{
 "description": "Add a text watermark to an image. Provide an image URL and watermark text. Returns a download URL (valid 30 min).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "angle": {
    "description": "Rotation angle in degrees (-180 to 180, default -30)",
    "type": "number"
   },
   "color": {
    "description": "Hex color (e.g. #ffffff, default white)",
    "type": "string"
   },
   "font": {
    "description": "Font (default inter)",
    "enum": [
     "inter",
     "roboto",
     "playfair",
     "courier",
     "arial"
    ],
    "type": "string"
   },
   "image_url": {
    "description": "URL of the image to watermark (must be publicly accessible)",
    "type": "string"
   },
   "opacity": {
    "description": "Opacity percentage (5-100, default 50)",
    "type": "number"
   },
   "position": {
    "description": "Watermark position (default center)",
    "enum": [
     "top-left",
     "top",
     "top-right",
     "left",
     "center",
     "right",
     "bottom-left",
     "bottom",
     "bottom-right"
    ],
    "type": "string"
   },
   "size": {
    "description": "Font size in pixels (12-200, default 48)",
    "type": "number"
   },
   "text": {
    "description": "Watermark text (max 200 characters)",
    "type": "string"
   },
   "tile": {
    "description": "Tile the watermark across the entire image (default false)",
    "type": "boolean"
   }
  },
  "required": [
   "image_url",
   "text"
  ],
  "type": "object"
 },
 "name": "markly_watermark_text"
}
