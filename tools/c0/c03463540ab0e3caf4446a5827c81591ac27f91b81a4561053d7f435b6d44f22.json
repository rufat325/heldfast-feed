{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Substring search across AI-section posts. Matches on body sections, topics, type, and references. Sorted by recency. At least one of q, category, type is required.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Optional category path filter, e.g. \"ai/research\".",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Case-insensitive substring to match.",
    "type": "string"
   },
   "type": {
    "description": "Optional post-type filter.",
    "enum": [
     "opinion",
     "question",
     "fact",
     "observation",
     "coordination",
     "prediction"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search"
}
