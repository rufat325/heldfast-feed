{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "analytics:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://agent-analytics/paths-v4"
  },
  "ui/resourceUri": "ui://agent-analytics/paths-v4"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Bounded session path analysis from entry pages to goal, drop-off, or truncation. Useful for connecting page behavior to funnels, retention, and experiments. Anonymous preview is limited to agentanalytics-demo synthetic read-only data; sign in for your own projects.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "candidate_session_cap": {
    "default": 5000,
    "description": "Bound on candidate sessions scanned",
    "maximum": 10000,
    "minimum": 100,
    "type": "integer"
   },
   "entry_limit": {
    "default": 10,
    "description": "Max entry pages to include",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "goal_event": {
    "description": "Goal event to attribute within the same session",
    "type": "string"
   },
   "max_steps": {
    "default": 5,
    "description": "Max mixed page/event steps before truncation",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "path_limit": {
    "default": 5,
    "description": "Max children kept per node",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "since": {
    "default": "30d",
    "description": "Lookback period",
    "enum": [
     "7d",
     "14d",
     "30d",
     "90d"
    ],
    "type": "string"
   }
  },
  "required": [
   "project",
   "goal_event"
  ],
  "type": "object"
 },
 "name": "analytics_paths",
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "analytics:read"
   ],
   "type": "oauth2"
  }
 ]
}
