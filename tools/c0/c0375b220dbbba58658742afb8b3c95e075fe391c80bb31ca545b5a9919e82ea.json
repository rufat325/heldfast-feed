{
 "description": "Launch a specialist-model loop (define \u2192 env \u2192 trajectories \u2192 train \u2192 evaluate \u2192 serve; Step 33). entry lets you start mid-stream: RLENV_PROJECT / GRADED_PROJECT (projectId) or TRAINING_RUN (trainingRunId \u2014 rails or your own stack; an already-SUCCEEDED run lands at TRAINED immediately). autoOrchestration SEMI (default) parks with a confirm offer at spend/work boundaries. Requires workflow:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoOrchestration": {
    "enum": [
     "MANUAL",
     "SEMI"
    ],
    "type": "string"
   },
   "entry": {
    "additionalProperties": false,
    "properties": {
     "kind": {
      "enum": [
       "FRESH",
       "RLENV_PROJECT",
       "GRADED_PROJECT",
       "TRAINING_RUN"
      ],
      "type": "string"
     },
     "projectId": {
      "type": "string"
     },
     "trainingRunId": {
      "type": "string"
     }
    },
    "required": [
     "kind"
    ],
    "type": "object"
   },
   "name": {
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "opentrain_workflow_launch",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
