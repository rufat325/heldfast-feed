{"_meta":{"securitySchemes":[{"scopes":["planitude:read","planitude:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Creates a complete new project in one call: phases, tasks, milestones, FS/SS/FF/SF dependencies with lag, date constraints, deadlines, people and assignments, and the working calendar (days, hours, holidays).\nDates are not passed in: the Planitude scheduler calculates them from durations, dependencies and calendar. Durations are working days that already account for the availability of the assigned people.\nThe plan is validated by the server: if something is wrong the response lists the problems and nothing is created.\nWith dryRun=true it only returns a preview (calculated finish, deadline met or missed, conflicts, overloaded people, critical path) and creates nothing. Without dryRun, calling it twice creates two projects. Requires write permission (read permission is enough for dryRun).","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"dryRun":{"description":"true = preview only, the project is not created.","type":"boolean"},"key":{"description":"Project key (2-10 letters/digits, starting with a letter, e.g. 'Cronos'): tasks are numbered Cronos-1, Cronos-2, ... Fixed once the first task exists. Omitted = derived from the name.","pattern":"^[A-Za-z][A-Za-z0-9]{1,9}$","type":"string"},"plan":{"description":"The complete plan.","properties":{"assumptions":{"items":{"maxLength":400,"type":"string"},"type":"array"},"calendar":{"properties":{"holidays":{"description":"Holidays and closures: the scheduler does not know any country's public holidays by itself","items":{"properties":{"date":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"endDate":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"name":{"type":"string"}},"required":["date"],"type":"object"},"type":"array"},"timeZone":{"description":"IANA time zone, e.g. Europe/Rome","type":"string"},"workingDays":{"description":"1 = Monday ... 7 = Sunday","items":{"maximum":7,"minimum":1,"type":"integer"},"type":"array"},"workingHours":{"description":"Working hour ranges, e.g. 09:00-13:00 and 14:00-18:00","items":{"properties":{"from":{"description":"HH:MM","type":"string"},"to":{"description":"HH:MM","type":"string"}},"required":["from","to"],"type":"object"},"type":"array"}},"required":["timeZone","workingDays","workingHours"],"type":"object"},"currency":{"pattern":"^[A-Z]{3}$","type":"string"},"deadline":{"anyOf":[{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},{"type":"null"}],"description":"Project deadline"},"deadlineKind":{"description":"hard = fixed commitment, soft = target","enum":["hard","soft"],"type":"string"},"dependencies":{"items":{"properties":{"from":{"description":"short stable id, e.g. 'design' or 't12'","pattern":"^[A-Za-z0-9_.-]{1,40}$","type":"string"},"lagDays":{"description":"Lag in working days (negative = overlap)","type":"number"},"to":{"description":"short stable id, e.g. 'design' or 't12'","pattern":"^[A-Za-z0-9_.-]{1,40}$","type":"string"},"type":{"description":"Default FS","enum":["FS","SS","FF","SF"],"type":"string"}},"required":["from","to"],"type":"object"},"type":"array"},"description":{"maxLength":2000,"type":"string"},"name":{"maxLength":200,"minLength":1,"type":"string"},"resources":{"items":{"properties":{"availabilityPct":{"description":"Availability on the project in percent, default 100","maximum":100,"minimum":1,"type":"integer"},"costPerHour":{"minimum":0,"type":"number"},"id":{"description":"short stable id, e.g. 'design' or 't12'","pattern":"^[A-Za-z0-9_.-]{1,40}$","type":"string"},"name":{"maxLength":120,"minLength":1,"type":"string"},"role":{"maxLength":120,"type":"string"}},"required":["id","name"],"type":"object"},"type":"array"},"risks":{"items":{"maxLength":400,"type":"string"},"type":"array"},"startDate":{"description":"Project start date","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"tasks":{"items":{"properties":{"assignments":{"items":{"properties":{"resourceId":{"description":"short stable id, e.g. 'design' or 't12'","pattern":"^[A-Za-z0-9_.-]{1,40}$","type":"string"},"unitsPct":{"maximum":100,"minimum":1,"type":"integer"}},"required":["resourceId"],"type":"object"},"type":"array"},"constraint":{"properties":{"date":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"kind":{"enum":["start_no_earlier_than","start_no_later_than","finish_no_earlier_than","finish_no_later_than","must_start_on","must_finish_on"],"type":"string"}},"required":["kind","date"],"type":"object"},"deadline":{"description":"Task target date: it does not move the task, it flags when exceeded","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"durationDays":{"description":"Only for 'task': working days (0.5 = half a day)","minimum":0,"type":"number"},"id":{"description":"short stable id, e.g. 'design' or 't12'","pattern":"^[A-Za-z0-9_.-]{1,40}$","type":"string"},"kind":{"description":"phase = summary of its children, milestone = zero duration","enum":["phase","task","milestone"],"type":"string"},"name":{"maxLength":200,"minLength":1,"type":"string"},"notes":{"maxLength":1000,"type":"string"},"parentId":{"anyOf":[{"description":"short stable id, e.g. 'design' or 't12'","pattern":"^[A-Za-z0-9_.-]{1,40}$","type":"string"},{"type":"null"}],"description":"id of the phase that contains it"}},"required":["id","name","kind"],"type":"object"},"minItems":1,"type":"array"}},"required":["name","startDate","calendar","tasks"],"type":"object"},"workspaceId":{"description":"Workspace. Omitted = the personal workspace.","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"}},"required":["plan"],"type":"object"},"name":"planitude_create_project_from_plan","securitySchemes":[{"scopes":["planitude:read","planitude:write"],"type":"oauth2"}],"title":"Create project from structured plan"}
