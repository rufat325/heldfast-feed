{
 "_meta": {
  "openai/outputTemplate": "ui://careclinic/tracker-card-v2.html",
  "openai/toolInvocation/invoked": "Review before saving",
  "openai/toolInvocation/invoking": "Preparing a CareClinic preview\u2026",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "careclinic.wellness.read",
     "careclinic.symptoms.write"
    ],
    "type": "oauth2"
   },
   {
    "scopes": [
     "careclinic.wellness.read",
     "careclinic.mood.write"
    ],
    "type": "oauth2"
   },
   {
    "scopes": [
     "careclinic.wellness.read",
     "careclinic.sleep.write"
    ],
    "type": "oauth2"
   },
   {
    "scopes": [
     "careclinic.wellness.read",
     "careclinic.medications.write"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://careclinic/tracker-card-v2.html",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://careclinic/tracker-card-v2.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Validates an exact owned symptom, mood or sleep entry and creates a short-lived confirmation preview. It never writes data. Scheduled medication and supplement taken/skipped events are enabled.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "entry": {
    "oneOf": [
     {
      "properties": {
       "domain": {
        "const": "symptom",
        "type": "string"
       },
       "durationMinutes": {
        "maximum": 43200,
        "minimum": 0,
        "type": "integer"
       },
       "name": {
        "maxLength": 120,
        "type": "string"
       },
       "note": {
        "maxLength": 300,
        "type": "string"
       },
       "occurredAt": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string"
       },
       "severity": {
        "maximum": 10,
        "minimum": 1,
        "type": "integer"
       },
       "symptomId": {
        "maxLength": 1024,
        "minLength": 32,
        "pattern": "^cc1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
        "type": "string"
       }
      },
      "required": [
       "domain",
       "symptomId",
       "name",
       "severity",
       "occurredAt"
      ],
      "type": "object"
     },
     {
      "properties": {
       "domain": {
        "const": "mood",
        "type": "string"
       },
       "energy": {
        "maximum": 10,
        "minimum": 0,
        "type": "integer"
       },
       "label": {
        "maxLength": 120,
        "type": "string"
       },
       "note": {
        "maxLength": 300,
        "type": "string"
       },
       "occurredAt": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string"
       },
       "valence": {
        "maximum": 5,
        "minimum": -5,
        "type": "integer"
       }
      },
      "required": [
       "domain",
       "valence",
       "occurredAt"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "enum": [
         "taken",
         "skipped"
        ],
        "type": "string"
       },
       "domain": {
        "const": "medication",
        "type": "string"
       },
       "medicationId": {
        "maxLength": 1024,
        "minLength": 32,
        "pattern": "^cc1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
        "type": "string"
       },
       "medicationName": {
        "maxLength": 120,
        "type": "string"
       },
       "note": {
        "maxLength": 300,
        "type": "string"
       },
       "occurredAt": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string"
       },
       "reminderId": {
        "maxLength": 1024,
        "minLength": 32,
        "pattern": "^cc1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
        "type": "string"
       },
       "reminderIndex": {
        "maximum": 1000,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "domain",
       "medicationId",
       "medicationName",
       "action",
       "occurredAt"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "domain": {
        "const": "sleep",
        "type": "string"
       },
       "note": {
        "maxLength": 250,
        "type": "string"
       },
       "occurredAt": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string"
       },
       "planId": {
        "maxLength": 1024,
        "minLength": 32,
        "pattern": "^cc1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
        "type": "string"
       },
       "planName": {
        "maxLength": 120,
        "type": "string"
       },
       "quality": {
        "maximum": 5,
        "minimum": 1,
        "type": "integer"
       },
       "stages": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "durationMinutes": {
           "maximum": 1440,
           "minimum": 0,
           "type": "integer"
          },
          "endAt": {
           "format": "date-time",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
           "type": "string"
          },
          "sleepType": {
           "anyOf": [
            {
             "const": 0,
             "type": "number"
            },
            {
             "const": 1,
             "type": "number"
            },
            {
             "const": 2,
             "type": "number"
            },
            {
             "const": 4,
             "type": "number"
            }
           ]
          },
          "startAt": {
           "format": "date-time",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
           "type": "string"
          }
         },
         "required": [
          "sleepType",
          "startAt",
          "endAt",
          "durationMinutes"
         ],
         "type": "object"
        },
        "maxItems": 4,
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "domain",
       "occurredAt",
       "stages"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "entry"
  ],
  "type": "object"
 },
 "name": "careclinic_preview_log",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expiresAt": {
    "type": "string"
   },
   "kind": {
    "const": "log_preview",
    "type": "string"
   },
   "preview": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "requiresExplicitConfirmation": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "kind",
   "preview",
   "expiresAt",
   "requiresExplicitConfirmation"
  ],
  "type": "object"
 },
 "title": "Preview a CareClinic check-in"
}
