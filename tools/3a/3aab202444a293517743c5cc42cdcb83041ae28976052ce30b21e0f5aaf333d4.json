{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Report the page count, per-page dimensions and document metadata of a local PDF. Read-only: the file is never modified. Call this before merging or extracting so page numbers are known to be valid.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "path": {
    "description": "The PDF to inspect. Absolute, or relative to the client's working directory.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "pdf_info",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "author": {
    "type": [
     "string",
     "null"
    ]
   },
   "name": {
    "type": "string"
   },
   "pageCount": {
    "type": "number"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "heightPt": {
       "type": "number"
      },
      "page": {
       "type": "number"
      },
      "widthPt": {
       "type": "number"
      }
     },
     "required": [
      "page",
      "widthPt",
      "heightPt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "path": {
    "type": "string"
   },
   "sizeBytes": {
    "type": "number"
   },
   "title": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "path",
   "name",
   "pageCount",
   "sizeBytes",
   "title",
   "author",
   "pages"
  ],
  "type": "object"
 },
 "title": "Inspect a PDF"
}
