{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Call after writing a review from prepare_review. Reads the review, checks every cited file and line against the manifest, and returns the verdict, the reference problems and the Markdown evidence packet with file hashes. No account needed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "What the researcher states about the finding: the same context object prepare_review takes.",
    "type": "object"
   },
   "manifest": {
    "description": "The manifest prepare_review or run_review returned, unchanged.",
    "items": {
     "properties": {
      "bytes": {
       "minimum": 0,
       "type": "integer"
      },
      "label": {
       "type": "string"
      },
      "lines": {
       "minimum": 0,
       "type": "integer"
      },
      "sha256": {
       "pattern": "^[0-9a-f]{64}$",
       "type": "string"
      }
     },
     "required": [
      "label",
      "bytes",
      "sha256"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "model": {
    "description": "The model that wrote the review.",
    "maxLength": 200,
    "type": "string"
   },
   "profile": {
    "description": "Review profile id from list_profiles. Defaults to general.",
    "enum": [
     "general",
     "solidity",
     "report",
     "scope",
     "provenance",
     "prior-art",
     "poc",
     "severity",
     "triage",
     "report-edit",
     "scanner",
     "verdict",
     "panel"
    ],
    "type": "string"
   },
   "provider": {
    "description": "Who runs that model.",
    "maxLength": 200,
    "type": "string"
   },
   "review": {
    "description": "The review text, starting at \"# Review\".",
    "maxLength": 400000,
    "type": "string"
   },
   "source": {
    "description": "pasted: your own model wrote it (default). ai: run_review wrote it. gauntlet or panel: the final review of a staged run.",
    "enum": [
     "pasted",
     "ai",
     "panel",
     "gauntlet"
    ],
    "type": "string"
   },
   "stages": {
    "description": "For a gauntlet or panel: one entry per earlier stage, in order.",
    "items": {
     "properties": {
      "headline": {
       "type": "string"
      },
      "model": {
       "type": "string"
      },
      "profile": {
       "enum": [
        "general",
        "solidity",
        "report",
        "scope",
        "provenance",
        "prior-art",
        "poc",
        "severity",
        "triage",
        "report-edit",
        "scanner",
        "verdict",
        "panel"
       ],
       "type": "string"
      },
      "verdict": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   }
  },
  "required": [
   "review",
   "manifest"
  ],
  "type": "object"
 },
 "name": "build_packet",
 "outputSchema": {
  "properties": {
   "headline": {
    "type": "string"
   },
   "ok": {
    "description": "False when the review has no valid Verdict line.",
    "type": "boolean"
   },
   "packet": {
    "type": "string"
   },
   "referenceProblems": {
    "type": "array"
   },
   "verdict": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "verdict",
   "referenceProblems",
   "packet"
  ],
  "type": "object"
 },
 "title": "Build the evidence packet"
}
