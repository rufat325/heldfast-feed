{
 "description": "Update an existing product. Pass only the fields to change. Use this to adjust price, rename, or republish a product without losing its productId \u2014 changing the id would break checkout flows already wired into the app.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currency": {
    "description": "ISO 4217 code, e.g. \"usd\"",
    "type": "string"
   },
   "defaultLang": {
    "enum": [
     "en",
     "es",
     "fr",
     "de",
     "it",
     "pt",
     "ja",
     "ko",
     "zh",
     "ar"
    ],
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "Description, string or per-language object"
   },
   "image": {
    "description": "Product image URL",
    "type": "string"
   },
   "max": {
    "description": "Maximum quantity for consumable",
    "type": "number"
   },
   "min": {
    "description": "Minimum quantity for consumable",
    "type": "number"
   },
   "name": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "Product name, string or { en: \"...\", es: \"...\" }"
   },
   "price": {
    "description": "Price in cents (one_time)",
    "type": "number"
   },
   "pricePerUnit": {
    "description": "Price per unit in cents (consumable)",
    "type": "number"
   },
   "productId": {
    "description": "The product ID returned by neblla_create_product",
    "type": "string"
   },
   "published": {
    "description": "Whether the product is buyable",
    "type": "boolean"
   },
   "step": {
    "description": "Quantity step for consumable selector",
    "type": "number"
   }
  },
  "required": [
   "productId"
  ],
  "type": "object"
 },
 "name": "neblla_update_product"
}
