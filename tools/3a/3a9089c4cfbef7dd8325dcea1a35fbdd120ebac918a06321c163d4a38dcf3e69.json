{
 "description": "Splits input around regex matches of pattern, returning at most limit substrings (the last holds the unsplit remainder). limit<=0 means no limit.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "type": "string"
   },
   "limit": {
    "type": "integer"
   },
   "pattern": {
    "type": "string"
   }
  },
  "required": [
   "pattern",
   "input"
  ],
  "type": "object"
 },
 "name": "regex_split",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "parts": {
    "items": {
     "type": "string"
    },
    "type": [
     "null",
     "array"
    ]
   }
  },
  "required": [
   "parts"
  ],
  "type": "object"
 }
}
