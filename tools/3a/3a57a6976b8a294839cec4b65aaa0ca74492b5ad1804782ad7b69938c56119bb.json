{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a localization project"
 },
 "description": "Use this when someone asks to create a new localization project with a given name and languages. Returns the new project with its default locale and locales; if the name is taken it returns already-exists and creates nothing. Not for adding a language to an existing project.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "defaultLocale": {
    "description": "Locale code of the source language, such as en",
    "maxLength": 35,
    "minLength": 1,
    "type": "string"
   },
   "locales": {
    "description": "Other locale codes to start with, such as it or de; the default locale is added automatically",
    "items": {
     "maxLength": 35,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 200,
    "type": "array"
   },
   "name": {
    "description": "Name of the new project, 1 to 128 characters; a URL-safe slug such as my-app is easiest to reference later",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "defaultLocale"
  ],
  "type": "object"
 },
 "name": "add_project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "project": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 35,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "pattern": "^[0-9a-f]{24}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "$ref": "#/properties/project/anyOf/0/properties/creationTime"
       },
       "locales": {
        "items": {
         "$ref": "#/properties/project/anyOf/0/properties/defaultLocale/anyOf/0"
        },
        "maxItems": 200,
        "type": "array"
       },
       "name": {
        "maxLength": 128,
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "defaultLocale",
       "locales",
       "creationTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "created",
     "already-exists"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "project"
  ],
  "type": "object"
 },
 "title": "Create a localization project"
}
