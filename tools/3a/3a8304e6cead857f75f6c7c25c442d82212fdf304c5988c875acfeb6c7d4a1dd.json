{
 "description": "Create a new ACP session on an initialized agent. Returns the agent's session ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentId": {
    "description": "ID of the initialized agent",
    "type": "string"
   },
   "cwd": {
    "description": "Working directory for the session",
    "type": "string"
   },
   "mcpServers": {
    "description": "MCP servers to make available to the agent",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "args": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "command": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "command"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "type": {
         "const": "http",
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "type",
        "name",
        "url"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "permissionPolicy": {
    "description": "Permission policy: elicit, allow_all, deny_all, or operator",
    "enum": [
     "elicit",
     "allow_all",
     "deny_all",
     "operator"
    ],
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "cwd"
  ],
  "type": "object"
 },
 "name": "new_session"
}
