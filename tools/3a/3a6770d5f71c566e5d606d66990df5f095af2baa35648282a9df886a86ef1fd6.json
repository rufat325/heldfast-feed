{
 "description": "Invoke an http / http-x402 listing's endpoint directly. Paid (x402) calls settle via ArisPay delegated signing and need ARISPAY_API_KEY. Non-2xx statuses are reported in-band.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Request body (for POST/PUT/PATCH)",
    "type": "string"
   },
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Extra HTTP headers",
    "type": "object"
   },
   "method": {
    "default": "GET",
    "description": "HTTP method",
    "enum": [
     "GET",
     "POST",
     "PUT",
     "PATCH",
     "DELETE"
    ],
    "type": "string"
   },
   "slug": {
    "description": "Agent slug to invoke",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "call_agent"
}
