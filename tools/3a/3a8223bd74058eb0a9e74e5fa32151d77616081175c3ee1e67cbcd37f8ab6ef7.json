{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch all provider rates for a specific coin symbol. Optionally filter by category.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "category": {
    "description": "Filter to a single product category (e.g. \"savings\", \"lending\", \"staking\")",
    "type": "string"
   },
   "symbol": {
    "description": "Coin symbol, e.g. \"btc\" or \"eth\"",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "get_rate_by_symbol",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "rates": {
    "description": "Matching rate entries",
    "items": {
     "additionalProperties": true,
     "properties": {
      "apy": {
       "description": "Annual percentage yield as a decimal (0.05 = 5%)",
       "type": "number"
      },
      "category": {
       "description": "Product category",
       "enum": [
        "savings",
        "lending",
        "staking",
        "borrowing"
       ],
       "type": "string"
      },
      "provider": {
       "description": "Provider slug, e.g. `nexo`",
       "type": "string"
      },
      "symbol": {
       "description": "Coin symbol, e.g. `btc`",
       "type": "string"
      },
      "updatedAt": {
       "description": "ISO-8601 timestamp of the most recent rate refresh",
       "type": "string"
      }
     },
     "required": [
      "provider",
      "symbol",
      "category",
      "apy"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "rates"
  ],
  "type": "object"
 },
 "title": "Get rates for a single symbol"
}
