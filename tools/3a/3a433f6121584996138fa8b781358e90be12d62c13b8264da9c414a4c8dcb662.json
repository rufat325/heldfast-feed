{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read a saved database restore review and its accepted receipt. Accepted means queued, not restored or verified. Requires read scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "restore_plan_id": {
    "pattern": "^rspl_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "required": [
   "restore_plan_id"
  ],
  "type": "object"
 },
 "name": "impreza_get_database_restore",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "cutover": {
      "type": "string"
     },
     "expires_at": {
      "type": "string"
     },
     "operation": {
      "type": "string"
     },
     "plan_id": {
      "type": "string"
     },
     "receipt": {
      "type": [
       "object",
       "null"
      ]
     },
     "review_digest": {
      "type": "string"
     },
     "source_backup": {
      "type": "object"
     },
     "source_deployment_id": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "target": {
      "type": "object"
     }
    },
    "required": [
     "plan_id",
     "review_digest",
     "expires_at",
     "status",
     "receipt",
     "operation",
     "source_backup",
     "source_deployment_id",
     "target",
     "cutover"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Read restore review"
}
