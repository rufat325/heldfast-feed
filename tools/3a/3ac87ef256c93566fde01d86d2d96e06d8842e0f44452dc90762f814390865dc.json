{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare employer cost across the 26 cantons"
 },
 "description": "The same hourly wage and weekly hours computed in all 26 Swiss cantons: monthly employer cost, net wage, family allowance fund rate, admin fee and the canton's minimum wage, ranked. Use it for 'where is it cheapest', 'how much does the canton matter' or a table for several cantons.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hourly_wage_chf": {
    "description": "Agreed hourly wage in CHF, before the vacation supplement (e.g. 30).",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "number"
   },
   "hours_per_week": {
    "description": "Average working hours per week with this household (e.g. 4).",
    "exclusiveMinimum": 0,
    "maximum": 70,
    "type": "number"
   },
   "language": {
    "default": "en",
    "description": "Language of the explanatory texts and of the clino.ch links: en, de, fr, it, es or pt. Default en.",
    "enum": [
     "en",
     "de",
     "fr",
     "it",
     "es",
     "pt"
    ],
    "type": "string"
   },
   "sort_by": {
    "default": "employer_cost",
    "description": "Sort the 26 cantons by monthly employer cost (ascending) or by the worker's net wage (descending).",
    "enum": [
     "employer_cost",
     "net_wage"
    ],
    "type": "string"
   },
   "vacation_weeks": {
    "default": 4,
    "description": "Paid vacation weeks per year: 4 (legal minimum), 5 (under age 20) or 6. Default 4.",
    "maximum": 6,
    "minimum": 4,
    "type": "integer"
   },
   "wage_is_net": {
    "default": false,
    "description": "true if the agreed hourly wage is what the worker receives in hand (net). The gross wage is then worked out from it. Default false (gross).",
    "type": "boolean"
   }
  },
  "required": [
   "hourly_wage_chf",
   "hours_per_week"
  ],
  "type": "object"
 },
 "name": "compare_cantons",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cantons": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "admin_fee_of_gross_wage_approx_percent": {
       "type": "number"
      },
      "below_minimum_wage": {
       "description": "true when the hourly wage entered is below the canton's floor from 5 h/week (city minimums not included).",
       "type": "boolean"
      },
      "code": {
       "type": "string"
      },
      "family_allowance_fund_employer_percent": {
       "type": "number"
      },
      "gross_wage_monthly": {
       "description": "CHF",
       "type": "number"
      },
      "minimum_wage_from_5h_chf": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "net_wage_monthly": {
       "$ref": "#/properties/cantons/items/properties/gross_wage_monthly"
      },
      "procedure": {
       "enum": [
        "simplified",
        "ordinary"
       ],
       "type": "string"
      },
      "rank": {
       "type": "number"
      },
      "total_employer_cost_monthly": {
       "$ref": "#/properties/cantons/items/properties/gross_wage_monthly"
      }
     },
     "required": [
      "rank",
      "code",
      "name",
      "procedure",
      "gross_wage_monthly",
      "net_wage_monthly",
      "total_employer_cost_monthly",
      "family_allowance_fund_employer_percent",
      "admin_fee_of_gross_wage_approx_percent",
      "minimum_wage_from_5h_chf",
      "below_minimum_wage"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "data_verified_on": {
    "description": "Date the rate set was last checked against the official sources.",
    "type": "string"
   },
   "disclaimer": {
    "type": "string"
   },
   "inputs": {
    "additionalProperties": false,
    "properties": {
     "hourly_wage_chf": {
      "type": "number"
     },
     "hours_per_week": {
      "type": "number"
     },
     "vacation_weeks": {
      "type": "number"
     },
     "wage_is_net": {
      "type": "boolean"
     }
    },
    "required": [
     "hourly_wage_chf",
     "hours_per_week",
     "wage_is_net",
     "vacation_weeks"
    ],
    "type": "object"
   },
   "links": {
    "additionalProperties": false,
    "properties": {
     "calculator": {
      "type": "string"
     }
    },
    "required": [
     "calculator"
    ],
    "type": "object"
   },
   "note": {
    "type": "string"
   },
   "provider": {
    "type": "string"
   },
   "rates_year": {
    "type": "number"
   },
   "spread_monthly_chf": {
    "type": "number"
   }
  },
  "required": [
   "inputs",
   "cantons",
   "spread_monthly_chf",
   "note",
   "links",
   "rates_year",
   "data_verified_on",
   "disclaimer",
   "provider"
  ],
  "type": "object"
 },
 "title": "Compare employer cost across the 26 cantons"
}
