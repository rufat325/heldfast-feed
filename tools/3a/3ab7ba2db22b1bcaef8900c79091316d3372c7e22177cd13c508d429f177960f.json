{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Deterministic council tally over an ASSEMBLED, de-anonymized input (meta + findings + adjudications + rankings). Peers-only tier cascade (Confirmed/Contested/Disputed/Singleton) + street-cred. Pure + synchronous: returns the tally record immediately. No subprocess, no polling. Claude assembles the input and may override margin tiers afterward.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adjudications": {
    "description": "One row per (judge \u00d7 finding).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "findingId": {
       "type": "string"
      },
      "judge": {
       "type": "string"
      },
      "seat": {
       "type": [
        "string",
        "null"
       ]
      },
      "verdict": {
       "enum": [
        "agree",
        "dispute",
        "neutral"
       ],
       "type": "string"
      }
     },
     "required": [
      "judge",
      "findingId",
      "verdict"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "findings": {
    "description": "Run-global findings (ids already A1/B2/C3-prefixed by Claude).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "claim": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "raiser": {
       "type": "string"
      },
      "raiserSeat": {
       "type": [
        "string",
        "null"
       ]
      },
      "severity": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "raiser",
      "severity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "additionalProperties": false,
    "description": "Run metadata; meta.models lists every reviewed model.",
    "properties": {
     "chair": {
      "type": "string"
     },
     "claudeInCouncil": {
      "type": "boolean"
     },
     "date": {
      "type": "string"
     },
     "intent": {
      "enum": [
       "review",
       "task"
      ],
      "type": "string"
     },
     "models": {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "runId": {
      "type": "string"
     },
     "runType": {
      "type": "string"
     },
     "seats": {
      "anyOf": [
       {
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "runId",
     "models"
    ],
    "type": "object"
   },
   "project": {
    "description": "Optional project directory path.",
    "type": "string"
   },
   "rankings": {
    "description": "Each judge's preference order over the reviews (ties = nested array).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "judge": {
       "type": "string"
      },
      "order": {
       "items": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        ]
       },
       "type": "array"
      },
      "orderSeats": {
       "anyOf": [
        {
         "items": {
          "anyOf": [
           {
            "type": [
             "string",
             "null"
            ]
           },
           {
            "items": {
             "type": [
              "string",
              "null"
             ]
            },
            "type": "array"
           }
          ]
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "seat": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "judge",
      "order"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "runStats": {
    "description": "Optional per-model run stats (status/duration/usage).",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "meta",
   "findings",
   "adjudications",
   "rankings"
  ],
  "type": "object"
 },
 "name": "amicus_council_tally"
}
