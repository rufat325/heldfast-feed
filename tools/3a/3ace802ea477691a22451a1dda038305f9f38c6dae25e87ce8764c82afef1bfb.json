{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Locate a domain (e.g. broz.be) in the Infomaniak account tree. Returns {account_id, hosting_id, site_id, hosting_label, full site object}. Use this BEFORE any tool that requires hosting_id + site_id (get_certificate, request_certificate, list_databases, etc.) when you only know the domain name. Significantly cheaper than calling list_hostings + list_sites manually because it short-circuits on the first match.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "account_id": {
    "description": "Optional account_id to restrict the lookup. Omit to scan every account the token has access to.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "domain": {
    "description": "Public domain to locate. Accepts root domains (broz.be) or sub-domains (crm.coden.lu). Punycode (xn--...) is fine.",
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "infomaniak_find_site",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "account_id": {
    "type": "number"
   },
   "domain": {
    "type": "string"
   },
   "found": {
    "type": "boolean"
   },
   "hint": {
    "type": "string"
   },
   "hosting_id": {
    "type": "number"
   },
   "hosting_label": {
    "type": "string"
   },
   "scanned_hostings": {
    "type": "number"
   },
   "site": {
    "additionalProperties": false,
    "properties": {
     "account_id": {
      "type": "number"
     },
     "applications": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "number"
        },
        "is_complete": {
         "type": "boolean"
        },
        "link_admin": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "type": {
         "type": "string"
        },
        "url": {
         "type": "string"
        },
        "version": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "type"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "customer_name": {
      "type": "string"
     },
     "directory": {
      "type": "string"
     },
     "has_website_builder": {
      "type": "boolean"
     },
     "has_wordpress": {
      "type": "boolean"
     },
     "hosting_type": {
      "type": "string"
     },
     "id": {
      "type": "number"
     },
     "main_fqdn": {
      "type": [
       "string",
       "null"
      ]
     },
     "parent_hosting_name": {
      "type": "string"
     },
     "parent_id": {
      "type": "number"
     },
     "ssl_issuer": {
      "type": [
       "string",
       "null"
      ]
     },
     "ssl_status": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "account_id",
     "customer_name"
    ],
    "type": "object"
   },
   "site_id": {
    "type": "number"
   }
  },
  "required": [
   "found",
   "domain",
   "scanned_hostings"
  ],
  "type": "object"
 }
}
