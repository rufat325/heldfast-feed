{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Clone une VM KVM existante (complet ou li\u00e9)",
 "inputSchema": {
  "properties": {
   "autostart": {
    "default": false,
    "type": "boolean"
   },
   "linked": {
    "default": false,
    "type": "boolean"
   },
   "network": {
    "default": "default",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "new_vm_name": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
    "type": "string"
   },
   "source_vm": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
    "type": "string"
   },
   "start": {
    "default": false,
    "type": "boolean"
   },
   "timeout_ms": {
    "maximum": 3600000,
    "minimum": 10000,
    "type": "number"
   },
   "tracking_session_id": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "source_vm",
   "new_vm_name"
  ],
  "type": "object"
 },
 "name": "vm_clone"
}
