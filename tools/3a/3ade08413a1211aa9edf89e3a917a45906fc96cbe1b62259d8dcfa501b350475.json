{
 "description": "Retrieve recent observations from a STATEC LUSTAT SDMX dataflow.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dataflow_id": {
    "description": "STATEC identifier such as DF_D7100",
    "type": "string"
   },
   "key": {
    "default": "all",
    "description": "SDMX dimension key or all",
    "type": "string"
   },
   "last_n_observations": {
    "default": 5,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "max_rows": {
    "default": 500,
    "maximum": 2000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "dataflow_id"
  ],
  "type": "object"
 },
 "name": "get_statistics"
}
