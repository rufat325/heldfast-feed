   "cardCount": {
    "type": "number"
   },
   "cards": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "definition": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "term": {
       "type": "string"
      }
     },
     "required": [
      "term",
      "definition"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "deepLink": {
    "type": "string"
   },
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "notes": {
    "type": [
     "string",
     "null"
    ]
   },
   "setId": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "topic": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "setId",
   "title",
   "cardCount",
   "cards",
   "deepLink"
  ],
  "type": "object"
 },
 "title": "Get study set contents"
}
