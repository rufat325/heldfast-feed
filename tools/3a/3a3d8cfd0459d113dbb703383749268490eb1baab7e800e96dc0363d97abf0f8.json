  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "setId": {
    "description": "Set id returned by create_study_set or list_study_sets",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "setId"
  ],
  "type": "object"
 },
 "name": "get_study_set",
 "outputSchema": {
