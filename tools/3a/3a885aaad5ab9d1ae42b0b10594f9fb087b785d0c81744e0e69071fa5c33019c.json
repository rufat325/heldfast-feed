{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List actions with optional filtering by collection, type, and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "clientId": {
    "description": "Filter by client ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "collId": {
    "description": "Filter by collection ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "end": {
    "description": "End timestamp",
    "type": "number"
   },
   "id": {
    "description": "Filter by action ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "index": {
    "description": "Start index (0-based)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "isDeleted": {
    "description": "Include deleted actions",
    "type": "boolean"
   },
   "mostRecentBy": {
    "description": "Most recent by filter",
    "type": "string"
   },
   "nValues": {
    "description": "Number of results (-1 for all)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "page": {
    "description": "Filter by page number",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "pageId": {
    "description": "Filter by page ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "pagingWrapper": {
    "default": false,
    "description": "Use paging wrapper",
    "type": "boolean"
   },
   "sortColumn": {
    "description": "Column to sort by",
    "type": "string"
   },
   "sortDirection": {
    "description": "Sort direction: asc or desc",
    "type": "string"
   },
   "start": {
    "description": "Start timestamp",
    "type": "number"
   },
   "type": {
    "description": "Filter by action type",
    "type": "string"
   },
   "typeId": {
    "description": "Filter by action type ID",
    "type": "string"
   },
   "userid": {
    "description": "Filter by user ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "transkribus_action_list",
 "title": "List Actions"
}
