        "properties": {
         "autoLiability": {
          "$ref": "#/properties/requirements/anyOf/0/properties/coverages/properties/generalLiability"
         },
         "generalLiability": {
          "additionalProperties": false,
          "properties": {
           "limits": {
            "additionalProperties": {
             "additionalProperties": false,
             "properties": {
              "min": {
               "type": "integer"
              }
             },
             "required": [
              "min"
             ],
             "type": "object"
            },
            "type": "object"
           },
           "minDaysToExpiry": {
            "minimum": 0,
            "type": "integer"
           },
           "mustBeActive": {
            "type": "boolean"
           },
           "requireAdditionalInsured": {
            "type": "boolean"
           },
           "requireOccurrenceForm": {
            "type": "boolean"
           },
           "requirePrimaryNonContributory": {
            "type": "boolean"
           },
           "requireSubrogationWaiver": {
            "type": "boolean"
           },
           "required": {
            "type": "boolean"
           }
          },
          "required": [
           "required"
          ],
          "type": "object"
         },
         "umbrellaExcess": {
          "$ref": "#/properties/requirements/anyOf/0/properties/coverages/properties/generalLiability"
         },
         "workersComp": {
          "$ref": "#/properties/requirements/anyOf/0/properties/coverages/properties/generalLiability"
         }
        },
        "type": "object"
       },
       "formMustBeCurrent": {
        "type": "boolean"
       },
       "insuredNameMustMatch": {
        "additionalProperties": false,
