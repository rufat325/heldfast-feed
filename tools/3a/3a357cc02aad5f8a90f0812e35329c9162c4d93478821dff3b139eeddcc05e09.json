   "document": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "data": {
        "description": "Base64-encoded document bytes, no data: URI prefix",
        "type": "string"
       },
       "kind": {
        "const": "base64",
        "type": "string"
       },
       "mediaType": {
        "enum": [
         "application/pdf",
         "image/png",
         "image/jpeg"
        ],
        "type": "string"
       }
      },
      "required": [
       "kind",
       "mediaType",
       "data"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "url",
        "type": "string"
       },
       "url": {
        "description": "https URL, fetched server-side under the \u00a77.2 SSRF limits",
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "url"
      ],
      "type": "object"
     }
    ],
    "description": "The certificate to read: base64 bytes, or an https url fetched server-side (\u00a73.5)"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "checkCarrier": {
      "type": "boolean"
     },
     "evaluationDate": {
      "type": "string"
     },
     "redactStored": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "requirements": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "carrier": {
        "additionalProperties": false,
        "properties": {
         "minAmBestRating": {
          "type": "string"
