{
 "description": "Get campaign breakdowns by device or network for a Google Ads campaign",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "breakdown_type": {
    "default": "device",
    "description": "Breakdown dimension",
    "enum": [
     "device",
     "network"
    ],
    "type": "string"
   },
   "campaign_id": {
    "description": "Campaign ID",
    "type": "string"
   },
   "customer_id": {
    "description": "Google Ads customer/account ID",
    "type": "string"
   },
   "days": {
    "default": 30,
    "description": "Lookback window in days (default 30)",
    "type": "number"
   }
  },
  "required": [
   "customer_id",
   "campaign_id"
  ],
  "type": "object"
 },
 "name": "google_ads_breakdowns"
}
