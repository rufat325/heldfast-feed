 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "ListRecipients returns a company's registered destinations, optionally narrowed to one counterparty. One counterparty may have many recipients, so this is what a send-money picker enumerates. Company-scoped + membership-authorized. MCP-exposed (read-only).",
 "inputSchema": {
  "properties": {
   "companyId": {
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   },
   "counterpartyId": {
    "maxLength": 36,
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$",
    "type": "string"
   },
   "pageSize": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "pageToken": {
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_send_recipients",
 "outputSchema": {
  "properties": {
   "nextPageToken": {
    "type": "string"
   },
   "recipients": {
    "items": {
     "properties": {
      "accountHolderName": {
       "type": "string"
      },
      "accountType": {
       "type": "string"
      },
      "counterpartyId": {
       "type": "string"
      },
      "displayLabel": {
       "type": "string"
      },
      "externalAccountId": {
       "type": "string"
      },
      "hasCreditorAddress": {
       "type": "boolean"
      },
      "last4": {
       "type": "string"
      },
      "provider": {
       "type": "string"
      },
      "recipientId": {
       "type": "string"
      },
      "unsupportedRails": {
       "items": {
        "enum": [
         "PAYMENT_RAIL_UNSPECIFIED",
         "PAYMENT_RAIL_ACH",
         "PAYMENT_RAIL_WIRE",
         "PAYMENT_RAIL_RTP",
         "PAYMENT_RAIL_FEDNOW",
         "PAYMENT_RAIL_INTERNAL"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "verificationStatus": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "totalCount": {
    "type": "integer"
   }
  },
  "type": "object"
 },
 "title": "List Recipients"
}
