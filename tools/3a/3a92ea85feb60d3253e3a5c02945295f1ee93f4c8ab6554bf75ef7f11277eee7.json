{
 "annotations": {
  "destructiveHint": true,
  "title": "Set rates and minimum stays"
 },
 "description": "Set the nightly price and/or minimum length of stay for dates on one or more properties. Smoobu PUSHES these to every channel with price sync enabled, so this changes live prices guests see. Reversible by setting the old values again \u2014 read them first with smoobu_get_rates. Each operation needs daily_price, min_length_of_stay, or both (a minimum stay alone needs an existing price). Smoobu: POST /api/rates.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "apartment_ids": {
    "description": "Property ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   },
   "operations": {
    "description": "Rate changes to apply.",
    "items": {
     "properties": {
      "daily_price": {
       "description": "Nightly price.",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "dates": {
       "description": "Single dates 'yyyy-mm-dd' or ranges 'yyyy-mm-dd:yyyy-mm-dd'.",
       "items": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}(:\\d{4}-\\d{2}-\\d{2})?$",
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      },
      "min_length_of_stay": {
       "description": "Minimum nights.",
       "maximum": 9007199254740991,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "dates"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "apartment_ids",
   "operations"
  ],
  "type": "object"
 },
 "name": "smoobu_set_rates",
 "title": "Set rates and minimum stays"
}
