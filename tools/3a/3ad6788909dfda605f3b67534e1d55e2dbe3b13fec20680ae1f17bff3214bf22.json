{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Spending Search Awards"
 },
 "description": "Search federal awards (contracts, grants, loans) from USAspending.gov by recipient company, keyword, and/or awarding agency, with optional fiscal year and minimum amount. Returns each award's id, recipient, amount, awarding agency, type, start date, and description, sorted by amount.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agency": {
    "description": "Awarding agency name, e.g. 'Department of Defense'.",
    "type": "string"
   },
   "category": {
    "description": "Award category: 'contracts' (default), 'grants', 'loans', or 'other'.",
    "type": "string"
   },
   "fiscal_year": {
    "description": "Federal fiscal year, e.g. 2024.",
    "type": "integer"
   },
   "keyword": {
    "description": "Free-text keyword across the award.",
    "type": "string"
   },
   "limit": {
    "description": "Max rows (default 10, max 50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_amount": {
    "description": "Minimum award amount in USD.",
    "type": "number"
   },
   "recipient": {
    "description": "Recipient company/org name, e.g. 'Lockheed Martin'.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "spending_search_awards"
}
