{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read a cited page's facts and evidence in a market.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "brandSlug": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "marketId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "brandSlug",
   "id",
   "marketId"
  ],
  "type": "object"
 },
 "name": "parse_dashboard_page",
 "securitySchemes": [
  {
   "scopes": [
    "parse:dashboard:read",
    "user:org:read"
   ],
   "type": "oauth2"
  }
 ]
}
