{
 "description": "Update queue item \u2014 Updates item status or assigned reviewer. Setting status to `completed` auto-records `completed_by` / `completed_at`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assigned_to": {
    "type": [
     "string",
     "null"
    ]
   },
   "itemId": {
    "type": "string"
   },
   "queueId": {
    "type": "string"
   },
   "status": {
    "enum": [
     "pending",
     "in_progress",
     "completed",
     "skipped"
    ],
    "type": "string"
   }
  },
  "required": [
   "queueId",
   "itemId"
  ],
  "type": "object"
 },
 "name": "update_annotation_queue_item"
}
