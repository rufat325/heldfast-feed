{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Export a media file's transcript or insights in various formats (pdf, docx, srt, vtt, txt, csv).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fileType": {
    "description": "Desired export format",
    "enum": [
     "csv",
     "csv-insights",
     "csv-transcript",
     "csv-transcript-sentiment",
     "csv-text-sentiment",
     "docx",
     "html",
     "json",
     "md",
     "pdf",
     "sourceFile",
     "srt",
     "ttml",
     "txt",
     "vtt",
     "mp4"
    ],
    "type": "string"
   },
   "isInsightVisualized": {
    "description": "Include insight visualizations",
    "type": "boolean"
   },
   "isRedacted": {
    "description": "Apply PII redaction to export",
    "type": "boolean"
   },
   "isSpeakerEmail": {
    "description": "Include speaker emails in export",
    "type": "boolean"
   },
   "isSpeakerNames": {
    "description": "Include speaker names in export",
    "type": "boolean"
   },
   "isTimeStamps": {
    "description": "Include timestamps in export",
    "type": "boolean"
   },
   "mediaId": {
    "description": "Unique identifier of the media file",
    "minLength": 1,
    "type": "string"
   },
   "redactedCategories": {
    "description": "Specific categories to redact",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "mediaId",
   "fileType"
  ],
  "type": "object"
 },
 "name": "export_media",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Response payload from the Speak AI API"
   }
  },
  "type": "object"
 },
 "title": "Export Media Transcript"
}
