{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Delete steps from a test case version. Provide either stepIds (array) or a filter, or set deleteAll=true to wipe all steps.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "deleteAll": {
    "type": "boolean"
   },
   "filter": {
    "properties": {
     "expectedResult": {
      "type": "string"
     },
     "stepDetails": {
      "type": "string"
     },
     "testData": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "id": {
    "description": "Test case ID or key",
    "type": [
     "string",
     "number"
    ]
   },
   "stepIds": {
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "versionNo": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "id",
   "versionNo"
  ],
  "type": "object"
 },
 "name": "qtm4j_delete_test_steps",
 "title": "Delete Test Steps"
}
