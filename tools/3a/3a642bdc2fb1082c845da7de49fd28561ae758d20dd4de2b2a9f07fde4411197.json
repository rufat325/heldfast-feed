{
 "description": "Create a buy or sell order",
 "inputSchema": {
  "properties": {
   "limitPrice": {
    "description": "Limit price (required for limit orders)",
    "type": "string"
   },
   "qty": {
    "description": "Quantity to buy/sell",
    "type": "string"
   },
   "side": {
    "description": "Order side",
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Trading pair symbol (e.g. BTC-BRL)",
    "type": "string"
   },
   "type": {
    "description": "Order type",
    "enum": [
     "limit",
     "market"
    ],
    "type": "string"
   }
  },
  "required": [
   "symbol",
   "side",
   "type",
   "qty"
  ],
  "type": "object"
 },
 "name": "create_order"
}
