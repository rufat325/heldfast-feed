{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Rank native-text pages for a question and return a bounded context pack with page, block, and excerpt evidence. No model call or OCR is used.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capability": {
    "description": "Document capability returned by POST /v1/documents.",
    "maxLength": 64,
    "minLength": 40,
    "type": "string"
   },
   "document_id": {
    "description": "UUID returned by POST /v1/documents.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "max_chars": {
    "description": "Maximum context characters.",
    "maximum": 32000,
    "minimum": 1000,
    "type": "integer"
   },
   "pages": {
    "description": "Optional 1-based pages to search.",
    "items": {
     "maximum": 100,
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 100,
    "type": "array"
   },
   "query": {
    "description": "Question or terms used for deterministic page ranking.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "document_id",
   "capability",
   "query"
  ],
  "type": "object"
 },
 "name": "prepare_document_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "Bounded cited context ranked from native PDF text.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "documentId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "error": {},
   "evidence": {
    "items": {},
    "type": "array"
   },
   "extensions": {},
   "maxChars": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "method": {
    "type": "string"
   },
   "omittedPages": {
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "pages": {
    "items": {},
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "resource": {},
   "selectedPages": {
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "text": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   },
   "warning": {
    "type": "string"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Prepare cited PDF context"
}
