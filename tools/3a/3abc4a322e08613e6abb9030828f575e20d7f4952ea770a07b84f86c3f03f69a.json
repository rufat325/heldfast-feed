        "number",
        "null"
       ]
      },
      "exit_type": {
       "description": "How the position closed, once scored (invalidated = at the veto price); absent before.",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "description": "Signal id.",
       "type": [
        "string",
        "null"
       ]
      },
      "pnl_percent": {
