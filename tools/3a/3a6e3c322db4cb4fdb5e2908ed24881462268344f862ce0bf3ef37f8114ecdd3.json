{
 "description": "Drop a pending condition-edit proposal (#365) without touching the condition. undo_last re-seats it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "proposal_id": {
    "description": "From propose_condition_edit, or takeoff_summary's proposed_condition_edits",
    "type": "string"
   }
  },
  "required": [
   "proposal_id"
  ],
  "type": "object"
 },
 "name": "withdraw_condition_edit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "condition": {
    "type": "string"
   },
   "proposal_id": {
    "type": "string"
   },
   "withdrawn": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "proposal_id",
   "condition",
   "withdrawn"
  ],
  "type": "object"
 }
}
