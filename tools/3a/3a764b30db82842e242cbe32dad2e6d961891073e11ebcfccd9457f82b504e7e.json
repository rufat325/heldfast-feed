  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "hash": {
    "description": "64-char SHA-256 hex hash from _proof.dataHash of any ChainRay response",
    "type": "string"
   }
  },
  "required": [
   "hash"
  ],
  "type": "object"
 },
 "name": "util.verify_proof",
