{
 "_meta": {
  "vealth/cost": "free-read"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Private, read-only capacity check-in. Keeps private blockers private and emits only coarse available/reduced/unavailable for a shared work graph. It is never fitness-for-duty and never exposes health reasons to an employer or public board.",
 "inputSchema": {
  "properties": {
   "desiredFocus": {
    "type": "string"
   },
   "privateBlockers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "safetySignal": {
    "enum": [
     "none",
     "uncertain",
     "medical_emergency",
     "mental_health_crisis",
     "withdrawal_risk",
     "safeguarding"
    ],
    "type": "string"
   },
   "selfReportedCapacity": {
    "enum": [
     "available",
     "reduced",
     "recovery_needed",
     "paused"
    ],
    "type": "string"
   }
  },
  "required": [
   "selfReportedCapacity"
  ],
  "type": "object"
 },
 "name": "capacity_checkin",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "claimId": {
    "type": "string"
   },
   "claimable": {
    "type": "boolean"
   },
   "definitionOfDone": {
    "type": [
     "object",
     "array",
     "string",
     "null"
    ]
   },
   "fulfillableBy": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "funded": {
    "type": "boolean"
   },
   "needs_from_caller": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "next_call": {
    "type": "object"
   },
   "notClaimableReason": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "payUsd": {
    "type": "number"
   },
   "proofRule": {
    "type": "string"
   },
   "tool": {
    "type": "string"
   },
   "workId": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Project private human capacity into a minimal work-availability signal"
}
