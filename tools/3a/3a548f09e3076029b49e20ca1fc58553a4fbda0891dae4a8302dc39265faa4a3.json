{
 "description": "Rebuilds dataFlow for all modules from module file dependencies or existing dependsOn edges. Recomputes providesTo and optionally syncs module files. Use instead of editing architecture.json directly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "description": "Required. Call list-projects first (query by workspace folder name) and pass the matching projectId. Never omit. default-project is forbidden.",
    "minLength": 1,
    "type": "string"
   },
   "pruneOrphans": {
    "description": "Remove invalid module references (default true)",
    "type": "boolean"
   },
   "source": {
    "description": "Source for dependsOn edges (default module-dependencies)",
    "enum": [
     "module-dependencies",
     "dataFlow-dependsOn"
    ],
    "type": "string"
   },
   "syncInverse": {
    "description": "Recompute providesTo (default true)",
    "type": "boolean"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "rebuild-data-flow",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "edgesAdded": {
    "type": "number"
   },
   "edgesRemoved": {
    "type": "number"
   },
   "message": {
    "type": "string"
   },
   "modulesUpdated": {
    "type": "number"
   }
  },
  "required": [
   "edgesAdded",
   "edgesRemoved",
   "modulesUpdated",
   "message"
  ],
  "type": "object"
 },
 "title": "Rebuild Data Flow"
}
