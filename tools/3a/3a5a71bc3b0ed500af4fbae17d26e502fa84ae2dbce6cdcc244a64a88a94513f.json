{
 "description": "Calculate X (Twitter) engagement rate using the public follower-based formula: (likes + reposts + replies + bookmarks + quotes) / followers \u00d7 100. Returns the percentage and the tier-aware benchmark band (Excellent / Good / Average / Low / Inactive).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bookmarks": {
    "default": 0,
    "description": "Bookmarks (optional, default 0)",
    "minimum": 0,
    "type": "integer"
   },
   "followers": {
    "description": "Account follower count",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "likes": {
    "description": "Likes on the post (or sum across posts)",
    "minimum": 0,
    "type": "integer"
   },
   "posts": {
    "default": 1,
    "description": "Number of posts the engagement is summed over (default 1)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "quotes": {
    "default": 0,
    "description": "Quote tweets (optional, default 0)",
    "minimum": 0,
    "type": "integer"
   },
   "replies": {
    "description": "Reply count",
    "minimum": 0,
    "type": "integer"
   },
   "reposts": {
    "description": "Reposts / retweets",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "followers",
   "likes",
   "reposts",
   "replies"
  ],
  "type": "object"
 },
 "name": "calculate_x_engagement_rate"
}
