  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Save Purchase Details"
 },
 "description": "Saves what the user is working toward so the RealOpen sidebar and conversation panel stay in step: the property price, the crypto asset or wallet they intend to use, and the workflow they chose. Call it when the user states or changes any of these. Pass null to clear a value. Stores planning details only. It does not move, sell, convert, or reserve crypto, and it does not create a Proof of Funds letter.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asset": {
    "description": "Crypto asset as a ticker or name; null clears it",
    "type": [
     "string",
     "null"
    ]
   },
   "target_price_usd": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Property price in US dollars; null clears it"
   },
   "wallet_id": {
    "description": "Internal wallet id the user picked; null clears it",
    "type": [
     "string",
     "null"
    ]
   },
   "workflow": {
    "anyOf": [
     {
      "enum": [
       "buying_power",
       "verify_wallet",
       "proof_of_funds",
       "realscore_report"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "buying_power, verify_wallet, or proof_of_funds; null clears it"
   }
  },
  "type": "object"
 },
 "name": "save_purchase_context",
