{
 "_meta": {
  "openai/outputTemplate": "ui://mimiq/report/v2",
  "openai/widgetCSP": {
   "connect_domains": [],
   "redirect_domains": [
    "https://www.mimiqai.com"
   ],
   "resource_domains": []
  },
  "securitySchemes": [
   {
    "scopes": [
     "mimiq:use"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://mimiq/report/v2"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show a Mimiq report"
 },
 "description": "Show the finished result of a saved Mimiq test, or two saved tests compared: the call, counts, objections in simulated people's words, and a full report link. Use session IDs from an earlier test result or report URL. Reads your account only and spends no credits.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "compare_session_id": {
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "session_id": {
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "mimiq.show_report",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "headline": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "limitation": {
    "type": "string"
   },
   "progress": {
    "additionalProperties": false,
    "properties": {
     "done": {
      "minimum": 0,
      "type": "integer"
     },
     "total": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "done",
     "total"
    ],
    "type": "object"
   },
   "reason": {
    "type": "string"
   },
   "report_url": {
    "format": "uri",
    "type": "string"
   },
   "status": {
    "enum": [
     "finished",
     "running"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "versions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "answers": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "option": {
          "type": "string"
         },
         "person": {
          "type": "string"
         },
         "reason": {
          "type": "string"
         }
        },
        "required": [
         "person",
         "option",
         "reason"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "counts": {
       "additionalProperties": false,
       "properties": {
        "finished": {
         "minimum": 0,
         "type": "integer"
        },
        "for_them": {
         "minimum": 0,
         "type": "integer"
        },
        "left": {
         "minimum": 0,
         "type": "integer"
        },
        "partway": {
         "minimum": 0,
         "type": "integer"
        },
        "rated": {
         "minimum": 0,
         "type": "integer"
        },
        "stayed": {
         "minimum": 0,
         "type": "integer"
        },
        "total": {
         "minimum": 0,
         "type": "integer"
        },
        "understood": {
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "total"
       ],
       "type": "object"
      },
      "label": {
       "type": "string"
      },
      "objections": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "count": {
          "minimum": 1,
          "type": "integer"
         },
         "person": {
          "type": "string"
         },
         "quote": {
          "type": "string"
         }
        },
        "required": [
         "quote",
         "person",
         "count"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "unanswered": {
       "minimum": 0,
       "type": "integer"
      },
      "votes": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "count": {
          "minimum": 0,
          "type": "integer"
         },
         "option": {
          "type": "string"
         }
        },
        "required": [
         "option",
         "count"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "label",
      "title",
      "counts",
      "objections"
     ],
     "type": "object"
    },
    "maxItems": 2,
    "minItems": 0,
    "type": "array"
   }
  },
  "required": [
   "title",
   "kind",
   "headline",
   "reason",
   "report_url",
   "limitation",
   "versions"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "mimiq:use"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Show a Mimiq report"
}
