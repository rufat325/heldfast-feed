{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Immediately edit one existing editable text file and record the applied change in PaperDock's Review changes UI. Provide exactly one target (fileId or path) and exactly one payload: operations, content, or rangeToken with insert. Read the relevant current text first and pass its baseRevision. For a long replacement covering every line returned by an exact read_file.lineRange call, pass its rangeToken with insert; the token is connection-, file-, revision-, range-, and content-bound and expires after 10 minutes. For other focused edits, use sequential UTF-16 operations and copy expectedText exactly from read_file without retyping, normalization, spelling correction, or manual Unicode escaping; insertions use expectedText: \"\". On a conflict, read again and retry once. Use content only when broadly rewriting most of the file. This tool cannot create, rename, or delete files.",
 "inputSchema": {
  "additionalProperties": false,
  "allOf": [
   {
    "oneOf": [
     {
      "required": [
       "fileId"
      ]
     },
     {
      "required": [
       "path"
      ]
     }
    ]
   },
   {
    "oneOf": [
     {
      "required": [
       "operations"
      ]
     },
     {
      "required": [
       "content"
      ]
     },
     {
      "required": [
       "rangeToken",
       "insert"
      ]
     }
    ]
   }
  ],
  "properties": {
   "baseRevision": {
    "minimum": 0,
    "type": "integer"
   },
   "content": {
    "type": "string"
   },
   "expectedUpdatedAt": {
    "type": "string"
   },
   "fileId": {
    "format": "uuid",
    "type": "string"
   },
   "insert": {
    "type": "string"
   },
   "operations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "expectedText": {
       "type": "string"
      },
      "from": {
       "minimum": 0,
       "type": "integer"
      },
      "insert": {
       "type": "string"
      },
      "to": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "expectedText",
      "from",
      "insert",
      "to"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "minItems": 1,
    "type": "array"
   },
   "path": {
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "format": "uuid",
    "type": "string"
   },
   "rangeToken": {
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "baseRevision"
  ],
  "type": "object"
 },
 "name": "edit_file",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "applicationStatus": {
    "enum": [
     "applied",
     "applying",
     "not_applied",
     "pending_review"
    ],
    "type": "string"
   },
   "file": {
    "additionalProperties": false,
    "properties": {
     "kind": {
      "enum": [
       "source",
       "asset"
      ],
      "type": "string"
     },
     "mimeType": {
      "type": [
       "string",
       "null"
      ]
     },
     "path": {
      "type": "string"
     },
     "revision": {
      "type": "integer"
     },
     "sizeBytes": {
      "type": [
       "integer",
       "null"
      ]
     }
    },
    "required": [
     "kind",
     "mimeType",
     "path",
     "revision",
     "sizeBytes"
    ],
    "type": "object"
   }
  },
  "required": [
   "applicationStatus",
   "file"
  ],
  "type": "object"
 },
 "title": "Edit a text project file"
}
