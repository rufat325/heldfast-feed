{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Set a motion override (deck / slide / element)"
 },
 "description": "Pin a Motion 3.0 pro-tier motion override. Target: deckId alone sets the DECK-wide spring default; add slideIndex (0-based) for a per-SLIDE spring default; add elementName too for a per-ELEMENT override. Deck/slide targets take only `spring` (a preset name \u2014 snappy|fluid|stately|pop|crisp|bouncy|mellow \u2014 or a params object). Element targets also take enter/exit preset, delaySec, durationSec, stagger (false opts out of the stagger cascade). Overrides survive restyle/re-roll verbatim and re-apply on every re-choreograph. Precedence: element > slide > deck > Style kit. Free workspaces may set overrides, but the free-tier motion clamp caps the spring feel to the calm posture (the clamp wins).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "deckId": {
    "type": "string"
   },
   "delaySec": {
    "maximum": 30,
    "minimum": 0,
    "type": "number"
   },
   "durationSec": {
    "maximum": 30,
    "minimum": 0.05,
    "type": "number"
   },
   "elementName": {
    "description": "Element label (\"Title\", \"Q3 chart\"); requires slideIndex",
    "type": "string"
   },
   "enter": {
    "description": "Entrance preset (element target only)",
    "enum": [
     "fadeIn",
     "rise",
     "drop",
     "pop",
     "blurIn",
     "slideLeft",
     "slideRight",
     "spin",
     "bounceIn",
     "swirlIn",
     "wobbleIn",
     "zoomIn",
     "wipe",
     "maskReveal",
     "typewriter",
     "drawOn",
     "countUp",
     "float",
     "pulse",
     "drift",
     "orbit",
     "sway",
     "breathe",
     "fadeOut",
     "sink",
     "shrink",
     "slideOutLeft",
     "slideOutRight",
     "spinOut",
     "blurOut"
    ],
    "type": "string"
   },
   "exit": {
    "description": "Exit preset (element target only)",
    "enum": [
     "fadeIn",
     "rise",
     "drop",
     "pop",
     "blurIn",
     "slideLeft",
     "slideRight",
     "spin",
     "bounceIn",
     "swirlIn",
     "wobbleIn",
     "zoomIn",
     "wipe",
     "maskReveal",
     "typewriter",
     "drawOn",
     "countUp",
     "float",
     "pulse",
     "drift",
     "orbit",
     "sway",
     "breathe",
     "fadeOut",
     "sink",
     "shrink",
     "slideOutLeft",
     "slideOutRight",
     "spinOut",
     "blurOut"
    ],
    "type": "string"
   },
   "slideIndex": {
    "description": "0-based slide index; omit to target the deck default",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "spring": {
    "anyOf": [
     {
      "enum": [
       "snappy",
       "fluid",
       "stately",
       "pop",
       "crisp",
       "bouncy",
       "mellow"
      ],
      "type": "string"
     },
     {
      "properties": {
       "damping": {
        "default": 26,
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "exitRatio": {
        "default": 0.65,
        "maximum": 1,
        "minimum": 0.1,
        "type": "number"
       },
       "mass": {
        "default": 1,
        "maximum": 10,
        "minimum": 0.1,
        "type": "number"
       },
       "overlap": {
        "default": 0.72,
        "maximum": 0.95,
        "minimum": 0,
        "type": "number"
       },
       "stagger": {
        "default": "uniform",
        "enum": [
         "uniform",
         "accelerate",
         "decelerate"
        ],
        "type": "string"
       },
       "stiffness": {
        "default": 210,
        "maximum": 1000,
        "minimum": 1,
        "type": "number"
       }
      },
      "type": "object"
     }
    ],
    "description": "Spring preset name or params object"
   },
   "stagger": {
    "description": "Participate in the stagger cascade (element target only)",
    "type": "boolean"
   }
  },
  "required": [
   "deckId"
  ],
  "type": "object"
 },
 "name": "set_motion",
 "title": "Set a motion override (deck / slide / element)"
}
