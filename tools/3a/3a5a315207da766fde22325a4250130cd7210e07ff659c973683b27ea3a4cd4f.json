{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add one later payment: a label, an amount in whole minor units, and a payment date. After the schedule is approved, a new later payment is refused until accept_schedule_change applies an add_later_payment suggestion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amountMinor": {
    "maximum": 100000000,
    "minimum": 1,
    "type": "integer"
   },
   "dueOn": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "label": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "scheduleId": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "scheduleId",
   "label",
   "amountMinor",
   "dueOn"
  ],
  "type": "object"
 },
 "name": "add_later_payment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "add later payment"
}
