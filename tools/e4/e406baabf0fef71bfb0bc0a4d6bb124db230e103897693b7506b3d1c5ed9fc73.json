{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Enable, disable, or configure the OpenVPN server (a per-router singleton). Throws NOT_FOUND if the OpenVPN package is not installed. The set action requires at least one configuration field.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "enable",
     "disable",
     "set"
    ],
    "type": "string"
   },
   "auth": {
    "description": "Authentication algorithm (set action only)",
    "enum": [
     "md5",
     "sha1",
     "sha256",
     "sha512",
     "null"
    ],
    "type": "string"
   },
   "certificate": {
    "description": "Server certificate name (set action only)",
    "type": "string"
   },
   "cipher": {
    "description": "Encryption cipher (set action only)",
    "enum": [
     "blowfish128",
     "aes128-cbc",
     "aes192-cbc",
     "aes256-cbc",
     "aes128-gcm",
     "aes256-gcm",
     "none"
    ],
    "type": "string"
   },
   "confirmationToken": {
    "description": "Token from a prior APPROVAL_REQUIRED response. Re-submit the identical call with this token to confirm the destructive action.",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview changes without applying.",
    "type": "boolean"
   },
   "mode": {
    "description": "Tunnel mode (set action only)",
    "enum": [
     "ip",
     "ethernet"
    ],
    "type": "string"
   },
   "port": {
    "description": "Listening port (set action only)",
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "protocol": {
    "description": "Transport protocol (set action only)",
    "enum": [
     "tcp-server",
     "udp"
    ],
    "type": "string"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_ovpn_server",
 "title": "Manage OpenVPN Server"
}
