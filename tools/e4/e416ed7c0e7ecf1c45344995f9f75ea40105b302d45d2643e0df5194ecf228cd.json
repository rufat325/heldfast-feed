   },
   "to": {
    "maxLength": 128,
    "minLength": 32,
    "type": "string"
   },
   "toChain": {
    "maxLength": 32,
    "minLength": 1,
    "type": "string"
   },
   "toToken": {
    "maxLength": 128,
    "type": "string"
   }
