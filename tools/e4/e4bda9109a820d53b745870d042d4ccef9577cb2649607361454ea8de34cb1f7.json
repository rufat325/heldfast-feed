{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Prepare a stake for your own key to sign"
 },
 "description": "Unsigned transactions that stake a market's token in its stake contract or its chain's stake hub: an approval for the exact amount (only if the allowance is short), then the stake. Checks balance, minimum and hub eligibility first, so a stake that would revert is refused before any gas is spent. No lock: unstake works at any time. A stake opens ask_agent for that market.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "description": "Wallet that holds the tokens and will sign.",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "amount": {
    "description": "Whole tokens to stake, for example \"10000\".",
    "pattern": "^\\d+(\\.\\d{1,18})?$",
    "type": "string"
   },
   "chainId": {
    "description": "Chain id of the market, for a ticker that trades on more than one chain (list_markets shows chainId). Without it the oldest market for that ticker is used.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "symbol": {
    "description": "Market ticker, for example PARCEL or ADEXTO. Required and has no default: the gateway refuses a missing ticker rather than quoting one, so a typo can never bill you for a token you did not ask for. Call list_markets first if you do not know it.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "symbol",
   "address",
   "amount"
  ],
  "type": "object"
 },
 "name": "prepare_stake",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "after": {
    "additionalProperties": {},
    "description": "The position once the transactions are mined.",
    "properties": {
     "active": {
      "description": "Active after staking.",
      "type": [
       "boolean",
       "null"
      ]
     },
     "minimum": {
      "description": "Minimum.",
      "type": [
       "string",
       "null"
      ]
     },
     "staked": {
      "description": "Position after staking.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "alreadyStaked": {
    "description": "On below_minimum: the current position.",
    "type": [
     "string",
     "null"
    ]
   },
   "balance": {
    "description": "On insufficient_balance: the wallet's balance.",
    "type": [
     "string",
