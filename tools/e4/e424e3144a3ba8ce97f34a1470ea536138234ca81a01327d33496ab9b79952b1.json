{
 "description": "Run the Florida solar cost calculator calculator: Electricity you buy each year (kWh); System size that covers it (kW); Solar panels installed; Home battery installed. Missing inputs fall back to their documented defaults.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "battCost": {
    "default": 12000,
    "description": "Battery price",
    "maximum": 80000,
    "minimum": 0,
    "type": "number"
   },
   "battery": {
    "default": "0",
    "description": "Include home battery storage",
    "type": "string"
   },
   "bill": {
    "default": 160,
    "description": "Average monthly electricity bill",
    "maximum": 2000,
    "minimum": 20,
    "type": "number"
   },
   "orient": {
    "default": "1",
    "description": "Roof the panels would go on",
    "enum": [
     "1",
     "0.85",
     "0.7"
    ],
    "type": "string"
   },
   "ppw": {
    "default": 2.8,
    "description": "Price per watt for the panels",
    "maximum": 8,
    "minimum": 1,
    "type": "number"
   },
   "rate": {
    "default": 15.17,
    "description": "Your electricity rate",
    "maximum": 60,
    "minimum": 5,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "calculate",
 "title": "Florida solar cost calculator"
}
