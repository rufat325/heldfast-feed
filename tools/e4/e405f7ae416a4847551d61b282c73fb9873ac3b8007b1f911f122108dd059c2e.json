{
 "description": "Make a retained revision the design's current content again, **forward**: it is committed as a new revision and nothing after it is lost, so a restore is undone by restoring again. `baseRevision` must be the current revision (a restore that raced an edit is refused as stale). `dryRun: true` writes nothing and returns the diff the restore would apply. Needs write access to the design.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agentModel": {
    "description": "Optional current model name shown to design viewers; self-reported. Omit when unknown.",
    "maxLength": 80,
    "type": "string"
   },
   "agentName": {
    "description": "Optional agent/client name shown to design viewers; self-reported.",
    "maxLength": 80,
    "type": "string"
   },
   "baseRevision": {
    "description": "The design's current revision, from ui_builder_get_design or ui_builder_list_revisions.",
    "type": "integer"
   },
   "designId": {
    "type": "string"
   },
   "dryRun": {
    "description": "Return the diff without restoring. Defaults to false.",
    "type": "boolean"
   },
   "operationId": {
    "description": "Makes a retry idempotent. Defaults to a fresh id.",
    "type": "string"
   },
   "revision": {
    "description": "The retained revision to restore.",
    "type": "integer"
   },
   "token": {
    "description": "A grant token from poll_access, when you cannot set the X-Compose-Preview-Token header yourself \u2014 an MCP client fixes its headers at connect time, so this is how a token approved during this session is used in it. Prefer the header where you control it.",
    "type": "string"
   }
  },
  "required": [
   "designId",
   "revision",
   "baseRevision"
  ],
  "type": "object"
 },
