{
 "description": "Redeem an artifact downloadRef from opentrain_episode_artifacts into a time-limited signed URL (the download leg of the Lane-4 artifacts plane). Fails closed 409 until PII scrub + household consent clear; foreign-org artifacts 404. Requires episodes:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "artifactId": {
    "type": "string"
   },
   "episodeId": {
    "type": "string"
   }
  },
  "required": [
   "episodeId",
   "artifactId"
  ],
  "type": "object"
 },
 "name": "opentrain_episode_artifact_download",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "artifactId": {
      "type": "string"
     },
     "expiresInSeconds": {
      "type": "number"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "artifactId",
     "url",
     "expiresInSeconds"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
