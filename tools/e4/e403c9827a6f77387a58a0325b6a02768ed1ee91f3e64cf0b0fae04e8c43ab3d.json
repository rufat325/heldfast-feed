{
 "description": "Import a playlist into the local transcript knowledge base for semantic search in Claude Desktop. Unlike raw yt-dlp, imports persist across sessions and become searchable \u2014 call recallWorkspace or listCollections first to avoid re-importing what you already have. [~5-30s, ~2s per video]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activateCollection": {
    "type": "boolean"
   },
   "chunkOverlapSec": {
    "maximum": 300,
    "minimum": 0,
    "type": "number"
   },
   "chunkSizeSec": {
    "maximum": 900,
    "minimum": 30,
    "type": "number"
   },
   "chunkStrategy": {
    "enum": [
     "time_window",
     "chapters",
     "auto"
    ],
    "type": "string"
   },
   "collectionId": {
    "type": "string"
   },
   "dryRun": {
    "type": "boolean"
   },
   "embeddingDimensions": {
    "maximum": 3072,
    "minimum": 128,
    "type": "number"
   },
   "embeddingModel": {
    "type": "string"
   },
   "embeddingProvider": {
    "enum": [
     "local",
     "gemini"
    ],
    "type": "string"
   },
   "label": {
    "type": "string"
   },
   "language": {
    "type": "string"
   },
   "maxVideos": {
    "maximum": 200,
    "minimum": 1,
    "type": "number"
   },
   "playlistUrlOrId": {
    "type": "string"
   },
   "reindexExisting": {
    "type": "boolean"
   }
  },
  "required": [
   "playlistUrlOrId"
  ],
  "type": "object"
 },
 "name": "importPlaylist"
}
