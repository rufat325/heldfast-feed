      },
      "verify_note": {
       "type": "string"
      },
      "verify_url": {
       "type": "string"
      }
     },
     "required": [
      "metric",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "page_url": {
    "type": "string"
   },
   "stale_omitted": {
    "type": "integer"
   },
