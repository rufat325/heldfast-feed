{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a network's latest measured values"
 },
 "description": "Returns the latest first-party measurements for one DePIN network (GPU and CPU capacity, storage, node or hotspot counts, on-chain totals), each with value, unit, as_of, freshness and the verify_url on the network's own API that you can open to check it. Market prices are not included. metric_filter narrows by substring; stale readings are omitted unless include_stale is true. Read-only, no key.",
 "inputSchema": {
  "properties": {
   "include_stale": {
    "description": "Include readings past their freshness window (default false).",
    "type": "boolean"
   },
   "max_metrics": {
    "description": "Max metrics returned (default 40).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "metric_filter": {
    "description": "Optional case-insensitive substring, e.g. 'gpu' or 'storage'.",
    "type": "string"
   },
   "symbol": {
    "description": "Network ticker, e.g. AKT, FIL, HNT (find_networks resolves names).",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "get_network",
 "outputSchema": {
  "properties": {
   "category": {
    "type": "string"
   },
   "metrics_matched": {
    "type": "integer"
   },
   "metrics_returned": {
    "type": "integer"
   },
   "name": {
    "type": "string"
   },
   "onchain_first_party": {
    "items": {
     "properties": {
      "as_of": {
       "type": "string"
      },
