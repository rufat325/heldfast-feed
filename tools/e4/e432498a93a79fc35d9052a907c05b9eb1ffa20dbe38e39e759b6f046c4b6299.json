{
 "description": "Aggregate suite timing from list_execution_history testStats (same filters as get-execution-history). Returns testCount, timedTestCount, sumSuccessMeanSecs (UI ExecutionTimingSummary total), sumFailMeanSecs, maxSuccessMeanSecs, slowTestCount (success mean > 30s). Sum of means is aggregate test CPU-time, not CI wall-clock under parallelism. Compare sumSuccessMeanSecs against any suite budget in the agent \u2014 this tool only returns stats.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "branchName": {
    "type": "string"
   },
   "dimensionFilters": {
    "items": {
     "properties": {
      "dimension": {
       "minLength": 1,
       "type": "string"
      },
      "values": {
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "dimension",
      "values"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "environment": {
    "type": "string"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "platform": {
    "enum": [
     "web",
     "ios",
     "android"
    ],
    "type": "string"
   },
   "release": {
    "type": "string"
   },
   "scenarioId": {
    "type": "string"
   },
   "scope": {
    "properties": {
     "filePaths": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "folderPath": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "string"
       }
      ]
     }
    },
    "type": "object"
   },
   "testId": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get-suite-execution-stats"
}
