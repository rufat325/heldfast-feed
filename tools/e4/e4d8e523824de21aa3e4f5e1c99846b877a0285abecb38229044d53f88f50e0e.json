{"_meta":{"securitySchemes":[{"type":"noauth"},{"scopes":["openid","email"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true,"title":"Find the modeler equivalent"},"description":"Translate between real amps and modeler factory amp models. Given a real amp (\"Dual Rectifier\", \"Vox AC30\"), returns the factory amp models on each modeler (or on one device) whose maker says they are that exact amp. Given a factory model name (\"Brit 2204\", \"Cali Rectifire\", \"Class-A 30W TB\"), returns the real amp it is, with a link to its gridleak.app page. Only exact twins are listed, never nearest-sounding models. Devices: quadcortex, axefx3 (the Axe-Fx III, FM9 and FM3 share one list; fm9 and fm3 are accepted too), axefx2, helix.","examples":[{"query":"Dual Rectifier"},{"query":"Brit 2204"},{"device":"helix","query":"Vox AC30"}],"inputSchema":{"properties":{"device":{"description":"Optional: limit the answer to one modeler.","enum":["quadcortex","axefx3","fm9","fm3","axefx2","helix"],"type":"string"},"query":{"description":"A real amp (name or canonical id) or a modeler's factory amp model name.","type":"string"}},"required":["query"],"type":"object"},"name":"find_modeler_equivalent","outputSchema":{"$defs":{"AmpRef":{"additionalProperties":true,"properties":{"canonical_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Canonical Id"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Name"},"url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Url"}},"title":"AmpRef","type":"object"},"Provenance":{"additionalProperties":true,"description":"Where an answer comes from (api/knowledge/envelope.make).","properties":{"basis":{"enum":["measured","derived_from_circuit","synthesised","catalog_record","unknown"],"title":"Basis","type":"string"},"last_checked":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Last Checked"},"record_id":{"title":"Record Id","type":"string"},"record_url":{"title":"Record Url","type":"string"},"verification":{"enum":["schematic_verified","catalog_verified","unverified"],"title":"Verification","type":"string"}},"required":["record_id","record_url","verification","basis"],"title":"Provenance","type":"object"}},"additionalProperties":true,"description":"find_modeler_equivalent: amp -> factory models (equivalents) or factory model -> amp (matches).","properties":{"amp":{"anyOf":[{"$ref":"#/$defs/AmpRef"},{"type":"null"}],"default":null},"device_filter":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Device Filter"},"direction":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Direction"},"equivalents":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"title":"Equivalents"},"error":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Error"},"matches":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"title":"Matches"},"provenance":{"$ref":"#/$defs/Provenance"},"query":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Query"},"rule":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Rule"},"search_url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Search Url"}},"required":["provenance"],"title":"EquivalentAnswer","type":"object"},"securitySchemes":[{"type":"noauth"},{"scopes":["openid","email"],"type":"oauth2"}],"title":"Find the modeler equivalent"}
