{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Agent"
 },
 "description": "Update an agent's name, description, metadata, or status (active/paused). Requires an org-level API key \u2014 agent-scoped keys cannot mutate agents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_id": {
    "description": "Agent ID to update",
    "type": "string"
   },
   "description": {
    "description": "New description (null to clear)",
    "type": [
     "string",
     "null"
    ]
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Arbitrary metadata (max 16KB)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "New display name",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "description": "Operational status",
    "enum": [
     "active",
     "paused"
    ],
    "type": "string"
   }
  },
  "required": [
   "agent_id"
  ],
  "type": "object"
 },
 "name": "update_agent"
}
