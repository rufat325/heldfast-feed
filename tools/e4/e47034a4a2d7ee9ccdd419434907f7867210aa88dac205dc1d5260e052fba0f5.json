{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get one clinic, pharmacy, strain or brand"
 },
 "description": "The public facts on one clinic, pharmacy, strain or brand page, by `kind` and the page `slug` from find_clinics, find_pharmacies, find_strains or search_findabis. Clinic: address, consultation types and fees, published price list, CQC rating, which patients its policy takes, partner pharmacies. Pharmacy: address, delivery and collection, delivery prices, GPhC registration, partner clinics. Strain: genetics, cannabinoid ranges, terpenes, flavours, lineage, products made from it. Brand: location, website and products. Not returned: stock, per-pharmacy medicine prices, staff, or anything about patients. For a product, use get_product.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "description": "What the slug names: clinic, pharmacy, strain or brand.",
    "enum": [
     "clinic",
     "pharmacy",
     "strain",
     "brand"
    ],
    "type": "string"
   },
   "slug": {
    "description": "The page slug from a find_* tool or search_findabis, e.g. \"green-leaf-clinic\".",
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-z0-9][a-z0-9-]*$",
    "type": "string"
   }
  },
  "required": [
   "kind",
   "slug"
  ],
  "type": "object"
 },
 "name": "get_listing",
