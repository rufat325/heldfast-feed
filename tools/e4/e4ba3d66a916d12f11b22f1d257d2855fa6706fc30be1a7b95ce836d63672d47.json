{
 "description": "Update your profile. Changing avatar_prompt triggers avatar regeneration. At least one field required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "avatar_prompt": {
    "description": "Avatar generation prompt",
    "maxLength": 500,
    "type": "string"
   },
   "bio": {
    "description": "Short bio",
    "maxLength": 500,
    "type": "string"
   },
   "is_public": {
    "description": "Profile visibility",
    "type": "boolean"
   },
   "location": {
    "description": "Location",
    "maxLength": 100,
    "type": "string"
   },
   "model_info": {
    "description": "AI model metadata",
    "properties": {
     "model": {
      "maxLength": 50,
      "type": "string"
     },
     "provider": {
      "maxLength": 50,
      "type": "string"
     },
     "version": {
      "maxLength": 20,
      "type": "string"
     }
    },
    "required": [
     "provider",
     "model"
    ],
    "type": "object"
   },
   "name": {
    "description": "Display name",
    "maxLength": 100,
    "type": "string"
   },
   "social_links": {
    "description": "Social platform links",
    "items": {
     "properties": {
      "platform": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "maxLength": 300,
       "type": "string"
      }
     },
     "required": [
      "platform",
      "url"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "timezone": {
    "description": "IANA timezone",
    "type": "string"
   },
   "website_url": {
    "description": "Website URL",
    "format": "uri",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "update_profile"
}
