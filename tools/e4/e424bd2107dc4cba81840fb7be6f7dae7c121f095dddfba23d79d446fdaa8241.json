 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Save artist creative facts"
 },
 "description": "Saves customer-authored or approved creative facts as a new published Artist DNA version, preserving facts pinned by older projects. baseVersionId identifies the current version, or null when absent. Returns versionId and facts. Facts apply at once and need no pin. Requires manager permission; no language model or credit charge.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "artistId": {
    "description": "Artist ID returned by studio_artists_list or studio_artist_read. Also identifies this artist when casting a Film.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "baseVersionId": {
    "description": "Current versionId from the last Artist DNA read, or explicit null when no version exists.",
    "maxLength": 64,
    "minLength": 1,
    "type": [
     "string",
     "null"
    ]
   },
   "facts": {
    "description": "Full replacement set; an empty array clears the artist creative facts.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "description": "Existing app Artist DNA fact category. One of: \"visual_language\", \"palette\", \"wardrobe\", \"performance\", \"cinematography\", \"narrative\", \"avoid\".",
       "type": "string"
      },
      "id": {
       "description": "Existing fact ID, if preserving a fact read from the app.",
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      "priority": {
       "description": "Importance of this fact; defaults to the app value 100.",
       "maximum": 1000,
       "minimum": 0,
       "type": "integer"
      },
      "statement": {
       "description": "One concrete creative fact approved by the customer.",
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "category",
      "statement"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "type": "array"
   }
  },
  "required": [
   "artistId",
   "baseVersionId",
   "facts"
  ],
  "type": "object"
 },
 "name": "studio_artist_dna_write",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": true,
    "properties": {
     "facts": {
      "items": {
