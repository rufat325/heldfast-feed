{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Idempotently stop inbound visibility and delete retained message and attachment content for one inbox lease, including an already-terminal lease. Supply the lease bearer on the HTTP or MCP transport; never place it in tool arguments.",
 "inputSchema": {
  "$defs": {
   "AgentInboxID": {
    "pattern": "^inb_[A-Za-z0-9_-]{22,64}$",
    "type": "string"
   }
  },
  "$id": "urn:ausca:mcp:DeleteAgentInbox:input:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "inbox_id": {
    "$ref": "#/$defs/AgentInboxID"
   }
  },
  "required": [
   "inbox_id"
  ],
  "type": "object"
 },
 "name": "ausca_agent_inbox_delete",
 "outputSchema": {
  "$defs": {
   "AgentInbox": {
    "additionalProperties": false,
    "properties": {
     "address": {
      "format": "email",
      "maxLength": 320,
      "minLength": 3,
      "pattern": "^[A-Za-z0-9!#$%&'*+/=?^_{|}~-]+(?:\\.[A-Za-z0-9!#$%&'*+/=?^_{|}~-]+)*@[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$",
      "type": "string"
     },
     "created_at": {
      "format": "date-time",
      "type": "string"
     },
     "deleted_at": {
      "format": "date-time",
      "type": "string"
     },
     "expires_at": {
      "format": "date-time",
      "type": "string"
     },
     "inbox_id": {
      "$ref": "#/$defs/AgentInboxID"
     },
     "state": {
      "enum": [
       "active",
       "deleting",
       "deleted",
       "expired"
      ],
      "type": "string"
     }
    },
    "required": [
     "inbox_id",
     "address",
     "state",
     "created_at",
     "expires_at"
    ],
    "type": "object"
   },
   "AgentInboxID": {
    "pattern": "^inb_[A-Za-z0-9_-]{22,64}$",
    "type": "string"
   }
  },
  "$id": "urn:ausca:mcp:DeleteAgentInbox:output:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "inbox": {
    "$ref": "#/$defs/AgentInbox"
   },
   "status": {
    "enum": [
     "deleted",
     "already_terminal"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "inbox"
  ],
  "type": "object"
 },
 "title": "Delete an agent-inbox lease"
}
