{
 "_meta": {
  "openai/ui": {
   "entrypoints": [
    {
     "type": "global"
    },
    {
     "type": "thread"
    }
   ]
  },
  "ui": {
   "resourceUri": "ui://peerlytics/activity.html"
  },
  "ui/resourceUri": "ui://peerlytics/activity.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Peerlytics Activity"
 },
 "description": "Read recent public Peer protocol activity on Base and open its interactive receipt desk. Returns a bounded latest sample, never all-time totals.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "peerlytics_activity",
 "title": "Peerlytics Activity"
}
