{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Creates a battle with named player seats, using the same rules as the site. Requires mcp:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allyId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "casual": {
    "default": false,
    "type": "boolean"
   },
   "limit": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "missionPackId": {
    "anyOf": [
     {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "opponentId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "opponentIds": {
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 2,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "create_battle",
 "title": "Create a battle"
}
