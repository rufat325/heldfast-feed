{
 "description": "Gestiona plantillas del sistema (admin only). Tipos: email, contracts, proposals, e-invoices, tickets. Acciones: list (type), get (type, id), create (type), update (type, id), delete (type, id).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete"
    ],
    "type": "string"
   },
   "custom_message": {
    "type": "string"
   },
   "default_message": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "email_subject": {
    "type": "string"
   },
   "id": {
    "description": "ID de la plantilla (requerido para get, update, delete)",
    "type": "number"
   },
   "language": {
    "type": "string"
   },
   "private": {
    "type": "number"
   },
   "template": {
    "type": "string"
   },
   "template_name": {
    "type": "string"
   },
   "template_type": {
    "type": "string"
   },
   "ticket_type_id": {
    "type": "number"
   },
   "title": {
    "type": "string"
   },
   "type": {
    "description": "Tipo de plantilla",
    "enum": [
     "email",
     "contracts",
     "proposals",
     "e-invoices",
     "tickets"
    ],
    "type": "string"
   }
  },
  "required": [
   "action",
   "type"
  ],
  "type": "object"
 },
 "name": "templates"
}
