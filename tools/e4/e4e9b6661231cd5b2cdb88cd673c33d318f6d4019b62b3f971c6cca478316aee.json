{
 "description": "Crop an image to a rectangle defined by x, y, width, height.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "Output format",
    "enum": [
     "jpeg",
     "png",
     "webp",
     "avif"
    ],
    "type": "string"
   },
   "height": {
    "description": "Height of crop rectangle",
    "minimum": 1,
    "type": "number"
   },
   "image_base64": {
    "description": "Base64-encoded image file",
    "type": "string"
   },
   "quality": {
    "description": "Output quality",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "width": {
    "description": "Width of crop rectangle",
    "minimum": 1,
    "type": "number"
   },
   "x": {
    "description": "Left edge of crop rectangle",
    "minimum": 0,
    "type": "number"
   },
   "y": {
    "description": "Top edge of crop rectangle",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "image_base64",
   "x",
   "y",
   "width",
   "height"
  ],
  "type": "object"
 },
 "name": "bytario_image_crop"
}
