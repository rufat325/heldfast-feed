 "description": "Number of 8\u00d78\u00d716 concrete blocks (CMU) for a wall. A standard block plus a \u215c in joint covers 16 \u00d7 8 in, so about 1.125 blocks per square foot. Formula: Blocks per sq ft = 144 \u00f7 ((length + joint) \u00d7 (height + joint)) = 144 \u00f7 (16 \u00d7 8) = 1.125 for standard units; blocks = net wall area \u00d7 1.125 \u00d7 (1 + waste%).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "joint_in": {
    "description": "Mortar joint (in); default 0.375",
    "type": "number"
   },
   "openings_sqft": {
    "description": "Openings to subtract (sq ft); default 0",
    "type": "number"
   },
   "unit_height_in": {
    "description": "Block height (actual) (in); default 7.625",
    "type": "number"
   },
   "unit_length_in": {
    "description": "Block length (actual) (in); default 15.625",
    "type": "number"
   },
   "wall_height_ft": {
    "description": "Wall height (ft); default 8",
    "type": "number"
   },
   "wall_length_ft": {
    "description": "Wall length (ft); default 40",
    "type": "number"
   },
   "waste_pct": {
    "description": "Waste allowance (%); default 5",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "calc_concrete_block",
 "title": "Concrete Block (CMU) Calculator"
}
