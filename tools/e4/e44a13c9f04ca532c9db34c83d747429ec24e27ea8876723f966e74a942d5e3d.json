{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Generate Etsy Listing"
 },
 "description": "Use this when the user wants a complete SEO-optimized Etsy listing from a product idea. Returns a title, A/B title variants, description, exactly 13 tags, and attributes. Uses one generation from the monthly quota.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Etsy category, e.g. \"Home & Living\"",
    "maxLength": 120,
    "type": "string"
   },
   "product_name": {
    "description": "Product description, e.g. \"handmade ceramic coffee mug, speckled glaze, 12oz\"",
    "maxLength": 300,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "product_name"
  ],
  "type": "object"
 },
 "name": "generate_etsy_seo",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cross_sell": {
    "description": "Suggested complementary product.",
    "type": "string"
   },
   "description": {
    "description": "SEO-optimized product description.",
    "type": "string"
   },
   "features": {
    "description": "Product feature highlights.",
    "items": {
     "$ref": "#/properties/title_alternatives/items"
    },
    "type": "array"
   },
   "shipping_tip": {
    "description": "Shipping pricing guidance.",
    "type": "string"
   },
   "suggested_attributes": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "color": {
        "type": "string"
       },
       "material": {
        "type": "string"
       },
       "occasion": {
        "type": "string"
       },
       "recipient": {
        "type": "string"
       },
       "style": {
        "type": "string"
       }
      },
      "required": [
       "occasion",
       "style",
       "color",
       "material",
       "recipient"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Suggested Etsy attribute values."
   },
   "tags": {
    "description": "All 13 Etsy tags.",
    "items": {
     "$ref": "#/properties/title_alternatives/items"
    },
    "type": "array"
   },
   "target_keywords": {
    "description": "Primary keyword phrases targeted by the listing.",
    "items": {
     "$ref": "#/properties/title_alternatives/items"
    },
    "type": "array"
   },
   "title": {
    "description": "Primary SEO title.",
    "type": "string"
   },
   "title_alternatives": {
    "description": "Alternative titles for A/B testing.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "usage": {
    "additionalProperties": false,
    "properties": {
     "dailyLimit": {
      "description": "Daily generation limit when one applies.",
      "type": "number"
     },
     "dailyRemaining": {
      "description": "Generations remaining today when a daily limit applies.",
      "type": "number"
     },
     "limit": {
      "description": "Monthly generation limit.",
      "type": "number"
     },
     "remaining": {
      "description": "Generations remaining this month.",
      "type": "number"
     },
     "tier": {
      "description": "Seerxo account tier.",
      "type": "string"
     },
     "usageByChannel": {
      "additionalProperties": false,
      "properties": {
       "mcp": {
        "description": "Generations used through MCP.",
        "type": "number"
       },
       "web": {
        "description": "Generations used through the web app.",
        "type": "number"
       }
      },
      "required": [
       "mcp",
       "web"
      ],
      "type": "object"
     }
    },
    "required": [
     "limit",
     "remaining",
     "tier",
     "usageByChannel"
    ],
    "type": "object"
   }
  },
  "required": [
   "title",
   "title_alternatives",
   "description",
   "tags",
   "features",
   "target_keywords",
   "cross_sell",
   "suggested_attributes",
   "shipping_tip",
   "usage"
  ],
  "type": "object"
 },
 "title": "Generate Etsy listing"
}
