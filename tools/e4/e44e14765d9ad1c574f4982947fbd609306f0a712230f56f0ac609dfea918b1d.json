{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Full-text search over the published developer, authentication, versioning and privacy documentation. Returns the best matching passages with their source page URL.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Documentation question or search terms.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_docs",
 "outputSchema": {
  "properties": {
   "passages": {
    "items": {
     "properties": {
      "heading": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "text": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url",
      "heading",
      "text",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "passages"
  ],
  "type": "object"
 },
 "title": "Search documentation"
}
