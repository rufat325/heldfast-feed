{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a Pollar Sounds episode"
 },
 "description": "Fetches one Pollar Sounds episode by slug (from list_sounds): description, the people and outlets whose recordings are heard, and the full transcript in the requested language with each speaker named. Episodes still in the members-only window come without a transcript. Returns a canonical pollar.news url.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "pl",
     "de",
     "fr"
    ],
    "type": "string"
   },
   "slug": {
    "minLength": 1,
    "type": "string"
   },
   "withTranscript": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_sound_episode",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "access": {
    "enum": [
     "early",
     "public"
    ],
    "type": "string"
   },
   "audioUrl": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "description": {
    "type": "string"
   },
   "durationMin": {
    "type": "number"
   },
   "episodeType": {
    "enum": [
     "full",
     "trailer"
    ],
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "number": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "publicAt": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "role": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "role",
      "source",
      "date",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "transcript": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "transcriptTruncated": {
    "type": "boolean"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "number",
   "episodeType",
   "title",
   "description",
   "durationMin",
   "publicAt",
   "access",
   "url",
   "sources",
   "audioUrl",
   "transcript",
   "transcriptTruncated"
  ],
  "type": "object"
 },
 "title": "Get a Pollar Sounds episode"
}
