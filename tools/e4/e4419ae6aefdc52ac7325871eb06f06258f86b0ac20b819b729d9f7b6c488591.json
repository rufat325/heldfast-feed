{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send one text request to a Thalovant hub using a saved identity and return the normalized reply.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "configPath": {
    "description": "Path to a Thalovant SDK config file.",
    "minLength": 1,
    "type": "string"
   },
   "context": {
    "additionalProperties": false,
    "properties": {
     "authClaims": {
      "additionalProperties": {},
      "type": "object"
     },
     "authProvider": {
      "minLength": 1,
      "type": "string"
     },
     "channel": {
      "minLength": 1,
      "type": "string"
     },
     "destination": {
      "minLength": 1,
      "type": "string"
     },
     "deviceId": {
      "minLength": 1,
      "type": "string"
     },
     "locale": {
      "minLength": 1,
      "type": "string"
     },
     "metadata": {
      "$ref": "#/properties/context/properties/authClaims"
     },
     "platform": {
      "minLength": 1,
      "type": "string"
     },
     "roles": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     },
     "sessionId": {
      "minLength": 1,
      "type": "string"
     },
     "source": {
      "minLength": 1,
      "type": "string"
     },
     "userId": {
      "minLength": 1,
      "type": "string"
     },
     "userName": {
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "emptyReplyWaitMs": {
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "fromEnv": {
    "default": false,
    "description": "Load the identity from Thalovant SDK environment variables.",
    "type": "boolean"
   },
   "identityFile": {
    "description": "Path to a Thalovant identity JSON file.",
    "minLength": 1,
    "type": "string"
   },
   "includeAudio": {
    "default": false,
    "description": "Include bounded embedded skill clips as MCP audio/resources; default returns metadata without placing audio hex in text.",
    "type": "boolean"
   },
   "lang": {
    "minLength": 1,
    "type": "string"
   },
   "location": {
    "additionalProperties": false,
    "description": "Request location, preferred over the hub's configured city.",
    "properties": {
     "city": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
     },
     "country": {
      "maxLength": 100,
      "type": "string"
     },
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "region": {
      "maxLength": 500,
      "type": "string"
     },
     "timezone": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "required": [
     "city"
    ],
    "type": "object"
   },
   "pipeline": {
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "profile": {
    "description": "SDK config profile name.",
    "minLength": 1,
    "type": "string"
   },
   "protocol": {
    "default": "wss",
    "description": "Runtime transport protocol.",
    "enum": [
     "wss",
     "https",
     "mqtt"
    ],
    "type": "string"
   },
   "replySettleMs": {
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "minLength": 1,
    "type": "string"
   },
   "sttLang": {
    "description": "Language recognized by speech-to-text; the hub validates this hint.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "maxLength": 20000,
    "minLength": 1,
    "type": "string"
   },
   "timeoutMs": {
    "default": 30000,
    "maximum": 300000,
    "minimum": 1000,
    "type": "integer"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "thalovant_ask",
 "title": "Ask Hub"
}
