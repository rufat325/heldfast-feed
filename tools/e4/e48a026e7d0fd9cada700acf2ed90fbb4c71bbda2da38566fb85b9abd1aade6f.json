{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search for resources by tags, type, or URI pattern. Check for existing resources before registering new ones to avoid duplicates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque cursor for pagination",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "orderBy": {
    "default": "recent",
    "enum": [
     "recent",
     "oldest",
     "fresh"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "enum": [
     "file",
     "url",
     "api",
     "command"
    ],
    "type": "string"
   },
   "uriPattern": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_resources",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "nextCursor": {
    "description": "Opaque cursor for next page, absent if no more results",
    "type": "string"
   },
   "resources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "categories": {
       "description": "All matched resource categories",
       "items": {
        "enum": [
         "lockFiles",
         "configFiles",
         "documentation",
         "generatedFiles",
         "apiSchemas",
         "sourceCode",
         "database",
         "scripts",
         "tests",
         "assets",
         "infrastructure",
         "default"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "freshnessThresholdHours": {
       "description": "Minimum freshness threshold in hours across all categories",
       "type": "number"
      },
      "hasSnapshot": {
       "type": "boolean"
      },
      "id": {
       "type": "number"
      },
      "lastVerifiedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "snapshotPreview": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "type": {
       "type": "string"
      },
      "uri": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "uri",
      "type",
      "description",
      "tags",
      "hasSnapshot",
      "snapshotPreview",
      "lastVerifiedAt",
      "categories",
      "freshnessThresholdHours"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "suggestedTags": {
    "description": "Popular tags to explore when search returns empty results",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "resources"
  ],
  "type": "object"
 },
 "title": "Search Resources"
}
