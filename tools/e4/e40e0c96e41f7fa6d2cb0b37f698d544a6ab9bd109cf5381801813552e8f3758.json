{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Search by location"},"description":"Find Cyclesite listings within a radius of a UK town, city or postcode district (the first half of a postcode, e.g. 'BS1', 'M20'). A full postcode is cut to its district; coordinates are not accepted. Radius capped at 50 miles. Returns up to 10 listings ordered by distance, rounded to the mile, and `searchedFrom` naming the place measured from. Live UK marketplace data. Example: 'used bikes within 25 miles of Leicester' or 'road bikes near LE10'.","inputSchema":{"properties":{"category":{"enum":["road","mtb","gravel","hybrid","ebike","kids","bmx","folding","city","touring","triathlon","track","cyclocross","cargo","adaptive","other"],"type":"string"},"limit":{"description":"1-10, default 5.","type":"number"},"maxPrice":{"type":"number"},"place":{"description":"UK town or city name (e.g. 'Bristol'), or a postcode district (e.g. 'BS1').","type":"string"},"radiusMiles":{"description":"Search radius in miles (1-50, default 25).","type":"number"}},"required":["place"],"type":"object"},"name":"search_by_location","outputSchema":{"properties":{"attribution":{"description":"Citation string \u2014 include verbatim when surfacing data.","type":"string"},"listings":{"items":{"properties":{"brand":{"type":["string","null"]},"city":{"type":["string","null"]},"condition":{"type":"string"},"delivery":{"type":["string","null"]},"distanceMiles":{"type":["number","null"]},"ebikeBatteryWh":{"type":["number","null"]},"ebikeMotor":{"type":["string","null"]},"frameMaterial":{"type":["string","null"]},"frameSize":{"type":["string","null"]},"groupset":{"type":["string","null"]},"imageUrl":{"format":"uri","type":["string","null"]},"isEbike":{"type":"boolean"},"listingId":{"type":["string","null"]},"model":{"type":["string","null"]},"negotiable":{"type":"boolean"},"offer":{"description":"UCP/ACP-shaped commerce signal for this listing.","propertie