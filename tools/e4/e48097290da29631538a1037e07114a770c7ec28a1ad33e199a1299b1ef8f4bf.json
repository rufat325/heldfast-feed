{
 "annotations": {
  "title": "Set waypoint"
 },
 "description": "Save a named waypoint (persisted to disk, survives restarts). Omit x/y/z to capture the bot's current position. Re-using a name overwrites it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "name": {
    "description": "Waypoint name, e.g. \"home\", \"diamond_mine\"",
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "description": "Optional note about this place",
    "type": "string"
   },
   "x": {
    "description": "X (defaults to current position)",
    "type": "number"
   },
   "y": {
    "description": "Y (defaults to current position)",
    "type": "number"
   },
   "z": {
    "description": "Z (defaults to current position)",
    "type": "number"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "set_waypoint"
}
