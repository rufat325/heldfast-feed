{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the account's managed VPS instances with id, plan, specs, status, region and SSH host. Call this first to discover vps ids for power_vps.",
 "inputSchema": {
  "properties": {},
  "type": "object"
 },
 "name": "list_vps",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "How many VPS instances the account has.",
    "type": "integer"
   },
   "instances": {
    "description": "One entry per VPS instance.",
    "items": {
     "properties": {
      "disk_gb": {
       "description": "NVMe disk in GB.",
       "type": "integer"
      },
      "game_node": {
       "description": "Name of the attached game node, empty when not attached.",
       "type": "string"
      },
      "id": {
       "description": "VPS id (vps_...) accepted by power_vps.",
       "type": "string"
      },
      "name": {
       "description": "Hostname of the VPS.",
       "type": "string"
      },
      "plan": {
       "description": "Plan, e.g. vps-8gb.",
       "type": "string"
      },
      "ram_mb": {
       "description": "RAM in MB.",
       "type": "integer"
      },
      "region": {
       "description": "Region name, e.g. Europe.",
       "type": "string"
      },
      "ssh_host": {
       "description": "Address SSH reaches the VPS on. Empty until provisioned.",
       "type": "string"
      },
      "ssh_port": {
       "description": "Port SSH listens on at ssh_host (22 on a dedicated IP, a NAT forward port until then).",
       "type": "integer"
      },
      "status": {
       "description": "running, stopped, provisioning, deleting or error.",
       "type": "string"
      },
      "vcpus": {
       "description": "Dedicated vCPU count.",
       "type": "integer"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "instances"
  ],
  "type": "object"
 },
 "title": "List VPS Instances"
}
