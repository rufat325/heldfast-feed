{
 "annotations": {
  "readOnlyHint": true,
  "title": "Activity time series"
 },
 "description": "Activity metric time series over a date range (e.g. daily steps for a week). Max 1095 days. Fitbit REST: GET /1/user/-/activities/{resource}/date/{startDate}/{endDate}.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "endDate": {
    "description": "Range end date, yyyy-MM-dd or 'today' (required).",
    "pattern": "^(\\d{4}-\\d{2}-\\d{2}|today)$",
    "type": "string"
   },
   "resource": {
    "description": "Activity metric to fetch (required).",
    "enum": [
     "steps",
     "distance",
     "calories",
     "floors",
     "elevation",
     "minutesSedentary",
     "minutesLightlyActive",
     "minutesFairlyActive",
     "minutesVeryActive",
     "activityCalories"
    ],
    "type": "string"
   },
   "startDate": {
    "description": "Range start date, yyyy-MM-dd or 'today' (required).",
    "pattern": "^(\\d{4}-\\d{2}-\\d{2}|today)$",
    "type": "string"
   }
  },
  "required": [
   "resource",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "fitbit_activity_time_series",
 "title": "Activity time series"
}
