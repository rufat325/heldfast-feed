{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false,"title":"Verify a site"},"description":"Checks for one method's proof now: `dns_txt` resolves the TXT record directly, and `meta_tag` and `well_known_file` read the page through Firecrawl. A proof that is found verifies the site by that method, and a missing one gets 409 `proof_not_found` and changes nothing. Riskcovery checks for the same proof again before every run, and while the proof is missing, the site gets no runs. Requires the admin role.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"host":{"description":"Host of a site from the sites tool, such as example.com","type":"string"},"method":{"enum":["dns_txt","meta_tag","well_known_file"],"type":"string"}},"required":["host","method"],"type":"object"},"name":"confirmSiteVerification","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"properties":{"host":{"type":"string"},"id":{"allOf":[{"pattern":"^[^A-Z]*$"}],"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$","type":"string"},"proofs":{"additionalProperties":true,"properties":{"dnsTxt":{"additionalProperties":true,"properties":{"name":{"type":"string"},"value":{"type":"string"}},"required":["name","value"],"type":"object"},"metaTag":{"additionalProperties":true,"properties":{"content":{"type":"string"},"html":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"required":["content","html","name","url"],"type":"object"},"wellKnownFile":{"additionalProperties":true,"properties":{"content":{"type":"string"},"url":{"type":"string"}},"required":["content","url"],"type":"object"}},"required":["dnsTxt","metaTag","wellKnownFile"],"type":"object"},"team":{"additionalProperties":true,"properties":{"id":{"type":"string"},"name":{"type":"string"}},"required":["id","name"],"type":"object"},"verification":{"anyOf":[{"additionalProperties":true,"properties":{"lastVerifiedAt":{"type":"null"},"method":{"anyOf":[{"enum":["dns_txt","meta_tag","well_known_file"],"type":"string"},{"type":"null"}]}},"required":["lastVerifiedAt","method"],"type":"object"},{"additionalProperties":true,"properties":{"lastVerifiedAt":{"type":"string"},"method":{"enum":["dns_txt","meta_tag","well_known_file"],"type":"string"}},"required":["lastVerifiedAt","method"],"type":"object"}]}},"required":["host","id","proofs","team","verification"],"type":"object"},"title":"Verify a site"}
