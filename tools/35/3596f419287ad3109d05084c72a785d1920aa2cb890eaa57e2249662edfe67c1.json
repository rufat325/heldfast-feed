  "additionalProperties": false,
  "properties": {
   "account": {
    "description": "Account name",
    "type": "string"
   },
   "metric_id": {
    "description": "Filter to events for one metric.",
    "type": "string"
   },
   "page_cursor": {
    "description": "Cursor from the previous page.",
    "type": "string"
   },
   "page_size": {
    "description": "Default 25, maximum 100 per page.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "account"
  ],
  "type": "object"
 },
 "name": "list_recent_events"
}
