{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Liste les ventes immobili\u00e8res (DVF) d'une zone : autour d'une adresse, d'une parcelle ou d'un point (rayon), ou dans toute une commune \u2014 id\u00e9al pour trouver des biens comparables. Une ligne par vente : date, prix, type de bien, surface b\u00e2tie, pi\u00e8ces, terrain, parcelles, prix au m\u00b2 (quand la vente porte sur un seul logement). Retourne aussi la m\u00e9diane du prix au m\u00b2 des ventes filtr\u00e9es. Seules les ventes g\u00e9olocalis\u00e9es sont couvertes (depuis 2021). Filtrer par 'type_bien' pour des prix au m\u00b2 comparables.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "anyOf": [
     {
      "anyOf": [
       {
        "minLength": 3,
        "type": "string"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Adresse postale au centre de la zone"
   },
   "commune": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Nom de commune : toute la commune (ignore 'rayon_m')"
   },
   "date_max": {
    "anyOf": [
     {
      "anyOf": [
       {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Date maximale 'AAAA-MM-JJ'"
   },
   "date_min": {
    "anyOf": [
     {
      "anyOf": [
       {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Date minimale 'AAAA-MM-JJ' (d\u00e9faut 2021-01-01)"
   },
   "lat": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Latitude du centre (avec 'lng')"
   },
   "limit": {
    "anyOf": [
     {
      "anyOf": [
       {
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Ventes par page (d\u00e9faut 20, max 50)"
   },
   "lng": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Longitude du centre (avec 'lat')"
   },
   "offset": {
    "anyOf": [
     {
      "anyOf": [
       {
        "maximum": 5000,
        "minimum": 0,
        "type": "integer"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Index de d\u00e9part pour la pagination (d\u00e9faut 0, max 5000). Utiliser pagination.next_offset pour la page suivante."
   },
   "parcelle_id": {
    "anyOf": [
     {
      "anyOf": [
       {
        "maxLength": 14,
        "minLength": 14,
        "type": "string"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "IDU d'une parcelle au centre de la zone"
   },
   "prix_max_eur": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Prix de vente maximal en euros, ex: 400000"
   },
   "prix_min_eur": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Prix de vente minimal en euros, ex: 150000"
   },
   "rayon_m": {
    "anyOf": [
     {
      "anyOf": [
       {
        "maximum": 2000,
        "minimum": 50,
        "type": "integer"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Rayon autour du centre en m\u00e8tres (d\u00e9faut 500, max 2000)"
   },
   "surface_max_m2": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Surface b\u00e2tie maximale en m\u00b2, ex: 120"
   },
   "surface_min_m2": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Surface b\u00e2tie minimale en m\u00b2, ex: 60"
   },
   "tri": {
    "anyOf": [
     {
      "anyOf": [
       {
        "enum": [
         "date",
         "distance"
        ],
        "type": "string"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Tri des ventes (d\u00e9faut : date d\u00e9croissante ; distance pour les plus proches)"
   },
   "type_bien": {
    "anyOf": [
     {
      "anyOf": [
       {
        "enum": [
         "maison",
         "appartement",
         "local"
        ],
        "type": "string"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Type de bien vendu : 'maison', 'appartement' ou 'local' (local commercial, industriel ou assimil\u00e9)"
   }
  },
  "type": "object"
 },
 "name": "search_ventes_dvf",
 "title": "Ventes immobili\u00e8res (DVF) dans une zone"
}
