        "type": "string"
       },
       "name": {
        "type": [
         "string",
         "null"
        ]
       },
       "niche": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "name",
       "domain",
       "niche"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "results_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "similar_newsletters": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "domain": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "domain"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sponsors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "brand": {
       "type": "string"
      },
      "domain": {
       "type": [
        "string",
        "null"
       ]
      },
      "last_seen": {
       "type": [
        "string",
        "null"
       ]
      },
      "newsletters_sponsored": {
       "type": [
        "number",
        "null"
       ]
      },
      "seen_in": {
