{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Return the full SSL certificate detail for one site on a web hosting: provisioning state (`installed`, `updating`, `error`, \u2026), type (free/paid/custom) and sub-type (`lets_encrypt`, \u2026), issuer + organization, validity flags (`is_valid`, `is_expired`, `is_selfsigned`), issue and expiry timestamps, SHA-256 fingerprint, main FQDN in IDN form, ACME identifier errors and the timestamp of the last issuance attempt.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "hosting_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "site_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "hosting_id",
   "site_id"
  ],
  "type": "object"
 },
 "name": "infomaniak_get_certificate",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "emitted_at": {
    "type": [
     "number",
     "null"
    ]
   },
   "error_identifiers": {
    "items": {},
    "type": "array"
   },
   "error_on_certificate": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ]
   },
   "expired_at": {
    "type": [
     "number",
     "null"
    ]
   },
   "fingerprint_sha256": {
    "type": [
     "string",
     "null"
    ]
   },
   "ignored_identifiers": {
    "items": {},
    "type": "array"
   },
   "is_expired": {
    "type": "boolean"
   },
   "is_selfsigned": {
    "type": "boolean"
   },
   "is_valid": {
    "type": "boolean"
   },
   "issuer": {
    "type": [
     "string",
     "null"
    ]
   },
   "last_attempt_at": {
    "type": [
     "number",
     "null"
    ]
   },
   "main_fqdn": {
    "type": "string"
   },
   "main_fqdn_idn": {
    "type": "string"
   },
   "organization": {
    "type": [
     "string",
     "null"
    ]
   },
   "site_id": {
    "type": "number"
   },
   "status": {
    "type": "string"
   },
   "sub_type": {
    "type": [
     "string",
     "null"
    ]
   },
   "type": {
    "enum": [
     "free",
     "paid",
     "custom"
    ],
    "type": "string"
   }
  },
  "required": [
   "site_id",
   "status"
  ],
  "type": "object"
 }
}
