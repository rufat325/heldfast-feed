{"description":"**\u590d\u76d8\u5206\u6790\u5e08\uff08analyst Agent\uff09**\uff1a\u8f93\u5165 scanner \u5feb\u7167 ID\uff0c\u8bfb\u53d6\u5feb\u7167\u4e0e T+1/T+5/T+20 \u8bc4\u4f30\uff0c\u8f93\u51fa\u6536\u76ca/\u57fa\u51c6/\u8d85\u989d/\u547d\u4e2d\u7387\u3001\u8d62\u5bb6\u8f93\u5bb6\u3001\u6570\u636e\u7f3a\u53e3\u548c\u590d\u76d8\u62a5\u544a\u3002\u53ea\u8bfb\u3001\u4e0d\u9009\u80a1\u3001\u4e0d\u9884\u6d4b\u3001\u4e0d\u63a8\u8350\u4e70\u5356\u3002\n\u26a0\ufe0f \u53ef\u9009 BYOK\uff1a\u5e26 `X-LLM-Key` \u7528\u6a21\u578b\u6da6\u8272\uff1b\u4e0d\u5e26\u8fd4\u56de\u786e\u5b9a\u6027\u590d\u76d8\u3002","inputSchema":{"properties":{"focus":{"default":"overall","description":"overall / winners / losers / attribution","title":"Focus","type":"string"},"horizon":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"description":"\u53ea\u590d\u76d8 1 / 5 / 20","title":"Horizon"},"snapshot_id":{"description":"scanner \u5feb\u7167 ID\uff0c\u5982 scn_xxx","title":"Snapshot Id","type":"string"}},"required":["snapshot_id"],"title":"ashare_analystArguments","type":"object"},"name":"ashare_analyst","outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"title":"ashare_analystOutput","type":"object"}}
