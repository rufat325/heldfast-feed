{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List Service Level Objectives with optional filtering by query, tags, or IDs",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ids": {
    "description": "Comma-separated list of SLO IDs to filter. Example: abc123,def456",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Max results (default 100)",
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset",
    "type": "number"
   },
   "query": {
    "description": "Search query for SLO names. Example: api-latency",
    "type": "string"
   },
   "tagsQuery": {
    "description": "Filter by tags. Example: env:prod,team:backend",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list-slos"
}
