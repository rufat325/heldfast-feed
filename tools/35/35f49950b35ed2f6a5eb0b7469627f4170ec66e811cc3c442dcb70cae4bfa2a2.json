{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "DMARC check"
 },
 "description": "Fetches a domain's DMARC record from _dmarc.<domain> and evaluates it: raw record, parsed tags, policy and subdomain policy, percentage, and warnings for records that parse but offer no protection (p=none, missing rua). Reports the published policy, not whether real mail passes it; spf_check and dkim_check cover the mechanisms it aligns against. Anonymous, rate-limited per IP.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "domain": {
    "description": "Domain name, e.g. deinkunde.com",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "dmarc_check",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "domain": {
    "type": [
     "string",
     "null"
    ]
   },
   "error": {
    "type": [
     "string",
     "null"
    ]
   },
   "found": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "ok": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "pct": {
    "type": [
     "number",
     "null"
    ]
   },
   "policy": {
    "type": [
     "string",
     "null"
    ]
   },
   "record": {
    "type": [
     "string",
     "null"
    ]
   },
   "subPolicy": {
    "type": [
     "string",
     "null"
    ]
   },
   "tags": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "properties": {
        "tag": {
         "type": [
          "string",
          "null"
         ]
        },
        "value": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "warnings": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "title": "DMARC check"
}
