{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a vacation rental's reviews"
 },
 "description": "Get guest reviews for a specific vacation rental property or for the entire collection. Returns a summary and individual review texts that can be used to answer questions about guest experiences.",
 "inputSchema": {
  "properties": {
   "collections": {
    "description": "Collection slug(s) \u2014 each a `collection_id` from list_collections. For search_bookables and discover_collections: OMIT to span the whole network, pass one to scope to a single manager, or several to compare across managers. For build_bookable_carousel: pass the collection_id(s) your chosen properties belong to \u2014 one, or several when the picks span managers. Every other tool operates on a single collection \u2014 pass exactly ONE.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Number of reviews to return (default 5, max 20).",
    "type": "number"
   },
   "offset": {
    "description": "Number of reviews to skip for pagination (default 0).",
    "type": "number"
   },
   "persona": {
    "description": "Filter to reviews from a guest persona type (e.g. \"family\", \"couples\", \"solo\").",
    "type": "string"
   },
   "propertySlug": {
    "description": "Slug of the specific property to get reviews for. If omitted, returns collection-level reviews.",
    "type": "string"
   },
   "season": {
    "description": "Filter to reviews from a specific season.",
    "enum": [
     "winter",
     "spring",
     "summer",
     "fall"
    ],
    "type": "string"
   },
   "sort": {
    "description": "How to sort reviews (default newest).",
    "enum": [
     "newest",
     "oldest",
     "highest",
     "lowest"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_bookable_reviews",
 "outputSchema": {
  "properties": {
   "collection": {
    "properties": {
     "name": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "pagination": {
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "type": "number"
     },
     "offset": {
      "type": "number"
     },
     "total": {
      "type": "number"
     }
    },
    "required": [
     "total",
     "limit",
     "offset",
     "hasMore"
    ],
    "type": "object"
   },
   "reviews": {
    "items": {
     "properties": {
      "channel": {
       "type": [
        "string",
        "null"
       ]
      },
      "date": {
       "type": [
        "string",
        "null"
       ]
      },
      "propertyName": {
       "type": "string"
      },
      "propertySlug": {
       "type": "string"
      },
