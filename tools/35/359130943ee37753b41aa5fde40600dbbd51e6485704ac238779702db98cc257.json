{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Change my RIED.TAXI booking"
 },
 "description": "Changes a booking. Always call first with mode='preview' and show the result to the customer; then call with mode='apply', customer_confirmed=true and an idempotency_key. Same-day time changes, flight number, passengers (max 5), notes and new addresses with the same price apply immediately; a new date or a different price is sent to Ronald for approval (status change_requested).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "access_code": {
    "description": "8-character access code given at booking time.",
    "maxLength": 8,
    "minLength": 8,
    "type": "string"
   },
   "booking_reference": {
    "description": "Public booking reference, e.g. RT-K7QM.",
    "pattern": "^RT-[A-Z0-9]{4,10}$",
    "type": "string"
   },
   "changes": {
    "additionalProperties": false,
    "minProperties": 1,
    "properties": {
     "destination_address": {
      "maxLength": 200,
      "type": "string"
     },
     "flight_number": {
      "maxLength": 12,
      "type": "string"
     },
     "notes": {
      "maxLength": 400,
      "type": "string"
     },
     "passengers": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
     },
     "pickup_address": {
      "maxLength": 200,
      "type": "string"
     },
     "pickup_date": {
      "description": "YYYY-MM-DD (Europe/Vienna).",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "pickup_time": {
      "description": "HH:MM, 24h, Europe/Vienna.",
      "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "customer_confirmed": {
    "type": "boolean"
   },
   "idempotency_key": {
    "description": "Unique key for this one intended action. Reuse it only when retrying the same action.",
    "maxLength": 80,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "mode": {
    "enum": [
     "preview",
     "apply"
    ],
    "type": "string"
   }
  },
  "required": [
   "booking_reference",
   "access_code",
   "mode",
   "changes"
  ],
  "type": "object"
 },
 "name": "ried_taxi_update_booking",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "booking_id": {
    "type": "string"
   },
   "booking_reference": {
    "type": "string"
   },
   "changes": {
    "type": "object"
   },
   "confirmation_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "currency": {
    "type": "string"
   },
   "destination": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "flight_number": {
    "type": [
     "string",
     "null"
    ]
   },
   "free_cancellation_until": {
    "type": "string"
   },
   "handled": {
    "enum": [
     "automatic",
     "needs_ronald"
    ],
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "passengers": {
    "type": [
     "integer",
     "null"
    ]
   },
   "pickup_address": {
    "type": "string"
   },
   "pickup_at": {
    "type": "string"
   },
   "pickup_date": {
    "type": "string"
   },
   "pickup_time": {
    "type": "string"
   },
   "price_eur": {
    "type": [
     "number",
     "null"
    ]
   },
   "status": {
    "type": "string"
   },
   "timezone": {
    "type": "string"
   },
   "updated_fields": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Change my RIED.TAXI booking"
}
