{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Performs a complete BagIQ analysis on a player's disc golf bag. Can accept a list of discs OR a BagIQ share link (e.g. 'https://app.bagiq.app/?s=4fisr8a7'). Returns slot coverage percentage, bag identity label (e.g. 'Overstable-heavy', 'Chaos bag'), top missing shot gaps, redundant overlaps, and mapped flight coordinates.","inputSchema":{"properties":{"discs":{"description":"List of discs currently in the bag (optional if share_url or share_id is provided)","items":{"oneOf":[{"description":"Disc name, slug, or brand+name string (e.g. 'Innova Destroyer' or 'discraft-buzzz')","type":"string"},{"properties":{"brand":{"description":"Manufacturer brand name","type":"string"},"confidence":{"description":"Player confidence","enum":["shaky","okay","trusted","money disc"],"type":"string"},"disc":{"description":"Disc name or slug (required)","type":"string"},"locked":{"description":"If true, lock this disc to prevent cut recommendations","type":"boolean"},"plastic":{"description":"Plastic blend (e.g. Star, Champion, ESP)","type":"string"},"throw_type":{"description":"Primary throw style","enum":["backhand","forehand","both"],"type":"string"},"usage":{"description":"Usage frequency","enum":["rare","sometimes","often","all the time"],"type":"string"},"use_case":{"description":"Role or shot description (e.g. 'windy drives', 'tunnel shots')","type":"string"},"wear_state":{"description":"Wear condition","enum":["new","seasoned","beat"],"type":"string"}},"required":["disc"],"type":"object"}]},"maxItems":35,"minItems":1,"type":"array"},"preferred_brand":{"description":"Optional preferred brand for recommendations (e.g. 'Innova', 'Discraft')","type":"string"},"share_id":{"description":"Optional BagIQ short share ID (e.g. '4fisr8a7')","type":"string"},"share_url":{"description":"Optional BagIQ share link (e.g. 'https://app.bagiq.app/?s=4fisr8a7' or 'https://app.bagiq.app/?discs=...')","type":"string"}},"type":"object"},"name":"analyze_bag","outputSchema":{"properties":{"bag_identity":{"type":"object"},"coverage_percent":{"type":"number"},"disc_count":{"type":"integer"},"gaps":{"items":{"type":"object"},"type":"array"},"interactive_bag_url":{"type":"string"},"mapped_discs":{"items":{"type":"object"},"type":"array"},"overlaps":{"items":{"type":"object"},"type":"array"},"recommendations":{"type":"object"},"source_type":{"type":"string"},"unresolved_discs":{"items":{"type":"string"},"type":"array"}},"required":["coverage_percent","bag_identity","disc_count","source_type","interactive_bag_url","gaps","overlaps","mapped_discs","recommendations","unresolved_discs"],"type":"object"}}
