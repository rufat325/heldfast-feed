{
 "description": "Create a label in a workspace (optionally attach to a task).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "color": {
    "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
    "type": "string"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "taskId": {
    "minLength": 1,
    "type": "string"
   },
   "workspaceId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "color",
   "workspaceId"
  ],
  "type": "object"
 },
 "name": "create_label"
}
