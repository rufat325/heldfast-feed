{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Install a conduitAI asset to your local environment. Modifies config files on disk. Use dry_run=true to preview changes first. Install specs are cryptographically signed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dry_run": {
    "description": "Preview changes without applying (recommended first)",
    "type": "boolean"
   },
   "scope": {
    "description": "Install scope (default: global)",
    "enum": [
     "global",
     "project"
    ],
    "type": "string"
   },
   "slug": {
    "description": "Asset slug to install",
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "install_asset",
 "title": "Install asset"
}
