{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Data Forest app (Kafka, Zeppelin, Spark, etc.)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountId": {
    "description": "Account unique identifier (Base62-encoded UUID)",
    "maxLength": 22,
    "type": "string"
   },
   "appTypeId": {
    "description": "App type and version (e.g. KAFKA-2.4.0)",
    "maxLength": 60,
    "type": "string"
   },
   "components": {
    "description": "App component configurations",
    "items": {
     "additionalProperties": false,
     "properties": {
      "containerCount": {
       "description": "Number of containers",
       "type": "number"
      },
      "cpuCount": {
       "description": "CPU count per container",
       "type": "number"
      },
      "memoryMb": {
       "description": "Memory in MB per container",
       "type": "number"
      },
      "name": {
       "description": "Component name (e.g. broker, shell)",
       "type": "string"
      }
     },
     "required": [
      "name",
      "memoryMb",
      "cpuCount",
      "containerCount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dependentIds": {
    "description": "Dependent app IDs required for creation",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "description": {
    "description": "App description (max 2048 chars)",
    "maxLength": 2048,
    "type": "string"
   },
   "lifetime": {
    "description": "App lifetime in seconds (300-604800, or -1 for permanent)",
    "type": "number"
   },
   "name": {
    "description": "App name (lowercase + numbers + '-', 3-15 chars)",
    "maxLength": 15,
    "minLength": 3,
    "type": "string"
   },
   "queueName": {
    "description": "YARN queue name (e.g. longlived, batch, dev)",
    "maxLength": 60,
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "queueName",
   "appTypeId",
   "name",
   "lifetime",
   "components"
  ],
  "type": "object"
 },
 "name": "ncloud_dataforest_create_app"
}
