{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update a routine"
 },
 "description": "Update a routine's instruction, cadence, delivery, or enabled switch (pause/resume). Only pass the fields being changed. Cadence changes recompute the next fire time.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approvalId": {
    "description": "Approval id from a prior needs_confirmation envelope.",
    "type": "string"
   },
   "delivery": {
    "enum": [
     "notification",
     "email",
     "room"
    ],
    "type": "string"
   },
   "enabled": {
    "type": "boolean"
   },
   "id": {
    "description": "Routine id (from routines_list).",
    "type": "string"
   },
   "instruction": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "interval": {
    "enum": [
     "daily",
     "weekly"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "roomId": {
    "description": "With delivery \"room\": the room to post in.",
    "type": "string"
   },
   "scheduleDayOfWeek": {
    "anyOf": [
     {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "scheduleTime": {
    "description": "Wall-clock \"HH:MM\" anchor (default 09:00).",
    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
    "type": "string"
   },
   "scheduleTimezone": {
    "type": "string"
   },
   "workspace": {
    "description": "Workspace slug. Personal tokens with no default workspace MUST pass this; tokens with a default can override per call. Ignored for workspace API keys.",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "routines_update",
 "title": "Update a routine"
}
