{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit a label"
 },
 "description": "Rename a label, recolour it, or both. The id comes from labels_list. An Outlook mailbox's categories are its labels, and Microsoft lets one take only a new colour.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "color": {
    "description": "Its new colour.",
    "enum": [
     "red",
     "orange",
     "yellow",
     "green",
     "teal",
     "blue",
     "purple",
     "gray",
     "black"
    ],
    "type": "string"
   },
   "id": {
    "description": "A label id from labels_list.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "type": "string"
   },
   "mailbox": {
    "description": "The mailbox's name or its email address.",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Its new name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "mailbox",
   "id"
  ],
  "type": "object"
 },
 "name": "labels_update",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "type": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "id",
   "name"
  ],
  "type": "object"
 },
 "title": "Edit a label"
}
