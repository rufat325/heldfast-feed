{
 "annotations": {
  "readOnlyHint": true,
  "title": "List Depot CI workflows"
 },
 "description": "List Depot CI workflows across runs, newest first, with per-status job counts. Filter by name/path text, repo, status, trigger, SHA prefix or PR number. Depot: CIService/ListWorkflows.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "name": {
    "description": "Text to match in the workflow name or file path.",
    "type": "string"
   },
   "page_size": {
    "description": "Page size, 1-200.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "pr": {
    "description": "Pull request number.",
    "type": "string"
   },
   "repo": {
    "description": "Repository in owner/name format.",
    "type": "string"
   },
   "sha": {
    "description": "Commit SHA prefix (1-40 hex chars).",
    "pattern": "^[0-9a-fA-F]{1,40}$",
    "type": "string"
   },
   "status": {
    "description": "Workflow statuses to include (ORed).",
    "items": {
     "enum": [
      "queued",
      "running",
      "finished",
      "failed",
      "cancelled"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "trigger": {
    "description": "Trigger event, e.g. push or pull_request.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "depot_ci_list_workflows",
 "title": "List Depot CI workflows"
}
