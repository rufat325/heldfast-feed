{
 "description": "Search the Probo product catalog. Returns product names, codes, categories, and pricing. Use without query to browse all products.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "language": {
    "description": "ISO 639-1 language code: \"en\", \"nl\", \"de\", \"fr\"",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "page": {
    "description": "Page number (default: 1)",
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Results per page (max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Filter by keyword, e.g. \"banner\", \"frame\", \"textile\"",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "searchProducts"
}
