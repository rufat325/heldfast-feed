{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Generate tests for a specific file in a GitHub repository. Creates test files and opens a PR with them.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "file": {
    "description": "File to generate tests for, e.g. 'src/auth.ts'",
    "minLength": 1,
    "type": "string"
   },
   "repo": {
    "description": "GitHub repo in owner/repo format",
    "pattern": "^[a-zA-Z0-9_.-]+\\/[a-zA-Z0-9_.-]+$",
    "type": "string"
   }
  },
  "required": [
   "repo",
   "file"
  ],
  "type": "object"
 },
 "name": "generate_tests"
}
