{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Change who can read a report: visibility (its owner only) and web\npublication (its owner or an org admin).",
 "inputSchema": {
  "properties": {
   "document_id": {
    "description": "UUID of the report",
    "format": "uuid",
    "title": "Document Id",
    "type": "string"
   },
   "published": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Anonymous web access; only on a report of a public database",
    "title": "Published"
   },
   "visibility": {
    "anyOf": [
     {
      "enum": [
       "private",
       "scoped",
       "everyone"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "private, scoped, or everyone (organisation-wide)",
    "title": "Visibility"
   }
  },
  "required": [
   "document_id"
  ],
  "title": "set_report_accessArguments",
  "type": "object"
 },
 "name": "myriade_set_report_access",
 "outputSchema": {
  "properties": {
   "result": {
    "title": "Result",
    "type": "string"
   }
  },
  "required": [
   "result"
  ],
  "title": "set_report_accessOutput",
  "type": "object"
 }
}
