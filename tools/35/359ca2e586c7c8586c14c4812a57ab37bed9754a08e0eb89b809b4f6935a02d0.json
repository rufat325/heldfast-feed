{
 "description": "Create a cooldown period for an agent. Prevents approvals during the cooldown period. Use when slicing attacks are detected or for manual security lockdowns.",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "Unique identifier for the agent",
    "type": "string"
   },
   "approver_id": {
    "description": "Optional: Specific approver to cooldown",
    "type": "string"
   },
   "cooldown_type": {
    "description": "Type of cooldown",
    "enum": [
     "velocity_limit",
     "fatigue_protection",
     "manual",
     "security_incident"
    ],
    "type": "string"
   },
   "duration_minutes": {
    "description": "Duration of the cooldown in minutes",
    "type": "number"
   },
   "reason": {
    "description": "Reason for the cooldown",
    "type": "string"
   }
  },
  "required": [
   "agent_id",
   "cooldown_type",
   "reason",
   "duration_minutes"
  ],
  "type": "object"
 },
 "name": "tork_hitl_create_cooldown"
}
