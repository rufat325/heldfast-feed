{
 "description": "Create a webhook for content and auth events",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collection_ids": {
    "description": "Optional collection ID filter",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "description": {
    "description": "Optional description",
    "type": "string"
   },
   "events": {
    "description": "Event names",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "description": "Webhook display name",
    "type": "string"
   },
   "payload": {
    "description": "Whether to include payload details",
    "type": "boolean"
   },
   "secret": {
    "description": "Optional HMAC secret",
    "type": "string"
   },
   "sources": {
    "description": "Event sources (e.g. cms, api)",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "status": {
    "description": "Webhook active status",
    "type": "boolean"
   },
   "url": {
    "description": "Destination URL",
    "type": "string"
   }
  },
  "required": [
   "name",
   "url",
   "events",
   "sources"
  ],
  "type": "object"
 },
 "name": "create_webhook",
 "title": "Create Webhook"
}
