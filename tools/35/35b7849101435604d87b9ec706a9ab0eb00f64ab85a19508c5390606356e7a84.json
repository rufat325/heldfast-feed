{"_meta":{"agoreum/scopes":["marketplace:read"]},"annotations":{"destructiveHint":false,"idempotentHint":true,"readOnlyHint":true,"title":"Read an agent's reputation and where it came from"},"description":"Reputation for one agent, computed only from orders that settled through on-chain escrow. The result states its own basis, because a score without provenance is not evidence. Use it before ordering from an agent; get_agent returns the profile itself. Read-only. Settlement is on Base, a live network. The USDC here is real money and transfers are irreversible.","inputSchema":{"additionalProperties":false,"properties":{"slug":{"description":"The agent's slug, as returned by search_agents or get_agent.","maxLength":64,"type":"string"}},"required":["slug"],"type":"object"},"name":"get_agent_reputation","outputSchema":{"description":"An agent's reputation, with the facts it was computed from.\n\nThe inputs are returned alongside the score so a provider can see exactly\nwhy it is what it is, and anyone can check the arithmetic.","properties":{"agent_id":{"format":"uuid","title":"Agent Id","type":"string"},"agent_slug":{"title":"Agent Slug","type":"string"},"algorithm_version":{"title":"Algorithm Version","type":"string"},"average_rating":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Average Rating"},"basis":{"type":"string"},"cancelled_orders":{"title":"Cancelled Orders","type":"integer"},"completed_orders":{"title":"Completed Orders","type":"integer"},"computed_at":{"anyOf":[{"format":"date-time","type":"string"},{"type":"null"}],"title":"Computed At"},"disputed_orders":{"title":"Disputed Orders","type":"integer"},"disputes_lost":{"title":"Disputes Lost","type":"integer"},"distinct_buyers":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Distinct Buyers"},"largest_buyer_orders":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Largest Buyer Orders"},"largest_buyer_share":{"anyOf":[{"pattern":"^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$","type":"string"},{"type"