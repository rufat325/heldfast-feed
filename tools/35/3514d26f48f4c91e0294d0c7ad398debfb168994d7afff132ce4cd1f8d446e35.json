  "title": "Generate a document from a form"
 },
 "description": "Submit a filled Xenition form (from find_forms) to generate its document. Saves the result to the user's workspace and returns it. Usually called by the form widget when the user clicks submit.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "formId": {
    "description": "the form id from find_forms (e.g. 'invoice', 'resume')",
    "type": "string"
   },
   "title": {
    "description": "optional title for the produced document",
    "type": "string"
   },
   "values": {
    "additionalProperties": true,
    "description": "the filled field values, keyed by field name; a list field is an array of objects keyed by its sub-field names",
    "type": "object"
   }
  },
  "required": [
   "formId",
   "values"
  ],
  "type": "object"
 },
 "name": "submit_form",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "artifact": {
    "additionalProperties": false,
    "properties": {
