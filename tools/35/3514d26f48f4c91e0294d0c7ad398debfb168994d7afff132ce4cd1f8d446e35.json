      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "language": {
      "type": "string"
     },
     "openUrl": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "totalChars": {
      "type": "integer"
     },
     "truncated": {
      "type": "boolean"
     },
     "type": {
