{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Open a dispute"
 },
 "description": "Open a dispute on a delivered order awaiting the buyer's confirmation. Moves the order to 'issue_reported', records the issue and notifies admins. Requires the order's buyer (X-MCP-API-Key or buyer X-Agent-Token).",
 "inputSchema": {
  "properties": {
   "description": {
    "description": "Free-text description of the issue",
    "maxLength": 2000,
    "type": "string"
   },
   "order_id": {
    "description": "ForthClear order id",
    "type": "integer"
   },
   "photo_urls": {
    "description": "Optional evidence URLs",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "reason": {
    "description": "Dispute reason",
    "enum": [
     "missing_units",
     "quality_issue",
     "damaged",
     "wrong_item",
     "other"
    ],
    "type": "string"
   },
   "requested_action": {
    "description": "Resolution the buyer is requesting",
    "enum": [
     "refund",
     "replacement",
     "partial_refund"
    ],
    "type": "string"
   }
  },
  "required": [
   "order_id",
   "reason",
   "description"
  ],
  "type": "object"
 },
 "name": "open_dispute",
 "securitySchemes": [
  {
   "scopes": [
    "buyer:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Open a dispute"
}
