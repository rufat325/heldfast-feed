     "markPx",
     "oraclePx",
     "spotPx",
     "position",
     "spotBalance",
     "vaultEquity",
     "hlp",
     "withdrawable"
    ],
    "type": "string"
   },
   "perp": {
    "type": "number"
   },
   "token": {
    "type": "number"
   },
   "user": {
    "type": "string"
   },
   "vaultAddress": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "hl_precompile_read"
}
