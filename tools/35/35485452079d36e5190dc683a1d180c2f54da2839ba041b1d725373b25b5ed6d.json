{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update reviewed likelihood and impact pairs. Read the PRA page context and present the proposed changes to the user before setting reviewed to true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "qualityId": {
    "$ref": "#/properties/testLevelId"
   },
   "reviewed": {
    "const": true,
    "description": "Set to true only after explicit user approval of these exact PRA changes.",
    "type": "boolean"
   },
   "testLevelId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "updates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "impact": {
       "$ref": "#/properties/updates/items/properties/likelihood"
      },
      "likelihood": {
       "enum": [
        1,
        3,
        5
       ],
       "type": "number"
      },
      "pbsQualityItemId": {
       "$ref": "#/properties/testLevelId"
      }
     },
     "required": [
      "pbsQualityItemId",
      "likelihood",
      "impact"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "reviewed",
   "updates"
  ],
  "type": "object"
 },
 "name": "submit_pra_risk_updates",
 "title": "Submit reviewed PRA risk updates"
}
