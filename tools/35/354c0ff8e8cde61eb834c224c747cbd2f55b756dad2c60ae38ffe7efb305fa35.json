{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Make an earlier version of a hosted space live again. Only a version that was live before (rollback: true in versions) can be picked; it goes live at once without a new check. Needs sign-in.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "space": {
    "description": "The space's slug, as my_spaces or publish named it, e.g. pixel-racer.",
    "pattern": "^[a-z0-9-]{1,100}$",
    "type": "string"
   },
   "version": {
    "description": "The version number to make live again.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "space",
   "version"
  ],
  "type": "object"
 },
 "name": "rollback",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "pageUrl": {
    "type": "string"
   },
   "status": {
    "const": "live",
    "type": "string"
   },
   "version": {
    "additionalProperties": false,
    "properties": {
     "number": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "number"
    ],
    "type": "object"
   }
  },
  "required": [
   "version",
   "status",
   "pageUrl"
  ],
  "type": "object"
 },
 "title": "Roll back a space"
}
