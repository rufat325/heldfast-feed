  "readOnlyHint": false,
  "title": "Add contact"
 },
 "description": "Adds a recruiter or referrer contact to the account using the supplied contact details.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "company": {
    "description": "Company",
    "type": "string"
   },
   "email": {
    "description": "Email",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "linkedinUrl": {
    "description": "LinkedIn URL",
    "format": "uri",
    "type": "string"
   },
   "name": {
    "description": "Contact name",
    "type": "string"
   },
   "title": {
    "description": "Job title",
    "type": "string"
   }
  },
  "required": [
   "name",
   "company"
  ],
  "type": "object"
 },
 "name": "add_contact",
 "title": "Add contact"
}
