{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "$0.02 per call. Pay with x402 (USDC on Base) in _meta[\"x402/payment\"]; MPP (tempo) on the HTTP URL /v1/osha/history. Returns the OSHA inspections, violations and penalties on file for an employer in a state (optional city and zip), matched by name in the US Department of Labor's inspection and violation files, as establishments with a penalty roll-up; OSHA inspections only, so an employer with none has no record and an empty result is a paid 200; it is not a determination about the employer and is not endorsed or certified by the U.S. Department of Labor.",
 "inputSchema": {
  "additionalProperties": false,
  "description": "An employer and the state it works in; city and zip only narrow.",
  "properties": {
   "city": {
    "anyOf": [
     {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Inspection site city, case-insensitive. A hard filter.",
    "examples": [
     "Lubbock"
    ],
    "title": "City"
   },
   "employer": {
    "description": "Employer name, with at least one word that is not a generic trade word.",
    "examples": [
     "Walmart"
    ],
    "maxLength": 150,
    "minLength": 2,
    "title": "Employer",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Establishments returned, 1-25.",
    "maximum": 25,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "min_score": {
    "default": 85,
    "description": "Name score floor, 70-100.",
    "maximum": 100,
    "minimum": 70,
    "title": "Min Score",
    "type": "integer"
   },
   "state": {
    "description": "US state or territory code. A hard filter on the inspection site.",
    "examples": [
     "TX"
    ],
    "maxLength": 2,
    "minLength": 2,
    "title": "State",
    "type": "string"
   },
   "zip": {
    "anyOf": [
     {
      "pattern": "^[0-9]{5}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Five-digit inspection site ZIP. A hard filter.",
    "examples": [
     "79404"
    ],
    "title": "Zip"
   }
  },
  "required": [
   "employer",
   "state"
  ],
  "title": "OshaHistoryRequest",
  "type": "object"
 },
 "name": "osha_history",
 "outputSchema": {
