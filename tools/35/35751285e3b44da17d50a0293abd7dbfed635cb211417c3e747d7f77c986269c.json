       "type": "string"
      },
      "title": "Names",
      "type": "array"
     },
     "rollup": {
      "$ref": "#/$defs/OshaRollup"
     },
     "state": {
      "title": "State",
      "type": "string"
     },
     "zip": {
      "title": "Zip",
      "type": "string"
     }
    },
    "required": [
