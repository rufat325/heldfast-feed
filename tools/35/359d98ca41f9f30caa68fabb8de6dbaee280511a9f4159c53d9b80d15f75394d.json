{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Calculate Destination"},"description":"Calculate a destination point given a starting point, bearing, and distance using geodesic (great-circle) straight-line offset. Useful for \"find a point 5km north of X\", constructing search offsets, or computing waypoints. Bearing: 0=north, 90=east, 180/-180=south, -90=west. Note: this calculates a straight-line geographic offset, not road-network distance. Works offline without API calls.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"bearing":{"description":"Direction of travel in degrees (0=north, 90=east, -90=west, 180=south)","maximum":180,"minimum":-180,"type":"number"},"distance":{"description":"Distance to travel","exclusiveMinimum":0,"type":"number"},"origin":{"description":"Starting point","properties":{"latitude":{"maximum":90,"minimum":-90,"type":"number"},"longitude":{"maximum":180,"minimum":-180,"type":"number"}},"required":["longitude","latitude"],"type":"object"},"units":{"default":"meters","description":"Units for the distance","enum":["kilometers","miles","meters","feet"],"type":"string"}},"required":["origin","distance","bearing"],"type":"object"},"name":"destination_tool","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"bearing":{"description":"Bearing used","type":"number"},"destination":{"additionalProperties":false,"description":"The calculated destination point","properties":{"latitude":{"type":"number"},"longitude":{"type":"number"}},"required":["longitude","latitude"],"type":"object"},"distance":{"description":"Distance traveled","type":"number"},"units":{"description":"Distance units","type":"string"}},"required":["destination","distance","bearing","units"],"type":"object"},"title":"Calculate Destination"}
