{
 "description": "Returns a chosen per-symbol view (statistics or profile) for up to 25 symbols in one call, to avoid one request per symbol. Unresolved symbols are listed under data.unresolved.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "symbols": {
    "description": "Up to 25 ticker or Macroaxis symbol identifiers.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "view": {
    "description": "Optional per-symbol view: statistics (default) or profile.",
    "type": "string"
   }
  },
  "required": [
   "symbols"
  ],
  "type": "object"
 },
 "name": "get_symbols_batch",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
   "data": {
    "type": "object"
   },
   "mcpContext": {
    "additionalProperties": false,
    "properties": {
     "currencyCode": {
      "type": [
       "string",
       "null"
      ]
     },
     "freshness": {
      "additionalProperties": false,
      "properties": {
       "responseAsOfDate": {
        "type": [
         "string",
         "null"
        ]
       },
       "retrievedAt": {
        "type": "string"
       },
       "sourceAgeDays": {
        "type": [
         "number",
         "null"
        ]
       },
       "sourceDateAvailable": {
        "type": "boolean"
       }
      },
      "required": [
       "retrievedAt",
       "responseAsOfDate",
       "sourceAgeDays",
       "sourceDateAvailable"
      ],
      "type": "object"
     },
     "reportingPeriod": {
      "additionalProperties": false,
      "properties": {
       "endDate": {
        "type": [
         "string",
         "null"
        ]
       },
       "label": {
        "type": [
         "string",
         "null"
        ]
       },
       "startDate": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "label",
       "startDate",
       "endDate"
      ],
      "type": "object"
     },
     "source": {
      "type": [
       "string",
       "null"
      ]
     },
     "sourceDate": {
      "type": [
       "string",
       "null"
      ]
     },
     "units": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "path": {
         "type": "string"
        },
        "unit": {
         "type": "string"
        }
       },
       "required": [
        "path",
        "unit"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "currencyCode",
     "units",
     "reportingPeriod",
     "source",
     "sourceDate",
     "freshness"
    ],
    "type": "object"
   },
   "metadata": {
    "type": "object"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "mcpContext"
  ],
  "type": "object"
 }
}
