    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "servings": {
    "description": "Rescale the quantities to this many, up to 1000. Left out, the recipe comes back as published.",
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
