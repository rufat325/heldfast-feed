{
 "description": "Get turn-by-turn driving/biking/walking directions between two points in India, including distance, duration, and step-by-step instructions.",
 "inputSchema": {
  "properties": {
   "destination": {
    "description": "End point as 'lat,lng'",
    "type": "string"
   },
   "origin": {
    "description": "Start point as 'lat,lng'",
    "type": "string"
   },
   "profile": {
    "description": "Travel mode (default: driving)",
    "enum": [
     "driving",
     "biking",
     "walking"
    ],
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination"
  ],
  "type": "object"
 },
 "name": "get_directions"
}
