 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants help writing part of a response to a public tender: a quality question answer, social value response, method statement, case study, company overview, cover letter or clarification question. Returns a drafting brief built from the tender's award criteria, word limits and the user's facts, so the draft answers what evaluators will score. Write the draft from the brief. Do not use for job applications, grant applications or private-sector sales proposals.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "notes": {
    "description": "Facts the draft should use, e.g. \"we cut response times by 30% for Bristol City Council in 2025\".",
    "type": "string"
   },
   "question": {
    "description": "The buyer's question, word for word, when the user has it.",
    "type": "string"
   },
   "section": {
    "description": "Which part of the bid to draft, e.g. \"social_value\".",
    "enum": [
     "quality_answer",
     "social_value",
     "method_statement",
     "case_study",
     "company_overview",
     "cover_letter",
     "clarification_question"
    ],
    "type": "string"
   },
   "tender_reference": {
    "description": "The tender being answered, e.g. \"005566-2026\".",
    "minLength": 3,
    "type": "string"
   },
   "word_limit": {
    "description": "The buyer's word limit for this answer, e.g. 500.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "section"
  ],
  "type": "object"
 },
 "name": "draft_bid_response",
