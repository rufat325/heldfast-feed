{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search resources. Use this tool to search for videos, channels, playlists, and other resources.",
 "inputSchema": {
  "properties": {
   "channel_id": {
    "description": "Filter on resources belonging to this channelId",
    "type": "string"
   },
   "channel_type": {
    "default": "channelTypeUnspecified",
    "description": "channelTypeUnspecified|any|show",
    "enum": [
     "channelTypeUnspecified",
     "any",
     "show"
    ],
    "type": "string"
   },
   "event_type": {
    "default": "none",
    "description": "none|upcoming|live|completed",
    "enum": [
     "none",
     "upcoming",
     "live",
     "completed"
    ],
    "type": "string"
   },
   "for": {
    "description": "mine|developer|contentOwner",
    "enum": [
     "mine",
     "developer",
     "contentOwner"
    ],
    "type": "string"
   },
   "location": {
    "description": "Filter on location of the video",
    "type": "string"
   },
   "location_radius": {
    "description": "Filter on distance from the location",
    "type": "string"
   },
   "max_results": {
    "default": 5,
    "description": "The maximum number of items that should be returned, 0 for no limit",
    "minimum": 0,
    "type": "number"
   },
   "on_behalf_of_content_owner": {
    "description": "ID of the content owner, for YouTube content partners",
    "type": "string"
   },
   "order": {
    "default": "relevance",
    "description": "searchSortUnspecified|date|rating|viewCount|relevance|title|videoCount",
    "enum": [
     "searchSortUnspecified",
     "date",
     "rating",
     "viewCount",
     "relevance",
     "title",
     "videoCount"
    ],
    "type": "string"
   },
   "output": {
    "default": "json",
    "description": "json|yaml|table",
    "enum": [
     "json",
     "yaml",
     "table"
    ],
    "type": "string"
   },
   "parts": {
    "default": [
     "id",
     "snippet"
    ],
    "description": "Comma separated parts",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "published_after": {
    "description": "Filter on resources published after this date",
    "type": "string"
   },
   "published_before": {
    "description": "Filter on resources published before this date",
    "type": "string"
   },
   "q": {
    "description": "Textual search terms to match",
    "type": "string"
   },
   "region_code": {
    "description": "Display the content as seen by viewers in this country",
    "type": "string"
   },
   "relevance_language": {
    "description": "Return results relevant to this language",
    "type": "string"
   },
   "safe_search": {
    "default": "moderate",
    "description": "safeSearchSettingUnspecified|none|moderate|strict",
    "enum": [
     "safeSearchSettingUnspecified",
     "none",
     "moderate",
     "strict"
    ],
    "type": "string"
   },
   "topic_id": {
    "description": "Restrict results to a particular topic",
    "type": "string"
   },
   "types": {
    "description": "Restrict results to a particular set of resource types from One Platform",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "video_caption": {
    "default": "any",
    "description": "videoCaptionUnspecified|any|closedCaption|none",
    "enum": [
     "videoCaptionUnspecified",
     "any",
     "closedCaption",
     "none"
    ],
    "type": "string"
   },
   "video_category_id": {
    "description": "Filter on videos in a specific category",
    "type": "string"
   },
   "video_definition": {
    "description": "Filter on the definition of the videos",
    "enum": [
     "any",
     "high",
     "standard"
    ],
    "type": "string"
   },
   "video_dimension": {
    "default": "any",
    "description": "any|2d|3d",
    "enum": [
     "any",
     "2d",
     "3d"
    ],
    "type": "string"
   },
   "video_duration": {
    "default": "any",
    "description": "videoDurationUnspecified|any|short|medium|long",
    "enum": [
     "videoDurationUnspecified",
     "any",
     "short",
     "medium",
     "long"
    ],
    "type": "string"
   },
   "video_embeddable": {
    "description": "videoEmbeddableUnspecified|any|true",
    "enum": [
     "videoEmbeddableUnspecified",
     "any",
     "true"
    ],
    "type": "string"
   },
   "video_license": {
    "description": "any|youtube|creativeCommon",
    "enum": [
     "any",
     "youtube",
     "creativeCommon"
    ],
    "type": "string"
   },
   "video_paid_product_placement": {
    "description": "videoPaidProductPlacementUnspecified|any|true",
    "enum": [
     "videoPaidProductPlacementUnspecified",
     "any",
     "true"
    ],
    "type": "string"
   },
   "video_syndicated": {
    "description": "videoSyndicatedUnspecified|any|true",
    "enum": [
     "videoSyndicatedUnspecified",
     "any",
     "true"
    ],
    "type": "string"
   },
   "video_type": {
    "description": "videoTypeUnspecified|any|movie|episode",
    "enum": [
     "videoTypeUnspecified",
     "any",
     "movie",
     "episode"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search-list",
 "title": "Search resources"
}
