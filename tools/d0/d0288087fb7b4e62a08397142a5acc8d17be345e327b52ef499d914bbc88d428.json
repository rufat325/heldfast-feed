{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The best traders on one Hyperliquid market, ranked by profit factor then win rate, among wallets with at least 5 closed trades there.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Number of traders (1-50, default 20)",
    "type": "number"
   },
   "market": {
    "description": "Market symbol (e.g. \"BTC-PERP\", \"xyz:NVDA-PERP\")",
    "type": "string"
   },
   "window": {
    "description": "Lookback window. Default 30d",
    "enum": [
     "7d",
     "30d",
     "90d"
    ],
    "type": "string"
   }
  },
  "required": [
   "market"
  ],
  "type": "object"
 },
 "name": "get_market_leaders",
 "outputSchema": {
  "description": "Best traders on one market",
  "properties": {
   "market": {
    "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
   },
   "traders": {
    "description": "Traders",
    "items": {
     "description": "One trader",
     "properties": {
      "address": {
       "description": "Wallet address (0x\u2026)"
      },
      "avg_notional_usd": {
       "description": "Average trade size in USD"
      },
      "last_trade_ms": {
       "description": "Last trade, Unix milliseconds"
      },
      "profit_factor": {
       "description": "Gross profit divided by gross loss"
      },
      "realized_pnl_usd": {
       "description": "Realized PnL in USD"
      },
      "trades": {
       "description": "Closed trades in the window"
      },
      "win_rate": {
       "description": "Share of closed trades that were profitable, 0 to 1"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "window": {
    "description": "Lookback window, e.g. \"30d\""
   }
  },
  "type": "object"
 }
}
