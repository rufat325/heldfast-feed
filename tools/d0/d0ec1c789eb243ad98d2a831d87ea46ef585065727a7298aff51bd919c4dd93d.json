{
 "description": "Run a deployed HTTP function. function_name excludes method prefix.\nExample: \"get_Products\" \u2192 function_name=\"Products\", method=\"GET\"",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "function_name": {
    "description": "Function name without method prefix (e.g. 'Products')",
    "type": "string"
   },
   "method": {
    "default": "POST",
    "description": "HTTP method",
    "enum": [
     "GET",
     "POST",
     "PUT",
     "PATCH"
    ],
    "type": "string"
   },
   "params": {
    "additionalProperties": {},
    "description": "Parameters",
    "type": "object"
   }
  },
  "required": [
   "function_name"
  ],
  "type": "object"
 },
 "name": "run_function"
}
