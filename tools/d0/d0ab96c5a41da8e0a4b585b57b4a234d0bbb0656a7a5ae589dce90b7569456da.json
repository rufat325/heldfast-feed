{
 "description": "Complete a trace. Auto-calculates total duration, event counts, and span counts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "outcome": {
    "description": "Final outcome of the traced task",
    "enum": [
     "success",
     "failure",
     "partial",
     "timeout"
    ],
    "type": "string"
   },
   "summary": {
    "description": "Optional summary of what happened",
    "type": "string"
   },
   "trace_id": {
    "description": "Trace to complete",
    "type": "string"
   }
  },
  "required": [
   "trace_id",
   "outcome"
  ],
  "type": "object"
 },
 "name": "trace_end"
}
