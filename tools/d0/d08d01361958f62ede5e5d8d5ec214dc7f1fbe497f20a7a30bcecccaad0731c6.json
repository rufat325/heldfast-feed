{
 "description": "List project coding/governance rules from rules/*.yaml (enforceable standards and policies). For Cursor agent skills (Markdown/MDC under cursor skills/), use list_skills instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "enum": [
     "architecture",
     "backend",
     "frontend",
     "database",
     "security",
     "testing",
     "documentation",
     "git",
     "prompt-engineering",
     "performance",
     "accessibility",
     "ui",
     "naming",
     "logging",
     "error-handling",
     "api-design",
     "devops",
     "ci-cd",
     "typescript",
     "javascript",
     "python",
     "java",
     "go",
     "rust",
     "csharp",
     "cpp",
     "ruby",
     "php",
     "kotlin",
     "swift",
     "general"
    ],
    "type": "string"
   },
   "kind": {
    "enum": [
     "enforceable",
     "advisory"
    ],
    "type": "string"
   },
   "priority": {
    "enum": [
     "critical",
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "active",
     "deprecated"
    ],
    "type": "string"
   },
   "summary": {
    "description": "If true (default), return compact summaries instead of full rules",
    "type": "boolean"
   },
   "tags": {
    "description": "Tags that must all match",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "list_rules",
 "title": "List rules"
}
