{
 "annotations": {
  "readOnlyHint": true,
  "title": "Find nearest entity"
 },
 "description": "Find the single nearest tracked entity matching the given filter. Returns {found:false} if none match.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "format": {
    "description": "Response detail level; \"concise\" (default) or \"detailed\"",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "kind": {
    "description": "Entity kind, e.g. \"Hostile mobs\"",
    "type": "string"
   },
   "maxDistance": {
    "description": "Only entities within this many blocks",
    "minimum": 0,
    "type": "number"
   },
   "mobType": {
    "description": "Mob type/display name, e.g. \"Zombie\"",
    "type": "string"
   },
   "name": {
    "description": "Entity name, e.g. \"zombie\", \"item\"",
    "type": "string"
   },
   "type": {
    "description": "Entity type, e.g. \"player\", \"mob\", \"object\"",
    "type": "string"
   },
   "username": {
    "description": "Player username (players only)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_nearest_entity"
}
