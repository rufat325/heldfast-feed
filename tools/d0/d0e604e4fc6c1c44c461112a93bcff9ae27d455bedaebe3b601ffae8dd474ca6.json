{
 "description": "Fetch the full Markdown source of one article by its slug, as returned by search_articles.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "ar",
     "de",
     "es",
     "fr",
     "hi",
     "id",
     "it",
     "pl",
     "pt",
     "ru",
     "zh",
     "ja",
     "nl"
    ],
    "type": "string"
   },
   "slug": {
    "description": "Article slug, e.g. \"ozempic-and-alcohol\"",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_article",
 "title": "Get a Shotlee article as Markdown"
}
