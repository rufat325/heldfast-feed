{
 "description": "Delete a specific memory by key.\n\nRequires write access when connected with OAuth.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "description": "Memory key to delete",
    "type": "string"
   },
   "scope": {
    "description": "Memory scope",
    "enum": [
     "workspace",
     "workflow"
    ],
    "type": "string"
   },
   "workflowId": {
    "description": "Workflow ID for workflow-scoped memory",
    "type": "string"
   }
  },
  "required": [
   "key"
  ],
  "type": "object"
 },
 "name": "delete_memory"
}
