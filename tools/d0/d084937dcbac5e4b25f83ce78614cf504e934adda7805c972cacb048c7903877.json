{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create event (drafts when it has guests)"
 },
 "description": "Two kinds of event. Mode \"classic\" is a free share-the-link poll: it asks about days (or a morning/afternoon/evening), has NO guest list and NO exact times \u2014 anyone with the link votes \u2014 and goes live immediately. Mode \"ai\" is an autopilot event: it takes a guest list (every guest needs an email; this door can only mail) and exact start times, becomes a draft on the organizer's drafts page, and nothing is mailed or charged until it is sent (send_invites, one credit). A classic create carrying guests or an exact time is refused, never silently converted. Needs the write permission.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dates": {
    "items": {
     "anyOf": [
      {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      {
       "properties": {
        "date": {
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "type": "string"
        },
        "daypart": {
         "anyOf": [
          {
           "enum": [
            "morning",
            "afternoon",
            "evening"
           ],
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "endTime": {
         "anyOf": [
          {
           "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "startTime": {
         "anyOf": [
          {
           "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "date"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 300,
    "minItems": 1,
    "type": "array"
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 1000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "invites": {
    "items": {
     "properties": {
      "email": {
       "type": "string"
      },
      "name": {
       "maxLength": 80,
       "type": "string"
      },
      "phone": {
       "maxLength": 30,
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 75,
    "type": "array"
   },
   "mode": {
    "enum": [
     "classic",
     "ai"
    ],
    "type": "string"
   },
   "timeLabel": {
    "anyOf": [
     {
      "maxLength": 60,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "title": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "mode",
   "dates"
  ],
  "type": "object"
 },
 "name": "create_event",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "console_url": {
    "type": "string"
   },
   "draft_id": {
    "type": "string"
   },
   "event_id": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "draft",
     "event"
    ],
    "type": "string"
   },
   "next": {
    "type": "string"
   },
   "public_url": {
    "type": "string"
   },
   "review_url": {
    "type": "string"
   },
   "spends_credit": {
    "type": "boolean"
   }
  },
  "required": [
   "kind"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "events:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Create event (drafts when it has guests)"
}
