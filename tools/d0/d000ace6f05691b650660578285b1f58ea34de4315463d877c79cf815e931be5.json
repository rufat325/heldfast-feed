{
 "description": "Get the most-used contracts ranked by activity over a timeframe.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "network": {
    "description": "Network to query. Defaults to the server's configured network (mainnet).",
    "enum": [
     "mainnet",
     "sepolia"
    ],
    "type": "string"
   },
   "order": {
    "description": "Sort order.",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "orderBy": {
    "description": "Metric to rank by.",
    "enum": [
     "account_calls",
     "unique_callers",
     "unique_transactions"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based). Defaults to 1.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "description": "Items per page: 10, 25, 50, or 100. Defaults to 25. Keep small to save context.",
    "enum": [
     10,
     25,
     50,
     100
    ],
    "type": "number"
   },
   "q": {
    "description": "Search query.",
    "type": "string"
   },
   "timeframe": {
    "description": "Time window.",
    "enum": [
     "1d",
     "7d",
     "30d"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_top_contracts_stats"
}
