{
 "description": "Store OAuth tokens for a CRM location after OAuth callback. This enables auto-auth for all CRM tools on that location.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "OAuth access token",
    "type": "string"
   },
   "client_id": {
    "description": "Marketplace app client ID (default: 0nCORE app)",
    "type": "string"
   },
   "client_secret": {
    "description": "Marketplace app client secret (default: 0nCORE app)",
    "type": "string"
   },
   "company_id": {
    "description": "Company ID",
    "type": "string"
   },
   "expires_in": {
    "description": "Token TTL in seconds (default 86400)",
    "type": "number"
   },
   "location_id": {
    "description": "CRM location ID",
    "type": "string"
   },
   "refresh_token": {
    "description": "OAuth refresh token",
    "type": "string"
   }
  },
  "required": [
   "location_id",
   "access_token",
   "refresh_token"
  ],
  "type": "object"
 },
 "name": "crm_oauth_connect"
}
