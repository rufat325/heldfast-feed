 "description": "Audit one Avro schema for what it makes impossible later. Reports a field with no default, which cannot be removed without breaking readers; a nullable field with no default; a null default where null is not the first union branch, which is invalid; an enum with no default, which makes adding a symbol permanently breaking; an absent namespace on a top-level record; a logical type on a base the specification disallows; and a binary float on a monetary field name. Pay 120000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "require_documentation": {
    "description": "Also report records and fields with no doc. Defaults to false.",
    "example": true,
    "type": "boolean"
   },
   "schema": {
    "description": "The schema to audit. An Avro schema, as a JSON object or as JSON text, at most 262144 bytes. Nothing is fetched and no registry is consulted, so the documents supplied are the whole input.",
    "example": {
     "fields": [
      {
       "name": "invoice_id",
       "type": "string"
      },
      {
       "name": "amount",
       "type": "double"
      },
      {
       "name": "issued_at",
       "type": {
        "logicalType": "timestamp-millis",
        "type": "string"
       }
      },
      {
       "default": null,
       "name": "memo",
       "type": [
        "string",
        "null"
       ]
      },
      {
       "name": "state",
       "type": {
        "name": "State",
        "symbols": [
         "DRAFT",
         "SENT"
        ],
        "type": "enum"
       }
      }
     ],
     "name": "Invoice",
     "type": "record"
    },
    "type": [
     "object",
     "string"
    ]
   }
  },
  "required": [
   "schema"
  ],
  "type": "object"
 },
 "name": "avro_schema_audit",
