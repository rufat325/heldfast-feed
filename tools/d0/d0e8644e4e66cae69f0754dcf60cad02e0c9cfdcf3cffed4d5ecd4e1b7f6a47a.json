 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search every mailbox"
 },
 "description": "Search every mailbox you have connected in one call. The answer names the mailbox each result came from, names any mailbox it could not search, and is merged newest first by when each message arrived, a thread by its newest. The mail of every mailbox mailboxes_list names is read and written with Multi Mail's tools.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "by": {
    "description": "message, the default, answers each matching message; thread answers each matching thread with every message in it.",
    "enum": [
     "message",
     "thread"
    ],
    "type": "string"
   },
   "maxResults": {
    "description": "How many results to take from each mailbox.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "A Gmail mailbox reads Gmail's search operators: from:, to:, cc:, subject:, is:unread, is:starred, in:sent, has:attachment, filename:pdf, after:2026/01/31, before:, newer_than:7d, larger:5M, OR, -word and ( ). An Outlook mailbox reads Microsoft's keyword query language - from:, to:, cc:, subject:, body:, received:, hasAttachments:true, plain words and quoted phrases, AND, OR and NOT in capitals - and never a filter expression such as isRead eq false. A few distinctive words, with OR between alternatives, miss less than a copied subject line or sentence. Where the mailboxes are of different providers only from:, to:, subject:, plain words and quoted phrases are read alike, with no AND, OR or NOT.",
    "minLength": 1,
    "type": "string"
   },
   "view": {
    "description": "summary, the default, carries each message's subject and snippet; headers leaves both out.",
    "enum": [
     "summary",
     "headers"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
