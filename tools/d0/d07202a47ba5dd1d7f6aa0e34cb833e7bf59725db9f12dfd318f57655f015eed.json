    "maximum": 50,
    "minimum": 0,
    "type": "number"
   },
   "start": {
    "default": "2026-11-01",
    "description": "First payment date (YYYY-MM-DD)",
    "format": "date",
    "type": "string"
   },
   "term": {
    "default": 30,
    "description": "Loan term",
    "maximum": 600,
    "minimum": 1,
    "type": "number"
   },
   "unit": {
    "default": "years",
    "description": "Term in",
    "enum": [
     "years",
     "months"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "amortization_calculator",
 "title": "Amortization Calculator"
}
