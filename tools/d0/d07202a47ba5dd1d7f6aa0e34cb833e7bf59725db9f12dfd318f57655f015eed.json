{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "This amortization calculator splits every payment into principal and interest, shows your payoff date and what extra payments save, and exports to CSV. Web page: https://calcbright.com/amortization-calculator",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "amount": {
    "default": 300000,
    "description": "Loan amount",
    "maximum": 10000000000,
    "minimum": 100,
    "type": "number"
   },
   "currency": {
    "default": "USD",
    "description": "Currency",
    "enum": [
     "USD",
     "EUR",
     "GBP",
     "JPY",
     "CAD",
     "AUD",
     "CHF",
     "CNY",
     "INR",
     "PKR",
     "AED",
     "SAR",
     "NZD",
     "SGD",
     "HKD",
     "SEK",
     "NOK",
     "DKK",
     "PLN",
     "TRY",
     "ZAR",
     "BRL",
     "MXN",
     "KRW",
     "THB",
     "MYR",
     "IDR",
     "PHP",
     "BDT",
     "EGP",
     "NGN",
     "KWD",
     "QAR",
     "BHD",
     "OMR",
     "RUB"
    ],
    "type": "string"
   },
   "extra": {
    "default": 0,
    "description": "Extra payment / month Added to principal every month from the first payment.",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "rate": {
    "default": 6.5,
