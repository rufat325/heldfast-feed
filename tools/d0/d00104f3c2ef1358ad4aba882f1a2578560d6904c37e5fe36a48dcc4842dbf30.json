{
 "description": "Update a loyalty program balance. Supports absolute set or relative delta. Auto-creates the program if it doesn't exist (requires display_name on first call).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^[+-]?\\d+(\\.\\d+)?$",
      "type": "string"
     }
    ],
    "description": "Set absolute balance"
   },
   "cpp_valuation": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^[+-]?\\d+(\\.\\d+)?$",
      "type": "string"
     }
    ],
    "description": "Default cents-per-point valuation"
   },
   "currency": {
    "description": "Currency type",
    "enum": [
     "points",
     "miles"
    ],
    "type": "string"
   },
   "delta": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^[+-]?\\d+(\\.\\d+)?$",
      "type": "string"
     }
    ],
    "description": "Relative change (e.g., +12500 or -88000)"
   },
   "display_name": {
    "description": "Program display name (required when creating a new program)",
    "type": "string"
   },
   "notes": {
    "description": "Freeform notes",
    "type": "string"
   },
   "owner": {
    "description": "Owner name",
    "type": "string"
   },
   "program_key": {
    "description": "Program key (e.g., 'amex_mr', 'aa_advantage', 'hilton_honors')",
    "type": "string"
   },
   "program_type": {
    "description": "Program type",
    "enum": [
     "bank",
     "airline",
     "hotel"
    ],
    "type": "string"
   }
  },
  "required": [
   "program_key"
  ],
  "type": "object"
 },
 "name": "update_balance"
}
