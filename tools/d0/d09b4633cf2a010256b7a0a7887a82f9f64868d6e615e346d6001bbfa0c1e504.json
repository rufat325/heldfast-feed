      "x-maxUtf8Bytes": 262144
     },
     {
      "items": {
       "$ref": "#/$defs/JsonValue"
      },
      "maxItems": 10000,
      "type": "array"
     },
     {
      "additionalProperties": {
       "$ref": "#/$defs/JsonValue"
      },
      "maxProperties": 256,
      "propertyNames": {
       "maxLength": 256,
       "x-maxUtf8Bytes": 256
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "x-maxDepth": 16,
    "x-maxNodes": 10000
   }
  },
  "additionalProperties": false,
  "properties": {
   "fingerprint": {
    "default": "",
