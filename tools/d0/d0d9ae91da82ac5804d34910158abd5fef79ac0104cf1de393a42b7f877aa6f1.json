{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a public list link"
 },
 "description": "Publishes a preview_shortlist snapshot as a link. It requires the previewKey that preview_shortlist returned, and confirmPublic: true. The server itself requests no confirmation from the user: confirmPublic: true records the caller's statement that the user reviewed this snapshot and confirmed publishing it. The server rebuilds the snapshot and creates nothing when the selection or the snapshot no longer matches that previewKey: a different campaign, selection or order of leadIds, a different note, an includeRationale value that changes the snapshot, a prospect changed or removed, or the campaign renamed since the preview. The link makes the snapshot viewable by anyone who has it for 30 days unless it is revoked with revoke_shortlist. This does not share the conversation or invite anyone into the workspace. Returns the URL, list id and expiry to the requester; sending it to another person is a separate user action.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "campaignId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "confirmPublic": {
    "const": true,
    "type": "boolean"
   },
   "includeRationale": {
    "description": "When true, each person in the snapshot carries a fit rating (1\u20135, or null when none is stored) and a why-matched explanation; when false, the rating is null and the explanation empty.",
    "type": "boolean"
   },
   "leadIds": {
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "note": {
    "maxLength": 300,
    "type": "string"
   },
   "previewKey": {
    "maxLength": 64,
    "minLength": 64,
    "type": "string"
   },
   "title": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "campaignId",
   "leadIds",
   "title",
   "note",
   "includeRationale",
   "previewKey",
   "confirmPublic"
  ],
  "type": "object"
 },
 "name": "create_shortlist",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "expiresAt": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "snapshot": {
    "additionalProperties": {},
    "properties": {
     "note": {
      "type": "string"
     },
     "people": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "companyName": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "position": {
         "type": "string"
        },
        "profileUrl": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "rationale": {
         "type": "string"
        },
        "score": {
         "anyOf": [
          {
           "maximum": 5,
           "minimum": 1,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "name",
        "position",
        "companyName",
        "profileUrl",
        "rationale"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "title",
     "note",
     "people"
    ],
    "type": "object"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "url",
   "expiresAt",
   "snapshot"
  ],
  "type": "object"
 },
 "title": "Create a public list link"
}
