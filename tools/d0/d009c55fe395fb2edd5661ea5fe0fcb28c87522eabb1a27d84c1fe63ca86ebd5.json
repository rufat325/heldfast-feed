{
 "description": "Submit a review after completing a journey. Rating is 1-10. One review per journey.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "rating": {
    "description": "Rating from 1 (poor) to 10 (transcendent)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "review": {
    "description": "Written review of the experience",
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   }
  },
  "required": [
   "rating",
   "review"
  ],
  "type": "object"
 },
 "name": "submit_review"
}
