{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an LLM or MCP-tool guardrail. LLM guardrails require checks and actions; MCP-tool guardrails can be created first and mapped to servers afterward. The new version becomes the policy anchor for downstream use.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actions": {
    "description": "Actions to take when guardrail checks pass or fail",
    "properties": {
     "async": {
      "description": "Whether to run checks asynchronously",
      "type": "boolean"
     },
     "deny": {
      "description": "Whether to deny the request on check failure",
      "type": "boolean"
     },
     "message": {
      "description": "Message to return when guardrail triggers",
      "type": "string"
     },
     "on_fail": {
      "description": "Feedback configuration for failed checks",
      "properties": {
       "metadata": {
        "additionalProperties": {},
        "description": "Additional metadata",
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "value": {
        "description": "Feedback value",
        "type": "number"
       },
       "weight": {
        "description": "Feedback weight",
        "type": "number"
       }
      },
      "type": "object"
     },
     "on_fail_action": {
      "description": "Simple action on failure (e.g., 'block')",
      "type": "string"
     },
     "on_success": {
      "description": "Feedback configuration for successful checks",
      "properties": {
       "metadata": {
        "additionalProperties": {},
        "description": "Additional metadata",
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "value": {
        "description": "Feedback value",
        "type": "number"
       },
       "weight": {
        "description": "Feedback weight",
        "type": "number"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "checks": {
    "description": "Checks to apply; at least one entry. Required when target is llm.",
    "items": {
     "properties": {
      "id": {
       "description": "Check identifier (e.g., 'default.jwt', 'default.pii')",
       "type": "string"
      },
      "is_enabled": {
       "description": "Whether the check is enabled",
       "type": "boolean"
      },
      "name": {
       "description": "Display name for the check",
       "type": "string"
      },
      "parameters": {
       "additionalProperties": {},
       "description": "Check-specific configuration. Supported examples include requestParametersCheck and parameters.forwardHeaders; forwarded headers can expose sensitive values, so allow only the minimum required names.",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "description": "Name of the guardrail",
    "type": "string"
   },
   "organisation_id": {
    "description": "Organisation ID (required if workspace_id not provided)",
    "type": "string"
   },
   "target": {
    "description": "LLM traffic by default, or MCP tool calls",
    "enum": [
     "llm",
     "mcp_tools"
    ],
    "type": "string"
   },
   "workspace_id": {
    "description": "Workspace ID to create the guardrail in",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_guardrail",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
