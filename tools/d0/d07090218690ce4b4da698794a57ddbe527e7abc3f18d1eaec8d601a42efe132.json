{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Log time against a SWSD incident, problem, change, or release. Required: object_type, id, name, minutes_parsed. WRITE \u2014 honors SWSD_WRITE_MODE and does not retry on transient failure.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Parent record id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "minutes_parsed": {
    "description": "Number of minutes to log. SWSD field name is minutes_parsed.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Time entry description.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "object_type": {
    "description": "Parent SWSD object type.",
    "enum": [
     "incidents",
     "problems",
     "changes",
     "releases"
    ],
    "type": "string"
   }
  },
  "required": [
   "object_type",
   "id",
   "name",
   "minutes_parsed"
  ],
  "type": "object"
 },
 "name": "swsd_log_time"
}
