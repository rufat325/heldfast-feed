{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Task"
 },
 "description": "Update properties of an existing task. Supports confirm and idempotency validation.",
 "inputSchema": {
  "properties": {
   "assignedToName": {
    "description": "Optional updated assigned worker name",
    "type": "string"
   },
   "assignedToUserId": {
    "description": "Optional updated assigned worker user ID",
    "type": "string"
   },
   "confirm": {
    "description": "Set to true to commit, false for dry-run preview",
    "type": "boolean"
   },
   "description": {
    "description": "Optional updated description",
    "type": "string"
   },
   "dueDate": {
    "description": "Optional updated due date (YYYY-MM-DD, or null/\"\" to clear)",
    "type": "string"
   },
   "farmId": {
    "description": "The unique farm ID",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Unique request idempotency key",
    "type": "string"
   },
   "isRecurring": {
    "description": "Optional flag indicating if the task recurs",
    "type": "boolean"
   },
   "priority": {
    "description": "Optional updated priority (Low, Medium, or High)",
    "enum": [
     "Low",
     "Medium",
     "High"
    ],
    "type": "string"
   },
   "recurrencePattern": {
    "description": "Optional recurrence pattern",
    "enum": [
     "Daily",
     "Every Second Day",
     "Weekly",
     "Every 2 Weeks",
     "Monthly",
     "Every 2 Months",
     "Quarterly",
     "Yearly"
    ],
    "type": "string"
   },
   "taskId": {
    "description": "The unique task ID to update",
    "type": "string"
   },
   "title": {
    "description": "Optional updated task title",
    "type": "string"
   }
  },
  "required": [
   "farmId",
   "taskId"
  ],
  "type": "object"
 },
 "name": "update_task"
}
