{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Full detail for a single booth: its name, public link, currency, screen size, and the live status of the device running it \u2014 whether it is online, when it was last seen, app version, and camera/printer/internet state. Call this when the operator asks about one specific booth, or whether a booth is working. Get the project id from list_projects first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "description": "Project id from list_projects",
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "get_project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceCount": {
    "type": "number"
   },
   "devices": {
    "description": "Empty when device monitoring is unavailable \u2014 not an error",
    "items": {
     "additionalProperties": false,
     "properties": {
      "appVersion": {
       "type": "string"
      },
      "camera": {
       "type": "string"
      },
      "closedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "closedReason": {
       "type": [
        "string",
        "null"
       ]
      },
      "cpuUsagePercent": {
       "type": "number"
      },
      "deviceId": {
       "type": "string"
      },
      "diskFreeGB": {
       "type": "number"
      },
      "internet": {
       "type": "string"
      },
      "lastActivityAt": {
       "type": "string"
      },
      "lastSeenAt": {
       "type": "string"
      },
      "liveness": {
       "type": "string"
      },
      "printer": {
       "type": "string"
      },
      "ramUsagePercent": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "project": {
    "additionalProperties": false,
    "properties": {
     "country": {
      "type": "string"
     },
     "currency": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "isActive": {
      "type": "boolean"
     },
     "isPublic": {
      "type": "boolean"
     },
     "screenSize": {
      "additionalProperties": false,
      "properties": {
       "height": {
        "type": "number"
       },
       "width": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "slug": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "project",
   "deviceCount",
   "devices"
  ],
  "type": "object"
 },
 "title": "Get one booth in detail"
}
