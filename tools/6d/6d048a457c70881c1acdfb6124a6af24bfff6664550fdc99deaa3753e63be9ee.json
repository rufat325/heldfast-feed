{
 "description": "Sync a markdown file from a GitHub repository to RenderMark. Creates a new document or updates an existing one linked to the GitHub source.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoSync": {
    "description": "Enable automatic sync via webhook (default: false)",
    "type": "boolean"
   },
   "branch": {
    "description": "Branch name (default: main)",
    "type": "string"
   },
   "owner": {
    "description": "GitHub repository owner",
    "type": "string"
   },
   "path": {
    "description": "Path to the markdown file (e.g., 'docs/README.md')",
    "type": "string"
   },
   "publish": {
    "description": "Publish the document immediately (default: true)",
    "type": "boolean"
   },
   "repo": {
    "description": "GitHub repository name",
    "type": "string"
   },
   "title": {
    "description": "Override title",
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo",
   "path"
  ],
  "type": "object"
 },
 "name": "sync_from_github"
}
