{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Subscribers (batch)"
 },
 "description": "Add up to 1000 subscribers to an audience in one call (single opt-in). Returns a per-row outcome for each address.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "audience_id": {
    "description": "Audience ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Optional idempotency key. If omitted, the MCP server generates one for POST tools.",
    "pattern": "^[\\x20-\\x7E]{1,255}$",
    "type": "string"
   },
   "subscribers": {
    "items": {
     "properties": {
      "consent_ip": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "consent_source": {
       "anyOf": [
        {
         "maxLength": 500,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "display_name": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "email_address": {
       "maxLength": 508,
       "type": "string"
      },
      "merge_fields": {
       "additionalProperties": {
        "anyOf": [
         {
          "maxLength": 500,
          "type": "string"
         },
         {
          "type": "number"
         },
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ]
       },
       "propertyNames": {
        "maxLength": 64,
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "email_address"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "audience_id",
   "subscribers"
  ],
  "type": "object"
 },
 "name": "shipmail_add_subscribers_batch",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "results": {
    "items": {
     "properties": {
      "email_address": {
       "type": "string"
      },
      "outcome": {
       "type": "string"
      }
     },
     "required": [
      "email_address",
      "outcome"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Add Subscribers (batch)"
}
