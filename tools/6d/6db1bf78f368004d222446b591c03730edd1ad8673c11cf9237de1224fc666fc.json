{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read a poll"
 },
 "description": "Reads a When Works For You poll from its link: the title, the organizer, every date option with how many people said yes or maybe, and whether a date is already confirmed. With a personal link (one ending ?g=\u2026), it also returns the answers already given under that link. Use this before respond_to_poll so you can match the person's availability to the poll's exact dates. Reads only; changes nothing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "link": {
    "description": "The poll link, e.g. https://whenworksforyou.com/e/book-club-ab12cd34, or a personal link ending ?g=\u2026",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "link"
  ],
  "type": "object"
 },
 "name": "get_poll",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirmed_date": {
    "type": [
     "string",
     "null"
    ]
   },
   "dates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": "string"
      },
      "date_option_id": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "maybe": {
       "type": "number"
      },
      "yes": {
       "type": "number"
      }
     },
     "required": [
      "date_option_id",
      "date",
      "label",
      "yes",
      "maybe"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "organizer_name": {
    "type": "string"
   },
   "responded_count": {
    "type": "number"
   },
   "status": {
    "enum": [
     "open",
     "confirmed"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "your_answers": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "answers": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "answer": {
           "enum": [
            "yes",
            "maybe",
            "no"
           ],
           "type": "string"
          },
          "date": {
           "type": "string"
          }
         },
         "required": [
          "date",
          "answer"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "name": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "answers"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "title",
   "description",
   "organizer_name",
   "status",
   "confirmed_date",
   "dates",
   "responded_count",
   "your_answers"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "events:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Read a poll"
}
