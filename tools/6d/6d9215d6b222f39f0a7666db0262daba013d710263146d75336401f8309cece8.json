{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Market screener"
 },
 "description": "Screen every recorded pair at once: funding_band and oi_band against each pair's own recorded days (record high, top 5%, top 25%, typical, bottom 25%, bottom 5%, record low), a minimum whale-flow multiple, and unusual-only.",
 "inputSchema": {
  "additionalProperties": {},
  "properties": {
   "compact": {
    "description": "true: one line per coin.",
    "type": "boolean"
   },
   "cursor": {
    "description": "Next page: the cursor from the previous answer.",
    "type": "string"
   },
   "detail": {
    "description": "brief (default): the answer, key numbers and top rows. full: every row, paged with cursor.",
    "enum": [
     "brief",
     "full"
    ],
    "type": "string"
   },
   "funding_band": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Funding band(s), e.g. \"top 5%\"."
   },
   "limit": {
    "description": "Rows to return (usually up to 50; more is clamped and said).",
    "type": "integer"
   },
   "oi_band": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Open interest band(s)."
   },
   "unusual_only": {
    "description": "Only coins with unusual whale activity now.",
    "type": "boolean"
   },
   "whale_mult_min": {
    "description": "Minimum whale flow as a multiple of the coin's own average.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "market_screener",
 "outputSchema": {
  "additionalProperties": {},
  "properties": {
   "access_note": {
    "description": "What this connection could not return."
   },
   "as_of": {
    "description": "Data time, ISO."
   },
   "as_of_ms": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Data time, Unix ms."
   },
   "available": {
    "description": "False: no data; note says why.",
    "type": "boolean"
   },
   "caveat": {
    "description": "A real limit, when non-null."
   },
   "cursor": {
    "description": "Next page (detail full)."
   },
   "delayed": {
    "description": "Set when not live."
   },
   "next_tools": {
    "description": "Follow-up calls {tool,args,why}.",
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "The answer in one sentence."
   },
   "truncated": {
    "description": "Rows held back; see trimmed."
   }
  },
  "type": "object"
 },
 "title": "Market screener"
}
