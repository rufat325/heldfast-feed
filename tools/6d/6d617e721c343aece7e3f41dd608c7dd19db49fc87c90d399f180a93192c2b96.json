     "estimated_reward": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Estimated Reward"
     },
     "job_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Job Id"
     },
     "next_tool": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Next Tool"
     },
     "next_tool_args": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Next Tool Args"
     },
     "reason": {
      "title": "Reason",
      "type": "string"
     },
     "verb": {
      "title": "Verb",
      "type": "string"
     }
    },
    "required": [
