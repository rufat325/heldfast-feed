{
 "annotations": {
  "readOnlyHint": true,
  "title": "Search constituents"
 },
 "description": "Full-text search across constituents (individuals and organizations) and households by name, email, etc. Start here to find a donor's Id. Bloomerang: GET /constituents/search.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "search": {
    "description": "Text to search for, e.g. a name or email.",
    "minLength": 1,
    "type": "string"
   },
   "skip": {
    "description": "Records to skip (offset). Default 0.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "take": {
    "description": "Page size, 1-50. Default 50.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "type": {
    "description": "Only this record type.",
    "enum": [
     "Individual",
     "Organization",
     "Household"
    ],
    "type": "string"
   }
  },
  "required": [
   "search"
  ],
  "type": "object"
 },
 "name": "bloomerang_search_constituents",
 "title": "Search constituents"
}
