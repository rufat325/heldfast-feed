{
 "description": "Add password protection to a PDF.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ownerPassword": {
    "description": "Password required to edit/print",
    "type": "string"
   },
   "pdf_base64": {
    "description": "Base64-encoded PDF file",
    "type": "string"
   },
   "userPassword": {
    "description": "Password required to open the PDF",
    "type": "string"
   }
  },
  "required": [
   "pdf_base64"
  ],
  "type": "object"
 },
 "name": "bytario_pdf_protect"
}
