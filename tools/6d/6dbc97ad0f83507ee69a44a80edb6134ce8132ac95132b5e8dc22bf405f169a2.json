{
 "description": "Track keyword search interest over time and by region via Google Trends.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cat": {
    "description": "Category id. (API default: 0)",
    "type": "string"
   },
   "data_type": {
    "description": "Type of Trends data. (API default: TIMESERIES)",
    "enum": [
     "TIMESERIES",
     "GEO_MAP",
     "GEO_MAP_0"
    ],
    "type": "string"
   },
   "date": {
    "description": "Time range: e.g. 'now 1-H', 'now 7-d', 'today 12-m', 'all', or 'yyyy-mm-dd yyyy-mm-dd'.",
    "type": "string"
   },
   "geo": {
    "description": "Location origin (e.g. US, GB). Defaults to worldwide.",
    "type": "string"
   },
   "gprop": {
    "description": "Property filter.",
    "enum": [
     "images",
     "news",
     "froogle",
     "youtube"
    ],
    "type": "string"
   },
   "language": {
    "description": "Result language code (e.g. en, es, fr, de). (API default: en)",
    "type": "string"
   },
   "query": {
    "description": "Up to 5 comma-separated terms (1 for map-only types); max 100 chars each.",
    "type": "string"
   },
   "region": {
    "description": "Map granularity.",
    "enum": [
     "COUNTRY",
     "REGION",
     "DMA",
     "CITY"
    ],
    "type": "string"
   },
   "tz": {
    "description": "Timezone offset in minutes (-1439..1439). (API default: 420)",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "google_trends",
 "title": "Google Trends API"
}
