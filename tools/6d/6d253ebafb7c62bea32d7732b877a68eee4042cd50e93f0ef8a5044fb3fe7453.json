  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Identificador p\u00fablico de la subasta (10 caracteres)",
    "pattern": "^[A-Za-z0-9]{10}$",
    "type": "string"
   },
   "tier": {
    "description": "`web` (por defecto, seg\u00fan tu plan), `basic` o `completo` (solo si ya est\u00e1n desbloqueados)",
    "enum": [
     "web",
     "basic",
     "completo"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
