{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Preview a local cancellation watch and ask the citizen to approve the exact dates, party, accessibility filter, and notification destination through the MCP host. Acceptance saves the watch and, for notify_target='auto', sends a test message. It checks only while the assistant is connected and never books.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accessible_only": {
    "type": "boolean"
   },
   "campground_id": {
    "type": "string"
   },
   "end_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "equipment_type": {
    "type": "string"
   },
   "nights": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "notify_target": {
    "type": "string"
   },
   "party_size": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "recreation_area_id": {
    "type": "string"
   },
   "start_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "weekends_only": {
    "type": "boolean"
   }
  },
  "required": [
   "campground_id",
   "start_date",
   "end_date",
   "party_size"
  ],
  "type": "object"
 },
 "name": "create_alert",
 "title": "Set a cancellation alert"
}
