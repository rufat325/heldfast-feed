{
 "description": "Generate a full AI course and import it into a CRM location. Provide the topic, audience, and desired structure. The AI builds categories with lessons and imports everything.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "categories": {
    "description": "Course categories with lessons",
    "items": {
     "properties": {
      "lessons": {
       "description": "Lessons in this category",
       "items": {
        "properties": {
         "content_type": {
          "description": "Content type: video, text, audio (default: text)",
          "type": "string"
         },
         "description": {
          "description": "Lesson content/description (can be full HTML)",
          "type": "string"
         },
         "title": {
          "description": "Lesson title",
          "type": "string"
         }
        },
        "required": [
         "title",
         "description"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "title": {
       "description": "Category/module title",
       "type": "string"
      }
     },
     "required": [
      "title",
      "lessons"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "description": "Course description",
    "type": "string"
   },
   "instructor_name": {
    "description": "Instructor name (default: AI Instructor)",
    "type": "string"
   },
   "location_id": {
    "description": "CRM location ID where the course will be created",
    "type": "string"
   },
   "title": {
    "description": "Course title",
    "type": "string"
   },
   "user_id": {
    "description": "CRM user ID (course owner)",
    "type": "string"
   }
  },
  "required": [
   "location_id",
   "user_id",
   "title",
   "description",
   "categories"
  ],
  "type": "object"
 },
 "name": "crm_generate_course"
}
