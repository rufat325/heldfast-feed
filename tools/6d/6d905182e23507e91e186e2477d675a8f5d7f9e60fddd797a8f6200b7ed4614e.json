{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read bounded page history using a page-bound cursor; no new checkpoint is created. Requires current employer folder access. Empty destinations require reviewed activation; published/unknown delivery writes refuse without changing release/read/ack flags. Requires instructions:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folderId": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "pageId": {
    "$ref": "#/properties/folderId"
   },
   "query": {
    "additionalProperties": false,
    "properties": {
     "cursor": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "limit": {
      "maximum": 200,
      "minimum": 1,
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "folderId",
   "pageId"
  ],
  "type": "object"
 },
 "name": "opentrain_folder_instructions_history_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "archived": {
      "type": "boolean"
     },
     "checkpoints": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "actorType": {
         "$ref": "#/properties/result/properties/pageTitle"
        },
        "actorUserId": {
         "anyOf": [
          {
           "$ref": "#/properties/result/properties/pageId"
          },
          {
           "type": "null"
          }
         ]
        },
        "checkpointId": {
         "$ref": "#/properties/result/properties/pageId"
        },
        "contentDigest": {
         "$ref": "#/properties/result/properties/pageTitle"
        },
        "createdAt": {
         "$ref": "#/properties/result/properties/pageTitle"
        },
        "origin": {
         "$ref": "#/properties/result/properties/pageTitle"
        },
        "sizeBytes": {
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "checkpointId",
        "createdAt",
        "origin",
        "actorUserId",
        "actorType",
        "contentDigest",
        "sizeBytes"
       ],
       "type": "object"
      },
      "maxItems": 200,
      "type": "array"
     },
     "hasMore": {
      "type": "boolean"
     },
     "nextCursor": {
      "type": [
       "string",
       "null"
      ]
     },
     "pageId": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "pageTitle": {
      "type": "string"
     }
    },
    "required": [
     "pageId",
     "pageTitle",
     "archived",
     "checkpoints",
     "hasMore",
     "nextCursor"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
