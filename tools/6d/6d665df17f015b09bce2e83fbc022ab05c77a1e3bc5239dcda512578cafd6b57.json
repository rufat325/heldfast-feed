{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Shuttle-UM bus stops from the published GTFS feed, filtered by a name fragment or by distance from a point. Without a filter, every stop. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "lat": {
    "description": "Latitude to search around",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "lon": {
    "description": "Longitude to search around",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "query": {
    "description": "Only stops whose name contains this text, e.g. \"Stamp\"",
    "minLength": 1,
    "type": "string"
   },
   "radius_m": {
    "default": 500,
    "description": "Search radius in metres around lat/lon (default 500)",
    "maximum": 5000,
    "minimum": 50,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "transportation_list_stops",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "stops": {
    "description": "Matching stops: nearest first for a point search, otherwise by id",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "description": "Stop id, e.g. \"1001\"",
       "type": "string"
      },
      "lat": {
       "description": "Latitude",
       "type": [
        "number",
        "null"
       ]
      },
      "lon": {
       "description": "Longitude",
       "type": [
        "number",
        "null"
       ]
      },
      "name": {
       "description": "Stop name, e.g. \"Regents Drive Garage\"",
       "type": [
        "string",
        "null"
       ]
      },
      "wheelchair_boarding": {
       "description": "Wheelchair access as the feed records it",
       "enum": [
        "unknown",
        "accessible",
        "not_accessible"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "lat",
      "lon",
      "wheelchair_boarding"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "stops"
  ],
  "type": "object"
 },
 "title": "List Shuttle-UM stops"
}
