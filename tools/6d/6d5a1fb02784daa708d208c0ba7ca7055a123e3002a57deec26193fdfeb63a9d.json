{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Cancel my RIED.TAXI booking"
 },
 "description": "Cancels a booking, free of charge, any time before the pickup. Requires reference, access code, customer_confirmed=true after the customer explicitly confirmed, and an idempotency_key. Cannot be undone.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "access_code": {
    "description": "8-character access code given at booking time.",
    "maxLength": 8,
    "minLength": 8,
    "type": "string"
   },
   "booking_reference": {
    "description": "Public booking reference, e.g. RT-K7QM.",
    "pattern": "^RT-[A-Z0-9]{4,10}$",
    "type": "string"
   },
   "customer_confirmed": {
    "const": true,
    "type": "boolean"
   },
   "idempotency_key": {
    "description": "Unique key for this one intended action. Reuse it only when retrying the same action.",
    "maxLength": 80,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "reason": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "booking_reference",
   "access_code",
   "idempotency_key",
   "customer_confirmed"
  ],
  "type": "object"
 },
 "name": "ried_taxi_cancel_booking",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "booking_id": {
    "type": "string"
   },
   "booking_reference": {
    "type": "string"
   },
   "cancellation_fee_eur": {
    "type": "number"
   },
   "cancelled_at": {
    "type": "string"
   },
   "confirmation_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "currency": {
    "type": "string"
   },
   "destination": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "flight_number": {
    "type": [
     "string",
     "null"
    ]
   },
   "free_cancellation_until": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "passengers": {
    "type": [
     "integer",
     "null"
    ]
   },
   "pickup_address": {
    "type": "string"
   },
   "pickup_at": {
    "type": "string"
   },
   "pickup_date": {
    "type": "string"
   },
   "pickup_time": {
    "type": "string"
   },
   "price_eur": {
    "type": [
     "number",
     "null"
    ]
   },
   "status": {
    "type": "string"
   },
   "timezone": {
    "type": "string"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Cancel my RIED.TAXI booking"
}
