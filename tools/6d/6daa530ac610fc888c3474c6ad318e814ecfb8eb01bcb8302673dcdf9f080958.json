{"_meta":{"com.loadster/toolClass":"read"},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get Load Test Status"},"description":"Get a Load Test's live status, as the Dashboard's live test view shows it: stage, elapsed time, Bots started, running, peak and planned per Population, Iterations, response time percentiles, throughput, errors by type, and each engine's region, online state and, while the test runs, current CPU percentage. Use it to tell the user how a test in progress is going, and to tell an overloaded engine from a slow target. Call it no more often than every 10 seconds; the numbers do not move faster than that. Once the test is over, the status says so in its note; stop polling and read the Test Report with get_load_test_report.","inputSchema":{"properties":{"loadTestId":{"description":"The load test id, as reported by list_load_tests.","type":"string"},"projectId":{"type":"string"}},"required":["projectId","loadTestId"],"type":"object"},"name":"get_load_test_status","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"dashboardUrl":{"type":"string"},"elapsedMs":{"format":"int64","type":"integer"},"engines":{"items":{"properties":{"cpuPercent":{"format":"double","type":"number"},"name":{"type":"string"},"online":{"type":"boolean"},"region":{"type":"string"}},"required":["online"],"type":"object"},"type":"array"},"errorsByType":{"items":{"properties":{"count":{"format":"int32","type":"integer"},"error":{"type":"string"}},"required":["count","error"],"type":"object"},"type":"array"},"hitsPerSecond":{"format":"double","type":"number"},"id":{"type":"string"},"name":{"type":"string"},"note":{"type":"string"},"pagesPerSecond":{"format":"double","type":"number"},"populations":{"items":{"properties":{"id":{"type":"string"},"name":{"type":"string"},"peakBots":{"format":"int32","type":"integer"},"runningBots":{"format":"int32","type":"integer"},"startedBots":{"for