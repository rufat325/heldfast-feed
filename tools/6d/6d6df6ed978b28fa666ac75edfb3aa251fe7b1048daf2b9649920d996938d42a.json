{
 "description": "Resume a paused cloud execution by delivering a named signal (matched by name + correlationId).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "correlationId": {
    "description": "Signal correlation id.",
    "type": "string"
   },
   "executionId": {
    "description": "The paused execution.",
    "type": "string"
   },
   "name": {
    "description": "Signal name to deliver.",
    "type": "string"
   },
   "payload": {
    "description": "Signal payload (any JSON value)."
   }
  },
  "required": [
   "executionId",
   "name",
   "correlationId"
  ],
  "type": "object"
 },
 "name": "sapiom_dev_agents_signal"
}
