 "description": "Counts of offline LDA topic assignments, optionally over time. Topic labels are interpretive model outputs; exact topic_id filters select assignments rather than keyword matches. Reports unclassified coverage.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "country": {
    "description": "Exact country name (accents optional)",
    "type": "string"
   },
   "date_from": {
    "description": "Inclusive date bounds: YYYY[-MM[-DD]]",
    "type": "string"
   },
   "date_to": {
    "type": "string"
   },
   "exact": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    },
    "description": "AND values. Fields: subject/spatial/author/language/country/newspaper/topic_id/min_prob/scored_by; country_raw=whole cell; polarity:<model>.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "hijri_month": {
    "type": "string"
   },
   "hijri_year": {
    "type": "integer"
   },
   "keyword": {
    "minLength": 1,
    "type": "string"
   },
   "keyword_aliases": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "keyword_mode": {
    "enum": [
     "literal",
     "all_terms"
    ],
    "type": "string"
   },
   "min_prob": {
    "description": "0-1; keep only assignments at or above this probability",
    "type": "number"
   },
   "newspaper": {
    "description": "Newspaper/periodical substring",
    "type": "string"
   },
   "over_time": {
    "description": "Also return per-year counts for the leading topics",
    "type": "boolean"
   },
   "subject": {
    "description": "Exact tag",
    "type": "string"
   },
   "subset": {
    "description": "articles (default) | references",
    "type": "string"
   },
   "top_n": {
    "description": "Topics given their own band in over_time (default 8, max 15)",
    "type": "integer"
   }
  },
  "type": "object"
 },
