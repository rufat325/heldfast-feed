{
 "description": "View captured HTTP requests/responses for a session. Shows method, status, URL, size, and timing. Filter by URL pattern, method, status range, or content-type. Network capture starts automatically when a session is created.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contentType": {
    "description": "Content-type filter (e.g. 'json').",
    "type": "string"
   },
   "method": {
    "description": "HTTP method filter (GET, POST, etc).",
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID.",
    "type": "string"
   },
   "statusMax": {
    "description": "Maximum status code.",
    "type": "integer"
   },
   "statusMin": {
    "description": "Minimum status code (e.g. 400 for errors).",
    "type": "integer"
   },
   "urlPattern": {
    "description": "Regex or substring to filter URLs.",
    "type": "string"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "network_log",
 "title": "Network Log"
}
