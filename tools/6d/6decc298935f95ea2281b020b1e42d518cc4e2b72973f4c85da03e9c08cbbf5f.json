  {
   "mimeType": "image/x-icon",
   "sizes": [
    "16x16",
    "32x32"
   ],
   "src": "https://app.preshiftiq.com/favicon.ico"
  },
  {
   "mimeType": "image/png",
   "sizes": [
    "64x64"
   ],
   "src": "https://app.preshiftiq.com/icon.png"
  }
 ],
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "client_class": {
    "default": "other",
    "description": "Which assistant is asking: 'claude', 'chatgpt' or 'other'. Optional; 'other' when omitted. It labels the link this tool returns so PreShiftIQ can count assessments started from each assistant; it does not change the assessment.",
    "enum": [
     "claude",
     "chatgpt",
     "other"
    ],
    "type": "string"
   },
   "vertical_id": {
    "enum": [
     "tms",
     "dock-scheduling",
     "eld",
     "carrier-vetting",
     "fleet-management"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "start_assessment",
