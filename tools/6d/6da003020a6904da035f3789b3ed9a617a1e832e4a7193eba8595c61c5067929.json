{
 "_meta": {
  "openai/toolInvocation/invoked": "Roundup ready",
  "openai/toolInvocation/invoking": "Building today's roundup",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when a user asks what's happening today or tomorrow, or for a morning briefing or scheduled check-in. Returns a one-day digest for a city: top picks plus sections for parties, live music, art, comedy and theatre, talks, food, and more. With a profile, saved, learned and per-weekday taste rank the picks. Pass compact=true for a short push-style digest.",
 "inputSchema": {
  "dependentRequired": {
   "profile_id": [
    "profile_secret"
   ],
   "profile_secret": [
    "profile_id"
   ]
  },
  "properties": {
   "avoid": {
    "description": "Ranking penalties.",
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 40,
    "type": "array"
   },
   "city": {
    "description": "City name or slug.",
    "maxLength": 200,
    "type": "string"
   },
   "compact": {
    "default": false,
    "description": "Short digest: title, when, venue, price and link only; 3 picks, up to 4 sections of 3.",
    "type": "boolean"
   },
   "date": {
    "description": "Target day, YYYY-MM-DD (city-local). Defaults to today.",
    "maxLength": 200,
    "type": "string"
   },
   "event_types": {
    "description": "Hard filter.",
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "fields": {
    "items": {
     "enum": [
      "description",
      "images",
      "coordinates",
      "socials",
      "promoters",
      "source"
     ],
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "free": {
    "type": "boolean"
   },
   "genres": {
    "description": "Hard filter.",
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "limit": {
    "default": 100,
    "description": "How many of the day's events to fetch and rank.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "neighborhoods": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "price_max": {
    "type": "number"
   },
   "profile_id": {
    "description": "Optional profile id; pass with profile_secret to personalize.",
    "maxLength": 200,
    "type": "string"
   },
   "profile_secret": {
    "maxLength": 200,
    "type": "string"
   },
   "section_limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "top_limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "vibe": {
    "description": "Hard filter.",
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "when": {
    "description": "Single-day preset: today, tonight, tomorrow, or a weekday name. Ranges are rejected; use search_events for those.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "city"
  ],
  "type": "object"
 },
 "name": "get_daily_roundup",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Get Daily Roundup"
}
