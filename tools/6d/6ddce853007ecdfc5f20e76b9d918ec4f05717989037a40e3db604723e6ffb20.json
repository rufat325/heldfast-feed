{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find published off-plan UAE developments by project name or slug text, combined with exact structured filters. Returns shortlist facts and a pagination cursor. Follow more pages only when the user's task needs them; a page's result count is not a total.\n\nUse `suggest_project_terms` for a partial facet name, `list_project_facets` to explore all filter choices, and `fetch` for selected project detail. A known project URL or slug can go straight to `fetch`.\n\nPrices and price filters apply to the whole development. They do not establish that a particular bedroom count, property type, or unit is available at that price.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "area": {
    "description": "Exact public API area slug from list_project_facets, for example dubai-marina.",
    "maxLength": 160,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "availability": {
    "description": "Availability filter from list_project_facets.",
    "enum": [
     "available",
     "limited",
     "sold-out"
    ],
    "type": "string"
   },
   "bedroomsMin": {
    "description": "Return developments advertising a bedroom count at or above this value. Zero leaves the filter unset; it does not select studios or identify a unit at a particular price.",
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   },
   "comingSoon": {
    "description": "Filter for projects marked as coming soon.",
    "type": "boolean"
   },
   "cursor": {
    "description": "Pagination cursor returned by a previous search call.",
    "maxLength": 2048,
    "type": "string"
   },
   "developer": {
    "description": "Exact public API developer slug from list_project_facets, for example sobha-realty.",
    "maxLength": 160,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "emirate": {
    "description": "Exact public API emirate slug from list_project_facets, for example dubai.",
    "maxLength": 160,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "handoverYear": {
    "description": "Expected handover year.",
    "maximum": 2200,
    "minimum": 1900,
    "type": "integer"
   },
   "limit": {
    "description": "Maximum results to return. Defaults to 10.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "newLaunch": {
    "description": "Filter for projects marked as new launches.",
    "type": "boolean"
   },
   "priceMaxAed": {
    "description": "Upper bound of the desired development-wide price interval. A development matches when its known range starts at or below this amount; unknown pricing is excluded.",
    "maximum": 1000000000,
    "minimum": 1,
    "type": "integer"
   },
   "priceMinAed": {
    "description": "Lower bound of the desired development-wide price interval. A development matches when its known range reaches this amount or above; unknown pricing is excluded.",
    "maximum": 1000000000,
    "minimum": 1,
    "type": "integer"
   },
   "propertyType": {
    "description": "Exact public API property type slug from list_project_facets, for example apartment.",
    "maxLength": 160,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "query": {
    "description": "Literal text within a project name or slug; ASCII letter case is ignored. Use structured filters for location, budget and other criteria; this does not interpret natural-language requests.",
    "maxLength": 160,
    "minLength": 2,
    "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
    "type": "string"
   },
   "sort": {
    "description": "Sort value from list_project_facets.",
    "enum": [
     "recommended",
     "price-asc",
     "price-desc",
     "handover-asc",
     "handover-desc"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "nextCursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "pricingNote": {
    "type": "string"
   },
   "projects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "areas": {
       "items": {
        "additionalProperties": {},
        "properties": {
         "emirate": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "slug": {
          "type": "string"
         }
        },
        "required": [
         "slug",
         "name",
         "emirate"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "availability": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "bedrooms": {
