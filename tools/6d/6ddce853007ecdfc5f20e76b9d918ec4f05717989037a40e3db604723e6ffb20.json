         "properties": {
          "max": {
           "anyOf": [
            {
             "type": "number"
            },
            {
             "type": "null"
            }
           ]
          },
          "min": {
           "anyOf": [
            {
             "type": "number"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "min",
          "max"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "coordinates": {
       "additionalProperties": false,
       "properties": {
        "lat": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "lng": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "lat",
        "lng"
       ],
       "type": "object"
      },
      "developer": {
       "anyOf": [
        {
         "additionalProperties": {},
         "properties": {
          "name": {
           "type": "string"
          },
          "slug": {
           "type": "string"
          }
         },
         "required": [
          "slug",
          "name"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "emirate": {
       "anyOf": [
        {
         "additionalProperties": {},
         "properties": {
          "name": {
           "type": "string"
          },
          "slug": {
           "type": "string"
          }
         },
         "required": [
          "slug",
          "name"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "flags": {
       "additionalProperties": {
        "type": "boolean"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "handoverDate": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "string"
      },
      "pricing": {
       "additionalProperties": false,
       "properties": {
        "currency": {
         "const": "AED",
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "max": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "min": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "scope": {
         "const": "development",
         "type": "string"
        },
        "unitLevelPricingAvailable": {
         "const": false,
         "type": "boolean"
        }
       },
       "required": [
        "scope",
        "min",
        "max",
        "currency",
        "unitLevelPricingAvailable",
        "label"
       ],
       "type": "object"
      },
      "propertyTypes": {
       "items": {
        "additionalProperties": {},
        "properties": {
         "name": {
          "type": "string"
         },
         "slug": {
          "type": "string"
         }
        },
        "required": [
         "slug",
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "slug",
      "title",
      "url",
      "developer",
      "emirate",
      "areas",
      "propertyTypes",
      "pricing",
      "bedrooms",
      "coordinates",
      "handoverDate",
      "availability",
      "flags"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "limit",
   "nextCursor",
   "pricingNote",
   "projects"
  ],
  "type": "object"
 },
 "title": "Search Projectory Projects"
}
