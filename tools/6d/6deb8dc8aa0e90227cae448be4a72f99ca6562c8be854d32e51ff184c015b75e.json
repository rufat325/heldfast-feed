{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read-only: inspect embedded TouchDesigner technique packs and individual techniques, with optional code snippets and setup/workflow details.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Technique pack category id or display name.",
    "minLength": 1,
    "type": "string"
   },
   "include_code": {
    "default": false,
    "description": "Include code snippets in technique detail results.",
    "type": "boolean"
   },
   "include_setup": {
    "default": true,
    "description": "Include setup/workflow guidance in technique detail results.",
    "type": "boolean"
   },
   "technique_id": {
    "description": "Technique id or name inside the selected category.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_technique_detail",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "availableTechniqueIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "mode": {
    "enum": [
     "packs",
     "pack",
     "technique"
    ],
    "type": "string"
   },
   "nextToolHints": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pack": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "displayName": {
      "type": "string"
     },
     "resources": {},
     "techniqueCount": {
      "type": "number"
     },
     "versionRequirement": {
      "type": "string"
     }
    },
    "required": [
     "category",
     "displayName",
     "techniqueCount"
    ],
    "type": "object"
   },
   "packs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "type": "number"
      },
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "technique": {},
   "techniques": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "difficulty": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "operators": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "requiresVersion": {
       "type": "string"
      },
      "subcategory": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "mode",
   "nextToolHints"
  ],
  "type": "object"
 },
 "title": "Get technique detail"
}
