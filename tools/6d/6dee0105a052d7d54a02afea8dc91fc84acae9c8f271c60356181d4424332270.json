{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Quote the recent top two plus the best AssetFare graph at the exact amount; return up to two all-in choices labeled assetfare_verified_unsigned or external_provider_handoff. AssetFare cost, ETA and rank are always present; a recent winning range needs two supporting higher buckets and disappears on conflict. Example: compare Solana USDC to Base USDC at USD 347.25 with balanced (60s). Fast is 30s; balanced and explicit economy are 60s. The 60-second ceiling is absolute for recommendations; slower routes are reference-only. Never approves, prepares, signs, or submits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount_usd": {
    "description": "Requested input value in USD, minimum 1. USD 1 is reachability/schema smoke only. A USD 50 competitive bucket was observed only for dated 2026-09-23 Solana USDC to Base USDC evidence and must not be generalized to another corridor. USD 1,000 is the primary representative amount. SOL input includes a swap. Always quote the actual intended amount.",
    "minimum": 1,
    "type": "number"
   },
   "from_chain": {
    "description": "Source chain for the v2 route. Polygon, Optimism, Ethereum, HyperEVM, X Layer, Sei, Sonic, Monad, Avalanche, Cronos, Injective, Linea, Aptos, Unichain, and Ink are source-only and cannot be used as to_chain.",
    "enum": [
     "solana",
     "base",
     "arbitrum",
     "robinhood",
     "polygon",
     "optimism",
     "ethereum",
     "hyperevm",
     "xlayer",
     "sei",
     "sonic",
     "monad",
     "avalanche",
     "cronos",
     "injective",
     "linea",
     "aptos",
     "unichain",
     "ink"
    ],
    "type": "string"
   },
   "from_token": {
    "description": "Input token symbol on from_chain. The chain-token pair must appear in current v2 capabilities.",
    "enum": [
     "SOL",
     "ETH",
     "USDC",
     "USDG"
    ],
    "type": "string"
   },
   "max_eta_seconds": {
    "description": "Optional stricter maximum ETA in seconds; it cannot exceed 60 or the selected profile limit.",
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "profile": {
    "description": "Time policy: fast (30s), balanced (60s default), or explicit economy (60s). Every recommendation profile has an absolute 60-second ceiling.",
    "enum": [
     "fast",
     "balanced",
     "economy"
    ],
    "type": "string"
   },
   "to_chain": {
    "description": "Destination chain for the v2 route: Solana, Base, Arbitrum, or Robinhood Chain. Source-only chains are not destinations.",
    "enum": [
     "solana",
     "base",
     "arbitrum",
     "robinhood"
    ],
    "type": "string"
   },
   "to_token": {
    "description": "Output token symbol on to_chain. The chain-token pair must appear in current v2 capabilities.",
    "enum": [
     "SOL",
     "ETH",
     "USDC",
     "USDG"
    ],
    "type": "string"
   }
  },
  "required": [
   "from_chain",
   "from_token",
   "to_chain",
   "to_token",
   "amount_usd"
  ],
  "type": "object"
 },
