{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Transaction status"},"description":"Bitcoin: Retrieve the confirmation status of a transaction. Returns whether the transaction is confirmed and, if so, the block height, hash, and timestamp. A transaction not in the chain, pending or unknown, is `{\"confirmed\":false}`.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"txid":{"description":"A transaction ID: its hash.","examples":["4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b","2bb85f4b004be6da54f766c17c1e855187327112c231ef2ff35ebad0ea67c69e","9a0b3b8305bb30cacf9e8443a90d53a76379fb3305047fdeaa4e4b0934a2a1ba"],"pattern":"^[0-9a-f]{64}$","type":"string"}},"required":["txid"],"type":"object"},"name":"get_tx_status","outputSchema":{"$defs":{"BlockHash":{"pattern":"^[0-9a-f]{64}$","type":"string"},"Height":{"minimum":0,"type":"integer"},"Timestamp":{"minimum":0,"type":"integer"},"TxStatus":{"properties":{"block_hash":{"anyOf":[{"$ref":"#/$defs/BlockHash"},{"type":"null"}]},"block_height":{"anyOf":[{"$ref":"#/$defs/Height"},{"type":"null"}]},"block_time":{"anyOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"confirmed":{"type":"boolean"}},"required":["confirmed"],"type":"object"}},"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"block_hash":{"anyOf":[{"$ref":"#/$defs/BlockHash"},{"type":"null"}]},"block_height":{"anyOf":[{"$ref":"#/$defs/Height"},{"type":"null"}]},"block_time":{"anyOf":[{"$ref":"#/$defs/Timestamp"},{"type":"null"}]},"confirmed":{"type":"boolean"}},"required":["confirmed"],"type":"object"},"title":"Transaction status"}
