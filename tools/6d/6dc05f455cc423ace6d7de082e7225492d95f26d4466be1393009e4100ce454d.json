{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Update an existing discussion topic.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "delayed_post_at": {
    "description": "ISO 8601 datetime to schedule the topic for future posting",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "is_announcement": {
    "description": "When true, requests marking the topic as an announcement. Canvas silently downgrades this to a plain discussion topic (no error) if the caller lacks announcement permission in the course \u2014 check the response's own `is_announcement` field rather than assuming the request was honored.",
    "type": "boolean"
   },
   "message": {
    "description": "New body text (supports HTML)",
    "type": "string"
   },
   "published": {
    "description": "Publish or unpublish the topic",
    "type": "boolean"
   },
   "require_initial_post": {
    "description": "Require students to post before seeing replies",
    "type": "boolean"
   },
   "title": {
    "description": "New title for the discussion topic",
    "type": "string"
   },
   "topic_id": {
    "description": "The Canvas discussion topic ID",
    "type": "number"
   }
  },
  "required": [
   "course_id",
   "topic_id"
  ],
  "type": "object"
 },
 "name": "update_discussion",
 "title": "Update Discussion"
}
