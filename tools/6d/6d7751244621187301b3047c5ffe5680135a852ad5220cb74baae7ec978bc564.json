{
 "description": "Build an index file (.IDX) for fast lookups on a field",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "field": {
    "description": "Field name to index",
    "type": "string"
   },
   "file": {
    "description": "Data file to index",
    "type": "string"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "userid": {
    "description": "Project owner's username. Required when accessing a shared project where you are a writer. Defaults to the authenticated user.",
    "type": "string"
   }
  },
  "required": [
   "project",
   "file",
   "field"
  ],
  "type": "object"
 },
 "name": "chaprola_index"
}
