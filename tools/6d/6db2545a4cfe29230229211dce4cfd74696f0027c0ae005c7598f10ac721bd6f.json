{
 "description": "Register a fabricated NPC on the session. Returns a stable `npcId` to use in `generate_portrait` and `showDialogue`. Use BEFORE introducing any NPC that isn't already in the world pack \u2014 without this the NPC has no identity and their portrait can't be tracked across turns.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "attitude": {
    "default": "neutral",
    "description": "Initial disposition toward the player",
    "enum": [
     "friendly",
     "neutral",
     "hostile",
     "unknown"
    ],
    "type": "string"
   },
   "description": {
    "description": "Short physical + role description (1-2 sentences)",
    "type": "string"
   },
   "motivation": {
    "description": "What this NPC wants or fears (free-form, optional)",
    "type": "string"
   },
   "name": {
    "description": "NPC display name",
    "minLength": 1,
    "type": "string"
   },
   "narrativeRole": {
    "default": "background",
    "description": "Story role this NPC plays",
    "enum": [
     "quest_giver",
     "ally",
     "obstacle",
     "information",
     "antagonist",
     "merchant",
     "background"
    ],
    "type": "string"
   },
   "personality": {
    "description": "One-line personality summary (e.g. 'gruff but fair')",
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "name",
   "description"
  ],
  "type": "object"
 },
 "name": "add_npc"
}
