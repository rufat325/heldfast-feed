{
 "description": "Toggle the \"important\" flag on a communication. This is dev-only metadata and is NOT broadcast to the end user \u2014 use it to bubble messages to the top of your own triage view.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "The app public ID",
    "type": "string"
   },
   "commId": {
    "description": "Communication id",
    "type": "string"
   },
   "important": {
    "default": true,
    "type": "boolean"
   },
   "userId": {
    "description": "User's mongo ObjectId hex string",
    "type": "string"
   }
  },
  "required": [
   "appId",
   "userId",
   "commId"
  ],
  "type": "object"
 },
 "name": "neblla_set_communication_important"
}
