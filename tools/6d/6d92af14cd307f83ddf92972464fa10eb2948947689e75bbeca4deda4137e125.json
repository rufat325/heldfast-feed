{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compare one or two post-2023 new-build SDA funding scenarios from current official facts. Free. Requires all residents to be SDA-eligible; excludes rent, support services, vacancies and individual eligibility decisions.",
 "inputSchema": {
  "$defs": {
   "SdaScenario": {
    "additionalProperties": false,
    "properties": {
     "building_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Building Id",
      "type": "string"
     },
     "category_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Category Id",
      "type": "string"
     },
     "gst_treatment": {
      "enum": [
       "not_paid_or_credits_claimed",
       "paid_credits_not_claimed"
      ],
      "title": "Gst Treatment",
      "type": "string"
     },
     "location_id": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
     },
     "ooa": {
      "title": "Ooa",
      "type": "boolean"
     },
     "sprinklers": {
      "title": "Sprinklers",
      "type": "boolean"
     }
    },
    "required": [
     "building_id",
     "category_id",
     "location_id",
     "ooa",
     "sprinklers",
     "gst_treatment"
    ],
    "title": "SdaScenario",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "as_of": {
    "format": "date",
    "title": "As Of",
    "type": "string"
   },
   "scenarios": {
    "items": {
     "$ref": "#/$defs/SdaScenario"
    },
    "maxItems": 2,
    "minItems": 1,
    "title": "Scenarios",
    "type": "array"
   },
   "scope_confirmed": {
    "title": "Scope Confirmed",
    "type": "boolean"
   }
  },
  "required": [
   "scope_confirmed",
   "as_of",
   "scenarios"
  ],
  "title": "SdaInputs",
  "type": "object"
 },
 "name": "compare_ndis_sda",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ]
}
