{
 "description": "Create a subscription plan (recurring template). Endpoint: POST /plans",
 "inputSchema": {
  "properties": {
   "currency": {
    "description": "Currency code (default BRL)",
    "type": "string"
   },
   "features": {
    "description": "Plan features",
    "items": {
     "properties": {
      "identifier": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "identifier": {
    "description": "Unique slug identifier (e.g., 'basic_monthly')",
    "type": "string"
   },
   "interval": {
    "description": "Interval quantity (e.g., 1)",
    "type": "number"
   },
   "interval_type": {
    "description": "Interval unit",
    "enum": [
     "weeks",
     "months"
    ],
    "type": "string"
   },
   "name": {
    "description": "Plan name",
    "type": "string"
   },
   "payable_with": {
    "description": "Allowed payment methods: credit_card, bank_slip, pix",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "value_cents": {
    "description": "Price per period in cents (BRL)",
    "type": "number"
   }
  },
  "required": [
   "name",
   "identifier",
   "interval",
   "interval_type",
   "value_cents"
  ],
  "type": "object"
 },
 "name": "create_plan"
}
