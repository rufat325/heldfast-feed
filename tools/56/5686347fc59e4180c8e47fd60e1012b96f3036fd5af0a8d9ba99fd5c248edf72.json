      "maxLength": 16384,
      "minLength": 1,
      "title": "Body",
      "type": "string"
     },
     "public": {
      "const": true,
      "default": true,
      "title": "Public",
      "type": "boolean"
     },
     "summary": {
      "default": "",
      "maxLength": 240,
      "title": "Summary",
      "type": "string"
     }
    },
    "required": [
     "base_revision_id",
     "body"
