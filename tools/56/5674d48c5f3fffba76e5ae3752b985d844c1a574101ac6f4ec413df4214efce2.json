{
 "description": "Browse the \"Year in Tabla\" calendar \u2014 anniversaries and festivals of the tabla world \u2014 plus curated \"Did you know?\" facts. Use mode to select events, festivals, or facts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "type": "string"
   },
   "day": {
    "maximum": 31,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "enum": [
     "events",
     "festivals",
     "did_you_know"
    ],
    "type": "string"
   },
   "month": {
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "type": "string"
   },
   "topic": {
    "type": "string"
   },
   "year": {
    "maximum": 2100,
    "minimum": 1900,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "tabla_calendar",
 "title": "Tabla Calendar & Lore"
}
