{
 "description": "Revoke a passport (admin only). Wipes the NFT and submits a passport_revoked audit message.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "reason": {
    "description": "Revocation reason",
    "type": "string"
   },
   "serial": {
    "description": "NFT serial number",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "tokenId": {
    "description": "HTS passport token ID",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "tokenId",
   "serial"
  ],
  "type": "object"
 },
 "name": "revoke_passport"
}
