{
 "description": "Verify ecommerce/storefront work before reporting completion. Paid CDS-COMMERCE-001 check returns VERIFIED_COMPLETE only when every required test passes; otherwise returns machine-readable defects or missing evidence plus corrective actions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "evidence": {
    "additionalProperties": false,
    "properties": {
     "cart": {
      "additionalProperties": false,
      "properties": {
       "available": {
        "type": "boolean"
       },
       "url": {
        "format": "uri",
        "type": "string"
       }
      },
      "type": "object"
     },
     "checkout": {
      "additionalProperties": false,
      "properties": {
       "available": {
        "type": "boolean"
       },
       "url": {
        "format": "uri",
        "type": "string"
       }
      },
      "type": "object"
     },
     "contact_url": {
      "format": "uri",
      "type": "string"
     },
     "privacy_url": {
      "format": "uri",
      "type": "string"
     },
     "product": {
      "additionalProperties": false,
      "properties": {
       "inventory": {
        "type": [
         "string",
         "number"
        ]
       },
       "price": {
        "additionalProperties": false,
        "properties": {
         "amount": {
          "minimum": 0,
          "type": "number"
         },
         "currency": {
          "pattern": "^[A-Za-z]{3}$",
          "type": "string"
         }
        },
        "type": "object"
       },
       "title": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     "returns_url": {
      "format": "uri",
      "type": "string"
     },
     "shipping_url": {
      "format": "uri",
      "type": "string"
     },
     "terms_url": {
      "format": "uri",
      "type": "string"
     }
    },
    "type": "object"
   },
   "objective": {
    "maxLength": 2000,
    "type": "string"
   },
   "standard_id": {
    "const": "CDS-COMMERCE-001",
    "type": "string"
   },
   "standard_version": {
    "const": "0.2.0",
    "type": "string"
   },
   "target_url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "target_url",
   "evidence"
  ],
  "type": "object"
 },
 "name": "creator_desk_verify_completion"
}
