{
 "description": "Estimate the LLM token count, cost, and context-window fit of a piece of text for a given model. Use this instead of guessing \u2014 models cannot count their own tokens. Returns JSON.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "model": {
    "default": "gpt-5.4",
    "description": "Model id, e.g. gpt-5.4.",
    "type": "string"
   },
   "output_tokens": {
    "default": 0,
    "description": "Expected output tokens for cost.",
    "minimum": 0,
    "type": "integer"
   },
   "text": {
    "description": "The text to measure.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "token_count",
 "title": "Count LLM tokens"
}
