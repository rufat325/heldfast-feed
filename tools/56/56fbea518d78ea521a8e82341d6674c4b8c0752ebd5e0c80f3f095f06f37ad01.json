{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get report status"
 },
 "description": "Returns the status of a report created with create_free_report: queued, in_progress, ready, failed or expired, with the private link when ready. Wait pollAfterSeconds between calls. withLimitations=true means some source did not answer and its check shows \u25cb no data with the reason (unknown, not negative). Give the link only to the person.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "jobId": {
    "description": "jobId returned by create_free_report or purchase_report.",
    "pattern": "^scr_[A-Za-z0-9_-]{22}$",
    "type": "string"
   },
   "language": {
    "default": "es",
    "description": "Language of the texts in the answer (and of the report): es, en, de, nl or fr. Default es.",
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   },
   "statusToken": {
    "description": "statusToken returned by create_free_report or purchase_report.",
    "pattern": "^[A-Za-z0-9_-]{43}\\.[A-Za-z0-9_-]{43}$",
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "statusToken"
  ],
  "type": "object"
 },
 "name": "get_report_status",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "contract": {
    "const": "agent-api-1.1.0",
    "type": "string"
   },
   "errorCode": {
    "pattern": "^[A-Z0-9_]{1,100}$",
    "type": "string"
   },
   "estimatedSeconds": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "jobId": {
    "pattern": "^scr_[A-Za-z0-9_-]{22}$",
    "type": "string"
   },
   "language": {
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   },
   "notice": {
    "maxLength": 600,
    "minLength": 1,
    "type": "string"
   },
   "payment": {
    "additionalProperties": false,
    "properties": {
     "orderId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
     },
     "status": {
      "enum": [
       "pending",
       "paid",
       "expired",
       "failed",
       "refunded"
      ],
      "type": "string"
     }
    },
    "required": [
     "orderId",
     "status"
    ],
    "type": "object"
   },
   "pollAfterSeconds": {
    "maximum": 600,
    "minimum": 1,
    "type": "integer"
   },
   "previewUrl": {
    "maxLength": 400,
    "pattern": "^https:\\/\\/[^\\s]+$",
    "type": "string"
   },
   "queuePosition": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "stage": {
    "anyOf": [
     {
      "pattern": "^[A-Z0-9_]{1,64}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "awaiting_payment",
     "payment_received",
     "queued",
     "in_progress",
     "ready",
     "failed",
     "expired",
     "payment_expired",
     "refunded"
    ],
    "type": "string"
   },
   "withLimitations": {
    "type": "boolean"
   }
  },
  "required": [
   "contract",
   "language",
   "jobId",
   "status",
   "stage",
   "notice"
  ],
  "type": "object"
 },
 "title": "Get the status of a HOUSINGFAX report"
}
