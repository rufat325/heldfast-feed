{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calories burned walking, running, cycling, swimming, lifting and 20+ more activities, from Compendium MET values, your body weight and the time spent. Web page: https://calcbright.com/calories-burned-calculator",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activity": {
    "default": "run-6",
    "description": "Activity",
    "enum": [
     "walk-slow",
     "walk",
     "walk-fast",
     "hike",
     "run-5",
     "run-6",
     "run-7.5",
     "run-10",
     "cycle-leisure",
     "cycle-mod",
     "cycle-stationary",
     "swim-leisure",
     "swim-laps",
     "yoga",
     "weights",
     "weights-vig",
     "elliptical",
     "rowing",
     "aerobics",
     "jump-rope",
     "tennis",
     "basketball",
     "cleaning"
    ],
    "type": "string"
   },
   "kg": {
    "default": 70,
    "description": "Weight (kg)",
    "maximum": 350,
    "minimum": 25,
    "type": "number"
   },
   "lb": {
    "default": 155,
    "description": "Weight (lb)",
    "maximum": 770,
    "minimum": 55,
    "type": "number"
   },
   "minutes": {
    "default": 30,
    "description": "Duration (min)",
    "maximum": 1440,
    "minimum": 1,
