{
 "description": "Create a learning track (curated course sequence). After this, add courses in order with hivelearn_add_track_course. is_published defaults to false \u2014 publish once the curriculum is set.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "maxLength": 20000,
    "type": "string"
   },
   "difficulty_level": {
    "enum": [
     "beginner",
     "intermediate",
     "advanced"
    ],
    "type": "string"
   },
   "estimated_hours": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "is_featured": {
    "type": "boolean"
   },
   "is_published": {
    "description": "Defaults to false",
    "type": "boolean"
   },
   "thumbnail_url": {
    "format": "uri",
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_track"
}
