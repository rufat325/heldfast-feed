{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "One person's profile: role, bio, website, social links, studios, what their site is built with (confirmed technologies) and their work on Tangent. Set include_image to also get a small preview of their site. Example: {\"slug\": \"emil-kowalski\"}",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_image": {
    "default": false,
    "description": "Also attach a small WebP thumbnail (under ~100 KB) as an image block. Off by default to save tokens.",
    "type": "boolean"
   },
   "slug": {
    "description": "Person slug, e.g. \"rauno-freiberg\".",
    "maxLength": 80,
    "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_person",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "added_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "avatar_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "bio": {
    "type": [
     "string",
     "null"
    ]
   },
   "built_with": {
    "description": "Confirmed technologies their site is built with.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "image_url": {
    "description": "Their site's OG image, else their avatar: the stored image file, served directly.",
    "type": [
     "string",
     "null"
    ]
   },
   "links": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "resource_count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "role": {
    "type": [
     "string",
     "null"
    ]
   },
   "site_url": {
    "description": "Their site's own address, untagged.",
    "type": [
     "string",
     "null"
    ]
   },
   "slug": {
    "type": "string"
   },
   "studios": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tangent_url": {
    "description": "Their profile on Tangent.",
    "type": "string"
   },
   "thumbnail_url": {
    "description": "The same URL as image_url (people's images have no smaller stored copy).",
    "type": [
     "string",
     "null"
    ]
   },
   "website": {
    "description": "Visit link for their site (tagged utm_source=tangent-mcp).",
    "type": [
     "string",
     "null"
    ]
   },
   "work": {
    "description": "Their published work on Tangent, newest first.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": [
        "string",
        "null"
       ]
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "domain": {
       "type": "string"
      },
      "image_url": {
       "description": "Full-size preview (screenshot, else the site's OG image): the stored image file, served directly.",
       "type": [
        "string",
        "null"
       ]
      },
      "license": {
       "description": "SPDX licence id, e.g. \"MIT\".",
       "type": [
        "string",
        "null"
       ]
      },
      "match_reasons": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "notable_for": {
       "type": [
        "string",
        "null"
       ]
      },
      "open_source": {
       "description": "true: OSI-licensed; false: source-available or closed; null when unknown.",
       "type": [
        "boolean",
        "null"
       ]
      },
      "patterns": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "pricing": {
       "description": "free, freemium, paid or open_source; null when unknown.",
       "type": [
        "string",
        "null"
       ]
      },
      "sections": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "site_url": {
       "description": "The site's own address, untagged. Use it to compare, dedupe or cite.",
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "tangent_url": {
       "description": "This resource's page on Tangent.",
       "type": "string"
      },
      "thumbnail_url": {
       "description": "A smaller stored copy of image_url (a screenshot's 720px-wide WebP) when one exists; otherwise the same URL as image_url.",
       "type": [
        "string",
        "null"
       ]
      },
      "type": {
       "type": "string"
      },
      "url": {
       "description": "Visit link for the site (tagged utm_source=tangent-mcp). Use this one when linking people to the site.",
       "type": "string"
      }
     },
     "required": [
      "slug",
      "name",
      "url",
      "site_url",
      "tangent_url",
      "domain",
      "type",
      "description",
      "category",
      "sections",
      "patterns",
      "pricing",
      "open_source",
      "license",
      "notable_for",
      "image_url",
      "thumbnail_url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "slug",
   "name",
   "role",
   "bio",
   "website",
   "site_url",
   "tangent_url",
   "image_url",
   "thumbnail_url",
   "avatar_url",
   "resource_count",
   "links",
   "studios",
   "built_with",
   "added_at",
   "work"
  ],
  "type": "object"
 },
 "title": "Get a person"
}
