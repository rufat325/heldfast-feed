  "properties": {
   "period": {
    "description": "Lookback window. '24h' (default) or '7d'.",
    "enum": [
     "24h",
     "7d"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_status_history",
 "outputSchema": {
