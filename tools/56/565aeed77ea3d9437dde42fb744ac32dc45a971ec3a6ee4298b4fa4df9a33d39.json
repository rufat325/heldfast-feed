   },
   "points": {
    "description": "Hourly buckets",
    "items": {
     "description": "One hour",
     "properties": {
      "fresh_sec": {
       "description": "Data age in seconds"
      },
      "status": {
       "description": "Worst status in the hour"
      },
      "ts": {
       "description": "Hour start, Unix milliseconds"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "uptime_percent": {
    "description": "Share of operational hours"
   }
  },
  "type": "object"
 }
