{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "File a planning enquiry with Jenesis Travel. Call only after the user has stated their own name and email in the conversation and confirmed they want Jenesis to reply. Never invent or substitute contact details: an enquiry carrying a placeholder address cannot be answered and is rejected. If you do not have a real email, ask for it, or share the contact form or WhatsApp instead of calling this tool. One enquiry per email every 4 hours \u2014 do not retry if it already succeeded. This does not reserve hotels or take payment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "budget": {
    "enum": [
     "under-1000",
     "1000-2500",
     "2500-5000",
     "5000-10000",
     "10000+"
    ],
    "type": "string"
   },
   "clientLabel": {
    "enum": [
     "claude",
     "chatgpt",
     "grok",
     "other"
    ],
    "type": "string"
   },
   "comments": {
    "maxLength": 2000,
    "type": "string"
   },
   "email": {
    "description": "The traveller's own email address, exactly as they gave it in the conversation. This is the only way Jenesis can reply, so it must be an address they actually read. Never guess one, derive one from their name, or fill in a documentation placeholder such as an example.com address \u2014 ask the traveller for it instead.",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "endDate": {
    "type": "string"
   },
   "enquiryType": {
    "enum": [
     "private",
     "group",
     "phuket_fit"
    ],
    "type": "string"
   },
   "experience": {
    "enum": [
     "wellness-retreats",
     "boutique-hotels",
     "culinary-tours",
     "adventure",
     "family-holiday",
     "destination-wedding",
     "cultural-heritage",
     "romantic-escapes",
     "island-coastal",
     "home-away",
     "amanta-sathorn",
     "riverine-place",
     "not-sure"
    ],
    "type": "string"
   },
   "fitnessLevel": {
    "enum": [
     "Beginner",
     "Intermediate",
     "Advanced"
    ],
    "type": "string"
   },
   "groupObjective": {
    "maxLength": 2000,
    "type": "string"
   },
   "groupProgramme": {
    "enum": [
     "corporate-incentive",
     "bangkok-phuket",
     "bangkok-pattaya",
     "phuket-krabi",
     "retreat",
     "trade-partner",
     "private-group",
     "not-sure"
    ],
    "type": "string"
   },
   "groupSize": {
    "enum": [
     "8-20",
     "21-40",
     "41-80",
     "81-120",
     "120+",
     "not-sure"
    ],
    "type": "string"
   },
   "message": {
    "maxLength": 2000,
    "type": "string"
   },
   "name": {
    "description": "The traveller's own name, exactly as they gave it in the conversation. Do not invent one.",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   },
   "phone": {
    "type": "string"
   },
   "phuketFitPackage": {
    "enum": [
     "5N/6D Fit Reset",
     "6N/7D Fit & Wellness Journey",
     "7N/8D Signature Phuket Fit Camp",
     "Not sure yet"
    ],
    "type": "string"
   },
   "roomType": {
    "enum": [
     "1-bed-deluxe",
     "1-bed-executive",
     "2-bed-deluxe",
     "2-bed-executive",
     "1-bed",
     "2-bed",
     "3-bed"
    ],
    "type": "string"
   },
   "startDate": {
    "type": "string"
   },
   "travelers": {
    "enum": [
     "1",
     "2",
     "3-4",
     "5-8",
     "9+",
     "5+"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "email",
   "enquiryType"
  ],
  "type": "object"
 },
 "name": "start_enquiry",
 "title": "Start a Jenesis travel enquiry"
}
