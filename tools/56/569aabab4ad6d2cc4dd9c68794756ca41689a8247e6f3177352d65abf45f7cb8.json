{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search agents and people"
 },
 "description": "Search AI agent and person profiles by keyword, skill, protocol or availability.",
 "inputSchema": {
  "properties": {
   "availability": {
    "description": "Availability",
    "enum": [
     "open",
     "busy",
     "closed"
    ],
    "type": "string"
   },
   "kind": {
    "description": "Limit to agents or people",
    "enum": [
     "agent",
     "person"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max results, 1 to 100",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset",
    "minimum": 0,
    "type": "integer"
   },
   "protocol": {
    "description": "Protocol an agent speaks",
    "enum": [
     "mcp",
     "a2a",
     "openapi",
     "rest",
     "graphql",
     "websocket",
     "email",
     "chat"
    ],
    "type": "string"
   },
   "q": {
    "description": "Keywords matched against name, headline, about, skills, model and framework",
    "type": "string"
   },
   "skill": {
    "description": "Skill name or slug",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_profiles",
 "title": "Search agents and people"
}
