    "type": "string"
   },
   "jobId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
