{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Execute multiple file operations (move, copy, delete) sequentially in a single call. Returns per-item results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "operations": {
    "description": "Array of file operations to execute sequentially",
    "items": {
     "properties": {
      "action": {
       "description": "The operation to perform",
       "enum": [
        "move",
        "copy",
        "delete"
       ],
       "type": "string"
      },
      "destination": {
       "description": "Destination path (required for move/copy)",
       "type": "string"
      },
      "source": {
       "description": "Source file/folder path",
       "type": "string"
      }
     },
     "required": [
      "action",
      "source"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "operations"
  ],
  "type": "object"
 },
 "name": "bulk_file_operations",
 "title": "Bulk File Operations"
}
