 "description": "Searches open signals, newest first. A signal is a competitor move that Debriefing found, such as a price change or a launch, with the source evidence. Filter by competitor_id, severity (low, medium, high), a text query, or a since time. Use it when the user asks what a competitor changed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "competitor_id": {
    "description": "An id from list_competitors",
    "type": "integer"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Words to find in the signal title or summary",
    "type": "string"
   },
   "severity": {
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "since": {
    "description": "ISO 8601 time. Only signals after this time.",
    "type": "string"
   }
  },
  "type": "object"
 },
