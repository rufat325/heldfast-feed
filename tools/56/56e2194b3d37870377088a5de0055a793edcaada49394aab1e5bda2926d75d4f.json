{"annotations":{"openWorldHint":false,"readOnlyHint":true,"title":"Traffic sources"},"description":"Get traffic sources: referrers, trackable links, and UTM campaigns combined. Shows where visitors are coming from. Call twice with different periods to compare source mix over time. Optional filters segment by country, browser, os, device type, UTM source, or referrer.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"filter_browser":{"description":"Browser substring match (e.g. 'Chrome')","type":"string"},"filter_country":{"description":"2-letter country code (e.g. 'US')","type":"string"},"filter_device_type":{"description":"Device type: 'desktop' | 'mobile' | 'tablet'","type":"string"},"filter_os":{"description":"OS substring match (e.g. 'iOS')","type":"string"},"filter_referrer_contains":{"description":"Referrer substring (e.g. 'google')","type":"string"},"filter_utm_source":{"description":"Exact UTM source (e.g. 'twitter')","type":"string"},"limit":{"default":20,"description":"Max results (1-1000)","type":"number"},"period":{"default":"30d","description":"Time period","type":"string"},"site":{"description":"Site domain or UUID","type":"string"}},"required":["site"],"type":"object"},"name":"get_traffic_sources","title":"Traffic sources"}
