{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search across all SharePoint sites, document libraries, lists, and list items. More powerful than search_library_files which only searches within a single library.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entityTypes": {
    "description": "Types of content to search (default: all types)",
    "items": {
     "enum": [
      "driveItem",
      "listItem",
      "list",
      "site"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "query": {
    "description": "Search query text",
    "type": "string"
   },
   "top": {
    "description": "Max results (default: 25)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "search_sharepoint"
}
