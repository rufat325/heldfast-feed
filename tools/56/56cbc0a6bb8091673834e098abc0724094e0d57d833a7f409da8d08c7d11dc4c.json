{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/commerce.variant-compare",
  "agent-utilities/priceMicroUsd": 500
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Compare requested product attributes with an offered variant and list missing or mismatched fields. PAID: 500 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "offered": {
      "maxProperties": 100,
      "type": "object"
     },
     "requested": {
      "maxProperties": 100,
      "type": "object"
     }
    },
    "required": [
     "requested",
     "offered"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "commerce_variant_compare",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "extra": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "matches": {
    "type": "boolean"
   },
   "mismatched": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attribute": {
       "type": "string"
      },
      "offered": {},
      "requested": {}
     },
     "required": [
      "attribute",
      "requested",
      "offered"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "missing": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "scope": {
    "type": "string"
   }
  },
  "required": [
   "matches",
   "missing",
   "mismatched",
   "extra",
   "scope"
  ],
  "type": "object"
 }
}
