{
 "_meta": {
  "openai/toolInvocation/invoked": "Source files read",
  "openai/toolInvocation/invoking": "Reading source files"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read up to 50 files from the editable source tree in one call (8388608 bytes in total). Each path succeeds or fails on its own; paths past the budget fail with BATCH_BUDGET_EXCEEDED. Use read_source_files for source; use read_files instead for the files the site serves.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxBytesPerFile": {
    "description": "Per-file size cap in bytes. Default 1048576, max 5242880.",
    "exclusiveMinimum": 0,
    "maximum": 5242880,
    "type": "integer"
   },
   "name": {
    "description": "Site name as shown by list_sites, e.g. my-portfolio. Provide name or siteId.",
    "type": "string"
   },
   "paths": {
    "description": "Paths inside the source tree, e.g. 'src/App.tsx' (1 to 50). Results keep this order.",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "siteId": {
    "description": "Site id from list_sites or get_site. Use instead of name.",
    "type": "string"
   }
  },
  "required": [
   "paths"
  ],
  "type": "object"
 },
 "name": "read_source_files",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budgetExceededAt": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "files": {
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "content": {
         "type": "string"
        },
        "encoding": {
         "enum": [
          "utf8",
          "base64"
         ],
         "type": "string"
        },
        "ok": {
         "const": true,
         "type": "boolean"
        },
        "path": {
         "type": "string"
        },
        "size": {
         "type": "number"
        }
       },
       "required": [
        "ok",
        "path",
        "size",
        "encoding",
        "content"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "error": {
         "additionalProperties": false,
         "properties": {
          "code": {
           "type": "string"
          },
          "details": {
           "additionalProperties": {},
           "propertyNames": {
            "type": "string"
           },
           "type": "object"
          },
          "message": {
           "type": "string"
          }
         },
         "required": [
          "code",
          "message"
         ],
         "type": "object"
        },
        "ok": {
         "const": false,
         "type": "boolean"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "ok",
        "path",
        "error"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "siteId": {
    "type": "string"
   },
   "totalBytes": {
    "type": "number"
   }
  },
  "required": [
   "siteId",
   "name",
   "files",
   "totalBytes",
   "budgetExceededAt"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "sites:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Read multiple source files in one call"
}
