{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Price for a delivery country"
 },
 "description": "Price in the billing currency of the DELIVERY country (the currency cannot be chosen), with the tax regime: French VAT inside the EU, 0% VAT outside the EU (duties payable by the buyer). Indicative and non-binding; the checkout on brm-chronographes.com is authoritative.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "configuration": {
    "additionalProperties": false,
    "properties": {
     "engraving": {
      "description": "Optional engraving text (not priced, not rendered).",
      "maxLength": 24,
      "type": "string"
     },
     "model": {
      "description": "model_id from list_models, e.g. 'v6-44-sa'.",
      "type": "string"
     },
     "options": {
      "description": "option_id values from describe_model. Unset components keep their default.",
      "items": {
       "type": "string"
      },
      "maxItems": 40,
      "type": "array"
     }
    },
    "required": [
     "model"
    ],
    "type": "object"
   },
   "country": {
    "description": "ISO-3166 alpha-2, e.g. 'US'.",
    "type": "string"
   },
   "display_currency": {
    "maxLength": 3,
    "type": "string"
   },
   "lang": {
    "default": "en",
    "enum": [
     "fr",
     "en",
     "de",
     "es",
     "it",
     "nl",
     "pt",
     "ja",
     "ko",
     "zh",
     "ar",
     "hi"
    ],
    "type": "string"
   }
  },
  "required": [
   "configuration",
   "country"
  ],
  "type": "object"
 },
 "name": "quote_configuration",
 "outputSchema": {
  "properties": {
   "billing_currency": {
    "type": "string"
   },
   "binding": {
    "const": false
   },
   "catalogue_price_eur_incl_fr_vat": {
    "type": "number"
   },
   "delivery_country": {
    "type": "string"
   },
   "display_only": {
    "properties": {
     "currency": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "price": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "lead_time": {
    "description": "No firm number of weeks is given by this API: show `url` (the delivery page of brm-chronographes.com, in the user's language) for lead times.",
    "properties": {
     "text": {
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "type": "object"
   },
   "legal_notice": {
    "type": [
     "string",
     "null"
    ]
   },
   "model_id": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "price": {
    "type": "number"
   },
   "price_formatted": {
    "type": "string"
   },
   "rounding": {
    "type": "string"
   },
   "shipping": {
    "const": "included"
   },
   "tax_regime": {
    "properties": {
     "vat_included": {
      "type": "boolean"
     },
     "vat_rate_percent": {
      "type": "number"
     },
     "zone": {
      "enum": [
       "france",
       "eu_intra",
       "ue_oss",
       "dom_tom",
       "export"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Price for a delivery country"
}
