  "title": "chainpeek: the Hyperliquid perp market list with mark, oracle, open interest, volume and max leverage"
 },
 "description": "chainpeek: List Hyperliquid perpetual markets with mark, oracle, open interest and volume. For funding history use get_funding_rates. Returns the Hyperliquid perp market list: mark, oracle, premium, open interest, 24 h volume and change, max leverage, funding; filter by `symbols`, sort, limit. Hyperliquid perps only; cached up to 60 s; open interest USD = coins x mark. Data only, not trading advice. Bad input is a 422 (not charged). Typically 0.3-2 s. Price: USD 0.002. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/ethereum-base-chain-data-mcp-server.html",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 50,
    "description": "Rows returned, 1-250 (default 50).",
    "maximum": 250,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "order": {
    "default": "desc",
    "description": "desc (default) or asc.",
    "enum": [
     "desc",
     "asc"
    ],
    "title": "Order",
    "type": "string"
   },
   "sort": {
    "default": "volume",
    "description": "volume (24 h, default), open_interest, funding, premium, leverage, change (24 h) or symbol.",
    "enum": [
     "volume",
     "open_interest",
     "funding",
     "premium",
     "leverage",
     "change",
     "symbol"
    ],
    "title": "Sort",
    "type": "string"
   },
   "symbols": {
    "anyOf": [
     {
      "items": {
       "pattern": "^[A-Za-z0-9._-]{1,20}$",
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional: only these perps (case-insensitive, at most 50). Unknown names are listed in symbols_not_found.",
    "title": "Symbols"
   }
  },
  "title": "get_perp_marketsArguments",
  "type": "object"
 },
 "name": "get_perp_markets",
