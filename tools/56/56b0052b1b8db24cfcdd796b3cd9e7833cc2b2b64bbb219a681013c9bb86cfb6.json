{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Deterministically resolve a folder and set a custom metadata field (key/value) on every CONVERTED video (POST /videos/{id}?custom_fields). dry_run=true (default) previews the affected videos.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dry_run": {
    "default": true,
    "description": "true = preview only; false = apply",
    "type": "boolean"
   },
   "folder_ref": {
    "description": "Folder name, ID, or dashboard URL",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Reserved client-supplied retry key",
    "type": "string"
   },
   "key": {
    "description": "Custom field key (max 200 chars)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "value": {
    "description": "Custom field value (max 500 chars)",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "folder_ref",
   "key",
   "value"
  ],
  "type": "object"
 },
 "name": "panda_action_set_custom_field_for_folder",
 "title": "Set Custom Field for Folder"
}
