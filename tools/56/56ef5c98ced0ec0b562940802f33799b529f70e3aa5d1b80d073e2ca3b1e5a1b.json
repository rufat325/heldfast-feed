{
 "description": "Set up a complete project with a component library (shadcn, radix, headlessui, material) including config files, dependencies, and initial components.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "components": {
    "description": "Components to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "customizations": {
    "additionalProperties": {},
    "description": "Additional customizations",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "framework": {
    "description": "Target framework",
    "enum": [
     "react",
     "nextjs",
     "vue",
     "svelte",
     "angular",
     "html"
    ],
    "type": "string"
   },
   "library": {
    "description": "Component library to set up",
    "enum": [
     "shadcn",
     "radix",
     "headlessui",
     "material",
     "primevue",
     "none"
    ],
    "type": "string"
   },
   "patterns": {
    "description": "UI patterns to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "projectName": {
    "description": "Name of the project",
    "type": "string"
   },
   "projectPath": {
    "description": "Project directory path",
    "type": "string"
   },
   "skipGit": {
    "default": false,
    "description": "Skip git initialization",
    "type": "boolean"
   },
   "skipInstall": {
    "default": false,
    "description": "Skip npm install step",
    "type": "boolean"
   },
   "theme": {
    "description": "Theme configuration",
    "type": "string"
   }
  },
  "required": [
   "library",
   "framework",
   "projectName"
  ],
  "type": "object"
 },
 "name": "setup_component_library"
}
