 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Repeat a wake-up call"
 },
 "description": "Repeat a wake-up call on your wake-up-calls plan: every N minutes (at least 5), hourly, daily or weekly at a time in a time zone. Each run comes with an idempotency_key (dedupe on it). A run that fails after every retry is missed 21 to 25 minutes after its time and puts one \"missed\" message in alert_inbox_instance_id (or the target inbox). Up to 10 per plan.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "alert_inbox_instance_id": {
    "description": "One of your inboxes for missed-run messages.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "instance_id": {
    "description": "Utility instance id from buy or list_utilities.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Your own label.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "passport_token": {
    "description": "Your amp_ token, only if your client cannot send it as an Authorization header; leave it out when your MCP app signed in.",
    "pattern": "^amp_(?:s_)?[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "payload": {
    "additionalProperties": {},
    "description": "Any JSON object, up to 8 KB, sent with every run.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "repeat": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "minutes": {
        "description": "Minutes on the UTC clock: an N that divides a day (5, 15, 60, 1440) runs from 00:00 UTC.",
        "maximum": 10080,
        "minimum": 5,
        "type": "integer"
       },
       "type": {
        "const": "every",
        "type": "string"
       }
      },
      "required": [
       "type",
       "minutes"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "minute": {
        "maximum": 59,
        "minimum": 0,
        "type": "integer"
       },
       "type": {
        "const": "hourly",
        "type": "string"
       }
      },
      "required": [
       "type",
       "minute"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "at": {
        "description": "Time of day \"HH:MM\", 24-hour clock, in time_zone.",
        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
        "type": "string"
       },
       "type": {
        "const": "daily",
        "type": "string"
       }
      },
      "required": [
       "type",
       "at"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "at": {
        "description": "Time of day \"HH:MM\", 24-hour clock, in time_zone.",
        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
        "type": "string"
       },
       "days": {
        "description": "Weekdays, each once.",
        "items": {
         "enum": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
         ],
         "type": "string"
        },
        "maxItems": 7,
        "minItems": 1,
        "type": "array"
       },
       "type": {
        "const": "weekly",
        "type": "string"
       }
      },
      "required": [
       "type",
       "days",
       "at"
      ],
      "type": "object"
     }
    ],
    "description": "When it repeats."
   },
   "target": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "inbox_instance_id": {
        "description": "One of your webhook inboxes.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "type": {
        "const": "inbox",
        "type": "string"
       }
      },
      "required": [
       "type",
       "inbox_instance_id"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "url",
        "type": "string"
       },
       "url": {
        "description": "A public https URL we POST to.",
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "type",
       "url"
      ],
      "type": "object"
     }
    ],
    "description": "Where each run is delivered."
   },
   "time_zone": {
    "description": "IANA time zone, for example Europe/Istanbul. Default UTC.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "instance_id",
   "repeat",
   "target"
  ],
  "type": "object"
 },
 "name": "schedule_create",
 "title": "Repeat a wake-up call"
}
