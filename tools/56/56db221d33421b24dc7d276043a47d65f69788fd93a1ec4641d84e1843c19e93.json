 "_meta": {
  "alias_of": "host.tool.test"
 },
 "description": "Dry-run a published tool by name: verdict (pass/will_fail/unverifiable), writes rolled back (dry_run); see host.quickstart.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "args": {
    "description": "Arguments to pass, same shape as a real call.",
    "type": "object"
   },
   "fixtures": {
    "description": "Chain tools only: {\"<step number or tool name>\": <recorded result>}. A fixtured step executes nothing (no upstream call); later mappings resolve against it. host.runs.get(run_id, as_fixtures=true) exports a real run in this shape.",
    "type": "object"
   },
   "name": {
    "description": "Local name of the already-published tool to dry-run.",
    "type": "string"
   },
   "tenant_key": {
    "description": "The key `signup` returned. Optional on the connection that ran signup (or host.redeem): that connection is already bound to the tenant it created, so later calls on it need no tenant_key. On a connection with no Authorization: Bearer header and no prior signup, omitting it implicitly signs that connection up as a brand-new tenant and runs this call as it -- see host.whoami's source field. When both a header and this argument are present, the header wins.",
    "type": "string"
   }
  },
  "required": [
   "name",
   "args"
  ],
  "type": "object",
  "x-deprecated": {
   "replaced_by": "host.tool.test",
   "sunset": "2026-12-31"
  }
 },
