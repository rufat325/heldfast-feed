{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate a lightweight SVG placeholder image at any size, with an optional label and custom background/text colors. Dependency-free, pastes straight into a page or mockup. Use for wireframes and design stubs instead of hotlinking a placeholder service.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bg": {
    "default": "#e5e7eb",
    "description": "Background color (hex, rgb() or hsl()).",
    "maxLength": 32,
    "type": "string"
   },
   "color": {
    "default": "#6b7280",
    "description": "Text color.",
    "maxLength": 32,
    "type": "string"
   },
   "height": {
    "default": 400,
    "description": "Height in pixels.",
    "maximum": 4000,
    "minimum": 1,
    "type": "integer"
   },
   "text": {
    "description": "Label text. Defaults to the dimensions, e.g. \"600\u00d7400\".",
    "maxLength": 120,
    "type": "string"
   },
   "width": {
    "default": 600,
    "description": "Width in pixels.",
    "maximum": 4000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "placeholder_image",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "height": {
    "type": "number"
   },
   "svg": {
    "description": "The SVG markup.",
    "type": "string"
   },
   "width": {
    "type": "number"
   }
  },
  "required": [
   "svg",
   "width",
   "height"
  ],
  "type": "object"
 },
 "title": "Generate a placeholder image (SVG)"
}
