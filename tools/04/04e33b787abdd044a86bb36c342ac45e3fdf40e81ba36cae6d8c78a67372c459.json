{
 "annotations": {},
 "description": "Set a node's fill or stroke. SOLID: color, opacity. GRADIENT_*: stops, geometry, opacity.",
 "inputSchema": {
  "properties": {
   "color": {
    "description": "SOLID: hex #RRGGBB or #RRGGBBAA",
    "type": "string"
   },
   "geometry": {
    "description": "GRADIENT: in percentX/percentY. Linear: start, end, angle. Others: center, radius, rotation."
   },
   "mode": {
    "description": "replace (default) or append on top",
    "type": "string"
   },
   "nodeId": {
    "description": "Node ID",
    "type": "string"
   },
   "opacity": {
    "description": "Opacity 0-1 (default 1), multiplied with hex alpha",
    "type": "number"
   },
   "stops": {
    "description": "GRADIENT: [{position: 0-1, color: hex}]"
   },
   "strokeWeight": {
    "description": "Stroke width (default 1), stroke only",
    "type": "number"
   },
   "target": {
    "description": "fill (default) or stroke",
    "type": "string"
   },
   "type": {
    "description": "SOLID, GRADIENT_LINEAR, GRADIENT_RADIAL, GRADIENT_ANGULAR, or GRADIENT_DIAMOND",
    "type": "string"
   }
  },
  "required": [
   "nodeId",
   "type"
  ],
  "type": "object"
 },
 "name": "set_paint"
}
