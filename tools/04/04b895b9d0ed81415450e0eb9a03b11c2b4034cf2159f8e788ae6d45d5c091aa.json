 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Export Montage Video"
 },
 "description": "Export montage clips as one stitched video. Spends credits: call it only after the user confirmed the clips and their order in chat. Returns the generation_id to poll with get_generation_status.",
 "inputSchema": {
  "properties": {
   "aspect_ratio": {
    "description": "Output video aspect ratio in W:H format",
    "type": "string"
   },
   "base_resolution": {
    "description": "Output base resolution in pixels",
    "minimum": 1,
    "type": "integer"
   },
   "clips": {
    "description": "Ordered generation-result clips to stitch into the montage",
    "items": {
     "properties": {
      "generation_result_id": {
       "minimum": 1,
       "type": "integer"
      },
      "in_point": {
       "type": [
        "number",
        "null"
       ]
      },
      "muted": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "order": {
       "minimum": 0,
       "type": "integer"
      },
      "out_point": {
       "type": [
        "number",
        "null"
       ]
      },
      "speed": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "generation_result_id",
      "order"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "fit_mode": {
    "description": "How each clip fits the output frame: contain or cover",
    "type": "string"
   }
  },
  "required": [
   "clips",
   "aspect_ratio",
   "base_resolution",
   "fit_mode"
  ],
  "type": "object"
 },
 "name": "mcp_export_montage",
