{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search products"
 },
 "description": "Search live FastDrop products by name/tagline text and/or curated tag. Optionally filter to x402-payable services (listed in the Bazaar catalog). Results ranked by votes and include verification status (mcpVerified) and freshness where available.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max results, 1-50, default 20",
    "type": "number"
   },
   "query": {
    "description": "Text matched against name and tagline",
    "type": "string"
   },
   "tag": {
    "description": "Curated tag slug",
    "enum": [
     "ai-agents",
     "developer-tools",
     "mcp-server",
     "data",
     "automation",
     "productivity",
     "cloud",
     "security",
     "search",
     "docs",
     "payments",
     "analytics",
     "marketing",
     "design",
     "finance",
     "writing",
     "voice",
     "browser-automation",
     "llm-apis",
     "vector-db",
     "rag",
     "chatbots",
     "image-generation",
     "video-generation",
     "code-generation",
     "workflow-orchestration",
     "observability",
     "no-code",
     "customer-support",
     "crm",
     "scheduling",
     "testing",
     "devops"
    ],
    "type": "string"
   },
   "x402": {
    "description": "If true, only return products marked x402-payable via Bazaar enrichment",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "search_products",
 "outputSchema": {
  "properties": {
   "products": {
    "items": {
     "properties": {
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "differentiator": {
       "type": "string"
      },
      "discordUrl": {
       "type": "string"
      },
      "docsUrl": {
       "type": "string"
      },
      "features": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "galleryUrls": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "githubUrl": {
       "type": "string"
      },
      "isOpenSource": {
       "type": "boolean"
      },
      "launchedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "linkedinUrl": {
       "type": "string"
      },
      "maker": {
       "description": "Who built the product. label is their own description of themselves (e.g. \"Indie hacker\"), \"Builder\" when unset. handle and profile are present once they have a public FastDrop profile.",
       "properties": {
        "handle": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "profile": {
         "description": "Public profile URL",
         "type": "string"
        }
       },
       "required": [
        "name",
        "label"
       ],
       "type": "object"
      },
      "makerNote": {
       "type": "string"
      },
      "mcpAuthRequired": {
       "type": "boolean"
      },
      "mcpKeyedVerified": {
       "type": "boolean"
      },
      "mcpTools": {
       "items": {
        "properties": {
         "description": {
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "mcpUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "mcpVerified": {
       "type": "boolean"
      },
      "mcpVerifiedAt": {
       "description": "ISO-8601 when set",
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "page": {
       "description": "Public product page URL",
       "type": "string"
      },
      "pricingModel": {
       "type": "string"
      },
      "problemSolved": {
       "type": "string"
      },
      "rating": {
       "type": [
        "number",
        "null"
       ]
      },
      "reviewCount": {
       "type": "number"
      },
      "slug": {
       "type": "string"
      },
      "tagline": {
       "type": "string"
      },
      "twitterUrl": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "videoUrl": {
       "type": "string"
      },
      "votes": {
       "type": "number"
      },
      "x402MaxAmount": {
       "type": [
        "string",
        "null"
       ]
      },
      "x402MinAmount": {
       "type": [
        "string",
        "null"
       ]
      },
      "x402Payable": {
       "type": "boolean"
      }
     },
     "required": [
      "name",
      "slug",
      "tagline",
      "url",
      "mcpVerified",
      "votes",
      "page"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "products"
  ],
  "type": "object"
 },
 "title": "Search products"
}
