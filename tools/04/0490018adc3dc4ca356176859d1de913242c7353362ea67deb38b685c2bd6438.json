    "minItems": 1,
    "title": "Destinations",
    "type": "array"
   },
   "near": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Near"
   },
   "origins": {
    "items": {
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "title": "Origins",
    "type": "array"
   }
  },
  "required": [
   "origins",
   "destinations"
  ],
  "title": "MatrixRequest",
  "type": "object"
 },
