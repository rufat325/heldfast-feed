{
 "description": "List supported and planned official data sources and their access characteristics.",
 "inputSchema": {
  "properties": {
   "topic": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Topic"
   }
  },
  "title": "list_sourcesArguments",
  "type": "object"
 },
 "name": "list_sources",
 "outputSchema": {
  "$defs": {
   "SourceDefinition": {
    "properties": {
     "access_notes": {
      "title": "Access Notes",
      "type": "string"
     },
     "auth_type": {
      "enum": [
       "none",
       "service_key",
       "user_key",
       "oauth"
      ],
      "title": "Auth Type",
      "type": "string"
     },
     "base_url": {
      "title": "Base Url",
      "type": "string"
     },
     "capabilities": {
      "items": {
       "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
     },
     "documentation_url": {
      "title": "Documentation Url",
      "type": "string"
     },
     "id": {
      "title": "Id",
      "type": "string"
     },
     "index_health": {
      "default": "planned",
      "enum": [
       "live",
       "limited",
       "token_required",
       "not_applicable",
       "planned"
      ],
      "title": "Index Health",
      "type": "string"
     },
     "interface": {
      "title": "Interface",
      "type": "string"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "observation_health": {
      "default": "planned",
      "enum": [
       "live_tested",
       "available",
       "token_required",
       "not_applicable",
       "planned"
      ],
      "title": "Observation Health",
      "type": "string"
     },
     "provider": {
      "title": "Provider",
      "type": "string"
     },
     "status": {
      "default": "planned",
      "enum": [
       "active",
       "planned",
       "experimental"
      ],
      "title": "Status",
      "type": "string"
     },
     "topics": {
      "items": {
       "type": "string"
      },
      "title": "Topics",
      "type": "array"
     }
    },
    "required": [
     "id",
     "name",
     "provider",
     "interface",
     "base_url",
     "documentation_url",
     "auth_type",
     "access_notes"
    ],
    "title": "SourceDefinition",
    "type": "object"
   }
  },
  "properties": {
   "sources": {
    "items": {
     "$ref": "#/$defs/SourceDefinition"
    },
    "title": "Sources",
    "type": "array"
   },
   "total": {
    "title": "Total",
    "type": "integer"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "title": "Warnings",
    "type": "array"
   }
  },
  "required": [
   "sources",
   "total"
  ],
  "title": "SourceListResponse",
  "type": "object"
 }
}
