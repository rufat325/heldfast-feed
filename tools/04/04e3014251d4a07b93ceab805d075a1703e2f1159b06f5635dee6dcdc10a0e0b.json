{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Rotation plan"
 },
 "description": "Plan fair player rotations for pickup games: who plays on each court every round and who sits out, balancing games played across the roster. Use when more players show up than court spots. Does not split money; for costs use split_costs or split_series.",
 "inputSchema": {
  "properties": {
   "capacity": {
    "description": "Players per court: 2 for singles, 4 for doubles, 10 for 5v5 basketball",
    "minimum": 1,
    "type": "integer"
   },
   "courts": {
    "description": "Number of courts in use at once (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "players": {
    "description": "Unique roster names, at least capacity x courts of them, e.g. [\"Asha\",\"Dev\",\"Mira\",\"Sam\",\"Lee\",\"Kai\"]",
    "items": {
     "type": "string"
    },
    "minItems": 2,
    "type": "array"
   },
   "rounds": {
    "description": "Number of rounds to schedule, 1-50",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "players",
   "capacity",
   "rounds"
  ],
  "type": "object"
 },
 "name": "rotation_plan",
 "outputSchema": {
  "properties": {
   "fairness": {
    "description": "Games-played balance across the roster",
    "properties": {
     "max_games": {
      "description": "Most games any player gets",
      "type": "integer"
     },
     "min_games": {
      "description": "Fewest games any player gets",
      "type": "integer"
     },
     "spread": {
      "description": "max_games minus min_games",
      "type": "integer"
     }
    },
    "required": [
     "min_games",
     "max_games",
     "spread"
    ],
    "type": "object"
   },
   "format": {
    "description": "Format label with players per side and courts, e.g. '2v2 on 2 court(s)' for capacity 4 (doubles), '1v1' for capacity 2; odd capacity shows 'N player(s) per court'",
    "type": "string"
   },
   "note": {
    "description": "Whether the rotation is perfectly balanced",
    "type": "string"
   },
   "rounds": {
    "description": "Number of rounds scheduled",
    "type": "integer"
   },
   "schedule": {
    "description": "One entry per round",
    "items": {
     "properties": {
      "courts": {
       "description": "Players on each court this round",
       "items": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "type": "array"
      },
      "round": {
       "description": "Round number starting at 1",
       "type": "integer"
      },
      "sitting": {
       "description": "Players sitting out this round",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "round",
      "courts",
      "sitting"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "format",
   "rounds",
   "fairness",
   "schedule",
   "note"
  ],
  "type": "object"
 },
 "title": "Rotation plan"
}
