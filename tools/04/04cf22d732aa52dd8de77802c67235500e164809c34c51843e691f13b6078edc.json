{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update one or more Nextcloud Registration app settings. Boolean settings use the strings 'yes'/'no'; allowed_domains takes a JSON array string (e.g. '[\"example.com\"]'). Requires the configured Nextcloud user to be an admin.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "settings": {
    "description": "One or more key/value pairs to update",
    "items": {
     "properties": {
      "key": {
       "description": "The Registration config key to set",
       "enum": [
        "allowed_domains",
        "domains_is_blocklist",
        "show_domains",
        "admin_approval_required",
        "registered_user_group",
        "email_is_optional",
        "email_is_login",
        "disable_email_verification",
        "email_verification_hint",
        "additional_hint",
        "username_policy_regex",
        "show_fullname",
        "enforce_fullname",
        "show_phone",
        "enforce_phone"
       ],
       "type": "string"
      },
      "value": {
       "description": "The value to store (boolean keys: \"yes\"/\"no\")",
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "settings"
  ],
  "type": "object"
 },
 "name": "update_registration_settings",
 "title": "Update Registration Settings"
}
