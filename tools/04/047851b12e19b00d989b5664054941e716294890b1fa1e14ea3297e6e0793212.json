{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an OPC UA industrial telemetry scaffold with node maps, adapter ingest options, status tables, and read-only safety-policy notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_http_url": {
    "default": "http://127.0.0.1:9084/opcua",
    "type": "string"
   },
   "adapter_mode": {
    "default": "manual",
    "enum": [
     "webclient_json",
     "websocket_json",
     "udp_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_udp_port": {
    "default": 9084,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "adapter_ws_url": {
    "default": "ws://127.0.0.1:9084/opcua",
    "type": "string"
   },
   "endpoint_url": {
    "default": "opc.tcp://127.0.0.1:4840",
    "type": "string"
   },
   "name": {
    "default": "opcua_industrial_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "namespace_index": {
    "default": 2,
    "maximum": 999,
    "minimum": 0,
    "type": "integer"
   },
   "node_count": {
    "default": 12,
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the OPC UA scaffold.",
    "type": "string"
   },
   "poll_ms": {
    "default": 250,
    "maximum": 60000,
    "minimum": 50,
    "type": "integer"
   },
   "security_policy": {
    "default": "external_adapter",
    "enum": [
     "none",
     "basic256sha256",
     "external_adapter"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "connect_opcua_industrial_bus",
 "title": "Connect OPC UA industrial bus"
}
