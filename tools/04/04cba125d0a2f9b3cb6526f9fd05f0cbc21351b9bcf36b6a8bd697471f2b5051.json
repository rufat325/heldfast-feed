     "maxLength": 300,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "title": {
    "description": "Short heading in Russian, e.g. '\u041f\u044f\u0442\u043d\u0438\u0446\u0430 \u0432\u0435\u0447\u0435\u0440\u043e\u043c \u0432 \u041c\u043e\u0441\u043a\u0432\u0435'. No links, contacts or emoji.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "event_ids"
  ],
  "type": "object"
 },
