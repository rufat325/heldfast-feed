{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Generate fxmanifest.lua"},"description":"Generates a valid fxmanifest.lua (fx_version 'cerulean', game 'gta5') for client/server/shared Lua or JS scripts, NUI pages, maps, vehicle data files and dependencies, then validates it with the RPScripts manifest rules. Lua 5.4 is the default runtime, so no lua54 line is written.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"author":{"maxLength":100,"type":"string"},"client_scripts":{"description":"e.g. [\"client/*.lua\"] or [\"client.js\"]","items":{"maxLength":200,"minLength":1,"type":"string"},"maxItems":50,"type":"array"},"data_files":{"description":"e.g. [{\"type\": \"HANDLING_FILE\", \"path\": \"data/handling.meta\"}]","items":{"properties":{"path":{"maxLength":200,"minLength":1,"type":"string"},"type":{"pattern":"^[A-Z0-9_]{1,64}$","type":"string"}},"required":["type","path"],"type":"object"},"maxItems":50,"type":"array"},"dependencies":{"description":"Resources or constraints, e.g. [\"ox_lib\", \"/onesync\"]","items":{"maxLength":100,"minLength":1,"type":"string"},"maxItems":50,"type":"array"},"description":{"maxLength":300,"type":"string"},"files":{"description":"Files sent to clients (NUI assets, data files)","items":{"maxLength":200,"minLength":1,"type":"string"},"maxItems":100,"type":"array"},"node_version":{"description":"Set for server-side JavaScript using Node 22 features","enum":["22"],"type":"string"},"preset":{"default":"basic","enum":["basic","nui","map","vehicle"],"type":"string"},"server_scripts":{"description":"e.g. [\"@oxmysql/lib/MySQL.lua\", \"server/*.lua\"]","items":{"maxLength":200,"minLength":1,"type":"string"},"maxItems":50,"type":"array"},"shared_scripts":{"description":"e.g. [\"@ox_lib/init.lua\", \"config.lua\"]","items":{"maxLength":200,"minLength":1,"type":"string"},"maxItems":50,"type":"array"},"ui_page":{"description":"NUI page (preset nui), default html/index.html","maxLength":200,"type":"string"},"version":{"maxLength":30,"type":"string"}},"type":"object"},"name":"generate_fxmanifest","title":"Generate fxmanifest.lua"}
