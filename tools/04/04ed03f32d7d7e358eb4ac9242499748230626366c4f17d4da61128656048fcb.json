{
 "annotations": {
  "openWorldHint": true
 },
 "description": "Runs uv pip install and returns a structured summary of installed packages. WARNING: may execute untrusted code.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "constraint": {
    "description": "Path to constraints file for version pinning (-c FILE)",
    "maxLength": 4096,
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview what would be installed without actually installing (--dry-run)",
    "type": "boolean"
   },
   "editable": {
    "description": "Path to local package for editable install (-e PATH)",
    "maxLength": 4096,
    "type": "string"
   },
   "extras": {
    "description": "Package extras to install (--extra NAME)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "indexUrl": {
    "description": "Base URL of the Python Package Index (-i URL)",
    "maxLength": 65536,
    "type": "string"
   },
   "noDeps": {
    "default": false,
    "description": "Do not install package dependencies (--no-deps)",
    "type": "boolean"
   },
   "packages": {
    "description": "Packages to install",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   },
   "python": {
    "description": "Python interpreter version to use (-p VERSION)",
    "maxLength": 255,
    "type": "string"
   },
   "reinstall": {
    "default": false,
    "description": "Force reinstall of all packages even if already installed (--reinstall)",
    "type": "boolean"
   },
   "requirements": {
    "description": "Path to requirements file",
    "maxLength": 4096,
    "type": "string"
   },
   "upgrade": {
    "default": false,
    "description": "Upgrade already-installed packages to the newest version (--upgrade)",
    "type": "boolean"
   },
   "verifyHashes": {
    "default": false,
    "description": "Verify package hashes for supply-chain security (--verify-hashes)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "uv-install",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alreadySatisfied": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "installed": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "version"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "resolutionConflicts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "constraint": {
       "type": "string"
      },
      "package": {
       "type": "string"
      }
     },
     "required": [
      "package",
      "constraint"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "uv Install"
}
