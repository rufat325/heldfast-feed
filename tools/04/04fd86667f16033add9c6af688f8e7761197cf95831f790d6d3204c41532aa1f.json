{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only: sample one TouchDesigner operator over a short interval and return runtime state, readable parameter values, and CHOP channel values when available. Missing TD attributes/channels are reported as warnings instead of failing the watch. Returns {path, requested_samples, collected_samples, interval_ms, window_ms, warnings[], snapshots[]} where each snapshot has {sample_index, elapsed_ms, path, type, family, state, parameters, channels, warnings}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "channel_keys": {
    "description": "Optional channel-name allowlist for CHOP-like operators. Omit to sample all channels.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "interval_ms": {
    "default": 100,
    "description": "Delay between snapshots in milliseconds.",
    "maximum": 2000,
    "minimum": 16,
    "type": "integer"
   },
   "parameter_keys": {
    "description": "Optional parameter-name allowlist. Omit to sample all readable parameters.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "path": {
    "description": "Full path of the operator to sample.",
    "type": "string"
   },
   "samples": {
    "default": 3,
    "description": "How many snapshots to collect.",
    "maximum": 240,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "watch_node",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collected_samples": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "interval_ms": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "path": {
    "type": "string"
   },
   "requested_samples": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "snapshots": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "channels": {
       "additionalProperties": {
        "type": "number"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "elapsed_ms": {
       "type": "number"
      },
      "family": {
       "type": "string"
      },
      "parameters": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "path": {
       "type": "string"
      },
      "sample_index": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "state": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": {
       "type": "string"
      },
      "warnings": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "sample_index",
      "elapsed_ms",
      "path",
      "type",
      "state",
      "parameters",
      "channels",
      "warnings"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "window_ms": {
    "type": "number"
   }
  },
  "required": [
   "path",
   "requested_samples",
   "collected_samples",
   "interval_ms",
   "window_ms",
   "warnings",
   "snapshots"
  ],
  "type": "object"
 },
 "title": "Watch node"
}
