{
 "_meta": {
  "openai/outputTemplate": "ui://calculiva/planner-v3.html",
  "openai/toolInvocation/invoked": "Cut plan ready",
  "openai/toolInvocation/invoking": "Planning the cuts\u2026",
  "ui": {
   "resourceUri": "ui://calculiva/planner-v3.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan a wallpaper order"
 },
 "description": "Counts the wallpaper rolls to buy from the walls, doors and windows and the roll label (width, length, pattern repeat, match): drops per roll, every cut placed on its roll, match waste, and the straight / half-drop / random comparison. Lengths accept feet and inches. Returns a link to the full plan on calculiva.com.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deductOpenings": {
    "description": "Shorten drops over doors and windows (default true).",
    "type": "boolean"
   },
   "match": {
    "description": "Pattern match from the label: straight (default), half-drop or random.",
    "enum": [
     "straight",
     "half-drop",
     "random"
    ],
    "type": "string"
   },
   "openings": {
    "description": "Doors and windows; only drops fully crossed by an opening are shortened.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "fromLeft": {
       "anyOf": [
        {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        {
         "minimum": 0,
         "type": "number"
        }
       ],
       "description": "Distance from the left end of the wall to the opening. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
      },
      "height": {
       "anyOf": [
        {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        {
         "minimum": 0,
         "type": "number"
        }
       ],
       "description": "Opening height. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
      },
      "sillHeight": {
       "anyOf": [
        {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        {
         "minimum": 0,
         "type": "number"
        }
       ],
       "description": "Height of the bottom of the opening from the floor; \"0\" for a door. Default 0. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
      },
      "wall": {
       "description": "Wall number (1 = first wall). Default 1.",
       "maximum": 12,
       "minimum": 1,
       "type": "integer"
      },
      "width": {
       "anyOf": [
        {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        {
         "minimum": 0,
         "type": "number"
        }
       ],
       "description": "Opening width. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
      }
     },
     "required": [
      "width",
      "height",
      "fromLeft"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   },
   "repeat": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Vertical pattern repeat from the label; \"0\" for none. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "rollLength": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Roll length, from the label (e.g. \"33 ft\"). Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "rollWidth": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Roll width, from the label of the roll. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "trim": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Trim allowance per drop, top and bottom together. Default 4 in. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "walls": {
    "description": "Walls to paper, 1 to 12.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "height": {
       "anyOf": [
        {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        {
         "minimum": 0,
         "type": "number"
        }
       ],
       "description": "Wall height. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
      },
      "width": {
       "anyOf": [
        {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        {
         "minimum": 0,
         "type": "number"
        }
       ],
       "description": "Wall width. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
      }
     },
     "required": [
      "width",
      "height"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "walls",
   "rollWidth",
   "rollLength",
   "repeat"
  ],
  "type": "object"
 },
 "name": "plan_wallpaper_order",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "areaMethodRolls": {
    "$ref": "#/properties/rollsToBuy"
   },
   "cutTotalFt": {
    "type": "number"
   },
   "cuts": {
    "$ref": "#/properties/rollsToBuy"
   },
   "drops": {
    "$ref": "#/properties/rollsToBuy"
   },
   "dropsPerRoll": {
    "$ref": "#/properties/rollsToBuy"
   },
   "linearYards": {
    "$ref": "#/properties/cutTotalFt"
   },
   "longestCut": {
    "type": "string"
   },
   "match": {
    "enum": [
     "straight",
     "half-drop",
     "random"
    ],
    "type": "string"
   },
   "matchComparison": {
    "description": "The same walls with each pattern match; the match is printed on the roll label, so this is not a choice.",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "linearYards": {
         "$ref": "#/properties/cutTotalFt"
        },
        "match": {
         "enum": [
          "straight",
          "half-drop",
          "random"
         ],
         "type": "string"
        },
        "matchWasteFt": {
         "$ref": "#/properties/cutTotalFt"
        },
        "rollsToBuy": {
         "$ref": "#/properties/rollsToBuy"
        }
       },
       "required": [
        "match",
        "rollsToBuy",
        "linearYards",
        "matchWasteFt"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "error": {
         "$ref": "#/properties/longestCut"
        },
        "match": {
         "enum": [
          "straight",
          "half-drop",
          "random"
         ],
         "type": "string"
        }
       },
       "required": [
        "match",
        "error"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "matchWasteFt": {
    "$ref": "#/properties/cutTotalFt"
   },
   "openingAreaSqFt": {
    "$ref": "#/properties/cutTotalFt"
   },
   "rolls": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cuts": {
       "items": {
        "$ref": "#/properties/longestCut"
       },
       "type": "array"
      },
      "leftover": {
       "$ref": "#/properties/longestCut"
      },
      "roll": {
       "$ref": "#/properties/longestCut"
      }
     },
     "required": [
      "roll",
      "cuts",
      "leftover"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "rollsToBuy": {
    "type": "integer"
   },
   "shareUrl": {
    "$ref": "#/properties/longestCut"
   },
   "shareUrlComplete": {
    "type": "boolean"
   },
   "wallAreaSqFt": {
    "$ref": "#/properties/cutTotalFt"
   },
   "warnings": {
    "items": {
     "$ref": "#/properties/longestCut"
    },
    "type": "array"
   },
   "wastePercent": {
    "$ref": "#/properties/cutTotalFt"
   }
  },
  "required": [
   "rollsToBuy",
   "match",
   "dropsPerRoll",
   "drops",
   "cuts",
   "longestCut",
   "cutTotalFt",
   "linearYards",
   "matchWasteFt",
   "wastePercent",
   "wallAreaSqFt",
   "openingAreaSqFt",
   "areaMethodRolls",
   "rolls",
   "matchComparison",
   "warnings",
   "shareUrl",
   "shareUrlComplete"
  ],
  "type": "object"
 },
 "title": "Plan a wallpaper order"
}
