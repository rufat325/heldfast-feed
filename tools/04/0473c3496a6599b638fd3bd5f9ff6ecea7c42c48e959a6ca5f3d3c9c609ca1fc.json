{
 "annotations": {
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Record a sale order and automatically deduct the corresponding product stocks in Chirak.",
 "inputSchema": {
  "properties": {
   "channel": {
    "description": "Sale channel: 'WhatsApp', 'Instagram', 'Fiziki Ma\u011faza', 'Web Sitesi', 'Telefon Sipari\u015fi', 'Di\u011fer'.",
    "type": "string"
   },
   "customerName": {
    "description": "Customer full name (optional).",
    "type": "string"
   },
   "customerPhone": {
    "description": "Customer phone number (optional).",
    "type": "string"
   },
   "items": {
    "description": "List of items in the order.",
    "items": {
     "properties": {
      "name": {
       "description": "Product name (or SKU if name not available)",
       "type": "string"
      },
      "productId": {
       "description": "Product UUID (if known)",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity sold (minimum 1)",
       "type": "number"
      },
      "sku": {
       "description": "Product SKU",
       "type": "string"
      },
      "unitPrice": {
       "description": "Unit price (optional, uses product selling price if omitted)",
       "type": "number"
      }
     },
     "required": [
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "description": "Order notes or special delivery instructions.",
    "type": "string"
   },
   "paymentStatus": {
    "description": "Payment status: '\u00d6dendi', '\u00d6denmedi', 'K\u0131smi \u00d6deme'.",
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "record_sale",
 "outputSchema": {
  "properties": {
   "data": {
    "description": "Result data payload from Chirak API.",
    "type": "object"
   },
   "success": {
    "description": "Status of the tool execution.",
    "type": "boolean"
   }
  },
  "type": "object"
 }
}
