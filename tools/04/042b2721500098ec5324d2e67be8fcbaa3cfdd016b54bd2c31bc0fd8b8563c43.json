{
 "description": "Select options in a select element.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "selector": {
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "timeout": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "values": {
    "description": "Option values to select; pass multiple for multi-select.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "sessionId",
   "selector",
   "values"
  ],
  "type": "object"
 },
 "name": "browser_select_option",
 "title": "Browser Select Option"
}
