{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estimate the price for a trip. Given a route and passenger count (and optional luggage count), returns the cheapest vehicle that fits the group, plus all fitting options. Use this to answer 'how much for N people from X to the airport?'.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "luggage": {
    "description": "Number of large bags (optional).",
    "minimum": 0,
    "type": "integer"
   },
   "passengers": {
    "description": "Number of passengers.",
    "minimum": 1,
    "type": "integer"
   },
   "routeSlug": {
    "description": "Route slug from list_routes.",
    "type": "string"
   }
  },
  "required": [
   "routeSlug",
   "passengers"
  ],
  "type": "object"
 },
 "name": "estimate_price",
 "outputSchema": {
  "oneOf": [
   {
    "properties": {
     "allFittingOptions": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "fits": {
      "const": true
     },
     "luggage": {
      "type": [
       "integer",
       "null"
      ]
     },
     "note": {
      "type": "string"
     },
     "passengers": {
      "type": "integer"
     },
     "recommended": {
      "properties": {
       "maxLuggage": {
        "type": "integer"
       },
       "maxPassengers": {
        "type": "integer"
       },
       "priceEur": {
        "type": "number"
       },
       "priceRsd": {
        "type": [
         "number",
         "null"
        ]
       },
       "vehicle": {
        "type": "string"
       }
      },
      "required": [
       "vehicle",
       "priceEur"
      ],
      "type": "object"
     },
     "route": {
      "type": "string"
     }
    },
    "required": [
     "fits",
     "route",
     "recommended"
    ],
    "type": "object"
   },
   {
    "properties": {
     "fits": {
      "const": false
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "fits",
     "message"
    ],
    "type": "object"
   },
   {
    "properties": {
     "error": {
      "type": "string"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ]
 },
 "title": "Estimate price"
}
