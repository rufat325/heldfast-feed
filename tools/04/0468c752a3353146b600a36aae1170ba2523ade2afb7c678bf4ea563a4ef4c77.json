{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a DATEV-Format Buchungsstapel (EXTF, Formatversion 13) from booking rows, ready for import into DATEV Rechnungswesen or DATEV Unternehmen online. The result is checked with the validator before it's returned. With outputPath the file is written as Windows-1252, the encoding DATEV expects; without it the CSV text is returned. The tool formats bookings, it doesn't choose accounts or tax keys: take those from the user or their tax advisor.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "header": {
    "properties": {
     "berater": {
      "description": "Beraternummer, 4-7 digits",
      "type": "string"
     },
     "from": {
      "description": "First day of the batch period, YYYYMMDD",
      "pattern": "^20\\d{6}$",
      "type": "string"
     },
     "label": {
      "description": "Batch label (Bezeichnung), at most 30 characters",
      "type": "string"
     },
     "mandant": {
      "description": "Mandantennummer, 1-5 digits",
      "type": "string"
     },
     "skl": {
      "description": "Sachkontenl\u00e4nge, usually 4",
      "maximum": 8,
      "minimum": 4,
      "type": "integer"
     },
     "skr": {
      "description": "Chart of accounts: 03, 04, or empty if unknown",
      "enum": [
       "03",
       "04",
       ""
      ],
      "type": "string"
     },
     "to": {
      "description": "Last day of the batch period, YYYYMMDD, same calendar year as from",
      "pattern": "^20\\d{6}$",
      "type": "string"
     },
     "wjStart": {
      "description": "Start of the fiscal year (WJ-Beginn), YYYYMMDD",
      "pattern": "^20\\d{6}$",
      "type": "string"
     }
    },
    "required": [
     "berater",
     "mandant",
     "wjStart",
     "skl",
     "from",
     "to",
     "label",
     "skr"
    ],
    "type": "object"
   },
   "lang": {
    "default": "de",
    "description": "Language of the messages: de (default) or en.",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "outputPath": {
    "description": "Where to write the file, e.g. EXTF_Buchungsstapel.csv. Existing files are overwritten.",
    "type": "string"
   },
   "rows": {
    "items": {
     "properties": {
      "account": {
       "description": "Konto",
       "type": "string"
      },
      "amount": {
       "description": "Unsigned amount in cents, e.g. 11900 for 119,00",
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "beleg1": {
       "description": "Belegfeld 1, e.g. the invoice number. Disallowed characters are removed, at most 36 kept.",
       "type": "string"
      },
      "contra": {
       "description": "Gegenkonto, without BU-Schl\u00fcssel",
       "type": "string"
      },
      "day": {
       "description": "Belegdatum day",
       "maximum": 31,
       "minimum": 1,
       "type": "integer"
      },
      "key": {
       "description": "BU-Schl\u00fcssel (tax key), if any",
       "type": "string"
      },
      "month": {
       "description": "Belegdatum month",
       "maximum": 12,
       "minimum": 1,
       "type": "integer"
      },
      "side": {
       "description": "S = Soll (debit on account), H = Haben (credit on account)",
       "enum": [
        "S",
        "H"
       ],
       "type": "string"
      },
      "text": {
       "description": "Buchungstext, at most 60 characters",
       "type": "string"
      }
     },
     "required": [
      "amount",
      "side",
      "account",
      "contra",
      "day",
      "month"
     ],
     "type": "object"
    },
    "maxItems": 99999,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "header",
   "rows"
  ],
  "type": "object"
 },
 "name": "write_buchungsstapel",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "changed": {
    "description": "Belegfeld 1 values the writer had to clean, and texts with characters Windows-1252 can't hold",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "csv": {
    "type": "string"
   },
   "path": {
    "type": "string"
   },
   "report": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "description": "buchungsstapel, debkred or other",
      "type": "string"
     },
     "countsByCode": {
      "additionalProperties": {
       "type": "number"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "disclaimer": {
      "type": "string"
     },
     "encoding": {
      "type": "string"
     },
     "errors": {
      "type": "number"
     },
     "findings": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "field": {
         "type": "number"
        },
        "fieldName": {
         "type": "string"
        },
        "line": {
         "type": "number"
        },
        "message": {
         "type": "string"
        },
        "severity": {
         "enum": [
          "error",
          "warning"
         ],
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "severity",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "header": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "rows": {
      "type": "number"
     },
     "truncated": {
      "type": "boolean"
     },
     "warnings": {
      "type": "number"
     }
    },
    "required": [
     "rows",
     "encoding",
     "errors",
     "warnings",
     "countsByCode",
     "findings",
     "truncated",
     "disclaimer"
    ],
    "type": "object"
   },
   "rows": {
    "type": "number"
   }
  },
  "required": [
   "rows",
   "changed",
   "report"
  ],
  "type": "object"
 },
 "title": "Write a DATEV Buchungsstapel"
}
