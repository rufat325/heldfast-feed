{
 "description": "Create a new broadcast (email campaign) in Kit.com",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "The email content (HTML supported)",
    "type": "string"
   },
   "description": {
    "description": "Internal description for the broadcast",
    "type": "string"
   },
   "preview_text": {
    "description": "Preview text shown in email clients",
    "type": "string"
   },
   "public": {
    "description": "Whether the broadcast should be public",
    "type": "boolean"
   },
   "send_at": {
    "description": "ISO date when to send the broadcast",
    "type": "string"
   },
   "subject": {
    "description": "The email subject line",
    "type": "string"
   }
  },
  "required": [
   "subject"
  ],
  "type": "object"
 },
 "name": "kit_create_broadcast"
}
