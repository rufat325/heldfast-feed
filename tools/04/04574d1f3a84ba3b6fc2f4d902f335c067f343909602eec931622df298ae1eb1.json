{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "General web scraping that always returns JSON response with metadata. Use this when you need structured response data including headers, status, timing info, and content. Can return HTML, screenshot, or PDF in JSON format.",
 "inputSchema": {
  "properties": {
   "auto_proxy": {
    "description": "Auto-escalate proxy. Default: false",
    "type": "boolean"
   },
   "block_ads": {
    "description": "Block ads. Default: false",
    "type": "boolean"
   },
   "block_resources": {
    "description": "Block resources. Default: false for screenshot/pdf",
    "type": "boolean"
   },
   "cookies": {
    "description": "Custom cookies",
    "type": "string"
   },
   "custom_js": {
    "description": "Custom JavaScript code",
    "type": "string"
   },
   "custom_proxy": {
    "description": "Custom proxy URI",
    "type": "string"
   },
   "custom_proxy_password": {
    "description": "Custom proxy password",
    "type": "string"
   },
   "custom_proxy_username": {
    "description": "Custom proxy username",
    "type": "string"
   },
   "device": {
    "description": "Device: 'desktop' or 'mobile'. Default: 'desktop'",
    "type": "string"
   },
   "http_method": {
    "description": "HTTP method. Default: 'GET'",
    "type": "string"
   },
   "js": {
    "description": "Execute JavaScript. Default: true",
    "type": "boolean"
   },
   "js_timeout": {
    "description": "JS timeout in seconds",
    "type": "number"
   },
   "post_data": {
    "description": "POST/PUT data",
    "type": "string"
   },
   "progressive_scroll": {
    "description": "Progressive scroll. Default: false",
    "type": "boolean"
   },
   "proxy_country": {
    "description": "Proxy country. Default: 'US'",
    "type": "string"
   },
   "proxy_type": {
    "description": "Proxy type. Default: 'rotating'",
    "type": "string"
   },
   "response_type": {
    "description": "Content type: 'html', 'raw', 'pdf', or 'screenshot'. Default: 'html'",
    "type": "string"
   },
   "screenshot_fullpage": {
    "description": "Full page screenshot (if response_type=screenshot)",
    "type": "boolean"
   },
   "screenshot_partial": {
    "description": "Partial screenshot selector/coords (if response_type=screenshot)",
    "type": "string"
   },
   "scroll_down": {
    "description": "Scroll page. Default: false",
    "type": "boolean"
   },
   "session_id": {
    "description": "Session ID",
    "type": "string"
   },
   "strip_tags": {
    "description": "Tags/selectors to remove",
    "type": "string"
   },
   "timeout": {
    "description": "Timeout in seconds. Default: 60",
    "type": "number"
   },
   "url": {
    "description": "URL to scrape",
    "type": "string"
   },
   "useragent": {
    "description": "Custom user agent",
    "type": "string"
   },
   "wait_for": {
    "description": "Wait condition",
    "type": "string"
   },
   "wait_for_timeout": {
    "description": "Wait timeout in milliseconds",
    "type": "number"
   },
   "window_height": {
    "description": "Viewport height",
    "type": "number"
   },
   "window_width": {
    "description": "Viewport width",
    "type": "number"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "ujeebu_scrape_json"
}
