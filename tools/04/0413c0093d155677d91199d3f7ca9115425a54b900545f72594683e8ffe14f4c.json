{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return public keys of this issuer. The operator must establish trust in this issuer independently.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "get_agent_public_keys",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "issuer": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "type": "string"
   },
   "keys": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "jwk": {
       "additionalProperties": false,
       "properties": {
        "crv": {
         "const": "Ed25519",
         "type": "string"
        },
        "ext": {
         "type": "boolean"
        },
        "key_ops": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "kty": {
         "const": "OKP",
         "type": "string"
        },
        "x": {
         "type": "string"
        }
       },
       "required": [
        "kty",
        "crv",
        "x"
       ],
       "type": "object"
      },
      "keyId": {
       "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
       "type": "string"
      }
     },
     "required": [
      "keyId",
      "jwk"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "issuer",
   "keys"
  ],
  "type": "object"
 },
 "title": "Get Agent Public Keys"
}
