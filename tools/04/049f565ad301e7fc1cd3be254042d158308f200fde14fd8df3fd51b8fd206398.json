{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Max/MSP OSC bridge scaffold with parameter and audio-feature channel maps.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "channel_count": {
    "default": 8,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "include_audio_features": {
    "default": true,
    "type": "boolean"
   },
   "max_host": {
    "default": "127.0.0.1",
    "description": "Max/MSP OSC host.",
    "type": "string"
   },
   "name": {
    "default": "max_msp_bridge",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "namespace": {
    "default": "/tdmcp",
    "description": "OSC namespace prefix.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Max/MSP scaffold.",
    "type": "string"
   },
   "receive_port": {
    "default": 7401,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "send_port": {
    "default": 7400,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_max_msp_bridge",
 "title": "Connect Max/MSP bridge"
}
