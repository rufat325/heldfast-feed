{
 "description": "Send an image to a contact, group, or channel via a public URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "caption": {
    "description": "Optional caption",
    "type": "string"
   },
   "chatId": {
    "description": "Recipient: phone number, group ID, or channel ID",
    "type": "string"
   },
   "imageUrl": {
    "description": "Public URL of the image",
    "format": "uri",
    "type": "string"
   },
   "session": {
    "description": "Session name",
    "type": "string"
   }
  },
  "required": [
   "session",
   "chatId",
   "imageUrl"
  ],
  "type": "object"
 },
 "name": "send_image"
}
