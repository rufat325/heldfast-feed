{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read whether a prepared operation is pending, complete, failed or uncertain. Returns no file content or management key. Never assume pending means published.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "operation_id": {
    "description": "Exact operation_id from a preparation response. Read status after user confirmation or on request. Only complete with a result contains the published URL; pending is not published, uncertain must not be replayed.",
    "pattern": "^rop_[A-Za-z0-9_-]{43}$",
    "type": "string"
   }
  },
  "required": [
   "operation_id"
  ],
  "type": "object"
 },
 "name": "get_operation_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "create",
     "update",
     "delete"
    ],
    "type": "string"
   },
   "approval_expires_at": {
    "description": "Exact UTC timestamp in ISO 8601.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
    "type": "string"
   },
   "digest": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     }
    },
    "required": [
     "code"
    ],
    "type": "object"
   },
   "files": {
    "description": "Untrusted static file manifest for review, not file contents.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "bytes": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "bytes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "named_links_enabled": {
    "type": "boolean"
   },
   "operation_id": {
    "description": "Prepared operation identifier.",
    "pattern": "^rop_[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "preview_id": {
    "description": "AIfra preview identifier; never a management key.",
    "pattern": "^pv_[A-Za-z0-9_-]{24}$",
    "type": "string"
   },
   "result": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "active_slots_for_ip": {
        "description": "Aggregate active-slot count, never the source IP.",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "active_slots_limit": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "expires_at": {
        "description": "Server-enforced expiry, normally 48 hours from publication. Updates never extend it; only the owner can manually set a later date.",
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
        "type": "string"
       },
       "preview_id": {
        "description": "AIfra preview identifier; never a management key.",
        "pattern": "^pv_[A-Za-z0-9_-]{24}$",
        "type": "string"
       },
       "status": {
        "const": "ready",
        "type": "string"
       },
       "ttl_seconds": {
        "description": "Remaining seconds at response time, not a new lifetime.",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "url": {
        "description": "Public viewer URL; share only after successful browser confirmation.",
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "preview_id",
       "status",
       "url",
       "expires_at",
       "ttl_seconds"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "preview_id": {
        "description": "AIfra preview identifier; never a management key.",
        "pattern": "^pv_[A-Za-z0-9_-]{24}$",
        "type": "string"
       },
       "status": {
        "const": "deleted",
        "type": "string"
       }
      },
      "required": [
       "preview_id",
       "status"
      ],
      "type": "object"
     }
    ],
    "description": "Successful receipt: ready contains the real viewer URL and expiry; deleted contains no public URL. No management key."
   },
   "status": {
    "description": "Only complete plus result proves completion. Pending requires personal browser confirmation. Uncertain must not be automatically retried. Expired preparation needs a new request and fresh consent.",
    "enum": [
     "pending",
     "complete",
     "failed",
     "uncertain",
     "expired"
    ],
    "type": "string"
   },
   "terms_url": {
    "format": "uri",
    "type": "string"
   },
   "terms_version": {
    "type": "string"
   },
   "viewer_origin": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "operation_id",
   "status",
   "action",
   "preview_id",
   "viewer_origin",
   "named_links_enabled",
   "digest",
   "files",
   "approval_expires_at",
   "terms_url",
   "terms_version"
  ],
  "type": "object"
 }
}
