    "enum": [
     "requirements",
     "validate",
     "generate"
    ],
    "type": "string"
   },
   "data": {
    "additionalProperties": false,
    "properties": {
     "documents": {
      "items": {
       "oneOf": [
        {
         "additionalProperties": false,
         "properties": {
          "docType": {
           "enum": [
            "Invoice",
            "Debit Note",
            "Credit Note"
           ],
           "type": "string"
          },
          "idt": {
           "description": "Calendar date dd-mm-yyyy, not a future date.",
           "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
           "type": "string"
          },
          "inum": {
           "pattern": "^[A-Za-z0-9/-]{1,16}$",
           "type": "string"
          },
          "type": {
           "const": "S",
           "type": "string"
          },
          "val": {
           "description": "Document value in INR as reported for this export document, as a decimal string.",
           "pattern": "^(?:0|[1-9]\\d{0,14})(?:\\.\\d{1,2})?$",
           "type": "string"
          }
         },
         "required": [
          "docType",
          "inum",
          "idt",
          "val",
          "type"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "docType": {
           "enum": [
            "Invoice",
            "Debit Note",
            "Credit Note"
           ],
           "type": "string"
          },
          "egmref": {
           "pattern": "^[A-Za-z0-9]{1,20}$",
           "type": "string"
          },
          "egmrefdt": {
           "description": "Calendar date dd-mm-yyyy, not a future date.",
           "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
           "type": "string"
          },
          "fobValue": {
           "description": "INR FOB decimal string, at most 15 integer digits and 4 decimals.",
           "pattern": "^(?:0|[1-9]\\d{0,14})(?:\\.\\d{1,4})?$",
           "type": "string"
          },
          "idt": {
           "description": "Calendar date dd-mm-yyyy, not a future date.",
           "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
           "type": "string"
          },
          "inum": {
           "pattern": "^[A-Za-z0-9/-]{1,16}$",
           "type": "string"
          },
          "sbdt": {
           "description": "Calendar date dd-mm-yyyy, not a future date.",
           "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
           "type": "string"
          },
          "sbnum": {
           "pattern": "^\\d{3,7}$",
           "type": "string"
          },
          "sbpcode": {
           "pattern": "^[A-Za-z0-9]{6}$",
           "type": "string"
          },
          "type": {
           "const": "G",
           "type": "string"
          },
          "val": {
           "description": "Document value in INR as reported for this export document, as a decimal string.",
           "pattern": "^(?:0|[1-9]\\d{0,14})(?:\\.\\d{1,2})?$",
           "type": "string"
          }
         },
         "required": [
          "docType",
          "inum",
          "idt",
          "val",
          "type",
          "sbpcode",
          "sbnum",
          "sbdt",
          "fobValue",
          "egmref",
          "egmrefdt"
         ],
         "type": "object"
        }
       ]
      },
      "maxItems": 10000,
      "minItems": 1,
      "type": "array"
     },
     "fromFp": {
      "description": "Refund return period mmyyyy.",
      "pattern": "^(0[1-9]|1[0-2])\\d{4}$",
      "type": "string"
     },
     "gstin": {
      "pattern": "^\\d{2}[A-Z]{5}\\d{4}[A-Z][1-9A-Z][Z1-9A-J][0-9A-Z]$",
      "type": "string"
     },
     "receipts": {
      "description": "Separate aggregate BRC/FIRC rows, not nested under invoices. Use [] for goods-only statements without receipts.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "dt": {
