         "pattern": "^(?:0|[1-9]\\d{0,14})(?:\\.\\d{1,2})?$",
         "type": "string"
        }
       },
       "required": [
        "num",
        "dt",
        "val"
       ],
       "type": "object"
      },
      "maxItems": 10000,
