 "description": "Verifies with Stripe that payment actually completed and, on success, advances the formation to filing. Usually unnecessary \u2014 payment auto-confirms via webhook once the user pays. Only call this if the user explicitly returns and says they have paid. A user saying they paid is NOT proof \u2014 only a successful result here confirms payment. If it is not successful, do not tell the user payment succeeded or proceed to filing; ask them to complete checkout and retry.",
 "inputSchema": {
  "properties": {
   "formationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "stripeSessionId": {
    "maxLength": 255,
    "pattern": "^(cs_[A-Za-z0-9_]+)?$",
    "type": "string"
   }
  },
  "required": [
   "formationId"
  ],
  "type": "object"
 },
 "name": "formation_confirm_payment",
 "outputSchema": {
  "properties": {
   "formationId": {
    "anyOf": [
     {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "message": {
    "type": "string"
   },
   "paymentStatus": {
    "enum": [
     "PAYMENT_STATUS_UNSPECIFIED",
     "PAYMENT_STATUS_PENDING",
     "PAYMENT_STATUS_COMPLETED",
     "PAYMENT_STATUS_FAILED",
     "PAYMENT_STATUS_REFUNDED"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "FORMATION_STATUS_UNSPECIFIED",
     "FORMATION_STATUS_INITIATED",
     "FORMATION_STATUS_IN_PROGRESS",
     "FORMATION_STATUS_PAYMENT_PENDING",
     "FORMATION_STATUS_PAYMENT_COMPLETE",
     "FORMATION_STATUS_FILING_IN_PROGRESS",
     "FORMATION_STATUS_COMPLETED",
     "FORMATION_STATUS_FAILED",
     "FORMATION_STATUS_CANCELLED",
     "FORMATION_STATUS_IMPORTED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Confirm Payment"
}
