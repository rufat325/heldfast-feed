{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Order products. Prices are in minor units. A line naming a product (productId or sku) costs the business's price from list_products, and the total follows; a different price you send is only noted for the business. A line naming no product waits for the business to price it. A priced order binds your person only once they confirmed it: without terms_sha nothing is sent, and you get the summary to show them (confirm.summary, confirm.terms_sha); call again with that terms_sha on their clear yes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contact": {
    "properties": {
     "email": {
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "locale": {
      "maxLength": 12,
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "type": "string"
     }
    },
    "type": "object"
   },
   "idempotency_key": {
    "description": "Same key + same request = same answer. Required for agents.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "key": {
    "description": "The person's key (sdkey1_\u2026), if that is all you have: it is exchanged once for a pass, which comes back in identity.passes \u2014 keep the pass and send it next time instead. Never stored.",
    "maxLength": 200,
    "type": "string"
   },
   "message": {
    "maxLength": 20000,
    "type": "string"
   },
   "pass": {
    "description": "The person's passes (sdpass1_\u2026), space-separated, at most 8: presented to the network that issued each, so the business recognises the customer. Or send them in the Sdi-Pass header. Never stored.",
    "maxLength": 1608,
    "type": "string"
   },
   "payload": {
    "properties": {
     "billingAddress": {
      "properties": {
       "addressCountry": {
        "maxLength": 2,
        "minLength": 2,
        "type": "string"
       },
       "addressLocality": {
        "maxLength": 100,
        "type": "string"
       },
       "addressRegion": {
        "maxLength": 100,
        "type": "string"
       },
       "postalCode": {
        "maxLength": 20,
        "type": "string"
       },
       "streetAddress": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "type": "object"
     },
     "delivery": {
      "properties": {
       "method": {
        "enum": [
         "pickup",
         "delivery",
         "digital"
        ],
        "type": "string"
       },
       "when": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string"
       }
      },
      "required": [
       "method"
      ],
      "type": "object"
     },
     "notes": {
      "maxLength": 5000,
      "type": "string"
     },
     "orderedItem": {
      "items": {
       "properties": {
        "listPrice": {
         "properties": {
          "currency": {
           "maxLength": 3,
           "minLength": 3,
           "type": "string"
          },
          "value": {
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "value",
          "currency"
         ],
         "type": "object"
        },
        "name": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "price": {
         "properties": {
          "currency": {
           "maxLength": 3,
           "minLength": 3,
           "type": "string"
          },
          "value": {
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "value",
          "currency"
         ],
         "type": "object"
        },
        "productId": {
         "type": "string"
        },
        "quantity": {
         "maximum": 9007199254740991,
         "minimum": 1,
         "type": "integer"
        },
        "sku": {
         "maxLength": 100,
         "type": "string"
        }
       },
       "required": [
        "name",
        "quantity",
        "price"
       ],
       "type": "object"
      },
      "maxItems": 200,
      "minItems": 1,
      "type": "array"
     },
     "paymentMethod": {
      "maxLength": 60,
      "type": "string"
     },
     "personalised": {
      "properties": {
       "listPrice": {
        "properties": {
         "currency": {
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
         },
         "value": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "value",
         "currency"
        ],
        "type": "object"
       },
       "says": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "required": [
       "listPrice"
      ],
      "type": "object"
     },
     "shippingAddress": {
      "properties": {
       "addressCountry": {
        "maxLength": 2,
        "minLength": 2,
        "type": "string"
       },
       "addressLocality": {
        "maxLength": 100,
        "type": "string"
       },
       "addressRegion": {
        "maxLength": 100,
        "type": "string"
       },
       "postalCode": {
        "maxLength": 20,
        "type": "string"
       },
       "streetAddress": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "type": "object"
     },
     "totalPrice": {
      "properties": {
       "currency": {
        "maxLength": 3,
        "minLength": 3,
        "type": "string"
       },
       "value": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "value",
       "currency"
      ],
      "type": "object"
     }
    },
    "required": [
     "orderedItem",
     "totalPrice"
    ],
    "type": "object"
   },
   "terms_sha": {
    "description": "The fingerprint of the terms your person confirmed (details.terms_sha of the 409 confirm_terms a priced request without it gets). Nothing is sent to the business without it when the request carries a price.",
    "pattern": "^[A-Za-z0-9_-]{43}$",
    "type": "string"
   }
  },
  "required": [
   "payload"
  ],
  "type": "object"
 },
 "name": "create_order",
 "title": "Place an order"
}
