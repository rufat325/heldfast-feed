{
 "description": "Finalize a pending receipt by recording execution results, costs, and output data. Updates the receipt status to completed, failed, or timeout and re-signs with Ed25519. Use after create_receipt when you need to record results separately from creation (two-phase tracking). Cannot complete an already-completed receipt. Returns the updated signed receipt.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "callback_verified": {
    "description": "Whether an external callback verified the result",
    "type": [
     "boolean",
     "null"
    ]
   },
   "confidence": {
    "anyOf": [
     {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Confidence score for output quality, 0.0 to 1.0"
   },
   "cost_usd": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Total cost in USD"
   },
   "error": {
    "anyOf": [
     {
      "additionalProperties": {},
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Error details if status is \"failed\" (e.g., {\"code\": \"TIMEOUT\", \"message\": \"...\"})"
   },
   "latency_ms": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Total execution time in milliseconds"
   },
   "model": {
    "description": "AI model used during execution",
    "type": [
     "string",
     "null"
    ]
   },
   "output_hash": {
    "description": "Pre-computed SHA-256 hash of the output in format \"sha256:hexstring\"",
    "type": [
     "string",
     "null"
    ]
   },
   "output_summary": {
    "description": "Human-readable summary of the execution result",
    "type": [
     "string",
     "null"
    ]
   },
   "receipt_id": {
    "description": "The receipt ID to complete \u2014 must be a pending receipt (status: \"pending\")",
    "type": "string"
   },
   "status": {
    "description": "Final status: \"completed\" (success), \"failed\" (error occurred), or \"timeout\" (timed out)",
    "enum": [
     "completed",
     "failed",
     "timeout"
    ],
    "type": "string"
   },
   "tokens_in": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Input tokens consumed"
   },
   "tokens_out": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Output tokens generated"
   },
   "tool_calls": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Names of tools called during execution"
   }
  },
  "required": [
   "receipt_id",
   "status"
  ],
  "type": "object"
 },
 "name": "complete_receipt"
}
