{
 "description": "Stitch AI-generated video scenes into a final video with transitions and music.\nSupports portrait (9:16) and landscape (16:9), fade transitions, background music, and SpiderMedia upload.\nThis is a convenience wrapper for submit_job with type=spiderVideo.",
 "inputSchema": {
  "properties": {
   "aspect_ratio": {
    "description": "Aspect ratio (default: 9:16 portrait)",
    "enum": [
     "9:16",
     "16:9"
    ],
    "type": "string"
   },
   "music_url": {
    "description": "Background music URL (mp3, wav)",
    "type": "string"
   },
   "music_volume": {
    "description": "Music volume 0-1 (default: 0.3)",
    "type": "number"
   },
   "preprocess": {
    "description": "Auto-fix invalid formats with FFmpeg (default: false)",
    "type": "boolean"
   },
   "project_name": {
    "description": "Output filename without extension",
    "type": "string"
   },
   "scenes": {
    "description": "Video scenes to stitch (1-50)",
    "items": {
     "properties": {
      "durationInSeconds": {
       "description": "Duration in seconds",
       "type": "number"
      },
      "videoUrl": {
       "description": "URL to video file",
       "type": "string"
      }
     },
     "required": [
      "videoUrl",
      "durationInSeconds"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "test": {
    "description": "Route to test queue (default: false)",
    "type": "boolean"
   },
   "transition_frames": {
    "description": "Fade transition in frames (default: 15 = 0.5s at 30fps)",
    "type": "number"
   },
   "upload": {
    "description": "Upload result to SpiderMedia (default: false)",
    "type": "boolean"
   },
   "workspace": {
    "description": "Tenant to target (cli_\u2026). Omit to use the active/bound workspace. list_workspaces shows the options.",
    "type": "string"
   }
  },
  "required": [
   "project_name",
   "scenes"
  ],
  "type": "object"
 },
 "name": "create_video"
}
