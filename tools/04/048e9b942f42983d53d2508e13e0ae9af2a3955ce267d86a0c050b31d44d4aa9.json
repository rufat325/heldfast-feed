{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Delete a firewall rule"
 },
 "description": "Removes a firewall rule (its fw_... id from gpucloud_list_firewall_rules) of a ready server. (permission: firewall:write) [Requires a free GPU Cloud account and MCP key]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "ruleId": {
    "anyOf": [
     {
      "pattern": "^fw_[0-9a-f]{20}$",
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    ],
    "description": "Rule id (fw_...) from gpucloud_list_firewall_rules."
   },
   "serverId": {
    "description": "Server id (from gpucloud_list_servers).",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "serverId",
   "ruleId"
  ],
  "type": "object"
 },
 "name": "gpucloud_delete_firewall_rule",
 "title": "Delete a firewall rule"
}
