{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Search kitchens"},"description":"Finds published Stovefront kitchens and the dishes they have open for ordering. Matches words against kitchen names, dish names and categories, and can filter by dietary tags, pickup date and the area a kitchen serves. Returns each kitchen's name, storefront link, short description, service area and up to 8 matching dishes with price, dietary tags, stock and next pickup. Sample storefronts and kitchens hidden from search are not included.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"area":{"description":"City or neighborhood, matched against the area each kitchen says it serves","maxLength":100,"type":"string"},"cursor":{"description":"nextCursor from the previous page","maxLength":12,"type":"string"},"dietary":{"description":"Every dish returned has all of these tags","items":{"enum":["vegan","vegetarian","glutenFree","dairyFree","eggFree","nutFree","soyFree","paleo","spicy","containsNuts"],"type":"string"},"maxItems":10,"type":"array"},"limit":{"description":"Kitchens per page, default 10","maximum":20,"minimum":1,"type":"integer"},"pickup_date":{"description":"Only dishes that can be picked up or delivered on this kitchen-local date","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"pickup_from":{"description":"Start of a date range (use with pickup_to, at most 31 days)","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"pickup_to":{"description":"End of a date range, inclusive","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"query":{"description":"Words to match in kitchen names, dish names and categories, e.g. \"tamales\"","maxLength":200,"type":"string"}},"type":"object"},"name":"search_kitchens","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"currency":{"const":"USD",