{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Create a purchase order to receive goods against. Lines carry a sku, a description and an ordered whole-unit quantity. Over/under tolerances are whole percentages allowed above/below ordered before a GRN is flagged. Ids look like PO-0001. Free tier, full CRUD.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"lines":{"description":"Lines on this purchase order","items":{"additionalProperties":false,"properties":{"description":{"description":"What it is","maxLength":160,"type":"string"},"ordered":{"description":"Whole units ordered","maximum":1000000,"minimum":1,"type":"integer"},"sku":{"description":"Stock-keeping unit / model code","maxLength":40,"type":"string"}},"required":["sku","description","ordered"],"type":"object"},"maxItems":200,"minItems":1,"type":"array"},"overTolerancePct":{"default":10,"description":"Whole % extra allowed above ordered (default 10)","maximum":100,"minimum":0,"type":"integer"},"reference":{"description":"Your own purchase-order number","maxLength":60,"type":"string"},"supplier":{"description":"Who you ordered from","maxLength":60,"type":"string"},"underTolerancePct":{"default":10,"description":"Whole % short allowed below ordered (default 10)","maximum":100,"minimum":0,"type":"integer"}},"required":["reference","supplier","lines"],"type":"object"},"name":"po_add","title":"Add a purchase order"}
