{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tail.post"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit the exact customer-approved draft and previewBinding to the app moderation queue. Requires confirmation PUBLISH_POST, placementConfirmation and fWarning. Shares approved content with the Tail community when moderation allows; this irreversible send never places a wager. Keep the caller-generated commandKey (16-120 characters) stable for this action and all retries. Action and version are fixed by this tool; do not supply them.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "commandKey": {
    "maxLength": 120,
    "minLength": 16,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "confirmation": {
    "const": "PUBLISH_POST",
    "type": "string"
   },
   "draft": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "messageId": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
       },
       "pollOptions": {
        "items": {
         "maxLength": 50,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 4,
        "minItems": 2,
        "type": "array"
       },
       "source": {
        "const": "doctor_exchange",
        "type": "string"
       },
       "text": {
        "maxLength": 280,
        "type": "string"
       },
       "threadId": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
       }
      },
      "required": [
       "source",
       "threadId",
       "messageId",
       "text"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "placement": {
        "enum": [
         "asking",
         "self_reported_placed"
        ],
        "type": "string"
       },
       "pollOptions": {
        "items": {
         "maxLength": 50,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 4,
        "minItems": 2,
        "type": "array"
       },
       "reportId": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
       },
       "showStake": {
        "type": "boolean"
       },
       "text": {
        "maxLength": 280,
        "type": "string"
       }
      },
      "required": [
       "reportId",
       "text",
       "showStake",
       "placement"
      ],
      "type": "object"
     }
    ]
   },
   "fWarning": {
    "anyOf": [
     {
      "enum": [
       "acknowledge",
       "dont_ask_again"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "placementConfirmation": {
    "enum": [
     "NOT_PLACED",
     "SELF_REPORTED_PLACED"
    ],
    "type": "string"
   },
   "previewBinding": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "commandKey",
   "confirmation",
   "draft",
   "previewBinding",
   "placementConfirmation",
   "fWarning"
  ],
  "type": "object"
 },
 "name": "publish_tail_post",
 "securitySchemes": [
  {
   "scopes": [
    "tail.post"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Publish Tail post"
}
