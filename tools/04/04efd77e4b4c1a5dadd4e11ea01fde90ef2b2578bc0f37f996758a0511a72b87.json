        },
        {
         "exclusiveMinimum": 0,
         "maximum": 1000000000000000.0,
         "type": "number"
        }
       ]
      },
      "maxItems": 5000,
      "minItems": 1,
      "type": "array"
     },
     "high": {
      "anyOf": [
       {
        "items": {
         "anyOf": [
          {
           "exclusiveMinimum": 0,
           "maximum": 1000000000000000.0,
           "type": "integer",
           "x-strictJsonInteger": true
          },
          {
           "exclusiveMinimum": 0,
           "maximum": 1000000000000000.0,
           "type": "number"
          }
         ]
        },
        "maxItems": 5000,
        "minItems": 1,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "low": {
