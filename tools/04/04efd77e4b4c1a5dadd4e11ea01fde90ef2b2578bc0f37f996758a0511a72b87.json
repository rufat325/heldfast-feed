       {
        "items": {
         "anyOf": [
          {
           "exclusiveMinimum": 0,
           "maximum": 1000000000000000.0,
           "type": "integer",
           "x-strictJsonInteger": true
          },
          {
           "exclusiveMinimum": 0,
