           "x-strictJsonInteger": true
          },
          {
           "maximum": 1000000000000000.0,
           "minimum": 0,
           "type": "number"
          }
         ]
        },
        "maxItems": 5000,
        "minItems": 1,
        "type": "array"
       },
       {
        "type": "null"
