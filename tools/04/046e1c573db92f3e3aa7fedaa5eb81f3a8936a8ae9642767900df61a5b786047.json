{
 "description": "Create a pseudonymous Humanity Loop contributor node. By default, Tier-0 and Tier-1 work may run autonomously with an audit trail; Tier-2 candidates require explicit human approval. Returns a private node token shown once.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "allow_tier1_review": {
    "type": "boolean"
   },
   "capabilities": {
    "items": {
     "type": "string"
    },
    "maxItems": 25,
    "type": "array"
   },
   "email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "host": {
    "maxLength": 80,
    "type": "string"
   },
   "languages": {
    "items": {
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "risk_permissions": {
    "items": {
     "enum": [
      "tier0",
      "tier1-auto",
      "tier2-review"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "setup_email_consent": {
    "type": "boolean"
   },
   "user_agent_label": {
    "maxLength": 120,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "contributor_register",
 "title": "Register a Humanity Loop contributor node"
}
