{
 "description": "Wait for somebody to approve or reject a design, rather than asking again whether they have. Returns as soon as a decision lands after `afterSequence` \u2014 by default only a person's (`from: \"human\"`), on any revision unless you name one \u2014 or a `timedOut` reply after `waitSeconds`. Every reply carries `latest` (the newest matching verdict, new or not) and `approved`, so `waitSeconds: 0` is a cheap, idempotent poll for a routine that can only check back later; quote the reply's `sequence` as the next `afterSequence`. People record theirs over the design's `decisions` HTTP route.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "afterSequence": {
    "description": "The `sequence` you last saw. 0 for anything at all.",
    "type": "integer"
   },
   "agentModel": {
    "description": "Optional current model name shown to design viewers; self-reported. Omit when unknown.",
    "maxLength": 80,
    "type": "string"
   },
   "agentName": {
    "description": "Optional agent/client name shown to design viewers; self-reported.",
    "maxLength": 80,
    "type": "string"
   },
   "designId": {
    "type": "string"
   },
   "from": {
    "description": "Whose decisions count. Defaults to human.",
    "enum": [
     "human",
     "anyone"
    ],
    "type": "string"
   },
   "revision": {
    "description": "Only decisions on this revision.",
    "type": "integer"
   },
   "token": {
    "description": "A grant token from poll_access, when you cannot set the X-Compose-Preview-Token header yourself \u2014 an MCP client fixes its headers at connect time, so this is how a token approved during this session is used in it. Prefer the header where you control it.",
    "type": "string"
   },
   "waitSeconds": {
    "description": "Up to 120. Defaults to 25; 0 checks without blocking.",
    "type": "integer"
   }
  },
  "required": [
   "designId"
  ],
  "type": "object"
 },
 "name": "ui_builder_await_decision",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "approved": {
    "type": "boolean"
   },
   "decisions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "decidedAtEpochMillis": {
       "type": "integer"
      },
      "decidedBy": {
       "type": "string"
      },
      "deciderKind": {
       "type": "string"
      },
      "decisionId": {
       "type": "string"
      },
      "displayName": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "note": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "revision": {
       "type": "integer"
      },
      "sequence": {
       "type": "integer"
      },
      "verdict": {
       "type": "string"
      }
     },
     "required": [
      "decisionId",
      "sequence",
      "revision",
      "verdict",
      "decidedBy",
      "deciderKind",
      "decidedAtEpochMillis"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "designId": {
    "type": "string"
   },
   "latest": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "decidedAtEpochMillis": {
        "type": "integer"
       },
       "decidedBy": {
        "type": "string"
       },
       "deciderKind": {
        "type": "string"
       },
       "decisionId": {
        "type": "string"
       },
       "displayName": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "note": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "revision": {
        "type": "integer"
       },
       "sequence": {
        "type": "integer"
       },
       "verdict": {
        "type": "string"
       }
      },
      "required": [
       "decisionId",
       "sequence",
       "revision",
       "verdict",
       "decidedBy",
       "deciderKind",
       "decidedAtEpochMillis"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "schema": {
    "const": "compose-preview/ui-builder-decision/v1",
    "type": "string"
   },
   "sequence": {
    "type": "integer"
   },
   "summary": {
    "type": "string"
   },
   "timedOut": {
    "type": "boolean"
   }
  },
  "required": [
   "schema",
   "summary",
   "designId",
   "timedOut",
   "sequence",
   "approved"
  ],
  "type": "object"
 }
}
