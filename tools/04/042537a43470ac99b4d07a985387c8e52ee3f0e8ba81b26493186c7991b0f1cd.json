 "description": "Checks whether a specific fully-qualified domain (e.g. \"acme.com\") is available to register. Informational only; does not read or change any formation or company.",
 "inputSchema": {
  "properties": {
   "domain": {
    "maxLength": 253,
    "minLength": 1,
    "pattern": "^([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+\\.?)$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "formation_check_domain_availability",
 "outputSchema": {
  "properties": {
   "available": {
    "type": "boolean"
   },
   "message": {
    "type": "string"
   },
   "reason": {
    "enum": [
     "DOMAIN_PURCHASE_REASON_UNSPECIFIED",
     "DOMAIN_PURCHASE_REASON_AVAILABLE",
     "DOMAIN_PURCHASE_REASON_UNAVAILABLE",
     "DOMAIN_PURCHASE_REASON_UNSUPPORTED_TLD",
     "DOMAIN_PURCHASE_REASON_ERROR"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Check Domain Availability"
}
