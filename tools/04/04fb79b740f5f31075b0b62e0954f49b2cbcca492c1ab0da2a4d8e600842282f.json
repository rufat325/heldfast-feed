{
 "description": "DEV-2972: roll a published course version out to active learners. Every in-scope assignment is reclassified AT APPLY time from live state \u2014 learner progress drift never rejects the batch. Eligible assignments migrate now with state carried; unsafe/mid-work assignments queue and auto-migrate at their next safe boundary; already-current and terminal rows skip idempotently; only genuine per-assignment incompatibility blocks. Returns the durable batch receipt with counts {updatedNow, queued, alreadyCurrent, skippedTerminal, blocked, failed}; replayed verbatim for the same idempotency key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentIds": {
    "items": {
     "$ref": "#/properties/courseId"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "confirmApply": {
    "const": true,
    "type": "boolean"
   },
   "courseId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "expectedToContentHash": {
    "pattern": "^[0-9a-fA-F]{64}$",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Durable receipt key: 8-128 chars of letters, digits, ., _, :, -.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "jobId": {
    "$ref": "#/properties/courseId"
   },
   "policy": {
    "additionalProperties": false,
    "properties": {
     "assessmentReplaced": {
      "enum": [
       "RESET",
       "GRANDFATHER"
      ],
      "type": "string"
     },
     "completedAssignments": {
      "enum": [
       "SKIP"
      ],
      "type": "string"
     },
     "contentChanged": {
      "enum": [
       "CARRY",
       "RESET"
      ],
      "type": "string"
     },
     "openWork": {
      "enum": [
       "DEFER"
      ],
      "type": "string"
     }
    },
    "required": [
     "assessmentReplaced",
     "contentChanged",
     "openWork",
     "completedAssignments"
    ],
    "type": "object"
   },
   "toCourseVersionId": {
    "$ref": "#/properties/courseId"
   }
  },
  "required": [
   "courseId",
   "toCourseVersionId",
   "expectedToContentHash",
   "confirmApply",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_rollout_course_version",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
