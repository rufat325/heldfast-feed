{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Request a quote"
 },
 "description": "Ask a service business (plumber, etc.) for a price. Describe the problem in plain English. Many businesses answer instantly with an estimate and bookable slots; others reply within their stated response time (poll get_request_status).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "customer": {
    "description": "Who the job/order is for. Use what the customer already gave you; ask only for what a tool says is missing.",
    "properties": {
     "address": {
      "properties": {
       "city": {
        "type": "string"
       },
       "line1": {
        "type": "string"
       },
       "line2": {
        "type": "string"
       },
       "state": {
        "type": "string"
       },
       "zip": {
        "type": "string"
       }
      },
      "required": [
       "line1",
       "zip"
      ],
      "type": "object"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "notes": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "description": {
    "description": "What's wrong, in the customer's words",
    "type": "string"
   },
   "photos": {
    "description": "URLs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "preferred_times": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "service_sku": {
    "description": "If the profile's service list clearly matches",
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "urgency": {
    "enum": [
     "emergency",
     "today",
     "this_week",
     "flexible"
    ],
    "type": "string"
   }
  },
  "required": [
   "slug",
   "description",
   "customer"
  ],
  "type": "object"
 },
 "name": "request_quote",
 "title": "Request a quote"
}
