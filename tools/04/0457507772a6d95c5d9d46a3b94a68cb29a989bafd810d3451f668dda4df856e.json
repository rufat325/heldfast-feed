{
 "annotations": {},
 "description": "Change a TEXT node's text and whole-node settings (resize, truncation, alignment, spacing). Style parts with set_text_ranges.",
 "inputSchema": {
  "properties": {
   "maxLines": {
    "description": "Max lines (needs ENDING); null removes",
    "type": "number"
   },
   "nodeId": {
    "description": "TEXT node ID",
    "type": "string"
   },
   "paragraphIndent": {
    "description": "First line indent",
    "type": "number"
   },
   "paragraphSpacing": {
    "description": "Space between paragraphs",
    "type": "number"
   },
   "text": {
    "description": "New text",
    "type": "string"
   },
   "textAlignHorizontal": {
    "description": "Horizontal align",
    "type": "string"
   },
   "textAlignVertical": {
    "description": "Vertical align",
    "type": "string"
   },
   "textAutoResize": {
    "description": "NONE (fixed), HEIGHT (grow down), WIDTH_AND_HEIGHT (hug), or TRUNCATE",
    "type": "string"
   },
   "textTruncation": {
    "description": "ENDING adds \u2026 on overflow",
    "type": "string"
   }
  },
  "required": [
   "nodeId"
  ],
  "type": "object"
 },
 "name": "set_text"
}
