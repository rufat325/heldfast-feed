 "_meta": {
  "spellbook.finance/app-page": {
   "title": "Contact support",
   "url": "https://spellbook-finance.com/support"
  },
  "spellbook.finance/limitations": [
   "Receipt proves analytics storage under existing retention, not human review, response time, or permanent history.",
   "A customer who wants a person can email support@spellbook-finance.com or join the SpellBook Discord server at https://discord.gg/BbbepYdsJ2.",
   "If submission fails, contact support@spellbook-finance.com. A timeout or cancellation leaves storage uncertain; retry the identical submissionId and payload within 24 hours. Do not create a new key for an uncertain outcome."
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "File a support report"
 },
 "description": "Store one minimal customer failure report. Generate a fresh ULID submissionId and reuse the exact request for retries within 24 hours. Reports are accepted only after storage. No raw diagnostics, conversations, secrets, or customer identity. Available to authenticated Free customers, including paid-access denials. A report reaches no person.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "clientVersion": {
    "description": "This client's semantic version, e.g. \"1.2.3\". Required.",
    "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$",
    "type": "string"
   },
   "correlationId": {
    "description": "A correlation id from a prior response, if one was returned. Omit when none was given.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "errorCode": {
    "description": "Which closed error code best matches the failure. Required.",
    "enum": [
     "login_required",
     "access_denied",
     "invalid_input",
     "invalid_upstream_response",
     "upstream_http_error",
     "upstream_timeout",
     "upstream_unavailable",
     "upstream_response_too_large",
     "auth_unavailable",
     "invalid_token_response",
     "credential_store_busy",
     "credential_store_unavailable",
     "client_failure",
     "request_cancelled",
     "client_type_error",
     "client_range_error",
     "client_reference_error"
    ],
    "type": "string"
   },
   "occurredAt": {
    "description": "ISO-8601 timestamp of when the failure occurred. Required.",
    "format": "date-time",
    "maxLength": 30,
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
    "type": "string"
   },
