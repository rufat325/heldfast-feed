{
 "description": "Record a preparer or reviewer sign-off. Warns (does not block) if the same person prepared and reviewed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "actor": {
    "minLength": 1,
    "type": "string"
   },
   "comment": {
    "type": "string"
   },
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "role": {
    "enum": [
     "preparer",
     "reviewer"
    ],
    "type": "string"
   },
   "workpaperId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "workpaperId",
   "role"
  ],
  "type": "object"
 },
 "name": "sign_off",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "warning": {
    "type": "string"
   },
   "workpaper": {}
  },
  "required": [
   "workpaper"
  ],
  "type": "object"
 },
 "title": "Sign off a workpaper"
}
