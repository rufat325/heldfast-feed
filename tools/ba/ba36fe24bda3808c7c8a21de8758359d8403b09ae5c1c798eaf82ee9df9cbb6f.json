{
 "description": "List shaders from the GripForge catalog (authorized GodotShaders.com mirror). Returns { id, name, engines }. Search q=slash_reveal (alias) or a name. Then pull with gripforge_shader_pull. Listing is free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Page size (default 50, max 200)",
    "type": "number"
   },
   "offset": {
    "description": "Offset (default 0)",
    "type": "number"
   },
   "q": {
    "description": "Search id/name/alias (e.g. slash_reveal)",
    "type": "string"
   },
   "type": {
    "description": "Godot shader_type filter",
    "enum": [
     "canvas_item",
     "spatial",
     "sky",
     "particles",
     "fog"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "gripforge_shaders"
}
