{
 "_meta": {
  "openai/outputTemplate": "ui://widget/aviasurf-flight-results.html",
  "openai/toolInvocation/invoked": "Aviasurf results ready",
  "openai/toolInvocation/invoking": "Searching Aviasurf\u2026",
  "ui": {
   "resourceUri": "ui://widget/aviasurf-flight-results.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find filtered indicative flight prices"
 },
 "description": "Find cached indicative fares with baggage, cabin, direct-flight, budget, flexible-date, and trip-duration filters and render interactive flight cards. Prices are per adult. Always link the returned search_url from a short label in the answer language, for example \"Check live prices on Aviasurf\"; never paste the raw URL as text. Airline, departure-time, and transfer-count filters are applied only to the returned cache sample and are reported in query_coverage. Use flight_prices for requests that do not need these filters.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "airlines": {
    "description": "Allowed airline IATA codes, applied locally to the returned sample.",
    "items": {
     "pattern": "^[A-Za-z0-9]{2,3}$",
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "convenient": {
    "description": "Ask upstream for convenient itineraries.",
    "type": "boolean"
   },
   "currency": {
    "description": "Three-letter output currency. Set it only when the user explicitly requests a currency; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "depart_date_max": {
    "description": "Latest departure date, inclusive.",
    "format": "date",
    "type": "string"
   },
   "depart_date_min": {
    "description": "Earliest departure date, inclusive.",
    "format": "date",
    "type": "string"
   },
   "departure_time_max": {
    "description": "Latest local departure time in HH:MM format, applied locally.",
    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
    "type": "string"
   },
   "departure_time_min": {
    "description": "Earliest local departure time in HH:MM format, applied locally.",
    "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
    "type": "string"
   },
   "direct": {
    "description": "Ask upstream for nonstop options only.",
    "type": "boolean"
   },
   "grouping": {
    "description": "Optional upstream grouping mode.",
    "enum": [
     "NONE",
     "DEPART_DATE",
     "DIRECTIONS",
     "DATES",
     "DATES_NUM_OF_CHANGES",
     "YEAR_MONTH"
    ],
    "type": "string"
   },
   "limit": {
    "default": 30,
    "description": "Maximum upstream samples per pair.",
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "en",
    "description": "Language locale for names and response text.",
    "pattern": "^[A-Za-z]{2}(?:-[A-Za-z]{2})?$",
    "type": "string"
   },
   "market": {
    "description": "Two-letter country market. Set it only when the user explicitly requests a country market or local Aviasurf site; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "no_lowcost": {
    "description": "Exclude low-cost carriers upstream.",
    "type": "boolean"
   },
   "no_visa_at_transfer": {
    "description": "Exclude itineraries flagged as requiring a transit visa.",
    "type": "boolean"
   },
   "offset": {
    "description": "Upstream result offset.",
    "minimum": 0,
    "type": "integer"
   },
   "one_way": {
    "description": "Search one-way trips; inferred from return constraints when omitted.",
    "type": "boolean"
   },
   "pairs": {
    "description": "One to three origin/destination pairs to search in one batch.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "destination": {
       "description": "Destination city or airport IATA code.",
       "pattern": "^[A-Za-z]{3}$",
       "type": "string"
      },
      "origin": {
       "description": "Origin city or airport IATA code.",
       "pattern": "^[A-Za-z]{3}$",
       "type": "string"
      }
     },
     "required": [
      "origin",
      "destination"
     ],
     "type": "object"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "return_date_max": {
    "description": "Latest return date, inclusive.",
    "format": "date",
    "type": "string"
   },
   "return_date_min": {
    "description": "Earliest return date, inclusive.",
    "format": "date",
    "type": "string"
   },
   "sorting": {
    "default": "VALUE_ASC",
    "description": "Upstream result ordering.",
    "enum": [
     "VALUE_ASC",
     "ROUTE_WEIGHT_DESC",
     "DISCOUNT_DESC"
    ],
    "type": "string"
   },
   "transfers_max": {
    "description": "Maximum number of transfers, applied locally to the returned sample.",
    "maximum": 4,
    "minimum": 0,
    "type": "integer"
   },
   "trip_class": {
    "description": "Cabin class; human-readable names are preferred and Y/W/C/F are accepted aliases.",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first",
     "Y",
     "W",
     "C",
     "F"
    ],
    "type": "string"
   },
   "trip_duration_max": {
    "description": "Maximum trip length in days for round trips.",
    "minimum": 1,
    "type": "integer"
   },
   "trip_duration_min": {
    "description": "Minimum trip length in days for round trips.",
    "minimum": 1,
    "type": "integer"
   },
   "value_max": {
    "description": "Maximum indicative price in the requested currency.",
    "minimum": 0,
    "type": "integer"
   },
   "value_min": {
    "description": "Minimum indicative price in the requested currency.",
    "minimum": 0,
    "type": "integer"
   },
   "with_baggage": {
    "description": "Ask upstream for options marked as including baggage.",
    "type": "boolean"
   }
  },
  "required": [
   "pairs",
   "depart_date_min"
  ],
  "type": "object"
 },
