{"_meta":{"securitySchemes":[{"scopes":["mcp:read","mcp:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"No charge. Revise an owned draft's text, font, size, optional color and page limit and optional format settings and letterhead:{id,version} (or null to remove) using its current version. format controls printed fields, greeting/signature, reply cleanup, spacing/margins/page numbers; omitted format/color/letterhead/maxPages preserves the draft's settings. body may be empty. A supplied format fills unspecified fields with defaults, so merge existing settings first to change just one option. Color adds $0.49 for each page; site previews are grayscale when false. Production key required. Renders a new immutable PDF and increments version; always requires fresh review and approval. Cannot edit submitted, uncertain or rejected letters.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"body":{"description":"Required, but may be empty to clear the printed body. The original EML is preserved.","maxLength":100000,"type":"string"},"color":{"type":"boolean"},"font":{"enum":["times","librebaskerville","ebgaramond","sourceserif4","lora","merriweather","spectral","inter","roboto","opensans","notosans","nunito","ptserif"],"type":"string"},"fontSize":{"maximum":24,"minimum":8,"type":"integer"},"format":{"additionalProperties":false,"description":"Omit to preserve the draft format. When supplied, omitted format fields use their defaults; this is not a partial patch.","properties":{"dateFormat":{"default":"email","enum":["email","month_ordinal","month_day","day_month"],"type":"string"},"greeting":{"default":"","maxLength":300,"type":"string"},"lineSpacing":{"anyOf":[{"const":1.2,"type":"number"},{"const":1.45,"type":"number"},{"const":1.75,"type":"number"},{"const":2,"type":"number"}],"default":1.45},"marginInches":{"anyOf":[{"const":0.5,"type":"number"},{"const":1,"type":"number"},{"const":1.25,"type":"number"}],"default":1},"removeQuotedReplies":{"default":false,"type":"boolean"},"showDate":{"default":true,"type":"boolean"},"showEmailFrom":{"default":true,"type":"boolean"},"showEmailTo":{"default":false,"type":"boolean"},"showMailingAddress":{"default":true,"type":"boolean"},"showPageNumbers":{"default":true,"type":"boolean"},"showReturnAddress":{"default":true,"type":"boolean"},"showSubject":{"default":true,"type":"boolean"},"signature":{"default":"","maxLength":2000,"type":"string"}},"type":"object"},"id":{"pattern":"^[a-f0-9]{64}$","type":"string"},"letterhead":{"anyOf":[{"additionalProperties":false,"properties":{"id":{"pattern":"^[a-f0-9]{64}$","type":"string"},"version":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"required":["id","version"],"type":"object"},{"type":"null"}],"description":"Omit to preserve the pinned revision; null removes stationery; a reference selects that exact active owned revision."},"maxPages":{"maximum":20,"minimum":1,"type":"integer"},"version":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"required":["id","version","body","font","fontSize"],"type":"object"},"name":"edit_email_letter","outputSchema":{"additionalProperties":true,"description":"Read operation first for financial/mail state and recovery. Optional service fields are absent on failure. Unknown is not zero or permission to retry. Legacy service fields remain available.","properties":{"body":{"type":"string"},"error":{"type":"string"},"message":{"anyOf":[{"additionalProperties":true,"properties":{"id":{"type":"string"},"jobId":{"type":"string"},"priceCents":{"type":"integer"},"state":{"type":"string"},"version":{"type":"integer"}},"type":"object"},{"type":"string"}]},"operation":{"additionalProperties":false,"properties":{"amountCents":{"description":"USD cents. Null means not applicable or not known; never interpret null as zero.","type":["integer