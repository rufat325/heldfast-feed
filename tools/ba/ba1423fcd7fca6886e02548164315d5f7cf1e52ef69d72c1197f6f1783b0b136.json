{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Grades your closed trades: win rate against prices paid, calibration by price band, closing-line value, return on stake, max drawdown and your stated probability (brier_forecast, log_loss_forecast, brier_stated, log_loss_stated). Default since Sep 1, 2026. by adds a breakdown.",
 "inputSchema": {
  "properties": {
   "by": {
    "enum": [
     "league",
     "band",
     "hold"
    ],
    "type": "string"
   },
   "full": {
    "description": "Keep empty calibration bands.",
    "type": "boolean"
   },
   "month": {
    "description": "Deprecated.",
    "type": "string"
   },
   "run": {
    "description": "Since your last reset.",
    "enum": [
     "current"
    ],
    "type": "string"
   },
   "since": {
    "description": "30d, YYYY-MM-DD or ISO.",
    "type": "string"
   },
   "until": {
    "description": "YYYY-MM-DD or ISO.",
    "type": "string"
   },
   "window": {
    "description": "Default all.",
    "enum": [
     "all",
     "30d",
     "90d"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_my_stats",
 "outputSchema": {
  "properties": {
   "stats": {
    "type": "object"
   },
   "web_url": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Grade my trading"
}
