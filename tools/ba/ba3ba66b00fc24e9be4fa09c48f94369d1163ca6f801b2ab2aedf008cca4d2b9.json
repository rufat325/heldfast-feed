{
 "description": "Return a page of freestanding notes across agents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_level": {
    "default": "public",
    "type": "string"
   },
   "agent": {
    "type": [
     "string",
     "null"
    ]
   },
   "cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "include_private": {
    "default": false,
    "type": "boolean"
   },
   "limit": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "since": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "name": "list_notes"
}
