{
 "description": "Mark a benefit period as used, partially used, or unused. Use the period_id from list_benefits or get_benefit. If status is omitted, defaults to 'used' (the 90% use case).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount_used": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^[+-]?\\d+(\\.\\d+)?$",
      "type": "string"
     }
    ],
    "description": "Dollar amount used (required for partial status)"
   },
   "notes": {
    "description": "Optional note about usage",
    "type": "string"
   },
   "period_id": {
    "description": "The period ID to update",
    "type": "string"
   },
   "status": {
    "description": "New usage status (default: 'used')",
    "enum": [
     "unused",
     "partial",
     "used"
    ],
    "type": "string"
   }
  },
  "required": [
   "period_id"
  ],
  "type": "object"
 },
 "name": "mark_benefit_used"
}
