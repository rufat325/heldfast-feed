{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create project update"
 },
 "description": "Create a periodic project status update. Requires project_updates:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "author_id": {
    "description": "Author Clerk user ID (required)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "content": {
    "description": "Update content (required)",
    "minLength": 1,
    "type": "string"
   },
   "period_value": {
    "description": "Period value - 1-12 for monthly, 1-4 for quarterly, etc. (required)",
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   },
   "period_year": {
    "description": "Year for this update period (required)",
    "maximum": 2100,
    "minimum": 2000,
    "type": "integer"
   },
   "project_id": {
    "description": "Project ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "timeframe": {
    "description": "Update timeframe (required)",
    "enum": [
     "monthly",
     "quarterly",
     "bi-annually",
     "annually"
    ],
    "type": "string"
   },
   "title": {
    "description": "Optional custom title",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "author_id",
   "timeframe",
   "period_year",
   "period_value",
   "content"
  ],
  "type": "object"
 },
 "name": "create_project_update",
 "title": "Create project update"
}
