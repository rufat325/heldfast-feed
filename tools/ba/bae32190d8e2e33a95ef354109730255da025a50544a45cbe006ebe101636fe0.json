{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Stock comparison and weight in an ETF"
 },
 "description": "Use this when the user asks how two US stocks compare on size, valuation, returns, risk or correlation, or what weight and rank one stock has inside one named ETF, for example META in QQQ. For two stocks it returns market cap, P/E and dividend yield from market data, returns, volatility, worst fall, beta, the correlation of weekly returns over up to three years and the covered ETFs holding both. For a stock and an ETF it returns whether the ETF holds the stock, at what weight and rank among the shares it holds outright, with the date of the ETF's holdings; a derivative-based ETF's swaps, futures and options are in its profile (get_etf_holdings), not here. A stock is in the data with about two years of US prices, and sooner for a recent listing a covered ETF holds. Returns are past, not a forecast. Not for comparing two ETFs (compare_etfs), or a company's business or products.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "a": {
    "description": "A US stock ticker, for example NVDA. An ETF ticker also works on one side, for example QQQ.",
    "type": "string"
   },
   "b": {
    "description": "The other ticker, for example AMD.",
    "type": "string"
   }
  },
  "required": [
   "a",
   "b"
  ],
  "type": "object"
 },
 "name": "compare_stocks",
 "outputSchema": {
  "patternProperties": {
   "^[A-Z0-9.\\-^=/ *&]{1,16}$": {
    "properties": {
     "beta": {
      "description": "Over three years.",
      "type": [
       "number",
       "null"
      ]
     },
     "dividend_yield_pct": {
      "type": [
       "number",
       "null"
      ]
     },
