{
 "annotations": {
  "readOnlyHint": true,
  "title": "List jobs"
 },
 "description": "List the company's jobs (Recruitee calls them offers) with id, title, status, slug, department_id, recruiter_id, hiring_manager_id and pipeline_template_id. Filter by status, department, location, recruiter, hiring manager, tag and more; add heavy fields with `include` (e.g. counters for candidate counts, description, salary, location_ids). Paginated with limit + page (default 1000 per page); `meta.total_count` gives the total. Recruitee: GET /c/{company_id}/offers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "categories": {
    "description": "Only these job categories, e.g. information_technology.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "department_ids": {
    "description": "Only jobs in these departments.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "employment_types": {
    "description": "Only these employment types, e.g. fulltime.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "hiring_manager_ids": {
    "description": "Only jobs with these hiring managers (admin ids).",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "include": {
    "description": "Extra field groups to return.",
    "items": {
     "enum": [
      "description",
      "requirements",
      "highlight",
      "work_models",
      "salary",
      "dynamic_fields",
      "follower_ids",
      "location_ids",
      "requisition_ids",
      "tags",
      "job_scheduler",
      "issues",
      "counters"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "lang_codes": {
    "description": "Only jobs in these languages, e.g. en.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Jobs per page (default 1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "location_ids": {
    "description": "Only jobs at these locations.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "offer_ids": {
    "description": "Only these job ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "page": {
    "description": "Page number, starting at 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "priorities": {
    "description": "Only jobs with these priorities.",
    "items": {
     "enum": [
      "urgent",
      "high",
      "normal",
      "low"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "recruiter_ids": {
    "description": "Only jobs with these recruiters (admin ids).",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "statuses": {
    "description": "Only jobs in these statuses.",
    "items": {
     "enum": [
      "draft",
      "published",
      "internal",
      "closed",
      "archived"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "tag_ids": {
    "description": "Only jobs with these job tags.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "recruitee_list_offers",
 "title": "List jobs"
}
