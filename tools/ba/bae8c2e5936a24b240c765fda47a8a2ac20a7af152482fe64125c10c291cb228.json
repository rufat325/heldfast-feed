{
 "description": "Record what a session is about: a one-line title and an optional note. Readers of the store (the web view, get_session_works) show these instead of the bare session id. Fields you omit are kept.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approval_state": {
    "enum": [
     "approved",
     "waiting_user"
    ],
    "type": "string"
   },
   "default_acceptance": {
    "items": {
     "anyOf": [
      {
       "minLength": 1,
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "baseline": {
         "additionalProperties": false,
         "properties": {
          "failures": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "kind": {
              "enum": [
               "failure",
               "error"
              ],
              "type": "string"
             },
             "signature": {
              "minLength": 1,
              "type": "string"
             },
             "test_id": {
              "minLength": 1,
              "type": "string"
             }
            },
            "required": [
             "test_id",
             "kind",
             "signature"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "identity": {
           "additionalProperties": {
            "minLength": 1,
            "type": "string"
           },
           "properties": {
            "base_commit": {
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "base_commit"
           ],
           "type": "object"
          },
          "required": {
           "items": {
            "minLength": 1,
            "type": "string"
           },
           "type": "array"
          }
         },
         "required": [
          "identity",
          "failures",
          "required"
         ],
         "type": "object"
        },
        "command": {
         "minLength": 1,
         "type": "string"
        },
        "reportPath": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "command",
        "reportPath",
        "baseline"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 10,
    "type": "array"
   },
   "expected_revision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "note": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "objective": {
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "session_id": {
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "describe_session",
 "title": "Describe session"
}
