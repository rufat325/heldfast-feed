 "description": "Create an outgoing (sales) invoice as a **draft** \u2014 nothing is booked yet\n(accountant role).\n\nA draft changes no ledger balance, gets no invoice number and appears in no VAT\nreturn; it exists so it can be edited. Posting happens later, at\n``POST \u2026/ar/invoices/{invoice_id}/issue``.\n\nBody: ``issue_date`` (required), ``counterparty_id`` (the customer \u2014 required\nbefore it can be issued), ``currency``/``language``, ``due_date`` (filled from the\ncustomer's payment terms when omitted), ``doc_type`` (``invoice``, the default \u2014 a\n``credit_note`` draft can never be issued: credit an issued invoice with\n``POST \u2026/ar/invoices/{invoice_id}/credit-note`` instead), and ``lines``: each line\ncarries ``quantity``, ``unit_price``, a revenue ``account_code`` and a\n``vat_code_id`` (the id from ``GET \u2026/gl/vat-codes``; a line without one declares no\nVAT). Totals, per-line net/VAT/gross and discounts are computed server-side \u2014 do\nnot send them.\n\nReturns the created invoice with its lines and computed totals. Check\n``GET \u2026/ar/invoices/{invoice_id}/readiness`` for what still blocks issuing.",
 "inputSchema": {
  "properties": {
   "company_id": {
    "type": "string"
   },
   "counterparty_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "credited_invoice_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "currency": {
    "default": "CHF",
    "maxLength": 3,
    "minLength": 3,
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "doc_type": {
    "default": "invoice",
    "enum": [
     "invoice",
     "credit_note"
    ],
    "type": "string"
   },
   "due_date": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "footer_text": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "invoice_discount_kind": {
    "default": "none",
    "enum": [
     "none",
     "percent",
     "amount"
    ],
    "type": "string"
   },
   "invoice_discount_value": {
    "anyOf": [
     {
      "minimum": 0.0,
      "type": "number"
     },
     {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "type": "string"
     }
    ],
    "default": "0"
   },
   "issue_date": {
    "format": "date",
    "type": "string"
   },
   "issuer_profile_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "language": {
    "anyOf": [
     {
      "enum": [
       "de",
       "en",
       "fr",
       "it"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "legal_text": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "lines": {
    "items": {
     "properties": {
      "account_code": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "description": {
       "anyOf": [
        {
         "maxLength": 8000,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "group_label": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "item_code": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "line_discount_kind": {
       "default": "none",
       "enum": [
        "none",
        "percent",
        "amount"
       ],
       "type": "string"
      },
      "line_discount_value": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
         "type": "string"
        }
       ],
       "default": "0"
      },
      "line_type": {
       "default": "product",
       "enum": [
        "product",
        "service",
        "text",
        "section",
        "discount"
       ],
       "type": "string"
      },
      "product_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "quantity": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "service_period_end": {
       "anyOf": [
        {
         "format": "date",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "service_period_start": {
       "anyOf": [
        {
         "format": "date",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sort_order": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "unit_label": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "unit_price": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "vat_code_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "payment_terms_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "service_period_end": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "service_period_start": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "company_id",
   "issue_date"
  ],
  "type": "object"
 },
 "name": "create_ar_invoice"
}
