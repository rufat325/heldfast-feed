{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Apply Normalize"
 },
 "description": "Apply normalize operations. Two modes: \"extract\" writes agent-approved strings to Contentrain content files (source untouched), \"reuse\" patches source files with agent-provided replacement expressions. DRY RUN (default, dry_run:true): validates inputs, resolves conflicts, and returns a full preview \u2014 NO changes to disk or git. EXECUTE (dry_run:false): writes files to disk, commits to a branch, and requires branch health check to pass. Recommended workflow: always run dry_run first, review the preview, then call again with dry_run:false to execute. Normalize operations always use review workflow (never auto-merge).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dry_run": {
    "default": true,
    "description": "Defaults to preview mode (dry_run:true). Set dry_run:false to execute after reviewing the preview.",
    "type": "boolean"
   },
   "extractions": {
    "description": "Extract mode: content extractions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "domain": {
       "description": "Content domain (e.g. \"marketing\", \"app\")",
       "type": "string"
      },
      "entries": {
       "description": "Content entries to create",
       "items": {
        "additionalProperties": false,
        "properties": {
         "data": {
          "additionalProperties": {},
          "description": "Content data",
          "type": "object"
         },
         "locale": {
          "description": "Locale. Default: project default",
          "type": "string"
         },
         "slug": {
          "description": "Document slug",
          "type": "string"
         },
         "source": {
          "additionalProperties": false,
          "description": "Source tracking for traceability",
          "properties": {
           "file": {
            "description": "Source file path",
            "type": "string"
           },
           "line": {
            "description": "Source line number",
            "type": "number"
           },
           "value": {
            "description": "Original string value",
            "type": "string"
           }
          },
          "required": [
           "file",
           "line",
           "value"
          ],
          "type": "object"
         },
         "sources": {
          "description": "Per-key source tracking for dictionary models",
          "items": {
           "additionalProperties": false,
           "properties": {
            "file": {
             "description": "Source file path",
             "type": "string"
            },
            "key": {
             "description": "Dictionary key this source maps to",
             "type": "string"
            },
            "line": {
             "description": "Source line number",
             "type": "number"
            },
            "value": {
             "description": "Original string value",
             "type": "string"
            }
           },
           "required": [
            "file",
            "line",
            "key",
            "value"
           ],
           "type": "object"
          },
          "type": "array"
         }
        },
        "required": [
         "data"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "fields": {
       "additionalProperties": {
        "additionalProperties": false,
        "properties": {
         "accept": {
          "type": "string"
         },
         "default": {},
         "description": {
          "type": "string"
         },
         "fields": {
          "additionalProperties": {},
          "type": "object"
         },
         "items": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "additionalProperties": {},
            "type": "object"
           }
          ]
         },
         "label": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "additionalProperties": {
             "type": "string"
            },
            "type": "object"
           }
          ],
          "description": "Editor label. A string is one label for all locales; an object keyed by locale carries a translation each."
         },
         "max": {
          "type": "number"
         },
         "maxSize": {
          "type": "number"
         },
         "min": {
          "type": "number"
         },
         "model": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "items": {
             "type": "string"
            },
            "type": "array"
           }
          ]
         },
         "options": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "order": {
          "description": "Display position, ascending. Fields without one sort last, alphabetically. Fractional values allowed.",
          "type": "number"
         },
         "pattern": {
          "type": "string"
         },
         "required": {
          "type": "boolean"
         },
         "type": {
          "description": "Field type from the 27-type catalog",
          "enum": [
           "string",
           "text",
           "email",
           "url",
           "slug",
           "color",
           "phone",
           "code",
           "icon",
           "markdown",
           "richtext",
           "number",
           "integer",
           "decimal",
           "percent",
           "rating",
           "boolean",
           "date",
           "datetime",
           "image",
           "video",
           "file",
           "relation",
           "relations",
           "select",
           "array",
           "object"
          ],
          "type": "string"
         },
         "unique": {
          "type": "boolean"
         }
        },
        "required": [
         "type"
        ],
        "type": "object"
       },
       "description": "Field definitions \u2014 shared schema with model_save for full parity",
       "type": "object"
      },
      "i18n": {
       "description": "Enable i18n. Default: true",
       "type": "boolean"
      },
      "kind": {
       "description": "Model kind",
       "enum": [
        "singleton",
        "collection",
        "dictionary",
        "document"
       ],
       "type": "string"
      },
      "model": {
       "description": "Model ID (e.g. \"ui-texts\", \"hero-section\")",
       "type": "string"
      },
      "title_field": {
       "description": "Field shown as an entry title. Inferred from the extracted fields when omitted; the dry run reports what was chosen. Dictionary models: \"key\".",
       "type": "string"
      }
     },
     "required": [
      "model",
      "kind",
      "domain",
      "entries"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "mode": {
    "description": "Apply mode: extract (content creation) or reuse (source patching)",
    "enum": [
     "extract",
     "reuse"
    ],
    "type": "string"
   },
   "patches": {
    "description": "Reuse mode: patches to apply (max 100)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "file": {
       "description": "Relative file path to patch",
       "type": "string"
      },
      "import_statement": {
       "description": "Import to add if needed",
       "type": "string"
      },
      "line": {
       "description": "Line number hint (\u00b110 line search)",
       "type": "number"
      },
      "new_expression": {
       "description": "Replacement expression (agent-determined)",
       "type": "string"
      },
      "old_value": {
       "description": "Original string to replace",
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "old_value",
      "new_expression"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scope": {
    "additionalProperties": false,
    "description": "Reuse mode: scope (model or domain required)",
    "properties": {
     "domain": {
      "description": "Target domain",
      "type": "string"
     },
     "model": {
      "description": "Target model ID",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "mode"
  ],
  "type": "object"
 },
 "name": "contentrain_apply"
}
