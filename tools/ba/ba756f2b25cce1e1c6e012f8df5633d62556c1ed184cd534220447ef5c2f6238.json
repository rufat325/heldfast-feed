    "type": "string"
   },
   "limit": {
    "description": "Maximum rows to return (default 50 for observations, 25 for catalog queries).",
    "type": "number"
   },
   "series_ids": {
    "description": "2 to 5 FRED series IDs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "start": {
    "description": "Inclusive lower-bound ISO date (YYYY-MM-DD).",
    "type": "string"
   }
  },
