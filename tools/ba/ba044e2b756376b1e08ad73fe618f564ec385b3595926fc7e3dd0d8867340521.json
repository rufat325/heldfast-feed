{
 "description": "Scroll the page or a specific container. Returns full page representation after scrolling.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "description": "Scroll amount: \"page\" (default), \"half\", or pixel value (e.g. \"200\")",
    "type": "string"
   },
   "direction": {
    "description": "Scroll direction",
    "enum": [
     "up",
     "down",
     "left",
     "right"
    ],
    "type": "string"
   },
   "element_id": {
    "description": "Scroll within a specific container element",
    "type": "string"
   }
  },
  "required": [
   "direction"
  ],
  "type": "object"
 },
 "name": "charlotte_scroll"
}
