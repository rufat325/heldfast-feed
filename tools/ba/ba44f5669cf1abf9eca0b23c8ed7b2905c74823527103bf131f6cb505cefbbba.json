{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "A page of claims on a deployment, by id, each with its status, member count, bond, and \u2014 for sealed ones \u2014 how many Creditcoin blocks remain in the challenge window. Sealed claims inside their window are the ones a watcher can still act on. Pass the returned nextCursor to get the next page; utuh://claims/{deployment} is the same list in one read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page; omit for the first",
    "type": "string"
   },
   "deployment": {
    "description": "Which deployment: \"sepolia\" is the completed loop, \"mainnet\" underwrites real Aave history",
    "enum": [
     "sepolia",
     "mainnet"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Claims per page, 1..100",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "deployment"
  ],
  "type": "object"
 },
 "name": "list_claims",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "claims": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bondCTC": {
       "type": "string"
      },
      "challengeBlocksLeft": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Creditcoin blocks left in the window; null unless Sealed"
      },
      "claimId": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "claimant": {
       "type": "string"
      },
      "fromBlock": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "members": {
       "description": "Events proven into the claim",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "refutable": {
       "description": "Sealed and still inside its challenge window",
       "type": "boolean"
      },
      "status": {
       "description": "Open, Sealed, Finalized or Refuted",
       "type": "string"
      },
      "toBlock": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "claimId",
      "status",
      "members",
      "fromBlock",
      "toBlock",
      "bondCTC",
      "claimant",
      "challengeBlocksLeft",
      "refutable"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "deployment": {
    "description": "Which deployment: \"sepolia\" is the completed loop, \"mainnet\" underwrites real Aave history",
    "enum": [
     "sepolia",
     "mainnet"
    ],
    "type": "string"
   },
   "head": {
    "description": "The Creditcoin block the windows were measured against",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "nextCursor": {
    "description": "null on the last page",
    "type": [
     "string",
     "null"
    ]
   },
   "registry": {
    "type": "string"
   },
   "total": {
    "description": "Claims on the deployment",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "deployment",
   "registry",
   "head",
   "total",
   "claims",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List claims"
}
