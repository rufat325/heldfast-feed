{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Creates or overwrites a proxy secret. The site calls /_gk/proxy/:name and the Worker attaches this value server-side, so the secret never reaches the deployed site's own code.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Letters, digits, - and _ only.",
    "minLength": 1,
    "type": "string"
   },
   "site_id": {
    "description": "The site's id, from list_sites or create_site.",
    "minLength": 1,
    "type": "string"
   },
   "target_url": {
    "description": "Must be https://.",
    "minLength": 1,
    "type": "string"
   },
   "value": {
    "description": "The secret value (e.g. an API key). Never returned by list_secrets afterward.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "site_id",
   "name",
   "value",
   "target_url"
  ],
  "type": "object"
 },
 "name": "set_secret",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ok": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Set secret"
}
