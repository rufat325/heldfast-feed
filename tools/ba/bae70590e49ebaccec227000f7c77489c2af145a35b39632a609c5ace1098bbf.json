{
 "_meta": {
  "openai/outputTemplate": "ui://widget/xenition-artifact.html",
  "openai/toolInvocation/invoked": "Updated",
  "openai/toolInvocation/invoking": "Editing\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "xenition.read",
     "xenition.write"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://xenition-app/xenition-artifact.html"
  }
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit a saved item"
 },
 "description": "Use this when the user wants one of their existing Xenition items changed in place \u2014 rewrite, shorten, expand, change tone, fix grammar or translate. Saves a new version and returns it. Best for documents and notes. To only suggest changes without editing, use review_artifact.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "artifactId": {
    "description": "the id of the artifact to edit (from search_artifacts / get_artifact)",
    "type": "string"
   },
   "instruction": {
    "description": "what to change, in plain language (e.g. 'make it shorter', 'translate to Spanish', 'more formal tone')",
    "type": "string"
   }
  },
  "required": [
   "artifactId",
   "instruction"
  ],
  "type": "object"
 },
 "name": "edit_artifact",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "artifact": {
    "additionalProperties": false,
    "properties": {
     "content": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "language": {
      "type": "string"
     },
     "openUrl": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "totalChars": {
      "type": "integer"
     },
     "truncated": {
      "type": "boolean"
     },
     "type": {
      "type": "string"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "type",
     "content",
     "updatedAt"
    ],
    "type": "object"
   }
  },
  "required": [
   "artifact"
  ],
  "type": "object"
 },
 "title": "Edit a saved item"
}
