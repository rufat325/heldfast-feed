{
 "description": "Generate a complete MCP server package from a name, description, and tool definitions. Returns package.json, tsconfig.json, src/index.ts, README.md, and mcpize.yaml.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "Short description of what the server does",
    "type": "string"
   },
   "name": {
    "description": "Server package name",
    "type": "string"
   },
   "tools": {
    "description": "Array of tool definitions",
    "items": {
     "properties": {
      "description": {
       "description": "What the tool does",
       "type": "string"
      },
      "implementation": {
       "description": "TypeScript function body that returns a string value",
       "type": "string"
      },
      "name": {
       "description": "Tool name (snake_case)",
       "type": "string"
      },
      "params": {
       "description": "Array of parameter definitions",
       "items": {
        "properties": {
         "description": {
          "description": "Parameter description",
          "type": "string"
         },
         "name": {
          "description": "Parameter name",
          "type": "string"
         },
         "type": {
          "description": "Parameter type: string, number, or boolean",
          "type": "string"
         }
        },
        "required": [
         "name",
         "type",
         "description"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "description",
      "params",
      "implementation"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "description",
   "tools"
  ],
  "type": "object"
 },
 "name": "generate_server"
}
