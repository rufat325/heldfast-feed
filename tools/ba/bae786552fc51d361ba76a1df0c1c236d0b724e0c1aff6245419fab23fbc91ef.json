{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compact selected Wikidata facts for at most 10 supplied QIDs. Fact lookup does not establish local identity.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "fields": {
    "anyOf": [
     {
      "items": {
       "maxLength": 512,
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Fields"
   },
   "lang": {
    "default": "en",
    "maxLength": 512,
    "title": "Lang",
    "type": "string"
   },
   "qids": {
    "items": {
     "maxLength": 512,
     "type": "string"
    },
    "maxItems": 10,
    "title": "Qids",
    "type": "array"
   },
   "refresh": {
    "default": false,
    "title": "Refresh",
    "type": "boolean"
   }
  },
  "required": [
   "qids"
  ],
  "title": "kg_lookup_entitiesArguments",
  "type": "object"
 },
 "name": "kg_lookup_entities"
}
