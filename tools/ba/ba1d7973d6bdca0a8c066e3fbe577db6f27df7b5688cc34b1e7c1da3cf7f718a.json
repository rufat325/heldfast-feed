{"annotations":{"idempotentHint":false,"readOnlyHint":true},"description":"Apply the same metadata changes (tags, series, publisher, etc.) to a set of books selected by ids, a search query, or filter (a bundle name). Preview-first: returns the per-book diff without writing unless preview is set false. A book set is required (never all books). A list in changes replaces the whole list; to add or remove tags while keeping the rest, use tags_add / tags_remove (merged per book, case-insensitive, not together with changes.tags). changes.identifiers merges per book by scheme (listed schemes set, others kept, null removes one). Previews work without writes; applying needs CALIBRE_MCP_ENABLE_WRITE.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"changes":{"additionalProperties":{"anyOf":[{"type":"string"},{"type":"number"},{"items":{"type":"string"},"type":"array"},{"additionalProperties":{"type":["string","null"]},"propertyNames":{"type":"string"},"type":"object"}]},"propertyNames":{"type":"string"},"type":"object"},"filter":{"maxLength":256,"minLength":1,"type":"string"},"ids":{"items":{"anyOf":[{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},{"minLength":1,"type":"string"}]},"type":"array"},"library":{"type":"string"},"preview":{"type":"boolean"},"query":{"type":"string"},"tags_add":{"items":{"type":"string"},"type":"array"},"tags_remove":{"items":{"type":"string"},"type":"array"}},"type":"object"},"name":"calibre_bulk_update","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"applied":{"items":{"type":"number"},"type":"array"},"books":{"items":{"additionalProperties":false,"properties":{"changed":{"items":{"additionalProperties":false,"properties":{"after":{},"before":{},"field":{"type":"string"}},"required":["field","before","after"],"type":"object"},"type":"array"},"id":{"type":"number"},"tagsAdded":{"type":"number"},"tagsRemoved":{"type":"number"},"title":{"type":"string"},"warnings":{"items":{"type":"string"},"type":"array"}},"required":["id","changed"],"type":"object"},"type":"array"},"confirmedByReRead":{"items":{"additionalProperties":false,"properties":{"cause":{"enum":["dropped","timeout"],"type":"string"},"id":{"type":"number"}},"required":["id","cause"],"type":"object"},"type":"array"},"failed":{"items":{"additionalProperties":false,"properties":{"error":{"type":"string"},"id":{"type":"number"}},"required":["id","error"],"type":"object"},"type":"array"},"matched":{"type":"number"},"notAttempted":{"items":{"type":"number"},"type":"array"},"preview":{"type":"boolean"},"retryIds":{"items":{"type":"number"},"type":"array"},"unchanged":{"items":{"type":"number"},"type":"array"},"writeEnabled":{"description":"false on a preview in a session with writes disabled: applying it will be refused (write_disabled)","type":"boolean"}},"type":"object"},"title":"Bulk update book metadata"}
