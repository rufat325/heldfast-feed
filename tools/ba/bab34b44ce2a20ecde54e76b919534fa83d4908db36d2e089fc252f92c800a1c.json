{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "For clients without a journal panel: save the exact reflection the user has reviewed and explicitly confirmed. Never set confirmed from silence or inferred intent. Use compose_entry to prepare a draft; show it to the user, then save only after confirmation. Reuse operationId for retries of the same text. In interactive ChatGPT, prefer the journal panel Save action.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "confirmed": {
    "const": true,
    "type": "boolean"
   },
   "content": {
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "moodContext": {
    "maxLength": 200,
    "type": "string"
   },
   "operationId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 50,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "content",
   "confirmed",
   "operationId"
  ],
  "type": "object"
 },
 "name": "save_entry",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entryId": {
    "type": "string"
   },
   "saved": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "entryId",
   "saved"
  ],
  "type": "object"
 },
 "title": "Save an explicitly reviewed reflection"
}
