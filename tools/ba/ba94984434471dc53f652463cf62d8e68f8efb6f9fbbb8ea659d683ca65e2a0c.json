{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "After the human explicitly agrees to pay, prepare secure checkout for the $299 Preliminary Site Report or $750 Full Site Report. Requires buyer email and site address. Checkout creation is not payment proof or report fulfillment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "maxLength": 500,
    "minLength": 5,
    "type": "string"
   },
   "email": {
    "format": "email",
    "maxLength": 254,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "offer_key": {
    "enum": [
     "site_report_299",
     "site_report_750"
    ],
    "type": "string"
   },
   "request_id": {
    "maxLength": 100,
    "type": "string"
   },
   "user_confirmed_payment": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "user_confirmed_payment",
   "offer_key",
   "email",
   "address"
  ],
  "type": "object"
 },
 "name": "prepare_site_report_checkout",
 "title": "Prepare a human-confirmed AliEV site report checkout"
}
