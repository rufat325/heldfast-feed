{
 "description": "Check if domains are available for registration. Uses DNS + RDAP/WHOIS for accuracy.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domains": {
    "description": "Domain names to check (e.g., ['example.com', 'test.io'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filter": {
    "description": "Filter results: 'available' or 'taken'. Omit for all.",
    "enum": [
     "available",
     "taken"
    ],
    "type": "string"
   }
  },
  "required": [
   "domains"
  ],
  "type": "object"
 },
 "name": "check_domains"
}
