{
 "description": "Run general Anki utility operations: sync, version lookup, package import/export, profile listing, and media storage or retrieval. Use this for cross-cutting maintenance tasks that do not belong to flashcard, deck, model, or study workflows. Import, export, sync, and media writes have external side effects; version and profile reads do not. Select `operation`, then provide the relevant deck name, file path, filename, media payload, URL, or pattern.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "deckName": {
    "description": "Deck name to export",
    "type": "string"
   },
   "filePath": {
    "description": "File path for export/import",
    "type": "string"
   },
   "filename": {
    "description": "Media filename",
    "type": "string"
   },
   "includeSched": {
    "description": "Include scheduling in export",
    "type": "boolean"
   },
   "mediaData": {
    "description": "Base64 encoded media data",
    "type": "string"
   },
   "mediaUrl": {
    "description": "URL to download media from",
    "type": "string"
   },
   "operation": {
    "description": "Anki utility operation",
    "enum": [
     "sync",
     "version",
     "export_deck",
     "import_package",
     "store_media",
     "retrieve_media",
     "delete_media",
     "list_media",
     "get_profiles"
    ],
    "type": "string"
   },
   "pattern": {
    "description": "Pattern to match media files",
    "type": "string"
   }
  },
  "required": [
   "operation"
  ],
  "type": "object"
 },
 "name": "anki_operations"
}
