{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "STRAELO Blockchain Intelligence"
 },
 "description": "Inspect exactly one Base or Ethereum transaction, address, or contract with bounded read-only RPC calls and return deterministic context, observed signals, evidence, coverage, and actionable follow-up.",
 "inputSchema": {
  "properties": {
   "address": {
    "default": null,
    "description": "One EVM address to inspect.",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "title": "Address",
    "type": "string"
   },
   "chain": {
    "description": "EVM network containing the target.",
    "enum": [
     "ethereum",
     "base"
    ],
    "title": "Chain",
    "type": "string"
   },
   "contract_address": {
    "default": null,
    "description": "One EVM contract address to inspect.",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "title": "Contract Address",
    "type": "string"
   },
   "previous_state": {
    "default": null,
    "description": "Optional prior new_state for stateless change detection.",
    "title": "Previous State",
    "type": "object"
   },
   "transaction_hash": {
    "default": null,
    "description": "One transaction hash to inspect.",
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "title": "Transaction Hash",
    "type": "string"
   }
  },
  "required": [
   "chain"
  ],
  "title": "handlerArguments",
  "type": "object"
 },
 "name": "blockchain_intelligence",
 "outputSchema": {
  "properties": {
   "activity": {
    "type": "object"
   },
   "changes": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "classification": {
    "description": "Observed deterministic target classification, not a safety assessment.",
    "type": "string"
   },
   "contract_context": {
    "type": "object"
   },
   "coverage": {
    "description": "Explicitly records the observed RPC scope and unobserved categories.",
    "type": "object"
   },
   "current_state": {
    "type": "object"
   },
   "evidence": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "issues": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "material_changes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "new_state": {
    "type": "object"
   },
   "observed_at": {
    "format": "date-time",
    "type": "string"
   },
   "recommended_actions": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "risk_signals": {
    "description": "Observed signals only; no risk score is assigned.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rpc_calls_used": {
    "maximum": 5,
    "type": "integer"
   },
   "summary": {
    "type": "string"
   },
   "target": {
    "description": "Selected target type and value.",
    "type": "object"
   },
   "value_and_fee": {
    "type": "object"
   }
  },
  "required": [
   "target",
   "classification",
   "summary",
   "activity",
   "value_and_fee",
   "contract_context",
   "risk_signals",
   "issues",
   "evidence",
   "recommended_actions",
   "changes",
   "material_changes",
   "coverage",
   "rpc_calls_used",
   "observed_at",
   "current_state",
   "new_state"
  ],
  "title": "BlockchainIntelligenceOutput",
  "type": "object"
 },
 "title": "STRAELO Blockchain Intelligence"
}
