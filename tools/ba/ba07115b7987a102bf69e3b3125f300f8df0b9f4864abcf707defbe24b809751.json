{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Start here. Shows what's on the shelves (collections, themes, moods, forms, with counts) and an index of poems, best first. Filter by theme, mood, form or collection; page with offset.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collection": {
    "description": "'Singing in the Dark Times' (her 2022 book), 'Noun Poems', 'X' (poems posted on X), or 'new' (saved by hand, incl. commissions). Partial names work.",
    "type": "string"
   },
   "form": {
    "description": "rhymed-metred, rhymed-loose, free-verse, short-form, prose-poem",
    "type": "string"
   },
   "limit": {
    "description": "How many to list (default 40)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "mood": {
    "description": "tender, grieving, furious, playful, awed, defiant, hopeful, uneasy, wry",
    "type": "string"
   },
   "offset": {
    "description": "Skip this many, for paging",
    "minimum": 0,
    "type": "integer"
   },
   "sort": {
    "description": "best (default: her own picks, then the book, then the strongest from X), newest, or book (collection order)",
    "enum": [
     "best",
     "newest",
     "book"
    ],
    "type": "string"
   },
   "theme": {
    "description": "e.g. machines-and-minds, gods-and-spirits, death-and-time, nature-and-animals, love-and-the-body, crypto-and-markets",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_poems",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "offset": {
    "type": "number"
   },
   "poems": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "collection": {
       "type": "string"
      },
      "date": {
       "type": "string"
      },
      "first_line": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "mood": {
       "type": "string"
      },
      "themes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "date",
      "first_line",
      "collection",
      "themes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "shelves": {
    "additionalProperties": false,
    "properties": {
     "collections": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object"
     },
     "forms": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object"
     },
     "moods": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object"
     },
     "themes": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object"
     }
    },
    "required": [
     "collections",
     "themes",
     "moods",
     "forms"
    ],
    "type": "object"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "total",
   "count",
   "offset",
   "shelves",
   "poems"
  ],
  "type": "object"
 },
 "title": "List poems"
}
