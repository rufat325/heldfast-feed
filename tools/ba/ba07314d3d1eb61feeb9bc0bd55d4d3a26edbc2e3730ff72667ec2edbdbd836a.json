{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Planner task in a plan. Optionally set the bucket, due date, priority, assignees, labels, and a description.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assignee_ids": {
    "description": "User IDs to assign (from planner_find_user)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "bucket_id": {
    "description": "Bucket ID (defaults to the plan's default bucket)",
    "type": "string"
   },
   "description": {
    "description": "Task description (notes)",
    "type": "string"
   },
   "due_date": {
    "description": "Due date, ISO format e.g. 2026-07-31",
    "type": "string"
   },
   "labels": {
    "description": "Labels to apply \u2014 the plan's label name, a default color name (e.g. \"Red\"), or a category key (category1\u2013category25); planner_get_plan lists the plan's labels",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "plan_id": {
    "description": "Plan ID",
    "minLength": 1,
    "type": "string"
   },
   "priority": {
    "description": "Task priority",
    "enum": [
     "urgent",
     "important",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "title": {
    "description": "Task title",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "plan_id",
   "title"
  ],
  "type": "object"
 },
 "name": "planner_create_task",
 "title": "Create a Task"
}
