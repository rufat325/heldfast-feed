{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Verify a signed print locally with ECDSA P-256/SHA-256. Legacy valid authenticates only the v1 canonical price fields. Pass the whole print including v2 to authenticate its complete live, archive or daily-close index record; agents using sources, confidence, interval or cadence must require recordValid=true. Live records sign 18 fields; archive records sign 13 without freshness ages, and daily-close records add signed assetId and closeDay. v2.signedFields lists exactly what is authenticated. kind selects the format and is not signed. Added non-null freshness ages invalidate archived verification. verificationScope is full-record only when both signatures and all required fields match, price-only for a valid v1 print without v2, or invalid otherwise. metadataSigned equals recordValid. deltaMs and surrounding metadata remain unsigned. Public keys come from /api/index/v1/pubkey, cached five minutes with refresh at most every 30 seconds. Each supplied kid selects only its exact published key; v1 prints without kid use the bounded ring. No API key is sent to the key endpoint. Invalid verification can mean alteration or a key no longer published.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "anyOf": [
     {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "at": {
    "description": "Timestamp from the print, unchanged",
    "maxLength": 40,
    "minLength": 1,
    "pattern": "^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$",
    "type": "string"
   },
   "cadence": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "band": {
        "anyOf": [
         {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "calculatedAgeMs": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "newestSourceAgeMs": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "oldestSourceAgeMs": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "p50UpdateMs": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "p95UpdateMs": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "closeDay": {
    "anyOf": [
     {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "confidence": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "dispersionBps": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "engine": {
    "anyOf": [
     {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "grade": {
    "maxLength": 20,
    "minLength": 1,
    "pattern": "^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$",
    "type": "string"
   },
   "interval": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "lower": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "upper": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "lower",
       "upper"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "kid": {
    "description": "Signing key identifier, when provided by the API",
    "pattern": "^[A-Za-z0-9._:-]{1,64}$",
    "type": "string"
   },
   "kind": {
    "const": "daily-close",
    "description": "Selects the daily-close record format; this selector is not itself signed",
    "type": "string"
   },
   "price": {
    "anyOf": [
     {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$",
      "type": "string"
     },
     {
      "type": "number"
     }
    ]
   },
   "priceText": {
    "$ref": "#/properties/price/anyOf/0",
    "description": "Exact signed price text, when provided by the API; preserve unchanged"
   },
   "sig": {
    "const": "pulse-index-v1",
    "type": "string"
   },
   "signature": {
    "description": "ECDSA P-256 signature in base64",
    "maxLength": 88,
    "minLength": 88,
    "pattern": "^[A-Za-z0-9+/]{86}==$",
    "type": "string"
   },
   "sources": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "symbol": {
    "description": "Crypto ticker symbol, e.g. BTC, ETH, SOL",
    "maxLength": 20,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9]+$",
    "type": "string"
   },
   "tier": {
    "anyOf": [
     {
      "maxLength": 20,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "v2": {
    "additionalProperties": false,
    "description": "The unchanged v2 block, which signs price and quality fields together",
    "properties": {
     "canonical": {
      "description": "The exact signed string from the print, unchanged",
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
     },
     "kid": {
      "$ref": "#/properties/kid"
     },
     "sig": {
      "const": "pulse-index-v2",
      "type": "string"
     },
     "signature": {
      "maxLength": 88,
      "minLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$",
      "type": "string"
     }
    },
    "required": [
     "sig",
     "canonical",
     "signature",
     "kid"
    ],
    "type": "object"
   }
  },
  "required": [
   "symbol",
   "price",
   "at",
   "grade",
   "signature"
  ],
  "type": "object"
 },
 "name": "verify_print",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checked": {
    "maxLength": 512,
    "type": "string"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "accountUrl": {
      "const": "https://thepulse.markets/developers/access",
      "type": "string"
     },
     "code": {
      "pattern": "^[A-Z][A-Z0-9_]{0,79}$",
      "type": "string"
     },
     "nextAction": {
      "enum": [
       "wait",
       "review_access",
       "check_limits",
       "reconnect",
       "check_input",
       "choose_another_symbol",
       "report_issue"
      ],
      "type": "string"
     },
     "retryAfterSeconds": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "nextAction"
    ],
    "type": "object"
   },
   "keySource": {
    "maxLength": 256,
    "type": "string"
   },
   "metadataSigned": {
    "type": "boolean"
   },
   "recordValid": {
    "description": "Both signatures and every required v2 field verified. Does not prove freshness or settlement suitability.",
    "type": "boolean"
   },
   "requestId": {
    "description": "Identifier for this MCP call; not a signed price field.",
    "format": "uuid",
    "type": "string"
   },
   "v2": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "fieldsMatch": {
        "type": "boolean"
       },
       "mismatches": {
        "items": {
         "maxLength": 80,
         "type": "string"
        },
        "maxItems": 18,
        "type": "array"
       },
       "signatureValid": {
        "type": "boolean"
       },
       "signedFields": {
        "anyOf": [
         {
          "additionalProperties": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "number"
            },
            {
             "type": "boolean"
            },
            {
             "type": "null"
            }
           ]
          },
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "valid": {
        "type": "boolean"
       },
       "verifiedWithKid": {
        "anyOf": [
         {
          "$ref": "#/properties/verifiedWithKid/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "valid",
       "signatureValid",
       "fieldsMatch",
       "mismatches",
       "signedFields",
       "verifiedWithKid"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "valid": {
    "description": "Legacy price-only signature check. Use recordValid for quality metadata.",
    "type": "boolean"
   },
   "verificationScope": {
    "enum": [
     "full-record",
     "price-only",
     "invalid"
    ],
    "type": "string"
   },
   "verifiedWithKid": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z0-9._:-]{1,64}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "requestId"
  ],
  "type": "object"
 },
 "title": "Verify a Signed Print"
}
