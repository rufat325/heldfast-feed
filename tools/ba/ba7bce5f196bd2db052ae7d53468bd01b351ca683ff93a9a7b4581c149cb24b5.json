{
 "description": "List recent generation tasks with optional status filter.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum number of tasks to return",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Filter by task status",
    "enum": [
     "pending",
     "processing",
     "completed",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_tasks"
}
