{
 "description": "Set or view access level on published packages",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "list",
     "get",
     "set",
     "grant",
     "revoke"
    ],
    "type": "string"
   },
   "level": {
    "description": "Access level (for set action)",
    "enum": [
     "public",
     "private",
     "restricted"
    ],
    "type": "string"
   },
   "otp": {
    "description": "One-time password for 2FA",
    "type": "string"
   },
   "package": {
    "description": "Package name",
    "type": "string"
   },
   "permission": {
    "description": "Permission level (for grant action)",
    "enum": [
     "read-only",
     "read-write"
    ],
    "type": "string"
   },
   "team": {
    "description": "Team name in org:team format (for grant/revoke)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "access"
}
