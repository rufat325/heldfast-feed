{
 "description": "Install an APK on the device. Provide the full local path to the APK file.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apkPath": {
    "description": "Local filesystem path to the APK file",
    "type": "string"
   },
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "downgrade": {
    "default": false,
    "description": "Allow version downgrade (-d flag)",
    "type": "boolean"
   },
   "replace": {
    "default": true,
    "description": "Replace existing app (-r flag)",
    "type": "boolean"
   }
  },
  "required": [
   "apkPath"
  ],
  "type": "object"
 },
 "name": "adb_install"
}
