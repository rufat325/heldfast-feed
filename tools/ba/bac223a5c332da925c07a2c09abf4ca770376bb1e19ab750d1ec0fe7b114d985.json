{
 "_meta": {
  "fastmcp": {
   "tags": []
  }
 },
 "description": "Convert decimal degrees to degrees/minutes/seconds, or DMS back to decimal degrees.",
 "inputSchema": {
  "properties": {
   "payload": {
    "properties": {
     "decimal": {
      "anyOf": [
       {
        "maximum": 180,
        "minimum": -180,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Decimal"
     },
     "dms": {
      "anyOf": [
       {
        "properties": {
         "degrees": {
          "maximum": 180,
          "minimum": 0,
          "title": "Degrees",
          "type": "integer"
         },
         "direction": {
          "pattern": "^(N|S|E|W)$",
          "title": "Direction",
          "type": "string"
         },
         "minutes": {
          "maximum": 59,
          "minimum": 0,
          "title": "Minutes",
          "type": "integer"
         },
         "seconds": {
          "exclusiveMaximum": 60,
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
         }
        },
        "required": [
         "degrees",
         "minutes",
         "seconds",
         "direction"
        ],
        "title": "DmsParts",
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     }
    },
    "title": "DmsInput",
    "type": "object"
   }
  },
  "required": [
   "payload"
  ],
  "type": "object"
 },
 "name": "geo_dms",
 "title": "Geo Dms"
}
