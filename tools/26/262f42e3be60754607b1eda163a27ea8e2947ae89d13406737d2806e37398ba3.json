{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Realized PnL curve of a Hyperliquid wallet over time, bucketed (for example hourly or daily).",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "0x-prefixed 20-byte hex address",
    "type": "string"
   },
   "bucket_ms": {
    "description": "Bucket size in ms (e.g. 3600000 for 1h)",
    "type": "number"
   },
   "from": {
    "description": "Unix ms window start",
    "type": "number"
   },
   "to": {
    "description": "Unix ms window end (default now)",
    "type": "number"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_user_pnl_series",
 "outputSchema": {
  "description": "Realized PnL per bucket",
  "properties": {
   "address": {
    "description": "Wallet address (0x\u2026)"
   },
   "bucket": {
    "description": "Bucket size"
   },
   "data": {
    "description": "Buckets",
    "items": {
     "description": "One bucket",
     "properties": {
      "fees_usd": {
       "description": "Fees in USD"
      },
      "realized_pnl": {
       "description": "Realized PnL in USD"
      },
      "ts": {
       "description": "Bucket start, Unix milliseconds"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "from": {
    "description": "Window start, Unix milliseconds"
   },
   "to": {
    "description": "Window end, Unix milliseconds"
   }
  },
  "type": "object"
 }
}
