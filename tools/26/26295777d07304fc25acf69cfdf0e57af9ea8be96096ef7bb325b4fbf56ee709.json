{
 "description": "Tool to query breached accounts and breaches from the Have I Been Pwned API",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account": {
    "description": "Email address to check for breaches",
    "type": "string"
   },
   "domain": {
    "description": "Domain to filter breaches by",
    "type": "string"
   },
   "includeUnverified": {
    "description": "Whether to include unverified breaches",
    "type": "boolean"
   },
   "name": {
    "description": "Breach name to get details for",
    "type": "string"
   },
   "operation": {
    "description": "The HIBP operation to perform",
    "enum": [
     "getAllBreachesForAccount",
     "getAllBreachedSites",
     "getBreachByName",
     "getDataClasses"
    ],
    "type": "string"
   },
   "truncateResponse": {
    "description": "Whether to truncate the response",
    "type": "boolean"
   }
  },
  "required": [
   "operation"
  ],
  "type": "object"
 },
 "name": "HIBP-Breaches"
}
