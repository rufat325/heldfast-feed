    "minimum": 1,
    "type": "integer"
   },
   "reason": {
    "description": "Why they are suppressed",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "suppression",
 "title": "Bounce shield suppression list"
}
