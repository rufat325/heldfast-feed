    "type": "boolean"
   },
   "host": {
    "type": "string"
   },
   "https": {
    "type": "boolean"
   },
   "loggedIn": {
    "type": "boolean"
   },
   "name": {
    "type": "string"
   },
   "port": {
    "type": "number"
   },
   "protected": {
    "type": "boolean"
   },
   "readonly": {
    "type": "boolean"
   },
   "user": {
    "type": "string"
   },
   "writesUnlocked": {
    "type": "boolean"
   }
  },
  "required": [
   "name",
