{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Delete a tutorial"
 },
 "description": "Use this when someone wants a tutorial permanently deleted. Returns the deleted tutorial id; its videos and voiceover lines stay and each needs its own delete. Deleting it again changes nothing. Not for removing one language or device version.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "tutorialId": {
    "description": "Tutorial to delete",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "tutorialId"
  ],
  "type": "object"
 },
 "name": "delete_tutorial",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "const": "deleted",
    "type": "string"
   },
   "tutorialId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "status",
   "tutorialId"
  ],
  "type": "object"
 },
 "title": "Delete a tutorial"
}
