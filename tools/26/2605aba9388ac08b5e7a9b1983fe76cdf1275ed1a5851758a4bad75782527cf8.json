{
 "_meta": {
  "lovie/risk": "high",
  "openai/toolInvocation/invoked": "Removed",
  "openai/toolInvocation/invoking": "Removing\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false
 },
 "description": "Collects and saves EIN (SS-4) filing information after the company is filed with the state. First ask whether the user has an SSN or ITIN; if they do not, set no_ssn and skip it \u2014 the EIN then takes ~45 business days via paper filing. Collect the remaining fields conversationally: date of birth, employee counts, first wages date, closing month of the accounting year, reason for applying, any prior EIN, and principal business activity.",
 "inputSchema": {
  "properties": {
   "formationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "info": {
    "properties": {
     "appliedForEinBefore": {
      "type": "boolean"
     },
     "closingMonth": {
      "maximum": 12,
      "minimum": 1,
      "type": "integer"
     },
     "dateOfBirth": {
      "maxLength": 10,
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
      "type": "string"
     },
     "employeesAgricultural": {
      "minimum": 0,
      "type": "integer"
     },
     "employeesHousehold": {
      "minimum": 0,
      "type": "integer"
     },
     "employeesOther": {
      "minimum": 0,
      "type": "integer"
     },
     "firstWagesDate": {
      "maxLength": 10,
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
      "type": "string"
     },
     "previousEin": {
      "maxLength": 20,
      "type": "string"
     },
     "principalActivity": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
     },
     "reasonForApplying": {
      "enum": [
       "EIN_REASON_FOR_APPLYING_STARTED_NEW_BUSINESS",
       "EIN_REASON_FOR_APPLYING_HIRED_EMPLOYEES",
       "EIN_REASON_FOR_APPLYING_BANKING_PURPOSE",
       "EIN_REASON_FOR_APPLYING_CHANGED_ORGANIZATION_TYPE",
       "EIN_REASON_FOR_APPLYING_PURCHASED_GOING_BUSINESS",
       "EIN_REASON_FOR_APPLYING_CREATED_A_TRUST",
       "EIN_REASON_FOR_APPLYING_CREATED_A_PENSION_PLAN",
       "EIN_REASON_FOR_APPLYING_COMPLIANCE",
       "EIN_REASON_FOR_APPLYING_OTHER"
      ],
      "type": "string"
     },
     "submittedAt": {
      "format": "date-time",
      "type": "string"
     },
     "submittedVia": {
      "enum": [
       "EIN_SUBMITTED_VIA_UNSPECIFIED",
       "EIN_SUBMITTED_VIA_DASHBOARD",
       "EIN_SUBMITTED_VIA_MCP"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "noSsn": {
    "type": "boolean"
   },
   "ssnItin": {
    "maxLength": 11,
    "pattern": "^([0-9]{3}-?[0-9]{2}-?[0-9]{4})?$",
    "type": "string"
   }
  },
  "required": [
   "formationId",
   "info"
  ],
  "type": "object"
 },
 "name": "formation_submit_ein_filing_info",
 "outputSchema": {
  "properties": {
   "formationId": {
    "anyOf": [
     {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "hasSsn": {
    "type": "boolean"
   },
   "submittedAt": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "title": "Submit EIN Filing Info"
}
