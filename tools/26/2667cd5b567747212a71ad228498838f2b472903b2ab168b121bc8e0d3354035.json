{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Support Ticket"
 },
 "description": "Create a new support ticket. ALWAYS ask for confirmation before writing.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Ticket category",
    "enum": [
     "bug",
     "billing",
     "shipping/labels",
     "account",
     "integration",
     "other"
    ],
    "type": "string"
   },
   "confirm": {
    "description": "Set to true to commit, false for dry-run preview",
    "type": "boolean"
   },
   "description": {
    "description": "Detailed explanation of the issue (max 5000 chars)",
    "type": "string"
   },
   "farmId": {
    "description": "The unique farm ID",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Unique request idempotency key",
    "type": "string"
   },
   "priority": {
    "description": "Low, Normal, or High priority",
    "enum": [
     "low",
     "normal",
     "high"
    ],
    "type": "string"
   },
   "relatedRecordId": {
    "description": "Optional related order or record ID",
    "type": "string"
   },
   "subject": {
    "description": "The subject of the support ticket (max 200 chars)",
    "type": "string"
   }
  },
  "required": [
   "farmId",
   "subject",
   "description",
   "category",
   "priority"
  ],
  "type": "object"
 },
 "name": "create_support_ticket"
}
