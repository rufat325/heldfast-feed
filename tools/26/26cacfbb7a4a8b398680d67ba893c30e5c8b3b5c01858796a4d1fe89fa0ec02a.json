{"description":"Patch an ES connection by name in the layer it lives in (project or global). Set a field to null to remove it (e.g. \"ssh\": null); an ssh object is merged field by field, e.g. { \"ssh\": { \"hostKey\": \"SHA256:...\" } }. queryTimeoutMs sets the per-request deadline (null restores the 60 s default).","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"name":{"type":"string"},"patch":{"additionalProperties":false,"properties":{"apiKey":{"anyOf":[{"minLength":1,"type":"string"},{"type":"null"}]},"host":{"minLength":1,"type":"string"},"name":{"pattern":"^[a-zA-Z0-9_-]+$","type":"string"},"password":{"type":["string","null"]},"port":{"anyOf":[{"exclusiveMinimum":0,"type":"integer"},{"type":"null"}]},"queryTimeoutMs":{"anyOf":[{"exclusiveMinimum":0,"maximum":2147483647,"type":"integer"},{"type":"null"}]},"readonly":{"type":"boolean"},"scheme":{"enum":["http","https"],"type":"string"},"ssh":{"anyOf":[{"additionalProperties":false,"properties":{"agent":{"type":["boolean","null"]},"host":{"minLength":1,"type":"string"},"hostKey":{"anyOf":[{"pattern":"^SHA256:[A-Za-z0-9+/]+={0,2}$","type":"string"},{"type":"null"}]},"passphrase":{"type":["string","null"]},"password":{"type":["string","null"]},"port":{"exclusiveMinimum":0,"type":"integer"},"privateKey":{"type":["string","null"]},"privateKeyPath":{"type":["string","null"]},"user":{"minLength":1,"type":"string"}},"type":"object"},{"type":"null"}]},"user":{"anyOf":[{"minLength":1,"type":"string"},{"type":"null"}]},"verifyTls":{"type":"boolean"}},"type":"object"}},"required":["name","patch"],"type":"object"},"name":"update_connection"}
