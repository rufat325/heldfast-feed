{"annotations":{"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"Match old URLs to new ones from two complete inventories. Migrations up to 500 old URLs run free (one free run a day, five in total per account). Otherwise the answer is payment_required with the one-time price ($1 per 50 old URLs, $10 minimum) and a checkout link that only a person can complete; after paying, retry with the same input and key. A queued run finishes in minutes: poll get_migration after retry_after_seconds. confirmed_pairs must be pairs a person confirmed, never guesses.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"confirmed_pairs":{"items":{"properties":{"new_url":{"maxLength":8192,"type":"string"},"old_url":{"maxLength":8192,"type":"string"}},"required":["old_url","new_url"],"type":"object"},"maxItems":100,"type":"array"},"idempotency_key":{"description":"Unique per intended change; retry an uncertain call with the identical input and key.","maxLength":200,"minLength":1,"pattern":"^[^\\x00-\\x1f\\x7f]+$","type":"string"},"migration_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"new_inventory_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"old_inventory_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"}},"required":["migration_id","old_inventory_id","new_inventory_id","idempotency_key"],"type":"object"},"name":"run_migration","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"contract_version":{"type":"string"},"data":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"error":{"anyOf":[{"additionalProperties":false,"properties":{"code":{"type":"string"},"message":{"type":"string"},"next_action":{"type":"string"},"retryable":{"type":"boolean"}},"required":["code","message","retryable","next_action"],"type":"object"},{"type":"null"}]},"migration_id":{"type":["string","null"]},"next_action":{"type":"string"},"operation_id":{"type":["string","null"]},"retry_after_seconds":{"type":"number"},"status":{"type":"string"}},"required":["contract_version","migration_id","operation_id","status","next_action","data","error"],"type":"object"},"title":"Run a migration"}
