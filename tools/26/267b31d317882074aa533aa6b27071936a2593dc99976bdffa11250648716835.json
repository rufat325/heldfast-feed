{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List this account's app backups and restores, newest first \u2014 id, kind, status, chunk count, size, and any error. This is how you check whether a backup or restore started with impreza_backup_app / impreza_restore_app has finished. A `replaced_path` on a restore means the data it displaced is STILL on the server using disk, until impreza_discard_replaced removes it. Filter to one app with deployment_id. Not to be confused with impreza_vps_list_backups, which is backups of a whole VPS.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "Optional \u2014 only this app's jobs.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "impreza_list_backups",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "backups": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "backup_id": {
         "type": "string"
        },
        "bucket": {
         "type": "string"
        },
        "chunks": {
         "type": "integer"
        },
        "completed_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "created_at": {
         "type": "string"
        },
        "deployment_id": {
         "type": "string"
        },
        "error": {
         "type": [
          "string",
          "null"
         ]
        },
        "kind": {
         "type": "string"
        },
        "prefix": {
         "type": "string"
        },
        "replaced_path": {
         "type": [
          "string",
          "null"
         ]
        },
        "source_backup_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "type": "string"
        },
        "total_bytes": {
         "type": "integer"
        }
       },
       "required": [
        "backup_id",
        "kind",
        "deployment_id",
        "status",
        "bucket",
        "prefix",
        "chunks",
        "total_bytes",
        "source_backup_id",
        "replaced_path",
        "error",
        "created_at",
        "completed_at"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "schedule": {
      "type": "object"
     },
     "storage": {
      "type": "object"
     }
    },
    "required": [
     "backups"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "List app backups"
}
