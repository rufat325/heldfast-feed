{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the DayZ item database (vanilla game files, about 5,000 classes) by name in any language or by class name, optionally filtered by category or loot tier. Returns class names, weight, inventory size and loot tiers. Use get_item for the full record of one item and compare_weapons for damage to players.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "enum": [
     "World Static",
     "Misc",
     "Building",
     "Character / Bones",
     "Headgear",
     "Vehicle",
     "Zombie",
     "Top",
     "Weapon",
     "Magazine",
     "Food / Drink",
     "Ammo",
     "Pants",
     "Footwear",
     "Backpack",
     "Tool",
     "Attachment",
     "Container",
     "Gloves",
     "Animal",
     "Vest",
     "Optic",
     "Medical",
     "Ammo Box",
     "Base Building",
     "Suppressor",
     "Trap / Snare",
     "Vehicle Part"
    ],
    "type": "string"
   },
   "include_mods": {
    "default": false,
    "description": "Also list Namalsk mod items",
    "type": "boolean"
   },
   "lang": {
    "default": "en",
    "description": "Language for names, descriptions and links",
    "enum": [
     "en",
     "de",
     "fr",
     "es",
     "it",
     "ru",
     "pl",
     "cs",
     "pt",
     "zh"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Name or class name, e.g. 'akm', 'Verband', 'bandage'",
    "maxLength": 100,
    "type": "string"
   },
   "sort": {
    "default": "name",
    "description": "name = best match first when a query is given; damage = ammo hit value; rpm = full-auto rate of fire",
    "enum": [
     "name",
     "weight",
     "damage",
     "rpm"
    ],
    "type": "string"
   },
   "tier": {
    "description": "Only items that spawn in this loot tier",
    "enum": [
     "Tier1",
     "Tier2",
     "Tier3",
     "Tier4",
     "Unique"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_items",
 "title": "Search DayZ items"
}
