{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The signed-in student's current and final scores in every ELMS (Canvas) course they are enrolled in, or in one course. Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "course_id": {
    "description": "Only this course (default: all enrollments)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "elms_get_grades",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "enrollments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "course_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "grades": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "current_grade": {
           "description": "Letter grade for current_score, if the course has a grading scheme",
           "type": [
            "string",
            "null"
           ]
          },
          "current_score": {
           "description": "Percentage score on graded work so far",
           "type": [
            "number",
            "null"
           ]
          },
          "final_grade": {
           "type": [
            "string",
            "null"
           ]
          },
          "final_score": {
           "description": "Percentage score counting ungraded work as zero",
           "type": [
            "number",
            "null"
           ]
          }
         },
         "required": [
          "current_score",
          "current_grade",
          "final_score",
          "final_grade"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "last_activity_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      },
      "state": {
       "enum": [
        "active",
        "invited",
        "creation_pending",
        "deleted",
        "rejected",
        "completed",
        "inactive"
       ],
       "type": "string"
      },
      "total_activity_time": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Seconds spent in the course"
      },
      "type": {
       "enum": [
        "student",
        "teacher",
        "ta",
        "observer",
        "designer"
       ],
       "type": "string"
      }
     },
     "required": [
      "course_id",
      "type",
      "state",
      "grades",
      "last_activity_at",
      "total_activity_time"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "enrollments"
  ],
  "type": "object"
 },
 "title": "Get ELMS grades"
}
