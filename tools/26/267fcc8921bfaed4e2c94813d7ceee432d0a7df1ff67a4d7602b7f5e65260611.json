{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Start, stop, restart, or build a Node.js application. Two-phase commit: first call returns a plan + token, second call (with the token + same args) applies. `stop` causes downtime until next start. `build` triggers a build job and returns its log_stream so you can tail the output. Manager-private.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "`start`  \u2014 start a Stopped app; `stop`   \u2014 stop a Running app (causes downtime until next start/restart!); `restart` \u2014 gracefully restart the app (a few seconds of downtime); `build`  \u2014 trigger a build job (runs `build_command` + relaunches the app); returns a `resource_id` + log_stream",
    "enum": [
     "start",
     "stop",
     "restart",
     "build"
    ],
    "type": "string"
   },
   "confirmation_token": {
    "description": "Token from the prior plan response. Required on the apply phase.",
    "format": "uuid",
    "type": "string"
   },
   "site_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "vhost_route_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "site_id",
   "vhost_route_id",
   "action"
  ],
  "type": "object"
 },
 "name": "infomaniak_nodejs_app_action",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "action": {
        "type": "string"
       },
       "app_fqdn": {
        "type": "string"
       },
       "app_status_before": {
        "type": "string"
       },
       "site_id": {
        "type": "number"
       },
       "vhost_route_id": {
        "type": "number"
       }
      },
      "required": [
       "site_id",
       "vhost_route_id",
       "action"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "action": {
      "type": "string"
     },
     "log_stream": {
      "additionalProperties": false,
      "description": "Only for `build` \u2014 credentials to tail the build output live.",
      "properties": {
       "endpoint": {
        "type": "string"
       },
       "jwt_token": {
        "type": "string"
       }
      },
      "required": [
       "endpoint",
       "jwt_token"
      ],
      "type": "object"
     },
     "resource_id": {
      "description": "Only for `build` \u2014 id of the spawned build job, also used as log stream id.",
      "type": "string"
     },
     "result_status": {
      "description": "Status after the action (e.g. \"Running\", \"Stopped\").",
      "type": "string"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "action",
     "result_status"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
