{
 "description": "Score the personality test and save it on the logged-in member. access_token comes from login. answers is 70 letters a or b in question order, or objects {id, answer}. A new result can be saved 30 days after the previous one. Returns personality_code, personality_name, characteristics, strengths, weaknesses, saved, and result_id.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "access_token": {
    "minLength": 1,
    "type": "string"
   },
   "answers": {
    "items": {
     "anyOf": [
      {
       "enum": [
        "a",
        "b"
       ],
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "answer": {
         "enum": [
          "a",
          "b"
         ],
         "type": "string"
        },
        "id": {
         "type": "integer"
        }
       },
       "required": [
        "id",
        "answer"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "mood": {
    "default": "hap",
    "enum": [
     "ang",
     "plea",
     "love",
     "naug",
     "hap",
     "sadd"
    ],
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "answers"
  ],
  "type": "object"
 },
 "name": "score_personality_test"
}
