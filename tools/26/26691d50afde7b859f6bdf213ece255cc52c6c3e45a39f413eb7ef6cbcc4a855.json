{
 "description": "Bake multiple quality tiers (default: high / medium / low) of a single source GLB and emit a sidecar spatialpack.lod.json manifest pointing at them. The runtime picks the largest tier whose recommendedMinPixelHeight \u2264 the projected screen height.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "input_path": {
    "minLength": 1,
    "type": "string"
   },
   "out_dir": {
    "description": "Directory (created if missing) for tier GLBs + manifest.",
    "minLength": 1,
    "type": "string"
   },
   "tiers": {
    "description": "Custom tier ladder (default: 3-tier high/medium/low).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "decimate_ratio": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "preset": {
       "enum": [
        "web-mobile",
        "web-desktop",
        "quality-max"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "preset"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "input_path",
   "out_dir"
  ],
  "type": "object"
 },
 "name": "lod_bundle",
 "title": "Build a multi-tier LOD bundle"
}
