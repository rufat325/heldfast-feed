{
 "description": "Record compact model token usage for value proof. Use when the harness exposes provider/model token counts. Do not send raw prompts, completions, tool logs, secrets, or customer content.",
 "inputSchema": {
  "properties": {
   "action_type": {
    "type": "string"
   },
   "agent_id": {
    "maxLength": 160,
    "type": "string"
   },
   "baseline_tokens": {
    "minimum": 0,
    "type": "integer"
   },
   "baseline_usage_id": {
    "maxLength": 160,
    "type": "string"
   },
   "billing_host": {
    "maxLength": 160,
    "type": "string"
   },
   "billing_mode": {
    "enum": [
     "api",
     "subscription"
    ],
    "type": "string"
   },
   "cache_write_tokens": {
    "minimum": 0,
    "type": "integer"
   },
   "cached_tokens": {
    "type": "number"
   },
   "comparison_id": {
    "maxLength": 160,
    "type": "string"
   },
   "constraints_fingerprint": {
    "maxLength": 160,
    "type": "string"
   },
   "cost_source": {
    "enum": [
     "provider_response"
    ],
    "type": "string"
   },
   "cost_usd": {
    "type": "number"
   },
   "coverage_complete": {
    "type": "boolean"
   },
   "decision_id": {
    "type": "string"
   },
   "estimated_cost_saved_usd": {
    "type": "number"
   },
   "estimated_minutes_saved": {
    "type": "number"
   },
   "estimated_tokens_saved": {
    "type": "number"
   },
   "input_tokens": {
    "type": "number"
   },
   "latency_ms": {
    "type": "number"
   },
   "marrow_intervention": {
    "description": "runtime_gate, risk_gate, prior_lesson, proof_pack, before_you_act, fleet_lesson, or other compact reason.",
    "type": "string"
   },
   "model": {
    "description": "Model name.",
    "type": "string"
   },
   "occurred_at": {
    "format": "date-time",
    "maxLength": 40,
    "type": "string"
   },
   "output_tokens": {
    "type": "number"
   },
   "overhead_complete": {
    "type": "boolean"
   },
   "pricing_dimensions": {
    "additionalProperties": {
     "anyOf": [
      {
       "maxLength": 80,
       "type": "string"
      },
      {
       "minimum": 0,
       "type": "number"
      }
     ]
    },
    "maxProperties": 16,
    "type": "object"
   },
   "provider": {
    "description": "Model provider, e.g. openai, anthropic, google, xai, qwen, deepseek.",
    "type": "string"
   },
   "session_id": {
    "maxLength": 160,
    "type": "string"
   },
   "source": {
    "maxLength": 160,
    "type": "string"
   },
   "success": {
    "type": "boolean"
   },
   "task_fingerprint": {
    "maxLength": 160,
    "type": "string"
   },
   "task_type": {
    "type": "string"
   },
   "token_semantics": {
    "enum": [
     "input_includes_cache",
     "disjoint"
    ],
    "type": "string"
   },
   "total_tokens": {
    "type": "number"
   },
   "usage_event_id": {
    "maxLength": 160,
    "type": "string"
   },
   "usage_kind": {
    "enum": [
     "delta",
     "cumulative"
    ],
    "type": "string"
   },
   "usage_role": {
    "enum": [
     "task",
     "marrow_overhead"
    ],
    "type": "string"
   },
   "workflow_id": {
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "marrow_model_usage"
}
