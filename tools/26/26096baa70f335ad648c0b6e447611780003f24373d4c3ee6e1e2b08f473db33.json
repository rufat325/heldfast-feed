{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create Video Batch"
 },
 "description": "Launch up to 20 video generations in parallel. Pre-checks total token cost. Returns individual video IDs for polling.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "callbackUrl": {
    "description": "Webhook URL for completion notifications",
    "format": "uri",
    "type": "string"
   },
   "videos": {
    "description": "Array of video creation requests (1-20)",
    "items": {
     "properties": {
      "avatarPresetId": {
       "type": "string"
      },
      "captionStyle": {
       "enum": [
        "classic",
        "bold-impact",
        "karaoke",
        "pop",
        "bounce",
        "neon",
        "typewriter",
        "glow"
       ],
       "type": "string"
      },
      "ctaStyle": {
       "enum": [
        "classic",
        "blurred-photo",
        "dark-solid"
       ],
       "type": "string"
      },
      "duration": {
       "maximum": 60,
       "minimum": 10,
       "type": "integer"
      },
      "imagePromptHint": {
       "maxLength": 400,
       "type": "string"
      },
      "imageStyle": {
       "enum": [
        "warm-golden",
        "bright-neutral",
        "cool-diffused",
        "window-light",
        "earthy-ambient",
        "studio-clean",
        "moody-dramatic",
        "pastel-soft",
        "nordic-minimal",
        "sunset-warm"
       ],
       "type": "string"
      },
      "language": {
       "default": "en",
       "type": "string"
      },
      "musicPromptHint": {
       "maxLength": 400,
       "type": "string"
      },
      "musicStyle": {
       "enum": [
        "energetic",
        "friendly",
        "professional",
        "luxury",
        "funny",
        "cinematic",
        "lo-fi",
        "hip-hop",
        "acoustic"
       ],
       "type": "string"
      },
      "productDescription": {
       "type": "string"
      },
      "productImages": {
       "items": {
        "format": "uri",
        "type": "string"
       },
       "type": "array"
      },
      "productTitle": {
       "type": "string"
      },
      "productUrl": {
       "format": "uri",
       "type": "string"
      },
      "templateId": {
       "type": "string"
      },
      "tone": {
       "default": "professional",
       "enum": [
        "energetic",
        "professional",
        "friendly",
        "luxury",
        "funny"
       ],
       "type": "string"
      },
      "videoPromptHint": {
       "maxLength": 400,
       "type": "string"
      },
      "voiceId": {
       "type": "string"
      }
     },
     "required": [
      "templateId"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "videos"
  ],
  "type": "object"
 },
 "name": "create_video_batch"
}
