{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update key"
 },
 "description": "Update an existing key. Supported fields depend on the key type: all key types accept 'description'; OAuth clients and federated identities additionally accept 'scopes' and 'tags'; federated identities additionally accept 'issuer', 'subject', 'audience', and 'customClaimRules'. For auth keys, pass only 'description' \u2014 the Tailscale API will reject other fields.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "audience": {
    "description": "(federated only) Updated audience claim",
    "type": "string"
   },
   "customClaimRules": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "(federated only) Updated custom claim rules",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "description": {
    "description": "Updated description (max 50 chars, alphanumeric/hyphens/spaces)",
    "type": "string"
   },
   "issuer": {
    "description": "(federated only) Updated OIDC issuer URL",
    "type": "string"
   },
   "keyId": {
    "description": "The key ID to update",
    "type": "string"
   },
   "scopes": {
    "description": "(client/federated) Updated OAuth scopes",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "subject": {
    "description": "(federated only) Updated subject claim pattern",
    "type": "string"
   },
   "tags": {
    "description": "Updated ACL tags (must start with 'tag:')",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "keyId"
  ],
  "type": "object"
 },
 "name": "tailscale_update_key",
 "title": "Update key"
}
