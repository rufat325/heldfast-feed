{
 "description": "List JSON APIs the page has called. Captured automatically from XHR/fetch traffic. Classifies into: data, tracking, auth, cdn, ads.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "data",
     "tracking",
     "auth",
     "cdn",
     "ads"
    ],
    "type": "string"
   },
   "minConfidence": {
    "description": "Minimum classification confidence (0-1). Default: 0.",
    "type": "number"
   },
   "sessionId": {
    "type": "string"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "api_discover",
 "title": "Discover Page APIs"
}
