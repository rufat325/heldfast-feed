{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Delete stored in-memory chat history for a `conversation_id`. Use this when you want to keep the same ID but start a fresh thread. This only affects server-side memory in the current MCP process.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "conversation_id": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "conversation_id"
  ],
  "type": "object"
 },
 "name": "reset_conversation",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "conversation_id": {
    "type": "string"
   },
   "error_type": {
    "enum": [
     "deepseek_api_error",
     "tool_execution_error"
    ],
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "removed": {
    "type": "boolean"
   },
   "retryable": {
    "type": "boolean"
   },
   "status": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "suggestion": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
