{
 "_meta": {
  "openai/toolInvocation/invoked": "Add audio clip complete.",
  "openai/toolInvocation/invoking": "Add audio clip\u2026",
  "ui": {
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Place an audio file on a track. Pass a data URL for bundled audio or a source URL for a remotely hosted file.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dataUrl": {
    "pattern": "^data\\:audio\\/",
    "type": "string"
   },
   "gain": {
    "default": 1,
    "maximum": 4,
    "minimum": 0,
    "type": "number"
   },
   "lengthSteps": {
    "maximum": 4096,
    "minimum": 1,
    "type": "integer"
   },
   "mimeType": {
    "default": "audio/wav",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "sourceUrl": {
    "format": "uri",
    "type": "string"
   },
   "startStep": {
    "minimum": 0,
    "type": "integer"
   },
   "trackId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "trackId",
   "name",
   "startStep",
   "lengthSteps"
  ],
  "type": "object"
 },
 "name": "add_audio_clip",
 "title": "Add audio clip"
}
