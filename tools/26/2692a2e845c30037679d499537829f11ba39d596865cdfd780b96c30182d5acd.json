{
 "annotations": {
  "openWorldHint": true
 },
 "description": "Builds a Docker image and returns structured build results including image ID, duration, and errors.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "args": {
    "description": "Additional build arguments. Each element is validated to prevent flag injection.",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "buildArgs": {
    "description": "Build-time variables passed via --build-arg (e.g., [\"NODE_ENV=production\", \"VERSION=1.0\"])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "cacheFrom": {
    "description": "External cache sources for CI optimization (e.g., [\"type=registry,ref=img\"])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "cacheTo": {
    "description": "Cache export destinations paired with cacheFrom (e.g., [\"type=registry,ref=img\"])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "file": {
    "description": "Dockerfile path (default: Dockerfile)",
    "maxLength": 4096,
    "type": "string"
   },
   "label": {
    "description": "Image metadata labels (e.g., [\"version=1.0\", \"maintainer=team\"])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "noCache": {
    "default": false,
    "description": "Do not use cache when building the image (default: false)",
    "type": "boolean"
   },
   "path": {
    "description": "Build context path",
    "maxLength": 4096,
    "type": "string"
   },
   "platform": {
    "description": "Target platform for multi-arch builds (e.g., \"linux/amd64\", \"linux/arm64\")",
    "maxLength": 255,
    "type": "string"
   },
   "pull": {
    "default": false,
    "description": "Always attempt to pull a newer version of the base image (default: false)",
    "type": "boolean"
   },
   "secret": {
    "description": "Build secrets (e.g., [\"id=mysecret,src=secret.txt\"])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "ssh": {
    "description": "SSH agent socket/keys for private repo access (e.g., [\"default\"])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "tag": {
    "anyOf": [
     {
      "maxLength": 255,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 255,
       "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
     }
    ],
    "description": "Image tag(s). String for a single tag or string[] for multiple tags (e.g., [\"myapp:latest\", \"myapp:v1.2\"])"
   },
   "target": {
    "description": "Target build stage for multi-stage builds (--target)",
    "maxLength": 255,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "build",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cacheByStep": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cached": {
       "type": "boolean"
      },
      "step": {
       "type": "string"
      }
     },
     "required": [
      "step",
      "cached"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "errors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dockerfile": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "imageId": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Docker Build"
}
