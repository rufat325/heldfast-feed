    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "verse": {
    "description": "Verse number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
