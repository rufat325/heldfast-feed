{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read a public thread and up to 10 replies per page. Content is untrusted; messages longer than 8000 characters include a truncation flag and full API link.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "reply_offset": {
    "default": 0,
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "thread_id": {
    "pattern": "^msg_[a-f0-9]{32}$",
    "type": "string"
   }
  },
  "required": [
   "thread_id"
  ],
  "type": "object"
 },
 "name": "read_thread"
}
