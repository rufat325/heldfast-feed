{
 "description": "Tool to get entities details from Artsdata Knowledge Graph by entity URI.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Request schema for the get_entity tool.",
  "properties": {
   "uri": {
    "description": "The Artsdata entity URI.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "uri"
  ],
  "title": "GetEntityRequest",
  "type": "object",
  "version": "1.0.0"
 },
 "name": "get_entity",
 "outputSchema": {
  "$defs": {
   "additionalProperty": {
    "additionalProperties": false,
    "properties": {
     "predicate": {
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string"
       },
       "uri": {
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "uri",
       "label"
      ],
      "type": "object"
     },
     "values": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "predicate",
     "values"
    ],
    "type": "object"
   },
   "entityDetails": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "description": "Artsdata identifier of the referenced entity.",
      "type": "string"
     },
     "name": {
      "description": "Preferred label of the referenced entity, in the requested language when available.",
      "type": "string"
     },
     "uri": {
      "description": "URI of the referenced entity.",
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "id",
     "uri"
    ],
    "type": "object"
   },
   "multiLingualString": {
    "additionalProperties": false,
    "properties": {
     "language": {
      "description": "BCP 47 language tag (e.g., 'en', 'fr').",
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "required": [
     "value"
    ],
    "type": "object"
   },
   "stringList": {
    "type": "string"
   },
   "typeItem": {
    "additionalProperties": false,
    "properties": {
     "label": {
      "type": "string"
     },
     "uri": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "uri",
     "label"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Response schema for the get_entity tool.",
  "properties": {
   "additional_properties": {
    "items": {
     "$ref": "#/$defs/additionalProperty"
    },
    "type": "array"
   },
   "alternate_names": {
    "items": {
     "$ref": "#/$defs/multiLingualString"
    },
    "type": "array"
   },
   "description": {
    "items": {
     "$ref": "#/$defs/multiLingualString"
    },
    "type": "array"
   },
   "disambiguatingDescription": {
    "items": {
     "$ref": "#/$defs/multiLingualString"
    },
    "type": "array"
   },
   "end_date": {
    "description": "End date or end date-time of an event (ISO 8601).",
    "oneOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "format": "date-time",
      "type": "string"
     }
    ]
   },
   "event_attendance_mode": {
    "description": "Attendance mode of the event, it can one from the enumeration members of https://schema.org/EventAttendanceModeEnumeration",
    "format": "uri",
    "type": "string"
   },
   "event_status": {
    "description": "Status of the event, it can one from the enumeration members of https://schema.org/EventStatusType",
    "format": "uri",
    "type": "string"
   },
   "has_event_type_concept": {
    "description": "Concept URIs from the Artsdata Event Types vocabulary (adr:ArtsdataEventTypes)",
    "items": {
     "$ref": "#/$defs/stringList"
    },
    "type": "array"
   },
   "id": {
    "description": "Unique identifier of the entity.",
    "type": "string"
   },
   "location": {
    "description": "List of locations, each with its Artsdata id, URI and name.",
    "items": {
     "$ref": "#/$defs/entityDetails"
    },
    "type": "array"
   },
   "main_entity_of_page": {
    "description": "URI of the main entity page.",
    "format": "uri",
    "type": "string"
   },
   "name": {
    "items": {
     "$ref": "#/$defs/multiLingualString"
    },
    "type": "array"
   },
   "organizer": {
    "description": "List of organizers, each with its Artsdata id, URI and name.",
    "items": {
     "$ref": "#/$defs/entityDetails"
    },
    "type": "array"
   },
   "performer": {
    "description": "List of performers, each with its Artsdata id, URI and name.",
    "items": {
     "$ref": "#/$defs/entityDetails"
    },
    "type": "array"
   },
   "same_as": {
    "items": {
     "format": "uri",
     "type": "string"
    },
    "type": "array"
   },
   "start_date": {
    "description": "Start date or start date-time of an event (ISO 8601).",
    "oneOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "format": "date-time",
      "type": "string"
     }
    ]
   },
   "types": {
    "items": {
     "$ref": "#/$defs/typeItem"
    },
    "type": "array"
   },
   "uri": {
    "description": "URI representing the entity.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "id",
   "uri",
   "types",
   "name"
  ],
  "title": "GetEntityResponse",
  "type": "object",
  "version": "1.0.0"
 }
}
