{
 "description": "Get a single page by ID (content, when requested, is the raw stored markup)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "default": false,
    "description": "Include the full content (raw block markup, safe to edit and send back)",
    "type": "boolean"
   },
   "id": {
    "description": "Page ID",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "id"
  ],
  "type": "object"
 },
 "name": "wp_get_page"
}
