    "type": "string"
   },
   "exclude_news": {
    "default": false,
    "description": "Drop channels whose category is \"\u0218tiri\" (Romanian news channels)",
    "type": "boolean"
   },
   "limit": {
    "default": 15,
    "description": "Max number of items to return",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "scope": {
    "default": "main",
    "description": "main = the main Romanian channels (PRO TV, Antena 1, Kanal D, TVR 1/2, Digi 24, etc.); all = every channel in the guide (the live count is in tv_tonight_card stats.channelsMonitored)",
    "enum": [
     "main",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
