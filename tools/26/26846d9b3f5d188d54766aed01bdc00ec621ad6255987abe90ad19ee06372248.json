{
 "description": "Send a message to a lead via a specified channel (email, linkedin, whatsapp).",
 "inputSchema": {
  "properties": {
   "body": {
    "description": "Message body / content",
    "type": "string"
   },
   "channel": {
    "description": "Communication channel to use",
    "enum": [
     "email",
     "linkedin",
     "whatsapp"
    ],
    "type": "string"
   },
   "lead_id": {
    "description": "UUID of the lead to message",
    "type": "string"
   },
   "subject": {
    "description": "Message subject (required for email)",
    "type": "string"
   }
  },
  "required": [
   "lead_id",
   "channel",
   "body"
  ],
  "type": "object"
 },
 "name": "send_message"
}
