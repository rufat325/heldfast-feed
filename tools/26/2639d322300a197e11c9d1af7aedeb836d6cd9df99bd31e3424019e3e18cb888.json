{
 "_meta": {
  "stackfacts/http": "POST /v1/kev/check",
  "stackfacts/keywords": [
   "check if a CVE is actively exploited (CISA KEV)",
   "batch CVE check",
   "vulnerability scan triage",
   "known exploited vulnerabilities"
  ],
  "stackfacts/paid": true,
  "stackfacts/price_usd": "0.005"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check up to 100 CVEs at once against CISA KEV (known exploited vulnerabilities); returns in_kev and the KEV details for each one.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cves": {
    "description": "CVE ids; duplicates are merged",
    "items": {
     "description": "CVE id, e.g. CVE-2021-44228",
     "maxLength": 32,
     "pattern": "^[Cc][Vv][Ee]-\\d{4}-\\d{4,}$",
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "cves"
  ],
  "type": "object"
 },
 "name": "stackfacts_kev_check"
}
