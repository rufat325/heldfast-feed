{
 "description": "List your campaigns with optional status filtering.",
 "inputSchema": {
  "properties": {
   "country_code": {
    "description": "Filter by country code",
    "type": "string"
   },
   "format": {
    "description": "Response format (default: json)",
    "enum": [
     "json",
     "yaml",
     "md"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (default: 1)",
    "type": "number"
   },
   "page_size": {
    "description": "Results per page (1-100, default: 20)",
    "type": "number"
   },
   "status": {
    "description": "Filter by campaign status",
    "enum": [
     "active",
     "paused",
     "completed",
     "stopped"
    ],
    "type": "string"
   },
   "workspace": {
    "description": "Tenant to target (cli_\u2026). Omit to use the active/bound workspace. list_workspaces shows the options.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_campaigns"
}
