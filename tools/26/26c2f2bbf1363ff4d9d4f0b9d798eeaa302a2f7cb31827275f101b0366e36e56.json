{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a host-initiated event on a calendar. Supports attendees (with WhatsApp/email invitations), location, and daily/weekly/monthly recurrence.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attendees": {
    "description": "List of attendees to invite",
    "items": {
     "additionalProperties": false,
     "properties": {
      "contactId": {
       "description": "Link to existing Neuron contact UUID",
       "type": "string"
      },
      "email": {
       "description": "Attendee email",
       "type": "string"
      },
      "name": {
       "description": "Attendee name",
       "type": "string"
      },
      "phone": {
       "description": "Attendee phone (for WhatsApp invitations)",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "calendarId": {
    "description": "Calendar UUID",
    "type": "string"
   },
   "description": {
    "description": "Event description",
    "type": "string"
   },
   "endTime": {
    "description": "End time (ISO 8601)",
    "type": "string"
   },
   "locationType": {
    "description": "Location type",
    "enum": [
     "video",
     "phone",
     "in_person",
     "whatsapp",
     "custom"
    ],
    "type": "string"
   },
   "locationValue": {
    "description": "Location details",
    "type": "string"
   },
   "recurrenceRule": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "count": {
        "description": "Max occurrences",
        "type": "number"
       },
       "endAt": {
        "description": "Stop generating after this ISO date",
        "type": "string"
       },
       "interval": {
        "description": "Every N days (default: 1)",
        "type": "number"
       },
       "kind": {
        "const": "daily",
        "type": "string"
       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "count": {
        "description": "Max occurrences",
        "type": "number"
       },
       "days": {
        "description": "Days of week: 0=Sun, 1=Mon, ..., 6=Sat",
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       "endAt": {
        "description": "Stop generating after this ISO date",
        "type": "string"
       },
       "interval": {
        "description": "Every N weeks (default: 1)",
        "type": "number"
       },
       "kind": {
        "const": "weekly",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "days"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "count": {
        "description": "Max occurrences",
        "type": "number"
       },
       "dayOfMonth": {
        "description": "Day of month (1-31)",
        "type": "number"
       },
       "endAt": {
        "description": "Stop generating after this ISO date",
        "type": "string"
       },
       "interval": {
        "description": "Every N months (default: 1)",
        "type": "number"
       },
       "kind": {
        "const": "monthly",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "dayOfMonth"
      ],
      "type": "object"
     }
    ],
    "description": "Recurrence rule \u2014 generates instances 12 weeks ahead"
   },
   "startTime": {
    "description": "Start time (ISO 8601, e.g. '2025-03-15T09:00:00Z')",
    "type": "string"
   },
   "title": {
    "description": "Event title",
    "type": "string"
   }
  },
  "required": [
   "calendarId",
   "title",
   "startTime",
   "endTime"
  ],
  "type": "object"
 },
 "name": "neuron_create_event",
 "title": "Create Calendar Event"
}
