{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Cloud Insight event rule group for monitoring alerts. Defines monitoring targets, metrics, thresholds, and notification recipients.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cfgRuleList": {
    "description": "List of rule configurations defining alert conditions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "aggregation": {
       "description": "Aggregation type (default: AVG)",
       "enum": [
        "AVG",
        "MIN",
        "MAX",
        "SUM",
        "COUNT"
       ],
       "type": "string"
      },
      "condition": {
       "description": "Threshold condition (GT: >, GTE: >=, LT: <, LTE: <=, EQ: ==)",
       "enum": [
        "GT",
        "GTE",
        "LT",
        "LTE",
        "EQ"
       ],
       "type": "string"
      },
      "duration": {
       "description": "Duration in minutes before triggering alert",
       "type": "number"
      },
      "eventLevel": {
       "description": "Event severity level",
       "enum": [
        "CRITICAL",
        "WARNING",
        "INFO"
       ],
       "type": "string"
      },
      "metricGroupItemId": {
       "description": "Metric item ID",
       "type": "string"
      },
      "threshold": {
       "description": "Threshold value",
       "type": "number"
      }
     },
     "required": [
      "metricGroupItemId",
      "condition",
      "threshold",
      "duration",
      "eventLevel"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dryRun": {
    "description": "If true, returns a preview without creating the rule group (default: false)",
    "type": "boolean"
   },
   "groupName": {
    "description": "Name of the rule group",
    "type": "string"
   },
   "metricsGroupId": {
    "description": "Metrics group ID (rule template) to apply",
    "type": "string"
   },
   "monitorGroupId": {
    "description": "Monitor group ID (target group) to monitor",
    "type": "string"
   },
   "prodKey": {
    "description": "Product key (cw_key) for the target service",
    "type": "string"
   },
   "recipientNotification": {
    "description": "Notification recipients for alerts",
    "items": {
     "additionalProperties": false,
     "properties": {
      "notificationType": {
       "description": "Notification type",
       "enum": [
        "EMAIL",
        "SMS",
        "WEBHOOK"
       ],
       "type": "string"
      },
      "recipient": {
       "description": "Notification recipient (email, phone, or webhook URL)",
       "type": "string"
      }
     },
     "required": [
      "notificationType",
      "recipient"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "groupName",
   "prodKey",
   "metricsGroupId",
   "monitorGroupId",
   "cfgRuleList"
  ],
  "type": "object"
 },
 "name": "ncloud_create_rule_group"
}
