   },
   "sponsor": {
    "description": "Sponsor/organization, e.g. 'Pfizer'.",
    "type": "string"
   },
   "status": {
    "description": "Recruitment status, e.g. 'RECRUITING', 'COMPLETED', 'TERMINATED'.",
    "type": "string"
   },
   "term": {
    "description": "General search term.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "trials_search"
}
