 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "customer_id": {
    "description": "Only this customer's events.",
    "type": "string"
   },
   "end_timestamp": {
    "description": "ISO-8601 upper bound.",
    "type": "string"
   },
   "limit": {
    "description": "Page size, 1-100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "meter_id": {
    "description": "Only events matching this meter.",
    "type": "string"
   },
   "name": {
    "description": "Only events with this name.",
    "type": "string"
   },
   "organization_id": {
    "description": "Restrict to this organisation id. Needed when the token spans several organisations.",
    "type": "string"
   },
   "page": {
    "description": "1-based page number.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "start_timestamp": {
    "description": "ISO-8601 lower bound.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "polar_list_events",
 "title": "List usage events"
}
