{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search the VanAuto marketplace (akcesoria - camper parts and accessories). Supports text, manufacturer, category, condition, compatibility and price filters. Returns compact rows plus facets with category/condition counts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Category slug, e.g. \"appliances\", \"plumbing_water\".",
    "type": "string"
   },
   "compatibility": {
    "description": "Camper compatibility tag.",
    "type": "string"
   },
   "condition": {
    "description": "Item condition.",
    "enum": [
     "new_item",
     "used",
     "refurbished",
     "damaged"
    ],
    "type": "string"
   },
   "location": {
    "description": "City name or postal code text filter.",
    "type": "string"
   },
   "manufacturer": {
    "description": "Manufacturer/brand text filter.",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number (1-based).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "perPage": {
    "default": 20,
    "description": "Rows per page (1-50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "priceMax": {
    "description": "Maximum price in PLN.",
    "minimum": 0,
    "type": "number"
   },
   "priceMin": {
    "description": "Minimum price in PLN.",
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Free-text search over title and description.",
    "type": "string"
   },
   "subcategory": {
    "description": "Subcategory slug, e.g. \"toilets\", \"refrigeration\".",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_marketplace_listings",
 "title": "Search marketplace listings"
}
