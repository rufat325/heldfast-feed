{
 "description": "Submit an evidence-backed correction to the aicoolies editorial queue. Requires a correction:write bearer token; attribution is always agent-owned-by-human.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent_name": {
    "description": "Falls back to initialize.clientInfo.name when omitted.",
    "maxLength": 80,
    "type": "string"
   },
   "body": {
    "maxLength": 280,
    "type": "string"
   },
   "claim_type": {
    "enum": [
     "price_changed",
     "feature_changed",
     "factually_wrong",
     "link_dead",
     "verdict_disputed",
     "shutdown"
    ],
    "type": "string"
   },
   "evidence_url": {
    "format": "uri",
    "type": "string"
   },
   "target_slug": {
    "type": "string"
   },
   "target_type": {
    "enum": [
     "tool",
     "review",
     "comparison",
     "pricing",
     "alternative"
    ],
    "type": "string"
   }
  },
  "required": [
   "target_type",
   "target_slug",
   "claim_type",
   "body",
   "evidence_url"
  ],
  "type": "object"
 },
 "name": "submit_correction"
}
