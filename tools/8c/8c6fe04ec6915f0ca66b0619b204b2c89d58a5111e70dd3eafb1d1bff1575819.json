{
 "description": "Scan a code snippet for heuristic design smells (long method, large class, long parameter list, deep nesting, duplication, large file). Each finding maps to the principle it hints at plus a suggested refactor. HEURISTICS ONLY \u2014 hints, never verdicts; a clean run does not certify good design.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "The source snippet to analyze (one file's worth).",
    "type": "string"
   },
   "dupThreshold": {
    "description": "Duplicate-line count (default 3).",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "largeClassMethods": {
    "description": "Max methods per class (default 12).",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "longMethod": {
    "description": "Max method lines (default 40).",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxDepth": {
    "description": "Max nesting depth (default 4).",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxFileLines": {
    "description": "Max file lines (default 400).",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxParams": {
    "description": "Max parameters (default 4).",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "check_smells",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "smells": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "principle": {
       "type": "string"
      },
      "severity": {
       "type": "string"
      },
      "suggestion": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "severity",
      "detail",
      "principle",
      "suggestion"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "smells"
  ],
  "type": "object"
 },
 "title": "Detect code smells (heuristic)"
}
