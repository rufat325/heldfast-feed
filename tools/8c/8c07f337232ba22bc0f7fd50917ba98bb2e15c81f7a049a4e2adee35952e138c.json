{
 "description": "Scan current freshness/staleness across many active feeds, filterable by provider, symbol, or category. Use this to find feeds needing attention right now. For a single feed by UUID use get_feed_health; for a dated ecosystem-wide report use get_oracle_health.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Filter by feed category",
    "enum": [
     "crypto",
     "stablecoin",
     "forex",
     "commodity",
     "wrapped",
     "lst"
    ],
    "type": "string"
   },
   "provider": {
    "description": "Filter by oracle provider",
    "enum": [
     "chainlink",
     "api3",
     "redstone",
     "dia",
     "winklink",
     "supra",
     "twap",
     "reflector",
     "flare",
     "band"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Filter by asset symbol",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_feed_freshness"
}
