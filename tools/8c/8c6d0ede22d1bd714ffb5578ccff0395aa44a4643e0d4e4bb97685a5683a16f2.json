{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create work request"
 },
 "description": "Create a new work request. Requires work_requests:write scope. IMPORTANT - Location hierarchy: always resolve top-down by calling list_sites first, then list_buildings filtered by site_id, then list_locations filtered by building_id. Provide all three IDs (site_id, building_id, location_id) explicitly.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset_id": {
    "description": "Asset ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "building_id": {
    "description": "Building ID - resolve second via list_buildings filtered by site_id",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "location_id": {
    "description": "Location ID - resolve last via list_locations filtered by building_id",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "priority": {
    "description": "Priority level",
    "enum": [
     "LOW",
     "MEDIUM",
     "HIGH",
     "URGENT"
    ],
    "type": "string"
   },
   "site_id": {
    "description": "Site ID - resolve first via list_sites",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "status": {
    "description": "Omit it: new requests always start as PENDING_REVIEW. Approve or reject with update_work_request.",
    "enum": [
     "PENDING_REVIEW"
    ],
    "type": "string"
   },
   "system_id": {
    "description": "System ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "title": {
    "description": "Work request title (required)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "work_category_id": {
    "description": "Work category ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "create_work_request",
 "title": "Create work request"
}
