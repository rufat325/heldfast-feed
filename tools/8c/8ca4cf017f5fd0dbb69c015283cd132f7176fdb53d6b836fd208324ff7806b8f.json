  "title": "\u041f\u043e\u0434\u043f\u0438\u0441\u043a\u0430 \u043d\u0430 \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0437\u0430\u0432\u043e\u0434\u0430 (webhook)"
 },
 "description": "\u041f\u043e\u0434\u043f\u0438\u0441\u0430\u0442\u044c \u0418\u0418-\u0430\u0433\u0435\u043d\u0442\u0430 \u043d\u0430 webhook-\u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0437\u0430\u0432\u043e\u0434\u0430: \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0435 \u0446\u0435\u043d (price_change), \u043d\u043e\u0432\u044b\u0435 \u0437\u0430\u043a\u0430\u0437\u044b \u0411\u0438\u0440\u0436\u0438 (new_birzha_order), \u0441\u043a\u043b\u0430\u0434 (stock_update). \u0423\u043a\u0430\u0436\u0438 HTTPS webhook \u2014 \u0437\u0430\u0432\u043e\u0434 \u0431\u0443\u0434\u0435\u0442 \u043f\u0440\u0438\u0441\u044b\u043b\u0430\u0442\u044c POST \u0441 \u0441\u043e\u0431\u044b\u0442\u0438\u0435\u043c. \u0422\u0430\u043a \u0430\u0433\u0435\u043d\u0442 \u0434\u0435\u0440\u0436\u0438\u0442 \u0434\u0430\u043d\u043d\u044b\u0435 \u0437\u0430\u0432\u043e\u0434\u0430 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u043c\u0438.",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0430\u0433\u0435\u043d\u0442\u0430",
    "type": "string"
   },
   "event_types": {
    "items": {
     "enum": [
      "price_change",
      "new_birzha_order",
      "stock_update"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "webhook_url": {
    "description": "HTTPS URL \u0434\u043b\u044f POST webhooks",
    "type": "string"
   }
  },
  "required": [
   "webhook_url",
   "event_types"
  ],
  "type": "object"
 },
 "name": "subscribe_to_factory_events",
 "outputSchema": {
  "properties": {
   "ok": {
    "type": "boolean"
   },
   "subscription": {
    "type": "object"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "\u041f\u043e\u0434\u043f\u0438\u0441\u043a\u0430 \u043d\u0430 \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u0437\u0430\u0432\u043e\u0434\u0430 (webhook)"
}
