{
 "description": "Remove packages from a project",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "global": {
    "description": "Uninstall from global",
    "type": "boolean"
   },
   "packages": {
    "description": "Package names to uninstall",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "path": {
    "description": "Absolute path to the package directory",
    "type": "string"
   }
  },
  "required": [
   "path",
   "packages"
  ],
  "type": "object"
 },
 "name": "uninstall"
}
