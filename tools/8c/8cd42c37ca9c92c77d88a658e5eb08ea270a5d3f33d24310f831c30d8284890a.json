    },
    "type": "array"
   },
   "description": {
    "description": "What it is, in a sentence or two.",
    "maxLength": 500,
    "type": "string"
   },
   "id": {
    "description": "An existing product to change, from products_list.",
    "type": "string"
   },
   "name": {
    "description": "The name, or the new name when id is given.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "workspace_id": {
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
