{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Builds an optional practice protocol from the evidence ledger and user preferences. It can return no-remedy-needed, never emits unreviewed gemstones, costly rituals or initiation-only mantras, and does not claim causality.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "place"
    ]
   },
   {
    "required": [
     "latitude",
     "longitude",
     "timezone"
    ]
   }
  ],
  "properties": {
   "date": {
    "type": "string"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "place": {
    "description": "Catalogue query or display label when explicit coordinates are supplied",
    "type": "string"
   },
   "preferences": {
    "properties": {
     "allowCharity": {
      "type": "boolean"
     },
     "allowPrayer": {
      "type": "boolean"
     },
     "beliefMode": {
      "enum": [
       "hindu",
       "spiritual",
       "tradition-specific"
      ],
      "type": "string"
     },
     "maximumBurden": {
      "enum": [
       "minimal",
       "moderate"
      ],
      "type": "string"
     },
     "maximumCost": {
      "enum": [
       "free",
       "low"
      ],
      "type": "string"
     },
     "tradition": {
      "type": "string"
     }
    },
    "required": [
     "beliefMode",
     "maximumBurden",
     "maximumCost",
     "allowPrayer",
     "allowCharity"
    ],
    "type": "object"
   },
   "time": {
    "type": "string"
   },
   "timezone": {
    "description": "Required IANA timezone when explicit coordinates are supplied, for example Asia/Kolkata",
    "type": "string"
   },
   "timezoneOffset": {
    "description": "Optional fallback offset; derived from timezone and the requested local date when omitted",
    "maximum": 14,
    "minimum": -14,
    "type": "number"
   },
   "topic": {
    "enum": [
     "career",
     "education",
     "property",
     "relationships",
     "spirituality",
     "wealth"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "date",
   "time",
   "topic",
   "preferences"
  ],
  "type": "object"
 },
 "name": "suggest_safe_practice",
 "outputSchema": {
  "additionalProperties": true,
  "required": [
   "schemaVersion",
   "diagnosis",
   "outcome",
   "preferences",
   "remedyFamilyEligibility",
   "eligiblePractices",
   "traditionalChartRemedies",
   "contraindications",
   "followUp"
  ],
  "type": "object"
 },
 "title": "Suggest belief-compatible low-burden support"
}
