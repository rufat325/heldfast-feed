{
 "description": "Optimize 1D cutting plans for bars, pipes and profiles (linear cutting stock problem, best-fit decreasing heuristic). Returns bars used, per-bar cut lists with positions, total waste and unplaced parts. A web_url with the plan prefilled is included for a visual SVG diagram.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "kerf": {
    "default": 0,
    "description": "Saw blade width consumed by each cut",
    "minimum": 0,
    "type": "number"
   },
   "parts": {
    "description": "Parts to cut",
    "items": {
     "properties": {
      "label": {
       "description": "Optional part name",
       "type": "string"
      },
      "length": {
       "description": "Cut length",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "qty": {
       "default": 1,
       "description": "How many of this part",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "length"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "stock_count": {
    "default": 1,
    "description": "How many stock bars are available",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "stock_length": {
    "description": "Length of one stock bar",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "trim": {
    "default": 0,
    "description": "Unusable trim at bar ends",
    "minimum": 0,
    "type": "number"
   },
   "unit": {
    "description": "Unit for all lengths",
    "enum": [
     "mm",
     "cm",
     "m",
     "in",
     "ft"
    ],
    "type": "string"
   }
  },
  "required": [
   "unit",
   "stock_length",
   "parts"
  ],
  "type": "object"
 },
 "name": "linear_cutting_optimizer"
}
