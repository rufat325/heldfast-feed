{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "A bounded decision assessment: proceed, revise, or pause. Supply decision (or proposed_action) and goal. More relevant context supports better guidance: include available evidence, constraints, affected people, reversibility, urgency and decision owner. Optional means not required to submit, not unnecessary to assess. Preserve unknowns; never invent facts or authority. Takes no external action.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "decision"
    ]
   },
   {
    "required": [
     "proposed_action"
    ]
   }
  ],
  "properties": {
   "affected_people": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "constraints": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "decision": {
    "description": "The proposed action, options or question to assess. Use decision or the compatible proposed_action field.",
    "pattern": "\\S",
    "type": "string"
   },
   "decision_owner": {
    "type": "string"
   },
   "evidence": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "goal": {
    "description": "The outcome you want to achieve.",
    "pattern": "\\S",
    "type": "string"
   },
   "proposed_action": {
    "description": "Compatible alternative to decision. If both are supplied, they must match.",
    "pattern": "\\S",
    "type": "string"
   },
   "reversibility": {
    "type": "string"
   },
   "task_id": {
    "description": "Optional reference; generated when omitted.",
    "pattern": "\\S",
    "type": "string"
   },
   "urgency": {
    "type": "string"
   }
  },
  "required": [
   "goal"
  ],
  "type": "object"
 },
 "name": "sounding_decision_check",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "assessment_support": {
    "additionalProperties": false,
    "properties": {
     "explanation": {
      "pattern": "\\S",
      "type": "string"
     },
     "level": {
      "enum": [
       "strong",
       "moderate",
       "tentative"
      ],
      "type": "string"
     }
    },
    "required": [
     "level",
     "explanation"
    ],
    "type": "object"
   },
   "assumptions_to_check": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "disposition": {
    "enum": [
     "pause",
     "proceed",
     "revise"
    ],
    "type": "string"
   },
   "evidence_basis": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "material_question": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "task_id": {
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "disposition",
   "reason",
   "material_question",
   "evidence_basis",
   "assumptions_to_check",
   "next_step",
   "assessment_support"
  ],
  "type": "object"
 }
}
