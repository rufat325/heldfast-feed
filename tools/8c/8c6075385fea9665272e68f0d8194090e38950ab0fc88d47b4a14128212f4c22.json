{
 "description": "Retrieve beers on a user's wish list",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Results per page (max 50, default 25)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "sort": {
    "description": "Sort order (default: date)",
    "enum": [
     "date",
     "checkin",
     "highest_rated",
     "lowest_rated"
    ],
    "type": "string"
   },
   "username": {
    "description": "Untappd username",
    "type": "string"
   }
  },
  "required": [
   "username"
  ],
  "type": "object"
 },
 "name": "get_user_wishlist"
}
