{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Charge a saved payment method. Charges the card immediately WITHOUT any user interaction. MOVES REAL MONEY \u2014 irreversible.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "anyOf": [
     {
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    ],
    "description": "Recurring charge amount"
   },
   "currency": {
    "default": "RUB",
    "description": "Currency (ISO-4217, default RUB)",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "description": {
    "description": "Recurring payment description",
    "maxLength": 128,
    "type": "string"
   },
   "payment_method_id": {
    "description": "ID of the saved payment method (from payment_method.id)",
    "type": "string"
   }
  },
  "required": [
   "payment_method_id",
   "amount",
   "description"
  ],
  "type": "object"
 },
 "name": "create_recurring_payment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "confirmation_url": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "paid": {
    "type": "boolean"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Create recurring payment"
}
