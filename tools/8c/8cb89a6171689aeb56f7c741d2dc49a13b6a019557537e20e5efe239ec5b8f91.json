    "default": 10,
    "description": "How many to return per page. Min 1, max 100, default 10.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number (1-indexed).",
    "minimum": 1,
    "type": "integer"
   },
   "site_id": {
    "description": "Override the currently selected site.",
