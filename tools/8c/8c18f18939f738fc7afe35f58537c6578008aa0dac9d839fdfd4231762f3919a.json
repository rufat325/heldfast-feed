{
 "annotations": {
  "readOnlyHint": true,
  "title": "Store Inventories"
 },
 "description": "Stock levels (and cost prices) per offer/warehouse. Use details:true for the per-store breakdown. Returns {offers[], pagination}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "details": {
    "description": "Include per-store breakdown (sets filter[details]=1)",
    "type": "boolean"
   },
   "filter_offer_external_id": {
    "description": "Filter by offer externalId",
    "type": "string"
   },
   "filter_product_active": {
    "description": "Only offers of active products",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "Results per page (max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "minimum": 1,
    "type": "integer"
   },
   "site": {
    "description": "Site (store) symbolic code. Required on create/edit when the API key is scoped to multiple sites (see list_sites).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "store_inventories"
}
