 "description": "Judge whether a service level objective can actually be observed, before any measurement exists. The central check: at the expected event volume, one failure may already exceed the whole budget, so the objective is met with zero failures and breached by one and measures nothing in between. Also reports a budget of fewer than ten events, where chance dominates service quality, and a burn-rate alert whose own window is longer than the time that burn takes to exhaust the budget. Pay 200000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "burn_rate_alerts": {
    "description": "The burn-rate alerts intended over this objective.",
    "example": [
     {
      "burn_rate": 1.5,
      "name": "slow burn",
      "window_hours": 720
     }
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "burn_rate": {
       "minimum": 0,
       "type": "number"
      },
      "name": {
       "maxLength": 128,
       "type": "string"
      },
      "window_hours": {
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "burn_rate",
      "window_hours"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "expected_events_per_day": {
    "description": "The volume the objective will be measured over. Omitting it is reported as not having assessed observability, which is the check this product exists for.",
    "example": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "objective": {
    "description": "The objective as a percentage, parsed exactly.",
    "example": "99.99",
    "type": [
