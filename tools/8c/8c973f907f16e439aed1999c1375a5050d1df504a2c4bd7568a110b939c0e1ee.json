{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Retrieve multiple skills by name in a single call. Returns found skills and lists any not found.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hydrateRefs": {
    "default": false,
    "type": "boolean"
   },
   "names": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "names"
  ],
  "type": "object"
 },
 "name": "get_skills",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "notFound": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "skills": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "executionLogId": {
       "type": [
        "number",
        "null"
       ]
      },
      "hydratedSkills": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "content": {
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "content"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "references": {
       "additionalProperties": false,
       "properties": {
        "facts": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "content": {
            "type": "string"
           },
           "id": {
            "type": "number"
           }
          },
          "required": [
           "id",
           "content"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "resources": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "id": {
            "type": "number"
           },
           "isStale": {
            "type": "boolean"
           },
           "uri": {
            "type": "string"
           }
          },
          "required": [
           "id",
           "uri",
           "isStale"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "skills": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "name": {
            "type": "string"
           },
           "relation": {
            "type": "string"
           },
           "title": {
            "type": "string"
           }
          },
          "required": [
           "name",
           "title",
           "relation"
          ],
          "type": "object"
         },
         "type": "array"
        }
       },
       "required": [
        "skills",
        "resources",
        "facts"
       ],
       "type": "object"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "title",
      "content",
      "tags",
      "executionLogId",
      "references"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "skills",
   "notFound"
  ],
  "type": "object"
 },
 "title": "Get Skills"
}
