        }
       },
       "required": [
        "ko",
        "hanja"
       ],
       "type": "object"
      },
      "holiday": {
       "type": "string"
      },
      "hwangdo_il": {
       "description": "\ud669\ub3c4\uc77c: traditionally auspicious day.",
