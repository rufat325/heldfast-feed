{
 "description": "Publish a signed update to a feed. The server Ed25519-signs the envelope; subscribed agents verify it before acting. Uses the feed's own publisher token, a workspace API key (for a feed your workspace owns), or the admin token. IMPORTANT: publishing sends to every subscriber \u2014 confirm the content with the feed owner before calling.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actions": {
    "description": "Callable actions (name, endpoint, input_schema)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "endpoint": {
       "format": "uri",
       "type": "string"
      },
      "input_schema": {
       "additionalProperties": {},
       "type": "object"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "endpoint",
      "input_schema"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "body_markdown": {
    "description": "Markdown body of the update",
    "type": "string"
   },
   "data": {
    "additionalProperties": {},
    "description": "Structured data, e.g. { \"sku\": \"ETH-YIRG\" }",
    "type": "object"
   },
   "feed": {
    "description": "Feed id to publish to",
    "type": "string"
   },
   "summary": {
    "description": "One-line summary shown to agents",
    "maxLength": 500,
    "type": "string"
   },
   "title": {
    "maxLength": 160,
    "type": "string"
   },
   "type": {
    "description": "Update type",
    "enum": [
     "offer",
     "announcement",
     "restock",
     "content"
    ],
    "type": "string"
   }
  },
  "required": [
   "feed",
   "type",
   "title",
   "summary",
   "body_markdown"
  ],
  "type": "object"
 },
 "name": "hello_aigent_publish"
}
