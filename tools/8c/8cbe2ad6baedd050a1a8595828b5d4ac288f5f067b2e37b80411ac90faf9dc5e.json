{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Submit one original ticket email"},"description":"Submits ONE original ticket-confirmation email (the complete RFC 822 message as saved from the inbox, base64-encoded, up to 2 MiB) exactly as the website\u2019s upload does. Not a forward, screenshot, PDF or copy. Returns whether it is eligible, held or rejected, why, the bookings found and the email\u2019s status as get_ticket_status shows it. If we can\u2019t check an email yet (for example, its theater is new to us), we keep it for up to 7 days to finish checking it, then delete it. Never returns the email\u2019s text, headers or addresses.","inputSchema":{"additionalProperties":false,"properties":{"filename":{"maxLength":120,"type":"string"},"raw_email_base64":{"maxLength":3000000,"minLength":1,"type":"string"}},"required":["raw_email_base64"],"type":"object"},"name":"submit_ticket_email","outputSchema":{"additionalProperties":false,"properties":{"bookings":{"items":{"additionalProperties":false,"properties":{"cinema":{"type":"string"},"date":{"type":["string","null"]},"film":{"type":"string"},"id":{"type":"string"},"newCredits":{"type":"number"},"reason":{"type":"string"},"status":{"enum":["eligible","already_counted","pending_issuer","ambiguous","unable_to_authenticate","claimed","cancelled","needs_address"],"type":"string"},"tickets":{"type":"number"},"timezone":{"type":["string","null"]}},"required":["id","film","cinema","date","timezone","tickets","status","newCredits"],"type":"object"},"type":"array"},"errorCode":{"type":"string"},"message":{"type":"string"},"nextStep":{"type":"string"},"processing":{"type":"string"},"recipientVerified":{"type":"boolean"},"status":{"enum":["eligible","held","rejected"],"type":"string"},"submissionId":{"type":"string"},"ticketStatus":{"additionalProperties":false,"properties":{"action":{"enum":["confirm_inbox","claim","retry","upload"],"type":"string"},"filename":{"type":"string"},"no