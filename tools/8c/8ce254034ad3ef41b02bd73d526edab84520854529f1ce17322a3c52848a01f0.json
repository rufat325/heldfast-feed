{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Competitive citation snapshot for a query"
 },
 "description": "End-to-end competitive snapshot for a single query. Calls check_citations to get the cited URLs, then runs compare_domains on your_url vs the top cited competitors. Returns your score, the average competitor score, and the gap.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "engine": {
    "default": "auto",
    "description": "AI engine to query for the citation set. 'auto' picks the first available key.",
    "enum": [
     "perplexity",
     "claude",
     "openai",
     "gemini",
     "bing_serp",
     "brave_serp",
     "google_ai_mode",
     "auto"
    ],
    "type": "string"
   },
   "max_competitors": {
    "default": 4,
    "description": "How many cited URLs to compare against your_url. Capped at 9 (compare_domains accepts max 10 URLs total including yours).",
    "maximum": 9,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query to test (what would a user ask an AI?).",
    "minLength": 1,
    "type": "string"
   },
   "your_url": {
    "description": "Your URL to benchmark against the cited competitors.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "query",
   "your_url"
  ],
  "type": "object"
 },
 "name": "competitors_compete",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "average_competitor_score": {
    "description": "Mean score across competitor URLs.",
    "type": [
     "number",
     "null"
    ]
   },
   "comparison": {
    "anyOf": [
     {
      "additionalProperties": {},
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Full compare_domains result."
   },
   "competitors": {
    "description": "Competitor URLs that were compared.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "engine": {
    "description": "Engine used for the citation fetch.",
    "type": "string"
   },
   "fetched_at": {
    "description": "UTC ISO-8601 timestamp.",
    "type": "string"
   },
   "query": {
    "description": "The query that was tested.",
    "type": "string"
   },
   "score_gap": {
    "description": "your_score minus average_competitor_score.",
    "type": [
     "number",
     "null"
    ]
   },
   "your_in_citations": {
    "description": "Whether your URL appeared in the engine's citation list.",
    "type": "boolean"
   },
   "your_score": {
    "description": "predict_citation score for your URL (null on error).",
    "type": [
     "number",
     "null"
    ]
   },
   "your_url": {
    "description": "Your URL that was benchmarked.",
    "type": "string"
   }
  },
  "required": [
   "query",
   "engine",
   "fetched_at",
   "your_url",
   "your_score",
   "your_in_citations",
   "competitors",
   "average_competitor_score",
   "score_gap",
   "comparison"
  ],
  "type": "object"
 }
}
