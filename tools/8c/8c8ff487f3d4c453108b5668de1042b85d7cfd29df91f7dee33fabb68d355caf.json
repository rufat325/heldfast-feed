{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Execute an explicit bounded action batch in a task-owned tab of the approved local browser. Default: new tab closed after the batch. Opt-in session preserves top-level read/action/read state for at most 60 seconds and 10 calls in this owning server; resume with its opaque handle and exact current page URL, without navigation or replay. Use for user-authorized search/filter/expand workflows after retrieval alone is insufficient. Verify final evidence; a successful click is not goal completion. Password/MFA/CAPTCHA/consent require the user. Purchases, posting, deletion, uploads and account changes require separate explicit user authorization. No remote browser or credential export.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "session": {
    "additionalProperties": false,
    "description": "Opt in with {} to retain one guarded tab for at most 60 seconds/10 calls; resume with its id and exact current page URL. No lifetime renewal. Top-level actions only; frame/download/upload continuation is unsupported.",
    "properties": {
     "close": {
      "description": "Close the owned session after this batch and verify cleanup",
      "type": "boolean"
     },
     "id": {
      "description": "Opaque handle returned by this owning server; never a native tab ID",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "steps": {
    "default": [],
    "items": {
     "oneOf": [
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "click",
         "type": "string"
        },
        "frame": {
         "description": "Observed selector for a visible direct same-origin HTTP(S) iframe; at most three distinct scopes per batch",
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "selector": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "action",
        "selector"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "fill",
         "type": "string"
        },
        "frame": {
         "description": "Observed selector for a visible direct same-origin HTTP(S) iframe; at most three distinct scopes per batch",
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "selector": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "value": {
         "maxLength": 10000,
         "type": "string"
        }
       },
       "required": [
        "action",
        "selector",
        "value"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "wait",
         "type": "string"
        },
        "frame": {
         "description": "Observed selector for a visible direct same-origin HTTP(S) iframe; at most three distinct scopes per batch",
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "selector": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "text": {
         "maxLength": 1000,
         "type": "string"
        }
       },
       "required": [
        "action",
        "selector"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "select",
         "type": "string"
        },
        "frame": {
         "description": "Observed selector for a visible direct same-origin HTTP(S) iframe; at most three distinct scopes per batch",
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "selector": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "value": {
         "maxLength": 1000,
         "type": "string"
        }
       },
       "required": [
        "action",
        "selector",
        "value"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "press",
         "type": "string"
        },
        "frame": {
         "description": "Observed selector for a visible direct same-origin HTTP(S) iframe; at most three distinct scopes per batch",
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "key": {
         "maxLength": 50,
         "minLength": 1,
         "type": "string"
        },
        "selector": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "action",
        "selector",
        "key"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "scroll",
         "type": "string"
        },
        "frame": {
         "description": "Observed selector for a visible direct same-origin HTTP(S) iframe; at most three distinct scopes per batch",
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "selector": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "action",
        "selector"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "screenshot",
         "type": "string"
        },
        "frame": {
         "description": "Observed selector for a visible direct same-origin HTTP(S) iframe; at most three distinct scopes per batch",
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "action"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "download",
         "type": "string"
        },
        "expected_url": {
         "format": "uri",
         "type": "string"
        },
        "frame": {
         "description": "Observed selector for a visible direct same-origin HTTP(S) iframe; at most three distinct scopes per batch",
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "selector": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "action",
        "selector"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "upload",
         "type": "string"
        },
        "data_base64": {
         "maxLength": 2097152,
         "type": "string"
        },
        "filename": {
         "maxLength": 128,
         "minLength": 1,
         "pattern": "^[^/\\\\\\u0000-\\u001f]+$",
         "type": "string"
        },
        "frame": {
         "description": "Observed selector for a visible direct same-origin HTTP(S) iframe; at most three distinct scopes per batch",
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "mime_type": {
         "default": "application/octet-stream",
         "maxLength": 100,
         "pattern": "^[a-zA-Z0-9.+-]+\\/[a-zA-Z0-9.+-]+$",
         "type": "string"
        },
        "selector": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "action",
        "selector",
        "filename",
        "data_base64"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 20,
    "type": "array"
   },
   "timeout_ms": {
    "default": 15000,
    "maximum": 60000,
    "minimum": 500,
    "type": "integer"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "smartbrowser",
 "title": "Smart Browser Actions"
}
