{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store one immutable candidate adoption record after verifying a pinned cached arXiv abstract byte span, registered source byte spans, and any referenced execution artifact. Runs a bounded collection check. Receipt citation does not prove that the protocol ran or worked. Decisions are proposed/deferred/rejected only; no memory or skill promotion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "record": {
    "additionalProperties": false,
    "properties": {
     "decision": {
      "enum": [
       "proposed",
       "deferred",
       "rejected"
      ],
      "type": "string"
     },
     "hypothesis": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "issue": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
     },
     "paper": {
      "additionalProperties": false,
      "properties": {
       "content_hash": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "id": {
        "pattern": "^\\d{4}\\.\\d{4,5}$",
        "type": "string"
       },
       "span_hash": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "span_length": {
        "maximum": 2400,
        "minimum": 1,
        "type": "integer"
       },
       "span_start": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "version": {
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
       },
       "version_key": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "id",
       "version",
       "version_key",
       "content_hash",
       "span_start",
       "span_length",
       "span_hash"
      ],
      "type": "object"
     },
     "proposed_change": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "protocol": {
      "additionalProperties": false,
      "properties": {
       "acceptance_gate": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
       },
       "baseline": {
        "maxLength": 800,
        "minLength": 1,
        "type": "string"
       },
       "intervention": {
        "maxLength": 800,
        "minLength": 1,
        "type": "string"
       },
       "metrics": {
        "items": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "baseline",
       "intervention",
       "metrics",
       "acceptance_gate"
      ],
      "type": "object"
     },
     "rationale": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "research_extractions": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "evidence_basis": {
         "const": "review-note-paraphrase",
         "type": "string"
        },
        "extraction_status": {
         "const": "human-unverified-agent-extraction",
         "type": "string"
        },
        "kind": {
         "enum": [
          "research-question",
          "method",
          "result",
          "limitation",
          "applicability-hypothesis"
         ],
         "type": "string"
        },
        "paper_location": {
         "maxLength": 160,
         "minLength": 1,
         "type": "string"
        },
        "source_reference": {
         "additionalProperties": false,
         "properties": {
          "chunk_id": {
           "pattern": "^[a-f0-9]{64}$",
           "type": "string"
          },
          "content_hash": {
           "pattern": "^[a-f0-9]{64}$",
           "type": "string"
          },
          "span_hash": {
           "pattern": "^[a-f0-9]{64}$",
           "type": "string"
          },
          "span_length": {
           "maximum": 2400,
           "minimum": 1,
           "type": "integer"
          },
          "span_start": {
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "chunk_id",
          "content_hash",
          "span_start",
          "span_length",
          "span_hash"
         ],
         "type": "object"
        },
        "statement": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "kind",
        "statement",
        "paper_location",
        "evidence_basis",
        "extraction_status",
        "source_reference"
       ],
       "type": "object"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array"
     },
     "result": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "artifact_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
         },
         "artifact_path": {
          "maxLength": 180,
          "minLength": 1,
          "type": "string"
         },
         "receipt_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
         },
         "run_id": {
          "pattern": "^run_[A-Za-z0-9_]{1,100}$",
          "type": "string"
         }
        },
        "required": [
         "run_id",
         "receipt_hash",
         "artifact_path",
         "artifact_hash"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "schema_version": {
      "const": "dwin.adoption-record/v1",
      "type": "string"
     },
     "source_references": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "chunk_id": {
         "pattern": "^[a-f0-9]{64}$",
         "type": "string"
        },
        "content_hash": {
         "pattern": "^[a-f0-9]{64}$",
         "type": "string"
        },
        "span_hash": {
         "pattern": "^[a-f0-9]{64}$",
         "type": "string"
        },
        "span_length": {
         "maximum": 2400,
         "minimum": 1,
         "type": "integer"
        },
        "span_start": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "chunk_id",
        "content_hash",
        "span_start",
        "span_length",
        "span_hash"
       ],
       "type": "object"
      },
      "maxItems": 6,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "schema_version",
     "paper",
     "issue",
     "hypothesis",
     "proposed_change",
     "source_references",
     "protocol",
     "decision",
     "rationale"
    ],
    "type": "object"
   }
  },
  "required": [
   "record"
  ],
  "type": "object"
 },
 "name": "evidence_record_adoption",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "created": {
    "type": "boolean"
   },
   "run_id": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ACCEPTED",
     "REJECTED",
     "ERROR"
    ],
    "type": "string"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "authority": {
      "const": "candidate-only",
      "type": "string"
     },
     "instruction_authority": {
      "const": "none",
      "type": "string"
     },
     "paper_verification": {
      "const": "cached-abstract-span-not-full-text",
      "type": "string"
     },
     "privacy": {
      "const": "local-private-no-export",
      "type": "string"
     },
     "protocol_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "record_id": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "result_status": {
      "enum": [
       "not-run",
       "ACCEPTED",
       "REJECTED",
       "ERROR"
      ],
      "type": "string"
     },
     "scientific_verification": {
      "const": false,
      "type": "boolean"
     },
     "source_spans_checked": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "record_id",
     "protocol_hash",
     "source_spans_checked",
     "result_status",
     "paper_verification",
     "scientific_verification",
     "authority",
     "instruction_authority",
     "privacy"
    ],
    "type": "object"
   }
  },
  "required": [
   "validation",
   "created",
   "run_id",
   "status"
  ],
  "type": "object"
 }
}
