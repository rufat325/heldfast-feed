{
 "description": "Draft enabling, pausing, or removing an existing campaign. Returns a draftId \u2014 call confirm_write to actually apply it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "campaignId": {
    "description": "Numeric campaign ID",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "status": {
    "enum": [
     "ENABLED",
     "PAUSED",
     "REMOVED"
    ],
    "type": "string"
   }
  },
  "required": [
   "campaignId",
   "status"
  ],
  "type": "object"
 },
 "name": "update_campaign_status",
 "title": "Draft: update campaign status"
}
