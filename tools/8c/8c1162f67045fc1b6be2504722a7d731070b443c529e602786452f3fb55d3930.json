{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Fix once across apps (draft PRs)"
 },
 "description": "Propose the same kind of recipe edit in up to 10 repos of one organization, one draft PR per repo with a shared batch id. Dry run by default (the diff and denied paths of each repo); confirm: true opens the drafts. One repo failing never rolls back the others; each result says what happened. Needs an account-level key. Confirm with the user before confirm: true. Returns { dryRun, plans } or { batchId, opened, results }. Write.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "changes": {
    "items": {
     "properties": {
      "edits": {
       "items": {
        "properties": {
         "baseSha": {
          "anyOf": [
           {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "The file's baseSha from the dry run (null = it did not exist). The confirm is refused if the file changed since, so it never reverts someone else's edit"
         },
         "content": {
          "description": "The full new file content",
          "maxLength": 524288,
          "type": "string"
         },
         "path": {
          "description": "Repo-relative path the recipe allows",
          "maxLength": 400,
          "minLength": 1,
          "type": "string"
         },
         "reason": {
          "maxLength": 200,
          "type": "string"
         }
        },
        "required": [
         "path",
         "content"
        ],
        "type": "object"
       },
       "maxItems": 30,
       "minItems": 1,
       "type": "array"
      },
      "projectId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      }
     },
     "required": [
      "projectId",
      "edits"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "confirm": {
    "description": "true opens one draft PR per repo; omitted or false is a dry run",
    "type": "boolean"
   },
   "element": {
    "description": "Which part of the recipe the edit belongs to",
    "enum": [
     "design",
     "gates",
     "env",
     "routes",
     "store",
     "release"
    ],
    "type": "string"
   },
   "organizationId": {
    "description": "Organization UUID \u2014 defaults to the key owner's only organization",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "element",
   "changes"
  ],
  "type": "object"
 },
 "name": "propose_portfolio_change",
 "title": "Fix once across apps (draft PRs)"
}
