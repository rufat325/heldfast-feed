{
 "description": "Register a custom template at runtime for immediate use with render_page/preview_html",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "default": "custom",
    "description": "Template category",
    "type": "string"
   },
   "css": {
    "description": "Built-in CSS for the template",
    "type": "string"
   },
   "description": {
    "description": "Template description",
    "type": "string"
   },
   "html_template": {
    "description": "doT.js HTML template string with {{=it.content}} placeholder",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Template name (alphanumeric, hyphens, underscores allowed)",
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
    "type": "string"
   }
  },
  "required": [
   "name",
   "description",
   "html_template"
  ],
  "type": "object"
 },
 "name": "register_template"
}
