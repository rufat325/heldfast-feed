{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Add a reply inside a forum post.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "embeds": {
    "description": "Up to 10 embeds.",
    "items": {
     "properties": {
      "color": {
       "description": "Hex color like #5865f2.",
       "type": "string"
      },
      "description": {
       "maxLength": 4096,
       "type": "string"
      },
      "title": {
       "maxLength": 256,
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "post": {
    "description": "Post title or thread ID.",
    "type": "string"
   }
  },
  "required": [
   "post",
   "content"
  ],
  "type": "object"
 },
 "name": "reply_to_forum_post",
 "title": "Reply to forum post"
}
