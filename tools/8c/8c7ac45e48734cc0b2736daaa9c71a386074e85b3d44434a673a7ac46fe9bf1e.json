{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Calorie and Macro Calculator"
 },
 "description": "Calculate resting energy and daily calories from adult measurements, formula and activity level. (API Tool Calls, by Cowerx)",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "properties": {
      "method": {
       "enum": [
        "katch"
       ],
       "type": "string"
      }
     },
     "required": [
      "method"
     ]
    }
   },
   {
    "required": [
     "bodyFat"
    ]
   }
  ],
  "examples": [
   {
    "age": 30,
    "height": 180,
    "sex": "male",
    "weight": 80
   }
  ],
  "oneOf": [
   {
    "properties": {
     "units": {
      "enum": [
       "metric"
      ],
      "type": "string"
     }
    },
    "required": [
     "height"
    ]
   },
   {
    "properties": {
     "units": {
      "enum": [
       "imperial"
      ],
      "type": "string"
     }
    },
    "required": [
     "units",
     "feet",
     "inches"
    ]
   }
  ],
  "properties": {
   "activity": {
    "default": 1.2,
    "enum": [
     1.2,
     1.375,
     1.55,
     1.725,
     1.9
    ],
    "type": "number"
   },
   "age": {
    "description": "Adult age in years",
    "maximum": 120,
    "minimum": 18,
    "type": "number"
   },
   "bodyFat": {
    "description": "Body fat percentage",
    "exclusiveMaximum": 100,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "feet": {
    "description": "Imperial height in whole feet",
    "minimum": 0,
    "type": "integer"
   },
   "height": {
    "description": "Metric height in centimetres",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "inches": {
    "description": "Imperial additional inches",
    "exclusiveMaximum": 12,
    "minimum": 0,
    "type": "number"
   },
   "method": {
    "default": "mifflin",
    "enum": [
     "mifflin",
     "harris",
     "katch"
    ],
    "type": "string"
   },
   "sex": {
    "enum": [
     "male",
     "female"
    ],
    "type": "string"
   },
   "units": {
    "default": "metric",
    "enum": [
     "metric",
     "imperial"
    ],
    "type": "string"
   },
   "weight": {
    "description": "kg or lb by units",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "sex",
   "age",
   "weight"
  ],
  "type": "object"
 },
 "name": "calorie_calculator",
 "outputSchema": {
  "description": "resting and daily kcal/day, methodLabel, activity",
  "type": "object"
 },
 "title": "Calorie and Macro Calculator"
}
