{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Optimize Etsy Listing"
 },
 "description": "Use this when the user wants to rewrite an existing Etsy title, description, or tags based on audit findings. A re-audit gate prevents score regression. Uses one generation from the monthly quota.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Current Etsy listing description",
    "maxLength": 20000,
    "type": "string"
   },
   "mode": {
    "description": "Which fields to rewrite (default: full)",
    "enum": [
     "full",
     "title_only",
     "description_only",
     "tags_only"
    ],
    "type": "string"
   },
   "product_name": {
    "description": "Short product description, e.g. \"handmade ceramic coffee mug, speckled glaze, 12oz\"",
    "maxLength": 300,
    "minLength": 2,
    "type": "string"
   },
   "tags": {
    "description": "Current Etsy tags",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "title": {
    "description": "Current Etsy listing title",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "seerxo_optimize_listing",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "additionalProperties": false,
    "description": "Audit summary after optimization.",
    "properties": {
     "overallScore": {
      "$ref": "#/properties/before/properties/overallScore"
     },
     "scoreType": {
      "$ref": "#/properties/before/properties/scoreType"
     },
     "scoringVersion": {
      "$ref": "#/properties/before/properties/scoringVersion"
     },
     "seoScore": {
      "$ref": "#/properties/before/properties/seoScore"
     },
     "subScores": {
      "$ref": "#/properties/before/properties/subScores"
     },
     "weakPoints": {
      "$ref": "#/properties/before/properties/weakPoints"
     }
    },
    "required": [
     "scoringVersion",
     "scoreType",
     "overallScore",
     "seoScore",
     "subScores",
     "weakPoints"
    ],
    "type": "object"
   },
   "before": {
    "additionalProperties": false,
    "description": "Audit summary before optimization.",
    "properties": {
     "overallScore": {
      "description": "Deterministic Listing Readiness score from 0 to 100.",
      "type": "number"
     },
     "scoreType": {
      "const": "listing_readiness",
      "type": "string"
     },
     "scoringVersion": {
      "const": "etsy-guidance-2026-04-27",
      "type": "string"
     },
     "seoScore": {
      "description": "Deprecated compatibility alias for overallScore.",
      "type": "number"
     },
     "subScores": {
      "additionalProperties": false,
      "properties": {
       "completeness": {
        "description": "Listing completeness score from 0 to 100.",
        "type": "number"
       },
       "description": {
        "description": "Description readiness from 0 to 100.",
        "type": "number"
       },
       "tags": {
        "description": "Tag readiness from 0 to 100.",
        "type": "number"
       },
       "title": {
        "description": "Title readiness from 0 to 100.",
        "type": "number"
       }
      },
      "required": [
       "title",
       "tags",
       "description",
       "completeness"
      ],
      "type": "object"
     },
     "weakPoints": {
      "description": "Ranked, sourced readiness findings and fixes.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "explanation": {
         "description": "Why the deterministic rule produced this finding.",
         "type": "string"
        },
        "field": {
         "description": "Listing field that needs improvement.",
         "type": "string"
        },
        "fix": {
         "description": "Concrete action that resolves the finding.",
         "type": "string"
        },
        "id": {
         "description": "Stable identifier for the failed SEO check.",
         "type": "string"
        },
        "reason": {
         "description": "Human-readable explanation of the finding.",
         "type": "string"
        },
        "ruleId": {
         "description": "Version-stable rule identifier.",
         "type": "string"
        },
        "severity": {
         "description": "Priority of the finding.",
         "enum": [
          "high",
          "medium",
          "low"
         ],
         "type": "string"
        },
        "source": {
         "additionalProperties": false,
         "description": "Official Etsy source connected to this finding.",
         "properties": {
          "id": {
           "type": "string"
          },
          "source": {
           "type": "string"
          },
          "title": {
           "type": "string"
          },
          "url": {
           "format": "uri",
           "type": "string"
          }
         },
         "required": [
          "id",
          "source",
          "title",
          "url"
         ],
         "type": "object"
        }
       },
       "required": [
        "id",
        "ruleId",
        "field",
        "severity",
        "reason",
        "explanation",
        "fix",
        "source"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "scoringVersion",
     "scoreType",
     "overallScore",
     "seoScore",
     "subScores",
     "weakPoints"
    ],
    "type": "object"
   },
   "diff": {
    "additionalProperties": false,
    "description": "Before and after values for each listing field.",
    "properties": {
     "description": {
      "additionalProperties": false,
      "properties": {
       "after": {
        "type": "string"
       },
       "before": {
        "type": "string"
       }
      },
      "required": [
       "before",
       "after"
      ],
      "type": "object"
     },
     "tags": {
      "additionalProperties": false,
      "properties": {
       "after": {
        "$ref": "#/properties/diff/properties/tags/properties/before"
       },
       "before": {
        "items": {
         "$ref": "#/properties/optimized/properties/tags/items"
        },
        "type": "array"
       }
      },
      "required": [
       "before",
       "after"
      ],
      "type": "object"
     },
     "title": {
      "additionalProperties": false,
      "properties": {
       "after": {
        "type": "string"
       },
       "before": {
        "type": "string"
       }
      },
      "required": [
       "before",
       "after"
      ],
      "type": "object"
     }
    },
    "required": [
     "title",
     "description",
     "tags"
    ],
    "type": "object"
   },
   "fallback": {
    "description": "Whether the original listing was kept to prevent a score regression.",
    "type": "boolean"
   },
   "mode": {
    "description": "Optimization mode that was applied.",
    "enum": [
     "full",
     "title_only",
     "description_only",
     "tags_only"
    ],
    "type": "string"
   },
   "optimized": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "description": "Etsy listing description.",
      "type": "string"
     },
     "tags": {
      "description": "Etsy listing tags.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "description": "Etsy listing title.",
      "type": "string"
     }
    },
    "required": [
     "title",
     "description",
     "tags"
    ],
    "type": "object"
   },
   "resolved": {
    "description": "Finding IDs resolved by the rewrite.",
    "items": {
     "$ref": "#/properties/optimized/properties/tags/items"
    },
    "type": "array"
   },
   "unresolved": {
    "description": "Finding IDs still present after the rewrite.",
    "items": {
     "$ref": "#/properties/optimized/properties/tags/items"
    },
    "type": "array"
   },
   "usage": {
    "additionalProperties": false,
    "properties": {
     "dailyLimit": {
      "description": "Daily generation limit when one applies.",
      "type": "number"
     },
     "dailyRemaining": {
      "description": "Generations remaining today when a daily limit applies.",
      "type": "number"
     },
     "limit": {
      "description": "Monthly generation limit.",
      "type": "number"
     },
     "remaining": {
      "description": "Generations remaining this month.",
      "type": "number"
     },
     "tier": {
      "description": "Seerxo account tier.",
      "type": "string"
     },
     "usageByChannel": {
      "additionalProperties": false,
      "properties": {
       "mcp": {
        "description": "Generations used through MCP.",
        "type": "number"
       },
       "web": {
        "description": "Generations used through the web app.",
        "type": "number"
       }
      },
      "required": [
       "mcp",
       "web"
      ],
      "type": "object"
     }
    },
    "required": [
     "limit",
     "remaining",
     "tier",
     "usageByChannel"
    ],
    "type": "object"
   }
  },
  "required": [
   "before",
   "optimized",
   "after",
   "resolved",
   "unresolved",
   "diff",
   "fallback",
   "mode",
   "usage"
  ],
  "type": "object"
 },
 "title": "Optimize Etsy listing"
}
