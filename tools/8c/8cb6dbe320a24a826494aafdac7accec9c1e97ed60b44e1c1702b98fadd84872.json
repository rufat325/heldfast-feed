{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "XRP balance, sequence, owner count, transfer rate and trust lines (capped) for an account. When to use: To inspect an account before building a transaction for it. Prefer another tool: Not for transaction history, reserves or account flags; it is a summary, not a full account dump. Example: xrpl_account_summary {\"address\":\"rHb9CJAWyB4rj91VRWn96DkukG4bwdtyTh\"}",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "description": "Valid classic XRPL account address (r..., checksum verified)",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "xrpl_account_summary",
 "outputSchema": {
  "$defs": {
   "Meta": {
    "additionalProperties": false,
    "properties": {
     "age_seconds": {
      "description": "Age of the data at response time",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "as_of": {
      "description": "When the data was read from the ledger",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
     },
     "cache": {
      "enum": [
       "hit",
       "miss",
       "stale"
      ],
      "type": "string"
     },
     "ledger_index": {
      "description": "Validated ledger the data comes from",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "stale": {
      "description": "True when served past its fresh TTL (stale-on-error)",
      "type": "boolean"
     }
    },
    "required": [
     "ledger_index",
     "as_of",
     "age_seconds",
     "cache",
     "stale"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "address": {
    "type": "string"
   },
   "balance_xrp": {
    "description": "Decimal string",
    "type": "string"
   },
   "lines_truncated": {
    "type": "boolean"
   },
   "meta": {
    "$ref": "#/$defs/Meta"
   },
   "owner_count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "sequence": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "transfer_rate": {
    "description": "Issuer TransferRate, 1000000000 = no fee",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "trust_lines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "balance": {
       "description": "Decimal string",
       "type": "string"
      },
      "currency": {
       "type": "string"
      },
      "issuer": {
       "type": "string"
      },
      "limit": {
       "description": "Decimal string",
       "type": "string"
      }
     },
     "required": [
      "currency",
      "issuer",
      "balance",
      "limit"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "address",
   "balance_xrp",
   "sequence",
   "owner_count",
   "transfer_rate",
   "trust_lines",
   "lines_truncated",
   "meta"
  ],
  "type": "object"
 },
 "title": "Account summary"
}
