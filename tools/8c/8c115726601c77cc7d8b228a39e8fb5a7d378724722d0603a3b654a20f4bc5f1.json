{
 "description": "Expand a seed with free Google Autocomplete suggestions and optionally cross-reference Search Console rankings; no extra API key needed",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "description": "Autocomplete country passed as gl",
    "pattern": "^[a-z]{2}$",
    "type": "string"
   },
   "days": {
    "default": 90,
    "description": "Search Console lookback window in days",
    "maximum": 480,
    "minimum": 1,
    "type": "integer"
   },
   "expansions": {
    "default": [
     "alphabet",
     "questions",
     "prepositions",
     "comparisons"
    ],
    "description": "Suggestion expansion families to run beyond the bare seed",
    "items": {
     "enum": [
      "alphabet",
      "questions",
      "prepositions",
      "comparisons"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "language": {
    "default": "en",
    "description": "Autocomplete interface language passed as hl",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Maximum keyword ideas to return",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "seed": {
    "description": "Seed keyword to expand",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "siteUrl": {
    "description": "Optional Search Console property used to identify queries already ranking",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "seed"
  ],
  "type": "object"
 },
 "name": "keyword_ideas",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "crossReferenced": {
    "type": "boolean"
   },
   "gscMatched": {
    "type": "number"
   },
   "ideas": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "family": {
       "enum": [
        "seed",
        "alphabet",
        "questions",
        "prepositions",
        "comparisons"
       ],
       "type": "string"
      },
      "gsc": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "clicks": {
           "type": "number"
          },
          "impressions": {
           "type": "number"
          },
          "position": {
           "type": "number"
          }
         },
         "required": [
          "position",
          "clicks",
          "impressions"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "keyword": {
       "type": "string"
      }
     },
     "required": [
      "keyword",
      "family",
      "gsc"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "requestFailures": {
    "type": "number"
   },
   "returned": {
    "type": "number"
   },
   "seed": {
    "type": "string"
   },
   "totalFound": {
    "type": "number"
   }
  },
  "required": [
   "seed",
   "totalFound",
   "returned",
   "requestFailures",
   "gscMatched",
   "crossReferenced",
   "ideas"
  ],
  "type": "object"
 }
}
