{
 "_meta": {
  "openai/toolInvocation/invoked": "Artifacts listed",
  "openai/toolInvocation/invoking": "Listing your Artifacts\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List your Artifacts"
 },
 "description": "List Artifacts you own (scope owned, the default), ones shared with you (shared), or both (all), newest first. Each item carries its id, title, who can open it, and its URL.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "next_cursor from a prior page.",
    "type": "string"
   },
   "limit": {
    "description": "Page size, default 25.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "scope": {
    "description": "Default owned.",
    "enum": [
     "owned",
     "shared",
     "all"
    ],
    "type": "string"
   },
   "type": {
    "description": "Only this type.",
    "enum": [
     "html",
     "markdown",
     "presentation"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_artifacts",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "properties": {
      "artifact_id": {
       "type": "string"
      },
      "audience_mode": {
       "description": "Who can open it: owner, users, org, or public.",
       "type": "string"
      },
      "created_at": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "discoverability": {
       "enum": [
        "unlisted",
        "listed"
       ],
       "type": "string"
      },
      "group_id": {
       "type": "string"
      },
      "icon": {
       "type": "string"
      },
      "icon_image_url": {
       "description": "The page icon set with icon_image; null for the Bisque icon.",
       "type": [
        "string",
        "null"
       ]
      },
      "latest_version_id": {
       "type": "string"
      },
      "organization_id": {
       "type": "string"
      },
      "published_version_id": {
       "description": "The Version viewers see; null until a publication is ready.",
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "type": {
       "enum": [
        "html",
        "markdown",
        "presentation"
       ],
       "type": "string"
      },
      "updated_at": {
       "type": "string"
      },
      "url": {
       "description": "The viewer page.",
       "type": "string"
      },
      "viewer_version_mode": {
       "enum": [
        "latest",
        "pinned"
       ],
       "type": "string"
      }
     },
     "required": [
      "artifact_id",
      "type",
      "title",
      "audience_mode",
      "discoverability",
      "published_version_id",
      "url"
