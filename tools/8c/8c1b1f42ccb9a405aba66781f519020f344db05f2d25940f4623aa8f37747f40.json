     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "items",
   "next_cursor"
  ],
  "type": "object"
 },
 "title": "List your Artifacts"
}
