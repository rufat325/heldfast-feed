{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "mcp"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search Recent News"
 },
 "description": "Search recent news articles from NewsAPI and The Guardian and return them as structured results.\n\nCoverage: recent events, people, and topics (post-May-2025). Does NOT cover timeless topics (history, geography, science).\n\nReturns: article title, source, author, date, URL, description, and image URL per result.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "description": "Max results per provider (default 5)",
    "maximum": 15,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "News search query (e.g. 'Iran war 2026', 'Australian Open final', 'UK election')",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "clipform_search_news",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "articles": {
    "description": "Matching articles (empty if none)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "image_url": {
       "type": "string"
      },
      "published_at": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   }
  },
  "required": [
   "query",
   "articles"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Search Recent News"
}
