{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Create a copy of a file.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fileId": {
    "description": "The ID of the file to copy",
    "type": "string"
   },
   "name": {
    "description": "Name for the copy. If not specified, uses \"Copy of [original name]\"",
    "type": "string"
   },
   "parents": {
    "description": "Parent folder IDs for the copy",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "supportsAllDrives": {
    "default": true,
    "description": "Support shared drives",
    "type": "boolean"
   }
  },
  "required": [
   "fileId"
  ],
  "type": "object"
 },
 "name": "file_copy",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "id": {
    "type": "string"
   },
   "mimeType": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "parents": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "webViewLink": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "mimeType"
  ],
  "type": "object"
 },
 "title": "Copy file"
}
