{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "Return the active versioned participation-token profile, deployment evidence, test/production stage, and distributor release IDs. This is separate from live market collateral discovery.",
 "inputSchema": {
  "properties": {},
  "type": "object"
 },
 "name": "problee_get_token_release",
 "outputSchema": {
  "$defs": {
   "DiscoverTokenReleaseResponse": {
    "additionalProperties": false,
    "properties": {
     "deployed": {
      "type": "boolean"
     },
     "distributors": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "address": {
         "$ref": "#/$defs/EvmAddress"
        },
        "chainId": {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        "deploymentBlockHash": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "deploymentTxHash": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "distributorEpoch": {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        "fromBlock": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "releaseId": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "runtimeCodeHash": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "tokenAddress": {
         "$ref": "#/$defs/EvmAddress"
        }
       },
       "required": [
        "chainId",
        "address",
        "fromBlock",
        "deploymentTxHash",
        "deploymentBlockHash",
        "runtimeCodeHash",
        "releaseId",
        "distributorEpoch",
        "tokenAddress"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "origin": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "address": {
          "$ref": "#/$defs/EvmAddress"
         },
         "chainId": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         "deploymentBlockHash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
         },
         "deploymentTxHash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
         },
         "fromBlock": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "runtimeCodeHash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
         }
        },
        "required": [
         "chainId",
         "address",
         "fromBlock",
         "deploymentTxHash",
         "deploymentBlockHash",
         "runtimeCodeHash"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "profileId": {
      "minLength": 1,
      "type": "string"
     },
     "representations": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "address": {
         "$ref": "#/$defs/EvmAddress"
        },
        "bridgeAdapterAddress": {
         "anyOf": [
          {
           "$ref": "#/$defs/EvmAddress"
          },
          {
           "type": "null"
          }
         ]
        },
        "chainId": {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        "deploymentBlockHash": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "deploymentTxHash": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        },
        "fromBlock": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "originChainId": {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        "originTokenAddress": {
         "$ref": "#/$defs/EvmAddress"
        },
        "runtimeCodeHash": {
         "pattern": "^0x[0-9a-fA-F]{64}$",
         "type": "string"
        }
       },
       "required": [
        "chainId",
        "address",
        "fromBlock",
        "deploymentTxHash",
        "deploymentBlockHash",
        "runtimeCodeHash",
        "originChainId",
        "originTokenAddress",
        "bridgeAdapterAddress"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "stage": {
      "enum": [
       "test",
       "production"
      ],
      "type": "string"
     },
     "token": {
      "additionalProperties": false,
      "properties": {
       "decimals": {
        "maximum": 30,
        "minimum": 0,
        "type": "integer"
       },
       "disclaimer": {
        "type": [
         "string",
         "null"
        ]
       },
       "logoPath": {
        "minLength": 1,
        "type": "string"
       },
       "name": {
        "minLength": 1,
        "type": "string"
       },
       "symbol": {
        "minLength": 1,
        "type": "string"
       },
       "totalSupplyWei": {
        "pattern": "^\\d+$",
        "type": "string"
       }
      },
      "required": [
       "name",
       "symbol",
       "decimals",
       "totalSupplyWei",
       "logoPath",
       "disclaimer"
      ],
      "type": "object"
     }
    },
    "required": [
     "profileId",
     "stage",
     "deployed",
     "token",
     "origin",
     "representations",
     "distributors"
    ],
    "type": "object"
   },
   "EvmAddress": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/DiscoverTokenReleaseResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Get the active participation-token release manifest"
}
