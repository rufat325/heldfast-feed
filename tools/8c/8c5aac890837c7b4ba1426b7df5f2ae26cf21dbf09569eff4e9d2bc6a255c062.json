{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Clear specific run-level formatting (bold, italic, underline, highlight, color, font) from paragraphs. Surface: revisionable \u2014 clearing emits a native run-property-change revision (w:rPrChange).",
 "emitsNonRevisionChanges": false,
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "clear_bold": {
    "description": "Remove bold formatting.",
    "type": "boolean"
   },
   "clear_color": {
    "description": "Remove font color.",
    "type": "boolean"
   },
   "clear_font": {
    "description": "Remove font family and size.",
    "type": "boolean"
   },
   "clear_highlight": {
    "description": "Remove highlight formatting.",
    "type": "boolean"
   },
   "clear_italic": {
    "description": "Remove italic formatting.",
    "type": "boolean"
   },
   "clear_underline": {
    "description": "Remove underline formatting.",
    "type": "boolean"
   },
   "file_path": {
    "description": "Path to the DOCX or ODT file.",
    "type": "string"
   },
   "paragraph_ids": {
    "description": "Paragraph IDs to clear formatting from. If omitted, clears from all paragraphs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "file_path"
  ],
  "type": "object"
 },
 "name": "clear_formatting",
 "surface": "revisionable"
}
