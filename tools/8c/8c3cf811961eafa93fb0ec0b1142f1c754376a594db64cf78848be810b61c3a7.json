{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find places to stay"
 },
 "description": "Places to stay near a ski or beach resort (or any 'lat,lon') for given dates and party: live nightly prices, ratings and photos where available, filtered by budget, homes from local property managers booked direct (no booking-site fee) where Veabird has them, plus hotel and vacation-rental searches.",
 "inputSchema": {
  "properties": {
   "adults": {
    "description": "Adults (default 2).",
    "maximum": 16,
    "minimum": 1,
    "type": "integer"
   },
   "checkin": {
    "description": "YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "checkout": {
    "description": "YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "childrenAges": {
    "description": "Ages of children traveling, e.g. [6, 9].",
    "items": {
     "maximum": 17,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 8,
    "type": "array"
   },
   "limit": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "maxPricePerNight": {
    "description": "Lodging budget per night for the whole party, in USD.",
    "maximum": 20000,
    "minimum": 20,
    "type": "number"
   },
   "near": {
    "description": "Ski or beach resort name/id, or 'lat,lon'.",
    "type": "string"
   },
   "radiusMiles": {
    "description": "Search radius (default 5).",
    "maximum": 30,
    "minimum": 0.5,
    "type": "number"
   },
   "rooms": {
    "description": "Rooms needed (default 1).",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "near",
   "checkin",
   "checkout"
  ],
  "type": "object"
 },
 "name": "find_lodging",
 "title": "Find places to stay"
}
