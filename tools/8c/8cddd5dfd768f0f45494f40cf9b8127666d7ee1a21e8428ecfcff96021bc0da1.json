{
 "description": "Bulk-delete selected product records permanently. Only call after the user explicitly confirms. A product an open order or a page block still references is skipped rather than deleted; report every entry of `skipped` back to the user, with its reason.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "modelId": {
    "description": "Product model id",
    "minLength": 1,
    "type": "string"
   },
   "selection": {
    "properties": {
     "allMatching": {
      "description": "Target every record matching filter (ignores ids)",
      "type": "boolean"
     },
     "filter": {
      "properties": {
       "hasVariants": {
        "type": "boolean"
       },
       "priceMax": {
        "type": "number"
       },
       "priceMin": {
        "type": "number"
       },
       "search": {
        "type": "string"
       },
       "status": {
        "type": "string"
       },
       "stockState": {
        "enum": [
         "in",
         "low",
         "out"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "ids": {
      "description": "Explicit record ids",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "modelId",
   "selection"
  ],
  "type": "object"
 },
 "name": "bulk_delete_products"
}
