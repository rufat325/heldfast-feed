 "description": "Use this when the user asks what an employee costs the employer in a country beyond the gross salary: employer social security contributions, payroll taxes, pension, health or accident insurance, mandatory levies, or the total cost of employment (e.g. \"how much does it cost to employ a developer in Germany at 80k\", \"employer charges in Spain\", \"co\u00fbt employeur d'un salari\u00e9 en Pologne\"). Returns each statutory employer contribution with its rate, base, ceiling, source (official wherever one exists) and check date, then the monthly and annual total and its percent of gross, before any Employer of Record fee. A total the country declares as a floor or a ceiling is written \"at least\" or \"at most\". A monthly salary is passed as the user gives it, with salary_period \"month\": the country's statutory 13th or 14th month is then applied (e.g. \"a hire at 4,000 a month in Madrid\", \"un salari\u00e9 pay\u00e9 2 500 par mois \u00e0 Lisbonne\"). Do not use for an employee's net pay or income tax, for legal advice, or for the fees of a provider. Amounts given in the local currency come back in it, with the USD in brackets. Data snapshot 2026-10-13. Cost comparison, not legal or tax advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assumptions": {
    "additionalProperties": {
     "type": "number"
    },
    "description": "Override an adjustable assumption the country declares, e.g. {\"basic_share_of_gross\": 0.6}. See `assumptions` in an employer_cost answer.",
    "type": "object"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 code (\"DE\") or country name (\"Germany\")",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "include_notes": {
    "default": false,
    "description": "Include the long legal note behind each line",
    "type": "boolean"
   },
   "payments_per_year": {
    "description": "With salary_period \"month\" only: the total number of monthly salaries the contract pays in a year, statutory ones included (e.g. 14). Omit to use the statutory number of the country.",
    "maximum": 16,
    "minimum": 12,
    "type": "number"
   },
   "salary": {
    "description": "Gross salary, a year unless salary_period is \"month\". Omit to use the country's example salary.",
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "number"
   },
   "salary_currency": {
    "default": "USD",
    "description": "Currency of `salary`: USD, or the local currency of the country",
    "enum": [
     "USD",
     "local"
    ],
    "type": "string"
   },
   "salary_period": {
    "default": "year",
    "description": "Whether the salary is a year (default) or a month. Pass a monthly salary as the user gives it, with \"month\": the statutory number of monthly payments of the country (13th, 14th month) is applied, see salary_basis in the answer.",
    "enum": [
     "year",
     "month"
    ],
    "type": "string"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
