{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Recent activity across the signed-in student's active ELMS (Canvas) courses: new announcements, discussion posts, grades and messages. Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 20,
    "description": "Maximum number of records to return, 1-50 (default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "elms_get_activity_stream",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "description": "Newest first",
    "items": {
     "additionalProperties": false,
     "properties": {
      "course_id": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "created_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "message": {
       "description": "Activity text, converted from HTML to plain text; null when empty",
       "type": [
        "string",
        "null"
       ]
      },
      "read": {
       "type": "boolean"
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "type": {
       "enum": [
        "DiscussionTopic",
        "DiscussionEntry",
        "Announcement",
        "Conversation",
        "Message",
        "Submission",
        "Conference",
        "Collaboration",
        "AssessmentRequest"
       ],
       "type": "string"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "type",
      "title",
      "message",
      "created_at",
      "course_id",
      "read",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "title": "Get ELMS activity stream"
}
