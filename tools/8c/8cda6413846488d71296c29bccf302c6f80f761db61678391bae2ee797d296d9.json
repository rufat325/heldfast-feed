       },
       {
        "type": "null"
       }
      ]
     },
     "videos": {
      "description": "Video links for the product page (YouTube, Vimeo or a direct file), https only, at most 5. Links, not uploads. On update, sending the field replaces the whole list.",
      "example": [
       {
        "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
       }
      ],
      "items": {
       "properties": {
        "url": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
        "url"
       ],
       "type": "object"
      },
      "maxItems": 5,
      "type": "array"
     },
     "warehouseId": {
      "anyOf": [
       {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "weight": {
      "anyOf": [
       {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "minLength": 1,
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "weightUnit": {
      "anyOf": [
       {
        "enum": [
         "kg",
         "g",
         "lb",
         "oz"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "width": {
      "anyOf": [
       {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "minLength": 1,
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   }
  },
  "required": [
   "id",
   "patch"
  ],
  "type": "object"
 },
 "name": "update_product",
 "title": "Update product"
}
