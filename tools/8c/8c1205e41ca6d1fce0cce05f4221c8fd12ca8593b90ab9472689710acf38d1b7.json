{
 "description": "Validate a graph and return a signed quote and payment offers. No work or payment. Free steps require no wallet; paid steps require buyer wallet address. Use gas_mode=required to demand gas sponsorship or auto to prefer it. Inspect ready/blockers and gas_sponsorship. Sign offers LOCALLY, never provide a private key. Then call pipeline_invoke.",
 "inputSchema": {
  "$defs": {
   "StudioNode": {
    "description": "One hop of a studio blueprint \u2014 the executor's node shape, validated here too.",
    "properties": {
     "capability_id": {
      "maxLength": 80,
      "minLength": 2,
      "title": "Capability Id",
      "type": "string"
     },
     "depends_on": {
      "items": {
       "type": "string"
      },
      "maxItems": 16,
      "title": "Depends On",
      "type": "array"
     },
     "id": {
      "default": "",
      "maxLength": 64,
      "title": "Id",
      "type": "string"
     },
     "input": {
      "additionalProperties": true,
      "title": "Input",
      "type": "object"
     },
     "input_from": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Input From"
     },
     "product_id": {
      "maxLength": 80,
      "minLength": 2,
      "title": "Product Id",
      "type": "string"
     },
     "source_hub": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source Hub"
     }
    },
    "required": [
     "product_id",
     "capability_id"
    ],
    "title": "StudioNode",
    "type": "object"
   }
  },
  "properties": {
   "gas_mode": {
    "default": "buyer",
    "enum": [
     "buyer",
     "auto",
     "required"
    ],
    "title": "Gas Mode",
    "type": "string"
   },
   "max_budget_usd": {
    "anyOf": [
     {
      "maximum": 100000,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Max Budget Usd"
   },
   "nodes": {
    "items": {
     "$ref": "#/$defs/StudioNode"
    },
    "maxItems": 16,
    "minItems": 1,
    "title": "Nodes",
    "type": "array"
   },
   "wallet": {
    "default": "0x0000000000000000000000000000000000000000",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "title": "Wallet",
    "type": "string"
   }
  },
  "required": [
   "nodes"
  ],
  "title": "PrepareGraph",
  "type": "object"
 },
 "name": "pipeline_prepare"
}
