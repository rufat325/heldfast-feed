  "readOnlyHint": true,
  "title": "Quote an LLC owner lookup"
 },
 "description": "Use to find who is behind an LLC or company, for example the LLC that owns a property: its officers or managers, registered agent and formation details from public business records. Free: this tool only returns a quote and never spends credits. The quote states the credit cost (charged only if the company is found) and what that state's public records show; some states list the company but not its officers. Tell the user the cost and that note, and ask. Only after the user agrees, call run_llc_owner_lookup with the quote_id. Pass the company's exact registered name and the state where it is registered.",
 "inputSchema": {
  "properties": {
   "entityName": {
    "description": "The company's registered name, as on the deed or tax record, e.g. \"Sunrise Holdings LLC\".",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "state": {
    "description": "Two-letter US state where the company is registered, e.g. FL. Often the state of the property.",
