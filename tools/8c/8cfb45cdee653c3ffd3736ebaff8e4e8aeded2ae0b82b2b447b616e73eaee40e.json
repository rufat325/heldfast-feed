{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get the current status of a workflow and all its steps. Each call may advance the workflow by dispatching steps whose dependencies have completed. Poll every 5\u201310 seconds until status is COMPLETED, FAILED, PARTIALLY_FAILED, or CANCELLED.",
 "inputSchema": {
  "properties": {
   "workflow_id": {
    "description": "Workflow ID returned by submit_workflow.",
    "type": "string"
   }
  },
  "required": [
   "workflow_id"
  ],
  "type": "object"
 },
 "name": "get_workflow_status",
 "outputSchema": {
  "properties": {
   "completed_at": {
    "description": "ISO timestamp when workflow reached terminal state.",
    "type": "string"
   },
   "status": {
    "enum": [
     "QUEUED",
     "PROCESSING",
     "COMPLETED",
     "PARTIALLY_FAILED",
     "FAILED",
     "CANCELLED"
    ],
    "type": "string"
   },
   "steps": {
    "description": "Array of step status objects.",
    "type": "array"
   },
   "total_cost_usd": {
    "type": "number"
   },
   "workflow_id": {
    "type": "string"
   }
  },
  "required": [
   "workflow_id",
   "status"
  ],
  "type": "object"
 }
}
