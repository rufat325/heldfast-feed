{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Save or update one durable traveler memory for personalization. Use only for stable, travel-relevant preferences or constraints explicitly stated by the traveler.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "confidence": {
    "default": 0.8,
    "description": "Confidence in this memory. Use 1 for explicit user statements, lower for inferred patterns.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "key": {
    "description": "Stable normalized memory key. Choose the closest allowed key.",
    "enum": [
     "accessibility",
     "budget",
     "children",
     "diet",
     "guest_count",
     "language",
     "occasion",
     "pace",
     "pets",
     "room_features",
     "service_animal",
     "stay_length",
     "travel_party",
     "travel_purpose",
     "view"
    ],
    "type": "string"
   },
   "source": {
    "default": "USER_STATED",
    "enum": [
     "USER_STATED",
     "INFERRED",
     "BOOKING_HISTORY",
     "AGENT_NOTE"
    ],
    "type": "string"
   },
   "summary": {
    "description": "Short practical note, without speculation or sensitive details.",
    "maxLength": 240,
    "minLength": 8,
    "type": "string"
   },
   "travelerAssertion": {
    "description": "Current signed ATA traveler assertion matching travelerId; required on shared transports.",
    "type": "string"
   },
   "travelerId": {
    "description": "Verified traveler ID from the private traveler context.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "type": {
    "description": "Memory category.",
    "enum": [
     "PREFERENCE",
     "PROFILE_FACT",
     "TRAVEL_STYLE",
     "SERVICE_NOTE"
    ],
    "type": "string"
   },
   "value": {
    "description": "Small JSON value, e.g. {\"hasServiceDog\":true} or {\"typicalAdults\":2,\"typicalChildren\":1}."
   },
   "visibility": {
    "default": "AGENT_ONLY",
    "enum": [
     "AGENT_ONLY",
     "STAFF_VISIBLE",
     "USER_VISIBLE"
    ],
    "type": "string"
   }
  },
  "required": [
   "travelerId",
   "type",
   "key",
   "value",
   "summary"
  ],
  "type": "object"
 },
 "name": "suggest_traveler_memory"
}
