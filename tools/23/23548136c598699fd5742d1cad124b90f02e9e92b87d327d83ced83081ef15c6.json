{
 "description": "Lists issue groups for an app. Supports filtering by type (issue, crash, feedback) and status (open, resolved, closed). Use this instead of get_crashes or get_feedback when you need status filtering or combined results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "app_id": {
    "description": "The public app ID (e.g. 5X3c4veRGV) from list_apps",
    "type": "string"
   },
   "content": {
    "description": "Filter by issue body/content text.",
    "type": "string"
   },
   "date_range_end": {
    "description": "ISO 8601 datetime string (e.g. 2026-04-28T23:59:59Z)",
    "type": "string"
   },
   "date_range_start": {
    "description": "ISO 8601 datetime string (e.g. 2026-04-28T00:00:00Z)",
    "type": "string"
   },
   "issue_status": {
    "description": "Filter by status: new, open, in_progress, resolved, closed, muted",
    "type": "string"
   },
   "page": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "page_size": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "query": {
    "description": "Filter by issue title text.",
    "type": "string"
   },
   "type": {
    "description": "Filter by type: issue, crash, feedback",
    "type": "string"
   },
   "version": {
    "description": "Filter by app version ID.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "app_id"
  ],
  "type": "object"
 },
 "name": "list_issues"
}
