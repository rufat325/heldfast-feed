{
 "_meta": {
  "openai/outputTemplate": "ui://multilocale/project-overview-v2.html",
  "openai/toolInvocation/invoked": "MultiLocale project overview ready.",
  "openai/toolInvocation/invoking": "Loading MultiLocale project\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://multilocale/project-overview-v2.html"
  },
  "ui/resourceUri": "ui://multilocale/project-overview-v2.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show project overview"
 },
 "description": "Use this when someone wants a quick overview of one of their localization projects. Returns an overview card with the project's default locale, up to 24 configured locales and timestamps. Not for translation completeness.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "projectIdOrName": {
    "description": "Project id or name",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectIdOrName"
  ],
  "type": "object"
 },
 "name": "show_project_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 35,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "pattern": "^[0-9a-f]{24}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "localeCount": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "locales": {
        "items": {
         "maxLength": 35,
         "type": "string"
        },
        "maxItems": 24,
        "type": "array"
       },
       "localesTruncated": {
        "type": "boolean"
       },
       "name": {
        "maxLength": 128,
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "defaultLocale",
       "localeCount",
       "localesTruncated",
       "locales",
       "creationTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "title": "Show project overview"
}
