{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Publication and access of the shelf on explicit request only; DNS/TLS remain separate.",
 "inputSchema": {
  "properties": {
   "domaine": {
    "anyOf": [
     {
      "maxLength": 160,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Domaine"
   },
   "dry_run": {
    "default": false,
    "title": "Dry Run",
    "type": "boolean"
   },
   "expected_revision": {
    "pattern": "^[a-f0-9]{64}$",
    "title": "Expected Revision",
    "type": "string"
   },
   "password": {
    "default": "",
    "maxLength": 128,
    "title": "Password",
    "type": "string"
   },
   "protection": {
    "default": "keep",
    "enum": [
     "keep",
     "none",
     "password"
    ],
    "title": "Protection",
    "type": "string"
   },
   "shelf_id": {
    "pattern": "^[A-Za-z0-9_-]{1,64}$",
    "title": "Shelf Id",
    "type": "string"
   },
   "sous_domaine": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Sous Domaine"
   },
   "state": {
    "default": "keep",
    "enum": [
     "keep",
     "brouillon",
     "public",
     "protege"
    ],
    "title": "State",
    "type": "string"
   }
  },
  "required": [
   "shelf_id",
   "expected_revision"
  ],
  "title": "set_shelf_accessArguments",
  "type": "object"
 },
 "name": "foliade_set_shelf_access",
 "title": "Publish, protect or close a shelf"
}
