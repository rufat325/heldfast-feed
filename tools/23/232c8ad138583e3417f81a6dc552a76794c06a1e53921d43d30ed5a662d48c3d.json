{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search CourseProfiler's race catalog by race/course name and return direct CRSProf URLs that can be used as course sources.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum matches to return, default 5.",
    "type": "integer"
   },
   "query": {
    "description": "Race or course name to search, e.g. Val d'Aran PDA.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_race_catalog",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "asset_path": {
       "description": "Catalog CRSProf asset path.",
       "type": "string"
      },
      "confidence": {
       "description": "Catalog identity confidence. Weak matches require confirmation and must not be auto-used.",
       "enum": [
        "exact",
        "strong",
        "weak"
       ],
       "type": "string"
      },
      "country": {
       "description": "Race country, when available.",
       "type": "string"
      },
      "course": {
       "description": "Course name, when available.",
       "type": "string"
      },
      "crsprof_url": {
       "description": "Absolute CRSProf URL to use as course.source.url after event identity is confirmed.",
       "type": "string"
      },
      "date": {
       "description": "Race date, when available.",
       "type": "string"
      },
      "distance_meters": {
       "type": "integer"
      },
      "elevation_gain_meters": {
       "type": "integer"
      },
      "event_name": {
       "description": "Event name, when available.",
       "type": "string"
      },
      "id": {
       "description": "Catalog race ID.",
       "type": "string"
      },
      "location": {
       "description": "Race location, when available.",
       "type": "string"
      },
      "matched_tokens": {
       "description": "Distinctive query tokens matched against catalog identity fields.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "missing_query_tokens": {
       "description": "Distinctive query tokens not found in catalog identity fields.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "description": "Catalog race display name.",
       "type": "string"
      },
      "requires_confirmation": {
       "description": "True when event/course/location identity must be confirmed before using the CRSProf URL.",
       "type": "boolean"
      },
      "score": {
       "description": "Catalog match score.",
       "type": "integer"
      }
     },
     "required": [
      "name",
      "crsprof_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "description": "Search query.",
    "type": "string"
   }
  },
  "required": [
   "query",
   "matches"
  ],
  "type": "object"
 },
 "title": "Search race catalog"
}
