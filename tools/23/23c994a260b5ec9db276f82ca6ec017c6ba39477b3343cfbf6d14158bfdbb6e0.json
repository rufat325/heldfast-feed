{
 "description": "Group related deficiencies by control, flag combinations that may aggregate, and report the overall severity.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "deficiencyIds": {
    "items": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
     "type": "string"
    },
    "type": "array"
   },
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "engagementId"
  ],
  "type": "object"
 },
 "name": "aggregate_deficiencies",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "aggregation": {}
  },
  "required": [
   "aggregation"
  ],
  "type": "object"
 },
 "title": "Aggregate deficiencies"
}
