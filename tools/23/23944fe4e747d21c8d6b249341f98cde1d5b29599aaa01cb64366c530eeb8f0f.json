{
 "description": "Apply a suggestion returned by suggest_terms after the user accepted it: 'alias' merges the alias into the term, 'term' adds the term (aliases auto-suggested when none given), 'never' records the word as never-rewrite on the term, 'stale' removes the term. Pass the suggestion object back as received.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "scope": {
    "description": "Where to write: 'global' (default) or 'project'.",
    "enum": [
     "global",
     "project"
    ],
    "type": "string"
   },
   "suggestion": {
    "properties": {
     "alias": {
      "type": "string"
     },
     "aliases": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "canonical": {
      "minLength": 1,
      "type": "string"
     },
     "category": {
      "enum": [
       "brand",
       "person",
       "product",
       "acronym",
       "identifier",
       "place",
       "other"
      ],
      "type": "string"
     },
     "confidence": {
      "type": "number"
     },
     "count": {
      "type": "number"
     },
     "evidence": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "kind": {
      "enum": [
       "alias",
       "term",
       "never",
       "stale"
      ],
      "type": "string"
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "kind",
     "canonical"
    ],
    "type": "object"
   }
  },
  "required": [
   "suggestion"
  ],
  "type": "object"
 },
 "name": "apply_suggestion",
 "title": "Apply one suggestion"
}
