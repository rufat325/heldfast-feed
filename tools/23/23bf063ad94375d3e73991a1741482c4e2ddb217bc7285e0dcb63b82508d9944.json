{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Verify an email address"
 },
 "description": "Check one email's syntax, mail routing, disposable/free-provider/role flags, and SMTP recipient acceptance. Sends no email. DNS alone does not verify a mailbox. unknown means inconclusive or mailbox not checked; likely_deliverable is evidence, not a delivery guarantee. No login or API key required. Rate limited.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "email": {
    "maxLength": 320,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "email"
  ],
  "type": "object"
 },
 "name": "email_verify",
 "outputSchema": {
  "properties": {
   "checkedAt": {
    "format": "date-time",
    "type": "string"
   },
   "checks": {
    "properties": {
     "catchAll": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "disposable": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "freeProvider": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "mailRouting": {
      "enum": [
       "pass",
       "fail",
       "unknown",
       "not_checked"
      ],
      "type": "string"
     },
     "roleBased": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "smtp": {
      "enum": [
       "accepted",
       "rejected",
       "unknown",
       "not_checked"
      ],
      "type": "string"
     },
     "syntax": {
      "enum": [
       "pass",
       "fail",
       "unsupported"
      ],
      "type": "string"
     }
    },
    "required": [
     "syntax",
     "mailRouting",
     "disposable",
     "freeProvider",
     "roleBased",
     "smtp",
     "catchAll"
    ],
    "type": "object"
   },
   "email": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "status": {
    "enum": [
     "invalid",
     "unknown",
     "likely_deliverable",
     "accept_all"
    ],
    "type": "string"
   },
   "suggestion": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "email",
   "status",
   "reason",
   "checks",
   "suggestion",
   "checkedAt"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Verify an email address"
}
