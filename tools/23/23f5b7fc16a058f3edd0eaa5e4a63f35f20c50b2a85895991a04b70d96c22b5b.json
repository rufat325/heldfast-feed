   "category": {
    "description": "Category (spell, monster, class, item, feat, etc)",
    "type": "string"
   },
   "game": {
    "description": "Alias for system",
    "type": "string"
   },
   "page": {
    "description": "Page number (default 1)",
    "type": "number"
   },
   "pageSize": {
