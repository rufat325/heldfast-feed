{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Full recipe for one dish: steps, FAQ, image credit, and ingredients with PARSED quantities (amount, unit, and a normalised base in grams or millilitres where the quantity is measurable). Count-based lines like \"3 onions\" carry a gram estimate only where a per-item weight is known. Pass servings to rescale the ingredient quantities; the steps keep the original amounts. adaptations lists the diets (vegan, vegetarian, halal, dairy-free, pescatarian) the dish can be fully converted to, with each swap marked substitute (same dish) or adaptation (a different dish).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "lang": {
    "default": "en",
    "description": "Language for titles, ingredient names and URLs.",
    "enum": [
     "en",
     "tr",
     "de",
     "fr",
     "es",
     "it",
     "el"
    ],
    "type": "string"
   },
   "servings": {
    "description": "Rescale ingredient quantities to this many servings. The dish's own count is returned as original_servings. Steps are NOT rescaled: they keep the amounts of the original recipe.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "slug": {
    "description": "Recipe slug in any of the 7 languages, or a dish name (resolved by search).",
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_recipe",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "adaptations": {
    "description": "Diets this dish does not already fit but can be FULLY converted to - the adapt control shown on the recipe page. A diet is listed only when every disqualifying ingredient has a swap; partial conversions are never offered. Empty when the dish already fits every listed diet, or when no full conversion exists.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "diet": {
       "enum": [
        "vegan",
        "vegetarian",
        "halal",
        "dairy-free",
        "pescatarian"
       ],
       "type": "string"
      },
      "result": {
       "description": "same_dish when every swap is a like-for-like substitute; different_dish when at least one swap is an adaptation.",
       "enum": [
        "same_dish",
        "different_dish"
       ],
       "type": "string"
      },
      "swaps": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "ingredient": {
          "type": "string"
         },
         "kind": {
          "enum": [
           "substitute",
           "adaptation"
          ],
          "type": "string"
         },
         "replacement": {
          "type": "string"
         }
        },
        "required": [
         "ingredient",
         "replacement",
         "kind"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "diet",
      "result",
      "swaps"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "attribution": {
    "type": "string"
   },
   "calories": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "category": {
    "type": "string"
   },
   "country": {
    "type": "string"
   },
   "country_name": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "faq": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "answer": {
       "type": "string"
      },
      "question": {
       "type": "string"
      }
     },
     "required": [
      "question",
      "answer"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "form": {
    "type": [
     "string",
     "null"
    ]
   },
   "image": {
    "additionalProperties": false,
    "properties": {
     "ai_generated": {
      "type": "boolean"
     },
     "attribution": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "author": {
          "type": [
           "string",
           "null"
          ]
         },
         "license": {
          "type": [
           "string",
           "null"
          ]
         },
         "license_url": {
          "type": [
           "string",
           "null"
          ]
         },
         "source_url": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "author",
         "license",
         "license_url",
         "source_url"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "url",
     "ai_generated",
     "attribution"
    ],
    "type": "object"
   },
   "ingredients": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "type": [
        "number",
        "null"
       ]
      },
      "base": {
       "type": [
        "number",
        "null"
       ]
      },
      "base_unit": {
       "type": [
        "string",
        "null"
       ]
      },
      "canonical": {
       "type": [
        "string",
        "null"
       ]
      },
      "grams_estimate": {
       "type": [
        "number",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "quantity_text": {
       "type": [
        "string",
        "null"
       ]
      },
      "unit": {
       "type": [
        "string",
        "null"
       ]
      },
      "unit_class": {
       "description": "MASS, VOLUME, COUNT or VAGUE. VAGUE can appear even when quantity_text shows a number: trailing phrases like \"for serving\" or \"for frying\" mark a line as an amount we cannot pin down (0.5% of lines). Do not infer a quantity from the text when this is VAGUE.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "canonical",
      "name",
      "quantity_text",
      "amount",
      "unit",
      "unit_class",
      "base",
      "base_unit",
      "grams_estimate"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "match_count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "original_servings": {
    "description": "Servings the recipe was written for; the steps always describe this count.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "prep_time_minutes": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "resolved_by": {
    "enum": [
     "slug",
     "slug_other_language",
     "text_search"
    ],
    "type": "string"
   },
   "servings": {
    "description": "Servings the ingredient quantities are for (the requested count when servings was passed).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "slug": {
    "type": "string"
   },
   "steps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "slug",
   "title",
   "country",
   "country_name",
   "category",
   "form",
   "prep_time_minutes",
   "url",
   "description",
   "calories",
   "servings",
   "original_servings",
   "steps",
   "faq",
   "ingredients",
   "image",
   "adaptations",
   "match_count",
   "resolved_by",
   "notes",
   "attribution"
  ],
  "type": "object"
 },
 "title": "Get recipe"
}
