     "concepts",
     "process",
     "neighborhood",
     "schema",
     "context",
     "aggregate",
     "flow",
     "lifecycle",
     "organization",
     "system",
     "holds",
     "usecase",
     "scenario",
     "requirements"
    ],
    "type": "string"
   },
   "steps": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "type": "string"
      },
      "actor": {
       "type": "string"
      },
      "step": {
       "type": "string"
      }
     },
     "required": [
      "step",
      "actor",
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "type": [
     "string",
     "null"
    ]
   },
   "transitions": {
