     "additionalProperties": false,
     "properties": {
      "from": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "from",
      "to",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "mermaid": {
    "type": "string"
   },
   "model": {
    "additionalProperties": false,
    "properties": {
     "commit": {
      "type": [
       "string",
       "null"
      ]
     },
     "core": {
      "type": "string"
     },
     "parser": {
      "type": "string"
     },
     "repo": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
