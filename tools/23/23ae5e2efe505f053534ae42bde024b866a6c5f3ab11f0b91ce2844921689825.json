     "properties": {
      "id": {
       "type": "string"
      },
      "node": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "node",
      "id",
      "title",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "omitted": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "shape": {
