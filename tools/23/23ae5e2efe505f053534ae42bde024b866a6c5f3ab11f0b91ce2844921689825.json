{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "A picture of the model as Mermaid; edge data: list_references. Input: `shape`; `id`, `domain`, `type` or `unit` narrow it. aggregate, flow, lifecycle take a context's `id`; organization without `id` draws the company; system a landscape, holds its data; usecase, scenario a use case's; requirements a feature's, product's, use case's or requirement's. Returns `mermaid`, `nodes`, `links`, `units`, counts. Max 50 nodes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "domain": {
    "description": "A domain's id or address, to draw its concepts",
    "type": "string"
   },
   "id": {
    "description": "The process, the entity at a neighborhood's middle, the bounded context of a context map, or the aggregate or bounded context of an aggregate, flow or lifecycle picture, the group an organization is narrowed to, or the system drawn in its landscape by system and by the data it holds by holds, the use case drawn by usecase and scenario, or the feature, product, use case or requirement whose requirements are drawn, never by neighborhood",
    "type": "string"
   },
   "shape": {
    "enum": [
     "concepts",
     "process",
     "neighborhood",
     "schema",
     "context",
     "aggregate",
     "flow",
     "lifecycle",
     "organization",
     "system",
     "holds",
     "usecase",
     "scenario",
     "requirements"
    ],
    "type": "string"
   },
   "type": {
    "description": "A type, to draw its schema and the types it is declared with",
    "type": "string"
   },
   "unit": {
    "description": "core or a pack, to draw that unit's types and what they declare; a meta-model too large to draw whole is drawn as core, and `units` in the answer names every unit",
    "type": "string"
   }
  },
  "required": [
   "shape"
  ],
  "type": "object"
 },
 "name": "diagram",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "actor": {
    "type": "string"
   },
   "edges": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "everyType": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "multiplicity": {
       "type": "string"
      },
      "to": {
       "type": "string"
      },
      "via": {
       "type": "string"
      }
     },
     "required": [
      "via",
      "to",
      "multiplicity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "extensions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "condition": {
       "type": "string"
      },
      "handling": {
       "type": "string"
      },
      "step": {
       "type": "string"
      }
     },
     "required": [
      "step",
      "condition",
      "handling"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "links": {
