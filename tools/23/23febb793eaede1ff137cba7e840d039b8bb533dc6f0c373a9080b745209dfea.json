{
 "description": "Update an existing blocked time slot in the CRM.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "assignedUserId": {
    "description": "User ID whose calendar is blocked",
    "type": "string"
   },
   "blockedSlotId": {
    "description": "Blocked slot ID to update",
    "type": "string"
   },
   "calendarId": {
    "description": "Calendar ID",
    "type": "string"
   },
   "endTime": {
    "description": "Block end time (ISO string)",
    "type": "string"
   },
   "locationId": {
    "description": "CRM location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "startTime": {
    "description": "Block start time (ISO string)",
    "type": "string"
   },
   "title": {
    "description": "Title / reason for the blocked slot",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "blockedSlotId"
  ],
  "type": "object"
 },
 "name": "crm_update_blocked_slot"
}
