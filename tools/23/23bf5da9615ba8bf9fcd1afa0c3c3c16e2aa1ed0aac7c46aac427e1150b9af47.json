{
 "description": "Send multiple AT commands sequentially and capture all responses. Useful for running a diagnostic sequence. Requires root.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "commands": {
    "description": "Array of AT commands to send in order (max 50)",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "delayMs": {
    "default": 500,
    "description": "Delay between commands in ms (0-10000, default 500)",
    "maximum": 10000,
    "minimum": 0,
    "type": "number"
   },
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "force": {
    "default": false,
    "description": "Bypass dangerous command safety checks",
    "type": "boolean"
   },
   "port": {
    "description": "Modem device node (auto-detects if omitted)",
    "type": "string"
   },
   "timeout": {
    "default": 5000,
    "description": "Timeout per command in ms",
    "maximum": 30000,
    "minimum": 1000,
    "type": "number"
   }
  },
  "required": [
   "commands"
  ],
  "type": "object"
 },
 "name": "adb_at_batch"
}
