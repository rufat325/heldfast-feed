{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Prepare a ten-minute, single-use portal link for a secret variable of an existing app or project/environment group. Send target identifiers and variable_name only, NEVER a value. The owner opens the link and signs in; the tool transcript receives only the link and subsequent status. Existing app secrets are encrypted and apply on the next deployment. This protects the designated portal input only; it does not scan or protect secrets embedded in YAML, Dockerfile contents, source code or free text. Never paste those values into chat or tool arguments. See https://docs.imprezahost.com/customer-workflows.html#secret-entry-boundary.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "pattern": "^dpl_[a-f0-9]{16,24}$",
    "type": "string"
   },
   "environment_id": {
    "pattern": "^env_[a-f0-9]{24}$",
    "type": "string"
   },
   "project_id": {
    "pattern": "^prj_[a-f0-9]{24}$",
    "type": "string"
   },
   "variable_name": {
    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
    "type": "string"
   }
  },
  "required": [
   "variable_name"
  ],
  "type": "object"
 },
 "name": "impreza_prepare_secret_entry",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "expires_at": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "onion_url": {
      "type": "string"
     },
     "session_id": {
      "pattern": "^sen_[a-f0-9]{32}$",
      "type": "string"
     },
     "status": {
      "enum": [
       "pending",
       "stored",
       "expired",
       "cancelled"
      ],
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "variable_name": {
      "type": "string"
     }
    },
    "required": [
     "session_id",
     "variable_name",
     "status",
     "expires_at",
     "url",
     "onion_url",
     "note"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Prepare secret entry"
}
