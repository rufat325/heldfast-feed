{
 "annotations": {
  "title": "Set goal (async)"
 },
 "description": "Set a pathfinder goal without waiting (fire-and-forget). The bot keeps moving toward it in the background. Use `dynamic` for goals that should recompute as the world/target changes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dynamic": {
    "description": "Recompute the path continuously (default false)",
    "type": "boolean"
   },
   "goalType": {
    "description": "Which kind of pathfinder goal to build",
    "enum": [
     "block",
     "near",
     "xz",
     "nearxz",
     "y",
     "getToBlock",
     "lookAtBlock",
     "placeBlock",
     "composite_any",
     "composite_all",
     "invert"
    ],
    "type": "string"
   },
   "goals": {
    "description": "Nested goals for composite_any/composite_all/invert",
    "items": {
     "properties": {
      "goalType": {
       "type": "string"
      },
      "range": {
       "type": "number"
      },
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      },
      "z": {
       "type": "number"
      }
     },
     "required": [
      "goalType"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "range": {
    "description": "Acceptable distance from the target (for near/nearxz/follow)",
    "type": "number"
   },
   "x": {
    "description": "Target X (required for most goal types)",
    "type": "number"
   },
   "y": {
    "description": "Target Y",
    "type": "number"
   },
   "z": {
    "description": "Target Z",
    "type": "number"
   }
  },
  "required": [
   "goalType"
  ],
  "type": "object"
 },
 "name": "set_goal"
}
