    "type": "number"
   },
   "hands": {
    "description": "Deal into N hands",
    "type": "number"
   },
   "per_hand": {
    "description": "Cards per hand (default: 5)",
    "type": "number"
   },
   "type": {
    "description": "Deck type (default: standard-52)",
    "enum": [
     "standard-52",
     "bavarian-32",
     "hanafuda-48",
     "mahjong-136",
     "dominoes-28",
     "standard-dice"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "game_deck_create"
}
