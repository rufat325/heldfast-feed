{
 "annotations": {
  "readOnlyHint": true,
  "title": "Query channel members"
 },
 "description": "List/filter the members of one channel. Requires the channel type + id. Optional member filter, e.g. {\"name\":{\"$autocomplete\":\"jo\"}}. GET /api/v2/chat/members.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "filter": {
    "additionalProperties": {},
    "description": "Member filter_conditions, e.g. {\"user_id\":{\"$in\":[\"u1\",\"u2\"]}}. Default {}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "id": {
    "description": "Channel id.",
    "type": "string"
   },
   "limit": {
    "description": "Max members (<=100). Default 100.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "sort": {
    "description": "Sort spec, e.g. [{\"field\":\"created_at\",\"direction\":1}].",
    "items": {
     "properties": {
      "direction": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "field": {
       "type": "string"
      }
     },
     "required": [
      "field",
      "direction"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "type": {
    "description": "Channel type, e.g. \"messaging\".",
    "type": "string"
   }
  },
  "required": [
   "type",
   "id"
  ],
  "type": "object"
 },
 "name": "stream_query_members",
 "title": "Query channel members"
}
