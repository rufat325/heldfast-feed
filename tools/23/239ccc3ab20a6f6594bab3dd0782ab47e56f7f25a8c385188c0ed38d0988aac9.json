{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Record only explicit user feedback on a saved song: understood, partial or missed. Never infer recognition or helpfulness from playback. Replaces the user's previous feedback for this song. Resolve trackId first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "confirmed": {
    "const": true,
    "type": "boolean"
   },
   "context": {
    "maxLength": 500,
    "type": "string"
   },
   "resonance": {
    "enum": [
     "understood",
     "partial",
     "missed"
    ],
    "type": "string"
   },
   "trackId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "wasHelpful": {
    "type": "boolean"
   }
  },
  "required": [
   "trackId",
   "wasHelpful",
   "resonance",
   "confirmed"
  ],
  "type": "object"
 },
 "name": "submit_track_feedback",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {},
  "type": "object"
 },
 "title": "Record how a song felt to you"
}
