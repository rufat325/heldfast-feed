{
 "description": "Lint/validate ZPL and return the structured diagnostics report (unknown commands, parameter range errors, layout overflow, etc.) as JSON. Pass the real label size \u2014 checks depend on it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dpmm": {
    "default": 8,
    "description": "Printer density in dots per mm (6, 8, 12 or 24)",
    "maximum": 24,
    "minimum": 6,
    "type": "integer"
   },
   "height_in": {
    "default": 6,
    "description": "Label height in inches",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "width_in": {
    "default": 4,
    "description": "Label width in inches",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "zpl": {
    "description": "Raw ZPL code",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "zpl"
  ],
  "type": "object"
 },
 "name": "zpl_validate"
}
