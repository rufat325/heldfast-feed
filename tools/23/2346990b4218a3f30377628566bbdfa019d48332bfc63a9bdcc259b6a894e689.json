{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get entity field schema"
 },
 "description": "Returns the field schema for an entity in a company: every field with its type, required flag, alternativeTitles, and predefinedValues. Use to build or verify a mapping before running an import.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "companyId": {
    "description": "Company id from list_companies.",
    "type": "string"
   },
   "entityName": {
    "description": "Entity name from list_entities (e.g., 'Invoice', 'Bill').",
    "type": "string"
   }
  },
  "required": [
   "companyId",
   "entityName"
  ],
  "type": "object"
 },
 "name": "get_fields",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "fields": {
    "description": "Field schema entries for the entity.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "alternativeTitles": {
       "description": "Aliases the auto-mapper recognizes for this field.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "description": "Field id \u2014 pass as targetFieldId in create_mapping/update.",
       "type": "string"
      },
      "name": {
       "description": "Human-readable field name.",
       "type": "string"
      },
      "predefinedValues": {
       "description": "Closed-vocabulary values, if any.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "required": {
       "description": "Whether the field must be supplied per row.",
       "type": "boolean"
      },
      "type": {
       "description": "Field type (string, number, date, reference, etc.).",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}
