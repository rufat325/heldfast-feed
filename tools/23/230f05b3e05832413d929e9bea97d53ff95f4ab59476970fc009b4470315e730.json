{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Save this AI system to Merron so the user can build an evidence pack from it: the name, a description, the answers the user confirmed and the file/line findings from merron_scan_project. Returns a private single-use link, valid 7 days; the user signs in, the system opens prefilled and Merron guides them through connecting the code, confirming the answers and creating the pack. Ask the user first and tell them what will be saved. Never include code excerpts, secrets or personal data; findings carry only paths, line numbers and codes. Give the user the link exactly as returned.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "system": {
    "additionalProperties": false,
    "properties": {
     "company": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "description": {
      "maxLength": 4000,
      "minLength": 20,
      "type": "string"
     },
     "facts": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "enum": [
          "provider",
          "deployer",
          "both"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "default": {},
      "type": "object"
     },
     "findings": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "maxLength": 60,
         "minLength": 1,
         "type": "string"
        },
        "interpretation": {
         "maxLength": 300,
         "type": "string"
        },
        "line": {
         "maximum": 1000000,
         "minimum": 1,
         "type": "integer"
        },
        "path": {
         "maxLength": 240,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "code",
        "path",
        "line"
       ],
       "type": "object"
      },
      "maxItems": 60,
      "type": "array"
     },
     "productName": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "company",
     "productName",
     "description"
    ],
    "type": "object"
   },
   "userAgreed": {
    "const": true,
    "description": "True only after the user agrees to save these details to Merron.",
    "type": "boolean"
   }
  },
  "required": [
   "userAgreed",
   "system"
  ],
  "type": "object"
 },
 "name": "merron_prepare_workspace",
 "title": "Prepare the system in a private Merron workspace"
}
