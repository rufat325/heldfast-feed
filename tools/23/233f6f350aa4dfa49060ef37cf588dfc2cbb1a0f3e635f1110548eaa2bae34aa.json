{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a ready-to-paste iframe that embeds a live, interactive three.ws 3D avatar into any website or app \u2014 as easy as embedding a YouTube video.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "id"
    ]
   },
   {
    "required": [
     "handle"
    ]
   },
   {
    "required": [
     "model"
    ]
   }
  ],
  "properties": {
   "background": {
    "default": "transparent",
    "enum": [
     "transparent",
     "dark",
     "light"
    ],
    "type": "string"
   },
   "handle": {
    "description": "three.ws username/handle, e.g. \"nirholas\" or \"@nirholas\".",
    "type": "string"
   },
   "height": {
    "default": 480,
    "maximum": 1080,
    "minimum": 160,
    "type": "integer"
   },
   "id": {
    "description": "Avatar UUID (from a three.ws avatar URL or get_avatar).",
    "type": "string"
   },
   "idle": {
    "default": true,
    "description": "Play the idle animation loop.",
    "type": "boolean"
   },
   "model": {
    "description": "Direct GLB/GLTF model URL (skips lookup; used as-is).",
    "type": "string"
   },
   "overlay": {
    "default": false,
    "description": "Chrome-free mode (good for OBS/overlays).",
    "type": "boolean"
   },
   "width": {
    "default": "100%",
    "description": "CSS width, e.g. \"100%\" or \"480px\".",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "avatar_embed_code",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "embed_url": {
    "description": "Live avatar-embed page URL (iframe src).",
    "type": "string"
   },
   "id": {
    "description": "Avatar UUID, or null when the avatar came from a raw model URL.",
    "type": [
     "string",
     "null"
    ]
   },
   "iframe": {
    "description": "Ready-to-paste <iframe> embed snippet.",
    "type": "string"
   },
   "name": {
    "description": "Avatar display name.",
    "type": "string"
   }
  },
  "required": [
   "embed_url",
   "iframe",
   "name",
   "id"
  ],
  "type": "object"
 },
 "title": "Get avatar embed code"
}
