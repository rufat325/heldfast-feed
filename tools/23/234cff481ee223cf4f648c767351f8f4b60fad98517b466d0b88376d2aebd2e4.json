  "readOnlyHint": false,
  "title": "Update Audience Feed"
 },
 "description": "Enable or disable an audience's Atom feed, update its public metadata and canonical URL, or set its 10 to 100 entry limit.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "audience_id": {
    "description": "Audience ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "author_name": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "canonical_url": {
    "anyOf": [
     {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Publisher-owned https feed URL to emit as the Atom self link, or null to clear."
   },
   "enabled": {
    "type": "boolean"
   },
   "entry_limit": {
    "anyOf": [
     {
      "maximum": 100,
      "minimum": 10,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Stored number of recent issues in the feed, from 10 to 100, or null for default."
   },
   "icon_url": {
    "anyOf": [
     {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "idempotency_key": {
    "description": "Optional idempotency key. If omitted, the MCP server generates one for POST tools.",
    "pattern": "^[\\x20-\\x7E]{1,255}$",
    "type": "string"
   },
   "site_url": {
    "anyOf": [
     {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "subtitle": {
    "anyOf": [
     {
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "title": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "audience_id"
  ],
  "type": "object"
 },
