{
 "description": "Generate ASCII diagrams: flowcharts, boxes, trees, tables, sequence, timeline, bar, class, ER, mindmap, and gantt.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
   "__schema0": {
    "properties": {
     "children": {
      "items": {
       "$ref": "#/definitions/__schema0"
      },
      "type": "array"
     },
     "label": {
      "type": "string"
     }
    },
    "required": [
     "label"
    ],
    "type": "object"
   }
  },
  "properties": {
   "actors": {
    "description": "Sequence: list of actor names",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "classes": {
    "description": "Class: list of classes with name, properties, methods",
    "items": {
     "properties": {
      "methods": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "properties": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "entities": {
    "description": "ER: list of entities with name and attributes",
    "items": {
     "properties": {
      "attributes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "events": {
    "description": "Timeline: list of events with label and description",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "label": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "description"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "type": "array"
   },
   "headers": {
    "description": "Table: column headers",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "items": {
    "description": "Bar: list of items with label and numeric value",
    "items": {
     "properties": {
      "label": {
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "label",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "lines": {
    "description": "Box: body lines",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "maxWidth": {
    "description": "Bar: maximum bar width in characters (default 20)",
    "maximum": 40,
    "minimum": 1,
    "type": "number"
   },
   "messages": {
    "description": "Sequence: messages between actors",
    "items": {
     "properties": {
      "from": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "from",
      "to",
      "label"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "type": "array"
   },
   "nodes": {
    "description": "Flowchart: list of step labels",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "relationships": {
    "description": "ER: relationships between entities (from, to, label like \"1:N\")",
    "items": {
     "properties": {
      "from": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "from",
      "to",
      "label"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "type": "array"
   },
   "root": {
    "allOf": [
     {
      "$ref": "#/definitions/__schema0"
     }
    ],
    "description": "Tree/Mindmap: root node with label and optional children"
   },
   "rows": {
    "description": "Table: data rows",
    "items": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "maxItems": 50,
    "type": "array"
   },
   "style": {
    "default": "unicode",
    "description": "Border style: unicode (default), rounded, or ascii",
    "enum": [
     "unicode",
     "rounded",
     "ascii"
    ],
    "type": "string"
   },
   "tasks": {
    "description": "Gantt: tasks with label, start position, and duration",
    "items": {
     "properties": {
      "duration": {
       "minimum": 1,
       "type": "number"
      },
      "label": {
       "type": "string"
      },
      "start": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "label",
      "start",
      "duration"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "title": {
    "description": "Box: title text",
    "type": "string"
   },
   "type": {
    "description": "Diagram type",
    "enum": [
     "flowchart",
     "box",
     "tree",
     "table",
     "sequence",
     "timeline",
     "bar",
     "class",
     "er",
     "mindmap",
     "gantt"
    ],
    "type": "string"
   },
   "unitLabel": {
    "description": "Gantt: label for time units (e.g. \"weeks\", \"sprints\")",
    "type": "string"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
 "name": "diagram"
}
