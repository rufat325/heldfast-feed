{
 "description": "Create or update a task's kanban fields: title, description (what it is), project, impact (change surface), and risk level. New keys get a stable task number.",
 "inputSchema": {
  "properties": {
   "agent": {
    "description": "acting agent identity (defaults to OCTOBOARD_AGENT)",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "impact": {
    "type": "string"
   },
   "key": {
    "type": "string"
   },
   "project": {
    "type": "string"
   },
   "riskLevel": {
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "key"
  ],
  "type": "object"
 },
 "name": "board_task_define"
}
