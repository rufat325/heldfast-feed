    "description": "TEI with line tags",
    "type": "boolean"
   },
   "doTeiWithNoZones": {
    "default": false,
    "description": "TEI without zones",
    "type": "boolean"
   },
   "doTeiWithZonePerLine": {
    "default": false,
    "description": "TEI with zone per line",
    "type": "boolean"
   },
   "doTeiWithZonePerRegion": {
    "default": false,
    "description": "TEI with zone per region",
    "type": "boolean"
   },
   "doTeiWithZonePerWord": {
    "default": false,
    "description": "TEI with zone per word",
    "type": "boolean"
   },
   "doTeiWithZones": {
    "default": false,
    "description": "TEI with zones",
    "type": "boolean"
   },
   "doWordBased": {
    "default": false,
    "description": "Word-based export",
    "type": "boolean"
   },
   "doWriteDocx": {
    "default": false,
    "description": "Write DOCX",
    "type": "boolean"
   },
   "doWriteImages": {
    "default": true,
