    "maximum": 9007199254740991,
    "type": "integer"
   },
   "doBlackening": {
    "default": false,
    "description": "Apply blackening",
    "type": "boolean"
   },
   "doCreateTitle": {
    "default": false,
    "description": "Create title page",
    "type": "boolean"
   },
   "doDocxExpandAbbrevs": {
    "default": false,
    "description": "Expand abbreviations in DOCX",
    "type": "boolean"
   },
   "doDocxForcePageBreaks": {
    "default": false,
    "description": "Force page breaks in DOCX",
    "type": "boolean"
   },
   "doDocxKeepAbbrevs": {
    "default": false,
    "description": "Keep abbreviations in DOCX",
    "type": "boolean"
   },
   "doDocxMarkUnclear": {
    "default": false,
    "description": "Mark unclear text in DOCX",
    "type": "boolean"
   },
   "doDocxPreserveLineBreaks": {
    "default": false,
    "description": "Preserve line breaks in DOCX",
    "type": "boolean"
   },
