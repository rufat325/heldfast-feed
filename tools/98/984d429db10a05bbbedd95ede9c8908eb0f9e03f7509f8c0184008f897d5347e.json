    "type": "boolean"
   },
   "doWriteMets": {
    "default": true,
    "description": "Write METS file",
    "type": "boolean"
   },
   "doWritePdf": {
    "default": false,
    "description": "Write PDF",
    "type": "boolean"
   },
   "doWriteTablesXlsx": {
    "default": false,
    "description": "Write tables XLSX",
    "type": "boolean"
   },
   "doWriteTagsXlsx": {
    "default": false,
    "description": "Write tags XLSX",
    "type": "boolean"
   },
   "doWriteTei": {
    "default": false,
    "description": "Write TEI",
    "type": "boolean"
   },
