{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Get a user's trade info (averages, win/loss stats) for a specific period.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "period": {
    "description": "Period to retrieve trade info for",
    "enum": [
     "CurrMonth",
     "CurrQuarter",
     "CurrYear",
     "LastYear",
     "LastTwoYears",
     "OneMonthAgo",
     "TwoMonthsAgo",
     "ThreeMonthsAgo",
     "SixMonthsAgo",
     "OneYearAgo"
    ],
    "type": "string"
   },
   "username": {
    "description": "eToro username",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "username",
   "period"
  ],
  "type": "object"
 },
 "name": "etoro_get_user_trades",
 "title": "Get user trade info"
}
