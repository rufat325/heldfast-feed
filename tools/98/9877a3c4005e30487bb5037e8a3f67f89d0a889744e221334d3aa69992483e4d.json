{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Saved User Strategy State"
 },
 "description": "Store user-authored strategy text, execution timestamps, and the most recent result in encrypted per-user storage. This tool does not provide presets, define opportunities, choose domains, or execute a workflow. Requires a registered account with memory enabled.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "get, set, update, or delete. Defaults to get.",
    "enum": [
     "get",
     "set",
     "update",
     "delete"
    ],
    "type": "string"
   },
   "id": {
    "description": "Saved strategy ID for update or delete.",
    "type": "string"
   },
   "name": {
    "description": "Optional user-defined name for set.",
    "type": "string"
   },
   "result": {
    "description": "Latest user- or host-supplied result summary for update.",
    "type": "string"
   },
   "strategy": {
    "description": "User-authored text, maximum 500 characters, for set.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "strategy",
 "outputSchema": {
  "properties": {
   "error": {
    "type": "string"
   },
   "max": {
    "minimum": 0,
    "type": "integer"
   },
   "message": {
    "type": "string"
   },
   "strategies": {
    "items": {
     "properties": {
      "can_run": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "last_result": {
       "type": "string"
      },
      "last_run": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "runs_today": {
       "minimum": 0,
       "type": "integer"
      },
      "strategy": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "strategy",
      "can_run"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "strategy": {
    "properties": {
     "created_at": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "strategy": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "success": {
    "type": "boolean"
   },
   "total": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Saved User Strategy State"
}
