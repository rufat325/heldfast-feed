{
 "_meta": {
  "ui": {
   "resourceUri": "ui://agent-manager.dev/docs-browser"
  }
 },
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return the MCP tools agent-manager registers into every session it starts, so an agent running inside it can spawn, message and wait on other agents. Those tools run on the developer's own machine over stdio, not on this server.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "group": {
    "description": "Return only the tools that act on this part of the workspace.",
    "enum": [
     "session",
     "review",
     "coordination",
     "groups",
     "terminals"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_managed_mcp_tools",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "count": {
    "type": "integer"
   },
   "tools": {
    "items": {
     "properties": {
      "group": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "summary"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "tools"
  ],
  "type": "object"
 },
 "title": "List the tools the agent-manager binary exposes"
}
