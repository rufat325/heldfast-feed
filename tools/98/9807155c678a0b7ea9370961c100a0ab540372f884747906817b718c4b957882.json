{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks who won government contracts or grants: past awards by NAICS, agency, state, awardee name or UEI, with amounts and dates.\n\nFilters: type (contract_award, grant_award or any), naics (up to 10 codes), agency (a name; the note says which agency it matched), state, awardee (part of a name), uei, keyword (matched in the title; a grant award's title is its recipient's name), awarded_within_days (1 to 1095, default 365), limit (1 to 50, default 20). If has_more is true, call again with cursor=next_cursor and the same filters. Example: naics=\"541512\", agency=\"Department of Veterans Affairs\". Pass several NAICS codes in one call.\n\nAward records may be incomplete, so say so. Head a grant award with its awardee name and CFDA number, not its title. Pass an awardee's uei to get_company for its full history.\n\nPrint each award's url and source_url as markdown links.\n\nDo not use for open opportunities to bid on (search_contracts, search_grants) or for one firm's history when its UEI is known (get_company).",
 "inputSchema": {
  "properties": {
   "agency": {
    "anyOf": [
     {
      "maxLength": 100,
      "minLength": 2,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Agency name, e.g. 'Department of Veterans Affairs'; matched to the closest MatchAwards agency, which the result note names.",
    "title": "Agency"
   },
   "awarded_within_days": {
    "default": 365,
    "description": "Only awards from the last N days, 1 to 1095 (default 365).",
    "maximum": 1095,
    "minimum": 1,
    "title": "Awarded Within Days",
    "type": "integer"
   },
   "awardee": {
    "anyOf": [
     {
      "maxLength": 100,
      "minLength": 2,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Part of the awardee's name, 2 to 100 characters.",
    "title": "Awardee"
   },
   "cursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "next_cursor from the previous response. Pass it with the same filters to get the next page.",
    "title": "Cursor"
   },
   "keyword": {
    "anyOf": [
     {
      "maxLength": 100,
      "minLength": 2,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "2 to 100 characters matched against the title only.",
    "title": "Keyword"
   },
   "limit": {
    "default": 20,
    "description": "Number of results to return, 1 to 50.",
    "maximum": 50,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "naics": {
    "anyOf": [
     {
      "pattern": "^\\s*\\d{6}(\\s*,\\s*\\d{6}){0,9}\\s*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Up to 10 six-digit NAICS codes, comma-separated, e.g. '236220' or '541511,541512'. A record matches on its own codes (matched_naics says which). Unknown codes are ignored.",
    "title": "Naics"
   },
   "state": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z]{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Two-letter US state code of the place of performance.",
    "title": "State"
   },
   "type": {
    "default": "any",
    "description": "contract_award (federal contracts), grant_award, or any (both).",
    "enum": [
     "contract_award",
     "grant_award",
     "any"
    ],
    "title": "Type",
    "type": "string"
   },
   "uei": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z0-9]{12}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The awardee's 12-character UEI.",
    "title": "Uei"
   }
  },
  "title": "search_awardsArguments",
  "type": "object"
 },
 "name": "search_awards",
 "outputSchema": {
  "$defs": {
   "AwardRow": {
    "description": "One award. Federal contract awards fill solicitation_number and contract_number; grant awards fill\ncfda_number and period, and their title is the recipient's name.",
    "properties": {
     "agency": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Agency"
     },
     "agency_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Agency Id"
     },
     "amount": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "USD; null when the source value does not parse.",
      "title": "Amount"
     },
     "award_date": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Date, YYYY-MM-DD.",
      "title": "Award Date"
     },
     "awardee": {
      "anyOf": [
       {
        "$ref": "#/$defs/Awardee"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "cfda_number": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Cfda Number"
     },
     "city": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "City"
     },
     "contract_number": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Contract Number"
     },
     "id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
