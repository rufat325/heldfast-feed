      "title": "Matched Naics"
     },
     "naics": {
      "anyOf": [
       {
        "$ref": "#/$defs/Naics"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "period": {
      "anyOf": [
       {
        "$ref": "#/$defs/Period"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Grant awards only: start and end dates."
     },
     "set_aside": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Set Aside"
     },
     "solicitation_number": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Solicitation Number"
     },
     "source_url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "The award notice at SAM.gov or USAspending. Show it as a markdown link.",
      "title": "Source Url"
     },
     "state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "State"
     },
     "title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Title"
     },
     "type": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "contract_award or grant_award.",
      "title": "Type"
     },
     "url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "The award on matchawards.com. Show it as a markdown link.",
      "title": "Url"
     }
    },
    "title": "AwardRow",
    "type": "object"
   },
   "Awardee": {
    "properties": {
     "duns": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Duns"
     },
     "name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Name"
     },
     "uei": {
      "anyOf": [
       {
        "type": "string"
