 "description": "Count what people complain about and praise for a product. Use it for \"what do people complain about with Cursor?\", \"is Claude Code well liked?\", \"what do users say about Copilot?\". Pass product, a name such as \"Claude Code\". Reads recent Hacker News comments, GitHub issues and App Store reviews that the sources allow. Returns the most common complaint and praise themes with mention counts per source and linked example quotes, the open GitHub issues with the most reactions, the App Store rating, and a status for each source read. The counts come from a sample of public posts from the last 90 days. Results are reused for six hours.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "product": {
    "description": "A product name, such as \"Claude Code\", \"Cursor\" or \"GitHub Copilot\". Known AI coding tools also read GitHub issues and App Store reviews.",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "product"
  ],
  "type": "object"
 },
 "name": "product_feedback",
