{
 "description": "WRITE: Update an ad's name, status, or swap its creative. To replace the creative pass `creative: {creative_id: 'XXX'}`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ad_id": {
    "type": "string"
   },
   "creative": {
    "additionalProperties": {},
    "description": "e.g. {creative_id: '123456'}",
    "type": "object"
   },
   "name": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ACTIVE",
     "PAUSED",
     "DELETED",
     "ARCHIVED"
    ],
    "type": "string"
   }
  },
  "required": [
   "ad_id"
  ],
  "type": "object"
 },
 "name": "update_ad"
}
