{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Queue, dispatch, track, cancel, or resolve behavior directives for behavior-mcp runtime execution (actions: create, dispatch, get, list, cancel, resolve). Use manage_intentions instead of set_goal when dispatching immediate execution instructions to runtime behaviors rather than managing abstract objectives.\n\nReturns intention record, dispatch status, wire contract payload, or intention list.",
 "inputSchema": {
  "properties": {
   "abort_conditions": {
    "description": "Auto-abort trigger conditions",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "action": {
    "description": "Intention operation: create, dispatch, get, list, cancel, resolve",
    "enum": [
     "create",
     "dispatch",
     "get",
     "list",
     "cancel",
     "resolve"
    ],
    "type": "string"
   },
   "behavior_name": {
    "description": "Target behavior tree name (e.g. \"combat_kite\", \"gather_loop\")",
    "type": "string"
   },
   "client_request_id": {
    "description": "Idempotency key",
    "type": "string"
   },
   "deadline_at": {
    "description": "ISO-8601 completion deadline",
    "type": "string"
   },
   "goal_id": {
    "description": "Linked goal ID",
    "type": "string"
   },
   "intention_id": {
    "description": "Intention ID for dispatch/get/cancel/resolve",
    "type": "string"
   },
   "parameters": {
    "description": "Runtime behavior parameters",
    "type": "object"
   },
   "priority": {
    "description": "Execution priority (0.0 to 1.0)",
    "type": "number"
   },
   "project": {
    "description": "Target project slug",
    "type": "string"
   },
   "result": {
    "description": "Outcome payload for resolve action",
    "type": "object"
   },
   "status": {
    "description": "Status filter or update",
    "enum": [
     "pending",
     "dispatched",
     "running",
     "completed",
     "failed",
     "aborted",
     "interrupted"
    ],
    "type": "string"
   },
   "trace_id": {
    "description": "Linked decision trace ID",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_intentions"
}
