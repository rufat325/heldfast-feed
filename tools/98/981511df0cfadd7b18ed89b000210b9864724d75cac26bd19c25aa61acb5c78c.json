{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Fec Committee Search"
 },
 "description": "Search FEC-registered political committees (campaign committees, PACs, party committees, Super PACs) by name, state, or committee type. Returns committee IDs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "committee_type": {
    "description": "Committee type code: 'P' (President), 'S' (Senate), 'H' (House), 'N'/'Q' (PAC), 'O' (Super PAC), 'X'/'Y' (party). Optional.",
    "type": "string"
   },
   "cycle": {
    "description": "Two-year election cycle (even year, e.g. 2024). Optional.",
    "type": "integer"
   },
   "limit": {
    "description": "Maximum committees to return (default 20, max 100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Committee name fragment. Optional.",
    "type": "string"
   },
   "state": {
    "description": "Two-letter state code to filter by. Optional.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "fec_committee_search"
}
