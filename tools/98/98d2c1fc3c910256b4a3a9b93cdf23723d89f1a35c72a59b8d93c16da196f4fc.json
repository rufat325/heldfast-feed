{
 "description": "Create or update a sandbox preview resource in the project's sapiom.json. Fill the typed arguments instead of hand-writing JSON \u2014 the config is validated and written under resources.<name> (type: \"sandbox\"). Returns the stored config. Use sapiom_dev_sandbox_preview afterwards to deploy it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "build": {
    "type": "string"
   },
   "dir": {
    "description": "Project directory (defaults to the current working directory).",
    "type": "string"
   },
   "env": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "Resource name \u2014 the sapiom.json `resources` key and the sandbox name (e.g. `web`).",
    "type": "string"
   },
   "port": {
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "source": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "upload",
        "type": "string"
       },
       "path": {
        "type": "string"
       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "git",
        "type": "string"
       },
       "path": {
        "type": "string"
       },
       "slug": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "kind",
       "slug"
      ],
      "type": "object"
     }
    ]
   },
   "start": {
    "minLength": 1,
    "type": "string"
   },
   "tier": {
    "enum": [
     "xs",
     "s",
     "m",
     "l",
     "xl"
    ],
    "type": "string"
   },
   "ttl": {
    "type": "string"
   }
  },
  "required": [
   "name",
   "source",
   "start",
   "port"
  ],
  "type": "object"
 },
 "name": "sapiom_dev_sandbox_configure"
}
