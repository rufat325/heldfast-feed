{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Restart Kafka on one or more specific nodes in a CDSS cluster",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "computeInstanceNoList": {
    "description": "Node server instance numbers to restart (from ncloud_cdss_list_nodes)",
    "items": {
     "type": [
      "number",
      "string"
     ]
    },
    "minItems": 1,
    "type": "array"
   },
   "serviceGroupInstanceNo": {
    "description": "Cluster instance number",
    "type": "string"
   }
  },
  "required": [
   "serviceGroupInstanceNo",
   "computeInstanceNoList"
  ],
  "type": "object"
 },
 "name": "ncloud_cdss_restart_kafka_per_node"
}
