{
 "description": "Generate SEO title and meta description options for a URL or markdown page.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "current_meta_description": {
    "maxLength": 320,
    "type": "string"
   },
   "current_title": {
    "maxLength": 120,
    "type": "string"
   },
   "keyword": {
    "minLength": 1,
    "type": "string"
   },
   "page_markdown": {
    "description": "Page markdown when no URL exists",
    "maxLength": 50000,
    "minLength": 80,
    "type": "string"
   },
   "page_type": {
    "default": "auto",
    "enum": [
     "auto",
     "blog_post",
     "landing_page",
     "product",
     "software",
     "local_business",
     "comparison_page",
     "guide"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "description": "Optional target brand, domain, or product",
    "type": "string"
   },
   "url": {
    "description": "Page URL to scrape",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "keyword"
  ],
  "type": "object"
 },
 "name": "agentseo_content_title_meta",
 "title": "AgentSEO Content Title Meta"
}
