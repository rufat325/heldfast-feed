{
 "description": "Convert a table to CSV without changing any value; verified by round-trip. Costs $0.05 USDC (x402).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "table": {
    "additionalProperties": false,
    "description": "A string table: at most 1000 rows x 32 columns, 65536 characters total",
    "properties": {
     "columns": {
      "description": "Column names, in order",
      "items": {
       "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
     },
     "records": {
      "description": "Rows as objects of column -> string value",
      "items": {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
     }
    },
    "required": [
     "columns",
     "records"
    ],
    "type": "object"
   }
  },
  "required": [
   "table"
  ],
  "type": "object"
 },
 "name": "convert_to_csv"
}
