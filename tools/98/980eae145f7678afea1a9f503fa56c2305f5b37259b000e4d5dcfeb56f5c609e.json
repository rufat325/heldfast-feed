{
 "description": "Use when the user describes an operating environment (temperature, humidity, UV, chemicals) and wants to know if a material is suitable. Returns a compatibility rating (excellent/good/fair/poor) and specific risk factors.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "environment": {
    "additionalProperties": false,
    "properties": {
     "chemical_exposure": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "humidity": {
      "enum": [
       "low",
       "medium",
       "high"
      ],
      "type": "string"
     },
     "temperature_c": {
      "type": "number"
     },
     "uv_exposure": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "material_id": {
    "type": "string"
   }
  },
  "required": [
   "material_id",
   "environment"
  ],
  "type": "object"
 },
 "name": "check_material_environment_compatibility"
}
