 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Email Auth Check (SPF/DMARC/DKIM)"
 },
 "description": "Checks a domain's email authentication: parses SPF (+all, ?all, multiple records, over 10 DNS lookups), DMARC (p, sp, pct, rua), DKIM keys (your selector or 15 common ones) and MX, then returns an A-F grade, 0-100 score and coded issues (spf_missing, dmarc_p_none, ...). Use when an agent must judge if a domain can be spoofed, debug deliverability, or vet a sender/vendor domain. $0.01 USDC on Base. Paid tool: call it once to get the x402 PaymentRequired object, then retry with params._meta[\"x402/payment\"].",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Email domain, e.g. example.com. A URL or email address is reduced to its domain.",
    "examples": [
     "example.com"
    ],
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   },
   "selector": {
    "description": "Optional DKIM selector to check authoritatively (in addition to the common list: google, selector1, selector2, default, k1, k2, s1, s2, dkim, mail, mandrill, pm, zoho, protonmail, fm1).",
    "maxLength": 63,
    "pattern": "^[A-Za-z0-9._-]+$",
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "email_auth_check",
 "title": "Email Auth Check (SPF/DMARC/DKIM)"
}
