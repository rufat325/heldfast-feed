    "type": "string"
   },
   "hours": {
    "description": "look-back in whole hours (max 720) (default 72)",
    "type": "string"
   }
  },
  "required": [
   "coin"
  ],
  "type": "object"
 },
 "name": "market_hl_funding_history",
