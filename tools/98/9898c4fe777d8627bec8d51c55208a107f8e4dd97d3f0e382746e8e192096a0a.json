 },
 "description": "Every funding print Hyperliquid has for a perp coin since a look-back point: rate, premium component and the settlement timestamp. Costs $0.001 USDC per call. Byte-identical to GET /market/hl-funding-history?coin=BTC&hours=20.",
 "execution": {
  "taskSupport": "forbidden"
 },
