    ]
   },
   "coin": {
    "type": "string"
   },
   "count": {
    "type": "integer"
   },
   "found": {
    "type": "boolean"
   },
   "hours": {
    "type": "integer"
   },
   "latestRate": {
    "type": "string"
   },
   "note": {
    "type": [
     "string",
     "null"
    ]
   },
   "reason": {
    "type": [
     "string",
     "null"
    ]
   },
   "source": {
    "type": "string"
   },
   "stale": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "ts": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Hyperliquid funding history"
}
