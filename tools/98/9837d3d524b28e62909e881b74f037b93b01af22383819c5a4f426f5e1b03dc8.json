{
 "description": "Score and evaluate a cover letter for relevance, narrative strength, and completeness. Returns score 0-100 with actionable feedback.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "job_analysis": {
    "additionalProperties": true,
    "description": "Job analysis from storylenses_analyze_job",
    "properties": {
     "companyName": {
      "type": "string"
     },
     "jobTitle": {
      "type": "string"
     }
    },
    "required": [
     "jobTitle",
     "companyName"
    ],
    "type": "object"
   },
   "letter_text": {
    "description": "The cover letter text to evaluate (min 200 characters)",
    "minLength": 200,
    "type": "string"
   },
   "locale": {
    "default": "en",
    "description": "Feedback language",
    "enum": [
     "en",
     "de",
     "es",
     "pt"
    ],
    "type": "string"
   }
  },
  "required": [
   "letter_text",
   "job_analysis"
  ],
  "type": "object"
 },
 "name": "storylenses_quality_check"
}
