{
 "description": "Japanese Agricultural Standard (JAS) log scale: official diameter rounding (floor to 1 cm below 14 cm, even 2 cm at 14 cm and above), oval-log averaging, optional +2 cm ovality adjustment and the length allowance for logs over 6 m. Volume per log and totals in m3.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "diameter_long_cm": {
    "description": "Long-axis diameter for oval logs (cm)",
    "minimum": 0,
    "type": "number"
   },
   "diameter_small_cm": {
    "description": "Short-axis diameter in cm",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "length_m": {
    "description": "Log length in meters",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "oval_adjust": {
    "default": false,
    "description": "Add the +2 cm ovality adjustment",
    "type": "boolean"
   },
   "qty": {
    "default": 1,
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "diameter_small_cm",
   "length_m"
  ],
  "type": "object"
 },
 "name": "jas_log_scale"
}
