{
 "_meta": {
  "openai/fileParams": [
   "query_file"
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants to find references they saved, by words such as \"dark editorial layout with a serif headline\", or by giving another image to find similar ones. Pass the profile_key and exactly one of query_text, query_image_url or query_file. Returns the closest references with their name, summary, palette and a closeness score. It searches only this user's saved references, never the web.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "How many matches to return; default 5.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "profile_key": {
    "description": "The profile_key that add_refs returned. Keep it: it is the only way back to this profile and it is not recoverable.",
    "pattern": "^tp_[0-9a-f]{32}$",
    "type": "string"
   },
   "query_file": {
    "description": "An uploaded image to find similar references for.",
    "properties": {
     "download_url": {
      "description": "Temporary link to the uploaded image.",
      "maxLength": 2000,
      "type": "string"
     },
     "file_id": {
      "maxLength": 200,
      "type": "string"
     },
     "file_name": {
      "maxLength": 200,
      "type": "string"
     },
     "mime_type": {
      "maxLength": 100,
      "type": "string"
     }
    },
    "required": [
     "download_url",
     "file_id"
    ],
    "type": "object"
   },
   "query_image_url": {
    "description": "A public https link to an image to find similar references for.",
    "maxLength": 1000,
    "type": "string"
   },
   "query_text": {
    "description": "Words describing the look to find, such as \"dark editorial layout with a serif headline\".",
    "maxLength": 500,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "profile_key"
  ],
  "type": "object"
 },
 "name": "search_refs",
 "outputSchema": {
  "properties": {
   "as_of": {
    "description": "UTC date of this answer.",
    "type": "string"
   },
   "matches": {
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "palette": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "ref_id": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "summary": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "ref_id",
      "name",
      "summary",
      "palette",
      "tags",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "query": {
    "properties": {
     "kind": {
      "enum": [
       "text",
       "image"
      ],
      "type": "string"
     }
    },
    "required": [
     "kind"
    ],
    "type": "object"
   },
   "refs_total": {
    "type": "integer"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "empty"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "query",
   "matches",
   "refs_total",
   "source",
   "as_of",
   "notice"
  ],
  "type": "object"
 },
 "title": "Search reference images"
}
