{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Discover, attach, inspect, or discon\u2026",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
   {
    "additionalProperties": true,
    "description": "Allowed option 1",
    "properties": {
     "action": {
      "const": "ensure"
     }
    },
    "required": [
     "action"
    ],
    "type": "object"
   },
   {
    "additionalProperties": true,
    "description": "Allowed option 2",
    "properties": {
     "action": {
      "const": "status"
     },
     "launchIfNeeded": {
      "not": {}
     },
     "timeoutSeconds": {
      "not": {}
     }
    },
    "required": [
     "action"
    ],
    "type": "object"
   },
   {
    "additionalProperties": true,
    "description": "Allowed option 3",
    "properties": {
     "action": {
      "const": "disconnect"
     },
     "launchIfNeeded": {
      "not": {}
     },
     "timeoutSeconds": {
      "not": {}
     }
    },
    "required": [
     "action"
    ],
    "type": "object"
   }
  ],
  "properties": {
   "action": {
    "description": "Session action",
    "enum": [
     "ensure",
     "status",
     "disconnect"
    ],
    "type": "string"
   },
   "launchIfNeeded": {
    "description": "For ensure, launch an editor only af\u2026",
    "type": "boolean"
   },
   "projectPath": {
    "description": "Godot project path",
    "type": "string"
   },
   "timeoutSeconds": {
    "description": "For action=ensure only:",
    "maximum": 30,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "projectPath",
   "action"
  ],
  "type": "object"
 },
 "name": "editor_session",
 "outputSchema": {
  "additionalProperties": false,
  "oneOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "properties": {
     "ok": {
      "const": true
     }
    },
    "required": [
     "data"
    ]
   },
   {
    "not": {
     "required": [
      "data"
     ]
    },
    "properties": {
     "ok": {
      "const": false
     }
    },
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "data": {},
   "error": {
    "type": "object"
   },
   "meta": {
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok",
   "meta"
  ],
  "type": "object"
 },
 "title": "Editor Session"
}
