  "properties": {
   "location": {
    "description": "Choose city",
    "enum": [
     "New York",
     "Chicago",
     "Los Angeles"
    ],
    "type": "string"
   }
  },
  "required": [
   "location"
  ],
  "type": "object"
 },
 "name": "get-structured-content",
