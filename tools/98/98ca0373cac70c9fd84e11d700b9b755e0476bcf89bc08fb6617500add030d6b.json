{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Write. Add 1 to 100 prompt/answer pairs to one owned deck. All or nothing. Prompts only. After this, re-run previewDeadlinePlan with that deckId.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cards": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "answer": {
       "maxLength": 8000,
       "minLength": 1,
       "type": "string"
      },
      "prompt": {
       "maxLength": 8000,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "prompt",
      "answer"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "deckId": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "deckId",
   "cards"
  ],
  "type": "object"
 },
 "name": "addCards",
 "securitySchemes": [
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Add cards in bulk"
}
