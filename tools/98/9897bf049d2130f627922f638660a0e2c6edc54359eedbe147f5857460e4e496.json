{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Edit an existing item's title/description/category/priority/dueDate/sourceUrl/list by id. Only fields you pass are changed. Pass an empty string (\"\") for description/category/priority/dueDate/sourceUrl to clear that field.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "New category, or \"\" to clear",
    "type": "string"
   },
   "description": {
    "description": "New description, or \"\" to clear",
    "type": "string"
   },
   "dueDate": {
    "anyOf": [
     {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     {
      "const": "",
      "type": "string"
     }
    ],
    "description": "New due date YYYY-MM-DD, or \"\" to clear"
   },
   "id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "string"
     }
    ],
    "description": "The todo id, e.g. 3, or the cross-device short id, e.g. T-7K2F9A"
   },
   "list": {
    "description": "Move to this list",
    "enum": [
     "todo",
     "backlog"
    ],
    "type": "string"
   },
   "priority": {
    "description": "New priority, or \"\" to clear",
    "enum": [
     "low",
     "medium",
     "high",
     ""
    ],
    "type": "string"
   },
   "sourceUrl": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "const": "",
      "type": "string"
     }
    ],
    "description": "New source link (GitHub/Notion/Obsidian/etc.), or \"\" to clear"
   },
   "title": {
    "description": "New title",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "todo_edit",
 "title": "Edit todo"
}
