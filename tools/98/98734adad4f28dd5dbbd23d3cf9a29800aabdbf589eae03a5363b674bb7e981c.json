{
 "_meta": {},
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Cancel Booking (step 2 of 2)"
 },
 "description": "Second of two steps to cancel a booking: cancels it and starts any refund due. Irreversible. Requires the confirmation code and the single-use token that request_cancel_token emailed to the guest; a missing, expired or already-used token is rejected. get_cancellation_policy shows the refund terms that apply.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cancelToken": {
    "description": "Single-use cancellation token from the email request_cancel_token sent to the guest.",
    "minLength": 1,
    "type": "string"
   },
   "confirmationCode": {
    "description": "8-char booking confirmation code, e.g. K7X9M2P4",
    "pattern": "^[A-Za-z0-9]{4,32}$",
    "type": "string"
   },
   "reason": {
    "description": "Guest-provided cancellation reason (at least 3 characters)",
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "confirmationCode",
   "cancelToken",
   "reason"
  ],
  "type": "object"
 },
 "name": "cancel_booking",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "gatewaySettlementEta": {
    "type": [
     "string",
     "null"
    ]
   },
   "refundAmount": {
    "type": "number"
   },
   "refundStatus": {
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "refundAmount",
   "refundStatus",
   "gatewaySettlementEta"
  ],
  "type": "object"
 },
 "title": "Cancel Booking (step 2 of 2)"
}
