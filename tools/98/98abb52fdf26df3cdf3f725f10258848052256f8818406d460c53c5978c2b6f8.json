{
 "description": "Change any subset of a form's settings: name, purpose, allowedDomains, redirectUrl, spamMode, active, storeSubmissions, validation rules, blocklist, autoResponder (Pro).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "active": {
    "type": "boolean"
   },
   "allowedDomains": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "autoResponder": {
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "message": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "subject": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   },
   "blocklist": {
    "description": "Emails, @domains or keywords that mark a submission as spam",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "formId": {
    "description": "Form id, e.g. frm_abc123",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "purpose": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "redirectUrl": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Absolute URL visitors are sent to after submitting"
   },
   "spamMode": {
    "enum": [
     "basic",
     "strict"
    ],
    "type": "string"
   },
   "storeSubmissions": {
    "type": "boolean"
   },
   "validation": {
    "anyOf": [
     {
      "additionalProperties": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Server-side rules by field, e.g. { \"email\": { \"required\": true, \"type\": \"email\" }, \"message\": { \"minLength\": 10 } }. null clears."
   }
  },
  "required": [
   "formId"
  ],
  "type": "object"
 },
 "name": "update_form",
 "title": "Update form settings"
}
