{
 "description": "Report coverage indicators for one COSO component, aggregating its principles.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "id": {
    "enum": [
     "control-environment",
     "risk-assessment",
     "control-activities",
     "information-communication",
     "monitoring-activities"
    ],
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "id"
  ],
  "type": "object"
 },
 "name": "assess_component",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "assessment": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ]
   },
   "found": {
    "type": "boolean"
   }
  },
  "required": [
   "found",
   "assessment"
  ],
  "type": "object"
 },
 "title": "Assess a COSO component (indicators)"
}
