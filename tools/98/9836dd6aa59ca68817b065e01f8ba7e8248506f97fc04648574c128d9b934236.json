{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Run the verdict engine across a cohort (filtered by tag and/or min-age) and return a ranked table sorted by verdict priority then confidence.\n\nPractical use: 'which three posts should I refresh this week?' - the top three rows with verdict=refresh and highest confidence are the answer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_age_days": {
    "default": 90,
    "minimum": 0,
    "type": "integer"
   },
   "sitemap_url": {
    "description": "Sitemap URL to enumerate the cohort. Falls back to POSTS_SITEMAP_URL env var.",
    "format": "uri",
    "type": "string"
   },
   "urls": {
    "description": "Explicit list of post URLs to include. Overrides sitemap discovery.",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "type": "array"
   },
   "window": {
    "default": 30,
    "enum": [
     30,
     60,
     90
    ],
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "cohort_report",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "age_days": {
       "type": "number"
      },
      "clicks": {
       "type": "number"
      },
      "confidence": {
       "type": "number"
      },
      "impressions": {
       "type": "number"
      },
      "position": {
       "type": "number"
      },
      "reasons": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "verdict": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "title",
      "age_days",
      "clicks",
      "impressions",
      "position",
      "verdict",
      "confidence",
      "reasons"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "rows"
  ],
  "type": "object"
 },
 "title": "Cohort report across posts"
}
