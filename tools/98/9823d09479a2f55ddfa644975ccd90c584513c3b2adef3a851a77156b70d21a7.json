{"_meta":{"xdata.kr/credential":{"providers":[],"register_url":null,"required":false,"windows_pc_needed":false}},"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"\uc790\uaca9\uc99d\uba85\uc774\ub098 \ub85c\uadf8\uc778 \uc5c6\uc774 \ubc14\ub85c \ud638\ucd9c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud604\uc7ac \ubd80\uac00\uc138 \uc0ac\uac74\uacfc \uc900\ube44 \uc0c1\ud0dc\ub97c \uc870\ud68c\ud569\ub2c8\ub2e4. \ubc95\uc778 \uc77c\ubc18\uacfc\uc138\uc790\uac00 \uc790\uae30 \ud68c\uc0ac\uc758 \ubd80\uac00\uac00\uce58\uc138\ub97c \uc2e0\uace0\ud560 \ub54c \uc501\ub2c8\ub2e4. \uac1c\uc778\uc0ac\uc5c5\uc790, \uac04\uc774\uacfc\uc138\uc790 \uc2e0\uace0\uc640 \uc138\ubb34\ub300\ub9ac\uc778 \uc2e0\uace0\ub294 \uc544\uc9c1 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc774\uba74 \uccab \uc694\uccad \uc804\uc5d0 request_idempotency_key \uac12\uc744 \ub9cc\ub4e4\uc5b4 \uc800\uc7a5\ud558\uc138\uc694. \uc751\ub2f5\uc744 \ubc1b\uc9c0 \ubabb\ud55c \uadf8 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c\ub9cc \uac19\uc740 \uc778\uc790\uc640 \ud568\uaed8 \uadf8 \uac12\uc744 \ub2e4\uc2dc \ubcf4\ub0b4\uace0, \uc0c8\ub85c \uc2e4\ud589\ud560 \ub54c\ub294 \uc0c8 \uac12\uc744 \uc4f0\uc138\uc694. \uc774 \uac12 \uc5c6\uc774 \ub2e4\uc2dc \ubd80\ub974\uba74 \uc0c8 \uc694\uccad\uc774 \ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5c6\uc774 \ub9db\ubcf4\uae30\ub85c \ubd80\ub97c \ub54c\ub294 \uc774 \uc120\ud0dd \uce78\uc744 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00 \uc5c5\ubb34\uc5d0 \ub530\ub85c \uc788\ub294 idempotency_key \uce78\uc740 \ub2e4\ub978 \uce78\uc774\ub2c8 \uadf8\ub300\ub85c \ub450\uc138\uc694. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 1\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"case_id":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"\uc870\ud68c\ud560 \ubd80\uac00\uc138 \uc900\ube44 \uc0ac\uac74\uc758 ID \uc785\ub2c8\ub2e4. \uc0ac\uac74 \uc0dd\uc131(vat.case.create) \uacb0\uacfc\uc758 case_id \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4.","title":"Case Id"},"request_idempotency_key":{"description":"\ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc5d0\uc11c \uc751\ub2f5\uc744 \ubabb \ubc1b\uc740 \uac19\uc740 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c \uc4f0\ub294 \uc120\ud0dd \uac12\uc785\ub2c8\ub2e4. \uc4f0\ub294 \ubc95\uc740 \ub3c4\uad6c \uc124\uba85\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.","maxLength":128,"minLength":1,"pattern":"^[\\x20-\\x7E]+$","type":"string"}},"required":["case_id"],"title":"VatNamed_vat_case_get","type":"object"},"name":"vat__case__get","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\ubd80\uac00\uc138 \uc0ac\uac74 \uc870\ud68c"}
