{
 "annotations": {
  "readOnlyHint": true,
  "title": "List History"
 },
 "description": "List your Code-Fundi query history with optional filters for date range, category, endpoint, and repository.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "categories": {
    "description": "Filter by categories",
    "items": {
     "enum": [
      "chat",
      "search",
      "research",
      "files",
      "index",
      "repos",
      "history",
      "stats",
      "keys",
      "models",
      "other"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "conversation_id": {
    "description": "Filter by conversation thread",
    "type": "string"
   },
   "endpoint": {
    "description": "Exact endpoint match (e.g. 'v2.search')",
    "type": "string"
   },
   "from": {
    "description": "Start date (ISO 8601)",
    "type": "string"
   },
   "limit": {
    "description": "Max results per page",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "number"
   },
   "query_type": {
    "description": "Exact query_type match (e.g. 'search:semantic')",
    "type": "string"
   },
   "query_type_prefix": {
    "description": "Prefix match on query_type (e.g. 'search:')",
    "type": "string"
   },
   "repo_id": {
    "description": "Filter by repository UUID",
    "type": "string"
   },
   "to": {
    "description": "End date (ISO 8601)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "code-fundi-list-history"
}
