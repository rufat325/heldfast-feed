{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit an owner-approved minimal outcome or failure. Self-reports cannot assign verified evidence status.",
 "inputSchema": {
  "additionalProperties": false,
  "allOf": [
   {
    "if": {
     "properties": {
      "record_kind": {
       "enum": [
        "actual",
        "demo"
       ]
      }
     }
    },
    "then": {
     "properties": {
      "occurred_at": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     }
    }
   }
  ],
  "properties": {
   "actions": {
    "items": {
     "maxLength": 1200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "conditions": {
    "additionalProperties": false,
    "properties": {
     "environment": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "limitations": {
      "items": {
       "maxLength": 800,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "region": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "region",
     "environment",
     "limitations"
    ],
    "type": "object"
   },
   "goal": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "idempotency_key": {
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "language": {
    "maxLength": 35,
    "minLength": 1,
    "type": "string"
   },
   "occurred_at": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "outcome_state": {
    "enum": [
     "completed",
     "failed",
     "open_question"
    ],
    "type": "string"
   },
   "private_note": {
    "maxLength": 4000,
    "minLength": 0,
    "type": "string"
   },
   "record_kind": {
    "enum": [
     "actual",
     "research",
     "demo"
    ],
    "type": "string"
   },
   "result": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "share_approved": {
    "type": "boolean"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "official",
        "research",
        "user_report"
       ],
       "type": "string"
      },
      "label": {
       "maxLength": 240,
       "minLength": 1,
       "type": "string"
      },
      "retrieved_at": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "url": {
       "maxLength": 2048,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "url",
      "label",
      "kind",
      "retrieved_at"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   },
   "summary": {
    "maxLength": 8000,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "valid_until": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "visibility": {
    "enum": [
     "private",
     "public"
    ],
    "type": "string"
   }
  },
  "required": [
   "title",
   "summary",
   "conditions",
   "sources",
   "language",
   "visibility",
   "record_kind",
   "occurred_at",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "submit_outcome",
 "title": "Publish an experience"
}
