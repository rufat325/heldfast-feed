  "readOnlyHint": true
 },
 "description": "$0.03 per call. Pay with x402 (USDC on Base) in _meta[\"x402/payment\"]; MPP (tempo) on the HTTP URL /v1/carrier/lookup. US motor carrier by USDOT, MC/MX/FF docket or exact company name (FMCSA): USDOT status, out-of-service order, operating authority per docket with grant date and source (Motus, else legacy frozen 2026-05-14), BI&PD, cargo and bond required vs on file, insurance policies, BOC-3, fleet size, safety rating. Up to 10 carriers; empty is a paid 200. Not a determination: verify with FMCSA before dispatch.",
 "inputSchema": {
  "additionalProperties": false,
  "description": "Exactly one of usdot, docket or name.",
  "oneOf": [
   {
    "required": [
     "usdot"
    ]
   },
   {
    "required": [
     "docket"
    ]
   },
   {
    "required": [
     "name"
    ]
   }
  ],
  "properties": {
   "docket": {
    "anyOf": [
     {
      "maxLength": 20,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "MC, MX or FF + digits.",
    "examples": [
     "MC138328"
    ],
    "title": "Docket"
   },
   "name": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Whole legal or DBA name; no partial match.",
    "title": "Name"
   },
   "usdot": {
    "anyOf": [
     {
      "maximum": 99999999,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "examples": [
     53467
    ],
    "title": "Usdot"
   }
  },
  "title": "CarrierLookupRequest",
  "type": "object"
 },
