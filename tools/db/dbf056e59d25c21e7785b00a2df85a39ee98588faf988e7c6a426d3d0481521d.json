  "title": "Get Pick of the Day Proof"
 },
 "description": "Read one published pick's sealed, opened or uncommitted ledger entry by its stable decimal-string pick_id. commitment_version explicitly selects version 1 legacy proofs or version 2 rank-free proofs. Never infer a proof format from dates or reorder canonical bytes. Pending proofs withhold the backed side and nonce. This tool requires the usual authenticated MCP tools/call transport; the corresponding REST read is public.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "pick_id": {
    "description": "Stable positive database row id as decimal text",
    "pattern": "^[1-9][0-9]*$",
    "type": "string"
   }
  },
  "required": [
   "pick_id"
  ],
  "type": "object"
 },
