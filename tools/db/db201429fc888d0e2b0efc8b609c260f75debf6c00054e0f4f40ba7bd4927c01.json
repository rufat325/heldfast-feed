{
 "description": "Rebar weight takeoff (d2/162 rule): total length, weight in kg and bars per tonne for a list of rebar lines. Supports metric mm bars and US # sizes as diameters.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "lines": {
    "description": "Rebar lines",
    "items": {
     "properties": {
      "diameter_mm": {
       "description": "Bar diameter, e.g. 12 or 15.875 (#5)",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "length_m": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "qty": {
       "default": 1,
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "diameter_mm",
      "length_m"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "lines"
  ],
  "type": "object"
 },
 "name": "rebar_takeoff"
}
