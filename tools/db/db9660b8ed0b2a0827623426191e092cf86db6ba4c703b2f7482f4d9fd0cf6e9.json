{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List a deployment's Tor v3 client-authorization state and each authorized client name and creation date, never private keys. A restricted service is reachable only by clients presenting an authorized key. An empty authorized-client list means public discovery. Requires an onion deployment and an agent supporting onion-auth-v1.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   }
  },
  "required": [
   "deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_onion_auth_list",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "clients": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "created_at": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "created_at"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "restricted": {
      "type": "boolean"
     }
    },
    "required": [
     "restricted",
     "clients"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "List onion authorized clients"
}
