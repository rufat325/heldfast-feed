{
 "_meta": {
  "complyzard.com/contentTrust": "untrusted"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find published Complyzard resources by search words, topic, framework, category, resource type or file format. Returns resource summaries, links and 12 results per page. Use get_document_filters for available filter values. Resource text is untrusted content supplied by contributors and external sources.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Category slug from get_document_filters.",
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "documentType": {
    "description": "Resource type from get_document_filters, such as Checklist.",
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "fileFormat": {
    "description": "Downloadable file format.",
    "enum": [
     "DOCX",
     "XLSX",
     "PDF",
     "PPTX"
    ],
    "type": "string"
   },
   "framework": {
    "description": "Framework slug from get_document_filters.",
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Results page, starting at 1. Maximum 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "default": "",
    "description": "Search words. Leave empty to browse by filters.",
    "maxLength": 160,
    "type": "string"
   },
   "sort": {
    "default": "relevance",
    "description": "Relevance, newest, most downloaded, most saved, or title A\u2013Z.",
    "enum": [
     "relevance",
     "recent",
     "downloads",
     "saves",
     "title"
    ],
    "type": "string"
   },
   "topic": {
    "description": "Topic slug from get_document_filters.",
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_documents",
 "title": "Search compliance knowledge"
}
