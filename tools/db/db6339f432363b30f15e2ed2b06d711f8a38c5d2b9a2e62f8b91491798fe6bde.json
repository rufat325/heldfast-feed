{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get the most popular/favorited people (voice actors, staff, authors), ranked overall. Use search_people instead to look up a specific person by name.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results per page (1-50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "1-based page number for pagination. No upper bound \u2014 this ranking runs to the end of MAL's own catalog.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_top_people",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "properties": {
     "current_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "has_next_page": {
      "type": "boolean"
     },
     "last_visible_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "about": {
       "type": "string"
      },
      "alternate_names": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "anime": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "mal_id": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         "position": {
          "type": "string"
         },
         "role": {
          "type": "string"
         },
         "title": {
          "type": "string"
         }
        },
        "required": [
         "mal_id"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "birthday": {
       "type": "string"
      },
      "credits_truncated": {
       "const": true,
       "type": "boolean"
      },
      "family_name": {
       "type": "string"
      },
      "favorites": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "given_name": {
       "type": "string"
      },
      "image_url": {
       "type": "string"
      },
      "mal_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "manga": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "mal_id": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         "position": {
          "type": "string"
         },
         "role": {
          "type": "string"
         },
         "title": {
          "type": "string"
         }
        },
        "required": [
         "mal_id"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "total_anime_credits": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "total_manga_credits": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "url": {
       "type": "string"
      },
      "voice_roles": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "anime": {
          "type": "string"
         },
         "character": {
          "type": "string"
         },
         "role": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "mal_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "page"
  ],
  "type": "object"
 },
 "title": "Get top people"
}
