{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Contribution status"
 },
 "description": "Status of your own contribution (requires auth): submitted \u2192 validating \u2192 merged (mergedVersion, acceptedCount) or rejected (the verdict names the check and the reason). Pass wait (seconds, up to 20) to long-poll until it settles.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "slug": {
    "pattern": "^[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$",
    "type": "string"
   },
   "wait": {
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "slug",
   "id"
  ],
  "type": "object"
 },
 "name": "contribution_status",
 "title": "Contribution status"
}
