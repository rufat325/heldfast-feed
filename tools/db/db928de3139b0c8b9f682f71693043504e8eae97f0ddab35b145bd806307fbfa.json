{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Codestral FIM"
 },
 "description": "Fill-in-the-middle code completion with Codestral.\n\nGiven `prompt` (code preceding the cursor) and `suffix` (code after the cursor),\nCodestral writes the middle. Use for editor autocomplete scenarios, code-patching\nagents, or structured refactors where you know the target boundaries.\n\nDefault stop tokens: [] \u2014 let the model decide. Override with `stop` if needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "max_tokens": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "model": {
    "enum": [
     "codestral-latest"
    ],
    "type": "string"
   },
   "prompt": {
    "description": "Code preceding the cursor.",
    "minLength": 1,
    "type": "string"
   },
   "seed": {
    "description": "Random seed for deterministic sampling. Maps to Mistral's `random_seed`.",
    "type": "integer"
   },
   "stop": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "suffix": {
    "description": "Code after the cursor. Can be empty string.",
    "type": "string"
   },
   "temperature": {
    "maximum": 2,
    "minimum": 0,
    "type": "number"
   },
   "top_p": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "prompt",
   "suffix"
  ],
  "type": "object"
 },
 "name": "codestral_fim",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "finish_reason": {
    "type": "string"
   },
   "model": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "usage": {
    "additionalProperties": false,
    "properties": {
     "completionTokens": {
      "type": "number"
     },
     "promptTokens": {
      "type": "number"
     },
     "totalTokens": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "text",
   "model"
  ],
  "type": "object"
 },
 "title": "Codestral fill-in-the-middle completion"
}
