{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List covered cities"
 },
 "description": "List the cities that currently have a live events board, with how many upcoming events each holds, biggest first. Filter by part of a name or by country. Use it to check coverage or to find the exact city name before calling search_events.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "English country name or ISO 3166-1 alpha-2 code.",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Part of a city name, e.g. \"san\" or \"York\".",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_cities",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "cities": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "city": {
       "type": "string"
      },
      "country": {
       "description": "ISO 3166-1 alpha-2.",
       "type": [
        "string",
        "null"
       ]
      },
      "country_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "events": {
       "minimum": 0,
       "type": "integer"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "city",
      "country",
      "country_name",
      "events",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "minimum": 0,
    "type": "integer"
   },
   "total_cities": {
    "description": "Cities with a live board, before filtering.",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "total_cities",
   "count",
   "cities"
  ],
  "type": "object"
 },
 "title": "List covered cities"
}
