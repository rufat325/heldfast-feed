{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get a price quote"
 },
 "description": "Get the live total for a TripWays tour on one date and start time for a traveler mix, priced from the operator's booking calendar. A quote does not hold seats or charge anything. Optional extras and promo codes are not included. When the tour's rates cannot price that mix, the result is unpriced.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bokun_id": {
    "pattern": "^[0-9]+$",
    "type": "string"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "start_time": {
    "description": "HH:MM if start_time_id unknown.",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "start_time_id": {
    "minimum": 1,
    "type": "integer"
   },
   "travelers": {
    "additionalProperties": false,
    "description": "Simple ages; mapped to Bokun pricing categories.",
    "properties": {
     "adults": {
      "default": 1,
      "minimum": 0,
      "type": "integer"
     },
     "children": {
      "minimum": 0,
      "type": "integer"
     },
     "infants": {
      "minimum": 0,
      "type": "integer"
     },
     "seniors": {
      "minimum": 0,
      "type": "integer"
     },
     "youth": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "bokun_id",
   "date"
  ],
  "type": "object"
 },
 "name": "get_price_quote",
 "outputSchema": {
  "properties": {
   "bokun_id": {
    "type": "string"
   },
   "bookable_natively": {
    "type": "boolean"
   },
   "checkout_url": {
    "description": "Checkout preset to this date, time, and travelers.",
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "date": {
    "type": "string"
   },
   "error": {
    "description": "Present when ok is false. code: tour_not_found, destination_not_found, destination_ambiguous, or unpriced. message is written for the traveler.",
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "from_price": {
    "minimum": 0,
    "type": "number"
   },
   "includes_required_extras": {
    "type": "boolean"
   },
   "min_participants": {
    "type": "integer"
   },
   "ok": {
    "type": "boolean"
   },
   "optional_extras_excluded": {
    "type": "boolean"
   },
   "package_total": {
    "description": "Total for the whole group, before optional extras and promo codes.",
    "minimum": 0,
    "type": "number"
   },
   "promo_applied": {
    "type": "boolean"
   },
   "quote_kind": {
    "type": "string"
   },
   "rate_title": {
    "type": "string"
   },
   "reason": {
    "type": [
     "string",
     "null"
    ]
   },
   "start_time": {
    "type": "string"
   },
   "travelers_priced": {
    "additionalProperties": {
     "type": "integer"
    },
    "description": "Traveler counts the total covers.",
    "type": "object"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Get a price quote"
}
