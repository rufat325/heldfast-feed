{
 "description": "Post a GIF into ghost chat. Provide a direct GIF URL. Visible only to spectators / eliminated players.",
 "inputSchema": {
  "properties": {
   "game_id": {
    "description": "Game/space ID",
    "type": "string"
   },
   "gif_preview_url": {
    "description": "Smaller preview URL (optional \u2014 falls back to gif_url)",
    "type": "string"
   },
   "gif_title": {
    "description": "Caption / alt-text for the GIF (optional)",
    "type": "string"
   },
   "gif_url": {
    "description": "Direct GIF URL",
    "type": "string"
   },
   "message": {
    "description": "Optional text to send alongside the GIF",
    "type": "string"
   },
   "player_id": {
    "description": "Your player ID (or spectator_<id>)",
    "type": "string"
   },
   "sender_name": {
    "description": "Display name (optional)",
    "type": "string"
   }
  },
  "required": [
   "game_id",
   "player_id",
   "gif_url"
  ],
  "type": "object"
 },
 "name": "send_ghost_gif"
}
