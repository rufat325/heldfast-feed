{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search skills"
 },
 "description": "Search skills by keyword across name, description, and body. Returns the best-matching skills, ranked.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum number of results to return (default 10).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Keywords describing the task, e.g. \"prioritise backlog\" or \"customer churn\".",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_skills",
 "outputSchema": {
  "properties": {
   "matches": {
    "description": "Matching skills, best first.",
    "items": {
     "properties": {
      "description": {
       "description": "One-line summary of what the skill does.",
       "type": "string"
      },
      "name": {
       "description": "The skill id (use with get_skill).",
       "type": "string"
      },
      "tier": {
       "description": "Maturity tier: production | stable | experimental.",
       "type": "string"
      },
      "title": {
       "description": "Human-readable title.",
       "type": "string"
      }
     },
     "required": [
      "name",
      "title",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "description": "The query that was searched.",
    "type": "string"
   }
  },
  "required": [
   "query",
   "matches"
  ],
  "type": "object"
 },
 "title": "Search skills"
}
