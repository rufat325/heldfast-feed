{
 "description": "Create a shipment order",
 "inputSchema": {
  "properties": {
   "from": {
    "description": "Sender info (name, phone, email, address, city, state, postal_code, document)",
    "type": "object"
   },
   "options": {
    "description": "Options (insurance_value, receipt, own_hand, etc.)",
    "type": "object"
   },
   "products": {
    "description": "Products array (same as calculate_shipping)",
    "type": "array"
   },
   "service": {
    "description": "Service ID from calculate_shipping",
    "type": "number"
   },
   "to": {
    "description": "Recipient info (name, phone, email, address, city, state, postal_code, document)",
    "type": "object"
   }
  },
  "required": [
   "service",
   "from",
   "to",
   "products"
  ],
  "type": "object"
 },
 "name": "create_shipment"
}
