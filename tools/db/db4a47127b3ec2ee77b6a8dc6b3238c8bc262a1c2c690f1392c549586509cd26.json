{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Add users to a Cloud DB for PostgreSQL instance",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudPostgresqlInstanceNo": {
    "description": "Cloud PostgreSQL instance number",
    "type": "string"
   },
   "cloudPostgresqlUserList": {
    "description": "List of users to add",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "User name to add",
       "type": "string"
      },
      "password": {
       "description": "User password",
       "type": "string"
      }
     },
     "required": [
      "name",
      "password"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "cloudPostgresqlInstanceNo",
   "cloudPostgresqlUserList"
  ],
  "type": "object"
 },
 "name": "ncloud_add_postgresql_users"
}
