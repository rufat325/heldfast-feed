{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Fetch one screenshot PNG by filename. Call it when a get_report page result or a capture_screenshot result names a screenshot you want to see; a PNG over the inline cap comes back as links.file to fetch with the jobToken. Pass a report region as region to see only the changed area: regions are in the diff image's coordinates, which share their top-left origin with the source and target screenshots, so one region crops all three. Free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filename": {
    "description": "A screenshot filename from the report.",
    "pattern": "^[a-zA-Z0-9_-]+\\.png$",
    "type": "string"
   },
   "jobId": {
    "description": "The jobId returned when the job was created, e.g. web-1a2b3c.",
    "pattern": "^web-[a-z0-9-]+$",
    "type": "string"
   },
   "jobToken": {
    "description": "The jobToken returned when the job was created. Optional when the request\u2019s HTTP headers carry the key that paid the job.",
    "maxLength": 200,
    "minLength": 20,
    "type": "string"
   },
   "region": {
    "description": "A region from the report, { x, y, width, height } in screenshot px: only that rectangle is returned, clamped to the image.",
    "properties": {
     "height": {
      "description": "Height in px.",
      "maximum": 4000,
      "minimum": 1,
      "type": "integer"
     },
     "width": {
      "description": "Width in px.",
      "maximum": 20000,
      "minimum": 1,
      "type": "integer"
     },
     "x": {
      "description": "Left edge in screenshot px.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "y": {
      "description": "Top edge in screenshot px.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "x",
     "y",
     "width",
     "height"
    ],
    "type": "object"
   }
  },
  "required": [
   "jobId",
   "filename"
  ],
  "type": "object"
 },
 "name": "get_screenshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowanceRemaining": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "bytes": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "code": {
    "type": "string"
   },
   "dimensions": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "type": "string"
   },
   "filename": {
    "type": "string"
   },
   "imageSize": {
    "additionalProperties": false,
    "properties": {
     "height": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "width": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "width",
     "height"
    ],
    "type": "object"
   },
   "jobId": {
    "type": "string"
   },
   "jobToken": {
    "type": "string"
   },
   "links": {
    "additionalProperties": false,
    "properties": {
     "file": {
      "type": "string"
     }
    },
    "required": [
     "file"
    ],
    "type": "object"
   },
   "pagesCharged": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "payment": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "type": "string"
       },
       "balance": {
        "type": "string"
       },
       "currency": {
        "const": "USD",
        "type": "string"
       },
       "rail": {
        "const": "prepaid",
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency",
       "rail",
       "balance"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "allowanceRemaining": {
        "type": "number"
       },
       "amount": {
        "type": "string"
       },
       "currency": {
        "const": "USD",
        "type": "string"
       },
       "pagesFromAllowance": {
        "type": "number"
       },
       "rail": {
        "const": "subscription",
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency",
       "rail",
       "pagesFromAllowance",
       "allowanceRemaining"
      ],
      "type": "object"
     }
    ]
   },
   "region": {
    "additionalProperties": false,
    "properties": {
     "height": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "width": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "x": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "y": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "x",
     "y",
     "width",
     "height"
    ],
    "type": "object"
   },
   "sample": {
    "type": "boolean"
   },
   "url": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Get screenshot"
}
