{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Browse what filings exist in a date window (at most 31 days) without downloading.\n\n    ``from_date``/``to_date`` accept YYYY-MM-DD or DD/MM/YYYY. Returns counts of the\n    categories (headline categories), document types, and stock codes present in the window,\n    each sorted by frequency and capped at 50 values, plus the distinct counts. Optionally\n    narrow to one ``stock_code``. Use this to discover valid filter values before calling\n    search_filings; it fetches the window once and extracts no document text.\n    ",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "from_date": {
    "description": "YYYY-MM-DD or DD/MM/YYYY",
    "type": "string"
   },
   "max_results": {
    "description": "Maximum filings to scan (default 50, cap 200)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "stock_code": {
    "description": "Optional exact HKEx stock code to narrow the facets",
    "type": "string"
   },
   "to_date": {
    "description": "YYYY-MM-DD or DD/MM/YYYY",
    "type": "string"
   }
  },
  "required": [
   "from_date",
   "to_date"
  ],
  "type": "object"
 },
 "name": "list_filing_facets",
 "outputSchema": {
  "properties": {
   "result": {
    "description": "Counts of the window's categories, document types, and stock codes.",
    "properties": {
     "categories": {
      "items": {
       "properties": {
        "count": {
         "description": "Filings carrying this value",
         "type": "integer"
        },
        "value": {
         "description": "The category, file type, or stock code",
         "type": "string"
        }
       },
       "required": [
        "value",
        "count"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "count": {
      "description": "Filings scanned",
      "type": "integer"
     },
     "distinct_categories": {
      "type": "integer"
     },
     "distinct_document_types": {
      "type": "integer"
     },
     "distinct_stock_codes": {
      "type": "integer"
     },
     "document_types": {
      "items": {
       "properties": {
        "count": {
         "description": "Filings carrying this value",
         "type": "integer"
        },
        "value": {
         "description": "The category, file type, or stock code",
         "type": "string"
        }
       },
       "required": [
        "value",
        "count"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "from": {
      "description": "Window start, YYYY-MM-DD",
      "type": "string"
     },
     "stock_code_filter": {
      "type": "string"
     },
     "stock_codes": {
      "items": {
       "properties": {
        "count": {
         "description": "Filings carrying this value",
         "type": "integer"
        },
        "value": {
         "description": "The category, file type, or stock code",
         "type": "string"
        }
       },
       "required": [
        "value",
        "count"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "to": {
      "description": "Window end, YYYY-MM-DD",
      "type": "string"
     },
     "total_reported": {
      "type": [
       "integer",
       "null"
      ]
     }
    },
    "required": [
     "from",
     "to",
     "count"
    ],
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Browse Filing Facets"
}
