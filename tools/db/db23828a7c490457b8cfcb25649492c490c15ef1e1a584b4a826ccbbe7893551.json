{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Bible Semantic Search"
 },
 "description": "Free-form natural-language search across all Bible chunks, ranked by cosine similarity. Each result includes the top-N pre-computed Urantia paragraphs related to that chunk. One query surfaces both Bible matches and the relevant Urantia content. Optional filters: `canon` (`ot`, `deuterocanon`, `nt`) and `book_code`. Set `urantia_parallel_limit` to 0 to leave out the Urantia paragraphs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "book_code": {
    "description": "Restrict to a single book. Example: \"Matt\" or \"Matthew\"",
    "type": "string"
   },
   "canon": {
    "description": "Filter by canon: ot, deuterocanon, nt",
    "enum": [
     "ot",
     "deuterocanon",
     "nt"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Bible results per page (1-100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 0,
    "description": "Page number (0-indexed)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "q": {
    "description": "Alias for `query` (REST compatibility).",
    "type": "string"
   },
   "query": {
    "description": "Natural language query. Example: \"blessed are the poor\"",
    "type": "string"
   },
   "urantia_parallel_limit": {
    "default": 3,
    "description": "How many Urantia paragraphs to attach per Bible result (0-10, default 3). 0 disables.",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "bible.search.semantic",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bookCode": {
       "type": "string"
      },
      "bookName": {
       "type": "string"
      },
      "canon": {
       "enum": [
        "ot",
        "deuterocanon",
        "nt"
       ],
       "type": "string"
      },
      "chapter": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "id": {
       "type": "string"
      },
      "reference": {
       "type": "string"
      },
      "similarity": {
       "type": "number"
      },
      "text": {
       "type": "string"
      },
      "urantiaParallels": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string"
         },
         "paperId": {
          "type": "string"
         },
         "paperTitle": {
          "type": "string"
         },
         "rank": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "sectionTitle": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "similarity": {
          "type": "number"
         },
         "standardReferenceId": {
          "type": "string"
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "standardReferenceId",
         "paperId",
         "paperTitle",
         "sectionTitle",
         "text",
         "similarity",
         "rank"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "verseEnd": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "verseStart": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "id",
      "reference",
      "bookCode",
      "bookName",
      "canon",
      "chapter",
      "verseStart",
      "verseEnd",
      "text",
      "similarity",
      "urantiaParallels"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "limit": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "page": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "totalPages": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "page",
     "limit",
     "total",
     "totalPages"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 },
 "title": "Bible Semantic Search"
}
