{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Recommend an eSIM plan"
 },
 "description": "Recommend the best plan(s) for a trip to a destination, given its length in days and expected data usage (light, medium or heavy).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "destination": {
    "type": "string"
   },
   "locale": {
    "default": "en",
    "description": "Language of the user. Sets the language of product pages and the currency of prices (en: USD, fr: EUR, ja: JPY, etc.).",
    "enum": [
     "en",
     "fr",
     "es",
     "de",
     "pt",
     "it",
     "zh",
     "ja",
     "ko",
     "ar",
     "ru",
     "tr",
     "hi",
     "vi",
     "th",
     "sv",
     "nb",
     "da",
     "fi",
     "nl",
     "pl",
     "cs",
     "zh-TW",
     "id",
     "tl",
     "he"
    ],
    "type": "string"
   },
   "tripDays": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "usage": {
    "enum": [
     "light",
     "medium",
     "heavy"
    ],
    "type": "string"
   }
  },
  "required": [
   "destination",
   "tripDays",
   "usage"
  ],
  "type": "object"
 },
 "name": "recommend_plan",
 "title": "Recommend an eSIM plan"
}
