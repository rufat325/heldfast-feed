{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "GST/HST small supplier check"
 },
 "description": "Apply the CRA's $30,000 small-supplier tests (single calendar quarter and four consecutive calendar quarters) to taxable revenue by calendar quarter. Says whether the person must register for the GST/HST, when they stop being a small supplier, the effective date of registration, and headroom for next quarter. Most businesses only (not charities/public service bodies).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "quarters": {
    "description": "Consecutive calendar quarters, no gaps (use 0 for quarters with no sales).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "description": "Taxable revenue in CAD before expenses (worldwide taxable supplies incl. zero-rated; exclude exempt)",
       "minimum": 0,
       "type": "number"
      },
      "quarter": {
       "description": "Calendar quarter: 1 = Jan\u2013Mar, 2 = Apr\u2013Jun, 3 = Jul\u2013Sep, 4 = Oct\u2013Dec",
       "maximum": 4,
       "minimum": 1,
       "type": "integer"
      },
      "year": {
       "description": "Calendar year of the quarter, e.g. 2026",
       "maximum": 2100,
       "minimum": 1991,
       "type": "integer"
      }
     },
     "required": [
      "year",
      "quarter",
      "amount"
     ],
     "type": "object"
    },
    "maxItems": 40,
    "minItems": 1,
    "type": "array"
   },
   "taxiOrRideshare": {
    "description": "True if self-employed taxi or commercial ride-sharing driver (must register regardless).",
    "type": "boolean"
   }
  },
  "required": [
   "quarters"
  ],
  "type": "object"
 },
 "name": "gst_hst_small_supplier_check",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asOf": {
    "description": "Date the rules were last verified",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "currency": {
    "const": "CAD",
    "type": "string"
   },
   "dataVersion": {
    "description": "Version of the Tallyfern Rates dataset, e.g. 2026.10.03",
    "type": "string"
   },
   "disclaimer": {
    "description": "Not-tax-advice notice",
    "type": "string"
   },
   "explanation": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "headline": {
    "description": "One-sentence answer",
    "type": "string"
   },
   "latest": {
    "additionalProperties": false,
    "properties": {
     "label": {
      "description": "e.g. 'Q2 2026 (April 1 to June 30)'",
      "type": "string"
     },
     "percentOfThreshold": {
      "type": "number"
     },
     "rollingFourQuarters": {
      "description": "Amount in Canadian dollars (CAD)",
      "type": "number"
     }
    },
    "required": [
     "label",
     "rollingFourQuarters",
     "percentOfThreshold"
    ],
    "type": "object"
   },
   "nextQuarter": {
    "additionalProperties": false,
    "properties": {
     "headroom": {
      "description": "Most revenue next quarter can have while staying a small supplier (0 if already over)",
      "type": "number"
     },
     "label": {
      "description": "e.g. 'Q2 2026 (April 1 to June 30)'",
      "type": "string"
     },
     "quarter": {
      "maximum": 4,
      "minimum": 1,
      "type": "integer"
     },
     "year": {
      "type": "integer"
     }
    },
    "required": [
     "year",
     "quarter",
     "label",
     "headroom"
    ],
    "type": "object"
   },
   "quarters": {
    "description": "Each quarter checked, oldest first",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "description": "Amount in Canadian dollars (CAD)",
       "type": "number"
      },
      "label": {
       "description": "e.g. 'Q2 2026 (April 1 to June 30)'",
       "type": "string"
      },
      "overFourQuarters": {
       "type": "boolean"
      },
      "overSingleQuarter": {
       "type": "boolean"
      },
      "quarter": {
       "maximum": 4,
       "minimum": 1,
       "type": "integer"
      },
      "quartersInWindow": {
       "maximum": 4,
       "minimum": 1,
       "type": "integer"
      },
      "rollingFourQuarters": {
       "description": "Total of this and up to three previous quarters",
       "type": "number"
      },
      "year": {
       "type": "integer"
      }
     },
     "required": [
      "year",
      "quarter",
      "label",
      "amount",
      "rollingFourQuarters",
      "quartersInWindow",
      "overSingleQuarter",
      "overFourQuarters"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "relatedLink": {
    "description": "Related free Tallyfern tool or page",
    "format": "uri",
    "type": "string"
   },
   "rule": {
    "type": "string"
   },
   "ruleVersion": {
    "type": "string"
   },
   "sources": {
    "items": {
     "format": "uri",
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "description": "Result of the small-supplier tests",
    "enum": [
     "must_register",
     "must_register_taxi",
     "small_supplier"
    ],
    "type": "string"
   },
   "threshold": {
    "description": "Small-supplier threshold (30000)",
    "type": "number"
   },
   "trigger": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "description": "Revenue that went over the threshold",
        "type": "number"
       },
       "ceasesOn": {
        "anyOf": [
         {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "description": "Last day as a small supplier (four-quarter test); null for the single-quarter test"
       },
       "ceasesToBeSmallSupplier": {
        "type": "string"
       },
       "effectiveRegistration": {
        "type": "string"
       },
       "label": {
        "description": "e.g. 'Q2 2026 (April 1 to June 30)'",
        "type": "string"
       },
       "note": {
        "type": "string"
       },
       "quarter": {
        "maximum": 4,
        "minimum": 1,
        "type": "integer"
       },
       "test": {
        "description": "Which test was failed first",
        "enum": [
         "single_quarter",
         "four_quarters"
        ],
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "test",
       "year",
       "quarter",
       "label",
       "amount",
       "ceasesOn",
       "ceasesToBeSmallSupplier",
       "effectiveRegistration"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "The first quarter that triggered registration, or null"
   }
  },
  "required": [
   "rule",
   "ruleVersion",
   "threshold",
   "currency",
   "status",
   "headline",
   "trigger",
   "explanation",
   "latest",
   "nextQuarter",
   "quarters",
   "sources",
   "asOf",
   "disclaimer",
   "relatedLink",
   "dataVersion"
  ],
  "type": "object"
 },
 "title": "GST/HST small supplier ($30,000) check"
}
