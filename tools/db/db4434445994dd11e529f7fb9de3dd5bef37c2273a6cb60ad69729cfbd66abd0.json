      "anyOf": [
       {
        "minLength": 3,
        "type": "string"
       },
       {
        "const": "",
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Adresse postale au centre de la zone"
   },
