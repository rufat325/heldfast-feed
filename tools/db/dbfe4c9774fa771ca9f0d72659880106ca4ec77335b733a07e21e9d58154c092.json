  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search events in Germany"
 },
 "description": "Use this when the user wants to find events in Germany: concerts, parties, club nights, festivals, open airs, workshops, markets or community events, in a city or near them, for a day, a weekend or a date range. Returns upcoming public events with date, venue, price and a wullup.com link. Do not use it for buying tickets, for events outside Germany, or for past events.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "enum": [
     "concerts-and-music",
     "party",
     "festivals",
     "open-air",
     "club-night",
     "workshops",
     "community",
     "markets",
     "other"
    ],
    "type": "string"
   },
   "city": {
    "description": "Only when the user explicitly named a German city or town, e.g. M\u00fcnchen, K\u00f6ln, Frankfurt am Main (English names like Munich or Cologne work too). Omit to use the user's approximate location.",
    "maxLength": 120,
    "type": "string"
   },
   "from": {
    "description": "First day to include, YYYY-MM-DD (German local date).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "language": {
    "default": "de",
    "description": "The language the user writes in: 'de' for German, 'en' for any other language. Sets the language of the event cards.",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "default": 6,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "price": {
    "description": "'free' for free entry only.",
    "enum": [
     "free",
     "paid"
    ],
    "type": "string"
   },
   "query": {
    "description": "Words to match in the event title or venue, e.g. 'Techno', 'Jazz', 'Flohmarkt'. Omit for everything.",
    "maxLength": 200,
    "type": "string"
   },
   "to": {
    "description": "Last day to include, YYYY-MM-DD (German local date).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "when": {
    "description": "A quick date window. Ignored when `from` is given.",
    "enum": [
     "today",
     "tomorrow",
     "weekend"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
