{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "[Merchant] Get a placement.\n\n**Endpoint:** GET /products/{productId}/placements/{placementId}",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "placementId": {
    "description": "The placement's ID: pl + 8 letters or digits, e.g. pl7e4rCToG",
    "pattern": "^pl[0-9A-Za-z]{8}$",
    "type": "string"
   },
   "productId": {
    "description": "The product's ID: pr + 8 letters or digits, e.g. pr7e4rCToG",
    "pattern": "^pr[0-9A-Za-z]{8}$",
    "type": "string"
   },
   "useSandbox": {
    "default": true,
    "description": "Use the sandbox (the default) rather than production",
    "type": "boolean"
   }
  },
  "required": [
   "productId",
   "placementId"
  ],
  "type": "object"
 },
 "name": "payware_products_get_placement"
}
