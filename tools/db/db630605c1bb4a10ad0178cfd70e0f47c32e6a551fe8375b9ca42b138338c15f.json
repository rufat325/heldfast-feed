{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Genereer een directe boekingslink naar de booking engine op la-truite.com (geen OTA-commissie). Vooringevulde datums/type/personen zijn optioneel \u2014 de gast rondt de boeking zelf af.",
 "inputSchema": {
  "properties": {
   "aankomst": {
    "description": "Alleen flow=verblijf/camper: vooringevulde aankomst YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "datum": {
    "description": "Alleen flow=restaurant: vooringevulde datum YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "flow": {
    "description": "Type boeking (default verblijf).",
    "enum": [
     "verblijf",
     "restaurant",
     "camper"
    ],
    "type": "string"
   },
   "personen": {
    "description": "Alleen flow=verblijf: aantal personen.",
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   },
   "type_slug": {
    "description": "Alleen flow=verblijf: vooringevuld accommodatietype, bv. lodge.",
    "type": "string"
   },
   "vertrek": {
    "description": "Alleen flow=verblijf/camper: vooringevulde vertrek YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "flow"
  ],
  "type": "object"
 },
 "name": "buildBookingLink",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "flow": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Boekingslink genereren"
}
