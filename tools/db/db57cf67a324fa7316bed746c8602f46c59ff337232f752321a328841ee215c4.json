{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/web.link-shortlist",
  "agent-utilities/priceMicroUsd": 0
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Rank real links in supplied HTML against a query; return direct URLs and matched words instead of a page dump. No search or destination verification. FREE during validation. No key, credits or wallet. Existing source and input limits apply.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "html": {
      "maxLength": 100000,
      "type": "string"
     },
     "maxLinks": {
      "default": 5,
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     },
     "query": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
     },
     "sourceUrl": {
      "maxLength": 2048,
      "type": "string"
     }
    },
    "required": [
     "html",
     "sourceUrl",
     "query"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "web_link_shortlist",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "links": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "type": "string"
      },
      "matchedTerms": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "score": {
       "type": "number"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "label",
      "score",
      "matchedTerms"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "matchingLinks": {
    "type": "number"
   },
   "measurement": {
    "additionalProperties": false,
    "properties": {
     "estimateMethod": {
      "type": "string"
     },
     "estimatedInputTokens": {
      "type": "number"
     },
     "estimatedPayloadTokens": {
      "type": "number"
     },
     "inputBytes": {
      "type": "number"
     },
     "payloadBytes": {
      "type": "number"
     }
    },
    "required": [
     "inputBytes",
     "payloadBytes",
     "estimatedInputTokens",
     "estimatedPayloadTokens",
     "estimateMethod"
    ],
    "type": "object"
   },
   "query": {
    "type": "string"
   },
   "scope": {
    "type": "string"
   },
   "sourceUrl": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "sourceUrl",
   "query",
   "links",
   "matchingLinks",
   "truncated",
   "scope",
   "measurement"
  ],
  "type": "object"
 }
}
