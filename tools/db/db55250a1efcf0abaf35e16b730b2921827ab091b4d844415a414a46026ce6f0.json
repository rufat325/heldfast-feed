  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Read the lens of one task domain instead; not together with a family.",
    "enum": [
     "coding",
     "research",
     "documents",
     "reasoning",
     "evaluation",
     "operations",
     "security"
    ],
    "type": "string"
   },
   "family": {
    "description": "Restrict the list to one pattern family.",
    "enum": [
     "baseline",
     "parallelism",
     "hierarchy",
     "shared_state",
     "verification",
     "adaptive",
     "continuity"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_patterns",
