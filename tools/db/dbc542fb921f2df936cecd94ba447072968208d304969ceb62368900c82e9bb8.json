{
 "description": "Poll a pane for a regex pattern and complete when matched or after iterations.",
 "execution": {
  "taskSupport": "required"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "flags": {
    "description": "Regex flags (e.g., i)",
    "type": "string"
   },
   "host": {
    "description": "SSH host alias (optional). Uses default host if set.",
    "type": "string"
   },
   "intervalMs": {
    "default": 1500,
    "description": "Delay between polls in milliseconds.",
    "type": "number"
   },
   "iterations": {
    "default": 8,
    "description": "Max polling iterations.",
    "type": "number"
   },
   "lines": {
    "default": 400,
    "description": "Lines per fetch.",
    "type": "number"
   },
   "pattern": {
    "description": "Regex pattern to search for.",
    "type": "string"
   },
   "target": {
    "description": "Pane target to watch (pane id or session:window.pane). If omitted, uses default pane if set.",
    "type": "string"
   }
  },
  "required": [
   "pattern"
  ],
  "type": "object"
 },
 "name": "tmux_wait_for_pattern_task",
 "title": "Wait for output pattern"
}
