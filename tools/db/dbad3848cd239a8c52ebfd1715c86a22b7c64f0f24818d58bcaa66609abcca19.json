{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Stop a scheduled brand-monitoring watch, by watchId or by term. Takes effect immediately: the run that was due does not happen and nothing further is charged. Free, and deliberately still works at a zero balance \u2014 a user who has run out of credits is exactly the user who needs to turn off what is spending them. No cost to call. Use when the user wants a scheduled watch to stop running.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"term":{"description":"Alternative to watchId \u2014 the term it was watching.","type":"string"},"watchId":{"description":"The watch's id, from list_brand_watches.","type":"string"}},"type":"object"},"name":"stop_brand_watch","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"properties":{"alreadyStopped":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]},"cost":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]},"creditsSpent":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]},"message":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]},"runs":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]},"stopped":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]},"stoppedBecause":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]},"term":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]},"watchId":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]}},"type":"object"},"title":"Stop Brand Watch"}
