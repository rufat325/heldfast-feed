{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Returns, word for word, the parts of a tip that meet one concise English repo need. The need is a short phrase: no code, file contents, paths or secrets. With slug, it reads that tip alone. state fit: whole blocks or named checklist sections; menu: the tip fits but no part was selected (get_tip has the whole text); none: no part selected (search_tips lists candidates). Each part carries its source line, the tip URL with a mark that check_installed reads later, and its durability, check age and models and conflicts_with. Missing metadata means unknown.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"need":{"description":"One concise English task, up to 200 characters, e.g. limit unrelated code edits. Omit repo/framework details unless essential. Never code, file contents, paths or secrets.","maxLength":200,"minLength":1,"type":"string"},"slug":{"description":"Optional: a tip already chosen, from a search card, to answer for that tip alone.","maxLength":120,"minLength":1,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","type":"string"}},"required":["need"],"type":"object"},"name":"find_snippets","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"menu":{"items":{"properties":{"block":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"chars":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"id":{"type":"string"},"label":{"type":"string"},"language":{"type":"string"},"mark":{"type":"string"},"units":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["block","label","language","id","mark","units","chars"],"type":"object"},"type":"array"},"message":{"type":["string","null"]},"parts":{"items":{"properties":{"block":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"id":{"type":"string"},"label":{"type":"string"},"language":{"type":"string"},"mark":{"type":"string"},"sections":{"items":{"type":"string"},"type":"array"},"text":{"type":"string"},"units":{"items":{"type":"string"},"type":"array"},"use":{"enum":["whole","sections"],"type":"string"}},"required":["block","label","language","use","id","sections","units","mark","text"],"type":"object"},"type":"array"},"state":{"enum":["fit","menu","none"],"type":"string"},"tip":{"anyOf":[{"properties":{"check":{"enum":["checked","broken","no check on record"],"type":"string"},"checked_model":{"type":"string"},"checked_on":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"conflicts_with":{"items":{"properties":{"slug":{"type":"string"},"title":{"type":"string"},"why":{"type":"string"}},"required":["slug","title","why"],"type":"object"},"type":"array"},"durability":{"enum":["model-bound","tool-bound","durable"],"type":"string"},"kind":{"enum":["prompt","rules","skill","plugin","mcp","subagent","command","config"],"type":"string"},"newer_models":{"items":{"type":"string"},"type":"array"},"paste":{"type":"string"},"slug":{"type":"string"},"title":{"type":"string"},"tools":{"items":{"enum":["claude-code","codex","cursor","pi","grok","gemini","any"],"type":"string"},"type":"array"},"url":{"format":"uri","type":"string"}},"required":["slug","title","url","kind","tools","paste","check","durability","conflicts_with"],"type":"object"},{"type":"null"}]}},"required":["state","tip","parts","menu","message"],"type":"object"},"title":"Find the parts a repo needs"}
