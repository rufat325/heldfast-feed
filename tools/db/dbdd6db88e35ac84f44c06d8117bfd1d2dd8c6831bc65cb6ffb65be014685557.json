{
 "annotations": {
  "readOnlyHint": true,
  "title": "List line items"
 },
 "description": "List billing line items (charges/procedures), filterable by appointment, doctor, patient, or service date. Returns a page plus `next`/`previous`. DrChrono API: GET /line_items.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "appointment": {
    "description": "Filter by appointment id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "doctor": {
    "description": "Filter by doctor id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "page": {
    "description": "Page number to fetch (1-based). Default 1.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "page_size": {
    "description": "Results per page (max 250). Default 100.",
    "exclusiveMinimum": 0,
    "maximum": 250,
    "type": "integer"
   },
   "patient": {
    "description": "Filter by patient id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "service_date": {
    "description": "Filter by date of service, yyyy-mm-dd.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "drchrono_list_line_items",
 "title": "List line items"
}
