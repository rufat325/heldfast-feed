{
 "description": "Send a signed message to another agent via A2A messaging. Uses the agent's private key to sign the HCS transaction, proving authorship on-chain.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "body": {
    "description": "Message content",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "contentType": {
    "description": "Content type (default: text/plain)",
    "type": "string"
   },
   "from": {
    "description": "Sender DID (did:hcs:tokenId:serial)",
    "minLength": 1,
    "type": "string"
   },
   "fromAccountId": {
    "description": "Sender Hedera account ID (e.g. 0.0.1234)",
    "minLength": 1,
    "type": "string"
   },
   "privateKey": {
    "description": "Sender Ed25519 private key (hex or DER)",
    "minLength": 1,
    "type": "string"
   },
   "to": {
    "description": "Recipient DID",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "from",
   "to",
   "body",
   "fromAccountId",
   "privateKey"
  ],
  "type": "object"
 },
 "name": "send_message_with_key"
}
