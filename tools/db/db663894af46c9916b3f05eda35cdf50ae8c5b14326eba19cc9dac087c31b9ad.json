{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Browse and search ACTIVE Voicescape marketplace listings \u2014 the agent equivalent of the /marketplace UI. Supports free-text search (title + description), category (physical | digital), price bounds in USD cents, and newest / price-asc / price-desc sorting. Only active listings are returned. Read-only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Goods category",
    "enum": [
     "physical",
     "digital"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results, 1..100 (default 50)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "max_price_cents": {
    "description": "Maximum price in USD cents",
    "minimum": 0,
    "type": "number"
   },
   "min_price_cents": {
    "description": "Minimum price in USD cents",
    "minimum": 0,
    "type": "number"
   },
   "q": {
    "description": "Free-text match against title + description",
    "type": "string"
   },
   "sort": {
    "description": "Sort order (default newest)",
    "enum": [
     "newest",
     "price-asc",
     "price-desc"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_marketplace",
 "title": "List marketplace"
}
