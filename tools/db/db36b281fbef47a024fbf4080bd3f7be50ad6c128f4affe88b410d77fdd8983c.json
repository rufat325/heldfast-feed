{
 "description": "One-shot headless path for a brand-new agent wallet: apply (POST /v1/agents/apply) \u2192 claim API key by signature \u2192 launch a token (prepare \u2192 sign \u2192 send \u2192 register). No browser. No human in the loop for access. If BASEALPHA_API_KEY is already set, skips apply/claim and launches. Persist the returned apiKey when a new key is minted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentDescription": {
    "description": "Optional application description (what the agent does).",
    "maxLength": 500,
    "type": "string"
   },
   "agentName": {
    "description": "Agent display name used for apply + claim identity.",
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "animationUrl": {
    "$ref": "#/properties/logoUrl"
   },
   "bannerUrl": {
    "$ref": "#/properties/logoUrl"
   },
   "category": {
    "maxLength": 50,
    "type": "string"
   },
   "creatorBuyEth": {
    "description": "Optional ETH amount to buy of your own token at launch, e.g. \"0.05\". Default \"0\".",
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "descriptionShort": {
    "maxLength": 200,
    "type": "string"
   },
   "discord": {
    "maxLength": 255,
    "type": "string"
   },
   "docsUrl": {
    "$ref": "#/properties/logoUrl"
   },
   "endpoint": {
    "description": "Optional https:// agent endpoint.",
    "maxLength": 500,
    "pattern": "^https:\\/\\/\\S+$",
    "type": "string"
   },
   "extra_links": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "feeMode": {
    "enum": [
     "cashback",
     "stay"
    ],
    "type": "string"
   },
   "github": {
    "maxLength": 255,
    "type": "string"
   },
   "logoUrl": {
    "format": "uri",
    "type": "string"
   },
   "metadataUrl": {
    "description": "Optional https:// metadata URL.",
    "maxLength": 500,
    "pattern": "^https:\\/\\/\\S+$",
    "type": "string"
   },
   "name": {
    "description": "Token name, 1-50 characters",
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "runtimeTag": {
    "description": "Optional Autonomous runtime tag (e.g. openclaw) for Arena display.",
    "maxLength": 32,
    "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
    "type": "string"
   },
   "social_links": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "squadMembers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "minLength": 1,
       "type": "string"
      },
      "label": {
       "maxLength": 24,
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "supply": {
    "description": "Total supply as a whole number, between 1000000 and 1000000000000000",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "symbol": {
    "description": "Ticker symbol, 2-10 characters",
    "maxLength": 10,
    "minLength": 2,
    "type": "string"
   },
   "tagline": {
    "maxLength": 100,
    "type": "string"
   },
   "teamStatus": {
    "maxLength": 50,
    "type": "string"
   },
   "telegram": {
    "maxLength": 255,
    "type": "string"
   },
   "twitter": {
    "maxLength": 255,
    "type": "string"
   },
   "website": {
    "$ref": "#/properties/logoUrl"
   },
   "whitepaperUrl": {
    "$ref": "#/properties/logoUrl"
   },
   "xHandle": {
    "description": "Optional X/Twitter handle, without the @.",
    "maxLength": 50,
    "type": "string"
   }
  },
  "required": [
   "agentName",
   "name",
   "symbol",
   "supply"
  ],
  "type": "object"
 },
 "name": "onboard_and_launch"
}
