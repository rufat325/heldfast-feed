{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Run panel and save snapshot"
 },
 "description": "Run a saved panel through am_i_cited and append a timestamped snapshot. Side effects: makes external API calls to the configured AI engine (costs API quota); writes one snapshot file to disk at <config>/snapshots/<panel>/<iso>.json. Requires at least one engine API key (same as am_i_cited). Returns per-query citation presence and a citation_rate summary for the run. Use panel_track to create a panel first; use citations_trend to read the accumulated trend after multiple runs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Override the panel's default domain for this run.",
    "type": "string"
   },
   "engine": {
    "default": "auto",
    "description": "AI engine to query. Use bing_serp/brave_serp for web_rank comparison only \u2014 am_i_cited will refuse them.",
    "enum": [
     "perplexity",
     "claude",
     "openai",
     "gemini",
     "bing_serp",
     "brave_serp",
     "google_ai_mode",
     "auto"
    ],
    "type": "string"
   },
   "name": {
    "description": "Panel name previously saved via track_queries.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "panel_run",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "saved_to": {
    "description": "Absolute file path of the snapshot that was written.",
    "type": "string"
   },
   "snapshot": {
    "additionalProperties": false,
    "description": "The snapshot that was appended.",
    "properties": {
     "domain": {
      "type": "string"
     },
     "engine": {
      "type": "string"
     },
     "panel": {
      "type": "string"
     },
     "per_query": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "cited": {
         "description": "Whether the domain was cited for this query.",
         "type": "boolean"
        },
        "matching_urls": {
         "description": "Matching citation URLs found.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "query": {
         "type": "string"
        },
        "rank": {
         "description": "1-based rank of the first matching citation.",
         "type": "number"
        }
       },
       "required": [
        "query",
        "cited",
        "matching_urls"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "summary": {
      "additionalProperties": false,
      "properties": {
       "average_rank": {
        "description": "Average rank across cited queries.",
        "type": "number"
       },
       "citation_rate": {
        "description": "Fraction of queries where domain was cited (0-1).",
        "type": "number"
       },
       "queries_cited": {
        "type": "number"
       },
       "queries_total": {
        "type": "number"
       }
      },
      "required": [
       "queries_total",
       "queries_cited",
       "citation_rate"
      ],
      "type": "object"
     },
     "taken_at": {
      "type": "string"
     }
    },
    "required": [
     "panel",
     "domain",
     "engine",
     "taken_at",
     "per_query",
     "summary"
    ],
    "type": "object"
   }
  },
  "required": [
   "saved_to",
   "snapshot"
  ],
  "type": "object"
 }
}
