{"description":"Reorder slides in a presentation deck, either by providing a complete slideOrder array or moving a single slideId to a target position.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"deckId":{"description":"Stable ID of the presentation deck","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"slideId":{"description":"Single slide ID to move","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"slideOrder":{"description":"Complete array of slide IDs declaring the desired final order","items":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"type":"array"},"toPosition":{"description":"0-based target index when moving a single slide","maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["deckId"],"type":"object"},"name":"slide_move"}
