{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare clinics or pharmacies"
 },
 "description": "Two to six clinics, or two to six pharmacies, side by side by slug. Clinics: first and follow-up fees, estimated year-one and later-year clinic fees with a line-by-line breakdown for the patient type and visit counts you give, consultation types, CQC rating, reviews and whether accepting patients. Pharmacies: delivery and its cheapest price, free-delivery threshold, collection, GPhC registration and inspection outcome, reviews. Use it for 'which is cheapest', 'what's the difference between'. Services only: it never compares medicines or medicine prices, and the figures are each provider's published ones.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "followUpsPerYear": {
    "description": "Clinics: follow-up consultations a year. Default 4.",
    "maximum": 24,
    "minimum": 0,
    "type": "integer"
   },
   "kind": {
    "description": "Compare clinics or pharmacies (not both at once).",
    "enum": [
     "clinic",
     "pharmacy"
    ],
    "type": "string"
   },
   "patientType": {
    "description": "Clinics: price year one as NEW_PATIENT (default), TRANSFER or ACTIVE_PATIENT.",
    "enum": [
     "NEW_PATIENT",
     "TRANSFER",
     "ACTIVE_PATIENT"
    ],
    "type": "string"
   },
   "prescriptionsPerYear": {
    "description": "Clinics: repeat prescriptions a year. Default 12.",
    "maximum": 24,
    "minimum": 0,
    "type": "integer"
   },
   "slugs": {
    "description": "2-6 page slugs from find_clinics / find_pharmacies.",
    "items": {
     "description": "The page slug from a find_* tool or search_findabis, e.g. \"green-leaf-clinic\".",
     "maxLength": 200,
     "minLength": 1,
     "pattern": "^[a-z0-9][a-z0-9-]*$",
     "type": "string"
    },
    "maxItems": 6,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "kind",
   "slugs"
  ],
  "type": "object"
 },
 "name": "compare_providers",
