{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Generate subject lines"
 },
 "description": "Generate AI subject-line variants for a campaign topic, optionally tuned to a tone and audience. Good input for create_ab_test.",
 "inputSchema": {
  "properties": {
   "audience": {
    "description": "Who the email is for",
    "type": "string"
   },
   "count": {
    "description": "How many variants to generate (default 5, max 10)",
    "type": "number"
   },
   "tone": {
    "description": "Desired tone (default professional)",
    "enum": [
     "professional",
     "casual",
     "urgent",
     "playful",
     "informative"
    ],
    "type": "string"
   },
   "topic": {
    "description": "What the email is about",
    "type": "string"
   }
  },
  "required": [
   "topic"
  ],
  "type": "object"
 },
 "name": "generate_subject_lines"
}
