{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Record one task's reported reuse. Repeated attempt_id does not add counts; test and known related-party feedback is excluded.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "attempt_id": {
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "conditions": {
    "additionalProperties": false,
    "properties": {
     "environment": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "limitations": {
      "items": {
       "maxLength": 800,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "region": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "region",
     "environment",
     "limitations"
    ],
    "type": "object"
   },
   "idempotency_key": {
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "outcome_id": {
    "maxLength": 64,
    "pattern": "^[a-z]+_[0-9a-f]{32}$",
    "type": "string"
   },
   "result": {
    "enum": [
     "worked",
     "partial",
     "failed",
     "not_applicable"
    ],
    "type": "string"
   },
   "summary": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "outcome_id",
   "attempt_id",
   "result",
   "summary",
   "conditions",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "report_reuse",
 "title": "Share an attempt report"
}
