{
 "description": "Create a signed access receipt \u2014 cryptographic proof that your agent consumed content under specific terms. The receipt captures terms and revocation policy at access time.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentPrivateKey": {
    "description": "Your agent's Ed25519 private key (hex)",
    "type": "string"
   },
   "agentPublicKey": {
    "description": "Your agent's Ed25519 public key (hex)",
    "type": "string"
   },
   "block": {
    "description": "Governance block JSON string",
    "type": "string"
   },
   "intendedUsage": {
    "description": "How you intend to use this content",
    "type": "string"
   },
   "sourceUrl": {
    "description": "URL where content was accessed",
    "type": "string"
   }
  },
  "required": [
   "agentPublicKey",
   "agentPrivateKey",
   "block",
   "sourceUrl",
   "intendedUsage"
  ],
  "type": "object"
 },
 "name": "create_access_receipt"
}
