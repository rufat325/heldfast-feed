{"_meta":{"securitySchemes":[{"scopes":["invoicevista:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Update a stock quantity"},"description":"Use this when someone asks to correct or update how much of an item a business has in stock, such as after a count or a delivery. Returns the item with its previous and new quantity; the number given replaces the stored one. Not for adding a new stock item.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"expectedLastEditTime":{"description":"The item's lastEditTime as last read; an item changed since then is refused.","format":"date-time","maxLength":40,"type":"string"},"inventoryItemId":{"description":"Stock item id: 24 lowercase hexadecimal characters.","maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"quantity":{"description":"The quantity now in stock, in the item unit. It replaces the stored quantity rather than adding to it.","maximum":1000000000,"minimum":0,"type":"number"}},"required":["inventoryItemId","quantity","expectedLastEditTime"],"type":"object"},"name":"set_inventory_quantity","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"item":{"additionalProperties":false,"properties":{"businessId":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"id":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"lastEditTime":{"anyOf":[{"maxLength":40,"type":"string"},{"type":"null"}]},"lowStock":{"type":"boolean"},"minimumQuantity":{"anyOf":[{"maximum":1000000000,"minimum":0,"type":"number"},{"type":"null"}]},"name":{"maxLength":200,"type":"string"},"quantity":{"anyOf":[{"maximum":1000000000,"minimum":0,"type":"number"},{"type":"null"}]},"unit":{"anyOf":[{"maxLength":40,"type":"string"},