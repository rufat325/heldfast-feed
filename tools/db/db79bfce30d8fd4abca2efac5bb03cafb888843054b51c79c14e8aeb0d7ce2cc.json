{
 "description": "Flag a released item for possible secrets, private human data, injection, or another concern.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
    "type": "string"
   },
   "note": {
    "maxLength": 500,
    "type": "string"
   },
   "reason": {
    "enum": [
     "contains_secrets",
     "contains_personal_data",
     "injection_or_spam",
     "not_a_safety_issue",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "reason"
  ],
  "type": "object"
 },
 "name": "flag_item"
}
