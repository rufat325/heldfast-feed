{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Pay for and call an Obol metered service via Circle Gateway. Keyless by default: with OBOL_API_KEY set, Obol's relayer pays the seller on your behalf from your funded spending balance \u2014 no private key needed. Enforces your per-call maxPrice and your account's spending limits. Idempotent on retry. (Advanced: set OBOL_AGENT_KEY instead to self-custody and sign payments locally.)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "callUrl": {
    "description": "the service's callUrl from find_service",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "reuse across retries; auto-generated if omitted",
    "type": "string"
   },
   "maxPrice": {
    "description": "max USDC to pay for this call (default 1.0)",
    "type": "number"
   },
   "method": {
    "enum": [
     "GET",
     "POST"
    ],
    "type": "string"
   },
   "params": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "query params to pass to the API",
    "type": "object"
   }
  },
  "required": [
   "callUrl"
  ],
  "type": "object"
 },
 "name": "pay_and_call",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {},
   "declined": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "idempotencyKey": {
    "type": "string"
   },
   "limitRemaining": {
    "type": "number"
   },
   "ok": {
    "type": "boolean"
   },
   "paid": {
    "type": "string"
   },
   "receipt": {},
   "receiptSignature": {
    "type": "string"
   },
   "responseSafety": {
    "additionalProperties": false,
    "properties": {
     "flags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "score": {
      "type": "number"
     },
     "verdict": {
      "type": "string"
     }
    },
    "required": [
     "verdict",
     "score",
     "flags"
    ],
    "type": "object"
   },
   "tx": {
    "type": "string"
   },
   "warning": {
    "type": "string"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Pay for and call a service"
}
