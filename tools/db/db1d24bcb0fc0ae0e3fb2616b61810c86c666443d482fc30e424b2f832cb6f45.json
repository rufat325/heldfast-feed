{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "The checks the model's own gate runs, from the checker release this server was built with. Use to see which rules a script enforces and which are left to a reader. No input. Returns `checks`, each with `name`, `rule`, `title` and what it `reports`, a `failure` or a `note` that fails nothing, and `ranBy`. This server runs none of them.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {},
  "type": "object"
 },
 "name": "list_checks",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "checks": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "name": {
       "type": "string"
      },
      "reports": {
       "enum": [
        "failure",
        "note"
       ],
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "name",
      "rule",
      "title",
      "reports"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "model": {
    "additionalProperties": false,
    "properties": {
     "commit": {
      "type": [
       "string",
       "null"
      ]
     },
     "core": {
      "type": "string"
     },
     "parser": {
      "type": "string"
     },
     "repo": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "commit",
     "repo",
     "core",
     "parser"
    ],
    "type": "object"
   },
   "ranBy": {
    "type": "string"
   }
  },
  "required": [
   "checks",
   "ranBy",
   "model"
  ],
  "type": "object"
 }
}
