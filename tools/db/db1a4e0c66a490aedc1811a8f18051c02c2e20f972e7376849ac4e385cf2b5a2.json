  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search NYC underused buildings"
 },
 "description": "Lists NYC buildings with unused or vacant space: office buildings, school buildings and religious property (churches, convents, synagogues) in any of the five boroughs. A building is flagged when its owner reports it half occupied or less, half or more of its storefronts are reported vacant, it is listed for lease, a city order to vacate it is in force, or it is a school building with no school registered in it. Buildings listed for sale are returned too. Each row gives the BBL, address, owner of record, building size and every figure behind the flag, marked owner-reported, seen or inferred, with its date. The underused flag itself is derived. Never spends credits. On any paid plan the first 25 rows each day are free; other workspaces pay for every row. Rows already pulled are free again. Past the free rows, rows cost 1 credit per row, and this tool returns them as a quote: tell the user the credit cost and ask before calling run_nyc_underused_search with the quote_id. No contacts in the result: use unlock_nyc_property_report and then unlock_nyc_owner_contacts on a BBL for the owner's phones and emails. Up to 50 rows per call (default 25), largest buildings first; page with offset.",
 "inputSchema": {
  "properties": {
   "borough": {
    "description": "One NYC borough. All five when omitted.",
    "enum": [
     "manhattan",
     "bronx",
     "brooklyn",
     "queens",
     "staten_island"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_building_sqft": {
    "description": "Smallest building area in square feet.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "ntas": {
    "description": "2020 neighborhood codes from find_nyc_area, for example MN0801 Upper East Side-Lenox Hill-Roosevelt Island. Use them whenever the person names a neighborhood, so rows outside it are never quoted.",
    "items": {
     "pattern": "^[A-Z]{2}\\d{4}$",
     "type": "string"
    },
    "maxItems": 40,
    "type": "array"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "reason": {
    "description": "Keep only buildings with this signal: low_occupancy (owner reports half or less occupied), vacant_storefronts (half or more vacant), for_lease, for_sale, vacate_order (a city order to vacate still in force), no_school (a school building with no school registered in it).",
    "enum": [
     "low_occupancy",
     "vacant_storefronts",
     "for_lease",
     "for_sale",
     "vacate_order",
     "no_school"
    ],
    "type": "string"
   },
   "use": {
    "description": "office (office buildings), school (school buildings) or religious (churches, convents, synagogues and other property of religious owners). Every use when omitted.",
    "enum": [
     "office",
     "school",
     "religious"
    ],
    "type": "string"
   },
   "zips": {
    "description": "NYC ZIP codes. Combined with ntas as any of those places.",
    "items": {
     "pattern": "^\\d{5}$",
     "type": "string"
    },
    "maxItems": 40,
    "type": "array"
   }
  },
  "type": "object"
 },
