{
 "_meta": {
  "stackfacts/http": "GET /v1/cve/{id}",
  "stackfacts/keywords": [
   "get a CVE",
   "CVE lookup",
   "CVE details",
   "CVE fixed version",
   "CVE affected packages",
   "CVSS score",
   "OSV",
   "CISA KEV",
   "CVE priority"
  ],
  "stackfacts/paid": true,
  "stackfacts/price_usd": "0.003"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get any CVE: CISA KEV entry, CVSS score and patch priority, plus every OSV advisory aliased to it, with affected packages and fixed versions.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "CVE id, e.g. CVE-2021-44228. Loose ids such as cve 2021 44228 or cve_2021_44228 are accepted.",
    "maxLength": 32,
    "pattern": "^\\s*[Cc][Vv][Ee][\\s_\\u2010-\\u2015\\u2212-]*\\d{4}(?:[\\s_\\u2010-\\u2015\\u2212-]+\\d{4,}|\\d{5,})\\s*$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "stackfacts_cve_lookup"
}
