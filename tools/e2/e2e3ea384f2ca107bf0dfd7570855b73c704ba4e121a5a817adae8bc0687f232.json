 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Search Flights Live"
 },
 "description": "Starts a live flight search for a route and date, one-way or return. Fares come from Agoda, Trip.com, Traveloka and Google Flights. Origin and destination are 3-letter IATA airport codes (for example SGN, HAN, DAD). Returns a session ID; poll_flight_results returns the results. When the route or date is missing, the result is a question for the user instead of a search.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adults": {
    "default": 1,
    "description": "Number of adults (default 1)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "cabin": {
    "default": "economy",
    "description": "Cabin class (default economy)",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "departureDate": {
    "description": "Departure date YYYY-MM-DD, today or later. When omitted, the result asks the user for it.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "destination": {
    "description": "Arrival airport IATA code, e.g. 'HAN'. When omitted, the result asks the user for it.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "language": {
    "description": "Preferred UI language (en/vi/de/ja/ko/zh/fr/es/ru/th/id).",
    "enum": [
     "en",
     "vi",
     "de",
     "ja",
     "ko",
     "zh",
     "fr",
     "es",
     "ru",
     "th",
     "id"
    ],
    "type": "string"
   },
   "origin": {
    "description": "Departure airport IATA code, e.g. 'SGN'. When omitted, the result asks the user for it.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "queryText": {
    "description": "Optional short excerpt of the current request, used only to detect the UI language; it is not stored or forwarded.",
    "maxLength": 500,
    "type": "string"
   },
   "returnDate": {
    "description": "Return date YYYY-MM-DD (omit for one-way). Must be on or after departureDate.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
