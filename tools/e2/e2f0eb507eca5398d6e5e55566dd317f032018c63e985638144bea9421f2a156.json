{
 "description": "Transform AI-generated text to sound natural and human-written. Preserves meaning while improving readability. Use this after writing content with AI to make it sound authentic.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "level": {
    "description": "Humanization intensity \u2014 light preserves more original wording, aggressive makes maximum changes (default: aggressive)",
    "enum": [
     "light",
     "balanced",
     "aggressive"
    ],
    "type": "string"
   },
   "style": {
    "description": "Content style (default: general)",
    "enum": [
     "general",
     "essay",
     "article",
     "marketing",
     "creative",
     "formal",
     "report",
     "business",
     "legal"
    ],
    "type": "string"
   },
   "text": {
    "description": "The AI-generated text to humanize",
    "minLength": 50,
    "type": "string"
   },
   "tone": {
    "description": "Writing tone (default: standard)",
    "enum": [
     "casual",
     "standard",
     "academic",
     "professional",
     "marketing"
    ],
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "humanize_text"
}
