{
 "description": "Delete multiple media items at once. Returns the deleted and failed IDs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "force": {
    "description": "Permanently delete (default true)",
    "type": "boolean"
   },
   "ids": {
    "description": "Media IDs to delete",
    "items": {
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "ids"
  ],
  "type": "object"
 },
 "name": "mcp_bulk_delete_media"
}
