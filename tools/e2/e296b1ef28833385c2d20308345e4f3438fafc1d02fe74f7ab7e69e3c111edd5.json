{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare platform requirements"
 },
 "description": "Compare documented or readiness-oriented field requirements across supported hotel and catalog platforms before designing a feed mapping.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "targets": {
    "description": "Optional list of validation targets. Omit to use every supported target.",
    "items": {
     "description": "Validation target. Choose a published-contract validator, readiness checker or the generic hotel master data audit.",
     "enum": [
      "wego",
      "google_hotel_center",
      "trivago",
      "meta_catalog",
      "criteo",
      "hotel_master_data"
     ],
     "type": "string"
    },
    "maxItems": 6,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "compare_platform_requirements",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "platforms": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "formats": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "mode": {
       "type": "string"
      },
      "officialDocs": {
       "format": "uri",
       "type": "string"
      },
      "requirements": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "field": {
          "type": "string"
         },
         "formats": {
          "items": {
           "enum": [
            "JSON",
            "XML",
            "CSV",
            "TSV",
            "NDJSON"
           ],
           "type": "string"
          },
          "type": "array"
         },
         "label": {
          "type": "string"
         },
         "level": {
          "enum": [
           "required",
           "recommended",
           "informational"
          ],
          "type": "string"
         },
         "note": {
          "type": "string"
         }
        },
        "required": [
         "field",
         "label",
         "level"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "target": {
       "description": "Validation target. Choose a published-contract validator, readiness checker or the generic hotel master data audit.",
       "enum": [
        "wego",
        "google_hotel_center",
        "trivago",
        "meta_catalog",
        "criteo",
        "hotel_master_data"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "target",
      "title",
      "description",
      "formats",
      "mode",
      "requirements"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "platforms"
  ],
  "type": "object"
 },
 "title": "Compare platform requirements"
}
