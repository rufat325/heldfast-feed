{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants to know which vulnerable dependencies to fix first, such as \"which dependencies in this package-lock.json should I upgrade first?\" or \"triage my requirements.txt\". Pass the text of a package-lock.json, package.json or requirements.txt as manifest, or a packages list of ecosystem, name and exact version (npm, pypi, go, crates.io, maven, rubygems, nuget, packagist); only names and versions are read. Returns fix_first: by default the 3 packages to upgrade first, each with a priority (malicious, exploited, likely, routine or unknown), one line on why, the CVE ids and the version that fixes it, then a short list of the other vulnerable packages and a count per priority. It matches exact package versions to known advisories; it does not scan code or show that the vulnerable code is reached.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "How many packages to put in fix_first (default 3)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "manifest": {
    "description": "The text of a package-lock.json (best: exact versions), a package.json (ranges read at their lowest version) or a requirements.txt (only == pins). Only names and versions are read.",
    "maxLength": 500000,
    "minLength": 2,
    "type": "string"
   },
   "packages": {
    "description": "Installed packages: ecosystem (npm, pypi, go, crates.io, maven, rubygems, nuget, packagist), name and exact version. Up to 300.",
    "items": {
     "properties": {
      "ecosystem": {
       "enum": [
        "npm",
        "pypi",
        "go",
        "crates.io",
        "maven",
        "rubygems",
        "nuget",
        "packagist"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "ecosystem",
      "name",
      "version"
     ],
     "type": "object"
    },
    "maxItems": 300,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "triage_dependencies",
 "outputSchema": {
  "properties": {
   "advisories": {
    "type": "integer"
   },
   "also_vulnerable": {
    "items": {
     "properties": {
      "ecosystem": {
       "type": "string"
      },
      "fixed_in": {
       "type": [
        "string",
        "null"
       ]
      },
      "package": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "malicious",
        "exploited",
        "likely",
        "unknown",
        "routine"
       ],
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "also_vulnerable_total": {
    "type": "integer"
   },
   "as_of": {
    "properties": {
     "epss": {
      "type": [
       "string",
       "null"
      ]
     },
     "kev": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "checked": {
    "type": "integer"
   },
   "clean": {
    "type": "integer"
   },
   "counts": {
    "properties": {
     "exploited": {
      "type": "integer"
     },
     "likely": {
      "type": "integer"
     },
     "malicious": {
      "type": "integer"
     },
     "routine": {
      "type": "integer"
     },
     "unknown": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "fix_first": {
    "items": {
     "properties": {
      "advisories": {
       "description": "All advisories for this version",
       "type": "integer"
      },
      "advisory": {
       "description": "The advisory that sets the priority",
       "type": "string"
      },
      "cves": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "ecosystem": {
       "type": "string"
      },
      "epss": {
       "type": [
        "number",
        "null"
       ]
      },
      "fix": {
       "description": "The one-line action",
       "type": "string"
      },
      "fixed_in": {
       "description": "Lowest version that fixes every advisory that has a fix",
       "type": [
        "string",
        "null"
       ]
      },
      "kev": {
       "properties": {
        "added_on": {
         "type": "string"
        },
        "due_date": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": [
        "object",
        "null"
       ]
      },
      "package": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "malicious",
        "exploited",
        "likely",
        "unknown",
        "routine"
       ],
       "type": "string"
      },
      "severity": {
       "enum": [
        "critical",
        "high",
        "moderate",
        "low",
        null
       ],
       "type": [
        "string",
        "null"
       ]
      },
      "version": {
       "description": "The installed version that was checked",
       "type": "string"
      },
      "why": {
       "description": "One line on why it has this priority",
       "type": "string"
      }
     },
     "required": [
      "package",
      "ecosystem",
      "version",
      "priority",
      "why",
      "advisories",
      "fixed_in",
      "fix"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "not_triaged": {
    "items": {
     "properties": {
      "ecosystem": {
       "enum": [
        "npm",
        "pypi",
        "go",
        "crates.io",
        "maven",
        "rubygems",
        "nuget",
        "packagist"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "ecosystem",
      "name",
      "version"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "skipped": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "skipped_count": {
    "type": "integer"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "invalid_input",
     "unavailable"
    ],
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   },
   "vulnerable": {
    "type": "integer"
   }
  },
  "required": [
   "status",
   "summary",
   "checked",
   "vulnerable",
   "clean",
   "counts",
   "fix_first",
   "also_vulnerable",
   "not_triaged",
   "as_of",
   "source",
   "notice"
  ],
  "type": "object"
 },
 "title": "Triage dependency vulnerabilities"
}
