{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "category": "web",
 "description": "Measure response time of one or more HTTP endpoints (GET/POST). Runs N iterations and returns min/max/avg/p95 latency. Useful for API and MCP server benchmarking.",
 "inputSchema": {
  "properties": {
   "endpoints": {
    "description": "Endpoints to benchmark. Accepts a single URL string, an array of URL strings, or an array of {url, method?, body?, headers?, label?} objects.",
    "items": {
     "properties": {
      "body": {
       "additionalProperties": true,
       "description": "Request body for POST",
       "type": "object"
      },
      "headers": {
       "additionalProperties": true,
       "description": "Custom headers",
       "type": "object"
      },
      "label": {
       "description": "Optional label for this endpoint",
       "type": "string"
      },
      "method": {
       "description": "HTTP method (default: GET)",
       "enum": [
        "GET",
        "POST"
       ],
       "type": "string"
      },
      "url": {
       "description": "Full URL to test",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": [
     "string",
     "array"
    ]
   },
   "iterations": {
    "description": "Number of iterations per endpoint (default: 3, max: 10)",
    "type": "number"
   }
  },
  "required": [
   "endpoints"
  ],
  "type": "object"
 },
 "name": "latency_benchmark",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "iterations": {
    "type": "number"
   },
   "results": {
    "items": {
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}
