  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contentType": {
    "default": "text",
    "description": "Format for body content: text extracts plain text, html preserves HTML structure",
    "enum": [
     "text",
     "html"
    ],
    "type": "string"
   },
   "excludeThreadHistory": {
    "default": false,
    "description": "When true, removes quoted thread history from body content",
    "type": "boolean"
   },
   "filename": {
    "default": "gmail-messages.csv",
    "description": "Output filename (default: gmail-messages.csv)",
    "minLength": 1,
    "type": "string"
   },
   "maxItems": {
    "default": 10000,
    "description": "Maximum messages to export (default: 10000, max: 50000)",
    "exclusiveMinimum": 0,
    "maximum": 50000,
    "type": "integer"
   },
   "query": {
    "anyOf": [
     {
      "$ref": "#/$defs/__schema0"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Structured query object or JSON string for filtering messages. Use query-syntax prompt for reference and rawGmailQuery for Gmail syntax."
   }
