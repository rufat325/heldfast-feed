{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing Zendesk ticket.\n\nCan update status, priority, assignee, tags, custom fields, and add comments.\nUse add_comment to add a reply (public or internal note).\n\nExample - resolve with comment:\n{\n  \"ticket_id\": 12345,\n  \"status\": \"solved\",\n  \"add_comment\": \"Issue resolved - password reset successful\",\n  \"comment_public\": true\n}",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "add_comment": {
    "description": "Comment to add to ticket",
    "type": "string"
   },
   "add_tags": {
    "description": "Add tags (keeps existing)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "assignee_id": {
    "description": "New assignee ID",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "comment_public": {
    "description": "Is comment public (true) or internal note (false)? Default: true",
    "type": "boolean"
   },
   "custom_fields": {
    "description": "Custom field updates",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "value": {}
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "group_id": {
    "description": "New group ID",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "priority": {
    "description": "New priority",
    "enum": [
     "low",
     "normal",
     "high",
     "urgent"
    ],
    "type": "string"
   },
   "remove_tags": {
    "description": "Remove specific tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "description": "New status",
    "enum": [
     "new",
     "open",
     "pending",
     "hold",
     "solved"
    ],
    "type": "string"
   },
   "subdomain": {
    "description": "Zendesk subdomain (optional if only one account connected)",
    "type": "string"
   },
   "subject": {
    "description": "New subject line",
    "type": "string"
   },
   "tags": {
    "description": "Replace all tags with this list",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ticket_id": {
    "description": "Ticket ID to update",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "type": {
    "description": "New ticket type",
    "enum": [
     "problem",
     "incident",
     "question",
     "task"
    ],
    "type": "string"
   }
  },
  "required": [
   "ticket_id"
  ],
  "type": "object"
 },
 "name": "update_zendesk_ticket"
}
