{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List Mapbox Styles Tool"
 },
 "description": "List styles for a Mapbox account. Use limit parameter to avoid large responses (recommended: limit=5-10). Use start parameter for pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Maximum number of styles to return (recommended: 5-10 to avoid token limits, default: no limit)",
    "type": "number"
   },
   "start": {
    "description": "Start token for pagination (use the \"start\" value from previous response)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_styles_tool",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "styles": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bearing": {
       "description": "Default bearing in degrees",
       "type": "number"
      },
      "center": {
       "additionalItems": false,
       "description": "Default center [longitude, latitude]",
       "items": [
        {
         "type": "number"
        },
        {
         "type": "number"
        }
       ],
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      "created": {
       "description": "ISO 8601 timestamp of creation",
       "type": "string"
      },
      "draft": {
       "description": "Whether style is a draft",
       "type": "boolean"
      },
      "id": {
       "description": "Unique style ID",
       "type": "string"
      },
      "layers": {
       "description": "Style layers",
       "items": {},
       "type": "array"
      },
      "modified": {
       "description": "ISO 8601 timestamp of last modification",
       "type": "string"
      },
      "name": {
       "description": "Style name",
       "type": "string"
      },
      "owner": {
       "description": "Username of the style owner",
       "type": "string"
      },
      "pitch": {
       "description": "Default pitch in degrees",
       "type": "number"
      },
      "protected": {
       "description": "Whether style is protected",
       "type": "boolean"
      },
      "sources": {
       "additionalProperties": {},
       "description": "Style data sources",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "version": {
       "const": 8,
       "description": "Style specification version",
       "type": "number"
      },
      "visibility": {
       "description": "Style visibility setting",
       "enum": [
        "public",
        "private"
       ],
       "type": "string"
      },
      "zoom": {
       "description": "Default zoom level",
       "type": "number"
      }
     },
     "required": [
      "id",
      "name",
      "owner",
      "created",
      "modified",
      "visibility"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "styles"
  ],
  "type": "object"
 },
 "title": "List Mapbox Styles Tool"
}
