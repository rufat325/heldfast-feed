{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Global Traffic Manager policy with load balancing, monitor, and resource groups",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "geoMapId": {
    "description": "Geo/CIDR Map ID (required when lbType is GEO or CIDR)",
    "type": "number"
   },
   "lbType": {
    "description": "Load balancing type",
    "enum": [
     "ROUND_ROBIN",
     "WEIGHTED_RR",
     "FAILOVER",
     "GEO",
     "CIDR"
    ],
    "type": "string"
   },
   "monitor": {
    "additionalProperties": false,
    "description": "Health check monitor configuration",
    "properties": {
     "hostHeader": {
      "description": "Host header (HTTP/HTTPS only)",
      "type": "string"
     },
     "path": {
      "description": "Health check path (HTTP/HTTPS only)",
      "type": "string"
     },
     "period": {
      "description": "Check period in seconds (default: 30)",
      "type": "number"
     },
     "port": {
      "description": "Health check port",
      "type": "number"
     },
     "protocol": {
      "description": "Health check protocol",
      "enum": [
       "HTTP",
       "HTTPS",
       "TCP"
      ],
      "type": "string"
     },
     "thresholdFail": {
      "description": "Failure threshold (default: 1)",
      "type": "number"
     },
     "thresholdNormal": {
      "description": "Normal threshold (default: 1)",
      "type": "number"
     }
    },
    "required": [
     "protocol",
     "port"
    ],
    "type": "object"
   },
   "name": {
    "description": "Policy name",
    "type": "string"
   },
   "resourceGroups": {
    "description": "Resource groups with active/standby resources",
    "items": {
     "additionalProperties": false,
     "properties": {
      "active": {
       "description": "Active resources",
       "items": {
        "additionalProperties": false,
        "properties": {
         "content": {
          "description": "Resource address (IP or domain)",
          "type": "string"
         },
         "healthCheckRegionId": {
          "description": "Health check region ID",
          "type": "number"
         },
         "type": {
          "description": "Resource type (PUBLIC_IP or CNAME)",
          "type": "string"
         }
        },
        "required": [
         "content",
         "healthCheckRegionId",
         "type"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "geoMapDetailId": {
       "description": "Geo map detail ID (GEO/CIDR only)",
       "type": [
        "number",
        "null"
       ]
      },
      "sid": {
       "description": "Resource group ID (null for new)",
       "type": [
        "number",
        "null"
       ]
      },
      "standby": {
       "description": "Standby resources",
       "items": {
        "additionalProperties": false,
        "properties": {
         "content": {
          "description": "Resource address",
          "type": "string"
         },
         "healthCheckRegionId": {
          "description": "Health check region ID",
          "type": "number"
         },
         "type": {
          "description": "Resource type (PUBLIC_IP or CNAME)",
          "type": "string"
         }
        },
        "required": [
         "content",
         "healthCheckRegionId",
         "type"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "weighted": {
       "description": "Weight (WEIGHTED_RR only)",
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "active"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "lbType"
  ],
  "type": "object"
 },
 "name": "ncloud_gtm_create_policy"
}
