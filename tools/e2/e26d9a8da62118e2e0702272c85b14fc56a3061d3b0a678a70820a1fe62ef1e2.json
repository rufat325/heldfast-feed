{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Attach fulfillment evidence to an acceptance criterion in a Spool (the agreement object). Use after work is delivered and before verification; this persists evidence but does not decide whether it passes or what was earned. Works in the no-key sandbox.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "claim_class": {
    "enum": [
     "actor_identity",
     "artifact_state",
     "machine_fact"
    ],
    "type": "string"
   },
   "condition_id": {
    "format": "starts_with",
    "pattern": "^cond_.*",
    "type": "string"
   },
   "id": {
    "format": "starts_with",
    "pattern": "^spl_.*",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "default": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "on_behalf_of": {
    "format": "starts_with",
    "pattern": "^pty_.*",
    "type": "string"
   },
   "provenance": {
    "enum": [
     "api_response",
     "uploaded_json",
     "url_fetch",
     "external_tool_result"
    ],
    "type": "string"
   },
   "source": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "enum": [
     "photo",
     "text",
     "file",
     "url",
     "dataset",
     "confirmation"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "condition_id",
   "type",
   "source"
  ],
  "type": "object"
 },
 "name": "submit_evidence",
 "title": "Evidence submission"
}
