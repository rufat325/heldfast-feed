{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Trace a deterministic bounded caller or callee path from one exact procedure address, optionally stopping at a goal. Returns visited nodes, direct-call edges, one shortest traversal path, failures, frontier, consumed limits, an Evidence ID, and explicit residual unknowns without claiming unresolved indirect calls are absent.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
   {
    "direction": "forward",
    "goal": "0x1100",
    "max_depth": 5,
    "max_nodes": 100,
    "max_operations": 100,
    "start": "0x1000"
   }
  ],
  "properties": {
   "direction": {
    "default": "forward",
    "description": "Direction in which to traverse or compare relationships.",
    "enum": [
     "forward",
     "backward"
    ],
    "type": "string"
   },
   "goal": {
    "description": "An optional provider-normalized destination address",
    "type": "string"
   },
   "max_depth": {
    "default": 5,
    "description": "Maximum permitted depth for this operation.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "max_nodes": {
    "default": 100,
    "description": "Maximum permitted nodes for this operation.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "max_operations": {
    "default": 100,
    "description": "Maximum permitted operations for this operation.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "start": {
    "description": "A provider-normalized procedure address",
    "type": "string"
   },
   "unknown_registry_approved": {
    "const": true,
    "description": "Explicit approval to record bounded residuals durably",
    "type": "boolean"
   }
  },
  "required": [
   "start"
  ],
  "type": "object"
 },
