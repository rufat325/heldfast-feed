{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "campaign.read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search mnemons"
 },
 "description": "Full-text search across mnemon titles, tags, and body content (case-insensitive substring). Prefer this over list_mnemons when looking for entries by what they contain \u2014 e.g. \"what do we know about the Red Oracle?\". Each hit reports which fields matched (title/tags/content) and up to 3 body snippets; a snippet's blockId is the same block id get_mnemon returns, so you can target the matched block directly in update_mnemons_content. Only content visible to the current user is searched. Returns at most `limit` hits (default 20, max 50) plus `hasMore`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaignId": {
    "description": "ID of the campaign.",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Maximum results (default 20).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Text to find (case-insensitive substring) in mnemon titles, tags, and body content.",
    "minLength": 2,
    "type": "string"
   },
   "type": {
    "description": "Mnemon type filter (NPC, Location, Quest, \u2026).",
    "type": "string"
   }
  },
  "required": [
   "campaignId",
   "query"
  ],
  "type": "object"
 },
 "name": "search_mnemons",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "idMap": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "entryId": {
       "type": "string"
      },
      "matchedIn": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "snippets": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "blockId": {
          "type": "string"
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "text"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "entryId",
      "title",
      "type",
      "matchedIn",
      "snippets"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "idMap",
   "hasMore"
  ],
  "type": "object"
 },
 "title": "Search mnemons"
}
