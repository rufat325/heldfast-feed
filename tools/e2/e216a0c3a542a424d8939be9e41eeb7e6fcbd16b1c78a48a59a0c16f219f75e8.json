{"annotations":{"destructiveHint":false,"openWorldHint":false},"description":"Run many steps in one call and get one compact result: [{touch:{name:\"HIT\"}}, {expect:[{text:\"You win\"}]}, {advance:30}, ...]. Every touch/key/text waits until the program consumed it and the screen settled; a step fails if the program ignored the input (unless lenient). Stops at the first failure (stopOnFail:false to continue), returns only the failing steps with reasons and nearest matches, saves evidence files, and ends with a compact delta of the screens (ui:\"none\"|\"delta\"|\"full\"). One call replaces dozens of act/ui round trips.","inputSchema":{"properties":{"evidence":{"default":true,"type":"boolean"},"id":{"description":"Id returned by craftos_session_create.","type":"string"},"quietMs":{"default":250,"minimum":0,"type":"integer"},"steps":{"items":{"description":"One step: exactly one of touch, key, text, expect, advance, sim, seed or settle.","properties":{"advance":{"description":"Jump the virtual clock forward (seconds).","exclusiveMinimum":0,"type":"number"},"ctrl":{"type":"boolean"},"enter":{"description":"With text: press Enter after.","type":"boolean"},"expect":{"items":{"description":"One check; give exactly one of rect, text, waiting, sim or changed.","properties":{"changed":{"description":"Whether any screen differs from the last view.","type":"boolean"},"rect":{"description":"Elements on screen (default: at least one).","properties":{"absent":{"type":"boolean"},"color":{"description":"Hex colour, e.g. #f15c5c.","type":"string"},"max":{"minimum":0,"type":"integer"},"min":{"minimum":0,"type":"integer"},"name":{"description":"A label from craftos_labels.","type":"string"},"peripheral":{"type":"string"}},"type":"object"},"sim":{"properties":{"contains":{},"equals":{},"exists":{"type":"boolean"},"gte":{"type":"number"},"lte":{"type":"number"},"path":{"description":"Dotted path into the sim state, e.g. \"inventories.chest_0\".","type":"string"}},"required":["path"],"type":"object"},"text":{"description":"Text on text-mode screens.","properties":{"absent":{"type":"boolean"},"contains":{"type":"string"},"peripheral":{"type":"string"},"regex":{"type":"string"}},"type":"object"},"waiting":{"description":"What the program is blocked on.","properties":{"blocked":{"type":"boolean"},"filter":{"type":"string"}},"type":"object"}},"type":"object"},"type":"array"},"hold":{"description":"With key: hold it this many ms. ctrl+t held 1000 ms or more terminates.","maximum":10000,"minimum":1,"type":"integer"},"key":{"type":"string"},"lenient":{"description":"Do not fail when the program ignored the input.","type":"boolean"},"note":{"type":"string"},"seed":{"type":"integer"},"settle":{"type":"boolean"},"shift":{"type":"boolean"},"sim":{"additionalProperties":{},"properties":{"cmd":{"enum":["interact","approve","revoke","setBalance","setVaultLevel","setEquipment","setOnOtherServer","setGearPower","setTemper","setReputation","setGreedTier","setSkills","setStats","internalError","setEconomyDelay","addPlayer","join","leave","setPlayerPos","setComputerPos","setHost","setEconomy","chat","playerClick","setItem","setEnergy","setFluid","setEnergyTransferRate","setRedstoneInput","completeCraft","setNetworkConnected","setEnvironment","addEntity","qioSetPowered","qioSetDrive","qioSetSecurity","qioSetUpgrades","qioInsert","qioExtract","qeInsert","qeExtract","qeSetLoaded","seed","advance","unload","load","attachPeripheral","detachPeripheral","resizeMonitor","insertDisk","ejectDisk"],"type":"string"}},"required":["cmd"],"type":"object"},"text":{"type":"string"},"touch":{"description":"Touch a named element, or monitor + x,y.","properties":{"index":{"minimum":0,"type":"integer"},"monitor":{"type":"string"},"name":{"description":"A label from craftos_labels.","type":"string"},"player":{"description":"Who touches (default: the interacting player).","type":"string"},"x":{"minimum":1,"type":"integer"},"y":{"minimum":1,"type":"integer"}},"type":"object"},"waitMs":{"description":"With expect: re-check for this long (default 2000).","minimum":0,"type":"integer"}},"type":"object"},"maxItems":500,"minItems":1,"type":"array"},"stopOnFail":{"default":true,"type":"boolean"},"timeoutMs":{"default":15000,"minimum":100,"type":"integer"},"ui":{"default":"delta","enum":["none","delta","full"],"type":"string"}},"required":["id","steps"],"type":"object"},"name":"craftos_script"}
