{
 "description": "Render a URL or HTML to PDF with Puppeteer's page.pdf() options (format letter by default, scale, margins, header/footer templates, printBackground, pageRanges). Price: $0.005 a call (3 free calls a day without an API key).",
 "inputSchema": {
  "properties": {
   "addScriptTag": {
    "description": "[{content|url}]",
    "type": "array"
   },
   "addStyleTag": {
    "description": "[{content|url}]",
    "type": "array"
   },
   "allowRequestPattern": {
    "type": "array"
   },
   "allowResourceTypes": {
    "type": "array"
   },
   "authenticate": {
    "description": "{username,password}",
    "type": "object"
   },
   "bestAttempt": {
    "description": "Proceed when awaited events fail or time out",
    "type": "boolean"
   },
   "cookies": {
    "description": "Cookies to set before loading",
    "type": "array"
   },
   "deliver": {
    "description": "{store: \"1d\"|\"7d\"|\"30d\"|\"365d\", name?}: keep the PDF in file storage and answer with metadata instead of bytes",
    "type": "object"
   },
   "emulateMediaType": {
    "description": "screen|print",
    "type": "string"
   },
   "gotoOptions": {
    "description": "{waitUntil: load|domcontentloaded|networkidle0|networkidle2, timeout}",
    "type": "object"
   },
   "html": {
    "description": "HTML to render instead of a URL.",
    "type": "string"
   },
   "pdfOptions": {
    "description": "Puppeteer page.pdf() options as documented at pptr.dev/api/puppeteer.pdfoptions.",
    "properties": {
     "displayHeaderFooter": {
      "type": "boolean"
     },
     "footerTemplate": {
      "type": "string"
     },
     "format": {
      "description": "letter|legal|tabloid|ledger|a0|a1|a2|a3|a4|a5|a6 (default letter)",
      "type": "string"
     },
     "headerTemplate": {
      "description": "HTML with date/title/url/pageNumber/totalPages classes",
      "type": "string"
     },
     "height": {
      "description": "Paper height, e.g. \"11in\"",
      "type": "string"
     },
     "landscape": {
      "type": "boolean"
     },
     "margin": {
      "description": "{top,bottom,left,right}",
      "type": "object"
     },
     "omitBackground": {
      "type": "boolean"
     },
     "outline": {
      "type": "boolean"
     },
     "pageRanges": {
      "description": "e.g. \"1-5, 8, 11-13\"",
      "type": "string"
     },
     "preferCSSPageSize": {
      "type": "boolean"
     },
     "printBackground": {
      "type": "boolean"
     },
     "scale": {
      "description": "0.1-2, default 1",
      "type": "number"
     },
     "tagged": {
      "type": "boolean"
     },
     "timeout": {
      "description": "0-60000 ms, default 30000",
      "type": "number"
     },
     "width": {
      "description": "Paper width, e.g. \"8.5in\"",
      "type": "string"
     }
    },
    "type": "object"
   },
   "rejectRequestPattern": {
    "type": "array"
   },
   "rejectResourceTypes": {
    "description": "e.g. [\"image\"]",
    "type": "array"
   },
   "setExtraHTTPHeaders": {
    "description": "Extra HTTP headers",
    "type": "object"
   },
   "setJavaScriptEnabled": {
    "type": "boolean"
   },
   "url": {
    "description": "The page to render (https). Set url or html, not both.",
    "type": "string"
   },
   "userAgent": {
    "type": "string"
   },
   "viewport": {
    "description": "{width,height,deviceScaleFactor,isMobile,hasTouch,isLandscape}; default 1920x1080",
    "type": "object"
   },
   "waitForSelector": {
    "description": "{selector, visible?, hidden?, timeout}",
    "type": "object"
   },
   "waitForTimeout": {
    "description": "Extra wait in ms (0-120000)",
    "type": "number"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "pdf",
 "title": "Render a URL or HTML to PDF with Puppeteer's page"
}
