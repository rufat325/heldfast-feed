{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Log a recommended dialing change to allow contradiction/oscillation checking (G2).",
 "inputSchema": {
  "properties": {
   "based_on_shot": {
    "type": "integer"
   },
   "cited_rules": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "confidence": {
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "direction": {
    "enum": [
     "finer",
     "coarser",
     "more",
     "less",
     "same"
    ],
    "type": "string"
   },
   "lever": {
    "enum": [
     "grind",
     "yield",
     "temp",
     "program",
     "prep",
     "none"
    ],
    "type": "string"
   },
   "rationale": {
    "type": "string"
   }
  },
  "required": [
   "lever",
   "direction",
   "rationale",
   "confidence"
  ],
  "type": "object"
 },
 "name": "log_recommendation",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "message": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "message"
  ],
  "type": "object"
 },
 "title": "Log a recommendation"
}
