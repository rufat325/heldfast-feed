{
 "description": "Retrieve complete product detail by identifier. Returns a singular product\nwith a relevant set of variants, exact pricing, and real-time availability.\nSupports interactive option selection via selected and preferences parameters\nfor variant narrowing and availability signals. Use for product detail page\nrendering and purchase decisions.\n\nPrices in the response are integers in the currency's ISO 4217 minor units, paired with\na currency code: {\"amount\": 600, \"currency\": \"USD\"} is $6.00 and {\"amount\": 2500,\n\"currency\": \"USD\"} is $25.00. Convert to major units before quoting a price to a buyer\n(divide by 100 for two-decimal currencies such as USD and EUR; zero-decimal currencies\nsuch as JPY are already whole units).\n\n",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "catalog": {
    "description": "Product detail parameters.",
    "properties": {
     "context": {
      "additionalProperties": true,
      "description": "Buyer signals for localization and personalization.",
      "properties": {
       "address_country": {
        "description": "Country code in ISO 3166-1 alpha-2 format.",
        "type": "string"
       },
       "address_region": {
        "description": "Region or state.",
        "type": "string"
       },
       "currency": {
        "description": "Currency code in ISO 4217 format.",
        "type": "string"
       },
       "intent": {
        "description": "Buyer intent.",
        "type": "string"
       },
       "language": {
        "description": "Language tag in IETF BCP 47 format.",
        "type": "string"
       },
       "postal_code": {
        "description": "Postal code.",
        "type": "string"
       }
      },
      "type": "object"
     },
     "filters": {
      "additionalProperties": true,
      "description": "Narrowing criteria for catalog results.",
      "properties": {
       "available": {
        "default": true,
        "description": "Filter by availability. Default true (only sale-ready items).",
        "type": "boolean"
       },
       "categories": {
        "description": "Category filters combined with OR logic.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "price": {
        "description": "Price range filter.",
        "properties": {
         "max": {
          "description": "Maximum price in minor currency units.",
          "type": "integer"
         },
         "min": {
          "description": "Minimum price in minor currency units.",
          "type": "integer"
         }
        },
        "type": "object"
       }
      },
      "type": "object"
     },
     "id": {
      "description": "Product ID.",
      "type": "string"
     },
     "preferences": {
      "description": "Buyer preferences.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "selected": {
      "description": "Selected variant options.",
      "items": {
       "properties": {
        "label": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "signals": {
      "additionalProperties": true,
      "description": "Platform environment data.",
      "properties": {
       "dev.ucp.buyer_ip": {
        "description": "Buyer IP address.",
        "type": "string"
       },
       "dev.ucp.user_agent": {
        "description": "Buyer user agent.",
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   },
   "meta": {
    "description": "Metadata for UCP agent profile discovery.",
    "properties": {
     "ucp-agent": {
      "properties": {
       "profile": {
        "description": "Agent profile URI for UCP discovery.",
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "profile"
      ],
      "type": "object"
     }
    },
    "required": [
     "ucp-agent"
    ],
    "type": "object"
   }
  },
  "required": [
   "meta",
   "catalog"
  ],
  "type": "object"
 },
