{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "appskyline:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Track a new keyword"
 },
 "description": "Use this when someone asks to start tracking a keyword for their app in a given language and country. Returns the new keyword; adding the same term twice creates two rows. Keywords without a country are skipped by the weekly rank check. Not for a one-off rank lookup.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "AppSkyline app id (uuid)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "country": {
    "description": "Two-letter store country code such as US; without one the weekly rank check skips this keyword",
    "maxLength": 10,
    "type": "string"
   },
   "language": {
    "description": "Two-letter language code such as en",
    "maxLength": 32,
    "type": "string"
   },
   "searchTerms": {
    "description": "Keyword phrase to track, as users type it in the store, 1 to 200 characters",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "appId",
   "searchTerms"
  ],
  "type": "object"
 },
 "name": "add_keyword",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "keyword": {
    "additionalProperties": false,
    "properties": {
     "appId": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "country": {
      "anyOf": [
       {
        "maxLength": 10,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "language": {
      "anyOf": [
       {
        "maxLength": 32,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "term": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "id",
     "appId",
     "term",
     "language",
     "country"
    ],
    "type": "object"
   },
   "status": {
    "const": "added",
    "type": "string"
   }
  },
  "required": [
   "status",
   "keyword"
  ],
  "type": "object"
 },
 "title": "Track a new keyword"
}
