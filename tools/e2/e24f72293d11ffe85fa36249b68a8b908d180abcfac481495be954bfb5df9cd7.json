{
 "description": "Start a load test against a target. Max 100 concurrent connections, max 5 min duration, 1 test at a time per target, 60s cooldown between tests. Modes: HTTP_FLOOD (autocannon), BROWSER_USERS (Playwright), COMBINED (both). OWNER/ADMIN only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "acknowledgeSharedOrigin": {
    "description": "Acknowledge blast radius if target shares a server with other monitored sites",
    "type": "boolean"
   },
   "concurrency": {
    "default": 10,
    "description": "Number of concurrent connections",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "duration": {
    "default": 30,
    "description": "Test duration in seconds",
    "maximum": 300,
    "minimum": 10,
    "type": "number"
   },
   "httpMethod": {
    "description": "HTTP method",
    "enum": [
     "GET",
     "POST",
     "PUT",
     "DELETE",
     "PATCH"
    ],
    "type": "string"
   },
   "mode": {
    "default": "HTTP_FLOOD",
    "description": "Load test mode",
    "enum": [
     "HTTP_FLOOD",
     "BROWSER_USERS",
     "COMBINED"
    ],
    "type": "string"
   },
   "rampUp": {
    "description": "Ramp-up time in seconds",
    "maximum": 60,
    "minimum": 0,
    "type": "number"
   },
   "targetId": {
    "description": "The target ID to load test",
    "type": "string"
   },
   "targetUrl": {
    "description": "Override URL (defaults to target URL)",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "targetId"
  ],
  "type": "object"
 },
 "name": "start_load_test",
 "title": "Start Load Test"
}
