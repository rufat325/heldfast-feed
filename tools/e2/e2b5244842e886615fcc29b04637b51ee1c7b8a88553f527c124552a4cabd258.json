{
 "description": "Publish a markdown document to the authenticated RenderMark account and get a shareable link.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "markdown": {
    "description": "The markdown content to publish",
    "type": "string"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "showByLine": {
      "type": "boolean"
     },
     "showToc": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "title": {
    "description": "Document title",
    "type": "string"
   }
  },
  "required": [
   "markdown",
   "title"
  ],
  "type": "object"
 },
 "name": "publish_to_rendermark"
}
