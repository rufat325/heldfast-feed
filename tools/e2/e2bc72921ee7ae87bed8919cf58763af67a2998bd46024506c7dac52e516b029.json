{
 "description": "Find JOURNEY and, by default, COMPOSITE performance tests related to scenario titles and/or TestChimp ids.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "includeComposites": {
    "default": true,
    "type": "boolean"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "scenarioTitles": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "testchimpIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "list-related-perf-tests"
}
