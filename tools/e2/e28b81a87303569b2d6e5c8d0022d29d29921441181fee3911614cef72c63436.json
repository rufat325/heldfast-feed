{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Activate or deactivate a workflow"
 },
 "description": "Activate or deactivate a workflow on a live n8n instance (requires N8N_API_URL + N8N_API_KEY). Pass `active: false` to deactivate. Idempotent \u2014 re-activating an already-active workflow is a no-op on n8n's side.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "active": {
    "description": "Defaults to true (activate). Set false to deactivate.",
    "type": "boolean"
   },
   "id": {
    "description": "Workflow ID.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "workflow_activate",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Which action was performed.",
    "enum": [
     "activate",
     "deactivate"
    ],
    "type": "string"
   },
   "id": {
    "description": "The workflow ID that was (de)activated.",
    "type": "string"
   },
   "ok": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "ok",
   "id",
   "action"
  ],
  "type": "object"
 },
 "title": "Activate or deactivate a workflow"
}
