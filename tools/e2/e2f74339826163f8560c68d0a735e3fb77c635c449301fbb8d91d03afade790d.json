{
 "description": "Create a new calendar in the CRM.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "alertEmail": {
    "description": "Email address for calendar alerts",
    "type": "string"
   },
   "allowCancellation": {
    "description": "Allow contacts to cancel appointments",
    "type": "boolean"
   },
   "allowReschedule": {
    "description": "Allow contacts to reschedule appointments",
    "type": "boolean"
   },
   "appointmentPerDay": {
    "description": "Max appointments per day",
    "type": "number"
   },
   "appointmentPerSlot": {
    "description": "Max appointments per slot",
    "type": "number"
   },
   "autoConfirm": {
    "description": "Auto-confirm new appointments",
    "type": "boolean"
   },
   "availabilityType": {
    "description": "Availability type identifier",
    "type": "number"
   },
   "calendarCoverImage": {
    "description": "URL of the calendar cover image",
    "type": "string"
   },
   "calendarType": {
    "description": "Calendar type (e.g. round_robin, event, class_booking, collective, service_booking)",
    "type": "string"
   },
   "consentLabel": {
    "description": "Consent checkbox label text",
    "type": "string"
   },
   "description": {
    "description": "Calendar description",
    "type": "string"
   },
   "enableRecurring": {
    "description": "Enable recurring appointments",
    "type": "boolean"
   },
   "eventColor": {
    "description": "Event color hex code",
    "type": "string"
   },
   "eventTitle": {
    "description": "Default event title",
    "type": "string"
   },
   "formId": {
    "description": "Form ID to associate with the calendar",
    "type": "string"
   },
   "formSubmitRedirectURL": {
    "description": "URL to redirect after form submission",
    "type": "string"
   },
   "formSubmitThanksMessage": {
    "description": "Thank-you message shown after form submission",
    "type": "string"
   },
   "formSubmitType": {
    "description": "Form submit action type (e.g. message, redirect)",
    "type": "string"
   },
   "googleInvitationEmails": {
    "description": "Send Google Calendar invitation emails",
    "type": "boolean"
   },
   "guestType": {
    "description": "Guest type setting",
    "type": "string"
   },
   "id": {
    "description": "Custom calendar ID (optional, auto-generated if omitted)",
    "type": "string"
   },
   "isLivePaymentMode": {
    "description": "Enable live payment mode",
    "type": "boolean"
   },
   "locationId": {
    "description": "CRM location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "meetingLocation": {
    "description": "Default meeting location",
    "type": "string"
   },
   "name": {
    "description": "Calendar name",
    "type": "string"
   },
   "notes": {
    "description": "Internal notes for the calendar",
    "type": "string"
   },
   "openHours": {
    "description": "Array of open-hours objects defining availability windows",
    "items": {},
    "type": "array"
   },
   "pixelId": {
    "description": "Tracking pixel ID",
    "type": "string"
   },
   "postBuffer": {
    "description": "Post-event buffer time",
    "type": "number"
   },
   "postBufferUnit": {
    "description": "Unit for post-event buffer (e.g. mins, hours)",
    "type": "string"
   },
   "preBuffer": {
    "description": "Pre-event buffer time",
    "type": "number"
   },
   "preBufferUnit": {
    "description": "Unit for pre-event buffer (e.g. mins, hours)",
    "type": "string"
   },
   "shouldAssignContactToTeamMember": {
    "description": "Assign contact to the team member upon booking",
    "type": "boolean"
   },
   "shouldSendAlertEmailsToAssignedMember": {
    "description": "Send alert emails to assigned team member",
    "type": "boolean"
   },
   "shouldSkipAssigningContactForExisting": {
    "description": "Skip reassigning existing contacts to team members",
    "type": "boolean"
   },
   "slotBuffer": {
    "description": "Buffer time between slots in minutes",
    "type": "number"
   },
   "slotDuration": {
    "description": "Duration of each slot in minutes",
    "type": "number"
   },
   "slotInterval": {
    "description": "Interval between slots in minutes",
    "type": "number"
   },
   "slug": {
    "description": "URL-friendly slug",
    "type": "string"
   },
   "stickyContact": {
    "description": "Stick returning contacts to the same team member",
    "type": "boolean"
   },
   "teamMembers": {
    "description": "Array of team member objects assigned to this calendar",
    "items": {},
    "type": "array"
   },
   "widgetSlug": {
    "description": "Widget slug identifier",
    "type": "string"
   },
   "widgetType": {
    "description": "Widget display type",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId",
   "name"
  ],
  "type": "object"
 },
 "name": "crm_create_calendar"
}
