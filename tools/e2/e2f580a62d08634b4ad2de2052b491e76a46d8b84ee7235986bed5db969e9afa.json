  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Fetch a document"
 },
 "description": "Use this to read the full document for an id returned by search: a statute section\u2019s official text, or a court decision\u2019s DavisStirling summary followed by the start of the opinion, with source and currency information. Do not use it to search; use search first to get an id.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "An id from search, e.g. \"cal.civ.4920\" or \"cal.case.nahrstedt-v-lakeside-village-1994\".",
    "maxLength": 200,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "fetch",
