{
 "description": "Track token usage and cost for an LLM call. Auto-calculates cost from built-in pricing table if per-token costs are not provided.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cost_per_input_token": {
    "description": "Cost per input token (overrides built-in pricing)",
    "minimum": 0,
    "type": "number"
   },
   "cost_per_output_token": {
    "description": "Cost per output token (overrides built-in pricing)",
    "minimum": 0,
    "type": "number"
   },
   "input_tokens": {
    "description": "Number of input/prompt tokens",
    "minimum": 0,
    "type": "integer"
   },
   "model": {
    "description": "Model name (e.g., claude-sonnet-4, gpt-4o)",
    "type": "string"
   },
   "output_tokens": {
    "description": "Number of output/completion tokens",
    "minimum": 0,
    "type": "integer"
   },
   "provider": {
    "description": "LLM provider",
    "enum": [
     "anthropic",
     "openai",
     "google",
     "mistral",
     "local"
    ],
    "type": "string"
   },
   "session_id": {
    "description": "Unique session identifier",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "model",
   "provider",
   "input_tokens",
   "output_tokens"
  ],
  "type": "object"
 },
 "name": "track_token_usage"
}
