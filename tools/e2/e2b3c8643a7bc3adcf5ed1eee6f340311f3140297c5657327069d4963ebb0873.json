{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"List the modding skills installed in the mod, or load one by name, at the kit version HOI4 Mod Setup pinned, with its hash. A file edited since Setup installed it is refused unless acceptLocalEdits. Example: {\"name\":\"hoi4-events\"}. Returns up to 20,000 bytes of text; continue from nextOffset.","inputSchema":{"additionalProperties":false,"properties":{"acceptLocalEdits":{"default":false,"type":"boolean"},"file":{"default":"SKILL.md","pattern":"^(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[A-Za-z0-9._/-]{1,200}$","type":"string"},"name":{"pattern":"^[a-z0-9][a-z0-9._-]{0,63}$","type":"string"},"offset":{"default":0,"maximum":16000000,"minimum":0,"type":"integer"},"workspaceId":{"default":"current","pattern":"^[a-z][a-z0-9_-]{0,63}$","type":"string"}},"type":"object"},"name":"hoi4.skill","outputSchema":{"additionalProperties":false,"properties":{"artifacts":{"items":{},"maxItems":32,"type":"array"},"blockers":{"items":{},"type":"array"},"changedFiles":{"items":{},"type":"array"},"code":{"type":"string"},"data":{"additionalProperties":{},"properties":{},"type":"object"},"diagnostics":{"items":{},"maxItems":20,"type":"array"},"filesScanned":{"items":{},"type":"array"},"proposedFiles":{"items":{},"type":"array"},"status":{"enum":["ok","blocked","error"],"type":"string"},"validation":{},"workspaceId":{"type":"string"}},"required":["status","code","workspaceId","validation","data"],"type":"object"},"title":"Read the mod's modding skills"}
