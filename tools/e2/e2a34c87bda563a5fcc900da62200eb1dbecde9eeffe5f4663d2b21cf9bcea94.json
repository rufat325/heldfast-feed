{
 "annotations": {
  "readOnlyHint": true,
  "title": "List documents"
 },
 "description": "List documents, optionally filtered by status, folder, source template or a text query. Documenso v2: GET /document.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "folderId": {
    "description": "Only documents in this folder.",
    "type": "string"
   },
   "orderByDirection": {
    "description": "Sort by creation time. Defaults to desc.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "page": {
    "description": "1-based page number.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "perPage": {
    "description": "Results per page, 1-100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free-text search over document titles.",
    "type": "string"
   },
   "source": {
    "description": "How the document was created.",
    "enum": [
     "DOCUMENT",
     "TEMPLATE",
     "TEMPLATE_DIRECT_LINK"
    ],
    "type": "string"
   },
   "status": {
    "description": "Only documents in this state.",
    "enum": [
     "DRAFT",
     "PENDING",
     "COMPLETED",
     "REJECTED",
     "CANCELLED"
    ],
    "type": "string"
   },
   "templateId": {
    "description": "Only documents created from this template.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "documenso_list_documents",
 "title": "List documents"
}
