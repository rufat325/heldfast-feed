{
 "description": "Search the Sparkbites curated directory of design-forward websites. Filter by text query, tags, tech stacks, color families, and fonts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "colors": {
    "description": "Filter by color family (Red, Blue, Purple, etc)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "fonts": {
    "description": "Filter by font family names",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Text to search in name and description",
    "type": "string"
   },
   "stacks": {
    "description": "Filter by tech stack names",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tags": {
    "description": "Filter by tag names",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "search_bookmarks",
 "title": "Search Sparkbites directory"
}
