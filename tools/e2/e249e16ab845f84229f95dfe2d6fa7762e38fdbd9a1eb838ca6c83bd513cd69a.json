{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update an existing Geo or CIDR map",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "detailedMapList": {
    "description": "Detailed map entries",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "description": "CIDR subnet",
       "type": "string"
      },
      "geoIdMappings": {
       "description": "Geolocation mappings",
       "items": {
        "additionalProperties": false,
        "properties": {
         "geoName": {
          "description": "Geolocation name",
          "type": "string"
         },
         "geoType": {
          "description": "Geolocation type",
          "type": "string"
         }
        },
        "required": [
         "geoName",
         "geoType"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "description": "Zone/detail name",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "mapId": {
    "description": "Map ID to update",
    "type": "number"
   },
   "mapType": {
    "description": "Map type",
    "enum": [
     "GEO",
     "CIDR"
    ],
    "type": "string"
   },
   "name": {
    "description": "Map name",
    "type": "string"
   }
  },
  "required": [
   "mapId"
  ],
  "type": "object"
 },
 "name": "ncloud_gtm_update_geo_cidr_map"
}
