{
 "description": "Index or reindex the Obsidian vault into the external semantic index. Does not modify the vault.",
 "inputSchema": {
  "properties": {
   "dry_run": {
    "default": false,
    "type": "boolean"
   },
   "include_sensitive": {
    "default": false,
    "description": "Requires OBSIDIAN_SEMANTIC_ALLOW_SENSITIVE=true on the server.",
    "type": "boolean"
   },
   "mode": {
    "default": "incremental",
    "enum": [
     "incremental",
     "full"
    ],
    "type": "string"
   },
   "paths": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "index_vault"
}
