{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The signed-in student's courses on ELMS (Canvas) with term, instructors and current grade standing. Course ids are what the other ELMS tools take. Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "state": {
    "default": "active",
    "description": "\"active\" for current courses, \"completed\" for past terms, \"all\" for both",
    "enum": [
     "active",
     "completed",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "elms_list_courses",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "courses": {
    "description": "Courses as Canvas orders them",
    "items": {
     "additionalProperties": false,
     "properties": {
      "course_code": {
       "description": "e.g. \"CMSC131-0101-Fall 2026\"",
       "type": [
        "string",
        "null"
       ]
      },
      "end_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      },
      "enrollment_type": {
       "anyOf": [
        {
         "enum": [
          "student",
          "teacher",
          "ta",
          "observer",
          "designer"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "The user's role in the course"
      },
      "grades": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "current_grade": {
           "description": "Letter grade for current_score, if the course has a grading scheme",
           "type": [
            "string",
            "null"
           ]
          },
          "current_score": {
           "description": "Percentage score on graded work so far",
           "type": [
            "number",
            "null"
           ]
          },
          "final_grade": {
           "type": [
            "string",
            "null"
           ]
          },
          "final_score": {
           "description": "Percentage score counting ungraded work as zero",
           "type": [
            "number",
            "null"
           ]
          }
         },
         "required": [
          "current_score",
          "current_grade",
          "final_score",
          "final_grade"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "Current standing; null when the course hides grades"
      },
      "hide_final_grades": {
       "type": "boolean"
      },
      "id": {
       "description": "Canvas course id, used by the other ELMS tools",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "start_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      },
      "state": {
       "description": "Publication state",
       "enum": [
        "available",
        "unpublished",
        "completed",
        "deleted"
       ],
       "type": "string"
      },
      "teachers": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         "name": {
          "type": "string"
         },
         "pronouns": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "id",
         "name",
         "pronouns"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "term": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "end_at": {
           "description": "ISO 8601 timestamp (UTC); null when unset",
           "type": [
            "string",
            "null"
           ]
          },
          "id": {
           "exclusiveMinimum": 0,
           "maximum": 9007199254740991,
           "type": "integer"
          },
          "name": {
           "description": "e.g. \"Fall 2026\"",
           "type": "string"
          },
          "start_at": {
           "description": "ISO 8601 timestamp (UTC); null when unset",
           "type": [
            "string",
            "null"
           ]
          }
         },
         "required": [
          "id",
          "name",
          "start_at",
          "end_at"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "description": "Course home page",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "course_code",
      "state",
      "term",
      "start_at",
      "end_at",
      "teachers",
      "enrollment_type",
      "grades",
      "hide_final_grades",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "courses"
  ],
  "type": "object"
 },
 "title": "List ELMS courses"
}
