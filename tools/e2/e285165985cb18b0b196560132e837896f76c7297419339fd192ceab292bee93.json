    "type": "string"
   },
   "customerName": {
    "description": "Customer name.",
    "minLength": 1,
    "type": "string"
   },
   "email": {
    "description": "Contact email.",
    "type": "string"
   },
   "gstVatNumber": {
    "description": "GST/VAT number.",
    "type": "string"
   },
   "mobileNumber": {
    "description": "Mobile number.",
    "type": "string"
   },
   "paymentTerm": {
    "description": "Payment term name as configured in Unleashed.",
    "type": "string"
   },
   "phoneNumber": {
    "description": "Phone number.",
    "type": "string"
   },
   "taxable": {
    "description": "Whether sales to this customer are taxable.",
    "type": "boolean"
   },
   "website": {
    "description": "Website.",
    "type": "string"
   }
  },
