{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Pay Decision Snapshot"
 },
 "description": "Compare one supplied x402 v2 exact Base USDC payment requirement against declared intent and return deterministic consistency, mismatch, change, fingerprint, and coverage evidence without executing a payment.",
 "inputSchema": {
  "properties": {
   "intent": {
    "properties": {
     "amount_tolerance": {
      "description": "Optional permitted USDC decimal increase.",
      "type": "string"
     },
     "expected_amount": {
      "description": "Optional expected USDC decimal amount, not atomic units.",
      "type": "string"
     },
     "expected_asset": {
      "description": "Optional expected EVM asset address.",
      "type": "string"
     },
     "expected_network": {
      "description": "Optional expected CAIP-2 network.",
      "type": "string"
     },
     "expected_pay_to": {
      "description": "Optional expected EVM payment destination.",
      "type": "string"
     },
     "resource": {
      "description": "Expected exact absolute HTTP(S) resource URL.",
      "format": "uri",
      "type": "string"
     },
     "seller": {
      "description": "Caller-supplied seller label included in the fingerprint; identity is not externally verified.",
      "type": "string"
     },
     "service": {
      "description": "Expected resource.serviceName.",
      "type": "string"
     }
    },
    "required": [
     "seller",
     "service",
     "resource"
    ],
    "title": "Intent",
    "type": "object"
   },
   "payment_required": {
    "description": "Observed x402 v2 PAYMENT-REQUIRED challenge decoded as JSON.",
    "title": "Payment Required",
    "type": "object"
   },
   "previous_snapshot": {
    "default": null,
    "description": "Optional prior snapshot for stateless material-change detection.",
    "title": "Previous Snapshot",
    "type": "object"
   }
  },
  "required": [
   "intent",
   "payment_required"
  ],
  "title": "handlerArguments",
  "type": "object"
 },
 "name": "pay_decision_snapshot",
 "outputSchema": {
  "properties": {
   "assessment": {
    "description": "Consistency decision only; never a safety rating.",
    "enum": [
     "CONSISTENT",
     "INCONSISTENT",
     "REVIEW_REQUIRED"
    ],
    "type": "string"
   },
   "changes": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "checks_performed": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "checks_skipped": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "coverage": {
    "type": "object"
   },
   "evidence": {
    "type": "object"
   },
   "external_calls": {
    "description": "Always empty in this offline MVP.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "matched": {
    "type": "object"
   },
   "mismatched": {
    "type": "object"
   },
   "payment_fingerprint": {
    "description": "SHA-256 of canonical material payment fields.",
    "type": "string"
   },
   "reason_codes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "snapshot": {
    "description": "Reusable stateless comparison state.",
    "type": "object"
   }
  },
  "required": [
   "assessment",
   "reason_codes",
   "matched",
   "mismatched",
   "changes",
   "payment_fingerprint",
   "checks_performed",
   "checks_skipped",
   "evidence",
   "coverage",
   "external_calls",
   "snapshot"
  ],
  "title": "PayDecisionSnapshotOutput",
  "type": "object"
 },
 "title": "Pay Decision Snapshot"
}
