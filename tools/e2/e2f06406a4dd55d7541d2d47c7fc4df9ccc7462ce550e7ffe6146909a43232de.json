{
 "description": "List the schemas of a datasource.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "catalog": {
    "description": "Catalog / database name, if the DB uses one",
    "type": "string"
   },
   "datasource": {
    "description": "Datasource name; defaults to DBHAWK_DEFAULT_DATASOURCE",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_schemas"
}
