{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Reg Search"
 },
 "description": "Search the Federal Register (the daily journal of the US government) for rules, proposed rules, notices, and presidential documents by keyword, with optional agency, document type, and publication-date filters. Returns each document's number, title, type, publishing agency, abstract, and URL. Use reg_document to get the full text of one document.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agency": {
    "description": "Optional agency slug, e.g. 'environmental-protection-agency', 'securities-and-exchange-commission'.",
    "type": "string"
   },
   "limit": {
    "description": "Max rows (default 20, max 100).",
    "type": "number"
   },
   "published_from": {
    "description": "Published on/after, ISO date yyyy-mm-dd.",
    "type": "string"
   },
   "published_to": {
    "description": "Published on/before, ISO date yyyy-mm-dd.",
    "type": "string"
   },
   "term": {
    "description": "Keyword(s), e.g. 'methane emissions', 'overtime rule'.",
    "type": "string"
   },
   "type": {
    "description": "Optional document type: 'rule', 'proposed-rule', 'notice', or 'presidential-document'.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "reg_search"
}
