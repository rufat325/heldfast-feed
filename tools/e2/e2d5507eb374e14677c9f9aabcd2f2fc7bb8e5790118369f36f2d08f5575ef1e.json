{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get one cruise"
 },
 "description": "One cruise in full: the day-by-day itinerary, every future sailing with its price (or why there isn't one) and a booking link, and its Cruisify page. Give the url of a Cruisify cruise page, as search_cruises returns it, or the cruise's slug.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "A cruise's slug: the last part of its URL",
    "maxLength": 200,
    "type": "string"
   },
   "url": {
    "description": "A Cruisify cruise page URL, as search_cruises returns it",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_cruise",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cruise_line": {
    "description": "The cruise line's name",
    "type": "string"
   },
   "description": {
    "description": "A short description, or null",
    "type": [
     "string",
     "null"
    ]
   },
   "destinations": {
    "description": "The destinations it visits, the main one first",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "itinerary": {
    "description": "Day by day, with consecutive days in one place as one row",
    "items": {
     "additionalProperties": false,
     "properties": {
      "country": {
       "description": "The port's country, or null",
       "type": [
        "string",
        "null"
       ]
      },
      "day": {
       "description": "\"Day 3\" or \"Days 3\u20134\", or null when the day isn't known",
       "type": [
        "string",
        "null"
       ]
      },
      "duration": {
       "description": "\"Overnight in port\", \"3 days at sea\" and so on for a row of several days, else null",
       "type": [
        "string",
        "null"
       ]
      },
      "place": {
       "description": "The port, \"At sea\", or \"Port to be confirmed\"",
       "type": "string"
      }
     },
     "required": [
      "day",
      "place",
      "country",
      "duration"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "kind": {
    "description": "ocean, river or expedition",
    "enum": [
     "ocean",
     "river",
     "expedition"
    ],
    "type": "string"
   },
   "nights": {
    "description": "Length in nights",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "route": {
    "description": "Where it starts and ends: \"Round trip from Southampton\", \"Southampton to New York\"",
    "type": "string"
   },
   "sailings": {
    "description": "Every future sailing",
    "items": {
     "additionalProperties": false,
     "properties": {
      "book_url": {
       "description": "Where to book this sailing",
       "format": "uri",
       "type": "string"
      },
      "departure_date": {
       "description": "Departure date",
       "format": "date",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
       "type": "string"
      },
      "price": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "basis": {
           "description": "What the price covers, in the cruise line's own words",
           "type": "string"
          },
          "checked_at": {
           "description": "The UK date the price was checked, YYYY-MM-DD",
           "format": "date",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
           "type": "string"
          },
          "converted_from": {
           "description": "The currency we converted the price from, so it is our estimate; null for a price set in pounds",
           "type": [
            "string",
            "null"
           ]
          },
          "from_gbp": {
           "description": "The lowest price per person, in pounds",
           "type": "number"
          }
         },
         "required": [
          "from_gbp",
          "basis",
          "checked_at",
          "converted_from"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "The lowest price we hold for this sailing, or null (price_note says why)"
      },
      "price_note": {
       "description": "Why there is no price, or null when there is one",
       "type": [
        "string",
        "null"
       ]
      },
      "return_date": {
       "anyOf": [
        {
         "format": "date",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Return date, or null when we don't have it"
      },
      "sold_out": {
       "description": "true when this sailing is sold out",
       "type": "boolean"
      }
     },
     "required": [
      "departure_date",
      "return_date",
      "sold_out",
      "price",
      "price_note",
      "book_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ship": {
    "description": "The ship's name",
    "type": "string"
   },
   "title": {
    "description": "The cruise's title",
    "type": "string"
   },
   "url": {
    "description": "The cruise's Cruisify page, which shows every date and the current price",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "title",
   "cruise_line",
   "ship",
   "kind",
   "nights",
   "route",
   "destinations",
   "description",
   "itinerary",
   "sailings",
   "url"
  ],
  "type": "object"
 },
 "title": "Get one cruise"
}
