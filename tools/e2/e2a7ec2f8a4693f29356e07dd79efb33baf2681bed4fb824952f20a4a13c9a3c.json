{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Create a Markdown checkbox task in a note, optionally under a heading.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "checked": {
    "default": false,
    "description": "Create the task as completed.",
    "type": "boolean"
   },
   "dryRun": {
    "default": false,
    "description": "Preview the change without applying it: returns the planned action and the exact CLI command.",
    "type": "boolean"
   },
   "heading": {
    "description": "Optional Markdown heading section to append under.",
    "type": "string"
   },
   "indent": {
    "default": 0,
    "description": "Number of leading spaces.",
    "maximum": 32,
    "minimum": 0,
    "type": "integer"
   },
   "note": {
    "description": "Vault-relative note receiving the task.",
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "description": "Task text.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "note",
   "text"
  ],
  "type": "object"
 },
 "name": "task_create",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Optional tool-specific structured result data."
   },
   "text": {
    "description": "Human-readable result text.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "title": "Create task"
}
