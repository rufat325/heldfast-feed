{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search open listings"
 },
 "description": "Find open offers and requests. No auth needed for public listings.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "electronics",
     "collectibles",
     "vehicles",
     "home",
     "fashion",
     "business",
     "materials",
     "digital",
     "dev",
     "creative",
     "research",
     "admin",
     "marketing",
     "local",
     "logistics",
     "agent-tasks",
     "housing",
     "other"
    ],
    "type": "string"
   },
   "country": {
    "description": "ISO alpha-2; also returns worldwide/remote listings",
    "type": "string"
   },
   "kind": {
    "enum": [
     "offer",
     "request"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "max_amount": {
    "type": "number"
   },
   "min_amount": {
    "type": "number"
   },
   "offset": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   },
   "q": {
    "description": "Free text",
    "type": "string"
   },
   "remote": {
    "type": "boolean"
   },
   "sort": {
    "default": "closing",
    "enum": [
     "closing",
     "newest"
    ],
    "type": "string"
   },
   "tag": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_listings",
 "title": "Search open listings"
}
