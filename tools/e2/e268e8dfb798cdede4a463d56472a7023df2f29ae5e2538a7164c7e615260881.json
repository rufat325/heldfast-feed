 "description": "Audit one MCP toolset for the defects that stop an agent calling it correctly: a missing or non-object inputSchema, an argument with no type or no description, a required argument the schema never declares, a duplicated tool name, contradictory annotation hints, and a tool whose name reads as state-changing while declaring no hints at all. Pay 100000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "require_descriptions": {
    "description": "Whether a missing tool or argument description is a finding. Defaults to true, because it is what an agent reads to choose and fill the tool.",
    "type": "boolean"
   },
   "require_output_schemas": {
    "description": "Whether a missing outputSchema is a finding. Defaults to false, since many servers legitimately return free text.",
    "type": "boolean"
   },
   "toolset": {
    "description": "An MCP toolset: either the tools/list result object, or the bare array of tool definitions. At most 400 tools are read and the rest are reported. A capabilities or serverInfo object is used when present. Nothing is fetched and no tool is ever called.",
    "example": {
     "tools": [
      {
       "inputSchema": {
        "properties": {
         "q": {}
        },
        "type": "object"
       },
       "name": "search"
      },
      {
       "description": "Remove all records.",
       "inputSchema": {
        "properties": {
         "confirm": {
          "type": "boolean"
         }
        },
        "required": [
         "confirm",
         "scope"
        ],
        "type": "object"
       },
       "name": "purgeEverything"
      },
      {
       "annotations": {
        "destructiveHint": true,
        "readOnlyHint": true
       },
       "description": "Read a file from disk and return its contents as text.",
       "inputSchema": {
        "type": "array"
       },
       "name": "read_file"
      }
     ]
    }
   }
  },
  "required": [
   "toolset"
  ],
  "type": "object"
 },
 "name": "mcp_tool_schema_audit",
