{
 "description": "Compress image quality to reduce file size.",
 "inputSchema": {
  "oneOf": [
   {
    "required": [
     "filePath"
    ]
   },
   {
    "required": [
     "fileData"
    ]
   }
  ],
  "properties": {
   "fileData": {
    "description": "Base64 encoded image data.",
    "type": "string"
   },
   "filePath": {
    "description": "Local path to the image file.",
    "type": "string"
   },
   "outputPath": {
    "description": "Optional local path to save the compressed image.",
    "type": "string"
   },
   "quality": {
    "description": "Compression quality from 1 to 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "quality"
  ],
  "type": "object"
 },
 "name": "image_compress"
}
