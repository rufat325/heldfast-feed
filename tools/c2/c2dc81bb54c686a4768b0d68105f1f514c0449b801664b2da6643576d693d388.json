{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the ISHOB archive (titles, keywords, authors). All words must match. Free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fulltext": {
    "description": "Only resources with structured full text",
    "type": "boolean"
   },
   "license": {
    "description": "Restrict to one licence family",
    "enum": [
     "CC0",
     "PDM",
     "CC-BY",
     "CC-BY-SA"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of results to return",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Words to search for (all must match)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "topic": {
    "description": "Restrict to a topic slug",
    "pattern": "^[a-z0-9-]{1,64}$",
    "type": "string"
   },
   "year_from": {
    "description": "Earliest publication year to include",
    "maximum": 3000,
    "minimum": 1800,
    "type": "integer"
   },
   "year_to": {
    "description": "Latest publication year to include",
    "maximum": 3000,
    "minimum": 1800,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_archive",
 "title": "Search the archive"
}
