{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Run an ad hoc audience query or browse a saved audience run via the public query endpoint.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audienceId": {
    "format": "uuid",
    "type": "string"
   },
   "cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "filters": {
    "additionalProperties": false,
    "properties": {
     "ageRange": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "companyDomain": {
      "maxLength": 255,
      "type": "string"
     },
     "companyIndustry": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "companyName": {
      "maxLength": 255,
      "type": "string"
     },
     "companyRevenueRange": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "companySize": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "department": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "gender": {
      "type": "string"
     },
     "hasBusinessEmail": {
      "type": "boolean"
     },
     "hasLinkedin": {
      "type": "boolean"
     },
     "hasPersonalEmail": {
      "type": "boolean"
     },
     "hasPhone": {
      "type": "boolean"
     },
     "isB2b": {
      "enum": [
       "y",
       "n"
      ],
      "type": "string"
     },
     "jobTitle": {
      "maxLength": 200,
      "type": "string"
     },
     "seniority": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "state": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "maxScore": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "minScore": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "minTopicOverlap": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "topicIds": {
    "items": {
     "type": "integer"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "query_audience",
 "title": "Query Audience"
}
