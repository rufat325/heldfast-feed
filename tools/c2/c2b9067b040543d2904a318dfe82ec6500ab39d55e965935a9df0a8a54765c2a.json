{
 "description": "List WordPress posts with optional filters",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Published after this ISO8601 date",
    "type": "string"
   },
   "author": {
    "description": "Limit to these author user IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "author_exclude": {
    "description": "Exclude these author user IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "before": {
    "description": "Published before this ISO8601 date",
    "type": "string"
   },
   "categories": {
    "description": "Limit to posts in any of these category IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "categories_exclude": {
    "description": "Exclude posts in these category IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "exclude": {
    "description": "Exclude these IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "format": {
    "description": "Limit to these post formats",
    "items": {
     "enum": [
      "standard",
      "aside",
      "chat",
      "gallery",
      "link",
      "image",
      "quote",
      "status",
      "video",
      "audio"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "ignore_sticky": {
    "description": "Do not move sticky posts to the top (WP default true)",
    "type": "boolean"
   },
   "include": {
    "description": "Limit to these IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "modified_after": {
    "description": "Modified after this ISO8601 date",
    "type": "string"
   },
   "modified_before": {
    "description": "Modified before this ISO8601 date",
    "type": "string"
   },
   "offset": {
    "description": "Skip this many items (overrides page)",
    "type": "integer"
   },
   "order": {
    "default": "desc",
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "orderby": {
    "default": "date",
    "description": "Sort field",
    "enum": [
     "author",
     "date",
     "id",
     "include",
     "modified",
     "parent",
     "relevance",
     "slug",
     "include_slugs",
     "title"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "integer"
   },
   "per_page": {
    "default": 10,
    "description": "Posts per page (max 100)",
    "type": "integer"
   },
   "search": {
    "description": "Search term",
    "type": "string"
   },
   "search_columns": {
    "description": "Columns to search (default title, excerpt and content)",
    "items": {
     "enum": [
      "post_title",
      "post_content",
      "post_excerpt"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "search_semantics": {
    "description": "'exact' matches the search term as a whole phrase",
    "enum": [
     "exact"
    ],
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "Limit to these slugs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "description": "Limit to one or more statuses (default publish; 'any' = all except trash/auto-draft)",
    "items": {
     "enum": [
      "publish",
      "future",
      "draft",
      "pending",
      "private",
      "trash",
      "auto-draft",
      "inherit",
      "any"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "sticky": {
    "description": "true = only sticky posts, false = only non-sticky",
    "type": "boolean"
   },
   "tags": {
    "description": "Limit to posts with any of these tag IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "tags_exclude": {
    "description": "Exclude posts with these tag IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "tax_relation": {
    "description": "How categories and tags filters combine (default AND)",
    "enum": [
     "AND",
     "OR"
    ],
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "wp_list_posts"
}
