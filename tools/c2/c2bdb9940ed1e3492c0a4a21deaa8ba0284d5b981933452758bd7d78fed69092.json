{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a price quote"
 },
 "description": "Get the live total for a TripWays tour on one date and start time for a traveler mix, priced from the operator's booking calendar. A quote does not hold seats or charge anything. Optional extras and promo codes are not included. When the tour's rates cannot price that mix, the result is unpriced.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bokun_id": {
    "pattern": "^[0-9]+$",
    "type": "string"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "start_time": {
    "description": "HH:MM if start_time_id unknown.",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "start_time_id": {
    "minimum": 1,
    "type": "integer"
   },
   "travelers": {
    "additionalProperties": false,
    "description": "Simple ages; mapped to Bokun pricing categories.",
    "properties": {
     "adults": {
      "default": 1,
      "minimum": 0,
      "type": "integer"
     },
     "children": {
      "minimum": 0,
      "type": "integer"
     },
     "infants": {
      "minimum": 0,
      "type": "integer"
     },
     "seniors": {
      "minimum": 0,
      "type": "integer"
     },
     "youth": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "bokun_id",
   "date"
  ],
  "type": "object"
 },
 "name": "get_price_quote",
 "title": "Get a price quote"
}
