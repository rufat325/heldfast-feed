{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create client invoice"
 },
 "description": "Create the exact invoice previously returned by prepare_client_invoice. This is a confirmed write: it revalidates the report snapshot and client identity, creates a private editable Google Doc plus private PDF and DOCX copies, records the issued invoice, and supersedes an older active invoice for the same report. It does not send email or create an Income row. If tax is positive, confirmTax must be true.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmTax": {
    "description": "True only after the user confirms the displayed tax label and rate.",
    "type": "boolean"
   },
   "operationId": {
    "description": "Optional retry key. Reuse it after an uncertain response.",
    "type": "string"
   },
   "preparationId": {
    "description": "Short-lived ID returned by prepare_client_invoice.",
    "type": "string"
   }
  },
  "required": [
   "preparationId"
  ],
  "type": "object"
 },
 "name": "create_client_invoice",
