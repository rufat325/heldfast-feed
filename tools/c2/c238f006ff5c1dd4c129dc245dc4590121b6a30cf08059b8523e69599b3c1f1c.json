{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get a unified event stream combining ticket creates, updates, deletes, and tag changes. Without since/after: the newest events, newest first. With since or after: the events after it, oldest first. To poll incrementally without missing events, pass the sequence of the last event received as the next after.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Only events written after this sequence number (an earlier event's sequence), in write order",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "limit": {
    "description": "Maximum number of events to return (default 50)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "since": {
    "description": "Only events after this ISO timestamp (then oldest first)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "event_log",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "sequence": {
       "description": "Pass the last one as after to poll",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "ticketId": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "ticketTitle": {
       "type": "string"
      },
      "timestamp": {
       "description": "ISO timestamp",
       "type": "string"
      },
      "type": {
       "enum": [
        "ticket_created",
        "ticket_updated",
        "ticket_deleted",
        "tag_added",
        "tag_removed"
       ],
       "type": "string"
      }
     },
     "required": [
      "timestamp",
      "type",
      "ticketId",
      "ticketTitle",
      "detail",
      "sequence"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
