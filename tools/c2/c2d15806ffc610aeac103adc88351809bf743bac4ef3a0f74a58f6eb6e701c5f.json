{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a task"
 },
 "description": "Update a task \u2014 mark it completed, change due date, status, assignee or details. Only the fields you pass are changed. Insightly: PUT /Tasks with TASK_ID.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category_id": {
    "description": "Task category id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "completed": {
    "description": "Whether the task is done.",
    "type": "boolean"
   },
   "custom_fields": {
    "description": "Custom field values to set.",
    "items": {
     "properties": {
      "field_name": {
       "description": "The custom field's FIELD_NAME, e.g. Industry__c.",
       "type": "string"
      },
      "field_value": {
       "description": "The value (null clears it).",
       "type": [
        "string",
        "number",
        "boolean",
        "null"
       ]
      }
     },
     "required": [
      "field_name",
      "field_value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "details": {
    "description": "Task description.",
    "type": "string"
   },
   "due_date": {
    "description": "Due date, as \"yyyy-MM-dd HH:mm:ss\" in UTC (e.g. 2026-04-10 21:15:00).",
    "type": "string"
   },
   "opportunity_id": {
    "description": "Link the task to this opportunity.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "owner_user_id": {
    "description": "Owner's user id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "percent_complete": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "priority": {
    "description": "Priority number.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "project_id": {
    "description": "Link the task to this project.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "responsible_user_id": {
    "description": "Assignee's user id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "start_date": {
    "description": "Start date, as \"yyyy-MM-dd HH:mm:ss\" in UTC (e.g. 2026-04-10 21:15:00).",
    "type": "string"
   },
   "status": {
    "description": "Task STATUS text, using a value your Insightly instance accepts (read an existing task to see them).",
    "type": "string"
   },
   "task_id": {
    "description": "The task's numeric id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "title": {
    "description": "Task title.",
    "type": "string"
   }
  },
  "required": [
   "task_id"
  ],
  "type": "object"
 },
 "name": "insightly_update_task",
 "title": "Update a task"
}
