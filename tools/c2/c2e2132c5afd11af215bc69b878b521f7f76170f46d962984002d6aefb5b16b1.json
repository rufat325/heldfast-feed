{
 "_meta": {
  "chainray.com/capability": {
   "alternateOf": null,
   "catalog": "/.well-known/mcp-capabilities.json",
   "components": [],
   "contract": "/openapi.json",
   "httpRoutes": [
    "/recent-interactions/{address}"
   ],
   "id": "urn:chainray:capability:mcp:analyze.recent_interactions",
   "payment": "x402",
   "role": "atomic",
   "surface": [
    "mcp",
    "http"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Show addresses that interacted with a target in recent ~2000 blocks. Labels known entities (CEX, DEX, bridges). EVM only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Target wallet address",
    "type": "string"
   },
   "chain": {
    "default": "base",
    "description": "EVM chain only. Supported chains: base, ethereum, arbitrum, optimism, polygon, bsc, avalanche, zksync, linea, scroll, blast, mantle, gnosis, polygon-zkevm, mode, sei, celo, manta, taiko, fantom, cronos, opbnb, zora, worldchain, metis, fraxtal, kava, zetachain, filecoin, core-dao, aurora, moonbeam, klaytn, bob, canto, monad, tempo, megaeth, arc, plasma, katana, robinhood, pharos, hyperevm.",
    "enum": [
     "base",
     "ethereum",
     "arbitrum",
     "optimism",
     "polygon",
     "bsc",
     "avalanche",
     "zksync",
     "linea",
     "scroll",
     "blast",
     "mantle",
     "gnosis",
     "polygon-zkevm",
     "mode",
     "sei",
     "celo",
     "manta",
     "taiko",
     "fantom",
     "cronos",
     "opbnb",
     "zora",
     "worldchain",
     "metis",
     "fraxtal",
     "kava",
     "zetachain",
     "filecoin",
     "core-dao",
     "aurora",
     "moonbeam",
     "klaytn",
     "bob",
     "canto",
     "monad",
     "tempo",
     "megaeth",
     "arc",
     "plasma",
     "katana",
     "robinhood",
     "pharos",
     "hyperevm"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "analyze.recent_interactions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "blocksScanned": {
    "type": "number"
   },
   "chain": {
    "description": "Blockchain queried",
    "type": "string"
   },
   "chainName": {
    "type": "string"
   },
   "knownEntities": {
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "labeledEntities": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "totalUniqueCounterparts": {
      "type": "number"
     }
    },
    "required": [
     "totalUniqueCounterparts",
     "labeledEntities"
    ],
    "type": "object"
   },
   "target": {
    "description": "Address",
    "type": "string"
   },
   "timestamp": {
    "description": "Unix timestamp ms",
    "type": "number"
   },
   "topInteractions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "description": "Address",
       "type": "string"
      },
      "label": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastBlock": {
       "type": "number"
      },
      "received": {
       "type": "number"
      },
      "sent": {
       "type": "number"
      },
      "totalInteractions": {
       "type": "number"
      }
     },
     "required": [
      "address",
      "sent",
      "received",
      "lastBlock",
      "label",
      "totalInteractions"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "uniqueAddresses": {
    "type": "number"
   }
  },
  "required": [
   "chain",
   "chainName",
   "target",
   "blocksScanned",
   "note",
   "uniqueAddresses",
   "topInteractions",
   "knownEntities",
   "summary",
   "timestamp"
  ],
  "type": "object"
 },
 "title": "Recent Interactions"
}
