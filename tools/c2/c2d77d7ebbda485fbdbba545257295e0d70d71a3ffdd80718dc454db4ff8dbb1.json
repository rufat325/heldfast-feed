{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get Logs"
 },
 "description": "Search event logs by contract address and/or topics over a block range. Topics are 32-byte hex values; topic0 is usually the keccak256 event-signature hash. Adjacent-topic operators (and/or) combine multiple topic filters. Provide 'address' and/or at least one topic.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Contract address to filter by (optional if filtering by topics).",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "chainid": {
    "description": "Numeric chain id (e.g. 1=Ethereum, 56=BNB, 137=Polygon). If omitted, defaults to Ethereum Mainnet (1).",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "fromblock": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "const": "latest",
      "type": "string"
     }
    ],
    "description": "Start block number, or \"latest\". Default 0."
   },
   "offset": {
    "description": "Records per page (max 1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number (1-based).",
    "minimum": 1,
    "type": "integer"
   },
   "toblock": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "const": "latest",
      "type": "string"
     }
    ],
    "description": "End block number, or \"latest\". Default latest."
   },
   "topic0": {
    "description": "Topic 0 \u2014 usually the keccak256 event-signature hash.",
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "topic0_1_opr": {
    "description": "Combine topic0 and topic1: and | or.",
    "enum": [
     "and",
     "or"
    ],
    "type": "string"
   },
   "topic1": {
    "description": "Topic 1 (first indexed argument).",
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "topic1_2_opr": {
    "description": "Combine topic1 and topic2: and | or.",
    "enum": [
     "and",
     "or"
    ],
    "type": "string"
   },
   "topic2": {
    "description": "Topic 2 (second indexed argument).",
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "topic2_3_opr": {
    "description": "Combine topic2 and topic3: and | or.",
    "enum": [
     "and",
     "or"
    ],
    "type": "string"
   },
   "topic3": {
    "description": "Topic 3 (third indexed argument).",
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_logs",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "anyOf": [
     {
      "additionalProperties": {},
      "type": "object"
     },
     {
      "items": {},
      "type": "array"
     },
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "description": "The JSON result returned by the Etherscan data tool."
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "title": "Get Logs"
}
