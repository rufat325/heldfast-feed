{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "SEO dashboard"
 },
 "description": "A daily SEO data feed for key pages and a live dashboard in the chat. Pick with mode: feed = Start a daily feed of key pages; returns feed_id. Needs url. data = The feed as clean tables over time. Needs feed_id, dataset. build = Blueprint for a live SEO command center with realtime GA4 visitors. Needs feed_id.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bigquery": {
    "description": "Optional, for ready SQL.",
    "properties": {
     "ga4_dataset": {
      "description": "For example analytics_123456789.",
      "maxLength": 2000,
      "type": "string"
     },
     "gsc_dataset": {
      "description": "For example searchconsole.",
      "maxLength": 2000,
      "type": "string"
     },
     "project": {
      "maxLength": 2000,
      "type": "string"
     }
    },
    "type": "object"
   },
   "dataset": {
    "enum": [
     "overview",
     "pages",
     "issues",
     "open_issues",
     "vitals",
     "ai_access",
     "fixes"
    ],
    "type": "string"
   },
   "detail": {
    "description": "brief = short summary.",
    "enum": [
     "full",
     "brief"
    ],
    "type": "string"
   },
   "feed_id": {
    "description": "Feed from create_dashboard_feed.",
    "maxLength": 2000,
    "type": "string"
   },
   "fix_log_id": {
    "description": "Optional fix log from log_fix, to include shipped fixes.",
    "maxLength": 2000,
    "type": "string"
   },
   "format": {
    "description": "blueprint (default) for Claude Dashboards, or html for a complete, designed dashboard page filled with the feed's data, ready to show as an artifact.",
    "enum": [
     "blueprint",
     "html"
    ],
    "type": "string"
   },
   "from": {
    "description": "Start date, YYYY-MM-DD.",
    "maxLength": 2048,
    "type": "string"
   },
   "memory_key": {
    "description": "site_memory key, records this call.",
    "maxLength": 80,
    "type": "string"
   },
   "mode": {
    "description": "Default feed.",
    "enum": [
     "feed",
     "data",
     "build"
    ],
    "type": "string"
   },
   "name": {
    "description": "Optional name, for example the client's name.",
    "maxLength": 2000,
    "type": "string"
   },
   "pages": {
    "description": "Optional key pages to track, up to 10.",
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "replace": {
    "description": "Replace this connection's existing feed.",
    "type": "boolean"
   },
   "sources": {
    "description": "What the user has connected in Claude.",
    "items": {
     "enum": [
      "ga4",
      "gsc",
      "bigquery"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "to": {
    "description": "End date, YYYY-MM-DD.",
    "maxLength": 2048,
    "type": "string"
   },
   "url": {
    "description": "Home page of the site.",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "dashboard",
 "outputSchema": {
  "type": "object"
 },
 "title": "SEO dashboard"
}
