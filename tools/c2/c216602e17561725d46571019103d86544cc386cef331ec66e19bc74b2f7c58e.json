{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List all Datadog dashboards",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "default": 100,
    "description": "Number of dashboards to return",
    "type": "number"
   },
   "extractFields": {
    "description": "Comma-separated dotted paths to project from response (e.g. 'id,name,owner.name,columns.*.name'). Use `*` as wildcard for arrays/objects. Wrap field names with dots in backticks. Reduces response tokens dramatically on large entities.",
    "type": "string"
   },
   "filterShared": {
    "description": "Filter shared dashboards only",
    "type": "boolean"
   },
   "start": {
    "default": 0,
    "description": "Pagination offset",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "get-dashboards"
}
