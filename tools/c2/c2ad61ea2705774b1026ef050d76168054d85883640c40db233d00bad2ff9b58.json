{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Authorize a client for a deployment's Tor v3 restricted discovery. Supply pubkey generated in the customer's own Tor client, so its private key stays on their machine, OR generate=true to mint a keypair whose private_key is shown once and never retrievable later. Save any returned private credential securely; never put it in logs or source control. Duplicate names are refused; revoke first to reuse a name. Requires manage scope and an agent supporting onion-auth-v1.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   },
   "generate": {
    "type": "boolean"
   },
   "name": {
    "type": "string"
   },
   "pubkey": {
    "type": "string"
   }
  },
  "required": [
   "deployment_id",
   "name"
  ],
  "type": "object"
 },
 "name": "impreza_onion_auth_add",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "command_id": {
      "pattern": "^cmd_[A-Za-z0-9_-]{1,28}$",
      "type": "string"
     },
     "name": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$",
      "type": "string"
     },
     "private_note": {
      "type": "string"
     },
     "pubkey": {
      "pattern": "^[A-Z2-7]{52}$",
      "type": "string"
     }
    },
    "required": [
     "name",
     "pubkey",
     "command_id"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Authorize onion client"
}
