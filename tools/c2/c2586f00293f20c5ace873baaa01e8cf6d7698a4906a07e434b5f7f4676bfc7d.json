{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Resolve approved real assets, embed them, and render an exact absolute-coordinate editable .drawio artifact. Rejects stale approvals.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "approvalToken": {
    "minLength": 1,
    "type": "string"
   },
   "planId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "revision": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "planId",
   "revision",
   "approvalToken"
  ],
  "type": "object"
 },
 "name": "create_reference_drawio",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "comparison": {
    "additionalProperties": false,
    "properties": {
     "expectedElements": {
      "type": "number"
     },
     "matchedElements": {
      "type": "number"
     },
     "missingElementIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "structuralScore": {
      "type": "number"
     }
    },
    "required": [
     "structuralScore",
     "expectedElements",
     "matchedElements",
     "missingElementIds"
    ],
    "type": "object"
   },
   "outputFile": {
    "type": "string"
   },
   "outputPath": {
    "type": "string"
   },
   "planId": {
    "type": "string"
   },
   "revision": {
    "type": "number"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "issues": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "cellId": {
         "type": "string"
        },
        "code": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "valid": {
      "type": "boolean"
     }
    },
    "required": [
     "valid",
     "issues"
    ],
    "type": "object"
   }
  },
  "required": [
   "outputFile",
   "outputPath",
   "planId",
   "revision",
   "validation",
   "comparison"
  ],
  "type": "object"
 },
 "title": "Render an Approved Reference Recreation"
}
