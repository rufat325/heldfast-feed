{"_meta":{"openai/widgetAccessible":false,"ui":{"visibility":["model"]}},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Read a web page as a reference"},"description":"Fetch a public HTTPS page (product page, article, landing page, or social post) with private-network, size and type checks, and return its title, description, card, JSON-LD product data, headings, main text and images with source URL, retrieval time and content hash. Social links and script-rendered pages are metadata_only. JavaScript is not run and embedded video/audio is never watched. With placeOnCanvas (needs canvas:edit and expectedRevision) it also adds a source card and up to three product images to the canvas.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"expectedRevision":{"description":"Current canvas revision from canvas_read; on revision_conflict, read again and rebuild the change.","maximum":9007199254740991,"minimum":0,"type":"integer"},"placeOnCanvas":{"description":"Whether to add the fetched page and usable reference images to the canvas; requires edit access and a current revision.","type":"boolean"},"projectId":{"description":"ID of the Playground project chosen for this task; obtain it from project creation, an explicit project link or current context.","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"url":{"description":"Public HTTPS URL of the source to inspect or import; use the original source link.","format":"uri","maxLength":2000,"type":"string"}},"required":["projectId","url"],"type":"object"},"name":"playground_web_page_read","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"placed":{"additionalProperties":{},"properties":{"cardNodeId":{"type":