{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a TouchOSC-oriented OSC mapping surface and JSON manifest DAT. This intentionally does not claim to generate TouchOSC .tosc documents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "controls": {
    "default": [],
    "description": "TouchOSC-style controls to expose as OSC mapping rows.",
    "items": {
     "properties": {
      "address": {
       "description": "OSC address. If omitted, generated from label.",
       "type": "string"
      },
      "default": {
       "type": "number"
      },
      "label": {
       "description": "Control label shown in the manifest and mapping table.",
       "minLength": 1,
       "type": "string"
      },
      "max": {
       "type": "number"
      },
      "min": {
       "type": "number"
      },
      "target": {
       "description": "Optional target as nodePath.parName.",
       "type": "string"
      },
      "type": {
       "default": "fader",
       "enum": [
        "fader",
        "xy",
        "toggle",
        "push",
        "rotary"
       ],
       "type": "string"
      }
     },
     "required": [
      "label"
     ],
     "type": "object"
    },
    "maxItems": 64,
    "type": "array"
   },
   "create_manifest_dat": {
    "default": true,
    "type": "boolean"
   },
   "name": {
    "default": "touchosc_layout",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "page_name": {
    "default": "tdmcp",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the TouchOSC surface.",
    "type": "string"
   },
   "receive_port": {
    "default": 8000,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "send_host": {
    "default": "127.0.0.1",
    "type": "string"
   },
   "send_port": {
    "default": 9000,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "create_touchosc_layout",
 "title": "Create TouchOSC layout"
}
