{
 "_meta": {
  "openai/outputTemplate": "ui://haus/widgets/v2",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://haus/widgets/v2",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Update an appliance's details; omitted fields keep their current value. Rejects the update if the resulting warranty expiry date would fall before the purchase date.",
 "inputSchema": {
  "examples": [
   {
    "id": "01933f9c-7a2b-7c3d-8e4f-1a2b3c4d5e6f",
    "notes": "Repaired ice maker under warranty, June 2026.",
    "warrantyExpiryDate": "2026-11-04"
   }
  ],
  "properties": {
   "brand": {
    "description": "New manufacturer or brand.",
    "examples": [
     "Samsung"
    ],
    "type": "string"
   },
   "id": {
    "description": "Appliance id from list_appliances.",
    "examples": [
     "01933f9c-7a2b-7c3d-8e4f-1a2b3c4d5e6f"
    ],
    "type": "string"
   },
   "insuranceDocumentId": {
    "description": "Insurance document id from create_document.",
    "examples": [
     "doc_1a2b3c4d5e6f"
    ],
    "type": "string"
   },
   "model": {
    "description": "New model.",
    "examples": [
     "RF28R7351SG"
    ],
    "type": "string"
   },
   "name": {
    "description": "New name.",
    "examples": [
     "Kitchen Refrigerator"
    ],
    "type": "string"
   },
   "notes": {
    "description": "Freeform notes.",
    "examples": [
     "Extended warranty purchased in-store, receipt in the kitchen drawer."
    ],
    "type": "string"
   },
   "purchaseDate": {
    "description": "Purchase date, YYYY-MM-DD. Must not follow warrantyExpiryDate. Empty string clears it.",
    "examples": [
     "2023-11-04"
    ],
    "type": "string"
   },
   "serialNumber": {
    "description": "New serial number.",
    "examples": [
     "S/N-4471829"
    ],
    "type": "string"
   },
   "warrantyDocumentId": {
    "description": "Warranty document id from create_document.",
    "examples": [
     "doc_8f3a1c2b9e4d"
    ],
    "type": "string"
   },
   "warrantyExpiryDate": {
    "description": "Warranty expiry, YYYY-MM-DD. Must not precede purchaseDate. Empty string clears it.",
    "examples": [
     "2025-11-04"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_appliance",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "variant": {
    "enum": [
     "list",
     "detail",
     "confirmation"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 }
}
