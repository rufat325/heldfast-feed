{
 "description": "Build a Jupiter swap transaction for signing. Returns a serialized transaction the agent must sign and submit. Costs $0.25 USDC.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Amount in atomic units",
    "type": "string"
   },
   "inputMint": {
    "description": "Input token mint address",
    "type": "string"
   },
   "outputMint": {
    "description": "Output token mint address",
    "type": "string"
   },
   "priorityFee": {
    "description": "Priority fee in lamports (default: auto)",
    "type": "string"
   },
   "slippageBps": {
    "description": "Slippage in basis points (default: 50)",
    "type": "string"
   },
   "userPublicKey": {
    "description": "The wallet public key that will sign and submit the transaction",
    "type": "string"
   }
  },
  "required": [
   "inputMint",
   "outputMint",
   "amount",
   "userPublicKey"
  ],
  "type": "object"
 },
 "name": "obol_swap_execute"
}
