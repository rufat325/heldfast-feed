{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate a saved AdSense report as structured JSON.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currencyCode": {
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "dateRange": {
    "description": "Preset date range such as TODAY, YESTERDAY, LAST_7_DAYS, MONTH_TO_DATE, CUSTOM.",
    "type": "string"
   },
   "endDate": {
    "description": "Custom end date in YYYY-MM-DD.",
    "type": "string"
   },
   "languageCode": {
    "type": "string"
   },
   "name": {
    "pattern": "^accounts\\/[^/]+\\/reports\\/[^/]+$",
    "type": "string"
   },
   "reportingTimeZone": {
    "description": "ACCOUNT_TIME_ZONE or GOOGLE_TIME_ZONE.",
    "type": "string"
   },
   "startDate": {
    "description": "Custom start date in YYYY-MM-DD.",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "adsense_generate_saved_report"
}
