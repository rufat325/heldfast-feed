{"description":"Update an automation rule (admin only). Only supplied fields change; setting active true re-enables a rule that was auto-disabled after repeated failures. Hosted API only.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"actions":{"description":"Replacement actions (full replacement, not a merge)","items":{"description":"One action to run when the rule matches","properties":{"agent_id":{"description":"Agent to assign/delegate to (assign, delegate)","type":"string"},"assigned_to_agent_id":{"description":"Assignee for the new task (create_task)","type":"string"},"content":{"description":"Text template (add_comment, create_task, delegate). Placeholders: {{event}}, {{task.id}}, {{task.content}}, {{task.priority}}, {{task.project_id}}, {{task.labels}}, {{task.due_date}}","type":"string"},"description":{"description":"Description template (create_task, delegate)","type":"string"},"label":{"description":"Label to add (add_label)","type":"string"},"labels":{"description":"Labels for the new task (create_task, delegate)","items":{"type":"string"},"type":"array"},"policy":{"description":"Evidence policy to set (set_evidence_policy) \u2014 only 'required'; rules can tighten, never remove","enum":["required"],"type":"string"},"priority":{"description":"Priority 1-4 (set_priority, create_task, delegate)","maximum":4,"minimum":1,"type":"integer"},"project_id":{"description":"Project for the new task (create_task)","type":"string"},"type":{"description":"Action verb","enum":["assign","set_priority","add_label","add_comment","create_task","delegate","set_evidence_policy"],"type":"string"}},"required":["type"],"type":"object"},"maxItems":5,"minItems":1,"type":"array"},"active":{"description":"Enable or disable the rule","type":"boolean"},"automation_id":{"description":"Automation rule ID to update","type":["string","number"]},"conditions":{"description":"Replacement conditions (full replacement, not a merge)","items":{"description":"One condition; all conditions must match (AND)","properties":{"field":{"description":"Task field to test","enum":["label","priority","project_id","assigned_to_agent_id","created_by_agent_id","source"],"type":"string"},"op":{"description":"Comparison (label: has/not_has; priority: eq/neq/gte/lte; ids: eq/neq/is_null/not_null; source: eq/neq)","enum":["has","not_has","eq","neq","gte","lte","is_null","not_null"],"type":"string"},"value":{"description":"Comparison value (omit for is_null/not_null)","type":["string","number"]}},"required":["field","op"],"type":"object"},"maxItems":10,"type":"array"},"event":{"description":"New trigger event","enum":["task.created","task.updated","task.completed","task.deleted","task.assigned","task.delegated","task.commented","task.claimed","task.released","task.state_changed","task.linked"],"type":"string"},"name":{"description":"New rule name","maxLength":80,"type":"string"}},"required":["automation_id"],"type":"object"},"name":"update_automation"}
