       }
      },
      "required": [
       "action",
       "module"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "imports",
        "type": "string"
       },
       "module": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "module"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "exports",
        "type": "string"
       },
       "module": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "module"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "entry_point",
        "type": "string"
       },
       "module": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "module"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "relocations",
        "type": "string"
       },
       "address": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
