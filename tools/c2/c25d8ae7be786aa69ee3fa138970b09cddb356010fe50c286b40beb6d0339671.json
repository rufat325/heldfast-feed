        "type": "string"
       }
      },
      "required": [
       "action",
       "oep"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "export_patch_file",
        "type": "string"
       },
       "filename": {
        "description": "Output path for .1337 patch file",
        "type": "string"
       }
      },
      "required": [
       "action",
       "filename"
      ],
      "type": "object"
