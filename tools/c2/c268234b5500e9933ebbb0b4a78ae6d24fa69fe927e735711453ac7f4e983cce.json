  "readOnlyHint": false,
  "title": "Support-Ticket erstellen"
 },
 "description": "Legt nach ausdr\u00fccklicher Best\u00e4tigung ein Support-Ticket an. Erster Aufruf ohne g\u00fcltige Best\u00e4tigung ergibt CONFIRMATION_REQUIRED mit Zusammenfassung und Token; erst ein zweiter Aufruf mit confirmed=true und diesem Token speichert.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Kategorie",
    "enum": [
     "account",
     "billing",
     "bug",
     "feature_request",
     "question",
     "sync"
    ],
    "type": "string"
   },
   "confirmation_token": {
    "description": "Token aus der Best\u00e4tigungsaufforderung",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "confirmed": {
    "description": "true erst nach ausdr\u00fccklicher Zustimmung des Nutzers",
    "type": "boolean"
   },
   "contact_email": {
    "description": "Kontakt-E-Mail f\u00fcr R\u00fcckfragen",
    "maxLength": 254,
    "minLength": 5,
    "type": "string"
   },
   "description": {
    "description": "Beschreibung ohne Halter-/Patientendaten, Passw\u00f6rter oder Kartendaten",
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   },
   "include_diagnostics": {
    "description": "Einwilligung, Diagnosedaten anzuh\u00e4ngen (hier werden keine erhoben)",
    "type": "boolean"
   },
   "priority": {
    "description": "Priorit\u00e4t (Vorgabe normal)",
    "enum": [
     "low",
     "normal",
     "high"
    ],
    "type": "string"
   },
   "subject": {
    "description": "Betreff",
    "maxLength": 120,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
