  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "r-address",
    "minLength": 25,
    "type": "string"
   },
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "reward_status",
