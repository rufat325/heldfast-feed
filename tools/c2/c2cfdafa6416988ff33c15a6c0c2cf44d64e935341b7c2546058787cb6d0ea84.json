{
 "description": "Archive an item in a 1Password vault. The item is moved to the archive and hidden from regular views, rather than being permanently deleted.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "itemId": {
    "description": "Item ID to archive.",
    "minLength": 1,
    "type": "string"
   },
   "vaultId": {
    "description": "Vault ID containing the item.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "vaultId",
   "itemId"
  ],
  "type": "object"
 },
 "name": "item_archive"
}
