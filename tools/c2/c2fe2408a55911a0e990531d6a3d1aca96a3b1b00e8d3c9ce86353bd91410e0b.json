{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Adjust the crop of one existing source view after a layout has been applied. Revision checked; dryRun previews by default. Preserves the other shots.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "crop": {
    "additionalProperties": false,
    "properties": {
     "height": {
      "maximum": 1,
      "minimum": 0.0001,
      "type": "number"
     },
     "width": {
      "maximum": 1,
      "minimum": 0.0001,
      "type": "number"
     },
     "x": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "y": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "x",
     "y",
     "width",
     "height"
    ],
    "type": "object"
   },
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "itemId": {
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "description": "UUID string.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "itemId",
   "crop",
   "workspaceId",
   "idempotencyKey",
   "projectId",
   "expectedRevision",
   "dryRun"
  ],
  "type": "object"
 },
 "name": "editor_crop_set",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "editor crop set"
}
