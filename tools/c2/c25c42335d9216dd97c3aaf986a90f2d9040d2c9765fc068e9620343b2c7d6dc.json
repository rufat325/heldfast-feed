     "FR"
    ],
    "title": "Country",
    "type": "string"
   },
   "detail": {
    "default": "standard",
    "description": "summary: a few key fields; standard (default): the record, long lists shortened; full: everything.",
    "enum": [
     "summary",
     "standard",
     "full"
    ],
    "examples": [
     "summary"
    ],
    "title": "Detail",
    "type": "string"
   },
   "id_scheme": {
    "anyOf": [
     {
      "enum": [
       "FR_SIREN",
       "FR_SIRET",
       "EU_VAT",
       "LEI",
       "ES_RM_HOJA",
       "ES_NIF",
       "GB_COMPANY_NUMBER"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional: force the ID type.",
    "examples": [
     "FR_SIRET"
    ],
    "title": "Id Scheme"
   },
   "identifier": {
    "description": "Official ID: FR SIREN or SIRET; ES Registro Mercantil sheet from search_companies. GB: Companies House company number, e.g. 00445790. Never a name.",
    "examples": [
     "441639465",
     "VI-23266",
     "00445790"
    ],
    "maxLength": 64,
    "title": "Identifier",
    "type": "string"
   },
   "reference": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional: your own case id, stored with the result.",
    "examples": [
     "onboarding-2026-0042"
    ],
    "title": "Reference"
   }
  },
  "required": [
   "country",
   "identifier"
  ],
  "title": "verify_companyArguments",
  "type": "object"
 },
