{"description":"Monthly PIHPS Nasional (Bank Indonesia) price series, in Rp/kg, for one province and one staple food from May 2017; each point is the price on the first day of the month with data (observed_on). Optional from and to months.","inputSchema":{"properties":{"commodity":{"description":"Commodity code from list_food_commodities","enum":["beras","daging_ayam","daging_sapi","telur_ayam","bawang_merah","bawang_putih","cabai_merah","cabai_rawit","minyak_goreng","gula_pasir"],"type":"string"},"from":{"description":"First month, optional","pattern":"^\\d{4}-(0[1-9]|1[0-2])$","type":"string"},"province_code":{"description":"Kemendagri province code","pattern":"^\\d{2}$","type":"string"},"to":{"description":"Last month, optional","pattern":"^\\d{4}-(0[1-9]|1[0-2])$","type":"string"}},"required":["commodity","province_code"],"type":"object"},"name":"get_food_price_series"}
