{
 "description": "Positions of every body in an authored synthetic system at one instant. Three body modes: `placement` (fixed longitude), `periodic` (uniform motion), `kepler` (constant elements). With `observer` set on the system, positions are geocentric/apparent from that body (outer bodies can show retrograde). Pass `t_days` for abstract day units, or `date` (UT ISO) when body `epoch` values are Julian Days. Returns speed and retrograde per body.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date": {
    "description": "UT instant as ISO 8601; used as t when t_days is omitted",
    "type": "string"
   },
   "system": {
    "additionalProperties": false,
    "properties": {
     "bodies": {
      "items": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "id": {
           "type": "string"
          },
          "lonDeg": {
           "type": "number"
          },
          "mode": {
           "const": "placement",
           "type": "string"
          }
         },
         "required": [
          "id",
          "mode",
          "lonDeg"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "epoch": {
           "type": "number"
          },
          "id": {
           "type": "string"
          },
          "mode": {
           "const": "periodic",
           "type": "string"
          },
          "periodDays": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "phaseDeg": {
           "type": "number"
          }
         },
         "required": [
          "id",
          "mode",
          "periodDays",
          "phaseDeg"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "M0": {
           "type": "number"
          },
          "a": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "e": {
           "exclusiveMaximum": 1,
           "minimum": 0,
           "type": "number"
          },
          "epoch": {
           "type": "number"
          },
          "i": {
           "type": "number"
          },
          "id": {
           "type": "string"
          },
          "mode": {
           "const": "kepler",
           "type": "string"
          },
          "node": {
           "type": "number"
          },
          "peri": {
           "type": "number"
          },
          "periodDays": {
           "exclusiveMinimum": 0,
           "type": "number"
          }
         },
         "required": [
          "id",
          "mode",
          "a",
          "e",
          "i",
          "node",
          "peri",
          "M0",
          "periodDays"
         ],
         "type": "object"
        }
       ]
      },
      "minItems": 1,
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "observer": {
      "type": "string"
     },
     "render": {
      "additionalProperties": {
       "additionalProperties": false,
       "properties": {
        "color": {
         "type": "string"
        },
        "magnitude": {
         "type": "number"
        },
        "sizeDeg": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "object"
     }
    },
    "required": [
     "id",
     "bodies"
    ],
    "type": "object"
   },
   "t_days": {
    "description": "Time in the same day units as each body's periodDays/epoch (abstract world frame)",
    "type": "number"
   }
  },
  "required": [
   "system"
  ],
  "type": "object"
 },
 "name": "synthetic_positions"
}
