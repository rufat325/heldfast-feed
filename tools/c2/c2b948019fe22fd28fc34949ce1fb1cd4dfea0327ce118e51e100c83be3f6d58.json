{
 "description": "Bulk-replace all carousel cards for a post. Provide a full array of card objects with title, body, and optional number.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cards": {
    "description": "Full replacement array of card objects",
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "number": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "postId": {
    "description": "Post ID",
    "type": "string"
   },
   "rerender": {
    "default": false,
    "description": "Regenerate visual assets after update",
    "type": "boolean"
   }
  },
  "required": [
   "postId",
   "cards"
  ],
  "type": "object"
 },
 "name": "set_post_cards"
}
