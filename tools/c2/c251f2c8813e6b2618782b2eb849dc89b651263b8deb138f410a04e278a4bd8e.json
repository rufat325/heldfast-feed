{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Calendar"
 },
 "description": "Update a calendar's name, timezone, agent status, default reminders, or metadata. Agent-scoped keys may only update calendars owned by their agent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_status": {
    "description": "Owning agent's status",
    "enum": [
     "idle",
     "working",
     "waiting",
     "error"
    ],
    "type": "string"
   },
   "calendar_id": {
    "description": "Calendar ID to update",
    "type": "string"
   },
   "default_reminders": {
    "anyOf": [
     {
      "items": {
       "maximum": 40320,
       "minimum": 1,
       "type": "integer"
      },
      "maxItems": 5,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Default reminder offsets in minutes; null for system default, [] for none"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Arbitrary metadata (max 16KB)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "New calendar name",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "timezone": {
    "description": "New IANA timezone (e.g. America/New_York)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "calendar_id"
  ],
  "type": "object"
 },
 "name": "update_calendar"
}
