{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Scan project dependencies"
 },
 "description": "Inspect registry dependencies without installing or executing them. Default tree reviews require an npm lockfile packages map; directOnly explicitly narrows scope. Skipped packages or limits make coverage incomplete: retry, never continue. Use after dependency or lockfile changes and before installation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "ai": {
    "default": "off",
    "description": "Optional AI review mode. Heuristic-only scanning is the default.",
    "enum": [
     "off",
     "auto",
     "online",
     "ollama"
    ],
    "type": "string"
   },
   "aiLimit": {
    "default": 3,
    "description": "Maximum triggered AI reviews when AI is explicitly enabled.",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "concurrency": {
    "default": 3,
    "description": "Maximum concurrent heuristic package scans.",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "directOnly": {
    "default": false,
    "description": "Scan only the direct dependencies named in package.json. By default every registry-resolved package in package-lock.json is scanned.",
    "type": "boolean"
   },
   "includeDev": {
    "default": false,
    "description": "Include devDependencies in addition to production and optional dependencies.",
    "type": "boolean"
   },
   "maxPackages": {
    "default": 500,
    "description": "Maximum packages scanned in one project scan.",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "model": {
    "description": "Exact provider model identifier, required for online review. Ollama may use its configured local model. No online model catalog is bundled.",
    "minLength": 1,
    "type": "string"
   },
   "path": {
    "default": ".",
    "description": "Project directory or package.json path, relative to the MCP server working directory or absolute.",
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "default": "auto",
    "description": "AI provider. Credentials are read from environment variables, never tool arguments.",
    "enum": [
     "auto",
     "openai",
     "anthropic",
     "gemini",
     "openrouter",
     "groq",
     "together",
     "custom"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "scan_project",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "coverage": {
    "properties": {
     "complete": {
      "type": "boolean"
     },
     "failed": {
      "minimum": 0,
      "type": "integer"
     },
     "reasons": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "requested": {
      "minimum": 0,
      "type": "integer"
     },
     "scanned": {
      "minimum": 0,
      "type": "integer"
     },
     "scope": {
      "type": "string"
     },
     "skipped": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "scope",
     "complete",
     "requested",
     "scanned",
     "skipped",
     "failed",
     "reasons"
    ],
    "type": "object"
   },
   "decision": {
    "properties": {
     "action": {
      "enum": [
       "continue",
       "review",
       "stop",
       "retry"
      ],
      "type": "string"
     },
     "blocked": {
      "type": "boolean"
     },
     "exitCode": {
      "type": "integer"
     },
     "mayContinue": {
      "type": "boolean"
     },
     "mustStop": {
      "type": "boolean"
     },
     "requiresApproval": {
      "type": "boolean"
     },
     "requiresHumanReview": {
      "type": "boolean"
     },
     "riskScore": {
      "type": [
       "number",
       "null"
      ]
     },
     "verdict": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "verdict",
     "riskScore",
     "action",
     "exitCode",
     "mayContinue",
     "requiresApproval",
     "requiresHumanReview",
     "blocked",
     "mustStop"
    ],
    "type": "object"
   },
   "error": {
    "type": "object"
   },
   "kind": {
    "enum": [
     "package-scan",
     "project-scan",
     "script-approvals",
     "error"
    ],
    "type": "string"
   },
   "report": {
    "type": "object"
   },
   "schemaVersion": {
    "const": 3,
    "type": "integer"
   },
   "status": {
    "enum": [
     "complete",
     "incomplete",
     "error"
    ],
    "type": "string"
   },
   "subject": {
    "type": "object"
   },
   "tool": {
    "properties": {
     "name": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "version"
    ],
    "type": "object"
   }
  },
  "required": [
   "schemaVersion",
   "tool",
   "kind",
   "status",
   "decision",
   "coverage"
  ],
  "type": "object"
 },
 "title": "Scan project dependencies"
}
