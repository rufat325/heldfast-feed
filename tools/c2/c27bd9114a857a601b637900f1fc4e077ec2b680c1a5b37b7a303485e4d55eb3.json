{
 "_meta": {
  "openai/toolInvocation/invoked": "Estimates ready",
  "openai/toolInvocation/invoking": "Estimating premiums\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use this when the user wants premium estimates or carrier options for BOP, GL, WC or commercial_auto and you have the confirmed classification, the business's state, annual revenue and at least one coverage. Returns carriers whose appetite data matches, market budget estimates (not quotes) with sources, assumptions and caveats, and explicit estimateIssues for missing or unsupported inputs. Workers' comp in OH, WA, ND and WY is returned separately in stateFundEstimates; the Ohio figure is an estimate from published BWC rates, not a BWC quote. Omit any value the user did not give; never infer payroll from revenue. Each call saves the inputs and results in BizInsured's records and returns a recommendationId to pass to connect_with_agent; nothing is sent to carriers or agents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "annual_payroll": {
    "description": "Actual annual payroll; never infer from revenue",
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "annual_revenue": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "building_value": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "business_description": {
    "description": "The business activity, as confirmed with classify_business",
    "maxLength": 500,
    "type": "string"
   },
   "business_property_value": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "coverage_limits": {
    "additionalProperties": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "propertyNames": {
     "enum": [
      "BOP",
      "GL",
      "WC",
      "commercial_auto"
     ],
     "type": "string"
    },
    "type": "object"
   },
   "deductibles": {
    "additionalProperties": {
     "maximum": 1000000000000,
     "minimum": 0,
     "type": "number"
    },
    "propertyNames": {
     "enum": [
      "BOP",
      "GL",
      "WC",
      "commercial_auto"
     ],
     "type": "string"
    },
    "type": "object"
   },
   "desired_coverages": {
    "items": {
     "enum": [
      "BOP",
      "GL",
      "WC",
      "commercial_auto"
     ],
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "effective_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "employee_count": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "experience_modifier": {
    "exclusiveMinimum": 0,
    "maximum": 10,
    "type": "number"
   },
   "has_alcohol": {
    "type": "boolean"
   },
   "has_delivery": {
    "type": "boolean"
   },
   "iso_gl_code": {
    "pattern": "^\\d{3,6}$",
    "type": "string"
   },
   "naics_code": {
    "pattern": "^\\d{6}$",
    "type": "string"
   },
   "payroll_by_class": {
    "description": "Actual payroll split by state and workers compensation classification",
    "items": {
     "properties": {
      "class_code": {
       "pattern": "^\\d{1,6}$",
       "type": "string"
      },
      "class_system": {
       "maxLength": 30,
       "minLength": 1,
       "type": "string"
      },
      "payroll": {
       "exclusiveMinimum": 0,
       "maximum": 1000000000000,
       "type": "number"
      },
      "state": {
       "type": "string"
      }
     },
     "required": [
      "state",
      "class_code",
      "payroll"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "prior_losses": {
    "type": "boolean"
   },
   "square_footage": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "state": {
    "description": "Two-letter code of the US state where the business operates",
    "type": "string"
   },
   "vehicle_count": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "years_in_business": {
    "maximum": 300,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "state",
   "annual_revenue",
   "desired_coverages"
  ],
  "type": "object"
 },
 "name": "get_carrier_recommendations",
 "title": "Estimate premiums and match carriers"
}
