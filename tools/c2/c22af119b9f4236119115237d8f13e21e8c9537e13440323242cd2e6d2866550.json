{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find duplicate source strings"
 },
 "description": "Use this when someone wants to clean up a project by finding keys that repeat the same default-language text. Returns up to 25 repeated values with the keys that share them, scanning 1,000 default-locale strings by default and at most 2,000. Not for untranslated strings.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "project": {
    "description": "Project id or name",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "scanLimit": {
    "description": "Default-locale strings to scan, from 1 to 2000; defaults to 1000",
    "exclusiveMinimum": 0,
    "maximum": 2000,
    "type": "integer"
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "name": "find_duplicate_phrase_values",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "defaultLocale": {
    "anyOf": [
     {
      "maxLength": 35,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "duplicateCount": {
    "maximum": 2000,
    "minimum": 0,
    "type": "integer"
   },
   "duplicates": {
    "description": "Up to 25 default-locale values used by more than one key, with up to 10 keys each and the other projects sharing them",
    "items": {
     "additionalProperties": false,
     "properties": {
      "keys": {
       "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 10,
       "type": "array"
      },
      "keysTruncated": {
       "type": "boolean"
      },
      "sharedWith": {
       "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 10,
       "type": "array"
      },
      "sharedWithTruncated": {
       "type": "boolean"
      },
      "value": {
       "maxLength": 500,
       "type": "string"
      },
      "valueTruncated": {
       "type": "boolean"
      }
     },
     "required": [
      "value",
      "valueTruncated",
      "keys",
      "keysTruncated",
      "sharedWith",
      "sharedWithTruncated"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "type": "array"
   },
   "duplicatesTruncated": {
    "type": "boolean"
   },
   "phrasesScanned": {
    "maximum": 2000,
    "minimum": 0,
    "type": "integer"
   },
   "project": {
    "anyOf": [
     {
      "maxLength": 128,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "scanLimit": {
    "exclusiveMinimum": 0,
    "maximum": 2000,
    "type": "integer"
   },
   "scanTruncated": {
    "type": "boolean"
   },
   "status": {
    "enum": [
     "found",
     "none",
     "partial",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "project",
   "defaultLocale",
   "phrasesScanned",
   "scanLimit",
   "scanTruncated",
   "duplicateCount",
   "duplicatesTruncated",
   "duplicates"
  ],
  "type": "object"
 },
 "title": "Find duplicate source strings"
}
