{
 "description": "Navigate to a URL or go back/forward/reload",
 "inputSchema": {
  "properties": {
   "pageId": {
    "description": "Page ID (uses active page if not specified)",
    "type": "string"
   },
   "timeout": {
    "description": "Timeout in milliseconds",
    "type": "number"
   },
   "type": {
    "default": "url",
    "description": "Navigation type",
    "enum": [
     "url",
     "back",
     "forward",
     "reload"
    ],
    "type": "string"
   },
   "url": {
    "description": "URL to navigate to (required for type=\"url\")",
    "type": "string"
   },
   "waitUntil": {
    "default": "load",
    "description": "When to consider navigation complete",
    "enum": [
     "load",
     "domcontentloaded",
     "networkidle"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "navigate_page"
}
