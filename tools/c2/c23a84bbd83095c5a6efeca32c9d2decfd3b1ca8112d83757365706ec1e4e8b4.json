{
 "_meta": {
  "openai/outputTemplate": "ui://widget/career_roadmap.html",
  "openai/strictWidget": true,
  "openai/toolInvocation/invoked": "Roadmap ready.",
  "openai/toolInvocation/invoking": "Building your roadmap\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Career Roadmap (WIDGET). Use this when the user wants a step-by-step plan to move from their current role to a target role. Example: 'I am a receptionist, I want to become a project manager in 12 months'.Example: 'I\u2019m a receptionist, I want to become a project manager in 12 months'.",
 "inputSchema": {
  "properties": {
   "currentRole": {
    "description": "Current role (e.g., 'receptionist', 'barista').",
    "type": "string"
   },
   "dreamRole": {
    "description": "Target role (e.g., 'project manager', 'data analyst').",
    "type": "string"
   },
   "experience": {
    "description": "Experience level (e.g., 'beginner', 'some experience', 'experienced').",
    "type": "string"
   },
   "preferences": {
    "description": "Optional preferences (remote, low stress, no degree, etc.).",
    "type": "string"
   },
   "skills": {
    "description": "Optional skills you already have.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timeframe": {
    "description": "Timeframe (e.g., '6 months', '12 months').",
    "type": "string"
   }
  },
  "required": [
   "dreamRole"
  ],
  "type": "object"
 },
 "name": "career_roadmap"
}
