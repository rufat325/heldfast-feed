{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Verify a signed action against the hosted public record for an agent. Requires a portal-issued API key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actionIndex": {
    "description": "The action index",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "agentId": {
    "description": "The registered agent id",
    "pattern": "^[a-zA-Z0-9_:-]{1,128}$",
    "type": "string"
   },
   "expectedActionEnvelopeHash": {
    "description": "Optional expected action-envelope hash",
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "payload": {
    "description": "The signed action payload"
   },
   "signature": {
    "description": "0x-prefixed 65-byte signature",
    "pattern": "^0x[a-fA-F0-9]{130}$",
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "actionIndex",
   "payload",
   "signature"
  ],
  "type": "object"
 },
 "name": "ae_verify_action",
 "title": "Verify action (hosted record)"
}
