{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Extract any ad-hoc AdSense report. Supply API v2 dimensions, metrics, filters, dates, sorting, and other report parameters. Account is discovered automatically when omitted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account": {
    "description": "Account resource name; optional when one account is accessible.",
    "pattern": "^accounts\\/[^/]+$",
    "type": "string"
   },
   "currencyCode": {
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "dateRange": {
    "description": "Preset date range such as TODAY, YESTERDAY, LAST_7_DAYS, MONTH_TO_DATE, CUSTOM.",
    "type": "string"
   },
   "dimensions": {
    "description": "Report dimensions, e.g. DATE, AD_UNIT_NAME, COUNTRY_NAME.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "endDate": {
    "description": "Custom end date in YYYY-MM-DD.",
    "type": "string"
   },
   "filters": {
    "description": "AdSense filters, e.g. AD_CLIENT_ID==ca-pub-...",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "languageCode": {
    "type": "string"
   },
   "limit": {
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "metrics": {
    "description": "Required metrics, e.g. ESTIMATED_EARNINGS, PAGE_VIEWS, CLICKS.",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "orderBy": {
    "description": "Columns to sort, e.g. -ESTIMATED_EARNINGS.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reportingTimeZone": {
    "description": "ACCOUNT_TIME_ZONE or GOOGLE_TIME_ZONE.",
    "type": "string"
   },
   "startDate": {
    "description": "Custom start date in YYYY-MM-DD.",
    "type": "string"
   }
  },
  "required": [
   "metrics"
  ],
  "type": "object"
 },
 "name": "adsense_generate_report"
}
