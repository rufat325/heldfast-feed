{
 "annotations": {
  "readOnlyHint": true,
  "title": "Customers History"
 },
 "description": "Customer field-change log for growth/churn signals and incremental sync. Returns {history[], pagination}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filter_date_from": {
    "description": "Changes on/after this date (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "filter_date_to": {
    "description": "Changes on/before this date (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "filter_since_id": {
    "description": "Return changes after this history entry ID (incremental sync)",
    "type": "integer"
   },
   "limit": {
    "default": 20,
    "description": "Results per page (max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "minimum": 1,
    "type": "integer"
   },
   "raw": {
    "description": "If true, return the untouched RetailCRM payload (for debugging; verbose).",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "customers_history"
}
