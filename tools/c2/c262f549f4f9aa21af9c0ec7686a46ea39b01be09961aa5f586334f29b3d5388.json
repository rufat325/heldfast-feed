{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Drape one fabric at one warp angle (degrees); return statistics and an exportable result_id.\n\n        Omitted seed is suggested on the surface. Omitted pitch/lock_angle use the\n        fabric preset, including its UD spread/compression settings. pitch/offset\n        are mm; hole_area is mm\u00b2 (null bridges holes). The API may increase pitch\n        to bound the grid; pitch_used reports the actual resolution. Kinematic\n        shear/locking statistics are not a structural strength calculation.\n        ",
 "inputSchema": {
  "properties": {
   "angle": {
    "default": 0,
    "title": "Angle",
    "type": "number"
   },
   "fabric_id": {
    "default": "carbon-twill-3k",
    "title": "Fabric Id",
    "type": "string"
   },
   "hole_area": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Hole Area"
   },
   "lock_angle": {
    "anyOf": [
     {
      "exclusiveMaximum": 90,
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lock Angle"
   },
   "mesh_id": {
    "pattern": "^[A-Za-z0-9_-]{1,80}$",
    "title": "Mesh Id",
    "type": "string"
   },
   "offset": {
    "default": 0,
    "maximum": 50,
    "minimum": -50,
    "title": "Offset",
    "type": "number"
   },
   "pitch": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Pitch"
   },
   "seed": {
    "anyOf": [
     {
      "items": {
       "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Seed"
   },
   "workspace_id": {
    "pattern": "^[0-9a-f]{48}$",
    "title": "Workspace Id",
    "type": "string"
   }
  },
  "required": [
   "workspace_id",
   "mesh_id"
  ],
  "title": "run_drapeArguments",
  "type": "object"
 },
 "name": "run_drape",
 "outputSchema": {
  "additionalProperties": true,
  "title": "run_drapeDictOutput",
  "type": "object"
 }
}
