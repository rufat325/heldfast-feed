{"_meta":{"xdata.kr/credential":{"providers":["hometax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=hometax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: hometax__session__login (\uac19\uc740 account_link_id). candidates \uc5d0\uc11c \uace0\ub978 \uc6d0\ucc9c\uc138 \uc2e0\uace0\uc640 \uc2e0\uccad\uc778 \uc774\ub984, \uc5f0\ub77d\ucc98, \uac1c\uc778\uc815\ubcf4 \ub3d9\uc758\ub97c \uc81c\ucd9c \uc804\uc5d0 \ud655\uc778\ud569\ub2c8\ub2e4. \uc870\ud68c\ub9cc \ud558\uace0 \uae30\uad00\uc5d0 \uc81c\ucd9c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc774\uba74 \uccab \uc694\uccad \uc804\uc5d0 request_idempotency_key \uac12\uc744 \ub9cc\ub4e4\uc5b4 \uc800\uc7a5\ud558\uc138\uc694. \uc751\ub2f5\uc744 \ubc1b\uc9c0 \ubabb\ud55c \uadf8 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c\ub9cc \uac19\uc740 \uc778\uc790\uc640 \ud568\uaed8 \uadf8 \uac12\uc744 \ub2e4\uc2dc \ubcf4\ub0b4\uace0, \uc0c8\ub85c \uc2e4\ud589\ud560 \ub54c\ub294 \uc0c8 \uac12\uc744 \uc4f0\uc138\uc694. \uc774 \uac12 \uc5c6\uc774 \ub2e4\uc2dc \ubd80\ub974\uba74 \uc0c8 \uc694\uccad\uc774 \ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5c6\uc774 \ub9db\ubcf4\uae30\ub85c \ubd80\ub97c \ub54c\ub294 \uc774 \uc120\ud0dd \uce78\uc744 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00 \uc5c5\ubb34\uc5d0 \ub530\ub85c \uc788\ub294 idempotency_key \uce78\uc740 \ub2e4\ub978 \uce78\uc774\ub2c8 \uadf8\ub300\ub85c \ub450\uc138\uc694. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 2\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"applicantName":{"anyOf":[{"maxLength":100,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"\uc0ad\uc81c\uc2e0\uccad\uc5d0 \ud568\uaed8 \uc785\ub825\ud558\ub294 \uc2e0\uccad\uc778 \uc774\ub984\uc785\ub2c8\ub2e4. 1\uc790\uc5d0\uc11c 100\uc790\uae4c\uc9c0\uc774\uace0 \uacf5\ubc31\ub9cc \uc785\ub825\ud558\uba74 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud569\ub2c8\ub2e4. \uc774 \uac12\uc774 \uc5c6\uc73c\uba74 \uc900\ube44 \uacb0\uacfc\uc758 required_inputs \uc5d0 \ube60\uc9c4 \ud56d\ubaa9\uc73c\ub85c \ub098\uc624\uace0 \uadf8 \uacb0\uacfc\ub85c\ub294 \uc81c\ucd9c(submit)\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c, \uac12\uc744 \ucc44\uc6cc \uac19\uc740 \ud6c4\ubcf4 \uc870\ud68c(candidates) \uacb0\uacfc\ub85c prepare \ub97c \ub2e4\uc2dc \ubd80\ub985\ub2c8\ub2e4.","title":"Applicantname"},"applicantPhone":{"anyOf":[{"pattern":"^\\d{9,11}$","type":"string"},{"type":"null"}],"default":null,"description":"\uc2e0\uccad\uc778 \uc5f0\ub77d\ucc98\uc785\ub2c8\ub2e4. \ud558\uc774\ud508 \uc5c6\uc774 \uc22b\uc790 9\uc790\ub9ac\uc5d0\uc11c 11\uc790\ub9ac\ub85c \uc785\ub825\ud558\uba70 \ub2e4\ub978 \ubaa8\uc591\uc774\uba74 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud569\ub2c8\ub2e4. \uc774 \uac12\uc774 \uc5c6\uc73c\uba74 \uc900\ube44 \uacb0\uacfc\uc758 required_inputs \uc5d0 \ube60\uc9c4 \ud56d\ubaa9\uc73c\ub85c \ub098\uc624\uace0 \uadf8 \uacb0\uacfc\ub85c\ub294 \uc81c\ucd9c(submit)\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c, \uac12\uc744 \ucc44\uc6cc \uac19\uc740 \ud6c4\ubcf4 \uc870\ud68c(candidates) \uacb0\uacfc\ub85c prepare \ub97c \ub2e4\uc2dc \ubd80\ub985\ub2c8\ub2e4.","title":"Applicantphone"},"businessNo":{"description":"\uc0ad\uc81c\uc2e0\uccad\ud560 \uc6d0\ucc9c\uc138 \uc2e0\uace0\uc758 \uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638\uc785\ub2c8\ub2e4. \ud558\uc774\ud508 \uc5c6\uc774 \uc22b\uc790 10\uc790\ub9ac\ub85c \uc785\ub825\ud558\uba70 \uc774\uc804 \ub2e8\uacc4 \uc791\uc5c5\uc758 \uc0ac\uc5c5\uc790\uc640 \ub2e4\ub974\uba74 403 \uc73c\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^\\d{10}$","title":"Businessno","type":"string"},"consent":{"default":false,"description":"\uac1c\uc778\uc815\ubcf4 \ub3d9\uc758 \uc5ec\ubd80\uc785\ub2c8\ub2e4. \uc0ac\uc6a9\uc790 \ub3d9\uc758\ub97c \ubc1b\uc558\uc744 \ub54c\ub9cc JSON \ubd88\ub9ac\uc5b8 true \ub85c \uc785\ub825\ud558\uba70 \ubb38\uc790\uc5f4\ub85c \uc4f4 true \ub294 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud558\uace0, false \ub294 \uc785\ub825\ud558\uc9c0 \uc54a\uc740 \uac83\uacfc \uac19\uc2b5\ub2c8\ub2e4. \uc81c\ucd9c\ud560 \ub54c \uc774 \ub3d9\uc758\uac00 \uae30\ub85d\uc73c\ub85c \ub0a8\uc2b5\ub2c8\ub2e4. \uc774 \uac12\uc774 \uc5c6\uc73c\uba74 \uc900\ube44 \uacb0\uacfc\uc758 required_inputs \uc5d0 \ube60\uc9c4 \ud56d\ubaa9\uc73c\ub85c \ub098\uc624\uace0 \uadf8 \uacb0\uacfc\ub85c\ub294 \uc81c\ucd9c(submit)\ud560 \uc218 \uc5c6\uc73c\ubbc0\ub85c, \uac12\uc744 \ucc44\uc6cc \uac19\uc740 \ud6c4\ubcf4 \uc870\ud68c(candidates) \uacb0\uacfc\ub85c prepare \ub97c \ub2e4\uc2dc \ubd80\ub985\ub2c8\ub2e4.","title":"Consent","type":"boolean"},"expectedSnapshotHash":{"description":"sourceJobId \uc791\uc5c5 \uacb0\uacfc\uc758 snapshot_hash \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(\uc18c\ubb38\uc790 16\uc9c4\uc218 64\uc790\ub9ac). \uadf8 \uc791\uc5c5\uc758 \ub0b4\uc6a9\uacfc \ub9de\uc9c0 \uc54a\uc73c\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uc791\uc131 \ub0b4\uc6a9\uc774 \ubc14\ub00c\uc5c8\ub2e4\ub294 \uc624\ub958(409)\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^[0-9a-f]{64}$","title":"Expectedsnapshothash","type":"string"},"originalFilingReference":{"description":"\uc0ad\uc81c\ub97c \uc2e0\uccad\ud560 \uc6d0 \uc2e0\uace0\uc758 \ubbfc\uc6d0 ID \uc785\ub2c8\ub2e4. \ud6c4\ubcf4 \uc870\ud68c(candidates) \uacb0\uacfc candidates \ud56d\ubaa9\uc758 filing_reference \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4. \ube44\uc5b4 \uc788\uc73c\uba74 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud558\uace0, originalReceiptNo \uc640 \ud568\uaed8 \ud6c4\ubcf4 \ud558\ub098\ub85c \uc815\ud574\uc9c0\uc9c0 \uc54a\uc73c\uba74 409 \ub85c \uac70\uc808\ud558\uba70, \uacbd\uc815\uccad\uad6c \uc2e0\uace0\uc11c\ub294 \uc0ad\uc81c\uc2e0\uccad\ud560 \uc218 \uc5c6\uc5b4 \uac70\uc808\ud569\ub2c8\ub2e4. \ud6c4\ubcf4 \uc870\ud68c \ub4a4 \uae30\uad00\uc758 \uc2e0\uace0 \uc815\ubcf4\uac00 \ubc14\ub00c\uc5c8\uc73c\uba74 \uac70\uc808\ud558\ubbc0\ub85c \ud6c4\ubcf4 \uc870\ud68c(candidates)\ubd80\ud130 \ub2e4\uc2dc \ud569\ub2c8\ub2e4.","minLength":1,"title":"Originalfilingreference","type":"string"},"originalReceiptNo":{"description":"\uc0ad\uc81c\ub97c \uc2e0\uccad\ud560 \uc6d0 \uc2e0\uace0\uc758 \uc811\uc218\ubc88\ud638\uc785\ub2c8\ub2e4. originalFilingReference \uc640 \uac19\uc740 \ud6c4\ubcf4 \ud56d\ubaa9\uc758 receipt_no \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud558\uba70 \ube44\uc5b4 \uc788\uc73c\uba74 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","minLength":1,"title":"Originalreceiptno","type":"string"},"receiptJobId":{"anyOf":[{"pattern":"^job_[0-9A-HJKMNP-TV-Z]{26}$","type":"string"},{"type":"null"}],"default":null,"description":"\uc120\ud0dd. \uc6d0 \uc2e0\uace0\uc758 \uc811\uc218 \uacb0\uacfc\uc640 \ub300\uc870\ud560 \ub54c\ub9cc \uc785\ub825\ud569\ub2c8\ub2e4. \uc131\uacf5\ud55c \uc6d0\ucc9c\uc138 \uc804\uc790\ud30c\uc77c \ubcc0\ud658\uc2e0\uace0, \uc218\uc815\uc2e0\uace0, \uae30\ud55c\ud6c4\uc2e0\uace0\uc758 \uc81c\ucd9c \ub610\ub294 \uc811\uc218\uc99d \uc870\ud68c \uc791\uc5c5 ID \uc785\ub2c8\ub2e4. \uc815\uae30\uc2e0\uace0 \uc81c\ucd9c \uc791\uc5c5 ID \ub294 \uc785\ub825\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.","title":"Receiptjobid"},"receiptSnapshotHash":{"anyOf":[{"pattern":"^[0-9a-f]{64}$","type":"string"},{"type":"null"}],"default":null,"description":"\uc120\ud0dd. receiptJobId \ub97c \uc785\ub825\ud560 \ub54c \ud568\uaed8 \uc785\ub825\ud558\ub294 \uadf8 \uc791\uc5c5 \uacb0\uacfc\uc758 \ud574\uc2dc\uc785\ub2c8\ub2e4.","title":"Receiptsnapshothash"},"request_idempotency_key":{"description":"\ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc5d0\uc11c \uc751\ub2f5\uc744 \ubabb \ubc1b\uc740 \uac19\uc740 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c \uc4f0\ub294 \uc120\ud0dd \uac12\uc785\ub2c8\ub2e4. \uc4f0\ub294 \ubc95\uc740 \ub3c4\uad6c \uc124\uba85\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.","maxLength":128,"minLength":1,"pattern":"^[\\x20-\\x7E]+$","type":"string"},"sourceJobId":{"description":"\uc774\uc5b4\uc11c \uc9c4\ud589\ud560 \uc774\uc804 \ub2e8\uacc4 \uc791\uc5c5\uc758 job_id \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(job_ \uc73c\ub85c \uc2dc\uc791\ud558\ub294 \uc791\uc5c5 \ubc88\ud638). \uc0ad\uc81c \ub300\uc0c1 \ud6c4\ubcf4 \uc870\ud68c(candidates) \uacb0\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \uac19\uc740 \uc870\uc9c1\uacfc \ud658\uacbd, \uac19\uc740 \uae30\uad00 \uc5f0\uacb0\uc5d0\uc11c \uc131\uacf5\ud55c \uc6d0\ucc9c\uc138 \uc0ad\uc81c\uc2e0\uccad \uc791\uc5c5\uc774\uc5b4\uc57c \ud558\uace0 \uc544\ub2c8\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uac70\uc808\ud558\uba70, \ubc1b\uc9c0 \uc54a\ub294 \uc0c1\ud0dc\uc758 \uacb0\uacfc\uc774\uba74 409 \ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^job_[0-9A-HJKMNP-TV-Z]{26}$","title":"Sourcejobid","type":"string"},"taxCode":{"const":"14","default":"14","description":"\uc138\ubaa9 \ucf54\ub4dc\uc785\ub2c8\ub2e4. \uc6d0\ucc9c\uc138\ub97c \ub73b\ud558\ub294 14 \ub9cc \ubc1b\uc73c\uba70 \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 14 \uc785\ub2c8\ub2e4.","title":"Taxcode","type":"string"}},"required":["businessNo","sourceJobId","expectedSnapshotHash","originalFilingReference","originalReceiptNo"],"title":"PrepareRequest","type":"object"},"name":"hometax__tax__withholding__delete_request__prepare","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\ud648\ud0dd\uc2a4 \uc6d0\ucc9c\uc138 \uc2e0\uace0 \uc0ad\uc81c\uc2e0\uccad \uc900\ube44"}
