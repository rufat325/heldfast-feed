      "title": "Download Url",
      "type": "string"
     },
     "file_id": {
      "title": "File Id",
      "type": "string"
     },
     "file_name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "File Name"
     },
     "mime_type": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Mime Type"
     }
    },
