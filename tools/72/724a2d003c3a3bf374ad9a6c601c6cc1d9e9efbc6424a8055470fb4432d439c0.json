{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true,"title":"Explain a readiness or posture gap"},"description":"Reads validated answers, either readiness answers for a playbook (answers) or security posture answers (posture, the same shape check_security_posture takes). Deterministic rules name the gap and, for posture, the layer. The explanation is written from the cited record, by the model when available and from the record's own text otherwise. Returns citations and one next step. It never rates an arrangement as safe. First case: the family know where the devices are but not how recovery works if the keyholder is incapacitated ({\"answers\":{\"devicesLocation\":\"yes\",\"recoveryKnown\":\"no\"}}).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"answers":{"properties":{"devicesLocation":{"enum":["yes","no","unsure"],"type":"string"},"recoveryKnown":{"enum":["yes","no","unsure"],"type":"string"},"recoveryTested":{"enum":["yes","no"],"type":"string"}},"required":["devicesLocation","recoveryKnown"],"type":"object"},"playbookId":{"default":"trezor-collaborative-security","enum":["trezor-collaborative-security"],"type":"string"},"posture":{"additionalProperties":false,"properties":{"emailProtected":{"enum":["yes","no","unsure"],"type":"string"},"holding":{"enum":["exchange","single-key","multisig","unsure"],"type":"string"},"passwordManager":{"enum":["yes","no","unsure"],"type":"string"},"rehearsed":{"enum":["yes","no"],"type":"string"},"singleLoss":{"enum":["yes","no","unsure"],"type":"string"},"someoneCanRecover":{"enum":["yes","no","unsure"],"type":"string"}},"required":["emailProtected","passwordManager","holding","singleLoss","someoneCanRecover"],"type":"object"}},"type":"object"},"name":"explain_gap","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"check":{"enum":["playbook