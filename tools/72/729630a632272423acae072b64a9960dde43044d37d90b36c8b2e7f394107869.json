{
 "_meta": {
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "read"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Observe current work"
 },
 "description": "Immediate human-first state: identity, foreground work, changes and pending receipts. Optional facets have bounded coverage; omitted data has a read route.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent": {
    "type": "string"
   },
   "budget_bytes": {
    "default": 6144,
    "maximum": 12288,
    "minimum": 2048,
    "type": "integer"
   },
   "document": {
    "maxLength": 64,
    "type": "string"
   },
   "facets": {
    "items": {
     "enum": [
      "changes",
      "receipts",
      "capabilities",
      "structure",
      "drawing",
      "comments",
      "comparison",
      "history",
      "returns",
      "brief",
      "images",
      "layout",
      "paint"
     ],
     "type": "string"
    },
    "type": "array",
    "uniqueItems": true
   },
   "operation_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "since": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "document"
  ],
  "type": "object"
 },
 "name": "document.observe",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "outcome": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Observe current work"
}
