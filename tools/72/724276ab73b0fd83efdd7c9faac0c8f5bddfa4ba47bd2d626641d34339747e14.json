  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search public Foundaree profiles by free-text query and/or structured filters; give at least one. Free-text matches name, headline, bio, location, skills, experiences and projects. Each result carries `services` (what the person offers with prices), `languages`, `serviceAreas` (areas they cover) and `workingHours` (one entry per day, 24-hour HH:MM) when they gave them, so you can compare before booking. Each result has `updatedAt`, when the person last edited their profile: prefer recent ones when details matter, and say so when a profile is old. Among equally good matches, recently updated profiles rank a little higher. Structured filters: location (substring), area (neighbourhood substring; also matches the areas a person says they cover), language (a language they work in, e.g. Malayalam), workType (exact: local_service = blue-collar, hands-on work; professional = white-collar work), category (comma-separated trades/professions, OR semantics), availability (exact: available, open_to_offers, not_looking, unspecified), skills (comma-separated, AND semantics), lookingFor (comma-separated, AND semantics). Only the first 100 results can be paged through (offset + limit \u2264 100); add filters to narrow the search. Among people who fit equally well, founding members (Foundaree's first 150 members, `foundingMember`) come first; a better match always ranks higher. Returns JSON with a `results` array of structured people summaries. Results never include phone numbers or emails: use get_person for one profile's public contact details. Each answer has two views: the text content is the JSON described above, and the structured content is a profile-card list (`people`, `total`, `query`). In apps that support MCP Apps (ChatGPT, Claude) the cards render as Foundaree profile cards. A person with `foundareeRole` (\"founder\" or \"team\") is part of Foundaree's own team; only Foundaree sets it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "area": {
    "description": "Optional neighbourhood filter within the city (case-insensitive substring), e.g. \"Kakkanad\"",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "availability": {
    "description": "Optional availability filter (exact match)",
    "enum": [
     "available",
     "open_to_offers",
     "not_looking",
     "unspecified"
    ],
    "type": "string"
   },
   "category": {
    "description": "Optional comma-separated trade/profession filter (OR semantics), e.g. \"electrician\" or \"electrician,carpenter\"",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "description": "Optional language they work in (whole name, any case), e.g. \"Malayalam\", \"Tamil\" or \"Hindi\"",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of results. Defaults to 20.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "Optional location filter (case-insensitive substring), e.g. \"Bangalore\" or \"San Francisco\"",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "lookingFor": {
    "description": "Optional comma-separated looking-for filter (AND semantics), e.g. \"cofounder\" or \"job,freelance\"",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset. Defaults to 0. Paging stops after the first 100 results.",
    "maximum": 99,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Optional free-text search query, e.g. \"postgres engineer\" or \"technical co-founder\"",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "skills": {
    "description": "Optional comma-separated skills filter (AND semantics), e.g. \"AI,ML\" or \"React,TypeScript\"",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "workType": {
    "description": "Optional audience filter: local_service = blue-collar jobs, hands-on work (electricians, carpenters, drivers, cleaners, carers...); professional = white-collar jobs, office and professional work (developers, designers, accountants...)",
    "enum": [
     "local_service",
     "professional"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
