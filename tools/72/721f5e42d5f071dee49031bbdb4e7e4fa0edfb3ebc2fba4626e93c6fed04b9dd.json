{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run OCR on a document or specific pages in a collection.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "doBlockSegOnly": {
    "description": "Only do block segmentation (default false)",
    "type": "boolean"
   },
   "docId": {
    "description": "Document ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "id": {
    "description": "Model ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "language": {
    "description": "Language for OCR",
    "type": "string"
   },
   "ocrType": {
    "description": "OCR type (default \"Legacy\")",
    "type": "string"
   },
   "pages": {
    "description": "Page range (e.g. \"1-5\")",
    "type": "string"
   },
   "typeFace": {
    "description": "Type face for OCR",
    "type": "string"
   }
  },
  "required": [
   "collId",
   "docId"
  ],
  "type": "object"
 },
 "name": "transkribus_recog_run_ocr",
 "title": "Run OCR"
}
