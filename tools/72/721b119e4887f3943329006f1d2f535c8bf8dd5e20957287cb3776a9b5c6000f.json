{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Get an MPP challenge or pay an existing MPP PDF, letter, workflow-form order, or bulk letter campaign after buyer approval. Use the order_id returned by any draft tool with payment_protocol=mpp or by create_machine_order. When switching from create_machine_order, omit the credential first to get this payment endpoint\u2019s challenge. Review the preview or campaign_url, recipient count and total. No document or addresses are resubmitted. Without payment_authorization this only returns a challenge; with it, this can pay and send real mail. Reuse the same order_id on retries and follow the returned payment status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "order_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "payment_authorization": {
    "description": "Buyer-approved MPP Authorization header, usually Payment ... . Omit to retrieve the challenge.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "order_id"
  ],
  "type": "object"
 },
 "name": "postalform.pay_order",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bulk": {
    "additionalProperties": false,
    "properties": {
     "campaign_id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "content_mode": {
      "enum": [
       "text",
       "html",
       "pdf"
      ],
      "type": "string"
     },
     "recipient_count": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "status": {
      "type": "string"
     },
     "status_counts": {
      "additionalProperties": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "required": [
     "campaign_id",
     "recipient_count",
     "content_mode",
     "status",
     "status_counts"
    ],
    "type": "object"
   },
   "campaign_url": {
    "format": "uri",
    "type": "string"
   },
   "checkout_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "currency": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "endpoint": {
    "format": "uri",
    "type": "string"
   },
   "is_paid": {
    "type": "boolean"
   },
   "mailpiece_type": {
    "enum": [
     "letter",
     "postcard"
    ],
    "type": "string"
   },
   "next_action": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "order_complete_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "order_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "page_count": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "payment": {},
   "payment_options": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "type": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "payment_status": {
    "type": "string"
   },
   "postcard_size": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "preview_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "price_usd": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "protocol": {
    "enum": [
     "mpp",
     "x402"
    ],
    "type": "string"
   },
   "request_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "status_url": {
    "format": "uri",
    "type": "string"
   },
   "view": {
    "const": "machine_order",
    "type": "string"
   }
  },
  "required": [
   "view",
   "protocol",
   "order_id",
   "request_id",
   "endpoint",
   "status",
   "payment_status",
   "is_paid",
   "price_usd",
   "currency",
   "mailpiece_type",
   "postcard_size",
   "order_complete_url"
  ],
  "type": "object"
 },
 "title": "Pay a prepared order with MPP"
}
