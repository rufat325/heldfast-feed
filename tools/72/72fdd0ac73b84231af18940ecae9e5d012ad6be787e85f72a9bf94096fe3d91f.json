{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Rechercher des \u00e9v\u00e9nements"
 },
 "description": "\u00c9v\u00e9nements publi\u00e9s et actifs de l\u2019agenda NLocale, avec leurs occurrences. Les tarifs renseign\u00e9s ne constituent pas un devis.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "categorie": {
    "maxLength": 120,
    "type": "string"
   },
   "commune": {
    "maxLength": 120,
    "type": "string"
   },
   "date_debut": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_fin": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "gratuit": {
    "type": "boolean"
   },
   "langue": {
    "default": "fr",
    "enum": [
     "fr",
     "en",
     "de",
     "nl",
     "it",
     "es"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "periode": {
    "default": "a_venir",
    "enum": [
     "a_venir",
     "archives",
     "tous"
    ],
    "type": "string"
   },
   "query": {
    "maxLength": 160,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "rechercher_evenements",
 "title": "Rechercher des \u00e9v\u00e9nements"
}
