{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Retrieve metadata for one DeepSeek Files API image by `file_id`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "file_id": {
    "pattern": "^file-api-[a-zA-Z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "file_id"
  ],
  "type": "object"
 },
 "name": "retrieve_file",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "bytes": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "created_at": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "error_type": {
    "enum": [
     "deepseek_api_error",
     "tool_execution_error"
    ],
    "type": "string"
   },
   "expires_at": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "filename": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "object": {
    "const": "file",
    "type": "string"
   },
   "purpose": {
    "const": "user_data",
    "type": "string"
   },
   "retryable": {
    "type": "boolean"
   },
   "status": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "suggestion": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
