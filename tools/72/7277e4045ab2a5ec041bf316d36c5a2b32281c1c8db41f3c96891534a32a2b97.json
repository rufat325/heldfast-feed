{
 "description": "Run the Charter cost and the ownership crossover calculator: Hours actually billed; Hourly charges; Estimated total for this trip; Effective cost per flight hour. Missing inputs fall back to their documented defaults.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "annualHrs": {
    "default": 50,
    "description": "Hours you fly a year",
    "type": "number"
   },
   "fees": {
    "default": 1500,
    "description": "Landing, handling and airport fees",
    "type": "number"
   },
   "flightHrs": {
    "default": 4,
    "description": "Flight hours for the trip",
    "type": "number"
   },
   "fuelPct": {
    "default": 8,
    "description": "Fuel surcharge (%)",
    "type": "number"
   },
   "hourly": {
    "default": 5500,
    "description": "Quoted hourly rate",
    "type": "number"
   },
   "overnight": {
    "default": 0,
    "description": "Crew overnight and duty charges",
    "type": "number"
   },
   "ownFixed": {
    "default": 900000,
    "description": "Annual fixed cost of owning a comparable aircraft",
    "type": "number"
   },
   "ownVar": {
    "default": 3200,
    "description": "Variable cost per hour of owning",
    "type": "number"
   },
   "posHrs": {
    "default": 2,
    "description": "Positioning hours billed",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "calculate",
 "title": "Charter cost and the ownership crossover"
}
