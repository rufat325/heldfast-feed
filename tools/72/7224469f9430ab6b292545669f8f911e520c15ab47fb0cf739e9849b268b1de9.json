{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List geolint audit rules (id, category, severity, title, description).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "only show this category",
    "enum": [
     "ai-crawler",
     "llms-txt",
     "schema",
     "content",
     "technical"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_rules",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "rules": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warn",
        "info"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "category",
      "severity",
      "title",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "rules"
  ],
  "type": "object"
 }
}
