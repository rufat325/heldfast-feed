{"_meta":{"openai/toolInvocation/invoked":"\u05e2\u05de\u05d5\u05d3 \u05d4\u05de\u05db\u05e8\u05d6\u05d9\u05dd \u05e0\u05d8\u05e2\u05df","openai/toolInvocation/invoking":"\u05d8\u05d5\u05e2\u05df \u05e2\u05de\u05d5\u05d3 \u05de\u05db\u05e8\u05d6\u05d9\u05dd \u05de-Tendy","openai/widgetAccessible":false,"securitySchemes":[{"scopes":["tenders:read"],"type":"oauth2"}],"ui":{"visibility":["model"]}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"One public Tendy hub page in a single answer: the tenders of a category, of a publishing body, of an Israeli region, or all government or all municipal tenders. Returns the page's direct answer, counts as of today (shown, and with a known future deadline), aggregate facts computed over at least 10 tenders new in the last month, links to related hub pages, and up to 10 tenders per page as the public page lists them, each with a link and the publisher as a group such as \u05e8\u05e9\u05d5\u05ea \u05de\u05e7\u05d5\u05de\u05d9\u05ea \u05d1\u05e6\u05e4\u05d5\u05df. Fits overview questions: how many tenders a field or a body has, what the government is buying, what typical guarantees look like. For free text, combined filters, deadline windows or supplier size, search_tenders fits better; for one tender's full details, get_tender. The key comes from list_collections or list_categories; a Hebrew category or body name also works.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"key":{"description":"For category, publisher and region: the category slug or Hebrew name, the publishing body slug or Hebrew name, or the region name, as list_collections lists them. Not used for government and municipal.","maxLength":80,"minLength":1,"type":"string"},"kind":{"description":"category (what is being bought), publisher (one publishing body), region (an Israeli district), government (all government bodies) or municipal (all local authorities).","enum":["category","publisher","region","government","municipal"],"type":"string"},"page":{"default":1,"description":"Result page, from 1.","maximum":50,"minimum":1,"type":"integer"}},"required":["kind"],"type":"object"},"name":"browse_collection","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"notice":{"anyOf":[{"additionalProperties":false,"properties":{"code":{"const":"plan_required","type":"string"},"info_url":{"format":"uri","type":"string"}},"required":["code","info_url"],"type":"object"},{"type":"null"}]},"result":{"anyOf":[{"additionalProperties":false,"properties":{"answer":{"type":["string","null"]},"as_of":{"type":"string"},"closed_only":{"type":"boolean"},"counts":{"additionalProperties":false,"properties":{"shown":{"type":"number"},"with_future_deadline":{"type":"number"}},"required":["shown","with_future_deadline"],"type":"object"},"facts":{"anyOf":[{"additionalProperties":false,"properties":{"heading":{"type":"string"},"lines":{"items":{"type":"string"},"type":"array"},"note":{"type":["string","null"]},"provenance":{"type":"string"}},"required":["heading","provenance","lines","note"],"type":"object"},{"type":"null"}]},"key":{"type":"string"},"kind":{"enum":["category","publisher","region","government","municipal"],"type":"string"},"next_page":{"type":["number","null"]},"page":{"type":"number"},"recent_closed":{"items":{"additionalProperties":false,"properties":{"availability":{"enum":["future_deadline","unknown"],"type":"string"},"deadline":{"type":["string","null"]},"published":{"type":["string","null"]},"publisher_label":{"type":"string"},"region":{"type":["string","null"]},"teaser":{"type":"string"},"title":{"type":"string"},"url":{"format":"uri","type":"string"}},"required":["url","title","publisher_label","teaser","region","published","deadline","availability"],"type":"object"},"type":"array"},"related":{"items":{"additionalProperties":false,"properties":{"heading":{"type":