{
 "description": "List pull requests for a GitHub repository with filtering options",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "base": {
    "description": "Filter by base branch",
    "type": "string"
   },
   "direction": {
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "head": {
    "description": "Filter by head branch (format: user:branch)",
    "type": "string"
   },
   "owner": {
    "description": "Repository owner (username or organization)",
    "minLength": 1,
    "type": "string"
   },
   "page": {
    "description": "Page number",
    "minimum": 1,
    "type": "number"
   },
   "per_page": {
    "description": "Results per page (max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "repo": {
    "description": "Repository name",
    "minLength": 1,
    "type": "string"
   },
   "sort": {
    "description": "Sort field",
    "enum": [
     "created",
     "updated",
     "popularity",
     "long-running"
    ],
    "type": "string"
   },
   "state": {
    "description": "Filter by PR state",
    "enum": [
     "open",
     "closed",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo"
  ],
  "type": "object"
 },
 "name": "github_pr_list"
}
