{
 "description": "Execute a shell command on the Android device. Returns stdout and stderr.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "command": {
    "description": "Shell command to execute on the device",
    "type": "string"
   },
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "timeout": {
    "description": "Timeout in milliseconds (1s-10min)",
    "maximum": 600000,
    "minimum": 1000,
    "type": "number"
   }
  },
  "required": [
   "command"
  ],
  "type": "object"
 },
 "name": "adb_shell"
}
