{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the status and synthetic result of a sandbox job created with create_sandbox_job. Every well-formed jobId resolves as completed, so a result is not proof that the key was created.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "jobId": {
    "description": "jobId returned by create_sandbox_job.",
    "pattern": "^sbx_[0-9a-f]{16}$",
    "type": "string"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "get_sandbox_job",
 "outputSchema": {
  "anyOf": [
   {
    "properties": {
     "jobId": {
      "pattern": "^sbx_[0-9a-f]{16}$",
      "type": "string"
     },
     "result": {
      "properties": {
       "data": {
        "additionalProperties": false,
        "properties": {
         "advertiser": {
          "type": "string"
         },
         "canonicalUrl": {
          "format": "uri",
          "type": "string"
         },
         "contentType": {
          "enum": [
           "paid_advertisement",
           "house_advertisement"
          ],
          "type": "string"
         },
         "day": {
          "description": "Settled auction date in UTC, YYYY-MM-DD.",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
         },
         "description": {
          "type": "string"
         },
         "headline": {
          "type": "string"
         }
        },
        "required": [
         "day",
         "headline",
         "description",
         "advertiser",
         "canonicalUrl",
         "contentType"
        ],
        "type": "object"
       },
       "sandbox": {
        "const": true
       }
      },
      "required": [
       "sandbox",
       "data"
      ],
      "type": "object"
     },
     "sandbox": {
      "const": true
     },
     "status": {
      "enum": [
       "queued",
       "completed"
      ],
      "type": "string"
     },
     "statusUrl": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "sandbox",
     "jobId",
     "status",
     "statusUrl"
    ],
    "type": "object"
   },
   {
    "properties": {
     "detail": {
      "type": "string"
     },
     "docs": {
      "format": "uri",
      "type": "string"
     },
     "status": {
      "type": "integer"
     },
     "title": {
      "type": "string"
     },
     "type": {
      "type": "string"
     }
    },
    "required": [
     "type",
     "title",
     "status",
     "detail"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Get sandbox job"
}
