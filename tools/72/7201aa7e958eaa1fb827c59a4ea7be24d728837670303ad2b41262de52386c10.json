{
 "description": "Archive (soft-delete) a storyline. Pass confirm: true to proceed. Use storyline_restore to reverse this.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brandId": {
    "description": "Brand ID (defaults to active brand)",
    "type": "string"
   },
   "confirm": {
    "const": true,
    "description": "Must be true to confirm archiving",
    "type": "boolean"
   },
   "storylineId": {
    "description": "Storyline ID to archive",
    "type": "string"
   }
  },
  "required": [
   "storylineId",
   "confirm"
  ],
  "type": "object"
 },
 "name": "storyline_delete"
}
