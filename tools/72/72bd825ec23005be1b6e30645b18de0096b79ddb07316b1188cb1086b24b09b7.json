{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "veterical:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find free appointment slots"
 },
 "description": "Use this when someone asks when their vet clinic has free appointment slots or openings. Returns the open online-booking slots per day for one clinic: how many, plus the first start and last end time. Covers the next days that have openings, up to 14 days and 100 slots (no pet, owner or medical data). Not for booking an appointment.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clinicId": {
    "description": "Clinic id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "clinicId"
  ],
  "type": "object"
 },
 "name": "get_clinic_availability",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "One row per day that has open online-booking slots, in date order. Unassigned capacity only; appointments, animals, owners, staff and clinical data are never included.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "day": {
       "anyOf": [
        {
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "firstStartTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastEndTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "slotCount": {
       "maximum": 100,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "day",
      "slotCount",
      "firstStartTime",
      "lastEndTime"
     ],
     "type": "object"
    },
    "maxItems": 14,
    "type": "array"
   },
   "slotCount": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "slotCountIsLowerBound": {
    "description": "True when more open slots exist beyond the 14-day, 100-slot cap",
    "type": "boolean"
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "slotCount",
   "slotCountIsLowerBound",
   "days"
  ],
  "type": "object"
 },
 "title": "Find free appointment slots"
}
