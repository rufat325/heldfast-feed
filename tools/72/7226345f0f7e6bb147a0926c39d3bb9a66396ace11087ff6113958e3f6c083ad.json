      "minimum": 0,
      "type": "integer"
     },
     "inputTrackedSeconds": {
      "minimum": 0,
      "type": "integer"
     },
     "manualSeconds": {
      "minimum": 0,
      "type": "integer"
     },
     "trackedSeconds": {
      "minimum": 0,
      "type": "integer"
     },
     "workers": {
      "minimum": 0,
      "type": "integer"
     },
     "workersWithActivity": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
