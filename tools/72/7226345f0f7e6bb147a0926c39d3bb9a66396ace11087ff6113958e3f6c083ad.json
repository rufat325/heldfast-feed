         "billableSeconds": {
          "minimum": 0,
          "type": "integer"
         },
         "date": {
          "minLength": 1,
          "type": "string"
         },
         "inputTrackedSeconds": {
          "minimum": 0,
          "type": "integer"
         },
         "manualSeconds": {
          "minimum": 0,
          "type": "integer"
         },
         "trackedSeconds": {
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
