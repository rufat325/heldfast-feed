     "externalProjectId",
     "status",
     "lastSyncStartedAt",
     "lastSyncCompletedAt",
     "lastSyncStatus",
     "freshness"
    ],
    "type": "object"
   },
   "timezone": {
    "const": "UTC",
    "type": "string"
   },
   "to": {
    "minLength": 1,
    "type": "string"
   },
   "workers": {
    "items": {
