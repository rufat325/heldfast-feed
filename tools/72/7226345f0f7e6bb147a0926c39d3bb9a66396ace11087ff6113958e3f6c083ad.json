          "periodStart": {
           "minLength": 1,
           "type": "string"
          },
          "periodStop": {
           "minLength": 1,
           "type": "string"
          },
          "status": {
           "minLength": 1,
           "type": "string"
          },
          "trackedSeconds": {
           "minimum": 0,
           "type": "integer"
          },
          "updatedAt": {
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "status",
          "periodStart",
          "periodStop",
          "trackedSeconds",
          "inputTrackedSeconds",
          "activityPct",
          "updatedAt"
         ],
         "type": "object"
        },
        {
         "type": "null"
