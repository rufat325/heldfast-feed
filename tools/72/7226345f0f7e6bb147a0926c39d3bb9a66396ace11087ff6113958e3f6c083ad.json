{
 "description": "Employer-side provider (Hubstaff) time reconciliation for one job: per-worker enrollment state, tracked/manual/billable totals, daily rollups, latest approval, and source sync freshness. pageTotals cover the returned cursor page only, so summing every page is safe. Optional contractId drill-down and contractStatus ACTIVE|ENDED cohort filter (ENDED = closed OR endDate <= now). Requires time:read plus provider-authorized job access (owner or provider-access-authorized member); denials read as non-enumerating 404s. Never returns screenshots, window titles, or memos.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contractId": {
    "$ref": "#/properties/jobId"
   },
   "contractStatus": {
    "enum": [
     "ACTIVE",
     "ENDED"
    ],
    "type": "string"
   },
   "cursor": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "from": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "jobId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "to": {
    "$ref": "#/properties/from"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "opentrain_get_job_time_reconciliation",
