       "country",
       "registration"
      ],
      "type": "object"
     },
     "slug": {
      "enum": [
       "european-company-dossier",
       "tender-company-dossier"
      ],
      "type": "string"
     }
    },
    "required": [
     "slug",
     "input"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
