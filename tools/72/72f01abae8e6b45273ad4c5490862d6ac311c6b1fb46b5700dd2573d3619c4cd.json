{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Use Hermes-owned skills, connected services, browser workflows, messaging, schedules, or external automation through bridge policy. Effective execute requests require interactive client confirmation. Do not use for ordinary local code edits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "contextFiles": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dryRun": {
    "type": "boolean"
   },
   "maxTurns": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "mode": {
    "enum": [
     "plan",
     "draft",
     "execute",
     "request-approval"
    ],
    "type": "string"
   },
   "model": {
    "type": "string"
   },
   "preset": {
    "type": "string"
   },
   "prompt": {
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "type": "string"
   },
   "timeoutSeconds": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "yolo": {
    "type": "boolean"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "hermes_run",
 "title": "Delegate a request to Hermes"
}
