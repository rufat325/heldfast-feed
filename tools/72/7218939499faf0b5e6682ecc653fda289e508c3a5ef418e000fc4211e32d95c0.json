{
 "description": "Run Android instrumented tests (androidTest) via `am instrument` and capture results. Returns structured pass/fail output.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "runner": {
    "default": "androidx.test.runner.AndroidJUnitRunner",
    "description": "Test runner class (default: AndroidX JUnit runner)",
    "type": "string"
   },
   "testClass": {
    "description": "Specific test class to run (optional)",
    "type": "string"
   },
   "testMethod": {
    "description": "Specific test method (requires testClass)",
    "type": "string"
   },
   "testPackage": {
    "description": "Test package (e.g., 'com.example.app.test')",
    "type": "string"
   },
   "timeout": {
    "default": 300000,
    "description": "Timeout in ms (10s-10min, default 5 min)",
    "maximum": 600000,
    "minimum": 10000,
    "type": "number"
   }
  },
  "required": [
   "testPackage"
  ],
  "type": "object"
 },
 "name": "adb_ci_run_tests"
}
