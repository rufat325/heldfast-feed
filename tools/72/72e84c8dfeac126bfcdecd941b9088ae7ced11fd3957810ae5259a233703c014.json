{
 "description": "Step 3 of the workbench loop: export a proven blueprint's geometry as STL (ASCII) or OBJ text for 3D printing / CAD. Run this after anvil.solve reports all proof metrics passing.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "blueprint": {
    "additionalProperties": true,
    "description": "Anvil blueprint: a schematic graph for one domain.",
    "properties": {
     "description": {
      "type": "string"
     },
     "domain": {
      "enum": [
       "silicon",
       "cellular",
       "quantum",
       "neural",
       "mechanical",
       "chemistry",
       "architecture",
       "metallurgy",
       "robotics",
       "machines",
       "optics",
       "sky"
      ],
      "type": "string"
     },
     "edges": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "from": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "params": {
         "additionalProperties": {
          "type": "number"
         },
         "type": "object"
        },
        "to": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "nodes": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "id": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "params": {
         "additionalProperties": {
          "type": "number"
         },
         "type": "object"
        },
        "x": {
         "type": "number"
        },
        "y": {
         "type": "number"
        },
        "z": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "notes": {
      "type": "string"
     },
     "scale": {
      "description": "meters per schematic unit",
      "type": "number"
     },
     "skin": {
      "additionalProperties": true,
      "type": "object"
     }
    },
    "type": "object"
   },
   "format": {
    "default": "stl",
    "enum": [
     "stl",
     "obj"
    ],
    "type": "string"
   }
  },
  "required": [
   "blueprint",
   "format"
  ],
  "type": "object"
 },
 "name": "anvil.export"
}
