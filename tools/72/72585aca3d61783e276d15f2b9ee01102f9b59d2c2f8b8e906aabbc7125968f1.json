  "properties": {
   "league": {
    "description": "League key from list_leagues, e.g. 'premier' (England), 'spain1', 'brazil1', 'sweden1', 'wgermany1' (women). Not the display name.",
    "type": "string"
   }
  },
  "required": [
   "league"
  ],
  "type": "object"
 },
 "name": "get_season_projection",
