{
 "description": "Get stocks ranked by net institutional buy or sell flow in the latest quarter. `direction` is \"buy\" or \"sell\".",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "direction": {
    "default": "buy",
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_stock_flows",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "result": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "avg_weight_pct": {
       "type": [
        "number",
        "null"
       ]
      },
      "cusip": {
       "type": "string"
      },
      "institution_count": {
       "type": "number"
      },
      "issuer_name": {
       "type": "string"
      },
      "net_value_change_usd": {
       "type": "number"
      },
      "ticker": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "cusip",
      "ticker",
      "issuer_name",
      "net_value_change_usd",
      "avg_weight_pct",
      "institution_count"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
