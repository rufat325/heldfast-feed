{
 "_meta": {
  "opentrain.ai/authoring-retry": {
   "allowedRetryAction": "Inspect current page and tree first. Report convergence only with the exact target identity and all reviewed result fingerprints. Otherwise obtain a fresh preflight and explicitly confirm it. Do not resend a timed-out write blindly.",
   "automaticRetry": false,
   "identityFields": [
    "folderId",
    "pageId",
    "expectedChecksum",
    "reviewedTreeChecksum",
    "reviewedResultFingerprint"
   ],
   "inspect": [
    {
     "method": "GET",
     "path": "/api/public/v1/instructions/folders/{folderId}/pages/{pageId}"
    },
    {
     "method": "GET",
     "path": "/api/public/v1/instructions/folders/{folderId}/pages"
    }
   ],
   "keyRequirement": "NO_CLIENT_KEY",
   "missingResourceBehavior": "UNKNOWN_NOT_SUCCESS",
   "policy": "SIGNED_PREFLIGHT_INSPECTION",
   "schemaVersion": "folder-instruction-authoring-retry/1",
   "staleStateBehavior": "Changed identity/checksum/tree or unavailable comparison evidence requires a fresh reviewed preflight. An archive 404 is not proof of archival.",
   "stateActions": {
    "CHANGED": "FRESH_REVIEWED_PREFLIGHT_REQUIRED",
    "EXACT_REVIEWED_RESULT": "REPORT_VERIFIED_CONVERGENCE",
    "NOT_FOUND": "UNKNOWN_NOT_SUCCESS",
    "UNKNOWN": "INSPECT_DO_NOT_REPEAT"
   }
  }
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Archive the reviewed page and its children. Removing the last folder page does not resurrect archived job guidance. Requires current employer folder access. Empty destinations require reviewed activation; published/unknown delivery writes refuse without changing release/read/ack flags. Requires instructions:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folderId": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "pageId": {
    "$ref": "#/properties/folderId"
   },
   "request": {
    "additionalProperties": false,
    "properties": {
     "confirmArchive": {
      "const": true,
      "type": "boolean"
     },
     "confirmLive": {
      "const": true,
      "type": "boolean"
     },
     "preflightToken": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "preflightToken",
     "confirmArchive",
     "confirmLive"
    ],
    "type": "object"
   }
  },
  "required": [
   "folderId",
   "pageId",
   "request"
  ],
  "type": "object"
 },
 "name": "opentrain_folder_instructions_archive_page",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "archivedPageId": {
      "$ref": "#/properties/result/properties/location/properties/folderId"
     },
     "location": {
      "additionalProperties": false,
      "properties": {
       "canonicalSource": {
        "const": "FOLDER_INSTRUCTION_SET",
        "type": "string"
       },
       "employerUrl": {
        "type": "string"
       },
       "folderId": {
        "pattern": "^[A-Za-z0-9._:-]{1,128}$",
        "type": "string"
       },
       "instructionSetId": {
        "anyOf": [
         {
          "$ref": "#/properties/result/properties/location/properties/folderId"
         },
         {
          "type": "null"
         }
        ]
       },
       "managedAt": {
        "const": "FOLDER",
        "type": "string"
       },
       "writeLockedReason": {
        "type": "null"
       }
      },
      "required": [
       "canonicalSource",
       "folderId",
       "employerUrl",
       "instructionSetId",
       "managedAt",
       "writeLockedReason"
      ],
      "type": "object"
     },
     "ok": {
      "const": true,
      "type": "boolean"
     }
    },
    "required": [
     "ok",
     "location",
     "archivedPageId"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
