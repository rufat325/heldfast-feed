    "type": "string"
   },
   "max_risk": {
    "description": "Only consider offers graded at or below this letter: A (lower risk), B (moderate), C (elevated), D (higher).",
    "enum": [
     "A",
     "B",
     "C",
     "D"
    ],
    "type": "string"
   },
   "stablecoin": {
    "description": "Set to \"true\" to return only stablecoin assets.",
    "enum": [
     "true",
     "false"
    ],
    "type": "string"
   }
