      "asset": {
       "type": "string"
      },
      "best_apy": {
       "type": "number"
      },
      "best_platform": {
       "type": "string"
      },
      "offer_count": {
       "type": "integer"
      },
      "peg_price": {
       "description": "For a stablecoin: the live price of the dollar the best yield is paid in (1 = on its $1 peg). Null when unpriced or not a stablecoin.",
