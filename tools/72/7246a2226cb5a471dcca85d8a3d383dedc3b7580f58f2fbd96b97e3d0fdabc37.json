{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "After the human explicitly agrees to pay for a selected website service, prepare the secure checkout. Checkout creation is not payment proof.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "business_name": {
    "maxLength": 180,
    "minLength": 1,
    "type": "string"
   },
   "current_website": {
    "maxLength": 300,
    "type": "string"
   },
   "customer_email": {
    "format": "email",
    "maxLength": 200,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "customer_name": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "customer_phone": {
    "maxLength": 60,
    "type": "string"
   },
   "project_brief": {
    "maxLength": 3000,
    "minLength": 20,
    "type": "string"
   },
   "service_plan": {
    "enum": [
     "human_finished",
     "premium_custom",
     "total_launch"
    ],
    "type": "string"
   },
   "user_confirmed_payment": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "user_confirmed_payment",
   "service_plan",
   "customer_name",
   "customer_email",
   "business_name",
   "project_brief"
  ],
  "type": "object"
 },
 "name": "prepare_website_service_checkout",
 "title": "Prepare a human-confirmed Evercraft website service checkout"
}
