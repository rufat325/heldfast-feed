{
 "description": "Test an API endpoint with expected status code validation and optional JSON field checks. Shows PASS/FAIL for each check.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "expected_fields": {
    "default": [],
    "description": "Dot-notation JSON field paths expected in response (e.g. 'data.id')",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "expected_status": {
    "default": 200,
    "description": "Expected HTTP status code",
    "type": "number"
   },
   "method": {
    "default": "GET",
    "description": "HTTP method",
    "enum": [
     "GET",
     "POST",
     "PUT",
     "DELETE"
    ],
    "type": "string"
   },
   "url": {
    "description": "Endpoint URL to test",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "test_endpoint"
}
