{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store a feature or timeline statement the user has explicitly approved. The statement is the only wording that can later pass evaluate_commitment. Do not save a date or a feature the user did not approve.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deskId": {
    "format": "uuid",
    "type": "string"
   },
   "expectedRevision": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "kind": {
    "enum": [
     "FEATURE",
     "TIMELINE"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "statement": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "default": "APPROVED",
    "enum": [
     "APPROVED",
     "RETIRED"
    ],
    "type": "string"
   }
  },
  "required": [
   "deskId",
   "kind",
   "name",
   "statement"
  ],
  "type": "object"
 },
 "name": "save_approved_commitment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "save approved commitment"
}
