{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create expense"
 },
 "description": "Create a new expense. Requires expenses:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "description": "Expense amount (required)",
    "minimum": 0,
    "type": "number"
   },
   "category_id": {
    "description": "Cost category ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "description": {
    "description": "Expense description (required)",
    "minLength": 1,
    "type": "string"
   },
   "expense_date": {
    "description": "Expense date (ISO 8601, required)",
    "type": "string"
   },
   "notes": {
    "description": "Notes",
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "receipt_url": {
    "description": "Receipt URL",
    "maxLength": 2000,
    "type": "string"
   },
   "work_order_id": {
    "description": "Work order ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "description",
   "amount",
   "expense_date"
  ],
  "type": "object"
 },
 "name": "create_expense",
 "title": "Create expense"
}
