      "description": "Optional. The resource name of the asset this was copied from, if any. Format: assets/{asset} Tracks the fork history of assets.",
      "type": "string"
     },
     "designSystem": {
      "$ref": "#/$defs/DesignSystem",
      "description": "Optional. The design system."
     },
