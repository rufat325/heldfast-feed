     "m"
    ],
    "type": "string"
   },
   "width": {
    "description": "Rectangle width in selected unit",
    "exclusiveMinimum": 0,
    "maximum": 1000000.0,
    "type": "number"
   }
  },
  "required": [
   "shape",
   "depthInches"
  ],
  "type": "object"
 },
 "name": "mulch_calculator",
