     "length",
     "width"
    ]
   },
   {
    "properties": {
     "shape": {
      "enum": [
       "circle"
      ],
      "type": "string"
     }
    },
    "required": [
     "diameter"
    ]
   },
   {
    "properties": {
     "shape": {
      "enum": [
       "area"
      ],
      "type": "string"
     }
    },
    "required": [
     "area"
    ]
   }
  ],
  "properties": {
