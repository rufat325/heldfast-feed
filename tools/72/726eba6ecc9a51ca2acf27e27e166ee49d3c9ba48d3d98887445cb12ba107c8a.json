{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "rag",
 "description": "Format few-shot examples for LLM prompts. Converts example pairs into formatted blocks. Supports chat format (User/Assistant), XML tags, Markdown, or plain text.",
 "inputSchema": {
  "properties": {
   "examples": {
    "description": "Array of {input, output} pairs",
    "items": {
     "properties": {
      "input": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "output": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "format": {
    "description": "Output format (default: chat)",
    "enum": [
     "chat",
     "xml",
     "markdown",
     "plain"
    ],
    "type": "string"
   },
   "input_label": {
    "description": "Label for input (default: User / <input>)",
    "type": "string"
   },
   "output_label": {
    "description": "Label for output (default: Assistant / <output>)",
    "type": "string"
   }
  },
  "required": [
   "examples"
  ],
  "type": "object"
 },
 "name": "few_shot_formatter",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "example_count": {
    "type": "number"
   },
   "format": {},
   "formatted": {},
   "token_estimate": {
    "type": "number"
   }
  },
  "type": "object"
 }
}
