{"_meta":{"openai/fileParams":["image_file"],"openai/outputTemplate":"ui://widget/within-shelf.html","openai/toolInvocation/invoked":"Matched the photograph to the shelves","openai/toolInvocation/invoking":"Looking at the photograph","openai/widgetAccessible":true},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Find it from a photograph"},"description":"Pieces on the boutiques' shelves that resemble a photograph: a screenshot, a street style shot, a product photo, or a TikTok or Pinterest link. Answers in two tiers: pieces close enough to be the same or a near twin, and pieces in the same spirit. Use this when a shopper shares an image of something they want to find or 'something like this'. Pass image_url for a direct image, image_base64 with media_type for an uploaded file, or post_url for a TikTok or Pinterest link. Photographs are matched in memory and never stored. Do not use for Instagram links; they cannot be read, so ask for a screenshot instead.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"image_base64":{"description":"The image bytes, base64 encoded (under 1.5 MB decoded).","maxLength":2000000,"type":"string"},"image_file":{"description":"A photograph the shopper uploaded in the chat; the host passes the file here.","properties":{"download_url":{"maxLength":4000,"type":"string"},"file_id":{"type":"string"},"file_name":{"type":"string"},"mime_type":{"type":"string"}},"required":["download_url"],"type":"object"},"image_url":{"description":"A direct, publicly reachable JPEG, PNG or WebP URL (under 1.5 MB).","maxLength":2000,"type":"string"},"media_type":{"description":"Required with image_base64.","enum":["image/jpeg","image/png","image/webp"],"type":"string"},"post_url":{"description":"A TikTok or Pinterest post link; the photograph is read from the post.","maxLength":500,"type":"string"}},"type":"object"},"name":"vis