{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Invite yourself or one/many users to an instance. Users may be usr_ ids or exact display names. Destination is here=true, a full location like \"wrld_:instance\", or worldId+instanceId. A bare instanceId is not accepted: VRChat needs the worldId and rejects the stripped form.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "continueOnError": {
    "type": "boolean"
   },
   "dryRun": {
    "type": "boolean"
   },
   "here": {
    "type": "boolean"
   },
   "instanceId": {
    "type": "string"
   },
   "location": {
    "minLength": 1,
    "type": "string"
   },
   "message": {
    "minLength": 1,
    "type": "string"
   },
   "overwriteMessageSlot": {
    "maximum": 11,
    "minimum": 0,
    "type": "integer"
   },
   "retry": {
    "properties": {
     "baseDelayMs": {
      "maximum": 60000,
      "minimum": 0,
      "type": "integer"
     },
     "maxAttempts": {
      "maximum": 8,
      "minimum": 1,
      "type": "integer"
     },
     "maxDelayMs": {
      "maximum": 120000,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "self": {
    "type": "boolean"
   },
   "user": {
    "minLength": 1,
    "type": "string"
   },
   "users": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "worldId": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vrchat_invite",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "continueOnError": {
    "type": "boolean"
   },
   "destination": {
    "additionalProperties": false,
    "properties": {
     "instanceId": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "here",
       "location",
       "world_instance",
       "instance"
      ],
      "type": "string"
     },
     "location": {
      "type": "string"
     },
     "worldId": {
      "type": "string"
     }
    },
    "required": [
     "kind"
    ],
    "type": "object"
   },
   "dryRun": {
    "type": "boolean"
   },
   "failed": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "message": {
    "additionalProperties": false,
    "properties": {
     "matchedExisting": {
      "type": "boolean"
     },
     "overwrittenSlot": {
      "maximum": 11,
      "minimum": 0,
      "type": "integer"
     },
     "requested": {
      "type": "string"
     },
     "slot": {
      "maximum": 11,
      "minimum": 0,
      "type": "integer"
     },
     "wouldOverwriteSlot": {
      "maximum": 11,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attempts": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "data": {},
      "displayName": {
       "type": "string"
      },
      "error": {
       "type": "string"
      },
      "notification": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "status": {
       "enum": [
        "sent",
        "failed",
        "skipped",
        "would_send"
       ],
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "userId": {
       "type": "string"
      }
     },
     "required": [
      "target",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sent": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "skipped": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "enum": [
     "completed",
     "dry_run"
    ],
    "type": "string"
   },
   "stoppedAfterFailure": {
    "type": "boolean"
   },
   "totalTargets": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "status",
   "dryRun",
   "continueOnError",
   "totalTargets",
   "sent",
   "failed",
   "skipped",
   "results",
   "destination"
  ],
  "type": "object"
 }
}
