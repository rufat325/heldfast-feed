{
 "description": "Record a paper-only trade in Polyrama. This tool never submits a live order. Requires write:paper scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "botId": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "marketQuestion": {
    "type": "string"
   },
   "price": {
    "exclusiveMaximum": 1,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "side": {
    "enum": [
     "BUY",
     "SELL"
    ],
    "type": "string"
   },
   "size": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "strategy": {
    "default": "mcp",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "tokenId": {
    "minLength": 10,
    "type": "string"
   }
  },
  "required": [
   "botId",
   "tokenId",
   "side",
   "price",
   "size"
  ],
  "type": "object"
 },
 "name": "polyrama_place_paper_order"
}
