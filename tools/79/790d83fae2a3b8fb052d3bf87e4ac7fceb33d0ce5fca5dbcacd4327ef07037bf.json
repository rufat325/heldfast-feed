    "default": 300,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "raw_body",
   "timestamp",
   "signature",
   "secret"
  ],
  "type": "object"
 },
 "name": "monapay_verify_signature",
