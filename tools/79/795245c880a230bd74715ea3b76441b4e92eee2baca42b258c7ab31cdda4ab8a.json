{
 "description": "Prints the words of one bundled theme, optionally filtered by length, shuffled by --seed, and limited by --count. Useful as input for generators or other tools.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Maximum number of words",
    "type": [
     "string",
     "number"
    ]
   },
   "maxLength": {
    "description": "Maximum word length",
    "type": [
     "string",
     "number"
    ]
   },
   "minLength": {
    "description": "Minimum word length",
    "type": [
     "string",
     "number"
    ]
   },
   "seed": {
    "description": "Shuffle deterministically before applying --count",
    "type": [
     "string",
     "number"
    ]
   },
   "theme": {
    "description": "Theme id, e.g. animals/ocean-animals",
    "type": "string"
   }
  },
  "required": [
   "theme"
  ],
  "type": "object"
 },
 "name": "words_list",
 "title": "words list"
}
