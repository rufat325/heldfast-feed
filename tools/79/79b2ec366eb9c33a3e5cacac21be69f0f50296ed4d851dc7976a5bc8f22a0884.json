{
 "description": "Get TWROR (time-weighted rate of return) timeseries for the portfolio over a date range. Use this to answer 'how did my portfolio perform this year / last 5 years?'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountIds": {
    "description": "Depot ID(s) to include",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "endDate": {
    "description": "End date (yyyy-MM-dd), defaults to today",
    "type": "string"
   },
   "interval": {
    "default": "month",
    "enum": [
     "day",
     "week",
     "month",
     "year"
    ],
    "type": "string"
   },
   "startDate": {
    "description": "Start date (yyyy-MM-dd)",
    "type": "string"
   }
  },
  "required": [
   "accountIds",
   "startDate"
  ],
  "type": "object"
 },
 "name": "get_portfolio_performance"
}
