{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read side of Auto. Free. method=list browses queries, method=get polls one query and returns its latest evaluation, method=executions and method=execution show what fired, method=sessions and method=session return the LLM analysis attached to a query. There is no push channel here, poll with method=get and respect pollAfterSeconds.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "executionId": {
    "description": "Required for method=execution.",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Page size for list style methods.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "method": {
    "description": "Which read to perform.",
    "enum": [
     "list",
     "get",
     "executions",
     "execution",
     "sessions",
     "session"
    ],
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset.",
    "minimum": 0,
    "type": "integer"
   },
   "queryId": {
    "description": "Required for get, sessions and session.",
    "type": "string"
   },
   "search": {
    "description": "Free text filter for method=list.",
    "type": "string"
   },
   "sessionId": {
    "description": "Required for method=session.",
    "type": "string"
   },
   "status": {
    "description": "Filter by status.",
    "type": "string"
   },
   "type": {
    "description": "Filter executions by type.",
    "type": "string"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "auto_query",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {},
   "method": {
    "type": "string"
   },
   "pollAfterSeconds": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "required": [
   "method",
   "pollAfterSeconds"
  ],
  "type": "object"
 },
 "title": "Read Auto queries"
}
