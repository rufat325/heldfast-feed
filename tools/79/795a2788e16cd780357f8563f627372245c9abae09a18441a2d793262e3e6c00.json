{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Ask the market in plain English"
 },
 "description": "Answer one plain-English sentence about the domain market. A listings question ('short .com under $500 that accepts offers') returns matching for-sale listings; a sales question ('4-letter .com sold since 2020') is routed to the recorded sales and returns rows, total and stats as search_recorded_sales does, with interpretation.source set to recorded-sales. Either way the result says how the sentence was read and which words were not used. Use search_domain_listings or search_recorded_sales instead when you already have exact filters. Deterministic and offline: it calls no model. Read-only and runs no appraisal.",
 "inputSchema": {
  "properties": {
   "question": {
    "description": "The search as a sentence, up to 300 characters, for example: short .com under $500 that accepts offers.",
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "question"
  ],
  "type": "object"
 },
 "name": "ask_domain_market",
 "outputSchema": {
  "description": "Two outcomes. Listings: listings, count, total, nextOffset, generatedAt. Recorded sales (a question about what names sold for): rows, population, stats, exploreUrl, citation, citeAs, and total, with interpretation.source recorded-sales.",
  "properties": {
   "citation": {
    "type": "string"
   },
   "citeAs": {
    "description": "Same citation object as search_recorded_sales.",
    "type": "object"
   },
   "count": {
    "type": "integer"
   },
   "exploreUrl": {
    "type": "string"
   },
   "generatedAt": {
    "type": "string"
   },
   "interpretation": {
    "properties": {
     "ignored": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "length": {
      "properties": {
       "exact": {
        "type": "boolean"
       },
       "n": {
        "type": "integer"
       }
      },
      "type": "object"
     },
     "params": {
      "description": "Listings outcome only.",
      "type": "object"
     },
     "rowsFilteredToLength": {
      "properties": {
       "appliesTo": {
        "type": "string"
       },
       "characters": {
        "type": "integer"
       },
       "exact": {
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "sales": {
      "properties": {
       "yearFrom": {
        "type": "number"
       },
       "yearTo": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "searchUrl": {
      "description": "Listings outcome only.",
      "type": "string"
     },
     "source": {
      "description": "Present only when answered from recorded sales.",
      "enum": [
       "recorded-sales"
      ],
      "type": "string"
     },
     "understood": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "understood",
     "ignored"
    ],
    "type": "object"
   },
   "listings": {
    "description": "Same fields as search_domain_listings.",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "nextOffset": {
    "type": [
     "integer",
     "null"
    ]
   },
   "population": {
    "enum": [
     "corpus",
     "sample"
    ],
    "type": "string"
   },
   "rows": {
    "items": {
     "properties": {
      "category": {
       "type": [
        "string",
        "null"
       ]
      },
      "domain": {
       "type": "string"
      },
      "price": {
       "type": "number"
      },
      "saleDate": {
       "type": "string"
      },
      "venue": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "domain",
      "price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "stats": {
    "description": "Rounded; not exact sale prices.",
    "properties": {
     "highest": {
      "type": "number"
     },
     "median": {
      "type": "number"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "total",
   "interpretation"
  ],
  "type": "object"
 },
 "title": "Ask the market in plain English"
}
