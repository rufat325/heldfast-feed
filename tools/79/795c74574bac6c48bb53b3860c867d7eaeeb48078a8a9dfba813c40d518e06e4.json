{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Adaptive TDEE"
 },
 "description": "Measure actual TDEE from a logged history of daily weight and/or calorie intake. Default method (kalman) is a joint Kalman filter over true weight and TDEE \u2014 handles missing days, gates outliers, and reports uncertainty (CI95) alongside denoised true weight; regression/endpoints are simple window-based estimates kept for comparison. Use instead of formula TDEE once real logged data exists. Each entry needs at least one of weight/kcal (not necessarily both). Entry dates must span 10 years or less (earliest to latest). Note: all methods need at least one weigh-in (kalman) or two (regression/endpoints) \u2014 a history with zero weight entries throws under the kalman default; pass methods:'all' to get a graceful empty/skipped result instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "kcal": {
       "exclusiveMinimum": 0,
       "maximum": 20000,
       "type": "number"
      },
      "weight": {
       "additionalProperties": false,
       "properties": {
        "unit": {
         "default": "kg",
         "enum": [
          "kg",
          "lb"
         ],
         "type": "string"
        },
        "value": {
         "exclusiveMinimum": 0,
         "type": "number"
        }
       },
       "required": [
        "value"
       ],
       "type": "object"
      }
     },
     "required": [
      "date"
     ],
     "type": "object"
    },
    "maxItems": 400,
    "minItems": 10,
    "type": "array"
   },
   "methods": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "string"
     }
    ],
    "default": "kalman"
   },
   "prior_tdee_kcal": {
    "description": "Optional starting TDEE estimate, e.g. from the tdee tool; speeds early convergence.",
    "maximum": 10000,
    "minimum": 500,
    "type": "number"
   },
   "window_days": {
    "default": 7,
    "maximum": 14,
    "minimum": 3,
    "type": "integer"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 },
 "name": "adaptive-tdee",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "consensus": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "max": {
        "type": "number"
       },
       "mean": {
        "type": "number"
       },
       "median": {
        "type": "number"
       },
       "min": {
        "type": "number"
       },
       "n": {
        "type": "integer"
       }
      },
      "required": [
       "mean",
       "median",
       "min",
       "max",
       "n"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "anyOf": [
        {
         "additionalProperties": {},
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "method": {
       "type": "string"
      },
      "unit": {
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "method",
      "value",
      "unit"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "skipped": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "method": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "method",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "consensus",
   "skipped"
  ],
  "type": "object"
 },
 "title": "Adaptive TDEE"
}
