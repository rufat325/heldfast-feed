{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add a stage to a hiring pipeline"
 },
 "description": "Append (or insert at a position) a stage to a pipeline with a kind and optional approval scope.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approval_scope": {
    "anyOf": [
     {
      "enum": [
       "applications:offer",
       "applications:hire",
       "applications:reject",
       "applications:withdraw"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "is_terminal": {
    "type": "boolean"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "pipeline_id": {
    "minLength": 1,
    "type": "string"
   },
   "position": {
    "minimum": 1,
    "type": "integer"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "pattern": "^[a-z0-9][a-z0-9_]{0,62}$",
    "type": "string"
   },
   "stage_kind": {
    "enum": [
     "normal",
     "offer",
     "hired",
     "rejected",
     "terminal"
    ],
    "type": "string"
   }
  },
  "required": [
   "pipeline_id",
   "name",
   "slug",
   "stage_kind"
  ],
  "type": "object"
 },
 "name": "yardstick_pipelines_stages_create",
 "title": "Add a stage to a hiring pipeline"
}
