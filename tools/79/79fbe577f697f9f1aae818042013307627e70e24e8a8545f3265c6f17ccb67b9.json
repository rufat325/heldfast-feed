{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 },
 "description": "Book up to 500 transactions to the same chart-of-accounts account in one call, by full account path (e.g. \"expenses/meals-and-entertainment\"). Returns how many applied plus per-transaction failures. Use this instead of calling transaction_categorize_transaction_by_account in a loop. The booking is recorded as Lovie Agent's proposal and changes nothing until the person accepts it, so tell them it is waiting for their review. Returns proposal_ids, one proposal per transaction. List valid paths with accounting_get_chart_of_accounts.",
 "inputSchema": {
  "properties": {
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "glAccountPath": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*$",
    "type": "string"
   },
   "transactionIds": {
    "items": {
     "description": "UUID value wrapper.",
     "properties": {
      "value": {
       "format": "uuid",
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "name": "transaction_batch_categorize_transactions_by_account",
 "outputSchema": {
  "properties": {
   "failures": {
    "items": {
     "properties": {
      "message": {
       "type": "string"
      },
      "transactionId": {
       "anyOf": [
        {
         "description": "UUID value wrapper.",
         "properties": {
          "value": {
           "format": "uuid",
           "type": "string"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "glAccountPath": {
    "type": "string"
   },
   "proposalIds": {
    "items": {
     "description": "UUID value wrapper.",
     "properties": {
      "value": {
       "format": "uuid",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "reportedWarning": {
    "type": "string"
   },
   "undoId": {
    "anyOf": [
     {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "updatedCount": {
    "type": "integer"
   }
  },
  "type": "object"
 },
 "title": "Batch Categorize Transactions By Account"
}
