{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":true,"title":"Search Funding Rounds"},"description":"Search funding rounds (venture rounds, debt, grants, IPOs), newest announcement first. Costs $0.02 per record returned, after 100 free records a month; a search that matches nothing is free. Page with `cursor`: pass back `next_cursor` exactly as returned; a null `next_cursor` means there are no more matches. Narrow with filters before raising `limit`.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"company":{"description":"Company name contains this text (case-insensitive).","maxLength":100,"minLength":1,"type":"string"},"country":{"description":"Headquarters country, case-insensitive.","maxLength":60,"minLength":1,"type":"string"},"cursor":{"description":"Opaque cursor from the previous page's `next_cursor`.","maxLength":200,"type":"string"},"domain":{"description":"Exact company domain, for example `example.com`.","maxLength":253,"minLength":3,"type":"string"},"investor":{"description":"Exact investor name, case-insensitive.","maxLength":100,"minLength":1,"type":"string"},"limit":{"description":"Records per page, 1 to 100 (default 25). Each record returned is billed.","maximum":100,"minimum":1,"type":"integer"},"max_amount_usd":{"description":"Largest round size in USD.","maximum":999999999999999,"minimum":0,"type":"number"},"min_amount_usd":{"description":"Smallest round size in USD.","maximum":999999999999999,"minimum":0,"type":"number"},"round":{"description":"Comma-separated round stages, for example `seed,series_a,series_b`.","type":"string"},"since":{"description":"Earliest announcement date, inclusive (YYYY-MM-DD).","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"until":{"description":"Latest announcement date, inclusive (YYYY-MM-DD).","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"}},"type":"object"},"name":"funding_search","