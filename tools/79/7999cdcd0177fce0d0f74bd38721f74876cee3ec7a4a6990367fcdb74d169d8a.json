{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "The hirer funds the order through escrow-lite using caller-signed principal authorization. Only confirmed principal funding moves an open order to funded. Escrow principal is the hirer's order value, separate from the API access fee. POST /api/workorder-fund. Paid URL: 0.10 USDC per call on Base mainnet using x402 exact, under the existing shared 10 signed-wallet free calls over rolling 30 days. Every call requires X-Wever-Wallet-Proof bound to the exact JSON arguments and this API path, including paid calls. Order value is capped at 25.00 USDC under the existing escrow-lite rail; API access fees and escrow principal are separate. Normal states are open, funded, accepted, delivered and released. Disputed orders freeze release and retain an expiry refund path; expired funded orders refund only the hirer. No private keys are accepted, no arbitrary payee or payer substitution is allowed, and the adapter grants no authority. Read /api/workorder-contract for schemas, recovery and evidence bounds. Live funded acceptance remains a manual operator step.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "funding_payment": {
    "oneOf": [
     {
      "type": "null"
     },
     {
      "additionalProperties": false,
      "properties": {
       "accepted": {
        "additionalProperties": false,
        "properties": {
         "amount": {
          "pattern": "^(0|[1-9][0-9]{0,77})(?![\\s\\S])",
          "type": "string"
         },
         "asset": {
          "const": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
         },
         "extra": {
          "additionalProperties": false,
          "properties": {
           "name": {
            "const": "USD Coin"
           },
           "version": {
            "const": "2"
           }
          },
          "required": [
           "name",
           "version"
          ],
          "type": "object"
         },
         "maxTimeoutSeconds": {
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
         },
         "network": {
          "const": "eip155:8453"
         },
         "payTo": {
          "pattern": "^0x[0-9a-fA-F]{40}(?![\\s\\S])",
          "type": "string"
         },
         "scheme": {
          "const": "exact"
         }
        },
        "required": [
         "scheme",
         "network",
         "asset",
         "amount",
         "payTo",
         "maxTimeoutSeconds",
         "extra"
        ],
        "type": "object"
       },
       "payload": {
        "additionalProperties": false,
        "properties": {
         "authorization": {
          "additionalProperties": false,
          "properties": {
           "from": {
            "pattern": "^0x[0-9a-fA-F]{40}(?![\\s\\S])",
            "type": "string"
           },
           "nonce": {
            "pattern": "^0x[0-9a-fA-F]{64}(?![\\s\\S])",
            "type": "string"
           },
           "to": {
            "pattern": "^0x[0-9a-fA-F]{40}(?![\\s\\S])",
            "type": "string"
           },
           "validAfter": {
            "pattern": "^(0|[1-9][0-9]{0,77})(?![\\s\\S])",
            "type": "string"
           },
           "validBefore": {
            "pattern": "^(0|[1-9][0-9]{0,77})(?![\\s\\S])",
            "type": "string"
           },
           "value": {
            "pattern": "^(0|[1-9][0-9]{0,77})(?![\\s\\S])",
            "type": "string"
           }
          },
          "required": [
           "from",
           "to",
           "value",
           "validAfter",
           "validBefore",
           "nonce"
          ],
          "type": "object"
         },
         "signature": {
          "pattern": "^0x[0-9a-fA-F]{130}(?![\\s\\S])",
          "type": "string"
         }
        },
        "required": [
         "signature",
         "authorization"
        ],
        "type": "object"
       },
       "resource": {
        "additionalProperties": false,
        "properties": {
         "description": {
          "maxLength": 256,
          "type": "string"
         },
         "mimeType": {
          "const": "application/json"
         },
         "url": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "url",
         "description",
         "mimeType"
        ],
        "type": "object"
       },
       "x402Version": {
        "const": 2
       }
      },
      "required": [
       "x402Version",
       "resource",
       "accepted",
       "payload"
      ],
      "type": "object"
     }
    ]
   },
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+(?![\\s\\S])",
    "type": "string"
   },
   "order_id": {
    "pattern": "^wo_[a-f0-9]{64}(?![\\s\\S])",
    "type": "string"
   },
   "payer_terms_signature": {
    "pattern": "^0x[0-9a-fA-F]{130}(?![\\s\\S])",
    "type": "string"
   }
  },
  "required": [
   "order_id",
   "idempotency_key",
   "payer_terms_signature",
   "funding_payment"
  ],
  "type": "object"
 },
 "name": "wever_workorder-fund",
 "title": "Fund work order"
}
