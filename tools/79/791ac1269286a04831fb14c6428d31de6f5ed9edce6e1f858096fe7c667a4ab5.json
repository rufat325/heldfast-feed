{"_meta":{"securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Use this when the user asks to change a tailored resume: exact text edits, additions or removals based on what the user said, or the template, palette, font or density. Creates a new revision from the latest operationId, without AI or another adaptation; earlier revisions stay available to undo. For content edits, userRequest must quote the user's request; never add a fact the user did not state. Do not use to tailor the resume to another job; use create_tailored_resume.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"appearance":{"additionalProperties":false,"properties":{"density":{"enum":["compact","normal","airy"],"type":"string"},"fonts":{"maxLength":40,"type":"string"},"palette":{"maxLength":40,"type":"string"},"tplFonts":{"maxLength":40,"type":"string"},"tplPalette":{"maxLength":40,"type":"string"}},"type":"object"},"edits":{"items":{"additionalProperties":false,"properties":{"action":{"enum":["set","remove"],"type":"string"},"path":{"description":"CvData field, e.g. summary, experiences.0.bullets.1, contact.email. An index equal to the list length appends to the list.","maxLength":150,"minLength":1,"type":"string"},"value":{}},"required":["path","action"],"type":"object"},"maxItems":30,"type":"array"},"guestToken":{"maxLength":100,"minLength":40,"pattern":"^[A-Za-z0-9_-]+$","type":"string"},"operationId":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"templateId":{"enum":["classique","studio","technique","timeline","editorial","sidebar","banniere","masthead","swiss","luxe","academic","portrait","cover","gallery","noir","ledger","spotlight","hero","edition"