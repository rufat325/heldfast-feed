{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Search used cars for sale in India. All filters optional. Returns total count, listings (title, price in INR, year, kms, fuel, transmission, city, image, url) and a search_page_url with the full results.","inputSchema":{"additionalProperties":false,"properties":{"city":{"description":"City, locality or state, e.g. \"Pune\", \"Koramangala, Bangalore\", \"Kerala\". Spelling mistakes are tolerated; check place_match in the result to see what was matched. Omit for all of India.","type":"string"},"fuel":{"enum":["petrol","diesel","cng","electric","lpg"],"type":"string"},"limit":{"description":"Results to return (default 20).","maximum":50,"minimum":1,"type":"integer"},"make":{"description":"Brand, e.g. \"Hyundai\", \"Maruti Suzuki\", \"Mercedes-Benz\".","type":"string"},"max_kms":{"description":"Maximum kilometres driven.","type":"integer"},"max_price":{"description":"Maximum price in INR (e.g. 1000000 = 10 lakh).","type":"integer"},"max_year":{"description":"Newest model year.","type":"integer"},"min_price":{"description":"Minimum price in INR (e.g. 300000 = 3 lakh).","type":"integer"},"min_year":{"description":"Oldest model year, e.g. 2018.","type":"integer"},"model":{"description":"Model, e.g. \"Creta\", \"Swift\", \"Innova Crysta\".","type":"string"},"offset":{"description":"Pagination offset.","minimum":0,"type":"integer"},"sort":{"description":"Default newest.","enum":["newest","price_asc","price_desc","year_desc"],"type":"string"},"transmission":{"enum":["manual","automatic"],"type":"string"}},"type":"object"},"name":"search_used_cars","title":"Search used cars in India"}
