       "items": {
        "additionalProperties": true,
        "properties": {
         "id": {
          "description": "The line item GID.",
          "type": "string"
         },
         "quantity": {
          "type": "integer"
         }
        },
        "required": [
         "id",
         "quantity"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "occurred_at": {
       "description": "RFC 3339 timestamp.",
       "type": "string"
      },
      "status": {
       "enum": [
        "pending",
        "completed",
        "failed"
       ],
       "type": "string"
      },
      "totals": {
       "description": "Monetary totals in minor currency units.",
       "items": {
        "additionalProperties": true,
        "properties": {
         "amount": {
          "description": "The amount in minor currency units. Discount totals are negative.",
          "type": "integer"
         },
         "display_text": {
          "description": "Buyer-facing label for the total.",
          "type": "string"
         },
         "type": {
          "description": "Cost category. Well-known values: subtotal, items_discount, discount, fulfillment, tax, fee, total. Businesses may use additional values, which always carry `display_text` (Shopify emits `duty`).",
