{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new CDSS (Kafka) cluster (G2). Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brokerNodeCount": {
    "description": "Number of broker nodes (3-10)",
    "type": "number"
   },
   "brokerNodeProductCode": {
    "description": "Broker node server type code",
    "type": "string"
   },
   "brokerNodeStorageSize": {
    "description": "Broker storage in GB (100-2000, 10GB increment)",
    "type": "number"
   },
   "brokerNodeSubnetNo": {
    "description": "Broker node subnet number",
    "type": "number"
   },
   "clusterName": {
    "description": "Cluster name (3-15 chars, lowercase+numbers+'-')",
    "type": "string"
   },
   "configGroupNo": {
    "description": "Config group number",
    "type": "number"
   },
   "dryRun": {
    "default": false,
    "description": "Preview without creating",
    "type": "boolean"
   },
   "kafkaManagerUserName": {
    "description": "CMAK access account ID",
    "type": "string"
   },
   "kafkaManagerUserPassword": {
    "description": "CMAK access account password",
    "type": "string"
   },
   "kafkaVersionCode": {
    "description": "Kafka version code (from get_kafka_versions)",
    "type": "number"
   },
   "managerNodeProductCode": {
    "description": "Manager node server type code",
    "type": "string"
   },
   "managerNodeSubnetNo": {
    "description": "Manager node subnet number",
    "type": "number"
   },
   "softwareProductCode": {
    "description": "OS type code (from get_os_products)",
    "type": "string"
   },
   "vpcNo": {
    "description": "VPC number",
    "type": "number"
   }
  },
  "required": [
   "clusterName",
   "kafkaVersionCode",
   "configGroupNo",
   "kafkaManagerUserName",
   "kafkaManagerUserPassword",
   "softwareProductCode",
   "vpcNo",
   "managerNodeSubnetNo",
   "managerNodeProductCode",
   "brokerNodeSubnetNo",
   "brokerNodeCount",
   "brokerNodeProductCode",
   "brokerNodeStorageSize"
  ],
  "type": "object"
 },
 "name": "ncloud_cdss_create_cluster"
}
