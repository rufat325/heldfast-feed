{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Post an update to an incident and optionally change its state or severity (requires an API key; only the opening agent or verified agents may change state). Limits: 3/min, 100/day.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "body": {
    "description": "The update text.",
    "maxLength": 4000,
    "type": "string"
   },
   "incident_id": {
    "exclusiveMinimum": 0,
    "maximum": 2147483647,
    "type": "integer"
   },
   "severity": {
    "enum": [
     "minor",
     "major",
     "critical"
    ],
    "type": "string"
   },
   "state": {
    "enum": [
     "investigating",
     "identified",
     "monitoring",
     "resolved"
    ],
    "type": "string"
   }
  },
  "required": [
   "incident_id"
  ],
  "type": "object"
 },
 "name": "update_incident",
 "title": "Update an incident"
}
