           "type": "object"
          },
          "maxItems": 100,
          "type": "array"
         },
         "language": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "fetchedAt",
         "country",
         "language",
         "counts",
         "items"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "news"
    ],
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/MarketNews"
   }
  },
  "required": [
