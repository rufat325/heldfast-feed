  "permission": "none",
  "readOnlyHint": true
 },
 "description": "Read a market's recent news headlines (last 7 days, newest first): title, link to the publisher, outlet, label (official, wire, local) and the market terms each title matched. Titles and links only. Research, not advice.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "Checksummed or lowercase 20-byte EVM address (0x + 40 hex).",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "chainId": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "problee_get_market_news",
 "outputSchema": {
  "$defs": {
   "MarketNews": {
    "additionalProperties": false,
    "properties": {
     "news": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "country": {
          "type": [
           "string",
           "null"
          ]
         },
         "counts": {
          "additionalProperties": false,
          "properties": {
           "all": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
           },
           "international": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
           },
           "last24h": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
           },
           "local": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
           },
           "official": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
           }
          },
          "required": [
           "all",
           "official",
           "local",
           "international",
           "last24h"
          ],
          "type": "object"
         },
         "fetchedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
         },
         "items": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "host": {
             "type": "string"
            },
            "label": {
             "anyOf": [
              {
               "enum": [
                "official",
                "wire",
                "local"
               ],
               "type": "string"
              },
              {
               "type": "null"
              }
             ]
            },
            "language": {
             "type": [
              "string",
              "null"
             ]
            },
            "matched": {
             "items": {
              "type": "string"
             },
             "maxItems": 3,
             "minItems": 1,
             "type": "array"
            },
            "moreOutlets": {
             "maximum": 9007199254740991,
             "minimum": 0,
             "type": "integer"
            },
            "outlet": {
             "type": "string"
            },
            "publishedAt": {
             "format": "date-time",
             "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
             "type": "string"
            },
            "scope": {
             "enum": [
              "official",
              "local",
              "international"
             ],
             "type": "string"
            },
            "title": {
             "type": "string"
            },
            "url": {
             "format": "uri",
             "maxLength": 2048,
             "type": "string"
            }
           },
           "required": [
            "url",
            "title",
            "outlet",
            "host",
            "publishedAt",
            "language",
            "label",
            "scope",
            "moreOutlets",
            "matched"
