{
 "annotations": {
  "audience": [
   "user",
   "assistant"
  ],
  "openWorldHint": true,
  "priority": 0.5,
  "title": "Create Chat Message"
 },
 "description": "Post a new message to a chat channel. Requires channel_id or channel_name + content.",
 "inputSchema": {
  "properties": {
   "channel_id": {
    "description": "Channel ID (preferred).",
    "type": "string"
   },
   "channel_name": {
    "description": "Channel name (auto-resolved).",
    "type": "string"
   },
   "content": {
    "description": "Message content (Markdown supported). Required.",
    "type": "string"
   },
   "notify_all": {
    "description": "Notify all channel members.",
    "type": "boolean"
   },
   "post_title": {
    "description": "Title for post type.",
    "type": "string"
   },
   "subtype_id": {
    "description": "Subtype ID for post type.",
    "type": "string"
   },
   "subtype_name": {
    "description": "Subtype name (e.g. 'Announcement'). Auto-resolved to ID.",
    "type": "string"
   },
   "team_id": {
    "description": "The ClickUp Team ID or Workspace Name to use. If provided, the server will switch to this workspace for this and subsequent requests in the current session.",
    "type": "string"
   },
   "type": {
    "default": "message",
    "description": "Message type.",
    "enum": [
     "message",
     "post"
    ],
    "type": "string"
   }
  },
  "required": [
   "channel_id",
   "content"
  ],
  "type": "object"
 },
 "name": "create_chat_message"
}
