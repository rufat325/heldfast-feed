{
 "_meta": {
  "openai/outputTemplate": "ui://imagelato/project-overview-v1.html",
  "openai/toolInvocation/invoked": "Imagelato project overview ready.",
  "openai/toolInvocation/invoking": "Loading Imagelato project\u2026",
  "ui": {
   "resourceUri": "ui://imagelato/project-overview-v1.html"
  },
  "ui/resourceUri": "ui://imagelato/project-overview-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show image project overview"
 },
 "description": "Use this when someone wants a quick visual overview of one Imagelato project and its latest processed images. Returns a card with the project's name, logo and dates plus its 8 most recently processed batches with format, size and first-party links. Not for every batch in the project.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "projectIdOrName": {
    "description": "Exact project id or name, at most 200 characters",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectIdOrName"
  ],
  "type": "object"
 },
 "name": "show_project_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "batchCount": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "batchCountIsLowerBound": {
    "type": "boolean"
   },
   "batches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "format": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "maxLength": 200,
       "type": "string"
      },
      "size": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "slug": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "templateId": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "slug",
      "url",
      "format",
      "size",
      "templateId",
      "created"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "type": "array"
   },
   "project": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "created": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "edited": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "maxLength": 200,
        "type": "string"
       },
       "logo": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "logo",
       "created",
       "edited"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "project",
   "batchCount",
   "batchCountIsLowerBound",
   "batches"
  ],
  "type": "object"
 },
 "title": "Show image project overview"
}
