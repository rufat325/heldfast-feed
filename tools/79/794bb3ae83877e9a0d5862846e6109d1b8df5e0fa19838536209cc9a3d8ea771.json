{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the supported Warm operation catalog. Use this first to find the smallest matching operation.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "query": {
    "description": "Words describing the action or data you need.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_operations",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "operations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "confirmation_required": {
       "type": "boolean"
      },
      "description": {
       "type": "string"
      },
      "method": {
       "enum": [
        "DELETE",
        "GET",
        "PATCH",
        "POST",
        "PUT"
       ],
       "type": "string"
      },
      "operation_id": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "risk": {
       "items": {
        "enum": [
         "read",
         "write",
         "destructive",
         "external_effect"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "confirmation_required",
      "description",
      "method",
      "operation_id",
      "path",
      "risk",
      "summary"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "operations"
  ],
  "type": "object"
 }
}
