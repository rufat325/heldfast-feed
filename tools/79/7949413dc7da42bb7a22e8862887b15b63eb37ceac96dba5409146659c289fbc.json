{
 "description": "Update an existing in-app product",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "defaultLanguage": {
    "description": "Default language",
    "type": "string"
   },
   "defaultPriceCurrencyCode": {
    "description": "Currency code",
    "type": "string"
   },
   "defaultPriceMicros": {
    "description": "Price in micros",
    "type": "string"
   },
   "description": {
    "description": "Product description (for default language)",
    "type": "string"
   },
   "packageName": {
    "description": "Android package name",
    "type": "string"
   },
   "sku": {
    "description": "Product SKU",
    "type": "string"
   },
   "status": {
    "enum": [
     "active",
     "inactive"
    ],
    "type": "string"
   },
   "title": {
    "description": "Product title (for default language)",
    "type": "string"
   }
  },
  "required": [
   "packageName",
   "sku"
  ],
  "type": "object"
 },
 "name": "google_update_iap"
}
