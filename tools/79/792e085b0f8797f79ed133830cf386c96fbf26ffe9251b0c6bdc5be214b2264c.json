{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Runs Black code formatter and returns structured results (files changed, unchanged, would reformat).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "check": {
    "default": false,
    "description": "Check mode (report without modifying files)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "config": {
    "description": "Path to explicit Black config file (--config)",
    "maxLength": 4096,
    "type": "string"
   },
   "diff": {
    "default": false,
    "description": "Show diff of changes without applying (--diff)",
    "type": "boolean"
   },
   "lineLength": {
    "description": "Override the configured line length (--line-length)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "preview": {
    "default": false,
    "description": "Enable preview style (--preview)",
    "type": "boolean"
   },
   "skipStringNormalization": {
    "default": false,
    "description": "Skip string quote normalization (-S)",
    "type": "boolean"
   },
   "targetVersion": {
    "description": "Python version to target, e.g. 'py310', 'py311', 'py312' (--target-version)",
    "maxLength": 255,
    "type": "string"
   },
   "targets": {
    "default": [
     "."
    ],
    "description": "Files or directories to format (default: [\".\"])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "black",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "errorType": {
    "enum": [
     "check_failed",
     "internal_error"
    ],
    "type": "string"
   },
   "exitCode": {
    "type": "number"
   },
   "filesChanged": {
    "type": "number"
   },
   "filesUnchanged": {
    "type": "number"
   },
   "success": {
    "type": "boolean"
   },
   "wouldReformat": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "filesChanged",
   "filesUnchanged",
   "success"
  ],
  "type": "object"
 },
 "title": "Black Formatter"
}
