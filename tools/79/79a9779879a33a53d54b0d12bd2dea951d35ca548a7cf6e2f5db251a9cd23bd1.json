{
 "annotations": {
  "readOnlyHint": true,
  "title": "List time-off requests"
 },
 "description": "List time-off requests in a date range, with the requesting users. Status: 0 pending, 1 canceled, 2 accepted, 3 expired, 4 denied. When I Work: GET /2/requests.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "end": {
    "description": "End date, yyyy-mm-dd.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "include_deleted_users": {
    "description": "Include requests made by deleted users.",
    "type": "boolean"
   },
   "limit": {
    "description": "Maximum number of results.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "location_id": {
    "description": "Only requests for this schedule.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "max_id": {
    "description": "Only requests created before this request id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "page": {
    "description": "Page of results to load (the response says whether there are `more`).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "since_id": {
    "description": "Only requests created after this request id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "sortby": {
    "description": "'created' sorts newest first; anything else sorts by status then last update.",
    "type": "string"
   },
   "start": {
    "description": "Start date, yyyy-mm-dd.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "status": {
    "description": "Only requests with this status.",
    "maximum": 4,
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "description": "Only this request type.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "user_id": {
    "description": "One or more user ids.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": 0,
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "wheniwork_list_time_off_requests",
 "title": "List time-off requests"
}
