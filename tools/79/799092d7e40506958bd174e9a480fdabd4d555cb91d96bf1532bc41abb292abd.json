{
 "description": "Configure and save project context (dependencies and path) in the local database.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dependencies": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Project dependencies (e.g., from package.json)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "ecosystem": {
    "description": "The package ecosystem (e.g., \"npm\", \"pnpm\", \"pip\", \"cargo\"). Defaults to \"npm\".",
    "type": "string"
   },
   "name": {
    "description": "Name of the project",
    "type": "string"
   },
   "path": {
    "description": "Absolute path to the project root",
    "type": "string"
   }
  },
  "required": [
   "name",
   "path",
   "dependencies"
  ],
  "type": "object"
 },
 "name": "setup_project"
}
