{
 "description": "Search for entities in YOUR workspace (tasks, projects, users, comments, boards, USER documents). NOT system documentation!",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "entityType": {
    "default": "task",
    "enum": [
     "task",
     "project",
     "user",
     "comment",
     "board",
     "document"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search"
}
