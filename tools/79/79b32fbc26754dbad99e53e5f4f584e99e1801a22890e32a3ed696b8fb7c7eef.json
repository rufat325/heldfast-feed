{
 "description": "Update spreadsheet data by column headers with intelligent upsert logic. Supports adding missing columns, flexible update behaviors, and robust error handling. Uses column names as keys for matching existing rows, enabling context-aware data synchronization workflows.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "behavior": {
    "default": "add-or-update",
    "description": "Update behavior: add-or-update (default) adds new rows and updates existing, update-only skips new rows, add-only skips existing rows. BEST FOR: Bulk upsert operations with key matching in structured database or table contexts.",
    "enum": [
     "add-or-update",
     "update-only",
     "add-only"
    ],
    "type": "string"
   },
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "headers": {
    "description": "Array of column names/headers (max 50 columns). Must match the length of each row in the rows array",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "rows": {
    "description": "Array of rows to upsert (max 1000 rows per request). Each row is an array of cell values matching the headers array",
    "items": {
     "items": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "number"
       },
       {
        "const": null,
        "type": "number"
       },
       {
        "const": null,
        "type": "number"
       },
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ]
     },
     "type": "array"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "updateBy": {
    "description": "Array of column names to use as unique keys for matching existing rows (max 10 key columns). These columns must exist in the headers array",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "valueInputOption": {
    "default": "USER_ENTERED",
    "description": "How input data should be interpreted (RAW = exact values, USER_ENTERED = parsed like user input with formulas, dates, etc.)",
    "enum": [
     "RAW",
     "USER_ENTERED"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "gid",
   "rows",
   "headers",
   "updateBy"
  ],
  "type": "object"
 },
 "name": "columns-update",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "errors": {
        "description": "Any non-fatal errors encountered during the operation",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "headersAdded": {
        "description": "Column headers that were added to the sheet (if any were missing)",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "insertedKeys": {
        "description": "Keys of rows that were successfully inserted (new rows)",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "rowsSkipped": {
        "description": "Number of rows that were skipped based on the update behavior and existing data",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "sheetTitle": {
        "description": "Title of the updated sheet",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL of the updated sheet",
        "type": "string"
       },
       "spreadsheetTitle": {
        "description": "Title of the updated spreadsheet",
        "type": "string"
       },
       "spreadsheetUrl": {
        "description": "URL of the updated spreadsheet",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       },
       "updatedRows": {
        "description": "Number of rows that were successfully updated or inserted",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "spreadsheetTitle",
       "spreadsheetUrl",
       "sheetTitle",
       "sheetUrl",
       "updatedRows",
       "insertedKeys",
       "rowsSkipped",
       "headersAdded"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
