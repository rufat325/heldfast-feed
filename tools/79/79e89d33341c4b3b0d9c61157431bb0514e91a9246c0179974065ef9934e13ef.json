{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "carscout:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Dismiss Alert"
 },
 "description": "Dismiss the saved match the user selected from their own scout. Confirm the exact alert if the request is ambiguous.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alertId": {
    "description": "Selected alert ID",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "reason": {
    "default": "not_interested",
    "description": "Reason for dismissing",
    "enum": [
     "not_interested",
     "wrong_match",
     "already_purchased",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "alertId"
  ],
  "type": "object"
 },
 "name": "dismiss_alert",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alertId": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "reason": {
    "enum": [
     "not_interested",
     "wrong_match",
     "already_purchased",
     "other"
    ],
    "type": "string"
   },
   "status": {
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "alertId",
   "status",
   "reason"
  ],
  "type": "object"
 },
 "title": "Dismiss Alert"
}
