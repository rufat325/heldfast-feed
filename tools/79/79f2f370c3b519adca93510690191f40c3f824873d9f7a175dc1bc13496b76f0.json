 "description": "Ranks candidate 2022 NAICS industry codes for a formation from its business description. Returns SUGGESTIONS ONLY and changes nothing \u2014 always show the shortlist and have the person pick one. NAICS codes are two to six digits, not always six.",
 "inputSchema": {
  "properties": {
   "businessDescription": {
    "description": "Free-form description (max 5000 chars).",
    "properties": {
     "value": {
      "maxLength": 5000,
      "type": "string"
     }
    },
    "type": "object"
   },
   "formationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "maxResults": {
    "maximum": 25,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "formationId"
  ],
  "type": "object"
 },
 "name": "formation_suggest_naics_codes",
 "outputSchema": {
  "properties": {
   "matchedDescription": {
    "anyOf": [
     {
      "description": "Free-form description (max 5000 chars).",
