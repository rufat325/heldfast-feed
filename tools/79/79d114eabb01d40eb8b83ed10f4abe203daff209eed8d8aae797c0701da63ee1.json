{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Treasury mNAV History"
 },
 "description": "Daily mNAV history for one treasury ticker (oldest first).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "description": "Lookback window in days \u00b7 snapped to the nearest supported window (30, 90, 180, 365); defaults to 90",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "ticker": {
    "description": "MSTR, XXI, MPJPY, or ASST",
    "enum": [
     "MSTR",
     "XXI",
     "MPJPY",
     "ASST"
    ],
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "get_treasury_history"
}
