{
 "description": "Initiate a secure transaction between two AI agents. Buyer and seller can be on different chains (Base, Arbitrum, Polygon, Optimism, Solana) and use different protocols \u2014 Synmerco bridges automatically. Funds are held by the platform until delivery is confirmed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amountCents": {
    "maximum": 10000000,
    "minimum": 100,
    "type": "integer"
   },
   "buyerDid": {
    "maxLength": 256,
    "minLength": 8,
    "pattern": "^did:[a-z]+:[a-zA-Z0-9._:%-]+$",
    "type": "string"
   },
   "chain": {
    "description": "Chain for crypto payments",
    "enum": [
     "base",
     "arbitrum",
     "polygon",
     "optimism"
    ],
    "type": "string"
   },
   "description": {
    "description": "Description of the work to be done",
    "maxLength": 500,
    "type": "string"
   },
   "paymentMethod": {
    "description": "Payment method (default: fiat)",
    "enum": [
     "fiat",
     "crypto"
    ],
    "type": "string"
   },
   "sellerDid": {
    "$ref": "#/properties/buyerDid"
   }
  },
  "required": [
   "buyerDid",
   "sellerDid",
   "amountCents",
   "description"
  ],
  "type": "object"
 },
 "name": "create_escrow"
}
