{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search MCP servers"
 },
 "description": "Search the mcp.tc directory of MCP servers by keyword, category or how they connect. Returns compact results, featured servers first, then the most viewed on mcp.tc, each with its slug and mcp.tc link. Call get_server with a slug for the endpoint URL, install command and setup steps. With no arguments it lists the directory in that order.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "auth": {
    "description": "none: remote server that needs no sign-in. sign-in: remote server that needs OAuth sign-in or an API key (or offers optional sign-in). local: runs on your computer (npx, uvx, docker).",
    "enum": [
     "none",
     "sign-in",
     "local"
    ],
    "type": "string"
   },
   "category": {
    "description": "Category slug (see list_categories).",
    "enum": [
     "developer-tools",
     "docs-knowledge",
     "search-web",
     "browser-automation",
     "databases",
     "cloud-devops",
     "observability",
     "productivity",
     "communication",
     "design",
     "finance-payments",
     "crm-sales",
     "marketing-seo",
     "analytics",
     "ai-ml",
     "security",
     "automation",
     "travel-maps",
     "ecommerce",
     "utilities"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "How many results to return.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Words to find in the server's name, vendor, tagline or tags, e.g. \"postgres\" or \"github issues\". Every word must match.",
    "maxLength": 100,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_servers",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "more_url": {
    "description": "The same search on the website when there are more results",
    "type": [
     "string",
     "null"
    ]
   },
   "results": {
    "items": {
     "properties": {
      "auth": {
       "enum": [
        "none",
        "oauth",
        "api_key",
        "optional",
        "unknown"
       ],
       "type": "string"
      },
      "category": {
       "type": [
        "string",
        "null"
       ]
      },
      "kind": {
       "enum": [
        "remote",
        "local"
       ],
       "type": "string"
      },
      "link": {
       "description": "The listing page on mcp.tc, https://mcp.tc/i/{slug}",
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "tagline": {
       "type": "string"
      },
      "vendor": {
       "type": [
        "string",
        "null"
       ]
      },
      "verified": {
       "type": "boolean"
      }
     },
     "required": [
      "name",
      "slug",
      "link",
      "tagline",
      "auth",
      "kind",
      "verified"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Listings that match, including those not returned",
    "type": "integer"
   }
  },
  "required": [
   "total",
   "count",
   "results"
  ],
  "type": "object"
 },
 "title": "Search MCP servers"
}
