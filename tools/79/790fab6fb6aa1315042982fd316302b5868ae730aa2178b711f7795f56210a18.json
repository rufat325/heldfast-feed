{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"List tender changes"},"description":"List published notice changes in change order, with the kind of event, changed fields and a continuation cursor. Filter by countries, sources, sectors and events, and bound the window with since and until. A revision is a Zephior version, not an official amendment: event source_changed means a new source version was read, corrected a Zephior correction.","inputSchema":{"additionalProperties":false,"properties":{"countries":{"items":{"pattern":"^[A-Z]{2}$","type":"string"},"maxItems":250,"type":"array","uniqueItems":true},"cursor":{"description":"Pass nextCursor from the previous response to continue where it stopped.","maxLength":300,"pattern":"^[A-Za-z0-9_-]+$","type":"string"},"events":{"items":{"enum":["published","source_changed","corrected","withdrawn","merged","republished"],"type":"string"},"maxItems":6,"type":"array","uniqueItems":true},"limit":{"default":50,"maximum":100,"minimum":1,"type":"integer"},"locale":{"default":"en","enum":["en","de","fr"],"type":"string"},"sectors":{"items":{"enum":["construction","medical","it-telecoms","energy","environment","transport","facilities","food","engineering","consulting","education","office","culture","machinery","materials","agriculture"],"type":"string"},"maxItems":16,"type":"array","uniqueItems":true},"since":{"description":"Earliest change time with a timezone. Without a cursor or since, the feed starts seven days ago.","format":"date-time","type":"string"},"sources":{"description":"Source IDs from list_public_tender_sources, such as ted-europa.","items":{"pattern":"^[a-z0-9-]{1,100}$","type":"string"},"maxItems":50,"type":"array","uniqueItems":true},"until":{"description":"Exclusive end of the window, with a timezone. With since and until, paging with nextCursor reads one closed window completely.","format":"date-time","type":"string"}},"type":"object"},"name":"list