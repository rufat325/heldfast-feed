{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get the training data for a model by type and ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Resource ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "index": {
    "description": "Start index (0-based)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "nValues": {
    "description": "Number of values to return",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "type": {
    "description": "Model type (e.g. htr, la, ocr)",
    "pattern": "^[^/\\s]+$",
    "type": "string"
   }
  },
  "required": [
   "type",
   "id"
  ],
  "type": "object"
 },
 "name": "transkribus_model_get_train_data",
 "title": "Get Model Training Data"
}
