{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check whether a booking request (from create_booking_request) has been confirmed by the passenger yet. Returns 'pending', 'confirmed' (with the booking number), or 'expired'.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "requestId": {
    "description": "The requestId returned by create_booking_request.",
    "type": "string"
   }
  },
  "required": [
   "requestId"
  ],
  "type": "object"
 },
 "name": "get_booking_request_status",
 "outputSchema": {
  "oneOf": [
   {
    "properties": {
     "booked": {
      "type": "boolean"
     },
     "bookingNumber": {
      "type": [
       "string",
       "null"
      ]
     },
     "message": {
      "type": "string"
     },
     "ok": {
      "const": true
     },
     "status": {
      "enum": [
       "pending",
       "confirmed",
       "expired"
      ]
     }
    },
    "required": [
     "ok",
     "status",
     "booked",
     "message"
    ],
    "type": "object"
   },
   {
    "properties": {
     "error": {
      "type": "string"
     },
     "ok": {
      "const": false
     }
    },
    "required": [
     "ok",
     "error"
    ],
    "type": "object"
   }
  ]
 },
 "title": "Check booking request status"
}
