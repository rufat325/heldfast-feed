{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Change target group health check configuration",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "healthCheckCycle": {
    "description": "Health check cycle in seconds (5-300)",
    "type": "number"
   },
   "healthCheckDownThreshold": {
    "description": "Unhealthy threshold count (2-10)",
    "type": "number"
   },
   "healthCheckHttpMethodTypeCode": {
    "description": "HTTP method type for health check (HEAD, GET). Available if health check protocol is HTTP or HTTPS",
    "type": "string"
   },
   "healthCheckPort": {
    "description": "Health check port number (1-65534, default: 80)",
    "type": "number"
   },
   "healthCheckUpThreshold": {
    "description": "Healthy threshold count (2-10)",
    "type": "number"
   },
   "healthCheckUrlPath": {
    "description": "Health check URL path (for HTTP/HTTPS, starts with /)",
    "type": "string"
   },
   "targetGroupNo": {
    "description": "Target group number",
    "type": "string"
   }
  },
  "required": [
   "targetGroupNo"
  ],
  "type": "object"
 },
 "name": "ncloud_change_target_group_health"
}
