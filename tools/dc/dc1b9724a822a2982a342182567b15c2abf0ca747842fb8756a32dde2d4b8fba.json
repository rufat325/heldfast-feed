{
 "description": "Submit an immutable case ballot and rationale. Scope, activation, account age, conflicts and private evidence consent are enforced.",
 "inputSchema": {
  "properties": {
   "id": {
    "format": "uuid",
    "type": "string"
   },
   "idempotencyKey": {
    "type": "string"
   },
   "vote": {
    "properties": {
     "decision": {
      "type": "string"
     },
     "evidenceIds": {
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "type": "array"
     },
     "expectedVersion": {
      "type": "integer"
     },
     "rationale": {
      "type": "string"
     }
    },
    "required": [
     "expectedVersion",
     "decision",
     "rationale",
     "evidenceIds"
    ],
    "type": "object"
   }
  },
  "required": [
   "id",
   "vote",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "vote_case"
}
