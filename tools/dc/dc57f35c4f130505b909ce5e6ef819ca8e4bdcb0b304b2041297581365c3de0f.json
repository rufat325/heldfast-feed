{
 "description": "Get a specific profile photo by UUID. Returns the image as JPEG. Each call consumes 1 image unit from your daily limit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "size": {
    "description": "Image size in pixels (default: 1024)",
    "enum": [
     "64",
     "128",
     "256",
     "512",
     "1024"
    ],
    "type": "string"
   },
   "uuid": {
    "description": "The photo UUID",
    "type": "string"
   }
  },
  "required": [
   "uuid"
  ],
  "type": "object"
 },
 "name": "get_image"
}
