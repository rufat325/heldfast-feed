{
 "description": "Updates a timeline's fps / width / height (clips keep their timing; content re-fits) and/or renames it. Only provided fields change.",
 "inputSchema": {
  "properties": {
   "fps": {
    "description": "Optional new frames per second.",
    "type": "number"
   },
   "height": {
    "description": "Optional new height in px.",
    "type": "number"
   },
   "name": {
    "description": "Optional new display name.",
    "type": "string"
   },
   "projectId": {
    "description": "Project id from get_projects.",
    "type": "string"
   },
   "timelineId": {
    "description": "Timeline to update.",
    "type": "string"
   },
   "token": {
    "description": "The session token `connect` returned. Pass it on every call \u2014 it says which browser to drive.",
    "type": "string"
   },
   "width": {
    "description": "Optional new width in px.",
    "type": "number"
   }
  },
  "required": [
   "projectId",
   "timelineId",
   "token"
  ],
  "type": "object"
 },
 "name": "set_project_settings"
}
