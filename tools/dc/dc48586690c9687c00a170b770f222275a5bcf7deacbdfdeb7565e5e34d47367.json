{"annotations":{"destructiveHint":true,"idempotentHint":false},"description":"Delete several documents, files, or folders in one call. confirmCount must equal the number of paths, else CONFIRMATION_MISMATCH. Every path is resolved before anything is deleted, so a missing one fails the call with NOT_FOUND and changes nothing. Deleting a folder removes everything inside it, so list the folder alone, not its contents too. Continues past a failed delete unless stopOnError, and returns status, completed, failed, and remaining. Confirm the list with the user first.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"confirmCount":{"description":"The number of paths, repeated after confirming the list with the user","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"paths":{"description":"Project paths to delete","items":{"description":"Project-relative path using forward slashes","minLength":1,"type":"string"},"maxItems":500,"minItems":1,"type":"array"},"projectId":{"description":"Overleaf project ID","minLength":1,"type":"string"},"stopOnError":{"default":false,"description":"Stop at the first failure instead of continuing","type":"boolean"}},"required":["projectId","paths","confirmCount"],"type":"object"},"name":"delete_entities","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"completed":{"items":{"additionalProperties":false,"properties":{"entityId":{"type":"string"},"path":{"type":"string"},"type":{"enum":["doc","file","folder"],"type":"string"}},"required":["path","type","entityId"],"type":"object"},"type":"array"},"failed":{"items":{"additionalProperties":false,"properties":{"errorCode":{"enum":["AUTH_EXPIRED","PERMISSION_DENIED","NOT_FOUND","REVISION_CONFLICT","PROTOCOL_UNSUPPORTED","UPDATE_TOO_LARGE","DOC_TOO_LARGE","TIMEOUT","OUTCOME_UNKNOWN","COMPILE_FAILED","COMPILE_RATE_LIMITED","COMPILE_UNAVAILABLE","COMPILE_TIMEOUT","NO_BUILD","BUILD_NOT_FOUND","PARTIAL_CLEANUP","INVALID_ARGUMENT","CONFIRMATION_MISMATCH","RATE_LIMITED","REMOTE_DRIFT","PATH_OUTSIDE_ROOT","POLICY_DENIED","REMOTE_ERROR","TRANSIENT_FAILURE","REVIEW_UNSUPPORTED","INCLUDE_CYCLE","INCLUDE_DEPTH_EXCEEDED"],"type":"string"},"message":{"type":"string"},"path":{"type":"string"}},"required":["path","errorCode","message"],"type":"object"},"type":"array"},"remaining":{"items":{"additionalProperties":false,"properties":{"path":{"type":"string"}},"required":["path"],"type":"object"},"type":"array"},"status":{"enum":["complete","partial"],"type":"string"}},"required":["status","completed","failed","remaining"],"type":"object"}}
