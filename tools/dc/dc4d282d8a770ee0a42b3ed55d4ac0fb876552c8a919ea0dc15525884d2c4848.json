{
 "description": "Build a .0n application bundle \u2014 a portable encrypted file containing\nendpoints, workflows, operations, automations, and connections.\nDeploy anywhere with: 0nmcp app run <file>\n\nExample: app_build({ name: \"Lead Scorer\", passphrase: \"secret\", workflows: {...}, endpoints: {...} })",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "automations": {
    "additionalProperties": {},
    "description": "Automation definitions { id: def }",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "connections": {
    "additionalProperties": {},
    "description": "Connections to include { service: { credentials } }",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "endpoints": {
    "additionalProperties": {},
    "description": "Endpoint definitions { 'METHOD /path': def }",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "environment": {
    "description": "Environment configuration",
    "properties": {
     "feature_flags": {
      "additionalProperties": {
       "type": "boolean"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "secrets": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "settings": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "variables": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "name": {
    "description": "Application name",
    "type": "string"
   },
   "operations": {
    "additionalProperties": {},
    "description": "Reusable operation definitions { id: def }",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "output": {
    "description": "Output file path",
    "type": "string"
   },
   "passphrase": {
    "description": "Passphrase to encrypt the bundle",
    "type": "string"
   },
   "workflows": {
    "additionalProperties": {},
    "description": "Workflow definitions { id: workflowDef }",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "name",
   "passphrase"
  ],
  "type": "object"
 },
 "name": "app_build"
}
