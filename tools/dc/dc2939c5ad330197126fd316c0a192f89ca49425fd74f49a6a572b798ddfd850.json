{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compare current ride-hailing prices and pickup times from the providers available through Sail.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "destination": {
    "description": "Resolved destination place",
    "properties": {
     "address": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
     },
     "lat": {
      "description": "Latitude in decimal degrees",
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "lng": {
      "description": "Longitude in decimal degrees",
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "placeId": {
      "description": "Place ID returned by search_places",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "lat",
     "lng"
    ],
    "type": "object"
   },
   "pickup": {
    "description": "Resolved pickup place",
    "properties": {
     "address": {
      "maxLength": 300,
      "minLength": 1,
      "type": "string"
     },
     "lat": {
      "description": "Latitude in decimal degrees",
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "lng": {
      "description": "Longitude in decimal degrees",
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "placeId": {
      "description": "Place ID returned by search_places",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "lat",
     "lng"
    ],
    "type": "object"
   }
  },
  "required": [
   "pickup",
   "destination"
  ],
  "type": "object"
 },
 "name": "compare_rides",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "complete": {
    "type": "boolean"
   },
   "optionCounts": {
    "additionalProperties": false,
    "properties": {
     "returned": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "total",
     "returned",
     "truncated"
    ],
    "type": "object"
   },
   "options": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "available": {
       "type": "boolean"
      },
      "etaMinutes": {
       "type": "number"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "price": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "type": "number"
        },
        "currency": {
         "type": "string"
        },
        "originalAmount": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "provider": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "vehicleType": {
       "type": "string"
      }
     },
     "required": [
      "price",
      "available"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "options",
   "optionCounts",
   "complete"
  ],
  "type": "object"
 },
 "title": "Compare rides"
}
