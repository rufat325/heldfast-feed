         "type": [
          "object",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "quantity",
        "merchandise"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "items_count": {
      "type": "integer"
     },
     "stale_items": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "wallet": {
      "type": [
       "object",
