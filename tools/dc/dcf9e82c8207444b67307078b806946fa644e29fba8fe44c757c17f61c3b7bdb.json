{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List DNS records for a specific Global DNS domain with pagination",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domainId": {
    "description": "Domain ID to list records for",
    "type": "number"
   },
   "page": {
    "description": "Page number (0-based)",
    "type": "number"
   },
   "recordType": {
    "description": "Filter by record type",
    "enum": [
     "A",
     "AAAA",
     "CNAME",
     "MX",
     "PTR",
     "SPF",
     "TXT",
     "NS",
     "SRV",
     "CAA",
     "DS"
    ],
    "type": "string"
   },
   "searchContent": {
    "description": "Search filter for record content",
    "type": "string"
   },
   "size": {
    "description": "Number of items per page",
    "type": "number"
   }
  },
  "required": [
   "domainId",
   "page",
   "size"
  ],
  "type": "object"
 },
 "name": "ncloud_dns_list_records"
}
