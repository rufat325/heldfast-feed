{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check media processing status"
 },
 "description": "X (Twitter): check the async processing state of an uploaded media by `media_id`. Videos and GIFs process after upload \u2014 poll until `processing_state` is `succeeded` (`check_after_secs` suggests when) before attaching the media to a post.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "media_id": {
    "description": "The media id returned by x_media_upload whose processing state to check.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "media_id"
  ],
  "type": "object"
 },
 "name": "x_media_status",
 "outputSchema": {
  "properties": {
   "data": {
    "properties": {
     "check_after_secs": {
      "type": "number"
     },
     "media_id": {
      "type": "string"
     },
     "processing_state": {
      "type": "string"
     },
     "progress_percent": {
      "type": "number"
     }
    },
    "required": [
     "media_id",
     "processing_state"
    ],
    "type": "object"
   },
   "meta": {
    "properties": {
     "budget_warning": {
      "type": "string"
     },
     "cost_usd": {
      "type": "number"
     },
     "session_total_usd": {
      "type": "number"
     }
    },
    "required": [
     "cost_usd",
     "session_total_usd"
    ],
    "type": "object"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 }
}
