{
 "annotations": {
  "openWorldHint": true
 },
 "description": "Runs conda commands (list, info, env-list, create, remove, update) and returns structured JSON output.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Conda action to perform",
    "enum": [
     "list",
     "info",
     "env-list",
     "create",
     "remove",
     "update"
    ],
    "type": "string"
   },
   "all": {
    "default": false,
    "description": "For update action, update all installed packages (--all)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "name": {
    "description": "Environment name (used with 'list' action to list packages in a specific env)",
    "maxLength": 65536,
    "type": "string"
   },
   "packageFilter": {
    "description": "Regex filter for conda list to show only matching packages",
    "maxLength": 255,
    "type": "string"
   },
   "packages": {
    "description": "Packages used by create/remove/update actions",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   },
   "prefix": {
    "description": "Environment prefix path as alternative to name (--prefix DIR)",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "conda",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "action": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "title": "Conda"
}
