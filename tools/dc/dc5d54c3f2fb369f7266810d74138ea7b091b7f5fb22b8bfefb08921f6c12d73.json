{
 "description": "One WorkerTask -> one candidate test, generated by the MLX model running on this machine. Costs zero Claude tokens and touches no network: it is an HTTP call to http://localhost:<port>/v1. Raw worker output \u2014 verify it before showing it to anyone.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "task": {
    "additionalProperties": false,
    "description": "the task, as docs/specs/pipeline.md defines it",
    "properties": {
     "exemplar_source": {
      "type": "string"
     },
     "function": {
      "additionalProperties": false,
      "properties": {
       "name": {
        "minLength": 1,
        "type": "string"
       },
       "signature": {
        "minLength": 1,
        "type": "string"
       },
       "source": {
        "minLength": 1,
        "type": "string"
       },
       "source_sha": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "name",
       "signature",
       "source",
       "source_sha"
      ],
      "type": "object"
     },
     "imports_hint": {
      "type": "string"
     },
     "language": {
      "enum": [
       "typescript",
       "swift",
       "python",
       "kotlin"
      ],
      "type": "string"
     },
     "previous_error": {
      "anyOf": [
       {
        "maxLength": 2048,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "retry_of": {
      "type": [
       "string",
       "null"
      ]
     },
     "shape": {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "enum": [
         "happy_path",
         "boundary",
         "error_or_throw",
         "async",
         "stateful_sequence",
         "property_like"
        ],
        "type": "string"
       },
       "rules": {
        "type": "string"
       }
      },
      "required": [
       "kind",
       "rules"
      ],
      "type": "object"
     },
     "task_id": {
      "minLength": 1,
      "type": "string"
     },
     "test_framework": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "task_id",
     "language",
     "test_framework",
     "function",
     "imports_hint",
     "shape",
     "exemplar_source",
     "retry_of",
     "previous_error"
    ],
    "type": "object"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "sidecrew_generate"
}
