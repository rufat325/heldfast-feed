          ],
          "type": "object"
         },
         "type": "array"
        }
       },
       "required": [
        "id",
        "kind",
        "inbox_id",
        "subject",
        "to",
        "deleted_at",
        "restorable_until"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
