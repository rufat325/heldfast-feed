    "description": "\u4f86\u81ea dataset.search \u7684\u8cc7\u6599\u96c6\u4ee3\u865f\uff0c\u4f8b\u5982 \"exchangeReport/STOCK_DAY_ALL\"\u3002",
    "type": "string"
   }
  },
