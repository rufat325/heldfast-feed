{
 "description": "Search contacts with filters, sorting, and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "filters": {
    "description": "Array of filter objects to narrow results (e.g. [{field:'email',operator:'eq',value:'test@example.com'}])",
    "items": {},
    "type": "array"
   },
   "locationId": {
    "description": "Location ID to search within",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "page": {
    "description": "Page number for pagination (starts at 1)",
    "type": "number"
   },
   "pageLimit": {
    "description": "Number of results per page (max 100)",
    "type": "number"
   },
   "query": {
    "description": "Search query string to match against contact fields",
    "type": "string"
   },
   "sort": {
    "description": "Field name to sort results by",
    "type": "string"
   },
   "sortDirection": {
    "description": "Sort direction: 'asc' or 'desc'",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId"
  ],
  "type": "object"
 },
 "name": "crm_search_contacts"
}
