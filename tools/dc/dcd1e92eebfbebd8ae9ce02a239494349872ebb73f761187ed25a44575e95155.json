 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "permissions": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "string"
     }
    ],
    "description": "The permission rules, e.g. [{ \"mode\": \"allow\", \"action\": \"view\", \"resourceType\": \"item\", \"listIds\": [\"*\"], \"itemIds\": [\"*\"] }]"
   }
  },
  "required": [
   "permissions"
  ],
  "type": "object"
 },
 "name": "validate_token_permissions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
