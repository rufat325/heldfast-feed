  "title": "Search NYC preforeclosures"
 },
 "description": "Searches NYC properties in preforeclosure only: lis pendens foreclosure filings in Manhattan, Brooklyn, Queens, the Bronx and Staten Island. For one NYC property by address use find_nyc_property; for filtered searches or properties outside NYC use the national property search tools. Filters: borough, foreclosure stage, equity, case age, recently added, market value and amount owed. Returns summary rows, newest first, up to 25 per call (default 10); page with offset. Each row carries the lot's bbl when known. For the owner's phone and email on a row, call get_nyc_property with that bbl, then unlock_nyc_owner_contacts; never search the web for it. Never spends credits. On any paid plan the first 25 summary rows each day are free; other workspaces pay for every row. Rows the workspace already pulled are free again. Past the free rows, rows cost 1 credit per 10, and this tool returns them as a quote instead: tell the user the credit cost and ask before calling run_nyc_preforeclosure_search with the quote_id.",
 "inputSchema": {
  "properties": {
   "addedWithinDays": {
    "anyOf": [
     {
      "maximum": 3650,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Only filings added in the last N days. Use for 'new this week'."
   },
   "amountOwedMax": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "amountOwedMin": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "borough": {
    "default": [],
    "description": "NYC boroughs to include. Empty means all five.",
    "items": {
     "enum": [
      "manhattan",
      "brooklyn",
      "queens",
      "bronx",
      "staten_island"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "equity": {
    "default": [],
    "description": "Estimated equity: positive (value above the debt) or negative. Empty means any.",
    "items": {
     "enum": [
      "positive",
      "negative"
     ],
     "type": "string"
    },
    "maxItems": 2,
    "type": "array"
   },
   "filingAge": {
    "default": [],
    "description": "Case age by filing year: fresh (under 2 years), seasoned (2 to 5), long_running (5 or more).",
    "items": {
     "enum": [
      "fresh",
      "seasoned",
      "long_running"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "limit": {
    "default": 10,
    "description": "Rows to return, 1 to 25. Defaults to 10.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "marketValueMax": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "marketValueMin": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "offset": {
    "default": 0,
    "description": "Rows to skip, for the next page.",
    "maximum": 975,
    "minimum": 0,
    "type": "integer"
   },
   "stage": {
    "default": [],
    "description": "Foreclosure stages to include. Empty means every stage.",
    "items": {
     "enum": [
      "summons_and_complaint",
      "order_of_reference",
      "judgment_of_foreclosure_and_sale",
      "notice_of_sale",
      "stayed",
      "cancelled"
     ],
     "type": "string"
    },
    "maxItems": 6,
    "type": "array"
   }
  },
  "type": "object"
 },
