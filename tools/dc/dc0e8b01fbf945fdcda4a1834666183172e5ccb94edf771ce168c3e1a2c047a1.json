{
 "_meta": {
  "_fastmcp": {
   "tags": []
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get full manual text by name, e.g. manual_name=\"ls\"; no package needed.\n\nmanual_name is the command name (also matches aliases); package is an optional filter.\nTries exact casing first, then a case-insensitive name/alias match.\nSearch API selects latest indexed packages per scope, preferring Fedora\nwhen distribution is omitted, then newest Fedora RPM version across scopes.\nExplicit filters always apply; package_version can select historical manuals.\nExact command names (sections 1/8) precede other names and aliases within\nthe preferred distro. No locale fallback.\nReturns manual text with a distro/release and package/version header.\nSource-only manuals raise an error with extraction status.",
 "inputSchema": {
  "properties": {
   "architecture": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "distribution": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "locale": {
    "default": "en",
    "maxLength": 128,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
    "type": "string"
   },
   "manual_name": {
    "maxLength": 256,
    "pattern": "^[^\\s/\\\\]+$",
    "type": "string"
   },
   "package": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "package_version": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "release": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "repository": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "section": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "manual_name"
  ],
  "type": "object"
 },
 "name": "get_manual"
}
