{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List files in the vault, optionally filtered by folder and extension.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ext": {
    "description": "Restrict to a file extension, e.g. 'md'.",
    "type": "string"
   },
   "folder": {
    "description": "Restrict to a folder (vault-relative).",
    "type": "string"
   },
   "limit": {
    "description": "Max number of files to return.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "sort": {
    "default": "path",
    "description": "Sort order.",
    "enum": [
     "path",
     "name"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "note_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Optional tool-specific structured result data."
   },
   "text": {
    "description": "Human-readable result text.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "title": "List notes"
}
