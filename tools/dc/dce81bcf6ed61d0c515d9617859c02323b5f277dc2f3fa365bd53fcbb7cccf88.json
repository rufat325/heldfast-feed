{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Cross-engine citation provenance"
 },
 "description": "Fan a query out across multiple AI engines and report per-URL cross-engine consensus. Returns each unique cited URL with the list of engines that cited it, plus a consensus_urls list (URLs cited by ALL engines). High engine_count = strong cross-engine citation signal; engine_count=1 = engine-specific.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "engines": {
    "description": "Engines to query. If omitted, uses all LLM engines with a configured API key (perplexity, claude, openai, gemini, google_ai_mode). Include bing_serp/brave_serp only when you explicitly want web_rank comparison.",
    "items": {
     "enum": [
      "perplexity",
      "claude",
      "openai",
      "gemini",
      "google_ai_mode",
      "bing_serp",
      "brave_serp"
     ],
     "type": "string"
    },
    "maxItems": 7,
    "minItems": 1,
    "type": "array"
   },
   "max_results": {
    "default": 10,
    "description": "Max citations per engine.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query to fan out across multiple engines.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "citations_provenance",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "consensus_urls": {
    "description": "URLs cited by ALL succeeding engines (requires >=2 engines).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "engines": {
    "description": "Per-engine run summary.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "citations": {
       "type": "number"
      },
      "engine": {
       "type": "string"
      },
      "error": {
       "type": "string"
      },
      "interpretation_note": {
       "type": "string"
      },
      "ok": {
       "type": "boolean"
      },
      "surface": {
       "type": "string"
      }
     },
     "required": [
      "engine",
      "ok",
      "citations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "engines_queried": {
    "type": "number"
   },
   "engines_succeeded": {
    "type": "number"
   },
   "fetched_at": {
    "description": "UTC ISO-8601 timestamp.",
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "per_url": {
    "description": "All unique cited URLs sorted by cross-engine consensus (engine_count desc).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "cited_by": {
       "description": "Engines that cited this URL.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "engine_count": {
       "description": "Number of engines that cited this URL.",
       "type": "number"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "cited_by",
      "engine_count"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "description": "The query that was fanned across engines.",
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "consensus_count": {
      "type": "number"
     },
     "median_engines_per_url": {
      "type": "number"
     },
     "total_unique_urls": {
      "type": "number"
     }
    },
    "required": [
     "total_unique_urls",
     "consensus_count",
     "median_engines_per_url"
    ],
    "type": "object"
   }
  },
  "required": [
   "query",
   "fetched_at",
   "engines",
   "engines_queried",
   "engines_succeeded",
   "per_url",
   "consensus_urls",
   "summary"
  ],
  "type": "object"
 }
}
