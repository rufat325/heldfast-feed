{
 "description": "Run an assignment-scoped integration verification check through the exact-obligation choke point. A provider-ready time integration can queue a bounded fresh-proof probe and returns its check state, next action, and retry guidance. Employers verify any contract on their jobs; workers only their own. Requires integrations:write scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
