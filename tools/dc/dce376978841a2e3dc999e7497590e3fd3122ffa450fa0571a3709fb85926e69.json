    "description": "The exact worker obligation to verify.",
    "minLength": 1,
    "type": "string"
   },
   "contractId": {
    "description": "Contract that owns the obligation.",
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Client idempotency key.",
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "provider": {
    "description": "Provider key (for example HUBSTAFF).",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "idempotencyKey",
   "provider",
   "contractId",
   "assignmentId"
  ],
  "type": "object"
 },
 "name": "opentrain_verify_integration",
 "outputSchema": {
