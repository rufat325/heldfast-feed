{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search specific dates and occupancy for a known property using its propertyToken.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adults": {
    "default": 1,
    "type": "number"
   },
   "checkIn": {
    "description": "Check-in date (YYYY-MM-DD)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "checkOut": {
    "description": "Check-out date (YYYY-MM-DD)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "children": {
    "default": 0,
    "type": "number"
   },
   "displayCurrency": {
    "description": "Optional 3-letter currency for approximate traveler-facing display conversion. Native property currency remains authoritative.",
    "type": "string"
   },
   "internalAgentKey": {
    "type": "string"
   },
   "priceAudience": {
    "enum": [
     "PUBLIC",
     "VERIFIED_TRAVELER"
    ],
    "type": "string"
   },
   "propertyToken": {
    "description": "Exact public propertyToken returned by discovery or property context. Never add a prefix or invent a token.",
    "type": "string"
   }
  },
  "required": [
   "propertyToken",
   "checkIn",
   "checkOut"
  ],
  "type": "object"
 },
 "name": "search_property_availability"
}
