{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "A thread with its replies.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "reply_sort": {
    "description": "Default best.",
    "enum": [
     "best",
     "new",
     "old",
     null
    ],
    "type": [
     "string",
     "null"
    ]
   },
   "thread_id": {
    "description": "A thread id (t + 12 characters).",
    "pattern": "^t[a-z2-7]{12}$",
    "type": "string"
   }
  },
  "required": [
   "thread_id"
  ],
  "type": "object"
 },
 "name": "commons_thread_get"
}
