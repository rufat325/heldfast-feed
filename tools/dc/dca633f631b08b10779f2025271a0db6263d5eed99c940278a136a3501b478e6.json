{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Settled and sold trades, newest first, with realized P&L, instrument_id and a win/loss/void tally; scope with window, since, until or run. A reset write-off is sold, close_reason account_reset.",
 "inputSchema": {
  "properties": {
   "full": {
    "type": "boolean"
   },
   "limit": {
    "description": "Default 20, max 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "month": {
    "description": "Deprecated.",
    "type": "string"
   },
   "run": {
    "description": "Since your last reset.",
    "enum": [
     "current"
    ],
    "type": "string"
   },
   "since": {
    "description": "30d, YYYY-MM-DD or ISO.",
    "type": "string"
   },
   "until": {
    "description": "YYYY-MM-DD or ISO.",
    "type": "string"
   },
   "window": {
    "enum": [
     "all",
     "30d",
     "90d"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_history",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "number"
   },
   "forfeit_count": {
    "type": "number"
   },
   "loss_count": {
    "type": "number"
   },
   "realized_pnl_dollars": {
    "type": "number"
   },
   "trades": {
    "type": "array"
   },
   "truncated": {
    "type": "boolean"
   },
   "void_count": {
    "type": "number"
   },
   "warnings": {
    "type": "array"
   },
   "web_url": {
    "type": "string"
   },
   "win_count": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Closed trades"
}
