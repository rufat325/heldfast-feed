{
 "annotations": {
  "readOnlyHint": true,
  "title": "Render Contractual Agreement"
 },
 "description": "Renders the legal contractual agreement text/HTML for an offer using its offer data and metadata. Use to preview or store the agreement. Returns: rendered agreement string.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "configId": {
    "description": "Boson/Fermion Protocol deployment identifier. Format: '<env>-<chainId>-<index>' e.g. 'production-137-0' (Polygon mainnet), 'testing-80002-0' (Amoy testnet). Call get_config_ids to list all valid values for this server.",
    "type": "string"
   },
   "offerData": {
    "additionalProperties": false,
    "properties": {
     "agentId": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "buyerCancelPenalty": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "collectionIndex": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "disputePeriodDurationInMS": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "disputeResolverId": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "exchangeToken": {
      "description": "Valid Ethereum address (e.g. '0xAbCd...' or '0xabcd...'). Mixed-case addresses are checksum-validated; all-lowercase and all-uppercase addresses are also accepted.",
      "type": "string"
     },
     "feeLimit": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "metadataHash": {
      "type": "string"
     },
     "metadataUri": {
      "type": "string"
     },
     "price": {
      "type": "string"
     },
     "priceType": {
      "type": "number"
     },
     "quantityAvailable": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "resolutionPeriodDurationInMS": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "royaltyInfo": {
      "additionalProperties": false,
      "properties": {
       "bps": {
        "description": "Royalty amounts per recipient in basis points (1 bp = 0.01%). Parallel to recipients. Total must not exceed 10000.",
        "items": {
         "type": "string"
        },
        "minItems": 0,
        "type": "array"
       },
       "recipients": {
        "description": "Array of addresses receiving resale royalties.",
        "items": {
         "$ref": "#/properties/offerData/properties/exchangeToken"
        },
        "minItems": 0,
        "type": "array"
       }
      },
      "required": [
       "recipients",
       "bps"
      ],
      "type": "object"
     },
     "sellerDeposit": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "validFromDateInMS": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "validUntilDateInMS": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "voucherRedeemableFromDateInMS": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "voucherRedeemableUntilDateInMS": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "voucherValidDurationInMS": {
      "$ref": "#/properties/offerData/properties/price"
     }
    },
    "required": [
     "price",
     "sellerDeposit",
     "agentId",
     "buyerCancelPenalty",
     "quantityAvailable",
     "validFromDateInMS",
     "validUntilDateInMS",
     "voucherRedeemableFromDateInMS",
     "voucherRedeemableUntilDateInMS",
     "disputePeriodDurationInMS",
     "resolutionPeriodDurationInMS",
     "exchangeToken",
     "disputeResolverId",
     "metadataUri",
     "metadataHash",
     "collectionIndex"
    ],
    "type": "object"
   },
   "offerMetadata": {
    "additionalProperties": false,
    "properties": {
     "disputeResolverContactMethod": {
      "type": "string"
     },
     "escalationDeposit": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "escalationResponsePeriodInSec": {
      "$ref": "#/properties/offerData/properties/price"
     },
     "returnPeriodInDays": {
      "type": "number"
     },
     "sellerContactMethod": {
      "type": "string"
     },
     "sellerTradingName": {
      "type": "string"
     }
    },
    "required": [
     "sellerContactMethod",
     "disputeResolverContactMethod",
     "escalationDeposit",
     "escalationResponsePeriodInSec",
     "sellerTradingName",
     "returnPeriodInDays"
    ],
    "type": "object"
   },
   "signerAddress": {
    "$ref": "#/properties/offerData/properties/exchangeToken",
    "description": "Ethereum address that will sign and send this transaction. Must match the wallet that will sign the returned transaction locally."
   },
   "template": {
    "type": "string"
   }
  },
  "required": [
   "template",
   "offerData",
   "offerMetadata",
   "configId",
   "signerAddress"
  ],
  "type": "object"
 },
 "name": "render_contractual_agreement"
}
