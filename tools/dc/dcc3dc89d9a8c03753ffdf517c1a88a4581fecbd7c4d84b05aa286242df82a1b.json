{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage boat profile (multi-boat per account, keyed by name).\n\nInputs: action, name, type, loa_m, beam_m, draft_m, displacement_kg, engine_type, engine_hp, fuel_capacity_l, motor_consumption_l_per_h, water_capacity_l, cruising_speed_kts, max_speed_kts, safety_equipment, certifications.\n\nExamples: action=\"upsert\", name=\"Freya\", type=\"sail\", loa_m=12.5; action=\"delete\", name=\"Freya\"; action=\"set_default\", name=\"Freya\".\n\nTip: speed/consumption enrich nausika_sea_route ETA.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Create/update, delete, or set a boat as default",
    "enum": [
     "upsert",
     "delete",
     "set_default"
    ],
    "type": "string"
   },
   "beam_m": {
    "description": "Maximum beam in meters",
    "examples": [
     4.1
    ],
    "maximum": 50,
    "minimum": 0.5,
    "type": "number"
   },
   "certifications": {
    "description": "Certifications",
    "examples": [
     "CE B"
    ],
    "type": "string"
   },
   "cruising_speed_kts": {
    "description": "Cruising speed in knots",
    "examples": [
     6
    ],
    "maximum": 50,
    "minimum": 0.5,
    "type": "number"
   },
   "displacement_kg": {
    "description": "Displacement in kg",
    "examples": [
     8500
    ],
    "maximum": 500000,
    "minimum": 100,
    "type": "integer"
   },
   "draft_m": {
    "description": "Draft in meters",
    "examples": [
     1.8
    ],
    "maximum": 20,
    "minimum": 0.1,
    "type": "number"
   },
   "engine_hp": {
    "description": "Engine power in HP",
    "examples": [
     30
    ],
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "engine_type": {
    "description": "Engine type",
    "enum": [
     "inboard",
     "outboard",
     "none"
    ],
    "type": "string"
   },
   "fuel_capacity_l": {
    "description": "Fuel tank capacity in liters",
    "examples": [
     200
    ],
    "maximum": 50000,
    "minimum": 1,
    "type": "integer"
   },
   "loa_m": {
    "description": "Length overall in meters",
    "examples": [
     12.5
    ],
    "maximum": 200,
    "minimum": 1,
    "type": "number"
   },
   "max_speed_kts": {
    "description": "Maximum speed in knots",
    "examples": [
     8
    ],
    "maximum": 80,
    "minimum": 0.5,
    "type": "number"
   },
   "motor_consumption_l_per_h": {
    "description": "Average motor fuel consumption at cruising RPM, in litres per hour",
    "examples": [
     3.5
    ],
    "maximum": 1000,
    "minimum": 0,
    "type": "number"
   },
   "name": {
    "description": "Boat name (required for create, identifies boat for update/delete)",
    "examples": [
     "Calypso II",
     "Mistral"
    ],
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "safety_equipment": {
    "description": "Safety equipment description",
    "examples": [
     "VHF",
     "EPIRB",
     "liferaft"
    ],
    "type": "string"
   },
   "type": {
    "description": "Boat type",
    "enum": [
     "sail",
     "motor",
     "multihull"
    ],
    "type": "string"
   },
   "water_capacity_l": {
    "description": "Water tank capacity in liters",
    "examples": [
     250
    ],
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "nausika_manage_boat_profile",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "action": {
    "enum": [
     "upsert",
     "delete",
     "set_default"
    ],
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "name": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "title": "Manage Boat Profile"
}
