 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "addresses": {
    "description": "2-3 wallet addresses to compare",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "depth": {
    "default": "light",
    "description": "Enrichment depth",
    "enum": [
     "light",
     "full"
    ],
    "type": "string"
   }
  },
  "required": [
   "addresses"
  ],
  "type": "object"
 },
 "name": "compare_wallets",
 "title": "Compare Wallets"
}
