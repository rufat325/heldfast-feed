     "archive",
     "dashboard",
     "data-artifact",
     "docs",
     "example",
     "openapi",
     "repo-registry",
     "sdk",
     "source-repo",
     "sse",
     "subnet-api",
     "subtensor-rpc",
     "subtensor-wss",
     "website"
