    ],
    "maxLength": 100,
    "type": "string"
   },
   "sort": {
    "description": "Column to rank the result by; pair with `order` for direction. Options are per-tool; see this parameter's enum.",
    "enum": [
     "adapter_score",
     "candidate_count",
     "completeness_score",
     "curation_level",
     "endpoint_count",
     "evidence_action",
     "identity_level",
     "identity_surface_count",
     "lane",
     "name",
     "netuid",
     "operational_interface_count",
     "priority_score",
     "profile_level",
     "review_state",
     "stale_candidate_count",
     "surface_count",
     "verified_candidate_count"
    ],
    "examples": [
     "adapter_score"
    ],
    "type": "string"
   }
  },
  "required": [
   "context"
  ],
  "type": "object"
 },
