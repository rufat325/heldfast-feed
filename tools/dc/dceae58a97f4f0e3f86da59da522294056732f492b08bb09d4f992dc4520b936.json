{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Change HDFS quota for a Data Forest account",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fileCountMillion": {
    "description": "File count limit in millions (1-5, default: 1)",
    "maximum": 5,
    "minimum": 1,
    "type": "number"
   },
   "id": {
    "description": "Account unique identifier (Base62-encoded UUID)",
    "maxLength": 22,
    "type": "string"
   },
   "namespace": {
    "description": "HDFS namespace (koya or tata)",
    "enum": [
     "koya",
     "tata"
    ],
    "type": "string"
   },
   "spaceTb": {
    "description": "Max storage in TB (200-500, 100TB increments, default: 200)",
    "maximum": 500,
    "minimum": 200,
    "type": "number"
   }
  },
  "required": [
   "id",
   "namespace",
   "fileCountMillion",
   "spaceTb"
  ],
  "type": "object"
 },
 "name": "ncloud_dataforest_set_quota"
}
