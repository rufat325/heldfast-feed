{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "A song's lyrics, its context (the story and theology behind it), or its full info (lyrics, context, style and where to listen).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "part": {
    "default": "lyrics",
    "enum": [
     "lyrics",
     "context",
     "info"
    ],
    "type": "string"
   },
   "slug": {
    "description": "A song slug, such as current.slug from attend, or one from browse.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "read_song",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "context": {
    "type": [
     "string",
     "null"
    ]
   },
   "lyrics": {
    "type": [
     "string",
     "null"
    ]
   },
   "next_steps": {
    "description": "What to do next. A step with a \"tool\" field can be taken with that tool.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "description": {
       "type": "string"
      }
     },
     "required": [
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "slug": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "slug",
   "title",
   "next_steps"
  ],
  "type": "object"
 },
 "title": "Read a song"
}
