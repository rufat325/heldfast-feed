{
 "_meta": {
  "openai/outputTemplate": "ui://generate-greetings/card-v1.html",
  "openai/toolInvocation/invoked": "Your greeting is ready",
  "openai/toolInvocation/invoking": "Creating your greeting\u2026",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "resourceUri": "ui://generate-greetings/card-v1.html",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://generate-greetings/card-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a greeting card"
 },
 "description": "Create a downloadable PNG greeting with occasion-matched background, curated phrases and optional decorations. Optional first name is rendered in this response only. Creates a reusable design link without the name, available to anyone with the link for 30 days. Free with watermark. Does not post to social networks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "background": {
    "default": "auto",
    "description": "auto matches the occasion; other categories still obey cultural safety rules.",
    "enum": [
     "auto",
     "all",
     "nature",
     "flowers",
     "animals",
     "coffee",
     "celebration",
     "Mare",
     "Laghi",
     "Fiumi",
     "Cascate",
     "Montagne",
     "Boschi",
     "Deserti",
     "Neve",
     "Cieli",
     "Prati"
    ],
    "type": "string"
   },
   "decorations": {
    "default": "random",
    "enum": [
     "random",
     "none"
    ],
    "type": "string"
   },
   "format": {
    "default": "4:5",
    "enum": [
     "9:16",
     "4:5",
     "1:1",
     "16:9"
    ],
    "type": "string"
   },
   "locale": {
    "default": "en",
    "description": "Language code; hi is Hindi. Use list_greeting_options for supported languages.",
    "enum": [
     "it",
     "en",
     "fr",
     "es",
     "de",
     "pt",
     "ar",
     "zh",
     "ja",
     "ko",
     "th",
     "ru",
     "hi"
    ],
    "type": "string"
   },
   "name": {
    "default": "",
    "description": "Optional first name, up to 30 characters. Omit sensitive or identifying details. Never stored with a shared design.",
    "maxLength": 100,
    "type": "string"
   },
   "occasion": {
    "default": "morning",
    "enum": [
     "morning",
     "afternoon",
     "evening",
     "night",
     "birthday",
     "congratulations",
     "christmas",
     "newyear",
     "lunarnewyear",
     "mothersday",
     "fathersday",
     "weddinganniversary",
     "anniversary",
     "ramadan",
     "eid",
     "thankyou",
     "getwell",
     "wedding",
     "newbaby",
     "graduation"
    ],
    "type": "string"
   },
   "previousCodes": {
    "default": [],
    "description": "Recent phrase codes from this conversation to avoid repeats; do not send chat history.",
    "items": {
     "maxLength": 100,
     "pattern": "^[a-z]+:[a-z]+:\\d+:\\d+:\\d+$",
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   },
   "style": {
    "default": "sweet",
    "enum": [
     "sweet",
     "cheerful",
     "simple"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_greeting_card",
 "title": "Create a greeting card"
}
