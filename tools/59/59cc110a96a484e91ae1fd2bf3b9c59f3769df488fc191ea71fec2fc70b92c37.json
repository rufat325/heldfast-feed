{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Run a RouterOS bandwidth test from the router to a remote host running a RouterOS btest server. Returns TX and RX throughput in Mbps. Duration capped at 20 seconds. Saturates the link \u2014 not auto-retried.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Remote host running RouterOS btest server",
    "type": "string"
   },
   "direction": {
    "default": "both",
    "description": "Test direction",
    "enum": [
     "send",
     "receive",
     "both"
    ],
    "type": "string"
   },
   "duration": {
    "default": 5,
    "description": "Test duration in seconds (max 20)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "protocol": {
    "default": "tcp",
    "description": "Test protocol",
    "enum": [
     "tcp",
     "udp"
    ],
    "type": "string"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "bandwidth_test",
 "title": "Bandwidth Test"
}
