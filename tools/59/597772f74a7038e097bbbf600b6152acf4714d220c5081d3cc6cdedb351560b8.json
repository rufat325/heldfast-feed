{
 "description": "List form submissions with filtering by form, date range, and search query.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "endAt": {
    "description": "End date for filtering submissions (ISO 8601)",
    "type": "string"
   },
   "formId": {
    "description": "Filter submissions by form ID",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of submissions to return",
    "type": "number"
   },
   "locationId": {
    "description": "Location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "page": {
    "description": "Page number for pagination",
    "type": "number"
   },
   "q": {
    "description": "Free-text search query",
    "type": "string"
   },
   "startAt": {
    "description": "Start date for filtering submissions (ISO 8601)",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId"
  ],
  "type": "object"
 },
 "name": "crm_get_form_submissions"
}
