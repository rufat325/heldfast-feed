{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create a workflow (admin): statuses/steps plus transitions. Omit \"queue\" to create a common workflow available to all queues. Attach issue types via issueTypeResolutions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Custom workflow id (auto \"W\u2026\" if omitted)",
    "type": "string"
   },
   "initialAction": {
    "additionalProperties": {},
    "description": "Initial transition: {\"name\": {\"ru\": \"\u041e\u0442\u043a\u0440\u044b\u0442\u044c\"}, \"target\": \"open\"}",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "issueTypeResolutions": {
    "description": "Allowed resolutions per issue type",
    "items": {
     "properties": {
      "issueType": {
       "type": [
        "string",
        "number"
       ]
      },
      "resolutions": {
       "items": {
        "type": [
         "string",
         "number"
        ]
       },
       "type": "array"
      }
     },
     "required": [
      "issueType",
      "resolutions"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "queue": {
    "description": "Bind to one queue; omit for a common workflow",
    "type": "string"
   },
   "steps": {
    "items": {
     "additionalProperties": {},
     "description": "Step object: {\"status\": \"closed\", \"statusType\": \"DONE\", \"description\": {\"ru\": \"\u2026\"}, \"actions\": [transition objects {\"id\": \"close\", \"name\": \u2026, \"target\": \u2026, \"screen\": \u2026}]}",
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "type": {
    "description": "\"VISUAL\"",
    "type": "string"
   }
  },
  "required": [
   "name",
   "initialAction",
   "steps"
  ],
  "type": "object"
 },
 "name": "create_workflow"
}
