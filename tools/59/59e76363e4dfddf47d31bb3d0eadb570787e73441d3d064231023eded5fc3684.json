{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List the individual mails of a SENS mail send request (GET /mail/v2/services/{serviceId}/requests/{requestId}/mails). Mails whose only recipients were unsubscribed/blocked are counted as FAILED.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "mailId": {
    "description": "Exact mail ID",
    "type": "string"
   },
   "pageNo": {
    "description": "Page number (0-based, default 0)",
    "minimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "description": "Items per page (1-1000, default 10)",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "recipientAddress": {
    "description": "Exact recipient address",
    "type": "string"
   },
   "requestId": {
    "description": "Request ID",
    "type": "string"
   },
   "serviceId": {
    "description": "Mail service ID in NRN form (e.g. ncp:mail:kr:1********2:main). Defaults to NCLOUD_SENS_MAIL_SERVICE_ID / NCLOUD_SENS_SERVICE_ID. Find it with ncloud_sens_list_projects (mailService.serviceId). A 'Forbidden' reply means that project's Mail channel is not enabled (useMail=false) \u2014 pick a project with useMail=true.",
    "type": "string"
   },
   "sort": {
    "description": "Sort as '{field},{direction}' (default 'createDateTime,desc')",
    "type": "string"
   },
   "status": {
    "description": "Mail statuses to include (repeatable)",
    "items": {
     "enum": [
      "PREPARING",
      "READY",
      "RESERVED",
      "SENDING",
      "COMPLETED",
      "FAILED",
      "PARTIAL_FAILED",
      "CANCELED"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Subject (partial match)",
    "type": "string"
   }
  },
  "required": [
   "requestId"
  ],
  "type": "object"
 },
 "name": "ncloud_sens_list_mails"
}
