{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new appointment/event on a GHL calendar.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Meeting address",
    "type": "string"
   },
   "appointmentStatus": {
    "type": "string"
   },
   "assignedUserId": {
    "description": "Assigned team member",
    "type": "string"
   },
   "calendarId": {
    "description": "Calendar ID",
    "type": "string"
   },
   "contactId": {
    "description": "Contact to book for",
    "type": "string"
   },
   "endTime": {
    "description": "Event end (ISO 8601)",
    "type": "string"
   },
   "locationId": {
    "type": "string"
   },
   "notes": {
    "description": "Internal notes",
    "type": "string"
   },
   "startTime": {
    "description": "Event start (ISO 8601)",
    "type": "string"
   },
   "status": {
    "default": "confirmed",
    "enum": [
     "confirmed",
     "cancelled",
     "showed",
     "noshow",
     "invalid"
    ],
    "type": "string"
   },
   "title": {
    "description": "Event title",
    "type": "string"
   }
  },
  "required": [
   "calendarId",
   "contactId",
   "startTime",
   "endTime"
  ],
  "type": "object"
 },
 "name": "ghl_create_event",
 "title": "Create Calendar Event"
}
