{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read a campaign's discovered posts with their drafted replies. Free. Use after generate_posts to inspect what was found, then review_posts / regenerate_replies to refine.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaign_id": {
    "type": "string"
   },
   "include_replies": {
    "description": "Default true",
    "type": "boolean"
   },
   "limit": {
    "description": "Default 50",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "enum": [
     "filtered",
     "discovered",
     "rejected"
    ],
    "type": "string"
   }
  },
  "required": [
   "campaign_id"
  ],
  "type": "object"
 },
 "name": "get_posts",
 "title": "Read discovered posts & reply drafts"
}
