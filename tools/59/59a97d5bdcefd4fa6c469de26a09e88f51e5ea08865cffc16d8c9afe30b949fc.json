   "affiliate_code": {
    "description": "Optional affiliate code for commission",
    "type": "string"
   },
   "amount_sol": {
    "description": "Bet amount in SOL",
    "type": "number"
   },
   "market": {
    "description": "Market public key",
    "type": "string"
   },
   "outcome": {
    "description": "Outcome to bet on",
    "enum": [
     "yes",
     "no"
    ],
    "type": "string"
   },
   "user_wallet": {
    "description": "User wallet public key",
    "type": "string"
   }
  },
  "required": [
   "market",
   "outcome",
   "amount_sol",
   "user_wallet"
  ],
  "type": "object"
 },
 "name": "build_bet_transaction"
}
