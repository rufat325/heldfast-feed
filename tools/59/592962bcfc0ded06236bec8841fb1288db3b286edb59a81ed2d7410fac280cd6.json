{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search public active WeJob formations.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "categories": {
    "description": "Comma-separated category names, e.g. D\u00e9veloppement & IT.",
    "type": "string"
   },
   "certification_type": {
    "description": "Comma-separated certification: certificat, diplome, attestation, bootcamp, aucun (certificate, diploma, none are accepted).",
    "type": "string"
   },
   "company": {
    "description": "Company name filter, e.g. WeJob S\u00e0rl.",
    "type": "string"
   },
   "duration_max": {
    "description": "Maximum duration in days, e.g. 30.",
    "type": "string"
   },
   "duration_min": {
    "description": "Minimum duration in days, e.g. 5.",
    "type": "string"
   },
   "formation_mode": {
    "description": "Comma-separated training mode: presentiel, distanciel, hybride (on-site, online, hybrid are accepted).",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of results.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "City or canton, e.g. Gen\u00e8ve, Vaud, Lausanne, Zurich. Comma-separate several places.",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "One-based result page number.",
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "default": "",
    "description": "Free-text search over titles, descriptions and programs, e.g. cybers\u00e9curit\u00e9.",
    "type": "string"
   },
   "skills": {
    "description": "Comma-separated hard skills, e.g. Java, SQL. Only matches skills listed on the offer: prefer query for a broad search.",
    "type": "string"
   },
   "sort": {
    "description": "Optional public result sort order.",
    "enum": [
     "newest",
     "oldest",
     "deadline_soon",
     "deadline_later",
     "price_asc",
     "price_desc",
     "duration_asc"
    ],
    "type": "string"
   },
   "tarif_max": {
    "description": "Maximum price as a number, e.g. 3000.",
    "type": "string"
   },
   "tarif_min": {
    "description": "Minimum price as a number, e.g. 500.",
    "type": "string"
   },
   "technologies": {
    "description": "Comma-separated technologies, e.g. React, AWS.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "wejob_search_formations",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "pagination": {
    "additionalProperties": false,
    "properties": {
     "has_more": {
      "type": "boolean"
     },
     "limit": {
      "type": "integer"
     },
     "page": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "page",
     "limit",
     "has_more"
    ],
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "company": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "logo": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search WeJob formations"
}
