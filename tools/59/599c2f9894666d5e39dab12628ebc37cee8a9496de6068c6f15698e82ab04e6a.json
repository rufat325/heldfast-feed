{
 "description": "Send a WhatsApp text message to a person or group.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "message": {
    "description": "The message text to send",
    "type": "string"
   },
   "recipient_jid": {
    "description": "The recipient JID (e.g., 123456789@c.us or 123456789-12345678@g.us)",
    "type": "string"
   }
  },
  "required": [
   "recipient_jid",
   "message"
  ],
  "type": "object"
 },
 "name": "send_message"
}
