{
 "description": "Autosave, rename, or move a file. Content writes use If-Match for safe concurrent edits. Free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "archived": {
    "type": "boolean"
   },
   "content": {
    "type": "string"
   },
   "folder_id": {
    "anyOf": [
     {
      "format": "uuid",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "id": {
    "format": "uuid",
    "type": "string"
   },
   "ifMatch": {
    "description": "ETag/version for safe content writes (required when changing content).",
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_file",
 "title": "Update a file"
}
