      "type": "string"
     },
     "reason": {
      "description": "Why an alert is or is not on offer.",
      "enum": [
       "eligible",
       "lottery_period",
       "out_of_season",
       "closed",
       "no_quota_now",
       "lottery_draw_only",
       "not_sold_online",
       "not_tracked"
      ]
     }
    },
    "required": [
