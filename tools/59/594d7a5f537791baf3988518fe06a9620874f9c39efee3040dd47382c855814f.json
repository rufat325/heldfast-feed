     "id",
     "slug",
     "name",
     "park",
     "usState",
     "pageUrl",
     "officialUrl",
     "issuance",
     "scanRoute",
     "alert",
     "season",
     "agencyDates",
     "releaseRules",
     "groupSizeLimit",
     "description",
     "checkedAt"
    ]
   },
   {
    "required": [
     "found"
    ]
   }
  ],
  "description": "The rules and sourced dates of one US backcountry or wilderness permit, or found: false.",
  "properties": {
