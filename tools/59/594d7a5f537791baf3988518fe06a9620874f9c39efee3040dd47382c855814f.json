  "title": "US backcountry permit rules and dates"
 },
 "description": "Get the rules for one US backcountry or wilderness permit: how it is issued (reservation, lottery or in person), its season, lottery and release dates, closures, group size limit, and the official agency page. Use it after search_permits, or when the person names a specific permit. Every date comes from an agency source; a date we cannot source is left out. Says whether PermitSnag can send an alert when the permit opens.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "permit": {
    "description": "The permit id or slug from search_permits, or its permitsnag.com page URL.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "permit"
  ],
  "type": "object"
 },
 "name": "get_permit_details",
 "outputSchema": {
