{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Split utility bills among housemates. Use when bills are shared, not when splitting rent (use split_rent).",
 "inputSchema": {
  "properties": {
   "bills": {
    "description": "Bills to split",
    "items": {
     "properties": {
      "amount": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "split": {
       "enum": [
        "equal",
        "by_occupants",
        "by_usage"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "amount",
      "split"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "people": {
    "description": "People sharing the house",
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "occupants": {
       "type": "number"
      },
      "usage_weight": {
       "type": "number"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "bills",
   "people"
  ],
  "type": "object"
 },
 "name": "split_utilities",
 "outputSchema": {
  "properties": {
   "split_results": {
    "description": "List of split results for each person",
    "items": {
     "properties": {
      "bill_details": {
       "description": "Details of each bill and the person's share",
       "items": {
        "properties": {
         "amount_owed": {
          "description": "Amount owed by the person for this bill",
          "type": "number"
         },
         "bill_name": {
          "description": "Name of the bill",
          "type": "string"
         }
        },
        "required": [
         "bill_name",
         "amount_owed"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "description": "Name of the person",
       "type": "string"
      },
      "total_owed": {
       "description": "Total amount owed by the person",
       "type": "number"
      }
     },
     "required": [
      "name",
      "total_owed",
      "bill_details"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "split_results"
  ],
  "type": "object"
 },
 "title": "Split utilities"
}
