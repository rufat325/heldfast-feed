{
 "annotations": {},
 "description": "Create (or update-if-exists) a RenderData with resolution / renderer / fps / frame range in one call. Returns the render_data handle for subsequent create_take / set_params chaining.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "fps": {
    "description": "Frame rate (also disables Use Project Frame Rate).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "frame_end": {
    "description": "Frame range end.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "frame_sequence": {
    "description": "Frame range mode (default \"manual\" when frame_start/end given).",
    "enum": [
     "manual",
     "current",
     "all",
     "preview",
     "custom"
    ],
    "type": "string"
   },
   "frame_start": {
    "description": "Frame range start.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "height": {
    "description": "Output height (pixels).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "make_active": {
    "description": "Make this the active render data.",
    "type": "boolean"
   },
   "name": {
    "description": "Render data name (used as handle).",
    "type": "string"
   },
   "params": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "boolean"
      },
      {
       "type": "number"
      },
      {
       "type": "string"
      },
      {
       "items": {
        "type": "number"
       },
       "type": "array"
      }
     ]
    },
    "description": "Extra {param_id: value} to apply (any RDATA_* id).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "parent": {
    "description": "Parent render_data name to nest under (default: top level).",
    "type": "string"
   },
   "renderer": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "enum": [
       "standard",
       "physical",
       "redshift",
       "octane",
       "cycles",
       "viewport"
      ],
      "type": "string"
     }
    ],
    "description": "Renderer plugin id, or alias: \"octane\"/\"standard\"/\"physical\"/\"redshift\"/\"cycles\"/\"viewport\"."
   },
   "update_if_exists": {
    "description": "If a render data with this name already exists, update it instead of creating.",
    "type": "boolean"
   },
   "width": {
    "description": "Output width (pixels).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_render_data",
 "title": "Create Render Data"
}
