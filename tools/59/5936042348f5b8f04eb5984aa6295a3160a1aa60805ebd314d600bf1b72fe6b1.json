{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search covered objectives"
 },
 "description": "Searches the public coverage catalog by name or alias, with optional region and activity filters. Coverage follows the current public scope; region filters include WA, OR, and BC. Informational only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activity": {
    "description": "Optional visible activity filter.",
    "enum": [
     "mountaineering",
     "skimo_splitboard",
     "rock_climbing"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of matching objectives.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Objective name or alias; matching ignores case and accents.",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   },
   "region": {
    "description": "Optional state or province filter.",
    "enum": [
     "WA",
     "OR",
     "BC"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_objectives",
 "title": "Search covered objectives"
}
