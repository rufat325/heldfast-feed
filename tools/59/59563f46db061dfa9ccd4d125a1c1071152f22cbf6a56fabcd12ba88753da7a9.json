{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Read selected course topics"},"description":"Read CRICOS course topics by code or URL. Defaults to core. Explicit nonempty sections replace the default: core, overview, fees, requirements, intakes, campuses, pathways, packages, similar. Topic options must be nested under their selected section. Full semantic entries are preserved; subsequent pages require unchanged contentVersion. Use fee years/audience, requirement topics, date/campus filters or pageSize to narrow large responses. includeEvidence explicitly requests provider evidence separately from sections; website OAuth is required only on the public endpoint. includeSimilar and unknown arguments are rejected. This public endpoint returns English natural-language text, preserving sources, conditions and pagination.","inputSchema":{"additionalProperties":false,"properties":{"campuses":{"additionalProperties":false,"properties":{"contentVersion":{"pattern":"^[a-f0-9]{64}$","type":"string"},"page":{"default":1,"minimum":1,"type":"integer"},"pageSize":{"default":10,"maximum":20,"minimum":1,"type":"integer"},"postcode":{"pattern":"^\\d{4}$","type":"string"},"regionalCategory":{"enum":["Category 2","Category 3"],"type":"string"},"state":{"enum":["ACT","NSW","NT","QLD","SA","TAS","VIC","WA"],"type":"string"},"status":{"default":"open","enum":["open","all"],"type":"string"}},"type":"object"},"course":{"minLength":4,"type":"string"},"fees":{"additionalProperties":false,"properties":{"audience":{"enum":["offshore","onshore","domestic","online","voe"],"type":"string"},"offers":{"additionalProperties":false,"properties":{"contentVersion":{"pattern":"^[a-f0-9]{64}$","type":"string"},"page":{"default":1,"minimum":1,"type":"integer"},"pageSize":{"default":10,"maximum":20,"minimum":1,"type":"integer"}},"type":"object"},"years":{"items":{"maximum":9999,"minimum":1900,"type":"integer"},"minItems":1,"type":"array"}},"typ