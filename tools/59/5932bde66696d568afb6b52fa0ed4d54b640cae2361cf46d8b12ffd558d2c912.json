{
 "description": "Tokenize a credit card server-side. Endpoint: POST /payment_token. WARNING: using this from your server subjects you to PCI audits \u2014 prefer iugu.js client-side tokenization in production.",
 "inputSchema": {
  "properties": {
   "account_id": {
    "description": "iugu account ID",
    "type": "string"
   },
   "data": {
    "description": "Card data",
    "properties": {
     "first_name": {
      "type": "string"
     },
     "last_name": {
      "type": "string"
     },
     "month": {
      "description": "Expiration month (MM)",
      "type": "string"
     },
     "number": {
      "description": "Card number",
      "type": "string"
     },
     "verification_value": {
      "description": "CVV",
      "type": "string"
     },
     "year": {
      "description": "Expiration year (YYYY)",
      "type": "string"
     }
    },
    "required": [
     "number",
     "verification_value",
     "first_name",
     "last_name",
     "month",
     "year"
    ],
    "type": "object"
   },
   "method": {
    "description": "Payment method (e.g., 'credit_card')",
    "type": "string"
   },
   "test": {
    "description": "Use test mode",
    "type": "boolean"
   }
  },
  "required": [
   "account_id",
   "method",
   "data"
  ],
  "type": "object"
 },
 "name": "create_payment_token"
}
