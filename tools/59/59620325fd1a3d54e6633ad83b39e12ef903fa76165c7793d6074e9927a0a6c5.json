{
 "description": "Find high-impression queries or pages whose CTR trails peers at the same position for snippet rewrite prioritization",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "by": {
    "default": "query",
    "description": "Dimension used to identify CTR gaps",
    "enum": [
     "query",
     "page"
    ],
    "type": "string"
   },
   "endDate": {
    "description": "End date in YYYY-MM-DD; defaults to today",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "description": "Maximum gaps to return; defaults to 50",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "minImpressions": {
    "description": "Minimum impressions required; defaults to 100",
    "minimum": 0,
    "type": "number"
   },
   "siteUrl": {
    "description": "Search Console property to analyze",
    "minLength": 1,
    "type": "string"
   },
   "startDate": {
    "description": "Start date in YYYY-MM-DD; defaults to the latest 28-day window",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "siteUrl"
  ],
  "type": "object"
 },
 "name": "ctr_gaps",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "gaps": {
    "description": "Rows underperforming their position peers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "ctr": {
       "description": "Actual click-through rate as a fraction",
       "type": "number"
      },
      "expectedCtr": {
       "description": "Peer average click-through rate at the rounded position",
       "type": "number"
      },
      "impressions": {
       "description": "Search impressions",
       "type": "number"
      },
      "keys": {
       "description": "Dimension values in request order",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "missedClicks": {
       "description": "Estimated clicks missed versus peer CTR",
       "type": "number"
      },
      "position": {
       "description": "Average search position",
       "type": "number"
      }
     },
     "required": [
      "keys",
      "impressions",
      "ctr",
      "expectedCtr",
      "position",
      "missedClicks"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "siteUrl": {
    "description": "Search Console property analyzed",
    "type": "string"
   },
   "truncated": {
    "description": "Whether Search Console held more than 5000 rows for this window, so the list was computed from the top rows only",
    "type": "boolean"
   },
   "window": {
    "additionalProperties": false,
    "description": "Analysis window",
    "properties": {
     "endDate": {
      "description": "Inclusive window end date",
      "type": "string"
     },
     "startDate": {
      "description": "Inclusive window start date",
      "type": "string"
     }
    },
    "required": [
     "startDate",
     "endDate"
    ],
    "type": "object"
   }
  },
  "required": [
   "siteUrl",
   "window",
   "truncated",
   "gaps"
  ],
  "type": "object"
 }
}
