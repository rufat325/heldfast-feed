{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Who am I"
 },
 "description": "Returns the signed-in Lightbringer user and organisation for this connection. Optionally includes up to 20 fellow organisation members with names, roles and a total count, with read consent. An unavailable member lookup is reported separately from the profile.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "include_members": {
    "description": "Includes a bounded member roster with read consent",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "whoami",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "members": {
    "additionalProperties": false,
    "properties": {
     "members": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "role": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "role"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     "totalCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "members",
     "totalCount"
    ],
    "type": "object"
   },
   "members_error": {
    "type": "string"
   },
   "organisation": {
    "additionalProperties": false,
    "properties": {
     "country": {
      "type": "string"
     },
     "name": {
      "type": [
       "string",
       "null"
      ]
     },
     "state": {
      "maxLength": 128,
      "type": "string"
     },
     "website": {
      "maxLength": 2048,
      "type": "string"
     }
    },
    "type": "object"
   },
   "user": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": [
       "string",
       "null"
      ]
     },
     "role": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   }
  },
  "required": [
   "user",
   "organisation"
  ],
  "type": "object"
 },
 "title": "Who am I"
}
