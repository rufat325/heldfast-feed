{
 "description": "Create a service order for the authenticated customer. Call calculate_quote first to get the price and recommended durationHours, then call this once the customer agrees.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "Service address.",
    "properties": {
     "addressLine1": {
      "type": "string"
     },
     "city": {
      "type": "string"
     },
     "country": {
      "description": "Defaults to CA.",
      "enum": [
       "CA",
       "US"
      ],
      "type": "string"
     },
     "postalCode": {
      "type": "string"
     },
     "state": {
      "description": "Province/state abbreviation (e.g. \"ON\", \"FL\").",
      "type": "string"
     },
     "unit": {
      "type": "string"
     }
    },
    "required": [
     "addressLine1",
     "city",
     "state",
     "postalCode"
    ],
    "type": "object"
   },
   "areaRugs": {
    "type": "number"
   },
   "backyard": {
    "type": "boolean"
   },
   "baseboards": {
    "type": "boolean"
   },
   "basement": {
    "type": "boolean"
   },
   "bathrooms": {
    "type": "number"
   },
   "bedrooms": {
    "type": "number"
   },
   "bookIfPaymentOnFile": {
    "description": "If true and a payment method is saved, immediately confirms the booking.",
    "type": "boolean"
   },
   "carsToClear": {
    "type": "number"
   },
   "category": {
    "description": "Service category.",
    "enum": [
     "Cleaning",
     "Lawn-Care",
     "Exterior Cleaning",
     "Car Detailing",
     "Snow-Removal",
     "Tire-Changing"
    ],
    "type": "string"
   },
   "clayAndSeal": {
    "type": "boolean"
   },
   "cleaningSupplies": {
    "type": "boolean"
   },
   "comment": {
    "description": "Optional notes for the service provider.",
    "type": "string"
   },
   "drivewayType": {
    "enum": [
     "single",
     "double"
    ],
    "type": "string"
   },
   "durationHours": {
    "description": "Estimated duration in hours (0.5 increments). Use the value from calculate_quote.",
    "type": "number"
   },
   "edging": {
    "type": "boolean"
   },
   "engineBay": {
    "type": "boolean"
   },
   "excessDirt": {
    "type": "boolean"
   },
   "femaleCleaner": {
    "type": "boolean"
   },
   "fridgeInside": {
    "type": "boolean"
   },
   "frontWalkway": {
    "type": "boolean"
   },
   "garage": {
    "type": "boolean"
   },
   "groutCleaning": {
    "type": "boolean"
   },
   "gutterCleaning": {
    "type": "boolean"
   },
   "hallway": {
    "type": "boolean"
   },
   "hasPets": {
    "type": "boolean"
   },
   "iceBuildup": {
    "type": "boolean"
   },
   "iceSalting": {
    "type": "boolean"
   },
   "kitchenDeep": {
    "type": "boolean"
   },
   "kitchenSurface": {
    "type": "boolean"
   },
   "lawnCleanup": {
    "type": "boolean"
   },
   "leafRemoval": {
    "type": "boolean"
   },
   "livingRoom": {
    "type": "boolean"
   },
   "ovenInside": {
    "type": "boolean"
   },
   "overgrown": {
    "type": "boolean"
   },
   "petHairRemoval": {
    "type": "boolean"
   },
   "scheduledTime": {
    "description": "ISO 8601 datetime string (e.g. \"2025-07-15T10:00:00-04:00\"). Always include the timezone offset.",
    "type": "string"
   },
   "sendQuoteSMS": {
    "description": "Send the customer an SMS summary.",
    "type": "boolean"
   },
   "serviceType": {
    "description": "Specific service type.",
    "enum": [
     "DEEP-CLEAN",
     "POST-CONSTRUCTION",
     "AIRBNB-CLEAN",
     "MOVE-IN-OUT-CLEAN",
     "GENERAL-CLEAN",
     "CARPET-CLEAN",
     "LAWNCARE-LAWNMOWING",
     "LAWNCARE-MAINTENANCE",
     "LAWNCARE-PLANTING",
     "LAWNCARE-WEED-REMOVAL",
     "GENERAL",
     "CLEAN_CAR_EXTERIOR",
     "CLEAN_CAR_INTERIOR",
     "CLEAN_CAR_COMPLETE",
     "SNOW_REMOVAL",
     "TIRE-CHANGE-STANDARD",
     "TIRE-CHANGE-SEASONAL"
    ],
    "type": "string"
   },
   "soffitsAndFascia": {
    "type": "boolean"
   },
   "spotCleanDoors": {
    "type": "boolean"
   },
   "spotCleanWalls": {
    "type": "boolean"
   },
   "staircase": {
    "type": "boolean"
   },
   "tireCount": {
    "type": "number"
   },
   "vehicleType": {
    "enum": [
     "sedan",
     "suv",
     "van",
     "truck",
     "motorcycle"
    ],
    "type": "string"
   },
   "watering": {
    "type": "boolean"
   },
   "windowPanes": {
    "type": "number"
   },
   "windowScreens": {
    "type": "number"
   },
   "windows": {
    "type": "boolean"
   },
   "windrowClearing": {
    "type": "boolean"
   },
   "yardSize": {
    "enum": [
     "standard",
     "large"
    ],
    "type": "string"
   }
  },
  "required": [
   "category",
   "scheduledTime",
   "address"
  ],
  "type": "object"
 },
 "name": "create_order"
}
