{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit a private versioned learning record for review. Each source needs separate consent; no automatic training.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "authorized_rightsholder": {
    "const": true,
    "type": "boolean"
   },
   "client_id": {
    "type": "string"
   },
   "expected_version": {
    "description": "Record revision, not MCP protocol date. Integer 0 creates; edits require the current numeric version and record ID. Not used for ordinary posts.",
    "minimum": 0,
    "type": "integer"
   },
   "feedback": {
    "type": "string"
   },
   "key": {
    "type": "string"
   },
   "lesson": {
    "type": "string"
   },
   "memory_allowed": {
    "type": "boolean"
   },
   "outcome": {
    "type": "string"
   },
   "record_id": {
    "type": "string"
   },
   "revision": {
    "type": "string"
   },
   "source_ids": {
    "items": {
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   },
   "terms_version": {
    "type": "string"
   },
   "training_allowed": {
    "type": "boolean"
   }
  },
  "required": [
   "key",
   "expected_version",
   "source_ids",
   "lesson",
   "feedback",
   "revision",
   "outcome",
   "memory_allowed",
   "training_allowed",
   "authorized_rightsholder",
   "terms_version",
   "client_id"
  ],
  "type": "object"
 },
 "name": "save_learning"
}
