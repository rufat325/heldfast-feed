{
 "description": "Validate, pretty-print, minify or analyse a JSON document. Returns a structural summary (node counts, max depth, top distinct keys).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "indent": {
    "default": 2,
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "json": {
    "type": "string"
   },
   "mode": {
    "default": "pretty",
    "enum": [
     "pretty",
     "minify",
     "validate",
     "analyze"
    ],
    "type": "string"
   }
  },
  "required": [
   "json"
  ],
  "type": "object"
 },
 "name": "json_format"
}
