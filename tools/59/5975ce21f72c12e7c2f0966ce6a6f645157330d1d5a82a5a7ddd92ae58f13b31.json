{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"Prepare one seller briefing that combines proposed sale-price scenarios with available county property records and dated market context (licensed listing and price-index trends when sale-price snapshots are paused). Includes assumptions, missing information and source attributions. Missing or old data must remain visible; supplied prices are scenarios, not a CMA or appraisal. The result includes an 'attributions' array (upstream source lines and the NWMLS/DOR/county non-affiliation line) and a professional-advice disclaimer \u2014 pass both through to end users.","inputSchema":{"$defs":{"AgentApiDeadlinesRequest":{"additionalProperties":false,"properties":{"closing":{"anyOf":[{"format":"date","type":"string"},{"type":"null"}],"default":null,"title":"Closing"},"financing_days":{"default":21,"maximum":120,"minimum":1,"title":"Financing Days","type":"integer"},"mutual_acceptance":{"format":"date","title":"Mutual Acceptance","type":"string"}},"required":["mutual_acceptance"],"title":"AgentApiDeadlinesRequest","type":"object"},"MarketLocator":{"additionalProperties":false,"properties":{"area":{"maxLength":100,"minLength":1,"title":"Area","type":"string"},"region_type":{"anyOf":[{"enum":["zip","neighborhood","city","county"],"type":"string"},{"type":"null"}],"default":null,"title":"Region Type"}},"required":["area"],"title":"MarketLocator","type":"object"},"MonthlyPaymentRequest":{"additionalProperties":false,"properties":{"annual_home_insurance":{"anyOf":[{"exclusiveMaximum":500000000,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Annual Home Insurance"},"annual_property_tax":{"anyOf":[{"exclusiveMaximum":500000000,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Annual Property Tax"},"down_payment":{"anyOf":[{"exclusiveMaximum":500000000,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Down Payment"},"down_payment_pct":{"anyOf":[{"maximum":100,"minimum":0,"type":"number"},{"type":"null"}],"default":null,"description":"Percent, e.g. 20 means 20%; omit both down-payment fields to assume 20%.","title":"Down Payment Pct"},"interest_rate_pct":{"description":"User-supplied annual rate, e.g. 6.5 means 6.5%.","exclusiveMinimum":0,"maximum":25,"title":"Interest Rate Pct","type":"number"},"loan_term_years":{"default":30,"maximum":40,"minimum":1,"title":"Loan Term Years","type":"integer"},"monthly_hoa":{"default":0,"exclusiveMaximum":500000000,"minimum":0,"title":"Monthly Hoa","type":"integer"},"pmi_pct":{"default":0.5,"maximum":10,"minimum":0,"title":"Pmi Pct","type":"number"},"property_tax_rate_pct":{"default":0.92,"maximum":10,"minimum":0,"title":"Property Tax Rate Pct","type":"number"},"sale_price":{"exclusiveMaximum":500000000,"exclusiveMinimum":0,"title":"Sale Price","type":"integer"}},"required":["sale_price","interest_rate_pct"],"title":"MonthlyPaymentRequest","type":"object"},"PropertyLocator":{"additionalProperties":false,"anyOf":[{"properties":{"address":{"minLength":1}},"required":["address"]},{"required":["parcel_id"]}],"properties":{"address":{"default":"","maxLength":200,"title":"Address","type":"string"},"city":{"anyOf":[{"maxLength":100,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"City"},"parcel_id":{"anyOf":[{"maxLength":100,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Parcel Id"},"zip_code":{"anyOf":[{"pattern":"^\\d{5}$","type":"string"},{"type":"null"}],"default":null,"title":"Zip Code"}},"title":"PropertyLocator","type":"object"},"SellerScenario":{"additionalProperties":false,"properties":{"commission_rate":{"default":0.05,"description":"Total commission as a decimal fraction: 0.05 means 5%. Commission is negotiable.","maximum":0.15,"minimum":0,"title":"Commission Rate","type":"number"},"concessions":{"anyOf":[{"exclusiveMaximum":500000000,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Concessions"},"has_hoa":{"default":false,"title":"Has Hoa","type":"boolean"},"label":{"maxLength":80,"minLength":1,"title":"Label","type":"string"},"mortgage_balance":{"anyOf":[{"exclusiveMaximum":500000000,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"description":"Omitted/null means unknown; 0 explicitly means no payoff.","title":"Mortgage Balance"},"property_tax_proration":{"default":0,"exclusiveMaximum":500000000,"minimum":0,"title":"Property Tax Proration","type":"integer"},"sale_price":{"exclusiveMaximum":500000000,"exclusiveMinimum":0,"title":"Sale Price","type":"integer"}},"required":["label","sale_price"],"title":"SellerScenario","type":"object"}},"additionalProperties":false,"properties":{"county":{"maxLength":40,"minLength":1,"title":"County","type":"string"},"deadlines":{"anyOf":[{"$ref":"#/$defs/AgentApiDeadlinesRequest"},{"type":"null"}],"default":null},"includePermits":{"default":false,"description":"Include dated permit evidence for the supplied property; currently City of Seattle building permits.","title":"Include Permits","type":"boolean"},"market":{"anyOf":[{"$ref":"#/$defs/MarketLocator"},{"type":"null"}],"default":null},"monthlyPayment":{"anyOf":[{"$ref":"#/$defs/MonthlyPaymentRequest"},{"type":"null"}],"default":null},"property":{"anyOf":[{"$ref":"#/$defs/PropertyLocator"},{"type":"null"}],"default":null},"scenarios":{"items":{"$ref":"#/$defs/SellerScenario"},"maxItems":3,"minItems":2,"title":"Scenarios","type":"array"}},"required":["county","scenarios"],"title":"SellerPacketRequest","type":"object"},"name":"wa_seller_packet","title":"Build a Washington seller decision packet"}
