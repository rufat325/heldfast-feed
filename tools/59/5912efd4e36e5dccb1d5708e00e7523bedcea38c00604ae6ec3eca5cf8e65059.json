{
 "annotations": {
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "This is a multi-agent workspace. Run this tool at the start of every working session to check in and receive coordination instructions. Provide a concise gist of what you're working on and the file paths you expect to modify (if known). If you already have a worker ID from a previous check-in, pass it to update your session.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "files": {
    "description": "File paths you expect to modify. Omit if unknown \u2014 update later by calling again with your worker ID.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "gist": {
    "description": "Concise description of what you are working on.",
    "minLength": 1,
    "type": "string"
   },
   "workerId": {
    "description": "Your worker ID from a previous check-in. Omit on first call to receive a new one. Pass to update your session.",
    "pattern": "^[A-Z0-9]{6}$",
    "type": "string"
   }
  },
  "required": [
   "gist"
  ],
  "type": "object"
 },
 "name": "shift_check_in",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "workerId",
     "gist",
     "files",
     "checkedInAt",
     "activeWorkers"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "activeWorkers": {
    "description": "All currently active workers.",
    "items": {
     "additionalProperties": false,
     "description": "An active worker session.",
     "properties": {
      "checkedInAt": {
       "description": "ISO 8601 check-in timestamp.",
       "type": "string"
      },
      "files": {
       "description": "Declared file paths.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "gist": {
       "description": "What the worker is doing.",
       "type": "string"
      },
      "workerId": {
       "description": "Worker ID.",
       "type": "string"
      }
     },
     "required": [
      "workerId",
      "gist",
      "files",
      "checkedInAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "checkedInAt": {
    "description": "ISO 8601 timestamp of your check-in.",
    "type": "string"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `unknown_worker`: The supplied workerId has no active session \u2014 it was checked out, or the server restarted. Other values are possible when a failure originates below the handler.",
        "examples": [
         "unknown_worker"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "files": {
    "description": "Your declared file paths.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "gist": {
    "description": "Your current working gist.",
    "type": "string"
   },
   "workerId": {
    "description": "Your assigned worker ID.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Shift Check In"
}
