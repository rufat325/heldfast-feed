{"annotations":{"destructiveHint":true,"openWorldHint":true,"readOnlyHint":false,"title":"Modify a verified booking"},"description":"Keeps the 4-hour change lock and new-pickup notice (12h transfers, 3h hourly). Unpaid tip-only edits apply; paid/pending-payment tips need staff approval. Other price increases and stops still need approval; never charges/refunds.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"changes":{"additionalProperties":false,"properties":{"bags":{"maximum":20,"minimum":0,"type":"integer"},"dropoff_address":{"maxLength":300,"minLength":3,"type":"string"},"flight_number":{"maxLength":20,"type":"string"},"gratuity_percent":{"anyOf":[{"const":0,"type":"number"},{"const":15,"type":"number"},{"const":18,"type":"number"},{"const":20,"type":"number"},{"const":25,"type":"number"}]},"passenger_first_name":{"maxLength":80,"minLength":1,"type":"string"},"passenger_last_name":{"maxLength":80,"minLength":1,"type":"string"},"passenger_phone":{"maxLength":40,"minLength":10,"pattern":"^[+\\d\\s().-]*$","type":"string"},"passengers":{"maximum":14,"minimum":1,"type":"integer"},"pickup_address":{"maxLength":300,"minLength":3,"type":"string"},"pickup_date":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"pickup_time":{"pattern":"^\\d{1,2}:\\d{2}$","type":"string"},"special_requests":{"maxLength":500,"type":"string"},"stops":{"items":{"maxLength":300,"minLength":3,"type":"string"},"maxItems":3,"type":"array"},"vehicle_type":{"enum":["sedan","suv"],"type":"string"}},"type":"object"},"verification_token":{"pattern":"^[a-f0-9]{64}$","type":"string"}},"required":["verification_token","changes"],"type":"object"},"name":"iride_modify_booking","title":"Modify a verified booking"}
