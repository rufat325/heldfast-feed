{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add one document/link to a voice agent's knowledge base. Requires the OWNER or ADMIN role. The server fetches and embeds the content in the background (status moves from pending to completed).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "link",
     "presentation"
    ],
    "type": "string"
   },
   "agentId": {
    "minLength": 1,
    "type": "string"
   },
   "contentType": {
    "enum": [
     "video",
     "pdf",
     "image"
    ],
    "type": "string"
   },
   "description": {
    "maxLength": 1000,
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "url",
   "title",
   "description",
   "action"
  ],
  "type": "object"
 },
 "name": "create_voice_agent_resource",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Response payload from the Speak AI API"
   }
  },
  "type": "object"
 },
 "title": "Create Voice Agent Resource"
}
