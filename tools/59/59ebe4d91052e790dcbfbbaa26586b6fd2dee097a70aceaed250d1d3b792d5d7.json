{
 "description": "Write a model prediction onto an Open Label task. Predictions render in the labeling editor as editable pre-labels the annotator can accept or fix. The result is an array of editor result entries. Requires open-label:write scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confidence": {
    "description": "Prediction confidence (0-1).",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "modelName": {
    "description": "Model name shown on the pre-label chip.",
    "type": "string"
   },
   "projectId": {
    "description": "The Open Label project id.",
    "type": "string"
   },
   "result": {
    "description": "Editor result entries.",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "taskId": {
    "description": "The task id.",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "taskId",
   "result"
  ],
  "type": "object"
 },
 "name": "open_label_create_prediction",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
