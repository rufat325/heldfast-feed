{
 "description": "Update authentication credentials. All values are saved to local database \u2014 next session auto-restores them.\nGet token and session_id from browser DevTools \u2192 Network tab \u2192 copy from any API request headers",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_url": {
    "description": "API base URL (e.g. https://api.storecake.io)",
    "type": "string"
   },
   "session_id": {
    "description": "Session ID (from x-session-id header)",
    "type": "string"
   },
   "token": {
    "description": "JWT Bearer token (from Authorization header)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "update_auth"
}
