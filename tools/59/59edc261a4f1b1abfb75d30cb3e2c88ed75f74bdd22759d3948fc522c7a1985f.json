{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Share a file or shared drive by creating a new permission. Grants access to a user, group, domain, or anyone.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Domain (required for type domain, e.g. \"example.com\")",
    "type": "string"
   },
   "emailAddress": {
    "description": "Email address of user or group (required for type user/group)",
    "type": "string"
   },
   "emailMessage": {
    "description": "Custom message to include in the notification email",
    "type": "string"
   },
   "fileId": {
    "description": "The ID of the file or shared drive",
    "type": "string"
   },
   "moveToNewOwnersRoot": {
    "default": false,
    "description": "Move the file to the new owner's My Drive root folder (only for transferOwnership)",
    "type": "boolean"
   },
   "role": {
    "description": "The role granted by this permission",
    "enum": [
     "owner",
     "organizer",
     "fileOrganizer",
     "writer",
     "commenter",
     "reader"
    ],
    "type": "string"
   },
   "sendNotificationEmail": {
    "default": true,
    "description": "Send a notification email when sharing",
    "type": "boolean"
   },
   "supportsAllDrives": {
    "default": true,
    "description": "Support shared drives",
    "type": "boolean"
   },
   "transferOwnership": {
    "default": false,
    "description": "Whether to transfer ownership to the specified user (role must be owner)",
    "type": "boolean"
   },
   "type": {
    "description": "The type of grantee: user, group, domain, or anyone",
    "enum": [
     "user",
     "group",
     "domain",
     "anyone"
    ],
    "type": "string"
   },
   "useDomainAdminAccess": {
    "default": false,
    "description": "Issue the request as a domain administrator",
    "type": "boolean"
   }
  },
  "required": [
   "fileId",
   "type",
   "role"
  ],
  "type": "object"
 },
 "name": "permission_create",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "deleted": {
    "type": "boolean"
   },
   "displayName": {
    "type": "string"
   },
   "domain": {
    "type": "string"
   },
   "emailAddress": {
    "type": "string"
   },
   "expirationTime": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "pendingOwner": {
    "type": "boolean"
   },
   "photoLink": {
    "type": "string"
   },
   "role": {
    "enum": [
     "owner",
     "organizer",
     "fileOrganizer",
     "writer",
     "commenter",
     "reader"
    ],
    "type": "string"
   },
   "type": {
    "enum": [
     "user",
     "group",
     "domain",
     "anyone"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "type",
   "role"
  ],
  "type": "object"
 },
 "title": "Create permission"
}
