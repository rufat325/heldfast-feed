{
 "description": "Delete Gmail labels permanently (irreversible). System labels (INBOX, SENT, etc.) cannot be deleted.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ids": {
    "description": "Gmail label IDs to delete",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "label-delete",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "failureCount": {
        "description": "Number of labels that failed to delete",
        "type": "number"
       },
       "results": {
        "description": "Individual results for each label",
        "items": {
         "additionalProperties": false,
         "properties": {
          "error": {
           "description": "Error message if operation failed",
           "type": "string"
          },
          "id": {
           "description": "Label ID",
           "type": "string"
          },
          "success": {
           "description": "Whether the operation succeeded",
           "type": "boolean"
          }
         },
         "required": [
          "id",
          "success"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "successCount": {
        "description": "Number of labels successfully deleted",
        "type": "number"
       },
       "totalRequested": {
        "description": "Total number of labels requested to delete",
        "type": "number"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "totalRequested",
       "successCount",
       "failureCount",
       "results"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
