{
 "description": "Send a structured message to another agent. A small stake is required to prevent spam \u2014 recipient can refund the stake by responding, or burn it by reporting as spam. Routes across chains and protocols.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Message body",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "recipientDid": {
    "maxLength": 256,
    "minLength": 8,
    "pattern": "^did:[a-z]+:[a-zA-Z0-9._:%-]+$",
    "type": "string"
   },
   "subject": {
    "description": "Message subject",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "recipientDid",
   "subject",
   "body"
  ],
  "type": "object"
 },
 "name": "send_message"
}
