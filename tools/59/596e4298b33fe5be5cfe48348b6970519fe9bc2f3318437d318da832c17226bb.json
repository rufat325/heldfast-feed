 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Runs vision OCR on an already-uploaded FAST (Founder / Advisor Standard Template) advisor agreement PDF for the active company and returns the grant summary it states \u2014 advisor_name, company_name, tier, engagement_level, equity_percentage, shares, effective_date, vesting_total_months, vesting_cliff_months, vesting_frequency, signed, signature_date and governing_law \u2014 WITHOUT persisting anything. Empty string / 0 / false means the value was not stated in the document; never fabricate one. A vesting_cliff_months of 0 is a real answer, not a missing one: a FAST that says \"Cliff: None\" has no cliff. Flow: first call GetOcrUploadURL with kind=FAST and upload the PDF, then call this tool with the returned source_s3_uri. To persist the grant, pass the extracted terms and the SAME source_s3_uri to CreateCapTableAgreement with type=CAP_TABLE_AGREEMENT_TYPE_FAST \u2014 preserve the vesting fields, do not drop them.",
 "inputSchema": {
  "properties": {
   "agentCode": {
    "maxLength": 100,
    "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)?$",
    "type": "string"
   },
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "sourceS3Uri": {
    "maxLength": 2048,
    "minLength": 1,
    "pattern": "^s3://[a-z0-9.-]+/.+$",
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "name": "formation_extract_fast_terms_ocr",
 "outputSchema": {
  "properties": {
   "fastTerms": {
    "anyOf": [
     {
      "properties": {
       "advisorName": {
        "anyOf": [
         {
          "description": "Human-readable name (1-255 Unicode chars).",
          "properties": {
           "value": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
           }
          },
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "advisorTitle": {
        "type": "string"
       },
       "companyName": {
        "anyOf": [
         {
          "description": "Human-readable name (1-255 Unicode chars).",
          "properties": {
           "value": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
           }
          },
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "effectiveDate": {
        "type": "string"
       },
       "engagementLevel": {
        "type": "string"
       },
       "equityPercentage": {
        "type": "string"
       },
       "governingLaw": {
        "type": "string"
       },
       "securityType": {
        "type": "string"
       },
       "shares": {
        "type": "string"
       },
       "signatureDate": {
        "type": "string"
       },
       "signed": {
        "type": "boolean"
       },
       "tier": {
        "type": "string"
       },
       "vestingCliffMonths": {
        "type": "integer"
       },
       "vestingFrequency": {
        "type": "string"
       },
       "vestingTotalMonths": {
        "type": "integer"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "ocrConfidence": {
    "type": "string"
   },
   "sourceS3Uri": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Extract Fast Terms OCR"
}
