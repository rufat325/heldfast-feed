 "description": "Audit a pagination contract for the ways it loses or repeats rows. The central finding is the one almost every paginated API has at first: a sort on a non-unique field with no unique tiebreaker, so rows that compare equal have no defined order and a caller walking the pages can get one row twice and never get its neighbour, with nothing failing. Also reports offset pagination over a mutable sort, an unbounded page size, contradictory bounds, and a cursor contract that also takes an offset. Pay 240000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contract": {
    "description": "The pagination contract: style, page_size_default, page_size_max, max_total_results, sort as an ordered list of { field, unique, mutable }, offset_parameter, cursor_stable_across_writes and total_count_semantics. Uniqueness and mutability must be declared, because neither can be derived from a field name. Nothing is fetched and nothing is executed, so an arbitrary configuration can be audited without access to the system it governs.",
    "example": {
     "offset_parameter": "offset",
     "page_size_default": 100,
     "sort": [
      {
       "field": "updated_at",
       "mutable": true
      }
     ],
     "style": "offset"
    },
    "properties": {
     "max_total_results": {
      "minimum": 1,
      "type": "integer"
     },
     "page_size_default": {
      "minimum": 1,
      "type": "integer"
     },
     "page_size_max": {
      "minimum": 1,
      "type": "integer"
     },
     "sort": {
      "items": {
       "properties": {
        "field": {
         "maxLength": 200,
         "type": "string"
        },
        "mutable": {
         "type": "boolean"
        },
        "unique": {
         "type": "boolean"
        }
       },
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     "style": {
      "enum": [
       "cursor",
       "keyset",
       "offset",
       "page"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "contract"
  ],
  "type": "object"
 },
 "name": "pagination_contract_audit",
