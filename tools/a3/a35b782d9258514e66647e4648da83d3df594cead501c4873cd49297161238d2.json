{
 "description": "Search CanonicAI answers by simple deterministic token scoring over question, shortAnswer, and answer fields.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum matches to return.",
    "minimum": 0,
    "type": "integer"
   },
   "q": {
    "description": "Search query.",
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_answers",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "matches": {
    "items": {
     "properties": {
      "citationCount": {
       "type": "integer"
      },
      "id": {
       "type": "string"
      },
      "jsonUrl": {
       "format": "uri",
       "type": "string"
      },
      "question": {
       "type": "string"
      },
      "score": {
       "type": "integer"
      },
      "shortAnswer": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "score",
      "slug",
      "id",
      "question",
      "url",
      "jsonUrl",
      "citationCount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   }
  },
  "required": [
   "query",
   "count",
   "matches"
  ],
  "type": "object"
 }
}
