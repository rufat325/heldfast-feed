{
 "description": "List execution history for a specific job",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Job UUID",
    "type": "string"
   },
   "max": {
    "description": "Max results (default 20)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "succeeded",
     "failed",
     "aborted",
     "running",
     "timedout"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "rundeck_get_job_executions"
}
