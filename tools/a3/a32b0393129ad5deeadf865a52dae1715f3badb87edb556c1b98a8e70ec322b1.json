    "description": "EDINET document ID (8 characters), e.g. S100ABCD",
    "maxLength": 12,
    "type": "string"
   }
  },
  "required": [
   "doc_id"
  ],
  "type": "object"
 },
 "name": "edinet_filing_relations",
