{
 "description": "Create a Z Image task on RunAPI (text to image). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "aspect_ratio": {
    "description": "Declared type: string. Known values: \"1:1\", \"4:3\", \"3:4\", \"16:9\", \"9:16\".",
    "type": "string"
   },
   "callback_url": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "enable_safety_checker": {
    "description": "Declared type: boolean.",
    "type": "boolean"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "prompt",
   "aspect_ratio"
  ],
  "type": "object"
 },
 "name": "text_to_image"
}
