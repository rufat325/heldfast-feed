{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Completed PDF"
 },
 "description": "Fetch the completed PDF. Use mode: 'base64' to get content for displaying in an artifact or chat (embed as data:application/pdf;base64,{pdf_base64}). Default 'url' mode returns a shareable link.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "document_id": {
    "minLength": 1,
    "type": "string"
   },
   "file_format": {
    "default": "pdf",
    "enum": [
     "pdf",
     "zip"
    ],
    "type": "string"
   },
   "include_audit_page": {
    "default": true,
    "type": "boolean"
   },
   "mode": {
    "default": "url",
    "enum": [
     "url",
     "base64",
     "file"
    ],
    "type": "string"
   },
   "save_to_path": {
    "type": "string"
   }
  },
  "required": [
   "document_id"
  ],
  "type": "object"
 },
 "name": "document_completed_pdf"
}
