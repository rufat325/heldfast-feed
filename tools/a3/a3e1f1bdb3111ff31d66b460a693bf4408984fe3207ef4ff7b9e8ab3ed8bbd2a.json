{
 "description": "Generate a pre / during / post hydration plan for a single training session or event. Based on ACSM, NATA, and IOC guidelines. Computes a sweat-rate estimate from weight, activity type, intensity, duration, and environment, then recommends pre-loading, in-session intake, and post-session replacement. \u2014 powered by Vari (https://getvari.app)",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activity": {
    "enum": [
     "running",
     "cycling",
     "swimming",
     "hiit",
     "weightlifting",
     "team_sports",
     "tennis",
     "hiking",
     "yoga",
     "hot_yoga"
    ],
    "type": "string"
   },
   "duration_minutes": {
    "maximum": 600,
    "minimum": 10,
    "type": "integer"
   },
   "environment": {
    "enum": [
     "indoor_cool",
     "indoor",
     "outdoor_cool",
     "outdoor_mild",
     "outdoor_warm",
     "outdoor_hot",
     "outdoor_humid"
    ],
    "type": "string"
   },
   "intensity": {
    "enum": [
     "low",
     "moderate",
     "high",
     "very_high"
    ],
    "type": "string"
   },
   "is_acclimatized": {
    "type": "boolean"
   },
   "weight_kg": {
    "maximum": 150,
    "minimum": 35,
    "type": "number"
   }
  },
  "required": [
   "weight_kg",
   "activity",
   "intensity",
   "duration_minutes",
   "environment"
  ],
  "type": "object"
 },
 "name": "athlete_hydration_plan"
}
