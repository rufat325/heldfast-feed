    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "milestoneSetId",
   "milestoneId",
   "title"
  ],
  "type": "object"
 },
 "name": "save_work_item",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
