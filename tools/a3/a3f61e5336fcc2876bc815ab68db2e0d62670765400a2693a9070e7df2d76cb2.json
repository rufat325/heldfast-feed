{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Fetch verified Thirukkural couplets. CALL FIRST for ANY personal, emotional, moral, or life-guidance message \u2014 betrayal, lies, friendship, love, family, grief, anger, worry, anxiety, discipline, wealth, work, learning, meaning \u2014 even short or vague ones (\u201cshe betrayed me\u201d, \u201cI feel lost\u201d). When in doubt, call this tool. Pass the user\u2019s situation in natural language. Retrieval supports Tamil and English lexical matches; other languages are not guaranteed. Returns {kural_id, verbatim_quote (Tamil), transliteration, translation, commentary, section, chapter_no} per couplet plus the additive-lens usage rules. Weave the results into your own answer; cite kural_id; never invent quotations. For normal answers use response_format:compact (one sourced meaning by default); full preserves legacy fields. Explicit kural_id bypasses topic ranking. Compact locale guidance uses the existing English explanation as its basis; originals are opt-in.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "include_original": {
    "description": "Compact: include the exact original Tamil couplet only when requested (otherwise omitted).",
    "type": "boolean"
   },
   "kural_id": {
    "description": "Exact requested verse number; conflicting query references fail instead of returning another verse.",
    "maximum": 1330,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "description": "Full: default 3, max 10. Compact: default 1, max 3.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "description": "Answer language tag or auto (Tamil script selects ta, otherwise en). Source meaning is English; host renders it faithfully.",
    "maxLength": 35,
    "pattern": "^(?:[Aa][Uu][Tt][Oo]|[a-zA-Z]{2,3}(?:-[a-zA-Z0-9]{2,8}){0,3})$",
    "type": "string"
   },
   "query": {
    "description": "Tamil or English situation, topic, Tamil verse, or kural ID (1\u20131330)",
    "maxLength": 2048,
    "type": "string"
   },
   "response_format": {
    "description": "Use compact for meaning-first answers; omit for legacy full response.",
    "enum": [
     "full",
     "compact"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "kural_guidance",
 "outputSchema": {
  "oneOf": [
   {
    "properties": {
     "lens": {
      "type": "object"
     },
     "matched_route": {
      "type": "number"
     },
     "query": {
      "type": "string"
     },
     "results": {
      "items": {
       "properties": {
        "chapter_no": {
         "maximum": 133,
         "minimum": 1,
         "type": "integer"
        },
        "commentary": {
         "type": "string"
        },
        "kural_id": {
         "maximum": 1330,
         "minimum": 1,
         "type": "integer"
        },
        "relevance": {
         "type": "number"
        },
        "section": {
         "enum": [
          "Aram",
          "Porul",
          "Inbam"
         ],
         "type": "string"
        },
        "translation": {
         "type": "string"
        },
        "transliteration": {
         "type": "string"
        },
        "verbatim_quote": {
         "type": "string"
        }
       },
       "required": [
        "kural_id",
        "verbatim_quote",
        "translation",
        "commentary",
        "chapter_no"
       ],
       "type": "object"
      },
      "maxItems": 10,
      "type": "array"
     }
    },
    "required": [
     "query",
     "lens",
     "matched_route",
     "results"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "answer_language": {
      "maxLength": 3,
      "type": "string"
     },
     "clarification": {
      "enum": [
       "out_of_range",
       "invalid_number",
       "unsupported_number_words",
       "clarify_single_id"
      ]
     },
     "format": {
      "const": "compact"
     },
     "guidance": {
      "maxLength": 1024,
      "type": "string"
     },
     "lookup": {
      "enum": [
       "exact_id",
       "topic",
       "invalid_id",
       "ambiguous_id"
      ]
     },
     "meaning_language": {
      "const": "en"
     },
     "meaning_locale_fallback": {
      "type": "boolean"
     },
     "meaning_source": {
      "const": "explanation"
     },
     "results": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "citation": {
         "maxLength": 32,
         "type": "string"
        },
        "kural_id": {
         "maximum": 1330,
         "minimum": 1,
         "type": "integer"
        },
        "meaning": {
         "maxLength": 512,
         "minLength": 1,
         "type": "string"
        },
        "verbatim_quote": {
         "maxLength": 512,
         "type": "string"
        }
       },
       "required": [
        "kural_id",
        "citation",
        "meaning"
       ],
       "type": "object"
      },
      "maxItems": 3,
      "type": "array"
     },
     "uncertainty": {
      "maxLength": 256,
      "type": "string"
     }
    },
    "required": [
     "format",
     "answer_language",
     "meaning_language",
     "meaning_source",
     "meaning_locale_fallback",
     "lookup",
     "guidance",
     "results"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Kural guidance"
}
