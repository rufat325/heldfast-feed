{
 "description": "Copy a sheet to another spreadsheet. Copies all data, formatting, and charts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "destinationId": {
    "description": "Destination spreadsheet ID",
    "minLength": 1,
    "type": "string"
   },
   "newTitle": {
    "description": "New name for the copied sheet (optional, will use auto-generated name if not provided)",
    "minLength": 1,
    "type": "string"
   },
   "sourceGid": {
    "description": "Source sheet grid ID to copy",
    "minLength": 1,
    "type": "string"
   },
   "sourceId": {
    "description": "Source spreadsheet ID",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "sourceId",
   "sourceGid",
   "destinationId"
  ],
  "type": "object"
 },
 "name": "sheet-copy-to",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "completedAt": {
        "description": "ISO datetime when operation completed",
        "type": "string"
       },
       "destinationGid": {
        "description": "Copied sheet ID in destination",
        "type": "string"
       },
       "destinationId": {
        "description": "Destination spreadsheet ID",
        "type": "string"
       },
       "destinationTitle": {
        "description": "Title of the copied sheet in destination",
        "type": "string"
       },
       "itemsChanged": {
        "description": "Successfully copied (always 1 on success)",
        "type": "number"
       },
       "itemsProcessed": {
        "description": "Total items attempted (always 1)",
        "type": "number"
       },
       "operationSummary": {
        "description": "Summary of the copy operation",
        "type": "string"
       },
       "renamed": {
        "description": "Whether the sheet was renamed after copying",
        "type": "boolean"
       },
       "sheetUrl": {
        "description": "URL of the copied sheet",
        "type": "string"
       },
       "sourceGid": {
        "description": "Source sheet ID",
        "type": "string"
       },
       "sourceId": {
        "description": "Source spreadsheet ID",
        "type": "string"
       },
       "sourceTitle": {
        "description": "Source sheet title",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "operationSummary",
       "itemsProcessed",
       "itemsChanged",
       "completedAt",
       "sourceId",
       "sourceGid",
       "sourceTitle",
       "destinationId",
       "destinationGid",
       "destinationTitle",
       "sheetUrl",
       "renamed"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
