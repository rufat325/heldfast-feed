{
 "description": "Read an Android settings value from any namespace (system, secure, global)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "key": {
    "description": "Setting key (e.g., 'screen_brightness', 'location_mode', 'airplane_mode_on')",
    "minLength": 1,
    "type": "string"
   },
   "namespace": {
    "description": "Settings namespace",
    "enum": [
     "system",
     "secure",
     "global"
    ],
    "type": "string"
   }
  },
  "required": [
   "namespace",
   "key"
  ],
  "type": "object"
 },
 "name": "adb_settings_get"
}
