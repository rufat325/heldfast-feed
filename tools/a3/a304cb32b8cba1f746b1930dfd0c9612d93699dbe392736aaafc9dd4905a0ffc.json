{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Story timeline"
 },
 "description": "The full timeline of a followed story by slug (from list_stories, get_article or research_topic): every stage in order with its label, time, summary and each portal's report, plus the location. Use to explain how a story developed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "The story's slug (from /v1/stories or its /kronologija/\u2026 address).",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_story_timeline",
 "outputSchema": {
  "properties": {
   "data": {
    "properties": {
     "articles": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": [
       "string",
       "integer"
      ]
     },
     "first_published_at": {
      "format": "date-time",
      "type": "string"
     },
     "last_published_at": {
      "format": "date-time",
      "type": "string"
     },
     "location": {
      "properties": {
       "kind": {
        "type": "string"
       },
       "latitude": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
        "type": [
         "string",
         "number"
        ]
       },
       "longitude": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
        "type": [
         "string",
         "number"
        ]
       },
       "map_url": {
        "type": "string"
       },
       "place": {
        "type": "string"
       },
       "precision": {
        "type": "string"
       }
      },
      "required": [
       "latitude",
       "longitude",
       "place",
       "precision",
       "kind",
       "map_url"
      ],
      "type": [
       "object",
       "null"
      ]
     },
     "portals": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": [
       "string",
       "integer"
      ]
     },
     "slug": {
      "type": "string"
     },
     "stages": {
      "items": {
       "properties": {
        "label": {
         "type": "string"
        },
        "lead": {
         "properties": {
          "id": {
           "format": "uuid",
           "type": "string"
          },
          "published_at": {
           "format": "date-time",
           "type": "string"
          },
          "source": {
           "type": "string"
          },
          "title": {
           "type": "string"
          },
          "url": {
           "type": "string"
          }
         },
         "required": [
          "id",
          "title",
          "url",
          "source",
          "published_at"
         ],
         "type": "object"
        },
        "number": {
         "pattern": "^-?(?:0|[1-9]\\d*)$",
         "type": [
          "string",
          "integer"
         ]
        },
        "reports": {
         "items": {
          "properties": {
           "id": {
            "format": "uuid",
            "type": "string"
           },
           "published_at": {
            "format": "date-time",
            "type": "string"
           },
           "source": {
            "type": "string"
           },
           "title": {
            "type": "string"
           },
           "url": {
            "type": "string"
           }
          },
          "required": [
           "id",
           "title",
           "url",
           "source",
           "published_at"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "started_at": {
         "format": "date-time",
         "type": "string"
        },
        "summary": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "number",
        "label",
        "started_at",
        "lead",
        "reports"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "title",
     "url",
     "first_published_at",
     "last_published_at",
     "articles",
     "portals",
     "stages"
    ],
    "type": "object"
   },
   "meta": {
    "description": "count, plan, include_filler, the limits applied (e.g. radius_limited_to), and for a nearby search its center.",
    "type": "object"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "title": "Story timeline"
}
