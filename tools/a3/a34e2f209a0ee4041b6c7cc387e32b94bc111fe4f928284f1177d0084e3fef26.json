{
 "description": "Create a new account on Liberty.win.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "password": {
    "description": "Password (min 8 chars)",
    "type": "string"
   },
   "password_confirm": {
    "description": "Password confirmation (must match password)",
