   },
   "username": {
    "description": "Desired username (3-30 chars, alphanumeric/underscore/hyphen)",
    "type": "string"
   }
  },
  "required": [
   "username",
   "password",
   "password_confirm"
  ],
  "type": "object"
 },
 "name": "register"
}
