{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new task board (via the liveBoards API; the legacy POST /boards ignores body parameters). Columns map board columns to issue status keys.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "autoFilters": {
    "additionalProperties": {},
    "description": "Auto add/remove filter, e.g. {\"addFilter\": {\"liveFilter\": {\"fieldValues\": {\"queue\": [{\"fixed\": \"KEY\"}]}}, \"enabled\": true}}",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "backlogAvailable": {
    "description": "Enable backlog on the board",
    "type": "boolean"
   },
   "boardPermissionsTemplate": {
    "description": "Access template: \"private\" (owner only) or \"public\" (default)",
    "enum": [
     "private",
     "public"
    ],
    "type": "string"
   },
   "columns": {
    "description": "Board columns; omit to use default columns",
    "items": {
     "properties": {
      "limit": {
       "description": "WIP limit for the column",
       "type": "number"
      },
      "name": {
       "description": "Column name",
       "type": "string"
      },
      "statuses": {
       "description": "Status keys/names displayed in this column",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "statuses"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Board name",
    "type": "string"
   },
   "owner": {
    "description": "Owner login or uid",
    "type": "string"
   },
   "sprintsAvailable": {
    "description": "Enable sprints on the board",
    "type": "boolean"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_board"
}
