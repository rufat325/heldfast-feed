{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List all current published groups belonging to one public organization at its current address. Each group retains its exact publication ID, version, schedule, prices and confirmation timestamps; an empty list does not authorize substituting another group.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "locale": {
    "enum": [
     "pt-BR",
     "pt-PT",
     "en",
     "ru",
     "es"
    ],
    "type": "string"
   },
   "organizationId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "organizationId"
  ],
  "type": "object"
 },
 "name": "list_offerings",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bookingSemantics": {
    "additionalProperties": false,
    "properties": {
     "availability": {
      "const": "unknown",
      "type": "string"
     },
     "bookingMode": {
      "const": "request_confirmation",
      "type": "string"
     },
     "createsRequest": {
      "const": false,
      "type": "boolean"
     },
     "requiresOrganizationConfirmation": {
      "const": true,
      "type": "boolean"
     },
     "reservesSeat": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "availability",
     "bookingMode",
     "createsRequest",
     "reservesSeat",
     "requiresOrganizationConfirmation"
    ],
    "type": "object"
   },
   "generation": {
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "checkedAt": {
       "type": "string"
      },
      "offeringId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "publicationId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "source": {
       "const": "organization_confirmation",
       "type": "string"
      },
      "validUntil": {
       "type": "string"
      },
      "version": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "publicationId",
      "version",
      "offeringId",
      "source",
      "checkedAt",
      "validUntil"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "organizationId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "syncedAt": {
    "type": "string"
   }
  },
  "required": [
   "revision",
   "syncedAt",
   "generation",
   "organizationId",
   "items",
   "bookingSemantics"
  ],
  "type": "object"
 }
}
