{
 "annotations": {
  "readOnlyHint": true,
  "title": "List lease outstanding balances"
 },
 "description": "Delinquency report: leases that owe money, with aged buckets (0-30, 31-60, 61-90, 90+ days), total balance, past-due-email and eviction-pending dates. Leases with zero or credit balances are not returned. Buildium: GET /v1/leases/outstandingbalances.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "balance_duration": {
    "description": "Only leases with a balance in this aging bucket.",
    "enum": [
     "TotalBalance",
     "Balance0to30Days",
     "Balance31to60Days",
     "Balance61to90Days",
     "BalanceOver90Days"
    ],
    "type": "string"
   },
   "entity_id": {
    "description": "Property or rental owner id (per entity_type).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "entity_type": {
    "description": "Scope by entity type; required with entity_id.",
    "enum": [
     "Rental",
     "RentalOwner"
    ],
    "type": "string"
   },
   "eviction_status": {
    "description": "Eviction status.",
    "enum": [
     "NotEvictionPending",
     "EvictionPending"
    ],
    "type": "string"
   },
   "lease_ids": {
    "description": "Filter to these lease ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "lease_statuses": {
    "description": "Lease term statuses.",
    "items": {
     "enum": [
      "Active",
      "Past",
      "Future"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max results, 1-1000 (Buildium default 50).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Zero-based record offset for paging (default 0).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "orderby": {
    "description": "Sort, e.g. \"Name\", \"LeaseToDate desc\" or \"Rent desc,City asc\". Any field of the returned object.",
    "type": "string"
   },
   "past_due_email": {
    "description": "Past-due email state.",
    "enum": [
     "NoEmailAddress",
     "Sent"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "buildium_list_outstanding_balances",
 "title": "List lease outstanding balances"
}
