{
 "description": "Gestiona tareas personales (todo list). Acciones: list (page, limit, search, status), get (id), create, update (id), delete (id), toggle (id, alterna completado/pendiente).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete",
     "toggle"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "id": {
    "description": "ID del todo",
    "type": "number"
   },
   "labels": {
    "type": "string"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "search": {
    "type": "string"
   },
   "start_date": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "todo_id": {
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "todo"
}
