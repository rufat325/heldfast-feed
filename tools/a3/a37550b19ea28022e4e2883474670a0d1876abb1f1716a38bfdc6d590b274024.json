 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get one game"
 },
 "description": "The same game object list_games returns, for one event_slug: both sides with their provider ids and live scores, the UTC kickoff, the provider's own status, the esports series format, and every linked Polymarket market with its condition_id and outcome token ids. The slug is the identity the live_sports_updated webhook pulse carries, so a receiver can read the full game straight from a pulse.\n\nArgs:\n  - event_slug (string, required): the game's event slug, for example nfl-buf-nyj-2026-09-22. Matched case-insensitively\n\nReturns: the game object with the envelope's meta. status.state keeps postponed, cancelled, suspended and delayed distinct from a plain 'not live'. Each game's own coverage reports whether scores, competitor provider ids and the schedule were available: when competitors reads labels, do not join on names. A slug outside the published coverage answers 404, including a real Polymarket event in a sport this deployment does not serve; list_games names what is covered. Carries no price, no sharp-money split and no holder identity.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "event_slug": {
    "description": "The game's event slug, for example nfl-buf-nyj-2026-09-22; matched case-insensitively",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "event_slug"
  ],
  "type": "object"
 },
 "name": "get_game",
