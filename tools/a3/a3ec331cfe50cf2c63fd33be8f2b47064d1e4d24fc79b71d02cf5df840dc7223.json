{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Build and analyze a Crimp planning draft from exact catalog IDs and structured connections, without an AI model call. Agent provides physical lengths and provenance; Crimp selects terminals, layout, wire and fuse suggestions. Display the exact returned reviewUrl as a clickable HTTPS link labeled Review schematic in Crimp; do not substitute a local HTML wrapper. The link opens a view-only preview; Edit a copy is a separate explicit action that creates a new local project. At most 10 counted equipment items, 40 components and 100 cables. Does not save, replace or publish a user's project. Retain assumptions and review findings before installation.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "draft": {
    "additionalProperties": false,
    "properties": {
     "assumptions": {
      "items": {
       "maxLength": 500,
       "type": "string"
      },
      "maxItems": 40,
      "type": "array"
     },
     "components": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "catalogId": {
         "maxLength": 100,
         "minLength": 1,
         "pattern": "^[A-Za-z0-9_.-]+$",
         "type": "string"
        },
        "count": {
         "maximum": 8,
         "minimum": 1,
         "type": "integer"
        },
        "countEstimated": {
         "type": "boolean"
        },
        "label": {
         "anyOf": [
          {
           "maxLength": 200,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "partEstimated": {
         "type": "boolean"
        },
        "ref": {
         "maxLength": 100,
         "minLength": 1,
         "pattern": "^[A-Za-z0-9_.-]+$",
         "type": "string"
        }
       },
       "required": [
        "ref",
        "catalogId",
        "label",
        "count",
        "partEstimated",
        "countEstimated"
       ],
       "type": "object"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
     },
     "connections": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "from": {
         "maxLength": 100,
         "minLength": 1,
         "pattern": "^[A-Za-z0-9_.-]+$",
         "type": "string"
        },
        "fromPort": {
         "enum": [
          "input",
          "output",
          "any"
         ],
         "type": "string"
        },
        "lengthEstimated": {
         "type": "boolean"
        },
        "lengthM": {
         "maximum": 1000,
         "minimum": 0.01,
         "type": "number"
        },
        "marker": {
         "anyOf": [
          {
           "maxLength": 120,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "polarity": {
         "enum": [
          "positive",
          "negative"
         ],
         "type": "string"
        },
        "seriesLink": {
         "type": "boolean"
        },
        "to": {
         "maxLength": 100,
         "minLength": 1,
         "pattern": "^[A-Za-z0-9_.-]+$",
         "type": "string"
        },
        "toPort": {
         "enum": [
          "input",
          "output",
          "any"
         ],
         "type": "string"
        }
       },
       "required": [
        "from",
        "fromPort",
        "to",
        "toPort",
        "polarity",
        "lengthM",
        "lengthEstimated",
        "marker",
        "seriesLink"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "required": [
     "name",
     "components",
     "connections",
     "assumptions"
    ],
    "type": "object"
   }
  },
  "required": [
   "draft"
  ],
  "type": "object"
 },
 "name": "create_draft",
 "outputSchema": {
  "properties": {
   "data": {},
   "error": {
    "properties": {
     "code": {
      "type": "string"
     },
     "details": {},
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "metadata": {
    "properties": {
     "apiVersion": {
      "type": "string"
     },
     "engineVersion": {
      "type": "string"
     },
     "schemaVersion": {
      "type": "integer"
     }
    },
    "required": [
     "apiVersion",
     "engineVersion",
     "schemaVersion"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "tool": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool",
   "metadata"
  ],
  "type": "object"
 }
}
