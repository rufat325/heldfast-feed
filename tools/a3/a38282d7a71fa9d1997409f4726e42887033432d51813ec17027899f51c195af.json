{
 "description": "Get top selling products by quantity (completed + processing orders)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Number of products (default 10)",
    "type": "integer"
   },
   "period": {
    "description": "week = last 7 days, month = this month (default), year = this year",
    "enum": [
     "week",
     "month",
     "year"
    ],
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "woo_top_sellers"
}
