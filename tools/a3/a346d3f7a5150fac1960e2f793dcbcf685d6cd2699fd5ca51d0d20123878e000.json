{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create up to 100 short links in one sync batch. Correlate with client_ref. Requires registered account. Anonymous MCP is not supported.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "idempotency_key": "example-batch-1",
    "items": [
     {
      "alias": "notes",
      "client_ref": "item-1",
      "locale": "zh-cn",
      "title": "Notes",
      "url": "https://example.com/notes"
     }
    ]
   }
  ],
  "properties": {
   "idempotency_key": {
    "description": "Client-generated unique key for this create. Required. Replays within 24h.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "items": {
    "description": "Synchronous batch items (1 to 100). Each item creates one short link.",
    "items": {
     "properties": {
      "alias": {
       "description": "Optional custom path segment (stored lowercase). Do not send customSlug.",
       "maxLength": 32,
       "minLength": 1,
       "type": "string"
      },
      "client_ref": {
       "description": "Batch item correlation id (never use array index).",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "locale": {
       "description": "Accepted values: en, zh-CN, and zh-cn (the only case fold of zh-CN). EN, ZH-CN, and bare zh are rejected. Omitted or blank defaults to en.",
       "type": "string"
      },
      "title": {
       "description": "Optional link title, at most 256 characters.",
       "maxLength": 256,
       "type": "string"
      },
      "url": {
       "description": "Destination HTTPS/HTTP URL to shorten. Required. Do not send longUrl.",
       "maxLength": 2048,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "client_ref",
      "url"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "items",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "shorten_urls",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "batch_id": {
    "type": "string"
   },
   "batch_mode": {
    "const": "sync",
    "type": "string"
   },
   "code": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "fail_count": {
    "type": "number"
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "ok_count": {
    "type": "number"
   },
   "request_id": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "retryable": {
    "type": "boolean"
   }
  },
  "required": [
   "ok",
   "request_id"
  ],
  "type": "object"
 },
 "title": "Shorten URLs (batch)"
}
