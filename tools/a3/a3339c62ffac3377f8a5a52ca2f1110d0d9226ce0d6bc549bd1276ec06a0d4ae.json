{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create project task dependency"
 },
 "description": "Create a dependency between two project tasks. Requires project_task_dependencies:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "dependency_type": {
    "description": "Dependency type (default: finish_to_start)",
    "enum": [
     "finish_to_start",
     "start_to_start",
     "finish_to_finish",
     "start_to_finish"
    ],
    "type": "string"
   },
   "depends_on_task_id": {
    "description": "Task ID that must complete first (required); must differ from task_id",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "task_id": {
    "description": "Task ID (the dependent task, required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "depends_on_task_id"
  ],
  "type": "object"
 },
 "name": "create_project_task_dependency",
 "title": "Create project task dependency"
}
