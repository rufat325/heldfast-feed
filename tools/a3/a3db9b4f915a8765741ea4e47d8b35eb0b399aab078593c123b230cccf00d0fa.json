{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Which European markets and datasets ko.io serves: for Sweden, Netherlands, Denmark and the UK, the status of insider dealings (PDMR), major holdings, net short positions and annual reports -- live (with latest source date), pending (not activated yet) or not offered. Call first when unsure whether an EU dataset is live.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "get_eu_markets",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "live_count": {
    "description": "Live (country, dataset) pairs",
    "type": "integer"
   },
   "markets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "country": {
       "type": "string"
      },
      "datasets": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "dataset": {
          "enum": [
           "pdmr_dealings",
           "major_holdings",
           "short_positions",
           "annual_reports"
          ],
          "type": "string"
         },
         "latest_retrieved_at": {
          "$ref": "#/properties/markets/items/properties/datasets/items/properties/latest_source_date"
         },
         "latest_source_date": {
          "type": [
           "string",
           "null"
          ]
         },
         "status": {
          "description": "unknown = ko-api sent a status this tool does not recognise (reported, never guessed)",
          "enum": [
           "live",
           "pending",
           "not_offered",
           "unknown"
          ],
          "type": "string"
         }
        },
        "required": [
         "dataset",
         "status",
         "latest_source_date",
         "latest_retrieved_at"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "country",
      "datasets"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "markets",
   "live_count"
  ],
  "type": "object"
 }
}
