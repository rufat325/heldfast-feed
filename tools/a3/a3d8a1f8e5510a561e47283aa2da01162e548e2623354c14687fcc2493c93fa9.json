{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new Service Level Objective (monitor-based, metric-based, or time-slice). Write-gated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "SLO description",
    "type": "string"
   },
   "monitorIds": {
    "description": "Required if type='monitor'. List of linked monitor IDs",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "name": {
    "description": "SLO name",
    "type": "string"
   },
   "query": {
    "description": "Required if type='metric'",
    "properties": {
     "denominator": {
      "description": "Denominator metric query",
      "type": "string"
     },
     "numerator": {
      "description": "Numerator metric query",
      "type": "string"
     }
    },
    "required": [
     "numerator",
     "denominator"
    ],
    "type": "object"
   },
   "tags": {
    "description": "Tags. Example: ['env:prod', 'team:backend']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "targetThreshold": {
    "description": "Convenience: target % (e.g. 99.9)",
    "type": "number"
   },
   "thresholds": {
    "description": "One or more {target, timeframe, warning?} entries",
    "items": {
     "properties": {
      "target": {
       "description": "Target SLI value (e.g. 99.9)",
       "type": "number"
      },
      "timeframe": {
       "description": "SLO time window",
       "enum": [
        "7d",
        "30d",
        "90d"
       ],
       "type": "string"
      },
      "warning": {
       "description": "Optional warning threshold (must be > target)",
       "type": "number"
      }
     },
     "required": [
      "target",
      "timeframe"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "type": {
    "description": "SLO type. 'monitor' uses linked monitors; 'metric' uses a numerator/denominator query; 'time_slice' uses time-slice SLI",
    "enum": [
     "monitor",
     "metric",
     "time_slice"
    ],
    "type": "string"
   },
   "warningThreshold": {
    "description": "Convenience: warning %",
    "type": "number"
   }
  },
  "required": [
   "name",
   "type",
   "thresholds"
  ],
  "type": "object"
 },
 "name": "create-slo"
}
