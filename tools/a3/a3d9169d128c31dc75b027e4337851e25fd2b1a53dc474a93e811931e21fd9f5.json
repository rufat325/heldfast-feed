{
 "description": "List all custom fields for a location, optionally filtered by model.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "locationId": {
    "description": "The location ID to list custom fields for",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "model": {
    "description": "Filter by model type (e.g. 'contact', 'opportunity', 'all')",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId"
  ],
  "type": "object"
 },
 "name": "crm_list_custom_fields"
}
