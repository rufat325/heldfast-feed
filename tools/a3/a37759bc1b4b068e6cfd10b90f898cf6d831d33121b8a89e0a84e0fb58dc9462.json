{
 "description": "Search for LEGO sets by name, theme, year, or piece count. Use this when looking for sets matching specific criteria. Returns a summary list: use get_set for full details on a specific set.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results (default 25, max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "max_parts": {
    "description": "Maximum piece count (inclusive)",
    "type": "number"
   },
   "min_parts": {
    "description": "Minimum piece count (inclusive)",
    "type": "number"
   },
   "query": {
    "description": "Free-text search (FTS5) across set names",
    "type": "string"
   },
   "theme": {
    "description": "Filter by theme name (includes sub-themes recursively)",
    "type": "string"
   },
   "year_max": {
    "description": "Maximum release year (inclusive)",
    "type": "number"
   },
   "year_min": {
    "description": "Minimum release year (inclusive)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "search_sets"
}
