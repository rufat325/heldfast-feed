{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Create timeline"},"description":"Start an empty timeline. Returns its timeline_id and its tracks (ids for track_id). Timelines are immutable: every edit returns a new timeline_id, and older ids stay valid for 24 hours after last use. For work longer than a day, keep the timeline.get document on your side and restore it with timeline.load.","inputSchema":{"properties":{"name":{"default":"Untitled","maxLength":200,"minLength":1,"type":"string"},"sequence":{"properties":{"audio_rate":{"default":48000,"exclusiveMinimum":0,"type":"integer"},"channels":{"default":2,"maximum":8,"minimum":1,"type":"integer"},"color":{"const":"bt709","default":"bt709","type":"string"},"fps":{"properties":{"den":{"exclusiveMinimum":0,"type":"integer"},"num":{"exclusiveMinimum":0,"type":"integer"}},"required":["num","den"],"type":"object"},"height":{"maximum":8192,"minimum":16,"multipleOf":2,"type":"integer"},"width":{"maximum":8192,"minimum":16,"multipleOf":2,"type":"integer"}},"required":["width","height","fps"],"type":"object"},"tracks":{"default":{"audio":1,"video":1},"description":"How many empty tracks to start with","properties":{"audio":{"maximum":32,"minimum":0,"type":"integer"},"video":{"maximum":32,"minimum":0,"type":"integer"}},"required":["video","audio"],"type":"object"}},"required":["sequence"],"type":"object"},"name":"timeline.create","outputSchema":{"properties":{"timeline_id":{"description":"Timeline handle; every edit returns a new one","pattern":"^tl_[0-9a-f]{32}$","type":"string"},"tracks":{"description":"The new tracks; edits take the id (track_id), not the name","items":{"properties":{"id":{"type":"string"},"kind":{"enum":["video","audio"],"type":"string"},"name":{"type":"string"}},"required":["id","kind","name"],"type":"object"},"type":"array"}},"required":["timeline_id","tracks"],"type":"object"},"title":"Create timeline"}
