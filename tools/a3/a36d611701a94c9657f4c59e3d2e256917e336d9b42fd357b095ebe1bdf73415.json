{
 "annotations": {},
 "description": "Set node properties: position, size, radius, visibility, lock, opacity, rotation, blend, constraints, z-order, mask, stroke. Pass only what changes. Results are per node.",
 "inputSchema": {
  "properties": {
   "blendMode": {
    "description": "e.g. NORMAL, MULTIPLY, SCREEN",
    "type": "string"
   },
   "bottomLeftRadius": {
    "description": "Bottom left radius",
    "type": "number"
   },
   "bottomRightRadius": {
    "description": "Bottom right radius",
    "type": "number"
   },
   "constraints": {
    "description": "{horizontal, vertical}: MIN, MAX, CENTER, STRETCH, or SCALE",
    "properties": {},
    "type": "object"
   },
   "cornerRadius": {
    "description": "Radius for all corners",
    "type": "number"
   },
   "dashPattern": {
    "description": "Dash and gap e.g. [4, 2]. [] = solid.",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "height": {
    "description": "Height",
    "type": "number"
   },
   "isMask": {
    "description": "Use as mask for the layers above it",
    "type": "boolean"
   },
   "locked": {
    "description": "Lock or unlock",
    "type": "boolean"
   },
   "maskType": {
    "description": "ALPHA, VECTOR, or LUMINANCE",
    "type": "string"
   },
   "nodeIds": {
    "description": "Node IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "opacity": {
    "description": "Opacity 0-1",
    "type": "number"
   },
   "order": {
    "description": "Layer order: bringToFront, sendToBack, bringForward, sendBackward",
    "type": "string"
   },
   "rotation": {
    "description": "Rotation in degrees",
    "type": "number"
   },
   "strokeAlign": {
    "description": "Stroke position",
    "type": "string"
   },
   "strokeCap": {
    "description": "Line ends: NONE, ROUND, SQUARE, ARROW_LINES, ARROW_EQUILATERAL",
    "type": "string"
   },
   "strokeJoin": {
    "description": "Corner style",
    "type": "string"
   },
   "strokeMiterLimit": {
    "description": "Miter limit (default 4)",
    "type": "number"
   },
   "strokeWeight": {
    "description": "Stroke width",
    "type": "number"
   },
   "topLeftRadius": {
    "description": "Top left radius",
    "type": "number"
   },
   "topRightRadius": {
    "description": "Top right radius",
    "type": "number"
   },
   "visible": {
    "description": "Show or hide",
    "type": "boolean"
   },
   "width": {
    "description": "Width",
    "type": "number"
   },
   "x": {
    "description": "Absolute X (not an offset)",
    "type": "number"
   },
   "y": {
    "description": "Absolute Y (not an offset)",
    "type": "number"
   }
  },
  "required": [
   "nodeIds"
  ],
  "type": "object"
 },
 "name": "set_node_properties"
}
