{
 "description": "Full change history for a specific Graph object type, oldest to newest \u2014 \"what has happened to X over time?\"",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "endpoint": {
    "enum": [
     "v1.0",
     "beta"
    ],
    "type": "string"
   },
   "object_name": {
    "description": "e.g. group, application, accessPackage, conditionalAccessPolicy",
    "type": "string"
   },
   "since": {
    "description": "ISO date (YYYY-MM-DD)",
    "type": "string"
   }
  },
  "required": [
   "object_name"
  ],
  "type": "object"
 },
 "name": "get_object_history"
}
