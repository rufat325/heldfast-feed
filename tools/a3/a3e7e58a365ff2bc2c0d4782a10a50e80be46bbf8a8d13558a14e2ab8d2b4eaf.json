{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Return assembly for one analyzed procedure identified by symbol or hexadecimal address. Use when pseudocode loses calling-convention or instruction-level detail; output is currently returned as one unpaginated string.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "procedure": "main"
   }
  ],
  "properties": {
   "document": {
    "description": "The document name",
    "type": "string"
   },
   "procedure": {
    "description": "The procedure name or address",
    "type": "string"
   },
   "unknown_registry_approved": {
    "const": true,
    "description": "Explicit approval to record typed capability unavailability as a residual unknown",
    "type": "boolean"
   }
  },
  "required": [
   "procedure"
  ],
  "type": "object"
 },
 "name": "procedure_assembly",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "type": "string"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Procedure Assembly"
}
