{
 "_meta": {
  "openai/toolInvocation/invoked": "Hotel priced",
  "openai/toolInvocation/invoking": "Pricing hotel\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Price a hotel stay"
 },
 "description": "Gets a live supplier offer or MBD contract price (pricingSource) for hotels and dates. Books nothing and holds no room. An unverified price is not returned. PRICE_ON_REQUEST means no price is on file; the reply then carries pageUrl and contact. Supplier calls are limited daily. Needs check-in, check-out and guests. When nationality is omitted the price is for TR and the reply states nationalityUsed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "adults": {
    "description": "Adults; at most 6 people per room, 4 children.",
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   },
   "checkIn": {
    "description": "Check-in date; at most 365 days from today (YYYY-MM-DD)",
    "format": "date",
    "maxLength": 10,
    "minLength": 10,
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "checkOut": {
    "description": "Check-out date; the stay must be 1-30 nights (YYYY-MM-DD)",
    "format": "date",
    "maxLength": 10,
    "minLength": 10,
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "childrenAges": {
    "description": "Age of each child, one entry per child. No birth dates.",
    "items": {
     "maximum": 17,
     "minimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "currency": {
    "enum": [
     "EUR",
     "USD",
     "AED"
    ],
    "type": "string"
   },
   "hotelIds": {
    "description": "hotelId values (ids, not names).",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   },
   "language": {
    "enum": [
     "tr",
     "en"
    ],
    "type": "string"
   },
   "nationality": {
    "description": "ISO 3166-1 alpha-2 code (TR, AE, DE); optional, default TR. Changes the price.",
    "maxLength": 2,
    "minLength": 2,
    "pattern": "^[A-Z]{2}$",
    "type": "string"
   }
  },
  "required": [
   "language",
   "currency",
   "hotelIds",
   "checkIn",
   "checkOut",
   "adults"
  ],
  "type": "object"
 },
 "name": "quote_hotel_stay",
