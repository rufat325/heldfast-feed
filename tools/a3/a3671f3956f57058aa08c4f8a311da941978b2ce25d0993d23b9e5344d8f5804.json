  "title": "Search TikTok Music"
 },
 "description": "Search TikTok sounds by keyword (data.music): id_str, title, artist, duration, usage count and play URL. Paginate with data.cursor/has_more. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
