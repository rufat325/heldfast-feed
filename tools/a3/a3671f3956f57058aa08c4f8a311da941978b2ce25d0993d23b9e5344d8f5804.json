    "description": "Sounds per page, 1-20 (default 20).",
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "cursor": {
    "description": "data.cursor from the previous response (default '0').",
    "type": "string"
   },
   "keyword": {
    "description": "Search query, e.g. 'espresso'.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "keyword"
  ],
  "type": "object"
 },
 "name": "search_tiktok_music",
 "title": "Search TikTok Music"
}
