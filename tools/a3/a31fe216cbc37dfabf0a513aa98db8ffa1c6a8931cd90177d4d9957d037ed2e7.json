{
 "_meta": {
  "vesremont.com/auth": {
   "resource": "https://vesremont.com/mcp",
   "scope": "cart:write",
   "scopes": [
    "cart:write"
   ]
  },
  "vesremont.com/user-confirmation": false
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Set the absolute quantity of a basket line using its item_id from get_cart, not product_id. Zero removes the line; use add_cart_item to increment instead. Returns the refreshed basket; no order or payment. OAuth scopes: cart:write. Changes buyer or order state.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "item_id": {
    "description": "Basket line item_id from this consenting buyer's get_cart response, not product_id or another buyer's item.",
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   },
   "quantity": {
    "description": "New ABSOLUTE quantity for this basket line, not an increment. Zero removes the line.",
    "maximum": 999,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "item_id",
   "quantity"
  ],
  "type": "object"
 },
 "name": "update_cart_item",
 "outputSchema": {
