     "additionalProperties": false,
     "properties": {
      "availability": {
       "enum": [
        "in_stock",
        "backorder",
        "preorder",
        "out_of_stock",
        "unavailable",
        "unknown"
       ]
      },
      "currency": {
       "const": "RUB"
      },
      "item_id": {
       "maximum": 2147483647,
       "minimum": 1,
       "type": "integer"
      },
      "line_total": {
