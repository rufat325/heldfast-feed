        "total"
       ],
       "type": "object"
      },
      "unit_price": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "anyOf": [
        {
         "format": "uri",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "item_id",
      "product_id",
      "name",
      "url",
