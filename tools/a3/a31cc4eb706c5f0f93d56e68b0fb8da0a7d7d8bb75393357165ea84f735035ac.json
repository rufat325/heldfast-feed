{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List saved content from your library. Returns drafts, templates, and evergreen content.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Filter by category",
    "type": "string"
   },
   "limit": {
    "description": "Maximum items to return (default 20, max 100)",
    "type": "number"
   },
   "search": {
    "description": "Search in title and text",
    "type": "string"
   },
   "team_id": {
    "description": "Team ID to operate in team scope. Get available teams with list_teams. If omitted, uses personal scope.",
    "type": "string"
   },
   "type": {
    "description": "Filter by content type",
    "enum": [
     "draft",
     "template",
     "evergreen"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_library",
 "title": "List Content Library"
}
