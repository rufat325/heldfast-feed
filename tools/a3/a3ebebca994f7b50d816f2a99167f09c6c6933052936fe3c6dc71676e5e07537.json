{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Review npm install scripts"
 },
 "description": "Review every dependency npm would allow to run an install script, and return approve, review, or deny for each with the source evidence behind it. Reads package-lock.json and never executes a script. Use when npm reports pending allowScripts entries or after a lockfile change adds one.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "ai": {
    "default": "off",
    "description": "Optional AI review mode. Heuristic-only scanning is the default.",
    "enum": [
     "off",
     "auto",
     "online",
     "ollama"
    ],
    "type": "string"
   },
   "all": {
    "default": false,
    "description": "Re-review packages already recorded in allowScripts.",
    "type": "boolean"
   },
   "concurrency": {
    "default": 3,
    "description": "Maximum concurrent package reviews.",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "model": {
    "description": "Provider model identifier. Required when ai is not off, because no model catalog is bundled.",
    "minLength": 1,
    "type": "string"
   },
   "path": {
    "default": ".",
    "description": "Project directory or package.json path.",
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "default": "auto",
    "description": "AI provider. Credentials are read from environment variables, never tool arguments.",
    "enum": [
     "auto",
     "openai",
     "anthropic",
     "gemini",
     "openrouter",
     "groq",
     "together",
     "custom"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "approve_scripts",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "decision": {
    "properties": {
     "action": {
      "enum": [
       "continue",
       "review",
       "stop",
       "retry"
      ],
      "type": "string"
     },
     "blocked": {
      "type": "boolean"
     },
     "exitCode": {
      "type": "integer"
     },
     "mayContinue": {
      "type": "boolean"
     },
     "mustStop": {
      "type": "boolean"
     },
     "requiresApproval": {
      "type": "boolean"
     },
     "requiresHumanReview": {
      "type": "boolean"
     },
     "riskScore": {
      "type": [
       "number",
       "null"
      ]
     },
     "safeToExecute": {
      "type": "boolean"
     },
     "verdict": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "verdict",
     "riskScore",
     "action",
     "exitCode",
     "mayContinue",
     "safeToExecute",
     "requiresApproval",
     "requiresHumanReview",
     "blocked",
     "mustStop"
    ],
    "type": "object"
   },
   "error": {
    "type": "object"
   },
   "kind": {
    "enum": [
     "package-scan",
     "project-scan",
     "script-approvals",
     "error"
    ],
    "type": "string"
   },
   "report": {
    "type": "object"
   },
   "schemaVersion": {
    "const": 2,
    "type": "integer"
   },
   "status": {
    "enum": [
     "complete",
     "incomplete",
     "error"
    ],
    "type": "string"
   },
   "subject": {
    "type": "object"
   },
   "tool": {
    "properties": {
     "name": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "version"
    ],
    "type": "object"
   }
  },
  "required": [
   "schemaVersion",
   "tool",
   "kind",
   "status",
   "decision"
  ],
  "type": "object"
 },
 "title": "Decide npm install-script permissions"
}
