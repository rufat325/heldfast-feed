{
 "description": "Zet een rit om in een kant-en-klare musette: berekent het Ien-gevalideerde plan, kiest concrete producten + aantallen (Amacx/Maurten) en geeft een directe bestel-link naar musette.cc met de winkelwagen al gevuld. Gebruik dezelfde rit-gegevens als bereken_voedingsplan.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "afstand_km": {
    "description": "Ritafstand in km (alternatief voor duur_minuten)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "binnen": {
    "description": "Indoor/hometrainer (meer zweetverlies)",
    "type": "boolean"
   },
   "darmgetraind": {
    "description": "Kan de renner >75 g/uur verdragen?",
    "type": "boolean"
   },
   "duur_minuten": {
    "description": "Geschatte rijduur in minuten (nauwkeuriger dan afstand)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "ftp_percentage": {
    "description": "Exact % van FTP (overschrijft 'intensiteit')",
    "maximum": 150,
    "minimum": 20,
    "type": "number"
   },
   "gem_snelheid_kmh": {
    "description": "Gemiddelde snelheid, voor duurschatting uit afstand",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "geslacht": {
    "description": "Voor FTP-schatting wanneer alleen vermogen bekend is",
    "enum": [
     "M",
     "V"
    ],
    "type": "string"
   },
   "hoogtemeters": {
    "description": "Totale klim in meters",
    "minimum": 0,
    "type": "number"
   },
   "intensiteit": {
    "description": "Inspanningsniveau van de rit",
    "enum": [
     "herstel",
     "endurance",
     "tempo",
     "drempel",
     "wedstrijd"
    ],
    "type": "string"
   },
   "merk_voorkeur": {
    "description": "Merkvoorkeur voor de producten (standaard: amacx)",
    "enum": [
     "amacx",
     "maurten",
     "geen"
    ],
    "type": "string"
   },
   "temperatuur_celsius": {
    "description": "Verwachte buitentemperatuur",
    "maximum": 55,
    "minimum": -20,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "stel_musette_samen"
}
