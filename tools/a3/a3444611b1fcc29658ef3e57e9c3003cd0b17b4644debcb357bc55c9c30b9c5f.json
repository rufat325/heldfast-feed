  "ui": {
   "resourceUri": "ui://bsd/customer-cards-v3.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Prepare sportsbook link"
 },
 "description": "Prepare the existing app\u2019s fresh, vetted direct sportsbook link for an owned saved ticket. Choose the same sportsbook as the saved ticket and the customer-provided state, or null if unknown. Returns full-slip or explicit individual-selection/manual fallbacks with expiry. Set sendToPhone=true only on an explicit customer request; this sends an ID-only push to that account\u2019s registered devices. The phone opens BSD for review. Only an explicit customer tap in BSD opens the sportsbook; this tool never executes a wager or records placement.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bookKey": {
    "enum": [
     "draftkings",
     "fanduel",
     "betmgm",
     "caesars",
     "hardrockbet",
     "betrivers",
     "thescorebet",
     "fanatics",
     "bet365_us",
     "ballybet",
     "betparx",
     "fliff"
    ],
    "type": "string"
   },
   "platform": {
    "enum": [
     "web",
     "ios",
     "android"
    ],
    "type": "string"
   },
   "sendToPhone": {
    "description": "Set true only when the customer explicitly asks to send this exact saved-ticket handoff to their BSD phone. Omit otherwise.",
    "type": "boolean"
   },
   "state": {
    "anyOf": [
     {
      "enum": [
       "AL",
       "AK",
       "AZ",
       "AR",
       "CA",
       "CO",
       "CT",
       "DE",
       "FL",
       "GA",
       "HI",
       "ID",
       "IL",
       "IN",
       "IA",
       "KS",
       "KY",
       "LA",
       "ME",
       "MD",
       "MA",
       "MI",
       "MN",
       "MS",
       "MO",
       "MT",
       "NE",
       "NV",
       "NH",
       "NJ",
       "NM",
       "NY",
       "NC",
       "ND",
       "OH",
       "OK",
       "OR",
       "PA",
       "RI",
       "SC",
       "SD",
       "TN",
       "TX",
       "UT",
       "VT",
       "VA",
       "WA",
       "WV",
       "WI",
       "WY",
       "DC"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "ticketId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "ticketId",
   "platform",
   "bookKey",
   "state"
  ],
  "type": "object"
 },
 "name": "prepare_sportsbook_handoff",
 "securitySchemes": [
  {
   "scopes": [
    "slips.read",
    "odds.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Prepare sportsbook link"
}
