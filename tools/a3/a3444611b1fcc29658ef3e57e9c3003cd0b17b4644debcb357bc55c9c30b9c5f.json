{
 "_meta": {
  "openai/outputTemplate": "ui://bsd/customer-cards-v3.html",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "slips.read",
     "odds.read"
    ],
    "type": "oauth2"
