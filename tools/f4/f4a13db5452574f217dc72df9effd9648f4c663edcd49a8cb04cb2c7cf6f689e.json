 "description": "Calculate API rate limit utilization given current request count and limit. Returns utilization percentage, buffer, safety status, and risk level (OK at <80%, WARNING at 80-95%, CRITICAL at >95%).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "current_requests": {
    "description": "Current request count in the window",
    "examples": [
     1
    ],
    "minimum": 0,
    "type": "number"
   },
   "limit": {
    "description": "Rate limit ceiling",
    "examples": [
     1
    ],
    "minimum": 1,
    "type": "number"
   },
   "window_seconds": {
    "description": "Rate limit window in seconds (e.g. 60 for per-minute)",
    "examples": [
     1
    ],
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "current_requests",
   "limit"
  ],
  "type": "object"
 },
