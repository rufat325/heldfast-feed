{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Upload File"
 },
 "description": "Upload a file (UTF-8 text or base64 binary). Returns {success, file}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "base64": {
    "description": "Set true if `content` is base64-encoded binary",
    "type": "boolean"
   },
   "content": {
    "description": "File content (UTF-8 text, or base64 when base64=true)",
    "type": "string"
   },
   "content_type": {
    "description": "MIME type (default application/octet-stream)",
    "type": "string"
   },
   "filename": {
    "description": "Filename for the uploaded file",
    "type": "string"
   }
  },
  "required": [
   "filename",
   "content"
  ],
  "type": "object"
 },
 "name": "files_upload"
}
