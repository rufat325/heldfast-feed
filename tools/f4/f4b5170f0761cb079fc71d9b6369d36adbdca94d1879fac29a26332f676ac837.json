{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Config Group for CDSS cluster configuration",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "configGroupName": {
    "description": "Config group name (3-30 chars: lowercase letters, numbers, hyphen; must start and end with a lowercase letter or number)",
    "maxLength": 30,
    "type": "string"
   },
   "description": {
    "description": "Config group description (0-255 chars)",
    "maxLength": 255,
    "type": "string"
   },
   "kafkaVersionCode": {
    "description": "Kafka version code (from ncloud_cdss_get_kafka_versions)",
    "type": "number"
   }
  },
  "required": [
   "configGroupName",
   "kafkaVersionCode"
  ],
  "type": "object"
 },
 "name": "ncloud_cdss_create_config_group"
}
