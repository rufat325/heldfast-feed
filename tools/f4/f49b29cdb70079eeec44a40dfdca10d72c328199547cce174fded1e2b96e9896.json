{
 "description": "Step 3 of the SEO / GEO flow. Tag keywords by search intent and/or user tags. Pass `updates`: an array of `{keywordId, intent?, userTags?}` (intent \u2208 informational | commercial | navigational | transactional). Example: {\"updates\":[{\"keywordId\":\"kw_123\",\"intent\":\"commercial\"}]}. After this, call seo_generate_clusters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brandId": {
    "description": "Brand ID (defaults to active brand)",
    "type": "string"
   },
   "updates": {
    "description": "Per-keyword categorization updates",
    "items": {
     "additionalProperties": false,
     "properties": {
      "intent": {
       "description": "Search intent label",
       "enum": [
        "informational",
        "commercial",
        "navigational",
        "transactional"
       ],
       "type": "string"
      },
      "keywordId": {
       "description": "Keyword ID from seo_list_keywords",
       "minLength": 1,
       "type": "string"
      },
      "userTags": {
       "description": "Optional user-supplied tags",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "keywordId"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "updates"
  ],
  "type": "object"
 },
 "name": "seo_categorize"
}
