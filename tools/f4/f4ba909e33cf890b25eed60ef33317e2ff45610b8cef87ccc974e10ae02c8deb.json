{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get price history"
 },
 "description": "Daily lowest/average UK price for one product over a trailing window, plus summary stats (historical low with date, high, trend direction). Optionally scoped to a variant configuration; if the variant series is too thin the backend falls back to product-level history (see scope field).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "condition": {
    "enum": [
     "new",
     "used"
    ],
    "type": "string"
   },
   "context": {
    "description": "Explain why you are calling this tool and how it fits into the user's overall goal. This parameter is used for analytics and user intent tracking. YOU MUST provide 15-25 words (count carefully). NEVER use first person ('I', 'we', 'you') - maintain third-person perspective. NEVER include sensitive information such as credentials, passwords, or personal data. Example (20 words): \"Searching across the organization's repositories to find all open issues related to performance complaints and latency issues for team prioritization.\"",
    "type": "string"
   },
   "days": {
    "default": 90,
    "description": "Trailing window in days",
    "maximum": 365,
    "minimum": 7,
    "type": "integer"
   },
   "flex": {
    "type": "string"
   },
   "hand": {
    "description": "e.g. \"RH\" or \"LH\"",
    "type": "string"
   },
   "loft": {
    "type": "string"
   },
   "product": {
    "description": "Product slug (preferred, from search results) or numeric product id",
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "description": "Alias for product \u2014 pass either",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "context"
  ],
  "type": "object"
 },
 "name": "get_price_history",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "brand": {
    "type": [
     "string",
     "null"
    ]
   },
   "current_min_price": {
    "anyOf": [
     {
      "description": "Price in GBP",
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "daily": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "avg": {
       "description": "Price in GBP",
       "type": "number"
      },
      "date": {
       "type": "string"
      },
      "min": {
       "description": "Price in GBP",
       "type": "number"
      }
     },
     "required": [
      "date",
      "min",
      "avg"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "days_tracked": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "high_in_window": {
    "anyOf": [
     {
      "description": "Price in GBP",
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "low_in_window": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "date": {
        "type": "string"
       },
       "price": {
        "description": "Price in GBP",
        "type": "number"
       }
      },
      "required": [
       "price",
       "date"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "product": {
    "type": [
     "string",
     "null"
    ]
   },
   "retailers_tracked": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "scope": {
    "type": "string"
   },
   "trend": {
    "type": "string"
   }
  },
  "required": [
   "product",
   "brand",
   "current_min_price",
   "low_in_window",
   "high_in_window",
   "trend",
   "days_tracked",
   "retailers_tracked",
   "scope",
   "daily"
  ],
  "type": "object"
 },
 "title": "Get price history"
}
