{
 "description": "Modificar un flow existente: cambiar disparador y/o pasos.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Nombre del flow a modificar",
    "type": "string"
   },
   "steps": {
    "description": "Nuevos pasos",
    "items": {
     "additionalProperties": false,
     "properties": {
      "confirm": {
       "type": "boolean"
      },
      "note": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "trigger": {
    "description": "Nuevo disparador",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "df_flow_update"
}
