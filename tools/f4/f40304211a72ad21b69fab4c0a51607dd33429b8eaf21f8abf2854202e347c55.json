{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return a list of available writing templates with their metadata.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Returns a list of available built-in writing templates.",
  "properties": {
   "audience": {
    "description": "Case-insensitive substring filter for template audience.",
    "type": "string"
   },
   "family": {
    "description": "Filter templates by family.",
    "enum": [
     "nonfiction",
     "fiction"
    ],
    "type": "string"
   },
   "query": {
    "description": "Case-insensitive search across ID, name, description, audience, and use case.",
    "type": "string"
   },
   "use_case": {
    "description": "Case-insensitive substring filter for template use case.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_templates",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "minimum": 0,
    "type": "integer"
   },
   "templates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "audience": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "family": {
       "enum": [
        "nonfiction",
        "fiction"
       ],
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "use_case": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "family",
      "audience",
      "use_case",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "templates",
   "count"
  ],
  "type": "object"
 },
 "title": "List Templates"
}
