{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Station info"},"description":"Facts about one Metra station in the Chicago area on one service date, by station ID or name: its routes, the downtown terminals it serves and facility links when known.","inputSchema":{"additionalProperties":false,"description":"Exactly one of station_id or name. At most one of window_id, arrive_by, or depart_after: it limits terminal_services to the downtown terminals served at that time. Without one, terminal_services is the weekday peak (inbound_am, or outbound_pm when direction is outbound) or, on a Saturday or Sunday service_date, weekend_daytime. arrive_by and depart_after accept a clock time on the service date (H:MM, HH:MM, or HH:MM:SS, Chicago local time) or an RFC 3339 date-time with an offset.","properties":{"arrive_by":{"description":"A clock time on the service date (H:MM, HH:MM, or HH:MM:SS, local time in the region of the address or station) or an RFC 3339 date-time with an offset, for example 09:00, 2026-11-12T09:00:00-06:00, or 2026-11-12T15:00:00Z.","minLength":4,"type":"string"},"buffer_seconds":{"default":300,"maximum":1800,"minimum":0,"type":"integer"},"context":{"additionalProperties":false,"description":"Optional. Fill only with facts the user volunteered. No names, contact details or chat text.","minProperties":1,"properties":{"intent":{"description":"buy or rent, only if the user said so. Tailors the answer.","enum":["buy","rent"],"type":"string"},"wants_agent_contact":{"description":"True only if the user asked to be connected with a listing agent. Returns the agent's contact when listing contact is enabled.","type":"boolean"}},"required":[],"type":"object"},"depart_after":{"description":"A clock time on the service date (H:MM, HH:MM, or HH:MM:SS, local time in the region of the address or station) or an RFC 3339 date-time with an offset, for example 09:00, 2026-11-12T09:00:00-06:00, or 2026-11-12T15:00:00Z.","minLength":4,"type":"string"},"direction":{"enum":["inbound","outbound"],"type":"string"},"name":{"maxLength":80,"minLength":1,"type":"string"},"service_date":{"format":"date","type":"string"},"station_id":{"pattern":"^[A-Z0-9][A-Z0-9_-]{0,63}$","type":"string"},"terminal_id":{"pattern":"^[A-Z0-9][A-Z0-9_-]{0,63}$","type":"string"},"window_id":{"enum":["inbound_am","outbound_pm","inbound_offpeak","outbound_offpeak","weekend_daytime","early_late"],"type":"string"}},"required":["service_date"],"type":"object"},"name":"station_info","outputSchema":{"$defs":{"PublicErrorEnvelope":{"additionalProperties":false,"properties":{"candidates":{"items":{"additionalProperties":false,"properties":{"display":{"maxLength":200,"type":"string"},"id":{"type":"string"},"kind":{"enum":["address","station","place"],"type":"string"}},"required":["kind","id","display"],"type":"object"},"maxItems":5,"type":"array"},"error":{"additionalProperties":false,"properties":{"code":{"enum":["PUBLIC_ADDRESS_AMBIGUOUS","PUBLIC_CAPACITY_UNAVAILABLE","PUBLIC_CONTACT_UNAVAILABLE","PUBLIC_CURSOR_EXPIRED","PUBLIC_CURSOR_INVALID","PUBLIC_DATA_UNAVAILABLE","PUBLIC_INVALID_ARGUMENT","PUBLIC_NOT_FOUND","PUBLIC_NO_SERVICE","PUBLIC_OUT_OF_COVERAGE","PUBLIC_PLACE_AMBIGUOUS","PUBLIC_RATE_LIMITED","PUBLIC_SCHEDULE_UNAVAILABLE","PUBLIC_SEARCH_TOO_BROAD","PUBLIC_STATION_AMBIGUOUS","PUBLIC_STATION_NOT_FOUND","PUBLIC_VERSION_UNSUPPORTED"],"type":"string"},"detail":{"additionalProperties":false,"properties":{"expected":{"maxLength":200,"minLength":1,"type":"string"},"field":{"maxLength":200,"minLength":1,"type":"string"},"reason":{"maxLength":200,"minLength":1,"type":"string"}},"required":["field","reason","expected"],"type":"object"},"message":{"enum":["More than one address matches.","Capacity is unavailable.","Listing contact is unavailable.","The page cursor has expired.","The page cursor is not valid.","Public data is unavailable.","The request is not valid.","No public record is available.","No service is available for that request.","That address is outside Commlo coverage.","More than one place matches.","The request rate is limited.","Schedule data is unavailable.","The search is too broad.","More than one station matches.","No Metra station matches that name or ID.","This contract version is not supported."],"type":"string"},"retry_after_seconds":{"minimum":1,"type":"integer"},"retryable":{"type":"boolean"}},"required":["code","message","retryable"],"type":"object"},"schema_version":{"const":1}},"required":["schema_version","error"],"type":"object"},"PublicStation":{"additionalProperties":false,"properties":{"canonical_url":{"format":"uri","pattern":"^https://","type":"string"},"facility_urls":{"items":{"format":"uri","pattern":"^https://","type":"string"},"maxItems":5,"type":"array","uniqueItems":true},"lat":{"maximum":90,"minimum":-90,"type":"number"},"lon":{"maximum":180,"minimum":-180,"type":"number"},"municipality_id":{"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$","type":"string"},"routes":{"items":{"additionalProperties":false,"properties":{"route_id":{"maxLength":128,"minLength":1,"type":"string"},"route_name":{"maxLength":120,"minLength":1,"type":"string"}},"required":["route_id","route_name"],"type":"object"},"maxItems":20,"minItems":1,"type":"array"},"schema_version":{"const":1},"station_id":{"pattern":"^[A-Z0-9][A-Z0-9_-]{0,63}$","type":"string"},"station_name":{"maxLength":120,"minLength":1,"type":"string"},"terminal_services":{"items":{"additionalProperties":false,"properties":{"name":{"maxLength":120,"minLength":1,"type":"string"},"terminal_id":{"pattern":"^[A-Z0-9][A-Z0-9_-]{0,63}$","type":"string"}},"required":["terminal_id","name"],"type":"object"},"maxItems":5,"type":"array"}},"required":["schema_version","station_id","station_name","lon","lat","routes","terminal_services","facility_urls"],"type":"object"}},"oneOf":[{"$ref":"#/$defs/PublicStation"},{"$ref":"#/$defs/PublicErrorEnvelope"}],"type":"object"},"