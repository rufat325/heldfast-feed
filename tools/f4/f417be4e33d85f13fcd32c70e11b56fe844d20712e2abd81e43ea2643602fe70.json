{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Check a service's real response against terms you registered with witness_register_terms. mode=PUBLIC_REPLAY makes GAIP fetch the public URL itself; mode=BUYER_SUBMITTED checks a response you pass in. Returns PASS/FAIL/UNKNOWN per check and a receipt. Free, read-only, no account. Inputs must be public and non-personal; calling declares that (data_classification defaults to PUBLIC).",
 "inputSchema": {
  "additionalProperties": true,
  "examples": [
   {
    "mode": "PUBLIC_REPLAY",
    "terms_id": "<terms_id from witness_register_terms>"
   }
  ],
  "properties": {
   "body": {
    "maxLength": 32768,
    "type": "string"
   },
   "body_sha256": {
    "type": "string"
   },
   "content_type": {
    "type": "string"
   },
   "continuity_handle": {
    "additionalProperties": false,
    "properties": {
     "continuity_id": {
      "type": "string"
     },
     "token": {
      "type": "string"
     }
    },
    "required": [
     "continuity_id",
     "token"
    ],
    "type": "object"
   },
   "data_classification": {
    "default": "PUBLIC",
    "enum": [
     "PUBLIC",
     "NON_PERSONAL_PUBLIC"
    ],
    "type": "string"
   },
   "episode_id": {
    "type": "string"
   },
   "http_status": {
    "type": "integer"
   },
   "independent_operator_id": {
    "type": "string"
   },
   "mode": {
    "enum": [
     "BUYER_SUBMITTED",
     "PUBLIC_REPLAY"
    ],
    "type": "string"
   },
   "synthetic": {
    "type": "boolean"
   },
   "terms_id": {
    "type": "string"
   }
  },
  "required": [
   "terms_id",
   "mode"
  ],
  "type": "object"
 },
 "name": "witness_delivery",
 "title": "Check public delivery evidence"
}
