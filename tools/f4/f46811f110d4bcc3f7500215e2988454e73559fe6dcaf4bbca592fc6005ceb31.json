{
 "description": "Merge two sorted data files into one. Both must share the same format (.F)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "file_a": {
    "description": "First data file",
    "type": "string"
   },
   "file_b": {
    "description": "Second data file",
    "type": "string"
   },
   "key": {
    "description": "Merge key field",
    "type": "string"
   },
   "output": {
    "description": "Output file name",
    "type": "string"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "userid": {
    "description": "Project owner's username. Required when accessing a shared project where you are a writer. Defaults to the authenticated user.",
    "type": "string"
   }
  },
  "required": [
   "project",
   "file_a",
   "file_b",
   "output",
   "key"
  ],
  "type": "object"
 },
 "name": "chaprola_merge"
}
