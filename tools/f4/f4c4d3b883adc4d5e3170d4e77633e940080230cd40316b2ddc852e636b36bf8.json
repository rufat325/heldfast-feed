{
 "description": "Get one public Polymarket wallet's portfolio, positions, activity, history, and performance stats.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activityLimit": {
    "default": 200,
    "maximum": 5000,
    "minimum": 1,
    "type": "number"
   },
   "address": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "polyrama_get_trader"
}
