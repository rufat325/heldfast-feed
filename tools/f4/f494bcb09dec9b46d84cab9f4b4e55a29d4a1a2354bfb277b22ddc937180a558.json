{
 "_meta": {
  "openai/fileParams": [
   "plan"
  ],
  "securitySchemes": [
   {
    "scopes": [
     "plans:write",
     "offline_access"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Attach a PDF selected in this conversation as the first plan for a new Portravo project. Only PDF attachments up to 25 MiB are supported. Prefer the host-provided plan download_url/file_id. If unavailable, plan_inline accepts canonical base64 computed from the exact user-uploaded PDF bytes, with file_name and application/pdf mime_type, up to 32 KiB. Supply exactly one of plan or plan_inline; never recreate document bytes from text. Existing plans and review work are protected. Supply a stable idempotency_key and reuse it on retry. Stores the selected PDF privately in the connected account; does not extract or consume credits.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
   {
    "not": {
     "required": [
      "plan_inline"
     ]
    },
    "required": [
     "plan"
    ]
   },
   {
    "not": {
     "required": [
      "plan"
     ]
    },
    "required": [
     "plan_inline"
    ]
   }
  ],
  "properties": {
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9_.:-]+$",
    "type": "string"
   },
   "plan": {
    "additionalProperties": false,
    "properties": {
     "download_url": {
      "format": "uri",
      "maxLength": 8192,
      "type": "string"
     },
     "file_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     "file_name": {
      "maxLength": 200,
      "minLength": 5,
      "pattern": "^[^/\\\\\\x00-\\x1f]+\\.pdf$",
      "type": "string"
     },
     "mime_type": {
      "const": "application/pdf",
      "type": "string"
     }
    },
    "required": [
     "download_url",
     "file_id"
    ],
    "type": "object"
   },
   "plan_inline": {
    "additionalProperties": false,
    "properties": {
     "data_base64": {
      "maxLength": 43692,
      "minLength": 4,
      "type": "string"
     },
     "file_name": {
      "maxLength": 200,
      "minLength": 5,
      "pattern": "^[^/\\\\\\x00-\\x1f]+\\.pdf$",
      "type": "string"
     },
     "mime_type": {
      "const": "application/pdf",
      "type": "string"
     }
    },
    "required": [
     "data_base64",
     "mime_type",
     "file_name"
    ],
    "type": "object"
   },
   "project_id": {
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "attach_plan_pdf",
 "outputSchema": {
  "properties": {
   "planFileId": {
    "type": "string"
   },
   "reviewUrl": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "planFileId",
   "status",
   "reviewUrl"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "plans:write",
    "offline_access"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Attach a construction plan PDF"
}
