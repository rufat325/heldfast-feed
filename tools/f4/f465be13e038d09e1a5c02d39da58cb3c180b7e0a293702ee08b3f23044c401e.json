{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The modules of an ELMS (Canvas) course with their items (assignments, files, pages, links) and completion state. File items carry the link to lecture slides even when the Files tab is hidden. Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "course_id": {
    "description": "Canvas course id, from elms_list_courses",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "course_id"
  ],
  "type": "object"
 },
 "name": "elms_list_modules",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "modules": {
    "description": "Modules in course order",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "items": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "completed": {
          "description": "Completion requirement met; null when there is none",
          "type": [
           "boolean",
           "null"
          ]
         },
         "content_id": {
          "anyOf": [
           {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
           },
           {
            "type": "null"
           }
          ],
          "description": "Id of the assignment, file, page or discussion"
         },
         "due_at": {
          "description": "ISO 8601 timestamp (UTC); null when unset",
          "type": [
           "string",
           "null"
          ]
         },
         "external_url": {
          "type": [
           "string",
           "null"
          ]
         },
         "id": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         "indent": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "locked": {
          "type": "boolean"
         },
         "points_possible": {
          "type": [
           "number",
           "null"
          ]
         },
         "title": {
          "type": "string"
         },
         "type": {
          "enum": [
           "File",
           "Page",
           "Discussion",
           "Assignment",
           "Quiz",
           "SubHeader",
           "ExternalUrl",
           "ExternalTool"
          ],
          "type": "string"
         },
         "url": {
          "description": "Link to the item in ELMS",
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "id",
         "title",
         "type",
         "indent",
         "content_id",
         "url",
         "external_url",
         "due_at",
         "points_possible",
         "completed",
         "locked"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "position": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "state": {
       "anyOf": [
        {
         "enum": [
          "locked",
          "unlocked",
          "started",
          "completed"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "unlock_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "name",
      "position",
      "state",
      "unlock_at",
      "items"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "modules"
  ],
  "type": "object"
 },
 "title": "List ELMS modules"
}
