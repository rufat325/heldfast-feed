{
 "_meta": {
  "openai/toolInvocation/invoked": "Listings ready",
  "openai/toolInvocation/invoking": "Searching TicketSea"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search artists, teams, venues and events"
 },
 "description": "Use this when the user names an artist, team, venue or event and you need the matching TicketSea records. Ranked search with prefixes, aliases and labeled one-edit corrections. Artist and venue matches are worldwide; an event radius needs a city ID or a full City, Region, Country label. Results are cached listings, not live inventory, and this is a search by name, not a dated list of events.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "city": {
    "description": "City the user asked about: a TicketSea city ID or an exact City, Region, Country label. Required for a distance radius.",
    "maxLength": 160,
    "type": "string"
   },
   "from": {
    "format": "date",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 24,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "default": "results",
    "description": "suggest is a bounded autocomplete preview without pagination; short prefixes match names and aliases. Use results for full context matching and pagination.",
    "enum": [
     "results",
     "suggest"
    ],
    "type": "string"
   },
   "offset": {
    "default": 0,
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Artist, team, venue or event name, or the start of one.",
    "maxLength": 120,
    "type": "string"
   },
   "radius": {
    "default": "anywhere",
    "description": "Miles around city for event results.",
    "enum": [
     "75",
     "200",
     "anywhere"
    ],
    "type": "string"
   },
   "sale": {
    "description": "soon selects events whose public on-sale has not started yet. Give a specific query (an artist or a city name) with it; use radius 200 for local on-sales.",
    "enum": [
     "all",
     "soon"
    ],
    "type": "string"
   },
   "to": {
    "format": "date",
    "type": "string"
   },
   "type": {
    "description": "Limit results to one record type.",
    "enum": [
     "all",
     "artist",
     "venue",
     "event"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "search_catalog",
