 "description": "Check that each amount can exist in the currency it names. Reports an amount needing more decimal places than its currency has, where a currency with no sub-unit cannot hold a fraction at all. Also reports an amount that arrived as a JSON number rather than a decimal string, since a binary double cannot hold most two-place decimals exactly, so the digits may already differ from what was written. Pay 140000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "amounts": {
    "description": "The amounts to check. Nothing is fetched and no system is connected, so the data supplied is the whole input.",
    "example": [
     {
      "amount": "19.99",
      "currency": "AUD",
      "id": "A-1"
     },
     {
      "amount": "1250.50",
      "currency": "JPY",
      "id": "A-2"
     },
     {
      "amount": "12.345",
      "currency": "KWD",
      "id": "A-3"
     },
     {
      "amount": 0.1,
      "currency": "USD",
      "id": "A-4"
     },
     {
      "amount": "0.00000001",
      "currency": "Bitcoin",
      "id": "A-5"
     },
     {
      "amount": "19.990",
      "currency": "AUD",
      "id": "A-6"
     }
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "description": "The amount. A decimal string is preferred, because a JSON number cannot hold most two-place decimals exactly and the digits may already differ from what was written by the time they arrive. A number is accepted and that risk is reported.",
       "type": [
        "string",
        "number"
       ]
      },
      "currency": {
       "maxLength": 8,
       "type": "string"
      },
      "id": {
       "maxLength": 128,
       "type": "string"
      }
     },
     "required": [
      "currency",
      "amount"
     ],
     "type": "object"
    },
    "maxItems": 20000,
    "minItems": 1,
    "type": "array"
   },
   "minor_units": {
    "description": "Decimal places per currency code, overriding the published table. Two is the default because most currencies have two.",
    "type": "object"
   },
   "permitted_currencies": {
    "description": "The currencies permitted. Anything else is reported.",
    "example": [
     "AUD",
     "USD",
     "JPY",
     "KWD"
    ],
    "items": {
     "maxLength": 8,
     "type": "string"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
