{
 "description": "Deprecated compatibility alias for applying a previously reviewed Source -> KG -> Process WorkspaceUseCase package.\n\nUse preview_use_case_kit first, review the deterministic plan, and pass back its exact signed preview only after the user approves those writes. The server recompiles the typed kit and rejects any changed payload, stale preview, collision, or mismatched binding. This delegates to the shared paused package lifecycle; it does not run workflows, insert KG rows, send messages, write to external providers, trigger routines, make approval decisions, or spend credits. Requires confirmToken exactly \"PROVISION_USE_CASE_KIT\" and the exact preview object.\n\nRequires write access when connected with OAuth.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collaboratorUserIds": {
    "description": "Collaborator user IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "config": {
    "additionalProperties": {},
    "description": "Use-case config",
    "type": "object"
   },
   "confirmToken": {
    "const": "PROVISION_USE_CASE_KIT",
    "description": "Required explicit confirmation token for kit provisioning writes",
    "type": "string"
   },
   "description": {
    "description": "Use-case description",
    "type": "string"
   },
   "installProfile": {
    "additionalProperties": false,
    "description": "Optional additive shared-assistant sourcing profile",
    "properties": {
     "brief": {
      "additionalProperties": false,
      "description": "Known brief fields; missing values are proposed from context",
      "properties": {
       "geography": {
        "description": "Geographic scope for the first bounded pass",
        "type": "string"
       },
       "qualificationCriteria": {
        "description": "Business criteria for a useful match",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "targetEntityOrRole": {
        "description": "Who or what the workspace wants to find",
        "type": "string"
       }
      },
      "type": "object"
     },
     "caps": {
      "additionalProperties": false,
      "description": "Bounded first-run and recurring configuration caps",
      "properties": {
       "creditCap": {
        "maximum": 5,
        "minimum": 1,
        "type": "integer"
       },
       "rowCap": {
        "maximum": 5,
        "minimum": 1,
        "type": "integer"
       }
      },
      "type": "object"
     },
     "context": {
      "additionalProperties": false,
      "properties": {
       "company": {
        "additionalProperties": false,
        "description": "Known company context used to propose the brief",
        "properties": {
         "description": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "website": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "earlierAnswers": {
        "additionalProperties": {},
        "description": "Earlier structured onboarding answers",
        "type": "object"
       },
       "selectedUseCase": {
        "additionalProperties": {},
        "description": "Selected or expressed use-case context",
        "type": "object"
       },
       "workspaceGeography": {
        "description": "Known workspace or onboarding geography",
        "type": "string"
       },
       "workspaceKnowledgeHints": {
        "description": "Relevant workspace knowledge labels or summaries",
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "type": "object"
     },
     "intent": {
      "description": "Explicit sourcing intent; this is not inferred from arbitrary keywords",
      "enum": [
       "lead-generation",
       "deal-sourcing",
       "company-discovery",
       "local-business-prospecting",
       "fresh-signal-sourcing"
      ],
      "type": "string"
     },
     "operatingGuideKey": {
      "description": "Workspace operating-guide key to create when atomic provisioning is available",
      "type": "string"
     },
     "signalKitOwnedWorkflowIds": {
      "description": "Existing workflow ids owned by this install profile; unrelated assignments are preserved",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "sources": {
      "description": "Visible source readiness and cadence contract",
      "items": {
       "additionalProperties": false,
       "properties": {
        "activation": {
         "description": "Whether collection is scheduled, on demand, or paused",
         "enum": [
          "scheduled",
          "manual",
          "paused"
         ],
         "type": "string"
        },
        "cadence": {
         "description": "Client-facing source cadence, such as Weekly on Monday",
         "minLength": 1,
         "type": "string"
        },
        "critical": {
         "description": "Whether this source is required for the customer use case",
         "type": "boolean"
        },
        "id": {
         "description": "Stable source id",
         "minLength": 1,
         "type": "string"
        },
        "label": {
         "description": "Client-facing source name",
         "minLength": 1,
         "type": "string"
        },
        "proof": {
         "description": "Strongest completed source proof",
         "enum": [
          "end-to-end",
          "source-only",
          "pending"
         ],
         "type": "string"
        },
        "status": {
         "description": "Current source readiness state",
         "enum": [
          "ready",
          "validation-required",
          "connection-required"
         ],
         "type": "string"
        }
       },
       "required": [
        "id",
        "label",
        "status",
        "activation",
        "cadence",
        "proof"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "type": {
      "const": "shared-assistant-sourcing-v1",
      "type": "string"
     }
    },
    "required": [
     "type",
     "intent"
    ],
    "type": "object"
   },
   "key": {
    "description": "Stable workspace-local use-case key, e.g. business-intro",
    "type": "string"
   },
   "list": {
    "additionalProperties": false,
    "description": "Shared knowledge-list spec",
    "properties": {
     "dedupBy": {
      "description": "Deduplication strategy",
      "enum": [
       "userKey",
       "composite"
      ],
      "type": "string"
     },
     "initialStatus": {
      "description": "Initial status for inserted rows",
      "type": "string"
     },
     "key": {
      "description": "Knowledge list key for the shared target list",
      "type": "string"
     },
     "name": {
      "description": "Knowledge list display name",
      "type": "string"
     },
     "schema": {
      "description": "Reviewable knowledge-list schema",
      "items": {
       "additionalProperties": false,
       "properties": {
        "description": {
         "description": "Field description",
         "type": "string"
        },
        "key": {
         "description": "Field key",
         "type": "string"
        },
        "label": {
         "description": "Human-readable field label",
         "type": "string"
        },
        "required": {
         "description": "Whether the field is required",
         "type": "boolean"
        },
        "type": {
         "description": "Field type, e.g. string, url, select, date",
         "type": "string"
        }
       },
       "required": [
        "key"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "statusField": {
      "description": "Status field name",
      "type": "string"
     },
     "userKeyField": {
      "description": "Field used as the stable user key",
      "type": "string"
     }
    },
    "required": [
     "key"
    ],
    "type": "object"
   },
   "locale": {
    "description": "Workflow-agent locale bound into the exact preview; defaults to en",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Additional metadata",
    "type": "object"
   },
   "name": {
    "description": "Use-case display name",
    "minLength": 1,
    "type": "string"
   },
   "orchestrator": {
    "additionalProperties": false,
    "description": "Optional orchestrator/qualifier spec",
    "properties": {
     "criteria": {
      "description": "Qualification criteria",
      "type": "string"
     },
     "name": {
      "description": "Orchestrator/qualifier workflow name",
      "type": "string"
     },
     "onMatch": {
      "description": "Follow-up action after match",
      "enum": [
       "outreach",
       "slack",
       "none"
      ],
      "type": "string"
     },
     "outreachWorkflowId": {
      "description": "Existing outreach workflow id when onMatch is outreach",
      "type": "string"
     },
     "pipeline": {
      "additionalProperties": {},
      "description": "Concrete orchestrator workflow pipeline payload to provision later after preview approval",
      "type": "object"
     },
     "schedule": {
      "description": "Optional schedule/cadence",
      "type": "string"
     }
    },
    "type": "object"
   },
   "ownerUserId": {
    "description": "Owner user ID",
    "type": "string"
   },
   "preview": {
    "additionalProperties": {},
    "description": "Exact signed preview object returned by preview_use_case_kit",
    "type": "object"
   },
   "receiver": {
    "additionalProperties": false,
    "description": "One receiver/processor workflow for a shared-assistant sourcing install",
    "properties": {
     "name": {
      "description": "Client-facing receiver workflow name",
      "minLength": 1,
      "type": "string"
     },
     "pipeline": {
      "additionalProperties": {},
      "description": "Concrete receiver workflow pipeline payload for the reviewed plan",
      "type": "object"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "setupHint": {
    "description": "Setup hint for the UI",
    "type": "string"
   },
   "source": {
    "description": "How this use case will be created; defaults to custom",
    "enum": [
     "onboarding",
     "catalog",
     "custom",
     "imported"
    ],
    "type": "string"
   },
   "sources": {
    "description": "Source workflow specs",
    "items": {
     "additionalProperties": false,
     "properties": {
      "config": {
       "additionalProperties": {},
       "description": "Source config to review before workflow creation",
       "type": "object"
      },
      "criteriaInputPage": {
       "description": "Optional criteria/input page id",
       "type": "string"
      },
      "id": {
       "description": "Stable source id; defaults from name",
       "type": "string"
      },
      "kind": {
       "description": "Source type",
       "enum": [
        "search",
        "scrape",
        "api",
        "manual",
        "workflow"
       ],
       "type": "string"
      },
      "name": {
       "description": "Source workflow display name",
       "type": "string"
      },
      "pipeline": {
       "additionalProperties": {},
       "description": "Concrete workflow pipeline payload to provision later after preview approval",
       "type": "object"
      },
      "schedule": {
       "description": "Optional schedule/cadence",
       "type": "string"
      }
     },
     "required": [
      "name",
      "kind"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "description": "Lifecycle status; defaults to draft",
    "enum": [
     "selected",
     "draft",
     "active",
     "paused",
     "archived"
    ],
    "type": "string"
   },
   "tail": {
    "additionalProperties": false,
    "description": "Shared tail workflow spec",
    "properties": {
     "name": {
      "description": "Shared tail workflow name",
      "type": "string"
     },
     "normalizePrompt": {
      "description": "Normalization prompt/spec before upsert",
      "type": "string"
     },
     "pipeline": {
      "additionalProperties": {},
      "description": "Concrete shared-tail workflow pipeline payload to provision later after preview approval",
      "type": "object"
     },
     "upsertStrategy": {
      "description": "Shared-list upsert strategy",
      "enum": [
       "merge",
       "overwrite"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "workflowGraphId": {
    "description": "Runtime workflowGraphId bridge; defaults to key",
    "type": "string"
   },
   "workspaceSlug": {
    "description": "Optional workspace slug for readable preview ids",
    "type": "string"
   }
  },
  "required": [
   "name",
   "confirmToken",
   "preview"
  ],
  "type": "object"
 },
 "name": "provision_use_case_kit"
}
