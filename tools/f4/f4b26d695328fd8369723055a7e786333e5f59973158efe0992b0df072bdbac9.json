  "readOnlyHint": true,
  "title": "Track an order"
 },
 "description": "Use this when a signed in customer asks where one teas.co.uk order is. order_number is the number from my_orders or the order confirmation email, with or without a leading #. Only orders on the linked account are found; any other number returns a not found error. Once the order has shipped it includes courier tracking links; before that, a note on dispatch times. can_return says whether start_return can be used. For a list of recent orders use my_orders.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "order_number": {
    "description": "The order number, for example 123456.",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "order_number"
  ],
  "type": "object"
 },
 "name": "track_order",
