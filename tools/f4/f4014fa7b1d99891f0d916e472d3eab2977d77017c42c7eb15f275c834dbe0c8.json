{
 "description": "List recent executions (run history) for a job.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "jobId": {
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "success",
     "failed",
     "timeout",
     "running",
     "pending",
     "dead_letter",
     "quota_exceeded"
    ],
    "type": "string"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "list_executions"
}
