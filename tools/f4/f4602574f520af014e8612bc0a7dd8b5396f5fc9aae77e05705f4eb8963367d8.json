{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Consumption History"
 },
 "description": "Search your consumption history \u2014 wines you've opened and drunk. Filter by wine name, color, or date range. Returns most recent consumptions first with tasting context, up to max_results per page (default 25) \u2014 pass offset to page through more.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "color": {
    "description": "Filter by color (Red, White, Ros\u00e9)",
    "type": "string"
   },
   "date_from": {
    "description": "Start date (YYYY-MM-DD)",
    "type": "string"
   },
   "date_to": {
    "description": "End date (YYYY-MM-DD)",
    "type": "string"
   },
   "max_results": {
    "description": "Maximum results (default 25)",
    "type": "number"
   },
   "offset": {
    "description": "Result offset for pagination (default 0)",
    "type": "number"
   },
   "query": {
    "description": "Wine name search term",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "consumption-history",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "offset": {
    "type": "number"
   },
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "notes": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "value": {
       "type": "string"
      },
      "vintage": {
       "type": "string"
      },
      "wine": {
       "type": "string"
      }
     },
     "required": [
      "date",
      "wine",
      "vintage"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "total",
   "offset",
   "count",
   "rows"
  ],
  "type": "object"
 }
}
