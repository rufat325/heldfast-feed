{
 "description": "Predict how entertaining a game will be (1-10 buzz score) with the @buzzr/entertainment-engine ML model. Returns the score, model confidence, and the weighted factors behind the prediction. Odds, team power, injuries, and narrative context sharpen the estimate.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "awayTeam": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "engagement": {
    "additionalProperties": false,
    "description": "Fan engagement signals for the matchup.",
    "properties": {
     "averageRating": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": -1000000000,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "fireCount": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "ratingCount": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "skipCount": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   },
   "gameType": {
    "anyOf": [
     {
      "enum": [
       "regular",
       "playin",
       "playoff"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Regular season, play-in, or playoff."
   },
   "homeTeam": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "injuries": {
    "additionalProperties": false,
    "description": "Injury impact per team.",
    "properties": {
     "away": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": -1000000000,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "home": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": -1000000000,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   },
   "league": {
    "description": "League code, e.g. \"NBA\", \"NFL\", \"EPL\", \"WC\".",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "narratives": {
    "additionalProperties": false,
    "description": "Narrative flags that boost buzz (rivalries, debuts, revenge games).",
    "properties": {
     "hasDebut": {
      "type": "boolean"
     },
     "isRivalry": {
      "type": "boolean"
     },
     "playerVsFormerTeam": {
      "type": "boolean"
     },
     "rivalryIntensity": {
      "anyOf": [
       {
        "const": 1,
        "type": "number"
       },
       {
        "const": 2,
        "type": "number"
       },
       {
        "const": 3,
        "type": "number"
       }
      ]
     }
    },
    "type": "object"
   },
   "odds": {
    "additionalProperties": false,
    "description": "Betting-market context for the game.",
    "properties": {
     "awayMoneyline": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": -1000000000,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "homeMoneyline": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": -1000000000,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "overUnder": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": -1000000000,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "spread": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": -1000000000,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "description": "Point spread relative to the home team."
     }
    },
    "type": "object"
   },
   "searchHeat": {
    "additionalProperties": false,
    "description": "Per-team search interest in [-1, 1].",
    "properties": {
     "away": {
      "anyOf": [
       {
        "maximum": 1,
        "minimum": -1,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "home": {
      "anyOf": [
       {
        "maximum": 1,
        "minimum": -1,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   },
   "starPower": {
    "anyOf": [
     {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Marquee player availability / skill density in [0, 1]."
   },
   "startsAt": {
    "description": "ISO 8601 kickoff/tip-off time, e.g. \"2026-07-06T19:30:00Z\".",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "status": {
    "description": "Game status. The model only predicts games that are not in progress.",
    "enum": [
     "scheduled",
     "in_progress",
     "final",
     "postponed",
     "cancelled"
    ],
    "type": "string"
   },
   "teamPower": {
    "additionalProperties": false,
    "description": "Team power ratings.",
    "properties": {
     "away": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": -1000000000,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "home": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": -1000000000,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   }
  },
  "required": [
   "league",
   "homeTeam",
   "awayTeam",
   "startsAt"
  ],
  "type": "object"
 },
 "name": "predict_game_buzz",
 "title": "Predict game buzz"
}
