 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bg": {
    "description": "Background color as hex (default: \"#ffffff\")",
    "type": "string"
   },
   "color": {
    "description": "Foreground color as hex (default: \"#1a1a2e\")",
    "type": "string"
   },
   "format": {
    "description": "Output format: \"svg\" (the only format)",
    "enum": [
     "svg"
    ],
    "type": "string"
   },
   "margin": {
    "description": "Margin/quiet zone size (default: 1, range: 0-10)",
    "type": "number"
   },
   "size": {
    "description": "Size in pixels (default: 200, range: 50-1000)",
    "type": "number"
   },
   "text": {
    "description": "Text or URL to encode in the QR code",
    "type": "string"
   }
  },
  "required": [
