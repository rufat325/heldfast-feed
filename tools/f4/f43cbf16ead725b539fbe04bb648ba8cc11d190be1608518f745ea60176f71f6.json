{
 "description": "Generate items based on the world seed. Returns a prompt for LLM execution.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "default": 20,
    "description": "Number of items to generate",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "kinds": {
    "default": [
     "weapon",
     "armor",
     "consumable",
     "special",
     "misc"
    ],
    "description": "Item kinds to include (at least one required)",
    "items": {
     "enum": [
      "weapon",
      "armor",
      "consumable",
      "special",
      "misc"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "generate_items"
}
