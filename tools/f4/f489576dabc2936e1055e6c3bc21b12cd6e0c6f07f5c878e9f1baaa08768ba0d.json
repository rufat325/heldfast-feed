{
 "description": "Send an email from your @chaprola.org address. Subject to content moderation",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Sender local part (default: your username)",
    "type": "string"
   },
   "html": {
    "description": "HTML body",
    "type": "string"
   },
   "subject": {
    "description": "Email subject",
    "type": "string"
   },
   "text": {
    "description": "Plain text body",
    "type": "string"
   },
   "to": {
    "description": "Recipient email address",
    "type": "string"
   }
  },
  "required": [
   "to",
   "subject",
   "text"
  ],
  "type": "object"
 },
 "name": "chaprola_email_send"
}
