{
 "description": "Advance one loop leg: ATTACH_ENV/MARK_TRAJECTORIES_READY/ATTACH_RUN (launch spend rides POST /training-runs \u2014 attach the run here)/CREATE_EVAL (prompts required for inline-sourced runs)/ATTACH_EVAL (an already-completed eval advances straight to EVALUATED)/CLOSE. Requires workflow:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "ATTACH_ENV",
     "MARK_TRAJECTORIES_READY",
     "ATTACH_RUN",
     "CREATE_EVAL",
     "ATTACH_EVAL",
     "CLOSE"
    ],
    "type": "string"
   },
   "evalProjectId": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "prompts": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "trainingRunId": {
    "type": "string"
   },
   "workflowRunId": {
    "type": "string"
   }
  },
  "required": [
   "workflowRunId",
   "action"
  ],
  "type": "object"
 },
 "name": "opentrain_workflow_advance",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
