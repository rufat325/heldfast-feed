{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read more sections of a Guide"
 },
 "description": "Follow-up to get_skill: fetch sections it listed in `section_index` as not inlined (for example a supplier-pattern library). Pass `section_index` for one section, or omit it to get every section with its heading and markdown.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "512x512"
   ],
   "src": "https://www.openaccountants.com/logo-circle.png"
  }
 ],
 "inputSchema": {
  "properties": {
   "section_index": {
    "description": "Optional. Return only this section (matches the `index` from get_skill's `section_index`).",
    "type": "integer"
   },
   "section_indices": {
    "description": "Optional. Return only these sections.",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "slug": {
    "description": "Skill slug",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_skill_sections",
 "outputSchema": {
  "properties": {
   "guardrails": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "key_facts": {
    "description": "Optional at-a-glance facts \u2014 present only where the skill carries a structured key_facts block; omitted otherwise.",
    "type": "object"
   },
   "next_action": {
    "type": "string"
   },
   "sections": {
    "items": {
     "properties": {
      "heading": {
       "type": "string"
      },
      "heading_level": {
       "type": [
        "integer",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "markdown_content": {
       "type": "string"
      },
      "section_index": {
       "type": "integer"
      }
     },
     "required": [
      "heading",
      "markdown_content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "slug": {
    "type": "string"
   },
   "version": {
    "type": [
     "integer",
     "number"
    ]
   }
  },
  "required": [
   "slug",
   "sections"
  ],
  "type": "object"
 },
 "title": "Read more sections of a Guide"
}
