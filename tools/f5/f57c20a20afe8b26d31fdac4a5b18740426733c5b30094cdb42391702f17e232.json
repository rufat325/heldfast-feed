{
 "description": "File a dispute against a data artifact. The protocol records disputes \u2014 resolution is external.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "artifactId": {
    "type": "string"
   },
   "disputeType": {
    "enum": [
     "unauthorized_access",
     "terms_violation",
     "compensation_dispute",
     "revocation_dispute",
     "lineage_dispute"
    ],
    "type": "string"
   },
   "evidence": {
    "description": "Evidence artifact IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filedBy": {
    "type": "string"
   }
  },
  "required": [
   "artifactId",
   "disputeType",
   "filedBy",
   "evidence"
  ],
  "type": "object"
 },
 "name": "file_data_dispute"
}
