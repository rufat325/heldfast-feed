{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Render Resume PDF"
 },
 "description": "Render a resume as PDF with specific template and styling settings. Costs 1 API credit.",
 "inputSchema": {
  "properties": {
   "colorId": {
    "description": "Color scheme identifier for the template",
    "type": "string"
   },
   "font": {
    "description": "Font family name (e.g. Inter, Roboto)",
    "type": "string"
   },
   "fontSize": {
    "description": "Base font size in points",
    "type": "number"
   },
   "locale": {
    "description": "Language/locale code (e.g. en, de, fr)",
    "type": "string"
   },
   "margin": {
    "description": "Page margin in millimeters",
    "type": "number"
   },
   "pageNumbering": {
    "description": "Page numbering style",
    "enum": [
     "none",
     "simple",
     "fraction",
     "page"
    ],
    "type": "string"
   },
   "resumeId": {
    "description": "Resume UUID to render",
    "type": "string"
   },
   "spacing": {
    "description": "Line spacing multiplier (e.g. 1.0, 1.15, 1.5)",
    "type": "number"
   },
   "templateId": {
    "description": "Template identifier (e.g. GRAPHITE)",
    "type": "string"
   }
  },
  "required": [
   "resumeId",
   "templateId"
  ],
  "type": "object"
 },
 "name": "laddro.resumes.render",
 "outputSchema": {
  "properties": {
   "content": {
    "description": "Base64-encoded PDF data",
    "type": "string"
   },
   "mimeType": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
