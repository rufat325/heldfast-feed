 "description": "Which git providers Layero supports and which of them the organization\n    has connected (GitHub App installations and provider tokens).\n\n    Call before `import_repo` when you are not sure the provider is\n    connected. Connecting a provider token is done by the person in the\n    dashboard \u2014 never ask them to paste the token into the chat.\n    ",
 "inputSchema": {
  "properties": {
   "organization": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Organization slug. Without it \u2014 the account's only organization, or the personal one; if there are several and none is personal, the tool lists the slugs.",
    "title": "Organization"
   }
  },
  "title": "list_sourcesArguments",
  "type": "object"
 },
 "name": "list_sources",
 "outputSchema": {
  "$defs": {
