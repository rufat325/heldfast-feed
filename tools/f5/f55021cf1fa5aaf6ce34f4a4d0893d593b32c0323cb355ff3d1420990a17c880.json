      "default": true,
      "title": "Can Import",
      "type": "boolean"
     },
     "key": {
      "title": "Key",
      "type": "string"
     },
     "login": {
      "title": "Login",
      "type": "string"
     },
     "provider": {
      "title": "Provider",
      "type": "string"
     },
     "status": {
      "title": "Status",
      "type": "string"
     },
     "status_note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Status Note"
     }
    },
    "required": [
     "key",
     "provider",
     "login",
     "status"
    ],
    "title": "SourceAccountBrief",
    "type": "object"
   },
   "SourceProviderBrief": {
    "properties": {
     "id": {
      "title": "Id",
