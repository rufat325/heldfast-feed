{
 "description": "Validate and place an order at a meni.ge location. Returns orderId (keep it \u2014 it is the access token for status checks) and the computed total. customer.name/phone are required for pickup and delivery; delivery.address is required for delivery. Pass either items (inline) or cartId (the cart built with update_cart) \u2014 not both. Always pass idempotencyKey when you might retry: the same key within 48h returns the original order instead of placing a second one.",
 "inputSchema": {
  "properties": {
   "cartId": {
    "description": "Order this cart; mutually exclusive with items",
    "type": "string"
   },
   "customer": {
    "properties": {
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "delivery": {
    "properties": {
     "address": {
      "type": "string"
     },
     "notes": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "domain": {
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Retry guard, e.g. a UUID you keep for this order attempt",
    "maxLength": 64,
    "minLength": 8,
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "addons": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "itemId": {
       "type": "string"
      },
      "quantity": {
       "default": 1,
       "minimum": 1,
       "type": "integer"
      },
      "variants": {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "itemId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "language": {
    "type": "string"
   },
   "notes": {
    "type": "string"
   },
   "orderType": {
    "enum": [
     "dine-in",
     "delivery",
     "pickup"
    ],
    "type": "string"
   },
   "paymentMethod": {
    "enum": [
     "cash",
     "card-on-delivery",
     "online"
    ],
    "type": "string"
   },
   "pickup": {
    "properties": {
     "scheduledFor": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "qrCode": {
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "create_order"
}
