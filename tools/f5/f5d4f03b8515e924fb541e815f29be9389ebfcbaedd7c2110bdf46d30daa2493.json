{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Explain the source labels, provenance, confidence, and caveats behind Loa prices for one hospital or provider entity. Use this when an agent needs to tell a user why prices are MRF-published, Loa-reviewed, estimated, or unavailable.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cpt_codes": {
    "description": "Optional CPT codes to explain. If omitted, explains current indexed prices.",
    "items": {
     "type": "string"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   },
   "limit": {
    "default": 50,
    "description": "Maximum number of prices to inspect, default 50, max 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "slug": {
    "description": "Exact Loa entity slug from search_entities.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "explain_price_sources",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "caveats": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "comparable_mrf_price_count": {
    "type": "number"
   },
   "cpt_codes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "entity": {
    "additionalProperties": false,
    "properties": {
     "canonicalName": {
      "type": "string"
     },
     "city": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "entityType": {
      "enum": [
       "hospital",
       "provider"
      ],
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     },
     "state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "entityType",
     "slug",
     "canonicalName",
     "city",
     "state"
    ],
    "type": "object"
   },
   "price_count": {
    "type": "number"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "authority": {
      "enum": [
       "authoritative",
       "advisory",
       "estimate"
      ],
      "type": "string"
     },
     "basis": {
      "type": "string"
     },
     "methodology_url": {
      "format": "uri",
      "type": "string"
     },
     "source_scope": {
      "type": "string"
     },
     "source_url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "authority",
     "basis",
     "methodology_url"
    ],
    "type": "object"
   },
   "source_summary": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authority": {
       "type": "string"
      },
      "caveats": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "comparableMrfPriceCount": {
       "type": "number"
      },
      "confidence": {
       "type": "string"
      },
      "count": {
       "type": "number"
      },
      "label": {
       "type": "string"
      },
      "sourceType": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "authority",
      "sourceType",
      "confidence",
      "count",
      "comparableMrfPriceCount",
      "caveats"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "entity",
   "cpt_codes",
   "price_count",
   "comparable_mrf_price_count",
   "source_summary",
   "caveats",
   "provenance"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "openid",
    "email",
    "profile"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Explain Price Sources"
}
