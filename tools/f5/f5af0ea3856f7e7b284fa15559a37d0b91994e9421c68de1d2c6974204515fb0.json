{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Export MongoDB server logs to Object Storage",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucketName": {
    "description": "Object Storage bucket name",
    "type": "string"
   },
   "cloudMongoDbExportObjectList": {
    "description": "List of log objects to export",
    "items": {
     "additionalProperties": false,
     "properties": {
      "fullObjectName": {
       "description": "Full object name of the log file to export",
       "type": "string"
      }
     },
     "required": [
      "fullObjectName"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "cloudMongoDbInstanceNo": {
    "description": "Cloud MongoDB instance number",
    "type": "string"
   },
   "cloudMongoDbServerInstanceNo": {
    "description": "Cloud MongoDB server instance number",
    "type": "string"
   },
   "folderPath": {
    "description": "Folder path in the bucket",
    "type": "string"
   }
  },
  "required": [
   "cloudMongoDbInstanceNo",
   "cloudMongoDbServerInstanceNo",
   "bucketName",
   "cloudMongoDbExportObjectList"
  ],
  "type": "object"
 },
 "name": "ncloud_export_mongodb_log"
}
