{
 "description": "Create and run a standalone Persona report \u2014 not tied to an inquiry flow. Use for ad-hoc watchlist screening, adverse media, business (KYB) lookups, address verification, or profile checks against a known identity. Pass the appropriate `report-type` plus the query fields the report needs.",
 "inputSchema": {
  "properties": {
   "account-id": {
    "description": "Optional Persona account id (act_...) to attach the report to.",
    "type": "string"
   },
   "address-city": {
    "type": "string"
   },
   "address-postal-code": {
    "type": "string"
   },
   "address-street-1": {
    "type": "string"
   },
   "address-street-2": {
    "type": "string"
   },
   "address-subdivision": {
    "type": "string"
   },
   "birthdate": {
    "description": "YYYY-MM-DD (for profile / watchlist).",
    "type": "string"
   },
   "business-name": {
    "description": "Legal business name (for KYB / report/business).",
    "type": "string"
   },
   "country-code": {
    "description": "ISO-3166 alpha-2 country code.",
    "type": "string"
   },
   "email-address": {
    "type": "string"
   },
   "name-first": {
    "type": "string"
   },
   "name-last": {
    "type": "string"
   },
   "name-middle": {
    "type": "string"
   },
   "phone-number": {
    "type": "string"
   },
   "report-type": {
    "description": "Report type identifier, e.g. 'report/watchlist', 'report/adverse-media', 'report/business', 'report/address', 'report/profile'.",
    "type": "string"
   },
   "tax-identification-number": {
    "description": "SSN / EIN / tax id, depending on jurisdiction.",
    "type": "string"
   }
  },
  "required": [
   "report-type"
  ],
  "type": "object"
 },
 "name": "run_report"
}
