{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Deal Stage"
 },
 "description": "Move a deal to a different pipeline stage.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dealId": {
    "description": "The deal ID",
    "type": "string"
   },
   "lostReason": {
    "description": "Required when moving to lost",
    "type": "string"
   },
   "probability": {
    "description": "Optional win probability (percent string)",
    "type": "string"
   },
   "stage": {
    "description": "New pipeline stage. \"lead\", \"new\" and \"open\" are accepted aliases of \"discovery\".",
    "enum": [
     "discovery",
     "qualified",
     "proposal",
     "negotiation",
     "won",
     "lost",
     "lead",
     "new",
     "open"
    ],
    "type": "string"
   }
  },
  "required": [
   "dealId",
   "stage"
  ],
  "type": "object"
 },
 "name": "update_deal_stage",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
