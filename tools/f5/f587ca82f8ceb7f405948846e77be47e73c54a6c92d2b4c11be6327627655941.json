{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a work order"
 },
 "description": "Create a work order for a vendor. Attach it to an existing task (task_id) or create a new task with it (task: title, priority, status, assigned staff user, optional due date/property/unit). vendor_id and entry_allowed are required. Line items are optional (quantity x unit price, optional GL account). Buildium: POST /v1/workorders.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "chargeable_to": {
    "description": "Who will be charged for the work (max 100).",
    "maxLength": 100,
    "type": "string"
   },
   "entry_allowed": {
    "description": "Whether entry to the unit is allowed.",
    "enum": [
     "Unknown",
     "Yes",
     "No"
    ],
    "type": "string"
   },
   "entry_contact_ids": {
    "description": "Entry contact user ids (RentalTenant, AssociationOwner, Staff or RentalOwner).",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "entry_notes": {
    "description": "Notes on entering the unit.",
    "type": "string"
   },
   "invoice_number": {
    "description": "Vendor invoice/reference number (max 50).",
    "maxLength": 50,
    "type": "string"
   },
   "line_items": {
    "description": "Work order line items.",
    "items": {
     "properties": {
      "gl_account_id": {
       "description": "General ledger account id.",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "memo": {
       "description": "Line item memo.",
       "type": "string"
      },
      "quantity": {
       "description": "Line item quantity.",
       "type": "number"
      },
      "unit_price": {
       "description": "Line item unit price.",
       "type": "number"
      }
     },
     "required": [
      "quantity",
      "unit_price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "task": {
    "description": "A new task to create and link to this work order (instead of task_id).",
    "properties": {
     "assigned_to_user_id": {
      "description": "Staff user id assigned to the task.",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "due_date": {
      "description": "Due date, YYYY-MM-DD.",
      "type": "string"
     },
     "priority": {
      "description": "Task priority.",
      "enum": [
       "Low",
       "Normal",
       "High"
      ],
      "type": "string"
     },
     "property_id": {
      "description": "Active property id.",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "status": {
      "description": "Task status.",
      "enum": [
       "New",
       "InProgress",
       "Completed",
       "Deferred",
       "Closed"
      ],
      "type": "string"
     },
     "title": {
      "description": "Task title (max 127).",
      "maxLength": 127,
      "type": "string"
     },
     "unit_id": {
      "description": "Unit id (must belong to property_id).",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "title",
     "priority",
     "status",
     "assigned_to_user_id"
    ],
    "type": "object"
   },
   "task_id": {
    "description": "Existing task to attach this work order to.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "title": {
    "description": "Work order title (max 127 chars).",
    "maxLength": 127,
    "type": "string"
   },
   "vendor_id": {
    "description": "Vendor id doing the work.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "vendor_notes": {
    "description": "Notes for the vendor.",
    "type": "string"
   },
   "work_details": {
    "description": "Description of the work.",
    "type": "string"
   }
  },
  "required": [
   "vendor_id",
   "entry_allowed"
  ],
  "type": "object"
 },
 "name": "buildium_create_work_order",
 "title": "Create a work order"
}
