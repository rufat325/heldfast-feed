{"description":"Checks an inference receipt the way SessionPay.settle does: the session's locked enclave, active at the anchor block under its operator, locked model, growing cumulative total; and what the settlement would pay.","inputSchema":{"properties":{"receipt":{"description":"the receipt signed by the enclave, as it returns it (fields as decimal and hex strings)","properties":{"anchorBlock":{"description":"decimal integer \u2265 0 (uint256), e.g. \"12\"","type":"string"},"cumulativeUnits":{"description":"decimal integer \u2265 0 (uint256), e.g. \"12\"","type":"string"},"modelHash":{"description":"bytes32: 0x + 64 hex characters","type":"string"},"paramsHash":{"description":"bytes32: 0x + 64 hex characters","type":"string"},"productId":{"description":"decimal integer \u2265 0 (uint256), e.g. \"12\"","type":"string"},"requestHash":{"description":"bytes32: 0x + 64 hex characters","type":"string"},"responseHash":{"description":"bytes32: 0x + 64 hex characters","type":"string"},"seq":{"description":"decimal integer \u2265 0 (uint256), e.g. \"12\"","type":"string"},"sessionId":{"description":"decimal integer \u2265 0 (uint256), e.g. \"12\"","type":"string"},"tokensIn":{"description":"decimal integer \u2265 0 (uint256), e.g. \"12\"","type":"string"},"tokensOut":{"description":"decimal integer \u2265 0 (uint256), e.g. \"12\"","type":"string"}},"required":["productId","sessionId","seq","tokensIn","tokensOut","cumulativeUnits","anchorBlock","modelHash","paramsHash","requestHash","responseHash"],"type":"object"},"signature":{"description":"the enclave's EIP-712 signature: 0x + 130 hex (65 bytes)","type":"string"}},"required":["receipt","signature"],"type":"object"},"name":"arc_verify_receipt"}
