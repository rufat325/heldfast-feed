{
 "description": "Update an existing advertiser",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "can_add_ad_items": {
    "description": "Whether advertiser can submit advertisements for scheduling",
    "type": "boolean"
   },
   "can_change_password": {
    "description": "Whether advertiser can change password",
    "type": "boolean"
   },
   "email": {
    "description": "Contact email",
    "type": "string"
   },
   "id": {
    "description": "Advertiser ID",
    "type": "number"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom metadata key-value pairs",
    "type": "object"
   },
   "name": {
    "description": "Advertiser name",
    "type": "string"
   },
   "password": {
    "description": "Password for advertiser portal (min 8 chars, must include upper, lower, number)",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_advertiser"
}
