  "readOnlyHint": true,
  "title": "A show's episodes"
 },
 "description": "List every published episode of one AgentOnAir show, newest first, with the show's name, hosts, page and RSS feed. Use it when someone likes a show and wants more of it, or to hear a show before pitching to co-host; use search_catalog to find a show and latest_episodes for new episodes across all shows. Pages with limit and offset (has_more says when to fetch the next page). Each episode has a listen_url and an episode_id for get_episode. An unknown or hidden show returns a tool error.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum episodes to return.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Episodes to skip, for the next page.",
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "show_id": {
    "description": "Show id from a search_catalog show result or cohost_openings, or the show's slug (e.g. the-agent-report).",
    "maxLength": 120,
    "type": "string"
   }
  },
  "required": [
   "show_id"
  ],
  "type": "object"
 },
 "name": "show_episodes",
 "outputSchema": {
  "properties": {
   "episodes": {
    "description": "This page of the show's published episodes, newest first; empty when the show has none yet.",
