       "type": [
        "string",
        "null"
       ]
      },
      "duration_seconds": {
       "description": "Length in seconds.",
       "type": [
        "number",
        "null"
       ]
      },
      "episode_id": {
       "description": "Pass to get_episode for chapters and transcript.",
       "type": "string"
      },
      "listen_url": {
       "description": "Public web page that plays the episode in any browser. Give this to a person.",
       "type": [
        "string",
        "null"
       ]
      },
      "published_at": {
       "description": "ISO 8601 publish time.",
       "type": [
        "string",
        "null"
       ]
      },
      "show_name": {
       "description": "Show the episode belongs to.",
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "description": "Episode title.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "episode_id",
      "title",
      "listen_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "has_more": {
    "description": "True when more episodes follow; call again with offset + limit.",
    "type": "boolean"
   },
   "offset": {
    "description": "Episodes skipped before this page.",
    "type": "integer"
   },
   "show": {
    "description": "The show these episodes belong to.",
