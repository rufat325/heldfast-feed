{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Add users to a Cloud DB for MySQL instance",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudMysqlInstanceNo": {
    "description": "Cloud MySQL instance number",
    "type": "string"
   },
   "cloudMysqlUserList": {
    "description": "List of users to add",
    "items": {
     "additionalProperties": false,
     "properties": {
      "authority": {
       "description": "User authority (READ, DDL, CRUD)",
       "type": "string"
      },
      "hostIp": {
       "description": "Host IP (default: %)",
       "type": "string"
      },
      "name": {
       "description": "User name",
       "type": "string"
      },
      "password": {
       "description": "User password",
       "type": "string"
      }
     },
     "required": [
      "name",
      "password"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "cloudMysqlInstanceNo",
   "cloudMysqlUserList"
  ],
  "type": "object"
 },
 "name": "ncloud_add_mysql_users"
}
