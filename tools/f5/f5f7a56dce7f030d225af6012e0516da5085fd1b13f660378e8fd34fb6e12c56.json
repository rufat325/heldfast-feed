{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Reuse the chosen exact request-time quote while valid; after expiry refresh only that candidate at the same amount and never reselect. Example: pass candidate_id and the selection receipt hash. An AssetFare result requires a caller-local proof check and fresh wallet simulation before verified_for_signing; remote verification is not signing authority. An external result is only its provider handoff and has no AssetFare transaction-verification claim. Never prepares, signs, submits, or grants transaction authority.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount_usd": {
    "description": "Requested input value in USD, minimum 1. USD 1 is reachability/schema smoke only. A USD 50 competitive bucket was observed only for dated 2026-09-23 Solana USDC to Base USDC evidence and must not be generalized to another corridor. USD 1,000 is the primary representative amount. SOL input includes a swap. Always quote the actual intended amount.",
    "minimum": 1,
    "type": "number"
   },
   "candidate_id": {
    "description": "Exact candidate_id returned by assetfare_v2_route_selection; it is never chosen automatically.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "from_chain": {
    "description": "Source chain for the v2 route. Polygon, Optimism, Ethereum, HyperEVM, X Layer, Sei, Sonic, Monad, Avalanche, Cronos, Injective, Linea, Aptos, Unichain, and Ink are source-only and cannot be used as to_chain.",
    "enum": [
     "solana",
     "base",
     "arbitrum",
     "robinhood",
     "polygon",
     "optimism",
     "ethereum",
     "hyperevm",
     "xlayer",
     "sei",
     "sonic",
     "monad",
     "avalanche",
     "cronos",
     "injective",
     "linea",
     "aptos",
     "unichain",
     "ink"
    ],
    "type": "string"
   },
   "from_token": {
    "description": "Input token symbol on from_chain. The chain-token pair must appear in current v2 capabilities.",
    "enum": [
     "SOL",
     "ETH",
     "USDC",
     "USDG"
    ],
    "type": "string"
   },
   "max_eta_seconds": {
    "description": "Optional stricter maximum ETA in seconds; it cannot exceed 60 or the selected profile limit.",
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "profile": {
    "description": "Time policy: fast (30s), balanced (60s default), or explicit economy (60s). Every recommendation profile has an absolute 60-second ceiling.",
    "enum": [
     "fast",
     "balanced",
     "economy"
    ],
    "type": "string"
   },
   "selection_receipt_sha256": {
    "description": "Exact selection_receipt.sha256 returned with the fresh shortlist.",
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "to_chain": {
    "description": "Destination chain for the v2 route: Solana, Base, Arbitrum, or Robinhood Chain. Source-only chains are not destinations.",
    "enum": [
     "solana",
     "base",
     "arbitrum",
     "robinhood"
    ],
    "type": "string"
   },
   "to_token": {
    "description": "Output token symbol on to_chain. The chain-token pair must appear in current v2 capabilities.",
    "enum": [
     "SOL",
     "ETH",
     "USDC",
     "USDG"
    ],
    "type": "string"
   }
  },
  "required": [
   "from_chain",
   "from_token",
   "to_chain",
   "to_token",
   "amount_usd",
   "candidate_id",
   "selection_receipt_sha256"
  ],
  "type": "object"
 },
