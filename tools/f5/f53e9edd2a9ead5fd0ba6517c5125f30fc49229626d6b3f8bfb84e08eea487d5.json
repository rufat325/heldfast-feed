{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Remove one alias FQDN from a web hosting site (the main FQDN cannot be removed). Two-phase commit. After this, the site's Apache vhost will no longer respond to the alias. Manager-private.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "alias": {
    "description": "The FQDN to remove (e.g. `*.evo.broz.be` or `client1.example.com`). Cannot remove the main FQDN of the site (that's the `is_main: true` entry in the list).",
    "minLength": 3,
    "type": "string"
   },
   "confirmation_token": {
    "format": "uuid",
    "type": "string"
   },
   "hosting_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "site_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "hosting_id",
   "site_id",
   "alias"
  ],
  "type": "object"
 },
 "name": "infomaniak_delete_site_alias",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "alias": {
        "type": "string"
       },
       "hosting_id": {
        "type": "number"
       },
       "is_main": {
        "type": "boolean"
       },
       "is_protected": {
        "type": "boolean"
       },
       "site_id": {
        "type": "number"
       }
      },
      "required": [
       "hosting_id",
       "site_id",
       "alias",
       "is_main",
       "is_protected"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "message": {
      "type": "string"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
