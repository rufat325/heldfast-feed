{
 "description": "Get taxonomy details (labels, description, hierarchical, post_types, term count)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "taxonomy": {
    "description": "Taxonomy name (e.g. category, post_tag, product_cat)",
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "site",
   "taxonomy"
  ],
  "type": "object"
 },
 "name": "mcp_get_taxonomy"
}
