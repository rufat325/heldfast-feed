{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate an editable form from a JSON object. Returns nested field paths, JSON Schema, HTML, React JSX and config exports. Arrays and nulls use JSON textareas. Values are processed in memory; avoid secrets. To show an interactive preview, call usesignal_open_workbench with this result input.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "json": {
    "maxLength": 50000,
    "type": "string"
   },
   "overrides": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "maxLength": 120,
       "type": "string"
      },
      "path": {
       "items": {
        "type": "string"
       },
       "maxItems": 9,
       "type": "array"
      },
      "required": {
       "type": "boolean"
      },
      "type": {
       "enum": [
        "text",
        "email",
        "number",
        "checkbox",
        "textarea"
       ],
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "title": {
    "default": "Generated form",
    "maxLength": 120,
    "type": "string"
   }
  },
  "required": [
   "json"
  ],
  "type": "object"
 },
 "name": "usesignal_generate_form"
}
