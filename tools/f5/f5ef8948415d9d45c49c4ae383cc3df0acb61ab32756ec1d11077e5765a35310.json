 "description": "Get full details for one manga by mal_id: synopsis, score, genres, authors, serialization, external links (official site, social media), alternate title synonyms, and related entries. Obtain the mal_id from search_manga first. `sfw`/`sfw_strict` don't affect this manga itself (its id was requested explicitly) \u2014 they filter NSFW entries out of its `relations` list. If Tenrai is unavailable and MAL_CLIENT_ID is set, transparently retries via the official API, which omits `themes`/`demographics`/`favorites`/`moreinfo`/`explicit_genres`/`external` (no equivalent fields there) and ignores `sfw`/`sfw_strict` entirely.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "MyAnimeList numeric ID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "sfw": {
    "description": "If true, exclude adult/explicit-rated entries (R+ Mild Nudity and up). Defaults to false (no filtering). Note: this alone still allows mainstream, safely-rated shows tagged with the Ecchi genre (fanservice) through \u2014 use `sfw_strict` to also exclude those.",
    "type": "boolean"
   },
   "sfw_strict": {
    "description": "If true, exclude adult/explicit-rated entries AND anything tagged with the Ecchi genre, even otherwise-mainstream/safely-rated shows. Stricter than `sfw` alone. Defaults to false.",
    "type": "boolean"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_manga",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "authors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "background": {
    "type": "string"
   },
   "chapters": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
