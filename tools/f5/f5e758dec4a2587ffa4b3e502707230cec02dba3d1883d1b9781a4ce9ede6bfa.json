  "title": "Qualify a business lead or counterparty"
 },
 "description": "Qualifies a business that made contact (a form submission, an inquiry, an outreach reply). Input: the sender's e-mail (or the company domain), the company name if given, and the context (form type, message, stated value, stated role). Jid checks the domain (MX, SPF, DMARC, registration date over RDAP, the website), matches it to a Jid business file, reads that file's registrations, licences, filings, capital raises, loans and adverse records, and returns signals (each with source, source_url, verified_at), three scores (legitimacy, capacity, consistency, 0 to 100 with reasons), checks (each pass, fail or unknown with one line of evidence) and a read: a one-line headline (\"Passed all 7 checks Jid could run. Recommendation: engage.\"), the recommendation (engage, verify_first, do_not_engage), the failed checks and up to 4 links to verify by hand, plus a signed receipt reference. detail \"full\" adds each signal's raw value, each check's lookup link and the full signed receipt. Businesses only: personal webmail or no matched business returns individual_or_unverified with no scores. A possible list match is returned as 'review', not as a finding. Counts as 2 checks with a key; free tier without one. Not intended for credit, employment, insurance or housing decisions about any person.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "activity": {
    "description": "Regulated activity whose licences matter, if any",
    "enum": [
     "general_commerce",
     "sell_prescription_drugs",
     "manufacture_drugs",
     "sell_medical_devices",
     "haul_freight",
     "broker_freight",
     "sell_alcohol",
     "produce_spirits",
     "provide_investment_advice",
     "accept_deposits",
     "lend",
     "bill_medicare_medicaid",
     "healthcare_supplier",
     "federal_contracting",
     "charitable_solicitation",
     "construction",
     "operate_psilocybin_healing_center"
    ],
    "type": "string"
   },
   "browser_timezone": {
    "description": "IANA time zone reported by the submitter's browser",
    "maxLength": 60,
    "type": "string"
   },
   "claimed_website": {
    "description": "For vendor_claim / listing_claim: the website of the business or listing being claimed (enables the affiliation check)",
    "maxLength": 300,
    "type": "string"
   },
   "company_name": {
    "description": "Company name as stated by the sender",
    "maxLength": 200,
    "type": "string"
   },
   "country": {
    "description": "Stated country, ISO 3166-1 alpha-2",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "detail": {
    "description": "compact (default): signals without raw values and a receipt reference; full: raw signal values and the full signed receipt",
    "enum": [
     "compact",
     "full"
    ],
    "type": "string"
   },
   "domain": {
    "description": "Company domain, when no e-mail is available",
    "maxLength": 253,
    "type": "string"
   },
   "email": {
    "description": "Sender's e-mail address",
    "maxLength": 254,
    "type": "string"
   },
   "form_type": {
    "description": "What kind of submission this is",
    "enum": [
     "seller_application",
     "acquisition_inquiry",
     "buyer_registration",
     "nda_request",
     "sourcing_request",
     "listing_request",
     "consultation",
     "partnership",
     "contact",
     "other",
     "vendor_claim",
     "listing_claim",
     "sponsor_inquiry",
     "advertiser",
     "broker_request",
     "buyer_inquiry",
     "seller_inquiry",
     "data_purchase"
    ],
    "type": "string"
   },
   "ip_asn": {
    "description": "ASN of the submitting network, to recognise hosting and VPN networks",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "ip_country": {
    "description": "Country the submission came from, ISO alpha-2 (location consistency check)",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "ip_region": {
    "description": "Region the submission came from (ISO 3166-2, e.g. US-CA or CA)",
    "maxLength": 10,
    "type": "string"
   },
   "message": {
    "description": "The submission's free text (hashed, never stored)",
    "maxLength": 5000,
    "type": "string"
   },
   "policy": {
    "description": "How cautious `engage` is (default balanced)",
    "enum": [
     "strict",
     "balanced",
     "permissive"
    ],
    "type": "string"
   },
   "signal": {
    "description": "Jid Signals token (the form's jid_signal field): Jid's own reading of the visitor's location; replaces the ip_* fields when it verifies",
    "maxLength": 800,
    "type": "string"
   },
   "site": {
    "description": "The submitting website's domain (binds the signal token)",
    "maxLength": 253,
    "type": "string"
   },
   "stated_country": {
    "description": "Country the submitter stated (same as country)",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "stated_role": {
    "description": "The sender's stated role",
    "enum": [
     "buyer",
     "seller",
     "supplier",
     "investor",
     "operator"
    ],
    "type": "string"
   },
   "stated_value": {
    "description": "Deal or purchase size the sender states, USD",
    "minimum": 0,
    "type": "number"
   },
   "summary": {
    "description": "Add a short plain-English summary grounded in the signals (with an API key only)",
    "type": "boolean"
   }
  },
  "required": [
   "form_type"
  ],
  "type": "object"
 },
