{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check blog translation coverage"
 },
 "description": "Use this when someone asks how well their blog is translated, or which languages are missing posts. Returns per-language counts of posts, published posts and drafts with a coverage percentage, from the 100 most recently edited posts. Not for one post's translations.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blogId": {
    "description": "Blog id, or the blog's name",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "blogId"
  ],
  "type": "object"
 },
 "name": "get_blog_localization_summary",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blog": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "configuredLocales": {
        "items": {
         "maxLength": 50,
         "type": "string"
        },
        "maxItems": 50,
        "type": "array"
       },
       "configuredLocalesTruncated": {
        "type": "boolean"
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 50,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "required": [
       "name",
       "defaultLocale",
       "configuredLocales",
       "configuredLocalesTruncated"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "locales": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "articles": {
       "minimum": 0,
       "type": "integer"
      },
      "configured": {
       "type": "boolean"
      },
      "coveragePercent": {
       "maximum": 100,
       "minimum": 0,
       "type": "integer"
      },
      "drafts": {
       "minimum": 0,
       "type": "integer"
      },
      "locale": {
       "maxLength": 50,
       "type": "string"
      },
      "missingFromTranslationGroups": {
       "minimum": 0,
       "type": "integer"
      },
      "published": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "locale",
      "configured",
      "articles",
      "published",
      "drafts",
      "missingFromTranslationGroups",
      "coveragePercent"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "sample": {
    "additionalProperties": false,
    "description": "Coverage is computed from the 100 most recently edited posts; truncated means the blog has more",
    "properties": {
     "articles": {
      "minimum": 0,
      "type": "integer"
     },
     "translationGroups": {
      "minimum": 0,
      "type": "integer"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "articles",
     "translationGroups",
     "truncated"
    ],
    "type": "object"
   }
  },
  "required": [
   "blog",
   "sample",
   "locales"
  ],
  "type": "object"
 },
 "title": "Check blog translation coverage"
}
