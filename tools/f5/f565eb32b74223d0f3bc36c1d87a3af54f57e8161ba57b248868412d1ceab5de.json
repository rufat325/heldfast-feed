{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List recent imports"
 },
 "description": "Lists recent imports for a company with status and timestamps. Use to find an importId for status / results / revert / cancel.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "companyId": {
    "description": "Company id from list_companies.",
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "name": "list_imports",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "imports": {
    "description": "Recent imports.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "createdAt": {
       "description": "ISO timestamp.",
       "type": "string"
      },
      "entityName": {
       "description": "Entity type being imported.",
       "type": "string"
      },
      "fileName": {
       "description": "Uploaded file name.",
       "type": "string"
      },
      "finishedAt": {
       "description": "ISO timestamp when reached terminal status, if applicable.",
       "type": "string"
      },
      "id": {
       "description": "Import id.",
       "type": "string"
      },
      "status": {
       "description": "Lifecycle status (SCHEDULED, IN_PROGRESS, FINISHED, FINISHED_WITH_WARNINGS, FAILED, CANCELED, REVERTING, REVERTED).",
       "type": "string"
      },
      "summary": {
       "additionalProperties": true,
       "description": "Counts per result type.",
       "properties": {
        "failed": {
         "type": "integer"
        },
        "succeeded": {
         "type": "integer"
        },
        "total": {
         "type": "integer"
        },
        "warnings": {
         "type": "integer"
        }
       },
       "type": "object"
      }
     },
     "required": [
      "id",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}
