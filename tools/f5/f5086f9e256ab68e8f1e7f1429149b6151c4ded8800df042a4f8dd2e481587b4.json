{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Post Type Field"
 },
 "description": "Update a field on a post type schema. Changing fieldType or flipping required=true is blocked when posts already use the field unless force=true is passed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "fieldId": {
    "description": "Field ID",
    "type": "string"
   },
   "fieldType": {
    "description": "Field type",
    "enum": [
     "text",
     "textarea",
     "richtext",
     "number",
     "boolean",
     "date",
     "datetime",
     "select",
     "multiselect",
     "url",
     "email",
     "image",
     "file",
     "gallery",
     "attachments",
     "repeater"
    ],
    "type": "string"
   },
   "fields": {
    "anyOf": [
     {
      "items": {
       "properties": {
        "fieldType": {
         "description": "Child field type. Repeaters support scalar/select types plus singular upload fields: text, textarea, richtext, number, boolean, date, datetime, select, multiselect, url, email, image, file. Nested repeaters and array upload fields are not supported.",
         "enum": [
          "text",
          "textarea",
          "richtext",
          "number",
          "boolean",
          "date",
          "datetime",
          "select",
          "multiselect",
          "url",
          "email",
          "image",
          "file",
          "gallery",
          "attachments",
          "repeater"
         ],
         "type": "string"
        },
        "helpText": {
         "description": "Optional hint shown in the UI",
         "type": "string"
        },
        "key": {
         "description": "snake_case key for this repeater child field. Auto-derived from label if omitted.",
         "type": "string"
        },
        "label": {
         "description": "Human-readable child field label",
         "type": "string"
        },
        "options": {
         "additionalProperties": {},
         "description": "For select/multiselect child fields: { choices: [\"a\",\"b\"] }.",
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "required": {
         "description": "Whether this child field is required on every repeater row",
         "type": "boolean"
        },
        "sortOrder": {
         "type": "number"
        }
       },
       "required": [
        "label",
        "fieldType"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Child fields for fieldType=\"repeater\"."
   },
   "force": {
    "description": "Override safety guards. Required to change fieldType or flip required=true on a field that already has data in posts.",
    "type": "boolean"
   },
   "helpText": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Help text shown next to the input"
   },
   "label": {
    "description": "Display label",
    "type": "string"
   },
   "options": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "For URL fields, { uploadable: true } enables file upload while preserving a URL string in meta."
   },
   "postTypeId": {
    "description": "Post type ID",
    "type": "string"
   },
   "required": {
    "description": "Whether the field is required",
    "type": "boolean"
   },
   "sortOrder": {
    "description": "Sort order (lower = earlier)",
    "type": "number"
   }
  },
  "required": [
   "postTypeId",
   "fieldId"
  ],
  "type": "object"
 },
 "name": "update_post_type_field",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
