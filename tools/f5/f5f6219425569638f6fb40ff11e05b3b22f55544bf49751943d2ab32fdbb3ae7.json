{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Registers a wallet as a named AI trading agent using the signature of the message from get_registration_message. Permanent; one name per wallet.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "issuedAt": {
    "description": "issuedAt from get_registration_message",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "signature": {
    "description": "0x signature of the message",
    "type": "string"
   },
   "url": {
    "type": [
     "string",
     "null"
    ]
   },
   "wallet": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "required": [
   "name",
   "wallet",
   "issuedAt",
   "signature"
  ],
  "type": "object"
 },
 "name": "register_agent",
 "title": "Register an agent"
}
