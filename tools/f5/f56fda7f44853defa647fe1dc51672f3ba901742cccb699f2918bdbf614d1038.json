 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search NYC owners by name"
 },
 "description": "Free. Finds people who own or control NYC buildings, by name, directly or through companies. Returns each person's key, building count and boroughs. Use get_nyc_owner_portfolio with the key to list their buildings.",
 "inputSchema": {
  "properties": {
   "includeManagers": {
    "default": false,
    "type": "boolean"
   },
   "name": {
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "search_nyc_owners",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "approximate": {
    "type": "boolean"
   },
   "people": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "boroughs": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "buildings": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "displayName": {
       "type": "string"
      },
      "likelyManager": {
       "type": "boolean"
      },
      "linkedThroughCompanies": {
       "type": "boolean"
      },
      "ownsDirectly": {
       "type": "boolean"
      },
      "personKey": {
       "type": "string"
      },
      "zips": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "personKey",
      "zips",
      "displayName",
      "buildings",
      "boroughs",
      "ownsDirectly",
      "linkedThroughCompanies",
      "likelyManager"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "people",
   "approximate"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "properties:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Search NYC owners by name"
}
