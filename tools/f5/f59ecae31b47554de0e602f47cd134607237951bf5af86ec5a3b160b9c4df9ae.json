{
 "description": "Create a Wan task on RunAPI (speech to video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "callback_url": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "enable_safety_checker": {
    "description": "Declared type: boolean.",
    "type": "boolean"
   },
   "frames_per_second": {
    "description": "Declared type: integer.",
    "type": "integer"
   },
   "guidance_scale": {
    "description": "Declared type: number.",
    "type": "number"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "type": "string"
   },
   "negative_prompt": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "num_frames": {
    "description": "Declared type: integer.",
    "type": "integer"
   },
   "num_inference_steps": {
    "description": "Declared type: integer.",
    "type": "integer"
   },
   "output_resolution": {
    "description": "Declared type: string. Known values: \"480p\", \"580p\", \"720p\".",
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "seed": {
    "description": "Declared type: integer.",
    "type": "integer"
   },
   "shift": {
    "description": "Declared type: number.",
    "type": "number"
   },
   "source_audio_url": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "source_image_url": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "source_image_url",
   "source_audio_url",
   "prompt"
  ],
  "type": "object"
 },
 "name": "speech_to_video"
}
