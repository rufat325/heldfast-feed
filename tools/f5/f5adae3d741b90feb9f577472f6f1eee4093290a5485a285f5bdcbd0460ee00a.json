{
 "_meta": {
  "openai/outputTemplate": "ui://haus/widgets/v2",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://haus/widgets/v2",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Update a recipe. Only the fields you send change, except ingredients, which replaces the whole existing list rather than merging.",
 "inputSchema": {
  "examples": [
   {
    "id": "8f14e45f-ceea-467e-8a2f-1a2b3c4d5e6f",
    "servings": 6
   }
  ],
  "properties": {
   "id": {
    "description": "Recipe id from list_recipes.",
    "examples": [
     "8f14e45f-ceea-467e-8a2f-1a2b3c4d5e6f"
    ],
    "type": "string"
   },
   "ingredients": {
    "description": "Ingredients. Replaces the whole existing list rather than merging.",
    "items": {
     "description": "One ingredient and its quantity.",
     "properties": {
      "name": {
       "description": "Ingredient name.",
       "examples": [
        "chicken breast"
       ],
       "type": "string"
      },
      "quantity": {
       "description": "Whole-number quantity, minimum 1. No fractions or units.",
       "examples": [
        2
       ],
       "type": "integer"
      }
     },
     "required": [
      "name",
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "instructions": {
    "description": "Cooking method.",
    "examples": [
     "Marinate the chicken, then simmer in the spiced sauce."
    ],
    "type": "string"
   },
   "name": {
    "description": "Name.",
    "examples": [
     "Chicken Tikka Masala"
    ],
    "type": "string"
   },
   "servings": {
    "description": "Servings the recipe yields, minimum 1.",
    "examples": [
     4
    ],
    "type": "integer"
   },
   "url": {
    "description": "Source URL.",
    "examples": [
     "https://example.com/recipes/chicken-tikka-masala"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_recipe",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "variant": {
    "enum": [
     "list",
     "detail",
     "confirmation"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 }
}
