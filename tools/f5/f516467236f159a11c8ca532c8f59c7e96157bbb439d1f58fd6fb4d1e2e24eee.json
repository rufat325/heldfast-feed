{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "support.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a reply to Vaanzari support staff after signed-in browser approval, reopening a closed ticket if needed. The submitted message cannot be unsent.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "confirmation_id": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "message": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "ticket_id": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
    "type": "string"
   }
  },
  "required": [
   "ticket_id",
   "message"
  ],
  "type": "object"
 },
 "name": "reply_support_ticket",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "propertyNames": {
   "type": "string"
  },
  "type": "object"
 },
 "title": "Reply Support Ticket"
}
