{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Set Cookies"
 },
 "description": "Set one or more cookies in the browser session.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cookies": {
    "description": "Array of cookie objects to set",
    "items": {
     "additionalProperties": false,
     "properties": {
      "domain": {
       "type": [
        "string",
        "null"
       ]
      },
      "expires": {
       "description": "Unix timestamp",
       "type": [
        "number",
        "null"
       ]
      },
      "http_only": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "path": {
       "type": [
        "string",
        "null"
       ]
      },
      "secure": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "session_id": {
    "description": "Session ID returned by browser_navigate",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "cookies"
  ],
  "type": "object"
 },
 "name": "browser_set_cookies"
}
