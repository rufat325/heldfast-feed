{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Validate Expression Tool"
 },
 "description": "Validates Mapbox style expressions for syntax, operators, and argument correctness",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "context": {
    "description": "Context where the expression will be used",
    "enum": [
     "style",
     "filter",
     "layout",
     "paint"
    ],
    "type": "string"
   },
   "expression": {
    "anyOf": [
     {
      "type": "string"
     },
     {}
    ],
    "description": "Mapbox expression to validate (JSON string or expression array)"
   }
  },
  "required": [
   "expression"
  ],
  "type": "object"
 },
 "name": "validate_expression_tool",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "errors": {
    "description": "Critical errors",
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "description": "Description of the issue",
       "type": "string"
      },
      "path": {
       "description": "Path to the problem in the expression",
       "type": "string"
      },
      "severity": {
       "description": "Issue severity",
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      },
      "suggestion": {
       "description": "How to fix the issue",
       "type": "string"
      }
     },
     "required": [
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "info": {
    "description": "Informational messages",
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "description": "Description of the issue",
       "type": "string"
      },
      "path": {
       "description": "Path to the problem in the expression",
       "type": "string"
      },
      "severity": {
       "description": "Issue severity",
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      },
      "suggestion": {
       "description": "How to fix the issue",
       "type": "string"
      }
     },
     "required": [
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "metadata": {
    "additionalProperties": false,
    "description": "Expression metadata",
    "properties": {
     "depth": {
      "description": "Maximum nesting depth",
      "type": "number"
     },
     "expressionType": {
      "description": "Detected expression type (e.g., \"literal\", \"get\", \"match\")",
      "type": "string"
     },
     "returnType": {
      "description": "Expected return type of the expression",
      "type": "string"
     }
    },
    "type": "object"
   },
   "valid": {
    "description": "Whether the expression is valid",
    "type": "boolean"
   },
   "warnings": {
    "description": "Non-critical warnings",
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "description": "Description of the issue",
       "type": "string"
      },
      "path": {
       "description": "Path to the problem in the expression",
       "type": "string"
      },
      "severity": {
       "description": "Issue severity",
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      },
      "suggestion": {
       "description": "How to fix the issue",
       "type": "string"
      }
     },
     "required": [
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "valid",
   "errors",
   "warnings",
   "info",
   "metadata"
  ],
  "type": "object"
 },
 "title": "Validate Expression Tool"
}
