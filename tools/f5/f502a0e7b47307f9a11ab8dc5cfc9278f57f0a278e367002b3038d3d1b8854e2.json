{
 "description": "Create a custom API endpoint for a Frappe app",
 "inputSchema": {
  "properties": {
   "app_name": {
    "description": "Name of the Frappe app",
    "type": "string"
   },
   "code": {
    "description": "Python code for the API endpoint",
    "type": "string"
   },
   "endpoint_name": {
    "description": "Name of the API endpoint",
    "type": "string"
   },
   "method": {
    "default": "get",
    "enum": [
     "get",
     "post",
     "put",
     "delete"
    ],
    "type": "string"
   }
  },
  "required": [
   "app_name",
   "endpoint_name",
   "code"
  ],
  "type": "object"
 },
 "name": "frappe_create_api_endpoint"
}
