{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a cash, card, checking or e-money account. Bank-synced accounts are created by ZenMoney itself.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "balance": {
    "default": 0,
    "description": "Opening balance",
    "type": "number"
   },
   "credit_limit": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "currency": {
    "description": "ISO code; defaults to the main currency",
    "type": "string"
   },
   "in_balance": {
    "default": true,
    "description": "Count in the total balance and reports",
    "type": "boolean"
   },
   "savings": {
    "default": false,
    "type": "boolean"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "default": "cash",
    "description": "cash, ccard (card), checking, emoney",
    "enum": [
     "cash",
     "ccard",
     "checking",
     "emoney"
    ],
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "create_account",
 "title": "Create account"
}
