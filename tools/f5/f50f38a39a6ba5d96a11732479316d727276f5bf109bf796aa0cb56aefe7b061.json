{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List the steps of a test case version. Optional filter narrows by step details / test data / expected result substring.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "fields": {
    "description": "Comma-separated fields to return",
    "type": "string"
   },
   "filter": {
    "properties": {
     "expectedResult": {
      "type": "string"
     },
     "stepDetails": {
      "type": "string"
     },
     "testData": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "id": {
    "description": "Test case ID or key",
    "type": [
     "string",
     "number"
    ]
   },
   "maxResults": {
    "description": "Items per page (max 100, default 50)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "response_format": {
    "default": "json",
    "description": "Output format. 'markdown' is human-readable; 'json' (default) is machine-readable.",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   },
   "sort": {
    "description": "Sort e.g. \"id:asc\" or \"updated:desc\"",
    "type": "string"
   },
   "startAt": {
    "description": "Page offset (default 0)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "versionNo": {
    "description": "Test case version number",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "id",
   "versionNo"
  ],
  "type": "object"
 },
 "name": "qtm4j_get_test_steps",
 "title": "Get Test Steps"
}
