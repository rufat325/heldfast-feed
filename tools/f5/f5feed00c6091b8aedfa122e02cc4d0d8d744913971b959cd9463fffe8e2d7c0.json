{
 "description": "Storybook-MCP-compatible rendering of one or more story ids. Requires live scope.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "storyIds"
    ]
   },
   {
    "required": [
     "storyId"
    ]
   },
   {
    "required": [
     "ids"
    ]
   },
   {
    "required": [
     "id"
    ]
   }
  ],
  "properties": {
   "id": {
    "type": "string"
   },
   "ids": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "observe": {
    "enum": [
     "png",
     "svg",
     "scroll-png",
     "scroll-svg",
     "semantics",
     "hash"
    ],
    "type": "string"
   },
   "overrides": {
    "additionalProperties": {
     "type": [
      "string",
      "number",
      "boolean"
     ]
    },
    "type": "object"
   },
   "storyId": {
    "type": "string"
   },
   "storyIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "token": {
    "description": "A grant token from poll_access, when you cannot set the X-Compose-Preview-Token header yourself \u2014 an MCP client fixes its headers at connect time, so this is how a token approved during this session is used in it. Prefer the header where you control it.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "preview-stories",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "observations": {
    "items": {
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "observations"
  ],
  "type": "object"
 }
}
