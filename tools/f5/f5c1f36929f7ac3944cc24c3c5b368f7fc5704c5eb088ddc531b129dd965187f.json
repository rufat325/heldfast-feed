{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when a user asks for Kubernetes cluster capacity. Uses the same node vCPU, node memory, node count, system reserve, and target utilization model as the browser calculator.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "node_count": {
    "description": "node count used by this deterministic tool.",
    "examples": [
     1
    ],
    "minimum": 1,
    "type": "number"
   },
   "node_mem_gb": {
    "description": "node mem in gigabytes.",
    "examples": [
     0.001
    ],
    "minimum": 0.001,
    "type": "number"
   },
   "node_vcpu": {
    "description": "node vcpu used by this deterministic tool.",
    "examples": [
     0.001
    ],
    "minimum": 0.001,
    "type": "number"
   },
   "system_reserve_pct": {
    "description": "system reserve expressed as a percentage.",
    "examples": [
     1
    ],
    "maximum": 99.999,
    "minimum": 0,
    "type": "number"
   },
   "target_utilization_pct": {
    "description": "target utilization expressed as a percentage.",
    "examples": [
     0.001
    ],
    "maximum": 100,
    "minimum": 0.001,
    "type": "number"
   }
  },
  "required": [
   "node_vcpu",
   "node_mem_gb",
   "node_count"
  ],
  "type": "object"
 },
 "name": "cluster-capacity-calculator",
