{
 "description": "Mint an audited short-lived MP4-rendition grant. Optional outputPath makes the stdio server save it inside OPENTRAIN_MCP_VIDEO_DOWNLOAD_DIR; hosted MCP returns grants only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "outputPath": {
    "minLength": 1,
    "type": "string"
   },
   "overwrite": {
    "type": "boolean"
   },
   "reason": {
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "assetId",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_video_library_grant_download",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
