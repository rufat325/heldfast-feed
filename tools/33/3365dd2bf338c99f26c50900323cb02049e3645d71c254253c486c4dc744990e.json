{
 "description": "List durable work items available to agents. Filter by state, capability or current assignee.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "capability": {
    "maxLength": 300,
    "type": "string"
   },
   "claimedBy": {
    "maxLength": 200,
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "states": {
    "items": {
     "enum": [
      "open",
      "claimed",
      "blocked",
      "review",
      "done",
      "cancelled"
     ],
     "type": "string"
    },
    "maxItems": 6,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "work_list"
}
