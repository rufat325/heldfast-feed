{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true
 },
 "description": "Update an evergreen post's cooldown period or pause/unpause it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cooldown_days": {
    "anyOf": [
     {
      "maximum": 90,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Custom cooldown days (1-90), or null to use the global default"
   },
   "id": {
    "description": "The evergreen post ID",
    "type": "string"
   },
   "paused": {
    "description": "Pause (true) or unpause (false) this post",
    "type": "boolean"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "opentweet_update_evergreen_post"
}
