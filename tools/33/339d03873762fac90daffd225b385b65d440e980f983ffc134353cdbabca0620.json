{
 "description": "Queues an outbound email for a mailbox.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "format": "starts_with",
    "pattern": "^amk_.*",
    "type": "string"
   },
   "html": {
    "type": "string"
   },
   "mailboxId": {
    "minLength": 1,
    "type": "string"
   },
   "subject": {
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "to": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   }
  },
  "required": [
   "mailboxId",
   "to",
   "subject"
  ],
  "type": "object"
 },
 "name": "assistantmail_send_email"
}
