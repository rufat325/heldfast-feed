{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new Datadog dashboard with widgets",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "Dashboard description",
    "type": "string"
   },
   "layoutType": {
    "description": "Layout type: ordered (auto-arranged) or free (manual placement)",
    "enum": [
     "ordered",
     "free"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tags for the dashboard. Example: [\"env:prod\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "templateVariables": {
    "description": "Template variables for dynamic filtering",
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "Dashboard title. Example: Production Overview",
    "type": "string"
   },
   "widgets": {
    "description": "Array of widget definitions (each with a 'definition' key)",
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "title",
   "layoutType",
   "widgets"
  ],
  "type": "object"
 },
 "name": "create-dashboard"
}
