  "readOnlyHint": true,
  "title": "Check a stay's government registration (South Korea)"
 },
 "description": "Check whether a short-term rental listing (Airbnb, guesthouse, hanok stay, homestay, pension) is licensed and registered with the government, using official government registry records that are hard to access directly. SelectBNBs Verify covers South Korea today; more countries are coming. Use it when someone asks whether a Korean Airbnb or guesthouse is legal, licensed, registered or real. Pass the listing's 'Registration details' box exactly as shown (Region of issuance, Licence type, Licence number). If the traveler has not copied it yet, ask them to; a registered name or Korean road address is a weaker fallback. Returns the official permit status and its as-of date, the registered business name, permit category and address, a link to the public record page, and what the traveler should compare with their listing. One listing per call; no bulk search.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "ISO 3166-1 alpha-2 code of the country where the stay is, e.g. KR. Only KR (South Korea) is covered today; other countries return 'not covered yet'.",
    "maxLength": 40,
    "minLength": 1,
    "title": "Country",
    "type": "string"
   },
   "language": {
    "default": "en",
    "description": "Language for explanations and next steps: en (default), ja or zh-Hant.",
    "enum": [
     "en",
     "ja",
     "zh-Hant"
    ],
    "title": "Language",
    "type": "string"
   },
   "listing_details": {
    "description": "Text copied from ONE listing, as shown: ideally the whole Registration details box (e.g. 'Region of issuance: \uc11c\uc6b8\ud2b9\ubcc4\uc2dc \uc885\ub85c\uad6c / Licence type: \uc678\uad6d\uc778\uad00\uad11\ub3c4\uc2dc\ubbfc\ubc15\uc5c5 / Licence number: 2025-000006'). A registered name, Korean road address or government management number also works, less reliably.",
    "maxLength": 4000,
    "minLength": 1,
    "title": "Listing Details",
    "type": "string"
   }
  },
  "required": [
   "listing_details",
   "country"
  ],
  "title": "verify_listing_registrationArguments",
  "type": "object"
 },
