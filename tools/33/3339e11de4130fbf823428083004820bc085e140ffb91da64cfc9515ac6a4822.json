{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "classroom:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add students"
 },
 "description": "Adds students to a class roster from individual entries with names in First Last order and optional emails. Existing roster students are matched rather than duplicated. Emails support assignment notifications and are never returned. Roster additions can be removed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "classId": {
    "description": "Class id from list_classes.",
    "pattern": "^[a-f\\d]{24}$",
    "type": "string"
   },
   "students": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "email": {
       "format": "email",
       "maxLength": 254,
       "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
       "type": "string"
      },
      "name": {
       "description": "First Last.",
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "classId",
   "students"
  ],
  "type": "object"
 },
 "name": "add_students",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "classroom:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Add students"
}
