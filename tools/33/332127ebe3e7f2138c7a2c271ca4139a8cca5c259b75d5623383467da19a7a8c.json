{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Latest tick-level trades on a Hyperliquid market from our own nodes: price, size, side and block time. Covers native perps, HIP-3 builder markets, HIP-4 outcomes and spot.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Number of trades to return (1-100, default 20)",
    "type": "number"
   },
   "market": {
    "description": "Market symbol \u2014 native HL perp (e.g. \"BTC-PERP\", \"ETH-PERP\") or HIP-3 builder market namespaced as \"<issuer>:<base>-PERP\" (e.g. \"flx:GAS-PERP\", \"xyz:NVDA-PERP\")",
    "type": "string"
   }
  },
  "required": [
   "market"
  ],
  "type": "object"
 },
 "name": "get_recent_trades",
 "outputSchema": {
  "description": "Trades, newest first",
  "properties": {
   "data": {
    "description": "Trades, newest first",
    "items": {
     "description": "One row",
     "properties": {
      "address": {
       "description": "Wallet address (0x\u2026)"
      },
      "base_market": {
       "description": "Display symbol without the HIP-3 issuer prefix"
      },
      "block_number": {
       "description": "Hyperliquid block height"
      },
      "display_symbol": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "fee": {
       "description": "Fee paid in USD"
      },
      "issuer": {
       "description": "HIP-3 builder code (\"\" for native markets)"
      },
      "market": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "market_type": {
       "description": "perp, spot or prediction"
      },
      "price": {
       "description": "Price in USD"
      },
      "quote_asset": {
       "description": "Quote asset, e.g. USDC"
      },
      "realized_pnl": {
       "description": "Realized PnL in USD"
      },
      "sequence": {
       "description": "Order of the event within its block"
      },
      "side": {
       "description": "Fill side, \"buy\" or \"sell\""
      },
      "size": {
       "description": "Size in base units"
      },
      "source": {
       "description": "Venue, always hyperliquid"
      },
      "timestamp": {
       "description": "Unix milliseconds"
      },
      "venue": {
       "description": "Venue, always hyperliquid"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "pagination": {
    "description": "Cursor pagination",
    "properties": {
     "has_more": {
      "description": "Whether more rows exist"
     },
     "next_cursor": {
      "description": "Pass as cursor to fetch the next page; null on the last page"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 }
}
