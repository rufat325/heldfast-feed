     "counterparty",
     "transfer_count",
     "transfers_scanned",
     "scan_capped",
     "total_sent_tao",
     "total_received_tao",
     "net_tao",
     "first_block",
     "last_block",
     "first_seen_at",
     "last_seen_at",
