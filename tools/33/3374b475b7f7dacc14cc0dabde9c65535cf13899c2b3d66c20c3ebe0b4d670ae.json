{
 "description": "Ripristina un documento dal cestino.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "company_id": {
    "description": "Azienda su cui operare. Default: FIC_COMPANY_ID o l'unica azienda del token",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "id": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "kind": {
    "default": "issued",
    "enum": [
     "issued",
     "received"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "recover_document"
}
