{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Changes only the fields supplied: colours, bar, controls, sound, reading, logo, title, language, PDF.\n\n        It never touches the table of contents, which belongs to foliade_set_chapters.\n\n        dry_run returns a preview without writing. No change to the publication state.\n        ",
 "inputSchema": {
  "$defs": {
   "CataloguePatch": {
    "additionalProperties": false,
    "properties": {
     "barre_auto": {
      "default": null,
      "title": "Barre Auto",
      "type": "boolean"
     },
     "barre_fond": {
      "default": null,
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "title": "Barre Fond",
      "type": "string"
     },
     "barre_icones": {
      "default": null,
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "title": "Barre Icones",
      "type": "string"
     },
     "barre_position": {
      "default": null,
      "enum": [
       "bas",
       "haut"
      ],
      "title": "Barre Position",
      "type": "string"
     },
     "barre_ton": {
      "default": null,
      "enum": [
       "sombre",
       "clair"
      ],
      "title": "Barre Ton",
      "type": "string"
     },
     "controles_masques": {
      "default": null,
      "items": {
       "enum": [
        "premiere",
        "zoom",
        "sommaire",
        "recherche",
        "partager",
        "imprimer",
        "pleinecran",
        "telecharger"
       ],
       "type": "string"
      },
      "maxItems": 8,
      "title": "Controles Masques",
      "type": "array"
     },
     "description": {
      "default": null,
      "maxLength": 2000,
      "minLength": 0,
      "title": "Description",
      "type": "string"
     },
     "disposition": {
      "default": null,
      "enum": [
       "auto",
       "simple",
       "double"
      ],
      "title": "Disposition",
      "type": "string"
     },
     "droite_vers_gauche": {
      "default": null,
      "title": "Droite Vers Gauche",
      "type": "boolean"
     },
     "effet": {
      "default": null,
      "enum": [
       "magazine",
       "book",
       "slide",
       "cards",
       "coverflow",
       "single"
      ],
      "title": "Effet",
      "type": "string"
     },
     "fond": {
      "default": null,
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "title": "Fond",
      "type": "string"
     },
     "fond_couleur2": {
      "default": null,
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "title": "Fond Couleur2",
      "type": "string"
     },
     "fond_direction": {
      "default": null,
      "enum": [
       "vertical",
       "diagonal",
       "horizontal"
      ],
      "title": "Fond Direction",
      "type": "string"
     },
     "fond_flou": {
      "default": null,
      "maximum": 40,
      "minimum": 0,
      "title": "Fond Flou",
      "type": "integer"
     },
     "fond_opacite": {
      "default": null,
      "maximum": 100,
      "minimum": 0,
      "title": "Fond Opacite",
      "type": "integer"
     },
     "fond_position": {
      "default": null,
      "enum": [
       "haut",
       "centre",
       "bas"
      ],
      "title": "Fond Position",
      "type": "string"
     },
     "fond_type": {
      "default": null,
      "enum": [
       "couleur",
       "degrade",
       "image"
      ],
      "title": "Fond Type",
      "type": "string"
     },
     "invite": {
      "default": null,
      "enum": [
       "coin",
       "fleches",
       "survol",
       "aucune"
      ],
      "title": "Invite",
      "type": "string"
     },
     "langue": {
      "default": null,
      "enum": [
       "fr",
       "en",
       "es",
       "de",
       "it",
       "pt",
       "pl",
       "nl"
      ],
      "title": "Langue",
      "type": "string"
     },
     "logo_coin": {
      "default": null,
      "enum": [
       "haut-gauche",
       "haut-droite",
       "bas-gauche",
       "bas-droite"
      ],
      "title": "Logo Coin",
      "type": "string"
     },
     "logo_lien": {
      "default": null,
      "maxLength": 300,
      "minLength": 0,
      "title": "Logo Lien",
      "type": "string"
     },
     "logo_taille": {
      "default": null,
      "enum": [
       "petit",
       "moyen",
       "grand"
      ],
      "title": "Logo Taille",
      "type": "string"
     },
     "page_depart": {
      "default": null,
      "maximum": 100000,
      "minimum": 1,
      "title": "Page Depart",
      "type": "integer"
     },
     "progression": {
      "default": null,
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "title": "Progression",
      "type": "string"
     },
     "son_actif": {
      "default": null,
      "title": "Son Actif",
      "type": "boolean"
     },
     "son_volume": {
      "default": null,
      "maximum": 100,
      "minimum": 0,
      "title": "Son Volume",
      "type": "integer"
     },
     "surligner_liens": {
      "default": null,
      "title": "Surligner Liens",
      "type": "boolean"
     },
     "telechargement_pdf": {
      "default": null,
      "enum": [
       "heriter",
       "autoriser",
       "interdire"
      ],
      "title": "Telechargement Pdf",
      "type": "string"
     },
     "titre": {
      "default": null,
      "maxLength": 240,
      "minLength": 1,
      "title": "Titre",
      "type": "string"
     },
     "titre_sur_fond": {
      "default": null,
      "title": "Titre Sur Fond",
      "type": "boolean"
     }
    },
    "title": "CataloguePatch",
    "type": "object"
   }
  },
  "properties": {
   "catalogue_id": {
    "pattern": "^[A-Za-z0-9_-]{1,64}$",
    "title": "Catalogue Id",
    "type": "string"
   },
   "dry_run": {
    "default": false,
    "title": "Dry Run",
    "type": "boolean"
   },
   "expected_revision": {
    "pattern": "^[a-f0-9]{64}$",
    "title": "Expected Revision",
    "type": "string"
   },
   "patch": {
    "$ref": "#/$defs/CataloguePatch"
   }
  },
  "required": [
   "catalogue_id",
   "patch",
   "expected_revision"
  ],
  "title": "update_catalogueArguments",
  "type": "object"
 },
 "name": "foliade_update_catalogue",
 "title": "Change the reader and the metadata"
}
