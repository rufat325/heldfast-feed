       "type": "string"
      },
      "json": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "equals": {
          "type": [
           "string",
           "number",
           "boolean",
           "null"
          ]
         },
         "path": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "path",
         "equals"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "status": {
       "type": "integer"
      },
      "text": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
