{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Produce a markdown brief for a human (or downstream LLM) editor: verdict + reasons + raw numbers + top queries + suggested actions.\n\nUse this as the hand-off artefact when verdict is refresh / expand / merge / double_down.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "Canonical URL of the post.",
    "format": "uri",
    "type": "string"
   },
   "window": {
    "default": 30,
    "enum": [
     30,
     60,
     90
    ],
    "type": "number"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "posts_refresh_brief",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "markdown": {
    "type": "string"
   }
  },
  "required": [
   "markdown"
  ],
  "type": "object"
 },
 "title": "Refresh brief (markdown) per post"
}
