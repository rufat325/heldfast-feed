{
 "description": "Resume a previously created session. Agent must support session loading.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentId": {
    "description": "ID of the initialized agent",
    "type": "string"
   },
   "cwd": {
    "description": "Working directory",
    "type": "string"
   },
   "mcpServers": {
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "args": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "command": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "command"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "type": {
         "const": "http",
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "type",
        "name",
        "url"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "sessionId": {
    "description": "Session ID to resume",
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "sessionId",
   "cwd"
  ],
  "type": "object"
 },
 "name": "load_session"
}
