{
 "description": "Queue a signed synthetic webhook test for any supported lifecycle event. Requires endpoint creator or owner/admin authority; does not create a real incident or bundle. The legacy test_webhook verification contract is retained.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "eventType": {
    "enum": [
     "bundle.created",
     "bundle.updated",
     "bundle.reopened",
     "bundle.resolved",
     "verification.passed",
     "verification.failed",
     "improvement_bundle.created",
     "incident.spike_detected"
    ],
    "type": "string"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   },
   "webhookId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "webhookId",
   "eventType"
  ],
  "type": "object"
 },
 "name": "test_webhook_event"
}
