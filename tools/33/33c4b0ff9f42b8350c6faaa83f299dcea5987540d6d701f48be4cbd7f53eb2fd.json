  "title": "List interview results"
 },
 "description": "[Results] List the merchant's interview results. Rows carry the candidate's scores and recruiter risk flags, so this returns 20 at a time; page with `offset` while `pagination.has_more` is true, or narrow with `tab`/`interview_id`/`filter_text`.\n\nPaginated list of a merchant's interview results (the admin-portal results list), scoped to your token's merchant (or a merchant_id override). Capped at 1000 records per page.",
 "inputSchema": {
  "properties": {
   "conversation_id": {
    "description": "Pass the exact conversation_id from the server's previous response, unchanged. The server provides it on the first call \u2014 never invent one, and do not issue parallel tool calls until you have it. Keep passing the same conversation_id for the rest of the conversation, including after later user messages or on a different task; do not reset it when the user starts a new request.",
    "type": "string"
   },
   "filter_emoji": {
    "description": "Filter by the candidate emoji marker.",
    "type": "string"
   },
   "filter_text": {
    "description": "Case-insensitive search on candidate name or email.",
    "type": "string"
   },
   "interview_id": {
    "description": "Filter to a single interview definition id.",
    "format": "uuid",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of records to return (1\u20131000).",
    "example": 50,
    "maximum": 1000.0,
    "minimum": 1.0,
    "type": "integer"
   },
   "merchant_id": {
    "description": "Optional merchant to scope to. Admins and sub-merchant operators only; other callers always use their token's merchant.",
    "example": "28106cba-1c27-4e53-b149-32113e5e8e31",
    "format": "uuid",
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "Number of records to skip from the start of the result set.",
    "example": 0,
    "minimum": 0.0,
    "type": "integer"
   },
   "order_by": {
    "default": "created_at_newest",
    "description": "Sort order of the result set.",
    "enum": [
     "score",
     "created_at_newest",
     "created_at_oldest",
     "updated_at_newest"
    ],
    "example": "created_at_newest",
    "type": "string"
   },
   "profile_interview_id": {
    "description": "Filter to a single candidate (profile_interview) id.",
    "format": "uuid",
    "type": "string"
   },
   "risks": {
    "description": "Comma-separated list of recruiter-risk keys to filter by (matches any).",
    "type": "string"
   },
   "step": {
    "description": "Filter by pipeline step type (pre-screening, interview or meeting). Omit for all.",
    "enum": [
     "pre-screening",
     "interview",
     "meeting"
    ],
    "example": "interview",
    "type": "string"
   },
   "tab": {
    "description": "Filter by decision/completion state. Omit (or empty) to include all.",
    "enum": [
     "decided-rejected",
     "undecided",
     "shortlist",
     "decided-selected",
     "completed",
     "incomplete",
     "archived-interview",
     "public_avatar",
     "archived-public_avatar",
     ""
    ],
    "example": "undecided",
    "type": "string"
   },
   "type": {
    "default": "interview",
    "description": "Product type of results to list.",
    "enum": [
     "interview",
     "coaching",
     "assessment",
     "public_avatar",
     "persona",
     "persona_interview"
    ],
    "example": "interview",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
