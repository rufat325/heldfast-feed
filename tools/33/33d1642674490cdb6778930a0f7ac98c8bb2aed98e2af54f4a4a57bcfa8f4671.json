{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Register a seller endpoint"
 },
 "description": "Register a proxy endpoint (Mode B). Aether stores your auth secret encrypted at rest (AES-256-GCM) and routes agent queries server-to-server \u2014 agents never see your URL or token. Charge per call via the `price_per_call_usd_cents` field. Account must be status='active' for traffic to be routed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "auth_header_name": {
    "description": "Required when auth_method='header'.",
    "type": "string"
   },
   "auth_method": {
    "enum": [
     "bearer",
     "header",
     "basic",
     "none"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "display_name": {
    "type": "string"
   },
   "http_method": {
    "enum": [
     "POST",
     "GET"
    ],
    "type": "string"
   },
   "monthly_request_cap": {
    "minimum": 1,
    "type": "integer"
   },
   "price_per_call_usd_cents": {
    "minimum": 0,
    "type": "integer"
   },
   "pricing_model": {
    "enum": [
     "free",
     "per_call",
     "subscription"
    ],
    "type": "string"
   },
   "request_template": {
    "additionalProperties": true,
    "type": "object"
   },
   "response_jsonpath": {
    "description": "e.g. $.results",
    "type": "string"
   },
   "secret": {
    "description": "Encrypted at rest; never returned.",
    "type": "string"
   },
   "seller_api_key": {
    "type": "string"
   },
   "slug": {
    "description": "lowercase kebab-case; unique per seller",
    "type": "string"
   },
   "taxonomy_tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ticker_coverage": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "seller_api_key",
   "slug",
   "display_name",
   "url"
  ],
  "type": "object"
 },
 "name": "seller_register_endpoint",
 "outputSchema": {
  "properties": {
   "created_at": {
    "type": "string"
   },
   "endpoint_id": {
    "type": "integer"
   },
   "slug": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "endpoint_id",
   "slug",
   "status"
  ],
  "type": "object"
 },
 "x_aether_auth": {
  "kind": "seller_bearer_required",
  "reason": "post-signup seller management; requires seller_api_key bearer forwarded to /v1/seller/endpoints"
 }
}
