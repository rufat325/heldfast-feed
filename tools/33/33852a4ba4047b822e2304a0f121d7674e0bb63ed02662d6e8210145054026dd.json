{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return up to twelve latest published product and market insight cards with their full public content. Drafts and review previews are excluded.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "risetive_published_insights",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "cards": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "card": {
           "additionalProperties": false,
           "properties": {
            "comparison": {
             "additionalProperties": false,
             "properties": {
              "currentMonth": {
               "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
               "type": "string"
              },
              "observedAt": {
               "anyOf": [
                {
                 "format": "date-time",
                 "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                 "type": "string"
                },
                {
                 "type": "null"
                }
               ]
              },
              "previousMonth": {
               "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
               "type": "string"
              }
             },
             "required": [
              "currentMonth",
              "previousMonth",
              "observedAt"
             ],
             "type": "object"
            },
            "examples": {
             "items": {
              "additionalProperties": false,
              "properties": {
               "domain": {
                "minLength": 1,
                "type": "string"
               },
               "name": {
                "minLength": 1,
                "type": "string"
               },
               "productId": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
               },
               "purpose": {
                "minLength": 1,
                "type": "string"
               }
              },
              "required": [
               "productId",
               "domain",
               "name",
               "purpose"
              ],
              "type": "object"
             },
             "maxItems": 3,
             "minItems": 1,
             "type": "array"
            },
            "href": {
             "pattern": "^\\/.*",
             "type": "string"
            },
            "kind": {
             "enum": [
              "market",
              "product"
             ],
             "type": "string"
            },
            "metric": {
             "additionalProperties": false,
             "properties": {
              "label": {
               "minLength": 1,
               "type": "string"
              },
              "value": {
               "minLength": 1,
               "type": "string"
              }
             },
             "required": [
              "value",
              "label"
             ],
             "type": "object"
            },
            "researchFinding": {
             "maxLength": 360,
             "minLength": 1,
             "type": "string"
            },
            "schemaVersion": {
             "const": 1,
             "type": "number"
            },
            "signalType": {
             "enum": [
              "market_movement",
              "market_concentration",
              "product_breakout"
             ],
             "type": "string"
            },
            "sourceNote": {
             "minLength": 1,
             "type": "string"
            },
            "sources": {
             "items": {
              "additionalProperties": false,
              "properties": {
               "label": {
                "maxLength": 100,
                "minLength": 1,
                "type": "string"
               },
               "url": {
                "format": "uri",
                "type": "string"
               }
              },
              "required": [
               "label",
               "url"
              ],
              "type": "object"
             },
             "maxItems": 3,
             "type": "array"
            },
            "summary": {
             "minLength": 1,
             "type": "string"
            },
            "takeaway": {
             "anyOf": [
              {
               "minLength": 1,
               "type": "string"
              },
              {
               "additionalProperties": false,
               "properties": {
                "competitionAssessment": {
                 "maxLength": 520,
                 "minLength": 80,
                 "type": "string"
                },
                "growthLesson": {
                 "maxLength": 520,
                 "minLength": 80,
                 "type": "string"
                },
                "productLesson": {
                 "maxLength": 520,
                 "minLength": 80,
                 "type": "string"
                }
               },
               "required": [
                "productLesson",
                "growthLesson",
                "competitionAssessment"
               ],
               "type": "object"
              }
             ]
            },
            "title": {
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "schemaVersion",
            "kind",
            "signalType",
            "title",
            "summary",
            "metric",
            "takeaway",
            "examples",
            "href",
            "comparison",
            "sourceNote"
           ],
           "type": "object"
          },
          "id": {
           "exclusiveMinimum": 0,
           "maximum": 9007199254740991,
           "type": "integer"
          },
          "insightDate": {
           "type": "string"
          },
          "publishedAt": {
           "type": "string"
          },
          "sourceUrl": {
           "format": "uri",
           "type": "string"
          }
         },
         "required": [
          "id",
          "insightDate",
          "publishedAt",
          "sourceUrl",
          "card"
         ],
         "type": "object"
        },
        "maxItems": 12,
        "type": "array"
       },
       "source": {
        "additionalProperties": false,
        "properties": {
         "dataAsOf": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "period": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "readAt": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "url": {
          "format": "uri",
          "type": "string"
         }
        },
        "required": [
         "url",
         "dataAsOf",
         "readAt",
         "period"
        ],
        "type": "object"
       }
      },
      "required": [
       "cards",
       "source"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "message": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "retryAfterSeconds": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "ok",
     "not-found",
     "confirmed-empty",
     "rate-limited",
     "timeout",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "message",
   "retryAfterSeconds",
   "data"
  ],
  "type": "object"
 },
 "title": "Read published Risetive insights"
}
