{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a sharing link for a file or folder in a SharePoint document library. Returns a URL that can be shared with others.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "driveId": {
    "description": "Document library (drive) ID",
    "type": "string"
   },
   "itemId": {
    "description": "File or folder item ID",
    "type": "string"
   },
   "scope": {
    "description": "Who can use the link (default: \"organization\")",
    "enum": [
     "anonymous",
     "organization"
    ],
    "type": "string"
   },
   "type": {
    "description": "Link type: \"view\" for read-only, \"edit\" for read-write",
    "enum": [
     "view",
     "edit"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_sharing_link"
}
