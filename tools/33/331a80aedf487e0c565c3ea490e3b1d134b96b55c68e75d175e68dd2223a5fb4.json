{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Offer Rule"
 },
 "description": "Create an upsell/cross-sell offer rule as draft. Specify trigger type, conditions, and suggested products with optional discounts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "Rule description",
    "type": "string"
   },
   "name": {
    "description": "Rule name",
    "type": "string"
   },
   "products": {
    "description": "Products to suggest with optional discounts",
    "items": {
     "properties": {
      "discountType": {
       "description": "Discount type",
       "enum": [
        "percentage",
        "fixed_amount"
       ],
       "type": "string"
      },
      "discountValue": {
       "description": "Discount value",
       "type": "string"
      },
      "productId": {
       "description": "Product ID to suggest",
       "type": "number"
      }
     },
     "required": [
      "productId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "triggerConfig": {
    "additionalProperties": {},
    "description": "Trigger-specific configuration",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "triggerType": {
    "description": "When the offer triggers",
    "enum": [
     "product_view",
     "cart_contains",
     "cart_threshold",
     "post_order",
     "category_view"
    ],
    "type": "string"
   },
   "type": {
    "description": "Rule type: upsell, cross_sell, bundle, or post_purchase",
    "enum": [
     "upsell",
     "cross_sell",
     "bundle",
     "post_purchase"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "type",
   "triggerType"
  ],
  "type": "object"
 },
 "name": "create_offer_rule",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
