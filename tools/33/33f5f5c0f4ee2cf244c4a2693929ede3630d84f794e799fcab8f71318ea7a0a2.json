{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Scaffold Electron project"
 },
 "description": "Generate a complete, secure, modern Electron project scaffold. Includes proper process separation, TypeScript configuration, framework integration, build tooling, security defaults, and an example IPC channel. Produces a full project structure ready to develop.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "buildTool": {
    "description": "Build tool. Defaults to 'electron-vite'.",
    "enum": [
     "electron-forge",
     "electron-vite",
     "electron-builder"
    ],
    "type": "string"
   },
   "features": {
    "description": "Optional features to include",
    "items": {
     "enum": [
      "auto-update",
      "tray",
      "deep-linking",
      "multi-window"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "framework": {
    "description": "Frontend framework. Defaults to 'react'.",
    "enum": [
     "react",
     "vue",
     "svelte",
     "vanilla"
    ],
    "type": "string"
   },
   "name": {
    "description": "Project name (lowercase, hyphens ok), e.g. 'my-electron-app'",
    "pattern": "^[a-z0-9][a-z0-9._-]*$",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "electron_scaffold_project"
}
