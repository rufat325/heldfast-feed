{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a line. Note: Illustrator will be activated (brought to foreground) during execution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "coordinate_system": {
    "description": "Coordinate system. Auto-detected from document by default (CMYK/print \u2192 document, RGB/web \u2192 artboard-web). artboard-web: origin at active artboard top-left, Y-down. document: Illustrator native coords, origin at bottom-left, Y-up. Call get_document_info to check which system is active.",
    "enum": [
     "artboard-web",
     "document"
    ],
    "type": "string"
   },
   "layer_name": {
    "description": "Target layer name",
    "type": "string"
   },
   "name": {
    "description": "Object name",
    "type": "string"
   },
   "stroke": {
    "description": "Stroke settings",
    "properties": {
     "cap": {
      "description": "Line cap style",
      "enum": [
       "butt",
       "round",
       "projecting"
      ],
      "type": "string"
     },
     "color": {
      "description": "Stroke color",
      "oneOf": [
       {
        "properties": {
         "c": {
          "description": "Cyan (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "k": {
          "description": "Black (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "m": {
          "description": "Magenta (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "type": {
          "const": "cmyk",
          "description": "Color type",
          "type": "string"
         },
         "y": {
          "description": "Yellow (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         }
        },
        "required": [
         "type",
         "c",
         "m",
         "y",
         "k"
        ],
        "type": "object"
       },
       {
        "properties": {
         "b": {
          "description": "Blue (0-255)",
          "maximum": 255,
          "minimum": 0,
          "type": "number"
         },
         "g": {
          "description": "Green (0-255)",
          "maximum": 255,
          "minimum": 0,
          "type": "number"
         },
         "r": {
          "description": "Red (0-255)",
          "maximum": 255,
          "minimum": 0,
          "type": "number"
         },
         "type": {
          "const": "rgb",
          "description": "Color type",
          "type": "string"
         }
        },
        "required": [
         "type",
         "r",
         "g",
         "b"
        ],
        "type": "object"
       },
       {
        "properties": {
         "type": {
          "const": "gray",
          "description": "Color type",
          "type": "string"
         },
         "value": {
          "description": "Gray value (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         }
        },
        "required": [
         "type",
         "value"
        ],
        "type": "object"
       },
       {
        "properties": {
         "type": {
          "const": "none",
          "description": "Color type",
          "type": "string"
         }
        },
        "required": [
         "type"
        ],
        "type": "object"
       }
      ]
     },
     "width": {
      "description": "Stroke width",
      "type": "number"
     }
    },
    "type": "object"
   },
   "x1": {
    "description": "Start point X coordinate",
    "type": "number"
   },
   "x2": {
    "description": "End point X coordinate",
    "type": "number"
   },
   "y1": {
    "description": "Start point Y coordinate",
    "type": "number"
   },
   "y2": {
    "description": "End point Y coordinate",
    "type": "number"
   }
  },
  "required": [
   "x1",
   "y1",
   "x2",
   "y2"
  ],
  "type": "object"
 },
 "name": "create_line",
 "title": "Create Line"
}
