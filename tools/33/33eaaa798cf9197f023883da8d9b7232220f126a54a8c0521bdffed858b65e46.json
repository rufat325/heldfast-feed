{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Bike Products"
 },
 "description": "Search for bicycle parts, components, accessories, and cycling clothing by name, brand, or model number. Returns matching products sorted cheapest-first, each with its price, stock status, EAN barcode, and a direct purchase link. Supports DE and AT pricing. If you already have a product's EAN, use get_best_price instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Filter by merchant category (partial match, e.g. 'Fahrr\u00e4der' or 'Bremsen')",
    "type": "string"
   },
   "country": {
    "default": "DE",
    "description": "Country for pricing (DE or AT, default DE)",
    "enum": [
     "DE",
     "AT"
    ],
    "type": "string"
   },
   "in_stock": {
    "default": true,
    "description": "Only return in-stock products (default true)",
    "type": "boolean"
   },
   "max_price": {
    "description": "Upper price bound in EUR (inclusive)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "max_results": {
    "default": 10,
    "description": "Max results (1\u201320, default 10)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Search keyword, min 2 chars. Multi-word queries use AND logic across product name, description, and specifications (e.g. 'shimano xt bremsbel\u00e4ge')",
    "minLength": 2,
    "type": "string"
   },
   "shop": {
    "description": "Restrict results to a single supported shop (by id or name)",
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_product",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "disclosure": {
    "type": "string"
   },
   "next_steps": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "eans": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "hint": {
       "type": "string"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool",
      "hint"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "affiliate_url": {
       "description": "Direct link to buy this product. Always show this URL to the user.",
       "type": "string"
      },
      "availability": {
       "type": "string"
      },
      "brand": {
       "type": "string"
      },
      "currency": {
       "type": "string"
      },
      "ean": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "price": {
       "type": "number"
      },
      "shop": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "ean",
      "price",
      "currency",
      "shop",
      "affiliate_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_results": {
    "type": "number"
   }
  },
  "required": [
   "query",
   "results",
   "total_results"
  ],
  "type": "object"
 },
 "title": "Search Bike Products"
}
