   },
   "side": {
    "description": "\ub9e4\ub9e4 \uad6c\ubd84 \u2014 all(\uae30\ubcf8, \uc804\uccb4) | sell(\ub9e4\ub3c4) | buy(\ub9e4\uc218)",
    "enum": [
     "all",
     "sell",
     "buy"
    ],
    "type": "string"
   },
   "stock_code": {
    "description": "\ud2b9\uc815 \uc885\ubaa9\ub9cc \uc870\ud68c\ud560 \ub54c\uc758 6\uc790\ub9ac \uc885\ubaa9\ucf54\ub4dc",
    "pattern": "^[0-9A-Z]{6}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_order_executions",
 "title": "\uccb4\uacb0 \ub0b4\uc5ed \uc870\ud68c"
