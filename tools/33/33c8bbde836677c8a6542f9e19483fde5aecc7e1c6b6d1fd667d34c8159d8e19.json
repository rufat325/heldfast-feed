{
 "description": "Collect a bounded sample of live quotes or series. Stops after the message or duration limit and returns data messages as structured JSON.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "24h": {
    "description": "Include 24-hour market data.",
    "type": "boolean"
   },
   "badj": {
    "description": "Back-adjust continuous futures.",
    "type": "boolean"
   },
   "bar_interval": {
    "description": "Series interval. Tick requires 1; second accepts 1, 5, 10, 15, 30, or 45.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "bar_type": {
    "description": "Series bar type.",
    "enum": [
     "tick",
     "second",
     "minute",
     "hour",
     "day",
     "week",
     "month"
    ],
    "type": "string"
   },
   "currency": {
    "description": "Requested currency code.",
    "type": "string"
   },
   "dadj": {
    "description": "Apply dividend adjustment.",
    "type": "boolean"
   },
   "dp": {
    "description": "Initial series data points, 1-30000.",
    "maximum": 30000,
    "minimum": 1,
    "type": "integer"
   },
   "duration_seconds": {
    "default": 10,
    "description": "Stop after this many seconds. Default 10; maximum 60.",
    "exclusiveMinimum": 0,
    "maximum": 60,
    "type": "number"
   },
   "extended": {
    "description": "Include extended-hours data.",
    "type": "boolean"
   },
   "max_messages": {
    "default": 20,
    "description": "Stop after this many data messages. Default 20; maximum 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "max_reconnect_attempts": {
    "default": 2,
    "description": "Maximum consecutive reconnect attempts. Default 2; maximum 10.",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "settlement": {
    "description": "Use settlement as daily close.",
    "type": "boolean"
   },
   "slow_consumer_policy": {
    "description": "Use adaptive for fresh lower-frequency delivery instead of backlog disconnects.",
    "enum": [
     "disconnect",
     "adaptive"
    ],
    "type": "string"
   },
   "split": {
    "description": "Apply split adjustment.",
    "type": "boolean"
   },
   "subscriptions": {
    "description": "Per-symbol subscriptions. Do not combine with symbols or type.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "24h": {
       "type": "boolean"
      },
      "badj": {
       "type": "boolean"
      },
      "bar_interval": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "bar_type": {
       "enum": [
        "tick",
        "second",
        "minute",
        "hour",
        "day",
        "week",
        "month"
       ],
       "type": "string"
      },
      "code": {
       "description": "EXCHANGE:SYMBOL code.",
       "maxLength": 256,
       "type": "string"
      },
      "currency": {
       "type": "string"
      },
      "dadj": {
       "type": "boolean"
      },
      "dp": {
       "maximum": 30000,
       "minimum": 1,
       "type": "integer"
      },
      "extended": {
       "type": "boolean"
      },
      "settlement": {
       "type": "boolean"
      },
      "split": {
       "type": "boolean"
      },
      "type": {
       "enum": [
        "quote",
        "quotes",
        "series",
        "both"
       ],
       "type": "string"
      },
      "unit": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "type"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "symbols": {
    "anyOf": [
     {
      "maxLength": 65536,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 256,
       "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
     }
    ],
    "description": "One or more EXCHANGE:SYMBOL codes. Use with type."
   },
   "type": {
    "description": "Data to collect for every symbol. Use with symbols.",
    "enum": [
     "quote",
     "quotes",
     "series",
     "both"
    ],
    "type": "string"
   },
   "unit": {
    "description": "Requested unit code.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "collect_live",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activated": {
    "type": "boolean"
   },
   "data_message_count": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "endpoint": {
    "enum": [
     "live",
     "newsfeed"
    ],
    "type": "string"
   },
   "error": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "messages": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "stop_reason": {
    "enum": [
     "max_messages_reached",
     "duration_reached",
     "output_limit_reached",
     "cancelled",
     "activation_timeout",
     "terminal_error",
     "retry_exhausted",
     "output_error",
     "protocol_error"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "ok",
   "endpoint",
   "activated",
   "stop_reason",
   "data_message_count",
   "warnings",
   "messages"
  ],
  "type": "object"
 }
}
