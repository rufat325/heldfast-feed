{
 "description": "Create a new team. Requires `write` scope. Returns the created team.",
 "inputSchema": {
  "properties": {
   "color": {
    "description": "Hex color for the team chip",
    "type": "string"
   },
   "description": {
    "description": "What the team does",
    "type": "string"
   },
   "leadUid": {
    "description": "User id of the team lead",
    "type": "string"
   },
   "memberUids": {
    "description": "User ids of team members",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Team name (required)",
    "type": "string"
   },
   "slackChannel": {
    "description": "Slack channel, e.g. #payments",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_team"
}
