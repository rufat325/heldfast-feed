{"_meta":{"xdata.kr/credential":{"providers":[],"register_url":null,"required":false,"windows_pc_needed":false}},"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"\uc774 \uc870\uc9c1\uc758 \uad11\uace0\ube44 \ud55c\ub3c4(\ud558\ub8e8 \uc608\uc0b0 \uc0c1\ud55c\uacfc \uc785\ucc30\uac00 \uc0c1\ud55c, \uc6d0 \ub2e8\uc704)\ub97c \uc815\ud569\ub2c8\ub2e4. \ud558\ub8e8 \uc608\uc0b0 \uc0c1\ud55c\uc740 daily_budget_limit_won, \uc785\ucc30\uac00 \uc0c1\ud55c\uc740 max_bid_limit_won \uc5d0 0 \uc774\uc0c1\uc758 \uc815\uc218\ub97c \ub123\uace0, null \uc744 \ub123\uc73c\uba74 \uadf8 \uce78\uc744 \ube44\uc6c1\ub2c8\ub2e4. \ubcf4\ub0b4\uc9c0 \uc54a\uc740 \uce78\uc740 \uc9c0\uae08 \uac12 \uadf8\ub300\ub85c\uc785\ub2c8\ub2e4. \ube44\uc6b4 \uce78\uc740 \ubb34\uc81c\ud55c\uc774 \uc544\ub2c8\ub77c \uadf8 \uae08\uc561\uc744 \ubc14\uafb8\ub294 \uc694\uccad\uc744 \ub9c9\uc2b5\ub2c8\ub2e4. \ub450 \uce78 \ubaa8\ub450 \uc9c0\uae08 \uac12 \uc774\ud558\ub85c \ub0ae\ucd94\uac70\ub098 \ube44\uc6b0\ub294 \uc694\uccad\uc740 \uccab \ud638\ucd9c\uc5d0 \ubc14\ub85c \ubc18\uc601\ub429\ub2c8\ub2e4 - \ubbf8\ub9ac\ubcf4\uae30\ub9cc \ubcf4\ub824\uace0 \ub0ae\uc740 \uac12\uc73c\ub85c \ubd80\ub974\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ucc98\uc74c \uc815\ud558\uac70\ub098 \uc62c\ub9ac\ub294 \uc694\uccad\uc758 \uccab \ud638\ucd9c\uc740 \ubc18\uc601\ub418\uc9c0 \uc54a\uace0, \ubc14\ub014 \uac12\uacfc \uc9c0\uae08 \uac12\uc758 \ubbf8\ub9ac\ubcf4\uae30\uc640 1\ud68c\uc6a9 confirmation_token \uc744 \ub3cc\ub824\uc90d\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uadf8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc0ac\uc6a9\uc790\uc5d0\uac8c \uadf8\ub300\ub85c \ubcf4\uc5ec \uc8fc\uace0, \uc0ac\uc6a9\uc790\uac00 \ub3d9\uc758\ud55c \ub4a4\uc5d0\ub9cc \uac19\uc740 \uc778\uc790\uc5d0 \uadf8 confirmation_token \uc744 \ub354\ud574 \ub2e4\uc2dc \ud638\ucd9c\ud569\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uc758 \ub3d9\uc758 \uc5c6\uc774 \ud1a0\ud070\uc744 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud55c\ub3c4\ub294 \uad11\uace0 \uae08\uc561\uc744 \ubc14\uafb8\ub294 \uc694\uccad\uc744 \ub9c9\ub294 \uae30\uc900\uc774\uace0 \uc2e4\uc81c \ud558\ub8e8 \uc9c0\ucd9c \uc0c1\ud55c\uc744 \ubcf4\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc5d1\uc2a4\ubcf4\uc2a4\uc5d0 \uc800\uc7a5\ub41c \uc124\uc815\ub9cc \ubc14\uafc9\ub2c8\ub2e4. \uc678\ubd80 \uae30\uad00\uc774\ub098 \uad11\uace0 \uacc4\uc815\uc744 \ubd80\ub974\uc9c0 \uc54a\uc73c\uba70 \ub85c\uadf8\uc778\uc774\ub098 \uc5f0\ub3d9\uc774 \ud544\uc694 \uc5c6\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc774\uba74 \uccab \uc694\uccad \uc804\uc5d0 request_idempotency_key \uac12\uc744 \ub9cc\ub4e4\uc5b4 \uc800\uc7a5\ud558\uc138\uc694. \uc751\ub2f5\uc744 \ubc1b\uc9c0 \ubabb\ud55c \uadf8 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c\ub9cc \uac19\uc740 \uc778\uc790\uc640 \ud568\uaed8 \uadf8 \uac12\uc744 \ub2e4\uc2dc \ubcf4\ub0b4\uace0, \uc0c8\ub85c \uc2e4\ud589\ud560 \ub54c\ub294 \uc0c8 \uac12\uc744 \uc4f0\uc138\uc694. \uc774 \uac12 \uc5c6\uc774 \ub2e4\uc2dc \ubd80\ub974\uba74 \uc0c8 \uc694\uccad\uc774 \ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5c6\uc774 \ub9db\ubcf4\uae30\ub85c \ubd80\ub97c \ub54c\ub294 \uc774 \uc120\ud0dd \uce78\uc744 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00 \uc5c5\ubb34\uc5d0 \ub530\ub85c \uc788\ub294 idempotency_key \uce78\uc740 \ub2e4\ub978 \uce78\uc774\ub2c8 \uadf8\ub300\ub85c \ub450\uc138\uc694. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 1\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"confirmation_token":{"description":"\uccab \ud638\ucd9c\uc774 \ub3cc\ub824\uc900 1\ud68c\uc6a9 \ud655\uc778 \ud1a0\ud070\uc785\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uac19\uc740 \uc778\uc790\uc5d0 \uc774 \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc5b4 \ub2e4\uc2dc \ud638\ucd9c\ud558\uba74 \uc2e4\ud589\ub429\ub2c8\ub2e4. 10\ubd84 \ub4a4 \ub9cc\ub8cc\ub418\uace0 \ud55c \ubc88\ub9cc \uc4f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","type":"string"},"daily_budget_limit_won":{"description":"\ud558\ub8e8 \uc608\uc0b0 \uc0c1\ud55c(\uc6d0 \ub2e8\uc704 \uc815\uc218, 0 \uc774\uc0c1). null \uc774\uba74 \ud55c\ub3c4\ub97c \ube44\uc6b0\uace0, \ube44\uc6b4 \ud55c\ub3c4\ub294 \ubb34\uc81c\ud55c\uc774 \uc544\ub2c8\ub77c \ud558\ub8e8 \uc608\uc0b0\uc744 \ubc14\uafb8\ub294 \uc694\uccad\uc744 \ub9c9\uc2b5\ub2c8\ub2e4","minimum":0,"type":["integer","null"]},"max_bid_limit_won":{"description":"\uc785\ucc30\uac00 \uc0c1\ud55c(\uc6d0 \ub2e8\uc704 \uc815\uc218, 0 \uc774\uc0c1). null \uc774\uba74 \ud55c\ub3c4\ub97c \ube44\uc6b0\uace0, \ube44\uc6b4 \ud55c\ub3c4\ub294 \ubb34\uc81c\ud55c\uc774 \uc544\ub2c8\ub77c \uc785\ucc30\uac00\ub97c \ubc14\uafb8\ub294 \uc694\uccad\uc744 \ub9c9\uc2b5\ub2c8\ub2e4","minimum":0,"type":["integer","null"]},"request_idempotency_key":{"description":"\ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc5d0\uc11c \uc751\ub2f5\uc744 \ubabb \ubc1b\uc740 \uac19\uc740 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c \uc4f0\ub294 \uc120\ud0dd \uac12\uc785\ub2c8\ub2e4. \uc4f0\ub294 \ubc95\uc740 \ub3c4\uad6c \uc124\uba85\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.","maxLength":128,"minLength":1,"pattern":"^[\\x20-\\x7E]+$","type":"string"}},"required":[],"type":"object"},"name":"marketing__budget_limit__set","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\uad11\uace0\ube44 \ud55c\ub3c4 \uc815\ud558\uae30"}
