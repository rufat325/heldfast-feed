{
 "_meta": {
  "ui": {
   "resourceUri": "ui://uniaffitti/account/v2.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a listing draft for UniAffitti moderation. It is not public until approved. The draft stores the full property address and coordinates; university and campus IDs remain unset. Do not include passwords, payment-card details, government identifiers, health or biometric data in the description.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "address_full": {
    "description": "Full address of the property being listed; shared with the connector when you create this listing.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "available_from": {
    "description": "YYYY-MM-DD.",
    "type": "string"
   },
   "city": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "country_code": {
    "description": "ISO 3166-1 alpha-2 country code.",
    "type": "string"
   },
   "deposit_amount": {
    "minimum": 0,
    "type": "number"
   },
   "description": {
    "description": "Describe the room and rental terms only. Do not include passwords, payment-card details, government identifiers, health or biometric data.",
    "minLength": 1,
    "type": "string"
   },
   "features": {
    "additionalProperties": true,
    "type": "object"
   },
   "latitude": {
    "description": "Exact latitude of the property being listed.",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "location_label": {
    "maxLength": 190,
    "type": "string"
   },
   "longitude": {
    "description": "Exact longitude of the property being listed.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "min_stay_months": {
    "minimum": 0,
    "type": "integer"
   },
   "occupancy_status": {
    "default": "available",
    "enum": [
     "available",
     "reserved",
     "rented",
     "unavailable"
    ],
    "type": "string"
   },
   "price_currency": {
    "default": "EUR",
    "type": "string"
   },
   "price_monthly": {
    "minimum": 0,
    "type": "number"
   },
   "property_floor": {
    "maximum": 20,
    "minimum": -2,
    "type": "integer"
   },
   "property_type": {
    "default": "apartment",
    "enum": [
     "apartment",
     "house",
     "other"
    ],
    "type": "string"
   },
   "room_type": {
    "enum": [
     "single",
     "double",
     "bed"
    ],
    "type": "string"
   },
   "title": {
    "maxLength": 190,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "description",
   "address_full",
   "city",
   "country_code",
   "latitude",
   "longitude",
   "property_floor",
   "price_monthly",
   "room_type"
  ],
  "type": "object"
 },
 "name": "create_listing",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "location": {
    "additionalProperties": false,
    "properties": {
     "city": {
      "type": "string"
     },
     "country_code": {
      "type": "string"
     },
     "location_label": {
      "type": "string"
     }
    },
    "required": [
     "city",
     "country_code",
     "location_label"
    ],
    "type": "object"
   },
   "moderation_status": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "room_id": {
    "type": "integer"
   }
  },
  "required": [
   "room_id",
   "moderation_status",
   "location",
   "next_step"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "listings:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Create a listing"
}
