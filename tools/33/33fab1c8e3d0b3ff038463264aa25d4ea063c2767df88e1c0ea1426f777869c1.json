{
 "description": "Find a 1C document by its number. Convenience wrapper over OData $filter. Example: locate invoice \u0422\u0414-00123 dated 2025-03-01.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "description": "\u0414\u0430\u0442\u0430 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430 \u0432 \u0444\u043e\u0440\u043c\u0430\u0442\u0435 YYYY-MM-DD (\u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e, \u0441\u0443\u0436\u0430\u0435\u0442 \u043f\u043e\u0438\u0441\u043a)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "document_type": {
    "description": "\u0422\u0438\u043f \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, Document_\u0420\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u044f\u0422\u043e\u0432\u0430\u0440\u043e\u0432\u0423\u0441\u043b\u0443\u0433)",
    "type": "string"
   },
   "number": {
    "description": "\u041d\u043e\u043c\u0435\u0440 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430",
    "type": "string"
   },
   "select": {
    "description": "\u041f\u043e\u043b\u044f \u0434\u043b\u044f \u0432\u044b\u0431\u043e\u0440\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 OData $select (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, Ref_Key,Number,Date)",
    "type": "string"
   }
  },
  "required": [
   "document_type",
   "number"
  ],
  "type": "object"
 },
 "name": "get_document_by_number"
}
