{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Issue private API key"
 },
 "description": "Issue an API key after the email is confirmed.\n\n        Not needed when confirm_signup already returned api_key. Each call issues another key, so call it once.\n        Returns the key once. Store it securely and attach it to the connection.\n        ",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "account_id": {
    "description": "account_id returned by signup_free. Example: 3f1c2b9e-1d2a-4c5b-9e8f-0a1b2c3d4e5f",
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "title": "Account Id",
    "type": "string"
   },
   "signup_token": {
    "description": "signup_token returned by signup_free. It lasts 24 hours.",
    "maxLength": 512,
    "minLength": 1,
    "title": "Signup Token",
    "type": "string"
   }
  },
  "required": [
   "account_id",
   "signup_token"
  ],
  "title": "create_api_keyArguments",
  "type": "object"
 },
 "name": "create_api_key",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "api_key": {
    "title": "Api Key",
    "type": "string"
   },
   "prefix": {
    "title": "Prefix",
    "type": "string"
   }
  },
  "required": [
   "api_key",
   "prefix"
  ],
  "title": "IssuedKey",
  "type": "object"
 },
 "title": "Issue private API key"
}
