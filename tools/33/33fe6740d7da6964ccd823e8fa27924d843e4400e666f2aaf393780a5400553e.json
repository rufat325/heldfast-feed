  "properties": {
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "headlineStatesOutcome": {
    "description": "The headline states an outcome/benefit (weight 20)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "noJargon": {
    "description": "No jargon or vague buzzwords (weight 15)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "oneObviousPrimaryCta": {
    "description": "One obvious primary CTA above the fold (weight 20)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "strangerUnderstandsIn5Seconds": {
    "description": "A stranger knows what you do in 5 seconds (weight 30)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "subheadSupportsHeadline": {
    "description": "Subhead supports (not repeats) the headline (weight 15)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   }
  },
  "required": [
   "strangerUnderstandsIn5Seconds",
   "headlineStatesOutcome",
   "oneObviousPrimaryCta",
   "noJargon",
   "subheadSupportsHeadline"
  ],
  "type": "object"
 },
