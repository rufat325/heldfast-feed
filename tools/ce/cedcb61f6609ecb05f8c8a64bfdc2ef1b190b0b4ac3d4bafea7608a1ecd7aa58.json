{
 "description": "Render a still PNG of a VRM in its rest pose through a local headless Chrome/Edge, with optional expression weights (e.g. {\"happy\": 1}) and view presets including a face close-up.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expression": {
    "additionalProperties": {
     "maximum": 1,
     "minimum": 0,
     "type": "number"
    },
    "type": "object"
   },
   "height": {
    "maximum": 4096,
    "minimum": 64,
    "type": "integer"
   },
   "output_path": {
    "description": "Where to write the PNG output",
    "type": "string"
   },
   "path": {
    "description": "Local path to the .vrm avatar",
    "type": "string"
   },
   "pose": {
    "description": "v0.1 supports the rest pose only",
    "enum": [
     "rest"
    ],
    "type": "string"
   },
   "view": {
    "enum": [
     "front",
     "three_quarter",
     "side",
     "face"
    ],
    "type": "string"
   },
   "width": {
    "maximum": 4096,
    "minimum": 64,
    "type": "integer"
   }
  },
  "required": [
   "path",
   "output_path"
  ],
  "type": "object"
 },
 "name": "vrm_snapshot"
}
