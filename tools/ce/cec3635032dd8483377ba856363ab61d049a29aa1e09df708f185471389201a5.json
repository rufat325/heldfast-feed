{"_meta":{"openai/toolInvocation/invoked":"Bewertung gestartet","openai/toolInvocation/invoking":"Bewertung wird gestartet \u2026","securitySchemes":[{"type":"noauth"},{"scopes":["email"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Text bewerten lassen"},"description":"Use this when the user wants a German text they wrote themselves (about 50 to 900 words) evaluated the way an examiner would, for the writing section of TestDaF, DSH, Goethe-Zertifikat C1, telc Deutsch C1 Hochschule or telc Deutsch C1 (general). Without sign-in the result is a first evaluation (one per user): the passages an examiner would mark and the biggest risk. After the user signs in to their GermanExam.pro account the result also includes the verdict (is it enough, level, how close it is); what else an account includes depends on the account, and the result says when something is not included. Starts the evaluation and returns a job_id immediately; the result is collected with bewertung_abholen. Send only the user's own text. Not for: translations, grammar questions, exam tasks, phrase lists, texts the user did not write, or other languages.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"exam":{"description":"The exam the text is for: testdaf, dsh, goethe_c1, telc_c1 (Hochschule) or telc_c1_allgemein (general). Ask the user if unclear \u2014 plain \"telc C1\" can mean either telc exam.","enum":["testdaf","dsh","goethe_c1","telc_c1","telc_c1_allgemein"],"type":"string"},"feedback_language":{"description":"Language of the feedback: the language the user is writing to you in (de, en, ar, tr, ru, zh, fa). Default de.","enum":["de","en","ar","tr","ru","zh","fa"],"type":"string"},"is_revision":{"description":"true if this is a revised version of a text the user already had evaluated; false or omitted for a new text.","type":"boolean"},"part":{"description":"Only for goethe_c1: 1 = discussion post for an internet forum, 2 = (semi-)formal e-mail.","enum":["1","2"],"type":"string"},"task":{"description":"Optional: the exam task the text answers, verbatim, if the user has it.","maxLength":1000,"type":"string"},"text":{"description":"The German text exactly as the user wrote it (their own writing, at least about 50 words). Only the text itself \u2014 no chat history, no instructions.","maxLength":9000,"minLength":1,"type":"string"}},"required":["text","exam"],"type":"object"},"name":"text_bewerten","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"infoLabel":{"type":"string"},"infoUrl":{"type":"string"},"jobId":{"type":"string"},"labels":{"additionalProperties":{"type":"string"},"propertyNames":{"type":"string"},"type":"object"},"message":{"type":"string"},"preview":{"additionalProperties":false,"properties":{"biggestRisk":{"anyOf":[{"type":"string"},{"type":"null"}]},"exam":{"additionalProperties":false,"properties":{"name":{"type":"string"},"slug":{"enum":["testdaf","dsh","goethe_c1","telc_c1","telc_c1_allgemein"],"type":"string"}},"required":["slug","name"],"type":"object"},"language":{"enum":["de","en","ar","tr","ru","zh","fa"],"type":"string"},"marks":{"items":{"type":"string"},"type":"array"},"ownWork":{"type":"boolean"},"short":{"type":"boolean"},"wordCount":{"type":"number"}},"required":["exam","language","wordCount","biggestRisk","marks","short","ownWork"],"type":"object"},"retryAfterSeconds":{"type":"number"},"status":{"enum":["running","done","not_in_plan","not_a_submission","no_verdict","invalid_input","limit","busy","unavailable","not_found","sign_in_required"],"type":"string"},"verdict":{"additionalProperties":false,"properties":{"criteria":{"items":{"additionalProperties":false,"properties":{"mark":{"anyOf":[{"type":"string"},{"type":"null"}]},"name":{"type":"string"},"reason":{"anyOf":[{"type":"string"},{"type":"null"}]},"strengths":{"items":{"type":"string