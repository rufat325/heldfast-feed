  "properties": {
   "case_id": {
    "description": "Numeric judgment id",
    "minimum": 1,
    "title": "Case Id",
    "type": "integer"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "minimum": 0,
    "title": "Offset",
    "type": "integer"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "title": "Response Format",
    "type": "string"
   }
  },
  "required": [
   "case_id"
  ],
  "title": "caselaw_get_cited_byArguments",
  "type": "object"
 },
 "name": "caselaw_get_cited_by",
 "outputSchema": {
  "properties": {
