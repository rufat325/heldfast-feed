{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Generate draft hiring outcomes"
 },
 "description": "Generate draft interview-plan outcomes from explicit role context, or pass accepted_outcomes to store caller-written outcomes verbatim with no AI generation (the deterministic draft bootstrap).",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "const": "interview_plan.generate_outcomes",
    "type": "string"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "input": {
    "additionalProperties": false,
    "properties": {
     "accepted_outcomes": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "description": {
         "maxLength": 5000,
         "type": "string"
        },
        "id": {
         "maxLength": 128,
         "type": "string"
        },
        "priority": {
         "maxLength": 128,
         "type": "string"
        },
        "tag": {
         "maxLength": 128,
         "type": "string"
        },
        "text": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        },
        "title": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 25,
      "minItems": 1,
      "type": "array"
     },
     "instructions": {
      "maxLength": 10000,
      "type": "string"
     },
     "role_context": {
      "additionalProperties": false,
      "properties": {
       "additional_context": {
        "maxLength": 20000,
        "type": "string"
       },
       "organization_context": {
        "maxLength": 10000,
        "type": "string"
       },
       "role_title": {
        "maxLength": 300,
        "type": "string"
       },
       "title": {
        "maxLength": 300,
        "type": "string"
       }
      },
      "type": "object"
     },
     "source_job_id": {
      "type": "string"
     }
    },
    "required": [
     "role_context"
    ],
    "type": "object"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "resource": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "pattern": "^ipd_[0-9A-Za-z]{16,64}$",
      "type": "string"
     },
     "type": {
      "const": "interview_plan_draft",
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   }
  },
  "required": [
   "action",
   "input"
  ],
  "type": "object"
 },
 "name": "yardstick_interview_plan_drafts_generate_outcomes",
 "title": "Generate draft hiring outcomes"
}
