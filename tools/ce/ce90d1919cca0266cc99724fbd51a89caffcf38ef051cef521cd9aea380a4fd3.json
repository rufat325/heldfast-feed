{
 "description": "Rename a chat, change its description, or update its icon. The bot must be an admin of the chat.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chat_id": {
    "description": "The chat_id to edit",
    "type": "integer"
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "New chat description (pass null to clear)"
   },
   "icon": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "url": {
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "New icon as { url } (pass null to remove)"
   },
   "notify_members": {
    "description": "Notify members about changes (default: false)",
    "type": "boolean"
   },
   "title": {
    "description": "New chat title",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "chat_id"
  ],
  "type": "object"
 },
 "name": "edit_chat",
 "title": "Edit Chat"
}
