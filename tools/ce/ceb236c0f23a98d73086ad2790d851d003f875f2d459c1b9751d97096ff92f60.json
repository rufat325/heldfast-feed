{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Trump Truth Social posts"
 },
 "description": "Recent Truth Social posts by President Trump as they crossed the tape, with the measured market reaction where the post moved an instrument. Use for 'what has Trump posted today' or 'did his tariff post move markets'.",
 "inputSchema": {
  "properties": {
   "hours": {
    "description": "Look-back window in hours (1-336, default 24).",
    "type": "integer"
   },
   "limit": {
    "description": "Max results (1-50, default 20).",
    "type": "integer"
   },
   "query": {
    "description": "Free text to match in the post, e.g. tariff.",
    "type": "string"
   },
   "with_reaction_only": {
    "description": "Only posts with a measured market reaction.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "truth_social_posts",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "posts": {
    "items": {
     "properties": {
      "category": {
       "type": "string"
      },
      "context": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "headline": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "impact": {
       "type": "string"
      },
      "market_reaction": {
       "properties": {
        "instruments": {
         "items": {
          "properties": {
           "label": {
            "description": "Display name of the measured series.",
            "type": "string"
           },
           "move_10m_pct": {
            "description": "Percent move 10 minutes after the headline, measured from price_before.",
            "type": [
             "number",
             "null"
            ]
           },
           "move_1m_pct": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_10m": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_1m": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_before": {
            "description": "Price immediately before the headline crossed.",
            "type": [
             "number",
             "null"
            ]
           },
           "symbol": {
            "type": "string"
           },
           "volume_quality": {
            "type": [
             "string",
             "null"
            ]
           },
           "volume_ratio_10m": {
            "type": [
             "number",
             "null"
            ]
           },
           "window_minutes": {
            "type": "integer"
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        "measured_from": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "published_utc": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "tickers": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "why": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "headline"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "window_hours": {
    "type": "integer"
   }
  },
  "required": [
   "count",
   "posts"
  ],
  "type": "object"
 },
 "title": "Trump Truth Social posts"
}
