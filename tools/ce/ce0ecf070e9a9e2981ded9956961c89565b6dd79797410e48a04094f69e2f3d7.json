{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List files in a bucket with pagination and search (s3/get_files).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account_id": {
    "description": "Deprecated alias for s3uid",
    "type": "integer"
   },
   "bucket": {
    "description": "Bucket name",
    "type": "string"
   },
   "limit": {
    "description": "Page size",
    "type": "integer"
   },
   "page": {
    "description": "Page number",
    "type": "integer"
   },
   "s3uid": {
    "description": "S3 account UID; omit only if the token is bound to a single S3 account",
    "type": [
     "string",
     "number"
    ]
   },
   "search": {
    "description": "Search string by file name",
    "type": "string"
   }
  },
  "required": [
   "bucket"
  ],
  "type": "object"
 },
 "name": "s3_get_files"
