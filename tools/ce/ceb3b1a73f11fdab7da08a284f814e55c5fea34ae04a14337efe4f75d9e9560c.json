{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Free checks: balance (with this session's spend), transactions (itemised ledger; the receipts for one request_id), status (platform health; read it before retrying a 502/503) and freshness (whether this server's bundled catalogue is behind the API).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "transactions: next_cursor from the last page.",
    "type": "string"
   },
   "limit": {
    "description": "transactions: page size.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "request_id": {
    "description": "transactions: receipts for one request.",
    "type": "string"
   },
   "view": {
    "description": "balance (default, with this session's spend), transactions (ledger), status (platform health), freshness (catalogue vs live API).",
    "enum": [
     "balance",
     "transactions",
     "status",
     "freshness"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "socialcrawl_account",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "credits": {
    "additionalProperties": false,
    "properties": {
     "cached": {
      "description": "Cache hit: 0 credits.",
      "type": "boolean"
     },
     "estimated": {
      "description": "used = the hold.",
      "type": "boolean"
     },
     "quoted_max": {
      "description": "Hold taken up front.",
      "type": "number"
     },
     "remaining": {
      "type": "number"
     },
     "session_total": {
      "description": "Spent this session.",
      "type": "number"
     },
     "used": {
      "description": "After refunds.",
      "type": "number"
     }
    },
    "type": "object"
   },
   "data": {},
   "did_you_mean": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "fix": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "paging": {
    "additionalProperties": false,
    "properties": {
     "has_more": {
      "description": "false: stop paging.",
      "type": "boolean"
     },
     "next_cursor": {
      "description": "Send as cursor.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "has_more"
    ],
    "type": "object"
   },
   "reason": {
    "type": "string"
   },
   "request_id": {
    "type": "string"
   },
   "retry_after_s": {
    "type": "number"
   },
   "retryable": {
    "description": "Never retry a 402.",
    "type": "boolean"
   },
   "rows": {
    "description": "Ledger receipts.",
    "items": {},
    "type": "array"
   },
   "view": {
    "enum": [
     "balance",
     "transactions",
     "status",
     "freshness"
    ],
    "type": "string"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Account and Service Status"
}
