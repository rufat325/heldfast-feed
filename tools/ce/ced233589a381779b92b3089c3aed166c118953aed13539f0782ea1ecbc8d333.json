{
 "description": "List a product model's catalog with stock and variant info (onHand/reserved/available per record and variant).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filter": {
    "properties": {
     "hasVariants": {
      "type": "boolean"
     },
     "priceMax": {
      "type": "number"
     },
     "priceMin": {
      "type": "number"
     },
     "search": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "stockState": {
      "enum": [
       "in",
       "low",
       "out"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "limit": {
    "default": 50,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "modelId": {
    "description": "Product model id",
    "minLength": 1,
    "type": "string"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "sort": {
    "description": "Sort expression, e.g. 'createdAt' or '-updatedAt'",
    "type": "string"
   }
  },
  "required": [
   "modelId"
  ],
  "type": "object"
 },
 "name": "list_products"
}
