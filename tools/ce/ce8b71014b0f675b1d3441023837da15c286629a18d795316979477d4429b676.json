{
 "description": "Place a trailing stop or trailing buy over WS. action: trailing_sell|trailing_buy. trail: bps distance.",
 "inputSchema": {
  "properties": {
   "action": {
    "enum": [
     "trailing_sell",
     "trailing_buy"
    ],
    "type": "string"
   },
   "amount": {
    "type": "integer"
   },
   "expiry_hours": {
    "default": 144,
    "maximum": 336,
    "minimum": 1,
    "type": "integer"
   },
   "holdings_percentage": {
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "slippage": {
    "default": 1500,
    "maximum": 2500,
    "minimum": 100,
    "type": "integer"
   },
   "token_address": {
    "type": "string"
   },
   "trail": {
    "minimum": 1,
    "type": "integer"
   },
   "wallet_address": {
    "type": "string"
   }
  },
  "required": [
   "wallet_address",
   "token_address",
   "action",
   "trail"
  ],
  "type": "object"
 },
 "name": "place_trailing_order"
}
