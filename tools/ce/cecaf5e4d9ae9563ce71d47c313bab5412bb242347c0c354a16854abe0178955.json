{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a contact"
 },
 "description": "Create a new end-user contact under an existing customer (give customer_id or customer_name). Atera: POST /api/v3/contacts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "customer_id": {
    "description": "The customer's CustomerID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "customer_name": {
    "description": "The customer's name, if you don't have the id.",
    "type": "string"
   },
   "email": {
    "description": "The contact's email (required).",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "first_name": {
    "type": "string"
   },
   "is_contact_person": {
    "description": "Mark as the customer's primary contact person.",
    "type": "boolean"
   },
   "job_title": {
    "type": "string"
   },
   "last_name": {
    "type": "string"
   },
   "mobile_phone": {
    "type": "string"
   },
   "phone": {
    "type": "string"
   }
  },
  "required": [
   "email"
  ],
  "type": "object"
 },
 "name": "atera_create_contact",
 "title": "Create a contact"
}
