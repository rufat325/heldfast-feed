{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"\ubcf5\ub300\ub9ac \uc0c1\ub2f4 \uc218\uc815\u00b7\ucca0\ud68c \uc900\ube44"},"description":"Prepare an edit or withdrawal preview without applying it.\n\n\uc0ac\uc6a9\uc790\uac00 \uc811\uc218\ud55c \uc0c1\ub2f4\uc758 \uc218\uc815\u00b7\ucca0\ud68c\ub97c \uc694\uccad\ud588\uc744 \ub54c \ubcc0\uacbd\uc548\ub9cc \uc900\ube44\ud569\ub2c8\ub2e4. \uba3c\uc800 \uac00\ub2a5 \uc5ec\ubd80\uc640 \ud604\uc7ac \ubc84\uc804\uc744 \uc870\ud68c\ud558\uc138\uc694. edit\uc740 \ub300\ud654\uc5d0\uc11c \ud655\uc778\ud55c \ubcc0\uacbd \ud6c4 \uc804\uccb4 \uc694\uc57d\u00b7\uc720\ud615\u00b7\ub2e8\uacc4\ub97c \ub123\uace0 withdraw\ub294 \uc774 \uc138 \ud544\ub4dc\ub97c \uc0dd\ub7b5\ud569\ub2c8\ub2e4. edit\uc740 after.summary, withdraw\ub294 \ucca0\ud68c \ub300\uc0c1\uc778 before.summary\ub97c \uadf8\ub300\ub85c \uc778\uc6a9\ud558\uc138\uc694. \uc55e\uc120 \ub300\ud654\uc5d0 \uac19\uc740 \uc694\uc57d\uc774 \uc788\uc5b4\ub3c4 \uc774\ubc88 \ud655\uc778 \uc548\ub0b4\uc5d0 \ud3ec\ud568\ud569\ub2c8\ub2e4. \ubcc0\uacbd \uc804\ud6c4\u00b7\ube44\uc6a9 \uc720\uc9c0 \ub610\ub294 \ucca0\ud68c \ud6a8\uacfc\uc640 \uc544\uc9c1 \uc801\uc6a9 \uc804\uc774\ub77c\ub294 \uc0ac\uc2e4\uc744 \uc124\uba85\ud55c \ub4a4 \ubc18\ud658\ub41c next_action\uc744 \ub530\ub974\uc138\uc694: confirm_in_chat\uc774\uba74 \uc0ac\uc6a9\uc790\uc758 \uba85\ud655\ud55c \ub3d9\uc758 \uc751\ub2f5\uc744 \ubc1b\uc740 \ub4a4 apply_consultation_change\ub97c, confirm_on_web\uc774\uba74 \ubcf5\ub300\ub9ac \ud655\uc778 \ub9c1\ud06c\ub97c \uc548\ub0b4\ud569\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"category":{"enum":["civil","criminal","advisory"],"type":"string"},"change":{"enum":["edit","withdraw"],"type":"string"},"request_id":{"pattern":"^[a-f0-9]{32}$","type":"string"},"revision":{"minimum":1,"type":"integer"},"stage":{"enum":["before_action","in_progress","urgent","general_advice"],"type":"string"},"summary":{"maxLength":200,"minLength":10,"type":"string"}},"required":["request_id","revision","change"],"type":"object"},"name":"prepare_consultation_change","securitySchemes":[{"scopes":["consultations:read"],"type":"oauth2"}],"title":"\ubcf5\ub300\ub9ac \uc0c1\ub2f4 \uc218\uc815\u00b7\ucca0\ud68c \uc900\ube44"}
