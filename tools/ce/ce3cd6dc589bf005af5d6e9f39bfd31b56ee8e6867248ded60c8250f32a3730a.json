{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Legge un estratto conto esportato dall'home banking (XLSX, XLS, CSV) e mostra banca riconosciuta, periodo, entrate e uscite.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bank": {
    "description": "Forza il formato (vedi bank_formats), es. 'intesa'",
    "type": "string"
   },
   "file_path": {
    "type": "string"
   },
   "mapping": {
    "description": "Solo per banche non riconosciute: nomi delle colonne nell'intestazione del file",
    "properties": {
     "amount": {
      "description": "Colonna importo con segno",
      "type": "string"
     },
     "credit": {
      "description": "Colonna accrediti/entrate (in alternativa ad amount)",
      "type": "string"
     },
     "date": {
      "description": "Intestazione della colonna data",
      "type": "string"
     },
     "debit": {
      "description": "Colonna addebiti/uscite",
      "type": "string"
     },
     "description": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      ],
      "description": "Colonna/e descrizione"
     },
     "value_date": {
      "type": "string"
     }
    },
    "required": [
     "date",
     "description"
    ],
    "type": "object"
   }
  },
  "required": [
   "file_path"
  ],
  "type": "object"
 },
 "name": "bank_parse_statement"
}
