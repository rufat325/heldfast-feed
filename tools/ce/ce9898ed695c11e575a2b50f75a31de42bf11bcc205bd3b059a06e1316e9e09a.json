{
 "description": "Create a new game session, optionally associated with a world pack.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Session name",
    "type": "string"
   },
   "seed": {
    "description": "RNG seed for determinism",
    "type": "number"
   },
   "sessionId": {
    "description": "Unique session ID",
    "type": "string"
   },
   "worldPackId": {
    "description": "World pack ID (required - every session must belong to a world)",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "name",
   "worldPackId"
  ],
  "type": "object"
 },
 "name": "create_session"
}
