{
 "description": "Store text or structured content as an immutable artifact version, optionally linked to a work item. Reusing artifactId creates the next version.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "artifactId": {
    "maxLength": 200,
    "minLength": 4,
    "type": "string"
   },
   "content": {
    "maxLength": 48000,
    "type": "string"
   },
   "mediaType": {
    "default": "text/plain",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "workId": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "name",
   "content"
  ],
  "type": "object"
 },
 "name": "artifact_put"
}
