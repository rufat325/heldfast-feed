{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get a booking link"
 },
 "description": "Get the TripWays checkout link for a tour, optionally preset to a date, start time, rate, and traveler mix. The traveler pays on tripways.com; this tool does not hold seats or take payment. bookable_natively and reason say whether the link opens TripWays checkout or the operator's calendar, and whether a hotel pickup must be chosen at checkout.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bokun_id": {
    "pattern": "^[0-9]+$",
    "type": "string"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "rate_id": {
    "minimum": 1,
    "type": "integer"
   },
   "start_time": {
    "description": "HH:MM if start_time_id unknown.",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "start_time_id": {
    "minimum": 1,
    "type": "integer"
   },
   "travelers": {
    "additionalProperties": false,
    "description": "Simple ages; mapped to Bokun pricing categories.",
    "properties": {
     "adults": {
      "default": 1,
      "minimum": 0,
      "type": "integer"
     },
     "children": {
      "minimum": 0,
      "type": "integer"
     },
     "infants": {
      "minimum": 0,
      "type": "integer"
     },
     "seniors": {
      "minimum": 0,
      "type": "integer"
     },
     "youth": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "bokun_id"
  ],
  "type": "object"
 },
 "name": "get_booking_link",
 "outputSchema": {
  "properties": {
   "bokun_id": {
    "type": "string"
   },
   "bookable_natively": {
    "type": "boolean"
   },
   "checkout_url": {
    "description": "Open in the browser to pay on tripways.com.",
    "type": "string"
   },
   "error": {
    "description": "Present when ok is false. code: tour_not_found, destination_not_found, destination_ambiguous, or unpriced. message is written for the traveler.",
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "min_participants": {
    "type": "integer"
   },
   "ok": {
    "type": "boolean"
   },
   "reason": {
    "type": [
     "string",
     "null"
    ]
   },
   "spots_left": {
    "type": [
     "integer",
     "null"
    ]
   },
   "start_time": {
    "type": "string"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Get a booking link"
}
