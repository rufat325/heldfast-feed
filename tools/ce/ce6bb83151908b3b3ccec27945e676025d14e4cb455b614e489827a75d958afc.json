{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare the configuration of two environments of the same project before promoting. Services are paired by component name: for each pair it reports which variable names match, differ or exist on one side only, whether the source image or recipe diverges, and the summarized database connection state of each side. Never returns variable values, credentials or digests. Read-only; changes nothing. Requires unrestricted account credentials.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "environment_id": {
    "pattern": "^env_[a-f0-9]{24}$",
    "type": "string"
   },
   "other_environment_id": {
    "description": "The environment to compare against.",
    "pattern": "^env_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "required": [
   "environment_id",
   "other_environment_id"
  ],
  "type": "object"
 },
 "name": "impreza_compare_environments",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "environment_a": {
      "type": "object"
     },
     "environment_b": {
      "type": "object"
     },
     "only_in_a": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "component": {
         "type": "string"
        },
        "deployment_id": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "role": {
         "type": "string"
        },
        "status": {
         "type": "string"
        }
       },
       "required": [
        "component",
        "role",
        "deployment_id",
        "kind",
        "status"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "only_in_b": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "component": {
         "type": "string"
        },
        "deployment_id": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "role": {
         "type": "string"
        },
        "status": {
         "type": "string"
        }
       },
       "required": [
        "component",
        "role",
        "deployment_id",
        "kind",
        "status"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "paired": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "a": {
         "type": "object"
        },
        "b": {
         "type": "object"
        },
        "binding": {
         "type": "object"
        },
        "component": {
         "type": "string"
        },
        "source": {
         "type": "object"
        },
        "variables": {
         "type": "object"
        }
       },
       "required": [
        "component",
        "a",
        "b",
        "variables",
        "source",
        "binding"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "pairing": {
      "type": "string"
     },
     "project_id": {
      "type": "string"
     }
    },
    "required": [
     "project_id",
     "pairing",
     "environment_a",
     "environment_b",
     "paired",
     "only_in_a",
     "only_in_b"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
