{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check a biocide active substance, product type or disinfectant registration"
 },
 "description": "Checks whether a biocidal active substance is approved and for which product types (PT1 to PT22), whether a supplier is on the Article 95 list, whether a biocidal product or disinfectant is authorised, and which EPA-registered disinfectants work against a pathogen. EU coverage: BPR active substance approvals, the Article 95 supplier list, Union authorised biocidal products, BPC opinions and the product type definitions. National: the GB biocides active substances, GB Article 95 list and GB biocidal products register (HSE), the French SIMMBAD inventory and the ANSES biocide decisions register, and the German BAuA register of notified biocidal products. US: EPA List N and the other selected EPA-registered disinfectant lists by pathogen. Canada: Health Canada's archived COVID-19 lists of hard-surface disinfectants and hand sanitizers. Give an active substance or a product name. Not intended for plant protection products or MRLs (`regaffairs_check_pesticide_approval_and_mrl` covers those).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "active_substance": {
    "description": "Active substance name or CAS, e.g. 'permethrin', 'hydrogen peroxide'. Give active_substance or product_name.",
    "type": "string"
   },
   "include_suppliers": {
    "default": false,
    "description": "Add Article 95 supplier entries.",
    "type": "boolean"
   },
   "jurisdictions": {
    "default": [
     "EU",
     "GB"
    ],
    "items": {
     "enum": [
      "EU",
      "GB",
      "FR",
      "DE",
      "US",
      "CA"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "product_name": {
    "description": "Biocidal product or disinfectant name, or an EPA registration number. Give active_substance or product_name.",
    "type": "string"
   },
   "product_type": {
    "description": "e.g. 'PT18' (insecticides), 'PT8' (wood preservatives).",
    "pattern": "^PT([1-9]|1[0-9]|2[0-2])$",
    "type": "string"
   },
   "target_pathogen": {
    "description": "For US disinfectant lists, e.g. 'SARS-CoV-2', 'norovirus', 'C. difficile'.",
    "type": "string"
   }
  },
  "type": "object"
 },
