{
 "description": "Update an SLO. Requires `write` scope. Pass sloId plus at least one field. Changing type/target/window recomputes the error budget.",
 "inputSchema": {
  "properties": {
   "currentValue": {
    "description": "Manually set the current measured value (null clears)",
    "type": "number"
   },
   "dataSource": {
    "description": "New data source (null clears it)",
    "type": "string"
   },
   "name": {
    "description": "New name",
    "type": "string"
   },
   "sloId": {
    "description": "The SLO id to update (required)",
    "type": "string"
   },
   "target": {
    "description": "New target number",
    "type": "number"
   },
   "type": {
    "description": "New SLO type",
    "enum": [
     "availability",
     "latency",
     "errorRate",
     "throughput",
     "custom"
    ],
    "type": "string"
   },
   "unit": {
    "description": "New unit label",
    "type": "string"
   },
   "window": {
    "description": "New window",
    "enum": [
     "rolling7d",
     "rolling30d",
     "rolling90d",
     "calendarMonth",
     "calendarQuarter"
    ],
    "type": "string"
   }
  },
  "required": [
   "sloId"
  ],
  "type": "object"
 },
 "name": "update_slo"
}
