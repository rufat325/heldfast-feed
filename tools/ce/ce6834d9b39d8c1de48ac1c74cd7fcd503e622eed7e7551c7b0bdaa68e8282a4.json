{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Browse discovered agentic resources"
 },
 "description": "Browse the StealthStack ARD index \u2014 agentic resources (agents, MCP servers, skills, catalogs) discovered across the open web. Optionally filter by kind, domain, or trust. Returns a count, a kind breakdown, and the page of resources, each with its connect URL when the publisher provides one; otherwise the inline connection or pull details. Use search_resources for a specific need.",
 "inputSchema": {
  "properties": {
   "domain": {
    "description": "Restrict to one publisher domain (e.g. stealthstack.ai).",
    "type": "string"
   },
   "kind": {
    "description": "Restrict to one resource kind.",
    "enum": [
     "agent",
     "mcp",
     "skill",
     "catalog",
     "registry",
     "api",
     "other"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Max results (1-50).",
    "type": "integer"
   },
   "trust": {
    "description": "Restrict by trust status.",
    "enum": [
     "verified",
     "unverified"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_resources",
 "outputSchema": {
  "properties": {
   "byKind": {
    "additionalProperties": {
     "type": "integer"
    },
    "type": "object"
   },
   "results": {
    "items": {
     "properties": {
      "connect": {
       "description": "How to reach the resource. mode=url: `url`; mode=connections: `connections[]` (stdio \u2192 command/args, http/sse/streamable-http \u2192 url); mode=pull: `pull.command` (e.g. dirctl pull <cid>); mode=data: inline artifact of unrecognised shape (`dataKeys`; `data` itself when small, get_resource only); mode=none: nothing published.",
       "properties": {
        "connections": {
         "items": {
          "properties": {
           "args": {
            "items": {
             "type": "string"
            },
            "type": "array"
           },
           "command": {
            "type": "string"
           },
           "transport": {
            "type": "string"
           },
           "url": {
            "type": "string"
           }
          },
          "required": [
           "transport"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "data": {
         "type": "object"
        },
        "dataKeys": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "mode": {
         "enum": [
          "url",
          "connections",
          "pull",
          "data",
          "none"
         ],
         "type": "string"
        },
        "pull": {
         "properties": {
          "cid": {
           "type": "string"
          },
          "command": {
           "type": "string"
          }
         },
         "required": [
          "command"
         ],
         "type": "object"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "mode"
       ],
       "type": "object"
      },
      "description": {
       "type": "string"
      },
      "displayName": {
       "type": "string"
      },
      "identifier": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "lastSeen": {
       "type": "string"
      },
      "publisher": {
       "description": "URN authority.",
       "type": "string"
      },
      "representativeQueries": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "score": {
       "description": "Relevance as returned by the index /search (search_resources only).",
       "type": "number"
      },
      "source": {
       "properties": {
        "catalogUrl": {
         "type": "string"
        },
        "domain": {
         "type": "string"
        },
        "via": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "trust": {
       "type": "object"
      },
      "type": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "identifier",
      "displayName",
      "kind",
      "type",
      "connect"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "integer"
   }
  },
  "required": [
   "total",
   "results"
  ],
  "type": "object"
 },
 "title": "Browse discovered agentic resources"
}
