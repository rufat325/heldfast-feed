 "description": "Is this merchant safe to depend on? Audits up to ten x402 endpoints in one call and returns a verdict \u2014 ready, partially ready or not ready \u2014 with the specific blockers. Checks each endpoint serves a payable challenge with well-formed terms and a declared input schema, and adds the cross-endpoint check no single probe can make: whether every endpoint pays the same recipient. Never pays anything. Pay 150000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "endpoints": {
    "description": "Up to 10 endpoints. Give a descriptor with the request that endpoint actually needs \u2014 probing a paid API with an empty POST reports it unpayable when it is merely undocumented here.",
    "example": [
     {
      "body": {
       "domain": "stripe.com"
      },
      "method": "POST",
      "url": "https://api.zfinia.com/x402/v1/company-evidence-pack"
     },
     {
      "body": {
       "url": "https://docs.python.org/3/"
      },
      "method": "POST",
      "url": "https://api.zfinia.com/x402/v1/page-markdown"
     }
    ],
    "items": {
     "oneOf": [
      {
       "description": "Endpoint URL. Probed with POST and an empty body, which only suits endpoints that accept one.",
       "maxLength": 2048,
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "body": {
         "description": "The canonical request body this endpoint requires, when it requires one.",
         "type": "object"
        },
        "method": {
         "description": "Defaults to POST.",
         "enum": [
          "GET",
          "POST"
         ],
         "type": "string"
        },
        "url": {
         "maxLength": 2048,
         "type": "string"
        }
       },
       "required": [
        "url"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "expected_pay_to": {
    "description": "Optional. The recipient you expect every endpoint to pay; a difference becomes a blocker.",
    "example": "0x25e8245f07d5e4873987293dad666afbe56a9608",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "required": [
   "endpoints"
  ],
  "type": "object"
 },
