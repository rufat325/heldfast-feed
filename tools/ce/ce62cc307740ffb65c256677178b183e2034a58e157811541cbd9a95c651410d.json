{
 "_meta": {
  "heffl/page": "https://heffl.com/tools/uae-real-estate-tax/calculator"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "UAE property VAT estimate"
 },
 "description": "Estimate VAT on ordinary commercial/residential property in AED, not transfer fees. Residential zero-rating requires FIRST supply within three years of completion; other residential supply exempt. No mixed-use or specialist properties. Free, no authentication required. Rate limited.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "firstSupply": {
    "type": "boolean"
   },
   "includeVat": {
    "default": false,
    "type": "boolean"
   },
   "propertyType": {
    "enum": [
     "commercial",
     "residential"
    ],
    "type": "string"
   },
   "yearsSinceCompletion": {
    "maximum": 1000,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "amount",
   "propertyType",
   "firstSupply",
   "yearsSinceCompletion"
  ],
  "type": "object"
 },
 "name": "uae_real_estate_vat",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "net": {
    "type": "number"
   },
   "total": {
    "type": "number"
   },
   "treatment": {
    "enum": [
     "standard",
     "zero-rated",
     "exempt"
    ],
    "type": "string"
   },
   "vat": {
    "type": "number"
   },
   "vatRate": {
    "type": "number"
   }
  },
  "required": [
   "net",
   "vat",
   "total",
   "vatRate",
   "treatment"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "UAE property VAT estimate"
}
