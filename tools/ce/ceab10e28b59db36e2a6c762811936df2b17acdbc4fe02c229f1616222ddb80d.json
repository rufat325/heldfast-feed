   },
   "idempotency_key": {
    "type": "string"
   },
   "invalid_keypair_name": {
    "type": "boolean"
   },
   "machine": {},
   "mode": {
    "type": "string"
   },
   "needs_keypair": {
    "type": "boolean"
   },
   "needs_keypair_name": {
    "type": "boolean"
   },
   "needs_plan": {
    "type": "boolean"
   },
   "next": {
    "type": "string"
   },
   "plan_tool": {
    "type": "string"
   },
   "request": {},
   "result": {},
