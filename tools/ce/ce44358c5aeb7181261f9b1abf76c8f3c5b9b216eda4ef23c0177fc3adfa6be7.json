{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create or update a prompt in one idempotent step for CI/CD and prompt-as-code flows, unlike create_prompt which always makes a new prompt. Looks up the prompt by name within collection_id: if missing it creates the prompt, if found with different content it adds a new version (nothing is overwritten), and if the content already matches it no-ops; dry_run reports what would happen without changing anything. Stores app/env in template_metadata; get collection_id from list_collections. Returns the action taken (created, updated, or unchanged), dry_run flag, message, prompt id, slug, and version id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "app": {
    "description": "App identifier (REQUIRED). Use your deployed app name, for example 'hourlink' or 'support-console'.",
    "minLength": 1,
    "type": "string"
   },
   "collection_id": {
    "description": "Collection ID to search in and create under",
    "type": "string"
   },
   "dry_run": {
    "description": "When true, only check what action would be taken without making changes",
    "type": "boolean"
   },
   "env": {
    "description": "Environment identifier (REQUIRED). Use your environment name, for example 'dev', 'staging', 'prod', or 'qa'.",
    "minLength": 1,
    "type": "string"
   },
   "functions": {
    "description": "Function definitions",
    "items": {
     "properties": {
      "description": {
       "description": "Function description",
       "type": "string"
      },
      "name": {
       "description": "Function name",
       "type": "string"
      },
      "parameters": {
       "additionalProperties": {},
       "description": "Function parameters schema",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "is_raw_template": {
    "description": "Preserve raw structural-template rendering semantics",
    "type": "boolean"
   },
   "messages": {
    "description": "Structured chat template alias for migrations. Serialized to the legacy string format before the prompt is created or updated.",
    "items": {
     "additionalProperties": {},
     "description": "Structured chat message in a prompt template",
     "properties": {
      "content": {
       "description": "Message content blocks",
       "items": {
        "additionalProperties": {},
        "description": "Content block within a structured chat message",
        "properties": {
         "text": {
          "description": "Text content for text-based blocks",
          "type": "string"
         },
         "type": {
          "description": "Content block type",
          "type": "string"
         }
        },
        "required": [
         "type"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "role": {
       "description": "Message role in the chat template",
       "enum": [
        "system",
        "user",
        "assistant"
       ],
       "type": "string"
      }
     },
     "required": [
      "role",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "model": {
    "description": "Model identifier",
    "type": "string"
   },
   "name": {
    "description": "Prompt name to create or find for update",
    "type": "string"
   },
   "parameters": {
    "additionalProperties": {},
    "description": "Default values for template variables",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "string": {
    "description": "Legacy prompt template string with {{variable}} mustache syntax.",
    "type": "string"
   },
   "template_metadata": {
    "additionalProperties": {},
    "description": "Additional custom metadata",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "tool_choice": {
    "description": "Tool choice strategy",
    "properties": {
     "function_name": {
      "description": "Required when mode is 'function'; ignored otherwise",
      "type": "string"
     },
     "mode": {
      "description": "Tool choice mode: auto lets the model decide, none disables tool use, function forces one function by name",
      "enum": [
       "auto",
       "none",
       "function"
      ],
      "type": "string"
     }
    },
    "required": [
     "mode"
    ],
    "type": "object"
   },
   "tools": {
    "description": "Tool definitions",
    "items": {
     "properties": {
      "function": {
       "description": "Function definition",
       "properties": {
        "description": {
         "description": "Function description",
         "type": "string"
        },
        "name": {
         "description": "Function name",
         "type": "string"
        },
        "parameters": {
         "additionalProperties": {},
         "description": "Function parameters schema",
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "type": {
       "const": "function",
       "description": "Tool type",
       "type": "string"
      }
     },
     "required": [
      "type",
      "function"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "version_description": {
    "description": "Description for this version",
    "type": "string"
   },
   "virtual_key": {
    "description": "Virtual key slug for model access",
    "type": "string"
   }
  },
  "required": [
   "name",
   "app",
   "env",
   "collection_id",
   "parameters",
   "virtual_key"
  ],
  "type": "object"
 },
 "name": "migrate_prompt",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
