{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Convert a variant written in any notation into normalized hg38 genomic coordinates.\n\nUse when you only need the chr/pos/ref/alt of a variant (for example to translate HGVS or an rsID),\nwithout annotation. Does not classify the variant; use annotate_variant for that.\n","inputSchema":{"properties":{"input_genome":{"default":"hg38","description":"Genome build of positional input (hg19 input is lifted to hg38).","enum":["hg19","hg38","t2t"],"title":"Input Genome","type":"string"},"variant":{"description":"HGVS (NM_007294.4:c.3756_3759del), rsID (rs429358), SPDI (NC_000007.14:11324573:C:T), 'chr-pos-ref-alt', or 'GENE p.Thr1700Ile'.","title":"Variant","type":"string"}},"required":["variant"],"title":"convert_variantArguments","type":"object"},"name":"convert_variant","outputSchema":{"$defs":{"VariantCoordinates":{"properties":{"alt":{"title":"Alt","type":"string"},"chr":{"title":"Chr","type":"string"},"genome":{"title":"Genome","type":"string"},"pos":{"description":"1-based VCF position","title":"Pos","type":"integer"},"ref":{"title":"Ref","type":"string"}},"required":["genome","chr","pos","ref","alt"],"title":"VariantCoordinates","type":"object"}},"properties":{"error":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Error"},"input":{"title":"Input","type":"string"},"variants":{"description":"Resolved hg38 coordinates (usually exactly one)","items":{"$ref":"#/$defs/VariantCoordinates"},"title":"Variants","type":"array"}},"required":["input","variants"],"title":"ConvertResult","type":"object"}}
