  "ui/resourceUri": "ui://homejourney/ai-app-services-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Prepare guest service checkout"
 },
 "description": "Use this for new customer bookings from an external agent, whether the customer already has a Homejourney account or not. After the customer confirms the selected provider package, or a Homejourney catalog price (price_source launch_guide with platform_unit_count), the exact price, schedule, address, customer-provided email and mobile number, and contact consent, it returns one branded Homejourney review-and-authorization link. No OTP is required. The customer approves their card for the exact booking without a charge; for a provider package Homejourney charges it only after verified completion, and PayNow can instead be requested after completion. A catalog price takes a card only: nothing is charged until a verified provider accepts, the amount is held then and charged when the job is done, and the booking is cancelled at no charge if no provider accepts. A booking appears in Main after sign-in with the same verified email or WhatsApp number.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "base_price": {
    "minimum": 0,
    "type": "number"
   },
   "catalog_version_id": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "confirmed": {
    "const": true,
    "type": "boolean"
   },
   "consent_text": {
    "maxLength": 300,
    "type": "string"
   },
   "consent_to_contact": {
    "const": true,
    "type": "boolean"
   },
   "customer_info": {
    "additionalProperties": false,
    "properties": {
     "address": {
      "maxLength": 300,
      "minLength": 5,
      "type": "string"
     },
     "delivery_address": {
      "maxLength": 300,
      "minLength": 5,
      "type": "string"
     },
     "delivery_unit_number": {
      "maxLength": 40,
      "type": "string"
     },
     "email": {
      "format": "email",
      "maxLength": 254,
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "minLength": 8,
      "type": "string"
     },
     "pickup_address": {
      "maxLength": 300,
      "minLength": 5,
      "type": "string"
     },
     "pickup_unit_number": {
      "maxLength": 40,
      "type": "string"
     },
     "unit_number": {
      "maxLength": 40,
      "type": "string"
     }
    },
    "required": [
     "name",
     "email",
     "phone"
    ],
    "type": "object"
   },
   "discount_amount": {
    "minimum": 0,
    "type": "number"
   },
   "host": {
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "host_reference_id": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "issue_description": {
    "maxLength": 1000,
    "type": "string"
   },
   "number_of_units": {
    "default": 1,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "platform_unit_count": {
    "description": "The platformUnitCount of a launch_guide search result. Omit provider_id and provider_package_id with it.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "price_source": {
    "enum": [
     "provider_catalog",
     "launch_guide"
    ],
    "type": "string"
   },
   "provider_id": {
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   },
   "provider_package_id": {
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   },
   "scheduled_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "service_details": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "service_frequency": {
    "default": "one-time",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "service_type": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "singapore_time": {
    "description": "Exact customer-selected Singapore start time in 24-hour HH:mm format. Do not send a time range.",
    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
    "type": "string"
   },
   "special_instructions": {
    "maxLength": 1000,
    "type": "string"
   },
   "total_price": {
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "host",
   "idempotency_key",
   "confirmed",
   "service_type",
   "service_details",
   "catalog_version_id",
   "price_source",
   "scheduled_date",
   "singapore_time",
   "customer_info",
   "consent_to_contact"
  ],
  "type": "object"
 },
 "name": "prepare_guest_service_checkout",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "bookingFee": {
      "type": "number"
     },
     "checkoutId": {
      "type": "string"
     },
     "checkoutUrl": {
      "type": "string"
     },
     "collectionMode": {
      "enum": [
       "at_booking",
       "after_acceptance"
      ],
      "type": "string"
     },
     "currency": {
      "enum": [
       "SGD"
      ],
      "type": "string"
     },
     "deduplicated": {
      "type": "boolean"
     },
     "expiresAt": {
      "type": "string"
     },
     "maskedEmail": {
      "type": "string"
     },
     "maskedPhone": {
      "type": "string"
     },
     "packageName": {
      "type": "string"
     },
     "providerId": {
      "type": [
       "string",
       "null"
      ]
     },
     "providerLogoUrl": {
      "type": [
       "string",
       "null"
      ]
     },
     "providerName": {
      "type": [
       "string",
       "null"
      ]
     },
     "providerPackageId": {
      "type": [
       "string",
       "null"
      ]
     },
     "quantity": {
      "type": "number"
     },
     "serviceSubtotal": {
      "type": "number"
     },
     "state": {
      "type": "string"
     },
     "statusToken": {
      "type": "string"
     },
     "totalAmount": {
      "type": "number"
     },
     "unitLabel": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "checkoutId",
     "state",
     "deduplicated",
     "checkoutUrl",
     "statusToken",
     "expiresAt",
     "maskedEmail",
     "maskedPhone",
     "serviceSubtotal",
     "bookingFee",
     "totalAmount",
     "currency",
     "providerId",
     "providerName",
     "providerLogoUrl",
     "providerPackageId",
     "packageName"
    ],
    "type": "object"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Prepare guest service checkout"
}
