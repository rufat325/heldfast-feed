{
 "description": "Fetch the status and output URLs of a run created by a generation tool. Poll this until status is 'completed' or 'failed'.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "run_id": {
    "description": "The run id returned by a generation tool.",
    "type": "string"
   }
  },
  "required": [
   "run_id"
  ],
  "type": "object"
 },
 "name": "get_run",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "error": {
    "type": [
     "string",
     "null"
    ]
   },
   "output": {
    "description": "Output URLs when completed.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "description": "queued | processing | completed | failed",
    "type": "string"
   }
  },
  "required": [
   "status",
   "output"
  ],
  "type": "object"
 }
}
