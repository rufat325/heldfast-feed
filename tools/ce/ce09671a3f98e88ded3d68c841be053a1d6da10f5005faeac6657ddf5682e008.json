{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Run an AudioEye accessibility scan on the currently-open page (or navigate to `url` first). Returns a slim, agent-friendly structured result: a top-level summary, failures grouped by ruleCode and split into `sourceMapped` (with JSX source location) vs `unmapped` (typed by `bucket`: pageShell / nonReactDom / thirdPartyIframe / shadowDom), plus a `metadata` map containing rule descriptions and `sourceFixGuidance` for every rule that failed \u2014 read these directly, do not paraphrase or reformat the response. Pass `persistTo: \".agent/a11y-scan.json\"` (or any workspace path) to have the server write the response to disk for you \u2014 do NOT re-emit the JSON via a Write tool yourself. The response includes `summaryMarkdown` \u2014 the canonical user-facing report. Present it to the user verbatim: never dump the raw JSON, never reformat or rebuild the tables, and never build an HTML page, artifact, or custom UI for scan results unless the user explicitly asks for a different format. When the user asked a pointed question, answer it directly \u2014 but any tabular summary you show must be `summaryMarkdown`, verbatim.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "forceReload": {
    "description": "When true, reload the page before scanning. Default: false \u2014 a matching `url` (or omitted `url`) scans the existing DOM without reloading. Use this only when the `staleMutatedDom` diagnostic told you a prior scan lost source mapping due to DOM mutation, OR when the user explicitly asks for a fresh page state. Do NOT pass this just because the user said \"scan again\" \u2014 that should scan the current state.",
    "type": "boolean"
   },
   "persistTo": {
    "description": "Path to write the scan response to. Workspace-relative paths (e.g. `.agent/a11y-scan.json`) are resolved against the workspace root \u2014 `process.env.AUDIOEYE_MCP_WORKSPACE` when set, otherwise `process.cwd()` (the directory the host launched the MCP from). Absolute paths are accepted only if they fall within that workspace root. Saves the agent from re-emitting 30-40 KB of JSON via a Write tool. Returned as `persistedTo: <absolute-path>` on the response. Recommended: `.agent/a11y-scan.json`.",
    "type": "string"
   },
   "runOptions": {
    "additionalProperties": {},
    "description": "Partial AudioEye SDK RunOptions. Sensible defaults applied.",
    "type": "object"
   },
   "url": {
    "description": "Optional URL to navigate to before scanning. If omitted, scans the current page.",
    "format": "uri",
    "type": "string"
   },
   "waitForReadyMs": {
    "description": "Milliseconds to wait after navigation before scanning, to allow async content to render.",
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "audioeye_scan",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "componentClusters": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "componentKey": {
       "type": "string"
      },
      "componentName": {
       "type": [
        "string",
        "null"
       ]
      },
      "componentTypes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "instanceCount": {
       "minimum": 0,
       "type": "integer"
      },
      "ruleCodes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "sampleSelectors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "selector": {
       "type": "string"
      },
      "source": {
       "anyOf": [
        {
         "$ref": "#/properties/failures/items/properties/sourceMapped/items/properties/source"
        },
        {
         "type": "null"
        }
       ]
      },
      "unmapped": {
       "type": "boolean"
      }
     },
     "required": [
      "componentKey",
      "selector",
      "source",
      "componentName",
      "componentTypes",
      "instanceCount",
      "ruleCodes",
      "sampleSelectors",
      "unmapped"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "currentUrl": {
    "type": "string"
   },
   "failures": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "highConfidenceInstanceCount": {
       "minimum": 0,
       "type": "integer"
      },
      "instanceCount": {
       "type": "number"
      },
      "passthroughInstanceCount": {
       "minimum": 0,
       "type": "integer"
      },
      "ruleCode": {
       "type": "string"
      },
      "sourceMapped": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "componentName": {
          "type": [
           "string",
           "null"
          ]
         },
         "componentType": {
          "type": "string"
         },
         "confidence": {
          "enum": [
           "high",
           "passthrough"
          ],
          "type": "string"
         },
         "cssSelector": {
          "type": "string"
         },
         "outerHTMLHead": {
          "type": "string"
         },
         "passthroughReason": {
          "type": "string"
         },
         "source": {
          "additionalProperties": false,
          "properties": {
           "columnNumber": {
            "type": "number"
           },
           "fileName": {
            "type": "string"
           },
           "lineNumber": {
            "type": "number"
           }
          },
          "required": [
           "fileName",
           "lineNumber"
          ],
          "type": "object"
         }
        },
        "required": [
         "source",
         "componentName",
         "outerHTMLHead"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "unmapped": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "bucket": {
          "enum": [
           "pageShell",
           "nonReactDom",
           "thirdPartyIframe",
           "shadowDom"
          ],
          "type": "string"
         },
         "componentType": {
          "type": "string"
         },
         "cssSelector": {
          "type": "string"
         },
         "cssSelectorTail": {
          "type": "string"
         },
         "outerHTMLHead": {
          "type": "string"
         }
        },
        "required": [
         "cssSelectorTail",
         "bucket",
         "outerHTMLHead"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "unmappedInstanceCount": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "ruleCode",
      "instanceCount",
      "highConfidenceInstanceCount",
      "passthroughInstanceCount",
      "unmappedInstanceCount",
      "sourceMapped",
      "unmapped"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ignore": {
    "additionalProperties": false,
    "properties": {
     "configPath": {
      "type": [
       "string",
       "null"
      ]
     },
     "matchedRules": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "count": {
         "type": "number"
        },
        "rule": {
         "additionalProperties": true,
         "properties": {
          "comment": {
           "type": "string"
          },
          "cssSelector": {
           "type": "string"
          },
          "fileNameContains": {
           "type": "string"
          },
          "fileNamePrefix": {
           "type": "string"
          },
          "ruleCode": {
           "type": "string"
          }
         },
         "type": "object"
        }
       },
       "required": [
        "count",
        "rule"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "totalIgnored": {
      "type": "number"
     }
    },
    "required": [
     "configPath",
     "totalIgnored",
     "matchedRules"
    ],
    "type": "object"
   },
   "metadata": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "autoRemediated": {
       "type": "boolean"
      },
      "classification": {
       "type": "string"
      },
      "componentType": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "doNotPropose": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "reason": {
          "type": "string"
         },
         "reasonCode": {
          "type": "string"
         },
         "when": {
          "type": "string"
         }
        },
        "required": [
         "reasonCode",
         "reason",
         "when"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "fixAtSource": {
       "type": "boolean"
      },
      "issueType": {
       "type": "string"
      },
      "lowFixConfidence": {
       "type": "boolean"
      },
      "ruleCode": {
       "type": "string"
      },
      "severity": {
       "type": "string"
      },
      "sourceFixGuidance": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "wcagCriteria": {
       "type": "string"
      },
      "wcagCriterionName": {
       "type": "string"
      },
      "wcagDocsUrl": {
       "type": "string"
      }
     },
     "required": [
      "ruleCode"
     ],
     "type": "object"
    },
    "type": "object"
   },
   "persistedTo": {
    "type": "string"
   },
   "scannedAt": {
    "type": "string"
   },
   "sourceMappingDiagnostics": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "reason": {
        "enum": [
         "noReactDetected",
         "reactDevTransformMissing",
         "unsupportedReactBuild",
         "bundlerHookFailed",
         "partialCoverage",
         "staleMutatedDom"
        ],
        "type": "string"
       },
       "signals": {
        "additionalProperties": false,
        "properties": {
         "failuresInspected": {
          "minimum": 0,
          "type": "integer"
         },
         "failuresWithSource": {
          "minimum": 0,
          "type": "integer"
         },
         "jsxDevHookCapturedSources": {
          "type": "boolean"
         },
         "jsxDevHookInstalled": {
          "type": "boolean"
         },
         "observedDebugSource": {
          "type": "boolean"
         },
         "observedDebugStack": {
          "type": "boolean"
         },
         "reactDetected": {
          "type": "boolean"
         },
         "reactVersion": {
          "type": "string"
         }
        },
        "required": [
         "reactDetected",
         "observedDebugSource",
         "observedDebugStack",
         "jsxDevHookCapturedSources",
         "jsxDevHookInstalled",
         "failuresInspected",
         "failuresWithSource"
        ],
        "type": "object"
       }
      },
      "required": [
       "reason",
       "message",
       "signals"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "failuresWithSource": {
      "type": "number"
     },
     "failuresWithSourceHighConfidence": {
      "type": "number"
     },
     "isCompacted": {
      "type": "boolean"
     },
     "ruleCodeCounts": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object"
     },
     "totalEnriched": {
      "type": "number"
     },
     "totalFailures": {
      "type": "number"
     }
    },
    "required": [
     "totalEnriched",
     "totalFailures",
     "failuresWithSource",
     "failuresWithSourceHighConfidence",
     "ruleCodeCounts",
     "isCompacted"
    ],
    "type": "object"
   },
   "summaryMarkdown": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "scannedAt",
   "summary",
   "failures",
   "metadata",
   "componentClusters",
   "sourceMappingDiagnostics",
   "currentUrl",
   "ignore"
  ],
  "type": "object"
 }
}
