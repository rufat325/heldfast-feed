{
 "description": "List your media catalog assets (newest first, soft-delete aware).\nFilters AND-combine. The catalog spans every storage tier (seaweedfs/r2/peertube)\nand asset kind (image/video/doc) \u2014 broader than list_files/list_videos, which\nonly see a provisioned bucket. Read-only.",
 "inputSchema": {
  "properties": {
   "folder": {
    "description": "Filter by exact DAM folder path",
    "type": "string"
   },
   "format": {
    "description": "Response format (default json). yaml/md are token-efficient for agents.",
    "enum": [
     "json",
     "yaml",
     "md"
    ],
    "type": "string"
   },
   "kind": {
    "description": "Filter by asset class",
    "enum": [
     "image",
     "video",
     "doc"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Page size 1-500 (default 50)",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset (default 0)",
    "type": "number"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "pending",
     "processing",
     "ready",
     "failed"
    ],
    "type": "string"
   },
   "storage_tier": {
    "description": "Filter by storage tier",
    "enum": [
     "seaweedfs",
     "r2",
     "peertube"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Assets carrying ALL given tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "workspace": {
    "description": "Workspace name",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "catalog_list_assets"
}
