{
 "description": "List invoices from Teamleader Focus with optional filtering and pagination",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "department_id": {
    "description": "Filter by department ID",
    "type": "string"
   },
   "invoice_date_after": {
    "description": "Filter invoices dated after (YYYY-MM-DD)",
    "type": "string"
   },
   "invoice_date_before": {
    "description": "Filter invoices dated before (YYYY-MM-DD)",
    "type": "string"
   },
   "page": {
    "description": "Page number (default: 1)",
    "type": "number"
   },
   "page_size": {
    "description": "Page size (default: 20, max: 100)",
    "type": "number"
   },
   "status": {
    "description": "Filter by status (e.g. ['draft', 'outstanding', 'paid'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "updated_since": {
    "description": "ISO 8601 date - only invoices updated after this date",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "teamleader_list_invoices"
}
