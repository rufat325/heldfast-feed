{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find recorded KnowJudges profile or courtroom-rule changes since an inclusive date, optionally narrowed to the canonical judge_url from find_judges or court_url from find_court. Court filtering includes changes associated with that court and its indexed judge profiles; ambiguous court-only records are omitted. Use to check documented updates; returns at most 25 records. Change tracking begins at the reported launch date, so an empty result does not prove that no earlier real-world rule changed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "court_url": {
    "description": "Optional canonical court_url returned by find_court",
    "format": "uri",
    "type": "string"
   },
   "judge_url": {
    "description": "Optional canonical profile_url returned by find_judges",
    "format": "uri",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "Inclusive date in YYYY-MM-DD format",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   }
  },
  "required": [
   "since"
  ],
  "type": "object"
 },
 "name": "get_recent_rule_changes",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "change_tracking_started_at": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "change_type": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "changed_at": {
       "type": "string"
      },
      "court_url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "judge_url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "source_title": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "source_url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "summary": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "changed_at",
      "judge_url",
      "court_url"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "type": "array"
   },
   "since": {
    "type": "string"
   }
  },
  "required": [
   "since",
   "change_tracking_started_at",
   "results"
  ],
  "type": "object"
 }
}
