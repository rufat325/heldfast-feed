{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Confidence intervals for a mean (t or z) or a proportion (Wald and Wilson) at 80\u201399.9% confidence \u2013 margin of error, critical value and every step shown. Web page: https://calcbright.com/confidence-interval-calculator",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "conf": {
    "default": "95",
    "description": "Confidence level",
    "enum": [
     "80",
     "85",
     "90",
     "95",
     "98",
     "99",
     "99.9"
    ],
    "type": "string"
   },
   "mean": {
    "default": 50,
    "description": "Sample mean (x\u0304)",
    "maximum": 1000000000000,
    "minimum": -1000000000000,
    "type": "number"
   },
   "n": {
    "default": 25,
    "description": "Sample size (n)",
    "maximum": 1000000000,
    "minimum": 1,
    "type": "number"
   },
   "sd": {
    "default": 8,
    "description": "Sample SD (s)",
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "type": {
    "default": "mean-t",
    "description": "Interval for",
    "enum": [
     "mean-t",
     "mean-z",
     "prop"
    ],
    "type": "string"
   },
   "x": {
    "default": 12,
    "description": "Successes (x)",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "confidence_interval_calculator",
 "title": "Confidence Interval Calculator"
}
