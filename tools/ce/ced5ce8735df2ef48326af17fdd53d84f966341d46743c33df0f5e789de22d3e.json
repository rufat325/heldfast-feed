{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search clinical trials market-wide (cross-company). Distinct from get_clinical_trials, which is scoped to a single ticker. Filter by phase, indication, sponsor, status, and date window; sort and paginate the results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dateField": {
    "description": "Date field to filter/sort on",
    "type": "string"
   },
   "from": {
    "description": "Start date (YYYY-MM-DD)",
    "type": "string"
   },
   "indication": {
    "description": "Condition / indication filter",
    "type": "string"
   },
   "limit": {
    "description": "Maximum results to return (1-100, default: 50)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "description": "Offset for pagination (default: 0)",
    "minimum": 0,
    "type": "number"
   },
   "order": {
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "phase": {
    "description": "Trial phase filter (e.g., \"Phase 3\")",
    "type": "string"
   },
   "sort": {
    "description": "Sort field",
    "type": "string"
   },
   "sponsor": {
    "description": "Sponsor name filter",
    "type": "string"
   },
   "status": {
    "description": "Trial status filter",
    "type": "string"
   },
   "to": {
    "description": "End date (YYYY-MM-DD)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_clinical_trials",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "Search Clinical Trials"
}
