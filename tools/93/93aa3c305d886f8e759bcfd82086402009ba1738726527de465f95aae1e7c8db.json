  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Agent manual correction or degraded handoff recovery. note required except cancelled. Owning agent_id required.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_id": {
    "description": "Owning agent id (required for authorization)",
    "type": "string"
   },
   "carrier": {
    "description": "Carrier name when attaching tracking",
    "type": "string"
   },
   "external_checkout_id": {
    "description": "Merchant checkout id to recover degraded handoff polling",
    "type": "string"
   },
   "handoff_endpoint": {
    "description": "Merchant handoff/status endpoint URL for poll recovery",
    "type": "string"
   },
   "note": {
    "description": "Required note except when status=CANCELLED",
    "type": "string"
   },
   "order_id": {
    "description": "Order id to update",
    "type": "string"
   },
   "search_id": {
    "description": "Optional search_id for analytics correlation",
    "type": "string"
   },
   "session_token": {
    "description": "Session token from agent_authenticate \u2014 required whenever agent_id is passed",
    "type": "string"
   },
   "status": {
    "description": "New status, e.g. PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED",
    "type": "string"
   },
   "tracking_id": {
    "description": "Carrier tracking id when recovering handoff",
    "type": "string"
   },
   "tracking_url": {
    "description": "Carrier's public tracking page for tracking_id, when you have it. Never invent one.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "order_id",
   "agent_id",
   "status"
  ],
  "type": "object"
 },
 "name": "order_update_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "agent_status_locked": {
    "type": "boolean"
   },
   "carrier": {
    "type": "string"
   },
   "continue_url": {
    "type": "string"
   },
   "detail": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "external_checkout_id": {
    "type": "string"
   },
   "handoff_endpoint": {
    "type": "string"
   },
   "hint": {
    "type": "string"
   },
   "merchant_observed": {},
   "next": {
    "additionalProperties": false,
    "properties": {
     "args": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        }
       ]
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "tool": {
      "type": "string"
     }
    },
    "required": [
     "tool"
    ],
    "type": "object"
   },
   "order_id": {
    "type": "string"
   },
   "quantity": {
    "type": "number"
   },
   "status": {
    "type": "string"
   },
   "tracking_id": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Update order status"
}
