{
 "description": "Return the cheapest providers in one Top 11 list, sorted by lowest published starting price first. Optional max_price filter.",
 "inputSchema": {
  "properties": {
   "limit": {
    "maximum": 11,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "description": "Optional ceiling in USD/mo.",
    "type": "number"
   },
   "slug": {
    "description": "List slug, e.g. 'fractional-cfo'.",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "cheapest"
}
