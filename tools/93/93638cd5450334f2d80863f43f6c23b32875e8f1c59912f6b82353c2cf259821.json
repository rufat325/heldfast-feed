{
 "_meta": {
  "fastmcp": {
   "tags": []
  }
 },
 "description": "Create a new thought with optional type, color, label, and parent link. Requires npub for credit billing.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "ac_type": {
    "default": 0,
    "description": "Access type (0=Public, 1=Private)",
    "type": "integer"
   },
   "background_color": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Background color in hex format (e.g., \"#0000ff\")"
   },
   "brain_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The ID of the brain (uses active brain if not specified)"
   },
   "dpop_token": {
    "default": "",
    "type": "string"
   },
   "foreground_color": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Foreground color in hex format (e.g., \"#ff0000\")"
   },
   "kind": {
    "default": 1,
    "description": "Kind of thought to create \u2014 1=Normal (default) or 2=Type.\nTags and Events are NOT created via kind (the API rejects those\nvalues); model them as Normal thoughts carrying the appropriate\ntype_id from get_types (e.g. the \"Event\" type).",
    "type": "integer"
   },
   "label": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional label for the thought"
   },
   "name": {
    "description": "The name of the thought",
    "type": "string"
   },
   "npub": {
    "default": "",
    "description": "Required. Your Nostr public key (npub1...) for credit billing.",
    "type": "string"
   },
   "relation": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Relation type if linking (1=Child, 2=Parent, 3=Jump, 4=Sibling)"
   },
   "source_thought_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "ID of the source thought to link from"
   },
   "type_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "ID of the thought type to assign"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "brain_create_thought",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 }
}
