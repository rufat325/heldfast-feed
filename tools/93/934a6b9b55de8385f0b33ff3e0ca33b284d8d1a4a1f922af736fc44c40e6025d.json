{
 "_meta": {
  "openai/outputTemplate": "ui://widget/billsprig-v1.html",
  "openai/toolInvocation/invoked": "PDF ready",
  "openai/toolInvocation/invoking": "Drawing your PDF\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "resourceUri": "ui://widget/billsprig-v1.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants to make, create, generate or send an invoice, bill, quote, estimate or receipt, or asks for an \"invoice PDF\" or \"invoice template filled in\". Calculates line totals, tax, discount and shipping and returns a download link to a print-ready PDF plus the totals. Ask for missing essentials (who it is for and the items with prices) before calling; the seller details are optional.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "currency": {
    "default": "USD",
    "description": "ISO code, e.g. USD, EUR, GBP, CAD, AUD",
    "type": "string"
   },
   "date": {
    "description": "Issue date YYYY-MM-DD (default today)",
    "type": "string"
   },
   "discountPercent": {
    "description": "Discount on the whole document",
    "type": "number"
   },
   "dueDate": {
    "description": "Exact due date YYYY-MM-DD, if given",
    "type": "string"
   },
   "dueInDays": {
    "description": "Payment terms in days (0 = due on receipt). Default 14.",
    "type": "number"
   },
   "from": {
    "additionalProperties": false,
    "description": "The seller (the user's business)",
    "properties": {
     "address": {
      "description": "Street, city, postcode; new lines allowed",
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "taxId": {
      "description": "VAT/GST/tax number, if any",
      "type": "string"
     },
     "website": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "items": {
    "examples": [
     [
      {
       "description": "Web design (hours)",
       "quantity": 12,
       "unitPrice": 85
      }
     ]
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "discountPercent": {
       "type": "number"
      },
      "quantity": {
       "default": 1,
       "type": "number"
      },
      "taxPercent": {
       "description": "Tax/VAT/GST rate for this line, e.g. 8.875",
       "type": "number"
      },
      "unitPrice": {
       "type": "number"
      }
     },
     "required": [
      "description",
      "unitPrice"
     ],
     "type": "object"
    },
    "maxItems": 60,
    "minItems": 1,
    "type": "array"
   },
   "notes": {
    "description": "Thank-you note, bank details or terms",
    "type": "string"
   },
   "number": {
    "description": "Document number, e.g. INV-0042",
    "type": "string"
   },
   "paperSize": {
    "enum": [
     "Letter",
     "A4"
    ],
    "type": "string"
   },
   "paymentLink": {
    "description": "An https payment link to print on the PDF (optional)",
    "type": "string"
   },
   "paymentMethod": {
    "description": "Receipts only: how it was paid",
    "type": "string"
   },
   "shipping": {
    "type": "number"
   },
   "style": {
    "enum": [
     "classic",
     "modern",
     "minimal"
    ],
    "type": "string"
   },
   "taxLabel": {
    "description": "Tax, VAT, GST, Sales tax\u2026",
    "type": "string"
   },
   "to": {
    "additionalProperties": false,
    "description": "The customer",
    "properties": {
     "address": {
      "description": "Street, city, postcode; new lines allowed",
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "taxId": {
      "description": "VAT/GST/tax number, if any",
      "type": "string"
     },
     "website": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "type": {
    "default": "invoice",
    "enum": [
     "invoice",
     "quote",
     "estimate",
     "receipt"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "create_invoice",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Create an invoice, quote or receipt PDF"
}
