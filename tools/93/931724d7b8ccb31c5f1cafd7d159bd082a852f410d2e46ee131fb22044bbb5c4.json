{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Save your own contacts or organizations. Free. Existing contacts are matched and kept, never duplicated.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contacts": {
    "description": "Contacts to save; each needs an email, LinkedIn URL, website or organization ID",
    "items": {
     "properties": {
      "businessName": {
       "type": "string"
      },
      "city": {
       "type": "string"
      },
      "email": {
       "format": "email",
       "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
       "type": "string"
      },
      "industry": {
       "type": "string"
      },
      "linkedin": {
       "type": "string"
      },
      "organizationId": {
       "description": "From /organizations/search",
       "type": "string"
      },
      "personName": {
       "type": "string"
      },
      "phone": {
       "type": "string"
      },
      "position": {
       "type": "string"
      },
      "website": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "contacts"
  ],
  "type": "object"
 },
 "name": "contacts_create",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "saved": {
    "type": "number"
   }
  },
  "required": [
   "saved"
  ],
  "type": "object"
 },
 "title": "Save your own contacts or organizations"
}
