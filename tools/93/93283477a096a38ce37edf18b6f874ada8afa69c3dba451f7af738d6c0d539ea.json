{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find an investor"
 },
 "description": "Use this when the name of an investor, fund, fund family or insider is ambiguous and you need the exact holder first. Give it a name (its words in any order: \"Tim Cook\" finds \"Cook Timothy D\") or an id (cik:0000102909, lei:..., series:S000002848). Returns matching holders with type, country, family, filer number, 6ix holder id and 6ix page; get_holder_holdings also accepts a name directly.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "default": "any",
    "enum": [
     "any",
     "family",
     "institution",
     "fund",
     "person",
     "company"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "find_holder",
 "outputSchema": {
  "properties": {
   "asOf": {
    "description": "When 6ix answered (ISO 8601, UTC)",
    "type": "string"
   },
   "holders": {
    "items": {
     "properties": {
      "country": {
       "type": [
        "string",
        "null"
       ]
      },
      "family": {
       "type": [
        "object",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "ids": {
       "type": "object"
      },
      "name": {
       "type": "string"
      },
      "path": {
       "type": [
        "string",
        "null"
       ]
      },
      "type": {
       "type": "string"
      },
      "url": {
       "description": "The holder's 6ix page",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "holders"
  ],
  "type": "object"
 },
 "title": "Find an investor"
}
