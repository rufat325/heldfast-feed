{
 "description": "Call a unary gRPC method using JSON input. Supports server reflection or local .proto files.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "request metadata headers",
    "type": "object"
   },
   "import_paths": {
    "description": "proto import paths",
    "items": {
     "type": "string"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "method": {
    "description": "full method, for example helloworld.Greeter/SayHello",
    "type": "string"
   },
   "plaintext": {
    "description": "use plaintext HTTP/2 instead of TLS",
    "type": "boolean"
   },
   "proto_files": {
    "description": "paths to .proto files",
    "items": {
     "type": "string"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "request_json": {
    "additionalProperties": true,
    "description": "JSON request body",
    "type": "object"
   },
   "target": {
    "description": "host:port, for example localhost:50051",
    "type": "string"
   },
   "timeout_ms": {
    "description": "timeout in milliseconds",
    "type": "integer"
   },
   "use_reflection": {
    "description": "use gRPC server reflection",
    "type": "boolean"
   }
  },
  "required": [
   "target",
   "method",
   "plaintext",
   "use_reflection"
  ],
  "type": "object"
 },
 "name": "grpc_call",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "response_json": {
    "type": "string"
   }
  },
  "required": [
   "response_json"
  ],
  "type": "object"
 }
}
