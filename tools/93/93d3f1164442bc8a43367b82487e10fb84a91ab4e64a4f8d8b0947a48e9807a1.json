{
 "description": "List WordPress pages",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Published after this ISO8601 date",
    "type": "string"
   },
   "author": {
    "description": "Limit to these author user IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "author_exclude": {
    "description": "Exclude these author user IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "before": {
    "description": "Published before this ISO8601 date",
    "type": "string"
   },
   "exclude": {
    "description": "Exclude these IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "include": {
    "description": "Limit to these IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "menu_order": {
    "description": "Limit to pages with this menu_order",
    "type": "integer"
   },
   "modified_after": {
    "description": "Modified after this ISO8601 date",
    "type": "string"
   },
   "modified_before": {
    "description": "Modified before this ISO8601 date",
    "type": "string"
   },
   "offset": {
    "description": "Skip this many items (overrides page)",
    "type": "integer"
   },
   "order": {
    "default": "asc",
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "orderby": {
    "default": "menu_order",
    "description": "Sort field",
    "enum": [
     "author",
     "date",
     "id",
     "include",
     "modified",
     "parent",
     "relevance",
     "slug",
     "include_slugs",
     "title",
     "menu_order"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "integer"
   },
   "parent": {
    "description": "Limit to children of these page IDs ([0] = top level)",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "parent_exclude": {
    "description": "Exclude children of these page IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "per_page": {
    "default": 20,
    "description": "Pages per request (max 100)",
    "type": "integer"
   },
   "search": {
    "description": "Search term",
    "type": "string"
   },
   "search_columns": {
    "description": "Columns to search (default title, excerpt and content)",
    "items": {
     "enum": [
      "post_title",
      "post_content",
      "post_excerpt"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "search_semantics": {
    "description": "'exact' matches the search term as a whole phrase",
    "enum": [
     "exact"
    ],
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "Limit to these slugs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "description": "Limit to one or more statuses (default publish; 'any' = all except trash/auto-draft)",
    "items": {
     "enum": [
      "publish",
      "future",
      "draft",
      "pending",
      "private",
      "trash",
      "auto-draft",
      "inherit",
      "any"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "wp_list_pages"
}
