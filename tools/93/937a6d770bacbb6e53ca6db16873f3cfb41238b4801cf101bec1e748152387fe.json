{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "DKIM check"
 },
 "description": "Fetches and validates the DKIM public key at <selector>._domainkey.<domain>: parsed tags, key type, key size and warnings such as a revoked or malformed key. The selector is required and cannot be derived from the domain; it appears in a message's DKIM-Signature header (common provider values: google, selector1, default, k1). An unused selector returns found=false. Anonymous, rate-limited per IP.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "domain": {
    "description": "Domain name, e.g. deinkunde.com",
    "minLength": 1,
    "type": "string"
   },
   "selector": {
    "description": "DKIM selector, e.g. google or default",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "domain",
   "selector"
  ],
  "type": "object"
 },
 "name": "dkim_check",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "bits": {
    "type": [
     "number",
     "null"
    ]
   },
   "domain": {
    "type": [
     "string",
     "null"
    ]
   },
   "error": {
    "type": [
     "string",
     "null"
    ]
   },
   "found": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "hasKey": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "keyType": {
    "type": [
     "string",
     "null"
    ]
   },
   "ok": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "record": {
    "type": [
     "string",
     "null"
    ]
   },
   "selector": {
    "type": [
     "string",
     "null"
    ]
   },
   "tags": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "properties": {
        "tag": {
         "type": [
          "string",
          "null"
         ]
        },
        "value": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "warnings": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "title": "DKIM check"
}
