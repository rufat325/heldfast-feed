{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find open jobs at specific companies. Use it for questions like \"jobs at Stripe\", \"is Notion hiring designers?\", \"remote backend jobs at Ramp and Linear\" or \"which Spotify jobs list a salary?\". Pass company names as the user says them, or careers page links, up to 5 at a time. Covers companies whose careers pages run on Greenhouse, Lever, Ashby, Workable or SmartRecruiters; others come back as not_found. Optional filters: keyword, location, remote, department, postedSince, withSalary. Returns each job's title, locations, workplace type, salary when published, posting date, a short summary and the application link.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "companies": {
    "description": "Company names as the user says them (\"Stripe\", \"Hugging Face\"), or careers page links. At most 5.",
    "items": {
     "maxLength": 300,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "department": {
    "description": "Department or team, such as \"Engineering\"",
    "maxLength": 200,
    "type": "string"
   },
   "keyword": {
    "description": "Words that must appear in the job, such as \"designer\" or \"backend\"",
    "maxLength": 200,
    "type": "string"
   },
   "limit": {
    "description": "Most jobs per company (default 10)",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "City, country name or ISO country code, such as \"London\" or \"DE\"",
    "maxLength": 200,
    "type": "string"
   },
   "postedSince": {
    "description": "ISO date; keep jobs posted on or after it",
    "maxLength": 40,
    "pattern": "^\\d{4}-\\d{2}-\\d{2}",
    "type": "string"
   },
   "remote": {
    "description": "true to keep only remote jobs",
    "type": "boolean"
   },
   "withSalary": {
    "description": "true to keep only jobs that publish a salary",
    "type": "boolean"
   }
  },
  "required": [
   "companies"
  ],
  "type": "object"
 },
 "name": "find_company_jobs",
 "outputSchema": {
  "properties": {
   "companies": {
    "items": {
     "properties": {
      "boardUrl": {
       "type": "string"
      },
      "company": {
       "type": "string"
      },
      "jobs": {
       "items": {
        "properties": {
         "applyUrl": {
          "type": "string"
         },
         "department": {
          "type": [
           "string",
           "null"
          ]
         },
         "employmentType": {
          "type": [
           "string",
           "null"
          ]
         },
         "locations": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "postedOn": {
          "type": [
           "string",
           "null"
          ]
         },
         "salary": {
          "properties": {
           "currency": {
            "type": [
             "string",
             "null"
            ]
           },
           "interval": {
            "type": [
             "string",
             "null"
            ]
           },
           "max": {
            "type": [
             "number",
             "null"
            ]
           },
           "min": {
            "type": [
             "number",
             "null"
            ]
           }
          },
          "type": [
           "object",
           "null"
          ]
         },
         "summary": {
          "type": [
           "string",
           "null"
          ]
         },
         "title": {
          "type": "string"
         },
         "workplace": {
          "enum": [
           "remote",
           "hybrid",
           "onsite",
           null
          ],
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "title",
         "locations",
         "applyUrl"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "message": {
       "type": "string"
      },
      "moreAvailable": {
       "type": "boolean"
      },
      "query": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "status": {
       "enum": [
        "ok",
        "not_found",
        "unavailable"
       ],
       "type": "string"
      }
     },
     "required": [
      "query",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "companies"
  ],
  "type": "object"
 },
 "title": "Find company jobs and careers"
}
