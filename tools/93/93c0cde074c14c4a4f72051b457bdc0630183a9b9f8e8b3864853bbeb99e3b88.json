{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get historical prices, aggregates (low/high/average), trend, and data points for a product. On failure, returns a structured error object with fields error.code, error.message, error.http_status, error.retry_recommended, and error.retry_after_seconds.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "product_id": {
    "description": "Public product ID",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "product_id"
  ],
  "type": "object"
 },
 "name": "get_price_history",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "average_price": {
    "type": [
     "number",
     "null"
    ]
   },
   "currency": {
    "type": "string"
   },
   "current_price": {
    "type": [
     "number",
     "null"
    ]
   },
   "data_points": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": "string"
      },
      "price": {
       "type": "number"
      }
     },
     "required": [
      "date",
      "price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "historical_high": {
    "type": [
     "number",
     "null"
    ]
   },
   "historical_low": {
    "type": [
     "number",
     "null"
    ]
   },
   "preview": {
    "type": "boolean"
   },
   "product_id": {
    "type": "string"
   },
   "trend": {
    "enum": [
     "upward",
     "downward",
     "stable",
     "unknown"
    ],
    "type": "string"
   }
  },
  "required": [
   "product_id",
   "currency",
   "data_points"
  ],
  "type": "object"
 },
 "title": "Get price history"
}
