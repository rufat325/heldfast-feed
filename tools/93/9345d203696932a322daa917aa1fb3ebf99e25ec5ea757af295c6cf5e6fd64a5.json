{
 "description": "[OPERATOR] Review an evidence packet. Score it and approve, rework, or reject.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "issues": {
    "description": "Specific issues found",
    "items": {
     "properties": {
      "claim_id": {
       "type": "string"
      },
      "issue": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "critical",
        "major",
        "minor"
       ],
       "type": "string"
      }
     },
     "required": [
      "claim_id",
      "issue",
      "severity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "packet_id": {
    "description": "Evidence packet ID to review",
    "type": "string"
   },
   "rationale": {
    "description": "Why this verdict",
    "type": "string"
   },
   "score": {
    "description": "Quality score 0-100",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "task_id": {
    "description": "Task ID",
    "type": "string"
   },
   "threshold": {
    "default": 70,
    "description": "Minimum passing score",
    "type": "number"
   },
   "verdict": {
    "description": "Your verdict",
    "enum": [
     "approve",
     "rework",
     "reject"
    ],
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "packet_id",
   "verdict",
   "score",
   "rationale"
  ],
  "type": "object"
 },
 "name": "review_evidence"
}
