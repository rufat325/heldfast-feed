{"annotations":{"openWorldHint":false,"readOnlyHint":true,"title":"Run twin experiment"},"description":"Integrate a declared mass-action model with unperturbed controls, scheduled parameter changes, numerical verification, sensitivity bounds and optional observations. Read twin_experiment_guide first. Returns a replay manifest and raw errors, never a disease cure claim. No remote code or learned-model weights are downloaded or executed.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"arms":{"description":"1 to 4 intervention arms: {id, startStep, rateMultipliers {reactionId: 0 to 10}}. A baseline arm is added automatically.","items":{"additionalProperties":false,"properties":{"id":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"},"rateMultipliers":{"additionalProperties":{"maximum":10,"minimum":0,"type":"number"},"propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"},"type":"object"},"startStep":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["id","startStep","rateMultipliers"],"type":"object"},"maxItems":4,"minItems":1,"type":"array"},"dataset":{"additionalProperties":false,"description":"Optional dataset declaration for the observations: {id, citation (https), sha256, kind, split, independentOfModelFit}.","properties":{"citation":{"format":"uri","maxLength":1000,"type":"string"},"id":{"maxLength":500,"minLength":3,"type":"string"},"independentOfModelFit":{"type":"boolean"},"kind":{"enum":["synthetic","experimental"],"type":"string"},"sha256":{"pattern":"^[a-f0-9]{64}$","type":"string"},"split":{"enum":["held-out","training"],"type":"string"}},"required":["id","citation","sha256","kind","split","independentOfModelFit"],"type":"object"},"duration":{"description":"Simulated time span in model.timeUnit, greater than 0 and at most 1000. Example 48.","exclusiveMinimum":0,"maximum":1000,"type":"number"},"model":{"additionalProperties":false,"description":"Mass-action model: {id, version, context, scope, provenance, timeUnit, concentrationUnit, species[{id, initial}], reactions[{id, rate, reactants, products}], conservedPools}. Up to 16 species and 24 reactions. See twin_experiment_guide.","properties":{"concentrationUnit":{"enum":["M","mM","uM","dimensionless"],"type":"string"},"conservedPools":{"default":[],"items":{"additionalProperties":false,"properties":{"id":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"},"weights":{"additionalProperties":{"exclusiveMinimum":0,"maximum":100,"type":"number"},"propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"},"type":"object"}},"required":["id","weights"],"type":"object"},"maxItems":4,"type":"array"},"context":{"maxLength":500,"minLength":3,"type":"string"},"id":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"},"provenance":{"additionalProperties":false,"properties":{"citation":{"format":"uri","maxLength":1000,"type":"string"},"kind":{"enum":["synthetic","literature-derived"],"type":"string"},"note":{"maxLength":500,"minLength":3,"type":"string"}},"required":["kind","citation","note"],"type":"object"},"reactions":{"items":{"additionalProperties":false,"properties":{"id":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"},"products":{"additionalProperties":{"maximum":4,"minimum":1,"type":"integer"},"propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"},"type":"object"},"rate":{"maximum":10000,"minimum":0,"type":"number"},"reactants":{"additionalProperties":{"maximum":4,"minimum":1,"type":"integer"},"propertyNames":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"},"type":"object"}},"required":["id","rate","reactants","products"],"type":"object"},"maxItems":24,"minItems":1,"type":"array"},"scope":{"maxLength":500,"minLength":3,"type":"string"},"species":{"items":{"additionalProperties":false,"properties":{"id":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"},"initial":{"maximum":1000000,"minimum":0,"type":"number"}},"required":["id","initial"],"type":"object"},"maxItems":16,"minItems":1,"type":"array"},"timeUnit":{"enum":["second","minute","hour","week"],"type":"string"},"version":{"maxLength":500,"minLength":3,"type":"string"}},"required":["id","version","context","scope","provenance","timeUnit","concentrationUnit","species","reactions"],"type":"object"},"observations":{"default":[],"description":"Up to 200 measured values {arm, step, species, value} in model.concentrationUnit, compared against the simulation.","items":{"additionalProperties":false,"properties":{"arm":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"},"species":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"},"step":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"value":{"maximum":1000000,"minimum":0,"type":"number"}},"required":["arm","step","species","value"],"type":"object"},"maxItems":200,"type":"array"},"steps":{"default":40,"description":"Number of output time steps, 4 to 100. Default 40.","maximum":100,"minimum":4,"type":"integer"},"uncertainty":{"default":[],"description":"Up to 3 reactions with {reaction, low, high} rate bounds for sensitivity runs.","items":{"additionalProperties":false,"properties":{"high":{"maximum":10000,"minimum":0,"type":"number"},"low":{"maximum":10000,"minimum":0,"type":"number"},"reaction":{"pattern":"^[A-Za-z][A-Za-z0-9_]{0,39}$","type":"string"}},"required":["reaction","low","high"],"type":"object"},"maxItems":3,"type":"array"}},"required":["model","duration","arms"],"type":"object"},"name":"run_twin_experiment"}
