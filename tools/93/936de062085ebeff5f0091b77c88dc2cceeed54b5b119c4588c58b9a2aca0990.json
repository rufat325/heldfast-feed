{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Edgar Full Text Search"
 },
 "description": "Full-text search across all SEC filings via the EDGAR EFTS index. Filter by comma-separated form types and date range. Useful for finding filings that mention specific terms.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "end_date": {
    "description": "Optional ISO date upper bound (YYYY-MM-DD).",
    "type": "string"
   },
   "forms": {
    "description": "Comma-separated form types to filter (e.g. '10-K,10-Q'). Optional.",
    "type": "string"
   },
   "limit": {
    "description": "Maximum rows to return (default 25, max 100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query (e.g. 'cybersecurity incident', 'going concern').",
    "type": "string"
   },
   "start_date": {
    "description": "Optional ISO date lower bound (YYYY-MM-DD).",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "edgar_full_text_search"
}
