{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Calculate KP structural preview"
 },
 "description": "Returns deterministic Nakshatra star, sub, and sub-sub lords, ruling planets, and transparent significator evidence. Explicitly reports KP ayanamsa and Placidus cusps as unavailable until independently validated.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "place"
    ]
   },
   {
    "required": [
     "latitude",
     "longitude",
     "timezone"
    ]
   }
  ],
  "properties": {
   "birthTimeAccuracyMinutes": {
    "default": 5,
    "maximum": 1440,
    "minimum": 0,
    "type": "number"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "te"
    ],
    "type": "string"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "place": {
    "description": "Catalogue query or display label when explicit coordinates are supplied",
    "type": "string"
   },
   "time": {
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "timezone": {
    "description": "Required IANA timezone when explicit coordinates are supplied, for example Asia/Kolkata",
    "type": "string"
   },
   "timezoneOffset": {
    "description": "Optional fallback offset; derived from timezone and the requested local date when omitted",
    "maximum": 14,
    "minimum": -14,
    "type": "number"
   }
  },
  "required": [
   "date",
   "time"
  ],
  "type": "object"
 },
 "name": "calculate_kp",
 "outputSchema": {
  "properties": {
   "cusps": {
    "type": "object"
   },
   "planets": {
    "type": "array"
   },
   "rulingPlanets": {
    "type": "array"
   },
   "safety": {
    "type": "object"
   },
   "schemaVersion": {
    "const": "sahadeva-kp-preview-1"
   },
   "significators": {
    "type": "array"
   },
   "status": {
    "type": "string"
   },
   "zodiac": {
    "type": "object"
   }
  },
  "required": [
   "schemaVersion",
   "status",
   "zodiac",
   "cusps",
   "planets",
   "rulingPlanets",
   "significators",
   "safety"
  ],
  "type": "object"
 },
 "title": "Calculate KP structural preview"
}
