{
 "description": "Create a variation of a variable product. Note: wp-pilot-pro 1.1.0 declares `attributes` as a list and rejects this map with 400 until the plugin declares it as an object",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attributes": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Attribute map, e.g. {\"pa_color\": \"red\", \"size\": \"XL\"} (key: attribute taxonomy or custom attribute name; value: term slug or option; \"\" = any)",
    "type": "object"
   },
   "manage_stock": {
    "description": "Track stock quantity (default false)",
    "type": "boolean"
   },
   "product_id": {
    "description": "Parent product ID",
    "type": "integer"
   },
   "regular_price": {
    "description": "Regular price as decimal string",
    "type": "string"
   },
   "sale_price": {
    "description": "Sale price as decimal string",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "sku": {
    "description": "SKU (must be unique)",
    "type": "string"
   },
   "stock_quantity": {
    "description": "Stock quantity",
    "type": "integer"
   },
   "stock_status": {
    "description": "Stock status (default instock)",
    "enum": [
     "instock",
     "outofstock",
     "onbackorder"
    ],
    "type": "string"
   }
  },
  "required": [
   "site",
   "product_id",
   "attributes"
  ],
  "type": "object"
 },
 "name": "woo_create_variation"
}
