{
 "description": "Generate a Markdown internal-control review report: scope, risks, controls, testing, workpapers, deficiencies and COSO coverage.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "engagementId"
  ],
  "type": "object"
 },
 "name": "generate_report",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "counts": {},
   "markdown": {
    "type": "string"
   }
  },
  "required": [
   "markdown",
   "counts"
  ],
  "type": "object"
 },
 "title": "Generate the review report"
}
