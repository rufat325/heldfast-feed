          },
          "text": {
           "type": "string"
          },
          "timeoutMs": {
           "default": 5000,
           "maximum": 15000,
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "predicate"
         ],
         "type": "object"
        },
        "target": {
         "additionalProperties": false,
         "properties": {
          "description": {
           "maxLength": 1000,
           "minLength": 1,
           "type": "string"
          },
          "identifier": {
           "minLength": 1,
           "type": "string"
          }
         },
         "type": "object"
        }
       },
       "required": [
        "action",
        "target",
        "direction",
        "expect"
