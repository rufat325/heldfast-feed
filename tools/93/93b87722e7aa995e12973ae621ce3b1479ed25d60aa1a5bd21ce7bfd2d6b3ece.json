           "maxLength": 1000,
           "minLength": 1,
           "type": "string"
          },
          "identifier": {
           "minLength": 1,
           "type": "string"
          }
         },
         "type": "object"
        },
        "text": {
         "maxLength": 10000,
         "type": "string"
        }
       },
       "required": [
        "action",
        "target",
        "text",
        "replaceExisting",
        "expect"
