            "focused",
            "textContains",
            "textEquals",
            "checked",
            "unchecked",
            "selected",
            "unselected"
           ],
           "type": "string"
          },
          "text": {
           "type": "string"
          },
          "timeoutMs": {
           "default": 5000,
           "maximum": 15000,
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "predicate"
         ],
         "type": "object"
        }
       },
       "required": [
        "action",
        "expect"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "assert",
         "type": "string"
        },
        "expect": {
         "additionalProperties": false,
         "properties": {
          "identifier": {
           "minLength": 1,
           "type": "string"
          },
          "label": {
           "minLength": 1,
           "type": "string"
          },
          "predicate": {
           "enum": [
            "exists",
            "gone",
            "enabled",
            "focused",
            "textContains",
            "textEquals",
            "checked",
            "unchecked",
            "selected",
            "unselected"
           ],
           "type": "string"
          },
          "text": {
           "type": "string"
          },
          "timeoutMs": {
           "default": 5000,
           "maximum": 15000,
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "predicate"
         ],
         "type": "object"
        }
       },
       "required": [
        "action",
        "expect"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "timeoutMs": {
    "default": 60000,
    "maximum": 60000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "steps"
  ],
  "type": "object"
 },
 "name": "jevsim_run_steps"
}
