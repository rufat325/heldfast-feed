{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Execute up to 10 caller-planned tap/type/scroll/wait/assert steps within 60 seconds. Every action needs a deterministic expected outcome. Reserve the simulator or Android device for this call; do not use another UI tool concurrently. Returns partial progress and stops on ambiguity or failure. Never automatically replay uncertain actions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
