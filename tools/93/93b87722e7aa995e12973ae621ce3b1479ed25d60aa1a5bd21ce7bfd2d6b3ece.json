           "minLength": 1,
           "type": "string"
          },
          "label": {
           "minLength": 1,
           "type": "string"
          },
          "predicate": {
           "enum": [
            "exists",
            "gone",
            "enabled",
            "focused",
            "textContains",
            "textEquals",
            "checked",
            "unchecked",
            "selected",
            "unselected"
           ],
           "type": "string"
          },
          "text": {
           "type": "string"
          },
          "timeoutMs": {
           "default": 5000,
           "maximum": 15000,
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "predicate"
         ],
         "type": "object"
        },
        "target": {
         "additionalProperties": false,
         "properties": {
          "description": {
           "maxLength": 1000,
           "minLength": 1,
           "type": "string"
          },
          "identifier": {
           "minLength": 1,
           "type": "string"
          }
         },
         "type": "object"
        }
       },
       "required": [
        "action",
        "target",
        "expect"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "const": "type",
         "type": "string"
        },
        "expect": {
         "additionalProperties": false,
         "properties": {
          "identifier": {
           "minLength": 1,
           "type": "string"
          },
          "label": {
           "minLength": 1,
           "type": "string"
          },
          "predicate": {
           "enum": [
            "exists",
            "gone",
            "enabled",
            "focused",
            "textContains",
            "textEquals",
            "checked",
            "unchecked",
            "selected",
            "unselected"
           ],
           "type": "string"
          },
          "text": {
           "type": "string"
          },
          "timeoutMs": {
           "default": 5000,
           "maximum": 15000,
           "minimum": 0,
           "type": "integer"
          }
