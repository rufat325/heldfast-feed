    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9._:\\-]+$",
    "type": "string"
   },
   "freshness": {
    "default": "screen",
    "enum": [
     "screen",
     "target"
    ],
    "type": "string"
   },
   "minProbability": {
    "default": 0.9,
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "platform": {
    "default": "ios",
    "enum": [
     "ios",
     "android"
    ],
    "type": "string"
   },
   "simulatorId": {
    "format": "uuid",
