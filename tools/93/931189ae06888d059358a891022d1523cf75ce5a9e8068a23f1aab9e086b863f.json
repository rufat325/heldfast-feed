{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Organize user-provided notes into a transparent report outline without adding facts, citations, or conclusions that were not supplied.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "default": "Personal use",
    "description": "Intended audience.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "description": "Source notes to organize without inventing facts.",
    "items": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 30,
    "minItems": 1,
    "type": "array"
   },
   "purpose": {
    "description": "The report purpose or question it should answer.",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "reportType": {
    "default": "general",
    "description": "Report structure to use.",
    "enum": [
     "decision-record",
     "reflection-summary",
     "action-plan",
     "general"
    ],
    "type": "string"
   },
   "title": {
    "description": "Title for the digital report.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "purpose",
   "notes"
  ],
  "type": "object"
 },
 "name": "prepare_digital_report",
 "title": "Prepare a Digital Report Outline"
}
