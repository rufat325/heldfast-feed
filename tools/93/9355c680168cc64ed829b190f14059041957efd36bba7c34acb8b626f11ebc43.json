  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "utilpeek: build an .ics calendar file from 1-50 events given as JSON"
 },
 "description": "utilpeek: Build an iCalendar file from JSON events. To read an .ics file use parse_ics. Returns RFC 5545 VCALENDAR text built from 1-50 events, CRLF lines folded at 75 octets and text escaped, with its base64, a data: URI and the uids. Input: `events`, optional `calendar_name`, default `timezone` and `time_format`. Pure computation: no network access, nothing stored. A zoned start is written as TZID=<IANA name> with no VTIMEZONE block; an offset becomes UTC; a plain local time stays floating. All-day `end` is the last day, inclusive. A bad time zone, date, rrule, email or url, or both `end` and `duration`, is a 422 naming the event (not charged). Typically under 0.1 s. Price: USD 0.001. Free: 10 utilpeek calls per IP per UTC day. Docs: https://tanod.dev/learn/ics-calendar-api.html",
 "inputSchema": {
  "$defs": {
   "IcsEvent": {
    "additionalProperties": false,
    "properties": {
     "all_day": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "All-day event. Implied when `start` is a plain date.",
      "title": "All Day"
     },
     "attendees": {
      "anyOf": [
       {
        "items": {
         "anyOf": [
          {
           "$ref": "#/$defs/Person"
          },
          {
           "type": "string"
          }
         ]
        },
        "maxItems": 100,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Emails or {email, name (CN), rsvp (ask for a reply)}.",
      "title": "Attendees"
     },
     "description": {
      "anyOf": [
       {
        "maxLength": 8000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Description"
     },
     "duration": {
      "anyOf": [
       {
        "maxLength": 30,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "ISO 8601 duration such as PT1H30M or P2D (instead of end).",
      "title": "Duration"
     },
     "end": {
      "anyOf": [
       {
        "maxLength": 40,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "ISO 8601 end. All-day: the last day, inclusive. Send this or `duration`.",
      "title": "End"
     },
     "location": {
      "anyOf": [
       {
        "maxLength": 1000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Location"
     },
     "organizer": {
      "anyOf": [
       {
        "$ref": "#/$defs/Person"
       },
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Organizer email, or {email, name (CN)}.",
      "title": "Organizer"
     },
     "rrule": {
      "anyOf": [
       {
        "maxLength": 500,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "RFC 5545 recurrence rule, e.g. FREQ=WEEKLY;BYDAY=MO;COUNT=10.",
      "title": "Rrule"
     },
     "start": {
      "description": "ISO 8601 date (all-day) or datetime; without an offset or Z it is read in `timezone`.",
      "maxLength": 40,
      "minLength": 10,
      "title": "Start",
      "type": "string"
     },
     "status": {
      "anyOf": [
       {
        "pattern": "^(?i:CONFIRMED|TENTATIVE|CANCELLED)$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Status"
     },
     "summary": {
      "description": "Event title.",
      "maxLength": 500,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
     },
     "timezone": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "IANA time zone, such as Europe/Berlin.",
      "title": "Timezone"
     },
     "uid": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Stable event id; derived from the content when omitted.",
      "title": "Uid"
     },
     "url": {
      "anyOf": [
       {
        "maxLength": 2000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Url"
     }
    },
    "required": [
     "summary",
     "start"
    ],
    "title": "IcsEvent",
    "type": "object"
   },
   "Person": {
    "additionalProperties": false,
    "properties": {
     "email": {
      "maxLength": 320,
      "title": "Email",
      "type": "string"
     },
     "name": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Name"
     },
     "rsvp": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Rsvp"
     }
    },
    "required": [
     "email"
    ],
    "title": "Person",
    "type": "object"
   }
  },
  "properties": {
   "calendar_name": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Calendar name (X-WR-CALNAME).",
    "title": "Calendar Name"
   },
   "events": {
    "description": "1-50 events.",
    "items": {
     "$ref": "#/$defs/IcsEvent"
    },
    "maxItems": 50,
    "minItems": 1,
    "title": "Events",
    "type": "array"
   },
   "time_format": {
    "default": "tzid",
    "description": "tzid (default): zoned times as TZID=...; utc: all times in UTC.",
    "pattern": "^(tzid|utc)$",
    "title": "Time Format",
    "type": "string"
   },
   "timezone": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Default IANA time zone for events without one.",
    "title": "Timezone"
   }
  },
  "required": [
   "events"
  ],
  "title": "build_ics_eventArguments",
  "type": "object"
 },
