ed":["slug","name","sentence","page_url","provider","group","kind","api_status","signup","auth","price_tier","free_tier","ways_in","also_through","docs_url","pricing_url","site_url","local","live","web_api","update_frequency","terms","ranking","ranking_source","no_safe_way","safer_routes","checked_on","capabilities"],"type":"object"},"type":"array"}},"required":["tools","missing"],"type":"object"},"title":"Get tool records"}
