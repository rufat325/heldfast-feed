{
 "_meta": {
  "openai/outputTemplate": "ui://wapiworld/instance-health-v1.html",
  "openai/toolInvocation/invoked": "Wapiworld instance ready.",
  "openai/toolInvocation/invoking": "Loading Wapiworld instance\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "wapiworld:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://wapiworld/instance-health-v1.html"
  },
  "ui/resourceUri": "ui://wapiworld/instance-health-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get WhatsApp number details"
 },
 "description": "Use this when someone asks about one connected WhatsApp number, such as its phone number, account name or connection health. Returns the instance's name, account name, phone number, project, status and health, or not-found. Not for message history, which this connector does not read.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "instanceId": {
    "description": "Instance id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "instanceId"
  ],
  "type": "object"
 },
 "name": "get_instance",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "instance": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "accountName": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "health": {
        "enum": [
         "ready",
         "pairing",
         "starting",
         "offline",
         "unknown"
        ],
        "type": "string"
       },
       "id": {
        "pattern": "^[0-9a-f]{24}$",
        "type": "string"
       },
       "lastEditTime": {
        "$ref": "#/properties/instance/anyOf/0/properties/creationTime"
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       },
       "phone": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "projectId": {
        "anyOf": [
         {
          "pattern": "^[0-9a-f]{24}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "status": {
        "anyOf": [
         {
          "enum": [
           "starting",
           "qrcode",
           "ready",
           "logged_out",
           "not_connected",
           "disconnected",
           "offline",
           "STARTING",
           "QRCODE",
           "READY"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "accountName",
       "status",
       "health",
       "phone",
       "projectId",
       "creationTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Null when not found. QR pairing codes, instance secrets, API keys, proxy addresses, organization ids and arbitrary stored metadata are never returned."
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "instance"
  ],
  "type": "object"
 },
 "title": "Get WhatsApp number details"
}
