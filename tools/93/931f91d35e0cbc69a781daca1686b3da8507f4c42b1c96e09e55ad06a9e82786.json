{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Cross-section as of a date"
 },
 "description": "Get one measure for up to 50 companies as filed by a date: each one's latest period, its value then, and whether it was later restated. For point-in-time peer and factor work.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "as_of": {
    "description": "Only filings on or before it count.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "companies": {
    "description": "Tickers, CIKs or names.",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "concept": {
    "description": "Plain name (revenue, eps_diluted, assets; follows tag changes) or XBRL tag (Revenues).",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "periods": {
    "description": "annual (default) or quarterly.",
    "enum": [
     "annual",
     "quarterly"
    ],
    "type": "string"
   }
  },
  "required": [
   "companies",
   "concept",
   "as_of"
  ],
  "type": "object"
 },
 "name": "cross_section",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "description": "rows: one per company found, in the order asked, in the order of columns; missing names the others and why.",
  "properties": {
   "as_of": {
    "type": "string"
   },
   "columns": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "companies": {
    "type": "number"
   },
   "concept": {
    "type": "string"
   },
   "limits": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "meaning": {
    "type": "string"
   },
   "missing": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "next_offset": {
    "type": "number"
   },
   "rows": {
    "items": {},
    "type": "array"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "title": "Cross-section as of a date"
}
