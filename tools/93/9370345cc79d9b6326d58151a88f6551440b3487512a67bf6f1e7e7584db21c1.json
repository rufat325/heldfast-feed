{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Set the same category, brand, location, store, condition, list, or warranty date on up to 50 of your items. Every item must be yours or nothing is changed. The first call describes the edit and returns a confirm token. A second call with that token applies it.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"confirm_token":{"description":"Confirm token from the previous call. Without it, nothing is changed.","maxLength":20000,"minLength":1,"type":"string"},"fields":{"additionalProperties":false,"properties":{"brand":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}]},"category":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}]},"condition":{"anyOf":[{"enum":["mint","excellent","good","fair","poor"],"type":"string"},{"type":"null"}]},"list_type":{"enum":["inventory","wishlist","lent","borrowed","archived"],"type":"string"},"location":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}]},"purchased_from":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}]},"warranty_expires_at":{"anyOf":[{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},{"type":"null"}]}},"type":"object"},"item_ids":{"items":{"maxLength":64,"minLength":1,"type":"string"},"maxItems":50,"minItems":1,"type":"array"}},"required":["item_ids","fields"],"type":"object"},"name":"bulk_edit_items","title":"Edit items in bulk"}
