{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search CI/CD pipeline events (builds, deploys) with query filtering",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "from": {
    "description": "Start time (ISO 8601 or relative). Example: 2026-03-01T00:00:00Z or now-24h",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max results (default 50, max 1000)",
    "type": "number"
   },
   "query": {
    "default": "*",
    "description": "CI pipeline search query. Example: @ci.pipeline.name:deploy @ci.status:error",
    "type": "string"
   },
   "sort": {
    "default": "-timestamp",
    "description": "Sort order",
    "enum": [
     "timestamp",
     "-timestamp"
    ],
    "type": "string"
   },
   "to": {
    "description": "End time (ISO 8601 or relative). Example: 2026-03-02T00:00:00Z or now",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "search-ci-pipelines"
}
