{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Turn supplied factual news content into a publish-ready short-form news video without independently researching or fabricating current events. When: Use when an agent already has a verified headline, summary, facts and source URLs and needs a short news video. Selection: specialized; prefer for Use when an agent already has a verified headline, summary, facts and source URLs and needs a short news video.. Minimum required input: headline, summary, facts, sourceUrls, language, durationSeconds, aspectRatio, voice, subtitles, backgroundMusic. Price: $1.50 USD per call. A free preview is available through preview_capability before payment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "aspectRatio": {
    "default": "9:16",
    "enum": [
     "9:16",
     "16:9",
     "1:1"
    ],
    "type": "string"
   },
   "backgroundMusic": {
    "default": true,
    "type": "boolean"
   },
   "durationSeconds": {
    "default": 30,
    "maximum": 120,
    "minimum": 5,
    "type": "integer"
   },
   "facts": {
    "items": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "headline": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "default": "en",
    "maxLength": 32,
    "minLength": 2,
    "type": "string"
   },
   "sourceUrls": {
    "items": {
     "format": "uri",
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "subtitles": {
    "default": true,
    "type": "boolean"
   },
   "summary": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "voice": {
    "default": "auto",
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "headline",
   "summary",
   "facts",
   "sourceUrls"
  ],
  "type": "object"
 },
 "name": "news_video_generate",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "assets": {
    "additionalProperties": false,
    "properties": {
     "audioUrl": {
      "anyOf": [
       {
        "format": "uri",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "materialUrls": {
      "items": {
       "format": "uri",
       "type": "string"
      },
      "type": "array"
     },
     "subtitleUrl": {
      "anyOf": [
       {
        "format": "uri",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "audioUrl",
     "subtitleUrl",
     "materialUrls"
    ],
    "type": "object"
   },
   "billing": {
    "additionalProperties": false,
    "properties": {
     "priceUsd": {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    },
    "required": [
     "priceUsd"
    ],
    "type": "object"
   },
   "capability": {
    "type": "string"
   },
   "content": {
    "additionalProperties": false,
    "properties": {
     "language": {
      "type": "string"
     },
     "script": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "script",
     "language"
    ],
    "type": "object"
   },
   "engine": {
    "additionalProperties": false,
    "properties": {
     "provider": {
      "const": "MoneyPrinterTurbo",
      "type": "string"
     },
     "upstreamTaskId": {
      "type": "string"
     }
    },
    "required": [
     "provider",
     "upstreamTaskId"
    ],
    "type": "object"
   },
   "generatedAt": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": false,
    "properties": {
     "sourceUrls": {
      "items": {
       "format": "uri",
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "sourceUrls"
    ],
    "type": "object"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "task": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "status": {
      "enum": [
       "processing",
       "completed"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "status"
    ],
    "type": "object"
   },
   "video": {
    "additionalProperties": false,
    "properties": {
     "aspectRatio": {
      "enum": [
       "9:16",
       "16:9",
       "1:1"
      ],
      "type": "string"
     },
     "durationSeconds": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "resolution": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "url",
     "durationSeconds",
     "aspectRatio",
     "resolution"
    ],
    "type": "object"
   }
  },
  "required": [
   "success",
   "capability",
   "task",
   "video",
   "content",
   "assets",
   "engine",
   "billing",
   "generatedAt"
  ],
  "type": "object"
 }
