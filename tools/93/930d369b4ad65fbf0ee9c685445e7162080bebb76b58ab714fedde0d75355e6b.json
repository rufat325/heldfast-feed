{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Suggest Etsy Keywords"
 },
 "description": "Use this when the user wants Etsy keyword ideas for a product or listing. Returns ranked autosuggest phrases with relative demand and placement guidance; never fabricates search volumes. Uses one generation from the monthly quota.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Current Etsy listing description",
    "maxLength": 20000,
    "type": "string"
   },
   "product_name": {
    "description": "Short product description, e.g. \"handmade ceramic coffee mug, speckled glaze, 12oz\"",
    "maxLength": 300,
    "minLength": 2,
    "type": "string"
   },
   "seed": {
    "description": "Seed phrase to expand",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "tags": {
    "description": "Current Etsy tags",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "title": {
    "description": "Current Etsy listing title",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "seerxo_suggest_keywords",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confidence": {
    "description": "Confidence in the available suggestions.",
    "enum": [
     "medium",
     "low"
    ],
    "type": "string"
   },
   "keywords": {
    "description": "Keyword suggestions in Etsy autosuggest demand order.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "demandRank": {
       "description": "Relative rank from Etsy autosuggest.",
       "type": "number"
      },
      "inListing": {
       "description": "Whether the listing already contains the keyword.",
       "type": "boolean"
      },
      "keyword": {
       "description": "Suggested keyword phrase.",
       "type": "string"
      },
      "placement": {
       "description": "Recommended listing placement.",
       "enum": [
        "title",
        "tags",
        "description"
       ],
       "type": "string"
      }
     },
     "required": [
      "keyword",
      "demandRank",
      "placement",
      "inListing"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "seed": {
    "description": "Normalized seed phrase used for suggestions.",
    "type": "string"
   },
   "source": {
    "description": "Source used for keyword suggestions.",
    "type": "string"
   },
   "usage": {
    "additionalProperties": false,
    "properties": {
     "dailyLimit": {
      "description": "Daily generation limit when one applies.",
      "type": "number"
     },
     "dailyRemaining": {
      "description": "Generations remaining today when a daily limit applies.",
      "type": "number"
     },
     "limit": {
      "description": "Monthly generation limit.",
      "type": "number"
     },
     "remaining": {
      "description": "Generations remaining this month.",
      "type": "number"
     },
     "tier": {
      "description": "Seerxo account tier.",
      "type": "string"
     },
     "usageByChannel": {
      "additionalProperties": false,
      "properties": {
       "mcp": {
        "description": "Generations used through MCP.",
        "type": "number"
       },
       "web": {
        "description": "Generations used through the web app.",
        "type": "number"
       }
      },
      "required": [
       "mcp",
       "web"
      ],
      "type": "object"
     }
    },
    "required": [
     "limit",
     "remaining",
     "tier",
     "usageByChannel"
    ],
    "type": "object"
   }
  },
  "required": [
   "seed",
   "confidence",
   "keywords",
   "source",
   "usage"
  ],
  "type": "object"
 },
 "title": "Suggest Etsy keywords"
}
