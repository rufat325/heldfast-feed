{
 "_meta": {
  "openai/annotationJustification": "Sends product feedback from the agent session to improve the MCP surface.",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Send feedback"
 },
 "description": "Optional mid-session feedback (required feedback rides with publish_site).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "missing_tool | blocking_error | extra_round_trips | confusing_response | workaround | other",
    "enum": [
     "missing_tool",
     "blocking_error",
     "extra_round_trips",
     "confusing_response",
     "workaround",
     "other"
    ],
    "type": "string"
   },
   "context": {
    "description": "One sentence: why you are calling this tool and what you are trying to accomplish. Stored on the site's activity log and visible to everyone on the site \u2014 never put secrets or personal data here.",
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "$ref": "#/properties/category"
      },
      "description": {
       "type": "string"
      },
      "impactPercent": {
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      },
      "operationId": {
       "type": "string"
      },
      "suggestedImprovement": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "category",
      "impactPercent",
      "title"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "guestToken": {
    "description": "Guest token from start_site. Send it on every call until claim_site. Omit when this chat is already signed in to Dotsy.",
    "minLength": 20,
    "type": "string"
   },
   "impactPercent": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "site": {
    "description": "Site slug, e.g. acme-studio",
    "type": "string"
   },
   "suggestedImprovement": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "site",
   "category",
   "impactPercent",
   "title",
   "context"
  ],
  "type": "object"
 },
 "name": "submit_feedback"
}
