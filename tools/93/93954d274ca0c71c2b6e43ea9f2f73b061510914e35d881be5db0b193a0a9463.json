  "title": "Stop tracking a keyword"
 },
 "description": "Use this when someone asks to stop tracking one of their keywords. Returns deleted, or not-found for an unknown id or one outside the account. Weekly rank checks stop and past snapshots stay, leaving a gap if it is tracked again later. Not for pausing tracking temporarily.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Keyword id",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "delete_keyword",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "keywordId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "enum": [
     "deleted",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
