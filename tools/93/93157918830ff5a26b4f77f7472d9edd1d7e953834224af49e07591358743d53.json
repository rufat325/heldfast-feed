{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List the tools of this server with prices, data sources, licensing, daily limits and data freshness.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "catalog",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "daily_limits": {
    "additionalProperties": {},
    "description": "Daily limits of paid calls (calls, usd, timezone) or a misconfiguration notice.",
    "properties": {},
    "type": "object"
   },
   "fetch_status_values": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "legal": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "paused": {
    "additionalProperties": {
     "type": "boolean"
    },
    "description": "Operator pause flags (true = paused).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "payment": {
    "additionalProperties": {},
    "properties": {
     "asset": {
      "type": "string"
     },
     "enabled": {
      "type": "boolean"
     },
     "network": {
      "type": "string"
     },
     "protocol": {
      "type": "string"
     }
    },
    "required": [
     "protocol",
     "network",
     "asset",
     "enabled"
    ],
    "type": "object"
   },
   "provenance": {
    "description": "Freshness receipts for every upstream source used.",
    "items": {
     "additionalProperties": {},
     "description": "Freshness receipt for one upstream source.",
     "properties": {
      "content_sha256": {
       "type": [
        "string",
        "null"
       ]
      },
      "fetch_status": {
       "description": "found / empty / stale / unavailable / unsupported (see catalog fetch_status_values).",
       "enum": [
        "found",
        "empty",
        "stale",
        "unavailable",
        "unsupported"
       ],
       "type": "string"
      },
      "parser_version": {
       "type": "string"
      },
      "processed_by": {
       "type": "string"
      },
      "retrieved_at": {
       "description": "When this service retrieved the upstream data (null if unknown).",
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "additionalProperties": {},
       "description": "Publisher and URL of the upstream document or dataset.",
       "properties": {
        "publisher": {
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "publisher",
        "url"
       ],
       "type": "object"
      },
      "upstream_updated_at": {
       "description": "Update time stated by the upstream, or null when it states none.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "source",
      "upstream_updated_at",
      "retrieved_at",
      "content_sha256",
      "parser_version",
      "fetch_status",
      "processed_by"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "server": {
    "additionalProperties": {},
    "properties": {
     "name": {
      "type": "string"
     },
     "stage": {
      "type": "string"
     },
     "version": {
