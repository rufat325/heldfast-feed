     "version",
     "stage"
    ],
    "type": "object"
   },
   "terms": {
    "description": "URL of the terms of service.",
    "type": "string"
   },
   "tools": {
    "description": "Every tool of this server with its price.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
