      }
     },
     "required": [
      "name",
      "price_usd",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "server",
   "payment",
   "daily_limits",
   "paused",
   "tools",
   "legal",
   "terms"
  ],
  "type": "object"
