{"_meta":{"openai/toolInvocation/invoked":"\u0413\u043e\u0442\u043e\u0432\u043e","openai/toolInvocation/invoking":"\u0420\u0435\u0454\u0441\u0442\u0440\u0443\u044e \u043d\u0430 \u043f\u043e\u0434\u0456\u044e","securitySchemes":[{"scopes":["events:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"\u0420\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u044f \u043d\u0430 \u043f\u043e\u0434\u0456\u044e"},"description":"\u0420\u0435\u0454\u0441\u0442\u0440\u0443\u0454 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u043d\u0430 \u043f\u043e\u0434\u0456\u044e AOA. \u0412\u0438\u043a\u043b\u0438\u043a\u0430\u0439, \u043a\u043e\u043b\u0438 \u043b\u044e\u0434\u0438\u043d\u0430 \u043f\u0440\u044f\u043c\u043e \u043f\u043e\u043f\u0440\u043e\u0441\u0438\u043b\u0430 \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u0438 \u0457\u0457 \u043d\u0430 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0443 \u043f\u043e\u0434\u0456\u044e \u0456 event_id \u0432\u0456\u0434\u043e\u043c\u0438\u0439. \u0414\u043b\u044f \u0431\u0435\u0437\u043a\u043e\u0448\u0442\u043e\u0432\u043d\u0438\u0445 \u043f\u043e\u0434\u0456\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0443\u0454 \u0440\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u044e \u043e\u0434\u0440\u0430\u0437\u0443 (status registered), \u0434\u043b\u044f \u043f\u043b\u0430\u0442\u043d\u0438\u0445 \u0440\u0435\u0437\u0435\u0440\u0432\u0443\u0454 \u043a\u0432\u0438\u0442\u043e\u043a \u0456 \u043f\u043e\u0432\u0435\u0440\u0442\u0430\u0454 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u043d\u0430 \u043e\u043f\u043b\u0430\u0442\u0443 (payment_required). \u041f\u043e\u0442\u0440\u0435\u0431\u0443\u0454 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043e\u0433\u043e \u0430\u043a\u0430\u0443\u043d\u0442\u0430 AOA. \u041f\u043e\u0434\u0456\u0457 \u0437 \u0432\u0438\u0431\u043e\u0440\u043e\u043c \u043c\u0456\u0441\u0446\u044f, \u0432\u0456\u043a\u043e\u0432\u043e\u044e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u043e\u044e \u0447\u0438 \u0440\u0443\u0447\u043d\u0438\u043c \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f\u043c \u043e\u0444\u043e\u0440\u043c\u043b\u044e\u044e\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u043d\u0430 \u0441\u0430\u0439\u0442\u0456 - \u0442\u0443\u043b \u043f\u043e\u0432\u0435\u0440\u043d\u0435 \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f (handoff). \u041d\u0435 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0439, \u0449\u043e\u0431 \u0434\u0456\u0437\u043d\u0430\u0442\u0438\u0441\u044f \u0446\u0456\u043d\u0443 \u0447\u0438 \u0434\u0435\u0442\u0430\u043b\u0456: \u0446\u0435 get_event.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"event_id":{"description":"event_id \u0437 search_events \u0430\u0431\u043e get_event: \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u043a\u043e\u0434 \u043f\u043e\u0434\u0456\u0457, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 \"k7Qx2a\", \u0430\u0431\u043e \u043f\u043e\u0432\u043d\u0438\u0439 id","minLength":1,"type":"string"},"quantity":{"description":"\u041a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u043a\u0432\u0438\u0442\u043a\u0456\u0432, \u0446\u0456\u043b\u0435 1-10, \u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c 1","maximum":10,"minimum":1,"type":"integer"},"ticket_type_id":{"description":"id \u0442\u0438\u043f\u0443 \u043a\u0432\u0438\u0442\u043a\u0430, \u043a\u043e\u043b\u0438 \u0457\u0445 \u043a\u0456\u043b\u044c\u043a\u0430 \u0456 \u043b\u044e\u0434\u0438\u043d\u0430 \u043e\u0431\u0440\u0430\u043b\u0430 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0438\u0439; \u0431\u0435\u0437 \u043d\u044c\u043e\u0433\u043e - \u043e\u0441\u043d\u043e\u0432\u043d\u0438\u0439 (\u043f\u0435\u0440\u0448\u0438\u0439) \u0442\u0438\u043f \u043a\u0432\u0438\u0442\u043a\u0430 \u043f\u043e\u0434\u0456\u0457","type":"string"}},"required":["event_id"],"type":"object"},"name":"register_for_event","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"paymentUrl":{"description":"payment_required: \u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u043d\u0430 \u043e\u043f\u043b\u0430\u0442\u0443 \u0434\u043b\u044f \u043b\u044e\u0434\u0438\u043d\u0438","type":"string"},"reason":{"description":"handoff: \u0447\u043e\u043c\u0443 \u0440\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u044f \u043b\u0438\u0448\u0435 \u043d\u0430 \u0441\u0430\u0439\u0442\u0456","enum":["seat_selection","speed_dating","age_verification","diia_verification","approval_required","donation_proof","external_registration"],"type":"string"},"status":{"description":"registered - \u043a\u0432\u0438\u0442\u043e\u043a \u0443\u0436\u0435 \u0432 \u043f\u0440\u043e\u0444\u0456\u043b\u0456; payment_required - \u043a\u0432\u0438\u0442\u043e\u043a \u0437\u0430\u0440\u0435\u0437\u0435\u0440\u0432\u043e\u0432\u0430\u043d\u043e, \u0442\u0440\u0435\u0431\u0430 \u043e\u043f\u043b\u0430\u0442\u0438\u0442\u0438 \u0437\u0430 paymentUrl; handoff - \u0440\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u044f \u043b\u0438\u0448\u0435 \u043d\u0430 \u0441\u0430\u0439\u0442\u0456 \u0437\u0430 url","enum":["registered","payment_required","handoff"],"type":"string"},"url":{"description":"registered: \u043a\u0432\u0438\u0442\u043e\u043a \u0443 \u043f\u0440\u043e\u0444\u0456\u043b\u0456; handoff: \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u0430 \u043f\u043e\u0434\u0456\u0457","type":"string"}},"required":["status"],"type":"object"},"securitySchemes":[{"scopes":["events:write"],"type":"oauth2"}],"title":"\u0420\u0435\u0454\u0441\u0442\u0440\u0430\u0446\u0456\u044f \u043d\u0430 \u043f\u043e\u0434\u0456\u044e"}
