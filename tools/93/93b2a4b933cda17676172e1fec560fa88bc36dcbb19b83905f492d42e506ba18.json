{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The event-type, audience and status categories the UMD campus calendar files events under, with the slugs calendar_search_events accepts. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "calendar_list_categories",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "categories": {
    "description": "Categories in the order the site lists them",
    "items": {
     "additionalProperties": false,
     "properties": {
      "group": {
       "description": "Which filter the category belongs to",
       "enum": [
        "eventType",
        "audience",
        "eventStatus"
       ],
       "type": "string"
      },
      "id": {
       "description": "Craft category id",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "slug": {
       "description": "Slug to pass as event_type or audience, e.g. \"current-students\"",
       "type": "string"
      },
      "title": {
       "description": "Display name, e.g. \"Undergraduate Students\"",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "slug",
      "group"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "categories"
  ],
  "type": "object"
 },
 "title": "List event categories"
}
