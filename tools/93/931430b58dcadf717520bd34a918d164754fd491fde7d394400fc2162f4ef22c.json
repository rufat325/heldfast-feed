{
 "description": "Create an estimate (quote). CustomerRef and Line items required. Estimates can later be converted to invoices.",
 "inputSchema": {
  "properties": {
   "BillEmail": {
    "properties": {
     "Address": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "CurrencyRef": {
    "properties": {
     "value": {
      "description": "ISO-4217",
      "type": "string"
     }
    },
    "type": "object"
   },
   "CustomerMemo": {
    "properties": {
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "CustomerRef": {
    "properties": {
     "value": {
      "description": "Customer.Id",
      "type": "string"
     }
    },
    "required": [
     "value"
    ],
    "type": "object"
   },
   "ExpirationDate": {
    "description": "Estimate expiry (YYYY-MM-DD)",
    "type": "string"
   },
   "Line": {
    "description": "Estimate line items (same shape as invoice lines)",
    "items": {
     "properties": {
      "Amount": {
       "type": "number"
      },
      "Description": {
       "type": "string"
      },
      "DetailType": {
       "description": "Typically 'SalesItemLineDetail'",
       "type": "string"
      },
      "SalesItemLineDetail": {
       "properties": {
        "ItemRef": {
         "properties": {
          "value": {
           "description": "Item.Id",
           "type": "string"
          }
         },
         "type": "object"
        },
        "Qty": {
         "type": "number"
        },
        "UnitPrice": {
         "type": "number"
        }
       },
       "type": "object"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "TxnDate": {
    "description": "Estimate date (YYYY-MM-DD)",
    "type": "string"
   }
  },
  "required": [
   "CustomerRef",
   "Line"
  ],
  "type": "object"
 },
 "name": "create_estimate"
}
