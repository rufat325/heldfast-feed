{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "TrueRandomness service status"
 },
 "description": "Report service and beacon health: the current drand quicknet round, which relay answered, the rate-limiter mode, and whether the last draw obtained live atmospheric noise. Free, and does not consume rate limit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "beacon": {
    "additionalProperties": false,
    "properties": {
     "beaconTime": {
      "type": "string"
     },
     "chain": {
      "type": "string"
     },
     "relay": {
      "type": "string"
     },
     "round": {
      "type": "number"
     },
     "verificationUrl": {
      "type": "string"
     }
    },
    "required": [
     "chain",
     "round",
     "beaconTime",
     "relay",
     "verificationUrl"
    ],
    "type": "object"
   },
   "entropySource": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "physical": {
    "additionalProperties": false,
    "properties": {
     "at": {
      "type": "string"
     },
     "capturedAt": {
      "type": "string"
     },
     "enabled": {
      "type": "boolean"
     },
     "reason": {
      "type": "string"
     },
     "receiver": {
      "additionalProperties": false,
      "properties": {
       "host": {
        "type": "string"
       },
       "name": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "host"
      ],
      "type": "object"
     },
     "rssiDbm": {
      "type": "number"
     },
     "status": {
      "enum": [
       "untested",
       "ok",
       "unavailable"
      ],
      "type": "string"
     }
    },
    "required": [
     "enabled",
     "status"
    ],
    "type": "object"
   },
   "rateLimiter": {
    "additionalProperties": false,
    "properties": {
     "limit": {
      "type": "number"
     },
     "mode": {
      "type": "string"
     },
     "windowSeconds": {
      "type": "number"
     }
    },
    "required": [
     "mode",
     "limit",
     "windowSeconds"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "ok",
     "drand_unavailable"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "entropySource",
   "rateLimiter",
   "physical"
  ],
  "type": "object"
 },
 "title": "Service status"
}
