{
 "description": "Collect source context and evidence along bounded code graph relationships. Exact symbol/file works offline; query mode seeds from hybrid search. Token budget uses cl100k_base and may differ from the consuming model.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "depth": {
    "default": 1,
    "maximum": 3,
    "minimum": 0,
    "type": "integer"
   },
   "direction": {
    "default": "both",
    "enum": [
     "incoming",
     "outgoing",
     "both"
    ],
    "type": "string"
   },
   "file_path": {
    "type": "string"
   },
   "line": {
    "minimum": 1,
    "type": "integer"
   },
   "max_nodes": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "project_name": {
    "type": "string"
   },
   "query": {
    "minLength": 1,
    "type": "string"
   },
   "symbol": {
    "minLength": 1,
    "type": "string"
   },
   "token_budget": {
    "default": 4000,
    "maximum": 20000,
    "minimum": 256,
    "type": "integer"
   }
  },
  "required": [
   "project_name"
  ],
  "type": "object"
 },
 "name": "graph_context"
}
