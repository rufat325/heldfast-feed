{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Report a whole finished CI run in one call: creates the run, records every result, completes it. Use qase_result_record instead when the run already exists and results arrive in stages. Each result needs a numeric `case_id` and a status; batches over 200 are split for you, up to 2000. Cost: three API operations behind one call, about 0.7s for a small run.",
 "inputSchema": {
  "properties": {
   "code": {
    "description": "Project code, e.g. DEMO",
    "maxLength": 10,
    "minLength": 2,
    "pattern": "^[A-Z0-9_]+$",
    "type": "string"
   },
   "complete": {
    "default": true,
    "description": "Complete the run after recording results (default: true)",
    "type": "boolean"
   },
   "environment_id": {
    "description": "ID of the environment the build ran against",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "is_autotest": {
    "default": true,
    "description": "Mark as automated run (default: true)",
    "type": "boolean"
   },
   "results": {
    "description": "Test results to record, 1 to 2000 per call",
    "items": {
     "properties": {
      "attachments": {
       "description": "Hashes from qase_attachment_upload",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "case_id": {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "comment": {
       "type": "string"
      },
      "defect": {
       "type": "boolean"
      },
      "stacktrace": {
       "type": "string"
      },
      "status": {
       "enum": [
        "passed",
        "failed",
        "blocked",
        "skipped",
        "invalid"
       ],
       "type": "string"
      },
      "time_ms": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "case_id",
      "status"
     ],
     "type": "object"
    },
    "maxItems": 2000,
    "minItems": 1,
    "type": "array"
   },
   "title": {
    "description": "Run title (e.g., \"CI Build #1234\")",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "code",
   "title",
   "results"
  ],
  "type": "object"
 },
 "name": "qase_ci_report",
 "title": "Report CI results"
}
