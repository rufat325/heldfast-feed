{
 "_meta": {
  "openai/toolInvocation/invoked": "Night plan ready",
  "openai/toolInvocation/invoking": "Planning the night",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants a night plan with backups rather than a list. Returns, for one city and date, a primary event plus a nearby fallback (best taste fit within 6 km), a later-starting fallback, and alternates. Accepts the same filters as search_events and an optional profile for saved taste. An empty plan carries the same `no_results` guidance as search.",
 "inputSchema": {
  "dependentRequired": {
   "profile_id": [
    "profile_secret"
   ],
   "profile_secret": [
    "profile_id"
   ]
  },
  "properties": {
   "avoid": {
    "description": "Ranking penalties.",
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 40,
    "type": "array"
   },
   "city": {
    "description": "City name or slug.",
    "maxLength": 200,
    "type": "string"
   },
   "date_from": {
    "description": "Inclusive start date, YYYY-MM-DD.",
    "maxLength": 200,
    "type": "string"
   },
   "date_to": {
    "description": "Inclusive end date, YYYY-MM-DD.",
    "maxLength": 200,
    "type": "string"
   },
   "event_types": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "featuring": {
    "maxLength": 200,
    "type": "string"
   },
   "fields": {
    "items": {
     "enum": [
      "description",
      "images",
      "coordinates",
      "socials",
      "promoters",
      "source"
     ],
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "free": {
    "type": "boolean"
   },
   "genres": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "max_price": {
    "description": "Soft budget for ranking.",
    "type": "number"
   },
   "neighborhoods": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "price_max": {
    "description": "Hard price cap.",
    "type": "number"
   },
   "price_min": {
    "description": "Hard filter: minimum ticket price.",
    "type": "number"
   },
   "pride": {
    "description": "Only Pride / LGBTQ+ flagged events.",
    "type": "boolean"
   },
   "profile_id": {
    "description": "Optional profile id; pass with profile_secret.",
    "maxLength": 200,
    "type": "string"
   },
   "profile_secret": {
    "maxLength": 200,
    "type": "string"
   },
   "promoter": {
    "description": "Promoter slug or display name.",
    "maxLength": 200,
    "type": "string"
   },
   "query": {
    "description": "Free-text intent, for example 'concert first then a late party'.",
    "maxLength": 200,
    "type": "string"
   },
   "result_limit": {
    "default": 4,
    "description": "Plan size including the primary (1-6).",
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   },
   "venue": {
    "maxLength": 200,
    "type": "string"
   },
   "vibe": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "when": {
    "description": "Timeframe preset resolved in the city's local timezone: today, tonight, tomorrow, weekend, next weekend, week, next week, month, monday, tuesday, wednesday, thursday, friday, saturday, sunday, any, or an exact date as YYYY-MM-DD. Use date_from/date_to instead for a custom range.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "plan_night",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Plan Night"
}
