{"description":"Create a document in `draft`.\n\nTotals are computed and stored at creation, so the figures you read back are\nthe ones that were issued rather than a recalculation. Nothing is rendered \u2014\nuse `create_document_render` once the document is final.","inputSchema":{"$defs":{"InvoiceBankAccountInput":{"properties":{"account_name":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["Acme Corp"],"title":"Account Name"},"account_number":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["1234567890"],"title":"Account Number"},"bank_name":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["First National Bank"],"title":"Bank Name"},"iban":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["US82FNBK0000001234567890"],"title":"Iban"},"routing_number":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["021000021"],"title":"Routing Number"},"swift":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["FNBKUS33"],"title":"Swift"}},"title":"InvoiceBankAccountInput","type":"object"},"InvoiceBrandingInput":{"properties":{"accent_color":{"default":"#111827","title":"Accent Color","type":"string"},"font_family":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Font Family"},"footer_text":{"default":"Generated by InvoicePDFs","title":"Footer Text","type":"string"},"header_text":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Header Text"},"hide_invoicepdfs_branding":{"default":false,"title":"Hide Invoicepdfs Branding","type":"boolean"},"logo_file_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Logo File Id"},"primary_color":{"default":"#111827","title":"Primary Color","type":"string"}},"title":"InvoiceBrandingInput","type":"object"},"InvoiceCustomFieldInput":{"properties":{"label":{"examples":["PO Number"],"title":"Label","type":"string"},"value":{"examples":["PO-2026-001"],"title":"Value","type":"string"}},"required":["label","value"],"title":"InvoiceCustomFieldInput","type":"object"},"InvoiceNoteInput":{"properties":{"content":{"examples":["Thank you for your business!"],"title":"Content","type":"string"},"type":{"examples":["note"],"title":"Type","type":"string"}},"required":["type","content"],"title":"InvoiceNoteInput","type":"object"},"InvoicePaymentInput":{"properties":{"accepted_methods":{"examples":[["bank_transfer","credit_card"]],"items":{"type":"string"},"title":"Accepted Methods","type":"array"},"bank_account":{"anyOf":[{"$ref":"#/$defs/InvoiceBankAccountInput"},{"type":"null"}]},"instructions":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["Please pay within 30 days"],"title":"Instructions"},"payment_url":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["https://pay.acme.com/inv-001"],"title":"Payment Url"}},"title":"InvoicePaymentInput","type":"object"},"InvoiceShippingInput":{"properties":{"amount":{"examples":["9.99"],"title":"Amount","type":"string"},"description":{"default":"Shipping","title":"Description","type":"string"},"taxable":{"default":false,"title":"Taxable","type":"boolean"}},"required":["amount"],"title":"InvoiceShippingInput","type":"object"},"InvoiceTermInput":{"properties":{"content":{"examples":["Net 30 \u2014 payment due within 30 days of invoice date."],"title":"Content","type":"string"},"type":{"examples":["term"],"title":"Type","type":"string"}},"required":["type","content"],"title":"InvoiceTermInput","type":"object"},"LineItemDiscountInput":{"properties":{"reason":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["Loyalty discount"],"title":"Reason"},"type":{"default":"percentage","enum":["percentage","fixed"],"title":"Type","type":"string"},"value":{"examples":["10"],"title":"Value","type":"string"}},"required":["value"],"title":"LineItemDiscountInput","type":"object"},"LineItemTaxInput":{"properties":{"category":{"anyOf":[{"$ref":"#/$defs/TaxCategory"},{"type":"null"}],"description":"How this tax is treated \u2014 required for e-invoicing formats, which keep zero-rated, exempt and reverse-charge in separate VAT groups."},"inclusive":{"default":false,"title":"Inclusive","type":"boolean"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["Sales Tax"],"title":"Name"},"rate":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["8.875"],"title":"Rate"},"tax_rate_id":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["txr_01ABC"],"title":"Tax Rate Id"}},"title":"LineItemTaxInput","type":"object"},"PostalAddress":{"properties":{"city":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["San Francisco"],"title":"City"},"country":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["US"],"title":"Country"},"line1":{"examples":["1 Main St"],"title":"Line1","type":"string"},"line2":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["Suite 200"],"title":"Line2"},"postal_code":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["94105"],"title":"Postal Code"},"state":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["CA"],"title":"State"}},"required":["line1"],"title":"PostalAddress","type":"object"},"StandardLineItemInput":{"description":"A fully priced line: unit, price, tax, discount and SKU.","properties":{"description":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["Frontend redesign"],"title":"Description"},"discount":{"anyOf":[{"$ref":"#/$defs/LineItemDiscountInput"},{"type":"null"}]},"name":{"examples":["Web Development"],"title":"Name","type":"string"},"quantity":{"description":"Decimal string","examples":["2"],"title":"Quantity","type":"string"},"sku":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["SVC-WEB-001"],"title":"Sku"},"taxes":{"items":{"$ref":"#/$defs/LineItemTaxInput"},"title":"Taxes","type":"array"},"unit":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["hours"],"title":"Unit"},"unit_code":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"BT-130. UN/ECE Rec 20 code for the unit \u2014 HUR for hours, C62 for each. Separate from `unit`, which is the label printed on the PDF.","examples":["HUR"],"title":"Unit Code"},"unit_price":{"default":"0.00","description":"Decimal string, major units","examples":["150.00"],"title":"Unit Price","type":"string"}},"required":["name","quantity"],"title":"StandardLineItemInput","type":"object"},"TaxCategory":{"description":"How a tax is treated, as opposed to what it is called.\n\n`name` and `rate` do not say this: two taxes at 0% may be zero-rated,\nexempt, reverse-charge or outside scope, and EN 16931 keeps them in\nseparate VAT breakdown groups with different mandatory fields. Optional,\nso an invoice that never mentions a category calculates exactly as before.","properties":{"code":{"description":"UNCL5305 tax category code \u2014 S standard, Z zero-rated, E exempt, AE reverse charge, K intra-community, G export, O outside scope","examples":["S"],"minLength":1,"title":"Code","type":"string"},"exemption_reason":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Required by EN 16931 whenever the category is not standard.","examples":["Reverse charge"],"title":"Exemption Reason"},"exemption_reason_code":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["VATEX-EU-AE"],"title":"Exemption Reason Code"}},"required":["code"],"title":"TaxCategory","type":"object"}},"properties":{"Idempotency-Key":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Idempotency-Key"},"branding":{"anyOf":[{"$ref":"#/$defs/InvoiceBrandingInput"},{"type":"null"}]},"branding_profile_id":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["brnd_01ABC"],"title":"Branding Profile Id"},"business_profile_id":{"examples":["bp_01ABC"],"title":"Business Profile Id","type":"string"},"buyer_reference":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"BT-10. Mandatory in Peppol BIS unless an order reference is present \u2014 often the buyer's own PO or cost-centre string.","examples":["PO-4711"],"title":"Buyer Reference"},"currency":{"examples":["USD"],"maxLength":3,"minLength":3,"title":"Currency","type":"string"},"custom_fields":{"items":{"$ref":"#/$defs/InvoiceCustomFieldInput"},"title":"Custom Fields","type":"array"},"customer_id":{"examples":["cus_01XYZ"],"title":"Customer Id","type":"string"},"delivery_date":{"anyOf":[{"format":"date","type":"string"},{"type":"null"}],"description":"BT-72. When the goods or services were actually supplied \u2014 not the issue date, and what decides the VAT period. XRechnung requires this, an invoicing period, or a period on every line.","examples":["2026-09-30"],"title":"Delivery Date"},"discounts":{"items":{"$ref":"#/$defs/LineItemDiscountInput"},"title":"Discounts","type":"array"},"document_type":{"default":"invoice","enum":["invoice","credit_note","debit_note","quote","receipt","proforma","purchase_order","delivery_note"],"title":"Document Type","type":"string"},"due_date":{"anyOf":[{"format":"date","type":"string"},{"type":"null"}],"examples":["2026-08-19"],"title":"Due Date"},"issue_date":{"examples":["2026-07-20"],"format":"date","title":"Issue Date","type":"string"},"line_items":{"items":{"$ref":"#/$defs/StandardLineItemInput"},"title":"Line Items","type":"array"},"locale":{"anyOf":[{"type":"string"},{"type":"null"}],"default":"en-US","examples":["en-US"],"title":"Locale"},"notes":{"items":{"$ref":"#/$defs/InvoiceNoteInput"},"title":"Notes","type":"array"},"number":{"examples":["INV-2026-001"],"title":"Number","type":"string"},"payment":{"anyOf":[{"$ref":"#/$defs/InvoicePaymentInput"},{"type":"null"}]},"reason":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["Order cancelled"],"title":"Reason"},"ship_to":{"anyOf":[{"$ref":"#/$defs/PostalAddress"},{"type":"null"}]},"shipping":{"anyOf":[{"$ref":"#/$defs/InvoiceShippingInput"},{"type":"null"}]},"source_document_id":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["inv_01ABC"],"title":"Source Document Id"},"tax_scheme":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"UNCL5153 \u2014 what kind of tax this invoice states. One document, one answer: an invoice is issued under a tax regime, not a different one per line. Optional, and deliberately not defaulted, because a PDF does not need it and assuming `VAT` would put a claim in a tax document that you did not make. Required to produce or check an e-invoice, where it must be `VAT` \u2014 every ruleset built on EN 16931 describes VAT and tests for that string literally, so a document stating anything else is refused rather than relabelled.","examples":["VAT"],"title":"Tax Scheme"},"terms":{"items":{"$ref":"#/$defs/InvoiceTermInput"},"title":"Terms","type":"array"}},"required":["number","issue_date","currency","business_profile_id","customer_id","line_items"],"type":"object"},"name":"document_create"}
