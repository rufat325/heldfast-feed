{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List file import requests of a Box.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "boxId": {
    "description": "Box number (see ncloud_datafence_list_boxes)",
    "type": "integer"
   },
   "fenceId": {
    "description": "Datafence number (see ncloud_datafence_get_datafence)",
    "type": "integer"
   },
   "from": {
    "description": "Start datetime (yyyyMMddHHmmss)",
    "type": "string"
   },
   "page": {
    "description": "Page number (0-100, default 0)",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "size": {
    "description": "Items per page (1-100, default 10)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Import status code filter (File Import Status Code in the guide)",
    "type": "string"
   },
   "to": {
    "description": "End datetime (yyyyMMddHHmmss)",
    "type": "string"
   }
  },
  "required": [
   "fenceId",
   "boxId"
  ],
  "type": "object"
 },
 "name": "ncloud_datafence_list_file_imports"
}
