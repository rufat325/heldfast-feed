{
 "description": "Move an email to a different folder",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "type": "string"
   },
   "emailId": {
    "type": "string"
   },
   "sourceFolder": {
    "description": "Source folder (required for IMAP/iCloud when email is not in INBOX)",
    "type": "string"
   },
   "targetFolder": {
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "emailId",
   "targetFolder"
  ],
  "type": "object"
 },
 "name": "email_move"
}
