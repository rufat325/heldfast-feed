{
 "description": "Finish the task and close its session. outcome='none' closes without a reported outcome; 'credentials' extracts and vault-stores using store; 'result' reports summary or data \u2014 the reported outcome is recorded as-is. Successful completion saves eligible login state through the existing teardown.",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "outcome": {
       "const": "credentials"
      }
     },
     "required": [
      "outcome"
     ]
    },
    "then": {
     "required": [
      "store"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "outcome": {
       "const": "result"
      }
     },
     "required": [
      "outcome"
     ]
    },
    "then": {
     "anyOf": [
      {
       "required": [
        "summary"
       ]
      },
      {
       "required": [
        "data"
       ]
      }
     ]
    }
   }
  ],
  "properties": {
   "data": {
    "type": "object"
   },
   "outcome": {
    "default": "none",
    "enum": [
     "none",
     "credentials",
     "result"
    ],
    "type": "string"
   },
   "session_id": {
    "type": "string"
   },
   "store": {
    "properties": {
     "auth_shape": {
      "type": "string"
     },
     "egress_hosts": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "env_var_suggestion": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "service": {
      "type": "string"
     },
     "type": {
      "type": "string"
     }
    },
    "required": [
     "service"
    ],
    "type": "object"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "operate_finish",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cleanup": {
    "enum": [
     "open",
     "closing",
     "closed",
     "already_closed",
     "unknown"
    ],
    "type": "string"
   },
   "closed": {
    "type": "boolean"
   },
   "data": {
    "additionalProperties": {
     "type": [
      "string",
      "number",
      "boolean"
     ]
    },
    "type": "object"
   },
   "execution": {
    "enum": [
     "completed",
     "cancelled",
     "pending",
     "unknown"
    ],
    "type": "string"
   },
   "mutation": {
    "enum": [
     "not_dispatched",
     "dispatched",
     "unknown"
    ],
    "type": "string"
   },
   "operation_id": {
    "type": "string"
   },
   "session_id": {
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "operation_id",
   "execution",
   "mutation",
   "cleanup",
   "closed"
  ],
  "type": "object"
 }
}
