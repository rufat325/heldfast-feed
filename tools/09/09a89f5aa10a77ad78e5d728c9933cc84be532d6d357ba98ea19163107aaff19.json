{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add, remove, enable, or disable a firewall mangle rule. Uses comment as idempotency key. Supports dry-run mode.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "add",
     "remove",
     "enable",
     "disable"
    ],
    "type": "string"
   },
   "chain": {
    "description": "Mangle chain (required on add): prerouting, input, forward, output, postrouting",
    "type": "string"
   },
   "comment": {
    "description": "Idempotency key \u2014 uniquely identifies this mangle rule",
    "type": "string"
   },
   "confirmationToken": {
    "description": "Token from a prior APPROVAL_REQUIRED response. Re-submit the identical call with this token to confirm the destructive action.",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview changes without applying.",
    "type": "boolean"
   },
   "dstAddress": {
    "description": "Destination IP/CIDR to match",
    "type": "string"
   },
   "dstAddressList": {
    "description": "Destination address list name to match",
    "type": "string"
   },
   "dstPort": {
    "description": "Destination port or range",
    "type": "string"
   },
   "inInterface": {
    "description": "Incoming interface to match",
    "type": "string"
   },
   "newConnectionMark": {
    "description": "Connection mark to set",
    "type": "string"
   },
   "newDscpValue": {
    "description": "DSCP value to set (0\u201363)",
    "maximum": 63,
    "minimum": 0,
    "type": "integer"
   },
   "newRoutingMark": {
    "description": "Routing mark to set",
    "type": "string"
   },
   "outInterface": {
    "description": "Outgoing interface to match",
    "type": "string"
   },
   "passthrough": {
    "description": "Whether to continue matching subsequent rules",
    "type": "boolean"
   },
   "protocol": {
    "description": "Protocol to match (e.g. tcp, udp)",
    "type": "string"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "srcAddress": {
    "description": "Source IP/CIDR to match",
    "type": "string"
   },
   "srcAddressList": {
    "description": "Source address list name to match",
    "type": "string"
   },
   "srcPort": {
    "description": "Source port or range",
    "type": "string"
   }
  },
  "required": [
   "action",
   "comment"
  ],
  "type": "object"
 },
 "name": "manage_mangle_rule",
 "title": "Manage Mangle Rule"
}
