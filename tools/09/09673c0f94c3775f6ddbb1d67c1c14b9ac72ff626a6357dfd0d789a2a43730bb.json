{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Change an email, SMS or Telegram template that exists: its name, its text (and for email the subject, from, reply_to). Read its current text first: list_templates with kind and template_id returns it in full. A record template: update_record_template.",
 "inputSchema": {
  "properties": {
   "app_id": {
    "description": "Project ID (from list_projects)",
    "type": "string"
   },
   "body": {
    "description": "The whole new text (field html_names without brackets, as in the create tool)",
    "type": "string"
   },
   "from": {
    "description": "email only",
    "type": "string"
   },
   "kind": {
    "description": "email | sms | telegram",
    "type": "string"
   },
   "new_name": {
    "type": "string"
   },
   "reply_to": {
    "description": "email only",
    "type": "string"
   },
   "subject": {
    "description": "email only",
    "type": "string"
   },
   "template_id": {
    "description": "From list_templates",
    "type": "string"
   }
  },
  "required": [
   "app_id",
   "kind",
   "template_id"
  ],
  "type": "object"
 },
 "name": "update_template",
 "securitySchemes": [
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ]
}
