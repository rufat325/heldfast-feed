{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns live vehicles near a point, nearest first, each with its route, destination, and distance. Use when the user asks \"what transport is near me right now?\" or wants a live map around a location. Narrow with `route` when the user cares about one line; prefer `get_route_realtime` for a whole route and `get_stop_realtime` for arrival times at a stop. Requires decimal latitude and longitude (WGS84).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "latitude": {
    "description": "Decimal latitude of the centre point, WGS84 (e.g. 49.842 for central Lviv).",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "description": "Maximum vehicles to return, nearest first (1\u201350, default 15). `total` reports how many were in range.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "longitude": {
    "description": "Decimal longitude of the centre point, WGS84 (e.g. 24.031 for central Lviv).",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "radius_meters": {
    "description": "Search radius in metres (100\u20131000, default 500).",
    "maximum": 1000,
    "minimum": 100,
    "type": "integer"
   },
   "route": {
    "description": "Only vehicles on this route, by short name (e.g. \"\u042230\", \"\u04101\"). Omit for all routes.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "latitude",
   "longitude"
  ],
  "type": "object"
 },
 "name": "get_nearby_vehicles",
