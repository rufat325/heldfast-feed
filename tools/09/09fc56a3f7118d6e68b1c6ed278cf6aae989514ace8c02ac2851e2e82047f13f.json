{
 "description": "Record a welcome offer on a card. Tracks bonus amount, spend requirement, deadline, and progress. The agent must explicitly set status to 'earned' after confirming the bonus posted \u2014 no auto-earn.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bonus_amount": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^[+-]?\\d+(\\.\\d+)?$",
      "type": "string"
     }
    ],
    "description": "Points/miles/dollars earned (e.g., 80000)"
   },
   "bonus_currency": {
    "description": "Program key (e.g., 'amex_mr', 'aa_aadvantage', 'cashback')",
    "type": "string"
   },
   "card_id": {
    "description": "The card this offer belongs to",
    "type": "string"
   },
   "current_spend": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^[+-]?\\d+(\\.\\d+)?$",
      "type": "string"
     }
    ],
    "description": "Spend already applied (default 0)"
   },
   "notes": {
    "description": "Context (e.g., 'referral link', 'elevated offer')",
    "type": "string"
   },
   "spend_deadline": {
    "description": "ISO date by which spend must be completed (YYYY-MM-DD)",
    "type": "string"
   },
   "spend_requirement": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^[+-]?\\d+(\\.\\d+)?$",
      "type": "string"
     }
    ],
    "description": "Dollar amount that must be spent"
   }
  },
  "required": [
   "card_id",
   "bonus_amount",
   "bonus_currency",
   "spend_requirement",
   "spend_deadline"
  ],
  "type": "object"
 },
 "name": "create_welcome_offer"
}
