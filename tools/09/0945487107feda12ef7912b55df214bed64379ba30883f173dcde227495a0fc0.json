{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Profile a CSV or explicit string table before writing a recipe. Return empty, distinct and duplicate-value counts per column and complete formula warnings; no schema or business validity is inferred. Supply CSV OR columns/rows, never both. JSON numbers must be encoded as strings so identifiers keep leading zeros. One paid operation; no content retained. Reuse request_id only for identical input.",
 "inputSchema": {
  "$defs": {
   "TableInput": {
    "additionalProperties": false,
    "properties": {
     "columns": {
      "anyOf": [
       {
        "items": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 100,
        "minItems": 1,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Columns"
     },
     "csv_text": {
      "anyOf": [
       {
        "maxLength": 1000000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "CSV including headers; no paths or URLs.",
      "title": "Csv Text"
     },
     "delimiter": {
      "default": ",",
      "enum": [
       ",",
       ";",
       "\t",
       "|"
      ],
      "title": "Delimiter",
      "type": "string"
     },
     "rows": {
      "anyOf": [
       {
        "items": {
         "items": {
          "maxLength": 10000,
          "type": "string"
         },
         "maxItems": 100,
         "type": "array"
        },
        "maxItems": 10000,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Rows"
     }
    },
    "title": "TableInput",
    "type": "object"
   }
  },
  "properties": {
   "request_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Request Id"
   },
   "table": {
    "$ref": "#/$defs/TableInput"
   }
  },
  "required": [
   "table"
  ],
  "title": "inspect_tableArguments",
  "type": "object"
 },
 "name": "inspect_table",
 "title": "Inspect table columns without guessing types"
}
