{
 "description": "Get active marketplace listings for an Ordinals collection on Magic Eden. Returns listed inscriptions with prices in BTC.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collection_symbol": {
    "description": "Collection symbol on Magic Eden",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Results per page",
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset",
    "type": "number"
   }
  },
  "required": [
   "collection_symbol"
  ],
  "type": "object"
 },
 "name": "get_collection_listings"
}
