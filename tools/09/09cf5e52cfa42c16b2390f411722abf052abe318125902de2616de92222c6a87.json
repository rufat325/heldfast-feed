{"description":"Book a session (Servicialo spec). Returns confirmation_credential (opaque token, valid 30 min) and booking_id. Use scheduling_confirm with the credential to finalize. Does NOT require an API key \u2014 uses requester identity (fullName + email or phone). Accepts optional submission context for audit trail.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"datetime":{"type":"string"},"idempotencyKey":{"type":"string"},"notes":{"maxLength":500,"type":"string"},"orgSlug":{"type":"string"},"provider_id":{"type":"string"},"requester":{"properties":{"email":{"format":"email","pattern":"^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"fullName":{"minLength":2,"type":"string"},"nationalId":{"type":"string"},"phone":{"minLength":6,"type":"string"}},"required":["fullName"],"type":"object"},"service_id":{"type":"string"},"submission":{"properties":{"agentId":{"type":"string"},"agentName":{"type":"string"},"channel":{"default":"api","enum":["web","whatsapp","phone","chat","api","other"],"type":"string"},"platform":{"type":"string"},"submittedByType":{"default":"agent","enum":["human","agent","human_with_agent_assistance"],"type":"string"}},"type":"object"}},"required":["orgSlug","service_id","datetime","requester"],"type":"object"},"name":"scheduling_book"}
