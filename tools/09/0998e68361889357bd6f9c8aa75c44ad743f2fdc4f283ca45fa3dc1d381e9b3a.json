{
 "description": "Read the Chrome UX Report weekly history for an origin or URL, roughly six months of 28-day rolling windows, so a field metric can be seen trending rather than as one point. Read-only",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collectionPeriodCount": {
    "description": "Weekly periods to return, 1 to 40. Documented history is about six months; the API decides what it actually has",
    "maximum": 40,
    "minimum": 1,
    "type": "integer"
   },
   "formFactor": {
    "description": "Device class; omit for all form factors combined",
    "enum": [
     "PHONE",
     "TABLET",
     "DESKTOP"
    ],
    "type": "string"
   },
   "metrics": {
    "description": "Metric names to request; omit for all available",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "origin": {
    "description": "Origin such as https://example.com; aggregates every page under it. Give origin or url, not both",
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "A single page URL. Give origin or url, not both",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "crux_history",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collectionPeriods": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "firstDate": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastDate": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "firstDate",
      "lastDate"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "formFactor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "hasData": {
    "type": "boolean"
   },
   "metrics": {
    "anyOf": [
     {
      "additionalProperties": {
       "additionalProperties": false,
       "properties": {
        "p75s": {
         "items": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         },
         "type": "array"
        }
       },
       "required": [
        "p75s"
       ],
       "type": "object"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "additionalProperties": {
       "not": {}
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ]
   },
   "normalizedUrl": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "origin": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "periodCount": {
    "type": "number"
   },
   "source": {
    "type": "string"
   },
   "url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "origin",
   "url",
   "formFactor",
   "hasData",
   "source",
   "metrics",
   "notes"
  ],
  "type": "object"
 }
}
