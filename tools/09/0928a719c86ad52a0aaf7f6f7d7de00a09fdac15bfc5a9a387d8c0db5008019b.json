{
 "description": "Create an SLO for a project. Requires `write` scope. name, appId, type, target, and window are required.",
 "inputSchema": {
  "properties": {
   "appId": {
    "description": "Project id the SLO covers (required)",
    "type": "string"
   },
   "dataSource": {
    "description": "Where the metric comes from",
    "type": "string"
   },
   "name": {
    "description": "SLO name (required)",
    "type": "string"
   },
   "target": {
    "description": "Target number \u2014 0\u2013100 for availability/errorRate, \u22650 otherwise (required)",
    "type": "number"
   },
   "type": {
    "description": "SLO type (required)",
    "enum": [
     "availability",
     "latency",
     "errorRate",
     "throughput",
     "custom"
    ],
    "type": "string"
   },
   "unit": {
    "description": "Unit label (default '%')",
    "type": "string"
   },
   "window": {
    "description": "Rolling/calendar window (required)",
    "enum": [
     "rolling7d",
     "rolling30d",
     "rolling90d",
     "calendarMonth",
     "calendarQuarter"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "appId",
   "type",
   "target",
   "window"
  ],
  "type": "object"
 },
 "name": "create_slo"
}
