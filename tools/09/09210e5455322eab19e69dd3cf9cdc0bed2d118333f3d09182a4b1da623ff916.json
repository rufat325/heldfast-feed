        },
        {
         "type": "null"
        }
       ]
      },
      "discord": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "github_repo": {
       "anyOf": [
        {
         "format": "uri",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "identity_hash": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "logo_url": {
       "anyOf": [
        {
         "format": "uri",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "netuid": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "observed_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "subnet_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
