{
 "description": "Build quantified ROI business cases with documented assumptions, industry benchmarks, and executive-ready summaries. Generates defensible value calculations.",
 "inputSchema": {
  "properties": {
   "annual_revenue": {
    "description": "Customer annual revenue",
    "type": "number"
   },
   "company_size": {
    "description": "Company size tier",
    "enum": [
     "startup",
     "smb",
     "mid_market",
     "enterprise"
    ],
    "type": "string"
   },
   "current_process": {
    "description": "How they do it today (for comparison)",
    "type": "string"
   },
   "customer_name": {
    "description": "Customer/prospect name",
    "type": "string"
   },
   "employee_count": {
    "description": "Number of employees",
    "type": "number"
   },
   "implementation_timeline": {
    "description": "Expected implementation time",
    "type": "string"
   },
   "industry": {
    "description": "Industry for benchmarks",
    "type": "string"
   },
   "known_metrics": {
    "description": "Any metrics shared by prospect",
    "type": "string"
   },
   "primary_value_driver": {
    "description": "Primary value category",
    "enum": [
     "revenue_increase",
     "cost_reduction",
     "productivity",
     "risk_mitigation",
     "multiple"
    ],
    "type": "string"
   },
   "solution_price": {
    "description": "Annual cost of your solution",
    "type": "number"
   },
   "your_solution": {
    "description": "Your product/solution",
    "type": "string"
   }
  },
  "required": [
   "your_solution",
   "primary_value_driver"
  ],
  "type": "object"
 },
 "name": "roi_business_case_builder"
}
