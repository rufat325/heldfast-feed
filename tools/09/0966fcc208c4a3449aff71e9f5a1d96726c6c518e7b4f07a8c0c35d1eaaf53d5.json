{
 "description": "Deposita un documento nell'archivio con licenza dichiarata. Vietati i dati personali.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "licenza": {
    "enum": [
     "CC-BY-4.0",
     "CC-BY-SA-4.0",
     "CC0-1.0",
     "pubblico-dominio",
     "solo-consultazione"
    ],
    "type": "string"
   },
   "testo": {
    "maxLength": 50000,
    "type": "string"
   },
   "titolo": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "titolo",
   "testo",
   "licenza"
  ],
  "type": "object"
 },
 "name": "deposita_documento"
}
