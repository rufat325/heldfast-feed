{
 "description": "Route to the optimal model based on task complexity, risk, budget, and latency preferences. Returns recommendation with decision_path audit trail. Free \u2014 no metering.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budgetSensitivity": {
    "description": "Budget sensitivity (default: from profile)",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "complexity": {
    "description": "Reasoning complexity (auto-detected if prompt provided)",
    "enum": [
     "simple_factual",
     "analytical",
     "multi_step",
     "creative",
     "long_context",
     "agent_orchestration"
    ],
    "type": "string"
   },
   "context": {
    "description": "Optional context",
    "maxLength": 102400,
    "type": "string"
   },
   "latencySensitivity": {
    "description": "Latency sensitivity (default: from profile)",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "profile": {
    "description": "Optimization profile",
    "enum": [
     "cost_minimizer",
     "balanced",
     "quality_first",
     "creative",
     "enterprise_safe"
    ],
    "type": "string"
   },
   "prompt": {
    "description": "Raw prompt text (for auto-classification and research intent detection)",
    "maxLength": 102400,
    "minLength": 1,
    "type": "string"
   },
   "target": {
    "default": "claude",
    "description": "Output target for provider preference",
    "enum": [
     "claude",
     "openai",
     "generic"
    ],
    "type": "string"
   },
   "taskType": {
    "description": "Task type (auto-detected if prompt provided)",
    "enum": [
     "code_change",
     "question",
     "review",
     "debug",
     "create",
     "refactor",
     "writing",
     "research",
     "planning",
     "analysis",
     "communication",
     "data",
     "other"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "route_model"
}
