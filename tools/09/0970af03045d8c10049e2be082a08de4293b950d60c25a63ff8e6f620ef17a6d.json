{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Verify FreshProof Proof"
 },
 "description": "Verify the deterministic integrity of an existing FreshProof proof receipt and optionally evaluate declarative policy rules. This tool is free and performs no new public-network fetch.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "policy": {
    "additionalProperties": false,
    "properties": {
     "changed_since_content_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "content_hash_equals": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "final_host_equals": {
      "minLength": 1,
      "type": "string"
     },
     "max_age_seconds": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "original_host_equals": {
      "minLength": 1,
      "type": "string"
     },
     "require_same_origin_redirect": {
      "type": "boolean"
     },
     "status_in": {
      "items": {
       "maximum": 599,
       "minimum": 100,
       "type": "integer"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   },
   "proof_id": {
    "description": "FreshProof proof identifier returned by observe_url",
    "pattern": "^fp1_[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "proof_id"
  ],
  "type": "object"
 },
 "name": "verify_proof"
}
