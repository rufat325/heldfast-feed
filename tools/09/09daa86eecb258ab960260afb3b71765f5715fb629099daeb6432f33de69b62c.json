 "description": "Estimate what a Frontier Airlines ticket earns (miles or points, and status credit where it applies), using cwsi.net's calculator and the airline's published rules. Unofficial.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "card": {
    "default": "none",
    "description": "Frontier Airlines Mastercard cardmember. none = No; FC = Yes (Cardmember rate).",
    "enum": [
     "none",
     "FC"
    ],
    "type": "string"
   },
   "fare": {
    "default": "BF",
    "description": "Fare. BF = Basic Fare (basic rate); EC = Economy Bundle (bundle rate); PR = Premium Bundle (bundle rate); BZ = Business Bundle (bundle rate).",
    "enum": [
     "BF",
     "EC",
     "PR",
     "BZ"
    ],
    "type": "string"
   },
   "price": {
    "description": "Amount paid to Frontier (fare, bundle, bags and seats; not taxes) in US dollars. Eligible Frontier purchases on this booking. Taxes and change or cancel fees do not earn.",
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "number"
   },
   "status": {
    "default": "Member",
    "description": "Your Frontier status. Member = Member; Elite Silver = Elite Silver; Elite Gold = Elite Gold; Elite Platinum = Elite Platinum; Elite Diamond = Elite Diamond.",
    "enum": [
     "Member",
     "Elite Silver",
     "Elite Gold",
     "Elite Platinum",
     "Elite Diamond"
    ],
    "type": "string"
   }
  },
  "required": [
   "price"
  ],
  "type": "object"
 },
 "name": "calculate_frontier_miles",
