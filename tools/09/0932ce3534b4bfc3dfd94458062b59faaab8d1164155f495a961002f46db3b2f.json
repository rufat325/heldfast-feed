      "type": "string"
     },
     "participants": {
      "type": "number"
     },
     "points": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "date": {
         "type": "string"
        },
        "median": {
         "type": "number"
        },
        "p25": {
         "type": "number"
        },
