{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Side-by-side Model Tracker rows for 2 to 6 model slugs.",
 "inputSchema": {
  "properties": {
   "slugs": {
    "items": {
     "type": "string"
    },
    "maxItems": 6,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "slugs"
  ],
  "type": "object"
 },
 "name": "compare_models",
 "outputSchema": {
  "properties": {
   "attribution": {
    "type": "string"
   },
   "data": {
    "items": {
     "properties": {
      "benchmarks": {
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "category": {
       "enum": [
        "llm",
        "image",
        "audio",
        "video",
        "embedding",
        "other"
       ],
       "type": "string"
      },
      "contextWindow": {
       "type": [
        "integer",
        "null"
       ]
      },
      "lab": {
       "type": "string"
      },
      "license": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "openWeights": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "priceBasis": {
       "type": [
        "string",
        "null"
       ]
      },
      "pricePerMillionTokensUsd": {
       "description": "USD per 1M text tokens; null values when the model has no text-token price on record",
       "type": "object"
      },
      "releaseDate": {
       "type": [
        "string",
        "null"
       ]
      },
      "slug": {
       "type": "string"
      },
      "sources": {
       "description": "per-field {url, asOf}",
       "type": "object"
      },
      "url": {
       "type": "string"
      },
      "variants": {
       "description": "preview and dated snapshot slugs shown under this row",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "slug",
      "name",
      "lab",
      "sources",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "license": {
    "type": "object"
   }
  },
  "required": [
   "attribution",
   "data"
  ],
  "type": "object"
 },
 "title": "Compare models"
}
