{
 "_meta": {
  "openai/outputTemplate": "ui://polyblog/blog-overview-v1.html",
  "openai/toolInvocation/invoked": "Polyblog overview ready.",
  "openai/toolInvocation/invoking": "Loading Polyblog overview\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://polyblog/blog-overview-v1.html"
  },
  "ui/resourceUri": "ui://polyblog/blog-overview-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show blog overview"
 },
 "description": "Use this when someone wants a quick overview of one of their blogs. Returns an overview card with the blog's domain, languages and up to 10 most recently edited posts. Not for translation coverage.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "blogId": {
    "description": "Polyblog blog id to render, at most 200 characters",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "blogId"
  ],
  "type": "object"
 },
 "name": "show_blog_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "articles": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "locale": {
       "anyOf": [
        {
         "maxLength": 50,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "published": {
       "type": "boolean"
      },
      "slug": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "maxLength": 300,
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "slug",
      "locale",
      "published",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "blog": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "customDomain": {
        "anyOf": [
         {
          "maxLength": 300,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 50,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "locales": {
        "items": {
         "maxLength": 50,
         "type": "string"
        },
        "maxItems": 100,
        "type": "array"
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "customDomain",
       "defaultLocale",
       "locales"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "hasMoreArticles": {
    "type": "boolean"
   }
  },
  "required": [
   "blog",
   "articles",
   "hasMoreArticles"
  ],
  "type": "object"
 },
 "title": "Show blog overview"
}
