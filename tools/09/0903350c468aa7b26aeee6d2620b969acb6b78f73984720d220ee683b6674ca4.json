{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get fixed per-vehicle prices for a route, or for all routes if no routeSlug is given. Prices are fixed (no surge, no metered fares), in EUR and RSD. Each vehicle tier lists max passengers and luggage.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "routeSlug": {
    "description": "Optional route slug from list_routes (e.g. 'novi-sad-belgrade-airport'). Omit to get pricing for every route.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_pricing",
 "outputSchema": {
  "oneOf": [
   {
    "properties": {
     "currency": {
      "type": "string"
     },
     "routes": {
      "items": {
       "properties": {
        "pricing": {
         "items": {
          "properties": {
           "maxLuggage": {
            "type": [
             "integer",
             "null"
            ]
           },
           "maxPassengers": {
            "type": [
             "integer",
             "null"
            ]
           },
           "priceEur": {
            "type": "number"
           },
           "priceRsd": {
            "type": [
             "number",
             "null"
            ]
           },
           "vehicle": {
            "type": "string"
           }
          },
          "required": [
           "vehicle",
           "priceEur"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "route": {
         "type": "string"
        },
        "slug": {
         "type": "string"
        }
       },
       "required": [
        "slug",
        "pricing"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "currency",
     "routes"
    ],
    "type": "object"
   },
   {
    "properties": {
     "error": {
      "type": "string"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ]
 },
 "title": "Get pricing"
}
