{
 "description": "Poll a directory (local or via SSH) and complete when new files appear or after max iterations.",
 "execution": {
  "taskSupport": "required"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "host": {
    "description": "SSH host alias (optional).",
    "type": "string"
   },
   "intervalMs": {
    "default": 2000,
    "description": "Polling interval ms.",
    "type": "number"
   },
   "iterations": {
    "default": 10,
    "description": "Max polling iterations.",
    "type": "number"
   },
   "path": {
    "default": ".",
    "description": "Directory to watch.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tmux_watch_dir_task",
 "title": "Watch a directory for new files"
}
