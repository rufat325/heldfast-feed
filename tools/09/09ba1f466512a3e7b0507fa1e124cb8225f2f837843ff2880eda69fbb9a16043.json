{
 "description": "Create a new character in the session",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "abilities": {
    "additionalProperties": {
     "type": "integer"
    },
    "description": "Ability scores keyed by ability id. Must cover every ability the session's world defines, each within its range (the default world: STR, AGI, WIT, CON, each -5..+5). Omit to start at the world's defaults.",
    "propertyNames": {
     "minLength": 1
    },
    "type": "object"
   },
   "archetypeId": {
    "default": "custom",
    "description": "Archetype ID (optional)",
    "type": "string"
   },
   "armor": {
    "default": null,
    "description": "Armor name",
    "type": [
     "string",
     "null"
    ]
   },
   "background": {
    "default": "",
    "description": "Character background",
    "type": "string"
   },
   "gear": {
    "default": [],
    "description": "Other equipment",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "hp": {
    "default": 10,
    "description": "Starting HP",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "id": {
    "description": "Unique character ID (auto-generated from the name when omitted)",
    "type": "string"
   },
   "initializeStress": {
    "default": false,
    "description": "Start a stress tracker (from the world's stressConfig). Always on in worlds where stress is a penalty.",
    "type": "boolean"
   },
   "maxStress": {
    "description": "Maximum stress, overriding the world's (default 9)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "maxWounds": {
    "description": "Max Wounds, in worlds with Health and Wounds (the world's maxWounds otherwise)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "name": {
    "description": "Character name",
    "type": "string"
   },
   "personality": {
    "default": [],
    "description": "Personality traits",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "weapons": {
    "default": [],
    "description": "Weapons in format 'Name (damage)' e.g. 'Sword (d8)'",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "sessionId",
   "name"
  ],
  "type": "object"
 },
 "name": "create_character"
}
