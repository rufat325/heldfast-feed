{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Delete one or more messages (up to 500 ids). By default messages go to Deleted Items (recoverable with mail_search folder=deleteditems then mail_move; their id changes). `permanent: true` deletes irreversibly: only use it when the user explicitly asks for it.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"ids":{"description":"Message ids (1 to 500)","items":{"minLength":1,"type":"string"},"maxItems":500,"minItems":1,"type":"array"},"permanent":{"default":false,"description":"true = permanent deletion (irreversible). Default: Deleted Items.","type":"boolean"}},"required":["ids"],"type":"object"},"name":"mail_delete","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"failed":{"items":{"additionalProperties":false,"properties":{"error":{"type":"string"},"id":{"type":"string"}},"required":["id","error"],"type":"object"},"type":"array"},"moved":{"items":{"additionalProperties":false,"properties":{"id":{"type":"string"},"newId":{"type":"string"}},"required":["id","newId"],"type":"object"},"type":"array"},"succeeded":{"type":"number"}},"required":["succeeded","failed"],"type":"object"},"title":"Delete messages"}
