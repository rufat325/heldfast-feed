{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch the detail of a single MariaDB-level user (applications, permissions, link to phpMyAdmin).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "hosting_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "user_name": {
    "description": "Full user name including the hosting prefix",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "hosting_id",
   "user_name"
  ],
  "type": "object"
 },
 "name": "infomaniak_get_database_user",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "applications": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "is_temporary": {
    "type": "boolean"
   },
   "is_unlocked": {
    "type": "boolean"
   },
   "link": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "operation_in_progress": {
    "type": "boolean"
   },
   "permissions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "database": {
       "type": "string"
      },
      "rights": {
       "additionalProperties": false,
       "properties": {
        "admin": {
         "type": "boolean"
        },
        "read": {
         "type": "boolean"
        },
        "write": {
         "type": "boolean"
        }
       },
       "type": "object"
      }
     },
     "required": [
      "database"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "protected": {
    "type": "boolean"
