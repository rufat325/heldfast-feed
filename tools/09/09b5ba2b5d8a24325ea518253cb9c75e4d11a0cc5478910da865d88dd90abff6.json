{
 "description": "Search the marketplace by keyword and/or filters (network, asset, scheme, payTo, maxUsdPrice). Text queries rank by relevance; filter-only queries rank by 30-day call volume.",
 "inputSchema": {
  "properties": {
   "asset": {
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "type": "integer"
   },
   "maxUsdPrice": {
    "type": "number"
   },
   "network": {
    "description": "e.g. eip155:8453, solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
    "type": "string"
   },
   "payTo": {
    "type": "string"
   },
   "query": {
    "description": "Free-text keyword search",
    "type": "string"
   },
   "scheme": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_resources"
}
