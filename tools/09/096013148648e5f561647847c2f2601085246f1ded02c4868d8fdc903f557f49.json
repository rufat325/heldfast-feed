{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Quick verification for a narrow claim using up to 3 cited sources. Costs $0.02 USDC on Base per call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowedDomains": {
    "description": "Optional hostname allowlist without schemes or paths, for example openai.com.",
    "items": {
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "asOf": {
    "description": "Optional YYYY-MM-DD date at which the claim should be evaluated.",
    "type": "string"
   },
   "blockedDomains": {
    "description": "Optional hostname blocklist without schemes or paths.",
    "items": {
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "claim": {
    "description": "The factual claim to verify.",
    "maxLength": 4000,
    "minLength": 3,
    "type": "string"
   },
   "freshnessHours": {
    "description": "Maximum preferred source age in hours. Defaults to 168 hours.",
    "maximum": 8760,
    "minimum": 1,
    "type": "integer"
   },
   "includeConflicts": {
    "description": "Whether to search for and report conflicting evidence. Defaults to true.",
    "type": "boolean"
   },
   "jurisdiction": {
    "description": "Optional country, state, or legal jurisdiction that should frame the verification.",
    "maxLength": 100,
    "type": "string"
   },
   "language": {
    "description": "Preferred response language or auto for automatic selection. Defaults to auto.",
    "maxLength": 35,
    "minLength": 2,
    "type": "string"
   },
   "maxSources": {
    "description": "Maximum number of evidence sources to return, capped by the selected verification tier.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "minimumSources": {
    "description": "Minimum number of sources requested. Defaults to 2 and cannot exceed maxSources.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "sourcePolicy": {
    "description": "Source selection policy. Defaults to authoritative; official_only requires allowedDomains.",
    "enum": [
     "official_only",
     "authoritative",
     "open_web"
    ],
    "type": "string"
   }
  },
  "required": [
   "claim"
  ],
  "type": "object"
 },
 "name": "verify_claim_quick",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "atomicFacts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "confidence": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "evidenceIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "explanation": {
       "type": "string"
      },
      "statement": {
       "type": "string"
      },
      "status": {
       "enum": [
        "confirmed",
        "partially_confirmed",
        "contradicted",
        "insufficient_evidence",
        "ambiguous"
       ],
       "type": "string"
      }
     },
     "required": [
      "statement",
      "status",
      "confidence",
      "explanation",
      "evidenceIds"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "claim": {
    "type": "string"
   },
   "commerce": {
    "additionalProperties": false,
    "properties": {
     "orderId": {
      "type": "string"
     },
     "orderToken": {
      "type": "string"
     },
     "orderUrl": {
      "format": "uri",
      "type": "string"
     },
     "receiptId": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "orderId",
     "orderToken",
     "receiptId",
     "orderUrl"
    ],
    "type": "object"
   },
   "conclusion": {
    "type": "string"
   },
   "conflicts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "evidenceIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "summary",
      "evidenceIds"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "evidence": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cited": {
       "type": "boolean"
      },
      "consulted": {
       "type": "boolean"
      },
      "excerpt": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "providerSourceMatched": {
       "type": "boolean"
      },
      "publishedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "publisher": {
       "type": "string"
      },
      "qualityReason": {
       "type": "string"
      },
      "relationship": {
       "enum": [
        "supports",
        "contradicts",
        "context"
       ],
       "type": "string"
      },
      "retrievedAt": {
       "format": "date-time",
       "type": "string"
      },
      "snapshotId": {
       "type": [
        "string",
        "null"
       ]
      },
      "snapshotted": {
       "type": "boolean"
      },
      "sourceType": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "id",
      "url",
      "title",
      "publisher",
      "publishedAt",
      "retrievedAt",
      "excerpt",
      "relationship",
      "sourceType",
      "qualityReason",
      "providerSourceMatched",
      "cited",
      "snapshotId",
      "consulted",
      "snapshotted"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "observedAt": {
    "format": "date-time",
    "type": "string"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "cacheHit": {
      "type": "boolean"
     },
     "cachedInputTokens": {
      "minimum": 0,
      "type": "integer"
     },
     "citedSourceCount": {
      "minimum": 0,
      "type": "integer"
     },
     "consultedSourceCount": {
      "minimum": 0,
      "type": "integer"
     },
     "inputTokens": {
      "minimum": 0,
      "type": "integer"
     },
     "matchedEvidenceCount": {
      "minimum": 0,
      "type": "integer"
     },
     "model": {
      "type": "string"
     },
     "outputTokens": {
      "minimum": 0,
      "type": "integer"
     },
     "provider": {
      "type": "string"
     },
     "providerResponseId": {
      "type": "string"
     },
     "providerSourceCount": {
      "minimum": 0,
      "type": "integer"
     },
     "searchedWeb": {
      "type": "boolean"
     },
     "snapshottedSourceCount": {
      "minimum": 0,
      "type": "integer"
     },
     "webSearchCallCount": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "provider",
     "model",
     "providerResponseId",
     "searchedWeb",
     "consultedSourceCount",
     "citedSourceCount",
     "providerSourceCount",
     "matchedEvidenceCount",
     "snapshottedSourceCount",
     "webSearchCallCount",
     "inputTokens",
     "cachedInputTokens",
     "outputTokens",
     "cacheHit"
    ],
    "type": "object"
   },
   "providerSources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "actions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "cited": {
       "type": "boolean"
      },
      "evidenceIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "provider": {
       "type": "string"
      },
      "queries": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "searchCallIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "snapshotId": {
       "type": [
        "string",
        "null"
       ]
      },
      "sourceId": {
       "type": "string"
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "sourceId",
      "url",
      "title",
      "provider",
      "searchCallIds",
      "actions",
      "queries",
      "evidenceIds",
      "cited",
      "snapshotId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "snapshots": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "contentLength": {
       "anyOf": [
