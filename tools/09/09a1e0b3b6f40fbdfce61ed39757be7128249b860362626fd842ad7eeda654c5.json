{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Every fill for one Hyperliquid wallet, optionally for one market, from indexed history: price, size, side, fee and realized PnL. Hyperliquid's own userFills endpoints stop at the 10,000 most recent fills.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "Wallet address (e.g. 0x...)",
    "type": "string"
   },
   "limit": {
    "description": "Number of fills (1-100, default 20)",
    "type": "number"
   },
   "market": {
    "description": "Optional market filter \u2014 native HL (e.g. \"BTC-PERP\") or HIP-3 builder market \"<issuer>:<base>-PERP\" (e.g. \"flx:GAS-PERP\")",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_fills",
 "outputSchema": {
  "description": "Fills for one wallet, newest first",
  "properties": {
   "data": {
    "description": "Fills for one wallet, newest first",
    "items": {
     "description": "One row",
     "properties": {
      "address": {
       "description": "Wallet address (0x\u2026)"
      },
      "base_market": {
       "description": "Display symbol without the HIP-3 issuer prefix"
      },
      "block_number": {
       "description": "Hyperliquid block height"
      },
      "direction": {
       "description": "e.g. \"Open Long\", \"Close Short\""
      },
      "display_symbol": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "fee": {
       "description": "Fee paid in USD"
      },
      "issuer": {
       "description": "HIP-3 builder code (\"\" for native markets)"
      },
      "market": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "market_type": {
       "description": "perp, spot or prediction"
      },
      "price": {
       "description": "Price in USD"
      },
      "quote_asset": {
       "description": "Quote asset, e.g. USDC"
      },
      "realized_pnl": {
       "description": "Realized PnL in USD"
      },
      "side": {
       "description": "Fill side, \"buy\" or \"sell\""
      },
      "size": {
       "description": "Size in base units"
      },
      "source": {
       "description": "Venue, always hyperliquid"
      },
      "timestamp": {
       "description": "Unix milliseconds"
      },
      "venue": {
       "description": "Venue, always hyperliquid"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "pagination": {
    "description": "Cursor pagination",
    "properties": {
     "has_more": {
      "description": "Whether more rows exist"
     },
     "next_cursor": {
      "description": "Pass as cursor to fetch the next page; null on the last page"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 }
}
