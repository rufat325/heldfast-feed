{
 "description": "Create a GPT Image 2 task on RunAPI (edit image). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "enum": [
     "auto",
     "1:1",
     "3:2",
     "2:3",
     "4:3",
     "3:4",
     "5:4",
     "4:5",
     "16:9",
     "9:16",
     "2:1",
     "1:2",
     "3:1",
     "1:3",
     "21:9",
     "9:21"
    ],
    "type": "string"
   },
   "callback_url": {
    "type": "string"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "gpt-image-2"
    ],
    "type": "string"
   },
   "output_resolution": {
    "enum": [
     "1k",
     "2k",
     "4k"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "source_image_urls": {
    "items": {},
    "type": "array"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "prompt",
   "source_image_urls"
  ],
  "type": "object"
 },
 "name": "edit_image"
}
