{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Manages Python versions via pyenv.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "The pyenv action to perform",
    "enum": [
     "versions",
     "version",
     "install",
     "installList",
     "local",
     "global",
     "uninstall",
     "which",
     "rehash"
    ],
    "type": "string"
   },
   "command": {
    "description": "Command name for `which` action (e.g. python, pip)",
    "maxLength": 255,
    "type": "string"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "force": {
    "default": false,
    "description": "Force reinstallation of an already installed version (--force)",
    "type": "boolean"
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   },
   "skipExisting": {
    "default": false,
    "description": "Skip installation if version is already installed (--skip-existing)",
    "type": "boolean"
   },
   "unset": {
    "default": false,
    "description": "Clear local/global version setting (--unset)",
    "type": "boolean"
   },
   "version": {
    "description": "Python version string (required for install/uninstall/local/global, e.g. '3.12.0')",
    "maxLength": 255,
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "pyenv",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "action": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "title": "pyenv"
}
