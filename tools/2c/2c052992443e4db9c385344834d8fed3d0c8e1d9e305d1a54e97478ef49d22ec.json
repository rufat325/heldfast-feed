{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Audit AI crawler access to a URL"
 },
 "description": "Verify that major AI crawlers (GPTBot, OAI-SearchBot, ClaudeBot, PerplexityBot, CCBot, Google-Extended, Applebot-Extended, Bytespider, Meta-ExternalAgent, plus real-time fetch UAs) can fetch a URL. Parses robots.txt and does a live GET with each bot's User-Agent. Surfaces robots.txt blocks AND UA-based gating that breaks AI citation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bots": {
    "description": "Override the default bot list. Each entry is a User-Agent token (e.g. 'GPTBot', 'ClaudeBot').",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "fetch_with_ua": {
    "default": true,
    "description": "If true, do a live GET as each bot's User-Agent and report status. Disable to only parse robots.txt (no extra requests).",
    "type": "boolean"
   },
   "url": {
    "description": "Page URL to test for AI crawler access.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "audit_crawler_access",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bots": {
    "description": "Per-bot access verdict combining robots.txt + live UA test.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "fetch_error": {
       "type": [
        "string",
        "null"
       ]
      },
      "fetch_ok": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "fetch_status": {
       "type": [
        "number",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "operator": {
       "type": "string"
      },
      "purpose": {
       "type": "string"
      },
      "robots_allowed": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "const": "unknown",
         "type": "string"
        }
       ]
      },
      "robots_rule": {
       "type": [
        "string",
        "null"
       ]
      },
      "ua_token": {
       "type": "string"
      },
      "verdict": {
       "enum": [
        "allowed",
        "blocked",
        "robots_only_allowed",
        "robots_only_blocked",
        "unknown"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "ua_token",
      "operator",
      "purpose",
      "robots_allowed",
      "robots_rule",
      "fetch_status",
      "fetch_ok",
      "fetch_error",
      "verdict"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "fetched_at": {
    "description": "UTC ISO-8601 timestamp.",
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "robots_error": {
    "description": "Error message if robots.txt fetch failed.",
    "type": [
     "string",
     "null"
    ]
   },
   "robots_present": {
    "description": "Whether a non-empty robots.txt was found.",
    "type": "boolean"
   },
   "robots_status": {
    "description": "HTTP status of the robots.txt fetch.",
    "type": [
     "number",
     "null"
    ]
   },
   "robots_url": {
    "description": "robots.txt URL that was parsed.",
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "allowed": {
      "type": "number"
     },
     "blocked": {
      "type": "number"
     },
     "total": {
      "type": "number"
     },
     "unknown": {
      "type": "number"
     }
    },
    "required": [
     "total",
     "allowed",
     "blocked",
     "unknown"
    ],
    "type": "object"
   },
   "url": {
    "description": "The URL that was audited.",
    "type": "string"
   }
  },
  "required": [
   "url",
   "robots_url",
   "robots_status",
   "robots_present",
   "robots_error",
   "fetched_at",
   "bots",
   "summary"
  ],
  "type": "object"
 }
}
