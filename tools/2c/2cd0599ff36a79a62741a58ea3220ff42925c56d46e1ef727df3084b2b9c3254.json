{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Full-text search over the Skill of Skills directory (AI coding skills, plugins, MCP servers across Claude Code, Cursor, Codex, Windsurf, Cline). Results are ranked by the quality-first composite score, not popularity; when no tool matches every term, the closest partial matches are returned instead (match_mode: \"any\"), most relevant first. Critical-risk tools are excluded by default (risk_filter); every result carries risk_level and risk_reasons. Scores are evidence, not endorsements.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_high_risk": {
    "description": "Deprecated alias for risk_filter=none",
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "min_tier": {
    "default": "experimental",
    "description": "Quality floor: curated \u2265120, promising \u226580, experimental \u226540",
    "enum": [
     "curated",
     "promising",
     "experimental"
    ],
    "type": "string"
   },
   "platform": {
    "description": "Restrict to one client platform",
    "enum": [
     "claude_code",
     "cursor",
     "codex",
     "ai_studio",
     "windsurf",
     "cline",
     "generic",
     "multi_platform"
    ],
    "type": "string"
   },
   "query": {
    "description": "What capability you need, e.g. \"postgres migrations\"",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "risk_filter": {
    "default": "exclude_critical",
    "description": "Risk gate: exclude_critical omits critical risk (default); exclude_high omits high and critical risk; none omits no risk levels",
    "enum": [
     "exclude_critical",
     "exclude_high",
     "none"
    ],
    "type": "string"
   },
   "verified": {
    "description": "Current Verified Working result: runs only, or any verified tier",
    "enum": [
     "runs",
     "any"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_skills",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "match_mode": {
    "enum": [
     "all",
     "any"
    ],
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "composite_score": {
       "type": "number"
      },
      "description": {
       "type": "string"
      },
      "is_official": {
       "type": "boolean"
      },
      "last_commit_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "platforms": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "profile_url": {
       "type": "string"
      },
      "quality_score": {
       "type": "number"
      },
      "repo_url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "risk_level": {
       "type": "string"
      },
      "risk_reasons": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "slug": {
       "type": "string"
      },
      "stars": {
       "type": "number"
      },
      "tier": {
       "enum": [
        "curated",
        "promising",
        "experimental",
        "review_required"
       ],
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "verification": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "commit_sha": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "failing_check": {
           "additionalProperties": false,
           "properties": {
            "id": {
             "type": "string"
            },
            "path": {
             "anyOf": [
              {
               "type": "string"
              },
              {
               "type": "null"
              }
             ]
            }
           },
           "required": [
            "id",
            "path"
           ],
           "type": "object"
          },
          "stale": {
           "type": "boolean"
          },
          "status": {
           "type": "string"
          },
          "tier": {
           "anyOf": [
            {
             "enum": [
              "runs",
              "loads-clean"
             ],
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "verified_at": {
           "type": "string"
          }
         },
         "required": [
          "status",
          "tier",
          "commit_sha",
          "verified_at",
          "stale"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "slug",
      "tier",
      "quality_score",
      "composite_score",
      "risk_level",
      "risk_reasons",
      "type",
      "category",
      "platforms",
      "description",
      "repo_url",
      "profile_url",
      "stars",
      "is_official",
      "last_commit_at",
      "verification"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "count",
   "match_mode",
   "results"
  ],
  "type": "object"
 },
 "title": "Search skills"
}
