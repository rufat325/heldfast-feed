{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Survey"
 },
 "description": "Update a survey draft or publishing configuration. Use questionBlocks to replace the ordered form block list.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "closeAt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional ISO datetime when the survey closes"
   },
   "description": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Survey description"
   },
   "openAt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional ISO datetime when the survey opens"
   },
   "questionBlocks": {
    "description": "Ordered survey question blocks",
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "settings": {
    "additionalProperties": {},
    "description": "Survey settings such as allowMultipleResponses, collectEmail, collectIpAddress, requireAuthentication, showProgress, successMessage",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "slug": {
    "description": "URL slug",
    "type": "string"
   },
   "status": {
    "description": "Survey status",
    "enum": [
     "draft",
     "published",
     "closed",
     "archived"
    ],
    "type": "string"
   },
   "surveyId": {
    "description": "Survey ID",
    "type": "string"
   },
   "title": {
    "description": "Survey title",
    "minLength": 1,
    "type": "string"
   },
   "visibility": {
    "description": "Survey access mode",
    "enum": [
     "public",
     "members_only",
     "token_only",
     "private"
    ],
    "type": "string"
   }
  },
  "required": [
   "surveyId"
  ],
  "type": "object"
 },
 "name": "update_survey",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
