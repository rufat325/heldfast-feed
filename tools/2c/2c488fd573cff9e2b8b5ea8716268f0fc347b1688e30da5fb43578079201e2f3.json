{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Make a checkout link"
 },
 "description": "Build Squatch Stack checkout links for the chosen variants. It does NOT buy anything: give the links to the person, who reviews the cart and pays on the store's secure checkout (tax and shipping calculated there).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "items": {
    "items": {
     "properties": {
      "quantity": {
       "default": 1,
       "maximum": 10,
       "minimum": 1,
       "type": "integer"
      },
      "variant_id": {
       "description": "variant_id from get_good, e.g. T3M",
       "pattern": "^[A-Z0-9]{1,16}$",
       "type": "string"
      }
     },
     "required": [
      "variant_id"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "start_checkout",
 "title": "Make a checkout link"
}
