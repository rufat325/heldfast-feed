{
 "description": "Analyze backlink-bearing pages and classify linkable assets, broken backlink pages, lost links, refresh candidates, and quality risks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backlinks_status_type": {
    "default": "live",
    "enum": [
     "live",
     "all",
     "lost"
    ],
    "type": "string"
   },
   "dofollow_only": {
    "default": false,
    "type": "boolean"
   },
   "exclude_internal_backlinks": {
    "default": true,
    "type": "boolean"
   },
   "include_subdomains": {
    "default": true,
    "type": "boolean"
   },
   "internal_list_limit": {
    "default": 10,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_backlinks": {
    "maximum": 10000000,
    "minimum": 1,
    "type": "integer"
   },
   "min_referring_domains": {
    "maximum": 10000000,
    "minimum": 1,
    "type": "integer"
   },
   "min_words": {
    "maximum": 1000000,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 20000,
    "minimum": 0,
    "type": "integer"
   },
   "page_filter": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "rank_scale": {
    "default": "one_hundred",
    "enum": [
     "one_hundred",
     "one_thousand"
    ],
    "type": "string"
   },
   "sort_by": {
    "default": "backlinks",
    "enum": [
     "backlinks",
     "referring_domains",
     "rank",
     "spam_score",
     "broken_backlinks",
     "first_visited",
     "words_count",
     "external_links"
    ],
    "type": "string"
   },
   "status_code": {
    "maximum": 599,
    "minimum": 100,
    "type": "integer"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "minLength": 1,
    "type": "string"
   },
   "title_filter": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "agentseo_backlinks_domain_pages",
 "title": "AgentSEO Backlinks Domain Pages"
}
