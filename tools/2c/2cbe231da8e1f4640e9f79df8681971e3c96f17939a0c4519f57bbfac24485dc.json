{
 "description": "Create a new subscription. SIDE EFFECT: creates recurring invoicing for the customer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "billing_periods": {
    "description": "Number of billing periods",
    "type": "number"
   },
   "billing_unit": {
    "description": "Billing cycle unit",
    "enum": [
     "weekly",
     "monthly",
     "quarterly",
     "yearly"
    ],
    "type": "string"
   },
   "customer_id": {
    "description": "Customer ID",
    "type": "string"
   },
   "customer_type": {
    "description": "Customer type",
    "enum": [
     "contact",
     "company"
    ],
    "type": "string"
   },
   "department_id": {
    "description": "Department ID",
    "type": "string"
   },
   "line_items": {
    "description": "One or more line items for the subscription",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "extended_description": {
       "type": "string"
      },
      "product_id": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "tax_rate_id": {
       "type": "string"
      },
      "unit_price_amount": {
       "type": "number"
      },
      "unit_price_currency": {
       "default": "EUR",
       "type": "string"
      }
     },
     "required": [
      "quantity",
      "description",
      "unit_price_amount",
      "tax_rate_id"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "starts_on": {
    "description": "Start date (YYYY-MM-DD)",
    "type": "string"
   },
   "title": {
    "description": "Subscription title",
    "type": "string"
   }
  },
  "required": [
   "title",
   "customer_type",
   "customer_id",
   "department_id",
   "starts_on",
   "billing_periods",
   "billing_unit",
   "line_items"
  ],
  "type": "object"
 },
 "name": "teamleader_subscriptions_create"
}
