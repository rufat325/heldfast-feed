{
 "_meta": {
  "openai/iconStyle": "monochrome",
  "openai/ui": {
   "entrypoints": [
    {
     "quickAction": {
      "icons": [
       {
        "mimeType": "image/svg+xml",
        "sizes": [
         "20x20"
        ],
        "src": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2220%22%20height%3D%2220%22%20viewBox%3D%220%200%2020%2020%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%221.33%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%0A%20%20%3Crect%20x%3D%222.5%22%20y%3D%224%22%20width%3D%2215%22%20height%3D%2212%22%20rx%3D%222%22%2F%3E%0A%20%20%3Cpath%20d%3D%22M2.5%207l7.5%205%207.5-5%22%2F%3E%0A%20%20%3Ccircle%20cx%3D%2214.5%22%20cy%3D%2213.5%22%20r%3D%222.5%22%20fill%3D%22currentColor%22%2F%3E%0A%20%20%3Cpath%20d%3D%22M13.5%2013.5l0.7%200.7%201.5-1.4%22%20stroke%3D%22var(--bg%2C%20%23fff)%22%20stroke-width%3D%220.8%22%2F%3E%0A%3C%2Fsvg%3E"
       }
      ],
      "target": {
       "arguments": {},
       "name": "intake_message",
       "type": "tool"
      },
      "title": "Intake Pitch"
     },
     "type": "global"
    },
    {
     "type": "thread"
    },
    {
     "extensions": [
      ".eml",
      ".msg",
      ".pitch",
      ".outreach"
     ],
     "type": "file"
    }
   ]
  },
  "ui": {
   "resourceUri": "ui://outreach-desk/intake"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this to open the interactive inbound pitch intake form in ChatGPT, or evaluate and stage an incoming recruiter pitch.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channel": {
    "description": "Communication channel the message was received on.",
    "enum": [
     "email",
     "linkedin",
     "x",
     "other"
    ],
    "type": "string"
   },
   "desk_key": {
    "description": "Optional secret desk_key. If provided, evaluates against your private criteria and saves evaluation to your scoreboard.",
    "pattern": "^od_[0-9a-f]{32}$",
    "type": "string"
   },
   "file": {
    "description": "File metadata injected when opened through a file extension entrypoint.",
    "properties": {
     "name": {
      "minLength": 1,
      "type": "string"
     },
     "resourceUri": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "name",
     "resourceUri"
    ],
    "type": "object"
   },
   "message": {
    "description": "The inbound outreach or recruiter pitch text to evaluate.",
    "type": "string"
   },
   "priority": {
    "description": "Optional candidate priority assigned to this inbound opportunity.",
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "sender": {
    "description": "Optional recruiter sender info (email address, URL or domain).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "intake_message",
 "outputSchema": {
  "properties": {
   "as_of": {
    "type": "string"
   },
   "channel": {
    "type": "string"
   },
   "drafts": {
    "properties": {
     "decline": {
      "type": "string"
     },
     "interested": {
      "type": "string"
     },
     "request_info": {
      "type": "string"
     }
    },
    "required": [
     "interested",
     "request_info",
     "decline"
    ],
    "type": "object"
   },
   "evaluation": {
    "properties": {
     "breakdown": {
      "properties": {
       "cadence": {
        "type": "integer"
       },
       "relevance": {
        "type": "integer"
       },
       "spam": {
        "type": "integer"
       },
       "specificity": {
        "type": "integer"
       }
      },
      "required": [
       "relevance",
       "specificity",
       "cadence",
       "spam"
      ],
      "type": "object"
     },
     "composite_score": {
      "type": "integer"
     },
     "evaluation_id": {
      "type": "string"
     },
     "flags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "key_reasons": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "recommended_action": {
      "enum": [
       "interested",
       "request_info",
       "decline"
      ],
      "type": "string"
     },
     "sender_domain": {
      "type": "string"
     },
     "summary": {
      "type": "string"
     }
    },
    "required": [
     "evaluation_id",
     "sender_domain",
     "composite_score",
     "breakdown",
     "flags",
     "summary",
     "recommended_action",
     "key_reasons"
    ],
    "type": "object"
   },
   "file": {
    "type": "object"
   },
   "interactive_ui": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "priority": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "ready"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "interactive_ui"
  ],
  "type": "object"
 },
 "title": "Inbound Message Intake"
}
