{
 "description": "Run a snippet of code inside a capsule (python, node, or bash). Returns stdout/stderr/exit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "lang": {
    "enum": [
     "python",
     "node",
     "bash"
    ],
    "type": "string"
   },
   "sessionId": {
    "type": "string"
   },
   "timeoutSec": {
    "type": "number"
   }
  },
  "required": [
   "sessionId",
   "code"
  ],
  "type": "object"
 },
 "name": "capsulate_run_code",
 "title": "Run code"
}
