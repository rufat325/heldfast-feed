{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List importable entity types"
 },
 "description": "Lists importable entity types for a company (Invoice, Bill, JournalEntry, Customer, Vendor, etc.). Use the returned 'name' as entityName for get_fields and import tools.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "companyId": {
    "description": "Company id from list_companies.",
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "name": "list_entities",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "entities": {
    "description": "Importable entity types for this company.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "displayName": {
       "description": "Human-readable entity name.",
       "type": "string"
      },
      "name": {
       "description": "Entity name (use as entityName downstream).",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}
