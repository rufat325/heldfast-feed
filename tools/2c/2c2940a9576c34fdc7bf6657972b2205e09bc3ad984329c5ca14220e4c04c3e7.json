{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Grade a car deal: compare asking price to expected market value. ZIP is optional. Same inputs/outputs as POST /api/score.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asking_price": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "make": {
    "type": "string"
   },
   "mileage": {
    "minimum": 0,
    "type": "number"
   },
   "model": {
    "type": "string"
   },
   "trim": {
    "type": "string"
   },
   "vin": {
    "type": "string"
   },
   "year": {
    "maximum": 2027,
    "minimum": 1980,
    "type": "integer"
   },
   "zip": {
    "pattern": "^\\d{5}$",
    "type": "string"
   }
  },
  "required": [
   "asking_price",
   "mileage"
  ],
  "type": "object"
 },
 "name": "score_deal",
 "title": "Score Deal"
}
