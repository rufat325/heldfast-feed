{
 "description": "List orders with optional filters",
 "inputSchema": {
  "properties": {
   "book": {
    "description": "Filter by order book symbol",
    "type": "string"
   },
   "limit": {
    "description": "Number of results (default 25, max 100)",
    "type": "number"
   },
   "marker": {
    "description": "Pagination marker",
    "type": "string"
   },
   "sort": {
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "open",
     "partially_filled",
     "completed",
     "cancelled"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_orders"
}
