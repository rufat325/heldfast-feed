{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Full pre-publish checklist. Builds a UTM-tagged link and runs all validations: URL resolution, SSL, redirects, Open Graph, Twitter Card, favicon, load time, character count, hashtags, image dimensions, and CTA detection. Returns a tracked link + comprehensive validation report. Supported platforms: x, linkedin, facebook, instagram, threads.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaign": {
    "description": "Campaign name",
    "type": "string"
   },
   "content": {
    "description": "Content variant for A/B testing (optional)",
    "type": "string"
   },
   "copy": {
    "description": "Post copy text",
    "type": "string"
   },
   "image_height": {
    "description": "Image height in pixels (optional)",
    "type": "number"
   },
   "image_width": {
    "description": "Image width in pixels (optional)",
    "type": "number"
   },
   "medium": {
    "description": "Marketing medium, e.g. social, cpc, email",
    "type": "string"
   },
   "platform": {
    "description": "Target platform",
    "enum": [
     "x",
     "linkedin",
     "facebook",
     "instagram",
     "threads"
    ],
    "type": "string"
   },
   "source": {
    "description": "Traffic source, e.g. linkedin, google",
    "type": "string"
   },
   "term": {
    "description": "Paid keyword (optional)",
    "type": "string"
   },
   "url": {
    "description": "Destination URL",
    "type": "string"
   }
  },
  "required": [
   "url",
   "copy",
   "platform",
   "campaign",
   "source",
   "medium"
  ],
  "type": "object"
 },
 "name": "mlz_publish_check"
}
