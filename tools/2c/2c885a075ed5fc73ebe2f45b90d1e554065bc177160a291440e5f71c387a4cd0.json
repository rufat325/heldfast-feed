{
 "description": "Add items to queue \u2014 Adds one or more traces/spans/sessions to the queue for review. Duplicate `(queue_id, resource_id)` pairs are ignored silently.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "resource_id": {
       "minLength": 1,
       "type": "string"
      },
      "resource_type": {
       "enum": [
        "trace",
        "span",
        "session"
       ],
       "type": "string"
      }
     },
     "required": [
      "resource_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "queueId": {
    "type": "string"
   }
  },
  "required": [
   "queueId",
   "items"
  ],
  "type": "object"
 },
 "name": "add_annotation_queue_items"
}
