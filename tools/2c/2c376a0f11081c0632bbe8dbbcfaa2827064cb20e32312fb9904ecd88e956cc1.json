{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "quotes:read",
     "quotes:answer"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Save your current application page"
 },
 "description": "Saves answers to ordinary questions on the connected quote\u2019s current application page and returns the updated page. A save can overwrite earlier answers and can start or resume eligible carrier processing under the website\u2019s existing rules; it is not final submission. Protected information, coverage choices, consent and signatures are not accepted. Takes the current baseRevision and an eventId; the same eventId with the same answers returns the original result.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "answers": {
    "description": "Only customer-confirmed facts from the current page with answerOnWebsite false; readonly prefills are server-owned",
    "items": {
     "additionalProperties": false,
     "properties": {
      "questionId": {
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      },
      "status": {
       "enum": [
        "confirmed",
        "unknown",
        "declined"
       ],
       "type": "string"
      },
      "value": {
       "anyOf": [
        {
         "maxLength": 4000,
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        },
        {
         "items": {
          "maxLength": 500,
          "type": "string"
         },
         "maxItems": 100,
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "questionId",
      "status",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "baseRevision": {
    "description": "Current baseRevision returned by get_current_page",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "eventId": {
    "description": "Unique submission ID; retry identical answers with the same eventId",
    "pattern": "^[A-Za-z0-9_-]{8,128}$",
    "type": "string"
   },
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "es"
    ],
    "type": "string"
   }
  },
  "required": [
   "eventId",
   "baseRevision",
   "answers"
  ],
  "type": "object"
 },
 "name": "answer_quote_page",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "baseRevision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "demo": {
    "type": "boolean"
   },
   "formId": {
    "type": "string"
   },
   "formRevisionId": {
    "type": "string"
   },
   "geography": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "basis": {
        "enum": [
         "license",
         "product"
        ],
        "type": "string"
       },
       "eligible": {
        "type": "boolean"
       },
       "state": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "eligible",
       "state"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "nextStep": {
    "type": "string"
   },
   "page": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "answerSchema": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "id": {
        "type": "string"
       },
       "index": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "pageCount": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "questions": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "answerOnWebsite": {
           "type": "boolean"
          },
          "control": {
           "type": "string"
          },
          "helpText": {
           "type": "string"
          },
          "id": {
           "type": "string"
          },
          "label": {
           "type": "string"
          },
          "options": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "label": {
              "type": "string"
             },
             "value": {
              "anyOf": [
               {
                "type": "string"
               },
               {
                "type": "number"
               },
               {
                "type": "boolean"
               }
              ]
             }
            },
            "required": [
             "value",
             "label"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "prefillValue": {
           "anyOf": [
            {
             "maxLength": 4000,
             "type": "string"
            },
            {
             "type": "number"
            },
            {
             "type": "boolean"
            },
            {
             "items": {
              "maxLength": 500,
              "type": "string"
             },
             "maxItems": 100,
             "type": "array"
            },
            {
             "type": "null"
            }
           ]
          },
          "readOnly": {
           "type": "boolean"
          },
          "required": {
           "type": "boolean"
          }
         },
         "required": [
          "id",
          "label",
          "control",
          "required",
          "answerOnWebsite",
          "readOnly"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "title": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "title",
       "index",
       "pageCount",
       "questions",
       "answerSchema"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "quoteNumber": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "section": {
    "enum": [
     "easy",
     "recommendation",
     "application",
     "review",
     "waiting",
     "out_of_area",
     "cancelled"
    ],
    "type": "string"
   },
   "stage": {
    "type": "string"
   },
   "websiteRequired": {
    "type": "boolean"
   },
   "websiteRequiredReason": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "websiteUrl": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "demo",
   "quoteNumber",
   "formId",
   "formRevisionId",
   "baseRevision",
   "stage",
   "section",
   "websiteRequired",
   "websiteRequiredReason",
   "websiteUrl",
   "geography",
   "page",
   "nextStep"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "quotes:read",
    "quotes:answer"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Save your current application page"
}
