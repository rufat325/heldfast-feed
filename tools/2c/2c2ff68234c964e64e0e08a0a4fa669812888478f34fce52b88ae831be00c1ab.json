{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List the regulations and datasets covered"
 },
 "description": "Lists what RegAffairs AI covers (\"do you have the EU Cosmetics Regulation?\", \"which Brazil pesticide registers are in?\", \"what do you cover for food in the UK?\"), and checks before answering that a regulation or register is available. It returns the live catalogue: dataset id, plain name, regulator, jurisdiction, industry, what it contains and when it was last refreshed. Filter by industry, jurisdiction or a text query. It does not count as a question.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "industry": {
    "enum": [
     "chemicals",
     "ehs",
     "food",
     "cosmetics",
     "pesticides",
     "biocides",
     "pharma",
     "devices",
     "textiles"
    ],
    "type": "string"
   },
   "jurisdictions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "regaffairs_list_covered_regulations",
 "outputSchema": {
  "properties": {
   "datasets": {
    "items": {
     "properties": {
      "dataset_id": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "industry": {
       "type": "string"
      },
      "jurisdiction": {
       "type": "string"
      },
      "last_refreshed": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "regulator": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "source_url": {
       "type": "string"
      }
     },
     "required": [
      "dataset_id",
      "name",
      "jurisdiction",
      "industry",
      "last_refreshed"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "datasets",
   "total",
   "truncated"
  ],
  "type": "object"
 },
 "title": "List the regulations and datasets covered"
}
