{
 "_meta": {
  "openai/outputTemplate": "ui://starchild/player.html",
  "openai/toolInvocation/invoked": "Songs found",
  "openai/toolInvocation/invoking": "Searching the catalog\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "resourceUri": "ui://starchild/player.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search Starchild's catalog of original songs by meaning: describe the song in plain words (e.g. 'uplifting country ballad about starting over, female vocal'). Optional filters narrow by genre, mood, vocal or tempo. Shows an in-chat browser where every result plays, in every production style, with more results on request (use offset).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "genre": {
    "description": "e.g. Country, Pop, Rock, R&B, Holiday",
    "maxLength": 40,
    "type": "string"
   },
   "limit": {
    "default": 8,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "mood": {
    "description": "e.g. Uplifting, Romantic, Sad, Energetic",
    "maxLength": 40,
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "For more results: how many to skip",
    "maximum": 290,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "What the person is looking for, in their own words",
    "maxLength": 400,
    "type": "string"
   },
   "tempo": {
    "enum": [
     "Slow",
     "Medium",
     "Fast"
    ],
    "type": "string"
   },
   "vocal": {
    "enum": [
     "Female",
     "Male",
     "Duet",
     "Instrumental"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_songs",
 "title": "Find songs"
}
