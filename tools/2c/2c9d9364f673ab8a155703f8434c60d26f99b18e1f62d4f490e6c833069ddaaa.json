  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "minimum": 1,
    "type": "integer"
   },
   "provider_id": {
    "format": "uuid",
    "type": "string"
   },
   "query": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "service_type": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
