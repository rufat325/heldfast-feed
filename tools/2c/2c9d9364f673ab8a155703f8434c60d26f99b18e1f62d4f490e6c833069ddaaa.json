 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Homejourney services"
 },
 "description": "Use this to find active Homejourney services. A provider-published result identifies the provider, package, catalogue version, and price required for quoting and checkout: the Homejourney platform price for standardized packages, otherwise the provider-owned price. A result with priceSource launch_guide is a Homejourney catalog price with no provider yet: quote it with its platformUnitCount; the booking is offered to verified providers and the saved card is charged only after one accepts.",
