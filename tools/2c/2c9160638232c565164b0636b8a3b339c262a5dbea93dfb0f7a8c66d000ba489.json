{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create Destination Preset"
 },
 "description": "Create a destination preset: a saved set of channels with per-platform transformations, used to fan one post out across multiple channels. Saving a preset publishes nothing.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {
    "additionalProperties": true,
    "description": "Optional body override for endpoints with sparse parameter schemas.",
    "type": "object"
   },
   "brand_id": {
    "type": "string"
   },
   "channels": {
    "description": "Per-channel transformations",
    "items": {
     "properties": {
      "accountId": {
       "type": "string"
      },
      "platform": {
       "type": "string"
      },
      "transform": {
       "properties": {
        "appendUtm": {
         "description": "Add UTM parameters to links",
         "type": "boolean"
        },
        "captionMode": {
         "enum": [
          "inherit",
          "custom_template"
         ],
         "type": "string"
        },
        "captionTemplate": {
         "description": "Custom caption for this channel",
         "type": "string"
        },
        "hashtagSwap": {
         "description": "Hashtags to add or override",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "offsetSeconds": {
         "description": "Media timing offset in seconds",
         "type": "number"
        }
       },
       "type": "object"
      }
     },
     "required": [
      "platform",
      "accountId"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   },
   "defaults": {
    "description": "Default transformations for all channels",
    "properties": {
     "appendUtm": {
      "type": "boolean"
     },
     "captionTemplate": {
      "type": "string"
     },
     "offsetSeconds": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "idempotency_key": {
    "type": "string"
   },
   "name": {
    "description": "Preset name",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "additionalProperties": true,
    "description": "Optional query overrides for endpoints with sparse parameter schemas.",
    "type": "object"
   },
   "workspace_id": {
    "description": "Workspace to operate in: the `id` of a workspace returned by aidelly_list_workspaces. Optional for read operations; required when creating content.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "idempotency_key",
   "name",
   "channels"
  ],
  "type": "object"
 },
 "name": "aidelly_create_destination_preset",
 "securitySchemes": [
  {
   "scopes": [
    "destination-presets:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Create Destination Preset"
}
