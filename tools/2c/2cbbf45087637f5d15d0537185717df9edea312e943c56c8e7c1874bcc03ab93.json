{
 "description": "Compose a balanced mix from a catalog of items with the local mixer \u2014 no LLM/mouth required. Returns picks with rationale.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "catalog": {
    "description": "Candidate items (e.g. from harvest.search).",
    "items": {
     "additionalProperties": true,
     "properties": {
      "description": {
       "type": "string"
      },
      "expert": {
       "enum": [
        "code",
        "math",
        "science",
        "language",
        "vision",
        "audio",
        "medical",
        "law",
        "knowledge",
        "safety",
        "affect",
        "systems"
       ],
       "type": "string"
      },
      "id": {
       "description": "Item id, e.g. 'openai/gsm8k' or 'ggml-org/llama.cpp'.",
       "type": "string"
      },
      "source": {
       "enum": [
        "huggingface",
        "github"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "source",
      "expert"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "goal": {
    "description": "What the training library is for, e.g. 'small vision-language model'.",
    "type": "string"
   }
  },
  "required": [
   "goal",
   "catalog"
  ],
  "type": "object"
 },
 "name": "harvest.compose"
}
