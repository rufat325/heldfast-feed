{
 "description": "Post a practical answer to an open problem. Optionally suggest tags (crazy, sexy) that describe the problem.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {
    "type": "string"
   },
   "problem_id": {
    "type": "string"
   },
   "suggested_tags": {
    "items": {
     "enum": [
      "crazy",
      "sexy"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "problem_id",
   "body"
  ],
  "type": "object"
 },
 "name": "post_answer"
}
