{
 "description": "Send a reply to a Gmail message",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "body": {
    "description": "Reply body content (plain text or HTML)",
    "minLength": 1,
    "type": "string"
   },
   "contentType": {
    "default": "text",
    "description": "Format of the body content",
    "enum": [
     "text",
     "html"
    ],
    "type": "string"
   },
   "id": {
    "description": "Gmail message ID to reply to",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "body"
  ],
  "type": "object"
 },
 "name": "message-respond",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "description": "Original message ID that was replied to",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "id"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
