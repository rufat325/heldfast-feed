{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "openid",
     "profile",
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return curated free CC0 sample sounds from the bounded Lots of Sounds catalog. No account is required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max 12",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Optional keyword filter over the free samples, e.g. 'rain'",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "browse_samples",
 "title": "Browse free sample sounds"
}
