    "type": "boolean"
   },
   "includeImportanceScore": {
    "default": true,
    "type": "boolean"
   },
   "language": {
    "default": "auto",
    "enum": [
     "en",
     "ko",
     "auto"
    ],
    "type": "string"
   },
   "maxDecisions": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "projectContext": {
    "type": "string"
   },
   "useAI": {
    "default": false,
    "type": "boolean"
   }
  },
  "required": [
   "conversationLog"
  ],
  "type": "object"
 },
 "name": "muse_summarize_design_decisions"
}
