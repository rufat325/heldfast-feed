{
 "description": "Ingest a new agent interaction event. Use this to track queries, completions, errors, and feedback for any AI agent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "description": "The agent that generated this event",
    "type": "string"
   },
   "error": {
    "description": "Error message if the interaction failed",
    "type": "string"
   },
   "event_type": {
    "default": "query_completed",
    "description": "Event type (e.g. 'query_completed', 'error', 'feedback')",
    "type": "string"
   },
   "latency_ms": {
    "description": "Response latency in milliseconds",
    "type": "number"
   },
   "prompt_tokens": {
    "description": "Number of prompt tokens used",
    "type": "number"
   },
   "query": {
    "description": "The query or task that was processed",
    "type": "string"
   },
   "response_tokens": {
    "description": "Number of response tokens used",
    "type": "number"
   },
   "success": {
    "default": true,
    "description": "Whether the interaction was successful",
    "type": "boolean"
   }
  },
  "required": [
   "agent_id"
  ],
  "type": "object"
 },
 "name": "track_event"
}
