{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Quarters"
 },
 "description": "Returns every processed 13F quarter with reported and prior-quarter filer counts, a default_ready selection heuristic, and whether the current caller can access that quarter. It never labels a quarter complete. latest is the newest default-ready quarter; latest_reported is the newest quarter with any processed filing. If the index cannot be loaded, returns source_unavailable rather than a successful empty result.\n\nWHEN TO USE: When you need to know which quarters can be passed as the optional 'quarter' parameter to other tools. Returns quickly; safe to call once per session.\n\nVERIFICATION: Cite record-level `source_url` filing or disclosure links when present.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "list_quarters",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "access": {
    "additionalProperties": false,
    "properties": {
     "limited_fields": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "message": {
      "type": "string"
     },
     "tier": {
      "type": "string"
     },
     "upgrade_url": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "tier",
     "limited_fields"
    ],
    "type": "object"
   },
   "data_status": {
    "additionalProperties": false,
    "properties": {
     "complete": {
      "const": false,
      "type": "boolean"
     },
     "message": {
      "type": "string"
     },
     "missing": {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "complete",
     "missing"
    ],
    "type": "object"
   },
   "latest": {
    "$ref": "#/properties/quarters/items/properties/quarter"
   },
   "latest_reported": {
    "$ref": "#/properties/quarters/items/properties/quarter"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "data_through": {
      "type": [
       "string",
       "null"
      ]
     },
     "source": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "quarters": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accessible_to_caller": {
       "type": "boolean"
      },
      "default_ready": {
       "type": "boolean"
      },
      "filers_reported": {
       "minimum": 0,
       "type": "integer"
      },
      "prior_quarter_filers": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "quarter": {
       "pattern": "^\\d{4}-Q[1-4]$",
       "type": "string"
      }
     },
     "required": [
      "quarter",
      "filers_reported",
      "prior_quarter_filers",
      "default_ready",
      "accessible_to_caller"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "quarters",
   "latest",
   "latest_reported"
  ],
  "type": "object"
 },
 "title": "List Quarters"
}
