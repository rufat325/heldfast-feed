      "minimum": -9007199254740991,
      "type": "integer"
     },
     "effectFailures": {
      "items": {
       "additionalProperties": {},
       "properties": {},
       "type": "object"
      },
      "type": "array"
     },
     "finalSnapshots": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
