       "type": "object"
      },
      "type": "array"
     },
     "changedEntities": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "changedPaths": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "changedRelationships": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
