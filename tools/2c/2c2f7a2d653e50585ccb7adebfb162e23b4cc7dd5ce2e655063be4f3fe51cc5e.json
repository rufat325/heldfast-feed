{
 "description": "Report an observed LLM call to the Circulara meter (tokens in/out, model). Use after completing model calls so the org's spend baseline is accurate.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "input_tokens": {
    "minimum": 0,
    "type": "integer"
   },
   "model": {
    "description": "provider/model id, e.g. anthropic/claude-haiku-4-5",
    "type": "string"
   },
   "output_tokens": {
    "minimum": 0,
    "type": "integer"
   },
   "session_id": {
    "type": "string"
   }
  },
  "required": [
   "model",
   "input_tokens",
   "output_tokens"
  ],
  "type": "object"
 },
 "name": "circulara_report"
}
