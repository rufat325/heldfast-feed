{
 "description": "Send a single prompt to any UnoRouter model and return the reply. Use search_models to find model IDs; :free models cost nothing (light per-model rate limit, rotate models if you hit 429).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "max_tokens": {
    "maximum": 32768,
    "minimum": 1,
    "type": "integer"
   },
   "model": {
    "description": "Model id, e.g. deepseek-v4-flash:free",
    "type": "string"
   },
   "prompt": {
    "description": "The user prompt",
    "type": "string"
   },
   "system": {
    "description": "Optional system prompt",
    "type": "string"
   },
   "temperature": {
    "maximum": 2,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "model",
   "prompt"
  ],
  "type": "object"
 },
 "name": "chat",
 "title": "Chat with a UnoRouter model"
}
