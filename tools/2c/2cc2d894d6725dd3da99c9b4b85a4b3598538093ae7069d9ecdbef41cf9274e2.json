{
 "description": "Double tap at a point on screen. Triggers zoom, text selection, or double-tap gestures. Two rapid taps with a configurable interval.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "intervalMs": {
    "default": 80,
    "description": "Interval between taps in ms (20-500, default 80)",
    "maximum": 500,
    "minimum": 20,
    "type": "integer"
   },
   "x": {
    "description": "X coordinate",
    "maximum": 9999,
    "minimum": 0,
    "type": "integer"
   },
   "y": {
    "description": "Y coordinate",
    "maximum": 9999,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "x",
   "y"
  ],
  "type": "object"
 },
 "name": "adb_input_double_tap"
}
