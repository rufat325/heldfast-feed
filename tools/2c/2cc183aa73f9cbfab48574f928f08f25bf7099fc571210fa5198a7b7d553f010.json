{
 "description": "List all orders with optional filters. Returns order history with references, dates, prices, delivery addresses, and status.\n\nID fields in the response:\n- \"number\" = Probo's supplier_order_number (visible in Probo dashboard)\n- \"customer_order_id\" = the order ID from placeOrder (use this for getOrderStatus and cancelOrder)\n- \"customer_reference\" = your reference string from placeOrder",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filters": {
    "additionalProperties": false,
    "description": "Filters for orders query",
    "properties": {
     "customer_order_id": {
      "description": "Filter by customer order ID",
      "minLength": 1,
      "type": "string"
     },
     "order_date_from": {
      "description": "ISO date \u2014 lower bound (inclusive)",
      "minLength": 1,
      "type": "string"
     },
     "order_date_to": {
      "description": "ISO date \u2014 upper bound (inclusive)",
      "minLength": 1,
      "type": "string"
     },
     "page": {
      "description": "Page number (1-based)",
      "minimum": 1,
      "type": "integer"
     },
     "per_page": {
      "description": "Results per page (1\u201350)",
      "maximum": 50,
      "minimum": 1,
      "type": "integer"
     },
     "status": {
      "description": "Filter by status code",
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "getAllOrders"
}
