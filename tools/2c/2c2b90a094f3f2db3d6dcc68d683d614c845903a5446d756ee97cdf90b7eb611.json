{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get time series"
 },
 "description": "Time series values for one country from a dataset (oldest first). Optionally pick a series by exact dimension values (from inspect_dataset) and a start period such as 2015, Q1/2015 or 01/2015.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "Country, e.g. 'Poland'. Defaults to the dataset's default country.",
    "type": "string"
   },
   "dim1": {
    "description": "Optional exact value of dimension 1.",
    "type": "string"
   },
   "dim2": {
    "description": "Optional exact value of dimension 2.",
    "type": "string"
   },
   "dim3": {
    "description": "Optional exact value of dimension 3.",
    "type": "string"
   },
   "dim4": {
    "description": "Optional exact value of dimension 4.",
    "type": "string"
   },
   "id": {
    "description": "Dataset id from search_catalog.",
    "type": "integer"
   },
   "max_points": {
    "description": "Max points, most recent kept (default 200).",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "period_from": {
    "description": "Optional first period to include, e.g. '2015'.",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_series",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Get time series"
}
