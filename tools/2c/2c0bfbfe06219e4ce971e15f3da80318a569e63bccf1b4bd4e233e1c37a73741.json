{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get KOL performance rankings by PnL and win rate. PRO+ can sort by alternative axes (winrate/volume/avg_roi/profit_factor/early_entry_pct/consistency).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 20,
    "description": "Number of KOLs to return in ranking",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "min_winrate": {
    "description": "PRO+: minimum winrate cutoff (0-100)",
    "type": "number"
   },
   "period": {
    "default": "7d",
    "description": "Time period (trade retention is 180d)",
    "enum": [
     "today",
     "7d",
     "30d",
     "90d",
     "180d"
    ],
    "type": "string"
   },
   "sort": {
    "description": "PRO+: sort axis (default 'pnl')",
    "enum": [
     "pnl",
     "winrate",
     "volume",
     "avg_roi",
     "profit_factor",
     "early_entry_pct",
     "consistency"
    ],
    "type": "string"
   },
   "strategy": {
    "description": "PRO+: filter by strategy tag",
    "enum": [
     "scalper",
     "day_trader",
     "swing_trader",
     "hodler",
     "mixed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "madeonsol_kol_leaderboard"
}
