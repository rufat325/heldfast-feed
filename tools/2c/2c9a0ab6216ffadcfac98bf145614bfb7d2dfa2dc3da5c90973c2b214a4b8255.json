{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "PAID prepaid-credit XKEY intake validation. Requires an authenticated ck_ principal and commits one credit only on verified success. Discovery is free; execution is not.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "idempotency_key": {
    "description": "Unique client-generated idempotency key; 8-160 ASCII characters.",
    "maxLength": 160,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "raw_intake": {
    "description": "Raw intake text to validate and normalize; 2-100000 characters.",
    "maxLength": 100000,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "idempotency_key",
   "raw_intake"
  ],
  "type": "object"
 },
 "name": "xkey.validate",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance": {},
   "capability": {
    "type": "string"
   },
   "credits_charged": {},
   "normalized": {},
   "receipt_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "request_hash": {
    "type": [
     "string",
     "null"
    ]
   },
   "reservation_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "state": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "capability",
   "state",
   "success"
  ],
  "type": "object"
 },
 "title": "Validate structured XKEY intake"
}
