 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Category name (e.g. 'Restaurant', 'Home')",
    "type": "string"
   },
   "comment": {
    "description": "A comment or note",
    "type": "string"
   },
   "extensions": {
    "description": "Extra data as a string",
    "type": "string"
   },
   "lat": {
    "description": "Latitude",
    "type": "number"
   },
   "lng": {
    "description": "Longitude",
    "type": "number"
   },
   "myMapId": {
    "description": "ID of a custom map to scope the operation to; omit for the user's default map",
    "type": "number"
   },
   "name": {
    "description": "Name of the location",
    "type": "string"
   }
  },
