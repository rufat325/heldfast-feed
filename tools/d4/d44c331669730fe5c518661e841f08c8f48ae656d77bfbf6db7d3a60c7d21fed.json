{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find an AI model by creation task and verified constraints. Editorial recommendation; not a benchmark score.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "constraints": {
    "additionalProperties": false,
    "properties": {
     "audio": {
      "type": "boolean"
     },
     "budget": {
      "enum": [
       "draft",
       "flexible"
      ],
      "type": "string"
     },
     "duration": {
      "minimum": 1,
      "type": "number"
     },
     "input": {
      "enum": [
       "text",
       "image",
       "video",
       "youtube"
      ],
      "type": "string"
     },
     "output": {
      "enum": [
       "video",
       "image",
       "any"
      ],
      "type": "string"
     },
     "platform": {
      "enum": [
       "portrait",
       "landscape",
       "any"
      ],
      "type": "string"
     },
     "style": {
      "enum": [
       "realistic",
       "cinematic",
       "stylized"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "task": {
    "enum": [
     "ai-influencer",
     "ai-video-generator",
     "character-consistency",
     "cinematic-video",
     "image-to-video",
     "product-shots",
     "product-videos",
     "realistic-humans",
     "social-shorts",
     "talking-characters",
     "text-in-images",
     "ugc-ads"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_model"
}
