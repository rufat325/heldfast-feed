{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Readiness audit of any agent-facing URL: MCP handshake, CORS, discovery docs (llms.txt, mcp.json), and payment-offer behaviour. First call with url alone for the FREE grade and failing-check list. For the full findings and remediations, call get_offer with productType \"audit\" and productId \"conformance-report\", pay, then call audit_endpoint again with the same url plus paymentTx and paymentOffer. This tool both previews and redeems the paid report; no separate delivery tool is needed.",
 "inputSchema": {
  "properties": {
   "paymentOffer": {
    "description": "Signed offer token from get_offer (productType: audit)",
    "type": "string"
   },
   "paymentTx": {
    "description": "Base Pay UserOperation hash for USDC or Base transaction hash for ETH, for the full paid report",
    "type": "string"
   },
   "url": {
    "description": "Base URL to audit, e.g. https://your-agent.example.com",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "audit_endpoint",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "checkedAt": {
    "format": "date-time",
    "type": "string"
   },
   "checks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "check": {
       "type": "string"
      },
      "detail": {
       "description": "Paid report finding; omitted from the free grade.",
       "type": "string"
      },
      "remediation": {
       "description": "Paid remediation; omitted from the free grade.",
       "type": "string"
      },
      "status": {
       "enum": [
        "pass",
        "warn",
        "fail",
        "na"
       ],
       "type": "string"
      }
     },
     "required": [
      "check",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "description": "Machine-readable failure code.",
    "type": "string"
   },
   "grade": {
    "description": "Overall readiness grade.",
    "type": "string"
   },
   "paidReport": {
    "additionalProperties": true,
    "description": "Purchase instructions included with an unpaid report.",
    "type": "object"
   },
   "paymentDeclined": {
    "type": "string"
   },
   "receipt": {
    "additionalProperties": false,
    "description": "Machine-readable receipt derived by KnownFix after signed-offer and Base proof verification; never accepted from caller input.",
    "properties": {
     "custody_model": {
      "enum": [
       "direct-settlement"
      ],
      "type": "string"
     },
     "lifecycle": {
      "additionalProperties": false,
      "properties": {
       "authorization": {
        "enum": [
         "offer-verified"
        ],
        "type": "string"
       },
       "fulfillment": {
        "enum": [
         "pending",
         "released",
         "declined"
        ],
        "type": "string"
       },
       "settlement": {
        "enum": [
         "confirmed"
        ],
        "type": "string"
       }
      },
      "required": [
       "authorization",
       "settlement",
       "fulfillment"
      ],
      "type": "object"
     },
     "proof": {
      "additionalProperties": false,
      "properties": {
       "chain_id": {
        "const": 8453,
        "type": "integer"
       },
       "network": {
        "enum": [
         "base-mainnet"
        ],
        "type": "string"
       },
       "type": {
        "enum": [
         "erc-4337-user-operation-hash",
         "transaction-hash"
        ],
        "type": "string"
       }
      },
      "required": [
       "network",
       "chain_id",
       "type"
      ],
      "type": "object"
     },
     "reversal_supported": {
      "const": false,
      "type": "boolean"
     },
     "scheme": {
      "enum": [
       "base-pay-usdc",
       "base-exact-eth"
      ],
      "type": "string"
     },
     "spec": {
      "enum": [
       "knownfix-payment-receipt/1.0"
      ],
      "type": "string"
     }
    },
    "required": [
     "spec",
     "scheme",
     "custody_model",
     "reversal_supported",
     "lifecycle",
     "proof"
    ],
    "type": "object"
   },
   "soldTo": {
    "type": "string"
   },
   "summary": {
    "additionalProperties": true,
    "type": "object"
   },
   "target": {
    "description": "Canonical URL that was audited.",
    "type": "string"
   },
   "tier": {
    "enum": [
     "free-grade",
     "full-report"
    ],
    "type": "string"
   },
   "via": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Audit an agent endpoint"
}
