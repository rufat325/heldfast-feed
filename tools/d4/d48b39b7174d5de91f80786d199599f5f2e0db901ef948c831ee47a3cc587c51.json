{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Buy a Daski outcome"
 },
 "description": "Buy one committed Daski outcome. First call returns a standard x402 payment requirement; retry the identical providerAgentId, outcomeId, and request with the signed payment in _meta[\"x402/payment\"] (preferred) or paymentPayload (expert path). Fixed outcomes support stock Exact-EVM clients; input-bearing outcomes require the published Daski nonce recipe.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "outcomeId": {
    "minLength": 1,
    "type": "string"
   },
   "payerAddress": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "paymentPayload": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "providerAgentId": {
    "minLength": 1,
    "type": "string"
   },
   "request": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "providerAgentId",
   "outcomeId",
   "request"
  ],
  "type": "object"
 },
 "name": "daski_buy_outcome",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {},
  "type": "object"
 }
}
