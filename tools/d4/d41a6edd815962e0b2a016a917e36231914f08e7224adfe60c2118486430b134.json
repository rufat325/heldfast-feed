{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Code-Fundi Research"
 },
 "description": "Search Code-Fundi repositories AND get an AI-synthesized analysis of the results. This performs a search, then streams an AI response that analyzes the matching code files. Use this when you need both code context and an intelligent summary/explanation.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dependencies": {
    "description": "Filter by dependencies in code summaries",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "fields": {
    "description": "Documentation detail level",
    "enum": [
     "basic",
     "summary",
     "full"
    ],
    "type": "string"
   },
   "file_paths": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "file_types": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "function_names": {
    "description": "Filter by function names",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "has_functions": {
    "description": "Only files with functions",
    "type": "boolean"
   },
   "max_lines": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "min_lines": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "model": {
    "description": "AI model to use for analysis",
    "type": "string"
   },
   "query": {
    "description": "The research query",
    "type": "string"
   },
   "repo_ids": {
    "description": "Filter by repository UUIDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "repo_urls": {
    "description": "Filter by repository clone URLs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "scan_mode": {
    "description": "Search mode",
    "enum": [
     "semantic",
     "grep_docs",
     "grep_code"
    ],
    "type": "string"
   },
   "scope": {
    "description": "Search scope",
    "enum": [
     "all",
     "repos",
     "files",
     "code",
     "functions"
    ],
    "type": "string"
   },
   "similarity_threshold": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "visibility": {
    "enum": [
     "private",
     "public",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "code-fundi-research"
}
