  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks which single ingredient or bottle to add to unlock the most new cocktails from what they already have. Returns the one catalog bottle that unlocks the most drinks. Set zero_proof_only when the user wants drinks without alcohol. It does not sell anything or link to a store. Pass kind bottle when the user says bottle, spirit, liquor, or booze; otherwise leave kind as any. A bottle is a spirit, liqueur, vermouth, amaro, wine, or bitters, not a juice, syrup, or garnish.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ingredients": {
    "items": {
     "maxLength": 60,
     "type": "string"
    },
    "maxItems": 40,
    "minItems": 1,
    "type": "array"
   },
   "kind": {
    "default": "any",
    "description": "Pass bottle when the user says bottle, spirit, liquor, or booze. any also allows juices, syrups, garnishes, and mixers.",
    "enum": [
     "bottle",
     "any"
    ],
    "type": "string"
   },
   "limit": {
    "default": 1,
    "description": "How many bottles to return. Defaults to the single best one.",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "zero_proof_only": {
    "default": false,
    "description": "When true, only count zero-proof catalog drinks.",
    "type": "boolean"
   }
  },
  "required": [
   "ingredients"
  ],
  "type": "object"
 },
 "name": "suggest_next_ingredient",
