     "effective_from": {
      "type": "string"
     },
     "effective_to": {
      "type": "string"
     },
     "past_corrected": {
      "type": "boolean"
     },
     "requested_from": {
      "type": "string"
     },
     "requested_to": {
      "type": "string"
     },
     "swapped": {
      "type": "boolean"
     },
     "today": {
      "type": "string"
     }
    },
    "required": null,
    "type": "object"
   },
   "earliest": {
    "properties": {
     "date": {
