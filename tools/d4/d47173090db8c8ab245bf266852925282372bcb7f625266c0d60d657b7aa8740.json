      "type": "string"
     },
     "end": {
      "format": "date-time",
      "type": "string"
     },
     "provider": {
      "type": "string"
     },
     "slot_fingerprint": {
      "type": "string"
     },
     "start": {
      "format": "date-time",
      "type": "string"
     },
     "time": {
      "type": "string"
     }
    },
    "required": [
     "slot_fingerprint",
     "date",
     "time",
     "display",
     "start",
     "end"
    ],
    "type": "object"
   },
   "effective_from": {
    "type": "string"
   },
   "effective_to": {
    "type": "string"
   },
   "instructions": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "practice": {
