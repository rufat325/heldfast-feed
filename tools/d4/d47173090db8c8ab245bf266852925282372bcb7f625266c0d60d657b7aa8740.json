 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List open times at a connected practice for one service between date_from and date_to (inclusive, at most 8 weeks out). Returns the closest ten to preferred_time (else a balanced spread) plus the earliest open time, with a reason when empty. Each slot has a slot_fingerprint and date for hold_xona_booking_slot.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "date_from": {
    "description": "First day to search, in the practice's time zone",
    "format": "date",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "date_to": {
    "description": "Last day to search (inclusive); at most 56 days after date_from and 8 weeks from today",
    "format": "date",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "doctor_id": {
    "description": "Restrict to one provider, using a doctor_id a previous slot listing returned",
    "maxLength": 160,
    "type": "string"
   },
   "practice_slug": {
    "maxLength": 140,
    "minLength": 1,
    "type": "string"
   },
   "preferred_time": {
    "description": "The patient's preferred local start time, 24-hour HH:MM; slots closest to it come first",
    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
    "type": "string"
   },
   "service_id": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "practice_slug",
   "service_id",
   "date_from",
   "date_to"
  ],
  "type": "object"
 },
 "name": "list_xona_booking_slots",
 "outputSchema": {
