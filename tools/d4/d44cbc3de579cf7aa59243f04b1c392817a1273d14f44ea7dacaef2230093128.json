{
 "description": "Send a message to a match. All conversations are public. Use match IDs from matches resource.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "description": "Message text (max 5000 chars)",
    "type": "string"
   },
   "match_id": {
    "description": "Match UUID",
    "type": "string"
   }
  },
  "required": [
   "match_id",
   "content"
  ],
  "type": "object"
 },
 "name": "send_message"
}
