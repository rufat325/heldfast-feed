{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Agent"
 },
 "description": "Update agent",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentId": {
    "type": "string"
   },
   "data": {
    "additionalProperties": false,
    "properties": {
     "avatar": {
      "additionalProperties": false,
      "properties": {
       "data": {
        "additionalProperties": false,
        "properties": {
         "value": {
          "description": "Pick the most suitable emoji for this agent.",
          "type": "string"
         }
        },
        "required": [
         "value"
        ],
        "type": "object"
       },
       "type": {
        "const": "emoji",
        "type": "string"
       }
      },
      "required": [
       "type",
       "data"
      ],
      "type": "object"
     },
     "commands": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "description": "ID based on the name in snake case.",
         "minLength": 1,
         "type": "string"
        },
        "mode": {
         "default": "default",
         "enum": [
          "default",
          "plan-and-execute-v1",
          "plan-and-execute-v2"
         ],
         "type": "string"
        },
        "name": {
         "description": "Human-readable name of the command in title case. This should probably be a verb.",
         "minLength": 1,
         "type": "string"
        },
        "prompt": {
         "description": "Tell the agent what this command will do. It should be positioned as a direct instruction to the agent. At least 30 words.",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "name",
        "prompt",
        "id"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "description": {
      "description": "Role and purpose of agent, positioned as a direct instruction to the agent. Example: \"You are a doctor that helps save lives.\". At least 100 words.",
      "type": "string"
     },
     "inputPlaceholder": {
      "type": "string"
     },
     "knowledgeEnabled": {
      "type": "boolean"
     },
     "language": {
      "description": "The language of the agent, e.g. en-US, zh-Hans",
      "type": "string"
     },
     "tone": {
      "enum": [
       "authoritative",
       "clinical",
       "cold",
       "confident",
       "cynical",
       "emotional",
       "empathetic",
       "formal",
       "friendly",
       "humourous",
       "informal",
       "ironic",
       "optimistic",
       "pessimistic",
       "playful",
       "sarcastic",
       "serious",
       "sympathetic",
       "tentative",
       "warm",
       "creative",
       "inspiring",
       "casual"
      ],
      "type": "string"
     }
    },
    "required": [
     "commands"
    ],
    "type": "object"
   },
   "name": {
    "type": "string"
   }
  },
  "required": [
   "agentId"
  ],
  "type": "object"
 },
 "name": "agentUpdate"
}
