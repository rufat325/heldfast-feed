{
 "description": "Find and redact PII in a PDF in ONE on-device step: scan, keep only the requested entity kinds (email/ssn/phone/card plus the Australian tfn/abn/acn/medicare/crn/ihi/bsb \u2014 omit `kinds` to redact every kind detected), remove them, verify, and return what was redacted plus the audit log. This is the 'just scrub the obvious PII' shortcut; when you need to review before removing, call find_sensitive_regions first. Same caveat as the detector: matches are best-effort pattern matching, not a completeness guarantee and not a compliance assessment. Nothing is uploaded.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "drawBox": {
    "description": "also paint a black bar (default: opaque fill only)",
    "type": "boolean"
   },
   "kinds": {
    "description": "entity kinds to redact; omit to redact all detected",
    "items": {
     "enum": [
      "email",
      "ssn",
      "phone",
      "card",
      "tfn",
      "abn",
      "acn",
      "medicare",
      "crn",
      "ihi",
      "bsb"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "outputPath": {
    "description": "absolute path to write the redacted PDF",
    "type": "string"
   },
   "pdfPath": {
    "description": "absolute path to the source PDF",
    "type": "string"
   },
   "regions": {
    "description": "narrow to these regional packs (intersects with `kinds`); omit for all",
    "items": {
     "enum": [
      "generic",
      "us",
      "au"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "pdfPath",
   "outputPath"
  ],
  "type": "object"
 },
 "name": "redact_by_entity",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audit": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "disclosures": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "license": {
        "type": "string"
       },
       "licensedTo": {
        "type": [
         "string",
         "null"
        ]
       },
       "metadataScrubbed": {
        "type": "boolean"
       },
       "regions": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "bbox": {
           "additionalProperties": false,
           "properties": {
            "height": {
             "type": "number"
            },
            "width": {
             "type": "number"
            },
            "x": {
             "type": "number"
            },
            "y": {
             "type": "number"
            }
           },
           "required": [
            "x",
            "y",
            "width",
            "height"
           ],
           "type": "object"
          },
          "page": {
           "type": "integer"
          },
          "reason_code": {
           "type": "string"
          },
          "timestamp": {
           "type": "string"
          },
          "verification": {
           "anyOf": [
            {
             "additionalProperties": false,
             "properties": {
              "result": {
               "const": "pass",
               "type": "string"
              }
             },
             "required": [
              "result"
             ],
             "type": "object"
            },
            {
             "additionalProperties": false,
             "properties": {
              "detail": {
               "type": "string"
              },
              "result": {
               "const": "fail",
               "type": "string"
              }
             },
             "required": [
              "result",
              "detail"
             ],
             "type": "object"
            }
           ]
          }
         },
         "required": [
          "page",
          "bbox",
          "timestamp",
          "reason_code",
          "verification"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "verdict": {
        "enum": [
         "pass",
         "fail"
        ],
        "type": "string"
       },
       "warnings": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "verdict",
       "regions",
       "warnings",
       "metadataScrubbed",
       "license",
       "licensedTo",
       "disclosures"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "output": {
    "type": [
     "string",
     "null"
    ]
   },
   "redacted": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string"
      },
      "page": {
       "type": "integer"
      },
      "preview": {
       "type": "string"
      }
     },
     "required": [
      "page",
      "kind",
      "preview"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "redactedCount": {
    "minimum": 0,
    "type": "integer"
   },
   "verdict": {
    "anyOf": [
     {
      "enum": [
       "pass",
       "fail"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "output",
   "redactedCount",
   "redacted",
   "verdict",
   "audit"
  ],
  "type": "object"
 }
}
