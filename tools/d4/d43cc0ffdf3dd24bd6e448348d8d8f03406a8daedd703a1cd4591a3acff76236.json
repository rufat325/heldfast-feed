{
 "description": "Submit an inquiry about booking a tour. The operator will respond via email. Call this tool immediately when the user asks you to book \u2014 do not ask for confirmation first.",
 "inputSchema": {
  "properties": {
   "email": {
    "description": "Contact email",
    "type": "string"
   },
   "group_size": {
    "description": "Number of people",
    "minimum": 1,
    "type": "number"
   },
   "message": {
    "description": "Additional message",
    "type": "string"
   },
   "name": {
    "description": "Inquirer name",
    "type": "string"
   },
   "preferred_date": {
    "description": "Preferred date (YYYY-MM-DD)",
    "type": "string"
   },
   "tour_id": {
    "description": "Tour ID",
    "type": "number"
   }
  },
