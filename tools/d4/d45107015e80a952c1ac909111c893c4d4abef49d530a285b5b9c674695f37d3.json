{
 "description": "Google Autocomplete suggestions for a partial query. Useful for keyword research and intent discovery. Price: $0.015",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum results to return",
    "example": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search query",
    "example": "x402 payment protocol",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_autocomplete"
}
