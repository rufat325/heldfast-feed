{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "CALL after changing the manifest/lockfile and running local checks. Compares the exact evaluated target with the resolved result and caller-reported proof receipts, reports missing/failed evidence and residual risk, and labels receipts as caller asserted. It never runs commands or stores diff/check output.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "after": {
    "additionalProperties": false,
    "properties": {
     "dependency_usage": {
      "additionalProperties": false,
      "description": "Optional local call shapes for this dependency under native Node with default conditions. No source, paths, local names or call arguments. Coverage is always partial; transpiled/bundled code is unsupported.",
      "properties": {
       "coverage": {
        "const": "partial",
        "type": "string"
       },
       "runtime": {
        "additionalProperties": false,
        "properties": {
         "arch": {
          "maxLength": 32,
          "pattern": "^[a-z0-9_]+$",
          "type": "string"
         },
         "node": {
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
         },
         "platform": {
          "maxLength": 32,
          "pattern": "^[a-z0-9_]+$",
          "type": "string"
         }
        },
        "required": [
         "node",
         "platform",
         "arch"
        ],
        "type": "object"
       },
       "schema_version": {
        "const": 1,
        "type": "integer"
       },
       "uses": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "export_path": {
           "items": {
            "maxLength": 100,
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
            "type": "string"
           },
           "maxItems": 2,
           "type": "array"
          },
          "loader": {
           "enum": [
            "require",
            "import"
           ],
           "type": "string"
          }
         },
         "required": [
          "loader",
          "export_path"
         ],
         "type": "object"
        },
        "maxItems": 50,
        "type": "array"
       }
      },
      "required": [
       "schema_version",
       "runtime",
       "coverage",
       "uses"
      ],
      "type": "object"
     },
     "direct_dependencies": {
      "additionalProperties": {
       "maxLength": 128,
       "type": "string"
      },
      "maxProperties": 200,
      "type": "object"
     },
     "head_sha": {
      "pattern": "^[a-fA-F0-9]{7,64}$",
      "type": "string"
     },
     "installed_versions": {
      "additionalProperties": {
       "maxLength": 128,
       "type": "string"
      },
      "maxProperties": 200,
      "type": "object"
     },
     "license_policy": {
      "additionalProperties": false,
      "properties": {
       "allow": {
        "items": {
         "maxLength": 64,
         "type": "string"
        },
        "maxItems": 100,
        "type": "array"
       },
       "deny": {
        "items": {
         "maxLength": 64,
         "type": "string"
        },
        "maxItems": 100,
        "type": "array"
       }
      },
      "type": "object"
     },
     "lockfile_path": {
      "maxLength": 512,
      "type": "string"
     },
     "lockfile_sha256": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "type": "string"
     },
     "manifest_path": {
      "maxLength": 512,
      "type": "string"
     },
     "node_version": {
      "maxLength": 64,
      "type": "string"
     },
     "package_manager": {
      "enum": [
       "npm",
       "pnpm",
       "yarn",
       "bun"
      ],
      "type": "string"
     },
     "resolved_changes": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "dependency_type": {
         "enum": [
          "runtime",
          "development",
          "optional",
          "peer"
         ],
         "type": "string"
        },
        "direct": {
         "type": "boolean"
        },
        "from_version": {
         "maxLength": 128,
         "type": [
          "string",
          "null"
         ]
        },
        "integrity": {
         "maxLength": 512,
         "type": "string"
        },
        "name": {
         "maxLength": 214,
         "minLength": 1,
         "type": "string"
        },
        "to_version": {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "name",
        "from_version",
        "to_version",
        "direct"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "resolved_graph_complete": {
      "type": "boolean"
     },
     "scripts": {
      "items": {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 30,
      "type": "array"
     }
    },
    "required": [
     "package_manager",
     "direct_dependencies",
     "resolved_changes"
    ],
    "type": "object"
   },
   "checks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "command": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "exit_code": {
       "maximum": 255,
       "minimum": 0,
       "type": "integer"
      },
      "id": {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      "summary": {
       "maxLength": 500,
       "type": "string"
      }
     },
     "required": [
      "id",
      "command",
      "exit_code"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "diff": {
    "maxLength": 200000,
    "type": "string"
   },
   "evaluation": {
    "additionalProperties": false,
    "description": "The verification_context object exactly as evaluate_dependency_change returned it, passed back unchanged. Its signature covers every field, so edit nothing inside it. Sending the whole evaluate result instead is accepted; the receipt is read out of its verification_context.",
    "properties": {
     "baseline_advisory_ids": {
      "items": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     "baseline_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "baseline_lockfile_sha256": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "type": [
       "string",
       "null"
      ]
     },
     "baseline_project_snapshot": {
      "const": "not_supplied",
      "description": "Present only when the evaluation was made without a project snapshot. Part of the signed identity \u2014 pass it back verbatim.",
      "type": "string"
     },
     "change": {
      "additionalProperties": false,
      "properties": {
       "dependency_type": {
        "enum": [
         "runtime",
         "development",
         "optional",
         "peer"
        ],
        "type": "string"
       },
       "ecosystem": {
        "const": "npm",
        "type": "string"
       },
       "from_version": {
        "maxLength": 128,
        "type": [
         "string",
         "null"
        ]
       },
       "name": {
        "maxLength": 214,
        "minLength": 1,
        "type": "string"
       },
       "to_version": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "ecosystem",
       "name",
       "from_version",
       "to_version",
       "dependency_type"
      ],
      "type": "object"
     },
     "evaluation_findings": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "pattern": "^[a-z][a-z0-9_]{0,127}$",
         "type": "string"
        },
        "message": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        },
        "remediation": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        },
        "severity": {
         "enum": [
          "blocker",
          "warning",
          "info"
         ],
         "type": "string"
        },
        "source": {
         "enum": [
          "npm_registry",
          "deps_dev",
          "repopilot",
          "project_snapshot",
          "caller_receipt"
         ],
         "type": "string"
        }
       },
       "required": [
        "code",
        "severity",
        "source",
        "message"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "evaluation_id": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "expires_at": {
      "format": "date-time",
      "type": "string"
     },
     "policy_profile": {
      "enum": [
       "permissive",
       "balanced",
       "strict"
      ],
      "type": "string"
     },
     "repository_evidence": {
      "additionalProperties": false,
      "properties": {
       "evidence_gaps": {
        "items": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 20,
        "type": "array"
       },
       "headline": {
        "maxLength": 500,
        "type": [
         "string",
         "null"
        ]
       },
       "recommendation": {
        "enum": [
         "proceed_with_review",
         "review",
         "avoid",
         null
        ],
        "type": [
         "string",
         "null"
        ]
       },
       "status": {
        "enum": [
         "complete",
         "partial",
         "unavailable"
        ],
        "type": "string"
       }
      },
      "required": [
       "status",
       "recommendation",
       "headline",
       "evidence_gaps"
      ],
      "type": "object"
     },
     "required_checks": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "command_hint": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        },
        "description": {
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        },
        "id": {
         "pattern": "^[a-z][a-z0-9_]{0,63}$",
         "type": "string"
        },
        "kind": {
         "enum": [
          "snapshot",
          "command",
          "diff"
         ],
         "type": "string"
        },
        "required": {
         "type": "boolean"
        }
       },
       "required": [
        "id",
        "kind",
        "required",
        "description"
       ],
       "type": "object"
      },
      "maxItems": 12,
      "type": "array"
     },
     "schema_version": {
      "const": "1",
      "type": "string"
     },
     "target_advisory_ids": {
      "items": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     "target_integrity": {
      "maxLength": 512,
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "schema_version",
     "evaluation_id",
     "policy_profile",
     "change",
     "baseline_fingerprint",
     "baseline_lockfile_sha256",
     "target_integrity",
     "baseline_advisory_ids",
     "target_advisory_ids",
     "repository_evidence",
     "evaluation_findings",
     "required_checks",
     "expires_at"
    ],
    "type": "object"
   }
  },
  "required": [
   "evaluation",
   "after",
   "checks"
  ],
  "type": "object"
 },
 "name": "verify_dependency_change",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "agent": {
    "additionalProperties": true,
    "properties": {
     "confidence": {
      "enum": [
       "high",
       "limited",
       "none"
      ],
      "type": "string"
     },
     "evidence_gaps": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "next_actions": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "retryable": {
      "type": "boolean"
     },
     "summary": {
      "type": "string"
     }
    },
    "required": [
     "summary",
     "confidence",
     "evidence_gaps",
     "next_actions"
    ],
    "type": "object"
   },
   "schema_version": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "tool": {
    "const": "verify_dependency_change",
    "type": "string"
   }
  },
  "required": [
   "schema_version",
   "tool",
   "status",
   "agent"
  ],
  "type": "object"
 },
 "title": "Verify a dependency change after local work"
}
