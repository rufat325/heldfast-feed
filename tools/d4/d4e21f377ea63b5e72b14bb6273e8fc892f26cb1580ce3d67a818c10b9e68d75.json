{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Add or remove a role across every member matching a filter. Safe to call directly: the first call returns the affected count and a confirm_token; repeating the call with the token applies the change. Walks up to 3000 members and reports if it hits the cap.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "assign",
     "remove"
    ],
    "type": "string"
   },
   "confirm_token": {
    "type": "string"
   },
   "dry_run": {
    "type": "boolean"
   },
   "filter": {
    "properties": {
     "has_role": {
      "description": "Members holding this role.",
      "type": "string"
     },
     "is_bot": {
      "type": "boolean"
     },
     "joined_after": {
      "description": "ISO date.",
      "type": "string"
     },
     "joined_before": {
      "description": "ISO date.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "role": {
    "description": "Role name or ID.",
    "type": "string"
   }
  },
  "required": [
   "action",
   "role"
  ],
  "type": "object"
 },
 "name": "bulk_update_roles",
 "title": "Bulk update roles"
}
