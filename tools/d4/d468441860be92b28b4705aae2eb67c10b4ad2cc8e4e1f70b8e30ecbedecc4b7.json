{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search resorts"
 },
 "description": "Find ski resorts worldwide by name, country or distance. Returns at most 20 matches and does not expose the bulk resort index.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "maxLength": 40,
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "near": {
    "additionalProperties": false,
    "properties": {
     "lat": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "lon": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     }
    },
    "required": [
     "lat",
     "lon"
    ],
    "type": "object"
   },
   "query": {
    "maxLength": 80,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_resorts",
 "title": "Search resorts"
}
