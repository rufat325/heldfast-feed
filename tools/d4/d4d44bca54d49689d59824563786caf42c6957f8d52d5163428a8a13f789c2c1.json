   },
   "paid_at_min": {
    "description": "Paid at or after (ISO-8601, e.g. 2026-03-23T15:30:00Z).",
    "type": "string"
   },
   "sort_by": {
    "description": "Attribute to sort by.",
    "enum": [
     "amount",
