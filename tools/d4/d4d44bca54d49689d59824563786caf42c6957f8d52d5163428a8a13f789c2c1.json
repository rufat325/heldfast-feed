 },
 "description": "List invoices across the company, filterable by status, customer, and created / due / paid date ranges \u2014 e.g. everything open and overdue. Amounts are in cents. Housecall Pro: GET /invoices.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "created_at_max": {
    "description": "Created at or before (ISO-8601, e.g. 2026-03-23T15:30:00Z).",
    "type": "string"
   },
   "created_at_min": {
    "description": "Created at or after (ISO-8601, e.g. 2026-03-23T15:30:00Z).",
    "type": "string"
   },
   "customer_uuid": {
    "description": "Only these customers' invoices.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "due_at_max": {
    "description": "Due at or before (ISO-8601, e.g. 2026-03-23T15:30:00Z).",
    "type": "string"
   },
   "due_at_min": {
    "description": "Due at or after (ISO-8601, e.g. 2026-03-23T15:30:00Z).",
    "type": "string"
   },
   "location_ids": {
    "description": "Multi-location accounts: only these location ids (ignored when HOUSECALL_PRO_COMPANY_ID is set).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "page": {
    "description": "Page number, starting at 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Records per page.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "paid_at_max": {
    "description": "Paid at or before (ISO-8601, e.g. 2026-03-23T15:30:00Z).",
