{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search Shopify documentation and return source links. No store credentials are sent.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "api_name": {
    "default": "admin",
    "maxLength": 100,
    "type": "string"
   },
   "max_num_results": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "prompt": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "shopify_search_docs_chunks"
}
