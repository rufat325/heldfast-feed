{
 "description": "Advance workflow phase in strict sequence: scope -> root_cause -> implementation -> verification.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "file": {
    "description": "Path to the annotated markdown file",
    "type": "string"
   },
   "note": {
    "description": "Optional transition note",
    "type": "string"
   },
   "toPhase": {
    "description": "Next phase to move to",
    "enum": [
     "root_cause",
     "implementation",
     "verification"
    ],
    "type": "string"
   }
  },
  "required": [
   "file",
   "toPhase"
  ],
  "type": "object"
 },
 "name": "advance_workflow_phase"
}
