{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Prepare a 15-minute reviewed restore of a completed backup's managed PostgreSQL or MariaDB dump into a NEW database on the original or an eligible target binding's provider of the same engine \u2014 the current database is never overwritten and nothing is cut over. Returns the review with source, target database and digest; preparing queues nothing. The binding must be healthy: a pending credential rotation or cleanup refuses the review. Requires deploy scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "backup_id": {
    "description": "The completed backup to restore, from impreza_list_backups.",
    "pattern": "^bkp_[a-f0-9]{16}$",
    "type": "string"
   },
   "target_binding_id": {
    "description": "Optional. Restore through a different managed connection of the account (its provider, its owner) \u2014 the migration shape. Omit to use the connection the backup came from.",
    "pattern": "^bnd_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "required": [
   "backup_id"
  ],
  "type": "object"
 },
 "name": "impreza_prepare_database_restore",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "cutover": {
      "type": "string"
     },
     "expires_at": {
      "type": "string"
     },
     "operation": {
      "const": "database_restore",
      "type": "string"
     },
     "plan_id": {
      "pattern": "^rspl_[a-f0-9]{24}$",
      "type": "string"
     },
     "receipt": {
      "type": "null"
     },
     "review_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "source_backup": {
      "additionalProperties": false,
      "properties": {
       "backup_id": {
        "type": "string"
       },
       "created_at": {
        "type": [
         "string",
         "null"
        ]
       },
       "tables": {
        "type": "integer"
       },
       "total_bytes": {
        "type": "integer"
       }
      },
      "required": [
       "backup_id",
       "created_at",
       "total_bytes",
       "tables"
      ],
      "type": "object"
     },
     "source_deployment_id": {
      "type": "string"
     },
     "status": {
      "const": "ready_for_review",
      "type": "string"
     },
     "target": {
      "additionalProperties": false,
      "properties": {
       "binding_id": {
        "type": "string"
       },
       "database": {
        "type": "string"
       },
       "owner": {
        "type": "string"
       },
       "provider_deployment_id": {
        "type": "string"
       }
      },
      "required": [
       "provider_deployment_id",
       "database",
       "owner",
       "binding_id"
      ],
      "type": "object"
     }
    },
    "required": [
     "plan_id",
     "review_digest",
     "expires_at",
     "status",
     "receipt",
     "operation",
     "source_backup",
     "source_deployment_id",
     "target",
     "cutover"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Review database restore"
}
