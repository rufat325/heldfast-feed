{
 "annotations": {
  "openWorldHint": true
 },
 "description": "Builds Docker Compose service images and returns structured per-service build status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "buildArgs": {
    "additionalProperties": {
     "maxLength": 65536,
     "type": "string"
    },
    "default": {},
    "description": "Build arguments as key-value pairs (e.g., {NODE_ENV: 'production'})",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "builder": {
    "description": "Alternate builder to use (--builder)",
    "maxLength": 255,
    "type": "string"
   },
   "check": {
    "default": false,
    "description": "Validate build config without building (default: false)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "dryRun": {
    "default": false,
    "description": "Run in dry-run mode without actually building (default: false)",
    "type": "boolean"
   },
   "file": {
    "description": "Compose file path for targeting non-default compose files (maps to -f)",
    "maxLength": 4096,
    "type": "string"
   },
   "noCache": {
    "default": false,
    "description": "Do not use cache when building images (default: false)",
    "type": "boolean"
   },
   "path": {
    "description": "Directory containing docker-compose.yml",
    "maxLength": 4096,
    "type": "string"
   },
   "pull": {
    "default": false,
    "description": "Always pull a newer version of the base image (default: false)",
    "type": "boolean"
   },
   "push": {
    "default": false,
    "description": "Push images after building (default: false)",
    "type": "boolean"
   },
   "quiet": {
    "default": false,
    "description": "Suppress build output (default: false)",
    "type": "boolean"
   },
   "services": {
    "default": [],
    "description": "Specific services to build (default: all)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "ssh": {
    "description": "SSH agent socket or key for private repo access during build (--ssh)",
    "maxLength": 65536,
    "type": "string"
   },
   "withDependencies": {
    "default": false,
    "description": "Also build transitive dependencies (default: false)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "compose-build",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "services": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "duration": {
       "type": "number"
      },
      "error": {
       "type": "string"
      },
      "image": {
       "type": "string"
      },
      "imageId": {
       "type": "string"
      },
      "service": {
       "type": "string"
      },
      "success": {
       "type": "boolean"
      }
     },
     "required": [
      "service",
      "success"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Docker Compose Build"
}
