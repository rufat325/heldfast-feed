{
 "description": "Start an async audit job. Audit results are cached per account by a content hash of their inputs; pass force: true to bypass the cache and run a fresh audit (the same as the CLI's --no-cache flag). Requires audits:run for API keys.",
 "inputSchema": {
  "properties": {
   "artifactBundleId": {
    "format": "uuid",
    "type": "string"
   },
   "artifactBundleVersionNumber": {
    "minimum": 1,
    "type": "integer"
   },
   "artifactType": {
    "type": "string"
   },
   "customRequirements": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "force": {
    "default": false,
    "type": "boolean"
   },
   "modelTier": {
    "enum": [
     "cheap",
     "standard",
     "premium"
    ],
    "type": "string"
   },
   "reasoningEffort": {
    "enum": [
     "minimal",
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "rubricKey": {
    "type": "string"
   },
   "targetFileId": {
    "format": "uuid",
    "type": "string"
   },
   "targetVersionNumber": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "artifactBundleId"
  ],
  "type": "object"
 },
 "name": "rubrkit_start_audit",
 "title": "Start audit"
}
