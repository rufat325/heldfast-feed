{
 "description": "Search job listings by keyword, location, type, or remote policy. Returns paginated results with title, company, salary, and application URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "description": "Optional: your Datronis personal access token (starts with \"dtk_\"). Generate one at /app/api-keys/. Prefer sending it as an `Authorization: Bearer <token>` HTTP header instead of this argument \u2014 the header never enters the conversation/tool-call log the way this argument does. When provided (either way) and valid, results are personalized (e.g. includes whether you saved a job).",
    "type": "string"
   },
   "city": {
    "description": "Filter by city",
    "type": "string"
   },
   "country": {
    "description": "Filter by country (e.g. \"United States\")",
    "type": "string"
   },
   "job_level": {
    "description": "Experience level required",
    "enum": [
     "ENTRY",
     "MID",
     "SENIOR",
     "LEAD",
     "EXECUTIVE"
    ],
    "type": "string"
   },
   "job_type": {
    "description": "Employment type",
    "enum": [
     "FULL_TIME",
     "PART_TIME",
     "CONTRACT",
     "INTERNSHIP",
     "FREELANCE"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Results per page (default: 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number (default: 1)",
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Search keyword (title or description)",
    "type": "string"
   },
   "remote_type": {
    "description": "Remote work policy",
    "enum": [
     "REMOTE",
     "HYBRID",
     "ONSITE"
    ],
    "type": "string"
   },
   "salary_min": {
    "description": "Minimum annual salary (USD)",
    "type": "integer"
   },
   "skills": {
    "description": "Required skills (e.g. [\"Python\", \"React\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "search_jobs"
}
