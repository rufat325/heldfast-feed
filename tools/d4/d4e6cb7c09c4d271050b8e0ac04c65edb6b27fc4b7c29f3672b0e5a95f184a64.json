{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "PUBLIC and read-only, no header: reports whether the Model B project policy still fences existing delegated sends, its name and rules digest, the shared cap ceiling, and mint_enabled for new Model B trade setup. New trade-permission creation is retired, so mint_enabled is false on the serving retirement build. Existing status, revoke and exits remain available. No user, grant, address or policy contents are exposed. Arguments: {}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "otto_delegation_fence_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "mint_enabled": {
    "type": "boolean"
   },
   "per_swap_cap_min_usd": {
    "const": 1,
    "type": "number"
   },
   "per_swap_cap_usd": {
    "const": 5000,
    "type": "number"
   },
   "policy_name": {
    "type": "string"
   },
   "present": {
    "type": "boolean"
   },
   "project_id": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   },
   "reason": {
    "enum": [
     "absent",
     "ambiguous",
     "name_mismatch",
     "digest_mismatch"
    ],
    "type": "string"
   },
   "rules_digest": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "ruleset_version": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "present",
   "policy_name",
   "per_swap_cap_usd",
   "per_swap_cap_min_usd",
   "ruleset_version",
   "mint_enabled"
  ],
  "type": "object"
 },
 "title": "Read the Model-B delegation fence (public promise: present, name, rules digest, per-swap cap)"
}
