{
 "description": "List WooCommerce products (slim: id, name, slug, type, status, sku, prices, stock, category ids)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Product category ID",
    "type": "integer"
   },
   "featured": {
    "description": "Only featured (true) or only non-featured (false) products",
    "type": "boolean"
   },
   "on_sale": {
    "description": "Only products on sale (true) or not on sale (false)",
    "type": "boolean"
   },
   "order": {
    "description": "Sort direction (default desc)",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "orderby": {
    "description": "Sort field: date (default), ID, name, title, type, modified, menu_order, rand, none",
    "type": "string"
   },
   "page": {
    "description": "Page number (default 1)",
    "type": "integer"
   },
   "per_page": {
    "description": "Products per page (default 20, -1 for all)",
    "type": "integer"
   },
   "search": {
    "description": "Search term",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "description": "Post status (default any)",
    "enum": [
     "any",
     "draft",
     "pending",
     "private",
     "publish",
     "trash"
    ],
    "type": "string"
   },
   "stock_status": {
    "description": "Stock status filter (default: all)",
    "enum": [
     "instock",
     "outofstock",
     "onbackorder"
    ],
    "type": "string"
   },
   "tag": {
    "description": "Product tag ID",
    "type": "integer"
   },
   "type": {
    "description": "Product type (default: all types)",
    "enum": [
     "simple",
     "grouped",
     "external",
     "variable"
    ],
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "woo_list_products"
}
