 "description": "Prepare a 15-minute review to remove a managed PostgreSQL or MariaDB connection or retry pending cleanup. Applying replaces the consumer without its managed DATABASE_URL, then disables its dedicated login only after a healthy replacement. Database and data are retained. May interrupt traffic. Preparation queues nothing and returns no credential. Requires unrestricted account credentials and deploy scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "binding_id": {
    "pattern": "^bnd_[a-f0-9]{24}$",
    "type": "string"
   },
   "deployment_id": {
    "pattern": "^dpl_(?:[a-f0-9]{16}|[a-f0-9]{24})$",
    "type": "string"
   }
  },
  "required": [
   "deployment_id",
   "binding_id"
  ],
  "type": "object"
 },
 "name": "impreza_prepare_service_binding_removal",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "binding_id": {
      "type": "string"
     },
     "cleanup_retry": {
      "type": "boolean"
     },
     "consumer_deployment_id": {
      "type": "string"
     },
     "consumer_name": {
      "type": "string"
     },
     "copies_provider_password": {
      "type": "boolean"
     },
     "database": {
      "type": "string"
     },
     "database_data_retained": {
      "type": "boolean"
     },
     "environment_id": {
      "type": "string"
     },
     "expires_at": {
      "type": "string"
     },
     "login_disabled_after_replacement": {
      "type": "boolean"
     },
     "may_interrupt_traffic": {
      "type": "boolean"
     },
     "opens_host_port": {
      "type": "boolean"
     },
     "operation": {
      "const": "remove",
      "type": "string"
     },
     "plan_id": {
      "type": "string"
     },
     "provider_deployment_id": {
      "type": "string"
     },
     "provider_engine": {
      "type": "string"
     },
     "receipt": {
      "type": [
       "object",
       "null"
      ]
     },
     "review_digest": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "variable": {
      "const": "DATABASE_URL",
      "type": "string"
     }
    },
    "required": [
     "plan_id",
     "review_digest",
     "status",
     "expires_at",
     "receipt",
     "operation",
     "binding_id",
     "consumer_deployment_id",
