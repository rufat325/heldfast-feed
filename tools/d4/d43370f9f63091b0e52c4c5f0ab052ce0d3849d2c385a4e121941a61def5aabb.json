{
 "description": "Parses CSV text into rows of string fields (no type guessing). Ragged rows are tolerated \u2014 use csv_validate to detect them.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "delimiter": {
    "description": "a single character, default ','",
    "type": "string"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "csv_parse",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "rows": {
    "items": {
     "items": {
      "type": "string"
     },
     "type": [
      "null",
      "array"
     ]
    },
    "type": [
     "null",
     "array"
    ]
   }
  },
  "required": [
   "rows"
  ],
  "type": "object"
 }
}
