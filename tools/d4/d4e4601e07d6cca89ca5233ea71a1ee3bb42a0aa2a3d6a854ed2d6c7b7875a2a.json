{
 "description": "Capture high-quality screenshots of any webpage using headless browser. Price: $0.008",
 "inputSchema": {
  "properties": {
   "fullPage": {
    "default": false,
    "description": "Capture the whole scrollable page, not just the viewport",
    "example": false,
    "type": "boolean"
   },
   "height": {
    "default": 720,
    "description": "Viewport height in pixels",
    "maximum": 2160,
    "minimum": 240,
    "type": "number"
   },
   "selector": {
    "description": "CSS selector to capture",
    "example": "p",
    "type": "string"
   },
   "timeout": {
    "default": 10000,
    "description": "Request timeout in milliseconds",
    "example": 10000,
    "maximum": 30000,
    "minimum": 5000,
    "type": "number"
   },
   "url": {
    "description": "The URL to process",
    "example": "https://example.com",
    "format": "uri",
    "type": "string"
   },
   "width": {
    "default": 1280,
    "description": "Viewport width in pixels",
    "maximum": 3840,
    "minimum": 320,
    "type": "number"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "screenshot"
}
