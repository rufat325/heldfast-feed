{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Semantic + lexical search over the org's indexed files, documents, and agent brains. Returns scored text chunks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_id": {
    "description": "Restrict to one agent's content.",
    "type": "string"
   },
   "limit": {
    "description": "Maximum results (default 10).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "description": "Search mode (default hybrid).",
    "enum": [
     "hybrid",
     "vector",
     "lexical"
    ],
    "type": "string"
   },
   "query": {
    "description": "The search query.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "skopik_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "diagnostics": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "chunk_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "path": {
       "type": [
        "string",
        "null"
       ]
      },
      "scope": {
       "type": [
        "string",
        "null"
       ]
      },
      "scope_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "score": {
       "type": [
        "number",
        "null"
       ]
      },
      "text": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search platform content"
}
