         "after": {
          "description": "Founded after this year",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "before": {
          "description": "Founded before this year",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         }
        },
        "type": "object"
       },
       "handles": {
