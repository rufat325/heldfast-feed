        },
        "type": "array"
       },
       "exclude": {
        "additionalProperties": {},
        "description": "Exclusion filters (companies matching these are removed)",
        "properties": {
         "domains": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "industries": {
