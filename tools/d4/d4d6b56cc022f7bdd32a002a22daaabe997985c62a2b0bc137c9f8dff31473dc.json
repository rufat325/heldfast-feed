{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Survey Invitation"
 },
 "description": "Create a token-auth survey invitation for a specific member/account or contact.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "CRM account ID to invite",
    "type": "string"
   },
   "channel": {
    "description": "Intended channel, e.g. email, sms, whatsapp, link",
    "type": "string"
   },
   "contactId": {
    "description": "Contact ID to invite",
    "type": "string"
   },
   "expiresAt": {
    "description": "Optional invitation expiry ISO datetime",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Optional invitation metadata",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "recipientEmail": {
    "description": "Recipient email for link tracking",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "recipientName": {
    "description": "Recipient display name for link tracking",
    "type": "string"
   },
   "recipientPhone": {
    "description": "Recipient phone for link tracking",
    "type": "string"
   },
   "surveyId": {
    "description": "Survey ID",
    "type": "string"
   }
  },
  "required": [
   "surveyId"
  ],
  "type": "object"
 },
 "name": "create_survey_invitation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
