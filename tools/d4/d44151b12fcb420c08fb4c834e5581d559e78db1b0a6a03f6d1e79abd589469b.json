{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"\ud55c \uc0ac\ub78c\uc758 \ud55c \ub2ec \uae09\uc5ec\uc5d0\uc11c \uc608\uc678 \ud558\ub098(\uc911\ub3c4\uc785\uc0ac\u00b7\uc911\ub3c4\ud1f4\uc0ac\u00b7\uacb0\uadfc \uacf5\uc81c\u00b7\uc2dc\uae09\uc81c \uc8fc\ud734\uc218\ub2f9)\ub97c \uace8\ub77c, \ud655\uc778\ud55c \uac12\uacfc \ud68c\uc0ac \ubb38\uc11c\uc5d0 \uc801\ud78c \uacc4\uc0b0 \uae30\uc900\uc73c\ub85c \uba85\uc138\uc11c \uadf8 \ud56d\ubaa9 \uae08\uc561\uc744 \ub300\uc870\ud55c\ub2e4(\uc0ac\uc774\ud2b8 /tools/pay-check \uc640 \uac19\uc740 \uc5d4\uc9c4). \uacc4\uc0b0 \uae30\uc900: \uc2dc\uac04 \uae30\uc900 = \uc2dc\uae09 \u00d7 \uc720\uae09 \ucc98\ub9ac\ub41c \uc2dc\uac04 \u00b7 30\uc77c \uae30\uc900 = \uc6d4 \uae30\ubcf8\uae09 \u00f7 30 \u00d7 \uc778\uc815\uc77c\uc218 \u00b7 \uc2dc\uac04 \ub2e8\uc704 \uacb0\uadfc \uacf5\uc81c = \uc2dc\uae09 \u00d7 \ubb34\uae09 \uacb0\uadfc\uc2dc\uac04 \u00b7 \uc8fc\ud734 \uace0\uc815 \uc2a4\ucf00\uc904 = \uc2dc\uae09 \u00d7 (\ud3c9\uade0 \uae30\uac04 \uc57d\uc815 \uc18c\uc815\uadfc\ub85c\uc2dc\uac04 \u00f7 \uac19\uc740 \uae30\uac04 \ud1b5\uc0c1 \uadfc\ub85c\uc790 \uc18c\uc815\uadfc\ub85c\uc77c\uc218) \u00d7 \uc8fc\uc218(\uc2dc\ud589\ub839 [\ubcc4\ud45c 2] \uc81c2\ud638\ub098\ubaa9). 4\uc8fc(4\uc8fc \ubbf8\ub9cc \uadfc\ub85c\uba74 \uadf8 \uae30\uac04) \ud3c9\uade0 1\uc8fc 15\uc2dc\uac04 \ubbf8\ub9cc\uc740 \uc8fc\ud734 \ub300\uc870 \ubc16(\uadfc\ub85c\uae30\uc900\ubc95 \uc81c18\uc870\uc81c3\ud56d). \ucc28\uc774 = \uacc4\uc0b0\uac12 \u2212 \uba85\uc138\uc11c(\uacb0\uadfc \uacf5\uc81c\ub294 \uba85\uc138\uc11c \u2212 \uacc4\uc0b0\uac12), \uc591\uc218\uba74 \uadfc\ub85c\uc790\uac00 \ub35c \ubc1b\ub294 \ucabd. \uacb0\uacfc\ub294 \ub300\uc870 \uc77c\uce58\u00b7\uc5b4\uae0b\ub0a8 \uac00\ub2a5\uc131\u00b7\uacc4\uc0b0 \uae30\uc900 \ud655\uc778 \ud544\uc694\u00b7\ubc94\uc704 \ubc16 \ub137 \uc911 \ud558\ub098\ub2e4. \ud68c\uc0ac \uae30\uc900\uc744 \ubaa8\ub974\uba74(policy \uc5c6\uc74c) \uae08\uc561\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\uace0 \ud68c\uc0ac\uc5d0 \ubb3c\uc5b4\ubcfc \ubb38\uc7a5\uc744 \ub0b8\ub2e4. \uae30\uc900\uc740 \uace8\ub790\uc9c0\ub9cc \ubb38\uc11c\uc5d0\uc11c \ud655\uc778\ud558\uc9c0 \ubabb\ud588\uc73c\uba74 \ucc38\uace0 \uacc4\uc0b0\uc73c\ub85c \ub0b4\uace0 \u300c\uacc4\uc0b0 \uae30\uc900 \ubb38\uc11c \ubbf8\ud655\uc778\u300d\uc744 \ub0a8\uae34\ub2e4. \ub05d\uc218\uac00 \uc0dd\uacbc\ub294\ub370 \ucc98\ub9ac \ubc29\ubc95\u00b7\ub2e8\uc704 \uc911 \ud558\ub098\ub77c\ub3c4 \ubaa8\ub974\uba74 \uae08\uc561\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4. \ube48 \uce78\uc740 \ubaa8\ub984\uc774\uba70 \ub300\uc870\ub97c \uba48\ucd98\ub2e4. \ub0a0\uc9dc\ub97c \uace0\uce58\uac70\ub098 \uae30\uc900\uc744 \uc9d0\uc791\ud558\uc9c0 \uc54a\ub294\ub2e4. \uc815\uc0c1 \uadfc\ubb34\uc6d4, \ub450 \uac00\uc9c0 \uc774\uc0c1 \uacb9\uce5c \uc608\uc678, \uc5f0\uc7a5\u00b7\uc57c\uac04\u00b7\ud734\uc77c\uc218\ub2f9\uc744 \ubbf8\ub9ac \uc815\ud574 \uc6d4\uae09\uc5d0 \ub123\uc740 \uc815\uc561 \uc57d\uc815(\uace0\uc815OT), \uad50\ub300\uc81c\u00b7\uac00\uc0b0\uc218\ub2f9\u00b7\uc5f0\ucc28\u00b7\ud1f4\uc9c1\uae08\u00b7\ubcf4\ud5d8\u00b7\uc138\uc561\uc740 \ub2e4\ub8e8\uc9c0 \uc54a\ub294\ub2e4. \uacb0\uacfc\ub294 \ubc95\ub960 \ud310\ub2e8\uc774 \uc544\ub2c8\ub2e4.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"all_scheduled_days_attended":{"description":"\uadf8 \uc8fc \uc18c\uc815\uadfc\ub85c\uc77c \uac1c\uadfc\uc744 \uadfc\ubb34\ud45c\ub85c \ud655\uc778\ud568 = true \u00b7 \uac1c\uadfc \uc544\ub2d8 \ub610\ub294 \ud655\uc778\ud558\uc9c0 \ubabb\ud568 = false","type":"boolean"},"averaging_weeks":{"description":"\ud3c9\uade0\uc744 \ub0b8 \uc8fc\uc218 \u2014 \ubcf4\ud1b5 4, \uadfc\ub85c\ud55c \uae30\uac04\uc774 4\uc8fc \ubbf8\ub9cc\uc774\uba74 \uadf8 \uc8fc\uc218(\uc608: 2)","type":"number"},"basisDocumented":{"description":"\uace0\ub978 \uae30\uc900\uc744 \uadfc\ub85c\uacc4\uc57d\uc11c\u00b7\ucde8\uc5c5\uaddc\uce59 \ub4f1 \ud68c\uc0ac \ubb38\uc11c\uc5d0\uc11c \ud655\uc778\ud588\ub294\uc9c0 \u2014 true \uac00 \uc544\ub2c8\uba74 \ucc38\uace0 \uacc4\uc0b0","type":["boolean","null"]},"contract_change_confirmed":{"description":"\ub300\ud0c0 \uc2dc\uac04\uc774 \uacc4\uc57d\uc0c1 \uc57d\uc815\uc2dc\uac04 \ubcc0\uacbd\uc73c\ub85c \ud655\uc778\ub428 = true \u00b7 \ubcc0\uacbd\uc774 \uc544\ub2c8\uac70\ub098 \ud655\uc778\ud558\uc9c0 \ubabb\ud568 = false","type":"boolean"},"eligible_days":{"description":"\uc778\uc815\uc77c\uc218(\uc77c, 30\uc77c \uae30\uc900\uc73c\ub85c \uc140 \ub0a0\uc218) \u2014 30\uc77c \uae30\uc900","type":"number"},"employment_continued_for_7_days":{"description":"\uadf8 \uc8fc 7\uc77c \ub3d9\uc548 \uacc4\uc57d\uc774 \uc774\uc5b4\uc9d0 = true \u00b7 \uc774\uc5b4\uc9c0\uc9c0 \uc54a\uc558\uac70\ub098 \ubaa8\ub984 = false","type":"boolean"},"employment_end":{"description":"\ud1f4\uc0ac\uc77c(\uc911\ub3c4\ud1f4\uc0ac) YYYY-MM-DD","type":"string"},"employment_start":{"description":"\uc785\uc0ac\uc77c(\uc911\ub3c4\uc785\uc0ac) YYYY-MM-DD","type":"string"},"four_week_scheduled_hours":{"description":"\ud3c9\uade0 \uae30\uac04\uc758 \uc57d\uc815 \uc18c\uc815\uadfc\ub85c\uc2dc\uac04 \ud569\uacc4(\uc2dc\uac04) \u2014 \ubcf4\ud1b5 4\uc8fc, \uadfc\ub85c\ud55c \uae30\uac04\uc774 4\uc8fc \ubbf8\ub9cc\uc774\uba74 \uadf8 \uae30\uac04. \uacc4\uc57d\uc11c\uc5d0 \uc801\ud78c \uc2dc\uac04","type":"number"},"full_time_scheduled_days_4w":{"description":"\uac19\uc740 \uae30\uac04 \ud1b5\uc0c1 \uadfc\ub85c\uc790\uc758 \uc18c\uc815\uadfc\ub85c\uc77c\uc218(\uc77c, \uc8fc 5\uc77c \uc0ac\uc5c5\uc7a5\uc774\uba74 4\uc8fc\uc5d0 \ubcf4\ud1b5 20\uc77c) \u2014 \uc8fc\ud734 \uace0\uc815 \uc2a4\ucf00\uc904","type":"number"},"holiday_weeks":{"description":"\uba85\uc138\uc11c \uc8fc\ud734 \ud56d\ubaa9\uc774 \uba87 \uc8fc\ubd84\uc778\uc9c0(\uc8fc) \u2014 \uc8fc\ud734 \uace0\uc815 \uc2a4\ucf00\uc904","type":"number"},"hourly_rate":{"description":"\ud655\uc815 \uc2dc\uae09(\uc6d0) \u2014 \uc2dc\uac04 \uae30\uc900\u00b7\uc2dc\uac04 \ub2e8\uc704 \uacb0\uadfc \uacf5\uc81c\u00b7\uc8fc\ud734 \uace0\uc815 \uc2a4\ucf00\uc904","type":"number"},"last_scheduled_workday":{"description":"\ub9c8\uc9c0\ub9c9 \uc18c\uc815\uadfc\ub85c\uc77c YYYY-MM-DD(\uc911\ub3c4\ud1f4\uc0ac). null = \ubaa8\ub984","type":["string","null"]},"monthly_base_pay":{"description":"\uc6d4 \uae30\ubcf8\uae09(\uc6d0) \u2014 30\uc77c \uae30\uc900","type":"number"},"paid_holiday_treatment":{"anyOf":[{"enum":["paid","unpaid"],"type":"string"},{"type":"null"}],"description":"\ud1f4\uc0ac\uc6d4 \uc720\uae09\ud734\uc77c \ucc98\ub9ac(\uc911\ub3c4\ud1f4\uc0ac) \u2014 paid = \uc720\uae09\uc73c\ub85c \ucc98\ub9ac\ub428 \u00b7 unpaid = \ubb34\uae09\uc73c\ub85c \ucc98\ub9ac\ub428 \u00b7 null = \ubaa8\ub984"},"paid_hours":{"description":"\uc720\uae09 \ucc98\ub9ac\ub41c \uc2dc\uac04(\uc2dc\uac04) \u2014 \uc2dc\uac04 \uae30\uc900","type":"number"},"paid_leave_or_holiday":{"description":"\uadf8\ub0a0\uc774 \uc720\uae09\ud734\uac00\u00b7\uc720\uae09\ud734\uc77c\uc774\uc5c8\ub294\uc9c0 \u2014 true = \uadf8\ub807\ub2e4\uace0 \ud655\uc778\ub428 \u00b7 false = \uc544\ub2d8\uc744 \ud655\uc778\ud568 \u00b7 null = \ubaa8\ub984(\uacb0\uadfc \uacf5\uc81c)","type":["boolean","null"]},"pay_period_end":{"description":"\uae09\uc5ec\uae30\uac04 \ub9c8\uc9c0\ub9c9 \ub0a0(\uba85\uc138\uc11c\uc5d0 \uc801\ud78c \uae30\uac04, \uc911\ub3c4\uc785\uc0ac\u00b7\uc911\ub3c4\ud1f4\uc0ac) YYYY-MM-DD","type":"string"},"pay_period_start":{"description":"\uae09\uc5ec\uae30\uac04 \uccab\ub0a0(\uba85\uc138\uc11c\uc5d0 \uc801\ud78c \uae30\uac04, \uc911\ub3c4\uc785\uc0ac\u00b7\uc911\ub3c4\ud1f4\uc0ac) YYYY-MM-DD","type":"string"},"payslip_absence_deduction":{"description":"\uba85\uc138\uc11c \uacb0\uadfc \uacf5\uc81c\uc561(\uc6d0, \u2212\ub85c \ucc0d\ud600 \uc788\uc5b4\ub3c4 \uadf8\ub300\ub85c)","type":"number"},"payslip_amount":{"description":"\uba85\uc138\uc11c\uc758 \uc785\uc0ac\uc6d4\u00b7\ud1f4\uc0ac\uc6d4 \uae30\ubcf8\uae09(\uc6d0, \uc911\ub3c4\uc785\uc0ac\u00b7\uc911\ub3c4\ud1f4\uc0ac)","type":"number"},"payslip_weekly_holiday_pay":{"description":"\uba85\uc138\uc11c \uc8fc\ud734 \uae08\uc561(\uc6d0, \uc2dc\uae09\uc81c\u00b7\uc8fc\ud734)","type":"number"},"policy":{"anyOf":[{"enum":["HOUR_ACTUAL","DAY_30","ABSENCE_HOUR","WEEKLY_HOLIDAY_FIXED"],"type":"string"},{"type":"null"}],"description":"\ud68c\uc0ac \uacc4\uc0b0 \uae30\uc900 \u2014 HOUR_ACTUAL(\uc2dc\uac04 \uae30\uc900, \uc911\ub3c4\uc785\uc0ac\u00b7\uc911\ub3c4\ud1f4\uc0ac) \u00b7 DAY_30(30\uc77c \uae30\uc900, \uc911\ub3c4\uc785\uc0ac\u00b7\uc911\ub3c4\ud1f4\uc0ac) \u00b7 ABSENCE_HOUR(\uc2dc\uac04 \ub2e8\uc704 \uacb0\uadfc \uacf5\uc81c) \u00b7 WEEKLY_HOLIDAY_FIXED(\uc8fc\ud734 \uace0\uc815 \uc2a4\ucf00\uc904). \ube44\uc6b0\uac70\ub098 null = \uc5c6\uc74c\u00b7\ubaa8\ub984(\uae08\uc561\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4)"},"rounding":{"description":"\ub05d\uc218 \ucc98\ub9ac \ubc29\ubc95 \u2014 FLOOR \ubc84\ub9bc \u00b7 ROUND \ubc18\uc62c\ub9bc \u00b7 CEIL \uc62c\ub9bc. \ube44\uc6b0\uba74 \ubaa8\ub984","enum":["FLOOR","ROUND","CEIL"],"type":"string"},"roundingUnit":{"description":"\ub05d\uc218 \ucc98\ub9ac \ub2e8\uc704(\uc6d0) \u2014 1\u00b710\u00b7100. \ube44\uc6b0\uba74 \ubaa8\ub984","enum":[1,10,100],"type":"number"},"scenario":{"description":"\uc608\uc678 \u2014 MID_JOIN(\uc911\ub3c4\uc785\uc0ac) \u00b7 MID_LEAVE(\uc911\ub3c4\ud1f4\uc0ac) \u00b7 ABSENCE_DEDUCTION(\uacb0\uadfc \uacf5\uc81c) \u00b7 HOURLY_WEEKLY_HOLIDAY(\uc2dc\uae09\uc81c\u00b7\uc8fc\ud734) \u00b7 NORMAL_MONTH(\uc608\uc678 \uc5c6\ub294 \ub2ec, \ubc94\uc704 \ubc16) \u00b7 MULTIPLE(\ub450 \uac00\uc9c0 \uc774\uc0c1 \uacb9\uce68, \ubc94\uc704 \ubc16)","enum":["MID_JOIN","MID_LEAVE","ABSENCE_DEDUCTION","HOURLY_WEEKLY_HOLIDAY","NORMAL_MONTH","MULTIPLE"],"type":"string"},"scheduled_workday_confirmed":{"description":"\uacf5\uc81c\ub41c \ub0a0\uc774 \uc18c\uc815\uadfc\ub85c\uc77c\uc784\uc744 \uadfc\ubb34\ud45c\ub85c \ud655\uc778\ud568 = true \u00b7 \ud655\uc778\ud558\uc9c0 \ubabb\ud568 = false(\uacb0\uadfc \uacf5\uc81c)","type":"boolean"},"temporary_actual_hours_in_one_week":{"description":"\ub300\ud0c0\ub85c \uc2e4\uc81c \uc77c\ud55c \uadf8 \uc8fc\uc758 \uc2dc\uac04(\ub300\ud0c0\uac00 \uc788\uc5c8\uc744 \ub54c\ub9cc)","type":"number"},"unpaid_absence_hours":{"description":"\ubb34\uae09 \uacb0\uadfc\uc2dc\uac04(\uc2dc\uac04, \uacb0\uadfc \uacf5\uc81c)","type":"number"},"weekly_holiday_designated":{"description":"\uc8fc\ud734\uc77c \uc9c0\uc815 \u2014 true = \uacc4\uc57d\u00b7\uaddc\uce59\uc5d0 \uc9c0\uc815\ub428 \u00b7 false = \uc9c0\uc815\ub418\uc9c0 \uc54a\uc74c\uc744 \ud655\uc778\ud568 \u00b7 null = \ubaa8\ub984","type":["boolean","null"]}},"required":["scenario"],"type":"object"},"name":"check_monthly_pay","title":"\uc6d4\uae09 \ub300\uc870"}
