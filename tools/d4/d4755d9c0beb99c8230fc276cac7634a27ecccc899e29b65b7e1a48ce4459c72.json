  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "document_image": {
    "description": "Base64-encoded JPEG or URL",
    "type": "string"
   },
   "liveness_check": {
    "description": "Default true",
    "type": "boolean"
   },
   "selfie": {
    "description": "Base64-encoded JPEG or URL",
    "type": "string"
   }
  },
  "required": [
   "selfie",
   "document_image"
  ],
  "type": "object"
 },
 "name": "biometrics_face_match"
}
