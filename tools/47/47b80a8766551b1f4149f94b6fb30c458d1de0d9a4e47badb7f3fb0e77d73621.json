{
 "annotations": {
  "readOnlyHint": true,
  "title": "Search people (contacts/leads)"
 },
 "description": "Search contacts and leads. Criteria combine with AND. Name filters are partial matches. Newest first by default. People in the Trash stage are excluded unless includeTrash is true. Not every field is returned by default \u2014 pass `fields` (e.g. \"allFields\" or a comma list) for more. FUB: GET /v1/people.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignedPondId": {
    "description": "Assigned pond id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "assignedTo": {
    "description": "Full name of the assigned agent.",
    "type": "string"
   },
   "assignedUserId": {
    "description": "Assigned agent's user id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "contacted": {
    "description": "Whether they have been contacted.",
    "type": "boolean"
   },
   "createdAfter": {
    "description": "ISO-8601 UTC, e.g. 2026-07-01T00:00:00Z.",
    "type": "string"
   },
   "email": {
    "description": "Exact email address.",
    "type": "string"
   },
   "fields": {
    "description": "Comma-separated fields to return, or \"allFields\" / \"allCustom\".",
    "type": "string"
   },
   "firstName": {
    "description": "Partial match on first name.",
    "type": "string"
   },
   "includeTrash": {
    "description": "Include people in the Trash stage.",
    "type": "boolean"
   },
   "lastActivityAfter": {
    "description": "e.g. \"2026-01-31 00:00:00\".",
    "type": "string"
   },
   "lastActivityBefore": {
    "description": "e.g. \"2026-01-31 00:00:00\".",
    "type": "string"
   },
   "lastName": {
    "description": "Partial match on last name.",
    "type": "string"
   },
   "limit": {
    "description": "Page size, 1-100 (FUB default 10).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Partial match on full name.",
    "type": "string"
   },
   "next": {
    "description": "Cursor from the previous page's _metadata.next. Recommended over offset.",
    "type": "string"
   },
   "offset": {
    "description": "Rows to skip. For deep paging prefer `next`.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "phone": {
    "description": "Phone number.",
    "type": "string"
   },
   "priceAbove": {
    "description": "Price above this value.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "priceBelow": {
    "description": "Price below this value.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "smartListId": {
    "description": "Only people matching this Smart List.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "sort": {
    "description": "Sort field, e.g. \"created\", \"lastActivity\", \"name\"; prefix \"-\" for descending.",
    "type": "string"
   },
   "source": {
    "description": "Lead source, e.g. \"Zillow\".",
    "type": "string"
   },
   "stage": {
    "description": "Stage name, e.g. \"Lead\", \"Past Client\" (see fub_list_stages).",
    "type": "string"
   },
   "tags": {
    "description": "Comma-separated tags; matches ANY (\"Foo,Bar\").",
    "type": "string"
   },
   "updatedAfter": {
    "description": "ISO-8601 UTC.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "fub_search_people",
 "title": "Search people (contacts/leads)"
}
