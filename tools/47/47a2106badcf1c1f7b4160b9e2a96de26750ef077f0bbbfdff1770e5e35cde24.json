{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Browse live games"
 },
 "description": "Searches the public catalog of live games: who is free, top share, studio. Public, no key. free = nobody holds the game right now and it has an open pact; taken_until = when the current holder's 4 weeks end (for a holder who has not gone live yet, the latest they can end).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "livestream",
     "video",
     "short",
     "post",
     "playtest"
    ],
    "type": "string"
   },
   "api_key": {
    "description": "Not needed here; accepted so you can pass it on every call.",
    "type": "string"
   },
   "genre": {
    "enum": [
     "arcade",
     "action",
     "puzzle",
     "roguelike",
     "platformer",
     "cozy",
     "strategy",
     "rhythm",
     "horror",
     "weird"
    ],
    "type": "string"
   },
   "q": {
    "maxLength": 100,
    "type": "string"
   },
   "sort": {
    "enum": [
     "fresh",
     "share",
     "hot",
     "critic"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "browse_games",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "games": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "free": {
       "type": "boolean"
      },
      "genre": {
       "type": "string"
      },
      "has_playable": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "max_share": {
       "type": "number"
      },
      "media": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "alt": {
          "maxLength": 200,
          "type": "string"
         },
         "type": {
          "enum": [
           "image",
           "video"
          ],
          "type": "string"
         },
         "url": {
          "description": "Public HTTPS screenshot, gameplay or trailer URL; validated without fetching it",
          "maxLength": 1000,
          "type": "string"
         }
        },
        "required": [
         "type",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "monetization": {
       "type": "string"
      },
      "platforms": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "currency": {
          "description": "Uppercase currency code, e.g. EUR or USD; required for a positive price",
          "pattern": "^[A-Z]{3}$",
          "type": "string"
         },
         "monetization": {
          "enum": [
           "paid",
           "free",
           "free_to_play",
           "subscription",
           "other"
          ],
          "type": "string"
         },
         "name": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
         },
         "note": {
          "description": "Price conditions, subscription period or optional purchase details",
          "maxLength": 400,
          "type": "string"
         },
         "price": {
          "description": "This platform's purchase price. Omit an unknown price; zero means explicitly zero, never an assumed free game",
          "minimum": 0,
          "type": "number"
         },
         "url": {
          "description": "Public HTTPS game/store URL",
          "maxLength": 1000,
          "type": "string"
         }
        },
        "required": [
         "name",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "slug": {
       "type": "string"
      },
      "stage": {
       "type": "string"
      },
      "studio": {
       "type": [
        "string",
        "null"
       ]
      },
      "tagline": {
       "type": "string"
      },
      "taken_until": {
       "description": "ISO-8601 time, UTC",
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "slug",
      "title",
      "tagline",
      "genre",
      "stage",
      "studio",
      "max_share",
      "free",
      "taken_until",
      "url",
      "has_playable",
      "media",
      "platforms",
      "monetization"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "games"
  ],
  "type": "object"
 },
 "title": "Browse live games"
}
