{
 "_meta": {
  "ui": {
   "resourceUri": "ui://iwac/charts.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Semantic scatter"
 },
 "description": "Stable-hash sample of matching stored embeddings, projected with PCA. Reports eligible, invalid, missing and capped counts, seed and explained variance. Group counts describe the sample. Coordinates are chart-only; this is not the published UMAP landscape. Needs no API key.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "color_by": {
    "description": "country | newspaper | subject | lda_topic_label | polarity (gpt-5-6-luna's label)",
    "type": "string"
   },
   "country": {
    "description": "Exact country name (accents optional)",
    "type": "string"
   },
   "date_from": {
    "description": "Inclusive date bounds: YYYY[-MM[-DD]]",
    "type": "string"
   },
   "date_to": {
    "type": "string"
   },
   "exact": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    },
    "description": "AND values. Fields: subject/spatial/author/language/country/newspaper/topic_id/min_prob/scored_by; country_raw=whole cell; polarity:<model>.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "hijri_month": {
    "type": "string"
   },
   "hijri_year": {
    "type": "integer"
   },
   "keyword": {
    "minLength": 1,
    "type": "string"
   },
   "keyword_aliases": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "keyword_mode": {
    "enum": [
     "literal",
     "all_terms"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Items projected (default 300, max 2000)",
    "type": "integer"
   },
   "newspaper": {
    "description": "Newspaper/periodical substring",
    "type": "string"
   },
   "subject": {
    "description": "Exact tag",
    "type": "string"
   },
   "subset": {
    "description": "articles (default) | publications | references",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_semantic_map",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "color_by": {
    "type": "string"
   },
   "eligible_embeddings": {
    "type": "number"
   },
   "explained_variance": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "filters": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "groups": {
    "additionalProperties": {
     "type": "number"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "invalid_embeddings": {
    "type": "number"
   },
   "limit_warning": {
    "type": "string"
   },
   "missing_embeddings": {
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "omitted_by_limit": {
    "type": "number"
   },
   "points": {
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "projected": {
    "type": "number"
   },
   "requested_limit": {
    "type": "number"
   },
   "sampling": {
    "type": "string"
   },
   "seed": {
    "type": "string"
   },
   "subset": {
    "type": "string"
   },
   "total_matches": {
    "type": "number"
   },
   "view": {
    "type": "string"
   }
  },
  "required": [
   "view",
   "subset",
   "filters",
   "total_matches",
   "projected",
   "explained_variance",
   "note"
  ],
  "type": "object"
 },
 "title": "Semantic scatter"
}
