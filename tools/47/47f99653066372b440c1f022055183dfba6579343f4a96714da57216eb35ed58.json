{
 "_meta": {
  "openai/toolInvocation/invoked": "Guided setup updated.",
  "openai/toolInvocation/invoking": "Updating guided setup...",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Update Guided Page Onboarding"
 },
 "description": "Validate onboarding selections and return the remaining checklist. STATELESS: it does not remember previous calls, so every call must include the FULL accumulated selection (mainCategory, subCategory, layout, palette, primaryAction) plus all knownFields (name, description, action destination, etc.) gathered so far \u2014 not just the latest answer, or earlier choices will look 'missing'. You do not need to loop to a 'ready' state: once you have a name and a primary action, call page_create_from_brief with those values.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "knownFields": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "type": "string"
     },
     "hasImage": {
      "type": "boolean"
     },
     "name": {
      "type": "string"
     },
     "primaryActionDestination": {
      "description": "A real destination explicitly supplied by the user or imported public source. Do not invent booking/order URLs.",
      "type": "string"
     },
     "supportingContent": {
      "description": "True when the user has provided enough extra page content, such as services, products, location, hours, FAQs, reviews, or key notes.",
      "type": "boolean"
     },
     "supportingLinks": {
      "description": "True when the user has provided the initial phone/WhatsApp/location/social/site links they want on the page.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "locale": {
    "description": "en or es \u2014 resend the locale returned by page_onboarding_start (this tool is stateless). Defaults to English unless knownFields.description is clearly Spanish.",
    "type": "string"
   },
   "selection": {
    "additionalProperties": false,
    "properties": {
     "desiredPath": {
      "description": "User's desired URL path. The server normalizes to letters, numbers, and hyphens.",
      "type": "string"
     },
     "layout": {
      "enum": [
       "background_color",
       "full",
       "background_image"
      ],
      "type": "string"
     },
     "mainCategory": {
      "type": "string"
     },
     "palette": {
      "description": "Palette id returned by paletteChoices, for example atom_dark_plum or atom_black.",
      "type": "string"
     },
     "primaryAction": {
      "enum": [
       "appointment",
       "whatsapp",
       "phone",
       "maps",
       "buy",
       "lead",
       "subscribe",
       "follow"
      ],
      "type": "string"
     },
     "recommendedBlock": {
      "enum": [
       "image",
       "product",
       "contact_form",
       "text"
      ],
      "type": "string"
     },
     "subCategory": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "stepId": {
    "enum": [
     "category",
     "layout",
     "profile",
     "primary-action",
     "ready"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "page_onboarding_update",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "canContinue": {
    "type": "boolean"
   },
   "choices": {
    "items": {
     "additionalProperties": true,
