{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "imagelato:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a resize preset"
 },
 "description": "Use this when someone wants a new preset that resizes and converts images to set widths and formats in a project. Returns the new template; formats default to jpg and webp and widths to 512, 256, 128 and 64 pixels. Each call creates another preset. Not for editing a preset.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "formats": {
    "description": "Output formats, one to five of jpg, png, webp, gif or svg; defaults to jpg and webp",
    "items": {
     "enum": [
      "jpg",
      "png",
      "webp",
      "gif",
      "svg"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "description": "Template name, from 1 to 120 characters",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "description": "Exact project id",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "sizes": {
    "description": "Output widths in pixels, one to ten strings from 1 to 9999; defaults to 512, 256, 128 and 64",
    "items": {
     "description": "Positive pixel width from 1 to 9999, written as a string",
     "pattern": "^[1-9]\\d{0,3}$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "name",
   "projectId"
  ],
  "type": "object"
 },
 "name": "add_template",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "enum": [
     "created",
     "project-not-found",
     "project-id-mismatch"
    ],
    "type": "string"
   },
   "template": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "created": {
        "anyOf": [
         {
          "maxLength": 100,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "edited": {
        "$ref": "#/properties/template/anyOf/0/properties/created"
       },
       "formats": {
        "items": {
         "maxLength": 20,
         "type": "string"
        },
        "maxItems": 5,
        "type": "array"
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 120,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "projectId": {
        "$ref": "#/properties/template/anyOf/0/properties/id"
       },
       "sizes": {
        "items": {
         "maxLength": 20,
         "type": "string"
        },
        "maxItems": 10,
        "type": "array"
       }
      },
      "required": [
       "id",
       "name",
       "projectId",
       "formats",
       "sizes",
       "created",
       "edited"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "status",
   "template"
  ],
  "type": "object"
 },
 "title": "Create a resize preset"
}
