{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "gymflexa:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get gym opening hours and settings"
 },
 "description": "Use this when someone asks for one gym's opening hours, timezone, currency or default session length. Returns the gym's scheduling settings with up to 14 opening-hour rows, Monday first; an id outside the organization returns not-found. Not for free session slots.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "gymId": {
    "description": "Id of one of the user's gyms, as the gym list returns it (24 lowercase hex characters)",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "gymId"
  ],
  "type": "object"
 },
 "name": "get_gym",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "gym": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "appointmentDuration": {
        "description": "Default session length in minutes",
        "type": [
         "number",
         "null"
        ]
       },
       "countryCode": {
        "anyOf": [
         {
          "pattern": "^[A-Z]{2}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "currency": {
        "anyOf": [
         {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 16,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "firstDayOfTheWeek": {
        "anyOf": [
         {
          "enum": [
           "Monday",
           "Tuesday",
           "Wednesday",
           "Thursday",
           "Friday",
           "Saturday",
           "Sunday"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "pattern": "^[0-9a-f]{24}$",
        "type": "string"
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       },
       "openingHours": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "close": {
           "anyOf": [
            {
             "pattern": "^\\d{2}:\\d{2}$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "day": {
           "enum": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday"
           ],
           "type": "string"
          },
          "open": {
           "anyOf": [
            {
             "pattern": "^\\d{2}:\\d{2}$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "day",
          "open",
          "close"
         ],
         "type": "object"
        },
        "maxItems": 14,
        "type": "array"
       },
       "timezone": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "currency",
       "defaultLocale",
       "timezone",
       "countryCode",
       "firstDayOfTheWeek",
       "appointmentDuration",
       "openingHours",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Scheduling settings of the gym; null when not found. Address, phone, website, organization, billing, integrations, reminders, members and arbitrary metadata are excluded."
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "gym"
  ],
  "type": "object"
 },
 "title": "Get gym opening hours and settings"
}
