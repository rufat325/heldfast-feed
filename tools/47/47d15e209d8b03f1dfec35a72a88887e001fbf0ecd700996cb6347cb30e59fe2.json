{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Plan Staffing"
 },
 "description": "CALL THIS FIRST for event staffing requests. Returns a configured-market catalog match, role-level W-2 rate math, estimated totals, tier-based lead-time guidance, and state compliance flags from the event's city, date, roles, and headcount. It does not confirm order coverage or live inventory; a coordinator does that after buyer submission. Use granular tools only for a single rate, date, or state fact. A complete plan may save a non-contact snapshot for 30 days and return plan_id plus continuation. If it returns no plan_id and the buyer needs persistence, call save_staffing_plan once; never save a plan that already has an ID. This tool never accepts or submits contact details, reserves staff, or creates a quote request. Omit roles for the catalog and a suggested mix. Treat totals as planning estimates, not quotes. Branch on status: plan, needs_roles, roles_not_found, or city_not_found; confirm suggestions rather than auto-applying them.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attendees": {
    "description": "Expected attendee count.",
    "exclusiveMinimum": 0,
    "maximum": 5000000,
    "type": "integer"
   },
   "city": {
    "description": "Event city, name or slug (e.g., 'Chicago').",
    "maxLength": 120,
    "type": "string"
   },
   "description": {
    "description": "Optional free-text event description, echoed into the plan.",
    "maxLength": 2000,
    "type": "string"
   },
   "event_date": {
    "description": "Event date as YYYY-MM-DD; legacy recognizable dates are still accepted.",
    "format": "date",
    "maxLength": 40,
    "type": "string"
   },
   "event_type": {
    "description": "trade-show, conference, festival, concert, sporting-event, corporate, brand-activation, or other.",
    "enum": [
     "trade-show",
     "conference",
     "festival",
     "concert",
     "sporting-event",
     "corporate",
     "brand-activation",
     "other"
    ],
    "maxLength": 80,
    "type": "string"
   },
   "roles": {
    "description": "Roles and headcount. Omit to receive the role catalog and a suggested mix.",
    "items": {
     "properties": {
      "days": {
       "description": "Number of event days (default 1).",
       "exclusiveMinimum": 0,
       "maximum": 365,
       "type": "integer"
      },
      "headcount": {
       "description": "Staff needed for this role.",
       "exclusiveMinimum": 0,
       "maximum": 10000,
       "type": "integer"
      },
      "hours_per_shift": {
       "description": "Hours per shift (default 8, max 24).",
       "exclusiveMinimum": 0,
       "maximum": 24,
       "type": "number"
      },
      "role": {
       "description": "Role name or slug.",
       "maxLength": 80,
       "type": "string"
      }
     },
     "required": [
      "role",
      "headcount"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "city"
  ],
  "type": "object"
 },
 "name": "plan_staffing",
