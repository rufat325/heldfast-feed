{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "appskyline:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Look up keyword search volume"
 },
 "description": "Use this when someone asks how popular a keyword is or which keyword ideas are worth targeting. Returns monthly Google web-search volume (a demand proxy, not app-store search counts), difficulty, CPC and competition for up to 50 terms in one country. Terms missing from the 30-day cache trigger a billable lookup. Not for rankings.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "Two-letter country code such as US or IT (required)",
    "maxLength": 2,
    "minLength": 2,
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "lang": {
    "description": "Two-letter language code such as en or it; optional",
    "maxLength": 32,
    "type": "string"
   },
   "terms": {
    "description": "Keyword ideas to look up in one batch, 1 to 50 terms of up to 200 characters, none containing a comma",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "pattern": "^[^,]+$",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "terms",
   "country"
  ],
  "type": "object"
 },
 "name": "get_keyword_overview",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "keywords": {
    "description": "Google web-search demand per term from the shared 30-day cache, highest volume first; a proxy for interest, not app-store search counts",
    "items": {
     "additionalProperties": false,
     "properties": {
      "competition": {
       "anyOf": [
        {
         "maxLength": 50,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "cpc": {
       "anyOf": [
        {
         "maximum": 1000000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "fetchedAt": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "keyword": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "keywordDifficulty": {
       "anyOf": [
        {
         "maximum": 100,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "searchVolume": {
       "anyOf": [
        {
         "maximum": 1000000000,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "keyword",
      "searchVolume",
      "keywordDifficulty",
      "cpc",
      "competition",
      "fetchedAt"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "lang": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "returned": {
    "maximum": 50,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "enum": [
     "found",
     "empty"
    ],
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "country",
   "lang",
   "keywords",
   "returned",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Look up keyword search volume"
}
