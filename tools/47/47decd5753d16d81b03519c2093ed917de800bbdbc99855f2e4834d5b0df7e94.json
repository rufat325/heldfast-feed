{
 "description": "List the Traditional Chinese (zh-TW) comments/replies on a forum article, by article id (UUID). Paginated.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "articleId": {
    "description": "Article id (UUID).",
    "type": "string"
   },
   "page": {
    "description": "1-based page number, max 100 (default 1).",
    "type": "integer"
   },
   "size": {
    "description": "Page size, max 50 (default 10).",
    "type": "integer"
   }
  },
  "required": [
   "articleId"
  ],
  "type": "object"
 },
 "name": "list_comments"
}
