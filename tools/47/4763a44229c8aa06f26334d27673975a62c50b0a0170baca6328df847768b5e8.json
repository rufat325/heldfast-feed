{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true,
  "title": "BRRRR Deal Analysis"
 },
 "description": "Analyze a BRRRR (Buy, Rehab, Rent, Refinance, Repeat) real estate deal. Returns all-in cost, ARV margin, refinance cash-out, monthly cash flow, BRRRR Score (0-100), 70% rule check, and full breakdown. Pure local calculation \u2014 no API call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "annualInsurance": {
    "default": 0,
    "description": "Annual insurance",
    "type": "number"
   },
   "annualPropertyTax": {
    "default": 0,
    "description": "Annual property tax",
    "type": "number"
   },
   "arv": {
    "description": "After Repair Value in dollars",
    "type": "number"
   },
   "closingCostsBuyPct": {
    "default": 3,
    "description": "Closing costs percentage on purchase",
    "type": "number"
   },
   "holdingCosts": {
    "default": 0,
    "description": "Total holding costs during rehab",
    "type": "number"
   },
   "initialLoanAmount": {
    "default": 0,
    "description": "Initial loan amount if used",
    "type": "number"
   },
   "maintenancePct": {
    "default": 1,
    "description": "Maintenance as % of ARV per year",
    "type": "number"
   },
   "monthlyHoa": {
    "default": 0,
    "description": "Monthly HOA",
    "type": "number"
   },
   "monthlyOtherExpenses": {
    "default": 0,
    "description": "Other monthly expenses",
    "type": "number"
   },
   "monthlyRent": {
    "description": "Expected monthly rent in dollars",
    "type": "number"
   },
   "monthlyUtilities": {
    "default": 0,
    "description": "Monthly utilities",
    "type": "number"
   },
   "propertyMgmtPct": {
    "default": 0,
    "description": "Property management as % of rent",
    "type": "number"
   },
   "purchasePrice": {
    "description": "Purchase price in dollars",
    "type": "number"
   },
   "refiClosingCostsPct": {
    "default": 2,
    "description": "Refinance closing costs percentage",
    "type": "number"
   },
   "refiLtvPct": {
    "default": 75,
    "description": "Refinance LTV percentage",
    "type": "number"
   },
   "refiRate": {
    "default": 7,
    "description": "Refinance interest rate",
    "type": "number"
   },
   "refiTermYears": {
    "default": 30,
    "description": "Refinance loan term",
    "type": "number"
   },
   "rehabCosts": {
    "default": 0,
    "description": "Total rehab costs",
    "type": "number"
   },
   "useInitialLoan": {
    "default": false,
    "description": "Whether initial purchase used a loan",
    "type": "boolean"
   },
   "vacancyRatePct": {
    "default": 8,
    "description": "Vacancy rate percentage",
    "type": "number"
   }
  },
  "required": [
   "purchasePrice",
   "arv",
   "monthlyRent"
  ],
  "type": "object"
 },
 "name": "brrrr_analysis"
}
