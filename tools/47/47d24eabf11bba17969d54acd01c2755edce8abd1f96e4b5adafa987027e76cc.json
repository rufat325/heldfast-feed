      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "parentId": {
       "type": [
        "string",
        "null"
       ]
      },
      "topic": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "name",
      "topic",
      "parentId"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "channels"
  ],
  "type": "object"
 }
}
