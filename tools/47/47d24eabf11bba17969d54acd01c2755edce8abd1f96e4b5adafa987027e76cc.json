{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List forum channels"
 },
 "description": "List the forum channels in a server (id, name, topic, parent category). Read-only. Use discord_get_forum_tags to see a forum's available tags, or discord_list_forum_threads for its posts.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "guild_id": {
    "description": "Discord server (guild) ID (snowflake).",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   }
  },
  "required": [
   "guild_id"
  ],
  "type": "object"
 },
 "name": "discord_get_forum_channels",
