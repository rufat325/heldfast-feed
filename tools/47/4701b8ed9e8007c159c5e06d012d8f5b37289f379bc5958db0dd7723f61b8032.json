{
 "_meta": {
  "openai/outputTemplate": "ui://haus/widgets/v2",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://haus/widgets/v2",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Update a vehicle. Only the fields you send change; for text and due-date fields an empty string clears the stored value.",
 "inputSchema": {
  "examples": [
   {
    "id": "0198c1f4b2c07a1b9e4d5f6a7b8c9d0e",
    "notes": "Renewed tax disc",
    "taxDueDate": "2027-09-01"
   }
  ],
  "properties": {
   "colour": {
    "description": "Colour.",
    "examples": [
     "Blue"
    ],
    "type": "string"
   },
   "id": {
    "description": "Vehicle id from list_vehicles.",
    "examples": [
     "0198c1f4b2c07a1b9e4d5f6a7b8c9d0e"
    ],
    "type": "string"
   },
   "insuranceDocumentId": {
    "description": "Insurance document id from list_documents.",
    "examples": [
     "01928e4a7d3f7b9ac1e3f6d8b2a4c710"
    ],
    "type": "string"
   },
   "make": {
    "description": "Manufacturer, e.g. 'Toyota'.",
    "examples": [
     "Toyota"
    ],
    "type": "string"
   },
   "model": {
    "description": "Model, e.g. 'Corolla'.",
    "examples": [
     "Corolla"
    ],
    "type": "string"
   },
   "motDueDate": {
    "description": "Next MOT (roadworthiness test) due date, YYYY-MM-DD.",
    "examples": [
     "2026-11-15"
    ],
    "type": "string"
   },
   "notes": {
    "description": "Free-text notes.",
    "examples": [
     "Renewed tax disc"
    ],
    "type": "string"
   },
   "registration": {
    "description": "Registration as shown on the plate; format varies by country.",
    "examples": [
     "AB21 CDE"
    ],
    "type": "string"
   },
   "serviceDueDate": {
    "description": "Next service due date, YYYY-MM-DD.",
    "examples": [
     "2027-01-20"
    ],
    "type": "string"
   },
   "taxDueDate": {
    "description": "Next road tax due date, YYYY-MM-DD.",
    "examples": [
     "2026-09-01"
    ],
    "type": "string"
   },
   "vin": {
    "description": "Vehicle Identification Number, 17 alphanumeric characters.",
    "examples": [
     "1HGCM82633A004352"
    ],
    "type": "string"
   },
   "year": {
    "description": "Model year, 1900-2100.",
    "examples": [
     2021
    ],
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_vehicle",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "variant": {
    "enum": [
     "list",
     "detail",
     "confirmation"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 }
}
