{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List schema checks"
 },
 "description": "List past schema checks for a graph: each check's ID, status, timestamps, the subgraph it checked, the variant it ran against, the commit, and the status of each task in the check, plus the total count for the filter. Use this to find a check, then pass its ID to GetCheckResults for failure details. Provide the graph ID. Optionally filter by status (PASSED, FAILED, PENDING), subgraph names, branches, variants, authors, or check IDs, and page with limit and offset.",
 "inputSchema": {
  "definitions": {
   "CheckFilterInputStatusOption": {
    "description": "Options for filtering CheckWorkflows by status\nThis should always match CheckWorkflowStatus\n\nValues:\nFAILED: \nPENDING: \nPASSED: ",
    "enum": [
     "FAILED",
     "PENDING",
     "PASSED"
    ],
    "type": "string"
   }
  },
  "properties": {
   "authors": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "branches": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "graphId": {
    "type": "string"
   },
   "ids": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "limit": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": 20
   },
   "offset": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": 0
   },
   "status": {
    "anyOf": [
     {
      "$ref": "#/definitions/CheckFilterInputStatusOption"
     },
     {
      "type": "null"
     }
    ]
   },
   "subgraphs": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "variants": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "graphId"
  ],
  "type": "object"
 },
 "name": "GetSchemaChecks"
}
