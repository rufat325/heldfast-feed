 "description": "Identify the main Product or ProductGroup from supplied JSON-LD HTML using identity, mainEntity and canonical evidence; abstain on ambiguity. PAID: 800 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "html": {
      "maxLength": 100000,
      "type": "string"
     },
     "pageUrl": {
      "maxLength": 2048,
      "type": "string"
     }
    },
    "required": [
     "html"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
