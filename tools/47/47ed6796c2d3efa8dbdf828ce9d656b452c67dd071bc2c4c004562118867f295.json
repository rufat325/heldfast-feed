       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "city": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [],
    "type": "object"
   },
   "item_count": {
