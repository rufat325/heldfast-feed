{
 "description": "Generate a Yoco card or Ozow instant-EFT payment link; this does NOT complete payment. Rejects cancelled checkouts and rechecks stock and totals first. An atomic claim prevents competing gateway calls. Returns payment_url or null plus status and message; cloud callers may be held. Retain a successful URL: repeat calls return payment_pending with no URL. Gateway failures raise an error, send no payment-link email and require team review rather than an automatic retry. Poll get_order with customer_email for payment status.",
 "inputSchema": {
  "properties": {
   "checkout_id": {
    "type": "string"
   },
   "payment_method": {
    "description": "Overrides any value set in create_checkout/update_checkout",
    "enum": [
     "yoco",
     "ozow"
    ],
    "type": "string"
   }
  },
  "required": [
   "checkout_id"
  ],
  "type": "object"
 },
 "name": "complete_checkout",
 "outputSchema": {
  "additionalProperties": true,
  "allOf": [
   {
    "if": {
     "properties": {
      "payment_url": {
       "type": "string"
      }
     },
     "required": [
      "payment_url"
     ]
    },
    "then": {
     "required": [
      "total_zar",
      "currency",
      "payment_method"
     ]
    }
   }
  ],
  "properties": {
   "ap2": {
    "additionalProperties": true,
    "properties": {
     "merchant_authorization": {
      "type": "string"
     }
    },
