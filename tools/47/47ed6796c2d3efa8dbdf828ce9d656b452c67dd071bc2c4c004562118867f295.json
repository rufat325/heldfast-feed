        },
        "finish": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "height": {
         "type": "number"
        },
        "mountType": {
         "type": "string"
        },
        "price": {
         "type": "number"
        },
        "productId": {
         "type": "string"
        },
        "productName": {
         "type": "string"
        },
        "quantity": {
         "type": "number"
        },
        "total": {
