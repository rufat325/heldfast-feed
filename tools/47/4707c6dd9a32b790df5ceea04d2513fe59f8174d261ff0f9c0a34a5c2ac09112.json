     "properties": {
      "note": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "topic": {
       "type": "string"
      }
     },
     "required": [
      "topic",
      "note",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "registration": {
    "properties": {
     "age_days": {
      "type": [
       "number",
       "null"
      ]
     },
     "created_at": {
      "type": [
       "string",
       "null"
      ]
     },
