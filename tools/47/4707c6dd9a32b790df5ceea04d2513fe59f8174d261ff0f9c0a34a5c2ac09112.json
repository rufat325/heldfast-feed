{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks whether a new or secondary domain is ready for cold email or outreach, or wants a score for a sending domain, such as \"is acme-mail.com ready for cold email?\". Pass the domain and, optionally, up to 5 DKIM selectors. Returns a score from 0 to 100, a verdict (ready, almost, not_ready or incomplete), the 5 fixes to make first, every rule with its status, its kind (standard for a published requirement, opinion for common advice nobody requires) and its source link, the domain's registration date and age, what was not tested, and the source and as_of date. Opinion rules change the score but can never make the verdict not_ready. It reads public DNS and the public registry record only: it sends no message and cannot see sender reputation or warm-up, so it does not promise inbox placement.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dkim_selectors": {
    "description": "DKIM selector names, the s= value in a DKIM-Signature header, such as [\"google\"]. Optional: when omitted, 10 usual selector names are tried. At most 5.",
    "items": {
     "maxLength": 63,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9._-]+$",
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "domain": {
    "description": "The domain you will send cold email from, such as \"acme-mail.com\". A web address or an email address is reduced to its domain.",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "launch_score",
 "outputSchema": {
  "properties": {
   "as_of": {
    "type": "string"
   },
   "dkim": {
    "properties": {
     "named": {
      "type": "boolean"
     },
     "probes": {
      "items": {
       "properties": {
        "found": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "key_bits": {
         "type": "number"
        },
        "selector": {
         "type": "string"
        }
       },
       "required": [
        "selector",
        "found"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "named",
     "probes"
    ],
    "type": "object"
   },
   "domain": {
    "type": "string"
   },
   "fix_first": {
    "items": {
     "properties": {
      "detail": {
       "type": "string"
      },
      "fix": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "standard",
        "opinion"
       ],
       "type": "string"
      },
      "problem": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "required": [
      "rule",
      "kind",
      "problem",
      "detail",
      "fix",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "not_tested": {
