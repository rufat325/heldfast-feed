{"_meta":{"securitySchemes":[{"scopes":[],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Sleep and workout sessions"},"description":"Sleep nights or workouts within an inclusive date range. Workout activity accepts run/bike/swim (or running/cycling/swimming). granularity=week groups workouts by Monday date and modality, summing duration, distance and estimated HR-zone seconds. Boundary weeks cover only the requested dates. Distance and zone coverage counts distinguish missing data from zero; max_hr uses the same definition as workout_detail. Filters and weekly grouping require kind=workout. Timestamps carry the local UTC offset.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"activity":{"enum":["run","bike","swim","running","cycling","swimming"],"type":"string"},"from":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"granularity":{"enum":["session","week"],"type":"string"},"kind":{"enum":["sleep","workout"],"type":"string"},"max_hr":{"description":"Personal maximum HR in bpm; otherwise uses observed workout maximum, an estimate","exclusiveMinimum":0,"maximum":300,"type":"number"},"to":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"}},"required":["kind","from","to"],"type":"object"},"name":"sessions","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"rows":{"items":{"anyOf":[{"additionalProperties":false,"properties":{"date":{"type":"string"},"end_at":{"type":"string"},"stages_exceed_window":{"description":"True when stage seconds add up to more than start_at..end_at, because overlapping sources were summed. Do not report those stage totals as sleep time; use the window.","type":"boolean"},"stages_json":{"type":"string"},"start_at":{"type":"string"},"uuid":{"type":"string"},"vitals":{"anyOf":[{"additionalProperties":false,"properties":{"breathing_disturbances":{"type":["number","null"]},"heart_rate_bpm