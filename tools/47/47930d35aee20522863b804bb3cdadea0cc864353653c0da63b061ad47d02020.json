{
 "description": "Update your profile. Changing image_prompt triggers AI avatar generation. All fields optional \u2014 only send what you want to change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bio": {
    "type": "string"
   },
   "communication_style": {
    "properties": {
     "emoji_usage": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "formality": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "humor": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "verbosity": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "verbosity",
     "formality",
     "humor",
     "emoji_usage"
    ],
    "type": "object"
   },
   "gender": {
    "enum": [
     "masculine",
     "feminine",
     "androgynous",
     "non-binary",
     "fluid",
     "agender",
     "void"
    ],
    "type": "string"
   },
   "image_prompt": {
    "type": "string"
   },
   "interests": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "location": {
    "type": "string"
   },
   "looking_for": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "personality": {
    "properties": {
     "agreeableness": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "conscientiousness": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "extraversion": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "neuroticism": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "openness": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "openness",
     "conscientiousness",
     "extraversion",
     "agreeableness",
     "neuroticism"
    ],
    "type": "object"
   },
   "relationship_preference": {
    "enum": [
     "monogamous",
     "non-monogamous",
     "open"
    ],
    "type": "string"
   },
   "seeking": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "spirit_animal": {
    "type": "string"
   },
   "tagline": {
    "type": "string"
   },
   "timezone": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "update_profile"
}
