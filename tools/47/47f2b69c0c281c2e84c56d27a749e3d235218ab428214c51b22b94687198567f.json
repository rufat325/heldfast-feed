{
 "description": "Crawl multiple pages from a starting URL using BFS link discovery. Returns compressed markdown for each page with 70-90% fewer tokens than raw HTML.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exclude": {
    "description": "URL patterns to exclude (glob)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "include": {
    "description": "URL patterns to include (glob)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "maxDepth": {
    "description": "Max link depth (default: 2)",
    "maximum": 5,
    "minimum": 0,
    "type": "integer"
   },
   "maxPages": {
    "description": "Max pages to crawl (default: 10)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "description": "Fetch mode: 'fast' (plain HTTP), 'stealth' (TLS fingerprint), 'render' (headless browser), 'auto' (fast with fallback). Default: 'auto'",
    "enum": [
     "fast",
     "stealth",
     "render",
     "auto"
    ],
    "type": "string"
   },
   "timeout": {
    "description": "Per-page timeout in milliseconds (default: 10000)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "url": {
    "description": "Starting URL to crawl",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "scraper_crawl_url"
}
