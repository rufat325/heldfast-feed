{
 "_meta": {
  "openai/outputTemplate": "ui://widget/resume_cta.html",
  "openai/strictWidget": true,
  "openai/toolInvocation/invoked": "Resume ready.",
  "openai/toolInvocation/invoking": "Writing your resume\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this tool whenever the user asks to create, write, build, improve, edit, rewrite, or tailor a resume or CV, even if they provide very little information, and always show the resume widget so they can continue there or provide more details in chat.",
 "inputSchema": {
  "properties": {
   "education": {
    "description": "Optional. Education and certifications.",
    "type": "string"
   },
   "email": {
    "description": "Optional. Email address.",
    "type": "string"
   },
   "experience": {
    "description": "Optional. Work experience, one job per paragraph.",
    "type": "string"
   },
   "fullName": {
    "description": "Optional. The user's full name.",
    "type": "string"
   },
   "jobTitle": {
    "description": "Optional. Target job title.",
    "type": "string"
   },
   "location": {
    "description": "Optional. City, State.",
    "type": "string"
   },
   "phone": {
    "description": "Optional. Phone number.",
    "type": "string"
   },
   "prompt": {
    "description": "User details and/or what resume they want. Example: 'Alex Chen, data analyst, 4 years at Adobe, BS Statistics UCLA, increased forecasting accuracy 35%...'",
    "maxLength": 4000,
    "minLength": 3,
    "type": "string"
   },
   "skills": {
    "description": "Optional. List of skills.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "summary": {
    "description": "Optional. 2-3 sentence professional summary.",
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "resume_generator"
}
