{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Edit a blog post"
 },
 "description": "Use this when someone asks to change a blog post's title, text, summary, slug, author or categories, or to publish or unpublish it. Returns the updated post; only the fields passed change, and each edit notifies the blog's webhooks. Not for adding a translation.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "author": {
    "description": "New author name, up to 200 characters",
    "maxLength": 200,
    "type": "string"
   },
   "categories": {
    "description": "Complete new list of up to 50 categories; replaces the old list",
    "items": {
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "content": {
    "description": "New body in the post's format, up to 100,000 characters; replaces the whole body",
    "maxLength": 100000,
    "type": "string"
   },
   "description": {
    "description": "New summary, up to 1,000 characters",
    "maxLength": 1000,
    "type": "string"
   },
   "format": {
    "description": "markdown or html, describing how content is written",
    "enum": [
     "markdown",
     "html"
    ],
    "type": "string"
   },
   "id": {
    "description": "Id of the post to change",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "published": {
    "description": "true publishes the post, false turns it back into a draft",
    "type": "boolean"
   },
   "slug": {
    "description": "New URL slug, up to 300 characters; changes the post's URL",
    "maxLength": 300,
    "type": "string"
   },
   "title": {
    "description": "New title, up to 300 characters",
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_article",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "article": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 100,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "locale": {
        "anyOf": [
         {
          "maxLength": 50,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "published": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "slug": {
        "anyOf": [
         {
          "maxLength": 300,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "title": {
        "anyOf": [
         {
          "maxLength": 300,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "title",
       "locale",
       "slug",
       "published",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "updated",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "article"
  ],
  "type": "object"
 },
 "title": "Edit a blog post"
}
