    "description": "Invoice UUID returned by invoice.create",
    "type": "string"
   }
  },
  "required": [
   "invoiceId"
  ],
  "type": "object"
 },
 "name": "invoice.get",
 "outputSchema": {
  "properties": {
   "amount": {
    "type": "number"
   },
   "currency": {
    "type": "string"
   },
   "expiresAt": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "payUrl": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 }
