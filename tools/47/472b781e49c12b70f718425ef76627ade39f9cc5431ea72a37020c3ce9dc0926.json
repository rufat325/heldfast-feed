{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Edit a scheduled event's details, or move it through its lifecycle: status start makes it live, status end completes it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "maxLength": 1000,
    "type": "string"
   },
   "end_time": {
    "type": "string"
   },
   "event": {
    "description": "Event name or ID.",
    "type": "string"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "location": {
    "maxLength": 100,
    "type": "string"
   },
   "name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "start_time": {
    "type": "string"
   },
   "status": {
    "enum": [
     "start",
     "end"
    ],
    "type": "string"
   }
  },
  "required": [
   "event"
  ],
  "type": "object"
 },
 "name": "update_event",
 "title": "Update event"
}
