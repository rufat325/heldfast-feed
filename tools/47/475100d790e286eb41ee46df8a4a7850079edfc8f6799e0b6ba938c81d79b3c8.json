{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read a script run's status, and its result once it has finished.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "run_id": {
    "description": "A script run id (srun_...).",
    "type": "string"
   }
  },
  "required": [
   "run_id"
  ],
  "type": "object"
 },
 "name": "get_script_run",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One script run on the account's computer.",
  "properties": {
   "calls": {
    "description": "Every tool call the script made, in order.",
    "items": {
     "properties": {
      "error_code": {
       "type": "string"
      },
      "read_only": {
       "type": "boolean"
      },
      "role": {
       "type": "string"
      },
      "status": {
       "type": "integer"
      }
     },
     "required": [
      "role"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "completed_at": {
    "format": "date-time",
    "type": [
     "string",
     "null"
    ]
   },
   "created_at": {
    "format": "date-time",
    "type": "string"
   },
   "error": {
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "object": {
    "const": "script_run",
    "type": "string"
   },
   "output": {
    "description": "What the script printed (the last 64,000 characters).",
    "type": [
     "string",
     "null"
    ]
   },
   "result": {
    "description": "The script's last expression, as JSON."
   },
   "reused": {
    "type": "boolean"
   },
   "started_at": {
    "format": "date-time",
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "enum": [
     "queued",
     "in_progress",
     "completed",
     "failed",
     "cancelled",
     "timed_out"
    ],
    "type": "string"
   },
   "timeout_seconds": {
    "type": "integer"
   },
   "wait_timed_out": {
    "description": "The wait ended first. The work is still running: follow it with the tool next_step names.",
    "type": "boolean"
   }
  },
  "required": [
   "object",
   "id",
   "status",
   "calls",
   "timeout_seconds",
   "created_at"
  ],
  "type": "object"
 }
}
