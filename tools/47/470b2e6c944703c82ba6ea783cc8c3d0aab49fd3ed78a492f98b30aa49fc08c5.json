{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get one discovered resource"
 },
 "description": "Get the full record for one discovered ARD resource by its identifier (URN), as returned by search_resources / list_resources. Includes the connect URL when the publisher provides one; otherwise the inline connection or pull details. Also returns type, publisher, version, trust, source, description, tags, and example queries.",
 "inputSchema": {
  "properties": {
   "identifier": {
    "description": "The resource URN, e.g. urn:air:stealthstack.ai:skill:parquet (urn:ai: and urn:air: are both accepted).",
    "type": "string"
   }
  },
  "required": [
   "identifier"
  ],
  "type": "object"
 },
 "name": "get_resource",
 "outputSchema": {
  "properties": {
   "found": {
    "type": "boolean"
   },
   "requestedIdentifier": {
    "type": "string"
   },
   "resolvedIdentifier": {
    "description": "The identifier the index matched (may use the other URN prefix).",
    "type": "string"
   },
   "resource": {
    "properties": {
     "connect": {
      "description": "How to reach the resource. mode=url: `url`; mode=connections: `connections[]` (stdio \u2192 command/args, http/sse/streamable-http \u2192 url); mode=pull: `pull.command` (e.g. dirctl pull <cid>); mode=data: inline artifact of unrecognised shape (`dataKeys`; `data` itself when small, get_resource only); mode=none: nothing published.",
      "properties": {
       "connections": {
        "items": {
         "properties": {
          "args": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "command": {
           "type": "string"
          },
          "transport": {
           "type": "string"
          },
          "url": {
           "type": "string"
          }
         },
         "required": [
          "transport"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "data": {
        "type": "object"
       },
       "dataKeys": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "mode": {
        "enum": [
         "url",
         "connections",
         "pull",
         "data",
         "none"
        ],
        "type": "string"
       },
       "pull": {
        "properties": {
         "cid": {
          "type": "string"
         },
         "command": {
          "type": "string"
         }
        },
        "required": [
         "command"
        ],
        "type": "object"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "mode"
      ],
      "type": "object"
     },
     "description": {
      "type": "string"
     },
     "displayName": {
      "type": "string"
     },
     "identifier": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "lastSeen": {
      "type": "string"
     },
     "payment": {
      "description": "Payment terms the service lists (x402): protocol, lowest listed price + currency, network (CAIP-2). Self-declared; never a payee address.",
      "properties": {
       "currency": {
        "type": "string"
       },
       "network": {
        "type": "string"
       },
       "price": {
        "type": "string"
       },
       "protocol": {
        "type": "string"
       },
       "testnet": {
        "type": "boolean"
       }
      },
      "required": [
       "protocol"
      ],
      "type": "object"
     },
     "publisher": {
      "description": "URN authority.",
      "type": "string"
     },
     "representativeQueries": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "score": {
      "description": "Relevance as returned by the index /search (search_resources only).",
      "type": "number"
     },
     "source": {
      "properties": {
       "catalogUrl": {
        "type": "string"
       },
       "domain": {
        "type": "string"
       },
       "via": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "trust": {
      "type": "object"
     },
     "type": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "identifier",
     "displayName",
     "kind",
     "type",
     "connect"
    ],
    "type": "object"
   }
  },
  "required": [
   "found",
   "requestedIdentifier"
  ],
  "type": "object"
 },
 "title": "Get one discovered resource"
}
