{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Map common Rego compile errors and Regal lint findings to mechanical fix suggestions. Pass diagnostics from `rego_check` or `rego_lint`. Returns one suggestion per input diagnostic; confidence is `high` for well-known patterns, `medium` for partial matches, `low` for everything else.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "diagnostics": {
    "description": "Diagnostics from rego_check or rego_lint.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "description": "Category (Regal violations).",
       "type": "string"
      },
      "code": {
       "description": "Diagnostic code (e.g. \"rego_unsafe_var_error\").",
       "type": "string"
      },
      "location": {
       "additionalProperties": false,
       "properties": {
        "col": {
         "type": "number"
        },
        "file": {
         "type": "string"
        },
        "row": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "message": {
       "description": "Diagnostic message.",
       "type": "string"
      },
      "title": {
       "description": "Title (Regal violations).",
       "type": "string"
      }
     },
     "required": [
      "code",
      "message"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "diagnostics"
  ],
  "type": "object"
 },
 "name": "rego_suggest_fix",
 "title": "Suggest fix for Rego diagnostics"
}
