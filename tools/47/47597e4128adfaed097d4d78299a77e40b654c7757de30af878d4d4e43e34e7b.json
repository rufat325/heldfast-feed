{
 "annotations": {
  "audience": [
   "user",
   "assistant"
  ],
  "openWorldHint": true,
  "priority": 0.5,
  "title": "Create Comment"
 },
 "description": "Create a comment on a task, list, or view. context_type defaults to 'task'. Use commentText for markdown or formattedComment for rich text with @mentions.",
 "inputSchema": {
  "properties": {
   "assignee": {
    "description": "Assign comment to user ID.",
    "type": "number"
   },
   "commentText": {
    "description": "Comment text. Markdown supported (**bold**, _italic_, `code`, - lists).",
    "type": "string"
   },
   "context_type": {
    "description": "Context: 'task' (default), 'list', or 'view'.",
    "enum": [
     "task",
     "list",
     "view"
    ],
    "type": "string"
   },
   "formattedComment": {
    "description": "Rich text array. Blocks: {text, attributes?} for text, {type:'tag', user:{id}} for @mention, {type:'emoji', unicode} for emoji.",
    "items": {
     "description": "Formatted comment block",
     "properties": {
      "attributes": {
       "description": "Formatting: bold, italic, underline, strikethrough, code, color, background_color, link",
       "properties": {
        "background_color": {
         "description": "HEX color code",
         "type": "string"
        },
        "bold": {
         "type": "boolean"
        },
        "code": {
         "type": "boolean"
        },
        "color": {
         "description": "HEX color code",
         "type": "string"
        },
        "italic": {
         "type": "boolean"
        },
        "link": {
         "description": "URL for the link",
         "type": "string"
        },
        "strikethrough": {
         "type": "boolean"
        },
        "underline": {
         "type": "boolean"
        }
       },
       "type": "object"
      },
      "text": {
       "description": "Text content",
       "type": "string"
      },
      "type": {
       "description": "Block type for mentions/emoji",
       "enum": [
        "tag",
        "emoji"
       ],
       "type": "string"
      },
      "unicode": {
       "description": "Unicode hex for emoji",
       "type": "string"
      },
      "user": {
       "description": "User to mention",
       "properties": {
        "id": {
         "description": "User ID",
         "type": "number"
        }
       },
       "type": "object"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "listName": {
    "description": "List name. Helps resolve duplicate task names.",
    "type": "string"
   },
   "list_id": {
    "description": "List ID. Required when context_type is 'list'.",
    "type": "string"
   },
   "list_name": {
    "description": "List name (auto-resolved). Used when context_type is 'list'.",
    "type": "string"
   },
   "notifyAll": {
    "description": "Notify all assignees.",
    "type": "boolean"
   },
   "task": {
    "description": "Task name or ID. Required when context_type is 'task' (default).",
    "type": "string"
   },
   "team_id": {
    "description": "The ClickUp Team ID or Workspace Name to use. If provided, the server will switch to this workspace for this and subsequent requests in the current session.",
    "type": "string"
   },
   "view_id": {
    "description": "View ID. Required when context_type is 'view'.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_comment"
}
