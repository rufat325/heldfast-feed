{
 "description": "Bulk-reject N clusters in one call. Symmetric to seo_bulk_approve_clusters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brandId": {
    "description": "Brand ID (defaults to active brand)",
    "type": "string"
   },
   "clusterIds": {
    "description": "Cluster IDs from seo_list_clusters to reject",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "clusterIds"
  ],
  "type": "object"
 },
 "name": "seo_bulk_reject_clusters"
}
