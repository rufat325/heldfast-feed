{
 "_meta": {
  "openai/toolInvocation/invoked": "Found matching schools",
  "openai/toolInvocation/invoking": "Looking up the school\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Look up a school by name"
 },
 "description": "Use this to turn a school's name into its DBN \u2014 the official name, a common short form ('Brooklyn Tech', 'PS 321'), or a DBN to confirm. Returns candidate schools with their district, neighborhood, admission method and Motley page; pick the one that matches and pass its dbn to get-admissions-demand. Never guess a DBN. K-12 schools only (public, charter, private).",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "borough": {
    "description": "Narrow a name search to one borough when the family named it. Ignored when the query is a DBN.",
    "enum": [
     "Manhattan",
     "Brooklyn",
     "Queens",
     "Bronx",
     "Staten Island"
    ],
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "Max candidates to return",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "The school as the family named it: its official name ('Townsend Harris High School'), a common short form ('Brooklyn Tech', 'PS 321'), or its DBN ('02M475').",
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "find-school",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "message": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "schools": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "type": [
        "string",
        "null"
       ]
      },
      "admissions_method": {
       "type": [
        "string",
        "null"
       ]
      },
      "admissions_methods": {
       "anyOf": [
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "borough": {
       "type": [
        "string",
        "null"
       ]
      },
      "dbn": {
       "type": "string"
      },
      "district": {
       "type": [
        "number",
        "null"
       ]
      },
      "governance": {
       "type": [
        "string",
        "null"
       ]
      },
      "grade_levels": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "nta_code": {
       "type": [
        "string",
        "null"
       ]
      },
      "nta_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "dbn",
      "name",
      "governance",
      "grade_levels",
      "address",
      "borough",
      "district",
      "nta_code",
      "nta_name",
      "admissions_method",
      "admissions_methods",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
