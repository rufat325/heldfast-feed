{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "$0.01 per call. Pay with x402 (USDC on Base) in _meta[\"x402/payment\"]; MPP (tempo) on the HTTP URL /v1/npi/verify. For 1 to 10 NPIs, the CMS NPPES status of each (active or deactivated, with deactivation and reactivation dates), provider name or organization, practice city, state and ZIP and taxonomies, plus any HHS-OIG LEIE exclusion listed under the NPI, as facts from the files: not a credential check and not a determination about the provider.",
 "inputSchema": {
  "additionalProperties": false,
  "description": "1 to 10 NPIs, each 10 digits with a valid check digit, no duplicates.",
  "properties": {
   "npis": {
    "description": "1 to 10 National Provider Identifiers: 10 digits each, the last a valid check digit (Luhn over 80840 + the NPI). No duplicates.",
    "examples": [
     [
      "1407013493",
      "1427908037"
     ]
    ],
    "items": {
     "pattern": "^[0-9]{10}$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "title": "Npis",
    "type": "array"
   }
  },
  "required": [
   "npis"
  ],
  "title": "NpiVerifyRequest",
  "type": "object"
 },
 "name": "npi_verify",
