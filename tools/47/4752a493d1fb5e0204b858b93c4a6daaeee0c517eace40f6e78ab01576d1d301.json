{
 "description": "Log an agent action with metadata for audit trails and debugging. Supports tool calls, LLM requests, decisions, and errors.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action_type": {
    "description": "Type of action being traced",
    "enum": [
     "tool_call",
     "llm_request",
     "decision",
     "error"
    ],
    "type": "string"
   },
   "description": {
    "description": "Human-readable description of the action",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Additional key-value metadata",
    "type": "object"
   },
   "session_id": {
    "description": "Unique session identifier",
    "type": "string"
   },
   "timestamp": {
    "description": "ISO 8601 timestamp (defaults to now)",
    "type": "string"
   },
   "tool_name": {
    "description": "Name of the tool (for tool_call actions)",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "action_type",
   "description"
  ],
  "type": "object"
 },
 "name": "trace_agent_action"
}
