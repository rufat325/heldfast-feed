{
 "description": "Build validated OData query parameters from structured intent (filters, date period, sort, top). Returns params for odata_query + human explanation.",
 "inputSchema": {
  "properties": {
   "datePeriod": {
    "properties": {
     "field": {
      "type": "string"
     },
     "from": {
      "description": "YYYY-MM-DD or ISO datetime",
      "type": "string"
     },
     "to": {
      "type": "string"
     }
    },
    "required": [
     "field"
    ],
    "type": "object"
   },
   "entity": {
    "description": "Target entity name",
    "type": "string"
   },
   "expand": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filters": {
    "description": "Structured filters: field, operator (eq/ne/gt/ge/lt/le/contains/startswith), value",
    "items": {
     "properties": {
      "field": {
       "type": "string"
      },
      "operator": {
       "type": "string"
      },
      "value": {}
     },
     "required": [
      "field",
      "operator",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "orderBy": {
    "items": {
     "properties": {
      "direction": {
       "enum": [
        "asc",
        "desc"
       ],
       "type": "string"
      },
      "field": {
       "type": "string"
      }
     },
     "required": [
      "field"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "select": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "top": {
    "type": "number"
   }
  },
  "required": [
   "entity"
  ],
  "type": "object"
 },
 "name": "odata_build_query"
}
