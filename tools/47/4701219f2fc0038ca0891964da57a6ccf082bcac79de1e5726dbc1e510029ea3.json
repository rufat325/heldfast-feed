{
 "description": "Requires a ChainHelix API key as bearer token, or 5 cents per call paid over Binance b402 in USDT, USDC, USD1 or U on BNB Smart Chain, or over x402 in USDC on the Base network. Risk profile of one wallet address across chains: risk score, mixer funding and source, dormancy, transaction count and value, protocols used, bridge count, flagged status, plus its recent bridge, mixer and transfer events. Public onchain behaviour only",
 "inputSchema": {
  "properties": {
   "address": {
    "type": "string"
   },
   "chain": {
    "enum": [
     "bitcoin",
     "ethereum",
     "bnb",
     "solana",
     "avalanche",
     "xrp",
     "tron",
     "polygon",
     "sui"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object",
  "x-aliases": {
   "address": [
    "Address"
   ]
  },
  "x-lexicon": {
   "bundleSha256": "e5b4290024a229f2bdf97f8fc6a0079c3fe13b77267f41fdcffeb8b26aa1c41e",
   "name": "ChainHelix Agentic Lexicon",
   "resolve": "lexicon_resolve",
   "spec": "lexicon_spec",
   "version": "0.1.0"
  },
  "x-vocab": {
   "address": "onchain.addressApi",
   "chain": "onchain.chain"
  }
 },
 "name": "wallet_risk",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "address": {
    "type": "string"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "contentHash": {
      "type": "string"
     },
     "generated": {
      "type": "number"
     },
     "priceUsd": {
      "type": "number"
     },
     "validUntil": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "profiled": {
    "type": "boolean"
   },
   "profiles": {
    "type": "array"
   },
   "receipt": {
    "additionalProperties": false,
    "properties": {
     "bytes": {
      "type": "number"
     },
     "covers": {
      "type": "string"
     },
     "issuedAt": {
      "type": "number"
     },
     "lookup": {
      "type": "string"
     },
     "network": {
      "type": [
       "string",
       "null"
      ]
     },
     "nonce": {
      "type": "string"
     },
     "seq": {
      "type": "number"
     },
     "settleTx": {
      "type": [
       "string",
       "null"
      ]
     },
     "sha256": {
      "type": "string"
     },
     "tool": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "recentEvents": {
    "type": "array"
   },
   "source": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "address",
   "profiled"
  ],
  "type": "object"
 }
}
