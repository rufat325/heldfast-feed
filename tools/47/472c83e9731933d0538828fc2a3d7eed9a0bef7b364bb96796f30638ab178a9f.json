 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Update which verified proofs are visible on the user's public profile, including visibility, masking, and display order.\n\nACCESS: needs a Proof account. Authenticate this client (Claude Code: /mcp \u2192 Authenticate), or sign in with start_login \u2014 a session opens this tool \u2014 then call this tool again.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "proofs": {
    "description": "Array of proof display configurations (max 50)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "asset_id": {
       "description": "Asset ID to display",
       "type": "string"
      },
      "display_order": {
       "description": "Display position (0-based)",
       "minimum": 0,
       "type": "integer"
      },
      "is_visible": {
       "description": "Whether the proof is visible on the public profile",
       "type": "boolean"
      },
      "label": {
       "description": "Custom label for the proof",
       "maxLength": 50,
       "type": "string"
      },
      "mask_level": {
       "description": "How much of the proof value to show",
       "enum": [
        "full",
        "partial",
        "hidden"
       ],
       "type": "string"
      }
     },
     "required": [
      "asset_id"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "proofs"
  ],
  "type": "object"
 },
 "name": "update_public_proofs"
}
