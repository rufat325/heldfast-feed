{
 "_meta": {
  "openai/outputTemplate": "ui://widget/vdc_plan_card.html",
  "openai/toolInvocation/invoked": "Plan updated.",
  "openai/toolInvocation/invoking": "Refining the plan\u2026"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Refine the Delivery Plan"
 },
 "description": "Revise an existing delivery plan based on the user's requested changes. Given a plan_id and instructions such as adjusting the timeline, adding or removing scope, or changing the team composition, this returns the updated plan and replaces the stored plan with the revised version. Use this tool when the user wants to modify a plan created earlier in the conversation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "feedback": {
    "description": "What the user wants changed in the plan. Examples: 'compress to 8 weeks', 'remove the QA pod and use AI test generation only', 'add data migration as a separate workstream'.",
    "maxLength": 2000,
    "minLength": 5,
    "type": "string"
   },
   "plan_id": {
    "description": "The plan_id returned by a prior create_delivery_plan call.",
    "maxLength": 64,
    "minLength": 16,
    "type": "string"
   }
  },
  "required": [
   "plan_id",
   "feedback"
  ],
  "type": "object"
 },
 "name": "refine_delivery_plan",
 "outputSchema": {
  "description": "A complete Virtual Delivery Center plan: pods, roles, AI agents, modules sized in Delivery Units, phased timeline, total Delivery Units and project cost, plus the recommended Delivery Pack.",
  "properties": {
   "ai_agents": {
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "role": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "role"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "industry": {
    "type": "string"
   },
   "modules": {
    "items": {
     "properties": {
      "aus": {
       "description": "Delivery Units for this module. JSON key is `aus` for legacy compatibility; semantically these are Delivery Units.",
       "maximum": 20,
       "minimum": 1,
       "type": "integer"
      },
      "depends_on": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "timeline_weeks": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "aus"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "plan_id": {
    "description": "Identifier for this plan; use it with refine_delivery_plan, get_delivery_plan, or recommend_next_step.",
    "type": "string"
   },
   "pods": {
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "purpose": {
       "type": "string"
      },
      "roles": {
       "items": {
        "properties": {
         "count": {
          "type": "integer"
         },
         "key_skills": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "seniority": {
          "enum": [
           "junior",
           "mid",
           "senior",
           "lead",
           "principal"
          ],
          "type": "string"
         },
         "title": {
          "type": "string"
         }
        },
        "required": [
         "title",
         "seniority",
         "count"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "roles"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "project_name": {
    "type": "string"
   },
   "recommended_pack": {
    "description": "The recommended Delivery Pack tier for this plan.",
    "properties": {
     "delivery_units": {
      "description": "Delivery Units in the pack (0 for enterprise/custom).",
      "type": "integer"
     },
     "is_enterprise": {
      "type": "boolean"
     },
     "is_most_popular": {
      "type": "boolean"
     },
     "key": {
      "enum": [
       "starter",
       "small",
       "scale",
       "enterprise"
      ],
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "per_delivery_unit_usd": {
      "description": "$/Delivery Unit at this tier.",
      "type": "integer"
     },
     "price_usd": {
      "type": "integer"
     },
     "validity_label": {
      "type": "string"
     }
    },
    "required": [
     "key",
     "name",
     "is_enterprise"
    ],
    "type": "object"
   },
   "summary": {
    "type": "string"
   },
   "tier_rate_per_du_usd": {
    "description": "$/Delivery Unit rate for this plan size, per the tier-band rate card.",
    "type": "integer"
   },
   "timeline_phases": {
    "items": {
     "properties": {
      "outcomes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "phase": {
       "type": "string"
      },
      "weeks": {
       "description": "Human-readable week range, e.g. 'Weeks 1-4'.",
       "type": "string"
      }
     },
     "required": [
      "phase",
      "weeks"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_aus": {
    "description": "Total Delivery Units across all modules. JSON key is `total_aus` for legacy compatibility.",
    "type": "number"
   },
   "total_cost_usd_project": {
    "description": "Project-flow USD cost at the tier-band rate.",
    "type": "integer"
   },
   "total_delivery_units": {
    "description": "Public-facing alias for total_aus. Same value.",
    "type": "number"
   }
  },
  "required": [
   "plan_id",
   "project_name",
   "summary",
   "pods",
   "modules",
   "total_delivery_units",
   "recommended_pack"
  ],
  "type": "object"
 }
}
