     "simple",
     "moderate",
     "complex"
    ],
    "type": "string"
   },
   "customization": {
    "default": "light",
    "enum": [
     "none",
     "light",
     "heavy"
    ],
    "type": "string"
   },
   "customsToPort": {
    "default": "1-3",
    "enum": [
     "none",
     "1-3",
     "4-10",
     "10+"
    ],
    "type": "string"
   },
   "integrations": {
    "default": "1-2",
    "enum": [
     "0",
     "1-2",
     "3-5",
     "6+"
    ],
    "type": "string"
   },
   "moduleCount": {
    "default": 5,
    "maximum": 15,
    "minimum": 1,
    "type": "integer"
   },
   "quality": {
    "default": "typical",
    "enum": [
     "clean",
     "typical",
     "messy"
    ],
    "type": "string"
   },
   "source": {
    "default": "netsuite",
    "enum": [
     "spreadsheets",
     "quickbooks",
     "xero",
     "sage50",
     "sage100",
     "sage300",
     "zoho",
     "dynamics365bc",
     "netsuite",
     "customdb",
     "sapb1",
     "saps4"
    ],
    "type": "string"
   },
   "userCount": {
    "default": 25,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "volume": {
    "default": "m",
    "enum": [
     "s",
     "m",
     "l",
     "xl"
    ],
    "type": "string"
   },
   "years": {
    "default": "3-7",
    "enum": [
     "open",
     "1-3",
     "3-7",
     "7+"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "odoo-migration-cost-calculator",
