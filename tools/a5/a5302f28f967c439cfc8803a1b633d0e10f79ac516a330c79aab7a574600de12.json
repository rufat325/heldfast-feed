{
 "_meta": {
  "lovie/risk": "read",
  "openai/toolInvocation/invoked": "Loaded",
  "openai/toolInvocation/invoking": "Loading\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Seal a transfer to a registered recipient as a server-held draft and get back a summary plus a single-use draft_id. Moves no money. Requires an active trusted device. Any change to amount, recipient, or rail is a NEW draft.",
 "inputSchema": {
  "properties": {
   "amountCents": {
    "type": "integer"
   },
   "companyId": {
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   },
   "destinationAccountId": {
    "maxLength": 36,
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$",
    "type": "string"
   },
   "memo": {
    "maxLength": 500,
    "type": "string"
   },
   "rail": {
    "enum": [
     "PAYMENT_RAIL_ACH",
     "PAYMENT_RAIL_WIRE",
     "PAYMENT_RAIL_RTP",
     "PAYMENT_RAIL_FEDNOW",
     "PAYMENT_RAIL_INTERNAL"
    ],
    "type": "string"
   },
   "recipientId": {
    "maxLength": 36,
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?$",
    "type": "string"
   },
   "serviceLevel": {
    "enum": [
     "PAYMENT_SERVICE_LEVEL_UNSPECIFIED",
     "PAYMENT_SERVICE_LEVEL_STANDARD",
     "PAYMENT_SERVICE_LEVEL_SAME_DAY"
    ],
    "type": "string"
   },
   "sourceAccountId": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "mcp_draft_transfer",
 "outputSchema": {
  "properties": {
   "availableCents": {
    "type": "string"
   },
   "draftId": {
    "type": "string"
   },
   "expiresAt": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "feeCents": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "totalDebitCents": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Mcp Draft Transfer"
}
