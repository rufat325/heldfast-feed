{
 "description": "Create a new blog.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "description": {
    "description": "Description of the blog",
    "type": "string"
   },
   "imageUrl": {
    "description": "URL of the blog cover image",
    "type": "string"
   },
   "locationId": {
    "description": "Location ID to create the blog under",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "pathname": {
    "description": "Base pathname for the blog URL",
    "type": "string"
   },
   "slug": {
    "description": "URL slug for the blog",
    "type": "string"
   },
   "title": {
    "description": "Title of the blog",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId",
   "title"
  ],
  "type": "object"
 },
 "name": "crm_create_blog"
}
