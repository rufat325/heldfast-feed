{
 "description": "Add a founding signature to a charter.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "charter_id": {
    "type": "string"
   },
   "resigner_private_key": {
    "description": "Key to re-sign the outer charter envelope",
    "type": "string"
   },
   "signer_private_key": {
    "type": "string"
   },
   "signer_public_key": {
    "type": "string"
   },
   "signer_role": {
    "default": "board",
    "type": "string"
   }
  },
  "required": [
   "charter_id",
   "signer_private_key",
   "signer_public_key",
   "resigner_private_key"
  ],
  "type": "object"
 },
 "name": "sign_charter"
}
