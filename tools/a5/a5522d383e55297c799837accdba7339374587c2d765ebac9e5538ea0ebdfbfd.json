{
 "_meta": {
  "fastmcp": {
   "tags": [
    "free"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "title": "Report quote issues"
 },
 "description": "Report one issue category across one or more quotes for human moderation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "misattributed",
     "garbage",
     "nested",
     "typo",
     "wrong_date",
     "offensive",
     "source_suggestion"
    ],
    "type": "string"
   },
   "context": {
    "anyOf": [
     {
      "maxLength": 1000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Shared explanation applied to every quote"
   },
   "quote_short_codes": {
    "description": "Short codes of quotes to report (1\u201325)",
    "items": {
     "type": "string"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   },
   "source_url": {
    "anyOf": [
     {
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Earliest, most direct source URL; required for source_suggestion"
   }
  },
  "required": [
   "quote_short_codes",
   "category"
  ],
  "type": "object"
 },
 "name": "report_quote",
 "title": "Report quote issues"
}
