{
 "description": "S\u1eeda c\u1ea5u h\u00ecnh nh\u00f3m c\u00f3 bot G\u1ea5u Mona; group_id l\u1ea5y t\u1eeb MONA Account/PMS v\u00e0 template d\u00f9ng text thu\u1ea7n v\u00ec Zalo kh\u00f4ng parse Markdown.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "events": {
    "items": {
     "enum": [
      "TRANSACTION_IN",
      "CHECKOUT_PAID",
      "WEBHOOK_FAILED",
      "VA_CREATED"
     ],
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array"
   },
   "friendly_name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "group_id": {
    "description": "group_id g\u1ed3m 10\u201325 ch\u1eef s\u1ed1, l\u1ea5y t\u1eeb MONA Account/PMS",
    "pattern": "^\\d{10,25}$",
    "type": "string"
   },
   "id": {
    "description": "ID c\u1ea5u h\u00ecnh nh\u00f3m Zalo do MONA Pay tr\u1ea3 v\u1ec1 (UUIDv6)",
    "minLength": 8,
    "type": "string"
   },
   "is_active": {
    "type": "boolean"
   },
   "message_template": {
    "description": "Template text thu\u1ea7n, kh\u00f4ng d\u00f9ng Markdown",
    "type": "string"
   },
   "virtual_account_id": {
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "monapay_update_zalo_group",
 "title": "S\u1eeda nh\u00f3m Zalo"
}
