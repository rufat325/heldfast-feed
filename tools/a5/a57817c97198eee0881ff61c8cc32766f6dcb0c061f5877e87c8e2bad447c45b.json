{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Service cost estimate"
 },
 "description": "Estimate typical US parts-and-labor price ranges (USD) for a list of car maintenance services at an economy, mid or luxury shop, with low and high totals. Use when budgeting for known services. An estimate, not a quote. Do NOT use to find which services are due (use due_services).",
 "inputSchema": {
  "properties": {
   "services": {
    "description": "Service ids to price (duplicates ignored), e.g. [\"oil_change\",\"brake_inspection\"]",
    "items": {
     "enum": [
      "oil_change",
      "tire_rotation",
      "brake_inspection",
      "air_filter",
      "cabin_filter",
      "coolant_service",
      "spark_plugs",
      "transmission_service",
      "battery_check"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "tier": {
    "description": "Shop tier: 'economy' (x0.85), 'mid' (default) or 'luxury' (x1.6)",
    "enum": [
     "economy",
     "mid",
     "luxury"
    ],
    "type": "string"
   }
  },
  "required": [
   "services"
  ],
  "type": "object"
 },
 "name": "service_cost_estimate",
 "outputSchema": {
  "properties": {
   "items": {
    "description": "Price range per service in USD",
    "items": {
     "properties": {
      "high": {
       "description": "High end of the typical price, USD",
       "type": "number"
      },
      "id": {
       "description": "Service id",
       "enum": [
        "oil_change",
        "tire_rotation",
        "brake_inspection",
        "air_filter",
        "cabin_filter",
        "coolant_service",
        "spark_plugs",
        "transmission_service",
        "battery_check"
       ],
       "type": "string"
      },
      "low": {
       "description": "Low end of the typical price, USD",
       "type": "number"
      },
      "name": {
       "description": "Service name",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "low",
      "high"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "description": "Summary of what was priced",
    "type": "string"
   },
   "source_note": {
    "description": "Source and estimate-not-quote caveat",
    "type": "string"
   },
   "tier": {
    "description": "Shop tier used for pricing",
    "enum": [
     "economy",
     "mid",
     "luxury"
    ],
    "type": "string"
   },
   "total_high": {
    "description": "Sum of high prices, USD",
    "type": "number"
   },
   "total_low": {
    "description": "Sum of low prices, USD",
    "type": "number"
   }
  },
  "required": [
   "tier",
   "items",
   "total_low",
   "total_high",
   "note",
   "source_note"
  ],
  "type": "object"
 },
 "title": "Service cost estimate"
}
