{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "campaign.read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List mnemon relationships"
 },
 "description": "List the relationships of a mnemon entry, split into outgoing edges, incoming edges, and a flat list of linked entries (entryId/title/type/relationshipTypes). Use this to find members of a faction, allies/enemies of an NPC, etc.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaignId": {
    "minLength": 1,
    "type": "string"
   },
   "entryId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "campaignId",
   "entryId"
  ],
  "type": "object"
 },
 "name": "list_mnemon_relationships",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "incoming": {
    "items": {
     "$ref": "#/properties/outgoing/items"
    },
    "type": "array"
   },
   "linked": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "entryId": {
       "type": "string"
      },
      "relationshipTypes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "entryId",
      "title",
      "type",
      "relationshipTypes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "outgoing": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "color": {
       "type": "string"
      },
      "direction": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "relationshipId": {
       "type": "string"
      },
      "sourceId": {
       "type": "string"
      },
      "symmetry": {
       "type": "string"
      },
      "targetId": {
       "type": "string"
      }
     },
     "required": [
      "relationshipId",
      "sourceId",
      "targetId",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "outgoing",
   "incoming",
   "linked"
  ],
  "type": "object"
 },
 "title": "List mnemon relationships"
}
