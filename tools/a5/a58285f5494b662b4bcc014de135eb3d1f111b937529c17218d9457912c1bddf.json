{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Create a prefilled checkout link"
 },
 "description": "Builds a vitalsvault.com checkout URL prefilled with an optional Essential, Advanced, or Max base panel and exact catalog handles, each revalidated for current price and orderability without substitution. The response lists items, live prices, and the subtotal before automatic promotions or promo codes. It is only a URL: no cart, session, account, order, or payment is created, and the person reviews, edits, and pays on the website. Identity, PHI, and free-text symptoms are outside the input contract.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assistant": {
    "description": "Optional assistant surface for link attribution (utm_source); other or omitted falls back to the MCP client.",
    "enum": [
     "chatgpt",
     "claude",
     "perplexity",
     "other"
    ],
    "type": "string"
   },
   "basePackage": {
    "description": "Optional base panel slug: essential, advanced, or max.",
    "enum": [
     "essential",
     "advanced",
     "max"
    ],
    "maxLength": 32,
    "type": "string"
   },
   "handles": {
    "description": "Exact public catalog handles to prefill. Without a base panel they open as a Build Your Own Panel; with one they are removable add-ons.",
    "items": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 0,
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "create_checkout_link",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "attribution": {
    "additionalProperties": false,
    "properties": {
     "utmCampaign": {
      "type": "string"
     },
     "utmMedium": {
      "type": "string"
     },
     "utmSource": {
      "enum": [
       "chatgpt",
       "claude",
       "perplexity",
       "mcp"
      ],
      "type": "string"
     }
    },
    "required": [
     "utmSource",
     "utmMedium",
     "utmCampaign"
    ],
    "type": "object"
   },
   "basePackage": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string"
       },
       "price": {
        "additionalProperties": false,
        "properties": {
         "amount": {
          "type": "number"
         },
         "currency": {
          "const": "USD",
          "type": "string"
         },
         "display": {
          "type": "string"
         }
        },
        "required": [
         "amount",
         "currency",
         "display"
        ],
        "type": "object"
       },
       "slug": {
        "type": "string"
       }
      },
      "required": [
       "slug",
       "name",
       "price"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "checkoutUrl": {
    "format": "uri",
    "type": "string"
   },
   "editable": {
    "const": true,
    "type": "boolean"
   },
   "humanCheckoutOnly": {
    "const": true,
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "handle": {
       "type": "string"
      },
      "itemType": {
       "enum": [
        "panel",
        "individual_test"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "price": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "type": "number"
        },
        "currency": {
         "const": "USD",
         "type": "string"
        },
        "display": {
         "type": "string"
        }
       },
       "required": [
        "amount",
        "currency",
        "display"
       ],
       "type": "object"
      }
     },
     "required": [
      "handle",
      "name",
      "itemType",
      "price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "minimumOrder": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "type": "number"
       },
       "currency": {
        "const": "USD",
        "type": "string"
       },
       "display": {
        "type": "string"
       },
       "met": {
        "type": "boolean"
       },
       "remaining": {
        "additionalProperties": false,
        "properties": {
         "amount": {
          "type": "number"
         },
         "currency": {
          "const": "USD",
          "type": "string"
         },
         "display": {
          "type": "string"
         }
        },
        "required": [
         "amount",
         "currency",
         "display"
        ],
        "type": "object"
       }
      },
      "required": [
       "amount",
       "currency",
       "display",
       "remaining",
       "met"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "mode": {
    "enum": [
     "package",
     "build_your_own_panel"
    ],
    "type": "string"
   },
   "priceNote": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "total": {
    "additionalProperties": false,
    "properties": {
     "amount": {
      "type": "number"
     },
     "currency": {
      "const": "USD",
      "type": "string"
     },
     "display": {
      "type": "string"
     },
     "label": {
      "type": "string"
     }
    },
    "required": [
     "amount",
     "currency",
     "display",
     "label"
    ],
    "type": "object"
   }
  },
  "required": [
   "checkoutUrl",
   "mode",
   "items",
   "total",
   "summary",
   "editable",
   "attribution",
   "humanCheckoutOnly",
   "priceNote"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Create a prefilled checkout link"
}
