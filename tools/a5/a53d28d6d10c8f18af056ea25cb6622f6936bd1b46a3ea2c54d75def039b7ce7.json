{
 "description": "Search for entities in the knowledge graph by name. Useful for finding people, projects, concepts, etc.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results. Default: 20",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search term (matched against entity names)",
    "type": "string"
   },
   "volume_id": {
    "description": "Volume ID. Uses default if not set.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_entities"
}
