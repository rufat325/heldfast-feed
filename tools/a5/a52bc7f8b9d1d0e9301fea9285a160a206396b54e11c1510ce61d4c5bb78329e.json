{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Cloud Insight rule template (\uac10\uc2dc \ud56d\ubaa9 \uadf8\ub8f9 / metrics group).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "groupName": {
    "description": "Name of the metrics group",
    "type": "string"
   },
   "metricList": {
    "description": "List of metric configurations",
    "items": {
     "additionalProperties": false,
     "properties": {
      "aggregation": {
       "description": "Aggregation type",
       "enum": [
        "AVG",
        "MIN",
        "MAX",
        "SUM",
        "COUNT"
       ],
       "type": "string"
      },
      "condition": {
       "description": "Threshold condition",
       "enum": [
        "GT",
        "GTE",
        "LT",
        "LTE",
        "EQ"
       ],
       "type": "string"
      },
      "duration": {
       "description": "Duration in minutes before triggering",
       "type": "number"
      },
      "eventLevel": {
       "description": "Event severity level",
       "enum": [
        "CRITICAL",
        "WARNING",
        "INFO"
       ],
       "type": "string"
      },
      "metricGroupItemId": {
       "description": "Metric item ID",
       "type": "string"
      },
      "threshold": {
       "description": "Threshold value",
       "type": "number"
      }
     },
     "required": [
      "metricGroupItemId",
      "condition",
      "threshold",
      "duration",
      "eventLevel"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "prodKey": {
    "description": "Product key (cw_key) for the target service",
    "type": "string"
   }
  },
  "required": [
   "prodKey",
   "groupName",
   "metricList"
  ],
  "type": "object"
 },
 "name": "ncloud_create_metrics_group"
}
