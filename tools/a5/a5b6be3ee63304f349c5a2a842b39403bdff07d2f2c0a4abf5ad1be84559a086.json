{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Run Batch of Browser Actions"
 },
 "description": "Execute a sequence of browser actions in a single call against an existing session.\n\nUse this when you already know the full sequence of steps \u2014 it reduces round trips and\nis faster than calling each tool individually.\n\nActions run sequentially and stop at the first failure unless stop_on_error is false.\nEach step result is returned in the results array at the same index.\n\nNote: screenshots in batch results are returned as base64 strings inside the JSON.\nFor proper image rendering, use browser_screenshot directly.",
 "execution": {
  "taskSupport": "forbidden"
 },
