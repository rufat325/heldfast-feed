{
 "description": "Promote a release from one track to another (e.g., internal \u2192 beta \u2192 production). Copies the latest release with its version codes and release notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "fromTrack": {
    "description": "Source track to promote from",
    "enum": [
     "internal",
     "alpha",
     "beta",
     "production"
    ],
    "type": "string"
   },
   "releaseNotes": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Override release notes (locale -> text). If omitted, copies from source track.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "status": {
    "default": "completed",
    "description": "Release status on destination track",
    "enum": [
     "draft",
     "inProgress",
     "completed"
    ],
    "type": "string"
   },
   "toTrack": {
    "description": "Destination track to promote to",
    "enum": [
     "internal",
     "alpha",
     "beta",
     "production"
    ],
    "type": "string"
   },
   "userFraction": {
    "description": "Staged rollout fraction (only for inProgress status)",
    "maximum": 1,
    "minimum": 0.01,
    "type": "number"
   }
  },
  "required": [
   "fromTrack",
   "toTrack"
  ],
  "type": "object"
 },
 "name": "gpc_promote_release"
}
