{"_meta":{"equivalentCommands":["kubectl logs <pod> -n <ns>"]},"annotations":{"readOnlyHint":true},"description":"Get pod logs. lines are as kubectl prints them, '<timestamp> <message>', oldest first; consecutive repeats of a message merge into the first, marked ' [\u00d7N]', and a budget cut keeps the newest. Use grep to filter lines by regex pattern (e.g. 'ERROR|WARN') instead of piping through shell commands.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"container":{"description":"Container name","type":"string"},"context":{"description":"Kube context","type":"string"},"detailLevel":{"description":"Item preset: summary 20, normal 100, full (default; also skips the response budget)","enum":["summary","normal","full"],"type":"string"},"grep":{"description":"Regex pattern to filter log lines (e.g. 'ERROR|WARN', 'timeout'). Only matching lines are returned.","type":"string"},"ignoreCase":{"description":"Case-insensitive grep matching (default: false)","type":"boolean"},"includeRaw":{"description":"Include raw/verbose fields","type":"boolean"},"maxItems":{"description":"Item cap; overrides detailLevel","exclusiveMinimum":0,"type":"integer"},"namespace":{"default":"default","description":"Namespace","type":"string"},"pod":{"description":"Required. Pod name (or deployment/xxx)","type":"string"},"since":{"description":"Duration like '1h', '30m'","type":"string"},"tail":{"default":100,"description":"Number of lines (default 100)","type":"number"}},"type":"object"},"name":"kube_logs","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"lines":{"items":{"type":"string"},"type":"array"},"retained":{"additionalProperties":{},"type":"object"},"total":{"type":"number"},"truncated":{"type":"boolean"}},"required":["lines"],"type":"object"},"title":"Kubectl logs"}
