{
 "description": "Ask discovered Agent-Q Firmware devices to display short identification codes. Writes a status handshake to candidate USB serial ports before sending the identify request.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "identify_devices",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activeDeviceId": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "devices": {
    "items": {
     "oneOf": [
      {
       "additionalProperties": false,
       "properties": {
        "code": {
         "pattern": "^[0-9]{4}$",
         "type": "string"
        },
        "connected": {
         "const": true,
         "type": "boolean"
        },
        "device": {
         "additionalProperties": false,
         "properties": {
          "deviceId": {
           "pattern": "^[A-Za-z0-9_.-]{1,128}$",
           "type": "string"
          },
          "firmwareName": {
           "maxLength": 64,
           "pattern": "^[\\x20-\\x7E]*$",
           "type": "string"
          },
          "firmwareVersion": {
           "maxLength": 32,
           "pattern": "^[\\x20-\\x7E]*$",
           "type": "string"
          },
          "hardware": {
           "maxLength": 64,
           "pattern": "^[\\x20-\\x7E]*$",
           "type": "string"
          },
          "state": {
           "enum": [
            "idle",
            "busy",
            "awaiting_approval",
            "locked",
            "error"
           ],
           "type": "string"
          }
         },
         "required": [
          "deviceId",
          "state",
          "firmwareName",
          "hardware",
          "firmwareVersion"
         ],
         "type": "object"
        },
        "portPath": {
         "maxLength": 128,
         "pattern": "^[\\x20-\\x7E]*$",
         "type": "string"
        },
        "source": {
         "const": "live",
         "type": "string"
        }
       },
       "required": [
        "source",
        "connected",
        "portPath",
        "code",
        "device"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "connected": {
         "const": false,
         "type": "boolean"
        },
        "deviceId": {
         "pattern": "^[A-Za-z0-9_.-]{1,128}$",
         "type": "string"
        },
        "error": {
         "additionalProperties": false,
         "properties": {
          "code": {
           "type": "string"
          },
          "message": {
           "type": "string"
          },
          "retryable": {
           "type": "boolean"
          }
         },
         "required": [
          "code",
          "message",
          "retryable"
         ],
         "type": "object"
        },
        "portPath": {
         "maxLength": 128,
         "pattern": "^[\\x20-\\x7E]*$",
         "type": "string"
        },
        "source": {
         "const": "error",
         "type": "string"
        },
        "status": {
         "const": "error",
         "type": "string"
        }
       },
       "required": [
        "source",
        "connected",
        "portPath",
        "deviceId",
        "status",
        "error"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "source": {
    "const": "live",
    "type": "string"
   }
  },
  "required": [
   "source",
   "devices",
   "activeDeviceId"
  ],
  "type": "object"
 },
 "title": "Identify devices"
}
