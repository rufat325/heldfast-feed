{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Probe a remote MCP server URL once, credential-free and without calling its tools, and get its quality checks and its readiness for the Claude and OpenAI directories. Pass `url` to start a check (waits up to 25 s for the result), or `id` to read one. Quota: a few checks per hour anonymously, more with an API key.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "A check id returned earlier, to read its result",
    "maxLength": 64,
    "type": "string"
   },
   "url": {
    "description": "The server's streamable HTTP or SSE URL, e.g. https://mcp.example.com/mcp. Never include credentials.",
    "maxLength": 2000,
    "type": "string"
   },
   "wait": {
    "description": "Seconds to wait for the result (default 25)",
    "maximum": 25,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "check_server",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "disclaimer": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "finished_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "description": "Pass as id to read the result later",
    "type": "string"
   },
   "next_actions": {
    "description": "Follow-up calls: action is the tool, arguments are ready to pass ({placeholders} are yours to fill)",
    "items": {
     "additionalProperties": {},
     "properties": {
      "action": {
       "type": "string"
      },
      "arguments": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "page": {
    "description": "Shareable result page",
    "type": "string"
   },
   "requested_at": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "description": "Present when status is done",
    "properties": {
     "probe": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     "quality": {
      "additionalProperties": {},
      "properties": {
       "label": {
        "type": "string"
       },
       "score": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "score",
       "label"
      ],
      "type": "object"
     },
     "readiness": {
      "description": "Claude and OpenAI directory requirements, one per directory; items are pass, warn, fail, unknown, manual or na",
      "items": {
       "additionalProperties": {},
       "properties": {},
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "probe",
     "quality",
     "readiness"
    ],
    "type": "object"
   },
   "server": {
    "description": "The catalog server listing this URL, if any",
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "enum": [
     "queued",
     "running",
     "done",
     "failed"
    ],
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "status",
   "url",
   "requested_at",
   "finished_at",
   "server",
   "page",
   "disclaimer",
   "next_actions"
  ],
  "type": "object"
 },
 "title": "Check an MCP server URL"
}
