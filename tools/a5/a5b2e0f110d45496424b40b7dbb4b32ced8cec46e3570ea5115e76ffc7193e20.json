{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Render a prompt by substituting variables and returning the final messages without calling the model. Use this to verify template output before a completion; run_prompt_completion is the tool that actually invokes the model.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "hyperparameters": {
    "description": "Override default hyperparameters",
    "properties": {
     "frequency_penalty": {
      "description": "Frequency penalty (-2 to 2)",
      "maximum": 2,
      "minimum": -2,
      "type": "number"
     },
     "max_tokens": {
      "description": "Maximum tokens to generate",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "presence_penalty": {
      "description": "Presence penalty (-2 to 2)",
      "maximum": 2,
      "minimum": -2,
      "type": "number"
     },
     "stop": {
      "description": "Stop sequences",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "temperature": {
      "description": "Sampling temperature (0-2)",
      "maximum": 2,
      "minimum": 0,
      "type": "number"
     },
     "top_k": {
      "description": "Top-k sampling",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "top_p": {
      "description": "Top-p sampling (0-1)",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "prompt_id": {
    "description": "Prompt ID or slug to render",
    "type": "string"
   },
   "variables": {
    "additionalProperties": {
     "type": [
      "string",
      "number",
      "boolean"
     ]
    },
    "description": "Variable values to substitute into the template",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "prompt_id",
   "variables"
  ],
  "type": "object"
 },
 "name": "render_prompt",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
