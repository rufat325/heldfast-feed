{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List images uploaded to the DeepSeek Files API. Supports cursor pagination, creation-time order, and the `user_data` purpose filter.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "after": {
    "pattern": "^file-api-[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "limit": {
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "order": {
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "purpose": {
    "const": "user_data",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_files",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "data": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "bytes": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "created_at": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "expires_at": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "filename": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "object": {
       "const": "file",
       "type": "string"
      },
      "purpose": {
       "const": "user_data",
       "type": "string"
      }
     },
     "required": [
      "id",
      "object",
      "bytes",
      "created_at",
      "filename",
      "purpose"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error_type": {
    "enum": [
     "deepseek_api_error",
     "tool_execution_error"
    ],
    "type": "string"
   },
   "first_id": {
    "type": "string"
   },
   "has_more": {
    "type": "boolean"
   },
   "last_id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "object": {
    "const": "list",
    "type": "string"
   },
   "retryable": {
    "type": "boolean"
   },
   "status": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "suggestion": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
