{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Remove a pronunciation fix"
 },
 "description": "Use this when someone wants to drop a pronunciation rule so a word is spoken the default way again. Returns whether it was removed and the remaining rule count; a missing rule changes nothing, and existing audio is kept as it is. Not for changing a rule's phonemes.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "description": "Project the rule belongs to",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "word": {
    "description": "Exact word or phrase whose pronunciation rule should be removed",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "word"
  ],
  "type": "object"
 },
 "name": "remove_pronunciation_rule",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "remainingRuleCount": {
    "anyOf": [
     {
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "remainingRuleCountIsLowerBound": {
    "type": "boolean"
   },
   "status": {
    "enum": [
     "removed",
     "unchanged",
     "project-not-found"
    ],
    "type": "string"
   },
   "word": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "status",
   "projectId",
   "word",
   "remainingRuleCount",
   "remainingRuleCountIsLowerBound"
  ],
  "type": "object"
 },
 "title": "Remove a pronunciation fix"
}
