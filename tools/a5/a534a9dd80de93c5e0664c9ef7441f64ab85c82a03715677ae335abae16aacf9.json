 "description": "Use for line items as filed with the SEC (revenue, net income, cash flow, dividends paid, debt\u2026) by year or quarter. Raw as-filed statement rows (income statement, balance sheet, or cash flow) sourced exclusively from SEC EDGAR XBRL company facts \u2014 public domain, latest-filed per period, honest nulls (never zero-filled, never vendor-backfilled). Derived quarters are disclosed. Token-frugal default: 5 fiscal years without per-value provenance; set include_provenance for the winning us-gaap tag + accession per value, or use https://tgmcharts.com/api/v1/statements/{symbol}/{statement} for full depth (30y, CSV).",
 "inputSchema": {
  "properties": {
   "format": {
    "description": "json (default): the full JSON as text. markdown: a compact table or list, fewer tokens. structuredContent is the full JSON either way.",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   },
   "include_provenance": {
    "description": "Include per-value provenance (us-gaap tag, accession, filed date). Default false to stay token-frugal.",
    "type": "boolean"
   },
   "period": {
    "description": "annual (default) or quarterly",
    "enum": [
     "annual",
     "quarterly"
    ],
    "type": "string"
   },
   "statement": {
    "description": "Which statement",
    "enum": [
     "income-statement",
     "balance-sheet",
     "cash-flow"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Ticker symbol, e.g. AAPL",
    "type": "string"
   },
   "years": {
    "description": "Trailing fiscal years of rows (default 5; quarterly serves 4\u00d7years)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "symbol",
   "statement"
  ],
  "type": "object"
 },
