{
 "description": "Search past dead ends to avoid repeating mistakes",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fuzzy": {
    "description": "Enable fuzzy matching for typos (default: true)",
    "type": "boolean"
   },
   "limit": {
    "description": "Max results to return (default 20)",
    "type": "number"
   },
   "mode": {
    "description": "Search mode: 'and' requires all words, 'or' matches any (default: or)",
    "enum": [
     "and",
     "or"
    ],
    "type": "string"
   },
   "query": {
    "description": "Search term",
    "type": "string"
   },
   "tags": {
    "description": "Filter by tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "dead_end_search"
}
