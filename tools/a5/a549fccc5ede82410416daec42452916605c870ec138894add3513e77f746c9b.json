 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Authorized visual access to one READY feedback image: mints a SHORT-LIVED (300s) signed read grant returned as an MCP resource_link so a client can fetch and inspect the image. The link is never persisted server-side and must not be logged or stored; structured content carries only safe metadata (no URL). Employer-only: writes need project_todos:write and reads need project_todos:read, plus canonical organization/job access. Freelancer quiz access is retired. Missing, foreign, wrong-owner, and closed-window are one indistinguishable 404. No base64 anywhere \u2014 bytes travel only through the signed grant.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "minLength": 1,
    "type": "string"
   },
   "assignmentId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "assetId"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_coaching_image_delivery",
 "outputSchema": {
