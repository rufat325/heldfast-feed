  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "asset": {
      "additionalProperties": false,
      "properties": {
       "assetId": {
        "type": "string"
       },
       "byteSize": {
        "type": "integer"
       },
       "contentType": {
        "enum": [
         "image/png",
         "image/jpeg",
