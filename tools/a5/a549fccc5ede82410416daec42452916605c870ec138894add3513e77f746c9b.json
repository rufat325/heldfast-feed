          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "sha256": {
        "type": [
         "string",
         "null"
        ]
       },
       "status": {
        "enum": [
         "PENDING",
         "READY"
        ],
        "type": "string"
       },
       "uploaderRole": {
