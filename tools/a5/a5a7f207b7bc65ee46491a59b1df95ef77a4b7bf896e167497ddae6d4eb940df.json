   },
   "intention_id": {
    "description": "Target intention ID",
    "type": "string"
   },
   "project": {
    "description": "Target project slug",
    "type": "string"
   },
   "proposed_action": {
    "description": "Proposed behavior action to execute",
    "properties": {
     "behavior_name": {
      "type": "string"
     },
     "parameters": {
      "type": "object"
     },
     "target_resources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "behavior_name"
    ],
    "type": "object"
   },
   "state_pack": {
    "description": "Optional explicit StatePack",
    "type": "object"
   }
  },
  "required": [
   "project",
   "proposed_action"
  ],
  "type": "object"
 },
 "name": "gate_intention"
}
