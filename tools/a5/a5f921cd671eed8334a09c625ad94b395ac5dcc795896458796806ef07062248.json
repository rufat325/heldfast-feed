{
 "annotations": {
  "destructiveHint": true,
  "title": "Log time on a job"
 },
 "description": "WRITE: log hours worked by an employee on a job. `employee_id` is the employee's `id` from kickserv_list_employees. Kickserv: POST /{account}/jobs/{job_number}/time_entries.xml.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "billable": {
    "description": "Whether the time is billable.",
    "type": "boolean"
   },
   "employee_id": {
    "description": "The employee's `id`.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "ended_on": {
    "description": "When the work ended. A date/time string Kickserv can parse, e.g. `2026-10-02 09:30` or `10/2/2026 09:30am`.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "job_number": {
    "description": "Job number.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "mileage": {
    "description": "Mileage driven.",
    "maximum": 100000,
    "minimum": 0,
    "type": "number"
   },
   "note": {
    "description": "Note about the work.",
    "maxLength": 5000,
    "type": "string"
   },
   "number_of_hours": {
    "description": "Hours worked, e.g. 1.25.",
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "number"
   },
   "started_on": {
    "description": "When the work started, e.g. `2026-10-02 13:00` or `10/02/2026 01:00pm`.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "time_entry_type_id": {
    "description": "Time entry type id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "job_number",
   "employee_id",
   "started_on",
   "number_of_hours"
  ],
  "type": "object"
 },
 "name": "kickserv_log_time_entry",
 "title": "Log time on a job"
}
