      },
      "id": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "name": {
       "maxLength": 40,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "hex"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   },
   "description": {
    "maxLength": 1000,
    "type": "string"
   },
   "name": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "picorn_projects_create",
