{
 "description": "Have a multi-turn conversation with Adorbis AI by passing the full message history. Use this when you need to maintain context across multiple exchanges.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "department": {
    "default": "adorbis/auto",
    "enum": [
     "adorbis/coder",
     "adorbis/quick",
     "adorbis/auto",
     "adorbis/write",
     "adorbis/reason"
    ],
    "type": "string"
   },
   "max_tokens": {
    "default": 2048,
    "maximum": 8192,
    "minimum": 1,
    "type": "integer"
   },
   "messages": {
    "description": "Full conversation history as an array of {role, content} objects",
    "items": {
     "properties": {
      "content": {
       "type": "string"
      },
      "role": {
       "enum": [
        "user",
        "assistant",
        "system"
       ],
       "type": "string"
      }
     },
     "required": [
      "role",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "messages"
  ],
  "type": "object"
 },
 "name": "adorbis_multi_turn"
}
