{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "rank"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Queries with high impressions and low ctr in Search Console. Defaults are at least 100 impressions and ctr at or below 0.02 (the API fraction, so 0.02 is 2%). Does not estimate missed clicks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "device": {
    "enum": [
     "DESKTOP",
     "MOBILE",
     "TABLET"
    ],
    "type": "string"
   },
   "endDate": {
    "$ref": "#/properties/startDate"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "maxCtr": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "minImpressions": {
    "minimum": 0,
    "type": "number"
   },
   "searchType": {
    "enum": [
     "web",
     "image",
     "video",
     "news",
     "discover",
     "googleNews"
    ],
    "type": "string"
   },
   "siteUrl": {
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "startDate": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "siteUrl"
  ],
  "type": "object"
 },
 "name": "quick_wins",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "Quick wins"
}
