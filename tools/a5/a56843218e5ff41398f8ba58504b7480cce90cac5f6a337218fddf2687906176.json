{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Solve Sketch"
 },
 "description": "Use this when you need to solve a 2D sketch constraint set. Solve a 2D sketch constraint set. Side-effect-free: pass { entities, constraints } and receive solved entities plus the original constraints. Entities are POINT, LINE, and CIRCLE records; constraints use the kernelCAD constraint vocabulary.",
 "inputSchema": {
  "properties": {
   "constraints": {
    "description": "Constraints to apply to the entities.",
    "items": {
     "properties": {
      "entities": {
       "description": "Ids of the entities the constraint relates.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "type": {
       "enum": [
        "COINCIDENT",
        "DISTANCE",
        "HORIZONTAL",
        "VERTICAL",
        "PARALLEL",
        "PERPENDICULAR",
        "EQUAL_LENGTH",
        "TANGENT",
        "RADIUS",
        "ANGLE",
        "CONCENTRIC",
        "SYMMETRIC"
       ],
       "type": "string"
      },
      "value": {
       "description": "Required for DISTANCE, RADIUS, and ANGLE.",
       "type": "number"
      }
     },
     "required": [
      "id",
      "type",
      "entities"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "entities": {
    "description": "Sketch entities to solve. Lines reference point ids; circles reference a center point id.",
    "items": {
     "oneOf": [
      {
       "description": "POINT \u2014 a 2D point.",
       "properties": {
        "fixed": {
         "description": "If true, the solver won't move this point.",
         "type": "boolean"
        },
        "id": {
         "type": "string"
        },
        "type": {
         "enum": [
          "POINT"
         ],
         "type": "string"
        },
        "x": {
         "type": "number"
        },
        "y": {
         "type": "number"
        }
       },
       "required": [
        "id",
        "type",
        "x",
        "y"
       ],
       "type": "object"
      },
      {
       "description": "LINE \u2014 references two point ids.",
       "properties": {
        "id": {
         "type": "string"
        },
        "p1": {
         "type": "string"
        },
        "p2": {
         "type": "string"
        },
        "type": {
         "enum": [
          "LINE"
         ],
         "type": "string"
        }
       },
       "required": [
        "id",
        "type",
        "p1",
        "p2"
       ],
       "type": "object"
      },
      {
       "description": "CIRCLE \u2014 references a center point id.",
       "properties": {
        "center": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "radius": {
         "type": "number"
        },
        "type": {
         "enum": [
          "CIRCLE"
         ],
         "type": "string"
        }
       },
       "required": [
        "id",
        "type",
        "center",
        "radius"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   }
  },
  "required": [
   "entities",
   "constraints"
  ],
  "type": "object"
 },
 "name": "solve_sketch",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "constraints": {
    "description": "The constraints applied.",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "converged": {
    "description": "Whether the constraint solve converged below tolerance. ok is false when this is false.",
    "type": "boolean"
   },
   "entities": {
    "description": "Solved sketch entities (best-effort on a non-converging solve).",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "errors": {
    "description": "Solver/validation errors (present on failure, including non-convergence).",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "residual": {
    "description": "Final aggregate constraint residual when the solver ran.",
    "type": "number"
   }
  },
  "required": [
   "ok",
   "entities",
   "constraints"
  ],
  "type": "object"
 },
 "title": "Solve Sketch"
}
