{
 "description": "Submit evidence to an accessible interaction. Evidence text is stored as untrusted data, never executed or fetched.",
 "inputSchema": {
  "properties": {
   "evidence": {
    "properties": {
     "evidence": {
      "properties": {
       "content": {
        "type": "string"
       },
       "kind": {
        "type": "string"
       },
       "sourceUrl": {
        "type": "string"
       },
       "visibility": {
        "default": "private",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "sourceUrl",
       "content"
      ],
      "type": "object"
     },
     "expectedVersion": {
      "type": "integer"
     }
    },
    "required": [
     "expectedVersion",
     "evidence"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "type": "string"
   },
   "interactionId": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "interactionId",
   "evidence",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "submit_evidence"
}
