  "properties": {
   "data": {
    "properties": {
     "auth_mode": {
      "enum": [
       "app-only",
       "user"
      ],
      "type": "string"
     },
     "availability": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "me": {
      "properties": {
       "handle": {
        "type": "string"
       },
       "id": {
        "type": "string"
       }
      },
      "required": [
       "id"
      ],
      "type": "object"
     },
     "note": {
      "type": "string"
     },
     "policy": {
      "properties": {
       "cells": {
        "additionalProperties": {
         "type": "boolean"
        },
        "type": "object"
       },
       "preset": {
        "type": "string"
       }
      },
      "required": [
       "preset",
       "cells"
      ],
      "type": "object"
     },
     "scopes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
