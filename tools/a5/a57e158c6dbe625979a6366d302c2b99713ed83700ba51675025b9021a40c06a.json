{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store the escalation limit the user has explicitly approved for one channel. maxTier must be on tierLadder. Promise flags default closed unless the user sets them true. A limit does not itself approve refund, feature, or timeline wording.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowFeaturePromise": {
    "default": false,
    "type": "boolean"
   },
   "allowRefundPromise": {
    "default": false,
    "type": "boolean"
   },
   "allowTimelinePromise": {
    "default": false,
    "type": "boolean"
   },
   "channel": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "deskId": {
    "format": "uuid",
    "type": "string"
   },
   "expectedRevision": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxTier": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "maxLength": 4000,
    "type": "string"
   },
   "status": {
    "default": "APPROVED",
    "enum": [
     "APPROVED",
     "RETIRED"
    ],
    "type": "string"
   },
   "tierLadder": {
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "deskId",
   "name",
   "channel",
   "tierLadder",
   "maxTier"
  ],
  "type": "object"
 },
 "name": "save_escalation_limit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "save escalation limit"
}
