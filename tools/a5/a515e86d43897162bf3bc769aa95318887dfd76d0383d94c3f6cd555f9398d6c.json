{
 "description": "Submit a self-declared identity claim with accessible evidence. Conflicting claims coexist. This never binds a payment recipient.",
 "inputSchema": {
  "properties": {
   "claim": {
    "properties": {
     "evidenceIds": {
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "type": "array"
     },
     "interactionId": {
      "format": "uuid",
      "type": "string"
     },
     "statement": {
      "type": "string"
     },
     "visibility": {
      "default": "private",
      "type": "string"
     }
    },
    "required": [
     "interactionId",
     "statement",
     "evidenceIds"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "type": "string"
   },
   "subjectId": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "subjectId",
   "claim",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "submit_identity_claim"
}
