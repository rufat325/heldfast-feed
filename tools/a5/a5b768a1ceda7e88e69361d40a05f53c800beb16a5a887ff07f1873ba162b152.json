{
 "description": "Underwrite a market on BaseAlpha (bonding curve V4, Base mainnet). Handles the entire flow in one call: quotes it, signs and sends the transaction from your wallet, waits for confirmation, and registers the market so it appears on basealpha.fun. Returns the new token address and its page URL. Branding (logo/banner/clip/socials/squad) is optional but must be https URLs you host \u2014 there is no image-upload API for agents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "animationUrl": {
    "$ref": "#/properties/logoUrl",
    "description": "https clip/animation URL you host (e.g. mp4)"
   },
   "bannerUrl": {
    "$ref": "#/properties/logoUrl",
    "description": "https banner URL you host"
   },
   "category": {
    "maxLength": 50,
    "type": "string"
   },
   "creatorBuyEth": {
    "description": "Optional ETH amount to buy of your own token at launch, e.g. \"0.05\". Default \"0\".",
    "type": "string"
   },
   "description": {
    "description": "Long description",
    "maxLength": 2000,
    "type": "string"
   },
   "descriptionShort": {
    "description": "Short description / blurb",
    "maxLength": 200,
    "type": "string"
   },
   "discord": {
    "description": "Discord invite or URL",
    "maxLength": 255,
    "type": "string"
   },
   "docsUrl": {
    "$ref": "#/properties/logoUrl"
   },
   "extra_links": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Extra link map, e.g. { \"mirror\": \"https://\u2026\" }",
    "type": "object"
   },
   "feeMode": {
    "description": "Buyer-pool modes: \"cashback\" (VOLUME) or \"stay\" (HODL); omit for default creator fees",
    "enum": [
     "cashback",
     "stay"
    ],
    "type": "string"
   },
   "github": {
    "description": "GitHub org/repo or URL",
    "maxLength": 255,
    "type": "string"
   },
   "logoUrl": {
    "description": "https logo URL you host (IPFS gateway / CDN)",
    "format": "uri",
    "type": "string"
   },
   "name": {
    "description": "Token name, 1-50 characters",
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "social_links": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Extra social map, e.g. { \"farcaster\": \"https://\u2026\" }",
    "type": "object"
   },
   "squadMembers": {
    "description": "Squad Launch crew shown on the token page (\u226410). Holdings are verified on-chain.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "description": "0x\u2026, ENS, or Solana pubkey",
       "minLength": 1,
       "type": "string"
      },
      "label": {
       "description": "Role label, e.g. Co-founder",
       "maxLength": 24,
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "supply": {
    "description": "Total supply as a whole number, between 1000000 and 1000000000000000",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "symbol": {
    "description": "Ticker symbol, 2-10 characters",
    "maxLength": 10,
    "minLength": 2,
    "type": "string"
   },
   "tagline": {
    "maxLength": 100,
    "type": "string"
   },
   "teamStatus": {
    "description": "e.g. anon, doxxed, team",
    "maxLength": 50,
    "type": "string"
   },
   "telegram": {
    "description": "Telegram handle or URL",
    "maxLength": 255,
    "type": "string"
   },
   "twitter": {
    "description": "X/Twitter handle or URL",
    "maxLength": 255,
    "type": "string"
   },
   "website": {
    "$ref": "#/properties/logoUrl"
   },
   "whitepaperUrl": {
    "$ref": "#/properties/logoUrl"
   }
  },
  "required": [
   "name",
   "symbol",
   "supply"
  ],
  "type": "object"
 },
 "name": "launch_token"
}
