{
 "description": "Weight of metal stock per profile: pipe/tube (OD + wall), round bar, square/rectangular tube, flat bar, angle, beam/I-beam. Materials: steel, stainless, aluminum, copper, brass.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "height_mm": {
    "description": "rect-tube/beam: height",
    "minimum": 0,
    "type": "number"
   },
   "length_m": {
    "description": "Length in meters",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "material": {
    "enum": [
     "steel",
     "stainless",
     "aluminum",
     "copper",
     "brass"
    ],
    "type": "string"
   },
   "od_mm": {
    "description": "pipe/round-bar: outer diameter",
    "minimum": 0,
    "type": "number"
   },
   "profile": {
    "enum": [
     "pipe",
     "round-bar",
     "square-tube",
     "rect-tube",
     "flat-bar",
     "angle",
     "beam"
    ],
    "type": "string"
   },
   "qty": {
    "default": 1,
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wall_mm": {
    "description": "pipe/tubes: wall thickness",
    "minimum": 0,
    "type": "number"
   },
   "web_mm": {
    "description": "beam: web thickness",
    "minimum": 0,
    "type": "number"
   },
   "width_mm": {
    "description": "rect-tube/flat-bar/angle/beam: width",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "profile",
   "material",
   "length_m"
  ],
  "type": "object"
 },
 "name": "metal_weight_calculator"
}
