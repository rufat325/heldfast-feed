 "description": "\u0417\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u041d\u0410\u0411\u0406\u0420 \u0424\u0406\u041b\u042c\u0422\u0420\u0406\u0412 \u043f\u043e\u0448\u0443\u043a\u0443 \u0434\u043b\u044f \u0442\u0430\u0431\u043b\u0438\u0446\u0456 (\u043a\u0440\u0438\u0442\u0435\u0440\u0456\u0457 + \u0441\u043e\u0440\u0442\u0443\u0432\u0430\u043d\u043d\u044f). \u26a0\ufe0f \u0426\u0435 \u041d\u0415 \u0437\u0432\u0456\u0442: \u043d\u0430 \u0441\u0442\u043e\u0440\u0456\u043d\u0446\u0456 \u00ab\u0417\u0432\u0456\u0442\u0438\u00bb \u0439\u043e\u0433\u043e \u043d\u0435 \u0431\u0443\u0434\u0435 \u2014 \u0442\u0430\u043c \u0436\u0438\u0432\u0443\u0442\u044c \u0432\u0456\u0434\u0436\u0435\u0442\u0438-\u0437\u0432\u0456\u0442\u0438 (create_report). \u041d\u0435 \u043d\u0430\u0437\u0438\u0432\u0430\u0439 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u0437\u0432\u0456\u0442\u043e\u043c \u0456 \u043d\u0435 \u043f\u0440\u043e\u043f\u043e\u043d\u0443\u0439 \u0446\u0435 \u044f\u043a \u0441\u043f\u043e\u0441\u0456\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0432\u0438\u0433\u043b\u044f\u0434/\u0440\u043e\u0437\u043a\u043b\u0430\u0434\u043a\u0443 \u0432\u043e\u0440\u043a\u0441\u043f\u0435\u0439\u0441\u0443.",
 "inputSchema": {
  "properties": {
   "app_id": {
    "description": "Project ID (from list_projects)",
    "type": "string"
   },
   "entity_id": {
    "description": "Form ID (from list_forms or describe_project)",
    "type": "string"
   },
   "filters": {
    "description": "\u041c\u0430\u0441\u0438\u0432 \u0443\u043c\u043e\u0432 \u0444\u0456\u043b\u044c\u0442\u0440\u0430\u0446\u0456\u0457",
    "items": {
     "properties": {
      "condition": {
       "description": "equal, not_equal, contains, not_contains, greater_than, less_than, is_empty, is_not_empty, this_day_and_after, this_day_and_before",
       "type": "string"
      },
      "field": {
       "description": "field_name \u0430\u0431\u043e field_id",
       "type": "string"
      },
      "join": {
       "description": "and (default) | or",
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Display name",
    "type": "string"
   },
   "order_asc": {
    "description": "true=ASC (default), false=DESC",
    "type": "boolean"
   },
   "sort_by": {
    "description": "field_name \u0430\u0431\u043e field_id \u0434\u043b\u044f \u0441\u043e\u0440\u0442\u0443\u0432\u0430\u043d\u043d\u044f",
    "type": "string"
   }
  },
  "required": [
   "app_id",
   "entity_id",
   "name"
  ],
  "type": "object"
 },
 "name": "create_saved_view",
 "securitySchemes": [
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ]
}
