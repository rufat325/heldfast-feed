 "description": "Look up one person by LinkedIn URL, email, or name and company domain. Returns the person with their emails, phones, role and company. Charges 1 credit only when the person is found with an email or phone. saveToContacts also stores them in your contacts. Send an Idempotency-Key header to make retries safe.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "domain": {
    "description": "Company domain, e.g. \"acme.com\"",
    "minLength": 3,
    "type": "string"
   },
   "email": {
    "description": "Known email address identifying the person",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "linkedin": {
    "description": "e.g. \"https://www.linkedin.com/in/jane-doe\"",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Full name, e.g. \"Jane Doe\"; needs domain",
    "minLength": 3,
    "type": "string"
   },
   "saveToContacts": {
    "default": false,
    "description": "Save the returned person to your Deeplead contacts",
    "type": "boolean"
   }
  },
  "type": "object"
 },
