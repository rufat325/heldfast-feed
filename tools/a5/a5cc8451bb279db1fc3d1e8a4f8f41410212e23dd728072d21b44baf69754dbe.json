{
 "description": "Generate a complete dark mode from the light system built on a brand color: dark surfaces and text, adjusted palette, shadows and spacing, with contrast checked.",
 "inputSchema": {
  "properties": {
   "color": {
    "description": "Brand color in hex (e.g. #6366F1). The whole system is built from it.",
    "type": "string"
   },
   "color_scheme": {
    "description": "The palette the dark theme is derived from (default analogous)",
    "enum": [
     "monochromatic",
     "analogous",
     "complementary",
     "triadic",
     "split-complementary"
    ],
    "type": "string"
   },
   "colors": {
    "description": "Additional brand colors in hex (up to 5 colors in total, including `color`).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "preferences": {
    "description": "Other design preferences, so tools called separately stay consistent with each other. Pass the same values to every tool.",
    "properties": {
     "animation_style": {
      "description": "Motion character (default minimal)",
      "enum": [
       "none",
       "minimal",
       "fluid",
       "energetic"
      ],
      "type": "string"
     },
     "color_scheme": {
      "description": "How the palette is derived (default analogous)",
      "enum": [
       "monochromatic",
       "analogous",
       "complementary",
       "triadic",
       "split-complementary"
      ],
      "type": "string"
     },
     "corners": {
      "description": "Corner radius character (default rounded)",
      "enum": [
       "sharp",
       "rounded",
       "pill"
      ],
      "type": "string"
     },
     "density": {
      "description": "Spacing density (default balanced)",
      "enum": [
       "compact",
       "balanced",
       "airy"
      ],
      "type": "string"
     },
     "shadow_intensity": {
      "description": "Shadow strength (default subtle)",
      "enum": [
       "flat",
       "subtle",
       "pronounced",
       "dramatic"
      ],
      "type": "string"
     },
     "type_style": {
      "description": "Typography character (default modern)",
      "enum": [
       "modern",
       "classical",
       "minimalist",
       "expressive"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "color"
  ],
  "type": "object"
 },
 "name": "bridge_generate_theme"
}
