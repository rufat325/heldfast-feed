{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "profile",
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the bounded Lots of Sounds CC0 catalog by keyword, tags, category, and duration. A connected account is required. The query is a case-insensitive substring match on the sound name and description, so use short keywords and narrow the search with tags or max_duration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "SFX",
     "MUSIC",
     "LOFI",
     "AMBIENT"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max 100, default 20",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "max_duration": {
    "description": "Maximum duration in seconds",
    "type": "number"
   },
   "min_duration": {
    "description": "Minimum duration in seconds",
    "type": "number"
   },
   "order": {
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Keyword matched against name + description, e.g. 'whoosh'. Use one or two short words, not a sentence.",
    "type": "string"
   },
   "sort": {
    "enum": [
     "downloads",
     "created_at",
     "duration",
     "name"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tags to match (AND logic)",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "search_sounds",
 "title": "Search sound effects"
}
