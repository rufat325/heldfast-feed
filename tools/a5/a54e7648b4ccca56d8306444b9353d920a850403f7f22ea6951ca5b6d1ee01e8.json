{
 "description": "Detect whether a webpage changed. Compare current content against a previous hash or previous text and return deterministic hashes and diffs. Costs $0.001 USDC on Base via x402.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ignore_selectors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "include_current_text": {
    "type": "boolean"
   },
   "max_diff_chars": {
    "maximum": 50000,
    "minimum": 1000,
    "type": "integer"
   },
   "max_text_chars": {
    "maximum": 250000,
    "minimum": 1000,
    "type": "integer"
   },
   "previous_hash": {
    "type": "string"
   },
   "previous_text": {
    "type": "string"
   },
   "selector": {
    "type": "string"
   },
   "timeout_seconds": {
    "maximum": 60,
    "minimum": 5,
    "type": "integer"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "detectWebpageChange"
}
