{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Retrieve related CSAM 2024 sections/content using its source-evidenced knowledge graph. Start with a procedure number, a chunk_id from sacs_search_csam, a returned node_id, or short heading/code/glossary keywords (exactly one selector). Defaults to explicit references in both directions. Choose relations contains/in_procedure for hierarchy, defines/mentions for code or glossary connections, within_range for numeric code membership, or next for source adjacency; depth 1\u20132. Every result explains its evidence path and returns at most one cited text/Markdown chunk; representative content is partial. Query node_id=csam:2024:manual with relations=[contains] to browse structure. Use include_content=false for topology-only pages. No database/model calls or paid entitlement required.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "chunk_id": {
    "anyOf": [
     {
      "pattern": "^csam:20\\d{2}:[a-f0-9]{24}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Chunk Id"
   },
   "client_id": {
    "anyOf": [
     {
      "pattern": "^sacs_client_[0-9a-f]{32}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Client Id"
   },
   "depth": {
    "default": 1,
    "maximum": 2,
    "minimum": 1,
    "title": "Depth",
    "type": "integer"
   },
   "direction": {
    "default": "both",
    "enum": [
     "both",
     "outgoing",
     "incoming"
    ],
    "title": "Direction",
    "type": "string"
   },
   "include_content": {
    "default": true,
    "title": "Include Content",
    "type": "boolean"
   },
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "node_id": {
    "anyOf": [
     {
      "pattern": "^csam:20\\d{2}:(?:manual|(?:section|procedure):\\d{3}|appendix:[A-Z]|(?:topic|term):[a-f0-9]{16}|code:(?:fund|resource|goal|function|object|project_year|school):\\d{1,4}(?:-\\d{1,4})?|[a-f0-9]{24})$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Node Id"
   },
   "node_kinds": {
    "default": [
     "manual",
     "section",
     "procedure",
     "appendix",
     "topic",
     "code",
     "term"
    ],
    "items": {
     "enum": [
      "manual",
      "section",
      "procedure",
      "appendix",
      "topic",
      "chunk",
      "code",
      "term"
     ],
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "title": "Node Kinds",
    "type": "array"
   },
   "offset": {
    "default": 0,
    "maximum": 10000,
    "minimum": 0,
    "title": "Offset",
    "type": "integer"
   },
   "procedure": {
    "anyOf": [
     {
      "pattern": "^\\d{3}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Procedure"
   },
   "query": {
    "default": "",
    "maxLength": 160,
    "title": "Query",
    "type": "string"
   },
   "relations": {
    "default": [
     "references"
    ],
    "items": {
     "enum": [
      "references",
      "contains",
      "in_procedure",
      "defines",
      "mentions",
      "within_range",
      "next"
     ],
     "type": "string"
    },
    "maxItems": 7,
    "minItems": 1,
    "title": "Relations",
    "type": "array"
   }
  },
  "title": "sacs_get_csam_relatedArguments",
  "type": "object"
 },
 "name": "sacs_get_csam_related",
 "outputSchema": {
  "$defs": {
   "PublicError": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "invalid_request",
       "not_found",
       "private_scope_denied",
       "dataset_mismatch",
       "payload_rejected",
       "backend_unavailable"
      ],
      "title": "Code",
      "type": "string"
     },
     "message": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Message",
      "type": "string"
     },
     "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "title": "PublicError",
    "type": "object"
   },
   "SourceProvenance": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Description",
      "type": "string"
     },
     "record_ref": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Record Ref",
      "type": "string"
     },
     "source": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Source",
      "type": "string"
     }
    },
    "required": [
     "source",
     "record_ref",
     "description"
    ],
    "title": "SourceProvenance",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "contract_version": {
    "const": "sacs.mcp.v1",
    "default": "sacs.mcp.v1",
    "title": "Contract Version",
    "type": "string"
   },
   "data": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Data"
   },
   "data_version": {
    "maxLength": 256,
    "minLength": 1,
    "title": "Data Version",
    "type": "string"
   },
   "error": {
    "anyOf": [
     {
      "$ref": "#/$defs/PublicError"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "title": "Limitations",
    "type": "array"
   },
   "ok": {
    "title": "Ok",
    "type": "boolean"
   },
   "request_id": {
    "maxLength": 128,
    "minLength": 8,
    "title": "Request Id",
    "type": "string"
   },
   "source_provenance": {
    "items": {
     "$ref": "#/$defs/SourceProvenance"
    },
    "title": "Source Provenance",
    "type": "array"
   }
  },
  "required": [
   "data_version",
   "request_id",
   "ok"
  ],
  "title": "PublicToolResponse",
  "type": "object"
 }
}
