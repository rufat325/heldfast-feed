{"annotations":{"openWorldHint":true,"readOnlyHint":true},"description":"List trailers, teasers and clips for a movie or TV show; YouTube entries include a watch URL. Get the id from search_movies/search_tv. Returns videos in the server's configured TMDB_LANGUAGE (default 'en-US') plus English, the title's original language (e.g. Spirited Away's Japanese trailer) and untagged ones; each entry's `language` (ISO-639-1) says which. No per-call language override.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"id":{"description":"TMDB numeric id.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"media_type":{"description":"Media type: 'movie' or 'tv'.","enum":["movie","tv"],"type":"string"}},"required":["media_type","id"],"type":"object"},"name":"get_videos","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"results":{"items":{"additionalProperties":false,"properties":{"language":{"description":"ISO-639-1 code of the video's language, e.g. 'en'.","type":["string","null"]},"name":{"type":"string"},"official":{"type":["boolean","null"]},"published_at":{"anyOf":[{"format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","type":"string"},{"type":"null"}],"default":null},"site":{"type":["string","null"]},"type":{"type":["string","null"]},"url":{"type":["string","null"]}},"required":["language","type","site","official","url","published_at"],"type":"object"},"type":"array"}},"required":["results"],"type":"object"},"title":"Get trailers & videos"}
