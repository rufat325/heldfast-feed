{
 "description": "Surgically updates a note in the DevSpeak Notes Workspace by applying replace operations.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "noteId": {
    "description": "The ID of the note to update",
    "type": "string"
   },
   "ops": {
    "description": "List of patch operations to apply",
    "items": {
     "properties": {
      "op": {
       "enum": [
        "replace-content",
        "replace-title",
        "replace-range"
       ],
       "type": "string"
      },
      "path": {
       "description": "JSON pointer path, usually empty or /content",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "range": {
       "properties": {
        "endLine": {
         "maximum": 100000,
         "minimum": 0,
         "type": "integer"
        },
        "startLine": {
         "maximum": 100000,
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "startLine",
        "endLine"
       ],
       "type": "object"
      },
      "value": {
       "description": "The new text value",
       "maxLength": 200000,
       "type": "string"
      }
     },
     "required": [
      "op",
      "path",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "noteId",
   "ops"
  ],
  "type": "object"
 },
 "name": "patch_translation_note"
}
