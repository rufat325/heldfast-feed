{
 "description": "Generate a complete property investment pitch \u2014 the kind of one-page analysis a property agent presents to a client. Combines price fairness vs transaction comps, stamp duty breakdown, MAS affordability check, rental yield projection, location intelligence (MRT, district, region), tenure/lease risk assessment, and a plain-English verdict with recommendation. This is the highest-value output for property agents and investors. (PAID \u2014 auto-pay if wallet configured)",
 "inputSchema": {
  "properties": {
   "buyer_notes": {
    "description": "Any specific concerns or goals",
    "type": "string"
   },
   "buyer_profile": {
    "default": "SC",
    "enum": [
     "SC",
     "SPR",
     "FR",
     "entity"
    ],
    "type": "string"
   },
   "existing_monthly_debt": {
    "default": 0,
    "type": "number"
   },
   "flat_type": {
    "description": "HDB flat type (e.g. '4 ROOM') or unit type",
    "type": "string"
   },
   "monthly_income": {
    "description": "Gross monthly income",
    "type": "number"
   },
   "monthly_rent": {
    "description": "Expected monthly rent (optional)",
    "type": "number"
   },
   "postal_code": {
    "description": "Postal code for location intelligence",
    "type": "string"
   },
   "project_name": {
    "description": "Condo/project name (for private property)",
    "type": "string"
   },
   "property_count": {
    "default": 1,
    "type": "integer"
   },
   "property_price": {
    "description": "Asking price in SGD",
    "type": "number"
   },
   "property_type": {
    "default": "hdb",
    "description": "hdb, private, condo, landed",
    "type": "string"
   },
   "sqft": {
    "description": "Floor area in square feet",
    "type": "number"
   },
   "tenure": {
    "description": "Freehold, 99-year, 999-year, etc.",
    "type": "string"
   },
   "top_year": {
    "description": "Year of Temporary Occupation Permit (TOP)",
    "type": "integer"
   },
   "town": {
    "description": "HDB town (e.g. 'TAMPINES') or area name",
    "type": "string"
   }
  },
  "required": [
   "property_price"
  ],
  "type": "object"
 },
 "name": "sg_property_pitch"
}
