{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Mistral multimodal chat (vision)"
 },
 "description": "Chat completion with multimodal input: text + image_url parts.\n\nRequires a vision-capable model. Accepted:\n  - pixtral-large-latest\n  - pixtral-12b-latest\n  - mistral-large-latest\n  - mistral-medium-latest\n  - mistral-small-latest\n\nEach message's `content` is either a plain string (pure text) or an array of\nparts `{ type: 'text', text }` / `{ type: 'image_url', imageUrl }`. The image URL\ncan be an https URL or a data: URI base64 payload.\n\nReturns the assistant text + token usage. For non-visual requests, prefer `mistral_chat`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "max_tokens": {
    "description": "Maximum number of tokens to generate. Input tokens plus this limit must fit within the model's context length.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "messages": {
    "description": "Chat messages. Pure-text requests are accepted, but this tool is intended primarily for multimodal prompts containing image parts.",
    "items": {
     "properties": {
      "content": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "anyOf": [
           {
            "properties": {
             "text": {
              "description": "Text to include in the message.",
              "type": "string"
             },
             "type": {
              "const": "text",
              "description": "Identifies a text content part.",
              "type": "string"
             }
            },
            "required": [
             "type",
             "text"
            ],
            "type": "object"
           },
           {
            "properties": {
             "imageUrl": {
              "anyOf": [
               {
                "description": "https URL or data:image/...;base64,... payload",
                "type": "string"
               },
               {
                "properties": {
                 "detail": {
                  "description": "Image detail hint: automatic, low, or high.",
                  "enum": [
                   "auto",
                   "low",
                   "high"
                  ],
                  "type": "string"
                 },
                 "url": {
                  "description": "HTTPS URL or data:image/...;base64,... payload.",
                  "type": "string"
                 }
                },
                "required": [
                 "url"
                ],
                "type": "object"
               }
              ],
              "description": "Image source as a URL or base64 data URI, optionally with a detail hint."
             },
             "type": {
              "const": "image_url",
              "description": "Identifies an image content part.",
              "type": "string"
             }
            },
            "required": [
             "type",
             "imageUrl"
            ],
            "type": "object"
           },
           {
            "properties": {
             "documentName": {
              "description": "Filename of the referenced document.",
              "type": "string"
             },
             "documentUrl": {
              "description": "URL of the PDF or document to include in the message.",
              "type": "string"
             },
             "type": {
              "const": "document_url",
              "description": "Identifies a document content part.",
              "type": "string"
             }
            },
            "required": [
             "type",
             "documentUrl"
            ],
            "type": "object"
           }
          ]
         },
         "minItems": 1,
         "type": "array"
        }
       ],
       "description": "Message text or an ordered list of text, image, and document content parts."
      },
      "role": {
       "description": "Message author: system for instructions, user for requests, or assistant for prior replies.",
       "enum": [
        "system",
        "user",
        "assistant"
       ],
       "type": "string"
      }
     },
     "required": [
      "role",
      "content"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "model": {
    "description": "Vision-capable Mistral model. Default: pixtral-large-latest.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "seed": {
    "description": "Random seed for deterministic sampling. Maps to Mistral's `random_seed`.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "temperature": {
    "description": "Sampling temperature: higher values make output more random; lower values make it more focused. Prefer adjusting this or top_p, not both.",
    "maximum": 2,
    "minimum": 0,
    "type": "number"
   },
   "top_p": {
    "description": "Nucleus sampling probability mass: 0.1 considers tokens in the top 10% of probability mass. Prefer adjusting this or temperature, not both.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "messages"
  ],
  "type": "object"
 },
 "name": "mistral_vision",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "finish_reason": {
    "type": "string"
   },
   "model": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "usage": {
    "additionalProperties": false,
    "properties": {
     "completionTokens": {
      "type": "number"
     },
     "promptTokens": {
      "type": "number"
     },
     "totalTokens": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "text",
   "model"
  ],
  "type": "object"
 },
 "title": "Mistral multimodal chat (vision)"
}
