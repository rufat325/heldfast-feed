{
 "description": "Network-level Quantum Readiness Scorecard: aggregate HNDL exposure (hndl_exposure) + config grade (quantum_grade) across a SAMPLE of accounts. HONEST SCOPE: a sample of recently-active accounts (or a caller-supplied list), NOT a ledger census \u2014 active accounts skew toward exposed, so figures are a sample, not a network %. Reports exposure-class breakdown, balance-at-risk, conclusive-vs-unknown, grade tiers, and top exposed. HEAVY (many RPC reads). Set --markdown for a public-facing report. Read-only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accounts": {
    "description": "explicit account list; omit to sample recently-active accounts",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "cap": {
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "markdown": {
    "type": "boolean"
   },
   "maxPages": {
    "maximum": 15,
    "minimum": 1,
    "type": "integer"
   },
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   },
   "sampleLedgers": {
    "maximum": 40,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "quantum_scorecard",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attempted": {
    "type": "number"
   },
   "balanceAtRiskDrops": {
    "type": "string"
   },
   "byExposureClass": {},
   "byGradeTier": {},
   "caveat": {
    "type": "string"
   },
   "conclusiveCount": {
    "type": "number"
   },
   "error": {
    "type": "string"
   },
   "exposedCount": {
    "type": "number"
   },
   "exposedPct": {
    "type": "number"
   },
   "markdown": {
    "type": "string"
   },
   "masterExposedBalanceDrops": {
    "type": "string"
   },
   "masterExposedCount": {
    "type": "number"
   },
   "masterExposedPct": {
    "type": "number"
   },
   "network": {
    "type": "string"
   },
   "originatorSample": {
    "type": "boolean"
   },
   "population": {
    "type": "string"
   },
   "provenQuantumHookCount": {
    "type": "number"
   },
   "rows": {},
   "sampled": {
    "type": "number"
   },
   "skipped": {
    "type": "number"
   },
   "topExposedByBalance": {},
   "totalBalanceDrops": {
    "type": "string"
   },
   "unknownCount": {
    "type": "number"
   }
  },
  "required": [
   "byExposureClass",
   "byGradeTier",
   "topExposedByBalance",
   "rows"
  ],
  "type": "object"
 }
}
