{
 "description": "Chilean net salary calculator: gross to net with AFP, health, cesant\u00eda and impuesto \u00fanico. Free MCP demo; for production volume use POST /cl/sueldo-liquido via x402 (https://toolrail.dev/skill.md).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "afp": {
    "type": "string"
   },
   "bruto": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "salud": {
    "anyOf": [
     {
      "const": "fonasa",
      "type": "string"
     },
     {
      "properties": {
       "plan_uf": {
        "exclusiveMinimum": 0,
        "type": "number"
       }
      },
      "required": [
       "plan_uf"
      ],
      "type": "object"
     }
    ]
   },
   "tipo_contrato": {
    "enum": [
     "indefinido",
     "plazo_fijo"
    ],
    "type": "string"
   }
  },
  "required": [
   "bruto"
  ],
  "type": "object"
 },
 "name": "cl_sueldo_liquido"
}
