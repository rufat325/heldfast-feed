{
 "annotations": {
  "readOnlyHint": true,
  "title": "List GitHub Actions jobs on Depot runners"
 },
 "description": "List GitHub Actions jobs that ran on Depot-managed runners, newest first: status, conclusion, runner label, requested CPU/memory, duration, billable time and GitHub URL. Defaults to the last 30 days (max window 90 days). Depot: GithubActionsService/ListGithubActionsJobs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "conclusions": {
    "description": "Job conclusions to include, e.g. [\"failure\"].",
    "items": {
     "enum": [
      "success",
      "failure",
      "cancelled",
      "skipped",
      "neutral"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "end_at": {
    "description": "Window end, RFC 3339 (e.g. 2026-09-18T00:00:00Z).",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "page_size": {
    "description": "Page size, 1-250.",
    "maximum": 250,
    "minimum": 1,
    "type": "integer"
   },
   "page_token": {
    "description": "Cursor from the previous response's nextPageToken. Omit for the first page.",
    "type": "string"
   },
   "query": {
    "description": "Case-insensitive text matched against job and workflow names; numeric values also match exact GitHub job/run ids.",
    "type": "string"
   },
   "repositories": {
    "description": "Connected repositories in owner/name format, e.g. [\"acme/widgets\"]. Empty = all.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "runner_labels": {
    "description": "Runner labels to include.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "start_at": {
    "description": "Window start, RFC 3339 (e.g. 2026-09-17T00:00:00Z).",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "statuses": {
    "description": "Job states to include.",
    "items": {
     "enum": [
      "queued",
      "waiting",
      "running",
      "finished"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "depot_gha_list_jobs",
 "title": "List GitHub Actions jobs on Depot runners"
}
