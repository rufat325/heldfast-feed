{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the account's chats, newest first.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ending_before": {
    "description": "Return the page before this id \u2014 the first id from the previous page.",
    "type": "string"
   },
   "limit": {
    "description": "Default 20.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Only chats whose title matches.",
    "type": "string"
   },
   "starting_after": {
    "description": "Return the page after this id \u2014 the last id from the previous page.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_chats",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A page of chats, newest first.",
  "properties": {
   "data": {
    "items": {
     "description": "A chat \u2014 one conversation with the agent, across however many runs it took.",
     "properties": {
      "context_type": {
       "enum": [
        "general",
        "ai_builder",
        "customer_support",
        "onboarding",
        null
       ],
       "type": [
        "string",
        "null"
       ]
      },
      "created_at": {
       "format": "date-time",
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "latest_run_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "object": {
       "const": "chat",
       "type": "string"
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "updated_at": {
       "format": "date-time",
       "type": "string"
      }
     },
     "required": [
      "object",
      "id",
      "created_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "has_more": {
    "type": "boolean"
   },
   "object": {
    "const": "list",
    "type": "string"
   }
  },
  "required": [
   "object",
   "data",
   "has_more"
  ],
  "type": "object"
 }
}
