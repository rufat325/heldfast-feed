{
 "description": "Shorten a URL with optional custom alias. Returns a short URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customAlias": {
    "description": "Custom short code alias (3-20 chars)",
    "maxLength": 20,
    "minLength": 3,
    "type": "string"
   },
   "url": {
    "description": "The URL to shorten",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "shorten_url"
}
