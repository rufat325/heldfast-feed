{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Colour name finder"
 },
 "description": "Find the named CSS colour that exactly or most closely matches a hex code, using straight-line distance in RGB space across the 148 named CSS colours. Source: https://hopi.co.uk/colour-name-finder/",
 "inputSchema": {
  "properties": {
   "hex": {
    "description": "Hex colour code, e.g. #DC143C or #F00",
    "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
    "type": "string"
   }
  },
  "required": [
   "hex"
  ],
  "type": "object"
 },
 "name": "hopi_colour_name_finder",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "distance": {
    "type": "number"
   },
   "exact": {
    "type": "boolean"
   },
   "input": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "names": {
    "type": "array"
   },
   "nearestHex": {
    "type": "string"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Colour name finder"
}
