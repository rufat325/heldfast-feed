{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Change project languages or context"
 },
 "description": "Use this when someone asks to change a project's default locale, replace its list of languages, or set its translation context. Returns which fields changed. The language list is replaced as a whole, no strings are translated or deleted, and the project name stays fixed. Not for adding a language with its translations.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "Translation context for the whole project, up to 600 characters; an empty string clears it",
    "maxLength": 600,
    "type": "string"
   },
   "defaultLocale": {
    "description": "New default locale code; it has to be one of the project's locales",
    "maxLength": 35,
    "minLength": 1,
    "type": "string"
   },
   "locales": {
    "description": "Complete replacement list of locale codes, including the default locale",
    "items": {
     "maxLength": 35,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   },
   "projectIdOrName": {
    "description": "Project id or name",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectIdOrName"
  ],
  "type": "object"
 },
 "name": "update_project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "changedFields": {
    "items": {
     "enum": [
      "defaultLocale",
      "locales",
      "context"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "project": {
    "anyOf": [
     {
      "maxLength": 128,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "no-input",
     "not-found",
     "no-change",
     "updated"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "project",
   "changedFields"
  ],
  "type": "object"
 },
 "title": "Change project languages or context"
}
