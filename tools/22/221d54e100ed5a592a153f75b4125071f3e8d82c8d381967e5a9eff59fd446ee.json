{
 "description": "Update an existing native template. Variables uses add/remove format for updates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Native template ID",
    "type": "number"
   },
   "name": {
    "description": "Template name",
    "type": "string"
   },
   "raw_html": {
    "description": "HTML template content with variable placeholders",
    "type": "string"
   },
   "variables": {
    "additionalProperties": false,
    "description": "Variables to add/remove",
    "properties": {
     "add": {
      "description": "Variables to add",
      "items": {
       "additionalProperties": false,
       "properties": {
        "dropdown_values": {
         "type": "string"
        },
        "max_length": {
         "type": "number"
        },
        "name": {
         "description": "Variable name",
         "type": "string"
        },
        "optional": {
         "type": "boolean"
        },
        "placeholder": {
         "description": "Placeholder in raw_html",
         "type": "string"
        },
        "type": {
         "description": "Variable type",
         "enum": [
          "url",
          "url_raw",
          "text",
          "file",
          "number",
          "image_url",
          "dropdown",
          "third_party_script"
         ],
         "type": "string"
        }
       },
       "required": [
        "name",
        "placeholder",
        "type"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "remove": {
      "description": "Variable IDs to remove",
      "items": {
       "type": "number"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_native_template"
}
