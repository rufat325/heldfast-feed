{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use eight explicit user-selected answers to suggest a 12-color starting palette and adjacent option. Uncertain or conflicting preferences prompt clarification. The versioned result is unconfirmed guidance, not a diagnosis. It never overwrites a confirmed palette.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "complimented_colors": {
    "description": "Which colors have drawn compliments on you?",
    "enum": [
     "bright",
     "muted",
     "warm_rich",
     "cool_soft",
     "deep",
     "light"
    ],
    "type": "string"
   },
   "contrast": {
    "description": "What is your overall feature contrast?",
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "eye_color": {
    "description": "What is your eye color?",
    "enum": [
     "bright",
     "warm",
     "soft",
     "deep"
    ],
    "type": "string"
   },
   "metal_preference": {
    "description": "Which metal look do you prefer near your face?",
    "enum": [
     "silver",
     "gold",
     "both",
     "rose"
    ],
    "type": "string"
   },
   "natural_hair": {
    "description": "What is your natural hair color?",
    "enum": [
     "warm_light",
     "cool_light",
     "warm_dark",
     "cool_dark"
    ],
    "type": "string"
   },
   "skin_depth": {
    "description": "How would you describe your skin depth?",
    "enum": [
     "fair",
     "medium",
     "deep"
    ],
    "type": "string"
   },
   "undertone": {
    "description": "Which colors do you prefer near your face?",
    "enum": [
     "cool",
     "warm",
     "neutral",
     "unsure"
    ],
    "type": "string"
   },
   "white_preference": {
    "description": "Which white do you prefer wearing?",
    "enum": [
     "cool_white",
     "unsure",
     "cream"
    ],
    "type": "string"
   }
  },
  "required": [
   "undertone",
   "skin_depth",
   "natural_hair",
   "eye_color",
   "contrast",
   "metal_preference",
   "white_preference",
   "complimented_colors"
  ],
  "type": "object"
 },
 "name": "score_color_quiz",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "const": "score_color_quiz",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "adjacent_season": {
      "type": "string"
     },
     "adjacent_season_id": {
      "enum": [
       "bright_spring",
       "warm_spring",
       "light_spring",
       "light_summer",
       "cool_summer",
       "soft_summer",
       "soft_autumn",
       "warm_autumn",
       "deep_autumn",
       "deep_winter",
       "cool_winter",
       "bright_winter"
      ],
      "type": "string"
     },
     "clarification": {
      "type": [
       "string",
       "null"
      ]
     },
     "confidence": {
      "type": "string"
     },
     "palette": {
      "additionalProperties": false,
      "properties": {
       "caveat": {
        "maxLength": 600,
        "type": "string"
       },
       "colors": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "hex": {
           "pattern": "^#[0-9A-F]{6}$",
           "type": "string"
          },
          "label": {
           "type": "string"
          }
         },
         "required": [
          "label",
          "hex"
         ],
         "type": "object"
        },
        "maxItems": 12,
        "minItems": 12,
        "type": "array"
       },
       "confirmed": {
        "type": "boolean"
       },
       "guidance": {
        "maxLength": 600,
        "type": "string"
       },
       "palette_ref": {
        "maxLength": 1400,
        "minLength": 16,
        "type": "string"
       },
       "quiz_version": {
        "anyOf": [
         {
          "const": "tonebook.quiz.2026-09-23",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "revision": {
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
       },
       "season": {
        "type": "string"
       },
       "season_id": {
        "enum": [
         "bright_spring",
         "warm_spring",
         "light_spring",
         "light_summer",
         "cool_summer",
         "soft_summer",
         "soft_autumn",
         "warm_autumn",
         "deep_autumn",
         "deep_winter",
         "cool_winter",
         "bright_winter"
        ],
        "type": "string"
       },
       "source": {
        "enum": [
         "quiz_suggestion",
         "user_selection"
        ],
        "type": "string"
       },
       "storage": {
        "maxLength": 600,
        "type": "string"
       },
       "suggested_season_id": {
        "anyOf": [
         {
          "enum": [
           "bright_spring",
           "warm_spring",
           "light_spring",
           "light_summer",
           "cool_summer",
           "soft_summer",
           "soft_autumn",
           "warm_autumn",
           "deep_autumn",
           "deep_winter",
           "cool_winter",
           "bright_winter"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "version": {
        "const": "tonebook.palette.v1",
        "type": "string"
       }
      },
      "required": [
       "version",
       "season_id",
       "source",
       "confirmed",
       "quiz_version",
       "suggested_season_id",
       "revision",
       "palette_ref",
       "season",
       "colors",
       "guidance",
       "caveat",
       "storage"
      ],
      "type": "object"
     },
     "starter_swatches": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "hex": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "hex"
       ],
       "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
     },
     "state": {
      "enum": [
       "suggestion",
       "clarification_needed"
      ],
      "type": "string"
     }
    },
    "required": [
     "state",
     "palette",
     "adjacent_season_id",
     "adjacent_season",
     "clarification",
     "starter_swatches",
     "confidence"
    ],
    "type": "object"
   },
   "schema_version": {
    "const": "tonebook.connector.v1",
    "type": "string"
   }
  },
  "required": [
   "schema_version",
   "kind",
   "result"
  ],
  "type": "object"
 },
 "title": "Score a palette self-assessment"
}
