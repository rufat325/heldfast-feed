{
 "_meta": {
  "fastmcp": {
   "tags": [
    "map"
   ]
  }
 },
 "description": "Use when you need a geographic snapshot of where prediction-market attention is concentrated. Returns per-country heat (capped news score, summed) for the current moment (`at=now`) or a past hour (`at=<ISO8601>`).",
 "inputSchema": {
  "properties": {
   "at": {
    "default": "now",
    "description": "'now' (live cache) or an ISO-8601 timestamp for a past hourly frame.",
    "title": "At",
    "type": "string"
   },
   "source": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Restrict to one source (only honored when at=now): polymarket, kalshi, manifold, myriad, limitless, predict, opinion, gemini.",
    "title": "Source"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "map_heat",
 "outputSchema": {
  "properties": {
   "_meta": {
    "description": "Agent metadata for list/aggregate responses (no cite_as).",
    "properties": {
     "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
     },
     "attribution": {
      "default": "pdata.world \u2014 aggregated prediction-market data across 8 platforms",
      "title": "Attribution",
      "type": "string"
     },
     "canonical_url": {
      "title": "Canonical Url",
      "type": "string"
     },
     "docs": {
      "default": "https://api.pdata.world/docs",
      "title": "Docs",
      "type": "string"
     }
    },
    "required": [
     "canonical_url"
    ],
    "title": "ResponseMetaList",
    "type": "object"
   },
   "as_of": {
    "format": "date-time",
    "title": "As Of",
    "type": "string"
   },
   "at": {
    "description": "'now' or the resolved snapshot ISO timestamp.",
    "title": "At",
    "type": "string"
   },
   "frame": {
    "items": {
     "properties": {
      "country": {
       "title": "Country",
       "type": "string"
      },
      "heat_abs": {
       "description": "Sum of capped per-market news scores for this country.",
       "title": "Heat Abs",
       "type": "number"
      },
      "intensity": {
       "description": "heat_abs / rolling-30d reference, clamped to [0,1].",
       "title": "Intensity",
       "type": "number"
      },
      "top_markets": {
       "items": {
        "properties": {
         "delta_pp": {
          "title": "Delta Pp",
          "type": "number"
         },
         "event_id": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "title": "Event Id"
         },
         "market_id": {
          "title": "Market Id",
          "type": "string"
         },
         "more": {
          "default": 0,
          "description": "Count of other moved markets in the same event (collapsed into this row).",
          "title": "More",
          "type": "integer"
         },
         "prob": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ],
          "description": "Current implied probability (0-1); None if unknown.",
          "title": "Prob"
         },
         "source": {
          "title": "Source",
          "type": "string"
         },
         "title": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "title": "Title"
         },
         "url": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "External source-platform URL for this market; None if unknown.",
          "title": "Url"
         },
         "vol": {
          "description": "Market 24h notional volume (USD).",
          "title": "Vol",
          "type": "number"
         }
        },
        "required": [
         "source",
         "market_id",
         "delta_pp",
         "vol"
        ],
        "title": "MapTopMarket",
        "type": "object"
       },
       "title": "Top Markets",
       "type": "array"
      },
      "total_markets": {
       "default": 0,
       "description": "Geo-tagged, non-excluded markets active in the trailing 24h.",
       "title": "Total Markets",
       "type": "integer"
      },
      "total_volume": {
       "default": 0.0,
       "description": "Sum of lifetime market volume (USD).",
       "title": "Total Volume",
       "type": "number"
      },
      "volume_24hr": {
       "default": 0.0,
       "description": "Sum of 24h market volume (USD).",
       "title": "Volume 24Hr",
       "type": "number"
      }
     },
     "required": [
      "country",
      "heat_abs",
      "intensity",
      "top_markets"
     ],
     "title": "MapHeatCountry",
     "type": "object"
    },
    "title": "Frame",
    "type": "array"
   },
   "reference": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Display yardstick (p95 per-country heat, 30d).",
    "title": "Reference"
   },
   "source": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "title": "Source"
   },
   "total_heat": {
    "title": "Total Heat",
    "type": "number"
   },
   "total_heat_avg_30d": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "title": "Total Heat Avg 30D"
   }
  },
  "required": [
   "as_of",
   "at",
   "total_heat",
   "frame",
   "_meta"
  ],
  "title": "MapHeatOut",
  "type": "object",
  "x-fastmcp-top-level-schema": "MapHeatOut"
 }
}
