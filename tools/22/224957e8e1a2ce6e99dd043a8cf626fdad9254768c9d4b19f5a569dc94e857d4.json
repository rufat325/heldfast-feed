{
 "annotations": {
  "readOnlyHint": true,
  "title": "List available times"
 },
 "description": "List bookable appointment slots for a business + practitioner + appointment type within a date range (from/to, yyyy-mm-dd, span <= 7 days). High-value booking-slot lookup. GET /businesses/{business_id}/practitioners/{practitioner_id}/appointment_types/{appointment_type_id}/available_times.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "appointment_type_id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Appointment type id (path)."
   },
   "business_id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Business id (path)."
   },
   "from": {
    "description": "Range start yyyy-mm-dd (cannot be more than 7 days before `to`).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "practitioner_id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Practitioner id (path)."
   },
   "to": {
    "description": "Range end yyyy-mm-dd (cannot be more than 7 days after `from`).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "business_id",
   "practitioner_id",
   "appointment_type_id",
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "cliniko_list_available_times",
 "title": "List available times"
}
