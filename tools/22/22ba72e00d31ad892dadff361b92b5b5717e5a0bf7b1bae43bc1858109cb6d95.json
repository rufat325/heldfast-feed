 "description": "Compares 2 to 4 jobs side by side using the same FoundRole analysis fields: resume match, missing skills,\nH-1B and E-Verify signals, ghost-job risk, posted pay, and market salary estimates.\n\n`comparison_refs` accepts exact FoundRole job IDs returned by jobs_search and exact external\n`comparisonRef` URLs returned by jobs_analyze_external. Analyze each outside job first; a bare URL that\nhas not been analyzed cannot be compared because FoundRole does not have its posting facts. Preserve\nevery reference exactly, keep the user's requested order, and do not send duplicates.\n",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "comparison_refs": {
    "description": "Two to four exact FoundRole job IDs or external comparisonRef URLs",
    "items": {
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "comparison_refs"
  ],
  "type": "object"
 },
