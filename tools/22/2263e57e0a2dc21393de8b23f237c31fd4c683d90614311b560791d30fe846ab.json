{
 "description": "Update your subscription settings for a group",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "auto_follow_replies": {
    "description": "Auto-follow topics you post to",
    "type": "boolean"
   },
   "email_delivery": {
    "description": "Email delivery preference",
    "enum": [
     "email_delivery_single",
     "email_delivery_digest",
     "email_delivery_special",
     "email_delivery_none",
     "email_delivery_html_digest",
     "email_delivery_summary"
    ],
    "type": "string"
   },
   "group_id": {
    "description": "ID of the group",
    "type": "number"
   },
   "max_attachment_size": {
    "description": "Max attachment size",
    "enum": [
     "max_attachment_size_unlimited",
     "max_attachment_size_small",
     "max_attachment_size_medium",
     "max_attachment_size_large",
     "max_attachment_size_none"
    ],
    "type": "string"
   },
   "message_selection": {
    "description": "Which messages to receive",
    "enum": [
     "message_selection_all",
     "message_selection_follow_only",
     "message_selection_follow_and_first_message"
    ],
    "type": "string"
   }
  },
  "required": [
   "group_id"
  ],
  "type": "object"
 },
 "name": "update_subscription"
}
