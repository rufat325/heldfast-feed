{
 "_meta": {
  "openai/outputTemplate": "ui://alerts",
  "ui": {
   "resourceUri": "ui://alerts"
  },
  "ui/resourceUri": "ui://alerts"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a seat alert that notifies you by email when a matching seat becomes available on a specific flight. Supports preferences like window, aisle, exit row, specific seat, adjacent seats, and class availability. Requires authentication. The flight must already be in our database \u2014 use search_flight first if not.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "adjacent_seats_count": {
    "description": "Required when seat_preference is 'adjacent_seats' or 'minimum_seats' (2-9)",
    "maximum": 9,
    "minimum": 2,
    "type": "integer"
   },
   "cabin_class": {
    "description": "Cabin class to monitor",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "flight_date": {
    "description": "Flight date in YYYY-MM-DD format. Must be today or within the next 60 days.",
    "type": "string"
   },
   "flight_number": {
    "description": "Flight number, e.g. 'QF1', 'AA716'",
    "type": "string"
   },
   "seat_preference": {
    "description": "Seat preference to alert on",
    "enum": [
     "window",
     "aisle",
     "bulkhead",
     "exit_row",
     "extra_legroom",
     "quiet_zone",
     "front_of_cabin",
     "rear_of_cabin",
     "specific",
     "adjacent_seats",
     "minimum_seats",
     "class_availability",
     "better_seat_upgrade"
    ],
    "type": "string"
   },
   "specific_seat": {
    "description": "Required when seat_preference is 'specific' (e.g. '12A')",
    "type": "string"
   }
  },
  "required": [
   "flight_number",
   "flight_date",
   "cabin_class",
   "seat_preference"
  ],
  "type": "object"
 },
 "name": "create_seat_alert",
 "title": "Create seat alert"
}
