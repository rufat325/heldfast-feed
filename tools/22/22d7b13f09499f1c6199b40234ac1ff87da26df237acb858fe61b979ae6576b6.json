{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a job"
 },
 "description": "Create a job for an existing customer at one of their existing addresses, optionally scheduled, assigned, tagged and with line items (prices in cents). Get address ids from housecall_get_customer. Housecall Pro: POST /jobs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address_id": {
    "description": "The customer address id.",
    "minLength": 1,
    "type": "string"
   },
   "assigned_employee_ids": {
    "description": "Employees to assign.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "business_unit_id": {
    "type": "string"
   },
   "customer_id": {
    "description": "The customer id.",
    "minLength": 1,
    "type": "string"
   },
   "invoice_number": {
    "description": "Must be unique across the company's jobs; auto-assigned if omitted.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "job_type_id": {
    "description": "From housecall_list_job_types.",
    "type": "string"
   },
   "lead_source": {
    "type": "string"
   },
   "line_items": {
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "name": {
       "description": "Line item name.",
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "description": "Quantity; up to two decimal places.",
       "type": "number"
      },
      "unit_cost": {
       "description": "Direct cost of one unit to the company, in CENTS (job costing).",
       "type": "number"
      },
      "unit_price": {
       "description": "Selling price of one unit, in CENTS.",
       "type": "number"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "type": "string"
   },
   "schedule": {
    "properties": {
     "anytime": {
      "description": "Schedule for any time during the day.",
      "type": "boolean"
     },
     "anytime_start_date": {
      "description": "YYYY-MM-DD; required when anytime is true.",
      "type": "string"
     },
     "arrival_window": {
      "description": "Arrival window in minutes.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "scheduled_end": {
      "description": "ISO-8601 end.",
      "type": "string"
     },
     "scheduled_start": {
      "description": "ISO-8601 start, e.g. 2026-03-23T15:30:00.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "tags": {
    "description": "Tag names.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "customer_id",
   "address_id"
  ],
  "type": "object"
 },
 "name": "housecall_create_job",
 "title": "Create a job"
}
