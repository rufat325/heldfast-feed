{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Load the agent identity, permissions, skills, and context into this project.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "agentId": {
    "description": "Agent identifier from the identity record.",
    "type": "string"
   },
   "agentWallet": {
    "description": "Agent account (required when agentId omitted).",
    "type": "string"
   },
   "controllerWallet": {
    "description": "Owner account. Defaults to the signed-in profile.",
    "type": "string"
   },
   "identityQHash": {
    "description": "Identity proof ID (qHash).",
    "type": "string"
   },
   "requiredResources": {
    "description": "Optional provider/resource ids that must be present in the resolved mount.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "proofable_agent_mount",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "agent": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "mount": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "status": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     }
    ]
   },
   "success": {
    "type": "boolean"
   }
  },
  "type": "object"
 }
}
