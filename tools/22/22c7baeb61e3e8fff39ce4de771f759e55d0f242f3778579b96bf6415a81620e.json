{"_meta":{"securitySchemes":[{"scopes":["doctofam:read"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Check clinic stock"},"description":"Use this when someone asks how much of a supply is left in the clinic's stock or what is running low. Returns up to 100 stock items with unit, quantity, minimum and a low-stock flag. Not for procedure prices.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"clinicId":{"description":"Id of the clinic, from list_clinics. Leave it out when the user has one clinic.","maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"limit":{"description":"Maximum number of items (default 50, maximum 100).","maximum":100,"minimum":1,"type":"integer"},"lowStockOnly":{"description":"Only items at or below their minimum quantity.","type":"boolean"},"search":{"description":"Only items whose name contains these words.","maxLength":100,"minLength":1,"type":"string"}},"type":"object"},"name":"list_inventory_items","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"clinicId":{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"count":{"maximum":100000,"minimum":0,"type":"integer"},"hasMore":{"type":"boolean"},"items":{"items":{"additionalProperties":false,"properties":{"clinicId":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"id":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"lastEditTime":{"anyOf":[{"maxLength":40,"type":"string"},{"type":"null"}]},"lowStock":{"type":"boolean"},"minimumQuantity":{"anyOf":[{"maximum":1000000000,"minimum":0,"type":"number"},{"type":"null"}]},"name":{"maxLength":200,"type":"string"},"quantity":{"anyOf":[{"maximum":1000000000,"minimum":0,"type":"number"},{"type":"nu