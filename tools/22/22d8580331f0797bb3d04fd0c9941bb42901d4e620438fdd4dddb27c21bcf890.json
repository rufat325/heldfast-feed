{
 "description": "Calculate board feet and lumber cost (thickness x width x length / 144 in inches). Accepts multiple boards and an optional price quoted per board foot or per MBF (thousand board feet).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "boards": {
    "description": "Boards (dimensions in the chosen unit)",
    "items": {
     "properties": {
      "label": {
       "type": "string"
      },
      "length": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "qty": {
       "default": 1,
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "thickness": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "width": {
       "exclusiveMinimum": 0,
       "type": "number"
      }
     },
     "required": [
      "thickness",
      "width",
      "length"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "price": {
    "description": "Optional price per price_unit",
    "minimum": 0,
    "type": "number"
   },
   "price_unit": {
    "default": "bf",
    "description": "Unit the price is quoted in: single board foot or MBF (1,000 bf)",
    "enum": [
     "bf",
     "mbf"
    ],
    "type": "string"
   },
   "unit": {
    "default": "in",
    "description": "Unit for board dimensions",
    "enum": [
     "in",
     "ft",
     "mm",
     "cm",
     "m"
    ],
    "type": "string"
   }
  },
  "required": [
   "boards"
  ],
  "type": "object"
 },
 "name": "board_feet_calculator"
}
