{
 "description": "Look up a coin record by its coin name (the 32-byte sha256 of parent_coin_info || puzzle_hash || amount).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "pattern": "^(0x)?[0-9a-fA-F]{64}$",
    "type": "string"
   },
   "network": {
    "default": "mainnet",
    "description": "Chia network: 'mainnet' (default) or 'testnet11'",
    "enum": [
     "mainnet",
     "testnet11"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_coin_by_name"
}
