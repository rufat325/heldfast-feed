{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "project_todos:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Request-bound sequential apply of the EXACT planned FULL-retake rows (action require_retake_apply on registry op project_todos.quizzes.manage). Requires the planChecksum from opentrain_quiz_retake_plan plus a stable idempotencyKey; live drift fails closed as 409 PLAN_STALE; per-row results are truthful and sequential. Requires project_todos:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirmLive": {
    "const": true,
    "type": "boolean"
   },
   "idempotencyKey": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "planChecksum": {
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "assignmentId": {
       "minLength": 1,
       "type": "string"
      },
      "attemptId": {
       "anyOf": [
        {
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "expectedSubmittedAt": {
       "format": "date-time",
       "type": "string"
      },
      "grade": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "grades": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "awardedPoints": {
              "maximum": 10000,
              "minimum": 0,
              "type": "integer"
             },
             "questionId": {
              "minLength": 1,
              "type": "string"
             }
            },
            "required": [
             "questionId",
             "awardedPoints"
            ],
            "type": "object"
           },
           "maxItems": 500,
           "type": "array"
          },
          "note": {
           "anyOf": [
            {
             "maxLength": 5000,
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "grades"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "reason": {
       "maxLength": 2000,
       "minLength": 1,
       "type": "string"
      },
      "release": {
       "type": "boolean"
      },
      "rowKey": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "rowKey",
      "assignmentId",
      "reason",
      "expectedSubmittedAt"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "jobId",
   "rows",
   "planChecksum",
   "confirmLive",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_retake_apply",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "const": "require_retake_apply",
      "type": "string"
     },
     "appliedRows": {
      "type": "integer"
     },
     "failedRows": {
      "type": "integer"
     },
     "jobId": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "ok": {
      "type": "boolean"
     },
     "replayed": {
      "type": "boolean"
     },
     "rows": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "commands": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "action": {
            "enum": [
             "grade",
             "release",
             "require_retake"
            ],
            "type": "string"
           },
           "error": {
            "type": [
             "string",
             "null"
            ]
           },
           "idempotencyKey": {
            "type": "string"
           },
           "ok": {
            "type": "boolean"
           }
          },
          "required": [
           "action",
           "idempotencyKey",
           "ok",
           "error"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "error": {
         "type": [
          "string",
          "null"
         ]
        },
        "ok": {
         "type": "boolean"
        },
        "rowKey": {
         "type": "string"
        }
       },
       "required": [
        "rowKey",
        "ok",
        "error",
        "commands"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "action",
     "jobId",
     "ok",
     "appliedRows",
     "failedRows",
     "rows",
     "note",
     "replayed"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
