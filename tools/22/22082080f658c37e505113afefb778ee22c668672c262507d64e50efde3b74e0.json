{
 "description": "Record a cost transaction for an AI agent. Track LLM calls, embeddings, tool usage, API calls, storage, and compute costs. Essential for budget governance and spend tracking.",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "Unique identifier for the agent",
    "type": "string"
   },
   "input_tokens": {
    "description": "Number of input tokens",
    "type": "number"
   },
   "metadata": {
    "description": "Additional metadata about the transaction",
    "type": "object"
   },
   "model": {
    "description": "Model name (e.g., 'gpt-4', 'claude-3-opus')",
    "type": "string"
   },
   "output_tokens": {
    "description": "Number of output tokens",
    "type": "number"
   },
   "provider": {
    "description": "Provider name (e.g., 'openai', 'anthropic', 'aws')",
    "type": "string"
   },
   "session_id": {
    "description": "Optional session ID for grouping transactions",
    "type": "string"
   },
   "total_cost": {
    "description": "Total cost of the transaction in USD",
    "type": "number"
   },
   "transaction_type": {
    "description": "Type of cost transaction",
    "enum": [
     "llm_call",
     "embedding",
     "tool_call",
     "api_call",
     "storage",
     "compute",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "agent_id",
   "transaction_type",
   "total_cost"
  ],
  "type": "object"
 },
 "name": "tork_cost_record"
}
