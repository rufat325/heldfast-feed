{
 "description": "Code or steps to load an asset in three.js, React Three Fiber, <model-viewer>, Blender, Godot or Unity.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "framework": {
    "default": "threejs",
    "enum": [
     "threejs",
     "r3f",
     "model-viewer",
     "blender",
     "godot",
     "unity"
    ],
    "type": "string"
   },
   "slug": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_asset_usage",
 "title": "Get usage snippet"
}
