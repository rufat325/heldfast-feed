{
 "_meta": {
  "openai/toolInvocation/invoked": "Found similar neighborhoods",
  "openai/toolInvocation/invoking": "Finding similar neighborhoods\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find similar neighborhoods"
 },
 "description": "Find neighborhoods most similar to a given one based on a 9-dimension score vector (family density, wealth, education, safety, transit, etc.). Returns similarity scores.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 5,
    "description": "Number of comparable neighborhoods",
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "nta_code": {
    "description": "NTA code to find similar neighborhoods for",
    "maxLength": 6,
    "type": "string"
   }
  },
  "required": [
   "nta_code"
  ],
  "type": "object"
 },
 "name": "get-comparable",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "comparables": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "nta_code": {
       "type": "string"
      },
      "nta_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "similarity": {
       "type": "number"
      }
     },
     "required": [
      "nta_code",
      "nta_name",
      "similarity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "borough": {
      "type": [
       "number",
       "null"
      ]
     },
     "borough_name": {
      "type": [
       "string",
       "null"
      ]
     },
     "methodology_url": {
      "type": [
       "string",
       "null"
      ]
     },
     "nta_code": {
      "type": "string"
     },
     "nta_name": {
      "type": "string"
     },
     "scores_as_of": {
      "type": [
       "string",
       "null"
      ]
     },
     "scores_version": {
      "type": [
       "string",
       "null"
      ]
     },
     "viability_score": {
      "type": "number"
     }
    },
    "required": [
     "nta_code",
     "nta_name",
     "borough",
     "borough_name",
     "viability_score",
     "scores_as_of",
     "scores_version",
     "methodology_url"
    ],
    "type": "object"
   }
  },
  "required": [
   "source",
   "comparables"
  ],
  "type": "object"
 }
}
