{
 "annotations": {
  "readOnlyHint": true,
  "title": "Skin temperature"
 },
 "description": "Skin temperature (relative to baseline) for a date or range. Fitbit REST: GET /1/user/-/temp/skin/date/{date}[/{endDate}].json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date": {
    "description": "Date, yyyy-MM-dd or 'today' (required).",
    "pattern": "^(\\d{4}-\\d{2}-\\d{2}|today)$",
    "type": "string"
   },
   "endDate": {
    "description": "Range end date, yyyy-MM-dd or 'today' (optional).",
    "pattern": "^(\\d{4}-\\d{2}-\\d{2}|today)$",
    "type": "string"
   }
  },
  "required": [
   "date"
  ],
  "type": "object"
 },
 "name": "fitbit_skin_temperature",
 "title": "Skin temperature"
}
