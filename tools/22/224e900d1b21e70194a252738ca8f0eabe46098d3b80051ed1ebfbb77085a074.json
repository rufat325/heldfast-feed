{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Write a greeting"
 },
 "description": "Generate a short, coherent, family-friendly greeting for an occasion. Returns complete phrases from curated language collections. Optional first name stays transient. Does not send or publish anything.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "locale": {
    "default": "en",
    "description": "Language code; hi is Hindi. Use list_greeting_options for supported languages.",
    "enum": [
     "it",
     "en",
     "fr",
     "es",
     "de",
     "pt",
     "ar",
     "zh",
     "ja",
     "ko",
     "th",
     "ru",
     "hi"
    ],
    "type": "string"
   },
   "name": {
    "default": "",
    "description": "Optional first name, up to 30 characters. Omit sensitive or identifying details. Never stored with a shared design.",
    "maxLength": 100,
    "type": "string"
   },
   "occasion": {
    "default": "morning",
    "enum": [
     "morning",
     "afternoon",
     "evening",
     "night",
     "birthday",
     "congratulations",
     "christmas",
     "newyear",
     "lunarnewyear",
     "mothersday",
     "fathersday",
     "weddinganniversary",
     "anniversary",
     "ramadan",
     "eid",
     "thankyou",
     "getwell",
     "wedding",
     "newbaby",
     "graduation"
    ],
    "type": "string"
   },
   "previousCodes": {
    "default": [],
    "description": "Recent phrase codes from this conversation to avoid repeats; do not send chat history.",
    "items": {
     "maxLength": 100,
     "pattern": "^[a-z]+:[a-z]+:\\d+:\\d+:\\d+$",
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "generate_greeting",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "maxLength": 100,
    "pattern": "^(?:it|en|fr|es|de|pt|ar|zh|ja|ko|th|ru|hi):(?:morning|afternoon|evening|night|birthday|congratulations|christmas|newyear|lunarnewyear|mothersday|fathersday|weddinganniversary|anniversary|ramadan|eid|thankyou|getwell|wedding|newbaby|graduation):\\d+:\\d+:\\d+$",
    "type": "string"
   },
   "locale": {
    "enum": [
     "it",
     "en",
     "fr",
     "es",
     "de",
     "pt",
     "ar",
     "zh",
     "ja",
     "ko",
     "th",
     "ru",
     "hi"
    ],
    "type": "string"
   },
   "occasion": {
    "enum": [
     "morning",
     "afternoon",
     "evening",
     "night",
     "birthday",
     "congratulations",
     "christmas",
     "newyear",
     "lunarnewyear",
     "mothersday",
     "fathersday",
     "weddinganniversary",
     "anniversary",
     "ramadan",
     "eid",
     "thankyou",
     "getwell",
     "wedding",
     "newbaby",
     "graduation"
    ],
    "type": "string"
   },
   "text": {
    "maxLength": 6000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "text",
   "code",
   "locale",
   "occasion"
  ],
  "type": "object"
 },
 "title": "Write a greeting"
}
