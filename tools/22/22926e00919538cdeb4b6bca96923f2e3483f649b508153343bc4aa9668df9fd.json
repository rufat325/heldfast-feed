{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create infrastructure asset inspection"
 },
 "description": "Record an inspection against an infrastructure feature. Requires infrastructure_asset_inspections:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attachments": {
    "description": "Attachment URLs/paths",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "condition_score": {
    "description": "Condition score (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "defects": {
    "additionalProperties": {},
    "description": "Defect observations (JSON)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "feature_id": {
    "description": "Infrastructure asset (feature) ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "inspection_date": {
    "description": "Inspection date (YYYY-MM-DD, required)",
    "type": "string"
   },
   "inspector_id": {
    "description": "Inspector user ID",
    "type": "string"
   },
   "method": {
    "description": "Inspection method (e.g. CCTV, visual)",
    "maxLength": 100,
    "type": "string"
   },
   "notes": {
    "description": "Free-form notes",
    "type": "string"
   }
  },
  "required": [
   "feature_id",
   "inspection_date"
  ],
  "type": "object"
 },
 "name": "create_infrastructure_asset_inspection",
 "title": "Create infrastructure asset inspection"
}
