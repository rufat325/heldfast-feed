      "type": "number"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "itemId",
     "fileName",
     "mimeType",
     "size",
     "checksum",
     "updatedAt",
     "resourceUri",
     "downloadUrl"
