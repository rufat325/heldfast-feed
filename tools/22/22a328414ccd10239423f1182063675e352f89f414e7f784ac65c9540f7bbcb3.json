{
 "_meta": {
  "openai/toolInvocation/invoked": "Found investor firms",
  "openai/toolInvocation/invoking": "Finding investor firms and key people, about 10 seconds",
  "securitySchemes": [
   {
    "scopes": [
     "properties:read",
     "credits:spend"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Run an investor firm search"
 },
 "description": "Spends credits. Runs a quote from quote_investor_firm_search and returns the firms with business phones, business emails, website and key people (name and title only). Charges per firm returned, never more than the quote. No firms found costs nothing. Call only after the user agreed to the quoted cost. A quote runs once and expires after 10 minutes.",
 "inputSchema": {
  "properties": {
   "quote_id": {
    "description": "The quoteId from quote_investor_firm_search.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "quote_id"
  ],
  "type": "object"
 },
 "name": "run_investor_firm_search",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "alreadyOwned": {
    "type": "boolean"
   },
   "balance": {
    "type": "number"
   },
   "creditsCharged": {
    "type": "number"
   },
   "firms": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "emails": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "investorType": {
       "enum": [
        "hard_money_lender",
        "private_lender",
        "note_buyer",
        "fix_and_flip",
        "real_estate_fund",
        "cash_home_buyer",
        "wholesaler"
       ],
       "type": "string"
      },
      "keyPeople": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "type": "string"
         },
         "title": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "name",
         "title"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "locationCount": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "phones": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "website": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "website",
      "phones",
      "emails",
      "investorType",
      "locationCount",
      "keyPeople"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "quoteId": {
    "type": "string"
   }
  },
  "required": [
   "quoteId",
   "creditsCharged",
   "balance",
   "alreadyOwned",
   "firms"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "properties:read",
    "credits:spend"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Run an investor firm search"
}
