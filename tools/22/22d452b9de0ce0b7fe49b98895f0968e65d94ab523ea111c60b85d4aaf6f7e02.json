{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Start covering one surface with multiple pieces of the same ply/fabric.\n\n        This is not a laminate stack. overlap is mm; supplied seeds are laid first\n        and additional pieces fill remaining ground, up to max_pieces. Poll the\n        returned job_id with get_job(kind='layout'); export with layout=true.\n        ",
 "inputSchema": {
  "properties": {
   "angle": {
    "default": 0,
    "title": "Angle",
    "type": "number"
   },
   "fabric_id": {
    "default": "carbon-twill-3k",
    "title": "Fabric Id",
    "type": "string"
   },
   "hole_area": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Hole Area"
   },
   "lock_angle": {
    "anyOf": [
     {
      "exclusiveMaximum": 90,
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lock Angle"
   },
   "max_pieces": {
    "default": 6,
    "maximum": 12,
    "minimum": 1,
    "title": "Max Pieces",
    "type": "integer"
   },
   "mesh_id": {
    "pattern": "^[A-Za-z0-9_-]{1,80}$",
    "title": "Mesh Id",
    "type": "string"
   },
   "offset": {
    "default": 0,
    "maximum": 50,
    "minimum": -50,
    "title": "Offset",
    "type": "number"
   },
   "overlap": {
    "default": 20,
    "minimum": 0,
    "title": "Overlap",
    "type": "number"
   },
   "pitch": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Pitch"
   },
   "seeds": {
    "anyOf": [
     {
      "items": {
       "items": {
        "type": "number"
       },
       "maxItems": 3,
       "minItems": 3,
       "type": "array"
      },
      "maxItems": 12,
      "minItems": 1,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Seeds"
   },
   "workspace_id": {
    "pattern": "^[0-9a-f]{48}$",
    "title": "Workspace Id",
    "type": "string"
   }
  },
  "required": [
   "workspace_id",
   "mesh_id"
  ],
  "title": "create_layoutArguments",
  "type": "object"
 },
 "name": "create_layout",
 "outputSchema": {
  "additionalProperties": true,
  "title": "create_layoutDictOutput",
  "type": "object"
 }
}
