{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Inspect a test"
 },
 "description": "Decodes a test and describes it: slots, variants, context, and whether it can be served by redirect. Also lints it for the mistakes that only show up once a campaign is out, such as an email test whose context comes from geo (which a mail proxy answers about itself).\n\nUse this before sending anything, and to answer 'what is this link?'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
   {
    "required": [
     "test"
    ]
   },
   {
    "required": [
     "config"
    ]
   }
  ],
  "properties": {
   "config": {
    "description": "Alias for `test`: the same value under the name build_test returns it as (`config`). Pass one or the other.",
    "minLength": 1,
    "type": "string"
   },
   "test": {
    "description": "The test: an encoded config, or any LiveVariant URL containing one (serve, click, pixel, manage), or a query-parameter serve URL. Paste whatever you have.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "inspect_test",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "combinations": {
    "type": "number"
   },
   "context": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "from": {
       "type": "string"
      },
      "key": {
       "type": "string"
      },
      "values": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "key"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "level": {
       "enum": [
        "error",
        "warning",
        "note"
       ],
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "level",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "region": {
    "type": [
     "string",
     "null"
    ]
   },
   "resultsReadable": {
    "description": "False when the config has no stats key, which is permanent.",
    "type": "boolean"
   },
   "slots": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "slot": {
       "type": "string"
      },
      "variants": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "formats": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "name": {
          "type": "string"
         },
         "servesByRedirect": {
          "type": "boolean"
         }
        },
        "required": [
         "name",
         "formats",
         "servesByRedirect"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "slot",
      "variants"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testId": {
    "type": "string"
   }
  },
  "required": [
   "testId",
   "slots",
   "combinations",
   "region",
   "context",
   "resultsReadable",
   "findings"
  ],
  "type": "object"
 },
 "title": "Inspect a test"
}
