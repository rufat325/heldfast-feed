{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Parse a markdown Kanban board file into its column/card structure. Use this when you need the full board content \u2014 each column's name and its cards with their completion state. Works with the obsidian-kanban plugin's markdown format. Read-only. For completion counts and ratios instead of the full card list, use `kanban.stats`.\n\nOperates on the session-active vault (see `vault.current` \u2014 selectable via `vault.select`) unless an explicit `vaultPath` argument is passed, which always wins.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Arguments for `kanban.parse`.",
  "properties": {
   "filePath": {
    "description": "Path of the Kanban board note (`.md`).",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "vaultPath": {
    "type": "string"
   }
  },
  "required": [
   "filePath"
  ],
  "type": "object"
 },
 "name": "kanban.parse",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "columns": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "cards": {
       "items": {
        "additionalProperties": {},
        "properties": {
         "completed": {
          "type": "boolean"
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "text",
         "completed"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "cards"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "filePath": {
    "type": "string"
   }
  },
  "required": [
   "filePath",
   "columns"
  ],
  "type": "object"
 },
 "title": "Parse Kanban Board"
}
