    "type": "string"
   },
   "model": {
    "description": "Model slug from resolve_vehicle, e.g. 'f-150'.",
    "type": "string"
   },
   "year": {
    "description": "4-digit model year from resolve_vehicle.",
    "pattern": "^\\d{4}$",
    "type": "string"
   }
  },
  "required": [
   "year",
   "make",
   "model"
  ],
  "type": "object"
 },
 "name": "get_recalls",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
