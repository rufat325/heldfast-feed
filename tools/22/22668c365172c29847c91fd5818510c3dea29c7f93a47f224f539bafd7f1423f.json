{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Diagnose a network for cleanup: report likely-dead operators (zero wired outputs, unreferenced, not displayed), broken external-file dependencies (file parameters pointing at missing files), orphan COMPs, and a dependency map of which operators reference which. Read-only and conservative \u2014 every flagged item carries a human-readable reason. Complements plan_visual (which plans a build) and snapshot_td_graph (which dumps structure).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "path": {
    "default": "/project1",
    "description": "Network root to analyze (the COMP whose descendants are scanned).",
    "type": "string"
   },
   "recursive": {
    "default": true,
    "description": "Recurse into child COMPs (true) or only inspect the root's direct children (false).",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "analyze_project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "broken_file_deps": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "file": {
       "type": "string"
      },
      "par": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "par",
      "file"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "counts": {
    "additionalProperties": false,
    "properties": {
     "by_family": {
      "additionalProperties": {
       "type": "number"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "nodes": {
      "type": "number"
     }
    },
    "required": [
     "nodes",
     "by_family"
    ],
    "type": "object"
   },
   "dependency_map": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "orphan_comps": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "path": {
    "type": "string"
   },
   "recursive": {
    "type": "boolean"
   },
   "unused": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "type",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "path",
   "recursive",
   "counts",
   "unused",
   "broken_file_deps",
   "orphan_comps",
   "dependency_map",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Analyze project"
}
