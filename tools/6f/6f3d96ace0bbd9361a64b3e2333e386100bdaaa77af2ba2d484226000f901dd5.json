{
 "description": "Push changes to remote git repository.",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "Optional: ID of remote agent. If omitted, executes locally.",
    "type": "string"
   },
   "branch": {
    "description": "Branch name (optional)",
    "type": "string"
   },
   "remote": {
    "default": "origin",
    "description": "Remote name",
    "type": "string"
   },
   "repo": {
    "description": "Path to the git repository",
    "type": "string"
   }
  },
  "required": [
   "repo"
  ],
  "type": "object"
 },
 "name": "git_push"
}
