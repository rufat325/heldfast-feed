{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Move one of your leads to a new pipeline stage. Two-step: draft, then confirm.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "confirm": {
    "default": false,
    "description": "Leave false to get a draft of the change. Only set true after the user has seen the draft and approved it.",
    "type": "boolean"
   },
   "lead_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "status": {
    "enum": [
     "cold",
     "contacted",
     "shadow_trial",
     "trial_active",
     "won",
     "lost"
    ],
    "type": "string"
   }
  },
  "required": [
   "lead_id",
   "status"
  ],
  "type": "object"
 },
 "name": "update_lead_status",
 "title": "Update lead status"
}
