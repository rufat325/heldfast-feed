{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Recall relevant local Nuzo memories.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "include_global": {
    "default": false,
    "type": "boolean"
   },
   "limit": {
    "default": 8,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "retrieval_mode": {
    "default": "fts",
    "enum": [
     "fts",
     "semantic",
     "hybrid"
    ],
    "type": "string"
   },
   "scope": {
    "default": "user:default",
    "maxLength": 256,
    "pattern": "^(user|project|agent|team):[A-Za-z0-9._~:/-]+$",
    "type": "string"
   },
   "semantic_fallback": {
    "enum": [
     "error",
     "fts"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "memory.recall"
}
