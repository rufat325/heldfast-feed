{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Prepare a filename-only repository handoff plan from relative paths and file kinds. Use when asked to select files for another agent or reviewer. Returns exact zero-based include/exclude/skip indexes and reasons; map these back to the original input, never guess. Excludes known sensitive filenames and symlinks, skips directories. NOT a content security scan or permission to upload. No credentials or payment. Do not call for general advice or to claim that file contents are safe. Never send contents, secrets, repository URLs, archives or callbacks.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "file",
        "directory",
        "symlink"
       ],
       "type": "string"
      },
      "path": {
       "maxLength": 512,
       "type": "string"
      }
     },
     "required": [
      "path",
      "kind"
     ],
     "type": "object"
    },
    "maxItems": 1024,
    "type": "array"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 },
 "name": "prepare_repository_handoff",
 "outputSchema": {
  "properties": {
   "contentSecurityVerified": {
    "const": false
   },
   "entriesReceived": {
    "type": "integer"
   },
   "entryDecisions": {
    "items": {
     "properties": {
      "decision": {
       "enum": [
        "ALLOW",
        "DENY",
        "SKIP"
       ]
      },
      "index": {
       "minimum": 0,
       "type": "integer"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "index",
      "decision",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "excludeIndexes": {
    "items": {
     "minimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "includeIndexes": {
    "items": {
     "minimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "manifestDigest": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "schema": {
    "type": "string"
   },
   "skipIndexes": {
    "items": {
     "minimum": 0,
     "type": "integer"
    },
    "type": "array"
   }
  },
  "required": [
   "schema",
   "entriesReceived",
   "entryDecisions",
   "includeIndexes",
   "excludeIndexes",
   "skipIndexes",
   "manifestDigest",
   "contentSecurityVerified"
  ],
  "type": "object"
 }
}
