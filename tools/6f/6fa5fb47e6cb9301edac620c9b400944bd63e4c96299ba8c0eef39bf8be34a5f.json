{
 "description": "Upload media to WordPress from a public external URL (private/internal hosts are refused)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alt": {
    "description": "Alt text (for images)",
    "type": "string"
   },
   "caption": {
    "description": "Caption, plain text",
    "type": "string"
   },
   "description": {
    "description": "Description, plain text",
    "type": "string"
   },
   "filename": {
    "description": "Override filename (default: basename of the URL path)",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "title": {
    "description": "Media title",
    "type": "string"
   },
   "url": {
    "description": "Public URL of the file to download and import",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "site",
   "url"
  ],
  "type": "object"
 },
 "name": "mcp_sideload_media"
}
