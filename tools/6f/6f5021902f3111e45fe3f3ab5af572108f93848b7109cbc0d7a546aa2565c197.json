{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Create a group calendar event.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "accessType": {
    "default": "group",
    "enum": [
     "group",
     "public"
    ],
    "type": "string"
   },
   "category": {
    "default": "other",
    "enum": [
     "arts",
     "avatars",
     "dance",
     "education",
     "exploration",
     "film_media",
     "gaming",
     "hangout",
     "music",
     "other",
     "performance",
     "roleplaying",
     "wellness"
    ],
    "type": "string"
   },
   "closeInstanceAfterEndMinutes": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "description": {
    "minLength": 1,
    "type": "string"
   },
   "endsAt": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "featured": {
    "type": "boolean"
   },
   "groupId": {
    "type": "string"
   },
   "guestEarlyJoinMinutes": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "hostEarlyJoinMinutes": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "imageId": {
    "type": "string"
   },
   "isDraft": {
    "type": "boolean"
   },
   "languages": {
    "items": {
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "occurrenceKind": {
    "description": "Recurring schedules require explicit series.",
    "enum": [
     "single",
     "series"
    ],
    "type": "string"
   },
   "parentId": {
    "type": "string"
   },
   "platforms": {
    "items": {
     "enum": [
      "android",
      "ios",
      "standalonewindows"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "recurrence": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "daysOfWeek": {
        "items": {
         "enum": [
          "FR",
          "MO",
          "SA",
          "SU",
          "TH",
          "TU",
          "WE"
         ],
         "type": "string"
        },
        "type": "array"
       },
       "end": {
        "additionalProperties": {},
        "properties": {
         "count": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
         },
         "date": {
          "type": "string"
         },
         "type": {
          "default": "afterDate",
          "enum": [
           "afterDate",
           "afterOccurrences"
          ],
          "type": "string"
         }
        },
        "type": "object"
       },
       "frequency": {
        "default": "weekly",
        "enum": [
         "daily",
         "monthly",
         "weekly",
         "yearly"
        ],
        "type": "string"
       },
       "interval": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
       },
       "timezone": {
        "type": "string"
       }
      },
      "required": [
       "interval",
       "timezone"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "roleIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sendCreationNotification": {
    "default": false,
    "type": "boolean"
   },
   "startsAt": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "title": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "usesInstanceOverflow": {
    "type": "boolean"
   }
  },
  "required": [
   "description",
   "endsAt",
   "startsAt",
   "title",
   "groupId"
  ],
  "type": "object"
 },
 "name": "vrchat_event_create",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "event": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "result": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "success": {
        "additionalProperties": {},
        "properties": {
         "message": {
          "minLength": 1,
          "type": "string"
         },
         "status_code": {
          "maximum": 9007199254740991,
          "minimum": 100,
          "type": "integer"
         }
        },
        "required": [
         "status_code"
        ],
        "type": "object"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "created",
     "updated",
     "deleted",
     "followed",
     "unfollowed"
    ],
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 }
}
