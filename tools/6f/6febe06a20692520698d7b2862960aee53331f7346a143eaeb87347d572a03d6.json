{
 "description": "Gate a capability against your install-time allow-list (no auth). Returns { pass, violations }. Use before installing to enforce an org policy \u2014 e.g. minimum grade, no shell/network access, no unknown egress, no pickle model weights.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "denyInstallHooks": {
    "type": "boolean"
   },
   "denyPermissions": {
    "items": {
     "enum": [
      "shell",
      "network",
      "filesystem",
      "secrets"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "denyUnknownEgress": {
    "type": "boolean"
   },
   "denyUnsafeModel": {
    "type": "boolean"
   },
   "maxLevel": {
    "enum": [
     "SAFE",
     "REVIEW"
    ],
    "type": "string"
   },
   "minGrade": {
    "enum": [
     "A",
     "B",
     "C",
     "D"
    ],
    "type": "string"
   },
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "check_policy"
}
