{
 "description": "Send a new email",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "type": "string"
   },
   "attachments": {
    "description": "Files to attach. Total size is capped at 25 MB",
    "items": {
     "description": "One attachment: give either path or content (base64) plus filename",
     "properties": {
      "content": {
       "description": "Base64-encoded file content, used instead of path",
       "type": "string"
      },
      "contentType": {
       "description": "MIME type. Inferred from the file extension when omitted",
       "type": "string"
      },
      "filename": {
       "description": "File name shown to the recipient. Required with content; defaults to the file name of path",
       "type": "string"
      },
      "path": {
       "description": "A file inside the folder the user set in EMAIL_MCP_ATTACHMENTS_DIR: its name, a path relative to that folder, or an absolute path inside it. Files anywhere else are refused, and path attachments are off when that variable is not set.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "bcc": {
    "items": {
     "properties": {
      "email": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "body": {
    "properties": {
     "html": {
      "type": "string"
     },
     "text": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "cc": {
    "items": {
     "properties": {
      "email": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "subject": {
    "type": "string"
   },
   "to": {
    "items": {
     "properties": {
      "email": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "accountId",
   "to",
   "subject",
   "body"
  ],
  "type": "object"
 },
 "name": "email_send"
}
