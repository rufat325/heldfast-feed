{
 "description": "Set a previously discovered Agent-Q Firmware device as the default active device, or as the active device for a named routing purpose. 'purpose' is local Agent-Q process routing metadata, not security policy. Updates local Agent-Q process state only; does not contact Firmware.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "pattern": "^[A-Za-z0-9_.-]{1,128}$",
    "type": "string"
   },
   "purpose": {
    "pattern": "^[A-Za-z0-9_.-]{1,32}$",
    "type": "string"
   }
  },
  "required": [
   "deviceId"
  ],
  "type": "object"
 },
 "name": "select_device",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activeDeviceId": {
    "pattern": "^[A-Za-z0-9_.-]{1,128}$",
    "type": "string"
   },
   "device": {
    "additionalProperties": false,
    "properties": {
     "deviceId": {
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "type": "string"
     },
     "firmwareName": {
      "maxLength": 64,
      "pattern": "^[\\x20-\\x7E]*$",
      "type": "string"
     },
     "firmwareVersion": {
      "maxLength": 32,
      "pattern": "^[\\x20-\\x7E]*$",
      "type": "string"
     },
     "hardware": {
      "maxLength": 64,
      "pattern": "^[\\x20-\\x7E]*$",
      "type": "string"
     },
     "state": {
      "enum": [
       "idle",
       "busy",
       "awaiting_approval",
       "locked",
       "error"
      ],
      "type": "string"
     }
    },
    "required": [
     "deviceId",
     "state",
     "firmwareName",
     "hardware",
     "firmwareVersion"
    ],
    "type": "object"
   },
   "purpose": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z0-9_.-]{1,32}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "source": {
    "const": "selected",
    "type": "string"
   }
  },
  "required": [
   "source",
   "activeDeviceId",
   "purpose",
   "device"
  ],
  "type": "object"
 },
 "title": "Select device"
}
