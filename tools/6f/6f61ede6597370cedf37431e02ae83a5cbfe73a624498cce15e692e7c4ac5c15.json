{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Snapshot a root"
 },
 "description": "Deterministic, content-addressed inventory of a root: every regular file (and symlink) as { path, bytes, sha256, mode, kind }, sorted by code point, with snapshotDigest = sha256(JCS(body)). No timestamps, no absolute paths \u2014 the same tree gives the same digest on every machine. Honours the root .gitignore, always skips .git/ and .axiom/, never follows symlinks, never leaves the root. Use it to build Plans against real pre-image digests, or diff two snapshots with `axiom snapshot-diff`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "exclude": {
    "description": "Relative globs to drop",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "followSymlinks": {
    "const": false,
    "default": false,
    "description": "Always false; symlinks are recorded, never followed",
    "type": "boolean"
   },
   "include": {
    "description": "Relative globs (*, **, ?) to keep; default everything",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "maxBytes": {
    "default": 67108864,
    "description": "Stop once the summed size would exceed this; sets truncated",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "maxFiles": {
    "default": 20000,
    "description": "Stop after this many files (cap 50000); sets truncated",
    "maximum": 50000,
    "minimum": 1,
    "type": "integer"
   },
   "respectGitignore": {
    "default": true,
    "type": "boolean"
   },
   "root": {
    "description": "Absolute repository root; must equal or lie inside an allowlisted --root",
    "type": "string"
   },
   "withContentDigest": {
    "default": true,
    "description": "false \u2192 sizes only, no sha256",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "axiom_repo_snapshot",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "apiVersion": {
    "const": "axiom.dev/v2",
    "type": "string"
   },
   "body": {
    "additionalProperties": false,
    "properties": {
     "counts": {
      "additionalProperties": false,
      "properties": {
       "bytes": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "files": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "files",
       "bytes"
      ],
      "type": "object"
     },
     "files": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "bytes": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "kind": {
         "enum": [
          "file",
          "symlink"
         ],
         "type": "string"
        },
        "mode": {
         "enum": [
          "0644",
          "0755"
         ],
         "type": "string"
        },
        "path": {
         "description": "Relative POSIX path, NFC, no reserved names",
         "maxLength": 1024,
         "minLength": 1,
         "type": "string"
        },
        "sha256": {
         "description": "Lowercase hex-encoded sha256",
         "pattern": "^[a-f0-9]{64}$",
         "type": "string"
        }
       },
       "required": [
        "path",
        "bytes",
        "mode",
        "kind"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "files",
     "truncated",
     "counts"
    ],
    "type": "object"
   },
   "kind": {
    "const": "RepoSnapshot",
    "type": "string"
   },
   "root": {
    "additionalProperties": false,
    "properties": {
     "kind": {
      "const": "relative",
      "type": "string"
     }
    },
    "required": [
     "kind"
    ],
    "type": "object"
   },
   "snapshotDigest": {
    "description": "sha256:<64 lowercase hex>",
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "apiVersion",
   "kind",
   "root",
   "snapshotDigest",
   "body"
  ],
  "type": "object"
 },
 "title": "Snapshot a root"
}
