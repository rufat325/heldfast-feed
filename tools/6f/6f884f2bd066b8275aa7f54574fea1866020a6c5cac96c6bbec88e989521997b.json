{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use this to render supplied PNG/JPEG captures offline into NEW local directories with neutral frames, supplied copy, hashed metadata and a gallery. Does not capture or upload. Single-image tool requires one screen and template; variants requires multiple templates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "recipe": {
    "additionalProperties": false,
    "properties": {
     "accent": {
      "pattern": "^#[\\da-fA-F]{6}$",
      "type": "string"
     },
     "appName": {
      "$ref": "#/properties/recipe/properties/screens/items/properties/headline",
      "default": "Your app"
     },
     "direction": {
      "enum": [
       "ltr",
       "rtl"
      ],
      "type": "string"
     },
     "fontPaths": {
      "items": {
       "$ref": "#/properties/recipe/properties/projectPath"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
     },
     "iconPath": {
      "$ref": "#/properties/recipe/properties/projectPath"
     },
     "inputDirectory": {
      "$ref": "#/properties/recipe/properties/projectPath"
     },
     "locale": {
      "default": "en-US",
      "pattern": "^[a-zA-Z]{2,8}(?:-[a-zA-Z0-9]{1,8})*$",
      "type": "string"
     },
     "outputDirectory": {
      "$ref": "#/properties/recipe/properties/projectPath"
     },
     "profile": {
      "default": "iphone-portrait",
      "enum": [
       "iphone-portrait",
       "iphone-landscape",
       "ipad-portrait",
       "ipad-landscape",
       "mac",
       "apple-tv",
       "vision-pro",
       "watch-ultra"
      ],
      "type": "string"
     },
     "projectPath": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
     },
     "screens": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "additionalImages": {
         "items": {
          "$ref": "#/properties/recipe/properties/projectPath"
         },
         "maxItems": 2,
         "type": "array"
        },
        "badge": {
         "$ref": "#/properties/recipe/properties/screens/items/properties/headline"
        },
        "description": {
         "$ref": "#/properties/recipe/properties/screens/items/properties/headline"
        },
        "headline": {
         "maxLength": 240,
         "type": "string"
        },
        "image": {
         "$ref": "#/properties/recipe/properties/projectPath"
        },
        "subtitle": {
         "$ref": "#/properties/recipe/properties/screens/items/properties/headline"
        }
       },
       "required": [
        "image"
       ],
       "type": "object"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     },
     "templates": {
      "default": [
       "minimal"
      ],
      "items": {
       "maxLength": 40,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "outputDirectory"
    ],
    "type": "object"
   }
  },
  "required": [
   "recipe"
  ],
  "type": "object"
 },
 "name": "generate_screenshot_set"
}
