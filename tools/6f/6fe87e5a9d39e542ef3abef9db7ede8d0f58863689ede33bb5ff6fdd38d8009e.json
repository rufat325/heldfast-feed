{
 "_meta": {
  "openai/outputTemplate": "ui://sendit/widget/scheduled-list.html",
  "openai/toolInvocation/invoked": "Scheduled posts loaded",
  "openai/toolInvocation/invoking": "Loading scheduled posts...",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://sendit/apps/scheduler-app.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List scheduled posts and their current status, including pending, publishing, TikTok draft-delivered, published, failed, or cancelled posts.",
 "inputSchema": {
  "properties": {
   "cursor": {
    "description": "Optional forward-compatible pagination cursor from a previous scheduled-post listing response.",
    "type": "string"
   },
   "endDate": {
    "description": "Optional forward-compatible upper date bound in YYYY-MM-DD format.",
    "format": "date",
    "type": "string"
   },
   "limit": {
    "description": "Optional forward-compatible maximum number of scheduled posts to return.",
    "maximum": 200,
    "minimum": 1,
    "type": "number"
   },
   "platform": {
    "description": "Filter by platform (optional)",
    "enum": [
     "x",
     "linkedin",
     "linkedin-page",
     "facebook",
     "instagram",
     "threads",
     "bluesky",
     "mastodon",
     "nostr",
     "youtube",
     "tiktok",
     "lemmy",
     "discord",
     "slack",
     "telegram",
     "pinterest",
     "dribbble",
     "devto",
     "hashnode",
     "gmb",
     "whop",
     "producthunt"
    ],
    "type": "string"
   },
   "startDate": {
    "description": "Optional forward-compatible lower date bound in YYYY-MM-DD format.",
    "format": "date",
    "type": "string"
   },
   "status": {
    "description": "Optional forward-compatible status filter. Legacy handlers may continue returning pending posts only.",
    "enum": [
     "pending",
     "publishing",
     "draft_delivered",
     "published",
     "failed",
     "cancelled"
    ],
    "type": "string"
   },
   "team_id": {
    "description": "Team ID to list team's scheduled posts. If omitted, lists personal posts.",
    "type": "string"
   },
   "upcoming": {
    "description": "Optional forward-compatible flag to prefer upcoming scheduled posts.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "get_scheduled_posts",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "errorMessage": {
    "type": "string"
   },
   "followUpSuggestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "isError": {
    "type": "boolean"
   },
   "postCount": {
    "type": "number"
   },
   "posts": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "schedules": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "title": "Get Scheduled Posts"
}
