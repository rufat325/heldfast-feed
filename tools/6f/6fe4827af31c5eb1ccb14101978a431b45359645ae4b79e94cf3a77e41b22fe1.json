{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read a public article's complete Markdown, dates, canonical URL, and hosted section links. Use a slug from search_articles; unknown and draft articles are unavailable.",
 "inputSchema": {
  "properties": {
   "slug": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "title": "Slug",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "title": "get_articleArguments",
  "type": "object"
 },
 "name": "get_article",
 "outputSchema": {
  "$defs": {
   "ArticleSummary": {
    "properties": {
     "canonical": {
      "default": "",
      "title": "Canonical",
      "type": "string"
     },
     "date": {
      "format": "date-time",
      "title": "Date",
      "type": "string"
     },
     "description": {
      "title": "Description",
      "type": "string"
     },
     "image_alt": {
      "title": "Image Alt",
      "type": "string"
     },
     "image_url": {
      "title": "Image Url",
      "type": "string"
     },
     "reading_minutes": {
      "title": "Reading Minutes",
      "type": "integer"
     },
     "slug": {
      "title": "Slug",
      "type": "string"
     },
     "syndicated": {
      "default": "",
      "title": "Syndicated",
      "type": "string"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "title": "Tags",
      "type": "array"
     },
     "title": {
      "title": "Title",
      "type": "string"
     },
     "updated": {
      "format": "date-time",
      "title": "Updated",
      "type": "string"
     },
     "url": {
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "date",
     "updated",
     "title",
     "description",
     "slug",
     "url",
     "image_url",
     "image_alt",
     "tags",
     "reading_minutes"
    ],
    "title": "ArticleSummary",
    "type": "object"
   }
  },
  "properties": {
   "article": {
    "$ref": "#/$defs/ArticleSummary"
   },
   "canonical_url": {
    "title": "Canonical Url",
    "type": "string"
   },
   "markdown": {
    "title": "Markdown",
    "type": "string"
   },
   "sections": {
    "items": {
     "additionalProperties": {
      "type": "string"
     },
     "type": "object"
    },
    "title": "Sections",
    "type": "array"
   }
  },
  "required": [
   "article",
   "canonical_url",
   "markdown",
   "sections"
  ],
  "title": "ArticleResult",
  "type": "object"
 },
 "title": "Read an article"
}
