{
 "description": "Record an immutable human review. Use correct only with corrected_claim. The expected version prevents a stale review from overwriting newer work.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "claim_id": {
    "$ref": "#/properties/contract_id"
   },
   "contract_id": {
    "format": "uuid",
    "type": "string"
   },
   "corrected_claim": {
    "additionalProperties": false,
    "properties": {
     "materiality": {
      "enum": [
       "low",
       "medium",
       "high",
       "critical"
      ],
      "type": "string"
     },
     "object": {
      "anyOf": [
       {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
       },
       {
        "$ref": "#/properties/corrected_claim/properties/subject/anyOf/1"
       },
       {
        "type": "number"
       },
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ]
     },
     "predicate": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "scope": {
      "additionalProperties": {
       "anyOf": [
        {
         "maxLength": 2000,
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "description": "what the claim is scoped to, e.g. { jurisdiction: 'US', plan: 'HMO' }",
      "propertyNames": {
       "maxLength": 256,
       "minLength": 1
      },
      "type": "object"
     },
     "subject": {
      "anyOf": [
       {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "id": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
         },
         "name": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
         },
         "type": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "name"
        ],
        "type": "object"
       }
      ]
     },
     "text": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "subject",
     "predicate"
    ],
    "type": "object"
   },
   "decision": {
    "enum": [
     "approve",
     "correct",
     "reject"
    ],
    "type": "string"
   },
   "expected_candidate_version": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "idempotency_key": {
    "description": "reuse the operation key returned by an ambiguous prior attempt; omit for a new operation",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   },
   "reason": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "review_id": {
    "maxLength": 256,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._~:@/+-]*[A-Za-z0-9._~:@+-])?$",
    "type": "string"
   }
  },
  "required": [
   "contract_id",
   "claim_id",
   "review_id",
   "decision",
   "expected_candidate_version"
  ],
  "type": "object"
 },
 "name": "review_contract_claim"
}
