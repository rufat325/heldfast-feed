{
 "_meta": {
  "ui": {
   "resourceUri": "tree://display",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "description": "Display an interactive tree view for hierarchical data structures. Use this tool to visualize file systems, organizational charts, nested categories, JSON/XML structures, or any hierarchical relationships. Supports node expansion/collapse, metadata display, and export functionality.",
 "inputSchema": {
  "properties": {
   "expandAll": {
    "default": false,
    "description": "Expand all nodes initially",
    "type": "boolean"
   },
   "nodes": {
    "description": "Array of root tree nodes",
    "items": {
     "properties": {
      "children": {
       "description": "Optional child nodes",
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "expanded": {
       "default": false,
       "description": "Whether the node should be initially expanded",
       "type": "boolean"
      },
      "icon": {
       "description": "Optional icon/emoji for the node",
       "type": "string"
      },
      "id": {
       "description": "Unique identifier for the node",
       "type": "string"
      },
      "label": {
       "description": "Display label for the node",
       "type": "string"
      },
      "metadata": {
       "description": "Optional metadata for the node",
       "type": "object"
      }
     },
     "required": [
      "id",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "showMetadata": {
    "default": true,
    "description": "Show metadata in tree nodes",
    "type": "boolean"
   },
   "title": {
    "description": "Optional title for the tree view",
    "type": "string"
   }
  },
  "required": [
   "nodes"
  ],
  "type": "object"
 },
 "name": "display_tree",
 "title": "Display Tree"
}
