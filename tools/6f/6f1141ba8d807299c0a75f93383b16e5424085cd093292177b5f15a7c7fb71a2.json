  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_image": {
    "default": false,
    "description": "Also attach a small WebP thumbnail (under ~100 KB) as an image block. Off by default to save tokens.",
    "type": "boolean"
   },
   "slug": {
    "description": "Resource slug, e.g. \"linear\".",
    "maxLength": 80,
    "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
