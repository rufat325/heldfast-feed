{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a request or token rate-limit policy. Conditions and grouping must be non-empty; target llm uses model/provider keys, while target mcp_tools uses MCP server and tool keys.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "conditions": {
    "description": "Policy match conditions",
    "items": {
     "properties": {
      "excludes": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        }
       ],
       "description": "Values to exclude"
      },
      "key": {
       "description": "Match key such as api_key, virtual_key, provider, config, prompt, model, endpoint_type, mcp_server, mcp_tool, workspace_id, or metadata.*",
       "minLength": 1,
       "type": "string"
      },
      "value": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        }
       ],
       "description": "One value or several OR-matched values; use * for wildcard matching"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "group_by": {
    "description": "Counter grouping dimensions",
    "items": {
     "properties": {
      "key": {
       "description": "Counter grouping key such as api_key, workspace_id, virtual_key, provider, config, prompt, model, mcp_server, mcp_tool, or metadata.*",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "key"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "description": "Optional policy display name",
    "type": "string"
   },
   "organisation_id": {
    "description": "Organisation UUID scope",
    "type": "string"
   },
   "target": {
    "description": "LLM or MCP-tool enforcement target",
    "enum": [
     "llm",
     "mcp_tools"
    ],
    "type": "string"
   },
   "type": {
    "description": "Counter type",
    "enum": [
     "requests",
     "tokens"
    ],
    "type": "string"
   },
   "unit": {
    "description": "Counter reset interval",
    "enum": [
     "rpm",
     "rph",
     "rpd",
     "rpw"
    ],
    "type": "string"
   },
   "value": {
    "description": "Maximum requests or tokens",
    "minimum": 0,
    "type": "number"
   },
   "workspace_id": {
    "description": "Workspace UUID scope",
    "type": "string"
   }
  },
  "required": [
   "conditions",
   "group_by",
   "type",
   "unit",
   "value"
  ],
  "type": "object"
 },
 "name": "create_rate_limit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
