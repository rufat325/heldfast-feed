      "cm"
     ]
    }
   }
  ],
  "properties": {
   "cm": {
    "description": "Centimetres (for cm-to-feet)",
    "minimum": 0,
    "type": "number"
   },
   "direction": {
    "description": "Which way to convert",
    "enum": [
     "cm-to-feet",
     "feet-to-cm"
    ],
    "type": "string"
   },
   "feet": {
    "description": "Feet (for feet-to-cm)",
    "minimum": 0,
    "type": "number"
   },
   "inches": {
    "description": "Inches (for feet-to-cm, optional)",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "direction"
  ],
  "type": "object"
 },
 "name": "hopi_cm_to_feet",
