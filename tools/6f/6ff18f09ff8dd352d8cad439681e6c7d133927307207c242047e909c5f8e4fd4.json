{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get server metrics"
 },
 "description": "Fetch CPU, disk or network time series for one server over a window. Hetzner Cloud: GET /servers/{id}/metrics.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "end": {
    "description": "ISO-8601 end of the window.",
    "type": "string"
   },
   "server_id": {
    "description": "The server's numeric id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "start": {
    "description": "ISO-8601 start of the window.",
    "type": "string"
   },
   "step": {
    "description": "Resolution in seconds.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "type": {
    "description": "Which metric family to return.",
    "enum": [
     "cpu",
     "disk",
     "network"
    ],
    "type": "string"
   }
  },
  "required": [
   "server_id",
   "type",
   "start",
   "end"
  ],
  "type": "object"
 },
 "name": "hetzner_get_server_metrics",
 "title": "Get server metrics"
}
