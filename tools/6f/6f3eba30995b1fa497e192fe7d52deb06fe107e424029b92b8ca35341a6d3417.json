{"_meta":{"xdata.kr/credential":{"providers":["hometax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=hometax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: hometax__session__login (\uac19\uc740 account_link_id). prepare \ub85c \ud655\uc778\ud55c \uc6d0\ucc9c\uc138 \uc2e0\uace0\uc758 \uc0ad\uc81c\uc2e0\uccad\uc744 \uae30\uad00\uc5d0 \uc81c\ucd9c\ud569\ub2c8\ub2e4. \uae30\uad00\uc774 \uac80\ud1a0\ud574 \uc0ad\uc81c\ud558\ubbc0\ub85c \uc81c\ucd9c\uc774 \uace7 \uc0ad\uc81c \ud655\uc815\uc740 \uc544\ub2d9\ub2c8\ub2e4. \ub418\ub3cc\ub9b4 \uc218 \uc5c6\ub294 \uae30\uad00 \uc4f0\uae30\ub77c \uc0ac\uc6a9\uc790\uc758 \uc81c\ucd9c \ud655\uc778\uacfc \ub3d9\uc758 \uac12\uc744 \uba85\uc2dc\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774 \ub3c4\uad6c\ub294 \uae30\uad00\uc758 \uae30\ub85d\uc744 \ubc14\uafc9\ub2c8\ub2e4. \uccab \ud638\ucd9c\uc740 \uc2e4\ud589\ub418\uc9c0 \uc54a\uace0, \uc804\uc1a1\ud560 \ub0b4\uc6a9\uc758 \ubbf8\ub9ac\ubcf4\uae30\uc640 1\ud68c\uc6a9 confirmation_token \uc744 \ub3cc\ub824\uc90d\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uadf8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc0ac\uc6a9\uc790\uc5d0\uac8c \uadf8\ub300\ub85c \ubcf4\uc5ec \uc90d\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \ub3d9\uc758\ud55c \ub4a4\uc5d0\ub9cc \uac19\uc740 \uc778\uc790\uc5d0 \uadf8 confirmation_token \uc744 \ub354\ud574 \ub2e4\uc2dc \ud638\ucd9c\ud569\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uc758 \ub3d9\uc758 \uc5c6\uc774 \ud1a0\ud070\uc744 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc778\uc790\ub97c \ud558\ub098\ub77c\ub3c4 \ubc14\uafb8\uba74 \ud1a0\ud070\uc740 \ubb34\ud6a8\uac00 \ub429\ub2c8\ub2e4. \uadf8\ub54c\ub294 \ud1a0\ud070 \uc5c6\uc774 \ud638\ucd9c\ud574 \uc0c8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 5\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"businessNo":{"description":"\uc0ad\uc81c\uc2e0\uccad\ud560 \uc6d0\ucc9c\uc138 \uc2e0\uace0\uc758 \uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638\uc785\ub2c8\ub2e4. \ud558\uc774\ud508 \uc5c6\uc774 \uc22b\uc790 10\uc790\ub9ac\ub85c \uc785\ub825\ud558\uba70 \uc774\uc804 \ub2e8\uacc4 \uc791\uc5c5\uc758 \uc0ac\uc5c5\uc790\uc640 \ub2e4\ub974\uba74 403 \uc73c\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^\\d{10}$","title":"Businessno","type":"string"},"confirmDeleteRequest":{"default":false,"description":"\uc0ad\uc81c\uc2e0\uccad\uc744 \uc2e4\uc81c\ub85c \uc81c\ucd9c\ud55c\ub2e4\ub294 \ucd5c\uc885 \ud655\uc778\uac12\uc785\ub2c8\ub2e4. \uc811\uc218\ub41c \uc0ad\uc81c\uc2e0\uccad\uc740 \ub418\ub3cc\ub9b4 \uc218 \uc5c6\uc73c\ubbc0\ub85c \uc0ac\uc6a9\uc790 \ub3d9\uc758\ub97c \ubc1b\uc558\uc744 \ub54c JSON \ubd88\ub9ac\uc5b8 true \ub85c \uc785\ub825\ud569\ub2c8\ub2e4. \ube60\uc9c0\uac70\ub098 false \uc774\uba74 \uae30\uad00\uc5d0 \uc544\ubb34\uac83\ub3c4 \ubcf4\ub0b4\uc9c0 \uc54a\uace0 \ucd5c\uc885 \ud655\uc778\uc774 \ud544\uc694\ud558\ub2e4\ub294 \uc624\ub958(422)\ub85c \uac70\uc808\ud558\uace0, \ubb38\uc790\uc5f4\ub85c \uc4f4 true \ub098 \uc22b\uc790 1 \uc740 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud569\ub2c8\ub2e4. \uc81c\ucd9c \uacb0\uacfc\ub294 \uc0ad\uc81c\uc2e0\uccad \uc811\uc218\uc774\uace0 \uc0ad\uc81c\uac00 \ud655\uc815\ub41c \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4. \uc774 \uac12\ub3c4 \ud655\uc778 \ud1a0\ud070\uc774 \uac00\ub9ac\ud0a4\ub294 \uc694\uccad \ubcf8\ubb38\uc5d0 \ub4e4\uc5b4\uac00\ubbc0\ub85c \ud655\uc778 \ud1a0\ud070\uc744 \ubc1b\ub294 \uccab \uc694\uccad\ubd80\ud130 \ud568\uaed8 \uc785\ub825\ud569\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub354\ud558\uba74 \ubcf8\ubb38\uc774 \ub2ec\ub77c\uc838 \ud655\uc778 \ud1a0\ud070\uc744 \ub2e4\uc2dc \ubc1b\uc544\uc57c \ud569\ub2c8\ub2e4.","title":"Confirmdeleterequest","type":"boolean"},"confirmation_token":{"description":"\uccab \ud638\ucd9c\uc774 \ub3cc\ub824\uc900 1\ud68c\uc6a9 \ud655\uc778 \ud1a0\ud070\uc785\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uac19\uc740 \uc778\uc790\uc5d0 \uc774 \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc5b4 \ub2e4\uc2dc \ud638\ucd9c\ud558\uba74 \uc2e4\ud589\ub429\ub2c8\ub2e4. 10\ubd84 \ub4a4 \ub9cc\ub8cc\ub418\uace0 \ud55c \ubc88\ub9cc \uc4f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","type":"string"},"expectedSnapshotHash":{"description":"sourceJobId \uc791\uc5c5 \uacb0\uacfc\uc758 snapshot_hash \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(\uc18c\ubb38\uc790 16\uc9c4\uc218 64\uc790\ub9ac). \uadf8 \uc791\uc5c5\uc758 \ub0b4\uc6a9\uacfc \ub9de\uc9c0 \uc54a\uc73c\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uc791\uc131 \ub0b4\uc6a9\uc774 \ubc14\ub00c\uc5c8\ub2e4\ub294 \uc624\ub958(409)\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^[0-9a-f]{64}$","title":"Expectedsnapshothash","type":"string"},"sourceJobId":{"description":"\uc774\uc5b4\uc11c \uc9c4\ud589\ud560 \uc774\uc804 \ub2e8\uacc4 \uc791\uc5c5\uc758 job_id \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(job_ \uc73c\ub85c \uc2dc\uc791\ud558\ub294 \uc791\uc5c5 \ubc88\ud638). \uc81c\ucd9c \uc900\ube44(prepare) \uacb0\uacfc \uac00\uc6b4\ub370 \uc2e0\uccad\uc778 \uc774\ub984\uacfc \uc5f0\ub77d\ucc98, \uac1c\uc778\uc815\ubcf4 \ub3d9\uc758\uac00 \ubaa8\ub450 \ub4e4\uc5b4\uac00 \uc900\ube44\uac00 \ub05d\ub09c \uacb0\uacfc(ready_for_submission \uc774 true)\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \uac19\uc740 \uc870\uc9c1\uacfc \ud658\uacbd, \uac19\uc740 \uae30\uad00 \uc5f0\uacb0\uc5d0\uc11c \uc131\uacf5\ud55c \uc6d0\ucc9c\uc138 \uc0ad\uc81c\uc2e0\uccad \uc791\uc5c5\uc774\uc5b4\uc57c \ud558\uace0 \uc544\ub2c8\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uac70\uc808\ud558\uba70, \ubc1b\uc9c0 \uc54a\ub294 \uc0c1\ud0dc\uc758 \uacb0\uacfc\uc774\uba74 409 \ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^job_[0-9A-HJKMNP-TV-Z]{26}$","title":"Sourcejobid","type":"string"},"taxCode":{"const":"14","default":"14","description":"\uc138\ubaa9 \ucf54\ub4dc\uc785\ub2c8\ub2e4. \uc6d0\ucc9c\uc138\ub97c \ub73b\ud558\ub294 14 \ub9cc \ubc1b\uc73c\uba70 \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 14 \uc785\ub2c8\ub2e4.","title":"Taxcode","type":"string"}},"required":["businessNo","sourceJobId","expectedSnapshotHash","confirmDeleteRequest"],"title":"SubmitRequest","type":"object"},"name":"hometax__tax__withholding__delete_request__submit","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\ud648\ud0dd\uc2a4 \uc6d0\ucc9c\uc138 \uc2e0\uace0 \uc0ad\uc81c\uc2e0\uccad \uc81c\ucd9c"}
