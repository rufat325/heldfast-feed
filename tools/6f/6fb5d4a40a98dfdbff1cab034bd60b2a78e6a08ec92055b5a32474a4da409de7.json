    "minimum": 0,
    "type": "integer"
   },
   "catalog_version": {
    "type": "string"
   },
   "error_code": {
    "type": "string"
   },
   "idempotency_key": {
    "format": "uuid",
    "type": "string"
   },
   "matches": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "parsed_request": {
    "type": "object"
   },
   "protocol_version": {
    "const": "2",
    "type": "string"
   },
   "recover_task_ref": {
    "format": "uuid",
    "type": "string"
   },
   "request_id": {
    "format": "uuid",
    "type": "string"
   },
   "view": {
