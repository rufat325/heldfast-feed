 "description": "Search Apiosk's sources the way the Ask page does, with a capability object you fill in yourself (parsed_request, following the host instructions' parser rules). Slugs are English dot paths of letters and digits, such as location.time.current. Returns, per capability, the Ask page's ranked sources; each runnable candidate carries endpoint.inputs: the exact input keys, whether each is required, and its value schema for apiosk_prepare. Free: creates no task and buys nothing.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "parsed_request": {
    "additionalProperties": false,
    "properties": {
     "capabilities": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "confidence": {
         "type": "number"
        },
        "description": {
         "type": "string"
        },
        "domain": {
         "enum": [
          "company",
          "location",
          "compliance",
          "vehicle",
          "finance",
          "legal",
          "procurement",
          "document",
          "research",
          "general"
         ],
         "type": "string"
        },
        "inputs": {
         "items": {
          "type": "string"
         },
         "maxItems": 32,
         "type": "array"
        },
        "name": {
         "type": "string"
        },
        "outputs": {
         "items": {
          "type": "string"
         },
         "maxItems": 32,
         "type": "array"
        },
        "slug": {
         "type": "string"
        },
        "source_hint": {
         "type": [
          "string",
          "null"
         ]
        },
        "subject_id": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "slug",
        "name",
        "description",
        "domain",
        "inputs",
        "outputs",
        "subject_id",
        "source_hint",
        "confidence"
       ],
       "type": "object"
      },
      "maxItems": 16,
      "type": "array"
     },
     "deliverable": {
      "additionalProperties": false,
      "properties": {
       "format": {
        "enum": [
         "chat",
         "pdf",
         "xlsx",
         "docx",
         "json"
        ],
        "type": "string"
       },
       "operations": {
        "items": {
         "enum": [
          "summarize",
          "analyze",
          "compare",
          "list",
          "export"
         ],
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "format",
       "operations"
      ],
      "type": "object"
     },
     "language": {
      "type": "string"
     },
     "subjects": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string"
        },
        "identifiers": {
         "additionalProperties": {
          "type": "string"
         },
         "type": "object"
        },
        "label": {
         "type": "string"
        },
        "type": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "label",
        "type",
        "identifiers"
       ],
       "type": "object"
      },
      "maxItems": 32,
      "type": "array"
     }
    },
    "required": [
     "language",
     "subjects",
     "capabilities",
     "deliverable"
    ],
    "type": "object"
   }
  },
  "required": [
   "parsed_request"
  ],
  "type": "object"
 },
 "name": "apiosk_search",
 "outputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "protocol_version",
     "view",
     "parsed_request",
     "matches",
     "notice"
    ]
   },
   {
