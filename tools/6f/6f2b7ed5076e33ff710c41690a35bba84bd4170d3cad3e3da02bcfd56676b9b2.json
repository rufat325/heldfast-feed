 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update seat alert settings"
 },
 "description": "Use to pause or resume a seat alert, or change its seats-together rule or channels. To watch different seats call track_seats again (it adds to the alert). Only the fields given change. Confirm first.",
 "inputSchema": {
  "properties": {
   "alerts_on": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "false pauses the alert, true resumes it.",
    "title": "Alerts On"
   },
   "email": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Send alerts by email. Empty keeps the account's setting.",
    "title": "Email"
   },
   "seats_together": {
    "anyOf": [
     {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Alert only when this many seats are open together, 2-6; 0 clears the rule.",
    "title": "Seats Together"
   },
   "text": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Send alerts by text message. Needs a verified phone on the SlickTrip account; empty keeps the account's setting.",
    "title": "Text"
   },
   "tracking_key": {
    "description": "The alert's tracking_key from list_tracked_seats.",
    "title": "Tracking Key",
    "type": "string"
   }
  },
  "required": [
   "tracking_key"
  ],
  "title": "update_seat_trackingArguments",
  "type": "object"
 },
 "name": "update_seat_tracking",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "alertMethod": {
    "description": "{email, text} if channels changed",
    "type": [
     "object",
     "null"
    ]
   },
   "alertPreference": {
    "description": "\"any\" (on) or \"none\" (off) if changed",
    "type": [
     "string",
     "null"
    ]
   },
   "code": {
    "description": "On an error: a machine-readable kind, e.g. unknown_place",
    "type": [
     "string",
     "null"
    ]
   },
   "field": {
    "description": "On unknown_place: which argument (origin, destination, ...)",
    "type": [
     "string",
     "null"
    ]
   },
   "message": {
    "description": "Error or sign-in message from the server wrapper",
    "type": [
     "string",
     "null"
    ]
   },
   "note": {
    "description": "Change seats via track_seats",
    "type": [
     "string",
     "null"
    ]
   },
   "places_assumed": {
    "description": "Place names this call resolved on its own, e.g. 'Portland = Portland, OR (PDX)'; tell the traveler",
    "type": [
     "array",
     "null"
    ]
   },
   "seatsTogether": {
    "description": "Seats-together count if changed",
    "type": [
     "number",
     "null"
    ]
   },
   "status": {
    "description": "updated | error | sign_in_required",
    "type": [
     "string",
     "null"
    ]
   },
   "suggestions": {
    "description": "On unknown_place: places to offer the traveler, each with code, name, kind (airport, all airports in the city, nearby airport), city, country",
    "type": [
     "array",
     "null"
    ]
   },
   "tracking_key": {
    "description": "The updated seat alert key",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
