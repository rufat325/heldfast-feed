 "description": "Place a saved competitor ad on a board as a media card (its video or image, the advertiser as title, the hook as caption) with its decoded brief attached when it has one. Costs no credits. Returns the whole board and the new card. SIGN-IN REQUIRED: connect this server with OAuth (the host prompts for it), or add an API key header \"Authorization: Bearer acd_live_\u2026\" created at https://aicontentdrop.com/settings/integrations.",
 "inputSchema": {
  "properties": {
   "ad_id": {
    "description": "A saved ad's id, from list_saved_ads or save_competitor_ad.",
    "type": "string"
   },
   "canvas_id": {
    "description": "The board id, from list_canvases or create_canvas.",
    "type": "string"
   },
   "revision": {
    "description": "The board revision this change is based on. Optional: when omitted the tool reads the current one first.",
    "type": "number"
   }
  },
  "required": [
   "ad_id",
   "canvas_id"
  ],
  "type": "object"
 },
