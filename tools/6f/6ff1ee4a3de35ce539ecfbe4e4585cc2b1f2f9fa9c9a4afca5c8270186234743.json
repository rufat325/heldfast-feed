{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Returns ordered fields, the Browser sort field (v1), card-template field usage, and a field-order revision hash for one Anki note type. Use this before creating notes or changing fields.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"modelName":{"description":"Anki note type name. AnkiConnect calls note types \"models\" in its API.","maxLength":500,"minLength":1,"type":"string"}},"required":["modelName"],"type":"object"},"name":"get-note-type-schema","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"noteType":{"additionalProperties":false,"properties":{"cardTemplates":{"items":{"additionalProperties":false,"properties":{"answerFields":{"items":{"type":"string"},"type":"array"},"name":{"type":"string"},"questionFields":{"items":{"type":"string"},"type":"array"}},"required":["name","questionFields","answerFields"],"type":"object"},"type":"array"},"fields":{"items":{"additionalProperties":false,"properties":{"name":{"type":"string"},"order":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["name","order"],"type":"object"},"type":"array"},"id":{"description":"Anki note type/model ID","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"name":{"description":"Anki note type/model name","type":"string"},"schemaHash":{"description":"SHA-256 hash of the ordered note-type field names","pattern":"^[a-f0-9]{64}$","type":"string"},"sortField":{"description":"Field used by the Anki Browser's Sort Field column; null in legacy mode.","type":["string","null"]}},"required":["id","name","fields","sortField","cardTemplates","schemaHash"],"type":"object"}},"required":["noteType"],"type":"object"},"title":"Get note type schema"}
