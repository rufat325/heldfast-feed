{
 "_meta": {
  "openai/outputTemplate": "ui://homejourney/ai-app-services-v1.html",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "resourceUri": "ui://homejourney/ai-app-services-v1.html",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://homejourney/ai-app-services-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Quote a Homejourney service booking"
 },
 "description": "Use this after search_services with the selected provider and package identifiers, or with price_source launch_guide and platform_unit_count for a Homejourney catalog price. Returns the exact server-revalidated price before confirmation and does not create a booking row. A catalog price also returns the assignment deadline, after which an unaccepted booking is cancelled at no charge.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "base_price": {
    "minimum": 0,
    "type": "number"
   },
   "catalog_version_id": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "customer_info": {
    "additionalProperties": false,
    "properties": {
     "address": {
      "maxLength": 300,
      "minLength": 5,
      "type": "string"
     },
     "delivery_address": {
      "maxLength": 300,
      "minLength": 5,
      "type": "string"
     },
     "delivery_unit_number": {
      "maxLength": 40,
      "type": "string"
     },
     "email": {
      "format": "email",
      "maxLength": 254,
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "minLength": 8,
      "type": "string"
     },
     "pickup_address": {
      "maxLength": 300,
      "minLength": 5,
      "type": "string"
     },
     "pickup_unit_number": {
      "maxLength": 40,
      "type": "string"
     },
     "unit_number": {
      "maxLength": 40,
      "type": "string"
     }
    },
    "required": [
     "name",
     "email",
     "phone"
    ],
    "type": "object"
   },
   "discount_amount": {
    "minimum": 0,
    "type": "number"
   },
   "issue_description": {
    "maxLength": 1000,
    "type": "string"
   },
   "number_of_units": {
    "default": 1,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "platform_unit_count": {
    "description": "The platformUnitCount of a launch_guide search result. Omit provider_id and provider_package_id with it.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "price_source": {
    "enum": [
     "provider_catalog",
     "launch_guide"
    ],
    "type": "string"
   },
   "provider_id": {
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   },
   "provider_package_id": {
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   },
   "scheduled_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "service_details": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "service_frequency": {
    "default": "one-time",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "service_type": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "singapore_time": {
    "description": "Exact customer-selected Singapore start time in 24-hour HH:mm format. Do not send a time range.",
    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
    "type": "string"
   },
   "special_instructions": {
    "maxLength": 1000,
    "type": "string"
   },
   "total_price": {
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "service_type",
   "service_details",
   "catalog_version_id",
   "price_source",
   "scheduled_date",
   "singapore_time",
   "customer_info"
  ],
  "type": "object"
 },
 "name": "quote_service_booking",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "assignmentDeadlineAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "basePrice": {
      "type": "number"
     },
     "bookingFee": {
      "type": "number"
     },
     "catalogVersionId": {
      "type": [
       "string",
       "null"
      ]
     },
     "collectionMode": {
      "enum": [
       "at_booking",
       "after_acceptance"
      ],
      "type": "string"
     },
     "currency": {
      "enum": [
       "SGD"
      ],
      "type": "string"
     },
     "discountAmount": {
      "type": "number"
     },
     "estimatedDurationMinutes": {
      "type": "integer"
     },
     "prerequisites": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "priceSource": {
      "enum": [
       "provider_catalog",
       "launch_guide"
      ],
      "type": "string"
     },
     "providerId": {
      "type": [
       "string",
       "null"
      ]
     },
     "providerLogoUrl": {
      "type": [
       "string",
       "null"
      ]
     },
     "providerName": {
      "type": [
       "string",
       "null"
      ]
     },
     "providerPackageId": {
      "type": [
       "string",
       "null"
      ]
     },
     "serviceId": {
      "type": "string"
     },
     "serviceSubtotal": {
      "type": "number"
     },
     "serviceType": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "totalAmount": {
      "type": "number"
     }
    },
    "required": [
     "serviceType",
     "serviceId",
     "title",
     "basePrice",
     "serviceSubtotal",
     "bookingFee",
     "discountAmount",
     "totalAmount",
     "currency",
     "estimatedDurationMinutes",
     "prerequisites",
     "providerId",
     "providerName",
     "providerLogoUrl",
     "providerPackageId",
     "catalogVersionId",
     "priceSource"
    ],
    "type": "object"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Quote a Homejourney service booking"
}
