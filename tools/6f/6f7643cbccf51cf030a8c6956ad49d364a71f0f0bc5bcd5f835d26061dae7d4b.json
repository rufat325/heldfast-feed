        ],
        "title": "image",
        "type": "object"
       }
      ]
     },
     "button": {
      "additionalProperties": false,
      "description": "Button style. When supplied, include variant, radius, and shadow.",
      "properties": {
       "radius": {
        "enum": [
         "sharp",
         "soft",
         "pill"
