     "accent_color": {
      "description": "CSS color: hex, rgb()/rgba(), hsl()/hsla(), or named color.",
      "type": "string"
     },
     "background": {
      "description": "Page background. If supplied, include the background type and its required fields.",
      "oneOf": [
       {
        "additionalProperties": false,
        "properties": {
         "color": {
          "description": "CSS color: hex, rgb()/rgba(), hsl()/hsla(), or named color.",
          "type": "string"
         },
         "filter": {
          "enum": [
           "none",
           "blur",
           "dim"
          ],
          "type": "string"
         },
         "type": {
          "enum": [
           "solid"
          ],
          "type": "string"
         }
        },
        "required": [
         "type",
         "color"
        ],
        "title": "solid",
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "angle": {
          "maximum": 360,
          "minimum": 0,
          "type": "number"
         },
         "filter": {
          "enum": [
           "none",
           "blur",
           "dim"
          ],
          "type": "string"
         },
         "from": {
          "description": "CSS color: hex, rgb()/rgba(), hsl()/hsla(), or named color.",
          "type": "string"
         },
         "to": {
          "description": "CSS color: hex, rgb()/rgba(), hsl()/hsla(), or named color.",
          "type": "string"
         },
         "type": {
          "enum": [
           "gradient"
          ],
          "type": "string"
         }
        },
        "required": [
         "type",
         "from",
         "to"
        ],
        "title": "gradient",
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "filter": {
          "enum": [
           "none",
           "blur",
           "dim"
          ],
          "type": "string"
         },
