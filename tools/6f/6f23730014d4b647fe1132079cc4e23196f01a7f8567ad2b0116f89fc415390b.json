{
 "description": "Find agents and MCP servers for a natural-language task. Filter by resource type, protocol, callability, health availability, authentication, capability evidence, skill, source, and freshness; paginate with page and limit. Returns ranked candidates with match reasons. Location, language, pricing, and side-effect metadata are not indexed yet and are reported in meta.unsupportedFilters. Unknown states never satisfy known-state filters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiVersion": {
    "const": "1",
    "type": "string"
   },
   "authentication": {
    "description": "Filter by authentication requirement; unknown metadata does not match none or required.",
    "enum": [
     "unknown",
     "none",
     "required"
    ],
    "type": "string"
   },
   "availability": {
    "description": "Require this latest health state; missing or stale checks are unknown.",
    "enum": [
     "unknown",
     "online",
     "degraded",
     "offline"
    ],
    "type": "string"
   },
   "callable": {
    "description": "Filter by direct endpoint callability.",
    "type": "boolean"
   },
   "freshness": {
    "description": "Require a catalog update timestamp within this many days.",
    "properties": {
     "withinDays": {
      "maximum": 3650,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "withinDays"
    ],
    "type": "object"
   },
   "language": {
    "description": "Match any listed language; currently not indexed.",
    "items": {
     "maxLength": 35,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "limit": {
    "description": "Results per page; defaults to 10.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "Filter by structured location metadata; currently not indexed.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "page": {
    "description": "One-based result page; defaults to 1.",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "pricing": {
    "description": "Filter by structured pricing metadata; currently not indexed.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "protocol": {
    "description": "Return only resources that support this protocol, such as a2a or mcp.",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   },
   "protocolVersions": {
    "additionalProperties": {
     "items": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 10,
     "minItems": 1,
     "type": "array"
    },
    "propertyNames": {
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "type": "object"
   },
   "protocols": {
    "items": {
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "requirements": {
    "properties": {
     "authentication": {
      "enum": [
       "unknown",
       "none",
       "required"
      ],
      "type": "string"
     },
     "availability": {
      "enum": [
       "unknown",
       "online",
       "degraded",
       "offline"
      ],
      "type": "string"
     },
     "callable": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "resourceType": {
    "description": "Return only this resource type.",
    "enum": [
     "agent",
     "mcp-server",
     "skill",
     "knowledge-resource",
     "gateway",
     "tool",
     "repository",
     "website",
     "documentation"
    ],
    "type": "string"
   },
   "resourceTypes": {
    "items": {
     "enum": [
      "agent",
      "mcp-server",
      "skill",
      "knowledge-resource",
      "gateway",
      "tool",
      "repository",
      "website",
      "documentation"
     ],
     "type": "string"
    },
    "maxItems": 9,
    "type": "array"
   },
   "sideEffects": {
    "description": "Require all listed side effects; currently not indexed.",
    "items": {
     "enum": [
      "read",
      "write",
      "delete",
      "purchase",
      "message",
      "execute",
      "external-side-effect"
     ],
     "type": "string"
    },
    "maxItems": 7,
    "type": "array"
   },
   "skill": {
    "description": "Filter agents by a declared skill ID, name, description, or tag.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "description": "Filter by exact catalog source, such as self-registered or official-registry.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "task": {
    "description": "Natural-language task used to rank relevant resources.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "trust": {
    "properties": {
     "minimumCapability": {
      "enum": [
       "detected",
       "claimed",
       "tested",
       "verified"
      ],
      "type": "string"
     },
     "minimumIdentity": {
      "enum": [
       "detected",
       "declared",
       "verified"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "verificationState": {
    "description": "Require an exact capability evidence state.",
    "enum": [
     "detected",
     "claimed",
     "tested",
     "verified"
    ],
    "type": "string"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "discover",
 "title": "Discover resources"
}
