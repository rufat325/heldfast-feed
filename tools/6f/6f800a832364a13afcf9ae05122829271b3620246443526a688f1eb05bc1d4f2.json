 "description": "Watch up to ten reviewed public pages in one call. Supply the previous text hashes and it returns which pages actually changed, not ten hashes for you to compare. Hashes both the raw HTML and the visible text, so markup churn can be told from a real content change. A page that cannot be fetched is named individually and does not fail the batch. Pay 60000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "baseline": {
    "description": "Optional map of url to the text_sha256 you last saw. Without it every page reports no_baseline.",
    "example": {
     "https://docs.python.org/3/": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    },
    "type": "object"
   },
   "urls": {
    "description": "Up to 10 URLs on reviewed public origins.",
    "example": [
     "https://docs.python.org/3/",
     "https://developer.mozilla.org/en-US/"
    ],
    "items": {
     "description": "HTTPS URL on a reviewed public origin. Permitted origins: https://docs.python.org, https://developer.mozilla.org, https://en.wikipedia.org, https://www.cisa.gov, https://www.sec.gov, https://home.treasury.gov, https://books.toscrape.com. robots.txt is honoured and redirects are refused.",
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "urls"
  ],
  "type": "object"
 },
