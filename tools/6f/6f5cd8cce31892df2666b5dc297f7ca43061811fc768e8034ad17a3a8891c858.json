{
 "description": "Set severity override for a memo. Defaults remain: fix=blocking, question/highlight=non_blocking.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "file": {
    "description": "Path to the annotated markdown file",
    "type": "string"
   },
   "memoId": {
    "description": "Memo ID to classify",
    "type": "string"
   },
   "severity": {
    "description": "Severity override",
    "enum": [
     "blocking",
     "non_blocking"
    ],
    "type": "string"
   }
  },
  "required": [
   "file",
   "memoId",
   "severity"
  ],
  "type": "object"
 },
 "name": "set_memo_severity"
}
