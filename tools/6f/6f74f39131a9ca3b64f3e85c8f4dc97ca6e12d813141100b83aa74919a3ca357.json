{
 "description": "Add a receiving wallet for a (cryptocurrency, network) pair. Pass `address` for a DIRECT_WALLET, or `xpub` (extended PUBLIC key) for an XPUB_WALLET. One wallet per pair.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Required for DIRECT_WALLET.",
    "type": "string"
   },
   "cryptocurrency": {
    "enum": [
     "BTC",
     "ETH",
     "USDT",
     "USDC",
     "BNB",
     "SHIB",
     "POL",
     "LTC",
     "DAI",
     "CRO",
     "TRX",
     "UNI"
    ],
    "type": "string"
   },
   "derivationPath": {
    "type": "string"
   },
   "isEnabled": {
    "type": "boolean"
   },
   "network": {
    "enum": [
     "BTC",
     "ETH",
     "BNB",
     "POL",
     "LTC",
     "CRO",
     "TRX"
    ],
    "type": "string"
   },
   "requiredConfirmations": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "walletType": {
    "enum": [
     "DIRECT_WALLET",
     "XPUB_WALLET"
    ],
    "type": "string"
   },
   "xpub": {
    "description": "Extended PUBLIC key \u2014 required for XPUB_WALLET (BTC/LTC).",
    "type": "string"
   }
  },
  "required": [
   "cryptocurrency",
   "network",
   "walletType"
  ],
  "type": "object"
 },
 "name": "create_wallet",
 "title": "Create wallet"
}
