{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Promotion"
 },
 "description": "Create a promotion / discount code. type=percentage or fixed_amount; value is the discount as a string (\"10\" = 10% or 10 currency units). Codes are uppercased server-side.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bookingEnabled": {
    "description": "Allow on bookings",
    "type": "boolean"
   },
   "code": {
    "description": "Coupon code customers enter at checkout (auto-uppercased)",
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "endsAt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "ISO datetime \u2014 when the promo expires"
   },
   "eventEnabled": {
    "description": "Allow on event registrations",
    "type": "boolean"
   },
   "maximumDiscount": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cap on percentage discounts, decimal string"
   },
   "minimumAmount": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum order amount required, decimal string"
   },
   "minimumQuantity": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum item count required"
   },
   "name": {
    "description": "Promotion name (internal)",
    "type": "string"
   },
   "onlineEnabled": {
    "description": "Allow on online shop orders",
    "type": "boolean"
   },
   "posEnabled": {
    "description": "Allow at POS",
    "type": "boolean"
   },
   "startsAt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "ISO datetime \u2014 when the promo becomes valid"
   },
   "status": {
    "description": "Default active",
    "enum": [
     "active",
     "inactive",
     "expired"
    ],
    "type": "string"
   },
   "type": {
    "description": "Default percentage",
    "enum": [
     "percentage",
     "fixed_amount"
    ],
    "type": "string"
   },
   "usageLimitPerCustomer": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Max uses per single customer"
   },
   "usageLimitTotal": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Max total uses across all customers"
   },
   "value": {
    "description": "Discount value as decimal string",
    "type": "string"
   }
  },
  "required": [
   "name",
   "code",
   "value"
  ],
  "type": "object"
 },
 "name": "create_promotion",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
