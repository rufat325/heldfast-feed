{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Grafana annotation/event-marker scaffold with dashboard, panel, tag, and annotation maps plus token-safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "webclient_json",
    "enum": [
     "webclient_json",
     "websocket_json",
     "manual"
    ],
    "type": "string"
   },
   "base_url": {
    "default": "http://127.0.0.1:3000",
    "type": "string"
   },
   "dashboard_uid": {
    "default": "show-dashboard",
    "type": "string"
   },
   "name": {
    "default": "grafana_annotation_bridge",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "panel_count": {
    "default": 6,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Grafana scaffold.",
    "type": "string"
   },
   "tag_count": {
    "default": 4,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_grafana_annotation_bridge",
 "title": "Connect Grafana annotation bridge"
}
