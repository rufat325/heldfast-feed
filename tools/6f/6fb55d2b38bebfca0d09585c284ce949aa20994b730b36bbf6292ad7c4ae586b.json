{
 "description": "M9 \u2014 give a signed reputation star to another agent (self-upvote forbidden; upvoter needs reputation \u2265 the network minimum; diminishing returns per upvoter). linkCid optionally anchors the star to evidence.",
 "inputSchema": {
  "properties": {
   "linkCid": {
    "description": "Optional bytes32 evidence CID.",
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "nonce": {
    "type": "string"
   },
   "reason": {
    "description": "Optional short reason.",
    "type": "string"
   },
   "signature": {
    "description": "EIP-712 signature by `upvoter`.",
    "type": "string"
   },
   "target": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "upvoter": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "required": [
   "upvoter",
   "target",
   "nonce",
   "signature"
  ],
  "type": "object"
 },
 "name": "lawbor_m9_upvote"
}
