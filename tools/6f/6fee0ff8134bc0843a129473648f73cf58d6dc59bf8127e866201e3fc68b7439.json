      "minLength": 1,
      "title": "Body",
      "type": "string"
     },
     "parent_entry_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Parent Entry Id"
     },
     "public": {
      "const": true,
      "default": true,
      "title": "Public",
      "type": "boolean"
     },
     "scheduling": {
