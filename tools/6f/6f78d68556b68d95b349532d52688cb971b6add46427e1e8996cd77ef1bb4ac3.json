{
 "_meta": {
  "opentrain.ai/authoring-retry": {
   "allowedRetryAction": "Repeat only the identical key and payload to recover the durable receipt; then inspect canonical readback. Never allocate a new key for an uncertain outcome.",
   "automaticRetry": false,
   "identityFields": [
    "folderId",
    "idempotencyKey",
    "exactRequestPayload"
   ],
   "inspect": [
    {
     "method": "GET",
     "path": "/api/public/v1/instructions/folders/{folderId}/pages"
    }
   ],
   "keyRequirement": "SAME_KEY_AND_PAYLOAD",
   "missingResourceBehavior": "UNKNOWN_NOT_SUCCESS",
   "policy": "DURABLE_RECEIPT",
   "schemaVersion": "folder-instruction-authoring-retry/1",
   "staleStateBehavior": "A key/payload conflict requires inspection, not a new identity or blind retry.",
   "stateActions": {
    "REPLAYED": "INSPECT_CANONICAL_READBACK",
    "UNCERTAIN": "SAME_KEY_AND_PAYLOAD",
    "UPLOAD_GRANT_NOT_REPLAYABLE": "INSPECT_SAME_ASSET_NEVER_REISSUE_GRANT"
   }
  }
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Upload at most 5 MiB of reviewed image bytes. Requires exact size/SHA256 from plan_image and confirmLive; no page edit is performed. Requires current employer folder access. Empty destinations require reviewed activation; published/unknown delivery writes refuse without changing release/read/ack flags. Requires instructions:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folderId": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "request": {
    "additionalProperties": false,
    "properties": {
     "base64": {
      "maxLength": 7000000,
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
     },
     "confirmLive": {
      "const": true,
      "type": "boolean"
     },
     "contentType": {
      "enum": [
       "image/jpeg",
       "image/png",
       "image/webp",
       "image/gif",
       "image/avif"
      ],
      "type": "string"
     },
     "fileName": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "idempotencyKey": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "sha256": {
      "pattern": "^[a-fA-F0-9]{64}$",
      "type": "string"
     },
     "sizeBytes": {
      "maximum": 5242880,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "fileName",
     "contentType",
     "sizeBytes",
     "sha256",
     "idempotencyKey",
     "base64",
     "confirmLive"
    ],
    "type": "object"
   }
  },
  "required": [
   "folderId",
   "request"
  ],
  "type": "object"
 },
 "name": "opentrain_folder_instructions_upload_image",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "canonicalSource": {
      "const": "FOLDER_INSTRUCTION_SET",
      "type": "string"
     },
     "contentType": {
      "$ref": "#/properties/result/properties/url"
     },
     "folderId": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "sizeBytes": {
      "minimum": 0,
      "type": "integer"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "canonicalSource",
     "folderId",
     "url",
     "contentType",
     "sizeBytes",
     "replayed"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
