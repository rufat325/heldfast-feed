{"_meta":{"securitySchemes":[{"scopes":["mcp:read","mcp:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Expire an owned, ready Email to Postcard quote using quoteId and confirmed:true so a new edited quote can be prepared. Requires a production workspace key and OAuth mcp:read/mcp:write permissions. Cannot change a paid, payment-pending, submitted or uncertain order. Invalidates the old quote's approval and requires fresh review; no payment or mailing.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"confirmed":{"const":true,"type":"boolean"},"quoteId":{"maxLength":50,"pattern":"^quote_[a-zA-Z0-9_-]+$","type":"string"}},"required":["quoteId","confirmed"],"type":"object"},"name":"revise_email_postcard_quote","outputSchema":{"additionalProperties":true,"description":"Read operation first for financial/mail state and recovery. Optional service fields are absent on failure. Unknown is not zero or permission to retry. Legacy service fields remain available.","properties":{"error":{"type":"string"},"operation":{"additionalProperties":false,"properties":{"amountCents":{"description":"USD cents. Null means not applicable or not known; never interpret null as zero.","type":["integer","null"]},"code":{"type":"string"},"currency":{"const":"USD"},"expiresAt":{"type":["string","null"]},"fundsState":{"enum":["none","reserved","debited","captured","credited","refunded","unknown","simulated"]},"mailingState":{"enum":["none","submitted","pending","unknown","simulated"]},"receiptId":{"type":["string","null"]},"recovery":{"additionalProperties":false,"properties":{"action":{"enum":["none","retry_same_request","check_existing_job","fresh_approval","requires_user_action"]},"instructions":{"type":"string"},"nextTool":{"type":["string","null"]},"safeToRetry":{"type":"boolean"}},"required":["action","safeToRetry","nextTool","instructions"],"type":"object"},"requestId":{"type":"string"},"status":{"enum":["succeeded","failed","pending","needs_review"]},"tool":{"type":"string"}},"required":["requestId","tool","status","code","amountCents","currency","expiresAt","receiptId","fundsState","mailingState","recovery"],"type":"object"},"quoteId":{"type":"string"},"requiresFreshApproval":{"type":"boolean"},"revised":{"type":"boolean"}},"required":["operation"],"type":"object"},"securitySchemes":[{"scopes":["mcp:read","mcp:write"],"type":"oauth2"}],"title":"Revise Email Postcard Quote"}
