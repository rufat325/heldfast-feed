{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store or revise an answer the user has explicitly approved. Identical retries keep the same revision. A changed answer requires expectedRevision from a previous read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "answer": {
    "maxLength": 8000,
    "minLength": 1,
    "type": "string"
   },
   "deskId": {
    "format": "uuid",
    "type": "string"
   },
   "expectedRevision": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "question": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "default": "APPROVED",
    "enum": [
     "APPROVED",
     "RETIRED"
    ],
    "type": "string"
   },
   "topic": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "deskId",
   "topic",
   "question",
   "answer"
  ],
  "type": "object"
 },
 "name": "save_approved_answer",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "save approved answer"
}
