{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Log Transaction Ledger"
 },
 "description": "Log a manual income, expense, or equity transaction. Supports confirm and idempotency validation.",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "The absolute transaction amount (positive finite number <= 10000000)",
    "type": "number"
   },
   "category": {
    "description": "Ledger category (e.g. Feed, Sales, Postage)",
    "type": "string"
   },
   "confirm": {
    "description": "Set to true to commit, false for dry-run preview",
    "type": "boolean"
   },
   "date": {
    "description": "Optional transaction date (YYYY-MM-DD)",
    "type": "string"
   },
   "description": {
    "description": "Optional descriptive note",
    "type": "string"
   },
   "farmId": {
    "description": "The unique farm ID",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Unique request idempotency key",
    "type": "string"
   },
   "type": {
    "description": "Income, Expense, or Equity",
    "enum": [
     "Income",
     "Expense",
     "Equity"
    ],
    "type": "string"
   }
  },
  "required": [
   "farmId",
   "type",
   "amount",
   "category"
  ],
  "type": "object"
 },
 "name": "log_manual_transaction"
}
