{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search APIs"
 },
 "description": "Search the Gatefare catalog for paid APIs by text, price, category, or sort order. Returns paginated results with publisher info.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Category slug",
    "type": "string"
   },
   "include_testnet": {
    "description": "Include testnet APIs",
    "type": "boolean"
   },
   "max_price": {
    "description": "Maximum price in USD",
    "minimum": 0,
    "type": "number"
   },
   "page": {
    "description": "Page number",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Full-text search query",
    "type": "string"
   },
   "sort": {
    "description": "Sort order",
    "enum": [
     "popular",
     "new",
     "price-asc"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "gatefare.search_apis"
}
