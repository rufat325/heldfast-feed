 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Change an access rule's value, or activate or deactivate it.\n\nA rule's type can't change; delete it and create a new one. Before\nactivating, confirm with the user that the IP rules cover every IP that\ncalls the node. Activating the first origin rule blocks every request\nwithout an Origin header (servers, scripts, curl), even from allowed IPs.\nChanging or deactivating a rule can block clients that only it allowed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "node_id": {
    "description": "Node ID (e.g., ND-123-456-789).",
    "type": "string"
   },
   "rule_id": {
    "description": "Rule ID from list_node_access_rules (e.g., NAR-123-456-789).",
    "type": "string"
   },
   "status": {
    "anyOf": [
     {
      "enum": [
       "activated",
       "deactivated"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "activated or deactivated."
   },
   "value": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "New value, in the format the rule's type needs (see\ncreate_node_access_rule)."
   }
  },
  "required": [
   "node_id",
   "rule_id"
  ],
  "type": "object"
 },
 "name": "update_node_access_rule",
 "outputSchema": {
  "properties": {
   "created": {
    "type": "boolean"
   },
   "message": {
    "type": "string"
   },
   "rule": {
    "properties": {
     "id": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "updated_at": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "type",
     "value",
     "status"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "rule",
   "message"
  ],
  "type": "object"
 }
