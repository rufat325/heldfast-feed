{
 "description": "Deploy a strategy as a trading bot. Defaults to paper trading for safety.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exchangeId": {
    "description": "Exchange account ID",
    "type": "string"
   },
   "leverage": {
    "default": 1,
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "live": {
    "default": false,
    "description": "If true, trades with real money. Defaults to paper.",
    "type": "boolean"
   },
   "name": {
    "type": "string"
   },
   "stopLoss": {
    "description": "Stop loss % (e.g. 5)",
    "type": "number"
   },
   "strategyId": {
    "description": "Strategy ID to deploy",
    "type": "string"
   },
   "symbol": {
    "default": "BTC/USDT",
    "type": "string"
   },
   "takeProfit": {
    "description": "Take profit % (e.g. 10)",
    "type": "number"
   }
  },
  "required": [
   "strategyId",
   "exchangeId"
  ],
  "type": "object"
 },
 "name": "deploy_bot"
}
