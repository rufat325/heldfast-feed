{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Romanian TV programs"
 },
 "description": "Search programs across all Romanian TV channels in the guide by free-text title, channel, category, and time window. Use for queries like \"documentaries on Discovery tomorrow\", \"football on Saturday\", \"what is on Antena 1 right now\". Time references accepted: now, tonight, tomorrow, weekend, primetime, today, YYYY-MM-DD, ISO instant, or ISO range \"A/B\".",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Channel category: Generaliste | \u0218tiri | Sport | Filme & Seriale | Documentare | Copii | Muzic\u0103 | Altele",
    "type": "string"
   },
   "channel": {
    "description": "Channel id, display name, or alias (e.g. \"PRO TV\", \"tv-pro-tv\", \"HBO\")",
    "type": "string"
   },
   "exclude_news": {
    "default": false,
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free text to match against program title (case/diacritic-insensitive)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "timeframe": {
    "default": "now",
    "description": "Natural time reference: now | tonight | tomorrow | weekend | primetime | today | YYYY-MM-DD | ISO instant | ISO range \"A/B\"",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tv_search_program",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asked_at_utc": {
    "type": "string"
   },
   "count": {
    "type": "number"
   },
   "generated_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "items": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "channel_category": {
       "type": [
        "string",
        "null"
       ]
      },
      "channel_id": {
       "type": "string"
      },
      "channel_name": {
       "type": "string"
      },
      "match_reason": {
       "type": "string"
      },
      "program": {
       "additionalProperties": true,
       "properties": {
        "category": {
         "type": [
          "string",
          "null"
         ]
        },
        "description": {
         "type": "string"
        },
        "duration_min": {
         "type": "number"
        },
        "start_local": {
         "type": "string"
        },
        "start_utc": {
         "type": "string"
        },
        "stop_local": {
         "type": "string"
        },
        "stop_utc": {
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "title",
        "start_local",
        "start_utc",
        "stop_local",
        "stop_utc",
        "duration_min"
       ],
       "type": "object"
      }
     },
     "required": [
      "channel_id",
      "channel_name",
      "program"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "timeframe_label": {
    "type": "string"
   },
   "window": {
    "additionalProperties": true,
    "properties": {
     "from_utc": {
      "type": "string"
     },
     "to_utc": {
      "type": "string"
     }
    },
    "required": [
     "from_utc",
     "to_utc"
    ],
    "type": "object"
   }
  },
  "required": [
   "asked_at_utc",
   "timeframe_label",
   "window",
   "count",
   "items"
  ],
  "type": "object"
 },
 "title": "Search Romanian TV programs"
}
