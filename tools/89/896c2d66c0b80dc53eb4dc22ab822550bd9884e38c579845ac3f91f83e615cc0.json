{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Order 2\u2013256 points from index 0 using planar or spherical kilometre distances. Exact only after completed Held\u2013Karp search (at most 13 points); otherwise bounded heuristics. Returns every leg and stop reason. No roads or traffic.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "metric": {
    "enum": [
     "euclidean_km",
     "great_circle_km"
    ],
    "type": "string"
   },
   "points": {
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "x": {
         "maximum": 1000000,
         "minimum": -1000000,
         "type": "number"
        },
        "y": {
         "maximum": 1000000,
         "minimum": -1000000,
         "type": "number"
        }
       },
       "required": [
        "x",
        "y"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "lat": {
         "maximum": 90,
         "minimum": -90,
         "type": "number"
        },
        "lon": {
         "maximum": 180,
         "minimum": -180,
         "type": "number"
        }
       },
       "required": [
        "lat",
        "lon"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 256,
    "minItems": 2,
    "type": "array"
   },
   "return_to_start": {
    "default": true,
    "type": "boolean"
   },
   "time_budget_ms": {
    "default": 1000,
    "maximum": 10000,
    "minimum": 100,
    "type": "integer"
   }
  },
  "required": [
   "metric",
   "points"
  ],
  "type": "object"
 },
 "name": "route_optimizer",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contract_version": {
    "const": "0.1.0",
    "type": "string"
   },
   "elapsed_ms": {
    "minimum": 0,
    "type": "number"
   },
   "exact": {
    "type": "boolean"
   },
   "greedy_reference_km": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "improvement_vs_greedy_pct": {
    "type": [
     "number",
     "null"
    ]
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "method": {
    "enum": [
     "held_karp_exact",
     "nearest_neighbor_2opt",
     "nearest_neighbor"
    ],
    "type": "string"
   },
   "metric": {
    "enum": [
     "euclidean_km",
     "great_circle_km"
    ],
    "type": "string"
   },
   "order": {
    "items": {
     "maximum": 255,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 256,
    "minItems": 2,
    "type": "array"
   },
   "points": {
    "maximum": 256,
    "minimum": 2,
    "type": "integer"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "client": {
      "additionalProperties": {},
      "properties": {
       "name": {
        "type": "string"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "version"
      ],
      "type": "object"
     },
     "identity_source": {
      "type": "string"
     },
     "model": {
      "type": "null"
     },
     "server": {
      "const": "scorecompute",
      "type": "string"
     },
     "tool": {
      "const": "route_optimizer",
      "type": "string"
     }
    },
    "required": [
     "tool",
     "server",
     "client",
     "identity_source",
     "model"
    ],
    "type": "object"
   },
   "return_to_start": {
    "type": "boolean"
   },
   "stop_reason": {
    "enum": [
     "exact_search_completed",
     "heuristic_converged",
     "time_budget_exhausted",
     "work_limit_exhausted"
    ],
    "type": "string"
   },
   "total_distance_km": {
    "minimum": 0,
    "type": "number"
   },
   "tour_legs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "distance_km": {
       "minimum": 0,
       "type": "number"
      },
      "from_index": {
       "maximum": 255,
       "minimum": 0,
       "type": "integer"
      },
      "to_index": {
       "maximum": 255,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "from_index",
      "to_index",
      "distance_km"
     ],
     "type": "object"
    },
    "maxItems": 256,
    "minItems": 1,
    "type": "array"
   },
   "unit": {
    "const": "km",
    "type": "string"
   },
   "upper_bound_km": {
    "minimum": 0,
    "type": "number"
   },
   "work_limit": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "work_units": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "contract_version",
   "metric",
   "unit",
   "points",
   "return_to_start",
   "order",
   "tour_legs",
   "total_distance_km",
   "upper_bound_km",
   "exact",
   "method",
   "stop_reason",
   "greedy_reference_km",
   "improvement_vs_greedy_pct",
   "work_units",
   "work_limit",
   "elapsed_ms",
   "limitations",
   "provenance"
  ],
  "type": "object"
 }
}
