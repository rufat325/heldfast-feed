{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "AI assistant traffic"
 },
 "description": "Return AI-assistant traffic using dashboard_ai_referred. By default, mode='referred' uses the site's calendar month to date and compares with the prior month through the same calendar day (clamped to the prior month's last day). Pass start_date and end_date together for another inclusive calendar range in the site's analysis timezone; optionally pass compare_start_date and compare_end_date. If comparison dates are omitted, the immediately preceding equal-length range is used. mode='gaps' is STOPPED and returns only its stopped notice. site_id is optional when OAuth-authenticated. Scope is clicked citations only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compare_end_date": {
    "$ref": "#/properties/start_date"
   },
   "compare_start_date": {
    "$ref": "#/properties/start_date"
   },
   "end_date": {
    "$ref": "#/properties/start_date"
   },
   "limit": {
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "default": "referred",
    "enum": [
     "referred",
     "gaps"
    ],
    "type": "string"
   },
   "site_id": {
    "format": "uuid",
    "type": "string"
   },
   "start_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_ai_traffic",
