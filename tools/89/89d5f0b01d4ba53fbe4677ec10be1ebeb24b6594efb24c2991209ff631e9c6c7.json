      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "days": {
        "type": "number"
       },
       "end": {
        "type": "string"
       },
       "start": {
        "type": "string"
       }
      },
      "required": [
       "start",
       "end",
       "days"
      ],
      "type": "object"
     }
