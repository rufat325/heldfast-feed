         "comparison",
         "calendar_range"
        ],
        "type": "string"
       }
      },
      "required": [
       "start",
       "end",
       "days",
       "reference_start_at",
       "reference_end_at",
       "window_type",
       "reference_bounds",
       "timezone",
       "duration_hours",
       "calendar_dates_touched",
       "source_alignment",
       "source_boundaries"
