        "const": "start_inclusive_end_exclusive",
        "type": "string"
       },
       "reference_end_at": {
        "format": "date-time",
        "type": "string"
       },
       "reference_start_at": {
        "format": "date-time",
        "type": "string"
       },
       "source_alignment": {
        "enum": [
         "exact",
         "mixed"
        ],
        "type": "string"
       },
