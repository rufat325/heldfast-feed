{
 "description": "Create a new image from text prompt, JSON prompt, or both. Supports presets for common asset types (ads, web, social).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aspect_ratio": {
    "description": "Aspect ratio override (e.g., '16:9', '1:1')",
    "type": "string"
   },
   "enable_search_grounding": {
    "default": false,
    "description": "Use Google Search for real-world accuracy",
    "type": "boolean"
   },
   "image_size": {
    "description": "Output resolution",
    "enum": [
     "1K",
     "2K",
     "4K"
    ],
    "type": "string"
   },
   "model": {
    "default": "flash",
    "description": "Model: flash (fast) or pro (best quality)",
    "enum": [
     "flash",
     "pro"
    ],
    "type": "string"
   },
   "output_name": {
    "description": "Custom filename without extension",
    "type": "string"
   },
   "preset": {
    "description": "Preset name (e.g., 'facebook_ad', 'hero_image')",
    "type": "string"
   },
   "prompt": {
    "description": "Natural language description OR stringified JSON prompt",
    "type": "string"
   },
   "prompt_format": {
    "default": "text",
    "description": "Whether prompt is plain text or structured JSON",
    "enum": [
     "text",
     "json"
    ],
    "type": "string"
   },
   "reference_images": {
    "description": "File paths to reference images",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "generate_image",
 "title": "Generate Image"
}
