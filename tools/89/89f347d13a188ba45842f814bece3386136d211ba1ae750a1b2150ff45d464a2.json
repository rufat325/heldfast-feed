{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Discuss inspected work"
 },
 "description": "Creates, replies to, resolves or reopens a discussion on inspected text, a drawing object or the whole document.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "action": {
    "enum": [
     "create",
     "reply",
     "resolve",
     "reopen"
    ],
    "type": "string"
   },
   "agent": {
    "description": "This assistant's display name.",
    "type": "string"
   },
   "anchor": {
    "enum": [
     "document",
     "text",
     "image",
     "drawing"
    ],
    "type": "string"
   },
   "context_handle": {
    "maxLength": 128,
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "object_id": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "operation_id": {
    "description": "Optional retry identity scoped to this principal, connection and document. An unchanged mutation replays its original result for 24 hours, even after later edits; its expired identity never executes again. A read replays while its receipt is retained; after 256 later reads it executes afresh. Reusing an identity with changed arguments refuses. Visual observations are fresh. Inspect before starting another operation. Calls without it never replay.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "recipient": {
    "maxLength": 64,
    "type": "string"
   },
   "text": {
    "maxLength": 4096,
    "type": "string"
   },
   "thread_id": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "document",
   "action"
  ],
  "type": "object"
 },
 "name": "document.comment",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "changeId": {
    "maxLength": 128,
    "type": [
     "string",
     "null"
    ]
   },
   "collaboration": {
    "additionalProperties": true,
    "type": "object"
   },
   "contribution": {
    "description": "The purpose of these changes. Words and pictures with this name form one contribution, kept or dropped together.",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "drawingPatch": {
    "additionalProperties": true,
    "type": "object"
   },
   "drawingReceipt": {
    "additionalProperties": true,
    "type": "object"
   },
   "editCount": {
    "minimum": 0,
    "type": "integer"
   },
   "messageId": {
    "maxLength": 128,
    "type": "string"
   },
   "outcome": {
    "enum": [
     "applied",
     "unchanged",
     "target_gone",
     "conflict",
     "yielded",
     "pending",
     "invalid",
     "refused",
     "uncertain",
     "replayed"
    ],
    "type": "string"
   },
   "pending": {
    "additionalProperties": true,
    "properties": {
     "kind": {
      "enum": [
       "surface-fact",
       "human-review"
      ]
     },
     "proposalId": {
      "maxLength": 128,
      "type": "string"
     },
     "requestId": {
      "maxLength": 128,
      "type": "string"
     },
     "requirements": {
      "additionalProperties": true,
      "type": "object"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "reason": {
    "type": "string"
   },
   "receipt": {
    "additionalProperties": true,
    "type": "object"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   },
   "structure": {
    "additionalProperties": true,
    "type": "object"
   },
   "threadId": {
    "maxLength": 128,
    "type": "string"
   },
   "transaction": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Discuss inspected work"
}
