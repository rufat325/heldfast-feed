{
 "annotations": {
  "destructiveHint": true
 },
 "description": "Delete facts by ID, tags, age, or verification status",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ids": {
    "items": {
     "exclusiveMinimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "olderThan": {
    "format": "date-time",
    "type": "string"
   },
   "soft": {
    "default": false,
    "description": "If true, soft delete (set deletedAt) instead of hard delete",
    "type": "boolean"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "unverifiedOnly": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "delete_facts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deleted": {
    "description": "Number of facts deleted",
    "type": "number"
   },
   "success": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "deleted"
  ],
  "type": "object"
 },
 "title": "Delete Facts"
}
