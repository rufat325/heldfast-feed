{
 "_meta": {
  "openai/outputTemplate": "ui://etherscan/explorer-dashboard-v6.html",
  "openai/toolInvocation/invoked": "Etherscan view ready",
  "openai/toolInvocation/invoking": "Preparing Etherscan view\u2026",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://etherscan/explorer-dashboard-v6.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Present exact facts returned by Etherscan data tools in a fast explorer-style card. Call the relevant Etherscan data tool first and copy only supported values into this tool. Never invent scores, risk labels, historical prices, forecasts, or audit conclusions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "maxLength": 80,
    "type": "string"
   },
   "chart": {
    "additionalProperties": false,
    "properties": {
     "endLabel": {
      "maxLength": 40,
      "type": "string"
     },
     "points": {
      "items": {
       "type": "number"
      },
      "maxItems": 40,
      "minItems": 2,
      "type": "array"
     },
     "startLabel": {
      "maxLength": 40,
      "type": "string"
     },
     "title": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "title",
     "points"
    ],
    "type": "object"
   },
   "explorerUrl": {
    "format": "uri",
    "type": "string"
   },
   "footer": {
    "maxLength": 240,
    "type": "string"
   },
   "items": {
    "default": [],
    "items": {
     "$ref": "#/properties/metrics/items"
    },
    "maxItems": 12,
    "type": "array"
   },
   "metrics": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "maxLength": 300,
       "type": "string"
      },
      "label": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "value": {
       "maxLength": 240,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "label",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 6,
    "type": "array"
   },
   "sections": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "items": {
       "items": {
        "$ref": "#/properties/metrics/items"
       },
       "maxItems": 12,
       "type": "array"
      },
      "layout": {
       "default": "rows",
       "enum": [
        "cards",
        "rows",
        "chips"
       ],
       "type": "string"
      },
      "title": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "title",
      "items"
     ],
     "type": "object"
    },
    "maxItems": 4,
    "type": "array"
   },
   "subtitle": {
    "maxLength": 180,
    "type": "string"
   },
   "title": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "view": {
    "description": "The factual Etherscan result category to display.",
    "enum": [
     "wallet",
     "token",
     "transaction",
     "contract",
     "gas",
     "general"
    ],
    "type": "string"
   }
  },
  "required": [
   "view",
   "title"
  ],
  "type": "object"
 },
 "name": "render_etherscan_widget",
