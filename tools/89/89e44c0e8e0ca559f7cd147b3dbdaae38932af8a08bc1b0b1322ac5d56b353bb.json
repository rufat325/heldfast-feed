{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "grading:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Score submission"
 },
 "description": "Sets the teacher's score on sections of one submission (submission item ids), optionally with written feedback. Works in any scoring mode. Says whether the student sees it yet; to undo, set the sections back to the previous scores this returns.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "description": "Assignment id from list_coursework or list_submissions_to_review.",
    "pattern": "^[a-f\\d]{24}$",
    "type": "string"
   },
   "itemFeedback": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "itemId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "text": {
       "maxLength": 10000,
       "type": "string"
      }
     },
     "required": [
      "itemId",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "itemScores": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "itemId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "points": {
       "maximum": 500,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "itemId",
      "points"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "overallFeedback": {
    "maxLength": 10000,
    "type": "string"
   },
   "submissionId": {
    "description": "Submission id from list_submissions_to_review.",
    "pattern": "^[a-f\\d]{24}$",
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "submissionId",
   "itemScores"
  ],
  "type": "object"
 },
 "name": "score_submission",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "grading:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Score submission"
}
