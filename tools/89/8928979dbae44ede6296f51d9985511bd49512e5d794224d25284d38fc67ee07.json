{
 "description": "Get one live ParaSwap aggregate route for a supported pair. Returns expected output and route components; no independent venue comparison. Costs 0.002 USDC per call (x402 micropayment on Base).",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "Amount to swap (e.g. \"1.5\" for 1.5 ETH)",
    "type": "string"
   },
   "chain": {
    "description": "Chain to query (e.g. \"ethereum\", \"base\", \"arbitrum\"). Defaults to \"ethereum\".",
    "type": "string"
   },
   "from": {
    "description": "Input token symbol or address (e.g. \"ETH\", \"USDC\", \"0x...\")",
    "type": "string"
   },
   "to": {
    "description": "Output token symbol or address (e.g. \"USDC\", \"DAI\", \"0x...\")",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to",
   "amount"
  ],
  "type": "object"
 },
 "name": "get_dex_quotes"
}
