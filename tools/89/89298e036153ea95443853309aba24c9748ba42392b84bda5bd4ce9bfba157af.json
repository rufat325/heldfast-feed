{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Save Model"
 },
 "description": "Create or update a model definition. Changes are auto-committed to git \u2014 do NOT manually edit .contentrain/ files after calling this tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content_path": {
    "description": "Framework-relative path for content files (e.g. \"content/blog\", \"locales\"). When set, content is written here instead of .contentrain/content/",
    "type": "string"
   },
   "description": {
    "description": "Model description",
    "type": "string"
   },
   "domain": {
    "description": "Content domain (e.g. \"blog\", \"marketing\", \"system\")",
    "type": "string"
   },
   "fields": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "accept": {
       "type": "string"
      },
      "default": {},
      "description": {
       "type": "string"
      },
      "fields": {
       "additionalProperties": {},
       "type": "object"
      },
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "additionalProperties": {},
         "type": "object"
        }
       ]
      },
      "label": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "additionalProperties": {
          "type": "string"
         },
         "type": "object"
        }
       ],
       "description": "Editor label. A string is one label for all locales; an object keyed by locale carries a translation each."
      },
      "max": {
       "type": "number"
      },
      "maxSize": {
       "type": "number"
      },
      "min": {
       "type": "number"
      },
      "model": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       ]
      },
      "options": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "order": {
       "description": "Display position, ascending. Fields without one sort last, alphabetically. Fractional values allowed.",
       "type": "number"
      },
      "pattern": {
       "type": "string"
      },
      "required": {
       "type": "boolean"
      },
      "type": {
       "description": "Field type from the 27-type catalog",
       "enum": [
        "string",
        "text",
        "email",
        "url",
        "slug",
        "color",
        "phone",
        "code",
        "icon",
        "markdown",
        "richtext",
        "number",
        "integer",
        "decimal",
        "percent",
        "rating",
        "boolean",
        "date",
        "datetime",
        "image",
        "video",
        "file",
        "relation",
        "relations",
        "select",
        "array",
        "object"
       ],
       "type": "string"
      },
      "unique": {
       "type": "boolean"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "description": "Field definitions (not needed for dictionary)",
    "type": "object"
   },
   "i18n": {
    "description": "Whether this model supports localization",
    "type": "boolean"
   },
   "id": {
    "description": "Model ID (kebab-case, e.g. \"blog-post\")",
    "type": "string"
   },
   "kind": {
    "description": "Model kind",
    "enum": [
     "singleton",
     "collection",
     "document",
     "dictionary"
    ],
    "type": "string"
   },
   "locale_strategy": {
    "description": "How locale is encoded in file names. Default: \"file\"",
    "enum": [
     "file",
     "suffix",
     "directory",
     "none"
    ],
    "type": "string"
   },
   "locales": {
    "description": "The project locales this model's content covers \u2014 a subset of config.locales.supported. Omit it (the default) and the model covers every supported locale, which is what validation checks parity against. Declare it only when the content genuinely exists in a subset, e.g. a partially-translated site.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Human-readable name",
    "type": "string"
   },
   "title_field": {
    "description": "Name of the field shown as an entry's title in listings, pickers and relation references. Must name a field on this model whose type is string, text, slug, email, url, code, markdown or richtext. Dictionary models have no fields \u2014 use \"key\".",
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "kind",
   "domain",
   "i18n",
   "title_field"
  ],
  "type": "object"
 },
 "name": "contentrain_model_save"
}
