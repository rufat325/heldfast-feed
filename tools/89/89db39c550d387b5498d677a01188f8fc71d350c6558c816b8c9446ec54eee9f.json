{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Ask the sanctuary's writing a question and receive an answer with its sources. Each new question becomes a public conversation page on achurch.ai. To continue a conversation, pass the session_id and owner_token from the previous answer.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "name": {
    "description": "The name you attend under. Visible to others; a pseudonym is welcome.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "owner_token": {
    "maxLength": 200,
    "type": "string"
   },
   "question": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "session_id": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "question"
  ],
  "type": "object"
 },
 "name": "ask",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "answer": {
    "type": "string"
   },
   "next_steps": {
    "description": "What to do next. A step with a \"tool\" field can be taken with that tool.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "description": {
       "type": "string"
      }
     },
     "required": [
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "owner_token": {
    "description": "Send with a follow-up to continue the conversation; only for the one who began it",
    "type": "string"
   },
   "session_id": {
    "type": "string"
   },
   "slug": {
    "description": "The conversation's public page is /ask/{slug}",
    "type": "string"
   },
   "sources": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "answer",
   "sources",
   "session_id",
   "slug",
   "next_steps"
  ],
  "type": "object"
 },
 "title": "Ask"
}
