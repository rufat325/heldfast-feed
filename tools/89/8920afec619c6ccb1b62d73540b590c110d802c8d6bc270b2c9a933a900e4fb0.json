{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Cloud DB for Cache (Redis/Valkey) instance. Use dryRun=true to preview without creating.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backupFileRetentionPeriod": {
    "description": "Backup retention period in days (1-30)",
    "type": "number"
   },
   "backupTime": {
    "description": "Backup time (HH:mm format)",
    "type": "string"
   },
   "cloudCacheConfigGroupNo": {
    "description": "Config group number to apply",
    "type": "string"
   },
   "cloudCacheImageProductCode": {
    "description": "Cache image product code (Redis/Valkey version)",
    "type": "string"
   },
   "cloudCachePort": {
    "description": "Cache port number (default: 6379)",
    "type": "number"
   },
   "cloudCacheProductCode": {
    "description": "Cache server product (spec) code",
    "type": "string"
   },
   "cloudCacheServerNamePrefix": {
    "description": "Server name prefix",
    "type": "string"
   },
   "cloudCacheServiceName": {
    "description": "Cache service name (3-20 chars, lowercase letters and numbers)",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns a preview without actually creating the instance",
    "type": "boolean"
   },
   "isAutomaticFailover": {
    "description": "Whether to enable automatic failover",
    "type": "boolean"
   },
   "isBackup": {
    "description": "Whether to enable automatic backup",
    "type": "boolean"
   },
   "shardCopyCount": {
    "description": "Number of replicas per shard",
    "type": "number"
   },
   "shardCount": {
    "description": "Number of shards (for cluster mode)",
    "type": "number"
   },
   "subnetNo": {
    "description": "Subnet number",
    "type": "string"
   },
   "vpcNo": {
    "description": "VPC number",
    "type": "string"
   }
  },
  "required": [
   "cloudCacheServiceName",
   "vpcNo",
   "subnetNo"
  ],
  "type": "object"
 },
 "name": "ncloud_create_cache_instance"
}
