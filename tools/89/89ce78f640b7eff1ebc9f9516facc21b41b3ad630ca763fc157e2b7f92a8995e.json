{
 "_meta": {
  "openai/outputTemplate": "ui://widget/print-quote-card-v1.html",
  "openai/toolInvocation/invoked": "Quote ready",
  "openai/toolInvocation/invoking": "Getting the file and pricing it",
  "ui": {
   "resourceUri": "ui://widget/print-quote-card-v1.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use this when someone shares a link to a 3D model, such as a model page on Thingiverse or Printables or a direct link to an STL, 3MF, STEP or OBJ file, and wants a quote to have it printed and shipped by 3D Printer on Demand. It reads the model's licence where the site publishes one, gets the file, checks that it can be printed, saves the quote, and returns the estimate with a private link that opens the saved quote on our website. When the link offers several files, it lists them to pick from. Links that are not model pages with a licence need the person to confirm they have the right to print the file.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color": {
    "description": "Color name for the chosen material. Default is the material's first color.",
    "maxLength": 40,
    "type": "string"
   },
   "file_key": {
    "description": "The file_key of one file from an earlier answer that listed several files for this link.",
    "maxLength": 16,
    "type": "string"
   },
   "link": {
    "description": "The link to the model page or to the file, starting with https.",
    "maxLength": 2048,
    "type": "string"
   },
   "material": {
    "default": "petg",
    "description": "Material id, one of the listed values. Default petg.",
    "enum": [
     "petg",
     "pla",
     "abs",
     "pa-cf",
     "petg-cf",
     "opm",
     "tpu"
    ],
    "type": "string"
   },
   "part_description": {
    "description": "What the user says this part is or what it is for, in their own words, if they said. Leave out if they did not.",
    "maxLength": 500,
    "type": "string"
   },
   "quantity": {
    "default": 1,
    "description": "How many copies of the part.",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "rights_confirmed": {
    "description": "True only when the person has said they own this file or have the right to have it printed. Leave out otherwise.",
    "type": "boolean"
   }
  },
  "required": [
   "link"
  ],
  "type": "object"
 },
 "name": "quote_from_link",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color": {
    "type": "string"
   },
   "currency": {
    "const": "USD",
    "type": "string"
   },
   "file_name": {
    "type": "string"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "file_key": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "stl",
        "3mf",
        "obj",
        "step"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "size_mb": {
       "type": "number"
      }
     },
     "required": [
      "file_key",
      "name",
      "kind"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "material": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "multi_color": {
    "type": "boolean"
   },
   "next_step": {
    "type": "string"
   },
   "order_fee_usd": {
    "type": "number"
   },
   "outcome": {
    "enum": [
     "instant",
     "needs_upload",
     "needs_review",
     "not_accepted",
     "invalid_choice",
     "try_later",
     "needs_rights",
     "choose_file"
    ],
    "type": "string"
   },
   "price_held_days": {
    "type": "number"
   },
   "price_per_part_usd": {
    "type": "number"
   },
   "print_fit_notes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "quantity": {
    "type": "number"
   },
   "quote_url": {
    "type": "string"
   },
   "review_url": {
    "type": "string"
   },
   "shipping_usd": {
    "type": "number"
   },
   "size_mm": {
    "additionalProperties": false,
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y",
     "z"
    ],
    "type": "object"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "credit": {
      "type": "string"
     },
     "licence": {
      "type": "string"
     },
     "rights": {
      "enum": [
       "licence",
       "customer"
      ],
      "type": "string"
     },
     "source_type": {
      "enum": [
       "repo",
       "direct",
       "page"
      ],
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "source_type",
     "rights"
    ],
    "type": "object"
   },
   "subtotal_usd": {
    "type": "number"
   },
   "total_usd": {
    "type": "number"
   },
   "upload_url": {
    "type": "string"
   },
   "valid_colors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "valid_materials": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "outcome",
   "message"
  ],
  "type": "object"
 },
 "title": "Quote a 3D print from a link"
}
