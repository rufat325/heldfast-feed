   },
   "skills": {
    "description": "Key skills / technologies, e.g. [\"python\",\"llm\",\"rag\"]",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "skills"
  ],
  "type": "object"
 },
 "name": "match_profile",
 "title": "Match profile (alias of match_jobs)"
}
