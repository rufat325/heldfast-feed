  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Backward-compatible alias of match_jobs: skills[] (+ role_hint, remote_only, limit) \u2192 ranked verified roles with fit explanation.",
 "execution": {
