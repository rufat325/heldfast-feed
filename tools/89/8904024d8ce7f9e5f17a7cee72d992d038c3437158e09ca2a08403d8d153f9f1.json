  "title": "Check textile restricted substances and labelling (ZDHC, OEKO-TEX, REACH)"
 },
 "description": "Checks whether a substance is restricted in textiles, clothing, footwear or leather and what limit applies under a brand or certification list, and what a textile fibre, care or flammability label must show. Substance lists: the ZDHC MRSL, OEKO-TEX Standard 100 limit values by product class, the bluesign system substances list, REACH Annex XVII entries that apply to textiles and leather (for example entry 72 on CMR substances in clothing), the EU Ecolabel textile criteria, and Japanese household goods limits (formaldehyde). Labelling: the EU textile fibre names Regulation (EU) No 1007/2011, the US Textile Fiber Products Identification Act (16 CFR 303), the FTC care labeling rule (16 CFR 423) and wool and fur rules, the Canadian Textile Labelling Act, and US flammability standards (16 CFR 1610, 1611, 1615, 1616). Give substances or a topic. Not intended for general chemical status outside textiles (`regaffairs_check_chemical_substance` covers that).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "jurisdictions": {
    "items": {
     "enum": [
      "EU",
      "US",
      "CA",
      "JP",
      "INTL"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "lists": {
    "description": "Default: all.",
    "items": {
     "enum": [
      "zdhc_mrsl",
      "oeko_tex_100",
      "bluesign",
      "reach_annex_xvii",
      "eu_ecolabel",
      "jp_household_goods"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "product_class": {
    "description": "OEKO-TEX product class I to IV.",
    "enum": [
     "baby",
     "skin_contact",
     "no_skin_contact",
     "decoration"
    ],
    "type": "string"
   },
   "substances": {
    "description": "Names, CAS numbers or substance groups, e.g. 'APEOs', 'PFAS', 'azo dyes', '117-81-7'. Give substances or topic.",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "topic": {
    "description": "What to check. Give substances or topic; substances without a topic are checked as restricted_substances.",
    "enum": [
     "restricted_substances",
     "fibre_content_label",
     "care_label",
     "flammability"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
