{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Edit scheduled event"
 },
 "description": "Update a scheduled event; only provided fields change. Use the status field to start ('ACTIVE'), end ('COMPLETED'), or cancel ('CANCELED') an event; Discord only allows certain status transitions. Requires the Manage Events permission.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channel_id": {
    "description": "New voice/stage channel ID (snowflake) for VOICE/STAGE_INSTANCE events.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "description": {
    "description": "New event description (max 1000 characters).",
    "type": "string"
   },
   "event_id": {
    "description": "ID (snowflake) of the event to edit.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "guild_id": {
    "description": "Discord server (guild) ID (snowflake).",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "image": {
    "description": "New cover image URL.",
    "format": "uri",
    "pattern": "^https?://",
    "type": "string"
   },
   "location": {
    "description": "New free-text location for EXTERNAL events.",
    "type": "string"
   },
   "name": {
    "description": "New event name (max 100 characters).",
    "type": "string"
   },
   "scheduled_end_time": {
    "description": "New end time as an ISO 8601 datetime.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "scheduled_start_time": {
    "description": "New start time as an ISO 8601 datetime.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "status": {
    "description": "Change event status. Allowed transitions only: SCHEDULED\u2192ACTIVE\u2192COMPLETED, or SCHEDULED\u2192CANCELED (no transition back to SCHEDULED exists).",
    "enum": [
     "ACTIVE",
     "COMPLETED",
     "CANCELED"
    ],
    "type": "string"
   }
  },
  "required": [
   "guild_id",
   "event_id"
  ],
  "type": "object"
 },
 "name": "discord_edit_scheduled_event"
}
