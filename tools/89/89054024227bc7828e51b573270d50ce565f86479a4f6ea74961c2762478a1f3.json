{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Langit gradien, paparan (tone mapping ACES), bayangan, dan kabut. Paparan adalah pengatur terang yang BENAR di alur kerja PBR \u2014 menaikkan kekuatan cahaya untuk membuat gambar lebih terang akan merusak pantulan dan bayangannya.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bayangan": {
    "type": "boolean"
   },
   "kabut_dekat": {
    "minimum": 0,
    "type": "number"
   },
   "kabut_jauh": {
    "minimum": 0,
    "type": "number"
   },
   "kabut_mati": {
    "default": false,
    "type": "boolean"
   },
   "kabut_warna": {
    "pattern": "^#[0-9a-fA-F]{6}$",
    "type": "string"
   },
   "langit_atas": {
    "pattern": "^#[0-9a-fA-F]{6}$",
    "type": "string"
   },
   "langit_bawah": {
    "pattern": "^#[0-9a-fA-F]{6}$",
    "type": "string"
   },
   "paparan": {
    "maximum": 8,
    "minimum": 0.05,
    "type": "number"
   },
   "ruang": {
    "default": "utama",
    "description": "Nama ruang kerja; tiap ruang punya adegan.blend sendiri.",
    "pattern": "^[A-Za-z0-9._-]{1,64}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "rupa_adegan_lingkungan"
}
