{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Compare two canonical Evidence v2 bundles by exact record membership, explicit one-to-one observation pairs, and complete residual-unknown revision histories. Missing bundle members describe omission only, never behavioral equivalence; output is digest-anchored and deterministically paginated.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
   {
    "left_bundle_path": "/approved/left-evidence.json",
    "limit": 100,
    "offset": 0,
    "record_pairs": [],
    "right_bundle_path": "/approved/right-evidence.json"
   }
  ],
  "properties": {
   "left_bundle_path": {
    "description": "Local filesystem path for left bundle.",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Maximum number of results to return in this page.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Zero-based index of the first result to return.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "record_pairs": {
    "default": [],
    "description": "Value for record pairs.",
    "items": {
     "properties": {
      "left_evidence_id": {
       "description": "Exact Evidence v2 identifier for the left observation.",
       "pattern": "^ev_[a-f0-9]{64}$",
       "type": "string"
      },
      "right_evidence_id": {
       "description": "Exact Evidence v2 identifier for the right observation.",
       "pattern": "^ev_[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "left_evidence_id",
      "right_evidence_id"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "type": "array"
   },
   "right_bundle_path": {
    "description": "Local filesystem path for right bundle.",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "left_bundle_path",
   "right_bundle_path"
  ],
  "type": "object"
 },
 "name": "compare_bundles",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "changes": {
      "additionalProperties": false,
      "properties": {
       "items": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "classification": {
           "enum": [
            "added",
            "removed",
            "changed",
            "unknown",
            "history_advanced",
            "history_diverged"
           ],
           "type": "string"
          },
          "conclusion_kind": {
           "enum": [
            "observed_change",
            "contradiction",
            "unresolved_branch"
           ],
           "type": "string"
          },
          "entity": {
           "enum": [
            "evidence",
            "residual_unknown"
           ],
           "type": "string"
          },
          "key": {
           "minLength": 1,
           "type": "string"
          },
          "left_digest": {
           "anyOf": [
            {
             "pattern": "^[a-f0-9]{64}$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "left_evidence_ids": {
           "items": {
            "pattern": "^ev_[a-f0-9]{64}$",
            "type": "string"
           },
           "type": "array"
          },
          "limitations": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "right_digest": {
           "anyOf": [
            {
             "pattern": "^[a-f0-9]{64}$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "right_evidence_ids": {
           "items": {
            "pattern": "^ev_[a-f0-9]{64}$",
            "type": "string"
           },
           "type": "array"
          }
         },
         "required": [
          "entity",
          "key",
          "classification",
          "conclusion_kind",
          "left_evidence_ids",
          "right_evidence_ids",
          "left_digest",
          "right_digest",
          "limitations"
         ],
         "type": "object"
        },
        "maxItems": 500,
        "type": "array"
       },
       "limit": {
        "maximum": 500,
        "minimum": 1,
        "type": "integer"
       },
       "next_offset": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "offset": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "total": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "items",
       "offset",
       "limit",
       "total",
       "next_offset"
      ],
      "type": "object"
     },
     "left_bundle_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "limitations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "right_bundle_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "status": {
      "enum": [
       "unchanged",
       "changed",
       "unknown"
      ],
      "type": "string"
     },
     "summary": {
      "additionalProperties": false,
      "properties": {
       "records_added": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "records_changed": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "records_removed": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "records_unchanged": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "unknowns_added": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "unknowns_advanced": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "unknowns_diverged": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "unknowns_removed": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "unknowns_unchanged": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "unresolved": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "records_unchanged",
       "records_added",
       "records_removed",
       "records_changed",
       "unknowns_unchanged",
       "unknowns_added",
       "unknowns_removed",
       "unknowns_advanced",
       "unknowns_diverged",
       "unresolved"
      ],
      "type": "object"
     }
    },
    "required": [
     "status",
     "left_bundle_sha256",
     "right_bundle_sha256",
     "summary",
     "changes",
     "limitations"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Compare Bundles"
}
