{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Mail a table's or a report's rows as a file on a schedule: every day or on one weekday, at a time, to the listed addresses.",
 "inputSchema": {
  "properties": {
   "app_id": {
    "description": "Project ID (from list_projects)",
    "type": "string"
   },
   "day": {
    "description": "Monday \u2026 Sunday, or Daily (default)",
    "type": "string"
   },
   "entity_id": {
    "description": "Form ID (from list_forms or describe_project)",
    "type": "string"
   },
   "file_type": {
    "description": "xls (default) | csv",
    "type": "string"
   },
   "name": {
    "description": "The file's name (default: the table's name)",
    "type": "string"
   },
   "recipients": {
    "description": "Email addresses the file is mailed to",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "report_id": {
    "description": "A report of this table \u2014 only its rows are sent",
    "type": "string"
   },
   "run_time": {
    "description": "HH:MM, 24 hours (default 08:00)",
    "type": "string"
   },
   "time_zone": {
    "description": "e.g. UTC+02",
    "type": "string"
   }
  },
  "required": [
   "app_id",
   "entity_id",
   "recipients"
  ],
  "type": "object"
 },
 "name": "create_schedule",
 "securitySchemes": [
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ]
}
