    "type": "string"
   },
   "name": {
    "description": "New artist name.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "primaryLanguage": {
    "description": "Artist primary language; an empty string clears it.",
    "maxLength": 60,
    "type": "string"
   },
   "recurringThemes": {
    "description": "Artist recurring themes. An empty array clears the list.",
