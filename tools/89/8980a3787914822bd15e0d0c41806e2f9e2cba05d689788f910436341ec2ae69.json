  "title": "Create Brix36 artist"
 },
 "description": "Creates an artist through the app service and returns profile and revision. Name is required; photos use dedicated upload/reference tools. catalogueArtistId optionally selects a manageable catalogue through an existing artist. Creation has no replay receipt; the artist list exposes persisted results after an uncertain response. No generation or charge.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bio": {
    "description": "Artist biography; an empty string clears it.",
    "maxLength": 4000,
    "type": "string"
   },
   "catalogueArtistId": {
    "description": "Optional existing artist identifying the catalogue for creation. Not needed for a single-catalogue account.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "genres": {
    "description": "Artist genres. An empty array clears the list.",
    "items": {
     "description": "One value.",
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 24,
    "type": "array"
   },
   "identityKind": {
    "description": "Factual identity of the new artist. Real person by default. Adding a real face photo follows the app real-person rules.",
    "enum": [
     "real_person",
     "fictional_character"
    ],
    "type": "string"
   },
   "influences": {
    "description": "Artist influences. An empty array clears the list.",
    "items": {
     "description": "One value.",
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 24,
    "type": "array"
   },
   "location": {
