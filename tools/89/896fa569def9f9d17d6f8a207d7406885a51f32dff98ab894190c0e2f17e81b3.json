 "description": "Audit one supplied sitemap or sitemap index. Reports entries with no loc, locations that are not absolute URLs, locations on an unexpected host, duplicated locations with the entries they occupy, fragments, unescaped ampersands that make the document invalid XML, double-escaped ampersands that name a URL which does not exist, and lastmod values that either are not W3C datetimes or match the shape without being real dates. No URL is fetched. Pay 130000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "expected_host": {
    "description": "The host serving the sitemap. A sitemap may only list URLs for its own host, so anything else is reported.",
    "example": "example.test",
    "maxLength": 256,
    "type": "string"
   },
   "max_urls": {
    "description": "The entry limit to apply. Defaults to 50000, the sitemap protocol limit.",
    "example": 50000,
    "minimum": 1,
    "type": "integer"
   },
   "require_lastmod": {
    "description": "Report entries with no lastmod. Defaults to false, since lastmod is optional.",
    "example": true,
    "type": "boolean"
   },
   "sitemap": {
    "description": "The XML document, uncompressed, at most 1048576 bytes. Nothing is fetched.",
    "example": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n<url><loc>https://example.test/widgets/widget-1</loc><lastmod>2026-09-30</lastmod></url>\n<url><loc>https://example.test/search?q=widget&page=2</loc><lastmod>2026-13-40</lastmod></url>\n<url><loc>https://example.test/widgets/widget-1</loc></url>\n<url><loc>https://staging.example.test/widgets/widget-9</loc><lastmod>2026-09-29T10:00:00Z</lastmod></url>\n<url><loc>https://example.test/widgets/widget-2#reviews</loc><lastmod>2026-09-28</lastmod></url>\n<url><loc>/widgets/widget-3</loc></url>\n</urlset>",
    "maxLength": 1048576,
    "type": "string"
   }
  },
  "required": [
   "sitemap"
  ],
  "type": "object"
 },
 "name": "sitemap_contract_audit",
