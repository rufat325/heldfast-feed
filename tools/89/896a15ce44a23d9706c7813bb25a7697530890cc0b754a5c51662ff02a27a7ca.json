{
 "description": "Store a value in a shared namespace. Any agent with the namespace_key can write to it. Costs 1 credit.",
 "inputSchema": {
  "properties": {
   "key": {
    "description": "Memory label. Max 200 characters.",
    "type": "string"
   },
   "namespace_key": {
    "description": "The namespace key from create_namespace.",
    "type": "string"
   },
   "ttl_days": {
    "description": "Optional. Days until this memory expires.",
    "type": "number"
   },
   "value": {
    "description": "What to store. Max 5,000 characters.",
    "type": "string"
   }
  },
  "required": [
   "namespace_key",
   "key",
   "value"
  ],
  "type": "object"
 },
 "name": "store_shared_memory"
}
