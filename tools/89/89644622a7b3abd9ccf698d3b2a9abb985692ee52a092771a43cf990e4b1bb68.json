{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Current members of the University Senate with the seat, constituency, college and term end of each. Filter by college or division acronym, population, constituency, or a name search. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "college": {
    "description": "Only senators for this college or division acronym, e.g. \"CMNS\", \"ENGR\", \"VPSA\"",
    "minLength": 1,
    "type": "string"
   },
   "constituency": {
    "description": "Only senators for this constituency, e.g. \"Tenured/Tenure-Track Faculty\", \"Exempt Staff - Divisions\"",
    "minLength": 1,
    "type": "string"
   },
   "population": {
    "description": "Only senators for this population, e.g. \"Faculty\" or \"Undergraduate Student\"",
    "enum": [
     "Faculty",
     "Exempt Staff",
     "Non-Exempt Staff",
     "Undergraduate Student",
     "Graduate Student",
     "Ineligible",
     "Uncertain"
    ],
    "type": "string"
   },
   "query": {
    "description": "Only senators whose name, email or seat contains this text",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "senate_list_senators",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "senators": {
    "description": "In alphabetical order by name",
    "items": {
     "additionalProperties": false,
     "properties": {
      "college": {
       "description": "College or division acronym, e.g. \"CMNS\", \"ENGR\", \"VPSA\"",
       "type": [
        "string",
        "null"
       ]
      },
      "constituency": {
       "description": "Constituency the seat represents, e.g. \"Undergraduate Student\"",
       "type": "string"
      },
      "email": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "description": "Full name",
       "type": "string"
      },
      "population": {
       "description": "Population the seat represents, e.g. \"Faculty\"",
       "type": "string"
      },
      "seat": {
       "description": "Seat held, e.g. \"Tenured Faculty - CMNS\"",
       "type": "string"
      },
      "term_ends": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Calendar year the term ends in; null when not recorded"
      }
     },
     "required": [
      "name",
      "email",
      "seat",
      "population",
      "college",
      "term_ends",
      "constituency"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "senators"
  ],
  "type": "object"
 },
 "title": "List senators"
}
