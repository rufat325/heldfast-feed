{
 "description": "Read App Store Sales and Trends: units downloaded per day per territory per app, summarized by SKU. Needs SEO_MCP_ASC_VENDOR_NUMBER and a team key with Admin, Finance or Sales and Reports. A period with no sales is reported as an absence rather than an error. Read-only",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "frequency": {
    "default": "DAILY",
    "description": "Report period",
    "enum": [
     "DAILY",
     "WEEKLY",
     "MONTHLY",
     "YEARLY"
    ],
    "type": "string"
   },
   "includeRows": {
    "default": false,
    "description": "Include every raw report row as well as the per-SKU summary",
    "type": "boolean"
   },
   "reportDate": {
    "description": "Report date. DAILY and WEEKLY take YYYY-MM-DD (WEEKLY means the week's ending date), MONTHLY takes YYYY-MM, YEARLY takes YYYY. Defaults to the most recent complete period for the frequency",
    "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
    "type": "string"
   },
   "reportSubType": {
    "default": "SUMMARY",
    "description": "Report sub type",
    "enum": [
     "SUMMARY",
     "DETAILED",
     "SUMMARY_INSTALL_TYPE",
     "SUMMARY_TERRITORY",
     "SUMMARY_CHANNEL"
    ],
    "type": "string"
   },
   "reportType": {
    "default": "SALES",
    "description": "Sales and Trends report type",
    "enum": [
     "SALES",
     "PRE_ORDER",
     "SUBSCRIPTION",
     "SUBSCRIPTION_EVENT",
     "SUBSCRIBER",
     "INSTALLS",
     "FIRST_ANNUAL"
    ],
    "type": "string"
   },
   "version": {
    "description": "Report version, such as 1_0 or 1_3, when the default is not accepted",
    "maxLength": 10,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "app_store_sales",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apps": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "sku": {
       "type": "string"
      },
      "territories": {
       "additionalProperties": {
        "type": "number"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "title": {
       "type": "string"
      },
      "units": {
       "type": "number"
      }
     },
     "required": [
      "sku",
      "title",
      "units",
      "territories"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "frequency": {
    "type": "string"
   },
   "hasData": {
    "type": "boolean"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reportDate": {
    "type": "string"
   },
   "reportSubType": {
    "type": "string"
   },
   "reportType": {
    "type": "string"
   },
   "rowCount": {
    "type": "number"
   },
   "rows": {
    "items": {
     "additionalProperties": {
      "type": "string"
     },
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "totalUnits": {
    "type": "number"
   },
   "vendorNumber": {
    "type": "string"
   }
  },
  "required": [
   "reportDate",
   "frequency",
   "reportType",
   "reportSubType",
   "vendorNumber",
   "hasData",
   "rowCount",
   "totalUnits",
   "apps",
   "rows",
   "notes"
  ],
  "type": "object"
 }
}
