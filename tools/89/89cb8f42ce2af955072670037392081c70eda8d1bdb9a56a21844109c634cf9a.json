{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get one company by its slug, with the brands that it owns. The result is the JSON twin at `/companies/{slug}.json`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "A slug: lower-case letters, digits and hyphens, for example `acme-foods`.",
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_company",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "brands": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "canonical_name": {
       "type": "string"
      },
      "publish_state": {
       "enum": [
        "draft",
        "noindex",
        "published"
       ],
       "type": "string"
      },
      "slug": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "canonical_name",
      "publish_state"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "canonical_name": {
    "type": "string"
   },
   "country": {
    "type": [
     "string",
     "null"
    ]
   },
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "organization_type": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "updated_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "website": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "slug",
   "canonical_name",
   "organization_type",
   "website",
   "country",
   "description",
   "brands",
   "updated_at"
  ],
  "type": "object"
 },
 "title": "Get a company"
}
