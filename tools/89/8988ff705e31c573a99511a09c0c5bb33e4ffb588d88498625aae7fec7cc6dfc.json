{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get receipt"
 },
 "description": "The signed receipt of one gate decision on a GSC hub, by decision_id: what was cleared, for whom, under which rule, when \u2014 with the hub signature and the ledger transaction id. No caller data, no PII, no amounts.",
 "inputSchema": {
  "properties": {
   "decision_id": {
    "pattern": "^gate_[a-f0-9]{16,40}$",
    "type": "string"
   }
  },
  "required": [
   "decision_id"
  ],
  "type": "object"
 },
 "name": "get_receipt",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "actor_class": {
    "type": "string"
   },
   "decided_at": {
    "type": "string"
   },
   "decision_id": {
    "description": "the hub gate decision id",
    "pattern": "^gate_[a-f0-9]{16,40}$",
    "type": "string"
   },
   "gtin": {
    "pattern": "^[0-9]{14}$",
    "type": "string"
   },
   "hub": {
    "enum": [
     "a2a-grocery",
     "a2a-cosmetics",
     "a2a-peptides"
    ],
    "type": "string"
   },
   "hub_signature": {
    "description": "the hub's detached JWS over the receipt (keys sorted, compact JSON), verified against the hub keyring",
    "properties": {
     "alg": {
      "type": "string"
     },
     "jws": {
      "type": "string"
     },
     "kid": {
      "type": "string"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "ledger": {
    "properties": {
     "hash": {
      "type": "string"
     },
     "host": {
      "type": "string"
     },
     "transaction_id": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "market": {
    "pattern": "^[A-Z]{2}$",
    "type": "string"
   },
   "reason_code": {
    "type": "string"
   },
   "record": {
    "description": "the gtinfetch answer the decision read: source_page, fetch_date, status, kid",
    "properties": {
     "fetch_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "kid": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_page": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "result": {
    "type": "string"
   },
   "rule_set": {
    "properties": {
     "id": {
      "type": "string"
     },
     "version": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "decision_id",
   "hub",
   "gtin",
   "market",
   "result",
   "reason_code",
   "ledger"
  ],
  "type": "object"
 },
 "title": "Get receipt"
}
