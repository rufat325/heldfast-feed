{
 "description": "Set one or more cookies for a domain.",
 "inputSchema": {
  "properties": {
   "cookies": {
    "description": "Array of cookie objects to set multiple at once",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "domain": {
    "description": "Cookie domain (e.g. \".example.com\")",
    "type": "string"
   },
   "httpOnly": {
    "description": "HttpOnly flag (default: false)",
    "type": "boolean"
   },
   "name": {
    "description": "Cookie name",
    "type": "string"
   },
   "path": {
    "description": "Cookie path (default: /)",
    "type": "string"
   },
   "sameSite": {
    "description": "SameSite attribute (default: lax)",
    "enum": [
     "no_restriction",
     "lax",
     "strict"
    ],
    "type": "string"
   },
   "secure": {
    "description": "Secure flag (default: true)",
    "type": "boolean"
   },
   "url": {
    "description": "URL for the cookie (alternative to domain)",
    "type": "string"
   },
   "value": {
    "description": "Cookie value",
    "type": "string"
   }
  },
  "required": [
   "name",
   "value"
  ],
  "type": "object"
 },
 "name": "browser_set_cookies"
}
