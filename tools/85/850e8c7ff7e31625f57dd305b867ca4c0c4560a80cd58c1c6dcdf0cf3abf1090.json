{
 "description": "Check if an agent's earned tier permits an action at a given autonomy level and spend amount. Returns null if permitted, or escalation details if tier is insufficient.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentId": {
    "description": "Agent ID",
    "type": "string"
   },
   "principalId": {
    "description": "Principal ID",
    "type": "string"
   },
   "requestedAutonomy": {
    "description": "Requested autonomy level (1-5)",
    "type": "number"
   },
   "requestedDepth": {
    "description": "Requested delegation depth",
    "type": "number"
   },
   "requestedSpend": {
    "description": "Requested spend amount in dollars",
    "type": "number"
   },
   "scope": {
    "description": "Reputation scope",
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "principalId",
   "scope"
  ],
  "type": "object"
 },
 "name": "check_tier"
}
