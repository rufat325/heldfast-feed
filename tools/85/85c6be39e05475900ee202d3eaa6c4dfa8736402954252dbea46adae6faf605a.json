{"_meta":{"securitySchemes":[{"scopes":["mcp"],"type":"oauth2"}]},"description":"Add a food item. Expiry is estimated from shelf-life rules (category + storage) unless a printed expiry_date is given.","inputSchema":{"properties":{"category":{"enum":["produce","dairy","meat","seafood","bakery","frozen","pantry","beverage","non-food"],"type":"string"},"expiry_date":{"description":"Printed date; overrides the estimate","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"low_threshold":{"description":"Flag as low (and suggest for the shopping list) when qty <= this","type":"number"},"name":{"type":"string"},"notes":{"type":"string"},"purchase_date":{"description":"Defaults to today","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"qty":{"description":"Numeric amount, e.g. 2","type":"number"},"quantity":{"description":"Free text, e.g. '2 gal', '1 x 24ct'","type":"string"},"storage":{"enum":["fridge","freezer","pantry"],"type":"string"},"store":{"type":"string"},"unit":{"description":"e.g. gal, jar, lb","type":"string"}},"required":["name"],"type":"object"},"name":"add_pantry_item"}
