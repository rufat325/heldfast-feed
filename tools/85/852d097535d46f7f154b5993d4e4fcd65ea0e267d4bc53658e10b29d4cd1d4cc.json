{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Search US public water systems by name, and optionally narrow by state (two-letter code), county name as reported to SDWIS (requires state), system type code (CWS, NTNCWS, TNCWS), or active systems only. Results are ordered by population served, largest first, and each result includes its count of current health-based violations. Returns brief records at most `limit` at a time (default 50, max 500) with no offset paging \u2014 narrow the filters to dig deeper. Use get_water_system with a result's PWSID for that system's full profile, violations, lead/copper and PFAS detail.","inputSchema":{"properties":{"active_only":{"default":false,"description":"Only active systems","type":"boolean"},"county":{"description":"County name as reported to SDWIS, e.g. COOK (requires state)","type":"string"},"limit":{"default":50,"description":"Max results (default 50, max 500)","type":"number"},"query":{"description":"Name fragment to match, e.g. 'Springfield'","type":"string"},"state":{"description":"Two-letter state code, e.g. IL","type":"string"},"type":{"description":"System type code: CWS, NTNCWS, or TNCWS","type":"string"}},"type":"object"},"name":"search_water_systems","outputSchema":{"properties":{"data":{"anyOf":[{"properties":{"count":{"type":"integer"},"systems":{"items":{"properties":{"activity":{"type":"string"},"current_health_violation_count":{"type":"integer"},"epa_region":{"type":"string"},"first_reported_date":{"type":"string"},"ground_or_surface":{"type":"string"},"is_school_or_daycare":{"type":"boolean"},"is_wholesaler":{"type":"boolean"},"last_reported_date":{"type":"string"},"mailing_city":{"type":"string"},"mailing_zip":{"type":["null","string"]},"name":{"type":"string"},"outstanding_performer":{"type":"boolean"},"owner_type":{"type":["null","string"]},"population_served":{"type":"integer"},"primacy_agency":{"type":"string"},"primary_source":{"type":"string"},"pwsid