{
 "description": "Get raw OHLCV candle history (open, high, low, close, volume, timestamp) from Binance klines.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "interval": {
    "default": "1h",
    "description": "Kline interval",
    "enum": [
     "1m",
     "5m",
     "15m",
     "1h",
     "4h",
     "1d"
    ],
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Number of candles (1-500)",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "symbol": {
    "description": "Base symbol: BTC, ETH, SOL, etc.",
    "maxLength": 12,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "candle_history"
}
