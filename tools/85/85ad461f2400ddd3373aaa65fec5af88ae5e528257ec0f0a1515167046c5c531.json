{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Start or recover an asynchronous x402 conformance scan. Initial call returns a recovery capability; poll status, request a quote when ready, then supply an explicitly signed payment_signature. Never signs a payment.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 22,
    "type": "string"
   },
   "origin": {
    "type": "string"
   },
   "paths": {
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "payment_signature": {
    "type": "string"
   },
   "recovery_capability": {
    "type": "string"
   }
  },
  "required": [
   "origin",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "scan_origin"
}
