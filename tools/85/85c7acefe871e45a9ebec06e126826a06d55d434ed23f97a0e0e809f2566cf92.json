 "description": "Parse ONE Schedule 13D or 13G filing by issuer + accession_number (get the accession_number from sec_13d_filings). Returns every reporting owner (the \"group members\") with percent of class, sole/shared voting power, sole/shared dispositive power, and aggregate shares owned; for Schedule 13D, also Item 4 \u2014 the free-text \"Purpose of Transaction\", which is where an activist states its intent (board seats, a merger, liquidation, or \"no plans\"). Filings from before SEC's 2024 structured-XML rule have no machine-readable fields \u2014 this returns `structured: false` plus the bounded plain text of the filing instead of silently returning empty data.",
 "inputSchema": {
  "examples": [
   {
    "accession_number": "0001104659-25-086308",
    "ticker_or_cik": "IMXI"
   }
  ],
  "properties": {
   "accession_number": {
    "description": "The filing's SEC accession number, e.g. \"0001104659-25-086308\" (dashes optional). From sec_13d_filings.",
    "type": "string"
   },
   "cik": {
    "description": "Alias for ticker_or_cik.",
    "type": "string"
   },
   "ticker": {
    "description": "Alias for ticker_or_cik.",
    "type": "string"
   },
   "ticker_or_cik": {
    "description": "Ticker, company name, or CIK of the ISSUER the filing is about (same value you passed to sec_13d_filings).",
    "type": "string"
   }
  },
  "required": [
   "accession_number"
  ],
  "type": "object"
 },
 "name": "sec_13d_filing",
