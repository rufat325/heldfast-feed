{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compute a speakers breakdown for a given folder scope, date range, and field filters. Standalone analytics \u2014 does not require a dashboard to exist.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "endDate": {
    "description": "ISO end date",
    "type": "string"
   },
   "filterList": {
    "description": "Field filter rules",
    "items": {
     "additionalProperties": false,
     "properties": {
      "fieldCondition": {
       "maxLength": 50,
       "type": "string"
      },
      "fieldName": {
       "maxLength": 100,
       "type": "string"
      },
      "fieldOperator": {
       "maxLength": 50,
       "type": "string"
      },
      "fieldValue": {
       "items": {
        "maxLength": 500,
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "fieldName"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "folderScope": {
    "description": "Folder ids to scope to",
    "items": {
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "startDate": {
    "description": "ISO start date",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_dashboard_speakers_insight",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Response payload from the Speak AI API"
   }
  },
  "type": "object"
 },
 "title": "Get Dashboard Speakers Insight"
}
