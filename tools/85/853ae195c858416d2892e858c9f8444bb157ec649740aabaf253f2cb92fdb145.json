{
 "_meta": {
  "openai/annotationJustification": "Patches multiple content keys in one draft commit.",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit content in bulk"
 },
 "description": "patch_content on multiple keys; all-or-nothing validation. Preferred edit path for pages over 60KB. replace-string value/replace \u226460KB; whole call \u226480KB.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "One sentence: why you are calling this tool and what you are trying to accomplish. Stored on the site's activity log and visible to everyone on the site \u2014 never put secrets or personal data here.",
    "minLength": 1,
    "type": "string"
   },
   "guestToken": {
    "description": "Guest token from start_site. Send it on every call until claim_site. Omit when this chat is already signed in to Dotsy.",
    "minLength": 20,
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "minLength": 1,
       "type": "string"
      },
      "ops": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "anchored": {
          "type": "boolean"
         },
         "attrs": {
          "additionalProperties": {
           "type": "string"
          },
          "type": "object"
         },
         "expect": {
          "minimum": 0,
          "type": "integer"
         },
         "find": {
          "minLength": 1,
          "type": "string"
         },
         "name": {
          "minLength": 1,
          "type": "string"
         },
         "op": {
          "enum": [
           "set-attr",
           "remove-attr",
           "replace-text",
           "remove-node",
           "insert-after",
           "replace-inner-html",
           "replace-outer-html",
           "replace-string",
           "wrap",
           "unwrap",
           "move"
          ],
          "type": "string"
         },
         "position": {
          "enum": [
           "before",
           "after"
          ],
          "type": "string"
         },
         "replace": {
          "type": "string"
         },
         "selector": {
          "minLength": 1,
          "type": "string"
         },
         "selectors": {
          "items": {
           "minLength": 1,
           "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
         },
         "tag": {
          "enum": [
           "div",
           "section",
           "footer",
           "header",
           "article",
           "aside"
          ],
          "type": "string"
         },
         "target": {
          "minLength": 1,
          "type": "string"
         },
         "value": {
          "type": "string"
         }
        },
        "required": [
         "op"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "key",
      "ops"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "site": {
    "description": "Site slug, e.g. acme-studio",
    "type": "string"
   }
  },
  "required": [
   "site",
   "items",
   "context"
  ],
  "type": "object"
 },
 "name": "batch_patch_content"
}
