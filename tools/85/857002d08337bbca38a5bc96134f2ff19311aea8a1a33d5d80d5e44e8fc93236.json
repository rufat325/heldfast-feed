{
 "_meta": {
  "openai/outputTemplate": "ui://onpage/report-card.openai.html",
  "openai/toolInvocation/invoked": "Scan ready",
  "openai/toolInvocation/invoking": "Scanning with OnPage.dev",
  "ui": {
   "resourceUri": "ui://onpage/report-card.html"
  },
  "ui/resourceUri": "ui://onpage/report-card.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "AI visibility"
 },
 "description": "Whether AI assistants can read, quote and recommend a site. Pick with mode: check = AI crawler access, llms.txt, 15 citability checks and the page as a model reads it. Needs url. bots = Fetch the page as Googlebot, GPTBot, ClaudeBot, PerplexityBot and more against a browser: firewall blocks, challenges, cloaking. Needs url. gaps = Where AI answers name competitors, not you, from Brand Radar or similar. Needs site, brand, responses[{question, response, links, search_queries, engine, volume}]. citations = What pages cited by AI do differently, from citation counts. Needs pages[{url, chatgpt, perplexity, gemini, google_ai_overviews, google_ai_mode}].",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "brand": {
    "description": "Your brand name as people write it.",
    "maxLength": 2000,
    "type": "string"
   },
   "competitors": {
    "items": {
     "properties": {
      "domain": {
       "maxLength": 2000,
       "type": "string"
      },
      "name": {
       "maxLength": 2000,
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "detail": {
    "description": "brief = short summary.",
    "enum": [
     "full",
     "brief"
    ],
    "type": "string"
   },
   "memory_key": {
    "description": "site_memory key, records this call.",
    "maxLength": 80,
    "type": "string"
   },
   "mode": {
    "description": "Default check.",
    "enum": [
     "check",
     "bots",
     "gaps",
     "citations"
    ],
    "type": "string"
   },
   "pages": {
    "items": {
     "properties": {
      "chatgpt": {
       "minimum": 0,
       "type": "number"
      },
      "copilot": {
       "minimum": 0,
       "type": "number"
      },
      "gemini": {
       "minimum": 0,
       "type": "number"
      },
      "google_ai_mode": {
       "minimum": 0,
       "type": "number"
      },
      "google_ai_overviews": {
       "minimum": 0,
       "type": "number"
      },
      "grok": {
       "minimum": 0,
       "type": "number"
      },
      "perplexity": {
       "minimum": 0,
       "type": "number"
      },
      "total": {
       "description": "Total AI citations or appearances, if the source gives one number.",
       "minimum": 0,
       "type": "number"
      },
      "url": {
       "maxLength": 2048,
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "minItems": 2,
    "type": "array"
   },
   "responses": {
    "items": {
     "properties": {
      "engine": {
       "maxLength": 2000,
       "type": "string"
      },
      "links": {
       "items": {
        "maxLength": 2000,
        "type": "string"
       },
       "maxItems": 40,
       "type": "array"
      },
      "question": {
       "maxLength": 2000,
       "type": "string"
      },
      "response": {
       "maxLength": 8000,
       "type": "string"
      },
      "search_queries": {
       "items": {
        "maxLength": 2000,
        "type": "string"
       },
       "maxItems": 20,
       "type": "array"
      },
      "volume": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "question",
      "response"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   },
   "site": {
    "description": "Your site, for example example.com.",
    "maxLength": 2000,
    "type": "string"
   },
   "source": {
    "description": "Where the citation counts come from.",
    "enum": [
     "ahrefs",
     "semrush",
     "other"
    ],
    "type": "string"
   },
   "url": {
    "description": "Full address of the page, for example https://example.com/pricing.",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ai_visibility",
 "outputSchema": {
  "type": "object"
 },
 "title": "AI visibility"
}
