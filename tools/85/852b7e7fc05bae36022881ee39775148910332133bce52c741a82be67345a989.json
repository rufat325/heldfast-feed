{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Claim the next pending job using the worker token. Returns job:null immediately when no work is available, otherwise a job containing a new secret receipt. Visibility defaults to 60 seconds and accepts 30-900 seconds. Redelivery is possible: make worker side effects idempotent. Jobs fail after 5 unsuccessful claims. No job is executed by the server.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "queue_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   },
   "visibility_timeout": {
    "default": 60,
    "description": "Claim visibility in seconds, capped by the fixed queue expiry.",
    "maximum": 900,
    "minimum": 30,
    "type": "integer"
   },
   "worker_token": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "queue_id",
   "worker_token"
  ],
  "type": "object"
 },
 "name": "claim_agent_queue_job",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "expire_timestamp": {
    "type": "integer"
   },
   "job": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "attempts": {
        "maximum": 5,
        "minimum": 0,
        "type": "integer"
       },
       "claimed_until_timestamp": {
        "type": [
         "integer",
         "null"
        ]
       },
       "created_at_timestamp": {
        "type": "integer"
       },
       "expire_timestamp": {
        "type": "integer"
       },
       "job_id": {
        "pattern": "^[a-f0-9]{32}$",
        "type": "string"
       },
       "job_key": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
        "type": "string"
       },
       "payload": {},
       "receipt": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "status": {
        "enum": [
         "pending",
         "claimed",
         "completed",
         "failed"
        ],
        "type": "string"
       }
      },
      "required": [
       "job_id",
       "job_key",
       "payload",
       "status",
       "attempts",
       "created_at_timestamp",
       "expire_timestamp",
       "claimed_until_timestamp",
       "receipt"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "ok": {
    "type": "boolean"
   },
   "queue_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   }
  },
  "required": [
   "ok",
   "queue_id",
   "expire_timestamp",
   "job"
  ],
  "type": "object"
 },
 "title": "Claim agent queue job"
}
