  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Read the agent update policy of one server: channel (stable/beta/pinned), pinned version, maintenance window, available version for the channel, end-of-life status, whether the installed agent supports update jobs, and the last update job with its heartbeat verification state. Requires unrestricted account credentials and read scope. This read may reconcile expired operational state and clean up expired internal jobs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "pattern": "^agt_[a-f0-9]{16,24}$",
    "type": "string"
   }
  },
  "required": [
   "agent_id"
  ],
  "type": "object"
 },
 "name": "impreza_get_update_policy",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "agent_id": {
      "type": "string"
     },
     "end_of_life": {
      "type": [
       "object",
       "null"
      ]
     },
     "last_job": {
      "type": [
       "object",
       "null"
      ]
     },
     "maintenance_window_utc": {
      "type": [
       "object",
       "null"
      ]
     },
     "offer": {
      "type": "object"
     },
     "pinned_version": {
      "type": [
       "string",
       "null"
      ]
     },
     "supported_command": {
      "type": "boolean"
     },
     "update": {
      "type": "object"
     },
     "update_channel": {
      "type": "string"
     }
    },
    "required": [
     "agent_id",
     "update_channel",
     "pinned_version",
     "maintenance_window_utc",
     "update",
     "end_of_life",
     "supported_command",
     "offer",
     "last_job"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
