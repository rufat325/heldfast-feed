{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an A/B comparison from 2+ videos (POST /comparison) and optionally start it immediately (PUT /comparison/{id}?type=start). dry_run=true (default) previews.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "default": "",
    "description": "Optional description",
    "type": "string"
   },
   "dry_run": {
    "default": true,
    "description": "true = preview only; false = create",
    "type": "boolean"
   },
   "idempotency_key": {
    "description": "Reserved client-supplied retry key",
    "type": "string"
   },
   "name": {
    "description": "Comparison name",
    "minLength": 1,
    "type": "string"
   },
   "start": {
    "default": false,
    "description": "Start the test immediately after creating",
    "type": "boolean"
   },
   "video_ids": {
    "description": "Video IDs to compare (at least 2)",
    "items": {
     "type": "string"
    },
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "name",
   "video_ids"
  ],
  "type": "object"
 },
 "name": "panda_action_create_ab_test",
 "title": "Create A/B Test"
}
