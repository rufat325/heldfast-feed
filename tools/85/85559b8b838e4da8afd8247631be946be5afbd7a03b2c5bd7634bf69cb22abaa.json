{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update change order"
 },
 "description": "Update an existing change order by ID. Requires change_orders:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "description": "Amount (negative for credits)",
    "type": "number"
   },
   "approved_at": {
    "description": "Approval date (ISO 8601)",
    "type": "string"
   },
   "approved_by": {
    "description": "Approved by (user ID)",
    "type": "string"
   },
   "category_id": {
    "description": "Cost category ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "co_number": {
    "description": "Change order number",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "id": {
    "description": "Change order ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "notes": {
    "description": "Notes",
    "type": "string"
   },
   "project_id": {
    "description": "Project ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "reason": {
    "description": "Reason",
    "type": "string"
   },
   "status": {
    "description": "Status",
    "enum": [
     "draft",
     "submitted",
     "approved",
     "rejected"
    ],
    "type": "string"
   },
   "vendor_id": {
    "description": "Vendor ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_change_order",
 "title": "Update change order"
}
