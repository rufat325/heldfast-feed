   "listingId": {
    "description": "AVnester listingId, as returned in search_properties results (the `listingId` field). IDs are not guessable \u2014 call search_properties first. Also the trailing segment of a listing sourceUrl.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "listingId"
  ],
  "type": "object"
 },
