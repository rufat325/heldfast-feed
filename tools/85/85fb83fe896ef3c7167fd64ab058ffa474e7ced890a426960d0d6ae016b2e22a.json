{
 "description": "Find bounties matching a skill set + $ floor. Sorted by $ desc. Excludes assigned/active-PR bounties.",
 "inputSchema": {
  "properties": {
   "fresh_only": {
    "default": true,
    "type": "boolean"
   },
   "max_attempts": {
    "default": 5,
    "description": "skip bounties with >N attempts (scam-pattern guard)",
    "type": "number"
   },
   "min_dollars": {
    "default": 100,
    "type": "number"
   },
   "skills": {
    "description": "languages/skills, e.g. ['python','rust']",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "find_matching"
}
