{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get one story"
 },
 "description": "One story by its id, as returned by search_stories or get_instrument_stories: the headline, a summary, what it reports about the instruments it is linked to, the publications that reported it (up to 10, with links) and earlier stories on the same instruments. Returns NOT_FOUND for an unknown id or a story older than 48 hours. Information only \u2014 never investment advice.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "The story's id, from a previous result.",
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_story",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "code": {
    "enum": [
     "OK",
     "NOT_FOUND"
    ],
    "type": "string"
   },
   "earlier": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "first_seen_at": {
       "type": "string"
      },
      "headline": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "instruments": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "headline",
      "first_seen_at",
      "instruments"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "story": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "country": {
        "enum": [
         "IN",
         "US"
        ],
        "type": "string"
       },
       "first_seen_at": {
        "type": "string"
       },
       "headline": {
        "type": "string"
       },
       "id": {
        "type": "string"
       },
       "instruments": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "relevance": {
        "type": "number"
       },
       "sources": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "name": {
           "type": "string"
          },
          "url": {
           "type": "string"
          }
         },
         "required": [
          "name",
          "url"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "summary": {
        "type": [
         "string",
         "null"
        ]
       },
       "why_it_matters": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "headline",
       "summary",
       "why_it_matters",
       "instruments",
       "relevance",
       "country",
       "first_seen_at",
       "sources"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "code",
   "story",
   "earlier"
  ],
  "type": "object"
 },
 "title": "Get one story"
}
