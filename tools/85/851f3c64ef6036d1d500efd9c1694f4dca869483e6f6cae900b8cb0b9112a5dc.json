{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "cherami_mail:full"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit saved draft"
 },
 "description": "Edit supplied fields of an unsent draft. Concurrent edits to the same field use the last saved value; omitted fields stay unchanged.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "attachments": {
    "description": "Replacement list of files, with original bytes as padded base64. Empty clears; omitted keeps existing files on edit.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "description": "Padded base64 file content, not a URL.",
       "type": "string"
      },
      "filename": {
       "type": "string"
      },
      "type": {
       "description": "MIME type.",
       "type": "string"
      }
     },
     "required": [
      "filename",
      "type",
      "content"
     ],
     "type": "object"
    },
    "maxItems": 32,
    "type": "array"
   },
   "bcc": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "description": "Bare ASCII email address.",
       "type": "string"
      },
      "name": {
       "description": "Optional display name, at most 256 UTF-8 bytes after trimming, without control characters.",
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "cc": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "description": "Bare ASCII email address.",
       "type": "string"
      },
      "name": {
       "description": "Optional display name, at most 256 UTF-8 bytes after trimming, without control characters.",
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "draft_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "html": {
    "description": "HTML alternative; null clears it. When editing text, update or clear HTML too if needed.",
    "type": [
     "string",
     "null"
    ]
   },
   "in_reply_to": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Owned received or accepted sent reply target in this inbox; null clears. Supply recipients/subject or derive them with source on creation."
   },
   "labels": {
    "description": "Initial labels for the eventual sent copy.",
    "items": {
     "description": "Case-sensitive label, trimmed; at most 128 UTF-8 bytes, without control characters.",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "subject": {
    "type": "string"
   },
   "text": {
    "description": "Plain-text body; may be empty while drafting. For source forwards on creation, this is the introductory note.",
    "type": "string"
   },
   "to": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "description": "Bare ASCII email address.",
       "type": "string"
      },
      "name": {
       "description": "Optional display name, at most 256 UTF-8 bytes after trimming, without control characters.",
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "draft_id"
  ],
  "type": "object"
 },
 "name": "update_draft",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "created_at": {
    "description": "Absolute ISO 8601 service timestamp in UTC (Z), with millisecond precision.",
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "inbox_id": {
    "type": "string"
   },
   "sent_message_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "state": {
    "enum": [
     "draft",
     "submitted"
    ],
    "type": "string"
   },
   "subject": {
    "type": "string"
   },
   "updated_at": {
    "description": "Absolute ISO 8601 service timestamp in UTC (Z), with millisecond precision.",
    "type": "string"
   }
  },
  "required": [
   "id",
   "inbox_id",
   "state",
   "subject",
   "created_at",
   "updated_at",
   "sent_message_id"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "cherami_mail:full"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Edit saved draft"
}
