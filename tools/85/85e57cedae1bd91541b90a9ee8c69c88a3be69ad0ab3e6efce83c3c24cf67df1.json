{"_meta":{"xdata.kr/credential":{"providers":["hometax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=hometax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: hometax__session__login (\uac19\uc740 account_link_id). \uc791\uc131 \uc911\uc778 \uc6d0\ucc9c\uc138 \uae30\ud55c\ud6c4\uc2e0\uace0\uc11c\uc758 \ubd80\ud45c\ub97c \uc800\uc7a5\ud558\uace0 \uae30\uad00\uc5d0\uc11c \ub2e4\uc2dc \uc77d\uc5b4 \uc800\uc7a5\ub41c \ub0b4\uc6a9\uc744 \ud655\uc778\ud569\ub2c8\ub2e4. detail_save \ub85c \uc18c\ub4dd\ubcc4 \uc0c1\uc138\ub97c \uc800\uc7a5\ud55c \ub4a4\uc5d0 \ubd80\ub985\ub2c8\ub2e4. annex_document \uc758 kind \ub85c \ubd80\ud45c \uc885\ub958\ub97c \uace0\ub974\uace0, \uc788\ub358 \ud589\uc744 \uace0\uce58\uac70\ub098 \uc9c0\uc6b8 \ub54c\ub294 lookup \uc758 \ubd80\ud45c \uc870\ud68c\uac00 \ub3cc\ub824\uc900 \ud589 \ubc88\ud638\uc640 \ud574\uc2dc\ub97c \ud568\uaed8 \ubcf4\ub0c5\ub2c8\ub2e4. \uc81c\ucd9c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 4\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"$defs":{"AnnexDocument":{"additionalProperties":false,"properties":{"datasets":{"additionalProperties":{"anyOf":[{"additionalProperties":true,"type":"object"},{"items":{"additionalProperties":true,"type":"object"},"type":"array"}]},"description":"\ubd80\ud45c\uc758 \uac12\uc744 \ubc14\uafc0 \ub54c \uc4f0\ub294 \uac1d\uccb4\uc785\ub2c8\ub2e4. \ud0a4\ub294 \uadf8 \ubd80\ud45c\uc5d0\uc11c \ubc14\uafc0 \uc218 \uc788\ub294 \uae30\uad00 \ub370\uc774\ud130 \uc774\ub984\uc774\uace0, \uac12\uc740 \ubc14\uafc0 \uce78\ub9cc \ub2f4\uc740 \uac1d\uccb4\ub098 \ud589 \uac1d\uccb4 \ubaa9\ub85d\uc785\ub2c8\ub2e4. \ud589 \ubaa9\ub85d\uc740 \uae30\uad00 \ud589\uacfc \uac1c\uc218\uac00 \uac19\uc544\uc57c \ud558\uba70, \ud589 \uc218\ub97c \ubc14\uafb8\ub824\uba74 row_operations \ub97c \uc501\ub2c8\ub2e4. \ubc14\uafc0 \uc218 \uc5c6\ub294 \ub370\uc774\ud130 \uc774\ub984\uc740 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","title":"Datasets","type":"object"},"kind":{"description":"refund_succession\uc740 \uc2b9\uacc4\uba85\uc138 \uc800\uc7a5 \ud6c4 \ubcf8\ud45c detail_save\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. refund\ub294 \ud658\uae09\uc2e0\uccad\uc744 \uc120\ud0dd\ud55c \ub300\ud654\ud615\uc5d0\uc11c\ub9cc \uc9c0\uc6d0\ud569\ub2c8\ub2e4.","enum":["income_persons","annex","refund","previous_refund","paid_tax","refund_succession"],"title":"Kind","type":"string"},"row_operations":{"additionalProperties":{"items":{"$ref":"#/$defs/AnnexRowOperation"},"type":"array"},"description":"\uba85\uc138 \uc870\ud68c \uacb0\uacfc\uc758 \ud589\uc744 \ucd94\uac00, \uc218\uc815, \uc0ad\uc81c\ud569\ub2c8\ub2e4. \ud55c \ubb36\uc74c\uc758 \ud589 \ubc88\ud638\ub294 \ubcc0\uacbd \uc804 \uc870\ud68c \uae30\uc900\uc785\ub2c8\ub2e4.","title":"Row Operations","type":"object"}},"required":["kind"],"title":"AnnexDocument","type":"object"},"AnnexRowOperation":{"additionalProperties":false,"properties":{"expected_row_hash":{"anyOf":[{"pattern":"^[0-9a-f]{64}$","type":"string"},{"type":"null"}],"default":null,"description":"\uc218\uc815\ud558\uac70\ub098 \uc0ad\uc81c\ud560 \ud589\uc758 \ud655\uc778\uac12\uc785\ub2c8\ub2e4(\uc18c\ubb38\uc790 16\uc9c4\uc218 64\uc790\ub9ac). row_index \uc640 \uac19\uc740 row_targets \ud56d\ubaa9\uc5d0\uc11c \ubc1b\uc740 \uac12\uc744 \uadf8\ub300\ub85c \uc785\ub825\ud558\uba70 add \uc5d0\ub294 \uc785\ub825\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uae30\uad00\uc758 \uc9c0\uae08 \ud589\uacfc \ub2e4\ub974\uba74 409 \ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","title":"Expected Row Hash"},"operation":{"description":"\ud589 \uc791\uc5c5\uc758 \uc885\ub958\uc785\ub2c8\ub2e4. \uc0c8 \ud589\uc740 add, \uae30\uc874 \ud589 \uc218\uc815\uc740 update, \uae30\uc874 \ud589 \uc0ad\uc81c\ub294 delete \ub85c \uc785\ub825\ud569\ub2c8\ub2e4.","enum":["add","update","delete"],"title":"Operation","type":"string"},"row_index":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"description":"\uc218\uc815\ud558\uac70\ub098 \uc0ad\uc81c\ud560 \ud589\uc758 \uc704\uce58\uc785\ub2c8\ub2e4. \ubd80\ud45c \ud589 \uc870\ud68c(lookup \uc758 query.kind \uac00 annex_rows) \uacb0\uacfc\uc758 row_targets \uc5d0\uc11c \ubc1b\uc740 \uac12\uc744 \uadf8\ub300\ub85c \uc785\ub825\ud558\uba70 add \uc5d0\ub294 \uc785\ub825\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc870\ud68c \uacb0\uacfc\uc758 \ubc94\uc704\ub97c \ubc97\uc5b4\ub098\uac70\ub098 \uae30\uad00\uc758 \uc9c0\uae08 \ud589\uacfc \ub2e4\ub974\uba74 \uac70\uc808\ud569\ub2c8\ub2e4.","title":"Row Index"},"values":{"additionalProperties":true,"description":"\uae30\uad00 \uc785\ub825 \ud544\ub4dc\uba85\uc73c\ub85c \ubcc0\uacbd\uac12\ub9cc \ubcf4\ub0c5\ub2c8\ub2e4. \ub0a9\uc138\uc790 \uc2dd\ubcc4\uc790, \uac80\uc99d \uacb0\uacfc, \ud589 \uc0c1\ud0dc, \ubcf8\ud45c \ud569\uacc4\ub294 \uc9c1\uc811 \uc9c0\uc815\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.","title":"Values","type":"object"}},"required":["operation"],"title":"AnnexRowOperation","type":"object"}},"additionalProperties":false,"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"annex_document":{"$ref":"#/$defs/AnnexDocument","description":"\uc800\uc7a5\ud560 \ubd80\ud45c\ub97c \ub2f4\ub294 \uac1d\uccb4\uc785\ub2c8\ub2e4. kind \uc5d0 \ubd80\ud45c \uc885\ub958\ub97c \uc785\ub825\ud558\uace0, \uac12\uc744 \ubc14\uafc0 \ub54c\ub294 datasets \uc5d0, \ud589\uc744 \ucd94\uac00\ud558\uac70\ub098 \uc218\uc815\ud558\uac70\ub098 \uc0ad\uc81c\ud560 \ub54c\ub294 row_operations \uc5d0 \ub2f4\uc2b5\ub2c8\ub2e4. \uac19\uc740 \ubaa9\ub85d\uc744 \ub450 \uacf3\uc5d0 \ud568\uaed8 \uc785\ub825\ud558\uba74 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud569\ub2c8\ub2e4. \ud589\uc744 \uc218\uc815\ud558\uac70\ub098 \uc0ad\uc81c\ud560 \ub54c\ub294 query.kind \uac00 annex_rows \uc774\uace0 query.annex_kind \uc5d0 \uac19\uc740 \ubd80\ud45c \uc885\ub958\ub97c \uc785\ub825\ud55c \uc870\ud68c(lookup) \uacb0\uacfc\uc758 row_targets \uc5d0\uc11c \ubc1b\uc740 row_index \uc640 expected_row_hash \ub97c \ud568\uaed8 \uc785\ub825\ud558\uba70, \uae30\uad00\uc758 \uc9c0\uae08 \ud589\uacfc \ub2e4\ub974\uba74 409 \ub85c \uac70\uc808\ud569\ub2c8\ub2e4. \ud589\uc744 \ucd94\uac00\ud560 \ub54c\ub294 \uadf8 \ub458\uc744 \uc785\ub825\ud558\uc9c0 \uc54a\uace0, \uc0ad\uc81c\ud560 \ub54c\ub294 values \ub97c \uc785\ub825\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud658\uae09\uc2e0\uccad \ubd80\ud45c(refund)\ub294 \uc774 \uc2e0\uace0 \uc720\ud615\uc5d0\uc11c \ubc1b\uc9c0 \uc54a\uace0 \uac70\uc808\ud569\ub2c8\ub2e4. \uc2b9\uacc4\uba85\uc138(refund_succession)\ub294 \ubc14\ub010 \ud589\uc774 \uc5c6\uc73c\uba74 \uac70\uc808\ud558\uace0, \uc800\uc7a5\ud55c \ub4a4\uc5d0\ub294 \uba85\uc138 \uc800\uc7a5(detail_save)\uc744 \ub2e4\uc2dc \ud574\uc57c \ud569\ub2c8\ub2e4. \uc548\ucabd \uce78\uc740 \uc694\uad6c\uc0ac\ud56d \uc870\ud68c(requirements) \uacb0\uacfc\uc758 actions \uc544\ub798 annex_save \ud56d\ubaa9 schema \uc5d0 \uc788\uc2b5\ub2c8\ub2e4. JSON \ubb38\uc790\uc5f4\uc774 \uc544\ub2c8\ub77c \uac1d\uccb4\ub85c \uc785\ub825\ud558\uba70 \ubb38\uc790\uc5f4\uc774\uba74 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud569\ub2c8\ub2e4."},"expected_snapshot_hash":{"description":"source_job_id \uc791\uc5c5 \uacb0\uacfc\uc758 snapshot_hash \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(\uc18c\ubb38\uc790 16\uc9c4\uc218 64\uc790\ub9ac). \uadf8 \uc791\uc5c5\uc758 \ub0b4\uc6a9\uacfc \ub9de\uc9c0 \uc54a\uc73c\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uc791\uc131 \ub0b4\uc6a9\uc774 \ubc14\ub00c\uc5c8\ub2e4\ub294 \uc624\ub958(409)\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^[0-9a-f]{64}$","title":"Expected Snapshot Hash","type":"string"},"source_job_id":{"description":"\uc774\uc5b4\uc11c \uc9c4\ud589\ud560 \uc774\uc804 \ub2e8\uacc4 \uc791\uc5c5\uc758 job_id \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(job_ \uc73c\ub85c \uc2dc\uc791\ud558\ub294 \uc791\uc5c5 \ubc88\ud638). \uba85\uc138 \uc800\uc7a5(detail_save)\uc774\ub098 \ubd80\ud45c \uc800\uc7a5(annex_save) \uacb0\uacfc, \ub610\ub294 \uadf8 \uc0c1\ud0dc\uc5d0\uc11c \uc2e4\ud589\ud55c \uc870\ud68c(lookup) \uacb0\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ubd80\ud45c \uc885\ub958\uac00 \uc2b9\uacc4\uba85\uc138(refund_succession)\uc774\uba74 \uae30\ubcf8\uc815\ubcf4 \uc800\uc7a5(basic_save) \uacb0\uacfc\ub3c4 \ubc1b\uc2b5\ub2c8\ub2e4. \uac19\uc740 \uc870\uc9c1\uacfc \ud658\uacbd, \uac19\uc740 \uae30\uad00 \uc5f0\uacb0\uc5d0\uc11c \uc774 \uc2e0\uace0 \uc720\ud615\uc73c\ub85c \uc131\uacf5\ud55c \uc791\uc5c5\uc774\uc5b4\uc57c \ud558\uace0 \uc544\ub2c8\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uac70\uc808\ud558\uba70, \ubc1b\uc9c0 \uc54a\ub294 \uc791\uc131 \uc0c1\ud0dc\uc758 \uacb0\uacfc\uc774\uba74 409 \ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^job_[0-9A-HJKMNP-TV-Z]{26}$","title":"Source Job Id","type":"string"}},"required":["source_job_id","expected_snapshot_hash","annex_document"],"title":"AnnexSaveRequest","type":"object"},"name":"hometax__tax__withholding__late_report__annex_save","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\ud648\ud0dd\uc2a4 \uc6d0\ucc9c\uc138 \uae30\ud55c\ud6c4\uc2e0\uace0 \ubd80\ud45c \uc800\uc7a5"}
