{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Partially update a voice agent question \u2014 only the fields you send are changed. Requires the OWNER or ADMIN role. agentId and templateId are fixed after create; sending them is silently dropped.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customConfig": {
    "additionalProperties": false,
    "properties": {
     "confirmationText": {
      "type": "string"
     },
     "displayLabel": {
      "type": "string"
     },
     "question": {
      "description": "The prompt text the agent speaks to ask this question.",
      "type": "string"
     },
     "validation": {
      "additionalProperties": false,
      "properties": {
       "allowedValues": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "max": {
        "type": "number"
       },
       "maxLength": {
        "type": "number"
       },
       "min": {
        "type": "number"
       },
       "minLength": {
        "type": "number"
       },
       "pattern": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "validationPrompt": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "enabled": {
    "type": "boolean"
   },
   "fieldId": {
    "description": "ID of the question to update (from list_voice_questions)",
    "minLength": 1,
    "type": "string"
   },
   "mappedFieldId": {
    "anyOf": [
     {
      "anyOf": [
       {
        "not": {}
       },
       {
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ]
   },
   "maxPromptAttempts": {
    "maximum": 3,
    "minimum": 1,
    "type": "number"
   },
   "noResponseBehavior": {
    "enum": [
     "move_to_next_question",
     "end_conversation"
    ],
    "type": "string"
   },
   "order": {
    "type": "number"
   },
   "required": {
    "type": "boolean"
   },
   "triggerCondition": {
    "type": "string"
   }
  },
  "required": [
   "fieldId"
  ],
  "type": "object"
 },
 "name": "update_voice_question",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Response payload from the Speak AI API"
   }
  },
  "type": "object"
 },
 "title": "Update Voice Question"
}
