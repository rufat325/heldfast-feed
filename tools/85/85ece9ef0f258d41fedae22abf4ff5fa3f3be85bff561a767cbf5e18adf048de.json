       "description": "User ID",
       "type": "string"
      }
     },
     "required": [
      "user_id",
      "enabled"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "id",
   "users"
  ],
  "type": "object"
 },
 "name": "update_mcp_server_user_access",
