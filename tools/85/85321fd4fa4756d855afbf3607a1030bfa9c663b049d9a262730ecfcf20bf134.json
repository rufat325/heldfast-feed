{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Drag Element"
 },
 "description": "Drag an element from its current position to a target element.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "session_id": {
    "description": "Session ID returned by browser_navigate",
    "type": "string"
   },
   "source_selector": {
    "description": "CSS selector of the element to drag",
    "type": "string"
   },
   "target_selector": {
    "description": "CSS selector of the drop target",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "source_selector",
   "target_selector"
  ],
  "type": "object"
 },
 "name": "browser_drag"
}
