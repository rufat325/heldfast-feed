{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Lists the user's recent captures newest first, with a short text preview of each. This is the cheap summary view; get_capture returns a single capture in full. Useful for finding an earlier capture when the user does not mean the newest one, or for working through several marked screens.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "How many captures to return. Default 10.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_captures",
 "outputSchema": {
  "properties": {
   "captures": {
    "items": {
     "properties": {
      "annotations": {
       "description": "How many marks the user drew. Above zero means they were pointing at something specific.",
       "type": "integer"
      },
      "captured_at": {
       "type": "string"
      },
      "elements": {
       "type": "integer"
      },
      "frames": {
       "type": "integer"
      },
      "height_px": {
       "type": "integer"
      },
      "id": {
       "description": "Capture id, pass to get_capture.",
       "type": "string"
      },
      "mode": {
       "enum": [
        "single",
        "scroll"
       ],
       "type": "string"
      },
      "source_app": {
       "description": "App that was captured.",
       "type": [
        "string",
        "null"
       ]
      },
      "source_title": {
       "type": [
        "string",
        "null"
       ]
      },
      "source_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "text_preview": {
       "type": "string"
      },
      "width_px": {
       "type": "integer"
      }
     },
     "required": [
      "id",
      "captured_at",
      "mode",
      "frames",
      "elements",
      "annotations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "type": "integer"
   }
  },
  "required": [
   "captures",
   "count"
  ],
  "type": "object"
 },
 "title": "List recent SlimSnap captures"
}
