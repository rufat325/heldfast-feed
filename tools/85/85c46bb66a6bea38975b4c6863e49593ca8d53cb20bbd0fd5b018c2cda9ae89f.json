{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs ruff check and returns structured lint diagnostics (file, line, code, message).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "config": {
    "description": "Path to custom ruff config file",
    "maxLength": 4096,
    "type": "string"
   },
   "diff": {
    "default": false,
    "description": "Show diff of fixes without applying (--diff)",
    "type": "boolean"
   },
   "exclude": {
    "description": "File patterns to exclude from checking",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "fix": {
    "default": false,
    "description": "Auto-fix problems",
    "type": "boolean"
   },
   "ignore": {
    "description": "Rule codes or prefixes to suppress (e.g. ['E501'])",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "lineLength": {
    "description": "Override the configured line length (--line-length)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "noCache": {
    "default": false,
    "description": "Disable cache (--no-cache)",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "preview": {
    "default": false,
    "description": "Enable preview rules (--preview)",
    "type": "boolean"
   },
   "pythonPath": {
    "description": "Python interpreter path to use (overrides executable/PATH fallback)",
    "maxLength": 4096,
    "type": "string"
   },
   "select": {
    "description": "Rule codes or prefixes to enable (e.g. ['E', 'F401'])",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "statistics": {
    "default": false,
    "description": "Show rule violation statistics (--statistics)",
    "type": "boolean"
   },
   "targetVersion": {
    "description": "Python version target override (e.g. 'py38')",
    "maxLength": 255,
    "type": "string"
   },
   "targets": {
    "default": [
     "."
    ],
    "description": "Files or directories to check (default: ['.'])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "unsafeFixes": {
    "default": false,
    "description": "Apply unsafe fixes in addition to safe ones (--unsafe-fixes)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "ruff-check",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "column": {
       "type": "number"
      },
      "endColumn": {
       "type": "number"
      },
      "endLine": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "fixApplicability": {
       "description": "Fix applicability level from ruff (safe/unsafe/display)",
       "enum": [
        "safe",
        "unsafe",
        "display"
       ],
       "type": "string"
      },
      "fixable": {
       "type": "boolean"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "column",
      "code",
      "message",
      "fixable"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "exitCode": {
    "type": "number"
   },
   "fixableCount": {
    "description": "Count of fixable diagnostics (set in compact output)",
    "type": "number"
   },
   "fixedCount": {
    "type": "number"
   },
   "success": {
    "type": "boolean"
   },
   "total": {
    "description": "Total diagnostic count (set in compact output)",
    "type": "number"
   },
   "truncated": {
    "description": "Whether the compact diagnostics list was capped (only set when true)",
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "ruff Lint"
}
