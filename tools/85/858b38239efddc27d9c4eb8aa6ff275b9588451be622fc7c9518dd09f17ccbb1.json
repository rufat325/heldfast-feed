{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Check care provider contract status"},"description":"Checks per basic policy whether a care provider (zorgaanbieder, by AGB code) has a contract with the insurer (gecontracteerd) for a care type (zorgsoort), and which percentage of the costs is reimbursed without a contract. Each result states its origin (herkomst: insurer publication, the insurer's provider search (zorgzoeker), or cache) and the date it was retrieved. If herkomst is null the dataset has no contract information for that policy (status onbekend); calling again does not change that. Contracts can change during the year, so suggest the user confirms with the insurer. Provides information, not advice: the user makes the decision and signs up with the insurer themselves.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"agbCode":{"description":"AGB code (8 digits) of the care provider, from zoek_zorgaanbieder.","pattern":"^\\d{8}$","type":"string"},"jaar":{"description":"Insurance year (verzekeringsjaar), e.g. 2027. During the switching season (November-December) users usually mean the coming year.","maximum":2100,"minimum":2020,"type":"integer"},"polisIds":{"description":"Basic policy ids (polisId) to check, e.g. from zoek_basisverzekeringen.","items":{"maxLength":100,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","type":"string"},"maxItems":20,"minItems":1,"type":"array"},"taal":{"default":"nl","description":"Response language: nl (Dutch, default) or en (English).","enum":["nl","en"],"type":"string"},"zorgsoort":{"description":"Type of care (zorgsoort), lowercase key such as 'ziekenhuis' (hospital), 'kliniek', 'ggz' (mental healthcare), 'fysio', 'wijkverpleging', 'apotheek'.","maxLength":40,"minLength":2,"pattern":"^[a-z][a-z0-9_]*$","type":"string"}},"required":["agbCode","polisIds","zorgsoort","jaar"],"type":"object"},"name":"check_zorgaanbieder","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"aannames":{"items":{"type":"string"},"type":"array"},"acties":{"items":{"additionalProperties":false,"properties":{"label":{"type":"string"},"type":{"enum":["bewaar","afsluiten","bekijk"],"type":"string"},"url":{"type":"string"}},"required":["type","label","url"],"type":"object"},"type":"array"},"bronnen":{"items":{"additionalProperties":false,"properties":{"anchor":{"type":["string","null"]},"datum":{"type":["string","null"]},"id":{"type":"string"},"titel":{"type":"string"},"url":{"type":"string"},"versie":{"type":["string","null"]}},"required":["id","titel","url","versie","datum","anchor"],"type":"object"},"type":"array"},"data":{"additionalProperties":false,"properties":{"agbCode":{"type":"string"},"opnieuwProberenNaSeconden":{"anyOf":[{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},{"type":"null"}]},"resultaten":{"items":{"additionalProperties":false,"properties":{"bronId":{"type":["string","null"]},"herkomst":{"anyOf":[{"enum":["publicatie","zorgzoeker","zorgweb","cache","wordt_opgehaald"],"type":"string"},{"type":"null"}]},"omzetplafond":{"type":["boolean","null"]},"opgehaaldOp":{"type":["string","null"]},"polisId":{"type":"string"},"polisNaam":{"type":["string","null"]},"status":{"enum":["gecontracteerd","deels","niet","onbekend"],"type":"string"},"vergoedingNietGecontracteerdPct":{"anyOf":[{"maximum":100,"minimum":0,"type":"integer"},{"type":"null"}]},"verzekeraarId":{"type":["string","null"]}},"required":["polisId","polisNaam","verzekeraarId","status","vergoedingNietGecontracteerdPct","omzetplafond","herkomst","opgehaaldOp","bronId"],"type":"object"},"type":"array"},"zorgaanbieder":{"anyOf":[{"additionalProperties":false,"properties":{"naam":{"type":"string"},"soort":{"type":"string"}},"required":["naam","soort"],"type":"object"},{"type":"null"}]},"zorgsoort":{"type":"string"}},"required":["agbCode","zorgsoort","zorgaanbieder","resultaten","opnieuwProberenNaSeconden"],"type":"object"},"meta":{"additionalProperties":false,"properties":{"affiliateMelding":{"type":"string"},"cursor":{"type":["string","null"]},"datasetVersie":{"type":"string"},"engineVersie":{"type":"string"},"gegenereerdOp":{"type":"string"},"sorteersleutel":{"type":"string"},"taal":{"enum":["nl","en"],"type":"string"}},"required":["engineVersie","datasetVersie","taal"],"type":"object"},"samenvatting":{"type":"string"}},"required":["data","samenvatting","bronnen","aannames","meta","acties"],"type":"object"},"title":"Check care provider contract status"}
