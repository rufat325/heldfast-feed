{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"NWS: Active Alerts"},"description":"Get currently-active NWS weather alerts (tornado warnings, flood watches, winter storm advisories, etc.) filtered by area (state), zone, or point. Pass at most one of area/zone/point. Severity and urgency filters are optional.\nWithout a geographic filter this returns ALL active U.S. alerts (often hundreds) \u2014 capped to `limit`.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"area":{"description":"Two-letter state/territory code (e.g. 'CA', 'TX', 'PR')","maxLength":2,"minLength":2,"type":"string"},"limit":{"default":50,"description":"Max alerts to return (default 50)","maximum":500,"minimum":1,"type":"integer"},"message_type":{"enum":["alert","update","cancel"],"type":"string"},"point":{"description":"'lat,lon' string (e.g. '38.89,-77.04')","pattern":"^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?$","type":"string"},"severity":{"enum":["Extreme","Severe","Moderate","Minor","Unknown"],"type":"string"},"status":{"enum":["actual","exercise","system","test","draft"],"type":"string"},"urgency":{"enum":["Immediate","Expected","Future","Past","Unknown"],"type":"string"},"zone":{"description":"Forecast zone ID (e.g. 'CAZ006')","type":"string"}},"type":"object"},"name":"nws_alerts_active"}
