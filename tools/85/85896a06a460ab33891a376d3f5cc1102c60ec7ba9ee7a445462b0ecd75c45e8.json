{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update a Data Stream connector settings",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "connectorId": {
    "description": "Connector ID to update",
    "type": "string"
   },
   "consumerSpec": {
    "description": "Consumer spec: SMALL or MEDIUM",
    "enum": [
     "SMALL",
     "MEDIUM"
    ],
    "type": "string"
   },
   "dateFormat": {
    "description": "Date format for sub-path",
    "enum": [
     "NONE",
     "YEAR",
     "MONTH",
     "DAY",
     "HOUR"
    ],
    "type": "string"
   },
   "description": {
    "description": "Connector description (max 200 chars)",
    "type": "string"
   },
   "exportType": {
    "const": "OBJECT_STORAGE",
    "default": "OBJECT_STORAGE",
    "description": "Connector type",
    "type": "string"
   },
   "flushCount": {
    "description": "Messages per file (default: 5000)",
    "maximum": 50000,
    "minimum": 5000,
    "type": "number"
   },
   "flushInterval": {
    "description": "File creation interval in minutes (default: 10)",
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "includeTopicInPath": {
    "description": "Whether to create topic name directory in storage path",
    "type": "boolean"
   },
   "location": {
    "description": "Storage path in s3a://{bucket}/{path} format",
    "type": "string"
   },
   "roleNrn": {
    "description": "NRN of the Data Stream service role",
    "type": "string"
   },
   "schemaType": {
    "description": "Message value serialization (default: STRING)",
    "enum": [
     "STRING",
     "JSON",
     "AVRO",
     "PROTOBUF"
    ],
    "type": "string"
   },
   "topicId": {
    "description": "Topic ID",
    "type": "string"
   }
  },
  "required": [
   "topicId",
   "connectorId",
   "consumerSpec",
   "location",
   "includeTopicInPath",
   "dateFormat",
   "roleNrn"
  ],
  "type": "object"
 },
 "name": "ncloud_datastream_update_connector"
}
