{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a VCV Rack OSC/MIDI/CV modulation bridge scaffold with channel mapping and setup notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "bipolar": {
    "default": true,
    "type": "boolean"
   },
   "channel_count": {
    "default": 8,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   },
   "midi_device": {
    "type": "string"
   },
   "mode": {
    "default": "osc",
    "enum": [
     "osc",
     "midi",
     "cv_audio",
     "manual"
    ],
    "type": "string"
   },
   "name": {
    "default": "vcv_rack_bridge",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the VCV scaffold.",
    "type": "string"
   },
   "rack_host": {
    "default": "127.0.0.1",
    "type": "string"
   },
   "receive_port": {
    "default": 12001,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "send_port": {
    "default": 12000,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "create_vcv_rack_bridge",
 "title": "Create VCV Rack bridge"
}
