{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use when the user wants alternatives similar to a known GitHub login. Similarity uses public repository, language, location, and profile signals and is not a suitability judgment. Example: {\"login\":\"sajeetharan\",\"limit\":5}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum similar profiles from 1 to 20",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "login": {
    "description": "GitHub login of the source profile",
    "maxLength": 39,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "login"
  ],
  "type": "object"
 },
 "name": "find_similar_developers",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "methodologyDisclaimer": {
    "type": "string"
   },
   "resultCount": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "location": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "login": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "profileUrl": {
       "format": "uri",
       "type": "string"
      },
      "reasons": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "score": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "similarity": {
       "enum": [
        "Very similar",
        "Similar",
        "Related"
       ],
       "type": "string"
      },
      "topLanguage": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "login",
      "name",
      "profileUrl",
      "location",
      "topLanguage",
      "score",
      "similarity",
      "reasons"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "type": "string"
   }
  },
  "required": [
   "source",
   "results",
   "resultCount",
   "methodologyDisclaimer"
  ],
  "type": "object"
 }
}
