{
 "description": "Create a manual (admin-entered) order. Each item references a product recordId or is an ad-hoc line with name+price (minor units). Only call after the user confirms.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customerEmail": {
    "description": "Customer email for the order",
    "type": "string"
   },
   "customerId": {
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "name": {
       "description": "Custom line name (ad-hoc item)",
       "type": "string"
      },
      "price": {
       "description": "Custom unit price in minor units (ad-hoc item)",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "recordId": {
       "description": "Product record id the line refers to",
       "type": "string"
      },
      "variantSelections": {
       "additionalProperties": {},
       "description": "Selected variant options, e.g. {size: 'M', color: 'red'}",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "quantity"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "customerEmail",
   "items"
  ],
  "type": "object"
 },
 "name": "create_manual_order"
}
