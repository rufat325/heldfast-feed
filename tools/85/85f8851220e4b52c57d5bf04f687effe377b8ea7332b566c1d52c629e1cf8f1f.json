{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Collect trace and DLQ context for a Sentry issue.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contextId": {
    "type": "string"
   },
   "correlationId": {
    "type": "string"
   },
   "fromTs": {
    "description": "Window start in epoch milliseconds.",
    "minimum": 0,
    "type": "integer"
   },
   "limit": {
    "description": "Required maximum number of results.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "maxScan": {
    "description": "Maximum messages scanned before returning a cursor (default 10000).",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "requestId": {
    "type": "string"
   },
   "toTs": {
    "description": "Window end in epoch milliseconds.",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "contextId",
   "limit"
  ],
  "type": "object"
 },
 "name": "natstrail.enrich_sentry"
}
