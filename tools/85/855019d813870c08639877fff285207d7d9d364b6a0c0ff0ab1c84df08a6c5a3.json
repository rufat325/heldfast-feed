{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Load structured verification evidence for a MartinLoop run \u2014 verifier commands, pass/fail outcomes, and contradiction signals \u2014 from stored loop events and ledger entries. Use after a run completes to confirm whether automated verifiers passed before merging or promoting the result. Do not use to get a merge-readiness grade \u2014 use martin_eval for a scored grade with six check dimensions. Do not use for live run status \u2014 use martin_get_status instead. This tool only reads persisted run files and does not execute commands, modify state, or contact GitHub.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "file": {
    "description": "Absolute or relative path to a loop-record.json file or run directory. Mutually exclusive with loopId.",
    "type": "string"
   },
   "loopId": {
    "description": "MartinLoop run identifier from the run store. Mutually exclusive with file.",
    "type": "string"
   },
   "runsDir": {
    "description": "Override the default run-store root directory. Optional.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "martin_get_verification_results",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "loop": {
    "additionalProperties": true,
    "properties": {
     "activeAttemptId": {
      "description": "ID of the currently active attempt, when a run is in progress.",
      "type": "string"
     },
     "attempts": {
      "type": "integer"
     },
     "avoidedUsd": {
      "type": "number"
     },
     "costUsd": {
      "type": "number"
     },
     "createdAt": {
      "type": "string"
     },
     "lastAttempt": {
      "additionalProperties": true,
      "type": "object"
     },
     "lifecycleState": {
      "type": "string"
     },
     "loopId": {
      "type": "string"
     },
     "objective": {
      "type": "string"
     },
     "pressure": {
      "type": "string"
     },
     "remainingBudgetUsd": {
      "type": "number"
     },
     "remainingIterations": {
      "type": "integer"
     },
     "remainingTokens": {
      "type": "integer"
     },
     "shouldStop": {
      "type": "boolean"
     },
     "status": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "loopId",
     "title",
     "objective",
     "status",
     "lifecycleState",
     "attempts",
     "costUsd",
     "avoidedUsd",
     "pressure",
     "shouldStop",
     "remainingBudgetUsd",
     "remainingIterations"
    ],
    "type": "object"
   },
   "source": {
    "type": "string"
   },
   "sourceKind": {
    "enum": [
     "file",
     "loop_id",
     "latest",
     "runs_root"
    ],
    "type": "string"
   },
   "verification": {
    "additionalProperties": true,
    "properties": {
     "completedAt": {
      "type": "string"
     },
     "eventCount": {
      "type": "integer"
     },
     "latestAttemptIndex": {
      "type": "integer"
     },
     "ledgerEventCount": {
      "type": "integer"
     },
     "status": {
      "enum": [
       "passed",
       "failed",
       "contradicted",
       "not_run"
      ],
      "type": "string"
     },
     "steps": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "command": {
         "type": "string"
        },
        "detail": {
         "type": "string"
        },
        "exitCode": {
         "type": "integer"
        },
        "fastFail": {
         "type": "boolean"
        },
        "launched": {
         "type": "boolean"
        },
        "timedOut": {
         "type": "boolean"
        }
       },
       "required": [
        "command",
        "launched"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "summary": {
      "type": "string"
     },
     "warnings": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "status",
     "eventCount",
     "ledgerEventCount",
     "warnings"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "source",
   "sourceKind",
   "loop",
   "verification",
   "warnings"
  ],
  "type": "object"
 }
}
