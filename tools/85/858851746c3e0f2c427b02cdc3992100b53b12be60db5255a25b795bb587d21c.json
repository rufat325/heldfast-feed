{
 "description": "Get recent crash logs from the crash buffer",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "lines": {
    "default": 50,
    "description": "Number of lines (1-10000)",
    "maximum": 10000,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "adb_logcat_crash"
}
