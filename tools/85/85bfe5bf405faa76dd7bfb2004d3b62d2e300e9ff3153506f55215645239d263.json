{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "stories:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Publish a story owned by the connected account to the public Story World library.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "confirmPublicPublishing": {
    "const": true,
    "description": "True only after the user explicitly approved making this story public.",
    "type": "boolean"
   },
   "storyId": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "storyId",
   "confirmPublicPublishing"
  ],
  "type": "object"
 },
 "name": "publish_story_to_world",
 "title": "Publish My Story to Story World"
}
