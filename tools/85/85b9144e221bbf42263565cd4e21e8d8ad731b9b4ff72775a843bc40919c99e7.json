{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a GPS/fleet tracking scaffold with sanitized asset rows, geofence maps, privacy policy, adapter source, and credential/privacy notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "websocket_json",
    "enum": [
     "websocket_json",
     "mqtt_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "ws://127.0.0.1:9073/gps",
    "type": "string"
   },
   "fleet_label": {
    "default": "venue_fleet",
    "type": "string"
   },
   "geofence_count": {
    "default": 4,
    "maximum": 256,
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "default": "gps_fleet_tracker",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the GPS scaffold.",
    "type": "string"
   },
   "provider": {
    "default": "traccar",
    "enum": [
     "traccar",
     "owntracks",
     "mqtt_gps",
     "custom"
    ],
    "type": "string"
   },
   "tracked_asset_count": {
    "default": 12,
    "maximum": 2048,
    "minimum": 1,
    "type": "integer"
   },
   "update_rate_hz": {
    "default": 1,
    "maximum": 120,
    "minimum": 0.01,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "connect_gps_fleet_tracker",
 "title": "Connect GPS fleet tracker"
}
