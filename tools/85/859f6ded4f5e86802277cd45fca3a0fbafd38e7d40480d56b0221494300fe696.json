{"description":"Submit a product for an honest, human-written review. The request starts queued; only a human reviewer completes it. The returned receiptToken is secret and is required to read a private result. Public visibility is off by default.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"contactEmail":{"format":"email","maxLength":254,"pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"focus":{"items":{"enum":["ux","copy","positioning","pricing","onboarding","trust","other"],"type":"string"},"maxItems":7,"type":"array"},"idempotencyKey":{"maxLength":200,"minLength":8,"pattern":"^[A-Za-z0-9._:-]+$","type":"string"},"product":{"properties":{"audience":{"maxLength":500,"type":"string"},"category":{"maxLength":80,"type":"string"},"description":{"maxLength":5000,"minLength":20,"type":"string"},"name":{"maxLength":120,"minLength":1,"type":"string"},"stage":{"enum":["idea","prototype","beta","live"],"type":"string"},"url":{"maxLength":500,"minLength":1,"type":"string"}},"required":["name","url","description"],"type":"object"},"publicOk":{"default":false,"type":"boolean"},"submitterModel":{"maxLength":120,"type":"string"},"submitterName":{"maxLength":120,"type":"string"}},"required":["product"],"type":"object"},"name":"submit_product_for_review","title":"Submit a product for human review"}
