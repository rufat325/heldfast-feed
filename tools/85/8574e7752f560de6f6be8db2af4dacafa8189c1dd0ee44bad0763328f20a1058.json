{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search + Extract"
 },
 "description": "Search the live web and extract requested structured fields from relevant pages in one request.",
 "inputSchema": {
  "properties": {
   "fields": {
    "description": "Unique fields to extract from each result.",
    "items": {
     "description": "One supported source field.",
     "enum": [
      "title",
      "url",
      "snippet",
      "text"
     ],
     "type": "string"
    },
    "maxItems": 4,
    "title": "Fields",
    "type": "array"
   },
   "query": {
    "description": "Live web search query.",
    "minLength": 1,
    "title": "Query",
    "type": "string"
   }
  },
  "required": [
   "query",
   "fields"
  ],
  "title": "handlerArguments",
  "type": "object"
 },
 "name": "search_extract",
 "outputSchema": {
  "properties": {
   "economics": {
    "description": "Estimated request costs.",
    "type": "object"
   },
   "extracted_data": {
    "description": "One requested-field object per source.",
    "items": {
     "properties": {
      "data": {
       "description": "Requested field values; text may be null.",
       "type": "object"
      },
      "source_url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "source_url",
      "data"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "description": "Submitted search query.",
    "type": "string"
   },
   "requested_fields": {
    "description": "Fields selected for extraction.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sources": {
    "description": "Underlying search sources.",
    "type": "array"
   },
   "usage": {
    "description": "Measured provider usage and estimated request costs.",
    "type": "object"
   }
  },
  "required": [
   "query",
   "requested_fields",
   "extracted_data",
   "sources",
   "usage",
   "economics"
  ],
  "title": "SearchExtractOutput",
  "type": "object"
 },
 "title": "Search + Extract"
}
