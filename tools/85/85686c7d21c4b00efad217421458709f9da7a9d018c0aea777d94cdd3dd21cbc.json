    "minLength": 1,
    "type": "string"
   },
   "grade": {
    "default": "raw",
    "description": "Grade for the recent sales list.",
    "enum": [
     "raw",
     "psa9",
     "psa10"
    ],
    "type": "string"
   },
   "range": {
    "default": "30d",
    "description": "Window for recent sales. Individual sales are kept for 90 days.",
    "enum": [
     "7d",
     "30d",
     "90d"
    ],
    "type": "string"
   },
   "sales": {
    "default": 10,
    "description": "How many recent sales to list.",
    "maximum": 50,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
