{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Focuses a component or moves one position. Acknowledges after the selected component renders.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "componentID": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "controlToken": {
    "maxLength": 200,
    "minLength": 20,
    "type": "string"
   },
   "direction": {
    "enum": [
     "next",
     "previous"
    ],
    "type": "string"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "operationID": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "operationID",
   "expectedRevision",
   "controlToken"
  ],
  "type": "object"
 },
 "name": "navigate",
 "title": "Navigate"
}
