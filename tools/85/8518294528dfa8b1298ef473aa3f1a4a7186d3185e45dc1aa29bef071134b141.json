{
 "_meta": {
  "openai/outputTemplate": "ui://onpage/report-card.openai.html",
  "openai/toolInvocation/invoked": "Scan ready",
  "openai/toolInvocation/invoking": "Scanning with OnPage.dev",
  "ui": {
   "resourceUri": "ui://onpage/report-card.html"
  },
  "ui/resourceUri": "ui://onpage/report-card.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "SEO and AI scan"
 },
 "description": "Scan a page for Google and AI search: 0-100 score, issues to fix first with why and how, AI readiness and key facts. Pick with mode: page = A live page by url (default). Needs url. html = Unpublished HTML before deploy, to gate a release. Needs html. deep = Everything measured on one page, by section. Needs url. rescan = Scan again after fixes and compare with the last scan. Needs url.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "detail": {
    "description": "brief = short summary.",
    "enum": [
     "full",
     "brief"
    ],
    "type": "string"
   },
   "html": {
    "description": "The complete HTML document, up to 900 KB.",
    "maxLength": 921600,
    "type": "string"
   },
   "memory_key": {
    "description": "site_memory key, records this call.",
    "maxLength": 80,
    "type": "string"
   },
   "mode": {
    "description": "Default page.",
    "enum": [
     "page",
     "html",
     "deep",
     "rescan"
    ],
    "type": "string"
   },
   "sections": {
    "description": "Sections to include. Default: all.",
    "items": {
     "enum": [
      "speed",
      "links",
      "accessibility",
      "images",
      "rich_results",
      "security",
      "content",
      "technical"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "url": {
    "description": "Full address of the page, for example https://example.com/pricing.",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "scan_page",
 "outputSchema": {
  "type": "object"
 },
 "title": "SEO and AI scan"
}
