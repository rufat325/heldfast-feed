{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Scores how a page looks when shared on X, LinkedIn, Facebook, Telegram, WhatsApp and Slack, and lists the og: and twitter: tags to fix. Useful before launch or after changing meta tags. Works without an account. The result includes a link to a visual report of the check.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fresh": {
    "description": "Skip the 15-minute cache, e.g. right after deploying a fix",
    "type": "boolean"
   },
   "url": {
    "description": "The page to check, e.g. example.com/blog/post",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "check_link_preview",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "designsUrl": {
    "type": "string"
   },
   "grade": {
    "enum": [
     "great",
     "needs_work",
     "broken"
    ],
    "type": "string"
   },
   "image": {
    "type": [
     "string",
     "null"
    ]
   },
   "problems": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "fix": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "severity",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "reportUrl": {
    "type": "string"
   },
   "score": {
    "type": "number"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "score",
   "grade",
   "image",
   "problems",
   "reportUrl"
  ],
  "type": "object"
 },
 "title": "Check a link preview"
}
