{
 "_meta": {
  "chainray.com/capability": {
   "alternateOf": null,
   "catalog": "/.well-known/mcp-capabilities.json",
   "components": [],
   "contract": "/openapi.json",
   "httpRoutes": [
    "/portfolio-analyze/{address}"
   ],
   "id": "urn:chainray:capability:mcp:wallet.portfolio",
   "payment": "x402",
   "role": "atomic",
   "surface": [
    "mcp",
    "http"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Analyze a wallet's portfolio: total USD value, token breakdown, concentration analysis, and diversification score.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Wallet address to analyze",
    "type": "string"
   },
   "chain": {
    "default": "base",
    "description": "EVM chain only. Supported chains: base, ethereum, arbitrum, optimism, polygon, bsc, avalanche, zksync, linea, scroll, blast, mantle, gnosis, polygon-zkevm, mode, sei, celo, manta, taiko, fantom, cronos, opbnb, zora, worldchain, metis, fraxtal, kava, zetachain, filecoin, core-dao, aurora, moonbeam, klaytn, bob, canto, monad, tempo, megaeth, arc, plasma, katana, robinhood, pharos, hyperevm.",
    "enum": [
     "base",
     "ethereum",
     "arbitrum",
     "optimism",
     "polygon",
     "bsc",
     "avalanche",
     "zksync",
     "linea",
     "scroll",
     "blast",
     "mantle",
     "gnosis",
     "polygon-zkevm",
     "mode",
     "sei",
     "celo",
     "manta",
     "taiko",
     "fantom",
     "cronos",
     "opbnb",
     "zora",
     "worldchain",
     "metis",
     "fraxtal",
     "kava",
     "zetachain",
     "filecoin",
     "core-dao",
     "aurora",
     "moonbeam",
     "klaytn",
     "bob",
     "canto",
     "monad",
     "tempo",
     "megaeth",
     "arc",
     "plasma",
     "katana",
     "robinhood",
     "pharos",
     "hyperevm"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "wallet.portfolio",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "analysis": {
    "additionalProperties": false,
    "properties": {
     "diversification": {
      "type": "string"
     },
     "largestPosition": {
      "type": "string"
     },
     "stablecoinPct": {
      "type": "string"
     }
    },
    "required": [
     "diversification",
     "largestPosition",
     "stablecoinPct"
    ],
    "type": "object"
   },
   "chain": {
    "description": "Blockchain queried",
    "type": "string"
   },
   "ethPrice": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "holdings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "asset": {
       "type": "string"
      },
      "pct": {
       "type": "number"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "asset",
      "value",
      "pct"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "portfolio": {
    "additionalProperties": false,
    "properties": {
     "ethBalance": {
      "type": "number"
     },
     "ethValueUsd": {
      "type": "number"
     },
     "tokenCount": {
      "type": "number"
     },
     "tokenValueUsd": {
      "type": "number"
     },
     "totalValueUsd": {
      "type": "number"
     }
    },
    "required": [
     "totalValueUsd",
     "ethBalance",
     "ethValueUsd",
     "tokenCount",
     "tokenValueUsd"
    ],
    "type": "object"
   },
   "timestamp": {
    "description": "Unix timestamp ms",
    "type": "number"
   },
   "wallet": {
    "description": "Address",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "wallet",
   "ethPrice",
   "portfolio",
   "holdings",
   "analysis",
   "timestamp"
  ],
  "type": "object"
 },
 "title": "Portfolio Analysis"
}
