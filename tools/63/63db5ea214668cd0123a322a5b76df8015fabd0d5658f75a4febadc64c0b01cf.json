{
 "description": "[Trading Data API] OHLCV candles (oldest-first) for crypto or stocks \u2014 OHLCV candles (oldest-first) for crypto or stocks. Routes to Alpaca SIP / Alpaca-crypto / Coinbase.\n\n**Example:** `/v1/ohlcv?symbol=NVDA&timeframe=1h&limit=100`",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "class": {
    "description": "Optional. stock|crypto for non-curated symbols.",
    "type": "string"
   },
   "limit": {
    "description": "Optional. Candles to return (default 100, max 300).",
    "type": "number"
   },
   "symbol": {
    "description": "Required. e.g. BTC, NVDA, SPY.",
    "type": "string"
   },
   "timeframe": {
    "description": "Optional. 1m,5m,15m,30m,1h,2h,4h,6h,12h,1D,1W (default 1h).",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "ohlcv"
}
