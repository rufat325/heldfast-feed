 "description": "Checks an email address without sending mail or opening SMTP: syntax, domain exists, MX records (or RFC 5321 A/AAAA fallback), RFC 7505 null MX, MX host resolves, disposable-domain list (~9.9k domains), role account (info@, support@) and free provider. Verdict deliverable_domain, risky, undeliverable or unknown. Cannot prove the mailbox itself exists. Use when an agent validates a signup, lead or contact email before using it. $0.01 USDC. Paid tool: call it once to get the x402 PaymentRequired object, then retry with params._meta[\"x402/payment\"].",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "email": {
    "description": "Email address to check, e.g. someone@example.com",
    "examples": [
     "someone@gmail.com"
    ],
    "maxLength": 254,
    "minLength": 6,
    "type": "string"
   }
  },
  "required": [
   "email"
  ],
  "type": "object"
 },
