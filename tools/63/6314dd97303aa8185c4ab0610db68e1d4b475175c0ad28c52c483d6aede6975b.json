{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "The newest resources in one section: inspiration, components, motion, build, visuals, tools or learn. Use it to browse without a query, with the same filters as search_resources and cursor paging. Example: {\"vertical\": \"components\", \"technology\": \"react\", \"limit\": 20}",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Category slug or name, e.g. \"finance\", \"component-libraries\", \"typography\".",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "description": "next_cursor from the previous call, with the same query and filters. Omit for the first page.",
    "maxLength": 2000,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Results per page (1 to 50, default 20).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "open_source": {
    "description": "true: only open-source resources; false: only ones known not to be.",
    "type": "boolean"
   },
   "pricing": {
    "description": "Pricing model.",
    "enum": [
     "free",
     "freemium",
     "paid",
     "open_source"
    ],
    "type": "string"
   },
   "technology": {
    "description": "Technology slug or name, e.g. \"react\", \"tailwind-css\", \"three-js\".",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Resource type, e.g. \"website\", \"product\", \"library\", \"tool\", \"gallery\", \"article\".",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "vertical": {
    "description": "Section: \"inspiration\", \"components\", \"motion\", \"build\", \"visuals\", \"tools\" or \"learn\".",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "vertical"
  ],
  "type": "object"
 },
 "name": "browse_vertical",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "ignored_filters": {
    "description": "Filters this server could not apply yet; results are not narrowed by them.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": [
        "string",
        "null"
       ]
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "domain": {
       "type": "string"
      },
      "image_url": {
       "description": "Full-size preview (screenshot, else the site's OG image): the stored image file, served directly.",
       "type": [
        "string",
        "null"
       ]
      },
      "license": {
       "description": "SPDX licence id, e.g. \"MIT\".",
       "type": [
        "string",
        "null"
       ]
      },
      "match_reasons": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "notable_for": {
       "type": [
        "string",
        "null"
       ]
      },
      "open_source": {
       "description": "true: OSI-licensed; false: source-available or closed; null when unknown.",
       "type": [
        "boolean",
        "null"
       ]
      },
      "patterns": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "pricing": {
       "description": "free, freemium, paid or open_source; null when unknown.",
       "type": [
        "string",
        "null"
       ]
      },
      "sections": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "site_url": {
       "description": "The site's own address, untagged. Use it to compare, dedupe or cite.",
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "tangent_url": {
       "description": "This resource's page on Tangent.",
       "type": "string"
      },
      "thumbnail_url": {
       "description": "A smaller stored copy of image_url (a screenshot's 720px-wide WebP) when one exists; otherwise the same URL as image_url.",
       "type": [
        "string",
        "null"
       ]
      },
      "type": {
       "type": "string"
      },
      "url": {
       "description": "Visit link for the site (tagged utm_source=tangent-mcp). Use this one when linking people to the site.",
       "type": "string"
      }
     },
     "required": [
      "slug",
      "name",
      "url",
      "site_url",
      "tangent_url",
      "domain",
      "type",
      "description",
      "category",
      "sections",
      "patterns",
      "pricing",
      "open_source",
      "license",
      "notable_for",
      "image_url",
      "thumbnail_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "vertical": {
    "type": "string"
   }
  },
  "required": [
   "vertical",
   "results",
   "next_cursor"
  ],
  "type": "object"
 },
 "title": "Browse a section"
}
