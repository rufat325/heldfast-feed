{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Move selected timeline items to explicit times and layers. Revision checked; dryRun previews by default.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "minLength": 1,
       "type": "string"
      },
      "layerIndex": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "startSeconds": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "id",
      "startSeconds",
      "layerIndex"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "projectId": {
    "description": "UUID string.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "items",
   "workspaceId",
   "idempotencyKey",
   "projectId",
   "expectedRevision",
   "dryRun"
  ],
  "type": "object"
 },
 "name": "editor_items_move",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "editor items move"
}
