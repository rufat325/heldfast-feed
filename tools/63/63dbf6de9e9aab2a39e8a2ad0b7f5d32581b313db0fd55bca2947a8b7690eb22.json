{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "artifact.read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Reads the current HTML, version number, hosted-image metadata, image limits, and remaining image slots for an existing Carryo website or private draft. Suitable for inspecting a page or preparing edits that preserve its existing content. Returns image metadata rather than image files. Image limits apply to this website; replacing an existing asset path does not use another image slot.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "linkId": {
    "description": "Carryo page link identifier to read",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "linkId"
  ],
  "type": "object"
 },
 "name": "website.read",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assets": {
    "description": "Bundled asset descriptors",
    "items": {
     "additionalProperties": false,
     "properties": {
      "contentType": {
       "description": "Asset MIME type",
       "type": "string"
      },
      "path": {
       "description": "Relative asset path in the page asset bundle",
       "type": "string"
      },
      "sizeBytes": {
       "description": "Asset size in bytes",
       "type": "number"
      }
     },
     "required": [
      "path",
      "contentType",
      "sizeBytes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "currentVersionNumber": {
    "type": "number"
   },
   "forms": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "acknowledgementEmailField": {
       "type": "string"
      },
      "closed": {
       "type": "boolean"
      },
      "fields": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "label": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
         },
         "maxLength": {
          "maximum": 3000,
          "minimum": 1,
          "type": "integer"
         },
         "name": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
         },
         "options": {
          "items": {
           "maxLength": 200,
           "minLength": 1,
           "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array"
         },
         "required": {
          "type": "boolean"
         },
         "type": {
          "enum": [
           "text",
           "email",
           "tel",
           "number",
           "date",
           "textarea",
           "select",
           "checkbox",
           "radio"
          ],
          "type": "string"
         }
        },
        "required": [
         "name",
         "label",
         "type"
        ],
        "type": "object"
       },
       "maxItems": 30,
       "minItems": 1,
       "type": "array"
      },
      "key": {
       "pattern": "^[a-z][a-z0-9_-]{0,63}$",
       "type": "string"
      },
      "notifications": {
       "enum": [
        "enabled",
        "disabled",
        "unavailable"
       ],
       "type": "string"
      },
      "notifyOwner": {
       "type": "boolean"
      },
      "retentionDays": {
       "type": "number"
      },
      "revision": {
       "type": "number"
      },
      "state": {
       "enum": [
        "active",
        "draft",
        "closed",
        "unavailable"
       ],
       "type": "string"
      },
      "title": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "key",
      "title",
      "fields",
      "revision",
      "state",
      "retentionDays",
      "notifications"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "htmlContent": {
    "description": "Current HTML content for the page",
    "type": "string"
   },
   "imageLimits": {
    "additionalProperties": false,
    "description": "Hosted-image allowance for this website. Null counts mean no plan-specific cap. Existing images above a reduced limit can be kept or replaced, but the count cannot increase.",
    "properties": {
     "maxImages": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "remainingImages": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "usedImages": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "maxImages",
     "usedImages",
     "remainingImages"
    ],
    "type": "object"
   },
   "linkId": {
    "description": "Carryo page link identifier",
    "type": "string"
   }
  },
  "required": [
   "linkId",
   "htmlContent"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "artifact.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Read the Current Website"
}
