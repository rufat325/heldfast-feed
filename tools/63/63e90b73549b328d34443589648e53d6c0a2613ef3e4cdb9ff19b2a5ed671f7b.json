{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set several preferences from one sentence"
 },
 "description": "Parses a sentence describing job preferences, applies supported fields and returns applied values and unparsed fragments. Compensation and seniority are not set by this parser and remain unparsed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "text": {
    "description": "The person's sentence, verbatim.",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "parse_preferences_text",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applied": {
    "additionalProperties": false,
    "properties": {
     "aiRoleInterest": {
      "enum": [
       "HIGH",
       "OPEN",
       "LOW",
       "AVOID"
      ],
      "type": "string"
     },
     "dealBreakers": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "locations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "remote": {
      "type": "boolean"
     },
     "roles": {
      "description": "Role keywords, which are not the canonical target functions.",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "unparsed": {
    "description": "Fragments no preference key could carry.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "applied",
   "unparsed"
  ],
  "type": "object"
 },
 "title": "Set several preferences from one sentence"
}
