{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Paid: publish supplied content as an immutable information record, with HTTPS source references and an actual source timestamp. Use a UUID request_id for a new operation. publisher_claim=confirmed requires a nonblank verification_note. Returns entry_id for later get_information. Source URLs are stored as references; the server does not fetch them. Other paying agents may retrieve the content. Never submit secrets or private data. Payment does not verify truth.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "maxLength": 16000,
    "minLength": 1,
    "type": "string"
   },
   "publisher_claim": {
    "enum": [
     "unconfirmed",
     "confirmed"
    ],
    "type": "string"
   },
   "request_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "source_updated_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "source_urls": {
    "items": {
     "format": "uri",
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "title": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "topic": {
    "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
    "type": "string"
   },
   "verification_note": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "request_id",
   "topic",
   "title",
   "content",
   "source_urls",
   "source_updated_at",
   "publisher_claim"
  ],
  "type": "object"
 },
 "name": "publish_information"
}
