{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Rechercher dans les contenus Comontel"
 },
 "description": "Recherche plein texte dans les guides, la FAQ, le glossaire et les th\u00e8mes de comontel.fr. Renvoie titres, extraits et URL, du plus pertinent au moins pertinent. \u00c0 utiliser pour toute question qui ne rel\u00e8ve pas d\u2019un autre outil (portabilit\u00e9, eSIM, facture, TVA, r\u00e9seau\u2026). Param\u00e8tres : query (2 \u00e0 200 caract\u00e8res), limit (1 \u00e0 20, 8 par d\u00e9faut).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Nombre de r\u00e9sultats (8 par d\u00e9faut)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Mots-cl\u00e9s ou question",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_comontel_knowledge",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "La r\u00e9ponse ; null si l\u2019information demand\u00e9e n\u2019existe pas"
   },
   "provenance": {
    "type": "string"
   },
   "reviewed_at": {
    "description": "Derni\u00e8re v\u00e9rification (AAAA-MM-JJ)",
    "type": "string"
   },
   "source_url": {
    "description": "Page publique o\u00f9 l\u2019information est affich\u00e9e",
    "type": "string"
   },
   "status": {
    "description": "\u00ab inconnu \u00bb : ne jamais deviner ni compl\u00e9ter",
    "enum": [
     "valid\u00e9",
     "\u00e0 valider",
     "inconnu"
    ],
    "type": "string"
   },
   "updated_at": {
    "description": "Derni\u00e8re modification de la donn\u00e9e (AAAA-MM-JJ)",
    "type": "string"
   }
  },
  "required": [
   "data",
   "source_url",
   "updated_at",
   "reviewed_at",
   "provenance",
   "status"
  ],
  "type": "object"
 },
 "title": "Rechercher dans les contenus Comontel"
}
