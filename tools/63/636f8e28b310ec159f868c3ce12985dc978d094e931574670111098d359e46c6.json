{
 "description": "Iteratively refines generated output based on user feedback.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "audience": {
    "description": "Target audience",
    "enum": [
     "Junior Dev",
     "Senior Dev",
     "Tech Lead",
     "SRE",
     "Data Engineer"
    ],
    "type": "string"
   },
   "context": {
    "description": "Tech context",
    "enum": [
     "Backend",
     "Frontend",
     "Mobile",
     "Data/ML",
     "DevOps"
    ],
    "type": "string"
   },
   "contextProjectId": {
    "description": "Ground generation on a Context Project's instructions/assets",
    "type": "string"
   },
   "feedback": {
    "description": "User feedback / changes requested",
    "type": "string"
   },
   "format": {
    "description": "Output format",
    "enum": [
     "Technical Spec",
     "Jira Tickets",
     "API Design",
     "RFC",
     "Data Model",
     "Prompt",
     "Optimize"
    ],
    "type": "string"
   },
   "managedModel": {
    "description": "Pin a specific managed model (server-side allowlist)",
    "type": "string"
   },
   "originalInput": {
    "description": "Original user input",
    "type": "string"
   },
   "preserveMarkdown": {
    "description": "Preserve Markdown structure",
    "type": "boolean"
   },
   "previousOutput": {
    "description": "Previous generated output",
    "type": "string"
   },
   "responseFormat": {
    "description": "Output structure: prose Markdown, or machine-readable XML",
    "enum": [
     "markdown",
     "xml"
    ],
    "type": "string"
   },
   "tone": {
    "description": "Tone (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "webSearch": {
    "description": "Ground generation with real-time web search",
    "type": "boolean"
   }
  },
  "required": [
   "previousOutput",
   "feedback",
   "audience",
   "context",
   "format",
   "tone"
  ],
  "type": "object"
 },
 "name": "refine_translation"
}
