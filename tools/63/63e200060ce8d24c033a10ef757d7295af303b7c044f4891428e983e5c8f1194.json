  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Rebuild a CUSTOM deployment in place from its current source (re-pull image / re-clone the watched git ref at HEAD / rebuild) using the existing startup and recovery policy \u2014 domain, host port and URL never change. Prefer over uninstall+recreate for shipping a new build. Optional vars are merged before the rebuild. Uploaded-source apps may select a retained context_id for a new version; omission rebuilds the current retained archive. Build recipe and public build settings stay fixed. The selected source can differ from the running release after a failed replacement. Changing the stored image reference or Git repository/ref requires a new app; redeploy still fetches the watched ref's current HEAD. Read deployment history for the actual result. Use the owner portal secret-entry link for secret values rather than placing them in vars or the transcript.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "context_id": {
    "description": "Optional retained source version for an app created from an uploaded archive.",
    "type": "string"
   },
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   },
   "vars": {
    "description": "Optional non-secret environment changes merged before rebuilding; platform-managed variables are preserved. Use the owner portal secret-entry link for secret values.",
    "type": "object"
   },
   "zero_downtime": {
    "description": "Optional, this redeploy only: true runs a zero-downtime redeploy (the saved readiness settings, or GET / answering 200-399), false runs a normal in-place redeploy. Omit to use the app's saved setting. Refused, with the reason, for an app that does not qualify.",
    "type": "boolean"
   }
  },
  "required": [
   "deployment_id"
  ],
  "type": "object"
 },
