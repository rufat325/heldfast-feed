  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "chainpeek: stablecoin supply by coin and by chain with 1-day, 7-day and 30-day change (cached DefiLlama data)"
 },
 "description": "chainpeek: Get stablecoin supply by coin and chain. For whether a coin holds its peg use check_stablecoin_peg. Returns stablecoin supply by coin and chain with 1d, 7d and 30d change: a coin's chains, a chain's coins, or the largest coins and chains, from Tanod's cache of DefiLlama data. Input: optional `coin`, optional `chain` and `limit`; give one, both or neither. Cached DefiLlama data (refreshed every few hours), never live; `as_of` shows its age; an unknown name is a 422 with suggestions and a missing or over-2-day-old cache a 503 (neither charged). Informational only. Typically under 1 s (a local cache read). Price: USD 0.003. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/defi-data-api.html",
 "inputSchema": {
  "properties": {
   "chain": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^.*[A-Za-z0-9].*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Chain name, e.g. Ethereum, Tron, Solana, Base. With coin: that coin's supply on the chain. Alone: the chain's stablecoin supply and its largest coins.",
    "title": "Chain"
   },
   "coin": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^.*[A-Za-z0-9].*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Stablecoin symbol or name, e.g. USDT, USDC, DAI, USDe, PYUSD (symbols shared by several coins return each). Omit for a chain or the overview. An unknown coin is a 422 with suggestions.",
    "title": "Coin"
   },
   "limit": {
    "default": 10,
    "description": "Rows in a ranking or a breakdown, 1-50 (default 10).",
    "maximum": 50,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   }
  },
  "title": "get_stablecoin_supplyArguments",
  "type": "object"
 },
