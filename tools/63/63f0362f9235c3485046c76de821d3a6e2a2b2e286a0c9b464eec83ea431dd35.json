    "type": "string"
   },
   "cursor": {
    "description": "Continue with next_cursor from the previous result, keeping the same filters. Stop when next_cursor is null.",
    "maxLength": 1024,
    "type": "string"
   },
   "from": {
    "description": "Exact From address, case-insensitive.",
    "maxLength": 320,
    "type": "string"
   },
   "inbox_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "labels_all": {
    "description": "Require every listed label. An empty array in any label filter adds no condition.",
    "items": {
     "description": "Case-sensitive label, trimmed; at most 128 UTF-8 bytes, without control characters.",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "labels_any": {
    "description": "Require at least one listed label.",
    "items": {
     "description": "Case-sensitive label, trimmed; at most 128 UTF-8 bytes, without control characters.",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "labels_none": {
    "description": "Exclude messages with any listed label.",
    "items": {
     "description": "Case-sensitive label, trimmed; at most 128 UTF-8 bytes, without control characters.",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "order": {
    "description": "Defaults to newest. relevance requires query. Conversations sort by their latest activity.",
    "enum": [
     "newest",
     "oldest",
     "relevance"
    ],
    "type": "string"
   },
   "query": {
    "description": "Words or quoted phrases that must all appear in the subject or body. Case-insensitive keyword match, not semantic search; up to 16 terms or phrases.",
    "maxLength": 512,
    "type": "string"
   },
   "recipient": {
    "description": "Exact To, Cc or Bcc address, case-insensitive.",
    "maxLength": 320,
    "type": "string"
   },
   "subject": {
    "description": "Literal, case-insensitive substring of the subject.",
    "maxLength": 998,
    "type": "string"
   }
  },
  "required": [
   "inbox_id"
  ],
  "type": "object"
 },
