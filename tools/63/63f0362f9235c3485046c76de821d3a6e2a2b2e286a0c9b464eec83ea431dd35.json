  "readOnlyHint": true,
  "title": "Find conversations"
 },
 "description": "Find an inbox's conversations containing at least one message that matches all supplied filters.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Received or sent at or after this time: YYYY-MM-DDTHH:mm:ss, optional 1\u20133 fractional digits, then Z or \u00b1HH:mm.",
    "type": "string"
   },
   "before": {
