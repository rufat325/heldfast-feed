{
 "description": "Perform an action in Oculo browser: click, navigate, scroll, press key, hover, type, login. Elements found by ref (from a11y snapshot), text, role, label, placeholder, or CSS selector. After click/navigate/back/forward/reload, returns fresh ref-tagged snapshot. Use newTab with background=true to open tabs without switching, then use tabId to run actions in parallel.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "click",
     "navigate",
     "back",
     "forward",
     "scroll",
     "press",
     "hover",
     "select",
     "login",
     "reload",
     "screenshot",
     "screenshotSoM",
     "upload",
     "type",
     "focus",
     "clear",
     "newTab",
     "switchTab",
     "closeTab",
     "download",
     "listDownloads",
     "readFile",
     "writeFile",
     "clipboardImage",
     "smartScroll",
     "waitForText",
     "waitForNetworkIdle",
     "screenshotElement",
     "listTabs",
     "autoLogin",
     "monitorNetwork",
     "visualDiff",
     "detectAPIs",
     "iframeNavigate",
     "recordStart",
     "recordStop",
     "dragAndDrop",
     "extractPDF",
     "monitorWebSocket",
     "checkDialogs",
     "printToPDF",
     "getCookies",
     "setCookie",
     "deleteCookie",
     "getStorage",
     "setStorage",
     "clearStorage",
     "interceptNetwork",
     "drag",
     "clickAtPoint",
     "doubleClick",
     "rightClick",
     "tripleClick",
     "selectAll",
     "scrollIntoView",
     "waitForElement",
     "wait",
     "copy",
     "paste",
     "evaluate",
     "getAttribute",
     "solveCaptcha",
     "exportCookies",
     "importCookies",
     "setProxy",
     "clearProxy",
     "startRecording",
     "stopRecording"
    ],
    "type": "string"
   },
   "amount": {
    "description": "Scroll amount in pixels",
    "type": "number"
   },
   "attribute": {
    "description": "Attribute name for getAttribute action",
    "type": "string"
   },
   "autoSubmit": {
    "description": "Auto-submit after login (default: true)",
    "type": "boolean"
   },
   "background": {
    "description": "For newTab: open in background without switching (default: false). Returns tab ID for parallel execution.",
    "type": "boolean"
   },
   "clear": {
    "description": "Clear existing content before typing (for type action). Works with both regular inputs and contenteditable fields.",
    "type": "boolean"
   },
   "content": {
    "description": "File content for writeFile action",
    "type": "string"
   },
   "cookies": {
    "description": "Cookies array for importCookies action",
    "type": "array"
   },
   "direction": {
    "description": "Scroll direction",
    "enum": [
     "up",
     "down",
     "left",
     "right"
    ],
    "type": "string"
   },
   "expression": {
    "description": "JavaScript expression for evaluate action",
    "type": "string"
   },
   "from": {
    "description": "Drag source: {x, y} or {text, selector}",
    "type": "object"
   },
   "key": {
    "description": "Key to press (Enter, Tab, Escape, etc.)",
    "type": "string"
   },
   "label": {
    "description": "Label text associated with the element",
    "type": "string"
   },
   "modifiers": {
    "description": "Modifier keys (Ctrl, Shift, Alt, Meta)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Accessible name of the element",
    "type": "string"
   },
   "nth": {
    "description": "Which match to use (0-indexed, default: 0)",
    "type": "number"
   },
   "placeholder": {
    "description": "Placeholder text of the input",
    "type": "string"
   },
   "proxy": {
    "description": "Proxy config for setProxy action: {type, host, port, username?, password?, bypass?}",
    "properties": {
     "bypass": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "host": {
      "type": "string"
     },
     "password": {
      "type": "string"
     },
     "port": {
      "type": "number"
     },
     "type": {
      "enum": [
       "http",
       "https",
       "socks4",
       "socks5",
       "direct"
      ],
      "type": "string"
     },
     "username": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "ref": {
    "description": "Element ref from a11y snapshot (e.g. \"e5\"). Preferred over text/selector \u2014 use page({detail:\"a11y\"}) first.",
    "type": "string"
   },
   "role": {
    "description": "ARIA role (button, link, textbox, etc.)",
    "type": "string"
   },
   "screenshot": {
    "description": "Attach screenshot after action",
    "type": "boolean"
   },
   "selector": {
    "description": "CSS selector (fallback)",
    "type": "string"
   },
   "site": {
    "description": "Site domain for login action (uses credential vault)",
    "type": "string"
   },
   "tabId": {
    "description": "Target a specific tab by ID (for parallel execution). Omit for active tab.",
    "type": "string"
   },
   "text": {
    "description": "Visible text on the element to interact with",
    "type": "string"
   },
   "to": {
    "description": "Drag target: {x, y} or {text, selector}",
    "type": "object"
   },
   "url": {
    "description": "URL for navigate action",
    "type": "string"
   },
   "value": {
    "description": "Value for select action, file path for readFile/writeFile",
    "type": "string"
   },
   "x": {
    "description": "X coordinate for clickAtPoint/drag",
    "type": "number"
   },
   "y": {
    "description": "Y coordinate for clickAtPoint/drag",
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "act"
}
