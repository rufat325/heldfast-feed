{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update Template"
 },
 "description": "Update an existing template. IMPORTANT: Each layer must have a 'layer' field (unique identifier), not 'name'. Valid types: 'text', 'image', 'shape', 'rating'. For multi-page templates use 'pages': a page name that does not exist yet is ADDED to the template, an existing one has its layers merged (or replaced with replaceLayers). To change page sizes on a multi-size template set width/height per page inside 'pages'; top-level width/height are rejected there because they would resize every page.",
 "inputSchema": {
  "properties": {
   "background": {
    "description": "Template background color",
    "type": "string"
   },
   "description": {
    "description": "New template description",
    "type": "string"
   },
   "duration": {
    "description": "Default video duration in milliseconds for MP4 renders (e.g., 5000 for 5 seconds)",
    "type": "number"
   },
   "height": {
    "description": "New height in pixels. Applies to every page; rejected on multi-size templates (use per-page height inside 'pages')",
    "type": "number"
   },
   "layers": {
    "description": "Layer definitions. Each must have 'layer' (unique name) and 'type' (text/image/shape/rating).",
    "items": {
     "properties": {
      "animation": {
       "description": "Animation config for video (MP4) renders. All time values in milliseconds.",
       "properties": {
        "end": {
         "description": "When layer disappears (ms)",
         "type": "integer"
        },
        "in": {
         "properties": {
          "direction": {
           "type": "string"
          },
          "duration": {
           "type": "integer"
          },
          "type": {
           "type": "string"
          },
          "writingStyle": {
           "type": "string"
          }
         },
         "type": "object"
        },
        "loop": {
         "properties": {
          "duration": {
           "type": "integer"
          },
          "type": {
           "type": "string"
          }
         },
         "type": "object"
        },
        "out": {
         "properties": {
          "direction": {
           "type": "string"
          },
          "duration": {
           "type": "integer"
          },
          "type": {
           "type": "string"
          }
         },
         "type": "object"
        },
        "start": {
         "description": "When layer appears (ms)",
         "type": "integer"
        }
       },
       "type": "object"
      },
      "background": {
       "type": "string"
      },
      "color": {
       "type": "string"
      },
      "font_family": {
       "type": "string"
      },
      "font_size": {
       "type": "string"
      },
      "height": {
       "type": "number"
      },
      "html": {
       "description": "SVG content for shape layers",
       "type": "string"
      },
      "image_url": {
       "type": "string"
      },
      "layer": {
       "description": "REQUIRED: Unique layer identifier (NOT 'name')",
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "type": {
       "description": "Layer type",
       "enum": [
        "text",
        "image",
        "shape",
        "rating"
       ],
       "type": "string"
      },
      "width": {
       "type": "number"
      },
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      }
     },
     "required": [
      "layer",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "New template name",
    "type": "string"
   },
   "pages": {
    "description": "Pages for multi-page or multi-size templates (e.g. Instagram square, story and X landscape in ONE template, each with its own width/height). Use this INSTEAD of top-level 'layers'. Each page: 'page' (unique name), optional 'width'/'height' (fall back to the template size), and 'layers' as an OBJECT keyed by layer name (NOT an array). Same shape as get_template_pages returns.",
    "items": {
     "properties": {
      "height": {
       "description": "Page height in pixels (defaults to template height)",
       "type": "number"
      },
      "hide": {
       "description": "On update_template, true REMOVES the page from the template",
       "type": "boolean"
      },
      "layers": {
       "additionalProperties": {
        "properties": {
         "background": {
          "type": "string"
         },
         "color": {
          "type": "string"
         },
         "font_family": {
          "type": "string"
         },
         "font_size": {
          "description": "CSS size with unit, e.g. '48px'",
          "type": "string"
         },
         "height": {
          "type": "number"
         },
         "hide": {
          "type": "boolean"
         },
         "html": {
          "description": "SVG content for shape layers",
          "type": "string"
         },
         "image_url": {
          "type": "string"
         },
         "text": {
          "type": "string"
         },
         "type": {
          "description": "Layer type",
          "enum": [
           "text",
           "image",
           "shape",
           "rating"
          ],
          "type": "string"
         },
         "width": {
          "type": "number"
         },
         "x": {
          "type": "number"
         },
         "y": {
          "type": "number"
         }
        },
        "required": [
         "type"
        ],
        "type": "object"
       },
       "description": "Layers keyed by layer name: { \"title\": { \"type\": \"text\", \"text\": \"Hi\", ... } }",
       "type": "object"
      },
      "page": {
       "description": "Unique page name (e.g. 'Insta Story', 'X Landscape')",
       "type": "string"
      },
      "width": {
       "description": "Page width in pixels (defaults to template width)",
       "type": "number"
      }
     },
     "required": [
      "page",
      "layers"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "replaceLayers": {
    "description": "If true, replaces all layers. If false, merges with existing",
    "type": "boolean"
   },
   "template_id": {
    "description": "The template ID to update",
    "type": "string"
   },
   "width": {
    "description": "New width in pixels. Applies to every page; rejected on multi-size templates (use per-page width inside 'pages')",
    "type": "number"
   }
  },
  "required": [
   "template_id"
  ],
  "type": "object"
 },
 "name": "update_template"
}
