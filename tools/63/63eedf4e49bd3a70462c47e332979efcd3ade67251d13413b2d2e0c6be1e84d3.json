{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Configure IP ACL for an NKS cluster to restrict API server access. defaultAction (allow|deny) is required and applies to addresses not matched by entries.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clusterUuid": {
    "description": "UUID of the cluster",
    "type": "string"
   },
   "defaultAction": {
    "description": "Default action for addresses not matched by any entry",
    "enum": [
     "allow",
     "deny"
    ],
    "type": "string"
   },
   "entries": {
    "description": "IP ACL entries (optional)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "description": "ACL action for this entry",
       "enum": [
        "allow",
        "deny"
       ],
       "type": "string"
      },
      "address": {
       "description": "IP address or CIDR block",
       "type": "string"
      },
      "comment": {
       "description": "Free-text comment",
       "type": "string"
      }
     },
     "required": [
      "action",
      "address"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "clusterUuid",
   "defaultAction"
  ],
  "type": "object"
 },
 "name": "ncloud_nks_set_ip_acl"
}
