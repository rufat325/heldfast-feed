{
 "description": "List suppressed email addresses (bounces, complaints, unsubscribes, manual).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "description": "Send16 API key (overrides SEND16_API_KEY env var)",
    "type": "string"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "reason": {
    "enum": [
     "bounce",
     "complaint",
     "unsubscribe",
     "manual"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_suppressions"
}
