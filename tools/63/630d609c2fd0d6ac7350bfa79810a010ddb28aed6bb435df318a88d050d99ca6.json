  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Listet die Erfahrungsberichte von biohackingkompakt.de: Selbstversuche und recherchierte Berichte zu Supplements, Peptiden und Anwendungen, mit Dauer, Dosierung, Fazit sowie dem, was gut und was schlecht lief.\n\nWichtig zur Einordnung: Ein Erfahrungsbericht ist eine Einzelbeobachtung, kein Beleg. Er sagt nichts darueber aus, ob etwas wirkt - dafuer ist der BK-Score da (bk_get_topic).\nDiese Liste ist gefiltert: Berichte, die im Zusammenhang mit einem Partnerprogramm oder Rabattcode stehen, sind hier NICHT enthalten. `total` bezieht sich auf die gefilterte Liste. Auf biohackingkompakt.de stehen sie, dort als Anzeige gekennzeichnet.\n\nArgs:\n  - query (string): optionaler Suchbegriff\n  - kategorie (string): optionaler Kategoriefilter\n  - limit (1-50, Standard 10), offset, response_format\n\nReturns: { total, count, offset, items: [{ id, substanz, kategorie, autor, datum, dauer, dosis, bewertung, fazit, positiv[], negativ[], anzeige, shop_id }], has_more, next_offset }",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kategorie": {
    "description": "Kategorie, z. B. 'Supplement', 'Peptid'",
    "maxLength": 60,
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Hoechstzahl der Berichte (1-50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Wie viele Berichte uebersprungen werden",
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Suchbegriff in Substanz, Fazit und Bericht",
    "maxLength": 120,
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "description": "Ausgabeformat: 'markdown' zum Lesen, 'json' zum Weiterverarbeiten",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "bk_list_erfahrungen",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Zahl der Eintraege in dieser Antwort",
    "type": "number"
   },
   "enthaelt_werbung": {
    "description": "true = mindestens ein Bericht ist als Anzeige gekennzeichnet",
    "type": "boolean"
   },
   "has_more": {
    "description": "Ob es weitere Treffer gibt",
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "anzeige": {
       "type": "boolean"
      },
      "autor": {
       "$ref": "#/properties/items/items/properties/kategorie"
      },
      "bewertung": {
       "type": [
        "number",
        "null"
       ]
      },
      "datum": {
       "$ref": "#/properties/items/items/properties/kategorie"
      },
      "dauer": {
       "$ref": "#/properties/items/items/properties/kategorie"
      },
      "dosis": {
       "$ref": "#/properties/items/items/properties/kategorie"
      },
      "fazit": {
       "$ref": "#/properties/items/items/properties/kategorie"
      },
      "id": {
       "type": "string"
      },
      "kategorie": {
       "type": [
        "string",
        "null"
       ]
      },
      "negativ": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "positiv": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "shop_id": {
       "$ref": "#/properties/items/items/properties/kategorie"
      },
      "substanz": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "substanz",
      "kategorie",
      "autor",
      "datum",
      "dauer",
      "dosis",
      "bewertung",
      "fazit",
      "positiv",
      "negativ",
      "anzeige",
      "shop_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_offset": {
    "description": "offset fuer die naechste Seite",
    "type": "number"
   },
   "offset": {
    "description": "Wie viele uebersprungen wurden",
    "type": "number"
   },
   "total": {
    "description": "Gesamtzahl der Treffer",
    "type": "number"
   }
  },
  "required": [
   "total",
   "count",
   "offset",
   "has_more",
   "enthaelt_werbung",
   "items"
  ],
  "type": "object"
 },
 "title": "Erfahrungsberichte von Biohacking Kompakt"
