  "title": "Update conversation"
 },
 "description": "Update a conversation \u2014 assign/unassign users, add/remove shared labels, close/reopen, move to inbox, or set subject/color/team. Missive: PATCH /conversations/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "add_assignees": {
    "description": "User ids to assign.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "add_shared_labels": {
    "description": "Shared label ids to add.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "add_to_inbox": {
    "description": "Move the conversation back to the inbox.",
    "type": "boolean"
   },
   "close": {
    "description": "Close (archive) the conversation.",
    "type": "boolean"
   },
   "color": {
    "description": "Set the conversation color.",
    "type": "string"
   },
   "id": {
    "description": "The resource id (a UUID-like string).",
    "type": "string"
   },
   "organization": {
    "description": "Organization id (context for the update).",
    "type": "string"
   },
   "remove_assignees": {
    "description": "User ids to unassign.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "remove_shared_labels": {
    "description": "Shared label ids to remove.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reopen": {
    "description": "Reopen the conversation.",
