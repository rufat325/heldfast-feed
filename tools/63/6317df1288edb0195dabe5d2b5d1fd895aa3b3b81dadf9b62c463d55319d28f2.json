{
 "description": "Requires a ChainHelix API key as bearer token, or 6 cents per call paid over Binance b402 in USDT, USDC, USD1 or U on BNB Smart Chain, or over x402 in USDC on the Base network. The live ChainHelix signal stream, newest first. Each signal names chain, direction, entry price, win probability and a conviction score with its ranking tier, and each one is sealed on the opBNB chain before its outcome exists, typically within 5 minutes of being issued and at most about 30 minutes, so the record cannot be edited afterward. sealedAt is the time the signal was issued, committedAt the time its seal was written on chain. logOdds is the summed indicator score for the signal's direction; winProbability is that score calibrated on past outcomes, so it is not the plain logistic of logOdds. Verify any of them with the free proof tools. Optional chain, and limit up to 50",
 "inputSchema": {
  "properties": {
   "chain": {
    "enum": [
     "bitcoin",
     "ethereum",
     "bnb",
     "solana",
     "avalanche",
     "xrp",
     "tron",
     "polygon",
     "sui"
    ],
    "type": "string"
   },
   "limit": {
    "type": "number"
   }
  },
  "type": "object",
  "x-aliases": {
   "limit": [
    "Limit",
    "limits",
    "$limit",
    "_limit",
    "Limits"
   ]
  },
  "x-lexicon": {
   "bundleSha256": "e5b4290024a229f2bdf97f8fc6a0079c3fe13b77267f41fdcffeb8b26aa1c41e",
   "name": "ChainHelix Agentic Lexicon",
   "resolve": "lexicon_resolve",
   "spec": "lexicon_spec",
   "version": "0.1.0"
  },
  "x-vocab": {
   "chain": "onchain.chain",
   "limit": "data.limit"
  }
 },
 "name": "latest_signals",
