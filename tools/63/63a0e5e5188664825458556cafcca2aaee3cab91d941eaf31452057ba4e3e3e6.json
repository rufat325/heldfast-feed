{
 "description": "Add an income transaction to ZenMoney.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "account": {
    "description": "Account name or UUID to credit",
    "type": "string"
   },
   "amount": {
    "description": "Income amount (positive number)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "category": {
    "description": "Category name or UUID",
    "type": "string"
   },
   "comment": {
    "description": "Transaction comment",
    "type": "string"
   },
   "date": {
    "description": "Transaction date in YYYY-MM-DD format",
    "type": "string"
   },
   "payee": {
    "description": "Payer name",
    "type": "string"
   }
  },
  "required": [
   "account",
   "amount",
   "date"
  ],
  "type": "object"
 },
 "name": "add_income"
}
