{
 "description": "Search live flight offers and return normalized itineraries. Costs 0.05 USDC via x402 from the account wallet.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "adults": {
    "default": 1,
    "maximum": 9,
    "minimum": 1,
    "type": "number"
   },
   "children": {
    "default": 0,
    "maximum": 9,
    "minimum": 0,
    "type": "number"
   },
   "currency": {
    "description": "Optional 3-letter currency code for maxPrice comparison",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "departureDate": {
    "description": "Departure date as YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "destination": {
    "description": "IATA destination airport code, e.g. JFK",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "infants": {
    "default": 0,
    "maximum": 9,
    "minimum": 0,
    "type": "number"
   },
   "maxPrice": {
    "description": "Optional max total price filter; no currency conversion is applied",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "maxResults": {
    "default": 50,
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "nonStop": {
    "description": "When true, return non-stop offers only",
    "type": "boolean"
   },
   "origin": {
    "description": "IATA origin airport code, e.g. SFO",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "returnDate": {
    "description": "Optional return date as YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "travelClass": {
    "default": "ECONOMY",
    "enum": [
     "ECONOMY",
     "PREMIUM_ECONOMY",
     "BUSINESS",
     "FIRST"
    ],
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination",
   "departureDate"
  ],
  "type": "object"
 },
 "name": "search_flights"
}
