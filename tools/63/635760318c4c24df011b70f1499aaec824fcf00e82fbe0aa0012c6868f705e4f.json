{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Create one advertisement. New ads are paused with a zero budget unless you pass is_paused: false and initial_budget. Money values must match the account currency precision (EUR/TON: 2 decimals, XTR: 0). Telegram requires text unless target.type is search, and at most one of photo_id/video_id. Use dry_run: true to validate without calling the API. Requires confirm: true and TG_ADS_MODE=write.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"account_id":{"type":"string"},"activate_date":{"description":"Unix seconds.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"additional_info":{"type":"string"},"button":{"enum":["subscribe","view","read","learn_more","download","open","sign_up","buy","order","play","try","leave_request"],"type":"string"},"confirm":{"type":"boolean"},"conversion_event_id":{"type":"string"},"cpm":{"description":"Price per 1000 impressions in the account currency.","exclusiveMinimum":0,"type":"number"},"daily_budget_limit":{"description":"0 disables the daily limit.","minimum":0,"type":"number"},"deactivate_date":{"description":"Unix seconds.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"dry_run":{"type":"boolean"},"idempotency_key":{"maxLength":128,"minLength":1,"type":"string"},"impression_frequency":{"maximum":4,"minimum":1,"type":"integer"},"initial_budget":{"description":"Defaults to 0, which keeps the ad unfunded.","minimum":0,"type":"number"},"is_paused":{"description":"Defaults to true.","type":"boolean"},"photo_id":{"minLength":1,"type":"string"},"placement":{"enum":["channel_post","bot_banner","search_result","video_banner"],"type":"string"},"promote_url":{"format":"uri","maxLength":256,"type":"string"},"schedule":{"properties":{"timezone":{"description":"Offset in seconds from UTC. Required unless use_viewer_timezone is true.","maximum":50400,"minimum":-43200,"mult