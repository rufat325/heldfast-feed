{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a message (SMS, Email, WhatsApp, or other) to a contact via GoHighLevel.\n\nArgs:\n  - type: \"SMS\", \"Email\", \"WhatsApp\", \"GMB\", \"IG\", \"FB\", \"Custom\", \"Live_Chat\"\n  - contactId: The recipient contact ID\n  - message: The message body (text for SMS/WhatsApp, HTML for email)\n  - subject: Email subject (required for Email type)\n  - emailFrom: Sender email (for Email type)\n  - html: HTML body (for Email type, alternative to message)\n  - scheduledTimestamp: ISO timestamp to schedule future send\n\nReturns: Sent message object with ID and status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contactId": {
    "description": "Recipient contact ID",
    "type": "string"
   },
   "conversationId": {
    "description": "Existing conversation ID (auto-created if omitted)",
    "type": "string"
   },
   "conversationProviderId": {
    "description": "Provider ID for the conversation",
    "type": "string"
   },
   "emailFrom": {
    "description": "Sender email address",
    "type": "string"
   },
   "emailReplyMode": {
    "enum": [
     "reply",
     "reply_all"
    ],
    "type": "string"
   },
   "html": {
    "description": "HTML email body",
    "type": "string"
   },
   "message": {
    "description": "Message body (text for SMS/WhatsApp)",
    "type": "string"
   },
   "scheduledTimestamp": {
    "description": "Schedule send time (ISO 8601)",
    "type": "string"
   },
   "subject": {
    "description": "Email subject line",
    "type": "string"
   },
   "type": {
    "description": "Message channel",
    "enum": [
     "SMS",
     "Email",
     "WhatsApp",
     "GMB",
     "IG",
     "FB",
     "Custom",
     "Live_Chat"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "contactId"
  ],
  "type": "object"
 },
 "name": "ghl_send_message",
 "title": "Send Message via GHL"
}
