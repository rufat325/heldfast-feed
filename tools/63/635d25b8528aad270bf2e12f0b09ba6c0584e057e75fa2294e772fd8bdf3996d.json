{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Enrich creators"},"description":"Run shortlist AI enrichment (niche, celebrity, evidence, signal) for creators from search_creators. It takes the same creators array, query string (search query.q), and the shortlistId search_creators returned with them. Returns one analysis object per creatorId. A shortlistId works once, for 4 hours, and only for the caller who searched; enrichment spends no credits. Holds the call open until the result, up to 800 seconds.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"properties":{"creators":{"description":"The creators array exactly as returned by search_creators, unmodified; the shortlist is bound to it","items":{"additionalProperties":true,"properties":{"averageViews":{"anyOf":[{"maximum":9007199254740991,"minimum":0,"type":"integer"},{"type":"null"}],"description":"Mean views of the creator's 6 newest posts with a stored video, counting the posts that have views. Null when none of them has views."},"bio":{"anyOf":[{"type":"string"},{"type":"null"}]},"country":{"anyOf":[{"type":"string"},{"type":"null"}]},"emails":{"default":[],"description":"Contact addresses for this organization after Reveal contact. Empty until then.","items":{"format":"email","type":"string"},"type":"array"},"engagementOnViews":{"anyOf":[{"minimum":0,"type":"number"},{"type":"null"}],"description":"Mean of likes plus comments per view over the same posts as averageViews. Null when none of them has views."},"externalUrl":{"anyOf":[{"format":"uri","type":"string"},{"type":"null"}]},"fitScore":{"maximum":1,"minimum":0,"type":"number"},"followerCount":{"allOf":[{"maximum":9007199254740991,"minimum":-9007199254740991},{"maximum":2147483647,"minimum":-2147483648}],"minimum":1000,"type":"integer"},"hasContact":{"default":false,"description":"True when a contact address exists. The address is omitted until this organization reveals it.","type":"boolean"},"id":{"minLength":1,"type":"string"},"isVerified":{"type":"boolean"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"platform":{"enum":["ig","tt"],"type":"string"},"profileImageUrl":{"anyOf":[{"format":"uri","type":"string"},{"type":"null"}]},"tier":{"enum":["nano","micro","mid","macro","mega"],"type":"string"},"username":{"anyOf":[{"type":"string"},{"type":"null"}]},"videos":{"items":{"additionalProperties":true,"properties":{"bunnyStreamId":{"anyOf":[{"type":"string"},{"type":"null"}]},"caption":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Video caption, truncated to the first 500 characters."},"commentCount":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"id":{"minLength":1,"type":"string"},"isAd":{"type":"boolean"},"isSponsored":{"type":"boolean"},"likeCount":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"playCount":{"anyOf":[{"maximum":9007199254740991,"minimum":0,"type":"integer"},{"type":"null"}]},"playUrl":{"anyOf":[{"format":"uri","type":"string"},{"type":"null"}],"description":"Signed video URL. It expires within 24 hours. Search again for a new URL."},"postedAt":{"format":"date-time","pattern":"^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$","type":"string"},"score":{"type":"number"},"thumbnailUrl":{"anyOf":[{"format":"uri","type":"string"},{"type":"null"}],"description":"Signed thumbnail URL. It expires within 24 hours. Search again for a new URL."},"webUrl":{"format":"uri","type":"string"}},"required":["bunnyStreamId","caption","commentCount","id","isAd","isSponsored","likeCount","playCount","playUrl","postedAt","score","thumbnailUrl","webUrl"],"type":"object"},"type":"array"}},"required":["bio","country","fitScore","followerCount","id","isVerified","name","platform","profileImageUrl","tier","username","videos"],"type":"object"},"maxItems":100,"minItems":1,"type":"array"},"query":{"description":"The query.q string returned by search_creators","maxLength":200,"pattern":"^[^\\u0000]*[^\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u0300-\\u036F\\u034F\\u061C\\u115F\\u1160\\u1680\\u17B4\\u17B5\\u180B-\\u180F\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u206F\\u20D0-\\u20F0\\u2800\\u3000\\u3164\\uFE00-\\uFE0F\\uFE20-\\uFE2F\\uFEFF\\uFFA0\\uFFF0-\\uFFF8][^\\u0000]*$","type":"string"},"shortlistId":{"description":"The shortlistId search_creators returned with these creators","minLength":1,"type":"string"}},"required":["creators","query","shortlistId"],"type":"object"},"name":"enrich_creators","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{"additionalProperties":true,"properties":{"celebrity":{"type":"boolean"},"evidence":{"anyOf":[{"additionalProperties":true,"properties":{"lines":{"items":{"additionalProperties":true,"properties":{"metric":{"description":"Primary evidence metric or claim","type":"string"},"tag":{"description":"Short supporting tag","type":"string"},"tone":{"enum":["fit","growth","trust"],"type":"string"}},"required":["metric","tag","tone"],"type":"object"},"maxItems":3,"minItems":1,"type":"array"}},"required":["lines"],"type":"object"},{"type":"null"}]},"niche":{"anyOf":[{"type":"string"},{"type":"null"}]},"signal":{"anyOf":[{"additionalProperties":true,"properties":{"headline":{"description":"One-line signal detail; empty when kind is none","type":"string"},"kind":{"enum":["competitor_collab","hidden_pick","none","rising"],"type":"string"},"short":{"description":"Two or three word cell label; empty when kind is none","type":"string"}},"required":["headline","kind","short"],"type":"object"},{"type":"null"}]}},"required":["celebrity","evidence","niche","signal"],"type":"object"},"type":"object"},"title":"Enrich creators"}
