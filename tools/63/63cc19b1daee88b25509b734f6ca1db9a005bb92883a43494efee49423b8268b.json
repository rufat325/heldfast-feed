{
 "description": "Poll a run until it reaches a terminal state (complete/partial/failed) or the timeout. Returns the final run status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "runId": {
    "type": "string"
   },
   "timeoutSeconds": {
    "description": "default 600",
    "maximum": 900,
    "minimum": 5,
    "type": "integer"
   }
  },
  "required": [
   "runId"
  ],
  "type": "object"
 },
 "name": "wait_for_run",
 "title": "Wait for run"
}
