{
 "description": "List jobs in a project with optional filtering by group, name, or tags",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "groupPath": {
    "description": "Filter by group path (e.g., 'admin/utils')",
    "type": "string"
   },
   "jobFilter": {
    "description": "Filter by job name (substring match)",
    "type": "string"
   },
   "max": {
    "description": "Max results (default 20)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "integer"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "scheduledFilter": {
    "description": "Filter by scheduled status",
    "type": "boolean"
   },
   "tags": {
    "description": "Filter by tags (comma-separated)",
    "type": "string"
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "name": "rundeck_list_jobs"
}
