{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Record one or more probe rounds in the log. Any credential works, even when auth mode is off. Does not create tickets or change settings. Then call run_query with schema=counters (or trace, when the call trace is on).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "rounds": {
    "description": "How many probe rounds to record. Default 1.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "generate_traffic",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "changed": {
    "const": false,
    "type": "boolean"
   },
   "next": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "rounds": {
    "type": "number"
   }
  },
  "required": [
   "ok",
   "rounds",
   "changed",
   "next"
  ],
  "type": "object"
 }
}
