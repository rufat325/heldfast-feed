{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"\ud604\ud589 \ud611\uc758\ud68c\uaddc\uc815 \uc804\ubb38\uacfc \uac1c\uc815 \ud611\uc758\ud68c\uaddc\uc815 \uc804\ubb38\uc744 \ubc1b\uc544 \ubc14\ub010 \uacf3\ub9cc \u300c\ud604 \ud589 | \uac1c \uc815 \uc548\u300d \uc2e0\u00b7\uad6c\uc870\ubb38\ub300\ube44\ud45c\ub85c \ub9cc\ub4e0\ub2e4(\uc2dc\ud589\uaddc\uce59 \uc81c3\uc870\uc81c1\ud56d\uc81c2\ud638, 2023. 6. 8. \uac1c\uc815: \uaddc\uc815\uc744 \ubcc0\uacbd\ud574 \uc81c\ucd9c\ud560 \ub54c \ubd99\uc774\ub294 \uc11c\ub958). \ud45c\uc9c0\u00b7\uc870\u00b7\ud56d\u00b7\ud638\u00b7\ubd80\uce59\u00b7\ubcc4\uc9c0 \uc11c\uc2dd\uc73c\ub85c \ub098\ub220 \uae00\uc790\uac00 \ube44\uc2b7\ud55c \uac83\ub07c\ub9ac \uc9dd\uc9d3\uace0(\ubc88\ud638\uac00 \ubc00\ub9b0 \ud638\ub3c4 \ub0b4\uc6a9\uc73c\ub85c \ub9de\ucd98\ub2e4), \ubc14\ub010 \uae00\uc790\ub294 \uc5b4\uc808 \ub2e8\uc704\ub85c \uc591\ucabd\uc5d0 \ubc11\uc904\uc744 \uae0b\ub294\ub2e4. \uc548 \ubc14\ub010 \ud56d\u00b7\ud638\ub294 \ud604\ud589 \ucabd \u300c(\uc0dd\ub7b5)\u300d, \uac1c\uc815\uc548 \ucabd \u300c(\ud604\ud589\uacfc \uac19\uc74c)\u300d, \uc0c8\ub85c \uc0dd\uae34 \uac83\uc740 \u300c<\uc2e0 \uc124>\u300d, \uc5c6\uc564 \uac83\uc740 \u300c<\uc0ad \uc81c>\u300d\ub85c \uc801\ub294\ub2e4. \ub9c8\ud06c\ub2e4\uc6b4 \ud45c\ub97c \uacb0\uacfc\ub85c \ub3cc\ub824\uc8fc\uace0, outDir \uc5d0 docx\u00b7hwpx(\uac00\ub85c A4, \ubc11\uc904)\u00b7xlsx(\ubc11\uc904 \uc5c6\uc74c)\ub97c \ub9cc\ub4e0\ub2e4. \uaddc\uc815\uc740 \uae00(currentText\u00b7amendedText)\uc774\ub098 \uc774 PC \uc758 \ud30c\uc77c(hwp\u00b7hwpx\u00b7docx\u00b7pdf\u00b7txt\u00b7md) \uacbd\ub85c\ub85c \uc900\ub2e4. \uc774\ubbf8 \uc788\ub294 \ud30c\uc77c\uc740 \ub36e\uc5b4\uc4f0\uc9c0 \uc54a\ub294\ub2e4. \ubcf8\ubb38\uc740 \uc774 PC \ubc16\uc73c\ub85c \ub098\uac00\uc9c0 \uc54a\ub294\ub2e4. \uc8fc\ubbfc\ub4f1\ub85d\ubc88\ud638 \ubaa8\uc591\uc758 \uc22b\uc790\uac00 \uc788\uc73c\uba74 \uba48\ucd98\ub2e4. \ubcc4\uc9c0 \uc11c\uc2dd\uc758 \ud45c\ub294 \uae00\uc790\ub85c \uc77d\ud78c \ub9cc\ud07c\ub9cc \ub300\uc870\ud55c\ub2e4.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"amendDate":{"description":"\uac1c\uc815\uc77c(\uc81c\ubaa9 \uc544\ub798\uc5d0 \uc801\ub294\ub2e4, \uc608: 2026. 12. 1.)","maxLength":40,"type":"string"},"amendedFile":{"description":"\uac1c\uc815 \ud611\uc758\ud68c\uaddc\uc815 \ud30c\uc77c \uacbd\ub85c(hwp\u00b7hwpx\u00b7docx\u00b7pdf\u00b7txt\u00b7md, 10MB \uc774\ud558)","maxLength":400,"type":"string"},"amendedText":{"description":"\uac1c\uc815 \ud611\uc758\ud68c\uaddc\uc815 \uc804\ubb38(\uae00). amendedFile \uacfc \ub458 \uc911 \ud558\ub098","maxLength":300000,"type":"string"},"currentFile":{"description":"\ud604\ud589 \ud611\uc758\ud68c\uaddc\uc815 \ud30c\uc77c \uacbd\ub85c(hwp\u00b7hwpx\u00b7docx\u00b7pdf\u00b7txt\u00b7md, 10MB \uc774\ud558)","maxLength":400,"type":"string"},"currentText":{"description":"\ud604\ud589 \ud611\uc758\ud68c\uaddc\uc815 \uc804\ubb38(\uae00). currentFile \uacfc \ub458 \uc911 \ud558\ub098","maxLength":300000,"type":"string"},"fileBase":{"description":"\ud30c\uc77c \uc774\ub984 \uc55e\ubd80\ubd84(\uae30\ubcf8 \u300c\ud611\uc758\ud68c\uaddc\uc815\u300d)","maxLength":80,"type":"string"},"formats":{"description":"\ub9cc\ub4e4 \ud615\uc2dd(\uae30\ubcf8 docx\u00b7hwpx)","items":{"enum":["docx","hwpx","xlsx"],"type":"string"},"type":"array"},"outDir":{"description":"\uc800\uc7a5\ud560 \ud3f4\ub354(\uc5c6\uc73c\uba74 \ub9cc\ub4e0\ub2e4)","type":"string"},"workplaceName":{"description":"\uc0ac\uc5c5\uc7a5\uba85(\uc81c\ubaa9). \ube44\uc6b0\uba74 \ubcf8\ubb38\uc758 \u300c\uc0ac\uc5c5\uc7a5\uba85 :\u300d \uc904\uc5d0\uc11c \ucc3e\ub294\ub2e4","maxLength":100,"type":"string"}},"required":["outDir"],"type":"object"},"name":"make_council_rules_comparison","title":"\ub178\uc0ac\ud611\uc758\ud68c \ud611\uc758\ud68c\uaddc\uc815 \