 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Price the storyboard pictures"
 },
 "description": "Prices selected storyboard pictures without spending. Supports missing pictures or new_version for exactly one existing picture, bound to the current revision, quality and stableShotIds. lookTest:true selects the saved bounded key-look set. Returns a signed picture-only quote and exact confirmation fields. Missing operationId is derived by the server; new_version uses a stable op_ ID. Chat approval and existing issued confirmation codes are supported. Short balance returns credit information only. This quote covers no video or planning model.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "lookTest": {
    "const": true,
    "description": "For missing mode, true selects the approved storyboard\u2019s saved key-look set. In this mode stableShotIds and operationId are absent.",
    "type": "boolean"
   },
   "mode": {
    "description": "missing prepares selected shots without pictures; new_version buys another picture for exactly one shot that already has one.",
    "enum": [
     "missing",
     "new_version"
    ],
    "type": "string"
   },
   "operationId": {
    "description": "Stable operationId from the picture quote. A new_version operation uses op_ followed by 10\u2013120 letters, digits, underscores or dashes.",
    "maxLength": 130,
    "minLength": 1,
    "pattern": "^op_[A-Za-z0-9_-]{10,120}$",
    "type": "string"
   },
   "projectId": {
    "description": "The music-video or Film project id.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "quality": {
    "description": "The customer\u2019s explicit picture quality; high is the app\u2019s best-picture option.",
    "enum": [
     "medium",
     "high"
    ],
    "type": "string"
   },
   "revisionId": {
    "description": "Exact storyboard revisionId from studio_sections_read. Identical retries retain the originally quoted revision.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "stableShotIds": {
    "items": {
     "description": "A stableShotId on this exact storyboard.",
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "projectId",
   "revisionId",
   "mode",
   "quality"
  ],
  "type": "object"
 },
