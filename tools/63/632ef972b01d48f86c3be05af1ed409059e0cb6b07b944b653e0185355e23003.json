{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read Redis health and sanitized SLOWLOG samples for a configured source. Never scans all keys, reads values or executes write commands.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "sourceId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "sourceId"
  ],
  "type": "object"
 },
 "name": "inspect_redis",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "ok",
     "error"
    ],
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 }
}
