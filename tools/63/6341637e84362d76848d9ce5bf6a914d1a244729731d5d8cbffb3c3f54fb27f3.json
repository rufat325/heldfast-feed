{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "visibility": [
    "app"
   ]
  },
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Return an editor receipt"
 },
 "description": "Records the editor's receipt for one exact preference or device request, including the person's later choice of a preference.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "editorId": {
    "maxLength": 128,
    "type": "string"
   },
   "editorKey": {
    "description": "The editor key from private tool-result _meta.rapier, held by the host and editor alone.",
    "maxLength": 512,
    "type": "string"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "fact": {
    "additionalProperties": false,
    "properties": {
     "documentId": {
      "maxLength": 128,
      "type": "string"
     },
     "kind": {
      "const": "editor",
      "type": "string"
     },
     "operation": {
      "enum": [
       "document.set_view",
       "document.ask_editor"
      ],
      "type": "string"
     },
     "receipt": {
      "additionalProperties": false,
      "properties": {
       "action": {
        "enum": [
         "read_aloud",
         "copy",
         "open_file",
         "install_plugin"
        ],
        "type": "string"
       },
       "current": {
        "maxLength": 256,
        "type": [
         "string",
         "boolean"
        ]
       },
       "id": {
        "maxLength": 128,
        "type": "string"
       },
       "preference": {
        "enum": [
         "accent",
         "theme",
         "fontSize",
         "checker",
         "assets",
         "lineNums",
         "imageStorage",
         "inkColour",
         "inkWidth",
         "inkStylus",
         "wrap",
         "dim",
         "lineFit",
         "readOnly",
         "showPlayButton",
         "highlights",
         "highlightColor",
         "headings",
         "layout",
         "notesSkills",
         "notesStart",
         "notesSort",
         "notesLayout",
         "notesColour"
        ],
        "type": "string"
       },
       "previous": {
        "maxLength": 256,
        "type": [
         "string",
         "boolean"
        ]
       },
       "reason": {
        "maxLength": 96,
        "type": "string"
       },
       "status": {
        "enum": [
         "applied",
         "waiting",
         "done",
         "declined",
         "unavailable"
        ],
        "type": "string"
       },
       "superseded": {
        "type": "boolean"
       },
       "value": {
        "maxLength": 256,
        "type": [
         "string",
         "boolean"
        ]
       }
      },
      "required": [
       "status"
      ],
      "type": "object"
     },
     "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "kind",
     "documentId",
     "revision",
     "operation",
     "receipt"
    ],
    "type": "object"
   }
  },
  "required": [
   "document",
   "editorKey",
   "expectedRevision",
   "editorId",
   "fact"
  ],
  "type": "object"
 },
 "name": "document.editor_ack",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "editorId": {
    "maxLength": 128,
    "type": "string"
   },
   "outcome": {
    "enum": [
     "ok",
     "refused",
     "uncertain"
    ],
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "receipt": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "type": "string"
     },
     "current": {
      "type": [
       "string",
       "boolean"
      ]
     },
     "id": {
      "maxLength": 128,
      "type": "string"
     },
     "preference": {
      "type": "string"
     },
     "previous": {
      "type": [
       "string",
       "boolean"
      ]
     },
     "reason": {
      "type": "string"
     },
     "status": {
      "enum": [
       "applied",
       "waiting",
       "done",
       "declined",
       "unavailable"
      ],
      "type": "string"
     },
     "superseded": {
      "type": "boolean"
     },
     "value": {
      "type": [
       "string",
       "boolean"
      ]
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Return an editor receipt"
}
