{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Guided purchase (text)"
 },
 "description": "Stateful text-only purchase flow for clients without widget support. Called repeatedly with the same session_token, one question at a time, until status is \"complete\"; the first call takes empty arguments. The final \"confirm\" answer creates a real order.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "\"back\" to return to the previous step",
    "type": "string"
   },
   "answer": {
    "description": "Answer to the current question",
    "type": "string"
   },
   "session_token": {
    "description": "Omit on the first call \u2014 a new session is minted",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "purchase_wizard",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "error": {
    "type": "string"
   },
   "hint": {
    "type": "string"
   },
   "options": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "question": {
    "description": "Ask the user this",
    "type": "string"
   },
   "result": {
    "additionalProperties": true,
    "properties": {
     "coin": {
      "type": "string"
     },
     "error": {
      "description": "Present on failure: KYC_MISSING | FULLNAME_MISSING | PHONE_MISSING | CONFIRM_TOKEN_*",
      "type": "string"
     },
     "external_order_id": {
      "type": "string"
     },
     "instructions": {
      "type": "string"
     },
     "kyc_url": {
      "description": "Hosted verification link when error=KYC_MISSING",
      "type": "string"
     },
     "network": {
      "description": "Exact network \u2014 funds sent elsewhere are lost",
      "type": "string"
     },
     "network_label": {
      "type": "string"
     },
     "pay_amount": {
      "description": "EXACT amount to send",
      "type": "number"
     },
     "pay_to_address": {
      "description": "Wallet address to send funds to",
      "type": "string"
     },
     "payment_expires_at": {
      "description": "ISO timestamp; 30-minute window",
      "type": "string"
     },
     "payment_url": {
      "description": "Payment page with QR",
      "type": "string"
     },
     "qr_url": {
      "description": "QR code PNG of the address",
      "type": "string"
     },
     "state": {
      "description": "CREATED | WAITING_FOR_PAYMENT | PARTIAL | COMPLETED | CANCELED | EXPIRED",
      "type": "string"
     },
     "status_token": {
      "type": "string"
     },
     "status_url": {
      "description": "Live order-status page",
      "type": "string"
     }
    },
    "required": [],
    "type": "object"
   },
   "session_token": {
    "description": "Pass back on every call of this session",
    "type": "string"
   },
   "status": {
    "description": "in_progress | complete | error",
    "type": "string"
   },
   "step": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "session_token"
  ],
  "type": "object"
 },
 "title": "Guided purchase (text)"
}
