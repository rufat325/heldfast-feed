{
 "description": "Preferred structured discovery. Filter by category, partial colour name or required supported width/drop in mm. Returns results containing product_id, name, category and product_url, plus total. Width/drop filters check separate maximums, not every combination; confirm the exact pair with get_price.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "roller | venetian | honeycomb | vertical | outdoor",
    "type": "string"
   },
   "colour": {
    "type": "string"
   },
   "max_height_mm": {
    "type": "number"
   },
   "max_width_mm": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "lookup_catalog",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "category": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "product_id": {
       "type": "string"
      },
      "product_url": {
       "type": "string"
      }
     },
     "required": [
      "product_id",
      "name",
      "category",
      "product_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "results",
   "total"
  ],
  "type": "object"
 }
}
