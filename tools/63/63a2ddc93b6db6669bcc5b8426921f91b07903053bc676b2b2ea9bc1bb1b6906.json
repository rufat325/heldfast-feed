{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Search credential types"},"description":"Search the FIDES credential catalog for credential type definitions (schema, VC format, subject kind, authority, sectors, ecosystems, themes). Note: this returns credential definitions only, not issuers \u2014 use search_issuers for who issues a credential. Returns a compact, paginated list with canonical detail URLs.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"authority":{"description":"Free-text, case-insensitive partial match on authority name","type":"string"},"category":{"description":"Comma-separated category codes, e.g. 'identity,finance,health'","type":"string"},"credentialKind":{"description":"Subject kind of the credential","enum":["PERSONAL","ORGANIZATIONAL","PRODUCT","UNKNOWN"],"type":"string"},"direction":{"description":"Sort direction","enum":["asc","desc"],"type":"string"},"ecosystem":{"description":"Comma-separated ecosystem codes, e.g. 'eudi_wallet,gaia_x'","type":"string"},"hasIssuers":{"description":"Only credentials that have (true) or lack (false) known issuers","type":"boolean"},"page":{"description":"Zero-based page (default 0)","minimum":0,"type":"integer"},"sector":{"description":"Comma-separated sector codes, e.g. 'public_sector,finance,healthcare'","type":"string"},"size":{"description":"Page size, max 50 (default 20)","maximum":50,"minimum":1,"type":"integer"},"sort":{"description":"Sort field","enum":["id","vcFormat","credentialKind"],"type":"string"},"tags":{"description":"Free-text, case-insensitive partial match on tags","type":"string"},"theme":{"description":"Comma-separated theme codes, e.g. 'person_identity,payments'","type":"string"},"vcFormat":{"description":"Comma-separated VC formats, e.g. 'sd_jwt_vc,mdoc'","type":"string"}},"type":"object"},"name":"search_credential_types"}
