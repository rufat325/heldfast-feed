{
 "description": "[deprecated in v3.0.0 \u2014 use gateway.aeoess.com REST API] Create an enforcement context that automatically runs every action through the 3-signature policy chain.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "delegated_scopes": {
    "default": [],
    "description": "Scopes to delegate",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "enforcement": {
    "default": "auto",
    "description": "Enforcement level",
    "enum": [
     "auto",
     "manual",
     "strict"
    ],
    "type": "string"
   },
   "mission": {
    "description": "Agent mission statement",
    "type": "string"
   },
   "name": {
    "description": "Agent name",
    "type": "string"
   },
   "spend_limit": {
    "default": 1000,
    "description": "Maximum spend allowed",
    "type": "number"
   }
  },
  "required": [
   "name",
   "mission"
  ],
  "type": "object"
 },
 "name": "create_agent_context"
}
