{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Insider Trades (Form 4)"
 },
 "description": "Recent insider buying and selling at a US public company, by stock ticker or CIK: who traded (director, officer, 10% owner), transaction date, buy/sell/grant code with its plain meaning, shares, price, and shares held after, parsed from Form 4 filings. An option or RSU that vests shows as two rows in the same filing: the derivative given up and the common stock received. Data source: SEC EDGAR public filings (free public data; not affiliated with or endorsed by the SEC). Price: $0.03 per successful call; failed calls are free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "api_key": {
    "description": "Your Unstuck API key, if this connection has none. Leave empty to try free tools or to get a key and payment link.",
    "maxLength": 200,
    "type": "string"
   },
   "limit": {
    "description": "How many recent Form 4 filings to read, newest first. Default 10, max 20.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "ticker_or_cik": {
    "description": "Stock ticker (e.g. \"AAPL\", \"BRK.B\") or the company's numeric SEC CIK (e.g. \"320193\").",
    "maxLength": 12,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9.\\-]+$",
    "type": "string"
   }
  },
  "required": [
   "ticker_or_cik"
  ],
  "type": "object"
 },
 "name": "insider_trades",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance_usd": {
    "description": "Remaining prepaid balance, USD.",
    "type": "number"
   },
   "charged_usd": {
    "description": "Amount charged for this call, USD.",
    "type": "number"
   },
   "cik": {
    "type": "string"
   },
   "company": {
    "type": [
     "string",
     "null"
    ]
   },
   "filings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "filed": {
       "type": [
        "string",
        "null"
       ]
      },
      "filing_url": {
       "type": "string"
      },
      "insider_name": {
       "description": "Reporting person(s).",
       "type": [
        "string",
        "null"
       ]
      },
      "relationship": {
       "description": "e.g. \"Director\", \"Officer: CFO\", \"10% owner\".",
       "type": [
        "string",
        "null"
       ]
      },
      "transactions": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "acquired_or_disposed": {
          "anyOf": [
           {
            "enum": [
             "acquired",
             "disposed"
            ],
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "code": {
          "description": "Transaction code, e.g. \"P\" or \"S\".",
          "type": [
           "string",
           "null"
          ]
         },
         "code_meaning": {
          "description": "Plain-language meaning of the code.",
          "type": [
           "string",
           "null"
          ]
         },
         "derivative": {
          "description": "True for options/RSUs/other derivatives.",
          "type": "boolean"
         },
         "ownership": {
          "anyOf": [
           {
            "enum": [
             "direct",
             "indirect"
            ],
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "price": {
          "description": "Price per share (USD), if reported.",
          "type": [
           "number",
           "null"
          ]
         },
         "security": {
          "description": "e.g. \"Common Stock\".",
          "type": [
           "string",
           "null"
          ]
         },
         "shares": {
          "type": [
           "number",
           "null"
          ]
         },
         "shares_owned_after": {
          "type": [
           "number",
           "null"
          ]
         },
         "transaction_date": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "security",
         "derivative",
         "transaction_date",
         "code",
         "code_meaning",
         "acquired_or_disposed",
         "shares",
         "price",
         "shares_owned_after",
         "ownership"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "insider_name",
      "relationship",
      "filed",
      "filing_url",
      "transactions"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "skipped_filings": {
    "description": "Form 4 filings that could not be read and were left out.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "source": {
    "const": "SEC EDGAR",
    "type": "string"
   }
  },
  "required": [
   "source",
   "company",
   "cik",
   "filings",
   "skipped_filings",
   "charged_usd",
   "balance_usd"
  ],
  "type": "object"
 },
 "title": "Insider Trades (Form 4)"
}
