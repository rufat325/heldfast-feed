{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare 2-5 read-only HeyClaude entries by fit, category, platforms, source metadata, and install complexity.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "entries": {
    "description": "2\u20135 entries to compare, each identified by category and slug.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "description": "Category of the entry (e.g. 'mcp', 'skills').",
       "maxLength": 120,
       "minLength": 1,
       "pattern": "^[a-z0-9-]+$",
       "type": "string"
      },
      "slug": {
       "description": "Slug of the entry.",
       "maxLength": 120,
       "minLength": 1,
       "pattern": "^[a-z0-9-]+$",
       "type": "string"
      }
     },
     "required": [
      "category",
      "slug"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "minItems": 2,
    "type": "array"
   },
   "platform": {
    "description": "Target platform for the comparison (affects install steps shown).",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 },
 "name": "entry.compare",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "ok": {
    "type": "boolean"
   },
   "policy": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
