{
 "description": "Delete a media item and its files",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "force": {
    "default": true,
    "description": "Permanently delete; media cannot be trashed unless MEDIA_TRASH is on, so false usually fails with 501",
    "type": "boolean"
   },
   "id": {
    "description": "Media ID",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "id"
  ],
  "type": "object"
 },
 "name": "wp_delete_media"
}
