{
 "_meta": {
  "openai/outputTemplate": "ui://haus/widgets/v2",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://haus/widgets/v2",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Update a shopping list item's name, quantity, and/or category. Only the fields provided are changed; any field left out keeps its current value.",
 "inputSchema": {
  "examples": [
   {
    "category": "DairyAndEggs",
    "id": "0189c8d4f2b1712a9e4d6c9a1b2e3f4a",
    "quantity": 3
   }
  ],
  "properties": {
   "category": {
    "description": "New store-aisle category, overriding the auto-assigned one.",
    "enum": [
     "FruitAndVegetables",
     "Bakery",
     "DeliAndPreparedFoods",
     "MeatAndSeafood",
     "DairyAndEggs",
     "Frozen",
     "PantryAndDryGoods",
     "SnacksAndConfectionery",
     "Beverages",
     "HouseholdAndCleaning",
     "HealthAndPersonalCare",
     "BabyAndKids",
     "PetSupplies",
     "Online",
     "Other"
    ],
    "examples": [
     "DairyAndEggs"
    ],
    "type": "string"
   },
   "id": {
    "description": "Item id from add_shopping_list_item or list_shopping_list_items.",
    "examples": [
     "0189c8d4f2b1712a9e4d6c9a1b2e3f4a"
    ],
    "type": "string"
   },
   "name": {
    "description": "New item name.",
    "examples": [
     "Whole milk"
    ],
    "type": "string"
   },
   "quantity": {
    "description": "New quantity, 1-9999. Replaces rather than adds to the current one.",
    "examples": [
     3
    ],
    "type": "integer"
   },
   "shoppingListId": {
    "description": "Move the item to a different list, an id from list_shopping_lists. Omit to leave it where it is; name the default list explicitly to move it back.",
    "examples": [
     "0189c8d4f2b1712a9e4d6c9a1b2e3f4a"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_shopping_list_item",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "variant": {
    "enum": [
     "list",
     "detail",
     "confirmation"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 }
}
