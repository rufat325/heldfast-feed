  "readOnlyHint": true,
  "title": "chainpeek: DeFi TVL (total value locked) of a protocol or chain with 1-day and 7-day change (cached DefiLlama data)"
 },
 "description": "chainpeek: Get protocol or chain TVL with 1d and 7d change. For fees and revenue use get_protocol_fees; for DEX volume use get_dex_volume. Returns the TVL of a protocol or chain with 1d and 7d change, the protocol's chains or the chain's largest protocols, or the largest chains and protocols, from Tanod's cache of DefiLlama data. Input: optional `protocol`, optional `chain` and `limit`; give one, both or neither. Cached DefiLlama data (refreshed every few hours), never live; `as_of` shows its age; an unknown name is a 422 with suggestions and a missing or over-2-day-old cache a 503 (neither charged). Informational only. Typically under 1 s (a local cache read). Price: USD 0.004. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/defi-data-api.html",
 "inputSchema": {
  "properties": {
   "chain": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^.*[A-Za-z0-9].*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Chain name, e.g. Ethereum, Base, Solana, BSC, Arbitrum (common aliases such as bnb and eth work). With protocol: that protocol's TVL on the chain. Alone: the chain and its largest protocols.",
    "title": "Chain"
   },
   "limit": {
    "default": 10,
    "description": "Rows in a ranking or a breakdown, 1-50 (default 10).",
    "maximum": 50,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "protocol": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^.*[A-Za-z0-9].*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Protocol name or slug, e.g. aave, uniswap-v3, lido (a parent such as aave sums its versions). Omit for a chain or the overview. An unknown name is a 422 with suggestions.",
    "title": "Protocol"
   }
  },
  "title": "get_protocol_tvlArguments",
  "type": "object"
 },
