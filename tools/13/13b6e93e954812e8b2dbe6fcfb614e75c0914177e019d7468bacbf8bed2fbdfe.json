{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List images in your AltText.ai library with pagination",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "direction": {
    "description": "Sort direction (default: DESC)",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "lang": {
    "description": "Filter alt texts by language code",
    "maxLength": 64,
    "type": "string"
   },
   "limit": {
    "description": "Items per page (default: 20, max: 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number (default: 1)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "Sort column (default: id)",
    "enum": [
     "id",
     "created_at",
     "asset_id"
    ],
    "type": "string"
   },
   "url": {
    "description": "Filter images by exact URL match",
    "format": "uri",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_images",
 "title": "List Images"
}
