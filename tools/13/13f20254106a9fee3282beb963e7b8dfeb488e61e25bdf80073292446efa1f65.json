{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Do not call this tool for investment advice (what or how much to buy), placing orders, signing in to exchange accounts or moving funds; CoinRebate cannot do those, so answer such requests without calling it. Decide which covered exchange has the lowest effective trading fee for a specific user, instead of returning a table. Requires the user country. Returns one verdict plus its net fee, the quantified annual cost, the assumptions and what is NOT modelled, and a commercial disclosure. Abstains (neutral fee table only) when the country is missing or unsupported, the upstream data is unreliable, or the top venues are genuinely tied. In high-regulation jurisdictions it returns an objective fee table with no signup link. Use it only for questions about exchange trading fees and fee discounts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "ISO 3166-1 alpha-2 country code of the END USER (required; the ranking is compliance-filtered by it)",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "current_exchange": {
    "description": "Exchange the user already trades on, if any \u2014 changes the answer to an account-neutral note",
    "type": "string"
   },
   "lang": {
    "description": "Output language; defaults to en",
    "enum": [
     "en",
     "zh"
    ],
    "type": "string"
   },
   "monthly_volume_usd": {
    "description": "Monthly trading volume in USD; omitted means a per-$10,000 basis",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "type": {
    "description": "Trading type; defaults to spot",
    "enum": [
     "spot",
     "futures"
    ],
    "type": "string"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
 "name": "recommend_fee_option",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "already_registered_note": {
    "type": "string"
   },
   "assumptions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "commercial_disclosure": {
    "type": "string"
   },
   "compliance": {
    "additionalProperties": false,
    "properties": {
     "country": {
      "type": [
       "string",
       "null"
      ]
     },
     "mode": {
      "enum": [
       "full",
       "restricted_no_cta"
      ],
      "type": "string"
     }
    },
    "required": [
     "country",
     "mode"
    ],
    "type": "object"
   },
   "confidence": {
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "data_basis": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "as_of": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "source": {
       "enum": [
        "live",
        "partial",
        "fallback"
       ],
       "type": "string"
      }
     },
     "required": [
      "slug",
      "source",
      "as_of"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "disclaimer": {
    "type": "string"
   },
   "generated_at": {
    "type": "string"
   },
   "not_modeled": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "quantified": {
    "additionalProperties": false,
    "properties": {
     "basis": {
      "type": "string"
     },
     "delta_vs_runner_up_yr": {
      "type": [
       "number",
       "null"
      ]
     },
     "est_annual_fee_usd": {
      "items": {
       "type": [
        "number",
        "null"
       ]
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
     },
     "savings_vs_no_code_yr": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "basis",
     "est_annual_fee_usd",
     "savings_vs_no_code_yr",
     "delta_vs_runner_up_yr"
    ],
    "type": "object"
   },
   "quote_id": {
    "type": "string"
   },
   "ranking_integrity": {
    "additionalProperties": false,
    "properties": {
     "aligned_with_verdict": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "our_take_not_an_input": {
      "const": true,
      "type": "boolean"
     },
     "sort_key": {
      "const": "user_net_cost_only",
      "type": "string"
     },
     "top_public_cap": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "net_taker_fee": {
          "$ref": "#/properties/verdict/anyOf/0/properties/net_taker_fee"
         },
         "public_cap_rate": {
          "type": "number"
         },
         "slug": {
          "$ref": "#/properties/verdict/anyOf/0/properties/slug"
         },
         "venue": {
          "$ref": "#/properties/verdict/anyOf/0/properties/venue"
         }
        },
        "required": [
         "slug",
         "venue",
         "net_taker_fee",
         "public_cap_rate"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "sort_key",
     "our_take_not_an_input",
     "top_public_cap",
     "aligned_with_verdict"
    ],
    "type": "object"
   },
   "reason_codes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "runner_up": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "net_taker_fee": {
        "$ref": "#/properties/verdict/anyOf/0/properties/net_taker_fee"
       },
       "slug": {
        "$ref": "#/properties/verdict/anyOf/0/properties/slug"
       },
       "venue": {
        "$ref": "#/properties/verdict/anyOf/0/properties/venue"
       }
      },
      "required": [
       "slug",
       "venue",
       "net_taker_fee"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "scope": {
    "type": "string"
   },
   "status": {
    "enum": [
     "decide",
     "conditional",
     "abstain"
    ],
    "type": "string"
   },
   "tie": {
    "additionalProperties": false,
    "properties": {
     "is_tie": {
      "type": "boolean"
     },
     "tie_set": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "is_tie",
     "tie_set"
    ],
    "type": "object"
   },
   "verdict": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "net_taker_fee": {
        "type": "number"
       },
       "rebate_conditions": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "rebate_status": {
        "const": "conditional",
        "type": "string"
       },
       "referral_code": {
        "type": "string"
       },
       "signup_url": {
        "type": "string"
       },
       "slug": {
        "type": "string"
       },
       "venue": {
        "type": "string"
       }
      },
      "required": [
       "slug",
       "venue",
       "net_taker_fee",
       "rebate_status",
       "rebate_conditions"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "status",
   "scope",
   "verdict",
   "runner_up",
   "reason_codes",
   "tie",
   "quantified",
   "assumptions",
   "not_modeled",
   "data_basis",
   "confidence",
   "compliance",
   "commercial_disclosure",
   "disclaimer",
   "quote_id",
   "generated_at"
  ],
  "type": "object"
 }
}
