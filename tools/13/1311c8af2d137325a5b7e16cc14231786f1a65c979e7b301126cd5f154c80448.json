{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a YouTube Live Chat scaffold with sanitized message rows, Super Chat tiers, moderation policy, adapter source, and API/quota safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "polling_json",
    "enum": [
     "polling_json",
     "websocket_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9078/youtube-chat",
    "type": "string"
   },
   "channel_id": {
    "default": "youtube_channel",
    "type": "string"
   },
   "live_chat_id": {
    "default": "live_chat",
    "type": "string"
   },
   "message_count": {
    "default": 24,
    "maximum": 1024,
    "minimum": 1,
    "type": "integer"
   },
   "moderation_level": {
    "default": "filtered",
    "enum": [
     "display_only",
     "filtered",
     "approval_required"
    ],
    "type": "string"
   },
   "name": {
    "default": "youtube_live_chat_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the YouTube scaffold.",
    "type": "string"
   },
   "super_chat_tier_count": {
    "default": 5,
    "maximum": 32,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_youtube_live_chat_bus",
 "title": "Connect YouTube Live Chat bus"
}
