{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "T\u1ea1o ho\u1eb7c c\u1eadp nh\u1eadt t\u00ean shop, nh\u1eadn di\u1ec7n v\u00e0 t\u00e0i kho\u1ea3n nh\u1eadn ti\u1ec1n m\u1eb7c \u0111\u1ecbnh tr\u01b0\u1edbc khi t\u1ea1o checkout. Secret k\u00fd redirect ch\u1ec9 \u0111\u01b0\u1ee3c API tr\u1ea3 m\u1ed9t l\u1ea7n. / Create or update the hosted-checkout payment profile.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accent_color": {
    "anyOf": [
     {
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "beneficiary_name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "default_bank_account_id": {
    "minLength": 1,
    "type": "string"
   },
   "default_virtual_account_id": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "display_name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "hotline": {
    "anyOf": [
     {
      "maxLength": 30,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "locale": {
    "enum": [
     "vi",
     "en"
    ],
    "type": "string"
   },
   "logo_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "URL HTTPS c\u1ee7a logo, t\u1ed1i \u0111a 512 KB"
   },
   "merchant_id": {
    "minLength": 1,
    "type": "string"
   },
   "owner_number": {
    "minLength": 1,
    "type": "string"
   },
   "owner_type": {
    "enum": [
     "PER",
     "ORG"
    ],
    "type": "string"
   },
   "show_mona_badge": {
    "type": "boolean"
   },
   "support_email": {
    "anyOf": [
     {
      "format": "email",
      "maxLength": 320,
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "terminal_id": {
    "minLength": 1,
    "type": "string"
   },
   "va_prefix": {
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "monapay_set_payment_profile",
 "title": "Thi\u1ebft l\u1eadp h\u1ed3 s\u01a1 trang thanh to\u00e1n"
}
