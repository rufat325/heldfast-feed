 },
 "description": "Set the user's own schedule for one maintenance task on one grinder or machine: their own interval, switching it off, or muting the reminder until a date. Only the keys you send in fields change; send every: null to go back to the maker's guidance and muted_until: null to unmute. Use it when the user states how often they do a task or asks to be left alone about one \u2014 never to invent an interval. The task's class, interval and due state are read back from list_grinders and list_machines.",
 "inputSchema": {
  "properties": {
   "changed_at": {
    "description": "Optional \u2014 when the user made this change (ISO 8601, UTC). An app sending a queued edit passes it, so an older edit never overwrites a newer one; it is then answered with applied: false",
    "type": "string"
   },
   "equipment_id": {
    "description": "This account's own grinder or machine number, from list_grinders or list_machines",
    "type": "integer"
   },
   "equipment_kind": {
    "description": "Which kind of equipment the task is on",
    "enum": [
     "grinder",
     "machine"
    ],
    "type": "string"
   },
   "fields": {
    "properties": {
     "enabled": {
      "description": "false sets the user's interval aside (the maker's applies again) without forgetting it",
      "type": "boolean"
     },
     "every": {
      "description": "The user's interval: whichever basis arrives first makes it due. A grinder counts days, shots and grams; a machine days, shots and litres. null returns to the maker's guidance",
      "properties": {
       "days": {
        "description": "Whole days",
        "type": [
         "number",
         "null"
        ]
       },
       "grams": {
        "description": "Grams of coffee through a grinder",
        "type": [
         "number",
         "null"
        ]
       },
       "litres": {
        "description": "Litres through a machine's group",
        "type": [
         "number",
         "null"
        ]
       },
       "shots": {
        "description": "Whole shots",
        "type": [
         "number",
         "null"
        ]
       }
      },
      "type": [
       "object",
       "null"
      ]
     },
     "muted_until": {
      "description": "Silence the reminder until this date or time (ISO 8601, UTC); null unmutes",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "task": {
    "description": "The task, as its value in that equipment's maintenance.tasks",
    "enum": [
     "burr_clean",
     "backflush_water",
     "backflush_detergent",
     "descale",
     "group_gasket_replace",
     "shower_screen_clean",
     "shower_screen_replace",
     "group_head_wipe",
     "basket_portafilter_soak",
     "steam_wand_purge",
     "steam_wand_soak",
     "drip_tray_clean",
     "water_tank_clean",
     "water_filter_replace",
     "boiler_water_change",
     "lever_piston_seal_replace",
     "lever_lubricate",
     "milk_system_clean",
     "professional_service",
     "builtin_grinder_burr_clean",
     "builtin_grinder_burr_replace",
     "grinder_quick_clean",
     "grinder_cleaning_tablets",
     "burr_replace",
     "hopper_clean",
     "grounds_cup_clean",
     "bearing_lubricate",
     "gasket_seal_replace",
     "idle_rinse",
     "water_wash",
     "dishwasher",
     "filter_prime",
     "softener_regenerate",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "equipment_kind",
   "equipment_id",
   "task"
  ],
  "type": "object"
 },
