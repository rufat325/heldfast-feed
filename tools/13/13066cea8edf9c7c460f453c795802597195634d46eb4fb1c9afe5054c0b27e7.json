{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Lists Docker Compose services with structured state and status information.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "all": {
    "default": false,
    "description": "Show stopped containers from docker compose run (default: false)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "file": {
    "description": "Compose file path for consistency with compose-up/compose-down (maps to -f)",
    "maxLength": 4096,
    "type": "string"
   },
   "filter": {
    "description": "Generic property filter (--filter)",
    "maxLength": 255,
    "type": "string"
   },
   "noTrunc": {
    "default": false,
    "description": "Do not truncate output (default: false)",
    "type": "boolean"
   },
   "path": {
    "description": "Directory containing docker-compose.yml",
    "maxLength": 4096,
    "type": "string"
   },
   "services": {
    "default": [],
    "description": "Filter to specific services (positional args)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "status": {
    "default": [],
    "description": "Filter by container status (e.g., [\"running\", \"exited\"])",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "compose-ps",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "services": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "exitCode": {
       "type": "number"
      },
      "health": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "ports": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "container": {
          "type": "number"
         },
         "host": {
          "type": "number"
         },
         "protocol": {
          "enum": [
           "tcp",
           "udp"
          ],
          "type": "string"
         }
        },
        "required": [
         "container",
         "protocol"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "service": {
       "type": "string"
      },
      "state": {
       "default": "created",
       "enum": [
        "running",
        "exited",
        "paused",
        "restarting",
        "dead",
        "created",
        "removing"
       ],
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "service",
      "state"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "services"
  ],
  "type": "object"
 },
 "title": "Docker Compose PS"
}
