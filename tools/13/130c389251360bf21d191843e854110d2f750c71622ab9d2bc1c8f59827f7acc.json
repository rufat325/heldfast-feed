{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find Marketing Snippets"
 },
 "description": "Find pre-approved RealOpen social-media snippets \u2014 copy-ready posts written by RealOpen's marketing team for twitter, linkedin, instagram, email, or general use. Use this when a user asks for ready-to-post content or needs inspiration grounded in approved brand voice. Filter by platform, tone, tag, attached asset, or keyword. Each snippet includes body text, tags, share title (usable as email subject), and a preview of the associated visual asset when one is attached.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asset_id": {
    "description": "Get snippets tied to a specific asset by ID",
    "type": "string"
   },
   "keyword": {
    "description": "Free-text search on snippet text and title",
    "type": "string"
   },
   "platform": {
    "description": "Filter by target platform",
    "enum": [
     "twitter",
     "linkedin",
     "instagram",
     "email",
     "general"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Filter by snippet tags (matches ANY)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tone": {
    "description": "Filter by snippet tone",
    "enum": [
     "professional",
     "casual",
     "urgent",
     "educational"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_snippets",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "snippets": {
    "description": "Up to 20 matching snippets (random order to avoid stale top-matches)",
    "items": {
     "additionalProperties": true,
     "properties": {
      "asset_file_type": {
       "type": [
        "string",
        "null"
       ]
      },
      "asset_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "asset_image_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "asset_label": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "platform": {
       "type": [
        "string",
        "null"
       ]
      },
      "referral_url": {
       "description": "Tracked referral URL \u2014 only present when the session has a resolved ref_id",
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "text": {
       "description": "The actual snippet body to share",
       "type": "string"
      },
      "title": {
       "description": "Share title \u2014 usable as an email subject line",
       "type": [
        "string",
        "null"
       ]
      },
      "tone": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "text",
      "tags"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "snippets"
  ],
  "type": "object"
 }
}
