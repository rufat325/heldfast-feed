{
 "description": "Turn supplied SEO opportunities into a capacity-aware content calendar and execution plan.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "goal": {
    "default": "traffic_growth",
    "enum": [
     "traffic_growth",
     "lead_generation",
     "refresh_decay",
     "launch_support",
     "authority_building"
    ],
    "type": "string"
   },
   "horizon_days": {
    "default": 30,
    "maximum": 90,
    "minimum": 7,
    "type": "integer"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "buyer_stage": {
       "default": "awareness",
       "enum": [
        "awareness",
        "consideration",
        "decision",
        "implementation",
        "retention"
       ],
       "type": "string"
      },
      "dependencies": {
       "default": [],
       "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 10,
       "type": "array"
      },
      "effort": {
       "default": "medium",
       "enum": [
        "small",
        "medium",
        "large"
       ],
       "type": "string"
      },
      "impact_score": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "keyword": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "notes": {
       "maxLength": 1000,
       "type": "string"
      },
      "opportunity_type": {
       "default": "new_content",
       "enum": [
        "new_content",
        "refresh",
        "technical_fix",
        "internal_links",
        "schema",
        "backlink_outreach",
        "monitoring"
       ],
       "type": "string"
      },
      "priority": {
       "default": "medium",
       "enum": [
        "low",
        "medium",
        "high",
        "critical"
       ],
       "type": "string"
      },
      "source_endpoint": {
       "maxLength": 120,
       "type": "string"
      },
      "status": {
       "default": "idea",
       "enum": [
        "idea",
        "ready",
        "blocked",
        "in_progress"
       ],
       "type": "string"
      },
      "title": {
       "maxLength": 180,
       "minLength": 1,
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "start_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "type": "string"
   },
   "team": {
    "default": [],
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "weekly_capacity": {
    "default": 5,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "agentseo_content_action_plan",
 "title": "AgentSEO Content Action Plan"
}
