{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "BMI calculator"
 },
 "description": "Work out body mass index (BMI) from height and weight, with the NHS weight category. Use units 'metric' with heightCm and weightKg, or 'imperial' with heightInches and weightPounds. BMI = weight in kg / (height in metres squared). Source: https://hopi.co.uk/bmi-calculator/",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "units": {
       "const": "metric"
      }
     }
    },
    "then": {
     "required": [
      "heightCm",
      "weightKg"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "units": {
       "const": "imperial"
      }
     }
    },
    "then": {
     "required": [
      "heightInches",
      "weightPounds"
     ]
    }
   }
  ],
  "properties": {
   "heightCm": {
    "description": "Height in centimetres (metric)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "heightInches": {
    "description": "Total height in inches (imperial)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "units": {
    "description": "'metric' (cm and kg) or 'imperial' (inches and pounds)",
    "enum": [
     "metric",
     "imperial"
    ],
    "type": "string"
   },
   "weightKg": {
    "description": "Weight in kilograms (metric)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "weightPounds": {
    "description": "Weight in pounds (imperial)",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "units"
  ],
  "type": "object"
 },
 "name": "hopi_bmi_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "bmi": {
    "type": "number"
   },
   "category": {
    "type": "string"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "units": {
    "type": "string"
   }
  },
  "required": [
   "bmi",
   "category",
   "source_url",
   "summary",
   "units"
  ],
  "type": "object"
 },
 "title": "BMI calculator"
}
