{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Create a folder in a SharePoint document library.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "drive_id": {
    "description": "Drive ID. Omit to use the default drive.",
    "type": "string"
   },
   "folder_name": {
    "description": "Name of the new folder.",
    "type": "string"
   },
   "parent_path": {
    "description": "Parent folder path, e.g. '/Shared Documents'. Defaults to drive root.",
    "type": "string"
   },
   "site_id": {
    "description": "SharePoint Graph site ID.",
    "type": "string"
   }
  },
  "required": [
   "site_id",
   "folder_name"
  ],
  "type": "object"
 },
 "name": "create_folder"
}
