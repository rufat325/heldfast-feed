{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Take screenshots of web pages. Supports full page or partial screenshots, JavaScript execution, and custom viewport sizes. Returns base64-encoded image data.",
 "inputSchema": {
  "properties": {
   "auto_proxy": {
    "description": "Auto-escalate proxy. Default: false",
    "type": "boolean"
   },
   "block_ads": {
    "description": "Block ads. Default: false",
    "type": "boolean"
   },
   "cookies": {
    "description": "Custom cookies",
    "type": "string"
   },
   "custom_js": {
    "description": "Custom JavaScript code",
    "type": "string"
   },
   "custom_proxy": {
    "description": "Custom proxy URI",
    "type": "string"
   },
   "custom_proxy_password": {
    "description": "Custom proxy password",
    "type": "string"
   },
   "custom_proxy_username": {
    "description": "Custom proxy username",
    "type": "string"
   },
   "device": {
    "description": "Device: 'desktop' or 'mobile'. Default: 'desktop'",
    "type": "string"
   },
   "js": {
    "description": "Execute JavaScript. Default: true",
    "type": "boolean"
   },
   "js_timeout": {
    "description": "JS timeout in seconds",
    "type": "number"
   },
   "proxy_country": {
    "description": "Proxy country. Default: 'US'",
    "type": "string"
   },
   "proxy_type": {
    "description": "Proxy type. Default: 'rotating'",
    "type": "string"
   },
   "screenshot_fullpage": {
    "description": "Capture full page. Default: false",
    "type": "boolean"
   },
   "screenshot_partial": {
    "description": "CSS selector or JSON coordinates {x,y,width,height} for partial screenshot",
    "type": "string"
   },
   "scroll_down": {
    "description": "Scroll before screenshot. Default: false",
    "type": "boolean"
   },
   "session_id": {
    "description": "Session ID",
    "type": "string"
   },
   "timeout": {
    "description": "Timeout in seconds. Default: 60",
    "type": "number"
   },
   "url": {
    "description": "URL to screenshot",
    "type": "string"
   },
   "useragent": {
    "description": "Custom user agent",
    "type": "string"
   },
   "wait_for": {
    "description": "Wait condition before screenshot",
    "type": "string"
   },
   "wait_for_timeout": {
    "description": "Wait timeout in milliseconds",
    "type": "number"
   },
   "window_height": {
    "description": "Viewport height",
    "type": "number"
   },
   "window_width": {
    "description": "Viewport width",
    "type": "number"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "ujeebu_scrape_screenshot"
}
