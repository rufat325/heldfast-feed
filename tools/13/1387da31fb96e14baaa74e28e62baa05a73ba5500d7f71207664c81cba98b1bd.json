{
 "description": "Rename a sheet within a spreadsheet.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "newTitle": {
    "description": "New name for the sheet tab",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "gid",
   "newTitle"
  ],
  "type": "object"
 },
 "name": "sheet-rename",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "completedAt": {
        "description": "ISO datetime when operation completed",
        "type": "string"
       },
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "itemsChanged": {
        "description": "Successfully renamed sheets (always 1 on success)",
        "type": "number"
       },
       "itemsProcessed": {
        "description": "Total items attempted (always 1 for single sheet)",
        "type": "number"
       },
       "newTitle": {
        "description": "New title of the sheet",
        "type": "string"
       },
       "oldTitle": {
        "description": "Previous title of the sheet",
        "type": "string"
       },
       "operationSummary": {
        "description": "Summary of the rename operation",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL of the renamed sheet",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "operationSummary",
       "itemsProcessed",
       "itemsChanged",
       "completedAt",
       "id",
       "gid",
       "sheetUrl",
       "oldTitle",
       "newTitle"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
