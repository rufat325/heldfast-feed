{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit an adult donor's authorized vehicle-donation request to Cars Helping Kids for case review. Use only after the donor reviews the exact contact, vehicle, and pickup details and explicitly authorizes this submission, confirms ownership or legal authority and accuracy, accepts https://carshelpingkids.org/terms and https://carshelpingkids.org/privacy, and permits donation-related phone, text, or email contact. This additive action creates a donor record and notifications; it does not transfer ownership or guarantee acceptance, pickup, value, documents, or a deduction. Reuse submission_id for safe retries.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "donor": {
    "additionalProperties": false,
    "properties": {
     "email": {
      "anyOf": [
       {
        "format": "email",
        "maxLength": 254,
        "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "type": "string"
       },
       {
        "const": "",
        "type": "string"
       }
      ],
      "default": ""
     },
     "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "name",
     "phone"
    ],
    "type": "object"
   },
   "donor_authorized": {
    "const": true,
    "description": "True only after the donor explicitly authorizes this exact submission, confirms they are at least 18 and own or are legally authorized to dispose of the vehicle, confirms the details are accurate, accepts the Cars Helping Kids terms and privacy policy, and permits donation-related phone, text, or email contact.",
    "type": "boolean"
   },
   "notes": {
    "default": "",
    "maxLength": 500,
    "type": "string"
   },
   "pickup": {
    "additionalProperties": false,
    "properties": {
     "access": {
      "default": "unknown",
      "enum": [
       "standard_tow_access",
       "limited_or_special_access",
       "unknown"
      ],
      "type": "string"
     },
     "city": {
      "default": "",
      "maxLength": 100,
      "type": "string"
     },
     "state": {
      "default": "",
      "maxLength": 50,
      "type": "string"
     },
     "timing": {
      "default": "unknown",
      "enum": [
       "as_soon_as_possible",
       "within_7_days",
       "within_30_days",
       "flexible",
       "unknown"
      ],
      "type": "string"
     },
     "zip": {
      "pattern": "^\\d{5}$",
      "type": "string"
     }
    },
    "required": [
     "zip"
    ],
    "type": "object"
   },
   "submission_id": {
    "description": "A UUID generated once for this donation attempt. Reuse the same value when retrying the same submission.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "vehicle": {
    "additionalProperties": false,
    "properties": {
     "condition": {
      "enum": [
       "runs_and_drives",
       "starts_not_drivable",
       "does_not_run",
       "wrecked_or_incomplete",
       "unknown"
      ],
      "type": "string"
     },
     "keys": {
      "default": "unknown",
      "enum": [
       "yes",
       "no",
       "unknown"
      ],
      "type": "string"
     },
     "lien_status": {
      "enum": [
       "no_lien",
       "lien_exists",
       "unknown"
      ],
      "type": "string"
     },
     "make": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "model": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "title_status": {
      "enum": [
       "title_in_hand",
       "title_missing",
       "title_issue",
       "unknown"
      ],
      "type": "string"
     },
     "type": {
      "enum": [
       "Car",
       "Truck",
       "SUV",
       "Motorcycle",
       "RV",
       "Boat",
       "Trailer",
       "Other"
      ],
      "type": "string"
     },
     "year": {
      "maximum": 2028,
      "minimum": 1886,
      "type": "integer"
     }
    },
    "required": [
     "type",
     "year",
     "make",
     "model",
     "condition",
     "title_status",
     "lien_status"
    ],
    "type": "object"
   }
  },
  "required": [
   "submission_id",
   "donor_authorized",
   "donor",
   "vehicle",
   "pickup"
  ],
  "type": "object"
 },
 "name": "submit_car_donation",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "legal_recipient": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "ok": {
    "const": true,
    "type": "boolean"
   },
   "program": {
    "type": "string"
   },
   "receipt_url": {
    "format": "uri",
    "type": "string"
   },
   "reference": {
    "type": "string"
   },
   "replayed": {
    "type": "boolean"
   },
   "status": {
    "const": "received_for_review",
    "type": "string"
   },
   "submission_meaning": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "status",
   "reference",
   "replayed",
   "program",
   "legal_recipient",
   "receipt_url",
   "next_step",
   "submission_meaning"
  ],
  "type": "object"
 },
 "title": "Submit a Cars Helping Kids car donation"
}
