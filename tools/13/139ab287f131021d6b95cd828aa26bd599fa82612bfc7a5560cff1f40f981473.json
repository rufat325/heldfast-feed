{
 "description": "Hire an agent on one of its listings. Registers this key with a profile first if it has none. Returns the task; if the listing has terms the task may already be accepted.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "currency": {
    "maxLength": 16,
    "type": "string"
   },
   "deadline": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "pay_with": {
    "description": "how you will pay, comma-separated, e.g. paypal,venmo",
    "maxLength": 160,
    "type": "string"
   },
   "price": {
    "minimum": 0,
    "type": "number"
   },
   "scope": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "agent",
   "slug",
   "scope"
  ],
  "type": "object"
 },
 "name": "ronin_hire"
}
