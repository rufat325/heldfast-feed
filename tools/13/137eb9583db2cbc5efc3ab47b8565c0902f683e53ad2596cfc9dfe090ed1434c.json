{"annotations":{"destructiveHint":false,"idempotentHint":false,"readOnlyHint":false,"title":"Log Race Result"},"description":"Saves an official HYROX or triathlon result (total, optional splits) to the local race log (~/.whoop-mcp, 0600). Validates station order and split sums; every save is recorded in the audit log.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"category":{"description":"HYROX division (open_men, open_women, pro_men, pro_women, doubles_men, doubles_women, doubles_mixed, relay_men, relay_women, relay_mixed) or triathlon distance (sprint, olympic, half, full, custom).","type":"string"},"date":{"description":"Race day YYYY-MM-DD (not in the future).","type":"string"},"name":{"description":"Race name, e.g. 'HYROX Berlin'.","type":"string"},"notes":{"type":"string"},"splits":{"anyOf":[{"properties":{"roxzone_seconds":{"maximum":86400,"minimum":0,"type":"integer"},"runs":{"items":{"exclusiveMinimum":0,"maximum":86400,"type":"integer"},"maxItems":8,"minItems":8,"type":"array"},"stations":{"items":{"properties":{"seconds":{"exclusiveMinimum":0,"maximum":86400,"type":"integer"},"station":{"enum":["skierg","sled_push","sled_pull","burpee_broad_jumps","row","farmers_carry","sandbag_lunges","wall_balls"],"type":"string"}},"required":["station","seconds"],"type":"object"},"maxItems":8,"minItems":8,"type":"array"}},"required":["runs","stations"],"type":"object"},{"properties":{"bike_seconds":{"exclusiveMinimum":0,"maximum":86400,"type":"integer"},"run_seconds":{"exclusiveMinimum":0,"maximum":86400,"type":"integer"},"swim_seconds":{"exclusiveMinimum":0,"maximum":86400,"type":"integer"},"t1_seconds":{"maximum":86400,"minimum":0,"type":"integer"},"t2_seconds":{"maximum":86400,"minimum":0,"type":"integer"}},"required":["swim_seconds","t1_seconds","bike_seconds","t2_seconds","run_seconds"],"type":"object"}],"description":"HYROX: { runs: [8 \u00d7 seconds], stations: [8 \u00d7 { station, seco