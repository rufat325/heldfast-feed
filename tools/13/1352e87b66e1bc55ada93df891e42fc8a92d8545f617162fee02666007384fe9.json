  "readOnlyHint": true,
  "title": "Get mileage summary"
 },
 "description": "Mileage analytics \u2014 totals, breakdowns by month / client / purpose / category, plus deduction framing (cents-per-mile or cents-per-km \u00d7 distance, country-aware IRS / CRA rates). Examples: 'mileage this year', 'miles driven for Acme', 'mileage by month', 'mileage deduction estimate', 'business miles last quarter'. Supports YoY / MoM / QoQ comparison phrasing. Returns: { message, data: { totalDistance, deductionEstimate?, breakdown?, comparison?, sampleMeta? } }.",
 "inputSchema": {
  "properties": {
   "dateRange": {
    "description": "Time period filter. Use exactly one variant \u2014 pick the shape that matches the user's phrasing.",
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "month": {
        "description": "Month name or 1-12 (e.g., 'March' or '3')",
        "type": "string"
       },
       "type": {
        "const": "month",
        "type": "string"
       },
       "year": {
        "description": "4-digit year (e.g., 2026)",
        "type": "integer"
       }
      },
      "required": [
       "type",
       "month",
       "year"
      ],
      "title": "Specific month",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "quarter": {
        "maximum": 4,
        "minimum": 1,
        "type": "integer"
       },
       "type": {
        "const": "quarter",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "quarter",
       "year"
      ],
      "title": "Quarter of a year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "year",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "year"
      ],
      "title": "Full year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "end": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "start": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "type": {
        "const": "specific",
        "type": "string"
       }
      },
      "required": [
       "type",
       "start",
       "end"
      ],
      "title": "Specific date range",
      "type": "object"
     },
     {
      "additionalProperties": false,
