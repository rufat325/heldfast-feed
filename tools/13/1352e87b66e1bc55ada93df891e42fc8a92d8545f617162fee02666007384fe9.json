        "type": "string"
       }
      },
      "required": [
       "type",
       "value"
      ],
      "title": "Relative natural-language range",
      "type": "object"
     }
    ]
   },
   "groupBy": {
    "description": "How to group the breakdown",
    "enum": [
     "month",
     "tag",
     "purpose",
     "category"
    ],
    "type": "string"
   },
   "query": {
