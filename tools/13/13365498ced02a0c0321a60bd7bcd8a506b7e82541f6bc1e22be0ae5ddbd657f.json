{
 "description": "Create a page directly in the actual job Instructions tab. idempotencyKey is required. Rich content is TipTap JSON with a doc root. Optional contentSchemaVersion (1|2, default 1) sets the new page\u2019s node set; v2 blocks (youtube/callout/details/audio/attachment) require the page\u2019s contentSchemaVersion >= 2 \u2014 see schema_upgrade.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "afterPageId": {
    "minLength": 1,
    "type": "string"
   },
   "beforePageId": {
    "minLength": 1,
    "type": "string"
   },
   "confirmLive": {
    "const": true,
    "type": "boolean"
   },
   "content": {
    "additionalProperties": false,
    "properties": {
     "attrs": {
      "additionalProperties": {},
      "type": "object"
     },
     "content": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "attrs": {
         "additionalProperties": {},
         "type": "object"
        },
        "content": {
         "items": {
          "$ref": "#/properties/content/properties/content/items"
         },
         "type": "array"
        },
        "marks": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "attrs": {
            "additionalProperties": {},
            "type": "object"
           },
           "type": {
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "type"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "text": {
         "type": "string"
        },
        "type": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "type": {
      "const": "doc",
      "type": "string"
     }
    },
    "required": [
     "type",
     "content"
    ],
    "type": "object"
   },
   "contentSchemaVersion": {
    "enum": [
     1,
     2
    ],
    "type": "number"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "parentPageId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "position": {
    "minimum": 0,
    "type": "integer"
   },
   "preflightToken": {
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "title",
   "idempotencyKey",
   "preflightToken",
   "confirmLive"
  ],
  "type": "object"
 },
 "name": "opentrain_job_instructions_create_page",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
