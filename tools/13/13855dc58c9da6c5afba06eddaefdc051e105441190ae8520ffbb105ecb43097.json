  "title": "Buscar mat\u00e9rias legislativas"
 },
 "description": "Busca mat\u00e9rias legislativas por tipo (PEC, PL, PLP, MPV), n\u00famero, ano, palavras-chave, autor, per\u00edodo de apresenta\u00e7\u00e3o ou situa\u00e7\u00e3o de tramita\u00e7\u00e3o; informe ao menos um crit\u00e9rio. Para pedidos como 'mat\u00e9rias recentes sobre X', use `palavraChave`, `ano` ou `dataInicioApresentacao`/`dataFimApresentacao`, `ordenarPor: 'dataApresentacao'`, `ordem: 'desc'` e `limite` baixo (ex: 10); n\u00e3o \u00e9 necess\u00e1rio chamar detalhes para listar resultados. Retorna `{ count, total, materias[] }`, cada item com `codigo` (codigoMateria), `sigla`, `numero`, `ano`, `ementa`, `autor`, `situacao`, `dataApresentacao`, `url` e `tramitando`. Use `codigo` em `senado_obter_materia` apenas quando o usu\u00e1rio pedir detalhe/tramita\u00e7\u00e3o/textos. `limite` padr\u00e3o 100 (m\u00e1x. 500); ao truncar inclui `aviso`. Ex.: `{ palavraChave: 'intelig\u00eancia artificial', ano: 2025, limite: 10 }` ou `{ sigla: 'PEC', numero: 45, ano: 2019 }` (datas em YYYYMMDD ou ISO).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "ano": {
    "description": "Ano da mat\u00e9ria",
    "maximum": 2100,
    "minimum": 1900,
    "type": "integer"
   },
   "autorNome": {
    "description": "Nome do autor",
    "type": "string"
   },
   "dataFimApresentacao": {
    "description": "Data final de apresenta\u00e7\u00e3o (YYYYMMDD ou YYYY-MM-DD)",
    "pattern": "^(\\d{8}|\\d{4}-\\d{2}-\\d{2})$",
    "type": "string"
   },
   "dataInicioApresentacao": {
    "description": "Data inicial de apresenta\u00e7\u00e3o (YYYYMMDD ou YYYY-MM-DD)",
    "pattern": "^(\\d{8}|\\d{4}-\\d{2}-\\d{2})$",
    "type": "string"
   },
   "limite": {
    "default": 100,
    "description": "M\u00e1ximo de resultados (padr\u00e3o: 100)",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "numero": {
    "description": "N\u00famero da mat\u00e9ria",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "ordem": {
    "default": "desc",
    "description": "Dire\u00e7\u00e3o da ordena\u00e7\u00e3o quando ordenarPor=dataApresentacao",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "ordenarPor": {
    "default": "dataApresentacao",
    "description": "Ordena\u00e7\u00e3o local; padr\u00e3o dataApresentacao para favorecer pedidos recentes",
    "enum": [
     "relevancia",
     "dataApresentacao"
    ],
    "type": "string"
   },
   "palavraChave": {
    "description": "Termo livre buscado nas palavras-chave do processo",
    "type": "string"
   },
   "sigla": {
    "description": "Tipo: PEC, PL, PLP, MPV, PDL, PRS, etc.",
    "type": "string"
   },
   "tramitando": {
    "description": "Apenas em tramita\u00e7\u00e3o",
    "type": "boolean"
   }
  },
  "type": "object"
 },
