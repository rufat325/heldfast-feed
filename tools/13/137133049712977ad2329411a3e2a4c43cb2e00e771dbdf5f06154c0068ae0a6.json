 "description": "GetReportSeries returns one P&L, balance sheet or cash flow statement per month, quarter or year of a range, in one call: the same figures the single-period RPCs give for each period. Read-only.",
 "inputSchema": {
  "properties": {
   "basis": {
    "enum": [
     "REPORT_BASIS_UNSPECIFIED",
     "REPORT_BASIS_ACCRUAL",
     "REPORT_BASIS_CASH"
    ],
    "type": "string"
   },
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "currencyCode": {
    "maxLength": 3,
    "pattern": "^([A-Z]{3})?$",
    "type": "string"
   },
   "endDate": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "granularity": {
    "enum": [
     "REPORT_GRANULARITY_MONTH",
     "REPORT_GRANULARITY_QUARTER",
     "REPORT_GRANULARITY_YEAR"
    ],
    "type": "string"
   },
   "kind": {
    "enum": [
     "REPORT_KIND_PROFIT_AND_LOSS",
     "REPORT_KIND_BALANCE_SHEET",
     "REPORT_KIND_CASH_FLOW"
    ],
    "type": "string"
   },
   "startDate": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
