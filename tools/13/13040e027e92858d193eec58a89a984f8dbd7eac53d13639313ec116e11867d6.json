{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "UI"
 },
 "description": "UI Control nodes and themes. Actions: create_control|set_theme|layout|list_controls. Use help tool for full docs.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "create_control",
     "set_theme",
     "layout",
     "list_controls"
    ],
    "type": "string"
   },
   "font_size": {
    "description": "Default font size (for set_theme)",
    "type": "number"
   },
   "name": {
    "description": "Control node name",
    "type": "string"
   },
   "parent": {
    "description": "Parent node path (default: .)",
    "type": "string"
   },
   "preset": {
    "description": "Layout preset: full_rect, center, top_wide, bottom_wide, left_wide, right_wide",
    "type": "string"
   },
   "project_path": {
    "description": "Path to Godot project directory",
    "type": "string"
   },
   "scene_path": {
    "description": "Path to scene file",
    "type": "string"
   },
   "theme_path": {
    "description": "Path to theme .tres file (for set_theme)",
    "type": "string"
   },
   "type": {
    "description": "Control type (e.g., Button, Label, HBoxContainer)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "ui",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 }
}
