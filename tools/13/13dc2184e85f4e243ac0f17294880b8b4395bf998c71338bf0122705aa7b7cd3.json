{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Decide on an application"
 },
 "description": "Decide on an application without a review task. Only the job's hiring manager may decide; anyone else gets application not found. Reason codes must be system codes or your organization's. Reject disqualifies the candidate.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "application_id": {
    "minLength": 1,
    "type": "string"
   },
   "decision": {
    "enum": [
     "approve",
     "approve_and_schedule",
     "reject",
     "hold",
     "ask_recruiter"
    ],
    "type": "string"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "maxLength": 10000,
    "type": "string"
   },
   "reason_code_ids": {
    "items": {
     "format": "uuid",
     "type": "string"
    },
    "type": "array"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "application_id",
   "decision"
  ],
  "type": "object"
 },
 "name": "yardstick_applications_decide",
 "title": "Decide on an application"
}
