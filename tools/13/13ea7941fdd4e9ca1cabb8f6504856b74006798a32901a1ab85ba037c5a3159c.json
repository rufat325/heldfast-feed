{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Set exact monthly budget amounts (main currency) per category, for \"total\" (overall monthly budget) or \"uncategorized\". 0 removes that budget. Batch-friendly: e.g. copy last month's budgets to next month.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "budgets": {
    "items": {
     "properties": {
      "category": {
       "description": "Category name/path/id, \"total\" or \"uncategorized\"",
       "type": "string"
      },
      "expense": {
       "description": "Expense budget; 0 removes it",
       "minimum": 0,
       "type": "number"
      },
      "income": {
       "description": "Income budget; 0 removes it",
       "minimum": 0,
       "type": "number"
      },
      "month": {
       "description": "YYYY-MM",
       "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
       "type": "string"
      }
     },
     "required": [
      "month",
      "category"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "dry_run": {
    "default": false,
    "description": "Preview the outcome without saving anything",
    "type": "boolean"
   }
  },
  "required": [
   "budgets"
  ],
  "type": "object"
 },
 "name": "set_budgets",
 "title": "Set monthly budgets"
}
