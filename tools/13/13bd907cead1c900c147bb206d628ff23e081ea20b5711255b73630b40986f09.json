  "title": "List files"
 },
 "description": "List uploaded objects in the workspace, filtered by key prefix or by a PR/issue's attachments. Paginate with cursor, or set all to fetch every page.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "all": {
    "description": "Follow cursors and return every page.",
    "type": "boolean"
   },
   "cursor": {
    "description": "Pagination cursor from a previous call.",
    "type": "string"
   },
   "issue": {
    "description": "List attachments for this issue. Mutually exclusive with pr.",
    "type": "number"
   },
   "limit": {
    "description": "Page size.",
    "type": "number"
   },
   "pr": {
    "description": "List attachments for this pull request. Mutually exclusive with issue.",
    "type": "number"
   },
   "prefix": {
    "description": "Key prefix filter (default: UPLOADS_DEFAULT_PREFIX + '/'). Cannot be combined with pr/issue.",
    "type": "string"
   },
   "repo": {
    "description": "owner/name repository (default: gh/git inference).",
    "type": "string"
   },
   "workspace": {
    "description": "Override the workspace for this call (like the CLI's --workspace flag).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
