{
 "description": "Place a trading order (limit or market, buy or sell). Returns the created order.",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "Amount to trade (in base currency)",
    "type": "number"
   },
   "pair_id": {
    "description": "Trading pair ID (e.g., ECO-BTC)",
    "type": "string"
   },
   "price": {
    "description": "Price per unit (required for limit orders)",
    "type": "number"
   },
   "side": {
    "description": "Order side",
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "type": {
    "description": "Order type",
    "enum": [
     "limit",
     "market"
    ],
    "type": "string"
   }
  },
  "required": [
   "pair_id",
   "side",
   "type",
   "amount"
  ],
  "type": "object"
 },
 "name": "place_order"
}
