{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/web.robots-evaluate",
  "agent-utilities/priceMicroUsd": 300
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Evaluate supplied robots.txt for a URL and user agent; no network fetch. PAID: 300 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "robots": {
      "maxLength": 100000,
      "type": "string"
     },
     "url": {
      "maxLength": 2048,
      "type": "string"
     },
     "userAgent": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "url",
     "robots",
     "userAgent"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "web_robots_evaluate",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "allowed": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "crawlDelay": {
    "type": [
     "number",
     "null"
    ]
   },
   "scope": {
    "type": "string"
   },
   "sitemaps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "allowed",
   "crawlDelay",
   "sitemaps",
   "scope"
  ],
  "type": "object"
 }
}
