{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read-only: suggest a small ordered TouchDesigner operator chain for a creative or technical goal from offline operator docs and workflow patterns. Returns connection hints and next tool hints; it does not create nodes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "family": {
    "description": "Optional operator family/category preference, e.g. TOP, CHOP, SOP, DAT.",
    "type": "string"
   },
   "goal": {
    "description": "Creative or technical goal for the operator chain.",
    "minLength": 1,
    "type": "string"
   },
   "max_steps": {
    "default": 5,
    "description": "Maximum number of operators to return in the suggested chain.",
    "exclusiveMinimum": 0,
    "maximum": 10,
    "type": "integer"
   },
   "seed_operator": {
    "description": "Optional starting operator name, display name, or slug.",
    "type": "string"
   }
  },
  "required": [
   "goal"
  ],
  "type": "object"
 },
 "name": "suggest_operator_chain",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "connectionHint": {
       "type": "string"
      },
      "operator": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "role": {
       "type": "string"
      },
      "subcategory": {
       "type": "string"
      }
     },
     "required": [
      "operator",
      "role"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "family": {
    "type": "string"
   },
   "goal": {
    "type": "string"
   },
   "nextToolHints": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "seedOperator": {
    "type": "string"
   },
   "sourceMatches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "surface": {
       "type": "string"
      }
     },
     "required": [
      "surface",
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "goal",
   "chain",
   "sourceMatches",
   "nextToolHints",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Suggest operator chain"
}
