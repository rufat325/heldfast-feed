{
 "description": "Search the Prowl service directory by keyword, category, or filters. Returns ranked SaaS APIs with scores.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Filter by category (e.g. 'ai', 'email', 'database')",
    "type": "string"
   },
   "has_mcp": {
    "description": "Only show services with MCP support",
    "type": "boolean"
   },
   "limit": {
    "description": "Max results (default 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_score": {
    "description": "Minimum ASO score (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "q": {
    "description": "Search keyword (e.g. 'weather', 'payments')",
    "type": "string"
   },
   "sort": {
    "description": "Sort field",
    "enum": [
     "score",
     "latency",
     "name"
    ],
    "type": "string"
   },
   "verified_only": {
    "description": "Only show benchmarked/verified services",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "prowl_discover"
}
