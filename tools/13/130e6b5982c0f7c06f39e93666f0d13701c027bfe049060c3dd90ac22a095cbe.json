{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Analyse text"
 },
 "description": "Question answering over your own text: ask a question about material you supply and get an answer grounded only in that text (Gemini). If the text does not contain the answer it says so instead of guessing. Use it for summaries, Q&A and checks over documents, emails and pages. Input: text, question; optional language. Fixed JSON fields: llm.extract. $0.25 per call. Returns: answer, model, tokens{prompt,output}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "language": {
    "description": "Optional answer language, BCP-47 (en, ja, pt-BR). Default: the input's.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   },
   "question": {
    "description": "What to answer. Optional.",
    "type": "string"
   },
   "text": {
    "description": "Material to analyse.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "hubvibe_llm_analyze",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attribution": {
    "items": {},
    "type": "array"
   },
   "billing_warning": {
    "type": "string"
   },
   "price_usd": {
    "type": "number"
   },
   "provenance": {
    "type": "object"
   },
   "receipt_id": {
    "type": "string"
   },
   "receipt_url": {
    "type": "string"
   },
   "result": {
    "type": "object"
   },
   "status": {
    "const": "ok",
    "type": "string"
   },
   "worker": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "worker",
   "price_usd",
   "result",
   "provenance",
   "receipt_id",
   "receipt_url"
  ],
  "type": "object"
 },
 "title": "Analyse text"
}
