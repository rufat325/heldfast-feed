{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List enrollments within a specific course with Canvas filters. Use `include=grades` / `include=current_points` for richer grade data, `type[]` to limit to a role, and `user_id` to focus on a single user.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "enrollment_term_id": {
    "description": "Limit to enrollments in the given term",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "grading_period_id": {
    "description": "Scope grade-related includes to this grading period",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "include": {
    "description": "Extra fields to include (Canvas include[] param)",
    "items": {
     "enum": [
      "avatar_url",
      "group_ids",
      "locked",
      "observed_users",
      "can_be_removed",
      "uuid",
      "current_points",
      "grades"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "role": {
    "description": "Filter by custom role names",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "state": {
    "description": "Filter by enrollment states",
    "items": {
     "enum": [
      "active",
      "invited",
      "creation_pending",
      "deleted",
      "rejected",
      "completed",
      "inactive",
      "current_and_invited",
      "current_and_future",
      "current_and_concluded"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Filter by one or more enrollment types",
    "items": {
     "enum": [
      "StudentEnrollment",
      "TeacherEnrollment",
      "TaEnrollment",
      "DesignerEnrollment",
      "ObserverEnrollment"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "user_id": {
    "description": "Filter to a specific user (may be numeric ID or \"self\")",
    "type": [
     "number",
     "string"
    ]
   }
  },
  "required": [
   "course_id"
  ],
  "type": "object"
 },
 "name": "list_course_enrollments",
 "title": "List Course Enrollments"
}
