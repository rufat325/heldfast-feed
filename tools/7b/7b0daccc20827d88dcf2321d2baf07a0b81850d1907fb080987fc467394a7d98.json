{
 "_meta": {
  "ui": {
   "resourceUri": "ui://rds/widget.html"
  },
  "ui/resourceUri": "ui://rds/widget.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Score a mobile checkout flow's friction from step count, guest checkout, wallet pay, autofill, and mobile input types into a 0-100 score. See the full version at https://rahuldsarker.co/calculators/mobile-checkout-friction-tester",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "autofillSupported": {
    "description": "Autofill & saved details supported",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "correctMobileInputs": {
    "description": "Correct mobile input types & keyboards used",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "guestCheckout": {
    "description": "Guest checkout available",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "steps": {
    "description": "Checkout steps/screens: one (single page), two, or threeplus",
    "enum": [
     "one",
     "two",
     "threeplus"
    ],
    "type": "string"
   },
   "walletPay": {
    "description": "Wallet / one-tap pay (Apple/Google Pay) available",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   }
  },
  "required": [
   "steps",
   "guestCheckout",
   "walletPay",
   "autofillSupported",
   "correctMobileInputs"
  ],
  "type": "object"
 },
 "name": "mobile_checkout_friction_tester",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benchmarks": {
    "description": "Rule-of-thumb verdicts for the headline numbers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "band": {
       "type": "string"
      },
      "display": {
       "type": "string"
      },
      "metric": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "read": {
       "type": "string"
      },
      "segment": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "tone": {
       "enum": [
        "good",
        "ok",
        "warn",
        "bad"
       ],
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "metric",
      "name",
      "value",
      "display",
      "band",
      "tone",
      "read",
      "target",
      "segment",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bookingUrl": {
    "type": "string"
   },
   "calculator": {
    "description": "Slug of the interactive calculator on rahuldsarker.co",
    "type": "string"
   },
   "compact": {
    "type": "boolean"
   },
   "currency": {
    "type": [
     "string",
     "null"
    ]
   },
   "inputs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "kind": {
    "const": "calculator",
    "type": "string"
   },
   "metrics": {
    "description": "Every \"Label: value\" line of the result; value is the first number on the line",
    "items": {
     "additionalProperties": false,
     "properties": {
      "display": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "unit": {
       "anyOf": [
        {
         "enum": [
          "currency",
          "x",
          "%",
          "months"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "value": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "label",
      "value",
      "unit",
      "display"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "tool": {
    "description": "The calculator tool that produced this result",
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "kind",
   "tool",
   "title",
   "calculator",
   "url",
   "bookingUrl",
   "currency",
   "compact",
   "inputs",
   "metrics",
   "notes",
   "benchmarks"
  ],
  "type": "object"
 },
 "title": "Mobile Checkout Friction Tester"
}
