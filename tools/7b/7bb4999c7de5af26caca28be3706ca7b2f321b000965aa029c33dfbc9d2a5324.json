{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "What is the latest weekly flu count per sentinel for Japan, a prefecture or a covered health-center area? ISO week, value, recent weeks, official warning/advisory where announced (status_basis official), separate from a comparison with reference values (status_basis computed), school-closure counts by facility type and action where covered (no school names), tracking_since and receipts (url, fetched_at, sha256). Optional as_of date. Descriptive statistics only, no medical or travel advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "as_of": {
    "description": "Optional date YYYY-MM-DD: answer with what this service had recorded by the end of that day (UTC). Free window: the last 30 days; older dates return OUTSIDE_FREE_HISTORY_WINDOW.",
    "maxLength": 10,
    "type": "string"
   },
   "health_center": {
    "description": "Optional health-center area (\u4fdd\u5065\u6240\u7ba1\u5185) id or Japanese name, only for prefectures listed in coverage.prefectures_with_local_data.",
    "maxLength": 40,
    "type": "string"
   },
   "prefecture": {
    "description": "JP for the national total, or a prefecture: ISO 3166-2 code (JP-33), 1-2 digit code (33), English (Okayama) or Japanese (\u5ca1\u5c71\u770c) name.",
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "prefecture"
  ],
  "type": "object"
 },
 "name": "flu_region_snapshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "alert": {
    "additionalProperties": {},
    "properties": {
     "computed": {
      "additionalProperties": {},
      "description": "This service's comparison with published reference values; not an announcement.",
      "properties": {
       "level": {
        "enum": [
         "warning_criteria_met",
         "advisory_criteria_met",
         "below_criteria",
         "indeterminate"
        ],
        "type": "string"
       },
       "status_basis": {
        "const": "computed",
        "type": "string"
       }
      },
      "required": [
       "status_basis",
       "level"
      ],
      "type": "object"
     },
     "official": {
      "additionalProperties": {},
      "description": "What an authority announced (only where collected). Never filled from computed.",
      "properties": {
       "available": {
        "type": "boolean"
       },
       "status_basis": {
        "const": "official",
        "type": "string"
       }
      },
      "required": [
       "status_basis",
       "available"
      ],
      "type": "object"
     }
    },
    "required": [
     "official",
     "computed"
    ],
    "type": "object"
   },
   "answered_at": {
    "type": "string"
   },
   "as_of": {
    "type": "string"
   },
   "attribution": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "source_en": {
       "type": "string"
      },
      "terms_url": {
       "type": "string"
      }
     },
     "required": [
      "source_en",
      "terms_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "coverage": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "notice": {
    "type": "string"
   },
   "provenance": {
    "description": "Freshness receipts for every upstream source used.",
    "items": {
     "additionalProperties": {},
     "description": "Freshness receipt for one upstream source.",
     "properties": {
      "content_sha256": {
       "type": [
        "string",
        "null"
       ]
      },
      "fetch_status": {
       "description": "found / empty / stale / unavailable / unsupported (see catalog fetch_status_values).",
       "enum": [
        "found",
        "empty",
        "stale",
        "unavailable",
        "unsupported"
       ],
       "type": "string"
      },
      "parser_version": {
       "type": "string"
      },
      "processed_by": {
       "type": "string"
      },
      "retrieved_at": {
       "description": "When this service retrieved the upstream data (null if unknown).",
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "additionalProperties": {},
       "description": "Publisher and URL of the upstream document or dataset.",
       "properties": {
        "publisher": {
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "publisher",
        "url"
       ],
       "type": "object"
      },
      "upstream_updated_at": {
       "description": "Update time stated by the upstream, or null when it states none.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "source",
      "upstream_updated_at",
      "retrieved_at",
      "content_sha256",
      "parser_version",
      "fetch_status",
      "processed_by"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "receipts": {
    "description": "Raw files behind this answer: URL, when we fetched that content, SHA-256 of the bytes.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "fetched_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "sha256": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "fetched_at",
      "sha256"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "region": {
    "additionalProperties": {},
    "properties": {
     "code": {
      "type": "string"
     },
     "level": {
      "enum": [
       "national",
       "prefecture",
       "health_center_area"
      ],
      "type": "string"
     },
     "name_en": {
      "type": "string"
     },
     "name_ja": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "level",
     "name_en",
     "name_ja"
    ],
    "type": "object"
   },
   "school_closures": {
    "additionalProperties": {},
    "description": "Aggregate counts by facility type and action; never facility names.",
    "properties": {
     "status": {
      "enum": [
       "found",
       "not_yet_observed",
       "not_covered"
      ],
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "sentinel": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "iso_week": {
        "type": "string"
       },
       "per_sentinel": {
        "type": "number"
       },
       "source_url": {
        "type": "string"
       },
       "version_observed_at": {
        "type": "string"
       },
       "week_from": {
        "type": "string"
       },
       "week_to": {
        "type": "string"
       }
      },
      "required": [
       "iso_week",
       "week_from",
       "week_to",
       "per_sentinel",
       "source_url",
       "version_observed_at"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "description": "found = recorded and recently re-fetched; stale = last successful fetch older than stale_after_hours; not_yet_observed = no record (unknown, NOT 'no influenza'); unavailable = record store unreadable.",
    "enum": [
     "found",
     "stale",
     "not_yet_observed",
     "unavailable"
    ],
    "type": "string"
   },
   "terms": {
    "description": "URL of the terms of service.",
    "type": "string"
   },
   "tracking_since": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "status",
   "region",
   "as_of",
   "sentinel",
   "alert",
   "school_closures",
   "tracking_since",
   "receipts",
   "coverage",
   "attribution",
   "notice",
   "answered_at",
   "provenance",
   "terms"
  ],
  "type": "object"
 },
 "title": "Influenza snapshot for a Japanese region"
}
