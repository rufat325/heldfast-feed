  "title": "Fund Holdings"
 },
 "description": "Returns all disclosed positions currently processed for a hedge fund and quarter, paginated.\n\nWHEN TO USE: User wants every currently processed disclosed position for a fund, not just the headline moves or rating.\nExamples:\n  - \"List everything Berkshire Hathaway holds\"\n  - \"Show me Pershing Square's full portfolio\"\n  - \"What are all of Bridgewater's positions?\"\n\nPARAMETERS:\n  - cik_or_name: a CIK (e.g. \"0001067983\") or fund name (fuzzy-matched)\n  - quarter: optional quarter (default: latest available)\n  - limit: positions per page; an unsupported tier limit returns access_limited without changing the input\n  - cursor: pass back the previous response's next_cursor to fetch the next page\n\nWHEN NOT TO USE:\n  - Use analyze_fund for the rating, DNA archetype, and headline moves (not the full holdings list)\n  - Use compare_funds to compare portfolios across funds\n\nRETURNS: Fund and filing context plus cursor-paginated filing-native positions, including security listing status/detail, shares/value/weight, prior-position deltas, conviction, filing-period and current price dates/sources, cost basis, P&L, and price-data-through. Missing optional price or metadata fields are identified in data_status.\n\nVERIFICATION: Cite record-level `source_url` filing or disclosure links when present.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cik_or_name": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "maxLength": 500,
    "type": "string"
   },
   "instrument_type": {
    "default": "all",
    "enum": [
     "stocks",
     "options",
     "bonds",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "quarter": {
    "pattern": "^\\d{4}-Q[1-4]$",
    "type": "string"
   }
  },
  "required": [
   "cik_or_name"
  ],
  "type": "object"
 },
