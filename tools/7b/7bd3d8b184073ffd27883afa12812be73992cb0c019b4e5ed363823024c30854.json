{
 "annotations": {
  "readOnlyHint": true,
  "title": "List tasks"
 },
 "description": "List recruiting tasks (title, description, due date, completed, candidate_id). With candidate_id, lists that candidate's tasks (Recruitee: GET /c/{company_id}/candidates/{candidate_id}/tasks \u2014 only `status` applies). Otherwise lists company tasks with scope, assignee, sorting and paging (Recruitee: GET /c/{company_id}/tasks).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "admin_ids": {
    "description": "Only tasks assigned to these admin ids (company list only).",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "candidate_id": {
    "description": "Only this candidate's tasks.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "limit": {
    "description": "Tasks per page (company list only).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number, starting at 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "scope": {
    "description": "Whose tasks (company list only).",
    "enum": [
     "my",
     "unassigned",
     "all"
    ],
    "type": "string"
   },
   "sort_by": {
    "description": "Sort field (company list only).",
    "enum": [
     "due_date",
     "created_at",
     "completed_at"
    ],
    "type": "string"
   },
   "sort_order": {
    "description": "Sort direction (company list only).",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status": {
    "description": "Completed or open tasks only.",
    "enum": [
     "completed",
     "uncompleted"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "recruitee_list_tasks",
 "title": "List tasks"
}
