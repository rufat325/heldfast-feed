{
 "description": "Paid Agent Tool Router ($0.002 USDC on Base). Finds and ranks machine-payable MCP services and x402 HTTP endpoints before your agent chooses or pays a provider. Uses structured capability matching, hard constraints, price, observed latency/reliability, and cold-start trust confidence; no LLM call is required. Returns a recommendation only: it never invokes the selected provider or makes a second payment. Without X402_BAZAAR_DISCOVERY_URLS, results come only from this platform's local service registry and are marked degraded.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capability": {
    "maxLength": 80,
    "minLength": 2,
    "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]*$",
    "type": "string"
   },
   "constraints": {
    "additionalProperties": false,
    "properties": {
     "max_latency_ms": {
      "maximum": 600000,
      "minimum": 1,
      "type": "integer"
     },
     "max_price_usd": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "number"
     },
     "min_success_rate": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "preferences": {
    "additionalProperties": false,
    "properties": {
     "optimize_for": {
      "enum": [
       "cheapest",
       "fastest",
       "quality",
       "reliability",
       "balanced"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "query": {
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "capability"
  ],
  "type": "object"
 },
 "name": "route_tool",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "alternatives": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "capability_score": {
       "type": "number"
      },
      "currency": {
       "type": "string"
      },
      "endpoint": {
       "format": "uri",
       "type": "string"
      },
      "estimated_latency_ms": {
       "type": [
        "number",
        "null"
       ]
      },
      "latency_confidence": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      },
      "metadata_is_untrusted": {
       "type": "boolean"
      },
      "network": {
       "type": "string"
      },
      "overall_score": {
       "type": "number"
      },
      "price_confidence": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      },
      "price_usd": {
       "type": "number"
      },
      "protocol": {
       "enum": [
        "x402",
        "mcp",
        "https_api"
       ],
       "type": "string"
      },
      "provider": {
       "type": "string"
      },
      "service_id": {
       "type": "string"
      },
      "status": {
       "enum": [
        "active",
        "degraded",
        "unavailable",
        "unknown"
       ],
       "type": "string"
      },
      "success_rate": {
       "type": [
        "number",
        "null"
       ]
      },
      "tool_name": {
       "type": "string"
      },
      "trust_confidence": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      },
      "trust_score": {
       "type": "number"
      }
     },
     "required": [
      "service_id",
      "provider",
      "endpoint",
      "protocol",
      "price_usd",
      "capability_score",
      "trust_score",
      "trust_confidence",
      "success_rate",
      "estimated_latency_ms",
      "latency_confidence",
      "status",
      "overall_score",
      "price_confidence",
      "metadata_is_untrusted"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "best_tool": {
    "type": [
     "string",
     "null"
    ]
   },
   "cached": {
    "type": "boolean"
   },
   "candidates_after_filters": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "candidates_found": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "capability": {
    "type": "string"
   },
   "checked_at": {
    "type": "string"
   },
   "confidence": {
    "type": "number"
   },
   "degraded": {
    "type": "boolean"
   },
   "expected_total_cost_usd": {
    "type": [
     "number",
     "null"
    ]
   },
   "match_found": {
    "type": "boolean"
   },
   "next_best_tool": {
    "type": [
     "string",
     "null"
    ]
   },
   "optimize_for": {
    "enum": [
     "cheapest",
     "fastest",
     "quality",
     "reliability",
     "balanced"
    ],
    "type": "string"
   },
   "query": {
    "type": [
     "string",
     "null"
    ]
   },
   "reason": {
    "const": "NO_SERVICE_MATCHES_CONSTRAINTS",
    "type": "string"
   },
   "recommended": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "capability_score": {
        "type": "number"
       },
       "currency": {
        "type": "string"
       },
       "endpoint": {
        "format": "uri",
        "type": "string"
       },
       "estimated_latency_ms": {
        "type": [
         "number",
         "null"
        ]
       },
       "latency_confidence": {
        "enum": [
         "low",
         "medium",
         "high"
        ],
        "type": "string"
       },
       "metadata_is_untrusted": {
        "type": "boolean"
       },
       "network": {
        "type": "string"
       },
       "overall_score": {
        "type": "number"
       },
       "price_confidence": {
        "enum": [
         "low",
         "medium",
         "high"
        ],
        "type": "string"
       },
       "price_usd": {
        "type": "number"
       },
       "protocol": {
        "enum": [
         "x402",
         "mcp",
         "https_api"
        ],
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "service_id": {
        "type": "string"
       },
       "status": {
        "enum": [
         "active",
         "degraded",
         "unavailable",
         "unknown"
        ],
        "type": "string"
       },
       "success_rate": {
        "type": [
         "number",
         "null"
        ]
       },
       "tool_name": {
        "type": "string"
       },
       "trust_confidence": {
        "enum": [
         "low",
         "medium",
         "high"
        ],
        "type": "string"
       },
       "trust_score": {
        "type": "number"
       }
      },
      "required": [
       "service_id",
       "provider",
       "endpoint",
       "protocol",
       "price_usd",
       "capability_score",
       "trust_score",
       "trust_confidence",
       "success_rate",
       "estimated_latency_ms",
       "latency_confidence",
       "status",
       "overall_score",
       "price_confidence",
       "metadata_is_untrusted"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "recommended_next": {
    "additionalProperties": false,
    "properties": {
     "price": {
      "type": [
       "string",
       "null"
      ]
     },
     "reason": {
      "type": "string"
     },
     "tool": {
      "type": "string"
     }
    },
    "required": [
     "tool",
     "reason",
     "price"
    ],
    "type": "object"
   },
   "recommended_workflow": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "estimated_total_price_usd": {
        "type": "number"
       },
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "estimated_total_price_usd"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "registry_sources": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "routing_data_age_seconds": {
    "type": "number"
   },
   "routing_reason": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "why": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "success",
   "match_found",
   "capability",
   "query",
   "optimize_for",
   "recommended",
   "alternatives",
   "candidates_found",
   "candidates_after_filters",
   "routing_reason",
   "registry_sources",
   "degraded",
   "cached",
