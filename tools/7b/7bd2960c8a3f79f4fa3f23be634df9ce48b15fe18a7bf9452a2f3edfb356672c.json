    "properties": {
     "company": {
      "anyOf": [
       {
        "maxLength": 120,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "email": {
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
