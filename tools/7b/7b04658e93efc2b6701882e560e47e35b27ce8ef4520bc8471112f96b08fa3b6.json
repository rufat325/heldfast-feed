{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Create a customized instruction-only Website Starter ZIP after the start_website interview. Inputs are bounded and processed transiently; nothing is stored.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "aiTool": {
    "default": "codex",
    "enum": [
     "codex",
     "claude",
     "cursor",
     "other"
    ],
    "type": "string"
   },
   "computer": {
    "default": "private",
    "enum": [
     "private",
     "dedicated"
    ],
    "type": "string"
   },
   "dynamicNeeds": {
    "maxLength": 300,
    "type": "string"
   },
   "existingRepo": {
    "description": "HTTPS URL of an existing GitHub repository to continue instead of starting a new website.",
    "maxLength": 200,
    "type": "string"
   },
   "existingSite": {
    "maxLength": 300,
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "projectName": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "publicLanguages": {
    "default": "en",
    "enum": [
     "de",
     "en",
     "de-en"
    ],
    "type": "string"
   },
   "purpose": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectName",
   "purpose"
  ],
  "type": "object"
 },
 "name": "create_starter"
}
