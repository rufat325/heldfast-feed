 "description": "Audit a set of environment variables against a contract, without returning any value. Reports required variables that are absent, and separately those present but empty - which suppresses a default where absence does not. Checks value shapes such as port, url or duration, flags undeclared and forbidden variables, and names any value shaped like a credential without printing it. Pay 100000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contract": {
    "additionalProperties": false,
    "example": {
     "forbidden": [
      "DEBUG_SQL"
     ],
     "optional": [
      "LOG_LEVEL"
     ],
     "patterns": {
      "DATABASE_URL": "url",
      "LOG_LEVEL": "non-empty",
      "PORT": "port"
     },
     "required": [
      "DATABASE_URL",
      "SESSION_SECRET",
      "PORT",
      "FEATURE_FLAGS",
      "SENTRY_DSN"
     ]
    },
    "properties": {
     "allow_empty": {
      "description": "Whether a required variable may be present and empty. Defaults to false.",
      "type": "boolean"
     },
     "allow_undeclared": {
      "description": "Defaults to false.",
      "type": "boolean"
     },
     "forbidden": {
      "description": "Variables that must not be set in this environment, such as a debug switch.",
      "items": {
       "maxLength": 256,
       "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
     },
     "optional": {
      "items": {
       "maxLength": 256,
       "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
     },
     "patterns": {
      "description": "Map of variable to an expected shape. Supported: integer, number, boolean, url, https-url, port, email, non-empty, duration, comma-list. An unsupported name is reported as not checked.",
      "type": "object"
     },
     "required": {
      "items": {
       "maxLength": 256,
       "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   },
   "variables": {
    "description": "Variable names to values, at most 1000. No value is returned in the response.",
    "example": {
     "DATABASE_URL": "postgres://app:not-a-real-password@db.internal:5432/orders",
     "DEBUG_SQL": "true",
     "FEATURE_FLAGS": "",
     "GITHUB_TOKEN": "ghp_000000000000000000000000000000000000",
     "LOG_LEVEL": "debug",
     "PORT": "eight-thousand",
     "SESSION_SECRET": "f0e1d2c3b4a5968778695a4b3c2d1e0ff0e1d2c3b4a5968778695a4b3c2d1e0f"
    },
    "type": "object"
   }
  },
  "required": [
   "variables",
   "contract"
  ],
  "type": "object"
 },
