{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search the Pour Picks catalog"
 },
 "description": "Full-text search across 4,700+ bourbons, ryes, scotches, and other spirits in the Pour Picks database. Filter by category, price (USD), and proof. Returns structured tasting profiles with source attribution.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Spirit category filter",
    "enum": [
     "bourbon",
     "rye",
     "tennessee",
     "wheat",
     "corn",
     "american_single_malt",
     "scotch_single_malt",
     "scotch_blend",
     "irish",
     "japanese",
     "canadian",
     "world_whisky",
     "rum",
     "tequila",
     "mezcal",
     "cognac",
     "armagnac",
     "brandy",
     "gin",
     "vodka",
     "other"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 10, max 10)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "price_max": {
    "description": "Maximum price in USD",
    "minimum": 0,
    "type": "number"
   },
   "price_min": {
    "description": "Minimum price in USD",
    "minimum": 0,
    "type": "number"
   },
   "proof_max": {
    "description": "Maximum proof",
    "minimum": 0,
    "type": "number"
   },
   "proof_min": {
    "description": "Minimum proof",
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Free-text search: distillery, bottle name, or expression",
    "maxLength": 120,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_bottles"
}
