{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "Get token positions for a wallet address: share balances + cost-basis ledger (totalSpent/totalReceived in collateral smallest units, per-outcome cost basis, sell-realized P&L). Pass include=\"valuation\" to add per-position currentPrices (0-1 scale) and markValue (collateral smallest units) marked at the canonical indexer price \u2014 may lag the chain. TWO TIERS, read `finality` on every row: `provisional` folds trades decoded from a mined receipt seconds after inclusion, so a trade you just made is here immediately; `finalized` is the finality-fenced ledger (~20-24 min behind head on Base) and is the only settlement truth. Provisional rows move share balances only \u2014 their cost-basis columns and the response `aggregates` stay finalized-tier.",
 "inputSchema": {
  "properties": {
   "chainId": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "cursor": {
    "maxLength": 2048,
    "type": "string"
   },
   "include": {
    "description": "Set to \"valuation\" to add currentPrices (0-1) and markValue per position.",
    "enum": [
     "valuation"
    ],
    "type": "string"
   },
   "limit": {
    "default": 100,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "marketAddress": {
    "type": "string"
   },
   "walletAddress": {
    "type": "string"
   }
  },
  "required": [
   "walletAddress"
  ],
  "type": "object"
 },
 "name": "problee_get_positions",
 "outputSchema": {
  "$defs": {
   "ExactTradingRatio": {
    "additionalProperties": false,
