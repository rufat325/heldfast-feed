     "denominator": {
      "maxLength": 4096,
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
     },
     "numerator": {
      "maxLength": 4096,
      "pattern": "^-?(0|[1-9][0-9]*)$",
      "type": "string"
     }
    },
    "required": [
     "numerator",
     "denominator"
    ],
    "type": "object"
   },
   "IndexerReadMetadata": {
    "additionalProperties": false,
    "properties": {
     "degradedReason": {
      "anyOf": [
       {
        "const": "INDEXER_UNHEALTHY",
