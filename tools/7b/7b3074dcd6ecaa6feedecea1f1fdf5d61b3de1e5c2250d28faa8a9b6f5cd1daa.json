{
 "description": "Generate an optimized GPU kernel from scratch based on a specification.\nUse this when you need to create a new high-performance kernel without existing PyTorch code.\nForge will generate a PyTorch baseline first, then optimize it into Triton or CUDA.\n\nRequires authentication via forge_auth first. Cost: 1 credit per generation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Detailed description of what the kernel should do",
    "maxLength": 10240,
    "type": "string"
   },
   "dtype": {
    "default": "float16",
    "description": "Data type (float16, float32, bfloat16)",
    "type": "string"
   },
   "gpu": {
    "default": "H100",
    "enum": [
     "B200",
     "H200",
     "H100",
     "L40S",
     "L4",
     "A100",
     "A10",
     "T4"
    ],
    "type": "string"
   },
   "input_shapes": {
    "description": "Input tensor shapes, e.g., [[8, 512, 768]] for a single input",
    "items": {
     "items": {
      "type": "number"
     },
     "type": "array"
    },
    "type": "array"
   },
   "max_iterations": {
    "default": 10,
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "operation": {
    "description": "Operation name (e.g., \"fused_attention\", \"custom_gelu\", \"softmax\", \"matmul\")",
    "maxLength": 200,
    "type": "string"
   },
   "output_format": {
    "default": "triton",
    "description": "Output format",
    "enum": [
     "triton",
     "native_cuda"
    ],
    "type": "string"
   },
   "output_shape": {
    "description": "Expected output tensor shape",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "target_speedup": {
    "default": 2,
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "user_prompt": {
    "maxLength": 10240,
    "type": "string"
   }
  },
  "required": [
   "operation",
   "description",
   "input_shapes"
  ],
  "type": "object"
 },
 "name": "forge_generate",
 "title": "Generate GPU Kernel"
}
