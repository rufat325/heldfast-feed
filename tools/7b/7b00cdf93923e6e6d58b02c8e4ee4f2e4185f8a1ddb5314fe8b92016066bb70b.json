{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a rate-limit policy's name, unit, value, or non-empty conditions by id. The public contract does not allow changing its type, target, or grouping after creation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "conditions": {
    "description": "Replacement conditions",
    "items": {
     "properties": {
      "excludes": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        }
       ],
       "description": "Values to exclude"
      },
      "key": {
       "description": "Match key such as api_key, virtual_key, provider, config, prompt, model, endpoint_type, mcp_server, mcp_tool, workspace_id, or metadata.*",
       "minLength": 1,
       "type": "string"
      },
      "value": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        }
       ],
       "description": "One value or several OR-matched values; use * for wildcard matching"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "id": {
    "description": "Rate-limit policy UUID",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Replacement display name",
    "type": "string"
   },
   "unit": {
    "description": "Replacement reset interval",
    "enum": [
     "rpm",
     "rph",
     "rpd",
     "rpw"
    ],
    "type": "string"
   },
   "value": {
    "description": "Replacement maximum",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_rate_limit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
