{
 "annotations": {
  "readOnlyHint": true,
  "title": "List knowledgebase articles"
 },
 "description": "List knowledgebase articles, filterable by category, status and author. Deskpro: GET /api/v2/articles.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "author": {
    "description": "Only articles by this author id, or 'me' for the key's agent.",
    "pattern": "^(\\d+|me)$",
    "type": "string"
   },
   "category": {
    "description": "Only articles in this category id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "count": {
    "description": "Results per page, 1-200.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "order_by": {
    "description": "Sort field.",
    "enum": [
     "date_created",
     "date_updated",
     "person"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number, starting at 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Only articles in this status.",
    "enum": [
     "published",
     "archived",
     "hidden"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "deskpro_list_articles",
 "title": "List knowledgebase articles"
}
