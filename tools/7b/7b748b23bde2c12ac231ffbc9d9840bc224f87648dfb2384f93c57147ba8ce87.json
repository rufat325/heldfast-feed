{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Remove a bookmark by id (preferred) or by (slug, asset_type) pair. Errors if the bookmark does not exist.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "asset_type": {
    "description": "Asset type \u2014 required when using slug.",
    "enum": [
     "mcp_server",
     "mcp_client",
     "agent",
     "skill",
     "prompt",
     "plugin"
    ],
    "type": "string"
   },
   "id": {
    "description": "Bookmark id (preferred). Get from list_bookmarks.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "slug": {
    "description": "Asset slug \u2014 must be paired with asset_type if id is not provided.",
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "unbookmark_asset",
 "title": "Remove a bookmark"
}
