{
 "description": "List the user's most recent Clipy screen recordings (newest first). Use this to browse when you don't have a search term.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results (default 20).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Optional filter by processing status.",
    "enum": [
     "ready",
     "processing",
     "failed",
     "pending",
     "queued"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_recordings"
}
