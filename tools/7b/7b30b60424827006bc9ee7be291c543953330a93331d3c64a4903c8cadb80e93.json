{
 "description": "Calculate cyclomatic complexity of functions, count lines per function, and measure nesting depth. Flags functions that exceed configurable thresholds.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "code": {
    "description": "The source code to analyze",
    "type": "string"
   },
   "maxLines": {
    "default": 50,
    "description": "Maximum lines per function before flagging (default: 50)",
    "type": "number"
   },
   "maxNestingDepth": {
    "default": 4,
    "description": "Maximum nesting depth before flagging (default: 4)",
    "type": "number"
   },
   "threshold": {
    "default": 10,
    "description": "Cyclomatic complexity threshold to flag (default: 10)",
    "type": "number"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "analyze_complexity"
}
