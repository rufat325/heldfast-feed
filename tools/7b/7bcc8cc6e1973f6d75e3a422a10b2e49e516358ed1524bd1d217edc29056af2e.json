{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Pollar breaking-news moments"
 },
 "description": "Lists Pollar's live and recently ended breaking-news moments: what is breaking now and what ended within the past 24 hours. A moment that belongs to a multi-chapter story carries its storyId and chapterIndex, and chapters of one story come in chapter order. get_live_moment takes a returned id for the current snapshot.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "pl",
     "de",
     "fr"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_live_moments",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "moments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "chapterIndex": {
       "type": "number"
      },
      "decisionAt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "endedAt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "eventOnsetAt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "freshnessBand": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "string"
      },
      "importance": {
       "type": "number"
      },
      "kind": {
       "type": "string"
      },
      "lastBody": {
       "type": "string"
      },
      "lastStateAt": {
       "type": "string"
      },
      "startedAt": {
       "type": "string"
      },
      "status": {
       "enum": [
        "live",
        "ended"
       ],
       "type": "string"
      },
      "storyId": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "kind",
      "status",
      "title",
      "startedAt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "moments"
  ],
  "type": "object"
 },
 "title": "List Pollar breaking-news moments"
}
