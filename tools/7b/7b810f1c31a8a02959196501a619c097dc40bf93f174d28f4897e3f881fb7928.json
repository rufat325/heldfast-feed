{
 "description": "Set a logpoint that logs a message without pausing execution. Use {variable} syntax for interpolation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "file": {
    "description": "The file path (absolute or relative)",
    "type": "string"
   },
   "line": {
    "description": "The line number (1-indexed)",
    "type": "number"
   },
   "logMessage": {
    "description": "Log message template with {variable} interpolation (e.g., \"Value is {x}\")",
    "type": "string"
   },
   "sessionId": {
    "description": "The debug session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "file",
   "line",
   "logMessage"
  ],
  "type": "object"
 },
 "name": "debugger_set_logpoint"
}
