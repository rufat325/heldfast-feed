{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update a volunteer's details. Send only the fields you want to change; a field set to null clears it. Requires the `contacts:write` scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "contact_id": {
    "description": "The contact's numeric id (from list_contacts).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "email_address": {
    "anyOf": [
     {
      "format": "email",
      "maxLength": 320,
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Email address reminders may be sent to, or null."
   },
   "first_name": {
    "anyOf": [
     {
      "maxLength": 120,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "First name, or null."
   },
   "full_name": {
    "description": "New display name.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "group_id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Id of an existing group on this account to file the contact under, or null."
   },
   "land_phone": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Landline number (informational only, never texted), or null."
   },
   "last_name": {
    "anyOf": [
     {
      "maxLength": 120,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Last name, or null."
   },
   "mobile_phone": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Mobile number for SMS reminders. Accepts E.164 (+15125550100) or a plain 10-digit US/Canada number; stored as E.164. Send null to clear."
   },
   "notes": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Free-text notes about the contact, or null."
   }
  },
  "required": [
   "contact_id"
  ],
  "type": "object"
 },
 "name": "update_contact",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "full_name": {
    "type": "string"
   },
   "id": {
    "type": "number"
   }
  },
  "required": [
   "id",
   "full_name"
  ],
  "type": "object"
 },
 "title": "Update a volunteer"
}
