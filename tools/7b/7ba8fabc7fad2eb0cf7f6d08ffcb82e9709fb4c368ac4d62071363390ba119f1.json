{"annotations":{"openWorldHint":true,"readOnlyHint":true},"description":"Get one wiki page by its page_url slug \u2014 not a numeric ID \u2014 obtained from list_pages. Returns the page's title, published state, editing_roles and full HTML body, unlike the list endpoint's body-less stubs. Use list_pages to discover a course's pages and find a page_url, and update_page to edit this page's title, body, published state or editing_roles afterward.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"course_id":{"anyOf":[{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},{"pattern":"^[1-9][0-9]{0,18}$","type":"string"}],"description":"The Canvas course ID"},"page_url":{"description":"The page URL slug (e.g. \"welcome-page\")","type":"string"}},"required":["course_id","page_url"],"type":"object"},"name":"get_page","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"body":{"type":["string","null"]},"created_at":{"type":["string","null"]},"editing_roles":{"type":["string","null"]},"page_id":{"type":["number","string"]},"published":{"type":["boolean","null"]},"title":{"type":"string"},"updated_at":{"type":["string","null"]},"url":{"type":"string"}},"required":["page_id","url","title"],"type":"object"},"title":"Get Page"}
