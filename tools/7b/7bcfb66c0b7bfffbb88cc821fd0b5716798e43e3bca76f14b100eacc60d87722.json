{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Edit an alert"
 },
 "description": "Edits the interest, or pauses or turns on again an alert of the owner. The filters replace the whole filter.",
 "inputSchema": {
  "properties": {
   "ativo": {
    "description": "`false` pauses without deleting; `true` turns it on again.",
    "type": "boolean"
   },
   "canal": {
    "description": "New channel: `pull`, `webhook` or `email` (the verified e-mail of the account; requires a session).",
    "enum": [
     "pull",
     "webhook",
     "email"
    ],
    "type": "string"
   },
   "destino": {
    "description": "New https URL on port 443 (webhook). Ignored for pull and email.",
    "type": "string"
   },
   "filtros": {
    "additionalProperties": false,
    "description": "Extra filter: modalities, municipalities, exclusions, values, open proposals and CNAEs. PATCH replaces the whole filter; {} clears it.",
    "properties": {
     "abertas": {
      "type": "boolean"
     },
     "cnaes": {
      "items": {
       "pattern": "^\\d{4}-?\\d/?\\d{2}$",
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "excluir": {
      "items": {
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "modalidades": {
      "items": {
       "maximum": 19,
       "minimum": 1,
       "type": "integer"
      },
      "maxItems": 10,
      "type": "array"
     },
     "municipios": {
      "items": {
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "valor_max": {
      "minimum": 0,
      "type": "number"
     },
     "valor_min": {
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "id": {
    "description": "Alert identifier.",
    "type": "string"
   },
   "termos": {
    "description": "Object terms; a space requires all words, | accepts alternatives.",
    "type": "string"
   },
   "uf": {
    "description": "State (UF) abbreviation; empty means all.",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_alert",
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Edit an alert"
}
