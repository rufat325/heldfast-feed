{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Review 1-5 HeyClaude entries for source, package, safety, and privacy metadata fit before install or recommendation. This is a metadata review only and does not provide malware scanning, automatic safety guarantees, or installation approval.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "entries": {
    "description": "1\u20135 entries to review for safety and privacy metadata, each identified by category and slug.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "description": "Category of the entry.",
       "maxLength": 120,
       "minLength": 1,
       "pattern": "^[a-z0-9-]+$",
       "type": "string"
      },
      "slug": {
       "description": "Slug of the entry.",
       "maxLength": 120,
       "minLength": 1,
       "pattern": "^[a-z0-9-]+$",
       "type": "string"
      }
     },
     "required": [
      "category",
      "slug"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "platform": {
    "description": "Target platform to contextualize safety and compatibility notes.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 },
 "name": "entry.safety",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "ok": {
    "type": "boolean"
   },
   "policy": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
