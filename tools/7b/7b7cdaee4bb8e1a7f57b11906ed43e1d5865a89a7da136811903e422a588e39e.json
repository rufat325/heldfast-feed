     },
     "total_sf": {
      "type": "number"
     },
     "total_sf_net": {
      "type": "number"
     }
    },
    "required": [
     "total_sf",
     "total_sf_net",
     "lf",
     "lf_net",
     "ea",
     "sy_net"
    ],
    "type": "object"
   },
