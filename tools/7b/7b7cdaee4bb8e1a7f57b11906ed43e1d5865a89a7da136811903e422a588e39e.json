    "type": "string"
   }
  },
  "required": [
   "schema",
   "project_name",
   "generated_with",
   "sheets",
   "conditions",
   "by_sheet",
   "totals",
   "materials",
   "markups",
   "rfis",
   "condition_columns",
   "shape_labels",
   "by_label",
   "units",
   "display_units",
   "roll_goods"
  ],
  "type": "object"
 }
}
