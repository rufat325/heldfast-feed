{
 "description": "Execute a job with optional arguments, node filter, and log level. Returns the execution ID for monitoring.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asUser": {
    "description": "Run as a different user (requires admin)",
    "type": "string"
   },
   "id": {
    "description": "Job UUID",
    "type": "string"
   },
   "logLevel": {
    "description": "Log level override",
    "enum": [
     "DEBUG",
     "VERBOSE",
     "INFO",
     "WARN",
     "ERROR"
    ],
    "type": "string"
   },
   "nodeFilter": {
    "description": "Node filter expression (e.g., 'name: web.*')",
    "type": "string"
   },
   "options": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Job option values as key-value pairs",
    "type": "object"
   },
   "runAtTime": {
    "description": "Schedule execution at ISO 8601 time (e.g., '2024-12-01T10:00:00Z')",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "rundeck_run_job"
}
