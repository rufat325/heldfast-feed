{
 "description": "STRICTLY NO-WRITE assignment plan. Resolves the exact masked recipient, immutable course version and module, canonical mastery eligibility, run budget, Project To-do effects, due/blocking behavior, future-hire state, request hash, and signed receipt. It creates no assignment, To-do, attempt, progress, event, or notification. Requires lms:write because it previews a protected mutation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "enum": [
     "ACTIVE",
     "FUTURE",
     "ACTIVE_AND_FUTURE",
     "SELECTED"
    ],
    "type": "string"
   },
   "blockingMode": {
    "enum": [
     "NONE",
     "IMMEDIATE",
     "AFTER_DUE"
    ],
    "type": "string"
   },
   "categoryId": {
    "anyOf": [
     {
      "$ref": "#/properties/jobId"
     },
     {
      "type": "null"
     }
    ]
   },
   "completionPolicy": {
    "enum": [
     "SYSTEM",
     "EMPLOYER_REVIEW"
    ],
    "type": "string"
   },
   "courseId": {
    "$ref": "#/properties/jobId"
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 20000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "dueOffsetMinutes": {
    "anyOf": [
     {
      "maximum": 525600,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "expectedCourseVersionId": {
    "$ref": "#/properties/jobId"
   },
   "jobId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "masteryAntiGuessPolicy": {
    "additionalProperties": false,
    "properties": {
     "cooldownStepsSeconds": {
      "items": {
       "maximum": 3600,
       "minimum": 1,
       "type": "integer"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     },
     "restartScope": {
      "enum": [
       "WHOLE_MODULE",
       "MISSED_QUESTIONS"
      ],
      "type": "string"
     },
     "schemaVersion": {
      "const": 1,
      "type": "number"
     }
    },
    "required": [
     "schemaVersion",
     "cooldownStepsSeconds",
     "restartScope"
    ],
    "type": "object"
   },
   "masteryMode": {
    "type": "boolean"
   },
   "masteryRunLimit": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "moduleKeys": {
    "items": {
     "$ref": "#/properties/jobId"
    },
    "maxItems": 1,
    "type": "array"
   },
   "priority": {
    "enum": [
     "NORMAL",
     "HIGH",
     "URGENT"
    ],
    "type": "string"
   },
   "required": {
    "type": "boolean"
   },
   "selectedContractIds": {
    "items": {
     "$ref": "#/properties/jobId"
    },
    "maxItems": 1,
    "type": "array"
   },
   "title": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "courseId",
   "expectedCourseVersionId",
   "completionPolicy",
   "audience"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_plan_assignment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
