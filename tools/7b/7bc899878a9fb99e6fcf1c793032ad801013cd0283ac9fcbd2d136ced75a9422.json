{
 "description": "Add or remove labels on multiple emails at once (Gmail only). Much faster than individual email_label calls.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "type": "string"
   },
   "addLabels": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "emailIds": {
    "description": "Array of email IDs to label",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "removeLabels": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "accountId",
   "emailIds"
  ],
  "type": "object"
 },
 "name": "email_batch_label"
}
