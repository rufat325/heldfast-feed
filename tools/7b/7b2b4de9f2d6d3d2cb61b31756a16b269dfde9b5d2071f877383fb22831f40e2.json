       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warn",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "ruleId",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "b": {
    "additionalProperties": false,
    "properties": {
     "grade": {
      "enum": [
       "A",
       "B",
       "C",
       "D",
       "F"
      ],
      "type": "string"
     },
     "score": {
      "type": "number"
     },
     "url": {
      "type": "string"
     }
    },
