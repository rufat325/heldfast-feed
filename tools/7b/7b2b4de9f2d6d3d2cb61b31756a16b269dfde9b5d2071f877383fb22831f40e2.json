    "maximum": 9007199254740991,
    "type": "integer"
   },
   "urlA": {
    "description": "first (baseline) URL",
    "minLength": 1,
    "type": "string"
   },
   "urlB": {
    "description": "second (candidate) URL",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
