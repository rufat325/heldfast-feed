{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get stories for one instrument"
 },
 "description": "News stories linked to one instrument, newest first, for one country (IN or US). The instrument can be a listed company by name or ticker ('Reliance', 'HDFCBANK'), a commodity ('crude oil', 'gold'), an index ('Nifty'), the rupee, or a central bank's policy rate ('repo rate'). Unlike search_stories, which matches words, this returns the stories linked to that instrument. A name FocusPulse does not track returns UNKNOWN_INSTRUMENT \u2014 use list_instruments to see what is covered. Stories are kept 48 hours. Information only \u2014 never investment advice.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "country": {
    "description": "Market the story affects: 'IN' (India) or 'US'.",
    "enum": [
     "IN",
     "US"
    ],
    "type": "string"
   },
   "cursor": {
    "description": "next_cursor from the previous page of the same request. Omit for the first page.",
    "maxLength": 600,
    "type": "string"
   },
   "hours": {
    "description": "Lookback window in hours, default 48, max 48.",
    "maximum": 48,
    "minimum": 1,
    "type": "integer"
   },
   "instrument": {
    "description": "One company (name or NSE/US ticker), commodity, index, 'rupee' or 'repo rate'.",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "limit": {
    "description": "Stories per page, default 5, max 10.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "instrument",
   "country"
  ],
  "type": "object"
 },
 "name": "get_instrument_stories",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "code": {
    "enum": [
     "OK",
     "NO_DATA",
     "UNKNOWN_INSTRUMENT"
    ],
    "type": "string"
   },
   "country": {
    "enum": [
     "IN",
     "US"
    ],
    "type": "string"
   },
   "instruments": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "stories": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "country": {
       "enum": [
        "IN",
        "US"
       ],
       "type": "string"
      },
      "first_seen_at": {
       "type": "string"
      },
      "headline": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "instruments": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "relevance": {
       "type": "number"
      },
      "sources": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "summary": {
       "type": [
        "string",
        "null"
       ]
      },
      "why_it_matters": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "headline",
      "summary",
      "why_it_matters",
      "instruments",
      "relevance",
      "country",
      "first_seen_at",
      "sources"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   },
   "window_hours": {
    "type": "number"
   }
  },
  "required": [
   "code",
   "instruments",
   "stories",
   "next_cursor",
   "total",
   "country",
   "window_hours"
  ],
  "type": "object"
 },
 "title": "Get stories for one instrument"
}
