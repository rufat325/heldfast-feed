 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "anyOf": [
     {
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Continue with the same arguments; bound to this corpus release."
   },
   "instrument_id": {
    "description": "Registry instrument id.",
    "maxLength": 64,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "limit": {
    "anyOf": [
     {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Notes per page, default 10; complete bodies are never truncated."
   },
   "note_key": {
    "anyOf": [
     {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9*._-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Exact key returned by this tool. Omit to list notes. Printed markers may be reused and are not necessarily unique keys."
   },
   "version_id": {
    "anyOf": [
     {
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Omit or use current for the served version; pinned versions return an explicit version_not_served link."
   }
  },
  "required": [
   "instrument_id"
  ],
  "type": "object"
 },
 "name": "get_source_notes",
