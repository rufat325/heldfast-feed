    "examples": [
     "Checking whether SN64's API is healthy before recommending it to a user"
    ],
    "type": "string"
   },
   "conversation_id": {
    "description": "Reuse the conversation_id returned by this server; omit on the first call. Analytics only.",
    "examples": [
     "0198f2d6-0000-7000-8000-000000000001"
    ],
    "type": "string"
   },
   "id": {
    "description": "The subscription's id, a UUID v4, as returned when the subscription was created. There is no listing tool: an id that was not kept cannot be recovered. A malformed id is rejected outright.",
    "examples": [
     "3f2a1c6e-9b7d-4e21-8c5a-2d4f6b8e0a13"
    ],
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "llm_model": {
