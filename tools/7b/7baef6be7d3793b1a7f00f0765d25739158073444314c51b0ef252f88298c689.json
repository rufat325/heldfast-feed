{
 "description": "Force-stop then re-launch an app. The most frequent debugging workflow in a single call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "delayMs": {
    "default": 500,
    "description": "Delay between stop and start in ms (0-10000, default 500)",
    "maximum": 10000,
    "minimum": 0,
    "type": "number"
   },
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "packageName": {
    "description": "Package name (e.g., 'com.example.app')",
    "type": "string"
   }
  },
  "required": [
   "packageName"
  ],
  "type": "object"
 },
 "name": "adb_restart_app"
}
