{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "End call"
 },
 "description": "End an in-progress call early. The voice agent wraps up politely (\"I'll let you go, thanks!\") and hangs up; the call is force-terminated if wrap-up takes more than ~10 seconds. Use when the user changes their mind or the call is no longer needed. The partial transcript and resolution are still produced.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "call_id": {
    "description": "The id returned by place_call.",
    "type": "string"
   }
  },
  "required": [
   "call_id"
  ],
  "type": "object"
 },
 "name": "end_call",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
   {
    "additionalProperties": {},
    "properties": {
     "call_id": {
      "description": "Call identifier used with get_call, end_call and set_call_visibility.",
      "type": "string"
     },
     "ended": {
      "description": "Whether an end request was applied; false if already terminal.",
      "type": "boolean"
     },
     "message": {
      "description": "Wrap-up or already-ended explanation.",
      "type": "string"
     },
     "status": {
      "description": "Current call lifecycle state.",
      "enum": [
       "queued",
       "ringing",
       "in_progress",
       "completed",
       "no_answer",
       "busy",
       "voicemail",
       "failed",
       "rejected",
       "canceled",
       "declined_recording",
       "opted_out"
      ],
      "type": "string"
     }
    },
    "required": [
     "call_id",
     "status",
     "ended",
     "message"
    ],
    "type": "object"
   },
   {
    "additionalProperties": {},
    "properties": {
     "error": {
      "description": "Machine-readable failure code.",
      "type": "string"
     },
     "message": {
      "description": "Explanation or recovery guidance.",
      "type": "string"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "description": "Successful result or a machine-readable tool error.",
  "type": "object"
 }
}
