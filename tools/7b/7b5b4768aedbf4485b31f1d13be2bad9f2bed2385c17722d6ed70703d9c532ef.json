{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "imagelato:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Change a resize preset"
 },
 "description": "Use this when someone wants to rename a resize preset or change its output formats or widths. Returns the updated template after replacing only the fields given, and fires the template.updated webhook; it cannot move the preset to another project. Not for creating a preset.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "formats": {
    "description": "New output formats, one to five of jpg, png, webp, gif or svg; replaces the current list",
    "items": {
     "enum": [
      "jpg",
      "png",
      "webp",
      "gif",
      "svg"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "description": "New preset name, from 1 to 120 characters",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "sizes": {
    "description": "New output widths in pixels, one to ten strings from 1 to 9999; replaces the current list",
    "items": {
     "description": "Positive pixel width from 1 to 9999, written as a string",
     "pattern": "^[1-9]\\d{0,3}$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "templateIdOrName": {
    "description": "Exact template id or name",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "templateIdOrName"
  ],
  "type": "object"
 },
 "name": "update_template",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "enum": [
     "updated",
     "not-found"
    ],
    "type": "string"
   },
   "template": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "created": {
        "anyOf": [
         {
          "maxLength": 100,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "edited": {
        "$ref": "#/properties/template/anyOf/0/properties/created"
       },
       "formats": {
        "items": {
         "maxLength": 20,
         "type": "string"
        },
        "maxItems": 5,
        "type": "array"
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 120,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "projectId": {
        "$ref": "#/properties/template/anyOf/0/properties/id"
       },
       "sizes": {
        "items": {
         "maxLength": 20,
         "type": "string"
        },
        "maxItems": 10,
        "type": "array"
       }
      },
      "required": [
       "id",
       "name",
       "projectId",
       "formats",
       "sizes",
       "created",
       "edited"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "status",
   "template"
  ],
  "type": "object"
 },
 "title": "Change a resize preset"
}
