{
 "description": "Gets a specific message for a mailbox, including hydrated text/html bodies when available.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "format": "starts_with",
    "pattern": "^amk_.*",
    "type": "string"
   },
   "mailboxId": {
    "minLength": 1,
    "type": "string"
   },
   "messageId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "mailboxId",
   "messageId"
  ],
  "type": "object"
 },
 "name": "assistantmail_get_message"
}
