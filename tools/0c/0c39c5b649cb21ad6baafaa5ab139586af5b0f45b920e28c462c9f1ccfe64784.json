{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Export searched logs to an Object Storage bucket in Cloud Log Analytics.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucketname": {
    "description": "Object Storage bucket name (required)",
    "type": "string"
   },
   "keyword": {
    "description": "Search keyword",
    "type": "string"
   },
   "logTypes": {
    "description": "Log type filter (e.g. SYSLOG, security_log, tomcat)",
    "type": "string"
   },
   "regionCode": {
    "description": "Region code as a lowercase path segment (kr, jpn, sgn, uswn, den). Default: the client's active region",
    "type": "string"
   },
   "regionNo": {
    "description": "Region number",
    "type": "number"
   },
   "timestampFrom": {
    "description": "Start time (default now-1h)",
    "type": "string"
   },
   "timestampTo": {
    "description": "End time (default now)",
    "type": "string"
   }
  },
  "required": [
   "bucketname"
  ],
  "type": "object"
 },
 "name": "ncloud_export_logs"
}
