{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search collected logs in Cloud Log Analytics.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "interval": {
    "description": "Time interval, e.g. 5m/1h/1d (default 5m)",
    "type": "string"
   },
   "keyword": {
    "description": "Search keyword (default: all)",
    "type": "string"
   },
   "logTypes": {
    "description": "Log type filter, e.g. SYSLOG, security_log",
    "type": "string"
   },
   "pageNo": {
    "description": "Page number (1-100, default 1)",
    "type": "number"
   },
   "pageSize": {
    "description": "Page size (10-100, default 10)",
    "type": "number"
   },
   "regionCode": {
    "description": "Region code (kr, krs). Default kr",
    "type": "string"
   },
   "timestampFrom": {
    "description": "Start Unix timestamp",
    "type": "string"
   },
   "timestampTo": {
    "description": "End Unix timestamp",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ncloud_search_logs"
}
