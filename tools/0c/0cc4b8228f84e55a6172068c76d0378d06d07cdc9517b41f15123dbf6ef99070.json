 "description": "Series resistor and power dissipation for a Zener shunt regulator. Is = (Vin-Vz)/Rs, Iz = Is - Il, Pz = Vz*Iz, Prs = (Vin-Vz)*Is.\n\nArgs: vin_v, vz_v, il_a (load current, default 0), exactly one of rs_ohm (compute Iz) or iz_min_a (solve Rs), pz_max_w (optional Zener rating check).\nReturns (structured): { rs_ohm, is_a, iz_a, pz_w, prs_w, zener_ok (null if no pz_max) }.\nExample: Vin=12, Vz=5.1, Il=10mA, Rs=220 -> Iz 21.4 mA, Pz 0.109 W. Snap Rs with embedcalc_eseries_nearest.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "il_a": {
    "default": 0,
    "description": "Load current in A",
    "minimum": 0,
    "type": "number"
   },
   "iz_min_a": {
    "description": "Target minimum Zener current (solve Rs)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "pz_max_w": {
    "description": "Zener power rating in W (sets zener_ok)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "rs_ohm": {
    "description": "Series resistor (compute Iz)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "vin_v": {
    "description": "Input voltage in V",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "vz_v": {
    "description": "Zener voltage in V",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "vin_v",
   "vz_v"
  ],
  "type": "object"
 },
 "name": "embedcalc_zener_reg",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "is_a": {
    "type": "number"
   },
   "iz_a": {
    "type": "number"
   },
   "prs_w": {
    "type": "number"
   },
   "pz_w": {
    "type": "number"
   },
   "rs_ohm": {
    "type": "number"
   },
