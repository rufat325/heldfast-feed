{"_meta":{"securitySchemes":[{"scopes":["gpu"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Create a GPU pod"},"description":"Needs a rent.dev account: sign in when your client offers it, or call rent_signup first. Starts a GPU pod on RunPod with your own RunPod key (store it with rent_set_byok_credential, vendor runpod). RunPod bills your key by the hour until rent_terminate_gpu_pod; no rent.dev balance is used. The pod id (`lse_\u2026`) lives until it is terminated. Arguments not listed are refused by name. When RunPod is out of that GPU type it answers 503 `no_capacity` with `retry_after` and the pod is listed failed; retry after that, or pick another RunPod GPU type from rent_quote, which may be in stock.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"cloud_type":{"description":"Default SECURE.","enum":["SECURE","COMMUNITY"],"type":"string"},"container_disk_gb":{"description":"Default 20.","maximum":9007199254740991,"minimum":1,"type":"integer"},"credential_id":{"description":"RunPod credential (`cred_\u2026`); default the account's only one.","type":"string"},"env":{"additionalProperties":{"type":"string"},"propertyNames":{"type":"string"},"type":"object"},"gpu_count":{"description":"Default 1.","maximum":9007199254740991,"minimum":1,"type":"integer"},"gpu_type":{"description":"RunPod GPU type id, e.g. NVIDIA GeForce RTX 4090.","minLength":1,"type":"string"},"image":{"description":"Container image.","minLength":1,"type":"string"},"ports":{"description":"e.g. [\"8888/http\", \"22/tcp\"].","items":{"type":"string"},"type":"array"},"volume_gb":{"description":"Default 0.","maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["gpu_type","image"],"type":"object"},"name":"rent_create_gpu_pod","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"propert