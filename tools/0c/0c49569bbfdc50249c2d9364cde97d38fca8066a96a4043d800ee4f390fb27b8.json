{
 "description": "Search the KiwiClaw marketplace for vetted OpenClaw skills",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Filter by category slug",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 10)",
    "type": "number"
   },
   "query": {
    "description": "Search query",
    "type": "string"
   },
   "sort": {
    "description": "Sort order",
    "enum": [
     "popular",
     "hot"
    ],
    "type": "string"
   },
   "trust_tier": {
    "description": "Filter by trust tier",
    "enum": [
     "verified",
     "community",
     "unreviewed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_skills"
}
