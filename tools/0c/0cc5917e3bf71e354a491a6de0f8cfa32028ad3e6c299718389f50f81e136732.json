{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List sessions (the unit of agent work) in the caller's org, optionally filtered by status or agent, or resolve the standing session behind a key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_id": {
    "description": "Only sessions on this agent.",
    "type": "string"
   },
   "key": {
    "description": "Exactly the session holding this org-unique key.",
    "type": "string"
   },
   "status": {
    "description": "Only sessions with this status.",
    "enum": [
     "queued",
     "running",
     "waiting",
     "completed",
     "failed",
     "canceled"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "skopik_sessions_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "sessions": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "agent_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "created_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "error": {
       "anyOf": [
        {
         "additionalProperties": {},
         "properties": {},
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "Terminal Problem when the session failed."
      },
      "key": {
       "description": "Org-unique handle when the session was opened with one.",
       "type": [
        "string",
        "null"
       ]
      },
      "last_activity_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "parent_session_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "result": {
       "anyOf": [
        {},
        {
         "type": "null"
        }
       ],
       "description": "Accepted structured output, for sessions opened with an output contract."
      },
      "session_id": {
       "type": "string"
      },
      "status": {
       "description": "One of: queued, running, waiting, completed, failed, canceled.",
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "turn_count": {
       "type": [
        "number",
        "null"
       ]
      },
      "usage": {
       "anyOf": [
        {
         "additionalProperties": {},
         "properties": {
          "cost_usd": {
           "type": [
            "number",
            "null"
           ]
          },
          "tokens": {
           "type": [
            "number",
            "null"
           ]
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "waiting_for": {
       "anyOf": [
        {
         "additionalProperties": {},
         "properties": {
          "kind": {
           "type": "string"
          }
         },
         "required": [
          "kind"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "Typed park reason while status is waiting (input, approval, children, operation, remote)."
      }
     },
     "required": [
      "session_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "sessions"
  ],
  "type": "object"
 },
 "title": "List sessions"
}
