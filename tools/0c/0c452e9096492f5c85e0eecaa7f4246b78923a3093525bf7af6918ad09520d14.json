{
 "description": "Generate production sysctl.conf, limits.conf, systemd overrides, and Docker/K8s configs tuned for high-concurrency JMeter load testing (fixing ulimit nofile, BindException port exhaustion, somaxconn backlog, and JVM swappiness).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "concurrency": {
    "description": "Target concurrent connections/threads (default: 10000).",
    "maximum": 500000,
    "minimum": 100,
    "type": "integer"
   },
   "ramGb": {
    "description": "Host machine RAM in GB for TCP buffer sizing (default: 16).",
    "maximum": 512,
    "minimum": 2,
    "type": "integer"
   },
   "role": {
    "description": "Machine role: \"injector\" (JMeter client) or \"target_sut\" (default: \"injector\").",
    "enum": [
     "injector",
     "target_sut"
    ],
    "type": "string"
   },
   "targetDistro": {
    "description": "Linux distro or container target (default: \"ubuntu_debian\").",
    "enum": [
     "ubuntu_debian",
     "rhel_rocky",
     "amazon_linux",
     "docker_k8s"
    ],
    "type": "string"
   },
   "trafficType": {
    "description": "Traffic profile (default: \"http_churn\").",
    "enum": [
     "http_churn",
     "http_keepalive",
     "streaming_ws_grpc"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tune_linux_os",
 "title": "Linux Kernel & OS Tuning for Load Injectors"
}
