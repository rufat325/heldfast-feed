{
 "description": "Search your media catalog. q substring-matches key/folder; tags overlaps (ANY);\nkind narrows by type. All optional + AND-combined, newest first. Read-only.",
 "inputSchema": {
  "properties": {
   "format": {
    "description": "Response format (default json). yaml/md are token-efficient for agents.",
    "enum": [
     "json",
     "yaml",
     "md"
    ],
    "type": "string"
   },
   "kind": {
    "description": "Filter by asset class",
    "enum": [
     "image",
     "video",
     "doc"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Page size 1-500 (default 50)",
    "type": "number"
   },
   "q": {
    "description": "Case-insensitive substring match on key/folder",
    "type": "string"
   },
   "tags": {
    "description": "Assets sharing ANY given tag",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "workspace": {
    "description": "Workspace name",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "catalog_search_assets"
}
