{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search valet operators by service slug plus city slug across all matching states. Use this when an agent has both a service slug and a city slug and wants a cross-state tier-then-name ranked list. Invalid service slugs surface the 9 canonical alternatives.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "city_slug": {
    "description": "Lowercase kebab-case city slug (e.g. 'austin', 'springfield'). May match multiple cities across states.",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max results to return; default 10, capped at 50",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "service_slug": {
    "description": "Required canonical valet service slug. One of 9 values; call valet_list_services for the full set.",
    "enum": [
     "wedding-valet",
     "corporate-event-valet",
     "private-event-valet",
     "funeral-valet",
     "hotel-resort-valet",
     "restaurant-valet",
     "hospital-medical-valet",
     "major-venue-valet",
     "general-valet"
    ],
    "type": "string"
   }
  },
  "required": [
   "service_slug",
   "city_slug"
  ],
  "type": "object"
 },
 "name": "valet_search_by_service_and_city",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_meta": {
    "additionalProperties": false,
    "description": "TOOL-11 ToS and attribution block",
    "properties": {
     "attribution": {
      "type": "string"
     },
     "terms": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "terms",
     "attribution"
    ],
    "type": "object"
   },
   "data_freshness": {
    "additionalProperties": false,
    "description": "TOOL-10 freshness stamp",
    "properties": {
     "indexed_at": {
      "description": "ISO timestamp of the freshest row in the batch",
      "type": "string"
     },
     "source": {
      "description": "Origin tag: typesense:operators or typesense:operators:empty",
      "type": "string"
     }
    },
    "required": [
     "indexed_at",
     "source"
    ],
    "type": "object"
   },
   "operators": {
    "description": "Operators offering service_slug in any city matching city_slug across all states. Empty array means no matches.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description_text": {
       "description": "Plain-text summary; null if not on file",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "description": "Operator business name",
       "type": "string"
      },
      "phone": {
       "description": "Operator phone number, null if not on file",
       "type": [
        "string",
        "null"
       ]
      },
      "primary_city_name": {
       "description": "Display name of operator HQ city",
       "type": "string"
      },
      "primary_city_slug": {
       "description": "Canonical kebab-case HQ city slug",
       "type": "string"
      },
      "primary_state_name": {
       "description": "Display name of operator HQ state",
       "type": "string"
      },
      "primary_state_slug": {
       "description": "Canonical kebab-case HQ state slug; key disambiguation field",
       "type": "string"
      },
      "services": {
       "description": "Canonical service slugs this operator offers",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "slug": {
       "description": "Canonical kebab-case operator slug",
       "type": "string"
      },
      "tier": {
       "description": "Operator tier: 'free', 'paid', or 'custom'",
       "type": "string"
      }
     },
     "required": [
      "name",
      "slug",
      "primary_city_name",
      "primary_state_name",
      "primary_city_slug",
      "primary_state_slug",
      "services",
      "phone",
      "tier",
      "description_text"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "operators",
   "data_freshness",
   "_meta"
  ],
  "type": "object"
 },
 "title": "Search By Service And City"
}
