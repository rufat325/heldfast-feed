{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Local SEO"
 },
 "description": "Local search: the site, the Business Profile and the map. Pick with mode: check = LocalBusiness markup, NAP, locations and the Business Profile (default). Needs url. reviews = Reply drafts for Google reviews, unhappy ones first, for the user's GBP connector after approval. Needs reviews[{rating, author, text, date, replied, review_id}]. demand = Business Profile search terms and geo-grid ranks into new service and location pages.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "business": {
    "description": "Business name to sign with.",
    "maxLength": 120,
    "type": "string"
   },
   "city": {
    "description": "Main city, left out when matching terms to pages.",
    "maxLength": 80,
    "type": "string"
   },
   "contact": {
    "description": "Where unhappy customers can reach you, e.g.",
    "maxLength": 160,
    "type": "string"
   },
   "detail": {
    "description": "brief = short summary.",
    "enum": [
     "full",
     "brief"
    ],
    "type": "string"
   },
   "gbp_profile": {
    "description": "Optional: the Google Business Profile of this location, from the user's GBP connector or typed by the user, to compare with the site.",
    "properties": {
     "city": {
      "maxLength": 2000,
      "type": "string"
     },
     "hours": {
      "description": "Opening hours per day; leave a day out when closed.",
      "items": {
       "properties": {
        "closes": {
         "description": "HH:MM",
         "maxLength": 2000,
         "type": "string"
        },
        "day": {
         "description": "Monday to Sunday.",
         "maxLength": 2000,
         "type": "string"
        },
        "opens": {
         "description": "HH:MM",
         "maxLength": 2000,
         "type": "string"
        }
       },
       "required": [
        "day"
       ],
       "type": "object"
      },
      "maxItems": 14,
      "type": "array"
     },
     "phone": {
      "maxLength": 2000,
      "type": "string"
     },
     "postcode": {
      "maxLength": 2000,
      "type": "string"
     },
     "primary_category": {
      "description": "For example Dentist, Italian restaurant, Plumber.",
      "maxLength": 2000,
      "type": "string"
     },
     "street": {
      "maxLength": 2000,
      "type": "string"
     },
     "title": {
      "maxLength": 2000,
      "type": "string"
     },
     "website": {
      "description": "The website link on the profile.",
      "maxLength": 2000,
      "type": "string"
     }
    },
    "type": "object"
   },
   "grid": {
    "description": "Optional geo-grid rankings.",
    "items": {
     "properties": {
      "area": {
       "description": "Area, neighbourhood or point label.",
       "maxLength": 120,
       "type": "string"
      },
      "keyword": {
       "maxLength": 200,
       "type": "string"
      },
      "rank": {
       "description": "Map rank, 0 or above 20 for not found.",
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "keyword",
      "rank"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "type": "array"
   },
   "memory_key": {
    "description": "site_memory key, records this call.",
    "maxLength": 80,
    "type": "string"
   },
   "mode": {
    "description": "Default check.",
    "enum": [
     "check",
     "reviews",
     "demand"
    ],
    "type": "string"
   },
   "pages": {
    "description": "The site's page URLs, e.g.",
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 2000,
    "type": "array"
   },
   "reviews": {
    "items": {
     "properties": {
      "author": {
       "maxLength": 120,
       "type": "string"
      },
      "date": {
       "maxLength": 2000,
       "type": "string"
      },
      "rating": {
       "maximum": 5,
       "minimum": 1,
       "type": "number"
      },
      "replied": {
       "type": "boolean"
      },
      "review_id": {
       "maxLength": 300,
       "type": "string"
      },
      "text": {
       "maxLength": 4000,
       "type": "string"
      }
     },
     "required": [
      "rating"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "terms": {
    "description": "Search terms from the Business Profile performance report.",
    "items": {
     "properties": {
      "impressions": {
       "minimum": 0,
       "type": "number"
      },
      "keyword": {
       "maxLength": 200,
       "type": "string"
      }
     },
     "required": [
      "keyword"
     ],
     "type": "object"
    },
    "maxItems": 2000,
    "type": "array"
   },
   "url": {
    "description": "The home page, a location page or the locations overview page.",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "local",
 "outputSchema": {
  "type": "object"
 },
 "title": "Local SEO"
}
