{"description":"Create a Docuflex envelope. documents: inline base64 PDFs or staged uploadIds. recipients: name, email, routingOrder (1 = first), optional type (signer default, cc, certified_delivery, in_person_signer...). tabs: type (signature, initial, date_signed, text, checkbox...), page (1-based), x/y/width/height as fractions of the page from the top-left, documentIndex and recipientIndex into this request's arrays. status 'sent' sends now; omit for a draft.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"account_id":{"description":"Docuflex account id. Optional if sent as x-docuflex-account or if the key belongs to exactly one account.","maxLength":64,"type":"string"},"api_key":{"description":"Docuflex API key (dfx_live_...). Optional if sent as the x-docuflex-api-key header.","maxLength":200,"type":"string"},"documents":{"items":{"additionalProperties":false,"properties":{"base64":{"description":"PDF bytes, base64","type":"string"},"name":{"maxLength":200,"type":"string"},"uploadId":{"type":"string"}},"required":["name"],"type":"object"},"maxItems":20,"minItems":1,"type":"array"},"message":{"maxLength":4000,"type":"string"},"metadata":{"additionalProperties":{"type":"string"},"type":"object"},"recipients":{"items":{"additionalProperties":false,"properties":{"clientUserId":{"maxLength":120,"type":"string"},"email":{"format":"email","type":"string"},"name":{"maxLength":120,"type":"string"},"routingOrder":{"minimum":1,"type":"integer"},"type":{"maxLength":30,"type":"string"}},"required":["name","email"],"type":"object"},"maxItems":50,"minItems":1,"type":"array"},"routingType":{"enum":["sequential","parallel"],"type":"string"},"status":{"enum":["draft","sent"],"type":"string"},"subject":{"maxLength":200,"type":"string"},"tabs":{"items":{"additionalProperties":false,"properties":{"documentIndex":{"minimum":0,"type":"integer"},"height":{"maximum":1,"minimum":0,"