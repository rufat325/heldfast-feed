{
 "description": "A hotel's live rooms and rates for the dates: room names, size, occupancy, board (room only / breakfast / all-inclusive), refundability and the total price per option. Pass an option_id to create_booking_link.",
 "inputSchema": {
  "properties": {
   "adults": {
    "default": 2,
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "checkin": {
    "description": "YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "checkout": {
    "description": "YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "children_ages": {
    "items": {
     "maximum": 17,
     "minimum": 1,
     "type": "integer"
    },
    "type": "array"
   },
   "hotel_id": {
    "type": "string"
   },
   "rooms": {
    "default": 1,
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "hotel_id",
   "checkin",
   "checkout"
  ],
  "type": "object"
 },
 "name": "get_hotel"
}
