{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add a date"
 },
 "description": "Adds one candidate date to a draft (a draft_ id from create_event) or a live event (an id from list_events/get_event) \u2014 a bare ISO date, or an object naming a slot on it: a daypart (morning/afternoon/evening) on any event, or an exact start/end time on an autopilot event or draft. A classic (share-link) poll asks about days and dayparts only \u2014 an exact time on one is refused. Needs the write permission; never mails anyone.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "anyOf": [
     {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     {
      "properties": {
       "date": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       },
       "daypart": {
        "anyOf": [
         {
          "enum": [
           "morning",
           "afternoon",
           "evening"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "endTime": {
        "anyOf": [
         {
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "startTime": {
        "anyOf": [
         {
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "date"
      ],
      "type": "object"
     }
    ]
   },
   "event_id": {
    "description": "A draft_ id, or a live event id",
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "date"
  ],
  "type": "object"
 },
 "name": "add_dates",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date_count": {
    "type": "number"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "events:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Add a date"
}
