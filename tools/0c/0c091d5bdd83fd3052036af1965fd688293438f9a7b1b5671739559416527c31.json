{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Capture the current visible viewport of one approved page as a bounded, content-addressed PNG artifact. Screenshot capture requires separate explicit approval and never scrolls, navigates, or evaluates page JavaScript.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "allowed_origins": [
     "https://app.example.test"
    ],
    "approved": true,
    "cdp_endpoint": "http://127.0.0.1:9222",
    "maximum_image_bytes": 4194304,
    "screenshot_approved": true,
    "target_id": "TARGET_ID_FROM_LIST_BROWSER_TARGETS"
   }
  ],
  "properties": {
   "allowed_origins": {
    "description": "Value for allowed origins.",
    "items": {
     "maxLength": 2048,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 32,
    "minItems": 1,
    "type": "array"
   },
   "approved": {
    "const": true,
    "description": "Explicit operator approval to perform this operation.",
    "type": "boolean"
   },
   "cdp_endpoint": {
    "description": "Approved literal loopback Chrome DevTools Protocol endpoint.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "maximum_image_bytes": {
    "default": 4194304,
    "description": "Bounded byte count for maximum image.",
    "maximum": 8388608,
    "minimum": 1,
    "type": "integer"
   },
   "screenshot_approved": {
    "const": true,
    "description": "Explicit operator approval for screenshot.",
    "type": "boolean"
   },
   "target_id": {
    "description": "Exact authorized CDP target identifier.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "cdp_endpoint",
   "allowed_origins",
   "target_id",
   "approved",
   "screenshot_approved"
  ],
  "type": "object"
 },
 "name": "capture_web_screenshot",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
