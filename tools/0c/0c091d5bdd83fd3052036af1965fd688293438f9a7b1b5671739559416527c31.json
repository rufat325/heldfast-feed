        "maximum": 8388608,
        "minimum": 1,
        "type": "integer"
       },
       "data_base64": {
        "maxLength": 11184815,
        "type": "string"
       },
       "media_type": {
        "const": "image/png",
        "type": "string"
       },
       "sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "uri": {
        "pattern": "^rea:\\/\\/web-screenshot\\/sha256\\/[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "uri",
       "sha256",
       "bytes",
       "media_type",
       "data_base64"
      ],
      "type": "object"
     },
     "browser": {
      "additionalProperties": false,
      "properties": {
       "js_version": {
        "type": "string"
       },
       "product": {
        "type": "string"
       },
       "protocol_version": {
        "type": "string"
       },
       "revision": {
        "type": "string"
       },
       "user_agent": {
        "type": "string"
       }
