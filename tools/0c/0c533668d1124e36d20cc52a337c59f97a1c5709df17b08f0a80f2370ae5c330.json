{
 "description": "Search the SkillsIndex directory for AI agent tools (MCP servers, Claude skills, GPT actions, IDE plugins). Returns ranked results with scores.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Filter by category",
    "enum": [
     "databases-storage",
     "browser-automation",
     "code-execution",
     "communication",
     "social-media",
     "marketing-analytics",
     "memory-knowledge",
     "file-systems",
     "finance-fintech",
     "search-data",
     "ai-llm",
     "cloud-platforms",
     "home-automation",
     "security-monitoring",
     "location-maps",
     "media-entertainment",
     "ecommerce",
     "health-biology",
     "legal",
     "other"
    ],
    "type": "string"
   },
   "ecosystem": {
    "description": "Filter by ecosystem",
    "enum": [
     "mcp_server",
     "claude_skill",
     "gpt_action",
     "openclaw_skill",
     "plugin"
    ],
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "Number of results (1-20, default 5)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query \u2014 tool name, keyword, or use case",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_tools"
}
