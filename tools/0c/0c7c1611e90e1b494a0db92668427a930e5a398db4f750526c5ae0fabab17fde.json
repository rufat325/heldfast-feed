{
 "description": "Fetch and audit a web page's on-page SEO without Google credentials",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "url": {
    "description": "Public page URL to audit",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "seo_audit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "canonical": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "h1": {
    "additionalProperties": false,
    "properties": {
     "count": {
      "type": "number"
     },
     "texts": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "count",
     "texts"
    ],
    "type": "object"
   },
   "headingOutline": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "level": {
       "type": "number"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "level",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "httpStatus": {
    "type": "number"
   },
   "images": {
    "additionalProperties": false,
    "properties": {
     "altPercentage": {
      "type": "number"
     },
     "count": {
      "type": "number"
     },
     "withAlt": {
      "type": "number"
     }
    },
    "required": [
     "count",
     "withAlt",
     "altPercentage"
    ],
    "type": "object"
   },
   "issues": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "lang": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "links": {
    "additionalProperties": false,
    "properties": {
     "external": {
      "type": "number"
     },
     "internal": {
      "type": "number"
     }
    },
    "required": [
     "internal",
     "external"
    ],
    "type": "object"
   },
   "metaDescription": {
    "additionalProperties": false,
    "properties": {
     "length": {
      "type": "number"
     },
     "text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "text",
     "length"
    ],
    "type": "object"
   },
   "metaRobots": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "openGraph": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "schemaTypes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "additionalProperties": false,
    "properties": {
     "count": {
      "type": "number"
     },
     "length": {
      "type": "number"
     },
     "text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "text",
     "count",
     "length"
    ],
    "type": "object"
   },
   "twitter": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "url": {
    "type": "string"
   },
   "viewport": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "wordCount": {
    "type": "number"
   }
  },
  "required": [
   "url",
   "title",
   "metaDescription",
   "canonical",
   "metaRobots",
   "h1",
   "headingOutline",
   "openGraph",
   "twitter",
   "schemaTypes",
   "images",
   "links",
   "wordCount",
   "lang",
   "viewport",
   "issues",
   "httpStatus"
  ],
  "type": "object"
 }
}
