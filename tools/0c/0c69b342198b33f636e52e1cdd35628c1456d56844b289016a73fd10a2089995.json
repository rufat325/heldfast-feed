{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add, remove, enable, or disable a Netwatch monitoring entry. Idempotent by host+port: add returns already_exists if an entry with the same host and port already exists.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "add",
     "remove",
     "enable",
     "disable"
    ],
    "type": "string"
   },
   "comment": {
    "description": "Optional comment",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview changes without applying.",
    "type": "boolean"
   },
   "host": {
    "description": "Host to monitor \u2014 idempotency key",
    "type": "string"
   },
   "interval": {
    "description": "Check interval (e.g. '1m'; default '1m')",
    "type": "string"
   },
   "port": {
    "description": "TCP port (optional; ICMP if omitted)",
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "timeout": {
    "description": "Probe timeout (e.g. '500ms')",
    "type": "string"
   }
  },
  "required": [
   "action",
   "host"
  ],
  "type": "object"
 },
 "name": "manage_netwatch_entry",
 "title": "Manage Netwatch Entry"
}
