  "title": "Fare calendar"
 },
 "description": "Shows a Paytm fare calendar: the cheapest flight fare for every date in a range, so the traveller can spot the cheapest days to fly. Supports date-range queries and round trips. Origin and destination are IATA codes (e.g. DEL, BOM, DXB) and dates are ISO (YYYY-MM-DD). It answers cheapest *dates/days* and lists no individual flights; requests to show or find flights are served by search_flights. For a short window, the calendar is designed to appear below the search_flights card (sort_by='cheapest' on a date in that window) for the same route.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "adults": {
    "default": 1,
    "description": "Adult travellers (default 1).",
    "type": "integer"
   },
   "cabin": {
    "default": "economy",
    "description": "economy | premium economy | business | first.",
    "type": "string"
   },
   "children": {
    "default": 0,
    "description": "Child travellers (default 0).",
    "type": "integer"
   },
   "destination": {
    "description": "Destination IATA code, e.g. \"DXB\".",
    "type": "string"
   },
   "end_date": {
    "description": "Last date of the range, YYYY-MM-DD.",
    "type": "string"
   },
   "infants": {
    "default": 0,
    "description": "Infant travellers (default 0).",
    "type": "integer"
   },
   "origin": {
    "description": "Origin IATA code, e.g. \"DEL\".",
    "type": "string"
   },
   "start_date": {
    "description": "First date of the range, YYYY-MM-DD.",
    "type": "string"
   },
   "trip_type": {
    "default": "oneway",
    "description": "\"oneway\" or \"roundtrip\" (roundtrip also returns the return leg).",
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination",
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
