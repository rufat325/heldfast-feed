{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search destinations"
 },
 "description": "Search cities, countries, and school names. Use before search_language_schools to resolve place names to slugs.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "language": {
    "description": "Optional language slug to restrict destinations (e.g. spanish).",
    "type": "string"
   },
   "limit": {
    "default": 8,
    "description": "Maximum results (1\u201320).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "description": "Response language and site context. One of en, nl, da, sv.",
    "enum": [
     "en",
     "nl",
     "da",
     "sv"
    ],
    "examples": [
     "en",
     "nl",
     "da",
     "sv"
    ],
    "type": "string"
   },
   "query": {
    "description": "Destination or school name prefix. Empty returns popular destinations.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_destinations",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "hits": {
    "description": "Destination matches.",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "locale": {
    "enum": [
     "en",
     "nl",
     "da",
     "sv"
    ],
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "schools": {
    "description": "Optional school name fallback hits.",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "const": true
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ]
}
