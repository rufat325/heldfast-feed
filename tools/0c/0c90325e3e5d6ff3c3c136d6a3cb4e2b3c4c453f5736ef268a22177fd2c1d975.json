{
 "_meta": {
  "sato/effects": [
   "read"
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read chain state"
 },
 "description": "Reads one value from an EVM chain: a native balance, an ERC-20 balance or allowance, the latest block number, or the result of a view or pure contract function given its ABI fragment and arguments. Read-only: a function that is not view or pure is refused before any call is made. Amounts come back as base-unit decimal strings.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "abi": {
    "description": "One ABI function fragment for contract_read; stateMutability must be view or pure.",
    "properties": {
     "inputs": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     },
     "outputs": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "stateMutability": {
      "enum": [
       "view",
       "pure"
      ],
      "type": "string"
     },
     "type": {
      "enum": [
       "function"
      ],
      "type": "string"
     }
    },
    "required": [
     "type",
     "name",
     "inputs",
     "outputs",
     "stateMutability"
    ],
    "type": "object"
   },
   "address": {
    "description": "Account for native_balance.",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "args": {
    "description": "Arguments for contract_read; integers as decimal strings.",
    "items": {},
    "type": "array"
   },
   "chain": {
    "description": "Chain name.",
    "enum": [
     "ethereum",
     "sepolia",
     "base",
     "base-sepolia",
     "arbitrum",
     "arbitrum-sepolia",
     "optimism",
     "optimism-sepolia",
     "polygon"
    ],
    "type": "string"
   },
   "contract": {
    "description": "Contract for contract_read.",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "kind": {
    "enum": [
     "native_balance",
     "erc20_balance",
     "erc20_allowance",
     "block_number",
     "contract_read"
    ],
    "type": "string"
   },
   "owner": {
    "description": "Holder for erc20_balance and erc20_allowance.",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "spender": {
    "description": "Spender for erc20_allowance.",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "token": {
    "description": "ERC-20 contract for erc20_balance and erc20_allowance.",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "required": [
   "kind",
   "chain"
  ],
  "type": "object"
 },
 "name": "chain_read",
 "outputSchema": {
  "properties": {
   "as_of": {
    "type": "string"
   },
   "block_number": {
    "description": "Block the read was answered at.",
    "type": "string"
   },
   "chain": {
    "description": "Chain name.",
    "enum": [
     "ethereum",
     "sepolia",
     "base",
     "base-sepolia",
     "arbitrum",
     "arbitrum-sepolia",
     "optimism",
     "optimism-sepolia",
     "polygon"
    ],
    "type": "string"
   },
   "kind": {
    "enum": [
     "native_balance",
     "erc20_balance",
     "erc20_allowance",
     "block_number",
     "contract_read"
    ],
    "type": "string"
   },
   "result": {
    "description": "The value read; integers as decimal strings."
   }
  },
  "required": [
   "kind",
   "chain",
   "block_number",
   "result",
   "as_of"
  ],
  "type": "object"
 },
 "title": "Read chain state"
}
