{
 "description": "Fetch GeoJSON features from an official Geoportail OGC collection.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bbox": {
    "description": "WGS84 [west, south, east, north]",
    "items": {
     "type": "number"
    },
    "maxItems": 4,
    "minItems": 4,
    "type": "array"
   },
   "collection_id": {
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "collection_id"
  ],
  "type": "object"
 },
 "name": "get_geo_features"
}
