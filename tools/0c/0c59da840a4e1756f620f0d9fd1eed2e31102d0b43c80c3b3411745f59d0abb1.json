{
 "description": "Start a discussion as the API key's owner. It is published and visible to all members immediately, and notifies every member who has new-discussion notifications on.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Category label, default \"General\"",
    "type": "string"
   },
   "content": {
    "description": "Plain-text/markdown body. Required unless content_json is given.",
    "maxLength": 20000,
    "type": "string"
   },
   "content_format": {
    "description": "Defaults to 'tiptap_json' with content_json, else 'markdown'",
    "enum": [
     "markdown",
     "tiptap_json"
    ],
    "type": "string"
   },
   "content_json": {
    "description": "Tiptap JSON body (alternative to content)"
   },
   "tags": {
    "description": "Tag list",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "title": {
    "description": "Discussion title",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_discussion"
}
