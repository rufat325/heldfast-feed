 "description": "List feedback items, filtered and paginated. This is the entry point for \"work the queue\".\n\nArgs (all optional): project, status (open|triaged|in_progress|fixed|verified|wontfix), type (ui|backend|usage|ux), severity (p0-p3), source, assignee_agent, limit (default 20), offset (default 0), response_format (markdown|json).\n\nReturns items ordered most-severe first, then newest. Pagination metadata: total, count, offset, has_more, next_offset.\n\nTypical agent flow: loopback_list_feedback(project='X', status='open') \u2192 loopback_claim_feedback \u2192 fix \u2192 loopback_link_change \u2192 loopback_update_status(status='fixed').",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignee_agent": {
    "description": "Filter by claiming agent, e.g. 'claude-code'",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum results to return",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Number of results to skip (pagination)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "project": {
    "description": "Filter by project slug; omit for all projects",
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "description": "'markdown' for human-readable, 'json' for machine-readable",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "route": {
    "description": "Filter by app route where observed, e.g. '/checkout'",
    "type": "string"
   },
   "severity": {
    "description": "Filter by severity",
    "enum": [
     "p0",
     "p1",
     "p2",
     "p3"
    ],
    "type": "string"
   },
   "source": {
    "description": "Filter by source",
    "enum": [
     "manual",
     "widget",
     "stagewise",
     "sentry",
     "posthog",
     "jam",
     "other"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "open",
     "triaged",
     "in_progress",
     "fixed",
     "verified",
     "wontfix"
    ],
    "type": "string"
   },
   "type": {
    "description": "Filter by feedback type",
    "enum": [
     "ui",
     "backend",
     "usage",
     "ux"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
