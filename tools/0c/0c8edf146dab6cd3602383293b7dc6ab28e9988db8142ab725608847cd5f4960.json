{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set draft scorecard anchors"
 },
 "description": "Upsert behavioral anchors for draft items, keyed by item id with levels 1-4 \u2014 deterministic, no AI generation. Requires competencies; anchors keyed to unknown item ids are rejected by id. Optional source_stage {stage: questions_and_directions, version} returns 409 when stale.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "const": "interview_plan.update_anchors",
    "type": "string"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "input": {
    "additionalProperties": false,
    "properties": {
     "anchors": {
      "additionalProperties": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "description": {
          "maxLength": 5000,
          "minLength": 1,
          "type": "string"
         },
         "level": {
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
         }
        },
        "required": [
         "level",
         "description"
        ],
        "type": "object"
       },
       "maxItems": 4,
       "minItems": 1,
       "type": "array"
      },
      "propertyNames": {
       "maxLength": 128,
       "minLength": 1
      },
      "type": "object"
     },
     "source_stage": {
      "additionalProperties": false,
      "properties": {
       "stage": {
        "const": "questions_and_directions",
        "type": "string"
       },
       "version": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "stage"
      ],
      "type": "object"
     }
    },
    "required": [
     "anchors"
    ],
    "type": "object"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "resource": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "pattern": "^ipd_[0-9A-Za-z]{16,64}$",
      "type": "string"
     },
     "type": {
      "const": "interview_plan_draft",
      "type": "string"
     }
    },
    "required": [
     "type",
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "action",
   "resource",
   "input"
  ],
  "type": "object"
 },
 "name": "yardstick_interview_plan_drafts_update_anchors",
 "title": "Set draft scorecard anchors"
}
