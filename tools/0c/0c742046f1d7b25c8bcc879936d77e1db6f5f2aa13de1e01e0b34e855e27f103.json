{
 "annotations": {
  "readOnlyHint": true,
  "title": "List payouts"
 },
 "description": "List payouts \u2014 bundles of an affiliate's payable commissions \u2014 newest first, with amount, currency and state (pending, due, processing, paid). Filter by affiliate or state; expand affiliate or commissions. Rewardful: GET /v1/payouts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "affiliate_id": {
    "description": "Only this affiliate's payouts.",
    "type": "string"
   },
   "expand": {
    "description": "Nested objects to include for each payout.",
    "items": {
     "enum": [
      "affiliate",
      "commissions"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Results per page, 1-100 (default 25).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number, from 1. See pagination.next_page.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "description": "Only payouts in these states.",
    "items": {
     "enum": [
      "pending",
      "due",
      "processing",
      "paid"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "rewardful_list_payouts",
 "title": "List payouts"
}
