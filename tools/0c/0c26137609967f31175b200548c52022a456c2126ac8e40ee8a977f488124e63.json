{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get profit & loss"
 },
 "description": "Compute Profit & Loss (P&L / net income / margin) by combining the Income tab with expense tabs. Examples: 'am I profitable this year', 'P&L for Q1', 'net income last quarter', 'what's my margin', 'P&L this year vs last' (YoY). Supports period comparison \u2014 YoY, MoM, QoQ, same-month-prev-year. Margin renders as multiplier in loss territory ('expenses 5.4\u00d7 revenue') so the user gets a readable signal instead of '-436.9% margin'. Returns: { message, data: { revenue, expenses, netIncome, margin, comparison?, sampleMeta? } }.",
 "inputSchema": {
  "properties": {
   "clientEmail": {
    "description": "Client account email. Accountants may use this only for an accepted ExpenseBot client.",
    "format": "email",
    "type": "string"
   },
   "dateRange": {
    "description": "Time period filter. Use exactly one variant \u2014 pick the shape that matches the user's phrasing.",
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "month": {
        "description": "Month name or 1-12 (e.g., 'March' or '3')",
        "type": "string"
       },
       "type": {
        "const": "month",
        "type": "string"
       },
       "year": {
        "description": "4-digit year (e.g., 2026)",
        "type": "integer"
       }
      },
      "required": [
       "type",
       "month",
       "year"
      ],
      "title": "Specific month",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "quarter": {
        "maximum": 4,
        "minimum": 1,
        "type": "integer"
       },
       "type": {
        "const": "quarter",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "quarter",
       "year"
      ],
      "title": "Quarter of a year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "year",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "year"
      ],
      "title": "Full year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "end": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "start": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "type": {
        "const": "specific",
        "type": "string"
       }
      },
      "required": [
       "type",
       "start",
       "end"
      ],
      "title": "Specific date range",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "relative",
        "type": "string"
       },
       "value": {
        "description": "Relative range phrase, e.g., 'last month', 'YTD', 'this quarter', 'last 7 days'",
        "type": "string"
       }
      },
      "required": [
       "type",
       "value"
      ],
      "title": "Relative natural-language range",
      "type": "object"
     }
    ]
   },
   "query": {
    "description": "Natural language P&L question (e.g., 'P&L for Q1 2025', 'am I profitable')",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_pnl",
 "outputSchema": {
  "additionalProperties": true,
  "description": "Two branches. Async: type='analytics_pending' with jobId \u2014 poll poll_analytics until complete. Inline: message + data with the computed analytics (data may be null when there is no spreadsheet or no data yet). success is present only on the async branch.",
  "properties": {
   "data": {
    "additionalProperties": true,
    "description": "Inline branch: computed analytics, or null when no spreadsheet / no data.",
    "type": [
     "object",
     "null"
    ]
   },
   "estimatedTime": {
    "description": "Async branch only: seconds.",
    "type": "number"
   },
   "jobId": {
    "description": "Async branch only.",
    "type": "string"
   },
   "message": {
    "description": "Human-readable narrative (both branches).",
    "type": "string"
   },
   "pollEndpoint": {
    "description": "Async branch only.",
    "type": "string"
   },
   "pollInterval": {
    "description": "Async branch only: milliseconds.",
    "type": "number"
   },
   "response": {
    "description": "Chat alias of message.",
    "type": "string"
   },
   "success": {
    "description": "Async branch only.",
    "type": "boolean"
   },
   "type": {
    "description": "Async branch only: \"analytics_pending\" \u2014 poll pollEndpoint or call poll_analytics with jobId.",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "expenses.read"
   ],
   "type": "oauth2"
  }
 ]
}
