{
 "description": "Get race-by-race results for a constructor. Available on every plan; timing fields (gap, finish time) are only returned on Developer and above.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "constructorId": {
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "season": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "constructorId"
  ],
  "type": "object"
 },
 "name": "get_constructor_results"
}
