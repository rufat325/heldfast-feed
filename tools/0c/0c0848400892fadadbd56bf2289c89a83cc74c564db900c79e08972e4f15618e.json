{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Waits until the person has picked and published a design, then says what to install. A call returns within about 25 seconds with the design's current state: generating, waiting for the person, published or failed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "generation_id": {
    "description": "The generation_id from create_previews",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "generation_id"
  ],
  "type": "object"
 },
 "name": "wait_for_design",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "editorUrl": {
    "type": "string"
   },
   "generationId": {
    "type": "string"
   },
   "imageUrl": {
    "type": "string"
   },
   "pickerUrl": {
    "type": "string"
   },
   "ready": {
    "type": "number"
   },
   "siteId": {
    "type": "string"
   },
   "state": {
    "enum": [
     "generating",
     "waiting_for_person",
     "published",
     "failed"
    ],
    "type": "string"
   },
   "templateId": {
    "type": "string"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "state",
   "generationId"
  ],
  "type": "object"
 },
 "title": "Wait for the chosen design"
}
