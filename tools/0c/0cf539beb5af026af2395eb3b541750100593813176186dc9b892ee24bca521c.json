{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "mcp:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Most recent verified sales for one card (up to 10): date, grading company + grade, price in USD, marketplace name. Sales span US, Japan-domestic and Chinese marketplaces \u2014 each sale is a real completed transaction, not a listing. Calls record usage and query metadata within POKEKA.",
 "inputSchema": {
  "properties": {
   "card_id": {
    "description": "Card id from search_card / slang_lookup.",
    "type": "string"
   }
  },
  "required": [
   "card_id"
  ],
  "type": "object"
 },
 "name": "recent_sales",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "card_id": {
    "type": "string"
   },
   "fx_as_of": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "sale_count": {
    "type": "number"
   },
   "sales": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "company": {
       "type": "string"
      },
      "finish": {
       "description": "Print finish of the card sold (1st_edition, shadowless, reverse_holo, no_symbol, red_cheeks, yellow_cheeks). Combinations are joined with \"+\" (e.g. 1st_edition+red_cheeks). Absent = no finish recorded for that sale.",
       "type": "string"
      },
      "grade": {
       "type": "string"
      },
      "marketplace": {
       "type": "string"
      },
      "price_cny": {
       "type": "number"
      },
      "price_jpy": {
       "type": "number"
      },
      "price_usd": {
       "type": "number"
      },
      "sale_type": {
       "type": "string"
      },
      "sold_at": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "mcp:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Recent sales"
}
