{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Tasks: Complete Agent Task"
 },
 "description": "Mark a queued task done with a plain-text summary (max 2000 characters) of what you found and what you did. The user sees it in RankParse.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "summary": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "task_id": {
    "pattern": "^tsk_[A-Za-z0-9_-]{16,40}$",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "summary"
  ],
  "type": "object"
 },
 "name": "complete_agent_task"
}
