{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search CI test events (unit tests, integration tests) with query filtering",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "from": {
    "description": "Start time (ISO 8601 or relative). Example: now-24h",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max results (default 50, max 1000)",
    "type": "number"
   },
   "query": {
    "default": "*",
    "description": "CI test search query. Example: @test.service:my-app @test.status:fail",
    "type": "string"
   },
   "sort": {
    "default": "-timestamp",
    "description": "Sort order",
    "enum": [
     "timestamp",
     "-timestamp"
    ],
    "type": "string"
   },
   "to": {
    "description": "End time (ISO 8601 or relative). Example: now",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "search-ci-tests"
}
