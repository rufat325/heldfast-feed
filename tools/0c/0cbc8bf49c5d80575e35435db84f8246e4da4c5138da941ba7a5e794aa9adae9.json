{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compile a bounded list of explicit URLs in parallel. Returns clean markdown for each page within a consolidated budget. Maximum 20 URLs per batch call.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "format": {
    "default": "markdown",
    "description": "Content format for compilation.",
    "enum": [
     "markdown",
     "semantic",
     "markdown+links"
    ],
    "type": "string"
   },
   "max_output_chars_per_page": {
    "default": 15000,
    "description": "Character limit allocated per individual page.",
    "maximum": 50000,
    "minimum": 1000,
    "type": "integer"
   },
   "urls": {
    "description": "List of URLs to compile in parallel (maximum 20 per call).",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "urls"
  ],
  "type": "object"
 },
 "name": "atlas_batch_compile",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "failed": {
    "type": "number"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "character_count": {
       "type": "number"
      },
      "compilation_id": {
       "type": "string"
      },
      "error": {
       "type": "string"
      },
      "markdown": {
       "type": "string"
      },
      "resource_uri": {
       "type": "string"
      },
      "status": {
       "enum": [
        "success",
        "failed"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "successful": {
    "type": "number"
   },
   "total_requested": {
    "type": "number"
   }
  },
  "required": [
   "total_requested",
   "successful",
   "failed",
   "results"
  ],
  "type": "object"
 }
}
