  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "delivered_at": {
    "type": "string"
   },
   "delivery_eta": {
    "type": "string"
   },
   "order_id": {
    "type": "string"
   },
   "tracking": {
    "additionalProperties": false,
    "properties": {
     "carrier": {
      "type": "string"
     },
     "number": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "carrier",
     "number"
    ],
    "type": "object"
   }
  },
  "required": [
   "order_id"
  ],
  "type": "object"
 },
 "name": "shop.merchant.order_ship",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
