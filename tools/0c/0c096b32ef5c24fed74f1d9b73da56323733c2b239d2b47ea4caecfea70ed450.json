    "type": [
     "string",
     "null"
    ]
   },
   "order_id": {
    "type": "string"
   },
   "state": {
    "type": "string"
   },
   "tracking": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "order_id",
   "state"
  ],
  "type": "object"
 },
 "title": "Ship a physical order"
}
