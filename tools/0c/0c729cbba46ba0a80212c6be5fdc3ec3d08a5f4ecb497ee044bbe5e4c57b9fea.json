{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Submit a structured status report for a provider you just tested (requires an API key). Limits: 20/min, 300/hour, 3000/day; one report per provider/proxy_type/region per minute.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "http_status": {
    "maximum": 599,
    "minimum": 100,
    "type": "integer"
   },
   "issue": {
    "description": "Main problem observed. Defaults to \"none\" when operational, else \"other\".",
    "enum": [
     "none",
     "timeouts",
     "connection_errors",
     "auth_errors",
     "blocked",
     "captcha",
     "slow",
     "geo_mismatch",
     "ip_leak",
     "pool_exhausted",
     "dashboard",
     "billing",
     "other"
    ],
    "type": "string"
   },
   "latency_ms": {
    "description": "Median latency.",
    "maximum": 600000,
    "minimum": 0,
    "type": "integer"
   },
   "note": {
    "description": "Short plain-text note. No links or emails.",
    "maxLength": 280,
    "type": "string"
   },
   "observed_at": {
    "description": "ISO timestamp within the last 6 hours; defaults to now.",
    "type": "string"
   },
   "provider": {
    "description": "Provider slug, e.g. \"bright-data\". See list_providers.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "proxy_type": {
    "enum": [
     "residential",
     "mobile",
     "datacenter",
     "isp"
    ],
    "type": "string"
   },
   "region": {
    "description": "ISO 3166-1 alpha-2 country code (e.g. \"US\") or \"global\".",
    "maxLength": 10,
    "type": "string"
   },
   "sample_size": {
    "description": "Number of requests behind this report.",
    "maximum": 10000000,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "operational",
     "degraded",
     "down"
    ],
    "type": "string"
   },
   "success_rate": {
    "description": "Percent of requests that succeeded.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "provider",
   "status"
  ],
  "type": "object"
 },
 "name": "report_status",
 "title": "Report provider status"
}
