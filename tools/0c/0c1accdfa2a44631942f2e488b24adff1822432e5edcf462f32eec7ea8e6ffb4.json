{
 "description": "Rerank candidate documents/passages against a query using a dedicated reranking model. Use after retrieval/search when exact relevance ordering matters.",
 "execution": {
  "taskSupport": "optional"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "documents": {
    "items": {
     "maxLength": 8000,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "query": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "top_n": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "query",
   "documents",
   "top_n"
  ],
  "type": "object"
 },
 "name": "rerank_documents",
 "title": "Rerank Documents"
}
