{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Remove a permission from a file or shared drive, revoking access for that user/group/domain.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fileId": {
    "description": "The ID of the file or shared drive",
    "type": "string"
   },
   "permissionId": {
    "description": "The ID of the permission to delete",
    "type": "string"
   },
   "supportsAllDrives": {
    "default": true,
    "description": "Support shared drives",
    "type": "boolean"
   },
   "useDomainAdminAccess": {
    "default": false,
    "description": "Issue the request as a domain administrator",
    "type": "boolean"
   }
  },
  "required": [
   "fileId",
   "permissionId"
  ],
  "type": "object"
 },
 "name": "permission_delete",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "message"
  ],
  "type": "object"
 },
 "title": "Delete permission"
}
