{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update a local Nuzo memory.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "confidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "confidence_state": {
    "anyOf": [
     {
      "enum": [
       "observed",
       "inferred",
       "user_confirmed",
       "needs_review",
       "deprecated"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "content": {
    "maxLength": 8000,
    "type": "string"
   },
   "expected_revision": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "expires_at": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "id": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "kind": {
    "enum": [
     "preference",
     "project_decision",
     "fact",
     "instruction",
     "note"
    ],
    "type": "string"
   },
   "provenance": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "host": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "kind": {
        "enum": [
         "conversation",
         "file",
         "import",
         "cli",
         "mcp"
        ],
        "type": "string"
       },
       "line": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
       },
       "path": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "reason": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
       },
       "surface": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "thread_id": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "review_after": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "scope": {
    "maxLength": 256,
    "pattern": "^(user|project|agent|team):[A-Za-z0-9._~:/-]+$",
    "type": "string"
   },
   "tags": {
    "items": {
     "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "memory.update"
}
