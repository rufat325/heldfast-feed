{"description":"Search a shop's past quotes by scope words (for example \"water heater 50 gallon garage\"). Matches the job summary and line items, most words matched first, signed quotes first at a tie, then newest. Read only. Prices show only to people who can see prices.","inputSchema":{"properties":{"exclude_job_id":{"format":"uuid","type":"string"},"limit":{"maximum":25,"minimum":1,"type":"integer"},"q":{"maxLength":300,"minLength":2,"type":"string"},"shop_id":{"format":"uuid","type":"string"},"status":{"enum":["draft","sent","signed","declined","superseded","withdrawn"],"type":"string"}},"required":["shop_id","q"],"type":"object"},"name":"quotes_search","outputSchema":{"properties":{"next_actions":{"description":"Useful next steps to offer, in plain words. op names the op to call, when there is one.","items":{"properties":{"op":{"type":["string","null"]},"say":{"type":"string"}},"required":["say","op"],"type":"object"},"type":"array"},"quotes":{"items":{"properties":{"created_at":{"format":"date-time","type":"string"},"customer_name":{"type":["string","null"]},"job_id":{"format":"uuid","type":"string"},"job_summary":{"type":["string","null"]},"lines":{"items":{"properties":{"description":{"type":"string"},"quantity":{"type":"number"},"unit_price_minor":{"description":"Amount in minor units of the currency (cents), or null.","type":["integer","null"]}},"required":["description","quantity","unit_price_minor"],"type":"object"},"type":"array"},"matched":{"items":{"type":"string"},"type":"array"},"quote_id":{"format":"uuid","type":"string"},"status":{"type":"string"},"total_minor":{"description":"Amount in minor units of the currency (cents), or null.","type":["integer","null"]}},"required":["quote_id","job_id","status","created_at","job_summary","customer_name","total_minor","matched","lines"],"type":"object"},"type":"array"},"words":{"items":{"type":"string"},"type":"array"}},"required":["words","quotes","next_actions"],"type":"object"}}
