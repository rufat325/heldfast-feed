{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get the authenticated user's own anime list, with each entry's status, score and progress. Requires a MyAnimeList login.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results (1-100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Offset for pagination.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "sort": {
    "description": "Sort order. list_score/list_updated_at return highest/most-recent first; anime_title returns A-Z.",
    "enum": [
     "list_score",
     "list_updated_at",
     "anime_title",
     "anime_start_date"
    ],
    "type": "string"
   },
   "status": {
    "description": "List status bucket.",
    "enum": [
     "watching",
     "completed",
     "on_hold",
     "dropped",
     "plan_to_watch"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_my_anime_list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "has_next_page": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "list_status": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "mal_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "mal_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "items",
   "has_next_page"
  ],
  "type": "object"
 },
 "title": "Get my anime list"
}
