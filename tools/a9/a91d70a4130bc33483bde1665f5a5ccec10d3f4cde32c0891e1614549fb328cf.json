    "type": "string"
   },
   "season": {
    "description": "Season string as listed by list_leagues: '2026-2027' for winter-calendar leagues, '2026' for summer-calendar leagues (Brazil, Sweden, Norway, Japan\u2026). Omit for the current season. The free tier serves the current and previous season.",
    "type": "string"
   },
   "team": {
    "description": "Team slug, e.g. 'arsenal', 'manchester-city' (from the table's team names, lower-case, spaces as hyphens)",
    "type": "string"
   }
  },
  "required": [
   "league",
   "team"
  ],
  "type": "object"
 },
 "name": "get_team",
