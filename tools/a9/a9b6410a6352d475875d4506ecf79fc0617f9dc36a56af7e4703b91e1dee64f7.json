{
 "description": "GA4 conversion funnel across two or more event/step names.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "range": {
    "description": "time range e.g. 7d, 30d, 24h (default 7d)",
    "type": "string"
   },
   "slug": {
    "description": "site slug (from list_sites)",
    "type": "string"
   },
   "steps": {
    "description": "two or more funnel step names, in order",
    "items": {
     "type": "string"
    },
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "slug",
   "steps"
  ],
  "type": "object"
 },
 "name": "funnel"
}
