{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Diff your CURRENT code against a fresh deterministic generation of a unit \u2014 shows exactly what a designer changed. Pass the same unit params as the get tools, plus `baseline` (the files you currently have for that unit).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baseline": {
    "description": "Your current files for this unit (path + content).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "fileId": {
    "description": "The Shippp file id (from the file's URL, or shippp_list_units).",
    "minLength": 1,
    "type": "string"
   },
   "unit": {
    "enum": [
     "tokens",
     "design-system",
     "project",
     "component"
    ],
    "type": "string"
   },
   "unitId": {
    "description": "Required when unit='component'.",
    "type": "string"
   },
   "unitType": {
    "description": "Required when unit='component'.",
    "enum": [
     "master",
     "screen"
    ],
    "type": "string"
   }
  },
  "required": [
   "fileId",
   "unit",
   "baseline"
  ],
  "type": "object"
 },
 "name": "shippp_diff"
}
