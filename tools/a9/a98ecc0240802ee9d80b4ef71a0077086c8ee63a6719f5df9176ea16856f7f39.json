{
 "description": "Convert an amount between two tokens using live prices (e.g. 0.5 BTC to USDC).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Amount to convert",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "from": {
    "description": "Source token: BTC, ETH, SOL...",
    "maxLength": 12,
    "minLength": 1,
    "type": "string"
   },
   "to": {
    "description": "Target token: USDC, ETH, SOL...",
    "maxLength": 12,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "from",
   "to",
   "amount"
  ],
  "type": "object"
 },
 "name": "convert"
}
