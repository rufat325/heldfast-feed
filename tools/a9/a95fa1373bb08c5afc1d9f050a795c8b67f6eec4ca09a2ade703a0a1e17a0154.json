{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate a direct URL to the Bolot Studio product configurator with pre-selected options. Optionally pre-select size and/or finish ('matte' or 'glossy'). Valid sizes are product-specific: 'the-legacy-print' accepts 'keepsake-3-pack' (three separate 13\u00d79 cm panels with three separate metal desk stands), 'classic' (30\u00d720), or 'statement' (42\u00d730); 'the-cinematic-print' accepts 'intimate' (21\u00d714), 'classic' (30\u00d720), or 'statement' (42\u00d730); 'the-address-sign' uses templates and ignores size/finish.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "description": "ISO 3166-1 alpha-2 or alpha-3 country code for market-visible product availability (e.g. 'DE', 'DEU')",
    "maxLength": 3,
    "type": "string"
   },
   "finish": {
    "description": "Pre-select finish. Not applicable to address sign.",
    "enum": [
     "matte",
     "glossy"
    ],
    "type": "string"
   },
   "locale": {
    "description": "Locale code (en, de, pl, etc.)",
    "maxLength": 500,
    "type": "string"
   },
   "product_handle": {
    "description": "Product to configure",
    "enum": [
     "the-legacy-print",
     "the-cinematic-print",
     "the-address-sign"
    ],
    "type": "string"
   },
   "size": {
    "description": "Pre-select size. Valid set depends on the product: 'the-legacy-print' \u2192 'keepsake-3-pack', 'classic', or 'statement'; 'the-cinematic-print' \u2192 'intimate', 'classic', or 'statement'. The retired single token 'keepsake' is never accepted.",
    "enum": [
     "keepsake-3-pack",
     "classic",
     "statement",
     "intimate"
    ],
    "type": "string"
   }
  },
  "required": [
   "product_handle"
  ],
  "type": "object"
 },
 "name": "start_configuration",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_response_budget": {
    "additionalProperties": false,
    "properties": {
     "dropped": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "limit_bytes": {
      "type": "number"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "dropped",
     "limit_bytes",
     "note"
    ],
    "type": "object"
   },
   "configurator_url": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "instructions": {
    "type": "string"
   },
   "launch_gate": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "locale": {
    "type": "string"
   },
   "market": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "pre_selected": {
    "additionalProperties": false,
    "properties": {
     "finish": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "size": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "size",
     "finish"
    ],
    "type": "object"
   },
   "product": {
    "type": "string"
   },
   "requested_size": {
    "type": "string"
   },
   "valid_sizes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Start Configuration"
}
