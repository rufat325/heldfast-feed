{
 "_legacy": {
  "bucket": "checkout",
  "successor": "https://api.trusteed.xyz/demo-store/mcp/checkout"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Preview a UCP checkout and move it to ready-for-payment. Call after destination and shipping are set, before ucp_complete_checkout. Use ONLY for a checkout created with ucp_create_checkout. Checkout guide: read the MCP resource trusteed://guides/checkout.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "agent_key": {
    "description": "Sandbox credential from `create_sandbox_key`. Use this when your client cannot set an `Authorization: Bearer` header.",
    "type": "string"
   },
   "checkout_id": {
    "description": "UCP checkout session ID (valid UUID)",
    "type": "string"
   },
   "meta": {
    "description": "UCP request metadata. meta['ucp-agent'].profile = URL of the platform profile; it must be an https URL without credentials (at most 2048 characters)."
   },
   "payment_mandate": {
    "anyOf": [
     {
      "additionalProperties": true,
      "properties": {
       "aud": {
        "description": "This store's slug (the one in the URL you are calling) \u2014 not a domain.",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "currency": {
        "description": "Three-letter currency code; must match the cart's currency.",
        "maxLength": 3,
        "minLength": 3,
        "type": "string"
       },
       "exp": {
        "description": "Expiry as an INTEGER of Unix seconds, in the future \u2014 not an ISO 8601 date string.",
        "exclusiveMinimum": 0,
        "type": "integer"
       },
       "mandate_id": {
        "description": "Your identifier for this mandate.",
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
       },
       "max_amount_cents": {
        "description": "Spending limit the buyer gave you, as an integer in minor units (cents).",
        "exclusiveMinimum": 0,
        "type": "integer"
       },
       "sub": {
        "description": "The identity you authenticate as \u2014 it is compared against it. When the credential tool returns a `mandate_subject`, use that value.",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "mandate_id",
       "max_amount_cents",
       "currency",
       "exp",
       "sub",
       "aud"
      ],
      "type": "object"
     },
     {
      "type": "string"
     }
    ],
    "description": "Payment mandate with `mandate_id`, `max_amount_cents` (integer, minor units), `currency` (3 letters, must match the cart's), `exp` (expiry as an INTEGER of Unix seconds \u2014 not an ISO 8601 date string), `sub` (the identity you authenticate as \u2014 it is compared against it) and `aud` (the store slug this mandate is for, e.g. the slug in the URL you are calling \u2014 not a domain). It is a spending cap you declare to limit yourself: it authorises nothing and does not prove the buyer's consent. Use this when your client cannot set an `X-Payment-Mandate` header."
   }
  },
  "required": [
   "checkout_id"
  ],
  "type": "object"
 },
 "name": "ucp_preview_checkout",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "approval_id": {
    "type": "string"
   },
   "approval_status_url": {
    "type": "string"
   },
   "approval_url": {
    "type": "string"
   },
   "checkout_session_id": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "discount_cents": {
    "type": "number"
   },
   "expires_at": {
    "type": "string"
   },
   "expires_in_seconds": {
    "description": "Whole seconds left on this checkout SESSION at response time (0 when already past). It is not a stock reservation and not a price guarantee.",
    "minimum": 0,
    "type": "integer"
   },
   "items": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "line_price": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "quantity",
      "line_price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_step": {
    "enum": [
     "ask_user_payment_method",
     "complete_ucp_checkout"
    ],
    "type": "string"
   },
   "next_step_message": {
    "type": "string"
   },
   "payment_options": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "available": {
       "type": "boolean"
      },
      "charges_without_approval": {
       "const": true,
       "type": "boolean"
      },
      "funding_source": {
       "anyOf": [
        {
         "enum": [
          "platform_test_card",
          "platform_test_wallet",
          "buyer_wallet"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "enum": [
        "demo_card",
        "demo_wallet",
        "own_wallet",
        "merchant_card",
        "paypal",
        "kyapay"
       ],
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "rail": {
       "enum": [
        "stripe",
        "x402",
        "kyapay",
        "paypal"
       ],
       "type": "string"
      },
      "reason_unavailable": {
       "enum": [
        "coming_soon",
        "not_enabled",
        "currency_not_supported",
        "unsupported_on_this_tool"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "label",
      "rail",
      "funding_source",
      "available"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "shipping_authoritative": {
    "type": "boolean"
   },
   "shipping_cents": {
    "type": "number"
   },
   "shipping_source": {
    "enum": [
     "platform",
     "merchant_policy",
     "estimated"
    ],
    "type": "string"
   },
   "shipping_title": {
    "type": "string"
   },
   "status": {
    "enum": [
     "READY_FOR_PAYMENT",
     "PENDING_APPROVAL"
    ],
    "type": "string"
   },
   "store_name": {
    "type": "string"
   },
   "subtotal_cents": {
    "type": "number"
   },
   "tax_cents": {
    "type": "number"
   },
   "tax_status": {
    "enum": [
     "included",
     "not_calculated"
    ],
    "type": "string"
   },
   "total_cents": {
    "type": "number"
   },
   "total_is_final": {
    "type": "boolean"
   },
   "total_note": {
    "type": "string"
   }
  },
  "required": [
   "checkout_session_id",
   "store_name",
   "items",
   "subtotal_cents",
   "shipping_cents",
   "discount_cents",
   "total_cents",
   "currency",
   "tax_cents",
   "tax_status",
   "total_is_final",
   "total_note",
   "status"
  ],
  "type": "object"
 }
}
