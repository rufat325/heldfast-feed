{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 },
 "description": "Add a comment to an existing ticket. You need a real ticket_id from run_query schema=tickets \u2014 do not invent TCK- ids. Pass author as the human speaking; omitting it attributes the comment to the service account. This is a write tool and may require a credential. To resolve the ticket after commenting, call close_ticket.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "author": {
    "description": "Email of the person speaking, e.g. ada@example.com. Omit only if you intend to comment as the service account.",
    "type": "string"
   },
   "body": {
    "description": "The comment text the human wants on the ticket.",
    "type": "string"
   },
   "ticket_id": {
    "description": "Existing ticket id from run_query schema=tickets. Format: TCK-1001. Do not invent an id.",
    "type": "string"
   }
  },
  "required": [
   "ticket_id",
   "body"
  ],
  "type": "object"
 },
 "name": "add_comment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "next": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "ticket": {
    "additionalProperties": false,
    "properties": {
     "attribution": {
      "enum": [
       "customer",
       "service_account"
      ],
      "type": "string"
     },
     "body": {
      "type": "string"
     },
     "comments": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "at": {
         "type": "string"
        },
        "author": {
         "type": "string"
        },
        "body": {
         "type": "string"
        }
       },
       "required": [
        "author",
        "body",
        "at"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "created_at": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "requester_email": {
      "type": "string"
     },
     "resolved_at": {
      "type": "string"
     },
     "status": {
      "enum": [
       "open",
       "pending",
       "solved"
      ],
      "type": "string"
     },
     "subject": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "subject",
     "body",
     "status",
     "requester_email",
     "attribution",
     "comments",
     "created_at"
    ],
    "type": "object"
   }
  },
  "required": [
   "ok",
   "ticket"
  ],
  "type": "object"
 }
}
