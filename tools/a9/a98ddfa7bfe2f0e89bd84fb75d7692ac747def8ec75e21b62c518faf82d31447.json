{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Settlement Quote"
 },
 "description": "Get a binding fee quote for a DPX settlement. Returns core fee (1.50%), FX fee (0.40% cross-currency), live ESG fee (0\u20130.50%), license fee (0.01%), total all-in rate, net amount, oracle status, AI reasoning, and a quoteId valid for 300 seconds. Always call this before settlement.execute.",
 "inputSchema": {
  "properties": {
   "amountUsd": {
    "description": "Settlement amount in USD.",
    "type": "number"
   },
   "counterpartyName": {
    "description": "Counterparty company name \u2014 used for ESG auto-lookup if lei is not provided.",
    "type": "string"
   },
   "esgScore": {
    "description": "Counterparty ESG score 0\u2013100. If omitted and lei or counterpartyName is provided, the ESG Oracle is queried automatically.",
    "type": "number"
   },
   "hasFx": {
    "description": "True if source and destination currencies differ (adds 0.40% FX fee).",
    "type": "boolean"
   },
   "lei": {
    "description": "Counterparty LEI \u2014 triggers automatic ESG lookup if esgScore is not provided.",
    "type": "string"
   },
   "monthlyVolumeUsd": {
    "description": "Monthly volume for discount tier. $1M+ = Institutional (20% off). $10M+ = Sovereign (30% off).",
    "type": "number"
   }
  },
  "required": [
   "amountUsd"
  ],
  "type": "object"
 },
 "name": "settlement.quote",
 "outputSchema": {
  "properties": {
   "amountUsd": {
    "description": "Input settlement amount in USD",
    "type": "number"
   },
   "expiresAt": {
    "description": "ISO 8601 expiry timestamp",
    "type": "string"
   },
   "fees": {
    "properties": {
     "core": {
      "properties": {
       "pct": {
        "type": "number"
       },
       "usd": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "esg": {
      "properties": {
       "pct": {
        "type": "number"
       },
       "usd": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "fx": {
      "properties": {
       "pct": {
        "type": "number"
       },
       "usd": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "license": {
      "properties": {
       "pct": {
        "type": "number"
       },
       "usd": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "total": {
      "properties": {
       "pct": {
        "type": "number"
       },
       "usd": {
        "type": "number"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "netAmountUsd": {
    "description": "Net amount after all fees",
    "type": "number"
   },
   "oracleScore": {
    "description": "Oracle confidence 0\u2013100",
    "type": "number"
   },
   "oracleStatus": {
    "description": "STABLE | CAUTION | UNSTABLE",
    "type": "string"
   },
   "quoteId": {
    "description": "Binding quote ID, valid 300 seconds",
    "type": "string"
   },
   "reasoning": {
    "description": "AI reasoning for fee calculation",
    "type": "string"
   },
   "tier": {
    "description": "Volume tier: Standard | Growth | Institutional | Sovereign",
    "type": "string"
   }
  },
  "type": "object"
 }
}
