     "TENANT_ACCESS_DENIED",
     "STATE_CONFLICT",
     "QUOTE_CHANGED",
     "RATE_LIMITED",
     "OUTPUT_INVALID",
     "UNKNOWN_EFFECT"
    ],
    "type": "string"
   },
   "data": {
    "additionalProperties": {},
