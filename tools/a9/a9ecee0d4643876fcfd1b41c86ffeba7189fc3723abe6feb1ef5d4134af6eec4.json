      "type": "string"
     },
     "artistName": {
      "type": "string"
     },
     "platforms": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     "summary": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "draftId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "failureStage": {
    "maxLength": 120,
