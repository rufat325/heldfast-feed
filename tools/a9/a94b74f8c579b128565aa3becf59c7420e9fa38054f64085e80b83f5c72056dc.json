{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Run policy checks on a bundle"
 },
 "description": "Evaluate the profile's predicates (plus the manifest's own checks) against the bundle. Repo facts are read from the root when one is available and the profile allows it. Verdict `error` means a provider could not run \u2014 never a silent pass.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bundle": {
    "additionalProperties": {},
    "description": "ManifestBundle",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "profile": {
    "description": "Profile name (builtin default|strict|permissive, or <root>/.axiom/profiles/<name>.json)",
    "type": "string"
   },
   "root": {
    "description": "Absolute repository root; must equal or lie inside an allowlisted --root",
    "type": "string"
   }
  },
  "required": [
   "bundle"
  ],
  "type": "object"
 },
 "name": "axiom_check",
 "outputSchema": {
  "$defs": {
   "__schema0": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     },
     {
      "type": "null"
     },
     {
      "items": {
       "$ref": "#/$defs/__schema0"
      },
      "type": "array"
     },
     {
      "additionalProperties": {
       "$ref": "#/$defs/__schema0"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ]
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "apiVersion": {
    "const": "axiom.dev/v2",
    "type": "string"
   },
   "durationMs": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "factsDigest": {
    "description": "sha256:<64 lowercase hex>",
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "facts": {
       "additionalProperties": {
        "$ref": "#/$defs/__schema0"
       },
       "default": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "path": {
       "description": "Relative POSIX path, NFC, no reserved names",
       "maxLength": 1024,
       "minLength": 1,
       "type": "string"
      },
      "predicate": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warn",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "severity",
      "predicate",
      "message",
      "facts"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "kind": {
    "const": "CheckReport",
    "type": "string"
   },
   "manifestDigest": {
    "description": "sha256:<64 lowercase hex>",
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   },
   "preImage": {
    "enum": [
     "verified",
     "drifted",
     "unverified"
    ],
    "type": "string"
   },
   "profile": {
    "type": "string"
   },
   "providers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "ms": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "status": {
       "enum": [
        "ok",
        "skipped",
        "error"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "status",
      "ms"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "verdict": {
    "enum": [
     "pass",
     "fail",
     "error"
    ],
    "type": "string"
   }
  },
  "required": [
   "apiVersion",
   "kind",
   "manifestDigest",
   "profile",
   "verdict",
   "findings",
   "factsDigest",
   "durationMs",
   "providers"
  ],
  "type": "object"
 },
 "title": "Run policy checks on a bundle"
}
