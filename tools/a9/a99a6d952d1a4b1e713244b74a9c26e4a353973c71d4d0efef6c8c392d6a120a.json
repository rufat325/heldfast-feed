    "type": "string"
   },
   "dataFinal": {
    "description": "End date (DD/MM/YYYY)",
    "type": "string"
   },
   "dataInicial": {
    "description": "Start date (DD/MM/YYYY)",
    "type": "string"
   },
   "pagina": {
    "description": "Page number",
    "type": "number"
   },
   "situacao": {
    "description": "Filter by status",
    "enum": [
     "aberto",
     "pago",
     "cancelado",
     "parcial"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_accounts_receivable"
}
