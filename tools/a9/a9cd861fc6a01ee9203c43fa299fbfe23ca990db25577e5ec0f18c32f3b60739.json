{
 "annotations": {
  "readOnlyHint": true,
  "title": "Water log"
 },
 "description": "Water intake log for a date. Fitbit REST: GET /1/user/-/foods/log/water/date/{date}.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date": {
    "description": "Date, yyyy-MM-dd or 'today' (required).",
    "pattern": "^(\\d{4}-\\d{2}-\\d{2}|today)$",
    "type": "string"
   }
  },
  "required": [
   "date"
  ],
  "type": "object"
 },
 "name": "fitbit_water_log",
 "title": "Water log"
}
