{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create employee absences (vacation, illness, trip\u2026). Admin rights required.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gaps": {
    "items": {
     "properties": {
      "from": {
       "description": "Start, ISO 8601 (YYYY-MM-DDThh:mm:ss.sss\u00b1hhmm)",
       "type": "string"
      },
      "fullDay": {
       "type": "boolean"
      },
      "id": {
       "description": "Custom id (\u2264128 chars); auto-generated if omitted",
       "type": "string"
      },
      "to": {
       "description": "End, ISO 8601, must be later than from",
       "type": "string"
      },
      "user": {
       "description": "Login or user id",
       "type": "string"
      },
      "workInAbsence": {
       "description": "Works during the absence",
       "type": "boolean"
      },
      "workflow": {
       "description": "Absence type",
       "enum": [
        "vacation",
        "paid_day_off",
        "illness",
        "absence",
        "trip",
        "conference_trip",
        "conference",
        "learning",
        "maternity",
        "duty"
       ],
       "type": "string"
      }
     },
     "required": [
      "user",
      "workflow",
      "from",
      "to"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "gaps"
  ],
  "type": "object"
 },
 "name": "create_gaps"
}
