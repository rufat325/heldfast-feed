{
 "_meta": {
  "openai/outputTemplate": "ui://xona-dental-gateway/card.html",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://xona-dental-gateway/card.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Text a patient one link to see, move or cancel the appointments they already have at a practice connected to Xona, for a conversation with no booking action_id that still works. If the mobile number, name and date of birth match a patient there, Xona texts them the link; after they tap it and press Show my appointments, list_xona_appointments reads their appointments. The answer is the same whether or not the details match.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "date_of_birth": {
    "format": "date",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "first_name": {
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "last_name": {
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "patient_phone": {
    "description": "The patient's own Canadian or US mobile number, as the practice has it on file",
    "maxLength": 32,
    "minLength": 7,
    "type": "string"
   },
   "practice_slug": {
    "maxLength": 140,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "practice_slug",
   "patient_phone",
   "first_name",
   "last_name",
   "date_of_birth"
  ],
  "type": "object"
 },
 "name": "start_xona_appointment_access",
 "outputSchema": {
  "properties": {
   "action_id": {
    "type": "string"
   },
   "link_expires_at": {
    "format": "date-time",
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "practice": {
    "properties": {
     "name": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "name"
    ],
    "type": "object"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "action_id",
   "practice",
   "status",
   "link_expires_at",
   "next_step"
  ],
  "type": "object"
 },
 "title": "Text the patient a link to show their appointments"
}
