  "readOnlyHint": true
 },
 "description": "Search Rakuten Kobo's eBook catalogue by keyword, title, author, publisher, or genre. Returns eBook details with title, series, author, publisher, price, sale URL, language code, image URL, and review stats. Pass at least one search field.\n\n[JA] \u697d\u5929Kobo\u96fb\u5b50\u66f8\u7c4d\u30ab\u30bf\u30ed\u30b0\u3092\u3001\u30ad\u30fc\u30ef\u30fc\u30c9/\u30bf\u30a4\u30c8\u30eb/\u8457\u8005/\u51fa\u7248\u793e/\u30b8\u30e3\u30f3\u30eb\u3067\u691c\u7d22\u3057\u307e\u3059\u3002\u30bf\u30a4\u30c8\u30eb\u3001\u30b7\u30ea\u30fc\u30ba\u3001\u8457\u8005\u3001\u51fa\u7248\u793e\u3001\u4fa1\u683c\u3001\u8cfc\u5165URL\u3001\u8a00\u8a9e\u3001\u753b\u50cf\u3001\u30ec\u30d3\u30e5\u30fc\u3092\u542b\u3080\u66f8\u7c4d\u8a73\u7d30\u3092\u8fd4\u3057\u307e\u3059\u3002\u691c\u7d22\u6761\u4ef6\u306f1\u3064\u4ee5\u4e0a\u5fc5\u9808\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "author": {
    "description": "Author name. \u8457\u8005\u540d\u3002",
    "title": "Author",
    "type": "string"
   },
   "hits": {
    "default": 10,
    "description": "Results per page. \u53d6\u5f97\u4ef6\u6570\u3002",
    "maximum": 30,
    "minimum": 1,
    "title": "Hits",
    "type": "integer"
   },
   "keyword": {
    "description": "Free-text keyword. \u30ad\u30fc\u30ef\u30fc\u30c9\u3002",
    "title": "Keyword",
    "type": "string"
   },
   "koboGenreId": {
    "description": "Restrict to a Kobo genre ID. Use kobo_genre_search to discover. \u30b8\u30e3\u30f3\u30ebID\u3067\u7d5e\u308a\u8fbc\u307f\u3002",
    "title": "Kobo Genre ID",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number. \u30da\u30fc\u30b8\u756a\u53f7\u3002",
    "maximum": 100,
    "minimum": 1,
    "title": "Page",
    "type": "integer"
   },
   "publisherName": {
    "description": "Publisher name. \u51fa\u7248\u793e\u3002",
    "title": "Publisher Name",
    "type": "string"
   },
   "sort": {
    "default": "standard",
    "description": "Sort order. \u4e26\u3073\u9806\u3002",
    "enum": [
     "standard",
     "sales",
     "+releaseDate",
     "-releaseDate",
     "+itemPrice",
     "-itemPrice",
     "reviewCount",
     "reviewAverage"
    ],
    "title": "Sort",
    "type": "string"
   },
   "title": {
    "description": "Title (partial match). \u30bf\u30a4\u30c8\u30eb(\u90e8\u5206\u4e00\u81f4)\u3002",
    "title": "Title",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "kobo_ebook_search",
 "title": "Search Rakuten Kobo eBooks"
}
