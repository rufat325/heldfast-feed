{
 "description": "Retrieves configuration details for a specific monitor by ID (URL, check interval, notification settings, etc.). Use this when you need to examine or modify settings for a specific monitor. For current status, use getMonitorSummary instead. By default returns only common fields plus runtime data (uptime, avgPing); set includeTypeSpecificFields to true to include type-specific fields (e.g., url for HTTP, hostname/port for TCP).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "includeSecrets": {
    "description": "Return credentials in full instead of \"***\". Off by default: this output is persisted in conversation transcripts and logs. Can also be enabled globally with UPTIME_KUMA_INCLUDE_SECRETS=true.",
    "type": "boolean"
   },
   "includeTypeSpecificFields": {
    "description": "Include type-specific fields (url, hostname, port, etc.) in addition to common fields. Default: false. When false, only returns MonitorBase fields plus uptime/avgPing.",
    "type": "boolean"
   },
   "monitorID": {
    "description": "The ID of the monitor to retrieve",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "monitorID"
  ],
  "type": "object"
 },
 "name": "getMonitor",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "monitor": {
    "additionalProperties": true,
    "description": "Monitor object with common fields plus uptime/avgPing. May include type-specific fields when includeTypeSpecificFields is true. Credentials (pushToken, basic_auth_pass, bearer_token, headers, ...) read \"***\" unless includeSecrets is set.",
    "properties": {
     "accepted_statuscodes": {
      "default": [
       "200-299"
      ],
      "description": "Accepted status codes (must be strings)",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "active": {
      "default": true,
      "description": "Start monitoring immediately",
      "type": "boolean"
     },
     "childrenIDs": {
      "description": "Child monitor IDs (for groups)",
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "conditions": {
      "description": "Monitor conditions",
      "items": {
       "additionalProperties": false,
       "properties": {
        "andOr": {
         "description": "Group logic operator",
         "enum": [
          "and",
          "or"
         ],
         "type": "string"
        },
        "children": {
         "description": "Nested conditions",
         "items": {
          "$ref": "#/properties/monitor/properties/conditions/items"
         },
         "type": "array"
        },
        "operator": {
         "description": "Comparison operator",
         "type": "string"
        },
        "type": {
         "description": "Condition or group",
         "enum": [
          "condition",
          "group"
         ],
         "type": "string"
        },
        "value": {
         "description": "Expected value",
         "type": "string"
        },
        "variable": {
         "description": "Variable to check",
         "type": "string"
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "description": {
      "description": "Monitor description",
      "type": [
       "string",
       "null"
      ]
     },
     "forceInactive": {
      "description": "Force inactive state",
      "type": "boolean"
     },
     "id": {
      "description": "Monitor ID (omit for creation)",
      "type": "number"
     },
     "includeSensitiveData": {
      "description": "Whether sensitive data is included",
      "type": "boolean"
     },
     "interval": {
      "description": "Check interval in seconds (20-2073600)",
      "maximum": 2073600,
      "minimum": 20,
      "type": "number"
     },
     "maintenance": {
      "description": "In maintenance mode",
      "type": "boolean"
     },
     "maxretries": {
      "default": 0,
      "description": "Max retries before marking as down",
      "type": "number"
     },
     "name": {
      "description": "Monitor name",
      "type": "string"
     },
     "notificationIDList": {
      "additionalProperties": {
       "type": "boolean"
      },
      "description": "Notification ID to enabled map",
      "type": "object"
     },
     "parent": {
      "description": "Parent group ID (null for root)",
      "type": [
       "number",
       "null"
      ]
     },
     "path": {
      "description": "Hierarchical path array",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "pathName": {
      "description": "Full hierarchical path",
      "type": "string"
     },
     "resendInterval": {
      "default": 0,
      "description": "Notification resend interval (0 = disabled)",
      "type": "number"
     },
     "retryInterval": {
      "description": "Retry interval in seconds",
      "type": "number"
     },
     "tags": {
      "description": "Associated tags",
      "items": {
       "additionalProperties": false,
       "properties": {
        "color": {
         "description": "Tag color",
         "type": "string"
        },
        "monitor_id": {
         "description": "Monitor ID",
         "type": "number"
        },
        "name": {
         "description": "Tag name",
         "type": "string"
        },
        "tag_id": {
         "description": "Tag ID",
         "type": "number"
        },
        "value": {
         "description": "Tag value",
         "type": "string"
        }
       },
       "required": [
        "name",
        "color"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "timeout": {
      "description": "Request timeout in seconds",
      "type": [
       "number",
       "null"
      ]
     },
     "type": {
      "description": "Monitor type",
      "enum": [
       "http",
       "keyword",
       "json-query",
       "ping",
       "port",
       "dns",
       "docker",
       "mqtt",
       "mongodb",
       "redis",
       "sqlserver",
       "postgres",
       "mysql",
       "grpc-keyword",
       "kafka-producer",
       "radius",
       "rabbitmq",
       "smtp",
       "snmp",
       "real-browser",
       "gamedig",
       "push",
       "group",
       "tailscale-ping",
       "manual"
      ],
      "type": "string"
     },
     "upsideDown": {
      "default": false,
      "description": "Invert status (down = up, up = down)",
      "type": "boolean"
     },
     "user_id": {
      "description": "Owner user ID",
      "type": "number"
     },
     "weight": {
      "description": "Display order weight",
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "name",
     "type",
     "interval",
     "retryInterval"
    ],
    "type": "object"
   }
  },
  "required": [
   "monitor"
  ],
  "type": "object"
 },
 "title": "Get Monitor"
}
