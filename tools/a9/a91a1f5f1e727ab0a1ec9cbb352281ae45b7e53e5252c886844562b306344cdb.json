{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Institutional Signal"
 },
 "description": "Probe institutional and activist investor signals for a company. Returns a live activist_risk_flag (true if any SC 13D or 13D/A was filed in the last 365 days \u2014 an activist investor has disclosed a large stake). Also lists the 13D filings and their SEC URLs. NOTE: Institutional accumulation/distribution signal (institutional_signal) and recent_13f_count are null/0 in v0.1 \u2014 quarterly 13F XBRL parsing ships in v0.2.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "quarters_back": {
    "default": 4,
    "description": "Number of calendar quarters to look back (default 4 \u2248 1 year, max 20).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "ticker_or_cik": {
    "description": "Ticker symbol (e.g. \"NVDA\") or numeric CIK.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ticker_or_cik"
  ],
  "type": "object"
 },
 "name": "get_institutional_signal",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activist_risk_flag": {
    "type": "boolean"
   },
   "cik": {
    "type": "string"
   },
   "company_name": {
    "type": [
     "string",
     "null"
    ]
   },
   "institutional_signal": {
    "anyOf": [
     {
      "enum": [
       "ACCUMULATING",
       "HOLDING",
       "DISTRIBUTING"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "data_delay": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "timestamp": {
      "type": "string"
     }
    },
    "required": [
     "source",
     "timestamp",
     "data_delay"
    ],
    "type": "object"
   },
   "quarters_back": {
    "type": "number"
   },
   "recent_13d_filings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accession_number": {
       "type": "string"
      },
      "filing_date": {
       "type": "string"
      },
      "form": {
       "type": "string"
      },
      "sec_url": {
       "type": "string"
      }
     },
     "required": [
      "accession_number",
      "filing_date",
      "form",
      "sec_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "recent_13f_count": {
    "type": "number"
   },
   "ticker": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "ticker",
   "cik",
   "company_name",
   "quarters_back",
   "institutional_signal",
   "recent_13f_count",
   "activist_risk_flag",
   "recent_13d_filings",
   "meta"
  ],
  "type": "object"
 },
 "title": "Institutional Signal"
}
