{
 "description": "Compress chat message history using token-based trimming strategy. Removes oldest non-system messages when token count exceeds threshold while preserving system messages and recent context.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "maxModelTokens": {
    "default": 8192,
    "description": "Model's maximum token context window",
    "minimum": 1,
    "type": "number"
   },
   "messages": {
    "description": "Array of chat messages to compress",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "role": {
       "enum": [
        "system",
        "user",
        "assistant",
        "tool",
        "human"
       ],
       "type": "string"
      }
     },
     "required": [
      "role",
      "content"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "minRecentMessages": {
    "default": 2,
    "description": "Minimum recent messages to always preserve",
    "minimum": 0,
    "type": "number"
   },
   "thresholdPercent": {
    "default": 0.7,
    "description": "Percentage threshold to trigger compression (0-1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "messages"
  ],
  "type": "object"
 },
 "name": "trim_messages"
}
