{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Count distinct public works, editions and journals using combined filters, including exact baselReferences or baselReferencePrefix. No bibliography or text is returned.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "filters": {
    "additionalProperties": false,
    "properties": {
     "authorIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "baselReferencePrefix": {
      "maxLength": 250,
      "minLength": 1,
      "type": "string"
     },
     "baselReferences": {
      "items": {
       "maxLength": 250,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "downloadFormats": {
      "items": {
       "enum": [
        "epub",
        "pdf",
        "mobi"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "full": {
      "type": "boolean"
     },
     "hasDownload": {
      "type": "boolean"
     },
     "hasExtractedText": {
      "type": "boolean"
     },
     "inOriginalLanguage": {
      "type": "boolean"
     },
     "includeSemantic": {
      "type": "boolean"
     },
     "isIndexed": {
      "type": "boolean"
     },
     "journalIds": {
      "items": {
       "maxLength": 250,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "journalScope": {
      "enum": [
       "original",
       "edition",
       "any"
      ],
      "type": "string"
     },
     "labelIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "originalLanguages": {
      "items": {
       "maxLength": 16,
       "minLength": 2,
       "type": "string"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
     },
     "originalYearFrom": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "originalYearTo": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "publicationIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "publicationLanguages": {
      "items": {
       "maxLength": 16,
       "minLength": 2,
       "type": "string"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
     },
     "publicationTypes": {
      "items": {
       "enum": [
        "Mainwork",
        "Translation",
        "Anthology",
        "Article",
        "Contribution",
        "Preface",
        "Epilogue",
        "Letter",
        "EditedWork",
        "Excerpt"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "publicationYearFrom": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "publicationYearTo": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "publisherIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "reference": {
      "maxLength": 250,
      "minLength": 1,
      "type": "string"
     },
     "title": {
      "maxLength": 250,
      "minLength": 1,
      "type": "string"
     },
     "topicIds": {
      "items": {
       "maxLength": 250,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "translatorIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "workIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "workTypes": {
      "items": {
       "enum": [
        "Mainwork",
        "Translation",
        "Anthology",
        "Article",
        "Contribution",
        "Preface",
        "Epilogue",
        "Letter",
        "EditedWork"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "count_catalog",
 "title": "Count works, editions and journals"
}
