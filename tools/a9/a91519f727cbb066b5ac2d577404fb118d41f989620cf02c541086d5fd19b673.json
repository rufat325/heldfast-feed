{
 "annotations": {
  "readOnlyHint": true,
  "title": "List events"
 },
 "description": "List events, filterable by name, category, date window, published or archived state. Dates are YYYY-MM-DD. Only Neon's legacy events are exposed by the API. Neon: GET /events.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "archived": {
    "description": "Only archived (true) or active (false) events.",
    "type": "boolean"
   },
   "current_page": {
    "description": "0-based page number (Neon pages start at 0). Default 0.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "end_date_after": {
    "description": "Events ending after this date (YYYY-MM-DD).",
    "type": "string"
   },
   "end_date_before": {
    "description": "Events ending before this date (YYYY-MM-DD).",
    "type": "string"
   },
   "event_category": {
    "description": "Event category (a delimited list is allowed).",
    "type": "string"
   },
   "event_name": {
    "description": "Event name.",
    "type": "string"
   },
   "page_size": {
    "description": "Results per page.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "published_event": {
    "description": "Only published (true) or unpublished (false) events.",
    "type": "boolean"
   },
   "start_date_after": {
    "description": "Events starting after this date (YYYY-MM-DD).",
    "type": "string"
   },
   "start_date_before": {
    "description": "Events starting before this date (YYYY-MM-DD).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "neon_list_events",
 "title": "List events"
}
