{
 "description": "Create a new order",
 "inputSchema": {
  "properties": {
   "charges": {
    "description": "Charges for the order",
    "items": {
     "properties": {
      "payment_method": {
       "properties": {
        "expires_at": {
         "description": "Expiration timestamp (for OXXO/SPEI)",
         "type": "number"
        },
        "token_id": {
         "description": "Card token (for card payments)",
         "type": "string"
        },
        "type": {
         "description": "Payment type (card, oxxo_cash, spei)",
         "type": "string"
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "currency": {
    "description": "Currency code (e.g. MXN)",
    "type": "string"
   },
   "customer_info": {
    "description": "Customer information",
    "properties": {
     "email": {
      "description": "Customer email",
      "type": "string"
     },
     "name": {
      "description": "Customer name",
      "type": "string"
     },
     "phone": {
      "description": "Customer phone",
      "type": "string"
     }
    },
    "required": [
     "name",
     "email",
     "phone"
    ],
    "type": "object"
   },
   "line_items": {
    "description": "Order line items",
    "items": {
     "properties": {
      "name": {
       "description": "Item name",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity",
       "type": "number"
      },
      "unit_price": {
       "description": "Unit price in cents",
       "type": "number"
      }
     },
     "required": [
      "name",
      "unit_price",
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "currency",
   "customer_info",
   "line_items"
  ],
  "type": "object"
 },
 "name": "create_order"
}
