{
 "annotations": {
  "destructiveHint": true,
  "title": "Create task"
 },
 "description": "Create a new task. Reclaim schedules it into your calendar automatically. Reclaim REST: POST /api/tasks.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "due": {
    "description": "Due date/time (ISO-8601 Zulu datetime, e.g. 2026-07-20T17:00:00.000Z).",
    "type": "string"
   },
   "eventCategory": {
    "description": "Task category \u2014 WORK or PERSONAL (default WORK).",
    "enum": [
     "WORK",
     "PERSONAL"
    ],
    "type": "string"
   },
   "maxChunkSize": {
    "description": "Maximum contiguous block, in 15-minute chunks.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "minChunkSize": {
    "description": "Minimum contiguous block, in 15-minute chunks.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "notes": {
    "description": "Freeform notes / description for the task.",
    "type": "string"
   },
   "priority": {
    "description": "Task priority \u2014 P1 (highest) \u2026 P4 (lowest).",
    "enum": [
     "P1",
     "P2",
     "P3",
     "P4"
    ],
    "type": "string"
   },
   "snoozeUntil": {
    "description": "Do not schedule before this time (ISO-8601 Zulu datetime).",
    "type": "string"
   },
   "timeChunksRequired": {
    "description": "Total scheduled time as a number of 15-minute chunks, e.g. 4 = 1 hour.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "title": {
    "description": "The task title.",
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "reclaim_create_task",
 "title": "Create task"
}
