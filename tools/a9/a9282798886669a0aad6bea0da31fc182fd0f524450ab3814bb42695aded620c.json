{
 "description": "List known entities (people, projects, organizations, etc.) with optional filtering. Returns entities with their observation counts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entity_type": {
    "enum": [
     "person",
     "project",
     "organization",
     "preference",
     "fact",
     "context",
     "tool",
     "custom"
    ],
    "type": "string"
   },
   "include_forgotten": {
    "description": "Include forgotten entities (default: false)",
    "type": "boolean"
   },
   "limit": {
    "description": "Max results (default: 20)",
    "type": "number"
   },
   "query": {
    "description": "Search entity names and aliases",
    "type": "string"
   },
   "scope": {
    "enum": [
     "agent",
     "user",
     "team"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "memory_entities"
}
