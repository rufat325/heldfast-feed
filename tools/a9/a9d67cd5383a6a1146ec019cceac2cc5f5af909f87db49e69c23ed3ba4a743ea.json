{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Create a coupon. value = 1-100 for percent_off, integer cents for fixed_amount, ignored for free_shipping.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "Auto-uppercased",
    "minLength": 1,
    "type": "string"
   },
   "expiresAt": {
    "description": "ISO timestamp",
    "type": "string"
   },
   "maxUses": {
    "minimum": 1,
    "type": "integer"
   },
   "min_order_cents": {
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "enum": [
     "percent_off",
     "fixed_amount",
     "free_shipping"
    ],
    "type": "string"
   },
   "value": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "code",
   "type",
   "value"
  ],
  "type": "object"
 },
 "name": "create_coupon"
}
