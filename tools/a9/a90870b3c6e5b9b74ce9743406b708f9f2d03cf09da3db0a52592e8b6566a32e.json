{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Put up to 8 puzzles from the library in one PDF, in the order given, with their answer keys at the end. Use the activity and slug of each hit from search_activities. These activities can go in it: color-by-number, coloring-pages, mazes, word-searches, color-by-math, dot-to-dot, seek-and-count, secret-codes, word-scrambles, crosswords, logic-puzzles. A sheet listed twice prints once.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"items":{"description":"The sheets to print, in order.","items":{"properties":{"activity":{"enum":["color-by-number","coloring-pages","mazes","word-searches","color-by-math","dot-to-dot","seek-and-count","secret-codes","word-scrambles","crosswords","logic-puzzles"],"type":"string"},"slug":{"description":"Puzzle slug, for example \"farm-friends\".","maxLength":100,"minLength":1,"type":"string"}},"required":["activity","slug"],"type":"object"},"maxItems":8,"minItems":1,"type":"array"}},"required":["items"],"type":"object"},"name":"print_sheets","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"count":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"items":{"items":{"additionalProperties":false,"properties":{"activity":{"enum":["color-by-number","coloring-pages","mazes","word-searches","color-by-math","dot-to-dot","seek-and-count","secret-codes","word-scrambles","crosswords","logic-puzzles"],"type":"string"},"slug":{"type":"string"},"title":{"type":"string"},"url":{"type":"string"}},"required":["activity","slug","title","url"],"type":"object"},"type":"array"},"pdfUrl":{"type":"string"}},"required":["pdfUrl","count","items"],"type":"object"},"title":"Print several sheets in one PDF"}
