     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "topSharedLimit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
