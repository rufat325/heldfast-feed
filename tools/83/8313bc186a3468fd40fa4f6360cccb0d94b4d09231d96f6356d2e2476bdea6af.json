{
 "description": "Build a hosted Open Graph PNG and return a stable https://ogstamp.com/i/{id}.png URL for og:image. Requires api_key (ogs_\u2026 from https://ogstamp.com/pricing/). One credit per image. Does not return a free hotlink.",
 "inputSchema": {
  "properties": {
   "accent": {
    "description": "Accent bar / badge hex",
    "type": "string"
   },
   "api_key": {
    "description": "ogs_\u2026 key from https://ogstamp.com/pricing/. Required. One credit is spent.",
    "type": "string"
   },
   "badge": {
    "description": "Optional small label",
    "type": "string"
   },
   "bg": {
    "description": "Background hex, e.g. #0b1220",
    "type": "string"
   },
   "fg": {
    "description": "Text hex",
    "type": "string"
   },
   "font": {
    "description": "Typeface for brand fit",
    "enum": [
     "inter",
     "manrope",
     "playfair",
     "space",
     "dm",
     "lora",
     "mono",
     "figtree",
     "bitter"
    ],
    "type": "string"
   },
   "layout": {
    "description": "Card composition",
    "enum": [
     "classic",
     "center",
     "split",
     "minimal",
     "quote",
     "terminal"
    ],
    "type": "string"
   },
   "logo_url": {
    "description": "HTTPS URL of a square logo/PNG",
    "type": "string"
   },
   "site": {
    "description": "Small site/domain label on the card",
    "type": "string"
   },
   "size": {
    "description": "Output dimensions preset",
    "enum": [
     "og",
     "square",
     "linkedin",
     "story",
     "wide"
    ],
    "type": "string"
   },
   "subtitle": {
    "description": "Optional second line",
    "type": "string"
   },
   "theme": {
    "description": "Base theme; override with bg/fg/accent hex",
    "enum": [
     "midnight",
     "paper",
     "forest",
     "coral",
     "slate"
    ],
    "type": "string"
   },
   "title": {
    "description": "Main headline on the card",
    "type": "string"
   }
  },
  "required": [
   "title",
   "api_key"
  ],
  "type": "object"
 },
 "name": "render_og_image"
}
