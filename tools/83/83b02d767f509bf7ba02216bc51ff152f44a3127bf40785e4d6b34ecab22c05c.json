{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "favorites.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Remove a saved listing"
 },
 "description": "Remove a listing from the current user's saved (favorited) listings by its numeric id. Requires the favorites.write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "listingId": {
    "description": "Numeric id of the listing to remove.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "listingId"
  ],
  "type": "object"
 },
 "name": "remove_saved_listing",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "listingId": {
    "type": "number"
   },
   "removed": {
    "type": "boolean"
   }
  },
  "required": [
   "removed",
   "listingId"
  ],
  "type": "object"
 },
 "title": "Remove a saved listing"
}
