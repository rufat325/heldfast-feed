 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "slug": {
    "description": "Permanent slug, 3\u201363 characters, lowercase letters, digits, and hyphens. Example: billing or stripe-hooks.",
    "maxLength": 63,
    "minLength": 3,
    "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "endpoint.create",
