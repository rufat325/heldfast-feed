{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Polish public tenders"
 },
 "description": "Search Polish public procurement notices from BZP (national) and TED (EU): open calls with deadlines or awarded contracts. Filter by industry (it, construction, medicine, or a 2-digit CPV division such as 72), region, buyer city, kind and value. Returns title, buyer, CPV codes, publication date, deadline, estimated or awarded value and a link to the notice.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "city": {
    "description": "Buyer city, e.g. Warszawa.",
    "type": "string"
   },
   "currency": {
    "description": "Currency for value filters and output. Default PLN.",
    "enum": [
     "PLN",
     "EUR",
     "USD"
    ],
    "type": "string"
   },
   "industry": {
    "description": "it, construction, medicine, or a 2-digit CPV division code (e.g. 72, 45, 33).",
    "type": "string"
   },
   "kind": {
    "description": "Contract type.",
    "enum": [
     "supplies",
     "services",
     "works"
    ],
    "type": "string"
   },
   "page": {
    "description": "Result page (20 per page).",
    "maximum": 50,
    "minimum": 0,
    "type": "integer"
   },
   "region": {
    "description": "Voivodeship of the buyer.",
    "enum": [
     "dolno\u015bl\u0105skie",
     "kujawsko-pomorskie",
     "lubelskie",
     "lubuskie",
     "\u0142\u00f3dzkie",
     "ma\u0142opolskie",
     "mazowieckie",
     "opolskie",
     "podkarpackie",
     "podlaskie",
     "pomorskie",
     "\u015bl\u0105skie",
     "\u015bwi\u0119tokrzyskie",
     "warmi\u0144sko-mazurskie",
     "wielkopolskie",
     "zachodniopomorskie"
    ],
    "type": "string"
   },
   "source": {
    "description": "national (BZP) or eu (TED). Default: both.",
    "enum": [
     "national",
     "eu"
    ],
    "type": "string"
   },
   "status": {
    "description": "open (default) or awarded notices.",
    "enum": [
     "open",
     "awarded"
    ],
    "type": "string"
   },
   "value_max": {
    "description": "Maximum estimated/awarded value.",
    "type": "number"
   },
   "value_min": {
    "description": "Minimum estimated/awarded value.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "search_tenders",
 "securitySchemes": [
  {
   "scopes": [
    "read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Search Polish public tenders"
}
