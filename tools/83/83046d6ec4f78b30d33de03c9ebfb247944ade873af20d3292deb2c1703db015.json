{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get place details"
 },
 "description": "Read a China Footnotes place by id (from search_places). Prefer sections:[\"practical\",\"notices\"] plus relevant fields for a practical question; use sections:[\"intro\"] for an overview and request the full entry only when needed. Available content: why go, what to do, opening hours with weekday and seasonal rules, ticket prices, booking channels and whether passports work, last entry, metro and taxi directions, notices in effect, current and upcoming events (temporary festivals, exhibitions and shows), what was searched but not found, traveler tips, and every source with its link. Optional fields/sections select complete facts with sources; Tips default to 3 eligible entries after the shared quality ordering; tipLimit (0\u201350) and tipOffset page through them, with totals, per-topic counts of all eligible tips before pagination, and nextOffset. includeTravelerTips:false excludes community tips. Practical rules are not truncated by tipLimit. Cite the canonical page and field sources normally; extra page action suggestions follow initialize instructions and must match pageFeatures. visitDate adds a conservative stored-rule check in Asia/Shanghai. Each practical field carries its status and actual check date; this is not live confirmation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "fields": {
    "items": {
     "enum": [
      "hours",
      "admission",
      "booking",
      "lastAdmission",
      "foreignVisitors",
      "transport"
     ],
     "type": "string"
    },
    "maxItems": 6,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   },
   "id": {
    "description": "Place id, e.g. \"yuyuan-garden\".",
    "maxLength": 100,
    "type": "string"
   },
   "includeTravelerTips": {
    "default": true,
    "type": "boolean"
   },
   "sections": {
    "items": {
     "enum": [
      "intro",
      "practical",
      "notices",
      "events",
      "tips",
      "gaps",
      "photos"
     ],
     "type": "string"
    },
    "maxItems": 7,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   },
   "tipLimit": {
    "default": 3,
    "maximum": 50,
    "minimum": 0,
    "type": "integer"
   },
   "tipOffset": {
    "default": 0,
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "visitDate": {
    "description": "Date in Asia/Shanghai, YYYY-MM-DD. Stored rules only; not live availability.",
    "maxLength": 10,
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
