{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Entities"
 },
 "description": "List entities in the NaN Mesh trust network. Default: trust_score / evaluation_count / metadata (4.1.1 byte-identical). Constraint-solver mode (any of task_type/stack/min_confidence_*/max_failure_severity/exclude_unresolved_critical, or format='agent'): filters by per-axis confidence thresholds, failure-mode severity, and stack/task match. After browsing, use nanmesh.trust.review (expert) or nanmesh.trust.favor (instant) on entities you've evaluated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Filter by category slug",
    "type": "string"
   },
   "exclude_unresolved_critical": {
    "description": "If true, drop entities with any unresolved critical failure",
    "type": "boolean"
   },
   "format": {
    "description": "Pass 'agent' for the AI-native list (each entity includes confidence_decomposition + failure counts)",
    "enum": [
     "agent"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max results",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "max_failure_severity": {
    "description": "Exclude entities with worse-than-this unresolved failures",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "min_confidence_api_stability": {
    "description": "Minimum api_stability (0..1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "min_confidence_cost_efficiency": {
    "description": "Minimum cost_efficiency (0..1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "min_confidence_documentation_quality": {
    "description": "Minimum documentation_quality (0..1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "min_confidence_integration_success_rate": {
    "description": "Minimum integration_success_rate (0..1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "min_confidence_security_posture": {
    "description": "Minimum security_posture (0..1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset",
    "minimum": 0,
    "type": "integer"
   },
   "sort": {
    "default": "trust_score",
    "description": "Sort field",
    "enum": [
     "trust_score",
     "created_at",
     "evaluation_count",
     "views"
    ],
    "type": "string"
   },
   "stack": {
    "description": "Stack overlap filter (e.g. ['nextjs', 'supabase'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "task_type": {
    "description": "Narrow to a task (e.g. 'subscription_billing', 'oauth')",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "nanmesh.entity.list",
 "title": "List Entities"
}
