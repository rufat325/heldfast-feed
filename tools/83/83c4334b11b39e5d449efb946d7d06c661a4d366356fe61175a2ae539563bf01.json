{
 "description": "Detect newly seen Robinhood Chain tokens with market stats and confluence scores. Use this to hunt early memes/alts.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "maxAgeHours": {
    "maximum": 720,
    "minimum": 0,
    "type": "number"
   },
   "minLiquidity": {
    "minimum": 0,
    "type": "number"
   },
   "sort": {
    "default": "new",
    "enum": [
     "new",
     "volume",
     "confluence"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "talon_detect"
}
