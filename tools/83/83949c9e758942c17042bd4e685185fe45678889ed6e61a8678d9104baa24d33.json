     "capabilities": {
      "resources": {
       "subscribe": true
      },
      "tools": {
       "listChanged": true
      }
     },
     "serverInfo": {
      "name": "orders-mcp",
      "version": "1.3.0"
     },
     "tools": [
      {
       "annotations": {
