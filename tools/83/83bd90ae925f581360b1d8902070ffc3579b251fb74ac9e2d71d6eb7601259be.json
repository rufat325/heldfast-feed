{
 "description": "Create a new shipment",
 "inputSchema": {
  "properties": {
   "destination_city": {
    "description": "Destination city DANE code",
    "type": "string"
   },
   "origin_city": {
    "description": "Origin city DANE code",
    "type": "string"
   },
   "packages": {
    "description": "Packages to ship",
    "items": {
     "properties": {
      "content": {
       "description": "Package content description",
       "type": "string"
      },
      "declared_value": {
       "description": "Declared value in COP",
       "type": "number"
      },
      "height": {
       "description": "Height in cm",
       "type": "number"
      },
      "length": {
       "description": "Length in cm",
       "type": "number"
      },
      "weight": {
       "description": "Weight in kg",
       "type": "number"
      },
      "width": {
       "description": "Width in cm",
       "type": "number"
      }
     },
     "required": [
      "weight"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "payment_type": {
    "description": "Payment type (prepaid, collect, contra_entrega)",
    "type": "string"
   },
   "recipient": {
    "description": "Recipient information",
    "properties": {
     "address": {
      "description": "Recipient address",
      "type": "string"
     },
     "name": {
      "description": "Recipient name",
      "type": "string"
     },
     "nit": {
      "description": "Recipient NIT/CC",
      "type": "string"
     },
     "phone": {
      "description": "Recipient phone",
      "type": "string"
     }
    },
    "required": [
     "name",
     "phone",
     "address"
    ],
    "type": "object"
   },
   "sender": {
    "description": "Sender information",
    "properties": {
     "address": {
      "description": "Sender address",
      "type": "string"
     },
     "name": {
      "description": "Sender name",
      "type": "string"
     },
     "nit": {
      "description": "Sender NIT/CC",
      "type": "string"
     },
     "phone": {
      "description": "Sender phone",
      "type": "string"
     }
    },
    "required": [
     "name",
     "phone",
     "address"
    ],
    "type": "object"
   },
   "service_type": {
    "description": "Service type (standard, express, same_day)",
    "type": "string"
   }
  },
  "required": [
   "origin_city",
   "destination_city",
   "sender",
   "recipient",
   "packages"
  ],
  "type": "object"
 },
 "name": "create_shipment"
}
