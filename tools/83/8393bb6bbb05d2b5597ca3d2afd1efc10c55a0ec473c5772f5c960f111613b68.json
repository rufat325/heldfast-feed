{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get one Performix book profile"
 },
 "description": "Get the full grounded profile for one book/cluster record by slug (from list_books): the record's own argument (contrast-not-summary) plus metadata and cross-links. Same content rendered publicly at performix.app/learn/books/<slug>.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "slug": {
    "description": "Book slug, e.g. aguinis-performance-management.",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_book",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "book": {
    "additionalProperties": false,
    "properties": {
     "authors": {
      "type": "string"
     },
     "blurb": {
      "type": "string"
     },
     "body": {
      "type": "string"
     },
     "canonicalLibraryId": {
      "type": [
       "string",
       "null"
      ]
     },
     "canonicalUrl": {
      "type": "string"
     },
     "guidePartSlugs": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "slug": {
      "type": "string"
     },
     "stance": {
      "type": "string"
     },
     "stanceLabel": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "tradition": {
      "type": "string"
     },
     "useCaseSlugs": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "year": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "title",
     "authors",
     "year",
     "tradition",
     "stanceLabel",
     "stance",
     "blurb",
     "guidePartSlugs",
     "useCaseSlugs",
     "canonicalLibraryId",
     "body",
     "canonicalUrl"
    ],
    "type": "object"
   }
  },
  "required": [
   "book"
  ],
  "type": "object"
 },
 "title": "Get one Performix book profile"
}
