{
 "description": "projection of a committed Sh\u014dgen-verified witness (Binance BTCUSDT, self-notarized); the verifier is NOT executed at call time.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "attest",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "label": {
    "description": "Honesty label carried OUTSIDE the frozen price (K-1): the witness is demonstrative, not probative.",
    "type": "string"
   },
   "price": {
    "additionalProperties": false,
    "properties": {
     "attestor": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "identity": {
         "minLength": 1,
         "pattern": "^[ -~]+$",
         "type": "string"
        },
        "key": {
         "pattern": "^([0-9a-f]{2})+$",
         "type": "string"
        }
       },
       "required": [
        "identity",
        "key"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
     },
     "observed_at": {
      "additionalProperties": false,
      "properties": {
       "clock": {
        "minLength": 1,
        "pattern": "^[ -~]+$",
        "type": "string"
       },
       "instant": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "clock",
       "instant"
      ],
      "type": "object"
     },
     "octets_recalcules": {
      "type": "boolean"
     },
     "residual": {
      "items": {
       "minLength": 1,
       "pattern": "^[ -~]+$",
       "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
     },
     "schema_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
     },
     "sens_emis_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "subject": {
      "minLength": 1,
      "pattern": "^[ -~]+$",
      "type": "string"
     },
     "transport": {
      "minLength": 1,
      "pattern": "^[ -~]+$",
      "type": "string"
     },
     "utterance": {
      "additionalProperties": false,
      "properties": {
       "bytes": {
        "pattern": "^([0-9a-f]{2})*$",
        "type": "string"
       },
       "hash": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
       }
      },
      "required": [
       "hash"
      ],
      "type": "object"
     },
     "verifier_revision": {
      "minLength": 1,
      "pattern": "^[ -~]+$",
      "type": "string"
     }
    },
    "required": [
     "schema_version",
     "subject",
     "attestor",
     "residual",
     "transport",
     "utterance",
     "observed_at",
     "octets_recalcules",
     "verifier_revision"
    ],
    "type": "object"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "shogen_head_sha": {
      "description": "Source revision the fixtures were extracted from (pinned).",
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
     },
     "source_lot_sha256": {
      "description": "sha256 of the committed witness lot (CBOR), recomputed from the bytes.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "source_verdict_sha256": {
      "description": "sha256 of the committed verifier output (UTF-8), recomputed from the bytes.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     }
    },
    "required": [
     "source_lot_sha256",
     "source_verdict_sha256",
     "shogen_head_sha"
    ],
    "type": "object"
   }
  },
  "required": [
   "price",
   "provenance",
   "label"
  ],
  "type": "object"
 }
}
