{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "FINAL SENTINEL PILOT-REQUEST STEP. Use only AFTER portfolio-sentinel-v1 has been matched/reviewed and the human explicitly asks Evercraft to review a pilot. Records contact details plus rough portfolio scope as a private onboarding request. Do not use for browsing, matching, pricing inspection, or silent lead capture. It does not connect repositories, start monitoring, create checkout, create a payment obligation, mutate production, or send external communications.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "current_pain": {
    "maxLength": 2400,
    "type": "string"
   },
   "email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "human_confirmed": {
    "const": true,
    "type": "boolean"
   },
   "idempotency_key": {
    "maxLength": 240,
    "minLength": 8,
    "type": "string"
   },
   "machine_discovery_surface_count": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "organization": {
    "maxLength": 240,
    "type": "string"
   },
   "public_endpoint_count": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "repository_count": {
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "scope_notes": {
    "maxLength": 3000,
    "type": "string"
   },
   "source": {
    "default": "evercraft-machine-commerce-mcp",
    "maxLength": 160,
    "type": "string"
   },
   "website": {
    "maxLength": 800,
    "type": "string"
   },
   "workflow_count": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "idempotency_key",
   "name",
   "email",
   "human_confirmed"
  ],
  "type": "object"
 },
 "name": "submit_portfolio_sentinel_pilot_request",
 "title": "Submit a Systemia Portfolio Sentinel commercial-pilot request"
}
