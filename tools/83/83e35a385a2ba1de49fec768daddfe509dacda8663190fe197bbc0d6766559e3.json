{"description":"Gate exactly one unsigned Orca Whirlpool swap on Solana mainnet: the reviewed USDC/USDT 0.01% pool (both directions). The caller supplies the fully resolved compiled unsigned transaction containing exactly one legacy Whirlpool swap instruction (no swapV2, no aggregators, no bundles). Insight canonical-decodes the instruction, re-verifies the pool, vaults, tick array, oracle, and both user token accounts from live mainnet state, prices the pool from its own sqrtPrice against independent oracle consensus, requires a positive otherAmountThreshold consistent with the declared decision prices, and simulates the exact unsigned message. ALLOW returns a short-lived signed decision bound to the exact message hash; CAUTION or BLOCK returns no executable payload. After settlement, pair the signed decision with the transaction signature via settle_solana_swap_guard. It does not sign, submit, relay, or authorize anything.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"guard":{"additionalProperties":false,"properties":{"destinationDecisionPriceUsd":{"exclusiveMinimum":0,"maximum":1000000000,"type":"number"},"direction":{"enum":["usdc-to-usdt","usdt-to-usdc","usdc-to-sol","sol-to-usdc"],"type":"string"},"policy":{"additionalProperties":false,"properties":{"maxReferenceDeviationBps":{"maximum":1000,"minimum":0,"type":"integer"},"maxSlippageBps":{"maximum":1000,"minimum":0,"type":"integer"}},"required":["maxSlippageBps","maxReferenceDeviationBps"],"type":"object"},"profileId":{"enum":["solana-orca-whirlpool-usdc-usdt-1","solana-orca-whirlpool-sol-usdc-1"],"type":"string"},"sourceDecisionPriceUsd":{"exclusiveMinimum":0,"maximum":1000000000,"type":"number"}},"required":["profileId","direction","sourceDecisionPriceUsd","destinationDecisionPriceUsd","policy"],"type":"object"},"transaction":{"additionalProperties":false,"properties":{"accountKeys":{"items":{"type":"string"},"maxItems":256,"minItems":1,"