{
 "description": "Settle up to 50 DFS entries with @buzzr/dfs-engine batch settlement. Returns full explainable settlement results, isolated serializable failures, summary counts, and per-call stat-cache metrics.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "concurrency": {
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "baseMultiplier": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "maximum": 1000000000,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "bookId": {
       "description": "DFS book id, e.g. \"prizepicks\" or \"underdog\". See list_book_policies.",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "displayedMultiplier": {
       "description": "The payout multiplier the book displayed at entry time.",
       "exclusiveMinimum": 0,
       "maximum": 1000000000,
       "type": "number"
      },
      "entryId": {
       "description": "Stable id for the entry being graded.",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "legs": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "actual": {
          "anyOf": [
           {
            "maximum": 1000000000,
            "minimum": -1000000000,
            "type": "number"
           },
           {
            "type": "null"
           }
          ],
          "description": "Observed stat value, when already known. Omit to leave the leg pending."
         },
         "direction": {
          "description": "Which side of the line was picked.",
          "enum": [
           "over",
           "under"
          ],
          "type": "string"
         },
         "gameDate": {
          "anyOf": [
           {
            "anyOf": [
             {
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
              "type": "string"
             },
             {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
              "type": "string"
             }
            ]
           },
           {
            "type": "null"
           }
          ],
          "description": "ISO date or timestamp for the game, e.g. \"2026-07-06\"."
         },
         "gameId": {
          "anyOf": [
           {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "league": {
          "description": "League code, e.g. \"NBA\", \"NFL\", \"MLB\".",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
         },
         "legId": {
          "description": "Stable id for this leg, unique within the entry.",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
         },
         "line": {
          "description": "The prop line, e.g. 25.5.",
          "maximum": 1000000000,
          "minimum": -1000000000,
          "type": "number"
         },
         "opponent": {
          "anyOf": [
           {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "playerId": {
          "anyOf": [
           {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "Optional provider player id."
         },
         "playerName": {
          "description": "Player display name, e.g. \"LeBron James\".",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
         },
         "propType": {
          "description": "Prop market, e.g. \"points\", \"rebounds\", \"pass_yards\".",
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
         },
         "status": {
          "anyOf": [
           {
            "enum": [
             "pending",
             "won",
             "lost",
             "push",
             "dnp",
             "void",
             "rescued",
             "canceled",
             "manual"
            ],
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "Pre-graded leg status (e.g. \"dnp\" or \"void\") when the book already ruled it."
         },
         "team": {
          "anyOf": [
           {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "legId",
         "playerName",
         "league",
         "propType",
         "line",
         "direction"
        ],
        "type": "object"
       },
       "maxItems": 12,
       "minItems": 1,
       "type": "array"
      },
      "placedAt": {
       "anyOf": [
        {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "ISO timestamp the entry was placed."
      },
      "playTypeId": {
       "description": "Play type id for the book, e.g. \"power\", \"flex\", \"underdog_standard\".",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "profitBoostPct": {
       "anyOf": [
        {
         "maximum": 1000000000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "stake": {
       "description": "Entry stake in currency units.",
       "exclusiveMinimum": 0,
       "maximum": 1000000000,
       "type": "number"
      }
     },
     "required": [
      "entryId",
      "bookId",
      "playTypeId",
      "stake",
      "displayedMultiplier",
      "legs"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 },
 "name": "grade_dfs_entries",
 "title": "Grade DFS entries"
}
