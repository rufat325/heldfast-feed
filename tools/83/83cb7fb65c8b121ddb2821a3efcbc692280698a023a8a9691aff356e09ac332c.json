{
 "description": "Parses value as a UUID and reports its version/variant if well-formed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "value": {
    "description": "digits-only identifier to validate (no spaces or dashes)",
    "type": "string"
   }
  },
  "required": [
   "value"
  ],
  "type": "object"
 },
 "name": "uuid_validate",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "valid": {
    "type": "boolean"
   },
   "value": {
    "type": "string"
   },
   "variant": {
    "type": "string"
   },
   "version": {
    "type": "integer"
   }
  },
  "required": [
   "value",
   "valid"
  ],
  "type": "object"
 }
}
