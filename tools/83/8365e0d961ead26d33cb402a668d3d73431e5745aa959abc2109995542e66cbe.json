{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Every bill each University Senate standing committee has reviewed, grouped by committee and academic year back to 2001, as the Past Committees page lists them: document number, title, whether the bill is still active and when it completed. Optionally one committee. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "committee": {
    "description": "Only this committee, named as senate_list_committees gives it, e.g. \"Academic Procedures & Standards\" (default: every committee)",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "senate_list_past_committee_legislation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "committees": {
    "description": "Committees in the order the site lists them",
    "items": {
     "additionalProperties": false,
     "properties": {
      "committee": {
       "description": "Committee as the Past Committees page names it, e.g. \"Academic Procedures & Standards (APAS) Committee\"",
       "type": "string"
      },
      "years": {
       "description": "Oldest academic year first",
       "items": {
        "additionalProperties": false,
        "properties": {
         "academic_year": {
          "description": "Academic year the committee handled the bills, e.g. \"2009-2010\"",
          "type": "string"
         },
         "bills": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "completed": {
             "anyOf": [
              {
               "description": "Date as YYYY-MM-DD",
               "format": "date",
               "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
               "type": "string"
              },
              {
               "type": "null"
              }
             ],
             "description": "When the process finished"
            },
            "document_number": {
             "description": "Senate document number, e.g. \"26-27-04\": the academic year and a sequence number",
             "type": "string"
            },
            "id": {
             "description": "Bill id, for senate_get_bill",
             "maximum": 9007199254740991,
             "minimum": -9007199254740991,
             "type": "integer"
            },
            "is_active": {
             "description": "Whether the bill is still moving through the process",
             "type": "boolean"
            },
            "is_complete": {
             "description": "Whether the process has finished",
             "type": "boolean"
            },
            "title": {
             "description": "Bill title",
             "type": "string"
            },
            "url": {
             "description": "Bill page on senate.umd.edu",
             "type": "string"
            }
           },
           "required": [
            "id",
            "document_number",
            "title",
            "is_active",
            "is_complete",
            "completed",
            "url"
           ],
           "type": "object"
          },
          "type": "array"
         }
        },
        "required": [
         "academic_year",
         "bills"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "committee",
      "years"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "committees"
  ],
  "type": "object"
 },
 "title": "List past committee legislation"
}
