       "POST",
       "DELETE",
       "OPTIONS",
       "HEAD",
       "PATCH",
       "TRACE"
      ],
      "type": "string"
     },
     "path": {
      "description": "The concrete request path, such as /orders/o-1. It is matched against the document path templates.",
      "maxLength": 2048,
      "type": "string"
     },
     "query": {
      "description": "Query parameters as sent. Values arrive as text and are checked against the declared type in their text form.",
      "type": "object"
     }
    },
    "required": [
     "method",
     "path"
    ],
    "type": "object"
   },
   "specification": {
    "description": "An OpenAPI 3.x document as JSON. YAML is not accepted: a YAML reader is a parser dependency and a parser is an attack surface, so convert locally first. $ref resolves inside the document only and a remote reference is reported unresolved, never fetched. Swagger 2 documents are read only as far as they share OpenAPI 3 structure, and the difference is reported.",
    "example": {
     "components": {
      "schemas": {
       "Order": {
        "properties": {
         "id": {
          "type": "string"
         },
         "status": {
          "enum": [
           "open",
           "shipped",
           "disputed"
          ],
          "type": "string"
         },
         "tenant_id": {
          "type": "string"
         },
         "total": {
          "type": "number"
         }
        },
        "required": [
         "id",
         "total",
         "tenant_id"
        ],
        "type": "object"
       }
      },
      "securitySchemes": {
       "apiKey": {
        "in": "query",
        "name": "api_key",
        "type": "apiKey"
       }
      }
     },
     "info": {
      "title": "Orders API",
      "version": "2.0.0"
     },
     "openapi": "3.1.0",
     "paths": {
      "/orders": {
       "get": {
        "operationId": "listOrdersV2",
        "parameters": [
         {
          "in": "query",
          "name": "tenant",
          "required": true,
          "schema": {
           "type": "string"
          }
         }
        ],
        "responses": {
         "200": {
          "content": {
           "application/json": {
            "schema": {
             "items": {
              "$ref": "#/components/schemas/Order"
             },
             "type": "array"
            }
           }
          },
          "description": "A page of orders"
         }
        },
        "summary": "List orders"
       },
       "parameters": [
        {
         "in": "query",
         "name": "page",
         "schema": {
          "minimum": 1,
          "type": "integer"
         }
        }
       ],
       "post": {
        "operationId": "createOrder",
        "requestBody": {
         "content": {
          "application/json": {
           "schema": {
            "$ref": "#/components/schemas/Order"
           }
          }
         },
         "required": true
        },
        "responses": {
         "201": {
          "content": {
           "application/json": {
            "schema": {
             "$ref": "#/components/schemas/Order"
            }
           }
          },
          "description": "Created"
         }
        },
        "summary": "Create an order"
       }
      },
      "/orders/{id}": {
       "get": {
        "deprecated": true,
        "operationId": "getOrder",
        "parameters": [
         {
          "in": "path",
          "name": "id",
          "schema": {
           "type": "string"
          }
         }
        ],
        "responses": {
         "200": {
          "content": {
           "application/json": {
            "schema": {
             "$ref": "#/components/schemas/Order"
            }
           }
          },
          "description": "The order"
         },
         "404": {
          "description": "Not found"
         }
        },
        "summary": "Fetch one order"
       }
      }
     },
     "security": [
      {
       "apiKey": []
      }
     ]
    },
    "type": "object"
   }
