 "description": "\u041e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u0443 \u0446\u0438\u0444\u0440\u0443 \u0437 \u0431\u0430\u0437\u0438 \u0434\u0430\u043d\u0438\u0445 \u0442\u0430 \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438 \u044e\u0437\u0435\u0440\u0443 \u0432 \u0447\u0430\u0442. metric_type: count (\u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0437\u0430\u043f\u0438\u0441\u0456\u0432), sum (\u0441\u0443\u043c\u0430 \u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0433\u043e \u043f\u043e\u043b\u044f), average (\u0441\u0435\u0440\u0435\u0434\u043d\u0454), new_today (\u043d\u043e\u0432\u0456 \u0437\u0430\u043f\u0438\u0441\u0438 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456), updated_today (\u043e\u043d\u043e\u0432\u043b\u0435\u043d\u0456 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456), growth (\u043f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f \u043f\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0456 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e period, \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0454 date_field \u0456 compare_period). entity_id \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 ID \u0444\u043e\u0440\u043c\u0438 \u0430\u0431\u043e ID \u0437\u0432\u0456\u0442\u0443 (\u0437 \u0444\u0456\u043b\u044c\u0442\u0440\u043e\u043c).",
 "inputSchema": {
  "properties": {
   "app_id": {
    "description": "Project ID (from list_projects)",
    "type": "string"
   },
   "compare_period": {
    "description": "\u0414\u043b\u044f metric_type=growth: today_vs_yesterday | this_week_vs_last | this_month_vs_last | this_quarter_vs_last | this_year_vs_last",
    "type": "string"
   },
   "date_field": {
    "description": "\u041d\u0430\u0437\u0432\u0430 \u0430\u0431\u043e ID \u043f\u043e\u043b\u044f \u0434\u0430\u0442\u0438 (\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e \u0434\u043b\u044f growth). \u041c\u043e\u0436\u043d\u0430 \u043f\u0435\u0440\u0435\u0434\u0430\u0442\u0438 'created_at' \u0430\u0431\u043e 'updated_at' \u0434\u043b\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0438\u0445 \u043f\u043e\u043b\u0456\u0432.",
    "type": "string"
   },
   "entity_id": {
    "description": "ID \u0444\u043e\u0440\u043c\u0438 \u0430\u0431\u043e ID \u0437\u0432\u0456\u0442\u0443 (report) \u2014 \u044f\u043a\u0449\u043e \u0437\u0432\u0456\u0442, \u043c\u0435\u0442\u0440\u0438\u043a\u0430 \u0440\u0430\u0445\u0443\u0454\u0442\u044c\u0441\u044f \u0442\u0456\u043b\u044c\u043a\u0438 \u043f\u043e \u0432\u0456\u0434\u0444\u0456\u043b\u044c\u0442\u0440\u043e\u0432\u0430\u043d\u0438\u0445 \u0437\u0430\u043f\u0438\u0441\u0430\u0445",
    "type": "string"
   },
   "metric_type": {
    "description": "count | sum | average | new_today | updated_today | growth",
    "type": "string"
   },
   "value_field": {
    "description": "\u041d\u0430\u0437\u0432\u0430 \u0430\u0431\u043e ID \u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0433\u043e \u043f\u043e\u043b\u044f (\u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e \u0434\u043b\u044f sum \u0456 average)",
    "type": "string"
   }
  },
  "required": [
   "app_id",
   "entity_id",
   "metric_type"
  ],
  "type": "object"
 },
 "name": "get_metric",
 "securitySchemes": [
