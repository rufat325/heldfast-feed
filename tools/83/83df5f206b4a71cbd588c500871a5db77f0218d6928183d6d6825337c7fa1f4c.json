{
 "description": "All-in-one: open URL, wait for specified duration, stop recording, convert to GIF. Best for simple demos.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "durationSeconds": {
    "default": 5,
    "description": "How long to record (default 5 seconds)",
    "type": "number"
   },
   "gifFps": {
    "default": 10,
    "description": "GIF frame rate",
    "type": "number"
   },
   "gifWidth": {
    "default": 640,
    "description": "GIF width (height auto-scaled)",
    "type": "number"
   },
   "height": {
    "default": 720,
    "description": "Viewport height",
    "type": "number"
   },
   "url": {
    "description": "URL to record",
    "type": "string"
   },
   "width": {
    "default": 1280,
    "description": "Viewport width",
    "type": "number"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "record_and_gif"
}
