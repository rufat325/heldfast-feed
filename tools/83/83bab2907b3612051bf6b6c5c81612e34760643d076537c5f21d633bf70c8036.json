{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Resolve or reopen a comment by posting a reply with the specified action.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "default": "resolve",
    "description": "Action to perform: \"resolve\" to mark as resolved, \"reopen\" to unresolve",
    "enum": [
     "resolve",
     "reopen"
    ],
    "type": "string"
   },
   "commentId": {
    "description": "The ID of the comment to resolve or reopen",
    "type": "string"
   },
   "content": {
    "description": "Optional message to include with the action",
    "type": "string"
   },
   "fileId": {
    "description": "The ID of the file",
    "type": "string"
   }
  },
  "required": [
   "fileId",
   "commentId"
  ],
  "type": "object"
 },
 "name": "comment_resolve",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "action": {
    "type": "string"
   },
   "author": {
    "additionalProperties": false,
    "properties": {
     "displayName": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "content": {
    "type": "string"
   },
   "id": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "title": "Resolve or reopen comment"
}
