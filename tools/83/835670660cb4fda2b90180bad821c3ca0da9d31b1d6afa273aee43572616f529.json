{"description":"Make a video (vertical 9:16 by default; also 4:5, 1:1, 16:9) with voice, captions and music from a brief, files (PDF, Word, Excel, PowerPoint, CSV, text, photos) and/or a public website (site_url: we read its text and can use its logo). Spends tokens from the API key in the Authorization header. Returns the order; poll get_video. The script uses only facts from the brief and files.","inputSchema":{"$defs":{"file":{"additionalProperties":false,"properties":{"content_base64":{"type":"string"},"name":{"type":"string"}},"required":["name","content_base64"],"type":"object"}},"additionalProperties":false,"properties":{"brand_name":{"maxLength":60,"type":"string"},"brand_pronunciation":{"description":"How the narrator should say the brand, spelled as it sounds (e.g. \"Menunoud\" for MenuNode in Spanish). Captions keep brand_name.","maxLength":80,"type":"string"},"brief":{"description":"What the video is about. Required if no files.","maxLength":600,"type":"string"},"duration_seconds":{"maximum":300,"minimum":30,"type":"integer"},"email":{"description":"Optional: we email the order link when the video starts and the download link when it is ready.","maxLength":254,"type":"string"},"files":{"items":{"$ref":"#/$defs/file"},"maxItems":9,"type":"array"},"format":{"description":"Video size: 9:16 vertical (default), 4:5, 1:1 or 16:9.","enum":["9:16","4:5","1:1","16:9"],"type":"string"},"kind":{"enum":["marketing","topic"],"type":"string"},"language":{"enum":["en","es","pt","fr"],"type":"string"},"logo":{"$ref":"#/$defs/file"},"music":{"enum":["auto","ambient","chip","cine","funk","lofi","lux","pop","quirky","synth","tension","acoustic","corporate","hiphop","dance","rock","jazz","latin","kids","news","world","own","none"],"type":"string"},"music_file":{"$ref":"#/$defs/file"},"purpose":{"description":"Optional kind of video, guides the script: ad, brand, announce, realestate, lesson, summary, social, training.","enum":["ad","brand","announce","realestate","testimonial","offer","lesson","summary","social","training","tutorial","faq"],"type":"string"},"site_logo":{"description":"auto: use the best logo found on site_url when no logo file is sent.","enum":["auto","none"],"type":"string"},"site_url":{"description":"A public website to make the video from (its text, and its logo if site_logo is auto). Use instead of or with files/brief.","maxLength":500,"type":"string"},"style":{"description":"id from list_styles","type":"string"},"voice":{"enum":["f","f2","f3","f4","f5","f6","f7","f8","f9","f10","m","m2","m3","m4","m5","m6","m7","m8","m9","fnar20","fami20","fpro20","fnot20","fcue20","fcoa20","fcom20","ftec20","fnar30","fami30","fpro30","ftra30","fnot30","fcue30","fcoa30","fcom30","fasm30","ftec30","fnar45","fami45","fpro45","ftra45","fnot45","fcue45","fcoa45","fcom45","fasm45","ftec45","fnar65","fami65","ftra65","fnot65","fcue65","fcoa65","fasm65","mnar20","mami20","mpro20","mnot20","mcue20","mcoa20","mcom20","mtec20","mnar30","mami30","mpro30","mtra30","mnot30","mcue30","mcoa30","mcom30","masm30","mtec30","mnar45","mami45","mpro45","mtra45","mnot45","mcue45","mcoa45","mcom45","masm45","mtec45","mnar65","mami65","mtra65","mnot65","mcue65","mcoa65","masm65","fuk","muk","fau","mau","fxie","mxie","fxsc","mxsc","fxza","mxza","fxin","mxin","fxso","mxso","fxny","mxny","fxnz","mxnz","fxca","mxca","far","mar","fmx","mmx","fes","mes","fxco","mxco","fxcl","mxcl","fxpe","mxpe","fxve","mxve","fxcu","mxcu","fxan","mxan","fxuy","mxuy","fpt","mpt","fxne","mxne","fxrj","mxrj","fxrs","mxrs","fxmg","mxmg","fxao","mxao","fxba","mxba","fxpo","mxpo","fxmz","mxmz","fqc","mqc","fxbe","mxbe","fxch","mxch","fxsu","mxsu","fxsn","mxsn","fxci","mxci","fxac","mxac","fxly","mxly","fxma","mxma"],"type":"string"}},"required":["kind","language","style","duration_seconds"],"type":"object"},"name":"create_video"}
