{
 "description": "Generate an ISO 9564-1 format 0 clear PIN block from synthetic PIN and PAN test data.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "pan": {
    "description": "Synthetic PAN containing 13 to 19 digits",
    "pattern": "^\\d{13,19}$",
    "type": "string"
   },
   "pin": {
    "description": "Synthetic PIN containing 4 to 12 digits",
    "pattern": "^\\d{4,12}$",
    "type": "string"
   }
  },
  "required": [
   "pin",
   "pan"
  ],
  "type": "object"
 },
 "name": "iso0_pin_block"
}
