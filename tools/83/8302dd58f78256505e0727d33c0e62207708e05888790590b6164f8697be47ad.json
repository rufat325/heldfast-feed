{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Calculate a selectable ayanamsa projection"
 },
 "description": "Projects placements and sign-based Graha Drishti under Lahiri, Krishnamurti, Raman, or Fagan/Bradley, reports boundary changes, and preserves per-convention validation status. Non-Lahiri full derived systems are not silently recomputed.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "place"
    ]
   },
   {
    "required": [
     "latitude",
     "longitude",
     "timezone"
    ]
   }
  ],
  "properties": {
   "ayanamsa": {
    "enum": [
     "lahiri",
     "krishnamurti",
     "raman",
     "fagan-bradley"
    ],
    "type": "string"
   },
   "birthTimeAccuracyMinutes": {
    "default": 5,
    "maximum": 1440,
    "minimum": 0,
    "type": "number"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "te"
    ],
    "type": "string"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "place": {
    "description": "Catalogue query or display label when explicit coordinates are supplied",
    "type": "string"
   },
   "time": {
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "timezone": {
    "description": "Required IANA timezone when explicit coordinates are supplied, for example Asia/Kolkata",
    "type": "string"
   },
   "timezoneOffset": {
    "description": "Optional fallback offset; derived from timezone and the requested local date when omitted",
    "maximum": 14,
    "minimum": -14,
    "type": "number"
   }
  },
  "required": [
   "date",
   "time",
   "ayanamsa"
  ],
  "type": "object"
 },
 "name": "calculate_ayanamsa_chart",
 "outputSchema": {
  "properties": {
   "aspects": {
    "type": "object"
   },
   "boundaryChangesFromLahiri": {
    "type": "array"
   },
   "placements": {
    "type": "array"
   },
   "safety": {
    "type": "object"
   },
   "schemaVersion": {
    "const": "sahadeva-ayanamsa-projection-1"
   },
   "scope": {
    "type": "object"
   },
   "selected": {
    "type": "object"
   }
  },
  "required": [
   "schemaVersion",
   "selected",
   "placements",
   "aspects",
   "boundaryChangesFromLahiri",
   "scope",
   "safety"
  ],
  "type": "object"
 },
 "title": "Calculate a selectable ayanamsa projection"
}
