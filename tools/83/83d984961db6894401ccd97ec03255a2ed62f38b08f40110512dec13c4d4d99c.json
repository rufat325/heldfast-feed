{
 "annotations": {},
 "description": "Reset CMAK access account password for a CDSS cluster",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kafkaManagerUserPassword": {
    "description": "New CMAK password (8-20 chars, letters+numbers+special)",
    "type": "string"
   },
   "serviceGroupInstanceNo": {
    "description": "Cluster instance number",
    "type": "string"
   }
  },
  "required": [
   "serviceGroupInstanceNo",
   "kafkaManagerUserPassword"
  ],
  "type": "object"
 },
 "name": "ncloud_cdss_reset_cmak_password"
}
