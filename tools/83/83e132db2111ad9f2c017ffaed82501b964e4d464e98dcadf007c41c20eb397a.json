{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a named environment within a project; repeating the name returns the existing environment. Where test_copy_of is listed in this connection's input schema, supplying it with confirm=true queues fresh applications with empty production secrets, separate storage and addresses, and no production data or bindings. Otherwise this tool creates an empty environment. Requires unrestricted account credentials.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "name": {
    "pattern": "^[a-z][a-z0-9-]{0,47}$",
    "type": "string"
   },
   "project_id": {
    "pattern": "^prj_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "name"
  ],
  "type": "object"
 },
 "name": "impreza_create_environment",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "environment_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "services": {
      "additionalProperties": {
       "additionalProperties": false,
       "properties": {
        "command_id": {
         "type": "string"
        },
        "deployment_id": {
         "type": "string"
        }
       },
       "required": [
        "deployment_id",
        "command_id"
       ],
       "type": "object"
      },
      "type": "object"
     },
     "test_copy": {
      "additionalProperties": false,
      "properties": {
       "bindings_copied": {
        "const": false,
        "type": "boolean"
       },
       "data_copied": {
        "const": false,
        "type": "boolean"
       },
       "inherits_project_variables": {
        "const": false,
        "type": "boolean"
       },
       "required_variables": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "required_variables",
       "inherits_project_variables",
       "data_copied",
       "bindings_copied"
      ],
      "type": "object"
     }
    },
    "required": [
     "environment_id",
     "name",
     "replayed"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
