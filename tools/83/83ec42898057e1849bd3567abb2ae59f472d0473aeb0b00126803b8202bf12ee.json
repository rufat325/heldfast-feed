{
 "description": "Get a presigned S3 URL to download any file you own (1-hour expiry)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "file": {
    "description": "File name with extension (e.g., REPORT.R)",
    "type": "string"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "type": {
    "description": "File type directory",
    "enum": [
     "data",
     "format",
     "source",
     "proc",
     "output"
    ],
    "type": "string"
   },
   "userid": {
    "description": "Project owner's username. Required when accessing a shared project where you are a writer. Defaults to the authenticated user.",
    "type": "string"
   }
  },
  "required": [
   "project",
   "file",
   "type"
  ],
  "type": "object"
 },
 "name": "chaprola_download"
}
