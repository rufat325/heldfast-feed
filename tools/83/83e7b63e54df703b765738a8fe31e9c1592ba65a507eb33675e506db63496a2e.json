{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List posts"
 },
 "description": "List scheduled/published posts with filtering by status, platform, date range",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "fromDate": {
    "description": "Start date filter (ISO 8601)",
    "type": "string"
   },
   "limit": {
    "description": "Results per page (default: 20, max: 100)",
    "type": "number"
   },
   "page": {
    "description": "Page number (default: 1)",
    "type": "number"
   },
   "platform": {
    "description": "Filter by platform name, e.g. 'linkedin', 'twitter'",
    "type": "string"
   },
   "responseFormat": {
    "description": "'detailed' (default) returns full post content; 'concise' truncates each post's content to a preview to save tokens.",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "sortBy": {
    "description": "Sort field (default: createdAt)",
    "enum": [
     "createdAt",
     "updatedAt",
     "scheduledTime"
    ],
    "type": "string"
   },
   "sortOrder": {
    "description": "Sort direction (default: desc)",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by post status",
    "enum": [
     "draft",
     "scheduled",
     "published",
     "failed",
     "partially_published"
    ],
    "type": "string"
   },
   "toDate": {
    "description": "End date filter (ISO 8601)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_posts",
 "title": "List posts"
}
