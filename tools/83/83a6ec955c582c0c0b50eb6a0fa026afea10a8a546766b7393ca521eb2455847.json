{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false,
  "title": "Watermark a PDF"
 },
 "description": "Stamp a text watermark on every page. Runs entirely on this machine \u2014 the file is read and written locally and never sent anywhere.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "color": {
    "description": "Color as #RRGGBB (default #808080)",
    "type": "string"
   },
   "fontSize": {
    "description": "Font size in points (default 48)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "force": {
    "description": "Replace the output file if it already exists (default: refuse, so existing files are never silently clobbered)",
    "type": "boolean"
   },
   "input": {
    "description": "Path to the input PDF",
    "type": "string"
   },
   "opacity": {
    "description": "Opacity 0-1 (default 0.15)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "output": {
    "description": "Path to write the watermarked PDF",
    "type": "string"
   },
   "position": {
    "description": "Placement (default center)",
    "enum": [
     "center",
     "top-left",
     "top-right",
     "bottom-left",
     "bottom-right"
    ],
    "type": "string"
   },
   "text": {
    "description": "Watermark text",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "input",
   "output",
   "text"
  ],
  "type": "object"
 },
 "name": "pdf_watermark",
 "title": "Watermark a PDF"
}
