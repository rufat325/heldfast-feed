    "reconciliation"
   ]
  }
 },
 "description": "List Bank Entries",
 "inputSchema": {
  "properties": {
   "bank_account_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "bank_statement_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "company_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "counterparty_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "credit_debit": {
    "anyOf": [
     {
      "enum": [
       "credit",
       "debit"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "flag": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "from": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "limit": {
    "default": 20,
    "maximum": 200.0,
    "minimum": 1.0,
    "type": "integer"
   },
   "match_quality": {
    "anyOf": [
     {
      "description": "Graded bank-entry \u2194 invoice match quality (match-quality feature, 2026-06-09).\n\nAuto bands (from how many matchable fields line up, see ``services.reconciliation``):\n``full`` > ``strong`` > ``partial`` > ``weak``. ``manual`` (user-created/confirmed)\nand ``imported`` (asserted by a source export) are provenance values that win over\nany auto band.",
      "enum": [
       "full",
       "strong",
       "partial",
       "weak",
       "manual",
       "imported"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "offset": {
    "default": 0,
    "minimum": 0.0,
    "type": "integer"
   },
   "q": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "reconciliation_status": {
    "anyOf": [
     {
      "enum": [
       "unmatched",
       "partially_matched",
       "matched",
       "ignored"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "settlement_status": {
    "anyOf": [
     {
      "description": "Clean-bank settlement state of a bank entry (distinct from ``reconciliation_status``,\nwhich the matcher owns). Set by ``settle_bank_entry``.",
      "enum": [
       "unsettled",
       "settled",
       "partially_settled",
       "suspense"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "to": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "list_bank_entries"
}
