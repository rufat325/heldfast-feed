{
 "description": "Create a Langfuse trace to log an LLM interaction (input, output, model, metadata).\n\nRequires scope: integrations:observe:write. Every call governed by Arbiter constitutional policy and sealed with a ProofLink cryptographic receipt.",
 "inputSchema": {
  "properties": {
   "input": {
    "description": "Input payload (any JSON value)"
   },
   "metadata": {
    "description": "Arbitrary metadata object"
   },
   "model": {
    "description": "Model ID used (e.g. claude-sonnet-4-6)",
    "type": "string"
   },
   "name": {
    "description": "Trace name / operation label",
    "type": "string"
   },
   "output": {
    "description": "Output payload (any JSON value)"
   },
   "tags": {
    "description": "Trace tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "userId": {
    "description": "End-user identifier",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "langfuse_trace"
}
