{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Complete clariBI signup by submitting the verification code plus a password. Returns an OAuth access_token for immediate use AND a long-lived MCP API key for persistent configuration. The new organization lands on the Trial tier (50 AI credits, 14 days).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "6-digit verification code from the email.",
    "pattern": "^[0-9]{6}$",
    "type": "string"
   },
   "password": {
    "description": "A password for the new account. Must be at least 8 characters and pass Django's standard validators.",
    "minLength": 8,
    "type": "string"
   },
   "pending_id": {
    "description": "The pending_id returned by register_account.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "pending_id",
   "code",
   "password"
  ],
  "type": "object"
 },
 "name": "verify_email",
 "outputSchema": {
  "properties": {
   "access_token": {
    "description": "OAuth bearer token for this conversation.",
    "type": "string"
   },
   "expires_in": {
    "description": "Access-token lifetime in seconds.",
    "type": "integer"
   },
   "mcp_api_key": {
    "description": "Long-lived API key (claribi_mcp_...) for persistent client config.",
    "type": "string"
   },
   "mcp_api_key_id": {
    "format": "uuid",
    "type": "string"
   },
   "next_steps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "organization_id": {
    "type": "string"
   },
   "scope": {
    "description": "Space-separated granted scopes.",
    "type": "string"
   },
   "tier": {
    "description": "New organization tier, always \"trial\".",
    "type": "string"
   },
   "token_type": {
    "description": "Always \"Bearer\".",
    "type": "string"
   },
   "user_id": {
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "token_type",
   "expires_in",
   "scope",
   "mcp_api_key",
   "mcp_api_key_id",
   "user_id",
   "organization_id",
   "tier"
  ],
  "type": "object"
 }
}
