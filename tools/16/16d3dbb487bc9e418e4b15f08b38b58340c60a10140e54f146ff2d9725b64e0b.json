{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "gymflexa:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List your gyms"
 },
 "description": "Use this when someone asks which gyms or studios they run in GymFlexa, or a gym's id is needed. Returns gyms with id, name, currency, default language and last edit time, alphabetical, 25 per page by default. Not for finding a member.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page of this listing; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of gyms to return (default 25, maximum 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_gyms",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "gyms": {
    "description": "Gyms in the signed-in organization, alphabetical. Organization, address, contact, billing, integration and member data are never returned.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "currency": {
       "anyOf": [
        {
         "pattern": "^[A-Z]{3}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "defaultLocale": {
       "anyOf": [
        {
         "maxLength": 16,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "maxLength": 200,
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "currency",
      "defaultLocale",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "hasMore": {
    "type": "boolean"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 4096,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   }
  },
  "required": [
   "gyms",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List your gyms"
}
