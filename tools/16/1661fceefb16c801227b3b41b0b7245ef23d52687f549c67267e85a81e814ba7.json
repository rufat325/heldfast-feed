 "description": "\u3010\u9700\u8981\u767b\u5f55\u3011\u6307\u5b9a\u539frequestId\uff1b\u6536\u4ef6\u4ebaaccept/decline\uff0c\u53d1\u8d77\u4ebacancel\u3002\u9ed8\u8ba4\u9884\u89c8\uff0c\u672c\u4eba\u660e\u786e\u540c\u610f\u51b3\u5b9a\u540e\uff0c\u540c\u53c2+previewHash\u3001consent=true\u3001preview=false\u6267\u884c\u3002accept\u987b\u672c\u4eba\u63d0\u4f9b\u613f\u5411\u5bf9\u65b9\u5206\u4eab\u7684contact+shareContactConsent=true\uff0c\u7981\u53d6\u767b\u5f55\u624b\u673a/\u6863\u6848\uff1bdecline/cancel\u65e0contact\u3002\u4f1a\u901a\u77e5\u5bf9\u65b9\uff1b\u91cd\u9a8c\u72b6\u6001/\u53ef\u89c1\u6027/\u5c4f\u853d\uff0c\u5931\u8d25\u4e0d\u6362\u8bf7\u6c42\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "accept",
     "decline",
     "cancel"
    ],
    "type": "string"
   },
   "consent": {
    "const": true,
    "description": "\u7528\u6237\u660e\u786e\u540c\u610f\u672c\u6b21\u5bf9\u8c61\u53ca\u540e\u679c\u624d\u4f20 true",
    "type": "boolean"
   },
   "contact": {
    "description": "\u672c\u4eba\u63d0\u4f9b\u4e14\u660e\u786e\u540c\u610f\u5206\u4eab\uff1b\u7981\u6b62\u81ea\u52a8\u53d6\u624b\u673a\u53f7/\u6863\u6848",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "preview": {
    "default": true,
    "type": "boolean"
   },
   "previewHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "requestId": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "shareContactConsent": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "requestId",
   "action"
  ],
  "type": "object"
 },
 "name": "respond_connection_request",
 "title": "\u56de\u5e94\u6216\u64a4\u56de\u4ea4\u6d41\u8bf7\u6c42"
}
