{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Export a scoped, mergeable JSONL bundle for another Pathmark installation or trusted sync transport.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "destination": {
    "minLength": 1,
    "type": "string"
   },
   "encrypted": {
    "default": false,
    "description": "Encrypt the export with PATHMARK_EXPORT_KEY.",
    "type": "boolean"
   },
   "includeDeleted": {
    "default": false,
    "type": "boolean"
   },
   "kind": {
    "enum": [
     "memory",
     "conclusion"
    ],
    "type": "string"
   },
   "namespace": {
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "destination"
  ],
  "type": "object"
 },
 "name": "export_memory",
 "title": "Export memory"
}
