  "readOnlyHint": false
 },
 "description": "Update any subset of fields on an existing, not-yet-submitted Experience Application. Same field set and validation rules as createExperienceApplication \u2014 only pass the fields you're changing. Fails with a 409 if the application has already been submitted. Requires NOMADSTAYS_MCP_AGENT_TOKEN.",
 "inputSchema": {
  "properties": {
   "applicantEmail": {
    "type": "string"
   },
   "applicantFirstName": {
    "type": "string"
   },
   "applicantLastName": {
    "type": "string"
   },
   "applicationId": {
    "description": "The application's ID",
    "type": "number"
   },
   "availabilitySupplier": {
    "type": "string"
   },
   "businessModelId": {
    "description": "tbBusinessModel.EntryID \u2014 use getBusinessModelOptions.",
    "type": "number"
   },
   "businessName": {
    "type": "string"
   },
   "city": {
    "type": "string"
   },
   "comments": {
    "type": "string"
   },
   "daysQty": {
    "description": "Minimum 4 days, enforced server-side",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "downloadSpeed": {
    "type": "string"
   },
   "experienceCountryId": {
    "description": "tbCountry.CountryId \u2014 the country the application itself is filed under. Use getCountryOptions.",
    "type": "number"
   },
   "experienceName": {
    "type": "string"
   },
   "hasInsurance": {
    "type": "boolean"
   },
   "hasKitchen": {
    "type": "boolean"
   },
   "laundryFacilities": {
    "enum": [
     "No",
     "On Premises",
     "Nearby"
    ],
    "type": "string"
   },
   "maxPax": {
    "type": "string"
   },
   "mobile": {
    "type": "string"
   },
   "monthlyPrice": {
    "type": "string"
   },
   "overnightLocationsQty": {
    "type": "string"
   },
   "postalCountryId": {
    "description": "tbCountry.CountryId \u2014 used only for the VAT check, stored on the business profile, not on the application. Use getCountryOptions.",
    "type": "number"
   },
   "state": {
    "type": "string"
   },
   "street": {
    "type": "string"
   },
   "tourismNumber": {
    "type": "string"
   },
   "vatNumber": {
    "type": "string"
   },
   "website": {
    "type": "string"
   },
   "workFacilities": {
    "enum": [
     "None",
     "Both",
     "In Room",
     "CoWorking Space"
    ],
    "type": "string"
   },
   "zip": {
    "type": "string"
   }
  },
  "required": [
   "applicationId"
  ],
  "type": "object"
 },
 "name": "saveExperienceApplication"
}
