{
 "description": "Analyze a sales pipeline. Returns weighted forecast, stage breakdown, win rate, and flags stale or at-risk deals with recommended urgent actions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "forecastPeriod": {
    "default": "quarter",
    "enum": [
     "month",
     "quarter",
     "year"
    ],
    "type": "string"
   },
   "leads": {
    "description": "Array of leads in the pipeline",
    "items": {
     "additionalProperties": false,
     "properties": {
      "company": {
       "type": "string"
      },
      "dealValue": {
       "description": "Estimated deal value in USD",
       "type": "number"
      },
      "expectedCloseDate": {
       "description": "ISO date of expected close",
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "lastActivity": {
       "description": "ISO date of last activity",
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "notes": {
       "type": "string"
      },
      "owner": {
       "description": "Sales rep name",
       "type": "string"
      },
      "stage": {
       "enum": [
        "prospect",
        "qualified",
        "discovery",
        "proposal",
        "negotiation",
        "closed_won",
        "closed_lost"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "company",
      "dealValue",
      "stage",
      "lastActivity",
      "expectedCloseDate"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "leads"
  ],
  "type": "object"
 },
 "name": "track_pipeline"
}
