{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare two caller-supplied OpenAPI JSON documents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "after": {
    "description": "Later OpenAPI JSON document."
   },
   "before": {
    "description": "Earlier OpenAPI JSON document."
   },
   "idempotency_key": {
    "description": "Stable key used to make a paid retry idempotent.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "before",
   "after",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "diff_openapi",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "OpenAPI operation additions, removals, compatibility changes, and breaking flag.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "added": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "breaking": {
    "type": "boolean"
   },
   "changed": {
    "items": {},
    "type": "array"
   },
   "comparedAt": {
    "type": "string"
   },
   "error": {},
   "extensions": {},
   "removed": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "resource": {},
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Diff OpenAPI"
}
