{
 "description": "Create a new scheduled job \u2014 an HTTP request fired on a schedule. The schedule.type is one of: \"cron\" (schedule.expression is a cron string, optional IANA schedule.timezone), \"interval\" (schedule.expression is the number of milliseconds between runs, as a string), or \"once\" for a single future run (schedule.expression is an ISO-8601 date-time \u2014 either an absolute instant like \"2026-12-25T14:00:00Z\"/with offset, or a naive wall-clock time like \"2026-12-25T09:00:00\" interpreted in schedule.timezone, defaulting to UTC; the time must be in the future). One-off jobs support the same retries, alerts and logs as recurring jobs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "httpConfig": {
    "additionalProperties": false,
    "properties": {
     "body": {
      "maxLength": 1048576,
      "type": "string"
     },
     "headers": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "method": {
      "default": "GET",
      "enum": [
       "GET",
       "POST",
       "PUT",
       "PATCH",
       "DELETE",
       "HEAD",
       "OPTIONS"
      ],
      "type": "string"
     },
     "timeoutMs": {
      "default": 30000,
      "maximum": 300000,
      "minimum": 1000,
      "type": "integer"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "type": "object"
   },
   "name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "retryPolicy": {
    "additionalProperties": false,
    "properties": {
     "backoffMultiplier": {
      "default": 2,
      "maximum": 10,
      "minimum": 1,
      "type": "number"
     },
     "initialDelay": {
      "default": 1000,
      "maximum": 60000,
      "minimum": 100,
      "type": "integer"
     },
     "maxDelay": {
      "default": 300000,
      "maximum": 3600000,
      "minimum": 1000,
      "type": "integer"
     },
     "maxRetries": {
      "default": 3,
      "maximum": 10,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "schedule": {
    "additionalProperties": false,
    "properties": {
     "expression": {
      "minLength": 1,
      "type": "string"
     },
     "timezone": {
      "type": "string"
     },
     "type": {
      "enum": [
       "cron",
       "interval",
       "once"
      ],
      "type": "string"
     }
    },
    "required": [
     "type",
     "expression"
    ],
    "type": "object"
   },
   "tags": {
    "items": {
     "maxLength": 50,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "name",
   "schedule",
   "httpConfig"
  ],
  "type": "object"
 },
 "name": "create_job"
}
