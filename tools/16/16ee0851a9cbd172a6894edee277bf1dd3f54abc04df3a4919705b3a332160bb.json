{
 "description": "Request human approval for a high-value purchase.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent_id": {
    "description": "Agent requesting approval",
    "type": "string"
   },
   "amount": {
    "description": "Purchase amount",
    "type": "number"
   },
   "currency": {
    "default": "usd",
    "description": "Currency",
    "type": "string"
   },
   "expires_minutes": {
    "default": 30,
    "description": "Minutes until approval expires",
    "type": "number"
   },
   "merchant": {
    "description": "Merchant name",
    "type": "string"
   },
   "reason": {
    "description": "Why this purchase is needed",
    "type": "string"
   }
  },
  "required": [
   "agent_id",
   "merchant",
   "amount",
   "reason"
  ],
  "type": "object"
 },
 "name": "request_human_approval"
}
