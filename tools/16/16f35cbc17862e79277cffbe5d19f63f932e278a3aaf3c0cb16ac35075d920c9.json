{
 "description": "Create a virtual Visa card for a purchase. Returns card number (PAN), CVV, and expiry. Max $500 per card. Subject to card spending rules.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Purchase amount in USD (e.g. \"25.00\")",
    "type": "string"
   },
   "merchant": {
    "description": "Merchant name (e.g. \"OpenAI\", \"AWS\")",
    "type": "string"
   },
   "reason": {
    "description": "Reason for purchase",
    "type": "string"
   }
  },
  "required": [
   "amount"
  ],
  "type": "object"
 },
 "name": "card_purchase"
}
