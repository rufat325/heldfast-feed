{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:ads"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Replace a campaign's ad schedule (dayparting)"
 },
 "description": "Replace a campaign's ad schedule (dayparting). Spending/deletion: preview, then owner-approved confirm:true with the same requestId. Other edits: one call. Creates request active; report returned status and claim live only when active. Full field guide: soclo://tools/soclo_ads_update_campaign_ad_schedule.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "properties": {
     "campaignId": {
      "type": "string"
     }
    },
    "required": [
     "campaignId"
    ],
    "type": "object"
   },
   "payload": {
    "properties": {
     "schedule": {
      "items": {
       "properties": {
        "bidModifier": {
         "anyOf": [
          {
           "maximum": 10,
           "minimum": 0.1,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "dayOfWeek": {
         "enum": [
          "MONDAY",
          "TUESDAY",
          "WEDNESDAY",
          "THURSDAY",
          "FRIDAY",
          "SATURDAY",
          "SUNDAY"
         ],
         "type": "string"
        },
        "endHour": {
         "description": "24 means midnight at the end of the day.",
         "maximum": 24,
         "minimum": 0,
         "type": "integer"
        },
        "endMinute": {
         "description": "Quarter-hours only. Must be 0 when endHour is 24.",
         "enum": [
          0,
          15,
          30,
          45
         ],
         "type": "number"
        },
        "startHour": {
         "maximum": 23,
         "minimum": 0,
         "type": "integer"
        },
        "startMinute": {
         "description": "Quarter-hours only.",
         "enum": [
          0,
          15,
          30,
          45
         ],
         "type": "number"
        }
       },
       "required": [
        "dayOfWeek",
        "startHour",
        "endHour"
       ],
       "type": "object"
      },
      "maxItems": 42,
      "type": "array"
     }
    },
    "required": [
     "schedule"
    ],
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "parameters",
   "payload"
  ],
  "type": "object"
 },
 "name": "soclo_ads_update_campaign_ad_schedule",
 "title": "Replace a campaign's ad schedule (dayparting)"
}
