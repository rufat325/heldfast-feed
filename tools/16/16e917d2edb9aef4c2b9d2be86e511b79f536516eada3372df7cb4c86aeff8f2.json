{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create compliance item"
 },
 "description": "Create a new compliance item (regulatory requirement). Requires compliance:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "compliance_period_months": {
    "description": "Compliance period in months",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "name": {
    "description": "Compliance item name (required)",
    "maxLength": 500,
    "type": "string"
   },
   "regulation_reference": {
    "description": "Regulation or code reference",
    "maxLength": 500,
    "type": "string"
   },
   "status": {
    "description": "Status",
    "enum": [
     "active",
     "archived"
    ],
    "type": "string"
   },
   "system_id": {
    "description": "Associated system ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_compliance_item",
 "title": "Create compliance item"
}
