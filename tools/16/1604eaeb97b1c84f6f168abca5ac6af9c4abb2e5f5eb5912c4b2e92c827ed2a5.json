{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Voltage drop for a single- or three-phase run using NEC Chapter 9 Table 8 conductor sizes. Formula: VD = 2 \u00d7 K \u00d7 I \u00d7 L \u00f7 CM (single phase) or \u221a3 \u00d7 K \u00d7 I \u00d7 L \u00f7 CM (three phase); K = ohm\u00b7cmil/ft (approx. 12.9 Cu, 21.2 Al); CM from NEC Ch. 9 Table 8.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amps": {
    "description": "Load current (A); default 16",
    "type": "number"
   },
   "awg": {
    "description": "Wire size (AWG); default 12",
    "enum": [
     "1",
     "2",
     "3",
     "4",
     "6",
     "8",
     "10",
     "12",
     "14",
     "1/0",
     "2/0",
     "3/0",
     "4/0"
    ],
    "type": "string"
   },
   "material": {
    "description": "Conductor; default copper",
    "enum": [
     "copper",
     "aluminum"
    ],
    "type": "string"
   },
   "one_way_ft": {
    "description": "One-way length (ft); default 100",
    "type": "number"
   },
   "phase": {
    "description": "Phase; default 1; one of 1 = Single phase, 3 = Three phase",
    "type": "number"
   },
   "volts": {
    "description": "Source voltage (V); default 120",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "calc_voltage_drop",
 "title": "Wire Size & Voltage Drop Calculator (AWG, Copper/Aluminum)"
}
