{
 "description": "Validate a complete desired job instruction page tree without writing. Omitted current pages are reported as archives. Returns one token for the exact atomic tree swap.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "archivedPageIds": {
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "confirmTreeReplace": {
    "const": true,
    "type": "boolean"
   },
   "expectedTreeChecksum": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "additionalProperties": false,
       "properties": {
        "attrs": {
         "additionalProperties": {},
         "type": "object"
        },
        "content": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "attrs": {
            "additionalProperties": {},
            "type": "object"
           },
           "content": {
            "items": {
             "$ref": "#/properties/pages/items/properties/content/properties/content/items"
            },
            "type": "array"
           },
           "marks": {
            "items": {
             "additionalProperties": false,
             "properties": {
              "attrs": {
               "additionalProperties": {},
               "type": "object"
              },
              "type": {
               "minLength": 1,
               "type": "string"
              }
             },
             "required": [
              "type"
             ],
             "type": "object"
            },
            "type": "array"
           },
           "text": {
            "type": "string"
           },
           "type": {
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "type"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "type": {
         "const": "doc",
         "type": "string"
        }
       },
       "required": [
        "type",
        "content"
       ],
       "type": "object"
      },
      "contentSchemaVersion": {
       "enum": [
        1,
        2
       ],
       "type": "number"
      },
      "expectedChecksum": {
       "$ref": "#/properties/expectedTreeChecksum"
      },
      "icon": {
       "anyOf": [
        {
         "maxLength": 32,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "pageId": {
       "minLength": 1,
       "type": "string"
      },
      "parentRef": {
       "anyOf": [
        {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "position": {
       "minimum": 0,
       "type": "integer"
      },
      "ref": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "title": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "ref",
      "title",
      "parentRef",
      "position",
      "content"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "type": "array"
   }
  },
  "required": [
   "jobId",
   "expectedTreeChecksum",
   "pages",
   "confirmTreeReplace",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_job_instructions_preflight_tree",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
