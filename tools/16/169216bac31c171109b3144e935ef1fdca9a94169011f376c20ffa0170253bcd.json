{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a to-do task"
 },
 "description": "Create an internal to-do task assigned to a staff user, optionally tied to a property/unit and category, with a due date. Buildium: POST /v1/tasks/todorequests.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assigned_to_user_id": {
    "description": "Staff user id assigned to the task.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "category_id": {
    "description": "Task category id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "description": {
    "description": "Task description.",
    "maxLength": 65500,
    "type": "string"
   },
   "due_date": {
    "description": "Due date, YYYY-MM-DD.",
    "type": "string"
   },
   "priority": {
    "description": "Priority.",
    "enum": [
     "Low",
     "Normal",
     "High"
    ],
    "type": "string"
   },
   "property_id": {
    "description": "Active property id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "status": {
    "description": "Status.",
    "enum": [
     "New",
     "InProgress",
     "Completed",
     "Deferred",
     "Closed"
    ],
    "type": "string"
   },
   "subcategory_id": {
    "description": "Task subcategory id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "title": {
    "description": "Task title (max 127).",
    "maxLength": 127,
    "type": "string"
   },
   "unit_id": {
    "description": "Unit id (must belong to property_id).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "title",
   "assigned_to_user_id",
   "priority",
   "status"
  ],
  "type": "object"
 },
 "name": "buildium_create_todo_task",
 "title": "Create a to-do task"
}
