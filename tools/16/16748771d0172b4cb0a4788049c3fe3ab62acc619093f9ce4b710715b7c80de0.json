{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Replaces the contents of the shelf with this ordered list with collection names. The PDFs themselves are kept.",
 "inputSchema": {
  "$defs": {
   "ShelfItem": {
    "additionalProperties": false,
    "properties": {
     "catalogue_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Catalogue Id",
      "type": "string"
     },
     "collection": {
      "default": "",
      "maxLength": 80,
      "title": "Collection",
      "type": "string"
     }
    },
    "required": [
     "catalogue_id"
    ],
    "title": "ShelfItem",
    "type": "object"
   }
  },
  "properties": {
   "dry_run": {
    "default": false,
    "title": "Dry Run",
    "type": "boolean"
   },
   "expected_revision": {
    "pattern": "^[a-f0-9]{64}$",
    "title": "Expected Revision",
    "type": "string"
   },
   "items": {
    "items": {
     "$ref": "#/$defs/ShelfItem"
    },
    "maxItems": 400,
    "title": "Items",
    "type": "array"
   },
   "shelf_id": {
    "pattern": "^[A-Za-z0-9_-]{1,64}$",
    "title": "Shelf Id",
    "type": "string"
   }
  },
  "required": [
   "shelf_id",
   "items",
   "expected_revision"
  ],
  "title": "set_shelf_cataloguesArguments",
  "type": "object"
 },
 "name": "foliade_set_shelf_catalogues",
 "title": "Compose and order the catalogues of a shelf"
}
