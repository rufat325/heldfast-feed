{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Invoke one previously discovered Warm operation. Every write operation requires the approval_id returned for the exact same input by describe_operation.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approval_id": {
    "description": "Approval ID returned by describe_operation for the exact write input.",
    "format": "uuid",
    "type": "string"
   },
   "input": {
    "additionalProperties": false,
    "description": "Exact intended input. Required to obtain approval for a write operation.",
    "properties": {
     "body": {
      "additionalProperties": {},
      "type": "object"
     },
     "params": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "operation_id": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "operation_id"
  ],
  "type": "object"
 },
 "name": "invoke_operation",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {},
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "operation_id": {
    "type": "string"
   },
   "status": {
    "type": "integer"
   }
  },
  "required": [
   "headers",
   "operation_id",
   "status"
  ],
  "type": "object"
 }
}
