{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/html.tables",
  "agent-utilities/priceMicroUsd": 500
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Extract source table cells without expanding spans. PAID: 500 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "html": {
      "maxLength": 100000,
      "type": "string"
     }
    },
    "required": [
     "html"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "html_tables",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "spanPolicy": {
    "type": "string"
   },
   "tables": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "caption": {
       "type": "string"
      },
      "hasSpans": {
       "type": "boolean"
      },
      "rows": {
       "items": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "type": "array"
      }
     },
     "required": [
      "caption",
      "rows",
      "hasSpans"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tables",
   "spanPolicy"
  ],
  "type": "object"
 }
}
