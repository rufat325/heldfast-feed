{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Changes the DRAFT of one event website the person organizes with small operations on blocks, bands, the theme and pages; they apply together or not at all. A rename that comes with any wording meaning keep the old heading is one site_edit call with keepHeading true; the same wish said after the rename reply is one call sending its `undo` as is; a plain \"undo\" after a rename reverts the whole rename. Event dates, times and names go in as live tokens such as {event.dates}; a refused edit returns a `suggestion`. Nothing is live until site_publish. Only the organizer can edit it; it needs a personal connector token.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "eventIdOrName": {
    "description": "The event id or name as the organizer spells it.",
    "type": "string"
   },
   "ops": {
    "description": "The operations, applied together or not at all.",
    "items": {
     "properties": {
      "after": {
       "maxLength": 60,
       "type": "string"
      },
      "before": {
       "maxLength": 60,
       "type": "string"
      },
      "columns": {
       "maximum": 3,
       "minimum": 1,
       "type": "integer"
      },
      "field": {
       "maxLength": 20,
       "type": "string"
      },
      "href": {
       "description": "https, mailto, #<id> or page:<page id>.",
       "maxLength": 500,
       "type": "string"
      },
      "index": {
       "maximum": 60,
       "minimum": 0,
       "type": "integer"
      },
      "into": {
       "maxLength": 60,
       "type": "string"
      },
      "keepHeading": {
       "description": "true whenever the person indicates, in ANY words, that the page heading should stay as it was (keep the heading, leave the title, keep it as is, leave the heading alone, just the menu).",
       "type": "boolean"
      },
      "kind": {
       "maxLength": 20,
       "type": "string"
      },
      "leftOf": {
       "maxLength": 60,
       "type": "string"
      },
      "nav": {
       "items": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "properties": {
           "href": {
            "maxLength": 500,
            "type": "string"
           },
           "label": {
            "maxLength": 24,
            "type": "string"
           }
          },
          "required": [
           "label",
           "href"
          ],
          "type": "object"
         }
        ]
       },
       "maxItems": 8,
       "type": "array"
      },
      "navLabel": {
       "maxLength": 24,
       "type": "string"
      },
      "node": {
       "description": "Block or band id or label.",
       "maxLength": 60,
       "type": "string"
      },
      "op": {
       "description": "set_layout puts a row in `columns` 1 to 3; move and insert may go `rightOf` or `leftOf` a block.",
       "enum": [
        "move",
        "insert",
        "remove",
        "remove_page",
        "set_text",
        "set_link",
        "set_style",
        "set_theme",
        "add_page",
        "rename_page",
        "reorder_nav",
        "set_layout"
       ],
       "type": "string"
      },
      "page": {
       "maxLength": 60,
       "type": "string"
      },
      "props": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "rightOf": {
       "maxLength": 60,
       "type": "string"
      },
      "style": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "template": {
       "description": "add_page: blank, agenda, speakers, exhibitors, sponsors, venue-travel, faq, register or contact.",
       "maxLength": 20,
       "type": "string"
      },
      "text": {
       "description": "Plain words.",
       "maxLength": 2000,
       "type": "string"
      },
      "theme": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "title": {
       "maxLength": 60,
       "type": "string"
      },
      "toPage": {
       "maxLength": 60,
       "type": "string"
      }
     },
     "required": [
      "op"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "siteId": {
    "description": "The site id from site_list.",
    "maxLength": 64,
    "type": "string"
   }
  },
  "required": [
   "eventIdOrName",
   "siteId",
   "ops"
  ],
  "type": "object"
 },
 "name": "site_edit",
 "outputSchema": {
  "additionalProperties": true,
  "anyOf": [
   {
    "required": [
     "ok",
     "applied",
     "changes"
    ]
   },
   {
    "properties": {
     "ok": {
      "const": false
     }
    },
    "required": [
     "ok"
    ]
   },
   {
    "properties": {
     "found": {
      "const": false
     }
    },
    "required": [
     "found"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "applied": {
    "type": "boolean"
   },
   "changes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "code": {
    "type": "string"
   },
   "draftPreviewLink": {
    "type": [
     "string",
     "null"
    ]
   },
   "error": {
    "type": "string"
   },
   "failedOp": {
    "type": "integer"
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "reasons": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "servedBy": {
    "type": "string"
   },
   "siteId": {
    "type": "string"
   },
   "undo": {
    "items": {
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Edit an event website's draft (organizers only)"
}
