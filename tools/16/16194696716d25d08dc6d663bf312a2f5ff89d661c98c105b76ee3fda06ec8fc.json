{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "title": "Update day block"
 },
 "description": "Update a time block (title, duration, anchor, note, done). Only send fields you want to change. The block keeps its position in the timeline order.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "anchor_time": {
    "anyOf": [
     {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Fixed wall-clock hour HH:MM. Pass null to unpin (the block flows with the rest again)."
   },
   "done": {
    "description": "Mark the block done (true) or not done (false)",
    "type": "boolean"
   },
   "duration_minutes": {
    "description": "Duration in minutes",
    "maximum": 1440,
    "minimum": 1,
    "type": "integer"
   },
   "id": {
    "description": "Block UUID",
    "format": "uuid",
    "type": "string"
   },
   "note": {
    "description": "Free note. Pass null to clear.",
    "type": [
     "string",
     "null"
    ]
   },
   "title": {
    "description": "Block label",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_day_block"
}
