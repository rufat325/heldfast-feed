{
 "description": "Convert a PDF bank statement into transaction data. The PDF is uploaded over HTTPS to the Bank Statement Sheet API, where every extracted row is checked against the statement's own printed running balance. Returns the rows TOGETHER WITH a pass/fail verdict from that check.\n\nThe verdict is not advisory. When verdict.ledger_safe is false the transactions are withheld and MUST NOT be posted to a general ledger, accounting system, or voucher without a human reviewing them against the original PDF first.\n\nIf this tool declines a file, do not fall back to reading the PDF yourself and do not use another tool to extract the numbers. Figures taken without the balance check are exactly what this tool exists to prevent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bank": {
    "description": "Leave unset (auto-detect) unless the user names the bank. Auto-detection also covers banks with no dedicated parser.",
    "enum": [
     "auto",
     "handelsbanken",
     "nordea_se",
     "nordea_no",
     "nordea_dk",
     "seb",
     "swedbank",
     "lansforsakringar",
     "dnb",
     "sparebank1",
     "danske_bank",
     "jyske_bank",
     "generic"
    ],
    "type": "string"
   },
   "decimal_separator": {
    "description": "Pro only, applies to save_as. \"comma\" writes the European convention (semicolon-delimited, 1234,56) \u2014 the variant Swedish and other European accounting importers take without warnings.",
    "enum": [
     "period",
     "comma"
    ],
    "type": "string"
   },
   "file_path": {
    "description": "Absolute path to a PDF bank statement on this machine. Required unless use_demo_statement is true.",
    "type": "string"
   },
   "include_unverified_rows": {
    "description": "Only set true after a previous call returned ledger_safe: false AND you have told the user the data failed reconciliation.",
    "type": "boolean"
   },
   "order": {
    "description": "chronological = oldest first (what ledger imports expect, the default). statement = the order the bank printed.",
    "enum": [
     "chronological",
     "statement"
    ],
    "type": "string"
   },
   "output_dir": {
    "description": "Where to write save_as files. Defaults to the folder holding the input PDF.",
    "type": "string"
   },
   "save_as": {
    "description": "Also write files to disk. xlsx and csv are free; fortnox, ofx and json need a Pro API key.",
    "items": {
     "enum": [
      "xlsx",
      "csv",
      "fortnox",
      "ofx",
      "json"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "use_demo_statement": {
    "description": "Convert the hosted synthetic sample instead of a user file. Costs no quota and contains no real data \u2014 use this to demonstrate the tool.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "convert_bank_statement",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "conversion": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "ttl_seconds": {
      "type": "number"
     }
    },
    "required": [
     "id",
     "ttl_seconds"
    ],
    "type": "object"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bytes": {
       "type": "number"
      },
      "format": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "unverified": {
       "type": "boolean"
      }
     },
     "required": [
      "format",
      "path",
      "bytes",
      "unverified"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "bank_detected": {
      "type": [
       "string",
       "null"
      ]
     },
     "bytes": {
      "type": "number"
     },
     "detection_confidence": {
      "type": [
       "number",
       "null"
      ]
     },
     "file_name": {
      "type": "string"
     },
     "is_demo_statement": {
      "type": "boolean"
     },
     "pages": {
      "type": [
       "number",
       "null"
      ]
     },
     "sha256": {
      "type": "string"
     }
    },
    "required": [
     "file_name",
     "sha256",
     "bytes",
     "pages",
     "bank_detected",
     "detection_confidence",
     "is_demo_statement"
    ],
    "type": "object"
   },
   "totals": {
    "additionalProperties": false,
    "properties": {
     "count": {
      "type": "number"
     },
     "credits": {
      "type": "number"
     },
     "currency": {
      "type": [
       "string",
       "null"
      ]
     },
     "debits": {
      "type": "number"
     },
     "net": {
      "type": "number"
     }
    },
    "required": [
     "credits",
     "debits",
     "net",
     "count",
     "currency"
    ],
    "type": "object"
   },
   "transactions": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "type": "number"
        },
        "balance": {
         "type": [
          "number",
          "null"
         ]
        },
        "currency": {
         "type": [
          "string",
          "null"
         ]
        },
        "date": {
         "type": [
          "string",
          "null"
         ]
        },
        "description": {
         "type": [
          "string",
          "null"
         ]
        },
        "row_index": {
         "type": "number"
        },
        "verified": {
         "type": "boolean"
        }
       },
       "required": [
        "row_index",
        "date",
        "description",
        "amount",
        "currency",
        "balance",
        "verified"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "null when the gate failed and the rows were withheld."
   },
   "transactions_withheld": {
    "type": "boolean"
   },
   "verdict": {
    "additionalProperties": false,
    "description": "The reconciliation result. Read ledger_safe before doing anything with the rows.",
    "properties": {
     "agent_directive": {
      "type": "string"
     },
     "checks_passed": {
      "type": [
       "number",
       "null"
      ]
     },
     "checks_total": {
      "type": [
       "number",
       "null"
      ]
     },
     "extraction_method": {
      "type": "string"
     },
     "ledger_safe": {
      "type": "boolean"
     },
     "method": {
      "type": "string"
     },
     "score": {
      "type": [
       "number",
       "null"
      ]
     },
     "statement": {
      "type": "string"
     },
     "status": {
      "enum": [
       "verified",
       "unverified"
      ],
      "type": "string"
     },
     "threshold": {
      "type": "number"
     }
    },
    "required": [
     "status",
     "ledger_safe",
     "checks_passed",
     "checks_total",
     "score",
     "threshold",
     "method",
     "extraction_method",
     "statement",
     "agent_directive"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "withheld_reason": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "verdict",
   "transactions",
   "transactions_withheld",
   "withheld_reason",
   "totals",
   "source",
   "conversion",
   "files",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Convert a bank statement PDF to verified transactions"
}
