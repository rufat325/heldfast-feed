{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "After the human explicitly agrees to pay $49, create the bounded capital-research case and secure Polar checkout. Checkout creation is not payment proof.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "business_summary": {
    "maxLength": 12000,
    "type": "string"
   },
   "capital_goal": {
    "minimum": 0,
    "type": "number"
   },
   "capital_purpose": {
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "capital_type_preference": {
    "enum": [
     "best_fit",
     "debt",
     "sba",
     "equipment_project",
     "strategic",
     "equity"
    ],
    "type": "string"
   },
   "collateral_context": {
    "maxLength": 5000,
    "type": "string"
   },
   "company_name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "contact_email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "contact_name": {
    "maxLength": 200,
    "type": "string"
   },
   "existing_pitch": {
    "maxLength": 20000,
    "type": "string"
   },
   "profit_context": {
    "maxLength": 5000,
    "type": "string"
   },
   "request_id": {
    "maxLength": 240,
    "type": "string"
   },
   "revenue_context": {
    "maxLength": 5000,
    "type": "string"
   },
   "timeline": {
    "maxLength": 1000,
    "type": "string"
   },
   "user_confirmed_payment": {
    "const": true,
    "type": "boolean"
   },
   "website_url": {
    "maxLength": 1000,
    "type": "string"
   }
  },
  "required": [
   "user_confirmed_payment",
   "company_name",
   "contact_email",
   "capital_purpose"
  ],
  "type": "object"
 },
 "name": "prepare_capital_fit_checkout",
 "title": "Prepare a human-confirmed Capital Fit Sprint checkout"
}
