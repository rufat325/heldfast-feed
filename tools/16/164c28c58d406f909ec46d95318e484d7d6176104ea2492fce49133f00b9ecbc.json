{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find channel by name"
 },
 "description": "Find channels whose name contains a substring (case-insensitive). Returns matching channels (id, name, type) as a JSON array. Read-only. Useful for resolving a channel_id when you only know the channel's name.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "guild_id": {
    "description": "Discord server (guild) ID (snowflake).",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "name": {
    "description": "Case-insensitive substring to match against channel names.",
    "type": "string"
   }
  },
  "required": [
   "guild_id",
   "name"
  ],
  "type": "object"
 },
 "name": "discord_find_channel_by_name",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "matches"
  ],
  "type": "object"
 }
}
