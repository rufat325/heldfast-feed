{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Screen a generator outlet, destination, and cord distance for direct compatibility, adapter needs, verification boundaries, or unsafe paths.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "distanceFeet": {
    "anyOf": [
     {
      "const": 25,
      "type": "number"
     },
     {
      "const": 50,
      "type": "number"
     },
     {
      "const": 100,
      "type": "number"
     }
    ],
    "description": "Planned cord distance in feet"
   },
   "sourceConnectorId": {
    "description": "Generator receptacle family",
    "enum": [
     "520",
     "1450",
     "l1430",
     "l1420",
     "l630",
     "l530",
     "cs50",
     "tt30"
    ],
    "type": "string"
   },
   "targetId": {
    "description": "Intended destination",
    "enum": [
     "inlet",
     "rv",
     "appliance",
     "distribution"
    ],
    "type": "string"
   }
  },
  "required": [
   "sourceConnectorId",
   "targetId",
   "distanceFeet"
  ],
  "type": "object"
 },
 "name": "get_connector_compatibility",
 "title": "Check Generator Connector Compatibility"
}
