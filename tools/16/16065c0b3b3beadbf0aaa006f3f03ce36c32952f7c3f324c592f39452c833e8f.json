{
 "description": "Create a new multi-channel outreach sequence for a campaign. Returns the sequence id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaign_id": {
    "description": "Campaign (tap_projects) id",
    "format": "uuid",
    "type": "string"
   },
   "steps": {
    "description": "Ordered list of sequence steps",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "follow",
        "like",
        "comment",
        "dm",
        "email",
        "portal_submit",
        "connect",
        "mail"
       ],
       "type": "string"
      },
      "approvalRequired": {
       "type": "boolean"
      },
      "channel": {
       "enum": [
        "email",
        "instagram",
        "linkedin",
        "portal",
        "physical"
       ],
       "type": "string"
      },
      "day": {
       "type": "integer"
      },
      "description": {
       "type": "string"
      }
     },
     "required": [
      "day",
      "channel",
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "template_name": {
    "description": "Human-readable template name",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "campaign_id",
   "template_name",
   "steps"
  ],
  "type": "object"
 },
 "name": "tap_create_sequence"
}
