{
 "annotations": {
  "readOnlyHint": true,
  "title": "Read one FHIR resource"
 },
 "description": "Fetch a single FHIR resource by type and id. Canvas: GET /{resource}/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "The resource's id.",
    "type": "string"
   },
   "resource": {
    "description": "Which FHIR resource type to read.",
    "enum": [
     "Patient",
     "Appointment",
     "Condition",
     "Observation",
     "MedicationRequest",
     "MedicationStatement",
     "MedicationDispense",
     "AllergyIntolerance",
     "Immunization",
     "Encounter",
     "DocumentReference",
     "DiagnosticReport",
     "Procedure",
     "CarePlan",
     "CareTeam",
     "Goal",
     "Coverage",
     "Claim",
     "Practitioner",
     "Organization",
     "Location",
     "Schedule",
     "Slot",
     "Task",
     "ServiceRequest",
     "Questionnaire",
     "QuestionnaireResponse",
     "Consent",
     "Device",
     "Specimen",
     "RelatedPerson",
     "Communication",
     "DetectedIssue",
     "Provenance",
     "Media",
     "Group"
    ],
    "type": "string"
   }
  },
  "required": [
   "resource",
   "id"
  ],
  "type": "object"
 },
 "name": "canvas_read",
 "title": "Read one FHIR resource"
}
