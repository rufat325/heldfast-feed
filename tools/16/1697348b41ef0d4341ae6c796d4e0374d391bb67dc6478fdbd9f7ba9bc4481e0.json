{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "After the human explicitly agrees to pay for a selected EventWave promotion package, prepare the secure checkout. Checkout creation is not payment proof and source review still controls public placement.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "buyer_note": {
    "maxLength": 1200,
    "type": "string"
   },
   "city": {
    "maxLength": 160,
    "type": "string"
   },
   "contact_email": {
    "format": "email",
    "maxLength": 254,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "event_title": {
    "maxLength": 240,
    "type": "string"
   },
   "offer_key": {
    "enum": [
     "event_boost_49",
     "venue_pack_149"
    ],
    "type": "string"
   },
   "organizer_name": {
    "maxLength": 160,
    "type": "string"
   },
   "target_event_id": {
    "maxLength": 120,
    "type": "string"
   },
   "target_url": {
    "maxLength": 1000,
    "type": "string"
   },
   "user_confirmed_payment": {
    "const": true,
    "type": "boolean"
   },
   "venue_name": {
    "maxLength": 220,
    "type": "string"
   }
  },
  "required": [
   "user_confirmed_payment",
   "offer_key",
   "contact_email"
  ],
  "type": "object"
 },
 "name": "prepare_event_promotion_checkout",
 "title": "Prepare a human-confirmed EventWave promotion checkout"
}
