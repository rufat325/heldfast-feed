{
 "description": "Generate SVG or PNG mockup images of UI screens and components. Supports wireframe, mockup, and component preview modes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brand_identity": {
    "description": "JSON string from branding-mcp generate_brand_identity. Overrides design context with brand tokens.",
    "type": "string"
   },
   "description": {
    "description": "What to render in the image (e.g., \"Landing page with hero section and CTA\")",
    "type": "string"
   },
   "design_context": {
    "description": "Optional design context override",
    "properties": {
     "borderRadius": {},
     "colorPalette": {},
     "shadows": {},
     "spacing": {},
     "typography": {}
    },
    "type": "object"
   },
   "height": {
    "default": 800,
    "description": "Image height in pixels",
    "maximum": 4096,
    "minimum": 100,
    "type": "integer"
   },
   "output_format": {
    "default": "svg",
    "description": "Output image format",
    "enum": [
     "svg",
     "png"
    ],
    "type": "string"
   },
   "type": {
    "description": "Type of image to generate",
    "enum": [
     "wireframe",
     "mockup",
     "component_preview"
    ],
    "type": "string"
   },
   "width": {
    "default": 1200,
    "description": "Image width in pixels",
    "maximum": 4096,
    "minimum": 100,
    "type": "integer"
   }
  },
  "required": [
   "description",
   "type"
  ],
  "type": "object"
 },
 "name": "generate_design_image"
}
