{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Calculate the mileage allowance"
 },
 "description": "Calculate the tax-free business mileage allowance for a year at HMRC's approved mileage rates for a car or van, motorcycle or bicycle, including the passenger rate, and the tax it saves at the basic or higher rate.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "annualBusinessMiles": {
    "description": "Business miles in the year",
    "maximum": 500000,
    "minimum": 0,
    "type": "number"
   },
   "averageMilesPerPassengerTrip": {
    "maximum": 1000,
    "minimum": 0,
    "type": "number"
   },
   "passengerTrips": {
    "description": "Business trips with a passenger",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "taxBand": {
    "description": "Income tax band, for the saving; defaults to basic",
    "enum": [
     "basic",
     "higher"
    ],
    "type": "string"
   },
   "vehicleType": {
    "description": "Defaults to car (cars and vans)",
    "enum": [
     "car",
     "motorcycle",
     "bicycle"
    ],
    "type": "string"
   }
  },
  "required": [
   "annualBusinessMiles"
  ],
  "type": "object"
 },
 "name": "calculate_mileage_allowance",
 "title": "Calculate the mileage allowance"
}
