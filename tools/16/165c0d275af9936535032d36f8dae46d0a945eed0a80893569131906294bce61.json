{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read and export paginated admission audit for privileged operations on this account. Resource-confined credentials only see events on their permitted services/deployments. No arguments, command output, secrets or caller IPs. Fixed retention per class; acceptance does not certify host completion. Requires read scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "before": {
    "pattern": "^aud_[a-f0-9]{32}$",
    "type": "string"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "impreza_privileged_audit",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "events": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "actor_id": {
         "type": [
          "integer",
          "null"
         ]
        },
        "actor_type": {
         "type": "string"
        },
        "approval_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "client_id": {
         "type": "integer"
        },
        "created_at": {
         "type": "string"
        },
        "event_id": {
         "type": "string"
        },
        "finished_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "plan_digest": {
         "type": [
          "string",
          "null"
         ]
        },
        "plan_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "provider_ref": {
         "type": [
          "string",
          "null"
         ]
        },
        "result": {
         "type": "string"
        },
        "retention_class": {
         "type": "string"
        },
        "started_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "surface": {
         "type": "string"
        },
        "target_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "target_kind": {
         "type": [
          "string",
          "null"
         ]
        },
        "verb": {
         "type": "string"
        }
       },
       "required": [
        "event_id",
        "actor_type",
        "surface",
        "verb",
        "created_at",
        "result",
        "retention_class",
        "client_id",
        "actor_id",
        "target_kind",
        "target_id",
        "plan_id",
        "plan_digest",
        "approval_id",
        "started_at",
        "finished_at",
        "provider_ref"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "next_cursor": {
      "type": [
       "string",
       "null"
      ]
     },
     "note": {
      "type": "string"
     },
     "retention_days": {
      "additionalProperties": false,
      "properties": {
       "destructive": {
        "const": 90,
        "type": "integer"
       },
       "operational": {
        "const": 7,
        "type": "integer"
       },
       "refusal": {
        "const": 7,
        "type": "integer"
       },
       "security": {
        "const": 30,
        "type": "integer"
       }
      },
      "required": [
       "operational",
       "security",
       "destructive",
       "refusal"
      ],
      "type": "object"
     },
     "state": {
      "enum": [
       "available",
       "migration_required"
      ],
      "type": "string"
     }
    },
    "required": [
     "events",
     "state",
     "next_cursor",
     "retention_days",
     "note"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Privileged operation audit"
}
