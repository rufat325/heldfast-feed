{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check which reporter/period/classification combinations have published data before constructing expensive trade queries. Returns dataset records with period, classification, record count, and publication date. Call this before querying recent periods \u2014 annual data is typically published 3\u201312 months after the reference year and not all countries report every year. Omit all parameters to browse the full availability index.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "classification": {
    "default": "HS",
    "description": "Classification code filter (e.g. \"HS\", \"H6\", \"EB10\").",
    "type": "string"
   },
   "freq": {
    "default": "A",
    "description": "Frequency: A=annual, M=monthly.",
    "enum": [
     "A",
     "M"
    ],
    "type": "string"
   },
   "period": {
    "description": "Period to check: YYYY (annual) or YYYYMM (monthly). Omit to see all available periods for the reporter.",
    "type": "string"
   },
   "reporter_code": {
    "description": "M49 reporter code to check. Omit to browse availability across all reporters.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "type_code": {
    "default": "C",
    "description": "Trade type: C=commodities (goods), S=services.",
    "enum": [
     "C",
     "S"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "comtrade_get_data_availability",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "datasets",
     "totalDatasets"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "datasets": {
    "description": "Available datasets matching the query.",
    "items": {
     "additionalProperties": false,
     "description": "A single data availability record.",
     "properties": {
      "classificationCode": {
       "description": "Classification code.",
       "type": "string"
      },
      "freqCode": {
       "description": "Frequency: A or M.",
       "type": "string"
      },
      "period": {
       "description": "Period (YYYY or YYYYMM).",
       "type": "string"
      },
      "publicationDate": {
       "description": "Date when this dataset was published by UN Comtrade.",
       "type": "string"
      },
      "reporterCode": {
       "description": "M49 reporter code.",
       "type": "number"
      },
      "reporterDesc": {
       "description": "Reporter country name.",
       "type": "string"
      },
      "totalRecords": {
       "description": "Number of records available in this dataset.",
       "type": "number"
      },
      "typeCode": {
       "description": "Trade type: C or S.",
       "type": "string"
      }
     },
     "required": [
      "reporterCode",
      "reporterDesc",
      "period",
      "freqCode",
      "classificationCode",
      "typeCode"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode.",
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "notice": {
    "description": "Recovery hint when no availability records are found.",
    "type": "string"
   },
   "totalDatasets": {
    "description": "Total number of available dataset records.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Check Data Availability"
}
