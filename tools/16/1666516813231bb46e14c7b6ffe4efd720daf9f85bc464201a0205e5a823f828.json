{
 "description": "Return the most recent SEC filings (10-K, 10-Q, 8-K) with AI analysis and 30-day alpha predictions. Optionally filter by ticker and/or form type.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "filing_type": {
    "description": "SEC form type",
    "enum": [
     "10-K",
     "10-Q",
     "8-K",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max filings to return",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "ticker": {
    "description": "Stock ticker, e.g. \"AAPL\"",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_latest_filings",
 "title": "Get latest SEC filings"
}
