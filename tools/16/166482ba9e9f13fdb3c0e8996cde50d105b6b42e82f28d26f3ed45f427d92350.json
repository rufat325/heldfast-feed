 "description": "Returns the orderable lunch menu for the user's active school - item names, prices, dietary tags, and remaining quantity - for one date or a full month (today if neither is given). The menu_item_id values returned are required by order_lunch and create_draft_order. For orders already placed, use get_orders.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "date": {
    "description": "Single day to show, YYYY-MM-DD",
    "type": "string"
   },
   "month": {
    "description": "Calendar month to show, YYYY-MM",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_menu",
 "outputSchema": {
  "properties": {
   "date": {
    "description": "Date this menu applies to, YYYY-MM-DD",
    "type": "string"
   },
   "menuItems": {
    "description": "Items orderable on that date",
    "items": {
     "properties": {
      "availableQty": {
       "description": "Remaining portions; null means unlimited",
       "type": [
        "integer",
        "null"
       ]
      },
      "dailyMenuId": {
       "description": "Daily-menu entry ID",
       "type": "string"
      },
      "dietaryTags": {
       "description": "Dietary labels (e.g. vegetarian, halal)",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "menuItemId": {
       "description": "Menu item ID for ordering tools",
       "type": "string"
      },
      "menuItemName": {
       "description": "Item display name",
       "type": "string"
      },
      "priceCents": {
       "description": "Sale price in cents",
       "type": "integer"
      },
      "restaurantName": {
       "description": "Restaurant offering the item",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Get Menu"
}
