{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only: resolve compact TouchDesigner operator, Python API, or concept documentation from the installed OfflineHelp corpus first, then the embedded KB. Returns section ids for bounded drill-down plus installed/running build provenance. Web fallback is off by default and, when explicitly enabled, is restricted to docs.derivative.ca and labeled as latest-web rather than installed-build truth. Never accepts a filesystem path or returns raw HTML.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "kind": {
    "default": "auto",
    "description": "Documentation kind: auto, operator, python, or concept.",
    "enum": [
     "auto",
     "operator",
     "python",
     "concept"
    ],
    "type": "string"
   },
   "max_chars": {
    "default": 6000,
    "description": "Maximum returned documentation body characters (1000-12000).",
    "maximum": 12000,
    "minimum": 1000,
    "type": "integer"
   },
   "query": {
    "description": "Operator type, Python class/page id, or concept text; never a filesystem path.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "section": {
    "description": "Stable heading id or an exact unique section title from sections_available.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "default": "auto",
    "description": "Source policy: installed, embedded, web, or local-first auto.",
    "enum": [
     "auto",
     "installed",
     "embedded",
     "web"
    ],
    "type": "string"
   },
   "web_fallback": {
    "default": false,
    "description": "Allow auto mode to try the Derivative web API when the server gate is enabled.",
    "type": "boolean"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "get_td_docs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "candidates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "operator",
        "python",
        "concept"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "kind"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "content": {
    "type": "string"
   },
   "content_chars": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "content_truncated": {
    "type": "boolean"
   },
   "kind_requested": {
    "enum": [
     "auto",
     "operator",
     "python",
     "concept"
    ],
    "type": "string"
   },
   "page": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "operator",
       "python",
       "concept"
      ],
      "type": "string"
     },
     "matched_by": {
      "enum": [
       "exact",
       "normalized",
       "derived_class",
       "search",
       "embedded"
      ],
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "kind",
     "matched_by"
    ],
    "type": "object"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "build_relation": {
      "enum": [
       "match",
       "mismatch",
       "unknown"
      ],
      "type": "string"
     },
     "cache": {
      "enum": [
       "hit",
       "miss",
       "not_applicable"
      ],
      "type": "string"
     },
     "installed_corpus_build": {
      "type": "string"
     },
     "running_td_build": {
      "type": "string"
     },
     "source": {
      "enum": [
       "installed-offline",
       "embedded",
       "web"
      ],
      "type": "string"
     },
     "source_path": {
      "type": "string"
     },
     "source_url": {
      "format": "uri",
      "type": "string"
     },
     "sources_attempted": {
      "items": {
       "enum": [
        "installed-offline",
        "embedded",
        "web"
       ],
       "type": "string"
      },
      "maxItems": 3,
      "type": "array"
     }
    },
    "required": [
     "build_relation",
     "cache",
     "sources_attempted"
    ],
    "type": "object"
   },
   "query": {
    "type": "string"
   },
   "sections_available": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "level": {
       "maximum": 6,
       "minimum": 1,
       "type": "integer"
      },
      "parent_id": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "level"
     ],
     "type": "object"
    },
    "maxItems": 80,
    "type": "array"
   },
   "sections_truncated": {
    "type": "boolean"
   },
   "selected_section": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "level": {
      "maximum": 6,
      "minimum": 1,
      "type": "integer"
     },
     "parent_id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "level"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "found",
     "not_found",
     "section_not_found",
     "source_unavailable"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "enum": [
        "running_build_unavailable",
        "corpus_build_unknown",
        "build_mismatch",
        "installed_docs_unavailable",
        "installed_page_missing",
        "embedded_fallback",
        "web_disabled",
        "web_latest_not_installed_build",
        "web_fetch_failed",
        "content_truncated",
        "sections_truncated"
       ],
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "status",
   "query",
   "kind_requested",
   "content_chars",
   "content_truncated",
   "sections_available",
   "sections_truncated",
   "candidates",
   "provenance",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Get build-aware TouchDesigner docs"
}
