{
 "description": "Search for AI tools using natural language with AI-powered semantic matching. Best for conceptual queries like 'something that automates my email workflow'. Supports structured filters to narrow results (e.g., openSource + deploymentModel). For exact name/keyword searches, use search_listings instead. For comparing specific tools, use compare_listings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autonomyLevel": {
    "description": "Filter by autonomy level",
    "enum": [
     "ASSISTED",
     "SEMI_AUTONOMOUS",
     "FULLY_AUTONOMOUS"
    ],
    "type": "string"
   },
   "category": {
    "description": "Filter by category slug",
    "type": "string"
   },
   "cohort": {
    "description": "Filter by cohort",
    "enum": [
     "PEOPLE",
     "TEAMS"
    ],
    "type": "string"
   },
   "deploymentModel": {
    "description": "Filter by deployment model",
    "enum": [
     "CLOUD",
     "ON_DEVICE",
     "SELF_HOSTED",
     "HYBRID"
    ],
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "Max results to return",
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "mcpSupport": {
    "description": "Filter by MCP (Model Context Protocol) support",
    "type": "boolean"
   },
   "minScore": {
    "description": "Minimum agenticness score (0-36)",
    "maximum": 36,
    "minimum": 0,
    "type": "number"
   },
   "openSource": {
    "description": "Filter by open source status (true/false)",
    "type": "boolean"
   },
   "query": {
    "description": "Natural language search query",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "semantic_search"
}
