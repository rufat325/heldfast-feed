      "properties": {
       "alias": {
        "type": "string"
       },
       "mail_hosting_id": {
        "type": "number"
       },
       "mailbox_name": {
        "type": "string"
       }
      },
      "required": [
       "mail_hosting_id",
       "mailbox_name",
       "alias"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
