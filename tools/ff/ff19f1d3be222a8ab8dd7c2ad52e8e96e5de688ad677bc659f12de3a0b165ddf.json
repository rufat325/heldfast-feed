    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-z0-9._-]+$",
    "type": "string"
   },
   "confirmation_token": {
    "format": "uuid",
    "type": "string"
   },
   "mail_hosting_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "mailbox_name": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "mail_hosting_id",
   "mailbox_name",
   "alias"
  ],
  "type": "object"
 },
 "name": "infomaniak_create_mailbox_alias",
 "outputSchema": {
  "anyOf": [
   {
