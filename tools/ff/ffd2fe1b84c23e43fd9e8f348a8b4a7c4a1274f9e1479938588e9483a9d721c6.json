{
 "description": "Read App Store customer reviews and your responses, filtered by rating or storefront. Reports the mean and star split of the reviews actually fetched, which is not the app's lifetime rating; App Store Connect exposes no aggregate rating resource. Read-only",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "appId": {
    "description": "App Store Connect numeric app id; provide this or bundleId",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "bundleId": {
    "description": "Bundle id; provide this or appId",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Maximum reviews to return across pages",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "maxPages": {
    "default": 5,
    "description": "Maximum pages to follow",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "rating": {
    "description": "Only these star ratings",
    "items": {
     "maximum": 5,
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 5,
    "type": "array"
   },
   "sort": {
    "default": "-createdDate",
    "description": "Sort order; newest first by default",
    "enum": [
     "-createdDate",
     "createdDate",
     "rating",
     "-rating"
    ],
    "type": "string"
   },
   "territory": {
    "description": "Only reviews from this storefront",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "app_store_reviews",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "type": "string"
   },
   "bundleId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "filters": {
    "additionalProperties": false,
    "properties": {
     "rating": {
      "anyOf": [
       {
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "sort": {
      "type": "string"
     },
     "territory": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "rating",
     "territory",
     "sort"
    ],
    "type": "object"
   },
   "histogramOfFetched": {
    "additionalProperties": {
     "type": "number"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "meanOfFetched": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pagesRead": {
    "type": "number"
   },
   "returned": {
    "type": "number"
   },
   "reviews": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "createdDate": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "string"
      },
      "rating": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "respondedAt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "responseBody": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "reviewerNickname": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "territory": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "rating",
      "title",
      "body",
      "reviewerNickname",
      "createdDate",
      "territory",
      "respondedAt",
      "responseBody"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "withoutResponse": {
    "type": "number"
   }
  },
  "required": [
   "appId",
   "bundleId",
   "returned",
   "pagesRead",
   "meanOfFetched",
   "histogramOfFetched",
   "withoutResponse",
   "filters",
   "reviews",
   "notes"
  ],
  "type": "object"
 }
}
