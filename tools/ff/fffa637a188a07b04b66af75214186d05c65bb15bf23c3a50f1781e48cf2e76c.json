{
 "description": "Edit an event. Set is_cancelled=true to cancel (preserves history). Set max_attendees=null to lift the cap.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cover_image_url": {
    "format": "uri",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "description_format": {
    "enum": [
     "markdown",
     "tiptap_json"
    ],
    "type": "string"
   },
   "description_json": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "end_date": {
    "type": "string"
   },
   "event_type": {
    "enum": [
     "virtual",
     "in-person",
     "hybrid"
    ],
    "type": "string"
   },
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "is_cancelled": {
    "type": "boolean"
   },
   "location": {
    "type": "string"
   },
   "max_attendees": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "meeting_url": {
    "format": "uri",
    "type": "string"
   },
   "start_date": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timezone": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "hivelearn_update_event"
}
