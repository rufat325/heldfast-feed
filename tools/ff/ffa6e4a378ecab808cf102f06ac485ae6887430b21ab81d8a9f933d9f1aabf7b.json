{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "UCP Catalog product detail by product or variant id. Reads variants, price and availability live from the merchant KaliCart Bridge within a short time budget; if the merchant does not answer in time the indexed snapshot is returned and marked as such. The product url is the merchant storefront where the purchase happens.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "catalog": {
    "additionalProperties": true,
    "properties": {
     "attribution": {
      "additionalProperties": {},
      "type": "object"
     },
     "context": {
      "additionalProperties": true,
      "properties": {
       "address_country": {
        "type": "string"
       },
       "address_region": {
        "type": "string"
       },
       "currency": {
        "type": "string"
       },
       "intent": {
        "type": "string"
       },
       "language": {
        "type": "string"
       },
       "postal_code": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "filters": {
      "additionalProperties": true,
      "properties": {
       "available": {
        "type": "boolean"
       },
       "brand": {
        "type": "string"
       },
       "categories": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "color": {
        "type": "string"
       },
       "gender": {
        "enum": [
         "female",
         "male",
         "unisex"
        ],
        "type": "string"
       },
       "price": {
        "additionalProperties": true,
        "properties": {
         "max": {
          "minimum": 0,
          "type": "integer"
         },
         "min": {
          "minimum": 0,
          "type": "integer"
         }
        },
        "type": "object"
       }
      },
      "type": "object"
     },
     "id": {
      "minLength": 1,
      "type": "string"
     },
     "preferences": {
      "type": "array"
     },
     "selected": {
      "type": "array"
     },
     "signals": {
      "additionalProperties": {},
      "type": "object"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   },
   "meta": {
    "additionalProperties": true,
    "properties": {
     "ucp-agent": {
      "additionalProperties": true,
      "properties": {
       "profile": {
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "catalog"
  ],
  "type": "object"
 },
 "name": "get_product",
 "title": "Get product detail with live price and availability (UCP Catalog)"
}
