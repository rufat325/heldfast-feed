{
 "description": "Fail-closed compatibility check for one firmware playbook. Required model, codename, revision, SoC or firmware identifiers must exactly match a curated target; missing facts return unknown and mismatches return unsupported.",
 "inputSchema": {
  "properties": {
   "observed": {
    "additionalProperties": false,
    "properties": {
     "codename": {
      "description": "Documented hardware codename, when available.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "firmware_version": {
      "description": "Installed vendor firmware version.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "hardware_revision": {
      "description": "Exact hardware or PCB revision.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "model_number": {
      "description": "Model number from the physical label, not the retail family name.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "sensor": {
      "description": "Confirmed image sensor or other sensor identifier.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "soc": {
      "description": "Confirmed SoC or module identifier.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "wifi_module": {
      "description": "Confirmed Wi-Fi or radio module identifier.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "playbook_id": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "playbook_id",
   "observed"
  ],
  "type": "object"
 },
 "name": "check_firmware_compatibility",
 "outputSchema": {
  "properties": {},
  "type": "object"
 },
 "title": "Check firmware compatibility"
}
