{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Estimate a swap. side \"from\" (default) quotes spending `amount`; side \"to\" quotes receiving `amount`. A quote is an estimate, not a funding instruction.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Human decimal amount, e.g. \"0.5\". Not atomic units.",
    "pattern": "^\\d+(\\.\\d+)?$",
    "type": "string"
   },
   "fromChainId": {
    "description": "Chain id from list_chains.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "fromToken": {
    "description": "Token address from search_tokens, or \"native\" for the chain coin.",
    "minLength": 1,
    "type": "string"
   },
   "side": {
    "enum": [
     "from",
     "to"
    ],
    "type": "string"
   },
   "toAddress": {
    "description": "Recipient address; improves the estimate.",
    "type": "string"
   },
   "toChainId": {
    "description": "Chain id from list_chains.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "toToken": {
    "description": "Token address from search_tokens, or \"native\" for the chain coin.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "fromChainId",
   "fromToken",
   "toChainId",
   "toToken",
   "amount"
  ],
  "type": "object"
 },
 "name": "get_quote",
 "title": "Quote a swap"
}
