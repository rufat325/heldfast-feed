{
 "description": "List campaigns in the workspace, optionally filtered by status",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results (default 50)",
    "type": "number"
   },
   "status": {
    "enum": [
     "draft",
     "active",
     "paused",
     "completed",
     "archived"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tap_list_campaigns"
}
