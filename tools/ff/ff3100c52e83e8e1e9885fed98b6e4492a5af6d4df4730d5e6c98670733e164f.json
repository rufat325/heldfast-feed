{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a job"
 },
 "description": "WRITE: update fields on an existing job \u2014 status/sub-status, reschedule (JobDateTime/JobEndDateTime), contact, address, type, source, notes, tags. Only the fields you pass are sent. Workiz: POST /job/update/.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "Address": {
    "description": "Street address, e.g. 123 W Main Street.",
    "type": "string"
   },
   "City": {
    "description": "City.",
    "type": "string"
   },
   "ClientId": {
    "description": "Existing Workiz client id to attach this to.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "Company": {
    "description": "Client company name.",
    "type": "string"
   },
   "Country": {
    "description": "Country code, e.g. US.",
    "type": "string"
   },
   "CreatedBy": {
    "description": "Name recorded as the creator.",
    "type": "string"
   },
   "Email": {
    "description": "Client email.",
    "type": "string"
   },
   "FirstName": {
    "description": "Client first name.",
    "type": "string"
   },
   "JobDateTime": {
    "description": "New scheduled start. Date-time string, e.g. 2026-10-01T09:00:00.000Z.",
    "type": "string"
   },
   "JobEndDateTime": {
    "description": "New scheduled end. Date-time string, e.g. 2026-10-01T09:00:00.000Z.",
    "type": "string"
   },
   "JobNotes": {
    "description": "Internal job notes.",
    "type": "string"
   },
   "JobSource": {
    "description": "Lead/job source, e.g. Google.",
    "type": "string"
   },
   "JobType": {
    "description": "Job type, e.g. Repair.",
    "type": "string"
   },
   "LastName": {
    "description": "Client last name.",
    "type": "string"
   },
   "Phone": {
    "description": "Primary phone, digits only, e.g. 6195555555.",
    "type": "string"
   },
   "PhoneExt": {
    "description": "Primary phone extension.",
    "type": "string"
   },
   "PostalCode": {
    "description": "Postal / ZIP code.",
    "type": "string"
   },
   "SecondPhone": {
    "description": "Secondary phone.",
    "type": "string"
   },
   "SecondPhoneExt": {
    "description": "Secondary phone extension.",
    "type": "string"
   },
   "ServiceArea": {
    "description": "Service area, e.g. metro1.",
    "type": "string"
   },
   "State": {
    "description": "State, e.g. CA.",
    "type": "string"
   },
   "Status": {
    "description": "New job status, e.g. \"In progress\".",
    "type": "string"
   },
   "SubStatus": {
    "description": "New job sub-status.",
    "type": "string"
   },
   "Tags": {
    "description": "Job tags, e.g. [\"estimate\", \"callback\"].",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "Timezone": {
    "description": "Timezone, e.g. US/Pacific.",
    "type": "string"
   },
   "UUID": {
    "description": "The job's UUID (e.g. XYZ56X).",
    "minLength": 1,
    "type": "string"
   },
   "Unit": {
    "description": "Unit / apartment.",
    "type": "string"
   }
  },
  "required": [
   "UUID"
  ],
  "type": "object"
 },
 "name": "workiz_update_job",
 "title": "Update a job"
}
