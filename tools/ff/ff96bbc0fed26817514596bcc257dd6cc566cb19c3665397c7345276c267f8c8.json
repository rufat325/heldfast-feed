{
 "description": "Create a PSE bank-debit payment (POST /restpagos/pagos/debitos.json on secure.payco.co). Returns a bank redirect URL the payer must open to authorize the debit.",
 "inputSchema": {
  "properties": {
   "bank": {
    "description": "PSE bank code from list_pse_banks",
    "type": "string"
   },
   "cell_phone": {
    "description": "Payer mobile phone",
    "type": "string"
   },
   "currency": {
    "description": "Currency (default COP)",
    "type": "string"
   },
   "description": {
    "description": "Payment description",
    "type": "string"
   },
   "doc_number": {
    "description": "Payer document number",
    "type": "string"
   },
   "doc_type": {
    "description": "Payer document type: CC, CE, NIT, ...",
    "type": "string"
   },
   "email": {
    "description": "Payer email",
    "type": "string"
   },
   "invoice": {
    "description": "Merchant invoice/order reference",
    "type": "string"
   },
   "ip": {
    "description": "Payer IP address (PSE requirement)",
    "type": "string"
   },
   "last_name": {
    "description": "Payer last name",
    "type": "string"
   },
   "name": {
    "description": "Payer first name",
    "type": "string"
   },
   "tax": {
    "description": "Tax portion (default \"0\")",
    "type": "string"
   },
   "tax_base": {
    "description": "Taxable base",
    "type": "string"
   },
   "type_person": {
    "description": "0 = natural person, 1 = company",
    "type": "string"
   },
   "url_confirmation": {
    "description": "Server-to-server confirmation webhook URL",
    "type": "string"
   },
   "url_response": {
    "description": "URL the payer returns to after the bank flow",
    "type": "string"
   },
   "value": {
    "description": "Amount (string)",
    "type": "string"
   }
  },
  "required": [
   "bank",
   "invoice",
   "description",
   "value",
   "doc_type",
   "doc_number",
   "name",
   "email",
   "cell_phone",
   "ip"
  ],
  "type": "object"
 },
 "name": "create_pse_payment"
}
