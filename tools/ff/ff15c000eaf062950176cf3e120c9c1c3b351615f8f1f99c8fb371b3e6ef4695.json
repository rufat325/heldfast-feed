{
 "description": "Declare an intent to perform an action. First step of the 3-signature chain.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "action_type": {
    "description": "What type of action (e.g. 'web_search', 'commerce:checkout')",
    "type": "string"
   },
   "context": {
    "description": "Why the agent wants to do this",
    "type": "string"
   },
   "delegation_id": {
    "description": "Delegation ID authorizing this action",
    "type": "string"
   },
   "scope_required": {
    "description": "Which delegation scope is needed",
    "type": "string"
   },
   "spend_amount": {
    "description": "Expected spend amount",
    "type": "number"
   },
   "spend_currency": {
    "description": "Spend currency (e.g. 'usd')",
    "type": "string"
   },
   "target": {
    "description": "What the action operates on",
    "type": "string"
   }
  },
  "required": [
   "action_type",
   "target",
   "scope_required",
   "delegation_id"
  ],
  "type": "object"
 },
 "name": "create_intent"
}
