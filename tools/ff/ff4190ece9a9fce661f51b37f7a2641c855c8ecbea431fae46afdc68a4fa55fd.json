{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Lists a site's members with their entitlement history. Read-only \u2014 WiseWall never lets an owner mutate a member's account directly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "site_id": {
    "description": "The site's id, from list_sites or create_site.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "site_id"
  ],
  "type": "object"
 },
 "name": "list_members",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "members": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "createdAt": {
       "type": "number"
      },
      "email": {
       "type": "string"
      },
      "entitlements": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "currentPeriodEnd": {
          "type": [
           "number",
           "null"
          ]
         },
         "planName": {
          "type": "string"
         },
         "status": {
          "enum": [
           "active",
           "past_due",
           "canceled"
          ],
          "type": "string"
         }
        },
        "required": [
         "planName",
         "status",
         "currentPeriodEnd"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "email",
      "createdAt",
      "entitlements"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "members"
  ],
  "type": "object"
 },
 "title": "List members"
}
