{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Code-Fundi Search"
 },
 "description": "Search across indexed Code-Fundi repositories using semantic search, grep over docs, or grep over code. Returns matching files with similarity scores, paths, and optional documentation. Use scan_mode to choose between semantic (vector), grep_docs (substring on documentation), or grep_code (substring on source code).",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dependencies": {
    "description": "Filter by declared dependencies in code summaries",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "fields": {
    "description": "Documentation detail level per result (default: full).",
    "enum": [
     "basic",
     "summary",
     "full"
    ],
    "type": "string"
   },
   "file_paths": {
    "description": "Filter by file path patterns",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "file_types": {
    "description": "Filter by file extensions (e.g. ['.ts', '.py'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "function_names": {
    "description": "Filter by function names in code summaries",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "has_functions": {
    "description": "Only return files that define functions",
    "type": "boolean"
   },
   "max_lines": {
    "description": "Maximum file line count",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "min_lines": {
    "description": "Minimum file line count",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "The search query string",
    "type": "string"
   },
   "repo_ids": {
    "description": "Filter by repository UUIDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "repo_urls": {
    "description": "Filter by repository clone URLs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "scan_mode": {
    "description": "Search mode (default: semantic)",
    "enum": [
     "semantic",
     "grep_docs",
     "grep_code"
    ],
    "type": "string"
   },
   "scope": {
    "description": "Search scope (default: all)",
    "enum": [
     "all",
     "repos",
     "files",
     "code",
     "functions"
    ],
    "type": "string"
   },
   "similarity_threshold": {
    "description": "Minimum similarity score (0-1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "visibility": {
    "description": "Repository visibility filter",
    "enum": [
     "private",
     "public",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "code-fundi-search"
}
