      "id",
      "primary",
      "position",
      "contents",
      "images"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "description": "The query string that was sent to Wolfram Alpha",
    "type": "string"
   },
   "success": {
