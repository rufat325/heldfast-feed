{
 "annotations": {
  "destructiveHint": true,
  "title": "Add source string"
 },
 "description": "Adds a source string to a file in a Crowdin project (additive). Crowdin API: POST /projects/{projectId}/strings.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "context": {
    "description": "Optional context shown to translators.",
    "type": "string"
   },
   "fileId": {
    "description": "Id of the source file to add the string to.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "identifier": {
    "description": "Optional unique string identifier / key.",
    "type": "string"
   },
   "isHidden": {
    "description": "Hide the string from translators.",
    "type": "boolean"
   },
   "maxLength": {
    "description": "Max allowed translation length.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "projectId": {
    "description": "Numeric project id (path).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "text": {
    "description": "The source string text.",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "text",
   "fileId"
  ],
  "type": "object"
 },
 "name": "crowdin_add_string",
 "title": "Add source string"
}
