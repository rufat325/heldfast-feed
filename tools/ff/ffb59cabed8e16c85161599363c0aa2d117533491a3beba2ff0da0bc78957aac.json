{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Arr\u00eate une VM KVM proprement (ou force l'arr\u00eat avec --force) \u26a0\ufe0f ATTENTION: Op\u00e9ration potentiellement destructive!",
 "inputSchema": {
  "properties": {
   "force": {
    "default": false,
    "type": "boolean"
   },
   "timeout": {
    "default": 60,
    "maximum": 300,
    "minimum": 10,
    "type": "number"
   },
   "vm_name": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
    "type": "string"
   },
   "wait": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "vm_name"
  ],
  "type": "object"
 },
 "name": "vm_stop"
}
