{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true,
  "title": "Batch Job Results"
 },
 "description": "List result rows for a Batch job (cursor-paginated server-side; returns the full list).\n\nEach row may include task_id, external_id, status, and a short-lived result_url for the body.\nDownload result_url soon \u2014 presigned links expire.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "job_id": {
    "description": "Batch job id",
    "type": "string"
   },
   "status": {
    "anyOf": [
     {
      "enum": [
       "successful",
       "failed",
       "all"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Filter results by status (default: all)"
   }
  },
  "required": [
   "job_id"
  ],
  "type": "object"
 },
 "name": "batch_results"
}
