{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Generate a self-contained native .drawio architecture with selectable theme, real SVGs, deterministic layout, animated colour-coded datapaths, and editable objects.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "edges": {
    "default": [],
    "items": {
     "properties": {
      "animated": {
       "default": true,
       "type": "boolean"
      },
      "color": {
       "pattern": "^#[0-9A-Fa-f]{6}$",
       "type": "string"
      },
      "flow": {
       "default": "request",
       "enum": [
        "request",
        "realtime",
        "batch",
        "feedback",
        "monitoring",
        "dependency"
       ],
       "type": "string"
      },
      "flowDirection": {
       "default": "normal",
       "enum": [
        "normal",
        "reverse",
        "alternate",
        "alternate-reverse"
       ],
       "type": "string"
      },
      "flowDuration": {
       "default": 700,
       "maximum": 10000,
       "minimum": 100,
       "type": "integer"
      },
      "flowTiming": {
       "default": "linear",
       "enum": [
        "linear",
        "ease",
        "ease-in",
        "ease-out",
        "ease-in-out"
       ],
       "type": "string"
      },
      "id": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
       "type": "string"
      },
      "label": {
       "default": "",
       "maxLength": 120,
       "type": "string"
      },
      "pattern": {
       "default": "dashed",
       "enum": [
        "solid",
        "dashed",
        "dotted"
       ],
       "type": "string"
      },
      "source": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
       "type": "string"
      },
      "target": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
       "type": "string"
      }
     },
     "required": [
      "id",
      "source",
      "target"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "groups": {
    "default": [],
    "items": {
     "properties": {
      "id": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
       "type": "string"
      },
      "label": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "subtitle": {
       "maxLength": 160,
       "type": "string"
      }
     },
     "required": [
      "id",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "layout": {
    "enum": [
     "horizontal",
     "vertical",
     "edge-cloud",
     "hub-spoke",
     "pipeline"
    ],
    "type": "string"
   },
   "nodes": {
    "items": {
     "properties": {
      "asset": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "category": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "groupId": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
       "type": "string"
      },
      "id": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
       "type": "string"
      },
      "label": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "provider": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "subtitle": {
       "maxLength": 160,
       "type": "string"
      }
     },
     "required": [
      "id",
      "label",
      "asset"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "onlineAssets": {
    "default": false,
    "type": "boolean"
   },
   "outputFile": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.drawio$",
    "type": "string"
   },
   "overwrite": {
    "default": false,
    "type": "boolean"
   },
   "theme": {
    "enum": [
     "animated-sketch-dark",
     "animated-sketch-light",
     "professional-cloud",
     "minimal-corporate",
     "technical-blueprint",
     "presentation-neon"
    ],
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "theme",
   "layout",
   "outputFile",
   "nodes"
  ],
  "type": "object"
 },
 "name": "create_drawio",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "assets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "assetId": {
       "type": "string"
      },
      "integrity": {
       "type": "string"
      },
      "license": {
       "type": "string"
      },
      "nodeId": {
       "type": "string"
      },
      "provider": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "sourceUrl": {
       "type": "string"
      }
     },
     "required": [
      "nodeId",
      "assetId",
      "provider",
      "source",
      "license",
      "integrity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "counts": {
    "additionalProperties": false,
    "properties": {
     "edges": {
      "type": "number"
     },
     "groups": {
      "type": "number"
     },
     "nodes": {
      "type": "number"
     }
    },
    "required": [
     "groups",
     "nodes",
     "edges"
    ],
    "type": "object"
   },
   "layout": {
    "type": "string"
   },
   "outputFile": {
    "type": "string"
   },
   "outputPath": {
    "type": "string"
   },
   "theme": {
    "type": "string"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "issues": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "cellId": {
         "type": "string"
        },
        "code": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "valid": {
      "type": "boolean"
     }
    },
    "required": [
     "valid",
     "issues"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "outputFile",
   "outputPath",
   "theme",
   "layout",
   "counts",
   "warnings",
   "assets",
   "validation"
  ],
  "type": "object"
 },
 "title": "Create Editable Architecture Diagram"
}
