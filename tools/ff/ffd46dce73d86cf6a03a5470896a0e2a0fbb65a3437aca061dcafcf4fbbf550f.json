{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Submit correctness, freshness, safety, or completeness feedback without including private logs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "maxLength": 128,
    "minLength": 32,
    "type": "string"
   },
   "category": {
    "enum": [
     "correct",
     "incorrect",
     "outdated",
     "unsafe",
     "incomplete",
     "other"
    ],
    "type": "string"
   },
   "comment": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "rating": {
    "maximum": 1,
    "minimum": -1,
    "type": "integer"
   },
   "revision_ref": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "sample_contribution": {
    "properties": {
     "consent": {
      "const": true,
      "type": "boolean"
     },
     "consent_version": {
      "const": "2026-07-01",
      "type": "string"
     },
     "detected_context": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "sanitized_payload": {
      "minLength": 1,
      "type": "string"
     },
     "snapshot_type": {
      "enum": [
       "show_version",
       "config",
       "log",
       "topology",
       "other"
      ],
      "type": "string"
     }
    },
    "required": [
     "consent",
     "consent_version",
     "snapshot_type",
     "sanitized_payload"
    ],
    "type": "object"
   },
   "task_id": {
    "pattern": "^ekt_[A-Za-z0-9_-]{32}$",
    "type": "string"
   }
  },
  "required": [
   "category"
  ],
  "type": "object"
 },
 "name": "submit_feedback",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accepted": {
    "const": true,
    "type": "boolean"
   },
   "contribution_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "feedback_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "accepted",
   "feedback_id"
  ],
  "type": "object"
 },
 "title": "Submit Feedback"
}
