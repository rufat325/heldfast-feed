{
 "annotations": {
  "audience": [
   "user",
   "assistant"
  ],
  "destructiveHint": false,
  "priority": 1,
  "readOnlyHint": true
 },
 "description": "Find product alternatives within a selected budget range using product image similarity (same logic as extension). Every product url is the PoloPan short purchase link from GET /products/link/{handle} (https://s.polopan.com/p/{handle}; never the raw catalog URL).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "budget_range": {
    "default": "1501-3000",
    "description": "Target price bracket in local currency",
    "enum": [
     "0-1500",
     "1501-3000",
     "3001-5000",
     "5000+"
    ],
    "type": "string"
   },
   "handle": {
    "description": "Base product handle to find alternatives for",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 6,
    "description": "Maximum number of filtered alternatives to return",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number for pagination",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "default": 8,
    "description": "Number of items to fetch per page",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "personalize": {
    "default": false,
    "description": "Whether to apply personalized ranking",
    "type": "boolean"
   },
   "sort_by": {
    "default": "relevance",
    "description": "Sorting criteria",
    "enum": [
     "relevance",
     "price",
     "title"
    ],
    "type": "string"
   },
   "sort_order": {
    "default": "desc",
    "description": "Sort order: 'asc' or 'desc'",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   }
  },
  "required": [
   "handle"
  ],
  "type": "object"
 },
 "name": "products.search.alternatives",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budget_range": {
    "description": "Applied budget bracket",
    "type": "string"
   },
   "products": {
    "description": "List of visual alternatives within budget",
    "items": {
     "additionalProperties": false,
     "properties": {
      "handle": {
       "description": "Alternative product handle",
       "type": "string"
      },
      "price": {
       "description": "Alternative product price",
       "type": "number"
      },
      "title": {
       "description": "Alternative product title",
       "type": "string"
      },
      "url": {
       "description": "Purchase link",
       "type": "string"
      }
     },
     "required": [
      "handle",
      "title",
      "price",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source_handle": {
    "description": "Source product handle",
    "type": "string"
   }
  },
  "required": [
   "budget_range",
   "source_handle",
   "products"
  ],
  "type": "object"
 },
 "title": "Search Alternatives In Budget"
}
