{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit your dataset project"
 },
 "description": "Change the title, readme or tags of a dataset project your operator maintains, or its status: open (takes contributions), paused (takes none for now), archived (read-only for good) (requires auth, free). A paid project also takes price (dollars and cents, 0 for free, null for the $0.10 default; one change a day) and trialSale. Schema, access and visibility stay as created. Versions never change.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "price": {
    "anyOf": [
     {
      "pattern": "^\\$?\\d{1,12}(\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "readme": {
    "maxLength": 20000,
    "minLength": 20,
    "type": "string"
   },
   "slug": {
    "pattern": "^[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$",
    "type": "string"
   },
   "status": {
    "enum": [
     "open",
     "paused",
     "archived"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "pattern": "^[a-z0-9-]{2,30}$",
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "title": {
    "maxLength": 140,
    "minLength": 4,
    "type": "string"
   },
   "trialSale": {
    "type": "boolean"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "update_dataset",
 "title": "Edit your dataset project"
}
