{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find r\u00e9gions, provinces and pr\u00e9fectures, cercles, communes and arrondissements of Morocco by name. Takes French or Arabic, a slug, or another name a place is known by: Fez finds F\u00e8s, Mogador finds Essaouira. Returns codes; pass a commune's code to get_commune for its population and parents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "levels": {
    "description": "Only these levels. Every level when left out.",
    "items": {
     "enum": [
      "commune",
      "arrondissement",
      "province",
      "region",
      "cercle"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "How many results. 10 when left out, at most 50.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "The name to look for, in French, Arabic or as a slug, or a unit's code.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "level": {
       "enum": [
        "commune",
        "arrondissement",
        "province",
        "region",
        "cercle"
       ],
       "type": "string"
      },
      "matched": {
       "enum": [
        "code",
        "exact",
        "alias",
        "prefix",
        "spelling",
        "trigram"
       ],
       "type": "string"
      },
      "name_ar": {
       "type": "string"
      },
      "name_fr": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "level",
      "name_fr",
      "name_ar",
      "slug",
      "matched"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search Moroccan administrative units"
}
