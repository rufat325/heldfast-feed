{
 "description": "Create a new Support Agent for CRM/outreach.",
 "inputSchema": {
  "properties": {
   "allow_list": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "bulk_followup_enabled": {
    "type": "boolean"
   },
   "contact_option": {
    "enum": [
     "email",
     "whatsapp",
     "instagram",
     "x",
     "telegram"
    ],
    "type": "string"
   },
   "context": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "disable_ai_reply": {
    "type": "boolean"
   },
   "file_support": {
    "type": "boolean"
   },
   "followup_email_message": {
    "type": "string"
   },
   "followup_instagram_message": {
    "type": "string"
   },
   "followup_telegram_message": {
    "type": "string"
   },
   "followup_whatsapp_message": {
    "type": "string"
   },
   "followup_x_message": {
    "type": "string"
   },
   "inapp": {
    "type": "boolean"
   },
   "instructions": {
    "type": "string"
   },
   "is_public": {
    "type": "boolean"
   },
   "public_category_id": {
    "type": "integer"
   },
   "public_description": {
    "type": "string"
   },
   "public_slug": {
    "type": "string"
   },
   "theme": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "x_ld_attention_use_custom": {
    "description": "When true, use agent-specific X Leads Discovery public attention (Lane A/B).",
    "type": "boolean"
   },
   "x_ld_like_before_dm": {
    "type": "boolean"
   },
   "x_ld_like_daily_limit": {
    "type": "integer"
   },
   "x_ld_pool_public_quote_after_dm_fail": {
    "type": "boolean"
   },
   "x_ld_public_after_dm": {
    "type": "boolean"
   },
   "x_ld_public_daily_limit": {
    "type": "integer"
   },
   "x_ld_public_only": {
    "description": "Cold LD import: public quote/reply only, no DMs.",
    "type": "boolean"
   },
   "x_ld_public_per_run_limit": {
    "type": "integer"
   },
   "x_ld_public_post_goal": {
    "enum": [
     "attention",
     "check_dm"
    ],
    "type": "string"
   },
   "x_ld_public_poster": {
    "enum": [
     "main",
     "pool"
    ],
    "type": "string"
   },
   "x_ld_public_surface": {
    "enum": [
     "quote",
     "reply"
    ],
    "type": "string"
   },
   "x_ld_quote_target": {
    "enum": [
     "engagement",
     "root"
    ],
    "type": "string"
   }
  },
  "required": [
   "title",
   "contact_option"
  ],
  "type": "object"
 },
 "name": "admin__create_agent"
}
