{
 "description": "Sky View for a mix of real and synthetic bodies: register the authored system on an ephemeral engine, then frame the visible sky like sky_view. Synthetic bodies can carry render attributes (sizeDeg, magnitude, color) that flow into the pixel spec and prompt. Real Sun/Moon/planets stay for twilight and context unless omitted from `bodies`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "altitude": {
    "default": 5,
    "description": "Center altitude in degrees",
    "maximum": 90,
    "minimum": -10,
    "type": "number"
   },
   "azimuth": {
    "description": "Center direction: degrees from true north or a compass name",
    "type": [
     "number",
     "string"
    ]
   },
   "bodies": {
    "description": "Body ids to draw; defaults to Sun, Moon, planets, and every synthetic body",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "bortle": {
    "maximum": 9,
    "minimum": 1,
    "type": "integer"
   },
   "date": {
    "description": "UTC ISO date-time; omit for now",
    "type": "string"
   },
   "elevation_m": {
    "description": "Eye height above ground in meters",
    "type": "number"
   },
   "height": {
    "default": 683,
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "include_stars": {
    "default": false,
    "description": "Include catalog stars (usually off for fictional skies)",
    "type": "boolean"
   },
   "lat": {
    "description": "Latitude, north positive",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "lens": {
    "default": "normal",
    "enum": [
     "ultrawide",
     "wide",
     "standard",
     "normal",
     "portrait",
     "telephoto",
     "supertele"
    ],
    "type": "string"
   },
   "lon": {
    "description": "Longitude, EAST positive (Americas are negative)",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "system": {
    "additionalProperties": false,
    "properties": {
     "bodies": {
      "items": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "id": {
           "type": "string"
          },
          "lonDeg": {
           "type": "number"
          },
          "mode": {
           "const": "placement",
           "type": "string"
          }
         },
         "required": [
          "id",
          "mode",
          "lonDeg"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "epoch": {
           "type": "number"
          },
          "id": {
           "type": "string"
          },
          "mode": {
           "const": "periodic",
           "type": "string"
          },
          "periodDays": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "phaseDeg": {
           "type": "number"
          }
         },
         "required": [
          "id",
          "mode",
          "periodDays",
          "phaseDeg"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "M0": {
           "type": "number"
          },
          "a": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "e": {
           "exclusiveMaximum": 1,
           "minimum": 0,
           "type": "number"
          },
          "epoch": {
           "type": "number"
          },
          "i": {
           "type": "number"
          },
          "id": {
           "type": "string"
          },
          "mode": {
           "const": "kepler",
           "type": "string"
          },
          "node": {
           "type": "number"
          },
          "peri": {
           "type": "number"
          },
          "periodDays": {
           "exclusiveMinimum": 0,
           "type": "number"
          }
         },
         "required": [
          "id",
          "mode",
          "a",
          "e",
          "i",
          "node",
          "peri",
          "M0",
          "periodDays"
         ],
         "type": "object"
        }
       ]
      },
      "minItems": 1,
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "observer": {
      "type": "string"
     },
     "render": {
      "additionalProperties": {
       "additionalProperties": false,
       "properties": {
        "color": {
         "type": "string"
        },
        "magnitude": {
         "type": "number"
        },
        "sizeDeg": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "object"
     }
    },
    "required": [
     "id",
     "bodies"
    ],
    "type": "object"
   },
   "width": {
    "default": 1024,
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "system",
   "lat",
   "lon",
   "azimuth"
  ],
  "type": "object"
 },
 "name": "synthetic_sky_view"
}
