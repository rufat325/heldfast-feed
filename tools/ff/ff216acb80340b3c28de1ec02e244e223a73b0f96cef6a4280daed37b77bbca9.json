{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Performs a bounded, non-persisting GET of an authorized public domain's homepage and reports tracker markup, consent setup signals, and runtime-verification gaps. It does not run JavaScript, submit forms, create a RegSentry record, or make a legal determination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "authorizationAcknowledged": {
    "const": true,
    "description": "Must be true to confirm the user owns or is authorized to inspect this domain.",
    "type": "boolean"
   },
   "domain": {
    "description": "Public domain only, such as example.com. Do not include a path or query.",
    "maxLength": 300,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "domain",
   "authorizationAcknowledged"
  ],
  "type": "object"
 },
 "name": "inspect_site_tracking",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "consentManagers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "consentSetupState": {
    "enum": [
     "default_deny_signal_observed",
     "consent_mechanism_observed",
     "no_consent_signal_observed"
    ],
    "type": "string"
   },
   "consentSignals": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "disclaimer": {
    "type": "string"
   },
   "domain": {
    "type": "string"
   },
   "dynamicLoaders": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "finalHostname": {
    "type": "string"
   },
   "httpStatus": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "runtimeVerificationRequired": {
    "const": true,
    "type": "boolean"
   },
   "scope": {
    "const": "homepage_static_html",
    "type": "string"
   },
   "trackers": {
    "items": {
     "additionalProperties": false,
     "description": "A static HTML tracker reference; runtime firing and violations are not established.",
     "properties": {
      "category": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "category"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "trackersRequiringRuntimeVerification": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "domain",
   "finalHostname",
   "scope",
   "httpStatus",
   "consentSetupState",
   "consentManagers",
   "consentSignals",
   "trackers",
   "trackersRequiringRuntimeVerification",
   "dynamicLoaders",
   "runtimeVerificationRequired",
   "limitations",
   "disclaimer"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Inspect site tracking setup"
}
