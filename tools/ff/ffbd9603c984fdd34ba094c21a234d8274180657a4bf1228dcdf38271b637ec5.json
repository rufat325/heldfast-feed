{"_meta":{"openai/outputTemplate":"ui://3dlogo/preview","openai/toolInvocation/invoked":"Share link ready","openai/toolInvocation/invoking":"Creating the share link","openai/widgetAccessible":false,"ui":{"resourceUri":"ui://3dlogo/preview"},"ui/resourceUri":"ui://3dlogo/preview"},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"Use when the user wants to send a saved design to someone, post it, or embed it on a site: returns the share page, the iframe embed snippet, the oEmbed endpoint and a poster image URL. Unlisted (default) works for anyone holding the link without making the project public; public makes the page indexable. Reuses the project's active link of the same visibility, so calling twice is safe. The project must have been opened and saved once. Owner only. Do not use to let someone edit; create_invite_link does that.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"allow_download":{"default":true,"description":"Let viewers download the file from the page","type":"boolean"},"id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"title":{"description":"Title on the share page; defaults to the project title","maxLength":200,"minLength":1,"type":"string"},"visibility":{"default":"unlisted","enum":["unlisted","public"],"type":"string"}},"required":["id"],"type":"object"},"name":"create_share_link","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"allowDownload":{"type":"boolean"},"createdAt":{"type":"string"},"embedEnabled":{"type":"boolean"},"embedHtml":{"description":"Copy-paste iframe snippet with attribution","type":"string"},"embedUrl":{"description":"The iframe source","format":"uri","type":"string"},"expiresAt":{"type":["string","null"]},"kind":{"enum":["logo","coin","mesh"],"type":"string"},"modelUrl":{"anyOf":[{"format":"uri","type":"string"},{"type":"null"}],"description":"The GLB, for shares of generated meshes"},"oembedUrl":{"description":"oEmbed endpoint for this share","format":"uri","type":"string"},"posterUrl":{"anyOf":[{"format":"uri","type":"string"},{"type":"null"}],"description":"Rendered still of the design, when one exists"},"projectId":{"anyOf":[{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},{"type":"null"}]},"status":{"enum":["active","revoked","expired","removed"],"type":"string"},"title":{"type":"string"},"token":{"type":"string"},"url":{"description":"The share page","format":"uri","type":"string"},"videoUrl":{"anyOf":[{"format":"uri","type":"string"},{"type":"null"}],"description":"Turntable MP4, when one has been rendered"},"viewCount":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"visibility":{"enum":["unlisted","public"],"type":"string"}},"required":["token","url","embedUrl","posterUrl","videoUrl","modelUrl","oembedUrl","embedHtml","kind","title","visibility","status","expiresAt","allowDownload","embedEnabled","viewCount","projectId","createdAt"],"type":"object"},"title":"Create a share link and embed code"}
