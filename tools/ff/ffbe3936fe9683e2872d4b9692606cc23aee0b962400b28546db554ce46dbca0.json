{
 "description": "Get a regulatory compliance checklist for a specific GCC country and business type.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "business_type": {
    "description": "Business structure type",
    "enum": [
     "llc",
     "sole_proprietor",
     "free_zone",
     "branch",
     "representative"
    ],
    "type": "string"
   },
   "country": {
    "description": "GCC country code",
    "enum": [
     "SA",
     "AE",
     "KW",
     "BH",
     "OM",
     "QA"
    ],
    "type": "string"
   },
   "employee_count": {
    "description": "Number of employees (for labor law compliance)",
    "type": "number"
   },
   "industry": {
    "description": "Industry sector for industry-specific requirements",
    "type": "string"
   }
  },
  "required": [
   "country",
   "business_type"
  ],
  "type": "object"
 },
 "name": "gcc_compliance_checklist"
}
