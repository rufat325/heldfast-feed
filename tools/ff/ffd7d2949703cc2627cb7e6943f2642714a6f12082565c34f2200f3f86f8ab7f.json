{
 "description": "Recent RUNTIME logs of a container (CloudWatch, up to 1000 lines). For BUILD logs of a deployment use get_deployments with a deployment_id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "container": {
    "description": "Container name or id",
    "type": "string"
   },
   "lines": {
    "description": "Line count, default 100",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "container"
  ],
  "type": "object"
 },
 "name": "get_logs"
}
