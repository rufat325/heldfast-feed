{
 "description": "Search one or more features and named areas. Returns a GeoJSON FeatureCollection. Optional year narrows year-split snapshots; year-split features (anything not osm/visual) default to the newest year (2026, then 2025, ...). Internal c_id/s_id/r_id/p_id and h3 columns are removed from results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "area": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    ]
   },
   "area_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    ]
   },
   "country_code": {
    "minLength": 1,
    "type": "string"
   },
   "feature": {
    "anyOf": [
     {
      "type": [
       "string",
       "number"
      ]
     },
     {
      "items": {
       "$ref": "#/properties/feature/anyOf/0"
      },
      "minItems": 1,
      "type": "array"
     }
    ]
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "default": 1000,
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "mode": {
    "default": "auto",
    "enum": [
     "cloud",
     "offline",
     "auto"
    ],
    "type": "string"
   },
   "state_code": {
    "minLength": 1,
    "type": "string"
   },
   "year": {
    "description": "Optional snapshot year, for example 2026",
    "type": [
     "string",
     "number"
    ]
   }
  },
  "required": [
   "feature"
  ],
  "type": "object"
 },
 "name": "e2_search",
 "title": "Search Earth features"
}
