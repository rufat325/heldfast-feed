{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Notes"
 },
 "description": "List notes with optional filters. Returns notes sorted by most recent first.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 30,
    "type": "integer"
   },
   "note_type": {
    "enum": [
     "general",
     "decision",
     "context",
     "meeting",
     "technical",
     "blocker",
     "progress",
     "release"
    ],
    "type": "string"
   },
   "project_id": {
    "description": "Scope to one project. Defaults to SAGA_PROJECT if set, else the whole database.",
    "type": "integer"
   },
   "related_entity_id": {
    "type": "integer"
   },
   "related_entity_type": {
    "enum": [
     "project",
     "epic",
     "task"
    ],
    "type": "string"
   },
   "tag": {
    "description": "Filter by a single tag",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "note_list"
}
