{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compile a public web page into clean, deterministic, LLM-optimized markdown or structured AST nodes using the full 12-pass Atlas compiler. Strips boilerplate and generates section hierarchies. Best for complex documentation, API references, and dense technical articles.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "force_fresh": {
    "default": false,
    "description": "Bypass edge cache and force a fresh compilation from origin.",
    "type": "boolean"
   },
   "format": {
    "default": "markdown",
    "description": "'markdown' returns clean LLM-ready markdown; 'semantic' returns the structured AST section graph; 'markdown+links' appends discovered navigation links.",
    "enum": [
     "markdown",
     "semantic",
     "markdown+links"
    ],
    "type": "string"
   },
   "max_output_chars": {
    "default": 30000,
    "description": "Maximum character budget for the returned content. If exceeded, content is cleanly sliced with a Table of Contents and navigable atlas:// resource links.",
    "maximum": 200000,
    "minimum": 1000,
    "type": "integer"
   },
   "url": {
    "description": "The absolute HTTP or HTTPS URL of the web page to compile.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "atlas_compile",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "ast": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "compilation_id": {
    "type": "string"
   },
   "headings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "level": {
       "type": "number"
      },
      "resource_uri": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "level",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "markdown": {
    "type": "string"
   },
   "resources": {
    "additionalProperties": false,
    "properties": {
     "ast_uri": {
      "type": "string"
     },
     "compiled_artifact_uri": {
      "type": "string"
     }
    },
    "required": [
     "compiled_artifact_uri"
    ],
    "type": "object"
   },
   "stats": {
    "additionalProperties": false,
    "properties": {
     "character_count": {
      "type": "number"
     },
     "compilation_time_ms": {
      "type": "number"
     },
     "tokens_saved_pct": {
      "type": "number"
     }
    },
    "required": [
     "character_count",
     "compilation_time_ms"
    ],
    "type": "object"
   },
   "title": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "compilation_id",
   "title",
   "resources",
   "stats",
   "truncated"
  ],
  "type": "object"
 }
}
