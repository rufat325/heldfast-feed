{
 "description": "Add a new item to the inventory",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "brand": {
    "description": "Manufacturer or brand name",
    "type": "string"
   },
   "category": {
    "description": "Category (e.g. appliance, electronics, furniture, subscription)",
    "type": "string"
   },
   "currency": {
    "description": "Currency code (e.g. GBP, USD, EUR)",
    "type": "string"
   },
   "features": {
    "description": "Key features or specifications",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "location": {
    "description": "Where the item is kept (e.g. kitchen, garage, office)",
    "type": "string"
   },
   "model": {
    "description": "Model name or number",
    "type": "string"
   },
   "name": {
    "description": "Name of the item",
    "type": "string"
   },
   "notes": {
    "description": "Any additional notes about the item",
    "type": "string"
   },
   "purchase_date": {
    "description": "Date of purchase (ISO date, e.g. 2024-01-15)",
    "type": "string"
   },
   "purchase_price": {
    "description": "Price paid for the item",
    "type": "number"
   },
   "retailer": {
    "description": "Where the item was purchased",
    "type": "string"
   },
   "serial_number": {
    "description": "Serial number of the item",
    "type": "string"
   },
   "tags": {
    "description": "Tags for grouping or searching (e.g. ['white goods', 'laundry'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "warranty_expires": {
    "description": "Warranty expiry date (ISO date, e.g. 2026-01-15)",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "add_item"
}
