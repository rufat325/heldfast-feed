{
 "_meta": {
  "openai/outputTemplate": "ui://giftroam/app.html@v8",
  "openai/resultCanProduceWidget": true,
  "openai/toolInvocation/invoked": "Gift details ready",
  "openai/toolInvocation/invoking": "Loading gift details\u2026",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://giftroam/app.html@v8",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://giftroam/app.html@v8"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get gift details"
 },
 "description": "Full description, contents, images, customer price, estimated delivery window (EST cutoff-aware), substitution policy and restrictions for one gift in one destination country.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "description": "Destination country, ISO-3166 alpha-2.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "gift_id": {
    "description": "A gift_id from search results (or the gift's URL slug).",
    "minLength": 1,
    "type": "string"
   },
   "locale": {
    "description": "Display language for gift content (e.g. he-IL). Prices and availability are unaffected.",
    "maxLength": 12,
    "type": "string"
   }
  },
  "required": [
   "gift_id",
   "country"
  ],
  "type": "object"
 },
 "name": "get_gift_details",
 "outputSchema": {
  "properties": {
   "display_text": {
    "description": "Human-readable one-line summary of the result",
    "type": "string"
   },
   "error": {
    "description": "Present only when the call failed",
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "next_step": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "gift": {
    "properties": {
     "contains_alcohol": {
      "description": "yes | no | unknown",
      "type": "string"
     },
     "contents": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "currency": {
      "type": "string"
     },
     "customer_amount_minor": {
      "description": "Price in minor units (cents)",
      "type": "number"
     },
     "delivery_days": {
      "description": "Business-day delivery estimate range",
      "properties": {
       "max": {
        "type": "number"
       },
       "min": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "description": {
      "type": "string"
     },
     "display_price": {
      "description": "Final customer price incl. delivery, e.g. \"$99.95\"",
      "type": "string"
     },
     "estimated_delivery": {
      "properties": {
       "cutoff_passed_today": {
        "type": "boolean"
       },
       "earliest": {
        "type": "string"
       },
       "latest": {
        "type": "string"
       },
       "notes": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "type": "object"
     },
     "gift_id": {
      "type": "string"
     },
     "image_url": {
      "type": "string"
     },
     "images": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "one_liner": {
      "type": "string"
     },
     "restrictions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "substitution_policy": {
      "type": "string"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "locale": {
    "description": "BCP-47 locale the texts are localized to",
    "type": "string"
   },
   "translation": {
    "description": "How the gift content was localized",
    "properties": {
     "contentHash": {
      "type": "string"
     },
     "provider": {
      "type": [
       "string",
       "null"
      ]
     },
     "sourceLocale": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "targetLocale": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "orders:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Get gift details"
}
