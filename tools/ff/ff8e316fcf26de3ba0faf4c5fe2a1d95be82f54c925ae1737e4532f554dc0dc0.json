{
 "description": "Create a new Frappe DocType with JSON definition and Python controller",
 "inputSchema": {
  "properties": {
   "app_name": {
    "description": "Name of the Frappe app",
    "type": "string"
   },
   "doctype_name": {
    "description": "Name of the DocType",
    "type": "string"
   },
   "fields": {
    "description": "Array of field definitions",
    "items": {
     "properties": {
      "fieldname": {
       "type": "string"
      },
      "fieldtype": {
       "enum": [
        "Data",
        "Int",
        "Float",
        "Currency",
        "Date",
        "Datetime",
        "Text",
        "Long Text",
        "Check",
        "Select",
        "Link",
        "Table",
        "Attach",
        "Image"
       ],
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "options": {
       "description": "Options for Select/Link fields",
       "type": "string"
      },
      "reqd": {
       "default": false,
       "type": "boolean"
      },
      "unique": {
       "default": false,
       "type": "boolean"
      }
     },
     "required": [
      "fieldname",
      "label",
      "fieldtype"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "is_child": {
    "default": false,
    "type": "boolean"
   },
   "is_submittable": {
    "default": false,
    "type": "boolean"
   },
   "module": {
    "description": "Module where DocType belongs",
    "type": "string"
   }
  },
  "required": [
   "app_name",
   "doctype_name",
   "module",
   "fields"
  ],
  "type": "object"
 },
 "name": "frappe_create_doctype"
}
