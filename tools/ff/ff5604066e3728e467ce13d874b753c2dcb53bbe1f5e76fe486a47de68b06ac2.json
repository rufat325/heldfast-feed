{
 "description": "Read submissions across the workspace or for one form, with filters (status, date range, text search, country, attachments, failed deliveries) and paging. Spam is excluded unless status is 'spam'. Requires a paid plan.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "countries": {
    "description": "ISO 3166 alpha-2 codes",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "deliveryFailed": {
    "type": "boolean"
   },
   "formId": {
    "description": "Form id, e.g. frm_abc123",
    "type": "string"
   },
   "hasFiles": {
    "type": "boolean"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "q": {
    "description": "Free-text search across field values",
    "type": "string"
   },
   "since": {
    "description": "ISO date; received on/after",
    "type": "string"
   },
   "sort": {
    "enum": [
     "newest",
     "oldest",
     "score"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "spam",
     "flagged"
    ],
    "type": "string"
   },
   "until": {
    "description": "ISO date; received before",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_submissions",
 "title": "List submissions"
}
