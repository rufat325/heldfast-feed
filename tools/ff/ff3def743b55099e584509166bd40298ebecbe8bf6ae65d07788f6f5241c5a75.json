{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Poll a task"
 },
 "description": "Status of a task created by axiom_check_start. While `working` only the descriptor is returned; once terminal, `result` (completed) or `error` (failed|cancelled) is attached. Unknown or expired taskId \u2192 ERR_TASK_NOT_FOUND.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "taskId": {
    "description": "taskId returned by axiom_check_start",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taskId"
  ],
  "type": "object"
 },
 "name": "axiom_task_get",
 "outputSchema": {
  "$defs": {
   "__schema0": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     },
     {
      "type": "null"
     },
     {
      "items": {
       "$ref": "#/$defs/__schema0"
      },
      "type": "array"
     },
     {
      "additionalProperties": {
       "$ref": "#/$defs/__schema0"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ]
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "elapsedMs": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "details": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "pollIntervalMs": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "apiVersion": {
      "const": "axiom.dev/v2",
      "type": "string"
     },
     "durationMs": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "factsDigest": {
      "description": "sha256:<64 lowercase hex>",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "findings": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "facts": {
         "additionalProperties": {
          "$ref": "#/$defs/__schema0"
         },
         "default": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "id": {
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "path": {
         "description": "Relative POSIX path, NFC, no reserved names",
         "maxLength": 1024,
         "minLength": 1,
         "type": "string"
        },
        "predicate": {
         "type": "string"
        },
        "severity": {
         "enum": [
          "error",
          "warn",
          "info"
         ],
         "type": "string"
        }
       },
       "required": [
        "id",
        "severity",
        "predicate",
        "message",
        "facts"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "kind": {
      "const": "CheckReport",
      "type": "string"
     },
     "manifestDigest": {
      "description": "sha256:<64 lowercase hex>",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "preImage": {
      "enum": [
       "verified",
       "drifted",
       "unverified"
      ],
      "type": "string"
     },
     "profile": {
      "type": "string"
     },
     "providers": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "ms": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "name": {
         "type": "string"
        },
        "status": {
         "enum": [
          "ok",
          "skipped",
          "error"
         ],
         "type": "string"
        }
       },
       "required": [
        "name",
        "status",
        "ms"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "verdict": {
      "enum": [
       "pass",
       "fail",
       "error"
      ],
      "type": "string"
     }
    },
    "required": [
     "apiVersion",
     "kind",
     "manifestDigest",
     "profile",
     "verdict",
     "findings",
     "factsDigest",
     "durationMs",
     "providers"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "working",
     "completed",
     "failed",
     "cancelled"
    ],
    "type": "string"
   },
   "taskId": {
    "type": "string"
   },
   "tool": {
    "type": "string"
   },
   "ttlMs": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "taskId",
   "tool",
   "status",
   "pollIntervalMs",
   "ttlMs",
   "elapsedMs"
  ],
  "type": "object"
 },
 "title": "Poll a task"
}
