{
 "_meta": {
  "spellbook.finance/limitations": [
   "Omitted fields preserve current values, including server-owned demand behavior.",
   "Only seller-approved amendment fields are accepted. The update does not publish or trigger repricing."
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update a seller pricing amendment"
 },
 "description": "Update selected fields on one saved pricing amendment and return saved readback. Omitted fields preserve existing values, including server-owned demand behavior. The update does not publish or trigger repricing.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "amendmentId": {
    "description": "The exact saved amendment id from a prior amendment read. Required.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "enabled": {
    "description": "Replacement enabled state.",
    "type": "boolean"
   },
   "marketplaceScope": {
    "anyOf": [
     {
      "const": "all",
      "description": "Apply across all supported marketplaces.",
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "channels": {
        "description": "Specific marketplace channels for this amendment.",
        "items": {
         "enum": [
          "ebay",
          "tcg",
          "manapool",
          "shopify",
          "cardtrader"
         ],
         "type": "string"
        },
        "maxItems": 5,
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "channels"
      ],
      "type": "object"
     }
    ],
    "description": "Replacement marketplace scope."
   },
   "mode": {
    "additionalProperties": false,
    "description": "Replacement absolute multiplier and optional protected band.",
    "properties": {
     "multiplier": {
      "description": "Absolute multiplier applied by this amendment. Required.",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "protectedBand": {
      "additionalProperties": false,
      "description": "Optional seller-approved protected band.",
      "properties": {
       "multiplier": {
        "description": "Protected multiplier at or above the threshold.",
        "exclusiveMinimum": 0,
        "type": "number"
       },
       "thresholdUsd": {
        "description": "Original market anchor threshold in USD.",
        "exclusiveMinimum": 0,
        "type": "number"
       }
      },
      "required": [
       "thresholdUsd",
       "multiplier"
      ],
      "type": "object"
     }
    },
    "required": [
     "multiplier"
    ],
    "type": "object"
   },
   "name": {
    "description": "Replacement seller-selected name.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "anyOf": [
     {
      "maxLength": 1000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Replacement notes; null clears notes."
   },
   "priority": {
    "description": "Replacement precedence priority.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "selector": {
    "additionalProperties": false,
    "description": "Replacement bounded selector.",
    "properties": {
     "condition": {
      "description": "Optional condition selector.",
      "enum": [
       "NM",
       "LP",
       "MP",
       "HP",
       "DMG"
      ],
      "type": "string"
     },
     "finish": {
      "description": "Optional finish selector.",
      "enum": [
       "nf",
       "fo",
       "etched",
       "surge",
       "rh",
       "1e",
       "1e-fo"
      ],
      "type": "string"
     },
     "originalAnchorPriceBand": {
      "additionalProperties": false,
      "description": "Optional original market anchor band selector.",
      "properties": {
       "maxUsd": {
        "description": "Protected band upper bound in USD.",
        "minimum": 0,
        "type": "number"
       },
       "minUsd": {
        "description": "Protected band lower bound in USD.",
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     },
     "releaseFamilyCode": {
      "description": "Release family selector.",
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
     },
     "scryfallId": {
      "description": "Exact Scryfall printing selector. Requires setCode when supplied.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "setCode": {
      "description": "Set code selector.",
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "workspaceId": {
    "description": "The workspace the seller selected. The caller must own it. Required.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "workspaceId",
   "amendmentId"
  ],
  "type": "object"
 },
 "name": "spellbook_pricing_amendment_update"
}
