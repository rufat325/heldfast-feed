    "minLength": 1,
    "type": "string"
   },
   "entryId": {
    "description": "Mnemon entry ID (hex) or exact title.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "campaignId",
   "entryId"
  ],
  "type": "object"
 },
 "name": "get_mnemon",
