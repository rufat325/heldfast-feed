{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Draft an invoice"
 },
 "description": "Price an invoice (subtotal, tax after discount, shipping, total) and get a builderUrl that opens the free AI Invoice Generator builder prefilled. The human can download a PDF there, or connect Stripe to get a pay link that accepts partial payments. Nothing is stored or sent.",
 "inputSchema": {
  "properties": {
   "allowPartial": {
    "description": "Let the payer pay part of the balance now",
    "type": "boolean"
   },
   "billTo": {
    "description": "The customer. name is required; email is prefilled at checkout.",
    "properties": {
     "address": {
      "description": "Multi-line postal address",
      "maxLength": 500,
      "type": "string"
     },
     "email": {
      "format": "email",
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "type": "object"
   },
   "currency": {
    "default": "usd",
    "enum": [
     "usd",
     "cad",
     "eur",
     "gbp",
     "aud",
     "nzd"
    ],
    "type": "string"
   },
   "discount": {
    "description": "Minor units, taken off the subtotal",
    "minimum": 0,
    "type": "integer"
   },
   "dueDate": {
    "description": "YYYY-MM-DD. The invoice reads overdue the day after.",
    "format": "date",
    "type": "string"
   },
   "from": {
    "description": "The business sending the invoice. On create, leave it out to use the connected Stripe business's name and email.",
    "properties": {
     "address": {
      "description": "Multi-line postal address",
      "maxLength": 500,
      "type": "string"
     },
     "email": {
      "format": "email",
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "type": "object"
   },
   "issueDate": {
    "description": "YYYY-MM-DD",
    "format": "date",
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "description": {
       "maxLength": 500,
       "type": "string"
      },
      "quantity": {
       "description": "May be fractional, e.g. 1.5 hours",
       "minimum": 0,
       "type": "number"
      },
      "unitPrice": {
       "description": "Minor units (cents)",
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "description",
      "quantity",
      "unitPrice"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "minPayment": {
    "description": "Smallest partial payment in minor units (e.g. a deposit). The full balance is always payable.",
    "minimum": 0,
    "type": "integer"
   },
   "notes": {
    "maxLength": 2000,
    "type": "string"
   },
   "number": {
    "description": "Your invoice number, e.g. INV-1042",
    "maxLength": 40,
    "type": "string"
   },
   "shipTo": {
    "description": "Optional shipping address",
    "properties": {
     "address": {
      "description": "Multi-line postal address",
      "maxLength": 500,
      "type": "string"
     },
     "email": {
      "format": "email",
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "type": "object"
   },
   "shipping": {
    "description": "Minor units, added after tax",
    "minimum": 0,
    "type": "integer"
   },
   "taxRate": {
    "description": "Percent. Applied after discount, not to shipping.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "terms": {
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "draft_invoice",
 "title": "Draft an invoice (no account needed)"
}
