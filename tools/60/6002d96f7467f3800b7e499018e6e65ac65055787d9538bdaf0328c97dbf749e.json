{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The signed-in student's ELMS (Canvas) Inbox: conversations with their subject, participants and last message. Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 20,
    "description": "Maximum number of records to return, 1-100 (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "scope": {
    "default": "inbox",
    "description": "Which Inbox folder to list (default \"inbox\")",
    "enum": [
     "inbox",
     "unread",
     "starred",
     "archived"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "elms_list_conversations",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "conversations": {
    "description": "Most recent first",
    "items": {
     "additionalProperties": false,
     "properties": {
      "context": {
       "description": "Course the conversation belongs to, if any",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "description": "Conversation id, for elms_get_conversation",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "last_message": {
       "type": [
        "string",
        "null"
       ]
      },
      "last_message_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      },
      "message_count": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "participants": {
       "description": "Participant names",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "starred": {
       "type": "boolean"
      },
      "state": {
       "enum": [
        "read",
        "unread",
        "archived"
       ],
       "type": "string"
      },
      "subject": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "subject",
      "state",
      "last_message",
      "last_message_at",
      "message_count",
      "participants",
      "context",
      "starred"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "conversations"
  ],
  "type": "object"
 },
 "title": "List ELMS conversations"
}
