{
 "description": "Batch look up elevations in meters for multiple latitude/longitude points.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "locations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "latitude": {
       "maximum": 90,
       "minimum": -90,
       "type": "number"
      },
      "longitude": {
       "maximum": 180,
       "minimum": -180,
       "type": "number"
      }
     },
     "required": [
      "latitude",
      "longitude"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "locations"
  ],
  "type": "object"
 },
 "name": "get_elevations"
}
