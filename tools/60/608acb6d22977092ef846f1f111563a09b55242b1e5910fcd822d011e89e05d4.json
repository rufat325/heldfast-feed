{
 "annotations": {},
 "description": "Add an image from a URL (preferred) or base64, as a rectangle sized to the image, or as nodeId's fill.",
 "inputSchema": {
  "properties": {
   "crop": {
    "description": "Part of the image to show, {x, y, width, height} each 0-1. Sets scaleMode CROP.",
    "properties": {
     "height": {
      "description": "0-1",
      "type": "number"
     },
     "width": {
      "description": "0-1",
      "type": "number"
     },
     "x": {
      "description": "Left, 0-1",
      "type": "number"
     },
     "y": {
      "description": "Top, 0-1",
      "type": "number"
     }
    },
    "type": "object"
   },
   "filters": {
    "description": "Adjustments, each -1 to 1 (0 = none)",
    "properties": {
     "contrast": {
      "type": "number"
     },
     "exposure": {
      "type": "number"
     },
     "highlights": {
      "type": "number"
     },
     "saturation": {
      "type": "number"
     },
     "shadows": {
      "type": "number"
     },
     "temperature": {
      "description": "-1 cool to 1 warm",
      "type": "number"
     },
     "tint": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "height": {
    "description": "Height (default: image size, max 1000)",
    "type": "number"
   },
   "imageData": {
    "description": "Base64 PNG or JPG, if no URL",
    "type": "string"
   },
   "imageUrl": {
    "description": "Image URL",
    "type": "string"
   },
   "mode": {
    "description": "With nodeId: replace fills (default) or append",
    "type": "string"
   },
   "name": {
    "description": "Node name",
    "type": "string"
   },
   "nodeId": {
    "description": "Fill this node with the image instead of making a rectangle",
    "type": "string"
   },
   "parentId": {
    "description": "Parent node ID (default: current page)",
    "type": "string"
   },
   "scaleMode": {
    "description": "FILL (default), FIT, CROP, or TILE",
    "type": "string"
   },
   "width": {
    "description": "Width (default: image size, max 1000)",
    "type": "number"
   },
   "x": {
    "description": "X (default 0)",
    "type": "number"
   },
   "y": {
    "description": "Y (default 0)",
    "type": "number"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "import_image"
}
