{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"List files only under a course or folder (not all child types \u2014 use adam_list_children for that). Pass type when known. Follow nextCursor. Returns metadata and canonical URLs, not file bytes. Do not download PDFs into the model. Tests (tst) are omitted.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"cursor":{"description":"Opaque decimal token \u2014 copy nextCursor verbatim into cursor, do not invent offsets. Expired browser cursors require restarting the listing without cursor.","pattern":"^\\d+$","type":"string"},"limit":{"description":"Page size, default 20, max 100","maximum":100,"minimum":1,"type":"integer"},"refId":{"description":"ILIAS ref_id: digits, adam://{type}/{id}, or https://adam.unibas.ch/go/{type}/{id}. Titles and non-ADAM URLs are rejected.","minLength":1,"type":"string"},"type":{"description":"Optional object type from a prior listing/search hit (crs, fold, file, exc, \u2026). Pass the hit's type; never invent types. Prefer this so the server opens /go/{type}/{refId}. If explicit type disagrees with refId, the call fails \u2014 run `adam_search` and pass the hit's `type+refId`.","enum":["root","cat","crs","fold","file","blog","webr","frm","exc","tst","impr","unknown"],"type":"string"}},"required":["refId"],"type":"object"},"name":"adam_list_files","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"additionalProperties":{},"properties":{"items":{"items":{"additionalProperties":{},"properties":{"accessClass":{"type":"string"},"author":{"type":"string"},"breadcrumb":{"items":{"additionalProperties":{},"properties":{"refId":{"type":"string"},"resourceUri":{"type":"string"},"title":{"type":"string"},"type":{"enum":["root","cat","crs","fold","file","blog","webr","frm","exc","tst","impr","unknown"],"type":"string"},"url":{"type":"string"}},"required":["type","refId","title","url"],"type":"object"},"type":"array"},"createdAt":{"type":"string"},"match":{"description":"Search hits only: title vs page-body match. Body match means text exists; opening the body still needs confirm-gated read/extract.","enum":["title","body"],"type":"string"},"mimeType":{"type":"string"},"pageCount":{"type":"number"},"provenance":{"additionalProperties":{},"properties":{"fetchedAt":{"type":"string"},"freshness":{"type":"string"},"iliasVersion":{"type":"string"},"provider":{"enum":["fixture","soap","browser","html"],"type":"string"},"sourceUrl":{"type":"string"}},"required":["sourceUrl","fetchedAt","provider"],"type":"object"},"refId":{"type":"string"},"resourceUri":{"description":"MCP handle adam://{type}/{refId}; not a browser URL","type":"string"},"sizeBytes":{"type":"number"},"title":{"type":"string"},"type":{"const":"file","type":"string"},"updatedAt":{"type":"string"},"url":{"type":"string"}},"required":["type","refId","title","url","breadcrumb","provenance"],"type":"object"},"type":"array"},"listingNotice":{"description":"Provider listing guidance when present (ADR 0005); distinct from the untrusted notice","type":"string"},"listingSignals":{"additionalProperties":{},"properties":{"chromeOnly":{"type":"boolean"},"contentItemCount":{"type":"number"},"emptyCopy":{"type":"boolean"}},"required":["contentItemCount","emptyCopy","chromeOnly"],"type":"object"},"listingState":{"enum":["ok","empty","unknown"],"type":"string"},"nextCursor":{"type":"string"},"notice":{"type":"string"},"partial":{"description":"True when an enrolled-tree walk skipped pages or hit a page/time budget \u2014 results may be incomplete","type":"boolean"},"partialReason":{"const":"time_budget","type":"string"},"partialReasons":{"items":{"enum":["time_budget","page_budget","unreadable_page","unknown_listing"],"type":"string"},"type":"array"},"skipped":{"description":"Count of pages skipped during a partial walk","type":"number"},"snapshotAt":{"format":"date-time","pattern":"