{
 "description": "Begin tracking a mystery. Define the truth (GM-only) to enable hypothesis testing.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Investigation name",
    "type": "string"
   },
   "openQuestions": {
    "description": "Initial questions to answer",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "situationIds": {
    "description": "Related situation IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "truth": {
    "additionalProperties": false,
    "description": "The truth of the mystery (GM-only, used for hypothesis testing)",
    "properties": {
     "keyFacts": {
      "description": "Key facts players should discover",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "method": {
      "description": "How they did it",
      "type": "string"
     },
     "motive": {
      "description": "Why they did it",
      "type": "string"
     },
     "perpetrator": {
      "description": "Who did it",
      "type": "string"
     },
     "summary": {
      "description": "What actually happened (GM-only)",
      "type": "string"
     }
    },
    "required": [
     "summary",
     "keyFacts"
    ],
    "type": "object"
   }
  },
  "required": [
   "sessionId",
   "name",
   "truth"
  ],
  "type": "object"
 },
 "name": "start_investigation"
}
