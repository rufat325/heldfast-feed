{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Delegate multiple atomic tasks to Kimi for batch processing. Ideal for repetitive operations, mass refactoring, and automated transformations.",
 "inputSchema": {
  "properties": {
   "concurrency": {
    "description": "Maximum parallel Kimi processes when parallel=true. Default: min(task count, 4)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "model": {
    "description": "Optional model override applied to every task. Known: kimi-for-coding, kimi-k2-6, kimi-k2-6-turbo, kimi-k2-thinking-turbo, kimi-k2-5, kimi-latest.",
    "type": "string"
   },
   "parallel": {
    "default": false,
    "description": "Execute independent tasks in parallel",
    "type": "boolean"
   },
   "stopOnError": {
    "default": true,
    "description": "Stop execution if any task fails",
    "type": "boolean"
   },
   "tasks": {
    "description": "Array of atomic tasks to delegate to Kimi",
    "items": {
     "additionalProperties": false,
     "properties": {
      "priority": {
       "default": "normal",
       "description": "Task priority",
       "enum": [
        "high",
        "normal",
        "low"
       ],
       "type": "string"
      },
      "target": {
       "description": "Target files/directories (use @ syntax)",
       "type": "string"
      },
      "task": {
       "description": "Atomic task description",
       "type": "string"
      }
     },
     "required": [
      "task"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "timeout": {
    "description": "Maximum execution time per task in milliseconds",
    "type": "number"
   },
   "workingDir": {
    "description": "Working directory for execution",
    "type": "string"
   },
   "yolo": {
    "default": true,
    "description": "Auto-approve everything (typical for batch jobs)",
    "type": "boolean"
   }
  },
  "required": [
   "tasks"
  ],
  "type": "object"
 },
 "name": "batch-kimi",
 "outputSchema": {
  "properties": {
   "failed": {
    "type": "number"
   },
   "results": {
    "type": "array"
   },
   "skipped": {
    "type": "number"
   },
   "successful": {
    "type": "number"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "total",
   "successful",
   "failed",
   "skipped",
   "results"
  ],
  "type": "object"
 }
}
