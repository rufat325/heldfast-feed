{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Save a topic and primary keyword, optionally linked to the selected brand's pillar. This does not generate or publish content.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {
    "additionalProperties": false,
    "description": "Create a topic from the caller's own input, then generate content from it.\n\nSupply the angle and keywords; scoring signals are derived by the system.\nA newly created topic is immediately eligible for ``POST /content/generate``.\n``primary_keyword`` is required \u2014 generation seeds from it (title/premise\nalone are not enough and would produce generic content).",
    "properties": {
     "funnel_stage": {
      "default": "tofu",
      "description": "Marketing funnel position.",
      "enum": [
       "tofu",
       "mofu",
       "bofu"
      ],
      "title": "FunnelStage",
      "type": "string"
     },
     "intent": {
      "default": "informational",
      "description": "User intent classification for SEO.",
      "enum": [
       "informational",
       "navigational",
       "transactional",
       "commercial"
      ],
      "title": "SearchIntent",
      "type": "string"
     },
     "pillar_id": {
      "anyOf": [
       {
        "format": "uuid",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Pillar Id"
     },
     "premise": {
      "anyOf": [
       {
        "maxLength": 5000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Premise"
     },
     "primary_keyword": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Primary Keyword",
      "type": "string"
     },
     "secondary_keywords": {
      "items": {
       "type": "string"
      },
      "maxItems": 20,
      "title": "Secondary Keywords",
      "type": "array"
     },
     "suggested_format": {
      "default": "blog_post",
      "description": "Output format for content generation.",
      "enum": [
       "blog_post",
       "landing_page",
       "linkedin_post",
       "linkedin_article",
       "twitter_post",
       "twitter_thread",
       "newsletter",
       "video_script",
       "podcast_outline",
       "case_study",
       "whitepaper",
       "ebook",
       "infographic",
       "webinar",
       "email_sequence"
      ],
      "title": "ContentFormat",
      "type": "string"
     },
     "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
     }
    },
    "required": [
     "title",
     "primary_keyword"
    ],
    "title": "PublicTopicCreate",
    "type": "object"
   },
   "brand_id": {
    "format": "uuid",
    "title": "Brand Id",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Stable operation key. Reuse for the same request after a dropped response; use a new key for a new intended operation.",
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[!-~]+$",
    "type": "string"
   }
  },
  "required": [
   "brand_id",
   "body",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "create_topic"
}
