{
 "description": "Configure a marketplace split rule that routes part of a payment to a subseller. Values are cents; percentages are integers 0-100.",
 "inputSchema": {
  "properties": {
   "marketplace_subseller_payments": {
    "description": "One entry per subseller receiving a split",
    "items": {
     "properties": {
      "order_id": {
       "description": "Optional subseller-side order id",
       "type": "string"
      },
      "subseller_id": {
       "description": "Getnet seller_id of the subseller",
       "type": "string"
      },
      "subseller_rate_amount": {
       "description": "Marketplace fee (cents) retained from this subseller",
       "type": "number"
      },
      "subseller_sales_amount": {
       "description": "Amount (cents) routed to this subseller",
       "type": "number"
      }
     },
     "required": [
      "subseller_sales_amount",
      "subseller_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "order_id": {
    "description": "Merchant-side order identifier",
    "type": "string"
   }
  },
  "required": [
   "order_id",
   "marketplace_subseller_payments"
  ],
  "type": "object"
 },
 "name": "create_split"
}
