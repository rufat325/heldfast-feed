{
 "description": "Update an existing opportunity. Can change pipeline, stage, status, contact, monetary value, assigned user, or source.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "assignedTo": {
    "description": "User ID to assign the opportunity to",
    "type": "string"
   },
   "contactId": {
    "description": "Associated contact ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "monetaryValue": {
    "description": "Monetary value of the opportunity",
    "type": "number"
   },
   "name": {
    "description": "Opportunity name",
    "type": "string"
   },
   "opportunityId": {
    "description": "Opportunity ID to update",
    "type": "string"
   },
   "pipelineId": {
    "description": "Pipeline ID",
    "type": "string"
   },
   "pipelineStageId": {
    "description": "Pipeline stage ID",
    "type": "string"
   },
   "source": {
    "description": "Source of the opportunity",
    "type": "string"
   },
   "status": {
    "description": "Status (open, won, lost, abandoned)",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "opportunityId"
  ],
  "type": "object"
 },
 "name": "crm_update_opportunity"
}
