{
 "description": "List, create, rename or assign product categories in a shop. list first to understand the taxonomy before adding products. rename updates the category across all products; assign moves products into a category.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "What to do",
    "enum": [
     "list",
     "create",
     "rename",
     "assign"
    ],
    "type": "string"
   },
   "categorySub": {
    "description": "assign: optional subcategory",
    "type": "string"
   },
   "categoryTop": {
    "description": "assign: top-level category",
    "type": "string"
   },
   "from": {
    "description": "rename: current category name",
    "type": "string"
   },
   "name": {
    "description": "create: top-level category name",
    "type": "string"
   },
   "productIds": {
    "description": "assign: product IDs to update",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "projectId": {
    "description": "Website project ID",
    "type": "string"
   },
   "subcategory": {
    "description": "create: optional subcategory name",
    "type": "string"
   },
   "to": {
    "description": "rename: new category name",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "action"
  ],
  "type": "object"
 },
 "name": "manage_categories"
}
