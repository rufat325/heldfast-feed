{
 "description": "Create a new platform target for device/OS/browser targeting",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "device_targets": {
    "description": "List of device patterns to target (e.g. \"Apple*\", \"Samsung Galaxy S5\")",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Platform target name",
    "type": "string"
   },
   "platform": {
    "description": "Preset platform target (default: any)",
    "enum": [
     "any",
     "specific",
     "mobile",
     "tablet",
     "mobile_and_tablet",
     "desktop"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_platform_target"
}
