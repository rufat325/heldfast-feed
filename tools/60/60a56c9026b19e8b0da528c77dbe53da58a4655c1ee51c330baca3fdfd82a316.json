{
 "description": "Complete a unique task, derive its trust tier, reject duplicate evidence, and create an Ed25519-signed receipt.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "durationSeconds": {
    "maximum": 86400,
    "minimum": 0,
    "type": "integer"
   },
   "inputTokens": {
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "nonce": {
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "outputHash": {
    "$ref": "#/properties/nonce"
   },
   "outputTokens": {
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "providerEvidence": {
    "additionalProperties": false,
    "properties": {
     "keyId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
     },
     "signature": {
      "minLength": 32,
      "type": "string"
     }
    },
    "required": [
     "keyId",
     "signature"
    ],
    "type": "object"
   }
  },
  "required": [
   "nonce",
   "inputTokens",
   "outputTokens",
   "durationSeconds",
   "outputHash"
  ],
  "type": "object"
 },
 "name": "complete_ai_task"
}
