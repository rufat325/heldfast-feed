{
 "description": "Convert CSV data to JSON array",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "csv": {
    "description": "CSV string with header row",
    "type": "string"
   },
   "delimiter": {
    "default": ",",
    "description": "Column delimiter (default: comma)",
    "type": "string"
   },
   "indent": {
    "default": 2,
    "description": "JSON indent spaces",
    "type": "number"
   }
  },
  "required": [
   "csv"
  ],
  "type": "object"
 },
 "name": "csv_to_json"
}
