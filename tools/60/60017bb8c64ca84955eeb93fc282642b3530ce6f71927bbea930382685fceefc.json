{
 "annotations": {},
 "description": "Rename a deck or change its format. Omitting format clears it. Requires IWMM_API_KEY.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deckId": {
    "description": "Deck id. Get from list_decks or create_deck.",
    "minimum": 1,
    "type": "integer"
   },
   "format": {
    "description": "Target format. Omit for no format.",
    "enum": [
     "standard",
     "commander",
     "modern",
     "legacy",
     "vintage",
     "brawl",
     "explorer",
     "historic",
     "oathbreaker",
     "pauper",
     "pioneer"
    ],
    "type": "string"
   },
   "name": {
    "description": "New deck name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "deckId",
   "name"
  ],
  "type": "object"
 },
 "name": "update_deck"
}
