{
 "annotations": {
  "readOnlyHint": true,
  "title": "List check results"
 },
 "description": "List individual run results for a check (latency, success, location, response). Public API: GET /v1/check-results/{checkId}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "checkId": {
    "description": "The check id.",
    "type": "string"
   },
   "from": {
    "description": "Start of range as a Unix timestamp (seconds).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "hasFailures": {
    "description": "Only return results that contain failures.",
    "type": "boolean"
   },
   "limit": {
    "description": "Page size.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "location": {
    "description": "Filter by run location, e.g. eu-west-1.",
    "type": "string"
   },
   "page": {
    "description": "1-based page number.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "resultType": {
    "description": "FINAL, ATTEMPT, or ALL.",
    "enum": [
     "FINAL",
     "ATTEMPT",
     "ALL"
    ],
    "type": "string"
   },
   "to": {
    "description": "End of range as a Unix timestamp (seconds).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "checkId"
  ],
  "type": "object"
 },
 "name": "checkly_list_check_results",
 "title": "List check results"
}
