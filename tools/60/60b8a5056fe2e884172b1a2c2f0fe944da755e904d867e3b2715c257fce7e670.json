{
 "description": "Render branded carousel slides (the Instagram/LinkedIn format). Layout, fonts, accent bar, page numbers, and watermark are deterministic code; backgrounds can be plain color or any image asset. Returns one asset per slide.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "spec": {
    "properties": {
     "format": {
      "default": "png",
      "enum": [
       "png",
       "webp"
      ],
      "type": "string"
     },
     "pageNumbers": {
      "default": true,
      "type": "boolean"
     },
     "size": {
      "default": "4:5",
      "enum": [
       "4:5",
       "1:1",
       "9:16"
      ],
      "type": "string"
     },
     "slides": {
      "items": {
       "properties": {
        "backgroundAsset": {
         "description": "Asset id or absolute path of a background image",
         "type": "string"
        },
        "backgroundColor": {
         "pattern": "^#[0-9a-fA-F]{6}$",
         "type": "string"
        },
        "backgroundDarken": {
         "default": 0.45,
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "body": {
         "type": "string"
        },
        "headline": {
         "type": "string"
        },
        "kicker": {
         "description": "Small uppercase eyebrow line at the top",
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "watermark": {
      "default": true,
      "description": "Brand handle bottom-left when the brand kit has one",
      "type": "boolean"
     }
    },
    "required": [
     "slides"
    ],
    "type": "object"
   }
  },
  "required": [
   "spec"
  ],
  "type": "object"
 },
 "name": "render_carousel",
 "title": "Render carousel"
}
