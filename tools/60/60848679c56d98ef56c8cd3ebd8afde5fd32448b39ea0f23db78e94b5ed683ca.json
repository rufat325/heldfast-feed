{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check email domain"
 },
 "description": "Audit the email-authentication DNS records of a domain. Returns a 0\u2013100 score and A\u2013F grade (MX 10, SPF 25, DMARC 30, DKIM 25, BIMI 10, plus up to 5 bonus points for MTA-STS and TLS-RPT, capped at 100), each check's status, published record, findings and recommended fixes, and a link to the full report. Read-only: it only queries public DNS and the domain's public MTA-STS policy file. Same engine and scoring as the DnsGuard JSON API (GET /api/check).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dkim_selector": {
    "description": "Optional DKIM selector (the s= value from a DKIM-Signature header), e.g. s1 or google. Common selectors are always tried.",
    "maxLength": 255,
    "type": "string"
   },
   "domain": {
    "description": "Domain to check, e.g. example.com. A URL or email address is accepted and reduced to its domain.",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "include_raw": {
    "default": false,
    "description": "Also return the full /api/check JSON (all records, SPF include tree, DKIM keys) in structuredContent.raw. Larger output.",
    "type": "boolean"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
