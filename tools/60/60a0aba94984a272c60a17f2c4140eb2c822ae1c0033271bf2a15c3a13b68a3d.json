{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add a financial transaction (income or expense) to an account with optional category.",
 "inputSchema": {
  "properties": {
   "account_id": {
    "description": "Account ID (see list_accounts). Defaults to the user's main account.",
    "type": "integer"
   },
   "amount": {
    "description": "Transaction amount (positive number)",
    "type": "number"
   },
   "category_id": {
    "description": "Category ID",
    "type": "integer"
   },
   "description": {
    "description": "What is this transaction for",
    "type": "string"
   },
   "notes": {
    "description": "Additional notes",
    "type": "string"
   },
   "transaction_date": {
    "description": "Date (Y-m-d, defaults to today)",
    "type": "string"
   },
   "type": {
    "description": "Transaction type",
    "enum": [
     "income",
     "expense",
     "transfer"
    ],
    "type": "string"
   }
  },
  "required": [
   "amount",
   "type",
   "description"
  ],
  "type": "object"
 },
 "name": "add_transaction",
 "title": "Add transaction"
}
