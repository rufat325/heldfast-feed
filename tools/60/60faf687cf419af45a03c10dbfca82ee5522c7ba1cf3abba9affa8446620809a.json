{
 "description": "Record an explicit, auditable training-use decision for one reviewed feedback item. This mutation requires training:manage. Approval requires consent_to_training=true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "consent_to_training": {
    "type": "boolean"
   },
   "feedback_id": {
    "format": "uuid",
    "type": "string"
   },
   "idempotency_key": {
    "description": "reuse the operation key returned by an ambiguous prior attempt; omit for a new operation",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   },
   "reason": {
    "anyOf": [
     {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "training_use": {
    "enum": [
     "approved",
     "withheld"
    ],
    "type": "string"
   }
  },
  "required": [
   "feedback_id",
   "training_use",
   "consent_to_training"
  ],
  "type": "object"
 },
 "name": "record_training_feedback_consent"
}
