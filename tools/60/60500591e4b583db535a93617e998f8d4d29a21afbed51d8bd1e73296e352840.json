{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Returns recent session diagnostic entries for the given SESSION_ID.",
 "inputSchema": {
  "properties": {
   "SESSION_ID": {
    "description": "Session identifier to tail.",
    "type": "string"
   },
   "cursor": {
    "description": "Return entries with seq > cursor. Start with 0.",
    "type": "number"
   },
   "limit": {
    "description": "Maximum number of entries to return (default 50, max 200).",
    "type": "number"
   }
  },
  "required": [
   "SESSION_ID"
  ],
  "type": "object"
 },
 "name": "tail_session",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "SESSION_ID": {
    "type": "string"
   },
   "dropped": {
    "type": "boolean"
   },
   "dropped_before": {
    "type": "integer"
   },
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "seq": {
       "type": "integer"
      },
      "ts": {
       "type": "string"
      }
     },
     "required": [
      "seq",
      "ts",
      "kind",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "found": {
    "type": "boolean"
   },
   "next_cursor": {
    "type": "integer"
   },
   "state": {
    "type": "string"
   }
  },
  "required": [
   "found",
   "SESSION_ID",
   "next_cursor"
  ],
  "type": "object"
 },
 "title": "Tail Session"
}
