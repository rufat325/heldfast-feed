{
 "_meta": {
  "agent-utilities/exampleUrl": null,
  "agent-utilities/priceMicroUsd": 500
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Return dated Wikipedia article links ranked by official daily pageviews, with namespace filtering and original rank/view counts. PAID: 500 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "date": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "language": {
      "default": "en",
      "enum": [
       "en",
       "es",
       "de",
       "fr",
       "it",
       "pt",
       "ja",
       "zh",
       "ru",
       "ar"
      ],
      "type": "string"
     },
     "limit": {
      "default": 25,
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "date"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "web_wikipedia_popular",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "availableEntries": {
    "type": "number"
   },
   "date": {
    "type": "string"
   },
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "rank": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "views": {
       "type": "number"
      }
     },
     "required": [
      "title",
      "url",
      "rank",
      "views"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "language": {
    "type": "string"
   },
   "namespaceFilter": {
    "additionalProperties": false,
    "properties": {
     "mainPage": {
      "type": "string"
     },
     "retrievedAt": {
      "type": "string"
     },
     "sourceUrl": {
      "type": "string"
     }
    },
    "required": [
     "sourceUrl",
     "retrievedAt",
     "mainPage"
    ],
    "type": "object"
   },
   "ranking": {
    "type": "string"
   },
   "retrievedAt": {
    "type": "string"
   },
   "sourceUrl": {
    "type": "string"
   }
  },
  "required": [
   "sourceUrl",
   "date",
   "language",
   "retrievedAt",
   "namespaceFilter",
   "ranking",
   "entries",
   "availableEntries"
  ],
  "type": "object"
 }
}
