{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs pip show and returns structured package metadata (name, version, summary, dependencies). Supports multiple packages in a single call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "files": {
    "default": false,
    "description": "List installed files for the package (-f, --files)",
    "type": "boolean"
   },
   "package": {
    "description": "Single package name to show (for backward compatibility)",
    "maxLength": 255,
    "type": "string"
   },
   "packages": {
    "description": "Package names to show (supports multiple packages)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "pip-show",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "author": {
    "type": "string"
   },
   "authorEmail": {
    "type": "string"
   },
   "classifiers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "homepage": {
    "type": "string"
   },
   "license": {
    "type": "string"
   },
   "location": {
    "type": "string"
   },
   "metadataVersion": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "packageCount": {
    "description": "Number of packages returned (set in compact output)",
    "type": "number"
   },
   "packages": {
    "description": "Array of package info (one or more); omitted in compact output",
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": "string"
      },
      "authorEmail": {
       "type": "string"
      },
      "classifiers": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "homepage": {
       "type": "string"
      },
      "license": {
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "metadataVersion": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "requiredBy": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "requires": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "summary": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "version",
      "summary"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "requiredBy": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "requires": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   },
   "summary": {
    "type": "string"
   },
   "version": {
    "type": "string"
   }
  },
  "required": [
   "success",
   "name",
   "version",
   "summary"
  ],
  "type": "object"
 },
 "title": "pip Show"
}
