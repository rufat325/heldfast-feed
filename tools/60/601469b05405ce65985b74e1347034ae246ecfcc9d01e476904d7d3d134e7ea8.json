{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Fetch read-only install, config, usage, and package guidance for a HeyClaude entry.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Category of the entry (e.g. 'mcp', 'skills').",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   },
   "platform": {
    "description": "Target platform to tailor the install steps (e.g. 'claude-desktop', 'cursor').",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "description": "Slug of the entry to get install guidance for.",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   }
  },
  "required": [
   "category",
   "slug"
  ],
  "type": "object"
 },
 "name": "install.guidance",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "ok": {
    "type": "boolean"
   },
   "policy": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
