{
 "_meta": {
  "heffl/page": "https://heffl.com/tools/retainer-agreement-template"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate the website's monthly retainer agreement as plain text. Missing text fields use placeholders. Draft only; legal review may be needed. Free, no authentication required. Rate limited.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "clientName": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "contractTerm": {
    "default": "Month-to-month",
    "enum": [
     "Month-to-month",
     "3-month minimum",
     "6-month minimum",
     "12-month term"
    ],
    "type": "string"
   },
   "includedScope": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "monthlyFee": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "noticePeriod": {
    "default": "30 days written notice",
    "enum": [
     "30 days written notice",
     "60 days written notice",
     "14 days written notice"
    ],
    "type": "string"
   },
   "overageRate": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "paymentDue": {
    "default": "1st of each month, in advance",
    "enum": [
     "1st of each month, in advance",
     "Net 15",
     "Net 30"
    ],
    "type": "string"
   },
   "providerName": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "serviceType": {
    "default": "ongoing marketing and design services",
    "maxLength": 2000,
    "type": "string"
   },
   "startDate": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "retainer_agreement",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "format": {
    "const": "text/plain",
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text",
   "format",
   "notice"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Retainer agreement template"
}
