{
 "description": "Get all grades for the current student in a course",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "courseId": {
    "description": "Blackboard course ID",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   }
  },
  "required": [
   "courseId"
  ],
  "type": "object"
 },
 "name": "blackboard_get_grades"
}
