{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Call a Stophy endpoint"
 },
 "description": "Get the data from the endpoint you chose, with the credits used.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "examples": [
   {
    "fields": [
     "title",
     "url"
    ],
    "id": "redditSearch",
    "input": {
     "query": "bun runtime"
    }
   }
  ],
  "properties": {
   "fields": {
    "description": "Keys to keep, such as [\"title\", \"url\"]. They apply to each row of a results list, otherwise to the response. Dot paths reach nested keys, such as \"comments.author\". Unknown names are rejected.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "id": {
    "description": "Endpoint id from stophy_search_endpoints.",
    "minLength": 1,
    "type": "string"
   },
   "input": {
    "additionalProperties": {},
    "description": "JSON body for that endpoint. Omit keys you are not setting.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "maxTextLength": {
    "description": "Cut each text value to this many characters. Omit it for full text.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "stophy_call",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "creditsUsed": {
    "type": "number"
   },
   "data": {
    "description": "The endpoint's result. Its shape is in stophy_describe_endpoint."
   },
   "requestId": {
    "type": "string"
   },
   "success": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "data",
   "creditsUsed",
   "requestId"
  ],
  "type": "object"
 },
 "title": "Call a Stophy endpoint"
}
