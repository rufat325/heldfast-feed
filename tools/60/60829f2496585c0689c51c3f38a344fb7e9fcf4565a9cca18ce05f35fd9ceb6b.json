{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search products"
 },
 "description": "Search products from independent Shopify merchants. Returns products with a display price, store count, a Dercora product page `url`, and the merchant `buyUrl`. Pass `ships_to` (ISO country) so prices and availability match the buyer. Use `nextCursor` for more results.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "currency": {
    "description": "ISO 4217 presentment currency, e.g. EUR.",
    "type": "string"
   },
   "cursor": {
    "description": "`nextCursor` from a previous search.",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "description": "Maximum price in major units.",
    "minimum": 0,
    "type": "number"
   },
   "min_price": {
    "description": "Minimum price in major units.",
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "What the user is looking for, in natural language.",
    "type": "string"
   },
   "ships_to": {
    "description": "ISO 3166-1 alpha-2 country the buyer ships to, e.g. US, DE, JP.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_products",
 "outputSchema": {
  "properties": {
   "currency": {
    "type": "string"
   },
   "disclosure": {
    "type": "string"
   },
   "nextCursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "products": {
    "items": {
     "properties": {
      "buyUrl": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "string"
      },
      "price": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sellerCount": {
       "type": "integer"
      },
      "sponsored": {
       "type": "boolean"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "shipsTo": {
    "type": "string"
   }
  },
  "required": [
   "products",
   "disclosure"
  ],
  "type": "object"
 },
 "title": "Search products"
}
