{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Browse the mined content in a collection \u2014 posts/comments/profiles with author, content, engagement and engagementScore. sort 'top' ranks by engagement (great for picking the best clips/posts to reuse or distill into a persona).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collectionId": {
    "description": "The collection id.",
    "type": "string"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "top = highest engagement first (default recent).",
    "enum": [
     "top",
     "recent"
    ],
    "type": "string"
   },
   "type": {
    "description": "Filter by item type (post|comment|profile|page|custom).",
    "type": "string"
   }
  },
  "required": [
   "collectionId"
  ],
  "type": "object"
 },
 "name": "neuron_get_collection_items",
 "title": "Browse collection items"
}
