{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "One event from the UMD campus calendar by id or slug, with its full description, location, contact and recurrence rule. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Event id from calendar_search_events",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "slug": {
    "description": "URL slug, e.g. \"terps-after-dark-3\"; used when id is not given",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "calendar_get_event",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "all_day": {
    "type": "boolean"
   },
   "audiences": {
    "description": "Audience categories (unknown new ones are dropped)",
    "items": {
     "enum": [
      "current-students",
      "graduate-students",
      "prospective-students",
      "alumni",
      "faculty",
      "staff",
      "parents",
      "friends",
      "campus-leaders",
      "external-media"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "calendar": {
    "description": "Which of the site's calendars the event is in",
    "enum": [
     "submission",
     "communications",
     "athletics"
    ],
    "type": "string"
   },
   "contact": {
    "additionalProperties": false,
    "properties": {
     "email": {
      "type": [
       "string",
       "null"
      ]
     },
     "name": {
      "type": [
       "string",
       "null"
      ]
     },
     "phone": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "name",
     "phone",
     "email"
    ],
    "type": "object"
   },
   "description": {
    "description": "Full description as plain text",
    "type": [
     "string",
     "null"
    ]
   },
   "end": {
    "description": "ISO 8601 with the America/New_York offset, e.g. \"2026-10-01T14:00:00-04:00\"",
    "type": "string"
   },
   "event_types": {
    "description": "Event-type categories (unknown new ones are dropped)",
    "items": {
     "enum": [
      "academics",
      "athletics-and-recreation",
      "arts-entertainment-and-culture",
      "community-engagement",
      "diversity-inclusion",
      "health-and-wellness",
      "research",
      "spiritual-and-religious",
      "student-life",
      "family-engagement"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "featured": {
    "description": "true when the site marks the event as featured",
    "type": "boolean"
   },
   "id": {
    "description": "Event id to pass to calendar_get_event",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "image_url": {
    "description": "Hero image; append ?w=&h=&fit=crop to resize",
    "type": [
     "string",
     "null"
    ]
   },
   "location": {
    "additionalProperties": false,
    "properties": {
     "address": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "city": {
          "type": [
           "string",
           "null"
          ]
         },
         "name": {
          "description": "Place name, if given",
          "type": [
           "string",
           "null"
          ]
         },
         "state": {
          "type": [
           "string",
           "null"
          ]
         },
         "street": {
          "description": "Street lines, blank lines dropped",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "zip": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "street",
         "city",
         "state",
         "zip",
         "name"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "Postal address for off-campus events; null otherwise"
     },
     "off_campus_name": {
      "description": "Off-campus venue name",
      "type": [
       "string",
       "null"
      ]
     },
     "off_campus_url": {
      "description": "Off-campus venue website",
      "type": [
       "string",
       "null"
      ]
     },
     "type": {
      "anyOf": [
       {
        "enum": [
         "on_campus",
         "online",
         "off_campus"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "null when the event does not say"
     },
     "venue": {
      "description": "Free-text on-campus location, e.g. \"Stamp Student Union, Room 1101\"",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "type",
     "venue",
     "off_campus_name",
     "off_campus_url",
     "address"
    ],
    "type": "object"
   },
   "multi_day": {
    "type": "boolean"
   },
   "posted": {
    "description": "When the event was published, e.g. \"2026-08-27 10:49:00\"",
    "type": [
     "string",
     "null"
    ]
   },
   "recurrence": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "by_day": {
        "description": "e.g. \"MO,WE\"",
        "type": [
         "string",
         "null"
        ]
       },
       "by_month": {
        "type": [
         "string",
         "null"
        ]
       },
       "by_month_day": {
        "type": [
         "string",
         "null"
        ]
       },
       "count": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "frequency": {
        "description": "e.g. \"WEEKLY\"",
        "type": [
         "string",
         "null"
        ]
       },
       "interval": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "rrule": {
        "description": "The RFC 5545 RRULE string",
        "type": [
         "string",
         "null"
        ]
       },
       "until": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "rrule",
       "frequency",
       "interval",
       "count",
       "until",
       "by_day",
       "by_month",
       "by_month_day"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Recurrence rule; null for a one-off event"
   },
   "slug": {
    "description": "URL slug; also accepted by calendar_get_event",
    "type": "string"
   },
   "start": {
    "description": "ISO 8601 with the America/New_York offset, e.g. \"2026-10-01T14:00:00-04:00\"",
    "type": "string"
   },
   "summary": {
    "description": "Short blurb as plain text",
    "type": [
     "string",
     "null"
    ]
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "description": "Public page on calendar.umd.edu",
    "type": "string"
   }
  },
  "required": [
   "id",
   "slug",
   "title",
   "url",
   "start",
   "end",
   "all_day",
   "multi_day",
   "summary",
   "description",
   "image_url",
   "event_types",
   "audiences",
   "featured",
   "tags",
   "location",
   "contact",
   "calendar",
   "posted",
   "recurrence"
  ],
  "type": "object"
 },
 "title": "Get a campus event"
}
