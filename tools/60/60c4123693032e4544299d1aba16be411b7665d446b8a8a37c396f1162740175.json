{
 "_meta": {
  "openai/outputTemplate": "ui://applytovolunteer/form-preview.html",
  "ui": {
   "resourceUri": "ui://applytovolunteer/form-preview.html"
  },
  "ui/resourceUri": "ui://applytovolunteer/form-preview.html"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Grade a volunteer form"
 },
 "description": "Grade a blank volunteer form from pasted text or a document URL. No API key. Send a url or text, not both. Uses the on-server grader only: Workers AI and other models stay off. Returns score, letter grade, fixes (the top recommendations), and reportUrl (/tools/r/{id}) for the public share page when one is stored. Restricted fields such as Social Security numbers are left out of parsed; the score still counts them. Anonymous use shares the Form Grader limit of 5 per network per day and counts toward the daily anonymous MCP cap. An organization hourly limit applies when an org API key with the forms:read scope is sent. Does not grade a saved form.",
 "inputSchema": {
  "additionalProperties": false,
  "oneOf": [
   {
    "not": {
     "anyOf": [
      {
       "required": [
        "text"
       ]
      }
     ]
    },
    "required": [
     "url"
    ]
   },
   {
    "not": {
     "anyOf": [
      {
       "required": [
        "url"
       ]
      }
     ]
    },
    "required": [
     "text"
    ]
   }
  ],
  "properties": {
   "text": {
    "description": "Pasted blank form text.",
    "type": "string"
   },
   "url": {
    "description": "https URL of a blank volunteer form.",
    "format": "uri",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "grade_form",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fixes": {
    "description": "Top fixes, the same recommendations as report.recommendations.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "description": "What to change on the form.",
       "type": "string"
      },
      "id": {
       "description": "Stable id for this fix.",
       "type": "string"
      },
      "severity": {
       "enum": [
        "critical",
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "title": {
       "description": "Short name of the fix.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "severity",
      "title",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "grade": {
    "description": "Letter grade.",
    "enum": [
     "A",
     "B",
     "C",
     "D",
     "F"
    ],
    "type": "string"
   },
   "parsed": {
    "additionalProperties": true,
    "description": "Parsed form. Restricted fields are left out.",
    "properties": {
     "fields": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "label": {
         "type": "string"
        },
        "type": {
         "type": "string"
        }
       },
       "required": [
        "label",
        "type"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "title"
    ],
    "type": "object"
   },
   "parser": {
    "const": "heuristic",
    "description": "Set on anonymous grades. Workers AI stays off.",
    "type": "string"
   },
   "report": {
    "additionalProperties": true,
    "description": "Full grade report. Restricted field labels are left out.",
    "properties": {
     "grade": {
      "enum": [
       "A",
       "B",
       "C",
       "D",
       "F"
      ],
      "type": "string"
     },
     "recommendations": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "detail": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "severity": {
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "severity",
        "title",
        "detail"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "score": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "score",
     "grade",
     "recommendations"
    ],
    "type": "object"
   },
   "reportId": {
    "type": "string"
   },
   "reportUrl": {
    "description": "Public report path, /tools/r/{reportId}, when one is stored.",
    "type": "string"
   },
   "score": {
    "description": "Score from 0 to 100.",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "report",
   "parsed",
   "reportId",
   "score",
   "grade",
   "fixes"
  ],
  "type": "object"
 },
 "title": "Grade a volunteer form"
}
