     "budget",
     "moderate",
     "luxury"
    ],
    "type": "string"
   },
   "days": {
    "description": "Number of days",
    "minimum": 1,
    "type": "number"
   },
   "destination": {
    "description": "Travel destination",
    "type": "string"
   },
   "origin": {
    "description": "Where traveling from",
