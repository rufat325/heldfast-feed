{
 "description": "List, read, update or fulfil store orders. update_status/bulk_update_status: confirm with the user before cancelling/refunding/completing \u2014 this matters even more for bulk changes since they affect many orders at once. fulfill marks an order shipped and optionally saves tracking details. bulk_update_status only changes the status label \u2014 it does not touch shipment/tracking columns, use fulfill or manage_shipping(generate_label) for that.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "What to do",
    "enum": [
     "list",
     "get",
     "update_status",
     "fulfill",
     "bulk_update_status"
    ],
    "type": "string"
   },
   "limit": {
    "description": "list: max orders",
    "type": "number"
   },
   "note": {
    "description": "fulfill: optional note",
    "type": "string"
   },
   "offset": {
    "description": "list: pagination offset",
    "type": "number"
   },
   "orderId": {
    "description": "Order ID \u2014 required for get/update_status/fulfill",
    "type": "string"
   },
   "orderIds": {
    "description": "bulk_update_status: order IDs to change",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "projectId": {
    "description": "Website project ID",
    "type": "string"
   },
   "shippedAt": {
    "description": "fulfill: optional ISO timestamp",
    "type": "string"
   },
   "status": {
    "description": "update_status/bulk_update_status: the new status. Also usable as a list filter.",
    "enum": [
     "pending",
     "processing",
     "paid",
     "shipped",
     "completed",
     "cancelled",
     "refunded"
    ],
    "type": "string"
   },
   "trackingCarrier": {
    "description": "fulfill: carrier name",
    "type": "string"
   },
   "trackingNumber": {
    "description": "fulfill: tracking number",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "action"
  ],
  "type": "object"
 },
 "name": "manage_orders"
}
