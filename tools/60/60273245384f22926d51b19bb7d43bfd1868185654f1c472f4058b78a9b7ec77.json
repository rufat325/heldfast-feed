{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store a learning (pattern, mistake, insight, etc.). Gatekeeper prevents duplicates.",
 "inputSchema": {
  "properties": {
   "category": {
    "enum": [
     "pattern",
     "mistake",
     "insight",
     "research",
     "architecture",
     "infrastructure",
     "tool",
     "workflow",
     "performance",
     "security"
    ],
    "type": "string"
   },
   "confidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "content": {
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
   "memoryType": {
    "enum": [
     "episodic",
     "semantic"
    ],
    "type": "string"
   },
   "project": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "category",
   "content"
  ],
  "type": "object"
 },
 "name": "memory_learn"
}
