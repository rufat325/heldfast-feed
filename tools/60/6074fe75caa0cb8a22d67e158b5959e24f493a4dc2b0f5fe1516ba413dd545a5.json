  "title": "Get Account PnL"
 },
 "description": "Get PnL (cost basis) and yield earned for an Arcadia account. Returns lifetime totals: cost basis vs current value (negative cost_basis = net profit withdrawn), net transfers per token, total yield earned in USD and per token. cost_basis, current_value, cost_diff are in USD (human-readable). Per-token fields (net_transfers, summed_yields_earned) are in raw token units.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account_address": {
    "description": "Arcadia account address",
    "type": "string"
   },
   "chain_id": {
    "default": 8453,
    "description": "Chain ID: 8453 (Base), 130 (Unichain), or 10 (Optimism)",
    "type": "number"
   }
  },
  "required": [
   "account_address"
  ],
  "type": "object"
 },
 "name": "read.account.pnl",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "pnl_cost_basis": {
    "additionalProperties": {},
    "type": "object"
   },
   "yield_earned": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "pnl_cost_basis",
   "yield_earned"
  ],
  "type": "object"
 }
}
