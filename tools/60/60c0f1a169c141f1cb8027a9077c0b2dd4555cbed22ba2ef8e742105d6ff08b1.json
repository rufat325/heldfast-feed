{
 "_meta": {
  "openai/outputTemplate": "ui://haus/widgets/v2",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://haus/widgets/v2",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Save a recipe with optional ingredients, source URL, instructions and servings. Link it to a date with create_meal_plan.",
 "inputSchema": {
  "examples": [
   {
    "ingredients": [
     {
      "name": "chicken breast",
      "quantity": 2
     },
     {
      "name": "tomato",
      "quantity": 4
     }
    ],
    "instructions": "Marinate the chicken, then simmer in the spiced tomato sauce for 20 minutes.",
    "name": "Chicken Tikka Masala",
    "servings": 4,
    "url": "https://example.com/recipes/chicken-tikka-masala"
   }
  ],
  "properties": {
   "ingredients": {
    "description": "Ingredients.",
    "items": {
     "description": "One ingredient and its quantity.",
     "properties": {
      "name": {
       "description": "Ingredient name.",
       "examples": [
        "chicken breast"
       ],
       "type": "string"
      },
      "quantity": {
       "description": "Whole-number quantity, minimum 1. No fractions or units.",
       "examples": [
        2
       ],
       "type": "integer"
      }
     },
     "required": [
      "name",
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "instructions": {
    "description": "Cooking method.",
    "examples": [
     "Marinate the chicken, then simmer in the spiced tomato sauce for 20 minutes."
    ],
    "type": "string"
   },
   "name": {
    "description": "Recipe name.",
    "examples": [
     "Chicken Tikka Masala"
    ],
    "type": "string"
   },
   "servings": {
    "description": "Servings the recipe yields, minimum 1.",
    "examples": [
     4
    ],
    "type": "integer"
   },
   "url": {
    "description": "Source URL.",
    "examples": [
     "https://example.com/recipes/chicken-tikka-masala"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_recipe",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "variant": {
    "enum": [
     "list",
     "detail",
     "confirmation"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 }
}
