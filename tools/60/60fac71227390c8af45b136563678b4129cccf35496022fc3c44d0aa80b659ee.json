{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "CNAME Lookup"
 },
 "description": "Free public API. Resolve a hostname's CNAME chain. Useful for debugging custom-domain CNAME setups.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "host": {
    "description": "Hostname to resolve, e.g. www.example.com.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "host"
  ],
  "type": "object"
 },
 "name": "tools_cname_lookup",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "The hostname's CNAME target and what it resolves to.",
  "properties": {
   "data": {
    "additionalProperties": true,
    "properties": {
     "aRecords": {
      "description": "A records of the target.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "cnames": {
      "description": "CNAME answers; empty if the host has no CNAME.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "host": {
      "type": "string"
     },
     "isApex": {
      "type": "boolean"
     },
     "target": {
      "description": "First CNAME target, or null.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "host",
     "isApex",
     "cnames",
     "aRecords"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Always true here; failures return an isError result instead.",
    "type": "boolean"
   }
  },
  "required": [
   "ok",
   "data"
  ],
  "type": "object"
 },
 "title": "CNAME Lookup"
}
