{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"SPF Record Checker"},"description":"Check the SPF record for a domain. Returns the raw record, grade (A-F), the terminal `all` qualifier (resolved through redirect= chains), structured findings (NEAR_LOOKUP_LIMIT, LOOKUP_LIMIT_EXCEEDED, PLUS_ALL_DANGEROUS, PTR_MECHANISM_DEPRECATED, etc.), and an `analysis` block with the expanded include/redirect tree and the RFC 7208 \u00a74.6.4 lookup count. Read-only.","inputSchema":{"additionalProperties":false,"properties":{"domain":{"description":"Apex domain to inspect, e.g. \"google.com\". No scheme, no path.","maxLength":253,"pattern":"^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$","type":"string"}},"required":["domain"],"type":"object"},"name":"check_spf","outputSchema":{"properties":{"analysis":{"type":"object"},"error":{"properties":{"code":{"type":"string"},"message":{"type":"string"},"retriable":{"type":"boolean"},"retry_after":{"type":"integer"}},"required":["code","message","retriable"],"type":"object"},"findings":{"items":{"properties":{"code":{"pattern":"^[A-Z][A-Z0-9_]+$","type":"string"},"explanation":{"type":"string"},"remediation":{"type":"string"},"severity":{"enum":["info","warn","error"],"type":"string"},"title":{"type":"string"},"value":{"type":"string"}},"required":["code","severity","title"],"type":"object"},"type":"array"},"grade":{"enum":["A","B","C","D","F"],"type":"string"},"grade_reasons":{"items":{"type":"string"},"type":"array"},"input":{"type":"object"},"provenance":{"properties":{"operated_by":{"type":"string"}},"required":["operated_by"],"type":"object"},"records":{"items":{"properties":{"data":{"type":"string"},"name":{"type":"string"},"ttl":{"type":"integer"},"type":{"type":"string"}},"required":["name","type","ttl","data"],"type":"object"},"type":"array"},"resolvers":{"type":"array"},"schema_version":{"const":2,"type":"integer"},"status":{"enum":["pass","warn","fail","info","error"],"type":"string"},"timestamp":{"type":"string"},"tool":{"type":"string"},"tool_version":{"type":"string"},"verdict":{"type":"string"}},"required":["tool","tool_version","schema_version","input","status","findings","timestamp","provenance"],"type":"object"},"title":"SPF Record Checker"}
