   "interval": {
    "default": "1h",
    "enum": [
     "1m",
     "5m",
     "15m",
     "30m",
     "1h",
     "4h",
     "12h",
     "1d",
     "1w",
     "1M"
    ],
    "type": "string"
   },
   "limit": {
    "default": 120,
    "maximum": 500,
    "minimum": 20,
    "type": "integer"
   },
   "symbol": {
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "get_price_history",
 "title": "Price candles and trend"
}
