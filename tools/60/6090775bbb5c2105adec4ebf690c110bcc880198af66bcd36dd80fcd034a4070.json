{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get activation (execution) history for a specific action",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actionName": {
    "description": "Name of the action",
    "type": "string"
   },
   "end": {
    "description": "End time filter (format: yyyy-MM-ddTHH:mm:ss)",
    "type": "string"
   },
   "packageName": {
    "description": "Package name containing the action",
    "type": "string"
   },
   "pageNo": {
    "description": "Page number for pagination",
    "type": "number"
   },
   "pageSize": {
    "description": "Page size for pagination",
    "type": "number"
   },
   "platform": {
    "default": "vpc",
    "description": "Platform type (default: vpc)",
    "enum": [
     "vpc",
     "classic"
    ],
    "type": "string"
   },
   "start": {
    "description": "Start time filter (format: yyyy-MM-ddTHH:mm:ss)",
    "type": "string"
   }
  },
  "required": [
   "packageName",
   "actionName"
  ],
  "type": "object"
 },
 "name": "ncloud_functions_get_action_activations"
}
