{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Apply the exact reviewed configuration promotion after user confirmation with confirm=true and review_digest. Writes the target environment's variable group (secrets re-sealed under it) and each paired component's user variables \u2014 running containers are untouched; the change takes effect on each app's next deploy (roll it out with impreza_deploy_environment). Repeating the same promotion returns its receipt. Requires unrestricted account credentials and deploy scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "const": true,
    "type": "boolean"
   },
   "promotion_id": {
    "pattern": "^cpro_[a-f0-9]{24}$",
    "type": "string"
   },
   "review_digest": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "promotion_id",
   "review_digest",
   "confirm"
  ],
  "type": "object"
 },
 "name": "impreza_apply_config_promotion",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "receipt": {
      "type": "object"
     },
     "replayed": {
      "type": "boolean"
     }
    },
    "required": [
     "receipt",
     "replayed"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Apply config promotion"
}
