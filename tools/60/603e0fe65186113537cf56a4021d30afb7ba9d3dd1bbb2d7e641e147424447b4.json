 "description": "\u3010\u9700\u8981\u767b\u5f55\u3011activityId/organizationId\u81f3\u591a\u4e00\u4e2a\uff0c\u5747\u65e0\u662f\u516c\u57df\u3002\u9ed8\u8ba4\u9884\u89c8\uff1b\u672c\u4eba\u660e\u786e\u540c\u610f\u5bf9\u8c61/\u7406\u7531\u540e\uff0c\u540c\u53c2+previewHash\u3001consent=true\u3001preview=false\u6267\u884c\u3002note\u7531\u672c\u4eba\u63d0\u4f9b\uff1b\u9009\u586bcontact\u987b\u672c\u4eba\u63d0\u4f9b\u5e76\u660e\u786e\u5206\u4eab+shareContactConsent=true\uff0c\u7981\u6b62\u53d6\u767b\u5f55\u624b\u673a/\u6863\u6848\u3002\u4f1a\u901a\u77e5\u5bf9\u65b9\uff0c\u4e0d\u4ee3\u8868\u63a5\u53d7\uff1b\u6267\u884c\u91cd\u9a8c\u53cc\u5411\u53ef\u89c1\u6027\u3001\u5c4f\u853d\u3001\u72b6\u6001\u548c\u989d\u5ea6\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activityId": {
    "$ref": "#/properties/targetUserId"
   },
   "consent": {
    "const": true,
    "description": "\u7528\u6237\u660e\u786e\u540c\u610f\u672c\u6b21\u5bf9\u8c61\u53ca\u540e\u679c\u624d\u4f20 true",
    "type": "boolean"
   },
   "contact": {
    "description": "\u672c\u4eba\u63d0\u4f9b\u4e14\u660e\u786e\u540c\u610f\u5206\u4eab\uff1b\u7981\u6b62\u81ea\u52a8\u53d6\u624b\u673a\u53f7/\u6863\u6848",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "note": {
    "maxLength": 500,
    "minLength": 2,
    "type": "string"
   },
   "organizationId": {
    "$ref": "#/properties/targetUserId"
   },
   "preview": {
    "default": true,
    "type": "boolean"
   },
   "previewHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "shareContactConsent": {
    "const": true,
    "type": "boolean"
   },
   "targetUserId": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
