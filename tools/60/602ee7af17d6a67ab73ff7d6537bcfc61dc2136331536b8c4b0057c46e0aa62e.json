{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Quality-ranked tools inside one curated collection. Critical-risk tools are excluded by default (risk_filter); every result carries risk_level and risk_reasons.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_high_risk": {
    "description": "Deprecated alias for risk_filter=none",
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "risk_filter": {
    "default": "exclude_critical",
    "description": "Risk gate: exclude_critical omits critical risk (default); exclude_high omits high and critical risk; none omits no risk levels",
    "enum": [
     "exclude_critical",
     "exclude_high",
     "none"
    ],
    "type": "string"
   },
   "slug": {
    "enum": [
     "mcp-servers",
     "database-migrations",
     "cicd-devops",
     "testing-qa",
     "browser-automation",
     "security-audit",
     "frontend-react",
     "code-review",
     "data-analytics"
    ],
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_collection",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "collection": {
    "additionalProperties": false,
    "properties": {
     "slug": {
      "type": "string"
     },
     "tagline": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "title",
     "tagline"
    ],
    "type": "object"
   },
   "count": {
    "type": "number"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "composite_score": {
       "type": "number"
      },
      "description": {
       "type": "string"
      },
      "is_official": {
       "type": "boolean"
      },
      "last_commit_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "platforms": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "profile_url": {
       "type": "string"
      },
      "quality_score": {
       "type": "number"
      },
      "repo_url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "risk_level": {
       "type": "string"
      },
      "risk_reasons": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "slug": {
       "type": "string"
      },
      "stars": {
       "type": "number"
      },
      "tier": {
       "enum": [
        "curated",
        "promising",
        "experimental",
        "review_required"
       ],
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "verification": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "commit_sha": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "failing_check": {
           "additionalProperties": false,
           "properties": {
            "id": {
             "type": "string"
            },
            "path": {
             "anyOf": [
              {
               "type": "string"
              },
              {
               "type": "null"
              }
             ]
            }
           },
           "required": [
            "id",
            "path"
           ],
           "type": "object"
          },
          "stale": {
           "type": "boolean"
          },
          "status": {
           "type": "string"
          },
          "tier": {
           "anyOf": [
            {
             "enum": [
              "runs",
              "loads-clean"
             ],
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "verified_at": {
           "type": "string"
          }
         },
         "required": [
          "status",
          "tier",
          "commit_sha",
          "verified_at",
          "stale"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "slug",
      "tier",
      "quality_score",
      "composite_score",
      "risk_level",
      "risk_reasons",
      "type",
      "category",
      "platforms",
      "description",
      "repo_url",
      "profile_url",
      "stars",
      "is_official",
      "last_commit_at",
      "verification"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_in_collection": {
    "type": "number"
   }
  },
  "required": [
   "collection",
   "total_in_collection",
   "count",
   "results"
  ],
  "type": "object"
 },
 "title": "Get collection"
}
