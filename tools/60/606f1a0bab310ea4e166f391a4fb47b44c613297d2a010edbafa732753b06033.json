{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "List drops owned by the authenticated account (requires an sp_ API key; anonymous drops are not listable). Returns slug, url, name, file counts, expiry and password_protected, newest first.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max drops to return (1-500, default 100).",
    "type": "integer"
   },
   "offset": {
    "description": "Number of drops to skip (default 0).",
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_drops",
 "outputSchema": {
  "properties": {
   "drops": {
    "items": {
     "properties": {
      "created_at": {
       "type": "string"
      },
      "expires_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "file_count": {
       "type": "integer"
      },
      "name": {
       "type": [
        "string",
        "null"
       ]
      },
      "password_protected": {
       "type": "boolean"
      },
      "redeploy_count": {
       "type": "integer"
      },
      "slug": {
       "type": "string"
      },
      "updated_at": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "url",
      "password_protected"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "integer"
   }
  },
  "required": [
   "total",
   "drops"
  ],
  "type": "object"
 },
 "title": "List your drops"
}
