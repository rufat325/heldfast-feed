{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update project update"
 },
 "description": "Update an existing project update by ID. Requires project_updates:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "author_id": {
    "description": "Author Clerk user ID",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "content": {
    "description": "Update content",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Project update ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "period_value": {
    "description": "Period value",
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   },
   "period_year": {
    "description": "Year for this update period",
    "maximum": 2100,
    "minimum": 2000,
    "type": "integer"
   },
   "project_id": {
    "description": "Project ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "timeframe": {
    "description": "Update timeframe",
    "enum": [
     "monthly",
     "quarterly",
     "bi-annually",
     "annually"
    ],
    "type": "string"
   },
   "title": {
    "description": "Optional custom title",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_project_update",
 "title": "Update project update"
}
