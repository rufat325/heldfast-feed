{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Trigger an automation rule to run against a specific test cycle. testCycleId is the internal id string (from qtm4j_get_test_cycle). Returns a background task object with taskId and progressUrl.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "automationRuleKey": {
    "description": "Automation rule key to run",
    "type": "string"
   },
   "projectId": {
    "description": "Jira project numeric ID (e.g. 10000)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "testCycleId": {
    "description": "Internal test cycle ID (from qtm4j_search_test_cycles)",
    "type": "string"
   }
  },
  "required": [
   "automationRuleKey",
   "projectId",
   "testCycleId"
  ],
  "type": "object"
 },
 "name": "qtm4j_run_automation_rules",
 "title": "Run Automation Rule"
}
