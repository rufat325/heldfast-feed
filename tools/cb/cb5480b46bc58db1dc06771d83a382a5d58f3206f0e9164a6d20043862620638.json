{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Fill Template"
 },
 "description": "Create a document. Preview first, then confirm to generate PDF.",
 "inputSchema": {
  "properties": {
   "confirm": {
    "default": false,
    "description": "Set true to generate PDF (preview runs first if false)",
    "type": "boolean"
   },
   "data": {
    "description": "Template variables as key-value pairs",
    "type": "object"
   },
   "margin": {
    "description": "Page margin (e.g., '1in', '20mm')",
    "type": "string"
   },
   "orientation": {
    "description": "Page orientation",
    "enum": [
     "portrait",
     "landscape"
    ],
    "type": "string"
   },
   "page_size": {
    "description": "Paper size",
    "enum": [
     "A4",
     "Letter",
     "Legal"
    ],
    "type": "string"
   },
   "template_id": {
    "description": "Template ID to fill",
    "type": "string"
   }
  },
  "required": [
   "template_id",
   "data"
  ],
  "type": "object"
 },
 "input_examples": [
  {
   "data": {
    "company": "Acme Corp",
    "invoice_number": "INV-2026-001",
    "items": [
     "Widget A x10",
     "Service B"
    ],
    "total": "$1,250.00"
   },
   "orientation": "portrait",
   "page_size": "A4",
   "template_id": "tmpl_invoice_001"
  },
  {
   "confirm": true,
   "data": {
    "amount": "$49.99",
    "date": "2026-01-15",
    "payment_method": "Credit Card"
   },
   "template_id": "tmpl_receipt_002"
  }
 ],
 "name": "fill_template",
 "outputSchema": {
  "properties": {
   "download_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "job_id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "status": {
    "enum": [
     "pending",
     "processing",
     "completed",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "job_id",
   "status"
  ],
  "type": "object"
 }
}
