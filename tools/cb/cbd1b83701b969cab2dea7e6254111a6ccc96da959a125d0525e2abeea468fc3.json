{
 "description": "Creates a mailbox for the authenticated account.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "minLength": 1,
    "type": "string"
   },
   "apiKey": {
    "format": "starts_with",
    "pattern": "^amk_.*",
    "type": "string"
   },
   "displayName": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "assistantmail_create_mailbox"
}
