     "rejected",
     "reused",
     "completed"
    ],
    "type": "string"
   },
   "read_receipt_id": {
    "type": "string"
   },
   "session_id": {
    "description": "Receiving/reviewer session id",
    "type": "string"
   },
   "source_session_id": {
    "description": "Session that sealed the capsule",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "source_session_id",
   "artifact_sha256",
   "outcome"
  ],
  "type": "object"
