       "minLength": 1,
       "type": "string"
      },
      "sha256": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "sha256",
      "description"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "fleet_id": {
    "type": "string"
   },
   "outcome": {
    "enum": [
