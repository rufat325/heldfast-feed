    "description": "Private application credential; alternatively send the x-delx-agent-token header with x-delx-agent-id.",
    "type": "string"
   },
   "artifact_id": {
    "type": "string"
   },
   "artifact_sha256": {
    "pattern": "^[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "evidence": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
