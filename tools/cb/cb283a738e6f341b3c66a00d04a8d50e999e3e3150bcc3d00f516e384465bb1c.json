{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Check Google AI Overview presence"
 },
 "description": "Check whether Google shows an AI Overview for a query, and which URLs it cites. Uses SerpAPI (free tier: 100/month). Set SERPAPI_KEY.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hl": {
    "default": "en",
    "description": "Language code, default 'en'.",
    "type": "string"
   },
   "location": {
    "description": "Location string, e.g. 'United States'. Affects AI Overview eligibility.",
    "type": "string"
   },
   "query": {
    "description": "Search query to check for Google AI Overview.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "signals_ai_overview",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ai_overview_present": {
    "description": "Whether Google returned an AI Overview for this query.",
    "type": "boolean"
   },
   "ai_overview_text": {
    "description": "AI Overview text, if present.",
    "type": [
     "string",
     "null"
    ]
   },
   "cached": {
    "description": "Whether the result was served from local cache.",
    "type": "boolean"
   },
   "fetched_at": {
    "description": "UTC ISO-8601 timestamp.",
    "type": "string"
   },
   "query": {
    "description": "The query checked.",
    "type": "string"
   },
   "sources": {
    "description": "URLs cited in the AI Overview.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "fetched_at",
   "ai_overview_present",
   "ai_overview_text",
   "sources",
   "cached"
  ],
  "type": "object"
 }
}
