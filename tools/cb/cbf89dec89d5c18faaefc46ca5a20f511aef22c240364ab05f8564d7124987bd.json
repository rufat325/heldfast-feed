   },
   "season": {
    "description": "Season string exactly as list_leagues returns it: winter-calendar leagues look like '2026-2027', summer-calendar leagues (Brazil, Sweden, Norway, Japan\u2026) like '2026'. Omit for the current season. The free tier serves the current and previous season only.",
    "type": "string"
   },
   "team": {
