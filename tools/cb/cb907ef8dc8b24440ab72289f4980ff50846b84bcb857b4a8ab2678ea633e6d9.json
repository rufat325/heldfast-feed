{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Previsualizar una alerta"
 },
 "description": "Antes de crear una alerta: cu\u00e1ntas subastas coinciden ahora con los criterios, una muestra y avisos con `fix` aplicable (criterios sospechosos). Requiere cuenta (scope `alertas:read`). Los criterios avanzados (`scoreMin`, `discountMinPct`) requieren plan Pro; si no, se ignoran y se informa en `ajustes`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "criterios": {
    "additionalProperties": false,
    "description": "Filtros que debe cumplir una subasta para disparar la alerta: provincias, municipios, tipo de inmueble, precio, superficie y ocupaci\u00f3n.",
    "properties": {
     "discountMinPct": {
      "description": "Descuento m\u00ednimo sobre tasaci\u00f3n (%): requiere plan Pro",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     },
     "endingWithinDays": {
      "description": "Para el tipo `ending`: d\u00edas antes del fin",
      "maximum": 365,
      "minimum": 1,
      "type": "integer"
     },
     "keywords": {
      "description": "Palabras clave (m\u00e1x. 10\u00d740). NO filtran por zona: usa provincia/municipio",
      "items": {
       "maxLength": 40,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "m2Max": {
      "minimum": 0,
      "type": "number"
     },
     "m2Min": {
      "minimum": 0,
      "type": "number"
     },
     "municipalityKeys": {
      "description": "Claves `provincia:municipio` (de `estadisticas_publicas`)",
      "items": {
       "description": "Clave `provincia:municipio` (de `estadisticas_publicas`)",
       "pattern": "^[a-z0-9-]+:[a-z0-9-]+$",
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "occupied": {
      "description": "Solo ocupadas (true) o solo libres (false)",
      "type": "boolean"
     },
     "priceDropMinPct": {
      "description": "Para el tipo `price_drop`: bajada m\u00ednima (%)",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     },
     "priceMax": {
      "minimum": 0,
      "type": "number"
     },
     "priceMin": {
      "minimum": 0,
      "type": "number"
     },
     "propertyTypes": {
      "description": "Valores EXACTOS del recurso `subastech://tipos-de-inmueble`",
      "items": {
       "maxLength": 60,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "provinceSlugs": {
      "description": "Slugs de provincia",
      "items": {
       "description": "Slug en min\u00fasculas (p. ej. `madrid`)",
       "pattern": "^[a-z0-9-]{1,80}$",
       "type": "string"
      },
      "maxItems": 60,
      "type": "array"
     },
     "scoreMin": {
      "description": "Scoring m\u00ednimo (0-100): requiere plan Pro",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "criterios"
  ],
  "type": "object"
 },
