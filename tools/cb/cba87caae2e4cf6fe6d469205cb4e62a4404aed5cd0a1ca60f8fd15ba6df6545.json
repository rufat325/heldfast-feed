{
 "description": "Generates a custom MDMA prompt from structured input (domain, components, fields, steps). Returns only the custom prompt part \u2014 use buildSystemPrompt({ customPrompt }) in code to combine it with the base MDMA spec.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "businessRules": {
    "description": "Business rules or constraints",
    "type": "string"
   },
   "components": {
    "description": "Component types to use (e.g. [\"form\", \"approval-gate\", \"webhook\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "domain": {
    "description": "Domain context (e.g. \"HR onboarding\", \"expense approval\")",
    "type": "string"
   },
   "fields": {
    "description": "Form field definitions",
    "items": {
     "properties": {
      "label": {
       "description": "Display label",
       "type": "string"
      },
      "name": {
       "description": "Field name (kebab-case)",
       "type": "string"
      },
      "options": {
       "description": "Select options (for type: select)",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "required": {
       "description": "Whether field is required",
       "type": "boolean"
      },
      "sensitive": {
       "description": "Whether field contains PII",
       "type": "boolean"
      },
      "type": {
       "description": "Field type: text, number, email, date, select, checkbox, textarea",
       "type": "string"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "steps": {
    "description": "Multi-step flow definitions \u2014 each step becomes a separate conversation turn",
    "items": {
     "properties": {
      "description": {
       "description": "What this step does",
       "type": "string"
      },
      "label": {
       "description": "Step name (e.g. \"Registration Form\")",
       "type": "string"
      }
     },
     "required": [
      "label",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "build-system-prompt"
}
