{
 "description": "Update a routine's fields. Only provided fields are changed.\nIf interval is updated, nextRunAt is automatically recalculated.\n\nRequires write access when connected with OAuth.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "interval": {
    "description": "New schedule interval",
    "enum": [
     "weekday-morning",
     "weekday-evening",
     "weekly-monday",
     "weekly-tuesday-evening",
     "weekly-friday-evening",
     "daily",
     "monthly",
     "6h",
     "48h"
    ],
    "type": "string"
   },
   "max_credits_per_day": {
    "description": "Daily credit cap",
    "type": "integer"
   },
   "max_steps_per_run": {
    "description": "Max steps per run",
    "type": "integer"
   },
   "model": {
    "description": "New model",
    "type": "string"
   },
   "name": {
    "description": "New name",
    "type": "string"
   },
   "prompt": {
    "description": "New prompt / instructions",
    "type": "string"
   },
   "routine_id": {
    "description": "Routine ID",
    "type": "string"
   },
   "skillIds": {
    "description": "Routine-level skill IDs. Overrides the parent agent skills for this routine. Use list_agent_skills({ includeRuntime: true }) for advanced bundles such as routine-core.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "description": "New status",
    "enum": [
     "active",
     "paused"
    ],
    "type": "string"
   }
  },
  "required": [
   "routine_id"
  ],
  "type": "object"
 },
 "name": "update_routine"
}
