{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Search PriceInIndia for products sold in India and get matching listings with prices from retailers such as Amazon, Flipkart, Croma and Reliance Digital. Returns products (with price, MRP, discount, store, image and links) plus facet counts for brands, stores, categories and price buckets. Call this first for any product question; then optionally call compare_prices for a cheapest-per-retailer comparison, and render_product_results to show the products as cards in the chat.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"brand":{"description":"Filter by brand, e.g. 'sony'","maxLength":100,"type":"string"},"category":{"description":"Filter by category group id (from browse_categories) or name","maxLength":100,"type":"string"},"max_price":{"description":"Maximum price in INR","minimum":0,"type":"number"},"min_price":{"description":"Minimum price in INR","minimum":0,"type":"number"},"page":{"description":"Page number (default 1)","maximum":20,"minimum":1,"type":"integer"},"per_page":{"description":"Results per page (default 10, max 20)","maximum":20,"minimum":1,"type":"integer"},"query":{"description":"Product search query, e.g. 'sony wh-1000xm5'","maxLength":200,"minLength":2,"type":"string"},"sort":{"description":"Sort order (default: relevance)","enum":["relevance","price_asc","price_desc","newest"],"type":"string"},"store":{"description":"Filter by retailer, e.g. 'amazon.in'","maxLength":100,"type":"string"}},"required":["query"],"type":"object"},"name":"search_products","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"facets":{"additionalProperties":false,"properties":{"brands":{"items":{"additionalProperties":false,"properties":{"count":{"type":"number"},"value":{"type":"string"}},"required":["value","count"],"type":"object"},"type":"array"},"categories":{"items":{"additionalProperties":false,"properties":{"count":{"type":"number"},"id":{"type":"string"},"name":{"type":"string"}},"required":["id","name","count"],"type":"object"},"type":"array"},"priceBuckets":{"items":{"additionalProperties":false,"properties":{"count":{"type":"number"},"label":{"type":"string"},"slug":{"type":"string"}},"required":["label","slug","count"],"type":"object"},"type":"array"},"stores":{"items":{"additionalProperties":false,"properties":{"count":{"type":"number"},"value":{"type":"string"}},"required":["value","count"],"type":"object"},"type":"array"}},"required":["brands","stores","categories","priceBuckets"],"type":"object"},"page":{"type":"number"},"products":{"items":{"additionalProperties":false,"properties":{"brand":{"type":"string"},"currency":{"const":"INR","type":"string"},"discountPercent":{"type":"number"},"id":{"description":"Opaque product id \u2014 pass through unchanged; used in buy links","type":"string"},"imageUrl":{"type":"string"},"lastUpdated":{"description":"Unix seconds when the price was last seen","type":"number"},"mrp":{"description":"Maximum retail price in INR, when known","type":"number"},"outOfStock":{"type":"boolean"},"price":{"description":"Current price in INR","type":"number"},"productPageUrl":{"description":"PriceInIndia product page \u2014 use for citations","type":"string"},"productUrl":{"description":"Attributed buy link (PriceInIndia affiliate redirect)","type":"string"},"store":{"description":"Retailer siteName, e.g. amazon.in, flipkart.com","type":"string"},"title":{"type":"string"}},"required":["id","title","price","currency","store","productUrl","productPageUrl","outOfStock","lastUpdated"],"type":"object"},"type":"array"},"query":{"type":"string"},"total":{"type":"number"}},"required":["query","page","total","products","facets"],"type":"object"},"title":"Search products"}
