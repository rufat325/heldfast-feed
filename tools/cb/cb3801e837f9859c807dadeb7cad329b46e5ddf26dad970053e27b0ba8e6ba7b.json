{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Build a ready-to-send InstaVeil x402 POST request for one paid product so an autonomous agent can purchase with minimal integration work.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "product_id": "profile-snapshot",
    "username": "instagram"
   },
   {
    "product_id": "creator-compare",
    "usernames": [
     "instagram",
     "natgeo"
    ]
   }
  ],
  "properties": {
   "language": {
    "description": "Requested answer language for Veil Lens",
    "type": "string"
   },
   "product_id": {
    "description": "InstaVeil x402 product identifier",
    "enum": [
     "profile-snapshot",
     "story-snapshot",
     "profile-intelligence",
     "creator-compare",
     "veil-lens"
    ],
    "type": "string"
   },
   "question": {
    "description": "Research question for Veil Lens",
    "maxLength": 600,
    "minLength": 5,
    "type": "string"
   },
   "username": {
    "description": "One public Instagram username without @",
    "pattern": "^[A-Za-z0-9._]{1,30}$",
    "type": "string"
   },
   "usernames": {
    "description": "One to three public Instagram usernames without @",
    "items": {
     "pattern": "^[A-Za-z0-9._]{1,30}$",
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "product_id"
  ],
  "type": "object"
 },
 "name": "build_purchase_request"
}
