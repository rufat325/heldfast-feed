{
 "description": "List the pending browser screenshots as a manifest \u2014 NO image data. The stack is the local folder where the SnapStack browser extension pushes captures. Each entry has a stable two-digit \"number\", the absolute local \"path\", \"width\"/\"height\", and metadata (url, title, capturedAt, format, bytes). Read the file at \"path\" yourself only if you need the pixels. This tool does NOT delete anything \u2014 use clear_screenshots to remove captures. Pass \"numbers\" to list only specific captures (e.g. [1] or [1,3]); omit to list them all.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "numbers": {
    "description": "Capture numbers to include (e.g. [1] or [1,3,5]). Omit to include all.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "get_screenshots",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "missing": {
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "screenshots": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bytes": {
       "type": [
        "number",
        "null"
       ]
      },
      "capturedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "format": {
       "type": [
        "string",
        "null"
       ]
      },
      "height": {
       "type": [
        "number",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "number": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "path": {
       "type": "string"
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      },
      "width": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "number",
