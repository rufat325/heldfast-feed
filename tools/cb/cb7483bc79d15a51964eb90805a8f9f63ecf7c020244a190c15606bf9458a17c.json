{
 "description": "Build a live, source-hashed regulatory change evidence pack.\n\n    Fetches only the product's registry-owned regulator URLs, reports source\n    retrieval timestamps and SHA-256 hashes, distinguishes a first baseline\n    from a detected change, emits a bounded text diff on later changes, and\n    combines the evidence with a curated deadline calendar. Screening only;\n    confirm legal applicability with the cited authority or qualified counsel.\n    ",
 "inputSchema": {
  "properties": {
   "company_profile": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Company Profile"
   },
   "jurisdiction": {
    "title": "Jurisdiction",
    "type": "string"
   },
   "persist_snapshot": {
    "default": true,
    "title": "Persist Snapshot",
    "type": "boolean"
   },
   "since_days": {
    "default": 90,
    "title": "Since Days",
    "type": "integer"
   },
   "source_ids": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Source Ids"
   },
   "topics": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Topics"
   }
  },
  "required": [
   "jurisdiction"
  ],
  "title": "build_evidence_packArguments",
  "type": "object"
 },
 "name": "build_evidence_pack",
 "outputSchema": {
  "properties": {
   "result": {
    "title": "Result",
    "type": "string"
   }
  },
  "required": [
   "result"
  ],
  "title": "build_evidence_packOutput",
  "type": "object"
 }
}
