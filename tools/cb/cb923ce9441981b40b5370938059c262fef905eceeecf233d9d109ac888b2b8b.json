{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update job preferences"
 },
 "description": "Merges the supplied preference fields into the account's stored preferences and refreshes matching. compensation.kind is open or minimum; minimum requires minimumAmount, an ISO-4217 currency and an hour or year period. seniorities accepts one override level; an empty list restores resume-derived seniority. Work modes and relocation are stored together, with omitted values preserved.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "patch": {
    "additionalProperties": false,
    "properties": {
     "acceptedWorkModes": {
      "items": {
       "enum": [
        "remote",
        "hybrid",
        "onsite"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "aiRoleInterest": {
      "description": "How much they want AI-centred roles. AVOID demotes them.",
      "enum": [
       "HIGH",
       "OPEN",
       "LOW",
       "AVOID"
      ],
      "type": "string"
     },
     "availability": {
      "anyOf": [
       {
        "oneOf": [
         {
          "additionalProperties": false,
          "properties": {
           "kind": {
            "const": "immediate",
            "type": "string"
           }
          },
          "required": [
           "kind"
          ],
          "type": "object"
         },
         {
          "additionalProperties": false,
          "properties": {
           "date": {
            "description": "Local date, YYYY-MM-DD.",
            "type": "string"
           },
           "kind": {
            "const": "specific_date",
            "type": "string"
           }
          },
          "required": [
           "kind",
           "date"
          ],
          "type": "object"
         },
         {
          "additionalProperties": false,
          "properties": {
           "kind": {
            "const": "notice_period",
            "type": "string"
           },
           "noticePeriodDays": {
            "maximum": 365,
            "minimum": 1,
            "type": "integer"
           }
          },
          "required": [
           "kind",
           "noticePeriodDays"
          ],
          "type": "object"
         }
        ]
       },
       {
        "type": "null"
       }
      ],
      "description": "`null` withdraws it, which stops applications until it is answered again."
     },
     "compensation": {
      "anyOf": [
       {
        "description": "A USD per-year minimum must be between 10,000 and 1,000,000; other currencies and hourly rates are unbounded.",
        "oneOf": [
         {
          "additionalProperties": false,
          "properties": {
           "kind": {
            "const": "open",
            "type": "string"
           }
          },
          "required": [
           "kind"
          ],
          "type": "object"
         },
         {
          "additionalProperties": false,
          "properties": {
           "currency": {
            "description": "ISO-4217 code, e.g. \"USD\".",
            "pattern": "^[A-Z]{3}$",
            "type": "string"
           },
           "kind": {
            "const": "minimum",
            "type": "string"
           },
           "minimumAmount": {
            "exclusiveMinimum": 0,
            "maximum": 100000000,
            "type": "number"
           },
           "period": {
            "enum": [
             "hour",
             "year"
            ],
            "type": "string"
           }
          },
          "required": [
           "kind",
           "minimumAmount",
           "currency",
           "period"
          ],
          "type": "object"
         }
        ]
       },
       {
        "type": "null"
       }
      ],
      "description": "The person's pay floor. This is where salary lives. `null` withdraws it, which stops applications until it is answered again."
     },
     "coverLettersEnabled": {
      "type": "boolean"
     },
     "dealBreakers": {
      "items": {
       "maxLength": 200,
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "preferredLocations": {
      "description": "Where they want to work, not where they live.",
      "items": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 5,
      "type": "array"
     },
     "seniorities": {
      "description": "The level to match at, as a one-item list. `[]` drops back to the level read off the resume.",
      "items": {
       "enum": [
        "INTERN",
        "JUNIOR",
        "MID",
        "SENIOR",
        "STAFF",
        "PRINCIPAL",
        "DIRECTOR",
        "VP",
        "C_SUITE"
       ],
       "type": "string"
      },
      "maxItems": 1,
      "type": "array"
     },
     "targetFunctions": {
      "description": "Up to three of these labels; this REPLACES the list, so to add one include the current ones from get_preferences or the situation.",
      "items": {
       "enum": [
        "Engineering",
        "Product",
        "Design",
        "Marketing",
        "Data Science",
        "Sales",
        "Operations",
        "Finance",
        "Legal",
        "HR",
        "Customer Success",
        "DevRel",
        "Security",
        "Research",
        "Executive"
       ],
       "type": "string"
      },
      "maxItems": 3,
      "type": "array"
     },
     "willingToRelocate": {
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "patch"
  ],
  "type": "object"
 },
 "name": "update_preferences",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actionId": {
    "type": "string"
   },
   "cancel": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "actionId": {
        "type": "string"
       },
       "args": {}
      },
      "required": [
       "actionId",
       "args"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "createdAt": {
    "type": "string"
   },
   "handoff": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "destination": {
        "additionalProperties": false,
        "properties": {
         "destination": {
          "enum": [
           "matches",
           "browse",
           "applications",
           "messages",
           "profile",
           "billing",
           "help",
           "feedback",
           "job",
           "pack"
          ],
          "type": "string"
         },
         "params": {
          "additionalProperties": {
           "type": "string"
          },
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         }
        },
        "required": [
         "destination"
        ],
        "type": "object"
       },
       "note": {
        "maxLength": 200,
        "type": "string"
       },
       "preserved": {
        "type": "boolean"
       },
       "reason": {
        "enum": [
         "needs_credentials",
         "needs_payment_details",
         "needs_consent",
         "needs_entitlement",
         "needs_prerequisite",
         "person_must_do"
        ],
        "type": "string"
       },
       "remaining": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "required": [
       "reason",
       "note",
       "destination",
       "remaining",
       "preserved"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "object": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "type": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "id"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "revisionAfter": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "revisionBefore": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "source": {
    "enum": [
     "site",
     "mcp"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "completed",
     "queued",
     "verifying",
     "failed",
     "cancelled",
     "handoff"
    ],
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "taskId": {
    "type": "string"
   },
   "undo": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "actionId": {
        "type": "string"
       },
       "args": {},
       "until": {
        "type": "string"
       }
      },
      "required": [
       "until",
       "actionId",
       "args"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "webUrl": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "taskId",
   "actionId",
   "status",
   "object",
   "revisionBefore",
   "revisionAfter",
   "summary",
   "undo",
   "cancel",
   "handoff",
   "source",
   "createdAt",
   "webUrl"
  ],
  "type": "object"
 },
 "title": "Update job preferences"
}
