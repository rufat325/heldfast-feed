{
 "description": "Store a memory. Use this to persist decisions, preferences, architecture, patterns, or anything that should survive across sessions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "What to remember (be descriptive)",
    "type": "string"
   },
   "context": {
    "default": "general",
    "description": "Category: \"preferences\", \"architecture\", \"decisions\", \"patterns\", etc.",
    "type": "string"
   },
   "importance": {
    "default": 0.5,
    "description": "0.0 to 1.0 - higher = more important",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "metadata": {
    "default": "{}",
    "description": "Optional JSON string with additional data",
    "type": "string"
   }
  },
  "required": [
   "content"
  ],
  "type": "object"
 },
 "name": "remember"
}
