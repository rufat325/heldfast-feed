{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Company SEC Filings"
 },
 "description": "List a US public company's recent SEC filings (10-K annual reports, 10-Q quarterlies, 8-K current reports, proxies and more) by stock ticker or CIK: form, filing date, period, description and direct document links. Data source: SEC EDGAR public filings (free public data; not affiliated with or endorsed by the SEC). Price: $0.02 per successful call; failed calls are free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "api_key": {
    "description": "Your Unstuck API key, if this connection has none. Leave empty to try free tools or to get a key and payment link.",
    "maxLength": 200,
    "type": "string"
   },
   "form_types": {
    "description": "Only these form types, e.g. [\"10-K\",\"10-Q\",\"8-K\"]. Exact match (amendments are \"10-K/A\"). Default: all forms.",
    "items": {
     "maxLength": 20,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9\\-\\/ ]+$",
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "limit": {
    "description": "How many filings, newest first. Default 10, max 20.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "ticker_or_cik": {
    "description": "Stock ticker (e.g. \"AAPL\", \"BRK.B\") or the company's numeric SEC CIK (e.g. \"320193\").",
    "maxLength": 12,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9.\\-]+$",
    "type": "string"
   }
  },
  "required": [
   "ticker_or_cik"
  ],
  "type": "object"
 },
 "name": "company_filings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance_usd": {
    "description": "Remaining prepaid balance, USD.",
    "type": "number"
   },
   "charged_usd": {
    "description": "Amount charged for this call, USD.",
    "type": "number"
   },
   "cik": {
    "description": "10-digit SEC Central Index Key.",
    "type": "string"
   },
   "company": {
    "description": "Company name as filed.",
    "type": [
     "string",
     "null"
    ]
   },
   "filings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accession_number": {
       "type": "string"
      },
      "description": {
       "description": "Document description, or 8-K item numbers.",
       "type": [
        "string",
        "null"
       ]
      },
      "document_url": {
       "description": "Main document.",
       "type": [
        "string",
        "null"
       ]
      },
      "filed": {
       "description": "Filing date (YYYY-MM-DD).",
       "type": [
        "string",
        "null"
       ]
      },
      "filing_index_url": {
       "description": "Filing index with all documents and exhibits.",
       "type": "string"
      },
      "form": {
       "description": "Form type, e.g. \"10-K\".",
       "type": "string"
      },
      "report_date": {
       "description": "Period of report (YYYY-MM-DD), if any.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "form",
      "filed",
      "report_date",
      "description",
      "accession_number",
      "document_url",
      "filing_index_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "const": "SEC EDGAR",
    "type": "string"
   },
   "tickers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "source",
   "company",
   "cik",
   "tickers",
   "filings",
   "charged_usd",
   "balance_usd"
  ],
  "type": "object"
 },
 "title": "Company SEC Filings"
}
