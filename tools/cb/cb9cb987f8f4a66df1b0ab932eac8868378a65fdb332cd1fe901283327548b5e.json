{
 "_meta": {
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "sensitive-write"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Replace the working document"
 },
 "description": "Broad replacement guarded by current identity and revision. Keeps document identity and history; returns its act. Use edit for passage changes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent": {
    "type": "string"
   },
   "docKind": {
    "enum": [
     "markdown",
     "text",
     "code"
    ],
    "type": "string"
   },
   "document": {
    "maxLength": 64,
    "type": "string"
   },
   "expected_document_id": {
    "maxLength": 256,
    "type": "string"
   },
   "expected_revision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "filename": {
    "maxLength": 256,
    "type": "string"
   },
   "label": {
    "type": "string"
   },
   "operation_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "maxLength": 26214400,
    "type": "string"
   },
   "turn_id": {
    "maxLength": 160,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   }
  },
  "required": [
   "document",
   "text",
   "expected_document_id",
   "expected_revision"
  ],
  "type": "object"
 },
 "name": "document.replace",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "outcome": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Replace the working document"
}
