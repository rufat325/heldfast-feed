{
 "_meta": {
  "openai/outputTemplate": "ui://applytovolunteer/form-preview.html",
  "ui": {
   "resourceUri": "ui://applytovolunteer/form-preview.html"
  },
  "ui/resourceUri": "ui://applytovolunteer/form-preview.html"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Convert a PDF for the organization"
 },
 "description": "Convert a PDF URL into a stored preview for the authenticated organization. Requires an org API key with the forms:read scope. Returns the preview id and expiry. For a preview without a key, use preview_volunteer_form.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "https URL of a blank volunteer PDF.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "convert_pdf_preview",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expiresAt": {
    "type": "integer"
   },
   "fields": {
    "description": "Number of parsed fields.",
    "minimum": 0,
    "type": "integer"
   },
   "grader": {
    "additionalProperties": true,
    "properties": {
     "grade": {
      "enum": [
       "A",
       "B",
       "C",
       "D",
       "F"
      ],
      "type": "string"
     },
     "recommendations": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "detail": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "severity": {
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "severity",
        "title",
        "detail"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "score": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "score",
     "grade",
     "recommendations"
    ],
    "type": "object"
   },
   "previewId": {
    "description": "Preview id. The public path is /tools/p/{previewId}.",
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "title",
   "fields",
   "grader",
   "previewId",
   "expiresAt"
  ],
  "type": "object"
 },
 "title": "Convert a PDF for the organization"
}
