 "description": "MUTATES trips (+ optional calendar travel event). Prefer this over free-text log_event for map/history. Required: city + start_date. Optional: country, end_date, kind (trip|residence|soft_pin), confidence (confirmed|likely|possible), evidence, title, mirror_event. Soft pins default to status=possible and stay off cities/map until confidence=confirmed. The calendar event is private. Zelle/Venmo money belongs in log_transaction \u2014 not here. ($0.10; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "city": {
    "type": "string"
   },
   "confidence": {
    "enum": [
     "confirmed",
     "likely",
     "possible"
    ],
    "type": "string"
   },
   "country": {
    "type": "string"
   },
   "date": {
    "description": "Alias for start_date",
    "type": "string"
   },
   "end_date": {
    "type": "string"
   },
   "evidence": {
    "description": "Source note (Gmail id, address, etc.)",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Alias for request_id.",
    "type": "string"
   },
   "kind": {
    "enum": [
     "trip",
     "residence",
     "soft_pin"
    ],
    "type": "string"
   },
   "mirror_event": {
    "description": "Also insert category=travel calendar event (default true)",
    "type": "boolean"
   },
   "request_id": {
    "description": "Client idempotency key (retries return original result).",
    "type": "string"
   },
   "start_date": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "city"
  ],
  "type": "object"
 },
 "name": "log_travel",
