{
 "description": "Convert YAML text to a JSON string.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "indent": {
    "description": "JSON indentation spaces (default: 2)",
    "type": "number"
   },
   "yamlText": {
    "description": "The YAML text to convert to JSON",
    "type": "string"
   }
  },
  "required": [
   "yamlText"
  ],
  "type": "object"
 },
 "name": "yaml_to_json"
}
