{
 "annotations": {
  "destructiveHint": true
 },
 "description": "Executes arbitrary commands inside a running Docker container and returns structured output. WARNING: may execute untrusted code.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "command": {
    "description": "Command to execute (e.g., [\"ls\", \"-la\"])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "container": {
    "description": "Container name or ID",
    "maxLength": 255,
    "type": "string"
   },
   "detach": {
    "default": false,
    "description": "Run command in the background (default: false)",
    "type": "boolean"
   },
   "env": {
    "default": [],
    "description": "Environment variables (e.g., [\"KEY=VALUE\"])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "envFile": {
    "description": "Read environment variables from a file (--env-file)",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of characters to return in stdout. Output exceeding this limit will be truncated and isTruncated set to true.",
    "type": "number"
   },
   "parseJson": {
    "default": false,
    "description": "Parse stdout as JSON and return it in `json` when valid",
    "type": "boolean"
   },
   "path": {
    "description": "Host working directory",
    "maxLength": 4096,
    "type": "string"
   },
   "timeout": {
    "description": "Command timeout in milliseconds (min 1000, max 600000)",
    "maximum": 600000,
    "minimum": 1000,
    "type": "integer"
   },
   "user": {
    "description": "Run command as a specific user (e.g., \"root\", \"1000:1000\")",
    "maxLength": 255,
    "type": "string"
   },
   "workdir": {
    "description": "Working directory inside the container",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "required": [
   "container",
   "command"
  ],
  "type": "object"
 },
 "name": "exec",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exitCode": {
    "type": "number"
   },
   "isTruncated": {
    "type": "boolean"
   },
   "json": {},
   "parseJsonError": {
    "type": "string"
   },
   "stderr": {
    "type": "string"
   },
   "stdout": {
    "type": "string"
   },
   "timedOut": {
    "type": "boolean"
   }
  },
  "required": [
   "exitCode"
  ],
  "type": "object"
 },
 "title": "Docker Exec"
}
