{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read one bounded page from /api/index/v1/verity/catalog. Discover crypto symbols and their current coverage status and measured cadence. Catalog rows, prices and metadata are unsigned: use get_index_price or get_index_batch for signed receipts. Availability changes; total is a catalog count, not a count of fresh prices. No automatic pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "band": {
    "enum": [
     "real-time",
     "five-second",
     "ten-second",
     "slow",
     "unavailable"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "enum": [
     "consensus",
     "blended",
     "indicative",
     "insufficient-coverage",
     "venue-disagreement",
     "unconvertible-quote",
     "stale",
     "kernel-rejected"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_index_assets",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bands": {
    "items": {
     "enum": [
      "real-time",
      "five-second",
      "ten-second",
      "slow",
      "unavailable"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "count": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "engine": {
    "maxLength": 64,
    "type": "string"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "accountUrl": {
      "const": "https://thepulse.markets/developers/access",
      "type": "string"
     },
     "code": {
      "pattern": "^[A-Z][A-Z0-9_]{0,79}$",
      "type": "string"
     },
     "nextAction": {
      "enum": [
       "wait",
       "review_access",
       "check_limits",
       "reconnect",
       "check_input",
       "choose_another_symbol",
       "report_issue"
      ],
      "type": "string"
     },
     "retryAfterSeconds": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "nextAction"
    ],
    "type": "object"
   },
   "note": {
    "maxLength": 2048,
    "type": "string"
   },
   "requestId": {
    "description": "Identifier for this MCP call; not a signed price field.",
    "format": "uuid",
    "type": "string"
   },
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "ambiguousTicker": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "at": {
       "anyOf": [
        {
         "maxLength": 40,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "cadence": {
       "additionalProperties": false,
       "properties": {
        "band": {
         "$ref": "#/properties/bands/items"
        },
        "calculatedAgeMs": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "newestSourceAgeMs": {
         "anyOf": [
          {
           "$ref": "#/properties/rows/items/properties/cadence/properties/calculatedAgeMs/anyOf/0"
          },
          {
           "type": "null"
          }
         ]
        },
        "oldestSourceAgeMs": {
         "anyOf": [
          {
           "$ref": "#/properties/rows/items/properties/cadence/properties/calculatedAgeMs/anyOf/0"
          },
          {
           "type": "null"
          }
         ]
        },
        "p50UpdateMs": {
         "anyOf": [
          {
           "$ref": "#/properties/rows/items/properties/cadence/properties/calculatedAgeMs/anyOf/0"
          },
          {
           "type": "null"
          }
         ]
        },
        "p95UpdateMs": {
         "anyOf": [
          {
           "$ref": "#/properties/rows/items/properties/cadence/properties/calculatedAgeMs/anyOf/0"
          },
          {
           "type": "null"
          }
         ]
        },
        "updatesLast120s": {
         "$ref": "#/properties/total"
        }
       },
       "required": [
        "band",
        "calculatedAgeMs",
        "newestSourceAgeMs",
        "oldestSourceAgeMs",
        "p50UpdateMs",
        "p95UpdateMs"
       ],
       "type": "object"
      },
      "freshVenues": {
       "$ref": "#/properties/total"
      },
      "price": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "quotes": {
       "items": {
        "maxLength": 32,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "status": {
       "enum": [
        "consensus",
        "blended",
        "indicative",
        "insufficient-coverage",
        "venue-disagreement",
        "unconvertible-quote",
        "stale",
        "kernel-rejected"
       ],
       "type": "string"
      },
      "symbol": {
       "maxLength": 128,
       "type": "string"
      },
      "venues": {
       "$ref": "#/properties/total"
      }
     },
     "required": [
      "symbol",
      "status",
      "price",
      "at",
      "venues",
      "freshVenues",
      "quotes",
      "cadence",
      "ambiguousTicker"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "total": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "requestId"
  ],
  "type": "object"
 },
 "title": "List Pulse Verity Index Assets"
}
