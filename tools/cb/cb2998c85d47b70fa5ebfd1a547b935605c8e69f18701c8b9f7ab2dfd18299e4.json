{
 "description": "Submit a claimed contributor task result with evidence and uncertainty. Tier-1 external actions should include a verifiable receipt. Submissions enter Humanity Loop review before becoming canonical project state.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "evidence": {
    "items": {},
    "maxItems": 20,
    "type": "array"
   },
   "failure_modes": {
    "items": {},
    "maxItems": 20,
    "type": "array"
   },
   "node_token": {
    "minLength": 20,
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "uncertainty": {
    "maxLength": 2000,
    "type": "string"
   },
   "work_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "node_token",
   "work_id",
   "result"
  ],
  "type": "object"
 },
 "name": "contributor_submit",
 "title": "Submit contributor-node work"
}
