{
 "description": "Queue a rank tracking check for a URL and keyword.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "keyword": {
    "description": "Keyword to track",
    "type": "string"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "url": {
    "description": "URL to track",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "keyword",
   "url"
  ],
  "type": "object"
 },
 "name": "agentseo_rank_track",
 "title": "AgentSEO Rank Track"
}
