       "minLength": 1,
       "type": "string"
      },
      "prefecture": {
       "description": "Japanese prefecture: English name (e.g. \"Tokyo\", \"Osaka\", \"Hokkaido\"; \"Tokyo-to\" and \"Osaka Prefecture\" also work), Japanese name in kanji, or JIS code \"01\"..\"47\". Use with name.",
       "maxLength": 40,
       "minLength": 1,
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
