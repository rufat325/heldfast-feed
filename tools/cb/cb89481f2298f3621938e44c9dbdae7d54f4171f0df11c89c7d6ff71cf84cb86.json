   ]
  }
 },
 "description": "Use when an agent needs platform-level context before drilling into individual markets: one row per platform (Polymarket, Kalshi, Manifold, Myriad, Limitless, Predict, Opinion, Gemini) carrying 24h notional volume, active event and market counts, and that platform's category mix. Takes no parameters and returns the whole picture in one small response, which makes it the cheapest way to answer 'how big is X relative to Y' or 'which platform covers this topic'. Volumes are in each platform's native units \u2014 Manifold reports play-money mana, not USD \u2014 so do not sum across platforms without saying so.",
 "inputSchema": {
  "properties": {},
  "required": [],
  "type": "object"
 },
 "name": "get_summary",
 "outputSchema": {
  "properties": {
   "_meta": {
    "anyOf": [
     {
      "description": "Agent metadata for list/aggregate responses (no cite_as).",
      "properties": {
       "as_of": {
        "format": "date-time",
        "title": "As Of",
        "type": "string"
       },
       "attribution": {
        "default": "pdata.world \u2014 aggregated prediction-market data across 8 platforms",
        "title": "Attribution",
        "type": "string"
       },
       "canonical_url": {
        "title": "Canonical Url",
        "type": "string"
       },
       "docs": {
        "default": "https://api.pdata.world/docs",
        "title": "Docs",
        "type": "string"
       }
      },
      "required": [
       "canonical_url"
      ],
      "title": "ResponseMetaList",
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "grand_total_volume_24hr": {
    "title": "Grand Total Volume 24Hr",
    "type": "number"
   },
   "sources": {
    "items": {
     "properties": {
      "categories": {
       "additionalProperties": {
        "type": "number"
       },
       "title": "Categories",
       "type": "object"
      },
      "computed_at": {
       "format": "date-time",
