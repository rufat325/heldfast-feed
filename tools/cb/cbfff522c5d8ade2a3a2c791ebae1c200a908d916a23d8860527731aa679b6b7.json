{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Check whether the selected TAP service reports itself available; an unavailable service is not an empty catalog result.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "service": {
    "description": "Known Starfetch TAP service preset selected for this workflow; use this or url.",
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "Explicit TAP base URL selected for this workflow; use this or service.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "starfetch_tap_availability",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "available": {
      "type": "boolean"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "available"
    ],
    "type": "object"
   },
   "diagnostics": {
    "additionalProperties": false,
    "properties": {
     "target": {
      "additionalProperties": false,
      "properties": {
       "baseUrl": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "service": {
        "type": "string"
       }
      },
      "required": [
       "baseUrl"
      ],
      "type": "object"
     }
    },
    "required": [
     "target"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "diagnostics"
  ],
  "type": "object"
 },
 "title": "Read TAP availability"
}
