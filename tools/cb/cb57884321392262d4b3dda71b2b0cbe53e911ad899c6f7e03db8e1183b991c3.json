{
 "description": "Updates an existing monitor configuration. You must include the monitorID. Only the fields you provide will be changed (the server merges your changes with the existing config). Use getMonitor first to get the current config.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "accepted_statuscodes": {
    "description": "Accepted HTTP status codes",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "active": {
    "description": "Whether the monitor is active",
    "type": "boolean"
   },
   "body": {
    "description": "HTTP request body",
    "type": "string"
   },
   "description": {
    "description": "Free-text description shown on the monitor page",
    "type": [
     "string",
     "null"
    ]
   },
   "dns_resolve_server": {
    "description": "DNS server to use for resolution (for dns type)",
    "type": "string"
   },
   "dns_resolve_type": {
    "description": "DNS record type to query (for dns type)",
    "enum": [
     "A",
     "AAAA",
     "CNAME",
     "MX",
     "NS",
     "PTR",
     "SOA",
     "SRV",
     "TXT",
     "CAA"
    ],
    "type": "string"
   },
   "docker_container": {
    "description": "Docker container name (required for docker type)",
    "type": "string"
   },
   "docker_host": {
    "description": "Docker host ID (required for docker type). Use listDockerHosts to find available IDs.",
    "type": "number"
   },
   "expectedValue": {
    "description": "Threshold the json-query result is compared against, stored as a string.",
    "type": "string"
   },
   "expected_value": {
    "description": "Alias for expectedValue. Prefer expectedValue.",
    "type": "string"
   },
   "headers": {
    "description": "HTTP headers as JSON string",
    "type": "string"
   },
   "hostname": {
    "description": "Hostname",
    "type": "string"
   },
   "ignoreTls": {
    "description": "Ignore TLS/SSL errors",
    "type": "boolean"
   },
   "interval": {
    "description": "Check interval in seconds",
    "type": "number"
   },
   "invertKeyword": {
    "description": "Invert keyword match",
    "type": "boolean"
   },
   "jsonPath": {
    "description": "JSONata expression for json-query monitors. Must resolve to a primitive.",
    "type": "string"
   },
   "jsonPathOperator": {
    "description": "Comparison operator for json-query monitors.",
    "enum": [
     ">",
     ">=",
     "<",
     "<=",
     "==",
     "!=",
     "contains"
    ],
    "type": "string"
   },
   "json_path": {
    "description": "Alias for jsonPath (the database column name). Prefer jsonPath.",
    "type": "string"
   },
   "json_path_operator": {
    "description": "Alias for jsonPathOperator. Prefer jsonPathOperator.",
    "enum": [
     ">",
     ">=",
     "<",
     "<=",
     "==",
     "!=",
     "contains"
    ],
    "type": "string"
   },
   "keyword": {
    "description": "Keyword to search for",
    "type": "string"
   },
   "maxredirects": {
    "description": "Max HTTP redirects",
    "type": "number"
   },
   "maxretries": {
    "description": "Max retries before marking as down",
    "type": "number"
   },
   "method": {
    "description": "HTTP method",
    "type": "string"
   },
   "monitorID": {
    "description": "The ID of the monitor to update",
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "description": "Display name",
    "type": "string"
   },
   "notificationIDList": {
    "additionalProperties": {
     "type": "boolean"
    },
    "description": "Notification ID map",
    "type": "object"
   },
   "parent": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Parent group monitor ID \u2014 re-parents this monitor into that group. Pass null to move it to the top level."
   },
   "parentID": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Alias for parent. Prefer parent."
   },
   "parent_id": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Alias for parent. Prefer parent."
   },
   "port": {
    "description": "Port number",
    "type": "number"
   },
   "pushToken": {
    "description": "Push token \u2014 the secret in the ping URL. Changing it invalidates the existing URL and any sender still using it stops beating.",
    "minLength": 8,
    "type": "string"
   },
   "push_token": {
    "description": "Alias for pushToken (the database column name). Prefer pushToken.",
    "minLength": 8,
    "type": "string"
   },
   "resendInterval": {
    "description": "Resend notification every N checks while down (0 = disabled)",
    "type": "number"
   },
   "retryInterval": {
    "description": "Retry interval in seconds",
    "type": "number"
   },
   "tags": {
    "description": "Tags to assign",
    "items": {
     "additionalProperties": false,
     "properties": {
      "color": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "timeout": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Request timeout in SECONDS. Avoid 0 \u2014 Uptime Kuma's runtime fallback for a stored 0 yields a ~13 hour timeout, so the monitor can never report DOWN against a black-holed endpoint."
   },
   "upsideDown": {
    "description": "Invert status",
    "type": "boolean"
   },
   "url": {
    "description": "URL to monitor",
    "type": "string"
   }
  },
  "required": [
   "monitorID"
  ],
  "type": "object"
 },
 "name": "updateMonitor",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "monitorID": {
    "type": "number"
   },
   "msg": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Update Monitor"
}
