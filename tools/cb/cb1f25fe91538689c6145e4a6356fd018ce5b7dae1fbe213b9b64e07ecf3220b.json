{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read a message"
 },
 "description": "Read one message in a connected mailbox, with its headers and its body.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "The message's id, as a search or a thread read answered it, or a draft's own id.",
    "pattern": "^[A-Za-z0-9_=-]{1,512}$",
    "type": "string"
   },
   "mailbox": {
    "description": "The mailbox's name or its email address.",
    "minLength": 1,
    "type": "string"
   },
   "view": {
    "description": "full, the default, carries each message's text and attachments; summary leaves those out; headers leaves out the subject and snippet too.",
    "enum": [
     "full",
     "summary",
     "headers"
    ],
    "type": "string"
   }
  },
  "required": [
   "mailbox",
   "id"
  ],
  "type": "object"
 },
 "name": "messages_get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attachments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attachmentId": {
       "type": "string"
      },
      "filename": {
       "type": "string"
      },
      "holdsBytes": {
       "type": "boolean"
      },
      "mimeType": {
       "type": "string"
      },
      "size": {
       "type": "number"
      },
      "sizePrecision": {
       "enum": [
        "exact",
        "upperBound"
       ],
       "type": "string"
      }
     },
     "required": [
      "attachmentId",
      "filename",
      "mimeType",
      "size",
      "holdsBytes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bcc": {
    "type": [
     "string",
     "null"
    ]
   },
   "body": {
    "type": "string"
   },
   "bodyFormat": {
    "enum": [
     "text",
     "html",
     "none"
    ],
    "type": "string"
   },
   "categories": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "cc": {
    "type": [
     "string",
     "null"
    ]
   },
   "date": {
    "type": [
     "string",
     "null"
    ]
   },
   "draft": {
    "type": "boolean"
   },
   "draftId": {
    "type": [
     "string",
     "null"
    ]
   },
   "flagged": {
    "type": "boolean"
   },
   "folder": {
    "enum": [
     "inbox",
     "sent",
     "archive",
     "drafts",
     "deleted",
     "junk",
     "other"
    ],
    "type": "string"
   },
   "from": {
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "type": "string"
   },
   "labelIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "link": {
    "type": "string"
   },
   "omittedCharacters": {
    "type": "number"
   },
   "snippet": {
    "type": [
     "string",
     "null"
    ]
   },
   "subject": {
    "type": [
     "string",
     "null"
    ]
   },
   "threadId": {
    "type": "string"
   },
   "to": {
    "type": [
     "string",
     "null"
    ]
   },
   "unread": {
    "type": "boolean"
   }
  },
  "required": [
   "id",
   "threadId",
   "from",
   "to",
   "cc",
   "bcc",
   "date",
   "draft",
   "draftId",
   "unread",
   "labelIds",
   "link"
  ],
  "type": "object"
 },
 "title": "Read a message"
}
