{
 "description": "Resolves every variable under two different environment/service/workload selectors and reports what differs between them.",
 "inputSchema": {
  "properties": {
   "environmentA": {
    "description": "{ nodeEnv?, service?, workload?, container?, label? }",
    "type": "object"
   },
   "environmentB": {
    "description": "{ nodeEnv?, service?, workload?, container?, label? }",
    "type": "object"
   },
   "files": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "projectRoot": {
    "type": "string"
   },
   "variables": {
    "description": "Optional subset; defaults to every variable discovered",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "environmentA",
   "environmentB",
   "files"
  ],
  "type": "object"
 },
 "name": "diff_environments"
}
