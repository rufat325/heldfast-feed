{
 "description": "Place a demo market or limit order (optional TP/SL prices, idempotency_key).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 64,
    "type": "string"
   },
   "leverage": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "price": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "reduce_only": {
    "type": "boolean"
   },
   "side": {
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "size": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "sl_price": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "symbol": {
    "type": "string"
   },
   "tp_price": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "type": {
    "enum": [
     "market",
     "limit"
    ],
    "type": "string"
   }
  },
  "required": [
   "api_key",
   "symbol",
   "side",
   "type",
   "size"
  ],
  "type": "object"
 },
 "name": "demo_order"
}
