{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Validate JSON and pretty-print or minify it, optionally sorting object keys. Returns a precise parse error (with position) if invalid. Use to check and clean JSON instead of eyeballing it.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "input": {
    "description": "JSON text.",
    "maxLength": 100000,
    "minLength": 1,
    "type": "string"
   },
   "mode": {
    "default": "pretty",
    "description": "pretty = 2-space indent; minify = single line.",
    "enum": [
     "pretty",
     "minify"
    ],
    "type": "string"
   },
   "sort_keys": {
    "default": false,
    "description": "Sort object keys alphabetically (deep).",
    "type": "boolean"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "json_format",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "formatted": {
    "description": "The formatted JSON text.",
    "type": "string"
   },
   "valid": {
    "description": "Whether the input was valid JSON.",
    "type": "boolean"
   }
  },
  "required": [
   "valid",
   "formatted"
  ],
  "type": "object"
 },
 "title": "Format / validate JSON"
}
