{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Inspect a caller-supplied OpenAPI JSON document without fetching remote references.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "idempotency_key": {
    "description": "Stable key used to make a paid retry idempotent.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "spec": {
    "description": "OpenAPI JSON document to inspect; remote references are not fetched."
   }
  },
  "required": [
   "spec",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "inspect_openapi",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "OpenAPI version, servers, operations, response codes, and warnings.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "error": {},
   "extensions": {},
   "openapi": {
    "type": "string"
   },
   "operations": {
    "items": {},
    "type": "array"
   },
   "resolvedReferences": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "resource": {},
   "servers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "version": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Inspect OpenAPI"
}
