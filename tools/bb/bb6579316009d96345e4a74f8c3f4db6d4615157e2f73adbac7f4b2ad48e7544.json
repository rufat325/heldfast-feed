{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search U.S. federal prime-contract actions (USAspending, FY2015+) across companies, or rank companies by obligations with view=companies. Companies listed today plus reviewed links. Filter by ticker(s), agency, sub-agency, fiscal year or dates. Actions also support recipient, NAICS, award type and minimum absolute amount. Without tickers the window is at most 366 days. Exact decimal strings; signed obligations, not payments. Provisional recent months; Defense reports about 90 days late. Free: trailing 92 days; history: Pro.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agency": {
    "type": "string"
   },
   "award_type": {
    "pattern": "^[ABCD](,[ABCD])*$",
    "type": "string"
   },
   "fiscal_year": {
    "minimum": 2015,
    "type": "integer"
   },
   "from": {
    "format": "date",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "min_amount": {
    "pattern": "^\\d{1,36}(\\.\\d{1,2})?$",
    "type": "string"
   },
   "naics": {
    "pattern": "^\\d{2,6}$",
    "type": "string"
   },
   "page": {
    "default": 1,
    "minimum": 1,
    "type": "integer"
   },
   "period": {
    "enum": [
     "1Q",
     "2Q",
     "1Y",
     "ALL"
    ],
    "type": "string"
   },
   "recipient": {
    "type": "string"
   },
   "sort_actions": {
    "enum": [
     "date",
     "amount",
     "-amount"
    ],
    "type": "string"
   },
   "sort_companies": {
    "enum": [
     "net",
     "gross",
     "actions"
    ],
    "type": "string"
   },
   "sub_agency": {
    "type": "string"
   },
   "ticker": {
    "type": "string"
   },
   "to": {
    "format": "date",
    "type": "string"
   },
   "view": {
    "default": "actions",
    "enum": [
     "actions",
     "companies"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_gov_contracts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "action_date": {
       "type": "string"
      },
      "agency": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "sub_code": {
         "type": "string"
        },
        "sub_name": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "name",
        "sub_code",
        "sub_name"
       ],
       "type": "object"
      },
      "award_id": {
       "type": "string"
      },
      "award_type": {
       "enum": [
        "A",
        "B",
        "C",
        "D"
       ],
       "type": "string"
      },
      "cik": {
       "type": "string"
      },
      "company_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "description": {
       "type": "string"
      },
      "link_tier": {
       "enum": [
        "A",
        "B"
       ],
       "type": "string"
      },
      "modification_number": {
       "type": "string"
      },
      "naics": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "description": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "description"
       ],
       "type": "object"
      },
      "obligated_amount": {
       "pattern": "^-?\\d+\\.\\d{2}$",
       "type": "string"
      },
      "piid": {
       "type": "string"
      },
      "place_of_performance": {
       "additionalProperties": false,
       "properties": {
        "city": {
         "type": "string"
        },
        "country": {
         "type": "string"
        },
        "state": {
         "type": "string"
        }
       },
       "required": [
        "country",
        "state",
        "city"
       ],
       "type": "object"
      },
      "provisional": {
       "type": "boolean"
      },
      "psc": {
       "$ref": "#/properties/actions/items/properties/naics"
      },
      "recipient": {
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "parent_name": {
         "type": "string"
        },
        "parent_uei": {
         "type": "string"
        },
        "uei": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "uei",
        "parent_name",
        "parent_uei"
       ],
       "type": "object"
      },
      "source_url": {
       "type": "string"
      },
      "ticker": {
       "type": [
        "string",
        "null"
       ]
      },
      "transaction_id": {
       "type": "string"
      }
     },
     "required": [
      "transaction_id",
      "award_id",
      "piid",
      "modification_number",
      "action_date",
      "obligated_amount",
      "award_type",
      "agency",
      "recipient",
      "naics",
      "psc",
      "place_of_performance",
      "description",
      "link_tier",
      "provisional",
      "source_url",
      "ticker",
      "cik",
      "company_name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "caveats": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "companies": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "actions": {
       "$ref": "#/properties/companies/items/properties/rank"
      },
      "awards": {
       "$ref": "#/properties/companies/items/properties/rank"
      },
      "cik": {
       "type": "string"
      },
      "company_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "deobligated": {
       "$ref": "#/properties/actions/items/properties/obligated_amount"
      },
      "gross_obligated": {
       "$ref": "#/properties/actions/items/properties/obligated_amount"
      },
      "net_obligated": {
       "$ref": "#/properties/actions/items/properties/obligated_amount"
      },
      "rank": {
       "minimum": 0,
       "type": "integer"
      },
      "ticker": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "rank",
      "ticker",
      "cik",
      "company_name",
      "gross_obligated",
      "deobligated",
      "net_obligated",
      "actions",
      "awards"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "paging": {
    "additionalProperties": false,
    "description": "Paging state reconciled from ko.io meta.total_count and meta.softwall",
    "properties": {
     "continuation": {
      "description": "SIGNIN_REQUIRED = page>1 needs a (free) ko.io API key",
      "type": [
       "string",
       "null"
      ]
     },
     "has_more": {
      "description": "null = a full page came back and more MAY exist",
      "type": [
       "boolean",
       "null"
      ]
     },
     "next_page": {
      "anyOf": [
       {
        "$ref": "#/properties/paging/properties/total_count/anyOf/0"
       },
       {
        "type": "null"
       }
      ],
      "description": "Next page THIS caller can open; null when there is none (or sign-in is required)"
     },
     "page": {
      "type": "integer"
     },
     "per_page": {
      "type": "integer"
     },
     "plan_row_cap": {
      "anyOf": [
       {
        "$ref": "#/properties/paging/properties/total_count/anyOf/0"
       },
       {
        "type": "null"
       }
      ],
      "description": "Row cap the caller's plan applied to this page, if any"
     },
     "returned": {
      "type": "integer"
     },
     "total_count": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Total rows matching the request, when ko.io reported it"
     },
     "truncated_by_plan": {
      "description": "True when the plan's row cap withheld rows from this page",
      "type": "boolean"
     }
    },
    "required": [
     "page",
     "per_page",
     "returned",
     "total_count",
     "has_more",
     "next_page",
     "continuation",
     "plan_row_cap",
     "truncated_by_plan"
    ],
    "type": "object"
   },
   "plan_limit": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "continuation": {
        "$ref": "#/properties/plan_limit/anyOf/0/properties/policy_version"
       },
       "date_basis": {
        "$ref": "#/properties/plan_limit/anyOf/0/properties/policy_version"
       },
       "effective_period": {
        "$ref": "#/properties/plan_limit/anyOf/0/properties/policy_version"
       },
       "policy_version": {
        "type": [
         "string",
         "null"
        ]
       },
       "row_cap": {
        "anyOf": [
         {
          "$ref": "#/properties/paging/properties/total_count/anyOf/0"
         },
         {
          "type": "null"
         }
        ]
       },
       "truncated": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "window_end": {
        "$ref": "#/properties/plan_limit/anyOf/0/properties/policy_version"
       },
       "window_start": {
        "$ref": "#/properties/plan_limit/anyOf/0/properties/policy_version"
       }
      },
      "required": [
       "policy_version",
       "window_start",
       "window_end",
       "effective_period",
       "date_basis",
       "row_cap",
       "truncated",
       "continuation"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "The Free/keyless plan limits ko.io applied to this answer (null for paid callers)"
   },
   "universe": {
    "const": "listed_companies_plus_reviewed_links",
    "type": "string"
   },
   "view": {
    "enum": [
     "actions",
     "companies"
    ],
    "type": "string"
   },
   "window": {
    "additionalProperties": false,
    "properties": {
     "clamped": {
      "type": "boolean"
     },
     "date_basis": {
      "const": "action_date",
      "type": "string"
     },
     "end": {
      "type": "string"
     },
     "period": {
      "type": [
       "string",
       "null"
      ]
     },
     "start": {
      "type": "string"
     }
    },
    "required": [
     "start",
     "end",
     "clamped",
     "date_basis",
     "period"
    ],
    "type": "object"
   }
  },
  "required": [
   "view",
   "window",
   "universe",
   "caveats",
