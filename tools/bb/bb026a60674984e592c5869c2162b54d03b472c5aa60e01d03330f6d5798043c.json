 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "JS code to debug",
    "type": "string"
   },
   "function_name": {
    "description": "Function name to run",
    "type": "string"
   },
   "params": {
    "additionalProperties": {},
    "description": "Test parameters",
    "type": "object"
   }
  },
  "required": [
   "content",
   "function_name"
  ],
  "type": "object"
 },
 "name": "debug_function"
}
