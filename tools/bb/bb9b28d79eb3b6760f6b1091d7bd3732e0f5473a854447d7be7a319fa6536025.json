{
 "description": "Confirm the 6-digit code sent by agent_contact_set. Codes expire after 15 minutes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent_key": {
    "description": "Agent key from agent_register.",
    "minLength": 1,
    "type": "string"
   },
   "code": {
    "description": "The 6-digit code from the email.",
    "pattern": "^\\d{6}$",
    "type": "string"
   }
  },
  "required": [
   "code",
   "agent_key"
  ],
  "type": "object"
 },
 "name": "agent_contact_verify",
 "title": "Verify Agent Owner Email"
}
