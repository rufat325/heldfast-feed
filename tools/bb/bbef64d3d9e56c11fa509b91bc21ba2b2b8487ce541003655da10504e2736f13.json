{"description":"Prepares a free, NONBINDING signed proposal (preflight) for a desired SAAX capability. Validates capability, schema/version/digest, units, and the exact supported network/asset/rail/mode combination; returns a provider-signed proposal binding the request digest and normalized terms. Creates NO agreement, payment, custody deposit, service execution, resource reservation, or spending authority. A provider signature is NOT buyer acceptance. No preflight fee. Errors are typed DSC_* codes.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"capability":{"description":"Desired capability","properties":{"id":{"description":"Provider capability id","type":"string"}},"required":["id"],"type":"object"},"clientNonce":{"description":"Caller-chosen nonce (echoed; replay idempotency)","minLength":8,"type":"string"},"constraints":{"description":"Optional constraints","properties":{"deadline":{"description":"ISO-8601 deadline","type":"string"},"maxAmount":{"description":"Integer-string max amount","type":"string"}},"type":"object"},"financialProfile":{"description":"Financial axes","properties":{"asset":{"description":"CAIP-19 asset id","type":"string"},"mode":{"description":"Payment mode","type":"string"},"network":{"description":"CAIP-2 network id (e.g. eip155:8453)","type":"string"},"rail":{"description":"Rail: x402, mpp, ap2, acp, ach, card, internal-ledger, unknown","type":"string"}},"required":["network","asset","rail","mode"],"type":"object"},"intendedParties":{"description":"Intended parties","properties":{"buyer":{"description":"0x buyer address","type":"string"},"seller":{"description":"0x seller address","type":"string"}},"type":"object"},"issuedAt":{"description":"ISO-8601 client timestamp","type":"string"},"profileVersion":{"description":"SAAX Discovery profile version (e.g. 1.0.0)","type":"string"},"schema":{"description":"Expected commitment schema","properties":{"digest":{"description":"sha256:<64 hex> schema digest","type":"string"},"id":{"description":"Schema id (e.g. https://saax-protocol.com/schemas/commitment-manifest/v1)","type":"string"},"version":{"description":"Schema version","type":"string"}},"required":["id","version","digest"],"type":"object"},"units":{"description":"Amount + unit","properties":{"amount":{"description":"Integer-string settlement amount in the declared unit","type":"string"},"unit":{"description":"Explicit unit (e.g. micro-units of settlement asset)","type":"string"}},"required":["amount","unit"],"type":"object"}},"required":["profileVersion","capability","schema","units","financialProfile","clientNonce","issuedAt"],"type":"object"},"name":"prepare_commitment","title":"Prepare a free, nonbinding signed proposal (preflight)"}
