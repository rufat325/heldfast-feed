{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read the career record"
 },
 "description": "Returns resume-derived professional facts, document-vault metadata, person-stated preferences, writing preferences and unconfirmed hypotheses as separate fields. Resume text and document bodies are excluded.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "include": {
    "description": "Narrow the read. Omit for all four. A section you leave out comes back empty rather than absent, so do not read an omitted section as \"they have none\".",
    "items": {
     "enum": [
      "facts",
      "vault",
      "stated",
      "hypotheses"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "get_career_record",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "facts": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "functionPrimary": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "functionSecondary": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "seniority": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "skills": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "yearsExperience": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "functionPrimary",
       "functionSecondary",
       "yearsExperience",
       "seniority",
       "skills"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Null when no resume has been analyzed yet."
   },
   "hypotheses": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "createdAt": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "source": {
       "description": "Who formed it. Neither makes it a fact.",
       "enum": [
        "assistant",
        "user"
       ],
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "text",
      "createdAt",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "stated": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "coverLettersEnabled": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ]
       },
       "dealBreakers": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "preferredLocations": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "targetFunctions": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "targetFunctions",
       "preferredLocations",
       "dealBreakers",
       "coverLettersEnabled"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "vault": {
    "description": "Work-vault card titles and ids. Never their contents.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "writingPreferences": {
    "additionalProperties": false,
    "description": "Comes with `hypotheses`; both live in the same record.",
    "properties": {
     "dislikes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "likes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "likes",
     "dislikes"
    ],
    "type": "object"
   }
  },
  "required": [
   "facts",
   "vault",
   "stated",
   "writingPreferences",
   "hypotheses"
  ],
  "type": "object"
 },
 "title": "Read the career record"
}
