   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Canonical code-lookup tool for this server. Search Loa's CPT/HCPCS index using exact codes, clinical terms, or consumer phrases. Use this first when the user does not already know the CPT code, before calling pricing tools.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Filter by category: \"evaluation_management\", \"laboratory\", \"radiology\", \"surgery\", \"preventive\"",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of results (default 10, max 25)",
    "maximum": 25,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search query, procedure name, medical term, or CPT code number (e.g. \"knee MRI\", \"blood work\", \"99213\")",
    "type": "string"
   },
   "specialty": {
    "description": "Filter by medical specialty (e.g. \"cardiology\", \"dermatology\")",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_cpt_codes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "authority": {
      "enum": [
       "authoritative",
       "advisory",
       "estimate"
      ],
      "type": "string"
     },
     "basis": {
      "type": "string"
     },
     "methodology_url": {
      "format": "uri",
      "type": "string"
     },
     "source_scope": {
      "type": "string"
     },
     "source_url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "authority",
     "basis",
     "methodology_url"
    ],
    "type": "object"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "code": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "isCommon": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "name",
      "description",
      "category",
      "isCommon"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "specialty": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "query",
   "specialty",
   "category",
   "total",
   "provenance",
   "results"
  ],
  "type": "object"
 },
