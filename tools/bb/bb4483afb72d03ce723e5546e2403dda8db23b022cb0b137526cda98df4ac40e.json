{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Change user information (password) for a Cloud DB for PostgreSQL instance",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudPostgresqlInstanceNo": {
    "description": "Cloud PostgreSQL instance number",
    "type": "string"
   },
   "cloudPostgresqlUserList": {
    "description": "List of users to modify",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "User name to modify",
       "type": "string"
      },
      "password": {
       "description": "New password for the user",
       "type": "string"
      }
     },
     "required": [
      "name",
      "password"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "cloudPostgresqlInstanceNo",
   "cloudPostgresqlUserList"
  ],
  "type": "object"
 },
 "name": "ncloud_change_postgresql_users"
}
