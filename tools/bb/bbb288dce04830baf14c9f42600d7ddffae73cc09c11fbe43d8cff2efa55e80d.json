{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Add process monitoring plugin(s) to a server instance. Provide one or more process names (wildcards like *abc* allowed).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "configList": {
    "description": "Process names to monitor",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "instanceNo": {
    "description": "Server instance number",
    "type": "string"
   },
   "type": {
    "description": "Target type (default 'vpcserver')",
    "enum": [
     "vpcserver",
     "classicserver",
     "cloudhadoop"
    ],
    "type": "string"
   }
  },
  "required": [
   "instanceNo",
   "configList"
  ],
  "type": "object"
 },
 "name": "ncloud_add_process_plugin"
}
