{
 "description": "Reply to a discussion as the API key's owner. The reply is visible to all members immediately and notifies the discussion author. Fails with 409 if the discussion is locked. Set parent_reply_id to nest under another reply.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "description": "Plain-text/markdown body. Required unless content_json is given.",
    "maxLength": 20000,
    "type": "string"
   },
   "content_format": {
    "description": "Defaults to 'tiptap_json' with content_json, else 'markdown'",
    "enum": [
     "markdown",
     "tiptap_json"
    ],
    "type": "string"
   },
   "content_json": {
    "description": "Tiptap JSON body (alternative to content)"
   },
   "id": {
    "description": "Discussion uuid",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "parent_reply_id": {
    "description": "Reply uuid in the same discussion to nest under",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_discussion_reply"
}
