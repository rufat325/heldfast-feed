{
 "_meta": {
  "openai/toolInvocation/invoked": "Found neighborhoods",
  "openai/toolInvocation/invoking": "Searching NYC neighborhoods\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search NYC neighborhoods"
 },
 "description": "Search and filter NYC neighborhoods by borough or name. Returns NTA codes, names, boroughs, and centroid coordinates.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "borough": {
    "description": "Filter by borough",
    "enum": [
     "Manhattan",
     "Brooklyn",
     "Queens",
     "Bronx",
     "Staten Island"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max results",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search NTA name (case-insensitive)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search-neighborhoods",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Number of neighborhoods returned",
    "type": "number"
   },
   "neighborhoods": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "borough": {
       "type": [
        "number",
        "null"
       ]
      },
      "borough_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "lat": {
       "type": [
        "number",
        "null"
       ]
      },
      "lng": {
       "type": [
        "number",
        "null"
       ]
      },
      "nta_code": {
       "type": "string"
      },
      "nta_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "slug": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "nta_code",
      "nta_name",
      "borough",
      "borough_name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "neighborhoods"
  ],
  "type": "object"
 }
}
