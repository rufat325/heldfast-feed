{
 "description": "Run a backtest on a strategy with condition groups against historical data. Returns win rate, PnL, Sharpe ratio, drawdown, trade list, and equity curve.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "condition_groups": {
    "description": "Array of condition groups defining the strategy logic",
    "type": "array"
   },
   "exchange": {
    "default": "binance",
    "description": "Exchange to fetch candles from (default binance)",
    "type": "string"
   },
   "group_logic": {
    "default": "AND",
    "description": "Logic between condition groups: AND or OR",
    "type": "string"
   },
   "initial_capital": {
    "default": 10000,
    "description": "Initial capital for backtest (default 10000)",
    "type": "number"
   },
   "stop_loss_pct": {
    "description": "Stop loss percentage (e.g., 2 for 2%)",
    "type": "number"
   },
   "symbol": {
    "description": "Trading pair (e.g., BTCUSDT)",
    "type": "string"
   },
   "take_profit_pct": {
    "description": "Take profit percentage (e.g., 5 for 5%)",
    "type": "number"
   },
   "timeframe": {
    "description": "Candle timeframe (1m, 5m, 15m, 1h, 4h, 1d)",
    "type": "string"
   }
  },
  "required": [
   "symbol",
   "timeframe",
   "condition_groups"
  ],
  "type": "object"
 },
 "name": "backtest_strategy"
}
