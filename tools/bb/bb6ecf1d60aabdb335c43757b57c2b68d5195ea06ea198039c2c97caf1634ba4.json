{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Accept a rule suggestion from transaction_get_list_rule_suggestions: saves a categorization rule for that merchant and account as a DRAFT. A draft books nothing and categorizes no transactions until a person approves it on the Rules screen, so tell the user it is a draft awaiting their approval, never that it is live; rule_status in the response confirms it. Accepting the same suggestion again reuses the draft; it fails if the merchant already has a live rule booking to a different account.",
 "inputSchema": {
  "properties": {
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "conditions": {
    "items": {
     "properties": {
      "amountMax": {
       "maxLength": 30,
       "pattern": "^([0-9]+(\\.[0-9]{1,4})?)?$",
       "type": "string"
      },
      "amountMin": {
       "maxLength": 30,
       "pattern": "^([0-9]+(\\.[0-9]{1,4})?)?$",
       "type": "string"
      },
      "group": {
       "maximum": 19,
       "minimum": 0,
       "type": "integer"
      },
      "kind": {
       "enum": [
        "RULE_CONDITION_KIND_COUNTERPARTY",
        "RULE_CONDITION_KIND_NAME_CONTAINS",
        "RULE_CONDITION_KIND_DESCRIPTOR_REGEX",
        "RULE_CONDITION_KIND_MERCHANT_REGEX",
        "RULE_CONDITION_KIND_MCC",
        "RULE_CONDITION_KIND_PROVIDER",
        "RULE_CONDITION_KIND_ACCOUNT_ID",
        "RULE_CONDITION_KIND_CURRENCY",
        "RULE_CONDITION_KIND_AMOUNT_RANGE",
        "RULE_CONDITION_KIND_DIRECTION",
        "RULE_CONDITION_KIND_CARD",
        "RULE_CONDITION_KIND_TEAM_MEMBER",
        "RULE_CONDITION_KIND_CATEGORY",
        "RULE_CONDITION_KIND_ALL"
       ],
       "type": "string"
      },
      "negate": {
       "type": "boolean"
      },
      "reviewStatus": {
       "enum": [
        "RULE_CONDITION_REVIEW_STATUS_UNSPECIFIED",
        "RULE_CONDITION_REVIEW_STATUS_APPROVED",
        "RULE_CONDITION_REVIEW_STATUS_IN_REVIEW"
       ],
       "type": "string"
      },
      "textValue": {
       "maxLength": 500,
       "type": "string"
      },
      "uuidValue": {
       "maxLength": 36,
       "pattern": "^([0-9a-fA-F-]{36})?$",
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "counterpartyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "glAccountPath": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*$",
    "type": "string"
   }
  },
  "required": [
   "companyId",
   "counterpartyId"
  ],
  "type": "object"
 },
 "name": "transaction_accept_rule_suggestion",
 "outputSchema": {
  "properties": {
   "closedMonthCount": {
    "type": "integer"
   },
   "failures": {
    "items": {
     "properties": {
      "message": {
       "type": "string"
      },
      "transactionId": {
       "anyOf": [
        {
         "description": "UUID value wrapper.",
         "properties": {
          "value": {
           "format": "uuid",
           "type": "string"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "ruleId": {
    "anyOf": [
     {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "ruleReused": {
    "type": "boolean"
   },
   "ruleStatus": {
    "enum": [
     "RULE_STATUS_UNSPECIFIED",
     "RULE_STATUS_DRAFT",
     "RULE_STATUS_ACTIVE",
     "RULE_STATUS_PAUSED",
     "RULE_STATUS_SUPERSEDED",
     "RULE_STATUS_REJECTED"
    ],
    "type": "string"
   },
   "skippedCount": {
    "type": "integer"
   },
   "updatedCount": {
    "type": "integer"
   }
  },
  "type": "object"
 },
 "title": "Accept Rule Suggestion"
}
