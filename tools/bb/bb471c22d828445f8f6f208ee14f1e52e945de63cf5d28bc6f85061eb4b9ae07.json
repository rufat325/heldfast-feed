{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a case"
 },
 "description": "WRITE: change a case's subject, requester, assignee (team/agent), status, priority, type, brand, form, tags or custom fields. Sends nothing to the customer. `tags` sets the case's tag list (use kayako_add_case_tags to append). Trashing is deliberately not exposed. Kayako: PUT /api/v1/cases/{id}.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assigned_agent_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "assigned_team_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "brand_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "case_id": {
    "description": "The case id (integer).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "field_values": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom field values keyed by field key, e.g. {\"order_number\": \"1234\"}. For multi-select fields pass CSV options \u2014 ALL options must be passed; omitted ones are removed.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "form_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "priority_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "requester_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "status_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "subject": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "description": "Comma-separated tags (sets the list).",
    "maxLength": 500,
    "type": "string"
   },
   "type_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "case_id"
  ],
  "type": "object"
 },
 "name": "kayako_update_case",
 "title": "Update a case"
}
