{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan Platform Delivery Matrix"
 },
 "description": "Plan multi-ratio delivery of one source sequence to TikTok, Reels, Shorts, YouTube, LinkedIn, X, and Facebook from a local spec table: sequence settings, reframe scale math, duration and file-size fit, caption safe zones, and ordered apply routes. Local-only; never changes Premiere.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expected_cep_target": {
    "additionalProperties": false,
    "anyOf": [
     {
      "required": [
       "sequence_id"
      ]
     },
     {
      "required": [
       "source_item"
      ]
     }
    ],
    "description": "Optional reviewed CEP sequence/clip identity and exact tick ranges. Checked before every generated command; UXP refuses this CEP-only guard.",
    "properties": {
     "backend": {
      "const": "cep",
      "description": "Backend namespace for these IDs.",
      "type": "string"
     },
     "clip": {
      "additionalProperties": false,
      "description": "Optional exact reviewed timeline clip.",
      "properties": {
       "effect": {
        "additionalProperties": false,
        "description": "Reviewed effect and parameter identity checked before mutation.",
        "properties": {
         "display_name": {
          "description": "Optional exact host display name.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         "match_name": {
          "description": "Effect match name from host inspection.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         "parameter_index": {
          "description": "Inspected zero-based parameter index.",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
         },
         "parameter_name": {
          "description": "Exact inspected parameter name.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "match_name",
         "parameter_index",
         "parameter_name"
        ],
        "type": "object"
       },
       "end_ticks": {
        "description": "Exact expected exclusive timeline end ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "in_ticks": {
        "description": "Exact expected source In ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "node_id": {
        "description": "Stable CEP node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "out_ticks": {
        "description": "Exact expected exclusive source Out ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "project_item_id": {
        "description": "Expected source project-item node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "start_ticks": {
        "description": "Exact expected timeline start ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "track_index": {
        "description": "Expected zero-based track index; identity still checked.",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       },
       "track_type": {
        "description": "Expected media track group.",
        "enum": [
         "video",
         "audio"
        ],
        "type": "string"
       }
      },
      "required": [
       "node_id",
       "track_type",
       "track_index"
      ],
      "type": "object"
     },
     "project_document_id": {
      "description": "Exact Premiere project document ID observed during review.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "sequence_id": {
      "description": "Stable expected active sequence ID.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "source_item": {
      "additionalProperties": false,
      "description": "Reviewed source identity for a source-only operation.",
      "properties": {
       "media_path": {
        "description": "Optional exact source-media path.",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
       },
       "node_id": {
        "description": "Exact project-item node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "node_id"
      ],
      "type": "object"
     }
    },
    "required": [
     "backend"
    ],
    "type": "object"
   },
   "expected_project_path": {
    "description": "Optional absolute saved-project path. Every generated CEP command refuses before its body when the active project differs or is unsaved. UXP commands refuse this CEP-only guard; local-only tools do not inspect Premiere. Omit to keep existing behavior.",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "export_preset_hint": {
    "description": "Optional export preset name to echo into the export step.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "additionalProperties": false,
    "description": "Source sequence characteristics.",
    "properties": {
     "duration_seconds": {
      "description": "Source duration in seconds.",
      "maximum": 172800,
      "minimum": 0.001,
      "type": "number"
     },
     "frame_rate": {
      "description": "Source frame rate in frames per second.",
      "maximum": 240,
      "minimum": 1,
      "type": "number"
     },
     "has_captions": {
      "description": "Whether the source already carries a caption track.",
      "type": "boolean"
     },
     "height": {
      "description": "Source frame height in pixels.",
      "maximum": 16384,
      "minimum": 1,
      "type": "integer"
     },
     "sequence_id": {
      "description": "Optional Premiere sequence ID recorded in the plan evidence.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "width": {
      "description": "Source frame width in pixels.",
      "maximum": 16384,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "width",
     "height",
     "frame_rate",
     "duration_seconds"
    ],
    "type": "object"
   },
   "strategy": {
    "description": "Reframe strategy when the aspect ratio changes; defaults to auto_reframe.",
    "enum": [
     "auto_reframe",
     "pad_blur",
     "center_crop",
     "letterbox"
    ],
    "type": "string"
   },
   "targets": {
    "description": "Unique platform ids to plan for.",
    "items": {
     "description": "Platform id.",
     "enum": [
      "tiktok",
      "instagram_reels",
      "instagram_feed",
      "instagram_story",
      "youtube_shorts",
      "youtube",
      "linkedin",
      "x",
      "facebook_reels"
     ],
     "type": "string"
    },
    "maxItems": 9,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "source",
   "targets"
  ],
  "type": "object"
 },
 "name": "plan_platform_delivery_matrix",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true; on failure, diagnostic detail when the tool provides it."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "receipt": {
    "additionalProperties": true,
    "description": "Versioned common mutation receipt; success never implies rendered verification.",
    "type": "object"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Plan Platform Delivery Matrix"
}
