{
 "description": "Create a runbook. Requires `write` scope. title and runbookType are required (e.g. incident / deployment / rollback).",
 "inputSchema": {
  "properties": {
   "bodyMd": {
    "description": "Markdown body",
    "type": "string"
   },
   "linkedAppIds": {
    "description": "Project ids this runbook applies to",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "linkedIncidentSeverities": {
    "description": "Incident severities this runbook covers",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pinned": {
    "description": "Pin to the top of the runbook list",
    "type": "boolean"
   },
   "runbookType": {
    "description": "Runbook type, e.g. incident / deployment / rollback (required)",
    "type": "string"
   },
   "tags": {
    "description": "Tags (stored lowercased)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Runbook title (required)",
    "type": "string"
   },
   "visibilityRoleMin": {
    "description": "Minimum role to view (default 'viewer')",
    "type": "string"
   }
  },
  "required": [
   "title",
   "runbookType"
  ],
  "type": "object"
 },
 "name": "create_runbook"
}
