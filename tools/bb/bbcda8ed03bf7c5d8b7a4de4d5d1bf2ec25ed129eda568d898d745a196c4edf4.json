{
 "description": "[mode: hybrid] Run a stored scenario; real subprocess where possible, falls back to simulated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "device": {
    "type": "string"
   },
   "platform": {
    "enum": [
     "ios",
     "android",
     "flutter",
     "react-native",
     "web"
    ],
    "type": "string"
   },
   "projectPath": {
    "type": "string"
   },
   "retries": {
    "type": "number"
   },
   "scenarioId": {
    "type": "string"
   },
   "timeout": {
    "type": "number"
   }
  },
  "required": [
   "projectPath",
   "scenarioId",
   "platform"
  ],
  "type": "object"
 },
 "name": "run_scenario_test"
}
