{
 "description": "Get the portfolio's dividend yield per year (on current value and on invested capital) plus the dividend CAGR. Use this for 'what's my dividend yield?'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountIds": {
    "description": "Depot ID(s) to include",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "cagrYears": {
    "default": 5,
    "description": "Window for dividend CAGR",
    "maximum": 10,
    "minimum": 2,
    "type": "number"
   },
   "calculationType": {
    "default": "actual",
    "description": "'predicted' includes current-year predictions",
    "enum": [
     "actual",
     "predicted"
    ],
    "type": "string"
   }
  },
  "required": [
   "accountIds"
  ],
  "type": "object"
 },
 "name": "get_portfolio_yield"
}
