{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Quote Gripper"
 },
 "description": "Compliant gripper kits with two TPU pads, two rigid carriers and two keepers per kit. Quote the exact customer-reviewed configuration and revision as one complete set. Consumes one quote allowance. Reuse idempotencyKey for retries. Returns a browser link for customer checkout; individual-part update and checkout are blocked.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "accessToken": {
    "description": "Guest token returned by printing.sessions.start. Optional when Authorization already carries a permanent key or guest token.",
    "maxLength": 138,
    "minLength": 34,
    "type": "string"
   },
   "configuration": {
    "additionalProperties": false,
    "description": "Workbench configuration including geometry, materials, quantity and order options.",
    "properties": {
     "backer_thickness": {
      "description": "Carrier thickness",
      "maximum": 10,
      "minimum": 6,
      "type": "number"
     },
     "bottom_stop": {
      "description": "Lower seat",
      "maximum": 3,
      "minimum": 1.5,
      "type": "number"
     },
     "face_skin": {
      "description": "Contact wall",
      "maximum": 2.4,
      "minimum": 1.2,
      "type": "number"
     },
     "fit_clearance": {
      "description": "Sliding fit",
      "maximum": 0.6,
      "minimum": 0.15,
      "type": "number"
     },
     "fulfillmentMethod": {
      "enum": [
       "shipping",
       "pickup",
       "courier"
      ],
      "type": "string"
     },
     "grip_depth": {
      "description": "Contact depth",
      "maximum": 10,
      "minimum": 4,
      "type": "number"
     },
     "gyroid_depth": {
      "description": "Gyroid layer",
      "maximum": 8,
      "minimum": 2,
      "type": "number"
     },
     "gyroid_level": {
      "description": "Sheet level",
      "maximum": 0.8,
      "minimum": 0.35,
      "type": "number"
     },
     "gyroid_period": {
      "description": "Cell size",
      "maximum": 12,
      "minimum": 4,
      "type": "number"
     },
     "gyroid_resolution": {
      "description": "Export spacing",
      "maximum": 0.8,
      "minimum": 0.4,
      "type": "number"
     },
     "keeper_thickness": {
      "description": "Keeper thickness",
      "maximum": 4,
      "minimum": 2,
      "type": "number"
     },
     "lattice_depth": {
      "description": "Rib layer",
      "maximum": 20,
      "minimum": 8,
      "type": "number"
     },
     "mount_access_clearance": {
      "description": "Driver clearance",
      "maximum": 0.8,
      "minimum": 0.3,
      "type": "number"
     },
     "mount_head_diameter": {
      "description": "Mounting head",
      "maximum": 10,
      "minimum": 6,
      "type": "number"
     },
     "mount_hole_diameter": {
      "description": "Mounting bore",
      "maximum": 5.5,
      "minimum": 3,
      "type": "number"
     },
     "mount_slot_extra": {
      "description": "Slot adjustment",
      "maximum": 8,
      "minimum": 0,
      "type": "number"
     },
     "mount_spacing": {
      "description": "Mounting centers",
      "maximum": 80,
      "minimum": 20,
      "type": "number"
     },
     "mounting_slots": {
      "type": "boolean"
     },
     "padMaterialId": {
      "enum": [
       "black_tpu_85a",
       "black_tpu_95a"
      ],
      "type": "string"
     },
     "pad_height": {
      "description": "Pad height",
      "maximum": 40,
      "minimum": 16,
      "type": "number"
     },
     "pad_width": {
      "description": "Pad width",
      "maximum": 110,
      "minimum": 50,
      "type": "number"
     },
     "preview_gap": {
      "description": "Opening",
      "maximum": 70,
      "minimum": 10,
      "type": "number"
     },
     "productionSpeed": {
      "enum": [
       "standard",
       "rush"
      ],
      "type": "string"
     },
     "quantity": {
      "description": "Complete kits; each kit has two pads, two carriers and two keepers.",
      "maximum": 75,
      "minimum": 1,
      "type": "integer"
     },
     "rail_depth": {
      "description": "Rail depth limit",
      "maximum": 3.4,
      "minimum": 1.8,
      "type": "number"
     },
     "rail_head": {
      "description": "Rail head",
      "maximum": 8,
      "minimum": 5,
      "type": "number"
     },
     "rail_neck": {
      "description": "Rail neck",
      "maximum": 4,
      "minimum": 2.4,
      "type": "number"
     },
     "retaining_bolt_diameter": {
      "description": "Retaining bolt bore",
      "maximum": 4,
      "minimum": 2.5,
      "type": "number"
     },
     "rib_bow": {
      "description": "Rib bow limit",
      "maximum": 2.4,
      "minimum": 0.8,
      "type": "number"
     },
     "rib_count": {
      "description": "Rib count",
      "maximum": 11,
      "minimum": 5,
      "type": "integer"
     },
     "rib_thickness": {
      "description": "Rib wall",
      "maximum": 2,
      "minimum": 1,
      "type": "number"
     },
     "rigidMaterialId": {
      "enum": [
       "black_pla",
       "red_pla",
       "silver_pla",
       "matte_black_pla",
       "orange_petg",
       "white_petg",
       "black_petg",
       "black_asa",
       "black_ppa_cf"
      ],
      "type": "string"
     },
     "root_fillet": {
      "description": "Root allowance",
      "maximum": 0.8,
      "minimum": 0.3,
      "type": "number"
     },
     "spine_depth": {
      "description": "Retention spine",
      "maximum": 6,
      "minimum": 4,
      "type": "number"
     },
     "vertical_clearance": {
      "description": "Vertical fit",
      "maximum": 0.5,
      "minimum": 0.1,
      "type": "number"
     },
     "wave_count": {
      "description": "Contact waves",
      "maximum": 6,
      "minimum": 3,
      "type": "integer"
     }
    },
    "required": [
     "preview_gap",
     "pad_width",
     "pad_height",
     "gyroid_depth",
     "lattice_depth",
     "grip_depth",
     "gyroid_period",
     "gyroid_level",
     "gyroid_resolution",
     "wave_count",
     "face_skin",
     "spine_depth",
     "rib_count",
     "rib_thickness",
     "rib_bow",
     "root_fillet",
     "fit_clearance",
     "backer_thickness",
     "rail_neck",
     "rail_head",
     "rail_depth",
     "bottom_stop",
     "vertical_clearance",
     "keeper_thickness",
     "retaining_bolt_diameter",
     "mount_access_clearance",
     "mount_spacing",
     "mount_hole_diameter",
     "mount_slot_extra",
     "mount_head_diameter",
     "mounting_slots",
     "quantity",
     "padMaterialId",
     "rigidMaterialId",
     "productionSpeed",
     "fulfillmentMethod"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "description": "Stable unique key for retrying this complete-set quote.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "reviewConfirmed": {
    "const": true,
    "description": "True only after the customer has reviewed this exact design revision.",
    "type": "boolean"
   },
   "reviewedRevision": {
    "description": "Exact revision returned by preparation and reviewed by the customer.",
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   }
  },
  "required": [
   "configuration",
   "reviewedRevision",
   "reviewConfirmed",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "quote_gripper",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": true,
    "properties": {
     "build": {
      "additionalProperties": true,
      "description": "Complete-set quote and authoritative server totals, returned after quoting.",
      "type": "object"
     },
     "reviewUrl": {
      "description": "Private design review link for the customer.",
      "format": "uri",
      "type": "string"
     },
     "revision": {
      "description": "Hash of the exact normalized design and quantity.",
      "type": "string"
     },
     "success": {
      "const": true,
      "description": "Confirms the operation succeeded.",
      "type": "boolean"
     },
     "warnings": {
      "description": "Design and manufacturing limitations to review.",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "success",
     "revision",
     "reviewUrl"
    ],
    "type": "object"
   },
   {
    "additionalProperties": true,
    "description": "A structured AIURION tool error.",
    "properties": {
     "error": {
      "additionalProperties": true,
      "description": "Machine-readable error details.",
      "properties": {
       "code": {
        "description": "Stable error code.",
        "type": "string"
       },
       "message": {
        "description": "Human-readable error message.",
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     "success": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "success",
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Quote Gripper"
}
