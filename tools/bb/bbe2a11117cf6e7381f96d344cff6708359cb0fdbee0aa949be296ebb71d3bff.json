{
 "description": "Search for teams or competitions by fuzzy name to find their canonical OpenFootAPI IDs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "q": {
    "description": "Search query, e.g. 'Arsenal', 'Real Madrid', 'Bundesliga'",
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Optional filter by entity type",
    "enum": [
     "team",
     "competition"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "openfoot_search",
 "title": "Search teams and competitions"
}
