{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Whether Solana data is currently being served: latest probe status and finalized slot. When to use: Before relying on the Solana verdict endpoints, or to explain a 503 from them. Prefer another tool: Not a measure of the Solana network itself, only of this service's access to it; use the latest-slot endpoint to see chain progress. Example: solana_network_health {}",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {},
  "type": "object"
 },
 "name": "solana_network_health",
 "outputSchema": {
  "$defs": {
   "MetaSolana": {
    "additionalProperties": false,
    "properties": {
     "age_seconds": {
      "description": "Age of the data at response time",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "as_of": {
      "description": "When the data was read from Solana",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
     },
     "cache": {
      "enum": [
       "hit",
       "miss",
       "stale"
      ],
      "type": "string"
     },
     "commitment": {
      "const": "finalized",
      "description": "Every read is at finalized commitment",
      "type": "string"
     },
     "slot": {
      "description": "Context slot of the finalized read",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "stale": {
      "description": "True when served past its fresh TTL (stale-on-error)",
      "type": "boolean"
     }
    },
    "required": [
     "slot",
     "commitment",
     "as_of",
     "age_seconds",
     "cache",
     "stale"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "last_probe_at": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "latency_ms": {
    "type": [
     "number",
     "null"
    ]
   },
   "meta": {
    "$ref": "#/$defs/MetaSolana"
   },
   "slot": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Finalized slot of the latest successful probe"
   },
   "status": {
    "description": "Latest probe result; `unavailable` while Solana data is not configured",
    "enum": [
     "up",
     "down",
     "unknown",
     "unavailable"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "slot",
   "latency_ms",
   "last_probe_at",
   "meta"
  ],
  "type": "object"
 },
 "title": "Solana data status"
}
