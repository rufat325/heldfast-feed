{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Apply the exact reviewed PITR restore with user confirmation, confirm=true and the review_digest. Deploy scope. Queues recovery into a NEW database, preserving the serving database and traffic. Repeating the accepted plan returns its receipt; acceptance is not verified completion. Hosted MCP requires an account credential without resource confinement.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "const": true,
    "type": "boolean"
   },
   "pitr_plan_id": {
    "pattern": "^ppl_[a-f0-9]{24}$",
    "type": "string"
   },
   "review_digest": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "pitr_plan_id",
   "review_digest",
   "confirm"
  ],
  "type": "object"
 },
 "name": "impreza_apply_pitr_restore",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "receipt": {
      "properties": {
       "accepted_at": {
        "type": "string"
       },
       "agent_id": {
        "type": "string"
       },
       "binding_id": {
        "type": "string"
       },
       "binding_revision": {
        "type": "string"
       },
       "command_id": {
        "type": "string"
       },
       "config_id": {
        "type": "string"
       },
       "consumer_deployment_id": {
        "type": "string"
       },
       "phase": {
        "type": "string"
       },
       "plan_id": {
        "type": "string"
       },
       "provider_deployment_id": {
        "type": "string"
       },
       "provider_version": {
        "type": "string"
       },
       "recovery": {
        "type": "string"
       },
       "restore_database": {
        "type": "string"
       },
       "status": {
        "const": "accepted",
        "type": "string"
       },
       "storage_bucket": {
        "type": "string"
       },
       "storage_prefix": {
        "type": "string"
       },
       "storage_service_id": {
        "type": "integer"
       },
       "target_time": {
        "type": "string"
       }
      },
      "required": [
       "plan_id",
       "command_id",
       "target_time",
       "restore_database",
       "status",
       "accepted_at",
       "phase",
       "recovery",
       "binding_id",
       "binding_revision",
       "consumer_deployment_id",
       "provider_deployment_id",
       "provider_version",
       "agent_id",
       "config_id",
       "storage_service_id",
       "storage_bucket",
       "storage_prefix"
      ],
      "type": "object"
     },
     "replayed": {
      "type": "boolean"
     }
    },
    "required": [
     "receipt",
     "replayed"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Apply point-in-time restore"
}
