{
 "description": "Link a legacy unlinked report to its canonical subject person (audited one-way reconciliation \u2014 an already-linked report is a typed 409). Records a SUBJECT_LINKED event. Receipt-backed. Requires job_feedback:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "idempotencyKey": {
    "description": "Durable-receipt idempotency key. Same key + same payload replays the stored receipt; same key + changed payload is a 409.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "note": {
    "maxLength": 2000,
    "type": "string"
   },
   "reportId": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "subjectContractId": {
    "$ref": "#/properties/reportId"
   },
   "subjectUserId": {
    "$ref": "#/properties/reportId"
   }
  },
  "required": [
   "reportId",
   "subjectUserId",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_job_feedback_link_subject",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
