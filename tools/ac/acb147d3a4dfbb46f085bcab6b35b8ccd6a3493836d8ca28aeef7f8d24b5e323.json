{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Alias of search_catalog. Find statistical datasets by query, optional country and source_name.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "Optional country name (e.g. 'Germany').",
    "type": "string"
   },
   "limit": {
    "description": "Max cards (default 8, max 16).",
    "maximum": 16,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "What to find, e.g. 'GDP annual current prices'.",
    "type": "string"
   },
   "source_name": {
    "description": "Optional source filter, e.g. 'Eurostat'.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_datasets"
}
