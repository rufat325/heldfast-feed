{
 "annotations": {
  "destructiveHint": true,
  "title": "Create an event"
 },
 "description": "Create a base event (name, description, timezone, one or more date ranges, location, keywords, classification). Ticket types are then set up in the Humanitix console. Requires a special permission Humanitix activates on your account (403 otherwise). Humanitix: POST /v1/events.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "classification": {
    "description": "How the event is classified. subcategory must belong to category.",
    "properties": {
     "category": {
      "description": "Event category, e.g. music.",
      "enum": [
       "autoBoatAndAir",
       "businessAndProfessional",
       "charityAndCauses",
       "communityAndCulture",
       "familyAndEducation",
       "fashionAndBeauty",
       "filmMediaAndEntertainment",
       "foodAndDrink",
       "governmentAndPolitics",
       "healthAndWellness",
       "hobbiesAndSpecialInterest",
       "homeAndLifestyle",
       "music",
       "performingAndVisualArts",
       "religionAndSpirituality",
       "schoolActivities",
       "scienceAndTechnology",
       "seasonalAndHoliday",
       "sportsAndFitness",
       "travelAndOutdoor",
       "other"
      ],
      "type": "string"
     },
     "subcategory": {
      "description": "Subcategory within the category (e.g. jazz for music). Requires category.",
      "type": "string"
     },
     "type": {
      "description": "Event type, e.g. concertOrPerformance.",
      "enum": [
       "appearanceOrSigning",
       "attraction",
       "campTripOrRetreat",
       "classTrainingOrWorkshop",
       "concertOrPerformance",
       "conference",
       "convention",
       "dinnerOrGala",
       "festivalOrFair",
       "gameOrCompetition",
       "meetingOrNetworkingEvent",
       "partyOrSocialGathering",
       "raceOrEnduranceEvent",
       "rally",
       "screening",
       "seminarOrTalk",
       "tour",
       "tournament",
       "tradeShowConsumerShowOrExpo",
       "other"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "dates": {
    "description": "One or more date ranges (1-700).",
    "items": {
     "properties": {
      "endDate": {
       "description": "End as an ISO 8601 date-time, e.g. 2026-11-01T09:00:00.000Z.",
       "minLength": 1,
       "type": "string"
      },
      "startDate": {
       "description": "Start as an ISO 8601 date-time, e.g. 2026-11-01T09:00:00.000Z.",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "startDate",
      "endDate"
     ],
     "type": "object"
    },
    "maxItems": 700,
    "minItems": 1,
    "type": "array"
   },
   "description": {
    "description": "Event description.",
    "type": "string"
   },
   "event_location": {
    "description": "Where the event happens: online, address (geocoded), custom (free text) or toBeAnnounced.",
    "oneOf": [
     {
      "properties": {
       "instructions": {
        "description": "Joining instructions.",
        "type": "string"
       },
       "onlineUrl": {
        "description": "Link attendees join at.",
        "type": "string"
       },
       "type": {
        "const": "online",
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     },
     {
      "properties": {
       "address": {
        "description": "Full street address.",
        "type": "string"
       },
       "latLng": {
        "description": "[latitude, longitude].",
        "items": {
         "type": "number"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
       },
       "placeId": {
        "description": "Google Places place_id.",
        "type": "string"
       },
       "type": {
        "const": "address",
        "type": "string"
       },
       "venueName": {
        "description": "Venue name (may be empty).",
        "type": "string"
       }
      },
      "required": [
       "type",
       "address",
       "venueName",
       "latLng"
      ],
      "type": "object"
     },
     {
      "properties": {
       "address": {
        "description": "Free-text address.",
        "minLength": 1,
        "type": "string"
       },
       "type": {
        "const": "custom",
        "type": "string"
       },
       "venueName": {
        "description": "Venue name.",
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "type",
       "address",
       "venueName"
      ],
      "type": "object"
     },
     {
      "properties": {
       "type": {
        "const": "toBeAnnounced",
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     }
    ]
   },
   "keywords": {
    "description": "Up to 10 unique search keywords, each 1-25 characters.",
    "items": {
     "maxLength": 25,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "name": {
    "description": "Event name.",
    "minLength": 1,
    "type": "string"
   },
   "override_location": {
    "description": "Query a region other than your account's own (ISO 3166-1 alpha-2). Humanitix stores data per region.",
    "enum": [
     "AU",
     "NZ",
     "US",
     "FJ",
     "CA",
     "GB",
     "SG",
     "DE",
     "MY",
     "MX"
    ],
    "type": "string"
   },
   "timezone": {
    "description": "IANA timezone, e.g. Australia/Sydney or Pacific/Auckland.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "timezone",
   "dates"
  ],
  "type": "object"
 },
 "name": "humanitix_create_event",
 "title": "Create an event"
}
