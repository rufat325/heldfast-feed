{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "agent:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create or reuse one bounded authentication relationship between the caller and a destination AI without exposing credentials to model context. The hosted flow completes first-time provider setup when needed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "aiId": {
    "description": "Destination AI whose advertised sign-in requirement is being satisfied.",
    "maxLength": 191,
    "minLength": 1,
    "type": "string"
   },
   "methodId": {
    "description": "Exact authentication method identifier advertised by the destination AI.",
    "maxLength": 191,
    "minLength": 1,
    "type": "string"
   },
   "requestId": {
    "description": "Caller-generated idempotency key for this mutation. Reuse the same requestId only when retrying the same logical request; use a new value for different work.",
    "maxLength": 160,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
    "type": "string"
   },
   "saveToDarwinVault": {
    "description": "Whether the user explicitly requested that a one-time credential be saved in Darwin Vault.",
    "type": "boolean"
   },
   "source": {
    "description": "Credential source to use only through the secure hosted authentication flow.",
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "one_time",
        "type": "string"
       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "darwin_vault",
        "type": "string"
       },
       "vaultItemId": {
        "maxLength": 191,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "kind",
       "vaultItemId"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "itemReference": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
       },
       "kind": {
        "const": "external_vault",
        "type": "string"
       },
       "vaultConnectionId": {
        "maxLength": 191,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "kind",
       "vaultConnectionId",
       "itemReference"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "aiId",
   "methodId",
   "source",
   "saveToDarwinVault",
   "requestId"
  ],
  "type": "object"
 },
 "name": "authenticate_session",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "actionId": {
    "anyOf": [
     {
      "maxLength": 191,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "connectionId": {
    "anyOf": [
     {
      "maxLength": 191,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "interaction": {
    "additionalProperties": false,
    "properties": {
     "displayName": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "expiresAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     "hostname": {
      "maxLength": 253,
      "minLength": 1,
      "type": "string"
     },
     "id": {
      "maxLength": 191,
      "minLength": 1,
      "type": "string"
     },
     "kind": {
      "enum": [
       "connection"
      ],
      "type": "string"
     },
     "retentionChoices": {
      "items": {
       "enum": [
        "temporary",
        "saved"
       ],
       "type": "string"
      },
      "maxItems": 2,
      "type": "array"
     },
     "scopeDescriptions": {
      "items": {
       "maxLength": 240,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "state": {
      "enum": [
       "required",
       "pending",
       "complete",
       "declined",
       "expired",
       "failed"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "state",
     "displayName",
     "hostname",
     "expiresAt",
     "kind",
     "retentionChoices",
     "scopeDescriptions"
    ],
    "type": "object"
   },
   "state": {
    "enum": [
     "connected",
     "required"
    ],
    "type": "string"
   },
   "targetAiId": {
    "maxLength": 191,
    "minLength": 1,
    "type": "string"
   },
   "webLink": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "targetAiId",
   "actionId",
   "state",
   "connectionId"
  ],
  "type": "object"
 },
 "title": "Authenticate session"
}
