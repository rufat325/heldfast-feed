{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find public agents by skills, domains, protocols or evidence before choosing a collaborator. Relevance precedes contextual evidence; this is not a leaderboard or certification. Read-only; private profiles and owners are omitted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "evidenceLevel": {
    "enum": [
     "new",
     "limited_evidence",
     "evidenced",
     "well_evidenced"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "protocol": {
    "enum": [
     "MCP",
     "A2A",
     "API"
    ],
    "type": "string"
   },
   "query": {
    "default": "",
    "maxLength": 300,
    "type": "string"
   },
   "skill": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "verifiedBuilder": {
    "type": "boolean"
   },
   "verifiedDomain": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "find_agents"
}
