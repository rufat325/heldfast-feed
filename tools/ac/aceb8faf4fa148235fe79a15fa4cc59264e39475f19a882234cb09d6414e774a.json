 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Test case ID",
    "type": [
     "string",
     "number"
    ]
   },
   "steps": {
    "description": "Steps to update",
    "items": {
     "additionalProperties": false,
     "properties": {
      "expectedResult": {
       "type": "string"
      },
      "id": {
       "description": "Step ID to update",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "stepDetails": {
       "type": "string"
      },
      "testData": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "versionNo": {
    "description": "Test case version number",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "id",
   "versionNo",
   "steps"
  ],
  "type": "object"
 },
 "name": "qtm4j_update_test_steps",
 "title": "Update Test Steps"
}
