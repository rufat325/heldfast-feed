{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a payment via SBP (Russian fast payment system). Returns a confirmation URL / deep-link for the payer's banking app. MOVES REAL MONEY \u2014 irreversible.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "anyOf": [
     {
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    ],
    "description": "SBP payment amount"
   },
   "confirmation_type": {
    "default": "redirect",
    "description": "Confirmation type: redirect (needs return_url), embedded, or qr",
    "enum": [
     "redirect",
     "embedded",
     "qr"
    ],
    "type": "string"
   },
   "currency": {
    "default": "RUB",
    "description": "Currency (ISO-4217, default RUB)",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "description": {
    "description": "Payment description",
    "maxLength": 128,
    "type": "string"
   },
   "return_url": {
    "description": "Return URL \u2014 REQUIRED when confirmation_type=redirect",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "description"
  ],
  "type": "object"
 },
 "name": "create_sbp_payment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "confirmation_url": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "paid": {
    "type": "boolean"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Create SBP payment"
}
