{
 "description": "Create a new calendar event in the CRM.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "address": {
    "description": "Event address / location",
    "type": "string"
   },
   "appointmentStatus": {
    "description": "Status of the appointment (e.g. confirmed, cancelled, showed, noshow, invalid)",
    "type": "string"
   },
   "assignedUserId": {
    "description": "User ID to assign the event to",
    "type": "string"
   },
   "calendarId": {
    "description": "Calendar ID to create the event in",
    "type": "string"
   },
   "contactId": {
    "description": "Contact ID to associate with the event",
    "type": "string"
   },
   "endTime": {
    "description": "Event end time (ISO string)",
    "type": "string"
   },
   "groupId": {
    "description": "Calendar group ID",
    "type": "string"
   },
   "locationId": {
    "description": "CRM location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "notes": {
    "description": "Event notes",
    "type": "string"
   },
   "selectedSlot": {
    "description": "Selected slot identifier",
    "type": "string"
   },
   "selectedTimezone": {
    "description": "IANA timezone for the event",
    "type": "string"
   },
   "startTime": {
    "description": "Event start time (ISO string)",
    "type": "string"
   },
   "title": {
    "description": "Event title",
    "type": "string"
   },
   "toNotify": {
    "description": "Send notification to the contact",
    "type": "boolean"
   }
  },
  "required": [
   "access_token",
   "calendarId",
   "locationId",
   "contactId",
   "startTime",
   "endTime"
  ],
  "type": "object"
 },
 "name": "crm_create_event"
}
