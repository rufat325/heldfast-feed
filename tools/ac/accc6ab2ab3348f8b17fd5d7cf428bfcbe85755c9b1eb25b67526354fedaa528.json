 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date": {
    "description": "Date in YYYY-MM-DD format (default today)",
    "type": "string"
   },
   "kcal": {
    "type": "number"
   },
   "minutes": {
    "description": "Minutes to shift",
    "type": "integer"
   },
   "shift_from_id": {
    "description": "Exercise ID to shift time FROM",
    "type": "integer"
   },
   "shift_from_name": {
    "type": "string"
   },
   "shift_to_id": {
    "description": "Exercise ID to shift time TO",
    "type": "integer"
   },
   "shift_to_name": {
    "type": "string"
   }
  },
  "required": [
   "shift_to_id",
   "shift_from_id",
   "minutes"
  ],
  "type": "object"
 },
 "name": "edit_exercise_entries"
}
