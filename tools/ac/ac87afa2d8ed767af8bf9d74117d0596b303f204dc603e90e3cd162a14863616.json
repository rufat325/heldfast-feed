{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update a user-defined custom schema in Cloud Insight.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cw_key": {
    "description": "Product key (cw_key) of the schema to update",
    "type": "string"
   },
   "fields": {
    "description": "Updated schema field definitions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "aggregations": {
       "additionalProperties": {
        "items": {
         "enum": [
          "COUNT",
          "SUM",
          "MAX",
          "MIN",
          "AVG"
         ],
         "type": "string"
        },
        "type": "array"
       },
       "description": "Metric fields only: aggregation functions per interval, e.g. {\"Min1\": [\"AVG\"], \"Min5\": [\"AVG\",\"MAX\"]}",
       "propertyNames": {
        "enum": [
         "Min1",
         "Min5",
         "Min30",
         "Hour2",
         "Day1"
        ]
       },
       "type": "object"
      },
      "counter": {
       "description": "Counter metric (default false)",
       "type": "boolean"
      },
      "dataType": {
       "description": "Data type (dimension fields must be STRING)",
       "enum": [
        "STRING",
        "INTEGER",
        "LONG",
        "FLOAT"
       ],
       "type": "string"
      },
      "desc": {
       "description": "Field description",
       "type": "string"
      },
      "dimension": {
       "description": "true if this field is a dimension (default false)",
       "type": "boolean"
      },
      "idDimension": {
       "description": "Dimension used to identify resources in event rules (exactly one dimension must be the idDimension)",
       "type": "boolean"
      },
      "metric": {
       "description": "true if this field is a metric (default false)",
       "type": "boolean"
      },
      "metricType": {
       "description": "Metric type",
       "enum": [
        "BASIC",
        "EXTENDED",
        "CUSTOM"
       ],
       "type": "string"
      },
      "name": {
       "description": "Field name",
       "type": "string"
      }
     },
     "required": [
      "name",
      "dataType"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "prodName": {
    "description": "Product name of the schema to update",
    "type": "string"
   }
  },
  "required": [
   "prodName",
   "cw_key",
   "fields"
  ],
  "type": "object"
 },
 "name": "ncloud_update_product_schema"
}
