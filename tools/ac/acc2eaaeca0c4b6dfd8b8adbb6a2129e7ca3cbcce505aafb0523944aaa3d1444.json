 "description": "Audit a package manifest for what it leaves unpinned and undeclared. Reports a wildcard or latest specifier that accepts the next breaking release, a git or file specifier whose contents can change without the manifest changing, a version that is not an exact semantic version, missing engines, a dependency declared in both a runtime and a development group, and empty scripts. Pay 100000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "forbid_ranges": {
    "description": "Report any range specifier, not only unbounded ones. Defaults to false.",
    "type": "boolean"
   },
   "manifest": {
    "description": "A package.json as JSON. No registry is contacted and nothing is installed.",
    "example": {
     "dependencies": {
      "express": "^4.18.2",
      "internal-utils": "git+ssh://git@github.com/example/internal-utils.git#main",
      "left-pad": "*",
      "zod": "3.23.8"
     },
     "devDependencies": {
      "typescript": "~5.5.0",
      "zod": "3.23.8"
     },
     "name": "@example/orders-api",
     "scripts": {
      "build": "tsc -p .",
      "lint": "",
      "test": "node --test"
     },
     "version": "2.1"
    },
    "type": "object"
   },
   "require_engines": {
    "description": "Whether a missing engines block is a finding. Defaults to true.",
    "type": "boolean"
   },
   "require_fields": {
    "description": "Fields that must be present and non-empty. Defaults to name, version and license.",
    "example": [
     "name",
     "version",
     "license",
     "repository"
    ],
    "items": {
     "maxLength": 64,
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "manifest"
  ],
  "type": "object"
 },
 "name": "package_manifest_audit",
