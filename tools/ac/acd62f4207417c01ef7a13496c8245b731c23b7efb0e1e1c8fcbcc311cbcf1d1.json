{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read baseline context for a GitHub repository, including metadata, README summary, package.json summary, tech stack, common scripts, workflow file names, governance signals, agent instruction file summaries, open issues, and open PRs.\n\nUse this tool at the start of any SDLC workflow to understand the codebase before planning or creating work items.\n\nArgs:\n  - owner (string?): GitHub org or user. Defaults to GITHUB_OWNER env var.\n  - repo (string?): Repository name. Defaults to GITHUB_REPO env var.\n  - includeReadme (boolean): Include truncated README. Default: true.\n  - includePackageJson (boolean): Include package.json summary, detected package manager, tech stack, and common scripts. Default: false.\n  - includeWorkflows (boolean): Include .github/workflows/*.yml file names. Default: false.\n  - includeAgentInstructions (boolean): Include summaries of AGENTS.md/CLAUDE.md if present. Default: false.\n  - includeGovernance (boolean): Include whether a CODEOWNERS file exists. Default: false.\n  - includePolicy (boolean): Include validated repository policy and provenance. Default: false.\n  - includeOpenIssues (boolean): Include recent open issues. Default: false.\n  - includeOpenPRs (boolean): Include open pull requests. Default: false.\n  - issueLimit (number): Max open issues to fetch. Default: 20, max: 100.\n  - prLimit (number): Max open PRs to fetch. Default: 20, max: 100.\n  - maxReadmeChars (number): Max README characters before truncation. Default: 3000.\n  - maxInstructionChars (number): Max characters per agent instruction file summary. Default: 1000.\n\nReturns: Markdown summary of the repository context, plus structured content. Missing files (README, package.json, agent instructions) degrade gracefully rather than failing the whole call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "includeAgentInstructions": {
    "default": false,
    "description": "Include summaries of agent instruction files (AGENTS.md, CLAUDE.md) if present at the repo root.",
    "type": "boolean"
   },
   "includeGovernance": {
    "default": false,
    "description": "Include lightweight governance signals (currently: whether a CODEOWNERS file exists). For full branch protection details, use branch_protection_status.",
    "type": "boolean"
   },
   "includeOpenIssues": {
    "default": false,
    "description": "Include a list of recent open issues (up to 20).",
    "type": "boolean"
   },
   "includeOpenPRs": {
    "default": false,
    "description": "Include a list of open pull requests (up to 20).",
    "type": "boolean"
   },
   "includePackageJson": {
    "default": false,
    "description": "Include a package.json summary, detected package manager, tech stack, and common scripts.",
    "type": "boolean"
   },
   "includePolicy": {
    "default": false,
    "description": "Include the validated .agentic-sdlc.yml policy summary, rule IDs, digest, and source ref/SHA.",
    "type": "boolean"
   },
   "includeReadme": {
    "default": true,
    "description": "Include a truncated README summary.",
    "type": "boolean"
   },
   "includeWorkflows": {
    "default": false,
    "description": "Include `.github/workflows/*.yml` file names (names only, not permissions -- use workflow_permissions_audit for that).",
    "type": "boolean"
   },
   "issueLimit": {
    "default": 20,
    "description": "Max number of open issues to fetch when includeOpenIssues is true. Default: 20, max: 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "maxInstructionChars": {
    "default": 1000,
    "description": "Max characters per agent instruction file summary before truncation. Default: 1000.",
    "maximum": 20000,
    "minimum": 200,
    "type": "integer"
   },
   "maxReadmeChars": {
    "default": 3000,
    "description": "Max README characters before truncation. Default: 3000.",
    "maximum": 20000,
    "minimum": 200,
    "type": "integer"
   },
   "owner": {
    "description": "GitHub owner (org or user). Falls back to GITHUB_OWNER env var.",
    "type": "string"
   },
   "prLimit": {
    "default": 20,
    "description": "Max number of open PRs to fetch when includeOpenPRs is true. Default: 20, max: 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "repo": {
    "description": "GitHub repo name. Falls back to GITHUB_REPO env var.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "repo_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentInstructions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "summary"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "appliedPolicyRules": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "source": {
       "const": "repository",
       "type": "string"
      }
     },
     "required": [
      "id",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "defaultBranch": {
    "type": "string"
   },
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "fullName": {
    "type": "string"
   },
   "governance": {
    "additionalProperties": false,
    "properties": {
     "codeownersFound": {
      "type": "boolean"
     }
    },
    "required": [
     "codeownersFound"
    ],
    "type": "object"
   },
   "language": {
    "type": [
     "string",
     "null"
    ]
   },
   "openIssues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "createdAt": {
       "type": "string"
      },
      "labels": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "number": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "number",
      "title",
      "labels",
      "createdAt",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "openIssuesCount": {
    "type": "number"
   },
   "openPRs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": "string"
      },
      "createdAt": {
       "type": "string"
      },
      "draft": {
       "type": "boolean"
      },
      "number": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "number",
      "title",
      "author",
      "draft",
      "createdAt",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "packageJsonSummary": {
    "type": "string"
   },
   "packageManager": {
    "enum": [
     "npm",
     "pnpm",
     "yarn",
     "bun",
     "unknown"
    ],
    "type": "string"
   },
   "policy": {
    "additionalProperties": false,
    "properties": {
     "defaultWorkType": {
      "enum": [
       "docs",
       "feature",
       "bugfix",
       "refactor",
       "security",
       "release",
       "infra"
      ],
      "type": "string"
     },
     "degraded": {
      "type": "boolean"
     },
     "found": {
      "type": "boolean"
     },
     "protectedPaths": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "releaseBlockingLabels": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "requireChangelog": {
      "type": "boolean"
     },
     "requireCodeOwnersForProtectedPaths": {
      "type": "boolean"
     },
     "requireIssueLink": {
      "type": "boolean"
     },
     "requireRollbackPlan": {
      "type": "boolean"
     },
     "requiredChecks": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "appId": {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        "name": {
         "type": "string"
        },
        "source": {
         "const": "check_run",
         "type": "string"
        }
       },
       "required": [
        "name",
        "source",
        "appId"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "requiredReviewerRuleIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "riskRuleIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "schemaVersion": {
      "const": 1,
      "type": "number"
     }
    },
    "required": [
     "found",
     "degraded",
     "schemaVersion",
     "requiredChecks",
     "protectedPaths",
     "riskRuleIds",
     "requiredReviewerRuleIds",
     "releaseBlockingLabels",
     "requireIssueLink",
     "requireCodeOwnersForProtectedPaths",
     "requireChangelog",
     "requireRollbackPlan"
    ],
    "type": "object"
   },
   "policyDigest": {
    "type": "string"
   },
   "policyErrors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "policySources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "blobSha": {
       "type": [
        "string",
        "null"
       ]
      },
      "digest": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "default",
        "repository"
       ],
       "type": "string"
      },
      "path": {
       "type": [
        "string",
        "null"
       ]
      },
      "ref": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "kind",
      "path",
      "ref",
      "blobSha",
      "digest"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "policyWarnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "promptInjectionWarnings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "categories": {
       "items": {
        "enum": [
         "instruction_override",
         "role_impersonation",
         "tool_coercion",
         "secret_exfiltration",
         "data_exfiltration",
         "encoded_instruction"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "severity": {
       "enum": [
        "medium",
        "high"
       ],
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "required": [
      "source",
      "severity",
      "categories"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pushedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "readmeSummary": {
    "type": "string"
   },
   "scripts": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "stargazersCount": {
    "type": "number"
   },
   "techStack": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "topics": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "trustBoundary": {
    "additionalProperties": false,
    "properties": {
     "callerAndRepositoryContent": {
      "const": "untrusted",
      "type": "string"
     },
     "instructionHandling": {
      "const": "never_execute",
      "type": "string"
     },
     "permissionHandling": {
      "const": "never_expand",
      "type": "string"
     },
     "secretHandling": {
      "const": "never_reveal",
      "type": "string"
     }
    },
    "required": [
     "callerAndRepositoryContent",
     "instructionHandling",
     "secretHandling",
     "permissionHandling"
    ],
    "type": "object"
   },
   "visibility": {
    "type": "string"
   },
   "workflows": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "fullName",
   "description",
   "defaultBranch",
   "visibility",
   "language",
   "stargazersCount",
   "openIssuesCount",
   "topics",
   "pushedAt"
  ],
  "type": "object"
 },
 "title": "Get Repository Context"
}
