{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return a portable user-confirmed palette from an explicit season choice. For correction, pass the prior palette reference so source and revision are retained. Confirm only the user\u2019s stated choice. Keep the new reference for later calls; this does not write account or native report data.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "confirmed": {
    "const": true,
    "type": "boolean"
   },
   "previous_palette_ref": {
    "maxLength": 1400,
    "minLength": 16,
    "type": "string"
   },
   "season_id": {
    "enum": [
     "bright_spring",
     "warm_spring",
     "light_spring",
     "light_summer",
     "cool_summer",
     "soft_summer",
     "soft_autumn",
     "warm_autumn",
     "deep_autumn",
     "deep_winter",
     "cool_winter",
     "bright_winter"
    ],
    "type": "string"
   }
  },
  "required": [
   "season_id",
   "confirmed"
  ],
  "type": "object"
 },
 "name": "select_palette",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "const": "select_palette",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "caveat": {
      "maxLength": 600,
      "type": "string"
     },
     "colors": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "hex": {
         "pattern": "^#[0-9A-F]{6}$",
         "type": "string"
        },
        "label": {
         "type": "string"
        }
       },
       "required": [
        "label",
        "hex"
       ],
       "type": "object"
      },
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
     },
     "confirmed": {
      "type": "boolean"
     },
     "guidance": {
      "maxLength": 600,
      "type": "string"
     },
     "palette_ref": {
      "maxLength": 1400,
      "minLength": 16,
      "type": "string"
     },
     "quiz_version": {
      "anyOf": [
       {
        "const": "tonebook.quiz.2026-09-23",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "revision": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
     },
     "season": {
      "type": "string"
     },
     "season_id": {
      "enum": [
       "bright_spring",
       "warm_spring",
       "light_spring",
       "light_summer",
       "cool_summer",
       "soft_summer",
       "soft_autumn",
       "warm_autumn",
       "deep_autumn",
       "deep_winter",
       "cool_winter",
       "bright_winter"
      ],
      "type": "string"
     },
     "source": {
      "enum": [
       "quiz_suggestion",
       "user_selection"
      ],
      "type": "string"
     },
     "storage": {
      "maxLength": 600,
      "type": "string"
     },
     "suggested_season_id": {
      "anyOf": [
       {
        "enum": [
         "bright_spring",
         "warm_spring",
         "light_spring",
         "light_summer",
         "cool_summer",
         "soft_summer",
         "soft_autumn",
         "warm_autumn",
         "deep_autumn",
         "deep_winter",
         "cool_winter",
         "bright_winter"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "version": {
      "const": "tonebook.palette.v1",
      "type": "string"
     }
    },
    "required": [
     "version",
     "season_id",
     "source",
     "confirmed",
     "quiz_version",
     "suggested_season_id",
     "revision",
     "palette_ref",
     "season",
     "colors",
     "guidance",
     "caveat",
     "storage"
    ],
    "type": "object"
   },
   "schema_version": {
    "const": "tonebook.connector.v1",
    "type": "string"
   }
  },
  "required": [
   "schema_version",
   "kind",
   "result"
  ],
  "type": "object"
 },
 "title": "Confirm or correct a palette choice"
}
