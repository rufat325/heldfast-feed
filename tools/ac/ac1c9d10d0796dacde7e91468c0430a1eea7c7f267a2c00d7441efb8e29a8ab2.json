{
 "_legacy": {
  "bucket": "checkout",
  "successor": "https://api.trusteed.xyz/demo-store/mcp/checkout"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the current state of a cart created with create_cart: status, lines, totals, selected shipping, when it was previewed, its order if one exists and a pointer to get_trust_receipt. Read-only: it changes nothing and does not open any approval. Use it to resume a purchase; for UCP checkouts use ucp_get_checkout. Checkout guide: read the MCP resource trusteed://guides/checkout.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "agent_key": {
    "description": "Sandbox credential from `create_sandbox_key`. Use this when your client cannot set an `Authorization: Bearer` header.",
    "type": "string"
   },
   "cart_id": {
    "description": "The cart id returned by create_cart (the checkout session id, a valid UUID).",
    "type": "string"
   }
  },
  "required": [
   "cart_id"
  ],
  "type": "object"
 },
 "name": "get_checkout_state",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "actor": {
    "enum": [
     "buyer",
     "merchant",
     "agent"
    ],
    "type": "string"
   },
   "blocking_expires_at": {
    "description": "ISO-8601 UTC instant at which the pending approval stops being valid. Not the checkout session validity: that is expires_at.",
    "type": "string"
   },
   "blocking_requirement": {
    "enum": [
     "none",
     "merchant_approval",
     "merchant_rejected",
     "buyer_mandate_approval",
     "buyer_payment",
     "preview",
     "session_closed",
     "unknown"
    ],
    "type": "string"
   },
   "checkout_session_id": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "expires_at": {
    "type": "string"
   },
   "expires_in_seconds": {
    "type": "number"
   },
   "lines": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "line_price_cents": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "product_id": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "unit_price_cents": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "quantity",
      "unit_price_cents",
      "line_price_cents"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_tool": {
    "type": "string"
   },
   "order": {
    "additionalProperties": true,
    "properties": {
     "external_order_id": {
      "type": "string"
     },
     "order_id": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "order_id",
     "status"
    ],
    "type": "object"
   },
   "other_requirements": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "previewed_at": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "receipt": {
    "additionalProperties": true,
    "properties": {
     "checkout_session_id": {
      "type": "string"
     },
     "tool": {
      "const": "get_trust_receipt",
      "type": "string"
     }
    },
    "required": [
     "tool",
     "checkout_session_id"
    ],
    "type": "object"
   },
   "shipping": {
    "additionalProperties": true,
    "properties": {
     "handle": {
      "type": "string"
     },
     "price_cents": {
      "type": "number"
     },
     "title": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "status": {
    "type": "string"
   },
   "suggested_next_tool": {
    "type": "string"
   },
   "totals": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "amount_cents": {
       "type": "number"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "amount_cents"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "checkout_session_id",
   "status",
   "currency",
   "lines",
   "totals",
   "blocking_requirement"
  ],
  "type": "object"
 }
}
