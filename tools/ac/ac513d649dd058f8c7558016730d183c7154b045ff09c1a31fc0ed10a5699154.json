{
 "description": "Update metadata for an experience you own. Blocked during active journeys. All fields except slug are optional.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color_from": {
    "type": "string"
   },
   "color_to": {
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "estimated_duration": {
    "enum": [
     "15-30 min",
     "30-45 min",
     "1-2 hours",
     "Several hours",
     "Multi-day",
     "1-2 weeks",
     "Multi-week"
    ],
    "type": "string"
   },
   "image_prompt": {
    "maxLength": 2000,
    "type": "string"
   },
   "intensity": {
    "enum": [
     "LOW",
     "MEDIUM",
     "HIGH"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "relevance": {
    "maxLength": 2000,
    "type": "string"
   },
   "slug": {
    "description": "Experience slug to update",
    "type": "string"
   },
   "tagline": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "update_experience"
}
