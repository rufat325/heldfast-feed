{
 "description": "Long-presses at coordinates on the device screen",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device_id": {
    "pattern": "^[\\w\\-.:]{1,256}$",
    "type": "string"
   },
   "duration": {
    "maximum": 10000,
    "minimum": 1,
    "type": "number"
   },
   "x": {
    "type": "number"
   },
   "y": {
    "type": "number"
   }
  },
  "required": [
   "device_id",
   "x",
   "y"
  ],
  "type": "object"
 },
 "name": "long_press"
}
