{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Replace a memory when the user's own statement contradicts it, keeping what is still true: stored 'standup at 2:30', user says 'it is 3pm now' -> 'standup is at 3pm (was 2:30)'. The old version stays in history. Not for new facts or ones that can both be true (use remember).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "new_content": {
    "description": "The corrected fact, one sentence.",
    "type": "string"
   },
   "old_memory_id": {
    "description": "Id of the outdated memory.",
    "type": "string"
   }
  },
  "required": [
   "old_memory_id",
   "new_content"
  ],
  "type": "object"
 },
 "name": "update",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "new_memory_id": {},
   "old_memory_id": {},
   "status": {}
  },
  "type": "object"
 },
 "title": "Update an outdated memory"
}
