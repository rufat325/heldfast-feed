{
 "description": "Create an approval checkpoint for a high-risk action before execution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "file": {
    "description": "Path to the annotated markdown file",
    "type": "string"
   },
   "reason": {
    "description": "Reason for approval request",
    "type": "string"
   },
   "tool": {
    "description": "High-risk tool name (e.g., batch_apply, rollback_memo)",
    "type": "string"
   }
  },
  "required": [
   "file",
   "tool",
   "reason"
  ],
  "type": "object"
 },
 "name": "request_approval_checkpoint"
}
