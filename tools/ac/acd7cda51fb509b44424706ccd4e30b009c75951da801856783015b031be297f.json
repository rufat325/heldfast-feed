{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Service health"
 },
 "description": "Free. Liveness and store readiness. Returns 200 whenever the server is up. `ready` is false while the store is still ingesting after a restart; paid endpoints answer 503 (and take no payment) until it is true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "health",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "ingest": {
    "additionalProperties": true,
    "properties": {
     "added": {
      "type": "number"
     },
     "done": {
      "type": "number"
     },
     "error": {
      "type": [
       "string",
       "null"
      ]
     },
     "total": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "ready": {
    "description": "True once the store has ingested every raw file.",
    "type": "boolean"
   },
   "version": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Service health"
}
