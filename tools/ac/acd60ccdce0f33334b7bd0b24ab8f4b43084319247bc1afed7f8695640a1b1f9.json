{
 "description": "Register a webhook endpoint for Stone events",
 "inputSchema": {
  "properties": {
   "events": {
    "description": "Event types (e.g. payment.paid, pix.received, anticipation.settled)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "secret": {
    "description": "Optional HMAC signing secret",
    "type": "string"
   },
   "url": {
    "description": "HTTPS endpoint to receive events",
    "type": "string"
   }
  },
  "required": [
   "url",
   "events"
  ],
  "type": "object"
 },
 "name": "register_webhook"
}
