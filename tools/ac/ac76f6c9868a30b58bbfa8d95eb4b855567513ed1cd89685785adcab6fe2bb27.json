{
 "description": "Collects code blocks and conversation summaries into a structured context for documentation. Supports automatic language detection, duplicate removal, and statistics.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoDetectLanguage": {
    "default": true,
    "type": "boolean"
   },
   "codeBlocks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "filename": {
       "type": "string"
      },
      "language": {
       "default": "text",
       "type": "string"
      }
     },
     "required": [
      "code"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "conversationSummary": {
    "minLength": 1,
    "type": "string"
   },
   "includeStats": {
    "default": false,
    "type": "boolean"
   },
   "rawText": {
    "type": "string"
   },
   "removeDuplicates": {
    "default": true,
    "type": "boolean"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "conversationSummary"
  ],
  "type": "object"
 },
 "name": "muse_collect_code_context"
}
