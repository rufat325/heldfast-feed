{
 "description": "Create a blocked time slot on a CRM calendar to prevent bookings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "assignedUserId": {
    "description": "User ID whose calendar is blocked",
    "type": "string"
   },
   "calendarId": {
    "description": "Calendar ID to block time on",
    "type": "string"
   },
   "endTime": {
    "description": "Block end time (ISO string)",
    "type": "string"
   },
   "locationId": {
    "description": "CRM location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "startTime": {
    "description": "Block start time (ISO string)",
    "type": "string"
   },
   "title": {
    "description": "Title / reason for the blocked slot",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "calendarId",
   "locationId",
   "startTime",
   "endTime"
  ],
  "type": "object"
 },
 "name": "crm_create_blocked_slot"
}
