{
 "description": "Send a Meta CAPI event (Facebook/Instagram). Required creds: pixel_id, access_token. Recommended: hashed user_data (em, ph) for match quality. fbc is auto-built from fbclid + timestamp. Stores the request + response in dr_conversion_sends.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "account_id": {
    "type": "string"
   },
   "click_id_row": {
    "type": "string"
   },
   "conversion_value": {
    "type": "number"
   },
   "creds": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "currency": {
    "type": "string"
   },
   "email": {
    "description": "Will be SHA-256 hashed before send",
    "type": "string"
   },
   "event_name": {
    "description": "Default 'Purchase'",
    "type": "string"
   },
   "event_source_url": {
    "type": "string"
   },
   "event_time": {
    "type": "string"
   },
   "fbclid": {
    "type": "string"
   },
   "fbp": {
    "description": "Browser pixel cookie value (_fbp)",
    "type": "string"
   },
   "ip_address": {
    "type": "string"
   },
   "phone": {
    "description": "Will be SHA-256 hashed before send",
    "type": "string"
   },
   "session_id": {
    "type": "string"
   },
   "user_agent": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "dr_send_meta_conversion"
}
