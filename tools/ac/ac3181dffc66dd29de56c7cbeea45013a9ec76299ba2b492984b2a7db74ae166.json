{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get one AdSense account by resource name, e.g. accounts/pub-123.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account": {
    "pattern": "^accounts\\/[^/]+$",
    "type": "string"
   }
  },
  "required": [
   "account"
  ],
  "type": "object"
 },
 "name": "adsense_get_account"
}
