{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Open design"
 },
 "description": "Load a .tensorcad.json document from disk and return a design_id for it. Opening the same path twice returns the same handle.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "path": {
    "description": "Path to a .tensorcad.json file, absolute or relative to the server's directory.",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "tensorcad_open_design",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "design_id": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "params_total": {
    "type": "number"
   },
   "path": {
    "type": "string"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "counts": {
      "additionalProperties": false,
      "properties": {
       "error": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "info": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "warning": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       }
      },
      "required": [
       "error",
       "warning",
       "info"
      ],
      "type": "object"
     },
     "ok": {
      "description": "True when nothing blocks building this design.",
      "type": "boolean"
     },
     "top_findings": {
      "description": "The worst few findings. Call tensorcad_validate for all of them.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "hint": {
         "description": "What to change to clear the finding.",
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "path": {
         "description": "Block path the finding is about.",
         "type": "string"
        },
        "port": {
         "type": "string"
        },
        "rule": {
         "description": "Stable rule id, e.g. \"flash-head-dim\".",
         "type": "string"
        },
        "severity": {
         "enum": [
          "error",
          "warning",
          "info"
         ],
         "type": "string"
        }
       },
       "required": [
        "rule",
        "severity",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "ok",
     "counts",
     "top_findings"
    ],
    "type": "object"
   }
  },
  "required": [
   "design_id",
   "revision",
   "name",
   "path",
   "params_total",
   "validation"
  ],
  "type": "object"
 },
 "title": "Open design"
}
