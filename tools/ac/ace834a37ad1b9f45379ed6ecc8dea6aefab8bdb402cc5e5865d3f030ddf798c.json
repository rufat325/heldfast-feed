{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit an appointment request. A Western Sky team member calls the customer to confirm the time; it is not final until then. Only call this after the customer has confirmed every detail.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "city": {
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "email": {
    "format": "email",
    "maxLength": 254,
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "name": {
    "description": "Customer full name",
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   },
   "new_customer": {
    "description": "True if Western Sky has never been to this address",
    "type": "boolean"
   },
   "phone": {
    "description": "Best phone number, 10-digit US",
    "maxLength": 25,
    "minLength": 10,
    "type": "string"
   },
   "preferred_time": {
    "description": "Customer's preferred day/time in their words, if no window was picked",
    "maxLength": 200,
    "type": "string"
   },
   "problem": {
    "description": "What's going on, in the customer's words: equipment, symptoms, how long",
    "maxLength": 1000,
    "minLength": 5,
    "type": "string"
   },
   "service": {
    "enum": [
     "Heating repair",
     "Cooling repair",
     "Heating or cooling tune-up",
     "Plumbing repair",
     "Water heater",
     "New system estimate",
     "Other"
    ],
    "type": "string"
   },
   "street": {
    "maxLength": 120,
    "minLength": 3,
    "type": "string"
   },
   "unit": {
    "maxLength": 30,
    "type": "string"
   },
   "window_start": {
    "description": "window_start from get_available_times, if the customer picked one",
    "type": "string"
   },
   "zip": {
    "description": "5-digit ZIP",
    "pattern": "^\\d{5}$",
    "type": "string"
   }
  },
  "required": [
   "name",
   "phone",
   "street",
   "city",
   "zip",
   "service",
   "problem"
  ],
  "type": "object"
 },
 "name": "request_appointment",
 "title": "Request an appointment"
}
