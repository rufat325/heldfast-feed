{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:page"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Save website page content"
 },
 "description": "Write the allowlisted page content fields in page. Free. Without confirm:true it returns a preview only and sends nothing; pass confirm:true only after the owner approves the exact change. Saved changes are visible immediately on a live site; publication is a separate step (soclo_page_publish). A lost write reply must be reconciled with soclo_page_get, soclo_page_pages and soclo_page_versions before retrying.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "confirm": {
    "description": "true only after the owner approved the exact change. Omit or pass false to get a preview: nothing is sent.",
    "type": "boolean"
   },
   "page": {
    "additionalProperties": false,
    "description": "Only these app-writable content fields. Publication is a separate operation: soclo_page_publish.",
    "properties": {
     "blurb": {
      "anyOf": [
       {
        "maxLength": 10000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "buttons": {
      "anyOf": [
       {
        "items": {
         "maxLength": 80,
         "type": "string"
        },
        "maxItems": 30,
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "headline": {
      "anyOf": [
       {
        "maxLength": 1000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "news": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": false,
         "properties": {
          "at": {
           "maxLength": 100,
           "type": "string"
          },
          "detail": {
           "maxLength": 10000,
           "type": "string"
          },
          "title": {
           "maxLength": 1000,
           "type": "string"
          }
         },
         "type": "object"
        },
        "maxItems": 100,
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "offers": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": false,
         "properties": {
          "detail": {
           "maxLength": 10000,
           "type": "string"
          },
          "title": {
           "maxLength": 1000,
           "type": "string"
          },
          "until": {
           "maxLength": 100,
           "type": "string"
          }
         },
         "type": "object"
        },
        "maxItems": 100,
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "product_optin": {
      "anyOf": [
       {
        "items": {
         "maxLength": 200,
         "type": "string"
        },
        "maxItems": 300,
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "show_gallery": {
      "type": "boolean"
     },
     "show_hours": {
      "type": "boolean"
     },
     "slug": {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "page"
  ],
  "type": "object"
 },
 "name": "soclo_page_save",
 "title": "Save website page content"
}
