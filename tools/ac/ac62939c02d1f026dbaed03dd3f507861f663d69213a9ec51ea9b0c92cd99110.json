{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Today's activity"
 },
 "description": "Return today's activity for a site, matching the RevenueScope \u4eca\u65e5\u306e\u72b6\u6cc1 screen: sessions, RS-observed revenue, purchase-event count, bot-excluded sessions, new/returning sessions, and reaction tables by channel, generative-AI channel and entry page (top 50) with average duration, bounce rate and pages per session. Today is the site's time zone from 00:00 to now; values are provisional. purchase_events is an observed event count, not confirmed orders. Revenue values are null when purchase measurement is unconfirmed; null means unverified, not zero, and does not prove measurement is unconfigured. A table with status='error' is unavailable, not empty. Items in not_provided are unavailable, never 0. measurement_status='not_started' means the site has never received tracking data: counts are null (unknown), not 0. For sample sites (is_demo=true) the \u4eca\u65e5\u306e\u72b6\u6cc1 screen shows fixed sample data, so these values do not match that screen. No event-level or visitor-level rows are returned. For comparison with yesterday at the same time, use get_summary with period='today'. site_id is optional when OAuth-authenticated.",
 "execution": {
  "taskSupport": "forbidden"
 },
