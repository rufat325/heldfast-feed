{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/commerce.money-parse",
  "agent-utilities/priceMicroUsd": 300
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Normalize up to 50 displayed prices with explicit locale, currency and decimal scale; exact amounts, strict grouping and per-price errors. PAID: 300 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "amounts": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "text": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "id",
        "text"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
     },
     "currency": {
      "enum": [
       "USD",
       "EUR",
       "GBP",
       "CAD",
       "AUD",
       "JPY",
       "INR"
      ],
      "type": "string"
     },
     "locale": {
      "enum": [
       "en-US",
       "en-GB",
       "de-DE",
       "fr-FR",
       "en-IN"
      ],
      "type": "string"
     },
     "minorUnitDigits": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "locale",
     "currency",
     "minorUnitDigits",
     "amounts"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "commerce_money_parse",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "acceptedCurrencyTokens": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "allValid": {
    "type": "boolean"
   },
   "amounts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "type": [
        "string",
        "null"
       ]
      },
      "currencyToken": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "issue": {
       "type": [
        "string",
        "null"
       ]
      },
      "minorUnits": {
       "type": [
        "string",
        "null"
       ]
      },
      "valid": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "valid",
      "amount",
      "minorUnits",
      "currencyToken",
      "issue"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "currency": {
    "type": "string"
   },
   "locale": {
    "type": "string"
   },
   "minorUnitDigits": {
    "type": "number"
   },
   "scope": {
    "type": "string"
   }
  },
  "required": [
   "locale",
   "currency",
   "minorUnitDigits",
   "amounts",
   "allValid",
   "acceptedCurrencyTokens",
   "scope"
  ],
  "type": "object"
 }
}
