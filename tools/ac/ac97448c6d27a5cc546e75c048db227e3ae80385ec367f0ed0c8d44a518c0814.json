{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Request a file import from an Object Storage bucket into a Box NAS (up to 10 files, 2 GB each). Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "boxId": {
    "description": "Box number (see ncloud_datafence_list_boxes)",
    "type": "integer"
   },
   "description": {
    "description": "Description of the import request (1-50 chars)",
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns the request without sending it",
    "type": "boolean"
   },
   "fenceId": {
    "description": "Datafence number (see ncloud_datafence_get_datafence)",
    "type": "integer"
   },
   "sourceBucketName": {
    "description": "Source bucket name",
    "type": "string"
   },
   "sourceFilePathList": {
    "description": "Files to import (bucket object names, up to 10)",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "targetNasInstanceNo": {
    "description": "Target NAS instance number (see ncloud_datafence_list_import_target_nas)",
    "type": "string"
   }
  },
  "required": [
   "fenceId",
   "boxId",
   "sourceBucketName",
   "sourceFilePathList",
   "targetNasInstanceNo",
   "description"
  ],
  "type": "object"
 },
 "name": "ncloud_datafence_create_file_import"
}
