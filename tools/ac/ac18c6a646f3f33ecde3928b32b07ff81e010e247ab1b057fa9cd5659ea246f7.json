{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Paint Calculator"
 },
 "description": "Calculate paint volume and whole containers from entered area or supported surface geometry, openings, whole coats and user-supplied per-coat coverage. (API Tool Calls, by Cowerx)",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "area": "800",
    "coats": 2,
    "containerVolume": "1",
    "coverage": "350",
    "openings": "100"
   }
  ],
  "oneOf": [
   {
    "not": {
     "required": [
      "surfaces"
     ]
    },
    "required": [
     "area"
    ]
   },
   {
    "not": {
     "required": [
      "area"
     ]
    },
    "required": [
     "surfaces"
    ]
   }
  ],
  "properties": {
   "area": {
    "description": "Total gross surface area in selected squared units. Enter a bounded decimal or fraction string; positive except openings/price.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "areaUnit": {
    "description": "Dimensions unit; areas and coverage use its square. Default ft.",
    "enum": [
     "ft",
     "m"
    ],
    "type": "string"
   },
   "coats": {
    "description": "Whole coat count.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "containerVolume": {
    "description": "Entered volume of one container in selected volume units. Enter a bounded decimal or fraction string; positive except openings/price.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "coverage": {
    "description": "Entered per-coat coverage in selected square area units per selected volume unit. Enter a bounded decimal or fraction string; positive except openings/price.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "openings": {
    "description": "Unpainted opening area in the selected squared unit, no greater than gross area. Default 0. Enter a bounded decimal or fraction string; positive except openings/price.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "surfaces": {
    "items": {
     "additionalProperties": false,
     "oneOf": [
      {
       "properties": {
        "shape": {
         "description": "Shape.",
         "enum": [
          "rectangle"
         ],
         "type": "string"
        }
       },
       "required": [
        "length",
        "width"
       ]
      },
      {
       "properties": {
        "shape": {
         "description": "Shape.",
         "enum": [
          "circle"
         ],
         "type": "string"
        }
       },
       "required": [
        "radius"
       ]
      },
      {
       "properties": {
        "shape": {
         "description": "Shape.",
         "enum": [
          "triangle"
         ],
         "type": "string"
        }
       },
       "required": [
        "base",
        "height"
       ]
      },
      {
       "properties": {
        "shape": {
         "description": "Shape.",
         "enum": [
          "l-shape"
         ],
         "type": "string"
        }
       },
       "required": [
        "length",
        "width",
        "cutoutLength",
        "cutoutWidth"
       ]
      }
     ],
     "properties": {
      "base": {
       "description": "Triangle base.",
       "exclusiveMinimum": 0,
       "maximum": 1000000000000.0,
       "type": "number"
      },
      "cutoutLength": {
       "description": "Missing corner length.",
       "exclusiveMinimum": 0,
       "maximum": 1000000000000.0,
       "type": "number"
      },
      "cutoutWidth": {
       "description": "Missing corner width.",
       "exclusiveMinimum": 0,
       "maximum": 1000000000000.0,
       "type": "number"
      },
      "height": {
       "description": "Triangle perpendicular height.",
       "exclusiveMinimum": 0,
       "maximum": 1000000000000.0,
       "type": "number"
      },
      "length": {
       "description": "Outer length.",
       "exclusiveMinimum": 0,
       "maximum": 1000000000000.0,
       "type": "number"
      },
      "radius": {
       "description": "Circle radius.",
       "exclusiveMinimum": 0,
       "maximum": 1000000000000.0,
       "type": "number"
      },
      "shape": {
       "description": "Room shape.",
       "enum": [
        "rectangle",
        "circle",
        "triangle",
        "l-shape"
       ],
       "type": "string"
      },
      "width": {
       "description": "Outer width.",
       "exclusiveMinimum": 0,
       "maximum": 1000000000000.0,
       "type": "number"
      }
     },
     "required": [
      "shape"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "volumeUnit": {
    "description": "Volume unit for paint, coverage denominator and container. Default us_gal.",
    "enum": [
     "us_gal",
     "l"
    ],
    "type": "string"
   }
  },
  "required": [
   "coats",
   "coverage",
   "containerVolume"
  ],
  "type": "object"
 },
 "name": "paint_quantity",
 "outputSchema": {
  "description": "Structured entered quantities, explicit unit labels, calculated results and formula; gross/net area, required volume, whole containers and purchase volume.",
  "type": "object"
 },
 "title": "Paint Calculator"
}
