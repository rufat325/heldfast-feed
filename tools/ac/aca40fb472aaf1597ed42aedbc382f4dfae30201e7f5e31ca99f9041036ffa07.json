 "description": "Audit an OAuth client registration. Reports a wildcard redirect URI, where any matching host receives authorization codes; a plaintext redirect outside loopback; a registered URI that carries its own redirect parameter, so a code can be forwarded off the client's origin while still matching; the implicit and password grants; a public client registering a grant that needs a secret; and a client secret committed into the registration document itself. No secret value is ever reported. Pay 300000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "client": {
    "description": "An OAuth client registration or its equivalent configuration, with at most 100 redirect URIs. Nothing is fetched and no signature is verified, so an arbitrary provider or client can be audited without a credential and without the provider being contacted. Documents are bounded at 262144 bytes.",
    "example": {
     "client_id": "web-dashboard",
     "client_name": "Example Dashboard",
     "client_secret": "redacted-example-value-not-a-real-secret",
     "grant_types": [
      "authorization_code",
      "implicit",
      "client_credentials"
     ],
     "redirect_uris": [
      "https://*.example.com/oauth/callback",
      "http://dashboard.example.com/oauth/callback",
      "https://dashboard.example.com/oauth/callback?returnTo=%2Fhome",
      "https://dashboard.example.com/"
     ],
     "response_types": [
      "code",
      "token"
     ],
     "token_endpoint_auth_method": "none"
    },
    "type": "object"
   }
  },
  "required": [
   "client"
  ],
  "type": "object"
 },
