{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Delete Inbox Message"
 },
 "description": "Permanently delete one inbox message in Trash or Junk. Messages outside those folders cannot be deleted.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Mailbox ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Optional idempotency key. If omitted, the MCP server generates one for POST tools.",
    "pattern": "^[\\x20-\\x7E]{1,255}$",
    "type": "string"
   },
   "message_id": {
    "description": "JMAP inbox message ID.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "message_id"
  ],
  "type": "object"
 },
 "name": "shipmail_delete_inbox_message",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "properties": {
     "id": {
      "type": "string"
     },
     "ok": {
      "const": true,
      "type": "boolean"
     }
    },
    "required": [
     "ok",
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Delete Inbox Message"
}
