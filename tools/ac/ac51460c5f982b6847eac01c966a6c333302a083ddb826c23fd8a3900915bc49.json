{
 "description": "List WordPress users (id, username, email, display_name, first_name, last_name, roles, registered) with role/search filters. Returns { users, total, page }.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "order": {
    "description": "Sort direction (default DESC)",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "orderby": {
    "description": "Order by field (default registered)",
    "enum": [
     "registered",
     "login",
     "nicename",
     "email",
     "url",
     "display_name",
     "name",
     "post_count",
     "id"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Users per page (default 20)",
    "minimum": 1,
    "type": "integer"
   },
   "role": {
    "description": "Filter by role slug (administrator, editor, author, contributor, subscriber, or a custom role)",
    "type": "string"
   },
   "search": {
    "description": "Search login, email, URL, nicename or display name (wildcard on both sides)",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "mcp_list_users"
}
