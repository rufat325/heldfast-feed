{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Discover which keywords drive traffic to a specific Amazon listing (by ASIN). Returns keyword name, search volume, organic rank, sponsored rank, and relevancy score. Useful for competitor keyword gap analysis.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asin": {
    "description": "Amazon ASIN. Example: B07XJ8C8F5",
    "pattern": "^[A-Z0-9]{10}$",
    "type": "string"
   },
   "marketplace": {
    "default": "us",
    "description": "Amazon marketplace code. Defaults to 'us'.",
    "enum": [
     "us",
     "ca",
     "mx",
     "br",
     "uk",
     "de",
     "fr",
     "it",
     "es",
     "nl",
     "pl",
     "se",
     "tr",
     "ae",
     "in",
     "sg",
     "au",
     "jp"
    ],
    "type": "string"
   },
   "page_size": {
    "default": 25,
    "description": "Number of keywords to return (1-100). Defaults to 25.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "asin"
  ],
  "type": "object"
 },
 "name": "keywords_by_asin",
 "title": "Keywords by ASIN"
}
