{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List job download formats"
 },
 "description": "List the files a finished job already has, one per format: the main result plus any alternate formats the model returned (for 3D models, for example glb with fbx or usdz), each with a public download URL. Pass format to find one format. This does not convert: if the format asked for is not there, available_formats says what is, and a model can be exported to other formats from the web app model viewer.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "format": {
    "description": "A file format to look for, e.g. 'glb' or 'stl'.",
    "maxLength": 16,
    "type": "string"
   },
   "job_id": {
    "description": "The job id returned by generate_3d or generate.",
    "maxLength": 191,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "job_id"
  ],
  "type": "object"
 },
 "name": "list_job_files",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "available_formats": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "asset_id": {
       "type": "string"
      },
      "content_type": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "format": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "kind": {
       "description": "primary is the main result; alternate is the same model in another format.",
       "enum": [
        "primary",
        "alternate"
       ],
       "type": "string"
      },
      "size_bytes": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "source": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "description": "Public https download URL.",
       "type": "string"
      }
     },
     "required": [
      "asset_id",
      "kind",
      "format",
      "url",
      "content_type",
      "size_bytes",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "job_id": {
    "type": "string"
   },
   "note": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "requested_format": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "description": "pending and processing are running; success, partial, failed and canceled are final. 'partial' means some outputs finished and the rest were refunded.",
    "enum": [
     "pending",
     "processing",
     "success",
     "partial",
     "failed",
     "canceled"
    ],
    "type": "string"
   }
  },
  "required": [
   "job_id",
   "status",
   "requested_format",
   "available_formats",
   "files",
   "note"
  ],
  "type": "object"
 },
 "title": "List job download formats"
}
