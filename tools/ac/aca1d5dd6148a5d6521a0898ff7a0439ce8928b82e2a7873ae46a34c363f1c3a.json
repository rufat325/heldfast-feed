{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only: compress a TD subtree into a structured digest under max_tokens (default 500). Returns {header, nodeCount, connectionCount, primaryOutput, families{count,topTypes}, outputChain, errors{total,topGroups}, warnings, approxTokens}. Uses getNetworkTopology + getNetworkErrors \u2014 no new bridge work. Cheaper than get_td_topology / snapshot_td_graph for planning turns.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "family_top_types": {
    "default": 3,
    "description": "Per family, list up to N most-frequent operator types. 0 = counts only.",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "include_errors": {
    "default": true,
    "description": "Include top-3 grouped error keys. Off for purely structural turns.",
    "type": "boolean"
   },
   "include_output_chain": {
    "default": true,
    "description": "Walk the primary output TOP upstream up to output_chain_depth.",
    "type": "boolean"
   },
   "max_tokens": {
    "default": 500,
    "description": "Hard ceiling on approximate output tokens (chars/4 heuristic). Default 500.",
    "maximum": 2000,
    "minimum": 100,
    "type": "integer"
   },
   "output_chain_depth": {
    "default": 6,
    "description": "How far upstream to walk from the output TOP. 6 fits typical tails.",
    "maximum": 16,
    "minimum": 0,
    "type": "integer"
   },
   "path": {
    "default": "/project1",
    "description": "TD container/subtree path to digest. Defaults to /project1.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "compact_graph_digest",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approxTokens": {
    "type": "number"
   },
   "cachedAt": {
    "type": "string"
   },
   "connectionCount": {
    "type": "number"
   },
   "errors": {
    "additionalProperties": false,
    "properties": {
     "topGroups": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "count": {
         "type": "number"
        },
        "key": {
         "type": "string"
        }
       },
       "required": [
        "key",
        "count"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "total": {
      "type": "number"
     }
    },
    "required": [
     "total",
     "topGroups"
    ],
    "type": "object"
   },
   "families": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "type": "number"
      },
      "topTypes": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "count": {
          "type": "number"
         },
         "type": {
          "type": "string"
         }
        },
        "required": [
         "type",
         "count"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "count",
      "topTypes"
     ],
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "header": {
    "type": "string"
   },
   "nodeCount": {
    "type": "number"
   },
   "outputChain": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "overBudget": {
    "type": "boolean"
   },
   "path": {
    "type": "string"
   },
   "primaryOutput": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "path": {
        "type": "string"
       },
       "type": {
        "type": "string"
       }
      },
      "required": [
       "path",
       "type"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "path",
   "header",
   "nodeCount",
   "connectionCount",
   "primaryOutput",
   "families",
   "outputChain",
   "errors",
   "warnings",
   "approxTokens",
   "cachedAt"
  ],
  "type": "object"
 },
 "title": "Compact graph digest (token-cheap)"
}
