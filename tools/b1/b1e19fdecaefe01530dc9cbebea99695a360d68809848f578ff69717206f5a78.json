{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create the business card for this account, or update it. Each account has one card. Only the fields you pass are changed on update; pass an empty string to clear an optional text field. displayName is required when creating. The card is live at the returned publicUrl immediately.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiKey": {
    "description": "KadiConnect API key (starts with kc_). Only needed when the MCP connection was not configured with an Authorization header, for example right after calling register.",
    "type": "string"
   },
   "bio": {
    "description": "Short bio or tagline",
    "maxLength": 2000,
    "type": "string"
   },
   "companyLogo": {
    "description": "URL of a company logo",
    "type": "string"
   },
   "companyName": {
    "description": "Company or organisation",
    "maxLength": 200,
    "type": "string"
   },
   "coverImage": {
    "description": "URL of a cover image",
    "type": "string"
   },
   "displayName": {
    "description": "Full name shown on the card (required when creating)",
    "maxLength": 100,
    "type": "string"
   },
   "email": {
    "description": "Public contact email shown on the card",
    "maxLength": 255,
    "type": "string"
   },
   "leadCaptureEnabled": {
    "description": "Show a form on the card so visitors can leave their contact details. Read submissions with get_leads.",
    "type": "boolean"
   },
   "leadCaptureFields": {
    "description": "Fields the lead capture form asks for",
    "items": {
     "enum": [
      "name",
      "email",
      "phone",
      "company",
      "jobTitle",
      "message"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "leadCaptureTitle": {
    "description": "Heading for the lead capture form",
    "maxLength": 200,
    "type": "string"
   },
   "location": {
    "description": "City, country or address",
    "maxLength": 200,
    "type": "string"
   },
   "phone": {
    "description": "Public phone number shown on the card",
    "maxLength": 50,
    "type": "string"
   },
   "profileImage": {
    "description": "URL of a profile image",
    "type": "string"
   },
   "socialLinks": {
    "description": "Social profile links (replaces the existing list)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "platform": {
       "description": "Platform id, e.g. linkedin, x, github, instagram, facebook, tiktok, youtube",
       "type": "string"
      },
      "url": {
       "description": "Full http(s) profile URL",
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "platform",
      "url"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "themeColor": {
    "description": "Theme colour as a 6-digit hex, e.g. #0ea5e9",
    "type": "string"
   },
   "title": {
    "description": "Job title or role",
    "maxLength": 200,
    "type": "string"
   },
   "website": {
    "description": "Website URL (https:// is added if missing)",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_or_update_card",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "card": {
    "additionalProperties": {},
    "type": "object"
   },
   "created": {
    "type": "boolean"
   },
   "notice": {
    "type": "string"
   },
   "plan": {
    "additionalProperties": false,
    "properties": {
     "isPro": {
      "type": "boolean"
     },
     "status": {
      "type": "string"
     },
     "tier": {
      "type": "string"
     },
     "upgradeUrl": {
      "type": "string"
     },
     "viewLimit": {
      "type": [
       "number",
       "null"
      ]
     },
     "views": {
      "type": "number"
     },
     "viewsRemaining": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "tier",
     "status",
     "isPro",
     "views",
     "viewLimit",
     "viewsRemaining",
     "upgradeUrl"
    ],
    "type": "object"
   },
   "publicUrl": {
    "type": "string"
   }
  },
  "required": [
   "card",
   "created",
   "publicUrl",
   "plan"
  ],
  "type": "object"
 },
 "title": "Create or update my business card"
}
