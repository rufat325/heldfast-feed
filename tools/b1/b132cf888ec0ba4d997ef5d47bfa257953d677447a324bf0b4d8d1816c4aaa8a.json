{
 "description": "Submit a quote request (inquiry) for a trip. Only use after the user has clearly asked for a quote and provided their name and email.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "departureDate": {
    "description": "Preferred departure date (YYYY-MM-DD)",
    "type": "string"
   },
   "email": {
    "description": "Contact email address",
    "type": "string"
   },
   "message": {
    "description": "Free-text message (required)",
    "type": "string"
   },
   "name": {
    "description": "Traveller full name",
    "type": "string"
   },
   "phone": {
    "description": "Phone with country code",
    "type": "string"
   },
   "travellers": {
    "description": "Number of adult travellers",
    "type": "number"
   },
   "tripSlug": {
    "description": "Trip slug the quote is about",
    "type": "string"
   }
  },
  "required": [
   "name",
   "email",
   "message"
  ],
  "type": "object"
 },
 "name": "request_quote"
}
