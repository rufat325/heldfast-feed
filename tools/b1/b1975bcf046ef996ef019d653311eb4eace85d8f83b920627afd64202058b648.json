{
 "description": "The completions TypeScript offers at a cursor, including string-literal union members. Use to find valid values for an argument, key, or import before writing it. Returns the top 50.",
 "inputSchema": {
  "properties": {
   "column": {
    "description": "1-based column; the cursor sits before it, e.g. just inside an opening quote",
    "minimum": 1,
    "type": "integer"
   },
   "file": {
    "description": "TS/JS file: absolute, or relative to the server's cwd",
    "type": "string"
   },
   "limit": {
    "description": "Max entries (default 50)",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "line": {
    "description": "1-based line",
    "minimum": 1,
    "type": "integer"
   },
   "prefix": {
    "description": "Name prefix, case-insensitive; default: the text left of the cursor; \"\" lists all",
    "type": "string"
   },
   "project": {
    "description": "tsconfig.json; default: the nearest one above file",
    "type": "string"
   }
  },
  "required": [
   "file",
   "line",
   "column"
  ],
  "type": "object"
 },
 "name": "completions",
 "outputSchema": {
  "properties": {
   "error": {
    "properties": {
     "candidates": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "code": {
      "enum": [
       "INVALID_ARGUMENT",
       "FILE_NOT_FOUND",
       "SYMBOL_NOT_FOUND",
       "TYPESCRIPT_ERROR",
       "INTERNAL_ERROR"
      ]
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "result": {
    "properties": {
     "column": {
      "type": "number"
     },
     "entries": {
      "items": {
       "properties": {
        "insertText": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "sortText": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "kind",
        "sortText"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "file": {
      "type": "string"
     },
     "isGlobalCompletion": {
      "type": "boolean"
     },
     "isMemberCompletion": {
      "type": "boolean"
     },
     "isNewIdentifierLocation": {
      "type": "boolean"
     },
     "line": {
      "type": "number"
     },
     "note": {
      "type": "string"
     },
     "prefix": {
      "type": "string"
     },
     "total": {
      "type": "number"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "file",
     "line",
     "column",
     "isGlobalCompletion",
     "isMemberCompletion",
     "isNewIdentifierLocation",
     "entries",
     "total",
     "truncated"
    ],
    "type": "object"
   },
   "version": {
    "const": 1
   }
  },
  "required": [
   "version",
   "ok"
  ],
  "type": "object"
 }
}
