{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Manage event profile"},"description":"View or change the user's event preferences and privacy: budget, preferred days and times, time zone, interests (artist, team, genre, category, venue, keyword), saved locations (city precision; trips with valid_from/valid_until never replace home), clear personalization, or delete the account and all its data (both need confirm: true and an explicit request from the user).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"action":{"enum":["get","update","add_interest","remove_interest","set_location","delete_location","clear_personalization","delete_account"],"type":"string"},"confirm":{"const":true,"type":"boolean"},"currency":{"anyOf":[{"pattern":"^[A-Za-z]{3}$","type":"string"},{"type":"null"}]},"interest":{"maxLength":200,"minLength":1,"type":"string"},"interest_type":{"enum":["artist","team","genre","category","venue","keyword"],"type":"string"},"location":{"additionalProperties":false,"properties":{"city":{"maxLength":100,"minLength":1,"type":"string"},"country_code":{"pattern":"^[A-Za-z]{2}$","type":"string"},"is_default":{"type":"boolean"},"label":{"pattern":"^[A-Za-z0-9 _-]{1,40}$","type":"string"},"latitude":{"maximum":90,"minimum":-90,"type":"number"},"longitude":{"maximum":180,"minimum":-180,"type":"number"},"radius_km":{"exclusiveMinimum":0,"maximum":300,"type":"number"},"valid_from":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"valid_until":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"}},"required":["label"],"type":"object"},"location_label":{"pattern":"^[A-Za-z0-9 _-]{1,40}$","type":"string"},"max_price":{"anyOf":[{"maximum":100000,"minimum":0,"type":"number"},{"type":"null"}]},"preferred_days":{"items":{"enum":["sunday","monday","tuesday","wednesday","thursday","friday","saturday"],"type":"string"},"maxItems":7,"type":"array"},"preferred_times":{"items":{"enum":["morning","afternoon","evening","night"],"type":"string"},"maxItems":4,"type":"array"},"timezone":{"anyOf":[{"maxLength":60,"type":"string"},{"type":"null"}]},"weight":{"maximum":1,"minimum":0.1,"type":"number"}},"required":["action"],"type":"object"},"name":"manage_event_profile","title":"Manage event profile"}
