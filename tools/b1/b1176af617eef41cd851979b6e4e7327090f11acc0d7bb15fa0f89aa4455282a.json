{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create building"
 },
 "description": "Create a new building. Requires buildings:write scope. latitude and longitude place the building on the map and must be sent together - one without the other is rejected.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "area_sqft": {
    "description": "Area in square feet",
    "minimum": 0,
    "type": "number"
   },
   "building_type_id": {
    "description": "Building type ID (from building_types)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "floors": {
    "description": "Number of floors",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "latitude": {
    "description": "WGS 84 latitude of the building, in decimal degrees. Must be sent together with longitude.",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "description": "WGS 84 longitude of the building, in decimal degrees. Must be sent together with latitude.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "name": {
    "description": "Building name (required)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "site_id": {
    "description": "Site ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "type": {
    "description": "Building type label",
    "maxLength": 100,
    "type": "string"
   },
   "year_built": {
    "description": "Year the building was constructed",
    "maximum": 2100,
    "minimum": 1800,
    "type": "integer"
   }
  },
  "required": [
   "name",
   "site_id"
  ],
  "type": "object"
 },
 "name": "create_building",
 "title": "Create building"
}
