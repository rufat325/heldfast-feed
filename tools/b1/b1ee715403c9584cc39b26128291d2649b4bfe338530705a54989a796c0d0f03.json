{
 "description": "Where high-performing Solana wallets are moving. Scores seed wallets by copy-trade metrics, surfaces tokens they're accumulating, and maps wallet clusters.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_graph": {
    "default": true,
    "description": "Include wallet cluster analysis",
    "type": "boolean"
   },
   "lookback_days": {
    "default": 14,
    "description": "Copy-trade lookback window",
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "min_win_rate": {
    "default": 0.55,
    "description": "Minimum win rate to qualify",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "top_n_tokens": {
    "default": 10,
    "description": "Max accumulated tokens to surface",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "wallets": {
    "description": "Optional wallet addresses to score (curated default used if omitted)",
    "items": {
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "smart_money_flow",
 "title": "Smart Money Flow"
}
