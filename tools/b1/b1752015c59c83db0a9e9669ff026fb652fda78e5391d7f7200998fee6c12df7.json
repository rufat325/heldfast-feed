{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Move an event to a different calendar. Changes the event organizer. Only works for default events (not birthday, focusTime, etc.).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "calendarId": {
    "description": "Source calendar ID",
    "type": "string"
   },
   "destination": {
    "description": "Destination calendar ID",
    "type": "string"
   },
   "eventId": {
    "description": "Event ID to move",
    "type": "string"
   },
   "sendUpdates": {
    "default": "all",
    "description": "Who to send notifications to",
    "enum": [
     "all",
     "externalOnly",
     "none"
    ],
    "type": "string"
   }
  },
  "required": [
   "calendarId",
   "eventId",
   "destination"
  ],
  "type": "object"
 },
 "name": "event_move",
 "title": "Move event"
}
