    "description": "Oscillator or one-shot",
    "enum": [
     "astable",
     "monostable"
    ],
    "type": "string"
   },
   "ra_ohm": {
    "description": "Ra in ohms",
    "exclusiveMinimum": 0,
    "type": "number"
   },
