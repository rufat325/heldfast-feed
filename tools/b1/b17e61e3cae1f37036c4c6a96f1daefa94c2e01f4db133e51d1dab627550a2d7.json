{
 "annotations": {
  "title": "Craft item"
 },
 "description": "Craft an item using the bot's inventory. Uses a crafting table within 4 blocks (or at craftingTablePos) when the recipe requires one. Crafts `count` times (default 1). Cancellable.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "description": "How many times to craft (default 1)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "craftingTablePos": {
    "description": "Position of a crafting table to use; defaults to one within 4 blocks",
    "properties": {
     "x": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "y": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "z": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "x",
     "y",
     "z"
    ],
    "type": "object"
   },
   "item": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    ],
    "description": "Item name (e.g. \"diamond_pickaxe\") or numeric item id"
   }
  },
  "required": [
   "item"
  ],
  "type": "object"
 },
 "name": "craft_item"
}
