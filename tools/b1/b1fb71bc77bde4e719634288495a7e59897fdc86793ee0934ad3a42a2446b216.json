{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Decode a JSON Web Token into its header and payload so you can inspect claims (iss, exp, sub, scopes). The signature is NOT verified and no secret is required or stored. Use to read a token during debugging.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "token": {
    "description": "The JWT (three dot-separated segments).",
    "maxLength": 100000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "token"
  ],
  "type": "object"
 },
 "name": "jwt_decode",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exp_iso": {
    "description": "Expiry as ISO 8601, if present.",
    "type": "string"
   },
   "expired": {
    "description": "Whether the token is past its exp, if present.",
    "type": "boolean"
   },
   "header": {
    "description": "The decoded JWT header object."
   },
   "payload": {
    "description": "The decoded JWT payload (claims)."
   }
  },
  "type": "object"
 },
 "title": "Decode a JWT (no verification)"
}
