 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List board tasks"
 },
 "description": "Use this when the user asks what tasks are open on their Xenition boards \u2014 optionally one board, only theirs, or only overdue ones. Returns each task with its board, column, due date and link.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "board": {
    "description": "optional board name to scope to",
    "type": "string"
   },
   "mine": {
    "description": "only tasks assigned to me",
    "type": "boolean"
   },
   "overdue": {
    "description": "only overdue tasks",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_tasks",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
