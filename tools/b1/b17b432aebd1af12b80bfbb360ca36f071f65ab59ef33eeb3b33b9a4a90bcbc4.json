      },
      "id": {
       "type": "string"
      },
      "lat": {
       "type": [
        "null",
        "number"
       ]
      },
      "lng": {
       "type": [
        "null",
        "number"
       ]
      },
      "meta": {
       "type": "string"
      },
      "openUrl": {
       "type": "string"
      },
      "phone": {
       "type": "string"
      },
      "subtitle": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "website": {
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
