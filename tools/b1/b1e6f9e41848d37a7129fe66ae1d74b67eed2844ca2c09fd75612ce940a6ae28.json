{
 "description": "List the columns of a table/view: name, type, nullable.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "catalog": {
    "description": "Catalog / database name, if the DB uses one",
    "type": "string"
   },
   "datasource": {
    "description": "Datasource name; defaults to DBHAWK_DEFAULT_DATASOURCE",
    "type": "string"
   },
   "object": {
    "description": "Table or view name",
    "type": "string"
   },
   "schema": {
    "description": "Schema name",
    "type": "string"
   }
  },
  "required": [
   "schema",
   "object"
  ],
  "type": "object"
 },
 "name": "list_columns"
}
