{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "openid",
     "email",
     "profile.read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Berlin districts catalog"
 },
 "description": "List supported Berlin districts (Bezirke) and neighbourhoods (Ortsteile) with canonical FlatHunt ids. Returns id, name, slug, type and parent area information, with optional name and type filtering. Mitte exists both as a whole Bezirk (berlin:bezirk:mitte) and as a smaller Ortsteil (berlin:ortsteil:mitte). Charlottenburg is an Ortsteil; the parent Bezirk is Charlottenburg-Wilmersdorf.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "query": {
    "description": "Optional case-insensitive substring filter on area name or slug. Omit to return the full catalog (109 areas).",
    "type": "string"
   },
   "type": {
    "description": "Optional filter by area type.",
    "enum": [
     "bezirk",
     "ortsteil"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_areas",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "areas": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "parentAreaId": {
       "type": [
        "string",
        "null"
       ]
      },
      "parentName": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "type": {
       "enum": [
        "bezirk",
        "ortsteil"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "slug",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "catalogVersion": {
    "type": "string"
   },
   "total": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "areas",
   "total",
   "catalogVersion"
  ],
  "type": "object"
 },
 "title": "List Berlin districts catalog"
}
