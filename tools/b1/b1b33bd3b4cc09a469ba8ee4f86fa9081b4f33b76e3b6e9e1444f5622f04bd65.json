 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get property details"
 },
 "description": "Use this when the user asks for more about one specific home returned by search_properties (floor, condition, construction, ownership, energy class, balcony, lift, parking, price history). Requires the property id from search_properties; do not guess ids. Returns the facts LivinIsto shows on the listing page and its price verdict; it does not return the name, phone or e-mail of the agent or seller, the listing description or the source URL \u2014 for contact the user opens the listing's url. If the listing is no longer in the offer, found is false.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "propertyId": {
    "description": "The id of a property from search_properties results.",
    "maxLength": 40,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "propertyId"
  ],
  "type": "object"
 },
 "name": "get_property_details",
