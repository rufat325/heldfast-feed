{
 "description": "Search for one-way or round-trip flights. Returns prices, airlines, durations, stops, aircraft, emissions, and price context (low/typical/high).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adults": {
    "default": 1,
    "description": "Number of adult passengers",
    "minimum": 1,
    "type": "integer"
   },
   "cabinClass": {
    "default": "economy",
    "description": "Cabin class",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "children": {
    "default": 0,
    "description": "Number of child passengers",
    "minimum": 0,
    "type": "integer"
   },
   "departureDate": {
    "description": "Departure date in YYYY-MM-DD format",
    "type": "string"
   },
   "destination": {
    "description": "Arrival airport IATA code (e.g., NRT)",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "infants": {
    "default": 0,
    "description": "Number of infant passengers",
    "minimum": 0,
    "type": "integer"
   },
   "maxResults": {
    "default": 5,
    "description": "Maximum number of results to return",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "maxStops": {
    "description": "Maximum number of stops (0=nonstop, 1, 2). Omit for any.",
    "maximum": 2,
    "minimum": 0,
    "type": "integer"
   },
   "origin": {
    "description": "Departure airport IATA code (e.g., JFK)",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "returnDate": {
    "description": "Return date in YYYY-MM-DD format (makes it round-trip)",
    "type": "string"
   },
   "sortBy": {
    "default": "best",
    "description": "Sort results by",
    "enum": [
     "best",
     "price",
     "duration",
     "departure",
     "arrival"
    ],
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination",
   "departureDate"
  ],
  "type": "object"
 },
 "name": "search_flights"
}
