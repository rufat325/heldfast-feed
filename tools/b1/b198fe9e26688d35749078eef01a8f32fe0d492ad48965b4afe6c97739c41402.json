{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Search analyzed procedure names using literal matching by default or regex opt-in. Providers bound search work and reject regex constructs, paths, candidates, or cumulative work outside their finite budgets. Results are deterministic and offset-paginated.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "case_sensitive": false,
    "limit": 100,
    "mode": "literal",
    "offset": 0,
    "pattern": "main"
   }
  ],
  "properties": {
   "case_sensitive": {
    "default": false,
    "description": "Whether to match case",
    "type": "boolean"
   },
   "document": {
    "description": "The document name",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Maximum number of results to return in this page.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "default": "literal",
    "description": "Operation mode that selects the requested behavior.",
    "enum": [
     "literal",
     "regex"
    ],
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "Zero-based index of the first result to return.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "pattern": {
    "description": "The literal text or bounded regex pattern to search for",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "unknown_registry_approved": {
    "const": true,
    "description": "Explicit approval to record typed capability unavailability as a residual unknown",
    "type": "boolean"
   }
  },
  "required": [
   "pattern"
  ],
  "type": "object"
 },
 "name": "search_procedures",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "has_more": {
      "type": "boolean"
     },
     "items": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "address": {
         "type": "string"
        },
        "value": {
         "type": "string"
        },
        "value_truncated": {
         "type": "boolean"
        }
       },
       "required": [
        "address",
        "value",
        "value_truncated"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "limit": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     "next_offset": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "offset": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "items",
     "offset",
     "limit",
     "total",
     "next_offset",
     "has_more"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Search Procedures"
}
