{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Apply a bundle to the filesystem (two-phase commit)"
 },
 "description": "Transactionally write the bundle into the root: pre-image verification, staging, journal, atomic renames, scoped rollback on failure. Requires `confirmDigest === bundle.manifestDigest` (echo the digest you saw in dry-run). Idempotent: re-applying an applied digest is a no-op.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "branch": {
    "description": "pr mode: branch name (default axiom/<name>/<digest12>)",
    "type": "string"
   },
   "bundle": {
    "additionalProperties": {},
    "description": "ManifestBundle",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "commitMessage": {
    "description": "pr mode: commit message (passed to git on stdin)",
    "type": "string"
   },
   "confirmDigest": {
    "description": "Must equal bundle.manifestDigest",
    "type": "string"
   },
   "keepBackups": {
    "description": "Pre-image backup sets kept under .axiom/backup after commit (default 3)",
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "lockTimeoutMs": {
    "description": "How long to wait in the root's lock queue (ms); timeout \u2192 ERR_LOCKED with details { holder, waitedMs, queuePosition }",
    "maximum": 600000,
    "minimum": 0,
    "type": "integer"
   },
   "mode": {
    "description": "fs (default) writes files; pr additionally creates a git branch and commits exactly the touched paths (no push, no PR creation)",
    "enum": [
     "fs",
     "pr"
    ],
    "type": "string"
   },
   "profile": {
    "description": "Profile name (builtin default|strict|permissive, or <root>/.axiom/profiles/<name>.json)",
    "type": "string"
   },
   "root": {
    "description": "Absolute repository root; must equal or lie inside an allowlisted --root",
    "type": "string"
   }
  },
  "required": [
   "bundle"
  ],
  "type": "object"
 },
 "name": "axiom_apply",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "apiVersion": {
    "const": "axiom.dev/v2",
    "type": "string"
   },
   "diff": {
    "type": "string"
   },
   "drifted": {
    "items": {
     "description": "Relative POSIX path, NFC, no reserved names",
     "maxLength": 1024,
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "ERR_PATH_NOT_RELATIVE_POSIX",
       "ERR_PATH_SEGMENT",
       "ERR_PATH_NOT_NFC",
       "ERR_PATH_RESERVED_NAME",
       "ERR_PATH_INVALID_CHAR",
       "ERR_PATH_CASE_COLLISION",
       "ERR_SYMLINK_IN_PATH",
       "ERR_CONTAINMENT",
       "ERR_TARGET_TYPE",
       "ERR_EXISTS",
       "ERR_NOT_FOUND",
       "ERR_BLOB_MISSING",
       "ERR_DIGEST_FORMAT",
       "ERR_DIGEST_MISMATCH",
       "ERR_SIZE_MISMATCH",
       "ERR_BLOB_TOO_LARGE",
       "ERR_BUNDLE_TOO_LARGE",
       "ERR_LOCKED",
       "ERR_ROOT_NOT_ALLOWED",
       "ERR_ROOT_REQUIRED",
       "ERR_ROOT_NOT_DIR",
       "ERR_CONFIRM_DIGEST_MISMATCH",
       "ERR_CHECKS_FAILED",
       "ERR_PREIMAGE_CHANGED",
       "ERR_JOURNAL_CORRUPT",
       "ERR_JOURNAL_CHAIN",
       "ERR_EBUSY",
       "ERR_CONFLICT",
       "ERR_INVALID_PLAN",
       "ERR_INVALID_MANIFEST",
       "ERR_INVALID_PROFILE",
       "ERR_PREDICATE_UNKNOWN",
       "ERR_PREDICATE_PARAMS",
       "ERR_PROVIDER_FAILED",
       "ERR_GUARD_TIMEOUT",
       "ERR_GUARD_OUTPUT",
       "ERR_FACT_DISABLED",
       "ERR_SIGNATURE_MISSING",
       "ERR_SIGNATURE_INVALID",
       "ERR_KEYLESS_UNAVAILABLE",
       "ERR_TRUST_STATE_CORRUPT",
       "ERR_ROLLBACK",
       "ERR_EMITTER_UNKNOWN",
       "ERR_TEMPLATE_UNKNOWN",
       "ERR_TEMPLATE_PARAMS",
       "ERR_PATCH_FORMAT",
       "ERR_PATCH_PREIMAGE",
       "ERR_PATCH_NO_MATCH",
       "ERR_GIT_NOT_FOUND",
       "ERR_GIT_NOT_REPO",
       "ERR_GIT_DIRTY",
       "ERR_GIT_BRANCH_EXISTS",
       "ERR_GIT_BRANCH_INVALID",
       "ERR_GIT_FAILED",
       "ERR_TASK_NOT_FOUND",
       "ERR_TASK_CANCELLED",
       "ERR_PLAN_SESSION_STATE",
       "ERR_REF_OFFLINE",
       "ERR_NET_DISABLED",
       "ERR_NET_DENIED",
       "ERR_NET_FAILED",
       "ERR_NOT_CANONICAL",
       "ERR_UNSUPPORTED_OP",
       "ERR_INTERNAL"
      ],
      "type": "string"
     },
     "details": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "message": {
      "type": "string"
     },
     "path": {
      "description": "Relative POSIX path, NFC, no reserved names",
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "digest": {
       "additionalProperties": false,
       "properties": {
        "sha256": {
         "description": "Lowercase hex-encoded sha256",
         "pattern": "^[a-f0-9]{64}$",
         "type": "string"
        }
       },
       "required": [
        "sha256"
       ],
       "type": "object"
      },
      "op": {
       "enum": [
        "create",
        "overwrite",
        "delete"
       ],
       "type": "string"
      },
      "path": {
       "description": "Relative POSIX path, NFC, no reserved names",
       "maxLength": 1024,
       "minLength": 1,
       "type": "string"
      },
      "status": {
       "enum": [
        "written",
        "deleted",
        "unchanged",
        "skipped"
       ],
       "type": "string"
      }
     },
     "required": [
      "path",
      "op",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "git": {
    "additionalProperties": false,
    "properties": {
     "branch": {
      "minLength": 1,
      "type": "string"
     },
     "commit": {
      "pattern": "^[a-f0-9]{40}$",
      "type": "string"
     },
     "compareUrl": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "branch"
    ],
    "type": "object"
   },
   "journal": {
    "type": "string"
   },
   "kind": {
    "const": "ApplyResult",
    "type": "string"
   },
   "manifestDigest": {
    "description": "sha256:<64 lowercase hex>",
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   },
   "mode": {
    "enum": [
     "dry-run",
     "fs",
     "pr"
    ],
    "type": "string"
   },
   "root": {
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "enum": [
     "applied",
     "noop",
     "rolled-back",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "apiVersion",
   "kind",
   "manifestDigest",
   "mode",
   "status",
   "root",
   "files"
  ],
  "type": "object"
 },
 "title": "Apply a bundle to the filesystem (two-phase commit)"
}
