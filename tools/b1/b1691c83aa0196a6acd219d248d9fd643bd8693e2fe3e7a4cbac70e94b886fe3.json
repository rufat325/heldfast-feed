{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Compare Norwegian electricity contracts (str\u00f8mavtaler) for a postcode and yearly usage, and check whether the user's current contract is a good deal ('Er str\u00f8mavtalen min god?'). Returns offers ranked by yearly cost of markup (p\u00e5slag) and monthly fee, with sources and the data date. Each offer says how long the supplier guarantees its markup and whether it can send one bill with the grid fee (nettleie), with the grid companies that applies to. Ranking is by cost only; each offer states whether we earn a commission. Returns the 20 lowest-cost offers plus the recommended one and the user's current one. Needs no personal data. Norway only.","inputSchema":{"properties":{"annual_kwh":{"description":"Yearly electricity use in kWh, from the bill or the grid company's app; a typical house uses 15 000-20 000","title":"Annual Kwh","type":"integer"},"current_contract":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Name of the current contract, e.g. 'Lyse Spotpris'","title":"Current Contract"},"current_markup_ore_kwh":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"description":"as on the bill, incl. VAT","title":"Current Markup Ore Kwh"},"current_monthly_fee_nok":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"description":"as on the bill, incl. VAT","title":"Current Monthly Fee Nok"},"postcode":{"description":"Norwegian 4-digit postcode (postnummer)","title":"Postcode","type":"string"},"price_area":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Price area NO1-NO5, only if the postcode lookup is wrong; it is on the electricity bill","title":"Price Area"}},"required":["postcode","annual_kwh"],"title":"compare_electricity_contractsArguments","type":"object"},"name":"compare_electricity_contracts","outputSchema":{"$defs":{"Coverage":{"properties":{"contracts_in_area"