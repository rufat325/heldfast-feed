{
 "description": "List tasks from Teamleader Focus with optional filtering and pagination",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customer_id": {
    "description": "Customer ID to filter by",
    "type": "string"
   },
   "customer_type": {
    "description": "Customer type to filter by",
    "enum": [
     "contact",
     "company"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (default: 1)",
    "type": "number"
   },
   "page_size": {
    "description": "Page size (default: 20, max: 100)",
    "type": "number"
   },
   "term": {
    "description": "Search term to filter tasks",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "teamleader_list_tasks"
}
