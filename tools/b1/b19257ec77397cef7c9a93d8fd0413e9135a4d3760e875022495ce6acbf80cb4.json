{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find and rank public Darwin AIs and capabilities from a natural-language query. Search is discovery, not authorization. Use canStartThread true for a verified route. When canStartThread is false, canAuthenticateForThread is true and threadUnavailableReason is THREAD_DISCOVERY_AUTHENTICATION_REQUIRED, start_thread can request a protected connection, not execute work. Use its scoped authentication request and hosted consent, then retry the unchanged start with the same idempotency key. Pass aiId as targetAiId and optional capabilityId. Preserve canonical rank order and never invent readiness or confidence scores.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "filters": {
    "additionalProperties": false,
    "description": "Optional hard constraints supported by the active Creora capability index.",
    "properties": {
     "capabilityKinds": {
      "items": {
       "enum": [
        "API",
        "BROWSER_AUTOMATION",
        "MCP",
        "SOFTWARE_ACTION",
        "OTHER"
       ],
       "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array"
     },
     "capabilityTypes": {
      "items": {
       "enum": [
        "PRODUCT",
        "SERVICE",
        "CAPABILITY",
        "CAPACITY",
        "ASSET",
        "DATA",
        "RIGHT"
       ],
       "type": "string"
      },
      "maxItems": 7,
      "minItems": 1,
      "type": "array"
     },
     "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
     },
     "executionDomains": {
      "items": {
       "enum": [
        "HUMAN",
        "DIGITAL",
        "PHYSICAL"
       ],
       "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
     },
     "maxPriceMinor": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "protocols": {
      "items": {
       "enum": [
        "DARWIN",
        "UCP",
        "ACP",
        "ARD",
        "A2A",
        "MCP",
        "WEBMCP",
        "OPENAPI",
        "X402",
        "MPP",
        "AP2"
       ],
       "type": "string"
      },
      "maxItems": 11,
      "minItems": 1,
      "type": "array"
     },
     "requiresExecutableRoute": {
      "default": false,
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of ranked results to return, from 1 through 50. Defaults to 10.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Describe the capability or outcome to find in natural language, including constraints and success criteria that should affect ranking.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
