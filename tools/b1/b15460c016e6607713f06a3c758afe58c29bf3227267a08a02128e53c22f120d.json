 "description": "Decode a VIN. Use this when the user gives a 17-character vehicle identification number or asks to \"decode this VIN\". Returns the model year, make, model, trim, body class, manufacturer, plant country, engine and fuel from NHTSA vPIC, and warns when the VIN's check digit does not match. Follow it with check_vehicle_recalls using the year, make and model to list the vehicle's recalls.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "vin": {
    "description": "The 17-character vehicle identification number (letters and digits, no I, O or Q)",
    "pattern": "^[A-HJ-NPR-Za-hj-npr-z0-9]{17}$",
    "type": "string"
   }
  },
  "required": [
   "vin"
  ],
  "type": "object"
 },
 "name": "decode_vin",
