{
 "annotations": {
  "destructiveHint": true,
  "title": "Add a note"
 },
 "description": "WRITE: add a note to a constituent's record. text and original_date are required; the note type may be given by id or name (e.g. 'General'; see lgl_list_type_values type=note_types). LGL: POST /api/v1/constituents/{constituent_id}/notes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "constituent_id": {
    "description": "Constituent id (integer).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "external_id": {
    "type": "string"
   },
   "note_type_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "note_type_name": {
    "description": "Note type name, e.g. 'General'.",
    "type": "string"
   },
   "original_date": {
    "description": "Date the note refers to (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "text": {
    "description": "Note text.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "constituent_id",
   "text",
   "original_date"
  ],
  "type": "object"
 },
 "name": "lgl_create_note",
 "title": "Add a note"
}
