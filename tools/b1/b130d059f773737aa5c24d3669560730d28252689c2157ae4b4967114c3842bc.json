{
 "annotations": {
  "destructiveHint": true,
  "title": "Update person"
 },
 "description": "Update fields on an existing person. Only provided fields are changed; list-valued fields (emails, phones, groups, companies, etc.) REPLACE the existing values. Folk REST: PATCH /v1/people/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "addresses": {
    "description": "Replace the person's addresses.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "birthday": {
    "description": "Birthday, formatted YYYY-MM-DD.",
    "type": "string"
   },
   "companies": {
    "description": "Replace the person's linked companies (array of {id} or {name}).",
    "items": {
     "anyOf": [
      {
       "properties": {
        "id": {
         "description": "The company id.",
         "type": "string"
        }
       },
       "required": [
        "id"
       ],
       "type": "object"
      },
      {
       "properties": {
        "name": {
         "description": "The company name (creates/links by name).",
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      }
     ],
     "description": "A reference to a company by id or by name."
    },
    "type": "array"
   },
   "customFieldValues": {
    "additionalProperties": {},
    "description": "Custom field values, keyed by field.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "description": {
    "description": "Freeform description / notes.",
    "type": "string"
   },
   "emails": {
    "description": "Replace the person's email addresses.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "firstName": {
    "description": "First name.",
    "type": "string"
   },
   "fullName": {
    "description": "Full name.",
    "type": "string"
   },
   "gender": {
    "description": "Gender \u2014 one of Male, Female, Unknown, Other.",
    "enum": [
     "Male",
     "Female",
     "Unknown",
     "Other"
    ],
    "type": "string"
   },
   "groups": {
    "description": "Replace the person's groups (array of {id}).",
    "items": {
     "description": "A reference to a group by id.",
     "properties": {
      "id": {
       "description": "The group id.",
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "id": {
    "description": "The person id to update.",
    "type": "string"
   },
   "jobTitle": {
    "description": "Job title.",
    "type": "string"
   },
   "lastName": {
    "description": "Last name.",
    "type": "string"
   },
   "phones": {
    "description": "Replace the person's phone numbers.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "urls": {
    "description": "Replace the person's URLs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "folk_update_person",
 "title": "Update person"
}
