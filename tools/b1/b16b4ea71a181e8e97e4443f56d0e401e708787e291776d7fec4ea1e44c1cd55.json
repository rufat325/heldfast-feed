{
 "description": "Search spreadsheet and return matches at cell, row, or column granularity. Use a1-notation prompt for range syntax.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "a1s": {
    "description": "Include A1 notation references in response",
    "type": "boolean"
   },
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "matchCase": {
    "description": "Case-sensitive matching. Default is false (case-insensitive).",
    "type": "boolean"
   },
   "query": {
    "description": "Text to search for in sheet cells. If empty, returns all data at specified granularity.",
    "type": "string"
   },
   "render": {
    "description": "How to render cell values. FORMATTED_VALUE (default): calculated with formatting. UNFORMATTED_VALUE: calculated without formatting. FORMULA: show formula text instead of result.",
    "enum": [
     "FORMATTED_VALUE",
     "UNFORMATTED_VALUE",
     "FORMULA"
    ],
    "type": "string"
   },
   "select": {
    "description": "Granularity: cells (individual matches), rows (full matching rows), columns (columns with matching headers)",
    "enum": [
     "cells",
     "rows",
     "columns"
    ],
    "type": "string"
   },
   "values": {
    "description": "Include cell values in response",
    "type": "boolean"
   }
  },
  "required": [
   "id",
   "gid",
   "select"
  ],
  "type": "object"
 },
 "name": "values-search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "a1s": {
        "description": "A1 notation references for matches (e.g., \"B5\", \"A5:D5\", \"B:B\")",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "count": {
        "description": "Number of matches found",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "type": {
        "const": "success",
        "type": "string"
       },
       "values": {
        "description": "Cell values for matches (arrays for rows/columns, single values for cells)",
        "items": {
         "anyOf": [
          {
           "items": {
            "anyOf": [
             {
              "type": "string"
             },
             {
              "type": "number"
             },
             {
              "const": null,
              "type": "number"
             },
             {
              "const": null,
              "type": "number"
             },
             {
              "type": "boolean"
             },
             {
              "type": "null"
             }
            ]
           },
           "type": "array"
          },
          {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "number"
            },
            {
             "const": null,
             "type": "number"
            },
            {
             "const": null,
             "type": "number"
            },
            {
             "type": "boolean"
            },
            {
             "type": "null"
            }
           ]
          }
         ]
        },
        "type": "array"
       }
      },
      "required": [
       "type",
       "count"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
