{
 "description": "List the user's documents on RenderMark. Supports filtering by publish status, search by title, and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results (default: 20, max: 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "integer"
   },
   "published": {
    "description": "Filter by publish status",
    "type": "boolean"
   },
   "search": {
    "description": "Search by title (fuzzy match)",
    "type": "string"
   },
   "sortBy": {
    "description": "Sort order (default: updated)",
    "enum": [
     "updated",
     "created",
     "title"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_documents"
}
