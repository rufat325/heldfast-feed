{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Rank several CVEs. Use this when the user has a list of CVE ids and wants to know which to deal with first, such as \"which of these CVEs should I patch first?\". Pass up to 10 CVE ids. Returns each one's priority, CVSS score, CISA exploited-list status and EPSS score, most urgent first, with a count per priority. An id NVD could not be asked about in this call is marked deferred; ask for it again later. It does not know which software the user runs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cves": {
    "description": "Up to 10 CVE ids",
    "items": {
     "description": "A CVE id such as \"CVE-2021-44228\"",
     "maxLength": 30,
     "pattern": "^[Cc][Vv][Ee]-[0-9]{4}-[0-9]{4,19}$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "cves"
  ],
  "type": "object"
 },
 "name": "check_cves",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "counts": {
    "properties": {
     "exploited": {
      "type": "integer"
     },
     "likely": {
      "type": "integer"
     },
     "routine": {
      "type": "integer"
     },
     "unknown": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "notice": {
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "as_of": {
       "properties": {
        "epss": {
         "type": [
          "string",
          "null"
         ]
        },
        "nvd": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "cve": {
       "type": "string"
      },
      "cvss": {
       "properties": {
        "score": {
         "type": "number"
        },
        "scored_by": {
         "enum": [
          "NVD",
          "CNA"
         ],
         "type": "string"
        },
        "severity": {
         "type": [
          "string",
          "null"
         ]
        },
        "version": {
         "type": "string"
        }
       },
       "type": [
        "object",
        "null"
       ]
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "epss": {
       "properties": {
        "as_of": {
         "type": "string"
        },
        "percentile": {
         "type": "number"
        },
        "score": {
         "type": "number"
        }
       },
       "type": [
        "object",
        "null"
       ]
      },
      "fix_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "kev": {
       "properties": {
        "added_on": {
         "type": "string"
        },
        "due_date": {
         "type": [
          "string",
          "null"
         ]
        },
        "name": {
         "type": [
          "string",
          "null"
         ]
        },
        "required_action": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": [
        "object",
        "null"
       ]
      },
      "last_modified": {
       "type": [
        "string",
        "null"
       ]
      },
      "message": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "exploited",
        "likely",
        "routine",
        "unknown",
        null
       ],
       "type": [
        "string",
        "null"
       ]
      },
      "published": {
       "type": [
        "string",
        "null"
       ]
      },
      "references": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "retry_after_seconds": {
       "type": "integer"
      },
      "status": {
       "enum": [
        "ok",
        "not_found",
        "rate_limited",
        "unavailable",
        "deferred"
       ],
       "type": "string"
      },
      "vuln_status": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "cve",
      "status",
      "priority",
      "references",
      "as_of"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "type": "string"
   }
  },
  "required": [
   "count",
   "counts",
   "results",
   "source",
   "notice"
  ],
  "type": "object"
 },
 "title": "Rank several CVEs"
}
