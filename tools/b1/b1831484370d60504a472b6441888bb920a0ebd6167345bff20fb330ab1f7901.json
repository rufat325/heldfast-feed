{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use when a user wants to find a US bank account, savings, or credit card signup bonus, or asks which offers are worth opening. Returns matching offers sorted by bonus value, highest first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bonus_type": {
    "description": "Restrict to bank account bonuses, credit card signup bonuses, or savings account bonuses.",
    "enum": [
     "bank_account",
     "credit_card",
     "savings"
    ],
    "type": "string"
   },
   "direct_deposit_required": {
    "description": "Filter on whether the bonus requires a qualifying direct deposit.",
    "type": "boolean"
   },
   "limit": {
    "default": 25,
    "description": "Max results to return.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_bonus_amount_usd": {
    "description": "Minimum bonus value in USD. For credit cards this is the estimated USD value of the points/miles bonus.",
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Keyword matched against bank/issuer and product name, e.g. 'Chase' or 'Sapphire'.",
    "type": "string"
   },
   "state": {
    "description": "2-letter US state code, e.g. 'TX'. Nationwide offers always match; regional offers match only their states.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_bonuses",
