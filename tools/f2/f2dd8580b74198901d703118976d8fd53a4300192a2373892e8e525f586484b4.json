{
 "description": "Check how many of a sitemap's pages are indexed by Google (bounded; respects URL Inspection quota)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "concurrency": {
    "default": 3,
    "description": "Concurrent URL Inspection requests",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "maxUrls": {
    "default": 20,
    "description": "Maximum URLs to inspect",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "siteUrl": {
    "description": "Search Console property containing the sitemap URLs",
    "minLength": 1,
    "type": "string"
   },
   "sitemapUrl": {
    "description": "Fully qualified sitemap URL to inspect",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "siteUrl",
   "sitemapUrl"
  ],
  "type": "object"
 },
 "name": "index_coverage",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checked": {
    "type": "number"
   },
   "childSitemapsSkipped": {
    "type": "number"
   },
   "failed": {
    "type": "number"
   },
   "indexed": {
    "type": "number"
   },
   "notIndexed": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "coverageState": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "coverageState"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "coverageState": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "error": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "indexed": {
       "type": "boolean"
      },
      "lastCrawlTime": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "type": "string"
      },
      "verdict": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "url",
      "coverageState",
      "verdict",
      "indexed",
      "lastCrawlTime",
      "error"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "siteUrl": {
    "type": "string"
   },
   "sitemapUrl": {
    "type": "string"
   },
   "totalDiscovered": {
    "type": "number"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "siteUrl",
   "sitemapUrl",
   "totalDiscovered",
   "checked",
   "indexed",
   "notIndexed",
   "failed",
   "truncated",
   "childSitemapsSkipped",
   "results"
  ],
  "type": "object"
 }
}
