{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search expenses"
 },
 "description": "Search and filter the user's expenses. Returns matching expense rows from their spreadsheet. Filter by category, merchant, date range, amount, or tags. Results are paginated: when hasMore is true, call again with nextCursor and the same filters. Do not split a date range into repeated overlapping searches.\n\nUse the optional query parameter for deterministic natural-language recall over merchant, city/location, Notes (including receipt items, delivery source, payer, and Business purpose), Tag, and category. Each matching result includes matchedFields and a short matchReason so you can explain why it was selected. When several rows plausibly match, a disambiguation list is returned; each option carries the exact expenseId. Structured filters (categories, merchants, dateRange, tags, minAmount, maxAmount) combine with the query using AND semantics. Each result includes expenseId, the exact durable Receipt ID required by update_expense.",
 "inputSchema": {
  "properties": {
   "categories": {
    "description": "Filter by expense categories (e.g., ['Travel', 'Meals'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "clientEmail": {
    "description": "Client account email. Accountants may use this only for an accepted ExpenseBot client.",
    "format": "email",
    "type": "string"
   },
   "cursor": {
    "description": "Opaque nextCursor returned by the previous search_expenses page. Reuse the same filters; never construct or edit this value.",
    "type": "string"
   },
   "dateRange": {
    "description": "Time period filter. Use exactly one variant \u2014 pick the shape that matches the user's phrasing.",
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "month": {
        "description": "Month name or 1-12 (e.g., 'March' or '3')",
        "type": "string"
       },
       "type": {
        "const": "month",
        "type": "string"
       },
       "year": {
        "description": "4-digit year (e.g., 2026)",
        "type": "integer"
       }
      },
      "required": [
       "type",
       "month",
       "year"
      ],
      "title": "Specific month",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "quarter": {
        "maximum": 4,
        "minimum": 1,
        "type": "integer"
       },
       "type": {
        "const": "quarter",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "quarter",
       "year"
      ],
      "title": "Quarter of a year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "year",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "year"
      ],
      "title": "Full year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "end": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "start": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "type": {
        "const": "specific",
        "type": "string"
       }
      },
      "required": [
       "type",
       "start",
       "end"
      ],
      "title": "Specific date range",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "relative",
        "type": "string"
       },
       "value": {
        "description": "Relative range phrase, e.g., 'last month', 'YTD', 'this quarter', 'last 7 days'",
        "type": "string"
       }
      },
      "required": [
       "type",
       "value"
      ],
      "title": "Relative natural-language range",
      "type": "object"
     }
    ]
   },
   "hasReceipt": {
    "description": "When true, return only expenses with a receipt link. When false, return only expenses without one.",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "Results per page (default 20, maximum 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "maxAmount": {
    "description": "Maximum expense amount",
    "type": "number"
   },
   "merchants": {
    "description": "Filter by merchant names (e.g., ['Uber', 'Starbucks'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "minAmount": {
    "description": "Minimum expense amount",
    "type": "number"
   },
   "query": {
    "description": "Optional natural-language recall over the user's existing expense fields (merchant, city/location, Notes including receipt items, delivery source, payer, and Business purpose, Tag, category). Deterministic case-insensitive matching \u2014 no embeddings or model classifiers. Combine with structured filters using AND semantics. Examples: 'Tribeca restaurant', 'Bodewell project hardware store', 'client dinner note'.",
    "type": "string"
   },
   "tags": {
    "description": "Filter by tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "search_expenses",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "description": "Rows matched by the filters.",
    "type": "integer"
   },
   "expenses": {
    "description": "Matching expense rows, newest first, paginated.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "amount": {
       "description": "Functional/home-currency amount.",
       "type": "number"
      },
      "category": {
       "type": "string"
      },
      "currency": {
       "description": "Home currency code when available.",
       "type": "string"
      },
      "date": {
       "type": "string"
      },
      "dateIso": {
       "description": "Canonical YYYY-MM-DD when available.",
       "type": "string"
      },
      "expenseId": {
       "description": "Durable Receipt ID (Column Q). The only identity accepted by update_expense.",
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "matchReason": {
       "type": "string"
      },
      "matchedFields": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "merchant": {
       "type": "string"
      },
      "originalAmount": {
       "type": "number"
      },
      "originalCurrency": {
       "type": "string"
      },
      "tag": {
       "description": "Column K group (client/project/trip).",
       "type": "string"
      },
      "updateEligible": {
       "type": "boolean"
      }
     },
     "required": [
      "expenseId",
      "date",
      "amount",
      "tag",
      "updateEligible"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hasMore": {
    "type": "boolean"
   },
   "message": {
    "type": "string"
   },
   "nextCursor": {
    "description": "Opaque signed continuation; reuse with identical filters.",
    "type": [
     "string",
     "null"
    ]
   },
   "pageInfo": {
    "additionalProperties": true,
    "type": "object"
   },
   "queryApplied": {
    "type": "string"
   },
   "total": {
    "description": "Sum of the matched set in home currency.",
    "type": "number"
   },
   "totalMatched": {
    "description": "Present for free-text searches.",
    "type": "integer"
   }
  },
  "required": [
   "expenses",
   "count",
   "total"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "expenses.read"
   ],
   "type": "oauth2"
  }
 ]
}
