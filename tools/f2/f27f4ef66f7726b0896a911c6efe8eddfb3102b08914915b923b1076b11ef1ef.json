{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Compose a transaction to sweep all assets and/or BTC from one address to another",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Source Bitcoin address",
    "type": "string"
   },
   "destination": {
    "description": "Destination Bitcoin address",
    "type": "string"
   },
   "flags": {
    "default": 7,
    "description": "Bitfield: 1=transfer balances, 2=transfer ownership, 4=transfer BTC",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "inputs_set": {
    "description": "Comma-separated UTXOs to use as inputs (txid:vout)",
    "type": "string"
   },
   "memo": {
    "description": "Optional memo",
    "type": "string"
   },
   "sat_per_vbyte": {
    "description": "Fee rate in satoshis per virtual byte (e.g. 1, 5.5, 0.15). Check get_fee_estimate for current market rates.",
    "minimum": 0.1,
    "type": "number"
   }
  },
  "required": [
   "address",
   "destination"
  ],
  "type": "object"
 },
 "name": "compose_sweep"
}
