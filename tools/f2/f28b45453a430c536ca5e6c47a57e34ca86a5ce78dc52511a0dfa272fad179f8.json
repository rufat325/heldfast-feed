    ],
    "allowed_origins": [],
    "approved": true,
    "inspector_endpoint": "http://127.0.0.1:9229",
    "limits": {
     "max_events": 10000,
     "max_execution_contexts": 1000,
     "max_location_bytes": 16384,
     "max_scripts": 2000,
     "max_total_metadata_bytes": 4194304
