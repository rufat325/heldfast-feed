           "type": "object"
          },
          "type": "array"
         },
         "generatedAt": {
          "type": "string"
         },
         "insights": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "evidence": {
             "type": "string"
            },
            "observation": {
             "type": "string"
            },
            "title": {
             "type": "string"
            }
           },
           "required": [
            "title",
            "observation",
            "evidence"
