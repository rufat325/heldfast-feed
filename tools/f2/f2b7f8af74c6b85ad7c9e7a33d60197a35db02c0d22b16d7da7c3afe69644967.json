          "minimum": 0,
          "type": "integer"
         },
         "symptomEntries": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "symptomEntries",
         "moodEntries",
         "medicationEntries"
        ],
        "type": "object"
       },
       "isPremium": {
        "const": false,
        "type": "boolean"
       },
       "level": {
        "const": "basic",
        "type": "string"
       },
       "premiumInfoUrl": {
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "level",
       "isPremium",
       "premiumInfoUrl",
       "dataCoverage",
       "basicSummary"
