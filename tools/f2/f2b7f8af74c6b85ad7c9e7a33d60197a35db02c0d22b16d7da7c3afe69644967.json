         "medicationEntries": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "moodEntries": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "symptomEntries": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "symptomEntries",
         "moodEntries",
         "medicationEntries"
        ],
        "type": "object"
       },
       "isPremium": {
        "const": true,
        "type": "boolean"
       },
       "level": {
        "const": "full",
        "type": "string"
       },
       "report": {
        "additionalProperties": false,
