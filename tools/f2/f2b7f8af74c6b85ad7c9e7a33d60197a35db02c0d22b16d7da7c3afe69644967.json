  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "days": {
    "default": 30,
    "maximum": 90,
    "minimum": 3,
    "type": "integer"
   },
   "include": {
    "default": [
     "symptom",
     "mood",
     "medication"
    ],
    "items": {
     "enum": [
      "symptom",
      "mood",
      "medication"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "careclinic_get_insights",
