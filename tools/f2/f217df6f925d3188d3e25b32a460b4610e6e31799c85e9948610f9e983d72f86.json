{
 "description": "Get details of a single NFT (token) by contract address and token id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contractAddress": {
    "description": "NFT contract address (0x-prefixed hex).",
    "type": "string"
   },
   "network": {
    "description": "Network to query. Defaults to the server's configured network (mainnet).",
    "enum": [
     "mainnet",
     "sepolia"
    ],
    "type": "string"
   },
   "tokenId": {
    "description": "Token id within the collection.",
    "type": "string"
   }
  },
  "required": [
   "contractAddress",
   "tokenId"
  ],
  "type": "object"
 },
 "name": "get_nft"
}
