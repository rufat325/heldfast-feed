{
 "_meta": {
  "openai/toolInvocation/invoked": "Machine payment step ready.",
  "openai/toolInvocation/invoking": "Preparing machine payment\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a single PDF, letter, workflow-form order, or bulk letter campaign and pay through MPP or x402 after buyer approval. For bulk, provide exactly one of bulk.csv_content or bulk.recipients (JSON address objects with optional merge_fields), plus a shared PDF or text/HTML template. Omit top-level recipient fields and review campaign_url, recipient count and total. Bulk MPP orders can also use postalform.pay_order after fetching its challenge. The unpaid response also includes checkout_url and status_url for this same order. Without an available compatible wallet, give the buyer checkout_url and poll status_url; never recreate the order to change payment paths. Single-recipient clients with a Stripe shared payment token can instead use a draft tool followed by complete_checkout; other clients should present the hosted checkout URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bulk": {
    "additionalProperties": false,
    "description": "Bulk letter campaign: exactly one of csv_content or recipients (JSON list), plus shared PDF or text/HTML template. Omit single-recipient fields, letter, form, and postcard options. color and double_sided apply to every mailpiece.",
    "properties": {
     "campaign_name": {
      "maxLength": 255,
      "type": "string"
     },
     "content_mode": {
      "description": "pdf sends the same top-level PDF to every recipient; text/html render template_text/template_html with CSV columns or JSON merge_fields.",
      "enum": [
       "text",
       "html",
       "pdf"
      ],
      "type": "string"
     },
     "csv_content": {
      "description": "Recipient CSV text, mutually exclusive with recipients. Required columns: line1, city, state, zip. Optional: recipient_name, line2, country. Other columns can be used as merge fields.",
      "minLength": 1,
      "type": "string"
     },
     "recipients": {
      "description": "JSON recipient list, mutually exclusive with csv_content. Each address can include merge_fields for text/HTML templates.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "city": {
         "minLength": 1,
         "type": "string"
        },
        "country": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "description": "Mailing country code. Defaults to US."
        },
        "line1": {
         "minLength": 1,
         "type": "string"
        },
        "line2": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "merge_fields": {
         "additionalProperties": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "number"
           },
           {
            "type": "boolean"
           },
           {
            "type": "null"
           }
          ]
         },
         "description": "Optional template values. {{field_name}} inserts a value as plain text (HTML-escaped in html mode); in html mode, {{{field_name}}} inserts it as HTML. Address field names and full_address are reserved.",
         "propertyNames": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
         },
         "type": "object"
        },
        "recipient_name": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "state": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "description": "Required for US and Canadian recipients. Omit or send null elsewhere."
        },
        "zip": {
         "description": "ZIP/postal code as a string, preserving leading zeros.",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "line1",
        "city",
        "zip"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "template_html": {
      "description": "HTML letter template. {{field}} inserts a merge value as escaped text; {{{field}}} inserts it as HTML (use this for per-recipient HTML bodies). Scripts and remote resources are not loaded; embed images as data: URLs.",
      "type": "string"
     },
     "template_text": {
      "description": "Plain-text letter template. {{field}} inserts a merge value; HTML is not allowed.",
      "type": "string"
     }
    },
    "required": [
     "content_mode"
    ],
    "type": "object"
   },
   "buyer_email": {
    "description": "Buyer email for receipts.",
    "format": "email",
    "maxLength": 256,
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "buyer_name": {
    "description": "Buyer name for receipts.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "certified": {
    "type": "boolean"
   },
   "certified_return_receipt": {
    "type": "boolean"
   },
   "color": {
    "type": "boolean"
   },
   "double_sided": {
    "type": "boolean"
   },
   "file_name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "form": {
    "description": "Workflow form payload from postalform.get_form_schema. Provide exactly one of pdf, letter, or form.",
    "properties": {
     "attachments": {
      "items": {
       "properties": {
        "base64": {
         "minLength": 1,
         "type": "string"
        },
        "content_type": {
         "minLength": 1,
         "type": "string"
        },
        "file_name": {
         "maxLength": 255,
         "minLength": 1,
         "type": "string"
        },
        "id": {
         "minLength": 1,
         "type": "string"
        },
        "label": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "id",
        "base64"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "fields": {
      "additionalProperties": {},
      "default": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "slug": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "slug"
    ],
    "type": "object"
   },
   "letter": {
    "description": "Letter text to render and mail. Provide exactly one of pdf, letter, or form. Optional format may be text, html, markdown, or rtf; default is text. Optional signature may be a typed string or drawn signature payload.",
    "properties": {
     "body": {
      "maxLength": 20000,
      "minLength": 1,
      "type": "string"
     },
     "format": {
      "enum": [
       "text",
       "html",
       "markdown",
       "rtf"
      ],
      "type": "string"
     },
     "render": {
      "properties": {
       "font": {
        "enum": [
         "times",
         "helvetica"
        ],
        "type": "string"
       },
       "font_size": {
        "maximum": 14,
        "minimum": 9,
        "type": "integer"
       },
       "margin_in": {
        "maximum": 1.5,
        "minimum": 0.5,
        "type": "number"
       },
       "paper": {
        "const": "letter",
        "type": "string"
       }
      },
      "type": "object"
     },
     "signature": {
      "anyOf": [
       {
        "maxLength": 2000,
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "dataUrl": {
          "type": "string"
         },
         "mode": {
          "enum": [
           "typed",
           "drawn"
          ],
          "type": "string"
         },
         "printDataUrl": {
          "type": "string"
         },
         "text": {
          "maxLength": 2000,
          "type": "string"
         }
        },
        "type": "object"
       }
      ]
     },
     "title": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "required": [
     "body"
    ],
    "type": "object"
   },
   "mail_class": {
    "enum": [
     "standard",
     "priority",
     "express"
    ],
    "type": "string"
   },
   "mailpiece_type": {
    "enum": [
     "letter",
     "postcard"
    ],
    "type": "string"
   },
   "payment_authorization": {
    "description": "MPP retry value after paying with Link CLI/Link MCP. Pass the full Authorization header value, usually \"Payment ...\".",
    "minLength": 1,
    "type": "string"
   },
   "payment_protocol": {
    "description": "Direct machine payment protocol. Use mpp for Link CLI/Link MCP or Stripe SPT; use x402 for x402 wallet clients. Defaults to mpp.",
    "enum": [
     "mpp",
     "x402"
    ],
    "type": "string"
   },
   "payment_signature": {
    "description": "x402 retry value after paying the PAYMENT-REQUIRED challenge.",
    "minLength": 1,
    "type": "string"
   },
   "pdf": {
    "anyOf": [
     {
      "properties": {
       "download_url": {
        "format": "uri",
        "type": "string"
       },
       "file_id": {
        "type": "string"
       }
      },
      "required": [
       "download_url",
       "file_id"
      ],
      "type": "object"
     },
     {
      "properties": {
       "upload_token": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "upload_token"
      ],
      "type": "object"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Existing PDF to mail. For a single recipient, provide exactly one of pdf, letter, or form. For bulk.content_mode=pdf, this PDF is sent to every CSV or JSON recipient. Prefer upload_token from postalform.create_pdf_upload."
   },
   "postcard_size": {
    "enum": [
     "4x6",
     "6x9",
     "11x6"
    ],
    "type": "string"
   },
   "recipient_address_id": {
    "minLength": 1,
    "type": "string"
   },
   "recipient_address_manual": {
    "properties": {
     "city": {
      "minLength": 1,
      "type": "string"
     },
     "country": {
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "countryCode": {
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "line1": {
      "minLength": 1,
      "type": "string"
     },
     "line2": {
      "minLength": 1,
      "type": "string"
     },
     "state": {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "zip": {
      "maxLength": 20,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "line1",
     "line2",
     "city",
     "zip"
    ],
    "type": "object"
   },
   "recipient_address_text": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "recipient_address_type": {
    "enum": [
     "Address",
     "Manual"
    ],
    "type": "string"
   },
   "recipient_name": {
    "description": "Required for a single recipient. Omit when bulk supplies the recipient list.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "request_id": {
    "description": "Idempotency key. Reuse the same value and same order fields after a payment challenge.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "sender_address_id": {
    "minLength": 1,
    "type": "string"
   },
   "sender_address_manual": {
    "properties": {
     "city": {
      "minLength": 1,
      "type": "string"
     },
     "country": {
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "countryCode": {
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "line1": {
      "minLength": 1,
      "type": "string"
     },
     "line2": {
      "minLength": 1,
      "type": "string"
     },
     "state": {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "zip": {
      "maxLength": 20,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "line1",
     "line2",
     "city",
     "zip"
    ],
    "type": "object"
   },
   "sender_address_text": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "sender_address_type": {
    "enum": [
     "Address",
     "Manual"
    ],
    "type": "string"
   },
   "sender_name": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "signature_required": {
    "type": "boolean"
   }
  },
  "required": [
   "buyer_name",
   "buyer_email",
   "sender_name"
  ],
  "type": "object"
 },
 "name": "postalform.create_machine_order",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bulk": {
    "additionalProperties": false,
    "properties": {
     "campaign_id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "content_mode": {
      "enum": [
       "text",
       "html",
       "pdf"
      ],
      "type": "string"
     },
     "recipient_count": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "status": {
      "type": "string"
     },
     "status_counts": {
      "additionalProperties": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "required": [
     "campaign_id",
     "recipient_count",
     "content_mode",
     "status",
     "status_counts"
    ],
    "type": "object"
   },
   "campaign_url": {
    "format": "uri",
    "type": "string"
   },
   "checkout_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "currency": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "endpoint": {
    "format": "uri",
    "type": "string"
   },
   "is_paid": {
    "type": "boolean"
   },
   "mailpiece_type": {
    "enum": [
     "letter",
     "postcard"
    ],
    "type": "string"
   },
   "next_action": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "order_complete_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "order_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "page_count": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "payment": {},
   "payment_options": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "type": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "payment_status": {
    "type": "string"
   },
   "postcard_size": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "preview_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "price_usd": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "protocol": {
    "enum": [
     "mpp",
     "x402"
    ],
    "type": "string"
   },
   "request_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "status_url": {
    "format": "uri",
    "type": "string"
   },
   "view": {
    "const": "machine_order",
    "type": "string"
   }
  },
  "required": [
   "view",
   "protocol",
   "order_id",
   "request_id",
   "endpoint",
   "status",
   "payment_status",
   "is_paid",
   "price_usd",
   "currency",
   "mailpiece_type",
   "postcard_size",
   "order_complete_url"
  ],
  "type": "object"
 },
 "title": "Create or pay a machine order"
}
