{
 "description": "Create a new collection. Optionally include field definitions to create the collection with its full schema in a single request.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "fields": {
    "description": "Array of field definitions to create with the collection",
    "items": {
     "properties": {
      "children": {
       "description": "Child fields (only for group type)",
       "items": {
        "properties": {
         "description": {
          "type": "string"
         },
         "label": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "options": {
          "additionalProperties": {},
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         },
         "placeholder": {
          "type": "string"
         },
         "type": {
          "type": "string"
         },
         "validations": {
          "additionalProperties": {},
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         }
        },
        "required": [
         "type",
         "label",
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "description": {
       "description": "Field description",
       "type": "string"
      },
      "label": {
       "description": "Display label",
       "type": "string"
      },
      "name": {
       "description": "Field identifier in kebab-case",
       "type": "string"
      },
      "options": {
       "additionalProperties": {},
       "description": "Field-specific options (e.g. { repeatable: true } for group fields)",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "placeholder": {
       "description": "Placeholder text",
       "type": "string"
      },
      "type": {
       "description": "Field type: text, number, richtext, boolean, date, media, relation, select, longtext, group, etc.",
       "type": "string"
      },
      "validations": {
       "additionalProperties": {},
       "description": "Validation rules (e.g. { required: { status: true, message: 'Required' } })",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "type",
      "label",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "is_singleton": {
    "description": "If true, collection can only have one entry",
    "type": "boolean"
   },
   "name": {
    "description": "Display name (max 60 chars)",
    "type": "string"
   },
   "slug": {
    "description": "URL-friendly identifier, kebab-case (max 60 chars)",
    "type": "string"
   }
  },
  "required": [
   "name",
   "slug"
  ],
  "type": "object"
 },
 "name": "create_collection",
 "title": "Create Collection"
}
