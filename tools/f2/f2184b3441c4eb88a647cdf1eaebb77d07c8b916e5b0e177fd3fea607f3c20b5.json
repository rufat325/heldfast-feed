       "unknown"
      ],
      "type": "string"
     },
     "chemical_or_hazmat": {
      "enum": [
       "yes",
       "no",
       "unknown"
      ],
      "type": "string"
     },
     "childrens_product": {
      "enum": [
       "yes",
       "no",
       "unknown"
      ],
      "type": "string"
     },
     "cosmetic": {
      "enum": [
