       "unknown"
      ],
      "type": "string"
     },
     "counterfeit_or_unlicensed_replica": {
      "enum": [
       "yes",
       "no",
       "unknown"
      ],
      "type": "string"
     },
     "drug_or_medical_device": {
      "enum": [
       "yes",
       "no",
       "unknown"
      ],
      "type": "string"
     },
     "food_or_supplement": {
