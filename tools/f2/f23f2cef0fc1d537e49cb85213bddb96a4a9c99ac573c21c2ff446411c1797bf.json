{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Labels for notable Hyperliquid wallets: top whales by 24h volume, top traders by 30-day realized PnL, vaults and vault leaders. Pass addresses to check specific wallets; without them it lists the whales and smart money.",
 "inputSchema": {
  "properties": {
   "addresses": {
    "description": "Comma-separated wallet addresses to look up",
    "type": "string"
   },
   "smart_top_n": {
    "description": "Top N smart-money wallets to include (max 500, default 100)",
    "type": "number"
   },
   "whale_top_n": {
    "description": "Top N whales to include (max 500, default 100)",
    "type": "number"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_wallet_labels",
 "outputSchema": {
  "description": "Labels for notable wallets",
  "properties": {
   "counts": {
    "description": "Wallets per label kind"
   },
   "generated_at": {
    "description": "Unix milliseconds"
   },
   "labels": {
    "additionalProperties": {
     "description": "Labels",
     "items": {
      "description": "One label",
      "properties": {
       "kind": {
        "description": "whale, smart_money, vault or vault_leader"
       },
       "name": {
        "description": "Display label"
       },
       "rank": {
        "description": "Rank"
       }
      },
      "type": "object"
     },
     "type": "array"
    },
    "description": "Address to its labels",
    "type": "object"
   },
   "note": {
    "description": "What the labels map includes"
   },
   "source": {
    "description": "Venue, always hyperliquid"
   },
   "ttl_seconds": {
    "description": "Cache lifetime"
   }
  },
  "type": "object"
 }
}
