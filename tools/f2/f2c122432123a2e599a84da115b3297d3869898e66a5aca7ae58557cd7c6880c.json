{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Bundle nearby locations, credited groups, preservation and native-dimension highways. For only nearby locations use find_locations_near; for one named place use research_location. Use research_nocom_area for recorded NoCom storage, signs and portals. Example: {\"location_name\":\"Block Game Jerusalem\",\"radius\":25000,\"preserved_only\":true}. Prefer interactiveUrl for human links; recordUrl for identity, provenance and semantic retrieval (location-prefixed on derivatives).",
 "inputSchema": {
  "properties": {
   "dimension": {
    "default": null,
    "description": "0 Overworld, 1 Nether, 2 End. Inferred for a named location; defaults to Overworld for coordinates.",
    "type": [
     "integer",
     "null"
    ]
   },
   "group": {
    "default": null,
    "description": "Optional group name or alias for locations.",
    "type": [
     "string",
     "null"
    ]
   },
   "limit": {
    "default": 20,
    "description": "Maximum locations, 1\u2013100.",
    "type": "integer"
   },
   "location_id": {
    "default": null,
    "description": "Atlas location ID as the origin; do not combine with x/z or name.",
    "type": [
     "integer",
     "null"
    ]
   },
   "location_name": {
    "default": null,
    "description": "Exact location name, case-insensitive. Ambiguous names require an ID.",
    "type": [
     "string",
     "null"
    ]
   },
   "preserved_only": {
    "default": false,
    "description": "Require both a public render and downloadable WDL.",
    "type": "boolean"
   },
   "radius": {
    "default": 10000,
    "description": "Native-dimension radius, 1\u201330,000,000 blocks.",
    "type": "integer"
   },
   "x": {
    "default": null,
    "description": "Native X coordinate; provide x/z OR location_id OR exact location_name.",
    "type": [
     "integer",
     "null"
    ]
   },
   "z": {
    "default": null,
    "description": "Native Z coordinate, paired with x.",
    "type": [
     "integer",
     "null"
    ]
   }
  },
  "type": "object"
 },
