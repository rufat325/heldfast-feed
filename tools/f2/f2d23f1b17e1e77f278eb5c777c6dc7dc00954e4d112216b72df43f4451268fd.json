{
 "description": "Ask a question for the active session. Detect user language and pass language (zh-CN/en-US/ja-JP).",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "language": {
    "description": "User language for localized response, e.g. zh-CN/en-US/ja-JP",
    "maxLength": 16,
    "minLength": 2,
    "type": "string"
   },
   "question": {
    "description": "Detective question to judge",
    "minLength": 1,
    "type": "string"
   },
   "session_id": {
    "description": "Session ID returned by start_session",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "question"
  ],
  "type": "object"
 },
 "name": "ask_question"
}
