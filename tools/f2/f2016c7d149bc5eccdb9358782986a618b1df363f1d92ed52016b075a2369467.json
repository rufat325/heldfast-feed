{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/html.metadata",
  "agent-utilities/priceMicroUsd": 300
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Extract title, description, canonical URL, language and social metadata from supplied HTML. PAID: 300 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "baseUrl": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
     },
     "html": {
      "maxLength": 100000,
      "type": "string"
     }
    },
    "required": [
     "html"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "html_metadata",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "canonicalUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "description": {
    "type": "string"
   },
   "language": {
    "type": "string"
   },
   "robots": {
    "type": "string"
   },
   "social": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "title",
   "description",
   "language",
   "canonicalUrl",
   "robots",
   "social"
  ],
  "type": "object"
 }
}
