{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a calendar event"
 },
 "description": "Create an event on a calendar, optionally repeating. Times are 24-hour GMT. Use status \"draft\" to stage it unpublished. Elvanto: calendar/events/create.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "all_day": {
    "description": "All-day event? Default no.",
    "enum": [
     "yes",
     "no"
    ],
    "type": "string"
   },
   "calendar_id": {
    "description": "Calendar id (see elvanto_list_calendars).",
    "minLength": 1,
    "type": "string"
   },
   "color": {
    "description": "Hex color, e.g. #FF0000.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "description": {
    "description": "Description (basic HTML allowed).",
    "type": "string"
   },
   "end": {
    "description": "End, yyyy-mm-dd hh:mm:ss (24h, GMT).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
    "type": "string"
   },
   "locations": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    ],
    "description": "Location(s) to add to the event."
   },
   "name": {
    "description": "Event name.",
    "minLength": 1,
    "type": "string"
   },
   "organizer": {
    "description": "Person id of the organizer.",
    "minLength": 1,
    "type": "string"
   },
   "register_url": {
    "description": "Registration website URL.",
    "format": "uri",
    "type": "string"
   },
   "repeat": {
    "description": "Make it a repeating event.",
    "enum": [
     "daily",
     "weekdays",
     "mon_wed_fri",
     "tue_thu",
     "weekly",
     "fortnightly",
     "monthly",
     "yearly"
    ],
    "type": "string"
   },
   "repeat_end_date": {
    "description": "Stop repeating at, yyyy-mm-dd hh:mm:ss (GMT).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
    "type": "string"
   },
   "repeat_frequency": {
    "description": "How often to repeat. Required for daily, monthly, yearly.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "repeat_occurrences": {
    "description": "Number of repeats.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "repeat_on": {
    "description": "Weekly/fortnightly: monday..sunday. Monthly: weekday or monthday.",
    "type": "string"
   },
   "show_guest_list": {
    "description": "Show the guest list on the event page? Default no.",
    "enum": [
     "yes",
     "no"
    ],
    "type": "string"
   },
   "start": {
    "description": "Start, yyyy-mm-dd hh:mm:ss (24h, GMT).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
    "type": "string"
   },
   "status": {
    "description": "Visibility. Default public.",
    "enum": [
     "public",
     "private",
     "draft"
    ],
    "type": "string"
   },
   "where": {
    "description": "Where the event is held.",
    "type": "string"
   },
   "who_can_attend": {
    "description": "\"all\" to let anyone attend; omit for invite-only.",
    "type": "string"
   }
  },
  "required": [
   "name",
   "calendar_id",
   "start",
   "end",
   "organizer"
  ],
  "type": "object"
 },
 "name": "elvanto_create_calendar_event",
 "title": "Create a calendar event"
}
