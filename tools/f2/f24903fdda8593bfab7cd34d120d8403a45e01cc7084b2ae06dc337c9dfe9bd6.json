      "reason": "fraud",
      "schema_version": "2",
      "stream": "orders-1",
      "type": "order.cancelled"
     }
    ],
    "items": {
     "type": "object"
    },
    "maxItems": 2000,
    "minItems": 1,
    "type": "array"
   },
   "id_field": {
    "description": "The event id or idempotency key. Either a bare property name or an RFC 6901 JSON Pointer, since callers write both.",
    "example": "event_id",
    "maxLength": 256,
    "type": "string"
   },
   "ignore_pointers": {
    "description": "Pointers to exclude when comparing two payloads under one id, such as a delivery timestamp or an offset.",
    "example": [
     "/offset"
    ],
    "items": {
     "maxLength": 512,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "events",
   "id_field"
  ],
  "type": "object"
 },
