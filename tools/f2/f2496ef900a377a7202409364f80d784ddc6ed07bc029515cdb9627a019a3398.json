{
 "description": "Apply the espresso-quality scoring algorithm to a set of observed signals (no database lookup required). Returns a 0-100 score, tier, per-signal contributions, and reasoning. Use this when you've gathered information about a cafe from a website, photo, or review and want a structured assessment.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Optional cafe name (used in reasoning and roaster lookup).",
    "type": "string"
   },
   "observed_signals": {
    "additionalProperties": false,
    "description": "Signals observed about the cafe. Omit fields you don't know \u2014 unknowns are skipped, not penalized.",
    "properties": {
     "brew_methods": {
      "description": "e.g. ['espresso','filter','pour-over']",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "competition_involvement": {
      "type": "boolean"
     },
     "cortado_on_menu": {
      "type": "boolean"
     },
     "espresso_machine": {
      "description": "Free-form (e.g. 'Slayer', 'La Marzocco Linea PB'). Quality brands earn a bonus.",
      "type": "string"
     },
     "flavored_drink_share": {
      "description": "0..1 share of menu that is flavored. Continuous variant of syrup_emphasis.",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "grinder": {
      "type": "string"
     },
     "no_grinder_visible": {
      "description": "Effectively disqualifying.",
      "type": "boolean"
     },
     "no_origin_info": {
      "type": "boolean"
     },
     "only_dark_roast": {
      "type": "boolean"
     },
     "origin_transparency": {
      "enum": [
       "farm-level",
       "region-level",
       "country-only",
       "none"
      ],
      "type": "string"
     },
     "roast_date_on_bags": {
      "type": "boolean"
     },
     "roaster_names": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "roasting": {
      "enum": [
       "in-house",
       "named-partner",
       "unknown"
      ],
      "type": "string"
     },
     "sca_certified_staff": {
      "type": "boolean"
     },
     "signature_drinks": {
      "type": "boolean"
     },
     "single_origin_espresso": {
      "type": "boolean"
     },
     "small_focused_menu": {
      "type": "boolean"
     },
     "syrup_emphasis": {
      "description": "True if menu is dominated by flavored-syrup drinks. STRONGEST negative signal.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "source_rankings": {
    "description": "Awards / rankings the cafe appears in.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "rank": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "source": {
       "description": "e.g. 'worlds-100-best-2026', 'sca-world-barista-championship'",
       "type": "string"
      }
     },
     "required": [
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "observed_signals"
  ],
  "type": "object"
 },
 "name": "score_cafe",
 "title": "Score a Cafe by Observed Signals"
}
