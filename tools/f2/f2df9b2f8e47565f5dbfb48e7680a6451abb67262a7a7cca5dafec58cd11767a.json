{
 "description": "Return one compact, bounded source bundle for an exact symbol: definition, production-first inbound/outbound containers, exact re-export sites, on-demand TS/JS reference evidence and diverse excerpts around call sites. Use before an edit when query_graph would be too broad.",
 "inputSchema": {
  "properties": {
   "context_lines": {
    "default": 4,
    "maximum": 12,
    "minimum": 0,
    "type": "integer"
   },
   "include_classified": {
    "default": false,
    "description": "Include test/e2e/generated/vendored/mock/story/docs/benchmark/temp callers after production callers",
    "type": "boolean"
   },
   "label": {
    "description": "Exact node ID or unambiguous symbol label",
    "type": "string"
   },
   "max_reexports": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "max_references": {
    "default": 1000,
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "max_related": {
    "default": 10,
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "max_source_files": {
    "default": 4,
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "output_format": {
    "default": "text",
    "description": "text returns only the concise TextContent summary; json also returns and mirrors the stable structuredContent envelope",
    "enum": [
     "text",
     "json"
    ],
    "type": "string"
   },
   "precision": {
    "default": "auto",
    "enum": [
     "auto",
     "graph",
     "lsp"
    ],
    "type": "string"
   },
   "timeout_ms": {
    "default": 30000,
    "maximum": 60000,
    "minimum": 1000,
    "type": "integer"
   }
  },
  "required": [
   "label"
  ],
  "type": "object"
 },
 "name": "context_bundle"
}
