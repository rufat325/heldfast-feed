{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "reviews:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Retrieve categorical document-review status, review priority, confidence and fraud/AI indicator counts for one recoverable review from the connected purchase. Provides signals for human follow-up without source documents, personal fields or free-text excerpts. This does not prove fraud, authenticity, intent, identity or AI generation. No new credit is spent.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "review_id": {
    "pattern": "^ent_[a-f0-9]{32}(?:c[0-9]{2,3})?$",
    "type": "string"
   }
  },
  "required": [
   "review_id"
  ],
  "type": "object"
 },
 "name": "get_review_summary",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "aiGenerationAssessment": {
    "enum": [
     "no_supported_indicators",
     "indicators_present",
     "unable_to_determine"
    ],
    "type": "string"
   },
   "aiGenerationIndicatorCount": {
    "minimum": 0,
    "type": "integer"
   },
   "confidence": {
    "enum": [
     "low",
     "medium",
     "high",
     "unable_to_determine"
    ],
    "type": "string"
   },
   "disclaimer": {
    "const": "This review identifies document-level signals for human follow-up. It does not prove fraud, authenticity, intent, identity, account ownership, or AI generation.",
    "type": "string"
   },
   "fraudAssessment": {
    "enum": [
     "no_supported_indicators",
     "indicators_present",
     "unable_to_determine"
    ],
    "type": "string"
   },
   "fraudIndicatorCount": {
    "minimum": 0,
    "type": "integer"
   },
   "limitationCount": {
    "minimum": 0,
    "type": "integer"
   },
   "reviewPriority": {
    "enum": [
     "low",
     "moderate",
     "high",
     "unable_to_determine"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "completed",
     "unable_to_determine",
     "refused"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "reviewPriority",
   "confidence",
   "fraudAssessment",
   "aiGenerationAssessment",
   "fraudIndicatorCount",
   "aiGenerationIndicatorCount",
   "limitationCount",
   "disclaimer"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "reviews:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Read an Ocolta review summary"
}
