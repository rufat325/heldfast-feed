{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Scan npm package"
 },
 "description": "Resolve, verify, and inspect one public npm registry package without executing package code. Use before installing, recommending, or running an unfamiliar package. Obey decision.action: continue, review, stop, or retry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "ai": {
    "default": "off",
    "description": "Optional AI review mode. Heuristic-only scanning is the default.",
    "enum": [
     "off",
     "auto",
     "online",
     "ollama"
    ],
    "type": "string"
   },
   "model": {
    "description": "Provider model identifier. Required when ai is not off, because no model catalog is bundled.",
    "minLength": 1,
    "type": "string"
   },
   "package": {
    "description": "npm package spec such as esbuild, @scope/tool, or package@version.",
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "default": "auto",
    "description": "AI provider. Credentials are read from environment variables, never tool arguments.",
    "enum": [
     "auto",
     "openai",
     "anthropic",
     "gemini",
     "openrouter",
     "groq",
     "together",
     "custom"
    ],
    "type": "string"
   }
  },
  "required": [
   "package"
  ],
  "type": "object"
 },
 "name": "scan_package",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "decision": {
    "properties": {
     "action": {
      "enum": [
       "continue",
       "review",
       "stop",
       "retry"
      ],
      "type": "string"
     },
     "blocked": {
      "type": "boolean"
     },
     "exitCode": {
      "type": "integer"
     },
     "mayContinue": {
      "type": "boolean"
     },
     "mustStop": {
      "type": "boolean"
     },
     "requiresApproval": {
      "type": "boolean"
     },
     "requiresHumanReview": {
      "type": "boolean"
     },
     "riskScore": {
      "type": [
       "number",
       "null"
      ]
     },
     "safeToExecute": {
      "type": "boolean"
     },
     "verdict": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "verdict",
     "riskScore",
     "action",
     "exitCode",
     "mayContinue",
     "safeToExecute",
     "requiresApproval",
     "requiresHumanReview",
     "blocked",
     "mustStop"
    ],
    "type": "object"
   },
   "error": {
    "type": "object"
   },
   "kind": {
    "enum": [
     "package-scan",
     "project-scan",
     "script-approvals",
     "error"
    ],
    "type": "string"
   },
   "report": {
    "type": "object"
   },
   "schemaVersion": {
    "const": 2,
    "type": "integer"
   },
   "status": {
    "enum": [
     "complete",
     "incomplete",
     "error"
    ],
    "type": "string"
   },
   "subject": {
    "type": "object"
   },
   "tool": {
    "properties": {
     "name": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "version"
    ],
    "type": "object"
   }
  },
  "required": [
   "schemaVersion",
   "tool",
   "kind",
   "status",
   "decision"
  ],
  "type": "object"
 },
 "title": "Scan an npm package"
}
