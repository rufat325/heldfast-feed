{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "read"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read note history"
 },
 "description": "Lists the note's retained versions, newest first, without changing the note. Read a version with notes.read. A changed history refuses the continuation with notes_changed.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "agent": {
    "description": "This assistant's display name.",
    "type": "string"
   },
   "cursor": {
    "description": "Continues the previous page.",
    "maxLength": 128,
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "file": {
    "description": "The note's current file.",
    "maxLength": 256,
    "type": "string"
   },
   "limit": {
    "description": "Versions per page. Clamped to 64.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "operation_id": {
    "description": "Optional retry identity scoped to this principal, connection and document. An unchanged mutation replays its original result for 24 hours, even after later edits; its expired identity never executes again. A read replays while its receipt is retained; after 256 later reads it executes afresh. Reusing an identity with changed arguments refuses. Visual observations are fresh. Inspect before starting another operation. Calls without it never replay.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "document",
   "file"
  ],
  "type": "object"
 },
 "name": "notes.history",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "availability": {
    "enum": [
     "available",
     "locked",
     "unavailable"
    ]
   },
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "complete": {
    "type": "boolean"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "file": {
    "maxLength": 256,
    "type": "string"
   },
   "found": {
    "type": "boolean"
   },
   "next_cursor": {
    "maxLength": 128,
    "type": [
     "string",
     "null"
    ]
   },
   "omitted": {
    "minimum": 0,
    "type": "integer"
   },
   "outcome": {
    "enum": [
     "ok",
     "target_gone",
     "conflict",
     "invalid",
     "refused",
     "uncertain"
    ],
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "remaining": {
    "minimum": 0,
    "type": "integer"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   },
   "tidied": {
    "minimum": 0,
    "type": "integer"
   },
   "tidiedAt": {
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "versions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "current": {
       "type": "boolean"
      },
      "reason": {
       "maxLength": 64,
       "type": "string"
      },
      "size": {
       "minimum": 0,
       "type": "integer"
      },
      "time": {
       "minimum": 0,
       "type": "integer"
      },
      "version": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Read note history"
}
