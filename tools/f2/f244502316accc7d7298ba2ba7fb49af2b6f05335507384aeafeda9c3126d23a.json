{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read the posts of one fediverse account in Nextcloud Social, newest first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "account": {
    "description": "Account id, or the handle (user@server)",
    "type": "string"
   },
   "limit": {
    "description": "Statuses to return (default 20, max 50)",
    "type": "number"
   },
   "max_id": {
    "description": "Only statuses older than this status id (page back)",
    "type": "number"
   },
   "min_id": {
    "description": "Only statuses newer than this status id (page forward)",
    "type": "number"
   },
   "only_media": {
    "description": "Only posts carrying media (default false)",
    "type": "boolean"
   }
  },
  "required": [
   "account"
  ],
  "type": "object"
 },
 "name": "social_account_statuses",
 "title": "Read Social Account Posts"
}
