{
 "description": "Apply SpatialPack's cohort-aware quality gate (SPEC-0036 thresholds + SPEC-0090 reporting) to a set of per-asset visual-diff metrics. Each input asset carries its cohort tags (textured/untextured \u00b7 animated/static \u00b7 low/medium/high poly) and worst-of-N ssim/\u0394E94/edgeDelta numbers from an orbit-8 render. Returns per-asset verdicts plus an aggregate `summary` (`pass` iff every asset passed); optionally writes a JSON report and a `gate-report.md` to `output_path`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assets": {
    "description": "Per-asset visual-diff bundles. ssim/edgeDelta in [0,1]; \u0394E94 in CIE units.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "asset_id": {
       "minLength": 1,
       "type": "string"
      },
      "cohort_tags": {
       "additionalProperties": false,
       "properties": {
        "animation_cohort": {
         "enum": [
          "animated",
          "static"
         ],
         "type": "string"
        },
        "poly_cohort": {
         "enum": [
          "low",
          "medium",
          "high"
         ],
         "type": "string"
        },
        "texture_cohort": {
         "enum": [
          "textured",
          "untextured"
         ],
         "type": "string"
        }
       },
       "required": [
        "texture_cohort",
        "animation_cohort",
        "poly_cohort"
       ],
       "type": "object"
      },
      "metrics": {
       "additionalProperties": false,
       "properties": {
        "delta_e94_mean": {
         "minimum": 0,
         "type": "number"
        },
        "delta_e94_p95": {
         "minimum": 0,
         "type": "number"
        },
        "edge_delta": {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "ssim": {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        }
       },
       "required": [
        "ssim",
        "delta_e94_mean",
        "edge_delta"
       ],
       "type": "object"
      },
      "notes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "asset_id",
      "cohort_tags",
      "metrics"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "cohort": {
    "description": "Cohort name (e.g. \"static-props\", \"skinned-animated\", \"all\").",
    "minLength": 1,
    "type": "string"
   },
   "feature_id": {
    "description": "Stable label for the candidate under test (e.g. \"spec-0091-source-texture-dedup\").",
    "minLength": 1,
    "type": "string"
   },
   "output_path": {
    "description": "Optional sandbox-relative path to write the SafetyGateReport JSON (`.md` sibling auto-emitted).",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "feature_id",
   "cohort",
   "assets"
  ],
  "type": "object"
 },
 "name": "safety_gate",
 "title": "Gate a cohort of assets against cohort-aware visual-diff thresholds (SPEC-0090)"
}
