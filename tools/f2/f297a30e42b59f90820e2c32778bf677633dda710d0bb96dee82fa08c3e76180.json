{
 "_meta": {
  "toolset": "entity"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Polygon"
 },
 "description": "Draw a polygon area from geographic coordinate tuples. Returns { success, data: { entityId }, message? }; keep entityId for removeEntity.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "clampToGround": {
    "default": true,
    "description": "Whether to clamp to ground",
    "type": "boolean"
   },
   "color": {
    "default": "#3B82F6",
    "description": "Fill color (CSS format)",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "coordinates": {
    "description": "Polygon outer ring coordinates [[lon, lat, height?], ...]",
    "items": {
     "description": "Coordinate tuple [longitude, latitude, optional height]",
     "items": {
      "type": "number"
     },
     "maxItems": 3,
     "minItems": 2,
     "prefixItems": [
      {
       "description": "Longitude in decimal degrees",
       "maximum": 180,
       "minimum": -180,
       "type": "number"
      },
      {
       "description": "Latitude in decimal degrees",
       "maximum": 90,
       "minimum": -90,
       "type": "number"
      },
      {
       "description": "Optional height in meters",
       "maximum": 50000000,
       "minimum": -12000,
       "type": "number"
      }
     ],
     "type": "array"
    },
    "maxItems": 10000,
    "minItems": 3,
    "type": "array"
   },
   "extrudedHeight": {
    "description": "Extruded height (meters), for 3D effect",
    "maximum": 100000,
    "minimum": 0,
    "type": "number"
   },
   "label": {
    "description": "Polygon label text",
    "maxLength": 200,
    "type": "string"
   },
   "opacity": {
    "default": 0.6,
    "description": "Fill opacity (0-1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "outlineColor": {
    "default": "#FFFFFF",
    "description": "Outline color",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "description": "Target browser session ID for multi-browser routing (optional)",
    "type": "string"
   }
  },
  "required": [
   "coordinates"
  ],
  "type": "object"
 },
 "name": "addPolygon",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "entityId": {
      "type": "string"
     }
    },
    "required": [
     "entityId"
    ],
    "type": "object"
   },
   "error": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 }
}
