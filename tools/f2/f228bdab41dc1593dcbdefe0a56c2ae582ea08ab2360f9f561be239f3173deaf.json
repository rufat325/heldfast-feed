{
 "description": "Search the largest machine-readable CC0 database \u2014 ranked matches (slug, title, kind, license, contract). [PAID: $0.01 USDC per call via x402]",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "kind": {
    "description": "Optional filter by entry kind.",
    "enum": [
     "artist",
     "work",
     "movement"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results (1-50, default 25).",
    "type": "number"
   },
   "query": {
    "description": "Free-text search across cc0pedia titles (case-insensitive).",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "cc0pedia-search"
}
