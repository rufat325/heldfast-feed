{
 "description": "Immutable version history: a bounded newest-first page (cursor/limit), or one exact version with its frozen tree when versionNumber is given. Requires job_checklists:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "type": "string"
   },
   "definitionId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "versionNumber": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "definitionId"
  ],
  "type": "object"
 },
 "name": "opentrain_job_checklists_versions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
