{
 "description": "Set or clear the DeletionMark on a catalog item or document (recoverable soft delete).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "entity": {
    "description": "\u0421\u0443\u0449\u043d\u043e\u0441\u0442\u044c (Catalog_* \u0438\u043b\u0438 Document_*)",
    "type": "string"
   },
   "mark": {
    "default": true,
    "description": "true \u2014 \u043f\u043e\u043c\u0435\u0442\u0438\u0442\u044c \u043d\u0430 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435, false \u2014 \u0441\u043d\u044f\u0442\u044c \u043f\u043e\u043c\u0435\u0442\u043a\u0443",
    "type": "boolean"
   },
   "ref_key": {
    "description": "Ref_Key (GUID)",
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   }
  },
  "required": [
   "entity",
   "ref_key"
  ],
  "type": "object"
 },
 "name": "set_deletion_mark"
}
