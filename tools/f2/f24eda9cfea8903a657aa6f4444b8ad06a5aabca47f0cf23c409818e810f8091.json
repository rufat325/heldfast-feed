{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return the full stored state of a LIVE session \u2014 cookies, localStorage and other credentials \u2014 plus its fingerprint and domain scores. The `session_context` object can be passed to spicrawl_session_create to clone the session. The result contains secrets (login cookies): do not echo it to the user or logs unless asked.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "session_id": {
    "description": "The session id returned by spicrawl_session_create or spicrawl_session_list.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "spicrawl_session_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "created_at": {
    "description": "Creation time, RFC 3339 UTC.",
    "type": "string"
   },
   "domain_scores": {
    "additionalProperties": {
     "additionalProperties": true,
     "properties": {
      "bad": {
       "description": "Failed requests counted.",
       "type": "integer"
      },
      "good": {
       "description": "Successful requests counted.",
       "type": "integer"
      },
      "last_updated": {
       "description": "Last update, Unix milliseconds.",
       "type": "number"
      },
      "retired": {
       "description": "Hard block for this domain; use a new session for it.",
       "type": "boolean"
      },
      "score": {
       "description": "Error score; rises on failures, decays on successes. Blocked at 3.",
       "type": "number"
      }
     },
     "type": "object"
    },
    "description": "Per-domain standing, keyed by domain. Omitted when empty.",
    "type": "object"
   },
   "expires_at": {
    "description": "Current expiry, RFC 3339 UTC.",
    "type": "string"
   },
   "fingerprint": {
    "anyOf": [
     {
      "additionalProperties": {},
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Stored browser fingerprint; null when none."
   },
   "last_used_at": {
    "description": "Last use, RFC 3339 UTC; null if never used.",
    "type": [
     "string",
     "null"
    ]
   },
   "retired": {
    "description": "Why the session was retired; absent while usable.",
    "type": "string"
   },
   "schema_version": {
    "type": "integer"
   },
   "session_context": {
    "additionalProperties": true,
    "description": "Cookies and storage: secrets. Pass it as `session_context` to spicrawl_session_create to clone the session.",
    "properties": {
     "cookies": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "domain": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "indexed_db": {
      "additionalProperties": {},
      "description": "Origin to databases; opaque.",
      "type": "object"
     },
     "local_storage": {
      "additionalProperties": {},
      "description": "Origin to key/value map.",
      "type": "object"
     },
     "session_storage": {
      "additionalProperties": {},
      "description": "Origin to key/value map.",
      "type": "object"
     }
    },
    "type": "object"
   },
   "session_id": {
    "description": "The session id.",
    "type": "string"
   },
   "usage_count": {
    "type": "integer"
   },
   "warning": {
    "description": "The API's reminder that this state dies with the session.",
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "title": "Dump a session's stored context"
}
