{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "List prediction markets on Problee. Each row carries the canonical `marketState` and, beside it, the derived `lifecycleStage` plus the `stageDeadline` that stage runs to \u2014 prefer `lifecycleStage` for display and for deciding what is possible right now.\n\nExamples: List live CRYPTO markets on Base",
 "inputSchema": {
  "$defs": {
   "EvmAddress": {
    "description": "Checksummed or lowercase 20-byte EVM address (0x + 40 hex).",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "MarketState": {
    "description": "Canonical market state shared by every protocol surface.",
    "enum": [
     "open",
     "closed",
     "creator_proposal",
     "challenge",
     "human_voting",
     "council_review",
     "resolved",
     "void"
    ],
    "type": "string"
   }
  },
  "properties": {
   "category": {
    "enum": [
     "CRYPTO",
     "SPORTS",
     "POLITICS",
     "ELECTIONS",
     "FINANCE",
     "TECH",
     "WORLD",
     "ECONOMY",
     "CULTURE",
     "WEATHER",
     "SCIENCE_HEALTH",
     "AI",
     "GAMING",
     "BUSINESS",
     "FASHION",
     "MOVIES_TV",
     "MUSIC",
     "SHOPPING",
     "BEAUTY",
     "TRAVEL",
     "CLIMATE",
     "DAILY_LIFE",
     "LOCAL",
     "SOCIAL",
     "FUN",
     "OTHER"
    ],
    "type": "string"
   },
   "chainId": {
    "type": "number"
   },
   "creator": {
    "$ref": "#/$defs/EvmAddress",
    "description": "Filter to markets whose on-chain creator wallet matches this address."
   },
   "cursor": {
    "description": "Keyset cursor from a prior response nextCursor.",
    "type": "string"
   },
   "marketState": {
    "$ref": "#/$defs/MarketState",
    "description": "Exact canonical market-state filter."
   },
   "pageSize": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "pricingModel": {
    "description": "Filter by pricing engine: 'ORDERBOOK' = central limit order book markets; 'automated' = automated-market-maker markets.",
    "enum": [
     "automated",
     "ORDERBOOK"
    ],
    "type": "string"
   },
   "search": {
    "description": "Free-text search over the market question.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "sort": {
    "default": "new",
    "description": "Sort order. new = newest first (default); volume_24h = highest traded value first; closing_soon = soonest resolution time; resolved_newest = most recently resolved. The keyset `cursor` only applies to `new`.",
    "enum": [
     "new",
     "volume_24h",
     "closing_soon",
     "resolved_newest"
    ],
    "type": "string"
   },
   "sourceConditionId": {
    "description": "Source market condition ID: lists the markets whose `resolutionSource` is `{type: 'polymarket', conditionId}` with this ID.",
    "pattern": "^0x[0-9a-fA-F]{64}$",
    "type": "string"
   },
   "sourceTokenId": {
    "description": "Source outcome token ID, in decimal as the source market's orders name it: lists the market that follows it, each row carrying `sourceToken.side`, the order side that is that outcome.",
    "pattern": "^[0-9]{1,78}$",
    "type": "string"
   }
  },
  "type": "object"
 },
