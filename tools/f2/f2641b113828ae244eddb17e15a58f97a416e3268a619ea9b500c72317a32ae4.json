{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Google Custom Search"
 },
 "description": "Google search in the Custom Search JSON API (CSE) format: items[] with title/link/snippet/displayLink, searchInformation, queries.nextPage. Use when porting CSE code or when items[] is wanted; search_google returns the richer full SERP. 1 credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cr": {
    "description": "e.g. 'countryUS'.",
    "type": "string"
   },
   "date_restrict": {
    "description": "d[N]/w[N]/m[N]/y[N], e.g. 'm6'.",
    "type": "string"
   },
   "exact_terms": {
    "description": "Phrase every result must contain.",
    "type": "string"
   },
   "exclude_terms": {
    "description": "Word or phrase to exclude.",
    "type": "string"
   },
   "file_type": {
    "description": "Extension, e.g. 'pdf'.",
    "type": "string"
   },
   "gl": {
    "description": "Country, e.g. 'us'.",
    "type": "string"
   },
   "hl": {
    "description": "Language, e.g. 'en'.",
    "type": "string"
   },
   "lr": {
    "description": "e.g. 'lang_en'.",
    "type": "string"
   },
   "num": {
    "description": "Results, 1-10 (default 10).",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "or_terms": {
    "description": "Space-separated; each result has at least one.",
    "type": "string"
   },
   "q": {
    "description": "Search query.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "safe": {
    "description": "SafeSearch.",
    "enum": [
     "active",
     "off"
    ],
    "type": "string"
   },
   "site_search": {
    "description": "Site to include/exclude, e.g. 'example.com'. Enforced on results.",
    "type": "string"
   },
   "site_search_filter": {
    "description": "'i' include (default), 'e' exclude.",
    "enum": [
     "i",
     "e"
    ],
    "type": "string"
   },
   "start": {
    "description": "1-based first result. start+num <= 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "google_custom_search",
 "title": "Google Custom Search"
}
