{
 "description": "Soft-delete an asset from the brand library. Pass confirm: true to proceed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "description": "Asset ID to delete",
    "type": "string"
   },
   "brandId": {
    "description": "Brand ID (defaults to active brand)",
    "type": "string"
   },
   "confirm": {
    "const": true,
    "description": "Must be true to confirm deletion",
    "type": "boolean"
   }
  },
  "required": [
   "assetId",
   "confirm"
  ],
  "type": "object"
 },
 "name": "delete_asset"
}
