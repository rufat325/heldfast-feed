{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Generate an image into the media library and return its asset id (attach with create_post.mediaIds). quality 'free' uses the free provider; 'hq' costs credits.",
 "inputSchema": {
  "properties": {
   "alt": {
    "maxLength": 300,
    "type": "string"
   },
   "aspectRatio": {
    "enum": [
     "1:1",
     "4:5",
     "16:9",
     "9:16"
    ],
    "type": "string"
   },
   "prompt": {
    "maxLength": 2000,
    "minLength": 3,
    "type": "string"
   },
   "quality": {
    "enum": [
     "free",
     "fast",
     "hq"
    ],
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "generate_image",
 "outputSchema": {
  "description": "Generated image media details",
  "properties": {
   "mediaId": {
    "type": "string"
   },
   "url": {
    "description": "Public URL of generated image",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "title": "Generate image"
}
