{
 "_meta": {
  "ui": {
   "resourceUri": "ui://threews-avatar/avatar.html"
  }
 },
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Render a three.ws 3D avatar inline: shows an interactive (rotatable) 3D model in the chat, plus a preview image and a ready-to-embed live URL. Identify the avatar by id, @handle, or a raw GLB url.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "id"
    ]
   },
   {
    "required": [
     "handle"
    ]
   },
   {
    "required": [
     "model"
    ]
   }
  ],
  "properties": {
   "auto_rotate": {
    "default": true,
    "description": "Spin the model in the interactive view.",
    "type": "boolean"
   },
   "background": {
    "default": "transparent",
    "description": "Backdrop for the preview/embed.",
    "enum": [
     "transparent",
     "dark",
     "light"
    ],
    "type": "string"
   },
   "handle": {
    "description": "three.ws username/handle, e.g. \"nirholas\" or \"@nirholas\".",
    "type": "string"
   },
   "height": {
    "default": 480,
    "maximum": 1080,
    "minimum": 160,
    "type": "integer"
   },
   "id": {
    "description": "Avatar UUID (from a three.ws avatar URL or get_avatar).",
    "type": "string"
   },
   "model": {
    "description": "Direct GLB/GLTF model URL (skips lookup; used as-is).",
    "type": "string"
   },
   "scene": {
    "default": "portrait",
    "description": "Framing for the rendered preview image.",
    "enum": [
     "portrait",
     "headshot",
     "upper-body",
     "full-body"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "render_avatar",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "background": {
    "description": "Backdrop applied to the preview/embed.",
    "type": "string"
   },
   "embed_url": {
    "description": "Live avatar-embed page URL (iframe src).",
    "type": "string"
   },
   "id": {
    "description": "Avatar UUID, or null when the avatar came from a raw model URL.",
    "type": [
     "string",
     "null"
    ]
   },
   "iframe": {
    "description": "Ready-to-paste <iframe> embed snippet.",
    "type": "string"
   },
   "model_url": {
    "description": "Direct GLB/GLTF model URL.",
    "type": "string"
   },
   "name": {
    "description": "Avatar display name.",
    "type": "string"
   },
   "viewer_url": {
    "description": "Standalone full-page interactive viewer URL.",
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "model_url",
   "background",
   "embed_url",
   "viewer_url",
   "iframe"
  ],
  "type": "object"
 },
 "title": "Render 3D avatar"
}
