{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the Impreza documentation and get the actual paragraph back. Use this BEFORE guessing an argument, a field name or how a flow works \u2014 \"container_name 502\", \"onion\", \"how does topup work\", \"manifest routing\", \"rate limit\". Returns the matching sections with their heading trail and the relevant excerpt, so you answer from what the docs say instead of from a guess. A guessed argument costs a 400 and a round trip; this costs one call. Also use it when a customer asks how something works: the answer is written down and you can quote it.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum sections (1-10, default 3).",
    "type": "number"
   },
   "query": {
    "description": "Plain words or an exact term, e.g. \"container_name\", \"ready_for_deploy\", \"crypto payment\".",
    "type": "string"
   },
   "section": {
    "description": "Instead of searching, return one whole section by the heading a previous result gave you (e.g. \"Manifest-mode routing contract\"). Use when the excerpt was cut short.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "impreza_search_docs",
 "outputSchema": {
  "anyOf": [
   {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "note": {
        "type": "string"
       },
       "query": {
        "type": "string"
       },
       "results": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "excerpt": {
           "type": "string"
          },
          "matched": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "score": {
           "type": "integer"
          },
          "title": {
           "type": "string"
          },
          "trail": {
           "type": "string"
          }
         },
         "required": [
          "title",
          "trail",
          "score",
          "matched",
          "excerpt"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "source": {
        "type": "string"
       },
       "total": {
        "type": "integer"
       }
      },
      "required": [
       "query",
       "total",
       "results",
       "source",
       "note"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "body": {
        "type": "string"
       },
       "source": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "trail": {
        "type": "string"
       }
      },
      "required": [
       "title",
       "trail",
       "body",
       "source"
      ],
      "type": "object"
     }
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Search documentation"
}
