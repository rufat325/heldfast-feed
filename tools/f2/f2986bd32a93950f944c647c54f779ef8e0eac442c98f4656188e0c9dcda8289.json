{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search original IELTS vocabulary entries with meaning, an example sentence and a usage caution. Use words for their meaning, not as a shortcut to a higher band.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 8,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 100,
    "type": "string"
   },
   "topic": {
    "enum": [
     "Education & work",
     "Environment & cities",
     "Health & society",
     "Argument & evidence",
     "Charts & trends",
     "Letters & register"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_vocabulary",
 "title": "Find vocabulary examples"
}
