{
 "description": "Collect a bounded sample of live financial news. Stops after the message or duration limit and returns news items as structured JSON.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "description": "Comma- or space-separated terms; matches when content contains at least one term.",
    "type": "string"
   },
   "duration_seconds": {
    "default": 10,
    "description": "Stop after this many seconds. Default 10; maximum 60.",
    "exclusiveMinimum": 0,
    "maximum": 60,
    "type": "number"
   },
   "max_messages": {
    "default": 20,
    "description": "Stop after this many data messages. Default 20; maximum 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "max_reconnect_attempts": {
    "default": 2,
    "description": "Maximum consecutive reconnect attempts. Default 2; maximum 10.",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "related_symbols": {
    "description": "Comma- or space-separated related symbols.",
    "type": "string"
   },
   "source": {
    "description": "Case-insensitive exact source name.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "collect_newsfeed",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activated": {
    "type": "boolean"
   },
   "data_message_count": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "endpoint": {
    "enum": [
     "live",
     "newsfeed"
    ],
    "type": "string"
   },
   "error": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "messages": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "stop_reason": {
    "enum": [
     "max_messages_reached",
     "duration_reached",
     "output_limit_reached",
     "cancelled",
     "activation_timeout",
     "terminal_error",
     "retry_exhausted",
     "output_error",
     "protocol_error"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "ok",
   "endpoint",
   "activated",
   "stop_reason",
   "data_message_count",
   "warnings",
   "messages"
  ],
  "type": "object"
 }
}
