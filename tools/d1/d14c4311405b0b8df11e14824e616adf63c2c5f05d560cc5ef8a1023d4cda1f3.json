{
 "annotations": {
  "readOnlyHint": true,
  "title": "List forms"
 },
 "description": "List the forms in the account, with submission counts, live URL and folder. Filter by name or folder and sort. Formstack: GET /forms.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "folder": {
    "description": "Only forms in this folder ID.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "order": {
    "description": "Sort direction (default ASC).",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "order_by": {
    "description": "Column to order by, e.g. name, created, updated.",
    "type": "string"
   },
   "page_number": {
    "description": "Page number, starting at 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Items per page, 10-500 (Formstack default 50).",
    "maximum": 500,
    "minimum": 10,
    "type": "integer"
   },
   "search": {
    "description": "Match forms by name.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "formstack_list_forms",
 "title": "List forms"
}
