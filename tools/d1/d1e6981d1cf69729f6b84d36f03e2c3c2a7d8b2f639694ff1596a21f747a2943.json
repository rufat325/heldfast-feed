{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find TCLP content (clauses, glossary terms, guides) associated with a named concept.\n\n    Unlike `search`, this performs a deterministic name match against Entity nodes in\n    the knowledge graph rather than a relevance-ranked semantic search. Use it when\n    you have a specific term or concept (e.g. \"scope 3 emissions\", \"net zero\") and\n    want to retrieve every clause or glossary entry that explicitly references it.\n\n    Args:\n        name: The entity or concept name to look up (exact match, case-insensitive).\n        limit: Maximum number of results to return (1\u201350).\n        include_full_text: Include each hit's full body text (Markdown). Off by\n            default \u2014 bodies are large; request only when you need the content,\n            and prefer a small `limit` when you do.\n\n    Returns:\n        JSON with \"meta\" and \"results\" where each hit includes the source content\n        node and the entity names that matched.\n        Each hit's \"references\" lists the instruments it cites: pass a\n        reference's `work_id` to `get_legal_resource` for details. A reference's\n        `edge` (governs, references, describes) says how the content relates to\n        the instrument; it is not a statement of the instrument's legal effect.\n        An empty list means the hit cites no instruments. null with \"lrsf\" in\n        meta.degraded means references could not be loaded: do not conclude\n        that the hit cites no instruments.\n    ",
 "inputSchema": {
  "properties": {
   "include_full_text": {
    "default": false,
    "title": "Include Full Text",
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "name": {
    "maxLength": 1000,
    "minLength": 1,
    "title": "Name",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "title": "entity_lookupArguments",
  "type": "object"
 },
 "name": "entity_lookup",
 "outputSchema": {
  "$defs": {
   "_EntityHit": {
    "properties": {
     "content_type": {
      "title": "Content Type",
      "type": "string"
     },
     "entity_matches": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Entity Matches"
     },
     "full_text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Full Text"
     },
     "id": {
      "title": "Id",
      "type": "string"
     },
     "ranks": {
      "$ref": "#/$defs/_SearchRanks"
     },
     "references": {
      "anyOf": [
       {
        "items": {
         "$ref": "#/$defs/_Reference"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "References"
     },
     "scores": {
      "$ref": "#/$defs/_SearchScores"
     },
     "title": {
      "title": "Title",
      "type": "string"
     },
     "url": {
      "title": "Url",
      "type": "string"
     }
    },
    "title": "_EntityHit",
    "type": "object"
   },
   "_Reference": {
    "properties": {
     "edge": {
      "title": "Edge",
      "type": "string"
     },
     "jurisdiction": {
      "items": {
       "type": "string"
      },
      "title": "Jurisdiction",
      "type": "array"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "nature": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Nature"
     },
     "staleness": {
      "title": "Staleness",
      "type": "string"
     },
     "status": {
      "title": "Status",
      "type": "string"
     },
     "work_id": {
      "title": "Work Id",
      "type": "string"
     }
    },
    "required": [
     "edge",
     "work_id",
     "name",
     "nature",
     "jurisdiction",
     "status",
     "staleness"
    ],
    "title": "_Reference",
    "type": "object"
   },
   "_SearchMeta": {
    "properties": {
     "degraded": {
      "items": {
       "type": "string"
      },
      "title": "Degraded",
      "type": "array"
     },
     "graph_total": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Graph Total"
     },
     "request_id": {
      "title": "Request Id",
      "type": "string"
     },
     "text_total": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Text Total"
     },
     "took_ms": {
      "title": "Took Ms",
      "type": "integer"
     },
     "total_available": {
      "title": "Total Available",
      "type": "integer"
     }
    },
    "title": "_SearchMeta",
    "type": "object"
   },
   "_SearchRanks": {
    "properties": {
     "bm25": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Bm25"
     },
     "combined": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Combined"
     },
     "graph": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Graph"
     }
    },
    "title": "_SearchRanks",
    "type": "object"
   },
   "_SearchScores": {
    "properties": {
     "bm25": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Bm25"
     },
     "graph": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Graph"
     }
    },
    "title": "_SearchScores",
    "type": "object"
   }
  },
  "properties": {
   "meta": {
    "$ref": "#/$defs/_SearchMeta"
   },
   "results": {
    "items": {
     "$ref": "#/$defs/_EntityHit"
    },
    "title": "Results",
    "type": "array"
   }
  },
  "required": [
   "meta",
   "results"
  ],
  "title": "EntityLookupResult",
  "type": "object"
 }
}
