    "type": "string"
   },
   "limit": {
    "description": "Neighbours returned (default 12, max 50)",
    "type": "integer"
   },
   "min_score": {
    "description": "Minimum cosine similarity (-1 to 1)",
    "maximum": 1,
    "minimum": -1,
    "type": "number"
   },
   "subset": {
    "description": "articles (default) | publications | references",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_similar_items",
