{
 "description": "DuckDuckGo Images for a query (title, page url, image, thumbnail, width, height). Up to 100 images a page. Billing per call: 1 Credits.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "color": {
    "enum": [
     "color_only",
     "monochrome",
     "red",
     "orange",
     "yellow",
     "green",
     "blue",
     "purple",
     "pink",
     "brown",
     "black",
     "gray",
     "teal",
     "white"
    ],
    "title": "Color",
    "type": "string"
   },
   "layout": {
    "enum": [
     "square",
     "tall",
     "wide"
    ],
    "title": "Layout",
    "type": "string"
   },
   "license": {
    "description": "creative_commons is any Creative Commons license.",
    "enum": [
     "creative_commons",
     "public_domain",
     "share",
     "share_commercially",
     "modify",
     "modify_commercially"
    ],
    "title": "License",
    "type": "string"
   },
   "page": {
    "description": "The results page, from 1.",
    "title": "Page",
    "type": "integer"
   },
   "q": {
    "description": "The search query.",
    "example": "nikola tesla",
    "title": "Search Query",
    "type": "string"
   },
   "region": {
    "description": "A DuckDuckGo region code such as us-en, de-de or uk-en; wt-wt is no region.",
    "example": "us-en",
    "title": "Region",
    "type": "string"
   },
   "safe_search": {
    "description": "DuckDuckGo's default is moderate.",
    "enum": [
     "strict",
     "moderate",
     "off"
    ],
    "title": "Safe Search",
    "type": "string"
   },
   "size": {
    "enum": [
     "small",
     "medium",
     "large",
     "wallpaper"
    ],
    "title": "Size",
    "type": "string"
   },
   "time": {
    "description": "Only images from the past day, week or month.",
    "enum": [
     "day",
     "week",
     "month"
    ],
    "title": "Time",
    "type": "string"
   },
   "type": {
    "enum": [
     "photo",
     "clipart",
     "gif",
     "transparent",
     "line"
    ],
    "title": "Type",
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "get_images",
 "title": "Images"
}
