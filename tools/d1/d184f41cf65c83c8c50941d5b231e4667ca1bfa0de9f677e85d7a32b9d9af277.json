{
 "_meta": {
  "com.ballranks/source": "https://ballranks.com/developers",
  "com.ballranks/support": "https://ballranks.com/support",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Look up one player's published Ball Ranks season ranking by player ID or slug. Use this when the user asks where a specific player ranks.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "model": {
    "default": "v0",
    "enum": [
     "v0",
     "v1"
    ],
    "type": "string"
   },
   "player": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "scoring_format": {
    "enum": [
     "standard",
     "half_ppr",
     "ppr"
    ],
    "type": "string"
   },
   "season": {
    "anyOf": [
     {
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
     },
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    ]
   },
   "sport": {
    "enum": [
     "basketball",
     "football"
    ],
    "type": "string"
   }
  },
  "required": [
   "sport",
   "player"
  ],
  "type": "object"
 },
 "name": "get_player_rankings",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "meta": {
    "additionalProperties": false,
    "properties": {
     "apiVersion": {
      "const": "1",
      "type": "string"
     },
     "capability": {
      "enum": [
       "weekly_rankings",
       "season_rankings",
       "player_rankings",
       "player_projections"
      ],
      "type": "string"
     },
     "generatedAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "model": {
      "enum": [
       "v0",
       "v1"
      ],
      "type": "string"
     },
     "modelDataVersion": {
      "type": "string"
     },
     "sport": {
      "enum": [
       "basketball",
       "football"
      ],
      "type": "string"
     },
     "updatedAt": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "apiVersion",
     "capability",
     "sport",
     "model",
     "modelDataVersion",
     "generatedAt",
     "updatedAt"
    ],
    "type": "object"
   },
   "player": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "position": {
      "type": [
       "string",
       "null"
      ]
     },
     "slug": {
      "type": "string"
     },
     "team": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "id",
     "name",
     "team",
     "position"
    ],
    "type": "object"
   },
   "ranking": {
    "additionalProperties": false,
    "properties": {
     "mode": {
      "const": "per_game",
      "type": "string"
     },
     "positionRank": {
      "type": [
       "number",
       "null"
      ]
     },
     "projectedPoints": {
      "type": [
       "number",
       "null"
      ]
     },
     "rank": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "scoring": {
      "const": "nine_category",
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "rank"
    ],
    "type": "object"
   },
   "scoringFormat": {
    "enum": [
     "standard",
     "half_ppr",
     "ppr"
    ],
    "type": "string"
   },
   "season": {
    "type": [
     "string",
     "number"
    ]
   },
   "sourceUrl": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "meta",
   "sourceUrl",
   "player",
   "season",
   "ranking"
  ],
  "type": "object"
 },
 "title": "Get a player's season ranking"
}
