{
 "description": "Create an empty course (no modules/lessons). Prefer hivelearn_create_course_outline when you already know the structure \u2014 it scaffolds course + modules + lesson placeholders in one call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "type": "string"
   },
   "description_format": {
    "enum": [
     "markdown",
     "tiptap_json"
    ],
    "type": "string"
   },
   "description_json": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "difficulty": {
    "anyOf": [
     {
      "enum": [
       "beginner",
       "intermediate",
       "advanced"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "instructor_avatar_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "instructor_name": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "thumbnail_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "title": {
    "minLength": 1,
    "type": "string"
   },
   "visibility": {
    "description": "Defaults to all_members",
    "enum": [
     "all_members",
     "admin_only"
    ],
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_course"
}
