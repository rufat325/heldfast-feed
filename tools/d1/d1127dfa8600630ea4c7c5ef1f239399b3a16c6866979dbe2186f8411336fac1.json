{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Unified hybrid search across learnings, decisions, entities, and observations (FTS5 BM25 + vector cosine fused with RRF). mode: fts|vector|hybrid (default hybrid). Optional project/tags scoping.",
 "inputSchema": {
  "properties": {
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "enum": [
     "fts",
     "vector",
     "hybrid"
    ],
    "type": "string"
   },
   "project": {
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "minLength": 1,
    "type": "string"
   },
   "ranking": {
    "properties": {
     "halfLifeDays": {
      "minimum": 0,
      "type": "number"
     },
     "importanceWeight": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "recencyWeight": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "usageWeight": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "tags": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "types": {
    "items": {
     "enum": [
      "learning",
      "decision",
      "entity",
      "observation"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "memory_search"
}
