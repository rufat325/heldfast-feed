      "uploadResult"
     ]
    },
    "then": {
     "required": [
      "uploadTicket"
     ]
    }
   },
   {
    "not": {
     "anyOf": [
      {
       "required": [
        "url",
        "text"
       ]
      },
      {
       "required": [
        "url",
        "uploadTicket"
       ]
      },
      {
       "required": [
        "url",
        "uploadResult"
       ]
      },
      {
       "required": [
        "text",
        "uploadTicket"
       ]
      },
      {
       "required": [
        "text",
        "uploadResult"
       ]
      }
     ]
    }
   },
   {
