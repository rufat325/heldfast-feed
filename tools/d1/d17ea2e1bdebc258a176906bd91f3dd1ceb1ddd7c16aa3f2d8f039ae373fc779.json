         "url"
        ]
       },
       {
        "required": [
         "text"
        ]
       }
      ]
     },
     "required": [
      "uploadTicket",
      "uploadResult"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "type": {
       "const": "LINK"
      }
     },
