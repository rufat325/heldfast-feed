{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":true,"title":"Transaction Execution Decision"},"description":"Simulate an Ethereum or Base transaction before execution and return an ALLOW, WARN, BLOCK, or INCOMPLETE decision with deterministic risk findings. Supports legacy post-execution inspection via tx_hash and pre-execution simulation via {from, to, value, data}.","inputSchema":{"properties":{"chain":{"default":null,"description":"EVM network containing the transaction.","enum":["ethereum","base"],"title":"Chain","type":"string"},"data":{"default":null,"description":"Calldata hex for contract calls.","pattern":"^0x(?:[a-fA-F0-9]{2})*$","title":"Data","type":"string"},"from_address":{"default":null,"description":"Sender address for pre-execution simulation.","pattern":"^0x[a-fA-F0-9]{40}$","title":"From Address","type":"string"},"to_address":{"default":null,"description":"Recipient/target address for pre-execution simulation.","pattern":"^0x[a-fA-F0-9]{40}$","title":"To Address","type":"string"},"tx_hash":{"default":null,"description":"32-byte EVM transaction hash (legacy post-execution mode).","pattern":"^0x[a-fA-F0-9]{64}$","title":"Tx Hash","type":"string"},"value":{"default":null,"description":"Native value in hex wei.","pattern":"^0x[0-9a-fA-F]*$","title":"Value","type":"string"}},"title":"handlerArguments","type":"object"},"name":"transaction_intelligence","outputSchema":{"oneOf":[{"additionalProperties":false,"properties":{"analysis":{"description":"Deterministic execution, classification, selector, value, gas, fee, logs, and creation analysis.","type":"object"},"chain":{"description":"Selected EVM network.","type":"string"},"latency_ms":{"description":"Observed RPC latency in milliseconds.","type":"integer"},"provider":{"description":"RPC provider identifier.","type":"string"},"receipt":{"description":"Raw RPC receipt, or null when pending or unavailable.","type":["object","null"]},"transaction":{"descri