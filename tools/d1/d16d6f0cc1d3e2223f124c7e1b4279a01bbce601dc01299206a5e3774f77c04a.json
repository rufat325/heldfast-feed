{
 "description": "Save current session state. Call this every 3-5 tool calls to protect against UI crashes. Required: task, intent, next_steps",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "additionalProperties": {},
    "description": "Any important state/variables",
    "type": "object"
   },
   "dead_ends_hit": {
    "description": "Timestamps of dead ends recorded this session",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "decisions_made": {
    "description": "Timestamps of decisions recorded this session",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "errors_encountered": {
    "description": "Exact error messages hit during this session",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "files_touched": {
    "description": "File paths modified",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "intent": {
    "description": "What you are trying to accomplish",
    "type": "string"
   },
   "key_findings": {
    "description": "Important discoveries made during this session",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "next_steps": {
    "description": "Planned next steps",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recent_actions": {
    "description": "Last 3-5 actions",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "description": "Current status",
    "enum": [
     "IN_PROGRESS",
     "BLOCKED",
     "WAITING_USER"
    ],
    "type": "string"
   },
   "task": {
    "description": "Brief task name",
    "type": "string"
   },
   "tool_call_count": {
    "description": "Approx tool calls so far",
    "type": "number"
   }
  },
  "required": [
   "task",
   "intent",
   "next_steps"
  ],
  "type": "object"
 },
 "name": "session_checkpoint"
}
