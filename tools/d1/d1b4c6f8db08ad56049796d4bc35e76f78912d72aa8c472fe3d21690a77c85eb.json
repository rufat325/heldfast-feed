{
 "description": "Generate cryptographically random passwords using a CSPRNG. Configurable length, count, character classes and ambiguous-character exclusion.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "default": 1,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "digits": {
    "default": true,
    "type": "boolean"
   },
   "exclude_ambiguous": {
    "default": false,
    "type": "boolean"
   },
   "length": {
    "default": 16,
    "maximum": 128,
    "minimum": 8,
    "type": "integer"
   },
   "lowercase": {
    "default": true,
    "type": "boolean"
   },
   "symbols": {
    "default": true,
    "type": "boolean"
   },
   "uppercase": {
    "default": true,
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "password"
}
