{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "A University Senate standing committee's meeting dates and times for an academic year (default: the current one), with the agendas posted for each; other meeting materials need a committee member login. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "committee": {
    "description": "Committee name as senate_list_committees gives it, e.g. \"Academic Procedures & Standards\"",
    "minLength": 1,
    "type": "string"
   },
   "year": {
    "description": "Academic year, e.g. \"2024-2025\" (default: current)",
    "pattern": "^\\d{4}-\\d{4}$",
    "type": "string"
   }
  },
  "required": [
   "committee"
  ],
  "type": "object"
 },
 "name": "senate_get_committee_meetings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "academic_year": {
    "description": "Academic year as \"YYYY-YYYY\", e.g. \"2025-2026\"",
    "pattern": "^\\d{4}-\\d{4}$",
    "type": "string"
   },
   "meetings": {
    "description": "Meetings in date order",
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "description": "Date as YYYY-MM-DD",
       "format": "date",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
       "type": "string"
      },
      "documents": {
       "description": "Agendas posted for the meeting; other materials need a committee member login",
       "items": {
        "additionalProperties": false,
        "properties": {
         "text": {
          "description": "Link text",
          "type": "string"
         },
         "url": {
          "description": "Absolute URL",
          "type": "string"
         }
        },
        "required": [
         "text",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "end_time": {
       "description": "End as HH:MM, 24-hour",
       "type": "string"
      },
      "start_time": {
       "description": "Start as HH:MM, 24-hour",
       "type": "string"
      }
     },
     "required": [
      "date",
      "start_time",
      "end_time",
      "documents"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "years": {
    "description": "Every academic year with committee folders, newest first",
    "items": {
     "description": "Academic year as \"YYYY-YYYY\", e.g. \"2025-2026\"",
     "pattern": "^\\d{4}-\\d{4}$",
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "academic_year",
   "years",
   "meetings"
  ],
  "type": "object"
 },
 "title": "Get committee meetings"
}
