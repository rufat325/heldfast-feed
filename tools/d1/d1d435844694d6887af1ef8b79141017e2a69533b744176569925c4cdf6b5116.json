{
 "description": "Record one catch in your logbook: date, species, place, and optionally length, weight, method, weather and water temperature. Returns the stored entry, or the list of errors that prevented storing it.",
 "inputSchema": {
  "properties": {
   "caught_on": {
    "description": "date of the catch, YYYY-MM-DD",
    "type": "string"
   },
   "length_cm": {
    "description": "length in cm (optional)",
    "type": "number"
   },
   "method": {
    "description": "how it was caught (optional)",
    "type": "string"
   },
   "notes": {
    "description": "free text (optional)",
    "type": "string"
   },
   "place": {
    "description": "where, e.g. \"north jetty\"",
    "type": "string"
   },
   "species": {
    "description": "what was caught, e.g. \"sea bass\"",
    "type": "string"
   },
   "water_temp_c": {
    "description": "water temperature in Celsius (optional)",
    "type": "number"
   },
   "weather": {
    "description": "conditions (optional)",
    "type": "string"
   },
   "weight_kg": {
    "description": "weight in kg (optional)",
    "type": "number"
   }
  },
  "required": [
   "caught_on",
   "species",
   "place"
  ],
  "type": "object"
 },
 "name": "record_catch"
}
