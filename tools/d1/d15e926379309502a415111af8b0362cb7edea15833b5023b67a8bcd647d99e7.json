{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Which JPY rate did Japan Customs publish for this currency on this date? Input: ISO 4217 code and YYYY-MM-DD date. Returns status (valid/invalid/unknown), the inclusive effective period, the JPY rate as published with its base units (1 or 100), source URLs, retrieval and verification times and SHA-256 hashes. Dates from 2021-08-15. Unpublished periods and unlisted currencies return unknown. Reference for customs and bookkeeping only; not a market or remittance rate; no tax calculation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "currency": {
    "description": "Uppercase ISO 4217 alpha-3 code, e.g. USD",
    "maxLength": 16,
    "type": "string"
   },
   "date": {
    "description": "Calendar date YYYY-MM-DD (Japan), e.g. 2026-10-07",
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "currency",
   "date"
  ],
  "type": "object"
 },
 "name": "jp_customs_fx",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "answered_at": {
    "type": "string"
   },
   "dataset_version": {
    "type": [
     "string",
     "null"
    ]
   },
   "effective_period": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "end": {
        "type": "string"
       },
       "start": {
        "type": "string"
       }
      },
      "required": [
       "start",
       "end"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Inclusive effective period of the rate (YYYY-MM-DD)."
   },
   "notice": {
    "type": "string"
   },
   "query": {},
   "rate": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "base_units": {
        "description": "1 or 100 units of the currency.",
        "type": "number"
       },
       "quote_currency": {
        "type": "string"
       },
       "value": {
        "description": "JPY value as published (decimal string).",
        "type": "string"
       }
      },
      "required": [
       "value",
       "base_units",
       "quote_currency"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "reason": {
    "enum": [
     "matched",
     "invalid_input",
     "invalid_currency",
     "invalid_date",
     "outside_supported_range",
     "period_not_published",
     "currency_not_listed",
     "coverage_gap",
     "source_unavailable",
     "source_conflict",
     "parse_error",
     "freshness_expired",
     "currency_reference_unavailable"
    ],
    "type": "string"
   },
   "sources": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "role": {
       "enum": [
        "rate",
        "index"
       ],
       "type": "string"
      },
      "sha256": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "role",
      "url",
      "sha256"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "description": "valid = published rate found; invalid = malformed input; unknown = could not be confirmed from the checked sources.",
    "enum": [
     "valid",
     "invalid",
     "unknown"
    ],
    "type": "string"
   },
   "terms": {
    "description": "URL of the terms of service.",
    "type": "string"
   }
  },
  "required": [
   "status",
   "reason",
   "query",
   "effective_period",
   "rate",
   "sources",
   "dataset_version",
   "answered_at",
   "notice",
   "terms"
  ],
  "type": "object"
 },
 "title": "Japan Customs exchange rate lookup"
}
