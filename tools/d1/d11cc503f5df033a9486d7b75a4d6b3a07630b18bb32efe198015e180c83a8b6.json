{
 "description": "Search Outlook messages using structured query objects with flexible field selection.",
 "inputSchema": {
  "$defs": {
   "__schema0": {
    "additionalProperties": false,
    "properties": {
     "$and": {
      "description": "Array of conditions that must ALL match",
      "items": {
       "$ref": "#/$defs/__schema0"
      },
      "type": "array"
     },
     "$not": {
      "$ref": "#/$defs/__schema0",
      "description": "Nested condition that must NOT match"
     },
     "$or": {
      "description": "Array of conditions where ANY must match",
      "items": {
       "$ref": "#/$defs/__schema0"
      },
      "type": "array"
     },
     "bcc": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by BCC recipient email address (partial match, case-insensitive)"
     },
     "body": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by email body content (partial match)"
     },
     "categories": {
      "anyOf": [
       {
        "enum": [
         "work",
         "personal",
         "family",
         "travel",
         "important",
         "urgent"
        ],
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "items": {
           "enum": [
            "work",
            "personal",
            "family",
            "travel",
            "important",
            "urgent"
           ],
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "items": {
           "enum": [
            "work",
            "personal",
            "family",
            "travel",
            "important",
            "urgent"
           ],
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "items": {
           "enum": [
            "work",
            "personal",
            "family",
            "travel",
            "important",
            "urgent"
           ],
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by Outlook system categories (work, personal, family, travel, important, urgent)"
     },
     "cc": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by CC recipient email address (partial match, case-insensitive)"
     },
     "date": {
      "additionalProperties": false,
      "description": "Filter by date range",
      "properties": {
       "$gte": {
        "description": "Messages on or after this date (YYYY-MM-DD)",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       },
       "$lt": {
        "description": "Messages before this date (YYYY-MM-DD)",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       }
      },
      "type": "object"
     },
     "exactPhrase": {
      "description": "Exact phrase matching - words must appear together in exact order (strict matching). Outlook uses KQL.",
      "minLength": 1,
      "type": "string"
     },
     "from": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by sender email address or name (partial match, case-insensitive)"
     },
     "hasAttachment": {
      "description": "Filter messages with file attachments",
      "type": "boolean"
     },
     "importance": {
      "description": "Filter by message importance level (high, normal, low)",
      "enum": [
       "high",
       "normal",
       "low"
      ],
      "type": "string"
     },
     "isRead": {
      "description": "Filter by read status (true = read, false = unread)",
      "type": "boolean"
     },
     "kqlQuery": {
      "description": "Raw KQL (Keyword Query Language) syntax for advanced use cases. Bypasses schema validation - use sparingly.",
      "minLength": 1,
      "type": "string"
     },
     "label": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by user-created categories (case-sensitive). Use outlook-categories-list to see available categories"
     },
     "subject": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by subject line (partial match, case-insensitive)"
     },
     "text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Search in both subject AND body (convenience shortcut)"
     },
     "to": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by recipient email address (partial match, case-insensitive)"
     }
    },
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contentType": {
    "default": "text",
    "description": "Format for body content: text extracts plain text, html preserves HTML structure",
    "enum": [
     "text",
     "html"
    ],
    "type": "string"
   },
   "excludeThreadHistory": {
    "default": false,
    "description": "When true, removes quoted thread history from body content",
    "type": "boolean"
   },
   "fields": {
    "description": "Comma-separated fields to return. Omit for all fields. Available: id, threadId, subject, from, fromName, to, cc, bcc, date, snippet, body, isRead, isImportant, hasAttachments, attachmentCount, labelIds, folderName",
    "type": "string"
   },
   "pageSize": {
    "default": 50,
    "description": "Number of items per page (default: 50, max: 500). Accepts numbers or numeric strings.",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "pageToken": {
    "description": "Token for retrieving the next page of results (outlook format). Omit for first page.",
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "anyOf": [
     {
      "$ref": "#/$defs/__schema0"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Structured query object or JSON string for filtering messages. Use query-syntax prompt for reference and kqlQuery for KQL syntax."
   },
   "shape": {
    "default": "objects",
    "description": "Response shape: objects (keyed) or arrays (columnar, matching fields order)",
    "enum": [
     "objects",
     "arrays"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "message-search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "items": {
        "description": "Matching email messages",
        "items": {
         "additionalProperties": false,
         "properties": {
          "attachmentCount": {
           "description": "Number of attachments",
           "type": "number"
          },
          "attachments": {
           "description": "Detailed attachment information",
           "items": {
            "additionalProperties": false,
            "properties": {
             "filename": {
              "type": "string"
             },
             "id": {
              "type": "string"
             },
             "mimeType": {
              "type": "string"
             },
             "size": {
              "type": "number"
             }
            },
            "required": [
             "id",
             "filename",
             "mimeType"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "bcc": {
           "type": "string"
          },
          "body": {
           "type": "string"
          },
          "bodyContentType": {
           "enum": [
            "text",
            "html"
           ],
           "type": "string"
          },
          "cc": {
           "type": "string"
          },
          "date": {
           "description": "Date in RFC 2822 format",
           "type": "string"
          },
          "folderName": {
           "description": "Name of the folder/mailbox containing this message",
           "type": "string"
          },
          "from": {
           "type": "string"
          },
          "fromName": {
           "type": "string"
          },
          "hasAttachments": {
           "description": "Whether the message has file attachments",
           "type": "boolean"
          },
          "id": {
           "type": "string"
          },
          "isImportant": {
           "description": "Whether the message is marked as important/priority",
           "type": "boolean"
          },
          "isRead": {
           "description": "Whether the message has been read",
           "type": "boolean"
          },
          "labelIds": {
           "description": "Gmail label IDs or Outlook category IDs",
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "receivedDateTime": {
           "description": "ISO datetime when message was received",
           "type": "string"
          },
          "snippet": {
           "description": "Short preview of the message body",
           "type": "string"
          },
          "subject": {
           "type": "string"
          },
          "threadId": {
           "description": "Thread/conversation ID for grouping related messages",
           "type": "string"
          },
          "to": {
           "type": "string"
          }
         },
         "type": "object"
        },
        "type": "array"
       },
       "nextPageToken": {
        "description": "Token for fetching next page of results",
        "type": "string"
       },
       "shape": {
        "const": "objects",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "shape",
       "items"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "columns": {
        "description": "Column names in canonical order",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "nextPageToken": {
        "description": "Token for fetching next page of results",
        "type": "string"
       },
       "rows": {
        "description": "Row data matching column order",
        "items": {
         "items": {},
         "type": "array"
        },
        "type": "array"
       },
       "shape": {
        "const": "arrays",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "shape",
       "columns",
       "rows"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
