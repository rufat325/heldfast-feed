{"_meta":{"securitySchemes":[{"scopes":["plan:create"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Save a batch of post drafts"},"description":"Create 1-12 new photo-post drafts in Soclo from supplied content: each a new draft id, an owned Library image assetId and its mediaUri, a caption and scheduledFor (kept only as a proposed time). Without confirm:true, previews and saves nothing; with confirm:true, saves the batch once and returns its receipt. Does not overwrite a draft, generate media or captions, schedule, publish or contact social accounts. Keep batchId, draftRevision and clientRequestId for soclo_posts_recover_drafts. Free; needs plan:create.","icons":[{"mimeType":"image/png","sizes":["1024x1024"],"src":"https://mcp.soclo.app/icon.png"}],"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"batchId":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"clientRequestId":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"confirm":{"description":"true only after the owner approved this exact change. Omit or false for a preview that changes nothing.","type":"boolean"},"draftRevision":{"maximum":999999999,"minimum":0,"type":"integer"},"items":{"items":{"additionalProperties":false,"properties":{"assetId":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"caption":{"maxLength":4000,"minLength":1,"type":"string"},"id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"mediaUri":{"format":"uri","maxLength":4096,"type":"string"},"scheduledFor":{"format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$","type":"string"}},"required":["id","assetId","mediaUri","caption","scheduledFor"],"type":"object"},"maxItems":12,"minItems":1,"type":"array"}},"required":["batchId","draftRevision","clientRequestId","items"],"type":"object"},"name":"soclo_posts_save_drafts","title":"Save a batch of post drafts"}
