{
 "description": "Keyword or regex search \u2014 sanctioned replacement for grep, always filtered and gated",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "exclude": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "force": {
    "default": false,
    "type": "boolean"
   },
   "max_files": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "max_hits": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "max_tokens": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "min_relevance": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "pattern": {
    "minLength": 1,
    "type": "string"
   },
   "regex": {
    "default": false,
    "type": "boolean"
   },
   "scope": {
    "type": "string"
   }
  },
  "required": [
   "pattern"
  ],
  "type": "object"
 },
 "name": "search"
}
