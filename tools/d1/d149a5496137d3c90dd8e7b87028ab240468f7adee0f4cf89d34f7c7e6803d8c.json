{
 "description": "Acquire a distributed lock with fencing token",
 "inputSchema": {
  "properties": {
   "mode": {
    "default": "majority",
    "enum": [
     "majority",
     "bft"
    ],
    "type": "string"
   },
   "resource": {
    "description": "Lock key, e.g. 'portfolio:main'.",
    "type": "string"
   },
   "swarmId": {
    "type": "string"
   },
   "ttlSeconds": {
    "default": 60,
    "maximum": 86400,
    "minimum": 1,
    "type": "integer"
   },
   "x402": {
    "additionalProperties": true,
    "description": "Optional bring-your-own x402 proof/headers.",
    "type": "object"
   }
  },
  "required": [
   "swarmId",
   "resource"
  ],
  "type": "object"
 },
 "name": "arbiter_lock_acquire"
}
