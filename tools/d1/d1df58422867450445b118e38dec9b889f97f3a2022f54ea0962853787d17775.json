{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Set Layout Grid"},"description":"Set the document's layout grid (font, size, scale and aki of its character cells) and which grids show: layout grid, frame grids, character counts, and snapping to the layout grid (Layout > Layout Grid; View > Grids & Guides). Layout and frame grids are part of the Japanese (CJK) feature set.","inputSchema":{"properties":{"grid":{"description":"Layout Grid options; only the ones you pass change","properties":{"appliedFont":{"description":"Font family of the grid","type":"string"},"characterAki":{"description":"Character aki: space between characters (mm)","maximum":1000,"minimum":-1000,"type":"number"},"fontStyle":{"description":"Font style of the grid","type":"string"},"horizontalScale":{"description":"Horizontal scale of the characters (%)","maximum":1000,"minimum":1,"type":"number"},"lineAki":{"description":"Line aki: space between lines (mm)","maximum":1000,"minimum":-1000,"type":"number"},"pointSize":{"description":"Character size (points)","maximum":1296,"minimum":0.1,"type":"number"},"verticalScale":{"description":"Vertical scale of the characters (%)","maximum":1000,"minimum":1,"type":"number"}},"type":"object"},"view":{"description":"Grid display (View > Grids & Guides)","properties":{"showCharacterCount":{"description":"Show Character Count of frame grids","type":"boolean"},"showFrameGrids":{"description":"Show Frame Grid","type":"boolean"},"showLayoutGrids":{"description":"Show Layout Grid","type":"boolean"},"snapToLayoutGrid":{"description":"Snap to Layout Grid","type":"boolean"}},"type":"object"}},"type":"object"},"name":"set_layout_grid","title":"Set Layout Grid"}
