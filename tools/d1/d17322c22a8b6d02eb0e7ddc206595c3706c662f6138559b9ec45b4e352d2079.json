{
 "description": "Import one or more videos into a local transcript collection for later semantic search. Unlike raw yt-dlp, imports persist across sessions and become searchable \u2014 call recallWorkspace or listCollections first to avoid re-importing what you already have. [~5-20s, ~2s per video]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activateCollection": {
    "type": "boolean"
   },
   "chunkOverlapSec": {
    "maximum": 300,
    "minimum": 0,
    "type": "number"
   },
   "chunkSizeSec": {
    "maximum": 900,
    "minimum": 30,
    "type": "number"
   },
   "chunkStrategy": {
    "enum": [
     "time_window",
     "chapters",
     "auto"
    ],
    "type": "string"
   },
   "collectionId": {
    "type": "string"
   },
   "dryRun": {
    "type": "boolean"
   },
   "embeddingDimensions": {
    "maximum": 3072,
    "minimum": 128,
    "type": "number"
   },
   "embeddingModel": {
    "type": "string"
   },
   "embeddingProvider": {
    "enum": [
     "local",
     "gemini"
    ],
    "type": "string"
   },
   "label": {
    "type": "string"
   },
   "language": {
    "type": "string"
   },
   "reindexExisting": {
    "type": "boolean"
   },
   "videoIdsOrUrls": {
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "videoIdsOrUrls"
  ],
  "type": "object"
 },
 "name": "importVideos"
}
