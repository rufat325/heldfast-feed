{
 "description": "Place a compute buy order on the G-Exchange matching engine. Give your GPU need, quantity, hours and max acceptable price per GPU-hour. Provider offers at or below your price are auto-matched instantly. Settlement: USDC on Solana.",
 "inputSchema": {
  "properties": {
   "contact": {
    "description": "Contact (email / telegram / handle) for delivery",
    "type": "string"
   },
   "count": {
    "description": "Number of GPUs needed",
    "type": "integer"
   },
   "gpu": {
    "description": "GPU model wanted, e.g. H100",
    "type": "string"
   },
   "hours": {
    "description": "Hours needed",
    "type": "integer"
   },
   "max_price_per_gpu_hr": {
    "description": "Max acceptable $/GPU/hr",
    "type": "number"
   }
  },
  "required": [
   "gpu",
   "count",
   "hours",
   "max_price_per_gpu_hr",
   "contact"
  ],
  "type": "object"
 },
 "name": "place_compute_order"
}
