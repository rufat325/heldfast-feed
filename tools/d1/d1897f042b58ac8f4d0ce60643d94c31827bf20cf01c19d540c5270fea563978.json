{
 "description": "Log (or overwrite) the income total for a source for a given month. Use 0 to clear it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount_usd": {
    "description": "Total earned that month in USD",
    "type": "number"
   },
   "month": {
    "pattern": "^\\d{4}-\\d{2}$",
    "type": "string"
   },
   "source": {
    "description": "Source name (case-insensitive) or slug",
    "type": "string"
   }
  },
  "required": [
   "source",
   "month",
   "amount_usd"
  ],
  "type": "object"
 },
 "name": "log_monthly_income"
}
