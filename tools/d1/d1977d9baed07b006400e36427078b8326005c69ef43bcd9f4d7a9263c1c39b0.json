{
 "annotations": {
  "openWorldHint": true
 },
 "description": "Runs Poetry commands and returns structured output. Supports install, add, remove, show, build, update, lock, check, and export actions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Poetry action to perform",
    "enum": [
     "install",
     "add",
     "remove",
     "show",
     "build",
     "update",
     "lock",
     "check",
     "export"
    ],
    "type": "string"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "dryRun": {
    "default": false,
    "description": "Preview changes without applying, for install/add/remove (--dry-run)",
    "type": "boolean"
   },
   "exportFormat": {
    "default": "requirements.txt",
    "description": "Export format for export action",
    "enum": [
     "requirements.txt"
    ],
    "type": "string"
   },
   "format": {
    "description": "Build output format for build action",
    "enum": [
     "sdist",
     "wheel"
    ],
    "type": "string"
   },
   "group": {
    "description": "Dependency group for install/add/remove (e.g. 'dev')",
    "maxLength": 255,
    "type": "string"
   },
   "latest": {
    "default": false,
    "description": "Show latest available version, for show action (--latest)",
    "type": "boolean"
   },
   "outdated": {
    "default": false,
    "description": "Show only outdated packages, for show action (--outdated)",
    "type": "boolean"
   },
   "output": {
    "description": "Output file for export action (-o FILE)",
    "maxLength": 4096,
    "type": "string"
   },
   "packages": {
    "description": "Packages for add/remove actions",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   },
   "tree": {
    "default": false,
    "description": "Show dependency tree, for show action (--tree)",
    "type": "boolean"
   },
   "withoutHashes": {
    "default": false,
    "description": "Exclude hashes in exported requirements (--without-hashes)",
    "type": "boolean"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "poetry",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "artifactCount": {
    "description": "Total artifact count (set in compact output)",
    "type": "number"
   },
   "artifacts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "file": {
       "type": "string"
      }
     },
     "required": [
      "file"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "exitCode": {
    "type": "number"
   },
   "messageCount": {
    "description": "Total message count (set in compact output)",
    "type": "number"
   },
   "messages": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "packageCount": {
    "description": "Total package count (set in compact output)",
    "type": "number"
   },
   "packages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "version"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   },
   "truncated": {
    "description": "Whether any compact list was capped (only set when true)",
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Poetry"
}
