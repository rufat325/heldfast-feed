 "description": "Opens the interactive passwerk workbench in hosts that render MCP Apps (Claude Desktop, Claude web): upload documents, accept or edit mapping proposals, read the gap report and export, all on the user\u2019s machine. Pass the current draft so the user reviews it visually; the workbench keeps the draft id in sync so gap_report and emit_passport can continue on it. Hosts without a UI receive the same draft, validation report and gap report as text.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "draft": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "draftId": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "draftId"
      ],
      "type": "object"
     },
     {
      "additionalProperties": {},
      "properties": {
       "meta": {}
      },
      "required": [
       "meta"
      ],
      "type": "object"
     }
    ],
    "description": "The draft to review; omit to open an empty workbench"
   },
   "facts": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "factSetId": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "factSetId"
      ],
      "type": "object"
     },
     {
      "additionalProperties": {},
      "properties": {
       "facts": {}
      },
      "required": [
       "facts"
      ],
      "type": "object"
     }
    ],
    "description": "Extracted facts to review alongside the draft"
   },
   "lang": {
    "description": "Language of the text summary (default en)",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "review_passport",
