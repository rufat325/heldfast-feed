{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Log a workout session with type, duration, calories, and heart rate.",
 "inputSchema": {
  "properties": {
   "active_calories": {
    "description": "Active calories (Apple Watch)",
    "type": "integer"
   },
   "avg_hr": {
    "description": "Average heart rate",
    "type": "integer"
   },
   "calories": {
    "description": "Total calories burned",
    "type": "integer"
   },
   "duration_minutes": {
    "description": "Duration in minutes",
    "type": "integer"
   },
   "ended_at": {
    "description": "Session end (Y-m-d H:i:s)",
    "type": "string"
   },
   "location": {
    "description": "Where the session happened",
    "type": "string"
   },
   "max_hr": {
    "description": "Max heart rate",
    "type": "integer"
   },
   "min_hr": {
    "description": "Min heart rate",
    "type": "integer"
   },
   "notes": {
    "description": "Notes",
    "type": "string"
   },
   "started_at": {
    "description": "Session start (Y-m-d H:i:s)",
    "type": "string"
   },
   "type": {
    "description": "Workout type",
    "enum": [
     "push",
     "pull",
     "legs",
     "upper",
     "lower",
     "full_body",
     "zone2",
     "cardio",
     "other"
    ],
    "type": "string"
   },
   "workout_date": {
    "description": "Workout date (Y-m-d, defaults to today)",
    "type": "string"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
 "name": "log_workout",
 "title": "Log workout"
}
