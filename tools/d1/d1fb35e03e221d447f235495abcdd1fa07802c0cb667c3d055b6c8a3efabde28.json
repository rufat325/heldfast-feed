 "inputSchema": {
  "properties": {
   "amount": {
    "description": "The money amount",
    "type": "number"
   },
   "mode": {
    "description": "'add' VAT to a net amount, or 'remove' VAT from a gross amount",
    "enum": [
     "add",
     "remove"
    ],
    "type": "string"
   },
   "rate": {
    "default": 20,
    "description": "VAT rate as a percentage (default 20)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "amount",
   "mode"
  ],
  "type": "object"
 },
 "name": "hopi_vat_calculator",
 "outputSchema": {
