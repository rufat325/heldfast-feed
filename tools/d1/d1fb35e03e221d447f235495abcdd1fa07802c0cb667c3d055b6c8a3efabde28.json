    "type": "string"
   },
   "net": {
    "type": "number"
   },
   "rate": {
    "type": "number"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "vat": {
    "type": "number"
   }
  },
  "required": [
   "gross",
   "mode",
   "net",
   "rate",
   "source_url",
   "summary",
   "vat"
  ],
  "type": "object"
 },
