{
 "annotations": {
  "destructiveHint": true,
  "title": "Block staff time"
 },
 "description": "Block time on one staff member's calendar at a location (a break, meeting or personal time) so it cannot be booked. One-off only. GraphQL: createTimeblock.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "duration": {
    "description": "Length in minutes.",
    "maximum": 1440,
    "minimum": 1,
    "type": "integer"
   },
   "location_id": {
    "description": "Location id, e.g. urn:blvd:Location:<uuid> (from boulevard_list_locations).",
    "minLength": 1,
    "type": "string"
   },
   "reason": {
    "description": "Why the time is blocked.",
    "enum": [
     "BUSINESS",
     "PERSONAL"
    ],
    "type": "string"
   },
   "staff_id": {
    "description": "The Staff id, e.g. urn:blvd:Staff:<uuid>.",
    "minLength": 1,
    "type": "string"
   },
   "start_time": {
    "description": "Start, ISO 8601 datetime with offset, e.g. 2026-10-02T13:00:00-07:00.",
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "description": "Title shown on the calendar.",
    "type": "string"
   }
  },
  "required": [
   "location_id",
   "staff_id",
   "start_time",
   "duration"
  ],
  "type": "object"
 },
 "name": "boulevard_create_timeblock",
 "title": "Block staff time"
}
