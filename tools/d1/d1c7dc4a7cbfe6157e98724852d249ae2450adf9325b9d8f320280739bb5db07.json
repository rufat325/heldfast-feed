{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List unified inbox conversations across all connected channels.\n\nAggregates comments, mentions, DMs, and messages from all organic and workspace connectors into a single inbox view.",
 "inputSchema": {
  "properties": {
   "assignedTo": {
    "description": "Filter by assignee",
    "type": "string"
   },
   "connectorId": {
    "description": "Filter by connector/platform",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 20)",
    "type": "number"
   },
   "priority": {
    "description": "Filter by priority",
    "enum": [
     "low",
     "normal",
     "high",
     "urgent"
    ],
    "type": "string"
   },
   "sentiment": {
    "description": "Filter by sentiment",
    "enum": [
     "positive",
     "neutral",
     "negative",
     "mixed"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by conversation status",
    "enum": [
     "open",
     "closed",
     "snoozed",
     "archived"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_conversations",
 "title": "List Conversations"
}
