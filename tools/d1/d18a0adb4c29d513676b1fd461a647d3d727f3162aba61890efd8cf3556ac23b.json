{
 "description": "Create a new WordPress post",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "author": {
    "description": "Author user ID",
    "type": "integer"
   },
   "categories": {
    "description": "Category IDs (replaces the current set)",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "comment_status": {
    "description": "Whether comments are open",
    "enum": [
     "open",
     "closed"
    ],
    "type": "string"
   },
   "content": {
    "description": "Content (HTML / block markup, stored raw)",
    "type": "string"
   },
   "date": {
    "description": "Publish date in the site timezone (ISO8601); a future date with status publish schedules it",
    "type": "string"
   },
   "date_gmt": {
    "description": "Publish date in GMT (ISO8601)",
    "type": "string"
   },
   "excerpt": {
    "description": "Excerpt",
    "type": "string"
   },
   "featured_media": {
    "description": "Featured image media ID (0 removes it)",
    "type": "integer"
   },
   "format": {
    "description": "Post format",
    "enum": [
     "standard",
     "aside",
     "chat",
     "gallery",
     "link",
     "image",
     "quote",
     "status",
     "video",
     "audio"
    ],
    "type": "string"
   },
   "meta": {
    "additionalProperties": {},
    "description": "Registered meta fields (show_in_rest) as key/value",
    "type": "object"
   },
   "password": {
    "description": "Password to protect the content ('' removes protection); write-only, never returned",
    "type": "string"
   },
   "ping_status": {
    "description": "Whether pingbacks/trackbacks are open",
    "enum": [
     "open",
     "closed"
    ],
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "URL slug",
    "type": "string"
   },
   "status": {
    "default": "draft",
    "description": "Post status (default draft)",
    "enum": [
     "publish",
     "future",
     "draft",
     "pending",
     "private"
    ],
    "type": "string"
   },
   "sticky": {
    "description": "Stick the post to the front page",
    "type": "boolean"
   },
   "tags": {
    "description": "Tag IDs (replaces the current set)",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "template": {
    "description": "Theme template file, e.g. 'page-full-width.php' ('' = default)",
    "type": "string"
   },
   "title": {
    "description": "Post title",
    "type": "string"
   }
  },
  "required": [
   "site",
   "title"
  ],
  "type": "object"
 },
 "name": "wp_create_post"
}
