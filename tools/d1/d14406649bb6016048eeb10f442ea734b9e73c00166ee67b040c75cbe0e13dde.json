 "description": "Record how far a maintenance job moved the reference, on an entry that opened a calibration epoch. Takes an ENTRY, not a piece of equipment: the offset belongs to the event that caused it, which is what lets several of them compose for a recipe locked before all of them. Zero is a legitimate measurement and means \"measured, and it had not moved\" \u2014 omit offset_value entirely to clear it back to unmeasured.",
 "inputSchema": {
  "properties": {
   "entry_id": {
    "description": "The maintenance entry that opened the epoch, from list_grinders",
    "type": "integer"
   },
   "evidence": {
    "description": "One line recording what it rested on, e.g. \"Reference pull 1.38 g/s against 1.74 g/s locked.\"",
    "type": "string"
   },
   "offset_value": {
    "description": "Clicks to ADD to a pre-clean reading to get the same grind today, signed along the collar's own number direction. 0 records \"unchanged\"; omit to clear the measurement",
    "type": "number"
   },
   "source": {
    "description": "How it was arrived at: pull, counted, or typed",
    "enum": [
     "pull",
     "counted",
     "typed"
    ],
    "type": "string"
   }
  },
  "required": [
   "entry_id"
  ],
  "type": "object"
 },
 "name": "set_maintenance_offset",
