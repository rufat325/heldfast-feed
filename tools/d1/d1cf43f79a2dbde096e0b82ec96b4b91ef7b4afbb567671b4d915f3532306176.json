{
 "annotations": {
  "readOnlyHint": true,
  "title": "List purchase orders"
 },
 "description": "List purchase orders, most recently updated first, filterable by PO number and status. The list leaves out notes, terms, sub_total and line_items \u2014 use sortly_get_purchase_order for those. Needs Purchase Orders on the plan (else 402). Sortly: GET /api/v1/purchase_orders.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "page": {
    "description": "Page number, starting at 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Page size, 1-100 (default 20).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "purchase_order_number": {
    "description": "POs whose number contains this.",
    "type": "string"
   },
   "sort_by": {
    "description": "Sort field. Default updated_at.",
    "enum": [
     "purchase_order_number",
     "created_by",
     "submitted_by",
     "status",
     "updated_at",
     "total",
     "ordered_date",
     "expected_delivery_date",
     "received_date"
    ],
    "type": "string"
   },
   "sort_direction": {
    "description": "Default desc.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status": {
    "description": "Only these statuses. Default all.",
    "items": {
     "enum": [
      "draft",
      "ready_for_review",
      "approved",
      "ordered",
      "partially_received",
      "received",
      "voided",
      "closed"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "sortly_list_purchase_orders",
 "title": "List purchase orders"
}
