{
 "description": "Returns the full configuration of a status page by slug, including the ordered list of groups, the monitors inside each group, and active incidents. Only works for published status pages (fetches the public `/api/status-page/{slug}` endpoint).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "The status page slug (the URL-safe identifier)",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "getStatusPage",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "config": {
    "additionalProperties": true,
    "properties": {
     "customCSS": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ],
      "description": "Custom CSS for the status page"
     },
     "description": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ],
      "description": "Description shown on the status page"
     },
     "domainNameList": {
      "description": "Custom domain names for this status page",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "footerText": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ],
      "description": "Footer text"
     },
     "icon": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ],
      "description": "Icon URL or path"
     },
     "id": {
      "description": "Status page ID",
      "type": "number"
     },
     "published": {
      "description": "Whether the status page is publicly accessible",
      "type": "boolean"
     },
     "showPoweredBy": {
      "description": "Whether to show Uptime Kuma branding",
      "type": "boolean"
     },
     "showTags": {
      "description": "Whether to show tags on the status page",
      "type": "boolean"
     },
     "slug": {
      "description": "URL slug for the status page",
      "type": "string"
     },
     "theme": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ],
      "description": "Theme (light or dark)"
     },
     "title": {
      "description": "Title of the status page",
      "type": "string"
     }
    },
    "required": [
     "slug",
     "title"
    ],
    "type": "object"
   },
   "incidents": {
    "description": "Active incidents on the status page",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "msg": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "publicGroupList": {
    "description": "Ordered groups with their monitorList",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
