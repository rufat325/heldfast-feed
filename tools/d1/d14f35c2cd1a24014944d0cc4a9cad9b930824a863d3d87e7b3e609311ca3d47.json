{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false,"title":"Get the video plan for a whole site"},"description":"[Free] Up to 5 ranked videos a site should have, one per subject: goal, pitch, the real page it films (checked), the video made; detail full adds the brief, sources and shots. First call generates it (~10-20 s, no credit), then banks the site's images, videos and page clips in the background (media counts them). generate_site_videos works from it.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"detail":{"default":"short","description":"short: title, goal, pitch, page and whether it was made. full: also the brief (focus), its sources, audience, tone and shots.","enum":["short","full"],"type":"string"},"language":{"default":"en","description":"Language the ideas and shot list are written in. This is the planner's working language, not the videos' \u2014 generate_site_videos sets that.","enum":["en","fr","es","de","it","pt","nl","ar","hi","ko","pl","tr","sv"],"type":"string"},"limit":{"default":5,"description":"How many ideas, best first.","maximum":35,"minimum":1,"type":"integer"},"refresh":{"default":false,"description":"true regenerates the plan even if one exists, overwriting it. A plan is generated automatically the first time.","type":"boolean"},"site_url":{"description":"Any public http(s) URL on the site; the site is identified by its domain.","format":"uri","type":"string"}},"required":["site_url"],"type":"object"},"name":"get_site_plan","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"detail":{"type":"string"},"freshly_generated":{"type":"boolean"},"generated_at":{"type":["string","null"]},"grounding_notes":{"items":{"additionalProperties":{},"properties":{"detail":{"type":"string"},"idea_id":{"type":"string"},"kind":{"type":"string"}},"required":["idea_id","kind",