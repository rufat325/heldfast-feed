{
 "description": "Read Zotero's debug log output. Shows recent debug messages from Zotero.debug() calls.",
 "inputSchema": {
  "properties": {
   "filter": {
    "description": "Filter logs containing this string (case-insensitive)",
    "type": "string"
   },
   "level": {
    "default": "all",
    "description": "Filter by log level (default: all)",
    "enum": [
     "all",
     "error",
     "warning",
     "info"
    ],
    "type": "string"
   },
   "lines": {
    "default": 100,
    "description": "Number of recent lines to return (default: 100)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "zotero_read_logs"
}
