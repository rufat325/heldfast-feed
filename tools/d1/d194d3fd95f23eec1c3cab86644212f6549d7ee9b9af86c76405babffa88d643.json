{
 "description": "Queue 1 through 400 reviewed facts for warm checks. This tool does not create watched sources. Each item gets a terminal result.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "external_batch_id": {
    "maxLength": 256,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._~:@/+-]*[A-Za-z0-9._~:@+-])?$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "reuse the operation key returned by an ambiguous prior attempt; omit for a new operation",
    "maxLength": 200,
    "minLength": 8,
    "pattern": "^[\\x20-\\x7e]+$",
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "claim": {
       "additionalProperties": false,
       "properties": {
        "materiality": {
         "enum": [
          "low",
          "medium",
          "high",
          "critical"
         ],
         "type": "string"
        },
        "object": {
         "anyOf": [
          {
           "maxLength": 2000,
           "minLength": 1,
           "type": "string"
          },
          {
           "$ref": "#/properties/items/items/properties/claim/properties/subject/anyOf/1"
          },
          {
           "type": "number"
          },
          {
           "type": "boolean"
          },
          {
           "type": "null"
          }
         ]
        },
        "predicate": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "scope": {
         "additionalProperties": {
          "anyOf": [
           {
            "maxLength": 2000,
            "type": "string"
           },
           {
            "type": "number"
           },
           {
            "type": "boolean"
           },
           {
            "type": "null"
           }
          ]
         },
         "description": "what the claim is scoped to, e.g. { jurisdiction: 'US', plan: 'HMO' }",
         "propertyNames": {
          "maxLength": 256,
          "minLength": 1
         },
         "type": "object"
        },
        "subject": {
         "anyOf": [
          {
           "maxLength": 1000,
           "minLength": 1,
           "type": "string"
          },
          {
           "additionalProperties": false,
           "properties": {
            "id": {
             "maxLength": 1000,
             "minLength": 1,
             "type": "string"
            },
            "name": {
             "maxLength": 1000,
             "minLength": 1,
             "type": "string"
            },
            "type": {
             "maxLength": 256,
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "name"
           ],
           "type": "object"
          }
         ]
        },
        "text": {
         "maxLength": 2000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "subject",
        "predicate"
       ],
       "type": "object"
      },
      "contract_claim_id": {
       "format": "uuid",
       "type": "string"
      },
      "item_id": {
       "$ref": "#/properties/external_batch_id"
      },
      "source_ids": {
       "items": {
        "$ref": "#/properties/items/items/properties/contract_claim_id"
       },
       "maxItems": 20,
       "type": "array"
      }
     },
     "required": [
      "item_id",
      "claim",
      "source_ids"
     ],
     "type": "object"
    },
    "maxItems": 400,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "external_batch_id",
   "items"
  ],
  "type": "object"
 },
 "name": "import_facts"
}
