{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List comments on a file. Works with Google Docs, Sheets, Slides, and other Drive files.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fileId": {
    "description": "The ID of the file",
    "type": "string"
   },
   "includeDeleted": {
    "default": false,
    "description": "Include deleted comments",
    "type": "boolean"
   },
   "pageSize": {
    "default": 20,
    "description": "Maximum number of comments to return (1-100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "pageToken": {
    "description": "Token for pagination",
    "type": "string"
   },
   "startModifiedTime": {
    "description": "Only return comments modified after this time (RFC 3339)",
    "type": "string"
   }
  },
  "required": [
   "fileId"
  ],
  "type": "object"
 },
 "name": "comments_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "comments": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "anchor": {
       "type": "string"
      },
      "author": {
       "additionalProperties": false,
       "properties": {
        "displayName": {
         "type": "string"
        },
        "emailAddress": {
         "type": "string"
        },
        "photoLink": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "content": {
       "type": "string"
      },
      "createdTime": {
       "type": "string"
      },
      "deleted": {
       "type": "boolean"
      },
      "htmlContent": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "modifiedTime": {
       "type": "string"
      },
      "quotedFileContent": {
       "additionalProperties": false,
       "properties": {
        "mimeType": {
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "replies": {
       "items": {
        "additionalProperties": true,
        "properties": {
         "author": {
          "additionalProperties": false,
          "properties": {
           "displayName": {
            "type": "string"
           },
           "emailAddress": {
            "type": "string"
           },
           "photoLink": {
            "type": "string"
           }
          },
          "type": "object"
         },
         "content": {
          "type": "string"
         },
         "createdTime": {
          "type": "string"
         },
         "deleted": {
          "type": "boolean"
         },
         "htmlContent": {
          "type": "string"
         },
         "id": {
          "type": "string"
         },
         "modifiedTime": {
          "type": "string"
         }
        },
        "required": [
         "id"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "resolved": {
       "type": "boolean"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextPageToken": {
    "type": "string"
   }
  },
  "required": [
   "comments"
  ],
  "type": "object"
 },
 "title": "List comments"
}
