{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Setup Ducking"
 },
 "description": "Build a verified Volume > Level keyframe curve for one audio clip. Ducking-window times are relative to that clip's start; overlapping or out-of-range windows are rejected before any keyframe write.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "base_db": {
    "description": "Normal clip level in dB (defaults to 0; maximum +15 dB).",
    "type": "number"
   },
   "ducking_windows": {
    "description": "Non-overlapping windows during which this clip should be quieter.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "ducked_db": {
       "description": "Level during the window, in dB (maximum +15 dB).",
       "type": "number"
      },
      "end_seconds": {
       "description": "Window end, relative to clip start.",
       "minimum": 0,
       "type": "number"
      },
      "start_seconds": {
       "description": "Window start, relative to clip start.",
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "start_seconds",
      "end_seconds",
      "ducked_db"
     ],
     "type": "object"
    },
    "maxItems": 32,
    "minItems": 0,
    "type": "array"
   },
   "expected_cep_target": {
    "additionalProperties": false,
    "anyOf": [
     {
      "required": [
       "sequence_id"
      ]
     },
     {
      "required": [
       "source_item"
      ]
     }
    ],
    "description": "Optional reviewed CEP sequence/clip identity and exact tick ranges. Checked before every generated command; UXP refuses this CEP-only guard.",
    "properties": {
     "backend": {
      "const": "cep",
      "description": "Backend namespace for these IDs.",
      "type": "string"
     },
     "clip": {
      "additionalProperties": false,
      "description": "Optional exact reviewed timeline clip.",
      "properties": {
       "effect": {
        "additionalProperties": false,
        "description": "Reviewed effect and parameter identity checked before mutation.",
        "properties": {
         "display_name": {
          "description": "Optional exact host display name.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         "match_name": {
          "description": "Effect match name from host inspection.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         "parameter_index": {
          "description": "Inspected zero-based parameter index.",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
         },
         "parameter_name": {
          "description": "Exact inspected parameter name.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "match_name",
         "parameter_index",
         "parameter_name"
        ],
        "type": "object"
       },
       "end_ticks": {
        "description": "Exact expected exclusive timeline end ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "in_ticks": {
        "description": "Exact expected source In ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "node_id": {
        "description": "Stable CEP node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "out_ticks": {
        "description": "Exact expected exclusive source Out ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "project_item_id": {
        "description": "Expected source project-item node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "start_ticks": {
        "description": "Exact expected timeline start ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "track_index": {
        "description": "Expected zero-based track index; identity still checked.",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       },
       "track_type": {
        "description": "Expected media track group.",
        "enum": [
         "video",
         "audio"
        ],
        "type": "string"
       }
      },
      "required": [
       "node_id",
       "track_type",
       "track_index"
      ],
      "type": "object"
     },
     "project_document_id": {
      "description": "Exact Premiere project document ID observed during review.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "sequence_id": {
      "description": "Stable expected active sequence ID.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "source_item": {
      "additionalProperties": false,
      "description": "Reviewed source identity for a source-only operation.",
      "properties": {
       "media_path": {
        "description": "Optional exact source-media path.",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
       },
       "node_id": {
        "description": "Exact project-item node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "node_id"
      ],
      "type": "object"
     }
    },
    "required": [
     "backend"
    ],
    "type": "object"
   },
   "expected_project_path": {
    "description": "Optional absolute saved-project path. Every generated CEP command refuses before its body when the active project differs or is unsaved. UXP commands refuse this CEP-only guard; local-only tools do not inspect Premiere. Omit to keep existing behavior.",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "fade_seconds": {
    "description": "Fade length on each side of a window in seconds (defaults to 0.2).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "node_id": {
    "description": "Timeline audio-clip node ID.",
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "node_id",
   "ducking_windows"
  ],
  "type": "object"
 },
 "name": "setup_ducking",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true; on failure, diagnostic detail when the tool provides it."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "receipt": {
    "additionalProperties": true,
    "description": "Versioned common mutation receipt; success never implies rendered verification.",
    "type": "object"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Setup Ducking"
}
