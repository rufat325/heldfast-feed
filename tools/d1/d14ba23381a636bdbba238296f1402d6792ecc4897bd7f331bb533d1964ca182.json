{
 "description": "Decide whether another search or paid retrieval is worth the cost based on the scope already checked. Use after several search or source checks when you need to decide whether to continue or return a scoped not-found result. It does not prove universal absence and performs no searches itself. Price: $0.003 USD per call via x402.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "checks": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "authority": {
       "enum": [
        "primary",
        "official",
        "secondary",
        "general",
        "unknown"
       ],
       "type": "string"
      },
      "checked_at": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "coverage": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      },
      "exhaustive": {
       "default": false,
       "type": "boolean"
      },
      "method": {
       "enum": [
        "direct",
        "search",
        "documentation",
        "api_catalog",
        "registry",
        "browser",
        "other"
       ],
       "type": "string"
      },
      "result": {
       "enum": [
        "found",
        "not_found",
        "inconclusive",
        "error",
        "blocked",
        "contradictory"
       ],
       "type": "string"
      },
      "target": {
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "target",
      "method",
      "result",
      "authority",
      "coverage"
     ],
     "type": "object"
    },
    "maxItems": 40,
    "type": "array"
   },
   "goal": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "remaining_routes": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "estimated_cost_usd": {
       "maximum": 10000,
       "minimum": 0,
       "type": "number"
      },
      "expected_value": {
       "anyOf": [
        {
         "enum": [
          "low",
          "medium",
          "high"
         ],
         "type": "string"
        },
        {
         "const": "unknown",
         "type": "string"
        }
       ]
      },
      "route": {
       "maxLength": 300,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "route",
      "expected_value"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "risk": {
    "default": "medium",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "search_budget": {
    "additionalProperties": false,
    "properties": {
     "calls_remaining": {
      "maximum": 10000,
      "minimum": 0,
      "type": "integer"
     },
     "calls_used": {
      "maximum": 10000,
      "minimum": 0,
      "type": "integer"
     },
     "cost_remaining_usd": {
      "maximum": 10000,
      "minimum": 0,
      "type": "number"
     },
     "cost_used_usd": {
      "maximum": 10000,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "stop_search",
 "title": "stop_search"
}
