{
 "description": "Gestiona proyectos. Acciones: list (page, limit, search, status_id, client_id, deadline), get (id), create, update (id), delete (id), members (id), add_member (id, user_id), remove_member (id, user_id), comments (id), add_comment (id, description), files (id), milestones (id), create_milestone (id, title), update_milestone (id, milestone_id).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete",
     "members",
     "add_member",
     "remove_member",
     "comments",
     "add_comment",
     "files",
     "milestones",
     "create_milestone",
     "update_milestone"
    ],
    "type": "string"
   },
   "client_id": {
    "type": "number"
   },
   "custom_fields": {
    "items": {
     "properties": {
      "custom_field_id": {
       "type": "number"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "custom_field_id",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "deadline": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "due_date": {
    "type": "string"
   },
   "id": {
    "description": "ID del proyecto",
    "type": "number"
   },
   "labels": {
    "type": "string"
   },
   "leader_id": {
    "type": "number"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "milestone_id": {
    "description": "ID del milestone para update_milestone",
    "type": "number"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "points": {
    "type": "number"
   },
   "price": {
    "type": "number"
   },
   "project_type": {
    "type": "string"
   },
   "search": {
    "type": "string"
   },
   "sort_by_project_order": {
    "type": "boolean"
   },
   "start_date": {
    "type": "string"
   },
   "status_id": {
    "type": "string"
   },
   "team_members": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "user_id": {
    "description": "ID del usuario para add_member/remove_member",
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "projects"
}
