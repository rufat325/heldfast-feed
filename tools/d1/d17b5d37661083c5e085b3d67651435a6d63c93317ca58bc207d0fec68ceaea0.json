{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find products by (partial) name, e.g. 'fenix 9', 'forerunner 970'. Returns the release record, generation chain, case_sizes_mm, size_variants with specifications and caveats per model and case size, and buy_links. Missing size data is unknown. Do not apply generation-level battery ranges to individual sizes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Full or partial product name",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_product",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_via": {
    "description": "Source attribution for Endurance Wire",
    "type": "string"
   },
   "count": {
    "type": "integer"
   },
   "products": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "available": {
       "type": "string"
      },
      "brand": {
       "type": "string"
      },
      "buy_links": {
       "description": "Verified buying destinations; an empty list does not mean out of stock",
       "items": {
        "additionalProperties": false,
        "properties": {
         "merchant": {
          "type": "string"
         },
         "region": {
          "type": "string"
         },
         "url": {
          "format": "uri",
          "type": "string"
         }
        },
        "required": [
         "merchant",
         "region",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "case_sizes_mm": {
       "description": "Recorded case sizes in mm; an empty list means unknown",
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "colors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "date": {
       "description": "Announcement date, YYYY-MM or YYYY-MM-DD",
       "type": "string"
      },
      "family": {
       "type": "string"
      },
      "generation_chain": {
       "description": "Newest-first release history",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "img": {
       "format": "uri",
       "type": "string"
      },
      "line": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "price": {
       "description": "Historical launch price in its original currency, not a current offer",
       "type": "string"
      },
      "priceCurrency": {
       "description": "Defaults to USD when omitted",
       "enum": [
        "USD",
        "EUR"
       ],
       "type": "string"
      },
      "size_data_status": {
       "enum": [
        "recorded",
        "unknown"
       ],
       "type": "string"
      },
      "size_scope_note": {
       "description": "Limits on size-specific claims",
       "type": "string"
      },
      "size_variants": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "case_size_mm": {
          "type": "number"
         },
         "name": {
          "type": "string"
         },
         "notes": {
          "additionalProperties": {
           "type": "string"
          },
          "description": "Edition, material and other qualifications",
          "type": "object"
         },
         "specs": {
          "additionalProperties": {
           "type": "string"
          },
          "description": "Verified size-specific specifications, keyed by label",
          "type": "object"
         },
         "unresolved_specs": {
          "description": "Labels with no verified size-specific value",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "name",
         "case_size_mm",
         "specs",
         "notes",
         "unresolved_specs"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "src": {
       "description": "Manufacturer reference",
       "format": "uri",
       "type": "string"
      },
      "take": {
       "type": "string"
      }
     },
     "required": [
      "brand",
      "name",
      "line",
      "date",
      "price",
      "case_sizes_mm",
      "size_data_status",
      "size_scope_note",
      "size_variants",
      "buy_links"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "_via",
   "count",
   "products"
  ],
  "type": "object"
 },
 "title": "Look up a product"
}
