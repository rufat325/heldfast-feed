{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update floorplan"
 },
 "description": "Update floorplan metadata (rename floor, reorder, set status). Requires floorplans:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "detection_error": {
    "description": "Error message if status=failed",
    "maxLength": 2000,
    "type": "string"
   },
   "floor_label": {
    "description": "New floor label",
    "maxLength": 200,
    "type": "string"
   },
   "floor_order": {
    "description": "New sort order",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "id": {
    "description": "Floorplan ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "status": {
    "description": "Detection status",
    "enum": [
     "pending",
     "detecting",
     "ready",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_floorplan",
 "title": "Update floorplan"
}
