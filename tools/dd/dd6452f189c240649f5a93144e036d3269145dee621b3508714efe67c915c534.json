{
 "description": "Pretty-print a SQL query for a given dialect. Offloads tedious reformatting.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dialect": {
    "default": "sql",
    "enum": [
     "sql",
     "mysql",
     "postgresql",
     "mariadb",
     "sqlite",
     "tsql",
     "plsql"
    ],
    "type": "string"
   },
   "keyword_case": {
    "default": "upper",
    "enum": [
     "upper",
     "lower",
     "preserve"
    ],
    "type": "string"
   },
   "sql": {
    "type": "string"
   }
  },
  "required": [
   "sql"
  ],
  "type": "object"
 },
 "name": "sql_format",
 "title": "Format SQL"
}
