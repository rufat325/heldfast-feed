{
 "description": "Paid invoice OCR ($0.13 USDC on Base): process complete PDF/image invoices up to 10 pages. Oversized PDFs are rejected before OCR.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "document_base64": {
    "maxLength": 13500000,
    "minLength": 4,
    "type": "string"
   },
   "document_url": {
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   },
   "expected": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "maxLength": 3,
      "minLength": 3,
      "type": "string"
     },
     "line_items": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "pattern": "^-?\\d+(?:\\.\\d{1,2})?$",
         "type": "string"
        },
        "description": {
         "maxLength": 300,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "description",
        "amount"
       ],
       "type": "object"
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
     },
     "purchase_order": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "subtotal": {
      "pattern": "^-?\\d+(?:\\.\\d{1,2})?$",
      "type": "string"
     },
     "supplier_name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "tax": {
      "pattern": "^-?\\d+(?:\\.\\d{1,2})?$",
      "type": "string"
     },
     "total": {
      "pattern": "^-?\\d+(?:\\.\\d{1,2})?$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "mime_type": {
    "enum": [
     "application/pdf",
     "image/png",
     "image/jpeg"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "invoice_preflight_10_pages",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
