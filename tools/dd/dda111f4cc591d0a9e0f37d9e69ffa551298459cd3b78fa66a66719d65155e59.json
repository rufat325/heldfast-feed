    },
    "type": "array"
   },
   "invoice": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "type": [
       "string",
       "null"
      ]
     },
     "line_items": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "type": "string"
        },
        "description": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "description",
        "amount"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "number": {
      "type": [
       "string",
       "null"
      ]
     },
     "purchase_order": {
      "type": [
       "string",
       "null"
      ]
     },
     "subtotal": {
      "type": [
       "string",
       "null"
      ]
     },
     "supplier_name": {
      "type": [
       "string",
       "null"
      ]
     },
     "tax": {
      "type": [
       "string",
       "null"
      ]
     },
     "total": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "number",
     "supplier_name",
     "purchase_order",
     "currency",
     "subtotal",
     "tax",
     "total",
     "line_items"
