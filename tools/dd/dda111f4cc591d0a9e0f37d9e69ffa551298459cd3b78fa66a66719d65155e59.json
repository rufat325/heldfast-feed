       "type": "string"
      },
      "calculated": {
       "type": "string"
      },
      "expected": {
       "type": "string"
      },
      "field": {
       "type": "string"
      },
      "status": {
       "enum": [
        "match",
        "discrepancy",
        "needs_review"
       ],
       "type": "string"
      }
     },
     "required": [
      "field",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "decision": {
    "enum": [
     "match",
     "discrepancy",
     "needs_review"
    ],
    "type": "string"
   },
   "evidence": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "field": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "field",
      "source",
      "text"
     ],
