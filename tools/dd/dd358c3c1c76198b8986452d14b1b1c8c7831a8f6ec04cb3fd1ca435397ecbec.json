{
 "description": "Preview or apply in-repo refactor sync to architector data (no workspace access). Default dryRun=true. Workflow: (1) scan with file/text to list hits, (2) build 1-3 mutation ops, (3) dryRun preview, (4) apply with dryRun=false and confirm=true. Mutations: move-file, replace-path-prefix, rename-text, patch-entry, merge-files, remove-file-ref. Orphan entries with empty refs.files and no entryIds are deleted. Does not change module names or dataFlow.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "description": "Required true when dryRun=false",
    "type": "boolean"
   },
   "dryRun": {
    "description": "Preview only (default true). Set false with confirm=true to apply",
    "type": "boolean"
   },
   "limit": {
    "description": "Max changes/hits per page (default 15, max 50)",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset (default 0)",
    "type": "number"
   },
   "operations": {
    "description": "Refactor operations (max 10 per call)",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "file": {
         "type": "string"
        },
        "text": {
         "type": "string"
        },
        "type": {
         "const": "scan",
         "type": "string"
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "from": {
         "type": "string"
        },
        "to": {
         "type": "string"
        },
        "type": {
         "const": "move-file",
         "type": "string"
        }
       },
       "required": [
        "type",
        "from",
        "to"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "fromPrefix": {
         "type": "string"
        },
        "toPrefix": {
         "type": "string"
        },
        "type": {
         "const": "replace-path-prefix",
         "type": "string"
        }
       },
       "required": [
        "type",
        "fromPrefix",
        "toPrefix"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "fields": {
         "items": {
          "enum": [
           "title",
           "summary",
           "tags",
           "payload",
           "usageExamples"
          ],
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        },
        "from": {
         "type": "string"
        },
        "match": {
         "enum": [
          "exact",
          "contains"
         ],
         "type": "string"
        },
        "to": {
         "type": "string"
        },
        "type": {
         "const": "rename-text",
         "type": "string"
        }
       },
       "required": [
        "type",
        "from",
        "to",
        "fields",
        "match"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "match": {
         "additionalProperties": false,
         "properties": {
          "id": {
           "type": "string"
          },
          "kind": {
           "type": "string"
          },
          "title": {
           "type": "string"
          }
         },
         "type": "object"
        },
        "set": {
         "additionalProperties": false,
         "properties": {
          "payload": {
           "additionalProperties": {},
           "type": "object"
          },
          "refs": {
           "additionalProperties": false,
           "properties": {
            "entryIds": {
             "items": {
              "type": "string"
             },
             "type": "array"
            },
            "files": {
             "items": {
              "type": "string"
             },
             "type": "array"
            },
            "moduleName": {
             "type": "string"
            }
           },
           "type": "object"
          },
          "summary": {
           "type": "string"
          },
          "tags": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "title": {
           "type": "string"
          }
         },
         "type": "object"
        },
        "type": {
         "const": "patch-entry",
         "type": "string"
        }
       },
       "required": [
        "type",
        "match",
        "set"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "from": {
         "items": {
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        },
        "to": {
         "type": "string"
        },
        "type": {
         "const": "merge-files",
         "type": "string"
        }
       },
       "required": [
        "type",
        "from",
        "to"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "deleteIfEmpty": {
         "type": "boolean"
        },
        "file": {
         "type": "string"
        },
        "type": {
         "const": "remove-file-ref",
         "type": "string"
        }
       },
       "required": [
        "type",
        "file"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "projectId": {
    "description": "Required. Call list-projects first (query by workspace folder name) and pass the matching projectId. Never omit. default-project is forbidden.",
    "minLength": 1,
    "type": "string"
   },
   "scope": {
    "additionalProperties": false,
    "description": "Optional filter: moduleName, kinds, tags",
    "properties": {
     "kinds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "moduleName": {
      "type": "string"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "projectId",
   "operations"
  ],
  "type": "object"
 },
 "name": "refactor-architecture",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "changes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "update",
        "delete"
       ],
       "type": "string"
      },
      "after": {},
      "before": {},
      "field": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "moduleName": {
       "type": "string"
      },
      "target": {
       "enum": [
        "entry",
        "module"
       ],
       "type": "string"
      }
     },
     "required": [
      "action",
      "target",
      "id",
      "field"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dryRun": {
    "type": "boolean"
   },
   "hasMore": {
    "type": "boolean"
   },
   "hits": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "field": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "moduleName": {
       "type": "string"
      },
      "snippet": {
       "type": "string"
      },
      "target": {
       "enum": [
        "entry",
        "module"
       ],
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "target",
      "field",
      "value",
      "snippet"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "offset": {
    "type": "number"
   },
   "stats": {
    "additionalProperties": false,
    "properties": {
     "entriesDeleted": {
      "type": "number"
     },
     "entriesUpdated": {
      "type": "number"
     },
     "hits": {
      "type": "number"
     },
     "modules": {
      "type": "number"
     }
    },
    "required": [
     "modules",
     "entriesUpdated",
     "entriesDeleted"
    ],
    "type": "object"
   },
   "summary": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "dryRun",
   "summary",
   "stats",
   "changes",
   "warnings",
   "offset",
   "hasMore"
  ],
  "type": "object"
 },
 "title": "Refactor Architecture"
}
