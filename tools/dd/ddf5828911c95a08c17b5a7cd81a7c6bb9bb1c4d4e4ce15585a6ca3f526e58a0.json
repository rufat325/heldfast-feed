{
 "description": "Run multiple analyses across a video set with partial success, item-level errors, and provenance. [~5-20s, scales with video count]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "analyses": {
    "items": {
     "enum": [
      "video_info",
      "transcript",
      "comments",
      "sentiment",
      "hook_patterns",
      "tag_title_patterns"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "commentsSampleSize": {
    "maximum": 200,
    "minimum": 1,
    "type": "number"
   },
   "dryRun": {
    "type": "boolean"
   },
   "transcriptMode": {
    "enum": [
     "summary",
     "key_moments",
     "full"
    ],
    "type": "string"
   },
   "videoIdsOrUrls": {
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "videoIdsOrUrls",
   "analyses"
  ],
  "type": "object"
 },
 "name": "analyzeVideoSet"
}
