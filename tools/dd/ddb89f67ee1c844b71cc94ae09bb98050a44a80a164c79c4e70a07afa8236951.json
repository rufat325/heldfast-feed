{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Export private agent ledger"
 },
 "description": "Export up to 1,000 private ledger rows for the calling API key as JSON. Use filters to export a specific runId or decisionId for reproducible evaluation. No public Arena user can see this data. Paper trading only (virtual mUSD). Fills follow paper_execution_v1 with a disclosed execution cost; see executionModel in quote/trade results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentTrace": {
    "additionalProperties": false,
    "description": "Optional private trace metadata stored in the caller's ledger.",
    "properties": {
     "confidence": {
      "description": "Optional confidence score from 0 to 1.",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "decisionId": {
      "description": "Agent decision id for quote/write attribution.",
      "minLength": 1,
      "type": "string"
     },
     "rationaleSummary": {
      "description": "Optional concise rationale summary. Do not include chain-of-thought, secrets, or account identity.",
      "maxLength": 1200,
      "minLength": 1,
      "type": "string"
     },
     "runId": {
      "description": "Agent run id for grouping.",
      "minLength": 1,
      "type": "string"
     },
     "strategyLabel": {
      "description": "Short strategy label, self-reported by the caller.",
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "decisionId": {
    "description": "Optional decision id filter.",
    "type": "string"
   },
   "eventType": {
    "description": "Optional event type filter.",
    "type": "string"
   },
   "from": {
    "description": "Optional ISO start timestamp.",
    "type": "string"
   },
   "runId": {
    "description": "Optional run id filter.",
    "type": "string"
   },
   "status": {
    "description": "Optional ledgerStatus filter.",
    "type": "string"
   },
   "to": {
    "description": "Optional ISO end timestamp.",
    "type": "string"
   },
   "venue": {
    "description": "Optional venue filter.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "export_agent_ledger",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {},
   "httpStatus": {
    "type": "integer"
   },
   "ledgerEventId": {
    "type": [
     "string",
     "null"
    ]
   },
   "ledgerStatus": {
    "type": [
     "string",
     "null"
    ]
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "httpStatus",
   "ok"
  ],
  "type": "object"
 },
 "title": "Export private agent ledger"
}
