{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get wallet portfolio"
 },
 "description": "Get a wallet's Fabrica portfolio: properties owned (paged), active loans (as borrower or lender), marketplace orders, credit history, and total portfolio value. Counts and totals always cover the whole wallet.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Ethereum wallet address (0x...)",
    "type": "string"
   },
   "limit": {
    "description": "Max properties to list (default 50, max 200)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Properties to skip, for paging (propertiesPage.nextOffset)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_portfolio",
 "title": "Get wallet portfolio"
}
