{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "studio.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Prepare a signed file upload"
 },
 "description": "Creates an HTTPS POST upload capability bound to the user, project, role, exact file metadata and SHA-256, expiring in 15 minutes. Returns uploadUrl, uploadToken, method and expiresAt. The upload accepts raw bytes with the declared MIME Content-Type; attachment status is confirmed separately. No file bytes pass through MCP and no generation credits are spent.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contentHash": {
    "description": "SHA-256 of the exact file bytes. The signed capability binds these bytes and cannot attach another file.",
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "mimeType": {
    "description": "The file MIME type.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "File name, not a local path.",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "description": "The project receiving the file. Required for song, Artist DNA (artist is derived from the project) and reference attachment; no project is selected implicitly.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "purpose": {
    "description": "The customer file role; this never selects a paid generation.",
    "enum": [
     "song",
     "artist_photo",
     "reference"
    ],
    "type": "string"
   },
   "size": {
    "maximum": 67108864,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "projectId",
   "purpose",
   "name",
   "mimeType",
   "size",
   "contentHash"
  ],
  "type": "object"
 },
 "name": "studio_media_upload_url",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": true,
    "properties": {
     "expiresAt": {
      "type": "string"
     },
     "method": {
      "enum": [
       "POST"
      ]
     },
     "uploadToken": {
      "type": "string"
     },
     "uploadUrl": {
      "type": "string"
     }
    },
    "required": [
     "uploadUrl",
     "uploadToken",
     "method",
     "expiresAt"
    ],
    "type": "object"
   },
   {
    "additionalProperties": true,
    "properties": {
     "code": {
      "type": "string"
     },
     "issues": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "field": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       },
       "required": [
        "field",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "message": {
      "type": "string"
     },
     "outcomeUnknown": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "studio.write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Prepare a signed file upload"
}
