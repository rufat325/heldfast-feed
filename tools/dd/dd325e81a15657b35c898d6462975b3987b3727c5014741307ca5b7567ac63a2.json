  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Set a custom status message with optional emoji icon and auto-clear time",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "clearAt": {
    "description": "Unix timestamp when the message should auto-clear (null = never)",
    "type": "number"
   },
   "message": {
    "description": "Custom status message text",
    "type": "string"
   },
   "statusIcon": {
    "description": "Status emoji icon (e.g. \"\u2615\", \"\ud83c\udfe0\", \"\ud83e\udd12\")",
    "type": "string"
   }
  },
  "required": [
   "message"
  ],
  "type": "object"
 },
 "name": "set_user_status_message",
 "title": "Set User Status Message"
}
