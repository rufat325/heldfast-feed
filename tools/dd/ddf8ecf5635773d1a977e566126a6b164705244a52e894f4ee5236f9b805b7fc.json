{
 "description": "Public/bank/school holidays for a country and year, with optional region (US-CA \u2192 region=CA) and type filter.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "description": "ISO 3166-1 alpha-2, e.g. US, DE, JP",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "region": {
    "maxLength": 10,
    "type": "string"
   },
   "types": {
    "description": "comma list: public,bank,school,optional,observance",
    "type": "string"
   },
   "year": {
    "maximum": 2100,
    "minimum": 1900,
    "type": "integer"
   }
  },
  "required": [
   "country",
   "year"
  ],
  "type": "object"
 },
 "name": "holidays",
 "title": "Public holidays (200+ countries)"
}
