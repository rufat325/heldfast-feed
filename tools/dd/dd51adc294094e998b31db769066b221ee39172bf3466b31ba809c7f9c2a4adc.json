      "enum": [
       "png",
       "jpeg",
       "webp",
       "gif",
       "tiff",
       "bmp",
       "ico",
       "avif"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Output format (default: the input's; ICO in, PNG out).",
    "title": "Format"
   },
   "gravity": {
    "default": "center",
    "description": "cover: the part to keep (default center; north, southeast, ...).",
    "enum": [
     "center",
     "north",
     "south",
     "east",
     "west",
     "northwest",
     "northeast",
     "southwest",
     "southeast"
    ],
    "title": "Gravity",
    "type": "string"
   },
   "image_base64": {
    "anyOf": [
     {
      "maxLength": 13333464,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The image as standard or url-safe base64 (at most 10 MB decoded; a data:image/...;base64, prefix is fine); or use url.",
    "title": "Image Base64"
   },
   "output": {
    "default": "base64",
    "description": "base64 (default): the file comes back inline as base64. url: the file is stored for 24 hours and the reply carries a download link (url, expires_at, bytes, content_type, sha256) instead of the base64, which keeps the file out of your context window.",
    "enum": [
     "base64",
     "url"
    ],
    "title": "Output",
    "type": "string"
   },
   "quality": {
    "anyOf": [
     {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Encoder quality 1-100 (lossy formats).",
    "title": "Quality"
   },
   "sizes": {
    "description": "1-8 {width, height}.",
    "items": {
     "$ref": "#/$defs/ThumbSize"
    },
    "maxItems": 8,
    "minItems": 1,
    "title": "Sizes",
    "type": "array"
   },
   "upscale": {
    "default": false,
    "description": "Allow thumbnails larger than the input (default false).",
    "title": "Upscale",
    "type": "boolean"
   },
   "url": {
    "anyOf": [
     {
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Public http(s) URL of the image (at most 10 MB; private, internal and IP-literal hosts are refused); or use image_base64.",
    "title": "Url"
   }
  },
  "required": [
