    "default": true,
    "description": "Apply the EXIF orientation first.",
    "title": "Auto Orient",
    "type": "boolean"
   },
   "fit": {
    "default": "cover",
    "description": "cover (default: fill each size, cropping the overflow) or contain (fit inside, no crop).",
