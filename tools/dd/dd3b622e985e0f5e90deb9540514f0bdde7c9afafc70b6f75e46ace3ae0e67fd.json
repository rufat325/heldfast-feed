{
 "description": "Scored Solana pump.fun bonding-curve bursts from the last 1-24 hours: which graduated and how fast, the peak return, and the return under each exit rule with 2.5% round-trip costs. Data rewritten every 20 s; data older than 120 s is refused with a 503 and not charged. Costs $0.02 USDC per call (x402).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hours": {
    "description": "Look-back window in hours, 1-24 (default 24)",
    "maximum": 24,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "sol_bursts_history",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ageSec": {
    "type": "number"
   },
   "bursts": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "chain": {
    "type": "string"
   },
   "generatedAt": {
    "type": "number"
   },
   "rule": {
    "type": "string"
   },
   "schemaVersion": {
    "type": "number"
   },
   "solUsd": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "required": [
   "chain",
   "schemaVersion",
   "generatedAt",
   "ageSec",
   "solUsd",
   "bursts"
  ],
  "type": "object"
 }
}
