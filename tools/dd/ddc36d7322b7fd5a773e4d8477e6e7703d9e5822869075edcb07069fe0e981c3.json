{
 "description": "Submit multiple coding tasks as a batch to the local LLM. Tasks are processed sequentially or in parallel. Supports partial failure.",
 "inputSchema": {
  "properties": {
   "sequential": {
    "description": "Process tasks sequentially, passing previous result as context (default: false)",
    "type": "boolean"
   },
   "tasks": {
    "description": "Array of tasks (1-10)",
    "items": {
     "properties": {
      "category": {
       "enum": [
        "coding",
        "coding-agent",
        "japanese-text",
        "japanese-coding",
        "translation",
        "summarization",
        "general"
       ],
       "type": "string"
      },
      "context": {
       "description": "Additional context (optional)",
       "type": "string"
      },
      "language": {
       "description": "Programming language (optional)",
       "type": "string"
      },
      "model": {
       "description": "Model override (optional)",
       "type": "string"
      },
      "output_format": {
       "enum": [
        "code",
        "diff",
        "explanation",
        "raw"
       ],
       "type": "string"
      },
      "task": {
       "description": "The task to perform",
       "type": "string"
      }
     },
     "required": [
      "task"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tasks"
  ],
  "type": "object"
 },
 "name": "batch_offload"
}
