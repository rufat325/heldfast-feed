    "description": "Language of the `why` lines.",
    "enum": [
     "en",
     "ru"
    ],
    "type": "string"
   },
   "n": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
