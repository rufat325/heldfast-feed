{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Price history of a product, to judge whether a discount is real: min/avg/max in BRL, number of records and up to 30 dated prices. Says so when prices span fewer than 3 different days (not enough history to judge). Content in Brazilian Portuguese.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "period": {
    "default": "30d",
    "enum": [
     "30d",
     "90d",
     "1y"
    ],
    "type": "string"
   },
   "product_id": {
    "description": "Product id, the UUID in https://pechincha.ai/produto/<id>/<slug>",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "product_id"
  ],
  "type": "object"
 },
 "name": "get_price_history",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "history": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "enough_history": {
        "description": "false when prices span fewer than 3 different days",
        "type": "boolean"
       },
       "period": {
        "type": "string"
       },
       "prices": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "date": {
           "description": "ISO 8601",
           "type": "string"
          },
          "price": {
           "description": "BRL",
           "type": [
            "number",
            "null"
           ]
          }
         },
         "required": [
          "date",
          "price"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "product_id": {
        "type": "string"
       },
       "product_name": {
        "type": "string"
       },
       "stats": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "avg": {
            "description": "BRL",
            "type": [
             "number",
             "null"
            ]
           },
           "max": {
            "description": "BRL",
            "type": [
             "number",
             "null"
            ]
           },
           "min": {
            "description": "BRL",
            "type": [
             "number",
             "null"
            ]
           },
           "records": {
            "type": "integer"
           }
          },
          "required": [
           "min",
           "avg",
           "max",
           "records"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "product_id",
       "product_name",
       "period",
       "stats",
       "enough_history",
       "prices",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "null when the product does not exist"
   }
  },
  "required": [
   "history"
  ],
  "type": "object"
 },
 "title": "Get price history"
}
