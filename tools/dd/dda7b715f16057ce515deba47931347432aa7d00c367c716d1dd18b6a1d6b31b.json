{
 "description": "Run a leader election for a swarm",
 "inputSchema": {
  "properties": {
   "candidates": {
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "mode": {
    "default": "majority",
    "enum": [
     "majority",
     "bft"
    ],
    "type": "string"
   },
   "swarmId": {
    "type": "string"
   },
   "termHint": {
    "description": "Optional optimistic concurrency hint.",
    "type": "integer"
   },
   "x402": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "swarmId",
   "candidates"
  ],
  "type": "object"
 },
 "name": "arbiter_election_run"
}
