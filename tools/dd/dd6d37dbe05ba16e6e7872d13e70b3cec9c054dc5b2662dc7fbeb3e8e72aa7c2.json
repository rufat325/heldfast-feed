{
 "description": "Create a new artist in the workspace. Returns the artist ID for use in tap_create_campaign.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apple_music_url": {
    "description": "Apple Music artist URL",
    "format": "uri",
    "type": "string"
   },
   "bio": {
    "description": "Short bio (max 2000 chars)",
    "maxLength": 2000,
    "type": "string"
   },
   "genre": {
    "description": "Primary genre",
    "maxLength": 120,
    "type": "string"
   },
   "instagram": {
    "description": "Instagram handle (without @)",
    "maxLength": 120,
    "type": "string"
   },
   "name": {
    "description": "Artist name",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "spotify_url": {
    "description": "Spotify artist URL",
    "format": "uri",
    "type": "string"
   },
   "twitter": {
    "description": "Twitter/X handle (without @)",
    "maxLength": 120,
    "type": "string"
   },
   "website": {
    "description": "Artist website",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "tap_create_artist"
}
