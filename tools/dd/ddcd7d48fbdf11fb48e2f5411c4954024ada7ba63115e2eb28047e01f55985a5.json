{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Ask a human: create returns one link per respondent to give to them (each answers once in a browser). read\nreturns answers; pass answered (previous count) with wait_seconds up to 30 to wait for more, or omit it to wait\nuntil complete. Links do not prove identity. Never ask for passwords, codes or payment details.","inputSchema":{"properties":{"action":{"enum":["create","read","delete"],"title":"Action","type":"string"},"answer_kind":{"anyOf":[{"enum":["yes_no","choice","text"],"type":"string"},{"type":"null"}],"default":null,"title":"Answer Kind"},"answered":{"anyOf":[{"maximum":20,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Answered"},"id":{"anyOf":[{"pattern":"^[A-Za-z0-9_-]{16,64}$","type":"string"},{"type":"null"}],"default":null,"title":"Id"},"options":{"anyOf":[{"items":{"maxLength":100,"minLength":1,"type":"string"},"maxItems":10,"minItems":2,"type":"array"},{"type":"null"}],"default":null,"title":"Options"},"question":{"anyOf":[{"maxLength":2000,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Question"},"respondents":{"anyOf":[{"maximum":20,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Respondents"},"ttl_seconds":{"anyOf":[{"maximum":604800,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Ttl Seconds"},"wait_seconds":{"anyOf":[{"maximum":30,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Wait Seconds"}},"required":["action"],"title":"approvalArguments","type":"object"},"name":"approval"}
