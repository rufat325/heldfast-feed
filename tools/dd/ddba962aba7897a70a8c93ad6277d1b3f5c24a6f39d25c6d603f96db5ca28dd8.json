  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "volcano": {
    "description": "Optional. JMA volcano name in English (e.g. \"Sakurajima\", \"Asamayama\") or Japanese (e.g. \"\u685c\u5cf6\"), or the 3-digit JMA volcano code (e.g. \"506\"). Omit to list all volcanoes.",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
