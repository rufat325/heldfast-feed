{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Ask a question in plain English and get a synthesized answer with inline [n] citations, fused across sources with reciprocal rank fusion. Use this instead of library_ask when you want a cited answer rather than raw results. Every factual sentence is cited or dropped; an uncited or all-dropped answer is flagged in warnings[]. Requires OPENAI_API_KEY (or ALEXANDRIA_SYNTH_API_KEY). Set response_format: \"detailed\" for the full result set, routing, citation grades, and resolvability.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "max_sources": {
    "default": 6,
    "description": "Max number of sources to search (default 6)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Natural language question",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "read_top": {
    "default": 4,
    "description": "How many top full-text results to read and cite (default 4)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "response_format": {
    "default": "concise",
    "description": "concise (default) trims results/citations to high-signal fields; detailed returns the full payload, including routing reasons, scores, and stage diagnostics.",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "results_per_source": {
    "default": 5,
    "description": "Results to fetch per source (default 5)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "library_answer",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "answer": {
    "type": "string"
   },
   "citations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "grade": {
       "additionalProperties": false,
       "properties": {
        "signals": {
         "additionalProperties": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "tier": {
         "enum": [
          "A",
          "B",
          "C",
          "D"
         ],
         "type": "string"
        }
       },
       "required": [
        "tier",
        "signals"
       ],
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "n": {
       "type": "number"
      },
      "resolves": {
       "type": "boolean"
      },
      "source": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "via": {
       "const": "corpus",
       "type": "string"
      }
     },
     "required": [
      "n",
      "source",
      "id",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "cluster": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "downloadUrl": {
       "type": "string"
      },
      "hasFullText": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "language": {
       "type": "string"
      },
      "previewUrl": {
       "type": "string"
      },
      "published": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "source": {
       "type": "string"
      },
      "subjects": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "year": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "source",
      "title",
      "hasFullText",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "routing": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "query": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "required": [
      "source",
      "query",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "answer",
   "citations"
  ],
  "type": "object"
 },
 "title": "Answer With Cited Sources"
}
