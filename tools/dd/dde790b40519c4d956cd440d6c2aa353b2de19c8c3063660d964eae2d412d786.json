{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new PandaDoc document from an existing template.\n\nTemplates can contain fields, tokens (variables), pricing tables, images, and content placeholders.\nPre-fill field values, set recipients, and customize content when creating.\n\nWORKFLOW:\n1. Call list_templates to find the template ID\n2. Create the document with this tool (pre-fill fields/tokens as needed)\n3. Poll get_document_status until status is 'document.draft'\n4. Use send_document to send for signing\n\nRELATED TOOLS:\n- list_templates: Find available templates and their IDs\n- get_document_details: See all fields/tokens after creation\n- send_document: Send the created document",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fields": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "value": {
       "type": [
        "string",
        "number",
        "boolean"
       ]
      }
     },
     "required": [
      "value"
     ],
     "type": "object"
    },
    "description": "Map of field names to values: { \"FieldName\": { \"value\": \"text\" } }",
    "type": "object"
   },
   "folder_uuid": {
    "description": "Folder ID to store the document in (see list_document_folders)",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {
     "$ref": "#/properties/fields/additionalProperties/properties/value"
    },
    "description": "Custom key-value metadata to associate with the document",
    "type": "object"
   },
   "name": {
    "description": "Document name",
    "type": "string"
   },
   "pricing_tables": {
    "description": "Pricing tables to populate. Requires \"Automatically add products to this table\" enabled on the template pricing table. All product info must be passed here \u2014 products stored in PandaDoc cannot be used.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "data_merge": {
       "description": "If true, all field names in data rows must be the external names defined in the template",
       "type": "boolean"
      },
      "name": {
       "description": "Name of the pricing table in the template to populate",
       "type": "string"
      },
      "options": {
       "additionalProperties": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "type": "string"
         },
         "type": {
          "enum": [
           "percent",
           "absolute"
          ],
          "type": "string"
         },
         "value": {
          "type": "number"
         }
        },
        "required": [
         "type",
         "value"
        ],
        "type": "object"
       },
       "description": "Table options, e.g. { \"currency\": \"USD\", \"Discount\": { \"type\": \"percent\", \"name\": \"Global Discount\", \"value\": 10 } }",
       "properties": {
        "currency": {
         "pattern": "^[A-Z]{3}$",
         "type": "string"
        }
       },
       "type": "object"
      },
      "sections": {
       "description": "Pricing table sections with rows",
       "items": {
        "additionalProperties": false,
        "properties": {
         "default": {
          "description": "If true, this is the default section",
          "type": "boolean"
         },
         "multichoice_enabled": {
          "description": "If true, recipients can pick rows in this section",
          "type": "boolean"
         },
         "rows": {
          "description": "Rows to populate in this section",
          "items": {
           "additionalProperties": false,
           "properties": {
            "custom_fields": {
             "additionalProperties": {
              "$ref": "#/properties/fields/additionalProperties/properties/value"
             },
             "description": "Additional custom column values",
             "type": "object"
            },
            "data": {
             "additionalProperties": {
              "anyOf": [
               {
                "$ref": "#/properties/fields/additionalProperties/properties/value"
               },
               {
                "$ref": "#/properties/pricing_tables/items/properties/options/additionalProperties"
               }
              ]
             },
             "description": "Row values keyed by column name, e.g. { \"Name\": \"Widget\", \"Price\": 10, \"QTY\": 3, \"SKU\": \"widget-1\" }",
             "type": "object"
            },
            "options": {
             "additionalProperties": false,
             "description": "Row options (editable qty, optional row, pre-selected)",
             "properties": {
              "multichoice_selected": {
               "type": "boolean"
              },
              "optional": {
               "type": "boolean"
              },
              "optional_selected": {
               "type": "boolean"
              },
              "qty_editable": {
               "type": "boolean"
              }
             },
             "type": "object"
            }
           },
           "type": "object"
          },
          "type": "array"
         },
         "title": {
          "description": "Section title",
          "type": "string"
         }
        },
        "required": [
         "title"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "recipients": {
    "description": "Document recipients (at least one required)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "email": {
       "description": "Recipient email",
       "format": "email",
       "type": "string"
      },
      "first_name": {
       "description": "Recipient first name",
       "type": "string"
      },
      "last_name": {
       "description": "Recipient last name",
       "type": "string"
      },
      "role": {
       "description": "Must match a role in the template",
       "type": "string"
      },
      "signing_order": {
       "description": "Order in signing sequence",
       "type": "number"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "tags": {
    "description": "Tags to apply",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "template_uuid": {
    "description": "Template ID (from list_templates or PandaDoc app URL)",
    "minLength": 1,
    "type": "string"
   },
   "tokens": {
    "description": "Template variables to pre-fill",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Token/variable name from template",
       "type": "string"
      },
      "value": {
       "description": "Value to fill in",
       "type": "string"
      }
     },
     "required": [
      "name",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "template_uuid",
   "recipients"
  ],
  "type": "object"
 },
 "name": "create_document_from_template"
}
