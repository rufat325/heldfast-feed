{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get a photo URL for a place. Use the photo name from a text search response. At least one of maxHeightPx or maxWidthPx should be specified.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "maxHeightPx": {
    "description": "Maximum height in pixels (1-4800)",
    "maximum": 4800,
    "minimum": 1,
    "type": "number"
   },
   "maxWidthPx": {
    "description": "Maximum width in pixels (1-4800)",
    "maximum": 4800,
    "minimum": 1,
    "type": "number"
   },
   "photoName": {
    "description": "The photo resource name from a text search response (format: places/PLACE_ID/photos/PHOTO_RESOURCE)",
    "type": "string"
   }
  },
  "required": [
   "photoName"
  ],
  "type": "object"
 },
 "name": "photo_get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "photoUri": {
    "description": "URL to the photo image",
    "type": "string"
   }
  },
  "required": [
   "photoUri"
  ],
  "type": "object"
 },
 "title": "Get Place Photo"
}
