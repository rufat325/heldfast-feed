{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Start booking (creates order + payment link)"
 },
 "description": "Create a booking and get a secure Stripe checkout URL for the customer to pay. For product_type=\"tour\": pass slug (from search_tours/get_service), selected_date (YYYY-MM-DD), pax, an optional option_id, and lead contact details. For product_type=\"transfer\": pass from, to, optional vehicle/category/pickup_at, pax, and lead details. The price is calculated server-side and returned with the checkout_url. Payment confirms the booking.",
 "inputSchema": {
  "properties": {
   "airline": {
    "description": "transfer: optional airline (airport transfers).",
    "type": "string"
   },
   "category": {
    "description": "transfer: e.g. \"Arrival Transfers\", \"Departure Transfers\" (default Arrival).",
    "type": "string"
   },
   "flight_number": {
    "description": "transfer: optional flight number.",
    "type": "string"
   },
   "from": {
    "description": "transfer: pickup location (airport / city / hotel).",
    "type": "string"
   },
   "lead_email": {
    "description": "Customer email (booking confirmation is sent here).",
    "type": "string"
   },
   "lead_first_name": {
    "description": "Customer first name.",
    "type": "string"
   },
   "lead_phone": {
    "description": "Customer phone (optional, E.164 preferred).",
    "type": "string"
   },
   "lead_surname": {
    "description": "Customer surname.",
    "type": "string"
   },
   "notes": {
    "description": "transfer: optional notes.",
    "type": "string"
   },
   "option_id": {
    "description": "tour: chosen option_id from get_service (optional \u2014 omit for the \"from\" price).",
    "type": "string"
   },
   "pax": {
    "description": "Number of guests/passengers (default 1).",
    "minimum": 1,
    "type": "integer"
   },
   "pickup_at": {
    "description": "transfer: pickup datetime (free text or ISO).",
    "type": "string"
   },
   "pickup_text": {
    "description": "tour: optional pickup location / hotel.",
    "type": "string"
   },
   "product_type": {
    "description": "What is being booked.",
    "enum": [
     "tour",
     "transfer"
    ],
    "type": "string"
   },
   "selected_date": {
    "description": "tour: travel date, YYYY-MM-DD (today or later).",
    "type": "string"
   },
   "selected_start_time": {
    "description": "tour: optional start time, e.g. \"09:00\".",
    "type": "string"
   },
   "slug": {
    "description": "tour: service slug from search_tours/get_service.",
    "type": "string"
   },
   "to": {
    "description": "transfer: drop-off location.",
    "type": "string"
   },
   "vehicle": {
    "description": "transfer: vehicle class (default \"Standard Car\").",
    "type": "string"
   }
  },
  "required": [
   "product_type",
   "lead_first_name",
   "lead_surname",
   "lead_email"
  ],
  "type": "object"
 },
 "name": "start_booking"
}
