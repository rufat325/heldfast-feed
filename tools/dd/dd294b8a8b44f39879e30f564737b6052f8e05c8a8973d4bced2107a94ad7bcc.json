{
 "description": "Fire one action immediately \u2014 no flow, no enrollment, no schedule.\nUseful for one-shot sends ('email this person right now') and testing\nactions before composing a flow.\n\nExample:\n  flow_run_now({\n    action: \"email\",\n    contact_email: \"mike@rocketopp.com\",\n    contact_id: \"abc123\",\n    params: { subject: \"Test\", body: \"Hello {{contact.email}}\" },\n    provider: \"crm\"\n  })",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "email",
     "sms",
     "slack",
     "tag_add",
     "webhook"
    ],
    "type": "string"
   },
   "contact_data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "contact_email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "contact_id": {
    "type": "string"
   },
   "location_id": {
    "type": "string"
   },
   "params": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "provider": {
    "type": "string"
   }
  },
  "required": [
   "action",
   "contact_email",
   "params"
  ],
  "type": "object"
 },
 "name": "flow_run_now"
}
