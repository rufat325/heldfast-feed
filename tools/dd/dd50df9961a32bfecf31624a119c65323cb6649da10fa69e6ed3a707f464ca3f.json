{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Buy a stock token with USDG or sell one back to USDG, from your account (or your vault). Signs locally, the rail relays it, the chain enforces your ceiling. With confirm=false it only tells you what would happen.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "description": "buy: USDG to spend; sell: tokens to sell",
    "type": "string"
   },
   "confirm": {
    "description": "default true. false = dry run",
    "type": "boolean"
   },
   "side": {
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "slippageBps": {
    "description": "default 100 (1%)",
    "maximum": 1000,
    "minimum": 10,
    "type": "integer"
   },
   "symbol": {
    "type": "string"
   },
   "via": {
    "enum": [
     "account",
     "vault"
    ],
    "type": "string"
   }
  },
  "required": [
   "side",
   "symbol",
   "amount"
  ],
  "type": "object"
 },
 "name": "metamuse_trade",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "executed": {
    "type": "boolean"
   },
   "explorer": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "quote": {},
   "receipts": {},
   "transaction": {
    "type": "string"
   }
  },
  "required": [
   "executed",
   "quote"
  ],
  "type": "object"
 },
 "title": "Trade"
}
