{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update NTP client settings on a MikroTik router. Idempotent: returns already_set if no changes are needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": false,
    "description": "Preview changes without applying.",
    "type": "boolean"
   },
   "enabled": {
    "description": "Enable or disable the NTP client",
    "type": "boolean"
   },
   "mode": {
    "description": "NTP client mode",
    "enum": [
     "unicast",
     "broadcast",
     "multicast",
     "manycast"
    ],
    "type": "string"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "servers": {
    "description": "Comma-separated NTP server addresses",
    "type": "string"
   },
   "vlanInterface": {
    "description": "VLAN interface for NTP communication",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "manage_ntp_client",
 "title": "Manage NTP Client"
}
