{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Free validation of a locally built execution declaration before issuance. Hash exact input and output bytes locally; supply identifiers and UTC timestamps with milliseconds. Returns the validated event, commitment and logical chain without creating or purchasing a receipt. Use issue_agent_receipt only if a portable signed declaration is needed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "event": {
    "additionalProperties": false,
    "description": "Commitment-only declaration of one execution step.",
    "properties": {
     "agentId": {
      "description": "Identifier of the declaring agent, not an independently verified identity.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "completedAt": {
      "description": "Declared completion in UTC with milliseconds, at or after start.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
     },
     "inputHash": {
      "additionalProperties": false,
      "description": "SHA-256 of the exact input bytes, computed locally. Never send raw input.",
      "properties": {
       "algorithm": {
        "const": "sha256",
        "description": "Hash algorithm.",
        "type": "string"
       },
       "digest": {
        "description": "64 lowercase hexadecimal characters; SHA-256 of exact bytes.",
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "algorithm",
       "digest"
      ],
      "type": "object"
     },
     "outcome": {
      "description": "Outcome declared by the caller; Datoka does not observe execution.",
      "enum": [
       "success",
       "error"
      ],
      "type": "string"
     },
     "outputHash": {
      "additionalProperties": false,
      "description": "SHA-256 of exact output bytes, computed locally. Never send raw output.",
      "properties": {
       "algorithm": {
        "const": "sha256",
        "description": "Hash algorithm.",
        "type": "string"
       },
       "digest": {
        "description": "64 lowercase hexadecimal characters; SHA-256 of exact bytes.",
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "algorithm",
       "digest"
      ],
      "type": "object"
     },
     "runId": {
      "description": "Stable identifier for this execution run.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "startedAt": {
      "description": "Declared start time in UTC, with milliseconds.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
     },
     "stepId": {
      "description": "Stable identifier of the step within the run.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "tool": {
      "description": "Tool or operation identifier declared by the caller.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "version": {
      "const": "datoka.agent.execution.v1",
      "description": "Declaration format version; preserve this literal.",
      "type": "string"
     }
    },
    "required": [
     "version",
     "agentId",
     "runId",
     "stepId",
     "tool",
     "outcome",
     "startedAt",
     "completedAt",
     "inputHash",
     "outputHash"
    ],
    "type": "object"
   }
  },
  "required": [
   "event"
  ],
  "type": "object"
 },
