{
 "description": "Configure the Agent Wallet spend policy. Sets a daily limit, per-transaction cap, and optional recipient allowlist. The policy is enforced in-process for the lifetime of the MCP server.",
 "inputSchema": {
  "properties": {
   "allowedRecipients": {
    "description": "Allowlisted recipient addresses",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dailyLimitEth": {
    "description": "Daily spend limit in ETH-equivalent (e.g. \"0.1\")",
    "type": "string"
   },
   "perTxCapEth": {
    "description": "Per-tx cap in ETH-equivalent (e.g. \"0.01\")",
    "type": "string"
   },
   "scopeKey": {
    "description": "Optional session/scope key (default: \"global\")",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "set_spend_policy"
}
