{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "List the pages of Site A (sitemap, robots.txt, or crawl), mapped onto Site B when given. Paid in USDC (the 402 challenge names the network), or from a prepaid balance when the request carries Authorization: Bearer dck_\u2026: 0.05 USD per call. Answers with pages (sourceUrl, targetUrl, path) and strategy.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxPages": {
    "description": "Stop after this many pages.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "sitemapUrl": {
    "description": "Sitemap to read instead of the fallbacks.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "sourceUrl": {
    "description": "Site A (full URL).",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "targetUrl": {
    "description": "Site B; pages are mapped onto it when given.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "sourceUrl"
  ],
  "type": "object"
 },
 "name": "discover_pages",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "sourceUrl": {
       "type": "string"
      },
      "targetUrl": {
       "type": "string"
      }
     },
     "required": [
      "sourceUrl",
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "payment": {
    "additionalProperties": false,
    "properties": {
     "amount": {
      "type": "string"
     },
     "balance": {
      "type": "string"
     },
     "currency": {
      "const": "USD",
      "type": "string"
     },
     "rail": {
      "const": "prepaid",
      "type": "string"
     }
    },
    "required": [
     "amount",
     "currency",
     "rail",
     "balance"
    ],
    "type": "object"
   },
   "strategy": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Discover pages"
}
