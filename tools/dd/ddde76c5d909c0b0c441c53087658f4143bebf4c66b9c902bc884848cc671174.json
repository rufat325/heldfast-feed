{
 "_meta": {
  "openai/outputTemplate": "ui://widget/shortlist.html",
  "openai/toolInvocation/invoked": "Shortlist requested",
  "openai/toolInvocation/invoking": "Sending your shortlist request\u2026",
  "openai/widgetAccessible": false,
  "ui": {
   "resourceUri": "ui://widget/shortlist.html",
   "visibility": [
    "model"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Request a Vetted Engineer Shortlist"
 },
 "description": "Ask Ruzora for a shortlist of vetted senior engineers in Latin America for a role (ideally from a role scorecard). A vetted shortlist within 72 hours; profiles are blind until an agreement is signed. Needs a work email. Sends the name, email and company given to Ruzora.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "buyer_token": {
    "description": "Proof the user verified this work email: the buyer_token from confirm_work_email (valid 7 days). No token yet? Call verify_work_email first.",
    "maxLength": 1024,
    "type": "string"
   },
   "company": {
    "description": "Company name",
    "maxLength": 200,
    "type": "string"
   },
   "engineers": {
    "description": "How many engineers (default 1)",
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "full_name": {
    "description": "Hiring manager full name",
    "maxLength": 160,
    "type": "string"
   },
   "notes": {
    "description": "Context: what they will own, time-zone needs, the role scorecard summary",
    "maxLength": 2000,
    "type": "string"
   },
   "preferred_skills": {
    "description": "Nice-to-have skills (ranking only)",
    "items": {
     "maxLength": 60,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "required_skills": {
    "description": "Must-have skills only (hard filter), e.g. [\"Python\", \"Postgres\"]",
    "items": {
     "maxLength": 60,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "role": {
    "description": "Role title, e.g. \"Senior backend engineer\"",
    "maxLength": 200,
    "type": "string"
   },
   "seniority": {
    "description": "Seniority: mid (3-5 years), senior (5-8 years) or staff (8+ years, lead)",
    "enum": [
     "mid",
     "senior",
     "staff"
    ],
    "type": "string"
   },
   "timeline": {
    "description": "When they should start, e.g. \"within a month\"",
    "maxLength": 100,
    "type": "string"
   },
   "work_email": {
    "description": "Work email (personal inboxes are refused). The shortlist goes here.",
    "format": "email",
    "maxLength": 254,
    "type": "string"
   }
  },
  "required": [
   "full_name",
   "work_email",
   "company",
   "role",
   "seniority"
  ],
  "type": "object"
 },
 "name": "request_vetted_shortlist",
 "title": "Request a Vetted Engineer Shortlist"
}
