{
 "description": "Upload a local audio recording of a clinical encounter and get back a SOAP note. Short recordings return immediately; long ones process asynchronously \u2014 by default this tool waits and returns the finished note. Supported: mp3, m4a, wav, ogg, webm, flac.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audio_path": {
    "description": "Absolute path to a local audio file (mp3/m4a/wav/ogg/webm/flac).",
    "type": "string"
   },
   "custom_instructions": {
    "type": "string"
   },
   "include_billing_codes": {
    "type": "boolean"
   },
   "include_icd11": {
    "type": "boolean"
   },
   "include_patient_summary": {
    "type": "boolean"
   },
   "include_transcript": {
    "description": "Return the diarized, timestamped transcript.",
    "type": "boolean"
   },
   "patient": {
    "additionalProperties": false,
    "description": "Optional patient demographics & history to enrich the note.",
    "properties": {
     "age": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "allergies": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "gender": {
      "type": "string"
     },
     "medical_history": {
      "type": "string"
     },
     "medications": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "patient_history": {
    "type": "string"
   },
   "specialty": {
    "description": "Medical specialty. Call list_specialties for the full list.",
    "enum": [
     "nurse_practitioner",
     "physician",
     "psychiatrist",
     "psychotherapist",
     "physical_therapy",
     "occupational_therapy",
     "chiropractor",
     "dentist",
     "acupuncture",
     "social_worker",
     "registered_nurse",
     "slp",
     "veterinary",
     "massage_therapy",
     "pharmacy",
     "podiatrist",
     "dietitian_nutritionist",
     "athletic_trainer",
     "aroma_therapy",
     "exercise_therapy",
     "ems",
     "paramedic",
     "genetic_counselling",
     "generic"
    ],
    "type": "string"
   },
   "template": {
    "type": "string"
   },
   "timeout_seconds": {
    "default": 300,
    "description": "Max seconds to wait when polling an async job (default 300).",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait_for_completion": {
    "default": true,
    "description": "If true (default), poll until the note is ready for long async recordings.",
    "type": "boolean"
   }
  },
  "required": [
   "audio_path",
   "specialty"
  ],
  "type": "object"
 },
 "name": "transcribe_audio_to_soap",
 "title": "Audio recording \u2192 SOAP note"
}
