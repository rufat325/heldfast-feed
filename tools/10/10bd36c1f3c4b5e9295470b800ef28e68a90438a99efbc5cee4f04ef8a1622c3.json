  "title": "List a wallet's registrations"
 },
 "description": "List the registrations a wallet holds\n\nThe registrations held by a wallet, without signing in. Only the wallet's 100 most recently minted registrations are considered; `limit`/`offset` page within those and `total` never exceeds 100. Each row has a v3 `id` (`crown-{symbol}-{chainKey}-{tokenId}`), `chainId`, `tokenId`, `tokenAddress` and `isActive`. Caveats: `mintTimestamp` is the time of your request, not the mint; `caip2` is always written `eip155:{chainId}`, even for Solana (chain id 900900/900901); `owner` echoes the address you sent. Response is wrapped in `{success, data, timestamp}`.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "EVM address (`0x` + 40 hex) or Solana address",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 200,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "type": "integer"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
