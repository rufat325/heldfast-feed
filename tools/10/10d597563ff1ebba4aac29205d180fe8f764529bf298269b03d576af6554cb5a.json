{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List a project's strings"
 },
 "description": "Use this when someone asks to see the translation strings in a project, optionally in one language or for one key. Returns up to 100 phrases with id, key, language and value, plus the total count. Not for finding strings by the words they contain.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "description": "Only this exact key",
    "maxLength": 256,
    "type": "string"
   },
   "language": {
    "description": "Only strings in this locale code, such as en, it or pt-BR",
    "maxLength": 35,
    "type": "string"
   },
   "project": {
    "description": "Project name; an id matches nothing",
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "name": "list_phrases",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "phraseCount": {
    "minimum": 0,
    "type": "integer"
   },
   "phrases": {
    "description": "Up to 100 phrases, one row per key and language, values cut to 2,000 characters; phraseCount has the total",
    "items": {
     "additionalProperties": false,
     "properties": {
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "key": {
       "maxLength": 256,
       "type": "string"
      },
      "language": {
       "maxLength": 35,
       "type": "string"
      },
      "lastEditTime": {
       "$ref": "#/properties/phrases/items/properties/creationTime"
      },
      "machineTranslated": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "projects": {
       "items": {
        "maxLength": 128,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "value": {
       "maxLength": 2000,
       "type": "string"
      },
      "valueTruncated": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "key",
      "language",
      "value",
      "valueTruncated",
      "machineTranslated",
      "projects",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "phrasesTruncated": {
    "type": "boolean"
   },
   "status": {
    "enum": [
     "found",
     "empty"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "phraseCount",
   "phrasesTruncated",
   "phrases"
  ],
  "type": "object"
 },
 "title": "List a project's strings"
}
