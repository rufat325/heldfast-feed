  "readOnlyHint": false,
  "title": "Set inbound box information"
 },
 "description": "ACTION. Registra le SCATOLE del piano inbound FBA (dopo il packing confermato): per ogni packing group, le scatole con dimensioni in CM, peso in KG, quantit\u00e0 di scatole identiche e contenuto (SKU+quantit\u00e0 per scatola, salvo content_source diverso). Passo obbligatorio PRIMA di generare le opzioni di placement. Chiedi all'utente dimensioni/peso reali: Amazon le verifica in ricezione.",
 "inputSchema": {
  "properties": {
   "account_id": {
    "description": "ID dell'outpost Amazon (= un seller su uno specifico marketplace; vedi list_clients). Opzionale se il token \u00e8 legato a un solo outpost.",
    "type": [
     "string",
     "number"
    ]
   },
   "confirm_id": {
    "description": "Token di conferma ritornato dall'anteprima. Ripassa lo STESSO payload + confirm_id per eseguire davvero la scrittura.",
    "type": "string"
   },
   "groupings": {
    "items": {
     "properties": {
      "boxes": {
       "items": {
        "properties": {
         "content_source": {
          "description": "BOX_CONTENT_PROVIDED (default) | MANUAL_PROCESS | BARCODE_2D",
          "type": "string"
         },
         "height_cm": {
          "type": "number"
         },
         "items": {
          "items": {
           "properties": {
            "quantity": {
             "type": "number"
            },
            "sku": {
             "type": "string"
            }
           },
           "required": [
            "sku",
            "quantity"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "length_cm": {
          "type": "number"
         },
         "quantity": {
          "description": "Scatole identiche (default 1)",
          "type": "number"
         },
         "weight_kg": {
          "type": "number"
         },
         "width_cm": {
          "type": "number"
         }
        },
        "required": [
         "length_cm",
         "width_cm",
         "height_cm",
         "weight_kg"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "packing_group_id": {
       "type": "string"
      },
      "shipment_id": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "inbound_plan_id": {
    "type": "string"
   }
  },
  "required": [
