{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Arrange user-provided candidate steps into a time-bounded plan with checkpoints. The tool organizes steps and does not invent expert recommendations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "candidateSteps": {
    "description": "Candidate actions already identified by the user or agent.",
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 15,
    "minItems": 1,
    "type": "array"
   },
   "constraints": {
    "default": [],
    "description": "Constraints the plan must respect.",
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "currentState": {
    "description": "A concise description of the current situation.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "goal": {
    "description": "The outcome the user wants to move toward.",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "horizonDays": {
    "default": 30,
    "description": "Planning horizon in days.",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "goal",
   "currentState",
   "candidateSteps"
  ],
  "type": "object"
 },
 "name": "build_action_plan",
 "title": "Build an Action Plan"
}
