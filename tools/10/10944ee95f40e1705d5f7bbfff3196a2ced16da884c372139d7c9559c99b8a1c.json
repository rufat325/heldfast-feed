c_document"],"type":"object"},"name":"hometax__tax__withholding__regular_report__basic_save","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\ud648\ud0dd\uc2a4 \uc6d0\ucc9c\uc138 \uc815\uae30\uc2e0\uace0 \uae30\ubcf8\uc815\ubcf4 \uc800\uc7a5"}
