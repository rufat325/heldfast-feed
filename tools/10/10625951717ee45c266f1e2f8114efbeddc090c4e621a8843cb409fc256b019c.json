{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Free input/price preflight before a paid endpoint invocation. No target fetch, demand or payment.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "capability_id": {
    "maxLength": 100,
    "type": "string"
   },
   "client": {
    "additionalProperties": false,
    "properties": {
     "agent_id": {
      "maxLength": 100,
      "type": "string"
     },
     "requester_id": {
      "maxLength": 100,
      "type": "string"
     },
     "wallet": {
      "maxLength": 100,
      "type": "string"
     }
    },
    "type": "object"
   },
   "economics": {
    "additionalProperties": false,
    "properties": {
     "bounty_intent": {
      "type": "boolean"
     },
     "committed_max_budget_usd": {
      "minimum": 0,
      "type": "number"
     },
     "deadline_at": {
      "format": "date-time",
      "type": "string"
     },
     "expected_frequency": {
      "maxLength": 100,
      "type": "string"
     },
     "max_price_usd": {
      "minimum": 0,
      "type": "number"
     },
     "quantity": {
      "maximum": 10000,
      "minimum": 1,
      "type": "integer"
     },
     "recurring": {
      "type": "boolean"
     },
     "reservation_intent": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "freshness": {
    "additionalProperties": false,
    "properties": {
     "max_age_seconds": {
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "inputs": {
    "type": "object"
   },
   "output": {
    "additionalProperties": false,
    "properties": {
     "format": {
      "maxLength": 40,
      "type": "string"
     },
     "schema": {
      "type": "object"
     }
    },
    "type": "object"
   },
   "return_path": {
    "additionalProperties": false,
    "properties": {
     "a2a_callback": {
      "maxLength": 2000,
      "type": "string"
     },
     "webhook_url": {
      "maxLength": 2000,
      "type": "string"
     }
    },
    "type": "object"
   },
   "task": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "urgency": {
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "preflight_capability"
}
