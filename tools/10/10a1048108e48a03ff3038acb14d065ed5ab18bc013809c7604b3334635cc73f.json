{
 "description": "List submission attempts for a specific assignment (gradebook column)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "columnId": {
    "description": "Gradebook column ID (assignment ID)",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   },
   "courseId": {
    "description": "Blackboard course ID",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   }
  },
  "required": [
   "courseId",
   "columnId"
  ],
  "type": "object"
 },
 "name": "blackboard_list_attempts"
}
