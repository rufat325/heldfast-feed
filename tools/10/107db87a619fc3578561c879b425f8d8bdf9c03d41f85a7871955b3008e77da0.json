{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit an authorized brief for human review. No charge or booking. Keep one token and idempotency key per task, including across swarm retries.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brief": {
    "additionalProperties": false,
    "properties": {
     "acceptance": {
      "maxLength": 2500,
      "minLength": 10,
      "type": "string"
     },
     "alias": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "budgetUsd": {
      "maximum": 1000000,
      "minimum": 95,
      "type": "number"
     },
     "email": {
      "anyOf": [
       {
        "const": "",
        "type": "string"
       },
       {
        "format": "email",
        "maxLength": 254,
        "type": "string"
       }
      ],
      "default": ""
     },
     "location": {
      "maxLength": 300,
      "minLength": 3,
      "type": "string"
     },
     "permission": {
      "const": true,
      "type": "boolean"
     },
     "scope": {
      "maxLength": 6000,
      "minLength": 20,
      "type": "string"
     },
     "service": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "terms": {
      "const": true,
      "type": "boolean"
     },
     "timing": {
      "maxLength": 200,
      "minLength": 3,
      "type": "string"
     },
     "website": {
      "maxLength": 0,
      "type": "string"
     }
    },
    "required": [
     "service",
     "alias",
     "location",
     "scope",
     "acceptance",
     "budgetUsd",
     "timing",
     "permission",
     "terms"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "description": "Stable key for one logical operation. Reuse only with identical input on retries.",
    "pattern": "^[a-zA-Z0-9_-]{16,100}$",
    "type": "string"
   },
   "requestToken": {
    "description": "Private task token. Prefer configuring it in the HTTP Authorization Bearer header. Tool arguments may be retained in client conversation history.",
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "brief",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "submit_task"
}
