{
 "_meta": {
  "openai/profile": true,
  "securitySchemes": [
   {
    "scopes": [
     "account:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get the connected TaleSpinner account and current credit balances.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "get_profile",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "email": {
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "id": {
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "nickname": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "title": "Get TaleSpinner Profile"
}
