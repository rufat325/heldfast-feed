{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Ask a question"},"description":"Answer a question from recent stories. Ranks stories by keyword match and copies the best key facts word for word. Returns up to 5 facts, each with its story URL and Manifest ids, and up to `limit` matched stories. If nothing matches, returns no_match true and suggestions. It does not use an LLM. Use it when the user asks a question about recent news.","inputSchema":{"properties":{"days":{"default":7,"description":"How many days back to search. From 1 to 30.","title":"Days","type":"integer"},"limit":{"default":5,"description":"Maximum number of results. From 1 to 100.","title":"Limit","type":"integer"},"question":{"description":"Your question in plain words.","title":"Question","type":"string"},"topic":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Topic id. Call hc_topics for the list. Leave empty for all topics.","title":"Topic"}},"required":["question"],"title":"hc_askArguments","type":"object"},"name":"hc_ask","outputSchema":{"$defs":{"Fact":{"additionalProperties":true,"properties":{"headline":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Headline"},"manifest_ids":{"default":[],"items":{"type":"string"},"title":"Manifest Ids","type":"array"},"published_at":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Published At"},"story_slug":{"title":"Story Slug","type":"string"},"story_url":{"title":"Story Url","type":"string"},"text":{"title":"Text","type":"string"}},"required":["text","story_url","story_slug"],"title":"Fact","type":"object"},"StoryRow":{"additionalProperties":true,"properties":{"beat":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Beat"},"cited_manifest_ids":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Cited Manifest Ids"},"dek":{"anyOf":[{"type":"string"},{"type":"null