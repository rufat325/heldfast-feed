{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a private, unclaimed product on PeerPush. No API key or account is needed to create. Accepts the same fields as POST /api/v1/products and returns the same data envelope: id, status, claimUrl, expiresAt, claimedAt. Show the private claim link to the user so they can sign in, confirm details in the normal editor, and choose a plan. This does not claim, publish, or purchase anything. Keep the claim link private. Only create when the user asks to create a product. Each successful call creates a new product; do not automatically retry after an uncertain response.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alternatives": {
    "default": [],
    "items": {
     "properties": {
      "productId": {
       "minLength": 1,
       "type": "string"
      },
      "type": {
       "const": "internal",
       "type": "string"
      }
     },
     "required": [
      "type",
      "productId"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "apiDocsUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "appStoreUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "audiences": {
    "default": [],
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "categories": {
    "default": [],
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "cliInstallCommand": {
    "type": [
     "string",
     "null"
    ]
   },
   "contactEmail": {
    "description": "Contact address for the person who should claim this product. Required. Never published or returned by the API, and only PeerPush staff can see it. PeerPush emails it once, to remind the owner to claim the product before the link expires.",
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "description": {
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "discountCodes": {
    "items": {
     "properties": {
      "code": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "percentOff": {
       "maximum": 100,
       "minimum": 10,
       "type": "integer"
      },
      "title": {
       "maxLength": 50,
       "minLength": 1,
       "type": "string"
      },
      "validUntil": {
       "description": "Expiry as an ISO date string or Unix timestamp in milliseconds",
       "type": [
        "string",
        "number"
       ]
      }
     },
     "required": [
      "title",
      "code",
      "percentOff",
      "validUntil"
     ],
     "type": "object"
    },
    "maxItems": 1,
    "type": "array"
   },
   "externalId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "linkedinUrl": {
    "default": null,
    "type": [
     "string",
     "null"
    ]
   },
   "logoUrl": {
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   },
   "mcpServerUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "mrr": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "name": {
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   },
   "platforms": {
    "default": [],
    "items": {
     "enum": [
      "Web",
      "Api",
      "Desktop",
      "Mcp",
      "Cli",
      "Mobile",
      "Ios",
      "Android"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "playStoreUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "pricingType": {
    "anyOf": [
     {
      "enum": [
       "Free",
       "Freemium",
       "Subscription",
       "OneTime",
       "Paid"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "screenshotUrls": {
    "default": [],
    "items": {
     "format": "uri",
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "startingPrice": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "tagline": {
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "twitterUsername": {
    "default": null,
    "type": [
     "string",
     "null"
    ]
   },
   "useCases": {
    "default": [],
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "websiteUrl": {
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "name",
   "tagline",
   "description",
   "websiteUrl",
   "logoUrl",
   "contactEmail"
  ],
  "type": "object"
 },
 "name": "peerpush_create_product",
 "title": "Create a Product"
}
