    "description": "Declared type: string. Known values: \"1:1\", \"2:3\", \"3:2\", \"3:4\", \"4:3\", \"4:5\", \"5:4\", \"9:16\", \"16:9\", \"21:9\", \"auto\".",
    "type": "string"
   },
   "callback_url": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
