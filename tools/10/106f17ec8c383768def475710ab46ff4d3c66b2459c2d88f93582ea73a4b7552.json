{
 "_meta": {
  "openai/fileParams": [
   "video"
  ],
  "openai/outputTemplate": "ui://widget/clypmint-video.html",
  "openai/toolInvocation/invoked": "Edit started",
  "openai/toolInvocation/invoking": "Starting your edit",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "clypmint"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://widget/clypmint-video.html"
  }
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Edit one video in Clypmint. Attach the video file when the chat supports file uploads. Without a file, Clypmint returns a private upload link for the user that works for 15 minutes, and starts editing when the video arrives. The linked account's credits and limits apply. Preserve operation_id on retries. Social posts default to vertical and YouTube to horizontal.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "format": {
    "enum": [
     "vertical",
     "horizontal"
    ]
   },
   "hooks": {
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "instructions": {
    "maxLength": 2000,
    "type": "string"
   },
   "operation_id": {
    "description": "A stable ID for this authorized request. Preserve it on retries. Use a new ID only for a deliberate new request.",
    "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
    "type": "string"
   },
   "purpose": {
    "enum": [
     "organic",
     "ad",
     "youtube",
     "sales_page"
    ]
   },
   "shorts": {
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "style_id": {
    "anyOf": [
     {
      "enum": [
       "warm",
       "luxe",
       "brand",
       "intro",
       "tech",
       "ugc-ad",
       "youtube",
       "youtube-health",
       "podcast",
       "cut",
       "popup",
       "youtube-documentary",
       "realestate",
       "ugc-ad-sky",
       "studio",
       "playbook",
       "cinematic",
       "namedrop"
      ]
     },
     {
      "pattern": "^my-[a-f0-9]{12}$",
      "type": "string"
     }
    ]
   },
   "style_version": {
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "title": {
    "maxLength": 120,
    "type": "string"
   },
   "video": {
    "additionalProperties": false,
    "properties": {
     "download_url": {
      "format": "uri",
      "type": "string"
     },
     "file_id": {
      "minLength": 1,
      "type": "string"
     },
     "file_name": {
      "type": "string"
     },
     "mime_type": {
      "type": "string"
     }
    },
    "required": [
     "download_url",
     "file_id"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "edit_video",
 "securitySchemes": [
  {
   "scopes": [
    "clypmint"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Edit a video"
}
