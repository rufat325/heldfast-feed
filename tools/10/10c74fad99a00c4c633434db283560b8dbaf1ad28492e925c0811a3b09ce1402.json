{
 "description": "Rebase a revision onto a new destination. Caution: moves commits to a new base. Confirm with user before running.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cwd": {
    "description": "Repository path",
    "type": "string"
   },
   "dest": {
    "description": "Destination revision",
    "type": "string"
   },
   "rev": {
    "description": "Revision to rebase",
    "type": "string"
   }
  },
  "required": [
   "rev",
   "dest"
  ],
  "type": "object"
 },
 "name": "sl_rebase"
}
