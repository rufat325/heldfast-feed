{
 "description": "Search The Guardian for news articles. Supports filtering by section and date.",
 "inputSchema": {
  "properties": {
   "date_from": {
    "description": "Filter articles from this date (YYYY-MM-DD)",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Number of articles (max 25, default 10)",
    "type": "number"
   },
   "q": {
    "default": "artificial intelligence",
    "description": "Search query (default: artificial intelligence)",
    "type": "string"
   },
   "section": {
    "description": "Section filter: technology, science, business, world, politics",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_guardian"
}
