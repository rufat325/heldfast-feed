{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search every printable activity by title, topic or a word in the puzzle, like the site's search box. Each query word must start a word in the puzzle (\"ant\" finds Ants, not Elephant). Narrow by activity or level if you like. Each hit includes the printable PDF and the play URL, plus slugs for get_activity and show_word_search. Puzzle PDFs include an answer key. Game and drawing practice PDFs do not.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "activity": {
    "description": "Only this activity.",
    "enum": [
     "word-searches",
     "mazes",
     "color-by-number",
     "coloring-pages",
     "dot-to-dot",
     "drawing-practice",
     "criss-cross",
     "word-scrambles",
     "spot-the-difference",
     "sudoku",
     "games",
     "seek-and-count",
     "color-by-math",
     "secret-codes",
     "crosswords",
     "nonograms",
     "bingo",
     "logic-puzzles"
    ],
    "type": "string"
   },
   "level": {
    "description": "Only this level.",
    "enum": [
     "easy",
     "challenge",
     "expert"
    ],
    "type": "string"
   },
   "query": {
    "description": "Topic, title or word, for example \"farm\" or \"space\".",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_activities",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "hits": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "activity": {
       "enum": [
        "word-searches",
        "mazes",
        "color-by-number",
        "coloring-pages",
        "dot-to-dot",
        "drawing-practice",
        "criss-cross",
        "word-scrambles",
        "spot-the-difference",
        "sudoku",
        "games",
        "seek-and-count",
        "color-by-math",
        "secret-codes",
        "crosswords",
        "nonograms",
        "bingo",
        "logic-puzzles"
       ],
       "type": "string"
      },
      "level": {
       "enum": [
        "easy",
        "challenge",
        "expert"
       ],
       "type": "string"
      },
      "pdfUrl": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "topic": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "activity",
      "slug",
      "level",
      "topic",
      "url",
      "pdfUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "moreUrl": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "total": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "query",
   "total",
   "hits",
   "moreUrl"
  ],
  "type": "object"
 },
 "title": "Search activities"
}
