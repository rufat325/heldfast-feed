{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get engagement feed"
 },
 "description": "Live FastDrop launches that need attention right now - fewest votes first, zero-review items flagged. The participation loop: vote on, review, or comment on 3 different launches in the last 7 days and your submission moves to the front of the human review queue. With auth, the feed is personalized (your own launches and already-voted items excluded, tag-matches with your launches ranked first), each item says whether it needs a vote (toggle_vote) or a review (post_review), and the boost object reports your progress. Unauthenticated callers get the generic feed.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max results, 1-20, default 5",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "get_engagement_feed",
 "outputSchema": {
  "properties": {
   "boost": {
    "properties": {
     "boosted": {
      "type": "boolean"
     },
     "contributed": {
      "type": "number"
     },
     "note": {
      "type": "string"
     },
     "remaining": {
      "type": "number"
     },
     "threshold": {
      "type": "number"
     },
     "windowDays": {
      "type": "number"
     }
    },
    "required": [
     "threshold",
     "windowDays",
     "note"
    ],
    "type": "object"
   },
   "launches": {
    "items": {
     "properties": {
      "mcpUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "mcpVerified": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "needs": {
       "description": "toggle_vote when the launch has reviews, post_review when it has none",
       "type": "string"
      },
      "page": {
       "type": "string"
      },
      "reviewCount": {
       "type": "number"
      },
      "slug": {
       "type": "string"
      },
      "tagline": {
       "type": "string"
      },
      "votes": {
       "type": "number"
      }
     },
     "required": [
      "slug",
      "name",
      "tagline",
      "page",
      "votes",
      "reviewCount",
      "needs"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "personalized": {
    "type": "boolean"
   }
  },
  "required": [
   "personalized",
   "launches"
  ],
  "type": "object"
 },
 "title": "Get engagement feed"
}
