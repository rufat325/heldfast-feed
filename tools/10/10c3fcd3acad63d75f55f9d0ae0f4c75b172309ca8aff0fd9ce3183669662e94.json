      },
      "name": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "execution_time_ms": {
    "type": "number"
   },
   "row_count": {
    "type": "number"
   },
   "rows": {
    "items": {
     "type": "array"
    },
    "type": "array"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "columns",
   "rows",
   "row_count",
