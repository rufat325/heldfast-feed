{
 "description": "SENDS A REAL EMAIL: a WooCommerce order-email preview to `to`. settings (same keys as woo_helper_update_emails) are applied to this one email only and NOT saved, to try a look before saving it. Rate limited (30 s per user, 10 per hour per site; 429). Needs WooCommerce 9.6+ (409) and cvrt-woo-helper 0.2.0+.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "settings": {
    "additionalProperties": false,
    "description": "Unsaved overrides for this test email",
    "properties": {
     "background_color": {
      "$ref": "#/properties/settings/properties/base_color",
      "description": "Email background colour"
     },
     "base_color": {
      "description": "Base (accent) colour",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "type": "string"
     },
     "body_background_color": {
      "$ref": "#/properties/settings/properties/base_color",
      "description": "Body background colour"
     },
     "certificate_link_once": {
      "description": "Show the certificate download link only once (needs wp-woo-pdf-builder 1.7.6+)",
      "type": "boolean"
     },
     "footer_text": {
      "description": "Footer text; placeholders {site_title} {site_url} {store_address} {store_email} {year}",
      "type": "string"
     },
     "footer_text_color": {
      "$ref": "#/properties/settings/properties/base_color",
      "description": "Footer text colour"
     },
     "link_color": {
      "anyOf": [
       {
        "$ref": "#/properties/settings/properties/base_color"
       },
       {
        "const": "",
        "type": "string"
       }
      ],
      "description": "Link colour; empty = WooCommerce's default"
     },
     "logo_id": {
      "description": "Media library attachment id of the logo; 0 removes it",
      "minimum": 0,
      "type": "integer"
     },
     "logo_width": {
      "description": "Logo width in px (40-200)",
      "maximum": 200,
      "minimum": 40,
      "type": "integer"
     },
     "product_images": {
      "description": "Product images in order emails",
      "enum": [
       "off",
       "small"
      ],
      "type": "string"
     },
     "text_color": {
      "$ref": "#/properties/settings/properties/base_color",
      "description": "Body text colour"
     }
    },
    "type": "object"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "to": {
    "description": "Recipient address",
    "format": "email",
    "type": "string"
   }
  },
  "required": [
   "site",
   "to"
  ],
  "type": "object"
 },
 "name": "woo_helper_send_test_email"
}
