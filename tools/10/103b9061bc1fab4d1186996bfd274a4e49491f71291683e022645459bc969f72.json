{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Brand New ASINs"
 },
 "description": "Show ASINs that recently appeared for a brand. Use when the user asks 'new products for Nike', 'recently added ASINs', 'what new listings does this brand have', or any question about a brand's recent catalog additions. Each ASIN carries product brand, title, price (or price range) and fulfillment (FBA/FBM/AMZ + amz/fba pct).",
 "inputSchema": {
  "properties": {
   "asin": {
    "description": "Exact ASIN match.",
    "type": "string"
   },
   "asin_contains": {
    "type": "string"
   },
   "brand": {
    "description": "Brand name (case-insensitive).",
    "type": "string"
   },
   "first_seen_from": {
    "description": "YYYY-MM-DD (since_days already bounds the lower edge).",
    "type": "string"
   },
   "first_seen_to": {
    "type": "string"
   },
   "fulfillment_in": {
    "description": "Comma-separated FBA/FBM/AMZ to keep.",
    "type": "string"
   },
   "last_seen_from": {
    "type": "string"
   },
   "last_seen_to": {
    "type": "string"
   },
   "latest_buybox_seller": {
    "description": "Exact most-recent buy-box seller (case-insensitive).",
    "type": "string"
   },
   "latest_buybox_seller_contains": {
    "type": "string"
   },
   "limit": {
    "type": "integer"
   },
   "marketplace_id": {
    "default": 2,
    "description": "1 = Amazon UK, 2 = Amazon US (default), 4 = Amazon CA, 5 = Amazon AU, 6 = Amazon DE, 7 = Amazon JP, 8 = Amazon IT, 9 = Amazon FR, 10 = Amazon ES, 11 = Amazon MX, 12 = Amazon BR",
    "type": "integer"
   },
   "max_fulfillment_amz_dom_pct": {
    "type": "number"
   },
   "max_fulfillment_fba_pen_pct": {
    "type": "number"
   },
   "max_latest_price": {
    "type": "number"
   },
   "max_price": {
    "type": "number"
   },
   "max_seller_count": {
    "type": "number"
   },
   "min_fulfillment_amz_dom_pct": {
    "type": "number"
   },
   "min_fulfillment_fba_pen_pct": {
    "type": "number"
   },
   "min_latest_price": {
    "type": "number"
   },
   "min_price": {
    "type": "number"
   },
   "min_seller_count": {
    "type": "number"
   },
   "product_brand": {
    "description": "Exact product brand (case-insensitive).",
    "type": "string"
   },
   "product_brand_contains": {
    "type": "string"
   },
   "product_title_contains": {
    "type": "string"
   },
   "since_days": {
    "description": "How far back to look (default 30, max 180).",
    "type": "integer"
   }
  },
  "required": [
   "brand"
  ],
  "type": "object"
 },
 "name": "brand_new_asins"
}
