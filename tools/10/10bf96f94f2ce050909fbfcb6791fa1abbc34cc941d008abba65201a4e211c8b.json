{
 "description": "Update task metadata \u2014 title, description, priority, tags, project, assignment, or dependencies. Does not change stage or status (use task_stage for that).",
 "inputSchema": {
  "properties": {
   "assign_to": {
    "description": "New assignee (empty string to unassign)",
    "type": "string"
   },
   "dependency": {
    "description": "Add or remove a dependency in the same call",
    "properties": {
     "action": {
      "description": "Add or remove the dependency",
      "enum": [
       "add",
       "remove"
      ],
      "type": "string"
     },
     "depends_on": {
      "description": "The task ID this task depends on",
      "type": "number"
     },
     "relationship": {
      "description": "Relationship type (default: blocks, only for add)",
      "enum": [
       "blocks",
       "related",
       "duplicate"
      ],
      "type": "string"
     }
    },
    "required": [
     "action",
     "depends_on"
    ],
    "type": "object"
   },
   "description": {
    "description": "New description",
    "type": "string"
   },
   "priority": {
    "description": "New priority",
    "type": "number"
   },
   "project": {
    "description": "New project",
    "type": "string"
   },
   "tags": {
    "description": "New tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "task_id": {
    "description": "Task ID",
    "type": "number"
   },
   "title": {
    "description": "New title",
    "type": "string"
   }
  },
  "required": [
   "task_id"
  ],
  "type": "object"
 },
 "name": "task_update"
}
