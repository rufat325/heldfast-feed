{
 "description": "Create a new image ad item (banner)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "creative": {
    "description": "Image creative ID (mutually exclusive with creative_url)",
    "type": "number"
   },
   "creative_url": {
    "description": "URL to image file \u2014 PNG, JPEG, or GIF (mutually exclusive with creative)",
    "type": "string"
   },
   "height": {
    "description": "Ad height in pixels (defaults to 0)",
    "type": "number"
   },
   "html_alt_text": {
    "description": "Alt text for the image",
    "type": "string"
   },
   "html_content_below": {
    "description": "HTML content below the ad item",
    "type": "string"
   },
   "html_target": {
    "description": "Window/frame for destination URL (e.g. \"_blank\")",
    "type": "string"
   },
   "location": {
    "description": "Click-through URL",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom metadata key-value pairs",
    "type": "object"
   },
   "name": {
    "description": "Ad item name",
    "type": "string"
   },
   "tracking_pixel": {
    "description": "Third-party tracking pixel URL",
    "type": "string"
   },
   "tracking_pixels": {
    "description": "Array of tracking pixel URLs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "trusted_redirect_domains": {
    "description": "Trusted redirect domains",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "width": {
    "description": "Ad width in pixels (defaults to 0)",
    "type": "number"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_image_ad_item"
}
