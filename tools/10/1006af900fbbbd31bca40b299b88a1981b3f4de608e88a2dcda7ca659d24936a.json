{
 "description": "action=create makes a new playlist (private by default); action=add_items appends track URIs to an existing playlist. Does not delete or remove anything.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "create",
     "add_items"
    ],
    "type": "string"
   },
   "description": {
    "description": "New playlist description (action=create)",
    "type": "string"
   },
   "name": {
    "description": "New playlist name (action=create)",
    "type": "string"
   },
   "playlist": {
    "description": "Target playlist id/URI/URL (action=add_items)",
    "type": "string"
   },
   "public": {
    "description": "Make the new playlist public (default false)",
    "type": "boolean"
   },
   "uris": {
    "description": "Track URIs to add (action=add_items)",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "modify_playlist",
 "title": "Create playlist / add tracks"
}
