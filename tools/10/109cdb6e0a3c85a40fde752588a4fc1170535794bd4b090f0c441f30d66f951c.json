{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "GST/HST rate by province"
 },
 "description": "Current GST/HST rate for a Canadian province or territory (or all 13), with the PST/QST rate CRA lists for reference. From CRA's 'Charge and collect the GST/HST' table.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "province": {
    "description": "Province or territory code or name, e.g. \"ON\", \"Ontario\", \"QC\", \"Yukon\".",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "gst_hst_rate_by_province",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asOf": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dataVersion": {
    "description": "Version of the Tallyfern Rates dataset, e.g. 2026.10.03",
    "type": "string"
   },
   "disclaimer": {
    "description": "Not-tax-advice notice",
    "type": "string"
   },
   "effectiveFrom": {
    "description": "Rates effective on or after this date",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rate": {
    "additionalProperties": false,
    "description": "The requested province or territory (when one was given)",
    "properties": {
     "code": {
      "description": "Province or territory code",
      "enum": [
       "AB",
       "BC",
       "MB",
       "NB",
       "NL",
       "NT",
       "NS",
       "NU",
       "ON",
       "PE",
       "QC",
       "SK",
       "YT"
      ],
      "type": "string"
     },
     "combinedPercentIfBothApply": {
      "description": "GST/HST plus PST/QST where both apply",
      "type": "number"
     },
     "gstHstPercent": {
      "description": "GST or HST rate in percent",
      "type": "number"
     },
     "name": {
      "type": "string"
     },
     "provincialSalesTaxName": {
      "description": "PST, QST or null",
      "type": [
       "string",
       "null"
      ]
     },
     "provincialSalesTaxPercent": {
      "description": "PST/QST in percent as listed by CRA for reference; null in HST provinces",
      "type": [
       "number",
       "null"
      ]
     },
     "taxType": {
      "enum": [
       "GST",
       "HST"
      ],
      "type": "string"
     }
    },
    "required": [
     "code",
     "name",
     "taxType",
     "gstHstPercent",
     "provincialSalesTaxPercent",
     "provincialSalesTaxName",
     "combinedPercentIfBothApply"
    ],
    "type": "object"
   },
   "rates": {
    "description": "All 13 provinces and territories (when no province was given)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "description": "Province or territory code",
       "enum": [
        "AB",
        "BC",
        "MB",
        "NB",
        "NL",
        "NT",
        "NS",
        "NU",
        "ON",
        "PE",
        "QC",
        "SK",
        "YT"
       ],
       "type": "string"
      },
      "gstHstPercent": {
       "description": "GST or HST rate in percent",
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "provincialSalesTaxName": {
       "description": "PST, QST or null",
       "type": [
        "string",
        "null"
       ]
      },
      "provincialSalesTaxPercent": {
       "description": "PST/QST in percent as listed by CRA for reference; null in HST provinces",
       "type": [
        "number",
        "null"
       ]
      },
      "taxType": {
       "enum": [
        "GST",
        "HST"
       ],
       "type": "string"
      }
     },
     "required": [
      "code",
      "name",
      "taxType",
      "gstHstPercent",
      "provincialSalesTaxPercent",
      "provincialSalesTaxName"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "relatedLink": {
    "description": "Related free Tallyfern tool or page",
    "format": "uri",
    "type": "string"
   },
   "source": {
    "additionalProperties": false,
    "description": "Official source for these figures",
    "properties": {
     "pageDateModified": {
      "anyOf": [
       {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "'Date modified' shown on the page, if any"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "description": "Official canada.ca page",
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "title",
     "url"
    ],
    "type": "object"
   }
  },
  "required": [
   "asOf",
   "effectiveFrom",
   "source",
   "notes",
   "disclaimer",
   "relatedLink",
   "dataVersion"
  ],
  "type": "object"
 },
 "title": "GST/HST and PST rates by province"
}
