{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Paper"
 },
 "description": "Get a single paper with all its paragraphs. Paper IDs range from 0 (Foreword) to 196. Each paragraph has its reference, section, and plain text, so a whole paper fits in one call. Optionally include entity mentions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "include_entities": {
    "default": false,
    "description": "Include entity mentions in each paragraph",
    "type": "boolean"
   },
   "paper_id": {
    "description": "Paper ID (0-196). Example: '1'",
    "type": "string"
   }
  },
  "required": [
   "paper_id"
  ],
  "type": "object"
 },
 "name": "papers.get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "paper": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "labels": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "partId": {
      "type": "string"
     },
     "sortId": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "partId",
     "title",
     "sortId",
     "labels"
    ],
    "type": "object"
   },
   "paragraphs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "entities": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "type": {
          "enum": [
           "being",
           "place",
           "order",
           "race",
           "religion",
           "concept"
          ],
          "type": "string"
         }
        },
        "required": [
         "id",
         "name",
         "type"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "sectionId": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sectionTitle": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "standardReferenceId": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "standardReferenceId",
      "sectionId",
      "sectionTitle",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "paper",
   "paragraphs"
  ],
  "type": "object"
 },
 "title": "Get Paper"
}
