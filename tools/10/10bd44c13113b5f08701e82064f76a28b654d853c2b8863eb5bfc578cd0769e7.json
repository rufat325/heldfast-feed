{
 "_meta": {
  "openai/outputTemplate": "ui://widget/insight-cards-v2.html",
  "openai/widgetDescription": "Loan prepayment simulation card.",
  "ui": {
   "csp": {
    "connectDomains": [],
    "frameDomains": [],
    "resourceDomains": []
   },
   "resourceUri": "ui://widget/insight-cards-v2.html"
