{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create or revise one title or text overlay with explicit timing. Revision checked; dryRun previews by default. This edits project text, not spoken audio or captions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": true,
    "type": "boolean"
   },
   "durationSeconds": {
    "exclusiveMinimum": 0,
    "minimum": 0,
    "type": "number"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "itemId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "projectId": {
    "description": "UUID string.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "spec": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "startSeconds": {
    "minimum": 0,
    "type": "number"
   },
   "text": {
    "minLength": 1,
    "type": "string"
   },
   "textKind": {
    "enum": [
     "overlay",
     "title_card"
    ],
    "type": "string"
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "itemId",
   "text",
   "textKind",
   "spec",
   "startSeconds",
   "durationSeconds",
   "workspaceId",
   "idempotencyKey",
   "projectId",
   "expectedRevision",
   "dryRun"
  ],
  "type": "object"
 },
 "name": "editor_text_set",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "editor text set"
}
