{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Compatibility alias for note_insert_at with the same cursor and context guards.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "contextAfter": {
    "description": "Optional exact text immediately after the cursor; rejects stale positions.",
    "type": "string"
   },
   "contextBefore": {
    "description": "Optional exact text immediately before the cursor; rejects stale positions.",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview the change without applying it: returns the planned action and the exact CLI command.",
    "type": "boolean"
   },
   "path": {
    "description": "Vault-relative path to the note.",
    "minLength": 1,
    "type": "string"
   },
   "position": {
    "description": "Insertion cursor (zero-based line/ch).",
    "properties": {
     "ch": {
      "description": "Zero-based UTF-16 column within the line.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "line": {
      "description": "Zero-based line number.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "line",
     "ch"
    ],
    "type": "object"
   },
   "text": {
    "description": "Text to insert at the cursor; may contain newlines.",
    "type": "string"
   }
  },
  "required": [
   "path",
   "position",
   "text"
  ],
  "type": "object"
 },
 "name": "note_insert",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Optional tool-specific structured result data."
   },
   "text": {
    "description": "Human-readable result text.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "title": "Insert note text"
}
