{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new node pool in an NKS cluster. Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoscale": {
    "additionalProperties": false,
    "description": "Autoscale configuration",
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "max": {
      "type": "number"
     },
     "min": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "clusterUuid": {
    "description": "UUID of the cluster",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, preview only",
    "type": "boolean"
   },
   "fabricCluster": {
    "additionalProperties": false,
    "description": "Fabric cluster settings \u2014 required for server specs where ncloud_nks_get_server_specs reports isFabricClusterType=true",
    "properties": {
     "poolName": {
      "description": "Fabric cluster pool name",
      "type": "string"
     },
     "poolNo": {
      "description": "Fabric cluster pool number",
      "type": "number"
     }
    },
    "type": "object"
   },
   "labels": {
    "description": "Node labels",
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Node pool name",
    "type": "string"
   },
   "nodeCount": {
    "description": "Number of nodes (required if autoscale not set)",
    "type": "number"
   },
   "serverRoleId": {
    "description": "IAM server role ID",
    "type": "string"
   },
   "serverSpecCode": {
    "description": "Server spec code (KVM)",
    "type": "string"
   },
   "softwareCode": {
    "description": "Server image code",
    "type": "string"
   },
   "storageSize": {
    "description": "Storage size in GB (KVM, 100-2000)",
    "type": "number"
   },
   "taints": {
    "description": "Node taints",
    "items": {
     "additionalProperties": false,
     "properties": {
      "effect": {
       "type": "string"
      },
      "key": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "key",
      "effect"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "zoneCode": {
    "description": "Zone code (required for Regional clusters)",
    "type": "string"
   }
  },
  "required": [
   "clusterUuid",
   "name"
  ],
  "type": "object"
 },
 "name": "ncloud_nks_create_node_pool"
}
