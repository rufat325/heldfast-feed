{
 "description": "Issue a certificate of completion to a user for a course. Normally the platform auto-issues on course completion \u2014 use this tool for bulk backfill or manual awards.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "completion_date": {
    "description": "ISO timestamp; defaults to now",
    "type": "string"
   },
   "course_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "expires_at": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "ISO timestamp; omit or null for no expiry"
   },
   "final_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "instructor_name": {
    "type": "string"
   },
   "user_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "user_id",
   "course_id"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_certificate"
}
