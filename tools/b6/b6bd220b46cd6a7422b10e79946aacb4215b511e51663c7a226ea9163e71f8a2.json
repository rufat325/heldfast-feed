{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "checklists:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Save done, to do or not applicable for the exact item ID the user selected from an Afterglow checklist. Obtain confirmation of the item and status before calling. Overwrites that item's existing progress in the connected account. Repeating the same item and status preserves the completed timestamp and returns the saved state.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmed": {
    "const": true,
    "type": "boolean"
   },
   "item_id": {
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[a-z0-9_-]+$",
    "type": "string"
   },
   "status": {
    "enum": [
     "todo",
     "done",
     "na"
    ],
    "type": "string"
   }
  },
  "required": [
   "item_id",
   "status",
   "confirmed"
  ],
  "type": "object"
 },
 "name": "set_checklist_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "item": {
      "additionalProperties": false,
      "properties": {
       "doneAt": {
        "type": [
         "string",
         "null"
        ]
       },
       "id": {
        "minLength": 1,
        "type": "string"
       },
       "resourceUrl": {
        "type": [
         "string",
         "null"
        ]
       },
       "season": {
        "enum": [
         "steady",
         "sort",
         "rebuild",
         "rise"
        ],
        "type": "string"
       },
       "status": {
        "enum": [
         "todo",
         "done",
         "na"
        ],
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "urgent": {
        "type": "boolean"
       },
       "why": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "title",
       "why",
       "urgent",
       "season",
       "status",
       "doneAt"
      ],
      "type": "object"
     },
     "roomPieceUnlocked": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "pieceId": {
          "minLength": 1,
          "type": "string"
         },
         "reason": {
          "enum": [
           "move",
           "first",
           "season",
           "streak"
          ],
          "type": "string"
         },
         "svgKey": {
          "type": "string"
         },
         "title": {
          "type": "string"
         }
        },
        "required": [
         "pieceId",
         "title",
         "svgKey",
         "reason"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "item",
     "roomPieceUnlocked"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "error": {
      "minLength": 1,
      "type": "string"
     },
     "paywall": {
      "type": "boolean"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "checklists:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Update a checklist item"
}
