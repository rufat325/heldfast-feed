    "description": "Only this affiliate's commissions.",
    "type": "string"
   },
   "expand": {
    "description": "Nested objects to include for each commission.",
    "items": {
     "enum": [
      "sale",
      "campaign"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Results per page, 1-100 (default 25).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number, from 1. See pagination.next_page.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "description": "Only commissions in these states.",
    "items": {
     "enum": [
      "pending",
      "due",
      "paid",
      "voided"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
