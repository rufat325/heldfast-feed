{
 "annotations": {
  "readOnlyHint": true,
  "title": "List notes"
 },
 "description": "List notes, newest first by default \u2014 across the whole CRM, or for one contact. Filter by date range and author. LACRM: GetNotes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contact_id": {
    "description": "Only notes attached to this contact (a long numeric Uid \u2014 always pass it as a string).",
    "minLength": 1,
    "type": "string"
   },
   "date_end": {
    "description": "Only notes on/before this date-time (ISO 8601).",
    "type": "string"
   },
   "date_start": {
    "description": "Only notes on/after this date-time (ISO 8601).",
    "type": "string"
   },
   "max_results": {
    "description": "Results per page (MaxNumberOfResults), 1-10000. Default here: 50.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number, 1-based. Default 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "sort_direction": {
    "description": "Sort direction.",
    "enum": [
     "Ascending",
     "Descending"
    ],
    "type": "string"
   },
   "user_ids": {
    "description": "Only notes entered by these UserIds.",
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     ]
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "lacrm_list_notes",
 "title": "List notes"
}
