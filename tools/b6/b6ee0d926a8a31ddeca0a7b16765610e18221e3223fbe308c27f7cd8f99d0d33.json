{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/data.json-diff",
  "agent-utilities/priceMicroUsd": 500
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Compare JSON structures and return bounded changes at JSON Pointer paths. PAID: 500 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "after": {},
     "before": {},
     "maxChanges": {
      "maximum": 200,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "before",
     "after"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "data_json_diff",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "changes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "after": {},
      "before": {},
      "kind": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "kind"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "equal": {
    "type": "boolean"
   },
   "scope": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "equal",
   "changes",
   "truncated",
   "scope"
  ],
  "type": "object"
 }
}
