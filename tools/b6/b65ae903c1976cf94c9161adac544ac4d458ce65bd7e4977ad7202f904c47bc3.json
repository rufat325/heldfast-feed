{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "One ELMS (Canvas) Inbox conversation with every message in it. Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "conversation_id": {
    "description": "Conversation id, from elms_list_conversations",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "conversation_id"
  ],
  "type": "object"
 },
 "name": "elms_get_conversation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "Course the conversation belongs to, if any",
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "description": "Conversation id, for elms_get_conversation",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "last_message": {
    "type": [
     "string",
     "null"
    ]
   },
   "last_message_at": {
    "description": "ISO 8601 timestamp (UTC); null when unset",
    "type": [
     "string",
     "null"
    ]
   },
   "message_count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "messages": {
    "description": "Messages, newest first as Canvas orders them",
    "items": {
     "additionalProperties": false,
     "properties": {
      "attachments": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "type": "string"
         },
         "url": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "name",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "author": {
       "type": [
        "string",
        "null"
       ]
      },
      "body": {
       "type": "string"
      },
      "created_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "id",
      "author",
      "body",
      "created_at",
      "attachments"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "participants": {
    "description": "Participant names",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "starred": {
    "type": "boolean"
   },
   "state": {
    "enum": [
     "read",
     "unread",
     "archived"
    ],
    "type": "string"
   },
   "subject": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "id",
   "subject",
   "state",
   "last_message",
   "last_message_at",
   "message_count",
   "participants",
   "context",
   "starred",
   "messages"
  ],
  "type": "object"
 },
 "title": "Get an ELMS conversation"
}
