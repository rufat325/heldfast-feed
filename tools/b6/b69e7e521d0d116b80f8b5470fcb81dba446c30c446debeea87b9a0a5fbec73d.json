{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Material Events Digest"
 },
 "description": "Retrieve a severity-ranked digest of all 8-K and 8-K/A filings for a company within a configurable lookback window. Each event is tagged with item codes mapped to plain-English labels, categories, and severity (RED / YELLOW / GREEN). Returns redflag_count (events with any RED item) and category_counts for quick categorical analysis. Answers: \"Has this company disclosed a cybersecurity incident, restatement, or going-concern risk recently?\" Premium-tier tool. See the actor pricing page for current per-call cost.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "lookback_days": {
    "default": 365,
    "description": "Number of calendar days to include (default 365, max 1825 / 5 years).",
    "maximum": 1825,
    "minimum": 1,
    "type": "integer"
   },
   "ticker_or_cik": {
    "description": "Ticker symbol (e.g. \"TSLA\") or numeric CIK.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ticker_or_cik"
  ],
  "type": "object"
 },
 "name": "get_material_events_digest",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category_counts": {
    "additionalProperties": {
     "type": "number"
    },
    "type": "object"
   },
   "cik": {
    "type": "string"
   },
   "company_name": {
    "type": [
     "string",
     "null"
    ]
   },
   "events": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accession_number": {
       "type": "string"
      },
      "filing_date": {
       "type": "string"
      },
      "form": {
       "type": "string"
      },
      "items": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "category": {
          "type": "string"
         },
         "code": {
          "type": "string"
         },
         "label": {
          "type": "string"
         },
         "severity": {
          "enum": [
           "RED",
           "YELLOW",
           "GREEN"
          ],
          "type": "string"
         }
        },
        "required": [
         "code",
         "label",
         "category",
         "severity"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "overall_severity": {
       "enum": [
        "RED",
        "YELLOW",
        "GREEN"
       ],
       "type": "string"
      },
      "sec_url": {
       "type": "string"
      }
     },
     "required": [
      "accession_number",
      "filing_date",
      "form",
      "items",
      "sec_url",
      "overall_severity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "lookback_days": {
    "type": "number"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "data_delay": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "timestamp": {
      "type": "string"
     }
    },
    "required": [
     "source",
     "timestamp",
     "data_delay"
    ],
    "type": "object"
   },
   "redflag_count": {
    "type": "number"
   },
   "ticker": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "ticker",
   "cik",
   "company_name",
   "lookback_days",
   "events",
   "category_counts",
   "redflag_count",
   "meta"
  ],
  "type": "object"
 },
 "title": "Material Events Digest"
}
