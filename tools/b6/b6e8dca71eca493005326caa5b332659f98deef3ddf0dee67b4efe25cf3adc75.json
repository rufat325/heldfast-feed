{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Scan observation pairs with high cosine similarity but disagreeing negation/confidence. LLM-free heuristic. Requires sqlite-vec. Per-entity observations are capped (maxObservationsPerEntity, default 200) to bound the O(N^2) self-join.",
 "inputSchema": {
  "properties": {
   "entityId": {
    "minLength": 1,
    "type": "string"
   },
   "entityName": {
    "minLength": 1,
    "type": "string"
   },
   "entityType": {
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "maxObservationsPerEntity": {
    "maximum": 2000,
    "minimum": 2,
    "type": "integer"
   },
   "minConfidenceDrift": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "minCosine": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "memory_contradictions"
}
