{
 "description": "Check the safety of a DeFi lending position against oracle deviation stress tests. Supports multi-asset or single-asset positions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "borrowAmount": {
    "description": "Single-asset borrow amount",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "borrowSymbol": {
    "description": "Single-asset borrow symbol",
    "type": "string"
   },
   "borrows": {
    "description": "Multi-asset borrow positions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "description": "Asset amount",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "symbol": {
       "description": "Asset symbol",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "symbol",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "collateralAmount": {
    "description": "Single-asset collateral amount",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "collateralSymbol": {
    "description": "Single-asset collateral symbol",
    "type": "string"
   },
   "collaterals": {
    "description": "Multi-asset collateral positions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "description": "Asset amount",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "symbol": {
       "description": "Asset symbol",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "symbol",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "protocolId": {
    "description": "Protocol ID or slug",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "protocolId"
  ],
  "type": "object"
 },
 "name": "check_position_safety"
}
