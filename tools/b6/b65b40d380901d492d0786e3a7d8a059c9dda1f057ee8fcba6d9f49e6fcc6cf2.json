{
 "description": "Update an existing platform target",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "device_targets": {
    "description": "List of device patterns to target",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "Platform target ID",
    "type": "number"
   },
   "name": {
    "description": "Platform target name",
    "type": "string"
   },
   "platform": {
    "description": "Preset platform target",
    "enum": [
     "any",
     "specific",
     "mobile",
     "tablet",
     "mobile_and_tablet",
     "desktop"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_platform_target"
}
