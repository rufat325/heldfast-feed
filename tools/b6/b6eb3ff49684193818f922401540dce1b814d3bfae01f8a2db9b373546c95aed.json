{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Register Creative Asset"
 },
 "description": "Register a local or remote creative asset for Raven jobs. This is the local-first analog of upload: Raven stores metadata and a URI/path, not the file bytes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "What this asset should be used for.",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Optional non-secret metadata.",
    "type": "object"
   },
   "name": {
    "description": "Human-readable name.",
    "type": "string"
   },
   "tags": {
    "description": "Search tags.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Asset type.",
    "enum": [
     "image",
     "video",
     "audio",
     "document",
     "3d",
     "url",
     "other"
    ],
    "type": "string"
   },
   "uri": {
    "description": "Local path or URL to the asset.",
    "type": "string"
   }
  },
  "required": [
   "uri",
   "type"
  ],
  "type": "object"
 },
 "name": "register_creative_asset"
}
