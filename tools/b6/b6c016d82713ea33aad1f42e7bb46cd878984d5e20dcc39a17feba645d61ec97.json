{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Call FIRST, before answering, whenever the user's message references their projects, people, decisions or prior work. Returns a short recognition brief of what the user's other agents already know. `format` picks markdown, xml, compact, brief, json or yaml. `verbose: true` returns the full brief with every delivery variant, trace and diagnostics.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_level": {
    "default": "team",
    "type": "string"
   },
   "agent": {
    "default": "generic",
    "type": "string"
   },
   "cwd": {
    "type": [
     "string",
     "null"
    ]
   },
   "format": {
    "default": "markdown",
    "type": "string"
   },
   "max_chars": {
    "default": 1800,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "max_items": {
    "default": 6,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "verbose": {
    "default": false,
    "type": "boolean"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "compile_turn",
 "title": "Compile turn brief"
}
