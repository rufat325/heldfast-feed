{
 "description": "Is a date a business day in a country? Add/subtract N business days honouring holidays and the local weekend (e.g. Fri-Sat in Saudi Arabia).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "add": {
    "default": 0,
    "maximum": 2000,
    "minimum": -2000,
    "type": "integer"
   },
   "calendar": {
    "default": "standard",
    "enum": [
     "standard",
     "bank"
    ],
    "type": "string"
   },
   "country": {
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "date": {
    "description": "YYYY-MM-DD, default today",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "region": {
    "maxLength": 10,
    "type": "string"
   },
   "weekend": {
    "description": "override, weekday numbers 0=Sun e.g. 5,6",
    "type": "string"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
 "name": "business_day",
 "title": "Business-day calculator (any country)"
}
