     "schema-invalid",
     "schema-valid",
     "maintainer-review",
     "verified",
     "stale",
     "rejected"
    ],
    "examples": [
     "schema-invalid"
    ],
    "type": "string"
   }
  },
  "required": [
   "context"
  ],
  "type": "object"
