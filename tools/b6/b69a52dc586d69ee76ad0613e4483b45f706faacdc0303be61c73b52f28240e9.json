    ],
    "type": "string"
   },
   "cursor": {
    "description": "Row offset to resume from \u2014 the numeric position of the first row to return, not an opaque token. Rows inserted since the previous page shift it, so prefer the keyset cursor where a tool offers one.",
    "examples": [
     0,
     100
    ],
    "minimum": 0,
    "type": "integer"
   },
   "fields": {
    "description": "Comma-separated row field names to project, e.g. `netuid,name,slug`. Bare identifiers only \u2014 not a JSON array, no paths or indices. An unknown name is rejected rather than ignored. A projected row omits every non-selected property, including ones the row schema marks required: `required` describes the unprojected response (#10960), so a client validating responses should skip validation or treat row properties as optional when it sends this parameter.",
    "examples": [
     "netuid,name,slug"
    ],
    "pattern": "^[\\s,]*[A-Za-z_][A-Za-z0-9_]*(\\s*,[\\s,]*[A-Za-z_][A-Za-z0-9_]*)*[\\s,]*$",
    "type": "string"
   },
   "id": {
    "description": "The record's stable identifier, as returned by the corresponding list tool. Exact match; an unknown id yields an empty result rather than an error.",
    "examples": [
     "sn-64-chutes-subnet-api"
    ],
    "maxLength": 100,
    "type": "string"
   },
   "kind": {
    "description": "Restrict the result to this kind. Options are per-tool; see this parameter's enum.",
    "enum": [
     "archive",
     "dashboard",
     "data-artifact",
     "docs",
     "example",
     "openapi",
     "repo-registry",
     "sdk",
     "source-repo",
     "sse",
     "subnet-api",
     "subtensor-rpc",
     "subtensor-wss",
     "website"
    ],
    "examples": [
     "archive"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum rows to return (1-1000). Defaults to 20 when omitted. The response reports the limit actually applied.",
    "examples": [
     20
    ],
    "maximum": 1000,
    "minimum": 1,
    "type": "integer",
    "x-serving-bound": true
   },
   "llm_model": {
    "description": "Your model ID if known; omit otherwise. Analytics only.",
    "examples": [
     "gpt-6"
    ],
    "type": "string"
   },
   "netuid": {
    "description": "Subnet id (netuid), 0-65535. 0 is the root subnet, which is special: it has no AMM pool and is emission-ineligible.",
    "examples": [
     64,
     0
    ],
    "maximum": 65535,
    "minimum": 0,
    "type": "integer"
   },
   "order": {
    "description": "Sort direction for the chosen sort key: `asc` smallest-first, `desc` largest-first.",
    "enum": [
     "asc",
     "desc"
    ],
    "examples": [
     "desc"
    ],
    "type": "string"
   },
   "provider": {
    "description": "Restrict to one provider, by SLUG (`opentensor-foundation`), not display name. Unknown slugs yield an empty result, not an error.",
    "examples": [
     "opentensor-foundation"
