{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "dev",
 "description": "Generate a curl command from request parameters. Supports GET/POST/PUT/DELETE, custom headers, JSON body, and form data. Useful for documentation, sharing, and debugging API calls.",
 "inputSchema": {
  "properties": {
   "body": {
    "description": "Raw request body string",
    "type": "string"
   },
   "body_json": {
    "additionalProperties": true,
    "description": "JSON body (auto-adds Content-Type: application/json)",
    "type": "object"
   },
   "follow_redirects": {
    "description": "Follow redirects with -L flag (default: true)",
    "type": "boolean"
   },
   "headers": {
    "additionalProperties": true,
    "description": "Request headers as key-value object",
    "type": "object"
   },
   "method": {
    "description": "HTTP method (default: GET)",
    "type": "string"
   },
   "url": {
    "description": "Request URL (must be http/https)",
    "type": "string"
   },
   "verbose": {
    "description": "Add -v for verbose output (default: false)",
    "type": "boolean"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "generate_curl",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "curl": {
    "type": "string"
   },
   "header_count": {
    "type": "number"
   },
   "method": {},
   "url": {}
  },
  "type": "object"
 }
}
