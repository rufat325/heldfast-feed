  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The PARENT deployment (dpl_...) \u2014 the one connected to the repo, not a preview.",
    "type": "string"
   }
  },
  "required": [
   "deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_list_previews",
