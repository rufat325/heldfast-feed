    ]
   },
   "boostLevel": {
    "type": "number"
   },
   "channelCount": {
    "type": "number"
   },
   "createdAt": {
    "type": "string"
   },
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "type": "string"
   },
   "memberCount": {
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "owner": {
    "type": "string"
   },
   "roleCount": {
    "type": "number"
   }
  },
  "required": [
   "id",
   "name",
   "description",
   "memberCount",
   "channelCount",
   "roleCount",
   "boostLevel",
   "boostCount",
   "createdAt",
   "owner"
  ],
  "type": "object"
 }
