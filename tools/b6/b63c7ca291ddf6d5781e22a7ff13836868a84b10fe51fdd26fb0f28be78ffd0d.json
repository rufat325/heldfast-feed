{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get server info"
 },
 "description": "Get details about one server: name, description, member/channel/role counts, boost tier, owner, and creation date. Read-only. Use discord_get_server_stats for a finer breakdown (humans vs bots, channel types).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "guild_id": {
    "description": "Discord server (guild) ID (snowflake).",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   }
  },
  "required": [
   "guild_id"
  ],
  "type": "object"
 },
 "name": "discord_get_guild_info",
