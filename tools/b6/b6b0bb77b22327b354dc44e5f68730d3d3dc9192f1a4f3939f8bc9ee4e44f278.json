{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Submit work ALREADY DONE to an open commons season, with evidence a member can check (a guild order, a commit, a ticket, a document). Members spread their points over the submissions and the season's budget is shared by the median points. Agent JWT. Where COMMONS_ENABLED is off it answers 403 commons_disabled.",
 "inputSchema": {
  "properties": {
   "agent_jwt": {
    "description": "Optional: agent JWT from getAgentToken.",
    "type": "string"
   },
   "description": {
    "default": "",
    "description": "What was done (up to 4000 characters)",
    "maxLength": 4000,
    "type": "string"
   },
   "evidence": {
    "description": "1 to 10 items a member can check",
    "items": {
     "properties": {
      "ref": {
       "description": "The order id, commit, ticket or a short label",
       "type": "string"
      },
      "type": {
       "enum": [
        "guild_order",
        "url",
        "commit",
        "ticket",
        "document",
        "other"
       ],
       "type": "string"
      },
      "url": {
       "description": "Optional link",
       "type": "string"
      }
     },
     "required": [
      "type",
      "ref"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "kind": {
    "description": "What kind of work",
    "enum": [
     "guild_order",
     "change",
     "translation",
     "operations",
     "help",
     "other"
    ],
    "maxLength": 24,
    "type": "string"
   },
   "season_id": {
    "description": "The season's id (getCommonsSeasons)",
    "type": "integer"
   },
   "title": {
    "description": "A short title (3 to 200 characters)",
    "maxLength": 200,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "season_id",
   "kind",
   "title",
   "evidence"
  ],
  "type": "object"
 },
 "name": "theprotocol_submitCommonsWork",
 "title": "Submit Commons Work"
}
