{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get the anime broadcast schedule (air times in JST), optionally for a single weekday (or the `unknown`/`other` buckets Tenrai uses for shows with no fixed weekly slot). `broadcast` is only present for currently-airing shows. Defaults to 25 results if `limit` is omitted; use `page` for further results.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "day": {
    "description": "Weekday to filter by, or `unknown`/`other` for shows with no fixed weekly slot. Omit for the whole week.",
    "enum": [
     "monday",
     "tuesday",
     "wednesday",
     "thursday",
     "friday",
     "saturday",
     "sunday",
     "unknown",
     "other"
    ],
    "type": "string"
   },
   "kids": {
    "description": "If true, exclude entries tagged as children's/kids content. Defaults to false.",
    "type": "boolean"
   },
   "limit": {
    "default": 25,
    "description": "Max results per page (1-50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "1-based page number for pagination (1-1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "sfw": {
    "description": "If true, exclude adult/explicit-rated entries (R+ Mild Nudity and up). Defaults to false (no filtering). Note: this alone still allows mainstream, safely-rated shows tagged with the Ecchi genre (fanservice) through \u2014 use `sfw_strict` to also exclude those.",
    "type": "boolean"
   },
   "sfw_strict": {
    "description": "If true, exclude adult/explicit-rated entries AND anything tagged with the Ecchi genre, even otherwise-mainstream/safely-rated shows. Stricter than `sfw` alone. Defaults to false.",
    "type": "boolean"
   },
   "unapproved": {
    "description": "If true, also include entries not yet approved by MAL's moderators (excluded by default). Defaults to false.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "get_anime_schedule",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "properties": {
     "current_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "has_next_page": {
      "type": "boolean"
     },
     "last_visible_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "aired": {
       "type": "string"
      },
      "airing": {
       "type": "boolean"
      },
      "broadcast": {
       "type": "string"
      },
      "demographics": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "episodes": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "genres": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "image_url": {
       "type": "string"
      },
      "mal_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "members": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "popularity": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "rank": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "rating": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "season": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "studios": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "synopsis": {
       "type": "string"
      },
      "themes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "title_english": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "year": {
       "maximum": 2100,
       "minimum": 1900,
       "type": "integer"
      }
     },
     "required": [
      "mal_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "page"
  ],
  "type": "object"
 },
 "title": "Get broadcast schedule"
}
