{
 "description": "List WordPress users",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "capabilities": {
    "description": "Limit to users with at least one of these capabilities",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "exclude": {
    "description": "Exclude these user IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "has_published_posts": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "true = only users with published posts, or a list of post types"
   },
   "include": {
    "description": "Limit to these user IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "offset": {
    "description": "Skip this many users (overrides page)",
    "type": "integer"
   },
   "order": {
    "default": "asc",
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "orderby": {
    "default": "name",
    "description": "Sort field",
    "enum": [
     "id",
     "include",
     "name",
     "registered_date",
     "slug",
     "include_slugs",
     "email",
     "url"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "integer"
   },
   "per_page": {
    "default": 20,
    "description": "Users per page (max 100)",
    "type": "integer"
   },
   "roles": {
    "description": "Limit to users with at least one of these roles",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "search": {
    "description": "Search term",
    "type": "string"
   },
   "search_columns": {
    "description": "Columns to search",
    "items": {
     "enum": [
      "email",
      "name",
      "id",
      "username",
      "slug"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "Limit to these slugs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "who": {
    "description": "'authors' = only users considered authors",
    "enum": [
     "authors"
    ],
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "wp_list_users"
}
