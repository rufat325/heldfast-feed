{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new run in an experiment",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "experimentId": {
    "description": "Experiment ID (defaults to MLFLOW_EXPERIMENT_ID)",
    "type": "string"
   },
   "runName": {
    "description": "Optional run name",
    "type": "string"
   },
   "startTime": {
    "description": "Unix timestamp (ms) of run start",
    "type": "number"
   },
   "tags": {
    "description": "Initial tags",
    "items": {
     "properties": {
      "key": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "create-run"
}
