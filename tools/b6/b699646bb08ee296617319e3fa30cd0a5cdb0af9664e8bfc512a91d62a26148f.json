{
 "description": "Search for products in the smart store selection. Returns products available for home delivery.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "page": {
    "description": "Page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Results per page (max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query (max 64 chars)",
    "maxLength": 64,
    "type": "string"
   },
   "sortBy": {
    "description": "Sort field",
    "enum": [
     "price",
     "name"
    ],
    "type": "string"
   },
   "withDetail": {
    "description": "Include discounted price, discount percent, and tags (slower)",
    "type": "boolean"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_products"
}
