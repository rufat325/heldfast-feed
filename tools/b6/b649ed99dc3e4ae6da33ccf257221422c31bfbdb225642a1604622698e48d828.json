{"annotations":{"openWorldHint":true},"description":"Pulls changes from a remote repository. Returns structured data with success status, summary, change statistics, conflicts, up-to-date and fast-forward indicators.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"autostash":{"description":"Stash/unstash around pull (--autostash)","type":"boolean"},"branch":{"description":"Branch to pull (default: current tracking branch)","maxLength":255,"type":"string"},"depth":{"description":"Shallow fetch depth (--depth)","type":"number"},"ffOnly":{"description":"Only fast-forward pulls (--ff-only)","type":"boolean"},"noCommit":{"description":"Pull without auto-committing (--no-commit)","type":"boolean"},"noVerify":{"description":"Bypass pre-merge hooks (--no-verify)","type":"boolean"},"path":{"description":"Repository path. Authoritative \u2014 when omitted, the server uses its own process working directory (its launch dir, not the caller's cwd). Callers in a git worktree or other directory MUST pass this explicitly to avoid operating on the wrong repo.","maxLength":4096,"type":"string"},"prune":{"description":"Remove stale remote-tracking refs before pulling (--prune)","type":"boolean"},"rebase":{"default":false,"description":"Use rebase instead of merge (--rebase)","type":"boolean"},"rebaseMode":{"description":"Control rebase behavior (--rebase=<mode>)","enum":["true","false","merges","interactive"],"type":"string"},"remote":{"default":"origin","description":"Remote name (default: \"origin\")","maxLength":255,"type":"string"},"squash":{"description":"Squash pull (--squash)","type":"boolean"},"strategy":{"description":"Merge strategy (--strategy), e.g. recursive, ort","maxLength":255,"type":"string"},"strategyOption":{"description":"Strategy-specific option (-X), e.g. theirs, ours","maxLength":255,"type":"string"}},"type":"object"},"name":"pull","outputSchema":{"$schema":"ht