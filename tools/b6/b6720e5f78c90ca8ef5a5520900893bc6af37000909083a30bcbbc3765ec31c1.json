{
 "description": "Update an existing CRM contact by ID. Any field can be updated.",
 "inputSchema": {
  "properties": {
   "company": {
    "type": "string"
   },
   "email": {
    "type": "string"
   },
   "full_name": {
    "type": "string"
   },
   "id": {
    "description": "Contact ID",
    "type": "string"
   },
   "notes": {
    "type": "string"
   },
   "phone": {
    "type": "string"
   },
   "stage": {
    "enum": [
     "lead",
     "qualified",
     "proposal",
     "won",
     "lost"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "crm_update_contact"
}
