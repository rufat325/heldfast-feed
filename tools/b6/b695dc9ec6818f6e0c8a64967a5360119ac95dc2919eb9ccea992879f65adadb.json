{
 "description": "Register up to 5 colour swatches to be dispatched with the customer's order. Swatches ship at order placement only \u2014 they are NOT sent as a standalone postal sample before purchase. Capped at 5 codes per order. If the customer asks for swatches before ordering, explain they ship with the blind and guide them to place their order first.",
 "inputSchema": {
  "properties": {
   "customer_email": {
    "type": "string"
   },
   "customer_name": {
    "type": "string"
   },
   "customer_phone": {
    "description": "Used as WhatsApp number",
    "type": "string"
   },
   "product_interest": {
    "description": "e.g. 'Roller Blockout' or 'Honeycomb'",
    "type": "string"
   },
   "suburb": {
    "description": "Optional delivery suburb",
    "type": "string"
   },
   "swatch_codes": {
    "description": "Optional specific colour codes; no count limit enforced by this handler",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "customer_name",
   "customer_email",
   "customer_phone",
   "product_interest"
  ],
  "type": "object"
 },
 "name": "request_swatch",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "estimated_delivery_days": {
    "additionalProperties": true,
    "properties": {
     "max": {
      "type": "number"
     },
     "min": {
      "type": "number"
     }
    },
    "required": [
     "min",
     "max"
    ],
    "type": "object"
   },
   "message": {
    "type": "string"
   },
   "request_id": {
    "type": "number"
   },
   "status": {
    "type": "string"
   },
   "swatch_count": {
    "type": "number"
   }
  },
  "required": [
   "request_id",
   "status",
   "estimated_delivery_days",
   "swatch_count",
   "message"
  ],
  "type": "object"
 }
}
