{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate expected attendance and shopping quantities from an invite list. Use when RSVPs start arriving; use party_budget to estimate costs.",
 "inputSchema": {
  "properties": {
   "children_pct": {
    "description": "Share of attendees who are children, 0-100 (default 0)",
    "type": "number"
   },
   "expected_decline_pct": {
    "description": "Expected share who decline, 0-100 (default 15)",
    "type": "number"
   },
   "invited": {
    "description": "People invited (1-1000)",
    "type": "number"
   }
  },
  "required": [
   "invited"
  ],
  "type": "object"
 },
 "name": "headcount_plan",
 "outputSchema": {
  "properties": {
   "cake_slices": {
    "description": "Number of cake slices needed",
    "type": "integer"
   },
   "drinks": {
    "description": "Number of drinks needed",
    "type": "integer"
   },
   "expected_attendance": {
    "description": "Estimated number of adults attending",
    "type": "integer"
   },
   "expected_children": {
    "description": "Estimated number of children attending",
    "type": "integer"
   },
   "favors": {
    "description": "Number of favors needed",
    "type": "integer"
   },
   "mains_portions": {
    "description": "Number of main course portions needed",
    "type": "integer"
   },
   "plates": {
    "description": "Number of plates needed",
    "type": "integer"
   }
  },
  "required": [
   "expected_attendance",
   "expected_children",
   "mains_portions",
   "drinks",
   "cake_slices",
   "favors",
   "plates"
  ],
  "type": "object"
 },
 "title": "Headcount plan"
}
