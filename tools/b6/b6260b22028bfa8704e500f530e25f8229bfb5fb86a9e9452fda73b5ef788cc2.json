{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Historically replay a cross-sectional screen at every bar. Matching instruments form an equal-weight long or short portfolio, entered at the next bar open and held to the following bar open, then re-screened. Use this when the question is whether repeatedly trading screener matches worked \u2014 a single-symbol backtest of coins that match today is not a substitute. Costs follow actual portfolio turnover, so an unchanged holding is not charged as a fresh round trip.",
 "inputSchema": {
  "properties": {
   "direction": {
    "description": "Default long.",
    "enum": [
     "long",
     "short"
    ],
    "type": "string"
   },
   "feeBps": {
    "description": "Per side. Default 4.",
    "type": "number"
   },
   "logic": {
    "description": "Default all.",
    "enum": [
     "all",
     "any"
    ],
    "type": "string"
   },
   "lookback": {
    "description": "Bars. Default 300.",
    "enum": [
     300,
     500,
     1000,
     1500
    ],
    "type": "number"
   },
   "manualSymbols": {
    "description": "Optional symbols forced into the universe before current-volume ranking.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "maxPositions": {
    "description": "Equal-weight slots, 1 to 50. Default 10.",
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "quote": {
    "description": "Default USDT.",
    "enum": [
     "USDT",
     "USDC",
     "FDUSD",
     "BTC",
     "ETH",
     "ALL"
    ],
    "type": "string"
   },
   "rules": {
    "items": {
     "properties": {
      "left": {
       "description": "e.g. {\"kind\":\"field\",\"field\":\"change5\"}, {\"kind\":\"indicator\",\"studyId\":\"rsi\",\"plotKey\":\"rsi\"}, or {\"kind\":\"formula\",\"name\":\"atrPct\",\"expression\":\"atr(14)/close*100\"}",
       "type": "object"
      },
      "operator": {
       "enum": [
        "above",
        "atOrAbove",
        "below",
        "atOrBelow",
        "equal",
        "notEqual",
        "crossesAbove",
        "crossesBelow",
        "rising",
        "falling"
       ],
       "type": "string"
      },
      "right": {
       "description": "A number, or another operand in the same form as left."
      }
     },
     "required": [
      "left",
      "operator",
      "right"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "slippageBps": {
    "description": "Per side. Default 1.",
    "type": "number"
   },
   "timeframe": {
    "description": "Defaults to the chart.",
    "type": "string"
   },
   "universeSize": {
    "description": "Default 50.",
    "enum": [
     20,
     50,
     100,
     200
    ],
    "type": "number"
   }
  },
  "required": [
   "rules"
  ],
  "type": "object"
 },
 "name": "screener_backtest"
}
