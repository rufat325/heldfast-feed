{
 "description": "Compare supplied own and competitor pages to find missing topics, weak coverage, format gaps, and buyer-stage gaps.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "competitors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "domain": {
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      },
      "pages": {
       "items": {
        "$ref": "#/properties/own_pages/items"
       },
       "maxItems": 100,
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "domain",
      "pages"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "focus_topics": {
    "default": [],
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "max_opportunities": {
    "default": 30,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "own_pages": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "avg_position": {
       "maximum": 100,
       "minimum": 1,
       "type": "number"
      },
      "backlinks": {
       "minimum": 0,
       "type": "number"
      },
      "buyer_stage": {
       "default": "awareness",
       "enum": [
        "awareness",
        "consideration",
        "decision",
        "implementation",
        "retention"
       ],
       "type": "string"
      },
      "description": {
       "maxLength": 500,
       "type": "string"
      },
      "estimated_traffic": {
       "minimum": 0,
       "type": "number"
      },
      "keywords": {
       "default": [],
       "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "page_type": {
       "default": "unknown",
       "enum": [
        "unknown",
        "homepage",
        "blog_post",
        "landing_page",
        "product",
        "software",
        "local_business",
        "comparison_page",
        "guide",
        "docs",
        "template",
        "tool",
        "case_study"
       ],
       "type": "string"
      },
      "ranking_queries": {
       "default": [],
       "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "search_volume": {
       "minimum": 0,
       "type": "number"
      },
      "title": {
       "maxLength": 180,
       "minLength": 1,
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url",
      "title"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "type": "string"
   }
  },
  "required": [
   "competitors"
  ],
  "type": "object"
 },
 "name": "agentseo_content_competitor_gap_matrix",
 "title": "AgentSEO Competitor Content Gap Matrix"
}
