{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search Crimp's catalog by name, manufacturer, model or ID. Returns stable catalog IDs and published component data; use get_component for terminals and full fields. Read-only; no AI model call.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "battery",
     "charger",
     "solar",
     "source",
     "engine",
     "distribution",
     "load",
     "monitor"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "maxLength": 160,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_components",
 "outputSchema": {
  "properties": {
   "data": {},
   "error": {
    "properties": {
     "code": {
      "type": "string"
     },
     "details": {},
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "metadata": {
    "properties": {
     "apiVersion": {
      "type": "string"
     },
     "engineVersion": {
      "type": "string"
     },
     "schemaVersion": {
      "type": "integer"
     }
    },
    "required": [
     "apiVersion",
     "engineVersion",
     "schemaVersion"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "tool": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool",
   "metadata"
  ],
  "type": "object"
 }
}
