{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Gravel Calculator"
 },
 "description": "Calculate gravel layer volume and US short tons from rectangle dimensions, circle diameter or total area, depth in inches and editable bulk density. (API Tool Calls, by Cowerx)",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "densityTonsPerCubicYard": 1.4,
    "depthInches": 3,
    "length": 10,
    "shape": "rectangle",
    "width": 8
   }
  ],
  "oneOf": [
   {
    "properties": {
     "shape": {
      "enum": [
       "rectangle"
      ],
      "type": "string"
     }
    },
    "required": [
     "length",
     "width"
    ]
   },
   {
    "properties": {
     "shape": {
      "enum": [
       "circle"
      ],
      "type": "string"
     }
    },
    "required": [
     "diameter"
    ]
   },
   {
    "properties": {
     "shape": {
      "enum": [
       "area"
      ],
      "type": "string"
     }
    },
    "required": [
     "area"
    ]
   }
  ],
  "properties": {
   "area": {
    "description": "Total bed area in square feet or square metres",
    "exclusiveMinimum": 0,
    "maximum": 1000000000000.0,
    "type": "number"
   },
   "densityTonsPerCubicYard": {
    "description": "Bulk density in US short tons (2000 lb) per cubic yard; default 1.4",
    "exclusiveMinimum": 0,
    "maximum": 10,
    "type": "number"
   },
   "depthInches": {
    "description": "Layer depth in inches",
    "exclusiveMinimum": 0,
    "maximum": 1200,
    "type": "number"
   },
   "diameter": {
    "description": "Circle diameter across the bed in selected unit",
    "exclusiveMinimum": 0,
    "maximum": 1000000.0,
    "type": "number"
   },
   "length": {
    "description": "Rectangle length in selected unit",
    "exclusiveMinimum": 0,
    "maximum": 1000000.0,
    "type": "number"
   },
   "shape": {
    "description": "Bed shape or already measured total area",
    "enum": [
     "rectangle",
     "circle",
     "area"
    ],
    "type": "string"
   },
   "unit": {
    "description": "Dimension unit; area uses its square; default ft",
    "enum": [
     "ft",
     "m"
    ],
    "type": "string"
   },
   "width": {
    "description": "Rectangle width in selected unit",
    "exclusiveMinimum": 0,
    "maximum": 1000000.0,
    "type": "number"
   }
  },
  "required": [
   "shape",
   "depthInches"
  ],
  "type": "object"
 },
 "name": "gravel_calculator",
 "outputSchema": {
  "description": "squareFeet, squareMetres, depthInches, cubicFeet, cubicYards, cubicMetres, formula and densityTonsPerCubicYard and tons (US short tons)",
  "type": "object"
 },
 "title": "Gravel Calculator"
}
