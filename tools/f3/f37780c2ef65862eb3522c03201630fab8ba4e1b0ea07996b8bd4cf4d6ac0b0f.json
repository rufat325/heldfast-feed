{
 "description": "OCR a Brazilian ID document (RG / CNH / CRLV / proof of residence / passport). Returns extracted structured fields per document type. POST /v1/documents/ocr.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "document_type": {
    "description": "Document type",
    "enum": [
     "rg",
     "cnh",
     "crlv",
     "proof_of_residence",
     "passport"
    ],
    "type": "string"
   },
   "image": {
    "description": "Base64-encoded JPEG/PNG or URL",
    "type": "string"
   }
  },
  "required": [
   "document_type",
   "image"
  ],
  "type": "object"
 },
 "name": "documents_ocr"
}
