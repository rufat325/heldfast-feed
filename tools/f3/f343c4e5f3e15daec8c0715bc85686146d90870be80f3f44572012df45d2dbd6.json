{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Demo catalog: illustrative roles, applications closed. Search the sample roles by keywords, company, work arrangement and minimum annual USD base salary. For real openings use search_jobs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "arrangement": {
    "enum": [
     "Remote",
     "Hybrid",
     "On-site"
    ],
    "type": "string"
   },
   "company": {
    "maxLength": 160,
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "minSalary": {
    "default": 0,
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 500,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "default": "",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "demo_search_jobs",
 "title": "Search demo roles"
}
