{
 "annotations": {
  "readOnlyHint": true,
  "title": "List incidents"
 },
 "description": "Search/list incidents over a time window with filters (status, service, priority, assignee, tags, sources, starred, SLO-affecting) and sorting. `start_time`, `end_time` (both ISO8601) and `owner_id` (a TEAM id \u2014 use squadcast_list_teams to find it) are REQUIRED. Squadcast: GET /v3/incidents/export.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignedTo": {
    "description": "Filter by assignee id(s) \u2192 assigned_to.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "endTime": {
    "description": "ISO8601 end of the window (required) \u2192 end_time.",
    "type": "string"
   },
   "isStarred": {
    "description": "Filter to starred incidents \u2192 is_starred.",
    "enum": [
     "yes",
     "no"
    ],
    "type": "string"
   },
   "ownerId": {
    "description": "Team id that owns the incidents (required) \u2192 owner_id. Use squadcast_list_teams to find it.",
    "type": "string"
   },
   "priority": {
    "description": "Filter by priority (e.g. P1..P5) \u2192 priority.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "services": {
    "description": "Filter by service id(s) \u2192 services.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sloAffecting": {
    "description": "Filter by SLO-affecting \u2192 slo_affecting.",
    "enum": [
     "yes",
     "no",
     ""
    ],
    "type": "string"
   },
   "sortBy": {
    "description": "Sort field \u2192 sort_by.",
    "enum": [
     "time",
     "priority"
    ],
    "type": "string"
   },
   "sources": {
    "description": "Filter by alert source(s) \u2192 sources.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "startTime": {
    "description": "ISO8601 start of the window (required) \u2192 start_time.",
    "type": "string"
   },
   "status": {
    "description": "Filter by incident status(es) \u2192 status.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tags": {
    "description": "Filter by tag(s) \u2192 tags.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "textFilter": {
    "description": "Free-text filter \u2192 textFilter.",
    "type": "string"
   }
  },
  "required": [
   "startTime",
   "endTime",
   "ownerId"
  ],
  "type": "object"
 },
 "name": "squadcast_list_incidents",
 "title": "List incidents"
}
