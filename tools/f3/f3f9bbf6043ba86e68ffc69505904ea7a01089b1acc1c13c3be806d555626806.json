{
 "description": "Create a new calendar event. Supports timed events, all-day events, and Google Meet integration.",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Alias of the Google account to target. Optional \u2014 defaults to the session/global default account, or the sole authenticated account. Run manage_accounts list to see available aliases.",
    "type": "string"
   },
   "attachments": {
    "description": "File attachments (max 25). For Drive files use the file's share URL as fileUrl.",
    "items": {
     "properties": {
      "fileUrl": {
       "description": "URL of the file to attach (required)",
       "type": "string"
      },
      "mimeType": {
       "description": "MIME type (optional; ignored for Drive files)",
       "type": "string"
      },
      "title": {
       "description": "Attachment title",
       "type": "string"
      }
     },
     "required": [
      "fileUrl"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "type": "array"
   },
   "attendees": {
    "description": "Email addresses of attendees",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "calendarId": {
    "description": "Calendar ID (default: primary)",
    "type": "string"
   },
   "conferenceType": {
    "description": "Add Google Meet link",
    "enum": [
     "hangoutsMeet"
    ],
    "type": "string"
   },
   "description": {
    "description": "Event description",
    "type": "string"
   },
   "end": {
    "description": "End time",
    "properties": {
     "date": {
      "type": "string"
     },
     "dateTime": {
      "type": "string"
     },
     "timeZone": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "location": {
    "description": "Event location",
    "type": "string"
   },
   "recurrence": {
    "description": "RRULE strings for recurring events",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sendUpdates": {
    "description": "Send notifications (default: none)",
    "enum": [
     "all",
     "externalOnly",
     "none"
    ],
    "type": "string"
   },
   "start": {
    "description": "Start time (use dateTime for timed events, date for all-day)",
    "properties": {
     "date": {
      "description": "Date for all-day events (YYYY-MM-DD)",
      "type": "string"
     },
     "dateTime": {
      "description": "RFC3339 timestamp (e.g., '2024-01-15T09:00:00-08:00')",
      "type": "string"
     },
     "timeZone": {
      "description": "Time zone (e.g., 'America/Los_Angeles')",
      "type": "string"
     }
    },
    "type": "object"
   },
   "summary": {
    "description": "Event title",
    "type": "string"
   },
   "visibility": {
    "description": "Event visibility",
    "enum": [
     "default",
     "public",
     "private",
     "confidential"
    ],
    "type": "string"
   }
  },
  "required": [
   "summary",
   "start",
   "end"
  ],
  "type": "object"
 },
 "name": "createCalendarEvent"
}
