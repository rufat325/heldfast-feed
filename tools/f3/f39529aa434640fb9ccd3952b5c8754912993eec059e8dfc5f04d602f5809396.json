{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get personalized recommendations"
 },
 "description": "Personalized coffee picks from flavor preferences (e.g. 'chocolate', 'berry', 'caramel'), a budget in USD, roast preference, and the brew gear you own.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brew_method": {
    "description": "What you brew with, e.g. 'espresso', 'pourover'",
    "maxLength": 120,
    "type": "string"
   },
   "budget": {
    "description": "Max price in USD per bag",
    "minimum": 0,
    "type": "number"
   },
   "limit": {
    "description": "Max results (default 5)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "preferences": {
    "description": "Flavors the drinker enjoys, e.g. ['chocolate','caramel','nutty']",
    "items": {
     "maxLength": 60,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "roast_level": {
    "description": "Roast level to filter by; omit to include all roasts",
    "enum": [
     "light",
     "medium-light",
     "medium",
     "medium-dark",
     "dark"
    ],
    "type": "string"
   }
  },
  "required": [
   "preferences"
  ],
  "type": "object"
 },
 "name": "get_recommendations"
}
