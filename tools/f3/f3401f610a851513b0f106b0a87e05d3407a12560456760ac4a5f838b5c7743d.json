{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Preview a shareable list"
 },
 "description": "Prepares a preview of 1\u201350 selected prospects from a campaign the user takes part in, and publishes nothing. The snapshot holds a list title, which is the campaign's name, the note, and for each person only a name, role, company, LinkedIn profile and, when includeRationale is true, a fit rating and why-matched explanation. The preview returns the complete snapshot a link would expose, with the previewKey that create_shortlist requires; a created link stays viewable for 30 days by anyone who has it, and can be revoked with revoke_shortlist.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "campaignId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "includeRationale": {
    "description": "When true, each person in the snapshot carries a fit rating (1\u20135, or null when none is stored) and a why-matched explanation; when false, the rating is null and the explanation empty.",
    "type": "boolean"
   },
   "leadIds": {
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "note": {
    "maxLength": 300,
    "type": "string"
   },
   "title": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "campaignId",
   "leadIds",
   "title",
   "note",
   "includeRationale"
  ],
  "type": "object"
 },
 "name": "preview_shortlist",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "previewKey": {
    "type": "string"
   },
   "snapshot": {
    "additionalProperties": {},
    "properties": {
     "note": {
      "type": "string"
     },
     "people": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "companyName": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "position": {
         "type": "string"
        },
        "profileUrl": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "rationale": {
         "type": "string"
        },
        "score": {
         "anyOf": [
          {
           "maximum": 5,
           "minimum": 1,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "name",
        "position",
        "companyName",
        "profileUrl",
        "rationale"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "title",
     "note",
     "people"
    ],
    "type": "object"
   }
  },
  "required": [
   "snapshot",
   "previewKey"
  ],
  "type": "object"
 },
 "title": "Preview a shareable list"
}
