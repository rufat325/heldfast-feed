{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "File a project brief on the client's behalf. Djaouad replies with a fixed quote within 24 hours. Use after confirming scope with the human.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budget": {
    "description": "e.g. '$3.5k - $9k'. A $900 audit is the entry point.",
    "maxLength": 40,
    "type": "string"
   },
   "contact": {
    "description": "Email or WhatsApp number to reply to",
    "maxLength": 160,
    "minLength": 4,
    "type": "string"
   },
   "features": {
    "default": [],
    "description": "Feature list, optional",
    "items": {
     "maxLength": 60,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "name": {
    "description": "Client name",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "description": "Anything else",
    "maxLength": 1000,
    "type": "string"
   },
   "project_type": {
    "description": "What should be built, e.g. 'AI support chatbot'",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "timeline": {
    "description": "e.g. 'ASAP', '2-4 weeks'",
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "name",
   "contact",
   "project_type"
  ],
  "type": "object"
 },
 "name": "submit_project_brief",
 "title": "Submit a project brief"
}
