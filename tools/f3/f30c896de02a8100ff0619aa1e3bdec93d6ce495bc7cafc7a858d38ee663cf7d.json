    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "w1": {
    "description": "Benefit weight",
    "type": "number"
   },
   "w2": {
    "description": "Penalty weight",
    "type": "number"
   },
   "w3": {
    "description": "Estimate weight",
    "type": "number"
   },
   "w4": {
    "description": "Risk weight",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "weight_set",
