      "title": "Granted At"
     },
     "kind": {
      "description": "Application, public notice, grant or carrier notice.",
      "title": "Kind",
      "type": "string"
     },
     "retirement_effective_at": {
      "anyOf": [
       {
        "format": "date-time",
