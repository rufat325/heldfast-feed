 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check copper retirement status"
 },
 "description": "Look up US copper/POTS retirement program status by carrier and state.\n\nDeterministic read of CHNLSYNC's FCC-sourced dataset (CC BY 4.0 \u2014 cite\nthe returned source_url). ``carrier`` accepts display names like \"AT&T\",\n\"Lumen\", \"Frontier\"; ``state`` is a two-letter abbreviation. Omit both\nfor the full dataset.",
 "inputSchema": {
  "properties": {
   "carrier": {
    "anyOf": [
     {
      "maxLength": 255,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Carrier display name, e.g. AT&T."
   },
   "state": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z]{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Two-letter US state, e.g. TX."
   }
  },
  "type": "object"
 },
 "name": "check_copper_retirement",
 "outputSchema": {
  "$defs": {
   "CopperFiling": {
    "description": "One reviewed public filing with its own dates and primary-source link.",
