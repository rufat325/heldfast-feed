   "brief": {
    "title": "Brief",
    "type": "string"
   },
   "lang": {
    "default": "en",
    "title": "Lang",
    "type": "string"
   },
   "origin": {
    "default": "",
    "title": "Origin",
    "type": "string"
   }
  },
  "required": [
   "brief"
  ],
  "title": "plan_tripArguments",
  "type": "object"
 },
