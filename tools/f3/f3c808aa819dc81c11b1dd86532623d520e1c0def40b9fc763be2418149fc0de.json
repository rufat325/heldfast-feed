{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Sample a live target across short resume/pause intervals to distinguish no observed progress, same-frame execution movement, and probable busy loops. Use it when a process appears hung but a single thread snapshot cannot distinguish blocking from spinning. Do not use it when resuming the target is unsafe; sampling perturbs scheduling and is not proof of application-level progress.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"intervalMs":{"default":250,"description":"Approximate execution interval between debugger samples.","maximum":5000,"minimum":25,"type":"integer"},"samples":{"default":4,"description":"Number of stopped runtime samples to collect across resume/pause intervals.","maximum":8,"minimum":2,"type":"integer"},"sessionId":{"description":"Optional DAP session ID. Omit to use the backward-compatible default session.","maxLength":64,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$","type":"string"},"threadId":{"description":"Preferred thread to sample; omit to follow the debugger-selected stopped thread.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"type":"object"},"name":"debug_progress_probe","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"captures":{"items":{"additionalProperties":{},"properties":{"index":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"signature":{"additionalProperties":{},"properties":{"frame":{"type":"string"},"instruction":{"type":"string"},"line":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"source":{"type":"string"},"threadId":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"}},"required":["threadId","frame","line"],"type":"object"},"topFrames":{"items":{"additionalProperties":{},"properties":{"line":{"ma