{
 "annotations": {
  "idempotentHint": false,
  "title": "Redo"
 },
 "description": "Step forward in the document history (equivalent to Ctrl/Cmd+Shift+Z). Only works if ps_undo was the last operation; making a fresh edit destroys the redo stack. Returns updated context.",
 "inputSchema": {
  "properties": {
   "steps": {
    "default": 1,
    "description": "Number of steps to redo (default: 1)",
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "ps_redo",
 "outputSchema": {
  "properties": {
   "availableRedoSteps": {
    "type": "number"
   },
   "context": {
    "type": "object"
   },
   "currentHistoryState": {
    "type": "string"
   },
   "redone": {
    "type": "boolean"
   },
   "remainingStates": {
    "type": "number"
   },
   "steps": {
    "type": "number"
   },
   "undone": {
    "type": "boolean"
   }
  },
  "type": "object"
 }
}
