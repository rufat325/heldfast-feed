{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Discover and deduplicate Objective-C class labels after exhaustively paging names, optionally filtering by literal substring. Returns at most 100 classes; inspect matching metadata and references next.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
   {
    "pattern": ""
   }
  ],
  "properties": {
   "pattern": {
    "default": "",
    "description": "Text or bounded pattern used to filter matching results.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_objc_classes",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "classes": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "address": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "required": [
        "address",
        "name"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "count",
     "classes"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Get Objc Classes"
}
