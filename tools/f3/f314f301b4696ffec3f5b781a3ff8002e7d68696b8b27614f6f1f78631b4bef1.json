{
 "description": "Check code style issues: indentation (tabs vs spaces), line length, trailing whitespace, final newline, consistent quotes, and semicolons. All rules are configurable.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "code": {
    "description": "The source code to check",
    "type": "string"
   },
   "rules": {
    "description": "Style rules to enforce (all enabled by default)",
    "properties": {
     "finalNewline": {
      "description": "Require final newline",
      "type": "boolean"
     },
     "indentSize": {
      "description": "Number of spaces per indent level (when using spaces)",
      "type": "number"
     },
     "indentation": {
      "description": "Expected indentation style",
      "enum": [
       "tabs",
       "spaces"
      ],
      "type": "string"
     },
     "maxLineLength": {
      "description": "Maximum allowed line length",
      "type": "number"
     },
     "quotes": {
      "description": "Expected quote style for strings",
      "enum": [
       "single",
       "double"
      ],
      "type": "string"
     },
     "semicolons": {
      "description": "Semicolon usage preference",
      "enum": [
       "always",
       "never"
      ],
      "type": "string"
     },
     "trailingWhitespace": {
      "description": "Disallow trailing whitespace",
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "check_code_style"
}
