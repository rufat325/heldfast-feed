{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "UCP Catalog search across independent WooCommerce merchants in KaliCart Global. catalog.query is free text; catalog.filters.categories accepts KaliCart canonical category values as returned in products[].categories (taxonomy \"kalicart\", e.g. \"home.bedroom.pillows\"); filters.price is in ISO 4217 minor units of catalog.context.currency (default EUR). Results are indexed snapshots with the seller on every variant; verify the chosen product with get_product before quoting price or stock.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "catalog": {
    "additionalProperties": true,
    "properties": {
     "attribution": {
      "additionalProperties": {},
      "type": "object"
     },
     "context": {
      "additionalProperties": true,
      "properties": {
       "address_country": {
        "type": "string"
       },
       "address_region": {
        "type": "string"
       },
       "currency": {
        "type": "string"
       },
       "intent": {
        "type": "string"
       },
       "language": {
        "type": "string"
       },
       "postal_code": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "filters": {
      "additionalProperties": true,
      "properties": {
       "available": {
        "type": "boolean"
       },
       "brand": {
        "type": "string"
       },
       "categories": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "color": {
        "type": "string"
       },
       "gender": {
        "enum": [
         "female",
         "male",
         "unisex"
        ],
        "type": "string"
       },
       "price": {
        "additionalProperties": true,
        "properties": {
         "max": {
          "minimum": 0,
          "type": "integer"
         },
         "min": {
          "minimum": 0,
          "type": "integer"
         }
        },
        "type": "object"
       }
      },
      "type": "object"
     },
     "pagination": {
      "additionalProperties": true,
      "properties": {
       "cursor": {
        "type": "string"
       },
       "limit": {
        "minimum": 1,
        "type": "integer"
       }
      },
      "type": "object"
     },
     "query": {
      "type": "string"
     },
     "signals": {
      "additionalProperties": {},
      "type": "object"
     }
    },
    "type": "object"
   },
   "meta": {
    "additionalProperties": true,
    "properties": {
     "ucp-agent": {
      "additionalProperties": true,
      "properties": {
       "profile": {
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "catalog"
  ],
  "type": "object"
 },
 "name": "search_catalog",
 "title": "Search products across merchants (UCP Catalog)"
}
