{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Generate favicon and app icons"
 },
 "description": "Use this when someone asks to create, replace, or install favicons, website icons, Apple touch icons, PWA icons, or app icons. Generates favicon.ico, PNG sizes, Apple/Android icons, theme-aware icons, manifests, environment variants, downloadable URLs, and an install snippet from one image, URL, or Iconify name. This creates hosted output files but does not edit the caller's project. Call search_icons first if you need a source.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiKey": {
    "description": "ft_\u2026 key from a previous call for a higher rate limit.",
    "type": "string"
   },
   "backgroundColor": {
    "anyOf": [
     {
      "enum": [
       "none",
       "white",
       "black"
      ],
      "type": "string"
     },
     {
      "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "type": "string"
     }
    ],
    "description": "none | white | black | #rrggbb"
   },
   "backgroundShape": {
    "enum": [
     "auto",
     "square",
     "circular"
    ],
    "type": "string"
   },
   "docsBorderColor": {
    "description": "Docs ring colour: accent | contrast | white | #rrggbb.",
    "type": "string"
   },
   "docsVariant": {
    "description": "Also emit the outlined docs-* tab-icon set + docs-manifest.json.",
    "type": "boolean"
   },
   "excludeFromGraph": {
    "description": "When true, skip recording this generation to analytics.",
    "type": "boolean"
   },
   "includeDevVariations": {
    "type": "boolean"
   },
   "includeThemeAwareFavicon": {
    "type": "boolean"
   },
   "primaryColor": {
    "description": "Hex color, e.g. #61dafb.",
    "type": "string"
   },
   "source": {
    "description": "Iconify name (prefix:name), an http(s) image URL, or a base64/data-URL image.",
    "type": "string"
   },
   "variantType": {
    "enum": [
     "none",
     "badge",
     "color"
    ],
    "type": "string"
   }
  },
  "required": [
   "source"
  ],
  "type": "object"
 },
 "name": "generate_iconset",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiKey": {
    "type": "string"
   },
   "appliedBackgroundShape": {
    "enum": [
     "square",
     "circular"
    ],
    "type": "string"
   },
   "circleFit": {
    "additionalProperties": false,
    "properties": {
     "basis": {
      "type": "string"
     },
     "clippedRatio": {
      "type": "number"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "clippedRatio",
     "basis",
     "note"
    ],
    "type": "object"
   },
   "excludedFromGraph": {
    "type": "boolean"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "blobUrl": {
       "type": "string"
      },
      "filename": {
       "type": "string"
      },
      "sizeBytes": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "filename",
      "blobUrl",
      "sizeBytes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "headSnippet": {
    "type": "string"
   },
   "install": {
    "type": "string"
   },
   "manifest": {
    "additionalProperties": {},
    "type": "object"
   },
   "note": {
    "type": "string"
   },
   "safariPinnedTab": {
    "additionalProperties": false,
    "properties": {
     "included": {
      "type": "boolean"
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "included"
    ],
    "type": "object"
   }
  },
  "required": [
   "files",
   "headSnippet",
   "manifest",
   "appliedBackgroundShape",
   "excludedFromGraph",
   "install"
  ],
  "type": "object"
 },
 "title": "Generate a favicon and app-icon set"
}
