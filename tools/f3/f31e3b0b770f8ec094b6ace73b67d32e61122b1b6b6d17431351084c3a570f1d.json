{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Request a first call"
 },
 "description": "Requests a 30-minute first call about one service at an open start time. Sends the person a confirmation email, which cannot be unsent. Nothing is booked until they confirm through the link in it.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "email": {
    "format": "email",
    "maxLength": 200,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "lang": {
    "default": "de",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 80,
    "minLength": 2,
    "pattern": "^\\p{L}[\\p{L}\\p{M} .'\u2019-]*$",
    "type": "string"
   },
   "notes": {
    "default": "",
    "maxLength": 500,
    "type": "string"
   },
   "service": {
    "enum": [
     "assessment",
     "automation",
     "agents",
     "training",
     "migration",
     "relaunch",
     "landing",
     "polish",
     "redesign",
     "template",
     "tool",
     "software",
     "cssfix",
     "foundation",
     "check",
     "audit",
     "seoanalysis",
     "linking",
     "content",
     "visibility",
     "fixes",
     "measurement",
     "booking",
     "assistant",
     "deterministic",
     "newsite",
     "care",
     "shopauto",
     "photos",
     "shopcheck",
     "tracking",
     "diagnosis"
    ],
    "type": "string"
   },
   "start": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "timeZone": {
    "default": "Europe/Zurich",
    "maxLength": 64,
    "type": "string"
   },
   "website": {
    "format": "uri",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "service",
   "start",
   "name",
   "email"
  ],
  "type": "object"
 },
 "name": "request_booking",
 "title": "Request a first call"
}
