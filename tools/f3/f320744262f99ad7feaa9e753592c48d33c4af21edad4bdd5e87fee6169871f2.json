{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Current news on any topic, in any language"
 },
 "description": "Current news on any topic in any language from the GDELT Project, which reads the world's press every 15 minutes: titles matched in their original script (\u534a\u5c0e\u4f53, \ubc18\ub3c4\uccb4, tarifs), optionally only articles in one language, newest first, with publisher, language and link; a US ticker searches the company's name. Window up to 30 days (default 72 hours). Carries GDELT's required citation. Input: query and/or symbol; optional language, limit, since_hours. $0.25 per call. Returns: query, symbol, language, edition{}, sources_searched[], sources_ok[], sources_failed[], articles[{title, url, source_name, source_url, published_at, summary, feed}], article_count, limit, since_hours, notes[], checked_at.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "language": {
    "description": "Optional BCP-47 language tag (en, ja, pt-BR, zh-Hant): every prose field of the answer is written in this language. Default: the language of the material or question.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   },
   "limit": {
    "description": "Default 20.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Topic words in any language (\u534a\u5c0e\u4f53, \ubc18\ub3c4\uccb4, tarifs douaniers).",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "region": {
    "description": "Accepted for compatibility; GDELT does not record a publisher's country, so use language.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "since_hours": {
    "description": "Only articles published within this many hours.",
    "maximum": 720,
    "minimum": 1,
    "type": "integer"
   },
   "symbol": {
    "description": "Optional US ticker (AAPL, MSFT): searches the company's name from the SEC ticker table.",
    "pattern": "^[A-Za-z0-9.\\-=^]{1,12}$",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "hubvibe_news_search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The 200 body of every paid /work call. `result` is the worker's own output (its schema is per route); everything else is the same on every /work route. A receipt for the job is at `receipt_url`.",
  "properties": {
   "attribution": {
    "description": "Present only when the result's text was machine-translated: the credit to show with it.",
    "items": {
     "description": "A credit.",
     "properties": {
      "text": {
       "description": "Credit.",
       "examples": [
        "Translated by Google"
       ],
       "type": "string"
      },
      "url": {
       "description": "Link.",
       "examples": [
        "https://translate.google.com"
       ],
       "type": "string"
      }
     },
     "required": [
      "text",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "billing_warning": {
    "description": "Present only when the charge was recorded with a caveat.",
    "examples": [
     "settlement pending"
    ],
    "type": "string"
   },
   "price_usd": {
    "description": "What this call cost, in USD.",
    "examples": [
     0.02
    ],
    "type": "number"
   },
   "provenance": {
    "description": "How the result was produced: which providers ran and how long each took.",
    "properties": {
     "attempts": {
      "description": "Provider attempts made, including retries and failovers.",
      "examples": [
       1
      ],
      "type": "integer"
     },
     "elapsed_ms": {
      "description": "Wall-clock milliseconds for the whole job.",
      "examples": [
       340
      ],
      "type": "integer"
     },
     "providers_used": {
      "description": "Providers that served the job.",
      "examples": [
       [
        "coinbase-advanced-trade-public"
       ]
      ],
      "items": {
       "description": "Provider name.",
       "examples": [
        "coinbase-advanced-trade-public"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "steps": {
      "description": "Every step the job ran, in order.",
      "items": {
       "description": "One step of the job.",
       "properties": {
        "ms": {
         "description": "Milliseconds the step took.",
         "examples": [
          312
         ],
         "type": "integer"
        },
        "ok": {
         "description": "Whether the step succeeded.",
         "examples": [
          true
         ],
         "type": "boolean"
        },
        "provider": {
         "description": "Provider that served the step.",
         "examples": [
          "coinbase-advanced-trade-public"
         ],
         "type": "string"
        },
        "reason": {
         "description": "Failure reason, on a failed step.",
         "examples": [
          "provider_timeout"
         ],
         "type": "string"
        },
        "step": {
         "description": "Step name inside the worker.",
         "examples": [
          "quote"
         ],
         "type": "string"
        }
       },
       "required": [
        "step",
        "ok",
        "ms"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "steps",
     "providers_used",
     "attempts",
     "elapsed_ms"
    ],
    "type": "object"
   },
   "receipt_id": {
    "description": "Receipt id for this job.",
    "examples": [
     "rcpt_9f1c2b3a4d5e6f70"
    ],
    "type": "string"
   },
   "receipt_url": {
    "description": "Where to fetch the machine-readable receipt (free, no payment).",
    "examples": [
     "/work/receipts/rcpt_9f1c2b3a4d5e6f70"
    ],
    "type": "string"
   },
   "result": {
    "properties": {
     "article_count": {
      "description": "Articles returned.",
      "examples": [
       20
      ],
      "type": "integer"
     },
     "articles": {
      "description": "Articles, newest first, duplicates by title removed.",
      "items": {
       "description": "One article.",
       "properties": {
        "feed": {
         "description": "Which source it came from.",
         "enum": [
          "gdelt"
         ],
         "examples": [
          "gdelt"
         ],
         "type": "string"
        },
        "language": {
         "description": "Article language (BCP-47).",
         "examples": [
          "ja"
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "published_at": {
         "description": "When GDELT first saw it (UTC, 15-minute batches).",
         "examples": [
          "2026-09-27T02:30:00Z"
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "source_name": {
         "description": "Publisher domain.",
         "examples": [
          "nikkei.com"
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "source_url": {
         "description": "Publisher site.",
         "examples": [
          "https://nikkei.com"
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "summary": {
         "description": "Summary; GDELT carries none, so null.",
         "examples": [
          null
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "title": {
         "description": "Headline in its original language.",
         "examples": [
          "\u534a\u5c0e\u4f53\u682a\u304c\u53cd\u767a\u3001\u95a2\u7a0e\u5354\u8b70\u306e\u9032\u5c55\u3067"
         ],
         "type": "string"
        },
        "url": {
         "description": "The publisher's article link.",
         "examples": [
          "https://www.nikkei.com/article/DGXZQO..."
         ],
         "type": "string"
        }
       },
       "required": [
        "title",
        "url",
        "source_name",
        "source_url",
        "published_at",
        "summary",
        "language",
        "feed"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "attribution": {
      "description": "The citation GDELT's licence requires with every use.",
      "properties": {
       "text": {
        "description": "Required citation.",
        "examples": [
         "Source: The GDELT Project"
        ],
        "type": "string"
       },
       "url": {
        "description": "Required link.",
        "examples": [
         "https://www.gdeltproject.org/"
        ],
        "type": "string"
       }
      },
      "required": [
       "text",
       "url"
      ],
      "type": "object"
     },
     "checked_at": {
      "description": "When this node read the source (UTC). Nothing here is cached.",
      "examples": [
       "2026-09-26T18:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
     },
     "language": {
      "description": "BCP-47 language asked for; null when none.",
      "examples": [
       "ja"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "language_filter": {
      "description": "Language the articles were limited to; null when every language was searched.",
      "examples": [
       "ja"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "limit": {
      "description": "Most articles asked for.",
      "examples": [
       20
      ],
      "type": "integer"
     },
     "notes": {
      "description": "Caveats; empty when none.",
      "examples": [
       []
      ],
      "items": {
       "description": "A caveat.",
       "examples": [
        "GDELT does not record a publisher's country, so region is not a filter."
       ],
       "type": "string"
      },
      "type": "array"
     },
     "query": {
      "description": "Topic searched, as given; null when only a symbol was asked.",
      "examples": [
       "\u534a\u5c0e\u4f53"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "since_hours": {
      "description": "Window searched, in hours.",
      "examples": [
       72
      ],
      "type": "integer"
     },
     "sources_failed": {
      "description": "Searches that did not answer, with the reason; never silently dropped.",
      "examples": [
       []
      ],
      "items": {
       "description": "A search that failed for this call.",
       "properties": {
        "reason": {
         "description": "Why it did not answer this call.",
         "examples": [
          "Symbol news covers US-listed tickers"
         ],
         "type": "string"
        },
        "source": {
         "description": "Search id.",
         "examples": [
          "gdelt:symbol:7203.T"
         ],
         "type": "string"
        }
       },
       "required": [
        "source",
        "reason"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "sources_ok": {
      "description": "Searches that answered.",
      "examples": [
       [
        "gdelt:query"
       ]
      ],
      "items": {
       "description": "Search id.",
       "examples": [
        "gdelt:query"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "sources_searched": {
      "description": "Searches this call ran.",
      "examples": [
       [
        "gdelt:query"
       ]
      ],
      "items": {
       "description": "Search id.",
       "examples": [
        "gdelt:query"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "symbol": {
      "description": "Ticker whose company name was searched; null when none.",
      "examples": [
       "AAPL"
      ],
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "query",
     "symbol",
     "language",
     "language_filter",
     "sources_searched",
     "sources_ok",
     "sources_failed",
     "articles",
     "article_count",
     "limit",
     "since_hours",
     "attribution",
     "notes",
     "checked_at"
    ],
    "type": "object"
   },
   "status": {
    "const": "ok",
    "description": "Present only on a delivered result.",
    "type": "string"
   },
   "worker": {
    "description": "Catalog name of the worker that ran.",
    "examples": [
     "market.quote"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "worker",
   "price_usd",
   "result",
   "provenance",
   "receipt_id",
   "receipt_url"
  ],
  "title": "news.search response",
  "type": "object"
 },
 "title": "Current news on any topic, in any language"
}
