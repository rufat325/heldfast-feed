{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Aggregate usage and cost for the caller's org: total cost in USD, tokens, and call counts. Fields are camelCase.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "end_at": {
    "description": "Window end (Unix ms).",
    "type": "number"
   },
   "kind": {
    "description": "Restrict to one usage kind.",
    "enum": [
     "model",
     "tool",
     "embedding",
     "search"
    ],
    "type": "string"
   },
   "org_id": {
    "description": "Org id; defaults to the caller's org.",
    "type": "string"
   },
   "start_at": {
    "description": "Window start (Unix ms).",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "skopik_usage_summary",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "usage": {
    "additionalProperties": {},
    "properties": {
     "inputTokens": {
      "type": [
       "number",
       "null"
      ]
     },
     "outputTokens": {
      "type": [
       "number",
       "null"
      ]
     },
     "toolCalls": {
      "type": [
       "number",
       "null"
      ]
     },
     "totalCostUsd": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "type": "object"
   }
  },
  "required": [
   "usage"
  ],
  "type": "object"
 },
 "title": "Usage summary"
}
