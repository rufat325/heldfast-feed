{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get all messages in a thread (conversation). Recommended over gmail_message_get for reading emails.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "default": "full",
    "description": "The format to return messages in",
    "enum": [
     "minimal",
     "full",
     "metadata"
    ],
    "type": "string"
   },
   "id": {
    "description": "The ID of the thread to retrieve",
    "type": "string"
   },
   "metadataHeaders": {
    "description": "When format is metadata, only include these headers",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "thread_get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "historyId": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "messages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "historyId": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "internalDate": {
       "type": "string"
      },
      "labelIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "payload": {},
      "sizeEstimate": {
       "type": "number"
      },
      "snippet": {
       "type": "string"
      },
      "threadId": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "threadId"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "title": "Get thread"
}
