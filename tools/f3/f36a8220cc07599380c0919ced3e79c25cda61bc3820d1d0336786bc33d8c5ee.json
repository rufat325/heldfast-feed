{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Create a shareable Extrabold Tools Gridfinity baseplate URL from exact baseplate settings. Use generate_gridfinity_grid when the user asks for a grid by rows and columns.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "advancedWarning": {
    "default": "",
    "type": "string"
   },
   "baseplateType": {
    "default": "normal",
    "type": "string"
   },
   "borderRadius": {
    "default": 4,
    "minimum": 0,
    "type": "number"
   },
   "bottomChamfer": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "bottomPadding": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "connectMarginCrossings": {
    "default": true,
    "description": "Also place a dovetail wherever a split edge crosses from grid cells into a margin region. Off: dovetails only at cell-to-cell crossings.",
    "type": "boolean"
   },
   "containerPresetId": {
    "default": "",
    "type": "string"
   },
   "dimensions": {
    "default": {
     "depth": 126,
     "width": 126
    },
    "properties": {
     "depth": {
      "default": 126,
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "width": {
      "default": 126,
      "exclusiveMinimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "edgeConnectorSides": {
    "default": {
     "back": true,
     "front": true,
     "left": true,
     "right": true
    },
    "properties": {
     "back": {
      "default": true,
      "type": "boolean"
     },
     "front": {
      "default": true,
      "type": "boolean"
     },
     "left": {
      "default": true,
      "type": "boolean"
     },
     "right": {
      "default": true,
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "enableEdgeConnectors": {
    "default": false,
    "type": "boolean"
   },
   "enablePlateNesting": {
    "default": false,
    "type": "boolean"
   },
   "gridAlignment": {
    "default": {
     "alignment": "center",
     "offsetX": 0,
     "offsetY": 0
    },
    "properties": {
     "alignment": {
      "default": "center",
      "type": "string"
     },
     "offsetX": {
      "default": 0,
      "type": "number"
     },
     "offsetY": {
      "default": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "gridUnitDepth": {
    "default": 42,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "gridUnitWidth": {
    "default": 42,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "linkOrigin": {
    "default": "mcp",
    "description": "Link origin tag added as the org query parameter for attribution.",
    "pattern": "^[a-z0-9_-]+$",
    "type": "string"
   },
   "magnetBaseHeight": {
    "default": 2.8,
    "minimum": 0,
    "type": "number"
   },
   "magnetDiameter": {
    "default": 6,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "magnetDirection": {
    "default": "top",
    "type": "string"
   },
   "magnetHeight": {
    "default": 2,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "magnetHoleStyle": {
    "default": "cylinder",
    "type": "string"
   },
   "marginType": {
    "default": "solid",
    "type": "string"
   },
   "outerBorderRadius": {
    "default": 4,
    "minimum": 0,
    "type": "number"
   },
   "overrideMaxOuterBorderRadius": {
    "default": false,
    "type": "boolean"
   },
   "partsConnector": {
    "default": "none",
    "description": "Experimental dovetails interlock split pieces without separate parts and use your printer tolerance for male tabs. They require Split to Build Plates and work with all baseplate types. Clips connect split seams and optional outer edges; the printable clip model is included (not compatible with Skeleton).",
    "type": "string"
   },
   "pieceSpacingMm": {
    "default": 3,
    "minimum": 0,
    "type": "number"
   },
   "plateMarginMm": {
    "default": 10,
    "minimum": 0,
    "type": "number"
   },
   "printer": {
    "properties": {
     "buildDepth": {
      "exclusiveMinimum": 0,
      "maximum": 3000,
      "type": "number"
     },
     "buildHeight": {
      "exclusiveMinimum": 0,
      "maximum": 3000,
      "type": "number"
     },
     "buildWidth": {
      "exclusiveMinimum": 0,
      "maximum": 3000,
      "type": "number"
     },
     "name": {
      "default": "MCP printer",
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "buildWidth",
     "buildDepth",
     "buildHeight"
    ],
    "type": "object"
   },
   "removeHolesOnSplitLines": {
    "default": true,
    "type": "boolean"
   },
   "screwHeadSize": {
    "default": 6,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "screwHoleSize": {
    "default": 3,
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "showAdvanced": {
    "default": false,
    "type": "boolean"
   },
   "sizingMode": {
    "default": "direct",
    "type": "string"
   },
   "splitOffMargins": {
    "default": false,
    "type": "boolean"
   },
   "splitStrategy": {
    "default": "fewerParts",
    "type": "string"
   },
   "splitToBuildplates": {
    "default": false,
    "type": "boolean"
   },
   "toggleMagnetReleaseHole": {
    "default": false,
    "type": "boolean"
   },
   "toggleMagnets": {
    "default": false,
    "type": "boolean"
   },
   "toggleScrewHoles": {
    "default": false,
    "type": "boolean"
   },
   "tolerance": {
    "default": "standard",
    "description": "Experimental fit setting saved per printer. For dovetails, 0 mm gives the largest male tab; higher values make it smaller, up to 0.5 mm. Also affects CLICKbase clips and magnet holes. Print the tolerance test package to choose a dovetail fit. Normal bin pockets keep fixed geometry; the included bin-fit sample is a reference check. Values: none = 0 mm, tight = 0.1 mm, standard = 0.2 mm, loose = 0.3 mm, very-loose = 0.4 mm, extra-loose = 0.5 mm.",
    "type": "string"
   },
   "topCutoff": {
    "default": 0.4,
    "minimum": 0,
    "type": "number"
   },
   "version": {
    "default": "5.3",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_gridfinity_baseplate_url",
 "title": "Create Gridfinity Baseplate URL"
}
