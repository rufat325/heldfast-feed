{
 "description": "Check whether ONE planned trip is legal on top of existing Schengen stays. Returns compliant/warning/over plus practical advice.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "existingTrips": {
    "default": [],
    "description": "Already planned or taken trips (inclusive dates, YYYY-MM-DD)",
    "items": {
     "properties": {
      "entry": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "exit": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      }
     },
     "required": [
      "entry",
      "exit"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "planned": {
    "description": "The trip to check",
    "properties": {
     "entry": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "exit": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     }
    },
    "required": [
     "entry",
     "exit"
    ],
    "type": "object"
   },
   "today": {
    "description": "Reference day; defaults to the current UTC date",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "planned"
  ],
  "type": "object"
 },
 "name": "check_trip",
 "title": "Check a planned trip"
}
