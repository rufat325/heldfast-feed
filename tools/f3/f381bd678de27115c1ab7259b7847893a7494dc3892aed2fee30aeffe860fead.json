{"_meta":{"openai/toolInvocation/invoked":"Spreadsheet ready","openai/toolInvocation/invoking":"Building the spreadsheet"},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Use this when the user wants invoices, bills or receipts put into an Excel spreadsheet. Builds an .xlsx workbook with one row per invoice, one row per line item, a sheet of arithmetic, missing-field and duplicate checks, and totals per currency, and returns a download link that works for 24 hours.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"invoices":{"description":"Every invoice, one entry each, with values exactly as printed on the document. Use null for anything not printed or not legible; never estimate.","items":{"properties":{"category":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}]},"currency":{"anyOf":[{"pattern":"^[A-Za-z]{3}$","type":"string"},{"type":"null"}],"description":"ISO 4217 code, e.g. GBP, USD, EUR."},"date":{"anyOf":[{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},{"type":"null"}],"description":"Invoice date as YYYY-MM-DD."},"description":{"anyOf":[{"maxLength":4000,"type":"string"},{"type":"null"}],"description":"One line on what the invoice is for."},"invoice_number":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}]},"line_items":{"items":{"properties":{"category":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}]},"description":{"description":"The line as printed.","maxLength":2000,"type":"string"},"net":{"anyOf":[{"maximum":999999999999,"minimum":-999999999999,"type":"number"},{"type":"null"}],"description":"Line amount before VAT."},"quantity":{"anyOf":[{"maximum":999999999999,"minimum":-999999999999,"type":"number"},{"type":"null"}]},"unit_price":{"anyOf":[{"maximum":999999999999,"minimum":-999999999999,"type":"number"},{"type":"null"}],"description":"Price for one unit, before VAT."},"vat":{"anyOf":[{"max