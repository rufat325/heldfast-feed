{
 "description": "Update a form",
 "inputSchema": {
  "properties": {
   "formId": {
    "example": "fm_8f3kq2",
    "type": "string"
   },
   "from_template": {
    "type": "string"
   },
   "if_exists": {
    "default": "error",
    "enum": [
     "error",
     "return"
    ],
    "type": "string"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "project": {
    "default": "default",
    "type": "string"
   },
   "schema": {
    "properties": {
     "changelog": {
      "description": "A short human note on what changed in this version, shown in the version history.",
      "type": "string"
     },
     "json_schema": {
      "additionalProperties": {},
      "description": "JSON Schema draft 2020-12 describing the submission data. `required` drives drift detection and mapping completeness.",
      "type": "object"
     },
     "ui": {
      "additionalProperties": {
       "additionalProperties": {},
       "type": "object"
      },
      "description": "Per-field rendering hints keyed by field name (label, placeholder, widget, options, order) \u2014 used to render embed snippets.",
      "type": "object"
     }
    },
    "required": [
     "json_schema"
    ],
    "type": "object"
   },
   "schema_mode": {
    "default": "observe",
    "enum": [
     "observe",
     "enforce",
     "managed"
    ],
    "type": "string"
   },
   "settings": {
    "properties": {
     "allowed_origins": {
      "default": [],
      "items": {
       "format": "uri",
       "type": "string"
      },
      "type": "array"
     },
     "honeypot_field": {
      "default": "_gotcha",
      "type": "string"
     },
     "rate_limit": {
      "properties": {
       "burst": {
        "default": 20,
        "exclusiveMinimum": 0,
        "type": "integer"
       },
       "per_minute": {
        "default": 10,
        "exclusiveMinimum": 0,
        "type": "integer"
       }
      },
      "type": "object"
     },
     "redirect_url": {
      "format": "uri",
      "type": [
       "string",
       "null"
      ]
     },
     "reply_to_field": {
      "type": [
       "string",
       "null"
      ]
     },
     "turnstile": {
      "properties": {
       "enabled": {
        "type": "boolean"
       },
       "secret": {
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "slug": {
    "pattern": "^[a-z0-9][a-z0-9-]{1,62}$/u",
    "type": "string"
   },
   "status": {
    "default": "active",
    "enum": [
     "active",
     "paused"
    ],
    "type": "string"
   },
   "tags": {
    "default": [],
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "formId"
  ],
  "type": "object"
 },
 "name": "forms_update"
}
