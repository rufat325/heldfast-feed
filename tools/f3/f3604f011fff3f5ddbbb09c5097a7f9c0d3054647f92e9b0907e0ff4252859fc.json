{
 "description": "Lista chamados da conta com filtros da API (paginado, 50 por pagina). Nao altera dados.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category_id": {
    "type": "string"
   },
   "column": {
    "description": "Campo de ordenacao. Padrao: protocol.",
    "type": "string"
   },
   "creation_date_ge": {
    "description": "Criacao >= YYYY-MM-DD HH:II:SS-TZ ou data dinamica.",
    "type": "string"
   },
   "creation_date_le": {
    "type": "string"
   },
   "customer_id": {
    "type": "string"
   },
   "customer_type_id": {
    "description": "I = id interno, E = email. Padrao I.",
    "enum": [
     "I",
     "E"
    ],
    "type": "string"
   },
   "department_id": {
    "type": "string"
   },
   "last_situation_ge": {
    "type": "string"
   },
   "last_situation_le": {
    "type": "string"
   },
   "last_update_ge": {
    "description": "Ultima modificacao >=. Periodo maximo 90 dias.",
    "type": "string"
   },
   "max_protocol": {
    "type": "integer"
   },
   "min_protocol": {
    "type": "integer"
   },
   "operator_id": {
    "type": "string"
   },
   "order": {
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "organization_id": {
    "type": "string"
   },
   "page": {
    "description": "Pagina. Ate 50 itens por pagina. Padrao: 1.",
    "minimum": 1,
    "type": "integer"
   },
   "priority": {
    "type": "string"
   },
   "show_stopwatch": {
    "maximum": 1,
    "minimum": 0,
    "type": "integer"
   },
   "show_tags": {
    "maximum": 1,
    "minimum": 0,
    "type": "integer"
   },
   "situation": {
    "description": "Situacoes separadas por virgula. 0 aguardando atendente; 1 nao iniciada; 2 aguardando cliente; 3 respondido pelo cliente; 4 cancelada; 5 finalizada; 6 atendente modificado; 7 apoio; 8-11 aprovacoes.",
    "type": "string"
   },
   "status_id": {
    "type": "string"
   },
   "truncate_body": {
    "maximum": 1,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "tomticket_list_tickets"
}
