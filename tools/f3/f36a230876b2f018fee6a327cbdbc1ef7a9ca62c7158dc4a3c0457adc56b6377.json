{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create Template"
 },
 "description": "Create a new template programmatically with layers. IMPORTANT: Each layer must have a 'layer' field (unique identifier/name), not 'name'. Valid layer types are: 'text', 'image', 'shape', 'rating'. Use 'shape' for rectangles, circles, and other shapes - shapes require an 'html' field with SVG content. For a multi-page or multi-size template (several sizes in one template), pass 'pages' instead of 'layers': each page carries its own width/height and its layers as an object keyed by layer name.",
 "inputSchema": {
  "properties": {
   "background": {
    "description": "Template background color (e.g., '#ffffff', 'rgb(255,255,255)', 'transparent')",
    "type": "string"
   },
   "duration": {
    "description": "Default video duration in milliseconds for MP4 renders (e.g., 5000 for 5 seconds). Used as fallback when no duration is specified at render time.",
    "type": "number"
   },
   "height": {
    "description": "Template height in pixels",
    "type": "number"
   },
   "layers": {
    "description": "Array of layer objects. Each layer MUST have 'layer' (unique name) and 'type' fields.",
    "items": {
     "properties": {
      "animation": {
       "description": "Animation config for video (MP4) renders. All time values are in milliseconds. Contains 'in' (entrance), 'loop', 'out' (exit), 'start' and 'end' timeline.",
       "properties": {
        "end": {
         "description": "Time in milliseconds when layer disappears (default: video duration)",
         "type": "integer"
        },
        "in": {
         "description": "Entrance animation",
         "properties": {
          "direction": {
           "description": "Direction",
           "enum": [
            "left",
            "right",
            "up",
            "down",
            "in",
            "out"
           ],
           "type": "string"
          },
          "duration": {
           "description": "Duration in milliseconds",
           "type": "integer"
          },
          "type": {
           "description": "Animation type",
           "enum": [
            "slide",
            "fade",
            "zoom",
            "rotate"
           ],
           "type": "string"
          },
          "writingStyle": {
           "description": "Text animation style",
           "enum": [
            "block",
            "word",
            "character"
           ],
           "type": "string"
          }
         },
         "type": "object"
        },
        "loop": {
         "description": "Looping animation",
         "properties": {
          "duration": {
           "description": "Duration in milliseconds per cycle",
           "type": "integer"
          },
          "type": {
           "description": "Animation type",
           "enum": [
            "spin",
            "pulse"
           ],
           "type": "string"
          }
         },
         "type": "object"
        },
        "out": {
         "description": "Exit animation",
         "properties": {
          "direction": {
           "description": "Direction",
           "enum": [
            "left",
            "right",
            "up",
            "down",
            "in",
            "out"
           ],
           "type": "string"
          },
          "duration": {
           "description": "Duration in milliseconds",
           "type": "integer"
          },
          "type": {
           "description": "Animation type",
           "enum": [
            "slide",
            "fade",
            "zoom"
           ],
           "type": "string"
          }
         },
         "type": "object"
        },
        "start": {
         "description": "Time in milliseconds when layer becomes visible (default: 0)",
         "type": "integer"
        }
       },
       "type": "object"
      },
      "background": {
       "description": "Background color/gradient (for shapes use this OR html with SVG)",
       "type": "string"
      },
      "border_color": {
       "description": "Border color",
       "type": "string"
      },
      "border_radius": {
       "description": "Border radius (e.g., '8px', '50%')",
       "type": "string"
      },
      "border_width": {
       "description": "Border width in pixels",
       "type": "number"
      },
      "color": {
       "description": "Text color (e.g., '#000000', 'rgba(0,0,0,1)')",
       "type": "string"
      },
      "fill": {
       "description": "SVG fill color",
       "type": "string"
      },
      "font_family": {
       "description": "Font family (e.g., 'Inter', 'Arial')",
       "type": "string"
      },
      "font_size": {
       "description": "Font size with unit (e.g., '24px', '2em')",
       "type": "string"
      },
      "font_weight": {
       "description": "Font weight (e.g., 'normal', 'bold', '600')",
       "type": "string"
      },
      "height": {
       "description": "Height in pixels",
       "type": "number"
      },
      "hide": {
       "description": "Whether layer is hidden",
       "type": "boolean"
      },
      "horizontal_align": {
       "description": "Horizontal text alignment",
       "enum": [
        "left",
        "center",
        "right"
       ],
       "type": "string"
      },
      "html": {
       "description": "SVG content for shape layers. Example: '<rect width=\"100%\" height=\"100%\" fill=\"#ff0000\"/>'",
       "type": "string"
      },
      "image_url": {
       "description": "Image URL (for image layers)",
       "type": "string"
      },
      "layer": {
       "description": "REQUIRED: Unique layer identifier/name (e.g., 'title', 'background', 'photo'). This is NOT 'name', use 'layer'!",
       "type": "string"
      },
      "letter_spacing": {
       "description": "Letter spacing (e.g., '1px', '0.05em')",
       "type": "string"
      },
      "line_height": {
       "description": "Line height (e.g., '1.4', '24px')",
       "type": "string"
      },
      "object_fit": {
       "description": "How image fits in container",
       "enum": [
        "cover",
        "contain",
        "fill"
       ],
       "type": "string"
      },
      "opacity": {
       "description": "Opacity from 0 to 1",
       "type": "number"
      },
      "order": {
       "description": "Layer stacking order (lower = behind)",
       "type": "number"
      },
      "rotation": {
       "description": "Rotation in degrees",
       "type": "number"
      },
      "stroke": {
       "description": "SVG stroke color",
       "type": "string"
      },
      "text": {
       "description": "Text content (for text layers)",
       "type": "string"
      },
      "type": {
       "description": "REQUIRED: Layer type. Use 'shape' for rectangles/circles (NOT 'rectangle'). Shapes need 'html' with SVG content.",
       "enum": [
        "text",
        "image",
        "shape",
        "rating"
       ],
       "type": "string"
      },
      "vertical_align": {
       "description": "Vertical text alignment",
       "enum": [
        "top",
        "center",
        "bottom"
       ],
       "type": "string"
      },
      "width": {
       "description": "Width in pixels",
       "type": "number"
      },
      "x": {
       "description": "X position in pixels",
       "type": "number"
      },
      "y": {
       "description": "Y position in pixels",
       "type": "number"
      }
     },
     "required": [
      "layer",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Template name",
    "type": "string"
   },
   "pages": {
    "description": "Pages for multi-page or multi-size templates (e.g. Instagram square, story and X landscape in ONE template, each with its own width/height). Use this INSTEAD of top-level 'layers'. Each page: 'page' (unique name), optional 'width'/'height' (fall back to the template size), and 'layers' as an OBJECT keyed by layer name (NOT an array). Same shape as get_template_pages returns.",
    "items": {
     "properties": {
      "height": {
       "description": "Page height in pixels (defaults to template height)",
       "type": "number"
      },
      "hide": {
       "description": "On update_template, true REMOVES the page from the template",
       "type": "boolean"
      },
      "layers": {
       "additionalProperties": {
        "properties": {
         "background": {
          "type": "string"
         },
         "color": {
          "type": "string"
         },
         "font_family": {
          "type": "string"
         },
         "font_size": {
          "description": "CSS size with unit, e.g. '48px'",
          "type": "string"
         },
         "height": {
          "type": "number"
         },
         "hide": {
          "type": "boolean"
         },
         "html": {
          "description": "SVG content for shape layers",
          "type": "string"
         },
         "image_url": {
          "type": "string"
         },
         "text": {
          "type": "string"
         },
         "type": {
          "description": "Layer type",
          "enum": [
           "text",
           "image",
           "shape",
           "rating"
          ],
          "type": "string"
         },
         "width": {
          "type": "number"
         },
         "x": {
          "type": "number"
         },
         "y": {
          "type": "number"
         }
        },
        "required": [
         "type"
        ],
        "type": "object"
       },
       "description": "Layers keyed by layer name: { \"title\": { \"type\": \"text\", \"text\": \"Hi\", ... } }",
       "type": "object"
      },
      "page": {
       "description": "Unique page name (e.g. 'Insta Story', 'X Landscape')",
       "type": "string"
      },
      "width": {
       "description": "Page width in pixels (defaults to template width)",
       "type": "number"
      }
     },
     "required": [
      "page",
      "layers"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "width": {
    "description": "Template width in pixels",
    "type": "number"
   }
  },
  "required": [
   "name",
   "width",
   "height"
  ],
  "type": "object"
 },
 "name": "create_template"
}
