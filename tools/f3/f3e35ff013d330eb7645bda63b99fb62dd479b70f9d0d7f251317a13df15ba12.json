{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Draw on a Napkin board"
 },
 "description": "Draws shapes, strokes, and labels on a board \u2014 diagram on a sketch, annotate a deck slide \u2014 and, via `updates` / `deletes`, changes or removes shapes that are already there (ids from napkin_boards_get; the fix for something you drew wrong). For NEW elements never compute absolute board coordinates: with `slide`, coordinates are slide-local \u2014 (0, 0) top-left to (960, 540) bottom-right of that slide. Without `slide` (sketches), (0, 0) is the top-left of the existing content \u2014 the same area `napkin_boards_view` renders, so place by what you saw there; on an empty board just start at (0, 0). Example \u2014 circle a slide's title and margin-note it:\n\n{\"boardId\": \"\u2026\", \"slide\": 2, \"elements\": [\n  {\"type\": \"ellipse\", \"x\": 60, \"y\": 40, \"w\": 400, \"h\": 90, \"color\": \"#dc2626\"},\n  {\"type\": \"arrow\", \"x\": 560, \"y\": 140, \"x2\": 470, \"y2\": 90, \"color\": \"#dc2626\"},\n  {\"type\": \"text\", \"x\": 575, \"y\": 130, \"w\": 260, \"text\": \"tighten this claim\", \"color\": \"#dc2626\"}\n]}\n\nAfter drawing, cite the board with `[[board:ID]]` alone on its own line.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "boardId": {
    "description": "Napkin board id.",
    "type": "string"
   },
   "deletes": {
    "description": "Ids of existing shapes to remove (from napkin_boards_get).",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "elements": {
    "description": "New elements to draw, painted in order.",
    "items": {
     "properties": {
      "align": {
       "description": "text only.",
       "enum": [
        "left",
        "center",
        "right"
       ],
       "type": "string"
      },
      "bold": {
       "description": "text only.",
       "type": "boolean"
      },
      "color": {
       "description": "Stroke / text hex color. Default near-black ink.",
       "maxLength": 30,
       "type": "string"
      },
      "fill": {
       "description": "rect/ellipse fill hex (default none); sticky tint.",
       "maxLength": 30,
       "type": "string"
      },
      "h": {
       "description": "Height (rect/ellipse/text).",
       "type": "number"
      },
      "points": {
       "description": "pen only: [x, y] pairs along the stroke (\u2265 2).",
       "items": {
        "items": [
         {
          "type": "number"
         },
         {
          "type": "number"
         }
        ],
        "type": "array"
       },
       "maxItems": 4000,
       "type": "array"
      },
      "size": {
       "description": "Stroke width / font size. Default 3.5 (\u2248 pen; text \u2248 17px).",
       "maximum": 200,
       "minimum": 0.5,
       "type": "number"
      },
      "text": {
       "description": "text/sticky content.",
       "maxLength": 2000,
       "type": "string"
      },
      "type": {
       "description": "What to draw.",
       "enum": [
        "pen",
        "rect",
        "ellipse",
        "line",
        "arrow",
        "text",
        "sticky"
       ],
       "type": "string"
      },
      "w": {
       "description": "Width (rect/ellipse/text).",
       "type": "number"
      },
      "x": {
       "description": "Top-left x (line/arrow: start x).",
       "type": "number"
      },
      "x2": {
       "description": "line/arrow: end x.",
       "type": "number"
      },
      "y": {
       "description": "Top-left y (line/arrow: start y).",
       "type": "number"
      },
      "y2": {
       "description": "line/arrow: end y.",
       "type": "number"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "slide": {
    "description": "1-based slide number (decks only) \u2014 makes coordinates slide-local.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "updates": {
    "description": "Existing shapes to change \u2014 move, resize, retext, restyle. Read napkin_boards_get first for ids and current geometry.",
    "items": {
     "properties": {
      "id": {
       "description": "Shape id from napkin_boards_get.",
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      "patch": {
       "description": "Fields to change on the shape (x, y, w, h, text, spans, style, \u2026) \u2014 absolute board coordinates as napkin_boards_get reports them. `spans` replaces the shape's whole span list.",
       "properties": {
        "crop": {
         "anyOf": [
          {
           "properties": {
            "bottom": {
             "maximum": 0.95,
             "minimum": 0,
             "type": "number"
            },
            "left": {
             "maximum": 0.95,
             "minimum": 0,
             "type": "number"
            },
            "right": {
             "maximum": 0.95,
             "minimum": 0,
             "type": "number"
            },
            "top": {
             "maximum": 0.95,
             "minimum": 0,
             "type": "number"
            }
           },
           "required": [
            "top",
            "right",
            "bottom",
            "left"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "from": {
         "properties": {
          "shapeId": {
           "maxLength": 64,
           "minLength": 1,
           "type": "string"
          },
          "x": {
           "type": "number"
          },
          "y": {
           "type": "number"
          }
         },
         "required": [
          "x",
          "y"
         ],
         "type": "object"
        },
        "group": {
         "anyOf": [
          {
           "maxLength": 64,
           "minLength": 1,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "h": {
         "type": "number"
        },
        "imageId": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "layout": {
         "anyOf": [
          {
           "properties": {
            "accent": {
             "maxLength": 60,
             "type": "string"
            },
            "key": {
             "maxLength": 80,
             "minLength": 1,
             "type": "string"
            },
            "picture": {
             "enum": [
              "fill",
              "whole"
             ],
             "type": "string"
            },
            "slots": {
             "additionalProperties": {
              "maxLength": 2000,
              "type": "string"
             },
             "propertyNames": {
              "enum": [
               "eyebrow",
               "headline",
               "subhead",
               "body",
               "points",
               "stat",
               "statLabel",
               "quote",
               "attribution",
               "cta",
               "footer",
               "image",
               "mark"
              ],
              "type": "string"
             },
             "type": "object"
            }
           },
           "required": [
            "key",
            "slots"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "link": {
         "anyOf": [
          {
           "maxLength": 2000,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "linkSlide": {
         "anyOf": [
          {
           "maxLength": 64,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "locked": {
         "type": "boolean"
        },
        "notes": {
         "maxLength": 20000,
         "type": "string"
        },
        "order": {
         "type": "number"
        },
        "pageNumber": {
         "type": "boolean"
        },
        "placeholder": {
         "maxLength": 100,
         "type": "string"
        },
        "points": {
         "items": {
          "type": "number"
         },
         "maxItems": 60000,
         "type": "array"
        },
        "refId": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "refLabel": {
         "maxLength": 200,
         "type": "string"
        },
        "refType": {
         "maxLength": 30,
         "minLength": 1,
         "type": "string"
        },
        "role": {
         "enum": [
          "title",
          "eyebrow",
          "body"
         ],
         "type": "string"
        },
        "rotation": {
         "type": "number"
        },
        "routing": {
         "enum": [
          "elbow",
          "straight"
         ],
         "type": "string"
        },
        "size": {
         "anyOf": [
          {
           "maxLength": 40,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "skipped": {
         "type": "boolean"
        },
        "slot": {
         "anyOf": [
          {
           "properties": {
            "after": {
             "maxLength": 20,
             "type": "string"
            },
            "before": {
             "maxLength": 20,
             "type": "string"
            },
            "name": {
             "enum": [
              "eyebrow",
              "headline",
              "subhead",
              "body",
              "points",
              "stat",
              "statLabel",
              "quote",
              "attribution",
              "cta",
              "footer",
              "image",
              "mark"
             ],
             "type": "string"
            }
           },
           "required": [
            "name"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "spans": {
         "items": {
          "properties": {
           "bold": {
            "type": "boolean"
           },
           "color": {
            "maxLength": 30,
            "minLength": 1,
            "type": "string"
           },
           "end": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
           },
           "font": {
            "maxLength": 60,
            "type": "string"
           },
           "italic": {
            "type": "boolean"
           },
           "link": {
            "maxLength": 2000,
            "type": "string"
           },
           "scale": {
            "maximum": 4,
            "minimum": 0.2,
            "type": "number"
           },
           "start": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
           },
           "strike": {
            "type": "boolean"
           },
           "underline": {
            "type": "boolean"
           }
          },
          "required": [
           "start",
           "end"
          ],
          "type": "object"
         },
         "maxItems": 200,
         "type": "array"
        },
        "style": {
         "description": "Only the style fields to change \u2014 the rest of the shape's style is kept. stroke = text/outline color, fill = background, textSize = font size inside a shape (size is font size on a text block, stroke width elsewhere), font, bold, italic, opacity, align, valign, radius, \u2026",
         "properties": {
          "align": {
           "enum": [
            "left",
            "center",
            "right"
           ],
           "type": "string"
          },
          "autoFit": {
           "type": "boolean"
          },
          "bold": {
           "type": "boolean"
          },
          "caps": {
           "type": "boolean"
          },
          "dash": {
           "anyOf": [
            {
             "enum": [
              "dashed",
              "dotted",
              "long",
              "dashdot"
             ],
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "fill": {
           "maxLength": 30,
           "minLength": 1,
           "type": "string"
          },
          "font": {
           "maxLength": 60,
           "type": "string"
          },
          "italic": {
           "type": "boolean"
          },
          "lineHeight": {
           "maximum": 3,
           "minimum": 0.8,
           "type": "number"
          },
          "opacity": {
           "maximum": 1,
           "minimum": 0,
           "type": "number"
          },
          "radius": {
           "maximum": 400,
           "minimum": 0,
           "type": "number"
          },
          "size": {
           "maximum": 200,
           "minimum": 0.5,
           "type": "number"
          },
          "strike": {
           "type": "boolean"
          },
          "stroke": {
           "maxLength": 30,
           "minLength": 1,
           "type": "string"
          },
          "textSize": {
           "maximum": 80,
           "minimum": 0.5,
           "type": "number"
          },
          "tracking": {
           "maximum": 1,
           "minimum": -0.1,
           "type": "number"
          },
          "underline": {
           "type": "boolean"
          },
          "valign": {
           "enum": [
            "top",
            "middle",
            "bottom"
           ],
           "type": "string"
          }
         },
         "type": "object"
        },
        "text": {
         "maxLength": 10000,
         "type": "string"
        },
        "theme": {
         "maxLength": 40,
         "type": "string"
        },
        "to": {
         "properties": {
          "shapeId": {
           "maxLength": 64,
           "minLength": 1,
           "type": "string"
          },
          "x": {
           "type": "number"
          },
          "y": {
           "type": "number"
          }
         },
         "required": [
          "x",
          "y"
         ],
         "type": "object"
        },
        "w": {
         "type": "number"
        },
        "x": {
         "type": "number"
        },
        "y": {
         "type": "number"
        },
        "z": {
         "type": "number"
        }
       },
       "type": "object"
      }
     },
     "required": [
      "id",
      "patch"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "workspace": {
    "description": "Workspace slug. Personal tokens with no default workspace MUST pass this; tokens with a default can override per call. Ignored for workspace API keys.",
    "type": "string"
   }
  },
  "required": [
   "boardId"
  ],
  "type": "object"
 },
 "name": "napkin_draw",
 "title": "Draw on a Napkin board"
}
