{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the public-safe state of a game session. The session token grants access only to that session.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "sessionId": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   },
   "sessionToken": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "sessionToken"
  ],
  "type": "object"
 },
 "name": "arcade_read_game",
 "title": "Read the current game state"
}
