{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create asset document"
 },
 "description": "Create an asset document record (after uploading the file via create_upload_url). Requires asset_documents:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset_id": {
    "description": "Asset ID this document belongs to (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "category": {
    "description": "Document category",
    "enum": [
     "om",
     "commissioning",
     "warranty",
     "installation",
     "specification",
     "other"
    ],
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "file_path": {
    "description": "Storage path from upload URL response (required)",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "file_size": {
    "description": "File size in bytes",
    "minimum": 0,
    "type": "number"
   },
   "file_type": {
    "description": "MIME type",
    "maxLength": 200,
    "type": "string"
   },
   "name": {
    "description": "Document name (required)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "user_id": {
    "description": "Uploader user ID",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "name",
   "file_path",
   "asset_id"
  ],
  "type": "object"
 },
 "name": "create_asset_document",
 "title": "Create asset document"
}
