{
 "description": "Publish or update a marketplace listing. Requires ARISPAY_API_KEY (ap_test_ / ap_live_). Prices are integer cents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "args": {
    "description": "For mcp-stdio args",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "capabilities": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "command": {
    "description": "For mcp-stdio, e.g. \"npx\"",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "envKeys": {
    "description": "Env vars the installer must set",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "homepage": {
    "type": "string"
   },
   "name": {
    "description": "Display name",
    "type": "string"
   },
   "pricingAmount": {
    "description": "Cents, for x402 pricing",
    "type": "integer"
   },
   "pricingCurrency": {
    "type": "string"
   },
   "pricingModel": {
    "enum": [
     "free",
     "x402",
     "apikey",
     "subscription"
    ],
    "type": "string"
   },
   "pricingPer": {
    "enum": [
     "call",
     "session",
     "month"
    ],
    "type": "string"
   },
   "readme": {
    "type": "string"
   },
   "repository": {
    "type": "string"
   },
   "slug": {
    "description": "Unique slug, e.g. \"mycompany/booking\" (lowercase, hyphens)",
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "transport": {
    "enum": [
     "mcp-stdio",
     "mcp-http",
     "http-x402",
     "http"
    ],
    "type": "string"
   },
   "url": {
    "description": "For mcp-http / http-x402 / http",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "name",
   "transport"
  ],
  "type": "object"
 },
 "name": "publish_agent"
}
