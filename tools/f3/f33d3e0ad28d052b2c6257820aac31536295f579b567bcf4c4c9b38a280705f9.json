  "properties": {
   "prompt_id": {
    "description": "Prompt ID or slug",
    "type": "string"
   },
   "version_id": {
    "description": "Version UUID to retrieve",
    "type": "string"
   }
  },
  "required": [
   "prompt_id",
   "version_id"
  ],
  "type": "object"
 },
 "name": "get_prompt_version",
 "outputSchema": {
