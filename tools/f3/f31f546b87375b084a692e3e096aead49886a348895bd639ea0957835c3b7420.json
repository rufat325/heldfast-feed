{"_meta":{"securitySchemes":[{"scopes":["mcp"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Send a message"},"description":"Send a text message as the person: into a conversation they are in\n(`conversation_id`), or to a person (`to_person_id`), which opens or\nreuses their direct conversation. A first message to someone who does not\nfollow them is a request the other person accepts first. Blocked people\ncannot be messaged. Pass the same `client_id` (a UUID) to retry\nsafely.","inputSchema":{"properties":{"body":{"title":"Body","type":"string"},"client_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Client Id"},"conversation_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Conversation Id"},"to_person_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"To Person Id"}},"required":["body"],"title":"send_messageArguments","type":"object"},"name":"send_message","outputSchema":{"properties":{"conversation_id":{"title":"Conversation Id","type":"string"},"link":{"title":"Link","type":"string"},"message_id":{"title":"Message Id","type":"string"},"sent_at":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Sent At"},"summary":{"title":"Summary","type":"string"},"thread_status":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Thread Status"}},"required":["summary","message_id","conversation_id","link"],"title":"Sent","type":"object"},"securitySchemes":[{"scopes":["mcp"],"type":"oauth2"}],"title":"Send a message"}
