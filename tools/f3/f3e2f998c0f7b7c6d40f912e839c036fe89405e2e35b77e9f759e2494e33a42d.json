{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"Find rentable fields near a location. With a date, returns only fields with open slots that day (at start_time if given), each with a booking_url.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"city":{"description":"Used when lat/lng are not given","maxLength":100,"type":"string"},"date":{"description":"YYYY-MM-DD, in the field's local timezone","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"duration":{"default":60,"description":"Booking length in minutes","maximum":300,"minimum":30,"multipleOf":30,"type":"integer"},"lat":{"maximum":90,"minimum":-90,"type":"number"},"lng":{"maximum":180,"minimum":-180,"type":"number"},"radius_miles":{"default":25,"maximum":100,"minimum":1,"type":"number"},"size":{"enum":["5v5","7v7","9v9","11v11"],"type":"string"},"start_time":{"description":"HH:mm, 24-hour","pattern":"^([01]\\d|2[0-3]):[0-5]\\d$","type":"string"},"state":{"description":"Two-letter US state code, e.g. TX","maxLength":50,"type":"string"},"surface":{"enum":["Natural Grass","Artificial Turf","Indoor"],"type":"string"}},"type":"object"},"name":"search_fields","title":"Search fields"}
