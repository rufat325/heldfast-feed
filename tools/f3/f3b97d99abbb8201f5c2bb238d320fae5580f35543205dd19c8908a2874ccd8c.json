{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Read one Graunt catalog packet by id. Returns its title, description, price and whether an account is needed, its seller-declared rights, and its public URL.",
 "inputSchema": {
  "properties": {
   "id": {
    "description": "The packet listing id.",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "fetch",
 "outputSchema": {
  "properties": {
   "id": {
    "type": "string"
   },
   "metadata": {
    "properties": {
     "acquisition_mode": {
      "type": "string"
     },
     "asset_class": {
      "type": "string"
     },
     "category": {
      "type": "string"
     },
     "currency": {
      "enum": [
       "usd"
      ],
      "type": "string"
     },
     "free_access_grant_url": {
      "description": "Present only when the packet can be taken with no account: POST it for a short-lived grant, then GET the download_url in its response.",
      "type": "string"
     },
     "payment_required": {
      "type": "boolean"
     },
     "price_cents": {
      "minimum": 0,
      "type": "integer"
     },
     "publisher": {
      "type": "string"
     },
     "registration_required": {
      "type": "boolean"
     },
     "rights_passport_summary": {
      "properties": {
       "citation_required": {
        "type": "boolean"
       },
       "license_family": {
        "type": "string"
       },
       "no_redistribute": {
        "type": "boolean"
       },
       "no_train": {
        "type": "boolean"
       },
       "personal_data_sensitive": {
        "type": "boolean"
       },
       "redistribution_allowed": {
        "type": "boolean"
       },
       "training_allowed": {
        "type": "boolean"
       }
      },
      "required": [
       "license_family",
       "training_allowed",
       "redistribution_allowed",
       "citation_required",
       "no_train",
       "no_redistribute",
       "personal_data_sensitive"
      ],
      "type": "object"
     }
    },
    "required": [
     "price_cents",
     "currency",
     "acquisition_mode",
     "registration_required",
     "payment_required",
     "rights_passport_summary"
    ],
    "type": "object"
   },
   "text": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "title",
   "text",
   "url",
   "metadata"
  ],
  "type": "object"
 },
 "title": "Read a Graunt packet"
}
