  "readOnlyHint": true,
  "title": "chainpeek: Hyperliquid perp funding rates, hourly and annualised, with up to 7 days of history"
 },
 "description": "chainpeek: Use when an agent needs what a Hyperliquid perp costs to hold, or whether funding is flipping, before sizing a trade. For Hyperliquid against dYdX use compare_funding_rates; for the best pair over five venues use rank_funding_carry. Returns Hyperliquid perp funding: top markets by absolute funding (hourly and annualised, mark, open interest, 24 h volume), or one `symbol` with up to 7 days of hourly history. Hyperliquid perps only; cached up to 60 s; annualised = hourly x 24 x 365. Data only, not trading advice. Unknown symbol or bad input is a 422 (not charged). Typically 0.3-2 s. Price: USD 0.002. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/perp-funding-rates-api.html",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 10,
    "description": "Markets returned when symbol is omitted, 1-50 (default 10).",
    "maximum": 50,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "min_volume_usd": {
    "default": 0,
    "description": "Skip markets with less 24 h volume (USD), to hide thin markets. Default 0.",
    "maximum": 10000000000000.0,
    "minimum": 0,
    "title": "Min Volume Usd",
    "type": "number"
   },
   "symbol": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z0-9._-]{1,20}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional perp symbol such as BTC or kPEPE: returns its current funding and up to 7 days of hourly history. Omit for the top markets.",
    "title": "Symbol"
   }
  },
