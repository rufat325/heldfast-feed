{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new recipe in Nextcloud Cookbook with schema.org Recipe format.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cookTime": {
    "description": "Cooking time in ISO 8601 duration (e.g., PT1H)",
    "type": "string"
   },
   "description": {
    "description": "Brief description",
    "type": "string"
   },
   "image": {
    "description": "Image URL",
    "type": "string"
   },
   "keywords": {
    "description": "Comma-separated keywords (e.g., 'pasta,italian')",
    "type": "string"
   },
   "name": {
    "description": "Recipe name",
    "type": "string"
   },
   "nutrition": {
    "description": "Nutrition information",
    "properties": {
     "calories": {
      "description": "Calories (e.g., '450 kJ')",
      "type": "string"
     },
     "carbohydrateContent": {
      "description": "Carbohydrates (e.g., '2 g')",
      "type": "string"
     },
     "fatContent": {
      "description": "Fat (e.g., '10 g')",
      "type": "string"
     },
     "proteinContent": {
      "description": "Protein (e.g., '3 g')",
      "type": "string"
     },
     "sugarContent": {
      "description": "Sugar (e.g., '12 g')",
      "type": "string"
     }
    },
    "type": "object"
   },
   "prepTime": {
    "description": "Preparation time in ISO 8601 duration (e.g., PT30M)",
    "type": "string"
   },
   "recipeCategory": {
    "description": "Category (e.g., 'Easy', 'Dessert')",
    "type": "string"
   },
   "recipeIngredient": {
    "description": "List of ingredients",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recipeInstructions": {
    "description": "Step-by-step instructions",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recipeYield": {
    "description": "Number of servings",
    "type": "number"
   },
   "tool": {
    "description": "Kitchen tools needed",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "totalTime": {
    "description": "Total time in ISO 8601 duration",
    "type": "string"
   },
   "url": {
    "description": "Source URL",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_recipe",
 "title": "Create Recipe"
}
