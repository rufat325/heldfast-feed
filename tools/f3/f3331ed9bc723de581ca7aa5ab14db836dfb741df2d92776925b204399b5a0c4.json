{
 "description": "View npm configuration (read-only for safety)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action: list (show all config), get (get specific key)",
    "enum": [
     "list",
     "get"
    ],
    "type": "string"
   },
   "key": {
    "description": "Config key to get (required for get action)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "config"
}
