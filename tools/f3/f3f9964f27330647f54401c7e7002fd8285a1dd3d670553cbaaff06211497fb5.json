{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a booking"
 },
 "description": "Creates a new appointment on the connected Nexwin account and emails the customer a confirmation. Executes immediately. Get teamMemberId and timezone from list_team_members first. Online bookings require customerEmail and create a Zoom meeting; in-person bookings need customerEmail or customerPhone. Fails if the team member is already booked at that time.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customerEmail": {
    "type": "string"
   },
   "customerName": {
    "type": "string"
   },
   "customerPhone": {
    "type": "string"
   },
   "endTime": {
    "description": "ISO 8601 with UTC offset, e.g. 2026-09-20T15:00:00+10:00",
    "type": "string"
   },
   "meetingAddress": {
    "description": "For in_person bookings",
    "type": "string"
   },
   "meetingType": {
    "enum": [
     "online",
     "in_person"
    ],
    "type": "string"
   },
   "startTime": {
    "description": "ISO 8601 with UTC offset, e.g. 2026-09-20T14:00:00+10:00",
    "type": "string"
   },
   "teamMemberId": {
    "description": "From list_team_members",
    "type": "string"
   },
   "timezone": {
    "description": "IANA timezone, e.g. Australia/Sydney \u2014 use the team member's timezone from list_team_members",
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "teamMemberId",
   "title",
   "startTime",
   "endTime",
   "timezone",
   "meetingType",
   "customerName"
  ],
  "type": "object"
 },
 "name": "create_booking",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_environment": {
    "description": "The Nexwin country and environment that supplied the result",
    "type": "string"
   },
   "appointmentId": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "_environment"
  ],
  "type": "object"
 },
 "title": "Create a booking"
}
