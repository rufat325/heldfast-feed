{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"\ub178\uc0ac\ud611\uc758\ud68c \uc124\uce58\u00b7\uc120\ucd9c\u00b7\uc2e0\uace0 \uc11c\ub958\ub97c outDir \uc5d0 PDF\u00b7\ud55c\uae00(hwpx)\ub85c \ub9cc\ub4e0\ub2e4: 00 \ud611\uc758\ud68c\uaddc\uc815 \uacac\ubcf8(\uc785\ub825\uac12\uc73c\ub85c \uce78\uc744 \ucc44\uc6b0\uace0 \ubaa8\ub974\ub294 \uce78\uc740 \u25cb\u25cb, \uacfc\ubc18\uc218 \ub178\ub3d9\uc870\ud569\u00b7\uc120\uac70\uad6c\u00b7\uc704\uc6d0\uc120\uac70\uc778\u00b7\uacf5\ub3d9\uc758\uc7a5\uc740 \uc785\ub825\uc5d0 \ub530\ub77c \ud55c \uac00\uc9c0\ub9cc \ub0a8\uae40) \u00b7 01 \uc124\uce58\uc758\ubb34 \ud655\uc778\uc11c \u00b7 02 \uc120\ucd9c\ubc29\uc2dd \ud655\uc778\uc11c \u00b7 03 \uc120\uac70\uad00\ub9ac\uaddc\uc815 \u00b7 04 \uc120\uac70\uc778\uba85\ubd80(\ube48 \uc904) \u00b7 05 \uc815\uc871\uc218 \ud655\uc778\uc11c \u00b7 06 \ub2f9\uc120\uacf5\uace0 \u00b7 07 \uadfc\ub85c\uc790\ub300\ud45c \uacb8\uc784 \uc120\ucd9c \ud655\uc778\uc11c(\uacb8\uc784\uc77c \ub54c) \u00b7 08 \ud68c\uc758 \uc18c\uc9d1\ud1b5\ubcf4\uc11c \u00b7 09 \uc548\uac74 \uad6c\ubd84\ud45c \u00b7 10 \uace0\ucda9\ucc98\ub9ac\uc704\uc6d0 \uc120\uc784 \uc758\uacb0\uc11c \u00b7 11 \uace0\ucda9\ucc98\ub9ac \uc6b4\uc601\uc9c0\uce68 \u00b7 12 \uc704\ucd09\ud1b5\uc9c0\uc11c(\uacfc\ubc18\uc218 \ub178\ub3d9\uc870\ud569\uc77c \ub54c) \u00b7 13 \ud611\uc758\ud68c\uaddc\uc815 \ud544\uc218\uae30\uc7ac \uc810\uac80\ud45c \u00b7 14 \ub178\ub3d9\ud3ec\ud138 \uc81c\ucd9c \uc785\ub825\uac12(SN012 \uc2e0\uccad \ud654\uba74 \uce78\uacfc \ucc44\uc6b8 \uac12). \uacfc\ubc18\uc218 \ub178\ub3d9\uc870\ud569\uc774\uba74 \uc120\uac70 \uc11c\ub958(03~06)\ub97c \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4. election \uc744 \uc8fc\uba74 05 \uc5d0 \uc815\uc871\uc218 \uacb0\uacfc\ub97c \ucc44\uc6b4\ub2e4. \uc0ac\uc5c5\uc7a5\uba85\uc774 \ube44\uba74 \ub9cc\ub4e4\uc9c0 \uc54a\uace0 \ube48 \uce78\uc744 \ub3cc\ub824\uc900\ub2e4. \uc791\uc131\uc77c\uc740 \uae30\ubcf8 \uc624\ub298. \uadfc\ub85c\uc790\u00b7\uc704\uc6d0\u00b7\ud6c4\ubcf4 \uc774\ub984\uc740 \ubc1b\uc9c0 \uc54a\uace0 \uc11c\ub958\uc5d0\ub3c4 \ube44\uc6cc \ub454\ub2e4. \uc11c\uba85\u00b7\ub0a0\uc778 \uce78\uc740 \ube44\uc6cc \ub454\ub2e4. \uc774\ubbf8 \uc788\ub294 \ud30c\uc77c\uc740 \ub36e\uc5b4\uc4f0\uc9c0 \uc54a\ub294\ub2e4. \uc8fc\ubbfc\ub4f1\ub85d\ubc88\ud638\ub294 \ubc1b\uc9c0 \uc54a\ub294\ub2e4. \uc704\uc6d0 \uc218\uac00 3\uba85 \ubbf8\ub9cc\u00b710\uba85 \ucd08\uacfc\uc774\uac70\ub098 \uc591\ucabd \uc218\uac00 \ub2e4\ub974\uba74 \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4. \ud611\uc758\ud68c\uaddc\uc815\uc740 \u25cb\u25cb \uce78\uc744 \ucc44\uc6b0\uace0 \ud611\uc758\ud68c\uc5d0\uc11c \uc758\uacb0\ud55c \ub4a4 pdf \ub85c \ub178\ub3d9\ud3ec\ud138\uc5d0 \ucca8\ubd80\ud55c\ub2e4(hwpx \ub294 \ud3b8\uc9d1\uc6a9, \ucca8\ubd80 \ud655\uc7a5\uc790 \ubaa9\ub85d\uc5d0 \uc5c6\ub2e4). \uc81c\ucd9c\uc740 \uc0ac\uc6a9\uc790\uac00 \ub178\ub3d9\ud3ec\ud138\uc774\ub098 \uad00\ud560 \uc9c0\ubc29\uace0\uc6a9\ub178\ub3d9\uad00\uc11c\uc5d0 \ud55c\ub2e4.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"concurrentRep":{"description":"\uadfc\ub85c\uc790\uc704\uc6d0\uc774 \uadfc\ub85c\uae30\uc900\ubc95\uc0c1 \uadfc\ub85c\uc790\ub300\ud45c\ub97c \uacb8\ud55c\ub2e4","type":"boolean"},"concurrentScope":{"description":"\uacb8\uc784 \uad8c\ud55c \ubc94\uc704\ub97c \ud558\ub098\uc529(\uc608: \ud0c4\ub825\uc801 \uadfc\ub85c\uc2dc\uac04\uc81c \uc11c\uba74\ud569\uc758)","items":{"maxLength":100,"type":"string"},"maxItems":20,"type":"array"},"council":{"additionalProperties":false,"description":"\ub178\ub3d9\ud3ec\ud138 \uc81c\ucd9c \uce78 \u2014 \ub178\uc0ac\ud611\uc758\ud68c \uc815\ubcf4","properties":{"address":{"description":"\ub178\uc0ac\ud611\uc758\ud68c \uc18c\uc7ac\uc9c0","type":"string"},"name":{"description":"\ub178\uc0ac\ud611\uc758\ud68c \uba85\uce6d","type":"string"},"regularMeetin