{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Attach a question template to a voice agent. Requires the OWNER or ADMIN role. agentId and templateId are both required and must belong to your company (or, for templateId, be a public system template) \u2014 404 if either isn't found.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentId": {
    "minLength": 1,
    "type": "string"
   },
   "customConfig": {
    "additionalProperties": false,
    "description": "Agent-level override of the template's defaultConfig; only the keys you send are overridden.",
    "properties": {
     "confirmationText": {
      "type": "string"
     },
     "displayLabel": {
      "type": "string"
     },
     "question": {
      "description": "The prompt text the agent speaks to ask this question.",
      "type": "string"
     },
     "validation": {
      "additionalProperties": false,
      "properties": {
       "allowedValues": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "max": {
        "type": "number"
       },
       "maxLength": {
        "type": "number"
       },
       "min": {
        "type": "number"
       },
       "minLength": {
        "type": "number"
       },
       "pattern": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "validationPrompt": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "enabled": {
    "type": "boolean"
   },
   "mappedFieldId": {
    "anyOf": [
     {
      "anyOf": [
       {
        "not": {}
       },
       {
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "ID of an existing company Field to write this question's collected answer onto after each call."
   },
   "maxPromptAttempts": {
    "maximum": 3,
    "minimum": 1,
    "type": "number"
   },
   "noResponseBehavior": {
    "enum": [
     "move_to_next_question",
     "end_conversation"
    ],
    "type": "string"
   },
   "order": {
    "type": "number"
   },
   "required": {
    "type": "boolean"
   },
   "templateId": {
    "description": "From list_voice_question_templates.",
    "minLength": 1,
    "type": "string"
   },
   "triggerCondition": {
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "templateId"
  ],
  "type": "object"
 },
 "name": "create_voice_question",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Response payload from the Speak AI API"
   }
  },
  "type": "object"
 },
 "title": "Create Voice Question"
}
