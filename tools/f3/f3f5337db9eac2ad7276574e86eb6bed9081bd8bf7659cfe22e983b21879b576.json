{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find dedicated s&box servers by name, game, or map with current occupancy and source URLs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "game": {
    "pattern": "^[a-z0-9_-]+\\.[a-z0-9_-]+$",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "map": {
    "pattern": "^[a-z0-9_-]+\\.[a-z0-9_-]+$",
    "type": "string"
   },
   "query": {
    "default": "",
    "maxLength": 160,
    "type": "string"
   },
   "sort": {
    "default": "players",
    "enum": [
     "players",
     "capacity",
     "server",
     "game"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_servers",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "contentNotice": {
    "type": "string"
   },
   "generatedAt": {
    "type": "string"
   },
   "generation": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     }
    ]
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "canonicalUrl": {
       "format": "uri",
       "type": "string"
      },
      "game": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "gameTitle": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "string"
      },
      "map": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "markdownUrl": {
       "format": "uri",
       "type": "string"
      },
      "maxPlayers": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "online": {
       "type": "boolean"
      },
      "players": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "playersPeak24h": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "online",
      "canonicalUrl",
      "markdownUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sort": {
    "type": "string"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "generation",
   "generatedAt",
   "contentNotice",
   "query",
   "sort",
   "total",
   "results"
  ],
  "type": "object"
 },
 "title": "Search live s&box servers"
}
