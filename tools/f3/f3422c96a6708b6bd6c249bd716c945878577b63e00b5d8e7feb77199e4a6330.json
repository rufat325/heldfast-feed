{"_meta":{"openai/toolInvocation/invoked":"Film plan ready","openai/toolInvocation/invoking":"Writing the film plan"},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":true},"description":"Turn a one-sentence film idea into a plan without spending anything: title, characters, every scene with its dialogue, total length and the price range. Free, so it takes no max_cost_cents; that goes on make_film. The plan lasts 24 hours. Show the user the plan and price and get a clear yes first. Use it for several characters or anything over about 30 seconds.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"aspect_ratio":{"description":"16:9 (default), 9:16 for vertical, or 1:1.","enum":["16:9","9:16","1:1"],"type":"string"},"brief":{"description":"The film in the user's own words, e.g. 'a 50 second parody where 5 founders start a startup and know nothing'.","maxLength":2000,"minLength":1,"type":"string"},"customer_id":{"description":"Your own id for the end customer this film is for.","maxLength":128,"minLength":1,"type":"string"},"duration_s":{"description":"Length of the finished film in seconds, 10 to 120 (default 30).","maximum":120,"minimum":10,"type":"integer"},"language":{"description":"Language the characters speak, e.g. \"en\" or \"es\". Omit to follow the brief.","type":"string"},"resolution":{"description":"720p (default) or 1080p; 1080p costs more.","enum":["720p","1080p"],"type":"string"}},"required":["brief"],"type":"object"},"name":"plan_film","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"properties":{"characters":{"anyOf":[{"items":{"additionalProperties":true,"properties":{"description":{"type":["string","null"]},"id":{"type":"string"},"image_url":{"type":["string","null"]},"name":{"type":["string","null"]}},"type":"object"},"type":"array"},{"type":"null"}]},"estimated_cost_cents":{"type":["number","null"]},"estimated_cost_range":{"anyOf":[{"additionalProperties":true,"properties":{"max":{"type":"number"},"min":{"type":"number"}},"type":"object"},{"type":"null"}]},"expires_at":{"type":["string","null"]},"logline":{"type":["string","null"]},"plan_id":{"type":"string"},"scenes":{"anyOf":[{"items":{"additionalProperties":true,"properties":{"action":{"type":["string","null"]},"camera":{"type":["string","null"]},"characters":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}]},"dialogue":{"anyOf":[{"items":{"additionalProperties":true,"properties":{"character_id":{"type":"string"},"line":{"type":"string"}},"type":"object"},"type":"array"},{"type":"null"}]},"duration_s":{"type":["number","null"]},"index":{"type":"number"},"last_frame_url":{"type":["string","null"]},"reshoots":{"type":["number","null"]},"setting":{"type":["string","null"]},"status":{"type":["string","null"]},"video_url":{"type":["string","null"]}},"type":"object"},"type":"array"},{"type":"null"}]},"style":{"type":["string","null"]},"title":{"type":["string","null"]},"total_duration_s":{"type":["number","null"]}},"type":"object"},"title":"Plan a film (script and price, free)"}
