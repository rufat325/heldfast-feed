{
 "description": "Emergency halt for an AI agent. Issues a kill-switch directive to immediately stop agent operations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentName": {
    "description": "Name of the AI agent to halt",
    "type": "string"
   },
   "reason": {
    "description": "Reason for triggering kill switch",
    "type": "string"
   },
   "scope": {
    "default": "full",
    "description": "Scope of shutdown",
    "enum": [
     "partial",
     "full"
    ],
    "type": "string"
   },
   "severity": {
    "description": "Severity level",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   }
  },
  "required": [
   "agentName",
   "reason",
   "severity"
  ],
  "type": "object"
 },
 "name": "kill_switch"
}
