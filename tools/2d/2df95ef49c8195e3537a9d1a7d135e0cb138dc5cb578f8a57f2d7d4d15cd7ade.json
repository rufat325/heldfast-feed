{
 "annotations": {
  "readOnlyHint": true,
  "title": "List reservations"
 },
 "description": "List reservations across all channels (Airbnb, Vrbo, Booking.com, direct\u2026) with guest, dates, status, price and channel. Filter by listing, channel, arrival/departure window, guest name or email, unread messages, and more. Default order is newest first; for large accounts page with afterId (the id of the last reservation on the previous page). Channel ids: 2000 direct, 2018 airbnbOfficial, 2002 homeaway/Vrbo, 2005 bookingcom, 2007 expedia, 2013 bookingengine, 2019 marriott, 2020 partner, 2022 google. Hostaway: GET /v1/reservations.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "afterId": {
    "description": "Cursor: the id of the last reservation from the previous page (offset is then ignored).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "arrivalEndDate": {
    "description": "Arrival on or before (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "arrivalStartDate": {
    "description": "Arrival on or after (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "assigneeUserId": {
    "description": "Only reservations assigned to this user.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "channelId": {
    "description": "Only this channel id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "dateType": {
    "description": "Which date startDate/endDate bound (only on accounts with the new reservations query; 'cancellation' also restricts to cancelled).",
    "enum": [
     "arrival",
     "departure",
     "creation",
     "cancellation"
    ],
    "type": "string"
   },
   "departureEndDate": {
    "description": "Departure on or before (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "departureStartDate": {
    "description": "Departure on or after (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "endDate": {
    "description": "Upper bound for dateType (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "guestEmail": {
    "description": "Filter by guest email.",
    "type": "string"
   },
   "hasUnreadConversationMessages": {
    "description": "Only reservations with unread guest messages.",
    "type": "boolean"
   },
   "includeCancellationPolicy": {
    "description": "Attach the cancellation-policy snapshot to each reservation.",
    "type": "boolean"
   },
   "includeResources": {
    "description": "Include attached sub-resources (sent as includeResources=1).",
    "type": "boolean"
   },
   "isArchived": {
    "description": "Archived or not.",
    "type": "boolean"
   },
   "isStarred": {
    "description": "Only starred.",
    "type": "boolean"
   },
   "latestActivityEnd": {
    "description": "Latest activity on or before (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "latestActivityStart": {
    "description": "Latest activity on or after (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "description": "Maximum records to return (1-500).",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "listingId": {
    "description": "Only reservations for this listing.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "match": {
    "description": "Search by guest name.",
    "type": "string"
   },
   "offset": {
    "description": "Records to skip from the start.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "sortOrder": {
    "description": "Sort order.",
    "enum": [
     "arrivalDate",
     "arrivalDateDesc",
     "lastConversationMessageSent",
     "lastConversationMessageSentDesc",
     "lastConversationMessageReceived",
     "lastConversationMessageReceivedDesc",
     "latestActivity",
     "latestActivityDesc",
     "updatedOn"
    ],
    "type": "string"
   },
   "startDate": {
    "description": "Lower bound for dateType (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "hostaway_list_reservations",
 "title": "List reservations"
}
