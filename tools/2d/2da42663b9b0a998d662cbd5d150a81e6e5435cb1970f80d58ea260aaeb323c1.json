{
 "description": "Spawn a process from the configured allowedCommands list. Captures stdout/stderr with caps and a timeout.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "args": {
    "default": [],
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "command": {
    "description": "Binary name (must be in allowedCommands)",
    "minLength": 1,
    "type": "string"
   },
   "cwd": {
    "type": "string"
   },
   "env": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "timeoutMs": {
    "exclusiveMinimum": 0,
    "maximum": 300000,
    "type": "integer"
   }
  },
  "required": [
   "command"
  ],
  "type": "object"
 },
 "name": "run_command",
 "title": "Run command"
}
