  "additionalProperties": false,
  "properties": {
   "heartbeat_id": {
    "description": "The secret heartbeat ID returned by create_heartbeat.",
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "heartbeat_id"
  ],
  "type": "object"
 },
