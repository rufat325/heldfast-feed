{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Ask the dealership to reach out \u2014 prepare"
 },
 "description": "Prepare a named dealership's exact contact disclosure and a short-lived signed binding.",
 "inputSchema": {
  "additionalProperties": false,
  "description": "customer.email requires channels to include email. customer.phone requires channels to include phone.",
  "properties": {
   "channels": {
    "items": {
     "enum": [
      "email",
      "phone"
     ]
    },
    "maxItems": 2,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   },
   "comments": {
    "maxLength": 2000,
    "type": "string"
   },
   "customer": {
    "additionalProperties": false,
    "anyOf": [
     {
      "required": [
       "email"
      ]
     },
     {
      "required": [
       "phone"
      ]
     }
    ],
    "properties": {
     "email": {
      "maxLength": 254,
      "minLength": 6,
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "phone": {
      "maxLength": 30,
      "minLength": 7,
      "pattern": "^(?=(?:[^0-9]*[0-9]){7,15}[^0-9]*$)\\+?[0-9()\\-. ]+$",
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "include_quote": {
    "default": true,
    "description": "Set false when the shopper was not shown a quote: the disclosure then makes no price claim and quote_included is false.",
    "type": "boolean"
   },
   "rooftop_slug": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "unit_identity": {
    "maxLength": 30,
    "minLength": 5,
    "type": "string"
   }
  },
  "required": [
   "rooftop_slug",
   "unit_identity",
   "customer",
   "channels"
  ],
  "type": "object"
 },
 "name": "lead_prepare",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "binding": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
     },
     "disclosure_text": {
      "maxLength": 5000,
      "minLength": 10,
      "type": "string"
     },
     "expires_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
     },
     "quote_included": {
      "type": "boolean"
     }
    },
    "required": [
     "disclosure_text",
     "binding",
     "expires_at",
     "quote_included"
    ],
    "type": "object"
   },
   "error": {
    "additionalProperties": false,
    "description": "Unknown and foreign thread ids are deliberately indistinguishable: both return invalid_params with message \"unknown thread_id\" (anti-enumeration).",
    "properties": {
     "auth_help_url": {
      "description": "Present only when no credential was supplied for a capability that requires one. Points to human documentation for obtaining a key. Absent for invalid, pending, or disabled credentials, which are deliberately indistinguishable.",
      "format": "uri",
      "maxLength": 500,
      "type": "string"
     },
     "code": {
      "enum": [
       "rooftop_not_found",
       "rooftop_inactive",
       "unit_not_found",
       "invalid_params",
       "rate_limited",
       "upstream_unavailable",
       "capability_unavailable",
       "identity_required",
       "quota_exceeded",
       "unit_held",
       "quote_expired",
       "rooftop_paused",
       "handoff_duplicate",
       "idempotency_conflict",
       "price_unavailable",
       "snapshot_expired",
       "artifact_too_large",
       "cursor_invalid",
       "cursor_expired",
       "ambiguous_identity",
       "unsupported_in_country"
      ]
     },
     "message": {
      "maxLength": 500,
      "type": "string"
     },
     "retry_after_seconds": {
      "minimum": 0,
      "type": "integer"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message",
     "retryable"
    ],
    "type": "object"
   },
   "freshness": {
    "additionalProperties": false,
    "properties": {
     "by_rooftop": {
      "additionalProperties": {
       "additionalProperties": false,
       "properties": {
        "last_ingest_at": {
         "format": "date-time",
         "maxLength": 40,
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "enum": [
          "fresh",
          "stale",
          "no_data"
         ]
        }
       },
       "required": [
        "status",
        "last_ingest_at"
       ],
       "type": "object"
      },
      "maxProperties": 500,
      "type": "object"
     }
    },
    "required": [
     "by_rooftop"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Ask the dealership to reach out \u2014 prepare"
}
