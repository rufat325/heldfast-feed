{
 "description": "Create a new password/login item in a 1Password vault with optional username, URL, tags, and notes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Item category. Defaults to Login.",
    "enum": [
     "Login",
     "Password"
    ],
    "type": "string"
   },
   "notes": {
    "description": "Optional notes.",
    "type": "string"
   },
   "password": {
    "description": "Password to store in the item.",
    "minLength": 1,
    "type": "string"
   },
   "returnSecret": {
    "description": "If true, include the created password in the response. Defaults to false for security.",
    "type": "boolean"
   },
   "tags": {
    "description": "Optional tags for organization.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Item title.",
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "Optional website URL to associate.",
    "format": "uri",
    "type": "string"
   },
   "username": {
    "description": "Username to store in the item.",
    "type": "string"
   },
   "vaultId": {
    "description": "Vault ID to create the item in.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "vaultId",
   "title",
   "password"
  ],
  "type": "object"
 },
 "name": "password_create"
}
