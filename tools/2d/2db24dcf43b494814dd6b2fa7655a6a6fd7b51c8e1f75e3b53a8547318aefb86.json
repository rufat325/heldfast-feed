{
 "annotations": {
  "readOnlyHint": true,
  "title": "List Customers"
 },
 "description": "List/search customers by name, email, phone, created-date. Returns (summary): pagination + array of {id, name, email, phone, ordersCount, totalSpent}. detail:'full' adds address/externalId/all phones.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "detail": {
    "default": "summary",
    "description": "Output verbosity: 'summary' (compact, default \u2014 saves tokens) or 'full' (all shaped fields incl. line items, delivery, payments).",
    "enum": [
     "summary",
     "full"
    ],
    "type": "string"
   },
   "filter_date_from": {
    "description": "Filter customers created on/after (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "filter_date_to": {
    "description": "Filter customers created on/before (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "filter_email": {
    "description": "Filter by email address",
    "type": "string"
   },
   "filter_name": {
    "description": "Filter by customer name (partial match)",
    "type": "string"
   },
   "filter_phone": {
    "description": "Filter by phone number",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Results per page (max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "minimum": 1,
    "type": "integer"
   },
   "raw": {
    "description": "If true, return the untouched RetailCRM payload (for debugging; verbose).",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_customers"
}
