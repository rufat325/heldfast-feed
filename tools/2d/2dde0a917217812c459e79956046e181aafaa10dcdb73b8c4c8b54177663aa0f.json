 "description": "Does a JMA warning or advisory in effect now match a stop on this Japan itinerary [{date, prefecture}]? Per stop: matched_advisory (with severity), no_match_in_checked_sources (NOT a statement of no impact) or unknown (data missing, or date not today/tomorrow JST). Returns checked sources and areas, unchecked areas, issued_at, retrieved_at, and current JMA typhoon/volcano bulletins (listed, not matched). No forecast. Retrying with the same payment is not charged; use receipt_id with get_receipt.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "itinerary": {
    "description": "1 to 14 stops {date, prefecture}, in travel order. Only stops dated today or tomorrow (Japan time) can be matched; others return unknown, but typhoon and volcano bulletins currently in effect are still listed (not matched).",
    "items": {
     "properties": {
      "date": {
       "description": "YYYY-MM-DD in Japan time",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "prefecture": {
       "description": "Japanese prefecture: English name (e.g. \"Tokyo\", \"Osaka\", \"Hokkaido\"; \"Tokyo-to\" and \"Osaka Prefecture\" also work), Japanese name in kanji, or JIS code \"01\"..\"47\".",
       "maxLength": 40,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "date",
      "prefecture"
     ],
     "type": "object"
    },
    "maxItems": 14,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "itinerary"
  ],
  "type": "object"
 },
