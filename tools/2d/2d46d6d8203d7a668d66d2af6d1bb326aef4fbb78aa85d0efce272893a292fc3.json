{
 "description": "Create a new spreadsheet",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "title": {
    "description": "Title for the new spreadsheet",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "spreadsheet-create",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "completedAt": {
        "description": "ISO datetime when operation completed",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "itemsChanged": {
        "description": "Successfully created spreadsheets (always 1 on success)",
        "type": "number"
       },
       "itemsProcessed": {
        "description": "Total items attempted (always 1 for single spreadsheet)",
        "type": "number"
       },
       "operationSummary": {
        "description": "Summary of the spreadsheet creation operation",
        "type": "string"
       },
       "spreadsheetUrl": {
        "description": "URL of the created spreadsheet",
        "type": "string"
       },
       "title": {
        "description": "Title of the created spreadsheet",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "operationSummary",
       "itemsProcessed",
       "itemsChanged",
       "completedAt",
       "id",
       "spreadsheetUrl",
       "title"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
