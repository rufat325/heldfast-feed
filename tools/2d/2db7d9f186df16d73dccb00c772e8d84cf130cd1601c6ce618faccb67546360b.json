{
 "description": "Generate monsters based on the world seed. Returns a prompt for LLM execution.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Number of monsters to generate",
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "focusOn": {
    "description": "Specific monster seeds to focus on (by name)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "threatTiers": {
    "description": "Filter by threat tiers",
    "items": {
     "enum": [
      "minion",
      "standard",
      "elite",
      "boss"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "generate_monsters"
}
