{"_meta":{"securitySchemes":[{"type":"noauth"},{"scopes":[],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Suggest domain names"},"description":"Domain name ideas from 1 to 3 keywords (e.g. \"coffee dubai\"), with an optional industry, style and extension, from GlobalHostia's name generator. Returns names only: they are not checked; use bulk_check_availability for that. No sign-in needed.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"currency":{"description":"ISO 4217 currency code such as USD or AED (default USD).","pattern":"^[A-Za-z]{3}$","type":"string"},"industry":{"enum":["tech","ecommerce","food","realestate","finance","health","beauty","travel","education","consulting","creative","crypto"],"type":"string"},"keywords":{"maxLength":80,"minLength":2,"type":"string"},"limit":{"description":"Default 15.","maximum":30,"minimum":1,"type":"integer"},"style":{"enum":["brandable","short","compound","professional","playful"],"type":"string"},"tld":{"description":"Extension, e.g. \".com\" (default .com)","maxLength":24,"type":"string"}},"required":["keywords"],"type":"object"},"name":"suggest_domain_names","outputSchema":{"properties":{"ideas":{"type":["array","null"]},"keywords":{"type":["array","null"]},"tld":{"type":["string","null"]}},"type":"object"},"title":"Suggest domain names"}
