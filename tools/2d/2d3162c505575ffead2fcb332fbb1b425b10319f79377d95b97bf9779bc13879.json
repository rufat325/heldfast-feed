{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Remove an API key"
 },
 "description": "Permanently remove one pooled BYOK credential by key id from the authenticated project, including its Vault secret. Write; destructive; idempotent.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "keyId": {
    "description": "Pooled BYOK key UUID from list_byok_keys",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "projectId": {
    "description": "Project id (`project_id` is accepted too.)",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "keyId"
  ],
  "type": "object"
 },
 "name": "remove_byok_key",
 "title": "Remove an API key"
}
