{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/commerce.price-components",
  "agent-utilities/priceMicroUsd": 0
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Reconcile item, discount, shipping, tax and fee amounts using exact decimals; missing costs stay unknown and declared totals can be checked. FREE during validation. No key, credits or wallet. Existing source and input limits apply.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
     },
     "declaredTotal": {
      "maxLength": 19,
      "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
      "type": "string"
     },
     "fees": {
      "anyOf": [
       {
        "maxLength": 19,
        "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "items": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "discount": {
         "maxLength": 19,
         "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
         "type": "string"
        },
        "id": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "quantity": {
         "maximum": 100000,
         "minimum": 1,
         "type": "integer"
        },
        "unitPrice": {
         "maxLength": 19,
         "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
         "type": "string"
        }
       },
       "required": [
        "id",
        "unitPrice",
        "quantity",
        "discount"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "minorUnitDigits": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     "orderDiscount": {
      "maxLength": 19,
      "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
      "type": "string"
     },
     "shipping": {
      "anyOf": [
       {
        "maxLength": 19,
        "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "tax": {
      "anyOf": [
       {
        "maxLength": 19,
        "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "currency",
     "minorUnitDigits",
     "items",
     "orderDiscount",
     "shipping",
     "tax",
     "fees"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "commerce_price_components",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "currency": {
    "type": "string"
   },
   "difference": {
    "type": [
     "string",
     "null"
    ]
   },
   "itemSubtotal": {
    "type": "string"
   },
   "knownTotal": {
    "type": "string"
   },
   "lineDiscounts": {
    "type": "string"
   },
   "lines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "discount": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "subtotal": {
       "type": "string"
      },
      "total": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "subtotal",
      "discount",
      "total"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "matchesDeclaredTotal": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "minorUnitDigits": {
    "type": "number"
   },
   "missingComponents": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "orderDiscount": {
    "type": "string"
   },
   "scope": {
    "type": "string"
   },
   "total": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "currency",
   "minorUnitDigits",
   "lines",
   "itemSubtotal",
   "lineDiscounts",
   "orderDiscount",
   "knownTotal",
   "total",
   "missingComponents",
   "matchesDeclaredTotal",
   "difference",
   "scope"
  ],
  "type": "object"
 }
}
