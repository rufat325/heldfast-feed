{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a tutorial project"
 },
 "description": "Use this when someone wants to start a new Tutorializer project for a product or app. Returns the new project's id, name, vanity id, domain and default locale. Each call creates another project. Not for changing an existing project.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "defaultLocale": {
    "description": "Main language code of the tutorials, e.g. en or pt-BR; optional",
    "maxLength": 16,
    "minLength": 2,
    "type": "string"
   },
   "domain": {
    "description": "Domain of the product the tutorials cover, e.g. example.com; optional",
    "maxLength": 253,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Project name as people will see it, up to 120 characters",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "project": {
    "additionalProperties": false,
    "properties": {
     "defaultLocale": {
      "anyOf": [
       {
        "maxLength": 16,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "domain": {
      "anyOf": [
       {
        "maxLength": 253,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "vanityId": {
      "anyOf": [
       {
        "maxLength": 63,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "name",
     "vanityId",
     "domain",
     "defaultLocale"
    ],
    "type": "object"
   },
   "status": {
    "const": "created",
    "type": "string"
   }
  },
  "required": [
   "status",
   "project"
  ],
  "type": "object"
 },
 "title": "Create a tutorial project"
}
