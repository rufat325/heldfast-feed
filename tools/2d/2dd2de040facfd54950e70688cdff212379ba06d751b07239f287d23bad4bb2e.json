 "description": "Shows or hides one of the animated overlays. huasheng_list_clips with detail=\"full\" lists them, with the clips each one covers. **Their content cannot be changed and they cannot be regenerated or replaced** \u2014 Huasheng does not offer that for videos made this way, so do not try. Hiding one keeps it around; it just stops appearing in the video. To change what an animation says, ask Huasheng itself with huasheng_ask_agent. A successful show/hide response completes that request: do not inspect other animations or export the video unless the user also asked for it.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "animation": {
    "description": "Its id, from the animations list in huasheng_list_clips",
    "type": "integer"
   },
   "client_action_id": {
    "description": "MCP App only: submission id; reuse for the same click. Models omit.",
    "type": "string"
   },
   "pid": {
    "description": "Video id (15 digits); default: this machine's current video.",
    "type": "integer"
   },
   "ui_lang": {
    "description": "MCP App only: follow-up language. Models omit.",
    "type": "string"
   },
   "visible": {
    "description": "true shows it, false hides it",
    "type": "boolean"
   }
  },
  "required": [
   "animation",
   "visible"
  ],
  "type": "object"
 },
 "name": "huasheng_set_animation_visibility",
