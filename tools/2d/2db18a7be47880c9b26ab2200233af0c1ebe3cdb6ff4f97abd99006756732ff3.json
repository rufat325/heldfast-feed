{
 "description": "Set a breakpoint at a specific file and line number. Optionally provide a condition.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "condition": {
    "description": "Optional condition expression (e.g., \"x > 10\")",
    "type": "string"
   },
   "file": {
    "description": "The file path (absolute or relative)",
    "type": "string"
   },
   "line": {
    "description": "The line number (1-indexed)",
    "type": "number"
   },
   "sessionId": {
    "description": "The debug session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "file",
   "line"
  ],
  "type": "object"
 },
 "name": "debugger_set_breakpoint"
}
