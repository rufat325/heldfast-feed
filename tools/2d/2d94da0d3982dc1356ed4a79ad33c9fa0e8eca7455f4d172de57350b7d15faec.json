   },
   "start_month": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "First month, as a name or YYYY-MM. Empty means this month.",
    "examples": [
     "2026-11"
    ],
    "title": "Start Month"
   }
  },
  "required": [
