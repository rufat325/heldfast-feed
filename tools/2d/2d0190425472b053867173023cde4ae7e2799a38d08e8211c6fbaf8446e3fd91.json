{
 "description": "Issue a fiscal invoice (nota fiscal) for an order",
 "inputSchema": {
  "properties": {
   "courier": {
    "description": "Shipping carrier name",
    "type": "string"
   },
   "invoiceKey": {
    "description": "Fiscal key (chave da NFe)",
    "type": "string"
   },
   "invoiceNumber": {
    "description": "Invoice number issued by the ERP",
    "type": "string"
   },
   "invoiceUrl": {
    "description": "URL to the invoice PDF/XML",
    "type": "string"
   },
   "invoiceValue": {
    "description": "Invoice total value in cents",
    "type": "number"
   },
   "issuanceDate": {
    "description": "Issuance date in ISO 8601 format",
    "type": "string"
   },
   "items": {
    "description": "Items in the invoice",
    "items": {
     "properties": {
      "id": {
       "description": "SKU ID",
       "type": "string"
      },
      "price": {
       "description": "Item price in cents",
       "type": "number"
      },
      "quantity": {
       "description": "Quantity",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "orderId": {
    "description": "Order ID",
    "type": "string"
   },
   "trackingNumber": {
    "description": "Tracking number",
    "type": "string"
   },
   "trackingUrl": {
    "description": "Tracking URL",
    "type": "string"
   },
   "type": {
    "description": "Invoice type: Output (sale) or Input (return)",
    "enum": [
     "Output",
     "Input"
    ],
    "type": "string"
   }
  },
  "required": [
   "orderId",
   "type",
   "issuanceDate",
   "invoiceNumber",
   "invoiceValue",
   "items"
  ],
  "type": "object"
 },
 "name": "invoice_order"
}
