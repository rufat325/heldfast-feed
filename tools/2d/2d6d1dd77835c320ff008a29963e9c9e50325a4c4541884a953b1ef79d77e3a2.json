{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List or search anime producers and studios with their MAL IDs and counts. Use `q` to search by name, then get_producer for one studio's full profile (about text, external links).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "letter": {
    "description": "Restrict results to entries whose title starts with this single letter.",
    "maxLength": 1,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Max results per page (1-50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "order_by": {
    "description": "Field to order by.",
    "enum": [
     "mal_id",
     "count",
     "favorites",
     "established"
    ],
    "type": "string"
   },
   "page": {
    "description": "1-based page number for pagination (1-1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Filter by name.",
    "type": "string"
   },
   "sort": {
    "description": "Sort direction.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_producers",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "properties": {
     "current_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "has_next_page": {
      "type": "boolean"
     },
     "last_visible_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "established": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "favorites": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "image_url": {
       "type": "string"
      },
      "mal_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "mal_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "page"
  ],
  "type": "object"
 },
 "title": "Get producers/studios"
}
