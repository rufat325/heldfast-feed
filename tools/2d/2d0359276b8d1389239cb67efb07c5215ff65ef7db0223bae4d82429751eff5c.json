{
 "_meta": {
  "openai/toolInvocation/invoked": "Check-in saved",
  "openai/toolInvocation/invoking": "Saving the confirmed check-in\u2026",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "careclinic.wellness.read",
     "careclinic.symptoms.write"
    ],
    "type": "oauth2"
   },
   {
    "scopes": [
     "careclinic.wellness.read",
     "careclinic.mood.write"
    ],
    "type": "oauth2"
   },
   {
    "scopes": [
     "careclinic.wellness.read",
     "careclinic.sleep.write"
    ],
    "type": "oauth2"
   },
   {
    "scopes": [
     "careclinic.wellness.read",
     "careclinic.medications.write"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "visibility": [
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "App-only write used by the CareClinic confirmation card. It writes only the exact entry represented by a valid signed preview after explicit confirmation. Replaying the same preview returns the original receipt instead of creating a duplicate.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "confirmationToken": {
    "maxLength": 12000,
    "minLength": 80,
    "type": "string"
   },
   "confirmed": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "confirmationToken",
   "confirmed"
  ],
  "type": "object"
 },
 "name": "careclinic_commit_log",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "const": "write_receipt",
    "type": "string"
   },
   "receipt": {
    "additionalProperties": false,
    "properties": {
     "domain": {
      "enum": [
       "symptom",
       "mood",
       "medication",
       "sleep"
      ],
      "type": "string"
     },
     "duplicatePrevented": {
      "type": "boolean"
     },
     "occurredAt": {
      "type": "string"
     },
     "saved": {
      "const": true,
      "type": "boolean"
     },
     "summary": {
      "type": "string"
     }
    },
    "required": [
     "saved",
     "domain",
     "occurredAt",
     "summary",
     "duplicatePrevented"
    ],
    "type": "object"
   }
  },
  "required": [
   "kind",
   "receipt"
  ],
  "type": "object"
 },
 "title": "Save a confirmed CareClinic check-in"
}
