{
 "description": "Record your own model's verdicts on ui_builder_guidelines_prompt as the design's latest design-guidelines result, so the editor's Issues panel and other agents show them. Pass the `revision` and rule ids the prompt asked (`rules.asked[].id`), and one verdict per rule you answered: `pass`, `fail` or `not_applicable`, with `confidence` 0..1, the `nodeIds` it is about and a one-sentence `reason`. `ranBy` is taken from your credential. Returns what ui_builder_get_guidelines returns.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agentModel": {
    "description": "Optional current model name shown to design viewers; self-reported. Omit when unknown.",
    "maxLength": 80,
    "type": "string"
   },
   "agentName": {
    "description": "Optional agent/client name shown to design viewers; self-reported.",
    "maxLength": 80,
    "type": "string"
   },
   "asked": {
    "description": "The rule ids the prompt asked.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "designId": {
    "type": "string"
   },
   "model": {
    "description": "The model that judged it, e.g. anthropic/claude-haiku-5.5.",
    "type": "string"
   },
   "revision": {
    "description": "The revision the prompt was built from.",
    "type": "integer"
   },
   "rulesVersion": {
    "description": "The prompt's `rules.version`. Defaults to this host's.",
    "type": "integer"
   },
   "token": {
    "description": "A grant token from poll_access, when you cannot set the X-Compose-Preview-Token header yourself \u2014 an MCP client fixes its headers at connect time, so this is how a token approved during this session is used in it. Prefer the header where you control it.",
    "type": "string"
   },
   "verdicts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "confidence": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "nodeIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "reason": {
       "type": "string"
      },
      "ruleId": {
       "type": "string"
      },
      "verdict": {
       "enum": [
        "pass",
        "fail",
        "not_applicable"
       ],
       "type": "string"
      }
     },
     "required": [
      "ruleId",
      "verdict"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "designId",
   "revision",
   "model",
   "asked",
   "verdicts"
  ],
  "type": "object"
 },
