{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Update Template"
 },
 "description": "Update an existing SignWell template. Only provide fields you want to change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allow_decline": {
    "type": "boolean"
   },
   "allow_reassign": {
    "type": "boolean"
   },
   "api_application_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "apply_signing_order": {
    "type": "boolean"
   },
   "attachment_requests": {
    "items": {
     "properties": {
      "name": {
       "minLength": 1,
       "type": "string"
      },
      "placeholder_id": {
       "minLength": 1,
       "type": "string"
      },
      "required": {
       "default": true,
       "type": "boolean"
      }
     },
     "required": [
      "name",
      "placeholder_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "checkbox_groups": {
    "items": {
     "properties": {
      "checkbox_ids": {
       "items": {
        "type": "string"
       },
       "minItems": 2,
       "type": "array"
      },
      "exact_value": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "group_name": {
       "minLength": 1,
       "type": "string"
      },
      "max_value": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "min_value": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "placeholder_id": {
       "minLength": 1,
       "type": "string"
      },
      "required": {
       "default": false,
       "type": "boolean"
      },
      "validation": {
       "enum": [
        "minimum",
        "maximum",
        "range",
        "exact"
       ],
       "type": "string"
      }
     },
     "required": [
      "group_name",
      "placeholder_id",
      "checkbox_ids"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "copied_placeholders": {
    "items": {
     "properties": {
      "name": {
       "description": "REQUIRED. Name for the CC recipient role.",
       "type": "string"
      },
      "preassigned_recipient_email": {
       "description": "Pre-assigned email.",
       "type": "string"
      },
      "preassigned_recipient_name": {
       "description": "Pre-assigned name.",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "decline_redirect_url": {
    "format": "uri",
    "type": "string"
   },
   "draft": {
    "type": "boolean"
   },
   "expires_in": {
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "fields": {
    "items": {
     "items": {
      "properties": {
       "allow_other": {
        "description": "Allow 'Other' option in dropdown.",
        "type": "boolean"
       },
       "api_id": {
        "description": "Unique identifier for the field.",
        "type": "string"
       },
       "date_format": {
        "description": "Date field format.",
        "enum": [
         "MM/DD/YYYY",
         "DD/MM/YYYY",
         "YYYY/MM/DD",
         "Month DD, YYYY",
         "MM/DD/YYYY hh:mm:ss a"
        ],
        "type": "string"
       },
       "default_option": {
        "description": "Default dropdown option.",
        "type": "string"
       },
       "fixed_width": {
        "description": "Text fields: keep fixed width with multiline.",
        "type": "boolean"
       },
       "height": {
        "description": "Field height in pixels.",
        "type": "number"
       },
       "label": {
        "description": "Label displayed when field is empty (text/date fields).",
        "type": "string"
       },
       "lock_sign_date": {
        "description": "Date fields: auto-populate with sign date.",
        "type": "boolean"
       },
       "name": {
        "description": "Checkbox group name.",
        "type": "string"
       },
       "options": {
        "description": "Dropdown options.",
        "items": {
         "properties": {
          "api_id": {
           "description": "Unique ID for the option.",
           "type": "string"
          },
          "is_other": {
           "description": "Whether this is an 'Other' option.",
           "type": "boolean"
          },
          "name": {
           "description": "Option display text.",
           "type": "string"
          }
         },
         "required": [
          "name"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "page": {
        "description": "Page number within the file.",
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
       },
       "placeholder_id": {
        "description": "ID of the placeholder assigned to this field.",
        "minLength": 1,
        "type": "string"
       },
       "required": {
        "default": true,
        "type": "boolean"
       },
       "type": {
        "description": "Field type.",
        "enum": [
         "initials",
         "signature",
         "checkbox",
         "date",
         "select",
         "text",
         "dropdown",
         "autofill_company",
         "autofill_email",
         "autofill_first_name",
         "autofill_last_name",
         "autofill_name",
         "autofill_phone",
         "autofill_title",
         "autofill_date_signed"
        ],
        "type": "string"
       },
       "validation": {
        "description": "Text field validation type.",
        "enum": [
         "no_text_validation",
         "numbers",
         "letters",
         "email_address",
         "us_phone_number",
         "us_zip_code",
         "us_ssn",
         "us_age",
         "alphanumeric",
         "us_bank_routing_number",
         "us_bank_account_number"
        ],
        "type": "string"
       },
       "value": {
        "description": "Pre-filled value. Text accepts strings/numbers, date accepts ISO8601, checkbox accepts boolean.",
        "type": [
         "string",
         "number",
         "boolean"
        ]
       },
       "width": {
        "description": "Field width in pixels.",
        "type": "number"
       },
       "x": {
        "description": "Horizontal position in pixels.",
        "type": "number"
       },
       "y": {
        "description": "Vertical position in pixels.",
        "type": "number"
       }
      },
      "required": [
       "x",
       "y",
       "page",
       "placeholder_id",
       "type"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "type": "array"
   },
   "files": {
    "items": {
     "properties": {
      "content_text": {
       "description": "Plain text or Markdown content to convert to DOCX. When provided, the MCP server generates a DOCX file automatically. Use this instead of file_base64 to avoid UI freezing with large documents.",
       "type": "string"
      },
      "file_base64": {
       "description": "Base64-encoded file content.",
       "type": "string"
      },
      "file_token": {
       "description": "Token from file_store (recommended). Use file_store first, then pass the token here.",
       "type": "string"
      },
      "file_url": {
       "description": "Public URL to download the file.",
       "type": "string"
      },
      "name": {
       "description": "REQUIRED. Filename with extension (e.g., 'contract.pdf').",
       "type": "string"
      },
      "resource_uri": {
       "description": "MCP resource URI for the file.",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "labels": {
    "items": {
     "properties": {
      "name": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "language": {
    "enum": [
     "en",
     "fr",
     "es",
     "de",
     "pl",
     "pt",
     "da",
     "nl",
     "it",
     "ru",
     "sv",
     "ar",
     "el",
     "tr",
     "sk"
    ],
    "type": "string"
   },
   "message": {
    "maxLength": 4000,
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "type": "string"
   },
   "placeholders": {
    "items": {
     "properties": {
      "id": {
       "description": "REQUIRED. Unique ID that maps to the signer number in text tags (e.g., '1' for {{signature:1:y}}, '2' for {{signature:2:y}}).",
       "type": "string"
      },
      "name": {
       "description": "REQUIRED. Role name (e.g., 'Parent/Guardian', 'Client'). Used when assigning recipients via template_create_document.",
       "type": "string"
      },
      "preassigned_recipient_email": {
       "description": "Pre-assigned recipient email.",
       "type": "string"
      },
      "preassigned_recipient_name": {
       "description": "Pre-assigned recipient name.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "redirect_url": {
    "format": "uri",
    "type": "string"
   },
   "reminders": {
    "type": "boolean"
   },
   "subject": {
    "type": "string"
   },
   "template_id": {
    "minLength": 1,
    "type": "string"
   },
   "text_tags": {
    "type": "boolean"
   }
  },
  "required": [
   "template_id"
  ],
  "type": "object"
 },
 "name": "template_update"
}
