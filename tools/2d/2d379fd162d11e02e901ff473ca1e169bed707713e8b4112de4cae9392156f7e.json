{
 "_meta": {
  "x402/network": "eip155:8453",
  "x402/price": "$0.002"
 },
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Estimate the gas and the cost in ETH and USD of a Base transaction before signing it. Input: to, and optionally from, data and value. Price: $0.002 USDC on Base via x402.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "maxLength": 20000,
    "pattern": "^0x[0-9a-fA-F]*$",
    "type": "string"
   },
   "from": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "to": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "value": {
    "pattern": "^[0-9]+$",
    "type": [
     "string",
     "integer"
    ]
   }
  },
  "required": [
   "to",
   "from"
  ],
  "type": "object"
 },
 "name": "base_estimate_gas"
}
