{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Practice Questions"
 },
 "description": "Return curated Examova public-preview practice questions for a certification, optionally filtered by keyword. Use to quiz the user. Returns the question, options, and correct answer letter \u2014 full explanations and the complete question bank require an Examova account.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "certification": {
    "description": "Certification slug/code/name",
    "type": "string"
   },
   "keyword": {
    "description": "Optional topic keyword to filter (e.g. \"negotiation\", \"risk\")",
    "type": "string"
   },
   "limit": {
    "description": "How many questions (1-5, default 3)",
    "type": "number"
   }
  },
  "required": [
   "certification"
  ],
  "type": "object"
 },
 "name": "search_practice_questions",
 "outputSchema": {
  "properties": {
   "certification": {
    "type": "string"
   },
   "questions": {
    "items": {
     "properties": {
      "correctLabel": {
       "type": "string"
      },
      "options": {
       "items": {
        "properties": {
         "label": {
          "type": "string"
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "label",
         "text"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "signupUrl": {
       "type": "string"
      },
      "stem": {
       "type": "string"
      }
     },
     "required": [
      "stem",
      "options",
      "correctLabel"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "certification",
   "questions"
  ],
  "type": "object"
 },
 "title": "Search Practice Questions"
}
