 "description": "Check whether anything has been sent to a capture URL yet, and read it. The status field is pending or captured. Pending is the ordinary answer before the sender fires and is not a failure. Set wait_seconds from 1 to 25 to wait efficiently for the first request. The call returns early when the capture changes. Zero reads the current state immediately. Unknown and expired IDs fail. No API key, no account and no sign up: call it directly.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "capture_id": {
    "description": "The UUID that create_webhook_capture returned.",
    "format": "uuid",
    "type": "string"
   },
   "wait_seconds": {
    "default": 0,
    "description": "Wait up to this many seconds for a request. Zero returns immediately.",
    "maximum": 25,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "capture_id"
  ],
  "type": "object"
 },
 "name": "read_webhook_capture",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "capture_id": {
    "format": "uuid",
    "type": "string"
   },
   "captured_at_datetime": {
    "type": [
     "string",
     "null"
    ]
   },
   "captured_at_timestamp": {
    "type": [
     "integer",
     "null"
    ]
   },
   "created_at_datetime": {
    "type": "string"
   },
   "created_at_timestamp": {
    "type": "integer"
   },
   "expire_datetime": {
    "type": "string"
   },
   "expire_timestamp": {
    "type": "integer"
   },
   "ok": {
    "type": "boolean"
   },
   "request": {
    "type": [
     "object",
     "null"
    ]
   },
   "status": {
    "enum": [
     "pending",
     "captured"
    ],
    "type": "string"
   },
   "wait_reason": {
    "enum": [
     "terminal",
     "changed",
     "timeout",
     "immediate",
     "unavailable",
     "stalled"
    ],
    "type": "string"
   },
