    "type": "object"
   },
   "requestId": {
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "description": "`verification_required`: ask the user for the code sent to `verification.maskedEmail`, then call again with verificationId + otp. `booked`: the appointment exists.",
    "enum": [
     "verification_required",
     "booked"
    ],
    "type": "string"
   },
   "verification": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "expiresAt": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
        "type": "string"
       },
       "maskedEmail": {
        "type": "string"
       },
       "verificationId": {
        "type": "string"
       }
      },
      "required": [
       "verificationId",
       "maskedEmail",
       "expiresAt"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "requestId",
   "status",
   "verification",
   "appointment",
   "attribution",
   "meta"
  ],
  "type": "object"
 },
 "title": "Book a free AfAMax initial call"
}
