  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Books a free 15-minute initial phone call with the AfAMax team, in two steps.\n\nSTEP 1: after the user picked a slot from get_available_appointments, confirm the slot, their name and their own e-mail address with them, then call with startDateTime, name, email (and optionally phone, locale). AfAMax e-mails a 6-digit code to that address and returns status \"verification_required\" with a verificationId.\n\nSTEP 2: ask the user for the code from that e-mail and call again with only verificationId and otp. The code proves the address belongs to the user: use only the code the user gives you \u2014 never guess, invent or repeatedly retry codes. On success status is \"booked\" and a calendar invitation goes to the user.\n\nCodes expire after 15 minutes and allow 5 attempts. If the slot was taken meanwhile, list slots again and offer another. If the e-mail belongs to an existing AfAMax account, the user must log in and book on the website (link in the error). Only book for the person you are talking to.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "email": {
    "description": "Step 1 \u2014 the user's own e-mail address; the 6-digit confirmation code is sent there. Confirm it with the user before calling. / E-Mail-Adresse f\u00fcr den Best\u00e4tigungscode.",
    "format": "email",
    "maxLength": 254,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "locale": {
    "description": "Step 1 \u2014 language of the confirmation e-mail, the appointment and the links (`de` if omitted); match the user's language. Step 2 keeps step 1's language unless set. / Sprache der E-Mails und des Termins.",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "name": {
    "description": "Step 1 \u2014 the user's full name. / Vor- und Nachname.",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   },
   "otp": {
    "description": "Step 2 \u2014 the 6-digit code the user received by e-mail. Only ever the code the user gives you; never guess or retry codes. / Der 6-stellige Code aus der E-Mail.",
    "pattern": "^\\d{6}$",
    "type": "string"
   },
   "phone": {
    "description": "Step 1, optional \u2014 phone number for the call. / Telefonnummer f\u00fcr das Gespr\u00e4ch.",
    "maxLength": 40,
    "type": "string"
   },
   "startDateTime": {
    "description": "Step 1 \u2014 the chosen slot, copied exactly from get_available_appointments `startDateTime`.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "verificationId": {
    "description": "Step 2 \u2014 the `verificationId` returned by step 1.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "book_appointment",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "appointment": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "customerInviteSent": {
        "type": "boolean"
       },
       "durationMinutes": {
        "type": "number"
       },
       "endDateTime": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
        "type": "string"
       },
       "localDate": {
        "type": "string"
       },
       "localTime": {
        "type": "string"
       },
       "startDateTime": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
        "type": "string"
       },
       "timeZone": {
        "type": "string"
       }
      },
      "required": [
       "startDateTime",
       "endDateTime",
       "localDate",
       "localTime",
       "timeZone",
       "durationMinutes",
       "customerInviteSent"
      ],
      "type": "object"
     },
     {
      "type": "null"
