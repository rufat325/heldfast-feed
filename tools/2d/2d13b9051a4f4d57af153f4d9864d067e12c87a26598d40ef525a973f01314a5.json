 "description": "Create an accrual schedule that spreads a total amount across N monthly periods as accrual-only adjusting entries (e.g. amortize a prepaid, defer revenue, depreciate an asset). Each period posts Dr debit_gl_account / Cr credit_gl_account for its share; the split is straight-line with any rounding remainder on the final period. Pick gl_account_id values from accounting_get_chart_of_accounts. Cash-basis reports are unaffected.",
 "inputSchema": {
  "properties": {
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "creditGlAccountId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "currencyCode": {
    "maxLength": 3,
    "pattern": "^([A-Z]{3})?$",
    "type": "string"
   },
   "debitGlAccountId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "kind": {
    "enum": [
     "SCHEDULE_KIND_PREPAID_AMORTIZATION",
     "SCHEDULE_KIND_DEFERRED_REVENUE",
     "SCHEDULE_KIND_DEPRECIATION",
     "SCHEDULE_KIND_ACCRUAL_SPREAD"
    ],
    "type": "string"
   },
   "periodCount": {
    "maximum": 600,
    "minimum": 1,
    "type": "integer"
   },
   "sourceTransactionId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "startDate": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "totalAmount": {
    "maxLength": 30,
    "minLength": 1,
    "pattern": "^[0-9]+\\.[0-9]{1,4}$",
    "type": "string"
   }
  },
  "required": [
   "companyId",
   "debitGlAccountId",
   "creditGlAccountId"
  ],
  "type": "object"
 },
