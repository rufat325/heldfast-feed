{"annotations":{"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"After the person decides on a whole group from group_matches: record one decision (approve confirms each row's latest proposal; reject, defer or intentional_removal) for every row in the group that has no decision yet. Rows already decided are never changed, and rows in except_mapping_ids are left for resolve_matches. expected_selection_revision is the data.selection_revision you showed the person; a revision_conflict means read group_matches again and re-confirm. A data.remaining above 0 means call again with the new selection_revision and a new key.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"action":{"enum":["approve","reject","defer","intentional_removal"],"type":"string"},"except_mapping_ids":{"description":"Rows of the group the person wants to decide separately.","items":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"maxItems":1000,"type":"array"},"expected_selection_revision":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"group_id":{"pattern":"^g_[0-9a-f]{16}$","type":"string"},"idempotency_key":{"description":"Unique per intended change; retry an uncertain call with the identical input and key.","maxLength":200,"minLength":1,"pattern":"^[^\\x00-\\x1f\\x7f]+$","type":"string"},"migration_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"rationale":{"maxLength":2000,"type":"string"},"run_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"}},"required":["migration_id","run_id","group_id","action","expected_selection_revision","idempotency_key"],"type":"object"},"name":"resolve_group","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"contract_version":{"type":"string"},"data":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"error":{"anyOf":[{"additionalProperties":false,"properties":{"code":{"type":"string"},"message":{"type":"string"},"next_action":{"type":"string"},"retryable":{"type":"boolean"}},"required":["code","message","retryable","next_action"],"type":"object"},{"type":"null"}]},"migration_id":{"type":["string","null"]},"next_action":{"type":"string"},"operation_id":{"type":["string","null"]},"retry_after_seconds":{"type":"number"},"status":{"type":"string"}},"required":["contract_version","migration_id","operation_id","status","next_action","data","error"],"type":"object"},"title":"Resolve a group of matches"}
