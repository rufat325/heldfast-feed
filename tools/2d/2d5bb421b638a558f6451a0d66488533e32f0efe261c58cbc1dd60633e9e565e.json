{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Follow a token's references to its final value, in light or dark.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "path": {
    "description": "A token path, e.g. intent.primary.solid or button.height.md",
    "type": "string"
   },
   "scheme": {
    "default": "light",
    "enum": [
     "light",
     "dark"
    ],
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "explain",
 "title": "Explain a token"
}
