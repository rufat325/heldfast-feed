{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Apply exactly one stored host plan after human approval in the customer portal. Revalidates permission, credential revocation, server state, digest and expiry before the existing VPS reinstall operation. The AI cannot approve its own plan. Replay is refused; reconcile a partial effect instead of retrying blindly.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "approval_id": {
    "pattern": "^apr_[a-f0-9]{32}$",
    "type": "string"
   },
   "plan_digest": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "plan_id": {
    "pattern": "^hpl_[a-f0-9]{32}$",
    "type": "string"
   }
  },
  "required": [
   "plan_id",
   "plan_digest",
   "approval_id"
  ],
  "type": "object"
 },
 "name": "impreza_apply_host_plan",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "approval_id": {
      "pattern": "^apr_[a-f0-9]{32}$",
      "type": "string"
     },
     "created_at": {
      "type": "string"
     },
     "expires_at": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "operation": {
      "const": "vps.reinstall",
      "type": "string"
     },
     "plan_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "plan_id": {
      "pattern": "^hpl_[a-f0-9]{32}$",
      "type": "string"
     },
     "provider_ref": {
      "type": [
       "string",
       "null"
      ]
     },
     "service_id": {
      "type": "integer"
     },
     "status": {
      "enum": [
       "prepared",
       "dispatching",
       "submitted",
       "partial",
       "completed",
       "failed",
       "expired",
       "refused"
      ],
      "type": "string"
     },
     "template_id": {
      "type": "integer"
     }
    },
    "required": [
     "plan_id",
     "operation",
     "service_id",
     "template_id",
     "plan_digest",
     "approval_id",
     "status",
     "created_at",
     "expires_at",
     "provider_ref",
     "note"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Apply approved host plan"
}
