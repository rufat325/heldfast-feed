 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "missionId": {
    "description": "the job id returned by run_agent",
    "type": "string"
   }
  },
  "required": [
   "missionId"
  ],
  "type": "object"
 },
 "name": "check_agent_run",
 "outputSchema": {
