   },
   "error": {
    "type": "string"
   },
   "failed": {
    "type": "boolean"
   },
   "goal": {
    "type": "string"
   },
   "missionId": {
    "type": "string"
   },
   "openUrl": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
