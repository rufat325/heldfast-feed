 "description": "Summarise a Terraform plan and name everything it would destroy. A replacement is expressed as a create and a delete together, so reading only the first action would report a destroy and recreate as a plain create; replacements are classified as such. Counts changes by action and by resource type, and reports a destroy or replacement of any resource type or address you declare protected. Pay 200000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "plan": {
    "description": "Terraform plan JSON containing resource_changes, as produced by terraform show -json. Nothing is applied, no provider is contacted and no state is read.",
    "example": {
     "format_version": "1.2",
     "resource_changes": [
      {
       "address": "aws_db_instance.primary",
       "change": {
        "actions": [
         "delete",
         "create"
        ],
        "replace_paths": [
         [
          "engine_version"
         ]
        ]
       },
       "type": "aws_db_instance"
      },
      {
       "address": "aws_s3_bucket.audit_logs",
       "change": {
        "actions": [
         "delete"
        ]
       },
       "type": "aws_s3_bucket"
      },
      {
       "address": "module.networking.aws_vpc.main",
       "change": {
        "actions": [
         "delete",
         "create"
        ]
       },
       "module_address": "module.networking",
       "type": "aws_vpc"
      },
      {
       "address": "aws_iam_role.task",
       "change": {
        "actions": [
         "update"
        ]
       },
       "type": "aws_iam_role"
      },
      {
       "address": "aws_cloudwatch_log_group.app",
       "change": {
        "actions": [
         "create"
        ]
       },
       "type": "aws_cloudwatch_log_group"
      },
      {
       "address": "aws_security_group.app",
       "change": {
        "actions": [
         "no-op"
        ]
       },
       "type": "aws_security_group"
      }
     ],
     "terraform_version": "1.9.5"
    },
    "type": "object"
   },
   "protected_addresses": {
    "description": "Addresses that must not be destroyed or replaced. A module address protects everything inside it.",
    "example": [
     "module.networking"
    ],
    "items": {
     "maxLength": 512,
     "type": "string"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "protected_types": {
    "description": "Resource types that must not be destroyed or replaced, such as a database instance.",
    "example": [
     "aws_db_instance",
     "aws_s3_bucket"
    ],
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "plan"
  ],
  "type": "object"
 },
 "name": "terraform_plan_change_summary",
