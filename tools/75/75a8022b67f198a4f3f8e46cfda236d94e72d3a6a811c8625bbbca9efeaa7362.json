{
 "_meta": {
  "openai/toolInvocation/invoked": "Thread read",
  "openai/toolInvocation/invoking": "Reading the thread\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get an Artifact comment thread"
 },
 "description": "Read one comment thread on an Artifact with every message, oldest first. Mentions in a body look like @[Name](mention:uid); a mention of the agent is @[Agent](mention:agent).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "artifact_id": {
    "description": "The Artifact id (art_\u2026).",
    "pattern": "^art_[a-zA-Z0-9]+$",
    "type": "string"
   },
   "thread_id": {
    "description": "The thread id (thr_\u2026).",
    "pattern": "^thr_[a-zA-Z0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "artifact_id",
   "thread_id"
  ],
  "type": "object"
 },
 "name": "get_artifact_thread",
 "outputSchema": {
  "properties": {
   "agent_activated": {
    "description": "True once someone mentioned the agent; only then may the agent reply or resolve.",
    "type": "boolean"
   },
   "anchor": {
    "description": "Where the thread is pinned: kind element (selector, snapshot, slide), text (quote), or page.",
    "type": "object"
   },
   "artifact_id": {
    "type": "string"
   },
   "created_at": {
    "type": "string"
   },
   "created_by": {
    "description": "Who wrote it: { kind: \"user\", uid, name, handle, avatarUrl } or { kind: \"agent\", principal, name, via }.",
    "type": "object"
   },
   "last_message_at": {
    "type": "string"
   },
   "mentions": {
    "items": {
