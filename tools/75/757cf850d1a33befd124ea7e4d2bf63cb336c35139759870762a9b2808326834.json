{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search trains and return only matches by seat/car filters. Use requirePair=true for adjacent lower+upper places.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adults": {
    "default": 1,
    "description": "Adult passengers.",
    "maximum": 9,
    "minimum": 1,
    "type": "integer"
   },
   "carType": {
    "description": "coupe, platz, or raw RZD car type text.",
    "type": "string"
   },
   "children": {
    "default": 0,
    "description": "Child passengers.",
    "maximum": 9,
    "minimum": 0,
    "type": "integer"
   },
   "date": {
    "description": "Travel date in YYYY-MM-DD.",
    "type": "string"
   },
   "departureFrom": {
    "description": "Local departure lower bound HH:mm.",
    "type": "string"
   },
   "departureTo": {
    "description": "Local departure upper bound HH:mm.",
    "type": "string"
   },
   "destination": {
    "description": "RZD expressCode or nodeId of destination station.",
    "type": "string"
   },
   "destinationNodeId": {
    "description": "Optional nodeId for building checkout URL.",
    "type": "string"
   },
   "includeAccessible": {
    "default": false,
    "description": "Include disabled/special places.",
    "type": "boolean"
   },
   "includeImages": {
    "default": true,
    "description": "Fetch RZD car photo gallery URLs when CarPricing says HasImages=true.",
    "type": "boolean"
   },
   "includeSide": {
    "default": false,
    "description": "Include side places.",
    "type": "boolean"
   },
   "largeFamily": {
    "default": false,
    "description": "Search large-family availability.",
    "type": "boolean"
   },
   "maxPrice": {
    "description": "Maximum price in RUB.",
    "type": "number"
   },
   "minPlaces": {
    "description": "Minimum places in a car row.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "origin": {
    "description": "RZD expressCode or nodeId of origin station, e.g. 2038000 or 5a13...",
    "type": "string"
   },
   "originNodeId": {
    "description": "Optional nodeId for building checkout URL.",
    "type": "string"
   },
   "placeKind": {
    "description": "Seat kind filter.",
    "enum": [
     "lower",
     "upper",
     "other"
    ],
    "type": "string"
   },
   "requirePair": {
    "default": false,
    "description": "Return only adjacent lower+upper pairs.",
    "type": "boolean"
   },
   "service": {
    "description": "Raw RZD service class code, e.g. 2\u041a, 2\u0410, 2\u0428. The code set is open-ended.",
    "type": "string"
   },
   "train": {
    "description": "Single exact train number.",
    "type": "string"
   },
   "trains": {
    "description": "Exact train numbers, e.g. [\"097\u042d\"].",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "origin",
   "destination",
   "date"
  ],
  "type": "object"
 },
 "name": "rzd_find_places",
 "title": "Find matching RZD places"
}
