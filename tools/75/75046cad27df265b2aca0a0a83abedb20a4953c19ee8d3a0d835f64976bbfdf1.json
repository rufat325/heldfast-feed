{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Check the files you wrote for invented commands: every effect, trigger and modifier that the installed game documentation does not list and no loaded file defines, with its file, line and the closest real name. Checks the named paths, or the mod script files changed in the last 120 minutes. Needs hoi4-engine. Example: {\"paths\":[\"events/my_events.txt\"]}. Returns up to 40 names.","inputSchema":{"additionalProperties":false,"properties":{"paths":{"items":{"maxLength":1024,"minLength":1,"type":"string"},"maxItems":50,"minItems":1,"type":"array"},"sinceMinutes":{"default":120,"maximum":10080,"minimum":1,"type":"integer"},"workspaceId":{"default":"current","pattern":"^[a-z][a-z0-9_-]{0,63}$","type":"string"}},"type":"object"},"name":"hoi4.script_guard","outputSchema":{"additionalProperties":false,"properties":{"artifacts":{"items":{},"maxItems":32,"type":"array"},"blockers":{"items":{},"type":"array"},"changedFiles":{"items":{},"type":"array"},"code":{"type":"string"},"data":{"additionalProperties":{},"properties":{},"type":"object"},"diagnostics":{"items":{},"maxItems":20,"type":"array"},"filesScanned":{"items":{},"type":"array"},"proposedFiles":{"items":{},"type":"array"},"status":{"enum":["ok","blocked","error"],"type":"string"},"validation":{},"workspaceId":{"type":"string"}},"required":["status","code","workspaceId","validation","data"],"type":"object"},"title":"Find invented commands in new script"}
