{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find Alternative Shops"
 },
 "description": "Given a product's EAN barcode, return every shop that carries it with prices and availability, sorted cheapest-first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "default": "DE",
    "description": "Country for pricing (DE or AT, default DE)",
    "enum": [
     "DE",
     "AT"
    ],
    "type": "string"
   },
   "ean": {
    "description": "EAN barcode (8\u201314 digits, e.g. '4524667749493')",
    "pattern": "^\\d{8,14}$",
    "type": "string"
   }
  },
  "required": [
   "ean"
  ],
  "type": "object"
 },
 "name": "find_alternatives_for_product",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alternatives": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "affiliate_url": {
       "description": "Direct link to buy at this shop.",
       "type": "string"
      },
      "availability": {
       "type": "string"
      },
      "currency": {
       "type": "string"
      },
      "price": {
       "type": "number"
      },
      "shop": {
       "type": "string"
      }
     },
     "required": [
      "shop",
      "price",
      "currency",
      "affiliate_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "disclosure": {
    "type": "string"
   },
   "ean": {
    "type": "string"
   },
   "product_name": {
    "type": "string"
   }
  },
  "required": [
   "ean",
   "product_name",
   "alternatives"
  ],
  "type": "object"
 },
 "title": "Find Alternative Shops"
}
