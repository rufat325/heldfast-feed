{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Ask Elfa for written market analysis grounded in its social data. Costs credits and varies by speed, so fast is the cheaper option. Pass sessionId from a previous reply to continue the same conversation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "analysisType": {
    "default": "chat",
    "description": "chat needs message. tokenIntro and tokenAnalysis need symbol, or chain plus contractAddress. accountAnalysis needs username. macro and summary need nothing else.",
    "enum": [
     "chat",
     "macro",
     "summary",
     "tokenIntro",
     "tokenAnalysis",
     "accountAnalysis"
    ],
    "type": "string"
   },
   "chain": {
    "description": "Chain, paired with contractAddress.",
    "type": "string"
   },
   "contractAddress": {
    "description": "Contract address, paired with chain.",
    "type": "string"
   },
   "message": {
    "description": "The question, required for analysisType=chat.",
    "type": "string"
   },
   "sessionId": {
    "description": "Continue an earlier conversation.",
    "type": "string"
   },
   "speed": {
    "default": "fast",
    "description": "Defaults to fast, which is cheaper and shallower. Ask for expert when the answer needs deeper reasoning.",
    "enum": [
     "fast",
     "expert",
     "adaptive"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Token symbol, for token analysis.",
    "type": "string"
   },
   "username": {
    "description": "X username, for analysisType=accountAnalysis.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "market_chat",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "creditsConsumed": {
    "type": [
     "number",
     "null"
    ]
   },
   "message": {
    "type": "string"
   },
   "sessionId": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "message",
   "sessionId",
   "creditsConsumed"
  ],
  "type": "object"
 },
 "title": "Market chat"
}
