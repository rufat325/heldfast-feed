{"description":"Run a Performance report query \u2014 sets searchType, dateRange (preset or custom), primary dimension, chip filters, and optional comparison; returns total clicks/impressions/CTR/position plus full table rows as JSON. Auto-scrolls the grid to load up to `limit` rows.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"compare":{"description":"Enable date-range comparison.","type":"boolean"},"customEnd":{"description":"YYYY-MM-DD end (with dateRange=\"custom\").","type":"string"},"customStart":{"description":"YYYY-MM-DD start (with dateRange=\"custom\").","type":"string"},"dateRange":{"description":"Preset range or \"custom\" with customStart/customEnd.","enum":["24h","7d","28d","3m","6m","12m","16m","custom"],"type":"string"},"dimension":{"description":"Primary dimension to group by. Default: query.","enum":["query","page","country","device","searchAppearance","date"],"type":"string"},"filters":{"description":"Chip filters to apply. Op default: contains.","items":{"additionalProperties":false,"properties":{"op":{"enum":["contains","notContains","equals","notEquals","regex","notRegex"],"type":"string"},"type":{"enum":["query","page","country","device"],"type":"string"},"value":{"type":"string"}},"required":["type","value"],"type":"object"},"type":"array"},"limit":{"description":"Max rows (default 200, GSC table caps at 1000 visible).","exclusiveMinimum":0,"type":"integer"},"property":{"type":"string"},"searchType":{"description":"Search type filter. Default: web.","enum":["web","image","video","news","discover","googleNews"],"type":"string"},"sessionId":{"type":"string"},"tabId":{"type":"string"}},"type":"object"},"name":"gsc_performance_query"}
