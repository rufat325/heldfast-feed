{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Invoice"
 },
 "description": "Create a new invoice for a customer. Optionally include line items inline. Returns the new invoiceId.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "Customer accountId (CRM account)",
    "type": "string"
   },
   "currency": {
    "description": "ISO currency code (defaults to company default)",
    "type": "string"
   },
   "dueDate": {
    "description": "Due date (ISO 8601 date)",
    "type": "string"
   },
   "lineItems": {
    "description": "Line items to bill \u2014 totals are computed server-side",
    "items": {
     "properties": {
      "description": {
       "description": "Line item description",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity (default 1)",
       "type": "number"
      },
      "unitPrice": {
       "description": "Unit price as decimal string, e.g. \"100.00\"",
       "type": "string"
      }
     },
     "required": [
      "description",
      "unitPrice"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "description": "Free-form notes shown on the invoice",
    "type": "string"
   }
  },
  "required": [
   "accountId"
  ],
  "type": "object"
 },
 "name": "create_invoice",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
