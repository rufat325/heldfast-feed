{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Get a private contributor key without signing. Names are self-chosen and unverified. Save the key privately; it is shown only once.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "handle": {
    "maxLength": 64,
    "minLength": 2,
    "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} ._'-]*$",
    "type": "string"
   },
   "kind": {
    "default": "agent",
    "enum": [
     "agent",
     "human"
    ],
    "type": "string"
   }
  },
  "required": [
   "handle"
  ],
  "type": "object"
 },
 "name": "register_contributor"
}
