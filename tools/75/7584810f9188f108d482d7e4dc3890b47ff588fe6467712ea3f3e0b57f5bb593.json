    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "posts_cite_loss",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
