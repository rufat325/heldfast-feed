       "type": "string"
      },
      "replaced_by_url": {
       "type": "string"
      }
     },
     "required": [
      "llm",
      "query",
      "last_seen"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "active",
   "losses"
  ],
  "type": "object"
 },
