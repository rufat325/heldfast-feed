{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use AFTER match_offer identifies EverMaps, or when the user explicitly needs map-ready evidence. Queries only EverMaps records already marked public_safe=true and read_only=true across approved projection layers. Exact sensitive lifeline-asset topology is deliberately excluded. Results preserve evidence state, freshness, cautions and source references and are not official warning or navigation authority.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bbox": {
    "properties": {
     "east": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "north": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "south": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "west": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     }
    },
    "required": [
     "west",
     "south",
     "east",
     "north"
    ],
    "type": "object"
   },
   "layer": {
    "enum": [
     "climate_ocean",
     "river_history",
     "observation_platforms",
     "navigation_lights",
     "heat_smoke_action_sites",
     "heat_smoke_access_gaps",
     "volcanic_lakes",
     "lifeline_coverage"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "layer"
  ],
  "type": "object"
 },
 "name": "query_evermaps_public_projection",
 "title": "Query public-safe EverMaps evidence projections"
}
