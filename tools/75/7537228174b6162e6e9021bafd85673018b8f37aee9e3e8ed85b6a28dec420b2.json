{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "FINAL WORKFLOW FOUNDRY REQUEST STEP. Use only AFTER workflow-xray-v1 or workflow-proof-sprint-v1 has been matched/reviewed and the human explicitly asks Evercraft to review the workflow. Records bounded contact and workflow context only. Do not include passwords, API keys, production credentials, protected customer records, medical records or financial account credentials. It creates no checkout, charge, payment obligation, private-system access, production mutation, regulated authority, financial authority or third-party communication.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "current_tools": {
    "maxLength": 1500,
    "type": "string"
   },
   "desired_outcome": {
    "maxLength": 1800,
    "type": "string"
   },
   "email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "human_confirmed": {
    "const": true,
    "type": "boolean"
   },
   "idempotency_key": {
    "maxLength": 240,
    "minLength": 8,
    "type": "string"
   },
   "industry": {
    "maxLength": 160,
    "type": "string"
   },
   "monthly_volume": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "offer_public_id": {
    "enum": [
     "workflow-xray-v1",
     "workflow-proof-sprint-v1"
    ],
    "type": "string"
   },
   "organization": {
    "maxLength": 240,
    "type": "string"
   },
   "source": {
    "default": "evercraft-machine-commerce-mcp",
    "maxLength": 160,
    "type": "string"
   },
   "website": {
    "maxLength": 800,
    "type": "string"
   },
   "workflow_description": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "workflow_name": {
    "maxLength": 240,
    "type": "string"
   }
  },
  "required": [
   "idempotency_key",
   "offer_public_id",
   "name",
   "email",
   "workflow_description",
   "human_confirmed"
  ],
  "type": "object"
 },
 "name": "submit_workflow_foundry_request",
 "title": "Submit an Evercraft Workflow Foundry request"
}
