  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "margin": {
    "description": "Page margin (default: \"20mm\")",
    "type": "string"
   },
   "markdown": {
    "description": "Markdown content to convert",
    "type": "string"
   },
   "orientation": {
    "description": "Orientation: portrait, landscape (default: portrait)",
    "type": "string"
   },
   "page_size": {
    "description": "Page size: A4, Letter, Legal (default: A4)",
    "type": "string"
   },
   "title": {
    "description": "Document title for PDF metadata",
    "type": "string"
   }
  },
  "required": [
   "markdown"
  ],
  "type": "object"
 },
 "name": "markdown_to_pdf"
}
