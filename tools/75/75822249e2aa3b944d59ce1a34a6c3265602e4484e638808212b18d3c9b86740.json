{
 "description": "Browse a merchant's product catalog.\n\nActions:\n  list       \u2014 list active products (default; supports ?category=)\n  search     \u2014 full-text search on name + description\n  get        \u2014 fetch one product by id or slug\n\nDefaults to 0ncore.com merchant.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Default 'list'",
    "enum": [
     "list",
     "search",
     "get"
    ],
    "type": "string"
   },
   "category": {
    "description": "Filter by category slug (list action)",
    "type": "string"
   },
   "id": {
    "description": "Product id (get action)",
    "type": "string"
   },
   "merchant": {
    "format": "uri",
    "type": "string"
   },
   "query": {
    "description": "Search query (search action)",
    "type": "string"
   },
   "slug": {
    "description": "Product slug (get action)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ucp_catalog"
}
