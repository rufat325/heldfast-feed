{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new opportunity/deal in a pipeline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignedTo": {
    "description": "Assigned user ID",
    "type": "string"
   },
   "contactId": {
    "description": "Contact ID to associate",
    "type": "string"
   },
   "customFields": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "field_value": {
       "type": [
        "string",
        "number",
        "boolean"
       ]
      },
      "id": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "field_value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "locationId": {
    "type": "string"
   },
   "monetaryValue": {
    "description": "Deal value in currency",
    "type": "number"
   },
   "name": {
    "description": "Opportunity/deal name",
    "type": "string"
   },
   "pipelineId": {
    "description": "Pipeline ID to create opportunity in",
    "type": "string"
   },
   "pipelineStageId": {
    "description": "Stage ID within the pipeline",
    "type": "string"
   },
   "source": {
    "description": "Lead source",
    "type": "string"
   },
   "status": {
    "default": "open",
    "enum": [
     "open",
     "won",
     "lost",
     "abandoned"
    ],
    "type": "string"
   }
  },
  "required": [
   "pipelineId",
   "pipelineStageId",
   "contactId",
   "name"
  ],
  "type": "object"
 },
 "name": "ghl_create_opportunity",
 "title": "Create GHL Opportunity"
}
