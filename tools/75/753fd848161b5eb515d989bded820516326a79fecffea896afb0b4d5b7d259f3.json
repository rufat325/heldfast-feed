{
 "description": "Create a Runway task on RunAPI (text to video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "aspect_ratio": {
    "description": "Declared type: string. Known values: \"16:9\", \"9:16\", \"1:1\", \"4:3\", \"3:4\".",
    "type": "string"
   },
   "callback_url": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "duration_seconds": {
    "description": "Declared type: integer. Known values: 5, 10.",
    "type": "integer"
   },
   "first_frame_image_url": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "type": "string"
   },
   "output_resolution": {
    "description": "Declared type: string. Known values: \"720p\", \"1080p\".",
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   },
   "watermark": {
    "description": "Declared type: string.",
    "type": "string"
   }
  },
  "required": [
   "prompt",
   "duration_seconds",
   "output_resolution"
  ],
  "type": "object"
 },
 "name": "text_to_video"
}
