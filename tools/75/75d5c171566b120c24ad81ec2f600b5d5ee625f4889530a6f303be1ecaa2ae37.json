     "type": "string"
    },
    "type": "array"
   },
   "addedAt": {
    "type": "string"
   },
   "agentUrl": {
    "type": "string"
   },
   "authType": {
    "type": "string"
   },
   "categories": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "description": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "official": {
