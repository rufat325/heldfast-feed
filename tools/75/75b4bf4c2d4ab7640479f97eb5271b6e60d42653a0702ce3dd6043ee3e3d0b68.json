{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Search Alpine mountain huts by country, region, name, access difficulty, minimum elevation or proximity to a point. Returns a page of hut summaries with slugs for get-hut.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "Country slug from list-regions, e.g. \"austria\".",
    "type": "string"
   },
   "difficulty": {
    "description": "Access difficulty.",
    "enum": [
     "easy",
     "moderate",
     "demanding",
     "technical"
    ],
    "type": "string"
   },
   "min_elevation": {
    "description": "Minimum elevation in metres.",
    "type": "integer"
   },
   "near": {
    "description": "\"latitude,longitude\" to search around, e.g. \"46.02,7.75\".",
    "type": "string"
   },
   "page": {
    "description": "Page number, from 1.",
    "type": "integer"
   },
   "per_page": {
    "description": "Results per page (max 100).",
    "type": "integer"
   },
   "q": {
    "description": "Free-text match on the hut name.",
    "type": "string"
   },
   "radius_km": {
    "description": "Radius around `near` in km (default 25, max 200).",
    "type": "number"
   },
   "region": {
    "description": "Region slug from list-regions, e.g. \"tyrol\".",
    "type": "string"
   },
   "sort": {
    "description": "Sort order.",
    "enum": [
     "score",
     "elevation",
     "name"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search-huts",
 "title": "Search Huts Tool"
}
