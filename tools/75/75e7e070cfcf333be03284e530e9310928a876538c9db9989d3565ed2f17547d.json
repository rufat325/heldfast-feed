{
 "description": "Compare historical price deviations across oracle providers for an asset. Helps identify which providers consistently diverge from consensus.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Start date in YYYY-MM-DD format",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "interval": {
    "description": "Aggregation interval",
    "enum": [
     "1h",
     "6h",
     "24h"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Asset symbol, e.g. BTC, ETH",
    "type": "string"
   },
   "to": {
    "description": "End date in YYYY-MM-DD format",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "compare_oracle_deviation"
}
