{
 "description": "Paid exact-action authority preflight for consequential agent tool calls. Binds subject, tool, operation, target, canonical parameters, authority lifetime, retries and postcondition requirements. Costs $0.25 USDC on Base.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "additionalProperties": true,
    "properties": {
     "consequence": {
      "enum": [
       "read",
       "write",
       "send",
       "deploy",
       "payment",
       "delete",
       "account_mutation",
       "external_submission",
       "device_mutation"
      ],
      "type": "string"
     },
     "operation": {
      "minLength": 1,
      "type": "string"
     },
     "parameters": {
      "additionalProperties": {},
      "type": "object"
     },
     "target": {
      "additionalProperties": true,
      "properties": {
       "id": {
        "minLength": 1,
        "type": "string"
       },
       "kind": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "kind",
       "id"
      ],
      "type": "object"
     },
     "tool": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "tool",
     "operation",
     "consequence",
     "target"
    ],
    "type": "object"
   },
   "action_id": {
    "description": "Unique action-intent identifier",
    "minLength": 1,
    "type": "string"
   },
   "authority": {
    "additionalProperties": true,
    "properties": {
     "allow_retry": {
      "type": "boolean"
     },
     "allowed_operations": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "allowed_targets": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "id": {
         "minLength": 1,
         "type": "string"
        },
        "kind": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "kind",
        "id"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "allowed_tools": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "attestation_verified": {
      "type": "boolean"
     },
     "expected_parameters_hash": {
      "type": "string"
     },
     "expires_at": {
      "type": "string"
     },
     "human_confirmation_required": {
      "type": "boolean"
     },
     "human_confirmed": {
      "type": "boolean"
     },
     "max_attempts": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "postcondition_required": {
      "type": "boolean"
     },
     "subject_id": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "expires_at",
     "subject_id",
     "allowed_tools",
     "allowed_operations",
     "allowed_targets"
    ],
    "type": "object"
   },
   "execution": {
    "additionalProperties": true,
    "properties": {
     "attempt": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "idempotency_key": {
      "type": "string"
     },
     "prior_outcome": {
      "enum": [
       "NONE",
       "KNOWN_NO_EFFECT",
       "EFFECT_CONFIRMED",
       "UNKNOWN"
      ],
      "type": "string"
     },
     "retry_authorized": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "expires_at": {
    "description": "ISO-8601 action-intent expiry",
    "type": "string"
   },
   "nonce": {
    "description": "Unique anti-replay nonce",
    "minLength": 8,
    "type": "string"
   },
   "postcondition": {
    "additionalProperties": true,
    "properties": {
     "authoritative_source": {
      "minLength": 1,
      "type": "string"
     },
     "type": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "type",
     "authoritative_source"
    ],
    "type": "object"
   },
   "subject": {
    "additionalProperties": true,
    "properties": {
     "id": {
      "minLength": 1,
      "type": "string"
     },
     "identity_verified": {
      "type": "boolean"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "action_id",
   "nonce",
   "expires_at",
   "subject",
   "action",
   "authority"
  ],
  "type": "object"
 },
 "name": "verify_agent_action_intent",
 "title": "Verify Agent Action Intent"
}
