{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update infrastructure LoS target"
 },
 "description": "Update an infrastructure LoS target by ID. base_target stays on 0-100. Requires los_targets:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "active": {
    "description": "Whether the target is scored",
    "type": "boolean"
   },
   "base_target": {
    "description": "Base target, 0-100",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "feature_class": {
    "description": "Feature class code - resolve first via list_infrastructure_feature_classes",
    "pattern": "^[a-z][a-z0-9_]{0,49}$",
    "type": "string"
   },
   "id": {
    "description": "Infrastructure LoS target ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "metric": {
    "description": "Metric the target tracks",
    "enum": [
     "fci",
     "asset_condition_avg",
     "asset_past_useful_life_pct"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_infrastructure_los_target",
 "title": "Update infrastructure LoS target"
}
