{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"\u0423\u0442\u0438\u043b\u044c\u0441\u0431\u043e\u0440 \u0438 \u0440\u0430\u0441\u0442\u0430\u043c\u043e\u0436\u043a\u0430"},"description":"\u0420\u0430\u0441\u0447\u0451\u0442 \u0443\u0442\u0438\u043b\u044c\u0441\u0431\u043e\u0440\u0430 \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u044f \u043f\u043e 30-\u043c\u0438\u043d\u0443\u0442\u043d\u043e\u0439 \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u0438 (\u043a\u0412\u0442 \u0438\u043b\u0438 \u043b.\u0441.), \u0432\u043e\u0437\u0440\u0430\u0441\u0442\u0443 (\u043d\u043e\u0432\u044b\u0439 \u0438\u043b\u0438 \u0441\u0442\u0430\u0440\u0448\u0435 3 \u043b\u0435\u0442) \u0438 \u043f\u0440\u043e\u0444\u0438\u043b\u044e \u0432\u0432\u043e\u0437\u0430 (\u0444\u0438\u0437\u043b\u0438\u0446\u043e \u0434\u043b\u044f \u0441\u0435\u0431\u044f \u0438\u043b\u0438 \u043a\u043e\u043c\u043c\u0435\u0440\u0447\u0435\u0441\u043a\u0438\u0439); \u0441 \u0442\u0430\u043c\u043e\u0436\u0435\u043d\u043d\u043e\u0439 \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c\u044e \u2014 \u0432\u0441\u044f \u0440\u0430\u0441\u0442\u0430\u043c\u043e\u0436\u043a\u0430: \u043f\u043e\u0448\u043b\u0438\u043d\u0430 15%, \u0443\u0442\u0438\u043b\u044c\u0441\u0431\u043e\u0440, \u0442\u0430\u043c\u043e\u0436\u0435\u043d\u043d\u044b\u0439 \u0441\u0431\u043e\u0440, \u0421\u0411\u041a\u0422\u0421 (\u0434\u043e\u043f\u0443\u0449\u0435\u043d\u0438\u0435 90 000 \u0440\u0443\u0431.) \u0438 \u0438\u0442\u043e\u0433 \u0431\u0435\u0437 \u041d\u0414\u0421 \u0438 \u0441 \u041d\u0414\u0421 22%. \u0422\u0435 \u0436\u0435 \u0441\u0442\u0430\u0432\u043a\u0438 \u0438 \u0444\u043e\u0440\u043c\u0443\u043b\u0430, \u0447\u0442\u043e \u0432 \u043a\u0430\u043b\u044c\u043a\u0443\u043b\u044f\u0442\u043e\u0440\u0435 /calc. \u0417\u0432\u0430\u0442\u044c \u043d\u0430 \u00ab\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0443\u0442\u0438\u043b\u044c\u0441\u0431\u043e\u0440 \u0437\u0430 \u043c\u0430\u0448\u0438\u043d\u0443 300 \u043b.\u0441.\u00bb, \u00ab\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0441\u0442\u0430\u043c\u043e\u0436\u0438\u0442\u044c \u044d\u043b\u0435\u043a\u0442\u0440\u043e\u043c\u043e\u0431\u0438\u043b\u044c \u0437\u0430 3 \u043c\u043b\u043d\u00bb. EN: Russian recycling fee for an EV by 30-minute power, age and import profile; with a customs value, the full import cost (duty, fee, VAT scenarios).","inputSchema":{"properties":{"customs_value_rub":{"description":"\u0422\u0430\u043c\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u0441\u0442\u043e\u0438\u043c\u043e\u0441\u0442\u044c, \u0440\u0443\u0431. (\u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e): \u0442\u043e\u0433\u0434\u0430 \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044f \u0432\u0441\u044f \u0440\u0430\u0441\u0442\u0430\u043c\u043e\u0436\u043a\u0430","exclusiveMinimum":0,"type":"number"},"personal_use":{"description":"\u0424\u0438\u0437\u043b\u0438\u0446\u043e \u0432\u0432\u043e\u0437\u0438\u0442 \u0434\u043b\u044f \u0441\u0435\u0431\u044f (\u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e true); false \u2014 \u044e\u0440\u043b\u0438\u0446\u043e, \u0418\u041f, \u043f\u0435\u0440\u0435\u043f\u0440\u043e\u0434\u0430\u0436\u0430","type":"boolean"},"power_hp":{"description":"\u041c\u043e\u0449\u043d\u043e\u0441\u0442\u044c \u0432 \u043b.\u0441., \u0435\u0441\u043b\u0438 \u043a\u0412\u0442 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b: \u043f\u0435\u0440\u0435\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u043a\u0430\u043a 1 \u043b.\u0441. = 0,7355 \u043a\u0412\u0442","exclusiveMinimum":0,"type":"number"},"power_kw":{"description":"30-\u043c\u0438\u043d\u0443\u0442\u043d\u0430\u044f \u043c\u043e\u0449\u043d\u043e\u0441\u0442\u044c, \u043a\u0412\u0442 (\u0438\u0437 \u041e\u0422\u0422\u0421 \u0438\u043b\u0438 \u0421\u0411\u041a\u0422\u0421, \u043d\u0435 \u043f\u0438\u043a\u043e\u0432\u0430\u044f). \u041d\u0443\u0436\u043d\u0430 \u043e\u043d\u0430 \u0438\u043b\u0438 power_hp","exclusiveMinimum":0,"type":"number"},"used":{"description":"\u041c\u0430\u0448\u0438\u043d\u0430 \u0441\u0442\u0430\u0440\u0448\u0435 3 \u043b\u0435\u0442 (\u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e false \u2014 \u043d\u043e\u0432\u0430\u044f)","type":"boolean"}},"type":"object"},"name":"calc_import_fees","outputSchema":{"properties":{"customs":{"properties":{"customs_value_rub":{"type":"number"},"lines":{"items":{"properties":{"amount_rub":{"type":"number"},"key":{"type":"string"},"label":{"type":"string"},"note":{"type":["string","null"]},"source":{"type":"string"}},"required":["key","label","amount_rub","source"],"type":"object"},"type":"array"},"total_no_vat_rub":{"type":"integer"},"total_with_vat_rub":{"type":"integer"},"vat_rub":{"type":"integer"}},"type":["object","null"]},"personal_use":{"type":"boolean"},"power_hp":{"type":"integer"},"power_kw":{"type":"number"},"privileged":{"type":"boolean"},"regulation_url":{"type":"string"},"terms":{"description":"\u0423\u0441\u043b\u043e\u0432\u0438\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0434\u0430\u043d\u043d\u044b\u0445 (\u0430\u0434\u0440\u0435\u0441)","type":"string"},"url":{"type":"string"},"used":{"type":"boolean"},"util_coefficient":{"type":"number"},"util_rub":{"type":"integer"},"util_source":{"type":"string"}},"required":["power_kw","util_coefficient","util_rub","url","terms"],"type":"object"},"title":"\u0423\u0442\u0438\u043b\u044c\u0441\u0431\u043e\u0440 \u0438 \u0440\u0430\u0441\u0442\u0430\u043c\u043e\u0436\u043a\u0430"}
