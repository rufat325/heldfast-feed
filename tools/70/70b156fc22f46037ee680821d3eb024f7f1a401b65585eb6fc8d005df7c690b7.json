{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/text.chunk",
  "agent-utilities/priceMicroUsd": 300
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Split text into at most 200 overlapping chunks with offsets and intact UTF-16 surrogate pairs. PAID: 300 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "maxChars": {
      "maximum": 10000,
      "minimum": 32,
      "type": "integer"
     },
     "overlap": {
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
     },
     "text": {
      "maxLength": 100000,
      "type": "string"
     }
    },
    "required": [
     "text"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "text_chunk",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "chunks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "end": {
       "type": "number"
      },
      "start": {
       "type": "number"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "start",
      "end",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "type": "number"
   },
   "offsetUnit": {
    "type": "string"
   }
  },
  "required": [
   "chunks",
   "offsetUnit",
   "count"
  ],
  "type": "object"
 }
}
