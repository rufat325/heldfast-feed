{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:use"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Upsert one durable memory document per (scope, kind) for the authenticated user. Provide project_id for project-local memory, or null/omit for global. Identity comes from Core via the session bearer, not from input.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "kind": {
    "description": "Memory kind, e.g. study_preference or project_learning_context.",
    "minLength": 1,
    "type": "string"
   },
   "project_id": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Project UUID for project-local memory; null or omitted stores global (user-level) memory."
   },
   "value": {
    "additionalProperties": {},
    "description": "Freeform memory document. MVP convention is { content: string }.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "kind",
   "value"
  ],
  "type": "object"
 },
 "name": "write-memory",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "createdAt": {
    "description": "Creation timestamp of the row.",
    "type": "string"
   },
   "kind": {
    "description": "Memory kind that was written.",
    "type": "string"
   },
   "projectId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Owning project UUID, or null for global memory."
   },
   "updatedAt": {
    "description": "Last write timestamp of the row.",
    "type": "string"
   },
   "userId": {
    "description": "Owner of the memory document.",
    "type": "string"
   },
   "value": {
    "additionalProperties": {},
    "description": "Stored memory document.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "userId",
   "projectId",
   "kind",
   "value",
   "createdAt",
   "updatedAt"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "mcp:use"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Write Studocu Agent Memory"
}
