   },
   "bucket_id": {
    "description": "Revdoku bucket id returned by bucket_list or bucket_get, for example bkt_...",
    "type": "string"
   },
   "file_id": {
    "description": "Revdoku file id (df_...) returned by bucket_file_write, bucket_file_write_many, or bucket_file_list.",
    "type": "string"
   },
   "path": {
    "description": "Bucket-relative path, used when the file_id is not known.",
    "type": "string"
   },
   "reason": {
    "description": "Optional reason for this action. AI agents should include a short purpose for intentional reads and changes when known. Do not invent a reason or include secrets, file contents, or transcripts.",
