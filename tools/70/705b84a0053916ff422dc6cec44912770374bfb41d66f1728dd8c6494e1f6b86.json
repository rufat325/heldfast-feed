{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Resolve ordinary public product names using bounded filters: Children\u2019s Motrin means brand motrin and audience children; Zyrtec means brand zyrtec; generic cetirizine means ingredient cetirizine; Walmart means brand equate. Omit filters only when unspecified. An unlisted medicine or brand is unsupported; do not drop it or use an ingredient match to substitute another product. Lists matching calculator bottles and separately marked reference-only CVS, Equate and Walgreens formulations with sources. Returns clarification guidance for ambiguous matches. No free text or patient inputs. Arguments and results are excluded from operational telemetry.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "audience": {
    "description": "Public wording on the bottle, never a patient age.",
    "enum": [
     "infants",
     "children"
    ],
    "type": "string"
   },
   "brand": {
    "enum": [
     "tylenol",
     "motrin",
     "zyrtec",
     "cvs",
     "equate",
     "walgreens"
    ],
    "type": "string"
   },
   "ingredient": {
    "enum": [
     "acetaminophen",
     "ibuprofen",
     "cetirizine"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_label_references",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "calculator_bottles": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "concentration": {
       "enum": [
        "160 mg / 5 mL",
        "100 mg / 5 mL",
        "50 mg / 1.25 mL",
        "1 mg / mL"
       ],
       "type": "string"
      },
      "ingredient": {
       "type": "string"
      },
      "label_bands": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "age_band": {
          "type": "string"
         },
         "label_band": {
          "type": "string"
         },
         "url": {
          "format": "uri",
          "type": "string"
         },
         "weight_band": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "label_band",
         "weight_band",
         "age_band",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "product_id": {
       "enum": [
        "tylenol-child",
        "tylenol-infant",
        "motrin-child",
        "motrin-infant",
        "zyrtec-child"
       ],
       "type": "string"
      },
      "source": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "product_id",
      "name",
      "ingredient",
      "concentration",
      "note",
      "source",
      "label_bands"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_step": {
    "type": "string"
   },
   "reference_only": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "calculator_supported": {
       "const": false
      },
      "concentration": {
       "type": "string"
      },
      "flavor": {
       "type": "string"
      },
      "form": {
       "type": "string"
      },
      "ingredient": {
       "type": "string"
      },
      "label_updated": {
       "format": "date",
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "package_ndcs": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "package_size": {
       "type": "string"
      },
      "reference_id": {
       "type": "string"
      },
      "retailer": {
       "type": "string"
      },
      "source": {
       "format": "uri",
       "type": "string"
      },
      "source_check_note": {
       "const": "Source verification, not clinical review. Reference-only; not supported by the calculator or get_label_directions. Do not substitute by matching ingredient or strength."
      },
      "source_checked": {
       "const": "2026-09-25"
      }
     },
     "required": [
      "reference_id",
      "calculator_supported",
      "retailer",
      "name",
      "ingredient",
      "concentration",
      "form",
      "flavor",
      "package_size",
      "package_ndcs",
      "source",
      "label_updated",
      "source_checked",
      "source_check_note"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scope": {
    "type": "string"
   },
   "status": {
    "enum": [
     "match_found",
     "clarification_needed",
     "no_match"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "next_step",
   "scope",
   "calculator_bottles",
   "reference_only"
  ],
  "type": "object"
 },
 "title": "Find medicine label references"
}
