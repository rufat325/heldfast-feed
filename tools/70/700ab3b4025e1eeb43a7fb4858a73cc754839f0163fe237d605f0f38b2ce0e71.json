{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search the Dreambooth Studio documentation and FAQ. Call this before answering any question about the product, hardware, printing, booth setup, guest payments, or troubleshooting \u2014 answer from the docs rather than from memory. Pages about Dreambooth's own plans and billing come back as a link only: share the link, and do not quote prices, plans or trials in the conversation. Works without a connected account.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results (default 5)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "description": "Docs language (default en)",
    "enum": [
     "en",
     "id"
    ],
    "type": "string"
   },
   "query": {
    "description": "Search terms, in English or Indonesian",
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_docs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "locale": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "resultCount": {
    "type": "number"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "excerpt": {
       "type": "string"
      },
      "href": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "excerpt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "locale",
   "query",
   "resultCount",
   "results"
  ],
  "type": "object"
 },
 "title": "Search Dreambooth documentation"
}
