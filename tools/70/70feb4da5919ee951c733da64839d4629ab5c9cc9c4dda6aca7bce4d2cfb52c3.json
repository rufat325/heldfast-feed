{
 "_meta": {
  "openai/toolInvocation/invoked": "Edits applied",
  "openai/toolInvocation/invoking": "Applying edits across files"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Apply literal find/replace edits to several files in one call, in the served files (target 'dist', live at once) or the editable source (target 'source', shipped by build_and_deploy). Same edit rules as update_file_content. All or nothing: if any edit's match count differs from its expected count, no file is written.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "files": {
    "description": "Files + edits to apply. Up to 25 files / 200 total edits per call. All-or-nothing: if any edit's match count differs from its expected count, NOTHING is written.",
    "items": {
     "properties": {
      "edits": {
       "description": "Ordered edits applied to THIS file's current state.",
       "items": {
        "properties": {
         "count": {
          "description": "Expected matches: default 1, -1 = replace all, or an exact number.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "find": {
          "description": "Literal text to find (not a regex). Max 64 KB.",
          "maxLength": 65536,
          "minLength": 1,
          "type": "string"
         },
         "replace": {
          "description": "Literal replacement; empty string deletes the match. Max 64 KB.",
          "maxLength": 65536,
          "type": "string"
         }
        },
        "required": [
         "find",
         "replace"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      },
      "path": {
       "description": "Path inside the chosen tree, e.g. index.html.",
       "type": "string"
      }
     },
     "required": [
      "path",
      "edits"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "description": "Site name as shown by list_sites, e.g. my-portfolio.",
    "type": "string"
   },
   "target": {
    "description": "Tree to edit, dist (default) or source. Same tree applies to every file in this call.",
    "enum": [
     "dist",
     "source"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "files"
  ],
  "type": "object"
 },
 "name": "apply_edits",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "afterBytes": {
       "type": "number"
      },
      "beforeBytes": {
       "type": "number"
      },
      "edits": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "find": {
          "type": "string"
         },
         "replacements": {
          "type": "number"
         }
        },
        "required": [
         "find",
         "replacements"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "beforeBytes",
      "afterBytes",
      "edits"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "siteId": {
    "type": "string"
   },
   "target": {
    "enum": [
     "dist",
     "source"
    ],
    "type": "string"
   },
   "totalEdits": {
    "type": "number"
   },
   "warnings": {
    "description": "Secret-scanner findings in the rewritten files that did not block the call. Malicious content blocks the whole call with MALICIOUS_CONTENT instead.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "match": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "type",
      "match"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "siteId",
   "name",
   "target",
   "files",
   "totalEdits"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "deploy",
    "sites:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Multi-file find/replace in one call"
}
