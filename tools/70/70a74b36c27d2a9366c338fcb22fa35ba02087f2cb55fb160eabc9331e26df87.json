     "additionalProperties": false,
     "properties": {
      "fix": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "observed": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "blocking",
        "important",
        "improvement"
       ],
       "type": "string"
      },
      "source_url": {
       "format": "uri",
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "priority",
      "title",
      "observed",
      "source_url",
      "fix"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "kind": {
    "const": "business-site-audit",
    "type": "string"
   },
   "method": {
    "additionalProperties": false,
    "properties": {
     "fetches": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "max_fetches": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "scope": {
      "type": "string"
     }
    },
    "required": [
     "scope",
     "fetches",
     "max_fetches"
    ],
    "type": "object"
   },
   "observed_discovery": {
    "additionalProperties": false,
    "properties": {
     "blocked_crawlers": {
      "anyOf": [
       {
        "additionalProperties": {
         "additionalProperties": false,
         "properties": {
          "kind": {
           "type": "string"
          },
          "matchedBy": {
           "type": "string"
          },
          "rule": {
           "type": "string"
          },
          "verdict": {
           "const": "blocked",
           "type": "string"
          }
         },
         "required": [
          "kind",
          "verdict",
          "matchedBy"
         ],
         "type": "object"
        },
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "robots_status": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "sitemap_entries_seen": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "sitemap_status": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "sitemap_url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
