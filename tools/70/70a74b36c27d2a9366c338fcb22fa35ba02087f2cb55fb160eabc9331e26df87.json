      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "check",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "version": {
    "const": "1.1.2",
    "type": "string"
   }
  },
  "required": [
   "kind",
   "version",
   "target",
   "checked_at",
   "status",
   "summary",
   "top_actions",
   "findings",
