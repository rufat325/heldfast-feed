      ]
     },
     "description": {
      "type": [
       "string",
       "null"
      ]
     },
     "error": {
      "type": [
       "string",
       "null"
      ]
     },
     "http_status": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "json_ld_types": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "url",
     "http_status",
     "title",
