    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "target": {
    "format": "uri",
    "type": "string"
   },
   "top_actions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "fix": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "observed": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "blocking",
        "important",
        "improvement"
       ],
       "type": "string"
      },
      "source_url": {
       "format": "uri",
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "priority",
      "title",
      "observed",
      "source_url",
      "fix"
