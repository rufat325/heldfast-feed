{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Inspect one public business webpage, robots.txt, and sitemap. Return dated HTTP evidence, prioritized fixes, and unknown checks. Use when an owner asks what technical crawl or indexing problems their site has.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "url": {
    "description": "Public HTTP or HTTPS webpage URL, or a public domain name",
    "maxLength": 2048,
    "minLength": 4,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "audit_business_site",
