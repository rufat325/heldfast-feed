{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Search outcomes"},"description":"Search treatments (categories + specific drugs/procedures) and conditions by the names used in the published data. The query must appear in a name as a whole word or phrase (e.g. 'wegovy', 'back pain', 'ct scan'); generic names, abbreviations and drug classes are not translated, so search the brand or the specific treatment. Returns slugs for get_treatment_outcomes / get_condition_outcomes plus headline overturn rates.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"limit":{"description":"Max results per type (default 10)","maximum":50,"minimum":1,"type":"integer"},"query":{"description":"One treatment or condition name, e.g. 'wegovy', 'back pain', 'imaging'","maxLength":200,"minLength":2,"type":"string"}},"required":["query"],"type":"object"},"name":"search_outcomes","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"properties":{"_coverage":{"additionalProperties":false,"properties":{"applicability":{"additionalProperties":false,"properties":{"jurisdiction":{"type":"string"},"personal_deadline_calculated":{"const":false,"type":"boolean"},"scope":{"type":"string"}},"required":["jurisdiction","scope","personal_deadline_calculated"],"type":"object"},"content_reviewed_at":{"anyOf":[{"format":"date","type":"string"},{"type":"null"}],"description":"YYYY-MM-DD only when this specific content has an existing review date; null means no response-wide review date is asserted."},"continuation":{"additionalProperties":false,"properties":{"label":{"type":"string"},"url":{"$ref":"#/properties/_coverage/properties/sources/items/properties/url"}},"required":["label","url"],"type":"object"},"limitations":{"items":{"type":"string"},"type":"array"},"schema_version":{"const":"1.0","type":"strin