{
 "description": "Compare estimated search traffic across multiple domains, subdomains, or URLs before spending deeper analysis credits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "include_featured_snippet": {
    "default": true,
    "type": "boolean"
   },
   "include_local_pack": {
    "default": false,
    "type": "boolean"
   },
   "include_paid": {
    "default": true,
    "type": "boolean"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "location_code": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "sort_by": {
    "default": "organic_traffic",
    "enum": [
     "organic_traffic",
     "total_traffic",
     "paid_traffic",
     "opportunity",
     "target"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "targets": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "targets"
  ],
  "type": "object"
 },
 "name": "agentseo_domain_traffic_estimate",
 "title": "AgentSEO Domain Traffic Estimate"
}
