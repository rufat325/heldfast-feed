{
 "description": "Run LinearFit to scale a linear image to match a reference view. The reference is not modified.",
 "inputSchema": {
  "properties": {
   "reference_id": {
    "description": "Reference view ID.",
    "type": "string"
   },
   "reject_high": {
    "default": 0.92,
    "description": "High rejection threshold.",
    "type": "number"
   },
   "reject_low": {
    "default": 0,
    "description": "Low rejection threshold.",
    "type": "number"
   },
   "view_id": {
    "description": "PixInsight view identifier.",
    "type": "string"
   }
  },
  "required": [
   "view_id",
   "reference_id"
  ],
  "type": "object"
 },
 "name": "linear_fit"
}
