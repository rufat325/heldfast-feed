{
 "description": "Create multiple isolated browser sessions concurrently \u2014 5-10x faster than sequential session_create calls. Optionally navigate each to a URL. Returns all session IDs. A single reflow positions all windows into a unified grid after all sessions are created.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "sessions": {
    "description": "Array of sessions to create.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "headed": {
       "description": "Run with visible UI.",
       "type": "boolean"
      },
      "pinned": {
       "description": "Pin to prevent idle timeout.",
       "type": "boolean"
      },
      "profile": {
       "description": "Profile shorthand name for persistent Chrome profile.",
       "type": "string"
      },
      "url": {
       "description": "URL to navigate after creation.",
       "type": "string"
      },
      "viewport": {
       "additionalProperties": false,
       "description": "Custom viewport.",
       "properties": {
        "height": {
         "type": "number"
        },
        "width": {
         "type": "number"
        }
       },
       "required": [
        "width",
        "height"
       ],
       "type": "object"
      },
      "waitUntil": {
       "description": "Wait strategy for navigation.",
       "enum": [
        "load",
        "domcontentloaded",
        "networkidle"
       ],
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 15,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "sessions"
  ],
  "type": "object"
 },
 "name": "session_create_batch",
 "title": "Create Multiple Browser Sessions"
}
