    "type": "integer"
   },
   "query": {
    "description": "Search words or a quoted phrase (1-200 printable characters), such as x402 payments. Both sources match words, not meaning.",
    "maxLength": 200,
    "minLength": 1,
    "title": "Query",
    "type": "string"
   },
   "since": {
    "anyOf": [
     {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional: only posts newer than this. An ISO 8601 date or time (2026-10-12 or 2026-10-12T08:00:00Z, UTC when no zone is given) or a window back from now: 90m, 24h, 7d or 2w. Default: no limit.",
    "title": "Since"
   },
   "sources": {
    "anyOf": [
     {
      "items": {
       "enum": [
        "bluesky",
        "hackernews"
       ],
       "type": "string"
      },
