  "title": "Read bundled Kibi skills"
 },
 "description": "Read bundled Kibi agent skills (workflow guidance). action:list returns the catalog; action:load returns a skill's metadata, Markdown body, declared resources and content hash (start with id 'kibi-usage'); action:read returns one manifest-declared resource. Read-only; does not require Prolog.",
 "execution": {
  "taskSupport": "forbidden"
 },
