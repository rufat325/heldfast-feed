{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Voxtral speech-to-text"
 },
 "description": "Transcribe an audio file to text using Mistral Voxtral.\n\nAccepted models:\n  - voxtral-mini-latest\n  - voxtral-small-latest\n\nAudio source is one of:\n  - { type: \"file_url\", fileUrl: \"https://...\" }  (public URL)\n  - { type: \"file\", fileId: \"<id-from-files-api>\" }\n\nOptions:\n  - `language`: ISO-639-1 hint (e.g. 'fr', 'en'). Boosts accuracy when known.\n  - `temperature`: sampling temperature.\n  - `diarize`: return per-speaker segments (default false).\n  - `timestampGranularities`: ['segment'] to return per-segment timestamps.\n  - `contextBias`: list of phrases/terms that should bias the decoder.\n\nReturns plain `text`, detected `language`, optional `segments[]`, and token usage.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audio": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "fileUrl": {
        "description": "HTTPS URL to an audio file (mp3/wav/flac/ogg/webm/m4a).",
        "type": "string"
       },
       "type": {
        "const": "file_url",
        "type": "string"
       }
      },
      "required": [
       "type",
       "fileUrl"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "fileId": {
        "description": "ID of an audio file previously uploaded via the Files API (purpose=audio).",
        "type": "string"
       },
       "type": {
        "const": "file",
        "type": "string"
       }
      },
      "required": [
       "type",
       "fileId"
      ],
      "type": "object"
     }
    ]
   },
   "contextBias": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "diarize": {
    "type": "boolean"
   },
   "language": {
    "description": "ISO-639-1 language hint (e.g. 'fr', 'en').",
    "type": "string"
   },
   "model": {
    "description": "STT model. Default: voxtral-mini-latest.",
    "enum": [
     "voxtral-mini-latest",
     "voxtral-small-latest"
    ],
    "type": "string"
   },
   "temperature": {
    "maximum": 2,
    "minimum": 0,
    "type": "number"
   },
   "timestampGranularities": {
    "description": "Only 'segment' is currently supported.",
    "items": {
     "enum": [
      "segment"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "audio"
  ],
  "type": "object"
 },
 "name": "voxtral_transcribe",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "language": {
    "type": [
     "string",
     "null"
    ]
   },
   "model": {
    "type": "string"
   },
   "segments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "end": {
       "type": "number"
      },
      "score": {
       "type": "number"
      },
      "speaker_id": {
       "type": "string"
      },
      "start": {
       "type": "number"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text",
      "start",
      "end"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "text": {
    "type": "string"
   },
   "usage": {
    "additionalProperties": false,
    "properties": {
     "completionTokens": {
      "type": "number"
     },
     "promptTokens": {
      "type": "number"
     },
     "totalTokens": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "text",
   "model",
   "language"
  ],
  "type": "object"
 },
 "title": "Voxtral speech-to-text"
}
