{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Side-by-side metric/param comparison across multiple runs. Renders an Apps SDK card on ChatGPT clients (Claude clients receive the same JSON text).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "metricKeys": {
    "description": "Restrict to specific metric keys",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "paramKeys": {
    "description": "Restrict to specific parameter keys",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "runIds": {
    "description": "Run IDs to compare (>= 2)",
    "items": {
     "type": "string"
    },
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "runIds"
  ],
  "type": "object"
 },
 "name": "compare-runs"
}
