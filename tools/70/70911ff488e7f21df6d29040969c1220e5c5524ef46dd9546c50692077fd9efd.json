  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this tool to retrieve current booking preparation rules: account requirement, guest booking and minimum lead time. Reads the tenant policy and configured lead-time authority; observedAt records the read time, not a terms-validity guarantee. Review the offer's bound waiting and cancellation terms before confirmation. Use get_service_options for scope or quote_ride for a price; no offer or booking is created.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "locale": {
    "default": "en",
    "description": "Use the customer's requested language for text and booking links: en by default, de for German. Preserve it on retries; pickup times stay in the provider time zone.",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_customer_policy",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "status": {
      "const": "invalid_request",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "status": {
      "const": "unavailable",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingConfirmed": {
      "const": false,
      "type": "boolean"
     },
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "observedAt": {
      "type": "string"
     },
     "revalidationRequired": {
      "const": true,
      "type": "boolean"
     },
     "scope": {
      "const": "booking_preparation",
      "type": "string"
     },
     "status": {
      "const": "available",
      "type": "string"
     },
     "terms": {
      "additionalProperties": false,
      "properties": {
       "accountRequired": {
        "type": "boolean"
       },
       "bookerForGuestAllowed": {
        "type": "boolean"
       },
       "bookingConfirmation": {
        "const": "after_confirmed_full_payment",
        "type": "string"
       },
       "minimumLeadTimeMinutes": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "serviceSpecificTerms": {
        "const": "review_the_current_offer_before_confirmation",
        "type": "string"
       }
      },
      "required": [
       "minimumLeadTimeMinutes",
       "accountRequired",
       "bookerForGuestAllowed",
       "bookingConfirmation",
       "serviceSpecificTerms"
      ],
      "type": "object"
     },
     "timeZone": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "bookingUrl",
     "timeZone",
     "observedAt",
     "scope",
     "revalidationRequired",
     "terms",
     "bookingConfirmed"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Published customer terms"
}
