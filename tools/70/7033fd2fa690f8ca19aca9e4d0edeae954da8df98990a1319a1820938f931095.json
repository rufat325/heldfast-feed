{
 "description": "[skiplagged] Find lower-priced destinations from a departure city when the user is flexible about where to go.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adults": {
    "default": 1,
    "description": "Number of adult passengers",
    "maximum": 9,
    "minimum": 1,
    "type": "integer"
   },
   "children": {
    "default": 0,
    "description": "Number of child passengers",
    "maximum": 8,
    "minimum": 0,
    "type": "integer"
   },
   "depart": {
    "description": "Departure date in YYYY-MM-DD format",
    "type": "string"
   },
   "fare_class": {
    "default": "economy",
    "description": "Fare class preference",
    "enum": [
     "basic-economy",
     "economy",
     "premium",
     "business",
     "first"
    ],
    "type": "string"
   },
   "from": {
    "description": "Departure IATA code or city name",
    "type": "string"
   },
   "infantsLap": {
    "default": 0,
    "description": "Number of lap infants",
    "maximum": 4,
    "minimum": 0,
    "type": "integer"
   },
   "infantsSeat": {
    "default": 0,
    "description": "Number of seat infants",
    "maximum": 4,
    "minimum": 0,
    "type": "integer"
   },
   "return": {
    "$ref": "#/properties/depart",
    "description": "Return date in YYYY-MM-DD format (optional for one-way trips)"
   }
  },
  "required": [
   "from",
   "depart"
  ],
  "type": "object"
 },
 "name": "skiplagged_sk_destinations_anywhere"
}
