{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read bounded existing provider-reported engagement in the selected workspace, sorted by views. Returns source title, caption, published date and views/likes/comments/shares/saves. Does not import new data, start monitoring or infer attributable leads, sales or revenue.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "platform": {
    "default": "all",
    "enum": [
     "all",
     "youtube",
     "instagram",
     "facebook",
     "tiktok"
    ],
    "type": "string"
   },
   "range": {
    "default": "30d",
    "enum": [
     "7d",
     "30d",
     "90d",
     "all"
    ],
    "type": "string"
   },
   "search": {
    "default": "",
    "maxLength": 200,
    "type": "string"
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "workspaceId",
   "platform",
   "range",
   "limit",
   "offset",
   "search"
  ],
  "type": "object"
 },
 "name": "content_performance_list",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Read Published Content Performance"
}
