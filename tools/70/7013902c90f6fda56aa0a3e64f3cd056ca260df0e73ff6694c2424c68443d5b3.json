{
 "description": "Bind an on-call schedule to a team or component. Requires `write` scope. scheduleId is required unless provider is 'manual'.",
 "inputSchema": {
  "properties": {
   "label": {
    "description": "Optional display label",
    "type": "string"
   },
   "provider": {
    "description": "On-call provider",
    "enum": [
     "pagerduty",
     "opsgenie",
     "manual"
    ],
    "type": "string"
   },
   "scheduleId": {
    "description": "Provider schedule id (required unless provider='manual')",
    "type": "string"
   },
   "scope": {
    "description": "What the binding attaches to",
    "enum": [
     "team",
     "component"
    ],
    "type": "string"
   },
   "targetId": {
    "description": "Team id (scope=team) or project id (scope=component) (required)",
    "type": "string"
   }
  },
  "required": [
   "scope",
   "targetId",
   "provider"
  ],
  "type": "object"
 },
 "name": "create_oncall_binding"
}
