{
 "description": "List users via admin API. Requires admin API key. Returns ~100 users per page (Discourse's fixed page size). Returns JSON with users array and pagination meta.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asc": {
    "default": false,
    "description": "Sort ascending (default: false/descending)",
    "type": "boolean"
   },
   "filter": {
    "description": "Search by username, email, or IP address",
    "type": "string"
   },
   "order": {
    "description": "Sort order field",
    "enum": [
     "created",
     "last_emailed",
     "seen",
     "username",
     "trust_level",
     "days_visited",
     "posts"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (0-indexed)",
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "default": "active",
    "description": "User query type",
    "enum": [
     "active",
     "new",
     "staff",
     "suspended",
     "silenced",
     "pending",
     "staged"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "discourse_list_users",
 "title": "List Users"
}
