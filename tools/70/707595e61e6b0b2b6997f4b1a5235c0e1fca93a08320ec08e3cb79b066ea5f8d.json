{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List messages sent by this address (including unsent drafts, shown with time null), newest first, with per-recipient delivery state. Use delivery_status for one message's detail.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "include_reactions": {
    "default": false,
    "description": "also list reaction messages (normally hidden)",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "page size (host maximum 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "number of newest messages to skip",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_sent",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "count": {
    "type": "number"
   },
   "messages": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "added": {
       "description": "recipients added later via add-to",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "attachments": {
       "description": "sorted by filename, the same order in every tool",
       "items": {
        "additionalProperties": {},
        "properties": {
         "filename": {
          "type": "string"
         },
         "size": {
          "type": "number"
         },
         "type": {
          "description": "media type; inferred from the filename when the host records none",
          "type": "string"
         }
        },
        "required": [
         "filename",
         "size"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "compressed": {
       "description": "true when the body was sent deflate-compressed on the wire (see size)",
       "type": "boolean"
      },
      "delivery": {
       "items": {
        "additionalProperties": {},
        "properties": {
         "addr": {
          "type": "string"
         },
         "code": {
          "description": "the receiving host's fmsg response code for the last attempt when recorded: 200 means accepted, other codes are rejections; null when not recorded, including some successful deliveries",
          "type": [
           "number",
           "null"
          ]
         },
         "code_meaning": {
          "description": "the code's name in the fmsg specification, when known",
          "type": [
           "string",
           "null"
          ]
         },
         "status": {
          "description": "one of \"delivered\", \"pending\", \"failed\"; delivered once the receiving host accepted it; failed when the last attempt was rejected (the host may retry temporary failures); otherwise pending. More values may be added",
          "type": "string"
         },
         "time": {
          "description": "when delivery was confirmed",
          "type": [
           "string",
           "null"
          ]
         },
         "via": {
          "description": "one of \"to\", \"add_to\"; how the recipient was addressed: to for the original recipients, add_to for recipients added later with the fmsg add-to mechanism (add_recipients). More values may be added",
          "type": "string"
         }
        },
        "required": [
         "addr",
         "status",
         "time",
         "code",
         "via"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "from": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "important": {
       "type": "boolean"
      },
      "no_reply": {
       "type": "boolean"
      },
      "pid": {
       "type": [
        "string",
        "null"
       ]
      },
      "preview": {
       "description": "start of the body; may be shorter than the full body",
       "type": "string"
      },
      "reaction": {
       "description": "the emoji when this message is itself a reaction (\"\" clears one); null otherwise",
       "type": [
        "string",
        "null"
       ]
      },
      "reactions": {
       "items": {
        "additionalProperties": {},
        "properties": {
         "emoji": {
          "type": "string"
         },
         "from": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "emoji",
         "from"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "read": {
       "description": "null when not applicable (your own sent messages)",
       "type": [
        "boolean",
        "null"
       ]
      },
      "size": {
       "description": "body size in bytes as stored by your host: for a message you received with compressed true, the compressed wire length; your own sent messages store the uncompressed length. body_bytes, where given, is the decoded length",
       "type": "number"
      },
      "terminal": {
       "type": "boolean"
      },
      "time": {
       "description": "ISO-8601; null for drafts",
       "type": [
        "string",
        "null"
       ]
      },
      "time_posix": {
       "type": [
        "number",
        "null"
       ]
      },
      "to": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "topic": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "pid",
      "from",
      "to",
      "added",
      "topic",
      "time",
      "time_posix",
      "read",
      "important",
      "no_reply",
      "terminal",
      "type",
      "size",
      "preview",
      "attachments",
      "reactions",
      "delivery"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_offset": {
    "type": [
     "number",
     "null"
    ]
   },
   "offset": {
    "type": "number"
   },
   "untrusted_content_notice": {
    "type": "string"
   }
  },
  "required": [
   "messages",
   "count",
   "offset",
   "next_offset"
  ],
  "type": "object"
 },
 "title": "List sent messages"
}
