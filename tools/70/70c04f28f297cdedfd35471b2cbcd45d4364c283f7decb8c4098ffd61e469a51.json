  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Family day"
 },
 "description": "Use this when the user wants family-suitable options for a day in one city. Returns a flat ranked list of experiences (search rows) with family-tagged rows promoted and out-of-season products dropped, not a structured morning/lunch/afternoon/evening plan. `date` selects which season counts as current; `kids_ages` and `budget` are accepted but NOT yet applied, so compose the day yourself and verify age suitability per pick via get_experience_details.",
 "inputSchema": {
  "properties": {
   "budget": {
    "description": "Optional max budget in the listed currency.",
    "minimum": 0,
    "type": "number"
   },
   "city": {
    "description": "City slug.",
    "type": "string"
   },
   "date": {
    "description": "Optional ISO date (YYYY-MM-DD).",
    "type": "string"
   },
   "format": {
    "default": "json",
    "description": "Response shape. 'json' returns structured records; 'text' returns the same content rendered as a short narrative paragraph for chat surfaces.",
    "enum": [
     "json",
     "text"
    ],
    "type": "string"
   },
   "kids_ages": {
    "description": "Children's ages. Drives age-suitability filtering on each slot.",
    "items": {
     "maximum": 17,
     "minimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "language": {
    "description": "BCP-47 language code for human-readable fields (e.g., 'en', 'fr-FR'). Defaults to English when omitted.",
    "type": "string"
   }
  },
  "required": [
   "city"
  ],
  "type": "object"
 },
