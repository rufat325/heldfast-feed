{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search examples"
 },
 "description": "Find canonical .bpc examples by topic keywords and/or chart type. Returns ranked pointers { id, title, description, chartType } \u2014 call get_example with an id to fetch the full DSL.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "chartType": {
    "description": "Restrict results to this chart type (or alias).",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of results to return (max 20).",
    "exclusiveMinimum": 0,
    "maximum": 20,
    "type": "integer"
   },
   "query": {
    "description": "Topic keywords to match against sample titles and descriptions.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_examples",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "results": {
    "description": "Ranked sample pointers, best first.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "chartType": {
       "description": "Chart type of the sample.",
       "type": "string"
      },
      "description": {
       "description": "Sample description.",
       "type": "string"
      },
      "id": {
       "description": "Sample id (pass to get_example).",
       "type": "string"
      },
      "score": {
       "description": "Match score used for ordering.",
       "type": "number"
      },
      "title": {
       "description": "Sample title.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "description",
      "chartType",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 }
}
