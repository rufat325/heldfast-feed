{
 "description": "Get history of all activities performed by a specific user in the current workspace",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "boardIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "createdBy": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dateRangeEnd": {
    "type": "string"
   },
   "dateRangeStart": {
    "type": "string"
   },
   "entityTypes": {
    "items": {
     "enum": [
      "task",
      "project",
      "board",
      "document",
      "milestone"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "excludeKeys": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "keys": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "memberId": {
    "minLength": 1,
    "type": "string"
   },
   "projectIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "taskIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "memberId"
  ],
  "type": "object"
 },
 "name": "get_user_history"
}
