{
 "_meta": {
  "agents-x402/paymentRequired": true,
  "agents-x402/priceUSD": 0.05
 },
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Prospecting list: one page of 100 ACTIVE Brazilian establishments matching a filter (CNAE code or prefix, state/UF, city, opening date range, headquarters only), with CNPJ, legal and trade name, city/state, main activity and opening date. Stable paging by CNPJ; total and next_page included. Source: Receita Federal monthly registry; MEI owners' CPFs masked. Signed answer (Ed25519 attestation), verifiable at /v1/verify.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "city": {
    "description": "Municipality name (accents and case ignored).",
    "maxLength": 80,
    "type": "string"
   },
   "cnae": {
    "description": "CNAE code or prefix: '6201-5/00', '6201500', '6201' (class) or '62' (division).",
    "maxLength": 12,
    "type": "string"
   },
   "hq_only": {
    "description": "Only headquarters (one row per company).",
    "type": "boolean"
   },
   "opened_after": {
    "description": "Opened on or after (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "opened_before": {
    "description": "Opened on or before (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "page": {
    "description": "Page of 100, default 1.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "description": "UF, e.g. 'SP'.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "br_company_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attestation": {
    "additionalProperties": false,
    "description": "Ed25519 signature of this answer; verify at verify_url or with the public key at /.well-known/kyb-attestation.json.",
    "properties": {
     "algorithm": {
      "type": "string"
     },
     "key_id": {
      "type": "string"
     },
     "sha256": {
      "type": "string"
     },
     "signature": {
      "type": "string"
     },
     "signed_at": {
      "type": "string"
     },
     "verify_url": {
      "type": "string"
     }
    },
    "required": [
     "algorithm",
     "key_id",
     "sha256",
     "signed_at",
     "signature",
     "verify_url"
    ],
    "type": "object"
   },
   "cached": {
    "type": "boolean"
   },
   "data_freshness": {
    "type": "string"
   },
   "filters": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "generated_at": {
    "type": "string"
   },
   "next_page": {
    "type": [
     "number",
     "null"
    ]
   },
   "page": {
    "type": "number"
   },
   "page_size": {
    "type": "number"
   },
   "receipt": {
    "additionalProperties": false,
    "description": "Re-read this answer free for 10 minutes with br_replay.",
    "properties": {
     "replay_token": {
      "type": "string"
     },
     "replay_until": {
      "type": "string"
     }
    },
    "required": [
     "replay_token",
     "replay_until"
    ],
    "type": "object"
   },
   "reference_month": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "city": {
       "type": [
        "string",
        "null"
       ]
      },
      "cnpj": {
       "type": "string"
      },
      "cnpj_formatted": {
       "type": "string"
      },
