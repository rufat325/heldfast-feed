       "type": "boolean"
      },
      "legal_name": {
       "type": "string"
      },
      "registration_status": {
       "type": "string"
      },
      "state": {
       "type": [
        "string",
        "null"
       ]
      },
      "trade_name": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "cnpj",
      "cnpj_formatted",
      "legal_name",
      "trade_name",
      "registration_status",
      "is_headquarters",
      "city",
      "state"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sources": {
