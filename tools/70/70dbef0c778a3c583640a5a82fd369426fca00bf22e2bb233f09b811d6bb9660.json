{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":true},"description":"Read one bounded page from /api/index/v1/verity/catalog. Discover crypto symbols and their current coverage status and measured cadence. Catalog rows, prices and metadata are unsigned: use get_index_price or get_index_batch for signed receipts. Availability changes; total is a catalog count, not a count of fresh prices. No automatic pagination. Needs a developer key (PULSE_API_KEY) or the hosted server.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"band":{"description":"Only assets in this measured update cadence band","enum":["real-time","five-second","ten-second","slow","unavailable"],"type":"string"},"limit":{"default":50,"description":"Rows per page, 1 to 100; 50 when omitted. A plan may return fewer: use count and offset.","maximum":100,"minimum":1,"type":"integer"},"offset":{"default":0,"description":"Rows to skip before this page, for paging; 0 when omitted","maximum":100000,"minimum":0,"type":"integer"},"status":{"description":"Only assets with this coverage status","enum":["consensus","blended","indicative","insufficient-coverage","venue-disagreement","unconvertible-quote","stale","kernel-rejected"],"type":"string"}},"type":"object"},"name":"list_index_assets","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"bands":{"items":{"enum":["real-time","five-second","ten-second","slow","unavailable"],"type":"string"},"maxItems":5,"type":"array"},"count":{"maximum":100,"minimum":0,"type":"integer"},"engine":{"maxLength":64,"type":"string"},"error":{"additionalProperties":false,"properties":{"accountUrl":{"const":"https://thepulse.markets/developers/access","type":"string"},"batchLimit":{"maximum":100000,"minimum":1,"type":"integer"},"capacityAction":{"enum":["review_plans","contact_support"],"type":"string"},"c