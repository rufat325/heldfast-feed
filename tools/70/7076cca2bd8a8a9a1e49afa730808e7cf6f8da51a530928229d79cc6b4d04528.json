{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Search persons with their emails and phones. Returns only people with an email or phone, with full contact data, and charges 1 credit per returned person. Page with nextOffset. limit 0 returns only totalCount, free. saveToContacts also stores them in your contacts, where people you already had are refunded.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "decisionMakersOnly": {
    "description": "C-level, VP or director seniority, or a founder, owner, CEO, managing director or president title",
    "type": "boolean"
   },
   "domains": {
    "description": "Look companies up by domain, e.g. [\"stripe.com\"]",
    "items": {
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "employeeBands": {
    "description": "Headcount bands",
    "items": {
     "enum": [
      "1-10",
      "11-50",
      "51-200",
      "201-500",
      "501-1,000",
      "1,001-5,000",
      "5,001-10,000",
      "10,001+"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "employeeGrowthMin": {
    "description": "Minimum employee growth on LinkedIn in percent, e.g. 10; known for about 1 in 13 US companies",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "foundedAfter": {
    "description": "Earliest founding year to include",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "foundedBefore": {
    "description": "Latest founding year to include",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "fundedAfter": {
    "description": "Year of the last funding round, at least; known for about 1 in 100 US companies",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "hqCountry": {
    "description": "ISO alpha-2 country codes of the headquarters, e.g. [\"US\", \"DE\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "hqState": {
    "description": "US state names or codes of the headquarters",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "inCountry": {
    "description": "ISO alpha-2 country codes where the person is based",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "industryNaicsDirect": {
    "description": "NAICS codes",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "jobLevel": {
    "description": "Allowed job seniority levels",
    "items": {
     "enum": [
      "C-Team",
      "VP",
      "Director",
      "Manager",
      "Staff",
      "Other"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "jobTitle": {
    "description": "Matched as partial text, so \"CEO\" also finds \"Assistant to the CEO\"; combine with jobLevel to narrow",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "jobTitleExclude": {
    "description": "Job title phrases to exclude",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "default": 25,
    "description": "Maximum people to return; 0 returns only a free count",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "monthlyVisitsMin": {
    "description": "Minimum monthly website visits; known for about 1 in 8 US companies, the rest are excluded",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset; use nextOffset from the previous response",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "onePerOrganization": {
    "default": false,
    "description": "Return at most one person per company",
    "type": "boolean"
   },
   "organizationIds": {
    "description": "Limit to organizations from organizations_search",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "personCity": {
    "description": "Cities where the person is based",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "personState": {
    "description": "States where the person is based",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "query": {
    "description": "Free text matched against company name, description and keywords",
    "minLength": 1,
    "type": "string"
   },
   "revenueRange": {
    "description": "Annual company revenue bands",
    "items": {
     "enum": [
      "<$1M",
      "$1M to <$10M",
      "$10M to <$50M",
      "$50M to <$100M",
      "$100M to <$1B",
      "$1B+"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "saveToContacts": {
    "default": false,
    "description": "Save returned people to your Deeplead contacts",
    "type": "boolean"
   },
   "semantic": {
    "description": "What the company is and sells, matched by meaning, e.g. \"outsourced medical billing for clinics\"",
    "minLength": 1,
    "type": "string"
   },
   "technologies": {
    "description": "Technologies used by the company",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
