    "description": "Optional category slug.",
    "type": "string"
   },
   "format": {
    "default": "json",
    "description": "Response shape. 'json' returns structured records; 'text' returns the same content rendered as a short narrative paragraph for chat surfaces.",
    "enum": [
     "json",
     "text"
    ],
    "type": "string"
   },
   "language": {
    "description": "BCP-47 language code for human-readable fields (e.g., 'en', 'fr-FR'). Defaults to English when omitted.",
    "type": "string"
   },
   "latitude": {
    "description": "Latitude coordinate.",
    "type": "number"
   },
   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "longitude": {
    "description": "Longitude coordinate.",
    "type": "number"
   },
   "radius_km": {
    "default": 5,
    "description": "Search radius in kilometres.",
    "maximum": 50,
    "minimum": 0.1,
    "type": "number"
   }
  },
  "required": [
   "latitude",
   "longitude"
  ],
  "type": "object"
 },
