{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"DIRECTOR MODE \u2014 one call from raw footage to a finished edit. Analyzes if needed, removes black/dead stretches, picks the strongest moments (or keeps nearly everything with keep:\"most\"), tries 3 opening hooks and keeps the best, adds transitions, beat-syncs to music, makes captions from a transcript, auto-fixes review issues, reframes for vertical, and optionally renders all platform formats. Asynchronous: poll studio_get; project.autoEdit holds the report. Every step is a normal revision (undo with studio_restore).","inputSchema":{"additionalProperties":false,"properties":{"author":{"maxLength":40,"type":"string"},"beatSync":{"type":"boolean"},"brand":{"maxLength":40,"type":"string"},"brief":{"maxLength":2000,"type":"string"},"cta":{"maxLength":100,"type":"string"},"duration":{"maximum":1200,"minimum":5,"type":"number"},"formats":{"items":{"enum":["hd","landscape","qhd","uhd","ultrawide","vertical720","vertical","vertical1440","vertical4k","square720","square","square1440","portrait720","portrait","portrait1440","whatsapp"],"type":"string"},"maxItems":12,"minItems":1,"type":"array"},"hook":{"type":"boolean"},"hookText":{"maxLength":120,"type":"string"},"keep":{"enum":["highlights","story","most"],"type":"string"},"label":{"maxLength":70,"type":"string"},"music":{"maxLength":1000,"type":"string"},"pace":{"enum":["calm","balanced","punchy"],"type":"string"},"platform":{"enum":["shorts","tiktok","reels","feed","youtube","trailer","vlog","film"],"type":"string"},"preview":{"type":"boolean"},"projectId":{"pattern":"^[0-9a-f-]{36}$","type":"string"},"queue":{"type":"boolean"},"reframe":{"anyOf":[{"enum":["9:16","1:1","4:5"],"type":"string"},{"enum":[false],"type":"boolean"}]},"render":{"type":"boolean"},"revision":{"minimum":1,"type":"integer"},"title":{"maxLength":100,"type":"string"},"transitions":{"type":"boolean"},"variants":{"type":"boolea