{
 "description": "Compute one Dubai cost from published rates. kind=taxi_minimum (RTA minimum fare), salik_monthly (toll cost for a commute), fuel_tank (cost to fill a tank), fuel_per_km (fuel cost for a distance). Deterministic arithmetic only - no AI, and unpublished values are returned as not_published rather than guessed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "crossings_per_day": {
    "description": "salik_monthly: charged crossings per day",
    "type": "number"
   },
   "days_per_month": {
    "description": "salik_monthly: days per month (default 30)",
    "type": "number"
   },
   "fuel": {
    "enum": [
     "super_98",
     "special_95",
     "e_plus_91",
     "diesel"
    ],
    "type": "string"
   },
   "fuel_l_per_100km": {
    "description": "fuel_per_km: consumption",
    "type": "number"
   },
   "gates_per_crossing": {
    "description": "salik_monthly: gates passed per crossing (default 2)",
    "type": "number"
   },
   "kind": {
    "enum": [
     "taxi_minimum",
     "salik_monthly",
     "fuel_tank",
     "fuel_per_km"
    ],
    "type": "string"
   },
   "km": {
    "description": "fuel_per_km: distance",
    "type": "number"
   },
   "mode": {
    "description": "taxi_minimum: road pickup or e-hail",
    "enum": [
     "road",
     "ehail"
    ],
    "type": "string"
   },
   "tank_litres": {
    "description": "fuel_tank: tank size in litres",
    "type": "number"
   },
   "window": {
    "description": "salik_monthly: time window",
    "enum": [
     "peak",
     "offpeak",
     "sunday"
    ],
    "type": "string"
   }
  },
  "required": [
   "kind"
  ],
  "type": "object"
 },
 "name": "compute_cost"
}
