{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get an article"
 },
 "description": "One article: its opening paragraphs, or with detail \"full\" its whole text with every list of places.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "detail": {
    "default": "concise",
    "description": "\"concise\" (the default): the start of the answer and a count, to save context; \"full\": all of it.",
    "enum": [
     "concise",
     "full"
    ],
    "type": "string"
   },
   "slug": {
    "description": "The article's slug, the last part of its URL.",
    "maxLength": 120,
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_article",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "author": {
    "type": "string"
   },
   "category": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "photo": {
    "format": "uri",
    "type": "string"
   },
   "published": {
    "type": "string"
   },
   "standfirst": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "title",
   "url",
   "standfirst",
   "author",
   "category",
   "published",
   "photo",
   "text",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Get an article"
}
