{
 "description": "[OPERATOR] Assign an agent to a role in a task. Creates a delegation automatically.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent_id": {
    "description": "Agent ID",
    "type": "string"
   },
   "agent_public_key": {
    "description": "Agent's Ed25519 public key",
    "type": "string"
   },
   "role": {
    "description": "Role to assign",
    "type": "string"
   },
   "scope": {
    "description": "Delegation scopes",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "spend_limit": {
    "default": 500,
    "description": "Max spend",
    "type": "number"
   },
   "task_id": {
    "description": "Task ID",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "role",
   "agent_id",
   "agent_public_key",
   "scope"
  ],
  "type": "object"
 },
 "name": "assign_agent"
}
