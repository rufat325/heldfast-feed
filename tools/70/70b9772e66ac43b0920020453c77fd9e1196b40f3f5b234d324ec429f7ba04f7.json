     "properties": {
      "ad_ids": {
       "description": "Up to 5 ad ids as evidence",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "ads": {
       "description": "Distinct creatives using the angle",
       "type": "integer"
      },
