 "description": "Use this when the user wants to know which persuasion angles a set of ads uses and which are missing, such as \"which angles are these competitor ads missing?\". Pass the ads the user already has (id, text, and optionally advertiser). Optional descriptions of images or videos are read with the text. Returns the angles ranked with counts, advertisers and example ad ids, and a list of gaps: angles no ad uses (unclaimed) or only one advertiser uses (thin), each with evidence. Identical copy from one advertiser counts once. It does not fetch ads from any ad library. Angles come from keyword matching, so gaps are leads to check, not proof that an angle works.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "ads": {
    "description": "Ads you already have: objects with id, text and optionally advertiser. At most 300. This tool does not fetch ads from any ad library.",
    "items": {
     "properties": {
      "advertiser": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 300,
    "minItems": 1,
    "type": "array"
   },
   "descriptions": {
    "description": "Written descriptions of the ads' images or videos, as objects with the ad id and description. They are read together with the ad text. They come from a separate offline step.",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "description"
     ],
     "type": "object"
    },
    "maxItems": 300,
    "type": "array"
   }
  },
  "required": [
   "ads"
  ],
  "type": "object"
 },
 "name": "map_ad_angles",
 "outputSchema": {
  "properties": {
   "ads_analyzed": {
    "type": "integer"
   },
   "advertisers": {
    "type": "integer"
   },
   "angles": {
