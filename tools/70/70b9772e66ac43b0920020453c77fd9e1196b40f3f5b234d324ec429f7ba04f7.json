       "type": "integer"
      },
      "angle": {
       "type": "string"
      },
      "example": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "share": {
       "description": "Share of distinct creatives, 0 to 1",
       "type": "number"
      },
      "top_terms": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "angle",
      "label",
      "ads",
      "advertisers",
      "share",
      "ad_ids"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "as_of": {
    "type": "string"
   },
   "distinct_creatives": {
    "type": "integer"
   },
   "duplicates_collapsed": {
    "type": "integer"
   },
   "gaps": {
    "items": {
     "properties": {
      "ad_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "ads": {
       "type": "integer"
      },
      "advertisers": {
       "type": "integer"
