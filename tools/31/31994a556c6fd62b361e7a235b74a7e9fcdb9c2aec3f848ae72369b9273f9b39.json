{"_meta":{"securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Returns the legal frame of a raffle in one country: the coverage level of our content (structured, indication or not_covered), the regimes that apply with who may organise, the kind of authority, the lead time and the documents, a one-sentence legal basis, and the official sources with the date they were checked. A country without content returns not_covered. Every answer carries a notice that it is a general indication, not legal advice.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"country":{"description":"ISO 3166-1 alpha-2 country code, for example FR.","pattern":"^[A-Za-z]{2}$","type":"string"},"language":{"description":"Language of the notice.","enum":["fr","en"],"type":"string"}},"required":["country"],"type":"object"},"name":"get_legal_frame","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"basis_sentence":{"anyOf":[{"maxLength":1000,"minLength":1,"type":"string"},{"type":"null"}]},"country":{"pattern":"^[A-Z]{2}$","type":"string"},"coverage":{"enum":["structured","indication","not_covered"],"type":"string"},"notice":{"type":"string"},"regimes":{"items":{"additionalProperties":false,"properties":{"authority_kind":{"anyOf":[{"maxLength":200,"minLength":1,"type":"string"},{"type":"null"}]},"code":{"enum":["municipal_order","rup_declaration","sworn_statement","commercial_lottery","foreign_authority","none_required_declared"],"type":"string"},"label":{"maxLength":200,"minLength":1,"type":"string"},"lead_time_days":{"anyOf":[{"maximum":365,"minimum":0,"type":"integer"},{"type":"null"}]},"pieces":{"items":{"maxLength":200,"minLength":1,"type":"string"},"maxItems":30,"type":"array"},"who_can_organise":{"maxLength":500,"minLength":1,"type":"string"}},"required":["c