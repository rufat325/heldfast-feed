{
 "description": "Promote a release from one track to another (e.g. beta \u2192 production)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "editId": {
    "description": "Edit ID",
    "type": "string"
   },
   "fromTrack": {
    "description": "Source track",
    "enum": [
     "internal",
     "alpha",
     "beta"
    ],
    "type": "string"
   },
   "packageName": {
    "description": "Android package name",
    "type": "string"
   },
   "releaseNotes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "language": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "language",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "toTrack": {
    "description": "Target track",
    "enum": [
     "alpha",
     "beta",
     "production"
    ],
    "type": "string"
   },
   "userFraction": {
    "description": "Staged rollout fraction for production",
    "type": "number"
   }
  },
  "required": [
   "packageName",
   "editId",
   "fromTrack",
   "toTrack"
  ],
  "type": "object"
 },
 "name": "google_promote_release"
}
