{
 "_meta": {
  "openai/outputTemplate": "ui://widget/generation.html",
  "openai/toolInvocation/invoked": "Rancangan booth",
  "openai/toolInvocation/invoking": "Membaca rancangan\u2026",
  "ui.resourceUri": "ui://widget/generation.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read a booth draft by its draftId \u2014 the same summary check_generation gives for a finished design, plus everything the draft has been given since (settings, chosen frames, filters, AI effect). Use it when the job from start_booth is no longer tracked, to show the draft again before create_booth, or to confirm what update_booth_draft applied. Reads only; nothing is generated or created. A draft lives 7 days on the operator's account.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "draftId": {
    "description": "The draft, from check_generation or a previous tool result.",
    "pattern": "^dft_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "required": [
   "draftId"
  ],
  "type": "object"
 },
 "name": "get_booth_draft",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "draft": {
    "additionalProperties": false,
    "properties": {
     "aiEffectId": {
      "type": "string"
     },
     "appBackgroundUrl": {
      "type": "string"
     },
     "captureMode": {
      "type": "string"
     },
     "cta": {
      "type": "string"
     },
     "draftId": {
      "type": "string"
     },
     "edited": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "filterIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "filterMood": {
      "type": "string"
     },
     "frameIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "frameTags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "headline": {
      "type": "string"
     },
     "language": {
      "type": "string"
     },
     "logoUrl": {
      "type": "string"
     },
     "palette": {
      "additionalProperties": false,
      "properties": {
       "backgroundColor": {
        "type": "string"
       },
       "dark": {
        "type": "boolean"
       },
       "primaryColor": {
        "type": "string"
       },
       "secondaryColor": {
        "type": "string"
       }
      },
      "required": [
       "backgroundColor",
       "primaryColor",
       "secondaryColor",
       "dark"
      ],
      "type": "object"
     },
     "regenerated": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "remainingFullGenerations": {
      "type": "number"
     },
     "remainingRegens": {
      "type": "number"
     },
     "settings": {
      "additionalProperties": {
       "additionalProperties": {
        "type": [
         "boolean",
         "number",
         "null"
        ]
       },
       "type": "object"
      },
      "type": "object"
     },
     "slug": {
      "type": "string"
     },
     "subtext": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "welcomeLandscapeUrl": {
      "type": "string"
     },
     "welcomePortraitUrl": {
      "type": "string"
     }
    },
    "required": [
     "draftId",
     "slug",
     "title",
     "headline",
     "subtext",
     "cta",
     "captureMode",
     "language",
     "palette",
     "welcomePortraitUrl",
     "welcomeLandscapeUrl",
     "appBackgroundUrl",
     "frameTags",
     "filterMood",
     "remainingFullGenerations",
     "remainingRegens"
    ],
    "type": "object"
   },
   "draftId": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "jobId": {
    "type": "string"
   },
   "kind": {
    "const": "booth-draft",
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "state": {
    "type": "string"
   },
   "what": {
    "type": "string"
   }
  },
  "required": [
   "kind",
   "jobId",
   "state",
   "what",
   "draftId"
  ],
  "type": "object"
 },
 "title": "Read a booth draft"
}
