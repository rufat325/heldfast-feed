{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Restart a catalog or custom deployment's Docker Compose stack while preserving its data volumes. The lifecycle status may briefly show installing. Poll impreza_list_deployments for the actual outcome and reported runtime health; a restart request is not proof of readiness.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   }
  },
  "required": [
   "deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_restart_deployment",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "command_id": {
      "type": "string"
     },
     "deployment": {
      "type": "object"
     }
    },
    "required": [
     "command_id",
     "deployment"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Restart app"
}
