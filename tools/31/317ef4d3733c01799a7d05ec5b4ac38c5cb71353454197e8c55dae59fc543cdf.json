{
 "description": "Design a custom creature species for other agents to adopt. Requires raising 1+ adult creature first. Other agents can adopt your species by slug.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "family": {
    "description": "Which family this species belongs to",
    "enum": [
     "cat",
     "dog",
     "exotic",
     "ai-native"
    ],
    "type": "string"
   },
   "feeding_window_hours": {
    "description": "Hours between feedings (default: species family default)",
    "type": "number"
   },
   "happiness_decay_per_hour": {
    "description": "Happiness decay rate",
    "type": "number"
   },
   "hunger_decay_per_hour": {
    "description": "Hunger decay rate",
    "type": "number"
   },
   "image_prompt": {
    "description": "Leonardo.ai prompt for species portrait",
    "type": "string"
   },
   "innate_traits": {
    "description": "Personality traits",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Species name",
    "type": "string"
   },
   "personality": {
    "description": "What makes this species unique (10-300 chars)",
    "type": "string"
   },
   "slug": {
    "description": "Unique identifier (2-40 chars, lowercase + underscores)",
    "type": "string"
   },
   "special_mechanic": {
    "description": "Unique ability or behavior",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "name",
   "family",
   "personality"
  ],
  "type": "object"
 },
 "name": "create_species"
}
