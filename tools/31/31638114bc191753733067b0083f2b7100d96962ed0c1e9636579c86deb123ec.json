{
 "description": "List all calendars in the CRM. Optionally filter by group or include drafts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "groupId": {
    "description": "Filter calendars by group ID",
    "type": "string"
   },
   "locationId": {
    "description": "CRM location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "showDrafts": {
    "description": "Include draft calendars in results",
    "type": "boolean"
   }
  },
  "required": [
   "access_token",
   "locationId"
  ],
  "type": "object"
 },
 "name": "crm_list_calendars"
}
