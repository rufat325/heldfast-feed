     "created_at",
     "due_by",
     "updated_at",
     "status"
    ],
    "type": "string"
   },
   "order_type": {
    "description": "Sort direction: asc or desc.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number for pagination (1-based).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
