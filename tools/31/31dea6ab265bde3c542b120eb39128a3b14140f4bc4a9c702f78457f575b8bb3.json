    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "email": {
    "description": "Filter by requester email.",
    "type": "string"
   },
   "filter": {
    "description": "Predefined filter: new_and_my_open, watching, spam, or deleted.",
