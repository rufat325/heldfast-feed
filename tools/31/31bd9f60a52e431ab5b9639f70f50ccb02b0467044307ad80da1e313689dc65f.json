{"description":"Create portable Insight risk evidence for one exact unsigned direct Aave V3 Monad or Morpho Blue Monad supply/borrow call. It verifies target, selector, token or market binding, sender, nonce and zero value, then returns a short-lived EIP-712 decision when Insight signing is configured. It never authorizes, signs, or broadcasts the transaction; bind an ALLOW through PriorSeal or another user-authorization system.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"guard":{"additionalProperties":false,"properties":{"action":{"enum":["supply","borrow"],"type":"string"},"collateralSymbol":{"pattern":"^[A-Za-z][A-Za-z0-9.-]{0,15}$","type":"string"},"collateralValueUsd":{"exclusiveMinimum":0,"type":"number"},"debtValueUsd":{"minimum":0,"type":"number"},"loanSymbol":{"pattern":"^[A-Za-z][A-Za-z0-9.-]{0,15}$","type":"string"},"marketId":{"pattern":"^0x[a-fA-F0-9]{64}$","type":"string"},"protocolId":{"enum":["aave-v3-monad","morpho-blue-monad"],"type":"string"}},"required":["protocolId","action","collateralSymbol","loanSymbol","collateralValueUsd","debtValueUsd"],"type":"object"},"transaction":{"additionalProperties":false,"properties":{"chainId":{"const":143,"type":"number"},"data":{"pattern":"^0x(?:[a-fA-F0-9]{2})+$","type":"string"},"from":{"pattern":"^0x[a-fA-F0-9]{40}$","type":"string"},"nonce":{"anyOf":[{"pattern":"^0$|^[1-9][0-9]*$","type":"string"},{"maximum":9007199254740991,"minimum":0,"type":"integer"}]},"to":{"pattern":"^0x[a-fA-F0-9]{40}$","type":"string"},"value":{"anyOf":[{"pattern":"^0$|^[1-9][0-9]*$","type":"string"},{"maximum":9007199254740991,"minimum":0,"type":"integer"}]}},"required":["chainId","from","to","data","nonce"],"type":"object"}},"required":["guard","transaction"],"type":"object"},"name":"monad_lending_guard_exact_call"}
