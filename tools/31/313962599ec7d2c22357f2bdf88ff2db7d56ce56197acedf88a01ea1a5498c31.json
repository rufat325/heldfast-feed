{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get related authorities"
 },
 "description": "Use this when you need what a section or case is connected to: sections it cites or that cite it, defined terms it relies on, procedural steps before and after it, and cases that cite it or that it cites. Every connection carries the verbatim text that creates it. Do not use it to find topically similar law; it returns only these fixed connection types.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "authority": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    ],
    "description": "A section (\"4920\", \"Civ. Code \u00a7 4920\") or a case (name, citation like \"8 Cal.4th 361\", or id)."
   },
   "kinds": {
    "description": "Connection types to return (default all).",
    "items": {
     "enum": [
      "cites",
      "cited_by",
      "defines_term",
      "term_used_by",
      "precedes",
      "follows",
      "interpreted_by",
      "interprets",
      "discusses",
      "discussed_by"
     ],
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "limit": {
    "description": "Connections per type (default 10).",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "authority"
  ],
  "type": "object"
 },
 "name": "get_related_authorities",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "authority": {
    "additionalProperties": false,
    "properties": {
     "authority_id": {
      "type": "string"
     },
     "canonical_url": {
      "type": "string"
     },
     "cite": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "statute_section",
       "case"
      ],
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "authority_id",
     "kind",
     "cite",
     "title",
     "canonical_url"
    ],
    "type": "object"
   },
   "connections": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": [
        "string",
        "null"
       ]
      },
      "direction": {
       "enum": [
        "out",
        "in"
       ],
       "type": "string"
      },
      "kind": {
       "enum": [
        "cites",
        "cited_by",
        "defines_term",
        "term_used_by",
        "precedes",
        "follows",
        "interpreted_by",
        "interprets",
        "discusses",
        "discussed_by"
       ],
       "type": "string"
      },
      "receipt": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "in": {
           "type": "string"
          },
          "layer": {
           "const": "source",
           "type": "string"
          },
          "text": {
           "type": "string"
          }
         },
         "required": [
          "text",
          "in",
          "layer"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "target": {
       "additionalProperties": false,
       "properties": {
        "authority_id": {
         "type": "string"
        },
        "canonical_url": {
         "type": "string"
        },
        "cite": {
         "type": "string"
        },
        "kind": {
         "enum": [
          "statute_section",
          "case"
         ],
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "authority_id",
        "kind",
        "cite",
        "title",
        "canonical_url"
       ],
       "type": "object"
      },
      "why": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "layer": {
           "const": "davisstirling",
           "type": "string"
          },
          "method": {
           "enum": [
            "derived",
            "editorial.human",
            "editorial.machine-drafted",
            "editorial.machine-reviewed",
            "editorial.human-reviewed",
            "editorial.sourced"
           ],
           "type": "string"
          },
          "value": {
           "type": "string"
          }
         },
         "required": [
          "value",
          "layer",
          "method"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "kind",
      "target",
      "direction",
      "receipt",
      "why",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "corpus_version": {
      "description": "Version of the compiled corpus this response was built from.",
      "type": "string"
     },
     "coverage": {
      "description": "What the corpus covers and does not cover.",
      "type": "string"
     },
     "notice": {
      "type": "string"
     }
    },
    "required": [
     "corpus_version",
     "coverage",
     "notice"
    ],
    "type": "object"
   },
   "truncated": {
    "additionalProperties": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "propertyNames": {
     "enum": [
      "cites",
      "cited_by",
      "defines_term",
      "term_used_by",
      "precedes",
      "follows",
      "interpreted_by",
      "interprets",
      "discusses",
      "discussed_by"
     ],
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "authority",
   "connections",
   "truncated",
   "meta"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Get related authorities"
}
