{
 "_meta": {
  "openai/toolInvocation/invoked": "Tours searched",
  "openai/toolInvocation/invoking": "Searching tours\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search tours"
 },
 "description": "Lists and filters published tours by free text, destination, maximum from-price, departure date range and sort. Prices are \"from\" prices with their basis, not fixed prices. Returns an empty list with emptyReason when nothing matches. Tours only: no hotels, experiences or visas.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "city": {
    "description": "City: slug or name in Turkish or English.",
    "maxLength": 200,
    "type": "string"
   },
   "country": {
    "description": "Country: slug, name in Turkish or English, or ISO 3166-1 alpha-2 code (example: \"japonya\", \"Japan\", \"JP\").",
    "maxLength": 200,
    "type": "string"
   },
   "currency": {
    "description": "Price currency.",
    "enum": [
     "EUR",
     "USD",
     "AED"
    ],
    "type": "string"
   },
   "departureFrom": {
    "description": "Tours with a departure on or after this date (YYYY-MM-DD)",
    "format": "date",
    "maxLength": 10,
    "minLength": 10,
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "departureTo": {
    "description": "Tours with a departure on or before this date (YYYY-MM-DD)",
    "format": "date",
    "maxLength": 10,
    "minLength": 10,
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "language": {
    "description": "Catalogue language.",
    "enum": [
     "tr",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Default 10.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "maxPrice": {
    "description": "Maximum from-price in the unit of priceFrom.amount (minor units: 15000 for EUR 150) and in the chosen currency.",
    "maximum": 100000000,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Free text: country, city or tour name (example: \"Japan\").",
    "maxLength": 100,
    "type": "string"
   },
   "sort": {
    "description": "Default newest.",
    "enum": [
     "name",
     "newest",
     "price",
     "departure"
    ],
    "type": "string"
   }
  },
  "required": [
   "language",
   "currency"
  ],
  "type": "object"
 },
 "name": "search_tours",
 "outputSchema": {
  "properties": {
   "catalogueRefreshedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "deepLink": {
    "type": "string"
   },
   "disclaimer": {
    "type": "string"
   },
   "emptyReason": {
    "type": [
     "string",
     "null"
    ]
   },
   "generatedAt": {
    "type": "string"
   },
   "total": {
    "type": "integer"
   },
   "tours": {
    "items": {
     "properties": {
      "airline": {
       "type": [
        "string",
        "null"
       ]
      },
      "deepLink": {
       "type": "string"
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "nextDepartureOn": {
       "type": [
        "string",
        "null"
       ]
      },
      "nightCount": {
       "type": [
        "integer",
        "null"
       ]
      },
      "priceFrom": {
       "anyOf": [
        {
         "properties": {
          "amount": {
           "description": "Minor units.",
           "type": "integer"
          },
          "basis": {
           "type": "string"
          },
          "currency": {
           "enum": [
            "EUR",
            "USD",
            "AED"
           ],
           "type": "string"
          }
         },
         "required": [
          "amount",
          "currency",
          "basis"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "publishedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "slug": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "name",
      "deepLink"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tours",
   "total",
   "emptyReason",
   "deepLink"
  ],
  "type": "object"
 },
 "title": "Search tours"
}
