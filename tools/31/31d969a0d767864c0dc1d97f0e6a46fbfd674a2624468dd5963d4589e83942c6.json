 "description": "List shot history with support for pagination and filtering. Every shot carries a derived taste_pending flag (1 = logged with no sensory tags, no rating, and no tasted flip \u2014 the tasting is still owed and can be backfilled with update_shot).",
 "inputSchema": {
  "properties": {
   "filters": {
    "properties": {
     "bag_id": {
      "description": "Filter by bag number (one purchase of a coffee)",
      "type": "integer"
     },
     "bean_id": {
      "description": "Filter by coffee bean ID",
      "type": "integer"
     },
     "best": {
      "description": "Filter by best brew status",
      "enum": [
       0,
       1
      ],
      "type": "integer"
     },
     "date_from": {
      "description": "Filter shots pulled on or after YYYY-MM-DD",
      "type": "string"
     },
     "date_to": {
      "description": "Filter shots pulled on or before YYYY-MM-DD",
      "type": "string"
     },
     "favourite": {
      "description": "Filter by favourite status",
      "enum": [
       0,
       1
      ],
      "type": "integer"
     },
     "grinder_id": {
      "description": "Filter by grinder ID",
      "type": "integer"
     },
     "machine_id": {
      "description": "Filter by machine ID",
      "type": "integer"
     },
     "taste_pending": {
      "description": "1 = shots logged without sensory tags, a rating, or the tasted flip (tasting still owed); 0 = tasted shots",
      "enum": [
       0,
       1
      ],
      "type": "integer"
     }
    },
    "type": "object"
   },
   "limit": {
    "default": 50,
    "description": "Number of records to return (1-500)",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Offset for pagination",
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
