{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Creates a payment/invoice using POST /v3/payments. In a live environment this creates a real payable invoice. Omit paymentMethod to show all enabled methods; use notificationOption for invoicing. The returned PaymentURL is where the customer pays.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "advanced": {
    "additionalProperties": {},
    "description": "Additional documented v3 request fields. Explicit fields above take precedence.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "amount": {
    "description": "Payment amount; must be greater than zero.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "currency": {
    "description": "Display currency. Defaults to the account base currency.",
    "enum": [
     "SAR",
     "BHD",
     "AED",
     "QAR",
     "OMR",
     "KWD",
     "JOD",
     "EGP"
    ],
    "type": "string"
   },
   "customer": {
    "properties": {
     "civilId": {
      "maxLength": 100,
      "type": "string"
     },
     "email": {
      "description": "Required for EMAIL or ALL notifications.",
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "mobileCountryCode": {
      "description": "For example +965.",
      "maxLength": 6,
      "minLength": 1,
      "type": "string"
     },
     "mobileNumber": {
      "maxLength": 14,
      "minLength": 6,
      "type": "string"
     },
     "name": {
      "description": "Customer name.",
      "minLength": 1,
      "type": "string"
     },
     "reference": {
      "description": "Order ID in your own system.",
      "maxLength": 200,
      "type": "string"
     }
    },
    "type": "object"
   },
   "displayPaymentMethods": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "externalIdentifier": {
    "maxLength": 200,
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "enum": [
     "EN",
     "AR"
    ],
    "type": "string"
   },
   "notificationOption": {
    "enum": [
     "EMAIL",
     "SMS",
     "ALL",
     "LINK"
    ],
    "type": "string"
   },
   "paymentExpiry": {
    "description": "UTC ISO-8601 expiration time.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "paymentMethod": {
    "description": "ApiName from myfatoorah_get_payment_methods; omit to show enabled methods.",
    "minLength": 1,
    "type": "string"
   },
   "redirectionUrl": {
    "description": "Customer return URL after payment.",
    "format": "uri",
    "type": "string"
   },
   "suppliers": {
    "items": {
     "properties": {
      "invoiceShare": {
       "minimum": 0,
       "type": "number"
      },
      "proposedDepositShare": {
       "minimum": 0,
       "type": "number"
      },
      "supplierCode": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "supplierCode"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "userDefinedFields": {
    "properties": {
     "udf1": {
      "type": "string"
     },
     "udf2": {
      "type": "string"
     },
     "udf3": {
      "type": "string"
     },
     "udf4": {
      "type": "string"
     },
     "udf5": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "webhookUrl": {
    "description": "Per-payment webhook URL.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "amount"
  ],
  "type": "object"
 },
 "name": "myfatoorah_create_payment",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "response": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "response"
  ],
  "type": "object"
 },
 "title": "Create MyFatoorah payment or invoice link"
}
