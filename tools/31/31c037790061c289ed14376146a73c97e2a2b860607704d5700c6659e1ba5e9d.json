    "description": "Discover kind; only supply on the first page",
    "enum": [
     "all",
     "cirque",
     "major",
     "magic",
     "comedy",
     "music",
     "sports",
     "variety",
     "adult",
     "event"
    ],
    "type": "string"
   },
   "cursor": {
    "description": "Returned next_cursor; pass its returned date and omit category",
    "type": "string"
   },
   "date": {
    "description": "YYYY-MM-DD, today through the next six Vegas dates",
    "type": "string"
   },
   "page_size": {
    "description": "Default 8",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [],
  "type": "object"
