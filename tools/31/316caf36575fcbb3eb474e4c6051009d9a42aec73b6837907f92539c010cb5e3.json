{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "supovia:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List your support websites"
 },
 "description": "Use this when someone asks which websites their Supovia support chat runs on, or a website's id is needed. Returns each website's id, name, domain and whether its AI customer agent is on, most recently edited first, 20 per page by default. Not for customer conversations.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The page.nextCursor of the previous page; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Websites per page, from 1 to 50; defaults to 20",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_websites",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "description": "hasMore is true when more websites follow; pass nextCursor as cursor to get them",
    "properties": {
     "count": {
      "maximum": 50,
      "minimum": 0,
      "type": "integer"
     },
     "hasMore": {
      "type": "boolean"
     },
     "nextCursor": {
      "anyOf": [
       {
        "maxLength": 4096,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "count",
     "hasMore",
     "nextCursor"
    ],
    "type": "object"
   },
   "websites": {
    "description": "Websites in the signed-in organization, most recently edited first. Prompts, credentials, integration configuration, organization ids and arbitrary metadata are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "agentEnabled": {
       "type": "boolean"
      },
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "domain": {
       "anyOf": [
        {
         "maxLength": 253,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "domain",
      "agentEnabled",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "websites",
   "page"
  ],
  "type": "object"
 },
 "title": "List your support websites"
}
