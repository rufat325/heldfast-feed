{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a structured action payload to a Thalovant hub.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "configPath": {
    "description": "Path to a Thalovant SDK config file.",
    "minLength": 1,
    "type": "string"
   },
   "context": {
    "additionalProperties": false,
    "properties": {
     "authClaims": {
      "additionalProperties": {},
      "type": "object"
     },
     "authProvider": {
      "minLength": 1,
      "type": "string"
     },
     "channel": {
      "minLength": 1,
      "type": "string"
     },
     "destination": {
      "minLength": 1,
      "type": "string"
     },
     "deviceId": {
      "minLength": 1,
      "type": "string"
     },
     "locale": {
      "minLength": 1,
      "type": "string"
     },
     "metadata": {
      "$ref": "#/properties/context/properties/authClaims"
     },
     "platform": {
      "minLength": 1,
      "type": "string"
     },
     "roles": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     },
     "sessionId": {
      "minLength": 1,
      "type": "string"
     },
     "source": {
      "minLength": 1,
      "type": "string"
     },
     "userId": {
      "minLength": 1,
      "type": "string"
     },
     "userName": {
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "fromEnv": {
    "default": false,
    "description": "Load the identity from Thalovant SDK environment variables.",
    "type": "boolean"
   },
   "identityFile": {
    "description": "Path to a Thalovant identity JSON file.",
    "minLength": 1,
    "type": "string"
   },
   "lang": {
    "minLength": 1,
    "type": "string"
   },
   "payload": {
    "maxLength": 20000,
    "minLength": 1,
    "type": "string"
   },
   "profile": {
    "description": "SDK config profile name.",
    "minLength": 1,
    "type": "string"
   },
   "protocol": {
    "default": "wss",
    "description": "Runtime transport protocol.",
    "enum": [
     "wss",
     "https",
     "mqtt"
    ],
    "type": "string"
   },
   "requestId": {
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "payload"
  ],
  "type": "object"
 },
 "name": "thalovant_send_action",
 "title": "Send Action"
}
