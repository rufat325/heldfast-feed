{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check coverage"
 },
 "description": "Says whether HOUSINGFAX can produce a report for a province (name or two-digit INE code) and, optionally, finds the municipality in the official street directory. Status covered, not_yet_covered (Navarra: foral adapter pending) or unrecognized; not_yet_covered never means no risk. In the Basque Country (Araba, Bizkaia, Gipuzkoa) the report covers the whole building, not a single flat. municipalityLookup unavailable means the directory did not answer: unknown, not missing. Call it before search_address when you are not sure the place is covered.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "language": {
    "default": "es",
    "description": "Language of the texts in the answer (and of the report): es, en, de, nl or fr. Default es.",
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   },
   "municipality": {
    "description": "Optional municipality name; it is looked up in the official street directory of the province.",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   },
   "province": {
    "description": "Spanish province by name (Madrid, Val\u00e8ncia, Bizkaia\u2026) or two-digit INE code (28). Omit both fields to list every province.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "check_coverage",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "contract": {
    "const": "agent-api-1.1.0",
    "type": "string"
   },
   "coverageNote": {
    "maxLength": 600,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   },
   "municipalities": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": false,
       "properties": {
        "municipalityDgcCode": {
         "pattern": "^\\d{1,3}$",
         "type": "string"
        },
        "municipalityIneCode": {
         "pattern": "^\\d{3}$",
         "type": "string"
        },
        "officialLabel": {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        "provinceCode": {
         "pattern": "^\\d{2}$",
         "type": "string"
        }
       },
       "required": [
        "provinceCode",
        "municipalityDgcCode",
        "municipalityIneCode",
        "officialLabel"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "municipalityLookup": {
    "enum": [
     "not_requested",
     "found",
     "not_found",
     "unavailable"
    ],
    "type": "string"
   },
   "provinces": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "addressSource": {
       "anyOf": [
        {
         "enum": [
          "dgc",
          "nora_foral_cadastres"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "buildingConditionRegistry": {
       "anyOf": [
        {
         "enum": [
          "integrated",
          "not_integrated"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "foral": {
       "type": "boolean"
      },
      "note": {
       "maxLength": 600,
       "minLength": 1,
       "type": "string"
      },
      "provinceCode": {
       "anyOf": [
        {
         "pattern": "^\\d{2}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "provinceLabel": {
       "anyOf": [
        {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "reason": {
       "anyOf": [
        {
         "enum": [
          "foral_adapter_pending",
          "not_a_spanish_province"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "enum": [
        "covered",
        "not_yet_covered",
        "unrecognized"
       ],
       "type": "string"
      },
      "territoryCode": {
       "anyOf": [
        {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "unitSelection": {
       "anyOf": [
        {
         "enum": [
          "dwelling_or_building",
          "building_only"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "provinceCode",
      "provinceLabel",
      "territoryCode",
      "status",
      "foral",
      "addressSource",
      "unitSelection",
      "buildingConditionRegistry",
      "reason",
      "note"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "contract",
   "language",
   "provinces",
   "municipalities",
   "municipalityLookup",
   "coverageNote"
  ],
  "type": "object"
 },
 "title": "Check whether a Spanish province or municipality is covered"
}
