{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Enrich many companies with one shared custom question \u2014 one run per\ntarget domain. Capped at 100 targets per call; split a larger list\ninto successive calls of 100 or fewer. Returns 202 immediately; poll\neach run with enrichment_runs-get or list them with enrichment_runs-list.\n",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "__requestBody": {
    "additionalProperties": {},
    "description": "Request body",
    "properties": {
     "answerType": {
      "default": "open_text",
      "enum": [
       "open_text",
       "number",
       "boolean",
       "list",
       "percentage",
       "currency",
       "url",
       "contacts",
       "contact_posts",
       "contact_engagements",
       "json_schema"
      ],
      "type": "string"
     },
     "connectors": {
      "additionalProperties": {},
      "description": "Connector configuration applied to every run in the batch.",
      "properties": {
       "salesNavigator": {
        "additionalProperties": {},
        "properties": {
         "enabled": {
          "default": "preferred",
          "enum": [
           "required",
           "preferred",
           "off"
          ],
          "type": "string"
         }
        },
        "type": "object"
       }
      },
      "type": "object"
     },
     "forceRefresh": {
      "type": "boolean"
     },
     "generateSummaryOnComplete": {
      "type": "boolean"
     },
     "outputSchema": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     "qualificationCriteria": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     "question": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
     },
     "signalTemplateId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "targets": {
      "description": "Company domains; one run per target.",
      "items": {
       "description": "Company domain (e.g., \"acme.com\")",
       "example": "acme.com",
       "maxLength": 253,
       "minLength": 1,
       "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?)*$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "verificationMode": {
      "enum": [
       "strict",
       "lenient"
      ],
      "type": "string"
     },
     "webhookUrl": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     },
     "weight": {
      "enum": [
       "important",
       "nice_to_have",
       "not_important"
      ],
      "type": "string"
     }
    },
    "required": [
     "targets"
    ],
    "type": "object"
   }
  },
  "required": [
   "__requestBody"
  ],
  "type": "object"
 },
 "name": "companies-enrich_custom_batch"
}
