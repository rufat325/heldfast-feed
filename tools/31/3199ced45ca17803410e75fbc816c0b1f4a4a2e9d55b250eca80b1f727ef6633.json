{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a venue"
 },
 "description": "Save a new venue under an organization, to use as an event's venue_id. Eventbrite: POST /organizations/{organization_id}/venues/.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address_1": {
    "description": "Street address, line 1.",
    "type": "string"
   },
   "address_2": {
    "description": "Street address, line 2.",
    "type": "string"
   },
   "age_restriction": {
    "description": "Age restriction.",
    "enum": [
     "AGE_RESTRICTION_ALL_AGES",
     "AGE_RESTRICTION_MIN_TWELVE",
     "AGE_RESTRICTION_MIN_THIRTEEN",
     "AGE_RESTRICTION_MIN_FOURTEEN",
     "AGE_RESTRICTION_MIN_FIFTEEN",
     "AGE_RESTRICTION_MIN_SIXTEEN",
     "AGE_RESTRICTION_MIN_SEVENTEEN",
     "AGE_RESTRICTION_MIN_EIGHTEEN",
     "AGE_RESTRICTION_MIN_NINETEEN",
     "AGE_RESTRICTION_MIN_TWENTY_ONE",
     "AGE_RESTRICTION_UNDER_TWENTY_ONE_WITH_GUARDIAN",
     "AGE_RESTRICTION_UNDER_EIGHTEEN_WITH_GUARDIAN"
    ],
    "type": "string"
   },
   "capacity": {
    "description": "Venue capacity.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "city": {
    "description": "City.",
    "type": "string"
   },
   "country": {
    "description": "ISO 3166-1 two-letter country code, e.g. US.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "google_place_id": {
    "description": "Google Place ID for the venue.",
    "type": "string"
   },
   "latitude": {
    "description": "Latitude.",
    "type": "string"
   },
   "longitude": {
    "description": "Longitude.",
    "type": "string"
   },
   "name": {
    "description": "Venue name.",
    "minLength": 1,
    "type": "string"
   },
   "organization_id": {
    "description": "Organization ID (from eventbrite_list_organizations). This is NOT the organizer id in an organizer profile URL.",
    "minLength": 1,
    "type": "string"
   },
   "organizer_id": {
    "description": "Organizer the venue belongs to (omit for the default).",
    "type": "string"
   },
   "postal_code": {
    "description": "Postal code.",
    "type": "string"
   },
   "region": {
    "description": "ISO 3166-2 region code, e.g. CA.",
    "type": "string"
   }
  },
  "required": [
   "organization_id",
   "name"
  ],
  "type": "object"
 },
 "name": "eventbrite_create_venue",
 "title": "Create a venue"
}
