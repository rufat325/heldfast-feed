{
 "description": "Browse prediction markets on FlipCoin. Filter by status, search by title, sort by volume/trades/deadline. Returns market address, title, status, volume, prices, and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Filter by category (e.g. crypto, politics, sports)",
    "type": "string"
   },
   "limit": {
    "description": "Results per page (1-100, default 50)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "number"
   },
   "search": {
    "description": "Search markets by title",
    "type": "string"
   },
   "sort": {
    "description": "Sort order",
    "enum": [
     "volume",
     "created",
     "trades",
     "deadlineSoon"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by market status",
    "enum": [
     "open",
     "resolved",
     "pending",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_markets"
}
