{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Recent dated news (tests, launches, funding, delays, papers) with a short summary, the story page and the original source URL. Optionally filter by frontier, company, or program (program needs company or frontier). `sort: top` ranks by importance instead of recency.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "company": {
    "$ref": "#/properties/frontier",
    "description": "Company slug, e.g. 'spacex'"
   },
   "frontier": {
    "description": "Frontier slug, e.g. 'energy'",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[a-z0-9][a-z0-9-]*$",
    "type": "string"
   },
   "limit": {
    "description": "Max items (default 10, max 20)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "program": {
    "$ref": "#/properties/frontier",
    "description": "Program slug (with company or frontier)"
   },
   "sort": {
    "description": "latest (default) or top (most important first)",
    "enum": [
     "latest",
     "top"
    ],
    "type": "string"
   },
   "window": {
    "description": "Time window (default month)",
    "enum": [
     "day",
     "week",
     "month",
     "quarter",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "latest_updates",
 "title": "Latest news"
}
