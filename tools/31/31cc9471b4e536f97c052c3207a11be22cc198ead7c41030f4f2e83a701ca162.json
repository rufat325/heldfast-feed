{
 "description": "Pre-flight validate market parameters without creating any records. Returns issues (errors and warnings), duplicate-market check, and a computation preview (slug, fingerprint, seedUsdc, deadline, estimatedMaxLoss). Lightweight \u2014 counts as a read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "type": "string"
   },
   "description": {
    "maxLength": 5000,
    "type": "string"
   },
   "initialPriceYesBps": {
    "maximum": 9900,
    "minimum": 100,
    "type": "integer"
   },
   "liquidityTier": {
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "resolutionCriteria": {
    "description": "Resolution criteria.",
    "maxLength": 1000,
    "type": "string"
   },
   "resolutionDate": {
    "description": "ISO 8601 resolution date.",
    "type": "string"
   },
   "resolutionSource": {
    "description": "HTTPS URL of authoritative source.",
    "format": "uri",
    "type": "string"
   },
   "resolveEndAt": {
    "description": "ISO 8601 deadline.",
    "type": "string"
   },
   "title": {
    "description": "Market question.",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "title",
   "resolutionCriteria",
   "resolutionSource"
  ],
  "type": "object"
 },
 "name": "validate_market_params"
}
