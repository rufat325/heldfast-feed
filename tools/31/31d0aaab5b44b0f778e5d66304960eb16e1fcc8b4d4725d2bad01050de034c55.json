   },
   "message": {
    "title": "Message",
    "type": "string"
   },
   "status": {
    "const": "awaiting_user_confirmation",
    "title": "Status",
    "type": "string"
   }
  },
  "required": [
   "status",
   "expires_at",
   "message"
  ],
  "title": "InquiryResult",
  "type": "object"
 },
 "title": "Request a charter quote (partner Villiers)"
}
