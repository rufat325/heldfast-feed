  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Requests confirmed charter prices from partner Villiers for the route of a charter_alternative, for when the user has seen its price range, asked for confirmed prices and given their email. NOT an empty leg: a regular charter and a paid partner offer. voidjet emails the user a link; Villiers receives the request only after the user sends the form on voidjet.io within 48 hours, then emails confirmed options directly. name, phone and message are optional and come from the user.",
 "inputSchema": {
  "properties": {
   "departure_date": {
    "format": "date",
    "title": "Departure Date",
    "type": "string"
   },
   "destination": {
    "description": "destination_code from charter_alternative.",
    "maxLength": 64,
    "title": "Destination",
    "type": "string"
   },
   "email": {
    "description": "The user's email address.",
    "maxLength": 254,
    "title": "Email",
    "type": "string"
   },
   "flexible": {
    "default": false,
    "title": "Flexible",
    "type": "boolean"
   },
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "de"
    ],
    "title": "Locale",
    "type": "string"
   },
   "message": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Message"
   },
   "name": {
    "anyOf": [
     {
      "maxLength": 100,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Name"
   },
   "origin": {
    "description": "origin_code from charter_alternative.",
    "maxLength": 64,
    "title": "Origin",
    "type": "string"
   },
   "passengers": {
    "maximum": 19,
    "minimum": 1,
    "title": "Passengers",
    "type": "integer"
   },
   "phone": {
    "anyOf": [
     {
      "maxLength": 40,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Phone"
   }
  },
  "required": [
   "origin",
   "destination",
   "departure_date",
   "passengers",
   "email"
  ],
  "title": "request_charter_quoteArguments",
  "type": "object"
 },
 "name": "request_charter_quote",
 "outputSchema": {
