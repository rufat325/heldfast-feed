{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Lists available make or just targets with optional descriptions. Auto-detects make vs just.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "file": {
    "description": "Path to a non-default makefile or justfile (maps to make -f FILE / just --justfile FILE)",
    "maxLength": 4096,
    "type": "string"
   },
   "filter": {
    "description": "Client-side regex filter on target names \u2014 useful for projects with many targets",
    "maxLength": 255,
    "type": "string"
   },
   "includeSubmodules": {
    "description": "Include recipes from justfile submodules (just --list-submodules, just only)",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "showRecipe": {
    "description": "Include recipe command bodies per target where available (from just JSON dump or Makefile source)",
    "type": "boolean"
   },
   "tool": {
    "default": "auto",
    "description": "Task runner to use: \"auto\" detects from files, or force \"make\"/\"just\"",
    "enum": [
     "auto",
     "make",
     "just"
    ],
    "type": "string"
   },
   "unsorted": {
    "description": "List targets in definition order instead of alphabetical (just --unsorted, just only)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "patternRules": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dependencies": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "pattern": {
       "type": "string"
      },
      "recipe": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "pattern"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "targets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dependencies": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Make/Just List Targets"
}
