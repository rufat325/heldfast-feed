    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Save session debrief"
 },
 "description": "Save a post-session DEBRIEF onto the session in Metodic: how it went, what worked, what to improve, follow-ups. Call after the user has run their workshop and tells you how it went (or after a debrief conversation) \u2014 synthesize first, then save. Debriefs accumulate on the session; nothing is overwritten.",
 "inputSchema": {
  "properties": {
   "follow_ups": {
    "description": "Actions owed after the session.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notes": {
    "description": "The debrief synthesis \u2014 how the session actually went.",
    "type": "string"
   },
   "rating": {
    "description": "Overall 1-5.",
    "type": "integer"
   },
   "session_id": {
    "description": "The Metodic session (toolkit) id.",
    "type": "string"
   },
   "to_improve": {
    "description": "Things to change next time.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "went_well": {
    "description": "Things that worked.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "session_id",
   "notes"
  ],
  "type": "object"
 },
 "name": "add_debrief",
 "securitySchemes": [
  {
   "scopes": [
    "metodic"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Save session debrief"
}
