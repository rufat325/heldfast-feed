{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the account's storage: every folder (with its full path and file count) plus the files inside one folder. Omit folderId to list files sitting at the root. Also returns bytes used against the plan limit. Start here before moving, renaming or deleting anything \u2014 the ids it returns are what the other folder tools take.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "folderId": {
    "description": "Folder to list files from. Omit (or pass 'root') for the storage root.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_storage",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "files": {
    "description": "Files in the requested folder",
    "items": {
     "additionalProperties": false,
     "properties": {
      "createdAt": {
       "type": "string"
      },
      "fileName": {
       "type": "string"
      },
      "folderId": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "pricePerDownload": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "shareUrl": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sizeBytes": {
       "type": "number"
      },
      "status": {
       "type": "string"
      },
      "uploadId": {
       "type": "string"
      }
     },
     "required": [
      "uploadId",
      "fileName",
      "sizeBytes",
      "status",
      "createdAt",
      "folderId",
      "pricePerDownload",
      "shareUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "folder": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "path": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "path"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "The folder that was listed, or null for the root"
   },
   "folders": {
    "description": "Every folder in the account, flat, each with its full path",
    "items": {
     "additionalProperties": false,
     "properties": {
      "fileCount": {
       "type": "number"
      },
      "folderId": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "parentId": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "folderId",
      "name",
      "path",
      "parentId",
      "fileCount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "usage": {
    "additionalProperties": false,
    "description": "Whole-account storage usage \u2014 folders do not have their own quota",
    "properties": {
     "files": {
      "type": "number"
     },
     "limitBytes": {
      "type": "number"
     },
     "plan": {
      "type": "string"
     },
     "usedBytes": {
      "type": "number"
     }
    },
    "required": [
     "plan",
     "files",
     "usedBytes",
     "limitBytes"
    ],
    "type": "object"
   }
  },
  "required": [
   "folder",
   "folders",
   "files",
   "usage"
  ],
  "type": "object"
 },
 "title": "List Storage"
}
