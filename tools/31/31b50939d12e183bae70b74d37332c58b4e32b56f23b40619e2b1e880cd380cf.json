    "enum": [
     "email",
     "sms"
    ],
    "type": "string"
   },
   "contactId": {
    "description": "Defaults to the deal's contact",
    "type": "string"
   },
   "employeeId": {
    "description": "Sender; defaults to the company address",
    "type": "string"
   },
   "quoteId": {
    "description": "Quote id",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
