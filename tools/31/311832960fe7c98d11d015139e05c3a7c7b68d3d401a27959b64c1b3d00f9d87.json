{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List long-form articles in the workspace library with their id, title, status, word count, summary, and last updated time.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 20,
    "description": "Max number of articles to return (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Filter by article status",
    "enum": [
     "outline",
     "drafting",
     "ready",
     "published"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_articles",
 "outputSchema": {
  "description": "List of articles in the workspace library",
  "items": {
   "properties": {
    "createdAt": {
     "type": "string"
    },
    "id": {
     "description": "Article ID",
     "type": "string"
    },
    "status": {
     "description": "Status (outline, drafting, ready, published)",
     "type": "string"
    },
    "summary": {
     "description": "Summary or brief",
     "nullable": true,
     "type": "string"
    },
    "title": {
     "description": "Article title",
     "type": "string"
    },
    "updatedAt": {
     "type": "string"
    },
    "url": {
     "type": "string"
    },
    "words": {
     "description": "Word count",
     "type": "number"
    }
   },
   "required": [
    "id",
    "title",
    "status",
    "words"
   ],
   "type": "object"
  },
  "type": "array"
 },
 "title": "List articles"
}
