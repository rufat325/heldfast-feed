{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "appskyline:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read recent Google Play reviews"
 },
 "description": "Use this when someone asks what users say about their Android app on Google Play, or about recent ratings and complaints. Returns reviews with stars, text cut to 300 characters, app version, device, language and whether the developer replied, up to 100 per page. Google Play only returns reviews from the last 7 days. Not for App Store reviews.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "AppSkyline app id (uuid); the app needs a Google Play service account in AppSkyline",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "maxResults": {
    "description": "Reviews to return per page, from 1 to 100",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "token": {
    "description": "nextPageToken from the previous page; absent for the first page",
    "maxLength": 2000,
    "type": "string"
   },
   "translationLanguage": {
    "description": "Translate review text into this language, such as en; omit to keep the original language",
    "maxLength": 32,
    "type": "string"
   }
  },
  "required": [
   "appId"
  ],
  "type": "object"
 },
 "name": "list_google_play_reviews",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "nextPageToken": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Pass as token to get the next page; null on the last page"
   },
   "returned": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "reviews": {
    "description": "Reviews created or edited in the last 7 days, as the Google Play API returns them; review text is cut to 300 characters",
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "date": {
       "anyOf": [
        {
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "device": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "language": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "replied": {
       "type": "boolean"
      },
      "reviewId": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "stars": {
       "anyOf": [
        {
         "maximum": 5,
         "minimum": 1,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "text": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "version": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "reviewId",
      "author",
      "stars",
      "date",
      "version",
      "device",
      "language",
      "replied",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "status": {
    "enum": [
     "available",
     "empty",
     "not-configured"
    ],
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "appId",
   "reviews",
   "returned",
   "nextPageToken",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Read recent Google Play reviews"
}
