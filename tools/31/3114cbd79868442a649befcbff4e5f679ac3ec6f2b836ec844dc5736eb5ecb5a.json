{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Announce a system.info event every every_seconds (1 to 60, default 5), the first at once. for_seconds (1 to 3600) stops the watch after that long. every_seconds 0 stops it and leaves nothing running. Only one watch runs at a time; calling this again replaces it. If system events are off, watch_system switches on system.info itself, so a dashboard needs no admin credential; an administrator can turn that off with update_settings with events.autoSystem=false. The numbers are the container's cgroup limit when the process is inside Docker. The watch does not keep the process alive.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "every_seconds": {
    "description": "Seconds between reports, 1 to 60. Default 5. 0 stops the watch.",
    "maximum": 60,
    "minimum": 0,
    "type": "integer"
   },
   "for_seconds": {
    "description": "Stop reporting after this many seconds, 1 to 3600. Leave out to report until watch_system is called with every_seconds=0.",
    "maximum": 3600,
    "minimum": 1,
    "type": "integer"
   },
   "topic": {
    "description": "Tag for the events. Default system, so a listener can filter with ?topic=system.",
    "maxLength": 60,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "watch_system",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "delivered": {
    "type": "boolean"
   },
   "eventsOn": {
    "type": "boolean"
   },
   "info": {
    "additionalProperties": false,
    "properties": {
     "arch": {
      "type": "string"
     },
     "container": {
      "additionalProperties": false,
      "properties": {
       "in_container": {
        "type": "boolean"
       },
       "runtime": {
        "type": "string"
       }
      },
      "required": [
       "in_container",
       "runtime"
      ],
      "type": "object"
     },
     "cpu": {
      "additionalProperties": false,
      "properties": {
       "count": {
        "type": "integer"
       },
       "limit": {
        "type": "number"
       },
       "load": {
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       "model": {
        "type": "string"
       },
       "used_percent": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "count",
       "limit",
       "model",
       "load",
       "used_percent"
      ],
      "type": "object"
     },
     "disk": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "free_bytes": {
          "$ref": "#/properties/info/properties/memory/properties/total_bytes"
         },
         "path": {
          "type": "string"
         },
         "total_bytes": {
          "$ref": "#/properties/info/properties/memory/properties/total_bytes"
         },
         "used_bytes": {
          "$ref": "#/properties/info/properties/memory/properties/total_bytes"
         },
         "used_percent": {
          "type": "number"
         }
        },
        "required": [
         "path",
         "total_bytes",
         "free_bytes",
         "used_bytes",
         "used_percent"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "hostname": {
      "type": "string"
     },
     "memory": {
      "additionalProperties": false,
      "properties": {
       "free_bytes": {
        "$ref": "#/properties/info/properties/memory/properties/total_bytes"
       },
       "host_bytes": {
        "$ref": "#/properties/info/properties/memory/properties/total_bytes"
       },
       "limit_bytes": {
        "anyOf": [
         {
          "$ref": "#/properties/info/properties/memory/properties/total_bytes"
         },
         {
          "type": "null"
         }
        ]
       },
       "process_rss_bytes": {
        "$ref": "#/properties/info/properties/memory/properties/total_bytes"
       },
       "source": {
        "type": "string"
       },
       "total_bytes": {
        "minimum": 0,
        "type": "integer"
       },
       "used_bytes": {
        "$ref": "#/properties/info/properties/memory/properties/total_bytes"
       },
       "used_from": {
        "type": "string"
       },
       "used_percent": {
        "type": "number"
       }
      },
      "required": [
       "source",
       "used_from",
       "total_bytes",
       "host_bytes",
       "limit_bytes",
       "used_bytes",
       "free_bytes",
       "used_percent",
       "process_rss_bytes"
      ],
      "type": "object"
     },
     "node": {
      "type": "string"
     },
     "pid": {
      "type": "integer"
     },
     "platform": {
      "type": "string"
     },
     "process_uptime_s": {
      "minimum": 0,
      "type": "integer"
     },
     "release": {
      "type": "string"
     },
     "uptime_s": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "hostname",
     "platform",
     "arch",
     "release",
     "node",
     "pid",
     "uptime_s",
     "process_uptime_s",
     "container",
     "cpu",
     "memory",
     "disk"
    ],
    "type": "object"
   },
   "next": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "switchedOn": {
    "type": "boolean"
   },
   "watching": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "every_seconds": {
        "type": "number"
       },
       "for_seconds": {
        "type": "number"
       },
       "topic": {
        "type": "string"
       }
      },
      "required": [
       "every_seconds",
       "topic"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "ok",
   "info",
   "watching",
   "delivered",
   "eventsOn"
  ],
  "type": "object"
 }
}
