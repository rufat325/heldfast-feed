{
 "description": "Find Swedish statutes implementing a specific EU directive or regulation. For reverse (Swedish \u2192 EU), use get_eu_basis.",
 "inputSchema": {
  "properties": {
   "eu_document_id": {
    "description": "EU document ID (e.g., \"regulation:2016/679\", \"directive:95/46\")",
    "type": "string"
   },
   "in_force_only": {
    "default": false,
    "description": "Return only in-force statutes",
    "type": "boolean"
   },
   "primary_only": {
    "default": false,
    "description": "Return only primary implementing statutes",
    "type": "boolean"
   }
  },
  "required": [
   "eu_document_id"
  ],
  "type": "object"
 },
 "name": "get_swedish_implementations"
}
