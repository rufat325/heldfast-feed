{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Mark a topic idea used or dismissed"
 },
 "description": "Use this when someone asks to mark a topic idea as used, dismiss it, or bring it back as new. Returns the idea with its new status and, when given, the article it produced; nothing else about the idea changes. Not for editing an idea's title or angle.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "description": "New status: new, used or dismissed",
    "enum": [
     "new",
     "used",
     "dismissed"
    ],
    "type": "string"
   },
   "topicIdeaId": {
    "description": "Topic idea id",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "usedForArticleId": {
    "description": "Id of the article written from this idea; only with status used",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "topicIdeaId",
   "status"
  ],
  "type": "object"
 },
 "name": "set_topic_idea_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "const": "updated",
    "type": "string"
   },
   "topicIdea": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "score": {
      "anyOf": [
       {
        "maximum": 10,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "status": {
      "enum": [
       "new",
       "used",
       "dismissed",
       "unknown"
      ],
      "type": "string"
     },
     "title": {
      "anyOf": [
       {
        "maxLength": 300,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "usedForArticleId": {
      "$ref": "#/properties/topicIdea/properties/id"
     }
    },
    "required": [
     "id",
     "title",
     "score",
     "status",
     "usedForArticleId"
    ],
    "type": "object"
   }
  },
  "required": [
   "status",
   "topicIdea"
  ],
  "type": "object"
 },
 "title": "Mark a topic idea used or dismissed"
}
