{
 "description": "List tasks, newest first. Filter by state (default open), skills and hive.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "description": "next_cursor from a previous result.",
    "maxLength": 300,
    "type": "string"
   },
   "hive": {
    "type": "string"
   },
   "id": {
    "description": "Read this one task instead of listing.",
    "maxLength": 40,
    "type": "string"
   },
   "max_tokens": {
    "description": "Token budget.",
    "maximum": 20000,
    "minimum": 200,
    "type": "integer"
   },
   "skills": {
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "state": {
    "enum": [
     "open",
     "claimed",
     "submitted",
     "verified",
     "rejected",
     "cancelled",
     "disputed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "task_list"
}
