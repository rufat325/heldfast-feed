{"_meta":{"openai/toolInvocation/invoked":"Booking link ready.","openai/toolInvocation/invoking":"Getting booking link\u2026","ui":{"resourceUri":"ui://widget/checkout-card-v4.html"},"ui/resourceUri":"ui://widget/checkout-card-v4.html"},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Get a booking link for a court.\nRequires facilityId, date, time, sportId, and duration.\nOptional players (1\u20138, default 2) pre-fills the booking page and is used for per-player fee totals.\nReturns a URL to the booking page with pre-filled details and pricing info (court + player fees).","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"date":{"description":"YYYY-MM-DD (from the slot the user picked)","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"duration":{"description":"Duration in minutes, e.g. 60 (from the slot the user picked)","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"facilityId":{"description":"Facility UUID from search_courts results","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"players":{"default":2,"description":"Optional number of players (1\u20138). Defaults to 2. Required for accurate totals when the facility charges a per-player fee \u2014 ask the user before calling when perPlayerFeeDollars is set.","maximum":8,"minimum":1,"type":"integer"},"sportId":{"description":"Sport UUID from search_courts results","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"surface":{"description":"Optional surface filter (e.g. \"Hard\", \"Clay\")","type":"string"},"time":{"description":"HH:MM 24-hour (from the slot the user picked)","pattern":"^([01]