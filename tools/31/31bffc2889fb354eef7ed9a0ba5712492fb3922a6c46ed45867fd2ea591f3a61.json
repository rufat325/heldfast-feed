{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Rate a place (1-5 stars) with an optional private comment. One rating per user per place.\n\nExamples:\n  - Rate: action=\"upsert\", place_id=\"a1b2c3d4\", score=4, comment=\"Clean facilities\"\n  - Delete: action=\"delete\", place_id=\"a1b2c3d4\"\n\nplace_id accepts the 8-char [xxxxxxxx] shown by nausika_search_places, or a full UUID. Find places first with nausika_search_places, then rate by place_id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Create/update or delete your rating",
    "enum": [
     "upsert",
     "delete"
    ],
    "type": "string"
   },
   "comment": {
    "description": "Private comment (only visible to you)",
    "examples": [
     "Clean facilities, friendly staff"
    ],
    "type": "string"
   },
   "place_id": {
    "description": "Place id \u2014 full UUID or 8+ char hex prefix from nausika_search_places ([xxxxxxxx])",
    "maxLength": 64,
    "minLength": 8,
    "type": "string"
   },
   "score": {
    "description": "Rating 1-5 (required for upsert)",
    "examples": [
     4,
     5
    ],
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "action",
   "place_id"
  ],
  "type": "object"
 },
 "name": "nausika_manage_rating",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "action": {
    "enum": [
     "upsert",
     "delete"
    ],
    "type": "string"
   },
   "aggregate": {
    "additionalProperties": {},
    "properties": {
     "avg_rating": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "dist_1": {
      "type": "string"
     },
     "dist_2": {
      "type": "string"
     },
     "dist_3": {
      "type": "string"
     },
     "dist_4": {
      "type": "string"
     },
     "dist_5": {
      "type": "string"
     },
     "rating_count": {
      "type": "string"
     }
    },
    "required": [
     "avg_rating",
     "rating_count"
    ],
    "type": "object"
   },
   "place_id": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   },
   "rating": {
    "additionalProperties": {},
    "properties": {
     "comment": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "created_at": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "place_id": {
      "type": "string"
     },
     "score": {
      "type": "number"
     },
     "updated_at": {
      "type": "string"
     },
     "user_id": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "action",
   "place_id"
  ],
  "type": "object"
 },
 "title": "Manage Rating"
}
