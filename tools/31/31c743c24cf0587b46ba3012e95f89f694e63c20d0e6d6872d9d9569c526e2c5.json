{
 "description": "Generate a hash of the input text. Supports md5, sha1, sha256, sha512",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "algorithm": {
    "default": "sha256",
    "description": "Hash algorithm",
    "enum": [
     "md5",
     "sha1",
     "sha256",
     "sha512"
    ],
    "type": "string"
   },
   "text": {
    "description": "Text to hash",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "hash"
}
