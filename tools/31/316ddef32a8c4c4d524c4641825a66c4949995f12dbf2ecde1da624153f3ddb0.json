{
 "description": "Divisional chart (varga) placements for birth data \u2014 all sixteen supported divisions d1,d2,d3,d4,d7,d9,d10,d12,d16,d20,d24,d27,d30,d40,d45,d60. Deterministic, no LLM. Same compute path as POST /api/b2b/varga.",
 "inputSchema": {
  "properties": {
   "birth_data": {
    "properties": {
     "dob": {
      "description": "Birth date, YYYY-MM-DD.",
      "type": "string"
     },
     "lat": {
      "description": "Birth latitude, -90 to 90.",
      "type": "number"
     },
     "lng": {
      "description": "Birth longitude, -180 to 180.",
      "type": "number"
     },
     "tob": {
      "description": "Birth time, HH:MM (24h).",
      "type": "string"
     },
     "tz": {
      "description": "UTC offset (e.g. 5.5) or IANA zone name (e.g. Asia/Kolkata).",
      "type": [
       "number",
       "string"
      ]
     }
    },
    "required": [
     "dob",
     "tob",
     "lat",
     "lng",
     "tz"
    ],
    "type": "object"
   },
   "varga": {
    "enum": [
     "d1",
     "d2",
     "d3",
     "d4",
     "d7",
     "d9",
     "d10",
     "d12",
     "d16",
     "d20",
     "d24",
     "d27",
     "d30",
     "d40",
     "d45",
     "d60"
    ],
    "type": "string"
   }
  },
  "required": [
   "birth_data",
   "varga"
  ],
  "type": "object"
 },
 "name": "get_varga"
}
