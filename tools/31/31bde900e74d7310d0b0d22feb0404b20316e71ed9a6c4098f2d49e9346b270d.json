{
 "description": "Generate full project boilerplate with ML-composed pages for React, Next.js, Vue, Angular, Svelte, or HTML with Tailwind CSS and optional state management",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "architecture": {
    "default": "flat",
    "description": "Project architecture pattern",
    "enum": [
     "flat",
     "feature-based",
     "atomic"
    ],
    "type": "string"
   },
   "brand_identity": {
    "description": "JSON string from branding-mcp generate_brand_identity. Overrides design context with brand tokens.",
    "type": "string"
   },
   "framework": {
    "description": "Frontend framework to scaffold",
    "enum": [
     "react",
     "nextjs",
     "vue",
     "angular",
     "html",
     "svelte"
    ],
    "type": "string"
   },
   "industry": {
    "description": "Target industry for composed pages",
    "enum": [
     "saas",
     "fintech",
     "ecommerce",
     "healthcare",
     "education",
     "startup",
     "agency",
     "media",
     "devtools",
     "general"
    ],
    "type": "string"
   },
   "mood": {
    "description": "Design mood/personality for composed pages",
    "enum": [
     "bold",
     "calm",
     "playful",
     "professional",
     "premium",
     "energetic",
     "minimal",
     "editorial",
     "futuristic",
     "warm",
     "corporate",
     "creative"
    ],
    "type": "string"
   },
   "project_name": {
    "description": "Project name (used for directory and package.json)",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "state_management": {
    "default": "none",
    "description": "State management solution",
    "enum": [
     "useState",
     "zustand",
     "pinia",
     "signals",
     "none"
    ],
    "type": "string"
   },
   "styling": {
    "default": "tailwindcss",
    "description": "Styling framework",
    "enum": [
     "tailwindcss"
    ],
    "type": "string"
   },
   "visual_style": {
    "description": "Visual style for composed pages",
    "enum": [
     "glassmorphism",
     "neubrutalism",
     "soft-depth",
     "bento-grid",
     "gradient-mesh",
     "dark-premium",
     "minimal-editorial",
     "linear-modern",
     "retro-playful",
     "corporate-trust"
    ],
    "type": "string"
   }
  },
  "required": [
   "framework",
   "project_name"
  ],
  "type": "object"
 },
 "name": "scaffold_full_application"
}
