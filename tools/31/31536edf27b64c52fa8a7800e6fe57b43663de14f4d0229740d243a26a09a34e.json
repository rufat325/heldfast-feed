{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Render a public web page in Chromium and return a screenshot. Use fullPage for the whole scrollable page; very tall pages come back as a link instead of an inline image.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "format": {
    "default": "webp",
    "description": "Image format. webp and jpeg are much smaller than png.",
    "enum": [
     "png",
     "jpeg",
     "webp"
    ],
    "type": "string"
   },
   "fullPage": {
    "default": false,
    "description": "Capture the full scrollable page.",
    "type": "boolean"
   },
   "height": {
    "default": 720,
    "description": "Viewport height in CSS pixels.",
    "exclusiveMinimum": 0,
    "maximum": 1080,
    "type": "integer"
   },
   "locale": {
    "description": "BCP 47 locale, e.g. de-DE.",
    "type": "string"
   },
   "timezoneId": {
    "description": "IANA time zone, e.g. Europe/Berlin.",
    "type": "string"
   },
   "url": {
    "description": "Public http(s) URL to capture, e.g. 'https://example.com'.",
    "format": "uri",
    "type": "string"
   },
   "waitForSelector": {
    "description": "CSS selector that must appear before capturing.",
    "type": "string"
   },
   "waitUntil": {
    "default": "load",
    "description": "Navigation event to wait for before capturing.",
    "enum": [
     "load",
     "domcontentloaded",
     "networkidle"
    ],
    "type": "string"
   },
   "width": {
    "default": 1280,
    "description": "Viewport width in CSS pixels.",
    "exclusiveMinimum": 0,
    "maximum": 1920,
    "type": "integer"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "take_screenshot",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bytes": {
    "type": "number"
   },
   "cache": {
    "enum": [
     "hit",
     "rendered"
    ],
    "type": "string"
   },
   "contentType": {
    "type": "string"
   },
   "height": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "imageUrl": {
    "type": "string"
   },
   "inlined": {
    "type": "boolean"
   },
   "width": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "imageUrl",
   "contentType",
   "bytes",
   "width",
   "height",
   "inlined",
   "cache"
  ],
  "type": "object"
 },
 "title": "Take a screenshot"
}
