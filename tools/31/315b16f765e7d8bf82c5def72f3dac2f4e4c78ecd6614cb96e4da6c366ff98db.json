{
 "description": "Coordinate tenant agents without sharing transcripts. Acquire or release a bounded resource lease, list current leases, or create/list compact evidence-backed child proof packets for a parent agent.",
 "inputSchema": {
  "properties": {
   "action": {
    "enum": [
     "list_leases",
     "acquire_lease",
     "release_lease",
     "list_proof_packets",
     "create_proof_packet"
    ],
    "type": "string"
   },
   "decision_id": {
    "type": "string"
   },
   "evidence_refs": {
    "description": "Opaque durable evidence identifiers only.",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "lease_id": {
    "type": "string"
   },
   "lease_token": {
    "description": "One-time lease capability returned by acquire_lease.",
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "proof_pack_id": {
    "type": "string"
   },
   "resource": {
    "description": "Bounded tenant-visible resource label. Do not send secrets.",
    "maxLength": 160,
    "type": "string"
   },
   "resource_type": {
    "enum": [
     "file",
     "directory",
     "service",
     "workflow",
     "deployment",
     "custom"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "active",
     "released",
     "expired",
     "incomplete",
     "complete",
     "failed"
    ],
    "type": "string"
   },
   "summary": {
    "description": "Compact result summary; no raw transcript.",
    "maxLength": 280,
    "type": "string"
   },
   "ttl_seconds": {
    "maximum": 3600,
    "minimum": 30,
    "type": "number"
   },
   "workflow_id": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "marrow_coordinate"
}
