{
 "description": "Answer the seller's counter: accept it, counter with a higher offer (amountCents required), or withdraw.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "action": {
    "enum": [
     "accept",
     "counter",
     "withdraw"
    ],
    "type": "string"
   },
   "amountCents": {
    "exclusiveMinimum": 0,
    "maximum": 100000000,
    "type": "integer"
   },
   "offerId": {
    "maxLength": 64,
    "type": "string"
   }
  },
  "required": [
   "offerId",
   "action"
  ],
  "type": "object"
 },
 "name": "respond_to_counter",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "acceptance": {
    "additionalProperties": false,
    "properties": {
     "checkoutUrl": {
      "type": "string"
     },
     "code": {
      "type": "string"
     },
     "codeExpiresAt": {
      "type": "string"
     },
     "finalPriceCents": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "shopPayUrl": {
      "type": "string"
     }
    },
    "required": [
     "finalPriceCents",
     "checkoutUrl",
     "shopPayUrl"
    ],
    "type": "object"
   },
   "counterCents": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "currency": {
    "type": "string"
   },
   "expiresAt": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "offerId": {
    "type": "string"
   },
   "round": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "roundsRemaining": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "status": {
    "enum": [
     "countered",
     "accepted",
     "rejected",
     "expired",
     "withdrawn"
    ],
    "type": "string"
   },
   "yourLastOfferCents": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "offerId",
   "status",
   "round",
   "roundsRemaining",
   "currency",
   "expiresAt",
   "message"
  ],
  "type": "object"
 }
}
