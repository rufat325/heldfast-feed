{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a contact (person). Use search_companies for the companyId to link an employer. Enforces the workspace plan limit and validates the company/owner links; the result echoes the operating workspace.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "companyId": {
    "anyOf": [
     {
      "description": "Company id to link this contact to (from search_companies). Optional.",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Company id to link this contact to (from search_companies). Optional."
   },
   "email": {
    "anyOf": [
     {
      "description": "The contact's email address. Optional.",
      "format": "email",
      "maxLength": 255,
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "The contact's email address. Optional."
   },
   "firstName": {
    "description": "The contact's first name. Required.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "jobTitle": {
    "anyOf": [
     {
      "description": "The contact's job title. Optional.",
      "maxLength": 160,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "The contact's job title. Optional."
   },
   "lastName": {
    "anyOf": [
     {
      "description": "The contact's last name. Optional.",
      "maxLength": 120,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "The contact's last name. Optional."
   },
   "ownerId": {
    "anyOf": [
     {
      "description": "User id of the workspace member who owns this contact. Optional.",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "User id of the workspace member who owns this contact. Optional."
   },
   "phone": {
    "anyOf": [
     {
      "description": "The contact's phone number. Optional.",
      "maxLength": 50,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "The contact's phone number. Optional."
   },
   "tags": {
    "default": [],
    "description": "Tags for segmentation. Optional.",
    "items": {
     "maxLength": 80,
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "firstName"
  ],
  "type": "object"
 },
 "name": "create_contact",
 "title": "Create contact"
}
