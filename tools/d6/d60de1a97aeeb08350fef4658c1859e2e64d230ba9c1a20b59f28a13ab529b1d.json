{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Edit a page's name, slug, home flag, order, SEO (merged key by key) or members_only. Reads the page first and merges `settings`, so keys it does not name survive. On a template page (product, category, post, blog, course, brand): default_template makes it the type's default, render_for/render_default move entities onto it or back to the default.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "default_template": {
    "const": true,
    "type": "boolean"
   },
   "dry_run": {
    "type": "boolean"
   },
   "is_homepage": {
    "type": "boolean"
   },
   "members_only": {
    "type": "boolean"
   },
   "name": {
    "type": "string"
   },
   "page_id": {
    "type": "string"
   },
   "render_default": {
    "description": "entity ids to return to the type default",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "render_for": {
    "description": "entity ids that should render through this page",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "seo": {
    "additionalProperties": false,
    "properties": {
     "canonical": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "jsonld": {
      "description": "raw application/ld+json blocks, each must parse",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "keywords": {
      "type": "string"
     },
     "metaTags": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "attr": {
         "enum": [
          "name",
          "property",
          "http-equiv"
         ],
         "type": "string"
        },
        "content": {
         "type": "string"
        },
        "disabled": {
         "type": "boolean"
        },
        "key": {
         "type": "string"
        }
       },
       "required": [
        "attr",
        "key",
        "content",
        "disabled"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "noFollow": {
      "type": "boolean"
     },
     "noIndex": {
      "type": "boolean"
     },
     "ogDesc": {
      "type": "string"
     },
     "ogImage": {
      "type": "string"
     },
     "ogTitle": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "twitterCard": {
      "enum": [
       "",
       "summary",
       "summary_large_image"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "site_id": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "sort_order": {
    "type": "integer"
   }
  },
  "required": [
   "page_id"
  ],
  "type": "object"
 },
 "name": "sb_page_update"
}
