{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "A page's platform recovery points, everyone's edits included (sb_undo covers this process only). action:\"list\" \u2014 named versions and autosave history; \"save\" {label} \u2014 snapshot the current draft; \"restore\" {version_id | history_id} \u2014 put the draft back. Writes are dry runs by default.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "list",
     "save",
     "restore"
    ],
    "type": "string"
   },
   "dry_run": {
    "type": "boolean"
   },
   "history_id": {
    "type": "string"
   },
   "label": {
    "type": "string"
   },
   "page_id": {
    "description": "Defaults to the open page",
    "type": "string"
   },
   "site_id": {
    "type": "string"
   },
   "version_id": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "sb_page_version"
}
