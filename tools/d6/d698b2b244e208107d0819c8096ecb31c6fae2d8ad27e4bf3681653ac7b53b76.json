{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update cost category"
 },
 "description": "Update an existing cost category by ID. Requires cost_categories:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Cost category ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "is_active": {
    "description": "Whether the category is active",
    "type": "boolean"
   },
   "name": {
    "description": "Cost category name",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "parent_id": {
    "description": "Parent cost category ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_cost_category",
 "title": "Update cost category"
}
