{
 "description": "Generate a story-driven cover letter using matched data and a narrative archetype. Supports en/de/es/pt.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "archetype": {
    "default": "golden-fleece",
    "description": "Narrative archetype ID (use storylenses_list_archetypes to see options)",
    "type": "string"
   },
   "candidate_name": {
    "description": "Candidate's full name",
    "type": "string"
   },
   "job_analysis": {
    "additionalProperties": true,
    "description": "Job analysis from storylenses_analyze_job",
    "properties": {
     "companyName": {
      "type": "string"
     },
     "jobTitle": {
      "type": "string"
     }
    },
    "required": [
     "jobTitle",
     "companyName"
    ],
    "type": "object"
   },
   "length": {
    "default": "medium",
    "description": "Letter length: short (150-200 words), medium (250-350), full (400-500)",
    "enum": [
     "short",
     "medium",
     "full"
    ],
    "type": "string"
   },
   "locale": {
    "default": "en",
    "description": "Output language",
    "enum": [
     "en",
     "de",
     "es",
     "pt"
    ],
    "type": "string"
   },
   "match_data": {
    "additionalProperties": true,
    "description": "Match data from storylenses_match_profile",
    "properties": {
     "applicantArchetype": {
      "type": "string"
     },
     "matchPercentage": {
      "type": "number"
     },
     "matchingSkills": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "mitigationStrategy": {
      "type": "string"
     },
     "whatCanYouDo": {
      "type": "string"
     },
     "whatNotQualified": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "tone": {
    "default": "professional",
    "description": "Writing tone",
    "enum": [
     "professional",
     "conversational",
     "formal",
     "confident",
     "analytical",
     "storytelling",
     "humble",
     "technical",
     "creative"
    ],
    "type": "string"
   }
  },
  "required": [
   "job_analysis",
   "match_data",
   "candidate_name"
  ],
  "type": "object"
 },
 "name": "storylenses_generate_letter"
}
