{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Token safety screen before trading: honeypot, rug-pull, freeze/mint authority, transfer hooks, sell tax, blacklists. Returns verdict (ok/warn/critical/unknown), a 0-100 risk score, and itemized findings. Costs an x402 toll.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chain": {
    "description": "Chain to swap on",
    "enum": [
     "solana",
     "base",
     "ethereum",
     "arbitrum",
     "polygon",
     "optimism",
     "bsc",
     "avalanche"
    ],
    "type": "string"
   },
   "token": {
    "description": "Token to screen: mint address (solana) or ERC-20 address (EVM chains)",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "token"
  ],
  "type": "object"
 },
 "name": "check_token",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accepts": {
    "description": "x402 payment options when unpaid",
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "chain": {
    "type": "string"
   },
   "error": {
    "description": "Present when the request failed or payment is required",
    "type": "string"
   },
   "findings": {
    "description": "Individual risk findings",
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "next": {
    "additionalProperties": {},
    "description": "Suggested follow-up calls",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "riskScore": {
    "description": "0 (safe) to 100 (critical)",
    "type": "number"
   },
   "source": {
    "description": "Data source used for the screen",
    "type": "string"
   },
   "token": {
    "type": "string"
   },
   "verdict": {
    "description": "ok, warn, critical, or unknown",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Check token safety"
}
