{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "wapiworld:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List your Wapiworld projects"
 },
 "description": "Use this when someone asks which Wapiworld projects they have, or a project's id is needed. Returns each project's id, name and creation and edit times, 25 per page by default, with a cursor for more. Not for their WhatsApp numbers.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The page.nextCursor of the previous page; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Projects per page, from 1 to 100; defaults to 25",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_projects",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "description": "Pass nextCursor as cursor, with the same filters, for the next page; null on the last page",
    "properties": {
     "count": {
      "minimum": 0,
      "type": "integer"
     },
     "hasMore": {
      "type": "boolean"
     },
     "nextCursor": {
      "anyOf": [
       {
        "maxLength": 4096,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "total": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "count",
     "total",
     "hasMore",
     "nextCursor"
    ],
    "type": "object"
   },
   "projects": {
    "description": "Projects the session can reach; an API-key session sees only its own project. Internal organization ids and project configuration are omitted.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "lastEditTime": {
       "$ref": "#/properties/projects/items/properties/creationTime"
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "projects",
   "page"
  ],
  "type": "object"
 },
 "title": "List your Wapiworld projects"
}
