{
 "annotations": {
  "idempotentHint": true
 },
 "description": "Segna come saldate tutte le rate aperte di uno o pi\u00f9 documenti. Se una rata non ha conto, usa payment_account_id o il primo conto configurato.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "company_id": {
    "description": "Azienda su cui operare. Default: FIC_COMPANY_ID o l'unica azienda del token",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "ids": {
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   },
   "paid_date": {
    "description": "Default: oggi",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "payment_account_id": {
    "description": "Conto di saldo (vedi lookup payment_accounts)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "mark_paid"
}
