 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks whether their business should bid for a public contract, or which open tenders suit them best. Compares the tender's conditions of participation (turnover, insurance levels, experience and certifications), location and lot sizes with the company's profile, and returns a fit score with reasons, likely disqualifiers and gaps. Omit tender_reference to rank the open tenders that suit the company. It does not predict or guarantee an award. Do not use for general business strategy or for private-sector sales leads.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "business_size": {
    "description": "The company's size, e.g. \"small\" for under 50 staff. Use \"vcse\" for charities and social enterprises.",
    "enum": [
     "micro",
     "small",
     "medium",
     "large",
     "vcse"
    ],
    "type": "string"
   },
   "company_summary": {
    "description": "What the company does, its size, turnover, certifications, insurance, where it works and past contracts, in the user's words, e.g. \"6-person electrical contractor in Leeds, \u00a3800k turnover, CHAS and Cyber Essentials\". Optional when the user has a saved Tenda profile.",
    "type": "string"
   },
   "country": {
    "description": "The country to look in, when the user names one, e.g. \"Canada\", \"UK\" or \"Spain\" (an EU member state searches the rest of the EU there). Omit to use the user's own countries (the UK when they aren't signed in). Tenda covers the UK, Canada, the United States, Germany, France and the rest of the EU.",
    "type": "string"
   },
   "query": {
    "description": "When ranking without a tender_reference: the kind of work to look for, e.g. \"NHS cleaning\".",
    "type": "string"
   },
   "tender_reference": {
    "description": "The notice ID, procurement identifier, solicitation number or the buyer's own reference, e.g. \"012345-2026\" on Find a Tender, \"WS4851234567\" on CanadaBuys or \"140D0427Q0879\" on SAM.gov.",
    "minLength": 3,
    "type": "string"
   }
  },
  "type": "object"
 },
