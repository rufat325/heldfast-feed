{
 "description": "Parse a CI test run and group failures by error signature. Deduplicates repeated errors and categorizes them as assertion, timeout, network, or crash. Use this as the first step before triage.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "branch": {
    "description": "Branch name",
    "type": "string"
   },
   "commitSha": {
    "description": "Commit SHA",
    "type": "string"
   },
   "customInfraPatterns": {
    "description": "Extra regex patterns (as strings) to classify as infrastructure errors, e.g. cloud-provider-specific messages like 'No space left on device' or 'GCP quota exceeded'",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "failures": {
    "description": "List of test failures from the CI run",
    "items": {
     "properties": {
      "duration": {
       "type": "number"
      },
      "errorMessage": {
       "type": "string"
      },
      "filePath": {
       "type": "string"
      },
      "suiteName": {
       "type": "string"
      },
      "testName": {
       "type": "string"
      }
     },
     "required": [
      "testName",
      "suiteName",
      "errorMessage"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "passedTests": {
    "description": "Number of tests that passed",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "runId": {
    "description": "CI run identifier",
    "type": "string"
   },
   "totalTests": {
    "description": "Total number of tests in the run",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "failures",
   "totalTests",
   "passedTests"
  ],
  "type": "object"
 },
 "name": "aggregate_suite_failures"
}
