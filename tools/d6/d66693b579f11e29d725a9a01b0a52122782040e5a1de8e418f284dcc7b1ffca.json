{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search papers"
 },
 "description": "Search PubMed and OpenAlex for real papers. Every result carries a DOI or PubMed ID that resolves, so nothing returned can be fabricated. Finds sources for a claim or a topic. Filters: publication year range, open-access only, study types, and the number of results. Retracted papers are left out by default. Preprints are included and marked `preprint: true` (not peer reviewed). Results are ranked by the databases' relevance, alternating between the two sources.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "include_retracted": {
    "default": false,
    "description": "Keep retracted papers (flagged) instead of leaving them out.",
    "type": "boolean"
   },
   "max_results": {
    "default": 10,
    "description": "Number of results, 1\u201350.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "open_access_only": {
    "default": false,
    "description": "Only papers with a free, legal full text.",
    "type": "boolean"
   },
   "query": {
    "description": "What to look for, in English keywords (e.g. \"sepsis early antibiotics mortality\").",
    "maxLength": 500,
    "minLength": 2,
    "type": "string"
   },
   "study_types": {
    "description": "Study designs. Known ids use database filters: rct, clinical-trial, systematic-review, meta-analysis, review, guideline, cohort, case-control, case-report, observational. Any other text is added as keywords.",
    "items": {
     "maxLength": 60,
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "year_from": {
    "description": "Earliest publication year, inclusive.",
    "maximum": 2100,
    "minimum": 1800,
    "type": "integer"
   },
   "year_to": {
    "description": "Latest publication year, inclusive.",
    "maximum": 2100,
    "minimum": 1800,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_papers",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "excluded": {
    "additionalProperties": false,
    "properties": {
     "no_identifier": {
      "type": "integer"
     },
     "notices": {
      "type": "integer"
     },
     "outside_years": {
      "type": "integer"
     },
     "retracted": {
      "type": "integer"
     }
    },
    "required": [
     "no_identifier",
     "retracted",
     "notices",
     "outside_years"
    ],
    "type": "object"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "cited_by_count": {
       "type": "integer"
      },
      "doi": {
       "type": "string"
      },
      "found_in": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "journal": {
       "type": "string"
      },
      "links": {
       "additionalProperties": true,
       "properties": {},
       "type": "object"
      },
      "open_access": {
       "additionalProperties": false,
       "properties": {
        "is_oa": {
         "type": "boolean"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "is_oa"
       ],
       "type": "object"
      },
      "pmid": {
       "type": "string"
      },
      "preprint": {
       "type": "boolean"
      },
      "rank": {
       "type": "integer"
      },
      "retracted": {
       "type": "boolean"
      },
      "study_type_match": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "year": {
       "type": "integer"
      }
     },
     "required": [
      "rank",
      "title",
      "authors",
      "url",
      "links",
      "open_access",
      "found_in",
      "retracted",
      "preprint"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "ok",
     "unavailable"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "status",
   "results",
   "excluded",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Search papers"
}
