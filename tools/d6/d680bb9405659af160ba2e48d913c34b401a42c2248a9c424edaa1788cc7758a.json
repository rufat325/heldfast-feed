{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create project risk"
 },
 "description": "Create a new project risk. Requires project_risks:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Risk category",
    "enum": [
     "technical",
     "financial",
     "schedule",
     "resource",
     "external"
    ],
    "type": "string"
   },
   "contingency_plan": {
    "description": "Contingency plan",
    "type": "string"
   },
   "created_by": {
    "description": "Creator (Clerk user ID)",
    "maxLength": 200,
    "type": "string"
   },
   "description": {
    "description": "Risk description",
    "type": "string"
   },
   "due_date": {
    "description": "Due date (ISO 8601)",
    "type": "string"
   },
   "impact": {
    "description": "Impact level. Defaults to medium.",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "mitigation_plan": {
    "description": "Mitigation plan",
    "type": "string"
   },
   "owner_id": {
    "description": "Risk owner (Clerk user ID)",
    "maxLength": 200,
    "type": "string"
   },
   "probability": {
    "description": "Probability level. Defaults to medium.",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "status": {
    "description": "Risk status (default: identified)",
    "enum": [
     "identified",
     "analyzing",
     "mitigating",
     "resolved",
     "accepted"
    ],
    "type": "string"
   },
   "title": {
    "description": "Risk title (required)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "title"
  ],
  "type": "object"
 },
 "name": "create_project_risk",
 "title": "Create project risk"
}
