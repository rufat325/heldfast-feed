{"_meta":{"openai/fileParams":["manuscript"],"openai/outputTemplate":"ui://manusights/manuscript-preview-v1.html","openai/toolInvocation/invoked":"Preview started","openai/toolInvocation/invoking":"Uploading the manuscript","securitySchemes":[{"scopes":["openid","email"],"type":"oauth2"}],"ui":{"resourceUri":"ui://manusights/manuscript-preview-v1.html"}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false,"title":"Start a manuscript preview"},"description":"Use this when the user wants Manusights to review, check or assess a scientific manuscript they attached (PDF, Word, ODT, RTF, TXT, Markdown or LaTeX, up to 50 MB). Starts a pre-submission preview and returns a review_id right away. The preview takes a few minutes, so read it afterwards with get_manuscript_review using the same review_id. While processing, report status only; do not add a preliminary critique. Report only returned findings when ready. Each account can start a limited number of previews per day from connected apps; the result says when the limit is reached. Calling again with the same file and target journal returns the same review instead of starting another. Do not use it to write, rewrite or edit text, for figures or data files, or when no manuscript is attached.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"manuscript":{"description":"The manuscript file the user attached.","properties":{"download_url":{"description":"Temporary download URL for the attached file.","type":"string"},"file_id":{"description":"ChatGPT file id.","type":"string"},"file_name":{"type":"string"},"mime_type":{"type":"string"}},"required":["download_url","file_id"],"type":"object"},"target_journal":{"description":"The journal the author plans to submit to, only if the user named one.","maxLength":200,"type":"string"}},"required":["manuscript"],"type":"object"},"name":"review_manuscript","outputSchema":{"$schema":"https://json-sch