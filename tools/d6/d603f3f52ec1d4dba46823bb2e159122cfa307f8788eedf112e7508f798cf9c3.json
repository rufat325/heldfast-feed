{
 "description": "Batch update sheet dimensions by inserting, deleting, or appending rows/columns. Operations are atomic (all succeed or all fail) and execute in optimal order automatically.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "requests": {
    "description": "Array of dimension update requests",
    "items": {
     "properties": {
      "dimension": {
       "description": "Whether to operate on rows or columns",
       "enum": [
        "ROWS",
        "COLUMNS"
       ],
       "type": "string"
      },
      "endIndex": {
       "description": "Ending index for the operation (0-based, exclusive). Optional - if omitted, the range is unbounded (extends to the end of the sheet)",
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "inheritFromBefore": {
       "description": "For insertDimension: whether new rows/columns inherit properties from the row/column before the insertion point",
       "type": "boolean"
      },
      "operation": {
       "description": "Type of dimension operation to perform",
       "enum": [
        "insertDimension",
        "deleteDimension",
        "appendDimension"
       ],
       "type": "string"
      },
      "startIndex": {
       "description": "Starting index for the operation (0-based)",
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "operation",
      "dimension",
      "startIndex"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "id",
   "gid",
   "requests"
  ],
  "type": "object"
 },
 "name": "dimensions-batch-update",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "operationResults": {
        "description": "Detailed results for each dimension operation",
        "items": {
         "additionalProperties": false,
         "properties": {
          "affectedCount": {
           "description": "Number of rows/columns affected by this operation",
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          },
          "dimension": {
           "description": "Dimension that was operated on",
           "enum": [
            "ROWS",
            "COLUMNS"
           ],
           "type": "string"
          },
          "endIndex": {
           "description": "Ending index of the operation (for insert/delete)",
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          },
          "operation": {
           "description": "Type of operation that was performed",
           "enum": [
            "insertDimension",
            "deleteDimension",
            "appendDimension"
           ],
           "type": "string"
          },
          "startIndex": {
           "description": "Starting index of the operation",
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "operation",
          "dimension",
          "startIndex",
          "affectedCount"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "sheetTitle": {
        "description": "Title of the updated sheet",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL of the updated sheet",
        "type": "string"
       },
       "spreadsheetTitle": {
        "description": "Title of the updated spreadsheet",
        "type": "string"
       },
       "spreadsheetUrl": {
        "description": "URL of the updated spreadsheet",
        "type": "string"
       },
       "totalOperations": {
        "description": "Total number of dimension operations performed",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "type": {
        "const": "success",
        "type": "string"
       },
       "updatedDimensions": {
        "additionalProperties": false,
        "description": "Final dimensions of the sheet after all operations",
        "properties": {
         "columns": {
          "description": "Total number of columns in the sheet after all operations",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "rows": {
          "description": "Total number of rows in the sheet after all operations",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "rows",
         "columns"
        ],
        "type": "object"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "spreadsheetTitle",
       "spreadsheetUrl",
       "sheetTitle",
       "sheetUrl",
       "totalOperations",
       "operationResults",
       "updatedDimensions"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
