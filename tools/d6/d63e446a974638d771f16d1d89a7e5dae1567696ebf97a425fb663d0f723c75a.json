{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Run deep analytics"
 },
 "description": "Run deeper, multi-step analytics on the user's expenses. Use for explanatory questions like 'why did my spending increase' or 'compare Q1 vs Q2'. Takes 10-30 seconds (runs as a background job, polled automatically). Returns: { message, data: { ..., sampleMeta? } } where sampleMeta.isTruncated indicates whether the agent saw the full dataset.",
 "inputSchema": {
  "properties": {
   "dateRange": {
    "description": "Time period filter. Use exactly one variant \u2014 pick the shape that matches the user's phrasing.",
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "month": {
        "description": "Month name or 1-12 (e.g., 'March' or '3')",
        "type": "string"
       },
       "type": {
        "const": "month",
        "type": "string"
       },
       "year": {
        "description": "4-digit year (e.g., 2026)",
        "type": "integer"
       }
      },
      "required": [
       "type",
       "month",
       "year"
      ],
      "title": "Specific month",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "quarter": {
        "maximum": 4,
        "minimum": 1,
        "type": "integer"
       },
       "type": {
        "const": "quarter",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "quarter",
       "year"
      ],
      "title": "Quarter of a year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "year",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "year"
      ],
      "title": "Full year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "end": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "start": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "type": {
        "const": "specific",
        "type": "string"
       }
      },
      "required": [
       "type",
       "start",
       "end"
      ],
      "title": "Specific date range",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "relative",
        "type": "string"
       },
       "value": {
        "description": "Relative range phrase, e.g., 'last month', 'YTD', 'this quarter', 'last 7 days'",
        "type": "string"
       }
      },
      "required": [
       "type",
       "value"
      ],
      "title": "Relative natural-language range",
      "type": "object"
     }
    ]
   },
   "query": {
    "description": "The analytics question to answer",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "get_deep_analytics",
 "outputSchema": {
  "additionalProperties": true,
  "description": "Two branches. Async: type='analytics_pending' with jobId \u2014 poll poll_analytics until complete. Inline: message + data with the computed analytics (data may be null when there is no spreadsheet or no data yet). success is present only on the async branch.",
  "properties": {
   "data": {
    "additionalProperties": true,
    "description": "Inline branch: computed analytics, or null when no spreadsheet / no data.",
    "type": [
     "object",
     "null"
    ]
   },
   "estimatedTime": {
    "description": "Async branch only: seconds.",
    "type": "number"
   },
   "jobId": {
    "description": "Async branch only.",
    "type": "string"
   },
   "message": {
    "description": "Human-readable narrative (both branches).",
    "type": "string"
   },
   "pollEndpoint": {
    "description": "Async branch only.",
    "type": "string"
   },
   "pollInterval": {
    "description": "Async branch only: milliseconds.",
    "type": "number"
   },
   "response": {
    "description": "Chat alias of message.",
    "type": "string"
   },
   "success": {
    "description": "Async branch only.",
    "type": "boolean"
   },
   "type": {
    "description": "Async branch only: \"analytics_pending\" \u2014 poll pollEndpoint or call poll_analytics with jobId.",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
