{
 "description": "Agent Action Gate ($0.02 USDC flat; stable MCP tool name preflight_action). Use before an AI agent performs an external action. Evaluates the required safety, trust, spending and transaction checks and returns ALLOW, REVIEW, REQUIRE_APPROVAL or DENY. Use before opening an untrusted URL, installing a dependency, calling an unfamiliar MCP/tool, spending funds, submitting a transaction, or consuming untrusted external content. Do not use for pure local deterministic computation or when no external action/risk exists. Does not assess seller reputation. Missing or skipped relevant checks cannot produce ALLOW. REQUIRE_APPROVAL is a recommendation only; use /api/financial/authorize-spend separately for actual spend-policy authorization and owner approval. It does not sign, route payment, or broadcast. No private keys, seed phrases, or secrets are accepted. Typical latency depends on selected checks/providers; there is no uniform SLA. Recommended workflows: agent-safety-gate, safe-transaction-preflight, tool-discovery-trust.\n\nAgent entry points: risky external action \u2192 use Agent Action Gate when a combined action-specific safety assessment is needed; unclear capability/provider \u2192 use free /api/discover; constrained comparison between callable alternatives \u2192 use paid route_tool; known single capability \u2192 call the direct tool; multi-step objective \u2192 read the matching workflow recipe and call only relevant steps. Workflows are stateless recipes, not executors; calls are paid separately and are not bundle charged. Agent Action Gate does not approve payment, sign or broadcast transactions, evaluate seller reputation, replace transaction simulation, replace route_tool, or replace human approval.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "action_type": {
    "enum": [
     "tool_call",
     "install_package",
     "open_url",
     "use_external_content",
     "wallet_interaction",
     "transaction",
     "token_interaction",
     "purchase",
     "custom"
    ],
    "type": "string"
   },
   "context": {
    "additionalProperties": false,
    "properties": {
     "agent_id": {
      "maxLength": 128,
      "type": "string"
     },
     "purpose": {
      "maxLength": 500,
      "type": "string"
     },
     "risk_tolerance": {
      "default": "low",
      "enum": [
       "low",
       "medium",
       "high"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "expected_cost": {
    "additionalProperties": false,
    "properties": {
     "amount": {
      "pattern": "^\\d+(?:\\.\\d{1,6})?$",
      "type": "string"
     },
     "asset": {
      "maxLength": 16,
      "type": "string"
     },
     "network": {
      "maxLength": 64,
      "type": "string"
     }
    },
    "type": "object"
   },
   "intent": {
    "maxLength": 500,
    "minLength": 3,
    "type": "string"
   },
   "target": {
    "additionalProperties": false,
    "default": {},
    "properties": {
     "capability": {
      "maxLength": 80,
      "minLength": 2,
      "type": "string"
     },
     "claim": {
      "maxLength": 2000,
      "minLength": 3,
      "type": "string"
     },
     "content": {
      "maxLength": 100000,
      "minLength": 1,
      "type": "string"
     },
     "content_type": {
      "enum": [
       "text",
       "html",
       "markdown",
       "email",
       "tool_output",
       "api_response",
       "document_text"
      ],
      "type": "string"
     },
     "extract_fields": {
      "additionalProperties": {
       "enum": [
        "string",
        "number",
        "boolean",
        "string|null",
        "number|null",
        "boolean|null"
       ],
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "mcp_endpoint": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     },
     "package": {
      "maxLength": 214,
      "minLength": 1,
      "type": "string"
     },
     "token": {
      "additionalProperties": false,
      "properties": {
       "chain": {
        "maxLength": 32,
        "type": "string"
       },
       "token_address": {
        "maxLength": 128,
        "type": "string"
       }
      },
      "required": [
       "chain",
       "token_address"
      ],
      "type": "object"
     },
     "tool": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
     },
     "transaction": {
      "additionalProperties": false,
      "properties": {
       "chain": {
        "maxLength": 32,
        "type": "string"
       },
       "data": {
        "maxLength": 200000,
        "type": "string"
       },
       "from": {
        "maxLength": 128,
        "type": "string"
       },
       "to": {
        "maxLength": 128,
        "type": "string"
       },
       "value": {
        "maxLength": 128,
        "type": "string"
       }
      },
      "required": [
       "chain",
       "from",
       "to",
       "value",
       "data"
      ],
      "type": "object"
     },
     "url": {
      "format": "uri",
      "maxLength": 4096,
      "type": "string"
     },
     "wallet": {
      "anyOf": [
       {
        "pattern": "^0x[a-fA-F0-9]{40}$",
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "address": {
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "type": "string"
         },
         "chain": {
          "default": "base",
          "enum": [
           "base",
           "base-sepolia"
          ],
          "type": "string"
         }
        },
        "required": [
         "address"
        ],
        "type": "object"
       }
      ]
     }
    },
    "type": "object"
   }
  },
  "required": [
   "action_type",
   "intent"
  ],
  "type": "object"
 },
 "name": "preflight_action",
