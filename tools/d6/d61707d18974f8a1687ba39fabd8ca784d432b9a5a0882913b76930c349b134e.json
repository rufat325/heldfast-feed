{
 "description": "A design's branches, newest first: each one's id, name, owner, status (open, merged, archived), fork revision, head revision and the number of commands a merge would replay; for a merged one the parent revision it landed at, for an archived sibling the branch whose merge superseded it. Read access to the design.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agentModel": {
    "description": "Optional current model name shown to design viewers; self-reported. Omit when unknown.",
    "maxLength": 80,
    "type": "string"
   },
   "agentName": {
    "description": "Optional agent/client name shown to design viewers; self-reported.",
    "maxLength": 80,
    "type": "string"
   },
   "designId": {
    "description": "The parent design.",
    "type": "string"
   },
   "status": {
    "description": "Only branches in this state. Defaults to all.",
    "enum": [
     "open",
     "merged",
     "archived",
     "all"
    ],
    "type": "string"
   },
   "token": {
    "description": "A grant token from poll_access, when you cannot set the X-Compose-Preview-Token header yourself \u2014 an MCP client fixes its headers at connect time, so this is how a token approved during this session is used in it. Prefer the header where you control it.",
    "type": "string"
   }
  },
  "required": [
   "designId"
  ],
  "type": "object"
 },
 "name": "ui_builder_list_branches",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "branches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "branchId": {
       "type": "string"
      },
      "closedAtEpochMillis": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "closedByActorId": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "commandCount": {
       "type": "integer"
      },
      "createdAtEpochMillis": {
       "type": "integer"
      },
      "forkDocumentHash": {
       "type": "string"
      },
      "forkRevision": {
       "type": "integer"
      },
      "headRevision": {
       "type": "integer"
      },
      "mergedAtParentRevision": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "ownerActorId": {
       "type": "string"
      },
      "parentDesignId": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      },
      "supersededByBranchId": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "branchId",
      "parentDesignId",
      "name",
      "ownerActorId",
      "status",
      "forkRevision",
      "forkDocumentHash",
      "headRevision",
      "commandCount",
      "createdAtEpochMillis",
      "summary"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "designId": {
    "type": "string"
   },
   "schema": {
    "const": "compose-preview/ui-builder-branches/v1",
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "schema",
   "designId",
   "status",
   "branches",
   "summary"
  ],
  "type": "object"
 }
}
