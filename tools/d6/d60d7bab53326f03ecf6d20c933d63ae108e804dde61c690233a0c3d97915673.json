    "items": {
     "additionalProperties": false,
     "properties": {
      "day": {
       "enum": [
        "M",
        "Tu",
        "W",
        "Th",
        "F",
        "Sa",
        "Su"
       ],
       "type": "string"
      },
      "end_time": {
       "description": "End time as printed, e.g. \"8:30AM\"",
