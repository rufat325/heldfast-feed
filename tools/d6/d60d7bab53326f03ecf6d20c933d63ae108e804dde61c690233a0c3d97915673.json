  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "day": {
    "description": "Only classes on this weekday (default: the whole week)",
    "enum": [
     "M",
     "Tu",
     "W",
     "Th",
     "F",
     "Sa",
     "Su"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "recwell_get_group_fitness_schedule",
 "outputSchema": {
