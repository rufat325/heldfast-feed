{
 "description": "Create an Open RPC image generation batch. Recommended flow: list_models(type=image) -> generate_image -> get_task_status using the returned batch_id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "default": 1,
    "description": "Number of images.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "custom_resolution": {
    "default": false,
    "description": "Use custom image resolution when the selected model supports it.",
    "type": "boolean"
   },
   "model": {
    "description": "Image model id or API model key.",
    "minLength": 1,
    "type": "string"
   },
   "output_format": {
    "description": "Image output format for supported models, for example png or webp.",
    "type": "string"
   },
   "prompt": {
    "description": "Image generation prompt.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "quality": {
    "description": "Image quality for supported models. GPT-Image 2 supports low, medium, high.",
    "type": "string"
   },
   "resolution": {
    "description": "Image resolution for supported models. GPT-Image 2 defaults to 1024x1024.",
    "type": "string"
   },
   "size": {
    "description": "Image size for supported models, for example 1024x1024.",
    "type": "string"
   }
  },
  "required": [
   "model",
   "prompt"
  ],
  "type": "object"
 },
 "name": "generate_image",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accepted_count": {
    "description": "Number of accepted items.",
    "type": "number"
   },
   "accepted_credits": {
    "description": "Credits accepted by the batch.",
    "type": "number"
   },
   "batch_id": {
    "description": "Open RPC batch ID for get_task_status.",
    "type": "string"
   },
   "batch_status": {
    "description": "Initial batch status.",
    "type": "string"
   },
   "estimated_failed_credits": {
    "description": "Estimated credits for rejected items.",
    "type": "number"
   },
   "failed_count": {
    "description": "Number of rejected items.",
    "type": "number"
   },
   "items": {
    "description": "Per-item batch acceptance details.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "accepted": {
       "type": "boolean"
      },
      "business_type": {
       "type": "number"
      },
      "code": {
       "anyOf": [
        {
         "type": [
          "number",
          "string"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "message": {
       "type": [
        "string",
        "null"
       ]
      },
      "need_credits": {
       "type": "number"
      },
      "serial_no": {
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "business_type",
      "accepted",
      "serial_no",
      "need_credits",
      "status",
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "description": "Human-readable next-step guidance.",
    "type": "string"
   },
   "success": {
    "const": true,
    "description": "Whether the batch request was accepted by Freebeat.",
    "type": "boolean"
   },
   "total_count": {
    "description": "Total number of submitted items.",
    "type": "number"
   }
  },
  "required": [
   "success",
   "batch_id",
   "batch_status",
   "total_count",
   "accepted_count",
   "failed_count",
   "accepted_credits",
   "estimated_failed_credits",
   "items",
   "message"
  ],
  "type": "object"
 }
}
