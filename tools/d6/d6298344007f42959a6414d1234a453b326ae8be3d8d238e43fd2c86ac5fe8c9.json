{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Edits an EXISTING stakeholder's identity (name, type, email, metadata) by id. FULL REPLACE; type is effectively immutable. To ADD a new stakeholder use CreateCapTableStakeholder; for an investor contributing capital use RecordCapTableInvestment.",
 "inputSchema": {
  "properties": {
   "stakeholder": {
    "properties": {
     "accessLevel": {
      "enum": [
       "CAP_TABLE_ACCESS_LEVEL_UNSPECIFIED",
       "CAP_TABLE_ACCESS_LEVEL_NONE",
       "CAP_TABLE_ACCESS_LEVEL_SUMMARY_ONLY",
       "CAP_TABLE_ACCESS_LEVEL_OWN_SECURITIES",
       "CAP_TABLE_ACCESS_LEVEL_FULL"
      ],
      "type": "string"
     },
     "address": {
      "maxLength": 300,
      "type": "string"
     },
     "companyId": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "createdAt": {
      "format": "date-time",
      "type": "string"
     },
     "email": {
      "maxLength": 320,
      "pattern": "^$|^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "type": "string"
     },
     "id": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "metadata": {
      "additionalProperties": true,
      "type": "object"
     },
     "name": {
      "description": "Human-readable name (1-255 Unicode chars).",
      "properties": {
       "value": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     "title": {
      "maxLength": 100,
      "type": "string"
     },
     "type": {
      "enum": [
       "CAP_TABLE_STAKEHOLDER_TYPE_FOUNDER",
       "CAP_TABLE_STAKEHOLDER_TYPE_INVESTOR",
       "CAP_TABLE_STAKEHOLDER_TYPE_EMPLOYEE",
       "CAP_TABLE_STAKEHOLDER_TYPE_ADVISOR",
       "CAP_TABLE_STAKEHOLDER_TYPE_ENTITY"
      ],
      "type": "string"
     },
     "updatedAt": {
      "format": "date-time",
      "type": "string"
     },
     "userId": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   }
  },
  "required": [
   "stakeholder"
  ],
  "type": "object"
 },
 "name": "cap_table_update_cap_table_stakeholder",
 "outputSchema": {
  "properties": {},
  "type": "object"
 },
 "title": "Update Cap Table Stakeholder"
}
