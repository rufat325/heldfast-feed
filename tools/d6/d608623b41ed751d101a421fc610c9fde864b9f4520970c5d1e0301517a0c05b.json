{
 "annotations": {
  "destructiveHint": true,
  "title": "Create task"
 },
 "description": "Create a new task. Copper REST: POST /tasks.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignee_id": {
    "description": "User id to own this task.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "details": {
    "description": "Freeform description / notes.",
    "type": "string"
   },
   "due_date": {
    "description": "Due date as a Unix timestamp (seconds).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "name": {
    "description": "The task name (required).",
    "type": "string"
   },
   "priority": {
    "description": "Task priority.",
    "enum": [
     "None",
     "High"
    ],
    "type": "string"
   },
   "related_resource_id": {
    "description": "Id of the record to attach the task to (requires related_resource_type).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "related_resource_type": {
    "description": "Type of record to attach the task to (requires related_resource_id).",
