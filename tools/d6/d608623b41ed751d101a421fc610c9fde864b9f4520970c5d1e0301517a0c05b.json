     "lead",
     "person",
     "company",
     "opportunity",
     "project",
     "task"
    ],
    "type": "string"
   },
   "reminder_date": {
    "description": "Reminder date as a Unix timestamp (seconds).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "tags": {
    "description": "Tags to apply.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "copper_create_task",
 "title": "Create task"
}
