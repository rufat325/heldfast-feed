{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List all Cloud DB for Cache (Redis/Valkey) instances in the current region",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudCacheDbmsCode": {
    "description": "Filter by DBMS type: Redis | Valkey",
    "enum": [
     "Redis",
     "Valkey"
    ],
    "type": "string"
   },
   "cloudCacheInstanceNoList": {
    "description": "Filter by Cache instance numbers",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "cloudCacheServerInstanceNoList": {
    "description": "Filter by Cache server instance numbers",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "cloudCacheServerName": {
    "description": "Filter by Cache server name",
    "type": "string"
   },
   "cloudCacheServiceName": {
    "description": "Filter by Cache service name",
    "type": "string"
   },
   "generationCode": {
    "description": "Filter by server generation: G2 | G3",
    "enum": [
     "G2",
     "G3"
    ],
    "type": "string"
   },
   "pageNo": {
    "description": "Page number (0-based). Requires pageSize",
    "minimum": 0,
    "type": "number"
   },
   "pageSize": {
    "description": "Page size (min 1). Required when pageNo is given",
    "minimum": 1,
    "type": "number"
   },
   "regionCode": {
    "description": "Region code (e.g., KR, JPN, SGN)",
    "type": "string"
   },
   "subnetNo": {
    "description": "Filter by subnet number",
    "type": "string"
   },
   "vpcNo": {
    "description": "Filter by VPC number",
    "type": "string"
   },
   "zoneCode": {
    "description": "Filter by zone code (e.g. KR-1, KR-2)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ncloud_list_cache_instances"
}
