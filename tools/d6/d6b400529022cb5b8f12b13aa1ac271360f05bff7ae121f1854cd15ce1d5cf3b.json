{
 "annotations": {
  "destructiveHint": true,
  "title": "Save an address record"
 },
 "description": "Create a reusable saved address record (does NOT send any mail). Returns an address id (adr_\u2026) usable as `to`/`from` in mail tools. Lob API: POST /v1/addresses.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address_city": {
    "type": "string"
   },
   "address_country": {
    "description": "2-letter ISO country code. Defaults to US.",
    "type": "string"
   },
   "address_line1": {
    "description": "Primary street address.",
    "type": "string"
   },
   "address_line2": {
    "description": "Unit/suite/apt.",
    "type": "string"
   },
   "address_state": {
    "description": "2-letter state/province code.",
    "type": "string"
   },
   "address_zip": {
    "description": "ZIP / postal code.",
    "type": "string"
   },
   "company": {
    "type": "string"
   },
   "description": {
    "description": "Internal label for this address.",
    "type": "string"
   },
   "name": {
    "description": "Recipient name (required unless `company` is set).",
    "type": "string"
   }
  },
  "required": [
   "address_line1"
  ],
  "type": "object"
 },
 "name": "lob_create_address",
 "title": "Save an address record"
}
