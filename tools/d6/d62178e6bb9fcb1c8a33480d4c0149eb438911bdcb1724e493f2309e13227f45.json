{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search experiments with filter and pagination",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "extractFields": {
    "description": "Comma-separated dotted paths with `*` wildcard (e.g. 'experiments.*.experiment_id'). Reduces response tokens.",
    "type": "string"
   },
   "filter": {
    "description": "Filter expression, e.g. \"name LIKE '%demo%'\"",
    "type": "string"
   },
   "maxResults": {
    "default": 100,
    "description": "Max results (default 100)",
    "type": "number"
   },
   "orderBy": {
    "description": "Sort fields, e.g. ['name ASC']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pageToken": {
    "description": "Pagination token",
    "type": "string"
   },
   "viewType": {
    "description": "Lifecycle stage filter",
    "enum": [
     "ACTIVE_ONLY",
     "DELETED_ONLY",
     "ALL"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search-experiments"
}
