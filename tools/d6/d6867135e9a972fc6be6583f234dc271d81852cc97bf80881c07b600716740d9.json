{
 "description": "Assemble page from structured components",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budget": {
    "additionalProperties": false,
    "properties": {
     "max_tokens": {
      "type": "number"
     }
    },
    "required": [
     "max_tokens"
    ],
    "type": "object"
   },
   "entity_annotations": {
    "description": "Optional CSS selector-to-entity mappings for consistency engine support",
    "items": {
     "additionalProperties": false,
     "properties": {
      "depends_on": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "entity_id": {
       "type": "string"
      },
      "selector": {
       "type": "string"
      }
     },
     "required": [
      "selector",
      "entity_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "compression": {
      "enum": [
       "none",
       "low",
       "high",
       "ai"
      ],
      "type": "string"
     },
     "css_vars": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "inject_css": {
      "type": "string"
     },
     "inject_js": {
      "type": "string"
     },
     "line_width": {
      "type": "number"
     },
     "mode": {
      "enum": [
       "normal",
       "stream"
      ],
      "type": "string"
     },
     "skip_format": {
      "type": "boolean"
     },
     "theme": {
      "enum": [
       "dark",
       "light"
      ],
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "output_path": {
    "description": "Absolute path for the output HTML file",
    "type": "string"
   },
   "sections": {
    "description": "Array of component sections to assemble",
    "items": {
     "additionalProperties": false,
     "properties": {
      "children": {
       "type": "array"
      },
      "component": {
       "type": "string"
      },
      "props": {
       "additionalProperties": {},
       "type": "object"
      }
     },
     "required": [
      "component"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "template": {
    "description": "Template name (report, exploration, deck, code-review, design, prototyping, illustrations, research, custom-editor, minimal, documentation, invoice, data-sheet, pitch-deck, dashboard, newsletter, changelog, faq, api-doc, landing-page, budget, meeting-notes, comparison, financial-summary, error-page)",
    "type": "string"
   }
  },
  "required": [
   "template",
   "sections",
   "output_path"
  ],
  "type": "object"
 },
 "name": "render_page"
}
