{
 "description": "List a channel's recent catalog in compact creator-analysis shape. [~3-10s]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channelIdOrHandleOrUrl": {
    "type": "string"
   },
   "dryRun": {
    "type": "boolean"
   },
   "includeLongForm": {
    "type": "boolean"
   },
   "includeShorts": {
    "type": "boolean"
   },
   "maxResults": {
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "publishedWithinDays": {
    "maximum": 3650,
    "minimum": 1,
    "type": "number"
   },
   "sortBy": {
    "enum": [
     "date_desc",
     "date_asc",
     "views_desc"
    ],
    "type": "string"
   }
  },
  "required": [
   "channelIdOrHandleOrUrl"
  ],
  "type": "object"
 },
 "name": "listChannelCatalog"
}
