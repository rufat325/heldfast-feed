{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List data partners"
 },
 "description": "List active marketplace partners (sellers) and what each offers. Each partner has zero or more 'modes': `indexed` (free queries via partner_search against published documents) and/or `proxy` (queries routed server-to-server to the seller's own API via partner_proxy_search, consuming prepaid Aether credits per call). Use the returned per-call credit costs to budget calls before invoking partner_proxy_search.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 50,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "default": "any",
    "description": "Restrict to partners offering this mode.",
    "enum": [
     "indexed",
     "proxy",
     "any"
    ],
    "type": "string"
   },
   "ticker": {
    "description": "Optional \u2014 filter to partners that cover this ticker (either in indexed docs or proxy endpoints).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_partners",
 "outputSchema": {
  "properties": {
   "partners": {
    "items": {
     "properties": {
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "indexed": {
       "properties": {
        "doc_count": {
         "type": "integer"
        },
        "ticker_coverage_sample": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "doc_count",
        "ticker_coverage_sample"
       ],
       "type": "object"
      },
      "modes": {
       "items": {
        "enum": [
         "indexed",
         "proxy"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "org_name": {
       "type": "string"
      },
      "proxy_endpoints": {
       "items": {
        "properties": {
         "description": {
          "type": [
           "string",
           "null"
          ]
         },
         "display_name": {
          "type": "string"
         },
         "endpoint_slug": {
          "type": "string"
         },
         "monthly_request_cap": {
          "type": [
           "integer",
           "null"
          ]
         },
         "price_per_call_usd_cents": {
          "type": "integer"
         },
         "pricing_model": {
          "enum": [
           "free",
           "per_call",
           "subscription"
          ],
          "type": "string"
         },
         "taxonomy_tags": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "ticker_coverage": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "endpoint_slug",
         "display_name",
         "pricing_model"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "slug": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "org_name",
      "indexed",
      "proxy_endpoints",
      "modes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "integer"
   }
  },
  "required": [
   "partners",
   "total"
  ],
  "type": "object"
 },
 "x_aether_auth": {
  "kind": "anonymous_exception",
  "reason": "read-only marketplace discovery: partner names, modes, and prices only; no search results or charges"
 }
}
