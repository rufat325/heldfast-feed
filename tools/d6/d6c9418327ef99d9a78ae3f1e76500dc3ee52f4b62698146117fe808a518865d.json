{
 "description": "Create a unique task nonce and EIP-712 authorization signed by the dedicated farming wallet.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "client": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "model": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "taskHash": {
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "provider",
   "model",
   "taskHash",
   "client"
  ],
  "type": "object"
 },
 "name": "begin_ai_task"
}
