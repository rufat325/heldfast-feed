{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a reservation"
 },
 "description": "Change fields on an existing reservation \u2014 guest details and counts, dates, check-in/out hours, door code, host note or comment. Send only the fields to change. The listing cannot be changed, and this tool never cancels or reprices a booking. Date changes on channel bookings may be overwritten by the channel. Hostaway: PUT /v1/reservations/{reservationId}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "adults": {
    "description": "Adults.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "arrivalDate": {
    "description": "New arrival date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "checkInTime": {
    "description": "Check-in time (hour of day, 0-23).",
    "maximum": 23,
    "minimum": 0,
    "type": "integer"
   },
   "checkOutTime": {
    "description": "Check-out time (hour of day, 0-23).",
    "maximum": 23,
    "minimum": 0,
    "type": "integer"
   },
   "children": {
    "description": "Children.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "comment": {
    "description": "Free-text comment.",
    "type": "string"
   },
   "departureDate": {
    "description": "New departure date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "doorCode": {
    "description": "Door / lock code for this stay.",
    "type": "string"
   },
   "doorCodeInstruction": {
    "description": "Door-code instructions.",
    "type": "string"
   },
   "doorCodeVendor": {
    "description": "Lock vendor.",
    "type": "string"
   },
   "guestAddress": {
    "description": "Guest street address.",
    "type": "string"
   },
   "guestCity": {
    "description": "Guest city.",
    "type": "string"
   },
   "guestCountry": {
    "description": "Guest country (ISO 3166 code, e.g. US).",
    "type": "string"
   },
   "guestEmail": {
    "description": "Guest email.",
    "type": "string"
   },
   "guestFirstName": {
    "description": "Guest first name.",
    "type": "string"
   },
   "guestLastName": {
    "description": "Guest last name.",
    "type": "string"
   },
   "guestName": {
    "description": "Guest full name.",
    "type": "string"
   },
   "guestNote": {
    "description": "Note from the guest.",
    "type": "string"
   },
   "guestZipCode": {
    "description": "Guest ZIP / postal code.",
    "type": "string"
   },
   "hostNote": {
    "description": "Internal host note (not shown to the guest).",
    "type": "string"
   },
   "infants": {
    "description": "Infants.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "numberOfGuests": {
    "description": "Total number of guests.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "pets": {
    "description": "Pets.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "phone": {
    "description": "Guest phone, e.g. +15125551212.",
    "type": "string"
   },
   "reservationId": {
    "description": "Hostaway reservation id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "reservationId"
  ],
  "type": "object"
 },
 "name": "hostaway_update_reservation",
 "title": "Update a reservation"
}
