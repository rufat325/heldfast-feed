{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/agents.tool-name-conflicts",
  "agent-utilities/priceMicroUsd": 300
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Find duplicate or easily confused tool names after Unicode, case and separator normalization. PAID: 300 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "names": {
      "items": {
       "maxLength": 200,
       "type": "string"
      },
      "maxItems": 200,
      "type": "array"
     }
    },
    "required": [
     "names"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "agents_tool_name_conflicts",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "conflicts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "items": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "index": {
          "type": "number"
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "index"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "kind": {
       "type": "string"
      },
      "normalized": {
       "type": "string"
      }
     },
     "required": [
      "normalized",
      "kind",
      "items"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scope": {
    "type": "string"
   }
  },
  "required": [
   "conflicts",
   "scope"
  ],
  "type": "object"
 }
}
