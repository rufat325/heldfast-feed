{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search for tags, optionally filtered by collection or tag name.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "attributes": {
    "description": "Attributes filter",
    "type": "string"
   },
   "caseSensitive": {
    "description": "Case sensitive search (default false)",
    "type": "boolean"
   },
   "collId": {
    "description": "Limit search to a specific collection ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "exactMatch": {
    "description": "Require exact match (default true)",
    "type": "boolean"
   },
   "id": {
    "description": "Document ID",
    "type": "string"
   },
   "legacy": {
    "description": "Use legacy search (default false)",
    "type": "boolean"
   },
   "pageId": {
    "description": "Page ID",
    "type": "string"
   },
   "regionType": {
    "description": "Region type (default \"Line\")",
    "type": "string"
   },
   "rows": {
    "description": "Number of results (default 20000)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "start": {
    "description": "Start offset (default 0)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "tagName": {
    "description": "Filter by tag name",
    "type": "string"
   },
   "tagValue": {
    "description": "Filter by tag value",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "transkribus_search_tags",
 "title": "Search Tags"
}
