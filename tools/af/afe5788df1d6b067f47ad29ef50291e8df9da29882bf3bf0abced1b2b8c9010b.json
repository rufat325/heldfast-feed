{
 "description": "Converts CSV text to JSON: header=true (default) returns one object per data row keyed by the header row; header=false returns raw rows. Every value is a string.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "delimiter": {
    "type": "string"
   },
   "header": {
    "description": "default true",
    "type": "boolean"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "csv_to_json",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": true
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
