{
 "description": "AI-powered content discovery. Costs 100 credits. Handles polling internally (30-60s).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "depth": {
    "description": "Research depth (default: standard)",
    "enum": [
     "quick",
     "standard",
     "deep"
    ],
    "type": "string"
   },
   "minViews": {
    "description": "Minimum views filter",
    "enum": [
     "any",
     "10k",
     "25k",
     "50k",
     "100k"
    ],
    "type": "string"
   },
   "platform": {
    "description": "Target platform (default: tiktok)",
    "enum": [
     "tiktok",
     "youtube",
     "insta"
    ],
    "type": "string"
   },
   "query": {
    "description": "Describe the content you want to find. Be specific.",
    "type": "string"
   },
   "timeframe": {
    "description": "Time period filter",
    "enum": [
     "any",
     "today",
     "week",
     "last month",
     "year"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_content"
}
