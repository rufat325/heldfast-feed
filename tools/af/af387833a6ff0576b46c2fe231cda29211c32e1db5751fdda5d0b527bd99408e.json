{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Read at most 4,096 analyzed bytes from one provider-normalized virtual address. The hexadecimal payload reports the exact returned length; incomplete reads remain explicit and unsupported provider APIs return typed capability unavailability.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "address": "0x1000",
    "length": 16
   }
  ],
  "properties": {
   "address": {
    "description": "A provider-normalized address; default memory uses 0x-prefixed hexadecimal",
    "type": "string"
   },
   "document": {
    "description": "The document name",
    "type": "string"
   },
   "length": {
    "default": 256,
    "description": "Value for length.",
    "maximum": 4096,
    "minimum": 1,
    "type": "integer"
   },
   "unknown_registry_approved": {
    "const": true,
    "description": "Explicit approval to record typed capability unavailability as a residual unknown",
    "type": "boolean"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "read_bytes",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "address": {
      "type": "string"
     },
     "bytes_hex": {
      "pattern": "^(?:[a-f0-9]{2})*$",
      "type": "string"
     },
     "complete": {
      "type": "boolean"
     },
     "requested_bytes": {
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
     },
     "returned_bytes": {
      "maximum": 4096,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "address",
     "requested_bytes",
     "returned_bytes",
     "bytes_hex",
     "complete"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Read Bytes"
}
