{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Change lifetime (running duration) for a Data Forest app",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "App unique identifier (Base62-encoded UUID)",
    "maxLength": 22,
    "type": "string"
   },
   "lifetime": {
    "description": "New lifetime in seconds (300-604800)",
    "maximum": 604800,
    "minimum": 300,
    "type": "number"
   }
  },
  "required": [
   "id",
   "lifetime"
  ],
  "type": "object"
 },
 "name": "ncloud_dataforest_set_lifetime"
}
