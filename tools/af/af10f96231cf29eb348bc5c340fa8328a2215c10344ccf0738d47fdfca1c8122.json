{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Run a proposed autonomous AI action through Causara's frozen Shadow Mode economic-control engine. Returns downstream dependency path, economic exposure, potential loss, confidence, and an ALLOW/REVIEW/ESCALATE/BLOCK recommendation. Causara does not execute or block the proposed business action. The evaluation is recorded in Causara's Shadow risk ledger.",
 "inputSchema": {
  "properties": {
   "business_context": {
    "properties": {
     "commercial": {
      "properties": {
       "affectedOrderValue": {
        "minimum": 0,
        "type": "number"
       },
       "contractBase": {
        "minimum": 0,
        "type": "number"
       },
       "orderRiskHigh": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       "orderRiskLow": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       "revenueBase": {
        "minimum": 0,
        "type": "number"
       },
       "revenueRiskHigh": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       "revenueRiskLow": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       "slaRiskHigh": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       "slaRiskLow": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       }
      },
      "required": [
       "affectedOrderValue",
       "orderRiskLow",
       "orderRiskHigh",
       "contractBase",
       "slaRiskLow",
       "slaRiskHigh",
       "revenueBase",
       "revenueRiskLow",
       "revenueRiskHigh"
      ],
      "type": "object"
     },
     "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "inventory": {
      "properties": {
       "emergencyPremium": {
        "minimum": 0,
        "type": "number"
       },
       "emergencyUnitCost": {
        "minimum": 0,
        "type": "number"
       },
       "shortfallUnits": {
        "minimum": 0,
        "type": "number"
       }
      },
      "required": [
       "shortfallUnits",
       "emergencyUnitCost",
       "emergencyPremium"
      ],
      "type": "object"
     },
     "policy": {
      "properties": {
       "allowBelow": {
        "minimum": 0,
        "type": "number"
       },
       "blockAt": {
        "minimum": 0,
        "type": "number"
       },
       "reviewMax": {
        "minimum": 0,
        "type": "number"
       }
      },
      "required": [
       "allowBelow",
       "reviewMax",
       "blockAt"
      ],
      "type": "object"
     },
     "production": {
      "properties": {
       "downtimeHighHours": {
        "minimum": 0,
        "type": "number"
       },
       "downtimeLowHours": {
        "minimum": 0,
        "type": "number"
       },
       "lineValuePerHour": {
        "minimum": 0,
        "type": "number"
       },
       "scheduleRecoveryHigh": {
        "minimum": 0,
        "type": "number"
       },
       "scheduleRecoveryLow": {
        "minimum": 0,
        "type": "number"
       }
      },
      "required": [
       "downtimeLowHours",
       "downtimeHighHours",
       "lineValuePerHour",
       "scheduleRecoveryLow",
       "scheduleRecoveryHigh"
      ],
      "type": "object"
     },
     "realizationHigh": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "realizationLow": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "inventory",
     "production",
     "commercial",
     "realizationLow",
     "realizationHigh",
     "confidence",
     "policy"
    ],
    "type": "object"
   },
   "data_source": {
    "properties": {
     "access_control_status": {
      "type": "string"
     },
     "filename": {
      "type": "string"
     },
     "source_snapshot_at": {
      "type": "string"
     },
     "source_system": {
      "type": "string"
     },
     "type": {
      "default": "mcp",
      "type": "string"
     }
    },
    "type": "object"
   },
   "event": {
    "properties": {
     "action": {
      "minLength": 1,
      "type": "string"
     },
     "action_type": {
      "enum": [
       "supplier_substitution",
       "production_schedule_change",
       "customer_order_prioritization",
       "inventory_reallocation"
      ],
      "type": "string"
     },
     "agent": {
      "minLength": 1,
      "type": "string"
     },
     "component": {
      "type": "string"
     },
     "direct_transaction_value": {
      "minimum": 0,
      "type": "number"
     },
     "event_id": {
      "minLength": 1,
      "type": "string"
     },
     "from_supplier": {
      "type": "string"
     },
     "timestamp": {
      "minLength": 1,
      "type": "string"
     },
     "to_supplier": {
      "type": "string"
     }
    },
    "required": [
     "event_id",
     "timestamp",
     "agent",
     "action_type",
     "action",
     "direct_transaction_value"
    ],
    "type": "object"
   }
  },
  "required": [
   "event",
   "business_context"
  ],
  "type": "object"
 },
 "name": "evaluate_agent_action",
 "title": "Evaluate agent economic exposure"
}
