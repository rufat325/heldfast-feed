{
 "description": "The type TypeScript infers for a named variable, function, parameter, property, or type. Use before writing an annotation, when unsure what a generic or call resolves to, or instead of reading .d.ts files.",
 "inputSchema": {
  "properties": {
   "backend": {
    "description": "Default typescript7; retry with typescript6 if it fails or looks wrong",
    "enum": [
     "typescript6",
     "typescript7"
    ]
   },
   "file": {
    "description": "TS/JS file: absolute, or relative to the server's cwd",
    "type": "string"
   },
   "full": {
    "description": "Untruncated types (no \"... 12 more ...\"), all overloads",
    "type": "boolean"
   },
   "include_cost": {
    "description": "Count type instantiations; typescript6 only",
    "type": "boolean"
   },
   "include_docs": {
    "description": "Also return JSDoc/TSDoc",
    "type": "boolean"
   },
   "line": {
    "description": "1-based line, to pick among repeated names",
    "minimum": 1,
    "type": "integer"
   },
   "max_chars": {
    "description": "Text cap per type (default 4000 chars; 0: none)",
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "description": "Symbol name, e.g. \"createHandler\"",
    "minLength": 1,
    "type": "string"
   },
   "project": {
    "description": "tsconfig.json; default: the nearest one above file",
    "type": "string"
   }
  },
  "required": [
   "file",
   "name"
  ],
  "type": "object"
 },
 "name": "hover_by_name",
 "outputSchema": {
  "properties": {
   "error": {
    "properties": {
     "candidates": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "code": {
      "enum": [
       "INVALID_ARGUMENT",
       "FILE_NOT_FOUND",
       "SYMBOL_NOT_FOUND",
       "TYPESCRIPT_ERROR",
       "INTERNAL_ERROR"
      ]
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "result": {
    "properties": {
     "alternatives": {
      "items": {
       "properties": {
        "column": {
         "type": "number"
        },
        "kind": {
         "type": "string"
        },
        "line": {
         "type": "number"
        }
       },
       "required": [
        "line",
        "column"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "column": {
      "type": "number"
     },
     "cost": {
      "properties": {
       "instantiations": {
        "type": "number"
       },
       "types": {
        "type": "number"
       }
      },
      "required": [
       "instantiations",
       "types"
      ],
      "type": "object"
     },
     "display": {
      "type": "string"
     },
     "documentation": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "line": {
      "type": "number"
     },
     "name": {
      "type": "string"
     },
     "overloads": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "position": {
      "properties": {
       "column": {
        "type": "number"
       },
       "line": {
        "type": "number"
       }
      },
      "required": [
       "line",
       "column"
      ],
      "type": "object"
     },
     "returnType": {
      "type": "string"
     },
     "signature": {
      "type": "string"
     },
     "unionMembers": {
      "type": "number"
     }
    },
    "required": [
     "signature",
     "line",
     "column",
     "kind"
    ],
    "type": "object"
   },
   "version": {
    "const": 1
   }
  },
  "required": [
   "version",
   "ok"
  ],
  "type": "object"
 }
}
