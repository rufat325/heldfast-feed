{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search ClinicalTrials.gov for clinical trials. Filter by condition, intervention, status, and phase. Returns trial summaries with NCT IDs, status, sponsors, and enrollment info.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "condition": {
    "description": "Disease or condition (e.g., 'breast cancer', 'diabetes')",
    "type": "string"
   },
   "intervention": {
    "description": "Drug or therapy (e.g., 'pembrolizumab', 'radiation')",
    "type": "string"
   },
   "maxResults": {
    "default": 10,
    "description": "Maximum number of results (1-100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "phase": {
    "description": "Trial phase filter",
    "enum": [
     "EARLY_PHASE1",
     "PHASE1",
     "PHASE2",
     "PHASE3",
     "PHASE4",
     "NA"
    ],
    "type": "string"
   },
   "sort": {
    "default": "relevance",
    "description": "Sort order for results",
    "enum": [
     "relevance",
     "last_updated",
     "start_date",
     "enrollment"
    ],
    "type": "string"
   },
   "status": {
    "description": "Trial recruitment status filter",
    "enum": [
     "RECRUITING",
     "COMPLETED",
     "ACTIVE_NOT_RECRUITING",
     "NOT_YET_RECRUITING",
     "TERMINATED",
     "WITHDRAWN",
     "SUSPENDED"
    ],
    "type": "string"
   },
   "term": {
    "description": "General search term (searches all fields)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_trials"
}
