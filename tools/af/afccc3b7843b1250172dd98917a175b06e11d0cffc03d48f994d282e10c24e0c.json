{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List supplier bills (expenses) in Billy with filters for supplier, state, paid status, date range and free-text search.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contactId": {
    "description": "Filter by supplier contact ID",
    "type": "string"
   },
   "isPaid": {
    "description": "Filter by paid status",
    "type": "boolean"
   },
   "maxDueDate": {
    "description": "Due date <= this (YYYY-MM-DD)",
    "type": "string"
   },
   "maxEntryDate": {
    "description": "Bill date <= this (YYYY-MM-DD)",
    "type": "string"
   },
   "minDueDate": {
    "description": "Due date >= this (YYYY-MM-DD)",
    "type": "string"
   },
   "minEntryDate": {
    "description": "Bill date >= this (YYYY-MM-DD)",
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Records per page (max 1000, default 50)",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Free-text search (contact name, description, voucher no, amount)",
    "type": "string"
   },
   "sortDirection": {
    "description": "Sort direction",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "sortProperty": {
    "description": "Sort field: entryDate, dueDate, createdTime, amount, balance, contact.name, voucherNo",
    "type": "string"
   },
   "state": {
    "description": "Filter by bill state",
    "enum": [
     "draft",
     "approved",
     "voided"
    ],
    "type": "string"
   },
   "suppliersInvoiceNo": {
    "description": "Filter by the supplier's invoice number",
    "type": "string"
   },
   "verbose": {
    "description": "Return the full Billy response. Default false: compact records with key fields only (saves ~90% context)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_bills"
}
