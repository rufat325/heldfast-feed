  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "email": {
    "description": "Filter by email (contains match).",
    "type": "string"
   },
   "first_name": {
    "description": "Filter by first name (contains match).",
    "type": "string"
   },
   "last_name": {
    "description": "Filter by last name (contains match).",
    "type": "string"
   },
   "order": {
    "description": "Sort direction. asc | desc.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based). Default 1.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "per_page": {
    "description": "Results per page (max 100). Default 50.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "sort": {
    "description": "Field to sort by, e.g. created_at.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "cliniko_list_patients",
