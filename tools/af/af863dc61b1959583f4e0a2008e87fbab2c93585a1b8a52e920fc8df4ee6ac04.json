{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "\u3010\u9700\u8981\u767b\u5f55\u3011\u3010\u5bf9\u5916\u53d1\u5e03\u3011\u5148 preview=true\uff0c\u5411\u7528\u6237\u9010\u9879\u5c55\u793a\u6d3b\u52a8\u5168\u6587\u3001\u65f6\u95f4\u3001\u5730\u70b9\u3001\u95ed\u95e8\u53d7\u4f17\u4e0e\u53d7\u9080\u540d\u5355\uff1b\u7528\u6237\u786e\u8ba4\u540e\u5e26 previewHash \u548c\u540c\u4e00\u4efd activity/signup/excludeUserIds\uff0cpreview=false \u53d1\u5e03\u3002activity \u590d\u7528\u6b63\u5f0f\u6d3b\u52a8 schema\uff0c\u7ebf\u4e0b\u5fc5\u987b\u6709\u5730\u70b9\uff1bsignup \u4ec5\u6258\u7ba1\u62a5\u540d\uff0c\u9ed8\u8ba4\u5e73\u53f0\u8868\u5355\u3002\u53d7\u9080\u4eba\u91cd\u65b0\u4ece\u5f53\u524d\u53ef\u89c1\u63d0\u6848\u53d6\uff0c\u4e0d\u80fd\u6ce8\u5165\u522b\u7684\u4eba\uff1b\u4e91\u7528\u6237\u53d1\u5e03\u540e\u53e6\u9080\u3002\u9ed8\u8ba4\u4e0d\u63a8\u9001\uff0cnotifyInvitees=true \u624d\u901a\u77e5\u771f\u4eba\u3002\u53d1\u5e03\u65f6\u540c\u4e8b\u52a1\u628a\u63d0\u6848\u8bb0\u4e3a CONVERTED \u5e76\u5173\u8054\u6d3b\u52a8\uff0c\u4e0d\u80fd\u7528\u901a\u7528\u8349\u7a3f\u53d1\u5e03\u4ee3\u66ff\u3002\u5df2\u8f6c\u6362\u7684\u63d0\u6848\u8fd4\u56de\u73b0\u6709\u6d3b\u52a8\uff0c\u907f\u514d\u518d\u6b21\u521b\u5efa\uff1b\u4efb\u4f55\u9884\u89c8\u53d8\u5316\u90fd\u8981\u518d\u786e\u8ba4\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activity": {
    "additionalProperties": false,
    "properties": {
     "arrivalGuide": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "additionalProperties": false,
          "properties": {
           "images": {
            "items": {
             "$ref": "#/properties/activity/properties/posterUrls/items"
            },
            "maxItems": 9,
            "type": "array"
           },
           "note": {
            "maxLength": 2000,
            "type": "string"
           },
           "videoUrl": {
            "format": "uri",
            "maxLength": 2000,
            "type": "string"
           }
          },
          "type": "object"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "capacity": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "type": "integer"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "city": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "maxLength": 20,
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "coverUrl": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "format": "uri",
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "description": {
      "maxLength": 20000,
      "minLength": 1,
      "type": "string"
     },
     "endAt": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "format": "date-time",
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "location": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "maxLength": 200,
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "meetUrl": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "format": "uri",
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "memberMatchingEnabled": {
      "type": "boolean"
     },
     "organizerName": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "maxLength": 120,
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "posterUrls": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "h": {
         "default": 0,
         "maximum": 200000,
         "minimum": 0,
         "type": "integer"
        },
        "name": {
         "maxLength": 80,
         "type": "string"
        },
        "url": {
         "format": "uri",
         "type": "string"
        },
        "w": {
         "default": 0,
         "maximum": 20000,
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "url"
       ],
       "type": "object"
      },
      "maxItems": 9,
      "type": "array"
     },
     "productId": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "registrationDeadline": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "format": "date-time",
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "seriesId": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "seriesOrder": {
      "anyOf": [
       {
        "anyOf": [
         {
          "not": {}
         },
         {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "type": "integer"
         }
        ]
       },
       {
        "type": "null"
       }
      ]
     },
     "slug": {
      "maxLength": 80,
      "minLength": 2,
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "type": "string"
     },
     "startAt": {
      "format": "date-time",
      "type": "string"
     },
     "title": {
      "maxLength": 80,
      "minLength": 2,
      "type": "string"
     },
     "type": {
      "enum": [
       "BETA_RECRUIT",
       "ONLINE_GATHERING",
       "OFFLINE_GATHERING",
       "COMPETITION",
       "OTHER"
      ],
      "type": "string"
     }
    },
    "required": [
     "title",
     "type",
     "description",
     "startAt"
    ],
    "type": "object"
   },
   "appActivation": {
    "enum": [
     "required",
     "none"
    ],
    "type": "string"
   },
   "excludeUserIds": {
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "notifyInvitees": {
    "default": false,
    "type": "boolean"
   },
   "organizationId": {
    "description": "\u7ec4\u7ec7\u6216\u8054\u76df\u7a7a\u95f4\u7684\u7ec4\u7ec7 id",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "preview": {
    "default": true,
    "description": "\u9ed8\u8ba4 true \u4ec5\u9884\u89c8\uff1b\u7528\u6237\u786e\u8ba4\u540e\u624d\u4f20 false \u6267\u884c",
    "type": "boolean"
   },
   "previewHash": {
    "description": "\u6267\u884c\u65f6\u5fc5\u987b\u4f20\u6700\u65b0\u9884\u89c8\u7684 previewHash\uff1b\u53c2\u4e0e\u4eba\u6216\u5185\u5bb9\u6709\u53d8\u5316\u4f1a\u8981\u6c42\u91cd\u65b0\u786e\u8ba4",
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "proposalId": {
    "description": "list_organization_proposals \u8fd4\u56de\u7684\u63d0\u6848 id",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "signup": {
    "additionalProperties": false,
    "properties": {
     "contactNote": {
      "anyOf": [
       {
        "maxLength": 120,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "contactQrUrl": {
      "anyOf": [
       {
        "format": "uri",
        "maxLength": 2000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "formSchema": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "hint": {
         "maxLength": 200,
         "type": "string"
        },
        "key": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "label": {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        "options": {
         "default": [],
         "items": {
          "maxLength": 120,
          "type": "string"
         },
         "maxItems": 50,
         "type": "array"
        },
        "profileMap": {
         "anyOf": [
          {
           "maxLength": 64,
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null
        },
        "required": {
         "default": false,
         "type": "boolean"
        },
        "sensitive": {
         "type": "boolean"
        },
        "showIf": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "equals": {
             "items": {
              "maxLength": 120,
              "type": "string"
             },
             "maxItems": 20,
             "minItems": 1,
             "type": "array"
            },
            "key": {
             "maxLength": 64,
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "key",
            "equals"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "sourceLabel": {
         "maxLength": 200,
         "type": "string"
        },
        "type": {
         "default": "text",
         "enum": [
          "text",
          "textarea",
          "select",
          "multiselect",
          "phone",
          "email",
          "url",
          "number",
          "date",
          "file"
         ],
         "type": "string"
        }
       },
       "required": [
        "key",
        "label"
       ],
       "type": "object"
      },
      "maxItems": 80,
      "type": "array"
     },
     "kind": {
      "enum": [
       "HACKATHON",
       "COMPETITION",
       "INCUBATOR",
       "FUNDING",
       "COMMUNITY",
       "EVENT",
       "OTHER"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "organizationId",
   "proposalId",
   "activity"
  ],
  "type": "object"
 },
 "name": "create_organization_proposal_activity",
 "title": "\u786e\u8ba4\u540e\u53d1\u5e03\u7ec4\u7ec7\u63d0\u6848\u6d3b\u52a8"
}
