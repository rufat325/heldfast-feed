{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Premium decisions ($3) for up to 5 symbols in one call, computed in parallel: each full decision (action, conviction, pillars, trade plan, module status) plus a ranking from most bullish to most bearish.",
 "inputSchema": {
  "properties": {
   "format": {
    "default": "detailed",
    "enum": [
     "detailed",
     "compact"
    ],
    "type": "string"
   },
   "include": {
    "description": "Optional: modules to use (default all)",
    "items": {
     "enum": [
      "order_flow",
      "technicals",
      "smart_money",
      "fundamentals",
      "insiders",
      "derivatives_positioning",
      "market_risk",
      "news",
      "execution",
      "track_record"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "side": {
    "description": "Optional: answers GO / GO_SMALL / WAIT / NO_GO for this side",
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "symbols": {
    "description": "Crypto pairs (ETHUSD), US tickers (NVDA) or ISINs",
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "symbols"
  ],
  "type": "object"
 },
 "name": "get_decisions_batch"
}
