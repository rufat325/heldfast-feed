    "description": "1 = only projects where you are a manager."
   },
   "limit": {
    "description": "Max rows (max 500, default 25).",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "offset": {
    "description": "Rows to skip (default 0).",
    "maximum": 9007199254740991,
    "minimum": 0,
