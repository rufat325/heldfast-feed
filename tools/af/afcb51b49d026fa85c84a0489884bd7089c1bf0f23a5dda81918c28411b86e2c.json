{
 "description": "Create a Pix due charge (cobranca com vencimento). If txid omitted, server-generated.",
 "inputSchema": {
  "properties": {
   "calendario": {
    "description": "Calendar settings",
    "properties": {
     "dataDeVencimento": {
      "description": "Due date (YYYY-MM-DD)",
      "type": "string"
     },
     "validadeAposVencimento": {
      "description": "Days valid after due date",
      "type": "number"
     }
    },
    "required": [
     "dataDeVencimento"
    ],
    "type": "object"
   },
   "chave": {
    "description": "Pix key of the receiver",
    "type": "string"
   },
   "devedor": {
    "description": "Debtor info (CPF or CNPJ required)",
    "properties": {
     "cnpj": {
      "description": "Debtor CNPJ",
      "type": "string"
     },
     "cpf": {
      "description": "Debtor CPF",
      "type": "string"
     },
     "nome": {
      "description": "Debtor name",
      "type": "string"
     }
    },
    "required": [
     "nome"
    ],
    "type": "object"
   },
   "solicitacaoPagador": {
    "description": "Message to payer",
    "type": "string"
   },
   "txid": {
    "description": "Transaction ID (26-35 chars). If provided, PUT is used.",
    "type": "string"
   },
   "valor": {
    "description": "Charge value with optional juros/multa/desconto",
    "properties": {
     "original": {
      "description": "Amount as string (e.g. '100.00')",
      "type": "string"
     }
    },
    "required": [
     "original"
    ],
    "type": "object"
   }
  },
  "required": [
   "calendario",
   "valor",
   "chave",
   "devedor"
  ],
  "type": "object"
 },
 "name": "create_cobv"
}
