{
 "description": "Build stable AI visibility prompt sets mapped to owned assets, platforms, competitors, citations, and weekly action routing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "maxLength": 180,
    "type": "string"
   },
   "cadence": {
    "default": "weekly",
    "enum": [
     "weekly",
     "biweekly",
     "monthly"
    ],
    "type": "string"
   },
   "category": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "competitors": {
    "default": [],
    "items": {
     "maxLength": 160,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "include_citation_checks": {
    "default": true,
    "type": "boolean"
   },
   "include_competitor_checks": {
    "default": true,
    "type": "boolean"
   },
   "locale": {
    "default": "United States",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   },
   "owned_assets": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "page_type": {
       "default": "other",
       "enum": [
        "homepage",
        "docs",
        "blog_post",
        "comparison",
        "pricing",
        "product",
        "case_study",
        "tool",
        "other"
       ],
       "type": "string"
      },
      "title": {
       "maxLength": 180,
       "minLength": 1,
       "type": "string"
      },
      "topics": {
       "default": [],
       "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 20,
       "type": "array"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url",
      "title"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "personas": {
    "default": [],
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "platforms": {
    "default": [
     "chatgpt",
     "perplexity",
     "google_ai"
    ],
    "items": {
     "enum": [
      "chatgpt",
      "perplexity",
      "google_ai",
      "gemini",
      "copilot",
      "claude"
     ],
     "type": "string"
    },
    "maxItems": 6,
    "minItems": 1,
    "type": "array"
   },
   "product_terms": {
    "default": [],
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 40,
    "type": "array"
   },
   "prompt_count": {
    "default": 20,
    "maximum": 50,
    "minimum": 6,
    "type": "integer"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "minLength": 1,
    "type": "string"
   },
   "topics": {
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 40,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "target",
   "category",
   "topics"
  ],
  "type": "object"
 },
 "name": "agentseo_ai_visibility_prompt_set",
 "title": "AgentSEO AI Visibility Prompt Set"
}
