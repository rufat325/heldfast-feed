{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List catalog items available in SolarWinds Service Desk. Each item represents an offerable service request template (e.g., \"New Employee Onboarding\", \"Software Request\") with a defined set of input variables (form fields). Use swsd_get_catalog_item to inspect a single item's variables, then swsd_create_service_request to submit a request.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "department": {
    "description": "Filter by department name.",
    "maxLength": 500,
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number (1-indexed).",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "default": 25,
    "description": "Results per page (1-100). SWSD caps at 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free-text search across catalog item names + descriptions (maps to the SWSD `name` query param).",
    "maxLength": 2000,
    "type": "string"
   },
   "site": {
    "description": "Filter by site name.",
    "maxLength": 500,
    "type": "string"
   },
   "state": {
    "description": "Filter by state (\"Approved\", \"Internal\", or \"Draft\").",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "swsd_list_catalog_items",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applied_filters": {
    "additionalProperties": {},
    "description": "Echo of the filters applied to this query \u2014 empty object if none. Use this to reason about whether the result count reflects your filters or the tenant total.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "department": {
       "type": "string"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "request_count": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "site": {
       "type": "string"
      },
      "state": {
       "type": "string"
      },
      "subcategory": {
       "type": "string"
      },
      "updated_at": {
       "type": "string"
      },
      "variable_count": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pagination": {
    "additionalProperties": false,
    "properties": {
     "has_more": {
      "description": "True when more pages exist beyond this one.",
      "type": "boolean"
     },
     "next_page": {
      "description": "The next page number to request, when has_more is true.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "page": {
      "description": "Current page (1-indexed).",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "per_page": {
      "description": "Items per page used in the request.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total": {
      "description": "Total record count when SWSD returns X-Total-Count.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total_scope": {
      "description": "Whether `total` reflects the filtered-set size, the tenant-wide size, or is unknown. 'filtered' = filter was applied AND total is present; 'tenant' = no filter AND total is present; 'unknown' = total absent.",
      "enum": [
       "filtered",
       "tenant",
       "unknown"
      ],
      "type": "string"
     }
    },
    "required": [
     "page",
     "per_page",
     "has_more",
     "total_scope"
    ],
    "type": "object"
   }
  },
  "required": [
   "items",
   "pagination",
   "applied_filters"
  ],
  "type": "object"
 }
}
