{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get transaction feed items for an account category. Use the default category UID for main account transactions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountUid": {
    "description": "The account UID",
    "type": "string"
   },
   "categoryUid": {
    "description": "The category UID (use default category for main account)",
    "type": "string"
   },
   "maxTransactionTimestamp": {
    "description": "End date for transactions (ISO 8601 format, e.g., 2024-12-31T23:59:59.999Z)",
    "type": "string"
   },
   "minTransactionTimestamp": {
    "description": "Start date for transactions (ISO 8601 format, e.g., 2024-01-01T00:00:00.000Z)",
    "type": "string"
   }
  },
  "required": [
   "accountUid",
   "categoryUid",
   "minTransactionTimestamp",
   "maxTransactionTimestamp"
  ],
  "type": "object"
 },
 "name": "transactions_list",
