{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Plan one authorized source package as a non-executing Evercraft Clip campaign with an objective, audience intent, CTA or commerce handoff, conversion event, creative treatment, and per-platform derivatives. Use for awareness, education, revenue, lead generation, recruiting, product discovery, retention, or other campaign goals. Facebook, LinkedIn and Instagram have authenticated execution lanes. YouTube can be staged but remains provider-authorization/canary gated. TikTok remains unverified. This tool does not upload media, create checkout, charge, or publish.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "audience_intent": {
    "maxLength": 3000,
    "type": "string"
   },
   "campaign_key": {
    "maxLength": 300,
    "type": "string"
   },
   "canonical_url": {
    "maxLength": 1800,
    "type": "string"
   },
   "caption_mode": {
    "default": "burned_in",
    "enum": [
     "burned_in",
     "hook_only",
     "none"
    ],
    "type": "string"
   },
   "commerce_offer_id": {
    "maxLength": 320,
    "type": "string"
   },
   "conversion_event": {
    "maxLength": 240,
    "type": "string"
   },
   "creative_style": {
    "default": "clean",
    "enum": [
     "clean",
     "bold",
     "documentary",
     "property"
    ],
    "type": "string"
   },
   "cta_label": {
    "maxLength": 240,
    "type": "string"
   },
   "cta_url": {
    "maxLength": 1800,
    "type": "string"
   },
   "objective": {
    "default": "awareness",
    "enum": [
     "awareness",
     "education",
     "revenue",
     "lead_generation",
     "recruiting",
     "product_discovery",
     "retention",
     "other"
    ],
    "type": "string"
   },
   "source_package_key": {
    "maxLength": 320,
    "type": "string"
   },
   "target_platforms": {
    "items": {
     "maxLength": 40,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "title": {
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "plan_distribution_campaign",
 "title": "Plan an Evercraft Clip cross-platform campaign"
}
