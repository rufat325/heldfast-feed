{
 "description": "Collega un conto corrente via Enable Banking (PSD2). Restituisce un link: aprilo, autorizza nella tua banca, poi copia l'indirizzo della pagina finale (anche se d\u00e0 errore) e passalo a bank_link_finish. Il consenso dura fino a 180 giorni.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bank": {
    "default": "Intesa Sanpaolo",
    "description": "Nome esatto come in bank_list_banks",
    "type": "string"
   },
   "country": {
    "default": "IT",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "days": {
    "default": 180,
    "maximum": 180,
    "minimum": 1,
    "type": "integer"
   },
   "psu_type": {
    "default": "personal",
    "description": "business per conti aziendali",
    "enum": [
     "personal",
     "business"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "bank_link_start"
}
