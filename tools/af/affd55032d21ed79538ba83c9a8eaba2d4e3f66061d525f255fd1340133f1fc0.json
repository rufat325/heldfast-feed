{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Prepare exactly one unpaid reservation and binding offer for an authorized transfer, return transfer or hourly service. Requires real customer contact data and a client-generated submissionId and resumeToken. Approved distribution partners may add their opaque capability for tenant-bound attribution. The customer must review the complete bound terms and confirm on checkoutUrl; this does not charge or confirm the booking.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "contact": {
    "additionalProperties": false,
    "properties": {
     "email": {
      "format": "email",
      "maxLength": 254,
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "fullName": {
      "maxLength": 120,
      "minLength": 2,
      "type": "string"
     },
     "phone": {
      "pattern": "^\\+[1-9][0-9]{6,14}$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "distributionPartnerCapability": {
    "pattern": "^dp_live_[a-f0-9]{64}$",
    "type": "string"
   },
   "firstTouchTrackingToken": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
    "type": "string"
   },
   "locale": {
    "default": "de",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "resumeToken": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "ride": {
    "additionalProperties": false,
    "properties": {
     "date": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "destination": {
      "maxLength": 240,
      "minLength": 2,
      "type": "string"
     },
     "flightNumber": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "hours": {
      "maximum": 24,
      "minimum": 1,
      "type": "integer"
     },
     "luggage": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "passengers": {
      "maximum": 60,
      "minimum": 1,
      "type": "integer"
     },
     "pickup": {
      "maxLength": 240,
      "minLength": 2,
      "type": "string"
     },
     "returnDate": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "returnTime": {
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     "serviceType": {
      "enum": [
       "hourly"
      ],
      "type": "string"
     },
     "time": {
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     "tripType": {
      "enum": [
       "one_way",
       "return"
      ],
      "type": "string"
     }
    },
    "required": [
     "pickup",
     "destination",
     "date",
     "time",
     "passengers",
     "tripType"
    ],
    "type": "object"
   },
   "specialRequests": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "submissionId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "submissionId",
   "resumeToken",
   "contact",
   "ride"
  ],
  "type": "object"
 },
 "name": "prepare_offer",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "status": {
      "const": "invalid_request",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "status": {
      "const": "unavailable",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "retryAfterSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "status": {
      "const": "pending",
      "type": "string"
     }
    },
    "required": [
     "status",
     "retryAfterSeconds"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "retryAfterSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "status": {
      "const": "rate_limited",
      "type": "string"
     }
    },
    "required": [
     "status",
     "retryAfterSeconds"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "status": {
      "enum": [
       "conflict",
       "ambiguous",
       "not_found"
      ],
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingConfirmed": {
      "const": false,
      "type": "boolean"
     },
     "checkoutUrl": {
      "format": "uri",
      "type": "string"
     },
     "nextAction": {
      "type": "string"
     },
     "offer": {
      "additionalProperties": false,
      "properties": {
       "completeTermsBound": {
        "const": true,
        "type": "boolean"
       },
       "currency": {
        "const": "EUR",
        "type": "string"
       },
       "customerConfirmationRequired": {
        "const": true,
        "type": "boolean"
       },
       "expiresAt": {
        "type": "string"
       },
       "grossTotalCents": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "currency",
       "grossTotalCents",
       "expiresAt",
       "customerConfirmationRequired",
       "completeTermsBound"
      ],
      "type": "object"
     },
     "status": {
      "const": "prepared",
      "type": "string"
     },
     "termsUrl": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "status",
     "bookingConfirmed",
     "checkoutUrl",
     "termsUrl",
     "offer",
     "nextAction"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Prepare a binding chauffeur offer"
}
