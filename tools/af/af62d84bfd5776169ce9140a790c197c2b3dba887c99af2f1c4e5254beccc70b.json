{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Remove a tag assignment from a ticket. The tag itself is not deleted.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "prefix": {
    "description": "Tag prefix",
    "type": "string"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "ticket": {
    "description": "Ticket title",
    "type": "string"
   },
   "value": {
    "description": "Tag value",
    "type": "string"
   }
  },
  "required": [
   "ticket",
   "prefix",
   "value"
  ],
  "type": "object"
 },
 "name": "tag_remove",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "status": {
    "enum": [
     "removed",
     "was_not_assigned"
    ],
    "type": "string"
   },
   "tag": {
    "type": "string"
   },
   "ticket": {
    "type": "string"
   }
  },
  "required": [
   "ticket",
   "tag",
   "status"
  ],
  "type": "object"
 }
}
