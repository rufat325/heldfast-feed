{
 "description": "Assemble a Markdown control-testing workpaper from the control, its risks, population, sample, test results and exceptions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "controlId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "testResultId": {
    "description": "Restrict to a single test result.",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "controlId"
  ],
  "type": "object"
 },
 "name": "assemble_workpaper",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "workpaper": {}
  },
  "required": [
   "workpaper"
  ],
  "type": "object"
 },
 "title": "Assemble a workpaper"
}
