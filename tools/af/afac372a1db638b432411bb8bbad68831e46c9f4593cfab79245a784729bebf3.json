{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Edit a comment of a project, portfolio or goal.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attachmentIds": {
    "description": "Temp file ids to attach",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "commentId": {
    "type": "string"
   },
   "entityId": {
    "type": "string"
   },
   "entityType": {
    "description": "Entity type: \"project\", \"portfolio\" or \"goal\"",
    "enum": [
     "project",
     "portfolio",
     "goal"
    ],
    "type": "string"
   },
   "notify": {
    "description": "Notify users (default true)",
    "type": "boolean"
   },
   "notifyAuthor": {
    "description": "Notify the author (default false)",
    "type": "boolean"
   },
   "text": {
    "description": "New comment text",
    "type": "string"
   }
  },
  "required": [
   "entityType",
   "entityId",
   "commentId",
   "text"
  ],
  "type": "object"
 },
 "name": "update_entity_comment"
}
