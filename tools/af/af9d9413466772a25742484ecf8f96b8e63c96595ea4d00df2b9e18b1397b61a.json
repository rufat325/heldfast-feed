{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Assess formation need without checkout. Anonymous. An SSN-shaped or ITIN-shaped field is refused and nothing is stored.",
 "inputSchema": {
  "properties": {
   "foreignOwnedCaution": {
    "type": "boolean"
   },
   "goal": {
    "description": "Trimmed and truncated to 500 characters.",
    "type": "string"
   },
   "hasEin": {
    "description": "Other values are treated as unknown, not rejected.",
    "enum": [
     "yes",
     "no",
     "unknown"
    ],
    "type": "string"
   },
   "hasUsEntity": {
    "description": "Other values are treated as unknown, not rejected.",
    "enum": [
     "yes",
     "no",
     "unknown"
    ],
    "type": "string"
   },
   "intendedEmail": {
    "description": "Optional. When a valid email is supplied it is stored on the assessment; later prepare must use the same recipient. Invalid values are ignored, not rejected.",
    "type": "string"
   },
   "jurisdictionKnown": {
    "description": "Other values are treated as unknown, not rejected.",
    "enum": [
     "yes",
     "no",
     "unknown"
    ],
    "type": "string"
   },
   "providerRequiresEin": {
    "description": "Other values are treated as unknown, not rejected.",
    "enum": [
     "yes",
     "no",
     "unknown"
    ],
    "type": "string"
   },
   "providerRequiresUsEntity": {
    "description": "Other values are treated as unknown, not rejected.",
    "enum": [
     "yes",
     "no",
     "unknown"
    ],
    "type": "string"
   },
   "selectedState": {
    "description": "Trimmed and truncated to 80 characters.",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "assess_formation",
 "outputSchema": {
  "additionalProperties": true,
  "else": {
   "properties": {
    "actionableAuthorized": {
     "type": "boolean"
    },
    "adviceStatus": {
     "const": "provisional"
    },
    "assessment": {
     "properties": {
      "createsCheckout": {
       "const": false
      },
      "evidenceLinks": {
       "items": {
        "properties": {
         "label": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "label",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "nextSteps": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "offer": {
       "anyOf": [
        {
         "properties": {
          "priceNote": {
           "type": "string"
          },
          "serviceId": {
           "const": "llc-ein-399"
          },
          "timingNote": {
           "type": "string"
          }
         },
         "required": [
          "serviceId",
          "priceNote",
          "timingNote"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "outcome": {
       "enum": [
        "not_needed_now",
        "already_satisfied",
        "insufficient_information",
        "recommended_for_review",
        "required_for_selected_path"
       ],
       "type": "string"
      },
      "rationale": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "outcome",
      "summary",
      "rationale",
      "nextSteps",
      "evidenceLinks",
      "offer",
      "createsCheckout"
     ],
     "type": "object"
    },
    "assessmentId": {
     "type": "string"
    },
    "authorizedState": {
     "enum": [
      "provisional_advice",
      "actionable_bound"
     ],
     "type": "string"
    },
    "decisionBound": {
     "type": "boolean"
    },
    "deploymentStatus": {
     "const": "available"
    },
    "filingAuthorization": {
     "const": false
    },
    "unknownFields": {
     "items": {
      "enum": [
       "goal",
       "hasUsEntity",
       "hasEin",
       "providerRequiresUsEntity",
       "providerRequiresEin"
      ],
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "unknownFields",
    "assessment",
    "deploymentStatus",
    "assessmentId",
    "decisionBound",
    "authorizedState",
    "actionableAuthorized",
    "filingAuthorization",
    "adviceStatus"
   ],
   "type": "object"
  },
  "if": {
   "required": [
    "error"
   ],
   "type": "object"
  },
  "then": {
   "additionalProperties": true,
   "properties": {
    "code": {
     "type": "string"
    },
    "error": {
     "type": "string"
    },
    "retryAfterSeconds": {
     "type": "number"
    }
   },
   "required": [
    "error"
   ],
   "type": "object"
  },
  "type": "object"
 }
}
