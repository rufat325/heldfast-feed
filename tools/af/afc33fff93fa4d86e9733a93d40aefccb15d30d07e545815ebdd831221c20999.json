{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Calculate DCF valuation"},"description":"Discounted cash flow (DCF) enterprise and equity valuation: 3-10 year FCFF forecast with growth fading to the terminal rate, Gordon terminal value, optional mid-year convention, WACC given directly or built with CAPM, plus a WACC \u00d7 terminal growth sensitivity table. Ratios are decimals (0.1 = 10%). Same engine as tools.oiyo.net.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"beta":{"description":"Levered beta for CAPM","minimum":0,"type":"number"},"capexRatio":{"description":"Capital expenditure \u00f7 revenue","maximum":1,"minimum":0,"type":"number"},"daRatio":{"description":"Depreciation and amortization \u00f7 revenue","maximum":1,"minimum":0,"type":"number"},"debtWeight":{"description":"Debt weight D/(D+E)","maximum":1,"minimum":0,"type":"number"},"ebitMargin":{"description":"EBIT margin","maximum":1,"minimum":-1,"type":"number"},"growth":{"description":"Year-1 revenue growth (e.g. 0.1)","maximum":1,"minimum":-1,"type":"number"},"marketPremium":{"description":"Market risk premium","maximum":1,"minimum":0,"type":"number"},"midYear":{"description":"Use the mid-year discounting convention","type":"boolean"},"netDebt":{"description":"Net debt (debt \u2212 cash); negative for net cash","type":"number"},"nwcRatio":{"description":"Net working capital increase \u00f7 revenue increase","maximum":1,"minimum":-1,"type":"number"},"preTaxCostOfDebt":{"description":"Pre-tax cost of debt","maximum":1,"minimum":0,"type":"number"},"revenue0":{"description":"Last fiscal year revenue","minimum":0,"type":"number"},"riskFree":{"description":"Risk-free rate for CAPM","maximum":1,"minimum":0,"type":"number"},"shares":{"description":"Shares outstanding","maximum":9007199254740991,"minimum":1,"type":"integer"},"sizePremium":{"description":"Size / private company