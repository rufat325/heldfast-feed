{
 "description": "Send an outbound message (SMS, Email, WhatsApp, GMB, IG, FB, Custom, Live_Chat).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "altId": {
    "description": "Alternate ID for custom channel",
    "type": "string"
   },
   "appointmentId": {
    "description": "Link message to an appointment",
    "type": "string"
   },
   "attachments": {
    "description": "Array of attachment URLs",
    "items": {},
    "type": "array"
   },
   "contactId": {
    "description": "Contact ID to send the message to",
    "type": "string"
   },
   "conversationId": {
    "description": "Existing conversation ID to send within",
    "type": "string"
   },
   "conversationProviderId": {
    "description": "Conversation provider ID",
    "type": "string"
   },
   "emailBcc": {
    "description": "BCC email addresses",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "emailCc": {
    "description": "CC email addresses",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "emailFrom": {
    "description": "From email address",
    "type": "string"
   },
   "emailReplyMode": {
    "description": "Reply mode: reply, reply_all",
    "type": "string"
   },
   "emailTo": {
    "description": "To email address",
    "type": "string"
   },
   "fromNumber": {
    "description": "From phone number (E.164)",
    "type": "string"
   },
   "html": {
    "description": "HTML body for email messages",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "mentions": {
    "description": "Array of user IDs to mention",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "message": {
    "description": "Message body text",
    "type": "string"
   },
   "replyToMessageId": {
    "description": "Message ID to reply to",
    "type": "string"
   },
   "scheduledTimestamp": {
    "description": "Unix timestamp (ms) to schedule the message",
    "type": "number"
   },
   "subject": {
    "description": "Email subject line",
    "type": "string"
   },
   "templateId": {
    "description": "Template ID for pre-built messages",
    "type": "string"
   },
   "threadId": {
    "description": "Email thread ID for threading",
    "type": "string"
   },
   "toNumber": {
    "description": "To phone number (E.164)",
    "type": "string"
   },
   "type": {
    "description": "Message channel type (SMS, Email, WhatsApp, GMB, IG, FB, Custom, Live_Chat)",
    "type": "string"
   },
   "userId": {
    "description": "Send as this user",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "type",
   "contactId"
  ],
  "type": "object"
 },
 "name": "crm_send_message"
}
