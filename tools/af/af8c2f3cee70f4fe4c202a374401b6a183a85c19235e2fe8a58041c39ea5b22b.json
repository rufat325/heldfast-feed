{
 "description": "List all registered tokens and NFT collections in the Insumer registry. Filter by chain, symbol, or asset type.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "const": "solana",
      "type": "string"
     },
     {
      "const": "xrpl",
      "type": "string"
     },
     {
      "const": "bitcoin",
      "type": "string"
     }
    ],
    "description": "Filter by chain ID"
   },
   "symbol": {
    "description": "Filter by token symbol",
    "type": "string"
   },
   "type": {
    "description": "Filter by asset type",
    "enum": [
     "token",
     "nft"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "insumer_list_tokens"
}
