      "type": "string"
     },
     "closedAtEpochMillis": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "closedByActorId": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "commandCount": {
      "type": "integer"
     },
     "createdAtEpochMillis": {
      "type": "integer"
     },
     "forkDocumentHash": {
      "type": "string"
     },
     "forkRevision": {
      "type": "integer"
     },
     "headRevision": {
      "type": "integer"
     },
     "mergedAtParentRevision": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "type": "string"
     },
     "ownerActorId": {
      "type": "string"
     },
     "parentDesignId": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "summary": {
