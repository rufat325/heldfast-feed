       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "branchId",
     "parentDesignId",
     "name",
     "ownerActorId",
     "status",
     "forkRevision",
     "forkDocumentHash",
     "headRevision",
     "commandCount",
     "createdAtEpochMillis",
     "summary"
