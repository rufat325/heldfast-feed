{
 "description": "Add a note to a lead, contact, or company. Supports common notes, incoming/outgoing call logs, and service messages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entity_id": {
    "description": "Entity ID (lead, contact, or company)",
    "type": "number"
   },
   "entity_type": {
    "description": "Entity type",
    "enum": [
     "leads",
     "contacts",
     "companies"
    ],
    "type": "string"
   },
   "note_type": {
    "description": "Note type (default: common)",
    "enum": [
     "common",
     "call_in",
     "call_out",
     "service_message"
    ],
    "type": "string"
   },
   "text": {
    "description": "Note text content",
    "type": "string"
   }
  },
  "required": [
   "entity_id",
   "entity_type",
   "text"
  ],
  "type": "object"
 },
 "name": "add_note"
}
