  "readOnlyHint": true,
  "title": "List people, organisations or places in the news"
 },
 "description": "Lists the people, organisations or places most present in Pollar's recent coverage, ranked by recent mentions. Suited to questions like who is in the news this week; get_entity takes a returned person or organization slug for the profile and timeline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 15,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "pl",
     "de",
     "fr"
    ],
    "type": "string"
   },
   "type": {
    "default": "person",
    "enum": [
     "person",
     "organization",
     "place"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_trending_entities",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entities": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "desc": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "mentionCount": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "recentEvents": {
       "type": "number"
      },
      "slug": {
       "type": "string"
      },
      "type": {
       "enum": [
        "person",
        "place",
        "organization"
       ],
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "name",
      "type",
      "slug",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "entities"
  ],
  "type": "object"
 },
 "title": "List people, organisations or places in the news"
}
