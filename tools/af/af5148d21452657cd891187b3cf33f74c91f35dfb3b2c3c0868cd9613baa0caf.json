 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List a ticker's registrations"
 },
 "description": "List a ticker's registrations on every chain\n\nEvery registration of a ticker, on every chain, including ones still pending: for each, the chain (`primaryChainId`), the token contract it covers (`tokenAddress`), the holder (`owner`), whether it is active, and its heartbeat. One ticker can carry several registrations because each covers one token contract on one chain; an empty `tokens` list means the ticker has none.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "excludeEvm": {
    "description": "Leave out registrations held by this EVM address.",
    "examples": [
     "0x1234567890abcdef1234567890abcdef12345678"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Token ticker, e.g. DOGE.",
    "examples": [
     "DOGE"
    ],
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "list_registrations",
 "outputSchema": {
  "properties": {
   "symbol": {
    "type": [
     "string",
     "null"
    ]
   },
   "tokens": {
    "description": "One entry per registration; empty when the ticker has none",
    "items": {
     "properties": {
      "chainPeerIndex": {
       "type": [
        "integer",
        "null"
       ]
      },
      "chainType": {
       "type": [
        "string",
        "null"
       ]
      },
      "crownPda": {
       "description": "The Solana registration's account address",
       "type": [
        "string",
        "null"
       ]
      },
      "deploymentCount": {
       "type": [
        "integer",
        "null"
       ]
      },
      "heartbeatComposite": {
       "description": "The health score, 0-100, from the token's age, trading and holders. A registration expires when it stays below 60 for 30 days in a row.",
       "type": [
        "integer",
        "null"
       ]
      },
      "isActive": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "isLinked": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "isPending": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "mintTimestamp": {
       "description": "When it was written (unix seconds)",
       "type": [
        "integer",
        "null"
       ]
      },
      "owner": {
       "description": "The wallet holding it",
       "type": [
        "string",
        "null"
       ]
      },
      "ownerGroup": {
       "description": "Groups registrations whose owners are linked wallets of one account",
       "type": [
        "string",
        "null"
       ]
      },
      "ownerType": {
       "type": [
        "string",
        "null"
       ]
      },
      "peerIndex": {
       "type": [
        "integer",
        "null"
       ]
      },
      "primaryChainId": {
       "anyOf": [
        {
         "type": [
          "integer",
          "null"
         ]
        },
        {
         "type": [
          "string",
          "null"
         ]
        }
       ],
       "description": "The registration's chain, an EVM chain ID or a Solana cluster name"
      },
      "sharedMetadataCid": {
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "type": [
        "string",
        "null"
       ]
      },
      "tokenAddress": {
       "description": "The token contract (or Solana mint) this registration covers",
       "type": [
        "string",
        "null"
       ]
      },
      "tokenId": {
       "description": "The registration's token ID on its chain (null while pending)",
       "type": [
        "integer",
        "null"
       ]
      },
      "txHash": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": [
      "object",
      "null"
     ]
    },
    "type": [
     "array",
     "null"
    ]
   }
  },
  "type": "object"
 },
