{
 "description": "Attest subject, generate sealed Policy Artifact. Auto-loads into portal.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "behavioral_baseline": {
    "additionalProperties": false,
    "properties": {
     "forbidden_sequences": {
      "items": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "type": "array"
     },
     "permitted_tools": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "rate_limits": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object"
     },
     "window_ms": {
      "type": "number"
     }
    },
    "required": [
     "permitted_tools",
     "rate_limits",
     "forbidden_sequences",
     "window_ms"
    ],
    "type": "object"
   },
   "evidence_items": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "label": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "subject_content": {
    "description": "Content/bytes of the subject",
    "type": "string"
   },
   "subject_metadata": {
    "additionalProperties": false,
    "properties": {
     "author": {
      "type": "string"
     },
     "content_type": {
      "type": "string"
     },
     "filename": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "subject_content",
   "subject_metadata"
  ],
  "type": "object"
 },
 "name": "attest_subject"
}
