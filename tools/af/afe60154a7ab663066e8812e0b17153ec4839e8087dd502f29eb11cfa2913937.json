{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List what the assistant has done recently"
 },
 "description": "Returns recent account-owned assistant actions, newest first, across the site and MCP. status filters ongoing, completed or failed work; limit bounds the result. The ledger records actions rather than conversation text.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "running",
     "completed",
     "queued",
     "verifying",
     "failed",
     "cancelled",
     "undone"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_tasks",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "tasks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "actionId": {
       "type": "string"
      },
      "createdAt": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "source": {
       "enum": [
        "site",
        "mcp"
       ],
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "summary": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "actionId",
      "status",
      "summary",
      "source",
      "createdAt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tasks"
  ],
  "type": "object"
 },
 "title": "List what the assistant has done recently"
}
