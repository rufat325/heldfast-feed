{
 "description": "Perform a structured pan, fling, swipe, pinch, rotate, transform, or drag gesture. Select the gesture kind, then provide only the inputs that apply to that kind. Times out after 90s.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "androidDeviceAllowlist": {
    "description": "Android serial allowlist used for device resolution.",
    "type": "string"
   },
   "debug": {
    "description": "Enable debug diagnostics.",
    "type": "boolean"
   },
   "degrees": {
    "description": "Rotation in degrees.",
    "type": "number"
   },
   "delta": {
    "additionalProperties": false,
    "description": "Movement delta for pan or transform gestures.",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y"
    ],
    "type": "object"
   },
   "destination": {
    "description": "Drag destination @ref or selector.",
    "type": "string"
   },
   "destinationHoldMs": {
    "description": "Hold before releasing at the destination.",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "device": {
    "description": "Device name selector (a UDID belongs in udid, a serial in serial).",
    "type": "string"
   },
   "deviceTarget": {
    "description": "Device target form. Maps to the CLI --target flag.",
    "enum": [
     "mobile",
     "tv",
     "desktop"
    ],
    "type": "string"
   },
   "direction": {
    "description": "Fling direction.",
    "enum": [
     "up",
     "down",
     "left",
     "right"
    ],
    "type": "string"
   },
   "distance": {
    "description": "Fling distance.",
    "minimum": 0,
    "type": "integer"
   },
   "durationMs": {
    "description": "Pan/transform duration.",
    "maximum": 10000,
    "minimum": 16,
    "type": "integer"
   },
   "includeCost": {
    "description": "Include per-command agent-cost (cost.wallClockMs, \u2026) in structuredContent. Defaults to off; the default response shape is unchanged.",
    "type": "boolean"
   },
   "kind": {
    "description": "Gesture variant.",
    "enum": [
     "pan",
     "fling",
     "swipe",
     "pinch",
     "rotate",
     "transform",
     "drag"
    ],
    "type": "string"
   },
   "leaseId": {
    "description": "Existing lease identifier.",
    "type": "string"
   },
   "mcpOutputFormat": {
    "description": "MCP text content format. Defaults to optimized agent-friendly text; use json for JSON text. Structured content is always returned separately.",
    "enum": [
     "optimized",
     "json"
    ],
    "type": "string"
   },
   "moveMs": {
    "description": "Drag movement duration.",
    "maximum": 10000,
    "minimum": 16,
    "type": "integer"
   },
   "noRecord": {
    "description": "Do not record this action.",
    "type": "boolean"
   },
   "origin": {
    "additionalProperties": false,
    "description": "Gesture origin point.",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y"
    ],
    "type": "object"
   },
   "platform": {
    "description": "Platform selector used to resolve a device.",
    "enum": [
     "apple",
     "android",
     "harmonyos",
     "vega",
     "linux",
     "web",
     "ios",
     "macos"
    ],
    "type": "string"
   },
   "pointerCount": {
    "description": "Pan touch pointer count (1 or 2).",
    "maximum": 2,
    "minimum": 1,
    "type": "integer"
   },
   "preset": {
    "description": "Swipe preset.",
    "enum": [
     "left",
     "right",
     "left-edge",
     "right-edge"
    ],
    "type": "string"
   },
   "responseLevel": {
    "description": "Response verbosity: token-cheap digest / default (today) / full. Defaults to default; the default response shape is unchanged.",
    "enum": [
     "digest",
     "default",
     "full"
    ],
    "type": "string"
   },
   "runId": {
    "description": "Lease run identifier.",
    "type": "string"
   },
   "scale": {
    "description": "Pinch or transform scale.",
    "type": "number"
   },
   "serial": {
    "description": "Android, HarmonyOS, or Vega VVD serial selector.",
    "type": "string"
   },
   "session": {
    "description": "Agent-device session name.",
    "type": "string"
   },
   "source": {
    "description": "Drag source @ref or selector.",
    "type": "string"
   },
   "sourceHoldMs": {
    "description": "Drag activation hold duration.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "target": {
    "description": "Alias for deviceTarget on commands without a UI target field. Interaction commands reserve target for the UI element.",
    "enum": [
     "mobile",
     "tv",
     "desktop"
    ],
    "type": "string"
   },
   "tenant": {
    "description": "Remote tenant identifier.",
    "type": "string"
   },
   "udid": {
    "description": "Apple device or simulator UDID; the selector that pins one device when several share a name.",
    "type": "string"
   }
  },
  "required": [
   "kind"
  ],
  "type": "object"
 },
 "name": "gesture"
}
