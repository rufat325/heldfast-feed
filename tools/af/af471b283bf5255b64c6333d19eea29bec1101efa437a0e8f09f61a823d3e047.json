{
 "description": "Get the block record for a given header hash (32-byte hex, optional 0x prefix).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "header_hash": {
    "pattern": "^(0x)?[0-9a-fA-F]{64}$",
    "type": "string"
   },
   "network": {
    "default": "mainnet",
    "description": "Chia network: 'mainnet' (default) or 'testnet11'",
    "enum": [
     "mainnet",
     "testnet11"
    ],
    "type": "string"
   }
  },
  "required": [
   "header_hash"
  ],
  "type": "object"
 },
 "name": "get_block_by_hash"
}
