{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Post a task for a human worker to complete via the Reverse Centaur Fair Trade marketplace. Tasks must meet category-specific fair trade pay minimums.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budget_usd": {
    "description": "Budget in USD (must meet fair trade minimum for category)",
    "minimum": 1,
    "type": "number"
   },
   "callback_url": {
    "description": "Webhook URL to receive task completion notification",
    "format": "uri",
    "type": "string"
   },
   "category": {
    "description": "Task category (determines fair trade minimum)",
    "enum": [
     "verification",
     "research",
     "physical_action",
     "creative_judgment",
     "data_validation",
     "communication",
     "legal_identity",
     "sensory_evaluation",
     "other"
    ],
    "type": "string"
   },
   "deadline_minutes": {
    "default": 1440,
    "description": "Deadline in minutes from now (default: 1440 = 24h)",
    "maximum": 43200,
    "minimum": 15,
    "type": "integer"
   },
   "deliverable_format": {
    "default": "text",
    "description": "Expected format of the deliverable",
    "enum": [
     "text",
     "json",
     "image",
     "file",
     "confirmation"
    ],
    "type": "string"
   },
   "description": {
    "description": "Detailed description of what the human should do",
    "maxLength": 5000,
    "type": "string"
   },
   "payment_method": {
    "default": "stripe",
    "description": "Payment rail: \"stripe\" (default) or \"usdc_base\" (direct USDC on Base L2)",
    "enum": [
     "stripe",
     "usdc_base"
    ],
    "type": "string"
   },
   "title": {
    "description": "Short title for the task",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "title",
   "description",
   "category",
   "budget_usd"
  ],
  "type": "object"
 },
 "name": "post_task",
 "title": "Post Task"
}
