{
 "description": "Fill AcroForm fields in a PDF, optionally flatten afterwards.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fields": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Object mapping field names to values",
    "type": "object"
   },
   "flatten": {
    "description": "Flatten form after filling",
    "type": "boolean"
   },
   "pdf_base64": {
    "description": "Base64-encoded PDF file",
    "type": "string"
   }
  },
  "required": [
   "pdf_base64",
   "fields"
  ],
  "type": "object"
 },
 "name": "bytario_pdf_fill_form"
}
