{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return the photo gallery of a hotel (URLs and captions), optionally limited to the cover photo.\n\n    No availability, rates or booking: this tool only returns descriptive information.",
 "inputSchema": {
  "properties": {
   "cover_only": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "If true, return only the cover photo",
    "title": "Cover Only"
   },
   "hotel_id": {
    "description": "Hotel ID as returned by search_hotels (e.g. PAR-87155)",
    "title": "Hotel Id",
    "type": "string"
   },
   "language": {
    "default": "fr",
    "description": "Language of the captions. Accepted values: fr, en, de, it, es. A text missing in the requested language is returned in French.",
    "enum": [
     "fr",
     "en",
     "de",
     "it",
     "es"
    ],
    "title": "Language",
    "type": "string"
   }
  },
  "required": [
   "hotel_id"
  ],
  "title": "get_hotel_photosArguments",
  "type": "object"
 },
 "name": "get_hotel_photos",
 "outputSchema": {
  "$defs": {
   "Photo": {
    "additionalProperties": true,
    "properties": {
     "caption": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Caption"
     },
     "id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Id"
     },
     "is_cover": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Is Cover"
     },
     "url": {
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "title": "Photo",
    "type": "object"
   }
  },
  "properties": {
   "language": {
    "description": "Language of the returned texts",
    "title": "Language",
    "type": "string"
   },
   "photos": {
    "items": {
     "$ref": "#/$defs/Photo"
    },
    "title": "Photos",
    "type": "array"
   }
  },
  "required": [
   "language",
   "photos"
  ],
  "title": "PhotosResult",
  "type": "object"
 },
 "title": "Get hotel photos"
}
