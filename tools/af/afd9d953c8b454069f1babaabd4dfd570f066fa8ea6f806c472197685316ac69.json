{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Academic Paper Search"
 },
 "description": "Search scholarly papers, articles, books and preprints by topic or title: title, authors, year, journal or venue, DOI, link, type and citation count (metadata only, no abstracts). Use it to find sources or citations for a research question. Data source: Crossref. Price: $0.002 per successful call; failed calls are free. Free to try: a few calls a day without a key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "api_key": {
    "description": "Your Unstuck API key, if this connection has none. Leave empty to try free tools or to get a key and payment link.",
    "maxLength": 200,
    "type": "string"
   },
   "from_year": {
    "description": "Only works published in or after this year.",
    "maximum": 2100,
    "minimum": 1600,
    "type": "integer"
   },
   "limit": {
    "description": "How many papers, default 5, max 10.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "What to search for, e.g. \"microplastics drinking water\".",
    "maxLength": 300,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "paper_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance_usd": {
    "description": "Remaining prepaid balance, USD.",
    "type": "number"
   },
   "charged_usd": {
    "description": "Amount charged for this call, USD.",
    "type": "number"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authors": {
       "description": "Author names in order (first 20).",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "citation_count": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Times cited, as counted by Crossref."
      },
      "doi": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "type": {
       "description": "e.g. \"journal-article\".",
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      },
      "venue": {
       "description": "Journal, book or conference.",
       "type": [
        "string",
        "null"
       ]
      },
      "year": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "title",
      "authors",
      "year",
      "venue",
      "doi",
      "url",
      "type",
      "citation_count"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "const": "Crossref",
    "type": "string"
   },
   "total_results": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "source",
   "query",
   "total_results",
   "results",
   "charged_usd",
   "balance_usd"
  ],
  "type": "object"
 },
 "title": "Academic Paper Search"
}
