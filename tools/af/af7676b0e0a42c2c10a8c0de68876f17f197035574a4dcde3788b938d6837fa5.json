{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return a frozen Cloudflare Workers research snapshot. Omit view or set view=full for the complete fixture; view=compact slices mentions and citations to 8 and clears theme examples; query and filters are ignored because the snapshot is fixed; extra keys besides view are rejected; {} is valid. Use this free fixture when you need a sample payload; for liveness use get_health instead; for list price use get_pricing instead; for live mentions use research_mentions. Never charges, never hits live sources, and does not consume the shared 10-call trial.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "view": {
    "description": "Optional snapshot size: full or compact.",
    "enum": [
     "full",
     "compact"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_example",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "citations": {
    "description": "Sources used to build the brief",
    "items": {
     "additionalProperties": false,
     "properties": {
      "accessed_at": {
       "description": "When MentionForge fetched this source (ISO-8601)",
       "type": "string"
      },
      "source": {
       "description": "Publisher or site label",
       "type": "string"
      },
      "title": {
       "description": "Source title",
       "type": "string"
      },
      "url": {
       "description": "Source URL",
       "type": "string"
      }
     },
     "required": [
      "url",
      "title",
      "source",
      "accessed_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "markdown": {
    "description": "Deterministic pasteable brief when include_markdown was true",
    "type": "string"
   },
   "mentions": {
    "description": "Cited mention rows (may be empty \u2014 empty windows still succeed)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "aspects": {
       "description": "Optional product aspects tagged on this mention",
       "items": {
        "description": "Product aspect tagged from mention text",
        "enum": [
         "pricing",
         "support",
         "reliability",
         "security",
         "performance"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "author": {
       "description": "Display name or handle; may be empty",
       "type": "string"
      },
      "engagement": {
       "description": "Relative engagement score (0 when unknown)",
       "type": "number"
      },
      "id": {
       "description": "Stable mention id within this response",
       "type": "string"
      },
      "intent": {
       "description": "Optional intent class for this mention",
       "enum": [
        "praise",
        "complaint",
        "question",
        "buying",
        "news",
        "other"
       ],
       "type": "string"
      },
      "platform": {
       "description": "Surface this mention was gathered from",
       "enum": [
        "x",
        "reddit",
        "web",
        "reviews",
        "news"
       ],
       "type": "string"
      },
      "relevance": {
       "description": "Optional 0\u20131 overlap with the query",
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "sentiment": {
       "description": "Per-mention sentiment from -1 (negative) to 1 (positive)",
       "maximum": 1,
       "minimum": -1,
       "type": "number"
      },
      "text": {
       "description": "Mention body, truncated to the engine cap",
       "type": "string"
      },
      "timestamp": {
       "description": "When the mention was published or accessed (ISO-8601 when known)",
       "type": "string"
      },
      "url": {
       "description": "Canonical URL of the mention, or empty when the source had no permalink",
       "type": "string"
      }
     },
     "required": [
      "id",
      "platform",
      "url",
      "author",
      "timestamp",
      "text",
      "engagement",
      "sentiment"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "additionalProperties": false,
    "description": "Request metadata including billing and freshness",
    "properties": {
     "as_of": {
      "description": "When this intelligence was produced (ISO-8601)",
      "type": "string"
     },
     "billing": {
      "additionalProperties": false,
      "description": "Charge record for this call (never cached)",
      "properties": {
       "amount_usdc": {
        "description": "USDC charged for this call (`0` on trial/sandbox/replay)",
        "type": "string"
       },
       "free_trial": {
        "description": "True when this call used trial or sandbox and was not settled",
        "type": "boolean"
       },
       "tx_hash": {
        "description": "Settlement transaction hash, or null until settle / on trial",
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "amount_usdc",
       "tx_hash",
       "free_trial"
      ],
      "type": "object"
     },
     "confidence": {
      "description": "Optional 0\u20131 confidence in the aggregate",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "degraded": {
      "description": "Optional list of degraded or skipped adapters",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "freshness": {
      "description": "live = this call; cached = research body reused, new billing",
      "enum": [
       "live",
       "cached"
      ],
      "type": "string"
     },
     "latency_ms": {
      "description": "Engine wall time in milliseconds (not billed)",
      "type": "number"
     },
     "next_queries": {
      "description": "Up to three follow-up queries the agent can issue",
      "items": {
       "type": "string"
      },
      "maxItems": 3,
      "type": "array"
     },
     "request_id": {
      "description": "Request correlation id",
      "type": "string"
     },
     "sources_disabled": {
      "description": "Requested platform ids skipped because they are in DISABLED_SOURCES",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "sources_used": {
      "description": "Adapter ids that contributed data",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "request_id",
     "latency_ms",
     "sources_used",
     "billing"
    ],
    "type": "object"
   },
   "query": {
    "description": "Echo of the researched query",
    "type": "string"
   },
   "sentiment": {
    "additionalProperties": false,
    "description": "Aggregate and per-class sentiment",
    "properties": {
     "by_platform": {
      "additionalProperties": {
       "type": "number"
      },
      "description": "Optional per-platform sentiment from -1 to 1",
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "distribution": {
      "additionalProperties": false,
      "description": "Breakdown of sentiment classes",
      "properties": {
       "by_platform": {
        "additionalProperties": {
         "type": "number"
        },
        "description": "Mention counts keyed by platform id",
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "negative": {
        "description": "Negative share (percent)",
        "type": "number"
       },
       "neutral": {
        "description": "Neutral share (percent)",
        "type": "number"
       },
       "positive": {
        "description": "Positive share (percent)",
        "type": "number"
       }
      },
      "required": [
       "positive",
       "neutral",
       "negative",
       "by_platform"
      ],
      "type": "object"
     },
     "negative": {
      "description": "Share of negative mentions (percent)",
      "type": "number"
     },
     "neutral": {
      "description": "Share of neutral mentions (percent)",
      "type": "number"
     },
     "overall": {
      "description": "Aggregate sentiment from -1 to 1",
      "maximum": 1,
      "minimum": -1,
      "type": "number"
     },
     "positive": {
      "description": "Share of positive mentions (percent)",
      "type": "number"
     }
    },
    "required": [
     "overall",
     "positive",
     "neutral",
     "negative",
     "distribution"
    ],
    "type": "object"
   },
   "share_of_voice": {
    "description": "Present when the query is a vs / multi-brand compare",
    "items": {
     "additionalProperties": false,
     "properties": {
      "brand": {
       "description": "Brand or `other` when no brand token matched",
       "type": "string"
      },
      "engagement": {
       "description": "Sum of engagement for attributed mentions",
       "type": "number"
      },
      "mentions": {
       "description": "Mentions attributed to this brand",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "share": {
       "description": "Fraction of fused mentions (0\u20131)",
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "brand",
      "mentions",
      "engagement",
      "share"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "signals": {
    "additionalProperties": false,
    "description": "Spike and negative-concentration flags for this window",
    "properties": {
     "reasons": {
      "description": "Short reasons the agent can quote",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "risk": {
      "description": "Crisis-style risk from volume spike and negatives",
      "enum": [
       "low",
       "elevated",
       "high"
      ],
      "type": "string"
     },
     "spike": {
      "description": "True when the latest trend bucket is elevated vs earlier mean",
      "type": "boolean"
     }
    },
    "required": [
     "risk",
     "spike",
     "reasons"
    ],
    "type": "object"
   },
   "summary": {
    "description": "Executive summary when include_summary was true",
    "type": "string"
   },
   "themes": {
    "description": "Ranked themes extracted from mentions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "description": "How many mentions support this theme",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "examples": {
       "description": "Short supporting snippets",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "theme": {
       "description": "Short theme label clustered from mention text",
       "type": "string"
      }
     },
     "required": [
      "theme",
      "count",
      "examples"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "timeframe": {
    "anyOf": [
     {
      "description": "Named window echoed back",
      "type": "string"
     },
     {
      "additionalProperties": false,
      "description": "Custom inclusive ISO-8601 from/to window, maximum 90 days",
      "properties": {
       "from": {
        "description": "Custom range start (ISO-8601). Must be earlier than `to`.",
        "type": "string"
       },
       "to": {
        "description": "Custom range end (ISO-8601). Must be later than `from`. Window max 90 days.",
        "type": "string"
       }
      },
      "required": [
       "from",
       "to"
      ],
      "type": "object"
     }
    ],
    "description": "Echo of the requested window"
   },
   "voices": {
    "description": "Top non-placeholder authors by engagement",
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "description": "Display name or handle",
       "type": "string"
      },
      "engagement": {
       "description": "Sum of engagement",
       "type": "number"
      },
      "mentions": {
       "description": "How many fused mentions this author has",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "platform": {
       "description": "Surface this voice was seen on",
       "enum": [
        "x",
        "reddit",
        "web",
        "reviews",
        "news"
       ],
       "type": "string"
      }
     },
     "required": [
      "author",
      "platform",
      "mentions",
      "engagement"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "volume": {
    "additionalProperties": false,
    "description": "Mention counts and trend for the window",
    "properties": {
     "by_platform": {
      "additionalProperties": false,
      "description": "Per-platform mention counts (zeros when a surface returned nothing)",
      "properties": {
       "news": {
        "description": "Mentions attributed to news",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "reddit": {
        "description": "Mentions attributed to reddit",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "reviews": {
        "description": "Mentions attributed to reviews",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "web": {
        "description": "Mentions attributed to web",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "x": {
        "description": "Mentions attributed to x",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       }
      },
      "required": [
       "x",
       "reddit",
       "web",
       "reviews",
       "news"
      ],
      "type": "object"
     },
     "total": {
      "description": "Total mentions in the window after filtering",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "trend": {
      "description": "Time-bucketed mention counts across the window",
      "items": {
       "additionalProperties": false,
       "properties": {
        "count": {
         "description": "Mentions in this bucket",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "t": {
         "description": "Bucket start (ISO-8601)",
         "type": "string"
        }
       },
       "required": [
        "t",
        "count"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "total",
     "by_platform",
     "trend"
    ],
    "type": "object"
   }
  },
  "required": [
   "query",
   "timeframe",
   "volume",
   "sentiment",
   "themes",
   "mentions",
   "citations",
   "meta"
  ],
  "type": "object"
 },
 "title": "Get a frozen research snapshot"
}
