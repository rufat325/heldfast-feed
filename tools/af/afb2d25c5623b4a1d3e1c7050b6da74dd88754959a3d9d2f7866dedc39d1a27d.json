{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Change project settings"
 },
 "description": "Use this when someone wants to rename a project or change its domain, languages, default voice or narration speed. Returns the updated settings; fields left out keep their values, and a new locales list replaces the whole set. Not for pronunciation fixes.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "defaultLocale": {
    "description": "New main language code, e.g. en or pt-BR",
    "maxLength": 16,
    "minLength": 2,
    "type": "string"
   },
   "defaultVoice": {
    "description": "New default voice id for synthesized narration",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "domain": {
    "description": "New product domain, e.g. example.com",
    "maxLength": 253,
    "minLength": 1,
    "type": "string"
   },
   "locales": {
    "description": "Complete list of language codes the project publishes, 1 to 100; it replaces the current list, and languages left out stop being expected",
    "items": {
     "maxLength": 32,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "description": "New project name, up to 120 characters",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "description": "Project id or its stable public vanity id",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "speed": {
    "description": "New narration speed multiplier, from 0.1 to 10",
    "maximum": 10,
    "minimum": 0.1,
    "type": "number"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "update_project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "project": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultVoice": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "domain": {
        "anyOf": [
         {
          "maxLength": 253,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "locales": {
        "items": {
         "maxLength": 32,
         "type": "string"
        },
        "maxItems": 100,
        "type": "array"
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "speed": {
        "anyOf": [
         {
          "maximum": 10,
          "minimum": 0.1,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "vanityId": {
        "anyOf": [
         {
          "maxLength": 63,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "vanityId",
       "domain",
       "defaultLocale",
       "locales",
       "defaultVoice",
       "speed",
       "creationTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "updated",
     "unchanged",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "project"
  ],
  "type": "object"
 },
 "title": "Change project settings"
}
