{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "owner",
     "offline_access"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false,
  "title": "Add a service, class or rental"
 },
 "description": "Only for business owners signed in to Awning. Add a new offering to a business the owner already has, live or not, described the same way as in owner_setup. On a live business it can be booked at once. Confirm the details with the owner first; never invent a price.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "business_id": {
    "type": "string"
   },
   "offering": {
    "properties": {
     "capacity": {
      "description": "Classes: people per class",
      "type": "number"
     },
     "deposit": {
      "type": "number"
     },
     "description": {
      "maxLength": 600,
      "type": "string"
     },
     "duration_min": {
      "type": "number"
     },
     "name": {
      "maxLength": 120,
      "type": "string"
     },
     "options": {
      "items": {
       "properties": {
        "extra_min": {
         "type": "number"
        },
        "name": {
         "maxLength": 200,
         "type": "string"
        },
        "per_day": {
         "type": "boolean"
        },
        "price": {
         "type": "number"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "type": "array"
     },
     "price": {
      "description": "In major units of the business currency, e.g. 2500",
      "type": "number"
     },
     "price_from": {
      "description": "Price is 'from'",
      "type": "boolean"
     },
     "price_unit": {
      "enum": [
       "booking",
       "person",
       "hour",
       "day",
       "night",
       "week",
       "month"
      ],
      "type": "string"
     },
     "quote_only": {
      "type": "boolean"
     },
     "schedule": {
      "description": "Classes: when they run",
      "items": {
       "properties": {
        "days": {
         "anyOf": [
          {
           "maxLength": 100,
           "type": "string"
          },
          {
           "items": {
            "maxLength": 20,
            "type": "string"
           },
           "maxItems": 14,
           "type": "array"
          }
         ],
         "description": "e.g. \"mon-sat\", \"daily\", [\"tue\",\"thu\"]"
        },
        "time": {
         "maxLength": 20,
         "type": "string"
        }
       },
       "required": [
        "days",
        "time"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "type": "array"
     },
     "units": {
      "description": "Rentals: how many identical items",
      "type": "number"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   }
  },
  "required": [
   "business_id",
   "offering"
  ],
  "type": "object"
 },
 "name": "owner_add_offering",
 "title": "Add a service, class or rental"
}
