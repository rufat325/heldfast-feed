  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Alerts to a webhook"
 },
 "description": "Alerts checked continuously and posted to your webhook when they trigger. action: list (default), create (coin + trigger: radar_unusual, flag_fired or funding_band with band, + webhook_url), delete (id). Starter and up to create.",
 "inputSchema": {
  "additionalProperties": {},
  "properties": {
   "action": {
    "description": "Which lane; see the description.",
    "enum": [
     "list",
     "create",
     "delete"
    ],
    "type": "string"
   },
   "band": {
    "description": "create with funding_band: the band, e.g. \"top 5%\".",
    "type": "string"
   },
   "coin": {
    "description": "Coin symbol, e.g. BTC. A pair like ETH/USD works too.",
    "type": "string"
   },
   "id": {
    "description": "delete only: the alert id.",
    "type": "string"
   },
   "trigger": {
    "description": "create only: what triggers it.",
    "enum": [
     "radar_unusual",
     "flag_fired",
     "funding_band"
    ],
    "type": "string"
   },
   "webhook_url": {
    "description": "create only: a public https URL you control.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "watch",
 "outputSchema": {
  "additionalProperties": {},
  "properties": {
   "access_note": {
    "description": "What this connection could not return."
   },
   "as_of": {
    "description": "Data time, ISO."
   },
   "as_of_ms": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Data time, Unix ms."
   },
   "available": {
    "description": "False: no data; note says why.",
    "type": "boolean"
   },
   "caveat": {
    "description": "A real limit, when non-null."
   },
   "cursor": {
    "description": "Next page (detail full)."
   },
   "delayed": {
    "description": "Set when not live."
   },
   "next_tools": {
    "description": "Follow-up calls {tool,args,why}.",
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "The answer in one sentence."
   },
   "truncated": {
    "description": "Rows held back; see trimmed."
   }
  },
  "type": "object"
 },
 "title": "Alerts to a webhook"
}
