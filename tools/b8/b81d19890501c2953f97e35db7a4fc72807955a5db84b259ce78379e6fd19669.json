{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Create Order"
 },
 "description": "Create an order with line items and delivery. Link an existing customer via customer_id/customer_external_id, or pass first_name (+phone/email) to create one inline. Returns {success, id, order?}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customer_external_id": {
    "description": "Link the order to an EXISTING customer by externalId",
    "type": "string"
   },
   "customer_id": {
    "description": "Link the order to an EXISTING customer by RetailCRM ID (mutually exclusive with inline name/phone/email)",
    "type": "integer"
   },
   "delivery_address": {
    "description": "Delivery address as free text",
    "type": "string"
   },
   "delivery_code": {
    "description": "Delivery type code",
    "type": "string"
   },
   "delivery_cost": {
    "description": "Delivery cost",
    "type": "number"
   },
   "email": {
    "description": "Customer email",
    "type": "string"
   },
   "first_name": {
    "description": "Customer first name (omit only when linking by customer_id/customer_external_id)",
    "type": "string"
   },
   "items": {
    "description": "Order items (at least one required)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "initial_price": {
       "description": "Price per unit",
       "type": "number"
      },
      "product_name": {
       "description": "Product display name",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity",
       "minimum": 1,
       "type": "number"
      }
     },
     "required": [
      "product_name",
      "quantity",
      "initial_price"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "last_name": {
    "description": "Customer last name",
    "type": "string"
   },
   "order_type": {
    "default": "eshop-individual",
    "description": "Order type code",
    "type": "string"
   },
   "phone": {
    "description": "Customer phone number",
    "type": "string"
   },
   "site": {
    "description": "Site (store) symbolic code. Required on create/edit when the API key is scoped to multiple sites (see list_sites).",
    "type": "string"
   },
   "status": {
    "description": "Initial order status code (e.g. 'new')",
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "create_order"
}
