{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List subnets available for Cloud Hadoop deployment",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudHadoopImageProductCode": {
    "description": "Cluster image product code (from ncloud_hadoop_list_image_products)",
    "type": "string"
   },
   "isPublic": {
    "description": "true: public subnets only, false: private subnets only",
    "type": "boolean"
   },
   "regionCode": {
    "description": "Region code",
    "type": "string"
   },
   "vpcNo": {
    "description": "VPC number (from ncloud_hadoop_list_target_vpcs)",
    "type": "string"
   }
  },
  "required": [
   "vpcNo",
   "cloudHadoopImageProductCode"
  ],
  "type": "object"
 },
 "name": "ncloud_hadoop_list_target_subnets"
}
