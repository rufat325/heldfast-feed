{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create DNS records for a specific Global DNS domain",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domainId": {
    "description": "Domain ID to create records for",
    "type": "number"
   },
   "records": {
    "description": "Array of DNS records to create",
    "items": {
     "additionalProperties": false,
     "properties": {
      "aliasId": {
       "description": "Alias ID (optional)",
       "type": "number"
      },
      "content": {
       "description": "Record content/value",
       "type": "string"
      },
      "host": {
       "description": "Record host name",
       "type": "string"
      },
      "lbId": {
       "description": "Load Balancer ID (optional)",
       "type": "number"
      },
      "lbRegionCode": {
       "description": "Load Balancer region code (optional)",
       "type": "string"
      },
      "ttl": {
       "description": "TTL in seconds",
       "type": "number"
      },
      "type": {
       "description": "Record type (A, AAAA, CNAME, MX, PTR, SPF, TXT, NS, SRV, CAA, DS)",
       "type": "string"
      }
     },
     "required": [
      "host",
      "type",
      "content",
      "ttl"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "domainId",
   "records"
  ],
  "type": "object"
 },
 "name": "ncloud_dns_create_records"
}
