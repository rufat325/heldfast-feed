{
 "description": "Create a withdrawal request",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "Destination address (crypto) or bank account ID (BRL)",
    "type": "string"
   },
   "network": {
    "description": "Blockchain network (for crypto withdrawals)",
    "type": "string"
   },
   "quantity": {
    "description": "Amount to withdraw",
    "type": "string"
   },
   "symbol": {
    "description": "Asset symbol (e.g. BTC, ETH, BRL)",
    "type": "string"
   }
  },
  "required": [
   "symbol",
   "quantity",
   "address"
  ],
  "type": "object"
 },
 "name": "withdraw"
}
