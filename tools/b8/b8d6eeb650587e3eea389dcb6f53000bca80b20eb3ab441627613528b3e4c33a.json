{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find filings by ticker"
 },
 "description": "Find recent SEC filings for any company in the SEC's ticker list, by ticker or CIK, with filing ids, form types, dates, accession numbers and original SEC links. Returns up to 20 filings from the company's recent EDGAR window.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "form": {
    "enum": [
     "10-K",
     "10-Q",
     "8-K",
     "10-K/A",
     "10-Q/A",
     "20-F",
     "40-F"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "ticker": {
    "description": "A ticker in EDGAR spelling (BRK-B), or a CIK such as 320193.",
    "pattern": "^[A-Za-z0-9.-]{1,13}$",
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "list_filings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_url": {
    "type": "string"
   },
   "company": {
    "additionalProperties": false,
    "properties": {
     "cik": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "fiscalYearEnd": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "sic": {
      "type": "string"
     },
     "sicDescription": {
      "type": "string"
     },
     "ticker": {
      "type": "string"
     }
    },
    "required": [
     "cik",
     "ticker",
     "name"
    ],
    "type": "object"
   },
   "docs_url": {
    "type": "string"
   },
   "error": {
    "maxLength": 80,
    "type": "string"
   },
   "filings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accession": {
       "type": "string"
      },
      "filingDate": {
       "type": "string"
      },
      "form": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "pageUrl": {
       "type": "string"
      },
      "reportDate": {
       "type": "string"
      },
      "sectionsUrl": {
       "type": "string"
      },
      "sourceUrl": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "form",
      "accession",
      "filingDate",
      "reportDate",
      "sourceUrl",
      "pageUrl",
      "sectionsUrl"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "http_status": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "message": {
    "type": "string"
   },
   "retry_after": {
    "maxLength": 80,
    "type": "string"
   },
   "status": {
    "enum": [
     "success",
     "tool_error",
     "internal_error"
    ],
    "type": "string"
   },
   "usage": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "status",
   "docs_url"
  ],
  "type": "object"
 },
 "title": "Find filings by ticker"
}
