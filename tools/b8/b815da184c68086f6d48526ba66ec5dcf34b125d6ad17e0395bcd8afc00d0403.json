  "readOnlyHint": true,
  "title": "My orders"
 },
 "description": "Use this when a signed in customer asks about their recent teas.co.uk orders. limit is how many of the most recent orders to return, newest first, from 1 to 20 (default 5). There is no paging, so raise it only when the customer asks about older orders. Each order includes can_return. An empty list means the linked account has no orders. Without a linked account it returns an error asking the customer to sign in. To follow one order use track_order, to buy an order again use reorder, and to return items use start_return.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "How many recent orders (default 5).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "my_orders",
 "outputSchema": {
  "properties": {
