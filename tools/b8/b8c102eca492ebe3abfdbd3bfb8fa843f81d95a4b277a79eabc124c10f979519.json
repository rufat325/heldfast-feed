 },
 "description": "A run's profile on a 10 m grid \u2014 elevation, heart rate, power, cadence \u2014 as min, average, max and coverage per channel, not every sample. Also each half by distance with its moving pace, heart rate and efficiency, and the drift between them (aerobic decoupling, Pa:HR). No profile is a normal answer for an indoor run.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "activity_id": {
    "description": "Run id from ourpr_list_runs.",
    "type": "string"
   }
  },
  "required": [
   "activity_id"
  ],
  "type": "object"
 },
 "name": "ourpr_run_stream",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "channels": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "grid_m": {
    "type": "number"
   },
   "halves": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "samples": {
    "type": "number"
   },
   "total_miles": {
    "type": "number"
   }
  },
  "required": [
   "grid_m",
   "total_miles",
   "samples",
   "channels",
   "halves"
  ],
  "type": "object"
 },
 "title": "Get a run's elevation and sensor profile"
}
