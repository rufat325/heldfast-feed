{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Fraction to decimal converter"
 },
 "description": "Convert between fractions and decimals. Mode 'toDecimal': give a numerator and denominator (whole numbers) to get the decimal and percentage. Mode 'toFraction': give a decimal to get the closest simplified fraction (denominator up to 10,000), noting whether it is exact. Source: https://hopi.co.uk/fraction-to-decimal/",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "mode": {
       "const": "toDecimal"
      }
     }
    },
    "then": {
     "required": [
      "numerator",
      "denominator"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "mode": {
       "const": "toFraction"
      }
     }
    },
    "then": {
     "required": [
      "decimal"
     ]
    }
   }
  ],
  "properties": {
   "decimal": {
    "description": "The decimal to convert (mode 'toFraction')",
    "type": "number"
   },
   "denominator": {
    "description": "Denominator, not zero (mode 'toDecimal')",
    "not": {
     "const": 0
    },
    "type": "integer"
   },
   "mode": {
    "description": "'toDecimal' from a fraction, or 'toFraction' from a decimal",
    "enum": [
     "toDecimal",
     "toFraction"
    ],
    "type": "string"
   },
   "numerator": {
    "description": "Numerator (mode 'toDecimal')",
    "type": "integer"
   }
  },
  "required": [
   "mode"
  ],
  "type": "object"
 },
 "name": "hopi_fraction_to_decimal",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "decimal": {
    "type": "number"
   },
   "denominator": {
    "type": "number"
   },
   "exact": {
    "type": "boolean"
   },
   "mode": {
    "type": "string"
   },
   "numerator": {
    "type": "number"
   },
   "percentage": {
    "type": "string"
   },
   "recurring": {
    "type": "boolean"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "decimal",
   "denominator",
   "exact",
   "mode",
   "numerator",
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Fraction to decimal converter"
}
