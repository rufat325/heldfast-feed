{"annotations":{"destructiveHint":false,"readOnlyHint":false},"description":"Capture a window of Godot's function profiler - the editor's Profiler tab numbers. Requires run_project with profiling: true. Blocks for `seconds` (default 5). Times are elapsed, not CPU; inclusive rows overlap - never sum totalMs. Returns: rows (function, file, line, calls, selfMs/totalMs, per-frame averages, percentOfFrame, peak), the frame budget, servers, worstFrame, plus frames/frameGaps/limitReached for capture quality. Errors if profiling was off at launch or a capture is already open.","inputSchema":{"properties":{"captureLimit":{"description":"Rows the engine puts in each frame packet, 16..512 (default: 512). Godot selects them by inclusive time, so a lower limit hides cheap functions and sets limitReached.","type":"number"},"seconds":{"description":"Capture duration in seconds, greater than 0 and at most 60 (default: 5).","type":"number"},"sort":{"description":"Rank by own time (\"selfMs\", default), inclusive time (\"totalMs\"), or invocation count (\"calls\").","enum":["selfMs","totalMs","calls"],"type":"string"},"top":{"description":"How many functions to return, 1..100 (default: 20).","type":"number"}},"required":[],"type":"object"},"name":"profile_project","outputSchema":{"properties":{"captureLimit":{"type":"number"},"firstFrame":{"type":["number","null"]},"frame":{"properties":{"frameMs":{"properties":{"avg":{"type":"number"},"max":{"type":"number"}},"type":"object"},"physicsFrameMs":{"properties":{"avg":{"type":"number"},"max":{"type":"number"}},"type":"object"},"physicsMs":{"properties":{"avg":{"type":"number"},"max":{"type":"number"}},"type":"object"},"processMs":{"properties":{"avg":{"type":"number"},"max":{"type":"number"}},"type":"object"},"scriptMs":{"properties":{"avg":{"type":"number"},"max":{"type":"number"}},"type":"object"}},"type":"object"},"frameGaps":{"type":"number"},"frames":{"type":"number"},"framesReceived":{"type":"number"},"functionsReceived":{"type":"n