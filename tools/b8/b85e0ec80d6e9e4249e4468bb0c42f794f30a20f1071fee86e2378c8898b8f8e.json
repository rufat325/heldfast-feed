{
 "description": "Start an ABAP Unit test run for provided class test definitions. Returns run_id for status/result queries.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "context": {
    "description": "Optional context string shown in SAP tools.",
    "type": "string"
   },
   "duration": {
    "properties": {
     "long": {
      "type": "boolean"
     },
     "medium": {
      "type": "boolean"
     },
     "short": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "risk_level": {
    "properties": {
     "critical": {
      "type": "boolean"
     },
     "dangerous": {
      "type": "boolean"
     },
     "harmless": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "scope": {
    "properties": {
     "add_foreign_tests_as_preview": {
      "type": "boolean"
     },
     "foreign_tests": {
      "type": "boolean"
     },
     "own_tests": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "tests": {
    "description": "List of container/test class pairs to execute.",
    "items": {
     "properties": {
      "container_class": {
       "description": "Class that owns the test include.",
       "type": "string"
      },
      "test_class": {
       "description": "Test class name inside the include (e.g., LTCL_MAIN_CLASS).",
       "type": "string"
      }
     },
     "required": [
      "container_class",
      "test_class"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "Optional title for the ABAP Unit run.",
    "type": "string"
   }
  },
  "required": [
   "tests"
  ],
  "type": "object"
 },
 "name": "RunUnitTest"
}
