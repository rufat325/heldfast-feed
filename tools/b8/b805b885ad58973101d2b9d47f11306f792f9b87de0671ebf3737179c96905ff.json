{
 "description": "Attach a file (manual, receipt, photo, warranty, etc.) to an item. File contents must be base64-encoded.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data_base64": {
    "description": "Base64-encoded file contents",
    "type": "string"
   },
   "filename": {
    "description": "Filename to store the attachment as (e.g. manual.pdf)",
    "type": "string"
   },
   "item_id": {
    "description": "ID of the item to attach the file to",
    "type": "string"
   },
   "kind": {
    "description": "Type of attachment",
    "enum": [
     "manual",
     "receipt",
     "photo",
     "warranty",
     "other"
    ],
    "type": "string"
   },
   "label": {
    "description": "Human-readable label (e.g. 'Washing machine manual')",
    "type": "string"
   }
  },
  "required": [
   "item_id",
   "filename",
   "kind",
   "data_base64"
  ],
  "type": "object"
 },
 "name": "add_attachment"
}
