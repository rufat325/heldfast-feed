{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find meters when the exact slug is unknown. The backend searches for a literal, case-insensitive substring in slug, label, group and sourceNote, and orders matches by slug. This is not semantic search; no matches returns an empty meters array. Use list_meters to browse all meters.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "query": {
    "description": "Non-empty search text, for example water or GPU. Percent and underscore are literal characters, not wildcards.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_meters",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "meters": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "calculationMode": {
       "enum": [
        "snapshot",
        "live_today",
        "live_ytd",
        "rolling_window",
        "manual_estimate"
       ],
       "type": "string"
      },
      "confidenceLevel": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      },
      "group": {
       "type": "string"
      },
      "id": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "lastUpdate": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
       "type": "string"
      },
      "ratePerSecond": {
       "type": "number"
      },
      "slug": {
       "type": "string"
      },
      "sourceNote": {
       "anyOf": [
        {
         "description": "Source note supplied by the backend.",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "titleKey": {
       "type": "string"
      },
      "unit": {
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "slug",
      "label",
      "unit",
      "value",
      "titleKey",
      "ratePerSecond",
      "lastUpdate",
      "group",
      "calculationMode",
      "confidenceLevel",
      "sourceNote"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "meters"
  ],
  "type": "object"
 }
}
