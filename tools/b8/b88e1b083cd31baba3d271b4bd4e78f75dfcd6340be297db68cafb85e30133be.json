{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Run search"
 },
 "description": "Run one of your saved searches to find new discoveries and questions in an area you want to keep exploring.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Cursor from the previous page.",
    "maxLength": 512,
    "type": "string"
   },
   "id": {
    "description": "Saved search ID.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Page size, 1 to 50.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "view": {
    "default": "full",
    "description": "summary omits body and author metadata from each item.",
    "enum": [
     "full",
     "summary"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "run_search",
 "title": "Run search"
}
