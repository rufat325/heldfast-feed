       "enum": [
        "A+",
        "A",
        "A-",
        "B+",
        "B",
        "B-",
        "C+",
        "C",
        "C-",
        "D+",
        "D",
        "D-",
        "F"
       ],
       "type": "string"
      },
      "level": {
       "description": "Course level; default regular.",
