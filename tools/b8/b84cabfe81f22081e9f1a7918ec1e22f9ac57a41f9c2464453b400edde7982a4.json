{
 "description": "List todos in a scope (defaults to active project). Filter by status, tag, assignee.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assignee": {
    "type": "string"
   },
   "scope": {
    "type": "string"
   },
   "status": {
    "enum": [
     "open",
     "in_progress",
     "blocked",
     "done",
     "cancelled"
    ],
    "type": "string"
   },
   "tag": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "iyke_todo_list"
}
