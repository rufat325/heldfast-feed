{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Browse the conduitAI catalog by asset type. Results contain third-party metadata.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max results (1-20, default 10)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "Sort order",
    "enum": [
     "popular",
     "recent"
    ],
    "type": "string"
   },
   "type": {
    "description": "Asset type to browse",
    "enum": [
     "mcp_server",
     "mcp_client",
     "agent",
     "skill",
     "prompt",
     "plugin"
    ],
    "type": "string"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
 "name": "browse_catalog",
 "title": "Browse conduitAI catalog"
}
