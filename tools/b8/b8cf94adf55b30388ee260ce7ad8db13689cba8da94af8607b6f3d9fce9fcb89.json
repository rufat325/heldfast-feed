 "description": "Step 1 of 2 for a personality sketch. Casts the chart and returns the chart facts plus a fill-in template (\u8c61 image / \u91cc beneath / \u884c practice) for YOU, the assistant, to write \u2014 a short literary sketch grounded only in the returned facts, within the stated limits (no strength verdict, no favorable elements, no Ten Gods, no luck-cycle reading). Step 2: pass your three texts to compose_sketch and present its framed sheet verbatim. Deterministic facts; the prose is yours; the framing is the server\u2019s.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "day": {
    "description": "Birth day of month, 1\u201331",
    "maximum": 31,
    "minimum": 1,
    "type": "integer"
   },
   "hour": {
    "description": "Recorded wall-clock hour, 24-hour format",
    "maximum": 23,
    "minimum": 0,
    "type": "integer"
   },
   "lang": {
    "description": "Language of the rendered output \u2014 pass the language the user is conversing in. Defaults to 'en'.",
    "enum": [
     "en",
     "zh"
    ],
    "type": "string"
   },
   "longitude": {
    "description": "Birthplace longitude in degrees, east positive (Beijing \u2248 116.4, Vancouver \u2248 -123.1)",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "minute": {
    "description": "Recorded wall-clock minute, 0\u201359",
    "maximum": 59,
    "minimum": 0,
    "type": "integer"
   },
   "month": {
    "description": "Birth month, 1\u201312",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "timeZone": {
    "description": "IANA time zone of the birthplace, e.g. 'Asia/Shanghai', 'America/Vancouver'",
    "type": "string"
   },
   "year": {
    "description": "Birth year, Gregorian calendar (engine ephemeris covers 1900\u20132100)",
    "maximum": 2100,
    "minimum": 1900,
    "type": "integer"
   }
  },
  "required": [
   "year",
   "month",
   "day",
   "hour",
   "minute",
   "timeZone",
   "longitude"
  ],
  "type": "object"
 },
