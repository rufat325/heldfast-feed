{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a work order"
 },
 "description": "Update a work order's details. Buildium's PUT replaces the whole record, so this reads the current work order first and only changes the fields you pass \u2014 everything else (including line items and entry contacts) is preserved. Passing line_items REPLACES all existing line items. Status/priority/due date live on the linked task. Buildium: GET then PUT /v1/workorders/{workOrderId}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "chargeable_to": {
    "description": "Who will be charged (max 100).",
    "maxLength": 100,
    "type": "string"
   },
   "entry_allowed": {
    "description": "Whether entry to the unit is allowed.",
    "enum": [
     "Unknown",
     "Yes",
     "No"
    ],
    "type": "string"
   },
   "entry_contact_ids": {
    "description": "Replace the entry contact user ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "entry_notes": {
    "description": "Notes on entering the unit.",
    "type": "string"
   },
   "invoice_number": {
    "description": "Vendor invoice/reference number (max 50).",
    "maxLength": 50,
    "type": "string"
   },
   "line_items": {
    "description": "Replace ALL line items with this list.",
    "items": {
     "properties": {
      "gl_account_id": {
       "description": "General ledger account id.",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "memo": {
       "description": "Line item memo.",
       "type": "string"
      },
      "quantity": {
       "description": "Line item quantity.",
       "type": "number"
      },
      "unit_price": {
       "description": "Line item unit price.",
       "type": "number"
      }
     },
     "required": [
      "quantity",
      "unit_price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "New title (max 127).",
    "maxLength": 127,
    "type": "string"
   },
   "vendor_id": {
    "description": "Reassign to this vendor id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "vendor_notes": {
    "description": "Notes for the vendor.",
    "type": "string"
   },
   "work_details": {
    "description": "New description of the work.",
    "type": "string"
   },
   "work_order_id": {
    "description": "The work order id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "work_order_id"
  ],
  "type": "object"
 },
 "name": "buildium_update_work_order",
 "title": "Update a work order"
}
