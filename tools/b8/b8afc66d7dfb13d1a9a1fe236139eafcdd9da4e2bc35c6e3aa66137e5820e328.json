   "body": {
    "additionalProperties": {},
    "description": "\u0422\u0435\u043b\u043e \u0437\u0430\u043f\u0440\u043e\u0441\u0430 \u0432 JSON, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 {\"filter\":{},\"limit\":20,\"page\":1} \u0434\u043b\u044f \u044d\u043d\u0434\u043f\u043e\u0438\u043d\u0442\u0430 \u0441\u043f\u0438\u0441\u043a\u0430.",
    "type": "object"
   },
   "confirmWrite": {
    "description": "\u0414\u043b\u044f POST \u0438 DELETE \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c true. \u0423\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0444\u043b\u0430\u0433\u0430 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e \u043f\u0443\u0442\u044c \u043c\u043e\u0436\u0435\u0442 \u043f\u0438\u0441\u0430\u0442\u044c: funds-transfer \u0438 delete-user \u2014 \u0442\u0430\u043a\u0438\u0435 \u0436\u0435 POST/DELETE, \u043a\u0430\u043a \u0438 \u043b\u044e\u0431\u043e\u0435 \u0447\u0442\u0435\u043d\u0438\u0435 \u0441\u043f\u0438\u0441\u043a\u0430.",
