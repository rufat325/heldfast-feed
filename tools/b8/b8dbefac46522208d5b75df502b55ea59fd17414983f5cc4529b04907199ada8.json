     "roguelite",
     "rpg",
     "shooter",
     "simulation",
     "soccer",
     "sports",
     "strategy",
     "trivia",
     "word"
    ],
    "type": "string"
   },
   "limit": {
    "default": 6,
    "description": "How many games to return",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "madeFor": {
    "default": "any",
    "description": "Only games made for this device. Every game also plays in a computer browser on remix.gg.",
    "enum": [
     "phone",
     "computer",
     "any"
    ],
    "type": "string"
   },
   "query": {
    "description": "Words to search game names for",
    "maxLength": 80,
    "minLength": 1,
