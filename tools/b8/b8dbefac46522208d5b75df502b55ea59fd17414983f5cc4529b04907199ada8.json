 "description": "Use this when the user names a game or describes one in their own words, such as \"Tower Blocks\" or \"space shooter\", optionally in one genre or for one device. Returns free browser games made by creators on remix.gg.",
 "inputSchema": {
  "properties": {
   "genre": {
    "description": "A Remix genre, such as puzzle, racing, match-3, soccer or roguelite",
    "enum": [
     "action",
     "adventure",
     "basketball",
     "board",
     "card",
     "casual",
     "clicker",
     "cooking",
     "driving",
     "education",
