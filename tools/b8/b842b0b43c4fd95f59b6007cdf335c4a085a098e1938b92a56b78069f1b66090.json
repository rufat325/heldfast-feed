{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Calculate FDA Nutrition Facts label"},"description":"Calculate a US FDA Nutrition Facts label from a formula: FDA rounding (21 CFR 101.9), % Daily Values, RACC-based serving size, servings per container, single vs dual-column format, plus ingredient, allergen and net-quantity statements and nutrient-content claim checks. Ingredient quantities are batch amounts; nutrients are per 100 g of each ingredient. Missing nutrients are treated as 0 and reported back, so the label is only as good as its inputs: it must be verified before printing.","inputSchema":{"additionalProperties":false,"properties":{"ingredients":{"items":{"properties":{"allergens":{"items":{"enum":["Milk","Egg","Fish","Crustacean Shellfish","Tree Nuts","Peanuts","Wheat","Soy","Sesame"],"type":"string"},"type":"array"},"label_name":{"description":"Name for the ingredient statement; defaults to name.","type":"string"},"name":{"type":"string"},"nutrient_source":{"default":"manual","enum":["supplier_spec","lab","customer_db","usda","calculated","manual","ai_estimate"],"type":"string"},"nutrients_per_100g":{"additionalProperties":false,"description":"kcal; fat, sat, trans, carb, fiber, sugar, added, prot in g; chol, na, ca, fe, k in mg; vitd in mcg.","properties":{"added":{"minimum":0,"type":"number"},"ca":{"minimum":0,"type":"number"},"carb":{"minimum":0,"type":"number"},"chol":{"minimum":0,"type":"number"},"fat":{"minimum":0,"type":"number"},"fe":{"minimum":0,"type":"number"},"fiber":{"minimum":0,"type":"number"},"k":{"minimum":0,"type":"number"},"kcal":{"minimum":0,"type":"number"},"na":{"minimum":0,"type":"number"},"prot":{"minimum":0,"type":"number"},"sat":{"minimum":0,"type":"number"},"sugar":{"minimum":0,"type":"number"},"trans":{"minimum":0,"type":"number"},"vitd":{"minimum":0,"type":"number"}},"type":"object"},"quantity":{"description":"Amount in the batch.","type":"number"},"unit":{"default":"g","enum":["g","kg","lb","oz"],"type":"string"},"verified":{"default":false,"type":"boolean"}},"required":["name","quantity","nutrients_per_100g"],"type":"object"},"maxItems":60,"minItems":1,"type":"array"},"product":{"properties":{"density_g_per_ml":{"description":"For liquids sold by volume. Default 1.0.","type":"number"},"format":{"default":"auto","enum":["auto","standard","dual"],"type":"string"},"household_measure":{"description":"e.g. '2 cookies (30g)', '1 can', '2 tbsp'.","type":"string"},"may_contain":{"description":"Optional advisory allergen statement.","type":"string"},"name":{"type":"string"},"net_quantity":{"properties":{"unit":{"enum":["g","oz","lb","kg","fl_oz","mL","L"],"type":"string"},"value":{"type":"number"}},"required":["value","unit"],"type":"object"},"processing_loss_pct":{"description":"Moisture/processing loss from batch to finished product, percent. Default 0.","maximum":99,"minimum":0,"type":"number"},"protein_dv":{"default":false,"description":"Declare protein %DV (requires PDCAAS).","type":"boolean"},"racc_g":{"description":"Only for categories that need a gram RACC.","type":"number"},"racc_id":{"description":"FDA RACC category id, e.g. 'cookies'.","type":"string"},"serving_quantity":{"description":"Optional; defaults to the RACC.","properties":{"unit":{"enum":["g","oz","lb","kg","fl_oz","mL","L"],"type":"string"},"value":{"type":"number"}},"required":["value","unit"],"type":"object"}},"required":["name","racc_id","net_quantity","household_measure"],"type":"object"}},"required":["product","ingredients"],"type":"object"},"name":"calculate_nutrition_label","title":"Calculate an FDA Nutrition Facts label"}
