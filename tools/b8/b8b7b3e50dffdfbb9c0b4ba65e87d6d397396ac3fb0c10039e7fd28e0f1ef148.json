{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Query multiple time-series monitoring data from Cloud Insight in a single request (up to 20 metric conditions).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "metricInfoList": {
    "description": "Array of metric queries to execute (max 20)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "aggregation": {
       "description": "Aggregation type (default: AVG)",
       "enum": [
        "COUNT",
        "SUM",
        "MAX",
        "MIN",
        "AVG"
       ],
       "type": "string"
      },
      "dimensions": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Dimensions identifying the resource as key-value pairs",
       "type": "object"
      },
      "interval": {
       "description": "Aggregation interval",
       "enum": [
        "Min1",
        "Min5",
        "Min30",
        "Hour2",
        "Day1"
       ],
       "type": "string"
      },
      "metric": {
       "description": "Metric name to query",
       "type": "string"
      },
      "prodKey": {
       "description": "Product key (cw_key)",
       "type": "string"
      },
      "queryAggregation": {
       "$ref": "#/properties/metricInfoList/items/properties/aggregation",
       "description": "Query result aggregation (default: AVG)"
      }
     },
     "required": [
      "prodKey",
      "metric",
      "interval",
      "dimensions"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "timeEnd": {
    "description": "End time in Unix epoch milliseconds",
    "type": "number"
   },
   "timeStart": {
    "description": "Start time in Unix epoch milliseconds",
    "type": "number"
   }
  },
  "required": [
   "metricInfoList",
   "timeStart",
   "timeEnd"
  ],
  "type": "object"
 },
 "name": "ncloud_query_monitoring_data_multiple"
}
