{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find an MCP server"
 },
 "description": "Find official, vendor-run remote MCP servers in the Koskamo MCP directory. Every listed endpoint passed a recent live check; returns the endpoint URL, sign-in type, documentation link, and known tools.",
 "inputSchema": {
  "properties": {
   "auth": {
    "description": "Optional sign-in filter; none means usable without an account; oauth-optional means public tools work anonymously and account tools prompt OAuth sign-in",
    "enum": [
     "none",
     "oauth-optional",
     "oauth",
     "api-key"
    ],
    "type": "string"
   },
   "category": {
    "description": "Optional category filter",
    "enum": [
     "docs-reference",
     "developer-tools",
     "cloud-infrastructure",
     "data-analytics",
     "ai-ml",
     "commerce",
     "payments",
     "productivity",
     "project-management",
     "crm-marketing",
     "design"
    ],
    "type": "string"
   },
   "query": {
    "description": "Words to match against name, operator, description, use cases, and tool names",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "koskamo_find_mcp_server",
 "outputSchema": {
  "properties": {
   "servers": {
    "items": {
     "properties": {
      "auth": {
       "enum": [
        "none",
        "oauth-optional",
        "oauth",
        "api-key"
       ],
       "type": "string"
      },
      "category": {
       "enum": [
        "docs-reference",
        "developer-tools",
        "cloud-infrastructure",
        "data-analytics",
        "ai-ml",
        "commerce",
        "payments",
        "productivity",
        "project-management",
        "crm-marketing",
        "design"
       ],
       "type": "string"
      },
      "companyUrl": {
       "description": "Company website",
       "format": "uri",
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "directoryUrl": {
       "format": "uri",
       "type": "string"
      },
      "docsUrl": {
       "format": "uri",
       "type": "string"
      },
      "endpoint": {
       "format": "uri",
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "operator": {
       "type": "string"
      },
      "tools": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "transport": {
       "type": "string"
      },
      "useCases": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "verifiedAt": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "name",
      "operator",
      "endpoint",
      "transport",
      "auth",
      "category",
      "docsUrl",
      "directoryUrl"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "servers"
  ],
  "type": "object"
 },
 "title": "Find an MCP server"
}
