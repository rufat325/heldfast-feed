{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Revoke the Bearer key used for this call and return a fresh mk_live_ key (shown once). Works for deactivated merchants too, so open orders can still be closed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "encryption_key": {
    "additionalProperties": false,
    "description": "Optional: ALSO replace the buyer-data encryption key. New kid, same sig_by_wallet rule as registration. Envelopes sealed to the old kid are not re-encrypted: fetch them first.",
    "properties": {
     "alg": {
      "type": "string"
     },
     "kid": {
      "type": "string"
     },
     "pub": {
      "type": "string"
     },
     "sig_by_wallet": {
      "description": "EIP-191 signature by `wallet` over the encryption-key text.",
      "type": "string"
     }
    },
    "required": [
     "kid",
     "alg",
     "pub",
     "sig_by_wallet"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "shop.merchant.rotate_key",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "type": "string"
   },
   "terms_update_pending": {
    "additionalProperties": false,
    "description": "Present when a newer document version awaits re-acceptance (30-day window).",
    "properties": {
     "docs": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "doc_id": {
         "type": "string"
        },
        "sha256": {
         "type": "string"
        },
        "url": {
         "type": "string"
        },
        "version": {
         "type": "string"
        }
       },
       "required": [
        "doc_id",
        "version",
        "sha256"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "docs"
    ],
    "type": "object"
   }
  },
  "required": [
   "api_key"
  ],
  "type": "object"
 },
 "title": "Rotate merchant API key"
}
