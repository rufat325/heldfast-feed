{
 "annotations": {
  "readOnlyHint": true,
  "title": "Search patients"
 },
 "description": "Search patients within a location by name, email, phone, or date of birth. Patient search is always in a location context. GET /patients.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date_of_birth": {
    "description": "Patient date of birth, yyyy-mm-dd.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "email": {
    "description": "Patient email filter.",
    "type": "string"
   },
   "inactive": {
    "description": "Include inactive patients.",
    "type": "boolean"
   },
   "location_id": {
    "description": "Location id to search within (REQUIRED).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "name": {
    "description": "Full or partial patient name.",
    "type": "string"
   },
   "page": {
    "description": "Page number (pagination).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page (pagination).",
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "integer"
   },
   "phone_number": {
    "description": "Patient phone number filter.",
    "type": "string"
   },
   "sort": {
    "description": "Sort field/direction, e.g. name or -created_at.",
    "type": "string"
   },
   "subdomain": {
    "description": "Institution subdomain. Defaults to NEXHEALTH_SUBDOMAIN if unset.",
    "type": "string"
   }
  },
  "required": [
   "location_id"
  ],
  "type": "object"
 },
 "name": "nexhealth_search_patients",
 "title": "Search patients"
}
