{
 "annotations": {
  "destructiveHint": true,
  "title": "Log an activity"
 },
 "description": "Create an activity \u2014 log an interaction with a constituent (call, meeting, note) or schedule a task. Needs a subject, a start date, a time zone id (neon_list_properties name=systemTimezones), a status id (name=activityStatuses) and a priority; link it to accounts and assign it to system users. Returns the new id. Neon: POST /activities.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "account_ids": {
    "description": "Accounts this activity is about.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "end_date": {
    "description": "End date, YYYY-MM-DD.",
    "type": "string"
   },
   "end_time": {
    "description": "End time.",
    "type": "string"
   },
   "note": {
    "description": "The body / notes.",
    "type": "string"
   },
   "priority": {
    "description": "Priority.",
    "enum": [
     "High",
     "Normal",
     "Low"
    ],
    "type": "string"
   },
   "start_date": {
    "description": "Start date, YYYY-MM-DD.",
    "type": "string"
   },
   "start_time": {
    "description": "Start time, e.g. 09:30.",
    "type": "string"
   },
   "status_id": {
    "description": "Activity status id (neon_list_properties name=activityStatuses).",
    "type": "string"
   },
   "subject": {
    "description": "Short subject line.",
    "minLength": 1,
    "type": "string"
   },
   "system_user_ids": {
    "description": "System users it is assigned to.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "time_zone_id": {
    "description": "Time zone id (neon_list_properties name=systemTimezones).",
    "type": "string"
   }
  },
  "required": [
   "subject",
   "start_date",
   "time_zone_id",
   "status_id",
   "priority"
  ],
  "type": "object"
 },
 "name": "neon_create_activity",
 "title": "Log an activity"
}
