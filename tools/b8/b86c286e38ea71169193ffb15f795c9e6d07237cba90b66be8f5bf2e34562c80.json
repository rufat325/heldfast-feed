{
 "_meta": {
  "openai/outputTemplate": "ui://xona-dental-gateway/card.html",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://xona-dental-gateway/card.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List open times one of the patient's appointments can move to, for its own service and provider, between date_from and date_to. appointment_ref comes from list_xona_appointments.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action_id": {
    "maxLength": 128,
    "minLength": 16,
    "type": "string"
   },
   "appointment_ref": {
    "maxLength": 64,
    "minLength": 8,
    "type": "string"
   },
   "date_from": {
    "description": "First day to search, in the practice's time zone",
    "format": "date",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "date_to": {
    "description": "Last day to search (inclusive); at most 56 days after date_from and 8 weeks from today",
    "format": "date",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   }
  },
  "required": [
   "action_id",
   "appointment_ref",
   "date_from",
   "date_to"
  ],
  "type": "object"
 },
 "name": "list_xona_reschedule_times",
 "outputSchema": {
  "properties": {
   "action_id": {
    "type": "string"
   },
   "appointment_ref": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "practice": {
    "properties": {
     "name": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "name"
    ],
    "type": "object"
   },
   "slots": {
    "items": {
     "properties": {
      "date": {
       "type": "string"
      },
      "display": {
       "type": "string"
      },
      "end": {
       "format": "date-time",
       "type": "string"
      },
      "provider": {
       "type": "string"
      },
      "slot_fingerprint": {
       "type": "string"
      },
      "start": {
       "format": "date-time",
       "type": "string"
      }
     },
     "required": [
      "slot_fingerprint",
      "date",
      "display",
      "start",
      "end"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "time_zone": {
    "type": "string"
   }
  },
  "required": [
   "action_id",
   "practice",
   "appointment_ref",
   "time_zone",
   "slots",
   "next_step"
  ],
  "type": "object"
 },
 "title": "List times an appointment can move to"
}
