{
 "description": "Legacy alias for keyword_search_news. Keyword search over title/summary and optional section; use search_news for semantic/vector search.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "description": "Max results (default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Keyword search over title + summary",
    "type": "string"
   },
   "section": {
    "description": "Filter to one section slug",
    "enum": [
     "politics",
     "infrastructure",
     "business",
     "community",
     "culture"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_pr_news"
}
