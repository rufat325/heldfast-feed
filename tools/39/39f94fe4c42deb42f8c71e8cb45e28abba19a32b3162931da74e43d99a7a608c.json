{
 "annotations": {
  "readOnlyHint": true,
  "title": "List entities"
 },
 "description": "List nearby tracked entities, nearest-first, filtered by type/kind/mobType/username/name and/or maxDistance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "format": {
    "description": "Response detail level; \"concise\" (default) or \"detailed\"",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "kind": {
    "description": "Entity kind, e.g. \"Hostile mobs\"",
    "type": "string"
   },
   "limit": {
    "description": "Max entities to return (default 50)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "maxDistance": {
    "description": "Only entities within this many blocks",
    "minimum": 0,
    "type": "number"
   },
   "mobType": {
    "description": "Mob type/display name, e.g. \"Zombie\"",
    "type": "string"
   },
   "name": {
    "description": "Entity name, e.g. \"zombie\", \"item\"",
    "type": "string"
   },
   "type": {
    "description": "Entity type, e.g. \"player\", \"mob\", \"object\"",
    "type": "string"
   },
   "username": {
    "description": "Player username (players only)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_entities"
}
