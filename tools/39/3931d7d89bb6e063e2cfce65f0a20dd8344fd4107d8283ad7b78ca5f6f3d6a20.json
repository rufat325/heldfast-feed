{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read a list of urls"
 },
 "description": "A batch OF SCRAPES: reads a list of urls YOU give it (2 to 50, from any sites) and returns a jobId. It discovers nothing on its own \u2014 for that use web_crawl. Charged up front per url; urls that fail and urls served from the cache are refunded. Poll it with web_batch_status.",
 "inputSchema": {
  "properties": {
   "binaryAs": {
    "default": "base64",
    "description": "How a screenshot or a PDF comes back. `base64` is the only value today.",
    "enum": [
     "base64",
     "url"
    ],
    "type": "string"
   },
   "block": {
    "additionalProperties": false,
    "description": "What not to load, which makes a render faster and cheaper. `resourceTypes` takes image, font, stylesheet, media\u2026 and `urlPatterns` are regular expressions, not globs: `\\.svg$`, not `*.svg`.",
    "properties": {
     "resourceTypes": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     },
     "urlPatterns": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "controls": {
    "additionalProperties": false,
    "description": "Options for the `controls` format: `visibleOnly`, and `limit` (1 to 1000) to cut the map.",
    "properties": {
     "limit": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
     },
     "visibleOnly": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "formats": {
    "description": "Outputs you want in the same response. `controls` is the map of what can be clicked; `elements` needs `selectors`; `json` needs `json.prompt` or `json.schema`. A screenshot or a PDF is not available here: every result is kept until you collect it. Ask for those one url at a time on web_scrape.",
    "items": {
     "enum": [
      "html",
      "markdown",
      "links",
      "elements",
      "json",
      "accessibility",
      "controls"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "json": {
    "additionalProperties": false,
    "description": "For the `json` format: a `prompt` describing what to pull out, a JSON `schema` to fill, or both.",
    "properties": {
     "model": {
      "minLength": 1,
      "type": "string"
     },
     "prompt": {
      "minLength": 1,
      "type": "string"
     },
     "schema": {
      "additionalProperties": {},
      "type": "object"
     }
    },
    "type": "object"
   },
   "links": {
    "additionalProperties": false,
    "description": "Options for the `links` format: `visibleOnly`, `excludeExternal` to keep only internal links.",
    "properties": {
     "excludeExternal": {
      "type": "boolean"
     },
     "visibleOnly": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "maxAge": {
    "description": "Accept an answer up to this many milliseconds old. A cache hit costs $0.0002 instead of the format price. Leave it out to force a fresh render.",
    "maximum": 604800000,
    "minimum": 0,
    "type": "integer"
   },
   "request": {
    "additionalProperties": false,
    "description": "How to make the request: `headers`, `cookies`, `userAgent`, and `auth` for basic authentication.",
    "properties": {
     "auth": {
      "additionalProperties": false,
      "properties": {
       "password": {
        "type": "string"
       },
       "username": {
        "type": "string"
       }
      },
      "required": [
       "username",
       "password"
      ],
      "type": "object"
     },
     "cookies": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "domain": {
         "type": "string"
        },
        "httpOnly": {
         "type": "boolean"
        },
        "name": {
         "minLength": 1,
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "secure": {
         "type": "boolean"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "headers": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "userAgent": {
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "selectors": {
    "description": "CSS selectors for the `elements` format.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "urls": {
    "description": "The pages of this batch. Two to fifty, no duplicates: a batch charges per url.",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 2,
    "type": "array"
   },
   "viewport": {
    "additionalProperties": false,
    "description": "The window to render in: `width`, `height`, `deviceScaleFactor`.",
    "properties": {
     "deviceScaleFactor": {
      "maximum": 3,
      "minimum": 0.1,
      "type": "number"
     },
     "height": {
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
     },
     "width": {
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "width",
     "height"
    ],
    "type": "object"
   },
   "wait": {
    "additionalProperties": false,
    "description": "When to consider the page loaded: `until` (load, domcontentloaded, networkidle0, networkidle2), `selector` to wait for, `timeout` in ms.",
    "properties": {
     "selector": {
      "minLength": 1,
      "type": "string"
     },
     "timeout": {
      "maximum": 60000,
      "minimum": 100,
      "type": "integer"
     },
     "until": {
      "enum": [
       "load",
       "domcontentloaded",
       "networkidle0",
       "networkidle2"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "urls"
  ],
  "type": "object"
 },
 "name": "web_scrape_batch"
}
