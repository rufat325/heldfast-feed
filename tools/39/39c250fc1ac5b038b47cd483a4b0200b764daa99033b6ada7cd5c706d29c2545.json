{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:ads"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update portfolio bid strategy"
 },
 "description": "Update portfolio bid strategy. Spending/deletion: preview, then owner-approved confirm:true with the same requestId. Other edits: one call. Creates request active; report returned status and claim live only when active. Full field guide: soclo://tools/soclo_ads_update_bid_strategy.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "properties": {
     "strategyId": {
      "type": "string"
     }
    },
    "required": [
     "strategyId"
    ],
    "type": "object"
   },
   "payload": {
    "properties": {
     "name": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "targetCpa": {
      "type": "number"
     },
     "targetImpressionShare": {
      "properties": {
       "location": {
        "enum": [
         "ANYWHERE_ON_PAGE",
         "TOP_OF_PAGE",
         "ABSOLUTE_TOP_OF_PAGE"
        ],
        "type": "string"
       },
       "maxCpc": {
        "type": "number"
       },
       "percent": {
        "maximum": 100,
        "type": "number"
       }
      },
      "required": [
       "location",
       "percent",
       "maxCpc"
      ],
      "type": "object"
     },
     "targetRoas": {
      "type": "number"
     },
     "type": {
      "enum": [
       "TARGET_CPA",
       "TARGET_ROAS",
       "MAXIMIZE_CONVERSIONS",
       "MAXIMIZE_CONVERSION_VALUE",
       "TARGET_IMPRESSION_SHARE"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "parameters",
   "payload"
  ],
  "type": "object"
 },
 "name": "soclo_ads_update_bid_strategy",
 "title": "Update portfolio bid strategy"
}
