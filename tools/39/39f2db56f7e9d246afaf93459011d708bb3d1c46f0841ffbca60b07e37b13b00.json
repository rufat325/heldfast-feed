{
 "description": "Execute a SQL query against a SQLite database. Returns results as a formatted table. Read-only by default.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "db": {
    "description": "Path to the .db or .sqlite file",
    "type": "string"
   },
   "readonly": {
    "default": true,
    "description": "If true, only SELECT/PRAGMA/EXPLAIN allowed",
    "type": "boolean"
   },
   "sql": {
    "description": "SQL query to execute",
    "type": "string"
   }
  },
  "required": [
   "db",
   "sql"
  ],
  "type": "object"
 },
 "name": "query"
}
