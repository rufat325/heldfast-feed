{
 "description": "Generate a CSS gradient.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "angle": {
    "default": 135,
    "description": "Angle in degrees (for linear/conic)",
    "type": "number"
   },
   "colors": {
    "description": "Comma-separated colors (e.g. #ff0000,#0000ff)",
    "type": "string"
   },
   "type": {
    "default": "linear",
    "description": "Gradient type",
    "enum": [
     "linear",
     "radial",
     "conic"
    ],
    "type": "string"
   }
  },
  "required": [
   "colors"
  ],
  "type": "object"
 },
 "name": "generate_gradient"
}
