{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Submit feedback on a chat response (thumbs up/down). Helps improve AI answer quality.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "messageId": {
    "description": "ID of the message to rate",
    "minLength": 1,
    "type": "string"
   },
   "promptId": {
    "description": "ID of the conversation",
    "minLength": 1,
    "type": "string"
   },
   "reason": {
    "description": "Optional explanation for the feedback",
    "type": "string"
   },
   "score": {
    "description": "Feedback score: 1 for thumbs up, -1 for thumbs down",
    "enum": [
     1,
     -1
    ],
    "type": "number"
   }
  },
  "required": [
   "promptId",
   "messageId",
   "score"
  ],
  "type": "object"
 },
 "name": "submit_chat_feedback",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Response payload from the Speak AI API"
   }
  },
  "type": "object"
 },
 "title": "Submit Chat Feedback"
}
