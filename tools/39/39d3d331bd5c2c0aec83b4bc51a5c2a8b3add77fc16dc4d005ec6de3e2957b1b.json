{
 "annotations": {
  "destructiveHint": true,
  "title": "Create an opportunity"
 },
 "description": "Create a sales opportunity (opportunity_name is required). Insightly: POST /Opportunities.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bid_amount": {
    "description": "Bid value.",
    "type": "number"
   },
   "bid_currency": {
    "description": "ISO currency code, e.g. USD.",
    "type": "string"
   },
   "bid_duration": {
    "description": "Number of bid periods (for non-fixed bid types).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "bid_type": {
    "description": "BID_TYPE \u2014 how the bid is priced, using a value your Insightly instance accepts.",
    "type": "string"
   },
   "category_id": {
    "description": "Opportunity category id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "custom_fields": {
    "description": "Custom field values to set.",
    "items": {
     "properties": {
      "field_name": {
       "description": "The custom field's FIELD_NAME, e.g. Industry__c.",
       "type": "string"
      },
      "field_value": {
       "description": "The value (null clears it).",
       "type": [
        "string",
        "number",
        "boolean",
        "null"
       ]
      }
     },
     "required": [
      "field_name",
      "field_value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "forecast_close_date": {
    "description": "Forecast close date, as \"yyyy-MM-dd HH:mm:ss\" in UTC (e.g. 2026-04-10 21:15:00).",
    "type": "string"
   },
   "opportunity_details": {
    "description": "Description.",
    "type": "string"
   },
   "opportunity_name": {
    "description": "Opportunity name (required).",
    "minLength": 1,
    "type": "string"
   },
   "organisation_id": {
    "description": "Id of the linked organisation.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "owner_user_id": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "probability": {
    "description": "Win probability, 0-100.",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "responsible_user_id": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "opportunity_name"
  ],
  "type": "object"
 },
 "name": "insightly_create_opportunity",
 "title": "Create an opportunity"
}
