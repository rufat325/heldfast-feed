{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Read only the rolling current day plus next six days, standardized into an explicit query zone, else the saved project zone, else UTC. coverage returns count-only day/hour heatmap cells; people returns paginated masked names, states, and ranges without emails or user ids. Requires project_todos:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contractIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "cursor": {
    "minLength": 1,
    "type": "string"
   },
   "granularity": {
    "enum": [
     "day",
     "hour"
    ],
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "timeZone": {
    "description": "Read-only IANA display override; never changes the saved project zone.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "view": {
    "enum": [
     "coverage",
     "people"
    ],
    "type": "string"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "opentrain_read_project_availability_schedule",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
