     "remove"
    ],
    "type": "string"
   },
   "post": {
    "description": "Target post: a numeric post id or a full status URL (e.g. https://x.com/u/status/1).",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "post",
   "action"
  ],
  "type": "object"
 },
