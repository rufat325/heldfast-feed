{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the Satmarin catalog by part number, model or free text. Order: exact SKU (case and separators ignored), SKU prefix, then words found in the title or description in any order. A word that names an antenna model, such as v100NX, also matches parts fitted to that model. Use the model filter to restrict results to one model or series.",
 "inputSchema": {
  "properties": {
   "brand": {
    "description": "Exact brand slug, e.g. intellian.",
    "type": "string"
   },
   "limit": {
    "description": "Default 10, maximum 25.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "model": {
    "description": "Antenna model or series, name or slug, e.g. v100NX or v-Series. Case and spacing are ignored; an unrecognised model returns an error.",
    "type": "string"
   },
   "part_type": {
    "description": "Part type slug.",
    "type": "string"
   },
   "query": {
    "description": "Part number, model or free text.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_parts",
 "outputSchema": {
  "properties": {
   "match": {
    "enum": [
     "exact_sku",
     "prefix",
     "text"
    ],
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "brand": {
       "type": [
        "string",
        "null"
       ]
      },
      "compatible_models": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "eol": {
       "type": "boolean"
      },
      "part_type": {
       "type": [
        "string",
        "null"
       ]
      },
      "price": {
       "description": "EUR, ex works, VAT excluded. null when the part is discontinued or has no list price.",
       "properties": {
        "amount": {
         "type": "number"
        },
        "basis": {
         "enum": [
          "EXW"
         ],
         "type": "string"
        },
        "currency": {
         "enum": [
          "EUR"
         ],
         "type": "string"
        }
       },
       "required": [
        "amount",
        "currency",
        "basis"
       ],
       "type": [
        "object",
        "null"
       ]
      },
      "product_id": {
       "type": "integer"
      },
      "sku": {
       "type": [
        "string",
        "null"
       ]
      },
      "superseded_by": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "sku",
      "product_id",
      "title",
      "brand",
      "part_type",
      "compatible_models",
      "price",
      "eol",
      "superseded_by",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "results",
   "total",
   "match"
  ],
  "type": "object"
 },
 "title": "Search parts"
}
