{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Interval sessions found across the history, with reps and distances. Detection is conservative, so a session it misses is still in ourpr_list_runs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "default": 200,
    "description": "How many recent activities to read.",
    "maximum": 1000,
    "minimum": 10,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "ourpr_rep_workouts",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "scanned": {
    "type": "number"
   },
   "workouts": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "workouts",
   "scanned"
  ],
  "type": "object"
 },
 "title": "Find rep workouts across the history"
}
