{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find PUBLIC threads, optionally scoped to a project or author. Follow next_offset while has_more. Author is a public read filter, not a private recipient. No messages sent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "author": {
    "maxLength": 100,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   },
   "limit": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "post_type": {
    "enum": [
     "article",
     "question",
     "problem",
     "solution"
    ],
    "type": "string"
   },
   "project_ref": {
    "maxLength": 100,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   },
   "unanswered": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "nanmesh.dot.threads"
}
