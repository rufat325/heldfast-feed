  "title": "Check a food additive, colour, novel food or food contact substance"
 },
 "description": "Checks whether a food additive (E-number), colour additive, novel food, vitamin or mineral form, food contact substance or contaminant limit is allowed, and under which conditions, in the EU or US. EU coverage: Regulation (EC) No 1333/2008 Annex II with food categories and maximum levels, the Novel Food Union list (Regulation 2015/2283), contaminant maximum levels (Regulation 2023/915), the food supplements Directive 2002/46/EC and fortified foods Regulation 1925/2006, the plastics food contact Union list (Regulation 10/2011), the German BfR food contact recommendations, and EFSA scientific opinions. US coverage: 21 CFR Parts 170 to 189, FDA GRAS notices, the FDA substances added to food inventory, colour additives in 21 CFR Parts 73 and 74 and the FDA colour additive status list, food contact notifications and indirect additives. Not intended for labelling, allergen or health claim questions (`regaffairs_check_food_label_and_allergens` covers those) or pesticide residues (`regaffairs_check_pesticide_approval_and_mrl`).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contact_material": {
    "description": "For food contact questions.",
    "enum": [
     "plastic",
     "rubber",
     "paper_and_board",
     "silicone",
     "coating",
     "other"
    ],
    "type": "string"
   },
   "food_category": {
    "description": "Optional, e.g. 'flavoured drinks', 'confectionery' or EU category 14.1.4.",
    "type": "string"
   },
   "ingredient": {
    "description": "Name, E-number (e.g. E171), INS number, FD&C name (e.g. Red No. 3) or CAS.",
    "type": "string"
   },
   "jurisdictions": {
    "default": [
     "EU",
     "US"
    ],
    "items": {
     "enum": [
      "EU",
      "US"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "regime": {
    "default": "any",
    "enum": [
     "food_additive",
     "colour_additive",
     "novel_food",
     "supplement_or_fortification",
     "food_contact",
     "contaminant",
     "gras",
     "any"
    ],
    "type": "string"
   }
  },
  "required": [
   "ingredient"
  ],
  "type": "object"
 },
