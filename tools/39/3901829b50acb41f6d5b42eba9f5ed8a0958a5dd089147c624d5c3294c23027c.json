{
 "description": "A picture of part of the model as Mermaid source, built from its edges. Use to show how things connect; for the edges as data use list_references. Input: `shape` (concepts, process, neighborhood); `id` for process and neighborhood; optional `domain` for concepts. Returns `mermaid`, `nodes` mapping each node to an entity, `title`, `edges`, `omitted`. At most 50 nodes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "domain": {
    "description": "A domain's id, to draw its concepts",
    "type": "string"
   },
   "id": {
    "description": "The process to draw, or the entity at the middle of a neighborhood",
    "type": "string"
   },
   "shape": {
    "enum": [
     "concepts",
     "process",
     "neighborhood"
    ],
    "type": "string"
   }
  },
  "required": [
   "shape"
  ],
  "type": "object"
 },
 "name": "diagram",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "edges": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "mermaid": {
    "type": "string"
   },
   "model": {
    "additionalProperties": false,
    "properties": {
     "commit": {
      "type": [
       "string",
       "null"
      ]
     },
     "core": {
      "type": "string"
     },
     "parser": {
      "type": "string"
     },
     "repo": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "commit",
     "repo",
     "core",
     "parser"
    ],
    "type": "object"
   },
   "nodes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "node": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "node",
      "id",
      "title",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "omitted": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "shape": {
    "enum": [
     "concepts",
     "process",
     "neighborhood"
    ],
    "type": "string"
   },
   "title": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "shape",
   "title",
   "mermaid",
   "nodes",
   "edges",
   "omitted",
   "model"
  ],
  "type": "object"
 }
}
