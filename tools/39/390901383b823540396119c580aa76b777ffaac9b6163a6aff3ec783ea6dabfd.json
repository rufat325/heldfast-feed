{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Reads ~/.tdmcp/session-profile.json (or a custom path) and returns a unified JSON snapshot that an agent should load at the start of every session. The profile caches the most recent outputs of style_memory, recall_similar_work, learn_conventions, and learn_from_my_corpus so the agent has the artist's preferences and past work at hand without running all four tools every time. If no file exists, a default skeleton is created and returned. Pass reset=true to overwrite with fresh defaults. The profile_path field in the returned object is always the resolved path that was read or written.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "profile_path": {
    "description": "Absolute path to the session-profile JSON file. Defaults to ~/.tdmcp/session-profile.json.",
    "type": "string"
   },
   "reset": {
    "default": false,
    "description": "If true, overwrite the existing profile with the built-in defaults and return them.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "load_session_profile",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "conventions": {
    "additionalProperties": false,
    "description": "Snapshot from learn_conventions (Memory/conventions.md) if previously captured.",
    "properties": {
     "color_tags": {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     "layout": {
      "type": "string"
     },
     "naming_label": {
      "type": "string"
     },
     "param_defaults": {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "corpus_style": {
    "additionalProperties": false,
    "description": "Snapshot from learn_from_my_corpus (Memory/corpus_style.md) if previously captured.",
    "properties": {
     "favorite_generators": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "naming_label": {
      "type": "string"
     },
     "palettes": {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     "top_hexes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "created": {
    "description": "True when the profile was created fresh (no prior file).",
    "type": "boolean"
   },
   "loaded_at": {
    "description": "ISO-8601 timestamp of this read.",
    "type": "string"
   },
   "notes": {
    "description": "Human-readable notes about what was loaded or defaulted.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "profile_path": {
    "description": "Absolute path of the profile file read or written.",
    "type": "string"
   },
   "recent_work": {
    "description": "Top hits from recall_similar_work if previously captured.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "intent": {
       "type": "string"
      },
      "ops": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "path": {
       "type": "string"
      },
      "recipe": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "snippet": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "title",
      "score",
      "tags",
      "ops"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "reset": {
    "description": "True when reset=true was requested.",
    "type": "boolean"
   },
   "style_memory": {
    "additionalProperties": false,
    "description": "Snapshot from style_memory (Memory/style.md) if previously captured.",
    "properties": {
     "banned": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "default_energy": {
      "type": "string"
     },
     "favorite_generators": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "layout": {
      "type": "string"
     },
     "naming": {
      "type": "string"
     },
     "palettes": {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "profile_path",
   "created",
   "reset",
   "loaded_at",
   "notes"
  ],
  "type": "object"
 },
 "title": "Load or initialise the persistent session profile"
}
