 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Save a program to my coaching brain"
 },
 "description": "Use this when a Phorme coach has written a program in this conversation and clearly said to save it to one of their coaching brains. It saves the program as a draft on that brain (session names, exercises, sets and reps); members see nothing until the coach adds the draft in the coach console. It needs a connected Phorme account that owns the brain.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "brain_id": {
    "description": "The brain id from the coach's brains.",
    "maxLength": 80,
    "type": "string"
   },
   "confirmation": {
    "const": true,
    "description": "True only after the coach confirmed this save.",
    "type": "boolean"
   },
   "sessions": {
    "description": "One week of sessions; the app repeats and progresses it.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "exercises": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
         },
         "reps": {
          "description": "Reps per set, for example 8 or \"8-10\".",
          "type": [
           "integer",
           "string"
          ]
         },
         "rest": {
          "description": "Rest in seconds.",
          "maximum": 900,
          "minimum": 0,
          "type": "integer"
         },
         "seconds": {
          "description": "For timed sets instead of reps.",
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
         },
         "sets": {
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
         }
        },
        "required": [
         "name",
         "sets"
        ],
        "type": "object"
       },
       "maxItems": 30,
       "minItems": 1,
       "type": "array"
      },
      "title": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "title",
      "exercises"
     ],
     "type": "object"
    },
    "maxItems": 14,
    "minItems": 1,
    "type": "array"
   },
   "title": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "weeks": {
    "description": "How many weeks the program runs. Defaults to 4.",
    "maximum": 24,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "brain_id",
   "title",
   "sessions",
   "confirmation"
  ],
