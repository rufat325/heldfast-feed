    "minLength": 1,
    "type": "string"
   },
   "uf": {
    "description": "Sigla da unidade federativa, por exemplo SP.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   }
  },
  "required": [
   "cidade",
   "uf"
  ],
  "type": "object"
 },
 "name": "buscar_babas_publicas",
