{
 "description": "Get an exact ZAR price using product_id from search_catalog or lookup_catalog, width_mm and height_mm. Prices include VAT and delivery. Colour selects the bamboo price tier where applicable. A price is not a stock reservation: validate the exact colour and mount with configure_product before creating a cart. Failure can return success:false or a JSON-RPC validation error.",
 "inputSchema": {
  "properties": {
   "colour": {
    "description": "Optional bamboo colour for colour-specific tier pricing",
    "type": "string"
   },
   "finish": {
    "description": "Optional finish for aluminium products: Plain, Brushed, Woodgrain",
    "type": "string"
   },
   "height_mm": {
    "description": "Height/drop in millimetres (e.g. 1500)",
    "type": "number"
   },
   "product_id": {
    "description": "product_id from search_catalog or lookup_catalog (e.g. roller-blockout)",
    "type": "string"
   },
   "province": {
    "description": "Optional. Customer's South African province or city. Garden Route locations get Duncan's direct contact; other locations get the online shop contact.",
    "type": "string"
   },
   "quantity": {
    "description": "Number of blinds (default 1)",
    "type": "number"
   },
   "width_mm": {
    "description": "Width in millimetres (e.g. 1200)",
    "type": "number"
   }
  },
  "required": [
   "product_id",
   "width_mm",
   "height_mm"
  ],
  "type": "object"
 },
 "name": "get_price",
 "outputSchema": {
  "additionalProperties": true,
  "oneOf": [
   {
    "properties": {
     "success": {
      "const": true
     }
    },
    "required": [
     "product_id",
     "width_mm",
     "height_mm",
     "quantity",
     "unit_price_zar",
     "total_price_zar",
     "currency",
     "vat_included"
    ]
   },
   {
    "properties": {
     "success": {
      "const": false
     }
    },
    "required": [
     "message"
    ]
   }
  ],
  "properties": {
   "contact_name": {
    "type": "string"
   },
   "contact_phone": {
    "type": "string"
   },
   "contact_required": {
    "type": "boolean"
   },
   "currency": {
    "const": "ZAR",
    "type": "string"
   },
   "effective_height_mm": {
    "type": "number"
   },
   "effective_width_mm": {
    "type": "number"
   },
   "finish": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "height_mm": {
    "type": "number"
   },
   "lead_time": {
    "type": "string"
   },
   "measurement_review_required": {
    "type": "boolean"
   },
   "message": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "product_id": {
    "type": "string"
   },
   "quantity": {
    "type": "number"
   },
   "success": {
    "type": "boolean"
   },
   "total_price_zar": {
    "type": "number"
   },
   "unit_price_zar": {
    "type": "number"
   },
   "vat_included": {
    "type": "boolean"
   },
   "whatsapp": {
    "type": "string"
   },
   "width_mm": {
    "type": "number"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 }
}
