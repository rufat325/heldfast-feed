{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Who am I"
 },
 "description": "Which studio the key belongs to, with game and pact-request counts. Without a key, how to get one. Optionally check an existing studio key. With an unknown key it fails with invalid_api_key (the key shown masked).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "description": "Studio API key. Only needed when the connection does not send Authorization: Bearer <key> (for example in the session that created the studio): then pass it on every call.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "whoami",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "counts": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "changes_requested": {
        "type": "integer"
       },
       "games": {
        "type": "integer"
       },
       "in_review": {
        "type": "integer"
       },
       "listed": {
        "type": "integer"
       },
       "proofs_to_check": {
        "type": "integer"
       },
       "waiting_pitches": {
        "type": "integer"
       }
      },
      "required": [
       "games",
       "listed",
       "in_review",
       "changes_requested",
       "waiting_pitches",
       "proofs_to_check"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "key": {
    "description": "The key, masked",
    "type": [
     "string",
     "null"
    ]
   },
   "key_from": {
    "anyOf": [
     {
      "enum": [
       "api_key",
       "the Authorization header"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "next_step": {
    "type": "string"
   },
   "signed_in": {
    "type": "boolean"
   },
   "studio": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "contact": {
        "type": "string"
       },
       "created_at": {
        "description": "ISO-8601 time, UTC",
        "type": [
         "string",
         "null"
        ]
       },
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "slug": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "slug",
       "contact",
       "created_at"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "studio_desk_url": {
    "type": "string"
   }
  },
  "required": [
   "signed_in",
   "key",
   "key_from",
   "studio",
   "counts",
   "studio_desk_url",
   "next_step"
  ],
  "type": "object"
 },
 "title": "Who am I"
}
