{
 "description": "Get specific SEC form type filings for a company",
 "inputSchema": {
  "properties": {
   "formType": {
    "description": "Form type (e.g., '10-K', '8-K')",
    "type": "string"
   },
   "limit": {
    "description": "Number of filings to return",
    "type": "integer"
   },
   "quarter": {
    "description": "Filter by quarter",
    "type": "string"
   },
   "ticker": {
    "description": "Stock ticker",
    "type": "string"
   },
   "year": {
    "description": "Filter by year",
    "type": "string"
   }
  },
  "required": [
   "ticker",
   "formType"
  ],
  "type": "object"
 },
 "name": "filings_forms"
}
