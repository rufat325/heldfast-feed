    "type": "boolean"
   },
   "id": {
    "description": "Message ID",
    "type": "string"
   },
   "instance": {
    "description": "Instance name",
    "type": "string"
   },
   "participant": {
    "description": "Participant JID (required for group messages)",
    "type": "string"
   },
   "remoteJid": {
    "description": "Chat JID",
    "type": "string"
   }
  },
  "required": [
   "instance",
   "remoteJid",
   "id",
   "fromMe"
  ],
  "type": "object"
 },
 "name": "delete_message"
}
