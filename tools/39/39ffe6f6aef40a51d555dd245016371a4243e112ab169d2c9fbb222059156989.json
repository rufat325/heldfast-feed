{
 "description": "Scrolls on the device screen from start to end coordinates",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device_id": {
    "pattern": "^[\\w\\-.:]{1,256}$",
    "type": "string"
   },
   "endX": {
    "type": "number"
   },
   "endY": {
    "type": "number"
   },
   "startX": {
    "type": "number"
   },
   "startY": {
    "type": "number"
   }
  },
  "required": [
   "device_id",
   "startX",
   "startY",
   "endX",
   "endY"
  ],
  "type": "object"
 },
 "name": "scroll"
}
