{
 "description": "Explain 1 to 10 Algorand transaction IDs in one request, with per-item results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   },
   "txids": {
    "items": {
     "pattern": "^[A-Z2-7]{52}$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "txids"
  ],
  "type": "object"
 },
 "name": "explain_algorand_transaction_batch",
 "title": "Explain Algorand transaction batch"
}
