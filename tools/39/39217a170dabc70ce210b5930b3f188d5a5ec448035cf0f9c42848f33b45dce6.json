{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search CasaNest properties"
 },
 "description": "Search currently published properties in Portugal by exact structured filters. Requires purpose; municipality requires district. Rental budgets require month/week/night. Up to 20 results, cursor tied to filters. No results means no matches; do not widen filters without asking.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bedrooms_min": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "cursor": {
    "maxLength": 240,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "district": {
    "description": "Portuguese district slug, e.g. leiria. Does not mean municipality.",
    "maxLength": 160,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "features": {
    "items": {
     "enum": [
      "elevator",
      "balcony",
      "terrace",
      "garage",
      "pool",
      "garden",
      "airConditioning",
      "storageRoom",
      "alarm",
      "security",
      "gatedCommunity",
      "centralHeating",
      "fireplace",
      "jacuzzi",
      "soundSystem",
      "wineCellar",
      "furnished",
      "accessibility"
     ],
     "type": "string"
    },
    "maxItems": 18,
    "type": "array"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "pt",
    "enum": [
     "pt",
     "en"
    ],
    "type": "string"
   },
   "municipality": {
    "description": "Municipality slug; requires its district, e.g. district=leiria, municipality=leiria.",
    "maxLength": 160,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "net_area_min": {
    "maximum": 10000000,
    "minimum": 0,
    "type": "number"
   },
   "price_max": {
    "maximum": 10000000000,
    "minimum": 0,
    "type": "number"
   },
   "price_min": {
    "maximum": 10000000000,
    "minimum": 0,
    "type": "number"
   },
   "property_type": {
    "enum": [
     "apartment",
     "room",
     "house",
     "land",
     "shop",
     "office",
     "warehouse",
     "garage",
     "building",
     "farm",
     "other"
    ],
    "type": "string"
   },
   "purpose": {
    "enum": [
     "sale",
     "rent",
     "vacation",
     "exchange"
    ],
    "type": "string"
   },
   "rent_period": {
    "description": "Required with a rent/vacation budget: prices in different periods are not comparable.",
    "enum": [
     "month",
     "week",
     "night"
    ],
    "type": "string"
   },
   "typology": {
    "enum": [
     "t0",
     "t1",
     "t2",
     "t3",
     "t4",
     "t5",
     "t6plus"
    ],
    "type": "string"
   }
  },
  "required": [
   "purpose"
  ],
  "type": "object"
 },
 "name": "search_properties",
 "title": "Search CasaNest properties"
}
