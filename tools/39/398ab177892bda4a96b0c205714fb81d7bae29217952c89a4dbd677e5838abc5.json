{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read private health trend points for self (default), or for an explicit person subject through condition_id. Effective points only by default; include_superseded returns corrections. ($0.05; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "condition_id": {
    "description": "From get_conditions or create_condition.",
    "type": "string"
   },
   "include_superseded": {
    "description": "Default false. True includes correction history.",
    "type": "boolean"
   },
   "kind": {
    "enum": [
     "symptom",
     "treatment",
     "energy",
     "sleep"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Default 100.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "observed_from": {
    "description": "Inclusive ISO timestamp.",
    "type": "string"
   },
   "observed_to": {
    "description": "Inclusive ISO timestamp.",
    "type": "string"
   },
   "person_id": {
    "description": "Owned contact id; required for person.",
    "type": "string"
   },
   "subject_type": {
    "description": "self, or person with person_id.",
    "enum": [
     "self",
     "person"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_health_trends",
 "openWorldHint": false,
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "type": "number"
   },
   "include_superseded": {
    "type": "boolean"
   },
   "person_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "subject_type": {
    "description": "self or person.",
    "type": "string"
   },
   "trend_points": {
    "items": {
     "additionalProperties": true,
     "description": "A trend point with confidence, source and correction lineage.",
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count"
  ],
  "type": "object"
 },
 "readOnlyHint": true,
 "securitySchemes": [
  {
   "scopes": [
    "context.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Get Health Trends"
}
