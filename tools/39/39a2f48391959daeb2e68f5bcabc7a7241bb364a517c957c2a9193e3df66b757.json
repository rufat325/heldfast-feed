{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Local Storage"
 },
 "description": "Read, write, or clear localStorage in the current page context.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Operation: get a value, set a value, or clear all",
    "enum": [
     "get",
     "set",
     "clear"
    ],
    "type": "string"
   },
   "key": {
    "description": "Storage key (required for get and set)",
    "type": [
     "string",
     "null"
    ]
   },
   "session_id": {
    "description": "Session ID returned by browser_navigate",
    "type": "string"
   },
   "value": {
    "description": "Value to store (required for set)",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "session_id",
   "action"
  ],
  "type": "object"
 },
 "name": "browser_local_storage"
}
