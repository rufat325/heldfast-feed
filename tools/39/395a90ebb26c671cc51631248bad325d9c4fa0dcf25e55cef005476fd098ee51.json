{
 "description": "Register a dependency for an AI agent. Track models, packages, tools, services, APIs, and MCP servers that the agent depends on. Essential for supply chain visibility and health monitoring.",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "Unique identifier for the agent",
    "type": "string"
   },
   "dependency_type": {
    "description": "Type of dependency being registered",
    "enum": [
     "model",
     "package",
     "tool",
     "service",
     "api",
     "mcp_server"
    ],
    "type": "string"
   },
   "integrity_hash": {
    "description": "Integrity hash for verification (optional)",
    "type": "string"
   },
   "metadata": {
    "description": "Additional metadata about the dependency",
    "type": "object"
   },
   "name": {
    "description": "Name of the dependency (e.g., 'gpt-4', 'lodash', 'stripe-api')",
    "type": "string"
   },
   "source": {
    "description": "Source registry or provider (e.g., 'npm', 'pypi', 'openai')",
    "type": "string"
   },
   "version": {
    "description": "Version string of the dependency",
    "type": "string"
   }
  },
  "required": [
   "agent_id",
   "dependency_type",
   "name"
  ],
  "type": "object"
 },
 "name": "tork_supply_chain_register"
}
