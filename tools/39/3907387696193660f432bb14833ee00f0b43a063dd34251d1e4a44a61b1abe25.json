{
 "description": "Autocomplete cities and departments by search query. Returns IDs needed for location filters in search-properties and create-search.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "excludeCities": {
    "description": "City IRIs to exclude",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "excludeDepartments": {
    "description": "Department IRIs to exclude",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "query": {
    "description": "Search term (e.g. 'Paris', 'Lyon', 'Marseille')",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "location-autocomplete"
}
