{
 "description": "Tool to search for entities in the Artsdata knowledge graph by name, with optional filters on entity type and on the controlled vocabulary (skos:ConceptScheme) a concept belongs to.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Request schema for the search_entities tool.",
  "properties": {
   "in_scheme": {
    "description": "Optional list of Artsdata controlled vocabulary (skos:ConceptScheme) URIs (e.g., ['http://kg.artsdata.ca/resource/ArtsdataEventTypes']). Paired with types: ['http://www.w3.org/2004/02/skos/core#Concept']. Use it to find a concept URI by its label (e.g., the event type for 'exhibition') for use in search_events under has_event_type_concept. Can be left empty.",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "type": "array",
    "uniqueItems": true
   },
   "language": {
    "default": "en",
    "description": "Language code, restricted to 'en' or 'fr'.",
    "enum": [
     "en",
     "fr"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Number of results to return.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Non-empty mandatory search query.",
    "minLength": 1,
    "type": "string"
   },
   "types": {
    "description": "Optional list of type filters; can be empty.",
    "items": {
     "enum": [
      "http://kg.artsdata.ca/ontology/Event",
      "http://kg.artsdata.ca/ontology/Place",
      "http://kg.artsdata.ca/ontology/Person",
      "http://kg.artsdata.ca/ontology/Organization",
      "http://dbpedia.org/ontology/Agent",
      "http://www.w3.org/2004/02/skos/core#Concept"
     ],
     "format": "uri",
     "type": "string"
    },
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "query"
  ],
  "title": "SearchQueryRequest",
  "type": "object",
  "version": "1.0.0"
 },
 "name": "search_entities",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Response schema for the search_entities tool.",
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "type": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "format": "uri",
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "uri": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "type",
      "uri"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "title": "SearchEntitiesResponse",
  "type": "object",
  "version": "1.0.0"
 }
}
