{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Convert a public PDF to Markdown"
 },
 "description": "Convert a PDF available at a public HTTP or HTTPS link into Markdown for reading, research or a coding project. Returns extracted text, page and table counts, and whether scanned pages were found. No OCR, private links or local files. The reply is limited to 20,000 Markdown characters and marks longer results as excerpts; the whole PDF uses the API page allowance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "url": {
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "convert_pdf_url",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "converted_at": {
    "type": "string"
   },
   "docs_url": {
    "type": "string"
   },
   "error": {
    "maxLength": 80,
    "type": "string"
   },
   "http_status": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "markdown": {
    "maxLength": 20000,
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "pages": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "parser_version": {
    "type": "string"
   },
   "remaining_pages": {
    "type": "string"
   },
   "retry_after": {
    "type": "string"
   },
   "returned_characters": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "scanned_pages": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "source_url": {
    "type": "string"
   },
   "status": {
    "enum": [
     "success",
     "tool_error",
     "internal_error"
    ],
    "type": "string"
   },
   "tables": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "total_characters": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "message",
   "docs_url"
  ],
  "type": "object"
 },
 "title": "Convert a public PDF to Markdown"
}
