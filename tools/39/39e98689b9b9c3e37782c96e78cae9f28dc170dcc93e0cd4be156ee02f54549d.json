{
 "_meta": {
  "openai/outputTemplate": "ui://widget/xenition-list.html",
  "openai/toolInvocation/invoked": "Recorded",
  "openai/toolInvocation/invoking": "Recording it\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "xenition.read",
     "xenition.write"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://xenition-app/xenition-list.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add an invoice or bill"
 },
 "description": "Use this when the user wants to record an invoice, bill or receipt in their Xenition ledger \u2014 vendor, amount, due date, optionally already paid. Returns the ledger's invoices. Do not use to pay, send or email an invoice; Xenition has no payment or messaging channel.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "the invoice total",
    "type": "number"
   },
   "currency": {
    "description": "currency code, default USD",
    "type": "string"
   },
   "dueDate": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "invoiceNumber": {
    "type": "string"
   },
   "kind": {
    "description": "invoice | receipt | credit_note (default invoice)",
    "type": "string"
   },
   "markPaid": {
    "description": "also mark it paid now",
    "type": "boolean"
   },
   "vendor": {
    "description": "the vendor / who the invoice is from",
    "type": "string"
   }
  },
  "required": [
   "vendor",
   "amount"
  ],
  "type": "object"
 },
 "name": "add_ledger_entry",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "integer"
   },
   "empty": {
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accent": {
       "type": "string"
      },
      "address": {
       "type": "string"
      },
      "detail": {
       "additionalProperties": true,
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "lat": {
       "type": [
        "null",
        "number"
       ]
      },
      "lng": {
       "type": [
        "null",
        "number"
       ]
      },
      "meta": {
       "type": "string"
      },
      "openUrl": {
       "type": "string"
      },
      "phone": {
       "type": "string"
      },
      "subtitle": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "website": {
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "title",
   "count",
   "items"
  ],
  "type": "object"
 },
 "title": "Add an invoice or bill"
}
