  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "description": "ISO 3166-1 alpha-2 (TH), alpha-3 (THA), US-HI, or 4-digit MOFA country code (0066). US returns the mainland and Hawaii entries.",
    "maxLength": 16,
    "type": "string"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
 "name": "mofa_country_levels",
