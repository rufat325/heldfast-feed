{"_meta":{"xdata.kr/credential":{"providers":["hometax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=hometax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: hometax__session__login (\uac19\uc740 account_link_id). \uc800\uc7a5\ud55c \uc6d0\ucc9c\uc138 \uc218\uc815\uc2e0\uace0\uc11c\ub97c \uae30\uad00\uc5d0 \uc791\uc131\uc644\ub8cc\ub85c \ucc98\ub9ac\ud558\uace0 \uae30\uad00 \ub0b4\uc6a9\uac80\uc99d \uacb0\uacfc\ub97c \ub3cc\ub824\uc90d\ub2c8\ub2e4. \uc81c\ucd9c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc81c\ucd9c \uc804\uc5d0 \ubd80\ub974\uc138\uc694. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 4\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"expected_snapshot_hash":{"description":"source_job_id \uc791\uc5c5 \uacb0\uacfc\uc758 snapshot_hash \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(\uc18c\ubb38\uc790 16\uc9c4\uc218 64\uc790\ub9ac). \uadf8 \uc791\uc5c5\uc758 \ub0b4\uc6a9\uacfc \ub9de\uc9c0 \uc54a\uc73c\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uc791\uc131 \ub0b4\uc6a9\uc774 \ubc14\ub00c\uc5c8\ub2e4\ub294 \uc624\ub958(409)\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^[0-9a-f]{64}$","title":"Expected Snapshot Hash","type":"string"},"refund_account_no":{"anyOf":[{"pattern":"^\\d{1,20}$","type":"string"},{"type":"null"}],"default":null,"description":"\ud658\uae09\ubc1b\uc744 \uacc4\uc88c\ubc88\ud638\uc785\ub2c8\ub2e4. \ud558\uc774\ud508 \uc5c6\uc774 \uc22b\uc790\ub9cc 1\uc790\ub9ac\uc5d0\uc11c 20\uc790\ub9ac\uae4c\uc9c0 \uc785\ub825\ud569\ub2c8\ub2e4. \uae30\ubcf8\uc815\ubcf4\uc758 \ud658\uae09\uc2e0\uccad \uc5ec\ubd80\uac00 Y \uc778 \uc2e0\uace0\uc11c\ub97c \uac80\ud1a0\ud560 \ub54c\ub9cc \uc4f0\uba70, \uadf8\ub54c \uc740\ud589 \ucf54\ub4dc\uc640 \uacc4\uc88c\ubc88\ud638\uac00 \ubaa8\ub450 \uc788\uc5b4\uc57c \ud558\uace0 \uc5c6\uc73c\uba74 \uac70\uc808\ud569\ub2c8\ub2e4.","title":"Refund Account No"},"refund_bank_code":{"anyOf":[{"pattern":"^\\d{3}$","type":"string"},{"type":"null"}],"default":null,"description":"\ud658\uae09\ubc1b\uc744 \uc740\ud589\uc758 \ucf54\ub4dc\uc785\ub2c8\ub2e4. \uc22b\uc790 \uc138 \uc790\ub9ac\ub85c \uc785\ub825\ud569\ub2c8\ub2e4. \uae30\ubcf8\uc815\ubcf4\uc758 \ud658\uae09\uc2e0\uccad \uc5ec\ubd80\uac00 Y \uc778 \uc2e0\uace0\uc11c\ub97c \uac80\ud1a0\ud560 \ub54c\ub9cc \uc4f0\uba70, \uadf8\ub54c \uc740\ud589 \ucf54\ub4dc\uc640 \uacc4\uc88c\ubc88\ud638\uac00 \ubaa8\ub450 \uc788\uc5b4\uc57c \ud558\uace0 \uc5c6\uc73c\uba74 \uac70\uc808\ud569\ub2c8\ub2e4.","title":"Refund Bank Code"},"source_job_id":{"description":"\uc774\uc5b4\uc11c \uc9c4\ud589\ud560 \uc774\uc804 \ub2e8\uacc4 \uc791\uc5c5\uc758 job_id \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(job_ \uc73c\ub85c \uc2dc\uc791\ud558\ub294 \uc791\uc5c5 \ubc88\ud638). \uae30\ubcf8\uc815\ubcf4 \uc800\uc7a5(basic_save), \uba85\uc138 \uc800\uc7a5(detail_save), \ubd80\ud45c \uc800\uc7a5(annex_save) \uacb0\uacfc\ucc98\ub7fc \uae30\ubcf8\uc815\ubcf4\uac00 \uc800\uc7a5\ub41c \uc0c1\ud0dc\uc758 \uacb0\uacfc\ub97c \ubc1b\uace0, \ub2e4\uc2dc \uac80\ud1a0\ud560 \ub54c\ub294 \uac80\ud1a0(review) \uacb0\uacfc\ub3c4 \ubc1b\uc2b5\ub2c8\ub2e4. \uac19\uc740 \uc870\uc9c1\uacfc \ud658\uacbd, \uac19\uc740 \uae30\uad00 \uc5f0\uacb0\uc5d0\uc11c \uc774 \uc2e0\uace0 \uc720\ud615\uc73c\ub85c \uc131\uacf5\ud55c \uc791\uc5c5\uc774\uc5b4\uc57c \ud558\uace0 \uc544\ub2c8\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uac70\uc808\ud558\uba70, \ubc1b\uc9c0 \uc54a\ub294 \uc791\uc131 \uc0c1\ud0dc\uc758 \uacb0\uacfc\uc774\uba74 409 \ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^job_[0-9A-HJKMNP-TV-Z]{26}$","title":"Source Job Id","type":"string"}},"required":["source_job_id","expected_snapshot_hash"],"title":"ReviewRequest","type":"object"},"name":"hometax__tax__withholding__amendment_report__review","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\ud648\ud0dd\uc2a4 \uc6d0\ucc9c\uc138 \uc218\uc815\uc2e0\uace0 \uc800\uc7a5 \ub0b4\uc6a9 \uac80\ud1a0"}
