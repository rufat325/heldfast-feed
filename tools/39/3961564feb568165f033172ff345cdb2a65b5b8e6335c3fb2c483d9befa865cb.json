{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get Kafka monitoring metrics for a CDSS cluster node",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "computeInstanceNo": {
    "description": "Node instance number (from ncloud_cdss_list_nodes)",
    "type": "string"
   },
   "interval": {
    "description": "Aggregation interval (e.g. Min1, Min30, Hour2, Day1)",
    "type": "string"
   },
   "metric": {
    "description": "Metric set to retrieve",
    "enum": [
     "CLUSTER_ALL_METRICS",
     "BROKER_ALL_METRICS"
    ],
    "type": "string"
   },
   "serviceGroupInstanceNo": {
    "description": "Cluster instance number (path segment)",
    "type": "string"
   },
   "timeEnd": {
    "description": "End time as epoch milliseconds",
    "type": "number"
   },
   "timeStart": {
    "description": "Start time as epoch milliseconds (e.g. 1745280000000) \u2014 NOT an ISO 8601 string",
    "type": "number"
   }
  },
  "required": [
   "serviceGroupInstanceNo",
   "timeStart",
   "timeEnd",
   "metric",
   "computeInstanceNo"
  ],
  "type": "object"
 },
 "name": "ncloud_cdss_get_monitoring"
}
