{
 "description": "List posts of any post type (id, title, slug, status, date, modified, author, excerpt, parent) with paging totals",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "order": {
    "description": "Sort direction (default DESC)",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "orderby": {
    "description": "Order by field (default date)",
    "enum": [
     "date",
     "modified",
     "title",
     "name",
     "author",
     "parent",
     "type",
     "menu_order",
     "comment_count",
     "rand",
     "none"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Posts per page (default 20)",
    "minimum": 1,
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "description": "Post status filter: any (default), publish, draft, pending, private, future, trash, or a comma-separated list",
    "type": "string"
   },
   "type": {
    "description": "Post type name (e.g. post, page, product, testimonial)",
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "site",
   "type"
  ],
  "type": "object"
 },
 "name": "mcp_list_cpt_posts"
}
