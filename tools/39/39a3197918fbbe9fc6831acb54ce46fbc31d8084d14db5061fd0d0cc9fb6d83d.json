{
 "description": "Fetch a security timeline for an incident or topic from Vigile memory.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "incident_id": {
    "description": "Incident ID selector (preferred when known)",
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   },
   "topic": {
    "description": "Topic selector for timeline lookup",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vigile_timeline"
}
