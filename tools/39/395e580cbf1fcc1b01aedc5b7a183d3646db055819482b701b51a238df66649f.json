{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Generation Job"
 },
 "description": "Create a Raven creative generation job for image, video, 3D, audio, campaign, or analysis. Returns a brand-aware provider payload. If execute=true and RAVEN_CREATIVE_RUNNER is configured, Raven submits the job to that local runner.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "description": "Target aspect ratio, e.g. 1:1, 16:9, 9:16.",
    "type": "string"
   },
   "brand_profile_id": {
    "description": "Local Raven brand profile ID.",
    "type": "string"
   },
   "channel": {
    "description": "Target channel, e.g. TikTok, YouTube Shorts, blog, marketplace.",
    "type": "string"
   },
   "character_profile_id": {
    "description": "Local Raven character profile ID.",
    "type": "string"
   },
   "duration_seconds": {
    "description": "Video/audio duration.",
    "exclusiveMinimum": 0,
    "maximum": 600,
    "type": "number"
   },
   "execute": {
    "description": "Submit through RAVEN_CREATIVE_RUNNER now. Default false.",
    "type": "boolean"
   },
   "media_type": {
    "description": "Output type.",
    "enum": [
     "image",
     "video",
     "audio",
     "3d",
     "campaign",
     "analysis"
    ],
    "type": "string"
   },
   "model": {
    "description": "Raven model slot or external provider model ID.",
    "type": "string"
   },
   "objective": {
    "description": "Business or audience goal.",
    "type": "string"
   },
   "output_count": {
    "description": "Number of variants to request.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "preset": {
    "description": "Preset ID from list_creative_presets.",
    "type": "string"
   },
   "prompt": {
    "description": "Creative request.",
    "type": "string"
   },
   "provider": {
    "description": "Provider label for the downstream runner.",
    "type": "string"
   },
   "quality": {
    "description": "Requested quality tier.",
    "enum": [
     "draft",
     "standard",
     "high",
     "4k"
    ],
    "type": "string"
   },
   "reference_asset_ids": {
    "description": "Local Raven creative asset IDs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "media_type",
   "prompt"
  ],
  "type": "object"
 },
 "name": "create_generation_job"
}
