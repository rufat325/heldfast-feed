{
 "description": "Update an existing postal code target",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Postal code target ID",
    "type": "number"
   },
   "inclusive": {
    "description": "If true, inclusion target; if false, exclusion target",
    "type": "boolean"
   },
   "label": {
    "description": "Postal code target name",
    "type": "string"
   },
   "locations": {
    "description": "Array of locations grouped by country",
    "items": {
     "additionalProperties": false,
     "properties": {
      "country": {
       "description": "Two-letter country code",
       "type": "string"
      },
      "postal_codes": {
       "description": "Array of postal codes",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "country",
      "postal_codes"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_postal_code_target"
}
