{
 "_meta": {
  "heffl/page": "https://heffl.com/tools/risk-assessment-calculator"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Score user-supplied risks using likelihood \u00d7 impact (1\u20135). Low <=6, medium <=14, high >=15. Does not infer likelihood or impact. Free, no authentication required. Rate limited.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "risks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "impact": {
       "maximum": 5,
       "minimum": 1,
       "type": "integer"
      },
      "likelihood": {
       "maximum": 5,
       "minimum": 1,
       "type": "integer"
      },
      "mitigation": {
       "default": "",
       "maxLength": 2000,
       "type": "string"
      },
      "name": {
       "maxLength": 2000,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "name",
      "likelihood",
      "impact"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "risks"
  ],
  "type": "object"
 },
 "name": "risk_assessment",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "risks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "impact": {
       "type": "number"
      },
      "level": {
       "enum": [
        "Low",
        "Medium",
        "High"
       ],
       "type": "string"
      },
      "likelihood": {
       "type": "number"
      },
      "mitigation": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "score": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "likelihood",
      "impact",
      "mitigation",
      "score",
      "level"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "risks"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Project risk assessment"
}
