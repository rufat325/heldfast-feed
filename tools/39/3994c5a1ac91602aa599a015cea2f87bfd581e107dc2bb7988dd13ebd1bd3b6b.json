{
 "description": "Create a commerce order to purchase a product. Requires productLocator from search results and recipient shipping info.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "city": {
    "description": "Shipping city",
    "type": "string"
   },
   "country": {
    "description": "Shipping country (2-letter ISO code, e.g. 'US')",
    "type": "string"
   },
   "email": {
    "description": "Recipient email address",
    "type": "string"
   },
   "firstName": {
    "description": "Recipient first name",
    "type": "string"
   },
   "lastName": {
    "description": "Recipient last name",
    "type": "string"
   },
   "payerAddress": {
    "description": "Wallet address for crypto payment",
    "type": "string"
   },
   "paymentMethod": {
    "description": "Payment chain: 'base', 'solana', 'ethereum' (default: 'base')",
    "type": "string"
   },
   "postalCode": {
    "description": "Shipping postal/zip code",
    "type": "string"
   },
   "productLocator": {
    "description": "Product locator string (e.g. \"amazon:B09XS7JWHH\", \"shopify:<url>:<variantId>\", \"url:<product-url>\")",
    "type": "string"
   },
   "quantity": {
    "description": "Quantity to order (default 1)",
    "type": "number"
   },
   "reason": {
    "description": "Reason for the purchase",
    "type": "string"
   },
   "state": {
    "description": "Shipping state/province",
    "type": "string"
   },
   "street1": {
    "description": "Shipping street address",
    "type": "string"
   }
  },
  "required": [
   "productLocator",
   "email",
   "street1",
   "city",
   "state",
   "postalCode",
   "country"
  ],
  "type": "object"
 },
 "name": "commerce_order"
}
