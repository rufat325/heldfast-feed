{
 "description": "List TouchDesigner Python classes/modules (detailLevel+limit supported)",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "detailLevel": {
    "description": "Response detail level for tool output (minimal, summary, or detailed)",
    "enum": [
     "minimal",
     "summary",
     "detailed"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of items to include in formatted output",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "responseFormat": {
    "description": "Structured output format for formatted responses",
    "enum": [
     "json",
     "yaml",
     "markdown"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_td_classes"
}
