{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check username availability"
 },
 "description": "Check if ONE username is free on 12 resale platforms. Example: username='vintage_finds' returns available, taken, or unverified per platform.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "platforms": {
    "description": "Platform ids. Omit for all.",
    "items": {
     "enum": [
      "ebay",
      "ebaystore",
      "poshmark",
      "grailed",
      "vinted",
      "whatnot",
      "bonanza",
      "chairish",
      "depop",
      "etsy",
      "mercari",
      "rubylane"
     ],
     "type": "string"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   },
   "username": {
    "description": "Username, no @ or spaces.",
    "pattern": "^[a-zA-Z0-9-_]{3,50}$",
    "type": "string"
   }
  },
  "required": [
   "username"
  ],
  "type": "object"
 },
 "name": "check_username",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "disclaimer": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "check_url": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "platform": {
       "type": "string"
      },
      "status": {
       "enum": [
        "available",
        "taken",
        "unverified",
        "error"
       ],
       "type": "string"
      }
     },
     "required": [
      "platform",
      "name",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "available": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "error": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "taken": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "unverified": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "available",
     "taken",
     "unverified",
     "error"
    ],
    "type": "object"
   },
   "username": {
    "type": "string"
   }
  },
  "required": [
   "username",
   "results",
   "summary",
   "disclaimer"
  ],
  "type": "object"
 },
 "title": "Check username availability"
}
