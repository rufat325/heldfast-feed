{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/commerce.unit-price",
  "agent-utilities/priceMicroUsd": 0
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare up to 50 explicit pack prices with exact arithmetic across compatible mass, volume or count units; no currency conversion. FREE during validation. No key, credits or wallet. Existing source and input limits apply.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
     },
     "offers": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "packCount": {
         "maximum": 10000,
         "minimum": 1,
         "type": "integer"
        },
        "price": {
         "maxLength": 19,
         "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
         "type": "string"
        },
        "quantity": {
         "maxLength": 19,
         "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
         "type": "string"
        },
        "unit": {
         "enum": [
          "mg",
          "g",
          "kg",
          "oz",
          "lb",
          "ml",
          "l",
          "each"
         ],
         "type": "string"
        }
       },
       "required": [
        "id",
        "price",
        "quantity",
        "unit"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
     },
     "reference": {
      "additionalProperties": false,
      "properties": {
       "quantity": {
        "maxLength": 19,
        "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
        "type": "string"
       },
       "unit": {
        "enum": [
         "mg",
         "g",
         "kg",
         "oz",
         "lb",
         "ml",
         "l",
         "each"
        ],
        "type": "string"
       }
      },
      "required": [
       "quantity",
       "unit"
      ],
      "type": "object"
     }
    },
    "required": [
     "currency",
     "reference",
     "offers"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "commerce_unit_price",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "cheapestIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "currency": {
    "type": "string"
   },
   "offers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "exactPricePerReference": {
       "additionalProperties": false,
       "properties": {
        "denominator": {
         "type": "string"
        },
        "numerator": {
         "type": "string"
        }
       },
       "required": [
        "numerator",
        "denominator"
       ],
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "pricePerReference": {
       "type": "string"
      },
      "totalQuantity": {
       "additionalProperties": false,
       "properties": {
        "denominator": {
         "type": "string"
        },
        "numerator": {
         "type": "string"
        },
        "unit": {
         "type": "string"
        }
       },
       "required": [
        "numerator",
        "denominator",
        "unit"
       ],
       "type": "object"
      }
     },
     "required": [
      "id",
      "totalQuantity",
      "pricePerReference",
      "exactPricePerReference"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "reference": {
    "additionalProperties": false,
    "properties": {
     "quantity": {
      "maxLength": 19,
      "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
      "type": "string"
     },
     "unit": {
      "enum": [
       "mg",
       "g",
       "kg",
       "oz",
       "lb",
       "ml",
       "l",
       "each"
      ],
      "type": "string"
     }
    },
    "required": [
     "quantity",
     "unit"
    ],
    "type": "object"
   },
   "scope": {
    "type": "string"
   }
  },
  "required": [
   "currency",
   "reference",
   "offers",
   "cheapestIds",
   "scope"
  ],
  "type": "object"
 }
}
