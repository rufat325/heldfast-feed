{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Register a merchant (status pending). Sign the sign-in message (purpose register, nonce from GET /api/v1/shop/auth/nonce) with the merchant wallet. Returns the documents to accept via shop.merchant.accept_terms.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "type": "string"
   },
   "contact_email": {
    "type": "string"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2",
    "type": "string"
   },
   "encryption_key": {
    "additionalProperties": false,
    "properties": {
     "alg": {
      "type": "string"
     },
     "kid": {
      "type": "string"
     },
     "pub": {
      "type": "string"
     },
     "sig_by_wallet": {
      "description": "EIP-191 signature by `wallet` over the encryption-key text.",
      "type": "string"
     }
    },
    "required": [
     "kid",
     "alg",
     "pub",
     "sig_by_wallet"
    ],
    "type": "object"
   },
   "message": {
    "description": "Signed sign-in message (purpose register).",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "payout_wallet": {
    "type": "string"
   },
   "payout_wallet_base": {
    "type": "string"
   },
   "payout_wallet_tempo": {
    "type": "string"
   },
   "recovery_wallet": {
    "type": "string"
   },
   "signature": {
    "type": "string"
   },
   "site_url": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "wallet": {
    "type": "string"
   }
  },
  "required": [
   "wallet",
   "slug",
   "name",
   "category",
   "country",
   "contact_email",
   "site_url",
   "encryption_key",
   "message",
   "signature"
  ],
  "type": "object"
 },
 "name": "shop.merchant.register",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "docs_to_accept": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "doc_id": {
       "type": "string"
      },
      "sha256": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "doc_id",
      "version",
      "sha256"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "merchant_id": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "status": {
    "const": "pending",
    "type": "string"
   }
  },
  "required": [
   "merchant_id",
   "slug",
   "status",
   "docs_to_accept"
  ],
  "type": "object"
 },
 "title": "Register a merchant"
}
