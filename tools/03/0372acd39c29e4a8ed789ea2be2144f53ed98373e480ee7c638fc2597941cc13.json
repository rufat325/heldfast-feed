{
 "_meta": {
  "openai/outputTemplate": "ui://widget/noclegowo-offers-v9.html",
  "openai/toolInvocation/invoked": "Dost\u0119pno\u015b\u0107 sprawdzona",
  "openai/toolInvocation/invoking": "Sprawdzam dost\u0119pno\u015b\u0107\u2026",
  "ui": {
   "resourceUri": "ui://widget/noclegowo-offers-v9.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check availability and price"
 },
 "description": "Checks availability and the total price of a stay (date_from to date_to, adults, children) for up to 10 noclegowo.pl offers (offer_id values as returned in search results). Returns, per offer, the availability verdict, the whole-stay price for that party and the offer link.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adults": {
    "description": "Number of adults (default 2).",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "children": {
    "description": "Number of children (default 0, or the length of children_ages).",
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   },
   "children_ages": {
    "description": "Children ages at check-in; they decide occupancy and price. Unknown ages are priced as school-age.",
    "items": {
     "maximum": 17,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 20,
    "type": "array"
   },
   "date_from": {
    "description": "Arrival (check-in) date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_to": {
    "description": "Departure (check-out) date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "language": {
    "description": "Language of the user's conversation ('pl' or 'en'). Determines the language of texts and the offer link locale.",
    "enum": [
     "pl",
     "en"
    ],
    "type": "string"
   },
   "offer_ids": {
    "description": "offer_id values, as returned in search results.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "offer_ids",
   "date_from",
   "date_to"
  ],
  "type": "object"
 },
 "name": "check_availability",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "language": {
    "enum": [
     "pl",
     "en"
    ],
    "type": "string"
   },
   "missing_offer_ids": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "offers": {
    "description": "Available offers first, then unknown, then unavailable.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "availability": {
       "description": "available / unavailable for the requested dates; unknown = host confirms on inquiry; not_checked = no dates given or not verified.",
       "enum": [
        "available",
        "unavailable",
        "unknown",
        "not_checked"
       ],
       "type": "string"
      },
      "city": {
       "type": "string"
      },
      "image_url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "nearby": {
       "additionalProperties": false,
       "description": "Present on an alternative from a neighbouring locality, included because few offers were available in the requested place for these dates; the offer is not in the requested place.",
       "properties": {
        "distance_km": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ],
         "description": "Distance from the centre of the requested location, km."
        },
        "from": {
         "description": "The requested location this offer is near.",
         "type": "string"
        }
       },
       "required": [
        "from",
        "distance_km"
       ],
       "type": "object"
      },
      "offer_id": {
       "type": "number"
      },
      "price_from_pln": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Indicative \"from\" nightly rate from the listing price list; per person or per property depending on the listing. Not the price for specific dates."
      },
      "rating": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "reviews_count": {
       "type": "number"
      },
      "stay_price": {
       "anyOf": [
        {
         "additionalProperties": false,
         "description": "Date-specific quote from the availability check, for the requested dates and party.",
         "properties": {
          "adults": {
           "type": "number"
          },
          "children": {
           "type": "number"
          },
          "currency": {
           "const": "PLN",
           "type": "string"
          },
          "date_from": {
           "type": "string"
          },
          "date_to": {
           "type": "string"
          },
          "indicative": {
           "description": "True when the total is plausible but not backed by the host's calendar, so it is an indicative price to be confirmed with the host.",
           "type": "boolean"
          },
          "nights": {
           "type": "number"
          },
          "per_night": {
           "description": "total / nights, rounded \u2014 whole party.",
           "type": "number"
          },
          "total": {
           "description": "Total for the whole stay and the whole party, PLN.",
           "type": "number"
          }
         },
         "required": [
          "total",
          "currency",
          "nights",
          "per_night",
          "adults",
          "children",
          "date_from",
          "date_to"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "stay_price_withheld": {
       "description": "Set when the offer is available but the booking system quoted a total that failed plausibility checks; total_price_pln and stay_price are then null and the price for the dates is to be confirmed with the host.",
       "type": "string"
      },
      "total_price_pln": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Same as stay_price.total; null without a quote."
      },
      "url": {
       "description": "Offer page on noclegowo.pl (the URL carries attribution parameters).",
       "type": "string"
      },
      "why_match": {
       "type": "string"
      }
     },
     "required": [
      "offer_id",
      "name",
      "city",
      "image_url",
      "rating",
      "reviews_count",
      "price_from_pln",
      "availability",
      "total_price_pln",
      "stay_price",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "ok",
     "not_found",
     "check_failed"
    ],
    "type": "string"
   },
   "stay": {
    "additionalProperties": false,
    "properties": {
     "adults": {
      "type": "number"
     },
     "children": {
      "type": "number"
     },
     "children_ages": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "date_from": {
      "type": "string"
     },
     "date_to": {
      "type": "string"
     },
     "nights": {
      "type": "number"
     }
    },
    "required": [
     "date_from",
     "date_to",
     "nights",
     "adults",
     "children",
     "children_ages"
    ],
    "type": "object"
   }
  },
  "required": [
   "status",
   "language",
   "stay",
   "offers",
   "missing_offer_ids"
  ],
  "type": "object"
 },
 "title": "Check availability and price"
}
