         "type": "object"
        },
        "type": "array"
       },
       "remotes": {
        "description": "Remotes with transport, auth, protocol and health",
        "items": {
         "additionalProperties": {},
         "properties": {},
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "class",
       "autonomous",
       "human_steps",
       "remotes",
       "packages"
      ],
      "type": "object"
     },
     "dev.protogrid/identity": {
      "additionalProperties": {},
      "properties": {
       "canonical_id": {
        "type": "string"
       },
