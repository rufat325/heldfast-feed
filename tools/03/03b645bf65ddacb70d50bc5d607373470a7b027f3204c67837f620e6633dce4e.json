{
 "annotations": {
  "destructiveHint": true,
  "title": "Draft a purchase order"
 },
 "description": "Create a purchase order in draft status (no stock or ordering happens until it is moved on in Sortly). Sortly computes amounts, sub_total and total from the lines; omit purchase_order_number to have one generated. Needs Purchase Orders on the plan (else 402). WRITE. Sortly: POST /api/v1/purchase_orders.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bill_to": {
    "description": "Billing address.",
    "properties": {
     "city": {
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "line1": {
      "type": "string"
     },
     "line2": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "state": {
      "type": "string"
     },
     "zip_code": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "charges": {
    "description": "Order-level charges; each defaults to 0.",
    "properties": {
     "discount": {
      "anyOf": [
       {
        "pattern": "^-?\\d+(\\.\\d+)?$",
        "type": "string"
       },
       {
        "type": "number"
       }
      ],
      "description": "A decimal, e.g. \"10\" or \"2.5\"."
     },
     "shipping_cost": {
      "anyOf": [
       {
        "pattern": "^-?\\d+(\\.\\d+)?$",
        "type": "string"
       },
       {
        "type": "number"
       }
      ],
      "description": "A decimal, e.g. \"10\" or \"2.5\"."
     },
     "tax": {
      "anyOf": [
       {
        "pattern": "^-?\\d+(\\.\\d+)?$",
        "type": "string"
       },
       {
        "type": "number"
       }
      ],
      "description": "A decimal, e.g. \"10\" or \"2.5\"."
     }
    },
    "type": "object"
   },
   "currency_code": {
    "description": "ISO 4217 code, e.g. USD.",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "expected_delivery_date": {
    "description": "ISO 8601 timestamp, e.g. 2026-08-20T00:00:00Z.",
    "type": "string"
   },
   "line_items": {
    "description": "Up to 100 lines.",
    "items": {
     "properties": {
      "item_id": {
       "description": "Sortly item to order (must exist).",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "item_number": {
       "maxLength": 25,
       "type": "string"
      },
      "name": {
       "description": "Name recorded on the line.",
       "maxLength": 191,
       "minLength": 1,
       "type": "string"
      },
      "notes": {
       "maxLength": 314,
       "type": "string"
      },
      "quantity": {
       "anyOf": [
        {
         "pattern": "^-?\\d+(\\.\\d+)?$",
         "type": "string"
        },
        {
         "type": "number"
        }
       ],
       "description": "Quantity, e.g. \"10\" or 2.5."
      },
      "unit_of_measure": {
       "description": "Unit abbreviation, e.g. units, ft, kg.",
       "type": "string"
      },
      "unit_rate": {
       "anyOf": [
        {
         "pattern": "^-?\\d+(\\.\\d+)?$",
         "type": "string"
        },
        {
         "type": "number"
        }
       ],
       "description": "Price per unit. Omit for an unpriced line."
      },
      "variant_options": {
       "items": {
        "properties": {
         "name": {
          "type": "string"
         },
         "value": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "value"
        ],
        "type": "object"
       },
       "maxItems": 3,
       "type": "array"
      }
     },
     "required": [
      "item_id",
      "name",
      "quantity",
      "unit_of_measure"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "notes": {
    "maxLength": 4000,
    "type": "string"
   },
   "purchase_order_number": {
    "description": "Unique PO number, max 20 chars. Omit to auto-generate.",
    "maxLength": 20,
    "type": "string"
   },
   "ship_to": {
    "description": "Shipping address.",
    "properties": {
     "city": {
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "line1": {
      "type": "string"
     },
     "line2": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "state": {
      "type": "string"
     },
     "zip_code": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "terms": {
    "description": "e.g. Net 30.",
    "maxLength": 4000,
    "type": "string"
   },
   "vendor": {
    "description": "The vendor, captured on the PO.",
    "properties": {
     "city": {
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "email": {
      "maxLength": 190,
      "type": "string"
     },
     "line1": {
      "type": "string"
     },
     "line2": {
      "type": "string"
     },
     "name": {
      "maxLength": 50,
      "type": "string"
     },
     "phone": {
      "maxLength": 22,
      "type": "string"
     },
     "state": {
      "type": "string"
     },
     "zip_code": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "currency_code"
  ],
  "type": "object"
 },
 "name": "sortly_create_purchase_order",
 "title": "Draft a purchase order"
}
