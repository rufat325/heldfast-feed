{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Memory Query Structured"
 },
 "description": "Structured query over memory PROPERTIES (the agent's \"Bases/Dataview\"): filter currently-valid, top-level memories by scope/namespace/department/document_type/language/tags (AND)/min_importance/created_at range, sort by created_at|updated_at|importance_score|title, paginate, and project specific fields. Exact, deterministic retrieval that complements fuzzy memory_search \u2014 use it for \"all decision memories in namespace=acme with importance>0.7, newest first\".",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fields": {
    "description": "Return only these fields (projection)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filter": {
    "additionalProperties": false,
    "properties": {
     "created_after": {
      "description": "created_at >= this ISO instant",
      "format": "date-time",
      "type": "string"
     },
     "created_before": {
      "description": "created_at <= this ISO instant",
      "format": "date-time",
      "type": "string"
     },
     "department": {
      "type": "string"
     },
     "document_type": {
      "type": "string"
     },
     "language": {
      "type": "string"
     },
     "min_importance": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "namespace": {
      "type": "string"
     },
     "scope": {
      "enum": [
       "global",
       "project",
       "user",
       "team",
       "department"
      ],
      "type": "string"
     },
     "tags": {
      "description": "All listed tags must be present (AND)",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "limit": {
    "default": 20,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   },
   "sort": {
    "additionalProperties": false,
    "properties": {
     "by": {
      "default": "created_at",
      "enum": [
       "created_at",
       "updated_at",
       "importance_score",
       "title"
      ],
      "type": "string"
     },
     "order": {
      "default": "desc",
      "enum": [
       "asc",
       "desc"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "memory_query_structured"
}
