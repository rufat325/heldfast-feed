{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Compare a vehicle's price to like units"
 },
 "description": "Price context for one vehicle against like units across the network (same make, model, exact model year, condition; optional trim and geo). Example: {\"identity\": \"<VIN>\", \"rooftop_slug\": \"mms\"} or {\"make\": \"Subaru\", \"model\": \"Outback\", \"model_year\": 2024, \"condition\": \"used\"}. Returns count, price quartiles, the subject's rank and up to 5 cheapest peers. Advertised prices only; call quote_preview for a total. Pass country=CA for Canadian dealers.",
 "inputSchema": {
  "additionalProperties": false,
  "description": "Server-enforced: latitude requires longitude; longitude requires latitude; radius_miles requires latitude and longitude. Exactly one of identity | make+model+model_year is required. Additional argument rules are enforced server-side.",
  "properties": {
   "condition": {
    "enum": [
     "new",
     "used"
    ]
   },
   "country": {
    "default": "US",
    "description": "Market to search; rooftops in the other country are excluded. Prices are in that country's currency; the radius stays in miles.",
    "enum": [
     "US",
     "CA"
    ],
    "type": "string"
   },
   "currency": {
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "identity": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "make": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "model": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "model_year": {
    "maximum": 2100,
    "minimum": 1950,
    "type": "integer"
   },
   "model_year_expand": {
    "default": 0,
    "enum": [
     0,
     1
    ],
    "type": "integer"
   },
   "radius_miles": {
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "number"
   },
   "rooftop_slug": {
    "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
    "type": "string"
   },
   "trim": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
