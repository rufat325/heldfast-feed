{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create or update a ticket matched by exact title. Returns {ticket, action: 'created'|'updated'|'unchanged'}. Idempotent \u2014 safe to call repeatedly without duplicate errors.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benefit": {
    "anyOf": [
     {
      "const": 1,
      "type": "number"
     },
     {
      "const": 2,
      "type": "number"
     },
     {
      "const": 3,
      "type": "number"
     },
     {
      "const": 5,
      "type": "number"
     },
     {
      "const": 8,
      "type": "number"
     },
     {
      "const": 13,
      "type": "number"
     },
     {
      "const": 21,
      "type": "number"
     }
    ],
    "description": "Benefit score (Fibonacci: 1,2,3,5,8,13,21)"
   },
   "description": {
    "description": "Ticket description (max 10000 chars)",
    "type": "string"
   },
   "estimate": {
    "anyOf": [
     {
      "const": 1,
      "type": "number"
     },
     {
      "const": 2,
      "type": "number"
     },
     {
      "const": 3,
      "type": "number"
     },
     {
      "const": 5,
      "type": "number"
     },
     {
      "const": 8,
      "type": "number"
     },
     {
      "const": 13,
      "type": "number"
     },
     {
      "const": 21,
      "type": "number"
     }
    ],
    "description": "Estimate score (Fibonacci: 1,2,3,5,8,13,21)"
   },
   "penalty": {
    "anyOf": [
     {
      "const": 1,
      "type": "number"
     },
     {
      "const": 2,
      "type": "number"
     },
     {
      "const": 3,
      "type": "number"
     },
     {
      "const": 5,
      "type": "number"
     },
     {
      "const": 8,
      "type": "number"
     },
     {
      "const": 13,
      "type": "number"
     },
     {
      "const": 21,
      "type": "number"
     }
    ],
    "description": "Penalty score (Fibonacci: 1,2,3,5,8,13,21)"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "risk": {
    "anyOf": [
     {
      "const": 1,
      "type": "number"
     },
     {
      "const": 2,
      "type": "number"
     },
     {
      "const": 3,
      "type": "number"
     },
     {
      "const": 5,
      "type": "number"
     },
     {
      "const": 8,
      "type": "number"
     },
     {
      "const": 13,
      "type": "number"
     },
     {
      "const": 21,
      "type": "number"
     }
    ],
    "description": "Risk score (Fibonacci: 1,2,3,5,8,13,21)"
   },
   "title": {
    "description": "Ticket title (used as the unique key)",
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "ticket_upsert",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "created",
     "updated",
     "unchanged"
    ],
    "type": "string"
   },
   "ticket": {
    "additionalProperties": false,
    "properties": {
     "benefit": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "created_at": {
      "description": "ISO timestamp",
      "type": "string"
     },
     "description": {
      "type": [
       "string",
       "null"
      ]
     },
     "estimate": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "id": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "penalty": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "project_id": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "risk": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "ticket_uuid": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "updated_at": {
      "description": "ISO timestamp",
      "type": "string"
     }
    },
    "required": [
     "id",
     "ticket_uuid",
     "project_id",
     "title",
     "description",
     "benefit",
     "penalty",
     "estimate",
     "risk",
     "created_at",
     "updated_at"
    ],
    "type": "object"
   }
  },
  "required": [
   "ticket",
   "action"
  ],
  "type": "object"
 }
}
