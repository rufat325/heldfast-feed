{
 "annotations": {
  "readOnlyHint": true,
  "title": "List clinical notes"
 },
 "description": "List clinical notes, filterable by patient, date, date range, or last-modified time. Returns a page plus `next`/`previous`. DrChrono API: GET /clinical_notes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date": {
    "description": "Filter by a single day, yyyy-mm-dd.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_range": {
    "description": "Inclusive range \"yyyy-mm-dd/yyyy-mm-dd\", e.g. \"2026-01-01/2026-02-01\".",
    "type": "string"
   },
   "page": {
    "description": "Page number to fetch (1-based). Default 1.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "page_size": {
    "description": "Results per page (max 250). Default 100.",
    "exclusiveMinimum": 0,
    "maximum": 250,
    "type": "integer"
   },
   "patient": {
    "description": "Filter by patient id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "since": {
    "description": "Notes modified at/after this ISO timestamp.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "drchrono_list_clinical_notes",
 "title": "List clinical notes"
}
