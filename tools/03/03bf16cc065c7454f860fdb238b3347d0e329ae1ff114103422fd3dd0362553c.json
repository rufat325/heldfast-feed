{
 "annotations": {
  "readOnlyHint": true,
  "title": "List candidates"
 },
 "description": "List candidates, newest first, optionally narrowed to one job, a name/job search, qualified or disqualified only, specific ids, or those created after a date. Paginate with limit + offset (next offset = offset + limit). Recruitee: GET /c/{company_id}/candidates.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "created_after": {
    "description": "Only candidates created after this date (ISO 8601).",
    "type": "string"
   },
   "disqualified": {
    "description": "true = only disqualified candidates.",
    "type": "boolean"
   },
   "ids": {
    "description": "Only these candidate ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "limit": {
    "description": "Candidates per page (default 100, max 1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "offer_id": {
    "description": "Only candidates on this job/talent pool.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "offset": {
    "description": "Number of candidates to skip.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "qualified": {
    "description": "true = only qualified candidates.",
    "type": "boolean"
   },
   "query": {
    "description": "Search by candidate name or job.",
    "type": "string"
   },
   "sort": {
    "description": "Sort order (default by_date).",
    "enum": [
     "by_date",
     "by_last_message"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "recruitee_list_candidates",
 "title": "List candidates"
}
