{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Firecrawl crawl status"
 },
 "description": "\nRetrieve the current status, progress, and available results for an existing crawl ID. This only reads Firecrawl job state and does not start or modify the crawl.\n",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "firecrawl_check_crawl_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Crawl job state and the documents collected so far.",
  "properties": {
   "agent_hints": {
    "description": "Optional response guidance from the Firecrawl API.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "completed": {
    "description": "Pages crawled so far.",
    "type": [
     "number",
     "null"
    ]
   },
   "creditsUsed": {
    "description": "Credits the crawl consumed.",
    "type": [
     "number",
     "null"
    ]
   },
   "data": {
    "description": "Scraped documents collected by the crawl."
   },
   "error": {
    "description": "Error message or error object when the call did not succeed."
   },
   "expiresAt": {
    "description": "When the crawl results expire.",
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "description": "Crawl identifier, for `firecrawl_check_crawl_status`.",
    "type": [
     "string",
     "null"
    ]
   },
   "next": {
    "description": "URL of the next page of results, when the data is paginated.",
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "description": "Crawl state, such as `scraping`, `completed`, or `failed`.",
    "type": [
     "string",
     "null"
    ]
   },
   "success": {
    "description": "Whether the API call succeeded.",
    "type": [
     "boolean",
     "null"
    ]
   },
   "total": {
    "description": "Pages the crawl expects to visit.",
    "type": [
     "number",
     "null"
    ]
   },
   "url": {
    "description": "The URL the crawl started from.",
    "type": [
     "string",
     "null"
    ]
   },
   "warning": {
    "description": "Non-fatal warning about the result.",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 }
}
