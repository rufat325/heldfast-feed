{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The runner's planned runs between two dates: day, name, miles, time, tag, the runner's note, whether a logged run fulfilled it, and whether ourpr create wrote it. Read it before ourpr_plan_week so a new plan does not land on a day that already holds one.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "end_date": {
    "description": "Last day, YYYY-MM-DD. Default 13 days after the first.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "start_date": {
    "description": "First day, YYYY-MM-DD. Default today.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ourpr_list_plans",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "end_date": {
    "type": "string"
   },
   "plans": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "start_date": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "plans",
   "start_date",
   "end_date",
   "truncated"
  ],
  "type": "object"
 },
 "title": "List planned runs in a date range"
}
