    "enum": [
     "packet-format",
     "prerequisites",
     "sleep-states",
     "troubleshooting",
     "host-profiles",
     "sender-environment"
    ],
    "type": "string"
   },
   "topics": {
    "description": "Every available topic, for navigation.",
    "items": {
     "description": "A topic name.",
     "enum": [
      "packet-format",
      "prerequisites",
      "sleep-states",
      "troubleshooting",
      "host-profiles",
      "sender-environment"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
