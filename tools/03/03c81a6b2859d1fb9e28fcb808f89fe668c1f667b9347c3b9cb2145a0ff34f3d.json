{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Fetch platform compatibility metadata for a HeyClaude skill entry.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Entry category (defaults to 'skills').",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   },
   "slug": {
    "description": "Slug of the skill entry to check compatibility for.",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "install.compatibility",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "ok": {
    "type": "boolean"
   },
   "policy": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
