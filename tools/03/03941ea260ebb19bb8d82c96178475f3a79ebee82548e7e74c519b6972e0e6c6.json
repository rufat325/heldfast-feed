{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Verify Fees"
 },
 "description": "Verify that the off-chain fee quote matches what the on-chain DPXSettlementRouter contract will charge. Returns feesMatch (true/false). Call after get_quote and before settle to confirm fee integrity.",
 "inputSchema": {
  "properties": {
   "amountUsd": {
    "description": "Settlement amount in USD",
    "type": "number"
   },
   "esgScore": {
    "description": "ESG score 0\u2013100",
    "type": "number"
   },
   "hasFx": {
    "description": "Cross-currency settlement?",
    "type": "boolean"
   }
  },
  "required": [
   "amountUsd"
  ],
  "type": "object"
 },
 "name": "fees.verify",
 "outputSchema": {
  "properties": {
   "delta": {
    "description": "Absolute difference in basis points",
    "type": "number"
   },
   "feesMatch": {
    "description": "True if off-chain quote matches on-chain contract",
    "type": "boolean"
   },
   "offChainFee": {
    "properties": {
     "pct": {
      "type": "number"
     },
     "usd": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "onChainFee": {
    "properties": {
     "pct": {
      "type": "number"
     },
     "usd": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "recommendation": {
    "description": "PROCEED | INVESTIGATE",
    "type": "string"
   }
  },
  "type": "object"
 }
}
