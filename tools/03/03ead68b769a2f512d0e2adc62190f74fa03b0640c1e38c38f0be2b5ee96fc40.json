{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "utilpeek: count words and score the readability of a text"
 },
 "description": "utilpeek: Count words and score the readability of a text. For word frequencies use text_frequency. Returns counts (characters, letters, words, unique words, sentences, paragraphs, averages), reading and speaking time, and for English the Flesch reading ease, Flesch-Kincaid grade, Gunning fog, SMOG, Coleman-Liau and ARI scores (estimates from heuristic syllable counts; Dale-Chall is not offered). An unsupported `lang` is a 422 invalid_lang and text without words a 422 no_words (not charged). Word counts undercount scripts written without spaces. Typically under 0.2 s. Price: USD 0.001. Free: 10 utilpeek calls per IP per UTC day. The submitted text is never logged or stored. Docs: https://tanod.dev/learn/text-statistics-api.html",
 "inputSchema": {
  "properties": {
   "lang": {
    "anyOf": [
     {
      "maxLength": 3,
      "minLength": 2,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "ISO 639 code; readability scores are computed for English only (default en); any other language gets counts only.",
    "title": "Lang"
   },
   "text": {
    "description": "The text (at most 200,000 characters).",
    "maxLength": 200000,
    "minLength": 1,
    "title": "Text",
    "type": "string"
   }
  },
  "required": [
