{
 "description": "Update an existing product. Pass product_id + only the fields to change. To change\nprice/stock, pass variations (get_product first to see the existing variation shape).\nImages must be hosted CDN urls (search_images cdn_url / upload_images).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category_ids": {
    "description": "Replace the product's categories",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "description": {
    "description": "New description (HTML allowed)",
    "type": "string"
   },
   "images": {
    "description": "New hosted image URLs; first becomes the thumbnail",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "is_published": {
    "description": "Publish/unpublish the product",
    "type": "boolean"
   },
   "name": {
    "description": "New name",
    "type": "string"
   },
   "product_id": {
    "description": "Product id to update",
    "type": "string"
   },
   "variations": {
    "description": "Replace variations (price/stock/SKU per variant). Reuse existing custom_ids from get_product to edit in place.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "custom_id": {
       "description": "SKU for this variation (auto-generated if omitted)",
       "type": "string"
      },
      "fields": {
       "description": "Attribute values for this variation, e.g. [{name:'Color',value:'\u0110en'},{name:'Size',value:'M'}]",
       "items": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "type": "string"
         },
         "value": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "images": {
       "description": "Hosted image URLs for this variation",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "original_price": {
       "description": "List/compare-at price (defaults to retail_price)",
       "type": "number"
      },
      "remain_quantity": {
       "description": "Stock quantity (default 100)",
       "type": "number"
      },
      "retail_price": {
       "description": "Selling price (what the customer pays)",
       "type": "number"
      },
      "weight": {
       "description": "Weight in grams (default 0)",
       "type": "number"
      }
     },
     "required": [
      "retail_price"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "product_id"
  ],
  "type": "object"
 },
 "name": "update_product"
}
