{
 "description": "Create a Responsive Display Ad in a DISPLAY ad group from uploaded image assets + text. Provide marketing image asset resource_names (landscape 1.91:1) and square (1:1), plus headlines, descriptions, business name, and final URL. Refs #5744.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adGroupId": {
    "description": "DISPLAY ad group ID.",
    "type": "string"
   },
   "businessName": {
    "description": "Business name (\u226425 chars), e.g. \"AINative\".",
    "type": "string"
   },
   "customerId": {
    "description": "Google Ads customer ID. Defaults to GOOGLE_ADS_CUSTOMER_ID env var.",
    "type": "string"
   },
   "descriptions": {
    "description": "1\u20135 descriptions (\u226490 chars).",
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "finalUrl": {
    "description": "Landing page URL.",
    "type": "string"
   },
   "headlines": {
    "description": "1\u20135 short headlines (\u226430 chars).",
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "logoImageAssets": {
    "description": "Optional square logo image asset resource names.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "longHeadline": {
    "description": "One long headline (\u226490 chars).",
    "type": "string"
   },
   "marketingImageAssets": {
    "description": "Resource names of landscape (1.91:1) image assets.",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "squareImageAssets": {
    "description": "Resource names of square (1:1) image assets.",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "status": {
    "default": "ENABLED",
    "enum": [
     "ENABLED",
     "PAUSED"
    ],
    "type": "string"
   }
  },
  "required": [
   "adGroupId",
   "marketingImageAssets",
   "squareImageAssets",
   "headlines",
   "longHeadline",
   "descriptions",
   "businessName",
   "finalUrl"
