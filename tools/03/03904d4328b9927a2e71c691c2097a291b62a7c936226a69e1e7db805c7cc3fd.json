{
 "description": "Get a single company by UUID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "logo_format": {
    "description": "Image format for meta.logo_url (default: jpg, webp ~30% smaller)",
    "enum": [
     "jpg",
     "webp"
    ],
    "type": "string"
   },
   "logo_size": {
    "description": "Logo size in meta.logo_url (default: 1024)",
    "enum": [
     "64",
     "128",
     "256",
     "512",
     "1024"
    ],
    "type": "string"
   },
   "uuid": {
    "description": "The company UUID",
    "type": "string"
   }
  },
  "required": [
   "uuid"
  ],
  "type": "object"
 },
 "name": "get_company"
}
