{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hotelumo:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get hotel details"
 },
 "description": "Use this when someone asks about one hotel's setup, such as its default check-in and check-out times, currency, country or timezone. Returns the hotel's name, currency, language, timezone, country code and default check-in and check-out times, or not-found. Not for room availability or prices.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hotelId": {
    "description": "Hotel id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "hotelId"
  ],
  "type": "object"
 },
 "name": "get_hotel",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hotel": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "checkInDefaultTime": {
        "$ref": "#/properties/hotel/anyOf/0/properties/name"
       },
       "checkOutDefaultTime": {
        "$ref": "#/properties/hotel/anyOf/0/properties/name"
       },
       "countryCode": {
        "$ref": "#/properties/hotel/anyOf/0/properties/name"
       },
       "currency": {
        "$ref": "#/properties/hotel/anyOf/0/properties/name"
       },
       "id": {
        "pattern": "^[0-9a-f]{24}$",
        "type": "string"
       },
       "lastEditTime": {
        "$ref": "#/properties/hotel/anyOf/0/properties/name"
       },
       "locale": {
        "$ref": "#/properties/hotel/anyOf/0/properties/name"
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "timezone": {
        "$ref": "#/properties/hotel/anyOf/0/properties/name"
       }
      },
      "required": [
       "id",
       "name",
       "currency",
       "locale",
       "timezone",
       "countryCode",
       "checkInDefaultTime",
       "checkOutDefaultTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Operational hotel metadata; null when not found. Contact details, addresses, integrations, credentials, payment configuration, reminders and guest data are never returned."
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "hotel"
  ],
  "type": "object"
 },
 "title": "Get hotel details"
}
