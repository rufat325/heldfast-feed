{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compare several models side by side at a given volume: cost per request and per month, prices, context window, output limit, release date and knowledge cutoff, from AI Gateway's live catalog. Pass ids like 'openai/gpt-4.1-mini', or a provider name ('anthropic', 'openai', 'google') for its newest models, so you don't need to know which models are current.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cached_share": {
    "description": "Share of input tokens served from the prompt cache, 0 to 1",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "input_tokens": {
    "description": "Input tokens per request: system prompt, retrieved documents, history and the user's message",
    "maximum": 2000000,
    "minimum": 0,
    "type": "integer"
   },
   "models": {
    "description": "Model ids like 'openai/gpt-4.1-mini', or provider names like 'anthropic' for that provider's newest models",
    "items": {
     "maxLength": 100,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   },
   "output_tokens": {
    "description": "Output tokens per request: the length of a typical reply",
    "maximum": 200000,
    "minimum": 0,
    "type": "integer"
   },
   "requests_per_day": {
    "description": "Expected requests per day, for the monthly cost",
    "maximum": 100000000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "models",
   "input_tokens",
   "output_tokens",
   "requests_per_day"
  ],
  "type": "object"
 },
 "name": "compare_models",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "live_catalog": {
    "type": "boolean"
   },
   "models": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "context_window": {
       "type": "number"
      },
      "fits": {
       "description": "Whether the request's input and output fit the model's context window and output limit",
       "type": "boolean"
      },
      "knowledge_cutoff": {
       "type": "string"
      },
      "max_output": {
       "type": "number"
      },
      "model": {
       "type": "string"
      },
      "per_month": {
       "type": "number"
      },
      "per_request": {
       "type": "number"
      },
      "prices_per_million": {
       "additionalProperties": false,
       "description": "Dollars per million tokens",
       "properties": {
        "cached_input": {
         "type": "number"
        },
        "input": {
         "type": "number"
        },
        "output": {
         "type": "number"
        }
       },
       "required": [
        "input",
        "cached_input",
        "output"
       ],
       "type": "object"
      },
      "released": {
       "type": "string"
      }
     },
     "required": [
      "model",
      "per_request",
      "per_month",
      "prices_per_million",
      "fits"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "requests_per_day": {
    "type": "number"
   },
   "unknown": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "requests_per_day",
   "models",
   "unknown",
   "live_catalog"
  ],
  "type": "object"
 },
 "title": "Compare models"
}
