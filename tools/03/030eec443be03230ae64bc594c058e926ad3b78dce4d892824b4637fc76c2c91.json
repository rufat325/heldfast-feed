{
 "description": "Generate the exact shadcn-CLI install command for one or more 0n\ncomponents. Supports npm, pnpm, yarn, and bun.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "components": {
    "description": "Component slug(s) \u2014 e.g., ['0n-spotlight', '0n-modal-box']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "packageManager": {
    "default": "npm",
    "enum": [
     "npm",
     "pnpm",
     "yarn",
     "bun"
    ],
    "type": "string"
   }
  },
  "required": [
   "components"
  ],
  "type": "object"
 },
 "name": "pwd_install"
}
