{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Verify a Quote"},"description":"Checks whether a quoted passage is in the Urantia Papers. Returns `verdict` (exact, close, not_found), the reference and exact text of the best match, each word that differs, and other places the quote appears. Case and punctuation are ignored. A quote must be at least 4 words and fall within one paragraph. Give `ref` (such as \"2:5.1\") to also check the reference the quote claims. A quote of an older edition (such as the 1955 first printing) also matches: `match.edition` names the edition, and `match.variants` gives the changes.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"ref":{"description":"The reference the quote claims, such as \"2:5.1\".","maxLength":40,"type":"string"},"text":{"description":"The quoted passage to check. At least 4 words.","maxLength":2000,"minLength":1,"type":"string"}},"required":["text"],"type":"object"},"name":"quotes.verify","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"data":{"additionalProperties":false,"properties":{"alsoFoundAt":{"items":{"type":"string"},"type":"array"},"claimedReference":{"anyOf":[{"additionalProperties":false,"properties":{"exists":{"type":"boolean"},"ref":{"type":"string"},"verdict":{"anyOf":[{"enum":["exact","close","not_found"],"type":"string"},{"type":"null"}]}},"required":["ref","exists","verdict"],"type":"object"},{"type":"null"}]},"match":{"anyOf":[{"additionalProperties":false,"properties":{"differences":{"items":{"additionalProperties":false,"properties":{"quote":{"type":"string"},"text":{"type":"string"}},"required":["quote","text"],"type":"object"},"type":"array"},"edition":{"type":"string"},"paperId":{"type":"string"},"paperTitle":{"type":"string"},"reference":{"type":"string"},"sectionTitle":{"anyOf":[{"type":"string