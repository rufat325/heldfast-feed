 "description": "Get historical OHLCV candle data for a symbol.\n\nReturns a markdown table of the most recent candles within the requested\nperiod, capped at the last 30 rows for readability. A footnote line is\nadded when truncation occurs so the agent knows more data was available.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dpop_token": {
    "default": "",
    "type": "string"
   },
   "frequency": {
    "default": 1,
    "description": "Frequency interval (only meaningful for \"minute\" candles).",
    "type": "integer"
   },
   "frequency_type": {
    "default": "daily",
    "description": "\"minute\", \"daily\", \"weekly\", or \"monthly\".",
    "type": "string"
   },
   "npub": {
    "default": "",
    "description": "Required. Your Nostr public key (npub1...) for credit billing.",
    "type": "string"
   },
   "period": {
    "default": 1,
    "description": "Number of periods (see valid combinations above).",
    "type": "integer"
   },
   "period_type": {
    "default": "month",
    "description": "\"day\", \"month\", \"year\", or \"ytd\".",
    "type": "string"
   },
   "symbol": {
    "description": "Ticker symbol (equity, ETF, or $-prefixed index).",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "schwab_get_price_history",
 "outputSchema": {
  "properties": {
   "result": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": true,
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object",
  "x-fastmcp-wrap-result": true
 }
}
