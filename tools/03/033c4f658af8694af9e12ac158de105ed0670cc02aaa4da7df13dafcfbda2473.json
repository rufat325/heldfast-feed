{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List clariBI subscription tiers with prices, AI credits, data source limits, user limits, and headline features. No authentication required.",
 "inputSchema": {
