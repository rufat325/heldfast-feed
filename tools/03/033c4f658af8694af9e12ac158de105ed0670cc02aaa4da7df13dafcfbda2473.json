  "properties": {
   "tier": {
    "description": "Optional. Return only this tier (free, trial, lite, starter, professional, enterprise).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "check_pricing",
 "outputSchema": {
  "properties": {
   "billing_url": {
    "format": "uri",
    "type": "string"
   },
   "currency": {
    "description": "ISO currency code, always \"USD\".",
    "type": "string"
   },
   "tiers": {
    "items": {
     "properties": {
      "ai_credits": {
       "type": "integer"
      },
      "data_sources": {
       "type": "integer"
      },
      "duration_days": {
       "description": "Trial length in days; 0 for paid tiers.",
       "type": "integer"
      },
      "headline_features": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "max_users": {
       "type": "integer"
      },
      "name": {
       "description": "Display name of the tier.",
       "type": "string"
      },
      "price_monthly_usd": {
       "type": "number"
      },
      "price_yearly_usd": {
       "type": "number"
      },
      "storage_gb": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "name",
      "price_monthly_usd",
      "price_yearly_usd"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
