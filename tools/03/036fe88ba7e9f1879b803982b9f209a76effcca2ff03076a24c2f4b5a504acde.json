{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find deterministic source-to-sink dataflow paths between anchored flow points.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "expand": {
    "description": "Optional bounded expansion sections to materialize. Heavy tools return counts/previews by default and expand only the requested sections.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "expand_limit": {
    "description": "Max rows to materialize for expanded sections (default: 10, capped at 25)",
    "type": "number"
   },
   "flow_kind": {
    "default": "value",
    "enum": [
     "value",
     "taint"
    ],
    "type": "string"
   },
   "include_evidence": {
    "description": "Include supporting evidence in expanded rows. Defaults to false to keep payloads compact.",
    "type": "boolean"
   },
   "limit": {
    "description": "Max flow paths (default: 10)",
    "type": "number"
   },
   "max_hops": {
    "description": "Max flow propagation hops (default: 4)",
    "type": "number"
   },
   "min_confidence": {
    "description": "Filter out facts below this confidence tier",
    "enum": [
     "low",
     "inferred",
     "exact",
     "precise"
    ],
    "type": "string"
   },
   "path": {
    "description": "Indexed project root or a file/directory inside the indexed project",
    "type": "string"
   },
   "sink": {
    "properties": {
     "anchor": {
      "description": "Anchor within the selected symbol",
      "properties": {
       "access_path": {
        "description": "Bounded property path segments for property anchors",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "kind": {
        "enum": [
         "param",
         "local",
         "return",
         "property"
        ],
        "type": "string"
       },
       "name": {
        "description": "Anchor name for param/local/property",
        "type": "string"
       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     },
     "symbol": {
      "description": "Canonical selector for the symbol that owns this flow point",
      "properties": {
       "file": {
        "description": "File path used with name to disambiguate symbol",
        "type": "string"
       },
       "name": {
        "description": "Symbol name (must be paired with file)",
        "type": "string"
       },
       "qualified_name": {
        "description": "Canonical qualified symbol name",
        "type": "string"
       },
       "symbol_id": {
        "description": "Canonical symbol id",
        "type": "number"
       },
       "workspace_qualified_name": {
        "description": "Canonical workspace-qualified symbol name",
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "required": [
     "symbol",
     "anchor"
    ],
    "type": "object"
   },
   "source": {
    "properties": {
     "anchor": {
      "description": "Anchor within the selected symbol",
      "properties": {
       "access_path": {
        "description": "Bounded property path segments for property anchors",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "kind": {
        "enum": [
         "param",
         "local",
         "return",
         "property"
        ],
        "type": "string"
       },
       "name": {
        "description": "Anchor name for param/local/property",
        "type": "string"
       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     },
     "symbol": {
      "description": "Canonical selector for the symbol that owns this flow point",
      "properties": {
       "file": {
        "description": "File path used with name to disambiguate symbol",
        "type": "string"
       },
       "name": {
        "description": "Symbol name (must be paired with file)",
        "type": "string"
       },
       "qualified_name": {
        "description": "Canonical qualified symbol name",
        "type": "string"
       },
       "symbol_id": {
        "description": "Canonical symbol id",
        "type": "number"
       },
       "workspace_qualified_name": {
        "description": "Canonical workspace-qualified symbol name",
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "required": [
     "symbol",
     "anchor"
    ],
    "type": "object"
   },
   "verbosity": {
    "default": "compact",
    "description": "Response budget. `minimal` returns the shortest actionable answer, `compact` keeps key reasoning visible, and `full` includes supporting detail.",
    "enum": [
     "minimal",
     "compact",
     "full"
    ],
    "type": "string"
   }
  },
  "required": [
   "source",
   "path"
  ],
  "type": "object"
 },
 "name": "trace_dataflow",
 "title": "Trace Dataflow"
}
