    "maxLength": 100,
    "pattern": "^[a-z0-9]+:[A-Za-z0-9._-]+$",
    "type": "string"
   },
   "max_price_usd": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "method": {
    "default": "GET",
    "enum": [
     "GET",
     "HEAD",
     "POST"
    ],
    "type": "string"
   },
   "resource_url": {
    "description": "Public HTTPS x402 resource to inspect without payment credentials.",
    "format": "uri",
    "maxLength": 2048,
    "pattern": "^https://",
    "type": "string"
   }
  },
  "required": [
   "resource_url"
  ],
  "type": "object"
 },
