{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Compare citation signals across URLs"
 },
 "description": "Run predict_citation on 2-10 URLs and return a side-by-side signal table plus a list of signals where the URLs diverge. Use to compare your URL to top-cited competitors for the same query.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "urls": {
    "description": "URLs to compare side-by-side. 2-10 URLs. One is typically yours and the rest are cited competitors.",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "urls"
  ],
  "type": "object"
 },
 "name": "competitors_compare",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "diverging_signals": {
    "description": "Signals where at least one URL differs from the others.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "per_url": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "url": {
          "type": "string"
         },
         "value": {
          "type": "boolean"
         }
        },
        "required": [
         "url",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "signal": {
       "description": "Signal name where URLs differ.",
       "type": "string"
      }
     },
     "required": [
      "signal",
      "per_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "fetched_at": {
    "description": "UTC ISO-8601 timestamp.",
    "type": "string"
   },
   "rows": {
    "description": "Per-URL predict_citation rows (or { url, error } on failure).",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "fetched_at",
   "rows",
   "diverging_signals"
  ],
  "type": "object"
 }
}
