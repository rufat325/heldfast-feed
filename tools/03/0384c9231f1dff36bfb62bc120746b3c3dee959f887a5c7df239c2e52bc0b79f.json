{
 "_meta": {
  "category": "cost",
  "tier": "reporter"
 },
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Preview filter patterns"
 },
 "description": "CALL THIS AFTER log10x_explain_mode when the user picks Preview. Shows the list of patterns that would be affected by applying a given enforcement mode to a service, before any action is taken. Returns a fixed-width plain-text table (no markdown pipes) with columns: rank, descriptor, volume, %, service, severity, first seen, trend sparkline. Writes a CSV to /tmp/log10x-preview-<mode>-<service>.csv. must_ask_user offers: drill into pattern #N (calls log10x_pattern_detail), Apply, or go back to pick a different mode. forbidden_next_actions locks log10x_configure_engine, log10x_pattern_mitigate, and log10x_advise_retriever until the user commits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "environment": {
    "description": "Environment nickname for multi-env setups.",
    "type": "string"
   },
   "mode": {
    "description": "The enforcement mode being previewed. Controls which patterns are highlighted as affected.",
    "enum": [
     "compact",
     "offload",
     "tier_down",
     "sample",
     "drop",
     "observe_only"
    ],
    "type": "string"
   },
   "service": {
    "description": "Service to scope the preview to.",
    "type": "string"
   },
   "top_n": {
    "default": 20,
    "description": "Number of patterns to surface. Default 20.",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "service",
   "mode"
  ],
  "type": "object"
 },
 "name": "log10x_preview_filter",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
