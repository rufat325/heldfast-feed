{
 "description": "Header/summary of a ledger (default the latest validated). Read-only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ledgerIndex": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "string"
     }
    ],
    "default": "validated"
   },
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_ledger"
}
