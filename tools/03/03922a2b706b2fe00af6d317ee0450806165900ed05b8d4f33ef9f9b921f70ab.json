{"_meta":{"securitySchemes":[{"type":"noauth"},{"scopes":["read","write"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Add cards"},"description":"ADDS cards to a board; existing cards are never touched. Leave x, y, w and h out: cards are sized to what they hold and laid out by section as arrange_board does, in the order sent (x and y place only one or two cards). A note's body takes \"- \" bullets, \"1. \" lists, \"[ ] \" checkboxes, **bold**, *italic*: one idea per note; long writing goes in write_doc. Name a section in group; groups gives their order and colours. For pictures from the web use import_urls, not uploaded bytes; for your own bytes upload_image, then pass its image_key.","inputSchema":{"additionalProperties":false,"properties":{"board_id":{"description":"The board","format":"uuid","type":"string"},"cards":{"description":"The cards to add","items":{"additionalProperties":false,"properties":{"alt":{"type":"string"},"body":{"description":"The text, whatever the kind","type":"string"},"color":{"description":"A hex like \"#f3ddaa\" or a name (blue, clay, green, plum, teal, rose, moss, slate). Left out, a note takes its section\u2019s colour; \"\" for none","type":"string"},"file_key":{"description":"From a multipart upload","type":"string"},"file_name":{"description":"The file\u2019s own name","type":"string"},"group":{"description":"Section name (made if missing)","type":"string"},"group_id":{"description":"A group by id; group, by name, is simpler","type":"string"},"h":{"type":"number"},"html":{"type":"string"},"identifiers":{"description":"Ids from another system: [{scope, value}]","items":{"properties":{"scope":{"type":"string"},"value":{"type":"string"}},"required":["scope","value"],"type":"object"},"type":"array"},"image_key":{"description":"From upload_image, for kind=image","type":"string"},"kind":{"description":"Defaults to note","enum":["note","image","link","doc","video","audio","pdf","file","palette"],"type":"string"},"mime":{"type":"string"},"props":{"description":"Free-form; null removes a key","type":"object"},"rotation":{"description":"Degrees","type":"number"},"section_header":{"description":"A full-width heading","type":"boolean"},"swatches":{"description":"For kind=palette, in order","items":{"properties":{"hex":{"type":"string"},"name":{"type":"string"}},"required":["hex"],"type":"object"},"maxItems":12,"minItems":1,"type":"array"},"title":{"type":"string"},"url":{"type":"string"},"w":{"type":"number"},"x":{"description":"Kept only when one or two cards are added","type":"number"},"y":{"type":"number"},"z":{"description":"Higher is in front","type":"number"}},"type":"object"},"maxItems":1000,"minItems":1,"type":"array"},"draft":{"description":"The draft key create_boards returned. Pass it on every call about that draft.","type":"string"},"groups":{"description":"Sections the cards name (group), in order, each with an optional outline color","items":{"properties":{"color":{"type":"string"},"name":{"type":"string"}},"required":["name"],"type":"object"},"maxItems":50,"type":"array"},"layout":{"description":"Arrange the whole batch this way","enum":["auto","justified","masonry","grid","row","column"],"type":"string"},"on_conflict":{"description":"\"identifier\" updates rather than duplicates","enum":["identifier"],"type":"string"}},"required":["board_id","cards"],"type":"object"},"name":"add_cards","outputSchema":{"properties":{"board_id":{"type":"string"},"cards":{"items":{"properties":{"group":{"type":"string"},"id":{"type":"string"},"kind":{"type":"string"},"title":{"type":"string"}},"type":"object"},"type":"array"},"groups":{"items":{"properties":{"id":{"type":"string"},"name":{"type":"string"}},"type":"object"},"type":"array"},"live":{"type":"boolean"},"warnings":{"items":{"type":"string"},"type":"array"}},"type":"object"},"securitySchemes":[{"type":"noauth"},{"scopes":["read","write"],"type":"oauth2"}],"title"