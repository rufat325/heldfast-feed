{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read one answer's full text and citations using the id and executedAt returned by Answers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "brandSlug": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "executedAt": {
    "format": "date-time",
    "type": "string"
   },
   "id": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "marketId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "brandSlug",
   "marketId",
   "id",
   "executedAt"
  ],
  "type": "object"
 },
 "name": "parse_dashboard_answer",
 "outputSchema": {
  "properties": {
   "data": {},
   "dataAsOf": {
    "type": "string"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "parse:dashboard:read",
    "user:org:read"
   ],
   "type": "oauth2"
  }
 ]
}
