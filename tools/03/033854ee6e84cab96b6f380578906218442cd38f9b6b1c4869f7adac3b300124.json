{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":true,"title":"Foreign Agents (FARA)"},"description":"FARA registrations (efile.fara.gov, DOJ): US agents of foreign principals, one row per registrant and principal pair. Read weekly from DOJ's active list; one that later leaves it stays, as status 'terminated'. Fields: keyvex.com/docs/tools/get_foreign_agents","inputSchema":{"additionalProperties":false,"properties":{"foreign_principal_country":{"description":"Exact, upper-cased, e.g. 'CHINA'.","type":"string"},"foreign_principal_name":{"description":"Case-insensitive substring.","type":"string"},"has_foreign_principal":{"type":"boolean"},"limit":{"description":"Default 50.","maximum":500,"minimum":1,"type":"integer"},"registrant_name":{"description":"Case-insensitive substring.","type":"string"},"registration_number":{"description":"Exact.","type":"string"},"since":{"description":"YYYY-MM-DD, inclusive, on sort_by.","type":"string"},"sort_by":{"description":"Default registration_date.","enum":["registration_date","foreign_principal_reg_date"],"type":"string"},"sort_order":{"description":"Default desc.","enum":["desc","asc"],"type":"string"},"status":{"description":"active = on DOJ's list now; terminated = left it since. Omit for both.","enum":["active","terminated"],"type":"string"},"until":{"description":"YYYY-MM-DD, inclusive, on sort_by.","type":"string"}},"type":"object"},"name":"get_foreign_agents"}
