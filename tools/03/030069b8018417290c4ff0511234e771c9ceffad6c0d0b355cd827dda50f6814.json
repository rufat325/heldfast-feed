{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Chunk, embed, and store a text. Idempotent. Full-text sources only. Requires OPENAI_API_KEY + SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "description": "Library source name. Run library_list_sources for the current list and descriptions.",
    "type": "string"
   }
  },
  "required": [
   "id",
   "source"
  ],
  "type": "object"
 },
 "name": "library_ingest",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "chunksDropped": {
    "type": "number"
   },
   "chunksWritten": {
    "type": "number"
   },
   "skippedDuplicate": {
    "type": "boolean"
   },
   "source": {
    "type": "string"
   },
   "sourceId": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "sourceId",
   "source",
   "title",
   "chunksWritten",
   "chunksDropped",
   "skippedDuplicate"
  ],
  "type": "object"
 },
 "title": "Ingest Into Vector Database"
}
