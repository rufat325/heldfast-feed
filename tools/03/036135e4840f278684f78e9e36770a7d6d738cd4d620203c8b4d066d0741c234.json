{
 "description": "Render a web page (url) or an HTML document (html) to a PDF. Returns the hosted PDF URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adblock": {
    "description": "Block ads",
    "type": "boolean"
   },
   "block_cookie_banner": {
    "description": "Hide cookie consent banners",
    "type": "boolean"
   },
   "html": {
    "description": "HTML document to render instead of a URL",
    "maxLength": 500000,
    "minLength": 1,
    "type": "string"
   },
   "light_mode": {
    "description": "Force light or dark color scheme",
    "enum": [
     "default",
     "light",
     "dark"
    ],
    "type": "string"
   },
   "printed": {
    "description": "Use the print stylesheet. Default true",
    "type": "boolean"
   },
   "url": {
    "description": "Page to capture (http:// or https://)",
    "format": "uri",
    "type": "string"
   },
   "viewport_height": {
    "description": "Viewport height in pixels. Default 1080",
    "maximum": 3840,
    "minimum": 16,
    "type": "integer"
   },
   "viewport_width": {
    "description": "Viewport width in pixels. Default 1920",
    "maximum": 3840,
    "minimum": 16,
    "type": "integer"
   },
   "wait_ms": {
    "description": "Extra wait before capturing, in ms",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "generate_pdf",
 "title": "Convert a web page or HTML to PDF"
}
