{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Post Type"
 },
 "description": "Define a new custom post type (e.g. \"treatment\", \"service\"). Required before creating posts of that type. After creating a post type, use create_post_type_field to define its structured field schema. Those fields are stored in meta on each post \u2014 do not use excerpt for structured data.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "icon": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Icon name or URL"
   },
   "label": {
    "description": "Singular UI label, e.g. \"Treatment\"",
    "type": "string"
   },
   "labelPlural": {
    "description": "Plural UI label, e.g. \"Treatments\"",
    "type": "string"
   },
   "slug": {
    "description": "Lowercase identifier, e.g. \"treatment\". Auto-derived from label if omitted.",
    "type": "string"
   },
   "sortOrder": {
    "description": "Sort order (lower = earlier)",
    "type": "number"
   },
   "supportsBlocks": {
    "description": "Default true",
    "type": "boolean"
   },
   "supportsCategories": {
    "description": "Default true",
    "type": "boolean"
   },
   "supportsExcerpt": {
    "description": "Default true",
    "type": "boolean"
   },
   "supportsFeaturedImage": {
    "description": "Default true",
    "type": "boolean"
   },
   "supportsNesting": {
    "description": "Default false",
    "type": "boolean"
   }
  },
  "required": [
   "slug",
   "label",
   "labelPlural"
  ],
  "type": "object"
 },
 "name": "create_post_type",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
