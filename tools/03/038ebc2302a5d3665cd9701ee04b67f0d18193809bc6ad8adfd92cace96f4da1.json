   },
   "location": {
    "maxLength": 120,
    "type": "string"
   },
   "open_now": {
    "type": "boolean"
   },
   "radius_m": {
    "description": "Metres. Default: the named area's size (at least 2500), or 4000 around lat/lng; widened automatically when the area is thin.",
    "maximum": 30000,
    "minimum": 200,
    "type": "integer"
   },
   "service": {
    "description": "Trade or need, e.g. plumber, dentist, electrician.",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "service"
  ],
  "type": "object"
 },
