{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "CodeInspectus Explain Finding"
 },
 "description": "Return a deep explanation and full remediation plan for a single finding id from a prior scan: what the weakness is, why it matters, concrete fix steps, and references.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "finding_id": {
    "description": "The finding id (e.g. CI-0007) to explain in depth.",
    "type": "string"
   },
   "scan_id": {
    "description": "scan_id the finding belongs to.",
    "pattern": "^scan-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   }
  },
  "required": [
   "scan_id",
   "finding_id"
  ],
  "type": "object"
 },
 "name": "codeinspectus_explain_finding",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "explanation": {
    "type": "string"
   },
   "finding": {
    "additionalProperties": false,
    "properties": {
     "attack_techniques": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "confidence": {
      "enum": [
       "high",
       "medium",
       "low"
      ],
      "type": "string"
     },
     "cwe": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "engine": {
      "enum": [
       "opengrep",
       "gitleaks",
       "trivy",
       "codeinspectus-ai",
       "codeinspectus-pub"
      ],
      "type": "string"
     },
     "engines": {
      "items": {
       "$ref": "#/properties/finding/properties/engine"
      },
      "type": "array"
     },
     "finding_kind": {
      "enum": [
       "vulnerability",
       "license",
       "misconfiguration",
       "secret",
       "sast",
       "ai",
       "other"
      ],
      "type": "string"
     },
     "fingerprint": {
      "type": "string"
     },
     "frameworks": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "controls": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "framework": {
         "type": "string"
        }
       },
       "required": [
        "framework",
        "controls"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "is_secret": {
      "type": "boolean"
     },
     "location": {
      "additionalProperties": false,
      "properties": {
       "end_line": {
        "type": "integer"
       },
       "file": {
        "type": "string"
       },
       "snippet": {
        "type": "string"
       },
       "start_line": {
        "type": "integer"
       }
      },
      "required": [
       "file",
       "start_line",
       "end_line"
      ],
      "type": "object"
     },
     "message": {
      "type": "string"
     },
     "owasp_api": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "owasp_llm": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "owasp_web": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "producer_components": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "remediation": {
      "additionalProperties": false,
      "properties": {
       "code_suggestion": {
        "type": "string"
       },
       "references": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "steps": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "summary": {
        "type": "string"
       }
      },
      "required": [
       "summary",
       "steps",
       "references"
      ],
      "type": "object"
     },
     "rule_id": {
      "type": "string"
     },
     "scope_role": {
      "enum": [
       "primary",
       "supporting_context"
      ],
      "type": "string"
     },
     "secret_value_hash": {
      "type": "string"
     },
     "severity": {
      "enum": [
       "critical",
       "high",
       "medium",
       "low",
       "info"
      ],
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "vulnerability_aliases": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "id",
     "fingerprint",
     "title",
     "severity",
     "engine",
     "engines",
     "rule_id",
     "cwe",
     "location",
     "message",
     "remediation",
     "frameworks",
     "confidence"
    ],
    "type": "object"
   },
   "references": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "remediation": {
    "$ref": "#/properties/finding/properties/remediation"
   },
   "why_it_matters": {
    "type": "string"
   }
  },
  "required": [
   "finding",
   "explanation",
   "why_it_matters",
   "remediation",
   "references"
  ],
  "type": "object"
 },
 "title": "Explain a finding in depth"
}
