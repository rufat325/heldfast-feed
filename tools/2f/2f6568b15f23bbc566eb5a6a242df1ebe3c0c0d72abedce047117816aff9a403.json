{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Top wallets on one Hyperliquid market by volume or realized PnL, up to 200 rows.",
 "inputSchema": {
  "properties": {
   "from": {
    "description": "Unix ms window start (default 24h ago)",
    "type": "number"
   },
   "limit": {
    "description": "Number of rows, max 200, default 25",
    "type": "number"
   },
   "market": {
    "description": "Market symbol (e.g. 'BTC-PERP' or 'flx:GAS-PERP')",
    "type": "string"
   },
   "sort_by": {
    "description": "Ranking metric",
    "enum": [
     "volume",
     "realized_pnl"
    ],
    "type": "string"
   },
   "to": {
    "description": "Unix ms window end (default now)",
    "type": "number"
   }
  },
  "required": [
   "market"
  ],
  "type": "object"
 },
 "name": "get_market_top_wallets",
 "outputSchema": {
  "description": "Top wallets on one market",
  "properties": {
   "data": {
    "description": "Wallets",
    "items": {
     "description": "One wallet",
     "properties": {
      "address": {
       "description": "Wallet address (0x\u2026)"
      },
      "fills": {
       "description": "Fills in the window"
      },
      "first_seen_ms": {
       "description": "First fill in the window, Unix milliseconds"
      },
      "last_seen_ms": {
       "description": "Last fill in the window, Unix milliseconds"
      },
      "losses": {
       "description": "Losing closing fills"
      },
      "maker_fills": {
       "description": "Fills as maker"
      },
      "pct_maker": {
       "description": "Share of fills as maker, 0 to 1"
      },
      "realized_pnl": {
       "description": "Realized PnL in USD"
      },
      "taker_fills": {
       "description": "Fills as taker"
      },
      "volume_usd": {
       "description": "Traded notional in USD"
      },
      "wins": {
       "description": "Profitable closing fills"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "from": {
    "description": "Window start, Unix milliseconds"
   },
   "market": {
    "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
   },
   "sort_by": {
    "description": "Ranking metric"
   },
   "to": {
    "description": "Window end, Unix milliseconds"
   }
  },
  "type": "object"
 }
}
