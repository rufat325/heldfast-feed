{
 "description": "Create a v2 PolicyContext with mandatory sunset. Every v2 object requires one.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "policy_version": {
    "default": "2.0.0",
    "type": "string"
   },
   "trust_epoch": {
    "default": 1,
    "type": "number"
   },
   "valid_until": {
    "description": "ISO 8601 expiration (mandatory, max 180 days)",
    "type": "string"
   },
   "values_floor_version": {
    "default": "1.0.0",
    "type": "string"
   }
  },
  "required": [
   "valid_until"
  ],
  "type": "object"
 },
 "name": "create_policy_context"
}
