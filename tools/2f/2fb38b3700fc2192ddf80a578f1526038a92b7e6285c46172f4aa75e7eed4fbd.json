{"_meta":{"securitySchemes":[{"scopes":["preferences:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Change the connected renter's saved alert search. Send only the fields to change; everything else stays. Saves exactly like the RentReboot preferences page, so its rules apply (for example a search always keeps at least one neighborhood). For a new account, set city together with neighborhoods once; after that the market cannot change here. Confirm the change with the renter first. Weekly recap pauses individual alerts.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"alertFrequency":{"description":"minimal (1-2/day), medium (3-4/day), all, or weekly_recap","enum":["minimal","medium","all","weekly_recap"],"type":"string"},"amenities":{"description":"Replaces the whole amenity list","items":{"properties":{"amenity":{"enum":["elevator","pets","dishwasher","laundry","central_ac","doorman","gym","public_outdoor_space","storage","bike_room","package_room","roofdeck","virtual_doorman","washer_dryer","parking","furnished"],"type":"string"},"required":{"type":"boolean"}},"required":["amenity","required"],"type":"object"},"maxItems":16,"type":"array"},"bathrooms":{"items":{"maximum":4,"minimum":1,"type":"integer"},"maxItems":4,"minItems":1,"type":"array"},"bedrooms":{"description":"0 is a studio, 4 means 4 or more","items":{"maximum":4,"minimum":0,"type":"integer"},"maxItems":5,"minItems":1,"type":"array"},"channel":{"description":"Text alerts need a phone number already on the account","enum":["email","sms","both"],"type":"string"},"city":{"description":"Only for a new search with no neighborhoods yet; send neighborhoods with it","enum":["nyc","sf","la","chicago","dc","miami","boston","seattle","philadelphia","london"],"type":"string"},"includeNearbyBedroomCounts":{"type":"boolean"},"includeUndisclosedAddresses":{"type":"boolean"},"maxRent":{"maximum":100000,"minimum":500,"type":"integer"},"minRent":{"anyOf":[{"maximum":100000,"minimum":0,"type":"integer"},{"type":"null"}],"description":"null removes the minimum"},"moveInDate":{"anyOf":[{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},{"type":"null"}],"description":"YYYY-MM-DD, or null for no date"},"neighborhoods":{"description":"Names or ids from find_search_neighborhoods","properties":{"add":{"items":{"maxLength":80,"minLength":1,"type":"string"},"maxItems":30,"type":"array"},"remove":{"items":{"maxLength":80,"minLength":1,"type":"string"},"maxItems":30,"type":"array"},"set":{"items":{"maxLength":80,"minLength":1,"type":"string"},"maxItems":60,"minItems":1,"type":"array"}},"type":"object"},"noFeeOnly":{"type":"boolean"},"rentStabilized":{"enum":["all","likely","verified"],"type":"string"},"strictMoveInDate":{"description":"Only listings available within 31 days before the move-in date","type":"boolean"},"subwayLines":{"description":"NYC only; replaces the whole list","items":{"properties":{"line":{"pattern":"^[A-Za-z0-9]{1,2}$","type":"string"},"required":{"type":"boolean"}},"required":["line","required"],"type":"object"},"maxItems":30,"type":"array"},"weeklyRecapDay":{"enum":["sunday","monday","tuesday","wednesday","thursday","friday","saturday"],"type":"string"}},"type":"object"},"name":"update_search_preferences","title":"Change my apartment search"}
