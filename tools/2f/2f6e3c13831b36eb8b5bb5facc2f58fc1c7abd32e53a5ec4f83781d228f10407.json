{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Build a UDS request as hex with an annotated breakdown. Services: session, ecu_reset, read_did, write_did, security_seed, security_key, tester_present, routine, request_download, transfer_data, transfer_exit, clear_dtc, read_dtc, control_dtc, comm_control, raw. Numeric strings are hex.",
 "inputSchema": {
  "properties": {
   "action": {
    "enum": [
     "start",
     "stop",
     "results"
    ],
    "type": "string"
   },
   "address": {
    "description": "request_download: e.g. \"0x08000000\".",
    "type": "string"
   },
   "addressBytes": {
    "description": "Default 4.",
    "type": "integer"
   },
   "commType": {
    "description": "comm_control communicationType, default 01."
   },
   "control": {
    "description": "comm_control control type."
   },
   "counter": {
    "description": "transfer_data block sequence counter.",
    "type": "integer"
   },
   "data": {
    "description": "Hex payload (write_did, transfer_data, routine option record).",
    "type": "string"
   },
   "dfi": {
    "description": "dataFormatIdentifier, default 0.",
    "type": "integer"
   },
   "did": {
    "type": "string"
   },
   "dids": {
    "description": "read_did: e.g. [\"F190\",\"F18C\"].",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "group": {
    "description": "clear_dtc group, default FFFFFF.",
    "type": "string"
   },
   "hex": {
    "description": "raw: bytes to pass through.",
    "type": "string"
   },
   "key": {
    "description": "security_key: key bytes in hex.",
    "type": "string"
   },
   "level": {
    "description": "security_seed/security_key: odd seed-request level; the key is sent with level+1.",
    "type": "integer"
   },
   "mask": {
    "description": "read_dtc status mask, default FF."
   },
   "on": {
    "description": "control_dtc: true = DTC setting on.",
    "type": "boolean"
   },
   "rid": {
    "description": "routine: e.g. \"FF00\".",
    "type": "string"
   },
   "service": {
    "enum": [
     "session",
     "ecu_reset",
     "read_did",
     "write_did",
     "security_seed",
     "security_key",
     "tester_present",
     "routine",
     "request_download",
     "transfer_data",
     "transfer_exit",
     "clear_dtc",
     "read_dtc",
     "control_dtc",
     "comm_control",
     "raw"
    ],
    "type": "string"
   },
   "size": {
    "description": "request_download: e.g. \"0x10000\".",
    "type": "string"
   },
   "sizeBytes": {
    "description": "Default 4.",
    "type": "integer"
   },
   "subfunction": {
    "description": "read_dtc sub-function (e.g. 2 = reportDTCByStatusMask)."
   },
   "suppress": {
    "description": "tester_present: set suppressPosRspMsgIndicationBit.",
    "type": "boolean"
   },
   "type": {
    "description": "session/ecu_reset sub-function (number, hex string or name)."
   }
  },
  "required": [
   "service"
  ],
  "type": "object"
 },
 "name": "build_uds_request",
 "title": "Build UDS request"
}
