{
 "description": "Run the full SpatialPack optimization pipeline against a preset. Writes a new GLB to `output_path` (must be inside the sandbox) and returns the structured optimization report \u2014 pass-by-pass before/after stats, baseline comparison, KTX2 status, quality notes. All opt-in passes (decimate, saliencyAware decimation, channelPack ORM, palette PNG re-encode, materialClustering, symmetry detection, cohort-quantize, lockBorder, etc.) are exposed as flat options.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "animations": {
    "additionalProperties": false,
    "properties": {
     "resample": {
      "type": "boolean"
     },
     "simplify": {
      "additionalProperties": false,
      "properties": {
       "epsilon": {
        "minimum": 0,
        "type": "number"
       },
       "extent_aware": {
        "type": "boolean"
       },
       "extent_weight": {
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "channel_pack": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "cohort_quantize": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "override": {
      "additionalProperties": false,
      "properties": {
       "color": {
        "type": "integer"
       },
       "normal": {
        "type": "integer"
       },
       "position": {
        "type": "integer"
       },
       "texcoord": {
        "type": "integer"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "decimate": {
    "additionalProperties": false,
    "properties": {
     "error": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "lock_border": {
      "type": "boolean"
     },
     "ratio": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "saliency_aware": {
      "type": "boolean"
     },
     "saliency_weight": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "ratio",
     "error"
    ],
    "type": "object"
   },
   "input_path": {
    "description": "Source .glb / .gltf path (sandbox-relative).",
    "minLength": 1,
    "type": "string"
   },
   "ktx2_quality": {
    "enum": [
     "fast",
     "balanced",
     "max"
    ],
    "type": "string"
   },
   "material_clustering": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "epsilon": {
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "meshopt": {
    "type": "boolean"
   },
   "meshopt_method": {
    "enum": [
     "quantize",
     "filter"
    ],
    "type": "string"
   },
   "meshopt_scheduler": {
    "enum": [
     "cohort"
    ],
    "type": "string"
   },
   "no_ktx2": {
    "description": "Skip KTX2 encoding even when toktx is on PATH.",
    "type": "boolean"
   },
   "output_path": {
    "description": "Destination .glb path (sandbox-relative).",
    "minLength": 1,
    "type": "string"
   },
   "palette": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "preset": {
    "description": "Preset id: 'web-mobile' | 'web-desktop' | 'quality-max'.",
    "enum": [
     "web-mobile",
     "web-desktop",
     "quality-max"
    ],
    "type": "string"
   },
   "saliency": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "low_factor": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "low_threshold": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "skinning_weights": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "limit": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "symmetry": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "epsilon": {
      "minimum": 0,
      "type": "number"
     },
     "min_match_ratio": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "unlit": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "variance_threshold": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "uv_align": {
    "additionalProperties": false,
    "properties": {
     "block_size": {
      "type": "integer"
     },
     "enabled": {
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "input_path",
   "output_path",
   "preset"
  ],
  "type": "object"
 },
 "name": "optimize",
 "title": "Optimize a glTF / GLB asset"
}
