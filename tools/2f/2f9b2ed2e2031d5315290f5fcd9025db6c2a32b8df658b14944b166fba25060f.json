{
 "annotations": {
  "readOnlyHint": true,
  "title": "Scan region"
 },
 "description": "Scan a bounded box [min..max] (inclusive) and return non-air blocks, optionally filtered to specific block names. Volume is capped at 32768 blocks; shrink the box if you hit the cap.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "includeAir": {
    "description": "Include air blocks (default false)",
    "type": "boolean"
   },
   "matching": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       }
      ],
      "description": "Block name (e.g. \"iron_ore\") or numeric block id"
     },
     {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        }
       ],
       "description": "Block name (e.g. \"iron_ore\") or numeric block id"
      },
      "type": "array"
     }
    ],
    "description": "Restrict to these block name(s)/id(s)"
   },
   "max": {
    "properties": {
     "x": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "y": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "z": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "x",
     "y",
     "z"
    ],
    "type": "object"
   },
   "maxCount": {
    "description": "Max blocks to return (default 1024)",
    "maximum": 4096,
    "minimum": 1,
    "type": "integer"
   },
   "min": {
    "properties": {
     "x": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "y": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "z": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "x",
     "y",
     "z"
    ],
    "type": "object"
   }
  },
  "required": [
   "min",
   "max"
  ],
  "type": "object"
 },
 "name": "get_blocks_in_region"
}
