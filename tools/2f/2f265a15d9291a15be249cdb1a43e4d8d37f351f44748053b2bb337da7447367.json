{
 "description": "Update an Action (toggle enabled, change template, change event name).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actionId": {
    "description": "Action ID",
    "type": "string"
   },
   "apiKey": {
    "description": "Send16 API key (overrides SEND16_API_KEY env var)",
    "type": "string"
   },
   "delaySeconds": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "enabled": {
    "type": "boolean"
   },
   "eventName": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "sendOnce": {
    "type": "boolean"
   },
   "templateSlug": {
    "type": "string"
   }
  },
  "required": [
   "actionId"
  ],
  "type": "object"
 },
 "name": "update_action"
}
