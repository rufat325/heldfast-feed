{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Converts an amount between two currencies using TCMB rates. TRY may be either side. Cross conversions (e.g. USD to EUR) go through TRY using the same rate_type on both legs. Returns the result (6 decimals), the effective rate and a calculation breakdown. Omit date for the latest bulletin. Source: Central Bank of the Republic of T\u00fcrkiye (CBRT/TCMB) daily indicative bulletin, published on business days around 15:30 T\u00fcrkiye time (UTC+3). Rates are TRY per `unit` of currency (JPY is per 100). Decimals are strings. Every result includes source_url, bulletin_date and a disclaimer; rates are indicative, not for official use.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"amount":{"anyOf":[{"type":"string"},{"exclusiveMinimum":0,"type":"number"}],"description":"Positive amount; a string like \"1234.56\" preserves precision"},"date":{"description":"Bulletin date, YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"from":{"description":"Source currency, ISO 4217 (TRY allowed)","pattern":"^[A-Za-z]{3}$","type":"string"},"rate_type":{"default":"forex_selling","description":"TCMB rate to use. forex_* are for transfers, banknote_* for cash; some currencies lack banknote rates.","enum":["forex_buying","forex_selling","banknote_buying","banknote_selling"],"type":"string"},"to":{"description":"Target currency, ISO 4217 (TRY allowed)","pattern":"^[A-Za-z]{3}$","type":"string"}},"required":["from","to","amount"],"type":"object"},"name":"convert_currency","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"bulletin_date":{"type":"string"},"bulletin_no":{"type":["string","null"]},"calculation":{"additionalProperties":false,"properties":{"formula":{"type":"string"},"legs":{"items":{"additionalProperties":false,"properties":{"currency":{"type":"string"},"quote":{"type":"string"},"rate":{"pattern":"^\\d+(\\.\\d+)?$","type":"string"},"unit":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"}},"required":["currency","rate","unit","quote"],"type":"object"},"type":"array"},"note":{"type":"string"},"rate_type":{"enum":["forex_buying","forex_selling","banknote_buying","banknote_selling"],"type":"string"},"rounding":{"type":"string"},"via":{"enum":["TRY","TRL"],"type":"string"}},"required":["rate_type","via","legs","formula","note","rounding"],"type":"object"},"disclaimer":{"type":"string"},"domestic_currency":{"enum":["TRY","TRL"],"type":"string"},"fallback_reason":{"anyOf":[{"enum":["no_bulletin_weekend_or_holiday","not_yet_published"],"type":"string"},{"type":"null"}]},"is_fallback":{"type":"boolean"},"query":{"additionalProperties":false,"properties":{"amount":{"type":"string"},"from":{"type":"string"},"rate_type":{"enum":["forex_buying","forex_selling","banknote_buying","banknote_selling"],"type":"string"},"to":{"type":"string"}},"required":["from","to","amount","rate_type"],"type":"object"},"rate":{"pattern":"^\\d+(\\.\\d+)?$","type":"string"},"requested_date":{"type":["string","null"]},"result":{"pattern":"^\\d+(\\.\\d+)?$","type":"string"},"retrieved_at":{"type":"string"},"source":{"const":"TCMB","type":"string"},"source_url":{"format":"uri","type":"string"}},"required":["source","source_url","bulletin_date","bulletin_no","requested_date","is_fallback","fallback_reason","domestic_currency","retrieved_at","query","result","rate","calculation","disclaimer"],"type":"object"},"title":"Convert currency with TCMB rates"}
