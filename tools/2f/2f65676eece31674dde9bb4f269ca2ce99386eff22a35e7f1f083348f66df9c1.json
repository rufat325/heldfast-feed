{
 "description": "Real-time stock check at a specific retailer for a specific product, including click-and-collect availability at the nearest store to a postcode (where supported).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "postcode": {
    "description": "AU postcode for click-and-collect availability",
    "pattern": "^\\d{4}$",
    "type": "string"
   },
   "product_id": {
    "description": "Canonical product ID",
    "type": "string"
   },
   "retailer_id": {
    "description": "Specific retailer slug (e.g. \"ebay-au\")",
    "type": "string"
   }
  },
  "required": [
   "product_id",
   "retailer_id"
  ],
  "type": "object"
 },
 "name": "check_availability"
}
