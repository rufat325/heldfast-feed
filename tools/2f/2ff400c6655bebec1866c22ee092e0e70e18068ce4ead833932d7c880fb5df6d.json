{
 "description": "Manage the verified local cache, pull published Stratum data, query it locally or from the server, and upload local GeoJSON, CSV, or Parquet. Optional year narrows year-split snapshots; year-split features default to the newest year (2026, then 2025, ...).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "area_id": {
    "type": "string"
   },
   "connectTo": {
    "$ref": "#/properties/feature"
   },
   "database": {
    "type": "string"
   },
   "feature": {
    "type": [
     "string",
     "number"
    ]
   },
   "featureId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "id": {
    "type": "string"
   },
   "key": {
    "type": "string"
   },
   "limit": {
    "default": 1000,
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "default": "auto",
    "enum": [
     "cloud",
     "offline",
     "auto"
    ],
    "type": "string"
   },
   "namespace": {
    "type": "string"
   },
   "operation": {
    "enum": [
     "cacheList",
     "cacheSet",
     "cacheDelete",
     "cacheClear",
     "download",
     "query",
     "upload",
     "featureList",
     "featureSearch",
     "featureInfo",
     "areaList",
     "areaSearch",
     "areaInfo",
     "dataList",
     "dataInfo"
    ],
    "type": "string"
   },
   "output": {
    "type": "string"
   },
   "path": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "size": {
    "type": [
     "string",
     "number"
    ]
   },
   "year": {
    "description": "Optional snapshot year, for example 2026",
    "type": [
     "string",
     "number"
    ]
   }
  },
  "required": [
   "operation"
  ],
  "type": "object"
 },
 "name": "e2_stratum",
 "title": "Manage EmbedEarth Stratum data"
}
