{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Compare two refs"
 },
 "description": "Compare graph between two refs (and optional generation numbers). Prefer this to understand what a branch changes vs its base.",
 "inputSchema": {
  "properties": {
   "baseAt": {
    "description": "Optional generation number on the base ref",
    "type": "integer"
   },
   "baseRef": {
    "description": "Base ref (branch) to compare from",
    "type": "string"
   },
   "headAt": {
    "description": "Optional generation number on the head ref",
    "type": "integer"
   },
   "headRef": {
    "description": "Head ref (branch) to compare to",
    "type": "string"
   },
   "limit": {
    "description": "Max diff entries to return (default 500)",
    "type": "integer"
   },
   "source": {
    "description": "Optional source filter (e.g. github:owner/repo)",
    "type": "string"
   }
  },
  "required": [
   "baseRef",
   "headRef"
  ],
  "type": "object"
 },
 "name": "gently_diff",
 "title": "Compare two refs"
}
