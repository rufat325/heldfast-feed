{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Lists a site's plans, including archived ones, each with its active subscriber count.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "site_id": {
    "description": "The site's id, from list_sites or create_site.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "site_id"
  ],
  "type": "object"
 },
 "name": "list_plans",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "plans": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "activeSubscriberCount": {
       "type": "number"
      },
      "archivedAt": {
       "type": [
        "number",
        "null"
       ]
      },
      "billingInterval": {
       "anyOf": [
        {
         "enum": [
          "month",
          "year"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "currency": {
       "type": [
        "string",
        "null"
       ]
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "polarProductId": {
       "type": [
        "string",
        "null"
       ]
      },
      "priceCents": {
       "type": [
        "number",
        "null"
       ]
      },
      "protectedPaths": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "name",
      "polarProductId",
      "protectedPaths",
      "activeSubscriberCount",
      "archivedAt",
      "priceCents",
      "currency",
      "billingInterval",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "plans"
  ],
  "type": "object"
 },
 "title": "List plans"
}
