{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create MagicScreenshots localization jobs for source App Store screenshots across one or more target locales.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "source_app": {
    "additionalProperties": true,
    "properties": {
     "app_id": {
      "type": "string"
     },
     "app_url": {
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "query": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "source_screenshot_urls": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "target_locales": {
    "description": "Locale IDs such as JPN, DEU, FRA, BRA, or objects with language/country.",
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "additionalProperties": true,
       "properties": {
        "country": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "language": {
         "type": "string"
        }
       },
       "required": [
        "language"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   }
  },
  "required": [
   "source_app",
   "target_locales"
  ],
  "type": "object"
 },
 "name": "create_localize",
 "securitySchemes": [
  {
   "scopes": [
    "openid",
    "email"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Create localize"
}
