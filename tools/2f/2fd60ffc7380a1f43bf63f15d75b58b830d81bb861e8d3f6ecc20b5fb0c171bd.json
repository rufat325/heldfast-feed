{
 "description": "List orders. Defaults to all orders for the calling key (server-side).\nPass customer_email to scope to one buyer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "customer_email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 200,
    "type": "integer"
   },
   "merchant": {
    "format": "uri",
    "type": "string"
   },
   "status": {
    "description": "Filter by order status",
    "enum": [
     "pending",
     "paid",
     "fulfilled",
     "refunded",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ucp_orders"
}
