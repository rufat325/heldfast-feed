{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Dry-run a launch (default) or wire-fees (intent=wire-fees). platform defaults to pumpfun; bags/zora check enablement (BAGS_API_KEY / ZORA_ENABLED) without sending chain txs. Prefer explicit crew[] from crew_list_kols; Autohire is a fallback. Returns dryRunId + approvalUrl. Requires CREW_AGENT_API_KEY.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agentModel": {
    "maxLength": 48,
    "type": "string"
   },
   "agentName": {
    "maxLength": 48,
    "minLength": 2,
    "type": "string"
   },
   "agentObjective": {
    "maxLength": 280,
    "minLength": 8,
    "type": "string"
   },
   "crew": {
    "items": {
     "properties": {
      "evmWallet": {
       "maxLength": 42,
       "minLength": 42,
       "type": "string"
      },
      "handle": {
       "type": "string"
      },
      "hireRole": {
       "enum": [
        "caller",
        "chart",
        "raid",
        "kol",
        "dev"
       ],
       "type": "string"
      },
      "share": {
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      },
      "wallet": {
       "maxLength": 64,
       "minLength": 20,
       "type": "string"
      }
     },
     "required": [
      "handle",
      "wallet",
      "share"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "description": {
    "description": "\u2264204 chars; attribution appended to reach \u2264240 final",
    "maxLength": 204,
    "type": "string"
   },
   "holderKol": {
    "type": "boolean"
   },
   "imageBase64": {
    "minLength": 64,
    "type": "string"
   },
   "imageUrl": {
    "description": "Public image URL (or use imageBase64)",
    "format": "uri",
    "type": "string"
   },
   "initialBuySol": {
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "intent": {
    "description": "launch (default) or wire-fees",
    "enum": [
     "launch",
     "wire-fees"
    ],
    "type": "string"
   },
   "launcherKey": {
    "description": "FORBIDDEN \u2014 rejected if set. Use CREW_LAUNCHER_KEY in MCP env only.",
    "type": "string"
   },
   "launcherPubkey": {
    "description": "Optional public launcher address for balance check (never a secret)",
    "maxLength": 64,
    "minLength": 20,
    "type": "string"
   },
   "mint": {
    "description": "Required when intent=wire-fees",
    "maxLength": 64,
    "minLength": 32,
    "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,64}$",
    "type": "string"
   },
   "mode": {
    "enum": [
     "agent",
     "split",
     "buyback",
     "raid"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 32,
    "minLength": 2,
    "type": "string"
   },
   "platform": {
    "enum": [
     "pumpfun",
     "bags",
     "zora",
     "clanker",
     "vibevibe"
    ],
    "type": "string"
   },
   "privateKey": {
    "description": "FORBIDDEN \u2014 rejected if set.",
    "type": "string"
   },
   "seats": {
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "secretKey": {
    "description": "FORBIDDEN \u2014 rejected if set.",
    "type": "string"
   },
   "ticker": {
    "maxLength": 13,
    "minLength": 2,
    "type": "string"
   },
   "twitter": {
    "maxLength": 128,
    "type": "string"
   },
   "website": {
    "format": "uri",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "crew_launch_dry_run",
 "title": "Dry-run a CREW launch (no chain tx)"
}
