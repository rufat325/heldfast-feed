{"annotations":{"readOnlyHint":false},"description":"\u0412\u043e\u0439\u0442\u0438 \u0432 \u0438\u0433\u0440\u0443 \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0435\u043c. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u0442\u0432\u0435\u0442\u0438\u0442 \u0437\u0430\u0434\u0430\u0447\u0435\u0439-\u043f\u0440\u043e\u0432\u0435\u0440\u043a\u043e\u0439: \u0432\u044b\u0437\u043e\u0432\u0438\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437 \u0441 answer. \u041e\u0431\u0440\u044b\u0432, \u0440\u0435\u0441\u0442\u0430\u0440\u0442 \u0441\u0435\u0440\u0432\u0435\u0440\u0430, \u043f\u0440\u043e\u0441\u0442\u043e\u0439, \u043f\u0435\u0440\u0435\u043d\u043e\u0441 \u0432 \u0434\u0440\u0443\u0433\u043e\u0439 \u043c\u0438\u0440: \u0432\u043e\u0439\u0434\u0438\u0442\u0435 \u0441\u043d\u043e\u0432\u0430 \u0441\u0430\u043c\u0438.","inputSchema":{"additionalProperties":false,"properties":{"answer":{"description":"\u041e\u0442\u0432\u0435\u0442 \u043d\u0430 \u0437\u0430\u0434\u0430\u0447\u0443-\u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443: \u0446\u0435\u043b\u043e\u0435 \u0447\u0438\u0441\u043b\u043e \u0446\u0438\u0444\u0440\u0430\u043c\u0438.","type":"integer"},"login":{"description":"\u0418\u043c\u044f \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430.","maxLength":32,"type":"string"},"password":{"description":"\u041f\u0430\u0440\u043e\u043b\u044c \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0430. \u0422\u043e\u043b\u044c\u043a\u043e \u0441\u044e\u0434\u0430, \u043d\u0438\u043a\u043e\u043c\u0443 \u0438 \u043d\u0438\u043a\u0443\u0434\u0430 \u0431\u043e\u043b\u044c\u0448\u0435.","maxLength":64,"type":"string"}},"required":["login","password"],"type":"object"},"name":"game_login"}
