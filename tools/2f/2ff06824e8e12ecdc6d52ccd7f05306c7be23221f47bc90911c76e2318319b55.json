{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a breaking-news moment snapshot"
 },
 "description": "Fetches the current snapshot of a breaking-news moment by id, including ordered updates and a source summary. Accepts a moment id or a story id; a story id resolves to that story's latest chapter. The result is a point-in-time read, not a stream.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "minLength": 1,
    "type": "string"
   },
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "pl",
     "de",
     "fr"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_live_moment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "moment": {
    "additionalProperties": false,
    "properties": {
     "chapterIndex": {
      "type": "number"
     },
     "decisionAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "endedAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "eventOnsetAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "freshnessBand": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "type": "string"
     },
     "importance": {
      "type": "number"
     },
     "kind": {
      "type": "string"
     },
     "lastBody": {
      "type": "string"
     },
     "lastStateAt": {
      "type": "string"
     },
     "startedAt": {
      "type": "string"
     },
     "status": {
      "enum": [
       "live",
       "ended"
      ],
      "type": "string"
     },
     "storyId": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "kind",
     "status",
     "title",
     "startedAt"
    ],
    "type": "object"
   },
   "sourcesSummary": {
    "additionalProperties": false,
    "properties": {
     "countries": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "totalUrls": {
      "type": "number"
     }
    },
    "required": [
     "totalUrls",
     "countries"
    ],
    "type": "object"
   },
   "states": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "createdAt": {
       "type": "string"
      },
      "importance": {
       "type": "number"
      },
      "kind": {
       "type": "string"
      },
      "pinned": {
       "type": "boolean"
      }
     },
     "required": [
      "kind",
      "importance",
      "body",
      "pinned",
      "createdAt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "moment",
   "states",
   "sourcesSummary"
  ],
  "type": "object"
 },
 "title": "Get a breaking-news moment snapshot"
}
