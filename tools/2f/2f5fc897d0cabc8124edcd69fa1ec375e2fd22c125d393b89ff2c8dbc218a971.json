{
 "description": "Update fields of a listing you own (by slug). You cannot change ownership or set review status. Any edit sends the listing back to admin review (status: pending) and it reappears publicly only after re-approval. Every listing needs a logo: pass logo_url to replace it (required if the listing has none yet). Requires a write-scoped Tulimoa login.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent_interfaces": {
    "items": {
     "enum": [
      "api",
      "cli",
      "sdk",
      "webhooks"
     ],
     "type": "string"
    },
    "maxItems": 4,
    "type": "array"
   },
   "ai_usage": {
    "description": "40 to 600 characters, ideally in English: how the software uses AI, or what agents can do with it. Be concrete, not salesy. Submissions without a clear AI or agent angle are rejected.",
    "maxLength": 600,
    "minLength": 40,
    "type": "string"
   },
   "category": {
    "enum": [
     "developer-tools",
     "ai-infra",
     "sales-crm",
     "marketing",
     "productivity",
     "data-analytics",
     "finance-accounting",
     "customer-support",
     "hr-recruiting",
     "design-creative",
     "security-privacy",
     "communication",
     "commerce-payments",
     "automation-nocode",
     "other"
    ],
    "type": "string"
   },
   "certifications": {
    "items": {
     "enum": [
      "soc2",
      "iso27001",
      "hipaa"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "data_region": {
    "description": "Where customer data is hosted: eu (in the EU by default), eu-option (an EU region can be selected), non-eu, self-hosted (runs at the customer). Listings with EU hosting also appear on tulimoa.com/mcp-eu.",
    "enum": [
     "eu",
     "eu-option",
     "non-eu",
     "self-hosted"
    ],
    "type": "string"
   },
   "founder_x_handles": {
    "items": {
     "maxLength": 40,
     "type": "string"
    },
    "maxItems": 4,
    "type": "array"
   },
   "gdpr_dpa": {
    "type": "boolean"
   },
   "hosting_provider": {
    "maxLength": 60,
    "type": "string"
   },
   "launch_hook": {
    "maxLength": 140,
    "type": "string"
   },
   "logo_url": {
    "description": "New logo. Public https URL of the company logo: PNG, JPEG, WebP, GIF or AVIF, at least 64 px, max 5 MB. A square icon works best. Tulimoa downloads it, scales it to max 512 px and stores it as WebP. Required if the listing has no logo yet.",
    "format": "uri",
    "type": "string"
   },
   "mcp": {
    "type": "boolean"
   },
   "mcp_auth": {
    "items": {
     "enum": [
      "oauth",
      "api"
     ],
     "type": "string"
    },
    "maxItems": 2,
    "type": "array"
   },
   "mcp_docs_url": {
    "format": "uri",
    "type": "string"
   },
   "mcp_server_url": {
    "format": "uri",
    "type": "string"
   },
   "model_source": {
    "enum": [
     "own",
     "open-weight",
     "provider",
     "mixed",
     "none"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "pricing_detail": {
    "maxLength": 400,
    "type": "string"
   },
   "pricing_model": {
    "enum": [
     "free",
     "freemium",
     "paid",
     "lifetime"
    ],
    "type": "string"
   },
   "short_description": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "description": "Slug of YOUR listing to edit (from submit_listing).",
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "trains_on_customer_data": {
    "enum": [
     "no",
     "opt-out",
     "yes"
    ],
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   },
   "x_handle": {
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "edit_listing",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Listing id.",
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "status": {
    "const": "pending",
    "type": "string"
   }
  },
  "required": [
   "id",
   "slug",
   "status"
  ],
  "type": "object"
 },
 "title": "Edit one of your own Tulimoa listings"
}
