{
 "description": "Create a new n8n workflow. Provide the full workflow JSON including nodes and connections.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activate": {
    "default": false,
    "description": "Activate workflow after creation",
    "type": "boolean"
   },
   "connections": {
    "description": "Array of connections between nodes",
    "items": {
     "additionalProperties": false,
     "properties": {
      "from_node": {
       "description": "Source node name",
       "type": "string"
      },
      "from_output": {
       "default": 0,
       "description": "Source output index (integer 0-1000)",
       "maximum": 1000,
       "minimum": 0,
       "type": "integer"
      },
      "to_input": {
       "$ref": "#/properties/connections/items/properties/from_output",
       "default": 0,
       "description": "Target input index (integer 0-1000)"
      },
      "to_node": {
       "description": "Target node name",
       "type": "string"
      }
     },
     "required": [
      "from_node",
      "to_node"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Workflow name",
    "type": "string"
   },
   "nodes": {
    "description": "Array of workflow nodes",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Node display name",
       "type": "string"
      },
      "parameters": {
       "additionalProperties": {},
       "description": "Node parameters",
       "type": "object"
      },
      "position": {
       "description": "[x, y] position",
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "type": {
       "description": "n8n node type, e.g. 'n8n-nodes-base.webhook'",
       "type": "string"
      }
     },
     "required": [
      "type",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "server_name": {
    "description": "Server name. Uses default if omitted.",
    "type": "string"
   }
  },
  "required": [
   "name",
   "nodes"
  ],
  "type": "object"
 },
 "name": "n8n_create_workflow"
}
