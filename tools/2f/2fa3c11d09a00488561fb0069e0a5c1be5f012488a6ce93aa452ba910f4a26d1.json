{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Create Cost"
 },
 "description": "Create an expense record, optionally attributed to an order. Returns {success, id}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "comment": {
    "description": "Free-text comment",
    "type": "string"
   },
   "cost_item": {
    "description": "Cost item code (expense category)",
    "type": "string"
   },
   "date_from": {
    "description": "Cost period start (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_to": {
    "description": "Cost period end (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "order_id": {
    "description": "Attribute the cost to an order RetailCRM ID",
    "type": "integer"
   },
   "site": {
    "description": "Site (store) symbolic code. Required on create/edit when the API key is scoped to multiple sites (see list_sites).",
    "type": "string"
   },
   "summ": {
    "description": "Cost amount",
    "type": "number"
   }
  },
  "required": [
   "summ",
   "cost_item",
   "date_from"
  ],
  "type": "object"
 },
 "name": "create_cost"
}
