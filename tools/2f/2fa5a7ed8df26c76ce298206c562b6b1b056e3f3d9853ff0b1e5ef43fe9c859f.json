{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get the full details of one match: what the other person wrote, why the two of them matched, something to open with, and where the match stands. It only reads. To accept, decline or block the match, call respond_to_match. Never promise an address.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "match_id": {
    "description": "The match_id from check_matches.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "match_id"
  ],
  "type": "object"
 },
 "name": "get_match_details",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "icebreaker": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Something to open with."
   },
   "introduced_at": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "match_id": {
    "type": "string"
   },
   "state": {
    "type": "string"
   },
   "their_name": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "their_request_text": {
    "type": "string"
   },
   "they_accepted": {
    "type": "boolean"
   },
   "why_you_matched": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "you_accepted": {
    "type": "boolean"
   }
  },
  "required": [
   "match_id",
   "state",
   "their_request_text",
   "why_you_matched",
   "icebreaker",
   "you_accepted",
   "they_accepted"
  ],
  "type": "object"
 },
 "title": "Get match details"
}
