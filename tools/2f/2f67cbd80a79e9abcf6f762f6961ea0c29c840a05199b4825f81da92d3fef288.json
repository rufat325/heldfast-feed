{
 "description": "List rows from a data table with optional filter, search, sorting and pagination. Filter is a JSON string with {type, filters} structure.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Pagination cursor",
    "type": "string"
   },
   "dataTableId": {
    "description": "Data table ID",
    "type": "string"
   },
   "filter": {
    "description": "JSON filter, e.g. {\"type\":\"and\",\"filters\":[{\"columnName\":\"status\",\"condition\":\"eq\",\"value\":\"active\"}]}",
    "type": "string"
   },
   "limit": {
    "description": "Max rows (default 50)",
    "maximum": 250,
    "minimum": 1,
    "type": "number"
   },
   "search": {
    "description": "Full-text search on string columns",
    "type": "string"
   },
   "sortBy": {
    "description": "columnName:asc or columnName:desc",
    "type": "string"
   }
  },
  "required": [
   "dataTableId"
  ],
  "type": "object"
 },
 "name": "n8n_get_datatable_rows",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "data": {
    "items": {},
    "type": "array"
   },
   "nextCursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "title": "Query data table rows"
}
