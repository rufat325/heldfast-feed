{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Region reserved snapshot"
 },
 "description": "Paid (0.10 USDC per call). Current reserved effective hourly price of every instance type and ri_type in a region (AWS or Azure).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "provider": {
    "description": "Provider: `aws` (default), `azure` or `gcp`.",
    "enum": [
     "aws",
     "azure",
     "gcp"
    ],
    "type": "string"
   },
   "region": {
    "description": "Region slug (for example `us-east-1`, `us-east` for Azure, `us-central1` for GCP). Example: us-east-1",
    "type": "string"
   }
  },
  "required": [
   "region"
  ],
  "type": "object"
 },
 "name": "reserved_snapshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "count": {
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "prices": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "instance": {
       "type": "string"
      },
      "price": {
       "type": "number"
      },
      "ri_type": {
       "type": "string"
      },
      "since": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "provider": {
    "type": "string"
   },
   "region": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Region reserved snapshot"
}
