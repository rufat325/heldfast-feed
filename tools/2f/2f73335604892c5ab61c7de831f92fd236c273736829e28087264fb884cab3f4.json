{
 "annotations": {
  "destructiveHint": true,
  "title": "Update an event"
 },
 "description": "Update an event's name, description, timezone, location, keywords or classification, and add or reschedule dates (date operations CREATE and UPDATE; deleting dates is not exposed). Only fields you pass are sent. Requires a special permission Humanitix activates on your account (403 otherwise). Humanitix: PATCH /v1/events/{eventId}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "classification": {
    "description": "How the event is classified. subcategory must belong to category.",
    "properties": {
     "category": {
      "description": "Event category, e.g. music.",
      "enum": [
       "autoBoatAndAir",
       "businessAndProfessional",
       "charityAndCauses",
       "communityAndCulture",
       "familyAndEducation",
       "fashionAndBeauty",
       "filmMediaAndEntertainment",
       "foodAndDrink",
       "governmentAndPolitics",
       "healthAndWellness",
       "hobbiesAndSpecialInterest",
       "homeAndLifestyle",
       "music",
       "performingAndVisualArts",
       "religionAndSpirituality",
       "schoolActivities",
       "scienceAndTechnology",
       "seasonalAndHoliday",
       "sportsAndFitness",
       "travelAndOutdoor",
       "other"
      ],
      "type": "string"
     },
     "subcategory": {
      "description": "Subcategory within the category (e.g. jazz for music). Requires category.",
      "type": "string"
     },
     "type": {
      "description": "Event type, e.g. concertOrPerformance.",
      "enum": [
       "appearanceOrSigning",
       "attraction",
       "campTripOrRetreat",
       "classTrainingOrWorkshop",
       "concertOrPerformance",
       "conference",
       "convention",
       "dinnerOrGala",
       "festivalOrFair",
       "gameOrCompetition",
       "meetingOrNetworkingEvent",
       "partyOrSocialGathering",
       "raceOrEnduranceEvent",
       "rally",
       "screening",
       "seminarOrTalk",
       "tour",
       "tournament",
       "tradeShowConsumerShowOrExpo",
       "other"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "dates": {
    "description": "Date operations: CREATE a new date range, or UPDATE an existing one by its _id.",
    "items": {
     "oneOf": [
      {
       "properties": {
        "endDate": {
         "description": "End as an ISO 8601 date-time, e.g. 2026-11-01T09:00:00.000Z.",
         "minLength": 1,
         "type": "string"
        },
        "operation": {
         "const": "CREATE",
         "type": "string"
        },
        "startDate": {
         "description": "Start as an ISO 8601 date-time, e.g. 2026-11-01T09:00:00.000Z.",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "operation",
        "startDate",
        "endDate"
       ],
       "type": "object"
      },
      {
       "properties": {
        "_id": {
         "description": "The date range id (the _id inside the event's dates) (24-character hex id).",
         "pattern": "^[0-9a-fA-F]{24}$",
         "type": "string"
        },
        "endDate": {
         "description": "New end as an ISO 8601 date-time, e.g. 2026-11-01T09:00:00.000Z.",
         "minLength": 1,
         "type": "string"
        },
        "operation": {
         "const": "UPDATE",
         "type": "string"
        },
        "startDate": {
         "description": "New start as an ISO 8601 date-time, e.g. 2026-11-01T09:00:00.000Z.",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "operation",
        "_id",
        "startDate",
        "endDate"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 700,
    "minItems": 1,
    "type": "array"
   },
   "description": {
    "description": "New description.",
    "type": "string"
   },
   "event_id": {
    "description": "The event id (24-character hex id).",
    "pattern": "^[0-9a-fA-F]{24}$",
    "type": "string"
   },
   "event_location": {
    "description": "Where the event happens: online, address (geocoded), custom (free text) or toBeAnnounced.",
    "oneOf": [
     {
      "properties": {
       "instructions": {
        "description": "Joining instructions.",
        "type": "string"
       },
       "onlineUrl": {
        "description": "Link attendees join at.",
        "type": "string"
       },
       "type": {
        "const": "online",
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     },
     {
      "properties": {
       "address": {
        "description": "Full street address.",
        "type": "string"
       },
       "latLng": {
        "description": "[latitude, longitude].",
        "items": {
         "type": "number"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
       },
       "placeId": {
        "description": "Google Places place_id.",
        "type": "string"
       },
       "type": {
        "const": "address",
        "type": "string"
       },
       "venueName": {
        "description": "Venue name (may be empty).",
        "type": "string"
       }
      },
      "required": [
       "type",
       "address",
       "venueName",
       "latLng"
      ],
      "type": "object"
     },
     {
      "properties": {
       "address": {
        "description": "Free-text address.",
        "minLength": 1,
        "type": "string"
       },
       "type": {
        "const": "custom",
        "type": "string"
       },
       "venueName": {
        "description": "Venue name.",
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "type",
       "address",
       "venueName"
      ],
      "type": "object"
     },
     {
      "properties": {
       "type": {
        "const": "toBeAnnounced",
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     }
    ]
   },
   "keywords": {
    "description": "Up to 10 unique search keywords, each 1-25 characters.",
    "items": {
     "maxLength": 25,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "name": {
    "description": "New event name.",
    "minLength": 1,
    "type": "string"
   },
   "override_location": {
    "description": "Query a region other than your account's own (ISO 3166-1 alpha-2). Humanitix stores data per region.",
    "enum": [
     "AU",
     "NZ",
     "US",
     "FJ",
     "CA",
     "GB",
     "SG",
     "DE",
     "MY",
     "MX"
    ],
    "type": "string"
   },
   "timezone": {
    "description": "New IANA timezone.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "event_id"
  ],
  "type": "object"
 },
 "name": "humanitix_update_event",
 "title": "Update an event"
}
