{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List evidence artifacts and SHA-256 hashes for a secured human job. Download paths require the same job token.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "job_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "job_token": {
    "minLength": 16,
    "type": "string"
   }
  },
  "required": [
   "job_id",
   "job_token"
  ],
  "type": "object"
 },
 "name": "human_list_evidence",
 "title": "List private evidence artifacts"
}
