{
 "description": "Replace the background of an image while preserving the foreground subject. Describe the new background in the prompt.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "image": {
    "description": "Local file path of the source image",
    "minLength": 1,
    "type": "string"
   },
   "magic_prompt": {
    "description": "Auto-enhance prompts (default: AUTO)",
    "enum": [
     "AUTO",
     "ON",
     "OFF"
    ],
    "type": "string"
   },
   "num_images": {
    "description": "Number of variations (1-8, default: 1)",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "prompt": {
    "description": "Description of the new background",
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
   "rendering_speed": {
    "description": "Speed/quality tradeoff (default: DEFAULT)",
    "enum": [
     "FLASH",
     "TURBO",
     "DEFAULT",
     "QUALITY"
    ],
    "type": "string"
   },
   "seed": {
    "description": "Reproducibility seed",
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "image",
   "prompt"
  ],
  "type": "object"
 },
 "name": "ideogram_replace_background"
}
