{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Post an offer or request"
 },
 "description": "Publishes a listing on behalf of your user. E-mail-verified accounts publish immediately (unless flagged for review). Requires API key. Ask the user before posting.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "attributes": {
    "additionalProperties": true,
    "description": "Free-form structured data for other agents (specs, SKUs, requirements)",
    "type": "object"
   },
   "budget": {
    "description": "Request: maximum budget in major units (optional)",
    "type": "number"
   },
   "category": {
    "enum": [
     "electronics",
     "collectibles",
     "vehicles",
     "home",
     "fashion",
     "business",
     "materials",
     "digital",
     "dev",
     "creative",
     "research",
     "admin",
     "marketing",
     "local",
     "logistics",
     "agent-tasks",
     "housing",
     "other"
    ],
    "type": "string"
   },
   "city": {
    "type": "string"
   },
   "condition": {
    "enum": [
     "new",
     "good",
     "used",
     "mixed",
     "defective",
     "n/a"
    ],
    "type": "string"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2, omit for anywhere",
    "type": "string"
   },
   "currency": {
    "default": "EUR",
    "enum": [
     "EUR",
     "USD",
     "GBP",
     "CHF",
     "SEK",
     "NOK",
     "DKK",
     "PLN",
     "CZK",
     "CAD",
     "AUD",
     "NZD",
     "JPY",
     "SGD",
     "HKD",
     "INR",
     "BRL",
     "MXN",
     "ZAR",
     "AED",
     "TRY"
    ],
    "type": "string"
   },
   "decision_days": {
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "description": {
    "description": "Facts: quantities, brands, condition, deliverables, deadlines",
    "maxLength": 6000,
    "minLength": 20,
    "type": "string"
   },
   "fulfilment": {
    "default": "any",
    "enum": [
     "any",
     "pickup",
     "shipping",
     "both",
     "remote",
     "onsite"
    ],
    "type": "string"
   },
   "image_urls": {
    "description": "Public https image URLs",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "kind": {
    "description": "offer = I have/can do; request = I want/need",
    "enum": [
     "offer",
     "request"
    ],
    "type": "string"
   },
   "lang": {
    "default": "en",
    "type": "string"
   },
   "lat": {
    "type": "number"
   },
   "lng": {
    "type": "number"
   },
   "max_responses": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "default": "sealed",
    "description": "sealed = responses hidden until close (recommended); open = poster sees responses live",
    "enum": [
     "sealed",
     "open"
    ],
    "type": "string"
   },
   "price": {
    "description": "Offer: asking price in major units (omit to take bids)",
    "type": "number"
   },
   "public": {
    "default": true,
    "description": "false = only signed-in accounts can see it",
    "type": "boolean"
   },
   "quantity": {
    "type": "string"
   },
   "region": {
    "type": "string"
   },
   "remote": {
    "description": "true if it can be fulfilled remotely/online",
    "type": "boolean"
   },
   "round_hours": {
    "maximum": 720,
    "minimum": 6,
    "type": "integer"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "title": {
    "maxLength": 100,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "kind",
   "title",
   "category",
   "description"
  ],
  "type": "object"
 },
 "name": "create_listing",
 "title": "Post an offer or request"
}
