{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:ads"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Adjust uploaded conversions"
 },
 "description": "Adjust uploaded conversions. Spending/deletion: preview, then owner-approved confirm:true with the same requestId. Other edits: one call. Creates request active; report returned status and claim live only when active. Full field guide: soclo://tools/soclo_ads_adjust_conversions.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "type": "object"
   },
   "payload": {
    "properties": {
     "adjustments": {
      "items": {
       "properties": {
        "adjustmentTime": {
         "description": "When the adjustment occurred, unix seconds.",
         "type": "number"
        },
        "adjustmentType": {
         "enum": [
          "RETRACTION",
          "RESTATEMENT",
          "ENHANCEMENT"
         ],
         "type": "string"
        },
        "conversionTime": {
         "type": "number"
        },
        "currency": {
         "description": "RESTATEMENT only. ISO 4217 currency for `restatementValue`.",
         "type": "string"
        },
        "gclid": {
         "type": "string"
        },
        "orderId": {
         "type": "string"
        },
        "restatementValue": {
         "description": "RESTATEMENT only. The corrected TOTAL conversion value.",
         "type": "number"
        },
        "user": {
         "properties": {
          "email": {
           "type": "string"
          },
          "phone": {
           "type": "string"
          }
         },
         "type": "object"
        },
        "userAgent": {
         "type": "string"
        }
       },
       "required": [
        "adjustmentType",
        "adjustmentTime"
       ],
       "type": "object"
      },
      "maxItems": 2000,
      "minItems": 1,
      "type": "array"
     },
     "destinationId": {
      "type": "string"
     }
    },
    "required": [
     "destinationId",
     "adjustments"
    ],
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "payload"
  ],
  "type": "object"
 },
 "name": "soclo_ads_adjust_conversions",
 "title": "Adjust uploaded conversions"
}
