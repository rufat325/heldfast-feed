{
 "description": "Create a billing plan in Vindi",
 "inputSchema": {
  "properties": {
   "billing_trigger_type": {
    "description": "When to bill",
    "enum": [
     "beginning_of_period",
     "end_of_period"
    ],
    "type": "string"
   },
   "interval": {
    "description": "Billing interval unit",
    "enum": [
     "days",
     "months"
    ],
    "type": "string"
   },
   "interval_count": {
    "description": "Number of intervals between billings",
    "type": "number"
   },
   "name": {
    "description": "Plan name",
    "type": "string"
   },
   "plan_items": {
    "description": "Plan items with product_id and cycles",
    "items": {
     "properties": {
      "cycles": {
       "type": "number"
      },
      "product_id": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "interval",
   "interval_count"
  ],
  "type": "object"
 },
 "name": "create_plan"
}
