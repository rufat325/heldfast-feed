{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Investigate a specific endpoint or operation in one service/log source and explicit time window. Match route or query, then correlate sampled request/trace IDs. Live infrastructure anomalies are only temporally related, not proof of causation. When history is configured, appends a local archive without changing connected infrastructure.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "from": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "logLimit": {
    "default": 500,
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "method": {
    "enum": [
     "GET",
     "POST",
     "PUT",
     "PATCH",
     "DELETE",
     "HEAD",
     "OPTIONS",
     "CONNECT",
     "TRACE"
    ],
    "type": "string"
   },
   "projectId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "question": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "route": {
    "format": "starts_with",
    "maxLength": 1000,
    "pattern": "^\\/.*",
    "type": "string"
   },
   "serviceId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "sourceId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "to": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "sourceId",
   "serviceId",
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "investigate_operation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "ok",
     "error"
    ],
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 }
}
