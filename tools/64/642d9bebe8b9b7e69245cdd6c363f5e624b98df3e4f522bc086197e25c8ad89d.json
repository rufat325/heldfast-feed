{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Map a natural-language symptom (e.g. 'my app is slow', 'hardcoded password', 'infinite react loop') to the relevant Code Auditor rule(s) and their fixes. Call this when a user describes a problem rather than naming a rule.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "symptom": {
    "description": "A plain-language description of the problem.",
    "type": "string"
   }
  },
  "required": [
   "symptom"
  ],
  "type": "object"
 },
 "name": "explain_symptom",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "hint": {
    "type": "string"
   },
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "config": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "method": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "critical",
        "severe",
        "high"
       ],
       "type": "string"
      },
      "threshold": {
       "type": "string"
      }
     },
     "required": [
      "rule",
      "category",
      "severity",
      "description",
      "method"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "matches"
  ],
  "type": "object"
 },
 "title": "Explain Symptom"
}
