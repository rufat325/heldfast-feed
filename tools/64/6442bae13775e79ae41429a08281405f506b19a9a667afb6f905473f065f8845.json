{
 "description": "Update an invoice. QBO uses sparse update: pass Id, SyncToken, sparse=true, plus any fields to change.",
 "inputSchema": {
  "properties": {
   "BillEmail": {
    "properties": {
     "Address": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "CustomerMemo": {
    "properties": {
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "DueDate": {
    "description": "Due date (YYYY-MM-DD)",
    "type": "string"
   },
   "Id": {
    "description": "Invoice.Id",
    "type": "string"
   },
   "Line": {
    "description": "Full Line array replaces existing lines (even with sparse=true for Line).",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "PrivateNote": {
    "type": "string"
   },
   "SyncToken": {
    "description": "Current SyncToken from the invoice record",
    "type": "string"
   },
   "TxnDate": {
    "description": "Transaction date (YYYY-MM-DD)",
    "type": "string"
   },
   "sparse": {
    "description": "Set true to sparse-update (recommended)",
    "type": "boolean"
   }
  },
  "required": [
   "Id",
   "SyncToken"
  ],
  "type": "object"
 },
 "name": "update_invoice"
}
