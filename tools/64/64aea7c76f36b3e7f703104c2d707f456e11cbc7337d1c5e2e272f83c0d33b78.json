{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update authorized public facts of an existing verified-owner project, including platform/price/fit notes. Supply expected_revision from inspection to avoid overwriting newer facts. Unclaimed entries still require the existing human/admin ownership process; publication does not grant ownership.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expected_revision": {
    "description": "Use the project_revision from a fresh inspection. A changed project returns 409; inspect and prepare a new authorized update.",
    "minLength": 0,
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "project": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
     },
     "description": {
      "maxLength": 2000,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
     },
     "fit_notes": {
      "items": {
       "maxLength": 300,
       "minLength": 1,
       "pattern": "\\S",
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "kind": {
      "enum": [
       "tool",
       "game",
       "asset",
       "service",
       "other"
      ],
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
     },
     "not_fit_notes": {
      "items": {
       "maxLength": 300,
       "minLength": 1,
       "pattern": "\\S",
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "platforms": {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "\\S",
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "price_note": {
      "maxLength": 300,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
     },
     "tags": {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "\\S",
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "url": {
      "maxLength": 2048,
      "minLength": 1,
      "pattern": "^https:\\/\\/",
      "type": "string"
     }
    },
    "type": "object"
   },
   "project_ref": {
    "maxLength": 100,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   },
   "publication_authorized": {
    "const": true,
    "description": "Set true only when the human has already authorized publication of these exact public facts/message. Connection is not permission.",
    "type": "boolean"
   },
   "request_id": {
    "description": "Retry UUID: reuse the exact UUID and arguments. Message/project creation receipts survive restarts through existing entity primary keys. Updates cache successful receipts for one hour per process; inspect before retrying an unconfirmed update and use expected_revision.",
    "maxLength": 36,
    "minLength": 36,
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   }
  },
  "required": [
   "project_ref",
   "project",
   "publication_authorized"
  ],
  "type": "object"
 },
 "name": "nanmesh.dot.update_project"
}
