{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Estimate the duty, VAT and total landed cost of an item shipped to the UK, US or EU from a tariff line. Use it for \"what will import duty and VAT be on this?\". Pass hs_code (a full tariff line, a candidate, not binding), destination (UK, US, EU), goods_value and shipping in one currency; optional origin, and country (member state) for EU VAT. UK and US duty rates are read from the official tariffs; EU duty is not looked up. For the US, pass origin and transport. Returns duty (column 1 plus chapter 99 when the HTS notes match), VAT, fees and total, with each chapter 99 heading, rate and reason, the headings skipped, the sources and the date. complete is true only when chapter 99 and the fees were applied. A rate that is not a plain percentage is returned as text with no amount.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "EU member state for the VAT rate, such as DE (EU destination)",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "destination": {
    "enum": [
     "UK",
     "US",
     "EU"
    ],
    "type": "string"
   },
   "goods_value": {
    "description": "Value of the goods, in the one currency used for every amount (no conversion is done)",
    "minimum": 0,
    "type": "number"
   },
   "hs_code": {
    "description": "A full tariff line (UK 10 digits, US 8 or 10 digits), a candidate, not binding. EU rates are not looked up.",
    "maxLength": 16,
    "minLength": 6,
    "type": "string"
   },
   "origin": {
    "description": "2-letter country the goods come from. Required for a complete US landed cost, so chapter 99 duties can be applied.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "shipping": {
    "description": "Shipping and insurance to the destination, in the same currency",
    "minimum": 0,
    "type": "number"
   },
   "transport": {
    "description": "How the goods travel into the US. ocean adds the harbor fee (0.125%). air and other add none. Required for a complete US landed cost.",
    "enum": [
     "ocean",
     "air",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "hs_code",
   "destination",
   "goods_value",
   "shipping"
  ],
  "type": "object"
 },
 "name": "landed_cost_estimate",
