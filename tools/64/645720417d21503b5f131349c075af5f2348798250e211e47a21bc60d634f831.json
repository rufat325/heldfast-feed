      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "heading",
      "reason",
      "applied"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "complete": {
    "type": "boolean"
   },
   "destination": {
    "type": "string"
   },
   "duty": {
