             "type": "string"
            },
            "name": {
             "type": "string"
            },
            "type": {
             "type": "string"
            }
           },
           "required": [
            "id",
            "type",
            "name"
           ],
           "type": "object"
          }
         ]
        },
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "from": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "type": {
          "type": "string"
         }
        },
        "required": [
