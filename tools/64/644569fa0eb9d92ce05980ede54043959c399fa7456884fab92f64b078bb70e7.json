{
 "description": "List published CanonicAI answer summaries from the static Answers corpus. Returns slug, id, question, canonical URLs, and citation counts.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum summaries to return.",
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "description": "Number of summaries to skip.",
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_answers",
 "outputSchema": {
  "properties": {
   "answers": {
    "items": {
     "properties": {
      "citationCount": {
       "type": "integer"
      },
      "id": {
       "type": "string"
      },
      "jsonUrl": {
       "format": "uri",
       "type": "string"
      },
      "question": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "slug",
      "id",
      "question",
      "url",
      "jsonUrl",
      "citationCount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "type": "integer"
   }
  },
  "required": [
   "count",
   "answers"
  ],
  "type": "object"
 }
}
