{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Purchase Token Pack"
 },
 "description": "Create a Stripe Checkout session for a Pulse token pack. Returns payment_url \u2014 DO NOT submit it programmatically; surface it to the user so they can complete payment in their browser. Once paid, banked tokens are credited automatically. Requires PULSE_API_KEY.",
 "inputSchema": {
  "properties": {
   "pack": {
    "description": "Token pack tier",
    "enum": [
     "1K",
     "10K",
     "50K",
     "200K"
    ],
    "type": "string"
   }
  },
  "required": [
   "pack"
  ],
  "type": "object"
 },
 "name": "purchase_token_pack",
 "outputSchema": {
  "additionalProperties": true,
  "anyOf": [
   {
    "required": [
     "purchase_id",
     "pack",
     "tokens",
     "amount_usd",
     "currency",
     "payment_url",
     "expires_at"
    ]
   },
   {
    "required": [
     "error",
     "message"
    ]
   }
  ],
  "properties": {
   "amount_usd": {
    "description": "Pack price in USD.",
    "type": "number"
   },
   "currency": {
    "description": "Checkout currency.",
    "type": "string"
   },
   "details": {
    "additionalProperties": true,
    "description": "Additional structured context from Pulse.",
    "type": "object"
   },
   "error": {
    "description": "Machine-readable error code.",
    "type": "string"
   },
   "expires_at": {
    "description": "ISO timestamp when the Checkout link expires.",
    "type": "string"
   },
   "message": {
    "description": "Human-readable recovery guidance.",
    "type": "string"
   },
   "pack": {
    "description": "Token-pack tier label.",
    "type": "string"
   },
   "payment_url": {
    "description": "Stripe Checkout URL to present to the user.",
    "type": "string"
   },
   "purchase_id": {
    "description": "Pulse token-pack purchase id.",
    "type": "string"
   },
   "retryable": {
    "description": "Whether the caller may retry after changing state or waiting.",
    "type": "boolean"
   },
   "tokens": {
    "description": "Tokens included in the pack.",
    "type": "number"
   }
  },
  "required": [],
  "type": "object"
 }
