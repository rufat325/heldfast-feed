{
 "description": "Search and filter opportunities across pipelines. Supports filtering by pipeline, stage, contact, status, assigned user, campaign, date range, and free-text query. Can optionally include calendar events, notes, and tasks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "assignedTo": {
    "description": "Filter by assigned user ID",
    "type": "string"
   },
   "campaignId": {
    "description": "Filter by campaign ID",
    "type": "string"
   },
   "contactId": {
    "description": "Filter by contact ID",
    "type": "string"
   },
   "endDate": {
    "description": "End date for date range filter (YYYY-MM-DD)",
    "type": "string"
   },
   "getCalendarEvents": {
    "description": "Include calendar events in response",
    "type": "boolean"
   },
   "getNotes": {
    "description": "Include notes in response",
    "type": "boolean"
   },
   "getTasks": {
    "description": "Include tasks in response",
    "type": "boolean"
   },
   "limit": {
    "description": "Max results to return (default 20)",
    "type": "number"
   },
   "locationId": {
    "description": "Location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "order": {
    "description": "Sort order (asc or desc)",
    "type": "string"
   },
   "page": {
    "description": "Page number for pagination",
    "type": "number"
   },
   "pipelineId": {
    "description": "Filter by pipeline ID",
    "type": "string"
   },
   "pipelineStageId": {
    "description": "Filter by pipeline stage ID",
    "type": "string"
   },
   "q": {
    "description": "Free-text search query",
    "type": "string"
   },
   "sortBy": {
    "description": "Field to sort by",
    "type": "string"
   },
   "startDate": {
    "description": "Start date for date range filter (YYYY-MM-DD)",
    "type": "string"
   },
   "status": {
    "description": "Filter by status (open, won, lost, abandoned, all)",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId"
  ],
  "type": "object"
 },
 "name": "crm_search_opportunities"
}
