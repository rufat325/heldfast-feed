{
 "description": "Get full details of a specific BullMQ job \u2014 payload, status, timestamps, error info",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "job_id": {
    "description": "Job ID to inspect",
    "type": "string"
   },
   "queue": {
    "description": "BullMQ queue name",
    "type": "string"
   },
   "redis_url": {
    "default": "redis://localhost:6379",
    "description": "Redis connection URL",
    "type": "string"
   }
  },
  "required": [
   "queue",
   "job_id"
  ],
  "type": "object"
 },
 "name": "bullmq_job_details"
}
