{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Upload a validated static PNG to the signed-in VRChat account gallery. This does not attach the image to a group post or event.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "imagePath": {
    "description": "Absolute path to a static PNG inside uploads.allowedRoots. The image must be 65-2048 pixels per side and no larger than 10 MiB.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "imagePath"
  ],
  "type": "object"
 },
 "name": "vrchat_gallery_image_upload",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "extension": {
    "type": "string"
   },
   "fileId": {
    "type": "string"
   },
   "image": {
    "additionalProperties": false,
    "properties": {
     "byteSize": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "fileName": {
      "type": "string"
     },
     "height": {
      "maximum": 2048,
      "minimum": 65,
      "type": "integer"
     },
     "width": {
      "maximum": 2048,
      "minimum": 65,
      "type": "integer"
     }
    },
    "required": [
     "fileName",
     "byteSize",
     "width",
     "height"
    ],
    "type": "object"
   },
   "mimeType": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "ownerId": {
    "type": "string"
   },
   "version": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "fileId",
   "image"
  ],
  "type": "object"
 }
}
