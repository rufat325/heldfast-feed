{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Tax filing deadlines"
 },
 "description": "Filing and payment deadlines for a country or US state: 'when is my tax return due', 'when do I file VAT', 'when is the next instalment'. Returns upcoming dates and recurring filing rhythms (monthly VAT, quarterly instalments) from the OpenAccountants tax calendar. Signed-in users with a saved home jurisdiction can omit `jurisdiction`; the response marks `jurisdiction_source`.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "512x512"
   ],
   "src": "https://www.openaccountants.com/logo-circle.png"
  }
 ],
 "inputSchema": {
  "properties": {
   "horizon_days": {
    "description": "How far ahead to look (default 120, max 366).",
    "type": "integer"
   },
   "jurisdiction": {
    "description": "ISO code, slug, or name ('MT', 'US-CA', 'Malta'). Optional for signed-in users with a saved home jurisdiction.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_deadlines",
 "outputSchema": {
  "properties": {
   "calendar_url": {
    "type": "string"
   },
   "horizon_days": {
    "type": "integer"
   },
   "jurisdiction": {
    "type": "string"
   },
   "jurisdiction_source": {
    "type": "string"
   },
   "next_action": {
    "type": "string"
   },
   "recurring_rhythms": {
    "items": {
     "properties": {
      "frequency": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "upcoming_deadlines": {
    "items": {
     "properties": {
      "date": {
       "type": "string"
      },
      "date_display": {
       "type": "string"
      },
      "days_away": {
       "type": "integer"
      },
      "personas": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "jurisdiction",
   "upcoming_deadlines"
  ],
  "type": "object"
 },
 "title": "Tax filing deadlines"
}
