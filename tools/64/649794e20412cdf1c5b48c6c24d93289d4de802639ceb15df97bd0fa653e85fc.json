{
 "description": "Paid Untrusted Content Security Layer ($0.005 USDC on Base). Scan untrusted text, HTML, Markdown, email, document text, API responses, and tool outputs before your agent adds them to context, follows their instructions, or acts. Returns risk score, risk categories, recommendation, and sanitized plain text when possible. Bounded deterministic local scanning; no external LLM or provider call. Maximum 100000 characters.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "content": {
    "minLength": 1,
    "type": "string"
   },
   "content_type": {
    "enum": [
     "text",
     "html",
     "markdown",
     "email",
     "tool_output",
     "api_response",
     "document_text"
    ],
    "type": "string"
   },
   "source": {
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "content"
  ],
  "type": "object"
 },
 "name": "scan_content",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cached": {
    "type": "boolean"
   },
   "credential_theft_risk": {
    "type": "boolean"
   },
   "data_exfiltration_risk": {
    "type": "boolean"
   },
   "degraded": {
    "type": "boolean"
   },
   "detected_patterns": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "severity": {
       "enum": [
        "low",
        "medium",
        "high",
        "critical"
       ],
       "type": "string"
      },
      "type": {
       "enum": [
        "instruction_override",
        "system_prompt_extraction",
        "credential_request",
        "secret_exfiltration",
        "tool_manipulation",
        "external_data_exfiltration",
        "unsafe_navigation_instruction",
        "privilege_escalation",
        "hidden_instruction",
        "encoded_instruction",
        "role_impersonation",
        "memory_manipulation",
        "security_bypass",
        "suspicious_action_request"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "severity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "instruction_override_risk": {
    "type": "boolean"
   },
   "prompt_injection_detected": {
    "type": "boolean"
   },
   "recommendation": {
    "enum": [
     "allow",
     "caution",
     "sanitize",
     "block"
    ],
    "type": "string"
   },
   "requested_actions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "risk_level": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "risk_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "safe": {
    "type": "boolean"
   },
   "sanitized_content": {
    "type": "string"
   },
   "scanned_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "sources": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tool_manipulation_risk": {
    "type": "boolean"
   }
  },
  "required": [
   "safe",
   "risk_score",
   "risk_level",
   "recommendation",
   "prompt_injection_detected",
   "data_exfiltration_risk",
   "credential_theft_risk",
   "tool_manipulation_risk",
   "instruction_override_risk",
   "detected_patterns",
   "requested_actions",
   "sanitized_content",
   "sources",
   "cached",
   "degraded",
   "scanned_at"
  ],
  "type": "object"
 }
}
