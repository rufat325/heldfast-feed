{
 "description": "Process a workflow JSON definition. Creates tags and custom values, returns workflow JSON ready for builder injection.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "workflow": {
    "description": "Workflow JSON definition",
    "properties": {
     "actions": {
      "items": {},
      "type": "array"
     },
     "custom_values": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "goal": {},
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "trigger": {}
    },
    "required": [
     "name",
     "actions"
    ],
    "type": "object"
   }
  },
  "required": [
   "access_token",
   "location_id",
   "workflow"
  ],
  "type": "object"
 },
 "name": "crm_process_workflow"
}
