 "description": "Search the CERN Open Data Portal's datasets, software, environments, documentation and supplementary records with exact-vocabulary filters and an optional full-text query. The filters are experiment, record type, physics category, keyword, collision energy and type, file format, data-taking year, event count, availability, collection, and LHCb magnet polarity, stripping stream and stripping version. Returns compact hits with recids plus live facet counts. Each facet ignores its own filter, so its counts show the alternatives under the other filters. Filter values are exact upstream; common spellings are normalized, and cern_opendata_list_reference lists the vocabulary. Paging reaches the first 10,000 matches.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "availability": {
    "description": "Record availability (OR): online, partial, ondemand (on tape, requested before download) or requested. Array or comma-separated string, up to 4.",
    "items": {
     "description": "One availability value.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 4,
    "type": "array"
   },
   "category": {
    "description": "Physics categories of simulated datasets (OR): a primary such as Exotica, Higgs Physics, Standard Model Physics or Supersymmetry, or Primary::Secondary such as Higgs Physics::Standard Model. Array or comma-separated string, up to 20; case and the separator are normalized, and a known value holding a comma is kept whole. Heavy-Ion Physics also matches its leading-space spelling. cern_opendata_list_reference topic categories lists every value.",
    "items": {
     "description": "One category value.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "collection": {
    "description": "Portal collections (OR), exact and case-sensitive, such as CMS-Validated-Runs; copy spellings from a record's collections field. Array or comma-separated string, up to 10.",
    "items": {
     "description": "One collection name, exact and case-sensitive.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "collision_energy": {
    "description": "Collision energies (OR), such as 7TeV, 8TeV, 13TeV or 5.02TeV. Array or comma-separated string, up to 15; \"13TeV, 13.6TeV\" is one upstream value and is kept whole.",
    "items": {
     "description": "One collision_energy value.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 15,
    "type": "array"
   },
   "collision_type": {
    "description": "Collision types (OR): pp, PbPb, pPb, e+e-, Interfill. PbPb also matches the Pb-Pb spelling. Array or comma-separated string, up to 6.",
    "items": {
     "description": "One collision_type value.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 6,
    "type": "array"
   },
   "experiment": {
    "description": "Experiments (OR): ALICE, ATLAS, CMS, DELPHI, JADE, LHCb, OPERA, PHENIX, TOTEM. Array or comma-separated string, up to 9; case is normalized.",
    "items": {
     "description": "One experiment value.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 9,
    "type": "array"
   },
   "file_type": {
    "description": "File formats and data tiers (OR), such as nanoaod, miniaod, aod, root, DAOD_PHYSLITE or csv. Array or comma-separated string, up to 20; case is normalized for known values.",
    "items": {
     "description": "One file_type value.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "keywords": {
    "description": "Record keywords (OR), exact and case-sensitive (Education and education differ), sent as given. Array or comma-separated string, up to 10; pass a keyword holding a comma in an array.",
    "items": {
     "description": "One keyword, exact and case-sensitive.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "limit": {
    "default": 10,
    "description": "Hits per page, 1-50.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "magnet_polarity": {
    "description": "LHCb magnet polarities (OR): MagDown or MagUp, set on LHCb collision datasets. Array or comma-separated string, up to 2; case is normalized.",
    "items": {
     "description": "One magnet_polarity value.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 2,
    "type": "array"
   },
   "max_events": {
    "description": "Maximum number of events, inclusive.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "min_events": {
    "description": "Minimum number of events, inclusive.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number, from 1. page \u00d7 limit may not exceed 10,000.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Full-text query, sent verbatim as an OpenSearch query_string (AND between terms; title matches weigh double). Field forms such as title:\"\u2026\", recid:(1 OR 2) or run_period:(\"Run2012B\") work; cern_opendata_list_reference with topic query_syntax lists them. Omit to browse by filters alone.",
    "maxLength": 500,
    "type": "string"
   },
   "sort": {
    "description": "bestmatch (relevance), mostrecent (by date_published, newest first), title (A-Z) or title_desc (Z-A). Omitted: bestmatch with a query, mostrecent (newest first) without.",
    "enum": [
     "bestmatch",
     "mostrecent",
     "title",
     "title_desc"
    ],
    "type": "string"
   },
   "stripping_stream": {
    "description": "LHCb stripping streams (OR), such as BHADRON, CHARM, DIMUON, EW or LEPTONIC; they also match LHCb stripping documentation. Array or comma-separated string, up to 11; case is normalized. cern_opendata_list_reference topic lhcb lists them.",
    "items": {
     "description": "One stripping_stream value.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 11,
    "type": "array"
   },
   "stripping_version": {
    "description": "LHCb stripping versions (OR), such as stripping21 or stripping21r1p2. Array or comma-separated string, up to 12; case is normalized.",
    "items": {
     "description": "One stripping_version value.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "type": {
    "description": "Record types (OR): a primary (Dataset, Documentation, Environment, Software, Supplementaries, News) or Primary::Secondary such as Dataset::Collision or Dataset::Simulated. Array or comma-separated string, up to 7. Omit for every served type; Glossary is not served.",
    "items": {
     "description": "One type value.",
     "maxLength": 100,
     "type": "string"
    },
    "maxItems": 7,
    "type": "array"
   },
   "year_from": {
    "description": "Earliest data-taking year, inclusive. Alone, it means this year onward; for one year, set year_from and year_to to it.",
    "maximum": 2100,
    "minimum": 1900,
    "type": "integer"
   },
   "year_to": {
    "description": "Latest data-taking year, inclusive. Alone, it means up to this year.",
    "maximum": 2100,
    "minimum": 1900,
    "type": "integer"
   }
  },
  "type": "object"
 },
