{
 "description": "Create or update an opportunity. If a matching opportunity exists (by pipeline, location, and contact), it will be updated; otherwise a new one is created.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "assignedTo": {
    "description": "User ID to assign the opportunity to",
    "type": "string"
   },
   "contactId": {
    "description": "Associated contact ID",
    "type": "string"
   },
   "locationId": {
    "description": "Location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "monetaryValue": {
    "description": "Monetary value of the opportunity",
    "type": "number"
   },
   "name": {
    "description": "Opportunity name",
    "type": "string"
   },
   "pipelineId": {
    "description": "Pipeline ID",
    "type": "string"
   },
   "pipelineStageId": {
    "description": "Pipeline stage ID",
    "type": "string"
   },
   "source": {
    "description": "Source of the opportunity",
    "type": "string"
   },
   "status": {
    "description": "Status (open, won, lost, abandoned)",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "pipelineId",
   "locationId",
   "contactId",
   "name"
  ],
  "type": "object"
 },
 "name": "crm_upsert_opportunity"
}
