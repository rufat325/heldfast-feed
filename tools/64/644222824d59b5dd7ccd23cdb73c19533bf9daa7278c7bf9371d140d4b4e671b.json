       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "description": "Public https download URL.",
       "type": "string"
      }
     },
     "required": [
      "format",
      "url",
      "size_bytes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "code": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "message": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "is_terminal": {
    "type": "boolean"
   },
   "job_id": {
    "type": "string"
   },
   "library_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Where the job is kept in the web app."
   },
   "media_type": {
    "type": "string"
   },
   "model": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "format": {
        "enum": [
         "glb"
        ],
        "type": "string"
       },
       "size_bytes": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "url": {
        "description": "Public https URL of a file the viewer can draw.",
        "type": "string"
       }
      },
      "required": [
