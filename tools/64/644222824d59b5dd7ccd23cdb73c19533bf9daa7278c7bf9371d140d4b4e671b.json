       "format",
       "size_bytes"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Null until the job has produced a file in a viewable format."
   },
   "outputs": {
    "additionalProperties": false,
    "properties": {
     "expected": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "finished": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
