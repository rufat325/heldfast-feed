  "title": "Viewer job state"
 },
 "description": "Used by the interactive 3D viewer shown next to a generation result, not for direct use: the state of one job and, once it has finished, the URL of the model file the viewer can draw plus the download links. Read-only; the conversation never needs to call it, get_job gives the same facts as text.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "job_id": {
    "description": "The job id returned by generate_3d.",
    "maxLength": 191,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "job_id"
  ],
  "type": "object"
 },
 "name": "viewer_job_state",
 "outputSchema": {
