{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Evaluate a math expression and return the numeric result. Useful for fuel, range/autonomy, unit conversions, and ad-hoc arithmetic.\n\nSupported (exhaustive): +, -, *, /, ^, %, parentheses, sqrt(), abs(), ceil(), floor(), round(), sin(), cos(), tan(), log(), exp(), min(), max(), PI, E. Anything else (atan2, pow, log10, hypot, if, factorial, comparisons) is rejected.\n\nExamples: \"(120 / 6) * 8.5\" (fuel for 120 nm at 8.5 L/h, 6 kn); \"45 * 1.852\" (nm to km).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expression": {
    "description": "Math expression to evaluate",
    "examples": [
     "(450 / 8.5) * 1.1",
     "sqrt(3^2 + 4^2)",
     "45 * 1.852"
    ],
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "precision": {
    "default": 4,
    "description": "Decimal places in the result (default 4)",
    "examples": [
     2,
     4,
     6
    ],
    "maximum": 15,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "expression"
  ],
  "type": "object"
 },
 "name": "nausika_calculator",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expression": {
    "type": "string"
   },
   "precision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "result": {
    "type": "number"
   }
  },
  "required": [
   "expression",
   "result",
   "precision"
  ],
  "type": "object"
 },
 "title": "Calculator"
}
