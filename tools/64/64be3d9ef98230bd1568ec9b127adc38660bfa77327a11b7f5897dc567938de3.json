{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "croncool:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check a job's run history"
 },
 "description": "Use this when someone asks whether a cron job ran, failed or was slow, including a run just triggered. Returns recent runs newest first with success or failure, HTTP status, duration and time (no response bodies), 20 by default and 100 at most. Not for starting a run.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "jobId": {
    "description": "Job id (uuid)",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "How many runs to return, from 1 to 100; defaults to 20",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "get_job_runs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "executions": {
    "description": "Runs newest first. Response bodies, error text, job request payloads and credentials are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "durationMs": {
       "anyOf": [
        {
         "maximum": 86400000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "executionTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "httpStatus": {
       "anyOf": [
        {
         "maximum": 599,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 128,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "anyOf": [
        {
         "enum": [
          "success",
          "failure"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "status",
      "httpStatus",
      "durationMs",
      "executionTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "jobId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "executions"
  ],
  "type": "object"
 },
 "title": "Check a job's run history"
}
