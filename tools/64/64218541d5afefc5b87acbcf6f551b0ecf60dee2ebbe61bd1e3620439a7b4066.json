{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create floorplan region"
 },
 "description": "Create a region (labeled room or zone) on a floorplan. Polygon coordinates are normalized 0-1 with origin top-left. Optionally link the region to an existing Location via location_id. Requires floorplan_regions:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "confidence": {
    "description": "AI confidence score (0-1), only set when source=ai",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "floorplan_id": {
    "description": "Floorplan this region belongs to",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "label": {
    "description": "Region label (e.g. \"Boiler Room 2B\")",
    "maxLength": 500,
    "type": "string"
   },
   "location_id": {
    "description": "Linked Location ID (resolved via list_locations)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "polygon": {
    "description": "Polygon outline as an array of [x, y] points in normalized 0-1 coordinates (origin top-left). At least 3 points.",
    "items": {
     "items": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "maxItems": 2,
     "minItems": 2,
     "type": "array"
    },
    "minItems": 3,
    "type": "array"
   },
   "reviewed": {
    "description": "True if an admin has reviewed this region (default: true for manual, false for ai)",
    "type": "boolean"
   },
   "source": {
    "description": "\"manual\" (default) or \"ai\" for AI-detected",
    "enum": [
     "manual",
     "ai"
    ],
    "type": "string"
   }
  },
  "required": [
   "floorplan_id",
   "label",
   "polygon"
  ],
  "type": "object"
 },
 "name": "create_floorplan_region",
 "title": "Create floorplan region"
}
