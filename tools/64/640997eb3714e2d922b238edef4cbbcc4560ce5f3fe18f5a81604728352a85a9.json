{
 "description": "Register a training run that ran on YOUR OWN stack (your Tinker/RunPod account, custom TRL pipeline \u2014 Step 19-ext two-lane doctrine): the checkpoint becomes a first-class TrainingRun/TrainedModel so human evals link to it (experiments[].trainingRunId on opentrain_launch_eval_work), webhooks fire with it, and model programs can reference it. Idempotent via externalRef. Requires compute:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baseModel": {
    "type": "string"
   },
   "displayName": {
    "type": "string"
   },
   "externalRef": {
    "description": "Idempotency key, e.g. your W&B run id",
    "type": "string"
   },
   "hyperparams": {
    "additionalProperties": {
     "type": [
      "string",
      "number",
      "boolean"
     ]
    },
    "type": "object"
   },
   "lineage": {
    "additionalProperties": false,
    "properties": {
     "datasetLicenseId": {
      "type": "string"
     },
     "exportId": {
      "type": "string"
     },
     "projectId": {
      "type": "string"
     },
     "syntheticRunId": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "meta": {
    "additionalProperties": {},
    "type": "object"
   },
   "metrics": {
    "additionalProperties": {
     "type": "number"
    },
    "type": "object"
   },
   "modelHandle": {
    "description": "Checkpoint ref: HF repo, URL, tinker://\u2026, replicate version",
    "type": "string"
   },
   "objective": {
    "description": "Free text, default SFT (GRPO/RL/distillation welcome)",
    "type": "string"
   },
   "provider": {
    "description": "Your stack, free text: \"tinker\", \"runpod\", \"custom-trl\", \u2026",
    "type": "string"
   },
   "trainedAt": {
    "type": "string"
   }
  },
  "required": [
   "provider",
   "baseModel",
   "modelHandle"
  ],
  "type": "object"
 },
 "name": "opentrain_compute_register_external_run",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
