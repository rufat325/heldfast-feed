{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Given a guide slug and one pick per debate ('A', 'B', or skip, in debate order, as a single string e.g. 'ABAB'), returns which library ids argue the picked side of each debate and the union reading list. Pure compute over public debate data \u2014 no book text is generated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "guide": {
    "description": "Guide slug (e.g. memoir-writing, nonfiction-writing, fiction-writing, getting-published).",
    "type": "string"
   },
   "picks": {
    "description": "One char per debate in order: A, B, or any other char (or omit) for skip.",
    "type": "string"
   }
  },
  "required": [
   "guide"
  ],
  "type": "object"
 },
 "name": "choose_camp",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "canonicalUrl": {
    "type": "string"
   },
   "contract": {
    "type": "string"
   },
   "guideCanonicalUrl": {
    "type": "string"
   },
   "guideSlug": {
    "type": "string"
   },
   "guideTitle": {
    "type": "string"
   },
   "libraryIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "picks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "canonicalUrl": {
       "type": "string"
      },
      "debateSlug": {
       "type": "string"
      },
      "libraryIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "pick": {
       "enum": [
        "A",
        "B",
        "skip"
       ],
       "type": "string"
      }
     },
     "required": [
      "debateSlug",
      "name",
      "pick",
      "libraryIds",
      "canonicalUrl"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "contract",
   "guideSlug",
   "guideTitle",
   "picks",
   "libraryIds",
   "canonicalUrl",
   "guideCanonicalUrl"
  ],
  "type": "object"
 },
 "title": "Choose your camp on a guide's debates"
}
