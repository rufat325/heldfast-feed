    "type": "string"
   },
   "extract": {
    "enum": [
     "text",
     "links",
     "code",
     "headings",
     "grep"
    ],
    "type": "string"
   },
   "handle": {
    "type": "string"
   },
   "interval_seconds": {
    "description": "\u22653600 (1h)",
    "type": "integer"
   },
   "pattern": {
    "description": "regex, required if extract=grep",
    "type": "string"
   },
   "secret": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
