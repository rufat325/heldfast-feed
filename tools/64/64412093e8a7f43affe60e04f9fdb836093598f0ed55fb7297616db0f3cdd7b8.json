{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Record an action an agent took (or was blocked from taking) with tokens, cost and value. Pass idempotency_key to make retries safe. Requires member role.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"action_type":{"maxLength":120,"minLength":1,"type":"string"},"agent":{"maxLength":120,"minLength":1,"type":"string"},"approval_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"blocked_reason":{"maxLength":500,"type":"string"},"compensates_action_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"compensation":{"properties":{"action_type":{"maxLength":120,"minLength":1,"type":"string"},"metadata":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"target_system":{"maxLength":120,"minLength":1,"type":"string"}},"required":["action_type","target_system"],"type":"object"},"cost_center":{"pattern":"^[A-Za-z0-9_-]{1,40}$","type":"string"},"decision_record_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"idempotency_key":{"maxLength":200,"type":"string"},"latency_ms":{"default":0,"maximum":86400000,"minimum":0,"type":"integer"},"metadata":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"minutes_saved":{"default":0,"maximum":100000,"minimum":0,"type":"number"},"model":{"maxLength":120,"type":"string"},"model_cost_usd":{"default":0,"maximu