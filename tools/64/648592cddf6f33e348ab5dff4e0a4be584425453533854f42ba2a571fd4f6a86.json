   "apiInputPrice": {
    "default": 0.15,
    "minimum": 0,
    "type": "number"
   },
   "apiModel": {
    "default": "gpt-4o-mini",
    "type": "string"
   },
   "apiOutputPrice": {
    "default": 0.6,
    "minimum": 0,
    "type": "number"
   },
   "gpu": {
    "description": "Canonical tokcalc GPU ID (e.g. 'h100-sxm'). Call list_gpus first if unknown.",
    "type": "string"
   },
   "gpuCount": {
    "default": 1,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   },
   "inputTokens": {
    "default": 500,
    "maximum": 2000000,
    "minimum": 1,
    "type": "integer"
   },
   "model": {
    "description": "Canonical tokcalc model ID (e.g. 'llama3-8b'). Call list_models first if unknown.",
    "type": "string"
   },
   "outputTokens": {
    "default": 200,
    "maximum": 200000,
    "minimum": 1,
    "type": "integer"
   },
   "quantization": {
    "default": "fp16",
    "enum": [
     "fp32",
     "fp16",
     "bf16",
     "int8",
     "int4",
     "gguf-q2k",
     "gguf-q3km",
     "gguf-q4km",
     "gguf-q5km",
     "gguf-q6k",
     "gguf-q8",
     "gptq4",
     "awq4",
     "exl2-6bpw",
     "fp8",
     "nvfp4"
    ],
    "type": "string"
   },
   "requestsPerDay": {
    "default": 1000,
    "maximum": 100000000,
    "minimum": 1,
    "type": "integer"
   },
   "utilization": {
    "default": 0.5,
    "maximum": 1,
    "minimum": 0.05,
    "type": "number"
   }
  },
  "required": [
   "model",
   "gpu"
  ],
  "type": "object"
 },
 "name": "estimate_api_vs_self_host"
}
