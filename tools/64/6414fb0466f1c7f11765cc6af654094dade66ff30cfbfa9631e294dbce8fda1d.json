{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Real Google search suggestions (autocomplete/suggest) via pure HTTP \u2014 no browser, no CAPTCHA. Set expand=true to mine long-tail keywords.\n\nupAPI operation `google-autocomplete.post` (Search). Costs 1 unit of monthly quota per call.",
 "inputSchema": {
  "properties": {
   "client": {
    "default": "chrome",
    "description": "'chrome' (rich: relevance+type) or 'firefox' (simple)",
    "title": "Client",
    "type": "string"
   },
   "country": {
    "default": "us",
    "description": "gl param (e.g. us, ca, gb)",
    "title": "Country",
    "type": "string"
   },
   "expand": {
    "default": false,
    "description": "Also query '{query} a..z' to mine long-tail suggestions",
    "title": "Expand",
    "type": "boolean"
   },
   "language": {
    "default": "en",
    "description": "hl param (e.g. en, fr, es)",
    "title": "Language",
    "type": "string"
   },
   "maxSuggestions": {
    "default": 50,
    "description": "Max suggestions to return",
    "maximum": 200,
    "minimum": 1,
    "title": "Maxsuggestions",
    "type": "integer"
   },
   "proxyUrl": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional proxy URL",
    "title": "Proxyurl"
   },
   "query": {
    "description": "Seed query to autocomplete",
    "minLength": 1,
    "title": "Query",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "title": "Input",
  "type": "object"
 },
 "name": "google_autocomplete_post",
 "title": "Google Autocomplete"
}
