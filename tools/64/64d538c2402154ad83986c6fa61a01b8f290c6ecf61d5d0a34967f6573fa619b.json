{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Send feedback"
 },
 "description": "FREE. Tell Maxwell why you did not buy, what data, category or product you needed that is not here, or whether a paid answer was right. Every field is optional; one call, no payment.",
 "inputSchema": {
  "properties": {
   "comment": {
    "description": "Anything else (max 1000 characters)",
    "type": "string"
   },
   "kind": {
    "description": "What this is about",
    "enum": [
     "no_purchase",
     "missing",
     "after_purchase",
     "request",
     "other"
    ],
    "type": "string"
   },
   "product": {
    "description": "Product id or path, e.g. courts.search",
    "type": "string"
   },
   "rating": {
    "description": "For a paid answer: 1 (bad) to 5 (good)",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "reason": {
    "enum": [
     "no_wallet",
     "price",
     "unclear",
     "not_needed",
     "data_missing",
     "wrong_data",
     "stale",
     "format",
     "too_slow",
     "other"
    ],
    "type": "string"
   },
   "requestId": {
    "description": "requestId from a paid answer, if any",
    "type": "string"
   },
   "wanted": {
    "description": "The data, category or product you needed",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "send_feedback",
 "title": "Send feedback"
}
