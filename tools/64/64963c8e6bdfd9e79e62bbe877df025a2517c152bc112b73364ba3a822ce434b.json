    },
    "type": "object"
   },
   "domain_id": {
    "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "question": {
    "maxLength": 2000,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
