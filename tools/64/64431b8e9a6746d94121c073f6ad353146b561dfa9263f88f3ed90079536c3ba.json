{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Assign semantic categorical labels to an entity, visual state, task, or state snapshot using deterministic System One calculus. Use classify instead of ask_choice when assigning predefined taxonomy labels rather than selecting among runtime decision alternatives.\n\nReturns top class label, probability distribution, and classification margin.",
 "inputSchema": {
  "properties": {
   "classes": {
    "description": "Candidate classes (capped at 16)",
    "items": {
     "type": "string"
    },
    "maxItems": 16,
    "type": "array"
   },
   "project": {
    "description": "Target project slug",
    "type": "string"
   },
   "state_pack": {
    "description": "Optional explicit StatePack",
    "type": "object"
   },
   "target_id": {
    "description": "Identifier of the target",
    "type": "string"
   },
   "target_type": {
    "description": "Type of target to classify",
    "enum": [
     "entity",
     "visual_state",
     "task",
     "goal",
     "snapshot"
    ],
    "type": "string"
   }
  },
  "required": [
   "project",
   "target_type",
   "classes"
  ],
  "type": "object"
 },
 "name": "classify"
}
