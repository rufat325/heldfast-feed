{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Replace the full set of file monitoring plugins for a server instance (sends the entire list).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "configList": {
    "description": "Full list of file paths to monitor (replaces existing)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "instanceNo": {
    "description": "Server instance number",
    "type": "string"
   },
   "type": {
    "description": "Target type (default 'vpcserver')",
    "enum": [
     "vpcserver",
     "classicserver",
     "cloudhadoop"
    ],
    "type": "string"
   }
  },
  "required": [
   "instanceNo",
   "configList"
  ],
  "type": "object"
 },
 "name": "ncloud_set_file_plugins"
}
