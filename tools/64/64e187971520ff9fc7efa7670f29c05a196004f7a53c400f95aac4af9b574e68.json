{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estimate the hard-disk storage a CCTV system needs and suggest a disk size. Same calculation as https://utechit.pk/tools/cctv-hard-disk-storage-calculator",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cameras": {
    "maximum": 512,
    "minimum": 1,
    "type": "integer"
   },
   "codec": {
    "default": "h265",
    "enum": [
     "h264",
     "h265",
     "h265+"
    ],
    "type": "string"
   },
   "days": {
    "default": 30,
    "description": "Days of recording to keep",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "hoursPerDay": {
    "default": 24,
    "maximum": 24,
    "minimum": 1,
    "type": "number"
   },
   "motionPercent": {
    "default": 100,
    "description": "Share of time recorded; 100 = continuous",
    "maximum": 100,
    "minimum": 5,
    "type": "number"
   },
   "resolution": {
    "default": "4mp",
    "enum": [
     "2mp",
     "4mp",
     "5mp",
     "8mp"
    ],
    "type": "string"
   }
  },
  "required": [
   "cameras"
  ],
  "type": "object"
 },
 "name": "calculate_cctv_storage",
 "title": "CCTV storage calculator"
}
