{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List your submitted job applications, most recent first, paginated. Each item includes jobOpen, indicating whether the job is still open, and isWithdrawable, indicating whether the application can be withdrawn via the withdraw_application tool. If isWithdrawable is false, the application cannot be withdrawn from MCP; it can still be withdrawn from the confirmation email sent when applying. Recruiting-pipeline stages (in_review, interviewed, offered, rejected) are not tracked here.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "default": 1,
    "description": "1-based page number; 10 applications per page (default 1)",
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_my_applications",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applications": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "applicationDate": {
       "description": "ISO date the application was submitted",
       "type": "string"
      },
      "applicationId": {
       "description": "Application identifier (use with withdraw_application)",
       "type": "string"
      },
      "company": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": [
          "string",
          "null"
         ]
        },
        "name": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "employmentType": {
       "type": "string"
      },
      "isWithdrawable": {
       "description": "Whether this application can be withdrawn via the withdraw_application MCP tool. If false, it cannot be withdrawn from MCP; it can still be withdrawn from the confirmation email sent when applying.",
       "type": "boolean"
      },
      "jobOpen": {
       "description": "Whether the job is still active/open",
       "type": "boolean"
      },
      "location": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "uid": {
       "description": "Job/posting identifier (use with get_job)",
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "workplace": {
       "type": "string"
      }
     },
     "required": [
      "applicationId",
      "uid",
      "title",
      "location",
      "applicationDate",
      "jobOpen",
      "isWithdrawable"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hasMore": {
    "type": "boolean"
   },
   "page": {
    "type": "number"
   },
   "pageSize": {
    "type": "number"
   },
   "totalItems": {
    "type": "number"
   },
   "totalPages": {
    "type": "number"
   }
  },
  "required": [
   "totalItems",
   "page",
   "pageSize",
   "totalPages",
   "hasMore",
   "applications"
  ],
  "type": "object"
 },
 "title": "Get my applications"
}
