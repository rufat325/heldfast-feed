{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get Token Allowances"
 },
 "description": "Check ERC20 token allowances for a spender address. Use before write.wallet.approve to avoid redundant approvals \u2014 skip approving if the current allowance is already sufficient.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain_id": {
    "default": 8453,
    "description": "Chain ID: 8453 (Base), 130 (Unichain), or 10 (Optimism)",
    "type": "number"
   },
   "owner_address": {
    "description": "Token owner address (the wallet granting approval)",
    "type": "string"
   },
   "spender_address": {
    "description": "Spender address to check allowance for (e.g. Arcadia account address)",
    "type": "string"
   },
   "token_addresses": {
    "description": "ERC20 token contract addresses to check",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "owner_address",
   "spender_address",
   "token_addresses"
  ],
  "type": "object"
 },
 "name": "read.wallet.allowances",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "tokens": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "type": "string"
      },
      "allowance": {
       "type": "string"
      },
      "decimals": {
       "type": "number"
      },
      "formatted": {
       "type": "string"
      },
      "is_max_approval": {
       "type": "boolean"
      },
      "symbol": {
       "type": "string"
      }
     },
     "required": [
      "address",
      "symbol",
      "decimals",
      "allowance",
      "formatted",
      "is_max_approval"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tokens"
  ],
  "type": "object"
 }
}
