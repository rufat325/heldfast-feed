{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "assignments:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create assignment draft"
 },
 "description": "Builds an assignment draft from multiple-choice units and topics (skipping already assigned questions), Fiveable FRQ or SAQ ids, readings with optional checks, or a diagnostic. Settings start from the first class's defaults. AP Calculus drafts require courseVariant or target classes sharing one course. Returns the draft id and review link. Drafts never use an included assignment slot.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "availableAt": {
    "description": "When it opens, ISO with offset.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "classes": {
    "description": "Classes to target, each with an optional due date.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "classId": {
       "description": "Class id from list_classes.",
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "dueAt": {
       "description": "ISO date-time with timezone offset.",
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      }
     },
     "required": [
      "classId"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   },
   "courseVariant": {
    "description": "AP Calculus only: ap-calc-ab or ap-calc-bc. Omit to use the course the target classes share.",
    "enum": [
     "ap-calc-ab",
     "ap-calc-bc"
    ],
    "type": "string"
   },
   "dueAt": {
    "description": "Default due time for every class.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "instructions": {
    "maxLength": 5000,
    "type": "string"
   },
   "requestId": {
    "description": "A unique id you generate for this action. Reuse it only when retrying the same action.",
    "pattern": "^[\\w-]{8,128}$",
    "type": "string"
   },
   "resultRelease": {
    "description": "When students see results.",
    "enum": [
     "immediate",
     "manual",
     "scheduled"
    ],
    "type": "string"
   },
   "sections": {
    "items": {
     "oneOf": [
      {
       "additionalProperties": false,
       "properties": {
        "avoidRepeats": {
         "default": true,
         "description": "Skip questions this teacher already published.",
         "type": "boolean"
        },
        "questionCount": {
         "description": "Total questions in this section.",
         "maximum": 100,
         "minimum": 1,
         "type": "integer"
        },
        "skillId": {
         "anyOf": [
          {
           "maxLength": 200,
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "description": "Optional CED skill id to narrow to."
        },
        "style": {
         "default": "exam",
         "description": "exam = AP-style (with stimulus sets where the exam has them); comprehension or vocabulary checks.",
         "enum": [
          "exam",
          "comprehension",
          "vocabulary"
         ],
         "type": "string"
        },
        "timeLimitMinutes": {
         "anyOf": [
          {
           "maximum": 300,
           "minimum": 1,
           "type": "integer"
          },
          {
           "type": "null"
          }
         ],
         "description": "Omit for untimed."
        },
        "type": {
         "const": "multiple_choice",
         "type": "string"
        },
        "units": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "questionCount": {
            "description": "Omit to split the total evenly.",
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
           },
           "topicIds": {
            "description": "Topic ids to narrow to.",
            "items": {
             "maxLength": 200,
             "minLength": 1,
             "type": "string"
            },
            "maxItems": 60,
            "type": "array"
           },
           "unitId": {
            "anyOf": [
             {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
             },
             {
              "type": "null"
             }
            ],
            "description": "Unit id from get_subject_outline; null = whole course."
           }
          },
          "required": [
           "unitId"
          ],
          "type": "object"
         },
         "maxItems": 20,
         "minItems": 1,
         "type": "array"
        }
       },
       "required": [
        "type",
        "questionCount",
        "style",
        "units",
        "avoidRepeats"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "questionId": {
         "description": "An frq: or saq: id from search_question_bank.",
         "pattern": "^frq:[\\w-]+$|^saq:[\\w-]+(:[A-Za-z])?$",
         "type": "string"
        },
        "type": {
         "const": "free_response",
         "type": "string"
        }
       },
       "required": [
        "type",
        "questionId"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "readingQuestions": {
         "default": false,
         "description": "Add reading-check questions (study guides and AMSCO guided notes).",
         "type": "boolean"
        },
        "resourceId": {
         "description": "A resource id from list_teaching_resources.",
         "maxLength": 300,
         "minLength": 1,
         "type": "string"
        },
        "type": {
         "const": "reading",
         "type": "string"
        }
       },
       "required": [
        "type",
        "resourceId",
        "readingQuestions"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "type": {
         "const": "diagnostic",
         "type": "string"
        },
        "unitIds": {
         "description": "Unit ids from get_subject_outline.",
         "items": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
         },
         "maxItems": 15,
         "minItems": 1,
         "type": "array"
        },
        "unitLabels": {
         "items": {
          "maxLength": 200,
          "type": "string"
         },
         "maxItems": 15,
         "type": "array"
        }
       },
       "required": [
        "type",
        "unitIds"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "settings": {
    "additionalProperties": false,
    "properties": {
     "durationMinutes": {
      "anyOf": [
       {
        "maximum": 300,
        "minimum": 1,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "maxAttempts": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
     },
     "notifications": {
      "additionalProperties": false,
      "properties": {
       "dueReminder": {
        "type": "boolean"
       },
       "onPublish": {
        "type": "boolean"
       },
       "onResultsRelease": {
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "resultRelease": {
      "description": "When students see results.",
      "enum": [
       "immediate",
       "manual",
       "scheduled"
      ],
      "type": "string"
     },
     "scoringMode": {
      "description": "Who scores free responses.",
      "enum": [
       "ai",
       "self",
       "teacher"
      ],
      "type": "string"
     },
     "timerMode": {
      "enum": [
       "strict",
       "flexible",
       "none"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "subjectSlug": {
    "description": "Subject, e.g. apush or ap-bio.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "subjectSlug",
   "sections",
   "requestId"
  ],
  "type": "object"
 },
 "name": "create_assignment_draft",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "assignments:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Create assignment draft"
}
