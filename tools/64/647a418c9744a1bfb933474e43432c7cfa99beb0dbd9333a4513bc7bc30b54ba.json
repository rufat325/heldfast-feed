{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Parse a plist at a bounded relative path beneath the active artifact container. Symlink and traversal escapes are rejected; output is normalized JSON rather than plutil text.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "relative_path": "Contents/Info.plist"
   }
  ],
  "properties": {
   "relative_path": {
    "default": "Contents/Info.plist",
    "description": "Local filesystem path for relative.",
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "inspect_plist",
 "outputSchema": {
  "$defs": {
   "__schema0": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     },
     {
      "type": "null"
     },
     {
      "items": {
       "$ref": "#/$defs/__schema0"
      },
      "type": "array"
     },
     {
      "additionalProperties": {
       "$ref": "#/$defs/__schema0"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ]
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "bundle": {
      "additionalProperties": false,
      "properties": {
       "executable": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "identifier": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "short_version": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "version": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "identifier",
       "executable",
       "name",
       "version",
       "short_version"
      ],
      "type": "object"
     },
     "format": {
      "enum": [
       "xml",
       "binary",
       "json",
       "unknown"
      ],
      "type": "string"
     },
     "limitations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "provenance": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "command": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "executable_sha256": {
         "pattern": "^[a-f0-9]{64}$",
         "type": "string"
        },
        "exit": {
         "additionalProperties": false,
         "properties": {
          "code": {
           "anyOf": [
            {
             "maximum": 9007199254740991,
             "minimum": -9007199254740991,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ]
          },
          "signal": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "code",
          "signal"
         ],
         "type": "object"
        },
        "stderr_bytes": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "stderr_truncated": {
         "type": "boolean"
        },
        "stdout_bytes": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "stdout_truncated": {
         "type": "boolean"
        },
        "tool": {
         "minLength": 1,
         "type": "string"
        },
        "tool_version": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "version_reason": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "tool",
        "command",
        "tool_version",
        "version_reason",
        "executable_sha256",
        "exit",
        "stdout_bytes",
        "stderr_bytes",
        "stdout_truncated",
        "stderr_truncated"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "source_path": {
      "type": "string"
     },
     "value": {
      "$ref": "#/$defs/__schema0"
     }
    },
    "required": [
     "format",
     "value",
     "bundle",
     "source_path",
     "provenance",
     "limitations"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Inspect Plist"
}
