{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "eth_call with your own calldata against one pinned public node: raw return data plus its decoded uint/address forms. The escape hatch for any view function we did not wrap. Costs $0.001 USDC per call. Chains: base, ethereum, arbitrum, bsc, polygon, optimism, avalanche. Byte-identical to GET /chain/call?chain=base&to=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913&data=0x95d89b41&blockTag=latest.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blockTag": {
    "description": "block number or latest|safe|finalized|earliest|pending (default \"latest\")",
    "type": "string"
   },
   "chain": {
    "description": "chain key: base, ethereum, arbitrum, bsc, polygon, optimism, avalanche [required]",
    "type": "string"
   },
   "data": {
    "description": "hex calldata, even digits, max 4096 bytes [required]",
    "type": "string"
   },
   "to": {
    "description": "contract address to call [required]",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "to",
   "data"
  ],
  "type": "object"
 },
 "name": "chain_call",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asAddress": {
    "type": [
