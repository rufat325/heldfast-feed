     "null"
    ]
   },
   "asString": {
    "type": "string"
   },
   "asUint": {
    "type": "string"
   },
   "blockTag": {
    "type": "string"
   },
   "caveat": {
    "type": [
     "string",
     "null"
    ]
   },
   "chain": {
    "type": [
     "string",
     "null"
    ]
   },
   "chainId": {
    "anyOf": [
