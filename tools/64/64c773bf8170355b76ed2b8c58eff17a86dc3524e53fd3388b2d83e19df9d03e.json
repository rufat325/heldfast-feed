  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fit_type": {
    "description": "What the fit is for: sliding-moving, bolt-clearance, pin-in-hole, mating-fdm-parts, press-interference or snap-fit.",
    "enum": [
     "sliding-moving",
     "bolt-clearance",
     "pin-in-hole",
     "mating-fdm-parts",
     "press-interference",
     "snap-fit"
    ],
    "type": "string"
   },
   "hole_axis": {
    "description": "vertical-z when the hole goes through a top or bottom face, horizontal-xy when it goes through a side wall.",
    "enum": [
     "vertical-z",
     "horizontal-xy"
    ],
    "type": "string"
   },
   "hole_diameter_mm": {
    "description": "The hole diameter the user plans to draw, in mm.",
    "maximum": 500,
    "minimum": 0.1,
    "type": "number"
   }
  },
  "type": "object"
 },
