{"_meta":{"fastmcp":{"tags":["client"]}},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true,"title":"List partner change requests"},"description":"List requests to move numbers between partners, with their status.\n\nClient users see the requests their client made. Partner users see the requests addressed to their partner,\nwhich they can approve or reject; a partner can pass 'client_id' to only see the requests of one client.\nPass 'request_id' to follow the status of one request.","inputSchema":{"additionalProperties":false,"properties":{"page":{"default":1,"description":"Page number to retrieve, starting at 1.","minimum":1,"type":"integer"},"request_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Optional. Only show the request with this ID."},"size":{"default":20,"description":"Number of requests to return per page, at most 100.","maximum":100,"minimum":1,"type":"integer"},"status":{"anyOf":[{"enum":["created","pending","completed","failed","rejected"],"type":"string"},{"type":"null"}],"default":null,"description":"Optional. Only list requests in this status. 'created' means waiting for the new partner's approval."}},"required":[],"type":"object"},"name":"list_partner_change_requests","outputSchema":{"properties":{"count":{"type":"integer"},"message":{"type":"string"},"requests":{"items":{"properties":{"client_contact_email":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"client_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"created_at":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"error_details":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null},"id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"is_full_migration":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null},"migrated_channels":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null},"modified_at":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"rejection_reason":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"source_client_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"source_partner_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"status":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"target_client_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"target_partner_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null}},"type":"object"},"type":"array"},"total":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null}},"required":["count","requests","message"],"type":"object"},"title":"List partner change requests"}
