{"description":"Returns counts only, never the items themselves: for the items use crossload_search. Given one topic name, it counts the whole topic server-side and reports how it is distributed over bible books and chapters, authors, series, years, licences, categories, media and duration, plus the topics that co-occur on the same items. Use it to answer 'which passages/authors/years does this topic span', to find related topics by evidence rather than by guess, and before writing anything that sums up a topic: counting by hand means paging through every hit. The topic name must match crossload_browse exactly; a guessed spelling is rejected and nothing is counted. 'withoutBibleRef' says how many items carry no passage at all, which is the caveat to every statement about the passages of a topic. Each distribution lists the most frequent entries only, and says so when it leaves something out.","inputSchema":{"additionalProperties":false,"properties":{"topic":{"description":"Topic name, exactly as listed by crossload_browse, e.g. 'Vergebung'. Resolved server-side; a guessed spelling is rejected and nothing is counted.","maxLength":100,"minLength":1,"type":"string"}},"required":["topic"],"type":"object"},"name":"crossload_topic_stats","outputSchema":{"properties":{"candidates":{"items":{"properties":{"contentCount":{"type":"number"},"description":{"type":"string"},"id":{"type":"string"},"imageUrl":{"type":"string"},"name":{"type":"string"},"path":{"type":"string"}},"required":["name","id"],"type":"object"},"type":"array"},"countedContents":{"type":"number"},"distributions":{"properties":{"authors":{"items":{"properties":{"count":{"type":"number"},"name":{"type":"string"}},"required":["name","count"],"type":"object"},"type":"array"},"bibleBooks":{"items":{"properties":{"count":{"type":"number"},"name":{"type":"string"}},"required":["name","count"],"type":"object"},"type":"array"},"bibleChapters":{"items":{"properties":{"count":{"type":"number"},"name":{"type":"string"}},"required":["name","count"],"type":"object"},"type":"array"},"categories":{"items":{"properties":{"count":{"type":"number"},"name":{"type":"string"}},"required":["name","count"],"type":"object"},"type":"array"},"coOccurringTopics":{"items":{"properties":{"count":{"type":"number"},"name":{"type":"string"}},"required":["name","count"],"type":"object"},"type":"array"},"duration":{"properties":{"longestMinutes":{"type":"number"},"medianMinutes":{"type":"number"},"shortestMinutes":{"type":"number"},"withDuration":{"type":"number"}},"required":["withDuration"],"type":"object"},"licenses":{"items":{"properties":{"count":{"type":"number"},"name":{"type":"string"}},"required":["name","count"],"type":"object"},"type":"array"},"media":{"items":{"properties":{"count":{"type":"number"},"name":{"type":"string"}},"required":["name","count"],"type":"object"},"type":"array"},"series":{"items":{"properties":{"count":{"type":"number"},"name":{"type":"string"}},"required":["name","count"],"type":"object"},"type":"array"},"withoutBibleRef":{"type":"number"},"withoutDate":{"type":"number"},"years":{"items":{"properties":{"count":{"type":"number"},"name":{"type":"string"}},"required":["name","count"],"type":"object"},"type":"array"}},"required":["bibleBooks","bibleChapters","withoutBibleRef","authors","series","years","withoutDate","licenses","categories","media","duration","coOccurringTopics"],"type":"object"},"message":{"type":"string"},"policyVersion":{"type":"string"},"resolved":{"items":{"properties":{"bookId":{"description":"0-based book id, as sent to the search API. Job is 17.","type":"number"},"chapterId":{"description":"0-based chapter id within the book. Job 15 is 14.","type":"number"},"chapterIdTo":{"description":"0-based, inclusive end of a chapter range.","type":"number"},"id":{"type":"string"},"input":{"type":"string"},"kind":{"enum":["topic","author","series","bibleRef"],"type":"string"},"name":{"type":"string"},"path":{"type":"string"},"verseIdFrom":{"description":"0-based. Recorded, but not used as a filter.","type":"number"},"verseIdTo":{"description":"0-based, inclusive.","type":"number"}},"required":["input","kind"],"type":"object"},"type":"array"},"status":{"enum":["ok","ambiguousInput","invalidInput","upstreamUnavailable"],"type":"string"},"topic":{"properties":{"contentCount":{"type":"number"},"description":{"type":"string"},"id":{"type":"string"},"imageUrl":{"type":"string"},"name":{"type":"string"},"path":{"type":"string"}},"required":["name","id"],"type":"object"},"totalContents":{"type":"number"},"truncated":{"properties":{"charactersDropped":{"type":"number"},"entriesDropped":{"type":"number"},"evidenceDropped":{"type":"number"},"hint":{"type":"string"},"hitsDropped":{"type":"number"},"reason":{"enum":["characterBudget","teaserBudget","listCap","evidenceCap","candidateCap","pageUnavailable"],"type":"string"},"suggestedPageSize":{"type":"number"},"teasersShortened":{"type":"number"}},"required":["reason","hint"],"type":"object"}},"required":["status"],"type":"object"}}
