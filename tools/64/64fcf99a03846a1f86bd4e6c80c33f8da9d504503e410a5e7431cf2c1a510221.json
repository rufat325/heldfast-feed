{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Start a recurring-card series on a board: every everyN unit(s) (days|weeks|months) it mints a card from the given template, until endAt (if set).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "boardId": {
    "description": "Board id, from zuuna_boards.",
    "minLength": 1,
    "type": "string"
   },
   "columnId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "endAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "everyN": {
    "minimum": 1,
    "type": "integer"
   },
   "priority": {
    "anyOf": [
     {
      "enum": [
       "HIGHEST",
       "HIGH",
       "NORMAL",
       "LOW",
       "LOWEST"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "title": {
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "enum": [
     "TASK",
     "BUG",
     "FEATURE",
     "CHANGE_REQUEST"
    ],
    "type": "string"
   },
   "unit": {
    "enum": [
     "days",
     "weeks",
     "months"
    ],
    "type": "string"
   }
  },
  "required": [
   "boardId",
   "title",
   "everyN",
   "unit"
  ],
  "type": "object"
 },
 "name": "zuuna_create_recurring_card",
 "title": "zuuna_create_recurring_card"
}
