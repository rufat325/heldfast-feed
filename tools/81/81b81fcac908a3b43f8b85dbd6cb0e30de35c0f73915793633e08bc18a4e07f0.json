{
 "description": "Execute an action on a deployed Floom app. Returns the function output as JSON. Preferred: use app_slug + action for simple invocation. Alternative: use project_id + endpoint_id + version_id for explicit control. Pass secrets: {KEY: value} for functions that require API keys.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action name (e.g. \"count\", \"generate\"). Used with app_slug.",
    "type": "string"
   },
   "app_slug": {
    "description": "App slug for simple invocation (e.g. \"my-app\")",
    "type": "string"
   },
   "callback_url": {
    "description": "URL to receive a POST with the run result when it completes (webhook)",
    "type": "string"
   },
   "endpoint_id": {
    "description": "Endpoint ID (e.g. \"post--generate_invoice\"). Used with project_id.",
    "type": "string"
   },
   "json": {
    "additionalProperties": {},
    "description": "JSON body to send to the endpoint",
    "type": "object"
   },
   "params": {
    "additionalProperties": {},
    "description": "Query parameters",
    "type": "object"
   },
   "project_id": {
    "description": "Project ID (alternative to app_slug)",
    "type": "string"
   },
   "timeout_seconds": {
    "description": "Max execution time in seconds (default 60)",
    "type": "number"
   },
   "version_id": {
    "description": "Version ID. Used with project_id.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "run"
}
