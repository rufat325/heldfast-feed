{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Returns the plan behind the current credential, an API key or a signed-in account: tier, rate limits, concurrency cap, data access, key cap, and trial budget. data_access gives how many of the most recent markets of each type the plan can read. A null cap means no cap. trial_budget is what a free trial may use in total over its 3 days. It applies only during a trial and does not show how much is left. Use it before a large read or after a plan or rate limit error. Costs 1 API request.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{},"type":"object"},"name":"polytest_get_limits","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"api_keys":{"additionalProperties":false,"properties":{"max_active":{"type":["number","null"]}},"required":["max_active"],"type":"object"},"concurrency":{"additionalProperties":false,"properties":{"max_concurrent":{"type":["number","null"]}},"required":["max_concurrent"],"type":"object"},"data_access":{"additionalProperties":false,"properties":{"15m_markets":{"type":["number","null"]},"1hr_markets":{"type":["number","null"]},"24hr_markets":{"type":["number","null"]},"4hr_markets":{"type":["number","null"]},"5m_markets":{"type":["number","null"]},"snapshots_per_market":{"type":["number","null"]}},"required":["5m_markets","15m_markets","1hr_markets","4hr_markets","24hr_markets","snapshots_per_market"],"type":"object"},"rate_limits":{"additionalProperties":false,"properties":{"burst_per_second":{"type":"number"},"requests_per_minute":{"type":"number"}},"required":["requests_per_minute","burst_per_second"],"type":"object"},"tier":{"type":"string"},"trial_budget":{"additionalProperties":false,"properties":{"bytes":{"type":"number"},"records":{"type":"number"},"requests":{"type":"number"}},"required":["requests","records","byte