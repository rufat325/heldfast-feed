{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare public digital-art / NFT records (marketplace, on-chain, catalogue) and find where they conflict. Pass a `question` and `evidence_items`; get conflicts, gaps and a receipt. Does not prove ownership or price. Free, read-only, no account. Inputs must be public and non-personal; calling declares that (data_classification defaults to PUBLIC).",
 "inputSchema": {
  "additionalProperties": true,
  "examples": [
   {
    "evidence_items": [
     {
      "creator": "Artist A",
      "source": "marketplace_listing"
     },
     {
      "creator": "Artist A",
      "source": "onchain_metadata"
     }
    ],
    "question": "Do these public records agree on the creator?"
   }
  ],
  "properties": {
   "continuity_handle": {
    "additionalProperties": false,
    "properties": {
     "continuity_id": {
      "type": "string"
     },
     "token": {
      "type": "string"
     }
    },
    "required": [
     "continuity_id",
     "token"
    ],
    "type": "object"
   },
   "data_classification": {
    "default": "PUBLIC",
    "enum": [
     "PUBLIC",
     "NON_PERSONAL_PUBLIC"
    ],
    "type": "string"
   },
   "episode_id": {
    "type": "string"
   },
   "evidence_items": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "independent_operator_id": {
    "type": "string"
   },
   "question": {
    "type": "string"
   },
   "synthetic": {
    "type": "boolean"
   }
  },
  "required": [
   "question",
   "evidence_items"
  ],
  "type": "object"
 },
 "name": "evaluate_public_art_evidence",
 "title": "Check public art evidence"
}
