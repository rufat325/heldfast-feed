{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Start a recurring research series"
 },
 "description": "Creates a research program that fields the SAME instrument on a schedule \u2014 brand tracking, a weekly pulse \u2014 each wave an ordinary study. The questions freeze once the first wave fields (that's the trendline), so get them right with the user first. Optionally bind a Ledger metric + score rule so every wave posts a reading (a `scorer` needs a `metricId`). Waves launch on schedule, or on demand with prism_series_launch_wave. May return `needs_confirmation`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adaptiveFollowUps": {
    "description": "AI follow-up questions on curious answers (default true).",
    "type": "boolean"
   },
   "approvalId": {
    "description": "Approval id from a prior needs_confirmation envelope.",
    "type": "string"
   },
   "autoAnalyzeTarget": {
    "anyOf": [
     {
      "maximum": 1000,
      "minimum": 2,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Analyze each wave automatically at this many completes."
   },
   "dayOfWeek": {
    "anyOf": [
     {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Weekly only: 0 = Sunday \u2026 6 = Saturday."
   },
   "interval": {
    "description": "daily or weekly.",
    "enum": [
     "daily",
     "weekly"
    ],
    "type": "string"
   },
   "metricId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Ledger metric the waves post readings to (from ledger_metrics_list)."
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "questions": {
    "description": "The instrument: an ordered list of questions ({ type, prompt, options?, \u2026 } \u2014 read an existing study with prism_studies_get for the shape).",
    "items": {
     "additionalProperties": {},
     "properties": {
      "allowOther": {
       "type": "boolean"
      },
      "anchorLast": {
       "maximum": 5,
       "minimum": 1,
       "type": "integer"
      },
      "contextImageUrl": {
       "maxLength": 1000,
       "type": "string"
      },
      "contextText": {
       "maxLength": 2000,
       "type": "string"
      },
      "exclusiveLast": {
       "type": "boolean"
      },
      "highLabel": {
       "type": "string"
      },
      "kanoRole": {
       "enum": [
        "functional",
        "dysfunctional"
       ],
       "type": "string"
      },
      "loopId": {
       "maxLength": 40,
       "type": "string"
      },
      "loopItem": {
       "maxLength": 200,
       "type": "string"
      },
      "loopPresentation": {
       "enum": [
        "paged",
        "grid"
       ],
       "type": "string"
      },
      "loopRotate": {
       "type": "boolean"
      },
      "lowLabel": {
       "type": "string"
      },
      "maxSelections": {
       "maximum": 20,
       "minimum": 1,
       "type": "integer"
      },
      "maxdiffId": {
       "maxLength": 40,
       "type": "string"
      },
      "numberMax": {
       "type": "number"
      },
      "numberMin": {
       "type": "number"
      },
      "options": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "otherLabel": {
       "maxLength": 60,
       "type": "string"
      },
      "placeholder": {
       "type": "string"
      },
      "prefix": {
       "type": "string"
      },
      "probe": {
       "maxLength": 500,
       "type": "string"
      },
      "prompt": {
       "type": "string"
      },
      "qid": {
       "maxLength": 40,
       "type": "string"
      },
      "rotate": {
       "type": "boolean"
      },
      "scaleMax": {
       "maximum": 20,
       "minimum": 2,
       "type": "integer"
      },
      "scaleMin": {
       "maximum": 10,
       "minimum": 0,
       "type": "integer"
      },
      "screenOutOptions": {
       "items": {
        "maxLength": 200,
        "type": "string"
       },
       "maxItems": 10,
       "type": "array"
      },
      "showIf": {
       "properties": {
        "anyOf": {
         "items": {
          "maxLength": 200,
          "type": "string"
         },
         "maxItems": 20,
         "type": "array"
        },
        "gte": {
         "type": "number"
        },
        "lte": {
         "type": "number"
        },
        "qid": {
         "maxLength": 40,
         "type": "string"
        }
       },
       "required": [
        "qid"
       ],
       "type": "object"
      },
      "susIndex": {
       "maximum": 10,
       "minimum": 1,
       "type": "integer"
      },
      "type": {
       "enum": [
        "word",
        "text",
        "choice",
        "multi",
        "rank",
        "maxdiff",
        "scale",
        "number",
        "completion"
       ],
       "type": "string"
      },
      "vwRole": {
       "enum": [
        "too_cheap",
        "cheap",
        "expensive",
        "too_expensive"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "maxItems": 40,
    "minItems": 1,
    "type": "array"
   },
   "scheduleTime": {
    "description": "HH:MM local to scheduleTimezone (default 09:00).",
    "type": "string"
   },
   "scheduleTimezone": {
    "description": "IANA zone (default UTC).",
    "type": "string"
   },
   "scorer": {
    "anyOf": [
     {
      "properties": {
       "kind": {
        "enum": [
         "scale_mean",
         "nps",
         "top_2_box",
         "choice_share"
        ],
        "type": "string"
       },
       "minN": {
        "default": 5,
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
       },
       "option": {
        "maxLength": 200,
        "type": "string"
       },
       "questionIndex": {
        "maximum": 39,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "kind",
       "questionIndex"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "How a wave becomes one number: { kind, questionIndex, option?, minN? }."
   },
   "workspace": {
    "description": "Workspace slug. Personal tokens with no default workspace MUST pass this; tokens with a default can override per call. Ignored for workspace API keys.",
    "type": "string"
   }
  },
  "required": [
   "name",
   "questions",
   "interval"
  ],
  "type": "object"
 },
 "name": "prism_series_create",
 "title": "Start a recurring research series"
}
