{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "classroom:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set class assignment defaults"
 },
 "description": "Sets a class's assignment defaults (scoring mode, timer, attempts, result release, notifications) so new assignments for that class start with them. Replaces the previous defaults and returns them for undo.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "classId": {
    "description": "Class id from list_classes.",
    "pattern": "^[a-f\\d]{24}$",
    "type": "string"
   },
   "defaults": {
    "additionalProperties": false,
    "description": "The class's new defaults; unset fields fall back to Fiveable's.",
    "properties": {
     "durationMinutes": {
      "anyOf": [
       {
        "maximum": 300,
        "minimum": 1,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "maxAttempts": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
     },
     "notifications": {
      "additionalProperties": false,
      "properties": {
       "dueReminder": {
        "type": "boolean"
       },
       "onPublish": {
        "type": "boolean"
       },
       "onResultsRelease": {
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "resultRelease": {
      "description": "When students see results.",
      "enum": [
       "immediate",
       "manual",
       "scheduled"
      ],
      "type": "string"
     },
     "scoringMode": {
      "description": "Who scores free responses.",
      "enum": [
       "ai",
       "self",
       "teacher"
      ],
      "type": "string"
     },
     "timerMode": {
      "enum": [
       "strict",
       "flexible",
       "none"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "classId",
   "defaults"
  ],
  "type": "object"
 },
 "name": "set_class_assignment_defaults",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "classroom:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Set class assignment defaults"
}
