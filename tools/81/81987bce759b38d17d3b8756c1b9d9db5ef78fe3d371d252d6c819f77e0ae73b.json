 "description": "Score social-post sentiment for a cashtag using a deterministic lexicon. Returns score (-1..1), positive/negative/neutral percentages, and example posts. Use this to score posts you have already collected; it fetches nothing itself, so pass the posts in.",
 "inputSchema": {
  "properties": {
   "posts": {
    "description": "Array of post objects. Each must have a text field; id, ts, and author are optional.",
    "items": {
     "properties": {
      "author": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "ts": {
       "type": "string"
      }
     },
     "required": [
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "posts"
  ],
  "type": "object"
 },
 "name": "social_cashtag_sentiment",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "description": "Number of posts scored",
    "type": "integer"
   },
   "examples": {
    "additionalProperties": true,
    "properties": {
     "neg": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "pos": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "pos",
     "neg"
    ],
    "type": "object"
   },
   "negPct": {
    "description": "Percentage of negative posts (0\u2013100)",
    "type": "number"
   },
   "neuPct": {
    "description": "Percentage of neutral posts (0\u2013100)",
    "type": "number"
   },
   "posPct": {
    "description": "Percentage of positive posts (0\u2013100)",
    "type": "number"
   },
   "score": {
    "description": "Net sentiment, -1 (bearish) to 1 (bullish)",
    "type": "number"
   }
  },
  "required": [
   "score",
   "posPct",
   "negPct",
   "neuPct",
   "count",
   "examples"
  ],
  "type": "object"
 },
