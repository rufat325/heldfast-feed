{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new habit. Tracking types: check (daily toggle), count (hit a number), duration (minutes), times_per_week (weekly frequency).",
 "inputSchema": {
  "properties": {
   "color": {
    "description": "Color as #rrggbb, e.g. #10AC84",
    "type": "string"
   },
   "icon": {
    "description": "Lucide icon name (lowercase, dashes), e.g. book-open",
    "type": "string"
   },
   "name": {
    "description": "Habit name",
    "type": "string"
   },
   "target_duration": {
    "description": "Target duration in minutes (for duration type, 5-480)",
    "type": "integer"
   },
   "target_value": {
    "description": "Target count value (for count type)",
    "type": "integer"
   },
   "time_of_day": {
    "description": "When during the day",
    "enum": [
     "morning",
     "afternoon",
     "evening"
    ],
    "type": "string"
   },
   "times_per_week": {
    "description": "Times per week target (for times_per_week type, 1-7)",
    "type": "integer"
   },
   "tracking_type": {
    "description": "Tracking type (default: check)",
    "enum": [
     "check",
     "count",
     "duration",
     "times_per_week"
    ],
    "type": "string"
   },
   "unit": {
    "description": "Unit label (e.g., \"pages\", \"glasses\")",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_habit",
 "title": "Create habit"
}
