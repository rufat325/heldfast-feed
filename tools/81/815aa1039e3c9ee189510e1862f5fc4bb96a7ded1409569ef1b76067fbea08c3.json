{
 "description": "Approve the compiled prompt. Returns the final optimized prompt ready for use.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "session_id": {
    "description": "Session ID from optimize_prompt",
    "pattern": "^[a-zA-Z0-9-]+$",
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "approve_prompt"
}
