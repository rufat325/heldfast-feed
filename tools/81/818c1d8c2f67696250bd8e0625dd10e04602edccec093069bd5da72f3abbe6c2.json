{
 "_meta": {
  "fastmcp": {
   "tags": []
  },
  "ui": {
   "resourceUri": "ui://shorti/arena@1"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "The arena's open spots, first recorded takes, later breakouts and entrant standings. view='spots': open spots with their words, dates and how to shoot; 'board': first recorded takes and finds; 'entrant': one opted-in entrant's standing. kind filters by move, vary, mix, about or found. Counts name their denominators; keyless reads show the first 50. Unread: not_run, never an empty board.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "entrant": {
    "anyOf": [
     {
      "pattern": "^ae_[a-z2-7]{16}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "kind": {
    "anyOf": [
     {
      "enum": [
       "move",
       "vary",
       "mix",
       "about",
       "found"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "lang": {
    "default": "ko",
    "enum": [
     "ko",
     "en"
    ],
    "type": "string"
   },
   "lineage": {
    "anyOf": [
     {
      "pattern": "^lin_[A-Za-z0-9_.-]{1,156}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "view": {
    "enum": [
     "spots",
     "board",
     "entrant"
    ],
    "type": "string"
   }
  },
  "required": [
   "view"
  ],
  "type": "object"
 },
 "name": "shorti_arena",
 "outputSchema": {
  "properties": {
   "arena_view": {
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Read Shorti's arena"
}
