{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List products"
 },
 "description": "List products in the merchant's catalog with optional filters. Useful for 'show me products that haven't been enriched yet' or 'find products with the lowest scores'. Returns up to 50 per call.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "enrichmentStatus": {
    "description": "Filter by enrichment status",
    "enum": [
     "PENDING",
     "COMPLETED",
     "FAILED",
     "RUNNING"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Match against title/vendor/type",
    "type": "string"
   },
   "sortBy": {
    "default": "updated_desc",
    "enum": [
     "score_asc",
     "score_desc",
     "updated_desc"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_products",
 "title": "List products"
}
