{
 "description": "Fetch market price history for a single market. Two modes: raw (per-trade points) and OHLC candles (1m/5m/1h/1d). Optional from/to time range, includeVolume flag, and limit (1-500).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "ISO 8601 start time (inclusive).",
    "type": "string"
   },
   "includeVolume": {
    "description": "Include volume data in response.",
    "type": "boolean"
   },
   "interval": {
    "description": "Mode: raw (trade points) or OHLC bucket size. Default: raw.",
    "enum": [
     "raw",
     "1m",
     "5m",
     "1h",
     "1d"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Number of data points (1-500, default 200).",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "marketAddress": {
    "description": "Market contract address.",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "to": {
    "description": "ISO 8601 end time (inclusive).",
    "type": "string"
   }
  },
  "required": [
   "marketAddress"
  ],
  "type": "object"
 },
 "name": "get_market_history"
}
