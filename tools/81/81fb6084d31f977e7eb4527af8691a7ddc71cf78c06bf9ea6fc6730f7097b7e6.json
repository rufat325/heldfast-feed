{
 "description": "Find ranked keywords for a domain, subdomain, or URL and prioritize refresh opportunities.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "include_lost": {
    "default": false,
    "type": "boolean"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 250,
    "minimum": 10,
    "type": "integer"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "location_code": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "max_rank": {
    "default": 100,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_search_volume": {
    "default": 0,
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "sort_by": {
    "default": "opportunity",
    "enum": [
     "opportunity",
     "estimated_traffic",
     "rank",
     "search_volume",
     "cpc"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "agentseo_domain_ranked_keywords",
 "title": "AgentSEO Domain Ranked Keywords"
}
