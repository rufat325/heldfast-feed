{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Normalize local Apple Health export sleep, workout and activity data into the shared wellness_context shape for recommendation engines.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "description": "YYYY-MM-DD local date. Defaults to today in the configured timezone.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "injury_flags": {
    "default": [],
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "notes": {
    "maxLength": 500,
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "soreness": {
    "default": [],
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "timezone": {
    "description": "IANA timezone, e.g. America/Fortaleza. Defaults to APPLE_HEALTH_TIMEZONE or UTC.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "apple_health_wellness_context",
 "title": "Apple Health Wellness Context"
}
