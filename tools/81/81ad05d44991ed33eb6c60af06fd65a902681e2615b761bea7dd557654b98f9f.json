{
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm_apply": {
    "type": "boolean"
   },
   "desired_records": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "minLength": 1,
       "type": "string"
      },
      "notes": {
       "type": "string"
      },
      "prio": {
       "minimum": 0,
       "type": "integer"
      },
      "subdomain": {
       "type": "string"
      },
      "ttl": {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "type": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "type",
      "content"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "domain": {
    "minLength": 1,
    "type": "string"
   },
   "max_changes": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "mode": {
    "enum": [
     "plan",
     "apply"
    ],
    "type": "string"
   },
   "strategy": {
    "enum": [
     "merge",
     "replace"
    ],
    "type": "string"
   }
  },
  "required": [
   "domain",
   "desired_records"
  ],
  "type": "object"
 },
 "name": "dns_batch_apply"
}
