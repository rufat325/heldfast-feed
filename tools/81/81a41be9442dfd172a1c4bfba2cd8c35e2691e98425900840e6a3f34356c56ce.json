{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Watchlist Diff"
 },
 "description": "Show what changed on a saved tracking list versus its captured baseline \u2014 new sellers observed on the tracked ASINs and sourcing-score moves. Each changed ASIN also carries product identity (brand, title, price or price range) and fulfillment (FBA/FBM/AMZ with amz/fba share). Use when the user asks 'what changed on <list>', 'any updates on my watchlist', 'new sellers on the ASINs I track'. Re-run watchlist_add to reset the baseline to the current state.",
 "inputSchema": {
  "properties": {
   "asin": {
    "description": "Only the change row for this exact ASIN.",
    "type": "string"
   },
   "asin_contains": {
    "type": "string"
   },
   "fulfillment_in": {
    "description": "Comma-separated FBA/FBM/AMZ to keep.",
    "type": "string"
   },
   "list_type": {
    "default": "asin",
    "description": "Defaults to asin.",
    "enum": [
     "asin",
     "brand",
     "seller",
     "niche"
    ],
    "type": "string"
   },
   "max_current_score": {
    "type": "number"
   },
   "max_current_seller_count": {
    "type": "number"
   },
   "max_dropped_sellers": {
    "type": "number"
   },
   "max_fulfillment_amz_dom_pct": {
    "type": "number"
   },
   "max_fulfillment_fba_pen_pct": {
    "type": "number"
   },
   "max_new_sellers": {
    "type": "number"
   },
   "max_price": {
    "type": "number"
   },
   "max_score_delta": {
    "type": "number"
   },
   "min_current_score": {
    "type": "number"
   },
   "min_current_seller_count": {
    "type": "number"
   },
   "min_dropped_sellers": {
    "type": "number"
   },
   "min_fulfillment_amz_dom_pct": {
    "type": "number"
   },
   "min_fulfillment_fba_pen_pct": {
    "type": "number"
   },
   "min_new_sellers": {
    "description": "Only ASINs that gained at least this many new sellers.",
    "type": "number"
   },
   "min_price": {
    "type": "number"
   },
   "min_score_delta": {
    "type": "number"
   },
   "name": {
    "description": "The list name to diff.",
    "type": "string"
   },
   "product_brand": {
    "description": "Exact product brand (case-insensitive).",
    "type": "string"
   },
   "product_brand_contains": {
    "type": "string"
   },
   "product_title_contains": {
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "watchlist_diff"
}
