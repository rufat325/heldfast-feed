{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the customer's billable services (VPS, hosting, dedicated, domains) \u2014 each with its service id, product name, status, billing cycle and next due date. Use this to find the numeric service_id for the impreza_vps_* tools. Optional status filter.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "status": {
    "description": "Filter by service status (e.g. Active, Suspended, Terminated).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "impreza_list_services",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "services": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "type": "number"
        },
        "billing_cycle": {
         "type": [
          "string",
          "null"
         ]
        },
        "dedicated_ip": {
         "type": [
          "string",
          "null"
         ]
        },
        "domain": {
         "type": [
          "string",
          "null"
         ]
        },
        "id": {
         "type": "integer"
        },
        "is_dedicated": {
         "type": "boolean"
        },
        "next_due": {
         "type": [
          "string",
          "null"
         ]
        },
        "platform": {
         "type": [
          "object",
          "null"
         ]
        },
        "product": {
         "type": [
          "string",
          "null"
         ]
        },
        "product_group": {
         "type": [
          "string",
          "null"
         ]
        },
        "registered_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "type": "string"
        },
        "vps_backend": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "domain",
        "status",
        "product",
        "product_group",
        "billing_cycle",
        "amount",
        "dedicated_ip",
        "registered_at",
        "next_due",
        "vps_backend",
        "is_dedicated",
        "platform"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "services",
     "total"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "List services"
}
