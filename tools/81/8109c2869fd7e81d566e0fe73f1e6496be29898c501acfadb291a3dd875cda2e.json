{
 "description": "C\u1eadp nh\u1eadt t\u00ean, ng\u01b0\u1eddi nh\u1eadn, s\u1ef1 ki\u1ec7n, VA ho\u1eb7c tr\u1ea1ng th\u00e1i b\u1eadt/t\u1eaft c\u1ee7a c\u1ea5u h\u00ecnh email. Ng\u01b0\u1eddi nh\u1eadn m\u1edbi ph\u1ea3i x\u00e1c minh tr\u01b0\u1edbc khi c\u1ea5u h\u00ecnh ho\u1ea1t \u0111\u1ed9ng. / Update an email config; new recipients must be verified before activation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "config_id": {
    "description": "UUID c\u1ea5u h\u00ecnh email",
    "minLength": 8,
    "type": "string"
   },
   "events": {
    "items": {
     "enum": [
      "TRANSACTION_IN",
      "WEBHOOK_FAILED",
      "VA_CREATED"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "is_active": {
    "type": "boolean"
   },
   "name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "recipients": {
    "items": {
     "format": "email",
     "maxLength": 320,
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "virtual_account_id": {
    "anyOf": [
     {
      "minLength": 8,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "UUID VA; null \u0111\u1ec3 b\u1ecf gi\u1edbi h\u1ea1n VA"
   }
  },
  "required": [
   "config_id"
  ],
  "type": "object"
 },
 "name": "monapay_update_email_config",
 "title": "S\u1eeda c\u1ea5u h\u00ecnh th\u00f4ng b\u00e1o email"
}
