{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Searches Berlin neighborhoods (LOR Planungsr\u00e4ume) by name.\n\nParameters:\n- q (required): search term (min. 3 characters)\n- limit: max. results (default: 25)\n- bezirk_id/ortsteil_id: optional filters to narrow the search\n\nExample: q=\"Kollwitz\" finds the \"Kollwitzplatz\" neighborhood",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bezirk_id": {
    "pattern": "^\\d{2}$",
    "type": "string"
   },
   "bezirke": {
    "default": "false",
    "enum": [
     "true",
     "false"
    ],
    "type": "string"
   },
   "include": {
    "type": "string"
   },
   "limit": {
    "description": "Maximale Anzahl Ergebnisse (\u00f6ffentlich bis 1000)",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "ortsteil_id": {
    "pattern": "^\\d{4}$",
    "type": "string"
   },
   "ortsteile": {
    "default": "false",
    "enum": [
     "true",
     "false"
    ],
    "type": "string"
   },
   "q": {
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "berlin_neighborhood_search",
 "title": "Neighborhood Search"
}
