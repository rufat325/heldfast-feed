{
 "description": "Gestiona posts del timeline. Acciones: list (page, limit, user_id), create, update (id), delete (id), like (id).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "create",
     "update",
     "delete",
     "like"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "files": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "ID del post",
    "type": "number"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "share_with": {
    "type": "string"
   },
   "user_id": {
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "timeline"
}
