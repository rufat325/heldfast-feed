{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List comment threads. Use this tool to list comment threads.",
 "inputSchema": {
  "properties": {
   "all_threads_related_to_channel_id": {
    "description": "Returns the comment threads of all videos of the channel and the channel comments as well",
    "type": "string"
   },
   "channel_id": {
    "description": "Channel id of the video owner",
    "type": "string"
   },
   "ids": {
    "description": "IDs of the comment threads",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "max_results": {
    "default": 5,
    "description": "The maximum number of items that should be returned, 0 for no limit",
    "minimum": 0,
    "type": "number"
   },
   "moderation_status": {
    "default": "published",
    "description": "published|heldForReview|likelySpam|rejected",
    "enum": [
     "published",
     "heldForReview",
     "likelySpam",
     "rejected"
    ],
    "type": "string"
   },
   "order": {
    "default": "time",
    "description": "orderUnspecified|time|relevance",
    "enum": [
     "orderUnspecified",
     "time",
     "relevance"
    ],
    "type": "string"
   },
   "output": {
    "default": "yaml",
    "description": "json|yaml|table",
    "enum": [
     "json",
     "yaml",
     "table"
    ],
    "type": "string"
   },
   "parts": {
    "default": [
     "id",
     "snippet"
    ],
    "description": "Comma separated parts",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "search_terms": {
    "description": "Search terms",
    "type": "string"
   },
   "text_format": {
    "default": "html",
    "description": "textFormatUnspecified|html",
    "enum": [
     "textFormatUnspecified",
     "html"
    ],
    "type": "string"
   },
   "video_id": {
    "description": "Returns the comment threads of the specified video",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "commentThread-list",
 "title": "List comment threads"
}
