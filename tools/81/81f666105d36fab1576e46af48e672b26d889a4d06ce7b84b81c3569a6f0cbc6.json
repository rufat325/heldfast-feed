{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return the reviewed answers to one question for several objects side by side (for example the minimum investment of several programmes, or a tax rate in several countries), each with its official quotations. Objects not covered are listed in missing \u2014 never guessed.",
 "inputSchema": {
  "properties": {
   "locale": {
    "description": "Answer language; Russian when omitted.",
    "enum": [
     "ru",
     "en"
    ],
    "type": "string"
   },
   "objects": {
    "description": "Object codes or names.",
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "question": {
    "description": "A question code or a natural-language question.",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "question",
   "objects"
  ],
  "type": "object"
 },
 "name": "answer_compare",
 "outputSchema": {
  "properties": {
   "missing": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "question": {
    "anyOf": [
     {
      "properties": {
       "code": {
        "type": "string"
       },
       "text": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "text"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "revision": {
    "type": "string"
   },
   "rows": {
    "items": {
     "properties": {
      "answers": {
       "items": {
        "properties": {
         "caveat": {
          "type": [
           "string",
           "null"
          ]
         },
         "conditions": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "sources": {
          "items": {
           "properties": {
            "date": {
             "description": "Snapshot date of the stored source copy, else the date the quote was checked in it.",
             "type": "string"
            },
            "quote": {
             "description": "Verbatim text of the official source.",
             "type": "string"
            },
            "title": {
             "type": "string"
            },
            "url": {
             "type": "string"
            }
           },
           "required": [
            "quote",
            "url",
            "title",
            "date"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "statement": {
          "type": "string"
         }
        },
        "required": [
         "statement",
         "caveat",
         "conditions",
         "sources"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "object": {
       "properties": {
        "code": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "type": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "name",
        "type"
       ],
       "type": "object"
      },
      "provenance": {
       "description": "Origin of one record: stable id, clean canonical URL, publisher, the exact published revision served, a ready citation, primary sources and review status.",
       "properties": {
        "canonical_url": {
         "description": "Published location without tracking parameters.",
         "format": "uri",
         "type": "string"
        },
        "cite_as": {
         "type": "string"
        },
        "contract": {
         "const": "wiki-provenance/1",
         "type": "string"
        },
        "id": {
         "description": "<locale>:<slug> for an article, <dataset>:<record id> for a dataset row.",
         "type": "string"
        },
        "primary_sources": {
         "items": {
          "properties": {
           "name": {
            "type": "string"
           },
           "url": {
            "type": [
             "string",
             "null"
            ]
           }
          },
          "required": [
           "name",
           "url"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "publisher": {
         "properties": {
          "name": {
           "type": "string"
          },
          "url": {
           "format": "uri",
           "type": "string"
          }
         },
         "required": [
          "name",
          "url"
         ],
         "type": "object"
        },
        "verification_status": {
         "enum": [
          "verified",
          "pending",
          "unknown"
         ],
         "type": "string"
        },
        "version": {
         "description": "Revision of exactly the material served: for an article the snapshot content hash (the HTML ETag value); for a dataset record the dataset revision it was published in, not the published filename. Null when unknown.",
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "contract",
        "id",
        "canonical_url",
        "publisher",
        "version",
        "cite_as",
        "primary_sources",
        "verification_status"
       ],
       "type": "object"
      },
      "question": {
       "properties": {
        "code": {
         "type": "string"
        },
        "text": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "text"
       ],
       "type": "object"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "object",
      "question",
      "answers",
      "url",
      "provenance"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "question",
   "rows",
   "missing",
   "revision"
  ],
  "type": "object"
 },
 "title": "Compare reviewed answers across places"
}
