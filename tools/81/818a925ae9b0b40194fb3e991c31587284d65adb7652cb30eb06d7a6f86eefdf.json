{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a reservation"
 },
 "description": "Update an existing reservation's times, guest contact, notes, guest counts, language, or price / prepayment / deposit amounts and paid status. Only the fields you pass are sent. Dates and property cannot be changed here. Smoobu: PUT /api/reservations/{reservationId}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "adults": {
    "description": "Number of adults.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "arrival_time": {
    "description": "Arrival time (HH:mm, 24h).",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "assistant_notice": {
    "description": "Instructions for your assistant / cleaner.",
    "type": "string"
   },
   "children": {
    "description": "Number of children.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "departure_time": {
    "description": "Departure time (HH:mm, 24h).",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "deposit": {
    "description": "Deposit amount.",
    "type": "number"
   },
   "deposit_status": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     }
    ],
    "description": "Deposit status: 0 = open / not paid, 1 = paid in full."
   },
   "guest_email": {
    "description": "Guest email.",
    "type": "string"
   },
   "guest_name": {
    "description": "Guest name.",
    "type": "string"
   },
   "guest_phone": {
    "description": "Guest phone.",
    "type": "string"
   },
   "language": {
    "description": "Guest language, e.g. en, de, es.",
    "type": "string"
   },
   "notice": {
    "description": "Free-text notes on the booking.",
    "type": "string"
   },
   "prepayment": {
    "description": "Prepayment amount.",
    "type": "number"
   },
   "prepayment_status": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     }
    ],
    "description": "Prepayment status: 0 = open / not paid, 1 = paid in full."
   },
   "price": {
    "description": "Total price.",
    "type": "number"
   },
   "price_status": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     }
    ],
    "description": "Price status: 0 = open / not paid, 1 = paid in full."
   },
   "reservation_id": {
    "description": "The reservation (booking) id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "reservation_id"
  ],
  "type": "object"
 },
 "name": "smoobu_update_reservation",
 "title": "Update a reservation"
}
