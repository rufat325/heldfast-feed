{
 "description": "Create a new native ad template with HTML and variable placeholders",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Template name",
    "type": "string"
   },
   "raw_html": {
    "description": "HTML template content with variable placeholders (e.g. \"[%title%]\")",
    "type": "string"
   },
   "variables": {
    "description": "Array of template variables",
    "items": {
     "additionalProperties": false,
     "properties": {
      "dropdown_values": {
       "description": "Comma-separated options for dropdown variables",
       "type": "string"
      },
      "max_length": {
       "description": "Max length for text variables",
       "type": "number"
      },
      "name": {
       "description": "Variable name",
       "type": "string"
      },
      "optional": {
       "description": "Whether the variable can be left blank (default: false)",
       "type": "boolean"
      },
      "placeholder": {
       "description": "Placeholder in raw_html (e.g. \"[%title%]\")",
       "type": "string"
      },
      "type": {
       "description": "Variable type",
       "enum": [
        "url",
        "url_raw",
        "text",
        "file",
        "number",
        "image_url",
        "dropdown",
        "third_party_script"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "placeholder",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "raw_html",
   "variables"
  ],
  "type": "object"
 },
 "name": "create_native_template"
}
