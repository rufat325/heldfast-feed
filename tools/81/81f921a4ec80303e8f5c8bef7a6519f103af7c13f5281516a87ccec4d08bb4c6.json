     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "notFound": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "services": {
    "type": "number"
   },
   "url": {
    "description": "The dashboard in the app",
    "type": "string"
   }
  },
  "required": [
