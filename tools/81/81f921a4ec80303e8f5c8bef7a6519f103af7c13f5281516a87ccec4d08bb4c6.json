  "title": "Create a dashboard"
 },
 "description": "Makes a dashboard with a name and, optionally, services by slug (search_services finds them), within the plan\u2019s dashboards and services. Answers with its address.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "name": {
    "description": "The dashboard\u2019s name, e.g. \"Checkout\"",
    "type": "string"
   },
   "services": {
    "description": "Slugs to start with, e.g. [\"stripe\", \"shopify\"]",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_dashboard",
 "outputSchema": {
