{
 "description": "Add followers (users) to a contact.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "contactId": {
    "description": "The contact ID to add followers to",
    "type": "string"
   },
   "followers": {
    "description": "Array of user IDs to add as followers",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "contactId",
   "followers"
  ],
  "type": "object"
 },
 "name": "crm_add_contact_followers"
}
