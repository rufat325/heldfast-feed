{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The general education categories and requirement codes (FSAW, DSHS, DVUP, ...) the UMD Schedule of Classes lists for a term. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "term_id": {
    "description": "Term to list for (default: the newest term)",
    "pattern": "^\\d{4}(01|05|08|12)$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "testudo_soc_list_gen_ed_categories",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "categories": {
    "description": "Categories in the order the site lists them",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Category name, e.g. \"Fundamental Studies\"",
       "type": "string"
      },
      "requirements": {
       "description": "Requirements in the category, with their codes",
       "items": {
        "additionalProperties": false,
        "properties": {
         "code": {
          "description": "General education code, e.g. \"FSAW\"",
          "type": "string"
         },
         "name": {
          "description": "Category and requirement, e.g. \"Fundamental Studies - Academic Writing\"",
          "type": "string"
         }
        },
        "required": [
         "code",
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "requirements"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "categories"
  ],
  "type": "object"
 },
 "title": "List gen-ed categories"
}
