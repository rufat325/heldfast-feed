{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Liquidations across every Hyperliquid market (or one market) over the last N minutes, totalled: count, notional, longs vs shorts liquidated, the top markets and the largest single liquidation. Use it for 'who got liquidated in the last hour?'. Keyless calls can look back 60 minutes, keyed calls up to 240.",
 "inputSchema": {
  "properties": {
   "market": {
    "description": "Optional market filter (e.g. \"BTC-PERP\")",
    "type": "string"
   },
   "minutes": {
    "description": "Lookback in minutes (default 60, max 240)",
    "type": "number"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_liquidation_summary",
 "outputSchema": {
  "description": "Liquidation totals over the window",
  "properties": {
   "by_market": {
    "description": "Top markets by liquidated notional",
    "items": {
     "description": "One market",
     "properties": {
      "count": {
       "description": "Liquidations"
      },
      "market": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "notional_usd": {
       "description": "Notional in USD"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "complete": {
    "description": "False when the page cap was hit and totals are a lower bound"
   },
   "count": {
    "description": "Number of liquidations"
   },
   "from": {
    "description": "Window start, Unix milliseconds"
   },
   "largest": {
    "description": "Largest single liquidation, or null when there were none",
    "properties": {
     "address": {
      "description": "Wallet address (0x\u2026)"
     },
     "market": {
      "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
     },
     "notional_usd": {
      "description": "Notional in USD"
     },
     "price": {
      "description": "Price in USD"
     },
     "side": {
      "description": "\"long\" or \"short\""
     },
     "timestamp": {
      "description": "Unix milliseconds"
     }
    },
    "type": "object"
   },
   "longs_liquidated_usd": {
    "description": "Notional of liquidated longs in USD"
   },
   "market": {
    "description": "Market filter, or null for all markets"
   },
   "notional_usd": {
    "description": "Liquidated notional in USD"
   },
   "shorts_liquidated_usd": {
    "description": "Notional of liquidated shorts in USD"
   },
   "to": {
    "description": "Window end, Unix milliseconds"
   }
  },
  "type": "object"
 }
}
