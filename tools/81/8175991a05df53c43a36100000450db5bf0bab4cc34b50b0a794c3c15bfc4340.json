  "additionalProperties": false,
  "properties": {
   "contactEmail": {
    "description": "Contact email",
    "format": "email",
    "type": "string"
   },
   "description": {
    "description": "Detailed description",
    "type": "string"
   },
   "orderId": {
    "description": "Order ID this ticket is about",
    "type": "string"
   },
   "reason": {
    "description": "Reason for the ticket",
    "type": "string"
   },
   "suggestedSolution": {
    "description": "Your proposed solution",
    "type": "string"
   },
   "ticketId": {
    "description": "Unique ticket ID",
    "type": [
