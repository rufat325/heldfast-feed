{
 "description": "Add a new node to the map. Returns the new node id.",
 "inputSchema": {
  "properties": {
   "ip": {
    "description": "IP address (optional)",
    "type": "string"
   },
   "name": {
    "description": "Display name",
    "type": "string"
   },
   "type": {
    "description": "Node type",
    "enum": [
     "server",
     "router",
     "switch",
     "firewall",
     "domain",
     "project",
     "service",
     "pc",
     "nas",
     "ap",
     "camera",
     "printer",
     "other"
    ],
    "type": "string"
   },
   "x": {
    "description": "Canvas X position (optional)",
    "type": "number"
   },
   "y": {
    "description": "Canvas Y position (optional)",
    "type": "number"
   }
  },
  "required": [
   "type",
   "name"
  ],
  "type": "object"
 },
 "name": "map_add_node"
}
