{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Overall and per-node health of the upstream XRPL nodes. When to use: To decide whether to trust or retry data, or to explain a 503 from another endpoint. Prefer another tool: Not a probe of your own connectivity; it reports the service's upstream nodes. Example: xrpl_network_health {}",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {},
  "type": "object"
 },
 "name": "xrpl_network_health",
 "outputSchema": {
  "$defs": {
   "Meta": {
    "additionalProperties": false,
    "properties": {
     "age_seconds": {
      "description": "Age of the data at response time",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "as_of": {
      "description": "When the data was read from the ledger",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
     },
     "cache": {
      "enum": [
       "hit",
       "miss",
       "stale"
      ],
      "type": "string"
     },
     "ledger_index": {
      "description": "Validated ledger the data comes from",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "stale": {
      "description": "True when served past its fresh TTL (stale-on-error)",
      "type": "boolean"
     }
    },
    "required": [
     "ledger_index",
     "as_of",
     "age_seconds",
     "cache",
     "stale"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "last_probe_at": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "ledger_index": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "meta": {
    "$ref": "#/$defs/Meta"
   },
   "nodes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "error": {
       "type": [
        "string",
        "null"
       ]
      },
      "latency_ms": {
       "type": [
        "number",
        "null"
       ]
      },
      "ledger_age_s": {
       "type": [
        "number",
        "null"
       ]
      },
      "ledger_index": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "load_factor": {
       "type": [
        "number",
        "null"
       ]
      },
      "member": {
       "type": "string"
      },
      "sampled_at": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
       "type": "string"
      },
      "state": {
       "enum": [
        "up",
        "down"
       ],
       "type": "string"
      }
     },
     "required": [
      "member",
      "state",
      "latency_ms",
      "ledger_index",
      "ledger_age_s",
      "load_factor",
      "error",
      "sampled_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "ok",
     "degraded",
     "down",
     "unknown"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "nodes",
   "ledger_index",
   "last_probe_at",
   "meta"
  ],
  "type": "object"
 },
 "title": "Network health"
}
