{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an RSS/Atom/editorial feed scaffold with sanitized item rows, category maps, refresh policy, adapter source, and copyright/sanitization notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "rss_atom",
    "enum": [
     "rss_atom",
     "webhook_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9082/feed.xml",
    "type": "string"
   },
   "category_count": {
    "default": 6,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "feed_label": {
    "default": "editorial_feed",
    "type": "string"
   },
   "item_count": {
    "default": 24,
    "maximum": 1024,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "rss_feed_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the RSS scaffold.",
    "type": "string"
   },
   "refresh_interval_sec": {
    "default": 300,
    "maximum": 86400,
    "minimum": 5,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_rss_feed_bus",
 "title": "Connect RSS feed bus"
}
