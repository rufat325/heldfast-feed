{
 "description": "Get public reviews, optionally filtered to a specific experience. Paginated with total count.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "experience": {
    "description": "Filter by experience slug",
    "type": "string"
   },
   "limit": {
    "description": "Results per page (default: 20, max: 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number (default: 1)",
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_reviews"
}
