{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "List FreeAgent bills \u2014 money the company owes to suppliers (accounts payable). Use view='open_or_overdue' to see what is still to pay.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contact": {
    "description": "Only bills from this supplier",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/contacts\\/\\d+$",
    "type": "string"
   },
   "fromDate": {
    "description": "Earliest bill date YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Maximum bills to return (default 50, max 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "project": {
    "description": "Only bills allocated to this project",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/projects\\/\\d+$",
    "type": "string"
   },
   "toDate": {
    "description": "Latest bill date YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "view": {
    "default": "all",
    "description": "Which bills to return (default: all)",
    "enum": [
     "all",
     "open",
     "overdue",
     "open_or_overdue",
     "paid",
     "recurring"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "freeagent_list_bills"
}
