{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Full-text search across the vault, returning matching note paths. Optional filters (tag, frontmatter type/status) are combined with the query via Obsidian search operators.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max number of files to return.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "query": {
    "description": "Text to search for.",
    "type": "string"
   },
   "status": {
    "description": "Restrict to a frontmatter 'status' value.",
    "type": "string"
   },
   "tag": {
    "description": "Restrict to a tag (with or without leading #).",
    "type": "string"
   },
   "type": {
    "description": "Restrict to a frontmatter 'type' value.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vault_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Optional tool-specific structured result data."
   },
   "text": {
    "description": "Human-readable result text.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "title": "Search vault"
}
