     {
      "type": "null"
     }
    ],
    "default": null
   },
   "disclaimer": {
    "description": "Canonical compliance disclaimer (always present)",
    "type": "string"
   },
   "full_data": {
    "anyOf": [
     {
      "additionalProperties": true,
      "description": "`full_data` for get_position_detail \u2014 \uc2e4\uc751\ub2f5\uc5d0\uc11c \ucd94\ucd9c(2026-09-23).",
      "properties": {
