        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null
       },
       "position": {
        "additionalProperties": true,
        "type": "object"
       },
       "recent_decisions": {
        "items": {},
        "type": "array"
       },
       "recent_trades": {
