{
 "description": "Create prose-styleguide.config.yaml at sync root or project root using language defaults plus optional explicit overrides.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "language": {
    "description": "Primary writing language. Seeds language-specific defaults.",
    "enum": [
     "english_us",
     "english_uk",
     "english_au",
     "english_ca",
     "swedish",
     "norwegian",
     "danish",
     "finnish",
     "french",
     "italian",
     "russian",
     "portuguese_pt",
     "portuguese_br",
     "german",
     "dutch",
     "polish",
     "czech",
     "hungarian",
     "spanish",
     "irish",
     "japanese",
     "korean",
     "chinese_traditional",
     "chinese_simplified"
    ],
    "type": "string"
   },
   "overrides": {
    "description": "Optional overrides layered on top of language defaults.",
    "properties": {
     "abbreviation_periods": {
      "enum": [
       "with",
       "without"
      ],
      "type": "string"
     },
     "date_format": {
      "enum": [
       "mdy",
       "dmy"
      ],
      "type": "string"
     },
     "dialogue_tags": {
      "enum": [
       "minimal",
       "expressive"
      ],
      "type": "string"
     },
     "ellipsis_style": {
      "enum": [
       "three_periods",
       "ellipsis_char",
       "spaced"
      ],
      "type": "string"
     },
     "em_dash_spacing": {
      "enum": [
       "closed",
       "spaced"
      ],
      "type": "string"
     },
     "numbers": {
      "enum": [
       "spell_under_10",
       "spell_under_100",
       "always_spell",
       "numerals"
      ],
      "type": "string"
     },
     "oxford_comma": {
      "enum": [
       "yes",
       "no"
      ],
      "type": "string"
     },
     "pov": {
      "enum": [
       "first",
       "third_limited",
       "third_omniscient"
      ],
      "type": "string"
     },
     "quotation_style": {
      "enum": [
       "double",
       "single",
       "guillemets",
       "low9",
       "dialogue_dash_en",
       "dialogue_dash_em",
       "corner_brackets"
      ],
      "type": "string"
     },
     "quotation_style_nested": {
      "enum": [
       "double",
       "single",
       "guillemets_single",
       "low9_single",
       "corner_brackets_double"
      ],
      "type": "string"
     },
     "sentence_fragments": {
      "enum": [
       "disallow",
       "intentional"
      ],
      "type": "string"
     },
     "spelling": {
      "enum": [
       "uk",
       "us",
       "au",
       "ca"
      ],
      "type": "string"
     },
     "tense": {
      "type": "string"
     },
     "time_format": {
      "enum": [
       "12h",
       "24h"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "overwrite": {
    "description": "If true, replaces an existing config file at the target location.",
    "type": "boolean"
   },
   "project_id": {
    "description": "Project ID when writing project_root config (e.g. 'the-lamb' or 'universe-1/book-1').",
    "type": "string"
   },
   "scope": {
    "description": "Config write target scope. Defaults to project_root when project_id is supplied, otherwise sync_root.",
    "enum": [
     "sync_root",
     "project_root"
    ],
    "type": "string"
   },
   "voice_notes": {
    "description": "Optional freeform voice notes to include in config.",
    "type": "string"
   }
  },
  "required": [
   "language"
  ],
  "type": "object"
 },
 "name": "setup_prose_styleguide_config"
}
