{
 "annotations": {},
 "description": "Save code on a node for Dev Mode's Code panel. The whole team sees it. Code on a component shows on its instances. [] removes the code.",
 "inputSchema": {
  "properties": {
   "blocks": {
    "description": "One tab per block",
    "items": {
     "properties": {
      "code": {
       "description": "Code",
       "type": "string"
      },
      "language": {
       "description": "e.g. TYPESCRIPT, HTML, CSS, SWIFT, KOTLIN (default PLAINTEXT)",
       "type": "string"
      },
      "title": {
       "description": "Tab title (default 'Code')",
       "type": "string"
      }
     },
     "required": [
      "code"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nodeId": {
    "description": "Node ID",
    "type": "string"
   }
  },
  "required": [
   "nodeId",
   "blocks"
  ],
  "type": "object"
 },
 "name": "set_codegen_result"
}
