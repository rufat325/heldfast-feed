{
 "description": "Update a comment (approve, edit content, move, ...); only the given fields change",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "author": {
    "description": "User ID of the author (instead of author_name/author_email)",
    "type": "integer"
   },
   "author_email": {
    "description": "Author email",
    "type": "string"
   },
   "author_ip": {
    "description": "Author IP address (requires moderate_comments)",
    "type": "string"
   },
   "author_name": {
    "description": "Author display name",
    "type": "string"
   },
   "author_url": {
    "description": "Author website URL",
    "type": "string"
   },
   "author_user_agent": {
    "description": "Author user agent",
    "type": "string"
   },
   "content": {
    "description": "Comment content",
    "type": "string"
   },
   "date": {
    "description": "Date in the site timezone (ISO8601)",
    "type": "string"
   },
   "date_gmt": {
    "description": "Date in GMT (ISO8601)",
    "type": "string"
   },
   "id": {
    "description": "Comment ID",
    "type": "integer"
   },
   "meta": {
    "additionalProperties": {},
    "description": "Registered comment meta fields (show_in_rest) as key/value",
    "type": "object"
   },
   "parent": {
    "description": "Parent comment ID (for replies; 0 = top level)",
    "type": "integer"
   },
   "post": {
    "description": "Move the comment to this post ID",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "description": "New status",
    "enum": [
     "approve",
     "hold",
     "spam",
     "unspam",
     "trash",
     "untrash"
    ],
    "type": "string"
   }
  },
  "required": [
   "site",
   "id"
  ],
  "type": "object"
 },
 "name": "wp_update_comment"
}
