{
 "description": "Recommend a sample size for a control from its frequency, risk and population size, with a documented rationale.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "externalReliance": {
    "default": false,
    "type": "boolean"
   },
   "frequency": {
    "enum": [
     "annual",
     "quarterly",
     "monthly",
     "weekly",
     "daily",
     "per-transaction"
    ],
    "type": "string"
   },
   "populationSize": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "priorDeficiency": {
    "default": false,
    "type": "boolean"
   },
   "risk": {
    "default": "moderate",
    "enum": [
     "low",
     "moderate",
     "high"
    ],
    "type": "string"
   }
  },
  "required": [
   "frequency"
  ],
  "type": "object"
 },
 "name": "compute_sample_size",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capped": {
    "type": "boolean"
   },
   "effectiveRisk": {
    "type": "string"
   },
   "frequency": {
    "type": "string"
   },
   "populationSize": {
    "type": "number"
   },
   "rationale": {
    "type": "string"
   },
   "recommended": {
    "type": "number"
   },
   "requestedRisk": {
    "type": "string"
   }
  },
  "required": [
   "frequency",
   "requestedRisk",
   "effectiveRisk",
   "recommended",
   "capped",
   "rationale"
  ],
  "type": "object"
 },
 "title": "Compute a sample size"
}
