{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Every listed open model that fits on the given GPU(s), largest first, with the most faithful weight format that fits.",
 "inputSchema": {
  "properties": {
   "concurrent_requests": {
    "description": "Requests served at the same time, each with its own KV cache. Default 1.",
    "minimum": 1,
    "type": "integer"
   },
   "context": {
    "description": "Tokens per request (prompt + output). Default 8192.",
    "minimum": 1,
    "type": "integer"
   },
   "engine": {
    "description": "Serving engine. Default: vllm on data-center GPUs, llamacpp elsewhere.",
    "enum": [
     "vllm",
     "sglang",
     "trtllm",
     "llamacpp",
     "transformers"
    ],
    "type": "string"
   },
   "gpu": {
    "description": "GPU id or name, e.g. \"rtx-4090\".",
    "type": "string"
   },
   "gpu_count": {
    "description": "Default 1.",
    "minimum": 1,
    "type": "integer"
   },
   "kv_cache": {
    "description": "KV cache precision. Default bf16.",
    "enum": [
     "bf16",
     "fp8",
     "q8_0",
     "q4_0"
    ],
    "type": "string"
   },
   "weights": {
    "description": "Weight format. Default: the official checkpoint (native) or BF16.",
    "enum": [
     "native",
     "bf16",
     "fp8",
     "int8",
     "nvfp4",
     "mxfp4",
     "int4",
     "q8_0",
     "q6_k",
     "q5_k_m",
     "q4_k_m",
     "q3_k_m",
     "q2_k",
     "iq2_xxs",
     "fp32"
    ],
    "type": "string"
   }
  },
  "required": [
   "gpu"
  ],
  "type": "object"
 },
 "name": "models_that_fit",
 "title": "Which LLMs fit on this GPU?"
}
