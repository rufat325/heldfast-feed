{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false,
  "title": "Bates-number a PDF"
 },
 "description": "Stamp sequential Bates numbers ({prefix}{zero-padded n}) on every page. Runs entirely on this machine \u2014 the file is read and written locally and never sent anywhere.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "color": {
    "description": "Color as #RRGGBB (default #000000)",
    "type": "string"
   },
   "fontSize": {
    "description": "Font size in points (default 10)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "force": {
    "description": "Replace the output file if it already exists (default: refuse, so existing files are never silently clobbered)",
    "type": "boolean"
   },
   "input": {
    "description": "Path to the input PDF",
    "type": "string"
   },
   "output": {
    "description": "Path to write the numbered PDF",
    "type": "string"
   },
   "padWidth": {
    "description": "Zero-pad width (default 6)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "position": {
    "description": "Corner (default bottom-right)",
    "enum": [
     "bottom-right",
     "bottom-left",
     "top-right",
     "top-left"
    ],
    "type": "string"
   },
   "prefix": {
    "description": "Text before the number (default none)",
    "type": "string"
   },
   "startNumber": {
    "description": "First number (default 1)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "input",
   "output"
  ],
  "type": "object"
 },
 "name": "pdf_bates",
 "title": "Bates-number a PDF"
}
