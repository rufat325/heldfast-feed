{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hotelumo:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check room and housekeeping status"
 },
 "description": "Use this when someone asks which rooms are clean, dirty or inspected, or which are out of order or out of service. Returns each physical room's name or number, room type and hotel with its room and housekeeping status, 20 per page by default (no guest or occupant data). Not for which rooms are free on given dates.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hotelId": {
    "description": "Only this hotel (24 lowercase hexadecimal characters); every hotel when absent",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "limit": {
    "description": "Rooms per page, from 1 to 100; defaults to 20",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "offset": {
    "description": "Rooms to skip, from 0 to 10000; defaults to 0. For the next page pass offset + limit",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "roomTypeId": {
    "description": "Only this room type (24 lowercase hexadecimal characters)",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_rooms",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "description": "hasMore is true when another page exists; request it with offset + limit",
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "type": "integer"
     },
     "offset": {
      "maximum": 10000,
      "minimum": 0,
      "type": "integer"
     },
     "returned": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "limit",
     "offset",
     "returned",
     "hasMore"
    ],
    "type": "object"
   },
   "rooms": {
    "description": "Physical rooms sorted by name. Internal room ids, reservation, occupant, guest, access-control and channel data are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "hotelId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "housekeepingStatus": {
       "anyOf": [
        {
         "$ref": "#/properties/rooms/items/properties/name/anyOf/0"
        },
        {
         "type": "null"
        }
       ],
       "description": "CLEAN, DIRTY or INSPECTED"
      },
      "lastEditTime": {
       "$ref": "#/properties/rooms/items/properties/name"
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "roomTypeId": {
       "$ref": "#/properties/rooms/items/properties/hotelId"
      },
      "status": {
       "anyOf": [
        {
         "$ref": "#/properties/rooms/items/properties/name/anyOf/0"
        },
        {
         "type": "null"
        }
       ],
       "description": "AVAILABLE (in service, not a statement about occupancy), OUT_OF_ORDER or OUT_OF_SERVICE"
      }
     },
     "required": [
      "hotelId",
      "roomTypeId",
      "name",
      "status",
      "housekeepingStatus",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "rooms",
   "page"
  ],
  "type": "object"
 },
 "title": "Check room and housekeeping status"
}
