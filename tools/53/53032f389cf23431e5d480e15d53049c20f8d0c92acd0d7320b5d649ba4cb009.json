{
 "description": "Run content gap analysis for a URL and keyword.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "keyword": {
    "description": "Target keyword",
    "type": "string"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "scrape_depth": {
    "default": "h3",
    "enum": [
     "h1",
     "h2",
     "h3"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "url": {
    "description": "Your URL",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url",
   "keyword"
  ],
  "type": "object"
 },
 "name": "agentseo_content_gap",
 "title": "AgentSEO Content Gap"
}
