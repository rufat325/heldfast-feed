{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create or update reviewed project roles and hourly rates. Role deletion and reordering are not supported.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "creates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "maxLength": 255,
       "minLength": 1,
       "pattern": "^[\\p{Script=Latin}0-9\\s\\-_. ,!?;:'\"(){}\\[\\]*+\\/]+$",
       "type": "string"
      },
      "hourlyRate": {
       "maximum": 1000000,
       "minimum": 0,
       "type": "number"
      },
      "shortCode": {
       "maxLength": 3,
       "minLength": 1,
       "pattern": "^[\\p{Script=Latin}0-9\\s\\-_. ,!?;:'\"(){}\\[\\]*+\\/]+$",
       "type": "string"
      }
     },
     "required": [
      "shortCode",
      "description",
      "hourlyRate"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "projectId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "reviewed": {
    "const": true,
    "description": "Set to true only after explicit user approval of these exact project-role changes.",
    "type": "boolean"
   },
   "updates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "$ref": "#/properties/creates/items/properties/description"
      },
      "hourlyRate": {
       "$ref": "#/properties/creates/items/properties/hourlyRate"
      },
      "projectRoleId": {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "shortCode": {
       "$ref": "#/properties/creates/items/properties/shortCode"
      }
     },
     "required": [
      "projectRoleId"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "reviewed"
  ],
  "type": "object"
 },
 "name": "submit_project_role_changes",
 "title": "Submit reviewed project-role changes"
}
