{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "read"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Map the document"
 },
 "description": "Lists headings or code declarations with temporary read refs when choosing a document section to inspect.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "agent": {
    "description": "This assistant's display name.",
    "type": "string"
   },
   "cursor": {
    "description": "Continues the previous page.",
    "maxLength": 128,
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "limit": {
    "description": "Items per page. Clamped to 32.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "operation_id": {
    "description": "Optional retry identity scoped to this principal, connection and document. An unchanged mutation replays its original result for 24 hours, even after later edits; its expired identity never executes again. A read replays while its receipt is retained; after 256 later reads it executes afresh. Reusing an identity with changed arguments refuses. Visual observations are fresh. Inspect before starting another operation. Calls without it never replay.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "within": {
    "description": "An outline ref to stay inside.",
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "document"
  ],
  "type": "object"
 },
 "name": "document.get_outline",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "complete": {
    "type": "boolean"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "engine": {
    "type": [
     "string",
     "null"
    ]
   },
   "items": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "chars": {
       "minimum": 0,
       "type": "integer"
      },
      "depth": {
       "minimum": 0,
       "type": "integer"
      },
      "kind": {
       "maxLength": 64,
       "type": "string"
      },
      "label": {
       "maxLength": 192,
       "type": "string"
      },
      "layout": {
       "additionalProperties": true,
       "type": "object"
      },
      "ref": {
       "maxLength": 128,
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "maxLength": 128,
    "type": [
     "string",
     "null"
    ]
   },
   "omitted": {
    "minimum": 0,
    "type": "integer"
   },
   "outcome": {
    "enum": [
     "ok",
     "pending",
     "target_gone",
     "conflict",
     "yielded",
     "invalid",
     "refused",
     "uncertain"
    ],
    "type": "string"
   },
   "pending": {
    "additionalProperties": true,
    "properties": {
     "kind": {
      "enum": [
       "surface-fact",
       "human-review"
      ]
     },
     "proposalId": {
      "maxLength": 128,
      "type": "string"
     },
     "requestId": {
      "maxLength": 128,
      "type": "string"
     },
     "requirements": {
      "additionalProperties": true,
      "type": "object"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "reason": {
    "type": "string"
   },
   "remaining": {
    "minimum": 0,
    "type": "integer"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   },
   "total": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Map the document"
}
