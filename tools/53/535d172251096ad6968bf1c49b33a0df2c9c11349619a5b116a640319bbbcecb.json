{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get Market Data"
 },
 "description": "Get dated aggregate asking prices, model-year recalls, and EPA fuel economy. Check freshness and missing values before comparing prices. Does not return listings or a vehicle appraisal.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "make": {
    "description": "Vehicle make, such as Toyota",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "model": {
    "description": "Vehicle model, such as RAV4",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "year": {
    "description": "Model year",
    "maximum": 2027,
    "minimum": 1990,
    "type": "integer"
   }
  },
  "required": [
   "make",
   "model",
   "year"
  ],
  "type": "object"
 },
 "name": "get_market_data",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "freshness": {
    "additionalProperties": false,
    "properties": {
     "ageDays": {
      "type": [
       "number",
       "null"
      ]
     },
     "staleAfterDays": {
      "type": "number"
     },
     "status": {
      "enum": [
       "recent",
       "stale",
       "unknown",
       "unavailable"
      ],
      "type": "string"
     }
    },
    "required": [
     "status",
     "ageDays",
     "staleAfterDays"
    ],
    "type": "object"
   },
   "fuelEconomy": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "cityMpg": {
       "$ref": "#/properties/snapshot/anyOf/0/properties/listingCount"
      },
      "combinedMpg": {
       "$ref": "#/properties/snapshot/anyOf/0/properties/listingCount"
      },
      "highwayMpg": {
       "$ref": "#/properties/snapshot/anyOf/0/properties/listingCount"
      },
      "trim": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "trim"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recallScope": {
    "const": "model_year",
    "type": "string"
   },
   "recalls": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "campaignNumber": {
       "type": "string"
      },
      "component": {
       "type": [
        "string",
        "null"
       ]
      },
      "consequence": {
       "type": [
        "string",
        "null"
       ]
      },
      "remedy": {
       "type": [
        "string",
        "null"
       ]
      },
      "summary": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "campaignNumber",
      "component",
      "summary",
      "consequence",
      "remedy"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "retrievedAt": {
    "type": "string"
   },
   "snapshot": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "listingCount": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ],
        "default": null
       },
       "maxPrice": {
        "$ref": "#/properties/snapshot/anyOf/0/properties/listingCount"
       },
       "meanDom": {
        "$ref": "#/properties/snapshot/anyOf/0/properties/listingCount"
       },
       "meanMileage": {
        "$ref": "#/properties/snapshot/anyOf/0/properties/listingCount"
       },
       "meanPrice": {
        "$ref": "#/properties/snapshot/anyOf/0/properties/listingCount"
       },
       "medianDom": {
        "$ref": "#/properties/snapshot/anyOf/0/properties/listingCount"
       },
       "medianMileage": {
        "$ref": "#/properties/snapshot/anyOf/0/properties/listingCount"
       },
       "medianPrice": {
        "$ref": "#/properties/snapshot/anyOf/0/properties/listingCount"
       },
       "minPrice": {
        "$ref": "#/properties/snapshot/anyOf/0/properties/listingCount"
       },
       "snapshotDate": {
        "type": "string"
       }
      },
      "required": [
       "snapshotDate"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "sources": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "vehicle": {
    "additionalProperties": false,
    "properties": {
     "make": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "year": {
      "type": "number"
     }
    },
    "required": [
     "make",
     "model",
     "year"
    ],
    "type": "object"
   }
  },
  "required": [
   "vehicle",
   "freshness",
   "recallScope",
   "sources",
   "retrievedAt",
   "limitations"
  ],
  "type": "object"
 },
 "title": "Get Market Data"
}
