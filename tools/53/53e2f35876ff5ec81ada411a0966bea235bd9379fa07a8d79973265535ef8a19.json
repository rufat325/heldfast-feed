{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Recommend jobs for my profile"
 },
 "description": "Returns the authenticated user's personalized job recommendations built from their resume, skills,\ntarget roles, and preferred location. Results are ranked by fit, may include related roles, and carry\nthe same salary, match, H-1B, and job-trust insight payload used by job search. The search filters\nand sort parameters apply to this personalized feed too. Advanced parameters return a matching\npreview and hidden count for free accounts; Pro accounts receive the complete filtered list.\nAn explicit query for a different or unrecognized profession uses the same general job search as\njobs_search, preserving the query and filters instead of substituting the profile's target roles.\n\nA processing status means the personalized feed is still being prepared; a later call returns the\ncompleted feed. Page numbers fetch additional recommendations from the same feed.\n",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benefits": {
    "description": "Advanced filter: benefit names such as \"health insurance\", \"401k\" or \"parental leave\"; a job qualifies only when it states every listed benefit. Names that match no known benefit are ignored.",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "bonuses_only": {
    "description": "Advanced filter: only jobs that state a bonus (sign-on, performance, referral, commission and the like).",
    "type": "boolean"
   },
   "companies": {
    "description": "Filter: official company names; a job from any of them qualifies, across every job board each employer posts on. More than one company makes it an advanced filter. Next to company, a job has to match both; hiring_brand narrows company only.",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "company": {
    "description": "The official company name",
    "type": "string"
   },
   "confirmed_work_from": {
    "description": "Advanced filter: with strict_remote, also leaves out postings that do not say where the work can be done from.",
    "type": "boolean"
   },
   "education": {
    "description": "Filter: jobs whose posting requires one of these education levels (no_requirements, high_school, associate_degree, bachelor_degree, professional_certificate, postgraduate_degree); bachelor_degree means the posting asks for a bachelor degree, not that it suits someone holding one.",
    "items": {
     "enum": [
      "no_requirements",
      "high_school",
      "associate_degree",
      "bachelor_degree",
      "professional_certificate",
      "postgraduate_degree"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "employment_types": {
    "description": "Filter: jobs offered as any of these employment types (full_time, part_time, contractor, temporary, intern, volunteer, per_diem, other).",
    "items": {
     "enum": [
      "full_time",
      "part_time",
      "contractor",
      "temporary",
      "intern",
      "volunteer",
      "per_diem",
      "other"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "exclude_companies": {
    "description": "Advanced filter: official company names whose jobs are removed from the results, across every job board each employer posts on.",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "experience_levels": {
    "description": "Filter: jobs at any of these experience levels (entry_level, mid_level, senior_level, executive). The level comes from the years of experience the posting asks for and the seniority in its title, the higher of the two; entry_level never includes a posting asking for more than two years.",
    "items": {
     "enum": [
      "entry_level",
      "mid_level",
      "senior_level",
      "executive"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "h1b_sponsors_only": {
    "description": "Advanced filter: only companies known to sponsor H1B visas.",
    "type": "boolean"
   },
   "hide_low_quality": {
    "description": "Advanced filter: hides postings with a risky ghost grade (D/F); ungraded postings stay.",
    "type": "boolean"
   },
   "hiring_brand": {
    "description": "Filter: one brand inside the company, for example company \"Google\" with hiring_brand \"YouTube\"; used only together with company.",
    "type": "string"
   },
   "location": {
    "description": "Geographic location (e.g., 'Boston, MA')",
    "type": "string"
   },
   "min_match": {
    "description": "Advanced filter: lowest personal FoundRole match grade to keep, the same letter each job shows in insights.match.grade. A and A- are rare even for a strong resume; B keeps good and strong matches; C+ also keeps fair ones. Needs a resume on the account.",
    "enum": [
     "A",
     "A-",
     "B+",
     "B",
     "B-",
     "C+",
     "C"
    ],
    "type": "string"
   },
   "page": {
    "description": "Recommendation page number",
    "minimum": 1,
    "type": "integer"
   },
   "posted_days_ago": {
    "description": "Number of days ago to search for jobs (1-365)",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "The full job title or skill (e.g., \"Ruby Developer\", NOT just \"Ruby\")",
    "type": "string"
   },
   "radius": {
    "description": "Search radius in miles around a city location (default 40); not used for state, country or remote searches.",
    "maximum": 100,
    "minimum": 5,
    "type": "integer"
   },
   "remote": {
    "description": "Advanced filter: only remote-eligible jobs, matched across the whole country of the requested location rather than its radius.",
    "type": "boolean"
   },
   "salary_floor": {
    "description": "Advanced filter: minimum annualized salary in USD; a posting qualifies when the lower bound of its pay band reaches the floor. Jobs without a USD salary are dropped.",
    "minimum": 0,
    "type": "integer"
   },
   "sort": {
    "description": "Result order (score, posted_at, match, salary): score is relevance and the default, posted_at is newest first, salary is highest pay first, match is best personal fit first and needs a resume. Ordering by salary or match is an advanced option.",
    "enum": [
     "score",
     "posted_at",
     "match",
     "salary"
    ],
    "type": "string"
   },
   "strict_remote": {
    "description": "Advanced filter: only postings checked as fully remote that can be worked from the requested location: the posting names that area, allows anywhere, or does not say where. Stricter than remote; work_modes other than remote do not apply with it.",
    "type": "boolean"
   },
   "work_modes": {
    "description": "Advanced filter: jobs in any of these work modes (on_site, remote, hybrid). remote is matched across the whole country of the location, the others within the radius. [\"remote\"] is the same search as remote: true.",
    "items": {
     "enum": [
      "on_site",
      "remote",
      "hybrid"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
