{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List orders for an agent ({ orders }). Optional status or open_only filter.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_id": {
    "description": "Owning agent id whose orders to list",
    "type": "string"
   },
   "open_only": {
    "description": "If true, only in-flight orders (PENDING, CONFIRMED, IN_TRANSIT). Ignored when status is set.",
    "type": "boolean"
   },
   "session_token": {
    "description": "Session token from agent_authenticate \u2014 required whenever agent_id is passed",
    "type": "string"
   },
   "status": {
    "description": "Optional status filter: PENDING, CONFIRMED, IN_TRANSIT, DELIVERED, ABANDONED (or CANCELLED), FAILED, DISPUTED",
    "type": "string"
   }
  },
  "required": [
   "agent_id"
  ],
  "type": "object"
 },
 "name": "order_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "detail": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "hint": {
    "type": "string"
   },
   "next": {
    "additionalProperties": false,
    "properties": {
     "args": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        }
       ]
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "tool": {
      "type": "string"
     }
    },
    "required": [
     "tool"
    ],
    "type": "object"
   },
   "orders": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "List orders"
}
