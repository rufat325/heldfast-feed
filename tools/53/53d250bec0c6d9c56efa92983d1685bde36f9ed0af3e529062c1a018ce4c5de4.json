{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Place a limit / entry order that executes when the market reaches the specified price.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Investment amount in USD",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "instrumentId": {
    "description": "Instrument ID",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "isBuy": {
    "description": "true = Buy/Long, false = Sell/Short",
    "type": "boolean"
   },
   "leverage": {
    "description": "Leverage multiplier (default 1)",
    "maximum": 400,
    "minimum": 1,
    "type": "integer"
   },
   "rate": {
    "description": "Limit price at which the order should execute",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "stopLossRate": {
    "description": "Stop-loss price",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "takeProfitRate": {
    "description": "Take-profit price",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "instrumentId",
   "amount",
   "isBuy",
   "rate"
  ],
  "type": "object"
 },
 "name": "etoro_place_limit_order",
 "title": "Place limit order"
}
