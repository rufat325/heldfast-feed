{"description":"Update an existing one-time product. Pass the full desired listings/purchaseOptions state plus an updateMask (e.g. \"listings,purchaseOptions\").","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"listings":{"description":"At least one localization is required","items":{"additionalProperties":false,"properties":{"description":{"description":"Localized description (max 200 chars)","maxLength":200,"type":"string"},"languageCode":{"description":"BCP-47 locale code, e.g. en-US","minLength":1,"type":"string"},"title":{"description":"Localized title (max 55 chars)","maxLength":55,"type":"string"}},"required":["languageCode","title","description"],"type":"object"},"minItems":1,"type":"array"},"offerTags":{"items":{"$ref":"#/properties/purchaseOptions/items/properties/offerTags/items"},"maxItems":20,"type":"array"},"packageName":{"description":"Android package name (e.g. com.example.app)","type":"string"},"productId":{"description":"One-time product ID, e.g. com.example.app.remove_ads","pattern":"^[a-z0-9][a-z0-9._]*$","type":"string"},"purchaseOptions":{"description":"At least one purchase option (buy or rent) is required","items":{"additionalProperties":false,"properties":{"buy":{"additionalProperties":false,"description":"Configures this as a one-time buy option. Mutually exclusive with rent.","properties":{"legacyCompatible":{"description":"Marks this as the single \"buy\" option usable by legacy PBL flows","type":"boolean"},"multiQuantityEnabled":{"type":"boolean"}},"type":"object"},"newRegionsConfig":{"additionalProperties":false,"properties":{"availability":{"enum":["AVAILABLE","NO_LONGER_AVAILABLE"],"type":"string"},"eurPriceMicros":{"$ref":"#/properties/purchaseOptions/items/properties/newRegionsConfig/properties/usdPriceMicros"},"usdPriceMicros":{"pattern":"^\\d+$","type":"string"}},"required":["availability","usdPriceMicros","eurPriceMicros"],"type":"object"},"offerTags":{"items":{"pattern":"^[a-z0-9](?:[a-z0-9-]{0,18}[a-z0-9])?$","type":"string"},"maxItems":20,"type":"array"},"purchaseOptionId":{"description":"Stable purchase option id, e.g. buy-standard","pattern":"^[a-z0-9][a-z0-9-]{0,62}$","type":"string"},"regionalConfigs":{"description":"At least one region price is required","items":{"additionalProperties":false,"properties":{"availability":{"default":"AVAILABLE","enum":["AVAILABLE","NO_LONGER_AVAILABLE","AVAILABLE_IF_RELEASED","AVAILABLE_FOR_OFFERS_ONLY"],"type":"string"},"currency":{"description":"ISO 4217 currency code, e.g. USD","pattern":"^[A-Z]{3}$","type":"string"},"priceMicros":{"description":"Non-negative price in micros, e.g. 3990000 for $3.99","pattern":"^\\d+$","type":"string"},"regionCode":{"description":"ISO 3166-1 alpha-2 region, e.g. US","pattern":"^[A-Z]{2}$","type":"string"}},"required":["regionCode","priceMicros","currency"],"type":"object"},"minItems":1,"type":"array"},"rent":{"additionalProperties":false,"description":"Configures this as a rental option. Mutually exclusive with buy.","properties":{"expirationPeriod":{"description":"ISO 8601 duration after consumption starts before the entitlement is revoked, e.g. P2D","type":"string"},"rentalPeriod":{"description":"ISO 8601 duration the entitlement lasts, e.g. P30D","type":"string"}},"required":["rentalPeriod"],"type":"object"},"taxAndComplianceSettings":{"additionalProperties":false,"properties":{"withdrawalRightType":{"minLength":1,"type":"string"}},"type":"object"}},"required":["purchaseOptionId","regionalConfigs"],"type":"object"},"minItems":1,"type":"array"},"regionsVersion":{"default":"2022/02","description":"Google Play regions version. Default 2022/02 matches Google API expectations.","type":"string"},"restrictedPaymentCountries":{"items":{"pattern":"^[A-Z]{2}$","type":"string"},"type":"array"},"taxAndComplianceSettings":{"additionalProperties":false,"properties":{"isTokenizedDigitalAsset":{"type":"boolean"},"productTaxCate