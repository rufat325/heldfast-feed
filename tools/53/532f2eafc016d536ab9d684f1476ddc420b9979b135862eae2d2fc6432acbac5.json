{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search current property listings in Northern Cyprus. All filters are optional and accept English, Russian or Turkish spellings (e.g. region 'Kyrenia' or '\u0413\u0438\u0440\u043d\u0435'). Returns up to `limit` listings (featured first, then newest by default) with a one-line `summary`, `url` and `contact_url`. Example: long-term rent of a 2+1 in Iskele up to \u00a3700 \u2192 deal='Rent', region='iskele', layout='2+1', price_max=700, price_period='month'.",
 "inputSchema": {
  "properties": {
   "area_min": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Minimum area in m\u00b2",
    "title": "Area Min"
   },
   "currency": {
    "anyOf": [
     {
      "enum": [
       "GBP",
       "EUR",
       "USD"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Currency of price_min/max, default GBP",
    "title": "Currency"
   },
   "cursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "next_cursor from a previous call, for more results",
    "title": "Cursor"
   },
   "deal": {
    "anyOf": [
     {
      "enum": [
       "Sale",
       "Rent"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Sale or Rent",
    "title": "Deal"
   },
   "has_photo": {
    "default": false,
    "description": "Only listings with photos",
    "title": "Has Photo",
    "type": "boolean"
   },
   "layout": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "'studio', '1+1', '2+1', '3+1', or '4+' for 4 or more bedrooms",
    "title": "Layout"
   },
   "limit": {
    "default": 10,
    "description": "How many listings to return, 1\u201310",
    "maximum": 10,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "price_max": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Maximum price in `currency`",
    "title": "Price Max"
   },
   "price_min": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Minimum price in `currency`",
    "title": "Price Min"
   },
   "price_period": {
    "anyOf": [
     {
      "enum": [
       "month",
       "day",
       "total"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "month = monthly rent, day = daily/holiday rent, total = sale price",
    "title": "Price Period"
   },
   "region": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "girne (Kyrenia), iskele, famagusta, lefkosha (Nicosia), guzelyurt, lefke",
    "title": "Region"
   },
   "sort": {
    "default": "recommended",
    "description": "recommended = featured first, then newest",
    "enum": [
     "recommended",
     "price_asc",
     "price_desc",
     "newest"
    ],
    "title": "Sort",
    "type": "string"
   },
   "sub_region": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Area within a region, e.g. 'Long Beach', 'Bogaz', 'Esentepe', 'Alsancak' (see list_regions)",
    "title": "Sub Region"
   },
   "type": {
    "anyOf": [
     {
      "enum": [
       "Residential",
       "Commercial"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Property type",
    "title": "Type"
   }
  },
  "title": "search_listingsArguments",
  "type": "object"
 },
 "name": "search_listings",
 "outputSchema": {
  "additionalProperties": true,
  "title": "search_listingsDictOutput",
  "type": "object"
 },
 "title": "Search property listings"
}
