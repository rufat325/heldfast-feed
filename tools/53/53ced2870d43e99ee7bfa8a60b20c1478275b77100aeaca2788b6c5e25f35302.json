{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Ask the open editor"
 },
 "description": "Asks the open editor for what needs the person's device: one card the person taps to read a passage aloud, copy it, open a device file or install a plug-in, or a Word or PDF export returned as a file link without a tap. Receipts say waiting, done, declined or unavailable.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "action": {
    "description": "read_aloud and copy take text or a context_handle, and copy with format complete takes a context_handle; install_plugin takes a plugin; open_file, export_word and export_pdf take nothing more.",
    "enum": [
     "read_aloud",
     "copy",
     "open_file",
     "export_word",
     "export_pdf",
     "install_plugin"
    ],
    "type": "string"
   },
   "agent": {
    "description": "This assistant's display name.",
    "type": "string"
   },
   "context_handle": {
    "description": "The handle of an inspected passage to read aloud or copy.",
    "maxLength": 128,
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "format": {
    "description": "How copy writes the passage: markdown when absent.",
    "enum": [
     "markdown",
     "plain",
     "formatted",
     "complete"
    ],
    "type": "string"
   },
   "operation_id": {
    "description": "Optional retry identity scoped to this principal, connection and document. An unchanged mutation replays its original result for 24 hours, even after later edits; its expired identity never executes again. A read replays while its receipt is retained; after 256 later reads it executes afresh. Reusing an identity with changed arguments refuses. Visual observations are fresh. Inspect before starting another operation. Calls without it never replay.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "plugin": {
    "description": "The plug-in install_plugin installs.",
    "enum": [
     "math",
     "mermaid",
     "pdf",
     "ocr",
     "letters-field",
     "letters-relief",
     "letters-leaf",
     "letters-arabesque"
    ],
    "type": "string"
   },
   "text": {
    "description": "The passage to read aloud or copy.",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "document",
   "action"
  ],
  "type": "object"
 },
 "name": "document.ask_editor",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "bytes": {
    "minimum": 0,
    "type": "integer"
   },
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "exportExpiresAt": {
    "maxLength": 64,
    "type": "string"
   },
   "exportId": {
    "maxLength": 128,
    "type": "string"
   },
   "filename": {
    "maxLength": 256,
    "type": "string"
   },
   "mimeType": {
    "maxLength": 128,
    "type": "string"
   },
   "outcome": {
    "enum": [
     "ok",
     "pending",
     "target_gone",
     "conflict",
     "invalid",
     "refused",
     "uncertain",
     "replayed"
    ],
    "type": "string"
   },
   "pending": {
    "additionalProperties": true,
    "properties": {
     "kind": {
      "enum": [
       "surface-fact",
       "human-review"
      ]
     },
     "proposalId": {
      "maxLength": 128,
      "type": "string"
     },
     "requestId": {
      "maxLength": 128,
      "type": "string"
     },
     "requirements": {
      "additionalProperties": true,
      "type": "object"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "reason": {
    "type": "string"
   },
   "receipt": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "type": "string"
     },
     "current": {
      "type": [
       "string",
       "boolean"
      ]
     },
     "id": {
      "maxLength": 128,
      "type": "string"
     },
     "issues": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "count": {
         "type": "integer"
        },
        "message": {
         "type": "string"
        },
        "severity": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "severity",
        "count",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "preference": {
      "type": "string"
     },
     "previous": {
      "type": [
       "string",
       "boolean"
      ]
     },
     "reason": {
      "type": "string"
     },
     "status": {
      "enum": [
       "applied",
       "waiting",
       "done",
       "declined",
       "unavailable"
      ],
      "type": "string"
     },
     "superseded": {
      "type": "boolean"
     },
     "value": {
      "type": [
       "string",
       "boolean"
      ]
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Ask the open editor"
}
