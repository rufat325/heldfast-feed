   "pathContains": {
    "description": "\u0424\u0438\u043b\u044c\u0442\u0440 \u043f\u043e \u043f\u043e\u0434\u0441\u0442\u0440\u043e\u043a\u0435 \u043f\u0443\u0442\u0438 (CONTAINS): \u043f\u043e \u0433\u0440\u0443\u043f\u043f\u0438\u0440\u0443\u044e\u0449\u0435\u043c\u0443 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044e, \u0430 \u043f\u0440\u0438 groupBy=title \u2014 \u043f\u043e pagePath",
    "type": "string"
   },
   "propertyId": {
    "description": "\u0427\u0438\u0441\u043b\u043e\u0432\u043e\u0439 id \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 GA4 (\u0438\u043b\u0438 properties/123). \u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u2014 GA4_PROPERTY_ID",
