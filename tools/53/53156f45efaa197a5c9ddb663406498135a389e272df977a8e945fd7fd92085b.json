{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read a voiceover line"
 },
 "description": "Use this when someone needs the full wording or translation of one voiceover line, or its audio link. Returns its source text, translation, language, voice, duration, project and audio URL. Not for changing the words.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "speechId": {
    "description": "Voiceover line id",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "speechId"
  ],
  "type": "object"
 },
 "name": "get_speech",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "speech": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "duration": {
        "anyOf": [
         {
          "maximum": 86400,
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "language": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "projectId": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "text": {
        "anyOf": [
         {
          "maxLength": 4000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "textTruncated": {
        "type": "boolean"
       },
       "translatedText": {
        "anyOf": [
         {
          "maxLength": 4000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "translatedTextTruncated": {
        "type": "boolean"
       },
       "url": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "voice": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "projectId",
       "language",
       "voice",
       "duration",
       "url",
       "creationTime",
       "lastEditTime",
       "text",
       "textTruncated",
       "translatedText",
       "translatedTextTruncated"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "speech"
  ],
  "type": "object"
 },
 "title": "Read a voiceover line"
}
