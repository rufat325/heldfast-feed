  "readOnlyHint": true,
  "title": "chainpeek: will this USDC or USDT send go through? pass, warn or fail with a reason per check, read-only"
 },
 "description": "chainpeek: Preflight a USDC or USDT transfer: balance, gas, nonce, blacklist, recipient, simulation. For OFAC screening use check_sanctions; for a wallet's past pulls use check_wallet_drain. Returns a `verdict` (pass, warn or fail) for one planned ERC-20 transfer, with a row per check in `checks` (token balance, gas balance, pending nonce, issuer blacklist for sender and recipient, paused, recipient sanity, address-poisoning lookalike, simulated `transfer(to, amount)` with its revert reason, decimals and raw amount) and the non-passing ones in `reasons`. Read-only: nothing is signed or sent. A part that cannot be read is `not_checked` with a reason (verdict `warn`); a token without the blacklist function is `not_available`, not a fail. Lookalike check on Ethereum and Base only. Bad input is a 422 (not charged). Typically 1-4 s. Price: USD 0.01. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/gas-price-api.html",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "Amount in token units as a positive decimal string, e.g. \"250.5\" (not raw units).",
    "maxLength": 160,
    "pattern": "^(0|[1-9][0-9]{0,77})(\\.[0-9]{1,77})?$",
    "title": "Amount",
    "type": "string"
   },
   "chain": {
    "description": "ethereum, base, polygon, bnb or arbitrum.",
    "enum": [
     "ethereum",
     "base",
     "polygon",
     "bnb",
     "arbitrum"
    ],
    "title": "Chain",
    "type": "string"
   },
   "from": {
    "description": "The sending wallet (0x + 40 hex).",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "title": "From",
    "type": "string"
   },
   "to": {
    "description": "The recipient (0x + 40 hex).",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "title": "To",
    "type": "string"
   },
   "token": {
    "description": "USDC, USDT (the chain's native issuer contract) or an ERC-20 contract address.",
    "pattern": "^(USDC|USDT|0x[0-9a-fA-F]{40})$",
    "title": "Token",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "token",
   "from",
   "to",
   "amount"
  ],
  "title": "transfer_preflightArguments",
  "type": "object"
 },
