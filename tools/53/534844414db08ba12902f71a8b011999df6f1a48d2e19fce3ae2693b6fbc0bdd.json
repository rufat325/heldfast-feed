{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Update fields on ONE mail account (PATCH \u2014 only fields you supply are changed). Omit password to keep the stored one.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "account_type": {
    "description": "1=IMAP, 2=Gmail OAuth, 3=Outlook OAuth",
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "character_set": {
    "description": "e.g. UTF-8 (default) or US-ASCII",
    "maxLength": 256,
    "type": "string"
   },
   "id": {
    "type": "number"
   },
   "imap_port": {
    "description": "Usually 993 (SSL) or 143 (STARTTLS / none)",
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "imap_security": {
    "description": "1=no encryption, 2=SSL, 3=STARTTLS",
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "imap_server": {
    "maxLength": 256,
    "type": "string"
   },
   "is_token": {
    "description": "true when `password` is an OAuth/app token",
    "type": "boolean"
   },
   "name": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "owner": {
    "type": [
     "number",
     "null"
    ]
   },
   "password": {
    "description": "IMAP password or OAuth token. Write-only: Paperless returns it masked as all asterisks (at least 10, one per character), and sending any all-asterisks value back leaves the stored password unchanged.",
    "type": "string"
   },
   "username": {
    "maxLength": 256,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_mail_account"
}
