{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Inspect multiple wallets"
 },
 "description": "Use for positions of two to five wallets in one batch call, for example after a ranking. Covers one venue with bounded upstream concurrency and reports individual wallet failures. Accepts an optional asset for named markets.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "addresses": {
    "items": {
     "pattern": "^0x[0-9a-fA-F]{40}$",
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 2,
    "type": "array"
   },
   "asset": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "dex": {
    "default": "",
    "pattern": "^(?:|[a-z][a-z0-9]{0,31})$",
    "type": "string"
   }
  },
  "required": [
   "addresses"
  ],
  "type": "object"
 },
 "name": "get_hyperliquid_wallets_positions",
 "title": "Inspect multiple wallets"
}
