{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Set a contact's geographic address and coordinates so it appears on the map. Use search_map_contacts to look up bookid, uri and uid.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address_string": {
    "description": "Full address as a single string, used instead of the individual fields",
    "type": "string"
   },
   "attraction": {
    "description": "Point of interest name",
    "type": "string"
   },
   "bookid": {
    "description": "Address book ID",
    "type": "string"
   },
   "city": {
    "description": "City",
    "type": "string"
   },
   "country": {
    "description": "Country",
    "type": "string"
   },
   "house_number": {
    "description": "House number",
    "type": "string"
   },
   "lat": {
    "description": "Latitude",
    "type": "number"
   },
   "lng": {
    "description": "Longitude",
    "type": "number"
   },
   "myMapId": {
    "description": "ID of a custom map to scope the operation to; omit for the user's default map",
    "type": "number"
   },
   "postcode": {
    "description": "Postal code",
    "type": "string"
   },
   "road": {
    "description": "Street",
    "type": "string"
   },
   "state": {
    "description": "State or region",
    "type": "string"
   },
   "type": {
    "description": "Address type (e.g. 'HOME', 'WORK')",
    "type": "string"
   },
   "uid": {
    "description": "Contact UID",
    "type": "string"
   },
   "uri": {
    "description": "Contact URI (e.g. \"abc123.vcf\")",
    "type": "string"
   }
  },
  "required": [
   "bookid",
   "uri",
   "uid"
  ],
  "type": "object"
 },
 "name": "place_map_contact",
 "title": "Place Map Contact"
}
