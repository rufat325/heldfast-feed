{
 "description": "List contracts (hired freelancers) as a bounded page, optionally filtered by jobId, legacy status, exact participationState, and/or settlementState. Follow nextCursor with every original filter; there is no unbounded all mode. A bounded CONTRACT_LIST_TIMEOUT is retryable. Each contract includes both independent lifecycle states, milestones, payout states, and masked freelancer identity. Requires payments:read scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque nextCursor from a previous page \u2014 bound to the ORIGINAL jobId/status/participationState/settlementState/asOf; a mismatch is a typed 400.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "jobId": {
    "description": "Optional OWNED job id. Without limit/cursor the job-scoped read keeps the unchanged unpaged list; pass limit or cursor to page it.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Bounded page size (server default 50, max 100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "participationState": {
    "description": "Optional exact participation lifecycle filter.",
    "enum": [
     "ACTIVE",
     "OFFBOARDING",
     "OFFBOARDED_PAYABLE",
     "CLOSED",
     "REACTIVATED"
    ],
    "type": "string"
   },
   "settlementState": {
    "description": "Optional exact earned-payment settlement filter.",
    "enum": [
     "ACTION_REQUIRED",
     "PROCESSING",
     "SETTLED"
    ],
    "type": "string"
   },
   "status": {
    "description": "Optional contract status filter: active or ended. Omit to list both.",
    "enum": [
     "active",
     "ended"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "opentrain_list_contracts",
