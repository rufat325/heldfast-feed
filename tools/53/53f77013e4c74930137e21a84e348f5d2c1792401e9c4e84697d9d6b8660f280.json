 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Schedule a batch of posts"
 },
 "description": "Schedule many finished videos at once. First call with approve: false: it checks every slot (video ready, output, time 2 min to 60 days ahead, connected accounts) and changes nothing. Show the user the schedule; only after they say yes call again with approve: true, which schedules the ready ones and says which are still editing. Scheduling needs publishing permission. Never call approve: true without the user\u2019s explicit yes. Cost: Free to schedule.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approve": {
    "description": "false: check the schedule and change nothing. true: schedule the ready posts (publishing permission needed).",
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "caption": {
       "maxLength": 2000,
       "type": "string"
      },
      "output_id": {
       "description": "Which output to post (from check_video); the main video when left out.",
       "pattern": "^[a-z0-9-]{1,80}$",
       "type": "string"
      },
      "platform_options": {
       "additionalProperties": false,
       "properties": {
        "TIKTOK": {
         "additionalProperties": false,
         "properties": {
          "consent": {
           "const": true,
           "type": "boolean"
          },
          "disableComments": {
           "type": "boolean"
          },
          "disableDuet": {
           "type": "boolean"
          },
          "disableStitch": {
           "type": "boolean"
          },
          "isAiGenerated": {
           "type": "boolean"
          },
          "isBrandContent": {
           "type": "boolean"
          },
          "isOrganicBrandContent": {
           "type": "boolean"
          },
          "privacy": {
           "enum": [
            "SELF_ONLY",
            "PUBLIC_TO_EVERYONE",
            "MUTUAL_FOLLOW_FRIENDS",
            "FOLLOWER_OF_CREATOR"
           ],
           "type": "string"
          }
         },
         "required": [
          "privacy",
          "disableComments",
          "disableDuet",
          "disableStitch",
          "isAiGenerated",
          "isBrandContent",
          "isOrganicBrandContent",
          "consent"
         ],
         "type": "object"
        },
        "YOUTUBE": {
         "additionalProperties": false,
         "properties": {
          "containsSyntheticMedia": {
           "type": "boolean"
          },
          "madeForKids": {
           "type": "boolean"
          },
          "privacy": {
           "enum": [
            "PUBLIC",
            "PRIVATE",
            "UNLISTED"
           ],
           "type": "string"
          }
         },
         "required": [
          "privacy",
          "madeForKids"
         ],
         "type": "object"
        }
       },
       "type": "object"
      },
      "platforms": {
       "description": "INSTAGRAM, TIKTOK and/or YOUTUBE.",
       "items": {
        "enum": [
         "INSTAGRAM",
         "TIKTOK",
         "YOUTUBE"
        ],
        "type": "string"
       },
       "maxItems": 3,
       "minItems": 1,
       "type": "array"
      },
      "post_at": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "video_id": {
       "description": "The video id from list_videos.",
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "video_id",
      "platforms",
      "post_at",
      "caption"
     ],
     "type": "object"
    },
    "maxItems": 31,
    "minItems": 1,
    "type": "array"
   },
   "operation_id": {
    "description": "A stable ID for this request. Preserve it on retries. Use a new ID only for a deliberate new request.",
    "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
    "type": "string"
   },
   "timezone": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "items",
   "timezone",
   "approve"
  ],
  "type": "object"
 },
