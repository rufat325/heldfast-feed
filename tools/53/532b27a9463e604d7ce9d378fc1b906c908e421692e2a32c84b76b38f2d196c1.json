 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Enumerate ESG Hub articles, optionally filtered by `section`, `pillar`, or a title substring (`query` \u2014 an exact substring, not fuzzy). Use it to browse a whole section; to find articles by meaning use search_content. Results are ordered by section then title and returned one page at a time: pass the response's `next_offset` back as `offset` until `has_more` is false. `section` and `pillar` values must be taken from get_esg_metadata, and `offset` is a raw row count so advance it by `limit`; `limit` caps at 100 (default 20). A filter that matches nothing, or an `offset` past the end, returns an empty item list with `has_more=false`. Cached ~5 minutes; rate-limited per IP; retry on 5xx.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 20,
    "description": "Results per page",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset \u2014 pass the previous next_offset",
    "minimum": 0,
    "type": "number"
   },
   "pillar": {
    "description": "Filter by pillar (e.g., 'Environmental', 'Standards')",
    "type": "string"
   },
   "query": {
    "description": "Filter by title substring",
    "type": "string"
   },
   "section": {
    "description": "Filter by section (e.g., 'environmental', 'standards')",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_esg_pages",
