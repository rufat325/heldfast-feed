{
 "description": "Read current readiness for one repository already linked to the authenticated maintainer. Never bypasses maintainer or GitHub App checks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "owner": {
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_.-]+$",
    "type": "string"
   },
   "repo": {
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_.-]+$",
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo"
  ],
  "type": "object"
 },
 "name": "mizuki_repository_readiness"
}
