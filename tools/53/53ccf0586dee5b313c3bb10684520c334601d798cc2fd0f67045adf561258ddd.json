{
 "_meta": {
  "openai/outputTemplate": "ui://multilocale/phrase-detail-v2.html",
  "openai/toolInvocation/invoked": "MultiLocale phrase ready.",
  "openai/toolInvocation/invoking": "Loading MultiLocale phrase\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://multilocale/phrase-detail-v2.html"
  },
  "ui/resourceUri": "ui://multilocale/phrase-detail-v2.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show one string's translations"
 },
 "description": "Use this when someone asks how one exact key is translated, in every language or in one. Returns that key's text per locale, up to 24 locales and 2,000 characters each, with machine-translation flags and the projects sharing it, and renders a phrase card. Not for searching keys by text.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "description": "Exact key, matched case-sensitively",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "description": "One locale code such as en or it; every language when absent",
    "maxLength": 35,
    "type": "string"
   },
   "project": {
    "description": "Project name; an id matches nothing",
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "project",
   "key"
  ],
  "type": "object"
 },
 "name": "get_phrase",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "maxLength": 256,
    "type": "string"
   },
   "project": {
    "maxLength": 128,
    "type": "string"
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   },
   "translationCount": {
    "minimum": 0,
    "type": "integer"
   },
   "translations": {
    "description": "One row per locale, up to 24, values cut to 2,000 characters; projects lists every project sharing the row",
    "items": {
     "additionalProperties": false,
     "properties": {
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "language": {
       "maxLength": 35,
       "type": "string"
      },
      "lastEditTime": {
       "$ref": "#/properties/translations/items/properties/creationTime"
      },
      "machineTranslated": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "projects": {
       "items": {
        "maxLength": 128,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "value": {
       "maxLength": 2000,
       "type": "string"
      },
      "valueTruncated": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "language",
      "value",
      "valueTruncated",
      "machineTranslated",
      "projects",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 24,
    "type": "array"
   },
   "translationsTruncated": {
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "project",
   "key",
   "translationCount",
   "translationsTruncated",
   "translations"
  ],
  "type": "object"
 },
 "title": "Show one string's translations"
}
