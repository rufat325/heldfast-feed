  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "plan_id": {
    "description": "12-character lookalike-free plan reference returned by plan_staffing or save_staffing_plan.",
    "maxLength": 12,
    "pattern": "^[A-HJ-NP-Z2-9]{12}$",
    "type": "string"
   }
  },
  "required": [
   "plan_id"
  ],
  "type": "object"
 },
