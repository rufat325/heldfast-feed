{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a test cycle's metadata (summary, description, priority, status, dates, custom fields).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assignee": {
    "type": "string"
   },
   "customFields": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cascadeValue": {
       "description": "Cascade dropdown value",
       "type": "string"
      },
      "id": {
       "description": "Custom field ID, e.g. qcf_1",
       "type": "string"
      },
      "value": {
       "description": "Field value",
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "type": "string"
   },
   "id": {
    "description": "Test cycle ID",
    "type": [
     "string",
     "number"
    ]
   },
   "plannedEndDate": {
    "description": "ISO 8601 date",
    "type": "string"
   },
   "plannedStartDate": {
    "description": "ISO 8601 date",
    "type": "string"
   },
   "priority": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^\\d+$",
      "type": "string"
     }
    ],
    "description": "Priority integer ID \u2014 use qtm4j_get_priorities"
   },
   "status": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^\\d+$",
      "type": "string"
     }
    ],
    "description": "Status integer ID \u2014 use qtm4j_get_statuses (module=testcycle)"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "qtm4j_update_test_cycle",
 "title": "Update Test Cycle"
}
