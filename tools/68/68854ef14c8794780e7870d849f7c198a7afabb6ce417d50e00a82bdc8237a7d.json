{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create or update the seller storefront (nestuge-style page). Handle is auto-generated from the display name if omitted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "avatarUrl": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "bio": {
    "description": "Short store bio",
    "type": [
     "string",
     "null"
    ]
   },
   "brandColor": {
    "description": "Hex brand colour e.g. #188A56",
    "type": [
     "string",
     "null"
    ]
   },
   "displayName": {
    "description": "Store display name",
    "type": "string"
   },
   "enabled": {
    "description": "Whether the storefront is public",
    "type": "boolean"
   },
   "handle": {
    "description": "URL handle (a-z, 0-9, hyphens). Becomes /s/<handle>.",
    "type": "string"
   },
   "socials": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Map of social links e.g. { instagram: 'https://...' }",
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "neuron_update_storefront",
 "title": "Update Storefront"
}
