{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare 2 to 4 loan scenarios (type, rate, down payment, term, discount points) on one purchase price. Returns payment, an illustrative cash-to-close, and total interest. Read-only. Rates are examples.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "creditScore": {
    "maximum": 850,
    "minimum": 300,
    "type": "integer"
   },
   "hoaMonthly": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "insuranceMonthly": {
    "default": 150,
    "minimum": 0,
    "type": "number"
   },
   "monthlyTaxOverride": {
    "minimum": 0,
    "type": "number"
   },
   "propertyTaxRatePercent": {
    "default": 0.35,
    "maximum": 5,
    "minimum": 0,
    "type": "number"
   },
   "purchasePrice": {
    "exclusiveMinimum": 0,
    "maximum": 50000000,
    "type": "number"
   },
   "scenarios": {
    "items": {
     "properties": {
      "downPayment": {
       "minimum": 0,
       "type": "number"
      },
      "downPaymentUnit": {
       "default": "percent",
       "enum": [
        "percent",
        "dollars"
       ],
       "type": "string"
      },
      "label": {
       "maxLength": 80,
       "type": "string"
      },
      "loanType": {
       "enum": [
        "conventional",
        "fha",
        "va",
        "jumbo"
       ],
       "type": "string"
      },
      "points": {
       "default": 0,
       "description": "Discount points as a percent of the loan amount.",
       "maximum": 10,
       "minimum": 0,
       "type": "number"
      },
      "rate": {
       "maximum": 25,
       "minimum": 0,
       "type": "number"
      },
      "termYears": {
       "default": 30,
       "maximum": 40,
       "minimum": 1,
       "type": "integer"
      },
      "vaDisabilityExempt": {
       "type": "boolean"
      },
      "vaFirstUse": {
       "type": "boolean"
      }
     },
     "required": [
      "loanType",
      "rate",
      "downPayment"
     ],
     "type": "object"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array"
   },
   "vaDisabilityExempt": {
    "default": false,
    "type": "boolean"
   },
   "vaFirstUse": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "purchasePrice",
   "scenarios"
  ],
  "type": "object"
 },
 "name": "compare_loans",
 "title": "Compare loans"
}
