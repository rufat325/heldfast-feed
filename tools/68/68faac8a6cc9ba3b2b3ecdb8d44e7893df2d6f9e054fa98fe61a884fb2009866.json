     "null"
    ]
   },
   "chain": {
    "type": [
     "string",
     "null"
    ]
   },
   "chainId": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "chainLabel": {
    "type": [
     "string",
     "null"
    ]
   },
   "note": {
    "type": [
     "string",
     "null"
    ]
   },
   "reason": {
    "type": [
     "string",
     "null"
    ]
   },
   "source": {
    "type": "string"
   },
   "stale": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "ts": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Current block height"
}
