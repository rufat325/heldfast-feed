{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Indexed Documents"
 },
 "description": "Full-text search across all parsed SEC/FDA/register/weather section bodies (BM25 ranking). Also resolves company names for ticker lookup.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 25,
    "description": "Maximum matching document sections to return; default 25, max 200.",
    "maximum": 200,
    "type": "integer"
   },
   "q": {
    "description": "Search query (e.g. 'director departure', 'restatement', 'tornado warning')",
    "type": "string"
   },
   "topic": {
    "description": "Filter to one topic (optional)",
    "enum": [
     "sec",
     "fda",
     "register",
     "weather",
     "climate"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search",
 "title": "Search Indexed Documents"
}
