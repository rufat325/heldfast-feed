  "anyOf": [
   {
    "required": [
     "view",
     "projectId",
     "sections"
    ]
   },
   {
    "required": [
     "code",
     "message"
    ]
   }
  ],
  "properties": {
   "code": {
    "type": "string"
   },
   "issues": {
    "items": {
     "properties": {
      "field": {
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "field",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "mediaOrigin": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "outcomeUnknown": {
    "type": "boolean"
   },
   "projectId": {
    "type": "string"
   },
   "revisionId": {
    "type": [
     "string",
     "null"
    ]
   },
   "sections": {
    "items": {
     "properties": {
      "endMs": {
       "type": "number"
      },
      "included": {
       "type": "boolean"
      },
      "index": {
       "type": "number"
      },
      "lines": {
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "shots": {
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "startMs": {
       "type": "number"
      },
      "stillUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "type": {
       "enum": [
        "performance",
        "story"
       ]
      },
      "what": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "view": {
    "const": "storyboard"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "studio.read"
   ],
