   }
  ],
  "ui": {
   "resourceUri": "ui://brix36/studio/v4.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Preview the storyboard"
 },
 "description": "Returns the stored storyboard as 30-second section cards with lines and numbered shots. Each shot includes stableShotId and a signed stillUrl valid for about a day, or null if no picture exists. Supported hosts also receive an interactive preview. Free and read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "description": "Project id from the Brix36 library.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "studio_storyboard_preview",
 "outputSchema": {
