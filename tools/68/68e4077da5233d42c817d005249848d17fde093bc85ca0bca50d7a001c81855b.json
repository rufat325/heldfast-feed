{
 "description": "Update a catalog API. Requires `write` scope. Pass apiId plus at least one field to change.",
 "inputSchema": {
  "properties": {
   "apiId": {
    "description": "The API id to update (required)",
    "type": "string"
   },
   "componentId": {
    "description": "New owning component id (null clears it)",
    "type": "string"
   },
   "description": {
    "description": "New description (null clears it)",
    "type": "string"
   },
   "kind": {
    "description": "New kind",
    "type": "string"
   },
   "lifecycle": {
    "description": "New lifecycle",
    "type": "string"
   },
   "name": {
    "description": "New name",
    "type": "string"
   },
   "ownerTeamId": {
    "description": "New owner team id (null clears it)",
    "type": "string"
   },
   "specUrl": {
    "description": "New spec URL (null clears it)",
    "type": "string"
   },
   "tags": {
    "description": "Replacement tag list",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "apiId"
  ],
  "type": "object"
 },
 "name": "update_api"
}
