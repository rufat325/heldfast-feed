{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update project task"
 },
 "description": "Update an existing project task by ID. Requires project_tasks:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assigned_to": {
    "description": "Assigned user - an active member of the organization (see list_users)",
    "maxLength": 200,
    "type": "string"
   },
   "completion_percentage": {
    "description": "Percent complete (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "due_date": {
    "description": "Due date (ISO 8601)",
    "type": "string"
   },
   "estimated_cost": {
    "description": "Estimated cost",
    "minimum": 0,
    "type": "number"
   },
   "estimated_hours": {
    "description": "Estimated hours",
    "minimum": 0,
    "type": "number"
   },
   "id": {
    "description": "Project task ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "parent_task_id": {
    "description": "Parent task ID, for a subtask",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "phase_id": {
    "description": "Phase ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "priority": {
    "description": "Priority",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "project_id": {
    "description": "Project ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "start_date": {
    "description": "Start date (ISO 8601)",
    "type": "string"
   },
   "status": {
    "description": "Task status",
    "enum": [
     "todo",
     "in_progress",
     "completed",
     "blocked",
     "cancelled"
    ],
    "type": "string"
   },
   "title": {
    "description": "Task title",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_project_task",
 "title": "Update project task"
}
