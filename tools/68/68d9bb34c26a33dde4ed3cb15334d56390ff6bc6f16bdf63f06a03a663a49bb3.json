{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return locally ranked paper candidates with deterministic reasons and human review state.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 50,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "min_score": {
    "default": 0,
    "maximum": 100,
    "minimum": -100,
    "type": "number"
   },
   "status": {
    "enum": [
     "new",
     "shortlisted",
     "dismissed",
     "read",
     "applied",
     "needs-review"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "radar_queue",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authority": {
    "const": "candidate-only",
    "type": "string"
   },
   "papers": {
    "items": {},
    "type": "array"
   }
  },
  "required": [
   "authority",
   "papers"
  ],
  "type": "object"
 },
 "title": "Get research review queue"
}
