{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get a property's calendar"
 },
 "description": "Day-by-day availability and pricing for one property over a date range \u2014 the direct answer to 'is it free, and at what price?'. Hostfully: GET /api/v3.3/property-calendar/{propertyUid}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "availability_comments": {
    "description": "Include availability comments.",
    "type": "boolean"
   },
   "from": {
    "description": "First day (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "property_uid": {
    "description": "The property's UID.",
    "type": "string"
   },
   "to": {
    "description": "Last day (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "property_uid",
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "hostfully_get_property_calendar",
 "title": "Get a property's calendar"
}
