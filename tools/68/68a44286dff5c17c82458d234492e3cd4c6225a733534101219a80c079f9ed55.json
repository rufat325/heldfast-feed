 "description": "\u3010\u9700\u8981\u767b\u5f55\u3011\u4ec5\u5728\u7528\u6237\u660e\u786e\u8bf4\u5df2\u505a\u8054\u7cfb\u5e76\u7ed9\u51fa\u7ed3\u679c\u65f6\u8bb0\u5f55\uff1b\u4e0d\u6267\u884c\u62e8\u53f7\u3001\u77ed\u4fe1\u6216\u53d1\u9001\u3002\u9ed8\u8ba4\u9884\u89c8\uff0c\u7528\u6237\u786e\u8ba4\u540e\u540c\u53c2\u6570\u5e26hash\u6267\u884c\uff1b\u4e0d\u83b7\u53d6\u8054\u7cfb\u65b9\u5f0f\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channel": {
    "enum": [
     "call",
     "sms",
     "wechat",
     "email",
     "other"
    ],
    "type": "string"
   },
   "conversationId": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "done": {
    "default": false,
    "type": "boolean"
   },
   "note": {
    "maxLength": 1000,
    "type": "string"
   },
   "organizationId": {
    "$ref": "#/properties/conversationId"
   },
   "preview": {
    "default": true,
    "type": "boolean"
   },
   "previewHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "enum": [
     "reached",
     "no_answer",
     "busy",
     "added",
     "sent",
     "refused"
    ],
    "type": "string"
   },
   "userReportedContact": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "conversationId",
   "channel",
   "result",
   "userReportedContact"
  ],
  "type": "object"
 },
 "name": "log_host_followup",
 "title": "\u8bb0\u5f55\u5df2\u5b8c\u6210\u7684\u4eba\u5de5\u8054\u7cfb"
}
