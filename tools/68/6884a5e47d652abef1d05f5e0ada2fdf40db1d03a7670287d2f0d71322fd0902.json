 "description": "Stock and other securities trades reported by members of the US Congress, one row per trade, newest report first by default. Filter by member (bioguide ID or name), ticker, chamber, party, type (buy, sell, exchange), report filing dates (filed_from, filed_to) and trade dates (traded_from, traded_to). Each row has the member (bioguide, name, party, chamber, state), the asset and reported ticker, asset_class, type (purchase, sale_full, sale_partial, sale or exchange), owner (self, spouse, joint or child), traded_date and filed_date, delay_days (days from the trade to its first report; null when the reported trade date is after the filing date, a typo flagged by trade_date_error), late (reported more than 45 days after the trade), the amount range, the official source_url, and livermore.club links for the member and the stock (stock_url is null when the asset is not a listed company). totals summarize all trades matching the filters, not just this page. Data: House and Senate periodic transaction reports (PTRs) filed since 2020-01-01, from the U.S. House Clerk and the Senate Office of Public Records (eFD), updated daily. Amounts are the statutory ranges members report, not exact values: amount_min_usd to amount_max_usd, where a null amount_max_usd is an 'Over $X' range; estimated volumes add up range midpoints (an 'Over $X' range counts as X), so treat them as rough sizes. Trades replaced by an amendment and duplicates reported again in a later filing are left out. Paper and scanned reports are listed on member pages but their trades are not read. At most 200 rows per call; use page for more.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "chamber": {
    "description": "house or senate.",
    "enum": [
     "house",
     "senate"
    ],
    "type": "string"
   },
   "filed_from": {
    "description": "Earliest filing date of the report, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "filed_to": {
    "description": "Latest filing date of the report, YYYY-MM-DD, inclusive.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Maximum rows to return (1-200, default 25).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "member": {
    "description": "Only this member of Congress: a bioguide ID (e.g. P000197) or a name (e.g. Pelosi, Nancy Pelosi, Bernie Sanders). A name that matches several members returns an error listing them.",
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number starting at 1; each page has `limit` rows. Check has_more.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "party": {
    "description": "democrat, republican or independent (the member's latest party).",
    "enum": [
     "democrat",
     "republican",
     "independent"
    ],
    "type": "string"
   },
   "sort": {
    "default": "filed",
    "description": "filed = newest report first (default); traded = most recent trade first; amount = largest amount range first.",
    "enum": [
     "filed",
     "traded",
     "amount"
    ],
    "type": "string"
   },
   "ticker": {
    "description": "Only trades in this company (all its share classes, options and former tickers), e.g. MSFT. A ticker that is not a listed company (many ETFs and funds) matches the ticker as reported.",
    "maxLength": 12,
    "minLength": 1,
    "type": "string"
   },
   "traded_from": {
    "description": "Earliest trade date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "traded_to": {
    "description": "Latest trade date, YYYY-MM-DD, inclusive.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "type": {
    "description": "buy (purchases), sell (full, partial or unspecified sales) or exchange.",
    "enum": [
     "buy",
     "sell",
     "exchange"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
