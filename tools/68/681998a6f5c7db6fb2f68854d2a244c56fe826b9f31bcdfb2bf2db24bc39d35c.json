{
 "annotations": {
  "readOnlyHint": true,
  "title": "Generate meta tags"
 },
 "description": "Generate an HTML <head> meta-tag block (title, description, canonical, robots, Open Graph, Twitter Card) from page details. All fields optional.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "author": {
    "description": "Content author.",
    "type": "string"
   },
   "canonical": {
    "description": "Canonical URL (also used for og:url).",
    "type": "string"
   },
   "description": {
    "description": "Meta description (og:description fallback).",
    "type": "string"
   },
   "keywords": {
    "description": "Comma-separated keywords.",
    "type": "string"
   },
   "ogDescription": {
    "description": "Open Graph description; defaults to description.",
    "type": "string"
   },
   "ogImage": {
    "description": "Open Graph / Twitter image URL.",
    "type": "string"
   },
   "ogTitle": {
    "description": "Open Graph title; defaults to title.",
    "type": "string"
   },
   "ogType": {
    "description": "Open Graph type, e.g. \"website\" or \"article\".",
    "type": "string"
   },
   "robots": {
    "description": "Robots directive, e.g. \"index, follow\".",
    "type": "string"
   },
   "title": {
    "description": "Page title (<title> and og:title fallback).",
    "type": "string"
   },
   "twitterCard": {
    "description": "Twitter card type, e.g. \"summary_large_image\".",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "generate_meta_tags",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "html": {
    "description": "The generated <head> meta-tag block as HTML.",
    "type": "string"
   }
  },
  "required": [
   "html"
  ],
  "type": "object"
 },
 "title": "Generate meta tags"
}
