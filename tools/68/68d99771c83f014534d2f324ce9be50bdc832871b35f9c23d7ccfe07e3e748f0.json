{
 "description": "Prune a JSON string using signal keys. Auto-classifies URL against built-in API rules (GitHub, npm, HackerNews, weather, Reddit, JSONPlaceholder). Keeps only signal-matched keys, applies alias remapping, flattens to markdown.",
 "inputSchema": {
  "properties": {
   "aliases": {
    "description": "Key alias remapping (e.g. stargazers_count -> stars)",
    "type": "object"
   },
   "json": {
    "description": "Raw JSON string to prune",
    "type": "string"
   },
   "signals": {
    "description": "Signal keys to keep (overrides auto-classification)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "smallThreshold": {
    "description": "Bypass threshold in tokens (default 300)",
    "type": "number"
   },
   "stripAnsiCodes": {
    "description": "Strip ANSI before processing",
    "type": "boolean"
   },
   "url": {
    "description": "Original URL for auto-classification (e.g. https://api.github.com/repos/vercel/next.js)",
    "type": "string"
   }
  },
  "required": [
   "json"
  ],
  "type": "object"
 },
 "name": "apply_json_semantic"
}
