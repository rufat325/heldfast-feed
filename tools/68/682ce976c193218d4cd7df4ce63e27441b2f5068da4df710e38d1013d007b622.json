     "type": "string"
    },
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "state": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "id",
   "title",
