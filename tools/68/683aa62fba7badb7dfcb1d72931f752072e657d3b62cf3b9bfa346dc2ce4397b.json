{
 "annotations": {
  "title": "Set game settings"
 },
 "description": "Update the bot's client-side game settings (view distance, chat level, main hand, skin parts, etc.) via bot.setSettings. Only the fields you provide are changed. Returns the resulting bot.settings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chat": {
    "description": "Chat visibility level",
    "enum": [
     "enabled",
     "commandsOnly",
     "disabled"
    ],
    "type": "string"
   },
   "colorsEnabled": {
    "description": "Whether chat colors are enabled",
    "type": "boolean"
   },
   "difficulty": {
    "description": "Client difficulty value",
    "type": "number"
   },
   "enableServerListing": {
    "description": "Allow appearing in the server player listing",
    "type": "boolean"
   },
   "enableTextFiltering": {
    "description": "Enable server-side text filtering",
    "type": "boolean"
   },
   "mainHand": {
    "description": "Dominant hand",
    "enum": [
     "left",
     "right"
    ],
    "type": "string"
   },
   "skinParts": {
    "additionalProperties": {
     "type": "boolean"
    },
    "description": "Map of skin part toggles, e.g. { showCape: true, showJacket: false }",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "viewDistance": {
    "anyOf": [
     {
      "enum": [
       "far",
       "normal",
       "short",
       "tiny"
      ],
      "type": "string"
     },
     {
      "type": "number"
     }
    ],
    "description": "Named distance (\"far\"|\"normal\"|\"short\"|\"tiny\") or a numeric chunk radius"
   }
  },
  "type": "object"
 },
 "name": "set_settings"
}
