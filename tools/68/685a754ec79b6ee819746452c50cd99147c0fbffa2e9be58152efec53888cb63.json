{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read PostgreSQL health, current sessions and blocking locks. For a performance review explicitly request performanceChecks: query_statistics (pg_stat_statements), tables, indexes, vacuum, io. Optional checks use bounded fixed read-only queries and report availability/reasons individually. performanceLimit defaults to 5 rows per sample (maximum 20); cumulative statistics are not a recent time window. No arbitrary SQL, EXPLAIN ANALYZE, query cancellation or maintenance is exposed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "performanceChecks": {
    "items": {
     "enum": [
      "query_statistics",
      "tables",
      "indexes",
      "vacuum",
      "io"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "performanceLimit": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "sourceId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "sourceId"
  ],
  "type": "object"
 },
 "name": "inspect_database",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "ok",
     "error"
    ],
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 }
}
