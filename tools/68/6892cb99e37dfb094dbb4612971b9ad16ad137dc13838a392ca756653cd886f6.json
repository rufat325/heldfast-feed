{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Check Evidence Freshness"},"description":"Check whether typed attestation evidence is still fresh. Rotating evidence requires a ttl, snapshot evidence takes an optional maxAge, and static evidence is always fresh.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"max_age":{"description":"Seconds (optional for snapshot)","type":"number"},"now":{"description":"ISO 8601 override for current time","type":"string"},"ttl":{"description":"Seconds (required for rotating)","type":"number"},"type":{"enum":["rotating","snapshot","static"],"type":"string"},"valid_at":{"description":"ISO 8601 timestamp evidence was produced","type":"string"}},"required":["type","valid_at"],"type":"object"},"name":"is_evidence_fresh","title":"Check Evidence Freshness"}
