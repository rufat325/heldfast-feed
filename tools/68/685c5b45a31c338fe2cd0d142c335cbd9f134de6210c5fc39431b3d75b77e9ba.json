    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Appointment type id (path)."
   },
   "business_id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Business id (path)."
   },
   "from": {
    "description": "Optional earliest date yyyy-mm-dd to search from.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "practitioner_id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Practitioner id (path)."
   }
  },
  "required": [
   "business_id",
   "practitioner_id",
   "appointment_type_id"
  ],
  "type": "object"
 },
 "name": "cliniko_next_available_time",
 "title": "Next available time"
}
