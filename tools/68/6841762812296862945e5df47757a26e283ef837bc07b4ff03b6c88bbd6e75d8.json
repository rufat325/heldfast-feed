{
 "description": "Semantic search over your memories (GET /v1/memory/search). Requires LITHTRIX_API_KEY and server-side vector + embedding configuration. Returns ranked results with similarity scores.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "importance": {
    "description": "Optional importance tier (default normal on API if omitted)",
    "enum": [
     "critical",
     "high",
     "normal",
     "low"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results (1\u201320, default 5)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Natural-language search query",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "threshold": {
    "description": "Minimum similarity 0\u20131 (default 0.7 on API)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "lithtrix_memory_search"
}
