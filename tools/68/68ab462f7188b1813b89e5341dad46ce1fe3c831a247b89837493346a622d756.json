{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "Ranked public leaderboard \u2014 the same data human traders see. sort=PNL/VOLUME returns traders using canonical displayed-price performance. Legacy sort=RETURN aliases PNL; return percentage fields are null and no return is calculated. Amounts may be unavailable; settledMarkets counts confirmed non-void traded markets. RISK_ADJ_PNL is a legacy adapter; sort=CREATOR_QUALITY returns creators (track record + tier); sort=VOTERS returns voters. Every row carries the wallet and its black-box reputation tier.",
 "inputSchema": {
  "$defs": {
   "LeaderboardPeriod": {
    "description": "Window the board covers: `7d` is THIS CALENDAR WEEK (from Monday 00:00 UTC) and `30d` THIS CALENDAR MONTH \u2014 calendar windows since 2026-09-18, not trailing days; the keys are kept because this enum never renames a member. `all` is the life score, `season` the 2026 championship's fixed window, `season7d`/`season30d` the same calendar week and month clamped inside it. OPEN enum: windows are added over time \u2014 tolerate unseen values.",
    "enum": [
     "7d",
     "30d",
     "all",
     "season",
     "season7d",
     "season30d"
    ],
    "type": "string",
    "x-extensible-enum": true
   },
   "LeaderboardSort": {
    "description": "Board ordering. `MARKETS`, `SETTLED` and `WINS` rank the table's count columns; `WIN_RATE` ranks Wins \u00f7 Settled among accounts with enough settled markets; `ROI` ranks P&L \u00f7 PM spent over closed calls (sold out, or held to a resolved winner) among accounts with enough of them. Ties on any board are ordered by Volume, then P&L. OPEN enum: boards are added over time \u2014 tolerate unseen values.",
    "enum": [
     "PNL",
     "VOLUME",
     "RISK_ADJ_PNL",
     "CREATOR_QUALITY",
     "VOTERS",
     "RETURN",
     "MARKETS",
     "SETTLED",
     "WINS",
     "WIN_RATE",
     "ROI"
    ],
    "type": "string",
    "x-extensible-enum": true
   },
   "ServedCollateralSymbol": {
    "description": "Collateral symbol as this venue currently offers it. Read the live set from GET /markets/config or GET /discover/contracts rather than assuming the set in this document.",
    "maxLength": 16,
    "minLength": 1,
    "type": "string"
   }
  },
  "properties": {
   "category": {
    "default": "ALL",
    "description": "Market category for PNL and VOLUME.",
    "enum": [
     "ALL",
     "CRYPTO",
     "SPORTS",
     "POLITICS",
     "ELECTIONS",
     "FINANCE",
     "TECH",
     "WORLD",
     "ECONOMY",
     "CULTURE",
     "WEATHER",
     "SCIENCE_HEALTH",
     "AI",
     "GAMING",
     "BUSINESS",
     "FASHION",
     "MOVIES_TV",
     "MUSIC",
     "SHOPPING",
     "BEAUTY",
     "TRAVEL",
     "CLIMATE",
     "DAILY_LIFE",
     "LOCAL",
     "SOCIAL",
     "FUN",
     "OTHER"
    ],
    "type": "string"
   },
   "collateral": {
    "$ref": "#/$defs/ServedCollateralSymbol",
    "description": "Collateral symbol whose board to read. Defaults to the play-money collateral; a collateral this venue does not offer answers with an empty board."
   },
   "generation": {
    "description": "Pin the generation from the preceding leaderboard response.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 200,
    "minimum": 0,
    "type": "integer"
   },
   "period": {
    "$ref": "#/$defs/LeaderboardPeriod",
    "default": "7d",
    "description": "7d, 30d, all (the life score), season \u2014 the 2026 championship window \u2014 or season7d / season30d, the rolling 7- and 30-day windows clamped inside the championship."
   },
   "sort": {
    "$ref": "#/$defs/LeaderboardSort",
    "default": "PNL",
    "description": "PNL, VOLUME (traders). Legacy RETURN aliases PNL. RISK_ADJ_PNL is legacy. CREATOR_QUALITY (creators), or VOTERS."
   }
  },
  "type": "object"
 },
