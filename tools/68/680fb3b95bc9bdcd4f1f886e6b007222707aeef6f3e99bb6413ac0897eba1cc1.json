  "readOnlyHint": true,
  "title": "Tour departures"
 },
 "description": "Returns a tour's departures with the price of every occupancy slot for each (adult, single, extra bed, children, infant). Prices are not trimmed; every occupancy slot is listed. Past departures are excluded. Paged by date: default 12 per page; nextCursor is the cursor of the next page. The dates returned are the only departure dates the catalogue holds.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "currency": {
    "description": "Price currency.",
    "enum": [
     "EUR",
     "USD",
     "AED"
    ],
    "type": "string"
   },
   "cursor": {
    "description": "nextCursor from the previous response.",
    "maxLength": 500,
    "type": "string"
   },
   "from": {
    "description": "Departures on or after this date (YYYY-MM-DD)",
    "format": "date",
    "maxLength": 10,
    "minLength": 10,
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "language": {
    "description": "Catalogue language.",
    "enum": [
     "tr",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Departures per page. Default 12.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "slug": {
    "maxLength": 200,
    "type": "string"
   },
   "to": {
    "description": "Departures on or before this date (YYYY-MM-DD)",
    "format": "date",
    "maxLength": 10,
    "minLength": 10,
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "language",
   "currency",
   "slug"
  ],
  "type": "object"
 },
 "name": "get_departures",
