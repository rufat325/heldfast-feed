{
 "description": "Risk profile of one wallet address across chains: risk score, mixer funding and source, dormancy, transaction count and value, protocols used, bridge count, flagged (true when funded by a mixer or on the OFAC SDN list, with flagReasons), plus its recent bridge, mixer and transfer events. sanctioned: on the OFAC SDN address list. entity: the exchange name when the address is a labelled exchange hot wallet or deposit address. A wallet dropped from the live profile table in the last 30 days is answered from its newest saved profile (fromHistory true, evictedAt); history lists the saved profiles of the last 30 days, newest first, up to 20 per chain. Public onchain behaviour only. Price: 5 cents per call.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "address": {
    "type": "string"
   },
   "chain": {
    "enum": [
     "bitcoin",
     "ethereum",
     "bnb",
     "solana",
     "avalanche",
     "xrp",
     "tron",
     "polygon",
     "sui"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object",
  "x-aliases": {
   "address": [
    "Address"
   ]
  },
  "x-lexicon": {
   "bundleSha256": "25cc80db6d8e9eac73d47a50f7ad6333a21f1972d008a8fed0159de8bfb4b519",
   "name": "ChainHelix Agentic Lexicon",
   "resolve": "lexicon_resolve",
   "spec": "lexicon_spec",
   "version": "0.2.0"
  },
  "x-vocab": {
   "address": "onchain.addressApi",
   "chain": "onchain.chain"
  }
 },
 "name": "wallet_risk",
