{
 "description": "Preview how explicit updates would change an existing prose-styleguide.config.yaml without writing any files.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "project_id": {
    "description": "Project ID when previewing project_root config updates (e.g. 'the-lamb' or 'universe-1/book-1').",
    "type": "string"
   },
   "scope": {
    "description": "Config scope to preview updates for.",
    "enum": [
     "sync_root",
     "project_root"
    ],
    "type": "string"
   },
   "updates": {
    "additionalProperties": false,
    "description": "Explicit config field changes to preview at the selected scope.",
    "properties": {
     "abbreviation_periods": {
      "enum": [
       "with",
       "without"
      ],
      "type": "string"
     },
     "date_format": {
      "enum": [
       "mdy",
       "dmy"
      ],
      "type": "string"
     },
     "dialogue_tags": {
      "enum": [
       "minimal",
       "expressive"
      ],
      "type": "string"
     },
     "ellipsis_style": {
      "enum": [
       "three_periods",
       "ellipsis_char",
       "spaced"
      ],
      "type": "string"
     },
     "em_dash_spacing": {
      "enum": [
       "closed",
       "spaced"
      ],
      "type": "string"
     },
     "language": {
      "enum": [
       "english_us",
       "english_uk",
       "english_au",
       "english_ca",
       "swedish",
       "norwegian",
       "danish",
       "finnish",
       "french",
       "italian",
       "russian",
       "portuguese_pt",
       "portuguese_br",
       "german",
       "dutch",
       "polish",
       "czech",
       "hungarian",
       "spanish",
       "irish",
       "japanese",
       "korean",
       "chinese_traditional",
       "chinese_simplified"
      ],
      "type": "string"
     },
     "numbers": {
      "enum": [
       "spell_under_10",
       "spell_under_100",
       "always_spell",
       "numerals"
      ],
      "type": "string"
     },
     "oxford_comma": {
      "enum": [
       "yes",
       "no"
      ],
      "type": "string"
     },
     "pov": {
      "enum": [
       "first",
       "third_limited",
       "third_omniscient"
      ],
      "type": "string"
     },
     "quotation_style": {
      "enum": [
       "double",
       "single",
       "guillemets",
       "low9",
       "dialogue_dash_en",
       "dialogue_dash_em",
       "corner_brackets"
      ],
      "type": "string"
     },
     "quotation_style_nested": {
      "enum": [
       "double",
       "single",
       "guillemets_single",
       "low9_single",
       "corner_brackets_double"
      ],
      "type": "string"
     },
     "sentence_fragments": {
      "enum": [
       "disallow",
       "intentional"
      ],
      "type": "string"
     },
     "spelling": {
      "enum": [
       "uk",
       "us",
       "au",
       "ca"
      ],
      "type": "string"
     },
     "tense": {
      "type": "string"
     },
     "time_format": {
      "enum": [
       "12h",
       "24h"
      ],
      "type": "string"
     },
     "voice_notes": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "scope",
   "updates"
  ],
  "type": "object"
 },
 "name": "preview_prose_styleguide_config_update"
}
