{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Validate Style Tool"
 },
 "description": "Validates Mapbox style JSON against the Mapbox Style Specification, checking for errors, warnings, and providing suggestions for improvement",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "style": {
    "anyOf": [
     {
      "maxLength": 10485760,
      "type": "string"
     },
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "Mapbox style JSON object or JSON string to validate against the Mapbox Style Specification"
   }
  },
  "required": [
   "style"
  ],
  "type": "object"
 },
 "name": "validate_style_tool",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "errors": {
    "description": "Critical errors that prevent the style from working",
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "description": "Description of the validation issue",
       "type": "string"
      },
      "path": {
       "description": "JSON path to the problematic property",
       "type": "string"
      },
      "severity": {
       "description": "Severity level of the issue",
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      },
      "suggestion": {
       "description": "Suggested fix for the issue",
       "type": "string"
      }
     },
     "required": [
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "info": {
    "description": "Informational messages and suggestions for improvement",
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "description": "Description of the validation issue",
       "type": "string"
      },
      "path": {
       "description": "JSON path to the problematic property",
       "type": "string"
      },
      "severity": {
       "description": "Severity level of the issue",
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      },
      "suggestion": {
       "description": "Suggested fix for the issue",
       "type": "string"
      }
     },
     "required": [
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "additionalProperties": false,
    "description": "Summary of style structure",
    "properties": {
     "hasGlyphs": {
      "description": "Whether style has glyphs defined",
      "type": "boolean"
     },
     "hasSprite": {
      "description": "Whether style has sprite defined",
      "type": "boolean"
     },
     "layerCount": {
      "description": "Number of layers",
      "type": "number"
     },
     "sourceCount": {
      "description": "Number of sources",
      "type": "number"
     },
     "version": {
      "description": "Style specification version",
      "type": "number"
     }
    },
    "required": [
     "layerCount",
     "sourceCount",
     "hasSprite",
     "hasGlyphs"
    ],
    "type": "object"
   },
   "valid": {
    "description": "Whether the style is valid",
    "type": "boolean"
   },
   "warnings": {
    "description": "Non-critical issues that may cause unexpected behavior",
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "description": "Description of the validation issue",
       "type": "string"
      },
      "path": {
       "description": "JSON path to the problematic property",
       "type": "string"
      },
      "severity": {
       "description": "Severity level of the issue",
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      },
      "suggestion": {
       "description": "Suggested fix for the issue",
       "type": "string"
      }
     },
     "required": [
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "valid",
   "errors",
   "warnings",
   "info",
   "summary"
  ],
  "type": "object"
 },
 "title": "Validate Style Tool"
}
