{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read mailbox metadata in one call. Pick any subset of {aliases, signatures, backups} via the `fields` argument; the tool hits only the corresponding endpoints in parallel. Replaces the v0.9 trio `get_mailbox_aliases` / `get_mailbox_signatures` / `get_mailbox_backups` with no loss of capability.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "fields": {
    "default": [
     "aliases",
     "signatures",
     "backups"
    ],
    "description": "Sections to fetch. Each adds one API call. Omit to fetch all three.",
    "items": {
     "enum": [
      "aliases",
      "signatures",
      "backups"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "mail_hosting_id": {
    "description": "Mail hosting ID. Discover via infomaniak_list_mail_hostings.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "mailbox_name": {
    "description": "Local part of the mailbox (the part before @, e.g. 'anthony' for anthony@coden.lu). NOT the full email address.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "mail_hosting_id",
   "mailbox_name"
  ],
  "type": "object"
 },
 "name": "infomaniak_get_mailbox_info",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "aliases": {
    "additionalProperties": true,
    "properties": {
     "aliases": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "enabled_alias": {
      "type": "boolean"
     }
    },
    "required": [
     "aliases"
    ],
    "type": "object"
   },
   "backups": {
    "additionalProperties": true,
    "properties": {
     "backups": {
      "items": {},
      "type": "array"
     },
     "state": {}
    },
    "required": [
     "backups"
    ],
    "type": "object"
   },
   "errors": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "fields": {
    "items": {
     "enum": [
      "aliases",
      "signatures",
      "backups"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "mail_hosting_id": {
    "type": "number"
   },
   "mailbox_name": {
    "type": "string"
   },
   "signatures": {
    "additionalProperties": true,
    "properties": {
     "aliases": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "default_reply_signature_id": {
      "type": [
       "number",
       "null"
      ]
     },
     "default_signature_id": {
      "type": [
       "number",
       "null"
      ]
     },
     "is_forced": {
      "type": "boolean"
     },
     "signatures": {
      "items": {},
      "type": "array"
     },
     "valid_emails": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "verified_emails": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "signatures"
    ],
    "type": "object"
   }
  },
  "required": [
   "mail_hosting_id",
