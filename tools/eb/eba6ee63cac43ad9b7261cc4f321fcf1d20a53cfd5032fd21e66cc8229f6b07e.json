{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Wait for a resource action to reach success or error and return its full details. The timeout includes API requests and rate-limit delays.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action_id": {
    "description": "Action ID to wait for",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "domain": {
    "description": "Resource domain owning the action",
    "enum": [
     "servers",
     "load_balancers",
     "volumes",
     "networks",
     "firewalls",
     "floating_ips",
     "primary_ips",
     "certificates",
     "images",
     "zones",
     "storage_boxes"
    ],
    "type": "string"
   },
   "resource_id": {
    "description": "Resource ID owning the action",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "timeout": {
    "default": 300,
    "description": "Maximum wait in seconds, including requests and rate-limit delays (default 300, max 3600)",
    "exclusiveMinimum": 0,
    "maximum": 3600,
    "type": "number"
   }
  },
  "required": [
   "domain",
   "resource_id",
   "action_id"
  ],
  "type": "object"
 },
 "name": "hetzner_wait_for_action",
 "title": "Wait for Action"
}
