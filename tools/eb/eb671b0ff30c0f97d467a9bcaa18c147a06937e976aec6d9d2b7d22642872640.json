{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Schedule a completed project export to Instagram. Optional includeAffiliateCta appends Try BlitzReels for free plus the Affonso tracking URL. Requires an active Instagram account connected in the BlitzReels UI.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "affiliateCtaText": {
    "description": "Optional CTA text override (max 80).",
    "type": "string"
   },
   "affiliateTrackingUrl": {
    "description": "Optional BlitzReels URL with via/ref/aff override.",
    "type": "string"
   },
   "caption": {
    "description": "Caption text (max 2200).",
    "type": "string"
   },
   "connectionId": {
    "description": "Instagram connection UUID when multiple exist.",
    "type": "string"
   },
   "exportId": {
    "description": "Completed export UUID. Defaults to latest completed. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "includeAffiliateCta": {
    "default": false,
    "description": "Append Try BlitzReels for free plus Affonso tracking URL.",
    "type": "boolean"
   },
   "projectId": {
    "description": "Project UUID. UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "scheduledFor": {
    "description": "ISO-8601 datetime for the scheduled publish.",
    "type": "string"
   },
   "shareToFeed": {
    "description": "Also share Reel to profile feed.",
    "type": "boolean"
   },
   "timezone": {
    "default": "UTC",
    "description": "IANA timezone. Defaults to UTC.",
    "type": "string"
   },
   "trialGraduationStrategy": {
    "anyOf": [
     {
      "enum": [
       "MANUAL",
       "SS_PERFORMANCE"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "trialReel": {
    "description": "Publish as Trial Reel (video only).",
    "type": "boolean"
   }
  },
  "required": [
   "projectId",
   "scheduledFor"
  ],
  "type": "object"
 },
 "name": "publishing_instagram_schedule",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "connectionId": {
    "type": "string"
   },
   "exportId": {
    "type": "string"
   },
   "platform": {
    "type": "string"
   },
   "postId": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "publishKind": {
    "type": "string"
   },
   "scheduledFor": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "targetId": {
    "type": "string"
   }
  },
  "required": [
   "postId",
   "targetId",
   "platform",
   "status",
   "scheduledFor",
   "connectionId",
   "exportId",
   "projectId",
   "publishKind"
  ],
  "type": "object"
 },
 "title": "Schedule Instagram Publish"
}
