 },
 "description": "Historical price series for one outcome token. Interval controls the window (e.g. \"1d\", \"1w\", \"1m\", \"max\"); fidelity is the candle resolution in minutes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fidelity": {
    "description": "Candle resolution in minutes, default 30",
    "minimum": 1,
    "type": "integer"
   },
   "interval": {
    "description": "Window: 1h, 6h, 1d, 1w, 1m, max (default max)",
    "type": "string"
   },
   "tokenId": {
    "description": "CLOB token id",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "tokenId"
  ],
  "type": "object"
 },
 "name": "swop_get_price_history",
 "title": "Get price history for an outcome token"
}
