{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Free provider-neutral capability resolution. Applies eligibility constraints, preserves UNKNOWN and abstains when evidence is insufficient. Advisory only: never authorizes payment or execution.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "task"
    ]
   },
   {
    "required": [
     "capability"
    ]
   }
  ],
  "properties": {
   "capability": {
    "type": "string"
   },
   "constraints": {
    "properties": {
     "allowedAssets": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "allowedNetworks": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "allowedProviders": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "currency": {
      "type": "string"
     },
     "deadlineMs": {
      "minimum": 0,
      "type": "integer"
     },
     "excludedProviders": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "freshnessSeconds": {
      "minimum": 0,
      "type": "integer"
     },
     "jurisdiction": {
      "type": "string"
     },
     "maxPrice": {
      "minimum": 0,
      "type": "number"
     },
     "minimumQuality": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "privacy": {
      "type": "string"
     },
     "requireVerification": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "executionMode": {
    "enum": [
     "SHADOW",
     "ADVISORY",
     "PREFLIGHT"
    ]
   },
   "task": {
    "maxLength": 2000,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "phion_resolve"
}
