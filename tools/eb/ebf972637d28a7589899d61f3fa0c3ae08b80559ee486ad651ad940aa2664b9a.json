{
 "description": "Fetch any URL and return clean content. HTML pages converted to markdown. SSRF-protected. Rate limit: 20/day per user",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "Output format (default: markdown)",
    "enum": [
     "markdown",
     "text",
     "html",
     "json"
    ],
    "type": "string"
   },
   "max_length": {
    "description": "Max output characters (default: 50000, max: 200000)",
    "type": "number"
   },
   "url": {
    "description": "URL to fetch (http:// or https://)",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "chaprola_fetch"
}
