{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a task"
 },
 "description": "WRITE: create a follow-up task, optionally tied to a constituent and assigned to a user (find user Ids via bloomerang_get_current_user or existing tasks). Bloomerang: POST /task.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignee_user_id": {
    "description": "User Id to assign it to.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "channel": {
    "description": "Planned channel.",
    "enum": [
     "Email",
     "MassEmail",
     "Phone",
     "TextMessage",
     "Mail",
     "InPerson",
     "SocialMedia",
     "Website",
     "Twitter",
     "Other",
     "EngagementSurveyEmail",
     "EngagementSurvey"
    ],
    "type": "string"
   },
   "constituent_id": {
    "description": "Constituent the task is about.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "due_date": {
    "description": "Due date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "note": {
    "description": "Details.",
    "type": "string"
   },
   "purpose": {
    "description": "Planned purpose.",
    "enum": [
     "Acknowledgement",
     "ImpactCultivation",
     "Newsletter",
     "Receipt",
     "Solicitation",
     "SpecialEvent",
     "VolunteerActivity",
     "PledgeReminder",
     "Welcome",
     "BenevonPointOfEntry",
     "BenevonFollowUp",
     "BenevonAskEvent",
     "BenevonOneOnOneAsk",
     "BenevonOngoingCultivation",
     "Other"
    ],
    "type": "string"
   },
   "send_notifications": {
    "description": "If true, Bloomerang emails the assignee about the task. Default false.",
    "type": "boolean"
   },
   "subject": {
    "description": "Short subject line.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "due_date",
   "subject"
  ],
  "type": "object"
 },
 "name": "bloomerang_create_task",
 "title": "Create a task"
}
