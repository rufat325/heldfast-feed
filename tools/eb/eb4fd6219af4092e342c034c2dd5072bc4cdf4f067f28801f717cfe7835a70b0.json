 "description": "$0.10 once, for 30 days. Use when a Discord or Telegram room you own should get pump.fun and Robinhood Chain alerts posted without running a server. Input: destination (a Discord webhook URL, or telegram:<bot_token>:<chat_id>; any other host is refused before payment), kinds (graduation_odds, ring_flags, graduations, avoid_flips), optional filters. A test message is posted first and the payment settles when it arrives; a failed test is unpaid. Then every 60 s each new item is posted as one plain-text message with its public record and paid card links; at most 20 messages an hour and 200 a day. The destination is stored encrypted and never echoed. Unsubscribe with the link in the answer. To poll from code: launches_since ($0.001).",
 "inputSchema": {
  "properties": {
   "destination": {
    "description": "Your room's delivery endpoint: a Discord webhook URL https://discord.com/api/webhooks/<id>/<token>, or telegram:<bot_token>:<chat_id> for a Telegram bot you own. Send it in the POST JSON body or the X-Alert-Destination header: a query string can be recorded by proxies.",
    "maxLength": 300,
    "minLength": 20,
    "type": "string"
   },
   "kinds": {
    "description": "One or more of graduation_odds, ring_flags, graduations, avoid_flips.",
    "items": {
     "enum": [
      "graduation_odds",
      "ring_flags",
      "graduations",
      "avoid_flips"
     ],
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   },
   "label": {
    "default": "",
    "description": "optional name printed at the start of every message (letters, digits, spaces and basic punctuation)",
    "maxLength": 40,
    "type": "string"
   },
   "max_age_s": {
    "default": 0,
    "description": "keep items whose launch was at most this many seconds old when the item was recorded; for graduations the time to graduation (0 = no limit)",
    "maximum": 86400,
    "minimum": 0,
    "type": "number"
   },
   "min_p_grad": {
    "default": 0,
    "description": "graduation_odds and avoid_flips: keep items whose P(true graduation) at publication is at least this (0 = no floor)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "pumpfun_only": {
    "default": false,
    "description": "true: leave out the Robinhood Chain kind (ring_flags)",
    "type": "boolean"
   },
   "rhc_only": {
    "default": false,
    "description": "true: leave out the pump.fun kinds",
    "type": "boolean"
   }
  },
  "required": [
   "destination",
   "kinds"
  ],
  "type": "object"
 },
