{
 "description": "Unified tool for all breakpoint operations (set, get, list, configure, toggle, remove)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "set_software",
        "type": "string"
       },
       "address": {
        "description": "Address of the breakpoint",
        "type": "string"
       },
       "singleshot": {
        "type": "boolean"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "set_hardware",
        "type": "string"
       },
       "address": {
        "type": "string"
       },
       "size": {
        "description": "Hardware size",
        "enum": [
         "1",
         "2",
         "4",
         "8"
        ],
        "type": "string"
       },
       "type": {
        "description": "Hardware BP type (read/write/execute)",
        "enum": [
         "r",
         "w",
         "x"
        ],
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "set_memory",
        "type": "string"
       },
       "address": {
        "type": "string"
       },
       "type": {
        "description": "Memory BP type",
        "enum": [
         "a",
         "r",
         "w",
         "x"
        ],
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "delete",
        "type": "string"
       },
       "address": {
        "type": "string"
       },
       "type": {
        "enum": [
         "software",
         "hardware",
         "memory"
        ],
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "enable",
        "type": "string"
       },
       "address": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "disable",
        "type": "string"
       },
       "address": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "toggle",
        "type": "string"
       },
       "address": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "set_condition",
        "type": "string"
       },
       "address": {
        "type": "string"
       },
       "condition": {
        "description": "Expression, e.g. eax==0",
        "type": "string"
       }
      },
      "required": [
       "action",
       "address",
       "condition"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "set_log",
        "type": "string"
       },
       "address": {
        "type": "string"
       },
       "text": {
        "description": "Format string for logging",
        "type": "string"
       }
      },
      "required": [
       "action",
       "address",
       "text"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "reset_hit_count",
        "type": "string"
       },
       "address": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "get",
        "type": "string"
       },
       "address": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "list",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "configure",
        "type": "string"
       },
       "address": {
        "type": "string"
       },
       "bp_type": {
        "default": "software",
        "enum": [
         "software",
         "hardware",
         "memory"
        ],
        "type": "string"
       },
       "break_condition": {
        "type": "string"
       },
       "command_condition": {
        "type": "string"
       },
       "command_text": {
        "type": "string"
       },
       "fast_resume": {
        "type": "boolean"
       },
       "hw_size": {
        "enum": [
         "1",
         "2",
         "4",
         "8"
        ],
        "type": "string"
       },
       "hw_type": {
        "enum": [
         "r",
         "w",
         "x"
        ],
        "type": "string"
       },
       "log_condition": {
        "type": "string"
       },
       "log_text": {
        "type": "string"
       },
       "mem_type": {
        "enum": [
         "a",
         "r",
         "w",
         "x"
        ],
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "silent": {
        "type": "boolean"
       },
       "singleshot": {
        "type": "boolean"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "configure_batch",
        "type": "string"
       },
       "breakpoints": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "address": {
           "type": "string"
          },
          "bp_type": {
           "enum": [
            "software",
            "hardware",
            "memory"
           ],
           "type": "string"
          },
          "break_condition": {
           "type": "string"
          },
          "command_condition": {
           "type": "string"
          },
          "command_text": {
           "type": "string"
          },
          "fast_resume": {
           "type": "boolean"
          },
          "hw_size": {
           "type": "string"
          },
          "hw_type": {
           "type": "string"
          },
          "log_condition": {
           "type": "string"
          },
          "log_text": {
           "type": "string"
          },
          "mem_type": {
           "type": "string"
          },
          "name": {
           "type": "string"
          },
          "silent": {
           "type": "boolean"
          },
          "singleshot": {
           "type": "boolean"
          }
         },
         "required": [
          "address"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "action",
       "breakpoints"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "x64dbg_breakpoints"
}
