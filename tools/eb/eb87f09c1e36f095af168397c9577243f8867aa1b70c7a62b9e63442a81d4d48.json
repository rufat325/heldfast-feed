{
 "description": "Update a redirect (partial: omitted fields keep their stored value). Returns the redirect.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "enabled": {
    "description": "Redirect is active",
    "type": "boolean"
   },
   "from_url": {
    "description": "Source path or URL (regex when is_regex)",
    "type": "string"
   },
   "id": {
    "description": "Redirect ID",
    "type": "integer"
   },
   "is_regex": {
    "description": "Treat from_url as a regex",
    "type": "boolean"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "to_url": {
    "description": "Target path or URL",
    "type": "string"
   },
   "type": {
    "description": "HTTP status: 301, 302, 307, 410, 451",
    "enum": [
     301,
     302,
     307,
     410,
     451
    ],
    "type": "number"
   }
  },
  "required": [
   "site",
   "id"
  ],
  "type": "object"
 },
 "name": "seo_update_redirect"
}
