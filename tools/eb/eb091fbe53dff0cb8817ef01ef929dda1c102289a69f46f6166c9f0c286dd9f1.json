{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read a bounded, live-revalidated candidate graph for paper versions, proposed issues, protocols and agent-extracted research questions/methods/results/limitations. Extraction nodes are paraphrases anchored to exact review-note bytes and paper locations; they are human-unverified, non-scientific, and never durable Memory.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "max_edges": {
    "default": 500,
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "max_nodes": {
    "default": 200,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "record_id": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "evidence_adoption_graph",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authority": {
    "const": "candidate-only",
    "type": "string"
   },
   "edges": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authority": {
       "const": "candidate-only",
       "type": "string"
      },
      "dst": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "id": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      },
      "record_id": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      },
      "src": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "type": {
       "enum": [
        "CANDIDATE_FOR",
        "PROPOSES_TEST",
        "HAS_PROPOSED_DECISION",
        "CITES_SOURCE_BYTES",
        "CITES_EXECUTION",
        "HAS_AGENT_EXTRACTED_CANDIDATE",
        "PARAPHRASED_IN_REVIEW_NOTE",
        "MOTIVATES_ISSUE"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "src",
      "dst",
      "type",
      "record_id",
      "authority"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "instruction_authority": {
    "const": "none",
    "type": "string"
   },
   "network_requests": {
    "const": 0,
    "type": "number"
   },
   "nodes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "extraction_status": {
       "const": "human-unverified-agent-extraction",
       "type": "string"
      },
      "id": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "kind": {
       "enum": [
        "research-question",
        "method",
        "result",
        "limitation",
        "applicability-hypothesis"
       ],
       "type": "string"
      },
      "paper_location": {
       "maxLength": 160,
       "type": "string"
      },
      "statement_hash": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      },
      "type": {
       "enum": [
        "PaperCitation",
        "ProposedIssue",
        "ExperimentProtocol",
        "ProposedDecision",
        "SourceChunk",
        "ExecutionReceipt",
        "CandidateResearchExtraction"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "type"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "type": "array"
   },
   "privacy": {
    "const": "local-private-no-export",
    "type": "string"
   },
   "records_checked": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "records_current": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "records_excluded": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "schema_version": {
    "const": "dwin.adoption-graph/v1",
    "type": "string"
   },
   "scientific_verification": {
    "const": false,
    "type": "boolean"
   },
   "truncated": {
    "type": "boolean"
   },
   "validations": {
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "record_id": {
         "pattern": "^[a-f0-9]{64}$",
         "type": "string"
        },
        "state": {
         "const": "current",
         "type": "string"
        },
        "validation": {
         "additionalProperties": false,
         "properties": {
          "authority": {
           "const": "candidate-only",
           "type": "string"
          },
          "instruction_authority": {
           "const": "none",
           "type": "string"
          },
          "paper_verification": {
           "const": "cached-abstract-span-not-full-text",
           "type": "string"
          },
          "privacy": {
           "const": "local-private-no-export",
           "type": "string"
          },
          "protocol_hash": {
           "pattern": "^[a-f0-9]{64}$",
           "type": "string"
          },
          "record_id": {
           "pattern": "^[a-f0-9]{64}$",
           "type": "string"
          },
          "result_status": {
           "enum": [
            "not-run",
            "ACCEPTED",
            "REJECTED",
            "ERROR"
           ],
           "type": "string"
          },
          "scientific_verification": {
           "const": false,
           "type": "boolean"
          },
          "source_spans_checked": {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          }
         },
         "required": [
          "record_id",
          "protocol_hash",
          "source_spans_checked",
          "result_status",
          "paper_verification",
          "scientific_verification",
          "authority",
          "instruction_authority",
          "privacy"
         ],
         "type": "object"
        }
       },
       "required": [
        "record_id",
        "state",
        "validation"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "reason_code": {
         "pattern": "^[A-Z][A-Z0-9_]{1,100}$",
         "type": "string"
        },
        "record_id": {
         "pattern": "^[a-f0-9]{64}$",
         "type": "string"
        },
        "state": {
         "const": "historical-unavailable",
         "type": "string"
        }
       },
       "required": [
        "record_id",
        "state",
        "reason_code"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "schema_version",
   "records_checked",
   "records_current",
   "records_excluded",
   "validations",
   "nodes",
   "edges",
   "truncated",
   "network_requests",
   "scientific_verification",
   "authority",
   "instruction_authority",
   "privacy"
  ],
  "type": "object"
 }
}
