{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Move the active claim deadline using the worker token and current receipt. Visibility accepts 30-900 seconds, defaults to 60 seconds and is capped by the original queue expiry. A stale or expired receipt is a conflict. Queue lifetime is never extended.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "job_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   },
   "queue_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   },
   "receipt": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "visibility_timeout": {
    "default": 60,
    "description": "Claim visibility in seconds, capped by the fixed queue expiry.",
    "maximum": 900,
    "minimum": 30,
    "type": "integer"
   },
   "worker_token": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "queue_id",
   "job_id",
   "worker_token",
   "receipt"
  ],
  "type": "object"
 },
 "name": "renew_agent_queue_job",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "expire_timestamp": {
    "type": "integer"
   },
   "job": {
    "additionalProperties": false,
    "properties": {
     "attempts": {
      "maximum": 5,
      "minimum": 0,
      "type": "integer"
     },
     "claimed_until_timestamp": {
      "type": [
       "integer",
       "null"
      ]
     },
     "created_at_timestamp": {
      "type": "integer"
     },
     "expire_timestamp": {
      "type": "integer"
     },
     "job_id": {
      "pattern": "^[a-f0-9]{32}$",
      "type": "string"
     },
     "job_key": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "type": "string"
     },
     "payload": {},
     "status": {
      "enum": [
       "pending",
       "claimed",
       "completed",
       "failed"
      ],
      "type": "string"
     }
    },
    "required": [
     "job_id",
     "job_key",
     "payload",
     "status",
     "attempts",
     "created_at_timestamp",
     "expire_timestamp",
     "claimed_until_timestamp"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "queue_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   }
  },
  "required": [
   "ok",
   "queue_id",
   "expire_timestamp",
   "job"
  ],
  "type": "object"
 },
 "title": "Renew agent queue job"
}
