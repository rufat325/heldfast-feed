{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Records a bill the company owes a vendor. Writes, and records only \u2014 it does not pay anything or move money. Marking it paid is a separate call.",
 "inputSchema": {
  "properties": {
   "vendorBill": {
    "properties": {
     "amountCents": {
      "type": "integer"
     },
     "billNumber": {
      "maxLength": 50,
      "pattern": "^[A-Za-z0-9 ./_-]*$",
      "type": "string"
     },
     "cancelledAt": {
      "format": "date-time",
      "type": "string"
     },
     "companyId": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "createdAt": {
      "format": "date-time",
      "type": "string"
     },
     "currencyCode": {
      "pattern": "^([A-Z]{3})?$",
      "type": "string"
     },
     "dueDate": {
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
      "type": "string"
     },
     "id": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "issueDate": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
     },
     "notes": {
      "description": "Free-form description (max 5000 chars).",
      "properties": {
       "value": {
        "maxLength": 5000,
        "type": "string"
       }
      },
      "type": "object"
     },
     "paidAt": {
      "format": "date-time",
      "type": "string"
     },
     "status": {
      "enum": [
       "VENDOR_BILL_STATUS_UNSPECIFIED",
       "VENDOR_BILL_STATUS_OPEN",
       "VENDOR_BILL_STATUS_PAID",
       "VENDOR_BILL_STATUS_CANCELLED"
      ],
      "type": "string"
     },
     "updatedAt": {
      "format": "date-time",
      "type": "string"
     },
     "vendorName": {
      "description": "Human-readable name (1-255 Unicode chars).",
      "properties": {
       "value": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "required": [
     "companyId",
     "vendorName"
    ],
    "type": "object"
   }
  },
  "required": [
   "vendorBill"
  ],
  "type": "object"
 },
 "name": "vendor_bill_create_vendor_bill",
 "outputSchema": {
  "properties": {
   "vendorBillId": {
    "anyOf": [
     {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "vendorBillId"
  ],
  "type": "object"
 },
 "title": "Create Vendor Bill"
}
