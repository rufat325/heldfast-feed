{
 "description": "WRITE: Create an ad set under a campaign. Default status is PAUSED. `targeting` is a Meta targeting spec object (geo_locations, age_min, age_max, interests, etc.). `bid_amount` is in account currency minor units (cents). For multi-text / dynamic creative ads you MUST set is_dynamic_creative=true \u2014 otherwise asset_feed_spec ads will be rejected.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ad_account_id": {
    "description": "'act_123' or '123'",
    "type": "string"
   },
   "bid_amount": {
    "description": "Bid in minor currency units (cents). Always set at adset level.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "billing_event": {
    "enum": [
     "IMPRESSIONS",
     "LINK_CLICKS",
     "THRUPLAY",
     "POST_ENGAGEMENT",
     "APP_INSTALLS"
    ],
    "type": "string"
   },
   "campaign_id": {
    "type": "string"
   },
   "daily_budget": {
    "description": "For ABO; omit under CBO",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "end_time": {
    "type": "string"
   },
   "is_dynamic_creative": {
    "description": "Must be true for asset_feed_spec / multi-text creatives",
    "type": "boolean"
   },
   "lifetime_budget": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "optimization_goal": {
    "description": "e.g. OFFSITE_CONVERSIONS",
    "enum": [
     "NONE",
     "LINK_CLICKS",
     "IMPRESSIONS",
     "REACH",
     "OFFSITE_CONVERSIONS",
     "LEAD_GENERATION",
     "LANDING_PAGE_VIEWS",
     "THRUPLAY",
     "VIDEO_VIEWS",
     "APP_INSTALLS",
     "POST_ENGAGEMENT",
     "QUALITY_LEAD",
     "VALUE"
    ],
    "type": "string"
   },
   "pacing_type": {
    "description": "e.g. ['standard'] or ['no_pacing']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "promoted_object": {
    "additionalProperties": {},
    "description": "e.g. {pixel_id: 'XXX', custom_event_type: 'PURCHASE'} for conversion optimization",
    "type": "object"
   },
   "start_time": {
    "description": "ISO 8601, e.g. '2026-01-15T00:00:00+0000'",
    "type": "string"
   },
   "status": {
    "enum": [
     "ACTIVE",
     "PAUSED",
     "DELETED",
     "ARCHIVED"
    ],
    "type": "string"
   },
   "targeting": {
    "additionalProperties": {},
    "description": "Meta targeting spec object (JSON)",
    "type": "object"
   }
  },
  "required": [
   "ad_account_id",
   "campaign_id",
   "name",
   "targeting",
   "optimization_goal",
   "billing_event"
  ],
  "type": "object"
 },
 "name": "create_adset"
}
