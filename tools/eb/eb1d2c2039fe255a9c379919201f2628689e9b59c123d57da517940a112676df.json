{
 "description": "Duplicate an existing invoice with a new due date. Endpoint: POST /invoices/:id/duplicate",
 "inputSchema": {
  "properties": {
   "due_date": {
    "description": "New due date (YYYY-MM-DD)",
    "type": "string"
   },
   "id": {
    "description": "Invoice ID to duplicate",
    "type": "string"
   },
   "ignore_due_email": {
    "description": "Skip sending due-date email",
    "type": "boolean"
   }
  },
  "required": [
   "id",
   "due_date"
  ],
  "type": "object"
 },
 "name": "duplicate_invoice"
}
