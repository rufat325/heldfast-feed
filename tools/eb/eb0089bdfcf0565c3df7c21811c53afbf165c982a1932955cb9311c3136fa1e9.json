{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Merge multiple shopping lists into one. Use this when you have several lists to consolidate. Use scale_recipe when you need to adjust ingredient amounts for a different number of servings.",
 "inputSchema": {
  "properties": {
   "lists": {
    "description": "Shopping lists to merge",
    "items": {
     "properties": {
      "items": {
       "description": "Items on this list",
       "items": {
        "properties": {
         "item": {
          "description": "Item to buy",
          "type": "string"
         },
         "quantity": {
          "description": "Amount; omit it for non-numeric items",
          "type": "number"
         },
         "unit": {
          "description": "Unit such as cup, tbsp or g",
          "type": "string"
         }
        },
        "required": [
         "item"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "description": "e.g. 'Saturday dinner'",
       "type": "string"
      }
     },
     "required": [
      "items"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "lists"
  ],
  "type": "object"
 },
 "name": "merge_shopping_list",
 "outputSchema": {
  "properties": {
   "mergedList": {
    "description": "The consolidated shopping list",
    "properties": {
     "items": {
      "description": "List of items with quantities and units",
      "items": {
       "properties": {
        "item": {
         "description": "Item to buy",
         "type": "string"
        },
        "quantity": {
         "description": "Total amount of the item",
         "type": "number"
        },
        "unit": {
         "description": "Friendliest kitchen unit for the item",
         "type": "string"
        }
       },
       "required": [
        "item",
        "quantity",
        "unit"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "name": {
      "description": "Name of the merged list, e.g. 'Weekly Groceries'",
      "type": "string"
     },
     "notes": {
      "description": "List of items without quantities",
      "items": {
       "description": "Item to buy",
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "items",
     "notes"
    ],
    "type": "object"
   }
  },
  "required": [
   "mergedList"
  ],
  "type": "object"
 },
 "title": "Merge shopping list"
}
