{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List valet operators serving a city slug plus state slug, optionally narrowed by service. Use this when an agent has a city already disambiguated and wants its operator roster ranked by listing tier then name. Empty array if no listed operators.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "city_slug": {
    "description": "Lowercase kebab-case city slug (e.g. 'houston', 'san-francisco')",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max results to return; default 10, capped at 50",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "service": {
    "description": "Optional service narrowing. One of the 9 canonical valet service slugs. Omit to list every operator serving the city.",
    "enum": [
     "wedding-valet",
     "corporate-event-valet",
     "private-event-valet",
     "funeral-valet",
     "hotel-resort-valet",
     "restaurant-valet",
     "hospital-medical-valet",
     "major-venue-valet",
     "general-valet"
    ],
    "type": "string"
   },
   "state_slug": {
    "description": "Lowercase kebab-case US state slug (e.g. 'tx', 'new-york')",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "state_slug",
   "city_slug"
  ],
  "type": "object"
 },
 "name": "valet_find_operators_in_city",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_meta": {
    "additionalProperties": false,
    "description": "TOOL-11 ToS and attribution block",
    "properties": {
     "attribution": {
      "type": "string"
     },
     "terms": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "terms",
     "attribution"
    ],
    "type": "object"
   },
   "data_freshness": {
    "additionalProperties": false,
    "description": "TOOL-10 freshness stamp",
    "properties": {
     "indexed_at": {
      "description": "ISO timestamp of the freshest row in the batch",
      "type": "string"
     },
     "source": {
      "description": "Origin tag: typesense:operators or typesense:operators:empty",
      "type": "string"
     }
    },
    "required": [
     "indexed_at",
     "source"
    ],
    "type": "object"
   },
   "operators": {
    "description": "Operators serving the city, ranked tier:desc then name:asc. Empty array means no matches.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description_text": {
       "description": "Plain-text summary; null if not on file",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "description": "Operator business name",
       "type": "string"
      },
      "phone": {
       "description": "Operator phone number, null if not on file",
       "type": [
        "string",
        "null"
       ]
      },
      "primary_city_name": {
       "description": "Display name of operator HQ city",
       "type": "string"
      },
      "primary_city_slug": {
       "description": "Canonical kebab-case HQ city slug",
       "type": "string"
      },
      "primary_state_name": {
       "description": "Display name of operator HQ state",
       "type": "string"
      },
      "primary_state_slug": {
       "description": "Canonical kebab-case HQ state slug",
       "type": "string"
      },
      "services": {
       "description": "Canonical service slugs this operator offers",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "slug": {
       "description": "Canonical kebab-case operator slug; pass to valet_get_operator for details",
       "type": "string"
      },
      "tier": {
       "description": "Operator tier: 'free', 'paid', or 'custom'",
       "type": "string"
      }
     },
     "required": [
      "name",
      "slug",
      "primary_city_name",
      "primary_state_name",
      "primary_city_slug",
      "primary_state_slug",
      "services",
      "phone",
      "tier",
      "description_text"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "operators",
   "data_freshness",
   "_meta"
  ],
  "type": "object"
 },
 "title": "Find Operators In City"
}
