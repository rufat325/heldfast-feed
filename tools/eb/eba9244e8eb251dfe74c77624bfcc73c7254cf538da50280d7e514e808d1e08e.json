{
 "annotations": {
  "audience": [
   "user",
   "assistant"
  ],
  "openWorldHint": true,
  "priority": 0.5,
  "title": "Update Comment"
 },
 "description": "Edit or resolve a comment. Requires comment_id. Provide commentText or formattedComment to edit content, or resolved to change resolved state.",
 "inputSchema": {
  "properties": {
   "commentText": {
    "description": "Comment text. Markdown supported (**bold**, _italic_, `code`, - lists).",
    "type": "string"
   },
   "comment_id": {
    "description": "Comment ID. Required.",
    "type": "string"
   },
   "formattedComment": {
    "description": "Rich text array. Blocks: {text, attributes?} for text, {type:'tag', user:{id}} for @mention, {type:'emoji', unicode} for emoji.",
    "items": {
     "description": "Formatted comment block",
     "properties": {
      "attributes": {
       "description": "Formatting: bold, italic, underline, strikethrough, code, color, background_color, link",
       "properties": {
        "background_color": {
         "description": "HEX color code",
         "type": "string"
        },
        "bold": {
         "type": "boolean"
        },
        "code": {
         "type": "boolean"
        },
        "color": {
         "description": "HEX color code",
         "type": "string"
        },
        "italic": {
         "type": "boolean"
        },
        "link": {
         "description": "URL for the link",
         "type": "string"
        },
        "strikethrough": {
         "type": "boolean"
        },
        "underline": {
         "type": "boolean"
        }
       },
       "type": "object"
      },
      "text": {
       "description": "Text content",
       "type": "string"
      },
      "type": {
       "description": "Block type for mentions/emoji",
       "enum": [
        "tag",
        "emoji"
       ],
       "type": "string"
      },
      "unicode": {
       "description": "Unicode hex for emoji",
       "type": "string"
      },
      "user": {
       "description": "User to mention",
       "properties": {
        "id": {
         "description": "User ID",
         "type": "number"
        }
       },
       "type": "object"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "resolved": {
    "description": "Mark comment as resolved (true) or unresolved (false).",
    "type": "boolean"
   },
   "team_id": {
    "description": "The ClickUp Team ID or Workspace Name to use. If provided, the server will switch to this workspace for this and subsequent requests in the current session.",
    "type": "string"
   }
  },
  "required": [
   "comment_id"
  ],
  "type": "object"
 },
 "name": "update_comment"
}
