{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search local inventory. Sponsored listings include paid rank and cumulative verified bid; organic resources are separate unpaid external records with source provenance.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "maxLength": 512,
    "type": "string"
   },
   "freshness": {
    "enum": [
     "fresh",
     "aging",
     "stale",
     "not_observed"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_success_rate": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "organic_cursor": {
    "maxLength": 512,
    "type": "string"
   },
   "protocol": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "sort": {
    "default": "relevance",
    "enum": [
     "relevance",
     "reliability",
     "raw"
    ],
    "type": "string"
   },
   "source": {
    "enum": [
     "mcp_registry",
     "x402_bazaar"
    ],
    "type": "string"
   },
   "tool": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_agents",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {}
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Search sponsored and organic discovery"
}
