{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Valider une adresse de livraison"
 },
 "description": "Valide une adresse de livraison et renvoie sa forme standardisee, ses coordonnees et un score de livrabilite (residential / commercial / unknown / invalid) avec un niveau de confiance. Une reponse 200 avec degraded=true signale que le fournisseur etait injoignable : la reponse est alors incomplete et le champ confidence est bas. Cout : 1 validation (0.02 USDC sur Base, reglee en x402).",
 "inputSchema": {
  "$defs": {
   "AddressInput": {
    "properties": {
     "city": {
      "description": "Ville",
      "title": "City",
      "type": "string"
     },
     "country": {
      "default": "US",
      "description": "Code pays ISO 2 lettres",
      "title": "Country",
      "type": "string"
     },
     "state": {
      "description": "\u00c9tat ou r\u00e9gion",
      "title": "State",
      "type": "string"
     },
     "street": {
      "description": "Num\u00e9ro et nom de rue",
      "title": "Street",
      "type": "string"
     },
     "zip": {
      "description": "Code postal",
      "title": "Zip",
      "type": "string"
     }
    },
    "required": [
     "street",
     "city",
     "state",
     "zip"
    ],
    "title": "AddressInput",
    "type": "object"
   }
  },
  "properties": {
   "address": {
    "$ref": "#/$defs/AddressInput"
   }
  },
  "required": [
   "address"
  ],
  "title": "ValidationRequest",
  "type": "object"
 },
 "name": "validate_address",
 "outputSchema": {
  "$defs": {
   "AddressOutput": {
    "properties": {
     "cache_key": {
      "title": "Cache Key",
      "type": "string"
     },
     "confidence": {
      "title": "Confidence",
      "type": "number"
     },
     "degraded": {
      "default": false,
      "title": "Degraded",
      "type": "boolean"
     },
     "deliverability": {
      "title": "Deliverability",
      "type": "string"
     },
     "latitude": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Latitude"
     },
     "longitude": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Longitude"
     },
     "standardized": {
      "title": "Standardized",
      "type": "object"
     },
     "validated": {
      "title": "Validated",
      "type": "boolean"
     }
    },
    "required": [
     "validated",
     "standardized",
     "deliverability",
     "confidence",
     "cache_key"
    ],
    "title": "AddressOutput",
    "type": "object"
   }
  },
  "properties": {
   "price_paid": {
    "title": "Price Paid",
    "type": "number"
   },
   "result": {
    "$ref": "#/$defs/AddressOutput"
   },
   "transaction_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Transaction Id"
   }
  },
  "required": [
   "result",
   "price_paid"
  ],
  "title": "ValidationResponse",
  "type": "object"
 },
 "title": "Valider une adresse de livraison"
}
