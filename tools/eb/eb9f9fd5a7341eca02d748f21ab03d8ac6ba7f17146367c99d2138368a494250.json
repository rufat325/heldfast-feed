{
 "description": "Write an annotation onto an Open Label task as an imported layer (kind IMPORTED, or GROUND_TRUTH for gold answers). The result is an array of editor result entries (the same shape the editor produces). API-created annotations never masquerade as labeler work. Requires open-label:write scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "description": "Layer kind (default IMPORTED).",
    "enum": [
     "IMPORTED",
     "GROUND_TRUTH"
    ],
    "type": "string"
   },
   "projectId": {
    "description": "The Open Label project id.",
    "type": "string"
   },
   "result": {
    "description": "Editor result entries.",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "taskId": {
    "description": "The task id.",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "taskId",
   "result"
  ],
  "type": "object"
 },
 "name": "open_label_create_annotation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
