{
 "description": "Add a lesson to a course. content_type must match content_url (e.g. youtube URL \u2192 content_type:youtube). Set module_id=null to leave the lesson unassigned; otherwise pass a module uuid from list_course_modules.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content_format": {
    "enum": [
     "markdown",
     "tiptap_json"
    ],
    "type": "string"
   },
   "content_json": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "content_type": {
    "enum": [
     "youtube",
     "google_drive",
     "video",
     "image",
     "document",
     "pitch"
    ],
    "type": "string"
   },
   "content_url": {
    "format": "uri",
    "type": "string"
   },
   "course_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "duration_seconds": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "is_preview": {
    "description": "If true, visible to non-enrolled users",
    "type": "boolean"
   },
   "is_published": {
    "type": "boolean"
   },
   "module_id": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "sort_order": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "thumbnail_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "course_id",
   "title",
   "content_url"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_lesson"
}
