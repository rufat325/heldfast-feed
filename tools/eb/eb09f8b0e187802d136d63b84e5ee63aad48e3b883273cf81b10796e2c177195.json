{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Save or retrieve a summary of a large file to save tokens.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "get to read, set to save",
    "enum": [
     "get",
     "set"
    ],
    "type": "string"
   },
   "file": {
    "description": "File path",
    "type": "string"
   },
   "summary": {
    "default": "",
    "description": "File summary (only for set)",
    "type": "string"
   }
  },
  "required": [
   "action",
   "file"
  ],
  "type": "object"
 },
 "name": "memory_summary",
 "title": "File Summary"
}
