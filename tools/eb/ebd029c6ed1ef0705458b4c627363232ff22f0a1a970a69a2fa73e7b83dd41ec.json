{
 "description": "Create a QR code that redirects to the correct app store based on the device. iPhones go to the App Store, Android devices go to Google Play, and other devices go to the fallback URL. Provide at least one store URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "android_url": {
    "description": "Google Play Store URL.",
    "type": "string"
   },
   "background_color": {
    "description": "Hex color for background.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "corner_style": {
    "description": "Corner shape.",
    "enum": [
     "square",
     "extra-rounded",
     "dot"
    ],
    "type": "string"
   },
   "dot_style": {
    "description": "Dot shape.",
    "enum": [
     "square",
     "rounded",
     "dots",
     "classy-rounded"
    ],
    "type": "string"
   },
   "fallback_url": {
    "description": "Fallback URL for non-mobile devices.",
    "type": "string"
   },
   "foreground_color": {
    "description": "Hex color for dots.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "format": {
    "default": "svg",
    "description": "Image format.",
    "enum": [
     "svg",
     "png"
    ],
    "type": "string"
   },
   "frame_color": {
    "description": "Frame background color.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "frame_style": {
    "description": "Frame style around QR.",
    "enum": [
     "none",
     "banner_bottom",
     "banner_top",
     "rounded"
    ],
    "type": "string"
   },
   "frame_text": {
    "description": "CTA text on frame (max 30 chars).",
    "maxLength": 30,
    "type": "string"
   },
   "frame_text_color": {
    "description": "Frame text color.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "ios_url": {
    "description": "Apple App Store URL.",
    "type": "string"
   },
   "label": {
    "description": "Label for this QR code.",
    "type": "string"
   },
   "logo_url": {
    "description": "Logo URL or data URI.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_app_store_qr"
}
