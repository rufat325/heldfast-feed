{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Remove one item from the signed-in user's Saved list by the id that risetive_save_item or risetive_list_saved_items returns; the niche, product or project itself is not affected. Removing an item that is already gone returns removed: false. Requires signing in with a free Risetive account.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "savedItemId": {
    "pattern": "^[1-9][0-9]{0,18}$",
    "type": "string"
   }
  },
  "required": [
   "savedItemId"
  ],
  "type": "object"
 },
 "name": "risetive_remove_saved_item",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "removed": {
        "type": "boolean"
       }
      },
      "required": [
       "removed"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "message": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "ok",
     "not-found",
     "timeout",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "message",
   "data"
  ],
  "type": "object"
 },
 "title": "Remove a saved Risetive item"
}
