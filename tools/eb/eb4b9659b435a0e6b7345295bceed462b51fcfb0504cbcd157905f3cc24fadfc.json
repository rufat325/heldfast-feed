{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Shipment portfolio summary"
 },
 "description": "Overview of your entire container portfolio: total active, exceptions, arriving soon, demurrage risk. Use this as the starting point for any shipment question.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filter": {
    "default": "all",
    "description": "Focus on a specific subset: all (default), exceptions, arriving_soon, demurrage_risk",
    "enum": [
     "all",
     "exceptions",
     "arriving_soon",
     "demurrage_risk"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_shipment_summary",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "On an empty result: NOT_FOUND (no record after asking) or NO_EVENTS (record, nothing filed).",
    "type": "string"
   },
   "data": {
    "additionalProperties": true,
    "properties": {
     "arriving_this_week": {
      "type": [
       "number",
       "null"
      ]
     },
     "containers": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": true,
         "properties": {
          "bl_number": {
           "type": [
            "string",
            "null"
           ]
          },
          "carrier": {
           "description": "SCAC of the operating line",
           "type": [
            "string",
            "null"
           ]
          },
          "container_number": {
           "type": [
            "string",
            "null"
           ]
          },
          "demurrage_free_days_left": {
           "type": [
            "number",
            "null"
           ]
          },
          "destination_name": {
           "type": [
            "string",
            "null"
           ]
          },
          "eta": {
           "description": "ISO 8601",
           "type": [
            "string",
            "null"
           ]
          },
          "eta_confidence_pct": {
           "type": [
            "number",
            "null"
           ]
          },
          "id": {
           "type": [
            "string",
            "null"
           ]
          },
          "identifier": {
           "description": "Container number or B/L as tracked",
           "type": [
            "string",
            "null"
           ]
          },
          "origin_name": {
           "type": [
            "string",
            "null"
           ]
          },
          "status": {
           "type": [
            "string",
            "null"
           ]
          },
          "vessel_imo": {
           "type": [
            "string",
            "null"
           ]
          },
          "vessel_name": {
           "type": [
            "string",
            "null"
           ]
          }
         },
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "demurrage_risk_usd": {
      "type": [
       "number",
       "null"
      ]
     },
     "exceptions": {
      "type": [
       "number",
       "null"
      ]
     },
     "total_active": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "message": {
    "description": "On an empty result: what the emptiness means.",
    "type": "string"
   },
   "ok": {
    "description": "False never appears here \u2014 failures arrive as tool errors.",
    "type": "boolean"
   },
   "result": {
    "description": "\"empty\" means the query succeeded and there is nothing to report.",
    "enum": [
     "data",
     "empty"
    ],
    "type": "string"
   }
  },
  "required": [
   "ok",
   "result"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "openid",
    "email",
    "profile"
   ],
   "type": "oauth2"
  }
 ]
}
