  "title": "Check a chemical substance: REACH, SVHC, TSCA, Prop 65 status"
 },
 "description": "Checks whether one or more chemical substances (name, CAS or EC number) are registered, listed, restricted or banned, and screens a bill of materials. It resolves the identity against the ECHA C&L Inventory and REACH registered substances, the EU customs inventory (ECICS), the US TSCA Inventory, the Australian AICIS inventory and the Turkish chemical inventory. It then checks the ECHA SVHC Candidate List, REACH Annex XIV (authorisation, with sunset dates), REACH Annex XVII (restrictions, with entry conditions), CoRAP and POPs; the UK REACH candidate, authorisation and restriction lists (HSE) and the UK REACH candidate list policy paper (Defra); Turkey KKDIK Annex 17; US EPA TSCA section 6 risk management rules, SNURs and PFAS reporting; the California Prop 65 list with safe harbor levels; Belgian PFAS restrictions; and the AICIS banned and restricted chemicals list. Accepts up to 50 substances. A substance missing from a list is reported as not listed on it. Not intended for hazard classification, pictograms or UN numbers (`regaffairs_get_ghs_hazard_classification` covers those), exposure limits (`regaffairs_get_workplace_exposure_limits`), or cosmetic, food, pesticide or biocide ingredient status (the matching industry tools cover those).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "identity_only": {
    "default": false,
    "description": "Only resolve name, CAS and EC (for ambiguous names, salts, hydrates, group entries).",
    "type": "boolean"
   },
   "jurisdictions": {
    "description": "Default: all.",
    "items": {
     "enum": [
      "EU",
      "GB",
      "TR",
      "US",
      "US-CA",
      "AU",
      "BE"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "lists": {
    "description": "Default: all lists for the chosen jurisdictions.",
    "items": {
     "enum": [
      "reach_registration",
      "svhc_candidate",
      "authorisation",
      "restriction",
      "corap",
      "pops",
      "uk_reach",
      "kkdik_annex17",
      "tsca_inventory",
      "tsca_section6",
      "tsca_snur",
      "tsca_pfas_reporting",
      "prop65",
      "aicis",
      "pfas"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "substances": {
    "description": "Names, CAS (e.g. 80-05-7) or EC numbers (e.g. 201-245-8).",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "substances"
  ],
  "type": "object"
 },
