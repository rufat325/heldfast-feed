{
 "description": "Record a bounded security memory episode for future recall (idempotent write path).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adapter_type": {
    "enum": [
     "event",
     "evidence",
     "incident",
     "advisory"
    ],
    "type": "string"
   },
   "entity_id": {
    "description": "Optional linked entity ID",
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   },
   "event_type": {
    "description": "Episode event type",
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "payload": {
    "additionalProperties": {},
    "description": "Structured payload (PII/secrets redacted by API policy)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "sensitivity": {
    "enum": [
     "standard",
     "restricted"
    ],
    "type": "string"
   },
   "source_refs": {
    "items": {
     "properties": {
      "metadata": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "source_id": {
       "maxLength": 128,
       "minLength": 3,
       "type": "string"
      },
      "source_type": {
       "enum": [
        "incident",
        "finding",
        "event",
        "scan",
        "advisory",
        "rule",
        "episode",
        "external"
       ],
       "type": "string"
      },
      "title": {
       "maxLength": 200,
       "minLength": 2,
       "type": "string"
      },
      "url": {
       "maxLength": 500,
       "type": "string"
      }
     },
     "required": [
      "source_id",
      "source_type",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "description": "Optional human summary",
    "maxLength": 500,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "event_type"
  ],
  "type": "object"
 },
 "name": "vigile_remember"
}
