      },
      "launchedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "linkedinUrl": {
       "type": "string"
      },
      "maker": {
       "description": "Who built the product. label is their own description of themselves (e.g. \"Indie hacker\"), \"Builder\" when unset. handle and profile are present once they have a public FastDrop profile.",
       "properties": {
        "handle": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "profile": {
         "description": "Public profile URL",
         "type": "string"
        }
       },
       "required": [
        "name",
        "label"
       ],
       "type": "object"
      },
      "makerNote": {
       "type": "string"
      },
      "mcpAuthRequired": {
       "type": "boolean"
      },
      "mcpKeyedVerified": {
       "type": "boolean"
      },
      "mcpTools": {
