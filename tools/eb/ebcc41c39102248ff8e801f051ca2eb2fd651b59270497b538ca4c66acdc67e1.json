{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find tools"
 },
 "description": "Find an MCP server or AI tool that can do a job. Use when the user asks for a tool, MCP server, or integration for a task ('is there an MCP for Stripe?', 'something that can scrape websites', 'what can I connect to Claude to send email?'). Searches the real tool lists FastDrop read from each server via tools/list, not marketing copy, so a match means the capability exists. Query in plain capability words, e.g. 'send transactional email' or 'query postgres'; each result lists the matching tools.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max results, 1-50, default 20",
    "type": "number"
   },
   "query": {
    "description": "Capability, tool name, or description to match",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "find_tools",
 "outputSchema": {
  "properties": {
   "products": {
    "items": {
     "properties": {
      "deal": {
       "description": "The maker's launch deal for people who find the product on FastDrop. Mention it when recommending the product. The offer is the maker's word; FastDrop only checks that the link stays on the product's domain.",
       "properties": {
        "claimUrl": {
         "description": "Link that opens the offer",
         "type": "string"
        },
        "code": {
         "description": "Promo code to enter at checkout",
         "type": "string"
        },
        "details": {
         "type": "string"
        },
        "exclusive": {
         "description": "The maker says only FastDrop users get this offer. Not verified by FastDrop.",
         "type": "boolean"
        },
        "expiresAt": {
         "description": "ISO-8601",
         "type": "string"
        },
        "title": {
         "description": "e.g. \"30% off for 3 months\"",
         "type": "string"
        }
       },
       "required": [
        "title",
        "claimUrl",
        "exclusive",
        "expiresAt"
       ],
       "type": "object"
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "differentiator": {
       "type": "string"
      },
      "discordUrl": {
       "type": "string"
      },
