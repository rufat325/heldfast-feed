       "type": "string"
      },
      "features": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "galleryUrls": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "githubUrl": {
       "type": "string"
