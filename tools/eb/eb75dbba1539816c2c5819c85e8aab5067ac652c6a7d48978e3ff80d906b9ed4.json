{
 "description": "Extract structured data from any webpage using JSON schema. AI-powered extraction that understands page context. Price: $0.03, up to 3x on bot-protected or complex sites",
 "inputSchema": {
  "properties": {
   "instructions": {
    "description": "Natural language extraction hints",
    "example": "Extract the page title and what the domain is for",
    "type": "string"
   },
   "schema": {
    "additionalProperties": {},
    "description": "JSON schema for extraction",
    "example": {
     "purpose": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "url": {
    "description": "The URL to process",
    "example": "https://example.com",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url",
   "schema"
  ],
  "type": "object"
 },
 "name": "extract_data"
}
