{
 "annotations": {},
 "description": "Upgrade the Kubernetes version of a node pool. Uses PATCH with query parameters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clusterUuid": {
    "description": "UUID of the cluster",
    "type": "string"
   },
   "instanceNo": {
    "description": "Node pool instance number",
    "type": "number"
   },
   "k8sVersion": {
    "description": "Target Kubernetes version",
    "type": "string"
   },
   "maxSurge": {
    "description": "Max nodes added during upgrade (default: 1)",
    "type": "number"
   },
   "maxUnavailable": {
    "description": "Max unavailable nodes during upgrade (default: 0)",
    "type": "number"
   }
  },
  "required": [
   "clusterUuid",
   "instanceNo",
   "k8sVersion"
  ],
  "type": "object"
 },
 "name": "ncloud_nks_upgrade_node_pool"
}
