  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "enum": [
     "ethereum",
     "base",
     "arbitrum",
     "optimism",
     "polygon",
     "bsc"
    ],
    "type": "string"
   },
   "token_address": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "token_address"
  ],
  "type": "object"
 },
