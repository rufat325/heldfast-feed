{
 "description": "List fixtures and results with scores, kickoff times, status and teams. Filter by competition, team, status, date or season.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "competition": {
    "description": "Competition ID, e.g. 'comp_premier_league_eng', 'comp_bundesliga_de'",
    "type": "string"
   },
   "from": {
    "description": "Start date in YYYY-MM-DD format",
    "type": "string"
   },
   "limit": {
    "description": "Max matches to return (default 50, max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "season": {
    "description": "Season in YYYY/YY format (e.g. '2025/26')",
    "type": "string"
   },
   "status": {
    "enum": [
     "SCHEDULED",
     "LIVE",
     "IN_PLAY",
     "PAUSED",
     "FINISHED",
     "POSTPONED",
     "CANCELLED"
    ],
    "type": "string"
   },
   "team": {
    "description": "Team ID or fuzzy name",
    "type": "string"
   },
   "to": {
    "description": "End date in YYYY-MM-DD format",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "openfoot_matches",
 "title": "List matches"
}
