{
 "_meta": {
  "openai/outputTemplate": "ui://haus/widgets/v2",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://haus/widgets/v2",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Update a contact by id. Only the fields supplied are changed; omitted fields keep their current value (dateOfBirth is the exception: an empty string explicitly clears it).",
 "inputSchema": {
  "examples": [
   {
    "id": "01928e4a7d3f7b9ac1e3f6d8b2a4c710",
    "notes": "Prefers texts over calls.",
    "phone": "+44 7911 123456"
   }
  ],
  "properties": {
   "address": {
    "description": "Postal address. Replaces the stored one outright.",
    "properties": {
     "countryCode": {
      "description": "ISO country code, e.g. GB.",
      "examples": [
       "GB"
      ],
      "type": "string"
     },
     "line1": {
      "description": "Line 1, typically number and street.",
      "examples": [
       "12 Baker Street"
      ],
      "type": "string"
     },
     "line2": {
      "description": "Line 2, e.g. apartment or unit.",
      "examples": [
       "Flat 3"
      ],
      "type": "string"
     },
     "line3": {
      "description": "Line 3, e.g. town or city.",
      "examples": [
       "London"
      ],
      "type": "string"
     },
     "postalCode": {
      "description": "Postal or ZIP code.",
      "examples": [
       "NW1 6XE"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "dateOfBirth": {
    "description": "Date of birth, YYYY-MM-DD. Empty string clears it.",
    "examples": [
     "1990-05-15"
    ],
    "type": "string"
   },
   "displayName": {
    "description": "Name to show instead of first/last, e.g. a nickname or company.",
    "examples": [
     "Sarah from book club"
    ],
    "type": "string"
   },
   "email": {
    "description": "Email address.",
    "examples": [
     "sarah.jones@example.com"
    ],
    "type": "string"
   },
   "firstName": {
    "description": "First name.",
    "examples": [
     "Sarah"
    ],
    "type": "string"
   },
   "id": {
    "description": "Contact id from create_contact or list_contacts.",
    "examples": [
     "01928e4a7d3f7b9ac1e3f6d8b2a4c710"
    ],
    "type": "string"
   },
   "lastName": {
    "description": "Last (family) name.",
    "examples": [
     "Jones"
    ],
    "type": "string"
   },
   "notes": {
    "description": "Free-text notes.",
    "examples": [
     "Prefers texts over calls."
    ],
    "type": "string"
   },
   "phone": {
    "description": "Phone number, any format.",
    "examples": [
     "+44 7911 123456"
    ],
    "type": "string"
   },
   "prepareBirthdayPresent": {
    "description": "Whether to flag a birthday present for them.",
    "examples": [
     true
    ],
    "type": "boolean"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_contact",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "variant": {
    "enum": [
     "list",
     "detail",
     "confirmation"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 }
}
