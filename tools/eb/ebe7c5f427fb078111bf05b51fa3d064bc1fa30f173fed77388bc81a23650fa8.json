    "type": "string"
   },
   "hours": {
    "default": 6,
    "description": "Lookback hours (EVM only)",
    "maximum": 24,
    "minimum": 1,
    "type": "number"
   },
   "minAmount": {
    "default": 50000,
    "description": "Minimum USD value to qualify as whale transfer",
    "minimum": 10000,
    "type": "number"
   }
  },
  "type": "object"
 },
