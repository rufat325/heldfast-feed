{
 "_meta": {
  "openai/toolInvocation/invoked": "Loaded historical calendar",
  "openai/toolInvocation/invoking": "Loading historical calendar\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "fxmacrodata.read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Historical Calendar Snapshot"
 },
 "description": "Return persisted economic-event schedules, importance and cancellation states at an explicit historical cutoff. Accepted mode requires actual capture and parser acceptance by the cutoff. Reconstruction additionally admits qualified official notices recovered later; it does not establish historical service availability. Scheduled-date and event filters apply after version selection. Checkpoint and cursor pin subsequent export pages. Empty results do not establish that no events were scheduled. Access: requires an FXMacroData API key; an anonymous call returns subscription_required with a subscribe link.",
 "inputSchema": {
  "properties": {
   "as_of": {
    "description": "Required ISO 8601 knowledge cutoff with UTC offset or Z.",
    "examples": [
     "2025-10-01T15:00:00Z"
    ],
    "format": "date-time",
    "pattern": ".*(?:Z|[+-]\\d{2}:\\d{2})$",
    "type": "string"
   },
   "checkpoint": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Checkpoint returned by the first page."
   },
   "currency": {
    "description": "3-letter ISO currency code, case-insensitive.",
    "examples": [
     "usd",
     "eur",
     "gbp",
     "jpy"
    ],
    "type": "string"
   },
   "cursor": {
    "anyOf": [
     {
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Opaque next_cursor returned by the previous page."
   },
   "end_date": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Inclusive scheduled-date upper bound, YYYY-MM-DD."
   },
   "event_kind": {
    "anyOf": [
     {
      "enum": [
       "release",
       "speech",
       "meeting",
       "policy_decision",
       "press_conference",
       "other"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Scheduled event kind filter."
   },
   "importance": {
    "anyOf": [
     {
      "enum": [
       "high",
       "medium",
       "low",
       "unknown"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Frozen event importance filter."
   },
   "knowledge_mode": {
    "default": "accepted",
    "description": "Archive acceptance replay, or qualified documentary reconstruction.",
    "enum": [
     "accepted",
     "reconstruction"
    ],
    "type": "string"
   },
   "limit": {
    "default": 250,
    "description": "Maximum events per page, default 250.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "start_date": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Inclusive scheduled-date lower bound, YYYY-MM-DD."
   }
  },
  "required": [
   "currency",
   "as_of"
  ],
  "title": "calendar_snapshotArguments",
  "type": "object"
 },
 "name": "calendar_snapshot",
 "outputSchema": {
  "additionalProperties": true,
  "title": "calendar_snapshotDictOutput",
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "fxmacrodata.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Historical Calendar Snapshot"
}
