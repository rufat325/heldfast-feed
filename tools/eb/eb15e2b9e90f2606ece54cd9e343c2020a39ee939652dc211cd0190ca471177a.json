{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Update the current user's primary profile. Supports display name, bio, avatar, theme, custom links, and verification display settings.\n\nACCESS: needs a Proof account. Authenticate this client (Claude Code: /mcp \u2192 Authenticate), then call this tool again. start_login does NOT open this tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "avatar_url": {
    "anyOf": [
     {
      "anyOf": [
       {
        "not": {}
       },
       {
        "maxLength": 500000,
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Avatar (HTTPS URL or base64 data URI, null to remove)"
   },
   "bio": {
    "description": "Profile bio",
    "maxLength": 500,
    "type": "string"
   },
   "custom_links": {
    "description": "Custom links (max 20)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "display_order": {
       "description": "Display order",
       "minimum": 0,
       "type": "integer"
      },
      "icon": {
       "description": "Icon identifier",
       "maxLength": 50,
       "type": "string"
      },
      "is_visible": {
       "description": "Whether the link is visible",
       "type": "boolean"
      },
      "title": {
       "description": "Link title",
       "maxLength": 100,
       "type": "string"
      },
      "url": {
       "description": "Link URL",
       "format": "uri",
       "maxLength": 500,
       "type": "string"
      }
     },
     "required": [
      "title",
      "url"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "display_name": {
    "description": "Display name",
    "maxLength": 100,
    "type": "string"
   },
   "is_public": {
    "description": "Whether the profile is publicly visible",
    "type": "boolean"
   },
   "show_proof_channels": {
    "description": "Show proof channels",
    "type": "boolean"
   },
   "show_verification_dates": {
    "description": "Show verification dates",
    "type": "boolean"
   },
   "theme": {
    "additionalProperties": false,
    "description": "Profile theme settings",
    "properties": {
     "background_color": {
      "description": "Background color (hex)",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "type": "string"
     },
     "background_type": {
      "description": "Background type",
      "enum": [
       "solid",
       "gradient"
      ],
      "type": "string"
     },
     "font_style": {
      "description": "Font style",
      "enum": [
       "default",
       "modern",
       "classic"
      ],
      "type": "string"
     },
     "gradient_end": {
      "description": "Gradient end color",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "type": "string"
     },
     "gradient_start": {
      "description": "Gradient start color",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "type": "string"
     },
     "primary_color": {
      "description": "Primary color (hex)",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "update_my_profile"
}
