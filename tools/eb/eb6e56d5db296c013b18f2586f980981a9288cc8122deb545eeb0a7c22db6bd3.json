{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "project_todos:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Set the DRAFT selection cycle to EXACTLY requestedQuestionIds (action coaching_redo_selection). Request-bound: reusing one idempotencyKey with a DIFFERENT set is 409 IDEMPOTENCY_KEY_REUSED \u2014 never a silent change. Requires project_todos:write and a caller-supplied stable idempotencyKey (registry op project_todos.quizzes.coaching.manage). The response echoes its action discriminator and receipt fields.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "requestedQuestionIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "assignmentId",
   "requestedQuestionIds",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_coaching_redo_selection",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "enum": [
       "coaching_redo_selection",
       "coaching_draft_cancel"
      ],
      "type": "string"
     },
     "cycle": {
      "additionalProperties": false,
      "properties": {
       "closedAt": {
        "type": [
         "string",
         "null"
        ]
       },
       "closedReason": {
        "anyOf": [
         {
          "enum": [
           "ACCEPTED",
           "GRADED",
           "SUPERSEDED",
           "CANCELLED"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "cycleNumber": {
        "type": "integer"
       },
       "reason": {
        "type": [
         "string",
         "null"
        ]
       },
       "requestedQuestionIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "reviewCycleId": {
        "type": "string"
       },
       "sentAt": {
        "type": [
         "string",
         "null"
        ]
       },
       "sourceAttemptId": {
        "type": "string"
       },
       "status": {
        "enum": [
         "DRAFT",
         "OPEN",
         "RESUBMITTED",
         "CLOSED"
        ],
        "type": "string"
       }
      },
      "required": [
       "reviewCycleId",
       "cycleNumber",
       "status",
       "sourceAttemptId",
       "requestedQuestionIds",
       "reason",
       "sentAt",
       "closedAt",
       "closedReason"
      ],
      "type": "object"
     },
     "replayed": {
      "type": "boolean"
     }
    },
    "required": [
     "action",
     "cycle",
     "replayed"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
