{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Editar una alerta"
 },
 "description": "Modifica una alerta existente (nombre, criterios, tipos, cadencia, canales, horas de silencio). Requiere cuenta verificada (scope `alertas:write`). No env\u00eda correo.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cadencia": {
    "description": "`instant` requiere plan Pro (si no, pasa a `daily`)",
    "enum": [
     "instant",
     "daily",
     "weekly"
    ],
    "type": "string"
   },
   "canales": {
    "description": "`inapp` siempre; `email`; `push`/`telegram`/`webhook` seg\u00fan el plan",
    "items": {
     "enum": [
      "inapp",
      "email",
      "push",
      "telegram",
      "webhook"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "criterios": {
    "additionalProperties": false,
    "description": "Filtros que debe cumplir una subasta para disparar la alerta: provincias, municipios, tipo de inmueble, precio, superficie y ocupaci\u00f3n.",
    "properties": {
     "discountMinPct": {
      "description": "Descuento m\u00ednimo sobre tasaci\u00f3n (%): requiere plan Pro",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     },
     "endingWithinDays": {
      "description": "Para el tipo `ending`: d\u00edas antes del fin",
      "maximum": 365,
      "minimum": 1,
      "type": "integer"
     },
     "keywords": {
      "description": "Palabras clave (m\u00e1x. 10\u00d740). NO filtran por zona: usa provincia/municipio",
      "items": {
       "maxLength": 40,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "m2Max": {
      "minimum": 0,
      "type": "number"
     },
     "m2Min": {
      "minimum": 0,
      "type": "number"
     },
     "municipalityKeys": {
      "description": "Claves `provincia:municipio` (de `estadisticas_publicas`)",
      "items": {
       "description": "Clave `provincia:municipio` (de `estadisticas_publicas`)",
       "pattern": "^[a-z0-9-]+:[a-z0-9-]+$",
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "occupied": {
      "description": "Solo ocupadas (true) o solo libres (false)",
      "type": "boolean"
     },
     "priceDropMinPct": {
      "description": "Para el tipo `price_drop`: bajada m\u00ednima (%)",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     },
     "priceMax": {
      "minimum": 0,
      "type": "number"
     },
     "priceMin": {
      "minimum": 0,
      "type": "number"
     },
     "propertyTypes": {
      "description": "Valores EXACTOS del recurso `subastech://tipos-de-inmueble`",
      "items": {
       "maxLength": 60,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "provinceSlugs": {
      "description": "Slugs de provincia",
      "items": {
       "description": "Slug en min\u00fasculas (p. ej. `madrid`)",
       "pattern": "^[a-z0-9-]{1,80}$",
       "type": "string"
      },
      "maxItems": 60,
      "type": "array"
     },
     "scoreMin": {
      "description": "Scoring m\u00ednimo (0-100): requiere plan Pro",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "id": {
    "description": "Identificador de la alerta a modificar (de `alertas_listar`).",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "nombre": {
    "description": "Nombre de la alerta",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "quiet_hours": {
    "additionalProperties": false,
    "description": "Franja en la que no se env\u00edan avisos. `paused` la desactiva; `from` y `to` en formato HH:MM; `days` con 0 = domingo \u2026 6 = s\u00e1bado.",
    "properties": {
     "days": {
      "description": "0 = domingo \u2026 6 = s\u00e1bado",
      "items": {
       "maximum": 6,
       "minimum": 0,
       "type": "integer"
      },
      "maxItems": 7,
      "type": "array"
     },
     "from": {
      "description": "HH:MM",
      "pattern": "^\\d{2}:\\d{2}$",
      "type": "string"
     },
     "paused": {
      "type": "boolean"
     },
     "to": {
      "description": "HH:MM",
      "pattern": "^\\d{2}:\\d{2}$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "tipos": {
    "description": "`new`, `price_drop`, `ending`, `status`",
    "items": {
     "enum": [
      "new",
      "price_drop",
      "ending",
      "status"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "id",
   "nombre",
   "criterios",
   "tipos",
   "cadencia",
   "canales"
  ],
  "type": "object"
 },
 "name": "alertas_editar",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "ajustes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "avisos": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "code": {
       "type": "string"
      },
      "fix": {},
      "message": {
       "type": "string"
      }
     },
     "required": [
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "cta": {
    "additionalProperties": {},
    "properties": {
     "text": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "text",
     "url"
    ],
    "type": "object"
   },
   "disclosure": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "url"
  ],
  "type": "object"
 },
 "title": "Editar una alerta"
}
