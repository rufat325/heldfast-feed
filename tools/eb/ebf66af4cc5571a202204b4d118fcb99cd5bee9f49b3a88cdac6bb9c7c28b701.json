{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "\u26a0\ufe0f Replaces ALL tags on a database with the list given \u2014 tags not included are removed. Read the current tags first with ncloud_datacatalog_get_database (includeTags=true).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "catalogId": {
    "description": "Catalog ID",
    "type": "number"
   },
   "databaseName": {
    "description": "Database name",
    "type": "string"
   },
   "tagKeyTypeValueList": {
    "description": "Full replacement tag list. Every existing tag not present here is deleted",
    "items": {
     "additionalProperties": false,
     "properties": {
      "tagKey": {
       "description": "Tag key (1-64 chars)",
       "type": "string"
      },
      "tagType": {
       "description": "Tag value type",
       "enum": [
        "STRING",
        "DOUBLE",
        "BOOLEAN",
        "DATETIME"
       ],
       "type": "string"
      },
      "tagValue": {
       "description": "Tag value (1-256 chars)",
       "type": "string"
      }
     },
     "required": [
      "tagKey",
      "tagType",
      "tagValue"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "catalogId",
   "databaseName",
   "tagKeyTypeValueList"
  ],
  "type": "object"
 },
 "name": "ncloud_datacatalog_update_database_tag"
}
