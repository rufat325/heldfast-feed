{
 "description": "Add, remove, promote, or demote participants in a WhatsApp group",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to take on participants",
    "enum": [
     "add",
     "remove",
     "promote",
     "demote"
    ],
    "type": "string"
   },
   "groupJid": {
    "description": "Group JID (e.g. 120363000000000000@g.us)",
    "type": "string"
   },
   "instance": {
    "description": "Instance name",
    "type": "string"
   },
   "participants": {
    "description": "Array of phone numbers (with country code)",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "instance",
   "groupJid",
   "action",
   "participants"
  ],
  "type": "object"
 },
 "name": "update_group_participants"
}
