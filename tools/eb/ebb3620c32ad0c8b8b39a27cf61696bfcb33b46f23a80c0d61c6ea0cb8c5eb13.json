{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Replace existing mapping"
 },
 "description": "Replaces an existing mapping in full. Fetch the current mapping with list_mappings first and send the whole desired shape \u2014 this is a PUT, not a patch. Returns the updated mapping.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "companyId": {
    "description": "Company id from list_companies.",
    "type": "string"
   },
   "entityName": {
    "description": "Entity this mapping targets \u2014 must match list_entities output.",
    "type": "string"
   },
   "fields": {
    "description": "Field mappings (full replacement).",
    "items": {
     "additionalProperties": true,
     "description": "One mapped field. Either map a CSV column via 'sourceFieldTitle' or pin a constant via 'fixedValue' \u2014 not both.",
     "properties": {
      "fixedValue": {
       "description": "Constant value applied to every row (string, number, or boolean)."
      },
      "sourceFieldTitle": {
       "description": "CSV column header to read from.",
       "type": "string"
      },
      "targetFieldId": {
       "description": "Importer field id from get_fields for the target entity.",
       "type": "string"
      }
     },
     "required": [
      "targetFieldId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "mappingId": {
    "description": "Mapping id from list_mappings.",
    "type": "string"
   },
   "title": {
    "description": "Human-readable mapping name.",
    "type": "string"
   }
  },
  "required": [
   "companyId",
   "mappingId",
   "title",
   "entityName",
   "fields"
  ],
  "type": "object"
 },
 "name": "update_mapping",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "createdAt": {
    "description": "ISO timestamp.",
    "type": "string"
   },
   "entityName": {
    "description": "Entity this mapping targets.",
    "type": "string"
   },
   "fields": {
    "description": "Persisted field entries.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "fixedValue": {
       "description": "Constant applied to every row, if not mapped from a column."
      },
      "sourceFieldTitle": {
       "description": "CSV column the field reads from.",
       "type": "string"
      },
      "targetFieldId": {
       "description": "Importer field id.",
       "type": "string"
      }
     },
     "required": [
      "targetFieldId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "id": {
    "description": "Mapping id.",
    "type": "string"
   },
   "title": {
    "description": "Mapping name.",
    "type": "string"
   },
   "updatedAt": {
    "description": "ISO timestamp.",
    "type": "string"
   }
  },
  "required": [
   "id",
   "title",
   "entityName",
   "fields"
  ],
  "type": "object"
 }
}
