{
 "description": "Add a label/category or move message to a folder in Outlook",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Outlook message ID to add categories to",
    "minLength": 1,
    "type": "string"
   },
   "labels": {
    "description": "Category names to add (use outlook-categories-list to discover available categories)",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "id",
   "labels"
  ],
  "type": "object"
 },
 "name": "label-add",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "description": "Message ID the categories were added to",
        "type": "string"
       },
       "labels": {
        "description": "Categories that were applied",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "id",
       "type"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
