   "session_id": {
    "description": "\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0441\u0435\u0441\u0441\u0438\u0438 (chat_id) \u0438\u0437 \u043f\u0440\u043e\u0448\u043b\u043e\u0433\u043e ask_advisor \u2014 \u0434\u043b\u044f multi-turn. \u0411\u0435\u0437 \u043d\u0435\u0433\u043e \u0441\u043e\u0437\u0434\u0430\u0451\u0442\u0441\u044f \u043d\u043e\u0432\u0430\u044f \u0441\u0435\u0441\u0441\u0438\u044f.",
