    "type": "string"
   },
   "includeExchanges": {
    "type": "boolean"
   },
   "includeFunds": {
    "type": "boolean"
   },
   "includeLogs": {
    "type": "boolean"
   },
   "includeOffers": {
    "type": "boolean"
   },
   "sellersFilter": {
