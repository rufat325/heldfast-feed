{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get Wallet Balances"
 },
 "description": "Get native ETH and ERC20 token balances for a wallet address. Reads directly from chain via RPC multicall. Use before write.account.add_liquidity or write.account.deposit to verify the wallet has sufficient tokens. Returns both raw balance (smallest unit/wei) and formatted (human-readable) per token.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain_id": {
    "default": 8453,
    "description": "Chain ID: 8453 (Base), 130 (Unichain), or 10 (Optimism)",
    "type": "number"
   },
   "token_addresses": {
    "description": "ERC20 token contract addresses to check",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "wallet_address": {
    "description": "Wallet address to check balances for",
    "type": "string"
   }
  },
  "required": [
   "wallet_address",
   "token_addresses"
  ],
  "type": "object"
 },
 "name": "read.wallet.balances",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "native": {
    "additionalProperties": false,
    "properties": {
     "balance": {
      "type": "string"
     },
     "formatted": {
      "type": "string"
     },
     "symbol": {
      "type": "string"
     }
    },
    "required": [
     "symbol",
     "balance",
     "formatted"
    ],
    "type": "object"
   },
   "tokens": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "type": "string"
      },
      "balance": {
       "type": "string"
      },
      "decimals": {
       "type": "number"
      },
      "formatted": {
       "type": "string"
      },
      "symbol": {
       "type": "string"
      }
     },
     "required": [
      "address",
      "symbol",
      "decimals",
      "balance",
      "formatted"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "native",
   "tokens"
  ],
  "type": "object"
 }
}
