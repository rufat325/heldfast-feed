  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search Poly-Glot's template catalog by keywords and goal, optionally filtered to free or Pro results. Use before get_template or build_prompt when the exact name is unknown. Expired accounts see locked Pro template cards. Selecting one returns a paywall, not Pro fields or prompt text. Searching is read-only and does not trigger a send or trial.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "goal": {
    "description": "Optional intended outcome, e.g. write a help article.",
    "maxLength": 80,
    "type": "string"
   },
   "limit": {
    "default": 12,
    "description": "Maximum matches to return (1 to 24), default 12.",
    "maximum": 24,
    "minimum": 1,
    "type": "integer"
   },
   "plan": {
    "description": "Filter catalog by free or Pro tier; filtering does not grant access.",
    "enum": [
     "free",
     "pro"
    ],
    "type": "string"
   },
   "query": {
    "default": "",
    "description": "Search phrase or topic; blank lists available templates.",
    "maxLength": 200,
    "type": "string"
   },
   "uiLanguage": {
    "default": "EN",
    "description": "Language code for localized template labels; defaults to EN.",
    "maxLength": 80,
    "type": "string"
   }
  },
  "type": "object"
 },
