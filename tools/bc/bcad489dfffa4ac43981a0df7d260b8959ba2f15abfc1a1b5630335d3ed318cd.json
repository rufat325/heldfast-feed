{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Source sheet tags"
 },
 "description": "Source-sheet tags: \"trending\" (this week's trending tags), \"all\" (every tag, sorted by count or alphabetically), or a specific user's tags.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "kind": {
    "default": "trending",
    "enum": [
     "trending",
     "all",
     "user"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "sort_by": {
    "default": "count",
    "enum": [
     "count",
     "alpha"
    ],
    "type": "string"
   },
   "user_id": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_sheet_tags",
 "title": "Source sheet tags"
}
