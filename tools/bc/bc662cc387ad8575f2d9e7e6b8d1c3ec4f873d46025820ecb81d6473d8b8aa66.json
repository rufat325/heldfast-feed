{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Bulk-import normalized time entries (up to 200 per call) \u2014 from Clockify/Toggl/Harvest or a script. Each entry needs cardKey/cardId (or a PREFIX-N in description) plus seconds or start+end; userEmail attributes it. Idempotent on (source, externalId): repeating one updates it rather than duplicating it. One bad entry does not fail the rest.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cardId": {
       "minLength": 1,
       "type": "string"
      },
      "cardKey": {
       "minLength": 1,
       "type": "string"
      },
      "deleted": {
       "type": "boolean"
      },
      "description": {
       "maxLength": 2000,
       "type": "string"
      },
      "end": {
       "type": "string"
      },
      "externalId": {
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "seconds": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "source": {
       "type": "string"
      },
      "start": {
       "type": "string"
      },
      "userEmail": {
       "format": "email",
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 },
 "name": "zuuna_import_time_entries",
 "title": "zuuna_import_time_entries"
}
