 "description": "Use when a user asks about the Hindu calendar day for a location \u2014 tithi, paksha, nakshatra, yoga, karana, vara and its lord, sunrise and sunset, plus Rahu Kaal, Yamaganda, Gulika Kaal and the Choghadiya day/night windows. Needs only a place and a date, so it works without anyone's birth details. Deterministic computation, no LLM. Same compute path as GET /api/panchang.",
 "inputSchema": {
  "properties": {
   "date": {
    "description": "YYYY-MM-DD (default: local today at the location).",
    "type": "string"
   },
   "lat": {
    "description": "Birth latitude, -90 to 90.",
    "type": "number"
   },
   "lng": {
    "description": "Birth longitude, -180 to 180.",
    "type": "number"
   },
   "tz": {
    "description": "UTC offset (e.g. 5.5) or IANA zone name (e.g. Asia/Kolkata).",
    "type": [
     "number",
     "string"
    ]
   }
  },
  "required": [
   "lat",
   "lng",
   "tz"
  ],
  "type": "object"
 },
 "name": "get_panchang",
