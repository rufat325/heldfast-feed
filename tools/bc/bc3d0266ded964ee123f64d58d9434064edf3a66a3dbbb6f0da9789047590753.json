{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Deep research on a topic: outlines 3 to 7 coverage objectives, generates search queries, answers each with library_answer, extracts learnings and follow-up questions, then recurses with half the breadth. Stops once every objective is covered by a learning, at the given depth, at the time budget, or once a round finds no new sources. Requires OPENAI_API_KEY (or ALEXANDRIA_RESEARCH_API_KEY / ALEXANDRIA_SYNTH_API_KEY). Set response_format: \"detailed\" for the per-round breakdown, elapsed time, citation grades, resolvability, and the objectives/coverage outline.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "breadth": {
    "default": 4,
    "description": "Queries generated in the first round; halves each round (default 4)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "depth": {
    "default": 2,
    "description": "Recursion depth (default 2)",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "max_minutes": {
    "default": 6,
    "description": "Wall-clock time budget in minutes (default 6)",
    "exclusiveMinimum": 0,
    "maximum": 30,
    "type": "number"
   },
   "query": {
    "description": "Research topic or question",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "response_format": {
    "default": "concise",
    "description": "concise (default) trims results/citations to high-signal fields; detailed returns the full payload, including routing reasons, scores, and stage diagnostics.",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "library_research",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "citations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "grade": {
       "additionalProperties": false,
       "properties": {
        "signals": {
         "additionalProperties": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "tier": {
         "enum": [
          "A",
          "B",
          "C",
          "D"
         ],
         "type": "string"
        }
       },
       "required": [
        "tier",
        "signals"
       ],
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "n": {
       "type": "number"
      },
      "resolves": {
       "type": "boolean"
      },
      "source": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "via": {
       "const": "corpus",
       "type": "string"
      }
     },
     "required": [
      "n",
      "source",
      "id",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "coverage": {
    "items": {
     "type": "boolean"
    },
    "type": "array"
   },
   "elapsedMs": {
    "type": "number"
   },
   "objectives": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "report": {
    "type": "string"
   },
   "rounds": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "newSources": {
       "type": "number"
      },
      "queries": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "round": {
       "type": "number"
      },
      "truncated": {
       "type": "boolean"
      }
     },
     "required": [
      "round",
      "queries",
      "newSources",
      "truncated"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "report",
   "citations"
  ],
  "type": "object"
 },
 "title": "Recursive Cited Research"
}
