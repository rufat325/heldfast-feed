{
 "description": "Send a mini split quote request to the crew. Only when the user explicitly asks to be contacted and gives their own phone or email.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "email": {
    "format": "email",
    "maxLength": 120,
    "type": "string"
   },
   "name": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "phone": {
    "maxLength": 30,
    "type": "string"
   },
   "rooms": {
    "maxLength": 400,
    "type": "string"
   },
   "zip": {
    "maxLength": 10,
    "type": "string"
   },
   "zones": {
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "request_quote",
 "title": "Request a quote"
}
