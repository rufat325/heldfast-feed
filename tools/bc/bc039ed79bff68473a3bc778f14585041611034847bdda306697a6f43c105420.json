{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "read:ads"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search the public Ad Library"
 },
 "description": "Search the public Ad Library. Read only; no ad spending or changes. Full field guide: soclo://tools/soclo_ads_search_ad_library.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "parameters": {
    "properties": {
     "adType": {
      "enum": [
       "ALL",
       "POLITICAL_AND_ISSUE_ADS",
       "HOUSING_ADS",
       "EMPLOYMENT_ADS",
       "FINANCIAL_PRODUCTS_AND_SERVICES_ADS"
      ],
      "type": "string"
     },
     "advertiser": {
      "maxLength": 100,
      "type": "string"
     },
     "after": {
      "type": "string"
     },
     "countries": {
      "type": "string"
     },
     "fields": {
      "type": "string"
     },
     "languages": {
      "type": "string"
     },
     "limit": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     },
     "mediaType": {
      "enum": [
       "ALL",
       "IMAGE",
       "MEME",
       "VIDEO",
       "NONE"
      ],
      "type": "string"
     },
     "pageIds": {
      "type": "string"
     },
     "platforms": {
      "type": "string"
     },
     "q": {
      "maxLength": 100,
      "type": "string"
     },
     "searchType": {
      "enum": [
       "KEYWORD_UNORDERED",
       "KEYWORD_EXACT_PHRASE"
      ],
      "type": "string"
     },
     "since": {
      "type": "string"
     },
     "status": {
      "enum": [
       "ACTIVE",
       "INACTIVE",
       "ALL"
      ],
      "type": "string"
     },
     "until": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId"
  ],
  "type": "object"
 },
 "name": "soclo_ads_search_ad_library",
 "title": "Search the public Ad Library"
}
