{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Epidemiology Extraction Table"
 },
 "description": "Build a structured epidemiology extraction table (country \u00d7 prevalence \u00d7 incidence \u00d7 definition \u00d7 year) from agent-extracted rows. Applies an explicit source-quality hierarchy (IHME GBD/WHO > national survey/registry > systematic review > single observational study) and Hoy et al. 2012 / JBI prevalence-study checklist scoring. Use after literature_search (with literature_search_plan) and screen_abstracts for descriptive epidemiology \u2014 replaces risk_of_bias for prevalence/incidence reviews. Pass one row per country/source; the tool ranks preferred estimates per country.",
 "inputSchema": {
  "properties": {
   "condition": {
    "type": "string"
   },
   "output_format": {
    "enum": [
     "text",
     "json"
    ],
    "type": "string"
   },
   "rows": {
    "items": {
     "properties": {
      "country": {
       "type": "string"
      },
      "definition": {
       "type": "string"
      },
      "hoy_responses": {
       "additionalProperties": {
        "enum": [
         "yes",
         "no",
         "unclear"
        ],
        "type": "string"
       },
       "type": "object"
      },
      "incidence": {
       "type": [
        "string",
        "number"
       ]
      },
      "notes": {
       "type": "string"
      },
      "prevalence": {
       "type": [
        "string",
        "number"
       ]
      },
      "source_connector": {
       "type": "string"
      },
      "source_id": {
       "type": "string"
      },
      "source_title": {
       "type": "string"
      },
      "source_type": {
       "enum": [
        "ihme_gbd",
        "who_gho",
        "national_survey",
        "census",
        "disease_registry",
        "systematic_review",
        "meta_analysis",
        "cohort",
        "cross_sectional",
        "case_control",
        "narrative_review",
        "expert_opinion",
        "other"
       ],
       "type": "string"
      },
      "study_design": {
       "type": "string"
      },
      "year": {
       "type": [
        "string",
        "number"
       ]
      }
     },
     "required": [
      "country"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "target_countries": {
    "description": "Expected countries (e.g. EU-5 list) \u2014 missing countries flagged in output",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "rows"
  ],
  "type": "object"
 },
 "name": "epidemiology.extract"
}
