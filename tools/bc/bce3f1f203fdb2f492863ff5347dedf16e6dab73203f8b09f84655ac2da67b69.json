{
 "description": "Upload one or more text files into an artifact bundle. Requires files:write for API keys.",
 "inputSchema": {
  "properties": {
   "artifactBundleId": {
    "format": "uuid",
    "type": "string"
   },
   "files": {
    "items": {
     "properties": {
      "artifactType": {
       "type": "string"
      },
      "content": {
       "type": "string"
      },
      "mediaType": {
       "type": "string"
      },
      "message": {
       "maxLength": 500,
       "type": "string"
      },
      "path": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "path",
      "content"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "artifactBundleId",
   "files"
  ],
  "type": "object"
 },
 "name": "rubrkit_upload_artifact_files",
 "title": "Upload artifact files"
}
