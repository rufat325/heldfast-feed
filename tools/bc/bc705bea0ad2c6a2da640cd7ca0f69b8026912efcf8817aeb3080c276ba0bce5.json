{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a BLE beacon proximity scaffold with sanitized beacon rows, zone maps, smoothing policy, adapter source, and device-privacy notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "websocket_json",
    "enum": [
     "websocket_json",
     "http_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "ws://127.0.0.1:9085/ble",
    "type": "string"
   },
   "beacon_count": {
    "default": 16,
    "maximum": 2048,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "ble_beacon_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the BLE scaffold.",
    "type": "string"
   },
   "scanner_count": {
    "default": 4,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "site_label": {
    "default": "gallery_floor",
    "type": "string"
   },
   "smoothing_window_sec": {
    "default": 15,
    "maximum": 3600,
    "minimum": 1,
    "type": "integer"
   },
   "zone_count": {
    "default": 6,
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_ble_beacon_bus",
 "title": "Connect BLE beacon bus"
}
