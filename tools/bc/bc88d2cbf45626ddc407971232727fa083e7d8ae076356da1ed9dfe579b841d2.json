{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Busca produtos com filtros combinados de texto, categoria, tags, pre\u00e7o e estoque.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Nome da categoria.",
    "type": "string"
   },
   "company": {
    "description": "Slug da empresa: guapissimas, compraracoes ou indexagent.",
    "enum": [
     "guapissimas",
     "compraracoes",
     "indexagent"
    ],
    "type": "string"
   },
   "in_stock_only": {
    "description": "Somente em estoque.",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "M\u00e1ximo de resultados.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "description": "Pre\u00e7o m\u00e1ximo (BRL).",
    "type": "number"
   },
   "min_price": {
    "description": "Pre\u00e7o m\u00ednimo (BRL).",
    "type": "number"
   },
   "query": {
    "description": "Texto livre.",
    "type": "string"
   },
   "tags": {
    "description": "Tags exigidas (use 'teste_gratis' para Comprar A\u00e7\u00f5es).",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "company"
  ],
  "type": "object"
 },
 "name": "search_products",
 "title": "Buscar produtos"
}
