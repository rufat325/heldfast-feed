{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find .si names"
 },
 "description": "Search Hivex's index of .si domain names that are free to register. Filter by a word or fragment (contains, starts with, ends with, exact), length and minimum score; sort by best score, newest or shortest. Returns up to 25 names, each with its hivex.si page.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "match": {
    "default": "contains",
    "enum": [
     "contains",
     "starts",
     "ends",
     "exact"
    ],
    "type": "string"
   },
   "max_length": {
    "maximum": 63,
    "minimum": 2,
    "type": "integer"
   },
   "min_length": {
    "maximum": 63,
    "minimum": 2,
    "type": "integer"
   },
   "min_score": {
    "description": "Hivex Domain Ranking floor (70+ is strong, 80+ rare)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "A word or fragment, letters a-z, digits and hyphens (e.g. 'agent', 'lumen'). Leave empty to browse.",
    "maxLength": 30,
    "type": "string"
   },
   "sort": {
    "default": "best",
    "enum": [
     "best",
     "newest",
     "shortest"
    ],
    "type": "string"
   },
   "status": {
    "default": "any",
    "description": "free: confirmed by the registry; likely_free: no DNS, not confirmed yet",
    "enum": [
     "any",
     "free",
     "likely_free"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_names",
 "outputSchema": {
  "properties": {
   "more_at": {
    "type": "string"
   },
   "names": {
    "items": {
     "properties": {
      "category": {
       "type": "string"
      },
      "domain": {
       "type": "string"
      },
      "found": {
       "description": "When Hivex first saw it free (ISO date)",
       "type": "string"
      },
      "length": {
       "type": "integer"
      },
      "score": {
       "description": "Hivex Domain Ranking, 0 to 100",
       "type": "number"
      },
      "status": {
       "enum": [
        "free",
        "likely_free"
       ],
       "type": "string"
      },
      "tier": {
       "type": "string"
      },
      "url": {
       "description": "The name's page on hivex.si: live check and registrar links",
       "type": "string"
      },
      "words": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "domain",
      "status",
      "score",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   }
  },
  "required": [
   "names",
   "more_at"
  ],
  "type": "object"
 },
 "title": "Find .si names"
}
