{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Capture a screenshot to an image file and return its path (the image is written on the server host; the bytes are NOT returned inline). With ref/selector, captures just that element; otherwise the targeted window (windowId > windowTitle > windowIndex, default the active window) with optional fullPage or clip. Options: format (png|jpeg), quality (jpeg), path (absolute file) or dir (absolute directory, generated filename). With neither, writes to the server --screenshot-dir if configured, else the OS temp dir \u2014 pass dir or set --screenshot-dir for a stable, retrievable artifact location. Returns: { ok, session_id, path, bytes, format, width?, height? } (path is the absolute file written). When portable delivery is available, artifact metadata and an MCP resource_link let the client read the generated bytes before expires_at; otherwise artifact_unavailable explains the limit. Errors: ABSOLUTE_PATH_REQUIRED (relative path), REF_NOT_FOUND (no such window), SELECTOR_NO_MATCH (element not found), SURFACE_UNSUPPORTED (iframe element crops are not window-relative), NOT_RUNNING, BAD_ARGUMENT (invalid selector/options).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "clip": {
    "additionalProperties": false,
    "description": "Explicit capture rectangle in CSS pixels (window capture only).",
    "properties": {
     "height": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "width": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y",
     "width",
     "height"
    ],
    "type": "object"
   },
   "dir": {
    "description": "Absolute output DIRECTORY; the filename is generated. Use this (or the server --screenshot-dir default) for a stable, per-session artifact location instead of the OS temp dir. Mutually exclusive with path.",
    "type": "string"
   },
   "format": {
    "default": "png",
    "description": "Image format. Default png.",
    "enum": [
     "png",
     "jpeg"
    ],
    "type": "string"
   },
   "fullPage": {
    "description": "Capture the full scrollable page (window capture only).",
    "type": "boolean"
   },
   "path": {
    "description": "Absolute output file path. Takes precedence over dir / the server default.",
    "type": "string"
   },
   "quality": {
    "description": "JPEG quality 0-100 (jpeg only).",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "ref": {
    "description": "Element ref from a snapshot (resolves to [data-sw-ref=\"N\"]). Provide ref OR selector.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "selector": {
    "description": "CSS selector. Provide ref OR selector, not both.",
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "description": "Target session id. Omit when a single session is running.",
    "type": "string"
   },
   "windowId": {
    "description": "Target window transport id (highest precedence).",
    "type": "string"
   },
   "windowIndex": {
    "description": "Target window by 0-based index.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "windowTitle": {
    "description": "Target window by exact title.",
    "type": "string"
   }
  },
  "required": [
   "format"
  ],
  "type": "object"
 },
 "name": "electron_screenshot",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
   {
    "additionalProperties": {},
    "properties": {
     "_meta": {
      "additionalProperties": {},
      "properties": {
       "elapsed_ms": {
        "minimum": 0,
        "type": "number"
       },
       "estimated_tokens": {
        "minimum": 0,
        "type": "number"
       },
       "session_id": {
        "type": "string"
       }
      },
      "required": [
       "estimated_tokens",
       "elapsed_ms"
      ],
      "type": "object"
     },
     "artifact": {
      "additionalProperties": false,
      "properties": {
       "expires_at": {
        "type": "string"
       },
       "mimeType": {
        "enum": [
         "image/png",
         "image/jpeg",
         "application/x-ndjson",
         "application/json",
         "text/html"
        ],
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "size": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "uri": {
        "type": "string"
       }
      },
      "required": [
       "uri",
       "name",
       "mimeType",
       "size",
       "expires_at"
      ],
      "type": "object"
     },
     "artifact_unavailable": {
      "enum": [
       "too_large",
       "capacity",
       "closed",
       "unsupported_type"
      ],
      "type": "string"
     },
     "bytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "format": {
      "enum": [
       "png",
       "jpeg"
      ],
      "type": "string"
     },
     "height": {
      "type": "number"
     },
     "ok": {
      "const": true,
      "type": "boolean"
     },
     "path": {
      "type": "string"
     },
     "session_id": {
      "type": "string"
     },
     "width": {
      "type": "number"
     }
    },
    "required": [
     "session_id",
     "path",
     "bytes",
     "format",
     "ok",
     "_meta"
    ],
    "type": "object"
   },
   {
    "additionalProperties": {},
    "properties": {
     "_meta": {
      "additionalProperties": {},
      "properties": {
       "elapsed_ms": {
        "minimum": 0,
        "type": "number"
       },
       "estimated_tokens": {
        "minimum": 0,
        "type": "number"
       },
       "session_id": {
        "type": "string"
       }
      },
      "required": [
       "estimated_tokens",
       "elapsed_ms"
      ],
      "type": "object"
     },
     "code": {
      "type": "string"
     },
     "error": {
      "type": "string"
     },
     "hint": {
      "type": "string"
     },
     "http": {
      "type": "number"
     },
     "ok": {
      "const": false,
      "type": "boolean"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "ok",
     "error",
     "code",
     "hint",
     "retryable",
     "http",
     "_meta"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Capture a screenshot"
}
