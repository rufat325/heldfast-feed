{
 "description": "List grouped JavaScript errors for a site, busiest first. Use jamp_get_error with a fingerprint for the full stack trace and the release it appeared in.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max groups, default 25",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "site": {
    "description": "Site id from jamp_list_sites",
    "type": "string"
   },
   "window": {
    "description": "Time window, default 7d",
    "enum": [
     "24h",
     "7d",
     "30d",
     "90d"
    ],
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "jamp_list_errors"
}
