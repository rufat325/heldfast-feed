{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing webhook (events, URL, status, secret)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "New description",
    "type": "string"
   },
   "events": {
    "description": "New event list (replaces existing)",
    "items": {
     "enum": [
      "REGISTERED_MODEL_CREATED",
      "MODEL_VERSION_CREATED",
      "MODEL_VERSION_TRANSITIONED_STAGE",
      "MODEL_VERSION_TRANSITIONED_TO_STAGING",
      "MODEL_VERSION_TRANSITIONED_TO_PRODUCTION",
      "MODEL_VERSION_TRANSITIONED_TO_ARCHIVED",
      "MODEL_VERSION_TAG_SET",
      "MODEL_VERSION_TAG_DELETED",
      "MODEL_VERSION_ALIAS_CREATED",
      "MODEL_VERSION_ALIAS_DELETED",
      "REGISTERED_MODEL_TAG_SET",
      "REGISTERED_MODEL_TAG_DELETED"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "Webhook ID to update",
    "type": "string"
   },
   "secret": {
    "description": "New signing secret",
    "type": "string"
   },
   "status": {
    "description": "New status",
    "enum": [
     "ACTIVE",
     "DISABLED"
    ],
    "type": "string"
   },
   "url": {
    "description": "New URL",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update-webhook"
}
