{"annotations":{"openWorldHint":true,"readOnlyHint":true},"description":"Verify the issuance of a Korean electronic tax invoice or e-statement (\uc81c3\uc790 \ubc1c\uae09\uc0ac\uc2e4 \uc870\ud68c). \uacf5\uae09\uc790 \uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638\u00b7\uacf5\uae09\ubc1b\ub294\uc790 \ub4f1\ub85d\ubc88\ud638\u00b7\uc2b9\uc778\ubc88\ud638\u00b7\uc791\uc131\uc77c\uc790\u00b7\uacf5\uae09\uac00\uc561\uc73c\ub85c \uc804\uc790\uc138\uae08\uacc4\uc0b0\uc11c\u00b7\uc804\uc790\uacc4\uc0b0\uc11c \ubc1c\uae09 \uc0ac\uc2e4\uc744 \ud655\uc778\ud569\ub2c8\ub2e4. \ud655\uc778 \uacb0\uacfc\ub294 verified(true \ubc1c\uae09 \uc0ac\uc2e4 \ud655\uc778, false \ubc1c\uae09 \uc774\ub825 \uc5c6\uc74c)\ub85c \uc751\ub2f5\ud558\uba70 \uc6d0\ubb38\uc740 \ub3cc\ub824\uc8fc\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. [\ud638\ucd9c\ub2f9 40\ud3ec\uc778\ud2b8]","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"dmnr_no":{"description":"\uacf5\uae09\ubc1b\ub294\uc790 \ub4f1\ub85d\ubc88\ud638 \u2014 \uc0ac\uc5c5\uc790 10\uc790\ub9ac \ub610\ub294 \uc8fc\ubbfc 13\uc790\ub9ac","pattern":"^[0-9]{10}$|^[0-9]{13}$","type":"string"},"etan":{"description":"\uc2b9\uc778\ubc88\ud638(24\uc790\ub9ac \uc774\uc0c1, \uacf5\ubc31\u00b7\ud558\uc774\ud508 \uc81c\uac70 \ud6c4 \uc0ac\uc6a9)","type":"string"},"splr_no":{"description":"\uacf5\uae09\uc790 \uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638 10\uc790\ub9ac","pattern":"^[0-9]{10}$","type":"string"},"sum_amt":{"description":"\uacf5\uae09\uac00\uc561(\uc6d0, \uc22b\uc790\ub9cc)","pattern":"^[0-9]{1,13}$","type":"string"},"wrt_dt":{"description":"\uc791\uc131\uc77c\uc790 YYYYMMDD","pattern":"^[0-9]{8}$","type":"string"}},"required":["splr_no","dmnr_no","etan","wrt_dt","sum_amt"],"type":"object"},"name":"tax_invoice_third_party_check","title":"\uc804\uc790\uc138\uae08\uacc4\uc0b0\uc11c \ubc1c\uae09\uc0ac\uc2e4 \ud655\uc778"}
