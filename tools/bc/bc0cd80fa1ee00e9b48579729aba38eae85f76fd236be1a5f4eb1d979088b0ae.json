{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Build the UNSIGNED transaction that cancels a cross-chain escrow position and returns the funds to the owner wallet. Use when: a cross-chain swap did not settle \u2014 track_crosschain_swap shows cancellation_mode=onchain (before that the position cannot be cancelled by the trader). Non-custodial: returns TonConnect-ready messages for the SAME wallet that created the escrow; nothing is signed or sent here. After signing and sending, the escrowed input (and the security deposit) come back to the owner.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "quote_id": {
    "description": "Quote id returned by get_crosschain_quote",
    "type": "string"
   },
   "wallet": {
    "description": "The TON wallet that created the escrow position (only it can cancel)",
    "type": "string"
   }
  },
  "required": [
   "quote_id",
   "wallet"
  ],
  "type": "object"
 },
 "name": "build_crosschain_refund",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message_count": {
    "type": "number"
   },
   "quote_id": {
    "type": "string"
   },
   "tonconnect": {
    "additionalProperties": false,
    "properties": {
     "messages": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "address": {
         "type": "string"
        },
        "amount": {
         "type": "string"
        },
        "payload": {
         "type": "string"
        },
        "stateInit": {
         "type": "string"
        }
       },
       "required": [
        "address",
        "amount",
        "payload"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "network": {
      "type": "string"
     },
     "validUntil": {
      "type": "number"
     }
    },
    "required": [
     "validUntil",
     "network",
     "messages"
    ],
    "type": "object"
   },
   "total_attached_nano": {
    "type": "string"
   },
   "wallet": {
    "type": "string"
   }
  },
  "required": [
   "quote_id",
   "wallet",
   "message_count",
   "total_attached_nano",
   "tonconnect"
  ],
  "type": "object"
 },
 "title": "Build cross-chain refund"
}
