{
 "description": "Advanced backward-compatible Project To-do action union. Prefer the focused preflight/create/assign/archive/future-policy/activation tools because their schemas expose mandatory safety rules. preflight and activation_preview are no-write and omit idempotencyKey; every mutation requires a stable idempotencyKey. Requires project_todos:write scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Which Project To-do mutation to perform. Employer actions: set_enabled, create_category, create_item, update_item, archive_item, assign, set_future_assignment, activation_preview (no-write), activate (audited override), reorder_items (display only), review. Worker action: worker_transition. Prefer the focused activation tools for the activation family.",
    "enum": [
     "preflight",
     "set_enabled",
     "create_category",
     "create_item",
     "update_item",
     "archive_item",
     "assign",
     "set_future_assignment",
     "activation_preview",
     "activate",
     "reorder_items",
     "worker_transition",
     "review"
    ],
    "type": "string"
   },
   "allowDuplicate": {
    "description": "create_item: explicit override for an exact active duplicate warning.",
    "type": "boolean"
   },
   "assign": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "audience": {
        "enum": [
         "ACTIVE",
         "FUTURE",
         "ACTIVE_AND_FUTURE",
         "SELECTED"
        ],
        "type": "string"
       },
       "selectedContractIds": {
        "items": {
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 500,
        "type": "array"
       }
      },
      "required": [
       "audience"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "update_item: reissue the new version to this audience."
   },
   "assignmentId": {
    "description": "worker_transition / review: the assignment (obligation) id.",
    "minLength": 1,
    "type": "string"
   },
   "audience": {
    "description": "create_item / assign: who receives the obligation. REQUIRED for create_item and assign \u2014 the server rejects omissions instead of defaulting to an ACTIVE fan-out.",
    "enum": [
     "ACTIVE",
     "FUTURE",
     "ACTIVE_AND_FUTURE",
     "SELECTED"
    ],
    "type": "string"
   },
   "autoAssignNewHires": {
    "description": "create_item: keep the item armed for future hires.",
    "type": "boolean"
   },
   "categoryId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "create_item: category id (omit to use the General category)."
   },
   "decision": {
    "description": "review: APPROVE completes, RETURN rejects with a correction request, WAIVE is the audited admin override, CLOSE revokes.",
    "enum": [
     "APPROVE",
     "RETURN",
     "WAIVE",
     "CLOSE"
    ],
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 1000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "create_category: optional description."
   },
   "enabled": {
    "description": "set_enabled: turn the module on/off; set_future_assignment: exact future-hire policy state.",
    "type": "boolean"
   },
   "evidence": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "payload": {
        "anyOf": [
         {},
         {
          "type": "null"
         }
        ]
       },
       "referenceId": {
        "anyOf": [
         {
          "maxLength": 500,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "type": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "worker_transition: optional typed completion evidence."
   },
   "expectedSubmittedAt": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "review: stale-submission concurrency guard."
   },
   "idempotencyKey": {
    "description": "Client idempotency key (min 8 chars). Deterministic retries with the same key converge instead of duplicating work.",
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "itemId": {
    "description": "update_item / archive_item / assign / activation_preview: the logical item id.",
    "minLength": 1,
    "type": "string"
   },
   "jobId": {
    "description": "Job id (employer actions).",
    "minLength": 1,
    "type": "string"
   },
   "key": {
    "description": "create_item: stable item key.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "create_category: category name.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "operation": {
    "description": "preflight: the exact live operation to preview without writing.",
    "enum": [
     "create_item",
     "update_item",
     "assign",
     "archive_item",
     "set_future_assignment"
    ],
    "type": "string"
   },
   "orderedItemIds": {
    "description": "reorder_items: the category's complete non-archived item id set, in display order.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "preflightReceipt": {
    "description": "Broad create/update/assign or set_future_assignment: signed receipt from the exact matching preflight.",
    "minLength": 1,
    "type": "string"
   },
   "reason": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "archive_item / review RETURN/WAIVE/CLOSE: required human-readable reason."
   },
   "rule": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "mode": {
        "enum": [
         "ALL",
         "ANY"
        ],
        "type": "string"
       },
       "predicates": {
        "items": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "itemId": {
             "description": "Same-job prerequisite item id (stable).",
             "minLength": 1,
             "type": "string"
            },
            "kind": {
             "const": "todo_completed",
             "type": "string"
            },
            "satisfaction": {
             "enum": [
              "COMPLETED_ONLY",
              "COMPLETED_OR_WAIVED"
             ],
             "type": "string"
            }
           },
           "required": [
            "kind",
            "itemId"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "anchor": {
             "enum": [
              "ASSIGNED",
              "CONTRACT_START"
             ],
             "type": "string"
            },
            "kind": {
             "const": "after_delay",
             "type": "string"
            },
            "offsetMinutes": {
             "exclusiveMinimum": 0,
             "maximum": 525600,
             "type": "integer"
            }
           },
           "required": [
            "kind",
            "anchor",
            "offsetMinutes"
           ],
           "type": "object"
          }
         ]
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array"
       },
       "schemaVersion": {
        "const": 1,
        "type": "number"
       }
      },
      "required": [
       "schemaVersion",
       "mode",
       "predicates"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "activation_preview: draft activation rule to preview before publishing."
   },
   "selectedContractIds": {
    "description": "Audience SELECTED: the exact contract ids.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "transition": {
    "description": "worker_transition: the worker action to apply.",
    "enum": [
     "VIEW",
     "START",
     "COMPLETE",
     "SUBMIT"
    ],
    "type": "string"
   },
   "version": {
    "additionalProperties": {},
    "description": "create_item / update_item: immutable version definition \u2014 title, type (MANUAL_ACTION, READ_ACKNOWLEDGE, EXTERNAL_ACTION, EMPLOYER_REVIEW, QUIZ, TRAINING, PLATFORM_REQUIREMENT, INTEGRATION_ACTION), priority, blockingMode/Scope, dueOffsetMinutes, completionConfig (actionUrl must be absolute http(s); INTEGRATION_ACTION requires provider).",
    "type": "object"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "opentrain_manage_project_todo",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
