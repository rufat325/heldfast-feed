{"description":"Record a sale made outside the storefront (in person, WhatsApp, phone). payment.mode \"paid\" with method cash/spei/card/other when the money was already received: needs confirm: true after the owner checks the total. payment.mode \"link\" to get a Stripe payment link for the customer (the order waits as pending_payment and opens when paid). Stock is taken immediately; unit_price_amount overrides the price for this order only. Services must be booked from the storefront. Money is an integer in minor units: $199.90 MXN is 19990.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"dry_run":{"default":false,"description":"Validate and show what would happen without changing anything.","type":"boolean"},"order":{"properties":{"channel":{"enum":["admin","whatsapp","api","agent"],"type":"string"},"confirm":{"description":"Required (true) with payment.mode \"paid\": it records money received.","type":"boolean"},"discount_codes":{"items":{"maxLength":40,"minLength":1,"type":"string"},"maxItems":5,"type":"array"},"email":{"format":"email","pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"first_name":{"maxLength":100,"type":"string"},"items":{"items":{"properties":{"quantity":{"default":1,"maximum":999,"minimum":1,"type":"integer"},"unit_price_amount":{"description":"Overrides the catalog price for this order only.","maximum":9007199254740991,"minimum":0,"type":"integer"},"variant_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"}},"required":["variant_id"],"type":"object"},"maxItems":100,"minItems":1,"type":"array"},"last_name":{"maxLength":100,"type":"string"},"note":{"maxLength":2000,"type":"string"},"notify_customer":{"default":true,"type":"boolean"},"payment":{"oneOf":[{"properties":{"method":{"enum":["cash","spei","card","other"],"type":"string"},"mode":{"const":"paid","type":"string"},"reference":{"maxLength":200,"type":"string"}},"required":["mode","method"],"type":"object"},{"properties":{"mode":{"const":"link","type":"string"},"success_url":{"format":"uri","type":"string"}},"required":["mode"],"type":"object"}]},"phone":{"maxLength":30,"type":"string"},"shipping_address":{"properties":{"city":{"maxLength":120,"minLength":1,"type":"string"},"company":{"maxLength":200,"type":"string"},"country":{"pattern":"^[A-Z]{2}$","type":"string"},"first_name":{"maxLength":100,"type":"string"},"last_name":{"maxLength":100,"type":"string"},"line1":{"maxLength":200,"minLength":1,"type":"string"},"line2":{"maxLength":200,"type":"string"},"phone":{"maxLength":30,"type":"string"},"postal_code":{"maxLength":20,"minLength":1,"type":"string"},"state":{"maxLength":120,"type":"string"}},"required":["line1","city","postal_code","country"],"type":"object"},"shipping_amount":{"default":0,"description":"Integer amount in minor units (cents). $199.90 \u2192 19990. Never a decimal.","maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["email","items","payment"],"type":"object"}},"required":["order"],"type":"object"},"name":"order_create","title":"Record a manual order"}
