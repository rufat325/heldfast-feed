{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Submits a Hugging Face repo or a custom OCI image as a draft template. It stays unpublished until an operator reviews it. Needs an API key on a verified account. Provide hf_repo or oci_image. Run probe_hf_model first to pick the engine.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"category":{"description":"Template category, e.g. \"llm\".","maxLength":40,"minLength":1,"type":"string"},"description":{"maxLength":4000,"type":"string"},"engine":{"description":"Engine from probe_hf_model, e.g. vllm.","maxLength":40,"minLength":1,"type":"string"},"hf_repo":{"maxLength":240,"minLength":1,"type":"string"},"name":{"maxLength":120,"minLength":1,"type":"string"},"oci_image":{"maxLength":240,"minLength":1,"type":"string"},"summary":{"maxLength":280,"type":"string"},"tags":{"items":{"maxLength":40,"minLength":1,"type":"string"},"maxItems":12,"type":"array"}},"required":["name","category"],"type":"object"},"name":"propose_model","title":"Propose a model template"}
