{
 "_meta": {
  "openai/annotationJustification": "Overwrites the living site brief in `_intent/site.md` that guides agents and publish gates.",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update site brief"
 },
 "description": "Update `_intent/site.md` (site brief) or a page brief when `page` is set. See field descriptions for rules, notes, and head enums.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appendHandoff": {
    "description": "Append a hand-off log line \u2014 site brief only; ignored when page is set.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "body": {
    "description": "Replace narrative body (site \u226450k chars; page \u226410k).",
    "maxLength": 50000,
    "type": "string"
   },
   "context": {
    "description": "One sentence: why you are calling this tool and what you are trying to accomplish. Stored on the site's activity log and visible to everyone on the site \u2014 never put secrets or personal data here.",
    "minLength": 1,
    "type": "string"
   },
   "goal": {
    "description": "Current goal (site \u22644k chars; page \u22642k).",
    "maxLength": 4000,
    "type": "string"
   },
   "guestToken": {
    "description": "Guest token from start_site. Send it on every call until claim_site. Omit when this chat is already signed in to Dotsy.",
    "minLength": 20,
    "type": "string"
   },
   "head": {
    "description": "Head fields to merge. Site: purpose, audience, kind (exploration|production), priorities ({seo,analytics,design,mobile}: must|nice|skip), editingModel (ai|simple-editor|creator), sections, design (strict): palette string[] max 8, type string[] max 6, layout string max 80 chars \u2014 no other keys. Page: purpose, design.{direction,hero}."
   },
   "notes": {
    "anyOf": [
     {
      "maxLength": 4000,
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "content": {
        "anyOf": [
         {
          "maxLength": 4000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "design": {
        "anyOf": [
         {
          "maxLength": 4000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "seo": {
        "anyOf": [
         {
          "maxLength": 4000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "type": "object"
     }
    ],
    "description": "Site: free-form ## Notes string (\u22644k) OR per-section notes object for Design system / Content & CMS / SEO (null clears one). Page brief: string only (\u22642k)."
   },
   "page": {
    "description": "Content key \u2014 targets that page's brief (`_intent/pages/<key>.md`). Omit for the site brief.",
    "type": "string"
   },
   "removeRules": {
    "description": "Ids of rules or guidelines to remove (site brief only).",
    "items": {
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   },
   "rules": {
    "description": "Rules & guidelines lines to add or change (upsert by id \u2014 send only fields you change; omitted fields keep their stored value; check: null turns a Rule into a Guideline). A supported check (title-max, title-suffix, description-length, one-h1, banned-words, image-alt, allowed-colors, allowed-fonts) makes a Rule \u2014 use level block for hard musts (banned words, title suffix), warn for softer checks. locked can only be set by a person; locked: false unlocks.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "card": {
       "enum": [
        "intent",
        "design",
        "content",
        "seo"
       ],
       "type": "string"
      },
      "check": {
       "anyOf": [
        {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "max": {
             "maximum": 300,
             "minimum": 10,
             "type": "integer"
            },
            "type": {
             "const": "title-max",
             "type": "string"
            }
           },
           "required": [
            "type",
            "max"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "suffix": {
             "maxLength": 60,
             "minLength": 1,
             "type": "string"
            },
            "type": {
             "const": "title-suffix",
             "type": "string"
            }
           },
           "required": [
            "type",
            "suffix"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "max": {
             "maximum": 1000,
             "minimum": 1,
             "type": "integer"
            },
            "min": {
             "maximum": 1000,
             "minimum": 0,
             "type": "integer"
            },
            "type": {
             "const": "description-length",
             "type": "string"
            }
           },
           "required": [
            "type",
            "min",
            "max"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "type": {
             "const": "one-h1",
             "type": "string"
            }
           },
           "required": [
            "type"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "type": {
             "const": "banned-words",
             "type": "string"
            },
            "words": {
             "items": {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
             },
             "maxItems": 50,
             "minItems": 1,
             "type": "array"
            }
           },
           "required": [
            "type",
            "words"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "type": {
             "const": "image-alt",
             "type": "string"
            }
           },
           "required": [
            "type"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "colors": {
             "items": {
              "pattern": "^#([0-9a-f]{3}|[0-9a-f]{6}|[0-9a-f]{8})$",
              "type": "string"
             },
             "maxItems": 24,
             "minItems": 1,
             "type": "array"
            },
            "type": {
             "const": "allowed-colors",
             "type": "string"
            }
           },
           "required": [
            "type",
            "colors"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "fonts": {
             "items": {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
             },
             "maxItems": 12,
             "minItems": 1,
             "type": "array"
            },
            "type": {
             "const": "allowed-fonts",
             "type": "string"
            }
           },
           "required": [
            "type",
            "fonts"
           ],
           "type": "object"
          }
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "pattern": "^[a-z0-9-]{2,40}$",
       "type": "string"
      },
      "level": {
       "enum": [
        "block",
        "warn"
       ],
       "type": "string"
      },
      "locked": {
       "type": "boolean"
      },
      "text": {
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "id",
      "card",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "type": "array"
   },
   "site": {
    "description": "Site slug, e.g. acme-studio",
    "type": "string"
   }
  },
  "required": [
   "site",
   "context"
  ],
  "type": "object"
 },
 "name": "update_brief"
}
