{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Format cells"
 },
 "description": "Apply formatting to a range: font styles, colors, number formats, alignment, wrapping, borders. Only provided options are changed. To style several ranges differently in one go, use format_ranges.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "account": {
    "description": "Google account to use: an email or unique part of one (e.g. \"acme.com\"). Default: the account that can open the spreadsheet, else the default account.",
    "type": "string"
   },
   "background_color": {
    "description": "Hex, e.g. #f1f3f4",
    "type": "string"
   },
   "bold": {
    "type": "boolean"
   },
   "borders": {
    "properties": {
     "color": {
      "default": "#000000",
      "type": "string"
     },
     "sides": {
      "enum": [
       "all",
       "outer",
       "inner",
       "top",
       "bottom",
       "left",
       "right",
       "none"
      ],
      "type": "string"
     },
     "style": {
      "default": "SOLID",
      "enum": [
       "SOLID",
       "SOLID_MEDIUM",
       "SOLID_THICK",
       "DASHED",
       "DOTTED",
       "DOUBLE"
      ],
      "type": "string"
     }
    },
    "required": [
     "sides"
    ],
    "type": "object"
   },
   "clear_formatting": {
    "default": false,
    "description": "Reset all formatting first",
    "type": "boolean"
   },
   "font_family": {
    "type": "string"
   },
   "font_size": {
    "type": "number"
   },
   "horizontal_alignment": {
    "enum": [
     "LEFT",
     "CENTER",
     "RIGHT"
    ],
    "type": "string"
   },
   "italic": {
    "type": "boolean"
   },
   "number_format": {
    "properties": {
     "pattern": {
      "description": "e.g. \"#,##0.00\", \"$#,##0\", \"0.0%\", \"yyyy-mm-dd\"",
      "type": "string"
     },
     "type": {
      "enum": [
       "TEXT",
       "NUMBER",
       "PERCENT",
       "CURRENCY",
       "DATE",
       "TIME",
       "DATE_TIME",
       "SCIENTIFIC"
      ],
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   },
   "range": {
    "description": "A1 range, e.g. \"Sheet1!A1:D20\", \"'My Tab'!B:B\", or a tab name",
    "type": "string"
   },
   "spreadsheet": {
    "description": "Google Sheets link or spreadsheet ID. The name of a spreadsheet used with Sheets MCP before also works",
    "type": "string"
   },
   "strikethrough": {
    "type": "boolean"
   },
   "text_color": {
    "description": "Hex, e.g. #1a73e8",
    "type": "string"
   },
   "underline": {
    "type": "boolean"
   },
   "vertical_alignment": {
    "enum": [
     "TOP",
     "MIDDLE",
     "BOTTOM"
    ],
    "type": "string"
   },
   "wrap": {
    "enum": [
     "OVERFLOW_CELL",
     "CLIP",
     "WRAP"
    ],
    "type": "string"
   }
  },
  "required": [
   "spreadsheet",
   "range"
  ],
  "type": "object"
 },
 "name": "format_range",
 "title": "Format cells"
}
