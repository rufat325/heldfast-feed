     },
     "content_type": {
      "type": [
       "string",
       "null"
      ]
     },
     "expires_in": {
      "enum": [
       900
      ],
      "type": "integer"
     },
     "filename": {
      "type": "string"
     },
     "size_bytes": {
      "minimum": 0,
