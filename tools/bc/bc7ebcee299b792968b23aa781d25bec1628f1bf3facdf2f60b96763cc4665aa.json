{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use this before manually submitting a Commerce Gate SaaS offer in Microsoft Partner Center or AWS Marketplace. It requires a bounded offer, plan and market packet, public HTTPS listing and technical URLs, platform identity, preview or test confirmation, and digest-bound release evidence. Microsoft packets require Microsoft Entra tenant and application IDs; AWS packets require a Login with Amazon subject bound to the seller AWS account and IAM role. This is a non-writing preflight: it evaluates release metadata and preview or test evidence without reading customer commerce records, calling either marketplace, uploading an artifact, creating or changing an offer, or submitting the offer for review. PROCEED is policy evidence, not authority or consent to submit.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "policy_version": {
    "description": "Optional exact Decionis policy version. Omit to use the tenant default.",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[a-z0-9][\\w.:/-]{0,119}$",
    "type": "string"
   },
   "submission": {
    "additionalProperties": false,
    "description": "A bounded, digest-backed packet for manual Microsoft Partner Center or AWS Marketplace SaaS offer submission. This non-writing preflight uses release metadata and preview or test evidence; it does not read customer commerce records or send a marketplace write.",
    "properties": {
     "actor": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "description": "A stable, non-secret actor identifier.",
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "type": {
        "description": "The class of human or system proposing the commerce action.",
        "enum": [
         "HUMAN",
         "ERP",
         "REPRICER",
         "WORKFLOW",
         "AGENT",
         "UNKNOWN"
        ],
        "type": "string"
       }
      },
      "required": [
       "type",
       "id"
      ],
      "type": "object"
     },
     "business_central_extension": {
      "additionalProperties": false,
      "properties": {
       "app_id": {
        "format": "uuid",
        "type": "string"
       },
       "version": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "app_id",
       "version"
      ],
      "type": "object"
     },
     "connection_webhook_url": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     },
     "idempotency_key": {
      "maxLength": 180,
      "minLength": 1,
      "pattern": "^[a-z0-9][\\w.:/-]{0,179}$",
      "type": "string"
     },
     "landing_page_url": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     },
     "marketplace": {
      "enum": [
       "MICROSOFT_PARTNER_CENTER",
       "AWS_MARKETPLACE"
      ],
      "type": "string"
     },
     "marketplace_identity": {
      "oneOf": [
       {
        "additionalProperties": false,
        "properties": {
         "application_id": {
          "format": "uuid",
          "type": "string"
         },
         "provider": {
          "const": "MICROSOFT_ENTRA",
          "type": "string"
         },
         "tenant_id": {
          "format": "uuid",
          "type": "string"
         }
        },
        "required": [
         "provider",
         "tenant_id",
         "application_id"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "aws_account_id": {
          "pattern": "^[0-9]{12}$",
          "type": "string"
         },
         "aws_iam_role_arn": {
          "maxLength": 512,
          "pattern": "^arn:aws(?:-[a-z-]+)?:iam::[0-9]{12}:role/.+",
          "type": "string"
         },
         "provider": {
          "const": "LOGIN_WITH_AMAZON",
          "type": "string"
         },
         "seller_offer_access_verified": {
          "const": true,
          "type": "boolean"
         },
         "subject": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "provider",
         "subject",
         "aws_account_id",
         "aws_iam_role_arn",
         "seller_offer_access_verified"
        ],
        "type": "object"
       }
      ]
     },
     "offer_id": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "offer_name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "offer_type": {
      "const": "SAAS",
      "type": "string"
     },
     "plans": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "billing_term": {
         "enum": [
          "MONTHLY",
          "ANNUAL",
          "ONE_TIME"
         ],
         "type": "string"
        },
        "display_name": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "markets": {
         "items": {
          "pattern": "^[A-Z]{2}$",
          "type": "string"
         },
         "maxItems": 150,
         "minItems": 1,
         "type": "array"
        },
        "plan_id": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "plan_id",
        "display_name",
        "billing_term",
        "markets"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "privacy_policy_url": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     },
     "publisher_id": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "release_evidence": {
      "additionalProperties": false,
      "properties": {
       "marketplace_draft_status": {
        "const": "READY_TO_PUBLISH",
        "type": "string"
       },
       "marketplace_identity_verified": {
        "const": true,
        "type": "boolean"
       },
       "offer_listing_verified": {
        "const": true,
        "type": "boolean"
       },
       "preview_or_test_verified": {
        "const": true,
        "type": "boolean"
       },
       "release_evidence_sha256": {
        "pattern": "^sha256:[a-f0-9]{64}$",
        "type": "string"
       },
       "submission_payload_sha256": {
        "pattern": "^sha256:[a-f0-9]{64}$",
        "type": "string"
       },
       "technical_configuration_verified": {
        "const": true,
        "type": "boolean"
       }
      },
      "required": [
       "marketplace_draft_status",
       "offer_listing_verified",
       "technical_configuration_verified",
       "preview_or_test_verified",
       "marketplace_identity_verified",
       "submission_payload_sha256",
       "release_evidence_sha256"
      ],
      "type": "object"
     },
     "support_url": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     },
     "terms_of_use_url": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     }
    },
    "required": [
     "actor",
     "marketplace",
     "publisher_id",
     "offer_id",
     "offer_name",
     "offer_type",
     "idempotency_key",
     "plans",
     "landing_page_url",
     "connection_webhook_url",
     "support_url",
     "privacy_policy_url",
     "terms_of_use_url",
     "marketplace_identity",
     "release_evidence"
    ],
    "title": "Marketplace SaaS offer submission preflight",
    "type": "object"
   }
  },
  "required": [
   "submission"
  ],
  "type": "object"
 },
 "name": "commercegate_evaluate_marketplace_offer_submission",
 "title": "Preflight a Marketplace SaaS Offer Submission"
}
