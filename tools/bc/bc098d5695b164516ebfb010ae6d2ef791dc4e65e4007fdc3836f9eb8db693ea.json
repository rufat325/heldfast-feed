{
 "description": "Apply knobs to a loaded project. Every dial has \u00d71 (or 0) = as in their code; colours are #rrggbb. Returns what moved (count and a sample of value \u2192 value).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "type": "string"
   },
   "knobs": {
    "properties": {
     "borderTone": {
      "maximum": 0.15,
      "minimum": -0.15,
      "type": "number"
     },
     "borderWidth": {
      "maximum": 3,
      "minimum": 0,
      "type": "number"
     },
     "cAccent": {
      "type": "string"
     },
     "cBackground": {
      "description": "Page background, #rrggbb",
      "pattern": "^#[0-9a-f]{6}$",
      "type": "string"
     },
     "cDanger": {
      "type": "string"
     },
     "cInfo": {
      "type": "string"
     },
     "cPrimary": {
      "description": "Brand colour, #rrggbb",
      "pattern": "^#[0-9a-f]{6}$",
      "type": "string"
     },
     "cSecondary": {
      "type": "string"
     },
     "cSuccess": {
      "type": "string"
     },
     "cWarning": {
      "type": "string"
     },
     "contrast": {
      "maximum": 0.3,
      "minimum": -0.3,
      "type": "number"
     },
     "dark": {
      "description": "Switch their dark mode; omit for 'as is'",
      "enum": [
       "dark",
       "light"
      ],
      "type": "string"
     },
     "fontBody": {
      "type": "string"
     },
     "fontDisplay": {
      "type": "string"
     },
     "gradAngle": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "hue": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "lineHeight": {
      "maximum": 1.35,
      "minimum": 0.85,
      "type": "number"
     },
     "motion": {
      "maximum": 2.5,
      "minimum": 0,
      "type": "number"
     },
     "radius": {
      "description": "\u00d7 their radii, 1 = as is",
      "maximum": 2,
      "minimum": 0,
      "type": "number"
     },
     "reset": {
      "description": "Back to their code first, then apply the rest",
      "type": "boolean"
     },
     "sat": {
      "maximum": 2,
      "minimum": 0,
      "type": "number"
     },
     "shadow": {
      "maximum": 2.5,
      "minimum": 0,
      "type": "number"
     },
     "space": {
      "maximum": 1.5,
      "minimum": 0.6,
      "type": "number"
     },
     "tracking": {
      "description": "+em letter-spacing",
      "maximum": 0.15,
      "minimum": -0.05,
      "type": "number"
     },
     "type": {
      "maximum": 1.4,
      "minimum": 0.8,
      "type": "number"
     },
     "weight": {
      "description": "\u00b1 steps of 100",
      "maximum": 2,
      "minimum": -2,
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "id",
   "knobs"
  ],
  "type": "object"
 },
 "name": "set",
 "title": "Turn the knobs"
}
