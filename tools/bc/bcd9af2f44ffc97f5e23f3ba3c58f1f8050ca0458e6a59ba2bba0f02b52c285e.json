{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "One Model Tracker row plus its applied changelog.",
 "inputSchema": {
  "properties": {
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_model",
 "outputSchema": {
  "properties": {
   "attribution": {
    "type": "string"
   },
   "data": {
    "properties": {
     "benchmarks": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "category": {
      "enum": [
       "llm",
       "image",
       "audio",
       "video",
       "embedding",
       "other"
      ],
      "type": "string"
     },
     "contextWindow": {
      "type": [
       "integer",
       "null"
      ]
     },
     "lab": {
      "type": "string"
     },
     "license": {
      "type": [
       "string",
       "null"
      ]
     },
     "name": {
      "type": "string"
     },
     "openWeights": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "priceBasis": {
      "type": [
       "string",
       "null"
      ]
     },
     "pricePerMillionTokensUsd": {
      "description": "USD per 1M text tokens; null values when the model has no text-token price on record",
      "type": "object"
     },
     "releaseDate": {
      "type": [
       "string",
       "null"
      ]
     },
     "slug": {
      "type": "string"
     },
     "sources": {
      "description": "per-field {url, asOf}",
      "type": "object"
     },
     "url": {
      "type": "string"
     },
     "variants": {
      "description": "preview and dated snapshot slugs shown under this row",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "slug",
     "name",
     "lab",
     "sources",
     "url"
    ],
    "type": "object"
   },
   "license": {
    "type": "object"
   }
  },
  "required": [
   "attribution",
   "data"
  ],
  "type": "object"
 },
 "title": "Model by slug"
}
