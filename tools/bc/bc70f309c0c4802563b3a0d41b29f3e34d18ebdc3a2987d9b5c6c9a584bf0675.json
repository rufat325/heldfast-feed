     "relations": {
      "description": "Present when RELATIONS is requested in details. Each identifier is the canonical selector for the current state and must be copied into updateRelation or deleteRelation. Refetch after renaming an entity or changing an owning field.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "fromEntity": {
         "description": "Entity on the from side of the cardinality",
         "maxLength": 255,
         "pattern": "[a-zA-Z]+[a-zA-Z0-9]*(-[a-zA-Z0-9]+)*",
         "type": "string"
        },
        "fromField": {
         "description": "Field generated on fromEntity. Required unless an unidirectional ONE_TO_MANY relation omits this reverse field",
         "maxLength": 255,
         "pattern": "[a-zA-Z]+[a-zA-Z0-9]*(-[a-zA-Z0-9]+)*",
         "type": [
          "string",
          "null"
         ]
        },
        "identifier": {
         "description": "Canonical relation selector. It is OwningEntity.owningField: fromEntity.fromField for MANY_TO_ONE, ONE_TO_ONE and MANY_TO_MANY, but toEntity.toField for ONE_TO_MANY. Copy this value into updateRelation or deleteRelation.",
         "maxLength": 511,
         "pattern": "[a-zA-Z]+[a-zA-Z0-9]*(-[a-zA-Z0-9]+)*\\.[a-zA-Z]+[a-zA-Z0-9]*(-[a-zA-Z0-9]+)*",
         "type": "string"
        },
        "required": {
         "description": "Whether the owning foreign key is required. Not applicable to MANY_TO_MANY or self-relations",
         "type": "boolean"
        },
        "tableName": {
         "description": "Join-table name; required only for MANY_TO_MANY",
         "maxLength": 255,
         "pattern": "[a-zA-Z]+[a-zA-Z0-9]*(-[a-zA-Z0-9]+)*",
         "type": [
          "string",
          "null"
         ]
        },
        "toEntity": {
         "description": "Entity on the to side of the cardinality",
         "maxLength": 255,
         "pattern": "[a-zA-Z]+[a-zA-Z0-9]*(-[a-zA-Z0-9]+)*",
         "type": "string"
        },
        "toField": {
         "description": "Field generated on toEntity. Required for ONE_TO_MANY and bidirectional relations; also required for self-referencing MANY_TO_MANY relations",
         "maxLength": 255,
         "pattern": "[a-zA-Z]+[a-zA-Z0-9]*(-[a-zA-Z0-9]+)*",
         "type": [
          "string",
          "null"
         ]
        },
        "type": {
         "description": "Cardinality from fromEntity to toEntity",
         "enum": [
          "MANY_TO_ONE",
          "ONE_TO_MANY",
          "ONE_TO_ONE",
          "MANY_TO_MANY"
         ],
         "type": "string"
        },
        "unidirectional": {
         "description": "Omit the reverse field. Relations across application modules must be unidirectional",
         "type": "boolean"
        }
       },
       "required": [
        "identifier",
        "type",
        "fromEntity",
        "toEntity",
        "required",
        "unidirectional"
       ],
       "type": "object"
      },
      "type": "array"
