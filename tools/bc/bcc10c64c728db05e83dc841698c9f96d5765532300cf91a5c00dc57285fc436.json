{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Change an invoice's status in FreeAgent: mark_as_sent (issue it), mark_as_draft (pull it back), mark_as_scheduled, or mark_as_cancelled. These change status only \u2014 no email is sent to the client.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "invoiceId": {
    "description": "FreeAgent invoice ID",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "transition": {
    "description": "The status change to apply",
    "enum": [
     "mark_as_sent",
     "mark_as_draft",
     "mark_as_scheduled",
     "mark_as_cancelled"
    ],
    "type": "string"
   }
  },
  "required": [
   "invoiceId",
   "transition"
  ],
  "type": "object"
 },
 "name": "freeagent_update_invoice_status"
}
