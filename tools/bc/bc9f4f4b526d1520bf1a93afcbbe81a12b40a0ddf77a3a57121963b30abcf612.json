{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add or update a DNS record in a zone (pdns/add_dns). Requires pdns/edit permission. For SRV records, fill in proto/priority/weight/port/target. Fields mname/rname are marked required for SOA checks in the docs \u2014 fill them in on error.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "description": "Must be true to run the operation.",
    "type": "boolean"
   },
   "content": {
    "description": "Record value, e.g. 10.56.121.5",
    "type": "string"
   },
   "increase_soa_serial": {
    "description": "Auto-increment SOA serial (defaults to true)",
    "type": "boolean"
   },
   "mname": {
    "description": "Primary NS in the SOA record",
    "type": "string"
   },
   "name": {
    "description": "Record name, e.g. www",
    "type": "string"
   },
   "old_name": {
    "description": "Previous record name \u2014 for renaming",
    "type": "string"
   },
   "port": {
    "description": "Port for SRV",
    "type": "integer"
   },
   "priority": {
    "description": "Priority for SRV/MX",
    "type": "integer"
   },
   "proto": {
    "description": "Protocol for SRV, e.g. tcp",
    "type": "string"
   },
   "rname": {
    "description": "Admin email in the SOA record",
    "type": "string"
   },
   "target": {
    "description": "Target domain for SRV",
    "type": "string"
   },
   "ttl": {
    "description": "TTL in seconds, defaults to 3600",
    "type": "integer"
   },
   "type": {
    "description": "Record type: A, AAAA, CNAME, MX, TXT, SRV\u2026",
    "type": "string"
   },
   "weight": {
    "description": "Weight for SRV",
    "type": "integer"
   },
   "zone": {
    "description": "Zone name",
    "type": "string"
   }
  },
  "required": [
   "zone",
   "type",
   "content",
   "confirm"
  ],
  "type": "object"
 },
 "name": "add_dns_record"
}
