{
 "description": "Sell (close/reduce) a prediction market position. Subject to your rules.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Number of contracts to sell",
    "type": "string"
   },
   "market_ticker": {
    "description": "Market ticker (e.g. KXBTC-100K)",
    "type": "string"
   },
   "outcome": {
    "description": "Outcome tokens to sell: YES or NO",
    "type": "string"
   },
   "reason": {
    "description": "Reason for selling (optional)",
    "type": "string"
   }
  },
  "required": [
   "market_ticker",
   "outcome",
   "amount"
  ],
  "type": "object"
 },
 "name": "sell_prediction"
}
