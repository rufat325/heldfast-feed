{
 "description": "Get a single custom object schema by its key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "schemaKey": {
    "description": "Unique key identifying the custom object schema",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "schemaKey"
  ],
  "type": "object"
 },
 "name": "crm_get_object_schema"
}
