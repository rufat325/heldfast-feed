{
 "description": "Generate forms to change a Gibraltar company registered office address. Returns a ZIP with FREG01 form, board resolution, and guide. Optionally includes FDMS02 for director service address update.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "building": {
    "description": "New office building/number",
    "type": "string"
   },
   "companyName": {
    "description": "Full registered company name",
    "type": "string"
   },
   "companyNumber": {
    "description": "Gibraltar company registration number",
    "type": "string"
   },
   "currentBuilding": {
    "description": "Current office building/number",
    "type": "string"
   },
   "currentStreet": {
    "description": "Current office street",
    "type": "string"
   },
   "dateOfChange": {
    "description": "Date of change in YYYY-MM-DD format",
    "type": "string"
   },
   "directorDOB": {
    "description": "Director date of birth in YYYY-MM-DD format",
    "type": "string"
   },
   "directorName": {
    "description": "Director name if also updating service address",
    "type": "string"
   },
   "directorTitle": {
    "description": "Director title (Mr, Mrs, etc.)",
    "type": "string"
   },
   "signatoryName": {
    "description": "Name of person signing the forms",
    "type": "string"
   },
   "signatoryPosition": {
    "description": "Position of signatory (e.g. \"Director\")",
    "type": "string"
   },
   "street": {
    "description": "New office street",
    "type": "string"
   }
  },
  "required": [
   "companyNumber",
   "companyName",
   "building",
   "street",
   "signatoryName",
   "signatoryPosition"
  ],
  "type": "object"
 },
 "name": "registered_office_change"
}
