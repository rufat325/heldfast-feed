  "additionalProperties": false,
  "properties": {
   "bucketName": {
    "description": "Name of the bucket",
    "type": "string"
   },
   "contentType": {
    "description": "Content-Type for the object",
    "type": "string"
   },
   "key": {
    "description": "Object key (path) for the multipart upload",
    "type": "string"
   }
  },
  "required": [
