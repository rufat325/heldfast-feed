{
 "description": "Create a new person contact in Karbon.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "BusinessCards": {
    "items": {
     "additionalProperties": false,
     "description": "Contact details (email, phone, address)",
     "properties": {
      "Addresses": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "AddressLines": {
          "type": "string"
         },
         "City": {
          "type": "string"
         },
         "CountryCode": {
          "type": "string"
         },
         "Label": {
          "type": "string"
         },
         "StateProvinceCounty": {
          "type": "string"
         },
         "ZipCode": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "EmailAddresses": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "IsPrimaryCard": {
       "type": "boolean"
      },
      "OrganizationKey": {
       "description": "Link this card to an organization the person works at",
       "type": "string"
      },
      "PhoneNumbers": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "Label": {
          "type": "string"
         },
         "Number": {
          "type": "string"
         }
        },
        "required": [
         "Number"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "RoleOrTitle": {
       "type": "string"
      },
      "WebSites": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "ClientManager": {
    "type": "string"
   },
   "ClientOwner": {
    "description": "Email address of the Karbon user who owns this client",
    "type": "string"
   },
   "ContactType": {
    "description": "Contact type label, e.g. 'Client', 'Prospect'. Valid values come from get_tenant_settings.",
    "type": "string"
   },
   "FirstName": {
    "type": "string"
   },
   "LastName": {
    "type": "string"
   },
   "MiddleName": {
    "type": "string"
   },
   "PreferredName": {
    "type": "string"
   },
   "RestrictionLevel": {
    "enum": [
     "Public",
     "Private",
     "Hidden"
    ],
    "type": "string"
   },
   "Salutation": {
    "type": "string"
   },
   "UserDefinedIdentifier": {
    "description": "Your own external ID for this contact",
    "type": "string"
   }
  },
  "required": [
   "FirstName",
   "LastName"
  ],
  "type": "object"
 },
 "name": "create_contact",
 "title": "Create contact"
}
