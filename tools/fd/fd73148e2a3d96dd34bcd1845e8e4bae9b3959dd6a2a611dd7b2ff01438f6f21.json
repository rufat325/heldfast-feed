{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Checks Copybook text already in a repo by the IDs in its From Copybook source lines: <slug>#<8 hex> (the slug of the source URL with each block or unit ID), up to 100, IDs only (no paths or file contents). Each ID is current (the tip still has that text; local edits are not checked) or changed (the tip no longer has it). Also reports each tip as live, superseded (with its replacement) or retired (its latest check broke), with checks and durability. Without IDs, get_tip returns the current text to compare. Needs a Copybook sign-in; without one, the result's message says how to sign in from this client.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"ids":{"description":"The IDs from the source lines above Copybook text in the repo, up to 100, each <slug>#<8 hex>: the slug from the line's URL, then each block or units ID. Never file contents or paths.","items":{"maxLength":140,"pattern":"^([a-z0-9]+(?:-[a-z0-9]+)*)#([0-9a-f]{8})(?:-[1-9]\\d{0,2})?$","type":"string"},"maxItems":100,"minItems":1,"type":"array"}},"required":["ids"],"type":"object"},"name":"check_installed","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"message":{"type":["string","null"]},"tips":{"items":{"properties":{"blocks":{"items":{"properties":{"block":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"chars":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"id":{"type":"string"},"label":{"type":"string"},"language":{"type":"string"},"mark":{"type":"string"},"units":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["block","label","language","id","mark","units","chars"],"type":"object"},"type":"array"},"check":{"enum":["checked","broken","no check on record"],"type":"string"},"checked_model":{"type":"string"},"checked_on":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"durability":{"enum":["model-bound","tool-bound","durable"],"type":"string"},"ids":{"items":{"properties":{"block":{"anyOf":[{"maximum":9007199254740991,"minimum":0,"type":"integer"},{"type":"null"}]},"id":{"type":"string"},"label":{"type":["string","null"]},"state":{"enum":["current","changed"],"type":"string"}},"required":["id","state","block","label"],"type":"object"},"type":"array"},"newer_models":{"items":{"type":"string"},"type":"array"},"slug":{"type":"string"},"state":{"enum":["live","superseded","retired"],"type":"string"},"superseded_by":{"anyOf":[{"properties":{"slug":{"type":"string"},"title":{"type":"string"},"url":{"format":"uri","type":"string"}},"required":["slug","title","url"],"type":"object"},{"type":"null"}]},"title":{"type":"string"},"url":{"format":"uri","type":"string"}},"required":["slug","title","url","state","superseded_by","check","durability","ids","blocks"],"type":"object"},"type":"array"},"unknown":{"items":{"type":"string"},"type":"array"}},"required":["tips","unknown","message"],"type":"object"},"title":"Check installed Copybook text"}
