  "readOnlyHint": true
 },
 "description": "Search and list public AI company fundraising rounds. Filter by company name, round type, announcement date, or participating investor slug, and sort by announcement date.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "investor": {
    "description": "Optional verified active investor slug returned by search_investors.",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "order": {
    "default": "desc",
    "description": "Sort direction. Use desc for the latest fundraises first.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "query": {
    "description": "Optional company name or round type. Omit it, pass an empty string, or pass \"*\" to search all public fundraising rounds.",
    "type": "string"
   },
   "round_type": {
    "description": "Exact fundraising round type to include, such as Seed or Series A.",
    "enum": [
     "Pre-Seed",
     "Seed",
     "Series A",
     "Series B",
     "Series C",
     "Series D",
     "Series E",
     "Series E+",
     "Series F",
     "Series G",
     "Bridge",
     "Convertible Note",
     "SAFE",
     "Pre-IPO",
     "IPO",
     "Debt Financing",
     "Growth Round"
    ],
    "type": "string"
   },
   "since": {
    "description": "Include rounds announced on or after this date (YYYY-MM-DD).",
    "format": "date",
    "type": "string"
   },
   "sort": {
    "default": "announced_date",
    "description": "Field used to sort results.",
    "enum": [
     "announced_date"
    ],
    "type": "string"
   },
   "until": {
    "description": "Include rounds announced on or before this date (YYYY-MM-DD).",
    "format": "date",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "search_fundraises",
 "outputSchema": {
  "additionalProperties": false,
