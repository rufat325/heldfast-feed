       ]
      },
      "entity_type": {
       "type": "string"
      },
      "id": {
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "round_type": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "entity_type",
      "name",
      "slug",
      "url",
      "announced_date",
