{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search prediction markets"
 },
 "description": "Find events and their markets with live odds. Filter by free-text query, category slug (see predict://categories), sort and status. Each event lists markets with outcomes, token ids, best bid/ask, tick size and a human URL.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Category slug, e.g. politics, crypto, sports, new, breaking, ending",
    "type": "string"
   },
   "limit": {
    "description": "Events to return (1-50, default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "maxMarkets": {
    "description": "Markets per event (1-50, default 5)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "integer"
   },
   "q": {
    "description": "Free-text search, e.g. 'fed rate october' or 'bitcoin 150k'",
    "maxLength": 120,
    "type": "string"
   },
   "sort": {
    "description": "Sort order",
    "enum": [
     "volume24h",
     "volume",
     "liquidity",
     "newest",
     "ending",
     "competitive"
    ],
    "type": "string"
   },
   "status": {
    "description": "active (default), resolved or all",
    "enum": [
     "active",
     "resolved",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "search_markets",
 "title": "Search prediction markets"
}
