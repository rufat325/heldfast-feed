{
 "description": "Create a multi-party approval request for charter amendments, office transfers, etc.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "policy_id": {
    "type": "string"
   },
   "requested_by": {
    "type": "string"
   },
   "subject": {
    "description": "What is being approved (e.g. amendment ID)",
    "type": "string"
   },
   "subject_type": {
    "enum": [
     "charter_amendment",
     "delegation",
     "office_transfer",
     "dissolution",
     "escrow_release",
     "dispute_resolution"
    ],
    "type": "string"
   },
   "timeout_seconds": {
    "default": 86400,
    "type": "number"
   }
  },
  "required": [
   "policy_id",
   "subject",
   "subject_type",
   "requested_by"
  ],
  "type": "object"
 },
 "name": "create_approval_request"
}
