{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch the full deposited DataCite metadata for one DOI: titles, creators and contributors with ORCID iDs and ROR affiliations, publisher, dates, version, subjects, descriptions, funding, geolocations, rights, sizes and formats, related identifiers with their relation types, repository and provider, and citation, reference, version, part, view, and download counts. Long lists are capped with their full counts reported; use datacite_trace_relations for the complete relation graph. A DOI DataCite does not hold returns found: false naming the registration agency that does, or saying the DOI does not exist.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "doi": {
    "description": "The DOI, e.g. 10.5061/dryad.234: 10., a 4\u20139 digit registrant, a slash, and a suffix. Accepted bare, with doi: or info:doi/ prefixes, as a doi.org / dx.doi.org URL, or %2F-encoded; case-insensitive.",
    "maxLength": 500,
    "pattern": "^\\s*(?:[Hh][Tt][Tt][Pp][Ss]?:\\/\\/(?:[Dd][Xx]\\.)?[Dd][Oo][Ii]\\.[Oo][Rr][Gg]\\/)?(?:[Dd][Oo][Ii]:\\s*|[Ii][Nn][Ff][Oo]:[Dd][Oo][Ii]\\/)?10\\.\\S+\\s*$",
    "type": "string"
   }
  },
  "required": [
   "doi"
  ],
  "type": "object"
 },
 "name": "datacite_get_work",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "found",
     "doi"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "alternateIdentifiers": {
    "description": "Alternate identifiers. Found arm only.",
    "items": {
     "additionalProperties": false,
     "description": "One alternate identifier.",
     "properties": {
      "identifier": {
       "description": "The identifier.",
       "type": "string"
      },
      "identifierType": {
       "description": "Its type, e.g. URL or Local accession number.",
       "type": "string"
      }
     },
     "required": [
      "identifier",
      "identifierType"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "contentUrls": {
    "description": "Direct content URLs, when deposited. Found arm only.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "contributors": {
    "description": "Contributors, capped at 100 (full count in truncatedLists). Found arm only.",
    "items": {
     "additionalProperties": false,
     "description": "A creator or contributor.",
     "properties": {
      "affiliations": {
       "description": "Affiliations.",
       "items": {
        "additionalProperties": false,
        "description": "One affiliation.",
        "properties": {
         "name": {
          "description": "Affiliation name.",
          "type": "string"
         },
         "rorId": {
          "description": "ROR ID (bare), when deposited.",
          "type": "string"
         }
        },
        "required": [
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "contributorType": {
       "description": "Contributor role (contributors only), e.g. DataCurator; see datacite_list_reference topic contributor_types.",
       "type": "string"
      },
      "familyName": {
       "description": "Family name, when deposited.",
       "type": "string"
      },
      "givenName": {
       "description": "Given name, when deposited.",
       "type": "string"
      },
      "name": {
       "description": "Name as deposited, usually \"Family, Given\" for a person.",
       "type": "string"
      },
      "nameType": {
       "description": "Personal or Organizational, when deposited.",
       "type": "string"
      },
      "orcid": {
       "description": "ORCID iD in 0000-0000-0000-0000 form, when deposited and valid.",
       "type": "string"
      },
      "otherIdentifiers": {
       "description": "Other name identifiers.",
       "items": {
        "additionalProperties": false,
        "description": "A non-ORCID name identifier.",
        "properties": {
         "identifier": {
          "description": "The identifier as deposited.",
          "type": "string"
         },
         "scheme": {
          "description": "Identifier scheme, e.g. ISNI or ROR.",
          "type": "string"
         }
        },
        "required": [
         "identifier"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "otherIdentifiers",
      "affiliations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "counts": {
    "additionalProperties": false,
    "description": "DataCite's own counts; they can trail the live record by a few events. Found arm only.",
    "properties": {
     "citationCount": {
      "description": "Citations DataCite records for this DOI.",
      "type": "number"
     },
     "downloadCount": {
      "description": "Downloads reported by the repository.",
      "type": "number"
     },
     "partCount": {
      "description": "Parts of this DOI.",
      "type": "number"
     },
     "partOfCount": {
      "description": "DOIs this is part of.",
      "type": "number"
     },
     "referenceCount": {
      "description": "References this DOI makes.",
      "type": "number"
     },
     "versionCount": {
      "description": "Versions of this DOI.",
      "type": "number"
     },
     "versionOfCount": {
      "description": "DOIs this is a version of.",
      "type": "number"
     },
     "viewCount": {
      "description": "Views reported by the repository.",
      "type": "number"
     }
    },
    "required": [
     "citationCount",
     "referenceCount",
     "versionCount",
     "versionOfCount",
     "partCount",
     "partOfCount",
     "viewCount",
     "downloadCount"
    ],
    "type": "object"
   },
   "created": {
    "description": "When the record was created. Found arm only.",
    "type": "string"
   },
   "creators": {
    "description": "Creators, capped at 100 (full count in truncatedLists). Found arm only.",
    "items": {
     "additionalProperties": false,
     "description": "A creator or contributor.",
     "properties": {
      "affiliations": {
       "description": "Affiliations.",
       "items": {
        "additionalProperties": false,
        "description": "One affiliation.",
        "properties": {
         "name": {
          "description": "Affiliation name.",
          "type": "string"
         },
         "rorId": {
          "description": "ROR ID (bare), when deposited.",
          "type": "string"
         }
        },
        "required": [
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "contributorType": {
       "description": "Contributor role (contributors only), e.g. DataCurator; see datacite_list_reference topic contributor_types.",
       "type": "string"
      },
      "familyName": {
       "description": "Family name, when deposited.",
       "type": "string"
      },
      "givenName": {
       "description": "Given name, when deposited.",
       "type": "string"
      },
      "name": {
       "description": "Name as deposited, usually \"Family, Given\" for a person.",
       "type": "string"
      },
      "nameType": {
       "description": "Personal or Organizational, when deposited.",
       "type": "string"
      },
      "orcid": {
       "description": "ORCID iD in 0000-0000-0000-0000 form, when deposited and valid.",
       "type": "string"
      },
      "otherIdentifiers": {
       "description": "Other name identifiers.",
       "items": {
        "additionalProperties": false,
        "description": "A non-ORCID name identifier.",
        "properties": {
         "identifier": {
          "description": "The identifier as deposited.",
          "type": "string"
         },
         "scheme": {
          "description": "Identifier scheme, e.g. ISNI or ROR.",
          "type": "string"
         }
        },
        "required": [
         "identifier"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "otherIdentifiers",
      "affiliations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dates": {
    "description": "Dates. Found arm only.",
    "items": {
     "additionalProperties": false,
     "description": "One date.",
     "properties": {
      "date": {
       "description": "Date or date range as deposited.",
       "type": "string"
      },
      "dateInformation": {
       "description": "Free-text note on the date.",
       "type": "string"
      },
      "dateType": {
       "description": "Issued, Created, Available, Collected, and so on; see datacite_list_reference topic date_types.",
       "type": "string"
      }
     },
     "required": [
      "date",
      "dateType"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "descriptions": {
    "description": "Descriptions. Found arm only.",
    "items": {
     "additionalProperties": false,
     "description": "One description.",
     "properties": {
      "description": {
       "description": "Description text as deposited.",
       "type": "string"
      },
      "descriptionType": {
       "description": "Abstract, Methods, TechnicalInfo, and so on.",
       "type": "string"
      },
      "lang": {
       "description": "Language of the description.",
       "type": "string"
      }
     },
     "required": [
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "doi": {
    "description": "The DOI, normalized to lowercase bare form.",
    "type": "string"
   },
   "doiUrl": {
    "description": "Resolver URL, https://doi.org/<doi>, with #, ?, and % percent-encoded. Found arm only.",
    "type": "string"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `invalid_doi`: The doi input is not a DOI after normalization. `rate_limited`: This deployment's shared DataCite request budget is spent: its request queue could not start a request before the call's deadline, or DataCite answered HTTP 429. Other values are possible when a failure originates below the handler.",
        "examples": [
         "invalid_doi",
         "rate_limited"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "formats": {
    "description": "Formats as deposited. Found arm only.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "found": {
    "description": "True when DataCite holds a public record for the DOI.",
    "type": "boolean"
   },
   "fundingReferences": {
    "description": "Funding, capped at 100 (full count in truncatedLists). Found arm only.",
    "items": {
     "additionalProperties": false,
     "description": "One funding reference.",
     "properties": {
      "awardNumber": {
       "description": "Award or grant number.",
       "type": "string"
      },
      "awardTitle": {
       "description": "Award title.",
       "type": "string"
      },
      "awardUri": {
       "description": "Award URI.",
       "type": "string"
      },
      "funderIdentifier": {
       "description": "Funder identifier (ROR, Crossref Funder ID, \u2026).",
       "type": "string"
      },
      "funderIdentifierType": {
       "description": "Scheme of funderIdentifier, e.g. ROR or Crossref Funder ID.",
       "type": "string"
      },
      "funderName": {
       "description": "Funder name.",
       "type": "string"
      }
     },
     "required": [
      "funderName"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "geoLocations": {
    "description": "Geolocations, capped at 50 (full count in truncatedLists). Found arm only.",
    "items": {
     "additionalProperties": false,
     "description": "One geolocation.",
     "properties": {
      "box": {
       "additionalProperties": false,
       "description": "Bounding box.",
       "properties": {
        "east": {
         "description": "East bound longitude, decimal degrees.",
         "type": "number"
        },
        "north": {
         "description": "North bound latitude, decimal degrees.",
         "type": "number"
        },
        "south": {
         "description": "South bound latitude, decimal degrees.",
         "type": "number"
        },
        "west": {
         "description": "West bound longitude, decimal degrees.",
         "type": "number"
        }
       },
       "required": [
        "west",
        "east",
        "south",
        "north"
       ],
       "type": "object"
      },
      "place": {
       "description": "Free-text place.",
       "type": "string"
      },
      "point": {
       "additionalProperties": false,
       "description": "Point location.",
       "properties": {
        "latitude": {
         "description": "Latitude, decimal degrees.",
         "type": "number"
        },
        "longitude": {
         "description": "Longitude, decimal degrees.",
         "type": "number"
        }
       },
       "required": [
        "latitude",
        "longitude"
       ],
       "type": "object"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "guidance": {
    "description": "The next step for this miss. Miss arm only.",
    "type": "string"
   },
   "landingUrl": {
    "description": "The repository's landing page. Found arm only.",
    "type": "string"
   },
   "language": {
    "description": "Language as deposited, usually an ISO 639-1 code such as en. Found arm only.",
    "type": "string"
   },
   "metadataLicense": {
