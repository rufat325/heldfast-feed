 "description": "Check whether a video or image is finished and get its URL. Poll this after generate_video or generate_image; pass kind \"image\" for an image job. Reports status, the finished file URL, and the credits charged. SIGN-IN REQUIRED: connect this server with OAuth (the host prompts for it), or add an API key header \"Authorization: Bearer acd_live_\u2026\" created at https://aicontentdrop.com/settings/integrations.",
 "inputSchema": {
  "properties": {
   "id": {
    "description": "The id returned by generate_video or generate_image.",
    "type": "string"
   },
   "kind": {
    "description": "Which job type the id belongs to. Defaults to video.",
    "enum": [
     "video",
     "image"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_generation",
