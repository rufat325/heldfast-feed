{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update any editable field on an existing blog post, including its author.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "authorId": {
    "description": "Updated author user ID from list_blog_members. Reassignment requires owner or admin access.",
    "minLength": 1,
    "type": "string"
   },
   "blogId": {
    "description": "Blog ID. Use list_blogs to discover available blog IDs.",
    "minLength": 1,
    "type": "string"
   },
   "collection_id": {
    "description": "Updated collection ID.",
    "minLength": 1,
    "type": "string"
   },
   "content": {
    "description": "Updated HTML content.",
    "maxLength": 1000000,
    "minLength": 1,
    "type": "string"
   },
   "image": {
    "anyOf": [
     {
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Updated featured image path or URL. Use upload_image for local files."
   },
   "metadata": {
    "description": "Custom metadata entries as key/value objects. Maximum 20 entries; description should be 200 characters or fewer.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "maxLength": 50,
       "minLength": 1,
       "type": "string"
      },
      "value": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "postId": {
    "description": "Post ID.",
    "minLength": 1,
    "type": "string"
   },
   "published_at": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Updated publish datetime in ISO 8601 format."
   },
   "slug": {
    "description": "Updated post slug.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "description": "Updated publishing status.",
    "enum": [
     "draft",
     "published"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Updated tag names.",
    "items": {
     "maxLength": 50,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "title": {
    "description": "Updated post title.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "blogId",
   "postId"
  ],
  "type": "object"
 },
 "name": "update_post",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": {}
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Update post"
}
