  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cik_or_name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "quarter": {
    "pattern": "^\\d{4}-Q[1-4]$",
    "type": "string"
   }
  },
  "required": [
   "cik_or_name"
  ],
  "type": "object"
 },
