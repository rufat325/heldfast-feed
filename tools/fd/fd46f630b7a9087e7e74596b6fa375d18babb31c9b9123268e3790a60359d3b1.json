  "properties": {
   "categories": {
    "description": "e.g. [\"Raw Materials\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "company_name": {
    "minLength": 1,
    "type": "string"
   },
   "email": {
    "format": "email",
    "type": "string"
   },
   "person_of_contact": {
    "minLength": 1,
    "type": "string"
   },
   "phone_no": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "company_name",
   "person_of_contact",
   "phone_no",
   "email"
  ],
  "type": "object"
 },
 "name": "add_supplier",
 "title": "Add supplier"
}
