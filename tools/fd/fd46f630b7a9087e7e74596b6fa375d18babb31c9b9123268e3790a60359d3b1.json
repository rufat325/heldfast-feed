{
 "description": "Add a new supplier to the AuraVMS account. Searches for the email first (supplier emails are unique \u2014 re-adding an existing vendor fails). Returns the supplier UUID to use in create_rfq.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
