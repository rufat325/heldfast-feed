{
 "description": "Execute ONE closed typed step (open_lesson | complete_content) as a REAL DOM click on the hosted worker player, with before/after PNG evidence, post-step ARIA, and a canonical receipt reporting the ACTUAL before/after state revisions and APPLIED/ALREADY_SATISFIED. Never accepts selectors, scripts, or coordinates. Requires lms:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "capture": {
    "enum": [
     "before_after",
     "after",
     "none"
    ],
    "type": "string"
   },
   "expectedStateRevision": {
    "minimum": 1,
    "type": "integer"
   },
   "idempotencyKey": {
    "description": "Stable idempotency key. Reuse only for the identical operation.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "lessonKey": {
    "$ref": "#/properties/sessionId"
   },
   "op": {
    "enum": [
     "open_lesson",
     "complete_content"
    ],
    "type": "string"
   },
   "sessionId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "viewport": {
    "enum": [
     "desktop",
     "mobile"
    ],
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "op",
   "lessonKey",
   "expectedStateRevision",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_step_preview",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
