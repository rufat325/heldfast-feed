{
 "annotations": {
  "readOnlyHint": true,
  "title": "List sales orders"
 },
 "description": "List sales orders, filtered by status, customer, order number, warehouse or date range. Deleted orders are excluded unless asked for. Unleashed: GET /SalesOrders/{page}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "completedAfter": {
    "description": "Orders completed after this date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "completedBefore": {
    "description": "Orders completed before this date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "customOrderStatus": {
    "description": "A custom order status (overrides orderStatus).",
    "type": "string"
   },
   "customerCode": {
    "description": "Only orders whose customer code starts with this.",
    "type": "string"
   },
   "customerId": {
    "description": "Only orders for these customer Guids (comma-separated).",
    "type": "string"
   },
   "endDate": {
    "description": "Orders dated on/before this date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "modifiedSince": {
    "description": "Only records created or modified since this UTC date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "orderNumber": {
    "description": "Only the order with this number (overrides other filters).",
    "type": "string"
   },
   "orderStatus": {
    "description": "Comma-separated statuses, e.g. Parked,Placed,Backordered,Completed.",
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based). Default 1.",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Records per page, 1-1000. Unleashed default is 200.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "serialBatch": {
    "description": "Include serial and batch numbers on lines.",
    "type": "boolean"
   },
   "startDate": {
    "description": "Orders dated on/after this date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "warehouseCode": {
    "description": "Only orders from this warehouse.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "unleashed_list_sales_orders",
 "title": "List sales orders"
}
