{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Closes the Prashna feedback loop using the private confirmation token returned by calculate_prashna. The token is hashed at rest and is distinct from the consultation ID.",
 "inputSchema": {
  "properties": {
   "confirmationToken": {
    "maxLength": 256,
    "minLength": 16,
    "type": "string"
   },
   "notes": {
    "maxLength": 1000,
    "type": "string"
   },
   "outcome": {
    "enum": [
     "confirmed",
     "partly-confirmed",
     "not-confirmed",
     "unresolved"
    ],
    "type": "string"
   },
   "resolvedAt": {
    "format": "date-time",
    "type": "string"
   }
  },
  "required": [
   "confirmationToken",
   "outcome"
  ],
  "type": "object"
 },
 "name": "record_prashna_outcome",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "consultationId": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "recordedAt": {
    "type": "string"
   },
   "status": {
    "const": "recorded",
    "type": "string"
   }
  },
  "required": [
   "id",
   "consultationId",
   "status",
   "recordedAt"
  ],
  "type": "object"
 },
 "title": "Record a Prashna outcome"
}
