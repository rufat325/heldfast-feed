{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get product offers"
 },
 "description": "Get one product's description, highlights, specs and every merchant offer (seller, price, availability, buy link). `id` comes from search_products.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Product id from search_products.",
    "type": "string"
   },
   "ships_to": {
    "description": "ISO 3166-1 alpha-2 country the buyer ships to, e.g. US, DE, JP.",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_product",
 "outputSchema": {
  "properties": {
   "description": {
    "type": "string"
   },
   "disclosure": {
    "type": "string"
   },
   "highlights": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "type": "string"
   },
   "offers": {
    "items": {
     "properties": {
      "available": {
       "type": "boolean"
      },
      "buyUrl": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "price": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "seller": {
       "type": "string"
      },
      "sponsored": {
       "type": "boolean"
      },
      "variant": {
       "type": "string"
      }
     },
     "required": [
      "seller",
      "available"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "specs": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "title",
   "url",
   "offers",
   "disclosure"
  ],
  "type": "object"
 },
 "title": "Get product offers"
}
