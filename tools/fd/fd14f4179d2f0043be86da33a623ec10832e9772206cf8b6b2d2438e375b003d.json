{"description":"Signed-in session only: allow (with a workspaceId) or deny an AI assistant's request to use SAGOT. Allowing gives that assistant the listed scopes in one workspace \u2014 never admin, never more than your role \u2014 and returns redirectTo, the address to send the browser back to.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"allow":{"type":"boolean"},"request":{"properties":{"client_id":{"maxLength":500,"minLength":1,"type":"string"},"code_challenge":{"maxLength":200,"type":"string"},"code_challenge_method":{"maxLength":20,"type":"string"},"redirect_uri":{"maxLength":2000,"minLength":1,"type":"string"},"resource":{"maxLength":500,"type":"string"},"response_type":{"maxLength":40,"type":"string"},"scope":{"maxLength":500,"type":"string"},"state":{"maxLength":2000,"type":"string"}},"required":["response_type","client_id","redirect_uri"],"type":"object"},"workspaceId":{"description":"Workspace the assistant may use; required to allow.","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"}},"required":["request","allow"],"type":"object"},"name":"assistants_authorize"}
