{
 "annotations": {
  "destructiveHint": true,
  "title": "Log a call"
 },
 "description": "Record a phone call made or received outside FUB, with its outcome. Does not place a call. FUB: POST /v1/calls.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "duration": {
    "description": "Seconds.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "fromNumber": {
    "type": "string"
   },
   "isIncoming": {
    "description": "true for an incoming call, false for outgoing.",
    "type": "boolean"
   },
   "note": {
    "description": "Call notes.",
    "type": "string"
   },
   "outcome": {
    "enum": [
     "Interested",
     "Not Interested",
     "Left Message",
     "No Answer",
     "Busy",
     "Bad Number"
    ],
    "type": "string"
   },
   "personId": {
    "description": "The person id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "phone": {
    "description": "The number called or calling.",
    "type": "string"
   },
   "recordingUrl": {
    "type": "string"
   },
   "toNumber": {
    "type": "string"
   },
   "userId": {
    "description": "User who took the call (admins only).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "personId",
   "phone",
   "isIncoming"
  ],
  "type": "object"
 },
 "name": "fub_log_call",
 "title": "Log a call"
}
