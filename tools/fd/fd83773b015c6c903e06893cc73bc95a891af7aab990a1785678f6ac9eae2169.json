{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing product in Holded. Only provided fields will be updated.\n\nArgs:\n  - product_id (string): The product ID to update (required)\n  - name (string): Product name\n  - sku (string): Stock Keeping Unit\n  - price (number): Selling price\n  - And other optional fields to update\n\nReturns:\n  The updated product.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "barcode": {
    "description": "Product barcode",
    "type": "string"
   },
   "cost": {
    "description": "Cost price",
    "minimum": 0,
    "type": "number"
   },
   "desc": {
    "description": "Product description",
    "type": "string"
   },
   "hasStock": {
    "description": "Enable stock control",
    "type": "boolean"
   },
   "kind": {
    "description": "Product kind: simple, variants, lots, or pack",
    "enum": [
     "simple",
     "variants",
     "lots",
     "pack"
    ],
    "type": "string"
   },
   "name": {
    "description": "Product name",
    "minLength": 1,
    "type": "string"
   },
   "packProducts": {
    "description": "Products in the pack",
    "items": {
     "additionalProperties": false,
     "properties": {
      "productId": {
       "description": "Product ID in the pack",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity of this product in the pack",
       "exclusiveMinimum": 0,
       "type": "number"
      }
     },
     "required": [
      "productId",
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "packQuantity": {
    "description": "Pack quantity (for pack products)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "price": {
    "description": "Selling price",
    "minimum": 0,
    "type": "number"
   },
   "product_id": {
    "description": "The product ID to update",
    "minLength": 1,
    "type": "string"
   },
   "purchasePrice": {
    "description": "Purchase/supplier price",
    "minimum": 0,
    "type": "number"
   },
   "sku": {
    "description": "Stock Keeping Unit (SKU)",
    "type": "string"
   },
   "subtotal": {
    "description": "Product subtotal amount",
    "type": "number"
   },
   "tags": {
    "description": "Product tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tax": {
    "description": "Tax rate ID or percentage",
    "type": "string"
   },
   "typeId": {
    "description": "Product type/category",
    "type": "string"
   },
   "variants": {
    "description": "Product variants",
    "items": {
     "additionalProperties": false,
     "properties": {
      "barcode": {
       "description": "Variant barcode",
       "type": "string"
      },
      "cost": {
       "description": "Variant cost price",
       "type": "number"
      },
      "name": {
       "description": "Variant name",
       "type": "string"
      },
      "price": {
       "description": "Variant price",
       "type": "number"
      },
      "sku": {
       "description": "Variant SKU",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "weight": {
    "description": "Product weight",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "product_id"
  ],
  "type": "object"
 },
 "name": "holded_invoicing_update_product",
 "title": "Update Holded Product"
}
