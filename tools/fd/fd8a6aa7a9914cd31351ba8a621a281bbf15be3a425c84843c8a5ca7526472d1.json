  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search California HOA law"
 },
 "description": "Use this when the user asks about California HOA, condominium or common-interest-development law and you need the governing statute sections or court decisions. Searches the Davis-Stirling Act (Civil Code \u00a7\u00a74000\u20136150) and the court decisions interpreting it; returns ranked results, each with a verbatim snippet, citation and link. Do not use it for other states, commercial or industrial CIDs (\u00a7\u00a76500\u20136876), the Corporations Code, local ordinances, or a specific association\u2019s governing documents.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "description": "Limit to statute sections or cases (default all).",
    "enum": [
     "all",
     "statute",
     "case"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Results to return (default 8).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "What to look for, in plain words or a citation.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "topic": {
    "description": "A topic slug from browse_topics, e.g. \"meetings\".",
    "pattern": "^[a-z][a-z-]{2,39}$",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
