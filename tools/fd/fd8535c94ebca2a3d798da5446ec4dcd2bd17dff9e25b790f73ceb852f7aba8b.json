{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Post through a webhook with an optional display name and avatar override. Mentions are suppressed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "avatar_url_override": {
    "format": "uri",
    "type": "string"
   },
   "content": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "embeds": {
    "description": "Up to 10 embeds.",
    "items": {
     "properties": {
      "color": {
       "description": "Hex color like #5865f2.",
       "type": "string"
      },
      "description": {
       "maxLength": 4096,
       "type": "string"
      },
      "title": {
       "maxLength": 256,
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "username_override": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "webhook": {
    "description": "Webhook name or ID.",
    "type": "string"
   }
  },
  "required": [
   "webhook"
  ],
  "type": "object"
 },
 "name": "send_webhook_message",
 "title": "Send webhook message"
}
