{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Parse Cron Expression"
 },
 "description": "Parse a cron expression into a human-readable description and calculate next run times. Supports standard 5-field cron and special strings like @daily, @hourly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expression": {
    "description": "Cron expression (e.g., \"*/5 * * * *\", \"0 9 * * MON-FRI\")",
    "type": "string"
   },
   "num_next": {
    "description": "Number of next run times to return (default: 5, max: 20)",
    "type": "number"
   },
   "timezone": {
    "description": "Timezone for calculations (default: UTC, e.g., \"Europe/Zurich\")",
    "type": "string"
   }
  },
  "required": [
   "expression"
  ],
  "type": "object"
 },
 "name": "parse_cron"
}
