{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Add DB users (ACL) to a Cloud DB for Cache (Redis/Valkey) instance",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudCacheInstanceNo": {
    "description": "Cloud Cache instance number",
    "type": "string"
   },
   "cloudCacheUserList": {
    "description": "List of users to add",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "User name (4~16 chars: letters, numbers, '_', '-')",
       "type": "string"
      },
      "password": {
       "description": "User password (9~20 chars, must include at least one each of letter, number, special char)",
       "type": "string"
      }
     },
     "required": [
      "name",
      "password"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "regionCode": {
    "description": "Region code (KR, KRS)",
    "type": "string"
   }
  },
  "required": [
   "cloudCacheInstanceNo",
   "cloudCacheUserList"
  ],
  "type": "object"
 },
 "name": "ncloud_add_cache_users"
}
