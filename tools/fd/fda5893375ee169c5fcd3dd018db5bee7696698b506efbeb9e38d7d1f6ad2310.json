     "additionalProperties": false,
     "properties": {
      "source_url": {
       "format": "uri",
       "maxLength": 2048,
       "type": "string"
      },
      "statement": {
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "statement",
      "source_url"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "goal": {
