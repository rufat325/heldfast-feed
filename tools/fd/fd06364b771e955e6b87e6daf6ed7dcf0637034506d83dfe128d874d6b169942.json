{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Make tracing practice on handwriting lines, in print or cursive: the alphabet, a run of numbers, the child's own words, or one sentence. Returns a PDF link.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"level":{"description":"How much the sheet guides the child (easy: Pre-K and K, challenge: K and 1st grade, expert: 1st and 2nd grade). Defaults to easy.","enum":["easy","challenge","expert"],"type":"string"},"script":{"description":"print or cursive. Defaults to print.","enum":["print","cursive"],"type":"string"},"sheet":{"description":"What to trace. kind is letters, numbers, words or sentence.","oneOf":[{"properties":{"case":{"description":"upper, lower or both (Aa). Defaults to upper.","enum":["upper","lower","both"],"type":"string"},"kind":{"const":"letters","type":"string"}},"required":["kind"],"type":"object"},{"properties":{"from":{"description":"First number.","maximum":100,"minimum":0,"type":"integer"},"kind":{"const":"numbers","type":"string"},"to":{"description":"Last number. One page per number, up to 30 pages.","maximum":100,"minimum":0,"type":"integer"}},"required":["kind","from","to"],"type":"object"},{"properties":{"kind":{"const":"words","type":"string"},"words":{"anyOf":[{"items":{"maxLength":100,"type":"string"},"maxItems":100,"type":"array"},{"maxLength":4000,"type":"string"}],"description":"Up to 30 words, each up to 30 characters."}},"required":["kind","words"],"type":"object"},{"properties":{"kind":{"const":"sentence","type":"string"},"sentence":{"description":"One sentence, up to 120 characters.","maxLength":4000,"type":"string"}},"required":["kind","sentence"],"type":"object"}]},"title":{"description":"Title on the sheet, up to 60 characters.","maxLength":100,"type":"string"}},"required":["sheet"],"type":"object"},"name":"make_handwriting","outputSchema":{"$schema":"https://json-sche