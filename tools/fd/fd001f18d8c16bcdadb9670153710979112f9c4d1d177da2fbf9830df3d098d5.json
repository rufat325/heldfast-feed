{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Project Status Tasks"
 },
 "description": "List validated manifest tasks with optional status and phase filters plus bounded offset pagination. Returns public task details and no local evidence locators.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 25,
    "description": "Maximum tasks to return (1-100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Number of matching tasks to skip.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "phase_id": {
    "description": "Optional exact phase identifier.",
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "status": {
    "description": "Optional task status filter.",
    "enum": [
     "complete",
     "in_progress",
     "blocked",
     "not_started"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "project_status_list_tasks",
