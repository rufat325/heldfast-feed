{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "imagelato:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get image project details"
 },
 "description": "Use this when someone asks about one Imagelato project by name or id. Returns its id, name, logo URL and created and edited times, or not-found. Not for a quick look at its latest processed images.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectIdOrName": {
    "description": "Exact project id or name",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectIdOrName"
  ],
  "type": "object"
 },
 "name": "get_project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "project": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "created": {
        "anyOf": [
         {
          "maxLength": 100,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "edited": {
        "$ref": "#/properties/project/anyOf/0/properties/created"
       },
       "id": {
        "maxLength": 200,
        "type": "string"
       },
       "logo": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 120,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "logo",
       "created",
       "edited"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "project"
  ],
  "type": "object"
 },
 "title": "Get image project details"
}
