{"description":"Update a recurring task template, including pausing/resuming with active=false/true.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"active":{"description":"Whether the recurrence is active","type":"boolean"},"anchor_day":{"anyOf":[{"maximum":31,"minimum":1,"type":"integer"},{"type":"null"}],"description":"Day of month for monthly/yearly rules"},"anchor_month":{"anyOf":[{"maximum":12,"minimum":1,"type":"integer"},{"type":"null"}],"description":"Month for yearly rules"},"anchor_weekday":{"anyOf":[{"maximum":6,"minimum":0,"type":"integer"},{"type":"null"}],"description":"Weekday for weekly rules, Sunday=0"},"assigned_to_agent_id":{"description":"Optional assignee, or null to clear","type":["string","number","null"]},"content":{"description":"Task title/content for future spawned instances","type":"string"},"description":{"description":"Optional task description","type":["string","null"]},"interval":{"description":"Rule interval","maximum":9007199254740991,"minimum":1,"type":"integer"},"labels":{"description":"Labels for spawned tasks","items":{"type":"string"},"type":"array"},"next_due_at":{"description":"ISO timestamp for next due occurrence","type":["string","null"]},"priority":{"description":"Priority 1-4","maximum":4,"minimum":1,"type":"integer"},"project_id":{"description":"Optional project ID, or null to clear","type":["string","number","null"]},"recurrence_id":{"description":"The recurrence ID to update","type":["string","number"]},"rule_type":{"description":"Recurrence rule type","enum":["daily","weekly","monthly","yearly"],"type":"string"},"skip_if_open":{"description":"Skip spawning while a prior instance is open","type":"boolean"},"timezone":{"description":"IANA timezone","type":"string"}},"required":["recurrence_id"],"type":"object"},"name":"update_recurrence"}
