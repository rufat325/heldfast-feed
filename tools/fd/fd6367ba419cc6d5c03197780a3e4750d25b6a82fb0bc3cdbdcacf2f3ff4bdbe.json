{
 "description": "Capture a screenshot (PNG/JPG/WEBP) of any web page. Returns the image.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "Image format. (API default: png)",
    "enum": [
     "png",
     "jpg",
     "webp"
    ],
    "type": "string"
   },
   "fullPage": {
    "description": "Capture the full scrollable page instead of just the viewport. (API default: false)",
    "type": "boolean"
   },
   "height": {
    "description": "Viewport height in pixels.",
    "type": "number"
   },
   "quality": {
    "description": "Image quality 0-100 (jpg/webp). (API default: 80)",
    "type": "number"
   },
   "url": {
    "description": "URL of the page to screenshot.",
    "type": "string"
   },
   "wait_until": {
    "description": "Navigation completion trigger. (API default: domcontentloaded)",
    "enum": [
     "load",
     "domcontentloaded",
     "networkidle"
    ],
    "type": "string"
   },
   "width": {
    "description": "Viewport width in pixels.",
    "type": "number"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "screenshot",
 "title": "Screenshot API"
}
