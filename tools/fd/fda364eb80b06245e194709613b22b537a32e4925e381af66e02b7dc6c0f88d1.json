   "avgDealValue": {
    "description": "Average deal value",
    "type": "number"
   },
   "crmConsistency": {
    "description": "CRM fields complete & accurate",
    "enum": [
     "consistent",
     "inconsistent",
     "rarely"
    ],
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "meetingToCloseRatePct": {
    "description": "Meeting \u2192 close rate, as a percentage",
    "type": "number"
   },
   "meetingsHandedOffPerMonth": {
    "description": "Meetings handed off from SDR to AE per month",
    "type": "number"
   },
   "notesConsistency": {
    "description": "Context notes / discovery captured",
    "enum": [
     "consistent",
     "inconsistent",
     "rarely"
    ],
    "type": "string"
   },
   "schedulingConsistency": {
    "description": "Meeting booked & confirmed at hand-off",
    "enum": [
     "consistent",
     "inconsistent",
     "rarely"
    ],
    "type": "string"
   },
   "slaConsistency": {
    "description": "AE follows up within SLA",
    "enum": [
     "consistent",
     "inconsistent",
     "rarely"
    ],
    "type": "string"
   }
  },
  "required": [
