{
 "description": "Returns all configured status pages with their slug, title, visibility, and custom domain settings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "listStatusPages",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "statusPages": {
    "description": "Array of status page configurations",
    "items": {
     "additionalProperties": true,
     "properties": {
      "customCSS": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ]
        },
        {
         "type": "null"
        }
       ],
       "description": "Custom CSS for the status page"
      },
      "description": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ]
        },
        {
         "type": "null"
        }
       ],
       "description": "Description shown on the status page"
      },
      "domainNameList": {
       "description": "Custom domain names for this status page",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "footerText": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ]
        },
        {
         "type": "null"
        }
       ],
       "description": "Footer text"
      },
      "icon": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ]
        },
        {
         "type": "null"
        }
       ],
       "description": "Icon URL or path"
      },
      "id": {
       "description": "Status page ID",
       "type": "number"
      },
      "published": {
       "description": "Whether the status page is publicly accessible",
       "type": "boolean"
      },
      "showPoweredBy": {
       "description": "Whether to show Uptime Kuma branding",
       "type": "boolean"
      },
      "showTags": {
       "description": "Whether to show tags on the status page",
       "type": "boolean"
      },
      "slug": {
       "description": "URL slug for the status page",
       "type": "string"
      },
      "theme": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ]
        },
        {
         "type": "null"
        }
       ],
       "description": "Theme (light or dark)"
      },
      "title": {
       "description": "Title of the status page",
       "type": "string"
      }
     },
     "required": [
      "slug",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "statusPages",
   "count"
  ],
  "type": "object"
 },
 "title": "List Status Pages"
}
