{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":true},"description":"Preview the price for a complete request inside a published service area for Samuelz Chauffeur. Call get_service_options for the current service areas. Use after get_service_options. Related tools: get_service_options or get_customer_policy or prepare_offer or get_offer_status. outside_service_area means the request is not served and has no price. quoted is a preview, not a reservation. No contact is required.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"locale":{"default":"en","description":"Language for text and links: en, or de.","enum":["de","en"],"type":"string"},"offerKey":{"description":"Published supplier offer key, not a booking id.","pattern":"^[a-z0-9][a-z0-9_-]{0,79}$","type":"string"},"ride":{"additionalProperties":false,"description":"Pickup, destination, local date, time and passengers.","properties":{"date":{"description":"Service date as YYYY-MM-DD in the provider time zone.","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"destination":{"description":"Destination with city or postcode, distinct from pickup.","maxLength":240,"minLength":2,"type":"string"},"flightNumber":{"description":"Flight number for an airport pickup, if known.","maxLength":240,"minLength":1,"type":"string"},"hours":{"description":"Booked hours for hourly service; omit for transfers.","maximum":24,"minimum":1,"type":"integer"},"luggage":{"description":"Luggage notes. Unusual items may need review.","maxLength":240,"minLength":1,"type":"string"},"passengers":{"description":"Number of people travelling, from 1 to 60.","maximum":60,"minimum":1,"type":"integer"},"pickup":{"description":"Pickup place with city or postcode, inside a served area.","maxLength":240,"minLength":2,"type":"string"},"returnDate":{"description":"Return date YYYY-MM-DD, only for a return trip.","pattern":"^\\d{4}-\\d{