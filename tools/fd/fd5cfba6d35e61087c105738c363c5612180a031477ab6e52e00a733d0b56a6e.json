{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Turns an agent's own inventory of its connections into Agent Blueprint's one-page access map: a single offline HTML page showing what the agent can read and change, who has to approve, its riskiest powers, and what could be trimmed. The agent supplies the inventory from its own tool list; this tool only draws it. Returns the HTML for the person to save, such as my-agent-blueprint.html. The inventory is not stored. The field guide is at https://agentblueprint.ai/draw.md.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"agent":{"properties":{"model":{"maxLength":80,"type":"string"},"name":{"maxLength":80,"type":"string"},"product":{"maxLength":80,"type":"string"}},"required":["name"],"type":"object"},"checks":{"properties":{"commands":{"properties":{"evidence":{"maxLength":300,"type":"string"},"status":{"enum":["yes","none_found","unsure"],"type":"string"}},"required":["status","evidence"],"type":"object"},"delete":{"properties":{"evidence":{"maxLength":300,"type":"string"},"status":{"enum":["yes","none_found","unsure"],"type":"string"}},"required":["status","evidence"],"type":"object"},"messages":{"properties":{"evidence":{"maxLength":300,"type":"string"},"status":{"enum":["yes","none_found","unsure"],"type":"string"}},"required":["status","evidence"],"type":"object"},"money":{"properties":{"evidence":{"maxLength":300,"type":"string"},"status":{"enum":["yes","none_found","unsure"],"type":"string"}},"required":["status","evidence"],"type":"object"},"secrets":{"properties":{"evidence":{"maxLength":300,"type":"string"},"status":{"enum":["yes","none_found","unsure"],"type":"string"}},"required":["status","evidence"],"type":"object"}},"required":["commands","messages","delete","money","secrets"],"type":"object"},"connections":{"items":{"properties":{"asks":{"type":["boolean","null"]},"basis":{"enum":["declared","judged"],"type":"string"},"changes":{"items":{"maxLength":200,"type":"string"},"maxItems":300,"type":"array"},"icon":{"enum":["mail","chat","calendar","code","files","terminal","web","doc","data","money","plug"],"type":"string"},"name":{"maxLength":40,"type":"string"},"reads":{"items":{"maxLength":200,"type":"string"},"maxItems":300,"type":"array"},"risk":{"enum":["normal","high"],"type":"string"},"unsure":{"items":{"maxLength":200,"type":"string"},"maxItems":300,"type":"array"}},"required":["name","icon","basis","asks","risk","reads","changes","unsure"],"type":"object"},"maxItems":60,"minItems":1,"type":"array"},"drawn":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"trim":{"items":{"properties":{"kind":{"enum":["duplicate","overlap"],"type":"string"},"name":{"maxLength":40,"type":"string"},"tools":{"maximum":1000,"minimum":0,"type":"integer"},"why":{"maxLength":300,"type":"string"}},"required":["name","kind","tools","why"],"type":"object"},"maxItems":30,"type":"array"},"unseen":{"maxLength":600,"type":"string"},"version":{"const":"0.2","type":"string"}},"required":["version","agent","drawn","connections","checks","unseen","trim"],"type":"object"},"name":"render_agent_map","title":"Draw an agent's access map"}
