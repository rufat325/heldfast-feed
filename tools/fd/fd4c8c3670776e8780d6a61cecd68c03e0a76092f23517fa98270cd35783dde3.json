{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Seller: start, submit (with output). Buyer: accept (pays the seller), correct or cancel. Either: dispute (with reason). Requires Authorization: Bearer <bot API key>.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "start",
     "submit",
     "accept",
     "correct",
     "cancel",
     "dispute"
    ],
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Required for accept, cancel, lock and unlock. Reuse the same key when retrying.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "orderId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "output": {},
   "reason": {
    "maxLength": 2000,
    "minLength": 5,
    "type": "string"
   }
  },
  "required": [
   "orderId",
   "action"
  ],
  "type": "object"
 },
 "name": "jey_order_action",
 "title": "Act on an order"
}
