{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Screen stocks"
 },
 "description": "Use to find companies that meet conditions (cheap, high dividend, fast growth\u2026). Filter and rank the covered universe (about 4,000 US-listed names) on fundamental fields (marketCap, peRatio, dividendYield, consecutiveYears, margins, 5y CAGRs, \u2026). Returns at most 25 rows \u2014 the MCP tier's cap; the full screener lives at https://tgmcharts.com/screener.",
 "inputSchema": {
  "properties": {
   "filters": {
    "items": {
     "properties": {
      "field": {
       "description": "Field to filter on",
       "enum": [
        "symbol",
        "name",
        "sector",
        "marketCap",
        "peRatio",
        "dividendYield",
        "consecutiveYears",
        "netProfitMargin",
        "grossMargin",
        "revenueGrowth",
        "debtToEquity",
        "priceChange1Y",
        "percentFrom52WeekHigh",
        "percentFrom52WeekLow",
        "revenueCagr5y",
        "netIncomeCagr5y",
        "epsCagr5y",
        "fcfCagr5y",
        "dividendsCagr5y"
       ],
       "type": "string"
      },
      "operator": {
       "enum": [
        "gt",
        "gte",
        "lt",
        "lte",
        "eq",
        "neq"
       ],
       "type": "string"
      },
      "value": {
       "type": [
        "number",
        "string"
       ]
      }
     },
     "required": [
      "field",
      "operator",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "format": {
    "description": "json (default): the full JSON as text. markdown: a compact table or list, fewer tokens. structuredContent is the full JSON either way.",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   },
   "includeEtfs": {
    "description": "Include ETFs (default false)",
    "type": "boolean"
   },
   "limit": {
    "description": "Rows to return (default 10, max 25)",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "sortBy": {
    "description": "Sort field (default marketCap)",
    "enum": [
     "symbol",
     "name",
     "sector",
     "marketCap",
     "peRatio",
     "dividendYield",
     "consecutiveYears",
     "netProfitMargin",
     "grossMargin",
     "revenueGrowth",
     "debtToEquity",
     "priceChange1Y",
     "percentFrom52WeekHigh",
     "percentFrom52WeekLow",
     "revenueCagr5y",
     "netIncomeCagr5y",
     "epsCagr5y",
     "fcfCagr5y",
     "dividendsCagr5y"
    ],
    "type": "string"
   },
   "sortOrder": {
    "description": "Default desc",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "screen_stocks",
 "outputSchema": {
  "additionalProperties": {},
  "properties": {
   "screenerUrl": {
    "type": "string"
   },
   "shown": {
    "type": "number"
   },
   "stocks": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "symbol": {
       "type": "string"
      }
     },
     "required": [
      "symbol"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalMatches": {
    "type": "number"
   }
  },
  "required": [
   "stocks",
   "totalMatches",
   "shown",
   "screenerUrl"
  ],
  "type": "object"
 },
 "title": "Screen stocks"
}
