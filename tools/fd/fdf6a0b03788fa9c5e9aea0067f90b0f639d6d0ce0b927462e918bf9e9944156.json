{"description":"Add a conditional response to a route: when the request matches the conditions (query, header, path param, body field), the mock answers with this status, body and latency. Rules are evaluated in order, the first match wins; x-loutre-* headers keep priority.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"body":{"description":"JSON body of the response"},"latencyMs":{"maximum":30000,"minimum":0,"type":"number"},"name":{"description":"Human-readable label of the rule","maxLength":60,"type":"string"},"ownerToken":{"description":"Owner token received at creation (not needed when the account is connected with an API token)","type":"string"},"route":{"description":"Route identifier, lowercase method: \"get:/users/{id}\"","type":"string"},"slug":{"description":"Subdomain of the mock, e.g. \"brisk-otter\"","pattern":"^[a-z0-9-]{1,63}$","type":"string"},"status":{"maximum":599,"minimum":100,"type":"integer"},"when":{"additionalProperties":false,"description":"Every condition must hold","properties":{"body":{"additionalProperties":{},"description":"Expected JSON body fields, by dotted path (customer.email)","propertyNames":{"type":"string"},"type":"object"},"header":{"additionalProperties":{"type":"string"},"description":"Expected headers","propertyNames":{"type":"string"},"type":"object"},"param":{"additionalProperties":{"type":"string"},"description":"Expected path parameters ({id})","propertyNames":{"type":"string"},"type":"object"},"query":{"additionalProperties":{"type":"string"},"description":"Expected query parameters","propertyNames":{"type":"string"},"type":"object"}},"type":"object"}},"required":["slug","route","when"],"type":"object"},"name":"add_rule"}
