{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Evaluate spec mask"
 },
 "description": "Evaluates signal data against automated design specifications and tolerance corridors (rise time, settling time, overshoot %, steady-state error, min/max limits).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "blockId": {
    "description": "ID of the Scope or signal source block",
    "type": "string"
   },
   "lowerLimit": {
    "description": "Absolute lower bound corridor",
    "type": "number"
   },
   "maxOvershootPercent": {
    "description": "Maximum allowable overshoot %",
    "type": "number"
   },
   "maxRiseTime": {
    "description": "Maximum allowable rise time (seconds)",
    "type": "number"
   },
   "maxSettlingTime": {
    "description": "Maximum allowable settling time (seconds)",
    "type": "number"
   },
   "maxSteadyStateError": {
    "description": "Maximum allowable steady-state error",
    "type": "number"
   },
   "setpoint": {
    "description": "Target setpoint value (default: 1)",
    "type": "number"
   },
   "upperLimit": {
    "description": "Absolute upper bound corridor",
    "type": "number"
   }
  },
  "required": [
   "blockId"
  ],
  "type": "object"
 },
 "name": "evaluate_spec_mask",
 "title": "Evaluate spec mask"
}
