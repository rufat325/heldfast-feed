{
 "description": "Get BRC-20 token activity (deploy, mint, transfer events). Filter by ticker, address, or operation type.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Filter by Bitcoin address",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Results per page",
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset",
    "type": "number"
   },
   "operation": {
    "description": "Filter by operation type",
    "enum": [
     "deploy",
     "mint",
     "transfer",
     "transfer_send"
    ],
    "type": "string"
   },
   "ticker": {
    "description": "Filter by BRC-20 ticker",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_brc20_activity"
}
