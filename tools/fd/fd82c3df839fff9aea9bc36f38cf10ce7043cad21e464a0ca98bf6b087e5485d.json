{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "utilpeek: list the next run times of a cron expression"
 },
 "description": "utilpeek: the next run times of a cron expression. For iCalendar RRULEs use expand_rrule. Standard 5-field cron (minute hour day-of-month month day-of-week) or a macro (@daily, @hourly, ...); no seconds or year fields, no R/H/W. Day-of-month and day-of-week use Vixie OR semantics; an expression that never fires (Feb 30) is a 422 no_next_run (not charged); rare ones return what exists with `exhausted: true`. An invalid expression, start or zone is a 422 (not charged). Typically under 0.1 s. Price: USD 0.001. Free: 10 utilpeek calls per IP per UTC day. Docs: https://tanod.dev/learn/cron-next-run-api.html",
 "inputSchema": {
  "properties": {
   "count": {
    "default": 10,
    "description": "Number of next runs (1-50, default 10).",
    "maximum": 50,
    "minimum": 1,
    "title": "Count",
    "type": "integer"
   },
   "expression": {
    "description": "5-field cron expression or macro, e.g. */15 9-17 * * MON-FRI.",
    "maxLength": 200,
    "minLength": 1,
    "title": "Expression",
    "type": "string"
   },
   "start": {
    "anyOf": [
     {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional ISO 8601 start (default now).",
    "title": "Start"
   },
   "timezone": {
    "anyOf": [
     {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([A-Za-z0-9_+\\-]{1,40}(/[A-Za-z0-9_+\\-]{1,40}){0,2})$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional IANA time zone (default UTC).",
    "title": "Timezone"
   }
  },
  "required": [
   "expression"
  ],
  "title": "cron_next_runsArguments",
  "type": "object"
 },
 "name": "cron_next_runs",
 "outputSchema": {
  "properties": {
   "count": {
    "type": [
     "integer",
     "null"
    ]
   },
   "error": {
    "description": "Only on an error result: an object {code, message}, or the reason string of an x402 PaymentRequired object."
   },
   "exhausted": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "expression": {
    "type": [
     "string",
     "null"
    ]
   },
   "runs": {
    "items": {
     "properties": {
      "time": {
       "type": [
        "string",
        "null"
       ]
      },
      "unix": {
