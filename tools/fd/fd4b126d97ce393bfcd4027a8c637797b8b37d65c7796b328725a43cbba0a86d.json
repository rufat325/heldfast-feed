{
 "description": "List all saved searches for the authenticated user. Can filter by notification status and title.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "notificationEnabled": {
    "description": "Filter by notification status",
    "type": "boolean"
   },
   "orderByTitle": {
    "description": "Sort by title",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number",
    "type": "number"
   },
   "title": {
    "description": "Filter by title",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list-searches"
}
