{
 "description": "Sync production readiness findings from a local analysis back to the FinishKit dashboard. Creates a run record and inserts findings with deduplication.",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "Which AI agent performed the analysis",
    "enum": [
     "claude-code",
     "cursor",
     "codex",
     "windsurf",
     "custom"
    ],
    "type": "string"
   },
   "branch_name": {
    "description": "Git branch name (optional)",
    "type": "string"
   },
   "commit_sha": {
    "description": "Git commit SHA (optional)",
    "type": "string"
   },
   "detected_stack": {
    "description": "Detected stack metadata (framework, language, integrations)",
    "type": "object"
   },
   "findings": {
    "description": "Array of findings from the analysis",
    "items": {
     "properties": {
      "category": {
       "enum": [
        "blockers",
        "security",
        "deploy",
        "stability",
        "tests",
        "ui"
       ],
       "type": "string"
      },
      "confidence": {
       "description": "0.0 to 1.0",
       "type": "number"
      },
      "detail_md": {
       "type": "string"
      },
      "file_path": {
       "type": "string"
      },
      "fingerprint": {
       "description": "SHA-256 hash for deduplication",
       "type": "string"
      },
      "fixApplied": {
       "type": "boolean"
      },
      "fixVerified": {
       "type": "boolean"
      },
      "line_end": {
       "type": "number"
      },
      "line_start": {
       "type": "number"
      },
      "pr_task": {
       "type": "object"
      },
      "severity": {
       "enum": [
        "critical",
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "category",
      "severity",
      "confidence",
      "title",
      "detail_md",
      "file_path",
      "fingerprint",
      "pr_task"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "finished_at": {
    "description": "ISO timestamp when analysis finished",
    "type": "string"
   },
   "pack_id": {
    "description": "Intelligence pack ID used",
    "type": "string"
   },
   "pack_version": {
    "description": "Intelligence pack version used",
    "type": "string"
   },
   "project_name": {
    "description": "Project display name",
    "type": "string"
   },
   "provider": {
    "description": "Code provider. Defaults to 'local'.",
    "enum": [
     "github",
     "gitlab",
     "local"
    ],
    "type": "string"
   },
   "repo_name": {
    "description": "Repository name (optional, for linking)",
    "type": "string"
   },
   "repo_owner": {
    "description": "GitHub org/user that owns the repo (optional, for linking)",
    "type": "string"
   },
   "run_type": {
    "description": "Type of scan. Defaults to 'baseline'.",
    "enum": [
     "baseline",
     "pr",
     "manual_patch"
    ],
    "type": "string"
   },
   "started_at": {
    "description": "ISO timestamp when analysis started",
    "type": "string"
   },
   "summary": {
    "description": "Human-readable summary of the analysis",
    "type": "string"
   },
   "token_usage": {
    "description": "Token usage stats (optional)",
    "properties": {
     "input": {
      "type": "number"
     },
     "model": {
      "type": "string"
     },
     "output": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "project_name",
   "agent_id",
   "pack_id",
   "pack_version",
   "started_at",
   "finished_at",
   "detected_stack",
   "findings",
   "summary"
  ],
  "type": "object"
 },
 "name": "sync_findings"
}
