{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true
 },
 "description": "Delete a secret from a graduated app's vault by name. Deleting a name that does not exist is not an error \u2014 the final state is what you asked for.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dropId": {
    "pattern": "^[a-z0-9]{8}$",
    "type": "string"
   },
   "managementToken": {
    "type": "string"
   },
   "name": {
    "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
    "type": "string"
   }
  },
  "required": [
   "dropId",
   "name"
  ],
  "type": "object"
 },
 "name": "dropyour_secret_delete",
 "title": "Delete an app secret"
}
