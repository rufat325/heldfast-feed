{
 "_meta": {
  "vesremont.com/auth": {
   "resource": "https://vesremont.com/mcp",
   "scope": "",
   "scopes": []
  },
  "vesremont.com/user-confirmation": false
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read customer feedback for a product selected with get_product, not its specifications. Returns only moderated, published review text, ratings and rating_summary; no pending reviews or review submission. Use page or cursor, never both; an empty list means no published reviews, not a zero-star rating. Public; no OAuth required. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque next_cursor from the previous response. Keep the same filters/sort; do not combine with page. Expires after 15 minutes. Existing backend windows apply; not a frozen snapshot.",
    "maxLength": 765,
    "type": "string"
   },
   "page": {
    "description": "One-based result page, default 1. Do not combine with cursor; the existing offset window still applies.",
    "maximum": 100001,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Maximum results per page, default 20. Keep the same value when following next_cursor.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "product_id": {
    "description": "Internal numeric Vesremont product ID returned by catalog search or a product response, not the SKU/article or a basket item ID.",
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "Published review order: newest first by default; choose date_asc for oldest first or rating_desc/rating_asc for highest/lowest ratings first.",
    "enum": [
     "date_desc",
     "date_asc",
     "rating_desc",
     "rating_asc"
    ]
   }
  },
  "required": [
   "product_id"
  ],
  "type": "object"
 },
 "name": "get_product_reviews",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author_name": {
       "maxLength": 150,
       "type": "string"
      },
      "cons": {
       "maxLength": 4000,
       "type": "string"
      },
      "id": {
       "maximum": 2147483647,
       "minimum": 1,
       "type": "integer"
      },
      "product_id": {
       "maximum": 2147483647,
       "minimum": 1,
       "type": "integer"
      },
      "pros": {
       "maxLength": 4000,
       "type": "string"
      },
      "published_at": {
       "anyOf": [
        {
         "format": "date-time",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "rating": {
       "maximum": 5,
       "minimum": 1,
       "type": "integer"
      },
      "text": {
       "maxLength": 8000,
       "type": "string"
      }
     },
     "required": [
      "id",
      "product_id",
      "rating",
      "author_name",
      "pros",
      "cons",
      "text",
      "published_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pagination": {
    "additionalProperties": false,
    "properties": {
     "has_next": {
      "type": "boolean"
     },
     "has_prev": {
      "type": "boolean"
     },
     "next_cursor": {
      "anyOf": [
       {
        "maxLength": 765,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "page": {
      "type": "integer"
     },
     "per_page": {
      "type": "integer"
     },
     "total_items": {
      "minimum": 0,
      "type": "integer"
     },
     "total_pages": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "page",
     "per_page",
     "total_items",
     "total_pages",
     "has_next",
     "has_prev"
    ],
    "type": "object"
   },
   "rating_summary": {
    "additionalProperties": false,
    "properties": {
     "average_rating": {
      "anyOf": [
       {
        "maximum": 5,
        "minimum": 1,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "average_rating"
    ],
    "type": "object"
   }
  },
  "required": [
   "items",
   "pagination",
   "rating_summary"
  ],
  "type": "object"
 }
}
