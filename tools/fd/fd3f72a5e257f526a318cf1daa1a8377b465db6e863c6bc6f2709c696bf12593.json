  "additionalProperties": false,
  "properties": {
   "addLabelIds": {
    "description": "Label IDs to add to the message",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "The ID of the message to modify",
    "type": "string"
   },
   "removeLabelIds": {
    "description": "Label IDs to remove from the message",
