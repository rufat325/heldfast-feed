{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get Sleep Collection"
 },
 "description": "Get sleep records for a date range. Accepts ISO 8601 or relative dates (\"today\", \"last 7 days\", \"this week\"). Returns sleep stages, duration, respiratory rate, and performance scores.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "end": {
    "description": "Return records before this time (exclusive). ISO 8601 format or relative expression. Defaults to now.",
    "type": "string"
   },
   "limit": {
    "description": "Max records to return (1-25). Defaults to 10.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "nextToken": {
    "description": "Pagination token from a previous response.",
    "type": "string"
   },
   "start": {
    "description": "Return records after this time (inclusive). ISO 8601 format or relative expression (e.g. \"today\", \"last 7 days\", \"this week\").",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_sleep_collection",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "next_token": {
    "type": [
     "string",
     "null"
    ]
   },
   "records": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "created_at": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "cycle_id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "end": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "id": {
       "minLength": 1,
       "type": "string"
      },
      "nap": {
       "type": "boolean"
      },
      "score": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "respiratory_rate": {
           "anyOf": [
            {
             "minimum": 0,
             "type": "number"
            },
            {
             "type": "null"
            }
           ]
          },
          "sleep_consistency_percentage": {
           "anyOf": [
            {
             "maximum": 100,
             "minimum": 0,
             "type": "number"
            },
            {
             "type": "null"
            }
           ]
          },
          "sleep_efficiency_percentage": {
           "anyOf": [
            {
             "maximum": 100,
             "minimum": 0,
             "type": "number"
            },
            {
             "type": "null"
            }
           ]
          },
          "sleep_needed": {
           "additionalProperties": false,
           "properties": {
            "baseline_milli": {
             "minimum": 0,
             "type": "number"
            },
            "need_from_recent_nap_milli": {
             "type": "number"
            },
            "need_from_recent_strain_milli": {
             "type": "number"
            },
            "need_from_sleep_debt_milli": {
             "type": "number"
            }
           },
           "required": [
            "baseline_milli",
            "need_from_sleep_debt_milli",
            "need_from_recent_strain_milli",
            "need_from_recent_nap_milli"
           ],
           "type": "object"
          },
          "sleep_performance_percentage": {
           "anyOf": [
            {
             "maximum": 100,
             "minimum": 0,
             "type": "number"
            },
            {
             "type": "null"
            }
           ]
          },
          "stage_summary": {
           "additionalProperties": false,
           "properties": {
            "disturbance_count": {
             "minimum": 0,
             "type": "number"
            },
            "sleep_cycle_count": {
             "minimum": 0,
             "type": "number"
            },
            "total_awake_time_milli": {
             "minimum": 0,
             "type": "number"
            },
            "total_in_bed_time_milli": {
             "minimum": 0,
             "type": "number"
            },
            "total_light_sleep_time_milli": {
             "minimum": 0,
             "type": "number"
            },
            "total_no_data_time_milli": {
             "minimum": 0,
             "type": "number"
            },
            "total_rem_sleep_time_milli": {
             "minimum": 0,
             "type": "number"
            },
            "total_slow_wave_sleep_time_milli": {
             "minimum": 0,
             "type": "number"
            }
           },
           "required": [
            "total_in_bed_time_milli",
            "total_awake_time_milli",
            "total_no_data_time_milli",
            "total_light_sleep_time_milli",
            "total_slow_wave_sleep_time_milli",
            "total_rem_sleep_time_milli",
            "sleep_cycle_count",
            "disturbance_count"
           ],
           "type": "object"
          }
         },
         "required": [
          "stage_summary",
          "sleep_needed"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "score_state": {
       "enum": [
        "SCORED",
        "PENDING_SCORE",
        "UNSCORABLE"
       ],
       "type": "string"
      },
      "start": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "timezone_offset": {
       "pattern": "^[+-](?:0\\d|1[0-4]):[0-5]\\d$",
       "type": "string"
      },
      "updated_at": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "user_id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "user_id",
      "created_at",
      "updated_at",
      "score_state",
      "start",
      "end",
      "timezone_offset",
      "id",
      "cycle_id",
      "nap"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "records"
  ],
  "type": "object"
 }
}
