{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Change a registered command's description or options. Anything not passed is left as it is. Replacing options replaces the whole list, so send every option you want to keep.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bot": {
    "description": "Which bot to act as, by name, when more than one is configured. Omit to use the default bot.",
    "type": "string"
   },
   "command": {
    "description": "Command name or ID.",
    "type": "string"
   },
   "description": {
    "description": "New description.",
    "type": "string"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "options": {
    "description": "Replacement option list, replacing the existing one entirely.",
    "items": {
     "properties": {
      "choices": {
       "description": "Fixed set of allowed values, for string, integer, and number options.",
       "items": {
        "properties": {
         "name": {
          "type": "string"
         },
         "value": {
          "type": [
           "string",
           "number"
          ]
         }
        },
        "required": [
         "name",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "description": {
       "description": "What the option is for.",
       "type": "string"
      },
      "name": {
       "description": "Option name, lowercase, no spaces.",
       "type": "string"
      },
      "required": {
       "description": "Whether the user must supply it.",
       "type": "boolean"
      },
      "type": {
       "default": "string",
       "description": "Value type. Defaults to string.",
       "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "user",
        "channel",
        "role",
        "mentionable",
        "attachment"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "command"
  ],
  "type": "object"
 },
 "name": "update_app_command",
 "title": "Update app command"
}
