    "type": "string"
   },
   "email_opted_out": {
    "type": "boolean"
   },
   "employee_count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "first_name": {
    "type": "string"
   },
   "industry": {
    "type": "string"
   },
   "last_name": {
