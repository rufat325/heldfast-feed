{
 "description": "Search the Claidex failure database for post-mortems matching a drug name, gene target, disease, failure archetype, or sponsor. Returns matching claims with title, slug, drug, target, disease, phase, failure archetype, Open Targets score, and MRS score.",
 "execution": {
  "taskSupport": "optional"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "category": {
    "default": "any",
    "enum": [
     "Oncology",
     "Cardiology",
     "Neurology",
     "Immunology",
     "Infectious Disease",
     "Metabolic",
     "Rare Disease",
     "Other",
     "any"
    ],
    "type": "string"
   },
   "failure_archetype": {
    "default": "any",
    "enum": [
     "efficacy_failure",
     "safety_signal",
     "enrollment_collapse",
     "sponsor_decision",
     "strategic_reprioritization",
     "translational_mismatch",
     "biomarker_failure",
     "any"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search term: drug name, gene symbol, disease, or failure archetype",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query",
   "category",
   "failure_archetype",
   "limit"
  ],
  "type": "object"
 },
 "name": "search_claims",
 "title": "Search Claims"
}
