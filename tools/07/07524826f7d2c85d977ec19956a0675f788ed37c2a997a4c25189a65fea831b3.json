{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Submit a profile, listing, or price correction for Loa review without requiring a provider portal. This is the only mutating provider/entity tool. It requires OAuth, captures submitter and source evidence, records linked-provider status when available, and never changes public data until Loa approves the request.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "attestation": {
    "description": "How the submitter is connected to the submitted evidence.",
    "enum": [
     "provider_representative",
     "authorized_agent",
     "public_source",
     "other"
    ],
    "type": "string"
   },
   "entity_page_id": {
    "description": "Loa entity_pages.id for the provider or hospital.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "entity_slug": {
    "description": "Exact Loa entity slug if entity_page_id is not available.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "entity_type": {
    "default": "unknown",
    "description": "Entity kind for the requested update; use unknown only when it cannot be determined.",
    "enum": [
     "hospital",
     "provider",
     "unknown"
    ],
    "type": "string"
   },
   "idempotency_key": {
    "description": "Optional stable retry key. Loa derives one from the payload if omitted.",
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "price_items": {
    "default": [],
    "description": "Optional structured price rows proposed for Loa review.",
    "items": {
     "properties": {
      "billing_class": {
       "maxLength": 100,
       "type": "string"
      },
      "code_type": {
       "default": "CPT",
       "maxLength": 20,
       "minLength": 1,
       "type": "string"
      },
      "component": {
       "default": "unknown",
       "enum": [
        "global",
        "professional",
        "facility",
        "unknown"
       ],
       "type": "string"
      },
      "cpt_code": {
       "maxLength": 20,
       "minLength": 3,
       "type": "string"
      },
      "exclusions": {
       "maxLength": 1000,
       "type": "string"
      },
      "included_services": {
       "items": {
        "maxLength": 300,
        "type": "string"
       },
       "type": "array"
      },
      "payer_name": {
       "maxLength": 300,
       "type": "string"
      },
      "plan_name": {
       "maxLength": 300,
       "type": "string"
      },
      "price_kind": {
       "default": "cash",
       "enum": [
        "cash",
        "discounted_cash",
        "package_cash",
        "payer_negotiated"
       ],
       "type": "string"
      },
      "price_notes": {
       "maxLength": 1000,
       "type": "string"
      },
      "proposed_price_cents": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "service_name": {
       "maxLength": 300,
       "type": "string"
      },
      "setting": {
       "maxLength": 100,
       "type": "string"
      }
     },
     "required": [
      "cpt_code"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "proposed_changes": {
    "additionalProperties": {},
    "default": {},
    "description": "Structured profile or listing fields proposed for Loa review.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "request_type": {
    "description": "Type of reviewed change being requested.",
    "enum": [
     "price_update",
     "profile_correction",
     "new_listing",
     "remove_listing",
     "other"
    ],
    "type": "string"
   },
   "source_notes": {
    "description": "Short verification notes, source context, or callback instructions.",
    "maxLength": 2000,
    "type": "string"
   },
   "source_urls": {
    "default": [],
    "description": "Optional public URLs reviewers can use to verify the submitted change.",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "submitter_email": {
    "description": "Work email for the submitting representative.",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "submitter_name": {
    "description": "Name of the person submitting the request.",
    "maxLength": 200,
    "type": "string"
   },
   "submitter_organization": {
    "description": "Provider, hospital, or agent organization represented by the submitter.",
    "maxLength": 300,
    "type": "string"
   },
   "submitter_phone": {
    "description": "Optional callback phone number for reviewer follow-up.",
    "maxLength": 50,
    "type": "string"
   },
   "submitter_role": {
    "description": "Submitter role, such as billing manager or authorized agent.",
    "maxLength": 200,
    "type": "string"
   },
   "uploaded_file_url": {
    "description": "Optional public URL for an uploaded evidence file.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "submitter_email",
   "request_type"
  ],
  "type": "object"
 },
 "name": "submit_entity_update_request",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entityPageId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "requestId": {
    "type": "string"
   },
   "reusedExisting": {
    "type": "boolean"
   },
   "status": {
    "type": "string"
   },
   "updateRequestId": {
    "type": "string"
   }
  },
  "required": [
   "requestId",
   "updateRequestId",
   "status",
   "entityPageId",
   "reusedExisting"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "openid",
    "email",
    "profile"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Submit Entity Update Request"
}
