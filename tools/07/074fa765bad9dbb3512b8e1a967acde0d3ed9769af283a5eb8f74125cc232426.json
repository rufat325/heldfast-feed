{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Full detail of one Wallet movement by its id (from ripio_list_activity with source \"wallet\"): amounts, fee, rail, counterparty, status and the on-chain hash when there is one.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^[1-9]\\d*$",
      "type": "string"
     }
    ],
    "description": "Wallet transaction id, as a number or as the string ripio_list_activity returns."
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "ripio_get_transaction",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "type": "string"
   },
   "asset": {
    "type": "string"
   },
   "counterparty": {
    "type": "string"
   },
   "date": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "direction": {
    "enum": [
     "in",
     "out",
     "internal"
    ],
    "type": "string"
   },
   "fee": {
    "type": "string"
   },
   "fee_asset": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "rail": {
    "type": "string"
   },
   "raw_status": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "transaction_hash": {
    "type": "string"
   },
   "type": {
    "type": "string"
   },
   "unreadable": {
    "items": {
     "enum": [
      "amount",
      "asset"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "date",
   "type",
   "direction",
   "asset",
   "amount",
   "status",
   "raw_status"
  ],
  "type": "object"
 },
 "title": "Ripio Wallet transaction"
}
