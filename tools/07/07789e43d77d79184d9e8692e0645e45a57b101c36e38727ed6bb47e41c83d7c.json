{
 "description": "Create a Responsive Search Ad in an ad group. 3\u201315 headlines (\u226430 chars), 2\u20134 descriptions (\u226490 chars), and final URL(s). Validates lengths before sending. Refs #5741.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adGroupId": {
    "description": "Ad group ID to add the ad to.",
    "type": "string"
   },
   "customerId": {
    "description": "Google Ads customer ID. Defaults to GOOGLE_ADS_CUSTOMER_ID env var.",
    "type": "string"
   },
   "descriptions": {
    "description": "2\u20134 descriptions, each \u226490 chars.",
    "items": {
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array"
   },
   "finalUrl": {
    "description": "Landing page URL (e.g. https://ainative.studio/opencode).",
    "type": "string"
   },
   "headlines": {
    "description": "3\u201315 headlines, each \u226430 chars.",
    "items": {
     "type": "string"
    },
    "maxItems": 15,
    "minItems": 3,
    "type": "array"
   },
   "path1": {
    "description": "Optional display path 1 (\u226415 chars).",
    "type": "string"
   },
   "path2": {
    "description": "Optional display path 2 (\u226415 chars).",
    "type": "string"
   },
   "status": {
    "default": "ENABLED",
    "description": "Default ENABLED.",
    "enum": [
     "ENABLED",
     "PAUSED"
    ],
    "type": "string"
   }
  },
  "required": [
   "adGroupId",
   "headlines",
   "descriptions",
   "finalUrl"
  ],
  "type": "object"
 },
 "name": "gads_create_responsive_search_ad"
}
