{
 "annotations": {
  "openWorldHint": true
 },
 "description": "Invia il documento per email al cliente, con link e PDF. Mittente, destinatario, oggetto e testo di default sono quelli impostati in Fatture in Cloud.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "attach_pdf": {
    "type": "boolean"
   },
   "body": {
    "description": "HTML; {{allegati}} viene sostituito dai pulsanti",
    "type": "string"
   },
   "company_id": {
    "description": "Azienda su cui operare. Default: FIC_COMPANY_ID o l'unica azienda del token",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "id": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "recipient_email": {
    "description": "Pi\u00f9 indirizzi separati da virgola",
    "type": "string"
   },
   "send_copy": {
    "description": "Copia all'indirizzo CC dell'azienda",
    "type": "boolean"
   },
   "subject": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "email_document"
}
