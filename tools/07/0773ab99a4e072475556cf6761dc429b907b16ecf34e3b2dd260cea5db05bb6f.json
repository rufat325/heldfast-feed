{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Same as get_market_state for up to 50 symbols in one call.",
 "inputSchema": {
  "properties": {
   "format": {
    "default": "full",
    "description": "compact = symbol, layer, time, vector, short citation and remaining quota only. full = per-timeframe state, seq, hash and engine version (for citing and checking).",
    "enum": [
     "full",
     "compact"
    ],
    "type": "string"
   },
   "layer": {
    "default": "verified",
    "description": "verified = closed candles (recorded, never changed); live = forming candles (provisional)",
    "enum": [
     "verified",
     "live"
    ],
    "type": "string"
   },
   "proof": {
    "default": false,
    "description": "Also put DAMO's Ed25519 signature in the result body as 'proof'.",
    "type": "boolean"
   },
   "symbols": {
    "items": {
     "description": "Symbol, e.g. BTCUSDT (Binance USD\u24c8-M perpetual naming)",
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "timeframes": {
    "description": "Optional. Only these timeframes are returned and counted against the quota (case-sensitive: 1m = minute, 1M = month). Omit for all 10.",
    "items": {
     "enum": [
      "1m",
      "5m",
      "15m",
      "1h",
      "4h",
      "12h",
      "1d",
      "3d",
      "1w",
      "1M"
     ],
     "type": "string"
    },
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "symbols"
  ],
  "type": "object"
 },
 "name": "get_market_states",
 "outputSchema": {
  "properties": {
   "citation": {
    "type": "string"
   },
   "count": {
    "type": "integer"
   },
   "errors": {
    "items": {
     "properties": {
      "error": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "symbol": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "layer": {
    "enum": [
     "verified",
     "live"
    ],
    "type": "string"
   },
   "proof": {
    "type": "object"
   },
   "quota": {
    "type": "object"
   },
   "quota_remaining": {
    "type": "integer"
   },
   "results": {
    "items": {
     "properties": {
      "as_of": {
       "description": "verified: when DAMO last wrote this record (UTC). Each timeframe's own close time is states[tf].candle_close",
       "type": "string"
      },
      "chain_head": {
       "type": "object"
      },
      "citation": {
       "type": "string"
      },
      "engine_version": {
       "type": "string"
      },
      "layer": {
       "enum": [
        "verified",
        "live"
       ],
       "type": "string"
      },
      "observed_at": {
       "description": "live: when DAMO observed the forming candles (UTC)",
       "type": "string"
      },
      "proof": {
       "description": "Ed25519 signature when proof=true",
       "type": "object"
      },
      "quota": {
       "type": "object"
      },
      "quota_remaining": {
       "type": "integer"
      },
      "stale": {
       "type": "boolean"
      },
      "states": {
       "additionalProperties": {
        "type": "object"
       },
       "description": "full format: per-timeframe state, code, candle status and record fields",
       "type": "object"
      },
      "symbol": {
       "type": "string"
      },
      "vector": {
       "description": "State codes in timeframe order (1 bull_momentum, 2 weakening, 3 bear_momentum, 4 recovery); null = not requested or not available",
       "items": {
        "maximum": 4,
        "minimum": 1,
        "type": [
         "integer",
         "null"
        ]
       },
       "type": "array"
      },
      "vector_order": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "symbol",
      "layer",
      "vector"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "layer",
   "results"
  ],
  "type": "object"
 },
 "title": "Get DAMO market state for several symbols"
}
