{
 "description": "Create a new contact.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "address1": {
    "description": "Street address",
    "type": "string"
   },
   "city": {
    "description": "City",
    "type": "string"
   },
   "companyName": {
    "description": "Company name associated with the contact",
    "type": "string"
   },
   "dnd": {
    "description": "Do Not Disturb flag",
    "type": "boolean"
   },
   "email": {
    "description": "Contact email address",
    "type": "string"
   },
   "firstName": {
    "description": "Contact first name",
    "type": "string"
   },
   "lastName": {
    "description": "Contact last name",
    "type": "string"
   },
   "locationId": {
    "description": "Location ID the contact belongs to",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "phone": {
    "description": "Contact phone number",
    "type": "string"
   },
   "postalCode": {
    "description": "Postal / ZIP code",
    "type": "string"
   },
   "source": {
    "description": "Lead source for the contact",
    "type": "string"
   },
   "state": {
    "description": "State or province",
    "type": "string"
   },
   "tags": {
    "description": "Array of tag strings to apply to the contact",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timezone": {
    "description": "Contact timezone (e.g. 'America/New_York')",
    "type": "string"
   },
   "website": {
    "description": "Contact website URL",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId"
  ],
  "type": "object"
 },
 "name": "crm_create_contact"
}
