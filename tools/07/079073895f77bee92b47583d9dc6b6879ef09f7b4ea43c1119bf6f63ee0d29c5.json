{
 "description": "Search message archives",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "group_id": {
    "type": "number"
   },
   "group_name": {
    "type": "string"
   },
   "limit": {
    "type": "number"
   },
   "page_token": {
    "type": "string"
   },
   "q": {
    "description": "Search query",
    "type": "string"
   },
   "sort_dir": {
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "sort_field": {
    "enum": [
     "relevance",
     "created"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_archives"
}
