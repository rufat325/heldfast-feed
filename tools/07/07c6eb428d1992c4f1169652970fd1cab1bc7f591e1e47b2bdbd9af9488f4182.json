{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new task in Nextcloud Tasks with optional due date, start date, tags, location, and subtask relationships.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "calendarName": {
    "default": "tasks",
    "description": "The calendar name (default: 'tasks')",
    "type": "string"
   },
   "categories": {
    "description": "Tags/categories (e.g. ['work', 'urgent'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "classification": {
    "description": "Task visibility classification",
    "enum": [
     "PUBLIC",
     "PRIVATE",
     "CONFIDENTIAL"
    ],
    "type": "string"
   },
   "description": {
    "description": "Detailed description of the task",
    "type": "string"
   },
   "dtstart": {
    "description": "Start date in YYYYMMDD or YYYYMMDDTHHmmssZ format",
    "type": "string"
   },
   "due": {
    "description": "Due date in YYYYMMDD or YYYYMMDDTHHmmssZ format (e.g. '20240315' or '20240315T140000Z')",
    "type": "string"
   },
   "location": {
    "description": "Location string",
    "type": "string"
   },
   "percentComplete": {
    "description": "Completion percentage (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "priority": {
    "description": "Task priority (0=undefined, 1=highest, 5=medium, 9=lowest)",
    "maximum": 9,
    "minimum": 0,
    "type": "number"
   },
   "relatedTo": {
    "description": "Parent task UID (creates a subtask relationship)",
    "type": "string"
   },
   "summary": {
    "description": "The task summary/title",
    "type": "string"
   },
   "url": {
    "description": "Custom URL reference",
    "type": "string"
   }
  },
  "required": [
   "summary"
  ],
  "type": "object"
 },
 "name": "create_task",
 "title": "Create Task"
}
