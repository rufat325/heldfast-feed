{
 "_meta": {
  "openai/outputTemplate": "ui://soclo/chat-ads/v2.html",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "read:library"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://soclo/chat-ads/v2.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Recover your video variants (free)"
 },
 "description": "Free; never purchases. Recovers each canonical finished film from its saved project/generation (also in the app Library), keeping each original identity. Persist all returned IDs in host context/widget state. One result is one finished Soclo render, never joined agent-local clips. Wallet/ledger and soclo_video_make remain authoritative.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "variants": {
    "description": "Transport page of existing saved host projects, not an engine craft limit; use more pages if needed.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "clientRequestId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "dispatchConnected": {
       "type": "boolean"
      },
      "expectedCredits": {
       "minimum": 0,
       "type": "number"
      },
      "generationId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "hook": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "label": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "makeReady": {
       "type": "boolean"
      },
      "projectId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "quoteId": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      },
      "revision": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "hook",
      "projectId",
      "revision",
      "clientRequestId"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "variants"
  ],
  "type": "object"
 },
 "name": "soclo_video_variants_status",
 "title": "Recover your video variants (free)"
}
