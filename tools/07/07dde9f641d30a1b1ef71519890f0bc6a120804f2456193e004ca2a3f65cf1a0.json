{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Accepts a structured product-feedback report with category, message, and optional URL, route, tool, request ID, trace ID, or reproducible context. Returns an opaque report ID. Human triage owns disposition. Secret-bearing, oversize, or malformed payloads are rejected without persist. Authentication is optional; anonymous submissions are rate-limited. The request costs 0 credits. The result is a receipt for human triage, not investment advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "bug",
     "data_quality",
     "docs",
     "api",
     "mcp",
     "other"
    ],
    "type": "string"
   },
   "context": {
    "additionalProperties": false,
    "properties": {
     "executive_id": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "fiscal_year": {
      "maximum": 2100,
      "minimum": 1900,
      "type": "integer"
     },
     "ticker": {
      "pattern": "^(?=.*[A-Z])[A-Z0-9][A-Z0-9.\\s-]{0,29}$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "message": {
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   },
   "request_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "route": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "tool": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "trace_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "category",
   "message"
  ],
  "type": "object"
 },
 "name": "submit_feedback",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "schema_version": {
    "const": "feedback/v1",
    "type": "string"
   },
   "status": {
    "const": "accepted",
    "type": "string"
   }
  },
  "required": [
   "schema_version",
   "id",
   "status"
  ],
  "type": "object"
 },
 "title": "Submit Feedback"
}
