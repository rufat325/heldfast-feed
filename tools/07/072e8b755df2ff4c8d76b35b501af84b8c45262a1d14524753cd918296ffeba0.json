{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Add a \"Cycle time\" chart widget to an existing dashboard. Issue source priority: filterId > query > filter.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "autoUpdatable": {
    "description": "Auto-refresh the chart",
    "type": "boolean"
   },
   "bucket": {
    "description": "Chart step, default 7 days",
    "properties": {
     "boardId": {
      "description": "Board id, when unit is \"sprints\"",
      "type": "string"
     },
     "count": {
      "type": "number"
     },
     "unit": {
      "enum": [
       "days",
       "weeks",
       "months",
       "sprints"
      ],
      "type": "string"
     }
    },
    "required": [
     "unit"
    ],
    "type": "object"
   },
   "dashboardId": {
    "description": "Target dashboard id",
    "type": "number"
   },
   "description": {
    "description": "Widget title",
    "type": "string"
   },
   "end": {
    "description": "End formula, e.g. \"now()-2d\" (default now())",
    "type": "string"
   },
   "excludedStatuses": {
    "description": "Statuses to exclude",
    "items": {},
    "type": "array"
   },
   "filter": {
    "additionalProperties": {},
    "description": "Issue filter by fields",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "filterId": {
    "description": "Saved filter id",
    "type": "number"
   },
   "fromStatuses": {
    "description": "Status where work starts (excluded from the count)",
    "items": {
     "properties": {
      "key": {
       "type": "string"
      }
     },
     "required": [
      "key"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "includedStatuses": {
    "description": "Statuses to include",
    "items": {},
    "type": "array"
   },
   "lines": {
    "additionalProperties": {},
    "description": "Time axis settings: movingAverage, standardDeviation, percentile, cakePercentile",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "mode": {
    "description": "Chart display mode",
    "enum": [
     "common-lines",
     "common-lines-and-points",
     "status-lines"
    ],
    "type": "string"
   },
   "query": {
    "description": "Issue filter in Tracker query language, e.g. \"Queue: KEY Assignee: me()\"",
    "type": "string"
   },
   "start": {
    "description": "Start formula, e.g. \"now()-2w\" (default 2 years)",
    "type": "string"
   },
   "toStatuses": {
    "description": "Status where work ends",
    "items": {
     "properties": {
      "key": {
       "type": "string"
      }
     },
     "required": [
      "key"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "dashboardId",
   "description"
  ],
  "type": "object"
 },
 "name": "create_cycle_time_widget"
}
