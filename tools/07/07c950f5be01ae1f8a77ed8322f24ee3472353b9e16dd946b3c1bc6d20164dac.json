{"_meta":{"openai/outputTemplate":"ui://zodiacs/readings-v3.html","openai/ui":{"entrypoints":[{"type":"thread"}]},"securitySchemes":[{"type":"noauth"}],"ui":{"resourceUri":"ui://zodiacs/readings-v3.html","visibility":["model","app"]}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Birth chart readout"},"description":"Reads one person's birth chart in the conversation when they have already given their birth date. If they have not, or want to explore it themselves, use open_chart_studio. It gives the Sun, Moon and rising signs, each planet's sign and degree, its house when the birth time and place are known, the closest aspects between the planets (the tightest by orb), and the balance of elements and modes, each with what astrology traditionally reads into it. Add the birth time, the birthplace's time zone and its latitude and longitude only as the person gives them, and never guess a birth time. When they name a town or city instead of coordinates, use find_birthplace first and pass its latitude, longitude and time zone. Without a time it says plainly what is unknown: the rising sign, the houses and, on a day the Moon changed sign, the Moon sign, which it gives as the two possibilities. When the birth time fell in a daylight saving change (a skipped or a repeated hour), timeNote says which instant the chart used; tell the person. If the birth date is under 18, do not frame the chart as romance or attraction. chartUrl opens the birth chart page and does not carry the birth date, time, place or coordinates; give it as the page to open, not as a link that holds their details.","icons":[{"mimeType":"image/svg+xml","sizes":["20x20"],"src":"https://zodiacs.org/assets/ai/readings.svg"}],"inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"birthDate":{"description":"The birth date, such as 1990-05-03 (years 1800 to 2199).","pattern":"^(?:18|19|20|21)\\d{2}-\\d{2}-\\d{2}$","type":"string"},"latitude":{"description":"Optional. The birthplace's latitude; with a birth time it adds the rising sign and the houses. Give it with longitude and zone. Nothing is stored.","maximum":90,"minimum":-90,"type":"number"},"longitude":{"description":"Optional. The birthplace's longitude, with latitude. Nothing is stored.","maximum":180,"minimum":-180,"type":"number"},"place":{"description":"Optional birthplace name, such as Madrid, Spain. Display only: it is not used in the calculation and is not stored.","maxLength":80,"minLength":1,"pattern":"^[^\\u0000-\\u001f\\u007f<>{}[\\]\\\\`]+$","type":"string"},"time":{"description":"The birth time on the local clock, such as 08:30, only if the person knows it. Never guess it. Needs zone.","pattern":"^(?:[01]\\d|2[0-3]):[0-5]\\d$","type":"string"},"zone":{"description":"The birthplace's time zone, such as Europe/Madrid. Needed with a time or a place.","maxLength":64,"minLength":1,"pattern":"^[A-Za-z][A-Za-z0-9_+-]*(?:\\/[A-Za-z0-9_+-]+){0,3}$","type":"string"}},"required":["birthDate"],"type":"object"},"name":"get_natal_chart","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"additionalProperties":false,"properties":{"data":{"additionalProperties":false,"properties":{"angles":{"anyOf":[{"additionalProperties":false,"properties":{"ascendant":{"type":"string"},"midheaven":{"type":"string"}},"required":["ascendant","midheaven"],"type":"object"},{"type":"null"}]},"aspects":{"items":{"additionalProperties":false,"properties":{"a":{"enum":["Sun","Moon","Mercury","Venus","Mars","Jupiter","Saturn","Uranus","Neptune","Pluto"],"type":"string"},"b":{"enum":["Sun","Moon","Mercury","Venus","Mars","Jupiter","Saturn","Uranus","Neptune","Pluto"],"type":"string"},"line":{"type":"string"},"orb":{"minimum":0,"type":"number"},"type":{"enum":["conjunction","sextile","square","trine","opposition"],"type":"string"}},"required":["a","b","type","orb","line"],"type":"object"},"maxItems":8,"type":"array"},"balance":{"additionalProperties":false,"properties":{"elements":{"additionalProperties":false,"properties":{"air":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"earth":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"fire":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"water":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["fire","earth","air","water"],"type":"object"},"lines":{"items":{"type":"string"},"type":"array"},"modalities":{"additionalProperties":false,"properties":{"cardinal":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"fixed":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"mutable":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["cardinal","fixed","mutable"],"type":"object"}},"required":["elements","modalities","lines"],"type":"object"},"birthDate":{"type":"string"},"castFor":{"additionalProperties":false,"properties":{"basis":{"enum":["birth-time","local-noon","utc-noon"],"type":"string"},"utc":{"type":"string"}},"required":["utc","basis"],"type":"object"},"chartUrl":{"format":"uri","type":"string"},"houseSystem":{"anyOf":[{"enum":["whole-sign"],"type":"string"},{"type":"null"}]},"moon":{"additionalProperties":false,"properties":{"meaning":{"type":["string","null"]},"pageUrl":{"anyOf":[{"format":"uri","type":"string"},{"type":"null"}]},"possibleSigns":{"items":{"enum":["aries","taurus","gemini","cancer","leo","virgo","libra","scorpio","sagittarius","capricorn","aquarius","pisces"],"type":"string"},"type":"array"},"sign":{"anyOf":[{"enum":["aries","taurus","gemini","cancer","leo","virgo","libra","scorpio","sagittarius","capricorn","aquarius","pisces"],"type":"string"},{"type":"null"}]}},"required":["sign","possibleSigns","meaning","pageUrl"],"type":"object"},"note":{"const":"Astrology\u2019s reading of a birth chart: tendencies to reflect on, not a prediction or a fixed destiny.","type":"string"},"place":{"type":["string","