{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Create a shareable product-selection link valid for 24 hours from creation. Link expiry does not lock prices; use current merchant catalog prices in RUB. This does not change a personal cart, place an order or pay. Use only items and quantities approved by the user. Never request names, phone numbers or addresses; checkout happens on the merchant site.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"country":{"const":"RU","type":"string"},"products":{"items":{"additionalProperties":false,"properties":{"product_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"qty":{"maximum":40,"minimum":1,"type":"integer"}},"required":["product_id","qty"],"type":"object"},"maxItems":20,"minItems":1,"type":"array"},"region_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"}},"required":["country","region_id","products"],"type":"object"},"name":"cart_link_create"}
