{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search trade shows"
 },
 "description": "Search event series by name, country or vertical. Each row carries edition count, last and next start dates and the largest captured exhibitor count.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "ISO-3166 alpha-2 (TH, DE, JP \u2026).",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "1-based page, 20 rows each.",
    "maximum": 250,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Full-text phrase matched on the event name.",
    "maxLength": 80,
    "type": "string"
   },
   "vertical": {
    "description": "Vertical slug (composites, mice, \u2026).",
    "maxLength": 40,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_events",
 "title": "Search trade shows"
}
