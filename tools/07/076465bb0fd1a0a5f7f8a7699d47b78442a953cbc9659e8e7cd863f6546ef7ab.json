{
 "description": "List work items eligible for this authenticated builder. Defaults to queued and needs_changes items assigned to the registered builder/API key when available.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "sourceAgentEntityId": {
    "description": "Optional source business-agent filter.",
    "type": "string"
   },
   "status": {
    "description": "Statuses to include. Defaults to queued and needs_changes.",
    "items": {
     "enum": [
      "queued",
      "claimed",
      "in_progress",
      "submitted",
      "accepted",
      "needs_changes",
      "closed"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Optional work item type filter.",
    "enum": [
     "build_workflow",
     "fix_workflow",
     "review",
     "summarize",
     "configure",
     "other"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_builder_work_items"
}
