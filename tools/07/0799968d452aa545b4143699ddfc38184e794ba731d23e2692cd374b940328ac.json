{
 "description": "Run the Render cost calculator calculator: Wall area used; Low end of typical 2026 quotes; High end of typical 2026 quotes. Missing inputs fall back to their documented defaults.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "area": {
    "default": 110,
    "description": "Wall area to render",
    "maximum": 1000,
    "minimum": 5,
    "type": "number"
   },
   "houseType": {
    "default": "0",
    "description": "House type (sets a typical wall area)",
    "enum": [
     "0",
     "60",
     "90",
     "110",
     "160"
    ],
    "type": "string"
   },
   "renderType": {
    "default": "monocouche",
    "description": "Render system",
    "enum": [
     "sand_cement",
     "monocouche",
     "silicone"
    ],
    "type": "string"
   },
   "scaffold": {
    "default": "1",
    "description": "Scaffold needed?",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "calculate",
 "title": "Render cost calculator"
}
