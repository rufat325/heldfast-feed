{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Start guest free play, or authenticated free/daily play. Daily mode requires an account token and resumes that account\u2019s current UTC-day attempt.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "accountToken": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "game": {
    "enum": [
     "signal-hunter",
     "circuit-garden",
     "protocol-duel",
     "crate-current",
     "bloom-shift",
     "tidal-atlas"
    ],
    "type": "string"
   },
   "mode": {
    "default": "free",
    "enum": [
     "free",
     "daily"
    ],
    "type": "string"
   },
   "name": {
    "default": "MCP guest",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "game"
  ],
  "type": "object"
 },
 "name": "arcade_start_game",
 "title": "Start a game"
}
