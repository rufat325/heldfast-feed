{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Describe chart type"
 },
 "description": "Return everything an LLM needs to write a .bpc for a given chart type \u2014 typically your second call, after recommend_chart_type. Input: { chartType: \"bar-horizontal\" } (or any canonical/alias name). Returns summary, when-to-use, when-NOT-to-use, full property list with enum choices, data-shape example, and a pointer to a canonical sample.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "chartType": {
    "description": "A chart type or alias to describe, e.g. \"bar-horizontal\" or \"line\".",
    "type": "string"
   }
  },
  "required": [
   "chartType"
  ],
  "type": "object"
 },
 "name": "describe_chart_type",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "aliases": {
    "description": "Accepted alias names.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dataShape": {
    "additionalProperties": false,
    "description": "The data shape this chart type expects.",
    "properties": {
     "example": {
      "description": "Example data block.",
      "type": "string"
     },
     "kind": {
      "description": "Expected data shape.",
      "enum": [
       "single-series",
       "multi-series",
       "unknown"
      ],
      "type": "string"
     }
    },
    "required": [
     "kind",
     "example"
    ],
    "type": "object"
   },
   "directives": {
    "description": "Supported directives.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "description": "What the directive does.",
       "type": "string"
      },
      "name": {
       "description": "Directive name (e.g. highlight, annotation).",
       "type": "string"
      },
      "note": {
       "description": "Caveat or detail.",
       "type": "string"
      },
      "status": {
       "description": "Capability status for this chart type (CapabilityStatus).",
       "enum": [
        "supported",
        "not-implemented",
        "inapplicable"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "status",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "docsUrl": {
    "description": "Public docs URL.",
    "type": "string"
   },
   "exampleSlug": {
    "description": "Id of a canonical sample for this type.",
    "type": "string"
   },
   "name": {
    "description": "Canonical chart-type identifier.",
    "type": "string"
   },
   "properties": {
    "description": "Supported chart properties.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "choices": {
       "description": "Allowed values, for enum properties.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "default": {
       "description": "Default value, if any."
      },
      "description": {
       "description": "What the property does.",
       "type": "string"
      },
      "key": {
       "description": "Property name.",
       "type": "string"
      },
      "type": {
       "description": "Property value type.",
       "type": "string"
      }
     },
     "required": [
      "key",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "description": "One-line description.",
    "type": "string"
   },
   "whenNotToUse": {
    "description": "Situations to avoid it.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "whenToUse": {
    "description": "Situations this chart type fits.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "aliases",
   "summary",
   "whenToUse",
   "whenNotToUse",
   "properties",
   "directives",
   "dataShape"
  ],
  "type": "object"
 }
}
