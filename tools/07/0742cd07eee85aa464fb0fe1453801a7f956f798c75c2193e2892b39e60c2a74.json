 },
 "description": "Find companies and securities issuers by name or UNP; results tag entity_type. Use company uuid for company_get_by_uuid, issuer uuid for share_list/bond_list; linked_company_uuid joins them when known. Example: {\"query\":\"\u0410\u0433\u0440\u043e\u0444\u0438\u043d\u0430\u043d\u0441\"}.",
 "execution": {
  "taskSupport": "forbidden"
 },
