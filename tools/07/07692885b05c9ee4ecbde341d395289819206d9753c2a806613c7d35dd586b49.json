{
 "description": "Update a notification rule. Only provided fields are changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channelTypes": {
    "items": {
     "enum": [
      "IN_APP",
      "EMAIL",
      "SLACK",
      "WEBHOOK",
      "SMS",
      "WEB_PUSH"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "enabled": {
    "type": "boolean"
   },
   "eventTypes": {
    "items": {
     "enum": [
      "INCIDENT_OPENED",
      "INCIDENT_RESOLVED",
      "INCIDENT_ACKNOWLEDGED",
      "FINDING_CREATED",
      "FINDING_RESOLVED",
      "FINDING_ESCALATED",
      "TARGET_DOWN",
      "TARGET_RECOVERED",
      "TEST_FAILED",
      "TEST_RECOVERED",
      "SCAN_COMPLETED",
      "BILLING_LIMIT_REACHED",
      "ACTION_REQUIRED"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "quietHoursEnd": {
    "anyOf": [
     {
      "maximum": 23,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "quietHoursStart": {
    "anyOf": [
     {
      "maximum": 23,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "ruleId": {
    "description": "The notification rule ID",
    "type": "string"
   },
   "severities": {
    "items": {
     "enum": [
      "CRITICAL",
      "WARNING",
      "INFO"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "ruleId"
  ],
  "type": "object"
 },
 "name": "update_notification_rule",
 "title": "Update Notification Rule"
}
