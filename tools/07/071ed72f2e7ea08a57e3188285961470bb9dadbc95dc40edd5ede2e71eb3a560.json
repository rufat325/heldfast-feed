{
 "description": "PREFERRED for any task with 2+ actions. Executes a multi-step pipeline in a SINGLE call \u2014 use this instead of multiple act/fill calls. Example \u2014 post on X: run({steps:[{act:{action:\"navigate\",url:\"https://x.com/compose/post\"}},{wait:{timeout:2000}},{act:{action:\"type\",text:\"Hello world\",role:\"textbox\"}},{act:{action:\"click\",text:\"Post\",role:\"button\"}}]}). Each step is an object with exactly ONE key: page, act, fill, read, wait, or if. Cached for replay. Manage cached workflows: run({manage:\"list\"}) or run({manage:\"delete\", workflow:\"id\"}).",
 "inputSchema": {
  "properties": {
   "description": {
    "description": "Short description for caching",
    "type": "string"
   },
   "manage": {
    "description": "Manage cached workflows: \"list\" shows all, \"delete\" removes a workflow (requires workflow param as ID)",
    "enum": [
     "list",
     "delete"
    ],
    "type": "string"
   },
   "returnAll": {
    "description": "Return results from all steps (default: false)",
    "type": "boolean"
   },
   "steps": {
    "description": "Array of steps. Each step is an object with exactly ONE key: page, act, fill, read, wait, or if.",
    "items": {
     "properties": {
      "act": {
       "description": "Perform an action (click, navigate, scroll, etc.).",
       "properties": {
        "action": {
         "description": "click, navigate, scroll, press, type, hover, etc.",
         "type": "string"
        },
        "direction": {
         "type": "string"
        },
        "key": {
         "type": "string"
        },
        "selector": {
         "type": "string"
        },
        "text": {
         "type": "string"
        },
        "url": {
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "action"
       ],
       "type": "object"
      },
      "fill": {
       "description": "Fill form fields by label.",
       "properties": {
        "fields": {
         "description": "Map of label \u2192 value",
         "type": "object"
        },
        "submit": {
         "description": "true or button text"
        }
       },
       "required": [
        "fields"
       ],
       "type": "object"
      },
      "if": {
       "description": "Conditional branch.",
       "properties": {
        "else": {
         "description": "Step to execute if false",
         "type": "object"
        },
        "text": {
         "description": "Condition: page contains text",
         "type": "string"
        },
        "then": {
         "description": "Step to execute if true",
         "type": "object"
        },
        "url": {
         "description": "Condition: URL contains string",
         "type": "string"
        }
       },
       "type": "object"
      },
      "page": {
       "description": "Describe the page.",
       "properties": {
        "include": {
         "description": "Categories: forms, buttons, links, headings, text, images",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "scope": {
         "description": "CSS selector scope",
         "type": "string"
        }
       },
       "type": "object"
      },
      "read": {
       "description": "Extract structured data.",
       "properties": {
        "fields": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "format": {
         "enum": [
          "text",
          "json"
         ],
         "type": "string"
        },
        "limit": {
         "type": "number"
        },
        "scope": {
         "type": "string"
        },
        "what": {
         "description": "What to extract",
         "type": "string"
        }
       },
       "required": [
        "what"
       ],
       "type": "object"
      },
      "wait": {
       "description": "Wait for a condition (throws on timeout).",
       "properties": {
        "selector": {
         "description": "Wait for CSS selector to match",
         "type": "string"
        },
        "text": {
         "description": "Wait for text to appear",
         "type": "string"
        },
        "timeout": {
         "description": "Timeout in ms (default: 5000)",
         "type": "number"
        },
        "url": {
         "description": "Wait for URL to contain string",
         "type": "string"
        }
       },
       "type": "object"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "tabId": {
    "description": "Target a specific tab by ID (for parallel execution). Omit for active tab.",
    "type": "string"
   },
   "workflow": {
    "description": "Replay a cached workflow by ID",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "run"
}
