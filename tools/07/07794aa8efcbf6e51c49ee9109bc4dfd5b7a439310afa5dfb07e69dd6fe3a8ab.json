{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List all permissions on a file or shared drive. Shows who has access and their role.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fileId": {
    "description": "The ID of the file or shared drive",
    "type": "string"
   },
   "pageSize": {
    "default": 100,
    "description": "Maximum number of permissions to return (1-100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "pageToken": {
    "description": "Token for pagination",
    "type": "string"
   },
   "supportsAllDrives": {
    "default": true,
    "description": "Support shared drives",
    "type": "boolean"
   },
   "useDomainAdminAccess": {
    "default": false,
    "description": "Issue the request as a domain administrator",
    "type": "boolean"
   }
  },
  "required": [
   "fileId"
  ],
  "type": "object"
 },
 "name": "permissions_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "nextPageToken": {
    "type": "string"
   },
   "permissions": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "deleted": {
       "type": "boolean"
      },
      "displayName": {
       "type": "string"
      },
      "domain": {
       "type": "string"
      },
      "emailAddress": {
       "type": "string"
      },
      "expirationTime": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "pendingOwner": {
       "type": "boolean"
      },
      "permissionDetails": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "inherited": {
          "type": "boolean"
         },
         "inheritedFrom": {
          "type": "string"
         },
         "permissionType": {
          "type": "string"
         },
         "role": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "photoLink": {
       "type": "string"
      },
      "role": {
       "enum": [
        "owner",
        "organizer",
        "fileOrganizer",
        "writer",
        "commenter",
        "reader"
       ],
       "type": "string"
      },
      "type": {
       "enum": [
        "user",
        "group",
        "domain",
        "anyone"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "type",
      "role"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "permissions"
  ],
  "type": "object"
 },
 "title": "List permissions"
}
