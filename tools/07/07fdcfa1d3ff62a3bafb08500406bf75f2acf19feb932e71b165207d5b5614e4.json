{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Send campaign proposal"
 },
 "description": "Request a proposal send for a draft campaign the caller's organization owns. Starcovery Proposals runs concierge: this call records one open send request and notifies the Starcovery team, who send the proposals from the staff queue. Nothing is mailed by this call.\n\nNeeds a saved contract whose creator posting date, when set, is today or a later day in UTC, a captured disclosure, and at least one match. Returns a tool error naming the reason when the campaign is not the caller's, a step is missing, a request is already open, or the campaign is already sent. Returns the request row. Needs a credential.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
   "campaignId": {
    "description": "Campaign id from list_campaigns",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "campaignId"
  ],
  "type": "object"
 },
 "name": "send_campaign",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
   "request": {
    "additionalProperties": true,
    "properties": {
     "amountCents": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Null for a send request."
     },
     "campaignId": {
      "type": "string"
     },
     "createdAt": {
      "anyOf": [
       {
        "format": "date-time",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
        "type": "string"
       },
       {
        "format": "date-time",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
        "type": "string"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "fund",
       "send"
      ],
      "type": "string"
     },
     "requestedBy": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "resolvedAt": {
      "anyOf": [
       {
        "anyOf": [
         {
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
          "type": "string"
         },
         {
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
          "type": "string"
         }
        ]
       },
       {
        "type": "null"
       }
      ],
      "description": "Null while the request is open. Set when staff send the campaign."
     }
    },
    "required": [
     "amountCents",
     "campaignId",
     "createdAt",
     "id",
     "kind",
     "requestedBy",
     "resolvedAt"
    ],
    "type": "object"
   }
  },
  "required": [
   "request"
  ],
  "type": "object"
 },
 "title": "Send campaign proposal"
}
