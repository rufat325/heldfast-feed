 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a search alert"
 },
 "description": "Use this when someone wants to be notified about new listings (Suchabo, Benachrichtigung, alerte, avviso): e-mails new matching listings for a place, type, rooms, price and area. Needs their e-mail (or a Heimster sign-in). Starts after the confirmation link; unsubscribe in one click.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "area_min": {
    "type": "integer"
   },
   "category": {
    "enum": [
     "rent",
     "buy",
     "shared_flat",
     "sublet"
    ],
    "type": "string"
   },
   "email": {
    "type": "string"
   },
   "language": {
    "description": "Language of titles, descriptions and links (default de). Use the user's language.",
    "enum": [
     "de",
     "en",
     "fr",
     "it"
    ],
    "type": "string"
   },
   "place": {
    "description": "Municipality, postal code or canton in Switzerland, e.g. \u00abWinterthur\u00bb, \u00ab8004\u00bb, \u00abZH\u00bb.",
    "type": "string"
   },
   "price_max": {
    "type": "integer"
   },
   "property_type": {
    "enum": [
     "apartment",
     "house",
     "commercial",
     "parking",
     "land"
    ],
    "type": "string"
   },
   "rooms_min": {
    "type": "number"
   }
  },
  "required": [
   "place",
   "email"
  ],
  "type": "object"
 },
 "name": "create_search_alert",
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "openid",
    "profile",
    "email"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Create a search alert"
}
