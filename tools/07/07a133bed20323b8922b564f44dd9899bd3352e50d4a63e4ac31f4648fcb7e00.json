{
 "description": "Cancel an invoice",
 "inputSchema": {
  "properties": {
   "invoiceId": {
    "description": "Invoice ID",
    "type": "string"
   },
   "motive": {
    "description": "Cancellation motive (01=with errors, 02=not executed, 03=related, 04=nominative)",
    "enum": [
     "01",
     "02",
     "03",
     "04"
    ],
    "type": "string"
   },
   "substitution": {
    "description": "Substitution invoice ID (required for motive 01)",
    "type": "string"
   }
  },
  "required": [
   "invoiceId",
   "motive"
  ],
  "type": "object"
 },
 "name": "cancel_invoice"
}
