{
 "description": "Search all items by keyword. Best matches first.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "description": "next_cursor from a previous result.",
    "maxLength": 300,
    "type": "string"
   },
   "hive": {
    "description": "Limit to one hive, by slug.",
    "type": "string"
   },
   "max_tokens": {
    "description": "Token budget.",
    "maximum": 20000,
    "minimum": 200,
    "type": "integer"
   },
   "q": {
    "description": "Words to search for.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "hive_search"
}
