{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"\uc8fc\ud0dd\uc218\uc694 \uc2e4\uc801 \uc9c0\uc218"},"description":"\uc2dc\uad70\uad6c\u00b7\uc2dc\ub3c4\u00b7\uc804\uad6d\uc758 \uc8fc\ud0dd\uc218\uc694 \uc2e4\uc801\uc744 \uc5f0\ub3c4\ubcc4(2008~2025, 12\uc6d4 \ub9d0)\ub85c \ub3cc\ub824\uc900\ub2e4 \u2014 \uc778\uad6c\u00b7\uc138\ub300\u00b7\ud3c9\uade0 \uc138\ub300\uc6d0\u00b730~49\uc138 \uc778\uad6c\u00b7\uc5f0\ub839 \uac00\uc911 \uc218\uc694(2015=100 \uc9c0\uc218 \ud3ec\ud568)\uc640 \uc804\ub144 \ub300\ube44 \uc99d\uac00\uc728, \uae30\uac04 \ubcc0\ud654 \uc694\uc57d. \uc9c0\uc5ed\uc758 \uc8fc\ud0dd\uc218\uc694\uac00 \ub298\uc5c8\ub294\uc9c0 \uc904\uc5c8\ub294\uc9c0, \uc138\ub300 \ubd84\ud654(1~2\uc778 \uc138\ub300 \uc99d\uac00) \uc815\ub3c4\ub97c \ubb3c\uc744 \ub54c \uc4f4\ub2e4. \uc9c0\ub09c \uc2e4\uc801\ub9cc \uc8fc\uba70 \uc55e\uc73c\ub85c\uc758 \uc804\ub9dd\u00b7\ub4f1\uae09\uc740 \uc8fc\uc9c0 \uc54a\ub294\ub2e4(\ucd94\uc815 \uae08\uc9c0). \uc74d\uba74\ub3d9 \ub2e8\uc704 \uc790\ub8cc\ub294 \uc5c6\ub2e4. Korean regional housing-demand history (population, households, age-weighted demand).","inputSchema":{"properties":{"from_year":{"anyOf":[{"maximum":2025,"minimum":2008,"type":"integer"},{"type":"null"}],"default":null,"description":"\uc2dc\uc791 \uc5f0\ub3c4(\uae30\ubcf8 2008)","title":"From Year"},"region":{"description":"\uc9c0\uc5ed. \uc608: '\uc11c\uc6b8 \uac15\ub0a8\uad6c', '\uacbd\uae30 \ud654\uc131\uc2dc', '\uacbd\ubd81 \uc758\uc131\uad70', '\uacbd\uae30', '\uc804\uad6d'. \uc774\ub984\uc774 \uacb9\uce58\ub294 \uad6c(\uc911\uad6c\u00b7\ub0a8\uad6c \ub4f1)\ub294 \uc2dc\ub3c4\ub97c \ubd99\uc778\ub2e4","title":"Region","type":"string"},"to_year":{"anyOf":[{"maximum":2025,"minimum":2008,"type":"integer"},{"type":"null"}],"default":null,"description":"\ub05d \uc5f0\ub3c4(\uae30\ubcf8 2025)","title":"To Year"}},"required":["region"],"title":"get_housing_demandArguments","type":"object"},"name":"g