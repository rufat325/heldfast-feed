{"_meta":{"openai/outputTemplate":"ui://hairdora/appointment-detail-v1.html","openai/toolInvocation/invoked":"HairDora appointment ready.","openai/toolInvocation/invoking":"Loading HairDora appointment\u2026","securitySchemes":[{"scopes":["hairdora:read"],"type":"oauth2"}],"ui":{"resourceUri":"ui://hairdora/appointment-detail-v1.html"},"ui/resourceUri":"ui://hairdora/appointment-detail-v1.html"},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get appointment details"},"description":"Use this when someone asks what services a specific appointment includes, their prices, or the appointment's status. Returns one appointment's client, salon and stylist ids, times, status and up to 50 booked services with prices. Not for finding bookings by date.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"appointmentId":{"description":"Id of one appointment, as the appointment list returns it (24 lowercase hex characters)","pattern":"^[0-9a-f]{24}$","type":"string"}},"required":["appointmentId"],"type":"object"},"name":"get_appointment","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"appointment":{"anyOf":[{"additionalProperties":false,"properties":{"clientId":{"anyOf":[{"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"endTime":{"anyOf":[{"maxLength":32,"type":"string"},{"type":"null"}]},"id":{"pattern":"^[0-9a-f]{24}$","type":"string"},"lastEditTime":{"anyOf":[{"maxLength":32,"type":"string"},{"type":"null"}],"description":"Version to pass as expectedLastEditTime when moving or cancelling this appointment"},"providerIds":{"description":"Stylists booked on it, as list_providers ids","items":{"pattern":"^[0-9a-f]{24}$","type":"string"},"maxItems":10,"type":"array"},"salonId":{"anyOf":[{"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"serviceCount":{"maximum":10000,"minimum":0,"type":"integer"},"services":{"items":{"additionalProperties":false,"properties":{"id":{"anyOf":[{"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}],"description":"The service, as list_services and book_appointment name it"},"name":{"maxLength":200,"type":"string"},"price":{"type":["number","null"]}},"required":["id","name","price"],"type":"object"},"maxItems":50,"type":"array"},"servicesTruncated":{"type":"boolean"},"startTime":{"anyOf":[{"maxLength":32,"type":"string"},{"type":"null"}]},"status":{"anyOf":[{"enum":["SCHEDULED","CLIENT_ARRIVED","NO_SHOW","CANCELED"],"type":"string"},{"type":"null"}]}},"required":["id","clientId","salonId","providerIds","startTime","endTime","status","lastEditTime","serviceCount","servicesTruncated","services"],"type":"object"},{"type":"null"}],"description":"One booking with up to 50 booked services and their prices; null when not found. Free-text notes, reminders, contact details, organization data and payment data are excluded."},"status":{"enum":["found","not-found"],"type":"string"}},"required":["status","appointment"],"type":"object"},"title":"Get appointment details"}
