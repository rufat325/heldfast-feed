{
 "_meta": {
  "openai/toolInvocation/invoked": "Reply posted",
  "openai/toolInvocation/invoking": "Replying in the thread\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Reply in an Artifact comment thread"
 },
 "description": "Post a reply in a comment thread as the agent. Allowed only on activated threads (agent_activated true): someone mentioned the agent, or the agent started the thread. People see it as \"Agent \u00b7 via <your name>\".",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "artifact_id": {
    "description": "The Artifact id (art_\u2026).",
    "pattern": "^art_[a-zA-Z0-9]+$",
    "type": "string"
   },
   "body": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "thread_id": {
    "description": "The thread id (thr_\u2026).",
    "pattern": "^thr_[a-zA-Z0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "artifact_id",
   "thread_id",
   "body"
  ],
  "type": "object"
 },
 "name": "reply_to_artifact_thread",
 "outputSchema": {
  "properties": {
   "artifact_id": {
    "type": "string"
   },
   "attachments": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "author": {
    "description": "Who wrote it: { kind: \"user\", uid, name, handle, avatarUrl } or { kind: \"agent\", principal, name, via }.",
    "type": "object"
   },
   "body": {
    "type": "string"
   },
   "created_at": {
    "type": "string"
   },
   "edited_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "mentions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "message_id": {
    "type": "string"
   },
   "reactions": {
    "type": "object"
   },
   "thread_id": {
    "type": "string"
   }
  },
  "required": [
   "message_id",
   "thread_id",
   "author",
   "body",
   "created_at"
  ],
  "type": "object"
 },
 "title": "Reply in an Artifact comment thread"
}
