   "callback_url": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "enable_loop": {
    "description": "Declared type: boolean.",
    "type": "boolean"
   },
   "last_frame_image_url": {
    "description": "Declared type: string.",
