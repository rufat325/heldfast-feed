{
 "description": "Summarize up to 500 bet records with @buzzr/bets-core. Returns the overall rollup, UTC period buckets, maximum drawdown, and win/loss streaks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "americanOdds": {
       "anyOf": [
        {
         "maximum": 100000,
         "minimum": -100000,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "edgePercent": {
       "anyOf": [
        {
         "maximum": 1000000000,
         "minimum": -1000000000,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "externalBetId": {
       "anyOf": [
        {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "externalSource": {
       "anyOf": [
        {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "fairLine": {
       "anyOf": [
        {
         "maximum": 1000000000,
         "minimum": -1000000000,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "gameId": {
       "anyOf": [
        {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "kind": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "league": {
       "anyOf": [
        {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "line": {
       "anyOf": [
        {
         "maximum": 1000000000,
         "minimum": -1000000000,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "market": {
       "anyOf": [
        {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "payout": {
       "anyOf": [
        {
         "maximum": 1000000000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "placedAt": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "potentialPayout": {
       "anyOf": [
        {
         "maximum": 1000000000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "settledAt": {
       "anyOf": [
        {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "side": {
       "anyOf": [
        {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sportsbookSlug": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "stake": {
       "maximum": 1000000000,
       "minimum": 0,
       "type": "number"
      },
      "status": {
       "enum": [
        "draft",
        "pending",
        "won",
        "lost",
        "pushed",
        "void",
        "cashed_out",
        "canceled"
       ],
       "type": "string"
      },
      "userId": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "visibility": {
       "enum": [
        "private",
        "friends",
        "public"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "userId",
      "sportsbookSlug",
      "kind",
      "status",
      "stake",
      "placedAt"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 0,
    "type": "array"
   },
   "period": {
    "enum": [
     "day",
     "week",
     "month"
    ],
    "type": "string"
   }
  },
  "required": [
   "bets"
  ],
  "type": "object"
 },
 "name": "summarize_bet_history",
 "title": "Summarize bet history"
}
