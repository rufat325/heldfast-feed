{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Remove product quantity deltas from the active cart using Voila product UUIDs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "items": {
    "description": "an array of at least 1 item(s)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "productId": {
       "allOf": [
        {
         "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$"
        }
       ],
       "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
       "type": "string"
      },
      "quantity": {
       "description": "a positive number",
       "exclusiveMinimum": 0,
       "title": "greaterThan(0)",
       "type": "integer"
      }
     },
     "required": [
      "productId",
      "quantity"
     ],
     "type": "object"
    },
    "minItems": 1,
    "title": "minItems(1)",
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "voila_remove_cart_items",
 "title": "Remove Cart Items"
}
