{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Archive or delete a local Nuzo memory.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "confirm": {
    "default": false,
    "type": "boolean"
   },
   "expected_revision": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "id": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "mode": {
    "default": "archive",
    "enum": [
     "archive",
     "delete"
    ],
    "type": "string"
   },
   "reason": {
    "maxLength": 1000,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "memory.forget"
}
