{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find restaurants, fuel, groceries, attractions near a location, or search by POI name. POIs carry no ratings \u2014 rank and describe them by what they are and how close they are.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "restaurant",
     "grocery",
     "fuel",
     "chandlery",
     "pharmacy",
     "bank",
     "laundry",
     "entertainment",
     "water",
     "ice",
     "fishing",
     "provisioning",
     "parking",
     "medical",
     "worship",
     "other"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "type": "integer"
   },
   "location": {
    "description": "Location name (fuzzy). Required unless q is provided.",
    "type": "string"
   },
   "location_id": {
    "type": "string"
   },
   "q": {
    "description": "Search POI by name",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_pois",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Find Nearby Points of Interest"
}
