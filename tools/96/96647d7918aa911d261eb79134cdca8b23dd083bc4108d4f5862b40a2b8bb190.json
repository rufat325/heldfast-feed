{
 "description": "Report Gateway route delivery outcome \u2014 POST gateway/track with outcome delivered|not_delivered. Call after pay so Cleared can learn route quality.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "origin": {
    "description": "Merchant origin that was paid",
    "type": "string"
   },
   "outcome": {
    "description": "Whether the paid route delivered usable results",
    "enum": [
     "delivered",
     "not_delivered"
    ],
    "type": "string"
   },
   "requestId": {
    "description": "Gateway request/route id if available",
    "type": "string"
   },
   "source": {
    "description": "Reporter label (default agent_report)",
    "type": "string"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "name": "report_delivery"
}
