{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use this at every stage of an /ios-build run to record the stage and the short status line shown to the user, so RUN_REPORT.md contains the same progress log.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "projectDir": {
    "description": "Absolute path of the app's project folder. Every file the agent writes stays inside it.",
    "minLength": 1,
    "type": "string"
   },
   "stage": {
    "enum": [
     "preflight",
     "planning",
     "creating",
     "capabilities",
     "generating",
     "building",
     "fixing",
     "launching",
     "screenshots",
     "reporting",
     "complete",
     "failed",
     "stopped"
    ],
    "type": "string"
   }
  },
  "required": [
   "projectDir",
   "stage",
   "message"
  ],
  "type": "object"
 },
 "name": "ios_progress",
 "title": "Record a progress line"
}
