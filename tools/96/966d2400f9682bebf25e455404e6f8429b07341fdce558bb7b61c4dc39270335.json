{
 "description": "Rename, reparent, reorder, or set the identity icon ('emoji:<glyph>' | 'lucide:<name>'; null clears) of a page in the canonical job Instructions tab.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirmLive": {
    "const": true,
    "type": "boolean"
   },
   "direction": {
    "enum": [
     "up",
     "down"
    ],
    "type": "string"
   },
   "icon": {
    "anyOf": [
     {
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "pageId": {
    "minLength": 1,
    "type": "string"
   },
   "parentPageId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "preflightToken": {
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "pageId",
   "preflightToken",
   "confirmLive"
  ],
  "type": "object"
 },
 "name": "opentrain_job_instructions_update_page",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
