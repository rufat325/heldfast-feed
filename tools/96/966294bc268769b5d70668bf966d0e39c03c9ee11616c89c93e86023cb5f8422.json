{
 "description": "Read one exact durable routine run and a bounded page of its ordered events.\nThis is read-only and does not run, retry, resume, pause, approve, or send anything.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum events to return (default 100, maximum 200)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "next_token": {
    "description": "Opaque event pagination token",
    "type": "string"
   },
   "routine_id": {
    "description": "Routine ID",
    "type": "string"
   },
   "run_id": {
    "description": "Durable routine run ID returned by trigger_routine",
    "type": "string"
   }
  },
  "required": [
   "routine_id",
   "run_id"
  ],
  "type": "object"
 },
 "name": "get_routine_run"
}
