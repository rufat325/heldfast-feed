{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Disasters and hazards happening now or recently near a place, most severe and most recent first.\n\nWildfires (NASA FIRMS), earthquakes, floods, tropical cyclones, volcanic eruptions and droughts\n(GDACS), US National Weather Service flood, tropical cyclone and fire warnings, and air quality\n(OpenAQ reference monitors), with distance, bearing, severity and time.\nRadius defaults to a sensible distance per event type. At most 25 events are listed; total and\ncounts_by_type cover every event found.\n",
 "inputSchema": {
  "properties": {
   "days": {
    "anyOf": [
     {
      "maximum": 30,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Only events of the last N days",
    "title": "Days"
   },
   "event_types": {
    "anyOf": [
     {
      "items": {
       "enum": [
        "wildfire",
        "earthquake",
        "flood",
        "cyclone",
        "volcano",
        "drought",
        "air_quality"
       ],
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Only these kinds of event",
    "title": "Event Types"
   },
   "latitude": {
    "anyOf": [
     {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Latitude in degrees, WGS84",
    "title": "Latitude"
   },
   "longitude": {
    "anyOf": [
     {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Longitude in degrees, WGS84",
    "title": "Longitude"
   },
   "place": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "A place name or address, used when latitude and longitude are not given",
    "title": "Place"
   },
   "radius_km": {
    "anyOf": [
     {
      "maximum": 500,
      "minimum": 1,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Search radius in km, 1 to 500",
    "title": "Radius Km"
   }
  },
  "title": "get_hazards_nearArguments",
  "type": "object"
 },
 "name": "get_hazards_near",
 "outputSchema": {
  "additionalProperties": true,
  "title": "get_hazards_nearDictOutput",
  "type": "object"
 },
 "title": "Hazard events near a place"
}
