{
 "_meta": {
  "ui": {
   "csp": {
    "resourceDomains": [
     "https://esm.sh",
     "https://media.aiponge.app",
     "https://api.aiponge.app"
    ]
   },
   "resourceUri": "ui://aiponge/books/v5"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read / open a book's text content \u2014 its chapters and the prose of each \u2014 so you can summarize, quote, or discuss it. \"Read me that book\", \"what does the book say?\", \"summarize this book\". Resolve the bookId via browse_books or list_books first. Set chapterOffset and chapterLimit for a bounded chapter read. To LISTEN to it as narrated audio instead, use play_audiobook.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bookId": {
    "description": "The id of the book to read (from browse_books or list_books).",
    "minLength": 1,
    "type": "string"
   },
   "chapterLimit": {
    "description": "Bound the chapters returned. Omit with chapterOffset for the full interactive book.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "chapterOffset": {
    "description": "Zero-based first chapter to read.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "bookId"
  ],
  "type": "object"
 },
 "name": "read_book",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "book": {
    "additionalProperties": false,
    "properties": {
     "author": {
      "type": "string"
     },
     "chapters": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "paragraphs": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "paragraphs"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "coverUrl": {
      "type": "string"
     },
     "subtitle": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "chapters"
    ],
    "type": "object"
   },
   "chapterPage": {
    "additionalProperties": false,
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "nextOffset": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "offset": {
      "type": "number"
     },
     "total": {
      "type": "number"
     }
    },
    "required": [
     "offset",
     "total",
     "hasMore",
     "nextOffset"
    ],
    "type": "object"
   }
  },
  "required": [
   "book"
  ],
  "type": "object"
 },
 "title": "Read a book"
}
