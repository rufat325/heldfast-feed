{
 "description": "Update a discount (partial). code/type/currency become immutable once the discount has been used. Only call after the user confirms.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "enabled": {
    "type": "boolean"
   },
   "endsAt": {
    "description": "ISO date-time",
    "type": "string"
   },
   "idOrSlug": {
    "description": "The discount's id or code to update",
    "minLength": 1,
    "type": "string"
   },
   "maxUses": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "minSubtotal": {
    "type": "number"
   },
   "startsAt": {
    "description": "ISO date-time",
    "type": "string"
   },
   "type": {
    "enum": [
     "percentage",
     "fixed",
     "free_shipping"
    ],
    "type": "string"
   },
   "value": {
    "type": "number"
   }
  },
  "required": [
   "idOrSlug"
  ],
  "type": "object"
 },
 "name": "update_discount"
}
