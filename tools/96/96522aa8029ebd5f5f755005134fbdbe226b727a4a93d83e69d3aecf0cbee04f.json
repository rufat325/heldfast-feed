{
 "description": "Manage Datadog infrastructure hosts. Actions: list (with filters), totals (counts), mute (silence alerts), unmute. Use for: infrastructure inventory, host health, silencing noisy hosts during maintenance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "list",
     "totals",
     "mute",
     "unmute"
    ],
    "type": "string"
   },
   "count": {
    "description": "Number of hosts to return",
    "minimum": 1,
    "type": "number"
   },
   "end": {
    "description": "Mute end timestamp (POSIX). Omit for indefinite mute",
    "type": "number"
   },
   "filter": {
    "description": "Filter hosts by name, alias, or tag (e.g., \"env:prod\")",
    "type": "string"
   },
   "from": {
    "description": "Starting offset for pagination",
    "type": "number"
   },
   "hostName": {
    "description": "Host name (required for mute/unmute)",
    "type": "string"
   },
   "message": {
    "description": "Mute reason message",
    "type": "string"
   },
   "override": {
    "description": "If true, replaces existing mute instead of failing",
    "type": "boolean"
   },
   "sortDir": {
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "sortField": {
    "description": "Field to sort by (e.g., \"apps\", \"cpu\", \"name\")",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "hosts"
}
