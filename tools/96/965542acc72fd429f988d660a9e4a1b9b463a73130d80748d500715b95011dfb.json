{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a calendar with data sources (events from forms). date_title_type: 0=fixed text, 1=from a field. info_window_type: 0=fixed text, 1=from a field.",
 "inputSchema": {
  "properties": {
   "app_id": {
    "description": "Project ID (from list_projects)",
    "type": "string"
   },
   "data_sources": {
    "items": {
     "properties": {
      "date_field_id": {
       "description": "Start date field",
       "type": "string"
      },
      "date_title_field_id": {
       "description": "Field for the event's title",
       "type": "string"
      },
      "date_title_type": {
       "description": "0=fixed text, 1=from a field",
       "type": "integer"
      },
      "end_date_field_id": {
       "description": "End date field (optional)",
       "type": "string"
      },
      "entity_id": {
       "description": "Form ID",
       "type": "string"
      },
      "info_window": {
       "description": "Fixed popup text (if info_window_type=0)",
       "type": "string"
      },
      "info_window_field_id": {
       "description": "Field for the event's details",
       "type": "string"
      },
      "info_window_type": {
       "description": "0=fixed text, 1=from a field",
       "type": "integer"
      },
      "repeat_every_year": {
       "description": "Show the events again every year (birthdays, yearly deadlines)",
       "type": "boolean"
      },
      "repeat_field_id": {
       "description": "A yes/no field of this form: only records where it is yes repeat every year",
       "type": "string"
      },
      "title": {
       "description": "Fixed title (if date_title_type=0)",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Display name",
    "type": "string"
   }
  },
  "required": [
   "app_id",
   "name"
  ],
  "type": "object"
 },
 "name": "create_calendar",
 "securitySchemes": [
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ]
}
