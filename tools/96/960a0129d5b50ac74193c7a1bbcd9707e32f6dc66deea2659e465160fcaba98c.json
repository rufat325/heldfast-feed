{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Inspect the private source snapshot and candidate graph. Lexical search does not use vectors; inspect evidence_embedding_status for the optional sidecar. No durable truth promotion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "evidence_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authority": {
    "const": "candidate-only",
    "type": "string"
   },
   "counts": {
    "additionalProperties": false,
    "properties": {
     "chunks": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "documents": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "edges": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "nodes": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "packets": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "documents",
     "chunks",
     "nodes",
     "edges",
     "packets"
    ],
    "type": "object"
   },
   "generation": {
    "anyOf": [
     {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "index_policy_matches": {
    "type": "boolean"
   },
   "indexed_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "instruction_authority": {
    "const": "none",
    "type": "string"
   },
   "live_freshness": {
    "const": "not-checked-until-reopen",
    "type": "string"
   },
   "policy_hash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "privacy": {
    "const": "local-private-no-export",
    "type": "string"
   },
   "schema_version": {
    "const": "dwin.evidence-index/v1",
    "type": "string"
   },
   "vector_status": {
    "const": "NOT_USED_BY_LEXICAL_SEARCH",
    "type": "string"
   }
  },
  "required": [
   "schema_version",
   "generation",
   "indexed_at",
   "policy_hash",
   "index_policy_matches",
   "counts",
   "privacy",
   "instruction_authority",
   "authority",
   "vector_status",
   "live_freshness"
  ],
  "type": "object"
 }
}
