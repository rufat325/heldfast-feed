{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Explained price moves"
 },
 "description": "Abnormal price moves that MoveSurge detected first and then investigated, each with the cause it found, the evidence, a confidence level and how the move followed through. Use for 'why did oil / the Nasdaq / a stock suddenly move' when no single headline explains it. Only moves whose cause was established with medium or high confidence are published.",
 "inputSchema": {
  "properties": {
   "asset": {
    "description": "Restrict to one instrument symbol, e.g. WTI or NQ.",
    "type": "string"
   },
   "hours": {
    "description": "Look-back window in hours (1-336, default 72).",
    "type": "integer"
   },
   "limit": {
    "description": "Max results (1-50, default 10).",
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "explained_moves",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "moves": {
    "items": {
     "properties": {
      "asset": {
       "type": "string"
      },
      "confidence": {
       "type": "string"
      },
      "direction": {
       "type": "string"
      },
      "driver_category": {
       "type": "string"
      },
      "evidence": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "explanation": {
       "type": "string"
      },
      "follow_through_pct": {
       "description": "Move after 1/5/15/30/60 minutes, percent.",
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "move_pct": {
       "type": [
        "number",
        "null"
       ]
      },
      "published_utc": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "sources": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "window_minutes": {
       "type": [
        "integer",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "window_hours": {
    "type": "integer"
   }
  },
  "required": [
   "count",
   "moves"
  ],
  "type": "object"
 },
 "title": "Explained price moves"
}
