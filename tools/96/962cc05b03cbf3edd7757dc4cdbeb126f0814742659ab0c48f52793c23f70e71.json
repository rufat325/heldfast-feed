{
 "description": "Stack operations: call stack, read raw, get pointers/SEH/comments",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "get_call_stack",
        "type": "string"
       },
       "handle": {
        "description": "Thread handle (hex)",
        "type": "string"
       },
       "max_depth": {
        "default": "50",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "read",
        "type": "string"
       },
       "address": {
        "default": "csp",
        "type": "string"
       },
       "size": {
        "default": "256",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "pointers",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "seh_chain",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "return_address",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "comment",
        "type": "string"
       },
       "address": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "x64dbg_stack"
}
