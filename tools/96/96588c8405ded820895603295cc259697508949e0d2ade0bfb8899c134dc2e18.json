 "description": "Compare two lockfiles and report what a manifest diff cannot see. Reports newly installed transitive packages, resolved version moves with breaking risk, a registry that changed, and the most serious finding available here: the same version with a different integrity hash, meaning the artifact behind a version that was supposed to be immutable is not the one that was there before. Pay 180000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "The same, after the change.",
    "example": {
     "lockfileVersion": 3,
     "packages": {
      "": {
       "name": "orders-api",
       "version": "2.2.0"
      },
      "node_modules/cookie": {
       "integrity": "sha512-TAMPERED",
       "resolved": "https://registry.npmjs.org/cookie/-/cookie-0.5.0.tgz",
       "version": "0.5.0"
      },
      "node_modules/express": {
       "integrity": "sha512-DDDD",
       "resolved": "https://registry.npmjs.org/express/-/express-5.0.0.tgz",
       "version": "5.0.0"
      },
      "node_modules/router": {
       "integrity": "sha512-EEEE",
       "resolved": "https://packages.internal.example/router/-/router-2.0.0.tgz",
       "version": "2.0.0"
      }
     }
    },
    "type": "object"
   },
   "before": {
    "description": "A lockfile as JSON. The v2 and v3 packages map, the older dependencies map, and a flat name-to-version map are all read.",
    "example": {
     "lockfileVersion": 3,
     "packages": {
      "": {
       "name": "orders-api",
       "version": "2.1.0"
      },
      "node_modules/cookie": {
       "integrity": "sha512-BBBB",
       "resolved": "https://registry.npmjs.org/cookie/-/cookie-0.5.0.tgz",
       "version": "0.5.0"
      },
      "node_modules/dropped": {
       "integrity": "sha512-CCCC",
       "resolved": "https://registry.npmjs.org/dropped/-/dropped-1.0.0.tgz",
       "version": "1.0.0"
      },
      "node_modules/express": {
       "integrity": "sha512-AAAA",
       "resolved": "https://registry.npmjs.org/express/-/express-4.18.2.tgz",
       "version": "4.18.2"
      }
     }
    },
    "type": "object"
   },
   "expected_registry": {
    "description": "A URL prefix every package should resolve from. Anything else is reported.",
    "example": "https://registry.npmjs.org/",
    "maxLength": 256,
    "type": "string"
   }
  },
  "required": [
   "before",
   "after"
  ],
  "type": "object"
 },
 "name": "lockfile_change_report",
