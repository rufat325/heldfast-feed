{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Compute a public-safe readiness signal from title, closing, wire, lender-condition, approval, exception, and risk hashes/counts. The tool does not certify readiness to close or fund.","inputSchema":{"properties":{"readiness":{"additionalProperties":false,"properties":{"approval_receipt_hashes":{"items":{"pattern":"^\\s*(?:sha256:)?[0-9a-fA-F]{64}\\s*$","type":"string"},"type":"array"},"closing_pack_hash":{"anyOf":[{"pattern":"^\\s*(?:sha256:)?[0-9a-fA-F]{64}\\s*$","type":"string"},{"type":"null"}]},"critical_risk_count":{"minimum":0,"type":"integer"},"lender_condition_hashes":{"items":{"pattern":"^\\s*(?:sha256:)?[0-9a-fA-F]{64}\\s*$","type":"string"},"type":"array"},"open_condition_count":{"minimum":0,"type":"integer"},"target_milestone":{"enum":["title_clear_to_close","closing","funding","disbursement","post_close"],"type":"string"},"title_evidence_hash":{"anyOf":[{"pattern":"^\\s*(?:sha256:)?[0-9a-fA-F]{64}\\s*$","type":"string"},{"type":"null"}]},"unresolved_exception_count":{"minimum":0,"type":"integer"},"wire_review_hash":{"anyOf":[{"pattern":"^\\s*(?:sha256:)?[0-9a-fA-F]{64}\\s*$","type":"string"},{"type":"null"}]},"workflow_hash":{"pattern":"^\\s*(?:sha256:)?[0-9a-fA-F]{64}\\s*$","type":"string"}},"required":["workflow_hash","target_milestone"],"type":"object"}},"required":["readiness"],"type":"object"},"name":"proofrelay.compute_readiness_signal","outputSchema":{"additionalProperties":true,"title":"compute_readiness_signalDictOutput","type":"object"},"title":"Compute readiness signal"}
