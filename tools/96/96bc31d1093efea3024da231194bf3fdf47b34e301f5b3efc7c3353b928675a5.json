{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Request a new Code Auditor rule. Call lookup_rule or explain_symptom first to confirm no existing rule covers it. Provide a minimal example that should be flagged and a corrected example that should not. Reduce both to the smallest code that shows the difference, and remove secrets and proprietary identifiers. Returns a receipt id.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cleanExample": {
    "items": {
     "properties": {
      "content": {
       "minLength": 1,
       "type": "string"
      },
      "path": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "path",
      "content"
     ],
     "type": "object"
    },
    "maxItems": 6,
    "minItems": 1,
    "type": "array"
   },
   "firingExample": {
    "items": {
     "properties": {
      "content": {
       "minLength": 1,
       "type": "string"
      },
      "path": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "path",
      "content"
     ],
     "type": "object"
    },
    "maxItems": 6,
    "minItems": 1,
    "type": "array"
   },
   "languages": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "signal": {
    "maxLength": 2000,
    "minLength": 40,
    "type": "string"
   },
   "symptom": {
    "maxLength": 2000,
    "minLength": 40,
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "minLength": 10,
    "type": "string"
   },
   "toolVersion": {
    "type": "string"
   }
  },
  "required": [
   "title",
   "symptom",
   "signal",
   "languages",
   "firingExample",
   "cleanExample"
  ],
  "type": "object"
 },
 "name": "request_rule",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "duplicateSubmission": {
    "type": "boolean"
   },
   "existingRuleMatches": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "duplicateSubmission",
   "existingRuleMatches"
  ],
  "type": "object"
 },
 "title": "Request Rule"
}
