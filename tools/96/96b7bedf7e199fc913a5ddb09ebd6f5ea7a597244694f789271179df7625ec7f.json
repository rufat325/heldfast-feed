 "description": "Search bus schedules for the Carretera Austral region via the Coyhaique terminal (unique inventory, hard to find online). Filter by origin, destination, date or free text. Returns origin\u2192destination, date, departure/arrival time, company, operational status and a canonical URL. Use for \"c\u00f3mo llegar a Caleta Tortel\", \"bus Coyhaique a Chait\u00e9n\", \"horarios de bus en la Carretera Austral / Ays\u00e9n / Patagonia\".",
 "inputSchema": {
  "properties": {
   "date": {
    "description": "Date YYYY-MM-DD. Empty = upcoming.",
    "type": "string"
   },
   "destination": {
    "description": "Destination city (e.g. \"Chait\u00e9n\").",
    "type": "string"
   },
   "include_past": {
    "default": false,
    "description": "Include past trips (default false).",
    "type": "boolean"
   },
   "max_results": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset. Use next_offset from a previous response.",
    "minimum": 0,
    "type": "integer"
   },
   "origin": {
    "description": "Origin city (e.g. \"Coyhaique\").",
    "type": "string"
   },
   "query": {
    "description": "Free text (origin, destination or company).",
    "type": "string"
   },
   "response_format": {
    "default": "concise",
    "description": "concise = high-signal fields + canonical URL (token-cheap, default). detailed = full record.",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_bus_schedules",
