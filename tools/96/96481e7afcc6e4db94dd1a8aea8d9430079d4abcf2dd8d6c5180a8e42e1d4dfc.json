{
 "_meta": {
  "openai/outputTemplate": "ui://widget/aviasurf-destinations.html",
  "openai/toolInvocation/invoked": "Aviasurf results ready",
  "openai/toolInvocation/invoking": "Searching Aviasurf\u2026",
  "ui": {
   "resourceUri": "ui://widget/aviasurf-destinations.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Discover indicative destination prices"
 },
 "description": "Find cached indicative fares from an origin and render interactive destination cards, optionally filtered locally by budget, geography, monthly air or water temperature, distance to the coast, island status, elevation, trip-duration suitability, or an Aviasurf destination group. Connect natural user requests to filters: 'mountains' or '\u0432 \u0433\u043e\u0440\u044b' means elevation_min_m; 'weekend getaway' or '\u043d\u0430 \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435' means trip_duration_band=weekend; 'islands' or '\u043d\u0430 \u043e\u0441\u0442\u0440\u043e\u0432\u0430' means island=true; 'where can I swim?' or '\u0433\u0434\u0435 \u043a\u0443\u043f\u0430\u0442\u044c\u0441\u044f' means month plus water_temp_min. Prices are per adult. Temperature filters require month. Missing water data excludes a destination only when water_temp_min is requested. Historical significance, when present, is explicitly a sparse model estimate, not a measured fact. Always link the returned search_url from a short label in the answer language, for example \"Check live prices on Aviasurf\"; never paste the raw URL as text. Use group=russia explicitly for Russian domestic destinations.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "air_temp_min": {
    "description": "Minimum monthly air temperature in degrees Celsius. Requires month and excludes destinations without air-temperature data.",
    "maximum": 60,
    "minimum": -80,
    "type": "number"
   },
   "budget_max": {
    "description": "Maximum indicative price, applied locally.",
    "minimum": 1,
    "type": "integer"
   },
   "continent": {
    "description": "Seven-continent destination code, applied locally.",
    "enum": [
     "AF",
     "AN",
     "AS",
     "EU",
     "NA",
     "OC",
     "SA"
    ],
    "type": "string"
   },
   "country": {
    "description": "Two-letter destination country filter, applied locally.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "currency": {
    "description": "Three-letter output currency. Set it only when the user explicitly requests a currency; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "direct": {
    "default": false,
    "description": "Request nonstop observations only.",
    "type": "boolean"
   },
   "elevation_min_m": {
    "description": "Minimum destination elevation above sea level in metres, applied locally. Use for mountain or high-altitude requests such as 'I want to go to the mountains' or '\u0445\u043e\u0447\u0443 \u0432 \u0433\u043e\u0440\u044b'.",
    "maximum": 9000,
    "minimum": -500,
    "type": "number"
   },
   "group": {
    "description": "Curated destination group, applied locally. asia: cities in selected Asian countries. schengen: cities in the Schengen area. russia: domestic Russian destinations. Use the separate measured coast, monthly temperature, island, and elevation filters for those traits; do not infer unsupported themes.",
    "enum": [
     "asia",
     "schengen",
     "russia"
    ],
    "type": "string"
   },
   "island": {
    "default": false,
    "description": "When true, return tourist island destinations rather than dense urban island districts or continent-sized landmasses. Use for requests such as 'take me to an island' or '\u043a\u0443\u0434\u0430 \u043d\u0430 \u043e\u0441\u0442\u0440\u043e\u0432\u0430'.",
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of destinations to return, applied locally.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "en",
    "description": "Language locale for reference names and response text.",
    "pattern": "^[A-Za-z]{2}(?:-[A-Za-z]{2})?$",
    "type": "string"
   },
   "market": {
    "description": "Two-letter country market. Set it only when the user explicitly requests a country market or local Aviasurf site; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "max_coast_distance_km": {
    "description": "Maximum destination-city distance to the coast in kilometres, applied locally from the Aviasurf destination knowledge base.",
    "minimum": 0,
    "type": "number"
   },
   "month": {
    "description": "Optional departure month.",
    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
    "type": "string"
   },
   "origin": {
    "description": "Origin city or airport IATA code.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "sort": {
    "default": "price",
    "description": "Sort by indicative price or preserve upstream popularity order.",
    "enum": [
     "price",
     "popularity"
    ],
    "type": "string"
   },
   "subregion": {
    "description": "UN M49 destination subregion in lowercase snake_case, applied locally.",
    "enum": [
     "antarctica",
     "australia_and_new_zealand",
     "caribbean",
     "central_america",
     "central_asia",
     "eastern_africa",
     "eastern_asia",
     "eastern_europe",
     "melanesia",
     "micronesia",
     "middle_africa",
     "northern_africa",
     "northern_america",
     "northern_europe",
     "polynesia",
     "south_america",
     "south_eastern_asia",
     "southern_africa",
     "southern_asia",
     "southern_europe",
     "western_africa",
     "western_asia",
     "western_europe"
    ],
    "type": "string"
   },
   "trip_duration_band": {
    "description": "Route-suitability band from the destination knowledge base. Use weekend for requests such as 'weekend getaway' or '\u043a\u0443\u0434\u0430 \u043d\u0430 \u0432\u044b\u0445\u043e\u0434\u043d\u044b\u0435'; use the other bands for an explicitly requested trip length.",
    "enum": [
     "day_trip",
     "weekend",
     "short_trip",
     "week",
     "extended_stay"
    ],
    "type": "string"
   },
   "water_temp_min": {
    "description": "Minimum monthly water temperature in degrees Celsius. Use with month for requests such as 'where can I swim?' or '\u0433\u0434\u0435 \u043c\u043e\u0436\u043d\u043e \u043a\u0443\u043f\u0430\u0442\u044c\u0441\u044f'; destinations without water data are excluded.",
    "maximum": 40,
    "minimum": -5,
    "type": "number"
   }
  },
  "required": [
   "origin"
  ],
  "type": "object"
 },
