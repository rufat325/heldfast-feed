{
 "description": "Create a new Object Storage bucket",
 "inputSchema": {
  "properties": {
   "bucket_name": {
    "description": "Name for the new bucket",
    "type": "string"
   },
   "compartment_id": {
    "description": "Compartment OCID (defaults to tenancy)",
    "type": "string"
   },
   "public_access": {
    "default": "NoPublicAccess",
    "enum": [
     "NoPublicAccess",
     "ObjectRead",
     "ObjectReadWithoutList"
    ],
    "type": "string"
   },
   "storage_tier": {
    "default": "Standard",
    "enum": [
     "Standard",
     "Archive"
    ],
    "type": "string"
   }
  },
  "required": [
   "bucket_name"
  ],
  "type": "object"
 },
 "name": "oci_os_create_bucket"
}
