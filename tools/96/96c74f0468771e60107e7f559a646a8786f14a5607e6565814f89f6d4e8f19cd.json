{
 "description": "Switch a USB-connected device to TCP/IP mode on the specified port (default 5555). After this, you can disconnect USB and use adb_connect.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial (must be USB-connected)",
    "type": "string"
   },
   "port": {
    "default": 5555,
    "description": "TCP port for ADB (1-65535, default 5555)",
    "maximum": 65535,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "adb_tcpip"
}
