{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new draft email. The draft can be edited and sent later from Gmail.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attachments": {
    "description": "Optional file attachments (base64-encoded)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "description": "Base64-encoded file data",
       "type": "string"
      },
      "filename": {
       "description": "Attachment filename",
       "pattern": "^[^\\r\\n]*$",
       "type": "string"
      },
      "mimeType": {
       "description": "MIME type (e.g., application/pdf)",
       "pattern": "^[^\\r\\n]*$",
       "type": "string"
      }
     },
     "required": [
      "filename",
      "mimeType",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bcc": {
    "description": "BCC recipients, comma-separated",
    "type": "string"
   },
   "body": {
    "description": "Email body (plain text). Used as the plain-text alternative when htmlBody is also provided.",
    "type": "string"
   },
   "cc": {
    "description": "CC recipients, comma-separated",
    "type": "string"
   },
   "from": {
    "description": "Sender email address (for send-as aliases)",
    "type": "string"
   },
   "htmlBody": {
    "description": "Optional HTML body. When set alongside body, the draft is multipart/alternative; when set alone, text/html.",
    "type": "string"
   },
   "inReplyTo": {
    "description": "Message-ID header of the message being replied to",
    "type": "string"
   },
   "subject": {
    "description": "Email subject",
    "type": "string"
   },
   "threadId": {
    "description": "Thread ID if this is a reply draft",
    "type": "string"
   },
   "to": {
    "description": "Recipient email address(es), comma-separated for multiple",
    "type": "string"
   }
  },
  "required": [
   "to",
   "subject",
   "body"
  ],
  "type": "object"
 },
 "name": "draft_create",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "message": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "labelIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "threadId": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "threadId"
    ],
    "type": "object"
   }
  },
  "required": [
   "id",
   "message"
  ],
  "type": "object"
 },
 "title": "Create draft"
}
