{
 "description": "Place a trailing-then-TWAP order. When trail triggers, execute via TWAP. action: trailing_twap_sell|trailing_twap_buy.",
 "inputSchema": {
  "properties": {
   "action": {
    "enum": [
     "trailing_twap_sell",
     "trailing_twap_buy"
    ],
    "type": "string"
   },
   "amount": {
    "description": "Lamports (buy) or raw token units (sell)",
    "type": "integer"
   },
   "duration": {
    "minimum": 60,
    "type": "integer"
   },
   "expiry_hours": {
    "default": 144,
    "maximum": 336,
    "minimum": 1,
    "type": "integer"
   },
   "frequency": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "holdings_percentage": {
    "description": "Sell only: bps",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "slippage": {
    "default": 500,
    "maximum": 2500,
    "minimum": 100,
    "type": "integer"
   },
   "token_address": {
    "type": "string"
   },
   "trail": {
    "description": "Trail bps",
    "minimum": 1,
    "type": "integer"
   },
   "wallet_address": {
    "type": "string"
   }
  },
  "required": [
   "wallet_address",
   "token_address",
   "action",
   "trail",
   "frequency",
   "duration"
  ],
  "type": "object"
 },
 "name": "place_trailing_twap_order"
}
