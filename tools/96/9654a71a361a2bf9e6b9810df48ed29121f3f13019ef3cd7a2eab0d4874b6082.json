{
 "description": "Import contacts from a JSON array. Parses, deduplicates against existing contacts, and inserts new ones. Returns import summary with counts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contacts": {
    "description": "Array of contacts to import (max 100)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "email": {
       "description": "Email address (required)",
       "type": "string"
      },
      "genres": {
       "description": "Music genres",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "description": "Contact name",
       "type": "string"
      },
      "notes": {
       "description": "Free-text notes",
       "type": "string"
      },
      "outlet": {
       "description": "Station, publication, or company",
       "type": "string"
      },
      "platform_type": {
       "description": "Contact platform type",
       "enum": [
        "radio",
        "press",
        "playlist",
        "tv",
        "online",
        "other"
       ],
       "type": "string"
      },
      "role": {
       "description": "Job title or role",
       "type": "string"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "contacts"
  ],
  "type": "object"
 },
 "name": "tap_batch_import"
}
