      "description": "Output format for content generation.",
      "enum": [
       "blog_post",
       "landing_page",
       "linkedin_post",
       "linkedin_article",
       "twitter_post",
       "twitter_thread",
       "newsletter",
       "video_script",
       "podcast_outline",
       "case_study",
       "whitepaper",
       "ebook",
       "infographic",
       "webinar",
       "email_sequence"
      ],
