{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submits a parts list for a wholesale quote and returns an rfq_id. Poll get_quote(rfq_id) until status is 'ready'; the priced quote is also emailed to buyer_email. Non-binding; no charge occurs at this step.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account_number": {
    "description": "Existing Cintra account_number from a prior request, to be recognized as a repeat customer",
    "maxLength": 80,
    "type": "string"
   },
   "buyer_email": {
    "description": "Email to receive the quote and order records",
    "format": "email",
    "type": "string"
   },
   "company": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "contact_name": {
    "maxLength": 200,
    "type": "string"
   },
   "context": {
    "description": "Project, application, or delivery context",
    "maxLength": 2000,
    "type": "string"
   },
   "lines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "alternates_allowed": {
       "default": false,
       "description": "Whether Cintra may propose clearly labeled alternatives",
       "type": "boolean"
      },
      "description": {
       "description": "Product description or specification",
       "maxLength": 1000,
       "minLength": 2,
       "type": "string"
      },
      "manufacturer": {
       "description": "Requested manufacturer, when specified",
       "maxLength": 200,
       "type": "string"
      },
      "notes": {
       "maxLength": 1000,
       "type": "string"
      },
      "part_number": {
       "description": "Manufacturer part number, SKU, NSN, or catalog number",
       "maxLength": 200,
       "type": "string"
      },
      "quantity": {
       "description": "Requested quantity",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "unit": {
       "description": "Unit of measure, such as each, case, box, ft, or roll",
       "maxLength": 40,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "quantity",
      "unit",
      "description"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "needed_by": {
    "maxLength": 40,
    "type": "string"
   },
   "ship_to_zip": {
    "maxLength": 10,
    "type": "string"
   }
  },
  "required": [
   "lines",
   "buyer_email"
  ],
  "type": "object"
 },
 "name": "submit_rfq",
 "title": "Submit a request for quote"
}
