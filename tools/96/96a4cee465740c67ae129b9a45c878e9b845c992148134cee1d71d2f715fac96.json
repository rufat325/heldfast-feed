{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Fetch a modular snapshot for one exact ETF listing. The include array controls which of identity, classification, market, fund_data (NAV/AUM), costs, income, and benchmark are fetched and returned. Unrequested modules are omitted; requested-but-unavailable modules are named explicitly. Ratios use percentage points. Read-only. Successful results include an optional platformLink for continuing this research or reviewing the exact saved draft in Bullrun. When useful, present its descriptive link and respect its description of any settings not carried over.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "include": {
    "default": [
     "identity",
     "classification",
     "market",
     "costs"
    ],
    "description": "Only these snapshot modules are fetched and returned. Default: identity, classification, market, costs.",
    "items": {
     "enum": [
      "identity",
      "classification",
      "market",
      "fund_data",
      "costs",
      "income",
      "benchmark"
     ],
     "type": "string"
    },
    "maxItems": 7,
    "minItems": 1,
    "type": "array"
   },
   "ticker": {
    "description": "Exact Bullrun ETF listing ticker, including its exchange suffix when present, e.g. SPY, VWRL.L, or EUNL.DE.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "get_etf_snapshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asOf": {
    "additionalProperties": {},
    "type": "object"
   },
   "availableModules": {
    "items": {
     "$ref": "#/properties/requestedModules/items"
    },
    "type": "array"
   },
   "dataQuality": {
    "additionalProperties": {},
    "type": "object"
   },
   "found": {
    "type": "boolean"
   },
   "missingModules": {
    "items": {
     "$ref": "#/properties/requestedModules/items"
    },
    "type": "array"
   },
   "modules": {
    "additionalProperties": {},
    "type": "object"
   },
   "platformLink": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "label",
     "url",
     "description"
    ],
    "type": "object"
   },
   "requestedModules": {
    "items": {
     "enum": [
      "identity",
      "classification",
      "market",
      "fund_data",
      "costs",
      "income",
      "benchmark"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "ticker": {
    "type": "string"
   },
   "webPage": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "ticker",
   "found",
   "requestedModules",
   "availableModules",
   "missingModules",
   "modules",
   "asOf",
   "dataQuality"
  ],
  "type": "object"
 },
 "title": "Get ETF snapshot"
}
