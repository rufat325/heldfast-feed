{
 "description": "Bulk-update selected product records with a single patch (status, set/adjust stock, set/adjust price). Stock is units; price is minor units. Only call after the user confirms.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "modelId": {
    "description": "Product model id",
    "minLength": 1,
    "type": "string"
   },
   "patch": {
    "description": "Single patch applied to every selected record",
    "properties": {
     "adjustPrice": {
      "description": "Delta to price (minor units, +/-)",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "adjustStock": {
      "description": "Delta to stock (+/-)",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "setPrice": {
      "description": "Set absolute price (minor units)",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "setStock": {
      "description": "Set absolute stock",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "status": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "selection": {
    "properties": {
     "allMatching": {
      "description": "Target every record matching filter (ignores ids)",
      "type": "boolean"
     },
     "filter": {
      "properties": {
       "hasVariants": {
        "type": "boolean"
       },
       "priceMax": {
        "type": "number"
       },
       "priceMin": {
        "type": "number"
       },
       "search": {
        "type": "string"
       },
       "status": {
        "type": "string"
       },
       "stockState": {
        "enum": [
         "in",
         "low",
         "out"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "ids": {
      "description": "Explicit record ids",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "modelId",
   "selection",
   "patch"
  ],
  "type": "object"
 },
 "name": "bulk_update_products"
}
