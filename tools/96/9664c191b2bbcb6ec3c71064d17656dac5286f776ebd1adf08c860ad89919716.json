{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Enterprise-gated. Register a self-hosted Gateway deployment when onboarding a new control-plane target; use list_deployments for existing registrations. The response can contain authentication and registry credentials exactly once, exposed to this MCP transcript, so store them securely immediately and never log them. Enterprise-gated. Returns 403 on non-Enterprise Portkey plans.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "deployment_config": {
    "additionalProperties": {},
    "description": "Gateway deployment configuration",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "gateway_base_url": {
    "description": "Self-hosted Gateway base URL",
    "format": "uri",
    "type": "string"
   },
   "is_dataservice_hosted": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     }
    ],
    "description": "Whether the deployment hosts its own data service"
   },
   "is_default": {
    "description": "Make this the default deployment",
    "type": "boolean"
   },
   "is_playground_proxy_allowed": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     }
    ],
    "description": "Whether Playground proxy traffic is allowed"
   },
   "jwt_sub_workspace_mapping": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "JWT subject to workspace-slug mapping",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "jwt_subs_allowed": {
    "description": "JWT subject values allowed to use the deployment",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "mcp_gateway_base_url": {
    "description": "MCP Gateway base URL",
    "format": "uri",
    "type": "string"
   },
   "name": {
    "description": "Deployment display name",
    "minLength": 1,
    "type": "string"
   },
   "organisation_id": {
    "description": "Owning organisation UUID",
    "type": "string"
   },
   "slug": {
    "description": "Optional deployment slug",
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "anyOf": [
     {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "pattern": "^[a-zA-Z0-9_-]+$",
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Deployment tags, or null to create without tags"
   },
   "type": {
    "description": "Production or non-production deployment type",
    "enum": [
     "production",
     "non_production"
    ],
    "type": "string"
   },
   "workspaces_allowed": {
    "description": "Workspace slugs this deployment may serve; empty allows all",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "register_deployment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
