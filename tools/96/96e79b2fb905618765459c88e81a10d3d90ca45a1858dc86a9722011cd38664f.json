{
 "annotations": {
  "readOnlyHint": true,
  "title": "List appointment slots"
 },
 "description": "Find bookable appointment start times across providers/locations for a date range. High-value for scheduling. GET /appointment_slots.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "days": {
    "description": "Number of days from start_date to search.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "lids": {
    "description": "Location ids (sent as lids[]=...).",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "overlapping_operatory_slots": {
    "description": "Allow overlapping operatory slots.",
    "type": "boolean"
   },
   "pids": {
    "description": "Provider ids (sent as pids[]=...).",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "slot_length": {
    "description": "Desired slot length in minutes.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "start_date": {
    "description": "First day to search, yyyy-mm-dd (REQUIRED).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "subdomain": {
    "description": "Institution subdomain. Defaults to NEXHEALTH_SUBDOMAIN if unset.",
    "type": "string"
   }
  },
  "required": [
   "start_date"
  ],
  "type": "object"
 },
 "name": "nexhealth_list_appointment_slots",
 "title": "List appointment slots"
}
