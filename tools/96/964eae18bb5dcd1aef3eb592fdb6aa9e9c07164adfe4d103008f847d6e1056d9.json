{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new KadiConnect account with a name, email and password, and receive an API key (starts with kc_). Use this only when the user wants a new account; if they already have an API key, use that instead. The key is shown once: tell the user to store it securely. Subsequent tools need it as an Authorization header or the apiKey argument.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "email": {
    "description": "The account owner's email address",
    "format": "email",
    "type": "string"
   },
   "name": {
    "description": "The account owner's full name",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "password": {
    "description": "Password for the new account (minimum 8 characters)",
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "name",
   "email",
   "password"
  ],
  "type": "object"
 },
 "name": "register",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiKey": {
    "type": "string"
   },
   "next": {
    "type": "string"
   },
   "user": {
    "additionalProperties": false,
    "properties": {
     "email": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "email"
    ],
    "type": "object"
   }
  },
  "required": [
   "user",
   "apiKey",
   "next"
  ],
  "type": "object"
 },
 "title": "Create a KadiConnect account"
}
