{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a platform's requirements"
 },
 "description": "Returns what one platform requires before it lists an MCP connector or plugin, each requirement with its sources, evidence label and the date it was last checked. Narrow the list to one topic (category) or one product surface. Platforms: claude (Claude), chatgpt (ChatGPT), cursor (Cursor), mcp-registry (MCP Registry), ecosystem (MCP specification).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Only requirements on this topic.",
    "enum": [
     "submission",
     "eligibility",
     "tiers",
     "analytics",
     "extensions",
     "auth",
     "rules",
     "limits",
     "distribution",
     "protocol"
    ],
    "type": "string"
   },
   "platform": {
    "description": "The platform id.",
    "enum": [
     "claude",
     "chatgpt",
     "cursor",
     "mcp-registry",
     "ecosystem"
    ],
    "type": "string"
   },
   "productSurface": {
    "description": "Only requirements that hold for this product surface, e.g. claude-connectors or claude-plugins.",
    "enum": [
     "claude-connectors",
     "claude-plugins",
     "chatgpt",
     "codex",
     "cursor-marketplace",
     "mcp-registry"
    ],
    "type": "string"
   }
  },
  "required": [
   "platform"
  ],
  "type": "object"
 },
 "name": "get_platform_requirements",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "citation": {
    "additionalProperties": false,
    "properties": {
     "attribution": {
      "type": "string"
     },
     "dataset": {
      "type": "string"
     },
     "dateModified": {
      "type": "string"
     },
     "license": {
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "url"
      ],
      "type": "object"
     },
     "schemaVersion": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "dataset",
     "schemaVersion",
     "dateModified",
     "license",
     "attribution",
     "url"
    ],
    "type": "object"
   },
   "platform": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "minLength": 1,
        "type": "string"
       },
       "name": {
        "minLength": 1,
        "type": "string"
       },
       "surfaceName": {
        "minLength": 1,
        "type": "string"
       },
       "url": {
        "format": "uri",
        "type": "string"
       },
       "vendor": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "vendor",
       "surfaceName",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "requirements": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "minLength": 1,
       "type": "string"
      },
      "categoryLabel": {
       "minLength": 1,
       "type": "string"
      },
      "conflictNote": {
       "minLength": 1,
       "type": "string"
      },
      "evidence": {
       "minLength": 1,
       "type": "string"
      },
      "id": {
       "minLength": 1,
       "type": "string"
      },
      "platform": {
       "minLength": 1,
       "type": "string"
      },
      "productSurface": {
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "type": "array"
      },
      "sourceKind": {
       "minLength": 1,
       "type": "string"
      },
      "sources": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "accessed": {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
         },
         "label": {
          "minLength": 1,
          "type": "string"
         },
         "url": {
          "format": "uri",
          "type": "string"
         }
        },
        "required": [
         "label",
         "url",
         "accessed"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      },
      "status": {
       "enum": [
        "verified",
        "conflict"
       ],
       "type": "string"
      },
      "text": {
       "minLength": 1,
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      },
      "verifiedAt": {
       "format": "date",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
       "type": "string"
      },
      "verifiedBy": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "id",
      "platform",
      "productSurface",
      "category",
      "categoryLabel",
      "text",
      "evidence",
      "sourceKind",
      "sources",
      "status",
      "verifiedAt",
      "verifiedBy",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "platform",
   "requirements",
   "citation"
  ],
  "type": "object"
 },
 "title": "Get a platform's requirements"
}
