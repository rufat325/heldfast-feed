{
 "description": "Execute the full governance 360 loop on HTML content: extract governance block \u2192 verify signature + content hash \u2192 check usage terms \u2192 create signed access receipt. This is what an agent calls on every page it reads.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentPrivateKey": {
    "description": "Your agent's Ed25519 private key (hex)",
    "type": "string"
   },
   "agentPublicKey": {
    "description": "Your agent's Ed25519 public key (hex)",
    "type": "string"
   },
   "contentBody": {
    "description": "Article text content (for hash verification)",
    "type": "string"
   },
   "html": {
    "description": "Full HTML of the page",
    "type": "string"
   },
   "intendedUsage": {
    "enum": [
     "inference",
     "training",
     "redistribution",
     "derivative",
     "caching"
    ],
    "type": "string"
   },
   "publisherPublicKey": {
    "description": "Publisher's Ed25519 public key (hex)",
    "type": "string"
   },
   "sourceUrl": {
    "description": "URL of the page",
    "type": "string"
   }
  },
  "required": [
   "html",
   "contentBody",
   "publisherPublicKey",
   "agentPublicKey",
   "agentPrivateKey",
   "intendedUsage",
   "sourceUrl"
  ],
  "type": "object"
 },
 "name": "governance_360"
}
