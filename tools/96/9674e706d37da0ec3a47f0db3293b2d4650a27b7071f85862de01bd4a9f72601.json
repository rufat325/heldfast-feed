{
 "description": "Create a folder for organizing test suites. Folders can be nested via parentId.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Folder name",
    "type": "string"
   },
   "ordering": {
    "default": 0,
    "description": "Sort order",
    "type": "number"
   },
   "parentId": {
    "default": 0,
    "description": "Parent folder ID (0 for root)",
    "type": "number"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_suite_folder"
}
