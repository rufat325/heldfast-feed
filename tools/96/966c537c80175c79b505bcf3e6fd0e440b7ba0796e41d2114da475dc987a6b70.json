{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Publish a seller document"
 },
 "description": "Publish (or update) a document into the marketplace. The content is chunked + embedded + indexed by a background worker; status moves from `pending` to `indexed` once that completes. Re-publishing the same external_doc_id replaces the prior version. Account must be status='active' for the worker to index; pending_review accounts queue indefinitely.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "Document text. Up to ~2 MB.",
    "type": "string"
   },
   "doc_type": {
    "type": "string"
   },
   "external_doc_id": {
    "type": "string"
   },
   "license": {
    "type": "string"
   },
   "metadata": {
    "additionalProperties": true,
    "type": "object"
   },
   "seller_api_key": {
    "description": "Your seller API key (aether_sk_\u2026).",
    "type": "string"
   },
   "source_url": {
    "type": "string"
   },
   "ticker_coverage": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "seller_api_key",
   "external_doc_id",
   "content"
  ],
  "type": "object"
 },
 "name": "seller_publish_document",
 "outputSchema": {
  "properties": {
   "document_id": {
    "type": "integer"
   },
   "external_doc_id": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "published_at": {
    "type": "string"
   },
   "status": {
    "description": "pending until the index worker completes",
    "type": "string"
   }
  },
  "required": [
   "document_id",
   "external_doc_id",
   "status"
  ],
  "type": "object"
 },
 "x_aether_auth": {
  "kind": "seller_bearer_required",
  "reason": "post-signup seller management; requires seller_api_key bearer forwarded to /v1/seller/documents"
 }
}
