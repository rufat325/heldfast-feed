  "properties": {
   "chain": {
    "enum": [
     "base",
     "base-sepolia"
    ],
    "type": "string"
   },
   "data": {
    "maxLength": 131074,
    "pattern": "^0x(?:[a-fA-F0-9]{2})*$",
    "type": "string"
   },
   "from": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "to": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "value": {
    "maxLength": 78,
    "pattern": "^(?:0|[1-9]\\d*)$",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "from",
   "to",
   "value",
   "data"
  ],
  "type": "object"
 },
