{
 "description": "Create a new webhook that triggers a job when called",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "enabled": {
    "description": "Enable the webhook (default true)",
    "type": "boolean"
   },
   "jobId": {
    "description": "Job UUID to trigger",
    "type": "string"
   },
   "name": {
    "description": "Webhook display name",
    "type": "string"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "roles": {
    "description": "Authorization roles (comma-separated)",
    "type": "string"
   }
  },
  "required": [
   "project",
   "name",
   "jobId"
  ],
  "type": "object"
 },
 "name": "rundeck_create_webhook"
}
