{
 "_meta": {
  "openai/outputTemplate": "ui://pollar/explainer-v1.html",
  "openai/toolInvocation/invoked": "Explainer ready.",
  "openai/toolInvocation/invoking": "Opening the explainer.",
  "ui": {
   "resourceUri": "ui://pollar/explainer-v1.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a Pollar explainer"
 },
 "description": "Fetches the explainer for one news event by its event slug (from list_explainers, or get_event when its explainer field is set). Returns the question it answers, the narration beat by beat, and each beat's visual data: a map with places and coordinates, a dated timeline (entries marked next are what comes next), a key figure with its source, a bar chart, or a quote. Suited to questions about why a story matters. Returns a canonical pollar.news url.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "pl",
     "de",
     "fr"
    ],
    "type": "string"
   },
   "slug": {
    "description": "Event slug (per-locale)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_explainer",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audioUrl": {
    "format": "uri",
    "type": "string"
   },
   "beats": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "index": {
       "type": "number"
      },
      "narration": {
       "type": "string"
      },
      "visual": {
       "anyOf": [
        {
         "additionalProperties": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "index",
      "narration",
      "visual"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "durationS": {
    "type": "number"
   },
   "eventSlug": {
    "type": "string"
   },
   "eventTitle": {
    "type": "string"
   },
   "locale": {
    "enum": [
     "en",
     "pl",
     "de",
     "fr"
    ],
    "type": "string"
   },
   "question": {
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "locale",
   "question",
   "eventSlug",
   "eventTitle",
   "url",
   "audioUrl",
   "durationS",
   "beats"
  ],
  "type": "object"
 },
 "title": "Get a Pollar explainer"
}
