  "title": "Complete Billing"
 },
 "description": "Complete the tenant's billing details: legal-entity name and type, VAT id,\ninvoice address, invoice email and optional PO reference. Call this when the\nowner or a billing contact has the details. EU VAT ids are validated against\nVIES by the worker; a failed operation with `billing.vat_check_unavailable`\ncan be retried by submitting again. Returns `202` with an operation to poll.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "authorization": {
    "type": "string"
   },
   "body": {
    "default": "",
    "description": "`complete_billing` body. `vat_id` is checked against the tenant's country in the service.",
    "properties": {
     "address_line1": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "address_line2": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "city": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "invoice_email": {
      "format": "email",
      "type": "string"
     },
     "legal_entity_type": {
      "anyOf": [
       {
        "pattern": "^[A-Z]{2,3}_[A-Z0-9][A-Z0-9_]*$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "anyOf": [
       {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "other_label": {
      "anyOf": [
       {
        "maxLength": 80,
        "minLength": 2,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "po_reference": {
      "anyOf": [
       {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "postal_code": {
      "maxLength": 20,
      "minLength": 1,
      "type": "string"
     },
     "vat_id": {
      "anyOf": [
       {
        "maxLength": 40,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "address_line1",
     "postal_code",
     "city",
     "invoice_email"
    ],
    "type": "object"
   },
   "tenant_id": {
    "default": "",
    "type": "string"
   }
  },
  "required": [
   "authorization"
  ],
  "type": "object"
 },
 "name": "complete_billing",
