{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Record Value Metric"
 },
 "description": "Record a workflow value metric \u2014 tracks time saved, risk blocked, success rate, autonomy level, and task complexity for ROI reporting.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "description": "Agent that performed the workflow",
    "maxLength": 100,
    "type": "string"
   },
   "autonomy_level": {
    "description": "Level of agent autonomy",
    "enum": [
     "assist",
     "delegate",
     "automate"
    ],
    "type": "string"
   },
   "measurement_source": {
    "default": "estimated",
    "description": "How values were obtained",
    "enum": [
     "measured",
     "estimated",
     "derived"
    ],
    "type": "string"
   },
   "risk_blocked_count": {
    "default": 0,
    "description": "Number of risks/violations blocked",
    "minimum": 0,
    "type": "integer"
   },
   "success": {
    "description": "Whether the workflow completed successfully",
    "type": "boolean"
   },
   "task_complexity": {
    "default": "medium",
    "description": "Task complexity level",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "time_saved_minutes": {
    "description": "Minutes of human time saved",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "workflow_id": {
    "description": "Unique workflow identifier",
    "maxLength": 100,
    "type": "string"
   },
   "workflow_type": {
    "description": "Type of workflow (e.g., claim-analysis, evidence-review, compliance-check)",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "workflow_id",
   "workflow_type",
   "agent_id",
   "autonomy_level",
   "time_saved_minutes",
   "success"
  ],
  "type": "object"
 },
 "name": "record_value_metric"
}
