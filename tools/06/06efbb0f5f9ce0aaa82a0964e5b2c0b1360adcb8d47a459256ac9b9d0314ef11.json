{
 "annotations": {
  "title": "Place block"
 },
 "description": "Place a block (or entity, e.g. boat/minecart) against a reference block's face. Equips `itemName` first if given. faceVector is the unit direction from the reference block toward the new block.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "asEntity": {
    "description": "Place an entity instead of a block (default false)",
    "type": "boolean"
   },
   "faceVector": {
    "description": "Unit face direction, e.g. {x:0,y:1,z:0} for the top face",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y",
     "z"
    ],
    "type": "object"
   },
   "itemName": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    ],
    "description": "Item to equip to hand before placing"
   },
   "referenceX": {
    "description": "Reference block X",
    "type": "number"
   },
   "referenceY": {
    "description": "Reference block Y",
    "type": "number"
   },
   "referenceZ": {
    "description": "Reference block Z",
    "type": "number"
   }
  },
  "required": [
   "referenceX",
   "referenceY",
   "referenceZ",
   "faceVector"
  ],
  "type": "object"
 },
 "name": "place_block"
}
