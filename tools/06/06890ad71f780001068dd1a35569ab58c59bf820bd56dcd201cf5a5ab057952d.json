{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "croncool:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List scheduled cron jobs"
 },
 "description": "Use this when someone asks what cron jobs or scheduled tasks they have, or which ones last failed. Returns each job's id, name, schedule, target origin, method, enabled state and last run status and time, 20 per page by default, with a cursor for more. Not for a job's full run history.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page with the same projectId; absent for the first page",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Jobs per page, from 1 to 100; defaults to 20",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "description": "Only jobs of this project",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_jobs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "jobs": {
    "description": "Job schedules and target origins only. Request payloads and credential-bearing URL paths, queries, fragments and userinfo are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "contentType": {
       "anyOf": [
        {
         "maxLength": 120,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "enabled": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "expression": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "httpMethod": {
       "anyOf": [
        {
         "maxLength": 16,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 128,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastExecutionStatus": {
       "anyOf": [
        {
         "enum": [
          "success",
          "failure"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastExecutionTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "maxLength": 200,
       "type": "string"
      },
      "projectId": {
       "anyOf": [
        {
         "maxLength": 128,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "targetOrigin": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "type": {
       "anyOf": [
        {
         "maxLength": 60,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "projectId",
      "name",
      "expression",
      "type",
      "targetOrigin",
      "httpMethod",
      "contentType",
      "enabled",
      "lastExecutionTime",
      "lastExecutionStatus",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 4096,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page with the same filters; null on the last page"
   }
  },
  "required": [
   "jobs",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List scheduled cron jobs"
}
