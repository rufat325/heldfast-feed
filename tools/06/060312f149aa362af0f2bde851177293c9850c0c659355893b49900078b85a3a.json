{"_meta":{"xdata.kr/credential":{"providers":["naver_searchad"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=naver_searchad","required":true,"windows_pc_needed":false}},"annotations":{"destructiveHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"\ucea0\ud398\uc778 \ud558\ub098\ub97c \uc77c\uc2dc\uc815\uc9c0\ud558\uac70\ub098 \ub2e4\uc2dc \ucf1c\uac70\ub098(userLock), \ud558\ub8e8 \uc608\uc0b0(dailyBudget, useDailyBudget)\uc774\ub098 \uac8c\uc7ac \uae30\uac04(periodStartDt, periodEndDt, usePeriod)\uc744 \ubc14\uafc9\ub2c8\ub2e4. nccCampaignId \ub294 \ucea0\ud398\uc778 \ubaa9\ub85d \uc870\ud68c\uc5d0\uc11c \uc5bb\uc2b5\ub2c8\ub2e4. \ubc14\ub010 \uacb0\uacfc\ub294 \ub124\uc774\ubc84 \uac80\uc0c9\uad11\uace0\uc758 \uc751\ub2f5\uc73c\ub85c \ub3cc\ub824\uc90d\ub2c8\ub2e4. \uc785\ucc30\uac00\uc640 \ud558\ub8e8 \uc608\uc0b0\uc740 \uad11\uace0\ube44 \ud55c\ub3c4 \uc548\uc5d0\uc11c\ub9cc \ubc14\uafc0 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uad11\uace0\ube44 \ud55c\ub3c4\ub294 \uad11\uace0\ube44 \ud55c\ub3c4 \uc815\ud558\uae30(marketing__budget_limit__set)\ub85c \uc815\ud55c \ud558\ub8e8 \uc608\uc0b0 \uc0c1\ud55c\uacfc \uc785\ucc30\uac00 \uc0c1\ud55c\uc785\ub2c8\ub2e4. \ud55c\ub3c4\uac00 \uc5c6\uac70\ub098 \ub118\ub294 \uc694\uccad\uc740 \uc2e4\ud589\ub418\uc9c0 \uc54a\uc73c\ubbc0\ub85c, \uae08\uc561\uc744 \ub123\uae30 \uc804\uc5d0 \uad11\uace0\ube44 \ud55c\ub3c4 \ubcf4\uae30(marketing__budget_limit__get)\ub85c \ud55c\ub3c4\ub97c \ud655\uc778\ud558\uace0, \ud55c\ub3c4\uac00 \uc5c6\uc73c\uba74 \uad11\uace0\ube44 \ud55c\ub3c4 \uc815\ud558\uae30\ub85c \uba3c\uc800 \uc815\ud558\ub3c4\ub85d \uc548\ub0b4\ud558\uc138\uc694. \ud558\ub8e8 \uc608\uc0b0 \ub044\uae30\ub294 \ub124\uc774\ubc84 \uac80\uc0c9\uad11\uace0 \uad00\ub9ac \ud654\uba74\uc5d0\uc11c \ud558\ub3c4\ub85d \uc548\ub0b4\ud558\uc138\uc694. \uba3c\uc800 \ub124\uc774\ubc84 \uac80\uc0c9\uad11\uace0 \uacc4\uc815\uc744 \uc5f0\ub3d9\ud574\uc57c \ud569\ub2c8\ub2e4. \uc774 \ub3c4\uad6c\ub294 \uae30\uad00\uc758 \uae30\ub85d\uc744 \ubc14\uafc9\ub2c8\ub2e4. \uccab \ud638\ucd9c\uc740 \uc2e4\ud589\ub418\uc9c0 \uc54a\uace0, \uc804\uc1a1\ud560 \ub0b4\uc6a9\uc758 \ubbf8\ub9ac\ubcf4\uae30\uc640 1\ud68c\uc6a9 confirmation_token \uc744 \ub3cc\ub824\uc90d\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uadf8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc0ac\uc6a9\uc790\uc5d0\uac8c \uadf8\ub300\ub85c \ubcf4\uc5ec \uc90d\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \ub3d9\uc758\ud55c \ub4a4\uc5d0\ub9cc \uac19\uc740 \uc778\uc790\uc5d0 \uadf8 confirmation_token \uc744 \ub354\ud574 \ub2e4\uc2dc \ud638\ucd9c\ud569\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uc758 \ub3d9\uc758 \uc5c6\uc774 \ud1a0\ud070\uc744 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc778\uc790\ub97c \ud558\ub098\ub77c\ub3c4 \ubc14\uafb8\uba74 \ud1a0\ud070\uc740 \ubb34\ud6a8\uac00 \ub429\ub2c8\ub2e4. \uadf8\ub54c\ub294 \ud1a0\ud070 \uc5c6\uc774 \ud638\ucd9c\ud574 \uc0c8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 5\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uc11c\ube44\uc2a4\uc5d0 \uacc4\uc815\uc744 \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694.","type":"string"},"confirmation_token":{"description":"\uccab \ud638\ucd9c\uc774 \ub3cc\ub824\uc900 1\ud68c\uc6a9 \ud655\uc778 \ud1a0\ud070\uc785\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uac19\uc740 \uc778\uc790\uc5d0 \uc774 \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc5b4 \ub2e4\uc2dc \ud638\ucd9c\ud558\uba74 \uc2e4\ud589\ub429\ub2c8\ub2e4. 10\ubd84 \ub4a4 \ub9cc\ub8cc\ub418\uace0 \ud55c \ubc88\ub9cc \uc4f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","type":"string"},"dailyBudget":{"description":"\ud558\ub8e8 \uc608\uc0b0(\uc6d0 \ub2e8\uc704 \uc815\uc218). useDailyBudget true \uc640 \ud568\uaed8 \ubcf4\ub0c5\ub2c8\ub2e4. \uad11\uace0\ube44 \ud55c\ub3c4\uc758 \ud558\ub8e8 \uc608\uc0b0 \uc0c1\ud55c \uc548\uc758 \uac12\ub9cc \ubc18\uc601\ub429\ub2c8\ub2e4.","type":"integer"},"nccCampaignId":{"description":"\ucea0\ud398\uc778 id(nccCampaignId). \ucea0\ud398\uc778 \ubaa9\ub85d \uc870\ud68c \uacb0\uacfc\uc5d0\uc11c \uc5bb\uc2b5\ub2c8\ub2e4.","type":"string"},"periodEndDt":{"description":"\uac8c\uc7ac \uc885\ub8cc \uc77c\uc2dc.","type":"string"},"periodStartDt":{"description":"\uac8c\uc7ac \uc2dc\uc791 \uc77c\uc2dc.","type":"string"},"useDailyBudget":{"description":"true \ub85c dailyBudget \uacfc \ud568\uaed8 \ubcf4\ub0b4\uba74 \ud558\ub8e8 \uc608\uc0b0\uc744 \uc801\uc6a9\ud569\ub2c8\ub2e4. false \ub85c \ub044\ub294 \uc694\uccad\uc740 \uc2e4\ud589\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.","type":"boolean"},"usePeriod":{"description":"true \uba74 \uac8c\uc7ac \uae30\uac04\uc744 \uc801\uc6a9\ud558\uace0 false \uba74 \uc5c6\uc571\ub2c8\ub2e4.","type":"boolean"},"userLock":{"description":"true \uba74 \uc77c\uc2dc\uc815\uc9c0\ud558\uace0 false \uba74 \ub2e4\uc2dc \ucf2d\ub2c8\ub2e4.","type":"boolean"}},"required":["nccCampaignId"],"type":"object"},"name":"naver_searchad__campaigns__update","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\ub124\uc774\ubc84 \uac80\uc0c9\uad11\uace0 \ucea0\ud398\uc778 \uc218\uc815"}
