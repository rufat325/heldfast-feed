\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"fullName":{"description":"Optional customer name, 2 to 120 characters.","maxLength":120,"minLength":2,"type":"string"},"phone":{"description":"E.164 phone, required when no email is given.","pattern":"^\\+[1-9][0-9]{6,14}$","type":"string"}},"type":"object"},"distributionPartnerCapability":{"description":"Existing dp_live_ partner token. Omit for customers.","pattern":"^dp_live_[a-f0-9]{64}$","type":"string"},"firstTouchTrackingToken":{"description":"Existing first-touch token. Never invent one.","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$","type":"string"},"locale":{"default":"en","description":"Customer-requested language for text and links: en (default) or de. Preserve it on retries and related calls; it changes presentation, never price or eligibility.","enum":["de","en"],"type":"string"},"offerKey":{"description":"Optional published supplier offer key, for example service_airport. Pass only a key supplied by the provider\u2019s published context; otherwise omit to use the configured default. Preserve it across related calls and retries. It selects a service location and terms, not a booking ID or access grant.","pattern":"^[a-z0-9][a-z0-9_-]{0,79}$","type":"string"},"offerRequested":{"const":true,"description":"True only after the customer explicitly asks for an offer.","type":"boolean"},"resumeToken":{"description":"Caller-generated private secret of 64 hexadecimal characters. Generate once, retain it with submissionId for recovery, and never share the pair publicly or replace it on uncertain retries.","pattern":"^[a-f0-9]{64}$","type":"string"},"ride":{"additionalProperties":false,"description":"Pickup, destination, local date, time and passengers.","properties":{"date":{"description":"Service date as YYYY-MM-DD, for example 2026-12-24, in the selected location\u2019s time zone; do not convert it to a UTC date.","p