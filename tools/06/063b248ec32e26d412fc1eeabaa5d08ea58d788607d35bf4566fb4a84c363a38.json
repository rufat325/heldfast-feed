icitly requested offer, for example 123e4567-e89b-42d3-a456-426614174000. Retain it with the original resumeToken and unchanged request on retries.","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"}},"required":["submissionId","resumeToken","offerRequested","contact","ride"],"type":"object"},"name":"prepare_offer","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"additionalProperties":false,"properties":{"status":{"const":"invalid_request","description":"Input does not match this operation.","type":"string"}},"required":["status"],"type":"object"},{"additionalProperties":false,"properties":{"bookingUrl":{"format":"uri","type":"string"},"status":{"const":"unavailable","description":"This read could not be completed safely.","type":"string"}},"required":["status"],"type":"object"},{"additionalProperties":false,"properties":{"bookingUrl":{"format":"uri","type":"string"},"locations":{"items":{"additionalProperties":false,"properties":{"areas":{"items":{"additionalProperties":false,"properties":{"id":{"type":"string"},"label":{"type":"string"}},"required":["id","label"],"type":"object"},"type":"array"},"countryCode":{"type":"string"},"key":{"type":"string"},"label":{"type":"string"},"timeZone":{"type":"string"}},"required":["key","countryCode","timeZone","label","areas"],"type":"object"},"type":"array"},"nextAction":{"type":"string"},"reason":{"const":"outside_service_area","type":"string"},"status":{"const":"outside_service_area","description":"No price: outside the published areas.","type":"string"},"timeZone":{"type":"string"}},"required":["status","reason","bookingUrl","timeZone","locations","nextAction"],"type":"object"},{"additionalProperties":false,"properties":{"retryAfterSeconds":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"status":{"const":"pendi