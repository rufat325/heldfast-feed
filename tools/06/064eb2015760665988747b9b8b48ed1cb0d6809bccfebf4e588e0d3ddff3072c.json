{
 "description": "Read replies to a discussion message/post in an Ultra discussion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "courseId": {
    "description": "Blackboard course ID",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   },
   "discussionId": {
    "description": "Discussion ID from blackboard_list_discussions",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   },
   "groupId": {
    "description": "Optional group filter for group discussions",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   },
   "isRead": {
    "description": "Filter read or unread messages",
    "type": "boolean"
   },
   "limit": {
    "description": "Maximum replies to return (default 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "messageId": {
    "description": "Message ID from blackboard_list_discussion_messages",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   },
   "offset": {
    "description": "Pagination offset",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "description": "Message status filter",
    "enum": [
     "Published",
     "Deleted",
     "Draft"
    ],
    "type": "string"
   },
   "userId": {
    "description": "Optional author user ID filter",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   }
  },
  "required": [
   "courseId",
   "discussionId",
   "messageId"
  ],
  "type": "object"
 },
 "name": "blackboard_list_discussion_replies"
}
