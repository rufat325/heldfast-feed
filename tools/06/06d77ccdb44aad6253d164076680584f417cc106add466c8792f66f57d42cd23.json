{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Template"
 },
 "description": "Create a reusable set of tasks that can be instantiated into any epic. {variable} placeholders are filled in on apply.",
 "inputSchema": {
  "properties": {
   "description": {
    "type": "string"
   },
   "name": {
    "description": "Template name (must be unique)",
    "type": "string"
   },
   "tasks": {
    "description": "The tasks this template creates.",
    "items": {
     "properties": {
      "description": {
       "description": "Task description (supports {variable} placeholders)",
       "type": "string"
      },
      "estimated_hours": {
       "type": "number"
      },
      "priority": {
       "default": "medium",
       "enum": [
        "low",
        "medium",
        "high",
        "critical"
       ],
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "description": "Task title (supports {variable} placeholders)",
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "tasks"
  ],
  "type": "object"
 },
 "name": "template_create"
}
