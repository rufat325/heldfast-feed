{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Scout opportunities"
 },
 "description": "Find live public tenders, grants, RFPs and buyers for any business, by country/market. Pass a short description of what the business sells or does; optionally scope to market codes like za, uk, us, ng. Returns ranked, live opportunities (tenders, grants, RFPs, procurement notices, prospective buyers and partners), grouped, with a recommended NEXT MOVE. To get updates, call this tool again for the latest answer. If you run a backend with an https endpoint, POST { query, callbackUrl } to https://scoutrail.io/api/subscribe to receive signed webhook updates; conversational agents should just re-call this tool. Examples: {\"business\":\"solar panel installer in Cape Town\"}. {\"business\":\"IT security consultancy\",\"markets\":[\"za\",\"uk\"]}.",
 "inputSchema": {
  "properties": {
   "business": {
    "description": "What the business does, sells or is looking for (e.g. \"hospital cleaning services\")",
    "type": "string"
   },
   "markets": {
    "description": "Optional market codes to scope the search, like za, uk, us, ng",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "business"
  ],
  "type": "object"
 },
 "name": "scout_opportunities",
 "outputSchema": {
  "properties": {
   "counts": {
    "properties": {
     "lockedBriefs": {
      "type": "integer"
     },
     "shown": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "enriched": {
    "type": "boolean"
   },
   "groups": {
    "items": {
     "properties": {
      "count": {
       "type": "integer"
      },
      "items": {
       "items": {
        "description": "An opportunity. For full-data callers (MCP, WhatsApp) an unlocked item also carries `outreach`: how to reach the buyer and a drafted message to send.",
        "properties": {
         "actions": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "buyer": {
          "type": [
           "string",
           "null"
          ]
         },
         "classification": {
          "type": [
           "string",
           "null"
          ]
         },
         "commercial": {},
         "deadline": {},
         "evidence": {},
         "id": {
          "type": "string"
         },
         "links": {
          "properties": {
           "original": {
            "type": "string"
           }
          },
          "type": "object"
         },
         "outreach": {
          "description": "Present on unlocked full-data items only.",
          "properties": {
           "contact": {
            "properties": {
             "channel": {
              "type": "string"
             },
             "value": {
              "type": "string"
             }
            },
            "type": [
             "object",
             "null"
            ]
           },
           "message": {
            "properties": {
             "body": {
              "type": "string"
             },
             "subject": {
              "type": "string"
             }
            },
            "type": [
             "object",
             "null"
            ]
           },
           "steps": {
            "items": {
             "type": "string"
            },
            "type": "array"
           }
          },
          "type": "object"
         },
         "title": {
          "type": "string"
         },
         "value": {}
        },
        "type": "object"
       },
       "type": "array"
      },
      "key": {
       "type": "string"
      },
      "label": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "markets": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "nextMove": {
    "properties": {
     "detail": {
      "type": [
       "string",
       "null"
      ]
     },
     "opportunityId": {
      "type": [
       "string",
       "null"
      ]
     },
     "scout": {
      "type": [
       "object",
       "null"
      ]
     },
     "title": {
      "type": "string"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "pending": {
    "description": "True when more results are still being gathered; call again shortly for the complete list.",
    "type": "boolean"
   },
   "query": {
    "type": "string"
   },
   "schema": {
    "const": "scoutrail.answer/2",
    "type": "string"
   },
   "subscribe": {
    "description": "How to hear about updates for this query. poll: re-call the tool (what a conversational agent does). push: backends with an https endpoint POST { query, callbackUrl } to push.url for signed webhook updates.",
    "properties": {
     "poll": {
      "type": "string"
     },
     "push": {
      "properties": {
       "note": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "query": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "schema",
   "nextMove",
   "counts",
   "groups"
  ],
  "type": "object"
 },
 "title": "Scout opportunities"
}
