{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Draft a forward"
 },
 "description": "Compose a forward of a message as a draft, with the files it carries and inside the thread it already sits in. Nothing leaves the mailbox until the draft is sent.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bcc": {
    "description": "Who to blind-copy. The other recipients are not told.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "type": "array"
   },
   "cc": {
    "description": "Who to copy.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "type": "array"
   },
   "html": {
    "description": "Your own words as HTML, for formatting; note stays their plain-text version. An Outlook mailbox keeps only the HTML and writes the plain version from it.",
    "minLength": 1,
    "type": "string"
   },
   "mailbox": {
    "description": "The mailbox's name or its email address.",
    "minLength": 1,
    "type": "string"
   },
   "messageId": {
    "description": "The provider's own identifier.",
    "pattern": "^[A-Za-z0-9_=-]{1,512}$",
    "type": "string"
   },
   "note": {
    "description": "Your own words, above the message forwarded.",
    "type": "string"
   },
   "to": {
    "description": "Who the forward is addressed to.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "mailbox",
   "messageId",
   "to"
  ],
  "type": "object"
 },
 "name": "drafts_forward",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "link": {
    "type": "string"
   },
   "previousVersionId": {
    "type": "string"
   },
   "threadId": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "title": "Draft a forward"
}
