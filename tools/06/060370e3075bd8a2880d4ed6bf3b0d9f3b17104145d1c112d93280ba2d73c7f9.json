{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create (store) a signed job intent. DRY-RUN BY DEFAULT: returns the exact POST body that WOULD be sent, including the signed message. The caller signs with the signing helper first \u2014 this tool never signs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Atomic units as a decimal string (USDC = 6 decimals).",
    "type": "string"
   },
   "client": {
    "type": "string"
   },
   "dryRun": {
    "description": "Default true: show, do not send.",
    "type": "boolean"
   },
   "evaluator": {
    "type": "string"
   },
   "intentId": {
    "description": "Signed intent id (0x\u2026, from buildIntentRequest).",
    "type": "string"
   },
   "nonce": {
    "type": "string"
   },
   "paymentRecipient": {
    "type": "string"
   },
   "provider": {
    "type": "string"
   },
   "providerAgentId": {
    "description": "Decimal string.",
    "type": "string"
   },
   "signature": {
    "description": "The caller's EIP-712 signature over the intent.",
    "type": "string"
   },
   "terms": {
    "description": "{ description, deliverable }.",
    "type": "object"
   },
   "termsHash": {
    "type": "string"
   },
   "token": {
    "type": "string"
   },
   "validAfter": {
    "type": "string"
   },
   "validBefore": {
    "type": "string"
   }
  },
  "required": [
   "intentId",
   "client",
   "provider",
   "evaluator",
   "providerAgentId",
   "token",
   "amount",
   "paymentRecipient",
   "termsHash",
   "validAfter",
   "validBefore",
   "nonce",
   "terms",
   "signature"
  ],
  "type": "object"
 },
 "name": "acm_create_intent"
}
