{
 "description": "Create a new software development project with metadata, tech stack, architecture details, and quality gates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_id": {
    "description": "Unique project identifier (e.g., \"my-project\")",
    "minLength": 1,
    "type": "string"
   },
   "accessControl": {
    "additionalProperties": false,
    "description": "Access control settings",
    "properties": {
     "allowAdmins": {
      "type": "boolean"
     },
     "allowedRoles": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "description": {
    "description": "Project description",
    "type": "string"
   },
   "lifecycle": {
    "description": "Project lifecycle stage",
    "enum": [
     "planning",
     "in_development",
     "in_review",
     "in_testing",
     "staging",
     "production",
     "maintenance",
     "archived"
    ],
    "type": "string"
   },
   "metadata": {
    "additionalProperties": false,
    "description": "Project metadata including tech stack, architecture, standards, etc.",
    "properties": {
     "architecture": {
      "additionalProperties": false,
      "properties": {
       "directoryStructure": {
        "type": "string"
       },
       "overview": {
        "type": "string"
       },
       "stateManagement": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "style": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "authStrategy": {
      "additionalProperties": false,
      "properties": {
       "approach": {
        "type": "string"
       },
       "implementation": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "type": "object"
     },
     "deployment": {
      "additionalProperties": false,
      "properties": {
       "cicd": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "environment": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "externalServices": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "apiDocs": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "purpose": {
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "framework": {
      "type": "string"
     },
     "language": {
      "type": "string"
     },
     "qualityGates": {
      "additionalProperties": false,
      "properties": {
       "codeReviewChecklist": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "definitionOfDone": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "documentationStandards": {
        "type": "string"
       },
       "testingRequirements": {
        "additionalProperties": false,
        "properties": {
         "coverage": {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "requiresE2ETests": {
          "type": "boolean"
         },
         "testTypes": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      },
      "type": "object"
     },
     "repository": {
      "type": "string"
     },
     "standards": {
      "additionalProperties": false,
      "properties": {
       "errorHandling": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "loggingConvention": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "namingConventions": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "type": "object"
     },
     "techStack": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "name": {
    "description": "Project name",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "_id",
   "name"
  ],
  "type": "object"
 },
 "name": "createProject"
}
