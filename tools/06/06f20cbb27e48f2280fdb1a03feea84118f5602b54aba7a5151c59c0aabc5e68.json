{
 "description": "Append or prepend code to a custom code field WITHOUT reading the existing content first.\nUse this when you need to ADD new CSS rules, JS code, or script tags \u2014 no need to read first.\nFor full rewrites, use update_site_custom_code instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "Code to add",
    "type": "string"
   },
   "field": {
    "description": "Which code field to modify",
    "enum": [
     "code_before_head",
     "code_before_body",
     "code_custom_css",
     "code_custom_javascript"
    ],
    "type": "string"
   },
   "position": {
    "default": "append",
    "description": "Add to end (append) or beginning (prepend)",
    "enum": [
     "append",
     "prepend"
    ],
    "type": "string"
   }
  },
  "required": [
   "field",
   "code"
  ],
  "type": "object"
 },
 "name": "append_site_custom_code"
}
