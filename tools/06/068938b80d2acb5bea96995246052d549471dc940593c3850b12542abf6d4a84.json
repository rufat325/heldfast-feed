{
 "annotations": {
  "destructiveHint": true,
  "title": "Submit a gift for import"
 },
 "description": "Record a gift (donation already received) through Virtuous's gift import pipeline \u2014 the method Virtuous recommends. The gift is matched to a contact, recurring gift or pledge, held until the nightly import, and only created when a user reviews the import and clicks Run. This records a gift; it does NOT charge anyone. Identify the donor with contact.id, contact.referenceId, or name/email details. Virtuous: POST /api/v2/Gift/Transaction.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "description": "Gift amount, e.g. \"100.00\".",
    "minLength": 1,
    "type": "string"
   },
   "batch": {
    "description": "Batch name.",
    "type": "string"
   },
   "check_number": {
    "type": "string"
   },
   "contact": {
    "description": "The donor. Virtuous matches this against existing contacts.",
    "properties": {
     "address": {
      "properties": {
       "address1": {
        "type": "string"
       },
       "address2": {
        "type": "string"
       },
       "city": {
        "type": "string"
       },
       "country": {
        "type": "string"
       },
       "postal": {
        "type": "string"
       },
       "state": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "email": {
      "type": "string"
     },
     "emailType": {
      "type": "string"
     },
     "firstname": {
      "type": "string"
     },
     "id": {
      "description": "Existing Virtuous contact id.",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "lastname": {
      "type": "string"
     },
     "middlename": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "phoneType": {
      "type": "string"
     },
     "referenceId": {
      "description": "The donor's id in your system.",
      "type": "string"
     },
     "suffix": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "type": {
      "description": "Contact type, e.g. Household or Organization.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "currency_code": {
    "description": "ISO currency code, e.g. USD.",
    "type": "string"
   },
   "custom_fields": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom field name -> value.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "designations": {
    "description": "Split the gift across projects.",
    "items": {
     "properties": {
      "amountDesignated": {
       "description": "Amount designated to this project.",
       "type": "string"
      },
      "code": {
       "description": "Project code.",
       "type": "string"
      },
      "id": {
       "description": "Project id.",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "name": {
       "description": "Project name.",
       "type": "string"
      }
     },
     "required": [
      "amountDesignated"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "frequency": {
    "description": "For a recurring gift: its frequency as named in Virtuous.",
    "type": "string"
   },
   "gift_date": {
    "description": "Gift date, e.g. 2026-09-29.",
    "minLength": 1,
    "type": "string"
   },
   "gift_type": {
    "description": "Gift type as configured in Virtuous, e.g. \"Cash\".",
    "minLength": 1,
    "type": "string"
   },
   "is_private": {
    "type": "boolean"
   },
   "is_tax_deductible": {
    "type": "boolean"
   },
   "notes": {
    "type": "string"
   },
   "receipt_date": {
    "type": "string"
   },
   "segment": {
    "description": "Segment code the gift is attributed to.",
    "type": "string"
   },
   "transaction_id": {
    "description": "The gift's id in that source (prevents double import).",
    "type": "string"
   },
   "transaction_source": {
    "description": "Where the gift came from, e.g. \"Website\".",
    "type": "string"
   }
  },
  "required": [
   "gift_date",
   "gift_type",
   "amount",
   "contact"
  ],
  "type": "object"
 },
 "name": "virtuous_create_gift_transaction",
 "title": "Submit a gift for import"
}
