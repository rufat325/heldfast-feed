{
 "description": "Turn live SERP intent into a production-ready content brief for writers and coding agents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "description": "Optional audience description",
    "type": "string"
   },
   "brand_voice": {
    "default": "expert",
    "enum": [
     "neutral",
     "expert",
     "friendly",
     "bold",
     "technical"
    ],
    "type": "string"
   },
   "brief_depth": {
    "default": "standard",
    "enum": [
     "standard",
     "detailed"
    ],
    "type": "string"
   },
   "device": {
    "default": "desktop",
    "enum": [
     "desktop",
     "mobile"
    ],
    "type": "string"
   },
   "include_serp_outline": {
    "default": true,
    "type": "boolean"
   },
   "keyword": {
    "description": "Target keyword",
    "type": "string"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "page_type": {
    "default": "auto",
    "enum": [
     "auto",
     "blog_post",
     "landing_page",
     "comparison_page",
     "guide",
     "tool_page"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "description": "Optional target brand, domain, or product",
    "type": "string"
   }
  },
  "required": [
   "keyword"
  ],
  "type": "object"
 },
 "name": "agentseo_content_brief",
 "title": "AgentSEO Content Brief"
}
