{
 "description": "List running processes, optionally filtered by name or listening port.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 50,
    "description": "Maximum number of results",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Filter processes by name substring (case-insensitive)",
    "type": "string"
   },
   "port": {
    "description": "Filter by TCP listening port",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_processes",
 "title": "List processes"
}
