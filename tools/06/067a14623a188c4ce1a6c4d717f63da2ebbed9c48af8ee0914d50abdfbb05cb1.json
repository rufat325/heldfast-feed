    "type": "array"
   },
   "chain": {
    "type": "string"
   },
   "chain_id": {
    "type": "integer"
   },
   "charged": {
    "description": "When present on an error, false means the failed result is uncharged.",
    "type": "boolean"
   },
   "checked_at": {
    "type": "string"
   },
   "did_you_mean": {
    "additionalProperties": true,
    "type": [
     "object",
     "null"
    ]
   },
   "error": {
