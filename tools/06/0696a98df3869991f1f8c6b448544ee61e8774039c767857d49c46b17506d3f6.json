{
 "description": "Update the WiFi credentials of a WiFi QR code. Only works on QR codes created with type='wifi'. Note: updating WiFi data changes the QR image content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "encryption": {
    "description": "Encryption type.",
    "enum": [
     "WPA",
     "WEP",
     "nopass"
    ],
    "type": "string"
   },
   "hidden": {
    "description": "Whether the network is hidden.",
    "type": "boolean"
   },
   "label": {
    "description": "Update the label.",
    "type": "string"
   },
   "password": {
    "description": "WiFi password.",
    "type": "string"
   },
   "short_id": {
    "description": "The short ID of the WiFi QR code to update.",
    "type": "string"
   },
   "ssid": {
    "description": "WiFi network name.",
    "type": "string"
   }
  },
  "required": [
   "short_id"
  ],
  "type": "object"
 },
 "name": "update_wifi_qr"
}
