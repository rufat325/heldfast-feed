{
 "description": "[mode: real] Build a test plan from stored scenarios with filtering / scheduling.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "maxDuration": {
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "priorityFilter": {
    "items": {
     "enum": [
      "critical",
      "high",
      "medium",
      "low"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "projectPath": {
    "type": "string"
   },
   "template": {
    "enum": [
     "smoke",
     "regression",
     "nightly",
     "full"
    ],
    "type": "string"
   },
   "typeFilter": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "projectPath",
   "name"
  ],
  "type": "object"
 },
 "name": "create_test_plan"
}
