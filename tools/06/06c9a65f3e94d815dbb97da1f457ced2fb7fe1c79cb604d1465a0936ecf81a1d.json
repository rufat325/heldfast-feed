{
 "description": "Update an existing calendar event",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Alias of the Google account to target. Optional \u2014 defaults to the session/global default account, or the sole authenticated account. Run manage_accounts list to see available aliases.",
    "type": "string"
   },
   "attachments": {
    "description": "File attachments (max 25). Replaces existing attachments; pass an empty array to remove all, or omit to keep them. For Drive files use the file's share URL as fileUrl.",
    "items": {
     "properties": {
      "fileUrl": {
       "description": "URL of the file to attach (required)",
       "type": "string"
      },
      "mimeType": {
       "description": "MIME type (optional; ignored for Drive files)",
       "type": "string"
      },
      "title": {
       "description": "Attachment title",
       "type": "string"
      }
     },
     "required": [
      "fileUrl"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "type": "array"
   },
   "attendees": {
    "description": "Updated attendee emails (replaces existing)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "calendarId": {
    "description": "Calendar ID (default: primary)",
    "type": "string"
   },
   "description": {
    "description": "New event description",
    "type": "string"
   },
   "end": {
    "properties": {
     "date": {
      "type": "string"
     },
     "dateTime": {
      "type": "string"
     },
     "timeZone": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "eventId": {
    "description": "The event ID to update",
    "type": "string"
   },
   "location": {
    "description": "New event location",
    "type": "string"
   },
   "sendUpdates": {
    "description": "Send notifications (default: none)",
    "enum": [
     "all",
     "externalOnly",
     "none"
    ],
    "type": "string"
   },
   "start": {
    "properties": {
     "date": {
      "type": "string"
     },
     "dateTime": {
      "type": "string"
     },
     "timeZone": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "summary": {
    "description": "New event title",
    "type": "string"
   }
  },
  "required": [
   "eventId"
  ],
  "type": "object"
 },
 "name": "updateCalendarEvent"
}
