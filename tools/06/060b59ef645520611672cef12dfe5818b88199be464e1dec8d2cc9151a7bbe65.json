{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true
 },
 "description": "\u26a0\ufe0f Destructive: Delete 1-10 log files of an instance atomically (POST \u2026/logs/batch-delete \u2192 202 Operation). BIN logs cannot be deleted. Set confirm=true to execute.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clusterName": {
    "description": "Cluster name (3-30 chars, lowercase letters/digits/'-', no leading or trailing '-'; immutable after creation)",
    "pattern": "^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$",
    "type": "string"
   },
   "confirm": {
    "default": false,
    "description": "Must be true to actually execute the destructive operation",
    "type": "boolean"
   },
   "instanceName": {
    "description": "Instance name ({clusterName}-{suffix}, from ncloud_serverless_list_instances)",
    "pattern": "^[a-z0-9-]{3,39}$",
    "type": "string"
   },
   "logs": {
    "description": "Log files to delete (1-10)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "logType": {
       "enum": [
        "BIN",
        "SLOW_QUERY",
        "ERROR",
        "GENERAL"
       ],
       "type": "string"
      },
      "name": {
       "description": "Log file name (e.g. slow-query.log.1)",
       "type": "string"
      }
     },
     "required": [
      "name",
      "logType"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "clusterName",
   "instanceName",
   "logs"
  ],
  "type": "object"
 },
 "name": "ncloud_serverless_batch_delete_logs"
}
