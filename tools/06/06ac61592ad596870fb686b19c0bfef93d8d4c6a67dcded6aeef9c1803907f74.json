{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate a step-by-step tool-call sequence for a specific revision task (e.g., fact-preserving revision, template alignment). Use this when you are unsure which tool to call next.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Plans a sequence of tool calls for a specific revision task.",
  "properties": {
   "reference_text": {
    "description": "Reference text for reference_match.",
    "type": "string"
   },
   "task": {
    "enum": [
     "fact_preserving_revision",
     "template_revision",
     "reference_match",
     "hotspot_fix",
     "ai_sounding_audit"
    ],
    "type": "string"
   },
   "template_id": {
    "description": "Template ID for template_revision.",
    "type": "string"
   },
   "text": {
    "description": "The text to be revised.",
    "type": "string"
   }
  },
  "required": [
   "task",
   "text"
  ],
  "type": "object"
 },
 "name": "plan_revision_workflow",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "acceptance_gate": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "initial_tool": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "steps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "steps",
   "acceptance_gate",
   "initial_tool",
   "reason"
  ],
  "type": "object"
 },
 "title": "Plan Revision Workflow"
}
