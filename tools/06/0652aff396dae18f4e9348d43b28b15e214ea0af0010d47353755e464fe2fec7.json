  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Test credential"
 },
 "description": "Test one already stored credential by allowing n8n to contact its external service, which receives and may log the attempt. credentialId is the stable ID from n8n_credentials_list or get; inline credential data, names, and types are not accepted. Use get for metadata-only inspection and skip this tool when network contact is unwanted. Requires unsafe mode plus test permission; returns only the target-bound OK/Error outcome and withholds the upstream diagnostic message.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "credentialId": {
    "description": "Stable ID of the stored credential to test.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "type": "string"
   }
  },
  "required": [
   "credentialId"
  ],
  "type": "object"
 },
 "name": "n8n_credentials_test",
