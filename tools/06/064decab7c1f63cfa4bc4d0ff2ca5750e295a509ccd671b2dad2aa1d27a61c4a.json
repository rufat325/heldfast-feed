       "provider-claimed",
       "registry-observed"
      ],
      "type": "string"
     },
     "cluster_id": {
      "type": "string"
     },
     "contact_url": {
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:\\/\\/",
      "type": "string"
     },
     "docs_url": {
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:\\/\\/",
