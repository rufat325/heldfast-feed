    "type": "object"
   },
   "generated_at": {
    "type": "string"
   },
   "notes": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Public-safe notes; may be a string or a string list depending on the adapter."
   },
   "provider": {
    "additionalProperties": false,
    "properties": {
     "authority": {
      "enum": [
       "community",
