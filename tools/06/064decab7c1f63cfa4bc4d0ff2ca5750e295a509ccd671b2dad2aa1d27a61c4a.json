      },
      "type": "array"
     },
     "notes": {
      "type": "string"
     },
     "public_notes": {
      "type": "string"
     },
     "schema_version": {
      "const": 1,
      "type": "number"
     },
     "social": {
      "additionalProperties": false,
      "properties": {
       "reddit": {
        "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:\\/\\/",
        "type": "string"
       },
       "telegram": {
        "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:\\/\\/",
        "type": "string"
       },
       "x": {
        "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:\\/\\/",
        "type": "string"
       },
       "youtube": {
        "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:\\/\\/",
        "type": "string"
       }
      },
      "type": "object"
     },
     "subnet_count": {
      "minimum": 0,
      "type": "integer"
     },
     "surface_count": {
      "minimum": 0,
      "type": "integer"
     },
     "team_url": {
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:\\/\\/",
      "type": "string"
     },
     "website_url": {
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?:\\/\\/",
      "type": "string"
     }
    },
    "required": [
     "schema_version",
     "id",
     "name",
     "kind",
     "website_url",
     "authority",
     "netuids"
    ],
    "type": "object"
   },
   "schema_version": {
    "const": 1,
    "type": "number"
   }
  },
  "required": [
   "generated_at",
   "schema_version",
   "provider"
  ],
  "type": "object"
 },
 "title": "Get one provider's detail"
}
