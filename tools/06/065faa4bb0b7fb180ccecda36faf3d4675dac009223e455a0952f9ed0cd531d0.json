{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "The tools Tabflows works with (EHRs, scribes, messaging, labs and more), optionally filtered by category.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "enum": [
     "EMR",
     "Scribe",
     "Communication",
     "Clinical Support",
     "Patient Experience",
     "Labs",
     "Supplements & Rx",
     "Other"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_integrations",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "integrations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "capabilities": {
       "additionalProperties": false,
       "properties": {
        "contextRead": {
         "additionalProperties": false,
         "properties": {
          "evidence": {
           "type": "string"
          },
          "status": {
           "type": "string"
          }
         },
         "required": [
          "status",
          "evidence"
         ],
         "type": "object"
        },
        "executeWrites": {
         "additionalProperties": false,
         "properties": {
          "evidence": {
           "type": "string"
          },
          "status": {
           "type": "string"
          }
         },
         "required": [
          "status",
          "evidence"
         ],
         "type": "object"
        },
        "preparedActions": {
         "additionalProperties": false,
         "properties": {
          "evidence": {
           "type": "string"
          },
          "status": {
           "type": "string"
          }
         },
         "required": [
          "status",
          "evidence"
         ],
         "type": "object"
        }
       },
       "required": [
        "contextRead",
        "preparedActions",
        "executeWrites"
       ],
       "type": "object"
      },
      "category": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "name",
      "category",
      "description",
      "capabilities",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "integrations"
  ],
  "type": "object"
 },
 "title": "List Tabflows integrations"
}
