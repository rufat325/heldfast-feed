{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Communes within a radius of a point, nearest first. Distance is measured to each commune's centroid, so the nearest commune isn't always the one that contains the point: commune_at gives that one.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "lat": {
    "description": "Latitude, in degrees.",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "description": "How many results. 10 when left out, at most 50.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "lng": {
    "description": "Longitude, in degrees.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "radius_km": {
    "description": "Radius in km. 10 when left out, at most 100.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "number"
   }
  },
  "required": [
   "lat",
   "lng"
  ],
  "type": "object"
 },
 "name": "communes_near",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "distance_km": {
       "type": "number"
      },
      "name_ar": {
       "type": "string"
      },
      "name_fr": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "name_fr",
      "name_ar",
      "slug",
      "distance_km"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Communes near a point"
}
