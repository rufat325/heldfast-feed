{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Semantic Search"},"description":"Search the Urantia Papers using semantic similarity (vector embeddings). Returns conceptually related results even without exact keyword matches. A reference such as \"99:1.1\" gives those paragraphs; a pasted paragraph gives itself first. Each result has `strength` (strong, related, weak) and `match` (reference, exact, similar). The list holds the 100 nearest; `meta.total` is the length of that list, and `meta.related` counts the related or better.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"include_bible_parallels":{"default":false,"description":"Include the top-10 Bible verses semantically nearest to each result (Urantia \u2192 Bible).","type":"boolean"},"include_entities":{"default":false,"description":"Include entity mentions","type":"boolean"},"include_urantia_parallels":{"default":false,"description":"Include the top-10 most-similar OTHER Urantia paragraphs for each result.","type":"boolean"},"lang":{"default":"eng","description":"Language of the results. \"es\" gives the Spanish text and titles; the question can be in Spanish or English, and `strength` allows for the lower similarity of a Spanish question. Default \"eng\".","enum":["eng","es"],"type":"string"},"limit":{"default":20,"description":"Results per page (1-100)","maximum":100,"minimum":1,"type":"integer"},"page":{"default":0,"description":"Page number (0-indexed)","maximum":9007199254740991,"minimum":0,"type":"integer"},"paper_id":{"description":"Filter to a specific paper ID","type":"string"},"part_id":{"description":"Filter to a specific part ID (1-4)","type":"string"},"q":{"description":"Alias for `query` (REST compatibility).","maxLength":2000,"type":"string"},"query":{"description":"Natural language query. Example: \"What is the meaning of life?\"","maxLength":2000,"type":"