{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List document pages and calculators"
 },
 "description": "Lists the document pages on luckpanda.app (generators for invoices, quotes, proforma invoices, receipts and credit notes, plus country and trade templates) and its calculator pages, each with its URL. Optional filters: document_type, country, query. Read-only.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "ISO alpha-2: pages for this country plus the ones for any country.",
    "type": "string"
   },
   "document_type": {
    "description": "The kind of document.",
    "enum": [
     "invoice",
     "quote",
     "proforma",
     "credit_note",
     "receipt"
    ],
    "type": "string"
   },
   "query": {
    "description": "Words to look for in a page's name or summary, e.g. \"freelance\" or \"GST\".",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_tools",
 "outputSchema": {
  "properties": {
   "calculators": {
    "items": {
     "properties": {
      "api_url": {
       "type": "string"
      },
      "mcp_tool": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "page_url": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "slug",
      "page_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "docs_url": {
    "description": "Public page describing this server and its tools.",
    "type": "string"
   },
   "documents": {
    "items": {
     "properties": {
      "country": {
       "description": "ISO alpha-2, or null for a page that fits any country.",
       "type": [
        "string",
        "null"
       ]
      },
      "document_type": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "page_url": {
       "description": "The page, which also opens prefilled with ?doc=.",
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "slug",
      "document_type",
      "country",
      "summary",
      "page_url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "documents",
   "calculators"
  ],
  "type": "object"
 },
 "title": "List document pages and calculators"
}
