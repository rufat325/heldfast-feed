{
 "description": "Start a Stripe checkout session for a UCP product. Returns the hosted\ncheckout URL the buyer needs to visit.\n\nRequired: product_id (or slug) + customer_email.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cancel_url": {
    "format": "uri",
    "type": "string"
   },
   "customer_email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "merchant": {
    "format": "uri",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "product_id": {
    "type": "string"
   },
   "quantity": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "slug": {
    "type": "string"
   },
   "success_url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "customer_email"
  ],
  "type": "object"
 },
 "name": "ucp_checkout"
}
