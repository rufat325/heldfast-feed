{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":true,"title":"Spending by Transaction"},"description":"Search at the transaction (modification) level.\n\n    Unlike search_awards which returns one row per award, this returns one\n    row per transaction (initial action plus every modification). Useful for\n    tracking obligation events over time, ceiling adjustments, deobligations,\n    and admin mods.\n\n    recipient_uei is matched through the API's recipient text search (which\n    covers name, UEI, and DUNS), so pass the plain 12-character UEI.\n\n    Returns standard transaction fields: Action Date, Mod, Award ID,\n    Action Type, Awarding Agency, Recipient Name.\n\n    program_numbers filters assistance awards by assistance listing (CFDA)\n    number, e.g. ['93.778'] for Medicaid; use it with award_type='grants',\n    'loans', 'direct_payments', or 'other'. autocomplete_cfda() finds numbers\n    by program name.\n    ","inputSchema":{"properties":{"award_amount_max":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Award Amount Max"},"award_amount_min":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Award Amount Min"},"award_type":{"default":"contracts","enum":["contracts","idvs","grants","loans","direct_payments","other"],"title":"Award Type","type":"string"},"awarding_agency":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Awarding Agency"},"funding_agency":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Funding Agency"},"keywords":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Keywords"},"limit":{"default":25,"title":"Limit","type":"integer"},"naics_codes":{"anyOf":[{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array"},{"type":"null"}],"default":null,"title":"Naics Codes"},"order":{"default":"desc","enum":["asc","desc"],"title":"Order","type":"string"},"page":{"default":1,"title":"Page","type":"integer"},"program_numbers":{"anyOf":[{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array"},{"type":"null"}],"default":null,"title":"Program Numbers"},"psc_codes":{"anyOf":[{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array"},{"type":"null"}],"default":null,"title":"Psc Codes"},"recipient_uei":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Recipient Uei"},"set_aside_type_codes":{"anyOf":[{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array"},{"type":"null"}],"default":null,"title":"Set Aside Type Codes"},"sort":{"default":"Action Date","title":"Sort","type":"string"},"time_period_end":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Time Period End"},"time_period_start":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Time Period Start"}},"title":"spending_by_transactionArguments","type":"object"},"name":"spending_by_transaction","outputSchema":{"additionalProperties":true,"title":"spending_by_transactionDictOutput","type":"object"}}
