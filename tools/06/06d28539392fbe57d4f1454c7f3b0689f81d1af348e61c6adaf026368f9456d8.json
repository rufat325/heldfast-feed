{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Inspect a page's head tags: title, meta description, canonical, robots directives (meta AND the X-Robots-Tag header), html lang, charset, viewport and favicon. Flags length problems, missing or duplicated tags, and anything that makes the page non-indexable.\n\nArgs:\n  - url (string): the page to check.\n  - response_format ('markdown' | 'json'): output format (default 'markdown').\n\nReturns: { title, title_length, description, description_length, canonical, canonical_is_self, meta_robots, x_robots_tag, indexable, followable, lang, charset, viewport, score, grade, findings[] }.\n\nExample: \"Are the meta tags on https://example.com correct?\" -> meta_tags_check(url=\"https://example.com\").",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "response_format": {
    "default": "markdown",
    "description": "Output format: 'markdown' for a human-readable summary (default) or 'json' for the full structured payload.",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "url": {
    "description": "Page URL to analyse, e.g. 'https://example.com/blog/post'. The scheme defaults to https://.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "meta_tags_check",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "canonical": {
    "type": [
     "string",
     "null"
    ]
   },
   "canonical_is_self": {
    "type": "boolean"
   },
   "charset": {
    "type": [
     "string",
     "null"
    ]
   },
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "description_length": {
    "type": "number"
   },
   "favicon": {
    "type": [
     "string",
     "null"
    ]
   },
   "final_url": {
    "type": "string"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "type": "string"
      },
      "severity": {
       "type": "string"
      }
     },
     "required": [
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "followable": {
    "type": "boolean"
   },
   "grade": {
    "type": "string"
   },
   "indexable": {
    "type": "boolean"
   },
   "lang": {
    "type": [
     "string",
     "null"
    ]
   },
   "meta_robots": {
    "type": [
     "string",
     "null"
    ]
   },
   "robots_directives": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "score": {
    "type": "number"
   },
   "title": {
    "type": [
     "string",
     "null"
    ]
   },
   "title_length": {
    "type": "number"
   },
   "url": {
    "type": "string"
   },
   "viewport": {
    "type": [
     "string",
     "null"
    ]
   },
   "x_robots_tag": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "url",
   "final_url",
   "title",
   "title_length",
   "description",
   "description_length",
   "canonical",
   "canonical_is_self",
   "meta_robots",
   "x_robots_tag",
   "robots_directives",
   "indexable",
   "followable",
   "lang",
   "charset",
   "viewport",
   "favicon",
   "score",
   "grade",
   "findings"
  ],
  "type": "object"
 },
 "title": "Meta Tags Check"
}
