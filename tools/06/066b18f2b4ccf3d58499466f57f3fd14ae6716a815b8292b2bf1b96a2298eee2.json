{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Submit a free, private backlog request when no existing utility solves a concrete problem. Do not include secrets, personal data, or full conversation history.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "client_request_id": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[a-zA-Z0-9._:-]+$",
    "type": "string"
   },
   "constraints": {
    "additionalProperties": false,
    "default": {},
    "properties": {
     "freshness_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 31536000,
      "type": "integer"
     },
     "max_latency_ms": {
      "exclusiveMinimum": 0,
      "maximum": 86400000,
      "type": "integer"
     },
     "max_price_usdc": {
      "pattern": "^\\d{1,6}(\\.\\d{1,6})?$",
      "type": "string"
     },
     "retention": {
      "enum": [
       "no_raw_input",
       "ephemeral",
       "versioned_evidence"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "desired_outcome": {
    "maxLength": 1000,
    "minLength": 8,
    "type": "string"
   },
   "evidence_urls": {
    "default": [],
    "items": {
     "format": "uri",
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "example_input": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "expected_output": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "problem": {
    "maxLength": 1000,
    "minLength": 12,
    "type": "string"
   },
   "why_existing_tools_fail": {
    "maxLength": 1000,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "problem",
   "desired_outcome",
   "why_existing_tools_fail"
  ],
  "type": "object"
 },
 "name": "lab.request_capability",
 "title": "Request a missing capability"
}
