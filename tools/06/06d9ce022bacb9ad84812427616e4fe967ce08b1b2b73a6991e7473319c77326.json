{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a recurring analytics report that's generated and delivered automatically.",
 "inputSchema": {
  "properties": {
   "deliveryMethod": {
    "description": "How to deliver the report",
    "enum": [
     "email",
     "slack",
     "webhook"
    ],
    "type": "string"
   },
   "deliveryTarget": {
    "description": "Email address, Slack channel, or webhook URL",
    "type": "string"
   },
   "name": {
    "description": "Report name",
    "type": "string"
   },
   "platforms": {
    "description": "Platforms to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reportType": {
    "description": "Report type",
    "enum": [
     "performance_overview",
     "channel_comparison",
     "content_analysis",
     "ad_performance",
     "attribution",
     "executive_summary"
    ],
    "type": "string"
   },
   "schedule": {
    "description": "Report frequency",
    "enum": [
     "daily",
     "weekly",
     "monthly"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "reportType",
   "schedule"
  ],
  "type": "object"
 },
 "name": "create_scheduled_report",
 "title": "Create Scheduled Report"
}
