{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Respond To Proposal"
 },
 "description": "Submit a response (accept / decline / counter) on behalf of one participant agent to an open proposal. An \"accept\" requires the slot id from the proposal; a \"counter\" can suggest alternative slots. When all participants have responded the proposal auto-resolves \u2014 no separate resolve call needed in the normal flow. Requires an org-level API key. Pro plan only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_id": {
    "description": "Participant agent responding",
    "type": "string"
   },
   "counter_slots": {
    "description": "Alternative slots when response is \"counter\"",
    "items": {
     "properties": {
      "calendar_id": {
       "description": "Calendar to create the event on if this slot is chosen. Defaults to the proposal's top-level calendar_id.",
       "type": "string"
      },
      "end_time": {
       "description": "Slot end time (ISO 8601), after start_time",
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
       "type": "string"
      },
      "start_time": {
       "description": "Slot start time (ISO 8601)",
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
       "type": "string"
      },
      "weight": {
       "default": 1,
       "description": "Preference for this slot, 0\u201310 (higher = more preferred). Used to rank candidate slots when the proposal is resolved. Defaults to 1.",
       "maximum": 10,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "start_time",
      "end_time"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "message": {
    "description": "Optional note for the organizer",
    "maxLength": 2000,
    "type": "string"
   },
   "proposal_id": {
    "description": "Proposal to respond to",
    "type": "string"
   },
   "response": {
    "description": "Decision from this agent",
    "enum": [
     "accept",
     "decline",
     "counter"
    ],
    "type": "string"
   },
   "selected_slot_id": {
    "description": "Required when response is \"accept\"",
    "type": "string"
   }
  },
  "required": [
   "proposal_id",
   "agent_id",
   "response"
  ],
  "type": "object"
 },
 "name": "respond_to_proposal"
}
