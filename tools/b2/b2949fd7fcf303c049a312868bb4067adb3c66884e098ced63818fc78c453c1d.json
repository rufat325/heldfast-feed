{
 "description": "Request a short-lived access token for an agent. Returns a scoped token for the specified provider.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "description": "The agent requesting the token",
    "type": "string"
   },
   "provider_id": {
    "description": "Target provider identifier",
    "type": "string"
   },
   "scope": {
    "description": "Permission scope for the token",
    "enum": [
     "agent:read",
     "agent:write",
     "agent:execute",
     "agent:transact",
     "agent:communicate",
     "agent:delegate",
     "agent:elevate"
    ],
    "type": "string"
   }
  },
  "required": [
   "agent_id",
   "scope"
  ],
  "type": "object"
 },
 "name": "vorim_request_token"
}
