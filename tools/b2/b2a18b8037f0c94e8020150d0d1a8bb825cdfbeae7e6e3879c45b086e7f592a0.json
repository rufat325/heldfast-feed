{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Recommend resources"
 },
 "description": "Find a shortlist for a task. Keyword relevance precedes repository stars. Optional client preference is evidence, not tested compatibility. Requirements such as free or local-only must be checked upstream.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "client": {
    "maxLength": 60,
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "task": {
    "maxLength": 500,
    "minLength": 2,
    "type": "string"
   },
   "type": {
    "enum": [
     "skill",
     "mcp",
     "plugin",
     "agent",
     "prompt",
     "rule"
    ],
    "type": "string"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "recommend_resources",
 "title": "Recommend resources"
}
