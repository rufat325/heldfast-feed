{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp_crm"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "My listings"
 },
 "description": "List YOUR agency's own property listings (newest first), optionally\nfiltered by status or a specific reference. Use for \"show my listings\"\n/ \"is reference X still online?\". Requires a linked PropertyList\naccount (or an agency API key); only ever returns the calling\nagency's own properties.\n",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "reference": {
    "description": "A specific listing reference. Optional.",
    "type": "string"
   },
   "status": {
    "default": "online",
    "description": "Listing status. Defaults to 'online'. 'draft' covers listings not yet published (new + in review); 'all' returns every status.",
    "enum": [
     "online",
     "offline",
     "sold",
     "draft",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "my_listings",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "listings": {
    "items": {
     "properties": {
      "bathrooms": {
       "type": "integer"
      },
      "bedrooms": {
       "type": "integer"
      },
      "build_sqm": {
       "type": "integer"
      },
      "id": {
       "type": "integer"
      },
      "location": {
       "type": "object"
      },
      "monthly_price": {
       "type": "integer"
      },
      "photo": {
       "type": "string"
      },
      "price": {
       "description": "Headline price for the listing's transaction type; read with price_period.",
       "type": "integer"
      },
      "price_period": {
       "enum": [
        "total",
        "per_month",
        "per_week"
       ],
       "type": "string"
      },
      "reference": {
       "type": "string"
      },
      "sale_price": {
       "type": "integer"
      },
      "status": {
       "description": "online, offline, sold, new, inreview...",
       "type": "string"
      },
      "updated_at": {
       "description": "ISO 8601, UTC.",
       "type": "string"
      },
      "weekly_price_from": {
       "type": "integer"
      }
     },
     "required": [
      "id",
      "reference"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "listings"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "mcp_crm"
   ],
