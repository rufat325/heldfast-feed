{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add, update, or remove an OpenVPN client interface. Idempotent by name (already_exists on matching name+connectTo; CONFLICT on differing connectTo; no_change when an update differs in nothing). Password is always written when provided since RouterOS does not return it on GET.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "add",
     "update",
     "remove"
    ],
    "type": "string"
   },
   "certificate": {
    "description": "Client certificate name",
    "type": "string"
   },
   "confirmationToken": {
    "description": "Token from a prior APPROVAL_REQUIRED response. Re-submit the identical call with this token to confirm the destructive action.",
    "type": "string"
   },
   "connectTo": {
    "description": "Remote server address (required for add)",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview changes without applying.",
    "type": "boolean"
   },
   "mode": {
    "description": "Tunnel mode",
    "enum": [
     "ip",
     "ethernet"
    ],
    "type": "string"
   },
   "name": {
    "description": "OpenVPN client interface name \u2014 idempotency key",
    "type": "string"
   },
   "password": {
    "description": "VPN password (never logged)",
    "type": "string"
   },
   "port": {
    "description": "Remote port number",
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "protocol": {
    "description": "Transport protocol",
    "enum": [
     "tcp-client",
     "udp"
    ],
    "type": "string"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "user": {
    "description": "VPN username",
    "type": "string"
   }
  },
  "required": [
   "action",
   "name"
  ],
  "type": "object"
 },
 "name": "manage_ovpn_client",
 "title": "Manage OpenVPN Client"
}
