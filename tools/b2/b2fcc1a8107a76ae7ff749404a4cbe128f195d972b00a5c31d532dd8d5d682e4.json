{
 "description": "Version history: list publish/draft snapshots, restore one to the current draft (does not publish automatically), or revert_to_published to discard draft changes and restore the currently live version.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "What to do",
    "enum": [
     "list",
     "restore",
     "revert_to_published"
    ],
    "type": "string"
   },
   "limit": {
    "description": "list: max snapshots",
    "type": "number"
   },
   "offset": {
    "description": "list: pagination offset",
    "type": "number"
   },
   "projectId": {
    "description": "Website project ID",
    "type": "string"
   },
   "snapshotId": {
    "description": "restore: snapshot ID from action=\"list\"",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "action"
  ],
  "type": "object"
 },
 "name": "manage_snapshots"
}
