       "flag": {
        "type": "string"
       },
       "name": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "name",
       "flag"
      ],
      "type": "object"
     }
    },
    "required": [
     "uiLanguage",
     "inputLanguage",
     "outputLanguage",
     "supportedCount"
    ],
    "type": "object"
   },
   "message": {
    "type": "string"
   },
   "missingFields": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "outputLanguage": {
    "type": "string"
   },
   "prompt": {
    "type": "string"
   },
   "template": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "type": "string"
     },
     "fields": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "defaultValue": {
         "type": "string"
        },
        "key": {
         "type": "string"
        },
        "label": {
         "type": "string"
        }
       },
       "required": [
        "key",
        "label",
        "defaultValue"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "goal": {
      "type": "string"
     },
     "hasPrompt": {
      "type": "boolean"
     },
     "id": {
      "type": "string"
     },
     "lockReason": {
      "type": [
       "string",
       "null"
      ]
     },
     "locked": {
      "type": "boolean"
     },
     "name": {
      "type": "string"
     },
     "plan": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "description",
     "goal",
     "plan",
     "fields",
     "hasPrompt",
     "locked",
     "lockReason"
    ],
    "type": "object"
   },
   "view": {
    "enum": [
     "prompt",
     "locked"
    ],
    "type": "string"
   }
  },
  "required": [
   "view",
   "entitlement",
   "localization"
  ],
  "type": "object"
 },
 "title": "Build a Poly-Glot prompt"
}
