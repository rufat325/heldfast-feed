{
 "_meta": {
  "openai/outputTemplate": "ui://polyglot/workspace-v3.html",
  "openai/toolInvocation/invoked": "Prompt is ready",
  "openai/toolInvocation/invoking": "Building prompt\u2026",
  "openai/ui": {
   "availableDisplayModes": [
    "inline",
    "fullscreen"
   ],
   "preferredDisplayMode": "inline"
  },
  "openai/widgetDescription": "Interactive Poly-Glot AI Workspace with template search, multilingual prompt building, subscription-aware states, and Compare Mode.",
  "ui": {
   "csp": {
    "connectDomains": [],
    "resourceDomains": []
   },
   "prefersBorder": true,
   "resourceUri": "ui://polyglot/workspace-v3.html"
  },
  "ui/resourceUri": "ui://polyglot/workspace-v3.html"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Fill a named Poly-Glot template with field values and requested input/output languages, producing a finished prompt. Use get_template to inspect needed fields first. This is a Send: it starts the 3-day trial on the first qualifying use, or counts toward the shared rolling 24-hour free-send allowance after trial. Pro templates require trial or Pro; this does not directly query external AI providers.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "inputLanguage": {
    "default": "EN",
    "description": "Language name or code of input text, e.g. es; defaults to EN.",
    "maxLength": 80,
    "type": "string"
   },
   "name": {
    "description": "Required accessible template name; use search_templates or get_template to find it.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "outputLanguage": {
    "default": "EN",
    "description": "Requested output language name or code, e.g. fr; defaults to EN.",
    "maxLength": 80,
    "type": "string"
   },
   "uiLanguage": {
    "default": "EN",
    "description": "Interface language name or code, e.g. EN; independent of source and response languages.",
    "maxLength": 80,
    "type": "string"
   },
   "values": {
    "additionalProperties": {
     "type": [
      "string",
      "number",
      "boolean"
     ]
    },
    "default": {},
    "description": "Map of template placeholder names to strings, numbers or booleans, e.g. {topic: onboarding}.",
    "type": "object"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "build_prompt",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entitlement": {
    "additionalProperties": false,
    "properties": {
     "canUseFree": {
      "type": "boolean"
     },
     "compareLocked": {
      "type": "boolean"
     },
     "dailyFreeLimit": {
      "type": [
       "number",
       "null"
      ]
     },
     "dailyFreeRemaining": {
      "type": [
       "number",
       "null"
      ]
     },
     "isPro": {
      "type": "boolean"
     },
     "lastFreeSendAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "nextResetAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "pricing": {
      "additionalProperties": false,
      "properties": {
       "annual": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string"
         },
         "interval": {
          "type": "string"
         },
         "label": {
          "type": "string"
         },
         "price": {
          "type": "number"
         },
         "savingsLabel": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "label",
         "price",
         "interval",
         "savingsLabel"
        ],
        "type": "object"
       },
       "currency": {
        "type": "string"
       },
       "freeTemplateCount": {
        "type": "number"
       },
       "monthly": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string"
         },
         "interval": {
          "type": "string"
         },
         "label": {
          "type": "string"
         },
         "price": {
          "type": "number"
         }
        },
        "required": [
         "id",
         "label",
         "price",
         "interval"
        ],
        "type": "object"
       },
       "trialDays": {
        "type": "number"
       }
      },
      "required": [
       "currency",
       "trialDays",
       "freeTemplateCount",
       "monthly",
       "annual"
      ],
      "type": "object"
     },
     "state": {
      "type": "string"
     },
     "trialActive": {
      "type": "boolean"
     },
     "trialEndsAt": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "state",
     "trialEndsAt",
     "isPro",
     "trialActive",
     "canUseFree",
     "pricing"
    ],
    "type": "object"
   },
   "inputLanguage": {
    "type": "string"
   },
   "localization": {
    "additionalProperties": false,
    "properties": {
     "inputLanguage": {
      "$ref": "#/properties/localization/properties/uiLanguage"
     },
     "outputLanguage": {
      "$ref": "#/properties/localization/properties/uiLanguage"
     },
     "supportedCount": {
      "type": "number"
     },
     "uiLanguage": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
