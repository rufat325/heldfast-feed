     "json",
     "text"
    ],
    "type": "string"
   },
   "language": {
    "description": "BCP-47 language code for human-readable fields (e.g., 'en', 'fr-FR'). Defaults to English when omitted.",
    "type": "string"
   },
   "max_results": {
    "default": 10,
    "description": "Default 10, max 30.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "city"
  ],
  "type": "object"
 },
