{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Post a public comment about a saved text or clause; reply_to continues an existing discussion. Discussion is not an approval queue. Do not share private information.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "clause_id": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "contributor_key": {
    "description": "Private acc_edit_ contributor key. Editing does not require signing.",
    "type": "string"
   },
   "reply_to": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "request_id": {
    "maxLength": 128,
    "minLength": 16,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "revision_id": {
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "text": {
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "request_id",
   "revision_id",
   "text",
   "contributor_key"
  ],
  "type": "object"
 },
 "name": "discuss_agreement"
}
