{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Diff two n8n workflows"
 },
 "description": "Semantic diff between two workflows. Reports nodes added / removed / modified (with field-level deltas: type, typeVersion, parameters, credentials, disabled, position), connection topology changes, and settings drift. Ignores noise (small position deltas, createdAt/updatedAt). Pair with workflow_get to compare deployed vs local. Deterministic.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "anyOf": [
     {
      "additionalProperties": {},
      "type": "object"
     },
     {
      "type": "string"
     }
    ],
    "description": "The 'after' workflow JSON."
   },
   "before": {
    "anyOf": [
     {
      "additionalProperties": {},
      "type": "object"
     },
     {
      "type": "string"
     }
    ],
    "description": "The 'before' workflow JSON."
   }
  },
  "required": [
   "before",
   "after"
  ],
  "type": "object"
 },
 "name": "workflow_diff",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "change_count": {
    "type": "integer"
   },
   "changes": {
    "description": "Ordered list of semantic differences.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "node_added",
        "node_removed",
        "node_modified",
        "connection_added",
        "connection_removed",
        "setting_changed",
        "active_changed",
        "name_changed"
       ],
       "type": "string"
      },
      "node": {
       "type": "string"
      }
     },
     "required": [
      "kind",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "description": "One-line summary of change counts by kind.",
    "type": "string"
   }
  },
  "required": [
   "changes",
   "summary",
   "change_count"
  ],
  "type": "object"
 },
 "title": "Semantic diff between two n8n workflows"
}
