{"_meta":{"securitySchemes":[{"scopes":["dcast:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Ask the owner to create a paid subscription tier"},"description":"Ask the account owner to create a paid subscription tier with these exact terms (instead of telling them to make it in the cabinet). The owner sees them with the currency on DCAST's approval page and allows with one click; then DCAST creates the tier. Prices are in the account's selling currency (tier.currency).","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"benefits":{"description":"What subscribers get","items":{"maxLength":200,"minLength":1,"type":"string"},"maxItems":20,"minItems":1,"type":"array"},"description":{"description":"Short description","maxLength":500,"type":"string"},"name":{"description":"Tier name, e.g. \"Supporters\"","maxLength":80,"minLength":1,"type":"string"},"priceAnnual":{"anyOf":[{"maximum":9999999.99,"minimum":1,"type":"number"},{"pattern":"^\\d{1,7}(\\.\\d{1,2})?$","type":"string"}],"description":"Yearly price"},"priceMonthly":{"anyOf":[{"maximum":9999999.99,"minimum":1,"type":"number"},{"pattern":"^\\d{1,7}(\\.\\d{1,2})?$","type":"string"}],"description":"Monthly price, at least 1.00"},"trialDays":{"description":"Free trial days","maximum":365,"minimum":0,"type":"integer"}},"required":["name","priceMonthly","benefits"],"type":"object"},"name":"ask_paid_tier","title":"Ask the owner to create a paid subscription tier"}
