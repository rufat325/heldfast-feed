{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Register a GitHub Actions workflow by owner, repository, and workflow file or ID. Only the token environment-variable name is stored; token values remain in the runtime environment.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "branch": {
    "description": "Optional branch filter for workflow runs",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "check_interval_minutes": {
    "default": 5,
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Unique local name for this GitHub Actions target",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "owner": {
    "description": "GitHub user or organization",
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_.-]+$",
    "type": "string"
   },
   "repository": {
    "description": "GitHub repository name",
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_.-]+$",
    "type": "string"
   },
   "tags": {
    "default": [],
    "description": "Tags for grouping",
    "items": {
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "token_env": {
    "default": "GITHUB_TOKEN",
    "description": "Environment variable containing a GitHub token; the token value is never persisted",
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[A-Z_][A-Z0-9_]*$",
    "type": "string"
   },
   "workflow": {
    "description": "Workflow numeric ID or .yml/.yaml filename",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "owner",
   "repository",
   "workflow"
  ],
  "type": "object"
 },
 "name": "register_github_actions",
 "title": "Register GitHub Actions Workflow"
}
