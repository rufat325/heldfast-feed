{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "gymflexa:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find free session slots"
 },
 "description": "Use this when someone asks when their gym has free slots or openings for a class or session, or which coming days are fully booked. Returns, per day, how many online-booking slots are open plus the first start and last end time, for the next 14 days that have openings, so a skipped day has none (no member or trainer names). Not for booking a session.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "gymId": {
    "description": "Id of one of the user's gyms, as the gym list returns it (24 lowercase hex characters)",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "gymId"
  ],
  "type": "object"
 },
 "name": "get_gym_availability",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "availableDayCount": {
    "minimum": 0,
    "type": "integer"
   },
   "availableSlotCount": {
    "minimum": 0,
    "type": "integer"
   },
   "days": {
    "description": "One row per day with open online-booking slots inside the gym's booking window, in date order. Slot counts and times only; members, appointments, trainers and the reason a time is unavailable are never exposed.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "day": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "firstStartTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastEndTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "slotCount": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "day",
      "slotCount",
      "firstStartTime",
      "lastEndTime"
     ],
     "type": "object"
    },
    "maxItems": 14,
    "type": "array"
   },
   "timezone": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "timezone",
   "availableDayCount",
   "availableSlotCount",
   "days"
  ],
  "type": "object"
 },
 "title": "Find free session slots"
}
