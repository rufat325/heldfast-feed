{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compute the assistive-tech facts for an element on the currently-open page: computed accessible name, computed role, resolved aria-* attributes, plus nearest-landmark and nearest-focusable-ancestor context. Use this BEFORE proposing an aria-label / role fix \u2014 an outerHTML snippet does not tell you what AT users actually hear, and the element may already be labelled by an ancestor.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cssSelector": {
    "description": "CSS selector identifying the element to inspect. Prefer the `cssSelector` field on a scan failure (full, untruncated) over `cssSelectorTail` (display-truncated to 120 chars and may begin with `\u2026`, so it is not a valid selector for arbitrary inputs). Constructing a selector yourself from `outerHTMLHead` is also fine.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "cssSelector"
  ],
  "type": "object"
 },
 "name": "audioeye_get_a11y_facts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "element": {
    "additionalProperties": false,
    "properties": {
     "accessibleName": {
      "type": "string"
     },
     "ariaProperties": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "inheritedAtHidden": {
      "type": "boolean"
     },
     "nearestFocusableAncestor": {
      "additionalProperties": false,
      "properties": {
       "accessibleName": {
        "type": "string"
       },
       "role": {
        "type": "string"
       },
       "tag": {
        "type": "string"
       }
      },
      "required": [
       "tag",
       "role"
      ],
      "type": "object"
     },
     "nearestLandmark": {
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string"
       },
       "role": {
        "type": "string"
       },
       "tag": {
        "type": "string"
       }
      },
      "required": [
       "tag",
       "role"
      ],
      "type": "object"
     },
     "role": {
      "type": "string"
     },
     "tagName": {
      "type": "string"
     }
    },
    "required": [
     "tagName",
     "ariaProperties",
     "inheritedAtHidden"
    ],
    "type": "object"
   },
   "selectorMatched": {
    "type": "boolean"
   }
  },
  "required": [
   "selectorMatched"
  ],
  "type": "object"
 }
}
