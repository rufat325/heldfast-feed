{
 "description": "Verify whether a specific colour is available before configure_product. Returns in_stock boolean, expected_restock_date if out of stock, and up to 5 alternative in-stock colours ordered by similarity. Call this when a customer requests a named colour or when you want to prevent a configure_product failure due to an out-of-stock selection.",
 "inputSchema": {
  "properties": {
   "colour_name": {
    "type": "string"
   },
   "product_id": {
    "type": "string"
   }
  },
  "required": [
   "product_id",
   "colour_name"
  ],
  "type": "object"
 },
 "name": "check_colour_stock",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "alternative_colours": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "colour_name": {
       "type": "string"
      },
      "in_stock": {
       "type": "boolean"
      },
      "swatch_url": {
       "type": "string"
      }
     },
     "required": [
      "colour_name",
      "in_stock"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "available_colours": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "colour_name": {
    "type": "string"
   },
   "exact_colour_match": {
    "type": "boolean"
   },
   "expected_restock": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "found": {
    "type": "boolean"
   },
   "in_stock": {
    "type": "boolean"
   },
   "matching_colours": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "colour_name": {
       "type": "string"
      },
      "in_stock": {
       "type": "boolean"
      },
      "swatch_url": {
       "type": "string"
      }
     },
     "required": [
      "colour_name",
      "in_stock"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "product_id": {
    "type": "string"
   },
   "requires_exact_colour_selection": {
    "type": "boolean"
   },
   "swatch_url": {
    "type": "string"
   }
  },
  "required": [
   "in_stock"
  ],
  "type": "object"
 }
}
