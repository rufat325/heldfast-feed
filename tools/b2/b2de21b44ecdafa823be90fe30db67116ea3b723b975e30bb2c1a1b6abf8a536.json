{
 "description": "Update fields on an existing work item (partial update via PATCH). Only include the fields you want to change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "AssigneeEmailAddress": {
    "description": "Must be an existing Karbon user's email",
    "type": "string"
   },
   "DeadlineDate": {
    "type": "string"
   },
   "Description": {
    "type": "string"
   },
   "DueDate": {
    "type": "string"
   },
   "StartDate": {
    "description": "ISO 8601 date or date-time",
    "type": "string"
   },
   "Title": {
    "maxLength": 200,
    "type": "string"
   },
   "WorkType": {
    "type": "string"
   },
   "workItemKey": {
    "description": "The Karbon WorkItemKey to update",
    "type": "string"
   }
  },
  "required": [
   "workItemKey"
  ],
  "type": "object"
 },
 "name": "update_work_item",
 "title": "Update work item"
}
