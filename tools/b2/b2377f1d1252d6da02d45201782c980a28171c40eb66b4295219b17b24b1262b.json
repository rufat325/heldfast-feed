{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"DESTRUCTIVE. Creates a job in pending_review, the same hold the website uses before an admin approves it. It is not added to the public board. Does nothing unless confirm=true, and then requires an idempotency key. The invite link is returned once.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"budgetType":{"enum":["fixed","range"],"type":"string"},"companyName":{"maxLength":120,"type":"string"},"confirm":{"type":"boolean"},"description":{"maxLength":4000,"minLength":1,"type":"string"},"idempotencyKey":{"pattern":"^[A-Za-z0-9_-]{8,64}$","type":"string"},"isPublic":{"type":"boolean"},"jobType":{"enum":["part-time","full-time","contract","on-demand"],"type":"string"},"location":{"maxLength":120,"type":"string"},"maxBudgetPerMin":{"maximum":1000,"minimum":0,"type":"number"},"maxDailyHours":{"maximum":24,"minimum":0,"type":"integer"},"minBudgetPerMin":{"maximum":1000,"minimum":0,"type":"number"},"ratePerMinute":{"maximum":1000,"minimum":0,"type":"number"},"title":{"maxLength":140,"minLength":3,"type":"string"}},"required":["title","description"],"type":"object"},"name":"post_job","title":"Post a job"}
