{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a reachability polygon showing everywhere reachable from a point within a given travel time. Returns a GeoJSON polygon. Useful for understanding how far someone can travel.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "lat": {
    "description": "Latitude of starting point",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "lon": {
    "description": "Longitude of starting point",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "time_minutes": {
    "description": "Maximum travel time in minutes",
    "maximum": 120,
    "minimum": 1,
    "type": "number"
   },
   "transport_mode": {
    "description": "Travel mode",
    "enum": [
     "drive",
     "cycle",
     "walk"
    ],
    "type": "string"
   }
  },
  "required": [
   "lat",
   "lon",
   "transport_mode",
   "time_minutes"
  ],
  "type": "object"
 },
 "name": "get-isochrone"
}
