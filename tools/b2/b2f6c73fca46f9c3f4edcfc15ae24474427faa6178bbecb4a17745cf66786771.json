{
 "description": "Register a new warehouse (fulfillment center)",
 "inputSchema": {
  "properties": {
   "id": {
    "description": "Warehouse ID (slug, unique)",
    "type": "string"
   },
   "isActive": {
    "description": "Active (default true)",
    "type": "boolean"
   },
   "name": {
    "description": "Warehouse display name",
    "type": "string"
   },
   "priority": {
    "description": "Priority among warehouses (lower = higher priority)",
    "type": "number"
   },
   "warehouseDocks": {
    "description": "Docks (shipping origin points) attached to this warehouse",
    "items": {
     "properties": {
      "cost": {
       "type": "number"
      },
      "dockId": {
       "type": "string"
      },
      "priority": {
       "type": "number"
      },
      "time": {
       "description": "ISO 8601 duration (e.g., 00:00:00)",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "name"
  ],
  "type": "object"
 },
 "name": "create_warehouse"
}
