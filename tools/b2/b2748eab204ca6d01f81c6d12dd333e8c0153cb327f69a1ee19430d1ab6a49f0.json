{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List uploaded media"
 },
 "description": "Files in your workspaces, newest first, 50 at a time. Use these ids when attaching media to a post. By default these are the files to post; purpose: source lists the raw material kept to reuse instead. Narrow with kind, tags (files carrying every one) or search (words in the description or tags), or pass media_id for one file of either purpose. Each file has a url to download it from. When nextCursor is not null, pass it as cursor for the next page.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "description": "nextCursor from the previous page, for the page after it.",
    "type": "string"
   },
   "kind": {
    "description": "Only this kind of file.",
    "enum": [
     "image",
     "video",
     "audio"
    ],
    "type": "string"
   },
   "limit": {
    "description": "How many to return. Defaults to 50.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "media_id": {
    "description": "One file by id. Every other argument is ignored.",
    "type": "string"
   },
   "purpose": {
    "description": "library, the default: files to post. source: raw material kept to reuse \u2014 generated takes, recordings, sound effects, saved memes.",
    "enum": [
     "library",
     "source"
    ],
    "type": "string"
   },
   "search": {
    "description": "Words in the description or the tags, ignoring case.",
    "type": "string"
   },
   "tags": {
    "description": "Only files carrying every one of these tags.",
    "items": {
     "maxLength": 40,
     "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "media_list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "media": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "byteSize": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "createdAt": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
       "type": "string"
      },
      "description": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "durationMs": {
       "anyOf": [
        {
         "maximum": 2147483647,
         "minimum": -2147483648,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "height": {
       "anyOf": [
        {
         "maximum": 2147483647,
         "minimum": -2147483648,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "metadata": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "costUsd": {
           "description": "What the job cost or was quoted, in US dollars.",
           "minimum": 0,
           "type": "number"
          },
          "inputs": {
           "description": "Ids of the files it was made from, such as a starting still.",
           "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
           },
           "maxItems": 10,
           "type": "array"
          },
          "jobId": {
           "description": "The provider's id for the job, to find it again there.",
           "maxLength": 200,
           "minLength": 1,
           "type": "string"
          },
          "model": {
           "description": "The model, as the provider names it.",
           "maxLength": 200,
           "minLength": 1,
           "type": "string"
          },
          "prompt": {
           "description": "The prompt it was made from, exactly as sent.",
           "maxLength": 8000,
           "minLength": 1,
           "type": "string"
          },
          "provider": {
           "description": "Who made it: higgsfield, fal, memelord, a phone.",
           "maxLength": 40,
           "minLength": 1,
           "type": "string"
          },
          "ref": {
           "description": "The creative it was made for, e.g. PB-CR07.",
           "maxLength": 60,
           "minLength": 1,
           "type": "string"
          },
          "sourceUrl": {
           "description": "Where a file saved from the web was found.",
           "format": "uri",
           "maxLength": 2000,
           "type": "string"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "mimeType": {
       "type": "string"
      },
      "organizationId": {
       "type": "string"
      },
      "purpose": {
       "enum": [
        "library",
        "avatar",
        "intermediate",
        "corpus",
        "source"
       ],
       "type": "string"
      },
      "sha256": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "url": {
       "description": "Where the file can be downloaded, with no sign-in: the id is the key.",
       "type": "string"
      },
      "width": {
       "anyOf": [
        {
         "maximum": 2147483647,
         "minimum": -2147483648,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "kind",
      "description",
      "purpose",
      "metadata",
      "sha256",
      "mimeType",
      "byteSize",
      "width",
      "height",
      "durationMs",
      "organizationId",
      "createdAt",
      "tags",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "media",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List uploaded media"
}
