{"description":"Follow-ups the agent scheduled for itself that are due now (tasks.create with for_agent). Each row has the words and the op to call. Read only. A field worker sees the ones they made; the owner and office see the shop's.","inputSchema":{"properties":{"shop_id":{"format":"uuid","type":"string"}},"required":["shop_id"],"type":"object"},"name":"agent_due","outputSchema":{"properties":{"display":{"properties":{"columns":{"items":{"properties":{"key":{"type":"string"},"label":{"type":"string"}},"required":["key","label"],"type":"object"},"type":"array"},"fields":{"items":{"properties":{"key":{"type":"string"},"label":{"type":"string"}},"required":["key","label"],"type":"object"},"type":"array"},"kind":{"enum":["table","cards","timeline","checklist","map","calendar","chart"],"type":"string"},"title":{"type":"string"}},"required":["kind","title"],"type":"object"},"due":{"items":{"properties":{"due_at":{"format":"date-time","type":"string"},"job_id":{"format":"uuid","type":["string","null"]},"next_actions":{"description":"Up to 3 useful next steps, best first, in plain words. op names the op to call, when there is one. when is now, later, check, or tell_human. due_at is set for later and check when there is a natural time. A send is tell_human: show the owner the draft, then send only when they say so.","items":{"properties":{"args_hint":{"type":"string"},"due_at":{"format":"date-time","type":["string","null"]},"op":{"type":["string","null"]},"say":{"type":"string"},"when":{"enum":["now","later","check","tell_human"],"type":"string"}},"required":["say","op","when"],"type":"object"},"maxItems":3,"type":"array"},"op":{"type":["string","null"]},"task_id":{"format":"uuid","type":"string"},"title":{"type":"string"}},"required":["task_id","title","due_at","job_id","op","next_actions"],"type":"object"},"type":"array"},"summary":{"type":"string"},"time_zone":{"type":"string"}},"required":["time_zone","summary","display","due"],"type":"object"}}
