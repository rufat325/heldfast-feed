{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Organize user-provided options, facts, assumptions, constraints, and priorities into a neutral comparison. This tool does not choose an option or predict an outcome.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assumptions": {
    "$ref": "#/properties/options/items/properties/benefits",
    "default": [],
    "description": "Beliefs that still need verification."
   },
   "constraints": {
    "$ref": "#/properties/options/items/properties/benefits",
    "default": [],
    "description": "Time, money, policy, or personal constraints."
   },
   "deadline": {
    "description": "Optional human-readable decision deadline.",
    "maxLength": 120,
    "type": "string"
   },
   "decision": {
    "description": "The decision or question being considered.",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "facts": {
    "$ref": "#/properties/options/items/properties/benefits",
    "default": [],
    "description": "Facts that are directly known."
   },
   "options": {
    "description": "Two to eight options being compared.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "benefits": {
       "default": [],
       "description": "Known benefits or positive consequences.",
       "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 20,
       "type": "array"
      },
      "confidence": {
       "default": 3,
       "description": "Confidence in the available information, from 1 to 5.",
       "maximum": 5,
       "minimum": 1,
       "type": "integer"
      },
      "costs": {
       "$ref": "#/properties/options/items/properties/benefits",
       "default": [],
       "description": "Known costs, sacrifices, or tradeoffs."
      },
      "label": {
       "description": "Short name for the option.",
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      },
      "reversible": {
       "default": false,
       "description": "Whether the choice can be reversed without major cost.",
       "type": "boolean"
      },
      "risks": {
       "$ref": "#/properties/options/items/properties/benefits",
       "default": [],
       "description": "Known risks or failure modes."
      }
     },
     "required": [
      "label"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "minItems": 2,
    "type": "array"
   },
   "priorities": {
    "$ref": "#/properties/options/items/properties/benefits",
    "default": [],
    "description": "Values or outcomes that matter most."
   }
  },
  "required": [
   "decision",
   "options"
  ],
  "type": "object"
 },
 "name": "structure_decision",
 "title": "Structure a Decision"
}
