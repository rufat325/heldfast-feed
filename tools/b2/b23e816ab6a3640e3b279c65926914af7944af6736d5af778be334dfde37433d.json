    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "other_values": {
    "type": "number"
   },
   "subset": {
    "type": "string"
   },
   "total_matches": {
    "type": "number"
   },
   "values": {
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "view": {
