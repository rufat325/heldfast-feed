  "readOnlyHint": true,
  "title": "Rank a field's values"
 },
 "description": "Rank exact metadata values, splitting pipe-separated tags. Reports missing metadata and optional coverage over time. Choose spatial for mentioned places, country for stored country tags, or subject/author/language.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "country": {
    "description": "Exact country name (accents optional)",
    "type": "string"
   },
   "date_from": {
    "description": "Inclusive date bounds: YYYY[-MM[-DD]]",
    "type": "string"
   },
   "date_to": {
    "type": "string"
   },
   "exact": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    },
    "description": "AND values. Fields: subject/spatial/author/language/country/newspaper/topic_id/min_prob/scored_by; country_raw=whole cell; polarity:<model>.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "field": {
    "description": "subject | spatial | author | language | newspaper | country",
    "type": "string"
   },
   "hijri_month": {
    "type": "string"
   },
   "hijri_year": {
    "type": "integer"
   },
   "keyword": {
    "minLength": 1,
    "type": "string"
   },
   "keyword_aliases": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "keyword_mode": {
    "enum": [
     "literal",
     "all_terms"
    ],
    "type": "string"
   },
   "newspaper": {
    "description": "Newspaper/periodical substring",
    "type": "string"
   },
   "over_time": {
    "description": "Also return the per-year share of items carrying a value",
    "type": "boolean"
   },
   "subject": {
    "description": "Exact tag",
    "type": "string"
   },
   "subset": {
    "description": "articles (default) | publications | references",
    "type": "string"
   },
   "top_n": {
    "description": "Values returned (default 25, max 100)",
    "type": "integer"
   }
  },
  "required": [
   "field"
  ],
  "type": "object"
 },
 "name": "get_field_distribution",
 "outputSchema": {
