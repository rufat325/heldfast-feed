 "description": "Vet a person or company before onboarding, in one call: the name screened against the OFAC, UK and EU sanctions lists; the email's mailbox, disposable and role checks; the phone's validity, country and line type; the IP's country and network. Returns each result, flags (sanctions hit, disposable email, VoIP, countries that disagree...) and one risk level: low, review or high. Input: any of name, email, phone, ip; optional country, birth_year. $0.10 per call. Returns: input{}, risk (low | review | high), flags[{code, severity, detail}], checks{sanctions, email, phone, ip}, checks_run[], checks_failed[], notes[], checked_at.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "name"
    ]
   },
   {
    "required": [
     "email"
    ]
   },
   {
    "required": [
     "phone"
    ]
   },
   {
    "required": [
     "ip"
    ]
   }
  ],
  "properties": {
   "birth_year": {
    "description": "Birth year, to narrow sanctions matches for a person.",
    "maximum": 2030,
    "minimum": 1880,
    "type": "integer"
   },
   "country": {
    "description": "Country the person says they are in (US or United States), compared with phone and IP.",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "email": {
    "description": "Email address to verify.",
    "maxLength": 320,
    "minLength": 3,
    "type": "string"
   },
   "ip": {
    "description": "The client's IPv4 or IPv6 address.",
    "maxLength": 45,
    "minLength": 2,
    "type": "string"
   },
   "language": {
    "description": "Optional BCP-47 language tag (en, ja, ko, pt-BR): the human-readable strings of the result (notes, details, reasons) are translated into this language; data, codes, numbers and URLs are untouched. Default: as produced.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   },
   "name": {
    "description": "Person or company name to screen against sanctions lists.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "phone": {
    "description": "Phone number, international (+44 20 7946 0958) or national with `phone_region`.",
    "maxLength": 40,
    "minLength": 3,
    "type": "string"
   },
   "phone_region": {
    "description": "Two-letter country for a national-format phone number.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
