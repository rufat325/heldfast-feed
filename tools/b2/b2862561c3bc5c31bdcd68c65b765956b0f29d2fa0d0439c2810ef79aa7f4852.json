{
 "_meta": {
  "openai/outputTemplate": "ui://widget/print-quote-card-v1.html",
  "openai/toolInvocation/invoked": "Quote updated",
  "openai/toolInvocation/invoking": "Updating your quote",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://widget/print-quote-card-v1.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use this when someone wants a different quantity or color on a quote 3D Printer on Demand already gave them. It takes that quote's private link and the new quantity, works out the estimate again from the file saved with the quote, saves it, and returns the new estimate with a new private link. The earlier link keeps the earlier quote. It does not take a new file, a different material, or a link that did not come from one of our quotes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color": {
    "description": "A new color for the same material. Leave out to keep the saved color.",
    "maxLength": 40,
    "type": "string"
   },
   "quantity": {
    "description": "The new number of copies of the part.",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "quote_url": {
    "description": "The private quote link from an earlier quote in this chat.",
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "quote_url",
   "quantity"
  ],
  "type": "object"
 },
 "name": "update_print_quote",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color": {
    "type": "string"
   },
   "currency": {
    "const": "USD",
    "type": "string"
   },
   "file_name": {
    "type": "string"
   },
   "material": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "multi_color": {
    "type": "boolean"
   },
   "next_step": {
    "type": "string"
   },
   "order_fee_usd": {
    "type": "number"
   },
   "outcome": {
    "enum": [
     "instant",
     "needs_upload",
     "needs_review",
     "not_accepted",
     "invalid_choice",
     "try_later"
    ],
    "type": "string"
   },
   "price_held_days": {
    "type": "number"
   },
   "price_per_part_usd": {
    "type": "number"
   },
   "print_fit_notes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "quantity": {
    "type": "number"
   },
   "quote_url": {
    "type": "string"
   },
   "review_url": {
    "type": "string"
   },
   "shipping_usd": {
    "type": "number"
   },
   "size_mm": {
    "additionalProperties": false,
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y",
     "z"
    ],
    "type": "object"
   },
   "subtotal_usd": {
    "type": "number"
   },
   "total_usd": {
    "type": "number"
   },
   "upload_url": {
    "type": "string"
   },
   "valid_colors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "valid_materials": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "outcome",
   "message"
  ],
  "type": "object"
 },
 "title": "Update a 3D print quote"
}
