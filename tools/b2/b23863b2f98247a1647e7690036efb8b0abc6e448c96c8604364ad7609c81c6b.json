 "description": "Estimate monthly revenue, ROI, revenue per email and revenue per subscriber from an email programme, in ecommerce or B2B pipeline mode. See the full version at https://rahuldsarker.co/calculators/email-marketing-roi-calculator",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "clickToOpenPct": {
    "description": "Click-to-open rate, as a percentage",
    "type": "number"
   },
   "conversionPct": {
    "description": "Conversion rate of clicks, as a percentage",
    "type": "number"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "emailsPerMonth": {
    "description": "Emails sent to the list per month",
    "type": "number"
   },
   "listSize": {
    "description": "Subscribers on the list",
    "type": "number"
   },
   "openPct": {
    "description": "Open rate, as a percentage",
    "type": "number"
   },
   "peopleCost": {
    "description": "People cost per month for the programme",
    "type": "number"
   },
   "toolCost": {
    "description": "Email tool cost per month",
    "type": "number"
   },
   "valuePerConversion": {
    "description": "Average order value (ecommerce) or pipeline value per conversion (B2B)",
    "type": "number"
   },
   "winRatePct": {
    "description": "B2B only: win rate on that pipeline, as a percentage. Omit for ecommerce.",
    "type": "number"
   }
  },
  "required": [
   "listSize",
   "emailsPerMonth",
   "openPct",
   "clickToOpenPct",
   "conversionPct",
   "valuePerConversion",
   "toolCost",
   "peopleCost"
  ],
  "type": "object"
 },
