  "properties": {
   "limit": {
    "description": "Page size, default 12.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset, default 0.",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Optional panel name, category or alias filter.",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_panels",
