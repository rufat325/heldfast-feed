{
 "description": "Create an offer code for a consumable/non-consumable/non-renewing-subscription in-app purchase. Requires per-territory prices \u2014 look them up first with apple_get_iap_price_points.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customerEligibilities": {
    "description": "Which customers are eligible",
    "items": {
     "enum": [
      "NON_SPENDER",
      "ACTIVE_SPENDER",
      "CHURNED_SPENDER"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "iapId": {
    "description": "In-App Purchase ID",
    "type": "string"
   },
   "name": {
    "description": "Internal reference name for the offer code",
    "type": "string"
   },
   "prices": {
    "description": "Per-territory prices for the offer",
    "items": {
     "additionalProperties": false,
     "properties": {
      "pricePointId": {
       "description": "Price point ID from apple_get_subscription_price_points / apple_get_iap_price_points",
       "type": "string"
      },
      "territoryId": {
       "description": "Territory ID, e.g. USA",
       "type": "string"
      }
     },
     "required": [
      "territoryId",
      "pricePointId"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "iapId",
   "name",
   "customerEligibilities",
   "prices"
  ],
  "type": "object"
 },
 "name": "apple_create_iap_offer_code"
}
