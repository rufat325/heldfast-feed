{"_meta":{"openai/toolInvocation/invoked":"\u0417\u043d\u0430\u0439\u0448\u043e\u0432 \u043f\u043e\u0434\u0456\u0457","openai/toolInvocation/invoking":"\u0428\u0443\u043a\u0430\u044e \u043f\u043e\u0434\u0456\u0457","securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"\u041f\u043e\u0448\u0443\u043a \u043f\u043e\u0434\u0456\u0439"},"description":"\u0417\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u043c\u0430\u0439\u0431\u0443\u0442\u043d\u0456 \u043f\u043e\u0434\u0456\u0457 \u043d\u0430 AOA: \u043a\u043e\u043d\u0446\u0435\u0440\u0442\u0438, \u043b\u0435\u043a\u0446\u0456\u0457, \u0432\u0435\u0447\u0456\u0440\u043a\u0438, \u043d\u0435\u0442\u0432\u043e\u0440\u043a\u0456\u043d\u0433, \u0437\u043d\u0430\u0439\u043e\u043c\u0441\u0442\u0432\u0430, \u043c\u0430\u0439\u0441\u0442\u0435\u0440\u043a\u043b\u0430\u0441\u0438, \u043a\u0456\u043d\u043e\u043f\u043e\u043a\u0430\u0437\u0438. \u0412\u0438\u043a\u043b\u0438\u043a\u0430\u0439, \u043a\u043e\u043b\u0438 \u043b\u044e\u0434\u0438\u043d\u0430 \u043f\u0438\u0442\u0430\u0454, \u0449\u043e \u0440\u043e\u0431\u0438\u0442\u0438 \u043d\u0430 \u0432\u0438\u0445\u0456\u0434\u043d\u0438\u0445, \u043a\u0443\u0434\u0438 \u043f\u0456\u0442\u0438 \u0432\u0432\u0435\u0447\u0435\u0440\u0456, \u044f\u043a\u0456 \u0454 \u043f\u043e\u0434\u0456\u0457 \u0432 \u043c\u0456\u0441\u0442\u0456, \u0434\u0435 \u043f\u043e\u0437\u043d\u0430\u0439\u043e\u043c\u0438\u0442\u0438\u0441\u044f \u0437 \u043b\u044e\u0434\u044c\u043c\u0438 \u0430\u0431\u043e \u0447\u0438\u043c \u0437\u0430\u0439\u043d\u044f\u0442\u0438\u0441\u044c \u0443 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0443 \u0434\u0430\u0442\u0443. \u041f\u043e\u0432\u0435\u0440\u0442\u0430\u0454 \u0434\u043e 20 \u043f\u043e\u0434\u0456\u0439: event_id, \u0434\u0430\u0442\u0443, \u043c\u0456\u0441\u0446\u0435, \u0446\u0456\u043d\u0443 \u0456 \u0447\u0438 \u0432\u0456\u0434\u043a\u0440\u0438\