{"_meta":{"securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Find public manufacturer/supplier profile candidates; existence does not establish available stock.","inputSchema":{"additionalProperties":false,"properties":{"canonical_concept_id":{"anyOf":[{"pattern":"^[a-z0-9][a-z0-9._:-]{0,99}$","type":"string"},{"type":"null"}],"default":null,"title":"Canonical Concept Id"},"capacity":{"anyOf":[{"maxLength":100,"type":"string"},{"type":"null"}],"default":null,"title":"Capacity"},"certification":{"anyOf":[{"maxLength":100,"type":"string"},{"type":"null"}],"default":null,"title":"Certification"},"country":{"anyOf":[{"pattern":"^[A-Z]{2}$","type":"string"},{"type":"null"}],"default":null,"title":"Country"},"delivery_geography":{"anyOf":[{"maxLength":100,"type":"string"},{"type":"null"}],"default":null,"title":"Delivery Geography"},"hs_cn_code":{"anyOf":[{"pattern":"^[0-9]{4,10}$","type":"string"},{"type":"null"}],"default":null,"title":"Hs Cn Code"},"keywords":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"title":"Keywords"},"limit":{"default":10,"maximum":20,"minimum":1,"title":"Limit","type":"integer"},"moq":{"anyOf":[{"maxLength":100,"type":"string"},{"type":"null"}],"default":null,"title":"Moq"},"preferred_language":{"default":"en","pattern":"^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$","title":"Preferred Language","type":"string"},"product":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"title":"Product"},"source_language":{"default":"und","pattern":"^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$","title":"Source Language","type":"string"},"specification":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"title":"Specification"}},"title":"SearchQuery","type":"object"},"name":"search_suppliers"}
