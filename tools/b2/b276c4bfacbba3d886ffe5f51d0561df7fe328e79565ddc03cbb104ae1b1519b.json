{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add or remove a place from your favorites list.\n\nExamples:\n  - Add: action=\"add\", place_id=\"a1b2c3d4\", note=\"Great anchorage for overnight\"\n  - Remove: action=\"remove\", place_id=\"a1b2c3d4\"\n\nplace_id accepts the 8-char [xxxxxxxx] shown by nausika_search_places, or a full UUID. Find places first with nausika_search_places, then bookmark by place_id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Add or remove a favorite",
    "enum": [
     "add",
     "remove"
    ],
    "type": "string"
   },
   "note": {
    "description": "Personal note (only for add)",
    "examples": [
     "Quiet bay, sheltered from mistral"
    ],
    "type": "string"
   },
   "place_id": {
    "description": "Place id \u2014 full UUID or 8+ char hex prefix from nausika_search_places ([xxxxxxxx])",
    "maxLength": 64,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "action",
   "place_id"
  ],
  "type": "object"
 },
 "name": "nausika_manage_favorite",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "action": {
    "enum": [
     "add",
     "remove"
    ],
    "type": "string"
   },
   "created_at": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "note": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "place": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "name"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "place_id": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   },
   "user_id": {
    "type": "string"
   }
  },
  "required": [
   "action",
   "place_id"
  ],
  "type": "object"
 },
 "title": "Manage Favorite"
}
