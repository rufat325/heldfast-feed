{"annotations":{"destructiveHint":false,"readOnlyHint":false},"description":"Create a draft using team_commitments (project and Slack), request_intake or document_review (private submitted run input). Choose project, personal, team with explicit member usernames, or tenant audience. Optional execution_plan supports up to eight dependency-checked draft.compose/draft.review and artifact.document/artifact.spreadsheet/artifact.presentation/artifact.email/artifact.meeting steps with persisted call/input/attempt/deadline limits. The final step must depend on every other step. Instructions never execute arbitrary tools. Show steps and audience before publication.","inputSchema":{"$defs":{"ExecutionPlan":{"additionalProperties":false,"properties":{"max_attempts_per_step":{"default":2,"maximum":3,"minimum":1,"title":"Max Attempts Per Step","type":"integer"},"max_execution_seconds":{"default":3600,"maximum":86400,"minimum":1,"title":"Max Execution Seconds","type":"integer"},"max_generation_calls":{"default":12,"maximum":24,"minimum":1,"title":"Max Generation Calls","type":"integer"},"max_total_input_chars":{"default":200000,"maximum":400000,"minimum":1,"title":"Max Total Input Chars","type":"integer"},"steps":{"items":{"$ref":"#/$defs/PlanStep"},"maxItems":8,"minItems":1,"title":"Steps","type":"array"}},"required":["steps"],"title":"ExecutionPlan","type":"object"},"PlanStep":{"additionalProperties":false,"properties":{"capability":{"enum":["draft.compose","draft.review","artifact.document","artifact.spreadsheet","artifact.presentation","artifact.email","artifact.meeting"],"title":"Capability","type":"string"},"capability_version":{"const":1,"default":1,"title":"Capability Version","type":"integer"},"depends_on":{"items":{"type":"string"},"maxItems":7,"title":"Depends On","type":"array"},"instructions":{"maxLength":4000,"minLength":1,"title":"Instructions","type":"string"},"step_id":{"pattern":"^[a-z][a-z0-9_]{0,39}$","title":"Step Id","type":"string"},"title":{"maxLength":160,"minLength":1,"title":"Title","type":"string"}},"required":["step_id","title","capability","instructions"],"title":"PlanStep","type":"object"}},"additionalProperties":false,"properties":{"audience":{"default":"project","enum":["project","personal","team","tenant"],"title":"Audience","type":"string"},"channel_id":{"anyOf":[{"pattern":"^[CG][A-Z0-9]{1,63}$","type":"string"},{"type":"null"}],"default":null,"title":"Channel Id"},"execution_plan":{"anyOf":[{"$ref":"#/$defs/ExecutionPlan"},{"type":"null"}],"default":null},"instructions":{"maxLength":4000,"minLength":1,"title":"Instructions","type":"string"},"members":{"items":{"type":"string"},"maxItems":100,"title":"Members","type":"array"},"project_id":{"anyOf":[{"pattern":"^[a-f0-9-]{36}$","type":"string"},{"type":"null"}],"default":null,"title":"Project Id"},"template":{"default":"team_commitments","enum":["team_commitments","request_intake","document_review"],"title":"Template","type":"string"},"thread_ts":{"anyOf":[{"pattern":"^\\d{1,16}\\.\\d{6}$","type":"string"},{"type":"null"}],"default":null,"title":"Thread Ts"},"title":{"maxLength":160,"minLength":1,"title":"Title","type":"string"}},"required":["title","instructions"],"title":"Definition","type":"object"},"name":"workflow_create","title":"Workflow Create"}
