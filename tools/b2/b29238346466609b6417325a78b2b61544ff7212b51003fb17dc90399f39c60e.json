{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Query widget preview data from Cloud Insight by specifying metrics directly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aggregation": {
    "description": "Aggregation type",
    "enum": [
     "AVG",
     "MIN",
     "MAX",
     "SUM",
     "COUNT"
    ],
    "type": "string"
   },
   "dimensions": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Dimension filters as key-value pairs",
    "type": "object"
   },
   "interval": {
    "description": "Aggregation interval",
    "enum": [
     "Min1",
     "Min5",
     "Min30",
     "Hour2",
     "Day1"
    ],
    "type": "string"
   },
   "metric": {
    "description": "Metric name to query",
    "type": "string"
   },
   "prodKey": {
    "description": "Product key (cw_key)",
    "type": "string"
   },
   "timeEnd": {
    "description": "End time in Unix epoch milliseconds",
    "type": "number"
   },
   "timeStart": {
    "description": "Start time in Unix epoch milliseconds",
    "type": "number"
   }
  },
  "required": [
   "prodKey",
   "metric",
   "timeStart",
   "timeEnd"
  ],
  "type": "object"
 },
 "name": "ncloud_query_widget_preview"
}
