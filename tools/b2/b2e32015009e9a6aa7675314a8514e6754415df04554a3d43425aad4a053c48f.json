{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read-only: search the embedded TouchDesigner knowledge router across operators, operator workflows, examples, versions, compatibility notes, technique packs, TD classes, and experimental build notes. Returns normalized results with resource URIs and tool hints for deeper lookups.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum number of results to return.",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   },
   "query": {
    "description": "Search text to route across TouchDesigner knowledge.",
    "minLength": 1,
    "type": "string"
   },
   "surface": {
    "default": "all",
    "description": "Knowledge surface to search: all, operators, operator_workflows, operator_examples, versions, operator_compatibility, python_api_compatibility, techniques, td_classes, or experimentals.",
    "enum": [
     "all",
     "operators",
     "operator_workflows",
     "operator_examples",
     "versions",
     "operator_compatibility",
     "python_api_compatibility",
     "techniques",
     "td_classes",
     "experimentals"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_touchdesigner_knowledge",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Number of returned results.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Search text from the request.",
    "type": "string"
   },
   "results": {
    "description": "Normalized knowledge search results.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "description": "Short description when available.",
       "type": "string"
      },
      "id": {
       "description": "Stable id for the result within its surface.",
       "type": "string"
      },
      "name": {
       "description": "Human-readable result name.",
       "type": "string"
      },
      "resourceUri": {
       "description": "tdmcp:// resource URI for a detailed lookup.",
       "type": "string"
      },
      "surface": {
       "description": "Knowledge surface that produced this result.",
       "enum": [
        "operators",
        "operator_workflows",
        "operator_examples",
        "versions",
        "operator_compatibility",
        "python_api_compatibility",
        "techniques",
        "td_classes",
        "experimentals"
       ],
       "type": "string"
      },
      "toolHint": {
       "description": "Suggested tool to call next for this result.",
       "type": "string"
      }
     },
     "required": [
      "surface",
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "surface": {
    "description": "Surface requested by the caller.",
    "enum": [
     "all",
     "operators",
     "operator_workflows",
     "operator_examples",
     "versions",
     "operator_compatibility",
     "python_api_compatibility",
     "techniques",
     "td_classes",
     "experimentals"
    ],
    "type": "string"
   }
  },
  "required": [
   "query",
   "surface",
   "count",
   "results"
  ],
  "type": "object"
 },
 "title": "Search TouchDesigner knowledge"
}
