{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"\ubcc4\ud45c \uc6d0\ubb38 \uc870\ud68c"},"description":"\ud2b9\uc815 \ubcc4\ud45c\u00b7\uc11c\uc2dd\uc758 \ubcf8\ubb38\uc744 \ubc18\ud658\ud55c\ub2e4. \uc870\ubb38\uc774 '\ubcc4\ud45c N\uc5d0 \ub530\ub978\ub2e4'\ub85c \uc704\uc784\ud55c \uc138\uc728\u00b7\uae30\uc900\uae08\uc561\uc744 \ud655\uc778\ud560 \ub54c \uc0ac\uc6a9. \ud55c \ubc88\uc5d0 6,000\uc790\uc529 \uc8fc\uba70 \uae34 \ud45c\ub294 offset\uc73c\ub85c \uc774\uc5b4 \uc77d\ub294\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"annex_number":{"description":"'\ubcc4\ud45c 2', '\ubcc4\ud45c 1\uc7583', '\uc11c\uc2dd 1' \ub610\ub294 \uc22b\uc790\ub9cc","type":"string"},"law_name":{"description":"\ubc95\ub839\uba85 (\uc608: '\uc18c\ub4dd\uc138\ubc95 \uc2dc\ud589\ub839')","type":"string"},"offset":{"description":"\uc120\ud0dd: \uc774\uc5b4 \uc77d\uc744 \uc2dc\uc791 \uae00\uc790 \uc704\uce58 (\uc55e \uc751\ub2f5\uc774 \uc54c\ub824 \uc900 \uac12)","minimum":0,"type":"integer"}},"required":["law_name","annex_number"],"type":"object"},"name":"get_annex"}
