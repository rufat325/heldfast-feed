{
 "description": "Create a Notion database view. Pass database_id. Dashboard views and dashboard widget placement are not supported.",
 "inputSchema": {
  "properties": {
   "configuration": {
    "description": "Raw Notion view configuration payload. Dashboard configuration is rejected.",
    "type": "object"
   },
   "database_id": {
    "description": "Database ID",
    "type": "string"
   },
   "filter": {
    "description": "Raw Notion view filter payload",
    "type": "object"
   },
   "name": {
    "description": "View name",
    "type": "string"
   },
   "position": {
    "description": "Raw Notion view tab position payload",
    "type": "object"
   },
   "quick_filters": {
    "description": "Raw Notion quick filters payload",
    "type": "object"
   },
   "sorts": {
    "description": "Raw Notion view sorts payload",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "type": {
    "description": "View type. Dashboard is intentionally unsupported.",
    "enum": [
     "table",
     "board",
     "list",
     "calendar",
     "timeline",
     "gallery",
     "form",
     "chart",
     "map"
    ],
    "type": "string"
   }
  },
  "required": [
   "database_id",
   "name",
   "type"
  ],
  "type": "object"
 },
 "name": "create_view"
}
