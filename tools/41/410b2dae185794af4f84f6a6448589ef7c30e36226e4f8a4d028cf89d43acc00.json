{
 "description": "Read real-user Core Web Vitals for an origin or URL from the Chrome UX Report: the current 28-day field record with p75s and histograms. Field data, not a lab test; PageSpeed's own field block is being discontinued. Needs SEO_MCP_CRUX_KEY or a PageSpeed key allowed to call the Chrome UX Report API; read-only",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "formFactor": {
    "description": "Device class; omit for all form factors combined",
    "enum": [
     "PHONE",
     "TABLET",
     "DESKTOP"
    ],
    "type": "string"
   },
   "metrics": {
    "description": "Metric names to request; omit for all available",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "origin": {
    "description": "Origin such as https://example.com; aggregates every page under it. Give origin or url, not both",
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "A single page URL. Give origin or url, not both",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "crux_field_data",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collectionPeriod": {
    "additionalProperties": false,
    "properties": {
     "firstDate": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "lastDate": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "firstDate",
     "lastDate"
    ],
    "type": "object"
   },
   "formFactor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "hasData": {
    "type": "boolean"
   },
   "metrics": {
    "anyOf": [
     {
      "additionalProperties": {
       "additionalProperties": false,
       "properties": {
        "histogram": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "density": {
            "anyOf": [
             {
              "type": "number"
             },
             {
              "type": "null"
             }
            ]
           },
           "end": {
            "anyOf": [
             {
              "type": "number"
             },
             {
              "type": "null"
             }
            ]
           },
           "start": {
            "anyOf": [
             {
              "type": "number"
             },
             {
              "type": "null"
             }
            ]
           }
          },
          "required": [
           "start",
           "end",
           "density"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "p75": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "p75",
        "histogram"
       ],
       "type": "object"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "additionalProperties": {
       "not": {}
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ]
   },
   "normalizedUrl": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "origin": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "source": {
    "type": "string"
   },
   "url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "origin",
   "url",
   "formFactor",
   "hasData",
   "source",
   "metrics",
   "notes"
  ],
  "type": "object"
 }
}
