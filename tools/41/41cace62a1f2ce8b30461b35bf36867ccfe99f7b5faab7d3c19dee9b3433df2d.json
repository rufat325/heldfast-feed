{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Save a payment method for recurring charges. Creates a small real payment to bind the card/wallet (charged, then refundable). MOVES REAL MONEY \u2014 irreversible.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "anyOf": [
     {
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    ],
    "description": "Binding amount (min 1 ruble; charged then refundable)"
   },
   "currency": {
    "default": "RUB",
    "description": "Currency (ISO-4217, default RUB)",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "description": {
    "default": "Card binding",
    "description": "Description",
    "type": "string"
   },
   "payment_method_type": {
    "default": "bank_card",
    "description": "Payment method type",
    "enum": [
     "bank_card",
     "yoo_money",
     "sberbank"
    ],
    "type": "string"
   },
   "return_url": {
    "description": "URL to return to after binding",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "return_url"
  ],
  "type": "object"
 },
 "name": "save_payment_method",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "confirmation_url": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "paid": {
    "type": "boolean"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Save payment method"
}
