{
 "description": "Render an HTML document (inline CSS/JS allowed, public http(s) assets only) to an image \u2014 e.g. social cards, charts, email previews. Returns the hosted image URL and the image itself when it is 2 MB or smaller.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adblock": {
    "description": "Block ads",
    "type": "boolean"
   },
   "block_cookie_banner": {
    "description": "Hide cookie consent banners",
    "type": "boolean"
   },
   "device_scale_factor": {
    "description": "1 = standard, 2 = retina, 3 = high-dpi",
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "format": {
    "description": "Image format. Default png",
    "enum": [
     "png",
     "jpeg",
     "webp"
    ],
    "type": "string"
   },
   "full_page": {
    "description": "Capture the whole scrollable page. Default true",
    "type": "boolean"
   },
   "html": {
    "description": "Complete HTML document or fragment to render",
    "maxLength": 500000,
    "minLength": 1,
    "type": "string"
   },
   "light_mode": {
    "description": "Force light or dark color scheme",
    "enum": [
     "default",
     "light",
     "dark"
    ],
    "type": "string"
   },
   "selector": {
    "description": "CSS selector of a single element to capture",
    "type": "string"
   },
   "transparent_background": {
    "description": "Transparent background (PNG/WebP only)",
    "type": "boolean"
   },
   "viewport_height": {
    "description": "Viewport height in pixels. Default 1080",
    "maximum": 3840,
    "minimum": 16,
    "type": "integer"
   },
   "viewport_width": {
    "description": "Viewport width in pixels. Default 1920",
    "maximum": 3840,
    "minimum": 16,
    "type": "integer"
   },
   "wait_ms": {
    "description": "Extra wait before capturing, in ms",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "html"
  ],
  "type": "object"
 },
 "name": "screenshot_html",
 "title": "Render HTML to an image"
}
