{
 "description": "Write a short message tied to a location waypoint into the user's graph. PolarityGPS-style. Use only when the user is explicitly recording a place-anchored thought.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "lat": {
    "type": "number"
   },
   "lon": {
    "type": "number"
   },
   "message": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "waypoint_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "waypoint_id",
   "name",
   "message"
  ],
  "type": "object"
 },
 "name": "polarity_dump"
}
