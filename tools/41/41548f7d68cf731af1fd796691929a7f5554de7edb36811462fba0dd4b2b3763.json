{
 "description": "Set borders for cells in a Google Sheet",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Alias of the Google account to target. Optional \u2014 defaults to the session/global default account, or the sole authenticated account. Run manage_accounts list to see available aliases.",
    "type": "string"
   },
   "bottom": {
    "description": "Apply to bottom border",
    "type": "boolean"
   },
   "color": {
    "description": "Border color (RGB values 0-1)",
    "properties": {
     "blue": {
      "type": "number"
     },
     "green": {
      "type": "number"
     },
     "red": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "innerHorizontal": {
    "description": "Apply to inner horizontal borders",
    "type": "boolean"
   },
   "innerVertical": {
    "description": "Apply to inner vertical borders",
    "type": "boolean"
   },
   "left": {
    "description": "Apply to left border",
    "type": "boolean"
   },
   "range": {
    "description": "Range to format (e.g., 'A1:C10')",
    "type": "string"
   },
   "right": {
    "description": "Apply to right border",
    "type": "boolean"
   },
   "spreadsheetId": {
    "description": "Spreadsheet ID",
    "type": "string"
   },
   "style": {
    "description": "Border style",
    "enum": [
     "SOLID",
     "DASHED",
     "DOTTED",
     "DOUBLE"
    ],
    "type": "string"
   },
   "top": {
    "description": "Apply to top border",
    "type": "boolean"
   },
   "width": {
    "description": "Border width (1-3)",
    "type": "number"
   }
  },
  "required": [
   "spreadsheetId",
   "range",
   "style"
  ],
  "type": "object"
 },
 "name": "setGoogleSheetBorders"
}
