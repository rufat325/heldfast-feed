{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add questions to a draft interview round"
 },
 "description": "Add questions to one draft round exactly as written \u2014 deterministic, no AI generation. Requires rounds; each round holds at most 50 questions. The first question edit on a round persists question_N ids for every question in that round. Optional source_stage {stage: questions_and_directions, version} returns 409 when stale.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "const": "interview_plan.add_questions",
    "type": "string"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "input": {
    "additionalProperties": false,
    "properties": {
     "questions": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "followUpQuestions": {
         "items": {
          "maxLength": 2000,
          "type": "string"
         },
         "maxItems": 20,
         "type": "array"
        },
        "guidance": {
         "maxLength": 10000,
         "type": "string"
        },
        "id": {
         "maxLength": 128,
         "type": "string"
        },
        "tags": {
         "items": {
          "maxLength": 128,
          "type": "string"
         },
         "maxItems": 20,
         "type": "array"
        },
        "text": {
         "maxLength": 5000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "text"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
     },
     "round_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
     },
     "source_stage": {
      "additionalProperties": false,
      "properties": {
       "stage": {
        "const": "questions_and_directions",
        "type": "string"
       },
       "version": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "stage"
      ],
      "type": "object"
     }
    },
    "required": [
     "round_id",
     "questions"
    ],
    "type": "object"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "resource": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "pattern": "^ipd_[0-9A-Za-z]{16,64}$",
      "type": "string"
     },
     "type": {
      "const": "interview_plan_draft",
      "type": "string"
     }
    },
    "required": [
     "type",
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "action",
   "resource",
   "input"
  ],
  "type": "object"
 },
 "name": "yardstick_interview_plan_drafts_add_questions",
 "title": "Add questions to a draft interview round"
}
