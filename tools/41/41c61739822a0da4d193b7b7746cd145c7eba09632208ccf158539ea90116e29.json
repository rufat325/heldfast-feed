{
 "description": "Set a property on an existing element. Requires staruml-mcp-extension to be installed in StarUML. Install from https://github.com/ezrabrilliant/staruml-mcp-extension",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "field": {
    "description": "Property name, e.g. 'name', 'documentation', 'visibility'",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Element _id",
    "minLength": 1,
    "type": "string"
   },
   "value": {
    "description": "New value"
   }
  },
  "required": [
   "id",
   "field"
  ],
  "type": "object"
 },
 "name": "update_element"
}
