{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get rates and availability"
 },
 "description": "Get the nightly price, minimum length of stay and availability (0 = not available) for each date in a range, for one or more properties. Smoobu: GET /api/rates.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "apartment_ids": {
    "description": "Property ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   },
   "end_date": {
    "description": "Last date (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "start_date": {
    "description": "First date (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "apartment_ids",
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "smoobu_get_rates",
 "title": "Get rates and availability"
}
