{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read an attachment"
 },
 "description": "Read one attachment of a message. The answer is what it says, as plain text; with as original it is the file itself, base64. messages_get and threads_get name a message's attachments and their sizes. Either answer names the address the original is served at whole, to a GET carrying this same credential.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "as": {
    "description": "text, the default: what the file says. original: the file itself, byte for byte.",
    "enum": [
     "text",
     "original"
    ],
    "type": "string"
   },
   "continuation": {
    "description": "Where the words resume, as the last part read named it. The original always comes whole.",
    "pattern": "^[A-Za-z0-9_-]{43}\\.\\d{1,10}$",
    "type": "string"
   },
   "id": {
    "description": "An attachment id, as a message read named it.",
    "maxLength": 2048,
    "pattern": "^(?:\\d+(?:\\.\\d+)*|[A-Za-z0-9_=-]+)$",
    "type": "string"
   },
   "mailbox": {
    "description": "The mailbox's name or its email address.",
    "minLength": 1,
    "type": "string"
   },
   "messageId": {
    "description": "The message's id, as a search or a read answered it.",
    "pattern": "^[A-Za-z0-9_=-]{1,512}$",
    "type": "string"
   }
  },
  "required": [
   "mailbox",
   "messageId",
   "id"
  ],
  "type": "object"
 },
 "name": "messages_attachments_get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "type": "string"
   },
   "attachmentId": {
    "type": "string"
   },
   "carriesPayload": {
    "type": "boolean"
   },
   "charset": {
    "type": "string"
   },
   "contentFormat": {
    "enum": [
     "text",
     "image",
     "bytes"
    ],
    "type": "string"
   },
   "continuation": {
    "type": "string"
   },
   "data": {
    "type": "string"
   },
   "filename": {
    "type": "string"
   },
   "messageId": {
    "type": "string"
   },
   "mimeType": {
    "type": "string"
   },
   "outcome": {
    "enum": [
     "complete",
     "partial",
     "unsupported",
     "locked",
     "no_words",
     "not_read",
     "timed_out",
     "too_heavy",
     "unparseable",
     "changed",
     "reader_missing"
    ],
    "type": "string"
   },
   "returned": {
    "enum": [
     "original",
     "text"
    ],
    "type": "string"
   },
   "size": {
    "type": "number"
   },
   "sizePrecision": {
    "enum": [
     "exact",
     "upperBound"
    ],
    "type": "string"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "messageId",
   "attachmentId",
   "filename",
   "mimeType",
   "size",
   "sizePrecision",
   "contentFormat",
   "returned",
   "carriesPayload",
   "address"
  ],
  "type": "object"
 },
 "title": "Read an attachment"
}
