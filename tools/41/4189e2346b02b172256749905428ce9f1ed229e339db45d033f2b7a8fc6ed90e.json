  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create notification target"
 },
 "description": "Adds a post-call notification (email, SMS, WhatsApp or custom URL) to an assistant. Messages will be sent to the destination after calls; never invent the destination. Confirm the exact destination/value with the user first.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "active": {
    "type": "boolean"
   },
   "agent_id": {
    "description": "The assistant id. Call call2me_list_agents first if unknown.",
    "type": "string"
   },
   "channel": {
    "enum": [
     "whatsapp",
     "sms",
     "email",
     "custom_url"
    ],
    "type": "string"
   },
   "destination": {
    "description": "Email, phone number or URL.",
    "type": "string"
   },
   "recipient_kind": {
    "enum": [
     "owner",
     "caller",
     "fixed",
     "team"
    ],
    "type": "string"
   },
   "template": {
    "description": "Message template.",
    "type": "string"
   },
   "trigger_event": {
    "enum": [
     "call_ended",
     "chat_ended"
    ],
    "type": "string"
   }
  },
  "required": [
   "agent_id",
   "channel"
  ],
  "type": "object"
 },
 "name": "call2me_create_notification_target",
 "title": "Create notification target"
}
