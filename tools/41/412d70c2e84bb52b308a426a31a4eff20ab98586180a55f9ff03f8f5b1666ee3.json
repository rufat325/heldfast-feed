{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Fast lookup for a known CN code. Returns the canonical description (SV + EN), chapter heading, applicable classification rules, EUDR Annex I scope (in_scope + is_ex), and the MFN duty headline. Pass include=[\"reasoning\"] to also receive the bilingual reasoning_md narrative.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cn_code": {
    "pattern": "^(\\d{2}|\\d{4}|\\d{6}|\\d{8}|\\d{10})$",
    "type": "string"
   },
   "include": {
    "items": {
     "enum": [
      "reasoning"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "cn_code"
  ],
  "type": "object"
 },
 "name": "klassio_lookup_cn_code",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "chapter_description_en": {
    "type": "string"
   },
   "chapter_description_sv": {
    "type": "string"
   },
   "classification_rules": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "rule_id": {
       "type": "string"
      },
      "scope": {
       "type": "string"
      },
      "text_en": {
       "type": "string"
      },
      "text_sv": {
       "type": "string"
      }
     },
     "required": [
      "rule_id",
      "scope",
      "text_sv",
      "text_en"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "cn_code": {
    "type": "string"
   },
   "cn_code_display": {
    "type": "string"
   },
   "description_en": {
    "type": "string"
   },
   "description_sv": {
    "type": "string"
   },
   "duty": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "as_of": {
        "type": "string"
       },
       "geo_area": {
        "type": "string"
       },
       "rate": {
        "type": "string"
       },
       "type": {
        "type": "string"
       }
      },
      "required": [
       "rate",
       "type",
       "geo_area",
       "as_of"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "eudr": {
    "additionalProperties": false,
    "properties": {
     "commodity": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "in_scope": {
      "type": "boolean"
     },
     "is_ex": {
      "type": "boolean"
     }
    },
    "required": [
     "in_scope",
     "is_ex",
     "commodity"
    ],
    "type": "object"
   },
   "found": {
    "type": "boolean"
   },
   "message": {
    "type": "string"
   },
   "reasoning_md": {
    "type": "string"
   }
  },
  "required": [
   "found",
   "cn_code"
  ],
  "type": "object"
 }
}
