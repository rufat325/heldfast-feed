    "type": "string"
   },
   "category": {
    "default": "",
    "type": "string"
   },
   "date_from": {
    "default": "",
    "type": "string"
   },
   "date_to": {
    "default": "",
    "type": "string"
   },
   "dpop_token": {
    "default": "",
    "type": "string"
   },
