{
 "_meta": {
  "agents-x402/paymentRequired": true,
  "agents-x402/priceUSD": 0.005
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Observe and Verify URL"
 },
 "description": "Verify what is observable at a public URL before an agent trusts, pays, or acts. This paid tool combines observe_url and verify_proof in one call: it buys an observation, creates or returns a Proof Receipt, and evaluates the supplied trust policy. Set max_age=0 when current public-network evidence is required. The result contains both observation evidence and verification with decision PASS, FAIL, or UNKNOWN.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "max_age": {
    "description": "Maximum acceptable observation age in seconds. Defaults to 300. Set to 0 to require a fresh public-network request before policy evaluation.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "policy": {
    "additionalProperties": false,
    "description": "Declarative trust policy evaluated against the resulting Proof Receipt.",
    "properties": {
     "changed_since_content_hash": {
      "description": "Prior SHA-256 response-body fingerprint. Passes when the current proof has a different content hash.",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "content_hash_equals": {
      "description": "Expected SHA-256 response-body fingerprint, including the sha256: prefix. Passes only on exact equality.",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "final_host_equals": {
      "description": "Expected lowercase hostname after redirects, for example example.com. Provide a hostname, not a full URL.",
      "minLength": 1,
      "type": "string"
     },
     "max_age_seconds": {
      "description": "Maximum allowed age of the stored observation in seconds at verification time.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "original_host_equals": {
      "description": "Expected lowercase hostname from the originally requested URL. Provide a hostname, not a full URL.",
      "minLength": 1,
      "type": "string"
     },
     "require_same_origin_redirect": {
      "description": "When true, fails if the final URL origin differs from the original URL origin after redirects.",
      "type": "boolean"
     },
     "status_in": {
      "description": "Allowed HTTP status codes. The rule passes when the observed status is in this list.",
      "items": {
       "maximum": 599,
       "minimum": 100,
       "type": "integer"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   },
   "url": {
    "description": "Public HTTP or HTTPS URL to observe and verify.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url",
   "policy"
  ],
  "type": "object"
 },
 "name": "verify_url",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "observation": {
    "additionalProperties": false,
    "properties": {
     "age_seconds": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "content_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "content_length": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "etag": {
      "type": [
       "string",
       "null"
      ]
     },
     "fetch_duration_ms": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "final_url": {
      "format": "uri",
      "type": "string"
     },
     "last_modified": {
      "type": [
       "string",
       "null"
      ]
     },
     "observed_at": {
      "description": "ISO-8601 timestamp of the observation.",
      "type": "string"
     },
     "proof_id": {
      "description": "FreshProof proof identifier returned by observe_url or verify_url.",
      "pattern": "^fp1_[a-f0-9]{64}$",
      "type": "string"
     },
     "receipt_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "source": {
      "description": "fresh_fetch means FreshProof made a new public-network request; shared_cache means a stored observation satisfied max_age.",
      "enum": [
       "shared_cache",
       "fresh_fetch"
      ],
      "type": "string"
     },
     "status": {
      "maximum": 599,
      "minimum": 100,
      "type": "integer"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "url",
     "final_url",
     "observed_at",
     "age_seconds",
     "status",
     "content_hash",
     "content_length",
     "etag",
     "last_modified",
     "fetch_duration_ms",
     "source",
     "proof_id",
     "receipt_hash"
    ],
    "type": "object"
   },
   "verification": {
    "additionalProperties": false,
    "properties": {
     "checks": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "actual": {
         "description": "Observed value used by the rule."
        },
        "expected": {
         "description": "Expected value or condition used by the rule."
        },
        "pass": {
         "description": "Whether this individual rule passed.",
         "type": "boolean"
        },
        "rule": {
         "description": "Policy rule that was evaluated.",
         "type": "string"
        }
       },
       "required": [
        "rule",
        "pass",
        "actual",
        "expected"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "decision": {
      "description": "Overall policy decision. PASS means every supplied rule passed; FAIL means at least one supplied rule failed; UNKNOWN means a reliable decision could not be made.",
      "enum": [
       "PASS",
       "FAIL",
       "UNKNOWN"
      ],
      "type": "string"
     },
     "proof_id": {
      "description": "FreshProof proof identifier returned by observe_url or verify_url.",
      "pattern": "^fp1_[a-f0-9]{64}$",
      "type": "string"
     },
     "receipt": {
      "additionalProperties": false,
      "properties": {
       "payload": {
        "additionalProperties": false,
        "properties": {
         "content_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
         },
         "content_length": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "etag": {
          "type": [
           "string",
           "null"
          ]
         },
         "fetch_duration_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "final_url": {
          "format": "uri",
          "type": "string"
         },
         "last_modified": {
          "type": [
           "string",
           "null"
          ]
         },
         "method": {
          "const": "GET",
          "type": "string"
         },
         "normalized_url": {
          "format": "uri",
          "type": "string"
         },
         "observation_id": {
          "type": "string"
         },
         "observed_at": {
          "description": "ISO-8601 timestamp of the observation.",
          "type": "string"
         },
         "original_url": {
          "format": "uri",
          "type": "string"
         },
         "status": {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
         },
         "version": {
          "const": "freshproof-receipt-v1",
          "type": "string"
         }
        },
        "required": [
         "version",
         "observation_id",
         "normalized_url",
         "original_url",
         "final_url",
         "observed_at",
         "method",
         "status",
         "content_hash",
         "content_length",
         "etag",
         "last_modified",
         "fetch_duration_ms"
        ],
        "type": "object"
       },
       "proof_id": {
        "description": "FreshProof proof identifier returned by observe_url or verify_url.",
        "pattern": "^fp1_[a-f0-9]{64}$",
        "type": "string"
       },
       "receipt_hash": {
        "description": "SHA-256 content address of the canonical Proof Receipt payload.",
        "pattern": "^sha256:[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "proof_id",
       "receipt_hash",
       "payload"
      ],
      "type": "object"
     },
     "valid": {
      "description": "True when the stored receipt passes deterministic integrity verification.",
      "type": "boolean"
     }
    },
    "required": [
     "proof_id",
     "valid",
     "decision",
     "checks",
     "receipt"
    ],
    "type": "object"
   }
  },
  "required": [
   "observation",
   "verification"
  ],
  "type": "object"
 }
}
