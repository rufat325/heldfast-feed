{
 "description": "Run PageSpeed Insights for field Core Web Vitals, Lighthouse scores, and top opportunities",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "description": "Optional PageSpeed Insights API key; defaults to SEO_MCP_PAGESPEED_KEY",
    "minLength": 1,
    "type": "string"
   },
   "category": {
    "default": [
     "performance",
     "seo",
     "accessibility",
     "best-practices"
    ],
    "description": "Lighthouse categories to run",
    "items": {
     "enum": [
      "performance",
      "seo",
      "accessibility",
      "best-practices"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "strategy": {
    "default": "mobile",
    "description": "Lighthouse device strategy",
    "enum": [
     "mobile",
     "desktop"
    ],
    "type": "string"
   },
   "url": {
    "description": "Public page URL to analyze",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "pagespeed",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fieldData": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "value": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "value",
      "category"
     ],
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "opportunities": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "string"
      },
      "savingsMs": {
       "type": "number"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "description",
      "savingsMs"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scores": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ]
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "strategy": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "strategy",
   "fieldData",
   "scores",
   "opportunities"
  ],
  "type": "object"
 }
}
