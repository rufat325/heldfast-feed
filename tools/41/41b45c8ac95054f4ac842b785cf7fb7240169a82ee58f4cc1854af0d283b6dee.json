{"_meta":{"securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Read private uploads"},"description":"List assets and existing card compositions in one private scope after the buyer uploads. Returns asset IDs with their kinds and each composition\u2019s design_key/version. Reuse an existing composition directly; use compose_private_card only for a new face. For a new purchase, prepare_order uses request_id = scope_id and the same token; existing drafts use revise_order. An empty scope returns empty assets and compositions arrays. An expired scope without checkout or payment returns NOT_FOUND; open a new scope to upload again.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"order_access_token":{"description":"Exact private order_access_token returned by open_private_content for this scope. Keep it private and never invent one.","pattern":"^[A-Za-z0-9_-]{43}$","type":"string"},"scope_id":{"description":"Exact scope_id returned by open_private_content for the uploads to list.","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","type":"string"}},"required":["scope_id","order_access_token"],"type":"object"},"name":"read_private_content","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"data":{"additionalProperties":false,"properties":{"assets":{"items":{"additionalProperties":false,"properties":{"asset_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"kind":{"enum":["artwork","logo"],"type":"string"}},"required":["asset_id","kind"],"type":"object"},"type":"array"},"compositions":{"items":{"additionalProperties":false,"properties":{"composition_id":{"form