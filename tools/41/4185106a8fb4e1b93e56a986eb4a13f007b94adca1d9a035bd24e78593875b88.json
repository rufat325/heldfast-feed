{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Place an order"
 },
 "description": "Draft an order (food/retail). Returns line items, total, a ref and a customer_token. Nothing reaches the business until approve_request. Ask the customer to confirm the total first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "customer": {
    "description": "Who the job/order is for. Use what the customer already gave you; ask only for what a tool says is missing.",
    "properties": {
     "address": {
      "properties": {
       "city": {
        "type": "string"
       },
       "line1": {
        "type": "string"
       },
       "line2": {
        "type": "string"
       },
       "state": {
        "type": "string"
       },
       "zip": {
        "type": "string"
       }
      },
      "required": [
       "line1",
       "zip"
      ],
      "type": "object"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "notes": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "fulfillment": {
    "enum": [
     "pickup",
     "delivery"
    ],
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "add_ons": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "notes": {
       "type": "string"
      },
      "qty": {
       "type": "number"
      },
      "size": {
       "description": "option id from the menu, e.g. 16oz",
       "type": "string"
      },
      "sku": {
       "type": "string"
      }
     },
     "required": [
      "sku"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "requested_time": {
    "description": "ISO datetime; omit for ASAP",
    "type": "string"
   },
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "slug",
   "items",
   "fulfillment",
   "customer"
  ],
  "type": "object"
 },
 "name": "place_order",
 "title": "Place an order"
}
