{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare 2\u20134 projects or item sets with identical research-item filters. Reports denominators, missingness, dates and top types/languages; collections can overlap.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cohorts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "maxLength": 256,
       "minLength": 1,
       "type": "string"
      },
      "type": {
       "enum": [
        "project",
        "collection"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "id"
     ],
     "type": "object"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array"
   },
   "filters": {
    "additionalProperties": false,
    "properties": {
     "added_since": {
      "maxLength": 40,
      "type": "string"
     },
     "collection": {
      "maxLength": 1000,
      "type": "string"
     },
     "contributor": {
      "maxLength": 1000,
      "type": "string"
     },
     "country": {
      "maxLength": 1000,
      "type": "string"
     },
     "genre": {
      "maxLength": 1000,
      "type": "string"
     },
     "has_media": {
      "type": "boolean"
     },
     "keyword": {
      "maxLength": 1000,
      "type": "string"
     },
     "language": {
      "maxLength": 1000,
      "type": "string"
     },
     "location": {
      "maxLength": 1000,
      "type": "string"
     },
     "location_id": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "modified_since": {
      "maxLength": 40,
      "type": "string"
     },
     "project_id": {
      "anyOf": [
       {
        "maxLength": 256,
        "type": "string"
       },
       {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       }
      ]
     },
     "research_section": {
      "maxLength": 1000,
      "type": "string"
     },
     "resource_type": {
      "maxLength": 1000,
      "type": "string"
     },
     "subject": {
      "maxLength": 1000,
      "type": "string"
     },
     "university": {
      "maxLength": 1000,
      "type": "string"
     },
     "year_from": {
      "maximum": 2200,
      "minimum": 0,
      "type": "integer"
     },
     "year_to": {
      "maximum": 2200,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "cohorts"
  ],
  "type": "object"
 },
 "name": "compare_collections",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cohorts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amira_url": {
       "type": "string"
      },
      "date_range": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "earliest": {
           "type": "number"
          },
          "latest": {
           "type": "number"
          }
         },
         "required": [
          "earliest",
          "latest"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "number"
      },
      "languages": {
       "additionalProperties": {
        "type": "number"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "matched_items": {
       "type": "number"
      },
      "missing": {
       "additionalProperties": {
        "type": "number"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "name": {
       "type": "string"
      },
      "resource_types": {
       "additionalProperties": {
        "type": "number"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "total_items": {
       "type": "number"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "id",
      "name",
      "amira_url",
      "total_items",
      "matched_items",
      "missing",
      "resource_types",
      "languages",
      "date_range"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "overlap_note": {
    "type": "string"
   },
   "snapshot_id": {
    "type": "string"
   }
  },
  "required": [
   "snapshot_id",
   "overlap_note",
   "cohorts"
  ],
  "type": "object"
 },
 "title": "Compare project collections"
}
