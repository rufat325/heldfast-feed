{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Builds unsigned swap material so the user can buy (or sell) a listed meme coin (POST /api/build); wallet must review and sign. Not a launch/create-token tool. Fee 0.85% on fee-enabled trades. NFA. Does NOT authorize, sign, submit or confirm.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Positive decimal string",
    "pattern": "^\\d*\\.?\\d+$",
    "type": "string"
   },
   "chain": {
    "maxLength": 32,
    "minLength": 2,
    "pattern": "^[a-z0-9][a-z0-9_-]*$",
    "type": "string"
   },
   "from": {
    "description": "Public signing-wallet address; output is bound to this caller.",
    "maxLength": 128,
    "minLength": 32,
    "type": "string"
   },
   "quote": {
    "additionalProperties": {},
    "description": "Prior memeswap_quote /api/quote response object.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "side": {
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "slippageBps": {
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "token": {
    "maxLength": 128,
    "minLength": 32,
    "type": "string"
   }
  },
  "required": [
   "chain",
   "side",
   "token",
   "amount",
   "from",
   "quote"
  ],
  "type": "object"
 },
 "name": "memeswap_build"
}
