{"_meta":{"securitySchemes":[{"type":"oauth2"}]},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Page through the files in a private Space.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"cursor":{"maxLength":4096,"type":"string"},"limit":{"maximum":50,"minimum":1,"type":"integer"},"regex":{"description":"Filter files by regex on filename, media_type. Needs sign-in. No lookaround, backreferences or \\p; \\w \\d \\s \\b are ASCII. Case-insensitive, ^ $ per line, . stops at newlines: (?-i) (?-m) (?s) at the start change that. At most 256 characters and 62 positions: one per character, class or anchor, counting each alternative and repeated copy, so .* not .{0,100}. limit counts rows read; an empty page with has_more true means keep paging.","maxLength":256,"minLength":1,"type":"string"},"space_id":{"pattern":"^[so]_[0-9a-f]{32}$","type":"string"}},"required":["space_id"],"type":"object"},"name":"space_file_list","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"files":{"items":{"additionalProperties":{},"properties":{"bytes":{"type":"number"},"created_at":{"type":"string"},"expires_at":{"type":["string","null"]},"file_id":{"type":"string"},"filename":{"type":"string"},"media_type":{"type":"string"},"retention":{"type":"string"},"sha256":{"type":"string"},"space_id":{"type":"string"},"stored_bytes":{"type":"number"},"version":{"type":"string"}},"required":["file_id","version","space_id","filename","media_type","sha256","bytes","stored_bytes","created_at","expires_at","retention"],"type":"object"},"type":"array"},"has_more":{"type":"boolean"},"next_cursor":{"type":["string","null"]}},"required":["files","next_cursor","has_more"],"type":"object"},"securitySchemes":[{"type":"oauth2"}],"title":"List files"}
