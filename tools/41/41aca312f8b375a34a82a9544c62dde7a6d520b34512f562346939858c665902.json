{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Validate an HTTP API request body against a supplied JSON Schema before sending it. This tool does not execute the request. Use it when an agent needs to determine whether a proposed JSON body satisfies its expected schema. Optional economics adds proceed/abort advice from expected waste versus a $0.002 check.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "economics": {
    "description": "Optional V0.2 cost context. Omit for V0.1 validation-only output.",
    "properties": {
     "billsOnInvalidRequest": {
      "description": "True when the target API charges or consumes quota on 4xx",
      "type": "boolean"
     },
     "budgetRemainingUsd": {
      "description": "Remaining agent budget. Checks above this are not +EV",
      "minimum": 0,
      "type": "number"
     },
     "downstreamCostUsd": {
      "description": "USD cost of the target API attempt or success",
      "minimum": 0,
      "type": "number"
     },
     "preflightPriceUsd": {
      "description": "Price of this check. Default 0.002",
      "minimum": 0,
      "type": "number"
     },
     "priorInvalidProbability": {
      "description": "Prior probability the payload is doomed. Default 0.25",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "retryCostUsd": {
      "description": "USD model/tool-turn cost of one failed attempt",
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "downstreamCostUsd",
     "billsOnInvalidRequest",
     "retryCostUsd"
    ],
    "type": "object"
   },
   "request": {
    "properties": {
     "body": {
      "description": "JSON body checked against schema"
     },
     "headers": {
      "additionalProperties": {
       "type": "string"
      },
      "description": "HTTP headers as string key/value pairs",
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "method": {
      "description": "HTTP method of the proposed request",
      "type": "string"
     },
     "query": {
      "additionalProperties": {},
      "description": "Query parameters",
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "url": {
      "description": "Absolute http(s) URL. This tool never fetches the URL.",
      "type": "string"
     }
    },
    "required": [
     "method",
     "url"
    ],
    "type": "object"
   },
   "schema": {
    "additionalProperties": {},
    "description": "JSON Schema applied to request.body",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "request",
   "schema"
  ],
  "type": "object"
 },
 "name": "check_request",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "economics": {
    "additionalProperties": false,
    "properties": {
     "aPrioriExpectedNetUsd": {
      "type": "number"
     },
     "aPrioriExpectedWasteUsd": {
      "type": "number"
     },
     "decision": {
      "enum": [
       "proceed",
       "abort"
      ],
      "type": "string"
     },
     "preflightPriceUsd": {
      "type": "number"
     },
     "realizedNetUsd": {
      "type": "number"
     },
     "reason": {
      "enum": [
       "valid",
       "invalid_doomed_request"
      ],
      "type": "string"
     },
     "wasteIfSentUsd": {
      "type": "number"
     },
     "worthCheckingAPriori": {
      "type": "boolean"
     }
    },
    "required": [
     "decision",
     "reason",
     "preflightPriceUsd",
     "wasteIfSentUsd",
     "realizedNetUsd",
     "worthCheckingAPriori",
     "aPrioriExpectedWasteUsd",
     "aPrioriExpectedNetUsd"
    ],
    "type": "object"
   },
   "errors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "requestHash": {
    "type": "string"
   },
   "valid": {
    "type": "boolean"
   },
   "warnings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "valid",
   "errors",
   "warnings",
   "requestHash"
  ],
  "type": "object"
 },
 "title": "Check Request"
}
