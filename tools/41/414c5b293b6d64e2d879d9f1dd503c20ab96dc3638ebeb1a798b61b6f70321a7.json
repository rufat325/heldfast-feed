{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set Custom Field Values"
 },
 "description": "Set or clear custom field values for a CRM entity. Values are stored as strings; pass null to clear a value.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "entityId": {
    "description": "Entity ID",
    "type": "string"
   },
   "entityType": {
    "description": "Entity type",
    "enum": [
     "account",
     "contact",
     "deal",
     "booking",
     "ticket",
     "product",
     "post"
    ],
    "type": "string"
   },
   "values": {
    "description": "Values to upsert",
    "items": {
     "properties": {
      "definitionId": {
       "description": "Custom field definition ID",
       "type": "string"
      },
      "value": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Value to store, or null to clear"
      }
     },
     "required": [
      "definitionId",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "entityType",
   "entityId",
   "values"
  ],
  "type": "object"
 },
 "name": "set_custom_field_values",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
