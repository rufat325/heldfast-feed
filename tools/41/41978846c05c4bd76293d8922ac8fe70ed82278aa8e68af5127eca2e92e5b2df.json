{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search SaaSCity listings"
 },
 "description": "Search products listed on SaaSCity by keyword and/or category. Returns title, tagline, category, upvote points, the listing page and the product site. Useful for market research (\"what else exists in this space?\") before a launch.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Listing category id",
    "enum": [
     "ai",
     "saas",
     "productivity",
     "devtools",
     "design",
     "marketing",
     "fintech",
     "health",
     "mobile",
     "games",
     "web3",
     "molt",
     "directories",
     "other"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Results per page",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Skip this many results (pagination)",
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Keyword matched against title and tagline",
    "type": "string"
   },
   "sort": {
    "default": "points",
    "description": "points = most upvoted first",
    "enum": [
     "points",
     "newest"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_listings",
 "outputSchema": {
  "properties": {
   "listings": {
    "items": {
     "properties": {
      "category": {
       "type": "string"
      },
      "pageUrl": {
       "description": "SaaSCity listing page",
       "type": "string"
      },
      "points": {
       "description": "Community upvote points",
       "type": "integer"
      },
      "slug": {
       "description": "Pass to get_listing or find_alternatives",
       "type": "string"
      },
      "tagline": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "websiteUrl": {
       "description": "The product site",
       "type": "string"
      }
     },
     "required": [
      "title",
      "tagline",
      "slug",
      "category",
      "points",
      "pageUrl",
      "websiteUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "offset": {
    "type": "integer"
   }
  },
  "required": [
   "listings",
   "offset"
  ],
  "type": "object"
 },
 "title": "Search SaaSCity listings"
}
