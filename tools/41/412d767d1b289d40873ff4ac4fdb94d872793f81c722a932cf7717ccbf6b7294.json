{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update run status, end time, or name",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "endTime": {
    "description": "Unix timestamp (ms) of run end",
    "type": "number"
   },
   "runId": {
    "description": "Run ID",
    "type": "string"
   },
   "runName": {
    "type": "string"
   },
   "status": {
    "enum": [
     "RUNNING",
     "SCHEDULED",
     "FINISHED",
     "FAILED",
     "KILLED"
    ],
    "type": "string"
   }
  },
  "required": [
   "runId"
  ],
  "type": "object"
 },
 "name": "update-run"
}
