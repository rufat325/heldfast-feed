 "description": "Compare CAMELS-style health scores across a group of FDIC-insured institutions.\n\nThree usage modes:\n  - Explicit list: provide certs (up to 50) for a specific comparison set\n  - State-wide scan: provide state to compare all active institutions in that state\n  - Asset-based: provide asset_min/asset_max to compare institutions by size\n\nOptionally provide cert to highlight a subject institution's position in the ranking.\n\nOutput: structuredContent includes {model, official_status, report_date, institutions, metrics, peer_context, proxy_summary, proxy, deprecations}. Institutions include proxy scores and name_source. When a subject cert is provided, metrics[] is the preferred subject-vs-peer array for new UI bindings and proxy_summary is a flattened subject proxy. peer_context.subject_percentiles is deprecated, remains for backward compatibility, and is targeted for removal only in a future coordinated major release. Auto-peer selection derives asset bands from report-date financials and broadens the cohort if fewer than 10 peers match.\n\nNOTE: Public off-site analytical proxy \u2014 not official supervisory ratings.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "asset_max": {
    "description": "Maximum total assets ($thousands) for peer selection.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "asset_min": {
    "description": "Minimum total assets ($thousands) for peer selection.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "cert": {
    "description": "Subject institution CERT to highlight in the ranking. Optional.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "certs": {
    "description": "Explicit list of CERTs to compare (max 50).",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 50,
    "type": "array"
   },
   "limit": {
    "default": 25,
    "description": "Max institutions to return in the response.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "repdte": {
    "description": "Report Date (YYYYMMDD). Defaults to the most recent quarter.",
    "pattern": "^\\d{8}$",
    "type": "string"
   },
   "sort_by": {
    "default": "composite",
    "description": "Sort results by composite or a specific CAMELS component rating.",
    "enum": [
     "composite",
     "capital",
     "asset_quality",
     "earnings",
     "liquidity",
     "sensitivity"
    ],
    "type": "string"
   },
   "state": {
    "description": "Two-letter state code to select all active institutions (e.g., \"WY\").",
    "pattern": "^[A-Z]{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
