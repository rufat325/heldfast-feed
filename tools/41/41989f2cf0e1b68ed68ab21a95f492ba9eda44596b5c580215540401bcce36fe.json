{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Creates a single-use 10-minute deposit. Compute the size and the SHA-256 of the local PDF.\n\n    Transfer the bytes to upload_url with PUT, Content-Type application/pdf,\n    with the headers returned. Do not publish these headers in your reply.\n    This ticket allows no reading and is not an API key for the account.\n    ",
 "inputSchema": {
  "properties": {
   "filename": {
    "maxLength": 240,
    "minLength": 1,
    "title": "Filename",
    "type": "string"
   },
   "guest_mode": {
    "default": false,
    "title": "Guest Mode",
    "type": "boolean"
   },
   "language": {
    "default": "fr",
    "maxLength": 5,
    "title": "Language",
    "type": "string"
   },
   "notice_version": {
    "default": "",
    "title": "Notice Version",
    "type": "string"
   },
   "sha256": {
    "pattern": "^[a-fA-F0-9]{64}$",
    "title": "Sha256",
    "type": "string"
   },
   "size_bytes": {
    "minimum": 1,
    "title": "Size Bytes",
    "type": "integer"
   },
   "title": {
    "default": "",
    "maxLength": 240,
    "title": "Title",
    "type": "string"
   }
  },
  "required": [
   "filename",
   "size_bytes",
   "sha256"
  ],
  "title": "prepare_uploadArguments",
  "type": "object"
 },
 "name": "foliade_prepare_upload",
 "title": "Prepare the private upload of a PDF"
}
