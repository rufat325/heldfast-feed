{"annotations":{"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Calculates the required copper or aluminium cable cross-section for a residential circuit under the Belgian AREI/RGIE: design current, voltage drop per cross-section, protection check against the breaker rating and the recommended cross-section. Provide the load (A, W, kW or kVA), one-way cable length in metres, the network (1x230V, 3x230V, 3x400V) and the breaker rating; other fields use the defaults for a typical socket circuit. The response includes a shareable link that opens the same calculation on planelec.be.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"breakerAmps":{"description":"Circuit-breaker rating in A. Default: 16.","exclusiveMinimum":0,"type":"number"},"circuitKind":{"description":"\u2018lighting\u2019 applies the 3% voltage-drop limit, \u2018other\u2019 5%.","enum":["lighting","other"],"type":"string"},"circuitPhases":{"description":"Circuit type; three-phase requires a 3x network.","enum":["single","three"],"type":"string"},"cosPhi":{"description":"Power factor 0\u20131. Default: 0.95.","exclusiveMinimum":0,"maximum":1,"type":"number"},"lengthM":{"description":"One-way cable length in metres. Default: 30.","exclusiveMinimum":0,"type":"number"},"loadUnit":{"description":"Unit of loadValue. Default: A.","enum":["A","W","kW","kVA"],"type":"string"},"loadValue":{"description":"Load magnitude in loadUnit. Default: 16.","exclusiveMinimum":0,"type":"number"},"locale":{"description":"Language of source titles and links (nl, fr, de, en). Defaults to the server setting.","enum":["nl","fr","de","en"],"type":"string"},"material":{"description":"Conductor material. Default: CU.","enum":["CU","AL"],"type":"string"},"mode":{"description":"\u2018plan\u2019 recommends a cross-section; \u2018check\u2019 evaluates selectedCrossSectionMm2.","enum":["check","plan"],"type":"string"},"network":{"description":"Supply network. Default: 1x230V.","enum":["1x230V","3x230V","3x400V"],"type":"string"},"nominalVoltage":{"description":"Optional override of the nominal voltage (\u2264 1000 V).","exclusiveMinimum":0,"maximum":1000,"type":"number"},"selectedCrossSectionMm2":{"description":"Cross-section to evaluate in \u2018check\u2019 mode.","enum":[1.5,2.5,4,6,10,16,25,35,50],"type":"number"}},"type":"object"},"name":"size_cable_arei","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":{},"properties":{"activePowerW":{"type":"number"},"comparison":{"items":{"additionalProperties":{},"properties":{"crossSectionMm2":{"type":"number"},"dropPercent":{"type":"number"},"dropVolts":{"type":"number"},"maxLengthM":{"type":"number"}},"required":["crossSectionMm2","dropVolts","dropPercent","maxLengthM"],"type":"object"},"type":"array"},"currentAmps":{"type":"number"},"input":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"maxVoltageDropPercent":{"type":"number"},"nextSteps":{"items":{"additionalProperties":false,"properties":{"label":{"type":"string"},"url":{"type":"string"}},"required":["label","url"],"type":"object"},"type":"array"},"nominalVoltage":{"type":"number"},"overallStatus":{"enum":["pass","fail","not_evaluated"],"type":"string"},"source":{"additionalProperties":false,"properties":{"title":{"type":"string"},"url":{"type":"string"}},"required":["title","url"],"type":"object"}},"required":["currentAmps","activePowerW","nominalVoltage","maxVoltageDropPercent","comparison","overallStatus","input","source","nextSteps"],"type":"object"},"title":"Size a cable per AREI/RGIE"}
