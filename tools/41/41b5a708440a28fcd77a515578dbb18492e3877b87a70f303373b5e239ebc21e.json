{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a durable research task when deterministic knowledge has no applicable answer.",
 "execution": {
  "taskSupport": "optional"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "context": {
    "properties": {
     "model": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "operating_system": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "runtime_mode": {
      "enum": [
       "normal",
       "rescue",
       "installer",
       "update",
       "uninstall",
       "recovery",
       "diagnostic"
      ],
      "type": "string"
     },
     "shell_environment": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "vendor": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9()._\\-/]*$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "question": {
    "maxLength": 2000,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "question",
   "context"
  ],
  "type": "object"
 },
 "name": "request_expert_answer",
