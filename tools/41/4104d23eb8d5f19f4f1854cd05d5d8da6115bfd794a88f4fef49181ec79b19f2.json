{
 "description": "Generate a day-by-day Armenia itinerary grounded in Revamp's live catalog (real stays, tours, experiences, restaurants). Returns a structured plan.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "budget": {
    "description": "Default 'mid-range'.",
    "enum": [
     "budget",
     "mid-range",
     "comfort"
    ],
    "type": "string"
   },
   "days": {
    "description": "Trip length in days.",
    "maximum": 14,
    "minimum": 1,
    "type": "integer"
   },
   "interests": {
    "description": "e.g. ['hiking','wine','history','food'].",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pace": {
    "description": "Default 'balanced'.",
    "enum": [
     "relaxed",
     "balanced",
     "packed"
    ],
    "type": "string"
   },
   "startCity": {
    "description": "Base city (default 'Yerevan').",
    "type": "string"
   },
   "travelers": {
    "description": "Number of travelers (default 2).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "days"
  ],
  "type": "object"
 },
 "name": "plan_trip",
 "title": "Plan an Armenia trip"
}
