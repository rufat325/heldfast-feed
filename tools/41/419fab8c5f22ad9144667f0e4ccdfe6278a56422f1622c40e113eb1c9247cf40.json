{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List relations for a single ticket. For all relations in a project, use relation_list_all instead.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "ticket": {
    "description": "Ticket title",
    "type": "string"
   }
  },
  "required": [
   "ticket"
  ],
  "type": "object"
 },
 "name": "relation_list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
     "additionalProperties": false,
     "properties": {
      "direction": {
       "enum": [
        "outgoing",
        "incoming",
        "both"
       ],
       "type": "string"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "relation_type": {
       "type": "string"
      },
      "ticket_id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "ticket_title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "relation_type",
      "ticket_id",
      "ticket_title",
      "direction"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
