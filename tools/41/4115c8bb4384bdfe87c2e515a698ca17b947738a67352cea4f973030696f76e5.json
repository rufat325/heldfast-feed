  "title": "Search JS Fingerprint Patterns"
 },
 "description": "List scanned JavaScript files that match code-pattern filters: has_eval, has_crypto, high_entropy, no_library and cdn_mismatch, where false selects files without the pattern and filters can be combined. With no filter given, has_eval=true is applied. Each result has the fingerprint ID, scan, script URL, code length, obfuscation score and the patterns detected.",
 "inputSchema": {
  "properties": {
   "cdn_mismatch": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Cdn Mismatch"
   },
   "has_crypto": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Has Crypto"
   },
   "has_eval": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Has Eval"
   },
   "high_entropy": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "High Entropy"
   },
   "limit": {
    "default": 20,
    "title": "Limit",
    "type": "integer"
   },
   "no_library": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "No Library"
   }
  },
  "title": "search_js_fingerprint_patternsArguments",
  "type": "object"
 },
 "name": "search_js_fingerprint_patterns",
