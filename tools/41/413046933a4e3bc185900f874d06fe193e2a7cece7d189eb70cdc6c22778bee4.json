{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Read the full structured execution dossier for one MartinLoop run, including attempts, events, artifacts, verification, integrity, cost, and related discovery surfaces. Provide exactly one selector: file, loopId, or latest; runsDir changes the run-store root. Use for comprehensive evidence review. Do not use for a compact state check; use martin_get_run, or use martin_dossier when formatted sharing output is required.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "file": {
    "description": "Path to a canonical loop-record.json, legacy file, or run-store directory. Mutually exclusive with loopId and latest.",
    "type": "string"
   },
   "latest": {
    "const": true,
    "description": "When true, loads the most recently updated loop record. Mutually exclusive with file and loopId."
   },
   "loopId": {
    "description": "Loop ID under the run store. Mutually exclusive with file and latest.",
    "type": "string"
   },
   "runsDir": {
    "description": "Optional run-store root override used to resolve loopId or latest.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "martin_run_dossier",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "artifacts": {
    "additionalProperties": true,
    "properties": {
     "highlights": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "artifactId": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "uri": {
         "type": "string"
        }
       },
       "required": [
        "artifactId",
        "kind",
        "label",
        "uri"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "kinds": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object"
     },
     "totalCount": {
      "type": "integer"
     }
    },
    "required": [
     "totalCount",
     "kinds",
     "highlights"
    ],
    "type": "object"
   },
   "attempts": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "adapterId": {
       "type": "string"
      },
      "artifactFiles": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "artifacts": {
       "additionalProperties": false,
       "properties": {
        "available": {
         "type": "boolean"
        },
        "directory": {
         "type": "string"
        },
        "files": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "directory",
        "available",
        "files"
       ],
       "type": "object"
      },
      "attemptId": {
       "type": "string"
      },
      "completedAt": {
       "type": "string"
      },
      "failureClass": {
       "type": "string"
      },
      "index": {
       "type": "integer"
      },
      "intervention": {
       "type": "string"
      },
      "model": {
       "type": "string"
      },
      "startedAt": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "index"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "budget": {
    "additionalProperties": false,
    "properties": {
     "maxIterations": {
      "type": "integer"
     },
     "maxTokens": {
      "type": "integer"
     },
     "maxUsd": {
      "type": "number"
     },
     "softLimitUsd": {
      "type": "number"
     }
    },
    "required": [
     "maxUsd",
     "softLimitUsd",
     "maxIterations"
    ],
    "type": "object"
   },
   "cost": {
    "additionalProperties": false,
    "properties": {
     "actualUsd": {
      "type": "number"
     },
     "avoidedUsd": {
      "type": "number"
     },
     "provenance": {
      "enum": [
       "actual",
       "calculated",
       "estimated",
       "unavailable"
      ],
      "type": "string"
     },
     "tokensIn": {
      "type": "integer"
     },
     "tokensOut": {
      "type": "integer"
     }
    },
    "required": [
     "actualUsd",
     "avoidedUsd",
     "tokensIn",
     "tokensOut",
     "provenance"
    ],
    "type": "object"
   },
   "inspection": {
    "additionalProperties": true,
    "properties": {
     "canonicalLoopRecordPath": {
      "type": "string"
     },
     "canonicalRunDirectory": {
      "type": "string"
     },
     "ledgerPath": {
      "type": "string"
     },
     "loopRecordPath": {
      "type": "string"
     },
     "runDirectory": {
      "type": "string"
     },
     "runsRoot": {
      "type": "string"
     }
    },
    "required": [
     "runsRoot"
    ],
    "type": "object"
   },
   "loop": {
    "additionalProperties": true,
    "properties": {
     "activeAttemptId": {
      "description": "ID of the currently active attempt, when a run is in progress.",
      "type": "string"
     },
     "attempts": {
      "type": "integer"
     },
     "avoidedUsd": {
      "type": "number"
     },
     "costUsd": {
      "type": "number"
     },
     "createdAt": {
      "type": "string"
     },
     "lastAttempt": {
      "additionalProperties": true,
      "type": "object"
     },
     "lifecycleState": {
      "type": "string"
     },
     "loopId": {
      "type": "string"
     },
     "objective": {
      "type": "string"
     },
     "pressure": {
      "type": "string"
     },
     "remainingBudgetUsd": {
      "type": "number"
     },
     "remainingIterations": {
      "type": "integer"
     },
     "remainingTokens": {
      "type": "integer"
     },
     "shouldStop": {
      "type": "boolean"
     },
     "status": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "loopId",
     "title",
     "objective",
     "status",
     "lifecycleState",
     "attempts",
     "costUsd",
     "avoidedUsd",
     "pressure",
     "shouldStop",
     "remainingBudgetUsd",
     "remainingIterations"
    ],
    "type": "object"
   },
   "recentEvents": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "lifecycleState": {
       "type": "string"
      },
      "payload": {
       "additionalProperties": true,
       "type": "object"
      },
      "timestamp": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "payload"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "related": {
    "additionalProperties": false,
    "properties": {
     "prompts": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "resources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "resources",
     "prompts"
    ],
    "type": "object"
   },
   "source": {
    "type": "string"
   },
   "sourceKind": {
    "enum": [
     "file",
     "loop_id",
     "latest",
     "runs_root"
    ],
    "type": "string"
   },
   "verification": {
    "additionalProperties": true,
    "properties": {
     "completedAt": {
      "type": "string"
     },
     "eventCount": {
      "type": "integer"
     },
     "latestAttemptIndex": {
      "type": "integer"
     },
     "ledgerEventCount": {
      "type": "integer"
     },
     "status": {
      "enum": [
       "passed",
       "failed",
       "contradicted",
       "not_run"
      ],
      "type": "string"
     },
     "steps": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "command": {
         "type": "string"
        },
        "detail": {
         "type": "string"
        },
        "exitCode": {
         "type": "integer"
        },
        "fastFail": {
         "type": "boolean"
        },
        "launched": {
         "type": "boolean"
        },
        "timedOut": {
         "type": "boolean"
        }
       },
       "required": [
        "command",
        "launched"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "summary": {
      "type": "string"
     },
     "warnings": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "status",
     "eventCount",
     "ledgerEventCount",
     "warnings"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "source",
   "sourceKind",
   "loop",
   "budget",
   "cost",
   "attempts",
   "verification",
   "artifacts",
   "recentEvents",
   "related",
   "inspection",
   "warnings"
  ],
  "type": "object"
 }
}
