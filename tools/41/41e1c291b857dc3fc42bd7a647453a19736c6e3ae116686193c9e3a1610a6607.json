{
 "description": "Capture a performance baseline for a package: memory, CPU, frame stats, battery, and network state. Saves to a timestamped JSON file for later comparison with adb_regression_check.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "label": {
    "default": "baseline",
    "description": "Label for this baseline (e.g., 'before-refactor', 'v2.5.0')",
    "type": "string"
   },
   "packageName": {
    "description": "Package name to profile",
    "type": "string"
   }
  },
  "required": [
   "packageName"
  ],
  "type": "object"
 },
 "name": "adb_regression_baseline"
}
