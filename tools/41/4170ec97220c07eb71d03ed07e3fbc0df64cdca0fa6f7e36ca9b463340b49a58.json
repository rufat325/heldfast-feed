{
 "_meta": {
  "openai/toolInvocation/invoked": "Source file read",
  "openai/toolInvocation/invoking": "Reading a source file"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return the bytes of one source file (the platform's editable copy of the pre-build code), letting an AI in any future chat fetch and edit content without needing the original local files. Use list_source_files first to discover paths. For the served dist, use read_file instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxBytes": {
    "description": "Per-file size cap. Default 1048576, hard max 5242880.",
    "exclusiveMinimum": 0,
    "maximum": 5242880,
    "type": "integer"
   },
   "name": {
    "type": "string"
   },
   "path": {
    "description": "Site-relative path inside the source tree, e.g. 'src/App.tsx'.",
    "type": "string"
   },
   "siteId": {
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "read_source_file",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "type": "string"
   },
   "encoding": {
    "enum": [
     "utf8",
     "base64"
    ],
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "path": {
    "type": "string"
   },
   "siteId": {
    "type": "string"
   },
   "size": {
    "type": "number"
   }
  },
  "required": [
   "siteId",
   "name",
   "path",
   "size",
   "encoding",
   "content"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "sites:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Read a file from the editable source tree"
}
