{
 "_meta": {
  "ui": {
   "resourceUri": "ui://agent-manager.dev/docs-browser"
  }
 },
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return the title, description, section, URL and Markdown URL of every page this site publishes. Use it to see the shape of the documentation before reading a page.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "section": {
    "description": "Limit to one section: Site, Documentation or Writing.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_doc_pages",
 "outputSchema": {
  "$defs": {
   "page": {
    "properties": {
     "description": {
      "type": "string"
     },
     "markdown_url": {
      "type": "string"
     },
     "section": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "title",
     "url"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "count": {
    "type": "integer"
   },
   "pages": {
    "items": {
     "$ref": "#/$defs/page"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "pages"
  ],
  "type": "object"
 },
 "title": "List every page on agent-manager.dev"
}
