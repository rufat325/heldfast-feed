{
 "description": "Deploy a Floom app directly from a GitHub repository URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "github_ref": {
    "description": "Branch or tag to deploy (default: main)",
    "type": "string"
   },
   "github_url": {
    "description": "GitHub repository URL (e.g. \"https://github.com/user/repo\")",
    "type": "string"
   },
   "name": {
    "description": "Project name",
    "type": "string"
   }
  },
  "required": [
   "github_url",
   "name"
  ],
  "type": "object"
 },
 "name": "deploy_from_github"
}
