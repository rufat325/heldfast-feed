{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Contribute an Anonymized Delta"
 },
 "description": "Deliberately send one anonymized delta (opened or outcome) to the scvd aggregation endpoint. Requires consent on record; refuses fields the privacy sentence forbids.",
 "inputSchema": {
  "examples": [
   {
    "category": "hosting",
    "kind": "opened",
    "tool_name": "vercel",
    "week": "2026-W35"
   }
  ],
  "properties": {
   "category": {
    "description": "the closed category list",
    "enum": [
     "llm",
     "agent-framework",
     "image-gen",
     "video-gen",
     "seo",
     "aso",
     "analytics",
     "hosting",
     "database",
     "email",
     "social-scheduling",
     "design",
     "dev-tool",
     "mcp-server",
     "api-service",
     "streaming",
     "music",
     "news",
     "vpn",
     "storage",
     "domain",
     "other"
    ],
    "type": "string"
   },
   "kind": {
    "description": "opened when a trial began; outcome when it resolved",
    "enum": [
     "opened",
     "outcome"
    ],
    "type": "string"
   },
   "outcome": {
    "description": "outcome only: how the trial resolved",
    "enum": [
     "kept_past_conversion",
     "canceled_pre_conversion",
     "canceled_post_conversion",
     "replaced"
    ],
    "type": "string"
   },
   "replaced_with": {
    "description": "replaced only: the tool that took over",
    "type": "string"
   },
   "signup_friction": {
    "description": "what the signup path demanded",
    "enum": [
     "agent_native",
     "email_only",
     "phone_required",
     "kyc_required",
     "human_only"
    ],
    "type": "string"
   },
   "tool_name": {
    "description": "canonical lowercase name",
    "type": "string"
   },
   "week": {
    "description": "ISO week the delta belongs to, e.g. 2026-W35",
    "type": "string"
   },
   "weeks_held": {
    "description": "outcome only: whole weeks between opening and resolving",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "kind",
   "tool_name",
   "category"
  ],
  "type": "object"
 },
 "name": "contribute_anonymized_delta",
 "title": "Contribute an Anonymized Delta"
}
