{
 "description": "Launches an app on the device",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "app_id": {
    "pattern": "^[\\w\\-.:]{1,256}$",
    "type": "string"
   },
   "device_id": {
    "pattern": "^[\\w\\-.:]{1,256}$",
    "type": "string"
   }
  },
  "required": [
   "device_id",
   "app_id"
  ],
  "type": "object"
 },
 "name": "launch_app"
}
