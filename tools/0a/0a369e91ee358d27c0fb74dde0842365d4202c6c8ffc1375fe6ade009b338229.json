{
 "description": "v0.1 capability-token sink challenge (M1). Sink issues a signed canonical action statement. Returns the SinkChallenge and its challenge_hash. Used to bind the gateway's later policy evaluation to a specific action the sink authored. Search keywords: capability token, sink challenge, M1.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "action": {
    "description": "Canonical action statement",
    "properties": {
     "kind": {
      "type": "string"
     },
     "parameters": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "resource_version": {
      "type": "string"
     },
     "target": {
      "type": "string"
     }
    },
    "required": [
     "kind",
     "target",
     "parameters",
     "resource_version"
    ],
    "type": "object"
   },
   "required_policy_freshness": {
    "properties": {
     "beacon_hash_required": {
      "type": "boolean"
     },
     "max_age_seconds": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "max_age_seconds",
     "beacon_hash_required"
    ],
    "type": "object"
   },
   "sink_id": {
    "description": "DID of the sink issuing the challenge",
    "type": "string"
   },
   "sink_private_key": {
    "description": "Sink Ed25519 private key (hex)",
    "type": "string"
   },
   "sink_public_key": {
    "description": "Sink Ed25519 public key (hex)",
    "type": "string"
   },
   "subject_id": {
    "description": "DID of the subject the challenge is addressed to",
    "type": "string"
   },
   "validity_seconds": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "sink_id",
   "subject_id",
   "action",
   "sink_private_key",
   "sink_public_key"
  ],
  "type": "object"
 },
 "name": "aps_capability_issue_challenge"
}
