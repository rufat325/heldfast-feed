{
 "description": "Per-stage farm artifacts for an embodied episode (Lane-4 'returns artifacts' leg): status, opaque stage-version digest, input hash, metrics, cost cents + coarse MANAGED|BYOK mode, opaque download ref + downloadPath resolver, attempts; processed flips true when every stage is terminal with at least one OK. Fails closed 409 until PII scrub + household consent clear. Buyer-boundary safe. Requires episodes:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "episodeId": {
    "type": "string"
   }
  },
  "required": [
   "episodeId"
  ],
  "type": "object"
 },
 "name": "opentrain_episode_artifacts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "artifacts": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "attempts": {
         "type": "number"
        },
        "costCents": {
         "type": "number"
        },
        "costMode": {
         "anyOf": [
          {
           "enum": [
            "MANAGED",
            "BYOK"
           ],
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "createdAt": {
         "type": "string"
        },
        "downloadPath": {
         "type": [
          "string",
          "null"
         ]
        },
        "downloadRef": {
         "type": [
          "string",
          "null"
         ]
        },
        "inputHash": {
         "type": [
          "string",
          "null"
         ]
        },
        "metrics": {
         "anyOf": [
          {
           "additionalProperties": {
            "type": [
             "number",
             "boolean"
            ]
           },
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "stage": {
         "type": "string"
        },
        "status": {
         "enum": [
          "PENDING",
          "RUNNING",
          "OK",
          "FAILED"
         ],
         "type": "string"
        },
        "version": {
         "type": "string"
        }
       },
       "required": [
        "stage",
        "status",
        "version",
        "inputHash",
        "metrics",
        "costCents",
        "costMode",
        "downloadRef",
        "downloadPath",
        "attempts",
        "createdAt"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "episodeId": {
      "type": "string"
     },
     "processed": {
      "type": "boolean"
     }
    },
    "required": [
     "episodeId",
     "processed",
     "artifacts"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
