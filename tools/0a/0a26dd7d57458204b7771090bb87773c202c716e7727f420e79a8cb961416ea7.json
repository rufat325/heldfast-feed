{
 "description": "Submit a contribution to a robotics collection program AS THE TOKEN OWNER (contributor personal token, robotics:write). Teleop programs take teleop: {repoId, episodeIndex} (a public LeRobot dataset episode); egocentric programs take upload: {url, sha256} (a finalized field-capture ref). Set acceptConsent: true after showing the program attestation. Runs the full contributor rails \u2014 eligibility, consent, the hardware-kit gate, auto-QA, dedup, scrub quarantine, teleop ingest.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "acceptConsent": {
    "const": true,
    "type": "boolean"
   },
   "projectId": {
    "type": "string"
   },
   "teleop": {
    "additionalProperties": false,
    "properties": {
     "captureNotes": {
      "type": "string"
     },
     "episodeIndex": {
      "minimum": 0,
      "type": "integer"
     },
     "repoId": {
      "type": "string"
     }
    },
    "required": [
     "repoId",
     "episodeIndex"
    ],
    "type": "object"
   },
   "upload": {
    "additionalProperties": false,
    "properties": {
     "mime": {
      "type": "string"
     },
     "sha256": {
      "type": "string"
     },
     "storageKey": {
      "type": "string"
     }
    },
    "required": [
     "storageKey",
     "sha256"
    ],
    "type": "object"
   }
  },
  "required": [
   "projectId",
   "acceptConsent"
  ],
  "type": "object"
 },
 "name": "opentrain_submit_collection_contribution",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
