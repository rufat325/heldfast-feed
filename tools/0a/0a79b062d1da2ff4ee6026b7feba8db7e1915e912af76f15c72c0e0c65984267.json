{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Set custom field values on a test case execution. customFields use string IDs (e.g. 'qcf_1337') with value and optional cascadeValue. Requires the cycle id and testCaseExecutionId.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "customFields": {
    "description": "Custom field values to set",
    "items": {
     "additionalProperties": false,
     "properties": {
      "cascadeValue": {
       "description": "Cascade dropdown value",
       "type": "string"
      },
      "id": {
       "description": "Custom field ID, e.g. qcf_1",
       "type": "string"
      },
      "value": {
       "description": "Field value",
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "cycleId": {
    "description": "Test cycle ID",
    "type": [
     "string",
     "number"
    ]
   },
   "testCaseExecutionId": {
    "description": "Test case execution ID",
    "type": [
     "string",
     "number"
    ]
   }
  },
  "required": [
   "cycleId",
   "testCaseExecutionId",
   "customFields"
  ],
  "type": "object"
 },
 "name": "qtm4j_update_execution_custom_fields",
 "title": "Update Test Case Execution Custom Fields"
}
