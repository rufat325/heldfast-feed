{
 "description": "Poll an automatic schema creation run until it reaches completed, completed_with_errors, or failed. The terminal result preserves generated template IDs, saved documents, failed-document details, and retryability.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_url": {
    "description": "Optional API base URL. Defaults to SUPARSE_API_URL or Suparse production API.",
    "format": "uri",
    "type": "string"
   },
   "max_poll_attempts": {
    "description": "Maximum status requests before timing out. Defaults to the SDK client setting.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "poll_interval": {
    "description": "Seconds between status requests. Defaults to the SDK client setting.",
    "minimum": 0,
    "type": "number"
   },
   "run_id": {
    "description": "Quick schema creation run ID.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "run_id"
  ],
  "type": "object"
 },
 "name": "wait_for_quick_schema_creation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "result": {
    "anyOf": [
     {
      "additionalProperties": true,
      "properties": {
       "can_retry_failed": {
        "type": "boolean"
       },
       "error_code": {
        "type": "string"
       },
       "error_message": {
        "type": "string"
       },
       "failed_documents_count": {
        "type": [
         "number",
         "null"
        ]
       },
       "parent_document_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "path": {
        "type": "string"
       },
       "stage": {
        "type": "string"
       },
       "status": {
        "const": "failed",
        "type": "string"
       },
       "total_documents": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "status",
       "stage",
       "error_code",
       "error_message",
       "path",
       "can_retry_failed"
      ],
      "type": "object"
     },
     {
      "additionalProperties": true,
      "properties": {
       "document_id": {
        "type": "string"
       },
       "path": {
        "type": "string"
       },
       "saved_document_id": {
        "type": "string"
       },
       "status": {
        "const": "completed",
        "type": "string"
       },
       "template_group_id": {
        "type": "string"
       },
       "template_id": {
        "type": "string"
       }
      },
      "required": [
       "status",
       "document_id",
       "saved_document_id",
       "template_id",
       "template_group_id",
       "path"
      ],
      "type": "object"
     },
     {
      "additionalProperties": true,
      "properties": {
       "can_retry_failed": {
        "type": "boolean"
       },
       "completed_documents": {
        "type": "number"
       },
       "failed_documents": {
        "items": {
         "additionalProperties": true,
         "properties": {
          "error_code": {
           "type": "string"
          },
          "ordinal": {
           "type": "number"
          },
          "page_end": {
           "type": "number"
          },
          "page_start": {
           "type": "number"
          },
          "retryable": {
           "type": "boolean"
          }
         },
         "required": [
          "ordinal",
          "page_start",
          "page_end",
          "error_code",
          "retryable"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "failed_documents_count": {
        "type": "number"
       },
       "parent_document_id": {
        "type": "string"
       },
       "path": {
        "const": "multiple",
        "type": "string"
       },
       "saved_documents": {
        "items": {
         "additionalProperties": true,
         "properties": {
          "document_id": {
           "type": "string"
          },
          "ordinal": {
           "type": "number"
          },
          "page_end": {
           "type": "number"
          },
          "page_start": {
           "type": "number"
          },
          "schema_source": {
           "type": "string"
          },
          "template_group_id": {
           "type": "string"
          },
          "template_id": {
           "type": "string"
          }
         },
         "required": [
          "document_id",
          "template_id",
          "template_group_id",
          "ordinal",
          "page_start",
          "page_end",
          "schema_source"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "status": {
        "enum": [
         "completed",
         "completed_with_errors"
        ],
        "type": "string"
       },
       "total_documents": {
        "type": "number"
       }
      },
      "required": [
       "status",
       "path",
       "parent_document_id",
       "total_documents",
       "completed_documents",
       "failed_documents_count",
       "saved_documents",
       "failed_documents",
       "can_retry_failed"
      ],
      "type": "object"
     }
    ]
   },
   "run_id": {
    "type": "string"
   }
  },
  "required": [
   "run_id",
   "result"
  ],
  "type": "object"
 },
 "title": "Wait for Quick Schema Creation"
}
