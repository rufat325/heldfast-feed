{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when an insurer, auditor or buyer asks what evidence exists about an agent or supplier. Pass its `subject` (public id or https URL). Returns conformance, watch, witness, repair and incident records with Merkle proofs, plus gaps. A compilation, not certification or advice. Free, read-only, no account; inputs must be public and non-personal.",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "requester": {
     "purpose": "INSURER"
    },
    "scope": {
     "max_items": 50,
     "since": "2026-09-01"
    },
    "subject": {
     "counterparty_id": "example-weather-agent"
    }
   }
  ],
  "properties": {
   "requester": {
    "additionalProperties": false,
    "description": "Optional: {purpose, continuity_handle} to include your own receipts.",
    "properties": {
     "continuity_handle": {
      "properties": {
       "continuity_id": {
        "type": "string"
       },
       "token": {
        "type": "string"
       }
      },
      "required": [
       "continuity_id",
       "token"
      ],
      "type": "object"
     },
     "purpose": {
      "enum": [
       "INSURER",
       "AUDITOR",
       "OPERATOR",
       "BUYER",
       "UNSPECIFIED"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "scope": {
    "additionalProperties": false,
    "description": "Optional: {receipt_ids, since, until, categories, max_items}.",
    "properties": {
     "categories": {
      "items": {
       "enum": [
        "conformance",
        "watch",
        "witness",
        "repair",
        "incident",
        "supplier_checks"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "max_items": {
      "maximum": 200,
      "minimum": 1,
      "type": "integer"
     },
     "receipt_ids": {
      "items": {
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     "since": {
      "type": "string"
     },
     "until": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "subject": {
    "description": "The agent or supplier: its public id or https URL. Never a person.",
    "oneOf": [
     {
      "maxLength": 256,
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "counterparty_id": {
        "type": "string"
       },
       "ref": {
        "type": "string"
       },
       "seller_ref": {
        "type": "string"
       },
       "url": {
        "format": "uri",
        "type": "string"
       }
      },
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "subject"
  ],
  "type": "object"
 },
 "name": "gaip_evidence_pack",
 "title": "Build an evidence pack"
}
