{
 "description": "Convert a JSON array to CSV format",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "delimiter": {
    "default": ",",
    "description": "Column delimiter (default: comma)",
    "type": "string"
   },
   "json": {
    "description": "JSON array (or object) to convert",
    "type": "string"
   }
  },
  "required": [
   "json"
  ],
  "type": "object"
 },
 "name": "json_to_csv"
}
