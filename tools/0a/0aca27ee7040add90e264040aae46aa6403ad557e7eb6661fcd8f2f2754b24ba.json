{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check whether materials are ready"
 },
 "description": "Returns material preparation state for the specified application, board-card or listing ids: queued, generating, ready, partial, failed, stale, not_started or not_found. Includes requested and completed assets, edit and lock state, material revision and review-page URL. Reading starts no generation and changes no materials.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "applicationIds": {
    "description": "Application ids from a receipt or a result; a card or listing id on the board also resolves.",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "applicationIds"
  ],
  "type": "object"
 },
 "name": "get_pack_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "packs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "applicationId": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "assets": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "completed": {
           "items": {
            "enum": [
             "resume",
             "coverLetter",
             "answers"
            ],
            "type": "string"
           },
           "type": "array"
          },
          "failed": {
           "items": {
            "enum": [
             "resume",
             "coverLetter",
             "answers"
            ],
            "type": "string"
           },
           "type": "array"
          },
          "requested": {
           "items": {
            "enum": [
             "resume",
             "coverLetter",
             "answers"
            ],
            "type": "string"
           },
           "type": "array"
          }
         },
         "required": [
          "requested",
          "completed",
          "failed"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "coverLettersDisabled": {
       "type": "boolean"
      },
      "edited": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "locked": {
       "type": "boolean"
      },
      "materialsRevision": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "enum": [
        "queued",
        "generating",
        "ready",
        "partial",
        "failed",
        "stale",
        "not_started",
        "not_found"
       ],
       "type": "string"
      },
      "webUrl": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "applicationId",
      "status",
      "assets",
      "edited",
      "materialsRevision",
      "locked",
      "coverLettersDisabled",
      "webUrl"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "packs"
  ],
  "type": "object"
 },
 "title": "Check whether materials are ready"
}
