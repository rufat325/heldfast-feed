{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "videos:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update video"
 },
 "description": "Change a video's title, description, visibility (public/private), player colour or content category. Only the fields given are changed.",
 "inputSchema": {
  "properties": {
   "category": {
    "anyOf": [
     {
      "enum": [
       "gaming",
       "education",
       "music",
       "tech",
       "business",
       "lifestyle",
       "sports",
       "entertainment",
       "news",
       "other"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Content category used for ad targeting; null clears it."
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 5000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "New description; null clears it."
   },
   "player_color": {
    "anyOf": [
     {
      "description": "Player accent colour as a 6-digit hex value, e.g. #22d3ee.",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Player accent colour; null returns to your brand default."
   },
   "title": {
    "description": "New title.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "video_id": {
    "description": "The video's public id (from list_videos / get_video).",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "visibility": {
    "description": "Who can watch: public (anyone with the link / embed) or private (only you).",
    "enum": [
     "public",
     "private"
    ],
    "type": "string"
   }
  },
  "required": [
   "video_id"
  ],
  "type": "object"
 },
 "name": "update_video",
 "securitySchemes": [
  {
   "scopes": [
    "videos:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Update video"
}
