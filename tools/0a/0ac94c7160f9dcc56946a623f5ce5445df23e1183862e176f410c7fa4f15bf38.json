{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true
 },
 "description": "Update an existing assignment in a course.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignment_group_id": {
    "description": "New assignment group ID",
    "type": "number"
   },
   "assignment_id": {
    "description": "The Canvas assignment ID",
    "type": "number"
   },
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "description": {
    "description": "New assignment description (HTML supported)",
    "type": "string"
   },
   "due_at": {
    "description": "New due date in ISO 8601 format (e.g. 2026-05-01T23:59:00Z)",
    "type": "string"
   },
   "name": {
    "description": "New assignment name",
    "type": "string"
   },
   "points_possible": {
    "description": "New maximum points",
    "type": "number"
   },
   "submission_types": {
    "description": "New allowed submission types",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "course_id",
   "assignment_id"
  ],
  "type": "object"
 },
 "name": "update_assignment",
 "title": "Update Assignment"
}
