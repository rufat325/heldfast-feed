 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Sets the company's business address. Always present the user with BOTH options: pass source = ADDRESS_SOURCE_OWN with their own address, which may be anywhere in the world, or source = ADDRESS_SOURCE_NEED_ASSISTANCE to give them Lovie's virtual mailbox (a real US address Lovie provides). Offer the mailbox proactively whenever the user has no address or prefers not to use a home/personal one. Every address needs a street, city, and ISO country code; a US address also needs its state and a 5-digit ZIP.",
 "inputSchema": {
  "properties": {
   "address": {
    "properties": {
     "city": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "country": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
     },
     "county": {
      "maxLength": 100,
      "type": "string"
     },
     "state": {
      "maxLength": 100,
      "type": "string"
     },
     "street1": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "street2": {
      "maxLength": 200,
      "type": "string"
     },
     "zipCode": {
      "maxLength": 20,
      "type": "string"
     }
    },
    "type": "object"
   },
   "formationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "physicalBusinessAddress": {
    "properties": {
     "city": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "country": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
     },
     "county": {
      "maxLength": 100,
      "type": "string"
     },
     "state": {
      "maxLength": 100,
      "type": "string"
     },
     "street1": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "street2": {
      "maxLength": 200,
      "type": "string"
     },
     "zipCode": {
      "maxLength": 20,
      "type": "string"
     }
    },
    "type": "object"
   },
   "source": {
    "enum": [
     "ADDRESS_SOURCE_OWN",
     "ADDRESS_SOURCE_NEED_ASSISTANCE"
    ],
    "type": "string"
   }
  },
  "required": [
   "formationId"
  ],
  "type": "object"
 },
 "name": "formation_set_company_address",
 "outputSchema": {
  "properties": {
   "formationId": {
    "anyOf": [
     {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "needsVirtualPostMail": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "title": "Set Company Address"
}
