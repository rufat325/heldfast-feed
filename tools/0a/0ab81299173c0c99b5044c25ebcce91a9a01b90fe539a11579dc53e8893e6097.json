{
 "description": "Add a menu item to the cart. Must be on a restaurant page first (use doordash_menu).",
 "inputSchema": {
  "properties": {
   "itemName": {
    "description": "Name of the menu item to add",
    "type": "string"
   },
   "quantity": {
    "description": "Quantity to add (default: 1)",
    "type": "number"
   },
   "restaurantId": {
    "description": "The restaurant ID",
    "type": "string"
   },
   "specialInstructions": {
    "description": "Special instructions for the item (optional)",
    "type": "string"
   }
  },
  "required": [
   "restaurantId",
   "itemName"
  ],
  "type": "object"
 },
 "name": "doordash_add_to_cart"
}
