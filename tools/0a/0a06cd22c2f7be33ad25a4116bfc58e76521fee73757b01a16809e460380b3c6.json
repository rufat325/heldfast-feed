{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Answer a Kolmo quote for the person. \"accepted\" binds them to the work at that total; \"declined\" is final; \"changes_requested\" keeps it open and needs notes. To accept: show the person scope, options and total from get_my_quote, get an explicit yes, pass that total as confirmedTotal.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmedTotal": {
    "description": "Required to accept",
    "type": "number"
   },
   "notes": {
    "maxLength": 5000,
    "type": "string"
   },
   "personConfirmed": {
    "description": "True only after the person said yes. Required to accept or decline",
    "type": "boolean"
   },
   "quoteLink": {
    "description": "The person's kolmo.io/quotes/<id> link, as Kolmo sent it. Never guess one.",
    "maxLength": 300,
    "minLength": 36,
    "type": "string"
   },
   "response": {
    "enum": [
     "accepted",
     "declined",
     "changes_requested"
    ],
    "type": "string"
   },
   "selectedOptions": {
    "additionalProperties": false,
    "properties": {
     "alternates": {
      "additionalProperties": {
       "type": "integer"
      },
      "description": "group \u2192 choice id",
      "type": "object"
     },
     "optionalIds": {
      "items": {
       "type": "integer"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "quoteLink",
   "response"
  ],
  "type": "object"
 },
 "name": "respond_to_quote",
 "outputSchema": {
  "properties": {
   "message": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "total": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "required": [
   "status",
   "message"
  ],
  "type": "object"
 },
 "title": "Accept, decline or request changes to a quote"
}
