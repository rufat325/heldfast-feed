{
 "annotations": {},
 "description": "Invoke a Cloud Functions action and return the execution result",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actionName": {
    "description": "Name of the action to invoke",
    "type": "string"
   },
   "packageName": {
    "description": "Package name containing the action",
    "type": "string"
   },
   "params": {
    "additionalProperties": {},
    "description": "Runtime parameters to pass to the action",
    "type": "object"
   },
   "platform": {
    "default": "vpc",
    "description": "Platform type (default: vpc)",
    "enum": [
     "vpc",
     "classic"
    ],
    "type": "string"
   },
   "timeout": {
    "default": 60000,
    "description": "Invocation timeout in milliseconds (0~60000, default: 60000)",
    "maximum": 60000,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "packageName",
   "actionName"
  ],
  "type": "object"
 },
 "name": "ncloud_functions_invoke_action"
}
