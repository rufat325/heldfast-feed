{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Domain DNS Records"
 },
 "description": "Return all six DNS records required by Shipmail and live observed values for propagation diagnostics. This does not update domain state.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Shipmail resource ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "shipmail_get_domain_dns_records",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "dns_records": {
    "properties": {
     "all_verified": {
      "type": "boolean"
     },
     "checked_at": {
      "type": "string"
     },
     "domain_id": {
      "type": "string"
     },
     "domain_name": {
      "type": "string"
     },
     "object": {
      "type": "string"
     },
     "records": {
      "items": {
       "properties": {
        "found_values": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "host": {
         "type": "string"
        },
        "key": {
         "type": "string"
        },
        "priority": {
         "anyOf": [
          {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          {
           "type": "null"
          }
         ]
        },
        "status": {
         "type": "string"
        },
        "ttl": {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        "type": {
         "type": "string"
        },
        "value": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "key",
        "type",
        "host",
        "value",
        "priority",
        "ttl",
        "status",
        "found_values"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "object",
     "domain_id",
     "domain_name",
     "all_verified",
     "checked_at",
     "records"
    ],
    "type": "object"
   }
  },
  "required": [
   "dns_records"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Get Domain DNS Records"
}
