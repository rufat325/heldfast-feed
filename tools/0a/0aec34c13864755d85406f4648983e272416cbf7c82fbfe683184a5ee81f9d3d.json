{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a fleet schedule's name, query, recurrence rule, or status",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "The schedule ID to update",
    "type": "string"
   },
   "name": {
    "description": "Updated schedule name",
    "type": "string"
   },
   "query": {
    "description": "Updated filter query",
    "type": "string"
   },
   "rule": {
    "description": "Updated recurrence rule",
    "properties": {
     "daysOfWeek": {
      "description": "Days of week",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "maintenanceWindowDuration": {
      "description": "Duration in minutes",
      "type": "number"
     },
     "startMaintenanceWindow": {
      "description": "Start time (HH:MM)",
      "type": "string"
     },
     "timezone": {
      "description": "Timezone",
      "type": "string"
     }
    },
    "required": [
     "daysOfWeek",
     "maintenanceWindowDuration",
     "startMaintenanceWindow",
     "timezone"
    ],
    "type": "object"
   },
   "status": {
    "description": "Updated status",
    "enum": [
     "active",
     "inactive"
    ],
    "type": "string"
   },
   "versionToLatest": {
    "description": "Updated version offset",
    "type": "number"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update-fleet-schedule"
}
