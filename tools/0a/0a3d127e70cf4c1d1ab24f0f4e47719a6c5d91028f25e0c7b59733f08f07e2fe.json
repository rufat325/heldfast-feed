{
 "description": "Generate a tabletop RPG encounter with CR-appropriate monsters, terrain, and loot (D&D 5e or Pathfinder 1e)",
 "inputSchema": {
  "properties": {
   "difficulty": {
    "description": "Encounter difficulty (default: medium)",
    "enum": [
     "easy",
     "medium",
     "hard",
     "deadly"
    ],
    "type": "string"
   },
   "monster_type": {
    "description": "Filter by type (undead, dragon, beast, etc)",
    "type": "string"
   },
   "party_level": {
    "description": "Average party level 1-20 (default: 5)",
    "type": "number"
   },
   "party_size": {
    "description": "Number of players 1-10 (default: 4)",
    "type": "number"
   },
   "system": {
    "description": "Game system (default: dnd-5e)",
    "enum": [
     "dnd-5e",
     "pathfinder-1e"
    ],
    "type": "string"
   },
   "terrain": {
    "description": "Terrain type (omit for random)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "oracle_encounter"
}
