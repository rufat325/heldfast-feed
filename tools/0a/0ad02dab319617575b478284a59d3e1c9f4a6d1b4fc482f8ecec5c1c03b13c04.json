{"_meta":{"com.imonfhir/about":{"howToUse":["Pass keys like FHIR-54729."],"safeToRun":["Free. Read-only. No account, no key; nothing you send is stored."],"whatItDoes":["Gives status, resolution and when it was last verified, for up to 50 keys.","\"applied\" is not \"published\"."],"whatItIs":["HL7 Jira statuses as HORIZON last re-read them."]},"com.imonfhir/cost":{"free":true},"com.imonfhir/presets":[{"args":{"keys":["FHIR-54729"]},"id":"one-key","label":"One HL7 Jira key"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"HL7 Jira status"},"description":"Up to 50 HL7 Jira keys: status, resolved, resolution, last_verified with its jira_verified evidence record, lifecycle stage, source_url (HL7 Jira) and the canonical_url of public items that cite it. \"applied\" is not \"published\".","inputSchema":{"additionalProperties":false,"properties":{"keys":{"items":{"pattern":"^[A-Z][A-Z0-9]{1,9}-\\d{1,6}$","type":"string"},"maxItems":50,"minItems":1,"type":"array"}},"required":["keys"],"type":"object"},"name":"get_jira_status","outputSchema":{"properties":{"attribution":{"type":"string"},"statuses":{"items":{"properties":{"cited_by":{"items":{"type":"string"},"type":"array"},"evidence":{"properties":{"evidence_type":{"type":"string"},"observed_at":{"type":"string"}},"type":["object","null"]},"key":{"type":"string"},"known":{"type":"boolean"},"last_verified":{"type":["string","null"]},"lifecycle":{"type":["string","null"]},"resolution":{"type":["string","null"]},"resolved":{"type":["boolean","null"]},"source_url":{"type":"string"},"status":{"type":["string","null"]}},"required":["key","known","status","resolved","resolution","last_verified","lifecycle","evidence","source_url","cited_by"],"type":"object"},"type":"array"}},"required":["statuses","attribution"],"type":"object"},"title":"HL7 Jira status"}
