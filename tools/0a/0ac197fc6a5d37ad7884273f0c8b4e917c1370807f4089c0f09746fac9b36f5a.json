  "additionalProperties": false,
  "properties": {
   "detail": {
    "default": "full",
    "description": "full (the default): the whole answer. summary: the result lines, the citation line and the page only \u2014 fewer tokens to read.",
    "enum": [
     "full",
     "summary"
    ],
    "type": "string"
   },
   "slug": {
    "description": "The calculator's slug, such as concrete-calculator.",
    "pattern": "^[a-z0-9][a-z0-9-]{1,119}$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
