{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:use"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read durable agent memory for the authenticated user. Returns one document per (scope, kind); use project_id for project-scoped memory. Identity comes from Core via the session bearer, not from input.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "kind": {
    "description": "Narrow the result to a single memory kind.",
    "minLength": 1,
    "type": "string"
   },
   "project_id": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Project UUID for project-scoped memory; null or omitted reads global (user-level) memory. Required when scope is project or both."
   },
   "scope": {
    "description": "Memory scope to read: global, project, or both. Defaults to global unless project_id is set.",
    "enum": [
     "global",
     "project",
     "both"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "read-memory",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "memories": {
    "description": "Durable memory documents for the authenticated user.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "description": "Memory kind for this document.",
       "type": "string"
      },
      "projectId": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Owning project UUID, or null for global memory."
      },
      "updatedAt": {
       "description": "Last time this memory document changed.",
       "type": "string"
      },
      "value": {
       "additionalProperties": {},
       "description": "Freeform memory document.",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "kind",
      "projectId",
      "value",
      "updatedAt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "memories"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "mcp:use"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Read Studocu Agent Memory"
}
