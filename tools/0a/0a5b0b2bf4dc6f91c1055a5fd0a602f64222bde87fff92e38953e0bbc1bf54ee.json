      "images",
      "testing",
      "privacy",
      "pwa",
      "i18n"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "explainPrompt": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "suggestions": {
    "items": {
     "properties": {
      "similarity": {
