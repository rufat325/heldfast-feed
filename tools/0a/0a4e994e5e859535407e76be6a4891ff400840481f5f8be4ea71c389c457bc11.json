{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"Stops a suite run started with suite_run_start, cancels its remaining tests, and cleans up its local web servers. Returns the final status. Stopping a run that is already over just returns its status.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"suiteRunId":{"description":"Suite run ID returned by `suite_run_start`.","type":"string"}},"required":["suiteRunId"],"type":"object"},"name":"suite_run_stop","outputSchema":{"$defs":{"SuiteRunCounts":{"properties":{"failed":{"minimum":0,"type":"integer"},"flaking":{"description":"Tests with a failed attempt that are waiting on a retry right now. This is 0 once the run is over: a test that passed on retry counts as passed.","minimum":0,"type":"integer"},"passed":{"minimum":0,"type":"integer"},"skipped":{"minimum":0,"type":"integer"},"total":{"minimum":0,"type":"integer"}},"required":["total","passed","failed","flaking","skipped"],"type":"object"},"SuiteRunFailure":{"properties":{"file":{"type":"string"},"line":{"minimum":0,"type":"integer"},"message":{"type":["string","null"]},"project":{"type":"string"}},"required":["file","line","project"],"type":"object"},"SuiteRunState":{"enum":["running","passed","failed","stopped","error"],"type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"counts":{"$ref":"#/$defs/SuiteRunCounts"},"error":{"type":["string","null"]},"failures":{"items":{"$ref":"#/$defs/SuiteRunFailure"},"type":"array"},"reportUrl":{"type":["string","null"]},"resultsPath":{"type":["string","null"]},"status":{"$ref":"#/$defs/SuiteRunState"},"suiteRunId":{"type":"string"}},"required":["suiteRunId","status","counts","failures"],"type":"object"}}
