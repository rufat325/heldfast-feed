{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "agent:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List threads for one of your AIs to review its Act activity. This is the same bounded read as list_threads.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "agent": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   },
   "archived": {
    "type": "boolean"
   },
   "cursor": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "needsAttention": {
    "type": "boolean"
   },
   "targetAgent": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_act_history",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "threads": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "archived": {
       "type": "boolean"
      },
      "createdAt": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
       "type": "string"
      },
      "needsAttention": {
       "type": "boolean"
      },
      "targetAgent": {
       "maxLength": 200,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
       "type": "string"
      },
      "thread": {
       "maxLength": 200,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
       "type": "string"
      }
     },
     "required": [
      "thread",
      "targetAgent",
      "archived",
      "needsAttention",
      "createdAt"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "threads",
   "cursor"
  ],
  "type": "object"
 },
 "title": "List act history"
}
