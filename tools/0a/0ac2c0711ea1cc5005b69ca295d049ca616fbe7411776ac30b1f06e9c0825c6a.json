{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Caption Style Guidance"
 },
 "description": "Read-only caption style guidance: a preset (clean, bold_pop, karaoke, podcast, lecture) and/or a custom_style spec (font, size, fill, up to 3 strokes, shadow, zone, offsets) turned into Premiere 2024+ Properties-panel steps that save a reusable whole-track Track Style. NEVER modifies caption tracks; Premiere has no caption style API.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "custom_style": {
    "additionalProperties": false,
    "description": "Optional caption look to translate into concrete Premiere UI steps. Every field is optional; at least one is required. Values are documentation only and are never applied.",
    "properties": {
     "fill_color": {
      "description": "Text fill colour as #RRGGBB.",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "type": "string"
     },
     "font_family": {
      "description": "Font family name as shown in Premiere, e.g. Source Han Sans TW.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
     },
     "font_size_px": {
      "description": "Font size in Premiere's caption units (pixels).",
      "maximum": 400,
      "minimum": 8,
      "type": "integer"
     },
     "font_weight": {
      "description": "Font weight or style name, e.g. Heavy or Bold.",
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     "offset_x_px": {
      "description": "Horizontal position offset from the zone in pixels.",
      "maximum": 2000,
      "minimum": -2000,
      "type": "integer"
     },
     "offset_y_px": {
      "description": "Vertical position offset from the zone in pixels; negative moves up.",
      "maximum": 2000,
      "minimum": -2000,
      "type": "integer"
     },
     "shadow": {
      "additionalProperties": false,
      "description": "Drop shadow; omitted fields use the listed defaults.",
      "properties": {
       "angle": {
        "description": "Shadow angle in degrees (default 135).",
        "maximum": 360,
        "minimum": 0,
        "type": "number"
       },
       "blur": {
        "description": "Shadow blur (default 40).",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "color": {
        "description": "Shadow colour as #RRGGBB (default #000000).",
        "pattern": "^#[0-9A-Fa-f]{6}$",
        "type": "string"
       },
       "distance": {
        "description": "Shadow distance (default 7).",
        "maximum": 200,
        "minimum": 0,
        "type": "number"
       },
       "opacity": {
        "description": "Shadow opacity percent (default 75).",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "size": {
        "description": "Shadow size (default 0).",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     },
     "strokes": {
      "description": "Up to three strokes in Premiere's Stroke list order; each stroke after the first is added with + next to Stroke. Layered outer strokes need increasing widths.",
      "items": {
       "additionalProperties": false,
       "description": "One stroke.",
       "properties": {
        "color": {
         "description": "Stroke colour as #RRGGBB.",
         "pattern": "^#[0-9A-Fa-f]{6}$",
         "type": "string"
        },
        "placement": {
         "description": "Stroke placement (default outer).",
         "enum": [
          "outer",
          "inner",
          "center"
         ],
         "type": "string"
        },
        "width_px": {
         "description": "Stroke width.",
         "maximum": 100,
         "minimum": 0,
         "type": "number"
        }
       },
       "required": [
        "color",
        "width_px"
       ],
       "type": "object"
      },
      "maxItems": 3,
      "type": "array"
     },
     "track_style_name": {
      "description": "Name for the saved Track Style (default Caption Track Style).",
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "zone": {
      "description": "Caption region in Premiere's Align and Transform zone grid.",
      "enum": [
       "top_left",
       "top_center",
       "top_right",
       "middle_left",
       "middle_center",
       "middle_right",
       "bottom_left",
       "bottom_center",
       "bottom_right"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "expected_cep_target": {
    "additionalProperties": false,
    "anyOf": [
     {
      "required": [
       "sequence_id"
      ]
     },
     {
      "required": [
       "source_item"
      ]
     }
    ],
    "description": "Optional reviewed CEP sequence/clip identity and exact tick ranges. Checked before every generated command; UXP refuses this CEP-only guard.",
    "properties": {
     "backend": {
      "const": "cep",
      "description": "Backend namespace for these IDs.",
      "type": "string"
     },
     "clip": {
      "additionalProperties": false,
      "description": "Optional exact reviewed timeline clip.",
      "properties": {
       "effect": {
        "additionalProperties": false,
        "description": "Reviewed effect and parameter identity checked before mutation.",
        "properties": {
         "display_name": {
          "description": "Optional exact host display name.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         "match_name": {
          "description": "Effect match name from host inspection.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         "parameter_index": {
          "description": "Inspected zero-based parameter index.",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
         },
         "parameter_name": {
          "description": "Exact inspected parameter name.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "match_name",
         "parameter_index",
         "parameter_name"
        ],
        "type": "object"
       },
       "end_ticks": {
        "description": "Exact expected exclusive timeline end ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "in_ticks": {
        "description": "Exact expected source In ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "node_id": {
        "description": "Stable CEP node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "out_ticks": {
        "description": "Exact expected exclusive source Out ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "project_item_id": {
        "description": "Expected source project-item node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "start_ticks": {
        "description": "Exact expected timeline start ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "track_index": {
        "description": "Expected zero-based track index; identity still checked.",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       },
       "track_type": {
        "description": "Expected media track group.",
        "enum": [
         "video",
         "audio"
        ],
        "type": "string"
       }
      },
      "required": [
       "node_id",
       "track_type",
       "track_index"
      ],
      "type": "object"
     },
     "project_document_id": {
      "description": "Exact Premiere project document ID observed during review.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "sequence_id": {
      "description": "Stable expected active sequence ID.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "source_item": {
      "additionalProperties": false,
      "description": "Reviewed source identity for a source-only operation.",
      "properties": {
       "media_path": {
        "description": "Optional exact source-media path.",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
       },
       "node_id": {
        "description": "Exact project-item node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "node_id"
      ],
      "type": "object"
     }
    },
    "required": [
     "backend"
    ],
    "type": "object"
   },
   "expected_project_path": {
    "description": "Optional absolute saved-project path. Every generated CEP command refuses before its body when the active project differs or is unsaved. UXP commands refuse this CEP-only guard; local-only tools do not inspect Premiere. Omit to keep existing behavior.",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "preset": {
    "description": "Style preset to describe (default clean when custom_style is omitted).",
    "enum": [
     "clean",
     "bold_pop",
     "karaoke",
     "podcast",
     "lecture"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_caption_style_guidance",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true; on failure, diagnostic detail when the tool provides it."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "receipt": {
    "additionalProperties": true,
    "description": "Versioned common mutation receipt; success never implies rendered verification.",
    "type": "object"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Get Caption Style Guidance"
}
