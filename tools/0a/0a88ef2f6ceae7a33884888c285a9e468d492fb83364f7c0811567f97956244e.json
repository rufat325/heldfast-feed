{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Free. Compare dated caller-supplied asks, sales, bids, pools, funding, liquidity or holders without mixing metrics. Evidence is not independently verified.","inputSchema":{"$defs":{"EvidenceCompareRequest":{"properties":{"after":{"$ref":"#/$defs/EvidencePoint"},"before":{"$ref":"#/$defs/EvidencePoint"}},"required":["before","after"],"title":"EvidenceCompareRequest","type":"object"},"EvidencePoint":{"properties":{"asset_id":{"description":"Chain and exact contract/token identifier","maxLength":200,"minLength":1,"title":"Asset Id","type":"string"},"metric":{"enum":["floor_ask","completed_sale_average","best_bid","reward_pool","funding_amount","holders","liquidity"],"title":"Metric","type":"string"},"observed_at":{"format":"date-time","title":"Observed At","type":"string"},"source":{"description":"Source identifier; supplied evidence is not fetched or verified","maxLength":500,"minLength":1,"title":"Source","type":"string"},"unit":{"description":"Exact currency/token identifier, or wallets for holders","maxLength":100,"minLength":1,"title":"Unit","type":"string"},"value":{"anyOf":[{"minimum":0.0,"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,54}|(?=[\\d.]{1,79}0*$)\\d{0,54}\\.\\d{0,24}0*$)","type":"string"}],"title":"Value"}},"required":["asset_id","metric","unit","value","observed_at","source"],"title":"EvidencePoint","type":"object"}},"properties":{"request":{"$ref":"#/$defs/EvidenceCompareRequest"}},"required":["request"],"title":"market_evidence_compareArguments","type":"object"},"name":"market_evidence_compare"}
