{
 "description": "Update mutable fields on an account: status, tier, quota, allowed_origins, sheet_id, sheet OAuth refresh token, ad-network creds (merged into existing), Stripe ids. Pass only the fields you want to change. Use ad_network_creds with keys: google_ads, meta, linkedin, tiktok, x.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "account_id": {
    "type": "string"
   },
   "ad_network_creds": {
    "additionalProperties": {},
    "description": "Merged into existing. Shape: { \"google_ads\": {...}, \"meta\": {...}, \"linkedin\": {...}, \"tiktok\": {...}, \"x\": {...} }",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "allowed_origins": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "google_oauth_refresh": {
    "type": "string"
   },
   "google_sheet_id": {
    "type": "string"
   },
   "monthly_quota": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "name": {
    "type": "string"
   },
   "status": {
    "enum": [
     "active",
     "paused",
     "cancelled"
    ],
    "type": "string"
   },
   "stripe_customer_id": {
    "type": "string"
   },
   "stripe_subscription_id": {
    "type": "string"
   },
   "tier": {
    "enum": [
     "starter",
     "pro",
     "enterprise"
    ],
    "type": "string"
   }
  },
  "required": [
   "account_id"
  ],
  "type": "object"
 },
 "name": "dr_account_update"
}
