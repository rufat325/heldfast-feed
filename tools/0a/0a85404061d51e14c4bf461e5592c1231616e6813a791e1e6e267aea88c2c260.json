{
 "_meta": {
  "fastmcp": {
   "tags": [
    "search"
   ]
  }
 },
 "description": "Full-text search across emails + items, ranked by ``ts_rank_cd``, scoped (A1).\n\n``archive_status`` constrains item results only (the Documents \u2192 Archive page\npasses ``archived`` so its search box never surfaces pending/triage-parked items).",
 "inputSchema": {
  "properties": {
   "archive_status": {
    "anyOf": [
     {
      "enum": [
       "pending",
       "archiving",
       "archived",
       "failed"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "company_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "direction": {
    "anyOf": [
     {
      "pattern": "^(payable|receivable)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "limit": {
    "default": 20,
    "maximum": 200.0,
    "minimum": 1.0,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "minimum": 0.0,
    "type": "integer"
   },
   "q": {
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "anyOf": [
     {
      "pattern": "^(email|epost|upload|bexio|abacus)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "type": {
    "anyOf": [
     {
      "pattern": "^(email|item)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "global_search"
}
