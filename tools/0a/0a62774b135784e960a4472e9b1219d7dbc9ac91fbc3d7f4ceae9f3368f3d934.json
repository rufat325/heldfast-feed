   },
   "notes": {
    "description": "Optional notes",
    "type": "string"
   },
   "quantity": {
    "description": "The number of eggs collected (positive finite number <= 100000)",
    "type": "number"
   },
   "type": {
    "description": "Optional variety (e.g. Pharaoh, Celadon, Standard)",
    "type": "string"
   }
  },
  "required": [
