  "title": "Search Homechecker guidance"
 },
 "description": "Search professionally authored Australian homebuyer guidance using a natural-language question. Use this for general property, inspection, disclosure, apartment, condition, maintenance, era and buying-process questions. It does not assess an actual property.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "buyingStage": {
    "description": "For example research, contract review, physical inspection, ownership, or selling.",
    "type": "string"
   },
   "cluster": {
    "enum": [
     "how-to-buy",
     "state-rules",
     "read-building",
     "shared-buildings",
     "own-change"
    ],
    "type": "string"
   },
   "era": {
    "description": "For example pre-1920s, 1950s-1970s, or 2000s-on.",
    "type": "string"
   },
   "jurisdiction": {
    "description": "Optional state/territory code or name, such as WA, wa or Western Australia.",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "propertyType": {
    "description": "For example house, apartment, or townhouse or unit.",
    "type": "string"
   },
   "query": {
    "description": "The homebuyer question or issue to search for.",
    "maxLength": 800,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_guides",
