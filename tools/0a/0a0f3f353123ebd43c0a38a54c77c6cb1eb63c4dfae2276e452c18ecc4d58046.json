{
 "description": "Get all ACF field values for a post (name => { value, type, label })",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "formatted (default): values as get_field returns them; raw: unformatted stored values",
    "enum": [
     "formatted",
     "raw"
    ],
    "type": "string"
   },
   "post_id": {
    "description": "Post ID",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "post_id"
  ],
  "type": "object"
 },
 "name": "acf_get_post_fields"
}
