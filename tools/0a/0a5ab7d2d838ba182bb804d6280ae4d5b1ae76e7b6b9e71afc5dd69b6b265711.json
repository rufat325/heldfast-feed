{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Create a task on a FreeAgent project. Tasks carry the billing rate that logged time is charged at.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "billingPeriod": {
    "description": "Whether the billing rate is per hour or per day",
    "enum": [
     "hour",
     "day"
    ],
    "type": "string"
   },
   "billingRate": {
    "description": "Rate charged per billing period (e.g. '850.00')",
    "pattern": "^\\d+(\\.\\d+)?$",
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 currency code",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "isBillable": {
    "default": true,
    "description": "Whether time on this task is billable",
    "type": "boolean"
   },
   "name": {
    "description": "Task name (e.g. 'Delivery workshops')",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "project": {
    "description": "Project the task belongs to",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/projects\\/\\d+$",
    "type": "string"
   },
   "status": {
    "default": "Active",
    "description": "Task status (default Active)",
    "enum": [
     "Active",
     "Completed",
     "Hidden"
    ],
    "type": "string"
   }
  },
  "required": [
   "project",
   "name"
  ],
  "type": "object"
 },
 "name": "freeagent_create_task"
}
