{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new LaunchChair Product project in the token workspace, optionally save the first Idea Snapshot, and optionally start the project loop. Requires a workspace-scoped token with projects.write.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "name"
    ]
   },
   {
    "required": [
     "projectName"
    ]
   }
  ],
  "properties": {
   "executionMode": {
    "default": "host",
    "enum": [
     "host",
     "local_runner"
    ],
    "type": "string"
   },
   "ideaIntent": {
    "default": "preserve",
    "enum": [
     "preserve",
     "explore"
    ],
    "type": "string"
   },
   "ideaSnapshot": {
    "additionalProperties": false,
    "description": "Optional first-bucket seed. Include problem, targetUser, solution, and optional jobToBeDone/whyNow.",
    "properties": {
     "jobToBeDone": {
      "type": "string"
     },
     "problem": {
      "type": "string"
     },
     "resetDownstream": {
      "type": "boolean"
     },
     "solution": {
      "type": "string"
     },
     "targetUser": {
      "type": "string"
     },
     "whyNow": {
      "type": "string"
     }
    },
    "required": [
     "problem",
     "targetUser",
     "solution"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "oneLiner": {
    "type": "string"
   },
   "projectName": {
    "type": "string"
   },
   "projectType": {
    "enum": [
     "b2b",
     "b2c",
     "both",
     "free"
    ],
    "type": "string"
   },
   "startLoop": {
    "description": "If true, LaunchChair immediately calls loop/continue after creation.",
    "type": "boolean"
   },
   "stopPhaseKey": {
    "description": "Optional stop phase when startLoop is true.",
    "type": "string"
   },
   "validationGate": {
    "anyOf": [
     {
      "enum": [
       "very_high"
      ],
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "maxSaturation": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "minOpportunity": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "minPain": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     }
    ]
   }
  },
  "type": "object"
 },
 "name": "launchchair_create_project"
}
