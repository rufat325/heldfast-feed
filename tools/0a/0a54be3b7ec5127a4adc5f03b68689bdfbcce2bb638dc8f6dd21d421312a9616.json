{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a SharePoint site page's metadata (title, description, or promotion kind). Does not edit page body content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "New page description",
    "type": "string"
   },
   "pageId": {
    "description": "Page ID from list_site_pages or create_site_page",
    "type": "string"
   },
   "promotionKind": {
    "description": "Promote as a normal page or a news post",
    "enum": [
     "page",
     "newsPost"
    ],
    "type": "string"
   },
   "siteId": {
    "description": "SharePoint site ID",
    "type": "string"
   },
   "title": {
    "description": "New page title",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "update_site_page"
}
