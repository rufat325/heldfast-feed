{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Browse the catalog, 100 resources per page, optionally by topic. Free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "default": 0,
    "description": "Zero-based page number",
    "minimum": 0,
    "type": "integer"
   },
   "topic": {
    "description": "Topic slug from list_topics, e.g. laser-calibration",
    "pattern": "^[a-z0-9-]{1,64}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_catalog_page",
 "title": "Browse the catalog"
}
