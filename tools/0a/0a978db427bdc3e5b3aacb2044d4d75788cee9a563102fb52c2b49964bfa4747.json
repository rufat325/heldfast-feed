{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find roofing, siding or gutter contractors in a US city from The Roofing List. Returns only listed businesses that are open and passed our contact check. Ratings come from reviews published on The Roofing List only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "city": {
    "description": "US city name, for example \"Austin\".",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "How many results, 1 to 25. Default 10.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "description": "US state as a USPS code (\"TX\") or a full name (\"Texas\").",
    "maxLength": 40,
    "minLength": 2,
    "type": "string"
   },
   "trade": {
    "description": "The trade: roofing, siding or gutters.",
    "enum": [
     "roofing",
     "siding",
     "gutters"
    ],
    "type": "string"
   }
  },
  "required": [
   "trade",
   "city",
   "state"
  ],
  "type": "object"
 },
 "name": "search_contractors",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "contractors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "city": {
       "type": "string"
      },
      "claimed": {
       "type": "boolean"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "phone": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "profileUrl": {
       "type": "string"
      },
      "rating": {
       "additionalProperties": false,
       "description": "From reviews published on The Roofing List only. Absent when there are none.",
       "properties": {
        "count": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "value": {
         "description": "Average of published reviews on The Roofing List, 1 to 5.",
         "type": "number"
        }
       },
       "required": [
        "value",
        "count"
       ],
       "type": "object"
      },
      "state": {
       "type": "string"
      },
      "trades": {
       "items": {
        "enum": [
         "roofing",
         "siding",
         "gutters"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "website": {
       "description": "Only present for claimed profiles.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "trades",
      "city",
      "state",
      "phone",
      "profileUrl",
      "claimed"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "contractors"
  ],
  "type": "object"
 },
 "title": "Search contractors"
}
