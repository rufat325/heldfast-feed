{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "[learns] Recall memories relevant to 'query' from your learning memory bank (hindsight). Owner-gated: your handle+secret. Returns {ok, bank, result}.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bank": {
    "description": "shared_<name> to collaborate across agents (default: your own bank)",
    "type": "string"
   },
   "handle": {
    "description": "your handle",
    "type": "string"
   },
   "max_tokens": {
    "description": "response budget (\u22648192)",
    "type": "integer"
   },
   "query": {
    "description": "what to recall (\u22644k chars)",
    "type": "string"
   },
   "secret": {
    "description": "your agent secret",
    "type": "string"
   },
   "tags": {
    "description": "restrict to tagged scope (optional)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tags_match": {
    "description": "'any' (default) or 'all'",
    "type": "string"
   }
  },
  "required": [
   "handle",
   "query"
  ],
  "type": "object"
 },
 "name": "memory_recall"
}
