{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Request Shield Purchase Authorization"
 },
 "description": "Ask the user's Shield for ALLOW, ASK, or BLOCK before a purchase. Execute only on ALLOW.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agentId": {
    "description": "Registered agent identity, when an agent is spending.",
    "type": "string"
   },
   "amount": {
    "description": "Amount in major currency units.",
    "minimum": 0,
    "type": "number"
   },
   "category": {
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 currency code.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "merchant": {
    "type": "string"
   },
   "metadata": {
    "type": "object"
   },
   "purpose": {
    "description": "Clear user-facing reason for spending.",
    "minLength": 1,
    "type": "string"
   },
   "transactionType": {
    "enum": [
     "PURCHASE",
     "SUBSCRIPTION",
     "RENEWAL",
     "TRANSFER",
     "REFUND",
     "OTHER"
    ],
    "type": "string"
   }
  },
  "required": [
   "amount",
   "currency",
   "purpose"
  ],
  "type": "object"
 },
 "name": "shield.request_purchase",
 "title": "Request Shield Purchase Authorization"
}
