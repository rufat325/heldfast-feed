{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Check whether Leafwright MCP is authenticated. Completes a pending browser login if approved. Pass the device_code returned by leafwright_login when the client has no local storage, which is the case over HTTP.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device_code": {
    "description": "The device_code from leafwright_login. Required when the client stores no local auth state.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "leafwright_auth_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "active_project_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "expires_at": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "status": {
    "enum": [
     "connected",
     "not_authenticated",
     "pending"
    ],
    "type": "string"
   },
   "token": {
    "additionalProperties": false,
    "properties": {
     "createdAt": {
      "type": "string"
     },
     "defaultProjectId": {
      "type": "string"
     },
     "expiresAt": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "lastUsedAt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "orgId": {
      "type": "string"
     },
     "permissions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "revokedAt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "tokenPreview": {
      "type": "string"
     },
     "userId": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "userId",
     "orgId",
     "defaultProjectId",
     "tokenPreview",
     "permissions",
     "expiresAt",
     "revokedAt",
     "lastUsedAt",
     "createdAt"
    ],
    "type": "object"
   },
   "token_source": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "user_code": {
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Leafwright auth status"
}
