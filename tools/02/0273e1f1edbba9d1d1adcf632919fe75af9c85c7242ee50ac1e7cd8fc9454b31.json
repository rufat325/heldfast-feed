{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate a non-binding, non-persisted private-driver price range. Review the saved quote for payment eligibility and supplier-assignment status.",
 "inputSchema": {
  "properties": {
   "agent_session_id": {
    "anyOf": [
     {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._:-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Agent Session Id"
   },
   "agent_source": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._:-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Agent Source"
   },
   "datetime_local": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Datetime Local"
   },
   "days": {
    "maximum": 30,
    "minimum": 1,
    "title": "Days",
    "type": "integer"
   },
   "dropoff": {
    "anyOf": [
     {
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Dropoff"
   },
   "estimated_distance_km": {
    "anyOf": [
     {
      "maximum": 5000,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Estimated Distance Km"
   },
   "market": {
    "default": "LK",
    "maxLength": 2,
    "minLength": 2,
    "title": "Market",
    "type": "string"
   },
   "passengers": {
    "anyOf": [
     {
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Passengers"
   },
   "pickup": {
    "anyOf": [
     {
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Pickup"
   },
   "quote_currency": {
    "const": "USD",
    "default": "USD",
    "title": "Quote Currency",
    "type": "string"
   },
   "vehicle_class": {
    "enum": [
     "sedan",
     "standard_car",
     "van",
     "six_seater_van",
     "luxury_suv"
    ],
    "title": "Vehicle Class",
    "type": "string"
   }
  },
  "required": [
   "vehicle_class",
   "days"
  ],
  "title": "PrivateDriverQuoteRequest",
  "type": "object"
 },
 "name": "preview_private_driver_quote",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "booking_eligible_from_preview": {
    "const": false,
    "type": "boolean"
   },
   "market": {
    "type": "string"
   },
   "next_action": {
    "type": "string"
   },
   "persisted": {
    "const": false,
    "type": "boolean"
   },
   "preview": {
    "const": true,
    "type": "boolean"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "market",
   "status",
   "preview",
   "persisted",
   "booking_eligible_from_preview",
   "next_action"
  ],
  "type": "object"
 },
 "title": "Preview a private-driver quote"
}
