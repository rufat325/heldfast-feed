{
 "description": "Enable or disable location services",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "mode": {
    "description": "Location mode: off, sensors (GPS only), battery (network only), high (GPS + network)",
    "enum": [
     "off",
     "sensors",
     "battery",
     "high"
    ],
    "type": "string"
   }
  },
  "required": [
   "mode"
  ],
  "type": "object"
 },
 "name": "adb_location"
}
