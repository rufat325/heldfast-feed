{
 "description": "Build a canonical HookOn hex from a list of transaction types to fire on. Offline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "txTypes": {
    "description": "e.g. [\"Payment\",\"Invoke\"]",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "txTypes"
  ],
  "type": "object"
 },
 "name": "encode_hook_on",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "type": "string"
   },
   "firesOn": {
    "items": {},
    "type": "array"
   },
   "hookOn": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
