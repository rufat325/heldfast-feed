{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "owner",
     "offline_access"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "readOnlyHint": false,
  "title": "Set working hours"
 },
 "description": "Only for business owners signed in to Awning. Replace weekly hours of the business, or of one staff member/room with resource_id. Existing bookings are kept.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "business_id": {
    "description": "Only needed if you manage several businesses",
    "type": "string"
   },
   "hours": {
    "items": {
     "properties": {
      "close": {
       "description": "HH:MM",
       "maxLength": 20,
       "type": "string"
      },
      "days": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "items": {
          "maxLength": 20,
          "type": "string"
         },
         "maxItems": 14,
         "type": "array"
        }
       ],
       "description": "e.g. \"mon-sat\", \"daily\", [\"tue\",\"thu\"]"
      },
      "open": {
       "description": "HH:MM",
       "maxLength": 20,
       "type": "string"
      }
     },
     "required": [
      "days",
      "open",
      "close"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "resource_id": {
    "type": "string"
   }
  },
  "required": [
   "hours"
  ],
  "type": "object"
 },
 "name": "owner_set_schedule",
 "title": "Set working hours"
}
