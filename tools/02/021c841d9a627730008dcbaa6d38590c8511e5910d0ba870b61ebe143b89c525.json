{
 "_meta": {
  "anthropic/maxResultSizeChars": 500000
 },
 "description": "List and search messages in a folder. Supports metadata_only to return envelope fields only and automatically trims oversized results so the tool remains usable in Anthropic clients. Requires alias credentials (alias_username and alias_password).",
 "inputSchema": {
  "properties": {
   "alias_password": {
    "description": "Generated alias password for authentication. Required for alias-authenticated endpoints. Falls back to FORWARD_EMAIL_ALIAS_PASSWORD env var. Generate one with the generateAliasPassword tool.",
    "type": "string"
   },
   "alias_username": {
    "description": "Alias email address for authentication (e.g. user@example.com). Required for alias-authenticated endpoints. Falls back to FORWARD_EMAIL_ALIAS_USER env var.",
    "type": "string"
   },
   "bcc": {
    "description": "Filter by BCC address",
    "type": "string"
   },
   "before": {
    "description": "Filter messages before this date (ISO 8601)",
    "type": "string"
   },
   "body": {
    "description": "Search within message body",
    "type": "string"
   },
   "cc": {
    "description": "Filter by CC address",
    "type": "string"
   },
   "date": {
    "description": "Filter by message date",
    "type": "string"
   },
   "folder": {
    "description": "IMAP folder name (e.g. \"INBOX\", \"Sent\", \"Drafts\")",
    "type": "string"
   },
   "from": {
    "description": "Filter by sender address",
    "type": "string"
   },
   "has_attachment": {
    "description": "Filter messages with attachments (boolean)",
    "type": "string"
   },
   "has_attachments": {
    "description": "Filter messages with attachments (boolean)",
    "type": "string"
   },
   "headers": {
    "description": "Search within message headers",
    "type": "string"
   },
   "is_copied": {
    "description": "Filter by copied status (boolean)",
    "type": "string"
   },
   "is_deleted": {
    "description": "Filter by deleted status (boolean)",
    "type": "string"
   },
   "is_draft": {
    "description": "Filter by draft status (boolean)",
    "type": "string"
   },
   "is_encrypted": {
    "description": "Filter by encrypted status (boolean)",
    "type": "string"
   },
   "is_expired": {
    "description": "Filter by expired status (boolean)",
    "type": "string"
   },
   "is_flagged": {
    "description": "Filter by flagged status (boolean)",
    "type": "string"
   },
   "is_junk": {
    "description": "Filter by junk/spam status (boolean)",
    "type": "string"
   },
   "is_searchable": {
    "description": "Filter by searchable status (boolean)",
    "type": "string"
   },
   "is_unread": {
    "description": "Filter by unread status (boolean)",
    "type": "string"
   },
   "max_size": {
    "description": "Maximum message size in bytes",
    "type": "string"
   },
   "message_id": {
    "description": "Filter by Message-ID header",
    "type": "string"
   },
   "metadata_only": {
    "description": "If true, only return lightweight message metadata (id, uid, subject, from, to, date, size, attachment flags, flags, and folder). Use getMessage to fetch full content for a specific message.",
    "type": "boolean"
   },
   "min_size": {
    "description": "Minimum message size in bytes",
    "type": "string"
   },
   "q": {
    "description": "Search query string",
    "type": "string"
   },
   "reply-to": {
    "description": "Filter by Reply-To address",
    "type": "string"
   },
   "search": {
    "description": "IMAP SEARCH query string",
    "type": "string"
   },
   "since": {
    "description": "Filter messages after this date (ISO 8601)",
    "type": "string"
   },
   "subject": {
    "description": "Filter by message subject",
    "type": "string"
   },
   "text": {
    "description": "Full text search query",
    "type": "string"
   },
   "to": {
    "description": "Filter by recipient address",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "listMessages"
}
