{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create an invoice (or credit note) in Billy with one or more lines. Created as draft by default; pass state=approved to approve immediately (approval assigns the invoice number and books it). Amounts are in the invoice currency.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contactId": {
    "description": "Customer contact ID (see list_contacts)",
    "type": "string"
   },
   "contactMessage": {
    "description": "Message shown at the top of the invoice PDF",
    "type": "string"
   },
   "currencyId": {
    "description": "Invoice currency, e.g. 'DKK', 'EUR', 'USD'",
    "type": "string"
   },
   "entryDate": {
    "description": "Invoice date (YYYY-MM-DD)",
    "type": "string"
   },
   "invoiceNo": {
    "description": "Manual invoice number (must be unique; auto-assigned when omitted)",
    "type": "string"
   },
   "lines": {
    "description": "Invoice lines (at least one)",
    "items": {
     "properties": {
      "description": {
       "description": "Line description shown under the product name",
       "type": "string"
      },
      "discountMode": {
       "description": "Discount type",
       "enum": [
        "cash",
        "percent"
       ],
       "type": "string"
      },
      "discountValue": {
       "description": "Discount amount or percentage (25 = 25%)",
       "type": "number"
      },
      "productId": {
       "description": "Product ID (see list_products)",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity (default 1)",
       "type": "number"
      },
      "unitPrice": {
       "description": "Price per unit in the invoice currency",
       "type": "number"
      }
     },
     "required": [
      "productId",
      "unitPrice"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "paymentTermsDays": {
    "description": "Days for the payment terms (drives dueDate)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "paymentTermsMode": {
    "description": "Payment terms mode, e.g. 'net'",
    "type": "string"
   },
   "state": {
    "description": "Invoice state (default 'draft')",
    "enum": [
     "draft",
     "approved"
    ],
    "type": "string"
   },
   "taxMode": {
    "description": "Whether unit prices include or exclude VAT (defaults to org setting)",
    "enum": [
     "incl",
     "excl"
    ],
    "type": "string"
   },
   "type": {
    "description": "Document type (default 'invoice')",
    "enum": [
     "invoice",
     "creditNote"
    ],
    "type": "string"
   },
   "verbose": {
    "description": "Return the full Billy response. Default false: compact records with key fields only (saves ~90% context)",
    "type": "boolean"
   }
  },
  "required": [
   "contactId",
   "entryDate",
   "currencyId",
   "lines"
  ],
  "type": "object"
 },
 "name": "create_invoice"
}
