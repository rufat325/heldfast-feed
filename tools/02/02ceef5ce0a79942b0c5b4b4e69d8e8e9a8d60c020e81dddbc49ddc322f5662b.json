{
 "description": "Bulk import up to 100 websites for monitoring. Each URL gets a target created with auto-enabled tests, initial scan, and screenshot capture. Partial success \u2014 failed URLs are reported individually without blocking others.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "description": "Array of targets to import",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Display name (defaults to hostname)",
       "type": "string"
      },
      "type": {
       "default": "WEBSITE",
       "description": "Target type",
       "enum": [
        "WEBSITE",
        "API",
        "WEBSHOP"
       ],
       "type": "string"
      },
      "url": {
       "description": "URL to monitor",
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "import_targets",
 "title": "Import Targets"
}
