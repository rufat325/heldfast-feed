{
 "description": "Generate an observing session plan for a given location and date. Returns the best celestial objects to observe grouped by time window (evening, midnight, pre-dawn), scored by observability.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date": {
    "description": "Date in ISO 8601 format (defaults to today)",
    "type": "string"
   },
   "latitude": {
    "description": "Observer latitude in degrees (-90 to 90)",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "description": "Observer longitude in degrees (-180 to 180)",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "maxMagnitude": {
    "description": "Maximum (faintest) visual magnitude to include",
    "type": "number"
   },
   "minAltitude": {
    "description": "Minimum peak altitude in degrees (default 15)",
    "type": "number"
   },
   "types": {
    "description": "Object type codes to include (e.g. [\"G\", \"PN\", \"OCl\"])",
    "items": {
     "enum": [
      "*",
      "**",
      "*Ass",
      "OCl",
      "GCl",
      "Cl+N",
      "G",
      "GPair",
      "GTrpl",
      "GGroup",
      "PN",
      "HII",
      "DrkN",
      "EmN",
      "Neb",
      "RfN",
      "SNR",
      "Nova",
      "Other"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "latitude",
   "longitude"
  ],
  "type": "object"
 },
 "name": "plan_session"
}
