{
 "description": "Generate a robots.txt file for a given domain.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "disallow": {
    "default": [
     "/admin",
     "/api",
     "/private"
    ],
    "description": "Paths to disallow",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "domain": {
    "description": "Domain name (e.g. example.com)",
    "type": "string"
   },
   "sitemap_path": {
    "default": "/sitemap.xml",
    "description": "Sitemap path",
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "generate_robots_txt"
}
