{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Check an interview plan draft for problems"
 },
 "description": "Validate an interview-plan draft without publishing it.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "const": "interview_plan.validate_draft",
    "type": "string"
   },
   "input": {
    "additionalProperties": false,
    "properties": {
     "include_warnings": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "resource": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "pattern": "^ipd_[0-9A-Za-z]{16,64}$",
      "type": "string"
     },
     "type": {
      "const": "interview_plan_draft",
      "type": "string"
     }
    },
    "required": [
     "type",
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "action",
   "resource",
   "input"
  ],
  "type": "object"
 },
 "name": "yardstick_interview_plan_drafts_validate",
 "title": "Check an interview plan draft for problems"
}
