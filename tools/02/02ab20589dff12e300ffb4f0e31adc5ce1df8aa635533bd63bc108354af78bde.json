{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/commerce.pack-size-normalize",
  "agent-utilities/priceMicroUsd": 0
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Normalize locale-explicit pack-size expressions and multipacks to exact grams, millilitres or counts; reject ambiguous text. FREE during validation. No key, credits or wallet. Existing source and input limits apply.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "locale": {
      "enum": [
       "en-US",
       "en-GB",
       "de-DE",
       "fr-FR",
       "pt-BR"
      ],
      "type": "string"
     },
     "quantities": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "text": {
         "maxLength": 160,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "id",
        "text"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "locale",
     "quantities"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "commerce_pack_size_normalize",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "allNormalized": {
    "type": "boolean"
   },
   "locale": {
    "type": "string"
   },
   "quantities": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "approximate": {
       "type": "boolean"
      },
      "baseUnit": {
       "type": [
        "string",
        "null"
       ]
      },
      "dimension": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "issue": {
       "type": [
        "string",
        "null"
       ]
      },
      "packCount": {
       "type": [
        "integer",
        "null"
       ]
      },
      "quantity": {
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "enum": [
        "normalized",
        "unsupported"
       ],
       "type": "string"
      },
      "totalQuantity": {
       "type": [
        "string",
        "null"
       ]
      },
      "unit": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "status",
      "quantity",
      "unit",
      "packCount",
      "totalQuantity",
      "baseUnit",
      "dimension",
      "approximate",
      "issue"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scope": {
    "type": "string"
   }
  },
  "required": [
   "locale",
   "quantities",
   "allNormalized",
   "scope"
  ],
  "type": "object"
 }
}
