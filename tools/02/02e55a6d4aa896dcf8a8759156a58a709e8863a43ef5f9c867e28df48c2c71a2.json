   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Optional investor name to search for. Omit or pass an empty string to browse investors.",
    "type": "string"
   },
   "sort": {
    "default": "relevance",
    "description": "Result order. Relevance falls back to fundraise count when query is empty; recent uses the latest public announced date.",
    "enum": [
     "relevance",
     "fundraises",
     "recent",
     "total-invested",
     "name"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "search_investors",
