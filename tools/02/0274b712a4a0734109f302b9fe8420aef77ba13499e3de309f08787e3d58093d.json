{
 "annotations": {
  "readOnlyHint": true,
  "title": "Cardio score"
 },
 "description": "Cardio fitness score (VO2 max estimate) for a date or range. Fitbit REST: GET /1/user/-/cardioscore/date/{date}[/{endDate}].json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date": {
    "description": "Date, yyyy-MM-dd or 'today' (required).",
    "pattern": "^(\\d{4}-\\d{2}-\\d{2}|today)$",
    "type": "string"
   },
   "endDate": {
    "description": "Range end date, yyyy-MM-dd or 'today' (optional).",
    "pattern": "^(\\d{4}-\\d{2}-\\d{2}|today)$",
    "type": "string"
   }
  },
  "required": [
   "date"
  ],
  "type": "object"
 },
 "name": "fitbit_cardio_score",
 "title": "Cardio score"
}
