{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List members"
 },
 "description": "List members of a server with their roles, ordered by user ID. Returns { members: [...], nextCursor }. A page holds up to 1000 members; if nextCursor is non-null, pass it back as `after` to fetch the next page. Use discord_search_members to find specific members by name, or discord_get_member_info for one member's full details. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Pagination cursor: a user ID (snowflake). Pass the previous response's nextCursor to fetch the next page.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "guild_id": {
    "description": "Discord server (guild) ID (snowflake).",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "How many members per page (1\u20131000). Default 50.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "guild_id"
  ],
  "type": "object"
 },
 "name": "discord_list_members",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "members": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "joinedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "nickname": {
       "type": [
        "string",
        "null"
       ]
      },
      "roles": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "username": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "username",
      "nickname",
      "roles",
      "joinedAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextCursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "members",
   "nextCursor"
  ],
  "type": "object"
 }
}
