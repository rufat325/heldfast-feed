{
 "description": "Search global eSIM data plans. Each result includes the full plan shape (countries, region, data limit, validity, routing location, 5G/hotspot/calls/SMS/topup features) so a separate plan-details tool is unnecessary.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "description": "ISO-3166 country code (e.g. 'JP')",
    "type": "string"
   },
   "cursor": {
    "type": "string"
   },
   "has_5g": {
    "type": "boolean"
   },
   "has_hotspot": {
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "min_data_gb": {
    "type": "number"
   },
   "min_days": {
    "type": "number"
   },
   "query": {
    "description": "Substring search on plan title",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_esim_plans"
}
