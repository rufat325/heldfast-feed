{
 "description": "List the 404 monitor log: { items: [{ id, url, hits, first_seen, last_seen, ... }], total, pages }.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "order": {
    "description": "Sort direction (default DESC)",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "order_by": {
    "description": "Sort column (default last_seen)",
    "enum": [
     "id",
     "url",
     "hits",
     "first_seen",
     "last_seen"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page, 1-100 (default 50)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Substring of the 404 URL",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "seo_list_monitor_log"
}
