{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update form template item"
 },
 "description": "Update an existing form template item by ID. template_id and item_key are immutable and cannot be changed. Requires form_template_items:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "config": {
    "additionalProperties": {},
    "description": "Per-type configuration (e.g. { min, max, unit, multiline })",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "help_text": {
    "description": "Help text shown under the label",
    "maxLength": 5000,
    "type": "string"
   },
   "id": {
    "description": "Form template item ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "item_type": {
    "description": "Item type (section, checkbox, single_select, multi_select, number, text, photo, team_members, signature)",
    "enum": [
     "section",
     "checkbox",
     "single_select",
     "multi_select",
     "number",
     "text",
     "photo",
     "team_members",
     "signature"
    ],
    "type": "string"
   },
   "label": {
    "description": "Question label / prompt",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "options": {
    "description": "Choices for single_select / multi_select items",
    "items": {
     "properties": {
      "label": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "value",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "required": {
    "description": "Whether an answer is required",
    "type": "boolean"
   },
   "sort_order": {
    "description": "Display order within the template",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "visible_when": {
    "anyOf": [
     {
      "properties": {
       "itemKey": {
        "type": "string"
       },
       "op": {
        "type": "string"
       },
       "value": {}
      },
      "required": [
       "itemKey",
       "op"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Conditional-visibility rule referencing another item"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_form_template_item",
 "title": "Update form template item"
}
