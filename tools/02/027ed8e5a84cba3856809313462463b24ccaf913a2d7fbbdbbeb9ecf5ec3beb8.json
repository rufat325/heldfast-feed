{
 "description": "Correct or annotate a previously logged outcome. Use when an agent realises an outcome was misclassified (e.g. logged as bounced but the contact actually opened).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "notes": {
    "description": "Updated notes",
    "maxLength": 1000,
    "type": "string"
   },
   "outcome_id": {
    "description": "Outcome ID",
    "type": "string"
   },
   "outcome_type": {
    "description": "New outcome type",
    "enum": [
     "no_response",
     "opened",
     "replied_positive",
     "replied_negative",
     "added_to_playlist",
     "interview_booked",
     "coverage",
     "declined",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "outcome_id"
  ],
  "type": "object"
 },
 "name": "tap_update_outcome"
}
