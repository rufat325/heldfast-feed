{
 "description": "Create a portfolio case (dev.to-style Markdown). Defaults to a draft; set published:true to publish.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body_markdown": {
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "maxLength": 300,
    "type": "string"
   },
   "published": {
    "default": false,
    "type": "boolean"
   },
   "source_language": {
    "default": "en",
    "enum": [
     "en",
     "ru",
     "uk",
     "el"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "maxLength": 120,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "title",
   "body_markdown"
  ],
  "type": "object"
 },
 "name": "create_case",
 "title": "Create a case"
}
