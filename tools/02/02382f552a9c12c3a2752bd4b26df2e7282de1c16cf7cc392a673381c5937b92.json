 "description": "Audit telemetry attributes against a contract, and against the thing a schema cannot see: cardinality. Reports missing required attributes, undeclared attributes, an attribute appearing as two types across the batch, and an attribute whose distinct values exceed your limit - because in a metrics backend each distinct value is a separate series, and that is how an index or a bill explodes. Pay 120000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "attribute_pointer": {
    "description": "Pointer to the attribute object inside each record, such as /attributes. Omit when attributes are the record itself.",
    "example": "/attributes",
    "maxLength": 512,
    "type": "string"
   },
   "cardinality_limit": {
    "description": "Distinct values above which an attribute is reported as a cardinality risk. Defaults to 100.",
    "example": 3,
    "minimum": 1,
    "type": "integer"
   },
   "contract": {
    "additionalProperties": false,
    "example": {
     "optional": [
      "region"
     ],
     "required": [
      "service",
      "environment"
     ],
     "types": {
      "environment": "string",
      "latency_ms": "number",
      "service": "string"
     }
    },
    "properties": {
     "allow_undeclared": {
      "description": "Treat an undeclared attribute as acceptable. Defaults to false.",
      "type": "boolean"
     },
     "optional": {
      "items": {
       "maxLength": 256,
       "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array"
     },
     "required": {
      "items": {
       "maxLength": 256,
       "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array"
     },
     "types": {
      "description": "Map of attribute name to expected JSON type.",
      "type": "object"
     }
    },
    "type": "object"
   },
   "records": {
    "description": "Telemetry records as JSON objects, at most 2000.",
    "example": [
     {
      "attributes": {
       "environment": "prod",
       "latency_ms": 31.2,
       "region": "ap-southeast-2",
       "request_id": "r-1",
       "service": "checkout"
      },
      "name": "http.request"
     },
     {
      "attributes": {
       "environment": "prod",
       "latency_ms": 44,
