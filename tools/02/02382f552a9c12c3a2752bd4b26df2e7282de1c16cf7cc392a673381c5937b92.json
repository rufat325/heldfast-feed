      },
      "name": "http.request"
     },
     {
      "attributes": {
       "environment": "prod",
       "latency_ms": "51",
       "request_id": "r-3",
       "service": "checkout"
      },
      "name": "http.request"
     },
     {
      "attributes": {
       "environment": "prod",
       "latency_ms": 28,
       "request_id": "r-4",
       "service": "checkout"
      },
      "name": "http.request"
     },
     {
      "name": "http.request"
     }
    ],
    "items": {
     "type": "object"
    },
    "maxItems": 2000,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "records",
   "contract"
  ],
  "type": "object"
 },
