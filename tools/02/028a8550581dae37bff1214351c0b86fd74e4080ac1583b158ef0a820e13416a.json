{
 "description": "List a campaign's recipients with their per-recipient status: `pending` (not yet mailed), `sent`, `failed` (with a failure reason), or `skipped` (on the workspace's unsubscribe list, never mailed). Paginated. Use to check who a campaign reached before or after sending.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "campaign_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Match against the recipient address",
    "maxLength": 200,
    "type": "string"
   },
   "status": {
    "enum": [
     "pending",
     "sent",
     "failed",
     "skipped"
    ],
    "type": "string"
   }
  },
  "required": [
   "campaign_id"
  ],
  "type": "object"
 },
 "name": "list_campaign_recipients"
}
