{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Approve or reject pending join requests for a WhatsApp group. Requires admin privileges.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Whether to approve or reject the join requests",
    "enum": [
     "approve",
     "reject"
    ],
    "type": "string"
   },
   "channelId": {
    "description": "WhatsApp channel identifier (UUID)",
    "type": "string"
   },
   "groupJid": {
    "description": "Group JID (ending in @g.us)",
    "type": "string"
   },
   "participants": {
    "description": "Array of phone numbers or JIDs of requesters",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "channelId",
   "groupJid",
   "participants",
   "action"
  ],
  "type": "object"
 },
 "name": "neuron_handle_join_requests",
 "title": "Handle Join Requests"
}
