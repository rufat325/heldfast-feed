  "title": "New Steam releases"
 },
 "description": "Games released on Steam in the last 30 days that players rate well (70%+ positive, 50+ positive reviews), or with `upcoming` the upcoming games that have a release date; optionally co-op only. The site's New releases list, with price, Steam Deck status, release date and links. Released games carry `release_kind`: `new`, or `ea_exit` for a game that just left Early Access (its 1.0; it was playable before), so call those 'out of Early Access', not new. `ea_exits`: include (default), exclude (brand-new games only) or only. Use it for 'what's new / coming out'; for what is gaining players now use trending. Games rated for adults only (explicit sexual content) are not covered; filtering is best effort.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "coop": {
    "default": false,
    "type": "boolean"
   },
   "ea_exits": {
    "default": "include",
    "description": "Games that just left Early Access: include them, exclude them (only brand-new launches) or return only them.",
    "enum": [
     "include",
     "exclude",
     "only"
    ],
    "type": "string"
   },
   "lang": {
    "default": "en",
    "description": "Language of the `why` lines.",
    "enum": [
     "en",
     "ru"
    ],
    "type": "string"
   },
   "n": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "upcoming": {
    "default": false,
    "type": "boolean"
   }
  },
  "type": "object"
 },
