{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/web.page-delta",
  "agent-utilities/priceMicroUsd": 400
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Return added and removed content blocks from supplied before/after HTML; avoid rereading unchanged text. Explicit shared output budget and scope. PAID: 400 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "afterHtml": {
      "maxLength": 100000,
      "type": "string"
     },
     "beforeHtml": {
      "maxLength": 100000,
      "type": "string"
     },
     "maxChars": {
      "default": 6000,
      "maximum": 12000,
      "minimum": 256,
      "type": "integer"
     },
     "sourceUrl": {
      "maxLength": 2048,
      "type": "string"
     }
    },
    "required": [
     "beforeHtml",
     "afterHtml"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "web_page_delta",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "added": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "addedBlocks": {
    "type": "number"
   },
   "changed": {
    "type": "boolean"
   },
   "measurement": {
    "additionalProperties": false,
    "properties": {
     "estimateMethod": {
      "type": "string"
     },
     "estimatedInputTokens": {
      "type": "number"
     },
     "estimatedPayloadTokens": {
      "type": "number"
     },
     "inputBytes": {
      "type": "number"
     },
     "payloadBytes": {
      "type": "number"
     }
    },
    "required": [
     "inputBytes",
     "payloadBytes",
     "estimatedInputTokens",
     "estimatedPayloadTokens",
     "estimateMethod"
    ],
    "type": "object"
   },
   "removed": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "removedBlocks": {
    "type": "number"
   },
   "reorderedOnly": {
    "type": "boolean"
   },
   "scope": {
    "type": "string"
   },
   "sourceUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "titleAfter": {
    "type": "string"
   },
   "titleBefore": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "sourceUrl",
   "changed",
   "titleBefore",
   "titleAfter",
   "added",
   "removed",
   "addedBlocks",
   "removedBlocks",
   "reorderedOnly",
   "truncated",
   "scope",
   "measurement"
  ],
  "type": "object"
 }
}
