{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add one or more volunteers to the roster in a single call. ALL-OR-NOTHING: if the batch would push the account past its plan's volunteer limit, or any contact references a group_id not on this account, NOTHING is added and the error names the limit/count/bad id so you can adjust. Phone numbers are validated and normalized to E.164. Requires the `contacts:write` scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "contacts": {
    "description": "The volunteers to add (1\u2013200 per call). Each needs at least a full_name.",
    "items": {
     "properties": {
      "email_address": {
       "anyOf": [
        {
         "format": "email",
         "maxLength": 320,
         "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Email address reminders may be sent to, or null."
      },
      "first_name": {
       "anyOf": [
        {
         "maxLength": 120,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "First name, or null."
      },
      "full_name": {
       "description": "Display name, shown on the roster and in reminder text. Required.",
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "group_id": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Id of an existing group on this account to file the contact under, or null."
      },
      "land_phone": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Landline number (informational only, never texted), or null."
      },
      "last_name": {
       "anyOf": [
        {
         "maxLength": 120,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Last name, or null."
      },
      "mobile_phone": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Mobile number for SMS reminders. Accepts E.164 (+15125550100) or a plain 10-digit US/Canada number; stored as E.164. Send null to clear."
      },
      "notes": {
       "anyOf": [
        {
         "maxLength": 2000,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Free-text notes about the contact, or null."
      }
     },
     "required": [
      "full_name"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "contacts"
  ],
  "type": "object"
 },
 "name": "add_contacts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "created": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "full_name": {
       "type": "string"
      },
      "id": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "full_name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "created"
  ],
  "type": "object"
 },
 "title": "Add volunteers"
}
