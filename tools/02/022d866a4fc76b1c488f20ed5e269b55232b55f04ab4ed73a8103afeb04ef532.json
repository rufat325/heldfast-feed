{
 "description": "Update an existing standard zone",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ad_size_filter": {
    "additionalProperties": false,
    "description": "Ad size filter (dynamic zones only)",
    "properties": {
     "sizes": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "height": {
         "type": "number"
        },
        "width": {
         "type": "number"
        }
       },
       "required": [
        "width",
        "height"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "type": {
      "enum": [
       "INCLUSIVE",
       "EXCLUSIVE"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "allow_demand_sources": {
    "description": "Allow requests to demand endpoints",
    "type": "boolean"
   },
   "allowed_root_native_templates": {
    "description": "Allowed root native template IDs",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "api_frameworks": {
    "description": "Supported API frameworks",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "auction_tie_break": {
    "description": "Tie-breaking method",
    "enum": [
     "RANDOM",
     "SCORE"
    ],
    "type": "string"
   },
   "bid_floor": {
    "description": "Default bid floor",
    "type": "number"
   },
   "burn_in_hours": {
    "description": "Hours before eCPM confidence",
    "type": "number"
   },
   "burn_in_impressions": {
    "description": "Impressions before eCPM confidence",
    "type": "number"
   },
   "dimensions": {
    "description": "Zone dimensions type",
    "enum": [
     "fixed",
     "dynamic"
    ],
    "type": "string"
   },
   "ecpm_testing_allowance": {
    "description": "Percentage for eCPM recalculation",
    "type": "number"
   },
   "height": {
    "description": "Zone height in pixels",
    "type": "number"
   },
   "iab_categories": {
    "description": "IAB category descriptors",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "Zone ID",
    "type": "number"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom metadata key-value pairs",
    "type": "object"
   },
   "min_payout": {
    "description": "Minimum payout per impression (CPM)",
    "type": "number"
   },
   "name": {
    "description": "Zone name",
    "type": "string"
   },
   "optimization_strategy": {
    "description": "Zone optimization strategy",
    "type": "string"
   },
   "pmp_deals": {
    "description": "Allowed PMP Deal IDs",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "private_auction": {
    "description": "Ignore non-deal bids in auction",
    "type": "boolean"
   },
   "publisher": {
    "description": "Publisher ID",
    "type": "number"
   },
   "refresh_frequency": {
    "description": "Interval in seconds for serving new ads",
    "type": "number"
   },
   "refresh_limit": {
    "description": "Total times zone will refresh",
    "type": "number"
   },
   "responsive": {
    "description": "Size behavior",
    "enum": [
     "fixed",
     "auto",
     "inherit"
    ],
    "type": "string"
   },
   "rtb_placement_id": {
    "description": "OpenRTB tagid identifier",
    "type": "string"
   },
   "serve_priority_order": {
    "description": "Priority order",
    "enum": [
     "weight",
     "auction"
    ],
    "type": "string"
   },
   "unique_delivery": {
    "description": "Serve unique ads on each zone",
    "type": "boolean"
   },
   "width": {
    "description": "Zone width in pixels",
    "type": "number"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_zone"
}
