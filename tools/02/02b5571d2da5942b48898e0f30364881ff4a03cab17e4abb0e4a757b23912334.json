{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Current news on any topic, in any language"
 },
 "description": "Current headlines on any topic from the publishers of the reader's own country and language: the query goes to the Google News edition for the language and region asked (71 editions verified: en, ja, ko, zh, de, fr, es, pt, ar, hi, id, th, vi and more), and a ticker adds Yahoo Finance's own feed for that stock, including non-US listings. Merged, de-duplicated, newest first, with publisher, time and summary; a window in hours optional. Input: query and/or symbol; optional language, region, limit. $0.25 per call. Returns: query, symbol, language, edition{}, sources_searched[], sources_ok[], sources_failed[], articles[{title, url, source_name, source_url, published_at, summary, feed}], article_count, limit, since_hours, notes[], checked_at.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "language": {
    "description": "Optional BCP-47 language tag (en, ja, pt-BR, zh-Hant): every prose field of the answer is written in this language. Default: the language of the material or question.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   },
   "limit": {
    "description": "Default 20.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Topic words in any language (\u534a\u5c0e\u4f53, \ubc18\ub3c4\uccb4, tarifs douaniers).",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "region": {
    "description": "ISO 3166-1 alpha-2 country whose publishers to search (JP, KR, GB). Default: the language's home edition.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "since_hours": {
    "description": "Only articles published within this many hours.",
    "maximum": 720,
    "minimum": 1,
    "type": "integer"
   },
   "symbol": {
    "description": "Optional ticker (AAPL, 7203.T, 005930.KS) for that stock's own news feed.",
    "pattern": "^[A-Za-z0-9.\\-=^]{1,12}$",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "hubvibe_news_search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The 200 body of every paid /work call. `result` is the worker's own output (its schema is per route); everything else is the same on every /work route. A receipt for the job is at `receipt_url`.",
  "properties": {
   "billing_warning": {
    "description": "Present only when the charge was recorded with a caveat.",
    "examples": [
     "settlement pending"
    ],
    "type": "string"
   },
   "price_usd": {
    "description": "What this call cost, in USD.",
    "examples": [
     0.02
    ],
    "type": "number"
   },
   "provenance": {
    "description": "How the result was produced: which providers ran and how long each took.",
    "properties": {
     "attempts": {
      "description": "Provider attempts made, including retries and failovers.",
      "examples": [
       1
      ],
      "type": "integer"
     },
     "elapsed_ms": {
      "description": "Wall-clock milliseconds for the whole job.",
      "examples": [
       340
      ],
      "type": "integer"
     },
     "providers_used": {
      "description": "Providers that served the job.",
      "examples": [
       [
        "coinbase-advanced-trade-public"
       ]
      ],
      "items": {
       "description": "Provider name.",
       "examples": [
        "coinbase-advanced-trade-public"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "steps": {
      "description": "Every step the job ran, in order.",
      "items": {
       "description": "One step of the job.",
       "properties": {
        "ms": {
         "description": "Milliseconds the step took.",
         "examples": [
          312
         ],
         "type": "integer"
        },
        "ok": {
         "description": "Whether the step succeeded.",
         "examples": [
          true
         ],
         "type": "boolean"
        },
        "provider": {
         "description": "Provider that served the step.",
         "examples": [
          "coinbase-advanced-trade-public"
         ],
         "type": "string"
        },
        "reason": {
         "description": "Failure reason, on a failed step.",
         "examples": [
          "provider_timeout"
         ],
         "type": "string"
        },
        "step": {
         "description": "Step name inside the worker.",
         "examples": [
          "quote"
         ],
         "type": "string"
        }
       },
       "required": [
        "step",
        "ok",
        "ms"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "steps",
     "providers_used",
     "attempts",
     "elapsed_ms"
    ],
    "type": "object"
   },
   "receipt_id": {
    "description": "Receipt id for this job.",
    "examples": [
     "rcpt_9f1c2b3a4d5e6f70"
    ],
    "type": "string"
   },
   "receipt_url": {
    "description": "Where to fetch the machine-readable receipt (free, no payment).",
    "examples": [
     "/work/receipts/rcpt_9f1c2b3a4d5e6f70"
    ],
    "type": "string"
   },
   "result": {
    "properties": {
     "article_count": {
      "description": "Articles returned.",
      "examples": [
       20
      ],
      "type": "integer"
     },
     "articles": {
      "description": "Articles, newest first, duplicates by title removed.",
      "items": {
       "description": "One article.",
       "properties": {
        "feed": {
         "description": "Which feed it came from.",
         "enum": [
          "google_news",
          "yahoo_finance"
         ],
         "examples": [
          "google_news"
         ],
         "type": "string"
        },
        "published_at": {
         "description": "Publication time (UTC).",
         "examples": [
          "2026-09-27T02:32:00Z"
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "source_name": {
         "description": "Publisher.",
         "examples": [
          "\u65e5\u672c\u7d4c\u6e08\u65b0\u805e"
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "source_url": {
         "description": "Publisher site.",
         "examples": [
          "https://www.nikkei.com"
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "summary": {
         "description": "Plain-text summary when the feed carries one.",
         "examples": [
          "\u534a\u5c0e\u4f53\u95a2\u9023\u682a\u304c..."
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "title": {
         "description": "Headline, publisher suffix removed.",
         "examples": [
          "\u534a\u5c0e\u4f53\u682a\u304c\u53cd\u767a\u3001\u95a2\u7a0e\u5354\u8b70\u306e\u9032\u5c55\u3067"
         ],
         "type": "string"
        },
        "url": {
         "description": "Article link (Google News links resolve to the publisher).",
         "examples": [
          "https://news.google.com/rss/articles/CBMi..."
         ],
         "type": "string"
        }
       },
       "required": [
        "title",
        "url",
        "source_name",
        "source_url",
        "published_at",
        "summary",
        "feed"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "checked_at": {
      "description": "When this node read the source (UTC). Nothing here is cached.",
      "examples": [
       "2026-09-26T18:00:00Z"
      ],
      "format": "date-time",
      "type": "string"
     },
     "edition": {
      "description": "The Google News edition used; null when no query was given.",
      "properties": {
       "ceid": {
        "description": "Edition id.",
        "examples": [
         "JP:ja"
        ],
        "type": "string"
       },
       "gl": {
        "description": "Country edition.",
        "examples": [
         "JP"
        ],
        "type": "string"
       },
       "hl": {
        "description": "Google News language code.",
        "examples": [
         "ja"
        ],
        "type": "string"
       },
       "verified": {
        "description": "True for the 71 editions verified to answer; false for a pair tried on request.",
        "examples": [
         true
        ],
        "type": "boolean"
       }
      },
      "required": [
       "hl",
       "gl",
       "ceid",
       "verified"
      ],
      "type": [
       "object",
       "null"
      ]
     },
     "language": {
      "description": "BCP-47 language the edition was chosen for.",
      "examples": [
       "ja"
      ],
      "type": "string"
     },
     "limit": {
      "description": "Most articles asked for.",
      "examples": [
       20
      ],
      "type": "integer"
     },
     "notes": {
      "description": "Caveats; empty when none.",
      "examples": [
       []
      ],
      "items": {
       "description": "A caveat.",
       "examples": [
        "Edition XX:yy returned nothing for this query; results are from the en/US edition."
       ],
       "type": "string"
      },
      "type": "array"
     },
     "query": {
      "description": "Topic searched, as given; null when only a symbol was asked.",
      "examples": [
