      ],
      "type": [
       "string",
       "null"
      ]
     },
     "since_hours": {
      "description": "Window applied, in hours; null when none.",
      "examples": [
       24
      ],
      "type": [
       "integer",
       "null"
      ]
     },
     "sources_failed": {
      "description": "Feeds that did not answer, with the reason; never silently dropped.",
      "examples": [
