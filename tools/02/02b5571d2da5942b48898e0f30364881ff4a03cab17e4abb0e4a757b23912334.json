       "type": "object"
      },
      "type": "array"
     },
     "sources_ok": {
      "description": "Feeds that answered.",
      "examples": [
       [
        "google_news:JP:ja"
       ]
      ],
      "items": {
       "description": "Feed id.",
       "examples": [
        "google_news:JP:ja"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "sources_searched": {
      "description": "Feeds this call asked.",
      "examples": [
       [
        "google_news:JP:ja"
       ]
