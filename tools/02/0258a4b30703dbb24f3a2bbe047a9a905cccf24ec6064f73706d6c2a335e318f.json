{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List static routes on a MikroTik router with optional filtering by active status and dynamic status. Supports pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activeOnly": {
    "default": false,
    "description": "Return only active routes",
    "type": "boolean"
   },
   "limit": {
    "default": 100,
    "description": "Max results to return.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset.",
    "minimum": 0,
    "type": "integer"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "staticOnly": {
    "default": false,
    "description": "Return only non-dynamic routes",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_routes",
 "title": "List Static Routes"
}
