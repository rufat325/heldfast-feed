{
 "description": "Render ZPL label code to a PNG image via the Labelixa API. This is a SERVER-SIDE render for inspection \u2014 it is not a guarantee of how a specific physical printer will output the label.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dpmm": {
    "default": 8,
    "description": "Printer density in dots per mm (6, 8, 12 or 24)",
    "type": "integer"
   },
   "height_in": {
    "default": 6,
    "description": "Label height in inches (at most 15)",
    "exclusiveMinimum": 0,
    "maximum": 15,
    "type": "number"
   },
   "index": {
    "default": 0,
    "description": "Which label to render when the stream contains several",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "width_in": {
    "default": 4,
    "description": "Label width in inches (at most 15)",
    "exclusiveMinimum": 0,
    "maximum": 15,
    "type": "number"
   },
   "zpl": {
    "description": "Raw ZPL code (^XA ... ^XZ)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "zpl"
  ],
  "type": "object"
 },
 "name": "zpl_preview"
}
