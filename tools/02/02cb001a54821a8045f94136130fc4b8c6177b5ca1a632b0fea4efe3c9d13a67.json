  "readOnlyHint": true,
  "title": "Get one NYC condo unit or co-op apartment"
 },
 "description": "Free. Reads one unit inside an NYC building: a condominium unit (its own tax lot, with its own market value) or a co-op apartment (shares, valued here by an estimate from recent sales in its line). Pass the building lot from find_nyc_property and the unit as the person wrote it, e.g. \"14E\", \"Apt 1C\" or \"#PH-A\". Use it whenever the person names a unit, apartment or penthouse; the building lot alone describes the whole building, not the unit.",
 "inputSchema": {
  "properties": {
   "bbl": {
    "description": "The building's 10-digit lot (BBL) from find_nyc_property.",
    "pattern": "^[1-5]\\d{9}$",
    "type": "string"
   },
   "unit": {
    "description": "Leave out to list the building's units.",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "bbl"
  ],
  "type": "object"
 },
