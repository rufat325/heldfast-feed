    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Graded population for one card: PSA population by grade (total / 10 / 9 / 8), CCIC population (total / 10 / 9.5 / 9), PSA gem rate and scarcity tier when available. Calls record usage and query metadata within POKEKA.",
 "inputSchema": {
  "properties": {
   "card_id": {
    "description": "Card id from search_card / slang_lookup.",
    "type": "string"
   }
  },
  "required": [
   "card_id"
  ],
  "type": "object"
 },
 "name": "card_pop",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "card_id": {
    "type": "string"
   },
   "ccic": {
    "additionalProperties": true,
    "properties": {
     "pop10": {
      "type": "number"
     },
     "pop9": {
      "type": "number"
     },
     "pop9_5": {
      "type": "number"
     },
     "total": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "gem_rate": {
    "type": "number"
   },
   "gem_rate_band": {
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "psa": {
    "additionalProperties": true,
    "properties": {
     "pop10": {
      "type": "number"
     },
     "pop8": {
      "type": "number"
     },
     "pop9": {
      "type": "number"
     },
     "total": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "scarcity_tier": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "mcp:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Population report"
}
