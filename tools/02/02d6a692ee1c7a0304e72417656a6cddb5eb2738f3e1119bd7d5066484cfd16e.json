{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Buyer-side assurance in one step: preflight a public service you chose and record the delivery checks you expect. Returns a `terms_id`; finish with assurance_complete and check any receipt with assurance_verify. Free, read-only, no account. Inputs must be public and non-personal; calling declares that (data_classification defaults to PUBLIC).",
 "inputSchema": {
  "examples": [
   {
    "checks": [
     {
      "allowed": [
       200
      ],
      "id": "http_status_in"
     },
     {
      "id": "json_parses"
     }
    ],
    "counterparty_id": "example-weather-agent",
    "explicit_read_only_consent": true,
    "service_url": "https://weather.example.com/forecast.json",
    "task_class": "weather_forecast"
   }
  ],
  "properties": {
   "checks": {
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "counterparty_id": {
    "type": "string"
   },
   "data_classification": {
    "default": "PUBLIC",
    "enum": [
     "PUBLIC",
     "NON_PERSONAL_PUBLIC"
    ],
    "type": "string"
   },
   "episode_id": {
    "type": "string"
   },
   "explicit_read_only_consent": {
    "const": true
   },
   "service_url": {
    "type": "string"
   },
   "task_class": {
    "type": "string"
   }
  },
  "required": [
   "service_url",
   "checks",
   "explicit_read_only_consent"
  ],
  "type": "object"
 },
 "name": "assurance_prepare"
}
