{
 "annotations": {
  "readOnlyHint": true,
  "title": "Query usage for a meter"
 },
 "description": "Query aggregated usage for a single meter over a time range, optionally grouped/filtered. API: POST /usage/.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "aggregation": {
    "description": "Aggregation function: SUM | COUNT | MIN | MAX.",
    "enum": [
     "SUM",
     "COUNT",
     "MIN",
     "MAX"
    ],
    "type": "string"
   },
   "end_time_in_seconds": {
    "description": "Range end, unix epoch seconds. Defaults to now if omitted.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "filter": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "description": "Dimension filter: map of dimension name -> allowed values.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "group_by": {
    "description": "Dimension names to group results by, e.g. [\"customerId\"].",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "meter_api_name": {
    "description": "The meterApiName to query (from amberflo_list_meters).",
    "type": "string"
   },
   "start_time_in_seconds": {
    "description": "Range start, unix epoch seconds (inclusive).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "take_is_ascending": {
    "description": "Sort order for `take` (default false = descending).",
    "type": "boolean"
   },
   "take_limit": {
    "description": "Return only the top N groups.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "time_grouping_interval": {
    "description": "Bucket size: HOUR | DAY | WEEK | MONTH.",
    "enum": [
     "HOUR",
     "DAY",
     "WEEK",
     "MONTH"
    ],
    "type": "string"
   }
  },
  "required": [
   "meter_api_name",
   "aggregation",
   "time_grouping_interval",
   "start_time_in_seconds"
  ],
  "type": "object"
 },
 "name": "amberflo_get_usage",
 "title": "Query usage for a meter"
}
