{
 "description": "List installed packages. Supports filtering by name.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "filter": {
    "description": "Filter packages containing this string",
    "type": "string"
   },
   "type": {
    "default": "all",
    "description": "Show all, system-only, or third-party-only packages",
    "enum": [
     "all",
     "system",
     "third-party"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "adb_list_packages"
}
