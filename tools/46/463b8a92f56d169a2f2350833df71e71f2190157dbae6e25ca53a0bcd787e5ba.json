{
 "description": "Assign one exact published course version through the canonical Project To-do control plane. Mastery is opt-in, one-worker/one-module/SYSTEM-only, and requires a signed planReceiptToken from opentrain_lms_plan_assignment. Requires confirmAssign=true and an idempotency key. This tool never returns worker email.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "enum": [
     "ACTIVE",
     "FUTURE",
     "ACTIVE_AND_FUTURE",
     "SELECTED"
    ],
    "type": "string"
   },
   "blockingMode": {
    "enum": [
     "NONE",
     "IMMEDIATE",
     "AFTER_DUE"
    ],
    "type": "string"
   },
   "categoryId": {
    "anyOf": [
     {
      "$ref": "#/properties/jobId"
     },
     {
      "type": "null"
     }
    ]
   },
   "completionPolicy": {
    "enum": [
     "SYSTEM",
     "EMPLOYER_REVIEW"
    ],
    "type": "string"
   },
   "confirmAssign": {
    "const": true,
    "type": "boolean"
   },
   "courseId": {
    "$ref": "#/properties/jobId"
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 20000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "dueOffsetMinutes": {
    "anyOf": [
     {
      "maximum": 525600,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "expectedCourseVersionId": {
    "$ref": "#/properties/jobId"
   },
   "idempotencyKey": {
    "description": "Required request idempotency key. Reuse it only for the identical operation.",
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "jobId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "masteryAntiGuessPolicy": {
    "additionalProperties": false,
    "properties": {
     "cooldownStepsSeconds": {
      "items": {
       "maximum": 3600,
       "minimum": 1,
       "type": "integer"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     },
     "restartScope": {
      "enum": [
       "WHOLE_MODULE",
       "MISSED_QUESTIONS"
      ],
      "type": "string"
     },
     "schemaVersion": {
      "const": 1,
      "type": "number"
     }
    },
    "required": [
     "schemaVersion",
     "cooldownStepsSeconds",
     "restartScope"
    ],
    "type": "object"
   },
   "masteryMode": {
    "type": "boolean"
   },
   "masteryRunLimit": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "moduleKeys": {
    "items": {
     "$ref": "#/properties/jobId"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "planReceiptToken": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "priority": {
    "enum": [
     "NORMAL",
     "HIGH",
     "URGENT"
    ],
    "type": "string"
   },
   "required": {
    "type": "boolean"
   },
   "selectedContractIds": {
    "items": {
     "$ref": "#/properties/jobId"
    },
    "maxItems": 500,
    "type": "array"
   },
   "title": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "courseId",
   "expectedCourseVersionId",
   "completionPolicy",
   "audience",
   "confirmAssign",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_create_assignment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
