    "description": "Workflow tag name: 1-24 characters, without surrounding whitespace or controls.",
    "maxLength": 24,
    "minLength": 1,
    "type": "string"
   },
   "tagId": {
    "description": "Stable ID of the workflow tag to rename.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "type": "string"
   }
  },
  "required": [
   "tagId",
   "name"
  ],
  "type": "object"
 },
