{
 "_meta": {
  "openai/toolInvocation/invoked": "Sender domain checked",
  "openai/toolInvocation/invoking": "Verifying sender domain DNS"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Check the DNS records for a site's custom sender domain (DKIM TXT + SPF include). Once the DKIM record is observed, the sender domain is marked verified and the relay sends from the custom From (DKIM-signed). Until then it falls back to the platform address. DNS can take a few minutes to propagate \u2014 re-run if it fails the first time. Not needed when the site uses a custom smtpRelay.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "siteName": {
    "description": "The site whose custom sender domain to (re)check.",
    "type": "string"
   }
  },
  "required": [
   "siteName"
  ],
  "type": "object"
 },
 "name": "verify_forms_sender_domain",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dkimVerified": {
    "type": "boolean"
   },
   "dnsRecords": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "domain": {
    "type": "string"
   },
   "lastError": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "spfVerified": {
    "type": "boolean"
   },
   "status": {
    "description": "pending | verified | failed",
    "type": "string"
   }
  },
  "required": [
   "domain",
   "status",
   "dkimVerified",
   "spfVerified",
   "dnsRecords",
   "lastError"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "deploy",
    "sites:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Verify a forms custom sender domain"
}
