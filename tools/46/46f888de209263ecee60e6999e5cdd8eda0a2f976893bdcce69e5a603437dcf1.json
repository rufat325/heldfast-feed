{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get room calendar"
 },
 "description": "Per-day calendar values for rooms: units available, min/max stay, multiplier, override (blackout, no check-in, ...) and the price slots price1..price16, as date ranges. Choose fields with the include flags; if none are set this tool asks for numAvail, minStay, maxStay, override and prices. Beds24: GET /inventory/rooms/calendar.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "endDate": {
    "description": "Last date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "includeChannels": {
    "description": "Include per-channel booking limits.",
    "type": "boolean"
   },
   "includeLinkedPrices": {
    "type": "boolean"
   },
   "includeMaxStay": {
    "type": "boolean"
   },
   "includeMinStay": {
    "type": "boolean"
   },
   "includeMultiplier": {
    "type": "boolean"
   },
   "includeNumAvail": {
    "type": "boolean"
   },
   "includeOverride": {
    "type": "boolean"
   },
   "includePrices": {
    "type": "boolean"
   },
   "page": {
    "description": "Page number beyond the first (2, 3, ...). Check pages.nextPageExists in the previous response.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "propertyIds": {
    "description": "One or more property ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "roomIds": {
    "description": "One or more room ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "startDate": {
    "description": "First date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "beds24_get_room_calendar",
 "title": "Get room calendar"
}
