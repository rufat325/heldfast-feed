{
 "annotations": {
  "readOnlyHint": true,
  "title": "List purchase orders"
 },
 "description": "List purchase orders, filtered by status, supplier, order number, warehouse or date range. Unleashed: GET /PurchaseOrders/{page}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "completedAfter": {
    "description": "Orders completed after this date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "completedBefore": {
    "description": "Orders completed before this date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "customOrderStatus": {
    "description": "A custom order status.",
    "type": "string"
   },
   "endDate": {
    "description": "Orders dated on/before this date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "modifiedSince": {
    "description": "Only records created or modified since this UTC date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "orderNumber": {
    "description": "Only the purchase order with this number.",
    "type": "string"
   },
   "orderStatus": {
    "description": "Comma-separated: Parked, Placed, Unapproved, Costed, Receipted, Complete, Deleted.",
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based). Default 1.",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Records per page, 1-1000. Unleashed default is 200.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "startDate": {
    "description": "Orders dated on/after this date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "supplierCode": {
    "description": "Only orders whose supplier code starts with this.",
    "type": "string"
   },
   "warehouseCode": {
    "description": "Only orders into this warehouse.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "unleashed_list_purchase_orders",
 "title": "List purchase orders"
}
