{"_meta":{"securitySchemes":[{"scopes":["atlasly.mcp","atlasly.site_package.run"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Start Site Package"},"description":"Purpose: request a background Atlasly site package for a resolved site. When to use: only after the user explicitly asks to start a package and connects an account with atlasly.site_package.run permission. Inputs: address, optional search radius in metres and an optional existing project_id; account ownership and entitlement are enforced by the package service. Side effect: submits a new job to the Atlasly package service, which may retrieve independently published source data. Repeated calls can create separate jobs. Returns: accepted job_id and an Atlasly link, not a finished report or download. Use get_job_status to inspect completion, failed steps and reported files. Source coverage, export formats, delivery time and native import are unverified at acceptance. No global planning clearance, terrain, 3D or guaranteed CAD/GIS deliverable. For an immediate bounded buildings/roads export, use export_site_context instead. Chaining: every response returns site_ref; pass it unchanged into another Atlasly tool to reuse the canonical site, coordinates, boundary confidence, LPA, evidence links, and project context.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"address":{"description":"Site address or postcode, with town and country outside the UK. Alternatively pass site_ref from an earlier result; do not send both for different locations.","minLength":3,"type":"string"},"project_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"radius_meters":{"description":"Search radius in metres around the site. Requests above the caller's limit (1,000 m without an account, 2,000 m with one) are reduced or rejected.","maximum":5000,"minimum":250,"type":"integer"},"site_ref":{"description":"Canonical site_ref returned by any previous Atlasly tool. Pass it unchanged to chain the same resolved site into this call; address, search_area, or project_id will be filled from it when omitted.","properties":{"address_aliases":{"items":{"maxLength":300,"minLength":1,"type":"string"},"maxItems":4,"type":"array"},"boundary_confidence":{"enum":["address_point","inferred_parcel","red_line_upload","unknown"],"type":"string"},"boundary_id":{"type":["string","null"]},"canonical_address":{"type":["string","null"]},"coordinates":{"anyOf":[{"properties":{"lat":{"type":"number"},"lng":{"type":"number"}},"required":["lat","lng"],"type":"object"},{"type":"null"}]},"country_code":{"pattern":"^[a-z]{2}$","type":"string"},"id":{"type":["string","null"]},"jurisdiction":{"type":["string","null"]},"local_planning_authority":{"type":["string","null"]},"location_source":{"enum":["geocoder","user_coordinates"],"type":"string"},"project_id":{"type":["string","null"]},"source_links":{"items":{"properties":{"label":{"type":"string"},"url":{"format":"uri","type":"string"}},"required":["label","url"],"type":"object"},"type":"array"},"status":{"enum":["resolved","partial","unresolved"],"type":"string"},"version":{"const":"1","type":"string"}},"required":["version","status","id","canonical_address","coordinates","boundary_id","boundary_confidence","jurisdiction","local_planning_authority","source_links","project_id"],"type":"object"}},"type":"object"},"name":"run_site_package","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"atlasly_link":{"additionalProperties":false,"properties":{"label":{"type":"string"},"url":{"type":"string"}},"required":["label","url"],"type":"object"},"confidence_notes":{"items":{"type":"string"},"type":"array"},"details":{"additionalProperties"