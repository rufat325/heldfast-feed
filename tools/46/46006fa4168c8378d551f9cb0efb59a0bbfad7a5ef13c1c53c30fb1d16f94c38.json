{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Generic record query for any Salesforce object. Requires object_name (or its alias sobject). For standard objects, prefer dedicated get tools.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fields": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "string"
     }
    ],
    "description": "Fields to SELECT (defaults to Id); array or comma-separated string"
   },
   "filters": {
    "description": "WHERE conditions (AND-joined)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "field": {
       "description": "Field API name",
       "type": "string"
      },
      "operator": {
       "description": "Comparison operator",
       "enum": [
        "=",
        "!=",
        "<",
        ">",
        "<=",
        ">=",
        "LIKE"
       ],
       "type": "string"
      },
      "value": {
       "description": "Filter value",
       "type": [
        "string",
        "number",
        "boolean"
       ]
      }
     },
     "required": [
      "field",
      "operator",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max results 1-200 (default: 50)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "object_name": {
    "description": "sObject API name",
    "minLength": 1,
    "type": "string"
   },
   "record_id": {
    "description": "Fetch one record by ID (adds an Id = ... condition)",
    "minLength": 1,
    "type": "string"
   },
   "sobject": {
    "description": "Alias of object_name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "salesforce_get_records"
}
