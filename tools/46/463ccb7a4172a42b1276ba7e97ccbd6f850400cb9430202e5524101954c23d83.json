 "description": "Which entries were added to, dropped from, changed in or returned to Japan FSA registers and warning lists since a date? From this service's own record of list versions (the FSA publishes only current lists). Each change has the list, registration number, name as published (personal names withheld), before/after fields, observed_at and the list as-of date. Reasons are not published or inferred. History starts at tracking_since; free window: last 30 days.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "change_type": {
    "description": "Optional filter: added, no_longer_listed, details_changed or relisted",
    "enum": [
     "added",
     "no_longer_listed",
     "details_changed",
     "relisted"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of changes, 1-500 (default 100)",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "list": {
    "description": "Optional: one list id (fib, cae, epi, fts, ml, w_fib_dom, w_fib_ovs, w_fib_qii, w_cae_dom, w_cae_ovs) or registers / warnings; default all lists",
    "maxLength": 20,
    "type": "string"
   },
   "since": {
    "description": "ISO 8601 date or date-time with time zone, e.g. 2026-10-01 or 2026-10-01T00:00:00Z",
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "since"
  ],
  "type": "object"
 },
