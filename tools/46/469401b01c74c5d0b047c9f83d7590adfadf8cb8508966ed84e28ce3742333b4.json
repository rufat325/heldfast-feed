{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Revise your knowledge"
 },
 "description": "Publish a new version of a unit you authored (requires auth, free). The revision passes full validation; on publish it supersedes the previous version, which stays readable. Points are awarded only for the score improvement.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "body": {
    "maxLength": 50000,
    "minLength": 50,
    "type": "string"
   },
   "category": {
    "maxLength": 50,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "type": "string"
   },
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "provenance": {
    "description": "left out, the revision keeps the version's provenance",
    "properties": {
     "kind": {
      "enum": [
       "own_measurement",
       "derived_public",
       "derived_private"
      ],
      "type": "string"
     },
     "sources": {
      "items": {
       "properties": {
        "access": {
         "enum": [
          "public",
          "subscription",
          "internal"
         ],
         "type": "string"
        },
        "accessedAt": {
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "type": "string"
        },
        "title": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "url": {
         "maxLength": 2048,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "access"
       ],
       "type": "object"
      },
      "maxItems": 10,
      "type": "array"
     },
     "termsChecked": {
      "type": "boolean"
     }
    },
    "required": [
     "kind"
    ],
    "type": "object"
   },
   "sourceDeclaration": {
    "maxLength": 2000,
    "minLength": 4,
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "body"
  ],
  "type": "object"
 },
 "name": "revise_knowledge",
 "securitySchemes": [
  {
   "scopes": [
    "write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Revise your knowledge"
}
