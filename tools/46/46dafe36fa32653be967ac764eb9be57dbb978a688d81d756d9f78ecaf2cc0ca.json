  "readOnlyHint": true
 },
 "description": "Read-only: convert an ordered TouchDesigner operator chain into a RecipeSchema draft without writing files or touching the TD bridge.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chain": {
    "description": "Ordered TouchDesigner operator names, display names, slugs, or optypes, e.g. ['Noise TOP', 'Level TOP', 'Null TOP'].",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "description": {
    "default": "",
    "description": "Optional recipe description. A chain summary is generated when omitted.",
    "type": "string"
   },
   "difficulty": {
    "default": "intermediate",
    "enum": [
     "beginner",
     "intermediate",
     "advanced"
    ],
    "type": "string"
   },
   "family": {
    "description": "Optional operator family/category constraint, e.g. TOP, CHOP, SOP, DAT.",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Optional recipe id. Generated when omitted.",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Optional recipe display name. Generated when omitted.",
    "minLength": 1,
    "type": "string"
   },
   "strict": {
    "default": true,
    "description": "When true, unresolved operators or family mismatches return an isError result.",
    "type": "boolean"
   },
   "tags": {
    "default": [],
    "description": "Optional recipe tags.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "td_version_min": {
    "default": "2023",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "chain"
  ],
  "type": "object"
 },
