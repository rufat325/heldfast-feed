{
 "description": "Deletes messages from a mailbox by IDs or deletes all messages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "format": "starts_with",
    "pattern": "^amk_.*",
    "type": "string"
   },
   "deleteAll": {
    "type": "boolean"
   },
   "mailboxId": {
    "minLength": 1,
    "type": "string"
   },
   "messageIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "mailboxId"
  ],
  "type": "object"
 },
 "name": "assistantmail_delete_messages"
}
