 "description": "Listet die Bestellungen, die Agenten fuer das verbundene Kundenkonto angelegt haben (letzte sieben Tage, neueste zuerst), je mit einem frischen order_handle. Damit lassen sich auch aeltere Bestellungen aus anderen Gespraechen finden, ihr Stand abfragen (get_order_status) und offene oder reservierte stornieren (cancel_order). Bezahlen laesst sich nur eine Bestellung, die hoechstens zwei Stunden alt ist.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Vorgabe 10.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "open: nur offene und reservierte (stornierbar). Vorgabe: all.",
    "enum": [
     "open",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_orders",
 "outputSchema": {
  "properties": {
   "account": {
    "type": [
     "object",
     "null"
    ]
   },
   "orders": {
    "items": {
     "properties": {
      "cancellable": {
       "type": "boolean"
      },
      "created": {
       "type": "string"
      },
      "currency": {
       "type": "string"
      },
      "items": {
       "type": "string"
      },
      "mandate_id": {
       "type": [
        "integer",
        "null"
       ]
      },
      "mandate_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "mandate_state": {
       "enum": [
        "active",
        "revoked",
        "expired",
        "deleted",
        null
       ],
       "type": [
        "string",
        "null"
       ]
      },
      "order_handle": {
       "type": "string"
      },
      "order_number": {
       "type": "string"
      },
      "payable": {
       "type": "boolean"
      },
      "status": {
       "type": "string"
      },
      "total": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "orders"
  ],
  "type": "object"
 },
 "title": "Eigene Bestellungen auflisten"
}
