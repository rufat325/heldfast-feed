{
 "description": "Retrieve the public check-in feed near a geographic point (The Pub \u2014 Local)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "lat": {
    "description": "Latitude",
    "type": "number"
   },
   "limit": {
    "description": "Results per page (max 50, default 25 \u2014 the API may cap some feeds at 25)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "lng": {
    "description": "Longitude",
    "type": "number"
   },
   "max_id": {
    "description": "Return results older than this checkin ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "min_id": {
    "description": "Return only checkins newer than this ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "radius": {
    "description": "Radius in miles (default 25)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "lat",
   "lng"
  ],
  "type": "object"
 },
 "name": "get_local_feed"
}
