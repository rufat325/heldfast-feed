    "type": "boolean"
   },
   "files_enabled": {
    "description": "\u0414\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0444\u0430\u0439\u043b\u0456\u0432",
    "type": "boolean"
   },
   "has_access_to_team": {
