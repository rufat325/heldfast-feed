    "description": "Project ID (from list_projects)",
    "type": "string"
   },
   "can_create_calendars": {
    "type": "boolean"
   },
   "can_create_charts": {
    "type": "boolean"
   },
   "can_create_maps": {
    "type": "boolean"
   },
   "can_create_newsletters": {
    "type": "boolean"
   },
   "can_create_portals": {
    "type": "boolean"
   },
