   },
   "name": {
    "description": "\u041d\u0430\u0437\u0432\u0430 \u0433\u0440\u0443\u043f\u0438",
    "type": "string"
   },
   "tables_permissions": {
    "description": "\u041f\u0440\u0430\u0432\u0430 \u043d\u0430 \u0444\u043e\u0440\u043c\u0438/\u0437\u0432\u0456\u0442\u0438",
    "items": {
     "properties": {
      "hidden_fields": {
       "description": "\u041d\u0430\u0437\u0432\u0438 \u0430\u0431\u043e ID \u043f\u0440\u0438\u0445\u043e\u0432\u0430\u043d\u0438\u0445 \u043f\u043e\u043b\u0456\u0432",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "only_own_records": {
       "type": "boolean"
      },
      "role": {
       "description": "1=administrator: everything, as the owner; 2=read only; 3=read, write and DELETE records; 4=read, write and DELETE records, and build forms; 5=read and write records, NO delete; 6=read, edit and DELETE records; 7=read and edit records, NO delete. When the person asked that these people cannot delete, pass only a role that says NO delete (or read only), never one that says DELETE; and tell the person what the role lets them do in these words. \u00abAdmin\u00bb on the screen is role 1.",
       "type": "integer"
      },
