{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Add to cart"},"description":"Adds wine variants to an existing cart; quantities add up with lines already in the cart. Returns the updated cart and checkout_url. No order is placed and no payment is taken here; checkout_url opens the checkout on shop.nevini.wine. Use create_cart when there is no cart yet and update_cart to change or remove lines already in the cart.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"cart_id":{"description":"cart_id exactly as returned by create_cart, including its ?key= part.","maxLength":1024,"minLength":1,"type":"string"},"items":{"description":"Wines to add. Duplicate variant ids are merged; a cart holds at most 25 different variants.","items":{"additionalProperties":false,"properties":{"quantity":{"description":"Number of bottles, 1-24.","maximum":24,"minimum":1,"type":"integer"},"variant_id":{"description":"Shopify variant id from search_wines (default_variant_id) or get_wine (variants[].variant_id).","maxLength":80,"pattern":"^gid:\\/\\/shopify\\/ProductVariant\\/\\d+$","type":"string"}},"required":["variant_id","quantity"],"type":"object"},"maxItems":25,"minItems":1,"type":"array"},"language":{"description":"Language of item names and of the checkout: \"nl\" (default) or \"en\".","enum":["nl","en"],"type":"string"}},"required":["cart_id","items"],"type":"object"},"name":"add_to_cart","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"cart_id":{"type":"string"},"checkout_url":{"type":"string"},"currency":{"const":"EUR","type":"string"},"items":{"items":{"additionalProperties":{},"properties":{"line_id":{"type":"string"},"line_subtotal_eur":{"type":"number"},"name":{"type":"string"},"quantity":{"maximum":1000000,"minimum":0,"type":"integer"},"size":{"type":["string","null"]},"size_label":{"type":["string","null"]},"unit_price_eur":{"type":"number"},"url":{"type":["string","null"]},"variant_id":{"type":["string","null"]},"vintage":{"type":["string","null"]},"wine_id":{"anyOf":[{"maximum":1000000,"minimum":0,"type":"integer"},{"type":"null"}]}},"required":["line_id","variant_id","wine_id","name","vintage","size","size_label","quantity","unit_price_eur","line_subtotal_eur","url"],"type":"object"},"type":"array"},"next_step":{"type":"string"},"order_placed":{"const":false,"type":"boolean"},"shipping_note":{"type":"string"},"subtotal_eur":{"type":"number"},"total_quantity":{"maximum":1000000,"minimum":0,"type":"integer"},"warnings":{"items":{"additionalProperties":{},"properties":{"code":{"type":"string"},"message":{"type":"string"}},"required":["code","message"],"type":"object"},"type":"array"}},"required":["cart_id","order_placed","currency","items","total_quantity","subtotal_eur","checkout_url","next_step","shipping_note","warnings"],"type":"object"},"title":"Add to cart"}
