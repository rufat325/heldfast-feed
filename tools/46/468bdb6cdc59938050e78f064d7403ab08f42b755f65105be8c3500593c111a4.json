{"_meta":{"pack":"nl-wetten"},"annotations":{"cost":{"all":1},"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Search the Dutch official gazette (Staatsblad) by title words: laws, royal decrees, AMvBs and entry-into-force decrees (\"tijdstip van inwerkingtreding\"). All words must appear in the title. Returns Staatsblad identifier (e.g. stb-2023-235), year and number, title, type, ministry, publication date and official link. Pass year or type (e.g. \"Koninklijk Besluit\") to narrow. Use nl_staatsblad_get for the text.","inputSchema":{"examples":[{"query":"inwerkingtreding Wet homologatie onderhands akkoord"},{"limit":5,"query":"goed verhuurderschap","year":2023}],"properties":{"limit":{"description":"Max results, 1-50 (default 10).","type":"number"},"query":{"description":"Dutch title words, e.g. \"inwerkingtreding Wet homologatie onderhands akkoord\".","type":"string"},"type":{"description":"Publication type, e.g. \"Wet\", \"AMvB\", \"Koninklijk Besluit\", \"Klein Koninklijk Besluit\".","type":"string"},"year":{"description":"Only publications from this Staatsblad year, e.g. 2020.","type":"number"}},"required":["query"],"type":"object"},"name":"nl_staatsblad_search","outputSchema":{"additionalProperties":true,"properties":{"data_as_of":{"description":"Latest publication date among results","type":["string","null"]},"found":{"description":"Whether any publication matched","type":"boolean"},"has_more":{"description":"More matches exist than returned","type":"boolean"},"language":{"description":"nl","type":"string"},"query":{"description":"Query as run","type":"string"},"reason":{"description":"Why nothing was found","type":"string"},"results":{"items":{"additionalProperties":true,"properties":{"identifier":{"description":"Staatsblad identifier, e.g. stb-2023-235","type":"string"},"legal_basis":{"description":"Legal basis cited","type":"string"},"ministry":{"description":"Issuing ministry","type":"string"},"number":{"description":"Number within the year","type":"number"},"official_url":{"description":"Official link","type":"string"},"published_date":{"description":"Publication (issued) date, YYYY-MM-DD","type":["string","null"]},"title":{"description":"Official title (Dutch)","type":"string"},"type":{"description":"Publication type","type":"string"},"year":{"description":"Staatsblad year","type":"number"}},"type":"object"},"type":"array"},"returned":{"description":"Rows returned","type":"number"},"source":{"description":"Publisher and dataset","type":"string"},"total":{"description":"Total matches upstream","type":"number"}},"type":"object"},"title":"Nl Staatsblad Search","version":"v1.d67cc03c"}
