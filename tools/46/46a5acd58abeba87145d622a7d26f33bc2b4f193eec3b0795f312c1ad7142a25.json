{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read more answer, group or cited-page rows. List offsets must be multiples of 25; use the same query and group as the first page.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "brandSlug": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "group": {
    "anyOf": [
     {
      "enum": [
       "need",
       "question",
       "rival",
       "site",
       "reason",
       "engine"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "offset": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "pin": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "query": {
    "additionalProperties": false,
    "properties": {
     "brand": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "rule": {
        "enum": [
         "named",
         "not_named",
         "recommended",
         "named_not_recommended"
        ],
        "type": "string"
       }
      },
      "required": [
       "id",
       "rule"
      ],
      "type": "object"
     },
     "engine": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "insteadOf": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "market": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "need": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "question": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "reason": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "search": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "signal": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "site": {
      "type": "string"
     },
     "tone": {
      "enum": [
       "positive",
       "neutral",
       "hedged"
      ],
      "type": "string"
     },
     "v": {
      "const": 2,
      "type": "number"
     },
     "window": {
      "anyOf": [
       {
        "properties": {
         "preset": {
          "enum": [
           "week",
           "7d",
           "30d",
           "90d",
           "1y"
          ],
          "type": "string"
         }
        },
        "required": [
         "preset"
        ],
        "type": "object"
       },
       {
        "properties": {
         "end": {
          "format": "date",
          "type": "string"
         },
         "preset": {
          "const": "custom",
          "type": "string"
         },
         "start": {
          "format": "date",
          "type": "string"
         }
        },
        "required": [
         "preset",
         "start",
         "end"
        ],
        "type": "object"
       }
      ],
      "default": {
       "preset": "7d"
      }
     }
    },
    "required": [
     "v",
     "market"
    ],
    "type": "object"
   },
   "table": {
    "enum": [
     "list",
     "groups",
     "pages"
    ],
    "type": "string"
   }
  },
  "required": [
   "brandSlug",
   "pin",
   "table",
   "offset"
  ],
  "type": "object"
 },
 "name": "parse_dashboard_answer_rows",
 "outputSchema": {
  "properties": {
   "data": {},
   "dataAsOf": {
    "type": "string"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "parse:dashboard:read",
    "user:org:read"
   ],
   "type": "oauth2"
  }
 ]
}
