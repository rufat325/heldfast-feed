{
 "description": "Create a Grok Imagine task on RunAPI (extend video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "callback_url": {
    "description": "Webhook URL for terminal Task delivery.",
    "type": "string"
   },
   "extension_duration_seconds": {
    "anyOf": [
     {
      "const": 6,
      "type": "number"
     },
     {
      "const": 10,
      "type": "number"
     }
    ],
    "description": "Extension duration in seconds."
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "description": "Video continuation prompt.",
    "maxLength": 5000,
    "type": "string"
   },
   "source_task_id": {
    "description": "Completed prior Grok Imagine video Task ID.",
    "type": "string"
   },
   "start_seconds": {
    "description": "Source video position in seconds where extension begins.",
    "minimum": 0,
    "type": "number"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "source_task_id",
   "prompt",
   "start_seconds",
   "extension_duration_seconds"
  ],
  "type": "object"
 },
 "name": "extend_video"
}
