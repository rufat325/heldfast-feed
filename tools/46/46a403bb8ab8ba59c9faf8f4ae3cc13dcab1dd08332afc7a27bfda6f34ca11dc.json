{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "analysis:run",
     "portfolio:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Calculate historical return, volatility, drawdown, risk-adjusted and benchmark-relative statistics from a confirmed portfolio series profile. The metrics parameter describes all available calculations and their required inputs. Use daily, weekly or monthly complete periods; results include coverage, warnings and exact dataset/profile pins. Reuse an idempotency_key only for an identical calculation.",
 "inputSchema": {
  "$defs": {
   "ExactRateSeriesInput": {
    "additionalProperties": false,
    "properties": {
     "series_profile_id": {
      "format": "uuid",
      "title": "Series Profile Id",
      "type": "string"
     },
     "type": {
      "const": "series_profile",
      "title": "Type",
      "type": "string"
     }
    },
    "required": [
     "type",
     "series_profile_id"
    ],
    "title": "ExactRateSeriesInput",
    "type": "object"
   },
   "ScalarRateInput": {
    "additionalProperties": false,
    "properties": {
     "compounding": {
      "enum": [
       "simple",
       "annual",
       "continuous"
      ],
      "title": "Compounding",
      "type": "string"
     },
     "currency": {
      "maxLength": 3,
      "minLength": 3,
      "title": "Currency",
      "type": "string"
     },
     "provenance": {
      "additionalProperties": true,
      "title": "Provenance",
      "type": "object"
     },
     "quotation": {
      "const": "annualized",
      "default": "annualized",
      "title": "Quotation",
      "type": "string"
     },
     "tenor": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Tenor",
      "type": "string"
     },
     "type": {
      "const": "scalar",
      "title": "Type",
      "type": "string"
     },
     "value": {
      "title": "Value",
      "type": "string"
     },
     "value_date": {
      "format": "date",
      "title": "Value Date",
      "type": "string"
     }
    },
    "required": [
     "type",
     "value",
     "currency",
     "value_date",
     "tenor",
     "compounding",
     "provenance"
    ],
    "title": "ScalarRateInput",
    "type": "object"
   }
  },
  "properties": {
   "analysis_name": {
    "anyOf": [
     {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional private grouping name. The same case-sensitive name, after trimming outer whitespace, reuses one group for this user. Omit it for an independent operation. Keep the name on retries; each calculation still needs its own idempotency_key.",
    "title": "Analysis Name"
   },
   "benchmark_profile_id": {
    "anyOf": [
     {
      "format": "uuid",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Confirmed benchmark series profile in the same currency and return basis as the portfolio. Required for beta, alpha, correlation, tracking_error and information_ratio. Returns are matched by exact period dates.",
    "title": "Benchmark Profile Id"
   },
   "end_date": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "End Date"
   },
   "idempotency_key": {
    "maxLength": 255,
    "minLength": 1,
    "title": "Idempotency Key",
    "type": "string"
   },
   "metrics": {
    "description": "Select one or more unique metric names. periodic_returns: Return for each complete period at target_frequency. cumulative_return: Compounded return across the selected complete periods. observation_count: Number of source observations in the selected date range. period_count: Number of complete return periods available for calculation. min_return: Lowest periodic return and its period end date. max_return: Highest periodic return and its period end date. volatility: Sample standard deviation of periodic returns, with annualized volatility. drawdown: Decline from the running peak of compounded wealth for each period. max_drawdown: Largest peak-to-trough decline, with peak, trough and recovery dates when available. downside_deviation: Root mean square shortfall below minimum_acceptable_return, with annualized deviation. Requires minimum_acceptable_return. sharpe: Mean return above risk_free_rate divided by the sample standard deviation of excess returns, with annualized ratio. Requires risk_free_rate. sortino: Mean return above minimum_acceptable_return divided by downside deviation, with annualized ratio. Requires minimum_acceptable_return. beta: Sensitivity of portfolio returns to benchmark returns. Requires benchmark_profile_id. alpha: Return above the benchmark return implied by beta and risk_free_rate, with annualized alpha. Requires benchmark_profile_id and risk_free_rate. correlation: Pearson correlation between portfolio and benchmark returns. Requires benchmark_profile_id. tracking_error: Sample standard deviation of portfolio-minus-benchmark returns, with annualized tracking error. Requires benchmark_profile_id. information_ratio: Mean portfolio-minus-benchmark return divided by tracking error, with annualized ratio. Requires benchmark_profile_id.",
    "items": {
     "enum": [
      "periodic_returns",
      "cumulative_return",
      "observation_count",
      "period_count",
      "min_return",
      "max_return",
      "volatility",
      "drawdown",
      "max_drawdown",
      "downside_deviation",
      "sharpe",
      "sortino",
      "beta",
      "alpha",
      "correlation",
      "tracking_error",
      "information_ratio"
     ],
     "type": "string"
    },
    "maxItems": 17,
    "minItems": 1,
    "title": "Metrics",
    "type": "array"
   },
   "minimum_acceptable_return": {
    "anyOf": [
     {
      "$ref": "#/$defs/ExactRateSeriesInput"
     },
     {
      "$ref": "#/$defs/ScalarRateInput"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Required for downside_deviation and sortino. Use a confirmed minimum acceptable return profile or a source-backed dated annualized scalar with currency, tenor, compounding and provenance.",
    "title": "Minimum Acceptable Return"
   },
   "risk_free_rate": {
    "anyOf": [
     {
      "$ref": "#/$defs/ExactRateSeriesInput"
     },
     {
      "$ref": "#/$defs/ScalarRateInput"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Required for sharpe and alpha. Use a confirmed risk-free rate profile or a source-backed dated annualized scalar with currency, tenor, compounding and provenance. Do not substitute an assumed rate.",
    "title": "Risk Free Rate"
   },
   "series_profile_id": {
    "description": "Confirmed portfolio series profile returned by upload or list_portfolio_series; pins one immutable dataset version.",
    "format": "uuid",
    "title": "Series Profile Id",
    "type": "string"
   },
   "start_date": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Start Date"
   },
   "target_frequency": {
    "description": "Calculate complete daily, weekly or monthly return periods. Annualization uses 252, 52 or 12 periods per year respectively; finer-frequency data must be available.",
    "enum": [
     "daily",
     "weekly",
     "monthly"
    ],
    "title": "Target Frequency",
    "type": "string"
   }
  },
  "required": [
   "series_profile_id",
   "metrics",
   "target_frequency",
   "idempotency_key"
  ],
  "title": "calculate_portfolio_statisticsArguments",
  "type": "object"
 },
