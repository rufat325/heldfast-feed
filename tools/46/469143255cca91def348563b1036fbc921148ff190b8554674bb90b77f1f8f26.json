{
 "description": "Search Car Jaune (R\u00e9union interurban bus network) GTFS stops by name or code.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 50,
    "maximum": 500,
    "minimum": 1,
