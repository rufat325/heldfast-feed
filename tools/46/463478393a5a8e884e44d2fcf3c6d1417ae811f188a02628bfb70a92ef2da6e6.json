{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "List or enable agent payment methods (action=list|enable) with friendly labels. Defaults: cod + x402. invoice (B2B) is coming_soon. bank_card is handoff-only.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "list = enumerate rails; enable = turn on one rail",
    "enum": [
     "list",
     "enable"
    ],
    "type": "string"
   },
   "agent_id": {
    "description": "Agent id whose methods to list or enable",
    "type": "string"
   },
   "rail": {
    "description": "Rail key required when action=enable, e.g. x402 (not bank_card vault)",
    "type": "string"
   },
   "session_token": {
    "description": "Session token from agent_authenticate \u2014 required whenever agent_id is passed",
    "type": "string"
   }
  },
  "required": [
   "agent_id",
   "action"
  ],
  "type": "object"
 },
 "name": "payment_methods",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "approval_url": {
    "type": "string"
   },
   "detail": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "hint": {
    "type": "string"
   },
   "label": {
    "type": "string"
   },
   "methods": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "next": {
    "additionalProperties": false,
    "properties": {
     "args": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        }
       ]
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "tool": {
      "type": "string"
     }
    },
    "required": [
     "tool"
    ],
    "type": "object"
   },
   "rail_key": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Payment methods"
}
