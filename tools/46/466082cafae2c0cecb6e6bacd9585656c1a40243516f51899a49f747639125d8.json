{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update the description of a container image in a registry",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Short image description (max 100 characters)",
    "type": "string"
   },
   "fullDescription": {
    "description": "Detailed image description (Markdown supported)",
    "type": "string"
   },
   "imageName": {
    "description": "Name of the image to update",
    "type": "string"
   },
   "registryName": {
    "description": "Name of the registry",
    "type": "string"
   }
  },
  "required": [
   "registryName",
   "imageName"
  ],
  "type": "object"
 },
 "name": "ncloud_ncr_update_image"
}
