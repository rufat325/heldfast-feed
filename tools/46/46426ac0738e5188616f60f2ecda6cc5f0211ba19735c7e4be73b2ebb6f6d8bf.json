{
 "description": "Publish or unpublish one or more products quickly (without a full update).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "is_published": {
    "description": "true = publish (visible), false = hide",
    "type": "boolean"
   },
   "product_ids": {
    "description": "Product ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "product_ids",
   "is_published"
  ],
  "type": "object"
 },
 "name": "set_product_published"
}
