   },
   "query": {
    "description": "Short keywords in any language, e.g. \"linen dress\", \"\uc6d0\ud53c\uc2a4\", \"\u9488\u7ec7\u5f00\u886b\". Keywords only, not a whole message.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
