{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "project_todos:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Feedback thread summaries with visible-comment counts for one assignment (keyset page; response view:\"threads\"; comment bodies ride opentrain_quiz_coaching_comments). Worker names are masked; answer keys, expected answers, and worker personal data NEVER appear. Requires project_todos:read, a claimed account, and the default-off project-todos agent surface. Keyless read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "assignmentId"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_coaching_threads",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "assignmentId": {
      "type": "string"
     },
     "nextCursor": {
      "type": [
       "string",
       "null"
      ]
     },
     "threads": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "commentCount": {
         "type": "integer"
        },
        "id": {
         "type": "string"
        },
        "lastActivityAt": {
         "type": "string"
        },
        "questionId": {
         "type": "string"
        },
        "resolvedAt": {
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "enum": [
          "OPEN",
          "RESOLVED"
         ],
         "type": "string"
        },
        "workerVisibleCommentCount": {
         "type": "integer"
        }
       },
       "required": [
        "id",
        "questionId",
        "status",
        "lastActivityAt",
        "resolvedAt",
        "commentCount",
        "workerVisibleCommentCount"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "view": {
      "const": "threads",
      "type": "string"
     }
    },
    "required": [
     "view",
     "assignmentId",
     "threads",
     "nextCursor"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
