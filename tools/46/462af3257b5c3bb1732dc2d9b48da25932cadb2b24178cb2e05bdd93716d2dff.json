{"_meta":{"securitySchemes":[{"type":"noauth"},{"scopes":["catalog:read"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"Find similar products with stable continuation across catalog and supplier sources. Use nextCursor with the same item and market for subsequent pages. A short page is not exhaustion when continuation is present. If status is pending or supplierExpansion is queued, running, or throttled, retry at retryAfter or supplierRetryAt. If supplierExpansion is failed, stop retrying that supplier search and report its failure classification. Supplier previews must be hydrated with catalog_get_product before choosing a configuration or adding to cart. Present only buyer-market offer prices, never supplier costs.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"countryCode":{"description":"ISO 3166-1 alpha-2 country code","pattern":"^[A-Z]{2}$","type":"string"},"cursor":{"maxLength":512,"minLength":1,"type":"string"},"expandSuppliers":{"default":true,"type":"boolean"},"itemId":{"maxLength":160,"minLength":1,"type":"string"},"languageCode":{"description":"Lowercase two-letter language code","pattern":"^[a-z]{2}$","type":"string"},"limit":{"default":12,"maximum":24,"minimum":1,"type":"integer"},"offset":{"default":0,"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["countryCode","languageCode","itemId"],"type":"object"},"name":"catalog_get_similar_products","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"items":{"items":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"type":"array"},"nextCursor":{"type":"string"},"nextOffset":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"retryAfter":{"format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\