{
 "description": "Create a new Task in Salesforce. Link it to a Lead or Contact via whoId, and optionally to a Campaign or Opportunity via whatId. Set subject, status (e.g. 'Not Started', 'Completed'), priority, due date, and description. Returns the new Task ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": "string"
   },
   "dueDate": {
    "description": "ISO date string YYYY-MM-DD",
    "type": "string"
   },
   "priority": {
    "default": "Normal",
    "type": "string"
   },
   "status": {
    "default": "Not Started",
    "type": "string"
   },
   "subject": {
    "type": "string"
   },
   "whatId": {
    "description": "Campaign, Opportunity, or Account ID",
    "type": "string"
   },
   "whoId": {
    "description": "Lead or Contact ID",
    "type": "string"
   }
  },
  "required": [
   "subject"
  ],
  "type": "object"
 },
 "name": "sf_create_task"
}
