{
 "description": "Send a countertop quote request to the ATX Granite King crew. Only call this when the user explicitly asks to be contacted and has given their own phone or email.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "city": {
    "maxLength": 60,
    "type": "string"
   },
   "details": {
    "maxLength": 800,
    "type": "string"
   },
   "email": {
    "format": "email",
    "maxLength": 120,
    "type": "string"
   },
   "name": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "phone": {
    "maxLength": 30,
    "type": "string"
   },
   "sqft": {
    "exclusiveMinimum": 0,
    "maximum": 20000,
    "type": "number"
   },
   "stone": {
    "maxLength": 120,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "request_quote",
 "title": "Request a quote"
}
