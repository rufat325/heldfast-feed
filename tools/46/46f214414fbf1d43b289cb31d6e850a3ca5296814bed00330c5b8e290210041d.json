{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":true,"title":"Search Kirah businesses"},"description":"Searches Kirah's eligible public business directory by service need or exact Kirah Agent Address, with optional coarse location, price and demo-mode filters. Demo results are explicitly labeled. Follow coverage flags: absence is not proof no provider exists. Source-observed record_kind:observed_listing and optional observed_matches are unclaimed, not merchant verified, availability unknown and not Kirah-bookable; open listing_url for dated facts and preserve price/duration unknowns.","inputSchema":{"additionalProperties":false,"anyOf":[{"required":["query"]},{"required":["agent_address"]}],"properties":{"agent_address":{"description":"Exact public locator `<handle>@kirah.ai`; case-insensitive ASCII only. A locator, never authentication or owner authority. Reserved, malformed, unlisted, disabled, non-bookable, and tenant_mode-ineligible addresses do not resolve. Exact mode never fuzzy-matches a near miss.","maxLength":253,"pattern":"^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?@[Kk][Ii][Rr][Aa][Hh]\\.[Aa][Ii]$","type":"string"},"city":{"description":"Coarse place alias for location, such as Dublin, OH. Conflicting city and location are rejected.","maxLength":120,"type":"string"},"cursor":{"description":"Opaque next_cursor value from a previous search_businesses response with the SAME query/filters: resumes after that tenant in the stable ordering. A cursor that does not decode, or that names a tenant not present in the current ordering, is invalid_cursor.","maxLength":300,"type":"string"},"include_demo":{"description":"Back-compat alias: true is equivalent to tenant_mode 'include_demos' and false to 'real_only'. When omitted, tenant_mode defaults to include_demos. Every demo result carries demo:true and a demo_notice. Supplying both include_demo and tenant_mode with disagreeing demo-inclusion is invalid_tenant_mode.","type":"boolean"},"limit":{"default":5,"maximum":10,"minimum":1,"type":"integer"},"location":{"description":"Optional place text ('City, ST', ZIP, bare city/state) OR explicit coordinates 'lat,lng'. With resolvable coordinates, radius_miles applies as real distance; otherwise matching is city/ZIP/metro-market text equality.","maxLength":120,"type":"string"},"max_price_cents":{"description":"Only services with a parseable price at or under this amount are returned; unpriced services are excluded when this is set.","maximum":10000000,"minimum":0,"type":"integer"},"query":{"description":"The consumer's need in plain words (e.g. 'lower back tightness', 'prenatal massage'). Matched deterministically against real service catalogs, expanded by the discovery ontology.","maxLength":200,"minLength":1,"type":"string"},"radius_miles":{"description":"Radius in miles (default 25) \u2014 OPERATIVE when the location resolves to coordinates (2.6); otherwise answered with a truthful distance_note instead of a fabricated distance.","maximum":500,"minimum":1,"type":"integer"},"tenant_mode":{"default":"include_demos","description":"The authoritative eligibility filter for demo tenants. include_demos (default) returns real and demo businesses together; every demo is flagged demo:true and carries a clear notice. real_only excludes every demo business; demos_only returns ONLY demo businesses. A discovery-disabled, inactive, or otherwise ineligible tenant never appears in any mode \u2014 not even when its catalog uniquely matches the query.","enum":["real_only","include_demos","demos_only"],"type":"string"}},"type":"object"},"name":"search_businesses","outputSchema":{"anyOf":[{"additionalProperties":false,"properties":{"businesses":{"items":{"anyOf":[{"additionalProperties":false,"properties":{"agent_address":{"type":"string"},"agent_bookable":{"type":"boolean"},"agent_discoverable":{"type":"boolean"},"authority_mode":{"enum":["instant","approval_required",null],"type":["string","null"]},"demo":{"type":"boolea