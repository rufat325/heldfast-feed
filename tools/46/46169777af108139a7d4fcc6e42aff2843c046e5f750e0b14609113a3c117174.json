{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "TDEE & calorie calculator"
 },
 "description": "Estimate daily calories (TDEE) and BMR using the Mifflin-St Jeor equation. BMR = 10 x kg + 6.25 x cm - 5 x age + (5 for male, -161 for female). TDEE = BMR x activity factor (sedentary 1.2, light 1.375, moderate 1.55, active 1.725, very_active 1.9). Use units 'metric' (heightCm, weightKg) or 'imperial' (heightInches, weightPounds). Also returns mild-loss (-250), loss (-500) and gain (+500) calorie goals. Source: https://hopi.co.uk/tdee-calculator/",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "units": {
       "const": "metric"
      }
     }
    },
    "then": {
     "required": [
      "heightCm",
      "weightKg"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "units": {
       "const": "imperial"
      }
     }
    },
    "then": {
     "required": [
      "heightInches",
      "weightPounds"
     ]
    }
   }
  ],
  "properties": {
   "activity": {
    "default": "moderate",
    "description": "Activity level, default 'moderate'",
    "enum": [
     "sedentary",
     "light",
     "moderate",
     "active",
     "very_active"
    ],
    "type": "string"
   },
   "age": {
    "description": "Age in years",
    "exclusiveMinimum": 0,
    "maximum": 120,
    "type": "number"
   },
   "heightCm": {
    "description": "Height in centimetres (metric)",
    "maximum": 260,
    "minimum": 50,
    "type": "number"
   },
   "heightInches": {
    "description": "Total height in inches (imperial)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "sex": {
    "description": "Biological sex",
    "enum": [
     "male",
     "female"
    ],
    "type": "string"
   },
   "units": {
    "description": "'metric' (cm, kg) or 'imperial' (inches, pounds)",
    "enum": [
     "metric",
     "imperial"
    ],
    "type": "string"
   },
   "weightKg": {
    "description": "Weight in kilograms (metric)",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "number"
   },
   "weightPounds": {
    "description": "Weight in pounds (imperial)",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "sex",
   "age",
   "units"
  ],
  "type": "object"
 },
 "name": "hopi_tdee_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "activity": {
    "type": "string"
   },
   "activityFactor": {
    "type": "number"
   },
   "age": {
    "type": "number"
   },
   "bmr": {
    "type": "number"
   },
   "gain": {
    "type": "number"
   },
   "loss": {
    "type": "number"
   },
   "mildLoss": {
    "type": "number"
   },
   "sex": {
    "type": "string"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "tdee": {
    "type": "number"
   }
  },
  "required": [
   "activity",
   "activityFactor",
   "age",
   "bmr",
   "gain",
   "loss",
   "mildLoss",
   "sex",
   "source_url",
   "summary",
   "tdee"
  ],
  "type": "object"
 },
 "title": "TDEE & calorie calculator"
}
