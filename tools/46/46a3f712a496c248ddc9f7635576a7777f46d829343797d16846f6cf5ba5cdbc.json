{
 "description": "Estimate gas cost for a transaction on Base. Provide a to address and optional data/value to get precise gas estimates in ETH and USD-equivalent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "default": "0x",
    "description": "Transaction calldata (hex string)",
    "type": "string"
   },
   "to": {
    "description": "Destination address",
    "type": "string"
   },
   "value": {
    "default": "0",
    "description": "ETH value to send (e.g. '0.001')",
    "type": "string"
   }
  },
  "required": [
   "to"
  ],
  "type": "object"
 },
 "name": "get_gas_estimate"
}
