{
 "annotations": {
  "idempotentHint": true
 },
 "description": "Bulk update snapshot content for multiple resources. Each entry requires resourceId and snapshot content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "snapshots": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "resourceId": {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "snapshot": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "resourceId",
      "snapshot"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "snapshots"
  ],
  "type": "object"
 },
 "name": "update_resource_snapshots",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "updated": {
    "description": "Number of snapshots updated",
    "type": "number"
   }
  },
  "required": [
   "updated"
  ],
  "type": "object"
 },
 "title": "Update Resource Snapshots"
}
