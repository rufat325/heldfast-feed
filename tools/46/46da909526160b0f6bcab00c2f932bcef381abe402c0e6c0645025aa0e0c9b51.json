{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Backtest one built-in strategy with one set of parameters. Fills happen at the next bar's open and costs are charged per side. Returns risk-adjusted metrics alongside the raw return \u2014 judge on those, not on total return.",
 "inputSchema": {
  "properties": {
   "direction": {
    "enum": [
     "both",
     "long",
     "short"
    ],
    "type": "string"
   },
   "exchange": {
    "enum": [
     "binance",
     "bybit",
     "okx",
     "hyperliquid"
    ],
    "type": "string"
   },
   "feeBps": {
    "description": "Per side. Default 4.",
    "type": "number"
   },
   "market": {
    "description": "Default: the chart.",
    "enum": [
     "spot",
     "futures"
    ],
    "type": "string"
   },
   "maxBarsHeld": {
    "description": "Optional time stop in bars.",
    "type": "number"
   },
   "params": {
    "type": "object"
   },
   "ref": {
    "description": "Reuse a handle from market_candles instead of loading.",
    "type": "string"
   },
   "slippageBps": {
    "description": "Default 1.",
    "type": "number"
   },
   "stopLossPercent": {
    "description": "Optional protective stop percentage.",
    "type": "number"
   },
   "strategyId": {
    "type": "string"
   },
   "symbol": {
    "description": "Default: the chart.",
    "type": "string"
   },
   "takeProfitPercent": {
    "description": "Optional profit target percentage.",
    "type": "number"
   },
   "timeframe": {
    "description": "e.g. 1h, 4h. Default: the chart.",
    "type": "string"
   }
  },
  "required": [
   "strategyId"
  ],
  "type": "object"
 },
 "name": "backtest_run"
}
