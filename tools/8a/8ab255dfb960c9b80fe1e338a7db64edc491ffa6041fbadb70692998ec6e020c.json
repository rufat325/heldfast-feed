{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List recent market events (8-K filings, volume spikes, 3%+ day moves, 2%+ opening gaps) for tracked tickers. Informational only, not financial advice.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "days": {
    "default": 7,
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "ticker": {
    "description": "Ticker, e.g. NVDA",
    "type": "string"
   },
   "type": {
    "description": "Event type name; see event_types",
    "enum": [
     "market.8k_filed",
     "market.volume_spike",
     "market.day_move",
     "market.gap_at_open"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "recent_events",
 "securitySchemes": [
  {
   "scopes": [
    "market:read"
   ],
   "type": "oauth2"
  }
 ]
}
