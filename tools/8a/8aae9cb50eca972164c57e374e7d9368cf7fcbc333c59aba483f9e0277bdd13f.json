{
 "description": "Launch a new isolated cloud sandbox (capsule) and (by default) wait until it is ready. Returns the capsule id and connection info. Use the returned sessionId for exec/files/etc.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bundle": {
    "description": "Software bundle (Bucket B) id to launch from",
    "type": "string"
   },
   "env": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Environment variables to inject",
    "type": "object"
   },
   "region": {
    "description": "Region hint; omit for automatic placement",
    "type": "string"
   },
   "size": {
    "description": "Resource size, e.g. '2c4g' (default)",
    "type": "string"
   },
   "snapshot": {
    "description": "Snapshot/template id to restore from",
    "type": "string"
   },
   "template": {
    "description": "Template / OS / bundle id, e.g. 'ubuntu-22.04-headless'",
    "type": "string"
   },
   "wait": {
    "description": "Wait until ACTIVE (default true)",
    "type": "boolean"
   }
  },
  "required": [
   "template"
  ],
  "type": "object"
 },
 "name": "capsulate_launch",
 "title": "Launch a capsule"
}
