{
 "description": "Planning ocean-freight estimate from a Japan load port to a destination. Uses Freightos public LCL as a live container index, Brent crude for bunker, and Joint War Committee listed areas. Not a booking quote. Iran and Russia are refused.",
 "inputSchema": {
  "properties": {
   "countryCode": {
    "description": "ISO country code, e.g. AU",
    "type": "string"
   },
   "mode": {
    "enum": [
     "roro",
     "container",
     "either"
    ],
    "type": "string"
   },
   "origin": {
    "enum": [
     "yokohama",
     "nagoya",
     "osaka",
     "kobe"
    ],
    "type": "string"
   },
   "port": {
    "type": "string"
   },
   "vehicleClass": {
    "enum": [
     "suv",
     "pickup",
     "van",
     "light_truck",
     "medium_truck",
     "heavy_truck"
    ],
    "type": "string"
   }
  },
  "required": [
   "countryCode"
  ],
  "type": "object"
 },
 "name": "estimate_shipping"
}
