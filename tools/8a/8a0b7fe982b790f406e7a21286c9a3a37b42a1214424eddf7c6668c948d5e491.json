{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create project time entry"
 },
 "description": "Create a new project time entry. Requires project_time_entries:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "Description",
    "type": "string"
   },
   "duration_minutes": {
    "description": "Whole minutes worked. Send this or start_time and end_time; if you send both, they must agree.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "end_time": {
    "description": "End time (ISO 8601 datetime)",
    "type": "string"
   },
   "is_billable": {
    "description": "Whether the time is billable",
    "type": "boolean"
   },
   "project_id": {
    "description": "Project ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "start_time": {
    "description": "Start time (ISO 8601 datetime, required)",
    "type": "string"
   },
   "task_id": {
    "description": "Task ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "user_id": {
    "description": "User ID (required) - an active member of the organization (see list_users)",
    "minLength": 1,
    "type": "string"
   },
   "user_name": {
    "description": "Display name of the user",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "task_id",
   "user_id",
   "start_time"
  ],
  "type": "object"
 },
 "name": "create_project_time_entry",
 "title": "Create project time entry"
}
