{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search"
 },
 "description": "Search across all Keepsake data \u2014 contacts, entries, tasks, notes, and companies. Search is accent-insensitive (e.g., 'berenice' finds 'B\u00e9r\u00e9nice').",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results per type (default 10)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "q": {
    "description": "Search query",
    "type": "string"
   },
   "type": {
    "description": "Limit search to a specific entity type (default: all)",
    "enum": [
     "all",
     "contacts",
     "entries",
     "tasks",
     "notes",
     "companies"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search"
}
