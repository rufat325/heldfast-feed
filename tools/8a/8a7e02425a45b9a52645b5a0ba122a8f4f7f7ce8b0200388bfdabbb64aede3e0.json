          "environmentId": {
           "description": "Identifier of the Environment.",
           "format": "uuid",
           "type": "string"
          }
         },
         "required": [
          "environmentId",
          "environmentAccessType"
         ],
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "description": "List of environment specific permissions."
