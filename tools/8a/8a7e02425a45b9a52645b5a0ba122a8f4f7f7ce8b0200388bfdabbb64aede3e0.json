            "cannotApprove",
            "canApproveOthers",
            "canBypassApproval"
           ],
           "type": "string"
          },
          "environmentId": {
           "description": "Identifier of the Environment.",
           "format": "uuid",
           "type": "string"
          }
         },
         "required": [
          "environmentId",
          "environmentApprovalPermissionType"
         ],
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "description": "List of environment specific change request approval permissions."
