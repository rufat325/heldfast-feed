{
 "description": "List installed packages in a project",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "all": {
    "description": "Show all packages, not just top-level",
    "type": "boolean"
   },
   "depth": {
    "description": "Dependency tree depth (default: 0)",
    "type": "number"
   },
   "global": {
    "description": "List global packages",
    "type": "boolean"
   },
   "package": {
    "description": "Specific package to look for",
    "type": "string"
   },
   "path": {
    "description": "Absolute path to the package directory",
    "type": "string"
   },
   "production": {
    "description": "Only show production dependencies",
    "type": "boolean"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "ls"
}
