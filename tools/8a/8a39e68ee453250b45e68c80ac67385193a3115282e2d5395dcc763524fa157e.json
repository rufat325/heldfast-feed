    "type": "string"
   },
   "sub1": {
    "description": "Filter by sub1",
    "type": "string"
   },
   "sub2": {
    "description": "Filter by sub2",
    "type": "string"
   },
   "sub3": {
    "description": "Filter by sub3",
    "type": "string"
   },
   "sub4": {
    "description": "Filter by sub4",
    "type": "string"
   },
   "sub5": {
    "description": "Filter by sub5",
    "type": "string"
   },
   "time_interval": {
    "description": "Custom time interval",
    "type": "string"
   },
   "timezone": {
    "description": "Custom timezone",
    "type": "string"
   },
   "tracks_view": {
    "description": "Use cached costs for faster report generation",
    "type": "string"
   }
