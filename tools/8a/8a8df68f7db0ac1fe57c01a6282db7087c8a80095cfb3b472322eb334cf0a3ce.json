{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Create and edit mind maps from an outline or a project file. Export PNG, SVG and PDF, save locally and share a link. No account required.",
 "inputSchema": {
  "additionalProperties": false,
  "oneOf": [
   {
    "required": [
     "outline"
    ]
   },
   {
    "required": [
     "project"
    ]
   }
  ],
  "properties": {
   "outline": {
    "description": "First line is the root; indent following topics by two spaces per level.",
    "maxLength": 24000,
    "minLength": 1,
    "type": "string"
   },
   "project": {
    "additionalProperties": false,
    "properties": {
     "nodes": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "collapsed": {
         "type": "boolean"
        },
        "id": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "label": {
         "maxLength": 160,
         "minLength": 1,
         "type": "string"
        },
        "parentId": {
         "maxLength": 100,
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "parentId",
        "label"
       ],
       "type": "object"
      },
      "maxItems": 200,
      "minItems": 1,
      "type": "array"
     },
     "title": {
      "maxLength": 120,
      "type": "string"
     },
     "version": {
      "const": 1,
      "type": "integer"
     }
    },
    "required": [
     "title",
     "nodes"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "mindmaps",
 "title": "Mind Maps Generator"
}
