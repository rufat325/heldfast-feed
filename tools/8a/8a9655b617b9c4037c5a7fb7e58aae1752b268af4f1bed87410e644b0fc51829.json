{
 "_meta": {
  "openai/outputTemplate": "ui://soclo/chat-ads/v2.html",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "plan:create"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://soclo/chat-ads/v2.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read app plan preparation status"
 },
 "description": "Reads the original preparation identity only (projectId, revision and clientRequestId of an earlier soclo_video_prepare call). Free; never prepares, films or charges. Needs plan:create.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "clientRequestId": {
    "description": "Required: the original UUID clientRequestId of the preparation.",
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   },
   "projectId": {
    "description": "Required: the original saved projectId.",
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   },
   "revision": {
    "description": "Required: the original saved revision.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "projectId",
   "revision",
   "clientRequestId"
  ],
  "type": "object"
 },
 "name": "soclo_video_preparation_status",
 "title": "Read app plan preparation status"
}
