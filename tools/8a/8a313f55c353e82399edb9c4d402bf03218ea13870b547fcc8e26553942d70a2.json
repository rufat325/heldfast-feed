{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Create a shipment (get rates)"
 },
 "description": "Create a shipment from a to_address, from_address, and parcel, returning the available RATES from all enabled carriers. This only RATES the shipment \u2014 it does NOT purchase a label and does NOT charge the account; buying is a separate step (easypost_buy_shipment). API: POST /shipments (body { shipment }).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "carrier_accounts": {
    "description": "Restrict rating to these carrier_account ids.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "from_address": {
    "description": "Origin/return address.",
    "properties": {
     "city": {
      "type": "string"
     },
     "company": {
      "type": "string"
     },
     "country": {
      "description": "2-letter ISO country code, default US",
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "state": {
      "description": "2-letter state/province code",
      "type": "string"
     },
     "street1": {
      "description": "Street address line 1",
      "type": "string"
     },
     "street2": {
      "type": "string"
     },
     "zip": {
      "description": "Postal/ZIP code",
      "type": "string"
     }
    },
    "required": [
     "street1",
     "zip"
    ],
    "type": "object"
   },
   "parcel": {
    "description": "Package dimensions and weight.",
    "properties": {
     "height": {
      "description": "inches",
      "type": "number"
     },
     "length": {
      "description": "inches",
      "type": "number"
     },
     "predefined_package": {
      "description": "carrier predefined package name, e.g. FlatRateEnvelope",
      "type": "string"
     },
     "weight": {
      "description": "weight in OUNCES (required)",
      "type": "number"
     },
     "width": {
      "description": "inches",
      "type": "number"
     }
    },
    "required": [
     "weight"
    ],
    "type": "object"
   },
   "reference": {
    "description": "Your internal reference string for the shipment.",
    "type": "string"
   },
   "to_address": {
    "description": "Destination address.",
    "properties": {
     "city": {
      "type": "string"
     },
     "company": {
      "type": "string"
     },
     "country": {
      "description": "2-letter ISO country code, default US",
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "state": {
      "description": "2-letter state/province code",
      "type": "string"
     },
     "street1": {
      "description": "Street address line 1",
      "type": "string"
     },
     "street2": {
      "type": "string"
     },
     "zip": {
      "description": "Postal/ZIP code",
      "type": "string"
     }
    },
    "required": [
     "street1",
     "zip"
    ],
    "type": "object"
   }
  },
  "required": [
   "to_address",
   "from_address",
   "parcel"
  ],
  "type": "object"
 },
 "name": "easypost_create_shipment",
 "title": "Create a shipment (get rates)"
}
