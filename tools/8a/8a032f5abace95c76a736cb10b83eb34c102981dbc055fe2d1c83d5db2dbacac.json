{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Sets the category for a list of cookies on one of your CookiePal domains, and reports the result for each one. Send the category from @cookiepal-oss/cookie-db (necessary, functional, analytics, performance, advertisement or other).","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"cookies":{"items":{"additionalProperties":false,"properties":{"category":{"enum":["necessary","functional","analytics","performance","advertisement","other"],"type":"string"},"description":{"maxLength":512,"pattern":"^[^\\x00-\\x1F\\x7F-\\x9F\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u2069\\uFEFF\\uDB40]*$","type":"string"},"domain":{"maxLength":253,"minLength":1,"pattern":"^\\.?[A-Za-z0-9_.:\\x5B\\x5D\\x2D]+$","type":"string"},"name":{"maxLength":128,"pattern":"^[\\x21-\\x3A\\x3C\\x3E-\\x7E]*$","type":"string"}},"required":["name","domain","category"],"type":"object"},"maxItems":50,"minItems":1,"type":"array"},"domainId":{"description":"Which domain these cookies belong to. Omit it for the account\u2019s default domain.","maxLength":2048,"minLength":1,"type":"string"}},"required":["cookies"],"type":"object"},"name":"classify_cookies","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"domainId":{"type":"string"},"results":{"items":{"additionalProperties":false,"properties":{"domain":{"type":"string"},"name":{"type":"string"},"reason":{"type":"string"},"status":{"enum":["updated","failed"],"type":"string"}},"required":["name","domain","status"],"type":"object"},"type":"array"}},"required":["domainId","results"],"type":"object"},"title":"Classify cookies"}
