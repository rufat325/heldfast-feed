{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Send the started request to the clinic. It takes the 6-digit code Xona emailed the patient and the consent_version of the consent_text the patient agreed to. The outcome is a delivered, held or failed request, never a confirmed booking. Calling again with the same action_id returns the same outcome.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action_id": {
    "maxLength": 128,
    "minLength": 16,
    "type": "string"
   },
   "consent_version": {
    "enum": [
     "gateway-2026-09-11"
    ],
    "type": "string"
   },
   "note": {
    "maxLength": 500,
    "type": "string"
   },
   "preferred_window": {
    "description": "When the patient is free, in their words",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "service_category": {
    "enum": [
     "checkup_cleaning",
     "children",
     "cosmetic",
     "implants",
     "new_patient",
     "orthodontics",
     "other",
     "tooth_pain"
    ],
    "type": "string"
   },
   "verification_code": {
    "pattern": "^[0-9]{6}$",
    "type": "string"
   }
  },
  "required": [
   "action_id",
   "verification_code",
   "service_category",
   "preferred_window",
   "consent_version"
  ],
  "type": "object"
 },
 "name": "confirm_dental_request",
 "outputSchema": {
  "properties": {
   "action": {
    "type": "object"
   },
   "next_step": {
    "type": "string"
   },
   "outcome": {
    "type": "string"
   },
   "receipt_url": {
    "type": "string"
   }
  },
  "required": [
   "action",
   "outcome",
   "next_step"
  ],
  "type": "object"
 },
 "title": "Send a dental appointment request"
}
