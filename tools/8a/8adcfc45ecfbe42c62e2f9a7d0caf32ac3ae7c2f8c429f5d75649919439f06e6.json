{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store a file for an app (create or overwrite by path). `data_base64` carries the file bytes, base64-encoded. Overwriting an existing path bumps its version. Single-call writes are limited to a few MiB. Files persist and are the app's own, reusable across chats.",
 "inputSchema": {
  "properties": {
   "app": {
    "description": "the app this file belongs to",
    "type": "string"
   },
   "command_id": {
    "description": "idempotency key \u2014 a fresh uuid per write",
    "type": "string"
   },
   "data_base64": {
    "description": "file bytes, base64-encoded",
    "type": "string"
   },
   "expected_version": {
    "description": "the version you last saw, for optimistic concurrency (optional)",
    "type": "number"
   },
   "mime": {
    "description": "content type, e.g. 'image/png' (default application/octet-stream)",
    "type": "string"
   },
   "path": {
    "description": "logical file name, e.g. 'receipt.pdf' or 'exports/2026-q1.csv'",
    "type": "string"
   }
  },
  "required": [
   "command_id",
   "app",
   "path",
   "data_base64"
  ],
  "type": "object"
 },
 "name": "file_write",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "app": {
    "type": "string"
   },
   "files_version": {
    "type": "number"
   },
   "mime": {
    "type": "string"
   },
   "path": {
    "type": "string"
   },
   "sha256": {
    "type": "string"
   },
   "size": {
    "type": "number"
   },
   "version": {
    "type": "number"
   }
  },
  "required": [
   "app",
   "path",
   "size",
   "mime",
   "sha256",
   "version",
   "files_version"
  ],
  "type": "object"
 },
 "title": "Store an app file"
}
