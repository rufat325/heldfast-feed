{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "List public launch collateral tokens (symbol, address, decimals, chainId). chainId is optional only when exactly one chain is active.",
 "inputSchema": {
  "properties": {
   "chainId": {
    "description": "Optional only when exactly one chain is active; required when multiple chains are active.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "problee_list_collateral",
 "outputSchema": {
  "$defs": {
   "DiscoverCollateralResponse": {
    "additionalProperties": false,
    "properties": {
     "tokens": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "chainId": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "decimals": {
         "maximum": 30,
         "minimum": 0,
         "type": "integer"
        },
        "enabled": {
         "type": "boolean"
        },
        "settlement": {
         "enum": [
          "onchain",
          "committed"
         ],
         "type": "string"
        },
        "symbol": {
         "maxLength": 16,
         "minLength": 1,
         "type": "string"
        },
        "token": {
         "pattern": "^0x[a-fA-F0-9]{40}$",
         "type": "string"
        }
       },
       "required": [
        "token",
        "symbol",
        "decimals",
        "chainId",
        "enabled"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "tokens"
    ],
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/DiscoverCollateralResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "List public launch collateral tokens"
}
