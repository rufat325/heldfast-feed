{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create compliance record"
 },
 "description": "Create a new compliance record (audit trail entry). Requires compliance_records:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "completed_at": {
    "description": "Completion date-time (ISO 8601, required)",
    "type": "string"
   },
   "completed_by": {
    "description": "User ID who completed",
    "maxLength": 200,
    "type": "string"
   },
   "compliance_item_id": {
    "description": "Compliance item ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "days_since_last_completion": {
    "description": "Days since last completion",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "pm_schedule_id": {
    "description": "PM schedule ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "required_frequency_days": {
    "description": "Required frequency in days (required)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "work_order_id": {
    "description": "Work order ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "compliance_item_id",
   "pm_schedule_id",
   "work_order_id",
   "completed_at",
   "required_frequency_days"
  ],
  "type": "object"
 },
 "name": "create_compliance_record",
 "title": "Create compliance record"
}
