{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "[INSPECT] Read-only.\nRecord a frame sequence for a video. Time is virtualised, so frames are exactly 1/fps apart and smooth even if rendering is slow. Saves numbered images to screenshots/sequence-<time>/ and returns an ffmpeg command.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "duration": {
    "description": "Seconds to record (default: 3)",
    "type": "number"
   },
   "format": {
    "description": "png = lossless (default), jpeg = smaller/faster",
    "enum": [
     "png",
     "jpeg"
    ],
    "type": "string"
   },
   "fps": {
    "description": "Frames per second (default: 30)",
    "type": "number"
   },
   "height": {
    "description": "Height in pixels (default: canvas height)",
    "type": "number"
   },
   "width": {
    "description": "Width in pixels (default: canvas width)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "capture_frames"
}
