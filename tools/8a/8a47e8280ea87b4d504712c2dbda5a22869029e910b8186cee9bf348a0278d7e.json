  "readOnlyHint": true,
  "title": "List my open alerts"
 },
 "description": "List your open alerts\n\nReturns the alerts the signed-in wallet's rules have fired that are still open, status `triggered` (new) or `acknowledged` (seen, not yet resolved), newest first. Narrows to one token with BOTH `chainId` and `tokenAddress` (a `symbol` is not accepted). Resolved alerts are not included.\n\nNeeds Sign in with Chain Daddy (scope api:read).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "chainId": {
    "description": "Narrow to one token. Chain key (`base`), numeric id or CAIP-2 id. Send together with `tokenAddress`.",
    "examples": [
     "base"
    ],
    "type": "string"
   },
   "tokenAddress": {
    "description": "Narrow to one token (0x address on EVM, mint on Solana). Send together with `chainId`.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_active_alerts",
 "outputSchema": {
  "properties": {
   "alerts": {
    "items": {
     "description": "One alert a rule fired.",
     "properties": {
      "acknowledged_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "alert_type": {
       "description": "What the rule watches, and the lowest plan that may create it: `heartbeat_score` (Free, EVM only, needs a\ntoken page), `copycat_detected` (Free, needs a token page), `holder_count_drop`, `liquidity_drop`,\n`volume_anomaly`, `price_change` (Pro), `top10_concentration` (Pro+).\n",
       "type": [
