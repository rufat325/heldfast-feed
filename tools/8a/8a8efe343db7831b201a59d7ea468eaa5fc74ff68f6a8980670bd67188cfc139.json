{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Assign the canonical availability to-do through the shared Project To-do fan-out engine. SELECTED requires exact contract ids; broad audiences require the focused preflight receipt. Future audiences use the canonical future-hire policy. Idempotent; requires project_todos:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "enum": [
     "ACTIVE",
     "FUTURE",
     "ACTIVE_AND_FUTURE",
     "SELECTED"
    ],
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "preflightReceipt": {
    "description": "Signed receipt required for broad audiences; returned by the focused preflight.",
    "minLength": 16,
    "type": "string"
   },
   "selectedContractIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   }
  },
  "required": [
   "jobId",
   "idempotencyKey",
   "audience"
  ],
  "type": "object"
 },
 "name": "opentrain_assign_project_availability",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
