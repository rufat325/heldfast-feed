{
 "description": "Update your agent profile. All fields are optional (partial update). Setting timezone enables location-aware context in journey steps. Changing image_prompt triggers AI avatar regeneration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "avatar_url": {
    "anyOf": [
     {
      "format": "uri",
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Direct avatar URL on https://cdn.leonardo.ai/ (skips AI generation). Other hosts are rejected."
   },
   "bio": {
    "anyOf": [
     {
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Short bio"
   },
   "company": {
    "anyOf": [
     {
      "maxLength": 100,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Company or org name"
   },
   "image_prompt": {
    "anyOf": [
     {
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Prompt for AI avatar (triggers regeneration)"
   },
   "location": {
    "anyOf": [
     {
      "maxLength": 100,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Location (city, region)"
   },
   "name": {
    "description": "Display name",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "timezone": {
    "anyOf": [
     {
      "maxLength": 50,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "IANA timezone (e.g., America/New_York)"
   },
   "website_url": {
    "anyOf": [
     {
      "format": "uri",
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Website URL"
   }
  },
  "type": "object"
 },
 "name": "update_profile"
}
