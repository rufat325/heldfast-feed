{
 "_meta": {
  "openai/outputTemplate": "ui://uetgpt/widget-v1.html",
  "openai/toolInvocation/invoked": "Listed UET Taxila programs",
  "openai/toolInvocation/invoking": "Listing UET Taxila programs",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://uetgpt/widget-v1.html"
  },
  "ui/resourceUri": "ui://uetgpt/widget-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when a user asks which undergraduate programs UET Taxila offers, or wants to compare UET Taxila programs by recent closing merit or HSSC requirement. Returns each program's degree type, duration, minimum HSSC percentage and latest published Category A closing merit with its year. Do not use it for one program's details (use get_uet_program) or for other universities.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "degreeType": {
    "description": "Only list programs of this degree type.",
    "enum": [
     "BSc Engineering",
     "BS Computing",
     "BS Basic Sciences"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_uet_programs",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "meritNote": {
    "type": "string"
   },
   "meritSourceUrl": {
    "type": "string"
   },
   "meritYear": {
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "officialProgramsUrl": {
    "type": "string"
   },
   "programs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "degreeType": {
       "type": "string"
      },
      "department": {
       "type": "string"
      },
      "duration": {
       "type": "string"
      },
      "latestClosingMerit": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "latestClosingMeritYear": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "minHsscPercent": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "name",
      "degreeType",
      "department",
      "duration",
      "minHsscPercent",
      "latestClosingMerit",
      "latestClosingMeritYear",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "programs",
   "meritYear",
   "meritNote",
   "meritSourceUrl",
   "officialProgramsUrl",
   "note"
  ],
  "type": "object"
 },
 "title": "List UET Taxila programs"
}
