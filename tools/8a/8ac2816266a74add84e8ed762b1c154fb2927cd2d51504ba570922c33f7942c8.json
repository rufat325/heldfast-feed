{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get TrueCoverage Event Time Series"},"description":"TrueCoverage daily time series for one metric (EventTimeSeriesRequest). Requires baseExecutionScope (environment + timeWindow). Optional eventTitle and metricType: SESSION_COUNT | RELATIVE_FREQUENCY | PERCENTAGE_TERMINAL_EVENT | SESSION_POSITION | TIME_TO_NEXT_EVENT | REVERSE_INDEX | TIME_FROM_START | TIME_TO_END | TIME_SINCE_PREVIOUS_EVENT.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"baseExecutionScope":{"properties":{"automationEmitsOnly":{"description":"On comparison/coverage scopes only: restrict to emits with test_id","type":"boolean"},"branchName":{"type":"string"},"environment":{"description":"RUM environment tag from list-rum-environments (e.g. QA, production)","minLength":1,"type":"string"},"metadataFilters":{"items":{"properties":{"key":{"minLength":1,"type":"string"},"operator":{"enum":["UNKNOWN_OPERATOR","EQUALS","NOT_EQUALS","GREATER_THAN","LESS_THAN"],"type":"string"},"value":{"properties":{"boolValue":{"type":"boolean"},"floatValue":{"type":"number"},"intValue":{"type":["string","number"]},"stringValue":{"type":"string"}},"type":"object"}},"required":["key","value"],"type":"object"},"type":"array"},"platform":{"enum":["web","ios","android","UNKNOWN_EXECUTION_PLATFORM","WEB_EXECUTION_PLATFORM","IOS_EXECUTION_PLATFORM","ANDROID_EXECUTION_PLATFORM"],"type":"string"},"release":{"type":"string"},"timeWindow":{"anyOf":[{"additionalProperties":false,"properties":{"relativeWindow":{"pattern":"^-?\\d+(\\.\\d+)?s$","type":"string"}},"required":["relativeWindow"],"type":"object"},{"additionalProperties":false,"properties":{"fixedWindow":{"description":"Fixed calendar window (both bounds required)","properties":{"endTime":{"description":"RFC 3339 timestamp","minLength":1,"type":"string"},"startTime":{"description":"RFC 3339