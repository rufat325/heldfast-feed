{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a structured request for quotation for the human you act for. Call get_rfq_requirements for the process first and upload files with upload_rfq_file; use dry_run to check completeness before sending. The answer contains quote_readiness, missing and recommended items. We match manufacturers, email the ones that opted in, and return direct contact, quote-form and agent links for all matches plus an RFQ id and a token to read quotes later. Only call after the user agreed that the request is shared with matched manufacturers.",
 "inputSchema": {
  "properties": {
   "budget_note": {
    "type": "string"
   },
   "cad_files": {
    "items": {
     "properties": {
      "format": {
       "enum": [
        "step",
        "dxf",
        "dwg",
        "stl",
        "iges",
        "3mf",
        "gerber"
       ],
       "type": "string"
      },
      "sha256": {
       "type": "string"
      },
      "url": {
       "description": "public https URL of the CAD file",
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "callback_url": {
    "description": "Optional https URL that receives a signed event when a factory answers",
    "type": "string"
   },
   "certifications": {
    "items": {
     "enum": [
      "iso-9001",
      "iso-14001",
      "iatf-16949",
      "iso-13485",
      "as9100",
      "en-1090",
      "iso-45001",
      "itar",
      "nadcap",
      "ul-listed",
      "rohs",
      "fda-registered",
      "cmmc"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "description": {
    "description": "Part, size, material, use",
    "type": "string"
   },
   "dry_run": {
    "description": "true = check completeness only; nothing is stored or sent",
    "type": "boolean"
   },
   "file_formats": {
    "items": {
     "enum": [
      "step",
      "dxf",
      "dwg",
      "stl",
      "iges",
      "3mf",
      "gerber"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "file_ids": {
    "description": "file_id values returned by upload_rfq_file",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "finish": {
    "type": "string"
   },
   "industries": {
    "items": {
     "enum": [
      "automotive",
      "aerospace",
      "medical",
      "energy",
      "railway",
      "marine",
      "electronics",
      "food",
      "construction",
      "packaging",
      "defense",
      "consumer"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "materials": {
    "items": {
     "enum": [
      "aluminium",
      "steel",
      "stainless-steel",
      "titanium",
      "brass",
      "copper",
      "plastic"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "needed_by": {
    "type": "string"
   },
   "process": {
    "enum": [
     "laser-cutting",
     "cnc-machining",
     "sheet-metal",
     "3d-printing",
     "injection-molding",
     "pcb-assembly",
     "die-casting",
     "welding",
     "waterjet-cutting",
     "metal-stamping",
     "forging",
     "heat-treatment",
     "grinding-polishing",
     "casting",
     "wire-forming",
     "steel-construction",
     "surface-finishing"
    ],
    "type": "string"
   },
   "quantity": {
    "minimum": 1,
    "type": "integer"
   },
   "requester_email": {
    "type": "string"
   },
   "ship_to_country": {
    "description": "ISO 3166-1 alpha-2",
    "type": "string"
   },
   "strict": {
    "description": "true = refuse to send when required items are missing",
    "type": "boolean"
   },
   "thickness_mm": {
    "description": "Material thickness for sheet, plate and cut parts",
    "type": "number"
   },
   "tolerance_mm": {
    "type": "number"
   },
   "user_consent": {
    "description": "true only if the user agreed to share the request with matched manufacturers",
    "type": "boolean"
   }
  },
  "required": [
   "process",
   "quantity",
   "description",
   "requester_email",
   "user_consent"
  ],
  "type": "object"
 },
 "name": "create_rfq"
}
