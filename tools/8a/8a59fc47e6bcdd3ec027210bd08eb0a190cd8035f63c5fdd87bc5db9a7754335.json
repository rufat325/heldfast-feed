{
 "description": "Return the user answer to the exact Kloudy question. Interpret the relevant project capabilities into short component queries; preserve the complete useful selection independently of display pages. Choices do not authorize installation, execution or spending.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "answer": {
    "additionalProperties": false,
    "properties": {
     "artifact": {
      "type": "object"
     },
     "budget": {
      "maxLength": 2000,
      "type": "string"
     },
     "choice": {
      "enum": [
       "stage-scope",
       "stage-resources",
       "skip",
       "previous",
       "change-email",
       "edit-goal",
       "edit-requirements",
       "keep-selection",
       "pin-stack",
       "build-project",
       "build-complete",
       "more",
       "preview",
       "mockup",
       "like",
       "refine-preview",
       "preview-complete",
       "revise",
       "continue",
       "skip-account",
       "check-account"
      ],
      "type": "string"
     },
     "components": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "label": {
         "maxLength": 80,
         "type": "string"
        },
        "query": {
         "maxLength": 120,
         "type": "string"
        }
       },
       "required": [
        "label",
        "query"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "design": {
      "maxLength": 2000,
      "type": "string"
     },
     "details": {
      "maxLength": 2000,
      "type": "string"
     },
     "email": {
      "maxLength": 254,
      "type": "string"
     },
     "feedback": {
      "maxLength": 2000,
      "type": "string"
     },
     "goal": {
      "maxLength": 2000,
      "type": "string"
     },
     "lifecycle": {
      "description": "Stage planning input: operation, expectedRevision, stage/capability or exact component/resource/proposal IDs. No commands, secrets or action authority.",
      "type": "object"
     },
     "moreComponent": {
      "minimum": 0,
      "type": "integer"
     },
     "optionIds": {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
     },
     "pins": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "previewStatus": {
      "enum": [
       "ready",
       "unavailable"
      ],
      "type": "string"
     },
     "previewUrl": {
      "maxLength": 2048,
      "type": "string"
     },
     "project": {
      "type": "object"
     },
     "stageScope": {
      "description": "Explicitly accepted planning filters: confirmed, expectedRevision, combinationId, combinationRevision, requirementsRevision, constraints. This is not a permission grant.",
      "type": "object"
     }
    },
    "type": "object"
   },
   "cardId": {
    "type": "string"
   },
   "flowId": {
    "type": "string"
   }
  },
  "required": [
   "flowId",
   "cardId",
   "answer"
  ],
  "type": "object"
 },
 "name": "kloudy_build_answer"
}
