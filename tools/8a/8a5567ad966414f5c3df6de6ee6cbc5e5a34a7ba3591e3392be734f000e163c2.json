{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Decision Draft"
 },
 "description": "Capture a decision from working context with the why deferred for later confirmation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alternatives_rejected": {
    "description": "Alternatives considered and rejected.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "component_ref": {
    "description": "Component or surface the decision refers to.",
    "minLength": 1,
    "type": "string"
   },
   "scope": {
    "description": "Scope where the decision applies.",
    "minLength": 1,
    "type": "string"
   },
   "statement": {
    "description": "Decision statement.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "statement",
   "scope",
   "component_ref"
  ],
  "type": "object"
 },
 "name": "decision_draft"
}
