{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find the MCP(s) for a task"
 },
 "description": "Describe in natural language what you want your AI to do. ABCommunity detects the required capabilities, searches the marketplace, and returns the recommended MCP(s) plus alternatives, with reasoning. Example: 'I want my AI to read Gmail and create Linear tasks.'",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deployment_preference": {
    "enum": [
     "remote",
     "local"
    ],
    "type": "string"
   },
   "open_source_preference": {
    "type": "boolean"
   },
   "platform": {
    "description": "Target client, e.g. claude-code",
    "type": "string"
   },
   "pricing_preference": {
    "type": "string"
   },
   "security_preference": {
    "type": "string"
   },
   "task": {
    "description": "Natural-language description of the goal",
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "find_mcp_for_task",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alternatives": {
    "items": {
     "$ref": "#/properties/intent"
    },
    "type": "array"
   },
   "intent": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "note": {
    "type": "string"
   },
   "reasoningSummary": {
    "type": "string"
   },
   "reasoningSummaryEn": {
    "type": "string"
   },
   "recommended": {
    "items": {
     "$ref": "#/properties/intent"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Find the MCP(s) for a task"
}
