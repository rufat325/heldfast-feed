{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Time-series usage metrics for one agent (CPU, memory, network, disk, tokens) over a time window. Defaults to the last 24h.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Agent id (UUID)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "since": {
    "description": "ISO timestamp lower bound (default: 24h ago)",
    "type": "string"
   },
   "type": {
    "description": "Metric type filter, e.g. 'token_usage'",
    "type": "string"
   },
   "until": {
    "description": "ISO timestamp upper bound (default: now)",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_agent_metrics",
 "title": "Get agent metrics"
}
