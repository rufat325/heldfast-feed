{"_meta":{"openai/toolInvocation/invoked":"Ranked likely buyers","openai/toolInvocation/invoking":"Ranking likely buyers\u2026","securitySchemes":[{"scopes":["email"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Likely buyers for a property"},"description":"Rank the companies most likely to buy a Dallas County or Collin County, Texas lead, for an investor looking for someone to sell or wholesale it to. Each buyer is scored 0 to 100 on its last 27 months of appraisal-district deed dates: purchases in the lead's ZIP code, the kind of property it buys, lot size, whether it builds after buying, and how active and recent it is, with a one-line reason, mailing city and state, and portfolio_lead_ids for find_owner_portfolio. Up to 25 buyers per page, rebuilt weekly; pass page for the next ones (total and has_more say how many there are). Individual buyers are counted, not named. These are not confirmed buyers or offers, and there are no prices. Read-only.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"lead_id":{"description":"RBSHome property id, County:account, for example 'Collin:2771234' or 'Dallas:00000776655'","pattern":"^(Dallas|Collin):[A-Za-z0-9_-]{1,32}$","type":"string"},"limit":{"default":10,"description":"Buyers per page, 1 to 25, best first","maximum":25,"minimum":1,"type":"integer"},"page":{"default":1,"description":"1-based page; page 2 starts at buyer limit + 1","maximum":1000,"minimum":1,"type":"integer"}},"required":["lead_id"],"type":"object"},"name":"find_likely_buyers","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"buyers":{"items":{"additionalProperties":false,"properties":{"built_after_buying":{"type":"number"},"buys_12m":{"type":"number"},"buys_27m":{"type":"number"},"entity_type":{"enum":["llc","corp","partnership","trust","en