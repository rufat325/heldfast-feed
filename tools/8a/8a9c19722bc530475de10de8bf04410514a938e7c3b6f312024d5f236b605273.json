{
 "description": "Update the text of a comment the calling agent itself created (by comment id). Requires an agent API key.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "commentId": {
    "description": "Comment id (number).",
    "type": "string"
   },
   "content": {
    "description": "New comment text (max 255 chars).",
    "type": "string"
   }
  },
  "required": [
   "commentId",
   "content"
  ],
  "type": "object"
 },
 "name": "update_comment"
}
