{
 "description": "Match, replace or split text with a PCRE regular expression. Returns offsets and capture groups. ReDoS-protected: catastrophic patterns return an error rather than hanging.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "flags": {
    "description": "any of i, m, s, u, x",
    "type": "string"
   },
   "operation": {
    "default": "match_all",
    "enum": [
     "match",
     "match_all",
     "replace",
     "split"
    ],
    "type": "string"
   },
   "pattern": {
    "type": "string"
   },
   "replacement": {
    "type": "string"
   },
   "split_limit": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "pattern",
   "text"
  ],
  "type": "object"
 },
 "name": "regex_test"
}
