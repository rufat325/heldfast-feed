{
 "description": "Partial update of a todo. Only supplied fields are changed. Pass status=\"done\" or use iyke_todo_complete for the common case.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assignee": {
    "type": "string"
   },
   "blocker_id": {
    "type": "string"
   },
   "body": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "status": {
    "enum": [
     "open",
     "in_progress",
     "blocked",
     "done",
     "cancelled"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "iyke_todo_update"
}
