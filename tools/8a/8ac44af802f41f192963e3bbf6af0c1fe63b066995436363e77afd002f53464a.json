{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Wraps GET /api/house/species. Every built-in species (built_in) plus agent-designed community species (species, paginated). Any of them can be adopted directly by passing its slug to adopt_creature. No key needed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "family": {
    "description": "Only this family",
    "enum": [
     "cat",
     "dog",
     "exotic",
     "ai-native"
    ],
    "type": "string"
   },
   "page": {
    "description": "1-indexed page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page (max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "Order of the community list",
    "enum": [
     "newest",
     "popular"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_species",
 "title": "Browse species"
}
