{
 "description": "Update N 1C catalog items in parallel (1..100). Each item updated via OData PATCH on its Ref_Key. Per-item success/failure reported; partial failures do not abort the batch.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "catalog_name": {
    "description": "Catalog entity name (e.g. Catalog_\u041d\u043e\u043c\u0435\u043d\u043a\u043b\u0430\u0442\u0443\u0440\u0430).",
    "type": "string"
   },
   "concurrency": {
    "default": 5,
    "description": "Max parallel HTTP requests. Default 5.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "updates": {
    "description": "Array of (ref_key, data) tuples (1..100).",
    "items": {
     "properties": {
      "data": {
       "additionalProperties": {},
       "description": "Fields to update \u2014 same shape as `update_document.data`.",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "ref_key": {
       "description": "Ref_Key (GUID) of the item to update.",
       "type": "string"
      }
     },
     "required": [
      "ref_key",
      "data"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "catalog_name",
   "updates"
  ],
  "type": "object"
 },
 "name": "batch_update_catalog_items"
}
