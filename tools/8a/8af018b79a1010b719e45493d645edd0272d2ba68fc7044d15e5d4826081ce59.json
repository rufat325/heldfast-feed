{
 "description": "List subscribers from Kit.com with optional filters. Returns paginated results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Cursor for pagination - get results after this cursor",
    "type": "string"
   },
   "created_after": {
    "description": "Filter subscribers created after this ISO date",
    "type": "string"
   },
   "created_before": {
    "description": "Filter subscribers created before this ISO date",
    "type": "string"
   },
   "per_page": {
    "description": "Number of results per page (max 100)",
    "type": "number"
   },
   "sort_field": {
    "description": "Field to sort by",
    "enum": [
     "created_at",
     "updated_at"
    ],
    "type": "string"
   },
   "sort_order": {
    "description": "Sort order",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by subscriber status",
    "enum": [
     "active",
     "inactive",
     "bounced",
     "complained",
     "cancelled"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "kit_list_subscribers"
}
