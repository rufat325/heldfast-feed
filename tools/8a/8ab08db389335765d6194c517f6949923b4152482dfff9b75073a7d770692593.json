{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Delete a site from an Infomaniak web hosting. Two-phase commit: first call returns a plan with the site preview + token, second call (same params + token) actually deletes. WARNING: this also wipes the site directory on the FTP backend after a short grace period.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "description": "Token returned by the first (plan) phase. Re-pass on the second call to execute the delete. Omit on first call to receive the plan + token (full preview of what will be removed).",
    "format": "uuid",
    "type": "string"
   },
   "hosting_id": {
    "description": "Web hosting ID. Discover via infomaniak_find_site(domain) or infomaniak_list_hostings.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "site_id": {
    "description": "Site ID on that hosting. Same source as hosting_id (infomaniak_find_site or infomaniak_list_sites).",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "hosting_id",
   "site_id"
  ],
  "type": "object"
 },
 "name": "infomaniak_delete_site",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "hosting_id": {
        "type": "number"
       },
       "site_id": {
        "type": "number"
       },
       "site_preview": {
        "additionalProperties": false,
        "properties": {
         "account_id": {
          "type": "number"
         },
         "applications": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "id": {
             "type": "number"
            },
            "is_complete": {
             "type": "boolean"
            },
            "link_admin": {
             "type": "string"
            },
            "name": {
             "type": "string"
            },
            "type": {
             "type": "string"
            },
            "url": {
             "type": "string"
            },
            "version": {
             "type": "string"
            }
           },
           "required": [
            "id",
            "type"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "customer_name": {
          "type": "string"
         },
         "directory": {
          "type": "string"
         },
         "has_website_builder": {
          "type": "boolean"
         },
         "has_wordpress": {
          "type": "boolean"
         },
         "hosting_type": {
          "type": "string"
         },
         "id": {
          "type": "number"
         },
         "main_fqdn": {
          "type": [
           "string",
           "null"
          ]
         },
         "parent_hosting_name": {
          "type": "string"
         },
         "parent_id": {
          "type": "number"
         },
         "ssl_issuer": {
          "type": [
           "string",
           "null"
          ]
         },
         "ssl_status": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "account_id",
         "customer_name"
        ],
        "type": "object"
       }
      },
      "required": [
       "hosting_id",
       "site_id",
       "site_preview"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
