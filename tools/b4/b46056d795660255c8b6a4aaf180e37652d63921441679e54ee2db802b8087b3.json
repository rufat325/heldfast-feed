{
 "description": "Update fields on one node in the stored flow graph (prompt text, model, processor options). Run validate_asset_flow afterwards.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assetRef": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "globalRules": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "label": {
    "type": "string"
   },
   "mimeType": {
    "type": "string"
   },
   "modelId": {
    "type": "string"
   },
   "negativeConstraints": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "nodeId": {
    "description": "Node id in the stored graph \u2014 from get_asset_flow.",
    "minLength": 1,
    "type": "string"
   },
   "palette": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "position": {
    "additionalProperties": false,
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y"
    ],
    "type": "object"
   },
   "provider": {
    "type": "string"
   },
   "sessionId": {
    "description": "Persisted flow session id (flow_session_\u2026) from create_asset_flow or list_asset_flows.",
    "minLength": 1,
    "type": "string"
   },
   "stageIndex": {
    "type": "number"
   },
   "stageLabel": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "storagePath": {
    "type": "string"
   },
   "strategy": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "themeStyle": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "tone": {
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "nodeId"
  ],
  "type": "object"
 },
 "name": "update_flow_node"
}
