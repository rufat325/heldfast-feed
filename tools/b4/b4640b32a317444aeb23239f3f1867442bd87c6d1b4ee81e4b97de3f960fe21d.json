{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "project_todos:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Resolve one feedback thread (action coaching_thread_resolve); it stays in immutable history. Requires project_todos:write and a caller-supplied stable idempotencyKey (registry op project_todos.quizzes.coaching.manage). The response echoes its action discriminator and receipt fields.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "threadId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "threadId",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_coaching_resolve_thread",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "enum": [
       "coaching_thread_resolve",
       "coaching_thread_reopen"
      ],
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "resolvedAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "enum": [
       "OPEN",
       "RESOLVED"
      ],
      "type": "string"
     },
     "threadId": {
      "type": "string"
     }
    },
    "required": [
     "action",
     "threadId",
     "status",
     "resolvedAt",
     "replayed"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
