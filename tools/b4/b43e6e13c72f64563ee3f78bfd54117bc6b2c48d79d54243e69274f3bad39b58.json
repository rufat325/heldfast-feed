{
 "_meta": {
  "ui": {
   "resourceUri": "ui://fplcopilot/app-v1.html",
   "visibility": [
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Share this card"
 },
 "description": "Creates a public fplcopilot.com page for an FPL Copilot card so it can be shared.",
 "inputSchema": {
  "properties": {
   "component": {
    "description": "The card's component, e.g. rating_card",
    "maxLength": 40,
    "title": "Component",
    "type": "string"
   },
   "data": {
    "additionalProperties": true,
    "description": "The card's data object",
    "title": "Data",
    "type": "object"
   },
   "token": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The card's share token (from the result's _meta)",
    "title": "Token"
   }
  },
  "required": [
   "component",
   "data"
  ],
  "title": "create_share_linkArguments",
  "type": "object"
 },
 "name": "create_share_link",
 "title": "Share this card"
}
