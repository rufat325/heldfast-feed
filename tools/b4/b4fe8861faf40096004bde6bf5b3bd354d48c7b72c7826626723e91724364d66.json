{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store binary content (base64-encoded in 'data') in the content-addressed blob store and get back a BlobRef {$blobId, $mediaType, $bytes} to embed in a model's binary field. Storage is content-addressed (SHA-256), so uploading identical bytes returns the same $blobId.",
 "inputSchema": {
  "properties": {
   "data": {
    "description": "The blob content, base64-encoded.",
    "type": "string"
   },
   "mediaType": {
    "description": "Optional media type (default application/octet-stream).",
    "type": "string"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "name": "upload_blob",
 "outputSchema": {
  "properties": {
   "$blobId": {
    "description": "Content-addressed id (sha256:...).",
    "type": "string"
   },
   "$bytes": {
    "description": "Size in bytes.",
    "type": "integer"
   },
   "$mediaType": {
    "description": "The stored media type.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Upload blob"
}
