{
 "_meta": {
  "examples": [
   {
    "target": "https://api.example.com",
    "task": "I am about to pay an unfamiliar x402 endpoint"
   },
   {
    "fields": [
     "price",
     "limits"
    ],
    "target": "https://example.com/pricing",
    "task": "Extract price and limits from this webpage"
   }
  ],
  "signallayer/defaultEntryPoint": true,
  "signallayer/free": true
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Free deterministic task-to-tool router, not a full catalog. Returns match, recommendedTool, routingConfidence, reason, missingRequiredInputs and readyToCall HTTP/MCP arguments for the best eligible primitive, or an explicit no_match when nothing fits. It may recommend a paid tool but never authorizes payment; check the live x402 challenge and obtain user approval before spending.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "pattern": "^\\d+(?:\\.\\d+)?$",
    "type": "string"
   },
   "buyToken": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "buyTokenDecimals": {
    "maximum": 36,
    "minimum": 0,
    "type": "integer"
   },
   "fields": {
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "maxPriceUsd": {
    "minimum": 0,
    "type": "number"
   },
   "network": {
    "maxLength": 80,
    "type": "string"
   },
   "sellToken": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "sellTokenDecimals": {
    "maximum": 36,
    "minimum": 0,
    "type": "integer"
   },
   "target": {
    "maxLength": 2048,
    "type": "string"
   },
   "task": {
    "maxLength": 2000,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "signal_layer_router",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "match": {
    "type": "boolean"
   },
   "missingRequiredInputs": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "readyToCall": {},
   "reason": {
    "type": "string"
   },
   "recommendedTool": {
    "type": [
     "string",
     "null"
    ]
   },
   "routingConfidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Route a task to the right SignalLayer tool"
}
