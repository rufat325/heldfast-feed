{
 "description": "Create a GPT Image 2 task on RunAPI (text to image). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "aspect_ratio": {
    "description": "Declared type: string. Known values: \"auto\", \"1:1\", \"3:2\", \"2:3\", \"4:3\", \"3:4\", \"5:4\", \"4:5\", \"16:9\", \"9:16\", \"2:1\", \"1:2\", \"3:1\", \"1:3\", \"21:9\", \"9:21\".",
    "type": "string"
   },
   "callback_url": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "type": "string"
   },
   "output_resolution": {
    "description": "Declared type: string. Known values: \"1k\", \"2k\", \"4k\".",
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "text_to_image"
}
