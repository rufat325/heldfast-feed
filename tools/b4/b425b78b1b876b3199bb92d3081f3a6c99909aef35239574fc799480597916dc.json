{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Reads a site's protectedPaths / localStorageSync / authButton configuration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "site_id": {
    "description": "The site's id, from list_sites or create_site.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "site_id"
  ],
  "type": "object"
 },
 "name": "get_config",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ads": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     }
    },
    "required": [
     "enabled"
    ],
    "type": "object"
   },
   "authButton": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "position": {
      "default": "bottom-right",
      "enum": [
       "top-right",
       "top-left",
       "bottom-right",
       "bottom-left"
      ],
      "type": "string"
     }
    },
    "required": [
     "enabled"
    ],
    "type": "object"
   },
   "authOnlyPaths": {
    "$ref": "#/properties/protectedPaths",
    "default": []
   },
   "autoRedirectIfEntitled": {
    "additionalProperties": false,
    "properties": {
     "path": {
      "minLength": 1,
      "type": "string"
     },
     "to": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "path",
     "to"
    ],
    "type": "object"
   },
   "brandingBanner": {
    "additionalProperties": false,
    "properties": {
     "position": {
      "default": "bottom-left",
      "enum": [
       "top-right",
       "top-left",
       "bottom-right",
       "bottom-left"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "localStorageSync": {
    "additionalProperties": false,
    "properties": {
     "allowlist": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "protectedPaths": {
    "default": [],
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Get site config"
}
