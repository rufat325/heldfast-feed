{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update asset status"
 },
 "description": "Update an existing asset status by ID. Requires asset_statuses:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "Description",
    "type": "string"
   },
   "id": {
    "description": "Asset status ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "module": {
    "description": "Move the status to a workspace: facilities, infrastructure, or shared (both).",
    "enum": [
     "facilities",
     "infrastructure",
     "shared"
    ],
    "type": "string"
   },
   "name": {
    "description": "Status name",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_asset_status",
 "title": "Update asset status"
}
