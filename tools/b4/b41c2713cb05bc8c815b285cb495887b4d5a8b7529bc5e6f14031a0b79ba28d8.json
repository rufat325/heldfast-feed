{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Book for a customer, e.g. one who called or messaged. pay_at_desk and on_arrival confirm straight away (record the money with record_payment when it's taken); bank_transfer holds the booking until the transfer is recorded, then confirms it. Asking for exactly the same booking again (same listing, dates, guests, customer and payment) returns the existing one with alreadyBooked: true instead of booking twice.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"adults":{"default":1,"maximum":9007199254740991,"minimum":1,"type":"integer"},"children":{"default":0,"maximum":9007199254740991,"minimum":0,"type":"integer"},"courseId":{"type":"string"},"customer":{"description":"Name plus an email or phone. Confirmation emails need an email","properties":{"email":{"format":"email","pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"name":{"minLength":1,"type":"string"},"phone":{"minLength":5,"type":"string"}},"required":["name"],"type":"object"},"discountCode":{"description":"A discount code the customer gave (case doesn't matter); if it doesn't apply, the error says why","maxLength":30,"type":"string"},"listingId":{"type":"string"},"payment":{"description":"How the customer will pay","enum":["pay_at_desk","bank_transfer","on_arrival"],"type":"string"},"quantity":{"default":1,"maximum":9007199254740991,"minimum":1,"type":"integer"},"rateId":{"type":"string"},"when":{"description":"When, in the shape the listing's rate uses: nights for stays, hours/block/days for spaces, months/years for contracts","oneOf":[{"properties":{"checkIn":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"checkOut":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"kind":{"const":"nights","type":"string"}},"required":["kind","checkIn","checkOut"],"type":"object"},{"properties":{"hours":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"kind":{"const":"hours","type":"string"},"start":{"description":"Local start, YYYY-MM-DDTHH:mm","type":"string"}},"required":["kind","start","hours"],"type":"object"},{"properties":{"block":{"description":"Block name from the rate, e.g. Morning","type":"string"},"date":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"kind":{"const":"block","type":"string"}},"required":["kind","date","block"],"type":"object"},{"properties":{"days":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"kind":{"const":"days","type":"string"},"start":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"}},"required":["kind","start","days"],"type":"object"},{"properties":{"kind":{"const":"months","type":"string"},"months":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"start":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"}},"required":["kind","start","months"],"type":"object"},{"properties":{"kind":{"const":"years","type":"string"},"start":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"years":{"maximum":9007199254740991,"minimum":1,"type":"integer"}},"required":["kind","start","years"],"type":"object"}]}},"required":["customer","payment"],"type":"object"},"name":"book","title":"Make a booking"}
