{
 "description": "Executes multiple tool operations in batch. Actions: execute (run batch), preview (plan without executing), status (check job status), cancel (stop running job), history (list past jobs). Supports sequential and parallel execution with dependency management.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "execute",
     "preview",
     "status",
     "cancel",
     "history"
    ],
    "type": "string"
   },
   "includeErrors": {
    "default": true,
    "type": "boolean"
   },
   "includeResults": {
    "default": true,
    "type": "boolean"
   },
   "jobId": {
    "type": "string"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "mode": {
    "default": "sequential",
    "enum": [
     "sequential",
     "parallel"
    ],
    "type": "string"
   },
   "operations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dependsOn": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "params": {
       "additionalProperties": {},
       "type": "object"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool",
      "params"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "pending",
     "running",
     "completed",
     "failed",
     "cancelled"
    ],
    "type": "string"
   },
   "stopOnError": {
    "default": true,
    "type": "boolean"
   },
   "timeout": {
    "default": 60000,
    "maximum": 600000,
    "minimum": 1000,
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "muse_batch"
}
