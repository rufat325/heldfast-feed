{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get a product's availability calendar"
 },
 "description": "Day-by-day availability for one product over a month: status (available/partial/unavailable) and bookable quantity per day. Booqable: GET /api/4/availabilities with subject_type=item.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "location_id": {
    "description": "Location id to check at.",
    "type": "string"
   },
   "month": {
    "description": "Calendar month, 1-12.",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "product_id": {
    "description": "The product id (UUID).",
    "minLength": 1,
    "type": "string"
   },
   "quantity": {
    "description": "Units needed; sets the threshold for available vs partial.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "year": {
    "description": "Calendar year, e.g. 2026.",
    "maximum": 2100,
    "minimum": 2000,
    "type": "integer"
   }
  },
  "required": [
   "product_id",
   "year",
   "month"
  ],
  "type": "object"
 },
 "name": "booqable_get_availability_calendar",
 "title": "Get a product's availability calendar"
}
