{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks whether a product contains certain allergens, such as \"does 5449000000996 contain milk or nuts?\". Pass the barcode and the allergens to avoid. Returns which are listed as contained, which as possible traces, which are not listed, and whether the entry has no allergen data at all. It reads the entry's allergen tags and ingredients text, which are crowd-sourced and can be wrong: it is a data lookup, not a safety guarantee. The physical label wins.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "avoid": {
    "description": "Allergens to look for, such as milk, nuts, peanuts, soy, gluten, eggs, fish, shellfish, sesame",
    "items": {
     "maxLength": 40,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "barcode": {
    "description": "EAN or UPC barcode, 8 to 14 digits",
    "maxLength": 20,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "barcode",
   "avoid"
  ],
  "type": "object"
 },
 "name": "check_allergens",
 "outputSchema": {
  "properties": {
   "attribution": {
    "type": "string"
   },
   "avoid": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "barcode": {
    "type": "string"
   },
   "brands": {
    "type": [
     "string",
     "null"
    ]
   },
   "contains": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "data_quality_note": {
    "type": "string"
   },
   "listed_allergens": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "listed_traces": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "may_contain": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "name": {
    "type": [
     "string",
     "null"
    ]
   },
   "not_listed": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
