{
 "description": "Add an SEO keyword to track for a target. Max 50 keywords per target.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "isPrimary": {
    "default": false,
    "description": "Mark as primary keyword",
    "type": "boolean"
   },
   "keyword": {
    "description": "The keyword to track",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "pageScope": {
    "description": "URL pathname pattern to scope the keyword to (e.g. /kategori/*)",
    "maxLength": 500,
    "type": "string"
   },
   "targetId": {
    "description": "The target ID",
    "type": "string"
   }
  },
  "required": [
   "targetId",
   "keyword"
  ],
  "type": "object"
 },
 "name": "add_keyword",
 "title": "Add Keyword"
}
