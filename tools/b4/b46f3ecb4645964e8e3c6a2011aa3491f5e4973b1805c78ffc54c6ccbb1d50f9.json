{
 "description": "Declare future presence at a waypoint. `chip` is the time-window enum: next_30, next_hour, tonight, tomorrow_night.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "chip": {
    "enum": [
     "next_30",
     "next_hour",
     "tonight",
     "tomorrow_night"
    ],
    "type": "string"
   },
   "ends_at": {
    "format": "date-time",
    "type": "string"
   },
   "lat": {
    "type": "number"
   },
   "lon": {
    "type": "number"
   },
   "name": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "starts_at": {
    "format": "date-time",
    "type": "string"
   },
   "waypoint_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "waypoint_id",
   "name",
   "starts_at",
   "ends_at",
   "chip"
  ],
  "type": "object"
 },
 "name": "polarity_declare"
}
