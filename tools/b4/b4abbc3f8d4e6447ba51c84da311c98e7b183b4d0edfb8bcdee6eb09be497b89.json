{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Everything the public record says about a US address"
 },
 "description": "One US address or point, one call: FEMA National Risk Index ratings for flooding and 17 other hazards with expected annual loss, tract median home value, rent, income, ownership and vacancy (Census ACS), price trend (FHFA), fair market rents for the metro and ZIP (HUD), nearby public schools with enrollment and ratios (NCES), walkability (EPA) and Superfund sites nearby, plus tract, county, ZIP, metro and districts. Input: address or lat and lng. $0.25 per call. Returns: input{}, matched_address, lat, lng, geography{state, county, tract, zip, metro, congressional_district, school_district...}, flood{zone, special_flood_hazard_area...}, hazard_risk{overall_rating, hazards{}, notice...}, housing{median_home_value, median_gross_rent...}, price_trend{}, fair_market_rent{zip{}...}, schools[], walkability{}, superfund_sites[], sources[], sections_failed[], notes[], checked_at.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "address"
    ]
   },
   {
    "required": [
     "lat",
     "lng"
    ]
   }
  ],
  "properties": {
   "address": {
    "description": "US street address with city and state or ZIP.",
    "maxLength": 200,
    "minLength": 5,
    "type": "string"
   },
   "language": {
    "description": "Optional BCP-47 language tag (en, ja, ko, pt-BR): the human-readable strings of the result (notes, details, reasons) are translated into this language; data, codes, numbers and URLs are untouched. Default: as produced.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   },
   "lat": {
    "description": "Latitude, instead of an address.",
    "maximum": 72,
    "minimum": 17,
    "type": "number"
   },
   "lng": {
    "description": "Longitude, instead of an address.",
    "maximum": -64,
    "minimum": -180,
    "type": "number"
   },
   "school_radius_km": {
    "description": "Schools within this radius. Default 1.5.",
    "maximum": 5,
    "minimum": 0.1,
    "type": "number"
   },
   "superfund_radius_km": {
    "description": "Superfund sites within this radius. Default 5.",
    "maximum": 15,
    "minimum": 0.1,
    "type": "number"
   }
  },
  "required": [],
  "type": "object"
 },
