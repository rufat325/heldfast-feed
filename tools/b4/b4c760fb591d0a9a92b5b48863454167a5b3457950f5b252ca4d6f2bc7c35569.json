{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Looks up public employer identities by name or website domain, including employers without current vacancies.\nReturns the canonical company name, any known domain and website, and a lookupValue for employer-filtered job search.\nSeveral matches are candidates for clarification. This lookup does not search jobs.\n","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"query":{"description":"Employer name or website domain","maxLength":200,"minLength":1,"type":"string"}},"required":["query"],"type":"object"},"name":"company_lookup","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"candidates":{"items":{"properties":{"contextUrl":{"type":["string","null"]},"domain":{"type":["string","null"]},"headquarters":{"type":["string","null"]},"lookupValue":{"type":"string"},"name":{"type":"string"},"website":{"type":["string","null"]}},"required":["name","lookupValue"],"type":"object"},"type":"array"},"moreCandidates":{"type":"boolean"},"status":{"enum":["found","ambiguous","missing"],"type":"string"}},"required":["status","candidates","moreCandidates"],"type":"object"},"title":"Look up an employer"}
