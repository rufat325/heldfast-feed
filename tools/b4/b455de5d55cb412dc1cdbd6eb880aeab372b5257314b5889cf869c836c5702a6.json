{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Preserve a concise story-session handoff when the user asks to save progress or has authorized ongoing checkpoints for this story. Stores provisional notes, not canon or an approved scene. Separate established progress from unresolved ideas. Send only focused story state, never a full transcript, credentials, or unrelated personal details. Reuse checkpointId on retries.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checkpointId": {
    "$ref": "#/properties/projectId"
   },
   "nextSteps": {
    "default": [],
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "openThreads": {
    "default": [],
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "projectId": {
    "format": "uuid",
    "type": "string"
   },
   "storyState": {
    "maxLength": 6000,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "checkpointId",
   "title",
   "storyState"
  ],
  "type": "object"
 },
 "name": "save_story_checkpoint",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "save story checkpoint"
}
