{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search for concepts in a SKOS vocabulary. By default searches prefLabel, altLabel, hiddenLabel, and definition.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fields": {
    "description": "Fields to search in. Default: [\"prefLabel\", \"altLabel\", \"hiddenLabel\", \"definition\"]",
    "items": {
     "enum": [
      "prefLabel",
      "altLabel",
      "hiddenLabel",
      "definition",
      "notation"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "language": {
    "description": "Limit search to this language (e.g., \"de\"). If not specified, searches all languages.",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of results (default: 20, max: 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query",
    "minLength": 1,
    "type": "string"
   },
   "vocabularyUri": {
    "description": "URI of the vocabulary to search (e.g., \"https://w3id.org/kim/hochschulfaechersystematik/scheme\")",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "vocabularyUri",
   "query"
  ],
  "type": "object"
 },
 "name": "skos_search",
 "title": "Search SKOS Concepts"
}
