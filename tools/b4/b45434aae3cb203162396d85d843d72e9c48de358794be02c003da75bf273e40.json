{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Approve or deny the integration actions a run is paused on (status needs_input with pending_approval_ids). Submit a decision for every pending id at once; the run resumes in the background.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "approvals": {
    "description": "One decision per pending approval id \u2014 the run stays paused until every one is answered.",
    "items": {
     "properties": {
      "approved": {
       "description": "True to let the action run, false to deny it.",
       "type": "boolean"
      },
      "id": {
       "description": "A pending approval id from the run's pending_approval_ids.",
       "type": "string"
      },
      "reason": {
       "description": "Why it was denied (optional).",
       "type": "string"
      }
     },
     "required": [
      "id",
      "approved"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "run_id": {
    "description": "A run id (trun_...).",
    "type": "string"
   }
  },
  "required": [
   "run_id",
   "approvals"
  ],
  "type": "object"
 },
 "name": "resolve_approvals",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A task run \u2014 one delegated job and what is known about its state.",
  "properties": {
   "chat_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "completed_at": {
    "format": "date-time",
    "type": [
     "string",
     "null"
    ]
   },
   "created_at": {
    "format": "date-time",
    "type": "string"
   },
   "credits_consumed": {
    "type": "integer"
   },
   "error_message": {
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "object": {
    "const": "task_run",
    "type": "string"
   },
   "pending_approval_ids": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "result": {
    "type": [
     "string",
     "null"
    ]
   },
   "reused": {
    "type": "boolean"
   },
   "started_at": {
    "format": "date-time",
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "enum": [
     "pending",
     "running",
     "completed",
     "failed",
     "needs_input",
     "timed_out",
     "unknown",
     "skipped"
    ],
    "type": "string"
   },
   "summary": {
    "type": [
     "string",
     "null"
    ]
   },
   "task_id": {
    "type": "string"
   },
   "task_name": {
    "type": [
     "string",
     "null"
    ]
   },
   "wait_timed_out": {
    "description": "The wait ended first. The work is still running: follow it with the tool next_step names.",
    "type": "boolean"
   }
  },
  "required": [
   "object",
   "id",
   "task_id",
   "status",
   "created_at"
  ],
  "type": "object"
 }
}
