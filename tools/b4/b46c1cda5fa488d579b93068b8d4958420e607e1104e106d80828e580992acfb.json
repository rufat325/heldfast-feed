{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns the caller's most recent orders. Pass role: 'buyer' for orders you placed, or role: 'seller' for orders on your own listings. Each entry has the same decoded status booleans as orders.status (reserved / dispatched / paid / received / rejected / closed), plus the product name, item count, total price (converted to the requested currency, default USD), the other party's name, and a link to the order page. Read-only, no side effects. Requires an 'Authorization: Bearer <agent api key>' header.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currency": {
    "description": "ISO 4217 code for the returned price fields. Defaults to USD. Same semantics as in search_products.",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of most-recent orders to return (1-50, default 20).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "role": {
    "description": "Whose side to list from: 'buyer' returns orders you placed, 'seller' returns orders on your listings.",
    "enum": [
     "buyer",
     "seller"
    ],
    "type": "string"
   }
  },
  "required": [
   "role"
  ],
  "type": "object"
 },
 "name": "orders.list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "orders": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "closed": {
       "type": "boolean"
      },
      "completed_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "counterparty": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "created_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "dispatched": {
       "type": "boolean"
      },
      "item_count": {
       "type": "number"
      },
      "order_id": {
       "type": "string"
      },
      "paid": {
       "type": "boolean"
      },
      "product_name": {
       "type": "string"
      },
      "received": {
       "type": "boolean"
      },
      "rejected": {
       "type": "boolean"
      },
      "reserved": {
       "type": "boolean"
      },
      "role": {
       "enum": [
        "buyer",
        "seller"
       ],
       "type": "string"
      },
      "total_price": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "type": "number"
        },
        "currency": {
         "type": "string"
        }
       },
       "required": [
        "amount",
        "currency"
       ],
       "type": "object"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "order_id",
      "role",
      "reserved",
      "dispatched",
      "paid",
      "received",
      "rejected",
      "closed",
      "product_name",
      "item_count",
      "total_price",
      "counterparty",
      "url",
      "created_at",
      "completed_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "orders",
   "count"
  ],
  "type": "object"
 },
 "title": "List the authenticated user's own Resollo orders"
}
