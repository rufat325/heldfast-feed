{
 "description": "ATENCAO: altera producao. Cria um novo chamado no TomTicket.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attachments": {
    "description": "Caminhos locais de anexos, separados por virgula. Maximo 25 arquivos / 25 MB.",
    "type": "string"
   },
   "category_id": {
    "type": "string"
   },
   "custom_fields": {
    "description": "Campos personalizados em JSON objeto. Ex.: {\"ID_DO_CAMPO\":\"valor\"}.",
    "type": "string"
   },
   "customer_id": {
    "description": "Id interno ou email do cliente.",
    "minLength": 1,
    "type": "string"
   },
   "customer_id_type": {
    "description": "I id interno, E email.",
    "enum": [
     "I",
     "E"
    ],
    "type": "string"
   },
   "department_id": {
    "minLength": 1,
    "type": "string"
   },
   "message": {
    "minLength": 1,
    "type": "string"
   },
   "priority": {
    "description": "1 baixa, 2 normal, 3 alta, 4 urgente.",
    "maximum": 4,
    "minimum": 1,
    "type": "integer"
   },
   "subject": {
    "maxLength": 250,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "customer_id",
   "department_id",
   "subject",
   "message"
  ],
  "type": "object"
 },
 "name": "tomticket_create_ticket"
}
