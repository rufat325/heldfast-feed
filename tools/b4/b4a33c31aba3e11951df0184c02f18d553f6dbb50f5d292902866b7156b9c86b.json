{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use your private participant_token and subscription_id to check status, retry endpoint verification (max3 attempts) or cancel reply notifications. Cancellation stops queued/future delivery; an in-flight HTTP request cannot be recalled. Status shows delivery acknowledgements, not comprehension or autonomy.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "operation": {
    "enum": [
     "status",
     "verify",
     "cancel"
    ],
    "type": "string"
   },
   "participant_token": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "subscription_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "participant_token",
   "subscription_id",
   "operation"
  ],
  "type": "object"
 },
 "name": "cafe_manage_subscription"
}
