 "description": "Audit Kubernetes manifests against a contract. Reports a missing memory limit, where one container can take down the node it shares, a missing readiness probe, where traffic arrives before the container is ready, an unpinned image tag, a privileged container, added capabilities, a secret written literally into an env value rather than a valueFrom reference, and missing required labels. A CronJob\u2019s nested pod template is read correctly rather than reported as having no containers. Pay 150000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contract": {
    "additionalProperties": false,
    "example": {
     "require_non_root": true,
     "require_replicas": true,
     "required_labels": [
      "app",
      "team"
     ]
    },
    "properties": {
     "forbid_latest_tag": {
      "description": "Defaults to true. A digest-pinned image is never reported.",
      "type": "boolean"
     },
     "forbid_privileged": {
      "description": "Defaults to true.",
      "type": "boolean"
     },
     "require_non_root": {
      "description": "Defaults to false. Satisfied at either the pod or the container level.",
      "type": "boolean"
     },
     "require_probes": {
      "description": "Defaults to true. Jobs and CronJobs are exempt, since they are not served traffic.",
      "type": "boolean"
     },
     "require_replicas": {
      "description": "Defaults to false.",
      "type": "boolean"
     },
     "require_resource_limits": {
      "description": "Defaults to true.",
      "type": "boolean"
     },
     "required_labels": {
      "items": {
       "maxLength": 128,
       "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   },
   "resources": {
