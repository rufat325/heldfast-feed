{
 "description": "Execute a request and return status, timing, headers, and a (truncated) body. Resolves {{variables}} from the active environment and the request's collection. Optionally capture the response as a saved example.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collection": {
    "description": "Collection name/id when sending a saved request.",
    "type": "string"
   },
   "request": {
    "additionalProperties": false,
    "description": "Inline request definition (alternative to collection+requestName).",
    "properties": {
     "auth": {
      "additionalProperties": false,
      "properties": {
       "apikey": {
        "additionalProperties": false,
        "properties": {
         "addTo": {
          "enum": [
           "header",
           "query"
          ],
          "type": "string"
         },
         "key": {
          "type": "string"
         },
         "value": {
          "type": "string"
         }
        },
        "required": [
         "key",
         "value",
         "addTo"
        ],
        "type": "object"
       },
       "basic": {
        "additionalProperties": false,
        "properties": {
         "password": {
          "type": "string"
         },
         "username": {
          "type": "string"
         }
        },
        "required": [
         "username",
         "password"
        ],
        "type": "object"
       },
       "bearer": {
        "additionalProperties": false,
        "properties": {
         "token": {
          "type": "string"
         }
        },
        "required": [
         "token"
        ],
        "type": "object"
       },
       "type": {
        "enum": [
         "none",
         "bearer",
         "basic",
         "apikey"
        ],
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     },
     "body": {
      "type": "string"
     },
     "bodyType": {
      "enum": [
       "json",
       "form",
       "text",
       "graphql",
       "multipart",
       "none"
      ],
      "type": "string"
     },
     "headers": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "method": {
      "enum": [
       "GET",
       "POST",
       "PUT",
       "PATCH",
       "DELETE",
       "OPTIONS",
       "HEAD"
      ],
      "type": "string"
     },
     "name": {
      "description": "Human-readable request name; also the upsert match key within a collection.",
      "type": "string"
     },
     "tests": {
      "description": "Assertions run automatically after send_request.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "expected": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "operator": {
         "enum": [
          "eq",
          "neq",
          "contains",
          "not_contains",
          "gt",
          "lt",
          "exists"
         ],
         "type": "string"
        },
        "property": {
         "type": "string"
        },
        "source": {
         "enum": [
          "status",
          "time",
          "body",
          "header",
          "jsonpath"
         ],
         "type": "string"
        }
       },
       "required": [
        "source",
        "operator",
        "expected"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "url": {
      "description": "Request URL. May contain {{variable}} placeholders resolved from the environment and collection.",
      "type": "string"
     }
    },
    "required": [
     "name",
     "method",
     "url"
    ],
    "type": "object"
   },
   "requestName": {
    "description": "Saved request name or id within the collection.",
    "type": "string"
   },
   "saveExample": {
    "description": "When set, capture the response as an example on the saved request. Pass a string to label it.",
    "type": [
     "boolean",
     "string"
    ]
   }
  },
  "type": "object"
 },
 "name": "send_request"
}
