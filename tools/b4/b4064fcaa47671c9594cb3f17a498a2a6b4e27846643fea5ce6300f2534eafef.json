{
 "description": "Read official Bubblemaps concentration and decentralization metrics for one token without rendering the full graph. Read-only. Requires BUBBLEMAPS_API_KEY.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "chain": {
    "enum": [
     "eth",
     "base",
     "solana",
     "tron",
     "bsc",
     "sonic",
     "ton",
     "avalanche",
     "polygon",
     "monad",
     "hyperevm",
     "arbitrum",
     "robinhood"
    ],
    "type": "string"
   },
   "tokenAddress": {
    "maxLength": 128,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "chain",
   "tokenAddress"
  ],
  "type": "object"
 },
 "name": "bubble_metrics"
}
