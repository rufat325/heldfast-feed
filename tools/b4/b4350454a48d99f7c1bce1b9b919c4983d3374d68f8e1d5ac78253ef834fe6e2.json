{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "wapiworld:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check message recording settings"
 },
 "description": "Use this when someone asks whether Wapiworld stores the text of WhatsApp messages for a number, or how long it keeps them. Returns whether recording is on for the instance, whether the default, project or instance decided it, any lock, and the project's retention in days. Not for reading recorded messages.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "instanceId": {
    "description": "Instance id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "instanceId"
  ],
  "type": "object"
 },
 "name": "get_message_recording_policy",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "policy": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "chatOverridesExcluded": {
        "const": true,
        "type": "boolean"
       },
       "decidedBy": {
        "enum": [
         "default",
         "project",
         "instance"
        ],
        "type": "string"
       },
       "enabled": {
        "type": "boolean"
       },
       "instanceId": {
        "pattern": "^[0-9a-f]{24}$",
        "type": "string"
       },
       "lockedBy": {
        "anyOf": [
         {
          "enum": [
           "project",
           "instance"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "projectId": {
        "pattern": "^[0-9a-f]{24}$",
        "type": "string"
       },
       "retentionDays": {
        "exclusiveMinimum": 0,
        "maximum": 365,
        "type": "integer"
       }
      },
      "required": [
       "instanceId",
       "projectId",
       "enabled",
       "decidedBy",
       "lockedBy",
       "retentionDays",
       "chatOverridesExcluded"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Instance default only; chat-level exceptions are excluded. Message bodies, previews, sender names, contact identifiers, chat override keys and WhatsApp message ids are never read."
   },
   "status": {
    "enum": [
     "found",
     "instance-not-found",
     "project-not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "policy"
  ],
  "type": "object"
 },
 "title": "Check message recording settings"
}
