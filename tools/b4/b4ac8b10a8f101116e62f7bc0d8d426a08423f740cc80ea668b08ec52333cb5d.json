{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "imagelato:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List resize presets"
 },
 "description": "Use this when someone asks which resize and format presets (templates) they have, optionally in one project. Returns each template's id, name, project, output formats and pixel widths, 25 per page by default. Not for the images processed with them.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page with the same filters; absent for the first page",
    "maxLength": 1024,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "limit": {
    "description": "Results per page, from 1 to 100; defaults to 25",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "description": "Only presets in this project; every project when absent",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_templates",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "formats": {
       "items": {
        "maxLength": 20,
        "type": "string"
       },
       "maxItems": 5,
       "type": "array"
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 120,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "projectId": {
       "$ref": "#/properties/items/items/properties/id"
      },
      "sizes": {
       "items": {
        "maxLength": 20,
        "type": "string"
       },
       "maxItems": 10,
       "type": "array"
      }
     },
     "required": [
      "id",
      "name",
      "projectId",
      "formats",
      "sizes"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 1024,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   },
   "total": {
    "description": "Matching records across all pages",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "items",
   "total",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List resize presets"
}
