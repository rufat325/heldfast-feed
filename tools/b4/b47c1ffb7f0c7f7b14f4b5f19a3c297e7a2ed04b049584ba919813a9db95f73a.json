{
 "description": "Write raw HTML content directly to file",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budget": {
    "additionalProperties": false,
    "properties": {
     "max_tokens": {
      "type": "number"
     }
    },
    "required": [
     "max_tokens"
    ],
    "type": "object"
   },
   "content": {
    "type": "string"
   },
   "html": {
    "type": "string"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "compression": {
      "enum": [
       "none",
       "low",
       "high",
       "ai"
      ],
      "type": "string"
     },
     "css_vars": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "inject_css": {
      "type": "string"
     },
     "inject_js": {
      "type": "string"
     },
     "line_width": {
      "type": "number"
     },
     "mode": {
      "enum": [
       "normal",
       "stream"
      ],
      "type": "string"
     },
     "skip_format": {
      "type": "boolean"
     },
     "theme": {
      "enum": [
       "dark",
       "light"
      ],
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "output_path": {
    "type": "string"
   },
   "template": {
    "type": "string"
   }
  },
  "required": [
   "output_path"
  ],
  "type": "object"
 },
 "name": "write_raw_html"
}
