 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "default": "teardown",
    "enum": [
     "pause",
     "resume",
     "teardown"
    ],
    "type": "string"
   },
   "deploymentId": {
    "type": "string"
   }
  },
  "required": [
   "deploymentId"
  ],
  "type": "object"
 },
 "name": "opentrain_deploy_teardown",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
