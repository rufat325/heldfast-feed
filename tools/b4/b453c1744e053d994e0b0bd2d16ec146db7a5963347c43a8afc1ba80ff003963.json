{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "wapiworld:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List WhatsApp numbers"
 },
 "description": "Use this when someone asks which WhatsApp numbers they have connected to Wapiworld, or which ones are offline. Returns each instance's id, name, WhatsApp account name, phone number, connection status and health, 25 per page by default, optionally for one project (no QR codes, secrets or API keys). Not for sending a message.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The page.nextCursor of the previous page with the same projectId; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Instances per page, from 1 to 100; defaults to 25",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "projectId": {
    "description": "Only this project",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_instances",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "instances": {
    "description": "Connected WhatsApp instances. health is ready, pairing, starting, offline or unknown. QR pairing codes, instance secrets, API keys, proxy data and arbitrary stored fields are never returned.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "accountName": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "health": {
       "enum": [
        "ready",
        "pairing",
        "starting",
        "offline",
        "unknown"
       ],
       "type": "string"
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "lastEditTime": {
       "$ref": "#/properties/instances/items/properties/creationTime"
      },
      "name": {
       "maxLength": 200,
       "type": "string"
      },
      "phone": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "projectId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "anyOf": [
        {
         "enum": [
          "starting",
          "qrcode",
          "ready",
          "logged_out",
          "not_connected",
          "disconnected",
          "offline",
          "STARTING",
          "QRCODE",
          "READY"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "accountName",
      "status",
      "health",
      "phone",
      "projectId",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "page": {
    "additionalProperties": false,
    "description": "Pass nextCursor as cursor, with the same filters, for the next page; null on the last page",
    "properties": {
     "count": {
      "minimum": 0,
      "type": "integer"
     },
     "hasMore": {
      "type": "boolean"
     },
     "nextCursor": {
      "anyOf": [
       {
        "maxLength": 4096,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "count",
     "hasMore",
     "nextCursor"
    ],
    "type": "object"
   }
  },
  "required": [
   "instances",
   "page"
  ],
  "type": "object"
 },
 "title": "List WhatsApp numbers"
}
