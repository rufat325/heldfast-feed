{
 "description": "Translates and optimizes informal text into formal, audience-specific technical specifications.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "audience": {
    "description": "Target audience",
    "enum": [
     "Junior Dev",
     "Senior Dev",
     "Tech Lead",
     "SRE",
     "Data Engineer"
    ],
    "type": "string"
   },
   "context": {
    "description": "Tech context",
    "enum": [
     "Backend",
     "Frontend",
     "Mobile",
     "Data/ML",
     "DevOps"
    ],
    "type": "string"
   },
   "contextProjectId": {
    "description": "Ground generation on a Context Project's instructions/assets",
    "type": "string"
   },
   "customInstructions": {
    "description": "Optional custom instructions",
    "type": "string"
   },
   "format": {
    "description": "Output format",
    "enum": [
     "Technical Spec",
     "Jira Tickets",
     "API Design",
     "RFC",
     "Data Model",
     "Prompt",
     "Optimize"
    ],
    "type": "string"
   },
   "input": {
    "description": "Input text (min 10 chars)",
    "minLength": 10,
    "type": "string"
   },
   "managedModel": {
    "description": "Pin a specific managed model (server-side allowlist)",
    "type": "string"
   },
   "responseFormat": {
    "description": "Output structure: prose Markdown, or machine-readable XML",
    "enum": [
     "markdown",
     "xml"
    ],
    "type": "string"
   },
   "tone": {
    "description": "Tone (0=Concise, 100=Detailed)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "webSearch": {
    "description": "Ground generation with real-time web search",
    "type": "boolean"
   }
  },
  "required": [
   "input",
   "audience",
   "context",
   "format",
   "tone"
  ],
  "type": "object"
 },
 "name": "translate_text"
}
