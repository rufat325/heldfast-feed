{
 "_meta": {
  "openai/outputTemplate": "ui://widget/app-upload.html",
  "openai/toolInvocation/invoked": "App upload completed",
  "openai/toolInvocation/invoking": "Uploading app to LambdaTest...",
  "openai/widgetAccessible": true
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Uploads an app to LambdaTest for mobile testing and displays upload status.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "appFilePath": {
    "description": "Absolute path to the app file (APK, IPA, etc.). Provide this OR appUrl (exactly one is required).",
    "type": "string"
   },
   "appUrl": {
    "description": "URL of the app to upload. Provide this OR appFilePath (exactly one is required).",
    "type": "string"
   },
   "customId": {
    "description": "Custom ID for the app (optional)",
    "type": "string"
   },
   "name": {
    "description": "Name for the uploaded app",
    "type": "string"
   },
   "visibility": {
    "description": "Visibility setting (optional, default: individual)",
    "enum": [
     "individual",
     "team",
     "organization"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "upload_app",
 "outputSchema": {
  "properties": {
   "appId": {
    "description": "The app ID",
    "type": "string"
   },
   "appUrl": {
    "description": "The URL of the uploaded app to use in capabilities",
    "type": "string"
   },
   "error": {
    "description": "Error message if upload failed",
    "type": "string"
   },
   "message": {
    "description": "Status message",
    "type": "string"
   },
   "success": {
    "description": "Whether the upload was successful",
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "message"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Upload App to LambdaTest"
}
