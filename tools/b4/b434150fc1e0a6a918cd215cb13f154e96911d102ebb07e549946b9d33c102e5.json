 },
 "description": "The top ranked agents (L7 and above: a bound wallet was seen paying money out of the agent's control after registration). Sorted by level first (L9, then L8, then L7), then by lifetime counted USD; sort_by changes the second key to distinct counterparties or number of payments. A high place means a large counted spender at that level, not a working service: read agent_record before relying on one. Free tier: up to 25.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "min_level": {
    "description": "Only agents at or above this liveness level",
    "maximum": 9,
    "minimum": 7,
    "type": "integer"
   },
   "sort_by": {
    "default": "usd",
    "description": "Order within each level: lifetime counted USD (default), distinct counterparties, or number of counted payments",
    "enum": [
     "usd",
     "counterparties",
     "payments"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ranked_agents",
 "outputSchema": {
  "properties": {
   "agents": {
    "items": {
     "properties": {
      "declared_name": {
