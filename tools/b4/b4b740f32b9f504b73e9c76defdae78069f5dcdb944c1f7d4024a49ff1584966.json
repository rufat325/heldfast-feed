    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 },
 "description": "SetMark records the mark itself and what the applicant sells.",
 "inputSchema": {
  "properties": {
   "applicationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "businessDescription": {
    "description": "Free-form description (max 5000 chars).",
    "properties": {
     "value": {
      "maxLength": 5000,
      "type": "string"
     }
    },
    "type": "object"
   },
   "designDescription": {
    "description": "Free-form description (max 5000 chars).",
    "properties": {
     "value": {
      "maxLength": 5000,
      "type": "string"
     }
    },
    "type": "object"
   },
   "markType": {
    "enum": [
     "MARK_TYPE_STANDARD_CHARACTER",
     "MARK_TYPE_DESIGN",
     "MARK_TYPE_COMPOSITE"
    ],
    "type": "string"
   },
   "website": {
    "maxLength": 500,
    "pattern": "^$|^https?://[^\\s]+$",
    "type": "string"
   },
   "wordmark": {
    "description": "Human-readable name (1-255 Unicode chars).",
    "properties": {
     "value": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "applicationId"
  ],
  "type": "object"
 },
 "name": "trademark_set_mark",
 "outputSchema": {
  "properties": {},
  "type": "object"
 },
 "title": "Set Mark"
}
