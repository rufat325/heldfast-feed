  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Add container to tracking"
 },
 "description": "Start tracking a new container or Bill of Lading. Returns confirmation once tracking is set up. First status update arrives within 15 minutes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "identifier": {
    "description": "Container number (e.g. MRKU5004867) or B/L number",
    "type": "string"
   },
   "identifier_type": {
    "description": "Whether the identifier is a container number or B/L number",
    "enum": [
     "container_id",
     "bill_of_lading"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Optional tags for organisation (e.g. [\"client-acme\", \"vessel-gulsun\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "identifier",
   "identifier_type"
  ],
  "type": "object"
 },
 "name": "add_container",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "On an empty result: NOT_FOUND (no record after asking) or NO_EVENTS (record, nothing filed).",
    "type": "string"
   },
   "data": {
    "additionalProperties": true,
    "properties": {
     "bl_number": {
      "type": [
       "string",
       "null"
      ]
     },
     "container_number": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "description": "The tracked reference that was created",
      "type": [
       "string",
       "null"
      ]
     },
     "message": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "message": {
    "description": "On an empty result: what the emptiness means.",
    "type": "string"
   },
   "ok": {
    "description": "False never appears here \u2014 failures arrive as tool errors.",
    "type": "boolean"
   },
   "result": {
    "description": "\"empty\" means the query succeeded and there is nothing to report.",
    "enum": [
     "data",
     "empty"
    ],
    "type": "string"
   }
