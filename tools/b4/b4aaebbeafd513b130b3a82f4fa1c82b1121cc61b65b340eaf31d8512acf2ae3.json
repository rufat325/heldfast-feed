  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {},
  "type": "object"
 },
 "name": "otto_submit_under_delegation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
