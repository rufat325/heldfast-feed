      "const": 5000,
      "type": "number"
     },
     "policy_id": {
      "type": "string"
     },
     "policy_name": {
      "type": "string"
     },
     "rules_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "user_cap_usd": {
      "maximum": 5000,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
