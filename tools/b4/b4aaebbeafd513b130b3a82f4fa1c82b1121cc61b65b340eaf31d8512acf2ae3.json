     "policy_name",
     "rules_digest",
     "per_swap_cap_usd",
     "user_cap_usd"
    ],
    "type": "object"
   },
   "replayed": {
    "type": "boolean"
   },
   "status": {
    "const": "sent",
    "type": "string"
   },
   "steps": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "block_number": {
       "pattern": "^\\d+$",
       "type": "string"
      },
      "gas_used": {
       "pattern": "^\\d+$",
       "type": "string"
      },
      "index": {
       "maximum": 2,
       "minimum": 0,
       "type": "integer"
      },
      "kind": {
       "enum": [
        "approve_reset",
        "approve",
        "call"
       ],
       "type": "string"
      },
      "status": {
       "const": "success",
       "type": "string"
      },
      "to": {
       "pattern": "^0x[0-9a-fA-F]{40}$",
       "type": "string"
      },
      "transaction_hash": {
       "pattern": "^0x[0-9a-fA-F]{64}$",
       "type": "string"
      }
     },
     "required": [
