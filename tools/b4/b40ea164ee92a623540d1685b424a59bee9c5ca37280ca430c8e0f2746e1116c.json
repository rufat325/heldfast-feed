{
 "_meta": {
  "ui": {
   "resourceUri": "ui://swsd/comment-thread.html"
  },
  "ui/resourceUri": "ui://swsd/comment-thread.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List comments on a SWSD incident. Returns id, body, is_private, author_email, author_name, created_at. Use swsd_add_incident_comment to add a new comment.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "incident_id": {
    "description": "SWSD incident reference. Accepts either the internal id (>=7 digits, e.g. 180457930) or the human-facing number (<=6 digits, e.g. 60310). The handler auto-detects via digit count.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number (1-indexed).",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "default": 25,
    "description": "Results per page (1-100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "incident_id"
  ],
  "type": "object"
 },
 "name": "swsd_list_incident_comments",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "comments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author_email": {
       "type": "string"
      },
      "author_name": {
       "type": "string"
      },
      "body": {
       "type": "string"
      },
      "created_at": {
       "type": "string"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "is_private": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "body",
      "is_private"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "incident_id": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "pagination": {
    "additionalProperties": false,
    "properties": {
     "has_more": {
      "description": "True when more pages exist beyond this one.",
      "type": "boolean"
     },
     "next_page": {
      "description": "The next page number to request, when has_more is true.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "page": {
      "description": "Current page (1-indexed).",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "per_page": {
      "description": "Items per page used in the request.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total": {
      "description": "Total record count when SWSD returns X-Total-Count.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "page",
     "per_page",
     "has_more"
    ],
    "type": "object"
   }
  },
  "required": [
   "comments",
   "pagination",
   "incident_id"
  ],
  "type": "object"
 }
}
