{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:ads"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Send conversion events"
 },
 "description": "Send conversion events. Spending/deletion: preview, then owner-approved confirm:true with the same requestId. Other edits: one call. Creates request active; report returned status and claim live only when active. Full field guide: soclo://tools/soclo_ads_send_conversions.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "type": "object"
   },
   "payload": {
    "properties": {
     "consent": {
      "properties": {
       "adPersonalization": {
        "enum": [
         "GRANTED",
         "DENIED"
        ],
        "type": "string"
       },
       "adUserData": {
        "enum": [
         "GRANTED",
         "DENIED"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "destinationId": {
      "type": "string"
     },
     "events": {
      "items": {
       "properties": {
        "actionSource": {
         "enum": [
          "web",
          "app",
          "offline",
          "crm",
          "phone_call",
          "system_generated"
         ],
         "type": "string"
        },
        "currency": {
         "description": "ISO 4217 currency code.",
         "type": "string"
        },
        "eventId": {
         "type": "string"
        },
        "eventName": {
         "type": "string"
        },
        "eventTime": {
         "description": "When the conversion happened, in unix seconds.",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "items": {
         "description": "Item-level detail for ecommerce events.",
         "items": {
          "properties": {
           "category": {
            "type": "string"
           },
           "id": {
            "type": "string"
           },
           "name": {
            "type": "string"
           },
           "price": {
            "type": "number"
           },
           "quantity": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        "platformData": {
         "type": "object"
        },
        "sourceUrl": {
         "description": "URL where the conversion originated (used by Meta).",
         "type": "string"
        },
        "user": {
         "description": "User identity fields. More signals mean higher match rates.",
         "properties": {
          "city": {
           "type": "string"
          },
          "clickIds": {
           "properties": {
            "epik": {
             "type": "string"
            },
            "fbc": {
             "description": "Meta click ID (from fbclid URL param).",
             "type": "string"
            },
            "fbp": {
             "description": "Meta browser ID (_fbp cookie).",
             "type": "string"
            },
            "gbraid": {
             "description": "Google iOS 14.5+ app attribution ID.",
             "type": "string"
            },
            "gclid": {
             "description": "Google click ID (from gclid URL param).",
             "type": "string"
            },
            "li_fat_id": {
             "type": "string"
            },
            "wbraid": {
             "description": "Google iOS 14.5+ web-to-app attribution ID.",
             "type": "string"
            }
           },
           "type": "object"
          },
          "country": {
           "description": "ISO 3166-1 alpha-2 country code, e.g. 'us'.",
           "type": "string"
          },
          "dob": {
           "type": "string"
          },
          "email": {
           "description": "Plaintext email. Hashed server-side.",
           "type": "string"
          },
          "externalId": {
           "type": "string"
          },
          "firstName": {
           "description": "Plaintext first name. Hashed server-side.",
           "type": "string"
          },
          "gender": {
           "type": "string"
          },
          "ipAddress": {
           "description": "Client IP address. Sent plaintext.",
           "type": "string"
          },
          "lastName": {
           "description": "Plaintext last name. Hashed server-side.",
           "type": "string"
          },
          "leadId": {
           "type": "string"
          },
          "phone": {
           "description": "Phone number, ideally E.164. Hashed server-side.",
           "type": "string"
          },
          "state": {
           "type": "string"
          },
          "userAgent": {
           "description": "Client user-agent string. Sent plaintext.",
           "type": "string"
          },
          "zip": {
           "type": "string"
          }
         },
         "type": "object"
        },
        "value": {
         "description": "Conversion value in the specified currency.",
         "type": "number"
        }
       },
       "required": [
        "eventName",
        "eventTime",
        "eventId",
        "user"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "testCode": {
      "type": "string"
     }
    },
    "required": [
     "destinationId",
     "events"
    ],
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "payload"
  ],
  "type": "object"
 },
 "name": "soclo_ads_send_conversions",
 "title": "Send conversion events"
}
