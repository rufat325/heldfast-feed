 "description": "\u3010\u9700\u8981\u767b\u5f55\u00b7\u4e3b\u529e\u65b9\u3011open\u5f00\u653e\uff0clock\u51bb\u7ed3\u5f53\u524d\u7968\u6c60\uff0cdraw\u968f\u673a\u62bdprizeId\uff0creview\u6838\u9a8cdrawId\uff0cclaim\u6838\u9500\uff0ccomplete\u7ed3\u675f\u5e76\u516c\u5f00\u79cd\u5b50\uff08\u4e0d\u53ef\u91cd\u5f00\uff09\u3002\u9ed8\u8ba4\u9884\u89c8\uff1b\u786e\u8ba4\u540c\u53c2+previewHash\u3001consent=true\u3001preview=false\u3002requestId\u539f\u6837\u91cd\u8bd5\uff0c\u4e0d\u6362id\u91cd\u62bd\uff1b\u6838\u9a8c\u987b\u7528\u6237\u4eb2\u81ea\u5728App\u770b\u8bc1\u636e\u4e14evidenceReviewedByUser=true\uff0c\u5151\u5956\u987b\u7528\u6237\u63d0\u4f9bclaimCode\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "open",
     "lock",
     "draw",
     "review",
     "claim",
     "complete"
    ],
    "type": "string"
   },
   "activityRef": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "claimCode": {
    "maxLength": 64,
    "type": "string"
   },
   "consent": {
    "const": true,
    "type": "boolean"
   },
   "decision": {
    "enum": [
     "approve",
     "reject"
    ],
    "type": "string"
   },
   "drawId": {
    "$ref": "#/properties/activityRef"
   },
   "evidenceReviewedByUser": {
    "const": true,
    "type": "boolean"
   },
   "preview": {
    "default": true,
    "type": "boolean"
   },
   "previewHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "prizeId": {
    "$ref": "#/properties/activityRef"
   },
   "reason": {
    "maxLength": 300,
    "type": "string"
   },
   "requestId": {
    "pattern": "^[a-zA-Z0-9_-]{8,100}$",
    "type": "string"
   }
  },
  "required": [
   "activityRef",
   "action",
   "requestId"
  ],
  "type": "object"
 },
 "name": "act_activity_raffle",
 "title": "\u4e3b\u6301\u62bd\u5956\u4e0e\u9886\u5956\u6838\u9500"
