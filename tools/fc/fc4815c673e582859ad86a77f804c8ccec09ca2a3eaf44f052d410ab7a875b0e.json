{
 "description": "Report a malicious wallet address to the AgentRadar scam database. Requires operator key. Include chain, severity level, source of intel, and optional notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "chain": {
    "type": "string"
   },
   "notes": {
    "type": "string"
   },
   "severity": {
    "type": "string"
   },
   "source": {
    "type": "string"
   }
  },
  "required": [
   "address",
   "chain",
   "severity",
   "source"
  ],
  "type": "object"
 },
 "name": "add_scam_wallet"
}
