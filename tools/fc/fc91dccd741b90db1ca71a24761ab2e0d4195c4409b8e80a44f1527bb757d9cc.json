{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "postlyra:drafts:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use this when requesting a saved draft screenshot, public browser preview or validation warnings. Find draftId with search_post_drafts. Returns documentJson/richHtml, JPEG and enables a public preview link. Use show_post_card for an in-chat card. Follow display.instruction; check screenshot.truncated and retry unavailable screenshots without recreating the draft. May fetch external image URLs for screenshot rendering. Never publishes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "draftId": {
    "type": "string"
   }
  },
  "required": [
   "draftId"
  ],
  "type": "object"
 },
 "name": "preview_post",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "display": {
    "additionalProperties": false,
    "properties": {
     "imageContentIndex": {
      "description": "Index of the native image in this response's content array; null when unavailable.",
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "imageMarkdown": {
      "description": "Ready-to-use inline image Markdown for the final answer where the host permits remote images. Preserve the leading !.",
      "type": [
       "string",
       "null"
      ]
     },
     "instruction": {
      "description": "How to include the screenshot in the final user-facing answer; a tool-only image or ordinary link is insufficient.",
      "type": "string"
     },
     "linkMarkdown": {
      "description": "Interactive preview link to place after the image in the final answer.",
      "type": [
       "string",
       "null"
      ]
     },
     "suggestedFileName": {
      "description": "Filename suggestion for a host-supported attachment made from the returned bytes; not an existing local path.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "instruction",
     "imageContentIndex",
     "suggestedFileName",
     "imageMarkdown",
     "linkMarkdown"
    ],
    "type": "object"
   },
   "documentJson": {
    "type": "object"
   },
   "draftId": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "inlineButtons": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "locale": {
    "enum": [
     "ru",
     "en"
    ],
    "type": "string"
   },
   "message": {
    "maxLength": 1000,
    "type": "string"
   },
   "previewUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "richHtml": {
    "type": "string"
   },
   "screenshot": {
    "additionalProperties": false,
    "properties": {
     "capturedAt": {
      "type": "string"
     },
     "height": {
      "type": "integer"
     },
     "mimeType": {
      "enum": [
       "image/jpeg"
      ],
      "type": "string"
     },
     "nextAction": {
      "type": "string"
     },
     "retryable": {
      "type": "boolean"
     },
     "status": {
      "enum": [
       "ready",
       "unavailable"
      ],
      "type": "string"
     },
     "truncated": {
      "type": "boolean"
     },
     "url": {
      "type": "string"
     },
     "warnings": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "width": {
      "type": "integer"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "screenshotUrl": {
    "description": "JPEG screenshot of the saved Telegram preview; null if rendering is temporarily unavailable.",
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "maxLength": 64,
    "type": "string"
   },
   "telegramElements": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "text": {
    "maxLength": 4000,
    "type": "string"
   },
   "title": {
    "maxLength": 500,
    "type": "string"
   },
   "updatedAt": {
    "type": "string"
   },
   "validation": {
    "type": "object"
   },
   "warnings": {
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "message",
   "draftId",
   "warnings",
   "validation"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "postlyra:drafts:write"
   ],
