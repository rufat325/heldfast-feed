{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Recommendations from a Steam library"
 },
 "description": "Steam games for a player, ranked against their own public Steam library (what they play most), the way imho.run's library mode does it; owned games are left out. Use it when the user gives their Steam profile and wants picks for their taste in general; for 'games like X' use games_like or recommend. Takes a SteamID64 or a steamcommunity.com/profiles/<SteamID64> link (not a custom /id/ name) and works only for public profiles imho.run already has; otherwise it returns one 'unavailable' error with a link the user can open to paste their profile. Each pick names the most-played game it is closest to (`similar_to`). Games rated for adults only (explicit sexual content) are not covered; filtering is best effort.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "filters": {
    "additionalProperties": false,
    "description": "All optional, same meaning as in recommend.",
    "properties": {
     "coop": {
      "type": "boolean"
     },
     "coop_mode": {
      "enum": [
       "online",
       "local",
       "any"
      ],
      "type": "string"
     },
     "deck": {
      "enum": [
       "verified",
       "playable"
      ],
      "type": "string"
     },
     "exclude": {
      "items": {
       "enum": [
        "pvp",
        "microtransactions",
        "hard",
        "grind",
        "early_access",
        "vr_only"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "free": {
      "type": "boolean"
     },
     "year_max": {
      "maximum": 2100,
      "minimum": 1970,
      "type": "integer"
     },
     "year_min": {
      "maximum": 2100,
      "minimum": 1970,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "lang": {
    "default": "en",
    "description": "Language of the `why` lines.",
    "enum": [
     "en",
     "ru"
    ],
    "type": "string"
   },
   "n": {
    "default": 10,
    "maximum": 24,
    "minimum": 1,
    "type": "integer"
   },
   "profile": {
    "description": "SteamID64 or steamcommunity.com/profiles/<SteamID64> link.",
    "maxLength": 200,
    "minLength": 17,
    "type": "string"
   }
  },
  "required": [
   "profile"
  ],
  "type": "object"
 },
 "name": "library_recs",
 "outputSchema": {
  "properties": {
   "attribution": {
    "title": "Attribution",
    "type": "string"
   },
   "based_on": {
    "description": "The profile's most-played games the reasons refer to.",
    "items": {
     "properties": {
      "appid": {
       "title": "Appid",
       "type": "integer"
      },
      "name": {
       "title": "Name",
       "type": "string"
      },
      "url": {
       "title": "Url",
       "type": "string"
      }
     },
     "required": [
      "appid",
      "name",
      "url"
     ],
     "title": "AgentLibraryAnchor",
     "type": "object"
    },
    "title": "Based On",
    "type": "array"
   },
   "filters": {
    "properties": {
     "coop": {
      "default": false,
      "title": "Coop",
      "type": "boolean"
     },
     "coop_mode": {
      "anyOf": [
       {
        "enum": [
         "online",
         "local"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Coop Mode"
     },
     "deck": {
      "anyOf": [
       {
        "enum": [
         "verified",
         "playable"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Deck"
     },
     "exclude": {
      "items": {
       "enum": [
        "pvp",
        "microtransactions",
        "hard",
        "grind",
        "early_access",
        "vr_only"
       ],
       "type": "string"
      },
      "title": "Exclude",
      "type": "array"
     },
     "exclude_tags": {
      "items": {
       "type": "string"
      },
      "title": "Exclude Tags",
      "type": "array"
     },
     "free": {
      "default": false,
      "title": "Free",
      "type": "boolean"
     },
     "popularity_bias": {
      "default": 0.0,
      "title": "Popularity Bias",
      "type": "number"
     },
     "year_max": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "This year by default (no unreleased games), as on the site.",
      "title": "Year Max"
     },
     "year_min": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Year Min"
     }
    },
    "title": "AgentRecFilters",
    "type": "object"
   },
   "generated_at": {
    "title": "Generated At",
    "type": "string"
   },
   "lang": {
    "enum": [
     "en",
     "ru"
    ],
    "title": "Lang",
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "appid": {
       "title": "Appid",
       "type": "integer"
      },
      "genres": {
       "items": {
        "type": "string"
       },
       "title": "Genres",
       "type": "array"
      },
      "name": {
       "title": "Name",
       "type": "string"
      },
      "price": {
       "properties": {
        "amount": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ],
         "default": null,
         "description": "Price as last scraped from the US Steam store.",
         "title": "Amount"
        },
        "currency": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null,
         "title": "Currency"
        },
        "is_free": {
         "title": "Is Free",
         "type": "boolean"
        },
        "text": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "default": null,
         "description": "\"Free\", \"29.99 USD\" or null when unknown.",
         "title": "Text"
        }
       },
       "required": [
        "is_free"
       ],
       "title": "AgentPrice",
       "type": "object"
      },
      "rank": {
       "title": "Rank",
       "type": "integer"
      },
      "reviews": {
       "anyOf": [
        {
         "properties": {
          "positive_pct": {
           "description": "Share of positive Steam reviews, 0-100.",
           "title": "Positive Pct",
           "type": "integer"
          },
          "total": {
           "description": "Steam user reviews.",
           "title": "Total",
           "type": "integer"
          }
         },
         "required": [
          "total",
          "positive_pct"
         ],
         "title": "AgentReviews",
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "similar_to": {
       "description": "appid of the seed this pick is closest to; `why` names that seed.",
       "title": "Similar To",
       "type": "integer"
      },
      "steam_deck": {
       "enum": [
        "verified",
        "playable",
        "unsupported",
        "unknown"
       ],
       "title": "Steam Deck",
       "type": "string"
      },
      "steam_url": {
       "title": "Steam Url",
       "type": "string"
      },
      "url": {
       "description": "Link this when you mention the game: its page on imho.run.",
       "title": "Url",
       "type": "string"
      },
      "why": {
       "description": "One short sentence: why this game is like the seed.",
       "title": "Why",
       "type": "string"
      },
      "year": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Year"
      }
     },
     "required": [
      "rank",
      "appid",
      "name",
      "url",
      "steam_url",
      "why",
      "price",
      "steam_deck",
      "similar_to"
     ],
     "title": "AgentRecPick",
     "type": "object"
    },
    "title": "Results",
    "type": "array"
   },
   "source": {
    "title": "Source",
    "type": "string"
   },
   "tool_url": {
    "description": "imho.run's library mode, where the user can paste the link.",
    "title": "Tool Url",
    "type": "string"
   }
  },
  "required": [
   "source",
   "attribution",
   "lang",
   "filters",
   "tool_url",
   "results",
   "generated_at"
  ],
  "title": "LibraryRecsResponse",
  "type": "object"
 },
 "title": "Recommendations from a Steam library"
}
