{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Pause new server command dispatch and suspend credentials confined to this server. Apps and commands already dispatched may continue. Heartbeats remain active. Requires unrestricted account credentials with manage scope and explicit human confirmation (confirm=true).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "pattern": "^agt_[a-f0-9]{16,24}$",
    "type": "string"
   },
   "confirm": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "agent_id",
   "confirm"
  ],
  "type": "object"
 },
 "name": "impreza_pause_agent",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "agent_id": {
      "type": "string"
     },
     "paused": {
      "type": "boolean"
     },
     "status": {
      "enum": [
       "pending",
       "online",
       "offline",
       "draining"
      ],
      "type": "string"
     }
    },
    "required": [
     "agent_id",
     "status",
     "paused"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Pause agent"
}
