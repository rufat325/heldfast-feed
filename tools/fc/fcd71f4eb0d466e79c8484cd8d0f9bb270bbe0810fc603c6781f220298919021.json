{
 "description": "Find references or implementations of a symbol. Accepts symbol name (via prior locate) or file:line:col position.",
 "inputSchema": {
  "properties": {
   "character": {
    "description": "0-based character offset",
    "type": "number"
   },
   "file": {
    "description": "File path containing the symbol",
    "type": "string"
   },
   "implementations": {
    "description": "Find implementations instead of references",
    "type": "boolean"
   },
   "include_declaration": {
    "description": "Include declaration in references (default true)",
    "type": "boolean"
   },
   "limit": {
    "description": "Max results (default 50)",
    "type": "number"
   },
   "line": {
    "description": "0-based line number",
    "type": "number"
   },
   "position": {
    "description": "Alternative: path:line:col (1-based line/col)",
    "type": "string"
   }
  },
  "required": [
   "file"
  ],
  "type": "object"
 },
 "name": "refs"
}
