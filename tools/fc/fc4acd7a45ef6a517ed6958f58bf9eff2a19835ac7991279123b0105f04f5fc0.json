{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"Apply the same edits to one template PDF once per record, producing one output document per record \u2014 a mail merge over an existing PDF. Returns a `job_id`: call `pdf_job` with it for the per-record results. To change text on one page only, set `scope.pages`; to pick one of several identical matches, use `scope.after` with nearby text or `scope.occurrence`. Use `op: 'redact'` when the text must be unrecoverable.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"edits":{"description":"The edits applied to each record, with `{field}` placeholders filled from it.","items":{"additionalProperties":false,"properties":{"at":{"anyOf":[{"additionalProperties":false,"properties":{"after":{"description":"Anchor text to insert after; the first occurrence on the page wins, and the style is inherited from it.","type":["string","null"]},"page":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"placement":{"description":"With `after`: 'inline' writes one space past the anchor's right edge on its own baseline; 'below' writes at the anchor line's left edge, one leading down. (default: \"inline\")","enum":["inline","below"],"type":"string"},"units":{"description":"(default: \"pt\")","enum":["pt","fraction"],"type":"string"},"x":{"description":"Baseline origin x. Points from the page's left edge, or a fraction of the page width when units='fraction'.","type":["number","null"]},"y":{"description":"Baseline origin y: where the first line sits, measured from the page's TOP edge (PDF viewer convention, as every bbox and span origin in this API). A fraction of the page height when units='fraction'.","type":["number","null"]}},"required":["page"],"type":"object"},{"type":"null"}]},"box":{"anyOf":[{"additionalProperties":false,"properties":{"h":{"description":"Height in points.","maximum":14400,"t