"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}]},"pages":{"anyOf":[{"type":"string"},{"items":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"type":"array"}],"description":"(default: \"all\")"},"region":{"anyOf":[{"additionalProperties":false,"properties":{"units":{"description":"(default: \"fraction\")","enum":["fraction","pt"],"type":"string"},"x0":{"type":"number"},"x1":{"type":"number"},"y0":{"type":"number"},"y1":{"type":"number"}},"required":["x0","x1","y0","y1"],"type":"object"},{"type":"null"}]},"span_ids":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}]}},"type":"object"},"style":{"anyOf":[{"additionalProperties":false,"properties":{"color":{"anyOf":[{"pattern":"^#[0-9a-fA-F]{6}$","type":"string"},{"type":"null"}]},"font":{"type":["string","null"]},"size":{"anyOf":[{"maximum":200,"minimum":1,"type":"number"},{"type":"null"}]}},"type":"object"},{"type":"null"}]},"text":{"type":["string","null"]}},"type":"object"},"maxItems":200,"minItems":1,"type":"array"},"file":{"description":"The PDF: an absolute (or ~) local path, which this server uploads for you, an https:// URL the API fetches, or an `f_\u2026` file id from an earlier call. Used as the template for every record.","minLength":1,"type":"string"},"options":{"additionalProperties":false,"properties":{"async":{"description":"(default: false)","type":"boolean"},"atomic":{"description":"(default: true)","type":"boolean"},"break_signature":{"description":"(default: false)","type":"boolean"},"collateral_threshold":{"description":"(default: 8)","maximum":9007199254740991,"minimum":0,"type":"integer"},"dry_run":{"description":"(default: false)","type":"boolean"},"fail_fast":{"description":"(default: false)","type":"boolean"},"filename":{"type":["string","null"]},"font":{"additionalProperties":false,"properties":{"policy":{"description":"(default: \"auto\")","enum":["auto","metric_only","exact_only"],"type":"string"}},"type":"object"},"ocr":{"de