{
 "_meta": {
  "group": "tickets"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search tickets by company, board, status, summary text, or assigned member. Covers SERVICE and PROJECT tickets \u2014 ConnectWise keeps them apart, and ticket_type picks which. Defaults to open tickets only. Returns ticket ids for use with cw_get_ticket / cw_add_ticket_note / cw_create_time_entry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assigned_to": {
    "description": "Member identifier assigned to the ticket",
    "type": "string"
   },
   "board": {
    "description": "Service board name (e.g. \"Help Desk\")",
    "type": "string"
   },
   "company_id": {
    "description": "Filter by company ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "company_name": {
    "description": "Filter by exact company name",
    "type": "string"
   },
   "open_only": {
    "default": true,
    "description": "Only tickets that are not closed (default true)",
    "type": "boolean"
   },
   "page_number": {
    "default": 1,
    "description": "Page number (default 1)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "page_size": {
    "default": 25,
    "description": "Results per page (default 25, max 1000)",
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "integer"
   },
   "response_format": {
    "default": "markdown",
    "description": "Output format: human-readable markdown (default) or structured JSON",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "status": {
    "description": "Status name (e.g. \"New\", \"In Progress\")",
    "type": "string"
   },
   "summary_contains": {
    "description": "Text the ticket summary contains",
    "type": "string"
   },
   "ticket_type": {
    "default": "both",
    "description": "Which tickets to include: service, project, or both (default both)",
    "enum": [
     "both",
     "service",
     "project"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "cw_search_tickets",
 "title": "Search ConnectWise Tickets"
}
