 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update a person's signature details"
 },
 "description": "Change one field (name, title or phone) of a person's signature in the company. A joined member gets an email with their updated signature; for someone still invited, the invitation is sent again with the new details. Company owners only.",
 "inputSchema": {
  "properties": {
   "company": {
    "description": "The company slug (as in its Signatoro URL) or its id.",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "email": {
    "description": "The person's email address.",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "field": {
    "description": "Which detail to change.",
    "enum": [
     "name",
     "title",
     "phone"
    ],
    "type": "string"
   },
   "value": {
    "description": "The new value. Empty clears it.",
    "maxLength": 120,
    "type": "string"
   }
  },
  "required": [
   "company",
   "email",
   "field",
   "value"
  ],
  "type": "object"
 },
 "name": "update_member_field",
 "securitySchemes": [
