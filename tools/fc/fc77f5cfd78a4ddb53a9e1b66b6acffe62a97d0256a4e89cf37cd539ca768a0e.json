{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Build an order link"},"description":"Checks that the given dishes can be ordered now in those quantities (stock, cutoff, quantity rules, one shared pickup time) and returns a link to the kitchen's own storefront with them already in the cart. It does not place an order or take payment: the customer reviews and submits the order request on the storefront, and the cook confirms it.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"items":{"items":{"additionalProperties":false,"properties":{"dish_id":{"description":"An offer id from get_menu or search_kitchens","maxLength":200,"minLength":1,"type":"string"},"quantity":{"maximum":99,"minimum":1,"type":"integer"}},"required":["dish_id","quantity"],"type":"object"},"maxItems":20,"minItems":1,"type":"array"},"kitchen":{"description":"Kitchen slug or storefront link, e.g. \"stephanie-s-bite-of-heaven\" or \"https://app.stovefront.com/<slug>\"","maxLength":300,"minLength":1,"type":"string"}},"required":["kitchen","items"],"type":"object"},"name":"build_order_link","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"currency":{"const":"USD","type":"string"},"estimatedSubtotalCents":{"anyOf":[{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},{"type":"null"}],"description":"Before any delivery fee"},"instruction":{"type":"string"},"items":{"items":{"additionalProperties":false,"properties":{"dish_id":{"type":"string"},"kind":{"enum":["dish","package"],"type":"string"},"lineTotalCents":{"anyOf":[{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},{"type":"null"}]},"name":{"type":"string"},"quantity":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"unitPriceCents":{"anyOf":[{"maximum":9007199254740991,"minimum":-900719