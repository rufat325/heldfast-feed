 "description": "Resolve a company, compare supported claims with current company evidence, preserve a proof record, and optionally monitor verified claims for change. This call consumes normal CompanyProof claim credits and writes to the account evidence ledger.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "answer": {
      "description": "Natural-language answer from which CompanyProof should extract supported claims.",
      "maxLength": 8000,
      "minLength": 1,
      "type": "string"
     },
     "claims": {
      "not": {}
     },
     "company": {
      "properties": {
       "country": {
        "description": "ISO 3166-1 alpha-2 jurisdiction code, for example GB.",
        "pattern": "^[A-Za-z]{2}$",
        "type": "string"
       },
       "name": {
        "description": "Legal or trading name used to resolve the company.",
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "registration_number": {
        "description": "Official registration number when known.",
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "name",
       "country"
      ],
      "type": "object"
     },
     "idempotency_key": {
      "description": "Stable key for safely retrying the same verification.",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "type": "string"
     },
     "monitor": {
      "default": false,
      "description": "Keep verified claims connected to change monitoring. Requires an eligible live key.",
      "type": "boolean"
     }
    },
    "required": [
     "company",
     "answer"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "answer": {
      "not": {}
     },
     "claims": {
      "description": "Structured company claims. Use this instead of answer.",
      "items": {
       "properties": {
        "field": {
         "description": "Company field to compare with current evidence.",
         "enum": [
          "registered_name",
          "registration_number",
          "status",
          "incorporation_date",
          "vat_number",
          "legal_form"
         ],
         "type": "string"
        },
        "published": {
         "description": "Value the calling system plans to publish or has already published.",
         "maxLength": 500,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "field",
        "published"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "company": {
      "properties": {
       "country": {
        "description": "ISO 3166-1 alpha-2 jurisdiction code, for example GB.",
        "pattern": "^[A-Za-z]{2}$",
        "type": "string"
       },
       "name": {
        "description": "Legal or trading name used to resolve the company.",
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "registration_number": {
        "description": "Official registration number when known.",
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "name",
       "country"
      ],
      "type": "object"
     },
     "idempotency_key": {
      "description": "Stable key for safely retrying the same verification.",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "type": "string"
     },
     "monitor": {
      "default": false,
      "description": "Keep verified claims connected to change monitoring. Requires an eligible live key.",
      "type": "boolean"
     }
    },
    "required": [
     "company",
     "claims"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
