{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List elections by date range and/or country, soonest first, with each race's expected count stage right now. Answers \"Which elections are in Europe this autumn?\", \"Which elections are this month?\" or \"What elections does Germany have coming up?\". Without dates it starts today; with a country and no end date it covers every future election of that country, otherwise the next 365 days. Covers 312 elections in 62 countries, 2023\u20132030, including 23 of the 27 EU member states, the 2026 US midterms in all 50 states and the certified 2024 US presidential result, with vote counts, in all 50 states and DC.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "Country name or ISO 3166-1 alpha-2 code, e.g. \"Austria\" or \"AT\", \"United States\" or \"US\"",
    "type": "string"
   },
   "from": {
    "description": "Start date YYYY-MM-DD; default today",
    "type": "string"
   },
   "include_discovered": {
    "description": "Also list elections found on Wikidata but not yet verified by Global Election Index",
    "type": "boolean"
   },
   "level": {
    "description": "national: the country votes; regional: a state, region or autonomous community elects its own parliament or head (German L\u00e4nder, Spanish autonomous communities, Italian regions). Default all",
    "enum": [
     "national",
     "regional",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Most elections to return, soonest first; default 25, max 200. Narrow with from/to or country for more.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "to": {
    "description": "End date YYYY-MM-DD; default +365 days, or no end when a country is given",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "upcoming_elections",
