{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Configure IP ACL for an NKS cluster to restrict API server access. defaultAction is required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clusterUuid": {
    "description": "UUID of the cluster",
    "type": "string"
   },
   "defaultAction": {
    "description": "Default action applied to addresses not matched by entries (allow or deny)",
    "type": "string"
   },
   "entries": {
    "description": "IP ACL entries",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "description": "ACL action (allow or deny)",
       "type": "string"
      },
      "address": {
       "description": "IP address or CIDR block",
       "type": "string"
      },
      "comment": {
       "description": "Comment for the entry",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "clusterUuid",
   "defaultAction"
  ],
  "type": "object"
 },
 "name": "ncloud_nks_set_ip_acl"
}
