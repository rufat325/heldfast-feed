{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Account"
 },
 "description": "Create a CRM account/customer with a primary contact. Optionally enroll the account as a member; use enrol_membership later when the account already exists.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Postal address",
    "properties": {
     "city": {
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "line1": {
      "type": "string"
     },
     "line2": {
      "type": "string"
     },
     "postalCode": {
      "type": "string"
     },
     "state": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "email": {
    "description": "Email address",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "enrollMembership": {
    "description": "Whether to create an active membership immediately",
    "type": "boolean"
   },
   "expiresAt": {
    "description": "Optional ISO expiry for the membership",
    "type": "string"
   },
   "firstName": {
    "description": "First name for individual accounts",
    "type": "string"
   },
   "lastName": {
    "description": "Last name for individual accounts",
    "type": "string"
   },
   "lifeStage": {
    "description": "CRM life stage. Defaults to active.",
    "enum": [
     "lead",
     "active",
     "churned",
     "vip"
    ],
    "type": "string"
   },
   "name": {
    "description": "Account/customer display name",
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "description": "Internal notes",
    "type": "string"
   },
   "phone": {
    "description": "Phone number",
    "type": "string"
   },
   "source": {
    "description": "Acquisition source. Defaults to api.",
    "enum": [
     "walk_in",
     "online",
     "pos",
     "whatsapp",
     "referral",
     "import",
     "api",
     "shopify",
     "woocommerce",
     "email"
    ],
    "type": "string"
   },
   "tierId": {
    "description": "Membership tier ID to enroll into. If omitted, the company default tier may apply.",
    "type": "string"
   },
   "type": {
    "description": "Account type. Defaults to individual.",
    "enum": [
     "individual",
     "business",
     "household"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_account",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
