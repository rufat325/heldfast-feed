{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find blog posts"
 },
 "description": "Use this when someone asks to see their blog posts, drafts or published articles, optionally for one blog, language or slug. Returns id, title, language, slug and published state, most recently edited first, 25 per page by default with a cursor. It filters by those fields and does not search the text. Not for reading a post.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blogId": {
    "description": "Only posts in this blog",
    "maxLength": 200,
    "type": "string"
   },
   "cursor": {
    "description": "The nextCursor of the previous page with the same filters; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Posts per page, from 1 to 100; defaults to 25",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "locale": {
    "description": "Only posts in this language, an ISO 639-1 code such as en or it",
    "maxLength": 50,
    "type": "string"
   },
   "published": {
    "description": "\"true\" for published posts only, \"false\" for drafts only; omit for both",
    "enum": [
     "true",
     "false"
    ],
    "type": "string"
   },
   "slug": {
    "description": "Only the post with this exact slug",
    "maxLength": 300,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_articles",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "locale": {
       "anyOf": [
        {
         "maxLength": 50,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "published": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "slug": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "title",
      "locale",
      "slug",
      "published"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   }
  },
  "required": [
   "items",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "Find blog posts"
}
