{
 "description": "Browse anime by popularity, new additions, genre/category, or simulcast season. Use crunchyroll_get_categories to get valid category names and crunchyroll_get_simulcast_seasons for season tags.",
 "inputSchema": {
  "properties": {
   "categories": {
    "description": "Comma-separated category slugs (e.g. 'action,fantasy')",
    "type": "string"
   },
   "is_dubbed": {
    "description": "Filter for dubbed content",
    "type": "boolean"
   },
   "is_subbed": {
    "description": "Filter for subbed content",
    "type": "boolean"
   },
   "n": {
    "description": "Number of results (default 20)",
    "type": "number"
   },
   "seasonal_tag": {
    "description": "Simulcast season tag ID (from crunchyroll_get_simulcast_seasons)",
    "type": "string"
   },
   "sort_by": {
    "description": "Sort order",
    "enum": [
     "popularity",
     "newly_added",
     "updated",
     "alphabetical"
    ],
    "type": "string"
   },
   "start": {
    "description": "Offset for pagination (default 0)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "crunchyroll_browse"
}
