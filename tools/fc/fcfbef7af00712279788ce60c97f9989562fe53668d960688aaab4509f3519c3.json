    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "page": {
    "description": "Page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Results per page (max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
