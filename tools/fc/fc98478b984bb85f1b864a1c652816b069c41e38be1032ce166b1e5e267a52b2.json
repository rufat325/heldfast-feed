{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Search care providers"},"description":"Searches Dutch care providers (zorgaanbieders), such as hospitals, clinics and physiotherapists, in the national AGB register by name, city (plaats), postcode or care type (zorgsoort). Returns the AGB code, address and, when a postcode is given, the distance. Provide at least one of naam, plaats or postcode, then pass the AGB code to check_zorgaanbieder. Provides information, not advice: the user makes the decision and signs up with the insurer themselves.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"limit":{"default":10,"description":"Maximum number of results per page (1-50, default 10).","maximum":50,"minimum":1,"type":"integer"},"naam":{"description":"(Part of) the name of the care provider.","maxLength":100,"minLength":2,"type":"string"},"plaats":{"description":"City or town (plaats), e.g. Utrecht.","maxLength":80,"minLength":2,"type":"string"},"postcode":{"description":"Dutch postcode (4 digits, optionally 2 letters), e.g. 3511 or 3511AB; results get a distance.","pattern":"^\\d{4}\\s?([A-Za-z]{2})?$","type":"string"},"taal":{"default":"nl","description":"Response language: nl (Dutch, default) or en (English).","enum":["nl","en"],"type":"string"},"zorgsoort":{"description":"Type of care (zorgsoort), lowercase key such as 'ziekenhuis' (hospital), 'kliniek', 'ggz' (mental healthcare), 'fysio', 'wijkverpleging', 'apotheek'.","maxLength":40,"minLength":2,"pattern":"^[a-z][a-z0-9_]*$","type":"string"}},"type":"object"},"name":"zoek_zorgaanbieder","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"aannames":{"items":{"type":"string"},"type":"array"},"acties":{"items":{"additionalProperties":false,"properties":{"label":{"type":"string"},"type":{"enum":["bewaar","afsluiten","bekijk"],"type":"string"},"url":{"type":"string