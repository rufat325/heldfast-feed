{
 "description": "Generate a unique ASCII character from a seed. 153600 possible combinations (16 species \u00d7 10 eyes \u00d7 8 mouths \u00d7 10 hats \u00d7 12 accessories). Same seed always produces the same character. Use mood for quick expression presets. Output can be piped to the animate tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accessory": {
    "description": "Accessory override",
    "enum": [
     "none",
     "bowtie",
     "scarf",
     "sword",
     "shield",
     "tail",
     "glasses",
     "cape",
     "wings",
     "staff",
     "bag",
     "flower"
    ],
    "type": "string"
   },
   "eyes": {
    "description": "Eyes override",
    "enum": [
     "dot",
     "round",
     "wide",
     "wink",
     "happy",
     "star",
     "x",
     "at",
     "dash",
     "asym"
    ],
    "type": "string"
   },
   "hat": {
    "description": "Hat override",
    "enum": [
     "none",
     "tophat",
     "crown",
     "party",
     "cap",
     "beanie",
     "antenna",
     "bow",
     "halo",
     "headband"
    ],
    "type": "string"
   },
   "mood": {
    "description": "Expression preset (overrides eyes+mouth). Explicit eyes/mouth still take priority.",
    "enum": [
     "happy",
     "sad",
     "angry",
     "surprised",
     "sleepy",
     "cool",
     "love",
     "silly"
    ],
    "type": "string"
   },
   "mouth": {
    "description": "Mouth override",
    "enum": [
     "smile",
     "grin",
     "open",
     "flat",
     "cat",
     "teeth",
     "tongue",
     "zigzag"
    ],
    "type": "string"
   },
   "seed": {
    "description": "Deterministic seed string \u2014 same seed = same character",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "size": {
    "default": "standard",
    "description": "Size: \"standard\" (full character) or \"mini\" (2-line inline, no hat/accessory)",
    "enum": [
     "mini",
     "standard"
    ],
    "type": "string"
   },
   "species": {
    "description": "Body override",
    "enum": [
     "blob",
     "cat",
     "bear",
     "robot",
     "bird",
     "bunny",
     "ghost",
     "alien",
     "fox",
     "frog",
     "penguin",
     "octopus",
     "dragon",
     "mushroom",
     "cactus",
     "skull"
    ],
    "type": "string"
   }
  },
  "required": [
   "seed"
  ],
  "type": "object"
 },
 "name": "character"
}
