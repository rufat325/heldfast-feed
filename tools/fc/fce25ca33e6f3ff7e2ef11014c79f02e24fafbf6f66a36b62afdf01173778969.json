{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get read-status counts (reading/completed/\u2026) and the score distribution for a manga by mal_id. Get the mal_id from search_manga. Unlike get_anime_statistics, no official-API fallback exists for this tool \u2014 it always needs Tenrai itself to be reachable.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "MyAnimeList numeric ID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_manga_statistics",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "completed": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "dropped": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "on_hold": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "plan_to_read": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "plan_to_watch": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "reading": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "scores": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "percentage": {
       "type": "number"
      },
      "score": {
       "maximum": 10,
       "minimum": 1,
       "type": "integer"
      },
      "votes": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "watching": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "title": "Get manga statistics"
}
