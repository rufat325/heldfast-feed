    "maxLength": 80,
    "type": "string"
   },
   "goal": {
    "maxLength": 80,
    "type": "string"
   },
   "kind": {
    "enum": [
     "all",
     "provider",
     "tutor"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 12,
    "minimum": 3,
    "type": "integer"
   },
   "type": {
    "maxLength": 40,
    "type": "string"
   },
   "verified_pro": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "tdd_shortlist",
