{
 "description": "Create a new institutional charter \u2014 the constitutional root of an organization. Defines offices, amendment rules, dissolution policy.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amendment_board_keys": {
    "description": "Ed25519 public keys eligible for amendment voting",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "amendment_required_sigs": {
    "description": "Signatures required for amendment",
    "type": "number"
   },
   "dissolution_grace_seconds": {
    "default": 86400,
    "type": "number"
   },
   "founder_private_key": {
    "description": "Founder's Ed25519 private key",
    "type": "string"
   },
   "founder_public_key": {
    "description": "Founder's Ed25519 public key",
    "type": "string"
   },
   "founder_role": {
    "default": "board",
    "type": "string"
   },
   "name": {
    "description": "Institution name",
    "type": "string"
   },
   "offices": {
    "description": "Offices to create",
    "items": {
     "properties": {
      "allowedScopes": {
       "default": [
        "*"
       ],
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "holderPublicKey": {
       "description": "Ed25519 public key of initial holder",
       "type": "string"
      },
      "incompatibleOffices": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "maxDelegationDepth": {
       "default": 3,
       "type": "number"
      },
      "maxSpendPerAction": {
       "default": 1000,
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "officeId": {
       "type": "string"
      },
      "successionOrder": {
       "default": [],
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "officeId",
      "name",
      "holderPublicKey"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "offices",
   "amendment_board_keys",
   "amendment_required_sigs",
   "founder_private_key",
   "founder_public_key"
  ],
  "type": "object"
 },
 "name": "create_charter"
}
