{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Grep every class in one dependency JAR for a string (log message, exception text, constant). Use when you know the library but not the class. Pass coordinates {group, name, version} (see resolve_dependencies with query) or jarPath.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "configuration": {
    "description": "Gradle configuration (default compileClasspath).",
    "type": "string"
   },
   "contextLines": {
    "description": "Context lines per hit.",
    "maximum": 50,
    "minimum": 0,
    "type": "integer"
   },
   "coordinates": {
    "description": "Dependency to search, as listed by resolve_dependencies.",
    "properties": {
     "group": {
      "minLength": 1,
      "type": "string"
     },
     "name": {
      "minLength": 1,
      "type": "string"
     },
     "version": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "group",
     "name"
    ],
    "type": "object"
   },
   "forceRefresh": {
    "description": "Bypass the resolution cache.",
    "type": "boolean"
   },
   "includeTest": {
    "description": "Use the test classpath.",
    "type": "boolean"
   },
   "jarPath": {
    "description": "Absolute JAR path (instead of coordinates).",
    "type": "string"
   },
   "maxClasses": {
    "description": "Maximum classes to scan.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "maxHits": {
    "description": "Max hits.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "modulePath": {
    "description": "Gradle path like ':app', or a file/dir inside the module. Omit (or \"*\") for all modules.",
    "type": "string"
   },
   "projectRoot": {
    "description": "Project root. Omit to use the workspace.",
    "type": "string"
   },
   "query": {
    "description": "Text to find in the JAR's classes (literal; regex if regex=true).",
    "minLength": 1,
    "type": "string"
   },
   "regex": {
    "description": "Treat query as a regex.",
    "type": "boolean"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_in_artifact",
 "title": "Search text across all classes in one resolved dependency JAR"
}
