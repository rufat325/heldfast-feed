{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Events on the UMD campus calendar (calendar.umd.edu) in a date range, optionally narrowed by full-text query, event type, audience or featured status. Recurring events are expanded into occurrences. Returns the total so the caller can page with offset. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "audience": {
    "description": "Only events for this audience",
    "enum": [
     "current-students",
     "graduate-students",
     "prospective-students",
     "alumni",
     "faculty",
     "staff",
     "parents",
     "friends",
     "campus-leaders",
     "external-media"
    ],
    "type": "string"
   },
   "end": {
    "description": "Only events on or before this date (default: no limit)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "event_type": {
    "description": "Only events of this type",
    "enum": [
     "academics",
     "athletics-and-recreation",
     "arts-entertainment-and-culture",
     "community-engagement",
     "diversity-inclusion",
     "health-and-wellness",
     "research",
     "spiritual-and-religious",
     "student-life",
     "family-engagement"
    ],
    "type": "string"
   },
   "featured": {
    "description": "Only featured events when true",
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of records to return, 1-100 (default 10)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Number of records to skip, for pagination (default 0)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Full-text search over title and body, plain words, e.g. \"gis\"",
    "minLength": 1,
    "type": "string"
   },
   "start": {
    "description": "Only events on or after this date (default: today)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "calendar_search_events",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "events": {
    "description": "Events in start-date order",
    "items": {
     "additionalProperties": false,
     "properties": {
      "all_day": {
       "type": "boolean"
      },
      "audiences": {
       "description": "Audience categories (unknown new ones are dropped)",
       "items": {
        "enum": [
         "current-students",
         "graduate-students",
         "prospective-students",
         "alumni",
         "faculty",
         "staff",
         "parents",
         "friends",
         "campus-leaders",
         "external-media"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "calendar": {
       "description": "Which of the site's calendars the event is in",
       "enum": [
        "submission",
        "communications",
        "athletics"
       ],
       "type": "string"
      },
      "contact": {
       "additionalProperties": false,
       "properties": {
        "email": {
         "type": [
          "string",
          "null"
         ]
        },
        "name": {
         "type": [
          "string",
          "null"
         ]
        },
        "phone": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "name",
        "phone",
        "email"
       ],
       "type": "object"
      },
      "description": {
       "description": "Full description as plain text",
       "type": [
        "string",
        "null"
       ]
      },
      "end": {
       "description": "ISO 8601 with the America/New_York offset, e.g. \"2026-10-01T14:00:00-04:00\"",
       "type": "string"
      },
      "event_types": {
       "description": "Event-type categories (unknown new ones are dropped)",
       "items": {
        "enum": [
         "academics",
         "athletics-and-recreation",
         "arts-entertainment-and-culture",
         "community-engagement",
         "diversity-inclusion",
         "health-and-wellness",
         "research",
         "spiritual-and-religious",
         "student-life",
         "family-engagement"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "featured": {
       "description": "true when the site marks the event as featured",
       "type": "boolean"
      },
      "id": {
       "description": "Event id to pass to calendar_get_event",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "image_url": {
       "description": "Hero image; append ?w=&h=&fit=crop to resize",
       "type": [
        "string",
        "null"
       ]
      },
      "location": {
       "additionalProperties": false,
       "properties": {
        "address": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "city": {
             "type": [
              "string",
              "null"
             ]
            },
            "name": {
             "description": "Place name, if given",
             "type": [
              "string",
              "null"
             ]
            },
            "state": {
             "type": [
              "string",
              "null"
             ]
            },
            "street": {
             "description": "Street lines, blank lines dropped",
             "items": {
              "type": "string"
             },
             "type": "array"
            },
            "zip": {
             "type": [
              "string",
              "null"
             ]
            }
           },
           "required": [
            "street",
            "city",
            "state",
            "zip",
            "name"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ],
         "description": "Postal address for off-campus events; null otherwise"
        },
        "off_campus_name": {
         "description": "Off-campus venue name",
         "type": [
          "string",
          "null"
         ]
        },
        "off_campus_url": {
         "description": "Off-campus venue website",
         "type": [
          "string",
          "null"
         ]
        },
        "type": {
         "anyOf": [
          {
           "enum": [
            "on_campus",
            "online",
            "off_campus"
           ],
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "description": "null when the event does not say"
        },
        "venue": {
         "description": "Free-text on-campus location, e.g. \"Stamp Student Union, Room 1101\"",
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "type",
        "venue",
        "off_campus_name",
        "off_campus_url",
        "address"
       ],
       "type": "object"
      },
      "multi_day": {
       "type": "boolean"
      },
      "slug": {
       "description": "URL slug; also accepted by calendar_get_event",
       "type": "string"
      },
      "start": {
       "description": "ISO 8601 with the America/New_York offset, e.g. \"2026-10-01T14:00:00-04:00\"",
       "type": "string"
      },
      "summary": {
       "description": "Short blurb as plain text",
       "type": [
        "string",
        "null"
       ]
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "Public page on calendar.umd.edu",
       "type": "string"
      }
     },
     "required": [
      "id",
      "slug",
      "title",
      "url",
      "start",
      "end",
      "all_day",
      "multi_day",
      "summary",
      "description",
      "image_url",
      "event_types",
      "audiences",
      "featured",
      "tags",
      "location",
      "contact",
      "calendar"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Events matching the filters, across all pages",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "total",
   "events"
  ],
  "type": "object"
 },
 "title": "Search campus events"
}
