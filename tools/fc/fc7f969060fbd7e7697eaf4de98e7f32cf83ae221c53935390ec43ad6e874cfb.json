{
 "description": "Update an existing workflow. Supports partial updates: omitted fields keep their current values (the current workflow is fetched and merged automatically).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "connections": {
    "additionalProperties": {},
    "description": "Updated connections",
    "type": "object"
   },
   "id": {
    "description": "Workflow ID to update",
    "type": "string"
   },
   "name": {
    "description": "New workflow name",
    "type": "string"
   },
   "nodes": {
    "description": "Updated workflow nodes",
    "items": {
     "additionalProperties": true,
     "properties": {
      "name": {
       "type": "string"
      },
      "parameters": {
       "additionalProperties": {},
       "type": "object"
      },
      "position": {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "settings": {
    "additionalProperties": {},
    "description": "Updated settings",
    "type": "object"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "n8n_update_workflow"
}
