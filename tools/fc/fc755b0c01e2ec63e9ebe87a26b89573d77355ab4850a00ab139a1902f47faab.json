{
 "description": "Update an existing permission role",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Alias of the Google account to target. Optional \u2014 defaults to the session/global default account, or the sole authenticated account. Run manage_accounts list to see available aliases.",
    "type": "string"
   },
   "fileId": {
    "description": "Google Drive file ID",
    "type": "string"
   },
   "permissionId": {
    "description": "Permission ID",
    "type": "string"
   },
   "role": {
    "description": "New role",
    "enum": [
     "owner",
     "organizer",
     "fileOrganizer",
     "writer",
     "commenter",
     "reader"
    ],
    "type": "string"
   }
  },
  "required": [
   "fileId",
   "permissionId",
   "role"
  ],
  "type": "object"
 },
 "name": "updatePermission"
}
