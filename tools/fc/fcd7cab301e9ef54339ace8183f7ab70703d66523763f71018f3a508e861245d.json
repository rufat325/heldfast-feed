{
 "description": "Record one public transport trip (date, from, to, fare, mode, which account paid) so it counts towards a monthly total and the subsidy estimate. Writes to your own ledger; a bearer API key is required and the call counts against the same monthly allowance as the REST endpoint.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "date": {
    "description": "Travel date, YYYY-MM-DD.",
    "type": "string"
   },
   "fare": {
    "description": "Fare paid in HKD, e.g. 10.6",
    "type": "number"
   },
   "from": {
    "description": "Origin, e.g. \"Central\".",
    "type": "string"
   },
   "mode": {
    "description": "Transport mode.",
    "enum": [
     "mtr",
     "bus",
     "ferry",
     "minibus",
     "tram"
    ],
    "type": "string"
   },
   "paid_with": {
    "description": "Which account paid the fare.",
    "enum": [
     "octopus",
     "alipayhk"
    ],
    "type": "string"
   },
   "to": {
    "description": "Destination, e.g. \"Tsim Sha Tsui\".",
    "type": "string"
   }
  },
  "required": [
   "date",
   "from",
   "to",
   "fare",
   "mode",
   "paid_with"
  ],
  "type": "object"
 },
 "name": "log_trip"
}
