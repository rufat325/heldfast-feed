{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Builds a prefilled booking link for a 30-minute intro call. Does not book anything: give the link to the user to confirm a time themselves.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "company": {
    "maxLength": 100,
    "type": "string"
   },
   "date": {
    "description": "Preferred date, YYYY-MM-DD",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "email": {
    "format": "email",
    "maxLength": 254,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "topic": {
    "description": "What the user wants to discuss",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "request_intro",
 "title": "Prepare an intro call booking link"
}
