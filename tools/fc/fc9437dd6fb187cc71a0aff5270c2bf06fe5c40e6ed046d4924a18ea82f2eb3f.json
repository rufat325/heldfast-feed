{"description":"Create a campaign (the 'ad group') with targeting, budget, bid or bidding strategy (optimizationTargetType MAX_CLICK = Maximum Delivery on landing page clicks), schedule, and optional ad rotation (creativeSelection: OPTIMIZED or ROUND_ROBIN = rotate ads evenly). Defaults to DRAFT.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"accountId":{"type":"string"},"applyDefaultConversion":{"default":true,"type":"boolean"},"applyDefaultExclusions":{"default":true,"type":"boolean"},"audienceSegmentUrn":{"description":"urn:li:adSegment:... to target a matched audience","type":"string"},"campaignGroupId":{"description":"Numeric campaign group id","type":"string"},"conversionIds":{"items":{"type":"string"},"type":"array"},"costType":{"default":"CPM","enum":["CPC","CPM","CPV"],"type":"string"},"creativeSelection":{"description":"Ad rotation: OPTIMIZED (LinkedIn default, favors the predicted winner) or ROUND_ROBIN (rotate ads evenly)","enum":["OPTIMIZED","ROUND_ROBIN"],"type":"string"},"dailyBudget":{"additionalProperties":false,"properties":{"amount":{"description":"Decimal string, e.g. '100.00'","type":"string"},"currencyCode":{"default":"USD","maxLength":3,"minLength":3,"type":"string"}},"required":["amount"],"type":"object"},"geoUrns":{"description":"urn:li:geo:... locations to include","items":{"type":"string"},"type":"array"},"locale":{"additionalProperties":false,"default":{"country":"US","language":"en"},"properties":{"country":{"type":"string"},"language":{"type":"string"}},"required":["country","language"],"type":"object"},"name":{"minLength":1,"type":"string"},"objectiveType":{"description":"Campaign objective. Required to be ENGAGEMENT to sponsor another member's post (thought-leader ads).","enum":["BRAND_AWARENESS","ENGAGEMENT","JOB_APPLICANT","LEAD_GENERATION","VIDEO_VIEW","WEBSITE_CONVERSION","WEBSITE_VISIT"],"type":"string"},"optimizationTargetType":{"description":"Bidding strategy. MAX_CLICK = Maximum Delivery optimized for landing page clicks (automated bid, charged CPM, unitCost ignored). Omit or NONE for a manual bid.","enum":["NONE","MAX_CLICK","MAX_IMPRESSION","MAX_CONVERSION","MAX_LEAD","MAX_VIDEO_VIEW","MAX_REACH","TARGET_COST_PER_CLICK","TARGET_COST_PER_IMPRESSION","TARGET_COST_PER_VIDEO_VIEW","ENHANCED_CONVERSION"],"type":"string"},"politicalIntent":{"default":"NOT_POLITICAL","enum":["NOT_POLITICAL","POLITICAL","NOT_DECLARED"],"type":"string"},"runSchedule":{"additionalProperties":false,"properties":{"end":{"exclusiveMinimum":0,"type":"integer"},"start":{"exclusiveMinimum":0,"type":"integer"}},"required":["start"],"type":"object"},"status":{"default":"DRAFT","enum":["DRAFT","ACTIVE","PAUSED","ARCHIVED"],"type":"string"},"targeting":{"additionalProperties":false,"properties":{"exclude":{"additionalProperties":{"items":{"type":"string"},"type":"array"},"description":"facet short name -> entity URNs to exclude","type":"object"},"include":{"additionalProperties":{"items":{"type":"string"},"type":"array"},"description":"facet short name -> entity URNs (ANDed across facets)","type":"object"}},"required":["include"],"type":"object"},"targetingCriteria":{"additionalProperties":{},"type":"object"},"totalBudget":{"$ref":"#/properties/dailyBudget"},"type":{"default":"SPONSORED_UPDATES","enum":["SPONSORED_UPDATES","TEXT_AD","SPONSORED_INMAILS"],"type":"string"},"unitCost":{"$ref":"#/properties/dailyBudget","description":"Bid amount"}},"required":["accountId","campaignGroupId","name","runSchedule"],"type":"object"},"name":"create_campaign"}
