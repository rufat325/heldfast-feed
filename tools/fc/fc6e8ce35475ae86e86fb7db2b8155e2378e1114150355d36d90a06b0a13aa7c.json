 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Calculate tax on several incomes"
 },
 "description": "Calculate the combined UK tax on income from several sources in one tax year (employment, self-employment, rental profit, dividends and savings interest), allowing for PAYE tax already deducted: income tax, National Insurance, student loan, what is left to pay and take-home.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "dividendIncome": {
    "description": "Dividends",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "employment": {
    "description": "Employment income (salary)",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "payeTaxDeducted": {
    "description": "Income tax already deducted through PAYE",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "pensionContributions": {
    "description": "Personal pension contributions",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "rentalProfit": {
    "description": "Rental profit",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "savingsInterest": {
    "description": "Savings interest",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "selfEmployment": {
    "description": "Self-employed profit",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "studentLoanPlan": {
    "description": "Student loan plan, if any (plan4 is Scotland, postgrad the postgraduate loan)",
    "enum": [
     "none",
     "plan1",
     "plan2",
     "plan4",
     "postgrad"
    ],
    "type": "string"
   },
   "taxYear": {
    "description": "UK tax year, e.g. \"2026-27\". Defaults to the current one.",
    "enum": [
     "2026-27",
     "2025-26",
     "2024-25"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "calculate_tax_on_multiple_incomes",
 "title": "Calculate tax on several incomes"
}
