{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update fields on an existing lead by id. Provide a patch with at least one field. Use search_leads first to find the lead id. The result echoes the operating workspace.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "The lead id returned by search_leads.",
    "minLength": 1,
    "type": "string"
   },
   "patch": {
    "additionalProperties": false,
    "description": "The lead fields to update; include at least one changed field.",
    "properties": {
     "assignedTo": {
      "anyOf": [
       {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "User id of the workspace member to own the lead; null to unassign."
     },
     "companyName": {
      "anyOf": [
       {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The lead's company name; null to clear."
     },
     "email": {
      "anyOf": [
       {
        "format": "email",
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The lead's email; null to clear."
     },
     "name": {
      "description": "The lead's full name or label.",
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "nextActionDate": {
      "anyOf": [
       {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "ISO 8601 timestamp of the next action; null to clear."
     },
     "nextActionNote": {
      "anyOf": [
       {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "What the next action is; null to clear."
     },
     "notes": {
      "anyOf": [
       {
        "maxLength": 5000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Free-text notes; null to clear."
     },
     "phone": {
      "anyOf": [
       {
        "maxLength": 50,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The lead's phone number; null to clear."
     },
     "position": {
      "anyOf": [
       {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The lead's job title/position; null to clear."
     },
     "score": {
      "description": "Lead quality score, 0-100.",
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     },
     "source": {
      "description": "Lead source key (see list_lead_sources).",
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "status": {
      "description": "Lead status: new, contacted, qualified, unqualified, or converted.",
      "enum": [
       "new",
       "contacted",
       "qualified",
       "unqualified"
      ],
      "type": "string"
     },
     "tags": {
      "description": "Tags for segmentation (replaces the existing set; max 30).",
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 30,
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "id",
   "patch"
  ],
  "type": "object"
 },
 "name": "update_lead",
 "title": "Update lead"
}
