{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns phonetic neighbors for a baby name from the research neighborhood graph \u2014 the same sounds-like list the /names/[slug] profile panel shows. Does not invent neighbors.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max neighbors to return (default 8, max 20).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "The name, case-insensitive (e.g. Rowan).",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_similar_names",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "canonicalUrl": {
    "type": "string"
   },
   "contract": {
    "type": "string"
   },
   "count": {
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "neighbors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "canonicalUrl": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "canonicalUrl"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "contract",
   "name",
   "count",
   "neighbors",
   "canonicalUrl"
  ],
  "type": "object"
 },
 "title": "Get phonetically similar names"
}
