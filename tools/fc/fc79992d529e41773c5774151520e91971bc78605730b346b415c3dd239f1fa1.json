{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Crm Task"
 },
 "description": "Update a CRM follow-up task you can work: title, description, dueAt (exact datetime, or null to clear), owner (users.id, or null to unassign), status (done sets completion) or priority. Changing the linked account or conversation is not supported; create a new task instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "anyOf": [
     {
      "maxLength": 10000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "New description, or null to clear"
   },
   "dueAt": {
    "anyOf": [
     {
      "maxLength": 80,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Exact ISO 8601 datetime with timezone offset or Z, or null to clear"
   },
   "ownerId": {
    "anyOf": [
     {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "New owner users.id, or null to unassign"
   },
   "priority": {
    "description": "Priority",
    "enum": [
     "low",
     "medium",
     "high",
     "urgent"
    ],
    "type": "string"
   },
   "status": {
    "description": "todo, in_progress or done",
    "enum": [
     "todo",
     "in_progress",
     "done"
    ],
    "type": "string"
   },
   "taskId": {
    "description": "CRM task ID",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "description": "New title",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taskId"
  ],
  "type": "object"
 },
 "name": "update_crm_task",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
