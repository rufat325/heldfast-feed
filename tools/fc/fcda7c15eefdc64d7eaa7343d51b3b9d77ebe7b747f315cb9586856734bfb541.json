{
 "description": "List the catalog of software-design concepts, optionally filtered by kind. Returns each concept's slug, name, category, and one-line summary.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "description": "Filter by kind. \"principle\" = all principles; \"solid\"/\"oop\" narrow to the SOLID five / the four OOP pillars; \"pattern\" = all GoF patterns. Default \"all\".",
    "enum": [
     "all",
     "principle",
     "solid",
     "oop",
     "pattern",
     "creational",
     "structural",
     "behavioral"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_catalog",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "concepts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "name",
      "category",
      "summary"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "type": "number"
   }
  },
  "required": [
   "count",
   "concepts"
  ],
  "type": "object"
 },
 "title": "List design principles & patterns"
}
