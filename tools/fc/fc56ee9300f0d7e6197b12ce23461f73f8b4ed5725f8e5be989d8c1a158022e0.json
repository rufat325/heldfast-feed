{
 "annotations": {
  "readOnlyHint": true,
  "title": "List Tasks"
 },
 "description": "List follow-up tasks/reminders, filterable by status/performer/customer. Returns {tasks[], pagination}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filter_customer": {
    "description": "Filter by customer name/contact (text match \u2014 RetailCRM v5 has no numeric customer-ID task filter)",
    "type": "string"
   },
   "filter_performer_id": {
    "description": "Filter by assigned manager ID",
    "type": "integer"
   },
   "filter_status": {
    "description": "Filter by completion status",
    "enum": [
     "completed",
     "performing",
     "not_completed"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Results per page (max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "tasks_list"
}
