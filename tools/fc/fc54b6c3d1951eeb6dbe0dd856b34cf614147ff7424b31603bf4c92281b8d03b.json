{
 "annotations": {
  "destructiveHint": true,
  "title": "Record a gift"
 },
 "description": "WRITE: record a gift (donation, pledge payment, in-kind, etc.) on a constituent's record. This writes a CRM record of a gift that already happened \u2014 it does NOT charge a card or move money. Give gift_type_id or gift_type_name (required; see lgl_list_type_values type=gift_types). Fund, campaign, appeal, event, gift category and payment type may each be given by id or by exact name. Set ack_template_name to 'do_not_ack' to skip acknowledgment. LGL: POST /api/v1/constituents/{constituent_id}/gifts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ack_template_name": {
    "description": "Acknowledgment mailing template name, or 'do_not_ack'.",
    "type": "string"
   },
   "appeal_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "appeal_name": {
    "type": "string"
   },
   "campaign_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "campaign_name": {
    "type": "string"
   },
   "check_number": {
    "description": "Check/reference number.",
    "type": "string"
   },
   "constituent_id": {
    "description": "Constituent id (integer).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "deductible_amount": {
    "description": "Tax-deductible amount.",
    "minimum": 0,
    "type": "number"
   },
   "deposit_date": {
    "description": "Deposit date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "deposited_amount": {
    "minimum": 0,
    "type": "number"
   },
   "event_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "event_name": {
    "type": "string"
   },
   "external_id": {
    "description": "External gift id (your own system's id).",
    "type": "string"
   },
   "fund_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "fund_name": {
    "type": "string"
   },
   "gift_category_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "gift_category_name": {
    "description": "Gift category name, e.g. 'Donation'.",
    "type": "string"
   },
   "gift_type_id": {
    "description": "Gift type id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "gift_type_name": {
    "description": "Gift type name, e.g. 'Gift'.",
    "type": "string"
   },
   "is_anon": {
    "description": "Gift is anonymous.",
    "type": "boolean"
   },
   "note": {
    "description": "Gift note.",
    "type": "string"
   },
   "payment_type_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "payment_type_name": {
    "description": "Payment type name, e.g. 'Check', 'Credit Card'.",
    "type": "string"
   },
   "received_amount": {
    "description": "Gift amount.",
    "minimum": 0,
    "type": "number"
   },
   "received_date": {
    "description": "Gift date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "team_member": {
    "description": "Team member credited: id, email, or 'first_name last_name' (see lgl_list_team_members).",
    "type": "string"
   }
  },
  "required": [
   "constituent_id"
  ],
  "type": "object"
 },
 "name": "lgl_create_gift",
 "title": "Record a gift"
}
