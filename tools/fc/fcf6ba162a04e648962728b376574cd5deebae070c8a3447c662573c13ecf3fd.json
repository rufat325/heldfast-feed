{
 "description": "Update an existing scheduled report. Any field not provided stays unchanged.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dayOfWeek": {
    "description": "Updated day of week",
    "maximum": 6,
    "minimum": 0,
    "type": "number"
   },
   "enabled": {
    "description": "Enable or disable the report",
    "type": "boolean"
   },
   "frequency": {
    "description": "Updated frequency",
    "enum": [
     "DAILY",
     "WEEKLY"
    ],
    "type": "string"
   },
   "hourUtc": {
    "description": "Updated hour UTC",
    "maximum": 23,
    "minimum": 0,
    "type": "number"
   },
   "name": {
    "description": "Updated name",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "recipients": {
    "description": "Updated comma-separated email list",
    "type": "string"
   },
   "reportId": {
    "description": "The scheduled report ID to update",
    "type": "string"
   }
  },
  "required": [
   "reportId"
  ],
  "type": "object"
 },
 "name": "update_scheduled_report",
 "title": "Update Scheduled Report"
}
