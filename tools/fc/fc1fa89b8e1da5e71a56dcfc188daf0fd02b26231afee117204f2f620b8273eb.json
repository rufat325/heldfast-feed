{"_meta":{"securitySchemes":[{"scopes":["mcp"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Reset a connector account password"},"description":"Generate a new password for a connector project's email/password account; the old one stops working. Shown only once. Workspace owners only.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"email":{"format":"email","maxLength":254,"pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"project_id":{"description":"The project id","pattern":"^[A-Za-z0-9_-][A-Za-z0-9._:-]{0,127}$","type":"string"}},"required":["project_id","email"],"type":"object"},"name":"reset_connector_account_password","title":"Reset a connector account password"}
