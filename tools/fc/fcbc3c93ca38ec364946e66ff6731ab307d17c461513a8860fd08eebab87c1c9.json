{
 "description": "Remove followers (users) from a contact.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "contactId": {
    "description": "The contact ID to remove followers from",
    "type": "string"
   },
   "followers": {
    "description": "Array of user IDs to remove as followers",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "contactId",
   "followers"
  ],
  "type": "object"
 },
 "name": "crm_remove_contact_followers"
}
