{
 "annotations": {},
 "description": "Create a local style. Args per `type`: PAINT: color. TEXT: fontSize, fontFamily, fontStyle, textDecoration, lineHeightValue/Unit, letterSpacingValue/Unit. EFFECT: effectType, color, opacity, radius, offsetX, offsetY, spread. GRID: pattern, count, gutterSize, offset, alignment, sectionSize, color, opacity. Returns the style ID; apply with apply_style_to_node.",
 "inputSchema": {
  "properties": {
   "alignment": {
    "description": "STRETCH (default), CENTER, MIN, MAX",
    "type": "string"
   },
   "color": {
    "description": "Hex. PAINT: required. EFFECT: default #000000. GRID: default #FF0000.",
    "type": "string"
   },
   "count": {
    "description": "Columns/rows count (default 12)",
    "type": "number"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "effectType": {
    "description": "DROP_SHADOW (default), INNER_SHADOW, LAYER_BLUR, BACKGROUND_BLUR",
    "type": "string"
   },
   "fontFamily": {
    "description": "Default Inter",
    "type": "string"
   },
   "fontSize": {
    "description": "Default 16",
    "type": "number"
   },
   "fontStyle": {
    "description": "e.g. 'Bold' (default Regular)",
    "type": "string"
   },
   "gutterSize": {
    "description": "Gutter (default 16)",
    "type": "number"
   },
   "letterSpacingUnit": {
    "description": "PIXELS (default) or PERCENT",
    "type": "string"
   },
   "letterSpacingValue": {
    "description": "Letter spacing",
    "type": "number"
   },
   "lineHeightUnit": {
    "description": "PIXELS (default) or PERCENT",
    "type": "string"
   },
   "lineHeightValue": {
    "description": "Line height",
    "type": "number"
   },
   "name": {
    "description": "Style name; slashes group e.g. 'Brand/Primary'",
    "type": "string"
   },
   "offset": {
    "description": "Margin (default 0)",
    "type": "number"
   },
   "offsetX": {
    "description": "Default 0",
    "type": "number"
   },
   "offsetY": {
    "description": "Default 4",
    "type": "number"
   },
   "opacity": {
    "description": "0-1. EFFECT default 0.25, GRID default 0.1.",
    "type": "number"
   },
   "pattern": {
    "description": "GRID (default), COLUMNS, ROWS",
    "type": "string"
   },
   "radius": {
    "description": "Blur (default 8 shadow, 4 blur)",
    "type": "number"
   },
   "sectionSize": {
    "description": "Cell size (default 8)",
    "type": "number"
   },
   "spread": {
    "description": "Default 0",
    "type": "number"
   },
   "textDecoration": {
    "description": "NONE (default), UNDERLINE, STRIKETHROUGH",
    "type": "string"
   },
   "type": {
    "description": "PAINT, TEXT, EFFECT, or GRID",
    "type": "string"
   }
  },
  "required": [
   "type",
   "name"
  ],
  "type": "object"
 },
 "name": "create_style"
}
