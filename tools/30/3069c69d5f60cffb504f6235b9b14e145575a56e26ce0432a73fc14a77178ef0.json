{
 "description": "List the authenticated worker's reconciled time entries (10-minute billing cells: tracked on/off-platform seconds, manual seconds, billable seconds, activity %, status, memo), newest day first, cursor-paginated. Filter by contract and/or a from/to UTC day range. Requires time:read scope and the public API time-tracking feature.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contractId": {
    "description": "Filter to one contract.",
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "description": "Opaque pagination cursor from a previous nextCursor value.",
    "minLength": 1,
    "type": "string"
   },
   "from": {
    "description": "Inclusive first UTC day (YYYY-MM-DD).",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Page size (default 100).",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "to": {
    "description": "Inclusive last UTC day (YYYY-MM-DD).",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "opentrain_time_entries",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
