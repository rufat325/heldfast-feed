{"_meta":{"xdata.kr/credential":{"providers":["hometax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=hometax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: hometax__session__login (\uac19\uc740 account_link_id). \ubc1c\uae09\ub41c \uc99d\uba85\uc11c\ub97c PDF \ub85c \ub0b4\ub824\ubc1b\uc2b5\ub2c8\ub2e4. \uacb0\uacfc\uc758 data \uc5d0\ub294 \ubc1c\uae09 \uc2dd\ubcc4\uac12(cva_id, rcat_no)\uc774, artifacts[] \uc5d0\ub294 PDF \uc640 \uc11c\uba85\ub41c \ub0b4\ub824\ubc1b\uae30 \uc8fc\uc18c(download_url)\uac00 \ub2f4\uae41\ub2c8\ub2e4. \ub418\ub3cc\ub9b4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00\uc5d0\uc11c\ub294 \uc774\uac83\uc774 \ucd9c\ub825\uc774\ub77c \ucd9c\ub825\ud560 \ub54c\ub9c8\ub2e4 \uc2e0\uccad\ud55c \ubc1c\uae09 \ub9e4\uc218(\ubc1c\uae09 \ud55c\ub3c4) 1\ub9e4\ub97c \uc4f0\uace0, \ub2e4 \uc4f0\uba74 \uc99d\uba85\uc11c\ub97c \ub2e4\uc2dc \uc2e0\uccad\ud574\uc57c \ud569\ub2c8\ub2e4. \ucde8\uc18c \uae30\ub2a5\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. cva_id \uac12\uc740 \uc99d\uba85\uc11c \uc2e0\uccad \uacb0\uacfc(apply_auto, apply_with_template \ub4f1)\uc5d0\uc11c \uc5bb\uc2b5\ub2c8\ub2e4. rcat_no \uac12\uc740 apply_auto(data.list_info.rcat_no) \ub610\ub294 apply_auto_download(\ucd5c\uc0c1\uc704)\uc5d0\uc11c \uc5bb\uace0, apply_with_template \uc758 \uacb0\uacfc\uc5d0\uc11c\ub294 rcat_no \uac12\uc774 null \uc785\ub2c8\ub2e4. \uc774 \ub3c4\uad6c\ub294 \uae30\uad00\uc758 \uae30\ub85d\uc744 \ubc14\uafc9\ub2c8\ub2e4. \uccab \ud638\ucd9c\uc740 \uc2e4\ud589\ub418\uc9c0 \uc54a\uace0, \uc804\uc1a1\ud560 \ub0b4\uc6a9\uc758 \ubbf8\ub9ac\ubcf4\uae30\uc640 1\ud68c\uc6a9 confirmation_token \uc744 \ub3cc\ub824\uc90d\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uadf8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc0ac\uc6a9\uc790\uc5d0\uac8c \uadf8\ub300\ub85c \ubcf4\uc5ec \uc90d\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \ub3d9\uc758\ud55c \ub4a4\uc5d0\ub9cc \uac19\uc740 \uc778\uc790\uc5d0 \uadf8 confirmation_token \uc744 \ub354\ud574 \ub2e4\uc2dc \ud638\ucd9c\ud569\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uc758 \ub3d9\uc758 \uc5c6\uc774 \ud1a0\ud070\uc744 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc778\uc790\ub97c \ud558\ub098\ub77c\ub3c4 \ubc14\uafb8\uba74 \ud1a0\ud070\uc740 \ubb34\ud6a8\uac00 \ub429\ub2c8\ub2e4. \uadf8\ub54c\ub294 \ud1a0\ud070 \uc5c6\uc774 \ud638\ucd9c\ud574 \uc0c8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ud30c\uc77c: PDF \u00b7 \uae30\uad00\uc774 \ubc1c\uae09\ud55c \uc6d0\ubcf8. \uacb0\uacfc\uc758 artifacts[] \uc5d0 \uc2e4\ub9ac\uace0, \ub0b4\ub824\ubc1b\uae30 \ub9c1\ud06c(download_url)\ub294 15\ubd84 \ub3d9\uc548 \uc5f4\ub9ac\uba70 \ud30c\uc77c\uc740 7\uc77c \ub3d9\uc548 \ubcf4\uad00\ub429\ub2c8\ub2e4. \ub9c1\ud06c\uac00 \ub9cc\ub8cc\ub418\uba74 \uacb0\uacfc\uc758 job_id \ub85c xdata__job__result \ub97c \ub2e4\uc2dc \ubd88\ub7ec \uc0c8 \ub9c1\ud06c\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778 \uc5c6\uc774 \ubc1b\uc740 \uacb0\uacfc\ub294 \ud568\uaed8 \uc628 recovery_receipt \ub97c \ub530\ub85c \ubcf4\uad00\ud588\ub2e4\uac00, \ucc98\uc74c\uc758 job_id \ub098 pack_run_id \uc640 \ud568\uaed8 xdata__job__result \uc5d0 \ubcf4\ub0b4\uc138\uc694. \uc99d\ud45c\ub85c\ub294 \uadf8 \uacb0\uacfc \ud558\ub098\ub9cc, \uc6d0\ub798 \ud30c\uc77c \ubcf4\uad00 \uae30\uac04\uc774 \ub05d\ub0a0 \ub54c\uae4c\uc9c0 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc99d\ud45c\ub294 \uacf5\uac1c\ud558\uc9c0 \ub9c8\uc138\uc694. \uc783\uc5b4\ubc84\ub9ac\uba74 \uac00\uc785\ud574\ub3c4 \ub418\ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub85c\uadf8\uc778\ud574\ub3c4 \uc99d\ud45c\ub294 \uadf8\ub300\ub85c \uc4f0\uc774\uace0, \ub2e4\ub978 \uacb0\uacfc\ub294 \uc5f4\uc9c0 \ubabb\ud569\ub2c8\ub2e4. \uc99d\ud45c\uac00 \uc5c6\uc73c\uba74 \ucc98\uc74c \uacc4\uc815\uacfc \uac19\uc740 \ud658\uacbd(\ub370\ubaa8 \u00b7 \uc815\uc2dd)\uc5d0\uc11c\ub9cc \uacb0\uacfc\ub97c \uc77d\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 5\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"cer_cva_isn_no":{"description":"\uc99d\uba85\uc11c \ubaa9\ub85d \uc870\ud68c \uacb0\uacfc \ud589\uc758 cer_cva_isn_no \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc2b5\ub2c8\ub2e4. \ub123\uc9c0 \uc54a\uc73c\uba74 \ubaa9\ub85d\uc5d0\uc11c cva_id \ub85c \uadf8 \ud589\uc744 \ucc3e\uc544 \ucc44\uc6c1\ub2c8\ub2e4.","type":"string"},"cerp_isn_actl_qty":{"description":"\uc99d\uba85\uc11c \ubaa9\ub85d \uc870\ud68c \uacb0\uacfc \ud589\uc758 cerp_isn_actl_qty \uac12(\uc774\ubbf8 \ubc1c\uae09\ud55c \ub9e4\uc218)\uc744 \uadf8\ub300\ub85c \ub123\uc2b5\ub2c8\ub2e4. rpt_pkg_pth, cer_cva_isn_no \uc640 \ub450 \ub9e4\uc218\ub97c \ubaa8\ub450 \ub123\uc73c\uba74 \ubaa9\ub85d\uc744 \ub2e4\uc2dc \uc870\ud68c\ud558\uc9c0 \uc54a\uc544 \uc870\ud68c \uae30\uac04 \ubc16\uc758 \uc624\ub798\ub41c \uc2e0\uccad\ub3c4 \ub0b4\ub824\ubc1b\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","type":"integer"},"cerp_isn_rqs_qty":{"description":"\uc99d\uba85\uc11c \ubaa9\ub85d \uc870\ud68c \uacb0\uacfc \ud589\uc758 cerp_isn_rqs_qty \uac12(\uc2e0\uccad\ud55c \ubc1c\uae09 \ub9e4\uc218)\uc744 \uadf8\ub300\ub85c \ub123\uc2b5\ub2c8\ub2e4. \ub123\uc9c0 \uc54a\uc73c\uba74 \ubaa9\ub85d \ud589\uc758 \uac12\uc73c\ub85c \ucc44\uc6c1\ub2c8\ub2e4.","type":"integer"},"confirmation_token":{"description":"\uccab \ud638\ucd9c\uc774 \ub3cc\ub824\uc900 1\ud68c\uc6a9 \ud655\uc778 \ud1a0\ud070\uc785\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uac19\uc740 \uc778\uc790\uc5d0 \uc774 \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc5b4 \ub2e4\uc2dc \ud638\ucd9c\ud558\uba74 \uc2e4\ud589\ub429\ub2c8\ub2e4. 10\ubd84 \ub4a4 \ub9cc\ub8cc\ub418\uace0 \ud55c \ubc88\ub9cc \uc4f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","type":"string"},"cva_id":{"description":"\uc99d\uba85\uc11c ID(cvaId).","type":"string"},"end_dt":{"description":"\ubc1c\uae09 \uc99d\uba85\uc11c \ubaa9\ub85d\uc744 \ucc3e\uc744 \uc885\ub8cc\uc77c YYYYMMDD. \uc785\ub825\ud558\uc9c0 \uc54a\uc544\ub3c4 \ub429\ub2c8\ub2e4.","type":"string"},"lnk_cl_cd":{"description":"\uc99d\uba85\uc11c \ubaa9\ub85d \uc870\ud68c \uacb0\uacfc \ud589\uc758 lnk_cl_cd \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc2b5\ub2c8\ub2e4. \ub123\uc9c0 \uc54a\uc73c\uba74 \ubaa9\ub85d \ud589\uc758 \uac12\uc73c\ub85c \ucc44\uc6c1\ub2c8\ub2e4.","type":"string"},"mdl_txpr_yn":{"description":"\uc99d\uba85\uc11c \ubaa9\ub85d \uc870\ud68c \uacb0\uacfc \ud589\uc758 mdl_txpr_yn \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc2b5\ub2c8\ub2e4. \ub123\uc9c0 \uc54a\uc73c\uba74 \ubaa9\ub85d \ud589\uc758 \uac12\uc73c\ub85c \ucc44\uc6c1\ub2c8\ub2e4.","type":"string"},"page_num":{"description":"\ucabd \ubc88\ud638. \uae30\ubcf8 1.","type":"integer"},"page_size":{"description":"\ud55c \ucabd\uc5d0 \ubc1b\uc744 \uac74\uc218. \uae30\ubcf8 10.","type":"integer"},"rcat_no":{"description":"\uc811\uc218\ubc88\ud638(rcatNo).","type":"string"},"rpt_pkg_pth":{"description":"\ubcf4\uace0\uc11c \ud15c\ud50c\ub9bf \uacbd\ub85c(rptPkgPth). \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \uc99d\uba85\uc11c \ubaa9\ub85d\uc5d0\uc11c \ucc3e\uc2b5\ub2c8\ub2e4.","type":"string"},"strt_dt":{"description":"\ubc1c\uae09 \uc99d\uba85\uc11c \ubaa9\ub85d\uc744 \ucc3e\uc744 \uc2dc\uc791\uc77c YYYYMMDD. cva_id \ub098 rcat_no \ub97c \ubaa9\ub85d\uc5d0\uc11c \ucc3e\uc544\uc57c \ud560 \ub54c \uc4f0\uba70, \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \ucd5c\uadfc 3\uc77c\uc744 \ubd05\ub2c8\ub2e4.","type":"string"}},"required":["cva_id","rcat_no"],"type":"object"},"name":"hometax__certificate__download","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\uc99d\uba85\uc11c \ub2e4\uc6b4\ub85c\ub4dc"}
