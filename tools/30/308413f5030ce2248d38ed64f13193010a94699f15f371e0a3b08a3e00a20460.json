{
 "description": "Create a principal identity (human or org behind agents). Gets its own Ed25519 keypair.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contact_channel": {
    "description": "Contact method (e.g. 'telegram:@aeoess')",
    "type": "string"
   },
   "disclosure_level": {
    "default": "public",
    "description": "How much identity to reveal",
    "enum": [
     "public",
     "verified-only",
     "minimal"
    ],
    "type": "string"
   },
   "display_name": {
    "description": "Human-readable name (e.g. 'Tima', 'Acme Corp')",
    "type": "string"
   },
   "domain": {
    "description": "Verifiable domain (e.g. 'aeoess.com')",
    "type": "string"
   },
   "jurisdiction": {
    "description": "Legal jurisdiction (e.g. 'US', 'EU')",
    "type": "string"
   }
  },
  "required": [
   "display_name"
  ],
  "type": "object"
 },
 "name": "create_principal"
}
