{
 "description": "Update an existing job. Only the fields you provide are changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "httpConfig": {
    "additionalProperties": false,
    "properties": {
     "body": {
      "maxLength": 1048576,
      "type": "string"
     },
     "headers": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "method": {
      "default": "GET",
      "enum": [
       "GET",
       "POST",
       "PUT",
       "PATCH",
       "DELETE",
       "HEAD",
       "OPTIONS"
      ],
      "type": "string"
     },
     "timeoutMs": {
      "default": 30000,
      "maximum": 300000,
      "minimum": 1000,
      "type": "integer"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "type": "object"
   },
   "id": {
    "type": "string"
   },
   "name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "retryPolicy": {
    "additionalProperties": false,
    "properties": {
     "backoffMultiplier": {
      "default": 2,
      "maximum": 10,
      "minimum": 1,
      "type": "number"
     },
     "initialDelay": {
      "default": 1000,
      "maximum": 60000,
      "minimum": 100,
      "type": "integer"
     },
     "maxDelay": {
      "default": 300000,
      "maximum": 3600000,
      "minimum": 1000,
      "type": "integer"
     },
     "maxRetries": {
      "default": 3,
      "maximum": 10,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "schedule": {
    "additionalProperties": false,
    "properties": {
     "expression": {
      "minLength": 1,
      "type": "string"
     },
     "timezone": {
      "type": "string"
     },
     "type": {
      "enum": [
       "cron",
       "interval",
       "once"
      ],
      "type": "string"
     }
    },
    "required": [
     "type",
     "expression"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "active",
     "paused",
     "completed",
     "failed"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 50,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_job"
}
