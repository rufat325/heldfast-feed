  "properties": {
   "cwd": {
    "description": "Repository path",
    "type": "string"
   },
   "paths": {
    "description": "Files to forget",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "paths"
  ],
  "type": "object"
 },
 "name": "sl_forget"
}
