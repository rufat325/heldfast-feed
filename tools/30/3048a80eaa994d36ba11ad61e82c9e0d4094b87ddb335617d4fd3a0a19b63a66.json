{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "project_todos:write"
    ],
    "type": "oauth2"
   }
  ],
  "stdioOnly": true
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "ONE-SHOT local-file feedback-image upload (stdio-only convenience over the same registry ops as prepare/finalize): stat-gates the file (regular, non-empty, \u22645 MiB), infers or validates the MIME type, computes SHA-256, reserves with your idempotencyKey (\u2264126 chars; finalize derives \"<key>:f\"), PUTs through the upsert-disabled grant, and finalizes with server-side verification. An ambiguous PUT reconciles through canonical finalize before any failure is declared. Signed URLs never appear in the result. Employer-only: writes need project_todos:write and reads need project_todos:read, plus canonical organization/job access. Freelancer quiz access is retired. Missing, foreign, wrong-owner, and closed-window are one indistinguishable 404. No base64 anywhere \u2014 bytes travel only through the signed grant.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "minLength": 1,
    "type": "string"
   },
   "contentType": {
    "enum": [
     "image/png",
     "image/jpeg",
     "image/webp",
     "image/gif"
    ],
    "type": "string"
   },
   "filePath": {
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 126,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "questionId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "filePath",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_coaching_image_upload",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "asset": {
      "additionalProperties": false,
      "properties": {
       "assetId": {
        "type": "string"
       },
       "byteSize": {
        "type": "integer"
       },
       "contentType": {
        "enum": [
         "image/png",
         "image/jpeg",
         "image/webp",
         "image/gif"
        ],
        "type": "string"
       },
       "createdAt": {
        "type": "string"
       },
       "heightPx": {
        "anyOf": [
         {
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "sha256": {
        "type": [
         "string",
         "null"
        ]
       },
       "status": {
        "enum": [
         "PENDING",
         "READY"
        ],
        "type": "string"
       },
       "uploaderRole": {
        "enum": [
         "EMPLOYER",
         "WORKER"
        ],
        "type": "string"
       },
       "widthPx": {
        "anyOf": [
         {
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "assetId",
       "status",
       "contentType",
       "byteSize",
       "widthPx",
       "heightPx",
       "sha256",
       "uploaderRole",
       "createdAt"
      ],
      "type": "object"
     },
     "replayed": {
      "type": "boolean"
     }
    },
    "required": [
     "asset",
