  "title": "Estimate stamp duty + registration (calculator)"
 },
 "description": "Estimate Indian state stamp duty + registration charges on a property purchase. Supports all 28 states + 8 UTs with buyer-gender concessions, urban/rural overrides, and commercial/agricultural multipliers. Pass constructionStatus to also itemize GST (under-construction 1%/5%, ready/resale 0%) for an all-in statutory quote. Returns supported=false for states outside India (supported set named in rateBasis). Not legal/tax advice. Always surface the disclaimer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "properties": {
   "buyerGender": {
    "description": "\"female\" (a woman), \"joint\" (a man and a woman together) or \"male\" (default; two women: female). Changes the price only where a state gives women a concession. Overrides isWomanBuyer.",
    "enum": [
     "male",
     "female",
     "joint"
    ],
    "type": "string"
   },
   "carpetAreaSqft": {
    "description": "Carpet area (sqft) \u2014 with value, decides the affordable-housing 1% GST slab.",
    "exclusiveMinimum": 0,
    "maximum": 100000,
    "type": "integer"
   },
   "city": {
    "description": "City or town, e.g. \"Pune\". Decides the rate where the state prices by location (MH, KA, WB, MP, HR): Pune 7%, Mumbai 6%. Send the place as the buyer names it (\"Kharghar\"), not the wider city it is listed under.",
    "maxLength": 60,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9 .,'\u2019()\\-\u0b80-\u0bff\u0900-\u097f]+$",
    "type": "string"
   },
   "constructionStatus": {
    "description": "When set, also itemizes GST: under-construction = 1% (affordable) / 5%; ready/resale = 0%. Omit \u2192 GST not computed.",
    "enum": [
     "under_construction",
     "ready_to_move",
     "resale"
    ],
    "type": "string"
   },
   "firstSale": {
    "description": "True for the FIRST sale of a flat, from the builder (not the buyer's first home); false for a resale. Changes the duty only where a state has a first-sale rate (KA). Omit when unknown: a resale is priced, and said where it matters. Absent: constructionStatus under_construction \u21d2 true, resale \u21d2 false, ready_to_move decides nothing (may be a resale).",
    "type": "boolean"
   },
   "isUrban": {
    "description": "Urban (default) or rural. Used for the location when city and localBody are absent.",
    "type": "boolean"
   },
   "isWomanBuyer": {
    "default": false,
    "description": "Backward-compatibility shim \u2014 prefer buyerGender. When true, internally treated as buyerGender=\"female\".",
    "type": "boolean"
   },
   "localBody": {
    "description": "Where the property is, in a state that prices by it (MH, KA, WB, MP, HR): gram_panchayat (village), municipal_council (town) or municipal_corporation (city); overrides city. Omit when unknown (a corporation is priced, and said).",
    "enum": [
     "municipal_corporation",
     "municipal_council",
     "gram_panchayat"
    ],
    "type": "string"
   },
   "propertyType": {
    "description": "residential (default), plot (bare land; a residential-only concession does not reach it), commercial or agricultural.",
    "enum": [
     "residential",
     "commercial",
     "agricultural",
     "plot"
    ],
    "type": "string"
   },
   "propertyValue": {
    "description": "Sale value in INR for stamp-duty calculation.",
    "exclusiveMinimum": 0,
    "maximum": 10000000000,
    "type": "integer"
   },
   "state": {
    "description": "Indian state \u2014 ISO code (\"MH\"), slug (\"maharashtra\") or name (\"Maharashtra\"). Required.",
    "maxLength": 50,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9 .,'\u2019()\\-\u0b80-\u0bff\u0900-\u097f]+$",
    "type": "string"
   }
  },
  "required": [
   "propertyValue",
   "state"
  ],
  "type": "object"
 },
 "name": "estimate_stamp_duty_and_registration",
