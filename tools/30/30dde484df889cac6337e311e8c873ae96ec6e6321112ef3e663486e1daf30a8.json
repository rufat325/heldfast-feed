{
 "description": "List the authenticated user's saved letter templates.",
 "inputSchema": {
  "properties": {
   "favorites_only": {
    "description": "Only return favorited templates.",
    "type": "boolean"
   },
   "search": {
    "description": "Filter templates by name or content substring.",
    "type": "string"
   },
   "sort": {
    "description": "Sort order. Defaults to \"recent\".",
    "enum": [
     "recent",
     "most_used",
     "name"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_templates"
}
