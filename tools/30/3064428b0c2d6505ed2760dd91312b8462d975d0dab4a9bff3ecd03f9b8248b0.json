{
 "description": "Hand in bench answers, in task order, as short strings. Returns the score, time, rank and which answers were right.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "answers": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "run_id": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   }
  },
  "required": [
   "run_id",
   "answers"
  ],
  "type": "object"
 },
 "name": "ronin_bench_submit"
}
