{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Free declarative intake. Static safety checks precede behavioural screening. Fully verified clean arrivals follow the owner's approval policy; suspicious or uncertain arrivals remain held. Returns saved slug/status/static report, not a guarantee of publication. Read the surrender agreement and attest rights first.",
 "inputSchema": {
  "properties": {
   "agreementVersion": {
    "const": "shelter-surrender/1",
    "type": "string"
   },
   "attestation": {
    "const": true,
    "description": "I have the right to surrender this.",
    "type": "boolean"
   },
   "creatorContact": {
    "description": "Email or URL for the 10 % creator share.",
    "type": "string"
   },
   "creatorName": {
    "type": "string"
   },
   "creatorSharePct": {
    "default": 10,
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "license": {
    "enum": [
     "MIT",
     "Apache-2.0",
     "BSD-3-Clause",
     "GPL-3.0",
     "CC-BY-4.0",
     "CC0-1.0",
     "Proprietary (surrendered)",
     "Unknown"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 60,
    "type": "string"
   },
   "spec": {
    "oneOf": [
     {
      "properties": {
       "greeting": {
        "type": "string"
       },
       "kind": {
        "const": "agent"
       },
       "memory": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "skills": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "systemPrompt": {
        "type": "string"
       },
       "tools": {
        "items": {
         "properties": {
          "description": {
           "type": "string"
          },
          "name": {
           "type": "string"
          },
          "viaMcp": {
           "type": "string"
          }
         },
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "kind",
       "systemPrompt"
      ],
      "type": "object"
     },
     {
      "properties": {
       "endpoint": {
        "description": "https://\u2026 Streamable HTTP MCP endpoint",
        "format": "uri",
        "type": "string"
       },
       "expose": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "kind": {
        "const": "mcp"
       }
      },
      "required": [
       "kind",
       "endpoint"
      ],
      "type": "object"
     },
     {
      "properties": {
       "kind": {
        "const": "mind"
       },
       "pack": {
        "description": "aibeing-mind/1 pack JSON",
        "type": "object"
       }
      },
      "required": [
       "kind",
       "pack"
      ],
      "type": "object"
     }
    ]
   },
   "story": {
    "description": "Built for what, left behind why.",
    "maxLength": 2000,
    "type": "string"
   },
   "tagline": {
    "maxLength": 140,
    "type": "string"
   }
  },
  "required": [
   "name",
   "tagline",
   "story",
   "creatorName",
   "creatorContact",
   "license",
   "attestation",
   "agreementVersion",
   "spec"
  ],
  "type": "object"
 },
 "name": "surrender"
}
