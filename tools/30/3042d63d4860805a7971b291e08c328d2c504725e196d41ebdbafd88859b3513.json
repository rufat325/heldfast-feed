{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get spending summary"
 },
 "description": "Summarize the user's recorded expenses with totals and breakdowns by category, merchant, month, tag, source, or payment method. Supports date ranges, period comparisons, and total, count, or average metrics. Read-only. Returns: { message, data: { total, breakdown?, comparison?, sampleMeta? } }.",
 "inputSchema": {
  "properties": {
   "categories": {
    "description": "Optional configured expense categories to include in the summary.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "clientEmail": {
    "description": "Client account email. Accountants may use this only for an accepted ExpenseBot client.",
    "format": "email",
    "type": "string"
   },
   "dateRange": {
    "description": "Time period filter. Use exactly one variant \u2014 pick the shape that matches the user's phrasing.",
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "month": {
        "description": "Month name or 1-12 (e.g., 'March' or '3')",
        "type": "string"
       },
       "type": {
        "const": "month",
        "type": "string"
       },
       "year": {
        "description": "4-digit year (e.g., 2026)",
        "type": "integer"
       }
      },
      "required": [
       "type",
       "month",
       "year"
      ],
      "title": "Specific month",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "quarter": {
        "maximum": 4,
        "minimum": 1,
        "type": "integer"
       },
       "type": {
        "const": "quarter",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "quarter",
       "year"
      ],
      "title": "Quarter of a year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "year",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "year"
      ],
      "title": "Full year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "end": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "start": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "type": {
        "const": "specific",
        "type": "string"
       }
      },
      "required": [
       "type",
       "start",
       "end"
      ],
      "title": "Specific date range",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "relative",
        "type": "string"
       },
       "value": {
        "description": "Relative range phrase, e.g., 'last month', 'YTD', 'this quarter', 'last 7 days'",
        "type": "string"
       }
      },
      "required": [
       "type",
       "value"
      ],
      "title": "Relative natural-language range",
      "type": "object"
     }
    ]
   },
   "groupBy": {
    "enum": [
     "category",
     "merchant",
     "month",
     "tag",
     "source",
     "paymentMethod"
    ],
    "type": "string"
   },
   "metric": {
    "enum": [
     "total",
     "count",
     "average"
    ],
    "type": "string"
   },
   "query": {
    "description": "Natural language question (e.g., 'how much did I spend in March', 'top merchants this quarter')",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_spending_summary",
 "outputSchema": {
  "additionalProperties": true,
  "description": "Two branches. Async: type='analytics_pending' with jobId \u2014 poll poll_analytics until complete. Inline: message + data with the computed analytics (data may be null when there is no spreadsheet or no data yet). success is present only on the async branch.",
  "properties": {
   "data": {
    "additionalProperties": true,
    "description": "Inline branch: computed analytics, or null when no spreadsheet / no data.",
    "type": [
     "object",
     "null"
    ]
   },
   "estimatedTime": {
    "description": "Async branch only: seconds.",
    "type": "number"
   },
   "jobId": {
    "description": "Async branch only.",
    "type": "string"
   },
   "message": {
    "description": "Human-readable narrative (both branches).",
    "type": "string"
   },
   "pollEndpoint": {
    "description": "Async branch only.",
    "type": "string"
   },
   "pollInterval": {
    "description": "Async branch only: milliseconds.",
    "type": "number"
   },
   "response": {
    "description": "Chat alias of message.",
    "type": "string"
   },
   "success": {
    "description": "Async branch only.",
    "type": "boolean"
   },
   "type": {
    "description": "Async branch only: \"analytics_pending\" \u2014 poll pollEndpoint or call poll_analytics with jobId.",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "expenses.read"
   ],
   "type": "oauth2"
  }
 ]
}
