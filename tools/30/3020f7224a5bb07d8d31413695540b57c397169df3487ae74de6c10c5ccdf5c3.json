{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Revoke a hosting user (FTP / SSH access). Two-phase commit. Existing files are not deleted.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "description": "Token from the first (plan) phase. Re-pass on the second call to actually revoke access. Omit on first call to receive the plan + token.",
    "format": "uuid",
    "type": "string"
   },
   "hosting_id": {
    "description": "Web hosting ID. Discover via infomaniak_list_hostings.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "login": {
    "description": "Full user login as shown by infomaniak_list_hosting_users (includes the hosting prefix, e.g. 'q387gx_audit'). User's files are preserved on disk; only access is revoked.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "hosting_id",
   "login"
  ],
  "type": "object"
 },
 "name": "infomaniak_delete_hosting_user",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "hosting_id": {
        "type": "number"
       },
       "login": {
        "type": "string"
       }
      },
      "required": [
       "hosting_id",
       "login"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "login": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "login",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
