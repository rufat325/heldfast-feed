{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Returns open 30-minute intro call slots with SpinGras, grouped by date.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "days": {
    "default": 7,
    "maximum": 14,
    "minimum": 1,
    "type": "integer"
   },
   "from": {
    "description": "First date to check, YYYY-MM-DD. Defaults to today.",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "timeZone": {
    "default": "Europe/Amsterdam",
    "description": "IANA time zone for returned times",
    "maxLength": 64,
    "pattern": "^[A-Za-z_]+(\\/[A-Za-z0-9_+-]+){0,2}$|^UTC$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_intro_slots",
 "title": "Free slots for a 30-minute intro call"
}
