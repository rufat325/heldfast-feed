                      "description": "The served Variation's identifier."
                     },
                     "stringValue": {
                      "description": "The served value in case of a text Setting.",
                      "type": [
                       "string",
                       "null"
                      ]
                     }
                    },
                    "type": "object"
                   },
                   "prerequisiteSettingId": {
                    "description": "The prerequisite flag's identifier.",
                    "type": "integer"
                   }
                  },
                  "required": [
