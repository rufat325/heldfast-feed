                    "enum": [
                     "isOneOf",
                     "isNotOneOf",
                     "containsAnyOf",
                     "doesNotContainAnyOf",
                     "semVerIsOneOf",
                     "semVerIsNotOneOf",
                     "semVerLess",
                     "semVerLessOrEquals",
                     "semVerGreater",
                     "semVerGreaterOrEquals",
                     "numberEquals",
                     "numberDoesNotEqual",
                     "numberLess",
                     "numberLessOrEquals",
                     "numberGreater",
                     "numberGreaterOrEquals",
                     "sensitiveIsOneOf",
                     "sensitiveIsNotOneOf",
                     "dateTimeBefore",
                     "dateTimeAfter",
                     "sensitiveTextEquals",
                     "sensitiveTextDoesNotEqual",
                     "sensitiveTextStartsWithAnyOf",
                     "sensitiveTextNotStartsWithAnyOf",
