     },
     "headline": {
      "type": "string"
     },
     "language": {
      "type": "string"
     },
     "logoUrl": {
      "type": "string"
     },
     "palette": {
      "additionalProperties": false,
      "properties": {
       "backgroundColor": {
        "type": "string"
