{
 "description": "Generate a formatted worklog markdown entry for a development session. Pure template \u2014 no AI needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent": {
    "default": "AI",
    "description": "Who did the work",
    "type": "string"
   },
   "branch": {
    "description": "Git branch name",
    "type": "string"
   },
   "changes": {
    "description": "List of changes made",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "added",
        "modified",
        "removed"
       ],
       "type": "string"
      },
      "detail": {
       "type": "string"
      },
      "target": {
       "type": "string"
      }
     },
     "required": [
      "action",
      "target",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "date": {
    "description": "Session date in YYYY-MM-DD format",
    "type": "string"
   },
   "decisions": {
    "description": "Key decisions made and why",
    "type": "string"
   },
   "files": {
    "description": "Files touched in this session",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "created",
        "modified",
        "deleted"
       ],
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "action",
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "goal": {
    "description": "One sentence: what this session set out to do",
    "type": "string"
   },
   "lockDelta": {
    "description": "What changed in product.lock.json",
    "type": "string"
   },
   "lockVersion": {
    "description": "Lock version before this session",
    "type": "string"
   },
   "next": {
    "description": "What the next session should pick up",
    "type": "string"
   },
   "plsAfter": {
    "description": "PLS score after this session",
    "type": "number"
   },
   "plsBefore": {
    "description": "PLS score before this session",
    "type": "number"
   },
   "title": {
    "description": "Session title (short description)",
    "type": "string"
   }
  },
  "required": [
   "date",
   "title",
   "branch",
   "goal",
   "changes"
  ],
  "type": "object"
 },
 "name": "create_worklog"
}
