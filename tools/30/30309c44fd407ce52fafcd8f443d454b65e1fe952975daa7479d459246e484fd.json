{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Resolve an exact name through the bound provider's exhaustively paged name inventory and return a resolved or unresolved result. Unresolved names use the stable name_not_found reason; this compact xref workflow returns address-only projections.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
   {
    "name": "malloc"
   }
  ],
  "properties": {
   "name": {
    "description": "Exact name used by this operation.",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "find_xrefs_to_name",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "address": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "status": {
        "const": "resolved",
        "type": "string"
       },
       "xrefs": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "status",
       "name",
       "address",
       "xrefs"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string"
       },
       "reason": {
        "const": "name_not_found",
        "type": "string"
       },
       "status": {
        "const": "unresolved",
        "type": "string"
       }
      },
      "required": [
       "status",
       "name",
       "reason"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Find Xrefs To Name"
}
