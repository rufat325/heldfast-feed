{
 "description": "Cubic volume of a log by classical formula: Huber (mid diameter only), Smalian (both end diameters) or Newton (all three, most accurate). Metric (cm, m) or imperial (in, ft); returns volume in m3 and ft3.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "diameter_large": {
    "description": "Large-end diameter (smalian/newton)",
    "minimum": 0,
    "type": "number"
   },
   "diameter_mid": {
    "description": "Mid-length diameter (huber/newton)",
    "minimum": 0,
    "type": "number"
   },
   "diameter_small": {
    "description": "Small-end diameter (smalian/newton)",
    "minimum": 0,
    "type": "number"
   },
   "length": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "method": {
    "default": "huber",
    "enum": [
     "huber",
     "smalian",
     "newton"
    ],
    "type": "string"
   },
   "unit": {
    "default": "metric",
    "description": "metric: diameters in cm, length in m; imperial: in and ft",
    "enum": [
     "metric",
     "imperial"
    ],
    "type": "string"
   }
  },
  "required": [
   "length"
  ],
  "type": "object"
 },
 "name": "log_volume"
}
