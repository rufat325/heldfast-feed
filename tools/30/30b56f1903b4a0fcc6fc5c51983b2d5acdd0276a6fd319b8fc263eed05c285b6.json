{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "RSVP to a calendar event invitation (accept, decline, or tentative)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "calendarId": {
    "default": "primary",
    "description": "Calendar ID",
    "type": "string"
   },
   "eventId": {
    "description": "Event ID to respond to",
    "type": "string"
   },
   "response": {
    "description": "Your response to the event invitation",
    "enum": [
     "accepted",
     "declined",
     "tentative"
    ],
    "type": "string"
   },
   "sendUpdates": {
    "default": "all",
    "description": "Who to send notifications to",
    "enum": [
     "all",
     "externalOnly",
     "none"
    ],
    "type": "string"
   }
  },
  "required": [
   "eventId",
   "response"
  ],
  "type": "object"
 },
 "name": "event_respond",
 "title": "Respond to event"
}
