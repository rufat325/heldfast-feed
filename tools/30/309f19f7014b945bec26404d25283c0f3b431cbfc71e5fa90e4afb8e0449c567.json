{
 "description": "Attest to an interaction with evidence, a -1/0/+1 verdict and sponsorship disclosures. This is a submitted opinion, not independently verified evidence.",
 "inputSchema": {
  "properties": {
   "attestation": {
    "properties": {
     "context": {
      "type": "string"
     },
     "evidenceIds": {
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "type": "array"
     },
     "financialRelationship": {
      "default": "",
      "type": "string"
     },
     "interactionId": {
      "format": "uuid",
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "sponsored": {
      "default": false,
      "type": "boolean"
     },
     "verdict": {
      "type": "integer"
     },
     "visibility": {
      "default": "private",
      "type": "string"
     }
    },
    "required": [
     "interactionId",
     "context",
     "verdict",
     "reason",
     "evidenceIds"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "type": "string"
   }
  },
  "required": [
   "attestation",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "create_attestation"
}
