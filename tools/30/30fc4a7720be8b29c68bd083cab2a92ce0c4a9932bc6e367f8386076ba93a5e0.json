{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update the name, URL, adapter, or enabled state of one independent Yolfi webhook endpoint.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "adapter": {
    "description": "Webhook adapter output format.",
    "enum": [
     "NONE",
     "STRIPE",
     "LEMON_SQUEEZY"
    ],
    "type": "string"
   },
   "enabled": {
    "description": "Whether this endpoint receives new deliveries.",
    "type": "boolean"
   },
   "id": {
    "description": "Webhook endpoint id.",
    "type": "string"
   },
   "metadataFilters": {
    "additionalProperties": {
     "maxLength": 255,
     "type": "string"
    },
    "description": "Optional flat key/value metadata filters. A delivery must match every configured string value.",
    "maxProperties": 10,
    "propertyNames": {
     "maxLength": 100
    },
    "type": "object"
   },
   "name": {
    "description": "Endpoint display name.",
    "type": "string"
   },
   "url": {
    "description": "HTTPS webhook URL.",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "yolfi_webhooks_update",
 "title": "Update Yolfi Webhook Endpoint"
}
