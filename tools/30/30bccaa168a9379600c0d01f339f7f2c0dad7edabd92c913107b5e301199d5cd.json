{
 "description": "Run pre-publish SEO QA for metadata, indexability, canonical, headings, schema, links, and media.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "check_external_links": {
    "default": false,
    "type": "boolean"
   },
   "expected_canonical": {
    "format": "uri",
    "type": "string"
   },
   "html": {
    "maxLength": 250000,
    "minLength": 80,
    "type": "string"
   },
   "keyword": {
    "minLength": 1,
    "type": "string"
   },
   "markdown": {
    "maxLength": 50000,
    "minLength": 80,
    "type": "string"
   },
   "page_type": {
    "default": "auto",
    "enum": [
     "auto",
     "article",
     "blog_post",
     "landing_page",
     "product",
     "software",
     "local_business",
     "comparison_page",
     "guide",
     "docs"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "agentseo_content_technical_qa",
 "title": "AgentSEO Content Technical QA"
}
