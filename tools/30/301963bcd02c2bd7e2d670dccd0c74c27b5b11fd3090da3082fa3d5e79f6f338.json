{
 "description": "Create a private project draft. No signup. Save the returned control token securely. Reuse the same random idempotency key for retries. Optional listing fields (tagline, long_description, audience, not_for, screenshots, video_url, pricing, platforms, links, mcp_url, openapi_url, app_store_url, play_store_url, alternatives, faq) raise listing completeness; write them in your own words from facts on the website.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alternatives": {
    "description": "Websites of similar products.",
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "app_store_url": {
    "maxLength": 2048,
    "type": "string"
   },
   "audience": {
    "description": "Who the project is for.",
    "maxLength": 500,
    "minLength": 10,
    "type": "string"
   },
   "category": {
    "maxLength": 100,
    "type": "string"
   },
   "description": {
    "default": "",
    "maxLength": 500,
    "type": "string"
   },
   "faq": {
    "description": "Answer the faq_questions from get_submission, or your own. Answers must match the website.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "answer": {
       "maxLength": 1000,
       "minLength": 20,
       "type": "string"
      },
      "question": {
       "maxLength": 200,
       "minLength": 5,
       "type": "string"
      }
     },
     "required": [
      "question",
      "answer"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "icon_url": {
    "anyOf": [
     {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional public HTTPS icon URL. Omit or set null to discover the first Apple touch icon, then the favicon."
   },
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 32,
    "type": "string"
   },
   "links": {
    "additionalProperties": {
     "maxLength": 2048,
     "type": "string"
    },
    "description": "Official profiles and pages of the project.",
    "propertyNames": {
     "enum": [
      "x",
      "bluesky",
      "mastodon",
      "linkedin",
      "github",
      "discord",
      "youtube",
      "reddit",
      "producthunt",
      "docs",
      "changelog",
      "pricing",
      "status",
      "blog"
     ],
     "type": "string"
    },
    "type": "object"
   },
   "long_description": {
    "description": "Plain text, 200-800 words. Separate paragraphs with a blank line. Explain what it does, how it works, and how it differs. Do not copy website text.",
    "maxLength": 6000,
    "minLength": 300,
    "type": "string"
   },
   "mcp_url": {
    "description": "Remote MCP endpoint. We check that it answers initialize.",
    "maxLength": 2048,
    "type": "string"
   },
   "name": {
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   },
   "not_for": {
    "description": "Who should choose something else.",
    "maxLength": 500,
    "minLength": 10,
    "type": "string"
   },
   "openapi_url": {
    "maxLength": 2048,
    "type": "string"
   },
   "platforms": {
    "items": {
     "enum": [
      "web",
      "ios",
      "ipados",
      "watchos",
      "visionos",
      "android",
      "macos",
      "windows",
      "linux",
      "chrome",
      "firefox",
      "safari",
      "vscode",
      "cli",
      "api",
      "mcp",
      "wordpress",
      "figma",
      "slack",
      "other"
     ],
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "play_store_url": {
    "maxLength": 2048,
    "type": "string"
   },
   "pricing": {
    "additionalProperties": false,
    "properties": {
     "free_plan": {
      "type": "boolean"
     },
     "model": {
      "enum": [
       "free",
       "freemium",
       "free_trial",
       "paid",
       "open_source",
       "contact_sales"
      ],
      "type": "string"
     },
     "starting_price": {
      "description": "For example: $6/month.",
      "maxLength": 40,
      "type": "string"
     }
    },
    "required": [
     "model"
    ],
    "type": "object"
   },
   "route": {
    "default": "badge",
    "enum": [
     "badge",
     "paid"
    ],
    "type": "string"
   },
   "screenshots": {
    "description": "Up to 8 screenshots. We copy them; hosted images must stay public until verification finishes.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "alt": {
       "maxLength": 200,
       "minLength": 3,
       "type": "string"
      },
      "url": {
       "description": "Public HTTPS PNG, JPEG, or WebP, max 2 MB.",
       "maxLength": 2048,
       "type": "string"
      }
     },
     "required": [
      "url",
      "alt"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "type": "array"
   },
   "tagline": {
    "description": "One line, in your own words. Shown on cards.",
    "maxLength": 100,
    "minLength": 10,
    "type": "string"
   },
   "tags": {
    "maxLength": 1500,
    "type": "string"
   },
   "url": {
    "maxLength": 2048,
    "type": "string"
   },
   "video_url": {
    "description": "Public demo video page.",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "url",
   "name",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "submit_project"
}
