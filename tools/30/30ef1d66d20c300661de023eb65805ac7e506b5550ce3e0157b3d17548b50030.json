{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Extract a zip archive in Nextcloud into a destination folder. Runs server-side.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "archive": {
    "description": "Path to the .zip file (e.g., '/Documents/backup.zip')",
    "type": "string"
   },
   "destination": {
    "description": "Folder to extract into (e.g., '/Documents/restored')",
    "type": "string"
   },
   "overwrite": {
    "default": false,
    "description": "Whether to overwrite entries that already exist",
    "type": "boolean"
   }
  },
  "required": [
   "archive",
   "destination"
  ],
  "type": "object"
 },
 "name": "extract_archive",
 "title": "Extract Archive"
}
