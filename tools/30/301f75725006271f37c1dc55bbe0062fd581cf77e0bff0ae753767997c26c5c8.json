{"annotations":{"openWorldHint":true,"readOnlyHint":true},"description":"Build a requirements traceability matrix: map each requirement and acceptance criterion of a Jira issue to the changed files that implement it, and flag gaps. Fetches the issue itself. For a ready-for-PR verdict use delivery_check_changes.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"baseBranch":{"default":"origin/main","description":"Base branch to diff against","type":"string"},"compareRef":{"default":"HEAD","description":"Branch or commit to compare","type":"string"},"includeConfluence":{"default":true,"description":"Include requirements found in Confluence","type":"boolean"},"includePrDiff":{"default":true,"description":"Match requirements against the local diff","type":"boolean"},"issueKey":{"description":"Jira issue key (e.g. PROJ-123)","type":"string"},"repoPath":{"default":".","description":"Path to the git repository","type":"string"}},"required":["issueKey"],"type":"object"},"name":"delivery_traceability_matrix","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"issueKey":{"type":"string"},"markdown":{"type":"string"},"schemaVersion":{"const":"2.0","type":"string"},"tool":{"type":"string"},"warnings":{"items":{"type":"string"},"type":"array"}},"required":["schemaVersion","tool","markdown","warnings"],"type":"object"},"title":"Build a requirement traceability matrix"}
