 "description": "Which countries had their Japan MOFA danger or infectious disease danger levels (or region texts) change since a given time? From this service's own observation record: old and new levels, MOFA info ids and issue dates, when we observed the change and when we last saw the old state, plus polling gaps. Only changes since tracking_since, as observed at our polling times. Free window: last 30 days (an earlier since is clamped; see history_window). Relays MOFA; no advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "description": "Optional filter: ISO alpha-2/alpha-3 or 4-digit MOFA code",
    "maxLength": 16,
    "type": "string"
   },
   "include_notice_updates": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "Also list re-issued notices with the same levels and region text (default false)"
   },
   "limit": {
    "description": "Maximum number of changes, 1-200 (default 100)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "ISO 8601 date or date-time with time zone, e.g. 2026-10-01T00:00:00Z",
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "since"
  ],
  "type": "object"
 },
