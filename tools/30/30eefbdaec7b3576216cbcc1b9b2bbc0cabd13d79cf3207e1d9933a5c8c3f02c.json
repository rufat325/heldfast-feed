{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read strategy"
 },
 "description": "Reads a strategy, its section identifiers and Markdown, and its current revision for subsequent edits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "strategy_id": {
    "description": "Strategy identifier",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "strategy_id"
  ],
  "type": "object"
 },
 "name": "get_strategy",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "id": {
    "type": "string"
   },
   "kind": {
    "const": "STRATEGY",
    "type": "string"
   },
   "refNum": {
    "type": [
     "string",
     "null"
    ]
   },
   "revision": {
    "type": "string"
   },
   "sections": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "anyOf": [
     {
      "enum": [
       "DRAFT",
       "PUBLISHED"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "title": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "title",
   "kind",
   "revision",
   "sections",
   "url"
  ],
  "type": "object"
 },
 "title": "Read strategy"
}
