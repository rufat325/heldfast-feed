{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "visibility": [
    "app"
   ]
  },
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Return prepared material"
 },
 "description": "Supplies private Water pixels or a material sample for the exact pending request; the kernel retains source-edit authority.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "editorKey": {
    "description": "The editor key from private tool-result _meta.rapier, held by the host and editor alone.",
    "maxLength": 512,
    "type": "string"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "fact": {
    "additionalProperties": false,
    "properties": {
     "documentId": {
      "maxLength": 256,
      "type": "string"
     },
     "job": {
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "kind": {
      "const": "material",
      "type": "string"
     },
     "outcome": {
      "enum": [
       "ok",
       "refused"
      ],
      "type": "string"
     },
     "reason": {
      "maxLength": 128,
      "type": "string"
     },
     "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "value": {
      "additionalProperties": true,
      "type": "object"
     }
    },
    "required": [
     "kind",
     "documentId",
     "revision",
     "job",
     "outcome"
    ],
    "type": "object"
   },
   "materialId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "document",
   "editorKey",
   "expectedRevision",
   "materialId",
   "fact"
  ],
  "type": "object"
 },
 "name": "document.material_ack",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "materialId": {
    "maxLength": 128,
    "type": "string"
   },
   "outcome": {
    "enum": [
     "ok",
     "refused",
     "uncertain"
    ],
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Return prepared material"
}
