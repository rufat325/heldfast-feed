        "move",
        "copy"
       ],
       "type": "string"
      },
      "path": {
       "description": "Bucket-relative file path, for example index.html or assets/app.js.",
       "type": "string"
      },
      "reason": {
       "description": "Optional reason for this action. AI agents should include a short purpose for intentional reads and changes when known. Do not invent a reason or include secrets, file contents, or transcripts.",
       "maxLength": 2000,
       "type": [
        "string",
        "null"
       ]
      },
      "target_bucket_id": {
       "description": "Destination bucket id; omit when the destination is the source bucket.",
