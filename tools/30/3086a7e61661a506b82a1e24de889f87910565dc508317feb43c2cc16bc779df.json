  "readOnlyHint": true
 },
 "description": "Controleer welke accommodaties (exclusief Camp & Dinner) vrij zijn voor een periode, met prijs, waarborg en directe booking_url. Niet-beschikbare types bevatten reden_code + suggestie_code.",
 "inputSchema": {
  "properties": {
   "aankomst": {
    "description": "Aankomstdatum YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "lang": {
    "description": "Taal van de tekstvelden (default nl).",
    "enum": [
     "nl",
     "en",
     "fr",
     "de"
    ],
    "type": "string"
   },
   "personen": {
    "description": "Aantal personen (default 2).",
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   },
   "vertrek": {
    "description": "Vertrekdatum YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "aankomst",
   "vertrek"
  ],
  "type": "object"
 },
 "name": "getAvailability",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "aankomst": {
    "type": "string"
   },
   "aantal_beschikbaar": {
    "type": "integer"
   },
   "algemene_booking_url": {
    "type": "string"
   },
   "beschikbaar": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "beschikbaar": {
       "type": "boolean"
      },
      "booking_url": {
       "type": "string"
      },
      "foto_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "info_url": {
       "type": "string"
      },
      "kenmerken": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "max_personen": {
       "type": "integer"
      },
      "naam": {
       "type": "string"
      },
      "prijs": {
       "additionalProperties": false,
       "properties": {
        "per_nacht_euro": {
         "type": "integer"
        },
        "totaal_na_korting_euro": {
         "type": "integer"
        },
        "totaal_te_betalen_euro": {
         "type": "integer"
        },
