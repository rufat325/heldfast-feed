{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List recent n8n executions"
 },
 "description": "List recent executions from a live n8n instance (requires N8N_API_URL + N8N_API_KEY). Filter by workflowId, status (success|error|waiting), limit. Pass `includeData: true` to get the full execution body (large) \u2014 pair with execution_explain to diagnose a specific failure.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "includeData": {
    "description": "Include full execution data (large). Default false \u2014 pair with execution_explain.",
    "type": "boolean"
   },
   "limit": {
    "description": "Page size (n8n default: 100, max: 250).",
    "exclusiveMinimum": 0,
    "maximum": 250,
    "type": "integer"
   },
   "status": {
    "description": "Filter by status: success | error | waiting.",
    "enum": [
     "success",
     "error",
     "waiting"
    ],
    "type": "string"
   },
   "workflowId": {
    "description": "Filter by workflow ID.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "execution_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Number of executions returned.",
    "type": "integer"
   },
   "executions": {
    "description": "Either trimmed summaries (default) or full execution bodies (includeData=true).",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "finished": {},
        "id": {},
        "mode": {},
        "startedAt": {},
        "status": {},
        "stoppedAt": {},
        "workflowId": {}
       },
       "type": "object"
      },
      {
       "additionalProperties": {},
       "type": "object"
      }
     ]
    },
    "type": "array"
   }
  },
  "required": [
   "executions",
   "count"
  ],
  "type": "object"
 },
 "title": "List recent n8n executions"
}
