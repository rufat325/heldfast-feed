{
 "description": "Type annotations in one file that TypeScript would infer anyway (redundant) or that are wider than the inferred type (widening, often an intended contract). Use when reviewing or cleaning up types.",
 "inputSchema": {
  "properties": {
   "file": {
    "description": "TS/JS file: absolute, or relative to the server's cwd",
    "type": "string"
   },
   "project": {
    "description": "tsconfig.json; default: the nearest one above file",
    "type": "string"
   }
  },
  "required": [
   "file"
  ],
  "type": "object"
 },
 "name": "annotations",
 "outputSchema": {
  "properties": {
   "error": {
    "properties": {
     "candidates": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "code": {
      "enum": [
       "INVALID_ARGUMENT",
       "FILE_NOT_FOUND",
       "SYMBOL_NOT_FOUND",
       "TYPESCRIPT_ERROR",
       "INTERNAL_ERROR"
      ]
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "result": {
    "properties": {
     "checkedCount": {
      "type": "number"
     },
     "file": {
      "type": "string"
     },
     "findings": {
      "items": {
       "properties": {
        "column": {
         "type": "number"
        },
        "declared": {
         "type": "string"
        },
        "endColumn": {
         "type": "number"
        },
        "endLine": {
         "type": "number"
        },
        "exported": {
         "type": "boolean"
        },
        "inferred": {
         "type": "string"
        },
        "kind": {
         "enum": [
          "redundant",
          "widening"
         ]
        },
        "line": {
         "type": "number"
        },
        "name": {
         "type": "string"
        },
        "suggestion": {
         "type": "string"
        },
        "target": {
         "enum": [
          "variable",
          "parameter",
          "property",
          "return"
         ]
        }
       },
       "required": [
        "line",
        "column",
        "endLine",
        "endColumn",
        "name",
        "target",
        "kind",
        "declared",
        "inferred",
        "exported",
        "suggestion"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "redundantCount": {
      "type": "number"
     },
     "wideningCount": {
      "type": "number"
     }
    },
    "required": [
     "file",
     "findings",
     "redundantCount",
     "wideningCount",
     "checkedCount"
    ],
    "type": "object"
   },
   "version": {
    "const": 1
   }
  },
  "required": [
   "version",
   "ok"
  ],
  "type": "object"
 }
}
