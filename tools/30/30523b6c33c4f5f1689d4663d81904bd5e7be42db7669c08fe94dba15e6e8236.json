{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Build bounded district packs with source filing details. Deficit spending is signed net operating result / expenditure; negative means deficit.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "basis": {
    "default": "estimated_actuals",
    "enum": [
     "estimated_actuals",
     "unaudited_actuals",
     "adopted_budget",
     "first_interim",
     "second_interim"
    ],
    "title": "Basis",
    "type": "string"
   },
   "client_id": {
    "anyOf": [
     {
      "pattern": "^sacs_client_[0-9a-f]{32}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Client Id"
   },
   "detail": {
    "default": "summary",
    "enum": [
     "summary",
     "full"
    ],
    "title": "Detail",
    "type": "string"
   },
   "district_identifiers": {
    "items": {
     "maxLength": 100,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 25,
    "minItems": 1,
    "title": "District Identifiers",
    "type": "array"
   },
   "fiscal_year_max": {
    "anyOf": [
     {
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Fiscal Year Max"
   },
   "fiscal_year_min": {
    "anyOf": [
     {
      "pattern": "^[0-9]{4}-[0-9]{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Fiscal Year Min"
   },
   "fund_codes": {
    "anyOf": [
     {
      "description": "Defaults to Fund 01 (General Fund); two bounds request an explicit inclusive range.",
      "items": {
       "description": "Inclusive two-digit SACS fund bound",
       "pattern": "^[0-9]{2}$",
       "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Fund Codes"
   },
   "include_balance_sheet_from_actuals": {
    "default": true,
    "title": "Include Balance Sheet From Actuals",
    "type": "boolean"
   },
   "one_time_resource_codes": {
    "anyOf": [
     {
      "items": {
       "pattern": "^[0-9]{4}$",
       "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "One Time Resource Codes"
   }
  },
  "required": [
   "district_identifiers"
  ],
  "title": "sacs_district_context_pack_batchArguments",
  "type": "object"
 },
 "name": "sacs_district_context_pack_batch",
 "outputSchema": {
  "$defs": {
   "PublicError": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "invalid_request",
       "not_found",
       "private_scope_denied",
       "dataset_mismatch",
       "payload_rejected",
       "backend_unavailable"
      ],
      "title": "Code",
      "type": "string"
     },
     "message": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Message",
      "type": "string"
     },
     "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "title": "PublicError",
    "type": "object"
   },
   "SourceProvenance": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Description",
      "type": "string"
     },
     "record_ref": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Record Ref",
      "type": "string"
     },
     "source": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Source",
      "type": "string"
     }
    },
    "required": [
     "source",
     "record_ref",
     "description"
    ],
    "title": "SourceProvenance",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "contract_version": {
    "const": "sacs.mcp.v1",
    "default": "sacs.mcp.v1",
    "title": "Contract Version",
    "type": "string"
   },
   "data": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Data"
   },
   "data_version": {
    "maxLength": 256,
    "minLength": 1,
    "title": "Data Version",
    "type": "string"
   },
   "error": {
    "anyOf": [
     {
      "$ref": "#/$defs/PublicError"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "title": "Limitations",
    "type": "array"
   },
   "ok": {
    "title": "Ok",
    "type": "boolean"
   },
   "request_id": {
    "maxLength": 128,
    "minLength": 8,
    "title": "Request Id",
    "type": "string"
   },
   "source_provenance": {
    "items": {
     "$ref": "#/$defs/SourceProvenance"
    },
    "title": "Source Provenance",
    "type": "array"
   }
  },
  "required": [
   "data_version",
   "request_id",
   "ok"
  ],
  "title": "PublicToolResponse",
  "type": "object"
 }
}
