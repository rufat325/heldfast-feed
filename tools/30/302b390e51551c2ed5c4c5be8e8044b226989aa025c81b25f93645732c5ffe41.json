{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants to find something across the transcripts they made in the last day, for example \"where did I talk about pricing\", \"which hooks did I open with\", \"what themes keep coming up\". Searches only the caller's own saved transcripts (the latest 10, kept 24 hours). Pass query for passages; leave it out to list the transcripts and their repeated themes. Returns passages with transcript_id, timestamps and a snippet, repeated themes with counts, and the live transcripts. Pass library_id only if transcribe_media returned one.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "library_id": {
    "description": "The library_id that transcribe_media returned. Only needed when transcribe_media returned one; leave it out otherwise.",
    "pattern": "^lib_[0-9a-f]{24}$",
    "type": "string"
   },
   "limit": {
    "default": 8,
    "description": "Most passages to return (default 8).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Words or a phrase to look for, such as a topic or a hook. Leave out to list the transcripts and their repeated themes only.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_transcripts",
 "outputSchema": {
  "properties": {
   "as_of": {
    "type": "string"
   },
   "matches": {
    "items": {
     "properties": {
      "at": {
       "type": "string"
      },
      "end": {
       "type": "number"
      },
      "matched_terms": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "snippet": {
       "type": "string"
      },
      "start": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "transcript_id": {
       "type": "string"
      }
     },
     "required": [
      "transcript_id",
      "start",
      "end",
      "snippet"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "query": {
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "enum": [
     "ok",
     "empty"
    ],
    "type": "string"
   },
   "themes": {
    "items": {
     "properties": {
      "first": {
       "properties": {
        "at": {
         "type": "string"
        },
        "start": {
         "type": "number"
        },
        "transcript_id": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "mentions": {
       "type": "integer"
      },
      "term": {
       "type": "string"
      },
      "transcripts": {
       "type": "integer"
      }
     },
     "required": [
      "term",
      "mentions"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "transcripts": {
    "items": {
     "properties": {
      "duration_seconds": {
       "type": "integer"
      },
      "expires_at": {
       "type": "string"
      },
      "language": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "transcript_id": {
       "type": "string"
      }
     },
     "required": [
      "transcript_id",
      "title",
      "duration_seconds",
      "expires_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "status",
   "as_of",
   "matches",
   "themes",
   "transcripts",
   "notes"
  ],
  "type": "object"
 },
 "title": "Search your saved transcripts"
}
