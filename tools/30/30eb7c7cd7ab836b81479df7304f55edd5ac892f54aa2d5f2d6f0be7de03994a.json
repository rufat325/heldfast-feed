{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Make a link that opens Toys Hub's checkout with these products already in the cart. Give it to the shopper; they confirm and pay on the store's site. Nothing is ordered or stored by this tool.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "quantity": {
       "default": 1,
       "maximum": 20,
       "minimum": 1,
       "type": "integer"
      },
      "slug": {
       "type": "string"
      }
     },
     "required": [
      "slug"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "lang": {
    "default": "en",
    "description": "Language of names, descriptions and links: \"sq\" Albanian, \"en\" English.",
    "enum": [
     "sq",
     "en"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "create_cart_link",
 "outputSchema": {
  "properties": {
   "checkoutUrl": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "items": {
    "type": "array"
   },
   "skipped": {
    "type": "array"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "checkoutUrl",
   "items"
  ],
  "type": "object"
 },
 "title": "Checkout link"
}
