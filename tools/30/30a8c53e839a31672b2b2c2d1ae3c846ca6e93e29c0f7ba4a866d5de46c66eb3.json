{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Extract a PDF into page-delimited Markdown with metadata and a source digest. Costs $0.0025.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "maxPages": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "pdfBase64": {
    "maxLength": 11200000,
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "pdf_to_markdown",
 "title": "Convert PDF to Markdown"
}
