 "description": "Given a glass coating/product (e.g. 'SNX 62/27', 'Solarban 70', 'SN 68', 'VNE-53', or an old name like 'Solarban 70XL'), return equivalents from other makers with a match rating (Close / Approximate / Not supported by the numbers). Uses (1) the KB's Guardian\u2194Vitro chart with tested deltas (Topic 32 \u00a732.9), (2) computed nearest makeups across Vitro, Guardian and Viracon on the same substrate color family using the KB rating rule, and (3) Topic 29 renamed/discontinued notices. Use for 'or-equal' and substitution screening (e.g. 'SNX 62/27 Vitro equivalent'). Responses keep the KB's confidence tags: [V] verified, [V-mfr] manufacturer claim, [UNVERIFIED], [inference], [Expert] field experience.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_discontinued": {
    "description": "Include discontinued makeups among computed matches (default false).",
    "type": "boolean"
   },
   "limit": {
    "description": "Max computed matches per source makeup (default 5).",
    "maximum": 15,
    "minimum": 1,
    "type": "integer"
   },
   "product": {
    "description": "Source glass product, e.g. 'SNX 62/27' or 'Guardian SN 68' or 'Solarban R100'.",
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   },
   "substrate": {
    "description": "Substrate of the source makeup, e.g. 'Clear', 'UltraClear', 'Starphire', 'Gray'. Default: clear.",
    "type": "string"
   },
   "target_maker": {
    "description": "Only show equivalents from this maker: Vitro, Guardian, or Viracon.",
    "type": "string"
   }
  },
  "required": [
   "product"
  ],
  "type": "object"
 },
