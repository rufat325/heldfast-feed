{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read-only: convert an embedded TouchDesigner technique with GLSL source into a RecipeSchema draft without writing files or touching the TD bridge.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Technique pack category id or display name.",
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "description": "Optional recipe description override.",
    "type": "string"
   },
   "difficulty": {
    "description": "Optional recipe difficulty override.",
    "enum": [
     "beginner",
     "intermediate",
     "advanced"
    ],
    "type": "string"
   },
   "id": {
    "description": "Optional recipe id override.",
    "minLength": 1,
    "type": "string"
   },
   "include_glsl_code": {
    "default": true,
    "description": "Include technique GLSL source in the draft recipe's glsl_code block.",
    "type": "boolean"
   },
   "name": {
    "description": "Optional recipe display name override.",
    "minLength": 1,
    "type": "string"
   },
   "strict": {
    "default": true,
    "description": "Return an error when the technique cannot be converted to a valid draft.",
    "type": "boolean"
   },
   "tags": {
    "default": [],
    "description": "Extra recipe tags to append.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "td_version_min": {
    "default": "2023",
    "description": "Minimum TouchDesigner version.",
    "minLength": 1,
    "type": "string"
   },
   "technique_id": {
    "description": "Technique id or name inside the selected category.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "category",
   "technique_id"
  ],
  "type": "object"
 },
 "name": "draft_recipe_from_technique",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "nextToolHints": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recipe": {},
   "source": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "type": "string"
     },
     "techniqueId": {
      "type": "string"
     }
    },
    "required": [
     "category",
     "techniqueId"
    ],
    "type": "object"
   },
   "valid": {
    "type": "boolean"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "issues": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "valid": {
      "type": "boolean"
     }
    },
    "required": [
     "valid",
     "issues"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "valid",
   "validation",
   "source",
   "warnings",
   "nextToolHints"
  ],
  "type": "object"
 },
 "title": "Draft recipe from technique"
}
