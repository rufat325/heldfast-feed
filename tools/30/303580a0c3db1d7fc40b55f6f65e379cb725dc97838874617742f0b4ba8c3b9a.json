{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Pay for an order"
 },
 "description": "Pay for an unpaid order with a Stripe shared payment token (spt_\u2026) the user approved, scoped to at least the order amount in USD. For an order created with recipients, this pays for the whole group at once (scope the token to batch.price). On success the order is paid and goes to print. Use only after the user approved the purchase.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "order_id": {
    "description": "Order id from create_postcard or create_letter, ord_\u2026",
    "type": "string"
   },
   "shared_payment_token": {
    "description": "Stripe shared payment token, spt_\u2026",
    "type": "string"
   }
  },
  "required": [
   "order_id",
   "shared_payment_token"
  ],
  "type": "object"
 },
 "name": "pay_order",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "batch": {
    "additionalProperties": false,
    "description": "Present when the order was created with recipients: the whole group. The top-level fields describe the first recipient's order; use batch.price and batch.checkout_url for the total and payment.",
    "properties": {
     "checkout_url": {
      "description": "One payment link for every unpaid order in the group",
      "type": [
       "string",
       "null"
      ]
     },
     "count": {
      "description": "How many recipients (one order each)",
      "type": "number"
     },
     "discount": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "amount_cents": {
          "type": "number"
         },
         "display": {
          "type": "string"
         },
         "reason": {
          "type": "string"
         }
        },
        "required": [
         "amount_cents",
         "display",
         "reason"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "price": {
      "additionalProperties": false,
      "description": "Total for the whole group",
      "properties": {
       "amount_cents": {
        "type": "number"
       },
       "currency": {
        "type": "string"
       },
       "display": {
        "type": "string"
       }
      },
      "required": [
       "amount_cents",
       "currency",
       "display"
      ],
      "type": "object"
     },
     "url": {
      "description": "Group page listing every recipient",
      "type": "string"
     }
    },
    "required": [
     "id",
     "count",
     "url",
     "checkout_url",
     "price",
     "discount"
    ],
    "type": "object"
   },
   "certified": {
    "description": "none, certified or certified_return_receipt",
    "type": "string"
   },
   "checkout_url": {
    "description": "Where the user pays; null once paid or cancelled",
    "type": [
     "string",
     "null"
    ]
   },
   "discount": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount_cents": {
        "type": "number"
       },
       "display": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      },
      "required": [
       "amount_cents",
       "display",
       "reason"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "First-order discount, already taken off price; null when none applies"
   },
   "id": {
    "description": "Order id, ord_\u2026",
    "type": "string"
   },
   "object": {
    "enum": [
     "postcard",
     "letter"
    ],
    "type": "string"
   },
   "order_url": {
    "description": "Order status page",
    "type": "string"
   },
   "orders": {
    "description": "Every order in the group, when created with recipients",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "order_url": {
       "type": "string"
      },
      "preview_url": {
       "type": "string"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "to",
      "order_url",
      "preview_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "preview_url": {
    "description": "Exact print preview",
    "type": "string"
   },
   "price": {
    "additionalProperties": false,
    "properties": {
     "amount_cents": {
      "type": "number"
     },
     "currency": {
      "type": "string"
     },
     "display": {
      "type": "string"
     }
    },
    "required": [
     "amount_cents",
     "currency",
     "display"
    ],
    "type": "object"
   },
   "product": {
    "description": "Product id, e.g. postcard_4x6 or letter_certified",
    "type": "string"
   },
   "product_name": {
    "type": "string"
   },
   "status": {
    "description": "awaiting_payment, paid, printing, mailed, cancelled or refunded",
    "type": "string"
   },
   "status_detail": {
    "description": "Plain-English status to show the user",
    "type": "string"
   },
   "tracking": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "number": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "number",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "USPS tracking, for Certified Mail once printed"
   }
  },
  "required": [
   "id",
   "object",
   "product",
   "product_name",
   "certified",
   "status",
   "status_detail",
   "price",
   "checkout_url",
   "order_url",
   "preview_url",
   "tracking",
   "discount"
  ],
  "type": "object"
 },
 "title": "Pay for an order"
}
