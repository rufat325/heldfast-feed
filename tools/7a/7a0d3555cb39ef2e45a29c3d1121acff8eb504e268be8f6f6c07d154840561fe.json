{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run LA2 model inference on document pages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addToPageXML": {
    "description": "Add results to PAGE XML",
    "type": "boolean"
   },
   "approxPolyFrac": {
    "description": "Approximate polygon fraction (default 0.7)",
    "type": "number"
   },
   "clusterLinesWithoutRegions": {
    "description": "Cluster lines without regions",
    "type": "boolean"
   },
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "combineWithBaseLayout": {
    "description": "Combine with base layout",
    "type": "boolean"
   },
   "credits": {
    "description": "Credits parameter",
    "type": "string"
   },
   "docId": {
    "description": "Document ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "keepEmptyRegions": {
    "description": "Keep empty regions",
    "type": "boolean"
   },
   "lineOverlapFraction": {
    "description": "Line overlap fraction (default 0.05)",
    "type": "number"
   },
   "modelId": {
    "description": "Model/HTR ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "pages": {
    "description": "Page range (e.g. \"1-5\" or \"1,3,5\")",
    "type": "string"
   },
   "splitLines": {
    "description": "Split lines",
    "type": "boolean"
   },
   "threshold": {
    "description": "Detection threshold (default 0.75)",
    "type": "number"
   }
  },
  "required": [
   "collId",
   "docId"
  ],
  "type": "object"
 },
 "name": "transkribus_la_la2_inference",
 "title": "LA2 Inference"
}
