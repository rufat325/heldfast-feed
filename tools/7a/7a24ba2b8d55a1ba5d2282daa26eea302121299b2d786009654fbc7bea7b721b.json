{
 "description": "Upload custom files to a CRM form for a specific contact.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "contactId": {
    "description": "Contact ID to associate the files with",
    "type": "string"
   },
   "formId": {
    "description": "Form ID to upload files to",
    "type": "string"
   },
   "locationId": {
    "description": "Location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId",
   "contactId",
   "formId"
  ],
  "type": "object"
 },
 "name": "crm_upload_form_custom_files"
}
