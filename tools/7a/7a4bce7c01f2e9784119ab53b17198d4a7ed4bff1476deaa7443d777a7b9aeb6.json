{
 "description": "Publish a package to the npm registry",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "access": {
    "description": "Access level for scoped packages",
    "enum": [
     "public",
     "restricted"
    ],
    "type": "string"
   },
   "dryRun": {
    "description": "Run publish without actually publishing",
    "type": "boolean"
   },
   "otp": {
    "description": "One-time password for 2FA",
    "type": "string"
   },
   "path": {
    "description": "Absolute path to the package directory",
    "type": "string"
   },
   "tag": {
    "description": "Dist-tag (default: latest)",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "publish"
}
