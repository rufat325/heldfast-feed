{
 "description": "Get top holders of a Bitcoin Rune. Returns addresses and balances sorted by amount held.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "description": "Results per page",
    "type": "number"
   },
   "name": {
    "description": "Rune name (e.g., UNCOMMON\u2022GOODS or UNCOMMONGOODS)",
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset",
    "type": "number"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_rune_holders"
}
