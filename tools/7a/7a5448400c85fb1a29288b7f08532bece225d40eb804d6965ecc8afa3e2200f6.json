{"_meta":{"ui":{"resourceUri":"ui://attim/site-card"}},"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Change a live site at the same link with targeted edits. Call read_site first and pass its versionId as baseVersionId. Put every requested change in this one call: only the last 10 versions are kept. replacements swap an exact oldText from read_site (found once unless replaceAll) for newText; writes add or overwrite whole files; deletes remove files. All apply together or not at all, as a new version named versionName. Keep {{ vars.* }} and {{ attim.links.* }} placeholders. A temporary site needs its claimToken.","inputSchema":{"properties":{"baseVersionId":{"type":"string"},"claimToken":{"type":"string"},"deletes":{"items":{"type":"string"},"maxItems":50,"type":"array"},"replacements":{"items":{"properties":{"newText":{"type":"string"},"oldText":{"type":"string"},"path":{"type":"string"},"replaceAll":{"type":"boolean"}},"required":["path","oldText","newText"],"type":"object"},"maxItems":50,"type":"array"},"slug":{"description":"Slug or link.","maxLength":2048,"type":"string"},"versionName":{"description":"Short, like \"Added Q3 numbers\".","maxLength":120,"type":"string"},"writes":{"items":{"properties":{"content":{"type":"string"},"contentBase64":{"type":"string"},"contentType":{"type":"string"},"path":{"type":"string"}},"required":["path"],"type":"object"},"maxItems":20,"type":"array"}},"required":["slug","baseVersionId"],"type":"object"},"name":"edit_site","outputSchema":{"properties":{"changes":{"items":{"properties":{"action":{"type":"string"},"path":{"type":"string"}},"type":"object"},"type":"array"},"siteUrl":{"type":"string"},"slug":{"type":"string"},"versionId":{"type":"string"},"versionName":{"type":"string"}},"required":["slug","siteUrl","versionId"],"type":"object"},"securitySchemes":[{"type":"noauth"},{"scopes":["attim:write"],"type":"oauth2"}],"title":"Edit site"}
