{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants preprints from arXiv, such as \"search arXiv for speculative decoding\" or \"newest cs.CL papers on tokenization\". Pass topic words, and optionally an arXiv category such as cs.CL, from_year, sort (relevance or newest) and a limit of up to 10. Returns each preprint's title, authors, year, the start of its abstract, its arXiv page and its PDF link. Preprints are not peer reviewed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "arXiv category such as \"cs.CL\" or \"stat.ML\"",
    "maxLength": 30,
    "pattern": "^[a-z][a-z-]*(\\.[A-Za-z-]+)?$",
    "type": "string"
   },
   "from_year": {
    "description": "Only papers published in this year or later",
    "maximum": 2100,
    "minimum": 1900,
    "type": "integer"
   },
   "limit": {
    "description": "Number of papers to return, 5 by default",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Topic words, such as \"speculative decoding\"",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "sort": {
    "description": "relevance by default",
    "enum": [
     "relevance",
     "newest"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_arxiv",
 "outputSchema": {
  "properties": {
   "asOf": {
    "description": "Date the indexes were read (UTC, YYYY-MM-DD); they are updated continuously",
    "type": "string"
   },
   "count": {
    "type": "integer"
   },
   "error": {
    "description": "Present when status is not ok: a stable code, what went wrong and what to do next.",
    "properties": {
     "code": {
      "type": "string"
     },
     "hint": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "hint"
    ],
    "type": "object"
   },
   "notice": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "abstract": {
       "description": "First 300 characters of the abstract",
       "type": [
        "string",
        "null"
       ]
      },
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "citedBy": {
       "description": "Citation count in this source; sources count differently",
       "type": [
        "integer",
        "null"
       ]
      },
      "doi": {
       "type": [
        "string",
        "null"
       ]
      },
      "license": {
       "description": "License of the open copy when the source states it",
       "type": [
        "string",
        "null"
       ]
      },
      "openAccessUrl": {
       "description": "A link to the full text that is free to read; null when the source does not confirm one, which does not mean none exists",
       "type": [
        "string",
        "null"
       ]
      },
      "pmcid": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "enum": [
        "Europe PMC",
        "Crossref",
        "arXiv"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "A page for the record",
       "type": "string"
      },
      "venue": {
       "type": [
        "string",
        "null"
       ]
      },
      "year": {
       "type": [
        "integer",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "description": "The indexes the answer was read from",
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "no_results",
     "unavailable"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "query",
   "count",
   "results",
   "notice",
   "source",
   "asOf"
  ],
  "type": "object"
 },
 "title": "Search arXiv"
}
