{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Retry a failed post"
 },
 "description": "Ask PlanVortex to try a failed post again (state withErrors only: a post in state publishing has not failed, it is still on its way). Read get_publication first: if it failed because the text is too long or the account is disconnected, retrying changes nothing until that is fixed. On Instagram, error 999 (the network ran out of time) is worth retrying; 998 (it rejected the file) is not, until the file changes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id_organization": {
    "description": "The PlanVortex organization id. Optional.",
    "type": "string"
   },
   "id_publication": {
    "type": "string"
   }
  },
  "required": [
   "id_publication"
  ],
  "type": "object"
 },
 "name": "retry_publication",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "max_retries": {
    "type": "number"
   },
   "publication": {
    "additionalProperties": false,
    "properties": {
     "errors": {
      "type": "number"
     },
     "id": {
      "type": "string"
     },
     "id_account": {
      "type": "string"
     },
     "publication_type": {
      "type": "string"
     },
     "publish_date": {
      "type": "string"
     },
     "social_network": {
      "type": "string"
     },
     "state": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "social_network",
     "state",
     "publication_type",
     "text",
     "id_account",
     "errors"
    ],
    "type": "object"
   }
  },
  "required": [
   "publication",
   "max_retries"
  ],
  "type": "object"
 },
 "title": "Retry a failed post"
}
