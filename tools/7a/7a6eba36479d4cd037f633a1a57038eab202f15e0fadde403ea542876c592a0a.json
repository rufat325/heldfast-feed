{
 "description": "Updates an existing notification channel. Use listNotifications to find the notification ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "applyExisting": {
    "description": "Apply to all existing monitors now",
    "type": "boolean"
   },
   "config": {
    "additionalProperties": true,
    "description": "Type-specific configuration fields to update",
    "type": "object"
   },
   "isDefault": {
    "description": "Enable by default for new monitors",
    "type": "boolean"
   },
   "name": {
    "description": "Human-readable name",
    "type": "string"
   },
   "notificationID": {
    "description": "The ID of the notification to update",
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "description": "Notification type",
    "type": "string"
   }
  },
  "required": [
   "notificationID"
  ],
  "type": "object"
 },
 "name": "updateNotification",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "number"
   },
   "msg": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Update Notification"
}
