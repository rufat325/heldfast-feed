{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Filter the live board"
 },
 "description": "Filter the live LucyESL board of English-teaching jobs in South Korea: region, student age, housing, visa, schedule, contract, setting, direct hire, minimum salary, free text. Returns structured records; pay in KRW per month unless stated otherwise; null means the advert did not say.",
 "inputSchema": {
  "properties": {
   "age": {
    "description": "Student age group; adults_only means adults and nobody younger",
    "enum": [
     "kindergarten",
     "elementary",
     "middle",
     "high",
     "adults",
     "adults_only"
    ],
    "type": "string"
   },
   "contract": {
    "enum": [
     "employee",
     "contractor"
    ],
    "type": "string"
   },
   "delivery": {
    "enum": [
     "in_person",
     "online",
     "hybrid"
    ],
    "type": "string"
   },
   "direct_only": {
    "description": "Only employers hiring directly (no recruiters or agencies)",
    "type": "boolean"
   },
   "format": {
    "description": "Class shape",
    "enum": [
     "group",
     "small_group",
     "one_to_one"
    ],
    "type": "string"
   },
   "housing": {
    "enum": [
     "provided",
     "allowance",
     "none"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_salary": {
    "description": "Minimum monthly pay in KRW; snaps down to the board's steps 2000000, 2300000, 2600000, 3000000",
    "type": "integer"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Words to match in the title, city or employer name",
    "type": "string"
   },
   "region": {
    "description": "Region key",
    "enum": [
     "seoul",
     "gyeonggi",
     "busan",
     "daegu",
     "daejeon",
     "gwangju",
     "ulsan",
     "sejong",
     "gangwon",
     "chungcheong",
     "jeolla",
     "gyeongsang",
     "jeju"
    ],
    "type": "string"
   },
   "schedule": {
    "enum": [
     "fulltime",
     "parttime",
     "camp",
     "substitute"
    ],
    "type": "string"
   },
   "setting": {
    "enum": [
     "academy",
     "corporate",
     "school",
     "home"
    ],
    "type": "string"
   },
   "specialty": {
    "enum": [
     "ielts",
     "toefl",
     "toeic_opic",
     "sat_ap",
     "business",
     "esp",
     "phonics",
     "writing_debate",
     "subject",
     "bilingual",
     "training",
     "content"
    ],
    "type": "string"
   },
   "visa": {
    "description": "e2 = E-2 sponsorship, f = F-series visa holders",
    "enum": [
     "e2",
     "f",
     "other"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_jobs",
 "title": "Filter the live board"
}
