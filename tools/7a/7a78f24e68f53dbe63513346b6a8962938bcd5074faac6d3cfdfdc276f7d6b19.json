{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Run bounded assertions and capture e\u2026",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "assertions": {
    "description": "Bounded assertions evaluated against\u2026",
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "minimum": 0,
       "type": "integer"
      },
      "group": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "node_exists",
        "group_count",
        "log_contains"
       ],
       "type": "string"
      },
      "nodePath": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "kind"
     ],
     "type": "object"
    },
    "maxItems": 32,
    "type": "array"
   },
   "captureScreenshot": {
    "description": "Capture a screenshot and return its\u2026",
    "type": "boolean"
   },
   "projectPath": {
    "description": "Godot project path",
    "type": "string"
   },
   "scene": {
    "description": "Optional scene to run",
    "type": "string"
   },
   "teardown": {
    "description": "Stop the project after verification.",
    "type": "boolean"
   },
   "waitFrames": {
    "description": "Frames to wait before assertions.",
    "maximum": 600,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "projectPath"
  ],
  "type": "object"
 },
 "name": "verify_project",
 "outputSchema": {
  "additionalProperties": false,
  "oneOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "properties": {
     "ok": {
      "const": true
     }
    },
    "required": [
     "data"
    ]
   },
   {
    "not": {
     "required": [
      "data"
     ]
    },
    "properties": {
     "ok": {
      "const": false
     }
    },
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "data": {},
   "error": {
    "type": "object"
   },
   "meta": {
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok",
   "meta"
  ],
  "type": "object"
 },
 "title": "Verify Project"
}
