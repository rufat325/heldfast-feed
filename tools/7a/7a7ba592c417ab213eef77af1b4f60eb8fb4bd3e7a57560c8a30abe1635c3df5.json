{
 "description": "Render draft pages with their placed fields as short-lived private image handles (default page 1 plus every page with a field; at most 10 pages per call; PAGE_OUT_OF_RANGE past the last page). Handles only, never image bytes: fetch a page PNG before resource.expiresAt with an authenticated GET /api/public/v1/agreements/resources/{id}, or save them with the OpenTrain CLI (opentrain agreements preview --out <dir>). Requires agreements:read. Requires the agreements family flag and the agreements_native rollout; denials carry details.reason (AGENT_SURFACE_DISABLED, AGREEMENTS_DISABLED, TENANT_ACCESS_DENIED).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "documentId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "pages": {
    "items": {
     "maximum": 10000,
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "documentId"
  ],
  "type": "object"
 },
 "name": "opentrain_agreements_preview",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "documentId": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     "draftRevision": {
      "minimum": 0,
      "type": "integer"
     },
     "pages": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "fields": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "fieldId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
            "type": "string"
           },
           "label": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
           },
           "rect": {
            "additionalProperties": false,
            "properties": {
             "height": {
              "$ref": "#/properties/result/properties/pages/items/properties/fields/items/properties/rect/properties/width"
             },
             "width": {
              "exclusiveMinimum": 0,
              "maximum": 2000,
              "type": "number"
             },
             "x": {
              "minimum": 0,
              "type": "number"
             },
             "y": {
              "$ref": "#/properties/result/properties/pages/items/properties/fields/items/properties/rect/properties/x"
             }
            },
            "required": [
             "x",
             "y",
             "width",
             "height"
            ],
            "type": "object"
           }
          },
          "required": [
           "fieldId",
           "rect",
           "label"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "page": {
         "maximum": 10000,
         "minimum": 1,
         "type": "integer"
        },
        "resource": {
         "additionalProperties": false,
         "properties": {
          "expiresAt": {
           "format": "date-time",
           "type": "string"
          },
          "id": {
           "maxLength": 512,
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "id",
          "expiresAt"
         ],
         "type": "object"
        },
        "warnings": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "code": {
            "enum": [
             "ANCHOR_NOT_FOUND",
             "ANCHOR_AMBIGUOUS",
             "FIELD_OVERLAP",
             "FIELD_OUT_OF_BOUNDS",
             "FIELD_OVER_TEXT",
             "ROLE_HAS_NO_SIGNATURE",
             "MERGE_VALUE_MISSING",
             "GLYPH_UNSUPPORTED"
            ],
            "type": "string"
           },
           "fieldId": {
            "$ref": "#/properties/result/properties/pages/items/properties/fields/items/properties/fieldId"
           },
           "message": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
           },
           "page": {
            "$ref": "#/properties/result/properties/pages/items/properties/page"
           }
          },
          "required": [
           "code",
           "message"
          ],
          "type": "object"
         },
         "type": "array"
        }
       },
       "required": [
        "page",
        "resource",
        "fields",
        "warnings"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "warnings": {
      "items": {
       "$ref": "#/properties/result/properties/pages/items/properties/warnings/items"
      },
      "type": "array"
     }
    },
    "required": [
     "documentId",
     "draftRevision",
     "pages",
     "warnings"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
