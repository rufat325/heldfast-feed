{
 "description": "Query stored agent events with optional filters. Returns raw event data for analysis.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "description": "Filter by agent ID",
    "type": "string"
   },
   "days": {
    "description": "Time range in days",
    "type": "number"
   },
   "event_type": {
    "description": "Filter by event type (e.g. 'query_completed')",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max events to return (default: 50, max: 1000)",
    "type": "number"
   },
   "success": {
    "description": "Filter by success status",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "query_events"
}
