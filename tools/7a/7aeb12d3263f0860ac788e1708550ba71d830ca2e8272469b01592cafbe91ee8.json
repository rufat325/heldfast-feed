  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return the text of a single document snapshot. Pass the documentId and the snapshotId from list_snapshots. The snapshot's RTF is converted to plain text. Read-only; does not alter the document or restore the snapshot. Requires an open project (call open_project first).",
 "inputSchema": {
  "properties": {
   "documentId": {
    "description": "UUID of the document.",
    "type": "string"
   },
   "snapshotId": {
    "description": "Snapshot id from list_snapshots.",
    "type": "string"
   }
  },
  "required": [
   "documentId",
   "snapshotId"
  ],
  "type": "object"
 },
 "name": "read_snapshot",
 "outputSchema": {
  "properties": {
   "date": {
    "description": "Snapshot date.",
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "snapshotId": {
    "type": "string"
   },
   "text": {
    "description": "Snapshot content as plain text.",
    "type": "string"
   },
   "title": {
    "description": "Snapshot title (\"\" if none).",
    "type": "string"
   },
   "wordCount": {
    "description": "Word count of the snapshot text.",
    "type": "number"
   }
  },
  "required": [
   "documentId",
   "snapshotId",
   "text",
   "wordCount"
  ],
  "type": "object"
 },
 "title": "Read Document Snapshot"
}
