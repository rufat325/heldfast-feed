 "description": "Records who the founder is \u2014 their name, contact details and where they are based \u2014 on a formation. A Social Security Number or ITIN is optional here: ask for it only if the person offers, pass it once, and never read it back. The response says whether one is on file, never the number.",
 "inputSchema": {
  "properties": {
   "formationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "noSsn": {
    "type": "boolean"
   },
   "profile": {
