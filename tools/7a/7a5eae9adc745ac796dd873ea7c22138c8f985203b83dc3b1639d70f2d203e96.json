{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search flea markets in Germany"
 },
 "description": "Search German flea markets (Flohmarkt, Tr\u00f6delmarkt, Hofflohmarkt, Kinderflohmarkt, Antik- und Sammlermarkt) from the public my-flohmarkt.de catalogue. Filter by free text, by city name or postal code (PLZ) via the city argument, by date range, or by radius around a coordinate. Radius searches require lat, lng, and radiusKm together (max 100 km). Each hit carries title, date, start and end time, PLZ, city, coordinates, market type and the public event URL. Returns at most 50 results plus a dataAsOf timestamp.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "city": {
    "maxLength": 100,
    "type": "string"
   },
   "dateFrom": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dateTo": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "lat": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "lng": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "query": {
    "maxLength": 200,
    "type": "string"
   },
   "radiusKm": {
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "search_events",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dataAsOf": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "items": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "city": {
       "anyOf": [
