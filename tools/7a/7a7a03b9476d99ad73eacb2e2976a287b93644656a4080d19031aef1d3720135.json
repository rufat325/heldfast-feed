{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Verify a signed action against a public action record. Checks record status, action index, signature/address match, optional expected envelope hash, and time decay. No API key or network call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actionIndex": {
    "description": "The action index being invoked",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "expectedActionEnvelopeHash": {
    "description": "Optional expected action-envelope hash",
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "payload": {
    "description": "The exact signed action payload"
   },
   "record": {
    "additionalProperties": {},
    "description": "The public action record received from AgentEnvelope or another trusted store",
    "properties": {
     "actionEnvelope": {
      "additionalProperties": {},
      "properties": {
       "actionIndex": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "actionIndex"
      ],
      "type": "object"
     },
     "actionEnvelopeHash": {
      "pattern": "^0x[a-fA-F0-9]{64}$",
      "type": "string"
     },
     "agentAddress": {
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "type": "string"
     },
     "agentId": {
      "pattern": "^[a-zA-Z0-9_:-]{1,128}$",
      "type": "string"
     },
     "domain": {
      "additionalProperties": {},
      "properties": {
       "domainHash": {
        "pattern": "^0x[a-fA-F0-9]{64}$",
        "type": "string"
       },
       "domainId": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "domainId",
       "domainHash"
      ],
      "type": "object"
     },
     "expiry": {
      "type": [
       "string",
       "null"
      ]
     },
     "recordId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     "status": {
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
     },
     "type": {
      "const": "agentenvelope.publicActionRecord",
      "type": "string"
     },
     "version": {
      "const": 1,
      "type": "number"
     }
    },
    "required": [
     "type",
     "version",
     "recordId",
     "agentId",
     "agentAddress",
     "status",
     "domain",
     "actionEnvelope",
     "actionEnvelopeHash"
    ],
    "type": "object"
   },
   "signature": {
    "description": "0x-prefixed 65-byte signature",
    "pattern": "^0x[a-fA-F0-9]{130}$",
    "type": "string"
   }
  },
  "required": [
   "record",
   "actionIndex",
   "payload",
   "signature"
  ],
  "type": "object"
 },
 "name": "ae_verify_sovereign_record",
 "title": "Verify public action record (sovereign, offline)"
}
