{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing calendar event. Only specified fields will be changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attendees": {
    "description": "Updated attendee list",
    "items": {
     "additionalProperties": false,
     "properties": {
      "displayName": {
       "type": "string"
      },
      "email": {
       "description": "Attendee email address",
       "type": "string"
      },
      "optional": {
       "type": "boolean"
      },
      "responseStatus": {
       "enum": [
        "needsAction",
        "declined",
        "tentative",
        "accepted"
       ],
       "type": "string"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "calendarId": {
    "default": "primary",
    "description": "Calendar ID",
    "type": "string"
   },
   "description": {
    "description": "New event description",
    "type": "string"
   },
   "end": {
    "additionalProperties": false,
    "description": "New end time",
    "properties": {
     "date": {
      "type": "string"
     },
     "dateTime": {
      "type": "string"
     },
     "timeZone": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "eventId": {
    "description": "Event ID to update",
    "type": "string"
   },
   "location": {
    "description": "New event location",
    "type": "string"
   },
   "sendUpdates": {
    "default": "all",
    "description": "Who to send notifications to",
    "enum": [
     "all",
     "externalOnly",
     "none"
    ],
    "type": "string"
   },
   "start": {
    "additionalProperties": false,
    "description": "New start time",
    "properties": {
     "date": {
      "type": "string"
     },
     "dateTime": {
      "type": "string"
     },
     "timeZone": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "summary": {
    "description": "New event title",
    "type": "string"
   }
  },
  "required": [
   "eventId"
  ],
  "type": "object"
 },
 "name": "event_update",
 "title": "Update event"
}
