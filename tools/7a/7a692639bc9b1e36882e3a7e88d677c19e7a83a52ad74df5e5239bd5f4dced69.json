{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "human:actions"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List a cursor page of saved payment method references for the authorized account with status, rail and default selection. Continue with nextCursor as afterCursor until null. Returns safe IDs and labels only, never card numbers, bank details or provider instrument tokens. A saved method is not approval to spend.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "afterCursor": {
    "description": "Continue after the previous response nextCursor.",
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "limit": {
    "description": "Maximum saved methods to return, up to 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_payment_methods",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "methods": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "expiresAt": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
       "type": "string"
      },
      "isDefault": {
       "type": "boolean"
      },
      "label": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "method": {
       "enum": [
        "card",
        "bank",
        "hosted_checkout",
        "darwin_wallet",
        "mpp",
        "x402",
        "ucp",
        "acp"
       ],
       "type": "string"
      },
      "paymentMethodId": {
       "maxLength": 200,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9_-]+$",
       "type": "string"
      },
      "revision": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "status": {
       "enum": [
        "active",
        "revoked",
        "expired"
       ],
       "type": "string"
      }
     },
     "required": [
      "paymentMethodId",
      "label",
      "method",
      "status",
      "isDefault",
      "revision",
      "expiresAt"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "methods",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List payment methods"
}
