{
 "description": "List available tasks from the marketplace with optional capability filter and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capability": {
    "description": "Filter by capability",
    "type": "string"
   },
   "limit": {
    "description": "Max tasks (default: 50)",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset (default: 0)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "list_tasks"
}
