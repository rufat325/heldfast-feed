    "format": "date",
    "type": "string"
   },
   "platforms": {
    "description": "Optional platform subset to inspect.",
    "items": {
     "enum": [
      "x",
      "linkedin",
      "linkedin-page",
      "facebook",
      "instagram",
      "threads",
      "bluesky",
      "mastodon",
      "nostr",
      "youtube",
      "tiktok",
      "lemmy",
      "discord",
      "slack",
      "telegram",
      "pinterest",
      "dribbble",
      "devto",
      "hashnode",
      "gmb",
      "whop",
      "producthunt"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "start": {
    "description": "Range start date in YYYY-MM-DD format.",
    "format": "date",
    "type": "string"
   },
