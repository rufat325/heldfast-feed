{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Market cap calculator"
 },
 "description": "Calculate a coin's market cap (price times circulating supply) and fully diluted valuation, or work backwards to the price implied by a target market cap. Works in any currency; nothing is looked up. Source: https://hopi.co.uk/market-cap-calculator/",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "mode": {
       "const": "market_cap"
      }
     }
    },
    "then": {
     "required": [
      "price"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "mode": {
       "const": "implied_price"
      }
     }
    },
    "then": {
     "required": [
      "target"
     ]
    }
   }
  ],
  "properties": {
   "current": {
    "description": "Current price per coin, to show the multiple (optional, implied_price mode)",
    "minimum": 0,
    "type": "number"
   },
   "maxSupply": {
    "description": "Maximum or total supply for FDV (optional, market_cap mode)",
    "minimum": 0,
    "type": "number"
   },
   "mode": {
    "description": "market_cap: price times supply. implied_price: target cap divided by supply.",
    "enum": [
     "market_cap",
     "implied_price"
    ],
    "type": "string"
   },
   "price": {
    "description": "Current price per coin (for market_cap)",
    "minimum": 0,
    "type": "number"
   },
   "supply": {
    "description": "Circulating supply (for both modes)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "target": {
    "description": "Target market cap (for implied_price)",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "mode",
   "supply"
  ],
  "type": "object"
 },
 "name": "hopi_market_cap_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "approx": {
    "type": "string"
   },
   "marketCap": {
    "type": "number"
   },
   "marketCapString": {
    "type": "string"
   },
   "mode": {
    "type": "string"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "mode",
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Market cap calculator"
}
