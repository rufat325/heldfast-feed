 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "articles": {
    "anyOf": [
     {
      "properties": {
       "from": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "to": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Article-number range, in legal order."
   },
   "cursor": {
    "anyOf": [
     {
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "from_version_id": {
    "anyOf": [
     {
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional; where given, must name the published pair."
   },
   "instrument_id": {
    "maxLength": 64,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "limit": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "material_only": {
    "description": "Keep only articles carrying an editorial materiality marker.",
    "type": [
     "boolean",
     "null"
    ]
   },
   "status": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "One of the classification statuses, e.g. \"amended_substantial\"."
   },
   "to_version_id": {
    "anyOf": [
     {
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "instrument_id"
  ],
  "type": "object"
 },
