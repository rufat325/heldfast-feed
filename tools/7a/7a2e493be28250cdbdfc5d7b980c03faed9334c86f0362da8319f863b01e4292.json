{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The live list of codes every `currency`/`base` parameter accepts \u2014 ISO 4217 fiat plus BTC and the metal codes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque continuation token returned by the same tool with exactly the same filters.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Case-insensitive substring match against code or name.",
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_supported_currencies",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "currencies": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "maxLength": 16,
       "pattern": "^[A-Z0-9]+$",
       "type": "string"
      },
      "name": {
       "maxLength": 200,
       "type": "string"
      }
     },
     "required": [
      "code",
      "name"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "query": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "query",
   "currencies",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "Supported currency catalog"
}
