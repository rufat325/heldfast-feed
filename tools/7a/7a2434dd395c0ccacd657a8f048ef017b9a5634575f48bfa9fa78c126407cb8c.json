{
 "_meta": {
  "ui": {
   "resourceUri": "ui://rds/widget.html"
  },
  "ui/resourceUri": "ui://rds/widget.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Score a call-to-action button's visibility using its real WCAG contrast ratio against the background plus size and placement. See the full version at https://rahuldsarker.co/calculators/cta-visual-hierarchy-tester",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "backgroundColorHex": {
    "description": "Background color as a hex code, e.g. \"#FAFAFB\"",
    "type": "string"
   },
   "buttonColorHex": {
    "description": "Button color as a hex code, e.g. \"#7C3AED\"",
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "placement": {
    "description": "Placement: primary (above fold, standout), inline with content, or buried (below fold/crowded)",
    "enum": [
     "primary",
     "inline",
     "buried"
    ],
    "type": "string"
   },
   "size": {
    "description": "Button size: large/prominent, medium, or small/text-like",
    "enum": [
     "large",
     "medium",
     "small"
    ],
    "type": "string"
   }
  },
  "required": [
   "buttonColorHex",
   "backgroundColorHex",
   "size",
   "placement"
  ],
  "type": "object"
 },
 "name": "cta_visual_hierarchy_tester",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benchmarks": {
    "description": "Rule-of-thumb verdicts for the headline numbers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "band": {
       "type": "string"
      },
      "display": {
       "type": "string"
      },
      "metric": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "read": {
       "type": "string"
      },
      "segment": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "tone": {
       "enum": [
        "good",
        "ok",
        "warn",
        "bad"
       ],
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "metric",
      "name",
      "value",
      "display",
      "band",
      "tone",
      "read",
      "target",
      "segment",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bookingUrl": {
    "type": "string"
   },
   "calculator": {
    "description": "Slug of the interactive calculator on rahuldsarker.co",
    "type": "string"
   },
   "compact": {
    "type": "boolean"
   },
   "currency": {
    "type": [
     "string",
     "null"
    ]
   },
   "inputs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "kind": {
    "const": "calculator",
    "type": "string"
   },
   "metrics": {
    "description": "Every \"Label: value\" line of the result; value is the first number on the line",
    "items": {
     "additionalProperties": false,
     "properties": {
      "display": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "unit": {
       "anyOf": [
        {
         "enum": [
          "currency",
          "x",
          "%",
          "months"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "value": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "label",
      "value",
      "unit",
      "display"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "tool": {
    "description": "The calculator tool that produced this result",
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "kind",
   "tool",
   "title",
   "calculator",
   "url",
   "bookingUrl",
   "currency",
   "compact",
   "inputs",
   "metrics",
   "notes",
   "benchmarks"
  ],
  "type": "object"
 },
 "title": "CTA Visual Hierarchy Tester"
}
