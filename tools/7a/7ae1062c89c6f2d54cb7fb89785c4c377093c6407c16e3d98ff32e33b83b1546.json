{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update a checkout session"
 },
 "description": "Change items, state or buyer details on an open checkout session and get it re-priced. Returns the same session object as create_checkout.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "buyer": {
    "properties": {
     "email": {
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "first_name": {
      "maxLength": 80,
      "type": "string"
     },
     "last_name": {
      "maxLength": 80,
      "type": "string"
     },
     "phone_number": {
      "maxLength": 20,
      "type": "string"
     }
    },
    "type": "object"
   },
   "checkout_session_id": {
    "maxLength": 80,
    "minLength": 8,
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "id": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "maximum": 1,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   },
   "state": {
    "maxLength": 40,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "checkout_session_id"
  ],
  "type": "object"
 },
 "name": "update_checkout",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "id": {
    "type": "string"
   },
   "line_items": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "id": {
       "type": "string"
      },
      "total": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "total"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "messages": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "content": {
       "type": "string"
      },
      "type": {
       "enum": [
        "info",
        "error"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "type": "string"
   },
   "totals": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "type": "number"
      },
      "display_text": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "display_text",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "status",
   "line_items",
   "totals",
   "messages"
  ],
  "type": "object"
 },
 "title": "Update a checkout session"
}
