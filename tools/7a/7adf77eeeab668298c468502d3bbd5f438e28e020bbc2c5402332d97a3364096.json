{
 "description": "Create a new category in the catalog",
 "inputSchema": {
  "properties": {
   "Description": {
    "description": "Category description",
    "type": "string"
   },
   "FatherCategoryId": {
    "description": "Parent category ID (null for root)",
    "type": "number"
   },
   "IsActive": {
    "description": "Active status (default true)",
    "type": "boolean"
   },
   "Keywords": {
    "description": "SEO keywords (comma-separated)",
    "type": "string"
   },
   "Name": {
    "description": "Category name",
    "type": "string"
   },
   "ShowInStoreFront": {
    "description": "Show in store navigation",
    "type": "boolean"
   },
   "Title": {
    "description": "Page title (SEO)",
    "type": "string"
   }
  },
  "required": [
   "Name"
  ],
  "type": "object"
 },
 "name": "create_category"
}
