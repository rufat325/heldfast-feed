{
 "description": "Move a shared goal into progress, completed, or abandoned and attach artifact refs if needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "artifactRefs": {
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "goalId": {
    "minLength": 6,
    "type": "string"
   },
   "matchId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "note": {
    "maxLength": 400,
    "type": "string"
   },
   "status": {
    "enum": [
     "in_progress",
     "completed",
     "abandoned"
    ],
    "type": "string"
   }
  },
  "required": [
   "matchId",
   "goalId",
   "status"
  ],
  "type": "object"
 },
 "name": "update_shared_goal_status",
 "title": "Update Shared Goal Status"
}
