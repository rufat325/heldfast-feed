{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs a draft seed document through the exact parser the Calaf app imports with. Pass the entire JSON document as a string. Returns per-section counts and the precise issue list (path, severity, message): severity \"error\" means nothing imports; \"dropped\" means that row or field is discarded and the rest lands. Fix the issues and validate again until clean before delivering the file to the user.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "seed": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "The complete seed JSON document \u2014 as text, or as the JSON object itself."
   }
  },
  "required": [
   "seed"
  ],
  "type": "object"
 },
 "name": "validate_seed",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "counts": {
    "additionalProperties": false,
    "properties": {
     "contacts": {
      "type": "number"
     },
     "keyDates": {
      "type": "number"
     },
     "ladderRungs": {
      "type": "number"
     },
     "orgKinds": {
      "type": "number"
     },
     "orgs": {
      "type": "number"
     },
     "prep": {
      "type": "number"
     },
     "templates": {
      "type": "number"
     }
    },
    "required": [
     "orgs",
     "contacts",
     "templates",
     "prep",
     "keyDates",
     "orgKinds",
     "ladderRungs"
    ],
    "type": "object"
   },
   "hasPlanner": {
    "type": "boolean"
   },
   "hasVocab": {
    "type": "boolean"
   },
   "issues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "dropped"
       ],
       "type": "string"
      }
     },
     "required": [
      "path",
      "message",
      "severity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "valid": {
    "type": "boolean"
   }
  },
  "required": [
   "valid",
   "counts",
   "hasVocab",
   "hasPlanner",
   "issues"
  ],
  "type": "object"
 },
 "title": "Validate a Calaf seed file"
}
