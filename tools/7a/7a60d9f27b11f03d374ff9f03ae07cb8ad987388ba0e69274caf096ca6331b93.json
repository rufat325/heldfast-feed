{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Build a menu of up to 7 dinners, either one cuisine per day (\"world\") or all from one country. Honours diet exclusions (pork, beef, meat, fish, dairy, egg, alcohol), vegetarian/vegan/pescatarian requirements, a prep-time ceiling and a budget mode that reuses ingredients. When a constraint cannot be met it is relaxed and the relaxation is reported, never hidden.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "budget": {
    "default": false,
    "description": "Favour weeks that reuse ingredients across days.",
    "type": "boolean"
   },
   "country": {
    "description": "Required when mode is \"single\".",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "days": {
    "default": 7,
    "description": "How many days to plan, 1-7.",
    "maximum": 7,
    "minimum": 1,
    "type": "integer"
   },
   "exclude": {
    "description": "Ingredient attributes to avoid entirely: pork, beef, meat, fish, dairy, egg, alcohol.",
    "items": {
     "enum": [
      "pork",
      "beef",
      "meat",
      "fish",
      "dairy",
      "egg",
      "alcohol"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "exclude_countries": {
    "description": "Cuisines to keep out of the plan, ISO 3166-1 alpha-2. Only meaningful when mode is \"world\"; excluding too many leaves the generator with too few cuisines to fill the week.",
    "items": {
     "maxLength": 2,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   },
   "include_extras": {
    "default": true,
    "description": "Add 2 desserts and 2 drinks (never alcoholic).",
    "type": "boolean"
   },
   "lang": {
    "default": "en",
    "description": "Language for titles, ingredient names and URLs.",
    "enum": [
     "en",
     "tr",
     "de",
     "fr",
     "es",
     "it",
     "el"
    ],
    "type": "string"
   },
   "mode": {
    "default": "world",
    "description": "\"world\" = a different cuisine each day; \"single\" = one country.",
    "enum": [
     "world",
     "single"
    ],
    "type": "string"
   },
   "require": {
    "description": "Diet every dish must satisfy. This is a WHITELIST and differs from `exclude`, which only removes single ingredient attributes: \"vegan\" is not the same as excluding meat.",
    "enum": [
     "vegetarian",
     "vegan",
     "pescatarian"
    ],
    "type": "string"
   },
   "seed": {
    "description": "Same seed + same options = same menu.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "time_limit": {
    "description": "Max prep time in minutes; closed set (30/45/60). The generator relaxes it automatically if too few cuisines qualify, and reports that in relaxations.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "weekly_menu",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "attribution": {
    "type": "string"
   },
   "days": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "country": {
       "type": "string"
      },
      "country_name": {
       "type": "string"
      },
      "day": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "form": {
       "type": [
        "string",
        "null"
       ]
      },
      "prep_time_minutes": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "title",
      "country",
      "country_name",
      "category",
      "form",
      "prep_time_minutes",
      "url",
      "day"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "desserts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "country": {
       "type": "string"
      },
      "country_name": {
       "type": "string"
      },
      "form": {
       "type": [
        "string",
        "null"
       ]
      },
      "prep_time_minutes": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "title",
      "country",
      "country_name",
      "category",
      "form",
      "prep_time_minutes",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "drinks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "country": {
       "type": "string"
      },
      "country_name": {
       "type": "string"
      },
      "form": {
       "type": [
        "string",
        "null"
       ]
      },
      "prep_time_minutes": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "title",
      "country",
      "country_name",
      "category",
      "form",
      "prep_time_minutes",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pantry_assumed": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "relaxations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "reason": {
       "type": "string"
      },
      "what": {
       "type": "string"
      }
     },
     "required": [
      "what",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "shopping_list": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dishes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "ingredient": {
       "type": "string"
      },
      "used_in": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "ingredient",
      "used_in",
      "dishes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "stats": {
    "additionalProperties": false,
    "properties": {
     "countries": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "pool_size": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "seed": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "time_limit": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "countries",
     "pool_size",
     "time_limit",
     "seed"
    ],
    "type": "object"
   }
  },
  "required": [
   "days",
   "desserts",
   "drinks",
   "shopping_list",
   "pantry_assumed",
   "relaxations",
   "stats",
   "notes",
   "attribution"
  ],
  "type": "object"
 },
 "title": "Build a weekly menu"
}
