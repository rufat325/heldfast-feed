{
 "description": "Search emails by keyword. If inbox_id is omitted, uses the default inbox.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "inbox_id": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "string"
     }
    ],
    "description": "Inbox ID (optional, uses default inbox)"
   },
   "query": {
    "description": "Search query",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_emails"
}
