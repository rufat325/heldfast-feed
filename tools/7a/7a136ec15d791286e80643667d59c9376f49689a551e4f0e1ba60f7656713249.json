{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Create UNSIGNED launch transactions. platform defaults to pumpfun (Solana v0 messages). bags = Bags.fm Solana fee-claimers (needs BAGS_API_KEY). zora = Zora content coins on Base (EIP-1559; needs ZORA_ENABLED). clanker = Clanker v4 on Base (EIP-1559; needs CLANKER_ENABLED). vibevibe = vibe/vibe on Robinhood Chain (EIP-1559; needs VIBEVIBE_ENABLED). Prefer explicit crew[] from crew_list_kols; Autohire is fallback. optInOnly default off. Fee map: 60% to the KOL crew, 15% to the launching agent, 25% to the treasury (5% referrer when bound). Optional treasuryBps 2000\u20133000.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "crew": {
    "items": {
     "properties": {
      "evmWallet": {
       "maxLength": 42,
       "minLength": 42,
       "type": "string"
      },
      "handle": {
       "type": "string"
      },
      "hireRole": {
       "enum": [
        "caller",
        "chart",
        "raid",
        "kol",
        "dev"
       ],
       "type": "string"
      },
      "share": {
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      },
      "wallet": {
       "maxLength": 64,
       "minLength": 20,
       "type": "string"
      }
     },
     "required": [
      "handle",
      "wallet",
      "share"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "description": {
    "maxLength": 204,
    "type": "string"
   },
   "imageBase64": {
    "minLength": 64,
    "type": "string"
   },
   "imageUrl": {
    "format": "uri",
    "type": "string"
   },
   "initialBuySol": {
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "launcherKey": {
    "description": "FORBIDDEN \u2014 rejected if set. Use CREW_LAUNCHER_KEY in MCP env only.",
    "type": "string"
   },
   "launcherPubkey": {
    "maxLength": 64,
    "minLength": 20,
    "type": "string"
   },
   "mintPubkey": {
    "maxLength": 64,
    "minLength": 20,
    "type": "string"
   },
   "mode": {
    "enum": [
     "agent",
     "split",
     "buyback",
     "raid"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 32,
    "minLength": 2,
    "type": "string"
   },
   "optInOnly": {
    "type": "boolean"
   },
   "platform": {
    "description": "Launch venue. Default pumpfun. bags=Bags.fm (Solana). zora=Zora coins (Base).",
    "enum": [
     "pumpfun",
     "bags",
     "zora",
     "clanker",
     "vibevibe"
    ],
    "type": "string"
   },
   "privateKey": {
    "description": "FORBIDDEN \u2014 rejected if set.",
    "type": "string"
   },
   "seats": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "secretKey": {
    "description": "FORBIDDEN \u2014 rejected if set.",
    "type": "string"
   },
   "ticker": {
    "maxLength": 13,
    "minLength": 2,
    "type": "string"
   },
   "treasuryBps": {
    "maximum": 3000,
    "minimum": 2000,
    "type": "integer"
   },
   "twitter": {
    "maxLength": 128,
    "type": "string"
   },
   "website": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "name",
   "ticker",
   "launcherPubkey"
  ],
  "type": "object"
 },
 "name": "crew_build_unsigned",
 "title": "Build UNSIGNED launch transactions"
}
