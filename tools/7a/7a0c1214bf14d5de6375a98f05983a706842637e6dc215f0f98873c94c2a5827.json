{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/html.headings",
  "agent-utilities/priceMicroUsd": 300
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Extract up to 200 headings with parent indices and skipped-level indicators. PAID: 300 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "html": {
      "maxLength": 100000,
      "type": "string"
     }
    },
    "required": [
     "html"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "html_headings",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "headings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "level": {
       "type": "number"
      },
      "parentIndex": {
       "type": [
        "number",
        "null"
       ]
      },
      "skippedLevel": {
       "type": "boolean"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "level",
      "text",
      "id",
      "parentIndex",
      "skippedLevel"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "headings",
   "total",
   "truncated"
  ],
  "type": "object"
 }
}
