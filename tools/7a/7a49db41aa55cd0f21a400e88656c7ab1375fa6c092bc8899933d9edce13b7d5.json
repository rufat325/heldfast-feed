{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Poll an entry session created by this credential. Returns the variable name and pending, stored, expired or cancelled; never the secret value or its hash.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "session_id": {
    "pattern": "^sen_[a-f0-9]{32}$",
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "impreza_get_secret_entry",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "session_id": {
      "pattern": "^sen_[a-f0-9]{32}$",
      "type": "string"
     },
     "status": {
      "enum": [
       "pending",
       "stored",
       "expired",
       "cancelled"
      ],
      "type": "string"
     },
     "variable_name": {
      "type": "string"
     }
    },
    "required": [
     "session_id",
     "variable_name",
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Read secret entry status"
}
