{
 "description": "Search live prediction markets tracked by Polyrama across Polymarket and Kalshi. Filter by text or YES probability and sort by volume, movement, spread, or price.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 25,
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "priceMax": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "priceMin": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Case-insensitive question or slug search.",
    "type": "string"
   },
   "sort": {
    "default": "volume_24h",
    "enum": [
     "volume_24h",
     "spread",
     "yes_no_sum",
     "yes_mid",
     "change_1h",
     "change_24h",
     "trending",
     "end_date_iso",
     "updated_at"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "polyrama_search_markets"
}
