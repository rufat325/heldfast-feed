{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Note seasoning calculator"},"description":"A note's seasoning is how long the borrower has been paying, counted from the first payment due date, and this tool gives the months seasoned and the payments due so far. If given payments made, it shows how many were missed or paid ahead, which helps tell a performing note from a non-performing one. Estimates, not offers or appraisals. CashForMyNote.com does not buy notes or make offers.","inputSchema":{"additionalProperties":false,"properties":{"as_of":{"description":"YYYY-MM-DD","format":"date","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"first_payment_date":{"description":"YYYY-MM-DD","format":"date","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"payments_made":{"description":"Payments actually received (optional).","minimum":0,"type":"integer"}},"required":["first_payment_date","as_of"],"type":"object"},"name":"seasoning","outputSchema":{"additionalProperties":false,"properties":{"attribution":{"additionalProperties":false,"properties":{"cite":{"type":"string"},"conventions":{"type":"string"},"credit":{"type":"string"},"disclaimer":{"type":"string"},"education_note":{"type":"string"},"source":{"type":"string"},"source_url":{"type":"string"}},"required":["source","cite","credit","source_url","disclaimer","education_note","conventions"],"type":"object"},"result":{"additionalProperties":false,"properties":{"months_seasoned":{"type":"integer"},"payment_status":{"type":"string"},"payments_due_to_date":{"type":"integer"},"payments_made":{"type":"integer"}},"required":["months_seasoned","payments_due_to_date"],"type":"object"},"tool":{"const":"seasoning","type":"string"}},"required":["tool","result","attribution"],"type":"object"},"title":"Note seasoning calculator"}
