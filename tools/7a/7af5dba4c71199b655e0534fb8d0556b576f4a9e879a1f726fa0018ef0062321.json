{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Describe the shared style. Use this when the user asks what their references have in common or wants rules to design by, such as \"what is my taste?\". Pass the profile_key and optionally ref_ids to use only some references. Returns concrete rules for layout, type, texture and hierarchy, a palette of hex colors with how many references use each, and the most common style tags. The rules are suggestions to confirm with the user, then keep with save_profile.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "profile_key": {
    "description": "The profile_key that add_refs returned. Keep it: it is the only way back to this profile and it is not recoverable.",
    "pattern": "^tp_[0-9a-f]{32}$",
    "type": "string"
   },
   "ref_ids": {
    "description": "Only use these references; leave out to use all of them.",
    "items": {
     "pattern": "^r_[0-9a-f]{6}$",
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   }
  },
  "required": [
   "profile_key"
  ],
  "type": "object"
 },
 "name": "describe_style",
 "outputSchema": {
  "properties": {
   "as_of": {
    "description": "UTC date of this answer.",
    "type": "string"
   },
   "based_on": {
    "type": "integer"
   },
   "hierarchy": {
    "items": {
     "properties": {
      "refs": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "rule": {
       "type": "string"
      }
     },
     "required": [
      "rule",
      "refs"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "layout": {
    "items": {
     "properties": {
      "refs": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "rule": {
       "type": "string"
      }
     },
     "required": [
      "rule",
      "refs"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "palette": {
    "items": {
     "properties": {
      "hex": {
       "type": "string"
      },
      "refs": {
       "type": "integer"
      }
     },
     "required": [
      "hex",
      "refs"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "refs_total": {
    "type": "integer"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "empty"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "properties": {
      "refs": {
       "type": "integer"
      },
      "tag": {
       "type": "string"
      }
     },
     "required": [
      "tag",
      "refs"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "texture": {
    "items": {
     "properties": {
      "refs": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "rule": {
       "type": "string"
      }
     },
     "required": [
      "rule",
      "refs"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "type": {
    "items": {
     "properties": {
      "refs": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "rule": {
       "type": "string"
      }
     },
     "required": [
      "rule",
      "refs"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "status",
   "based_on",
   "palette",
   "layout",
   "type",
   "texture",
   "hierarchy",
   "tags",
   "refs_total",
   "source",
   "as_of",
   "notice"
  ],
  "type": "object"
 },
 "title": "Describe the shared style"
}
