{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":true,"title":"Run xfix search visibility check"},"description":"Runs the xfix search check on one public page: fetches it without running JavaScript, checks robots.txt for 9 crawlers, measures mobile speed and reviews text, headings and title. Returns a score out of 100, a grade, coverage, any failed gates and the 5 biggest point losses with fixes. Takes about a minute; if not finished within about 25 seconds, returns a check_id to fetch the result later.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"url":{"description":"The full address of one public page, for example https://example.com/page.","maxLength":2000,"type":"string"}},"required":["url"],"type":"object"},"name":"check_page_visibility","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"biggest_point_losses":{"items":{"additionalProperties":false,"properties":{"fix":{"type":["string","null"]},"id":{"type":"string"},"points_lost":{"type":"number"},"status":{"type":"string"},"title":{"type":"string"},"what_we_saw":{"type":"string"}},"required":["id","title","status","points_lost","what_we_saw","fix"],"type":"object"},"type":"array"},"blocked":{"type":"boolean"},"cached":{"type":"boolean"},"check_id":{"type":"string"},"checked_at":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"coverage":{"type":["number","null"]},"failed_gates":{"items":{"additionalProperties":false,"properties":{"fix":{"type":["string","null"]},"id":{"type":"string"},"title":{"type":"string"},"what_we_saw":{"type":"string"}},"required":["id","title","what_we_saw","fix"],"type":"object"},"type":"array"},"findings":{"items":{"additionalProperties":false,"properties":{"fix":{"type":"string"},"what_we_saw":{"type":"string"},"why_it_matters":{"type":"string"}},"required":["what_we_saw","why_it_matters","fix"],"type":"object"},"typ