{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Biggest measured movers"
 },
 "description": "The events with the largest MEASURED price reactions in a window, ranked by the size of the move attributed to the event. Answers 'what actually moved and why'. Only returns events where a reaction was successfully measured.",
 "inputSchema": {
  "properties": {
   "hours": {
    "description": "Look-back window in hours (1-336, default 24).",
    "type": "integer"
   },
   "limit": {
    "description": "Max results (1-50, default 10).",
    "type": "integer"
   },
   "min_move_pct": {
    "description": "Minimum absolute move percent (default 0.5).",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "top_movers",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "min_move_pct": {
    "type": "number"
   },
   "movers": {
    "description": "Ranked by the largest absolute measured move, biggest first.",
    "items": {
     "properties": {
      "category": {
       "type": "string"
      },
      "context": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "headline": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "impact": {
       "type": "string"
      },
      "market_reaction": {
       "properties": {
        "instruments": {
         "items": {
          "properties": {
           "label": {
            "description": "Display name of the measured series.",
            "type": "string"
           },
           "move_10m_pct": {
            "description": "Percent move 10 minutes after the headline, measured from price_before.",
            "type": [
             "number",
             "null"
            ]
           },
           "move_1m_pct": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_10m": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_1m": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_before": {
            "description": "Price immediately before the headline crossed.",
            "type": [
             "number",
             "null"
            ]
           },
           "symbol": {
            "type": "string"
           },
           "volume_quality": {
            "type": [
             "string",
             "null"
            ]
           },
           "volume_ratio_10m": {
            "type": [
             "number",
             "null"
            ]
           },
           "window_minutes": {
            "type": "integer"
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        "measured_from": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "published_utc": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "tickers": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "why": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "headline"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "window_hours": {
    "type": "integer"
   }
  },
  "required": [
   "count",
   "movers"
  ],
  "type": "object"
 },
 "title": "Biggest measured movers"
}
