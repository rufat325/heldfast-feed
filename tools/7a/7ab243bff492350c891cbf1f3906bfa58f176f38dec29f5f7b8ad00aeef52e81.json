{
 "description": "Record attribute-level outcomes (pass/fail/na) for a tested sample, with an optional conclusion.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attribute": {
    "description": "The control attribute/objective tested.",
    "minLength": 1,
    "type": "string"
   },
   "conclusion": {
    "enum": [
     "effective",
     "effective-with-exceptions",
     "deficiency",
     "not-concluded"
    ],
    "type": "string"
   },
   "controlId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "populationId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "preparedBy": {
    "type": "string"
   },
   "procedure": {
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "evidenceRef": {
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "outcome": {
       "enum": [
        "pass",
        "fail",
        "na"
       ],
       "type": "string"
      },
      "reference": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "reference",
      "outcome"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "sampleId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "controlId",
   "sampleId",
   "attribute",
   "results"
  ],
  "type": "object"
 },
 "name": "record_test_result",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "testResult": {}
  },
  "required": [
   "testResult"
  ],
  "type": "object"
 },
 "title": "Record a test result"
}
