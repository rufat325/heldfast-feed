{
 "description": "Audit a single package by name, version, and ecosystem",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ecosystem": {
    "description": "Package ecosystem",
    "enum": [
     "npm",
     "PyPI",
     "crates.io",
     "Maven",
     "Go",
     "RubyGems",
     "Packagist"
    ],
    "type": "string"
   },
   "exploitData": {
    "description": "Add CISA KEV (exploited in the wild) and FIRST EPSS data and order findings by it (default: true; sends CVE IDs only)",
    "type": "boolean"
   },
   "name": {
    "description": "Package name",
    "type": "string"
   },
   "version": {
    "description": "Package version (e.g. 1.2.3)",
    "type": "string"
   }
  },
  "required": [
   "name",
   "version",
   "ecosystem"
  ],
  "type": "object"
 },
 "name": "audit_package"
}
