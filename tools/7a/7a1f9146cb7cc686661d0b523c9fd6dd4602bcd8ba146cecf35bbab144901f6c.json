    "description": "Page size (default: 50, max: 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset (default: 0)",
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "pending",
     "running",
     "completed",
     "failed",
     "waiting"
    ],
    "type": "string"
   },
   "user_id": {
    "description": "Filter to a specific Rolli user",
