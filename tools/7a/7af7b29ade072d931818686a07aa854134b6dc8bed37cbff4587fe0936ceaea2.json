{
 "annotations": {
  "readOnlyHint": true,
  "title": "List tasks"
 },
 "description": "List tasks (follow-ups) \u2014 filter by status, due-date range, assignee user, constituent, channel or purpose. Bloomerang: GET /tasks.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignee_user_ids": {
    "description": "Only tasks assigned to these user Ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "channels": {
    "items": {
     "enum": [
      "Email",
      "MassEmail",
      "Phone",
      "TextMessage",
      "Mail",
      "InPerson",
      "SocialMedia",
      "Website",
      "Twitter",
      "Other",
      "EngagementSurveyEmail",
      "EngagementSurvey"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "constituent_ids": {
    "description": "Only these constituent Ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "ids": {
    "description": "Only these task Ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "max_due_date": {
    "description": "Due on or before this date (YYYY-MM-DD).",
    "type": "string"
   },
   "min_due_date": {
    "description": "Due on or after this date (YYYY-MM-DD).",
    "type": "string"
   },
   "order_by": {
    "enum": [
     "CreatedDate",
     "Date",
     "LastModifiedDate"
    ],
    "type": "string"
   },
   "order_direction": {
    "description": "Sort direction.",
    "enum": [
     "Asc",
     "Desc"
    ],
    "type": "string"
   },
   "purposes": {
    "items": {
     "enum": [
      "Acknowledgement",
      "ImpactCultivation",
      "Newsletter",
      "Receipt",
      "Solicitation",
      "SpecialEvent",
      "VolunteerActivity",
      "PledgeReminder",
      "Welcome",
      "BenevonPointOfEntry",
      "BenevonFollowUp",
      "BenevonAskEvent",
      "BenevonOneOnOneAsk",
      "BenevonOngoingCultivation",
      "Other"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "skip": {
    "description": "Records to skip (offset). Default 0.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "statuses": {
    "description": "Only these statuses.",
    "items": {
     "enum": [
      "Active",
      "Complete",
      "Archived"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "take": {
    "description": "Page size, 1-50. Default 50.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "bloomerang_list_tasks",
 "title": "List tasks"
}
