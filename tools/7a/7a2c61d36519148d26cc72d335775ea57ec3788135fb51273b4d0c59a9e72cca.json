    "type": "string"
   },
   "product": {
    "description": "CPE path: the NVD CPE product token, such as openssl, nginx or linux_kernel. Leave out for the registry path.",
    "type": "string"
   },
   "version": {
    "description": "The version to check, such as 3.0.0.",
    "type": "string"
   }
  },
  "required": [
   "version"
  ],
  "type": "object"
 },
