{
 "description": "Search imported comment collections with ranked results. Returns matching comments with author, like count, and relevance score. Uses active comment collection by default. [~instant]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "collectionId": {
    "description": "Specific collection to search",
    "type": "string"
   },
   "maxResults": {
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "minScore": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Search query",
    "type": "string"
   },
   "useActiveCollection": {
    "type": "boolean"
   },
   "videoIdFilter": {
    "items": {
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "searchComments"
}
