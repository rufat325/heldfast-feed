{
 "description": "Read Google Ads ads with ad strength, policy approval status, serving status and metrics; read-only",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "default": 30,
    "description": "How many days back to report, ending today",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "ads_ads",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ads": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "adGroup": {
       "type": "string"
      },
      "adId": {
       "type": "string"
      },
      "adStrength": {
       "type": "string"
      },
      "approvalStatus": {
       "type": "string"
      },
      "clicks": {
       "type": "number"
      },
      "impressions": {
       "type": "number"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "adId",
      "adGroup",
      "status",
      "adStrength",
      "approvalStatus",
      "impressions",
      "clicks"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "days": {
    "type": "number"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rowCount": {
    "type": "number"
   }
  },
  "required": [
   "days",
   "rowCount",
   "ads",
   "notes"
  ],
  "type": "object"
 }
}
