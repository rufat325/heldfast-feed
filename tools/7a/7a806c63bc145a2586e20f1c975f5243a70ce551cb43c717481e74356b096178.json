{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Query historical alert records; filterable by address, rule kind, severity, and time range.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Filter by monitored address (0x-prefixed)",
    "type": "string"
   },
   "hours": {
    "description": "Alerts from the last N hours",
    "maximum": 720,
    "minimum": 1,
    "type": "integer"
   },
   "kind": {
    "description": "Filter by alert kind",
    "enum": [
     "large_outflow",
     "large_inflow",
     "balance_drain",
     "startup"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Number of records (default 20, max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "severity": {
    "description": "Filter by severity",
    "enum": [
     "info",
     "warn",
     "critical"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "query_alerts"
}
