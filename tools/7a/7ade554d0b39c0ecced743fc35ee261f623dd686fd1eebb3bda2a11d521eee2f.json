{"_meta":{"securitySchemes":[{"scopes":["idoo.read.learner"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"T\u00e0i li\u1ec7u v\u00e0 b\u1ea3n ghi bu\u1ed5i h\u1ecdc"},"description":"D\u00f9ng khi: h\u1ecdc vi\u00ean xin t\u00e0i li\u1ec7u ho\u1eb7c b\u1ea3n ghi (video) c\u1ee7a bu\u1ed5i h\u1ecdc. C\u00e2u v\u00ed d\u1ee5: \"G\u1eedi m\u00ecnh t\u00e0i li\u1ec7u bu\u1ed5i 12\", \"C\u00f3 b\u1ea3n ghi bu\u1ed5i h\u00f4m qua kh\u00f4ng?\". Kh\u00f4ng d\u00f9ng khi: h\u1ecfi \u0111\u1ec1 thi, b\u00e0i l\u00e0m (kh\u00f4ng c\u00f3). Tr\u1ea3 T\u00caN t\u00e0i li\u1ec7u, b\u1ea3n ghi v\u00e0 \u0111\u01b0\u1eddng d\u1eabn t\u1edbi trang trong c\u1ed5ng h\u1ecdc vi\u00ean (ng\u01b0\u1eddi h\u1ecdc m\u1edf b\u1eb1ng t\u00e0i kho\u1ea3n c\u1ee7a m\u00ecnh); kh\u00f4ng c\u00f3 n\u1ed9i dung t\u1ec7p, kh\u00f4ng \u0111\u01b0\u1eddng t\u1ea3i. Tham s\u1ed1 sessionNo: ch\u1ec9 l\u1ea5y c\u1ee7a bu\u1ed5i s\u1ed1 n\u00e0y (0 = m\u1ecdi bu\u1ed5i).","inputSchema":{"properties":{"sessionNo":{"default":0,"type":"integer"}},"type":"object"},"name":"list_class_materials","outputSchema":{"properties":{"answer":{"type":"string"},"materials":{"items":{"properties":{"className":{"type":"string"},"kind":{"type":"string"},"name":{"type":"string"},"portalPage":{"type":"string"},"sessionNo":{"type":"integer"}},"required":["className","sessionNo","kind","name","portalPage"],"type":"object"},"type":"array"},"nextStep":{"properties":{"text":{"type":"string"},"url":{"type":["string","null"]}},"required":["text","url"],"type":"object"},"note":{"type":"string"},"untrusted":{"type":"boolean"},"updatedAt":{"type":"string"}},"required":["answer","nextStep","materials","updatedAt","untrusted","note"],"type":"object"},"title":"T\u00e0i li\u1ec7u v\u00e0 b\u1ea3n ghi bu\u1ed5i h\u1ecdc"}
