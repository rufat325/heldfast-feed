{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a current price preview for complete ride facts, using local service time and addresses with city or postcode. No availability guarantee, booking, charge, message or reservation. Do not include customer contact details.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "locale": {
    "default": "de",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "ride": {
    "additionalProperties": false,
    "properties": {
     "date": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "destination": {
      "maxLength": 240,
      "minLength": 2,
      "type": "string"
     },
     "flightNumber": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "hours": {
      "maximum": 24,
      "minimum": 1,
      "type": "integer"
     },
     "luggage": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "passengers": {
      "maximum": 60,
      "minimum": 1,
      "type": "integer"
     },
     "pickup": {
      "maxLength": 240,
      "minLength": 2,
      "type": "string"
     },
     "returnDate": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "returnTime": {
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     "serviceType": {
      "enum": [
       "hourly"
      ],
      "type": "string"
     },
     "time": {
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     "tripType": {
      "enum": [
       "one_way",
       "return"
      ],
      "type": "string"
     }
    },
    "required": [
     "pickup",
     "destination",
     "date",
     "time",
     "passengers",
     "tripType"
    ],
    "type": "object"
   },
   "specialRequests": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ride"
  ],
  "type": "object"
 },
 "name": "quote_ride",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "status": {
      "const": "invalid_request",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "status": {
      "const": "unavailable",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "retryAfterSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "status": {
      "const": "rate_limited",
      "type": "string"
     }
    },
    "required": [
     "status",
     "bookingUrl",
     "retryAfterSeconds"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "status": {
      "const": "review_required",
      "type": "string"
     }
    },
    "required": [
     "status",
     "bookingUrl",
     "message"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingConfirmed": {
      "const": false,
      "type": "boolean"
     },
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "nextAction": {
      "type": "string"
     },
     "quote": {
      "additionalProperties": false,
      "properties": {
       "billableHoursPerServiceLine": {
        "exclusiveMinimum": 0,
        "type": "number"
       },
       "calculatedAt": {
        "type": "string"
       },
       "currency": {
        "type": "string"
       },
       "grossTotalCents": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "parkingIncluded": {
        "type": "boolean"
       },
       "pricesIncludeVat": {
        "type": "boolean"
       },
       "revalidationRequired": {
        "const": true,
        "type": "boolean"
       },
       "serviceLines": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "direction": {
           "enum": [
            "outbound",
            "return"
           ],
           "type": "string"
          },
          "grossAmountCents": {
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "direction",
          "grossAmountCents"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "tollsIncluded": {
        "type": "boolean"
       },
       "vatRateBasisPoints": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "vehicleCount": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       }
      },
      "required": [
       "currency",
       "grossTotalCents",
       "pricesIncludeVat",
       "vatRateBasisPoints",
       "parkingIncluded",
       "tollsIncluded",
       "vehicleCount",
       "billableHoursPerServiceLine",
       "serviceLines",
       "calculatedAt",
       "revalidationRequired"
      ],
      "type": "object"
     },
     "status": {
      "const": "quoted",
      "type": "string"
     }
    },
    "required": [
     "status",
     "bookingUrl",
     "bookingConfirmed",
     "quote",
     "nextAction"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Chauffeur price preview"
}
