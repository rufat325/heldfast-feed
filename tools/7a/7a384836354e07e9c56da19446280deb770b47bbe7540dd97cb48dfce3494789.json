{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update form properties. Only provided fields are changed. state: 0=active, 1=closed, 2=archived. expires=0 disables expiration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allowEditSubmissions": {
    "type": "boolean"
   },
   "description": {
    "type": "string"
   },
   "expires": {
    "description": "Unix timestamp; 0 = no expiration",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "formId": {
    "description": "Form ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "isAnonymous": {
    "type": "boolean"
   },
   "showExpiration": {
    "type": "boolean"
   },
   "state": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     },
     {
      "const": 2,
      "type": "number"
     }
    ]
   },
   "submissionMessage": {
    "type": "string"
   },
   "submitMultiple": {
    "type": "boolean"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "formId"
  ],
  "type": "object"
 },
 "name": "update_form",
 "title": "Update Form"
}
