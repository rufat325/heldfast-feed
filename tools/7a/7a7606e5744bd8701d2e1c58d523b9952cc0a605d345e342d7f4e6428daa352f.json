{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Request a quote"
 },
 "description": "Submit a quote request for one or more SKUs with buyer contact info. KEYED tool \u2014 requires a valid API key. Sales follows up out-of-band.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contact": {
    "additionalProperties": false,
    "properties": {
     "company": {
      "description": "Company name.",
      "type": "string"
     },
     "email": {
      "description": "Requester email.",
      "type": "string"
     },
     "name": {
      "description": "Requester name.",
      "minLength": 1,
      "type": "string"
     },
     "phone": {
      "description": "Phone number.",
      "type": "string"
     }
    },
    "required": [
     "name",
     "email"
    ],
    "type": "object"
   },
   "items": {
    "description": "Line items to quote.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "quantity": {
       "description": "Units requested.",
       "exclusiveMinimum": 0,
       "maximum": 100000,
       "type": "integer"
      },
      "sku": {
       "description": "Product SKU.",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "sku",
      "quantity"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "notes": {
    "description": "Free-text context / use case.",
    "type": "string"
   }
  },
  "required": [
   "items",
   "contact"
  ],
  "type": "object"
 },
 "name": "request_quote"
}
