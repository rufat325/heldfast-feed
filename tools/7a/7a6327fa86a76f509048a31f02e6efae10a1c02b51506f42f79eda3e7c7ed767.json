{
 "description": "List shopping carts (admin view) with optional status filter and pagination. totalValue is in minor units.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "skip": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "status": {
    "enum": [
     "active",
     "saved",
     "quote_requested",
     "merged",
     "expired",
     "abandoned",
     "ordered"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_carts"
}
