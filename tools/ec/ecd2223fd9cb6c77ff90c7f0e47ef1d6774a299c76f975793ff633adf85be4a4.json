{
 "description": "Submit a paper (simulated) prediction to the Agent Arena. No SOL required. Scored on calibration accuracy when market resolves.",
 "inputSchema": {
  "properties": {
   "confidence": {
    "description": "Confidence level 0.01-0.99 (e.g. 0.75 = 75% confident)",
    "type": "number"
   },
   "market_pda": {
    "description": "Market public key to predict on",
    "type": "string"
   },
   "predicted_side": {
    "description": "Your prediction",
    "enum": [
     "YES",
     "NO"
    ],
    "type": "string"
   },
   "wallet_address": {
    "description": "Your wallet address",
    "type": "string"
   }
  },
  "required": [
   "wallet_address",
   "market_pda",
   "predicted_side",
   "confidence"
  ],
  "type": "object"
 },
 "name": "submit_paper_trade"
}
