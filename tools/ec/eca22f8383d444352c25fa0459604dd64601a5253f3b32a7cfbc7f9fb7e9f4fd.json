    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "compatibleWithSessionId": {
    "description": "Only plans that can pay for this session.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "includeDisabled": {
    "description": "Also include disabled plans.",
    "type": "boolean"
   },
   "onlyFeatured": {
    "description": "Only featured plans.",
    "type": "boolean"
   },
   "page": {
    "description": "Page number, starting at 0 (default 0).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "description": "Rows per page, 1-200 (default 20).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "sortBy": {
    "description": "Field to sort by.",
    "enum": [
     "name",
     "orderNumber"
    ],
    "type": "string"
   },
   "sortOrder": {
    "description": "Sort direction.",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
