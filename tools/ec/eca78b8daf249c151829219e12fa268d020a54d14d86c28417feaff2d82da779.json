{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Read the Bitcoin market position"},"description":"The Bitcoin market observatory's reading (/dashboard): the Bitcoin price in AUD, USD, EUR or GBP (default AUD), the Mayer Multiple (price over the mean of the 200 completed UTC daily USD closes, unavailable if any of those days is missing) and the position against the published Power Law model trend (USD, \u03c3 0.2). Without a day it reads now, from the cached spot with its own time; with a past day (YYYY-MM-DD) it reads that day's close. The server supplies every price: callers cannot submit a series. Historical measurement only: not a forecast, a valuation, or a signal to buy or sell.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"currency":{"enum":["usd","aud","eur","gbp","USD","AUD","EUR","GBP"],"type":"string"},"day":{"format":"date","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$","type":"string"}},"type":"object"},"name":"read_market_position","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"climate":{"anyOf":[{"enum":["constructive","balanced","extended","mixed"],"type":"string"},{"type":"null"}]},"climateHeadline":{"type":["string","null"]},"climateSentence":{"type":["string","null"]},"currency":{"enum":["usd","aud","eur","gbp"],"type":"string"},"day":{"type":"string"},"history":{"anyOf":[{"additionalProperties":false,"properties":{"basis":{"type":"string"},"from":{"type":"string"},"generatedAt":{"type":"string"},"source":{"type":"string"},"stale":{"type":"boolean"},"to":{"type":"string"}},"required":["from","to","generatedAt","source","basis","stale"],"type":"object"},{"type":"null"}]},"live":{"type":"boolean"},"mayer":{"anyOf":[{"additionalProperties":false,"properties":{"average":{"type":"number"},"from":{"type":"string"},"multiple":{"type":"number"},"to":{"type":"string"},"zone":{"enum":["deep-value","below-average","above-average","overheated"],"type":"string"}},"required":["multiple","zone","average","from","to"],"type":"object"},{"additionalProperties":false,"properties":{"unavailable":{"enum":["no-history","history-stale","gap-in-window","before-history","no-spot","no-close","no-cross","not-completed"],"type":"string"}},"required":["unavailable"],"type":"object"}]},"price":{"additionalProperties":false,"properties":{"observedAt":{"type":["string","null"]},"source":{"type":["string","null"]},"usd":{"type":["number","null"]},"value":{"type":["number","null"]}},"required":["value","usd","observedAt","source"],"type":"object"},"trend":{"anyOf":[{"additionalProperties":false,"properties":{"deviation":{"type":"number"},"distance":{"type":"number"},"trend":{"type":["number","null"]},"trendUsd":{"type":"number"},"zone":{"enum":["deep-support","below-trend","near-trend","extended","euphoria"],"type":"string"}},"required":["trendUsd","trend","deviation","distance","zone"],"type":"object"},{"additionalProperties":false,"properties":{"trendUsd":{"type":["number","null"]},"unavailable":{"enum":["no-history","history-stale","gap-in-window","before-history","no-spot","no-close","no-cross","not-completed"],"type":"string"}},"required":["unavailable","trendUsd"],"type":"object"}]}},"required":["currency","day","live","price","mayer","trend","climate","climateHeadline","climateSentence","history"],"type":"object"},"title":"Read the Bitcoin market position"}
