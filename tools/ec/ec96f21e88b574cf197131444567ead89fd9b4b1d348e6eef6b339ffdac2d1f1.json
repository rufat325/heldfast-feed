{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Batch Settlement"
 },
 "description": "Submit multiple settlements in a single call. Runs all settlements concurrently \u2014 one failure does not block others. Returns a summary (total/succeeded/failed) and per-item results mirroring what POST /settle would return. Maximum 50 per batch.",
 "inputSchema": {
  "properties": {
   "settlements": {
    "description": "Array of settlement request objects (same schema as the settle tool)",
    "items": {
     "properties": {
      "amount": {
       "type": "number"
      },
      "destinationCurrency": {
       "type": "string"
      },
      "recipientAddress": {
       "type": "string"
      },
      "sandbox": {
       "type": "boolean"
      },
      "sourceCurrency": {
       "type": "string"
      },
      "token": {
       "type": "string"
      }
     },
     "required": [
      "amount",
      "sourceCurrency",
      "destinationCurrency",
      "recipientAddress"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "settlements"
  ],
  "type": "object"
 },
 "name": "batch_settle",
 "outputSchema": {
  "properties": {
   "results": {
    "items": {
     "properties": {
      "data": {
       "additionalProperties": true,
       "type": "object"
      },
      "index": {
       "type": "number"
      },
      "status": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "properties": {
     "failed": {
      "type": "number"
     },
     "succeeded": {
      "type": "number"
     },
     "total": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 }
}
