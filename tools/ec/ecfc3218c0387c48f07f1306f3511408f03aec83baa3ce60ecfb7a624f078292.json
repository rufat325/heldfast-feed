{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List Hostkey account servers with filters. Before the first call, automatically refreshes inventory (eq/update_servers). Returns server IDs and brief data; use get_server for the full card.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "group": {
    "description": "Groups, comma-separated: VPS,Gpu,1CPU,2CPU,AMD,Instances,Storage,Nodes,Micro,Mini,Dell",
    "type": "string"
   },
   "ip": {
    "description": "Find server by IP address",
    "type": "string"
   },
   "location": {
    "description": "Location codes, comma-separated: NL,US,FI,DE,IS,TR,UK,ES,IT,PL,CH",
    "type": "string"
   },
   "mac": {
    "description": "Find server by MAC address",
    "type": "string"
   },
   "status": {
    "description": "Status: rent (active) or power_off (suspended)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_servers"
}
