{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run a complete governed coding task inside DvalinCode. Long calls are expected; callers should use a generous timeout.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cwd": {
    "type": "string"
   },
   "max_iterations": {
    "minimum": 1,
    "type": "integer"
   },
   "permission_mode": {
    "enum": [
     "plan",
     "auto",
     "bypass"
    ],
    "type": "string"
   },
   "prompt": {
    "type": "string"
   },
   "session_id": {
    "type": "string"
   },
   "timeout_minutes": {
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "dvalin_run_task",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 }
}
