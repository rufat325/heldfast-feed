{
 "_meta": {
  "openai/outputTemplate": "ui://teas/app-v4.html",
  "openai/toolInvocation/invoked": "Basket updated",
  "openai/toolInvocation/invoking": "Adding to your basket",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "account.read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://teas/app-v4.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add to basket"
 },
 "description": "Use this when someone asks to add teas.co.uk products to their basket. Each quantity is added to what is already there, so a product already in the basket goes up by that amount. Ids come from find_products. If any id is unknown, the call fails, names that id and adds nothing. A product that cannot be added (out of stock, or over the 20 kg parcel limit) is listed in messages while the rest are added. Nothing is bought or charged. Leave basket_id out on hosts that identify the customer; otherwise pass the basket_id from the first basket result every time. To change or remove a line use update_basket. To buy chosen products straight away use checkout_session.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "basket_id": {
    "description": "Only for hosts that do not identify the user: the basket_id returned by an earlier basket tool in this conversation. Leave it out otherwise.",
    "pattern": "^[A-Za-z0-9_-]{20,64}$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Optional. A unique key for this change (8 to 128 letters, digits or . _ : -). Sending the same key again within 24 hours returns the first answer instead of making the change twice.",
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "items": {
    "description": "Products and quantities to add.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "description": "Product id from find_products.",
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "description": "How many packs.",
       "maximum": 99,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "id",
      "quantity"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "add_to_basket",
 "outputSchema": {
  "properties": {
   "added": {
    "description": "How many products were added.",
    "type": "integer"
   },
   "basket_id": {
    "description": "Present only when the host did not identify the user: pass it to later basket tools.",
    "type": "string"
   },
   "delivery": {
    "properties": {
     "free_over_text": {
      "type": [
       "string",
       "null"
      ]
     },
     "note": {
      "type": "string"
     },
     "price": {
      "type": [
       "number",
       "null"
      ]
     },
     "price_text": {
      "type": [
       "string",
       "null"
      ]
     },
     "spend_more_for_free": {
      "description": "How much more to spend for free UK delivery.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "items": {
    "description": "Number of items in the basket.",
    "type": "integer"
   },
   "lines": {
    "items": {
     "properties": {
      "id": {
       "type": "string"
      },
      "image": {
       "type": [
        "string",
        "null"
       ]
      },
      "line_text": {
       "type": "string"
      },
      "line_total": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "quantity": {
       "type": "integer"
      },
      "shop": {
       "type": "string"
      },
      "unit_price": {
       "type": "number"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "quantity",
      "line_text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "messages": {
    "description": "Anything that could not be added or changed, in plain words.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "subtotal": {
    "description": "Pounds including VAT, before delivery.",
    "type": "number"
   },
   "subtotal_text": {
    "type": "string"
   }
  },
  "required": [
   "items",
   "lines",
   "subtotal_text",
   "delivery",
   "messages"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "account.read"
   ],
