{
 "description": "Process an inbound message received from an external channel.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "altId": {
    "description": "Alternate ID for custom channel",
    "type": "string"
   },
   "conversationId": {
    "description": "Conversation ID",
    "type": "string"
   },
   "conversationProviderId": {
    "description": "Conversation provider ID",
    "type": "string"
   },
   "direction": {
    "description": "Message direction (inbound)",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "message": {
    "description": "Inbound message body",
    "type": "string"
   },
   "type": {
    "description": "Message channel type (SMS, Email, WhatsApp, GMB, IG, FB, Custom, Live_Chat)",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "type",
   "message"
  ],
  "type": "object"
 },
 "name": "crm_process_inbound_message"
}
