 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan an agent team"
 },
 "description": "Without sign-in: dry-run a Team or Agent manifest or template for unclaimed creation. Creates nothing.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "manifest": {
    "additionalProperties": {},
    "description": "A centralcity.agent/v1 manifest (kind Agent or Team). See docs/AGENT_MANIFEST.md; list templates with city_list_templates.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "parent_agent_id": {
    "description": "Optional existing agent to create under (lineage for cascade revoke). Not available anonymously.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "template": {
    "description": "Built-in template reference, for example template:research-team@1.0.0.",
    "maxLength": 128,
    "pattern": "^template:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?@\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "city_plan_team",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "mode": {
    "enum": [
     "owned",
     "unclaimed"
    ],
    "type": "string"
   },
   "next_actions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "plan": {
    "additionalProperties": {},
    "properties": {
     "errors": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "hint": {
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "path",
        "message",
        "hint"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "ok": {
      "type": "boolean"
     },
     "requiresApproval": {
      "type": "boolean"
     },
     "warnings": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "hint": {
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "path",
        "message",
        "hint"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "ok",
     "errors",
     "warnings",
     "requiresApproval"
    ],
    "type": "object"
   },
   "team_hash": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "mode",
   "ok",
   "team_hash",
   "plan",
   "next_actions"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
