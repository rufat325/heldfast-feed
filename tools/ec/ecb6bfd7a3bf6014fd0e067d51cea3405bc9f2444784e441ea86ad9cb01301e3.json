{
 "description": "Builds an arrangement of the given duration from the project's regions, sequentially or at random (requires regions - e.g. from auto_edit).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "crossfades": {
    "description": "Apply crossfades at joints (default true)",
    "type": "boolean"
   },
   "duration_seconds": {
    "description": "Target duration (default 60)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "mode": {
    "description": "Selection mode (default sequential)",
    "enum": [
     "random",
     "sequential"
    ],
    "type": "string"
   },
   "project": {
    "description": "Path to the .audium project package (absolute paths recommended)",
    "type": "string"
   },
   "seed": {
    "description": "Random seed for reproducible random mode",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "track": {
    "description": "Track id (default 0)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "name": "assemble",
 "title": "Assemble arrangement"
}
