{
 "description": "List the 17 principles of the COSO ICIF-2013, optionally filtered to a single component.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "component": {
    "description": "Restrict to a single component id.",
    "enum": [
     "control-environment",
     "risk-assessment",
     "control-activities",
     "information-communication",
     "monitoring-activities"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_principles",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "framework": {
    "type": "string"
   },
   "principles": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "component": {
       "enum": [
        "control-environment",
        "risk-assessment",
        "control-activities",
        "information-communication",
        "monitoring-activities"
       ],
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "number": {
       "type": "number"
      },
      "statement": {
       "type": "string"
      }
     },
     "required": [
      "number",
      "id",
      "component",
      "statement"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "framework",
   "count",
   "principles"
  ],
  "type": "object"
 },
 "title": "List COSO principles"
}
