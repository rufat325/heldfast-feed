{
 "description": "Update an existing demand source",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Demand source ID",
    "type": "number"
   },
   "name": {
    "description": "Demand source name",
    "type": "string"
   },
   "spend_limit": {
    "description": "Spend limit amount",
    "type": "number"
   },
   "spend_limit_end": {
    "description": "Spend limit end date (ISO-8601)",
    "type": "string"
   },
   "spend_limit_period": {
    "description": "Spend limit reset interval",
    "enum": [
     "once",
     "weekly",
     "biweekly",
     "monthly",
     "quarterly"
    ],
    "type": "string"
   },
   "spend_limit_start": {
    "description": "Spend limit start date (ISO-8601)",
    "type": "string"
   },
   "status": {
    "description": "Whether to send bid requests",
    "enum": [
     "active",
     "inactive"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_demand_source"
}
