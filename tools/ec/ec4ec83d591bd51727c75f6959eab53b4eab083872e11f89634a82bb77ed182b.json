      "zetachain",
      "filecoin",
      "core-dao",
      "aurora",
      "moonbeam",
      "klaytn",
      "bob",
      "canto",
      "monad",
      "tempo",
      "megaeth",
      "arc",
      "plasma",
      "katana",
      "robinhood",
      "pharos",
      "hyperevm"
     ],
     "type": "string"
    },
    "maxItems": 15,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "chain.compare",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "chainsCompared": {
    "type": "number"
   },
   "comparison": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "blockTime": {
       "type": "string"
      },
      "chain": {
       "description": "Blockchain queried",
       "type": "string"
      },
      "defi": {},
      "gas": {
       "anyOf": [
        {},
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "nativeAsset": {}
     },
     "required": [
