      "name",
      "blockTime",
      "nativeAsset",
      "gas",
      "defi"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "rankings": {
    "additionalProperties": false,
    "properties": {
     "cheapestGas": {
      "type": "string"
     },
     "fastestBlock": {
      "type": "string"
     }
    },
    "required": [
     "cheapestGas",
     "fastestBlock"
    ],
    "type": "object"
   },
   "timestamp": {
    "description": "Unix timestamp ms",
    "type": "number"
   }
  },
