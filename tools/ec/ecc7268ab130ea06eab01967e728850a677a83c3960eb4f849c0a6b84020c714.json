 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "endDate": {
    "description": "Last night (day before check-out), YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "page": {
    "description": "Page number beyond the first (2, 3, ...). Check pages.nextPageExists in the previous response.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "propertyIds": {
    "description": "One or more property ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "roomIds": {
    "description": "One or more room ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "startDate": {
    "description": "First night, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "beds24_get_room_availability",
 "title": "Get room availability"
}
