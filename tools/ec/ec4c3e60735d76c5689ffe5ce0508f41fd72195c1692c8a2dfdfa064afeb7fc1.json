{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Run a funnel analysis report to track user progression through steps (Data API v1alpha).\n\nEach step matches an event: set 'eventName' per step (defaults to the step name).\nFor advanced matching, pass a full 'filterExpression' instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dateRanges": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "endDate": {
       "description": "End date (YYYY-MM-DD or \"yesterday\", \"today\", \"7daysAgo\")",
       "type": "string"
      },
      "name": {
       "description": "Optional name for the date range",
       "type": "string"
      },
      "startDate": {
       "description": "Start date (YYYY-MM-DD or \"yesterday\", \"today\", \"7daysAgo\")",
       "type": "string"
      }
     },
     "required": [
      "startDate",
      "endDate"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "funnelBreakdown": {
    "additionalProperties": false,
    "description": "Optional dimension to break down funnel",
    "properties": {
     "name": {
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "funnelSteps": {
    "description": "Steps in the funnel",
    "items": {
     "additionalProperties": false,
     "properties": {
      "eventName": {
       "description": "Event that defines the step (defaults to name)",
       "type": "string"
      },
      "filterExpression": {
       "additionalProperties": {},
       "description": "Advanced FunnelFilterExpression (overrides eventName)",
       "type": "object"
      },
      "isDirectlyFollowedBy": {
       "type": "boolean"
      },
      "name": {
       "description": "Display name for the step",
       "type": "string"
      },
      "withinDurationFromPriorStep": {
       "description": "e.g., \"3600s\"",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "funnelVisualizationType": {
    "enum": [
     "STANDARD_FUNNEL",
     "TRENDED_FUNNEL"
    ],
    "type": "string"
   },
   "propertyId": {
    "description": "GA4 property ID to query (overrides the default GA_PROPERTY_ID). Accepts \"123456789\" or \"properties/123456789\". Use ga_get_account_summaries to discover IDs.",
    "type": "string"
   }
  },
  "required": [
   "dateRanges",
   "funnelSteps"
  ],
  "type": "object"
 },
 "name": "ga_run_funnel_report"
}
