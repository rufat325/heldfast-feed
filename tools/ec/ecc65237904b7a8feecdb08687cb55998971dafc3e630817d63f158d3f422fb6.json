{
 "description": "Update an x402 paywall configuration. Can change price, resource URL, active status, or any other field.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "New price in human-readable format (e.g. \"0.05\")",
    "type": "string"
   },
   "description": {
    "description": "New description",
    "type": "string"
   },
   "is_active": {
    "description": "Enable (true) or disable (false) the paywall",
    "type": "boolean"
   },
   "name": {
    "description": "New paywall name",
    "type": "string"
   },
   "paywall_id": {
    "description": "Paywall ID to update",
    "type": "integer"
   },
   "resource_mime": {
    "description": "New MIME type",
    "type": "string"
   },
   "resource_url": {
    "description": "New resource URL",
    "format": "uri",
    "type": "string"
   },
   "token_decimals": {
    "description": "Token decimals. Read from the paywall itself when omitted",
    "maximum": 36,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "paywall_id"
  ],
  "type": "object"
 },
 "name": "update_paywall"
}
