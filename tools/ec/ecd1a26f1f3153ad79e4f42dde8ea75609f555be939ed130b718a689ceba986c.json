{
 "description": "Check if a package name looks like a typosquat of a popular package. Generates likely typo variants and checks which ones exist in the registry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ecosystem": {
    "default": "npm",
    "description": "Package ecosystem (default: npm)",
    "enum": [
     "npm",
     "pypi",
     "go",
     "maven",
     "cargo",
     "nuget",
     "rubygems",
     "pub"
    ],
    "type": "string"
   },
   "name": {
    "description": "Package name to check",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "hound_typosquat"
}
