{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get execution plan for a SQL query - shows how PostgreSQL will execute the query",
 "inputSchema": {
  "properties": {
   "analyze": {
    "default": false,
    "description": "Actually run the query to get real execution times",
    "type": "boolean"
   },
   "database_id": {
    "description": "Database ID",
    "type": "number"
   },
   "format": {
    "default": "text",
    "description": "Output format for the plan",
    "enum": [
     "text",
     "json",
     "yaml"
    ],
    "type": "string"
   },
   "sql": {
    "description": "SQL query to analyze",
    "type": "string"
   },
   "verbose": {
    "default": false,
    "description": "Include additional details in the plan",
    "type": "boolean"
   }
  },
  "required": [
   "database_id",
   "sql"
  ],
  "type": "object"
 },
 "name": "db_query_explain",
 "title": "Explain Query Plan"
}
