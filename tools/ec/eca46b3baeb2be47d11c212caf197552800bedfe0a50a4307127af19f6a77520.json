{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List asset replacement plans"
 },
 "description": "List asset replacement plans for lifecycle/capital planning. Filter by asset, status, priority, or planned year. Amounts are bare numbers with no currency: call get_organization_settings for currency_code before stating one.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset_id": {
    "description": "Filter by asset ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "page": {
    "description": "Page number (default: all pages fetched automatically)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page (default: 1000, max: 1000). All pages are fetched automatically.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "priority": {
    "description": "Filter by priority",
    "enum": [
     "CRITICAL",
     "HIGH",
     "MEDIUM",
     "LOW"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by plan status",
    "enum": [
     "PLANNED",
     "BUDGETED",
     "APPROVED",
     "COMPLETED",
     "CANCELLED"
    ],
    "type": "string"
   },
   "year": {
    "description": "Filter by planned replacement year",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_asset_replacement_plans",
 "title": "List asset replacement plans"
}
