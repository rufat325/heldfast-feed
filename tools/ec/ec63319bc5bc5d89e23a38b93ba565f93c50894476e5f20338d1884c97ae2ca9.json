  "readOnlyHint": true,
  "title": "Copy-trade backtest"
 },
 "description": "Would copying this wallet have made money? Replays its pump.fun entries and exits 0\u201325 slots late on the recorded curve and shows where the edge dies. Takes the wallet's pump.fun positions over the last 1\u201314 days and simulates a copier that buys the same token and sells when the leader sells, arriving 0, 1, 2, 5, 10 or 25 slots (0\u201310 s) late. Fills use the bonding-curve reserves our tape recorded at that moment, including curve fees and the copy's own price impact. Returns PnL, win rate and ROI per latency, the leader's own median ROI for contrast, and a verdict: copyable, latency-sensitive (edge gone by N slots), or not copyable. A wallet that looks great on its own PnL often loses money for anyone who follows it. When to use: After pump_wallet or smart_money, to check copying survives realistic delay. Price: $0.03 per call (10 free/day; after that a payment-required result lists x402 options). Errors: returns isError with a message for invalid input or an upstream failure (not charged).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "days": {
    "default": 3,
    "description": "How many days of the wallet's history to replay. Range 1-14. Default 3.",
    "maximum": 14,
    "minimum": 1,
    "type": "integer"
   },
   "exit": {
    "default": "first_sell",
    "description": "sell on the leader's first sell, or once it has sold 90%. Default \"first_sell\".",
    "pattern": "^(first_sell|full_exit)$",
    "type": "string"
   },
   "max_positions": {
    "default": 150,
    "description": "most recent positions to replay. Range 10-300. Default 150.",
    "maximum": 300,
    "minimum": 10,
    "type": "integer"
   },
   "size_sol": {
    "default": 0.1,
    "description": "SOL per copied entry. Range 0.01-10. Default 0.1.",
    "maximum": 10,
    "minimum": 0.01,
    "type": "number"
   },
   "wallet": {
    "description": "leader wallet to copy. Base58 Solana address, 32-44 chars.",
    "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
    "type": "string"
   }
  },
  "required": [
   "wallet"
  ],
  "type": "object"
 },
 "name": "copy_backtest",
