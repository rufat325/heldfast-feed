{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Re-download a bought skill"
 },
 "description": "Re-download the SKILL.md file you already bought (free), using the token from your purchase receipt. Always returns the current version of the skill.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "token": {
    "description": "The re-download token from your purchase receipt (the 'redownload' part): 64 lowercase hex characters. Not your payment signature.",
    "type": "string"
   }
  },
  "required": [
   "token"
  ],
  "type": "object"
 },
 "name": "redownload_skill",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bytes": {
    "description": "Size of the file in bytes.",
    "type": "number"
   },
   "changelog": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "What changed in this version; null if not recorded."
   },
   "file": {
    "additionalProperties": {},
    "description": "The file itself.",
    "properties": {
     "content": {
      "description": "The full SKILL.md text.",
      "type": "string"
     },
     "encoding": {
      "description": "Text encoding of content, 'utf-8'.",
      "type": "string"
     },
     "name": {
      "description": "File name, 'SKILL.md'.",
      "type": "string"
     }
    },
    "required": [
     "name",
     "encoding",
     "content"
    ],
    "type": "object"
   },
   "install": {
    "additionalProperties": {},
    "description": "Where to install the file.",
    "properties": {
     "claude_code": {
      "description": "Where to put the file for Claude Code.",
      "type": "string"
     },
     "generic": {
      "description": "The folder layout for any Agent Skills client.",
      "type": "string"
     }
    },
    "required": [
     "claude_code",
     "generic"
    ],
    "type": "object"
   },
   "license": {
    "additionalProperties": {},
    "properties": {
     "holder": {
      "description": "Who holds the rights.",
      "type": "string"
     },
     "summary": {
      "description": "The license in one sentence.",
      "type": "string"
     },
     "url": {
      "description": "Page with the full license text.",
      "type": "string"
     }
    },
    "required": [
     "summary",
     "holder",
     "url"
    ],
    "type": "object"
   },
   "name": {
    "description": "Display name.",
    "type": "string"
   },
   "ok": {
    "const": true,
    "description": "Always true on success.",
    "type": "boolean"
   },
   "purchase": {
    "additionalProperties": {},
    "description": "Your purchase record.",
    "properties": {
     "downloads": {
      "description": "How many times the file has been delivered, including this call.",
      "type": "number"
     },
     "status": {
      "description": "Purchase state, for example 'active' or 'pending' (payment settlement not yet confirmed).",
      "type": "string"
     }
    },
    "required": [
     "status",
     "downloads"
    ],
    "type": "object"
   },
   "sha256": {
    "description": "SHA-256 of the delivered file, lowercase hex.",
    "type": "string"
   },
   "skill": {
    "description": "Slug of the skill.",
    "type": "string"
   },
   "version": {
    "description": "The current version being delivered (may be newer than the one first bought).",
    "type": "string"
   }
  },
  "required": [
   "ok",
   "skill",
   "name",
   "version",
   "sha256",
   "bytes",
   "license",
   "file",
   "install",
   "changelog",
   "purchase"
  ],
  "type": "object"
 },
 "title": "Re-download a bought skill"
}
