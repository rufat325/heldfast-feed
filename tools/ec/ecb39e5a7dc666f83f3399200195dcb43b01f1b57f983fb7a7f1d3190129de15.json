    "properties": {
     "category": {
      "description": "Normalised Norwegian category: 'konkurs' (bankruptcy), 'fusjon' (merger), 'fisjon' (demerger), 'eierbytte' (change of ownership), 'aarsregnskap' (annual accounts), ...",
