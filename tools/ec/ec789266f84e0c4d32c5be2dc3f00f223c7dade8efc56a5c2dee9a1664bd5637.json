{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add a video or audio clip to a Picorn timeline. Source URLs must use an approved public media host. Video positions are center coordinates; timing and trim values are frame-based.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "durationFrames": {
    "maximum": 3600,
    "minimum": 1,
    "type": "integer"
   },
   "kind": {
    "enum": [
     "video",
     "audio"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 160,
    "type": "string"
   },
   "position": {
    "additionalProperties": {},
    "type": "object"
   },
   "posterUrl": {
    "format": "uri",
    "type": "string"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   },
   "size": {
    "additionalProperties": {},
    "type": "object"
   },
   "slideId": {
    "minLength": 1,
    "type": "string"
   },
   "sourceDurationFrames": {
    "minimum": 1,
    "type": "integer"
   },
   "sourceFps": {
    "maximum": 120,
    "minimum": 1,
    "type": "number"
   },
   "src": {
    "format": "uri",
    "type": "string"
   },
   "startFrame": {
    "minimum": 0,
    "type": "integer"
   },
   "transform": {
    "additionalProperties": {},
    "type": "object"
   },
   "trimEndFrame": {
    "minimum": 1,
    "type": "integer"
   },
   "trimStartFrame": {
    "minimum": 0,
    "type": "integer"
   },
   "volume": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "projectId",
   "slideId",
   "kind",
   "src",
   "durationFrames"
  ],
  "type": "object"
 },
 "name": "picorn_video_add_clip",
 "title": "Picorn Video: add media clip"
}
