{"description":"Export many nodes at a scale or targetWidth (clamped 0.01 to 4). Files go to outputDir (default ~/.deskhand/exports/), named by namePattern ({name} {id} {scale} {ext} {index}). One row per item; nothing is inlined.","inputSchema":{"properties":{"items":{"items":{"properties":{"format":{"default":"PNG","enum":["PNG","SVG","JPG","PDF"],"type":"string"},"name":{"description":"File name stem (default: node name)","type":"string"},"nodeId":{"type":"string"},"scale":{"description":"Ignored when targetWidth is given","exclusiveMinimum":0,"type":"number"},"targetWidth":{"description":"Output width in px","exclusiveMinimum":0,"type":"number"}},"required":["nodeId"],"type":"object"},"maxItems":100,"minItems":1,"type":"array"},"namePattern":{"default":"{name}@{scale}x.{ext}","type":"string"},"outputDir":{"description":"Absolute directory (created if missing)","type":"string"}},"required":["items"],"type":"object"},"name":"figma_export_batch"}
