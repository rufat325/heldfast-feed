{
 "description": "Get tasks in a specific list, scoped to the audit time window (default last 7 days; pass any window). Supports pagination, filters, custom fields. Use the `time_window` parameter ('1h'|'6h'|'1d'|'3d'|'7d') to scope the audit.",
 "inputSchema": {
  "properties": {
   "archived": {
    "type": "boolean"
   },
   "assignees": {
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      }
     ]
    },
    "type": "array"
   },
   "custom_fields": {
    "type": "string"
   },
   "date_created_gt": {
    "type": "integer"
   },
   "date_created_lt": {
    "type": "integer"
   },
   "date_updated_gt": {
    "type": "integer"
   },
   "date_updated_lt": {
    "type": "integer"
   },
   "due_date_gt": {
    "type": "integer"
   },
   "due_date_lt": {
    "type": "integer"
   },
   "include_closed": {
    "type": "boolean"
   },
   "include_markdown_description": {
    "type": "boolean"
   },
   "list_id": {
    "minLength": 1,
    "type": "string"
   },
   "order_by": {
    "enum": [
     "id",
     "created",
     "updated",
     "due_date"
    ],
    "type": "string"
   },
   "page": {
    "minimum": 0,
    "type": "integer"
   },
   "reverse": {
    "type": "boolean"
   },
   "statuses": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "subtasks": {
    "type": "boolean"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "time_window": {
    "type": "string"
   }
  },
  "required": [
   "list_id"
  ],
  "type": "object"
 },
 "name": "clickup_get_list_tasks"
}
