{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "favorites.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Save a listing"
 },
 "description": "Save (favorite) a FlatHunt listing for the current user by its numeric id. Requires the favorites.write scope. Ownership and duplicate handling are enforced by FlatHunt.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "listingId": {
    "description": "Numeric id of the listing to save.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "listingId"
  ],
  "type": "object"
 },
 "name": "save_listing",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "listingId": {
    "type": "number"
   },
   "saved": {
    "type": "boolean"
   }
  },
  "required": [
   "saved",
   "listingId"
  ],
  "type": "object"
 },
 "title": "Save a listing"
}
