{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Update details of an existing product in Chirak, such as selling price, cost, physical stock quantity, name, category, SKU, or barcode.",
 "inputSchema": {
  "properties": {
   "barcode": {
    "description": "Updated barcode string.",
    "type": "string"
   },
   "category": {
    "description": "Updated category name.",
    "type": "string"
   },
   "costPrice": {
    "description": "Updated wholesale cost price.",
    "type": "number"
   },
   "id": {
    "description": "Product UUID (required).",
    "type": "string"
   },
   "minimumStock": {
    "description": "Updated minimum stock threshold.",
    "type": "number"
   },
   "name": {
    "description": "Updated product name.",
    "type": "string"
   },
   "sellingPrice": {
    "description": "Updated retail selling price.",
    "type": "number"
   },
   "sku": {
    "description": "Updated SKU code.",
    "type": "string"
   },
   "stockQuantity": {
    "description": "Updated stock quantity.",
    "type": "number"
   },
   "unit": {
    "description": "Updated unit type (e.g. 'Adet', 'Kg').",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_product",
 "outputSchema": {
  "properties": {
   "data": {
    "description": "Result data payload from Chirak API.",
    "type": "object"
   },
   "success": {
    "description": "Status of the tool execution.",
    "type": "boolean"
   }
  },
  "type": "object"
 }
}
