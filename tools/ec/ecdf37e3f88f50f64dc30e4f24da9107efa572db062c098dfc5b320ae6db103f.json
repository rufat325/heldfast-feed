{
 "_meta": {
  "com.oxinsider/docs-group": "large_trades",
  "securitySchemes": [
   {
    "scopes": [
     "read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get large trade counterparty executions"
 },
 "description": "Page the counterparty executions of one large trade past the first page get_large_trade embeds in counterparty_analysis. Reads the immutable snapshot that response names; a stale or changed snapshot fails with reason cursor_expired, so read get_large_trade again and restart.\n\nArgs:\n  - id (string, required): Large trade ID such as wt_123 or 123\n  - snapshot_id (string, required): counterparty_analysis.snapshot_id from get_large_trade\n  - cursor (string, optional): executions_next_cursor from get_large_trade or from the previous page\n  - limit (number, 1-100, default 100): Executions per page\n\nReturns: executions (each with its first makers page and makers_next_cursor), executions_next_cursor, execution counts, status and meta.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "executions_next_cursor from get_large_trade or from the previous page",
    "type": "string"
   },
   "id": {
    "description": "Large trade ID such as wt_123 or 123",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Max executions per page (1-100, default 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "snapshot_id": {
    "description": "counterparty_analysis.snapshot_id from get_large_trade",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "snapshot_id"
  ],
  "type": "object"
 },
 "name": "get_large_trade_counterparty_executions",
 "outputSchema": {
  "$defs": {
   "CounterpartyAnalysis": {
    "properties": {
     "analysis_id": {
      "type": "string"
     },
