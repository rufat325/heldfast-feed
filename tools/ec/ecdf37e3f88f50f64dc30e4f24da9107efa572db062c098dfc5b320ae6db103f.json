      "type": "integer"
     },
     "execution_count": {
      "type": "integer"
     },
     "executions": {
      "items": {
       "$ref": "#/$defs/CounterpartyExecution"
      },
      "type": "array"
     },
     "executions_next_cursor": {
      "type": "string"
     },
     "snapshot_id": {
      "type": "string"
     },
     "status": {
      "enum": [
       "available",
       "partial",
       "unavailable"
      ],
      "type": "string"
     },
     "unavailable_execution_count": {
      "type": "integer"
     },
     "unavailable_reason": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "execution_count",
     "available_execution_count",
     "unavailable_execution_count",
     "executions"
    ],
    "type": "object"
   },
   "CounterpartyExecution": {
    "properties": {
     "exchange_family": {
      "enum": [
       "ctf_v2",
       "neg_risk_ctf_v2"
      ],
      "type": "string"
     },
     "execution_id": {
      "type": "string"
     },
     "makers": {
      "items": {
