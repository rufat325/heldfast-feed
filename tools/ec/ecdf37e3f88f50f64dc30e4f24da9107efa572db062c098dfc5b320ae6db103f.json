      "type": "string"
     },
     "filled_usdc": {
      "type": "string"
     },
     "grade": {
      "type": "string"
     },
     "identity_status": {
      "enum": [
       "resolved",
       "infrastructure",
       "unavailable"
      ],
      "type": "string"
     },
     "last_traded_at": {
      "format": "date-time",
      "type": "string"
     },
     "maker_fill_count": {
      "type": "integer"
     },
     "match_breakdown": {
      "items": {
       "$ref": "#/$defs/CounterpartyMatchBreakdown"
      },
      "type": "array"
     },
     "profile_segment": {
      "type": "string"
     },
     "resolution_block": {
      "type": "integer"
     },
     "resolution_source": {
      "type": "string"
     },
     "resolved_user_id": {
      "type": "string"
     },
     "share_pct": {
      "type": "string"
     },
     "wallet_family": {
      "type": "string"
     }
    },
