{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Discover popular investors / traders on eToro filtered by performance, risk, and popularity.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "gainMax": {
    "description": "Maximum gain percentage",
    "maximum": 10000,
    "minimum": -100,
    "type": "number"
   },
   "gainMin": {
    "description": "Minimum gain percentage",
    "maximum": 10000,
    "minimum": -100,
    "type": "number"
   },
   "maxDailyRiskScoreMax": {
    "description": "Max daily risk score (1\u201310, lower = safer)",
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "maxMonthlyRiskScoreMax": {
    "description": "Max monthly risk score (1\u201310, lower = safer)",
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "page": {
    "description": "Page number (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Results per page (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "period": {
    "description": "Performance period to filter by",
    "enum": [
     "CurrMonth",
     "CurrQuarter",
     "CurrYear",
     "LastYear",
     "LastTwoYears",
     "OneMonthAgo",
     "TwoMonthsAgo",
     "ThreeMonthsAgo",
     "SixMonthsAgo",
     "OneYearAgo"
    ],
    "type": "string"
   },
   "popularInvestor": {
    "description": "Filter to popular investors (eligible for copy) only",
    "type": "boolean"
   }
  },
  "required": [
   "period"
  ],
  "type": "object"
 },
 "name": "etoro_discover_users",
 "title": "Discover popular investors"
}
