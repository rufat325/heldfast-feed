{
 "description": "Applicant tracking: job postings, candidates, applications, hiring stages. Full CRUD.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action",
    "enum": [
     "list_postings",
     "get_posting",
     "create_posting",
     "update_posting",
     "delete_posting",
     "list_candidates",
     "get_candidate",
     "create_candidate",
     "update_candidate",
     "delete_candidate",
     "list_applications",
     "get_application",
     "create_application",
     "update_application",
     "delete_application",
     "advance_application",
     "list_stages"
    ],
    "type": "string"
   },
   "candidate_id": {
    "description": "Candidate ID",
    "type": "number"
   },
   "confirm": {
    "description": "Confirm delete",
    "type": "boolean"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "email": {
    "description": "Email",
    "type": "string"
   },
   "first_name": {
    "description": "First name",
    "type": "string"
   },
   "hiring_stage_id": {
    "description": "Hiring stage ID",
    "type": "number"
   },
   "id": {
    "description": "Posting/candidate/application ID",
    "type": "number"
   },
   "job_posting_id": {
    "description": "Job posting ID",
    "type": "number"
   },
   "last_name": {
    "description": "Last name",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Items per page",
    "type": "number"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "number"
   },
   "phone": {
    "description": "Phone",
    "type": "string"
   },
   "status": {
    "description": "Status",
    "enum": [
     "archived",
     "draft",
     "published",
     "closed"
    ],
    "type": "string"
   },
   "title": {
    "description": "Job title",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "factorial_ats",
 "title": "FactorialHR ATS (Recruiting)"
}
