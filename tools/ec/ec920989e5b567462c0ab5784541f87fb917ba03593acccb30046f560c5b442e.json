{
 "description": "Convert a JSON string to YAML text.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "indent": {
    "description": "YAML indentation spaces (default: 2)",
    "type": "number"
   },
   "jsonText": {
    "description": "The JSON text to convert to YAML",
    "type": "string"
   }
  },
  "required": [
   "jsonText"
  ],
  "type": "object"
 },
 "name": "json_to_yaml"
}
