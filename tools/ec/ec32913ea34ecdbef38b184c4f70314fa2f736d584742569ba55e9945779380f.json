{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "A Maryland team's next few games with date, time, opponent, venue and where to watch. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 5,
    "description": "Maximum number of records to return, 1-20 (default 5)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "sport_id": {
    "description": "Sport id from athletics_list_sports, e.g. 3 for Football",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "sport_id"
  ],
  "type": "object"
 },
 "name": "athletics_get_upcoming_events",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "events": {
    "description": "Soonest first",
    "items": {
     "additionalProperties": false,
     "properties": {
      "conference_game": {
       "type": "boolean"
      },
      "date": {
       "description": "Date as YYYY-MM-DD",
       "format": "date",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
       "type": "string"
      },
      "id": {
       "description": "Game id to pass to athletics_get_game",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "location": {
       "type": [
        "string",
        "null"
       ]
      },
      "opponent": {
       "description": "Opponent as displayed, e.g. \"#2 Indiana\"",
       "type": [
        "string",
        "null"
       ]
      },
      "sport": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "id": {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          "title": {
           "type": "string"
          }
         },
         "required": [
          "id",
          "title"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "starts_at": {
       "description": "ISO 8601 UTC timestamp",
       "type": [
        "string",
        "null"
       ]
      },
      "stats_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "time": {
       "type": [
        "string",
        "null"
       ]
      },
      "tv": {
       "type": [
        "string",
        "null"
       ]
      },
      "venue": {
       "enum": [
        "home",
        "away",
        "neutral"
       ],
       "type": "string"
      },
      "video_url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "sport",
      "date",
      "time",
      "starts_at",
      "venue",
      "location",
      "opponent",
      "conference_game",
      "tv",
      "video_url",
      "stats_url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "events"
  ],
  "type": "object"
 },
 "title": "Get upcoming events"
}
