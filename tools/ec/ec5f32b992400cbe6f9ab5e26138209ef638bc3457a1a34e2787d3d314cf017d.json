{
 "description": "Generate a direct Google Flights URL for a route. Users can click to view and book flights in their browser.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adults": {
    "default": 1,
    "minimum": 1,
    "type": "integer"
   },
   "cabinClass": {
    "default": "economy",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "departureDate": {
    "description": "Departure date (YYYY-MM-DD)",
    "type": "string"
   },
   "destination": {
    "description": "Arrival airport IATA code",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "origin": {
    "description": "Departure airport IATA code",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "returnDate": {
    "description": "Return date (YYYY-MM-DD) for round-trip",
    "type": "string"
   },
   "stops": {
    "description": "Max stops (0=nonstop)",
    "maximum": 2,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "origin",
   "destination",
   "departureDate"
  ],
  "type": "object"
 },
 "name": "get_flight_url"
}
