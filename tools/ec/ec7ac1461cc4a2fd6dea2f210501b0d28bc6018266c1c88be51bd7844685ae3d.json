{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create collection"
 },
 "description": "Create a collection in the user's FinTech Studios account that tracks a topic across curated news and the open web. Types: news (any topic), stock_portfolio (tickers), regulatory (agencies/jurisdictions; needs regulatory access), prediction_markets. Before calling, confirm the name, type and what it will track with the user. After it succeeds, ask the user whether they want an insight channel for it \u2014 AI-written analysis of the collection on a schedule \u2014 and if so, how often and in which format (see list_insight_formats), then call create_insight_channel. Costs 0 credits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agencies": {
    "description": "regulatory: agencies, e.g. SEC",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "exchanges": {
    "description": "prediction_markets: e.g. kalshi, polymarket",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "focus_areas": {
    "description": "regulatory: focus areas, e.g. AML",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "jurisdictions": {
    "description": "regulatory: jurisdictions, e.g. US, EU",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "keywords": {
    "description": "Key terms or phrases to match, each as a whole phrase (e.g. 'Fed rate decision'). Leave out to match the query as one phrase; avoid single common words, which match too broadly.",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "name": {
    "description": "Collection name, usually the topic",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "description": "What to search for",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "tickers": {
    "description": "stock_portfolio: ticker symbols, e.g. AAPL",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "topics": {
    "description": "prediction_markets: market topics",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "type": {
    "default": "news",
    "enum": [
     "news",
     "stock_portfolio",
     "regulatory",
     "prediction_markets"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "query"
  ],
  "type": "object"
 },
 "name": "create_collection",
 "title": "Create collection"
}
