 "description": "Evaluate safe standardized observations from wallet policies that track prior or concurrent requests. Use `wallet_policy_conformance` instead for one-request action shape, method, chain, token, recipient, amount, and function controls. This tool separately tests sequential cumulative limits, signed-but-unbroadcast accounting, ABI extraction, concurrent oversubscription, counter-reference failure, and application serialization. It accepts no credentials, counter values, wallet or resource IDs, signatures, transactions, or raw provider responses and does not run the provider tests itself.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "network": {
    "description": "Network identifier used by the tested stateful profile.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "observations": {
    "description": "Unique standardized stateful observations. Raw provider responses, signatures, transactions, counter values, credentials, wallet IDs, and resource IDs are rejected.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "actual": {
       "description": "Observed high-level outcome.",
       "enum": [
        "allowed",
        "denied",
        "error"
       ],
       "type": "string"
      },
      "case": {
       "description": "Standardized cumulative, extraction, concurrency, reference, or application-serialization case.",
       "enum": [
        "first_within_cap",
        "sequential_exceeds_cap",
        "signed_unbroadcast_counts",
        "unrecognized_calldata",
        "concurrent_exceeds_cap",
        "missing_counter_reference",
        "application_serialized_concurrent_exceeds_cap"
       ],
       "type": "string"
      },
      "code": {
       "description": "Optional safe provider code only, never a raw message, counter value, or payload.",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$",
       "type": "string"
      },
      "enforcementClass": {
       "description": "Where enforcement occurred. Provider policy and application guards remain separate.",
       "enum": [
        "none",
        "policy",
        "application",
        "validation",
        "provider"
       ],
       "type": "string"
      }
     },
     "required": [
      "case",
      "actual",
      "enforcementClass"
     ],
     "type": "object"
    },
    "maxItems": 7,
    "minItems": 1,
    "type": "array"
   },
   "profileId": {
    "description": "Caller-defined stateful policy profile identifier with no credential, wallet, or counter secret.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "protocol": {
    "description": "Payment or execution protocol bound by the tested stateful profile.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "description": "Wallet or delegated-signer provider name.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
