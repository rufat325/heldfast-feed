{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Send a video for an estimate case"},"description":"Video action=create takes one base64 file up to 250 MiB and reuses the connection agent key (X-Agent-Key header of the MCP connection; get one free with POST https://astranl.com/api/agents/register). action=status takes intake_id and its token only. After case creation, use case_id and case_token with estimate_case_status. Video and case tokens are distinct.","inputSchema":{"additionalProperties":false,"properties":{"action":{"enum":["create","status"],"type":"string"},"contact_email":{"maxLength":254,"type":"string"},"file":{"additionalProperties":false,"properties":{"data_base64":{"maxLength":349525336,"minLength":4,"type":"string"},"name":{"pattern":"^[A-Za-z0-9][A-Za-z0-9_. -]{0,119}$","type":"string"}},"required":["name","data_base64"],"type":"object"},"house_number":{"type":["string","integer"]},"intake_id":{"pattern":"^VID-[0-9]{8}-[0-9a-f]{10}$","type":"string"},"language":{"default":"nl","enum":["en","nl","uk","pl","de","fr","es","tr","ar","ro","it"],"type":"string"},"postcode":{"maxLength":20,"type":"string"},"requester_kind":{"default":"agent","enum":["agent"],"type":"string"},"speech_language":{"pattern":"^[A-Za-z]{2}$","type":"string"},"text":{"maxLength":5000,"type":"string"},"token":{"maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9_-]+$","type":"string"}},"required":["action"],"type":"object"},"name":"estimate_case_video"}
