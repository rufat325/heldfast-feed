    "description": "OData $select",
    "type": "string"
   },
   "skip": {
    "default": 0,
    "description": "$skip",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "top": {
    "default": 100,
    "description": "$top",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
