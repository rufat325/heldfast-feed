{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update the base price for a listing on specific dates or the default base price.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "basePrice": {
    "description": "New default base price per night",
    "type": "number"
   },
   "dateFrom": {
    "description": "Start date for date-specific pricing (YYYY-MM-DD)",
    "type": "string"
   },
   "dateTo": {
    "description": "End date for date-specific pricing (YYYY-MM-DD)",
    "type": "string"
   },
   "listingId": {
    "description": "The listing ID to update pricing for",
    "type": "string"
   },
   "price": {
    "description": "Price per night for the date range",
    "type": "number"
   }
  },
  "required": [
