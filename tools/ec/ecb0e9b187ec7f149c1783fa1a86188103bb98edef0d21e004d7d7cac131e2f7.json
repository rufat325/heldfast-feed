{
 "annotations": {
  "idempotentHint": true
 },
 "description": "Register one or more resources (files, URLs, APIs, commands) with metadata for tracking. The system stores retrieval methods - actual fetching is performed by you. Register immediately after fetching - don't wait for user prompting.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "resources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "default": "[auto-migrated] Needs description",
       "description": "Description of what this resource contains. Agents should always provide meaningful descriptions to enable search and avoid duplicates.",
       "minLength": 1,
       "type": "string"
      },
      "overflowBehavior": {
       "additionalProperties": false,
       "description": "How to handle snapshots that exceed size limits. If not provided and snapshot exceeds limit, a resubmission prompt will be returned.",
       "properties": {
        "behavior": {
         "enum": [
          "truncate",
          "remove_noise",
          "html_to_md",
          "ignore"
         ],
         "type": "string"
        },
        "noisePatterns": {
         "description": "Regex patterns to remove when behavior is 'remove_noise'. Each pattern is applied globally.",
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "behavior"
       ],
       "type": "object"
      },
      "retrievalMethod": {
       "additionalProperties": false,
       "properties": {
        "command": {
         "type": "string"
        },
        "headers": {
         "additionalProperties": {
          "type": "string"
         },
         "type": "object"
        },
        "type": {
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      },
      "snapshot": {
       "type": "string"
      },
      "tags": {
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "type": "array"
      },
      "type": {
       "enum": [
        "file",
        "url",
        "api",
        "command"
       ],
       "type": "string"
      },
      "uri": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "uri",
      "type",
      "tags"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "resources"
  ],
  "type": "object"
 },
 "name": "add_resources",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "created": {
    "type": "number"
   },
   "overflowPrompts": {
    "description": "Resources that exceeded size limits and need resubmission with overflow handling",
    "items": {
     "additionalProperties": false,
     "properties": {
      "currentSizeKb": {
       "description": "Current snapshot size in KB",
       "type": "number"
      },
      "maxSizeKb": {
       "description": "Configured maximum size in KB",
       "type": "number"
      },
      "message": {
       "description": "Instruction for the agent on how to resubmit",
       "type": "string"
      },
      "suggestedActions": {
       "description": "Available overflow behaviors the agent can choose",
       "items": {
        "additionalProperties": false,
        "properties": {
         "behavior": {
          "enum": [
           "truncate",
           "remove_noise",
           "html_to_md",
           "ignore"
          ],
          "type": "string"
         },
         "description": {
          "type": "string"
         }
        },
        "required": [
         "behavior",
         "description"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "uri": {
       "description": "URI of the resource that exceeded size limit",
       "type": "string"
      }
     },
     "required": [
      "uri",
      "currentSizeKb",
      "maxSizeKb",
      "message",
      "suggestedActions"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "resources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "hasSnapshot": {
       "type": "boolean"
      },
      "id": {
       "type": "number"
      },
      "uri": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "uri",
      "hasSnapshot"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "created",
   "resources"
  ],
  "type": "object"
 },
 "title": "Add Resources"
}
