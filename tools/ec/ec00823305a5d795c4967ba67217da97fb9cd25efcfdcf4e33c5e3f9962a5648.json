    "items": {
     "properties": {
      "channel": {
       "type": "string"
      },
      "description": {
       "maxLength": 50,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "channel",
      "description"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "description": {
    "maxLength": 140,
    "type": "string"
   },
   "enabled": {
    "type": "boolean"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "update_welcome_screen",
 "title": "Update welcome screen"
}
