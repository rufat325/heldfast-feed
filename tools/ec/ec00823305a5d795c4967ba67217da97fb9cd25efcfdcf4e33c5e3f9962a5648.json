{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Edit the Community welcome screen: the description and up to five channel cards.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
