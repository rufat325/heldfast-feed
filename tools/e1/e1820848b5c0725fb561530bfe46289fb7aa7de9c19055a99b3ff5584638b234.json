{
 "description": "Convenience wrapper over compute for a natal chart: casts the chart for a single birth moment + place (planets, houses, aspects, dignities, lots).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "moment": {
    "description": "The birth moment + place.",
    "properties": {
     "datetimeLocal": {
      "description": "Local civil datetime, ISO without offset, e.g. \"1990-05-21T14:30:00\".",
      "type": "string"
     },
     "houseSystem": {
      "description": "Single-letter house system code, default \"P\".",
      "type": "string"
     },
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "timezone": {
      "description": "IANA zone, e.g. \"America/New_York\".",
      "type": "string"
     }
    },
    "required": [
     "datetimeLocal",
     "latitude",
     "longitude"
    ],
    "type": "object"
   },
   "relocation": {
    "properties": {
     "datetimeLocal": {
      "type": "string"
     },
     "houseSystem": {
      "type": "string"
     },
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "timezone": {
      "type": "string"
     }
    },
    "required": [
     "latitude",
     "longitude"
    ],
    "type": "object"
   }
  },
  "required": [
   "moment"
  ],
  "type": "object"
 },
 "name": "natal",
 "title": "Natal chart (convenience)"
}
