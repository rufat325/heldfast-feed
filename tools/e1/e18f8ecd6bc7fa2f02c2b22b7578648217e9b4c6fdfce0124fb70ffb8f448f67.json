{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Adds a new session to the agenda of an event the person organizes: `title`, `start`, `end`, `room`, optionally `date` and `speakers`. Quiet unless `notify` is true. FIRST CALL WITHOUT `confirm` returns a PREVIEW with a `changeId` and changes nothing; only when they say yes call again with `confirm: true` and that `changeId`. Only the organizer of the event can change it; anybody else is refused, read out as given. It requires a personal connector token.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "changeId": {
    "description": "The changeId the preview returned.",
    "maxLength": 64,
    "type": "string"
   },
   "confirm": {
    "description": "Leave out for the preview; after the organizer says yes, true with the changeId.",
    "type": "boolean"
   },
   "date": {
    "description": "Optional day, YYYY-MM-DD.",
    "maxLength": 10,
    "type": "string"
   },
   "end": {
    "description": "The end, same forms.",
    "maxLength": 40,
    "type": "string"
   },
   "eventIdOrName": {
    "description": "The event id or name as the organizer spells it.",
    "type": "string"
   },
   "notify": {
    "description": "Optional; true notifies pass holders.",
    "type": "boolean"
   },
   "room": {
    "description": "The room or place label, plain words.",
    "maxLength": 120,
    "type": "string"
   },
   "speakers": {
    "description": "Optional speaker names.",
    "items": {
     "maxLength": 80,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "start": {
    "description": "Start, \"4:30 PM\" or a timestamp, in the event's time zone.",
    "maxLength": 40,
    "type": "string"
   },
   "title": {
    "description": "The new session's title.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "eventIdOrName"
  ],
  "type": "object"
 },
 "name": "event_session_add",
 "outputSchema": {
  "additionalProperties": true,
  "anyOf": [
   {
    "required": [
     "ok",
     "applied",
     "changeId"
    ]
   },
   {
    "properties": {
     "ok": {
      "const": false
     }
    },
    "required": [
     "ok"
    ]
   },
   {
    "properties": {
     "found": {
      "const": false
     }
    },
    "required": [
     "found"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "applied": {
    "type": "boolean"
   },
   "candidates": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "changeId": {
    "type": "string"
   },
   "changes": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "lockScreen": {
    "type": [
     "string",
     "null"
    ]
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "passUpdate": {
    "type": "object"
   },
   "preview": {
    "type": "boolean"
   },
   "servedBy": {
    "type": "string"
   },
   "session": {
    "type": [
     "object",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "title": "Add a session (organizers only)"
}
