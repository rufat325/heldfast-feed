{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks what the IMF projects for a country, such as \"what does the IMF forecast for India's growth next year?\". Pass the country and the indicator (growth, inflation or debt). Returns the IMF's figures for the current year and the next two, with the unit, the World Economic Outlook edition and the date it was published. It reports the IMF's projections only and does not make its own forecasts.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "A country name or ISO code, such as \"Vietnam\", \"VN\" or \"VNM\"",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "indicator": {
    "description": "growth (real GDP, annual percent change), inflation (average consumer prices, annual percent change) or debt (general government gross debt, percent of GDP)",
    "enum": [
     "growth",
     "inflation",
     "debt"
    ],
    "type": "string"
   }
  },
  "required": [
   "country",
   "indicator"
  ],
  "type": "object"
 },
 "name": "get_imf_forecast",
 "outputSchema": {
  "properties": {
   "as_of": {
    "type": "string"
   },
   "country": {
    "properties": {
     "iso3": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "iso3",
     "name"
    ],
    "type": "object"
   },
   "edition": {
    "type": [
     "string",
     "null"
    ]
   },
   "forecasts": {
    "items": {
     "properties": {
      "value": {
       "type": "number"
      },
      "year": {
       "type": "string"
      }
     },
     "required": [
      "year",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "indicator": {
    "properties": {
     "key": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "unit": {
      "type": "string"
     }
    },
    "required": [
     "key",
     "label",
     "unit"
    ],
    "type": "object"
   },
   "message": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "no_data",
     "unavailable"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "country",
   "indicator",
   "edition",
   "forecasts",
   "source",
   "as_of",
   "notice"
  ],
  "type": "object"
 },
 "title": "Get an IMF forecast"
}
