{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "MIGRATION (admin): create an issue with a custom author and creation date. Use only when migrating from another tracker.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignee": {
    "type": [
     "string",
     "number"
    ]
   },
   "createdAt": {
    "description": "YYYY-MM-DDThh:mm:ss.sss\u00b1hhmm, not in the future",
    "type": "string"
   },
   "createdBy": {
    "description": "Author login or id",
    "type": [
     "string",
     "number"
    ]
   },
   "deadline": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "end": {
    "type": "string"
   },
   "estimation": {
    "description": "Milliseconds",
    "type": "number"
   },
   "followers": {
    "items": {
     "type": [
      "string",
      "number"
     ]
    },
    "type": "array"
   },
   "key": {
    "description": "Custom issue key",
    "type": "string"
   },
   "originalEstimation": {
    "description": "Milliseconds",
    "type": "number"
   },
   "priority": {
    "description": "Priority id",
    "type": "number"
   },
   "queue": {
    "type": "string"
   },
   "resolution": {
    "description": "Resolution id (with resolvedAt/By)",
    "type": "number"
   },
   "resolvedAt": {
    "type": "string"
   },
   "resolvedBy": {
    "type": [
     "string",
     "number"
    ]
   },
   "spent": {
    "description": "Milliseconds",
    "type": "number"
   },
   "start": {
    "type": "string"
   },
   "status": {
    "description": "Status id",
    "type": "number"
   },
   "storyPoints": {
    "type": "number"
   },
   "summary": {
    "maxLength": 255,
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Issue type id",
    "type": "number"
   },
   "unique": {
    "type": "string"
   },
   "updatedAt": {
    "type": "string"
   },
   "updatedBy": {
    "type": [
     "string",
     "number"
    ]
   }
  },
  "required": [
   "queue",
   "summary",
   "createdAt",
   "createdBy"
  ],
  "type": "object"
 },
 "name": "import_issue"
}
