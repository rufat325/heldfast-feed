         "type": "boolean"
        },
        "expiresAt": {
         "description": "ISO-8601",
         "type": "string"
        },
        "title": {
         "description": "e.g. \"30% off for 3 months\"",
         "type": "string"
        }
       },
       "required": [
        "title",
        "claimUrl",
        "exclusive",
        "expiresAt"
