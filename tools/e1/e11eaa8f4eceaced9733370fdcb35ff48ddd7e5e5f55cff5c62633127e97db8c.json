     "llm-apis",
     "vector-db",
     "rag",
     "chatbots",
     "image-generation",
     "video-generation",
     "code-generation",
     "workflow-orchestration",
     "observability",
     "no-code",
     "customer-support",
     "crm",
     "scheduling",
     "testing",
     "devops"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
