  "properties": {
   "limit": {
    "description": "Max results, 1-50, default 20",
    "type": "number"
   },
   "query": {
    "description": "Optional text matched against name and tagline",
    "type": "string"
   },
   "tag": {
    "description": "Optional curated tag slug",
    "enum": [
     "ai-agents",
     "developer-tools",
     "mcp-server",
     "data",
     "automation",
     "productivity",
     "cloud",
     "security",
