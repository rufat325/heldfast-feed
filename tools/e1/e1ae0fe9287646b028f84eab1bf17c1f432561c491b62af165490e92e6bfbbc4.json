{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update reviewed intensity, explicit strategy text, and project technique selections. This never edits the workspace technique catalog or silently rewrites row text.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "qualityId": {
    "$ref": "#/properties/testLevelId"
   },
   "reviewed": {
    "const": true,
    "description": "Set to true only after explicit user approval of these exact strategy changes.",
    "type": "boolean"
   },
   "techniqueStrategy": {
    "additionalProperties": false,
    "properties": {
     "intensity1": {
      "items": {
       "$ref": "#/properties/testLevelId"
      },
      "maxItems": 10000,
      "type": "array"
     },
     "intensity2": {
      "items": {
       "$ref": "#/properties/testLevelId"
      },
      "maxItems": 10000,
      "type": "array"
     },
     "intensity3": {
      "items": {
       "$ref": "#/properties/testLevelId"
      },
      "maxItems": 10000,
      "type": "array"
     }
    },
    "required": [
     "intensity1",
     "intensity2",
     "intensity3"
    ],
    "type": "object"
   },
   "testLevelId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "updates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "intensity": {
       "maximum": 3,
       "minimum": 0,
       "type": "integer"
      },
      "pbsQualityItemId": {
       "$ref": "#/properties/testLevelId"
      },
      "testStrategy": {
       "anyOf": [
        {
         "maxLength": 255,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "pbsQualityItemId"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "reviewed"
  ],
  "type": "object"
 },
 "name": "submit_test_strategy_updates",
 "title": "Submit reviewed Test Strategy updates"
}
