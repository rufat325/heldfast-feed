 "description": "Thermal check: Tj = Ta + P\u00b7\u03b8JA, and max dissipable power for a Tj limit.\n\nArgs: ambient_c, power_w, theta_ja (\u00b0C/W from datasheet), tj_max_c (default 150).\nReturns (structured): { tj_c, p_max_w, margin_c, ok }.\nExample: Ta=25, P=2W, \u03b8JA=50 -> Tj=125\u00b0C, Pmax=2.5W @ Tj_max 150.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ambient_c": {
    "description": "Ambient temperature in \u00b0C",
    "type": "number"
   },
   "power_w": {
    "description": "Dissipated power in W",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "theta_ja": {
    "description": "Junction-to-ambient thermal resistance \u00b0C/W",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "tj_max_c": {
    "default": 150,
    "description": "Maximum junction temperature rating in \u00b0C",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "ambient_c",
   "power_w",
   "theta_ja"
  ],
  "type": "object"
 },
 "name": "embedcalc_junction_temp",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "margin_c": {
    "description": "tj_max - tj (negative = over limit)",
    "type": "number"
   },
   "ok": {
    "type": "boolean"
   },
   "p_max_w": {
    "type": "number"
   },
   "tj_c": {
    "type": "number"
   }
  },
  "required": [
   "tj_c",
   "p_max_w",
   "margin_c",
   "ok"
  ],
  "type": "object"
 },
 "title": "Junction Temperature / Max Power"
}
