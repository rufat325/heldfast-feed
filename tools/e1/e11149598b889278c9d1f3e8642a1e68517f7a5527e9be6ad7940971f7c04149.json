{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Diagnose sanitized MCP initialize, discovery, transport, capability and tool-schema failures. Returns bounded free checks and never performs a repair or payment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "context": {
    "maxLength": 2048,
    "type": "string"
   },
   "error_code": {
    "maxLength": 64,
    "type": "string"
   },
   "error_message": {
    "maxLength": 4096,
    "minLength": 3,
    "type": "string"
   },
   "protocol_version": {
    "maxLength": 64,
    "type": "string"
   },
   "transport": {
    "enum": [
     "streamable-http",
     "sse",
     "stdio"
    ],
    "type": "string"
   }
  },
  "required": [
   "error_message"
  ],
  "type": "object"
 },
 "name": "diagnose_mcp_failure",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "collision_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "confidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "confidence_label": {
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "diagnosis": {
    "type": "string"
   },
   "evidence_hash": {
    "type": "string"
   },
   "failure_class": {
    "type": "string"
   },
   "free_checks": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "policy": {
    "additionalProperties": false,
    "properties": {
     "automatic_checkout": {
      "type": "boolean"
     },
     "automatic_execution": {
      "type": "boolean"
     },
     "automatic_payment": {
      "type": "boolean"
     },
     "automatic_quote": {
      "type": "boolean"
     },
     "free_diagnosis": {
      "type": "boolean"
     },
     "raw_input_stored": {
      "type": "boolean"
     }
    },
    "required": [
     "free_diagnosis",
     "automatic_quote",
     "automatic_checkout",
     "automatic_payment",
     "automatic_execution",
     "raw_input_stored"
    ],
    "type": "object"
   },
   "quote_endpoint": {
    "type": [
     "string",
     "null"
    ]
   },
   "repair_available": {
    "type": "boolean"
   },
   "repair_scope": {
    "type": [
     "string",
     "null"
    ]
   },
   "secrets_redacted": {
    "type": "boolean"
   },
   "trace_id": {
    "type": "string"
   }
  },
  "required": [
   "diagnosis",
   "failure_class",
   "confidence",
   "confidence_label",
   "free_checks",
   "repair_available",
   "repair_scope",
   "quote_endpoint",
   "collision_id",
   "evidence_hash",
   "secrets_redacted",
   "trace_id",
   "policy"
  ],
  "type": "object"
 },
 "title": "Diagnose MCP Failure"
}
