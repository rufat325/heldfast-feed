{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Unarchive note"
 },
 "description": "Restore a note from the archive back to the active list.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "noteId": {
    "description": "The note ID to unarchive.",
    "type": "string"
   }
  },
  "required": [
   "noteId"
  ],
  "type": "object"
 },
 "name": "unarchive_note",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "note": {
    "additionalProperties": false,
    "description": "The affected note, with contentPreview rather than the full body. Call get_note to read it back.",
    "properties": {
     "archivedAt": {
      "description": "Set only while the note is archived.",
      "type": [
       "string",
       "null"
      ]
     },
     "contentPreview": {
      "description": "Markdown flattened to one line and clipped to ~200 chars. Call get_note for the full body.",
      "type": "string"
     },
     "createdAt": {
      "type": "string"
     },
     "deletedAt": {
      "description": "Set only while the note is in trash.",
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "type": "string"
     },
     "isPinned": {
      "type": "boolean"
     },
     "tags": {
      "description": "Present on detail, create and update responses. Omitted when empty.",
      "items": {},
      "type": "array"
     },
     "title": {
      "type": [
       "string",
       "null"
      ]
     },
     "updatedAt": {
      "type": "string"
     },
     "wordCount": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 }
}
