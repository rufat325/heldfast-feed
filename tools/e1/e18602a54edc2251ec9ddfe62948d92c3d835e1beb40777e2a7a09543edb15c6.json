{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Write one planned run, or a week of them, onto days still ahead. Each lands on the runner's week as a plan they can see, edit and remove. Needs a token made with the write scope and ourpr create. Never logs a run.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "plans": {
    "description": "One run, or up to fourteen.",
    "items": {
     "properties": {
      "date": {
       "description": "YYYY-MM-DD, after today.",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "is_long": {
       "description": "The week's long run.",
       "type": "boolean"
      },
      "miles": {
       "description": "Planned distance.",
       "maximum": 200,
       "minimum": 0.1,
       "type": "number"
      },
      "minutes": {
       "description": "Planned time.",
       "maximum": 1440,
       "minimum": 1,
       "type": "number"
      },
      "name": {
       "description": "A short name for the run.",
       "maxLength": 120,
       "type": "string"
      },
      "note": {
       "description": "A line the runner will read.",
       "maxLength": 500,
       "type": "string"
      },
      "tag": {
       "description": "How hard: easy, workout or race.",
       "enum": [
        "easy",
        "workout",
        "race"
       ],
       "type": "string"
      }
     },
     "required": [
      "date"
     ],
     "type": "object"
    },
    "maxItems": 14,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "plans"
  ],
  "type": "object"
 },
 "name": "ourpr_plan_week",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "written": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "written"
  ],
  "type": "object"
 },
 "title": "Put runs on the runner's week"
}
