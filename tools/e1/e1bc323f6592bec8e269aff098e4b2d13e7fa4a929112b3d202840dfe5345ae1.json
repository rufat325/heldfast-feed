{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"Render and print Markdown or HTML. Supply content (32 KiB max) or assetUrl (1 MiB max). Reuse the same arguments and idempotencyKey for retries.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"assetUrl":{"description":"Direct public or signed HTTPS URL containing UTF-8 Markdown or HTML. Provide assetUrl or content, never both.","maxLength":8192,"minLength":1,"type":"string"},"content":{"description":"Inline Markdown or HTML source, up to 32 KiB. Provide content or assetUrl, never both.","maxLength":32768,"minLength":1,"type":"string"},"format":{"enum":["markdown","html"],"type":"string"},"idempotencyKey":{"maxLength":128,"minLength":1,"type":"string"},"printerId":{"maxLength":256,"minLength":1,"type":"string"},"settings":{"additionalProperties":false,"properties":{"colorMode":{"enum":["color","monochrome"],"type":"string"},"copies":{"maximum":100,"minimum":1,"type":"integer"},"fitToPage":{"type":"boolean"},"orientation":{"enum":["portrait","landscape"],"type":"string"},"pageRanges":{"maxLength":500,"pattern":"^[1-9]\\d*(?:-[1-9]\\d*)?(?:,[1-9]\\d*(?:-[1-9]\\d*)?)*$","type":"string"},"paperSize":{"maxLength":100,"pattern":"^[a-zA-Z0-9][a-zA-Z0-9_.-]*$","type":"string"},"sides":{"enum":["one-sided","two-sided-long-edge","two-sided-short-edge"],"type":"string"}},"type":"object"}},"required":["printerId","format","idempotencyKey"],"type":"object"},"name":"printMarkup"}
