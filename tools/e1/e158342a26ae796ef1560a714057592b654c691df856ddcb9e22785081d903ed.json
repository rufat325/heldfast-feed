{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Register a webhook for model registry events",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "Description of the webhook's purpose",
    "type": "string"
   },
   "events": {
    "description": "Event types this webhook should fire on",
    "items": {
     "enum": [
      "REGISTERED_MODEL_CREATED",
      "MODEL_VERSION_CREATED",
      "MODEL_VERSION_TRANSITIONED_STAGE",
      "MODEL_VERSION_TRANSITIONED_TO_STAGING",
      "MODEL_VERSION_TRANSITIONED_TO_PRODUCTION",
      "MODEL_VERSION_TRANSITIONED_TO_ARCHIVED",
      "MODEL_VERSION_TAG_SET",
      "MODEL_VERSION_TAG_DELETED",
      "MODEL_VERSION_ALIAS_CREATED",
      "MODEL_VERSION_ALIAS_DELETED",
      "REGISTERED_MODEL_TAG_SET",
      "REGISTERED_MODEL_TAG_DELETED"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "modelName": {
    "description": "Restrict to events for a specific registered model name",
    "type": "string"
   },
   "name": {
    "description": "Human-readable webhook name",
    "type": "string"
   },
   "secret": {
    "description": "HMAC signing secret for payload verification",
    "type": "string"
   },
   "status": {
    "default": "ACTIVE",
    "description": "Initial webhook status",
    "enum": [
     "ACTIVE",
     "DISABLED"
    ],
    "type": "string"
   },
   "url": {
    "description": "HTTPS endpoint to call when events occur",
    "type": "string"
   }
  },
  "required": [
   "name",
   "events",
   "url"
  ],
  "type": "object"
 },
 "name": "create-webhook"
}
