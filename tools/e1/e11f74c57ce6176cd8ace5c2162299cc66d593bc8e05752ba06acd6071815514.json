{
 "description": "Create a new appointment in the CRM. Supports slot validation overrides.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "address": {
    "description": "Appointment address / location",
    "type": "string"
   },
   "appointmentStatus": {
    "description": "Status (e.g. confirmed, cancelled, showed, noshow, invalid)",
    "type": "string"
   },
   "assignedUserId": {
    "description": "User ID to assign the appointment to",
    "type": "string"
   },
   "calendarId": {
    "description": "Calendar ID to book the appointment in",
    "type": "string"
   },
   "contactId": {
    "description": "Contact ID for the appointment",
    "type": "string"
   },
   "endTime": {
    "description": "Appointment end time (ISO string)",
    "type": "string"
   },
   "ignoreDateRange": {
    "description": "Ignore calendar date-range restrictions",
    "type": "boolean"
   },
   "ignoreFreeSlotValidation": {
    "description": "Skip free-slot validation checks",
    "type": "boolean"
   },
   "locationId": {
    "description": "CRM location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "notes": {
    "description": "Appointment notes",
    "type": "string"
   },
   "selectedSlot": {
    "description": "Selected slot identifier",
    "type": "string"
   },
   "selectedTimezone": {
    "description": "IANA timezone (e.g. America/New_York)",
    "type": "string"
   },
   "startTime": {
    "description": "Appointment start time (ISO string)",
    "type": "string"
   },
   "title": {
    "description": "Appointment title",
    "type": "string"
   },
   "toNotify": {
    "description": "Send notification to the contact",
    "type": "boolean"
   },
   "tz": {
    "description": "Short timezone identifier",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "calendarId",
   "locationId",
   "contactId",
   "startTime",
   "endTime"
  ],
  "type": "object"
 },
 "name": "crm_create_appointment"
}
