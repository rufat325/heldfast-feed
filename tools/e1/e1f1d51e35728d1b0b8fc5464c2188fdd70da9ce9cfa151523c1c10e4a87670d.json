{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update budget"
 },
 "description": "Update an existing budget by ID. Requires budgets:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "allocated_amount": {
    "description": "Allocated amount",
    "minimum": 0,
    "type": "number"
   },
   "budgeted_amount": {
    "description": "Budgeted amount",
    "minimum": 0,
    "type": "number"
   },
   "building_id": {
    "description": "Building ID. Not read by the Budget tab.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "funding_source": {
    "description": "'O&M' or 'Capital'",
    "enum": [
     "O&M",
     "Capital"
    ],
    "type": "string"
   },
   "id": {
    "description": "Budget ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "module": {
    "anyOf": [
     {
      "enum": [
       "facilities",
       "infrastructure"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Workspace; null for organization-wide"
   },
   "site_id": {
    "description": "Site ID. Not read by the Budget tab.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "year": {
    "description": "Budget year",
    "maximum": 2100,
    "minimum": 2000,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_budget",
 "title": "Update budget"
}
