{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Change anything on a bill of sale that is not finalized yet: price, buyer, seller, item details, identifiers, the as-is clause, warranty or notes. Pass an empty string to clear an optional field. A finalized document cannot be edited.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"as_is":{"type":"boolean"},"buyer_address":{"maxLength":4000,"type":"string"},"buyer_email":{"maxLength":200,"type":"string"},"buyer_name":{"description":"Who is buying","maxLength":200,"type":"string"},"buyer_phone":{"maxLength":200,"type":"string"},"condition":{"maxLength":200,"type":"string"},"currency":{"pattern":"^[A-Za-z]{3}$","type":"string"},"date":{"description":"The date of the sale, YYYY-MM-DD","maxLength":10,"type":"string"},"identifier_other":{"maxLength":200,"type":"string"},"imei":{"maxLength":20,"type":"string"},"item_category":{"maxLength":200,"type":"string"},"item_description":{"maxLength":4000,"type":"string"},"notes":{"maxLength":4000,"type":"string"},"price_minor":{"description":"The sale price in whole minor units (integer cents)","maximum":999999999999,"minimum":0,"type":"integer"},"quantity":{"maximum":100000,"minimum":1,"type":"integer"},"sale":{"description":"The bill of sale id, e.g. BOS-2026-0001","maxLength":200,"type":"string"},"seller_address":{"maxLength":4000,"type":"string"},"seller_email":{"maxLength":200,"type":"string"},"seller_name":{"description":"Who is selling","maxLength":200,"type":"string"},"seller_phone":{"maxLength":200,"type":"string"},"serial":{"maxLength":200,"type":"string"},"vin":{"maxLength":40,"type":"string"},"warranty":{"maxLength":4000,"type":"string"}},"required":["sale"],"type":"object"},"name":"sale_update","title":"Change a bill of sale before signing"}
