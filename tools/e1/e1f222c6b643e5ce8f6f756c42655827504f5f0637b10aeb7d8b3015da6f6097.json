{
 "description": "View or modify npm user profile settings",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "get",
     "set"
    ],
    "type": "string"
   },
   "field": {
    "description": "Profile field to get or set (e.g. email, fullname, homepage)",
    "type": "string"
   },
   "otp": {
    "description": "One-time password for 2FA",
    "type": "string"
   },
   "value": {
    "description": "Value to set (required for set action)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "profile"
}
