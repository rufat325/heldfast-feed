{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Return bounded metadata for one procedure identified by symbol or address: entrypoint, signature, locals, size, and block count. Follow with decompilation or assembly for behavior.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "procedure": "main"
   }
  ],
  "properties": {
   "document": {
    "description": "The document name",
    "type": "string"
   },
   "procedure": {
    "description": "The procedure name or address",
    "type": "string"
   },
   "unknown_registry_approved": {
    "const": true,
    "description": "Explicit approval to record typed capability unavailability as a residual unknown",
    "type": "boolean"
   }
  },
  "required": [
   "procedure"
  ],
  "type": "object"
 },
 "name": "procedure_info",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "basicblock_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "classification": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "external": {
          "type": "boolean"
         },
         "provenance": {
          "minLength": 1,
          "type": "string"
         },
         "thunk": {
          "type": "boolean"
         },
         "thunk_target": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "external",
         "thunk",
         "thunk_target",
         "provenance"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "entrypoint": {
      "type": "string"
     },
     "length": {
      "minimum": 0,
      "type": "number"
     },
     "locals": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "description": {
         "type": "string"
        },
        "provenance": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "description",
        "provenance"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     },
     "signature": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "name",
     "entrypoint",
     "basicblock_count",
     "length",
     "signature",
     "locals",
     "classification"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Procedure Info"
}
