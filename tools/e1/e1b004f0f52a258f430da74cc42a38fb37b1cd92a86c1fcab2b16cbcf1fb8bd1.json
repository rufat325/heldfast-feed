{"annotations":{"openWorldHint":true,"readOnlyHint":false},"description":"Pushes commits to a remote repository. Returns structured data with success status, remote, branch, summary, and whether the remote branch was newly created.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"atomic":{"description":"Atomic push (--atomic)","type":"boolean"},"branch":{"description":"Branch to push (default: current branch)","maxLength":255,"type":"string"},"delete":{"description":"Delete remote branch/tag (--delete)","type":"boolean"},"dryRun":{"description":"Preview push without executing (--dry-run)","type":"boolean"},"followTags":{"description":"Push annotated tags with commits (--follow-tags)","type":"boolean"},"force":{"default":false,"description":"Force push (--force)","type":"boolean"},"forceWithLease":{"description":"Safe force push (--force-with-lease)","type":"boolean"},"noVerify":{"description":"Bypass pre-push hook (--no-verify)","type":"boolean"},"path":{"description":"Repository path. Authoritative \u2014 when omitted, the server uses its own process working directory (its launch dir, not the caller's cwd). Callers in a git worktree or other directory MUST pass this explicitly to avoid operating on the wrong repo.","maxLength":4096,"type":"string"},"pushOption":{"description":"Push options (-o/--push-option), e.g. 'ci.skip'","items":{"maxLength":255,"type":"string"},"maxItems":1000,"type":"array"},"refspec":{"description":"Explicit refspec (e.g. 'HEAD:refs/heads/branch')","maxLength":255,"type":"string"},"remote":{"default":"origin","description":"Remote name (default: \"origin\")","maxLength":255,"type":"string"},"setUpstream":{"default":false,"description":"Set upstream tracking (-u)","type":"boolean"},"tags":{"description":"Push all tags (--tags)","type":"boolean"}},"type":"object"},"name":"push","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"created":{"type":"boolean"},"errorType":{"enum":["rejected","no-upstream","permission-denied","repository-not-found","hook-declined","unknown"],"type":"string"},"hint":{"type":"string"},"objectStats":{"additionalProperties":false,"properties":{"bytes":{"type":"number"},"delta":{"type":"number"},"packReused":{"type":"number"},"reused":{"type":"number"},"total":{"type":"number"}},"type":"object"},"rejectedRef":{"type":"string"},"success":{"type":"boolean"},"summary":{"type":"string"}},"required":["success","summary"],"type":"object"},"title":"Git Push"}
