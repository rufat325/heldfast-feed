{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Record a proposed change order. This does not change scope, rates, or deadlines. kind add_work requires workTitle and workDescription. kind discount_rate requires rateCode and a lower amountMinor. kind add_rate requires rateCode, rateLabel, amountMinor, and unit. kind move_deadline requires scopeItemId and dueOn.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amountMinor": {
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "integer"
   },
   "dueOn": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "engagementId": {
    "format": "uuid",
    "type": "string"
   },
   "kind": {
    "enum": [
     "add_work",
     "discount_rate",
     "add_rate",
     "move_deadline"
    ],
    "type": "string"
   },
   "rateCode": {
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   },
   "rateLabel": {
    "$ref": "#/properties/workTitle"
   },
   "scopeItemId": {
    "$ref": "#/properties/engagementId"
   },
   "summary": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "unit": {
    "enum": [
     "hour",
     "day",
     "fixed"
    ],
    "type": "string"
   },
   "workDescription": {
    "maxLength": 12000,
    "minLength": 1,
    "type": "string"
   },
   "workTitle": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "kind",
   "summary"
  ],
  "type": "object"
 },
 "name": "file_change_order",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "file change order"
}
