{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new verification request to ask another user to share verified assets. Each asset is an object naming its type, e.g. { \"type\": \"email\" }.\n\nACCESS: needs a Proof account. Authenticate this client (Claude Code: /mcp \u2192 Authenticate), or sign in with start_login \u2014 a session opens this tool \u2014 then call this tool again.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action_context": {
    "additionalProperties": false,
    "description": "What the recipient is shown about why the assets are needed, e.g. { \"title\": \"Confirm your contact details\" }",
    "properties": {
     "amount": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "currency": {
      "maxLength": 10,
      "minLength": 1,
      "type": "string"
     },
     "description": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
     },
     "entity": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "title": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "action_type": {
    "description": "Purpose of the request (default: verification); custom and confirmation also need an action_context title",
    "enum": [
     "verification",
     "2fa",
     "login",
     "custom",
     "confirmation",
     "authorization"
    ],
    "type": "string"
   },
   "assets": {
    "description": "Assets to request, e.g. [{ \"type\": \"email\" }, { \"type\": \"phone\", \"required\": false }]",
    "items": {
     "additionalProperties": false,
     "properties": {
      "allowed_channels": {
       "description": "Channels the recipient may choose from",
       "items": {
        "enum": [
         "whatsapp",
         "telegram",
         "sms",
         "email",
         "dns",
         "http",
         "auto",
         "github",
         "google",
         "facebook",
         "x",
         "linkedin",
         "instagram",
         "youtube",
         "tiktok",
         "ethereum",
         "solana",
         "bitcoin",
         "coinbase",
         "kraken",
         "telegram_bot_token"
        ],
        "type": "string"
       },
       "maxItems": 10,
       "type": "array"
      },
      "channel": {
       "description": "Verification channel to use for this asset",
       "enum": [
        "whatsapp",
        "telegram",
        "sms",
        "email",
        "dns",
        "http",
        "auto",
        "github",
        "google",
        "facebook",
        "x",
        "linkedin",
        "instagram",
        "youtube",
        "tiktok",
        "ethereum",
        "solana",
        "bitcoin",
        "coinbase",
        "kraken",
        "telegram_bot_token"
       ],
       "type": "string"
      },
      "identifier": {
       "description": "The exact value to verify (e.g. an email address); omit to let the recipient choose",
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "required": {
       "description": "Whether this asset must be verified (default: true)",
       "type": "boolean"
      },
      "type": {
       "description": "What to verify",
       "enum": [
        "phone",
        "email",
        "domain",
        "social",
        "wallet",
        "telegram_bot"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "callback_url": {
    "description": "HTTPS webhook URL for request status updates",
    "format": "uri",
    "maxLength": 2000,
    "pattern": "^https:\\/\\/",
    "type": "string"
   },
   "expires_in_hours": {
    "description": "Hours until request expires (default: 168, i.e. 7 days)",
    "maximum": 720,
    "minimum": 1,
    "type": "integer"
   },
   "partial_ok": {
    "description": "Whether partial asset sharing is acceptable (default: false)",
    "type": "boolean"
   },
   "public_profile_id": {
    "description": "Public profile ID for branding",
    "pattern": "^[0-9a-fA-F]{24}$",
    "type": "string"
   },
   "redirect_url": {
    "description": "HTTPS URL to redirect the subject after completing the request",
    "format": "uri",
    "maxLength": 2000,
    "pattern": "^https:\\/\\/",
    "type": "string"
   },
   "reference_id": {
    "description": "External reference ID for tracking",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "validity_requirement": {
    "description": "How recently an existing proof must have been verified for the recipient to reuse it: a number and a unit, h hours, d days, w weeks or m months (30 days), e.g. \"24h\", \"7d\", \"1m\"",
    "pattern": "^\\d+[hdwm]$",
    "type": "string"
   }
  },
  "required": [
   "assets"
  ],
  "type": "object"
 },
 "name": "create_user_request"
}
