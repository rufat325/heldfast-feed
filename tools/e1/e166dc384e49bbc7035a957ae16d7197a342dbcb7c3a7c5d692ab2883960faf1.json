{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true,
  "title": "Wait for Batch Job"
 },
 "description": "Poll batch_status until the job reaches a terminal state (completed, stopped, or deleted).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "job_id": {
    "description": "Batch job id",
    "type": "string"
   },
   "timeout_ms": {
    "anyOf": [
     {
      "maximum": 3600000,
      "minimum": 1000,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Max wait time in ms (default 600000)"
   }
  },
  "required": [
   "job_id"
  ],
  "type": "object"
 },
 "name": "batch_wait"
}
