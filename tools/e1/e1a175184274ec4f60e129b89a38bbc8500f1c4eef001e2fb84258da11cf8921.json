{
 "description": "Convert sheet metal gauge to thickness (mm) or thickness to gauge, and compute sheet weight for steel, stainless, aluminum or galvanized steel.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gauge": {
    "description": "gauge mode: gauge number, e.g. 16",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "length_mm": {
    "default": 2000,
    "minimum": 0,
    "type": "number"
   },
   "material": {
    "default": "steel",
    "enum": [
     "steel",
     "stainless",
     "aluminum",
     "galvanized"
    ],
    "type": "string"
   },
   "mode": {
    "default": "gauge",
    "description": "gauge: from gauge number; mm: from thickness",
    "enum": [
     "gauge",
     "mm"
    ],
    "type": "string"
   },
   "qty": {
    "default": 1,
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "thickness_mm": {
    "description": "mm mode: thickness in mm",
    "minimum": 0,
    "type": "number"
   },
   "width_mm": {
    "default": 1000,
    "minimum": 0,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "sheet_metal_gauge"
}
