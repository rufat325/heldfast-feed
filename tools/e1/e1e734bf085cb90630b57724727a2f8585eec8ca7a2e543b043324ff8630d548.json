        "required-next",
        "recommended-next",
        "optional-followup",
        "alternative"
       ],
       "type": "string"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "data": {},
