 "description": "Schedule a service ticket to a member for a time window. Times are ISO-8601 (e.g. 2026-07-06T13:00:00Z). Creates a schedule entry on the dispatch board.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "member": {
    "description": "Member identifier to schedule the ticket to",
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "description": "Output format: human-readable markdown (default) or structured JSON",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "ticket_id": {
    "description": "The service ticket to schedule",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "time_end": {
    "description": "End time, ISO-8601",
    "type": "string"
   },
   "time_start": {
    "description": "Start time, ISO-8601",
    "type": "string"
   }
  },
  "required": [
   "ticket_id",
   "member",
   "time_start",
   "time_end"
  ],
  "type": "object"
 },
 "name": "cw_schedule_ticket",
 "title": "Schedule a ConnectWise Ticket"
}
