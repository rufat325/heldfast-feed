{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Get booking link"
 },
 "description": "Get the Viator booking page URL for one experience. This is an affiliate link; it does not book or charge. Present the disclosure to the user. Offers are limited to reviewed physical tours and admissions. Editorial destinations do not guarantee app inventory. Digital-only and unreviewed products are unavailable.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "currency": {
    "default": "EUR",
    "description": "Display currency for prices.",
    "enum": [
     "EUR",
     "USD",
     "GBP"
    ],
    "type": "string"
   },
   "experienceId": {
    "description": "Reviewed physical-experience id from search_experiences. Unreviewed ids are rejected.",
    "pattern": "^[A-Za-z0-9_-]{1,80}$",
    "type": "string"
   }
  },
  "required": [
   "experienceId"
  ],
  "type": "object"
 },
 "name": "get_booking_link",
 "outputSchema": {
  "anyOf": [
   {
    "properties": {
     "affiliate": {
      "const": true,
      "type": "boolean"
     },
     "disclosure": {
      "type": "string"
     },
     "experienceId": {
      "description": "Viator product code, for example 5010SYDNEY.",
      "examples": [
       "5010SYDNEY"
      ],
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "type": "string"
     },
     "url": {
      "description": "Viator affiliate product page. Booking and payment happen on Viator.",
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "url",
     "experienceId",
     "affiliate",
     "disclosure"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "availableTools": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "code": {
      "type": "string"
     },
     "docs": {
      "format": "uri",
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "retryAfterSeconds": {
      "type": "integer"
     },
     "status": {
      "type": "integer"
     }
    },
    "required": [
     "code",
     "message",
     "status"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Get booking link"
}
