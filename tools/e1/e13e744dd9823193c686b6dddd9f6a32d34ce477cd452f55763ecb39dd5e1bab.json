  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List the team, location and commitment wordings one company uses on Lever, so a filter can carry the words that company publishes. The vocabulary belongs to each company: one writes Full-time, another Full Time, another EE Full-Time. Lever publishes no vocabulary for department, so a department filter is checked against the openings a company has open right now.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "company_slug": {
    "description": "The Lever site name, as resolve_company returns it.",
    "minLength": 1,
    "type": "string"
   },
   "fields": {
    "description": "Which vocabularies to read. Each costs one request. All three by default.",
    "items": {
     "enum": [
      "team",
      "location",
      "commitment"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "instance": {
    "description": "The Lever instance this site lives on. Left out, the global one is read.",
    "enum": [
     "global",
     "eu"
    ],
    "type": "string"
   }
  },
  "required": [
   "company_slug"
  ],
  "type": "object"
 },
 "name": "list_filter_values",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "company_slug": {
    "type": "string"
   },
   "fields": {
    "additionalProperties": false,
    "properties": {
     "commitment": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "count": {
         "anyOf": [
          {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          {
           "type": "null"
          }
         ],
         "description": "Null when Lever published no openings alongside the category."
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "value",
        "count"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "location": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "count": {
         "anyOf": [
          {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          {
           "type": "null"
          }
         ],
         "description": "Null when Lever published no openings alongside the category."
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "value",
        "count"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "team": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "count": {
         "anyOf": [
          {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          {
           "type": "null"
          }
         ],
         "description": "Null when Lever published no openings alongside the category."
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "value",
        "count"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "instance": {
    "enum": [
     "global",
     "eu"
    ],
    "type": "string"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "company_slug",
