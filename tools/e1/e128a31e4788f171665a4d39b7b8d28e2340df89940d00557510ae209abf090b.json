{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Resolve one architecture component to a safe embedded SVG using bundled assets first and online Iconify-compatible assets when enabled.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "allowOnline": {
    "default": false,
    "type": "boolean"
   },
   "category": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "resolve_asset",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "asset": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "type": "string"
     },
     "embedded": {
      "type": "boolean"
     },
     "id": {
      "type": "string"
     },
     "integrity": {
      "type": "string"
     },
     "license": {
      "type": "string"
     },
     "mediaType": {
      "type": "string"
     },
     "provider": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "sourceUrl": {
      "type": "string"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "category",
     "provider",
     "tags",
     "mediaType",
     "license",
     "source",
     "integrity",
     "embedded"
    ],
    "type": "object"
   }
  },
  "required": [
   "asset"
  ],
  "type": "object"
 },
 "title": "Resolve Architecture SVG"
}
