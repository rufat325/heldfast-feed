{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new Tempo plan (resource allocation) for a user or generic resource against an issue or project. Asks the user to confirm first: a confirmation prompt where the client supports one; otherwise the first call returns a preview and a confirmToken, and only a repeat call with that token proceeds (see MCP_CONFIRM_MODE).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assigneeId": {
    "description": "Atlassian account id (for USER) or generic resource id (for GENERIC)",
    "type": "string"
   },
   "assigneeType": {
    "description": "Type of assignee",
    "enum": [
     "USER",
     "GENERIC"
    ],
    "type": "string"
   },
   "confirmToken": {
    "description": "ONLY for the two-step confirmation fallback (a client without MCP elicitation). The confirmToken from this same tool's phase-1 \"confirmation-required\" response, passed back ONLY after the user has seen that preview and explicitly approved it in chat \u2014 never on the first call, never invented, never reused. Call again with the same arguments. Ignored when the client supports elicitation.",
    "type": "string"
   },
   "description": {
    "description": "Plan description",
    "type": "string"
   },
   "effortPersistenceType": {
    "description": "How effort is distributed",
    "enum": [
     "SECONDS_PER_DAY",
     "TOTAL_SECONDS"
    ],
    "type": "string"
   },
   "endDate": {
    "description": "Plan end date (YYYY-MM-DD)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "includeNonWorkingDays": {
    "description": "Include non-working days in plan",
    "type": "boolean"
   },
   "planItemId": {
    "description": "Id of the issue or project to plan against",
    "type": "string"
   },
   "planItemType": {
    "description": "Type of plan item",
    "enum": [
     "ISSUE",
     "PROJECT"
    ],
    "type": "string"
   },
   "plannedSeconds": {
    "description": "Total seconds planned (for TOTAL_SECONDS persistence type)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "plannedSecondsPerDay": {
    "description": "Seconds planned per day (for SECONDS_PER_DAY persistence type)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "recurrenceEndDate": {
    "description": "End date for recurrence (YYYY-MM-DD)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "rule": {
    "description": "Recurrence rule",
    "enum": [
     "NEVER",
     "WEEKLY",
     "BI_WEEKLY",
     "MONTHLY"
    ],
    "type": "string"
   },
   "startDate": {
    "description": "Plan start date (YYYY-MM-DD)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "startTime": {
    "description": "Start time (HH:mm)",
    "pattern": "^([0-1]?[0-9]|2[0-3])(:[0-5][0-9])$",
    "type": "string"
   }
  },
  "required": [
   "assigneeId",
   "assigneeType",
   "planItemId",
   "planItemType",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "tempo_create_plan"
}
