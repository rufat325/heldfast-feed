{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search OiAir public activities using its current search API, ranking and filters. Age is inclusive; weekdays use Sunday=0 through Saturday=6, and any selected day may match. Age, day and time must match the same published group. Keep unresolved constraints and unknown availability; results do not confirm a place.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "filters": {
    "additionalProperties": false,
    "properties": {
     "after17": {
      "type": "boolean"
     },
     "age": {
      "anyOf": [
       {
        "maximum": 18,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "bounds": {
      "anyOf": [
       {
        "items": false,
        "maxItems": 4,
        "minItems": 4,
        "prefixItems": [
         {
          "type": "number"
         },
         {
          "type": "number"
         },
         {
          "type": "number"
         },
         {
          "type": "number"
         }
        ],
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "categories": {
      "items": {
       "enum": [
        "danca",
        "esportes",
        "artes",
        "musica",
        "ciencia",
        "linguas",
        "natureza",
        "projetos"
       ],
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "city": {
      "maxLength": 120,
      "type": "string"
     },
     "days": {
      "items": {
       "maximum": 6,
       "minimum": 0,
       "type": "integer"
      },
      "maxItems": 7,
      "type": "array"
     },
     "neighborhood": {
      "maxLength": 120,
      "type": "string"
     },
     "period": {
      "enum": [
       "",
       "manha",
       "tarde",
       "noite"
      ],
      "type": "string"
     },
     "price": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "amount": {
          "minimum": 0,
          "type": "number"
         },
         "currency": {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
         },
         "operator": {
          "enum": [
           "lte",
           "gte",
           "eq"
          ],
          "type": "string"
         },
         "unit": {
          "maxLength": 60,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "operator",
         "amount",
         "currency",
         "unit"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "enum": [
     "pt-BR",
     "pt-PT",
     "en",
     "ru",
     "es"
    ],
    "type": "string"
   },
   "query": {
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_activities",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "appliedFilters": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "bookingSemantics": {
    "additionalProperties": false,
    "properties": {
     "availability": {
      "const": "unknown",
      "type": "string"
     },
     "bookingMode": {
      "const": "request_confirmation",
      "type": "string"
     },
     "createsRequest": {
      "const": false,
      "type": "boolean"
     },
     "requiresOrganizationConfirmation": {
      "const": true,
      "type": "boolean"
     },
     "reservesSeat": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "availability",
     "bookingMode",
     "createsRequest",
     "reservesSeat",
     "requiresOrganizationConfirmation"
    ],
    "type": "object"
   },
   "items": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "id": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "organization": {
       "type": "string"
      },
      "publishedOffers": {
       "items": {
        "additionalProperties": {},
        "properties": {
         "checkedAt": {
          "type": "string"
         },
         "offeringId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
         },
         "publicationId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
         },
         "source": {
          "const": "organization_confirmation",
          "type": "string"
         },
         "validUntil": {
          "type": "string"
         },
         "version": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         }
        },
        "required": [
         "publicationId",
         "version",
         "offeringId",
         "source",
         "checkedAt",
         "validUntil"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "organization",
      "publishedOffers"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextCursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "queryStatus": {
    "type": "string"
   }
  },
  "required": [
   "items",
   "appliedFilters",
   "queryStatus",
   "nextCursor",
   "bookingSemantics"
  ],
  "type": "object"
 }
}
