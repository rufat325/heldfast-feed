{"_meta":{"securitySchemes":[{"type":"noauth"},{"scopes":["deploy"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Publishes a new static site or version. New: every file, or a template. Update: site and base_revision with every file, or patch: true with changed files and deleted paths.","inputSchema":{"properties":{"base_revision":{"description":"Update: the live revision id last read","type":"string"},"confirm_token":{"type":"string"},"deleted":{"description":"patch: paths to remove","items":{"type":"string"},"type":"array"},"files":{"items":{"properties":{"content":{"type":"string"},"encoding":{"description":"utf8 (default), or base64 for binaries","enum":["utf8","base64"],"type":"string"},"path":{"description":"e.g. img/a.png","type":"string"}},"required":["path","content"],"type":"object"},"type":"array"},"idempotency_key":{"description":"New sites: a UUID (retries replay)","minLength":16,"type":"string"},"patch":{"description":"true: only the changed files","type":"boolean"},"preview":{"description":"true: save a private preview, not live","type":"boolean"},"site":{"type":"string"},"site_token":{"description":"From an anonymous deploy (secret)","type":"string"},"staging":{"type":"boolean"},"template":{"description":"Template, e.g. \"brasa\" (files sent replace its paths)","type":"string"},"workspace":{"description":"New sites: workspace id or name, or \"private\"","type":"string"}},"type":"object"},"name":"deploy","outputSchema":{"properties":{"agent_message":{"type":"string"},"claim_url":{"type":"string"},"revision":{"properties":{"id":{"type":"string"},"number":{"type":"number"}},"type":"object"},"site":{"properties":{"name":{"type":"string"},"url":{"type":"string"}},"type":"object"},"site_token":{"type":"string"}},"type":"object"},"securitySchemes":[{"type":"noauth"},{"scopes":["deploy"],"type":"oauth2"}],"title":"Publish site"}
