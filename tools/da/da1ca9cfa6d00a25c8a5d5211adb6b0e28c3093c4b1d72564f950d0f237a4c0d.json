{
 "description": "Download multiple TikTok URLs at once. Requires a Business API key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "format": {
    "description": "Requested output format",
    "enum": [
     "mp4",
     "mp3",
     "photos_zip",
     "without_watermark"
    ],
    "type": "string"
   },
   "urls": {
    "description": "Public TikTok URLs",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "urls",
   "format"
  ],
  "type": "object"
 },
 "name": "tiktok_batch"
}
