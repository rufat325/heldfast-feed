{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "First call against an unfamiliar database, and the way to find where a name lives. With no query it inventories what exists and how big it is in production -- row estimates and table size (the heap: indexes and TOAST are not counted), partition children folded into their parent -- which the repo cannot tell you; kind= inventories views, functions or enums instead. With a query it searches names, table and column comments, index and view definitions, and enum labels, so a value like 'cancelled' finds the enum that carries it, not just an object named after it. Every hit is tagged with the field it matched (matched_on) and exact name matches rank first. Needs no database connection. Case-insensitive substring only -- no regex, no fuzzy matching, and never row data. Function bodies are not in the snapshot, so a name that appears only inside one is not findable here. One line per object: describe_table is what reads a table in full.",
 "inputSchema": {
  "properties": {
   "kind": {
    "description": "Restrict to one kind. Default: tables when there is no query, every kind when there is one.",
    "enum": [
     "table",
     "column",
     "index",
     "view",
     "materialized_view",
     "function",
     "enum"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max results (default 50, 0 for all). Truncation sets _meta.next to re-run uncapped.",
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Skip N results.",
    "type": "number"
   },
   "query": {
    "description": "Case-insensitive substring. Omit to inventory rather than search.",
    "type": "string"
   },
   "schema": {
    "description": "Schema filter; omit for all schemas.",
    "type": "string"
   },
   "sort": {
    "description": "Order: 'name', or 'rows'/'size' biggest first (objects that have no table sort last). Default is name without a query, match quality with one.",
    "enum": [
     "name",
     "rows",
     "size"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
