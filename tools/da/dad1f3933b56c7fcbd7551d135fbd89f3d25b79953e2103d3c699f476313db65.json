{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Changes name, visibility, opacity, blend mode, mask enablement or transform (origin, size, rotation, flips) of a layer. Only the given fields change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "description": "Make it the selected layer in Compositor",
    "type": "boolean"
   },
   "blendMode": {
    "enum": [
     "Normal",
     "Darken",
     "Multiply",
     "Color Burn",
     "Linear Burn",
     "Lighten",
     "Screen",
     "Color Dodge",
     "Linear Dodge (Add)",
     "Overlay",
     "Soft Light",
     "Hard Light",
     "Vivid Light",
     "Linear Light",
     "Pin Light",
     "Hard Mix",
     "Difference",
     "Exclusion",
     "Subtract",
     "Divide",
     "Hue",
     "Saturation",
     "Color",
     "Luminosity"
    ],
    "type": "string"
   },
   "flipX": {
    "type": "boolean"
   },
   "flipY": {
    "type": "boolean"
   },
   "layer": {
    "description": "Layer UUID or its exact name",
    "type": "string"
   },
   "maskEnabled": {
    "type": "boolean"
   },
   "name": {
    "type": "string"
   },
   "opacity": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "origin": {
    "additionalItems": false,
    "description": "Top-left in canvas pixels",
    "items": [
     {
      "type": "number"
     },
     {
      "type": "number"
     }
    ],
    "maxItems": 2,
    "minItems": 2,
    "type": "array"
   },
   "path": {
    "description": "Path to the .comp project package (a directory ending in .comp)",
    "type": "string"
   },
   "rotation": {
    "description": "Clockwise degrees",
    "type": "number"
   },
   "sampling": {
    "enum": [
     "Nearest",
     "Smooth",
     "High quality"
    ],
    "type": "string"
   },
   "size": {
    "additionalItems": false,
    "description": "Display size in canvas pixels; source pixels are untouched",
    "items": [
     {
      "type": "number"
     },
     {
      "type": "number"
     }
    ],
    "maxItems": 2,
    "minItems": 2,
    "type": "array"
   },
   "visible": {
    "type": "boolean"
   }
  },
  "required": [
   "path",
   "layer"
  ],
  "type": "object"
 },
 "name": "set_layer",
 "title": "Set layer properties"
}
