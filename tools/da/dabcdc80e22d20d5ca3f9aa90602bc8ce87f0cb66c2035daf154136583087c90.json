 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "holidays": {
    "description": "YYYY-MM-DD dates to exclude",
    "items": {
     "type": "string"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "to": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "weekdays": {
    "description": "sun/mon/tue/wed/thu/fri/sat, default mon-fri",
    "items": {
     "type": "string"
    },
    "type": [
     "null",
     "array"
    ]
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "datemath_businessdays",
 "outputSchema": {
  "type": "integer"
 }
}
