{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Economic data and calendar"
 },
 "description": "Released economic data (CPI, payrolls, PMIs, central-bank decisions and more) with actual vs forecast vs previous, the surprise direction and the measured market reaction in the minutes after the release; plus the scheduled releases ahead. Defaults to high-impact releases. Use for 'what did CPI come in at and how did markets react' or 'what data is out this week'.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "Two-letter country code, e.g. US, GB, EU, JP.",
    "type": "string"
   },
   "days_ahead": {
    "description": "Upcoming window in days (0-14, default 3; 0 skips it).",
    "type": "integer"
   },
   "hours": {
    "description": "Released-data look-back in hours (1-336, default 48).",
    "type": "integer"
   },
   "impact": {
    "description": "high (default) or all.",
    "enum": [
     "high",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max rows per list (1-50, default 20).",
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "economic_data",
 "outputSchema": {
  "properties": {
   "days_ahead": {
    "type": "integer"
   },
   "released": {
    "items": {
     "properties": {
      "actual": {
       "type": "string"
      },
      "country_code": {
       "type": "string"
      },
      "forecast": {
       "type": "string"
      },
      "impact": {
       "type": "string"
      },
      "market_reaction": {
       "properties": {
        "measured_from": {
         "type": "string"
        },
        "movers": {
         "items": {
          "properties": {
           "direction": {
            "type": [
             "string",
             "null"
            ]
           },
           "label": {
            "type": [
             "string",
             "null"
            ]
           },
           "move_pct": {
            "type": [
             "number",
             "null"
            ]
           },
           "symbol": {
            "type": [
             "string",
             "null"
            ]
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        "released_alongside_other_prints": {
         "type": "integer"
        },
        "window_minutes": {
         "type": [
          "integer",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "previous": {
       "type": "string"
      },
      "released_utc": {
       "type": "string"
      },
      "surprise": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "released_window_hours": {
    "type": "integer"
   },
   "upcoming": {
    "items": {
     "properties": {
      "country_code": {
       "type": "string"
      },
      "forecast": {
       "type": "string"
      },
      "impact": {
       "type": "string"
      },
      "previous": {
       "type": "string"
      },
      "scheduled_utc": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "released",
   "upcoming"
  ],
  "type": "object"
 },
 "title": "Economic data and calendar"
}
