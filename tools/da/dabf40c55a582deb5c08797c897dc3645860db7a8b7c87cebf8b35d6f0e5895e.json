{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Pre-release assessment: CI status, open bugs, CHANGELOG, release checklist, rollback template.\n\nRequired token scopes:\n  - repo, or public_repo for public-only repos (checks, issues, and file contents access)\n\nArgs:\n  - owner, repo: Repository coordinates.\n  - baseRef (string?): Deprecated compatibility field; ignored.\n  - headRef (string?): Branch, tag, or commit SHA to release (defaults to default branch).\n  - pullNumber (number?): Uses the PR head commit for CI status.\n\nReturns: isReady flag, blocking issues, CI status, docs check, release checklist, rollback template.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "baseRef": {
    "description": "Deprecated compatibility field; currently ignored.",
    "type": "string"
   },
   "headRef": {
    "description": "Branch, tag, or commit SHA to release. Defaults to default branch.",
    "type": "string"
   },
   "owner": {
    "description": "GitHub owner. Falls back to GITHUB_OWNER.",
    "type": "string"
   },
   "pullNumber": {
    "description": "If provided, checks the PR's head commit CI status.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "repo": {
    "description": "GitHub repo. Falls back to GITHUB_REPO.",
    "type": "string"
   },
   "rollbackPlanEvidence": {
    "description": "Caller-provided rollback runbook/reference and whether it was tested.",
    "properties": {
     "reference": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
     },
     "tested": {
      "type": "boolean"
     }
    },
    "required": [
     "reference",
     "tested"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "release_readiness_check",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appliedPolicyRules": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "source": {
       "const": "repository",
       "type": "string"
      }
     },
     "required": [
      "id",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "blockingIssues": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "bugEvidenceIncomplete": {
    "type": "boolean"
   },
   "ciEvidenceIncomplete": {
    "type": "boolean"
   },
   "ciStatus": {
    "enum": [
     "passing",
     "failing",
     "pending",
     "unknown"
    ],
    "type": "string"
   },
   "ciSummary": {
    "type": "string"
   },
   "hasChangelog": {
    "type": "boolean"
   },
   "headRef": {
    "type": "string"
   },
   "headShaResolved": {
    "type": "boolean"
   },
   "isReady": {
    "type": "boolean"
   },
   "openBugCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "policy": {
    "additionalProperties": false,
    "properties": {
     "defaultWorkType": {
      "enum": [
       "docs",
       "feature",
       "bugfix",
       "refactor",
       "security",
       "release",
       "infra"
      ],
      "type": "string"
     },
     "degraded": {
      "type": "boolean"
     },
     "found": {
      "type": "boolean"
     },
     "protectedPaths": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "releaseBlockingLabels": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "requireChangelog": {
      "type": "boolean"
     },
     "requireCodeOwnersForProtectedPaths": {
      "type": "boolean"
     },
     "requireIssueLink": {
      "type": "boolean"
     },
     "requireRollbackPlan": {
      "type": "boolean"
     },
     "requiredChecks": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "appId": {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        "name": {
         "type": "string"
        },
        "source": {
         "const": "check_run",
         "type": "string"
        }
       },
       "required": [
        "name",
        "source",
        "appId"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "requiredReviewerRuleIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "riskRuleIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "schemaVersion": {
      "const": 1,
      "type": "number"
     }
    },
    "required": [
     "found",
     "degraded",
     "schemaVersion",
     "requiredChecks",
     "protectedPaths",
     "riskRuleIds",
     "requiredReviewerRuleIds",
     "releaseBlockingLabels",
     "requireIssueLink",
     "requireCodeOwnersForProtectedPaths",
     "requireChangelog",
     "requireRollbackPlan"
    ],
    "type": "object"
   },
   "policyDegraded": {
    "type": "boolean"
   },
   "policyDigest": {
    "type": "string"
   },
   "policySources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "blobSha": {
       "type": [
        "string",
        "null"
       ]
      },
      "digest": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "default",
        "repository"
       ],
       "type": "string"
      },
      "path": {
       "type": [
        "string",
        "null"
       ]
      },
      "ref": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "kind",
      "path",
      "ref",
      "blobSha",
      "digest"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "repo": {
    "type": "string"
   },
   "rollbackPlanEvidence": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "reference": {
        "type": "string"
       },
       "source": {
        "const": "caller",
        "type": "string"
       },
       "tested": {
        "type": "boolean"
       }
      },
      "required": [
       "reference",
       "tested",
       "source"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "trustBoundary": {
    "additionalProperties": false,
    "properties": {
     "callerAndRepositoryContent": {
      "const": "untrusted",
      "type": "string"
     },
     "instructionHandling": {
      "const": "never_execute",
      "type": "string"
     },
     "permissionHandling": {
      "const": "never_expand",
      "type": "string"
     },
     "secretHandling": {
      "const": "never_reveal",
      "type": "string"
     }
    },
    "required": [
     "callerAndRepositoryContent",
     "instructionHandling",
     "secretHandling",
     "permissionHandling"
    ],
    "type": "object"
   }
  },
  "required": [
   "repo",
   "headRef",
   "isReady",
   "ciStatus",
   "ciSummary",
   "openBugCount",
   "blockingIssues",
   "hasChangelog",
   "rollbackPlanEvidence",
   "policy",
   "policyDigest",
   "policySources",
   "appliedPolicyRules",
   "policyDegraded"
  ],
  "type": "object"
 },
 "title": "Release Readiness Check"
}
