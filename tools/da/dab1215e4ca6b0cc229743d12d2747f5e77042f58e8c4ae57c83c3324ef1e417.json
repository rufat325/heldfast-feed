{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Change a saved address"},"description":"Changes the fields given on one saved address (from list_addresses); the rest stay. If an order or quote was made with it, the change is saved as a new address with a new id (the result's address.id) and the orders and quotes keep the old one. Australian state codes and four-digit postcodes only. Needs a signed-in Printdash account: called without one, the connection asks the customer to sign in on printdash.io.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"address_id":{"description":"An address id from list_addresses.","maxLength":64,"type":"string"},"address_line1":{"description":"Street address.","maxLength":120,"type":"string"},"address_line2":{"maxLength":120,"type":"string"},"city":{"description":"Suburb or town.","maxLength":60,"type":"string"},"company_name":{"maxLength":120,"type":"string"},"first_name":{"maxLength":60,"type":"string"},"last_name":{"maxLength":60,"type":"string"},"mobile":{"maxLength":20,"type":"string"},"postal_code":{"description":"Four-digit Australian postcode.","maxLength":4,"type":"string"},"state":{"description":"NSW, VIC, QLD, SA, WA, TAS, NT or ACT.","maxLength":3,"type":"string"},"type":{"enum":["home","business"],"type":"string"}},"required":["address_id"],"type":"object"},"name":"update_address","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"address":{"additionalProperties":false,"properties":{"company":{"type":["string","null"]},"country":{"type":"string"},"id":{"type":"string"},"is_default":{"type":"boolean"},"line1":{"type":"string"},"line2":{"type":["string","null"]},"mobile":{"type":["string","null"]},"name":{"type":["string","null"]},"postcode":{"type":"string"},"state":{"type":"string"},"suburb":{"type":"string"},"summary":{"type":"string"},"type":{"enum":["home","business"],"type":"string"}},"required":["id","name","company","line1","line2","suburb","state","postcode","country","mobile","type","is_default","summary"],"type":"object"},"next":{"type":"string"},"outcome":{"description":"replaced: an order or quote used the address, so the edit was saved as a new address (address.id is new) and the old one kept for those records (#669).","enum":["updated","replaced"],"type":"string"},"replaced_address_id":{"description":"The old id, when replaced. It no longer works.","type":"string"},"updated":{"items":{"type":"string"},"type":"array"}},"required":["updated","outcome","address","next"],"type":"object"},"securitySchemes":[{"scopes":["openid","email","profile","offline_access"],"type":"oauth2"}],"title":"Change a saved address"}
