{
 "description": "Compare two versions of a table by key: rows added, removed and changed (with the changed columns). Costs $0.05 USDC (x402).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "$ref": "#/properties/before"
   },
   "before": {
    "additionalProperties": false,
    "description": "A string table: at most 1000 rows x 32 columns, 65536 characters total",
    "properties": {
     "columns": {
      "description": "Column names, in order",
      "items": {
       "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
     },
     "records": {
      "description": "Rows as objects of column -> string value",
      "items": {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
     }
    },
    "required": [
     "columns",
     "records"
    ],
    "type": "object"
   },
   "keyColumns": {
    "description": "Columns that together identify a row (exact string match)",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "before",
   "after",
   "keyColumns"
  ],
  "type": "object"
 },
 "name": "reconcile"
}
