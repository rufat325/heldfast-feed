{"annotations":{"openWorldHint":true,"readOnlyHint":true},"description":"Check work on a Jira issue: does the branch cover the acceptance criteria and meet the Definition of Done? alignment and dod compare the local diff with them \u2014 run them before opening a PR. impact predicts the affected areas and works before any code is written, so use checks [\"impact\"] when planning. Each check runs independently. Returns a verdict (ready_for_pr, needs_work, insufficient_evidence; not_applicable when only impact ran) and per-criterion coverage. Fetches the issue itself.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"baseBranch":{"default":"origin/main","description":"Base branch to diff against","type":"string"},"checks":{"default":["alignment","dod","impact"],"description":"Which checks to run: alignment, dod, impact (default: all)","items":{"enum":["alignment","dod","impact"],"type":"string"},"minItems":1,"type":"array"},"compareRef":{"default":"HEAD","description":"Branch or commit to compare","type":"string"},"includeConfluence":{"default":true,"description":"Use Confluence context in the dod and impact checks","type":"boolean"},"issueKey":{"description":"Jira issue key (e.g. PROJ-123)","type":"string"},"maxDiffChars":{"default":50000,"description":"Maximum diff characters to analyse","maximum":200000,"minimum":1000,"type":"integer"},"repoPath":{"default":".","description":"Path to the git repository","type":"string"}},"required":["issueKey"],"type":"object"},"name":"delivery_check_changes","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"data":{"additionalProperties":false,"properties":{"alignment":{"additionalProperties":false,"properties":{"confidence":{"enum":["High","Medium","Low"],"type":"string"},"criteria":{"items":{"additionalProperties":false,"properties":{"files":{"items":{"type":"string"},"type":"array"},"status":{"enum":["covered","partial","miss