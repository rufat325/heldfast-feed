{
 "annotations": {
  "readOnlyHint": true,
  "title": "List DNS records"
 },
 "description": "List the records in one DNS zone, optionally filtered by type or search term. Record Type comes back as bunny.net's integer code (0=A, 1=AAAA, 2=CNAME, 3=TXT, 4=MX, 5=Redirect, 6=Flatten, 7=PullZone, 8=SRV, 9=CAA, 10=PTR, 11=Script, 12=NS, 13=SVCB, 14=HTTPS, 15=TLSA). bunny.net: GET /dnszone/{zoneId}/records.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "page": {
    "description": "Page number, 1-based. Default 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page, 5-1000. Default 1000.",
    "maximum": 1000,
    "minimum": 5,
    "type": "integer"
   },
   "search": {
    "description": "Filter results by this search term.",
    "type": "string"
   },
   "type": {
    "description": "Only records of this type.",
    "enum": [
     "A",
     "AAAA",
     "CNAME",
     "TXT",
     "MX",
     "Redirect",
     "Flatten",
     "PullZone",
     "SRV",
     "CAA",
     "PTR",
     "Script",
     "NS",
     "SVCB",
     "HTTPS",
     "TLSA"
    ],
    "type": "string"
   },
   "zone_id": {
    "description": "The DNS Zone ID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "zone_id"
  ],
  "type": "object"
 },
 "name": "bunny_list_dns_records",
 "title": "List DNS records"
}
