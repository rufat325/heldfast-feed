  "title": "utilpeek: SEC EDGAR company lookup (profile, filings, financials)"
 },
 "description": "utilpeek: Look up a company in SEC EDGAR by ticker or CIK. For financials per year or quarter use sec_financials. Returns a US SEC registrant by ticker or CIK from SEC EDGAR: name, CIK, tickers, exchanges, SIC industry, state, fiscal year end and the latest 10 filings with links; with `include_facts`, the latest annual revenue, net income, total assets (USD) and shares outstanding. Informational only, not investment advice. Data: SEC EDGAR (public domain), cached up to 1 hour; no SEC endorsement implied. Send exactly one of ticker or cik; bad input is a 422 and an unknown company a 404 company_not_found (neither charged); an upstream outage is a 503 (not charged). Typically 1-3 s (cached under 0.1 s). Price: USD 0.003. Free: 10 utilpeek calls per IP per UTC day. Docs: https://tanod.dev/learn/sec-edgar-company-filings-api.html",
 "inputSchema": {
  "properties": {
   "cik": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "maxLength": 16,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "SEC Central Index Key, 1-10 digits, as a number or a string (leading zeros and a CIK prefix allowed, such as 320193 or 0000320193). Send ticker or cik.",
    "title": "Cik"
   },
   "include_facts": {
    "default": false,
    "description": "Also return headline XBRL facts: latest annual revenue, net income and total assets (USD) and shares outstanding.",
    "title": "Include Facts",
    "type": "boolean"
   },
   "ticker": {
    "anyOf": [
     {
      "maxLength": 12,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Exchange ticker such as AAPL (class shares as BRK-B, BRK.B or BRK/B). Send ticker or cik.",
    "title": "Ticker"
   }
  },
  "title": "sec_company_lookupArguments",
  "type": "object"
 },
