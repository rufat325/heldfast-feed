{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List Answers (contract v0), paginated with an opaque cursor. Read-only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Opaque pagination cursor from a previous list_answers call's nextCursor.",
    "type": "string"
   },
   "limit": {
    "description": "Max answers to return (default: loader's choice, capped 200).",
    "exclusiveMinimum": 0,
    "maximum": 200,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_answers",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "items",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List answers"
}
