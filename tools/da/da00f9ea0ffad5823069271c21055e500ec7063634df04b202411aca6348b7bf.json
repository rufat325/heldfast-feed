{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search the organization directory for people (coworkers, etc). Requires directory.readonly scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "pageSize": {
    "default": 10,
    "description": "Maximum number of results",
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "pageToken": {
    "description": "Page token for pagination",
    "type": "string"
   },
   "query": {
    "description": "Search query - matches against names, email addresses, and phone numbers",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "directory_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "nextPageToken": {
    "type": "string"
   },
   "people": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "emailAddresses": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "type": {
          "type": "string"
         },
         "value": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "etag": {
       "type": "string"
      },
      "names": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "displayName": {
          "type": "string"
         },
         "familyName": {
          "type": "string"
         },
         "givenName": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "organizations": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "department": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "title": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "phoneNumbers": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "type": {
          "type": "string"
         },
         "value": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "photos": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "url": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "resourceName": {
       "type": "string"
      }
     },
     "required": [
      "resourceName"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalSize": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Search directory"
}
