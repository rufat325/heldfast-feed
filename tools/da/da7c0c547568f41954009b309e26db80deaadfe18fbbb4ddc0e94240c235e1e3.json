{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Read-only RSI, EMA, SMA, MACD, Bollinger bands and ATR over closed candles. Supply candles or symbol/venue (Hyperliquid). Returns latest values, effective params, candle window, source, as-of time and stale label. Prices are used as supplied; gaps and insufficient history are explicit errors. Periods 1\u2013500; max 16 indicators, 1000 supplied candles and a venue count of 5000. Defaults: RSI/ATR 14, EMA/SMA/Bollinger 20, MACD 12/26/9, Bollinger stdDev 2. Freshness is measured from the last candle close; stale after one interval.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "candles": {
    "description": "Chronological, consecutive closed OHLCV candles. t is opening Unix time in milliseconds. Empty/short arrays return INSUFFICIENT_CANDLES.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "c": {
       "type": "number"
      },
      "h": {
       "type": "number"
      },
      "l": {
       "type": "number"
      },
      "o": {
       "type": "number"
      },
      "t": {
       "minimum": 0,
       "type": "integer"
      },
      "v": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "t",
      "o",
      "h",
      "l",
      "c",
      "v"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "count": {
    "description": "Venue candle count; defaults to max(200, required warmup). Omit with explicit candles.",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "indicators": {
    "items": {
     "oneOf": [
      {
       "additionalProperties": false,
       "properties": {
        "name": {
         "enum": [
          "rsi",
          "ema",
          "sma",
          "atr"
         ],
         "type": "string"
        },
        "period": {
         "maximum": 500,
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "fastPeriod": {
         "maximum": 500,
         "minimum": 1,
         "type": "integer"
        },
        "name": {
         "enum": [
          "macd"
         ],
         "type": "string"
        },
        "signalPeriod": {
         "maximum": 500,
         "minimum": 1,
         "type": "integer"
        },
        "slowPeriod": {
         "maximum": 500,
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "name": {
         "enum": [
          "bollinger"
         ],
         "type": "string"
        },
        "period": {
         "maximum": 500,
         "minimum": 1,
         "type": "integer"
        },
        "stdDev": {
         "exclusiveMinimum": 0,
         "maximum": 10,
         "type": "number"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 16,
    "minItems": 1,
    "type": "array"
   },
   "interval": {
    "enum": [
     "1m",
     "3m",
     "5m",
     "15m",
     "30m",
     "1h",
     "2h",
     "4h",
     "8h",
     "12h",
     "1d"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Hyperliquid market identifier, e.g. ETH or xyz:XYZ. Required without candles.",
    "maxLength": 32,
    "minLength": 1,
    "type": "string"
   },
   "venue": {
    "description": "Required without candles. With candles, symbol/venue are caller-provided labels; source remains caller.",
    "enum": [
     "hyperliquid"
    ],
    "type": "string"
   }
  },
  "required": [
   "interval",
   "indicators"
  ],
  "type": "object"
 },
 "name": "ta_indicators"
}
