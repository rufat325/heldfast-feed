{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search VO registry metadata when no built-in preset fits; inspect the selected service before querying it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxrec": {
    "description": "TAP MAXREC row limit for registry results.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "query": {
    "description": "Registry search text.",
    "minLength": 1,
    "type": "string"
   },
   "registryUrl": {
    "description": "Explicit RegTAP service URL.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "starfetch_registry_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accessUrl": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "ivoid": {
       "type": "string"
      },
      "shortName": {
       "type": "string"
      },
      "standardId": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "accessUrl",
      "ivoid",
      "standardId",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnostics": {
    "additionalProperties": false,
    "properties": {
     "count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "registryUrl": {
      "type": "string"
     }
    },
    "required": [
     "count",
     "registryUrl"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "diagnostics"
  ],
  "type": "object"
 },
 "title": "Search TAP registry"
}
