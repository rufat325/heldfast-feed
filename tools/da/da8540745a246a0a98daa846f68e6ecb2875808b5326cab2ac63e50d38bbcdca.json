{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search active users assignable to issues by name, username, or email where the configured provider exposes those fields. Return every match and ask the user to choose when ambiguous.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "all": {
    "description": "Search all configured providers only when explicitly true",
    "type": "boolean"
   },
   "cwd": {
    "description": "Git working directory; defaults to the server process cwd",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "provider": {
    "description": "Explicit configured provider alias",
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_users",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "result": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "providerAlias": {
       "type": "string"
      },
      "truncated": {
       "type": "boolean"
      },
      "users": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "active": {
          "type": "boolean"
         },
         "assignee": {
          "type": "string"
         },
         "displayName": {
          "type": "string"
         },
         "email": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "provider": {
          "enum": [
           "linear",
           "github",
           "jira-cloud"
          ],
          "type": "string"
         },
         "username": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "provider",
         "assignee",
         "displayName",
         "username",
         "email",
         "active"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "providerAlias",
      "users",
      "truncated"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Search assignable users"
}
