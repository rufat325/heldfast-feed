{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"Get a bounded property research packet with exact identity matching, source-backed facts, explicit calculations, conflicts, unknowns and follow-up questions. Compact and full projections retain identical claims, references and required notices. Optional coordinate context is a separate point observation, never an inferred parcel match. Preserve every qualification. Unavailable or ambiguous research is free; useful partial evidence counts as one answer. The result includes an 'attributions' array (upstream source lines and the NWMLS/DOR/county non-affiliation line) and a professional-advice disclaimer \u2014 pass both through to end users.","inputSchema":{"$defs":{"ResearchLocalQuery":{"additionalProperties":false,"anyOf":[{"properties":{"zip_code":{"type":"string"}},"required":["zip_code"]},{"properties":{"county":{"type":"string"}},"required":["county"]},{"properties":{"school_district":{"type":"string"}},"required":["school_district"]},{"properties":{"school_code":{"type":"string"}},"required":["school_code"]},{"properties":{"business_ubi":{"type":"string"}},"required":["business_ubi"]},{"properties":{"latitude":{"type":"number"},"longitude":{"type":"number"}},"required":["latitude","longitude"]}],"dependentRequired":{"latitude":["longitude"],"longitude":["latitude"],"parcel_number":["county"]},"properties":{"business_ubi":{"anyOf":[{"pattern":"^[0-9]{9}$","type":"string"},{"type":"null"}],"default":null,"description":"Exact Washington Unified Business Identifier for official registry handoff","title":"Business Ubi"},"county":{"anyOf":[{"maxLength":40,"minLength":2,"pattern":"^[A-Za-z ]+$","type":"string"},{"type":"null"}],"default":null,"title":"County"},"latitude":{"anyOf":[{"maximum":49.01,"minimum":45.5,"type":"number"},{"type":"null"}],"default":null,"title":"Latitude"},"limit":{"default":5,"maximum":5,"minimum":1,"title":"Limit","type":"integer"},"longitude":{"anyOf":[{"maximum":-116.8