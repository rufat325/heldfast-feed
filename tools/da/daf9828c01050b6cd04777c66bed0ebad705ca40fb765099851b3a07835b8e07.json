    "minimum": 1,
    "type": "integer"
   },
   "items": {
    "items": {
     "properties": {
      "duration": {
       "maximum": 1440,
       "minimum": 1,
       "type": "integer"
      },
      "name": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "value": {
       "maximum": 10000,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "name",
      "duration",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 32,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "budget",
   "items"
  ],
  "type": "object"
 },
 "name": "optimize_tasks"
}
