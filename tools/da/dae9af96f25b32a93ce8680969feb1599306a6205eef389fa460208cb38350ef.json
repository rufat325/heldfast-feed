{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read an agent's active brain snapshot (its versioned memory and identity files). Without a path: lists all files. With a path: returns that file's content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_id": {
    "description": "Agent id (agent_...).",
    "type": "string"
   },
   "path": {
    "description": "Brain file path (e.g. \"AGENTS.md\", \"memory/MEMORY.md\"). Omit to list files.",
    "type": "string"
   }
  },
  "required": [
   "agent_id"
  ],
  "type": "object"
 },
 "name": "skopik_brain_read",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brain_snapshot": {
    "additionalProperties": {},
    "description": "Snapshot metadata (when listing).",
    "properties": {},
    "type": "object"
   },
   "file": {
    "additionalProperties": {},
    "description": "File content (when a path was given).",
    "properties": {
     "content": {
      "type": [
       "string",
       "null"
      ]
     },
     "path": {
      "type": "string"
     }
    },
    "required": [
     "path"
    ],
    "type": "object"
   },
   "files": {
    "description": "File entries (when listing).",
    "items": {
     "additionalProperties": {},
     "properties": {
      "path": {
       "type": "string"
      },
      "size_bytes": {
       "type": [
        "number",
        "null"
       ]
      },
      "updated_at": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Read agent brain"
}
