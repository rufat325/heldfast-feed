{
 "description": "List subscribers for a private podcast. Returns a paginated list.",
 "inputSchema": {
  "properties": {
   "page": {
    "description": "Page number for pagination",
    "minimum": 1,
    "type": "number"
   },
   "per": {
    "description": "Items per page (default 10)",
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search query to filter subscribers",
    "type": "string"
   },
   "show_id": {
    "description": "ID of the private podcast",
    "type": "string"
   }
  },
  "required": [
   "show_id"
  ],
  "type": "object"
 },
 "name": "list_subscribers"
}
