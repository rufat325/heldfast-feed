{
 "description": "Click an element by its UID from snapshot",
 "inputSchema": {
  "properties": {
   "button": {
    "default": "left",
    "enum": [
     "left",
     "right",
     "middle"
    ],
    "type": "string"
   },
   "clickCount": {
    "default": 1,
    "description": "1 for single click, 2 for double",
    "type": "number"
   },
   "modifiers": {
    "description": "Modifier keys to hold",
    "items": {
     "enum": [
      "Alt",
      "Control",
      "Meta",
      "Shift"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "pageId": {
    "description": "Page ID (uses active page if not specified)",
    "type": "string"
   },
   "uid": {
    "description": "Element UID from snapshot",
    "type": "string"
   }
  },
  "required": [
   "uid"
  ],
  "type": "object"
 },
 "name": "click"
}
