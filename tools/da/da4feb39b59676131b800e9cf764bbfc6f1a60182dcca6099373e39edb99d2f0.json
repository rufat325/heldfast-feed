{
 "annotations": {
  "readOnlyHint": true,
  "title": "List listings"
 },
 "description": "List the account's properties (listings) with name, address, capacity, base price, fees and check-in times. Filter by name, city, country, property type, availability for a date range and guest count, or active/archived status. Hostaway: GET /v1/listings.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "availabilityDateEnd": {
    "description": "Only listings available until (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "availabilityDateStart": {
    "description": "Only listings available from (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "availabilityGuestNumber": {
    "description": "Only listings that fit this many guests.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "city": {
    "description": "City.",
    "type": "string"
   },
   "country": {
    "description": "Country.",
    "type": "string"
   },
   "includeResources": {
    "description": "Include attached sub-resources (sent as includeResources=1).",
    "type": "boolean"
   },
   "limit": {
    "description": "Maximum records to return (1-500).",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "match": {
    "description": "Search by listing name.",
    "type": "string"
   },
   "offset": {
    "description": "Records to skip from the start.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "propertyTypeId": {
    "description": "Property type id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "sortOrder": {
    "description": "Sort order.",
    "enum": [
     "name",
     "nameReversed",
     "order",
     "orderReversed",
     "contactName",
     "contactNameReversed",
     "latestActivity",
     "latestActivityDesc"
    ],
    "type": "string"
   },
   "specialStatus": {
    "description": "Filter by status; omit for both active and archived.",
    "items": {
     "enum": [
      "active",
      "archived"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "hostaway_list_listings",
 "title": "List listings"
}
