{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find places"
 },
 "description": "Find places for a specific occasion in one city \u2014 the task-shaped entry point. Give the city and what the evening needs (a cuisine, a neighborhood, a budget, a vibe) and it returns ranked, citable venues with a freshness receipt. Prefer this over search_venues when you are planning rather than browsing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "city": {
    "description": "City name or key from list_cities",
    "type": "string"
   },
   "limit": {
    "description": "Max results, default 6",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "looking_for": {
    "description": "What the occasion needs, e.g. 'omakase', 'patio', 'birthday dinner'",
    "type": "string"
   },
   "max_price": {
    "description": "Max price tier 1-4",
    "maximum": 4,
    "minimum": 1,
    "type": "integer"
   },
   "neighborhood": {
    "description": "Narrow to a neighborhood",
    "type": "string"
   }
  },
  "required": [
   "city"
  ],
  "type": "object"
 },
 "name": "find_places",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "city": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "receipt": {
    "additionalProperties": false,
    "properties": {
     "abstained": {
      "type": "boolean"
     },
     "as_of": {
      "type": [
       "string",
       "null"
      ]
     },
     "as_of_scope": {
      "type": "string"
     },
     "reason": {
      "type": [
       "string",
       "null"
      ]
     },
     "scope_note": {
      "type": [
       "string",
       "null"
      ]
     },
     "source": {
      "type": "string"
     },
     "stale": {
      "type": "boolean"
     }
    },
    "required": [
     "as_of",
     "as_of_scope",
     "source",
     "abstained",
     "stale",
     "reason"
    ],
    "type": "object"
   },
   "showing": {
    "type": "number"
   },
   "total_matches": {
    "type": "number"
   },
   "venues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "awards": {
       "type": "string"
      },
      "cuisine": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "happy_hour": {
       "type": "string"
      },
      "iconic": {
       "type": "boolean"
      },
      "id": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "neighborhood": {
       "type": "string"
      },
      "opened": {
       "type": "string"
      },
      "price": {
       "type": "string"
      },
      "reservation": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "trending": {
       "type": "boolean"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "cuisine",
      "neighborhood",
      "happy_hour",
      "reservation",
      "description",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "city",
   "total_matches",
   "showing",
   "venues",
   "receipt"
  ],
  "type": "object"
 },
 "title": "Find places"
}
