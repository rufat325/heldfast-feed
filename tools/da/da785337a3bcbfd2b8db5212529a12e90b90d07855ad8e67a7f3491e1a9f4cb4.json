 "description": "Compares a logo image against the registered logos on the U.S. and international registers, three ways: the shape of the image, what the image depicts, and the wording inside it. Each match comes back with a similarity score, how it matched, and whether the registration is still live. Use this when someone shares artwork and asks whether it clashes with an existing mark. The search takes a minute or two, so this returns a job id to read back with get_result.",
 "inputSchema": {
  "properties": {
   "brand_name": {
    "description": "The wording in the logo, if known. Sharpens the text match.",
    "maxLength": 120,
    "type": "string"
   },
   "image": {
    "description": "The logo image file.",
    "properties": {
     "download_url": {
      "type": "string"
     },
     "file_id": {
      "type": "string"
     },
     "file_name": {
      "type": "string"
     },
     "mime_type": {
      "type": "string"
     }
    },
    "required": [
     "download_url",
     "file_id"
    ],
    "type": "object"
   }
  },
  "required": [
   "image"
  ],
  "type": "object"
 },
 "name": "check_logo",
 "outputSchema": {
  "properties": {
   "closest_matches": {
    "items": {
     "properties": {
      "classes": {
       "items": {
        "type": "integer"
       },
       "type": "array"
      },
      "filing_year": {
       "type": "integer"
      },
      "image_url": {
       "type": "string"
      },
      "live": {
       "type": "boolean"
      },
      "mark": {
       "description": "Wording in the registered logo, empty when it is purely graphic.",
       "type": "string"
      },
      "matched_on": {
       "description": "phash (image shape), clip (what it depicts), text (wording).",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "record_url": {
       "type": "string"
      },
      "serial": {
       "type": "string"
      },
      "similarity": {
       "description": "0 to 100.",
       "type": "integer"
      },
      "status": {
       "type": "string"
      },
      "strength": {
       "description": "identical, strong, moderate or loose.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "job_id": {
    "type": "string"
   },
   "match_count": {
    "type": "integer"
   },
   "pdf_url": {
    "type": "string"
   },
   "results_url": {
    "type": "string"
   },
   "status": {
    "description": "complete, failed, or a running stage.",
    "type": "string"
   },
   "wording_read_from_logo": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Check a logo"
}
