{
 "description": "Atomically swap the actual job Instructions tab to an exactly preflighted desired tree. TipTap documents are staged first, then all visible page/document pointers change in one database transaction. Requires explicit tree replacement and live confirmation; the response reports writesApplied:true (preflight_tree reports writesApplied:false and never writes). NEW pages accept optional contentSchemaVersion (1|2, default 1); v2 blocks (youtube/callout/details/audio/attachment) require the page\u2019s contentSchemaVersion >= 2 \u2014 see schema_upgrade.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "archivedPageIds": {
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "confirmLive": {
    "const": true,
    "type": "boolean"
   },
   "confirmTreeReplace": {
    "const": true,
    "type": "boolean"
   },
   "expectedTreeChecksum": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "additionalProperties": false,
       "properties": {
        "attrs": {
         "additionalProperties": {},
         "type": "object"
        },
        "content": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "attrs": {
            "additionalProperties": {},
            "type": "object"
           },
           "content": {
            "items": {
             "$ref": "#/properties/pages/items/properties/content/properties/content/items"
            },
            "type": "array"
           },
           "marks": {
            "items": {
             "additionalProperties": false,
             "properties": {
              "attrs": {
               "additionalProperties": {},
               "type": "object"
              },
              "type": {
               "minLength": 1,
               "type": "string"
              }
             },
             "required": [
              "type"
             ],
             "type": "object"
            },
            "type": "array"
           },
           "text": {
            "type": "string"
           },
           "type": {
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "type"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "type": {
         "const": "doc",
         "type": "string"
        }
       },
       "required": [
        "type",
        "content"
       ],
       "type": "object"
      },
      "contentSchemaVersion": {
       "enum": [
        1,
        2
       ],
       "type": "number"
      },
      "expectedChecksum": {
       "$ref": "#/properties/expectedTreeChecksum"
      },
      "icon": {
       "anyOf": [
        {
         "maxLength": 32,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "pageId": {
       "minLength": 1,
       "type": "string"
      },
      "parentRef": {
       "anyOf": [
        {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "position": {
       "minimum": 0,
       "type": "integer"
      },
      "ref": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "title": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "ref",
      "title",
      "parentRef",
      "position",
      "content"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "type": "array"
   },
   "preflightToken": {
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "expectedTreeChecksum",
   "pages",
   "archivedPageIds",
   "confirmTreeReplace",
   "idempotencyKey",
   "preflightToken",
   "confirmLive"
  ],
  "type": "object"
 },
 "name": "opentrain_job_instructions_apply_tree",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
