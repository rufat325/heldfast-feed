 "description": "Update a PM experiment \u2014 advance its state and record the outcome \u2014 and return it. state \u2208 hypothesis|build|measure|learn; verdict \u2208 validated|invalidated; decision \u2208 pivot|persevere. Resolve the id via list_experiments; only id is required.",
 "inputSchema": {
  "examples": [
   {
    "decision": "persevere",
    "id": "exp_123",
    "state": "learn",
    "verdict": "validated"
   }
  ],
  "properties": {
   "decision": {
    "description": "What you'll do next (optional).",
    "enum": [
     "pivot",
     "persevere"
    ],
    "type": "string"
   },
   "hypothesis": {
    "description": "New hypothesis; null clears it (optional).",
    "type": "string"
   },
   "id": {
    "description": "Experiment id, from list_experiments (required).",
    "type": "string"
   },
   "metric": {
    "description": "New metric; null clears it (optional).",
    "type": "string"
   },
   "result": {
    "description": "Free-text result / what you learned; null clears it (optional).",
    "type": "string"
   },
   "state": {
    "description": "Build-Measure-Learn stage (optional).",
    "enum": [
     "hypothesis",
     "build",
     "measure",
     "learn"
    ],
    "type": "string"
   },
   "target": {
    "description": "New target; null clears it (optional).",
    "type": "string"
   },
   "title": {
    "description": "New title (optional).",
    "type": "string"
   },
   "verdict": {
    "description": "Outcome (optional).",
    "enum": [
     "validated",
     "invalidated"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_experiment",
 "title": "Update Experiment"
}
