{
 "description": "Get the to-do list for a project \u2014 tickets filtered as actionable items (open/in_progress), sorted by priority. Excludes tickets with auto-execution workflow enabled. Use this for an overview of what needs to be done.",
 "inputSchema": {
  "properties": {
   "assigneeId": {
    "description": "Filter by assignee user ID",
    "type": "string"
   },
   "limit": {
    "description": "Max items to return (default: 50)",
    "type": "number"
   },
   "priority": {
    "description": "Filter by priority (default: all)",
    "enum": [
     "all",
     "critical",
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "projectId": {
    "description": "The project ID",
    "type": "string"
   },
   "status": {
    "description": "Filter by status (default: all actionable)",
    "enum": [
     "all",
     "open",
     "in_progress",
     "review"
    ],
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "list_todo"
}
