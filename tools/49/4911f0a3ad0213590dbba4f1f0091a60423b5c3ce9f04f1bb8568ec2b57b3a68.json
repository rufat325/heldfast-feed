           "minLength": 1,
           "type": "string"
          },
          "amount": {
           "type": "number"
          },
          "type": {
           "const": "MODIFY_ABILITY",
           "type": "string"
          }
         },
         "required": [
          "type",
          "ability",
          "amount"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "amount": {
           "type": "number"
          },
          "skillId": {
           "type": "string"
          },
          "type": {
           "const": "MODIFY_SKILL",
           "type": "string"
          }
         },
         "required": [
          "type",
          "skillId",
          "amount"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "scope": {
           "enum": [
            "attacks",
            "defense",
            "skill_tests",
            "all"
           ],
           "type": "string"
          },
          "skills": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "type": {
           "const": "GRANT_ADVANTAGE",
           "type": "string"
          }
         },
         "required": [
          "type",
          "scope"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "scope": {
           "enum": [
            "attacks",
            "defense",
            "skill_tests",
            "all"
           ],
           "type": "string"
          },
          "skills": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "type": {
           "const": "GRANT_DISADVANTAGE",
           "type": "string"
          }
         },
         "required": [
          "type",
          "scope"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "damageType": {
           "type": "string"
          },
          "multiplier": {
           "type": "number"
          },
          "type": {
           "const": "RESISTANCE",
           "type": "string"
          }
         },
         "required": [
          "type",
          "damageType"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "damageType": {
           "type": "string"
          },
          "multiplier": {
           "type": "number"
          },
          "type": {
           "const": "VULNERABILITY",
           "type": "string"
          }
         },
         "required": [
          "type",
          "damageType"
         ],
         "type": "object"
        }
       ]
      },
      "type": "array"
     },
     "id": {
      "minLength": 1,
      "type": "string"
     },
     "name": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "description",
     "duration"
    ],
    "type": "object"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "targetId": {
    "description": "Target combatant ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "targetId",
   "condition"
