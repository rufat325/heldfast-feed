  "properties": {
   "condition": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "type": "string"
     },
     "duration": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "const": "permanent",
        "type": "string"
       },
       {
        "const": "until_rest",
        "type": "string"
       }
      ]
     },
     "durationMinutes": {
      "description": "Duration in game minutes (sets time-based expiration)",
      "minimum": 1,
      "type": "number"
     },
     "effects": {
      "description": "Effects of the condition",
      "items": {
       "anyOf": [
        {
         "additionalProperties": false,
