  "readOnlyHint": true,
  "title": "chainpeek: cross-venue perpetual funding carry ranking across Binance, Bybit, OKX, Hyperliquid and dYdX"
 },
 "description": "chainpeek: Rank cross-venue perpetual funding carry. For Hyperliquid against dYdX alone use compare_funding_rates; for market data use get_perp_markets. Returns the best long and short venue pair per asset across Binance USDT-M, Bybit, OKX, Hyperliquid and dYdX v4, with the annualised funding spread gross and net of taker fees. Net subtracts four taker legs (open and close on both venues) at `taker_fee_bps`, spread over `holding_days`; with the default 0 bps net equals gross. Rates are normalised to hourly and annualised (simple); a venue that is down is listed in `venues_failed`. Cached up to 60 s. Data only, not trading advice. Bad input is a 422 (not charged). Typically 1-5 s. Price: USD 0.005. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/funding-rate-arbitrage-api.html",
 "inputSchema": {
  "properties": {
   "holding_days": {
    "default": 7,
    "description": "Days the position is held; the fees are amortised over it (default 7).",
    "exclusiveMinimum": 0,
    "maximum": 365,
    "title": "Holding Days",
    "type": "number"
   },
   "limit": {
    "default": 20,
    "description": "Rows returned, 1-100 (default 20).",
    "maximum": 100,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "min_volume_usd": {
    "default": 0,
    "description": "A venue is only used for a symbol when its 24 h volume there reaches this (USD), so it applies to both legs. Default 0.",
    "maximum": 10000000000000.0,
    "minimum": 0,
    "title": "Min Volume Usd",
    "type": "number"
   },
   "symbols": {
    "anyOf": [
     {
      "items": {
       "pattern": "^[A-Za-z0-9._-]{1,20}$",
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional: only these base assets (case-insensitive, at most 50), such as BTC. Names listed on fewer than two of the chosen venues are returned in symbols_not_found.",
    "title": "Symbols"
   },
   "taker_fee_bps": {
    "default": 0,
    "description": "Taker fee per side in basis points (default 0). Net APR subtracts 4 taker legs (open and close on both venues): 4 x bps / 100 x 365 / holding_days.",
    "maximum": 1000,
    "minimum": 0,
    "title": "Taker Fee Bps",
    "type": "number"
   },
   "venues": {
    "anyOf": [
     {
      "items": {
       "enum": [
        "hyperliquid",
        "dydx",
        "binance",
        "bybit",
        "okx"
       ],
       "type": "string"
      },
      "maxItems": 5,
      "minItems": 2,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional subset of hyperliquid, dydx, binance, bybit, okx (at least two). Default: all five.",
    "title": "Venues"
   }
  },
  "title": "rank_funding_carryArguments",
  "type": "object"
 },
