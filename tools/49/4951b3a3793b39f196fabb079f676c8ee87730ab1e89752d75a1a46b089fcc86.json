{
 "description": "Retrieves a render started by render_asset_preview once ready.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "jobId": {
    "description": "From a pending response.",
    "type": "string"
   },
   "timeoutMs": {
    "default": 15000,
    "description": "Bounded wait.",
    "maximum": 30000,
    "type": "number"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "poll_render"
}
