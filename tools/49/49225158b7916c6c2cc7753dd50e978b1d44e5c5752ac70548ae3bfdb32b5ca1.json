{"annotations":{"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Find meeting times when everyone is free: intersects each participant's working hours (own time zone, workdays, country holidays) minus their busy blocks, then lists slots of the requested length. Up to 10 people, 14 days, optional buffer between meetings. Use for scheduling across calendars and time zones. First 25 calls per day are free, then $0.001 per call (x402).","inputSchema":{"properties":{"buffer_minutes":{"default":0,"description":"Free time kept around busy blocks","maximum":120,"minimum":0,"type":"integer"},"days":{"default":5,"maximum":14,"minimum":1,"type":"integer"},"duration_minutes":{"maximum":720,"minimum":5,"type":"integer"},"from":{"example":"2026-11-07","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"max_slots":{"default":10,"maximum":50,"minimum":1,"type":"integer"},"not_before":{"description":"Earliest slot start: ISO 8601 with offset, or \"now\"","type":"string"},"participants":{"items":{"properties":{"busy":{"description":"Busy blocks, up to 100 per person (300 total)","items":{"properties":{"end":{"description":"ISO 8601 with offset","type":"string"},"start":{"description":"ISO 8601 with offset","type":"string"}},"required":["start","end"],"type":"object"},"maxItems":200,"type":"array"},"country":{"description":"ISO 3166-1 alpha-2 country code (207 countries); its public holidays (2000\u20132050) are excluded from business days","example":"US","pattern":"^[A-Za-z]{2}$","type":"string"},"holidays":{"description":"Extra dates excluded from business-day counts (rest days from workdays are always excluded)","items":{"example":"2026-11-07","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"maxItems":1000,"type":"array"},"timezone":{"description":"IANA time zone, e.g. Asia/Manila","example":"Asia/Manila","type":"string"},"work_end":{"description":"Overrides the default work_end","pattern":"^([01]\\d|2[0-4]):[0-5]\\d$","type":"string"},"work_star