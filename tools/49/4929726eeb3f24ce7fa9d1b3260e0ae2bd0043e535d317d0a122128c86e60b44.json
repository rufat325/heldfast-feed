{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check a postcode's structure offline and return its canonical forms and segments.\n\nFree and instant. Does not confirm the code is assigned to a building; use\nlookup_postcode for that.",
 "inputSchema": {
  "properties": {
   "postcode": {
    "description": "Code in any style, e.g. 'ek 01 a03 fk 01'.",
    "maxLength": 64,
    "title": "Postcode",
    "type": "string"
   }
  },
  "required": [
   "postcode"
  ],
  "title": "validate_postcodeArguments",
  "type": "object"
 },
 "name": "validate_postcode",
 "outputSchema": {
  "$defs": {
   "Segments": {
    "properties": {
     "area": {
      "title": "Area",
      "type": "string"
     },
     "district": {
      "title": "District",
      "type": "string"
     },
     "lga": {
      "title": "Lga",
      "type": "string"
     },
     "state": {
      "title": "State",
      "type": "string"
     },
     "unit": {
      "title": "Unit",
      "type": "string"
     }
    },
    "required": [
     "state",
     "lga",
     "district",
     "area",
     "unit"
    ],
    "title": "Segments",
    "type": "object"
   }
  },
  "properties": {
   "compact": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Compact form for storage, e.g. EK01A03FK01.",
    "title": "Compact"
   },
   "error": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Why the code is malformed.",
    "title": "Error"
   },
   "postcode": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Canonical form, e.g. EK-01-A03-FK-01.",
    "title": "Postcode"
   },
   "segments": {
    "anyOf": [
     {
      "$ref": "#/$defs/Segments"
     },
     {
      "type": "null"
     }
    ]
   },
   "spaced": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Form shown to people, e.g. EK 01 A03 FK 01.",
    "title": "Spaced"
   },
   "suggestion": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "A well-formed code if look-alike characters (O/0, I/1, S/5, B/8) were the only problem. Confirm it with the user before using it.",
    "title": "Suggestion"
   },
   "valid": {
    "description": "Whether the code is well formed. It may still be unassigned.",
    "title": "Valid",
    "type": "boolean"
   }
  },
  "required": [
   "valid",
   "postcode",
   "compact",
   "spaced",
   "segments",
   "error",
   "suggestion"
  ],
  "title": "Validation",
  "type": "object"
 },
 "title": "Validate a Nigerian postcode"
}
