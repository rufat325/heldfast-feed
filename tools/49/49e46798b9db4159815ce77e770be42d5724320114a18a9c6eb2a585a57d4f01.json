{
 "description": "Track GitLab activity and events. Actions: user (your activity across all projects), project (specific project activity feed). Filter by date range, action type, or target type.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to perform: user, project",
    "enum": [
     "user",
     "project"
    ],
    "type": "string"
   },
   "after": {
    "description": "Show events after this date (YYYY-MM-DD).",
    "type": "string"
   },
   "before": {
    "description": "Show events before this date (YYYY-MM-DD).",
    "type": "string"
   },
   "event_action": {
    "description": "Filter by event action.",
    "enum": [
     "created",
     "updated",
     "closed",
     "reopened",
     "pushed",
     "commented",
     "merged",
     "joined",
     "left",
     "destroyed",
     "expired"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "default": 20,
    "description": "Number of items per page (default: 20, max: 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "project_id": {
    "description": "Project ID. Required for 'project' action(s).",
    "minLength": 1,
    "type": "string"
   },
   "sort": {
    "description": "Sort order: asc=oldest first, desc=newest first.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "target_type": {
    "description": "Filter by target type.",
    "enum": [
     "issue",
     "milestone",
     "merge_request",
     "note",
     "project",
     "snippet",
     "user"
    ],
    "type": "string"
   }
  },
  "required": [
   "action",
   "per_page"
  ],
  "type": "object"
 },
 "name": "browse_events"
}
