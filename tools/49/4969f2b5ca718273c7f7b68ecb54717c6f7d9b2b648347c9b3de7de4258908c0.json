{
 "description": "Find Singapore primary/secondary schools within 1km and 2km of a postal code. Useful for Primary 1 distance-priority and property valuation. FREE",
 "inputSchema": {
  "properties": {
   "postal_code": {
    "description": "Singapore 6-digit postal code",
    "type": "string"
   },
   "radius_km": {
    "default": 2,
    "description": "Search radius in km (0.5-5)",
    "type": "number"
   },
   "school_type": {
    "default": "",
    "description": "Optional filter",
    "enum": [
     "",
     "primary",
     "secondary"
    ],
    "type": "string"
   }
  },
  "required": [
   "postal_code"
  ],
  "type": "object"
 },
 "name": "sg_school_proximity"
}
