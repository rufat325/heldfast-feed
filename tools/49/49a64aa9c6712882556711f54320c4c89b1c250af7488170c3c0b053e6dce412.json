{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List a server's tools"
 },
 "description": "Every current tool of a server with full input/output schemas, paginated by tool name.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "description": "next_cursor from the previous page",
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Official reverse-DNS name",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "list_tools",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "next_actions": {
    "description": "Follow-up calls: action is the tool, arguments are ready to pass ({placeholders} are yours to fill)",
    "items": {
     "additionalProperties": {},
     "properties": {
      "action": {
       "type": "string"
      },
      "arguments": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "description": "Pass as cursor for the next page; null on the last page",
    "type": [
     "string",
     "null"
    ]
   },
   "server": {
    "type": "string"
   },
   "tools": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "annotations": {
       "description": "Tool hints such as readOnlyHint, as the server declares them"
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "input_schema": {
       "description": "JSON Schema of the arguments, as the server declares it"
      },
      "name": {
       "type": "string"
      },
      "observed_at": {
       "type": "string"
      },
      "output_schema": {},
      "source": {
       "enum": [
        "probe",
        "publisher"
       ],
       "type": "string"
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "name",
      "title",
      "description",
      "input_schema",
      "output_schema",
      "annotations",
      "source",
      "observed_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "server",
   "count",
   "tools",
   "next_cursor",
   "next_actions"
  ],
  "type": "object"
 },
 "title": "List a server's tools"
}
