    "default": 1,
    "description": "Start month (1\u201312). Defaults to January.",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "from_year": {
    "description": "Start year of the data range (inclusive). The API uses monthly granularity.",
    "maximum": 2030,
    "minimum": 2000,
    "type": "integer"
   },
   "offense": {
    "description": "Offense type: violent-crime, property-crime, robbery, burglary, larceny, motor-vehicle-theft, arson, aggravated-assault, rape, or homicide.",
    "enum": [
     "violent-crime",
     "property-crime",
     "robbery",
     "burglary",
     "larceny",
     "motor-vehicle-theft",
     "arson",
     "aggravated-assault",
     "rape",
     "homicide"
    ],
    "type": "string"
   },
   "ori": {
    "description": "9-character ORI agency code. Required when scope is \"agency\".",
    "maxLength": 9,
    "minLength": 9,
    "type": "string"
   },
   "scope": {
    "description": "Geographic scope: national, state (requires state_abbr), or agency (requires ori).",
    "enum": [
     "national",
     "state",
     "agency"
    ],
    "type": "string"
   },
   "state_abbr": {
    "description": "Two-letter state abbreviation (e.g. CA). Required when scope is \"state\".",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "to_month": {
    "default": 12,
    "description": "End month (1\u201312). Defaults to December.",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "to_year": {
    "description": "End year of the data range (inclusive).",
    "maximum": 2030,
    "minimum": 2000,
    "type": "integer"
   }
  },
  "required": [
   "scope",
   "offense",
   "from_year",
   "to_year"
  ],
  "type": "object"
 },
