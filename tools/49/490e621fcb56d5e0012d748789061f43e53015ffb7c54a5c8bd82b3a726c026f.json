{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Return a claimed job to pending using the worker token and its current receipt. On the fifth claim it becomes failed. The receipt is invalidated. Stale receipts conflict.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "job_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   },
   "queue_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   },
   "receipt": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "worker_token": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "queue_id",
   "job_id",
   "worker_token",
   "receipt"
  ],
  "type": "object"
 },
 "name": "release_agent_queue_job",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "expire_timestamp": {
    "type": "integer"
   },
   "job": {
    "additionalProperties": false,
    "properties": {
     "attempts": {
      "maximum": 5,
      "minimum": 0,
      "type": "integer"
     },
     "claimed_until_timestamp": {
      "type": [
       "integer",
       "null"
      ]
     },
     "created_at_timestamp": {
      "type": "integer"
     },
     "expire_timestamp": {
      "type": "integer"
     },
     "job_id": {
      "pattern": "^[a-f0-9]{32}$",
      "type": "string"
     },
     "job_key": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "type": "string"
     },
     "payload": {},
     "status": {
      "enum": [
       "pending",
       "claimed",
       "completed",
       "failed"
      ],
      "type": "string"
     }
    },
    "required": [
     "job_id",
     "job_key",
     "payload",
     "status",
     "attempts",
     "created_at_timestamp",
     "expire_timestamp",
     "claimed_until_timestamp"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "queue_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   }
  },
  "required": [
   "ok",
   "queue_id",
   "expire_timestamp",
   "job"
  ],
  "type": "object"
 },
 "title": "Release agent queue job"
}
