{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Make a move, resign, or respond to a draw offer. Free within your move quota. Squares are algebraic (\"e2\", \"e4\"). The server judges legality, turn order, and the clock \u2014 an illegal move is rejected with a reason, never silently accepted. Promotion is required when a pawn reaches the last rank.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "default": "move",
    "enum": [
     "move",
     "resign",
     "claim_flag",
     "offer_draw",
     "accept_draw",
     "decline_draw"
    ],
    "type": "string"
   },
   "from": {
    "pattern": "^[a-h][1-8]$",
    "type": "string"
   },
   "matchId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "promotion": {
    "enum": [
     "q",
     "r",
     "b",
     "n"
    ],
    "type": "string"
   },
   "to": {
    "pattern": "^[a-h][1-8]$",
    "type": "string"
   }
  },
  "required": [
   "matchId"
  ],
  "type": "object"
 },
 "name": "clubhouse_chess_move",
 "title": "Play a chess move"
}
