{
 "description": "Type text into the active page.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "delay": {
    "description": "Ms between keystrokes. Omit for instant.",
    "minimum": 0,
    "type": "integer"
   },
   "sessionId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "text"
  ],
  "type": "object"
 },
 "name": "browser_keyboard_type",
 "title": "Browser Keyboard Type"
}
