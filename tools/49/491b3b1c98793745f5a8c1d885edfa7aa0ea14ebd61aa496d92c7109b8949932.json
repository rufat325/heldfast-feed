{"description":"\uc9c0\uc5ed\ud654\ud3d0\ub97c \ubc1b\ub294 \uac00\ub9f9\uc810(\uc74c\uc2dd\uc810, \ub9c8\ud2b8, \ubcd1\uc6d0, \uc8fc\uc720\uc18c \ub4f1 \ubaa8\ub4e0 \uc5c5\uc885)\uc744 \uc9c0\uc5ed\uacfc \uac80\uc0c9\uc5b4\ub85c \ucc3e\uc2b5\ub2c8\ub2e4. \uc2dc\u00b7\uad70\uacfc \ub300\uc804\uc2dc\uac00 \uacf5\uac1c\ud55c \uac00\ub9f9\uc810 \ubaa9\ub85d\uc744 \uc501\ub2c8\ub2e4. \ubaa9\ub85d\uc774 \uc788\ub294 \uc9c0\uc5ed\ub9cc \ub2f5\ud558\uba70, \uc5c6\ub294 \uc9c0\uc5ed\uc774\uba74 \ubaa9\ub85d\uc774 \uc788\ub294 \uc9c0\uc5ed\uc744 \uc54c\ub824 \uc90d\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"limit":{"description":"\ucd5c\ub300 \uacb0\uacfc \uc218. \uae30\ubcf8 20.","maximum":50,"minimum":1,"type":"integer"},"query":{"description":"\uc0c1\ud638\u00b7\uc8fc\uc18c\u00b7\uc5c5\uc885 \uac80\uc0c9\uc5b4. \uc5ec\ub7ec \ub2e8\uc5b4\ub294 \ubaa8\ub450 \ud3ec\ud568. \uc608: '\uad6d\ubc25', '\uc911\uc559\ub85c \uc57d\uad6d'. \ube44\uc6b0\uba74 \uc55e\uc5d0\uc11c\ubd80\ud130.","type":"string"},"region":{"description":"\uc9c0\uc5ed \uc774\ub984. \uc608: '\uc218\uc6d0', '\uacbd\uae30 \uc218\uc6d0\uc2dc', '\ub300\uc804', '\ucd98\ucc9c\uc2dc', '\uc81c\uc8fc'. \ub3c4 \ub2e8\uc704 \uc9c0\uc5ed\uc740 \uc2dc\u00b7\uad70\uae4c\uc9c0 \uc801\uc5b4\uc57c \ud569\ub2c8\ub2e4.","type":"string"}},"required":["region"],"type":"object"},"name":"search_merchants","title":"\uc9c0\uc5ed\ud654\ud3d0 \uac00\ub9f9\uc810 \uac80\uc0c9"}
