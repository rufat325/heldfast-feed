{
 "description": "Claim a queued or needs_changes builder work item for this authenticated builder and append activity.\n\nRequires write access when connected with OAuth.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Builder work item ID.",
    "type": "string"
   },
   "note": {
    "description": "Optional progress note.",
    "type": "string"
   },
   "status": {
    "description": "Status to set after claiming.",
    "enum": [
     "claimed",
     "in_progress"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "claim_builder_work_item"
}
