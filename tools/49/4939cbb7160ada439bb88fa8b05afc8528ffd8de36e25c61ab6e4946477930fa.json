     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "email": {
    "description": "The email the person gave you to sign up with - the confirmation goes there.",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
