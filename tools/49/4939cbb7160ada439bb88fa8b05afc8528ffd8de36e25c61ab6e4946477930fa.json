{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Prepare a signup"
 },
 "description": "Prepare a 1lev1 signup for a person who has NO 1lev1 account yet, so joining is one screen - the agreement prefilled with their name, email and countries, and the password on the same screen. Use it only when the person's own request is what 1lev1 does: finding partners for their work, turning a business or an idea into a partnership where the work, resources and money each partner brings become a share, or having something made or arranged by partners through the concierge. Do not bring it up in any other conversation. Before calling, tell the person what will be sent and get their go-ahead; pass only the name and email they gave you for this signup (ask for them - never take them from memory or earlier chats). intent: \"business\" (add their business so the concierge finds and orders from it), \"partnership\" (see an existing partnership on 1lev1), \"idea\" (break an idea down and recruit partners) - for these three send the rikma blueprint you built (the same shape as proposeRikmaBlueprint takes: fields, products first, missions, resources, partners) and you also get a previewUrl showing how it would look; \"join\" (join rikmas - pass aboutText: who they are, what they do); \"order\" (they want something made or arranged - pass wishText). You cannot sign, set a password or confirm the email for them, and nothing is created until they do. Give them signupUrl (valid 24h). After they confirm their email they land straight in what you prepared. Docs: https://1lev1.com/mcp#prepareSignup",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aboutText": {
    "maxLength": 8000,
    "type": "string"
   },
   "blueprint": {
    "additionalProperties": false,
    "properties": {
     "fields": {
      "additionalProperties": false,
      "properties": {
       "currency": {
        "maxLength": 3,
        "minLength": 3,
        "type": "string"
       },
       "descripFor": {
        "maxLength": 2000,
        "type": "string"
       },
       "linkToWebsite": {
        "format": "uri",
        "maxLength": 500,
        "type": "string"
       },
       "location": {
        "additionalProperties": false,
        "properties": {
         "hint": {
          "maxLength": 200,
          "type": "string"
         },
         "isOnline": {
          "type": "boolean"
         },
         "lat": {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
         },
         "lng": {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
         },
         "radius": {
          "maximum": 20000,
          "minimum": 0,
          "type": "number"
         }
        },
        "type": "object"
       },
       "name": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "publicDescription": {
        "maxLength": 2000,
        "type": "string"
       },
       "restime": {
        "enum": [
         "feh",
         "sth",
         "nsh",
         "sevend"
        ],
        "type": "string"
       },
       "track": {
        "enum": [
         "business",
         "partnership",
         "idea"
        ],
        "type": "string"
       },
       "vals": {
        "items": {
         "maxLength": 60,
         "type": "string"
        },
        "maxItems": 8,
        "type": "array"
       }
      },
      "required": [
       "track",
       "name"
      ],
      "type": "object"
     },
     "missions": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "descrip": {
         "maxLength": 2000,
         "type": "string"
        },
        "holder": {
         "enum": [
          "me",
          "open",
          "partner"
         ],
         "type": "string"
        },
        "hours": {
         "description": "Hours in total, or per month when recurring",
         "maximum": 10000,
         "minimum": 0,
         "type": "number"
        },
        "name": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "partnerRef": {
         "maxLength": 40,
         "minLength": 1,
         "type": "string"
        },
        "ratePerHour": {
         "maximum": 100000000,
         "minimum": 0,
         "type": "number"
        },
        "recurring": {
         "description": "Ongoing work, every month",
         "type": "boolean"
        },
        "ref": {
         "maxLength": 40,
         "minLength": 1,
         "type": "string"
        },
        "roles": {
         "items": {
          "maxLength": 60,
          "type": "string"
         },
         "maxItems": 6,
         "type": "array"
        },
        "skills": {
         "items": {
          "maxLength": 60,
          "type": "string"
         },
         "maxItems": 10,
         "type": "array"
        },
        "why": {
         "maxLength": 300,
         "type": "string"
        },
        "workways": {
         "items": {
          "maxLength": 60,
          "type": "string"
         },
         "maxItems": 6,
         "type": "array"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "maxItems": 30,
      "type": "array"
     },
     "partners": {
      "default": [],
