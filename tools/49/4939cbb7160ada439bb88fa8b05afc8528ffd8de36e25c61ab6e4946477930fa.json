         "maxLength": 200,
         "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
         "type": "string"
        },
        "name": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "ref": {
         "maxLength": 40,
         "minLength": 1,
         "type": "string"
        },
        "why": {
         "maxLength": 300,
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "maxItems": 10,
      "type": "array"
     },
     "products": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "categories": {
