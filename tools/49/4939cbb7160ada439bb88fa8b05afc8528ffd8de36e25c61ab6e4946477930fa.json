          "maxLength": 40,
          "type": "string"
         },
         "maxItems": 3,
         "type": "array"
        },
        "currency": {
         "maxLength": 3,
         "minLength": 3,
         "type": "string"
        },
        "desc": {
         "maxLength": 2000,
         "type": "string"
        },
        "isOnline": {
         "type": "boolean"
        },
        "keywords": {
         "items": {
          "maxLength": 60,
          "type": "string"
         },
         "maxItems": 15,
         "type": "array"
        },
        "kindOf": {
         "enum": [
          "total",
          "unlimited",
          "daily",
          "monthly",
          "yearly"
         ],
         "type": "string"
        },
        "name": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "price": {
         "maximum": 100000000,
         "minimum": 0,
         "type": "number"
        },
        "pricingMode": {
         "enum": [
          "fixed",
          "quote"
         ],
         "type": "string"
        },
        "quant": {
         "maximum": 1000000,
         "minimum": 1,
         "type": "integer"
        },
        "recipe": {
         "additionalProperties": false,
         "properties": {
          "missions": {
           "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
           },
           "maxItems": 15,
           "type": "array"
          },
          "resources": {
           "items": {
            "maxLength": 40,
            "minLength": 1,
            "type": "string"
           },
           "maxItems": 15,
           "type": "array"
          }
         },
         "type": "object"
        },
        "ref": {
         "maxLength": 40,
         "minLength": 1,
         "type": "string"
        },
        "unlimited": {
         "type": "boolean"
        },
        "why": {
         "maxLength": 300,
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "maxItems": 30,
      "type": "array"
     },
     "resources": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "descrip": {
         "maxLength": 2000,
         "type": "string"
        },
        "holder": {
         "enum": [
          "me",
          "open",
          "partner"
         ],
         "type": "string"
        },
        "kindOf": {
         "description": "monthly / yearly = a running cost (rent, subscription); price is then per month / year",
         "enum": [
          "total",
          "monthly",
          "yearly",
          "perUnit",
          "rent"
         ],
         "type": "string"
        },
        "name": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "partnerRef": {
         "maxLength": 40,
         "minLength": 1,
         "type": "string"
        },
        "price": {
         "description": "Per month / year when kindOf is monthly / yearly, otherwise the whole price",
         "maximum": 100000000,
         "minimum": 0,
         "type": "number"
        },
        "quantity": {
         "maximum": 1000000,
         "minimum": 0,
         "type": "number"
        },
        "ref": {
         "maxLength": 40,
         "minLength": 1,
         "type": "string"
        },
        "why": {
