  "additionalProperties": false,
  "properties": {
   "count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column_names": {
       "type": "string"
      },
      "index_name": {
       "type": "string"
      },
      "index_schema": {
       "type": "string"
      },
      "is_unique": {
       "type": "string"
      }
     },
     "required": [
      "index_name",
      "index_schema",
      "is_unique",
      "column_names"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
