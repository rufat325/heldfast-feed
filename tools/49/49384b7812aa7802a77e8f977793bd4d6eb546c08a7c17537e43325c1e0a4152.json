{
 "description": "Update a draft or scheduled post. Pass only the fields you want to change. platformMetadata replaces the whole object (set a Pinterest board or Reddit subreddit here).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "caption": {
    "type": "string"
   },
   "libraryItemId": {
    "type": "string"
   },
   "mediaIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "platformAccountIds": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     ]
    },
    "description": "Replacement per-platform account targeting, e.g. {\"twitter\": [\"<accountId>\"]}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "platformMetadata": {
    "description": "Per-platform settings. Pinterest posts need pinterest.boardIdByAccount and Reddit posts need reddit.subreddit before they can publish; drafts save without them.",
    "properties": {
     "pinterest": {
      "properties": {
       "boardIdByAccount": {
        "additionalProperties": {
         "maxLength": 64,
         "type": "string"
        },
        "description": "Pinterest account id (from list_social_accounts) \u2192 board id (from list_pinterest_boards). One entry per targeted Pinterest account.",
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       }
      },
      "type": "object"
     },
     "reddit": {
      "properties": {
       "subreddit": {
        "description": "Subreddit without the r/ prefix",
        "maxLength": 64,
        "type": "string"
       }
      },
      "type": "object"
     },
     "tiktok": {
      "properties": {
       "allow_comment": {
        "type": "boolean"
       },
       "allow_duet": {
        "type": "boolean"
       },
       "allow_stitch": {
        "type": "boolean"
       },
       "privacy_level": {
        "enum": [
         "PUBLIC_TO_EVERYONE",
         "MUTUAL_FOLLOW_FRIENDS",
         "FOLLOWER_OF_CREATOR",
         "SELF_ONLY"
        ],
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "platforms": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "postId": {
    "type": "string"
   },
   "scheduledFor": {
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "scheduled"
    ],
    "type": "string"
   },
   "title": {
    "description": "Replacement internal label (1\u2013140 chars); not published.",
    "type": "string"
   }
  },
  "required": [
   "postId"
  ],
  "type": "object"
 },
 "name": "update_post",
 "title": "Update post"
}
