{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "$0.02 per call. Pay with x402 (USDC on Base) in _meta[\"x402/payment\"]; MPP (tempo) on the HTTP URL /v1/license/verify. Contractor license status plus matching business-entity record. Served states: CA, FL, MN, OR, TX, VA, WA. CA entity is always null. MN entity is always null. TX entity is always null: Texas sells its business-registry data. FL and TX also take `profession`; values at GET /v1/license/professions?state=FL|TX. Empty licenses is a paid 200.",
 "inputSchema": {
  "description": "A two-letter state and either license_number or name.",
  "properties": {
   "license_number": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "License Number"
   },
   "name": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Name"
   },
   "profession": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "FL or TX only: a licensed profession instead of a contractor. GET /v1/license/professions?state=FL|TX (free) lists them. Omit for contractors.",
    "title": "Profession"
   },
   "state": {
    "examples": [
     "FL"
    ],
    "maxLength": 2,
    "minLength": 2,
    "pattern": "^[A-Za-z]{2}$",
    "title": "State",
    "type": "string"
   }
  },
  "required": [
   "state"
  ],
  "title": "LicenseVerifyRequest",
  "type": "object"
 },
 "name": "license_verify",
