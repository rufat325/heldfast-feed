{
 "description": "Create or retrieve a free persistent baseline. Existing registrations never refetch the target. No JavaScript execution.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ignore_json_paths": {
    "items": {
     "maxLength": 256,
     "minLength": 1,
     "pattern": "^\\/",
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "ignore_selectors": {
    "items": {
     "maxLength": 256,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "selector": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "format": "uri",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "fresh402_register"
}
