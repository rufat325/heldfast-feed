{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Run an action later or repeatedly, inside SetGet only. create takes one of in_seconds, at (ISO time),\nevery_seconds (60+) or cron (5 fields, UTC or `timezone`), plus do: {\"type\":\"notify\"} (default),\n{\"type\":\"enqueue\",\"queue_id\":...,\"channel\":...,\"payload\":...} or {\"type\":\"put_key\",\"key\":...,\"value\":...}.\nIt ends when it expires (max 7 days; touch renews) or after max_runs. read(runs, wait_seconds) waits for\nthe next run. run_now counts as a run.","inputSchema":{"properties":{"action":{"enum":["create","read","pause","resume","run_now","touch","delete"],"title":"Action","type":"string"},"at":{"anyOf":[{"maxLength":40,"type":"string"},{"type":"null"}],"default":null,"title":"At"},"cron":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"title":"Cron"},"do":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"title":"Do"},"every_seconds":{"anyOf":[{"maximum":604800,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Every Seconds"},"id":{"anyOf":[{"pattern":"^[A-Za-z0-9_-]{16,64}$","type":"string"},{"type":"null"}],"default":null,"title":"Id"},"in_seconds":{"anyOf":[{"maximum":604800,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"In Seconds"},"max_runs":{"anyOf":[{"maximum":100000,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Max Runs"},"runs":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Runs"},"timezone":{"anyOf":[{"maxLength":64,"type":"string"},{"type":"null"}],"default":null,"title":"Timezone"},"ttl_seconds":{"anyOf":[{"maximum":604800,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Ttl Seconds"},"wait_seconds":{"anyOf":[{"maximum":30,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Wait Seconds"}},"required":["action"],"title":"scheduleArguments","type":"object"},"name":"schedule"}
