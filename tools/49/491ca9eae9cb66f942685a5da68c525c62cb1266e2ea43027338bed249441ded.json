{"_meta":{"securitySchemes":[{"type":"noauth"},{"scopes":["mcp"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Find a market"},"description":"Where a market is and when it runs. Give a market's `name` (\"Mbare\nMusika\", \"Mile 12\", \"Wakulima\"; spelling and the word market do not\nmatter) or a town, district or lat/lng to see the markets near it, nearest\nfirst. `crop` keeps only markets that trade it. Each market has its town,\ncountry, how far away it is, the days and hours it runs, what is traded,\nwhat is in season this month, and its Divisi page. It gives no\nprices.","inputSchema":{"properties":{"crop":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Crop"},"lat":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Lat"},"limit":{"default":5,"title":"Limit","type":"integer"},"lng":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Lng"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Name"},"place":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Place"}},"title":"find_marketArguments","type":"object"},"name":"find_market","outputSchema":{"$defs":{"MarketCard":{"description":"One market: where it is, when it runs, what it trades.","properties":{"country":{"title":"Country","type":"string"},"distance_km":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Distance Km"},"hours":{"default":"","title":"Hours","type":"string"},"in_season":{"items":{"type":"string"},"title":"In Season","type":"array"},"link":{"title":"Link","type":"string"},"name":{"title":"Name","type":"string"},"open_days":{"title":"Open Days","type":"string"},"town":{"title":"Town","type":"string"},"trades":{"items":{"type":"string"},"title":"Trades","type":"array"}},"required":["name","town","country","open_days","trades","in_season","link"],"title":"MarketCard","type":"object"}},"properties"