{
 "description": "Have a multi-turn conversation with Doubao models. Supports conversation history.",
 "inputSchema": {
  "properties": {
   "max_tokens": {
    "default": 2048,
    "type": "number"
   },
   "messages": {
    "description": "Array of chat messages with role (system/user/assistant) and content",
    "items": {
     "properties": {
      "content": {
       "type": "string"
      },
      "role": {
       "enum": [
        "system",
        "user",
        "assistant"
       ],
       "type": "string"
      }
     },
     "required": [
      "role",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "model": {
    "default": "doubao-pro-32k",
    "description": "Model ID to use",
    "type": "string"
   },
   "temperature": {
    "default": 0.7,
    "type": "number"
   }
  },
  "required": [
   "messages"
  ],
  "type": "object"
 },
 "name": "doubao_chat"
}
