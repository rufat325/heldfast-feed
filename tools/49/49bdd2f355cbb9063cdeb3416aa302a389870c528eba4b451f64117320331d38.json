{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan Kibi bootstrap"
 },
 "description": "Generate a deterministic, snapshot-bound kibi.bootstrap-plan.v1 for repository onboarding. Read-only analysis of the repository plus any declared knowledge sources and cited intent claims returns evidence, bounded context questions, exact dependency-ordered actions, a canonical plan hash, and no mutation side effects.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "bootstrapContext": {
    "additionalProperties": {},
    "description": "Optional declared bootstrap context supplied by the agent to ground the read-only synthesis output.",
    "properties": {
     "intentClaims": {
      "description": "Statements of product intent the agent harvested from knowledgeSources, each citing its source. Normative claims the strict modeler can ground become cited req candidates; the rest become explicit authoring follow-ups. Bound into the plan hash.",
      "items": {
       "properties": {
        "excerpt": {
         "description": "Optional short quote supporting the claim.",
         "type": "string"
        },
        "reference": {
         "description": "Exact citation inside the source: a ticket key, page URL, or section anchor.",
         "minLength": 1,
         "type": "string"
        },
        "sourceId": {
         "description": "The id of a declared knowledge source.",
         "type": "string"
        },
        "statement": {
         "description": "One normative statement in the source's meaning, for example 'Refunds must not exceed the original charge.'",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "statement",
        "sourceId",
        "reference"
       ],
       "type": "object"
      },
      "maxItems": 200,
      "type": "array"
     },
     "knowledgeSources": {
      "description": "Knowledge sources outside the code that the human confirmed during the bootstrap interview (issue trackers, wikis, specs, decision logs). Kibi never contacts them; the agent reads them through its own connectors and cites them from intentClaims. Bound into the plan hash.",
      "items": {
       "properties": {
        "authority": {
         "anyOf": [
          {
           "const": "authoritative",
           "type": "string"
          },
          {
           "const": "supporting",
           "type": "string"
          },
          {
           "const": "stale",
           "type": "string"
          }
         ],
         "description": "The human's call: authoritative claims become higher-confidence candidates, supporting claims lower ones, and stale sources are cited but never produce candidates."
        },
        "connector": {
         "description": "Optional name of the MCP server or tool the agent used to read the source.",
         "type": "string"
        },
        "id": {
         "description": "Stable kebab-case handle that intentClaims cite, for example jira-payments.",
         "pattern": "^[a-z0-9][a-z0-9-]*$",
         "type": "string"
        },
        "kind": {
         "anyOf": [
          {
           "const": "issue_tracker",
           "type": "string"
          },
          {
           "const": "wiki",
           "type": "string"
          },
          {
           "const": "specification",
           "type": "string"
          },
          {
           "const": "design",
           "type": "string"
          },
          {
           "const": "decision_log",
           "type": "string"
          },
          {
           "const": "support",
           "type": "string"
          },
          {
           "const": "chat",
           "type": "string"
          },
          {
           "const": "repository_docs",
           "type": "string"
          },
          {
           "const": "other",
           "type": "string"
          }
         ]
        },
        "locator": {
         "description": "Where the source lives: a URL, project key, space name, or repo-relative path.",
         "minLength": 1,
         "type": "string"
        },
        "notes": {
         "type": "string"
        },
        "title": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "id",
        "kind",
        "title",
        "locator",
        "authority"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "type": "array"
     },
     "priorityRoots": {
      "description": "Optional repo roots the bootstrap flow should prioritize when authoring entities.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "projectSummary": {
      "description": "Optional short summary of the project or bootstrap goal.",
      "type": "string"
     },
     "sourceOfTruthNotes": {
      "description": "Optional notes about how to interpret the declared sources of truth.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "sourceOfTruthPaths": {
      "description": "Optional repo-relative paths that should be treated as declared sources of truth.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "verificationAnchors": {
      "description": "Optional verification commands, documents, or checkpoints to reference in the output.",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "entityTypes": {
    "description": "Optional filter to limit candidate generation to specific entity types.",
    "items": {
     "anyOf": [
      {
       "const": "req",
       "type": "string"
      },
      {
       "const": "scenario",
       "type": "string"
      },
      {
       "const": "test",
       "type": "string"
      },
      {
       "const": "adr",
       "type": "string"
      },
      {
       "const": "fact",
       "type": "string"
      },
      {
       "const": "symbol",
       "type": "string"
      }
     ]
    },
    "type": "array"
   },
   "includeGenericMarkdown": {
    "description": "Whether to include generic markdown file content as candidate facts. Default: true.",
    "type": "boolean"
   },
   "maxCandidates": {
    "description": "Maximum number of candidates to return. Clamped to [1, 200]. Default: 50.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "minConfidence": {
    "description": "Minimum confidence threshold for candidates. Clamped to [0.60, 0.95]. Default: 0.80.",
    "maximum": 0.95,
    "minimum": 0.6,
    "type": "number"
   },
   "workspaceRoot": {
    "description": "Optional absolute path of the workspace this call is about when it differs from the one the server started in, for example the git worktree you are working in. The server answers from that workspace's knowledge base when it is a worktree of the same repository or lies under the client's MCP roots; otherwise it answers from its own workspace and adds a workspace_mismatch diagnostic. Host hooks fill this in automatically where available.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "kb_plan_bootstrap",
