     "M5",
     "F1",
     "F2",
     "F3",
     "F4",
     "F5"
    ],
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "generate_controlled_voice",
 "title": "Generate Controlled Voice"
}
