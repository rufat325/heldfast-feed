  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Generate WAV speech with granular controls for speed and quality. Use this when an agent needs faster, slower, clearer, more polished, or more deliberate delivery. Costs $0.003 for 1-500 chars or $0.006 for 501-2000 chars.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "lang": {
    "description": "Language code, default en",
    "enum": [
     "en",
     "ko",
     "ja",
     "ar",
     "bg",
     "cs",
     "da",
     "de",
     "el",
     "es",
     "et",
     "fi",
     "fr",
     "hi",
     "hr",
     "hu",
     "id",
     "it",
     "lt",
     "lv",
     "nl",
     "pl",
     "pt",
     "ro",
     "ru",
     "sk",
     "sl",
     "sv",
     "tr",
     "uk",
     "vi"
    ],
    "type": "string"
   },
   "speed": {
    "description": "Speech speed, 0.7-2.0",
    "maximum": 2,
    "minimum": 0.7,
    "type": "number"
   },
   "steps": {
    "description": "Quality steps, 1-100",
    "maximum": 100,
    "minimum": 1,
