{"_meta":{"xdata.kr/credential":{"providers":["hometax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=hometax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: hometax__session__login (\uac19\uc740 account_link_id). preview \ub85c \ud655\uc778\ud55c \uc6d0\ucc9c\uc138 \uc804\uc790\ud30c\uc77c \ubcc0\ud658\uc2e0\uace0 \ub300\uc0c1\uc744 \uae30\uad00\uc5d0 \uc81c\ucd9c\ud569\ub2c8\ub2e4. \ub418\ub3cc\ub9b4 \uc218 \uc5c6\ub294 \uae30\uad00 \uc4f0\uae30\ub77c \uc0ac\uc6a9\uc790\uc758 \uc81c\ucd9c \ud655\uc778 confirm_submit \uacfc \ub3d9\uc758 sbms_agreement \ub97c \ud568\uaed8 \ubcf4\ub0b4\uc57c \ud558\uace0 confirm_submit \uc774 true \uc5ec\uc57c \uc81c\ucd9c\ub429\ub2c8\ub2e4. \ub0b4\uc6a9\uac80\uc99d \uacbd\uace0\uac00 \uc788\uc73c\uba74 confirm_warnings \ub3c4 true \uc5ec\uc57c \ud569\ub2c8\ub2e4. \ubbf8\ub9ac \ubcf8 \ub4a4 \ub300\uc0c1\uc774 \ubc14\ub00c\uc5c8\uc73c\uba74 \uc81c\ucd9c\ud558\uc9c0 \uc54a\uace0, \uc774\ubbf8 \ubaa8\ub450 \uc811\uc218\ub41c \ub300\uc0c1\uc774\uba74 \ub2e4\uc2dc \uc81c\ucd9c\ud558\uc9c0 \uc54a\uace0 \uc811\uc218 \uacb0\uacfc\ub97c \ub3cc\ub824\uc90d\ub2c8\ub2e4. \uacb0\uacfc\uac00 \ubd88\ubd84\uba85\ud558\uba74 \ub2e4\uc2dc \uc81c\ucd9c\ud558\uc9c0 \ub9d0\uace0 receipt \ub85c \uc811\uc218 \uc5ec\ubd80\ub97c \ud655\uc778\ud558\uc138\uc694. \uc774 \ub3c4\uad6c\ub294 \uae30\uad00\uc758 \uae30\ub85d\uc744 \ubc14\uafc9\ub2c8\ub2e4. \uccab \ud638\ucd9c\uc740 \uc2e4\ud589\ub418\uc9c0 \uc54a\uace0, \uc804\uc1a1\ud560 \ub0b4\uc6a9\uc758 \ubbf8\ub9ac\ubcf4\uae30\uc640 1\ud68c\uc6a9 confirmation_token \uc744 \ub3cc\ub824\uc90d\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uadf8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc0ac\uc6a9\uc790\uc5d0\uac8c \uadf8\ub300\ub85c \ubcf4\uc5ec \uc90d\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \ub3d9\uc758\ud55c \ub4a4\uc5d0\ub9cc \uac19\uc740 \uc778\uc790\uc5d0 \uadf8 confirmation_token \uc744 \ub354\ud574 \ub2e4\uc2dc \ud638\ucd9c\ud569\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uc758 \ub3d9\uc758 \uc5c6\uc774 \ud1a0\ud070\uc744 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc778\uc790\ub97c \ud558\ub098\ub77c\ub3c4 \ubc14\uafb8\uba74 \ud1a0\ud070\uc740 \ubb34\ud6a8\uac00 \ub429\ub2c8\ub2e4. \uadf8\ub54c\ub294 \ud1a0\ud070 \uc5c6\uc774 \ud638\ucd9c\ud574 \uc0c8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 5\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"confirm_submit":{"default":false,"description":"\ubcc0\ud658\uc2e0\uace0\uc11c\ub97c \uc2e4\uc81c\ub85c \uc81c\ucd9c\ud55c\ub2e4\ub294 \ud655\uc778\uac12\uc785\ub2c8\ub2e4. \ubbf8\ub9ac\ubcf4\uae30(preview) \uacb0\uacfc\ub97c \uc0ac\uc6a9\uc790\uc5d0\uac8c \ubcf4\uc5ec \uc8fc\uace0 \uc81c\ucd9c \ub3d9\uc758\ub97c \ubc1b\uc558\uc744 \ub54c true \ub85c \uc785\ub825\ud569\ub2c8\ub2e4. true \uac00 \uc544\ub2c8\uba74(\ube60\uc9c0\uac70\ub098 false) \uae30\uad00\uc5d0 \uc544\ubb34\uac83\ub3c4 \ubcf4\ub0b4\uc9c0 \uc54a\uace0 \uc2e0\uace0\uc11c \uc81c\ucd9c \ud655\uc778\uc774 \ud544\uc694\ud558\ub2e4\ub294 \uc624\ub958(422)\ub85c \uac70\uc808\ud569\ub2c8\ub2e4. \uc774 \uac12\ub3c4 \ud655\uc778 \ud1a0\ud070\uc774 \uac00\ub9ac\ud0a4\ub294 \uc694\uccad \ubcf8\ubb38\uc5d0 \ub4e4\uc5b4\uac00\ubbc0\ub85c \ud655\uc778 \ud1a0\ud070\uc744 \ubc1b\ub294 \uccab \uc694\uccad\ubd80\ud130 \ud568\uaed8 \uc785\ub825\ud569\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub354\ud558\uba74 \ubcf8\ubb38\uc774 \ub2ec\ub77c\uc838 \ud655\uc778 \ud1a0\ud070\uc744 \ub2e4\uc2dc \ubc1b\uc544\uc57c \ud569\ub2c8\ub2e4. 1 \uc774\ub098 yes, on \ucc98\ub7fc true \ub85c \uc77d\ud788\ub294 \uac12\ub3c4 true \ub85c \ubc1b\uace0, true \ub098 false \ub85c \uc77d\uc744 \uc218 \uc5c6\ub294 \uac12\uc740 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","title":"Confirm Submit","type":"boolean"},"confirm_warnings":{"default":false,"description":"\ub0b4\uc6a9\uac80\uc99d \uacbd\uace0\ub97c \ud655\uc778\ud588\ub2e4\ub294 \uac12\uc785\ub2c8\ub2e4. \ub0b4\uc6a9\uac80\uc99d\uc5d0\uc11c \uacbd\uace0\uac00 \ub098\uc628 \ubcc0\ud658\uc740 \uc774 \uac12\uc774 true \uc5ec\uc57c \uc81c\ucd9c\ud558\uace0, \uc544\ub2c8\uba74 \uae30\uad00\uc5d0 \uc544\ubb34\uac83\ub3c4 \ubcf4\ub0b4\uc9c0 \uc54a\uace0 \ub0b4\uc6a9\uac80\uc99d \uacbd\uace0\ub97c \ud655\uc778\ud574 \ub2ec\ub77c\ub294 \uc624\ub958(409)\ub85c \uac70\uc808\ud569\ub2c8\ub2e4. \uacbd\uace0\uac00 \uc5c6\ub294 \ubcc0\ud658\uc5d0\ub294 \ud544\uc694 \uc5c6\uc2b5\ub2c8\ub2e4. \uc774 \uac12\ub3c4 \ud655\uc778 \ud1a0\ud070\uc774 \uac00\ub9ac\ud0a4\ub294 \uc694\uccad \ubcf8\ubb38\uc5d0 \ub4e4\uc5b4\uac00\ubbc0\ub85c \ud655\uc778 \ud1a0\ud070\uc744 \ubc1b\ub294 \uccab \uc694\uccad\ubd80\ud130 \ud568\uaed8 \uc785\ub825\ud569\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub354\ud558\uba74 \ubcf8\ubb38\uc774 \ub2ec\ub77c\uc838 \ud655\uc778 \ud1a0\ud070\uc744 \ub2e4\uc2dc \ubc1b\uc544\uc57c \ud569\ub2c8\ub2e4. 1 \uc774\ub098 yes, on \ucc98\ub7fc true \ub85c \uc77d\ud788\ub294 \uac12\ub3c4 true \ub85c \ubc1b\uace0, true \ub098 false \ub85c \uc77d\uc744 \uc218 \uc5c6\ub294 \uac12\uc740 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","title":"Confirm Warnings","type":"boolean"},"confirmation_token":{"description":"\uccab \ud638\ucd9c\uc774 \ub3cc\ub824\uc900 1\ud68c\uc6a9 \ud655\uc778 \ud1a0\ud070\uc785\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uac19\uc740 \uc778\uc790\uc5d0 \uc774 \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc5b4 \ub2e4\uc2dc \ud638\ucd9c\ud558\uba74 \uc2e4\ud589\ub429\ub2c8\ub2e4. 10\ubd84 \ub4a4 \ub9cc\ub8cc\ub418\uace0 \ud55c \ubc88\ub9cc \uc4f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","type":"string"},"expected_snapshot_hash":{"description":"source_job_id \uc791\uc5c5 \uacb0\uacfc\uc758 snapshot_hash \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(\uc18c\ubb38\uc790 16\uc9c4\uc218 64\uc790\ub9ac). \uadf8 \uc791\uc5c5\uc758 \ub0b4\uc6a9\uacfc \ub9de\uc9c0 \uc54a\uc73c\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uc791\uc131 \ub0b4\uc6a9\uc774 \ubc14\ub00c\uc5c8\ub2e4\ub294 \uc624\ub958(409)\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^[0-9a-f]{64}$","title":"Expected Snapshot Hash","type":"string"},"sbms_agreement":{"default":false,"description":"\uc2e0\uace0 \ub0b4\uc6a9\uc5d0 \ub3d9\uc758\ud55c\ub2e4\ub294 \ud655\uc778\uac12\uc785\ub2c8\ub2e4. \uc694\uccad \uaddc\uaca9\uc5d0 \ud544\uc218 \uce78\uc73c\ub85c \uc801\ud600 \uc788\uc73c\ubbc0\ub85c \uc0ac\uc6a9\uc790\uc5d0\uac8c \ub3d9\uc758\ub97c \ubc1b\uc544 true \ub85c \uc785\ub825\ud569\ub2c8\ub2e4. \uc6d0\ucc9c\uc138 \ubcc0\ud658\uc2e0\uace0\ub294 \uc774 \uac12\uc774 true \uac00 \uc544\ub2c8\uc5b4\ub3c4 \uc81c\ucd9c\uc744 \uac70\uc808\ud558\uc9c0 \uc54a\uace0, \uae30\uad00\uc5d0 \ubcf4\ub0b4\uc9c0 \uc54a\uc73c\uba70 \uc751\ub2f5\uc758 submitUserAcknowledgements \uc5d0 \ubc1b\uc740 \uac12\uc744 \ub3cc\ub824\uc90d\ub2c8\ub2e4. \uc774 \uac12\ub3c4 \ud655\uc778 \ud1a0\ud070\uc774 \uac00\ub9ac\ud0a4\ub294 \uc694\uccad \ubcf8\ubb38\uc5d0 \ub4e4\uc5b4\uac00\ubbc0\ub85c \ud655\uc778 \ud1a0\ud070\uc744 \ubc1b\ub294 \uccab \uc694\uccad\ubd80\ud130 \ud568\uaed8 \uc785\ub825\ud569\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub354\ud558\uba74 \ubcf8\ubb38\uc774 \ub2ec\ub77c\uc838 \ud655\uc778 \ud1a0\ud070\uc744 \ub2e4\uc2dc \ubc1b\uc544\uc57c \ud569\ub2c8\ub2e4. 1 \uc774\ub098 yes, on \ucc98\ub7fc true \ub85c \uc77d\ud788\ub294 \uac12\ub3c4 true \ub85c \ubc1b\uace0, true \ub098 false \ub85c \uc77d\uc744 \uc218 \uc5c6\ub294 \uac12\uc740 \uc785\ub825 \uc624\ub958\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","title":"Sbms Agreement","type":"boolean"},"source_job_id":{"description":"\uc774\uc5b4\uc11c \uc9c4\ud589\ud560 \uc774\uc804 \ub2e8\uacc4 \uc791\uc5c5\uc758 job_id \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(job_ \uc73c\ub85c \uc2dc\uc791\ud558\ub294 \uc791\uc5c5 \ubc88\ud638). \ubbf8\ub9ac\ubcf4\uae30(preview) \uacb0\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ubbf8\ub9ac\ubcf4\uae30\ub97c \uac70\uce58\uc9c0 \uc54a\uc558\uac70\ub098 \uadf8 \ub4a4 \uc81c\ucd9c \ub300\uc0c1\uc774 \ubc14\ub00c\uc5c8\uc73c\uba74 409 \ub85c \uac70\uc808\ud569\ub2c8\ub2e4. \uac19\uc740 \uc870\uc9c1\uacfc \ud658\uacbd, \uac19\uc740 \uae30\uad00 \uc5f0\uacb0\uc5d0\uc11c \uc131\uacf5\ud55c \uc6d0\ucc9c\uc138 \ud30c\uc77c\ubcc0\ud658 \uc791\uc5c5\uc774\uc5b4\uc57c \ud558\uace0 \uc544\ub2c8\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^job_[0-9A-HJKMNP-TV-Z]{26}$","title":"Source Job Id","type":"string"}},"required":["source_job_id","expected_snapshot_hash","confirm_submit","sbms_agreement"],"title":"SubmitRequest","type":"object"},"name":"hometax__tax__withholding__file_conversion__submit","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\ud648\ud0dd\uc2a4 \uc6d0\ucc9c\uc138 \uc804\uc790\ud30c\uc77c \ubcc0\ud658\uc2e0\uace0 \uc81c\ucd9c"}
