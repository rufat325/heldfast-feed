    },
    "type": "array"
   },
   "calculationVersion": {
    "const": "1.0.0",
    "type": "string"
   },
   "documentationUrl": {
    "format": "uri",
    "type": "string"
   },
   "formulas": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "inputs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "metrics": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "type": "string"
      },
      "unit": {
       "type": "string"
      },
      "value": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "value",
      "unit",
      "label"
     ],
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "reproduceUrl": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "tool": {
    "enum": [
     "calculate_position_size",
     "calculate_net_risk_reward",
     "analyze_trade_performance"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "tool",
   "calculationVersion",
   "inputs",
   "metrics",
   "assumptions",
   "warnings",
   "formulas",
   "documentationUrl",
   "reproduceUrl"
  ],
  "type": "object"
 },
 "title": "Net risk/reward after fees"
}
