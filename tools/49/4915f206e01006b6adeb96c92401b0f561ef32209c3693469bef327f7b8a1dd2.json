  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare gross and fee-adjusted reward-to-risk, loss and profit per unit, and breakeven win rate for a linear trade with known entry, stop and target. Accepts distinct entry/stop/target fee percentages. Use for questions about a planned R ratio or how fees change it. Direction is derived from entry and stop. Does not fetch venue fees or predict execution, liquidation, or trade outcomes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "entryPrice": {
    "description": "Planned entry price in quote currency per base unit.",
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "number"
   },
   "fees": {
    "additionalProperties": false,
    "description": "User-supplied rates. Omission explicitly assumes zero fees; no exchange rate lookup is performed.",
    "properties": {
     "entryPercent": {
      "description": "Entry fee percent, e.g. 0.05 means 0.05%, not 5%.",
      "exclusiveMaximum": 100,
      "minimum": 0,
      "type": "number"
     },
     "stopPercent": {
      "description": "Stop exit fee percent, e.g. 0.05.",
      "exclusiveMaximum": 100,
      "minimum": 0,
      "type": "number"
     },
     "targetPercent": {
      "description": "Target exit fee percent; defaults to stopPercent.",
      "exclusiveMaximum": 100,
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "entryPercent",
     "stopPercent"
    ],
    "type": "object"
   },
   "instrumentType": {
    "const": "linear",
    "description": "Linear quote-margined instruments only. Inverse contracts and liquidation are unsupported.",
    "type": "string"
   },
   "quoteCurrency": {
    "description": "Currency shared by all monetary inputs. Defaults to USD; no currency conversion is performed.",
    "pattern": "^[A-Z][A-Z0-9]{1,9}$",
    "type": "string"
   },
   "stopPrice": {
    "description": "Planned stop price. Direction is derived from entry and stop.",
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "number"
   },
   "targetPrice": {
    "description": "Profit target price, opposite the stop relative to entry.",
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "number"
   }
  },
  "required": [
   "entryPrice",
   "stopPrice",
   "targetPrice"
  ],
  "type": "object"
 },
 "name": "calculate_net_risk_reward",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
