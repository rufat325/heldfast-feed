{
 "description": "Start a packet capture on the device using tcpdump. Requires root or tcpdump binary on device. Capture runs in background.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "filter": {
    "description": "tcpdump filter expression (e.g., 'port 443', 'host 10.0.0.1')",
    "type": "string"
   },
   "interface": {
    "default": "any",
    "description": "Network interface to capture (default: 'any')",
    "type": "string"
   },
   "maxPackets": {
    "description": "Stop after N packets (1-1000000, omit for continuous until stop)",
    "maximum": 1000000,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "adb_tcpdump_start"
}
