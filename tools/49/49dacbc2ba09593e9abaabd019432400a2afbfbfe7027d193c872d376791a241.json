{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List up to 100 table names by default (maximum 200). Filter by literal prefix, continue with nextAfter as after, or request statistics. Inspect columns and indexes with table.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "after": {
    "description": "nextAfter from the previous page; keep the same prefix.",
    "maxLength": 64,
    "type": "string"
   },
   "includeStats": {
    "description": "Include engine, row estimate and byte statistics; defaults to false.",
    "type": "boolean"
   },
   "limit": {
    "description": "Page size; defaults to 100.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "prefix": {
    "description": "Case-sensitive literal table-name prefix; % and _ are not wildcards.",
    "maxLength": 64,
    "type": "string"
   },
   "table": {
    "pattern": "^[A-Za-z0-9_]+$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "mysql_schema",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "nextAfter": {
      "type": [
       "string",
       "null"
      ]
     },
     "tables": {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "tables",
     "hasMore",
     "nextAfter"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "columns": {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     "indexes": {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     "table": {
      "type": "string"
     }
    },
    "required": [
     "table",
     "columns",
     "indexes"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Inspect WordPress schema"
}
