{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update an existing task's fields by UID. Uses CalDAV ETag-based optimistic concurrency.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "calendarName": {
    "default": "tasks",
    "description": "The calendar name (default: 'tasks')",
    "type": "string"
   },
   "categories": {
    "description": "Replace all tags with these",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "classification": {
    "description": "New classification",
    "enum": [
     "PUBLIC",
     "PRIVATE",
     "CONFIDENTIAL"
    ],
    "type": "string"
   },
   "description": {
    "description": "New description",
    "type": "string"
   },
   "dtstart": {
    "description": "New start date, or null to remove",
    "type": [
     "string",
     "null"
    ]
   },
   "due": {
    "description": "New due date (YYYYMMDD or YYYYMMDDTHHmmssZ), or null to remove",
    "type": [
     "string",
     "null"
    ]
   },
   "location": {
    "description": "New location, or null to remove",
    "type": [
     "string",
     "null"
    ]
   },
   "percentComplete": {
    "description": "New completion percentage",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "pinned": {
    "description": "Pin or unpin the task",
    "type": "boolean"
   },
   "priority": {
    "description": "New priority (0-9, 0 removes priority)",
    "maximum": 9,
    "minimum": 0,
    "type": "number"
   },
   "relatedTo": {
    "description": "New parent UID, or null to remove parent",
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "description": "New status",
    "enum": [
     "NEEDS-ACTION",
     "IN-PROCESS",
     "COMPLETED",
     "CANCELLED"
    ],
    "type": "string"
   },
   "summary": {
    "description": "New task title",
    "type": "string"
   },
   "uid": {
    "description": "The UID of the task to update",
    "type": "string"
   },
   "url": {
    "description": "New URL, or null to remove",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "uid"
  ],
  "type": "object"
 },
 "name": "update_task",
 "title": "Update Task"
}
