{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Record an approved plan in one call: saves the plan markdown as a document under plans/, then creates each epic and its tasks in order. Use right after the human approves a plan (for example when leaving plan mode) if it has 3 or more tasks. You do the breakdown; Beck does not re-plan it.",
 "inputSchema": {
  "properties": {
   "epics": {
    "description": "Epics in order. Each groups related tasks.",
    "items": {
     "properties": {
      "color": {
       "description": "Hex color, e.g. #7aa2f7",
       "type": "string"
      },
      "description": {
       "description": "One or two sentences shown in lists",
       "type": "string"
      },
      "destination": {
       "enum": [
        "backlog",
        "icebox"
       ],
       "type": "string"
      },
      "spec": {
       "description": "Optional longer markdown spec for this epic",
       "type": "string"
      },
      "tasks": {
       "items": {
        "properties": {
         "acceptanceCriteria": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "description": {
          "description": "Markdown",
          "type": "string"
         },
         "points": {
          "type": "number"
         },
         "tags": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "title": {
          "type": "string"
         },
         "type": {
          "enum": [
           "feature",
           "bug",
           "chore"
          ],
          "type": "string"
         }
        },
        "required": [
         "title"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "tasks"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "path": {
    "description": "Document path. Defaults to plans/<slug of title>. An existing page at that path is overwritten.",
    "type": "string"
   },
   "plan": {
    "description": "The approved plan as markdown",
    "type": "string"
   },
   "title": {
    "description": "Plan title, e.g. 'Agent loop'",
    "type": "string"
   },
   "workspaceId": {
    "description": "Optional when this repo is bound to a workspace (bind_workspace).",
    "type": "string"
   }
  },
  "required": [
   "title",
   "plan",
   "epics"
  ],
  "type": "object"
 },
 "name": "record_plan"
}
