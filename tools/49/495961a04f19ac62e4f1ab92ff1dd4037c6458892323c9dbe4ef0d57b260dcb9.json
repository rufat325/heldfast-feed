{
 "description": "Generate a QR code as PNG or SVG from text or a URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "background": {
    "description": "Background color (e.g. \"#ffffff\")",
    "type": "string"
   },
   "errorCorrection": {
    "description": "Error correction level",
    "enum": [
     "L",
     "M",
     "Q",
     "H"
    ],
    "type": "string"
   },
   "foreground": {
    "description": "Foreground color (e.g. \"#000000\")",
    "type": "string"
   },
   "format": {
    "description": "Output format (default: png)",
    "enum": [
     "png",
     "svg"
    ],
    "type": "string"
   },
   "margin": {
    "description": "Quiet zone margin",
    "minimum": 0,
    "type": "number"
   },
   "size": {
    "description": "Size in pixels",
    "minimum": 1,
    "type": "number"
   },
   "text": {
    "description": "Text or URL to encode",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "bytario_qr_generate"
}
