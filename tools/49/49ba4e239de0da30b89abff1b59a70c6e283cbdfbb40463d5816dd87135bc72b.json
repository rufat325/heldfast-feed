{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit a dine-in or takeaway order from a published restaurant facade menu. Creates a PENDING order; kitchen confirms in Dashboard. Restaurant facades only; menu item names must match facade.menu. HTTP equivalent: POST /api/v1/b/{handle}/orders.",
 "inputSchema": {
  "properties": {
   "fulfillmentMode": {
    "description": "Defaults to DINE_IN",
    "enum": [
     "DINE_IN",
     "TAKEAWAY",
     "PICKUP"
    ],
    "type": "string"
   },
   "guestName": {
    "description": "Guest name (required for takeaway/pickup)",
    "type": "string"
   },
   "guestPhone": {
    "description": "Guest phone (required for takeaway/pickup)",
    "type": "string"
   },
   "handle": {
    "description": "Public facade handle (AgentID)",
    "type": "string"
   },
   "items": {
    "description": "Menu lines \u2014 names must match published facade menu",
    "items": {
     "properties": {
      "currency": {
       "description": "Optional currency echo from menu",
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "price": {
       "description": "Optional display price echo from menu",
       "type": "string"
      },
      "qty": {
       "maximum": 40,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "name",
      "qty"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "description": "Optional note for the kitchen",
    "type": "string"
   },
   "table": {
    "description": "Table code from facade.tables, or TAKEAWAY / PICKUP for off-premise",
    "type": "string"
   }
  },
  "required": [
   "handle",
   "table",
   "items"
  ],
  "type": "object"
 },
 "name": "create_order"
}
