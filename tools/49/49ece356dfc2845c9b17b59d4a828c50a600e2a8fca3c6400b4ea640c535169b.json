{
 "description": "Buy an item from the Northside Intelligence Smart Store (US shipping). Card payment and shipping details are collected on Stripe checkout; returns checkout_url and order_id.",
 "inputSchema": {
  "properties": {
   "item_sku": {
    "description": "Product SKU",
    "type": "string"
   },
   "quantity": {
    "default": 1,
    "type": "integer"
   },
   "shipping_address": {
    "properties": {
     "city": {
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "postal_code": {
      "type": "string"
     },
     "state": {
      "type": "string"
     },
     "street": {
      "type": "string"
     }
    },
    "required": [
     "street",
     "city",
     "state",
     "postal_code",
     "country"
    ],
    "type": "object"
   }
  },
  "required": [
   "item_sku",
   "quantity",
   "shipping_address"
  ],
  "type": "object"
 },
 "name": "ni_store_order"
}
