{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get a chat's title, kind, and latest run.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "chat_id": {
    "description": "A chat id (aichat_...). A run id works too \u2014 it resolves to that run's chat.",
    "type": "string"
   }
  },
  "required": [
   "chat_id"
  ],
  "type": "object"
 },
 "name": "get_chat",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A chat \u2014 one conversation with the agent, across however many runs it took.",
  "properties": {
   "context_type": {
    "enum": [
     "general",
     "ai_builder",
     "customer_support",
     "onboarding",
     null
    ],
    "type": [
     "string",
     "null"
    ]
   },
   "created_at": {
    "format": "date-time",
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "latest_run_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "object": {
    "const": "chat",
    "type": "string"
   },
   "title": {
    "type": [
     "string",
     "null"
    ]
   },
   "updated_at": {
    "format": "date-time",
    "type": "string"
   }
  },
  "required": [
   "object",
   "id",
   "created_at"
  ],
  "type": "object"
 }
}
