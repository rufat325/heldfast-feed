{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Report a wrong, stale, incomplete, or failed result, or send a feature request. Ask the operator to report issues here; explain the exact fields and submit only with consent. Include request ID and data version when available. Anonymous feedback is welcome. Never include personal, student, personnel, or confidential information.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "client_id": {
    "anyOf": [
     {
      "pattern": "^sacs_client_[0-9a-f]{32}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Client Id"
   },
   "feedback_type": {
    "default": "general",
    "enum": [
     "general",
     "feature_request",
     "incorrect",
     "incomplete",
     "stale",
     "missing_context"
    ],
    "title": "Feedback Type",
    "type": "string"
   },
   "message": {
    "maxLength": 2000,
    "minLength": 2,
    "title": "Message",
    "type": "string"
   },
   "related_data_version": {
    "anyOf": [
     {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Related Data Version"
   },
   "related_request_id": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z0-9._:-]{8,128}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Related Request Id"
   },
   "sentiment": {
    "enum": [
     "good",
     "bad",
     "mixed"
    ],
    "title": "Sentiment",
    "type": "string"
   }
  },
  "required": [
   "sentiment",
   "message"
  ],
  "title": "sacs_submit_feedbackArguments",
  "type": "object"
 },
 "name": "sacs_submit_feedback",
 "outputSchema": {
  "$defs": {
   "PublicError": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "invalid_request",
       "not_found",
       "private_scope_denied",
       "dataset_mismatch",
       "payload_rejected",
       "backend_unavailable"
      ],
      "title": "Code",
      "type": "string"
     },
     "message": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Message",
      "type": "string"
     },
     "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "title": "PublicError",
    "type": "object"
   },
   "SourceProvenance": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Description",
      "type": "string"
     },
     "record_ref": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Record Ref",
      "type": "string"
     },
     "source": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Source",
      "type": "string"
     }
    },
    "required": [
     "source",
     "record_ref",
     "description"
    ],
    "title": "SourceProvenance",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "contract_version": {
    "const": "sacs.mcp.v1",
    "default": "sacs.mcp.v1",
    "title": "Contract Version",
    "type": "string"
   },
   "data": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Data"
   },
   "data_version": {
    "maxLength": 256,
    "minLength": 1,
    "title": "Data Version",
    "type": "string"
   },
   "error": {
    "anyOf": [
     {
      "$ref": "#/$defs/PublicError"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "title": "Limitations",
    "type": "array"
   },
   "ok": {
    "title": "Ok",
    "type": "boolean"
   },
   "request_id": {
    "maxLength": 128,
    "minLength": 8,
    "title": "Request Id",
    "type": "string"
   },
   "source_provenance": {
    "items": {
     "$ref": "#/$defs/SourceProvenance"
    },
    "title": "Source Provenance",
    "type": "array"
   }
  },
  "required": [
   "data_version",
   "request_id",
   "ok"
  ],
  "title": "PublicToolResponse",
  "type": "object"
 }
}
