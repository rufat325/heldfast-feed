{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Deterministically grades a redacted set of tracker-request observations by consent phase. It computes from the supplied data only, stores nothing, and returns a technical\u2014not legal\u2014interpretation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "consentBannerPresent": {
    "type": "boolean"
   },
   "domain": {
    "maxLength": 300,
    "minLength": 3,
    "type": "string"
   },
   "observations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "phase": {
       "enum": [
        "before_consent",
        "after_reject",
        "after_accept",
        "unknown"
       ],
       "type": "string"
      },
      "requestCount": {
       "maximum": 100000,
       "minimum": 0,
       "type": "integer"
      },
      "tracker": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "^[\\w .()+/&-]+$",
       "type": "string"
      },
      "typedValueTransmitted": {
       "type": "boolean"
      }
     },
     "required": [
      "tracker",
      "phase",
      "requestCount",
      "typedValueTransmitted"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "domain",
   "consentBannerPresent",
   "observations"
  ],
  "type": "object"
 },
 "name": "interpret_consent_evidence",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "disclaimer": {
    "type": "string"
   },
   "domain": {
    "type": "string"
   },
   "evidenceGrade": {
    "enum": [
     "direct",
     "strong",
     "limited",
     "none"
    ],
    "type": "string"
   },
   "observedAfterReject": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "observedBeforeConsent": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recommendedNextStep": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "typedValueTransmissionObserved": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "unresolvedTrackers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "domain",
   "evidenceGrade",
   "observedBeforeConsent",
   "observedAfterReject",
   "typedValueTransmissionObserved",
   "unresolvedTrackers",
   "summary",
   "recommendedNextStep",
   "disclaimer"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Interpret consent evidence"
}
