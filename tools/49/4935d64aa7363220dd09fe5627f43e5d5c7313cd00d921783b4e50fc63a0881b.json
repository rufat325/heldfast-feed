{
 "description": "[Wicked Registry] File a complaint about a tool's reliability or behaviour. Public, rate-limited; reviewed manually, never auto-suspends.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "evidence": {
    "description": "Optional note or URL.",
    "type": "string"
   },
   "reason": {
    "description": "\"downtime\", \"incorrect_response\", \"scam_or_abuse\", \"schema_violation\" or \"other\".",
    "type": "string"
   },
   "reporter": {
    "description": "Your wallet address or another best-effort identifier.",
    "type": "string"
   },
   "tool_id": {
    "description": "The tool's Wicked Registry id.",
    "type": "string"
   }
  },
  "required": [
   "tool_id",
   "reporter",
   "reason"
  ],
  "type": "object"
 },
 "name": "registry_report_tool"
}
