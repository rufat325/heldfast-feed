{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:ads"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a standalone campaign"
 },
 "description": "Create an advertising campaign in the selected connected ad account with the supplied campaign settings. Quote first by calling without confirm:true. Show the returned spending preview and obtain owner approval before confirming with the same requestId. Retain that requestId for soclo_ads_operation_status after an uncertain result; never automatically repeat a purchase. Report the returned status without claiming the ad is live until active. Confirmed creation requests active status, except Google Performance Max and Demand Gen campaigns, which are created paused. Full field guide: soclo://tools/soclo_ads_create_ad_campaign.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "type": "object"
   },
   "payload": {
    "properties": {
     "bidAmount": {
      "type": "number"
     },
     "bidStrategy": {
      "enum": [
       "LOWEST_COST_WITHOUT_CAP",
       "LOWEST_COST_WITH_BID_CAP",
       "COST_CAP",
       "LOWEST_COST_WITH_MIN_ROAS"
      ],
      "type": "string"
     },
     "budgetAmount": {
      "type": "number"
     },
     "budgetType": {
      "enum": [
       "daily",
       "lifetime"
      ],
      "type": "string"
     },
     "buyingType": {
      "enum": [
       "AUCTION",
       "RESERVED"
      ],
      "type": "string"
     },
     "goal": {
      "enum": [
       "engagement",
       "traffic",
       "awareness",
       "video_views",
       "lead_generation",
       "lead_conversion",
       "job_applicants",
       "conversions",
       "app_promotion",
       "catalog_sales",
       "page_likes",
       "page_visits"
      ],
      "type": "string"
     },
     "isSkadnetworkAttribution": {
      "type": "boolean"
     },
     "locationTargetingType": {
      "description": "Google only (400 elsewhere). Written on the new campaign.",
      "enum": [
       "presence",
       "presence_or_interest"
      ],
      "type": "string"
     },
     "manualCpc": {
      "additionalProperties": false,
      "properties": {
       "maxCpc": {
        "type": "number"
       }
      },
      "required": [
       "maxCpc"
      ],
      "type": "object"
     },
     "name": {
      "maxLength": 255,
      "type": "string"
     },
     "networkSettings": {
      "additionalProperties": false,
      "properties": {
       "displayNetwork": {
        "type": "boolean"
       },
       "searchPartners": {
        "description": "campaign.network_settings.target_search_network",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "portfolioBidStrategyId": {
      "pattern": "^\\d+$",
      "type": "string"
     },
     "promotedObject": {
      "additionalProperties": false,
      "properties": {
       "applicationId": {
        "description": "App ID. Required for `goal: app_promotion`.",
        "type": "string"
       },
       "customConversionId": {
        "type": "string"
       },
       "customEventStr": {
        "type": "string"
       },
       "customEventType": {
        "type": "string"
       },
       "objectStoreUrl": {
        "type": "string"
       },
       "offlineConversionDataSetId": {
        "type": "string"
       },
       "pageId": {
        "type": "string"
       },
       "pixelId": {
        "type": "string"
       },
       "productCatalogId": {
        "type": "string"
       },
       "productSetId": {
        "type": "string"
       },
       "whatsappPhoneNumber": {
        "description": "Meta only. WhatsApp number on messaging-destination ad sets.",
        "type": "string"
       }
      },
      "type": "object"
     },
     "roasAverageFloor": {
      "type": "number"
     },
     "specialAdCategories": {
      "items": {
       "enum": [
        "HOUSING",
        "EMPLOYMENT",
        "CREDIT",
        "ISSUES_ELECTIONS_POLITICS",
        "FINANCIAL_PRODUCTS_SERVICES",
        "ONLINE_GAMBLING_AND_GAMING"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "status": {
      "enum": [
       "ACTIVE",
       "PAUSED"
      ],
      "type": "string"
     },
     "targetImpressionShare": {
      "properties": {
       "location": {
        "enum": [
         "ANYWHERE_ON_PAGE",
         "TOP_OF_PAGE",
         "ABSOLUTE_TOP_OF_PAGE"
        ],
        "type": "string"
       },
       "maxCpc": {
        "type": "number"
       },
       "percent": {
        "maximum": 100,
        "type": "number"
       }
      },
      "required": [
       "location",
       "percent",
       "maxCpc"
      ],
      "type": "object"
     },
     "validateOnly": {
      "type": "boolean"
     }
    },
    "required": [
     "name",
     "goal"
    ],
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "payload"
  ],
  "type": "object"
 },
 "name": "soclo_ads_create_ad_campaign",
 "title": "Create a standalone campaign"
}
