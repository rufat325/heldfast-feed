{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Record a suggested change. This does not change the invoice. kind add_line requires description, quantity, rateMinor, and unit. kind change_rate requires lineId and rateMinor. kind apply_discount requires discountKind, discountValue, and discountNote. kind move_due_date requires dueOn. kind adjust_quantity requires lineId and quantity. kind revise_late_terms requires graceDays, lateBasis, feeMinor, latePercent, and lateNote.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "discountKind": {
    "enum": [
     "none",
     "percent",
     "fixed"
    ],
    "type": "string"
   },
   "discountNote": {
    "$ref": "#/properties/summary"
   },
   "discountValue": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "integer"
   },
   "dueOn": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "feeMinor": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "integer"
   },
   "graceDays": {
    "maximum": 365,
    "minimum": 0,
    "type": "integer"
   },
   "invoiceId": {
    "format": "uuid",
    "type": "string"
   },
   "kind": {
    "enum": [
     "add_line",
     "change_rate",
     "apply_discount",
     "move_due_date",
     "adjust_quantity",
     "revise_late_terms"
    ],
    "type": "string"
   },
   "lateBasis": {
    "enum": [
     "none",
     "flat_fee",
     "percent_per_period"
    ],
    "type": "string"
   },
   "lateNote": {
    "$ref": "#/properties/summary"
   },
   "latePercent": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "lineId": {
    "$ref": "#/properties/invoiceId"
   },
   "quantity": {
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "rateMinor": {
    "maximum": 100000000,
    "minimum": 1,
    "type": "integer"
   },
   "summary": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "unit": {
    "enum": [
     "hour",
     "each",
     "day"
    ],
    "type": "string"
   }
  },
  "required": [
   "invoiceId",
   "kind",
   "summary"
  ],
  "type": "object"
 },
 "name": "suggest_invoice_change",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "suggest invoice change"
}
