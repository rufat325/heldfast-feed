{
 "description": "Convert Virtual Address (VA) to File Offset, or File Offset to VA",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Conversion direction",
    "enum": [
     "va_to_file",
     "file_to_va"
    ],
    "type": "string"
   },
   "address": {
    "description": "Virtual address (required for va_to_file)",
    "type": "string"
   },
   "module": {
    "description": "Module name (required for file_to_va)",
    "type": "string"
   },
   "offset": {
    "description": "File offset hex (required for file_to_va)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "x64dbg_address_convert"
}
