{
 "description": "Create a signed promotion review for another agent. Reviewer must have 'earned' origin and tier above target. Returns signed review artifact.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentId": {
    "description": "Agent being reviewed for promotion",
    "type": "string"
   },
   "principalId": {
    "description": "Principal who delegated to the agent",
    "type": "string"
   },
   "probationDays": {
    "description": "Probation period in days (default: 7)",
    "type": "number"
   },
   "reasoning": {
    "description": "Explanation for the verdict",
    "type": "string"
   },
   "scope": {
    "description": "Scope of the promotion",
    "type": "string"
   },
   "toTier": {
    "description": "Target tier level (0-4)",
    "type": "number"
   },
   "verdict": {
    "description": "Promotion verdict",
    "enum": [
     "promoted",
     "denied"
    ],
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "principalId",
   "scope",
   "toTier",
   "verdict",
   "reasoning"
  ],
  "type": "object"
 },
 "name": "review_promotion"
}
