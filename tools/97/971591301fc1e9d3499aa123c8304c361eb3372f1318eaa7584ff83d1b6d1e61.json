 "description": "Pre-trade risk check gated by an x402 payment. Evaluated as COLR\nTier 2: $25,000 notional ceiling, 10/25 per-minute rate limits.\nNo COLR holdings are required \u2014 the on-chain payment is the\ncredential.\n\nFLOW\n----\n1. Call WITHOUT payment_proof \u2192 the tool returns a\n   `PaymentRequiredOutput` describing the on-chain payment\n   (network, asset, amount, payTo, resource).\n2. Settle the payment on-chain using an x402-capable client. The\n   facilitator returns a proof string.\n3. Call again with `payment_proof=<proof>` \u2192 the tool forwards the\n   proof to the guardrail's x402-paid endpoint and returns a full\n   `EvaluateTradeOutput` with `tier=2`.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Quantity in token units.",
    "type": "number"
   },
   "asset": {
    "description": "Asset symbol, e.g. NVDA, AAPL, TSLA, USDG.",
    "type": "string"
   },
   "contract_address": {
    "description": "Token contract address (0x...).",
    "type": "string"
   },
   "max_slippage_bps": {
    "default": 100,
    "description": "Max slippage in basis points (default 100).",
    "type": "integer"
   },
   "payment_proof": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "x402 payment proof from the facilitator. Omit\non the first call to receive the payment challenge."
   },
   "request_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional idempotency key."
   },
   "side": {
    "description": "\"buy\" or \"sell\".",
    "type": "string"
   },
   "wallet": {
    "description": "EVM wallet address (0x...) the trade would execute from.",
    "type": "string"
   }
  },
  "required": [
   "wallet",
   "asset",
   "contract_address",
   "side",
   "amount"
  ],
  "type": "object"
 },
