{
 "annotations": {
  "readOnlyHint": true,
  "title": "Retention report"
 },
 "description": "Cohort retention: of users who did `born_event`, how many came back and did `event` over subsequent intervals. Query API: GET /retention.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "born_event": {
    "description": "The defining first event for a birth cohort. Required when retention_type=birth.",
    "type": "string"
   },
   "born_where": {
    "description": "Filter expression applied to born_event.",
    "type": "string"
   },
   "event": {
    "description": "Returning event to measure. If omitted, any event counts.",
    "type": "string"
   },
   "from_date": {
    "description": "Start date yyyy-mm-dd (inclusive).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "interval": {
    "description": "Units per bucket (<=90 if days). Default 1.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "interval_count": {
    "description": "Number of intervals to report.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "retention_type": {
    "description": "birth = first-time retention (default), compounded = recurring.",
    "enum": [
     "birth",
     "compounded"
    ],
    "type": "string"
   },
   "to_date": {
    "description": "End date yyyy-mm-dd (inclusive).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "unit": {
    "description": "Interval unit. Default day.",
    "enum": [
     "day",
     "week",
     "month"
    ],
    "type": "string"
   },
   "where": {
    "description": "Filter expression applied to the returning event.",
    "type": "string"
   }
  },
  "required": [
   "from_date",
   "to_date"
  ],
  "type": "object"
 },
 "name": "mixpanel_retention",
 "title": "Retention report"
}
