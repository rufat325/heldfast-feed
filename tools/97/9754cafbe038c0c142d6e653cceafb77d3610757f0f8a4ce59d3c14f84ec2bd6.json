{
 "description": "Gestiona eventos de calendario. Acciones: list (page, limit, date_from, date_to, search, include_recurring), get (id), create, update (id), delete (id).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete"
    ],
    "type": "string"
   },
   "client_id": {
    "type": "number"
   },
   "color": {
    "type": "string"
   },
   "date_from": {
    "description": "Filtro fecha inicio (YYYY-MM-DD)",
    "type": "string"
   },
   "date_to": {
    "description": "Filtro fecha fin (YYYY-MM-DD)",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "end_date": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "end_time": {
    "description": "HH:mm:ss",
    "type": "string"
   },
   "id": {
    "description": "ID del evento (requerido para get, update, delete)",
    "type": "number"
   },
   "include_recurring": {
    "description": "Incluir eventos recurrentes",
    "type": "boolean"
   },
   "labels": {
    "type": "string"
   },
   "limit": {
    "default": 50,
    "type": "number"
   },
   "location": {
    "type": "string"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "recurring": {
    "type": "number"
   },
   "recurring_type": {
    "type": "string"
   },
   "recurring_value": {
    "type": "number"
   },
   "reminder_type": {
    "type": "string"
   },
   "reminder_value": {
    "type": "number"
   },
   "search": {
    "type": "string"
   },
   "share_with": {
    "type": "string"
   },
   "start_date": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "start_time": {
    "description": "HH:mm:ss",
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "events"
}
