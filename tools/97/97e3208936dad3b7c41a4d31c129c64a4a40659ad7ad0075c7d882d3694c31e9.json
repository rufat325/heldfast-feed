{
 "description": "Returns expected return, risk, Sharpe ratio, value at risk, diversification, and a per-holding breakdown for a basket of symbols at the supplied weights, without optimizing.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "budget": {
    "description": "Optional budget used to value shares and market values. Weights are budget-independent. Defaults to 10000.",
    "type": "number"
   },
   "days": {
    "description": "Optional trailing time window in days, from 30 to 720. Defaults to 90.",
    "type": "number"
   },
   "symbols": {
    "description": "List of at least 2 and at most 25 ticker or Macroaxis symbol identifiers.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "weights": {
    "description": "Optional weights aligned to the symbols order, for example [40, 35, 25]. Values are normalized; defaults to equal weight.",
    "items": {
     "type": "number"
    },
    "type": "array"
   }
  },
  "required": [
   "symbols"
  ],
  "type": "object"
 },
