{
 "description": "WRITE (BULK): Update `bid_amount` on many ad sets in one Batch API call. Input is an array of {adset_id, bid_amount_cents} pairs. Bid values are in minor currency units (cents). Chunks of 50 automatically.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "updates": {
    "description": "Array of {adset_id, bid_amount_cents} to apply",
    "items": {
     "additionalProperties": false,
     "properties": {
      "adset_id": {
       "type": "string"
      },
      "bid_amount_cents": {
       "exclusiveMinimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "adset_id",
      "bid_amount_cents"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "updates"
  ],
  "type": "object"
 },
 "name": "update_bids_batch"
}
