{"_meta":{"finalpos.com/pack":"customers","finalpos.com/provider":"hub"},"annotations":{"destructiveHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Update customer"},"description":"Change contact details on an existing customer. Takes the customer ID from get_customers, never a name. Only the fields you pass are changed, but an address you pass REPLACES the stored one whole \u2014 read it back with get_customer first and resend the parts that should stay. Notes are not editable here: use add_customer_note.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"billing":{"description":"Replaces the stored billing address","properties":{"address1":{"description":"Street address, e.g. \"123 Main St\"","type":"string"},"address2":{"description":"Apartment, suite, unit","type":"string"},"city":{"type":"string"},"country":{"description":"Country, e.g. \"US\"","type":"string"},"postCode":{"description":"ZIP / postal code","type":"string"},"state":{"type":"string"}},"type":"object"},"customerId":{"description":"Customer id from get_customers \u2014 not a name","minLength":1,"type":"string"},"email":{"format":"email","pattern":"^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"firstName":{"type":"string"},"lastName":{"type":"string"},"phone":{"type":"string"},"shipping":{"description":"Replaces the stored shipping address","properties":{"address1":{"description":"Street address, e.g. \"123 Main St\"","type":"string"},"address2":{"description":"Apartment, suite, unit","type":"string"},"city":{"type":"string"},"country":{"description":"Country, e.g. \"US\"","type":"string"},"postCode":{"description":"ZIP / postal code","type":"string"},"state":{"type":"string"}},"type":"object"}},"required":["customerId"],"type":"object"},"name":"hub_update_customer","title":"Update customer"}
