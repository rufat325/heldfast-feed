{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Move a file to a different folder by changing its parents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "addParents": {
    "description": "Folder IDs to add as parents (where to move the file)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "fileId": {
    "description": "The ID of the file to move",
    "type": "string"
   },
   "removeParents": {
    "description": "Folder IDs to remove as parents (current locations)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "supportsAllDrives": {
    "default": true,
    "description": "Support shared drives",
    "type": "boolean"
   }
  },
  "required": [
   "fileId",
   "addParents"
  ],
  "type": "object"
 },
 "name": "file_move",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "id": {
    "type": "string"
   },
   "mimeType": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "parents": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "name",
   "mimeType"
  ],
  "type": "object"
 },
 "title": "Move file"
}
