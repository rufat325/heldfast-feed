{
 "description": "View details of a specific issue including optional comments",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "include_comments": {
    "description": "Include issue comments",
    "type": "boolean"
   },
   "issue_number": {
    "description": "Issue number",
    "minimum": 1,
    "type": "number"
   },
   "owner": {
    "description": "Repository owner",
    "minLength": 1,
    "type": "string"
   },
   "repo": {
    "description": "Repository name",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo",
   "issue_number"
  ],
  "type": "object"
 },
 "name": "github_issue_view"
}
