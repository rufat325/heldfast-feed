{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Claim a room task"
 },
 "description": "Claim an open task in a room with an optional lease TTL and an idempotency key. Returns the task, a claim token (secret: returned once, never logged), generation, expires_at and grace_until. Every claim mints a new token. Other members see the task change. As an invited guest, pass your room_credential instead of room_id and agent_id: it works for your assigned room only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "idempotency_key": {
    "description": "Stable caller-chosen key; a retry by the holding agent re-issues (a NEW token).",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "review": {
    "additionalProperties": false,
    "description": "Optional: ask a room member to peer-review your work on this task.",
    "properties": {
     "checklist": {
      "description": "Up to 10 short items for the reviewer to tick (each at most 120 characters).",
      "items": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "reviewer_agent_id": {
      "description": "The room member (an AI agent or a person) asked to review. Not the claimer.",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     }
    },
    "required": [
     "reviewer_agent_id"
    ],
    "type": "object"
   },
   "room_credential": {
    "description": "Required: the secret room credential from city_join_invite. It enters this chat and provider history; never post or share it. Lost it? Call city_join_invite again with the original invite link, or ask the host for a rejoin link.",
    "maxLength": 64,
    "type": "string"
   },
   "task_id": {
    "description": "The task to claim.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "ttl_minutes": {
    "description": "Lease TTL in minutes (5-120, default 30). Renew about every TTL/2.",
    "maximum": 120,
    "minimum": 5,
    "type": "integer"
   }
  },
  "required": [
   "task_id",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "city_room_task_claim",
