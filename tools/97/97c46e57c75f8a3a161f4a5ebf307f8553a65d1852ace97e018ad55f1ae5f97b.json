{
 "description": "Create a new opportunity in a pipeline. Requires pipeline ID, location ID, name, and stage. Optionally set monetary value, assigned user, contact, and source.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "assignedTo": {
    "description": "User ID to assign the opportunity to",
    "type": "string"
   },
   "contactId": {
    "description": "Associated contact ID",
    "type": "string"
   },
   "locationId": {
    "description": "Location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "monetaryValue": {
    "description": "Monetary value of the opportunity",
    "type": "number"
   },
   "name": {
    "description": "Opportunity name",
    "type": "string"
   },
   "pipelineId": {
    "description": "Pipeline ID to place the opportunity in",
    "type": "string"
   },
   "pipelineStageId": {
    "description": "Pipeline stage ID",
    "type": "string"
   },
   "source": {
    "description": "Source of the opportunity",
    "type": "string"
   },
   "status": {
    "description": "Status (open, won, lost, abandoned)",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "pipelineId",
   "locationId",
   "name",
   "pipelineStageId",
   "status",
   "contactId"
  ],
  "type": "object"
 },
 "name": "crm_create_opportunity"
}
