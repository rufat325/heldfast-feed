{
 "description": "Create a TestChimp issue in the current project. title is required. Use simple fields for common creates, or pass the full curated contract via --json-input (description, issueType, category, severity, status, reportedReleaseId, dueDateMillis, assignee, linkTargets, labels, source, environment, attachments, artifactReference). For /testchimp implement TASK_ISSUE creates: set labels=[\"TestChimp Implement\"] (not source), severity from task priority, category (e.g. FUNCTIONAL), and linkTargets for STORY and/or SCENARIO ordinals. Optional agentTraceability (or flat workflowId/workflowExecutionId/policyFile/\u2026) records CREATED Activity inline \u2014 prefer this over a separate report-agent-action for issue creates. For Activity/timeline attachment both workflowId and workflowExecutionId (stable Plan ULID) are required; do not omit workflowExecutionId or mint a new ULID per issue. Authenticated via project API key; project is resolved from the key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actorType": {
    "enum": [
     "LOCAL_AGENT",
     "CLOUD_AGENT",
     "local-agent",
     "cloud-agent"
    ],
    "type": "string"
   },
   "agentModel": {
    "type": "string"
   },
   "agentTraceability": {
    "additionalProperties": false,
    "properties": {
     "actorType": {
      "enum": [
       "LOCAL_AGENT",
       "CLOUD_AGENT",
       "local-agent",
       "cloud-agent"
      ],
      "type": "string"
     },
     "agentModel": {
      "type": "string"
     },
     "branchName": {
      "type": "string"
     },
     "cliVersion": {
      "type": "string"
     },
     "gitSha": {
      "type": "string"
     },
     "policyFile": {
      "type": "string"
     },
     "policyVersion": {
      "type": "string"
     },
     "skillVersion": {
      "type": "string"
     },
     "userId": {
      "type": "string"
     },
     "workflowExecutionId": {
      "type": "string"
     },
     "workflowId": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "artifactReference": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "assignee": {
    "type": "string"
   },
   "attachments": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "branchName": {
    "type": "string"
   },
   "category": {
    "enum": [
     "ACCESSIBILITY",
     "SECURITY",
     "VISUAL",
     "PERFORMANCE",
     "FUNCTIONAL",
     "NETWORK",
     "USABILITY",
     "COMPATIBILITY",
     "DATA_INTEGRITY",
     "INTERACTION",
     "LOCALIZATION",
     "RESPONSIVENESS",
     "LAYOUT",
     "VISUAL_REGRESSION",
     "MEMORY",
     "PERFORMANCE_REGRESSION",
     "MEMORY_REGRESSION",
     "FORM_VALIDATION_BUG",
     "OTHER"
    ],
    "type": "string"
   },
   "cliVersion": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "dueDateMillis": {
    "type": "number"
   },
   "environment": {
    "type": "string"
   },
   "gitSha": {
    "type": "string"
   },
   "issueType": {
    "enum": [
     "BUG_ISSUE",
     "SUGGESTION_ISSUE",
     "OBSERVATION_ISSUE",
     "TASK_ISSUE"
    ],
    "type": "string"
   },
   "labels": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "linkTargets": {
    "items": {
     "properties": {
      "toEntityId": {
       "minLength": 1,
       "type": "string"
      },
      "toEntityType": {
       "enum": [
        "STORY",
        "SCENARIO",
        "TEST",
        "ISSUE",
        "EXTERNAL",
        "TEST_EXECUTION",
        "BATCH_INVOCATION"
       ],
       "type": "string"
      }
     },
     "required": [
      "toEntityType",
      "toEntityId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "policyFile": {
    "type": "string"
   },
   "policyVersion": {
    "type": "string"
   },
   "reportedReleaseId": {
    "type": "string"
   },
   "severity": {
    "enum": [
     "LOW_SEVERITY",
     "MEDIUM_SEVERITY",
     "HIGH_SEVERITY",
     "CRITICAL_SEVERITY"
    ],
    "type": "string"
   },
   "skillVersion": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ACTIVE",
     "IGNORED",
     "FIXED",
     "DUPLICATE",
     "IN_PROGRESS_BUG",
     "ARCHIVED_BUG",
     "BLOCKED"
    ],
    "type": "string"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   },
   "userId": {
    "type": "string"
   },
   "workflowExecutionId": {
    "type": "string"
   },
   "workflowId": {
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "create-issue"
}
