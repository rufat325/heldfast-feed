{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Configure Electron fuses"
 },
 "description": "Generate @electron/fuses configuration to harden your Electron app. Fuses are compile-time toggles that disable dangerous Electron features (like ELECTRON_RUN_AS_NODE, NODE_OPTIONS) and cannot be re-enabled by end users. Essential for production apps.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customFuses": {
    "additionalProperties": false,
    "description": "Individual fuse settings (only for 'custom' level)",
    "properties": {
     "cookieEncryption": {
      "description": "Encrypt cookies at rest (default: enable)",
      "type": "boolean"
     },
     "embeddedAsarIntegrity": {
      "description": "Validate ASAR integrity (default: enable)",
      "type": "boolean"
     },
     "grantFileProtocolExtraPrivileges": {
      "description": "Grant file:// protocol extra privileges (default: disable)",
      "type": "boolean"
     },
     "loadBrowserProcessSpecificV8Snapshot": {
      "description": "Use browser-specific V8 snapshot (default: disable)",
      "type": "boolean"
     },
     "nodeCliInspect": {
      "description": "Allow --inspect CLI flag (default: disable)",
      "type": "boolean"
     },
     "nodeOptions": {
      "description": "Allow NODE_OPTIONS env var (default: disable)",
      "type": "boolean"
     },
     "onlyLoadAppFromAsar": {
      "description": "Only load app from ASAR archive (default: enable)",
      "type": "boolean"
     },
     "runAsNode": {
      "description": "Allow ELECTRON_RUN_AS_NODE env var (default: disable)",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "level": {
    "description": "'recommended' for sensible defaults, 'strict' for maximum security, 'custom' to specify each fuse individually",
    "enum": [
     "recommended",
     "strict",
     "custom"
    ],
    "type": "string"
   }
  },
  "required": [
   "level"
  ],
  "type": "object"
 },
 "name": "electron_configure_fuses"
}
