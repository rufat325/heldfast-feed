{
 "description": "Record the FINAL pass/fail decision for one manual-review LMS assessment lesson, with overall feedback the worker sees. Decisions come after the result release; FAIL requires a reason. Requires confirmDecision=true and an idempotency key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "confirmDecision": {
    "const": true,
    "type": "boolean"
   },
   "decision": {
    "enum": [
     "PASS",
     "FAIL"
    ],
    "type": "string"
   },
   "expectedTargetHash": {
    "description": "Optional fence pinning the attempt actually reviewed: the lesson's reviewTarget.targetHash.",
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Required request idempotency key. Reuse it only for the identical operation.",
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "lessonKey": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "reason": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "assignmentId",
   "lessonKey",
   "decision",
   "confirmDecision",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_decide_assessment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
