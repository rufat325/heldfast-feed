  "readOnlyHint": true,
  "title": "Get expense by ID"
 },
 "description": "Fetch a single expense row by its sheet row number or by its ExpenseBot expenseId (the exact Receipt ID in Column Q). Returns the row's headers + values + a labeled {header \u2192 value} map so you can refer to a specific expense the user mentioned. Read-only.",
 "inputSchema": {
  "properties": {
   "expenseId": {
    "description": "Exact full ExpenseBot Receipt ID from Column Q",
    "type": "string"
   },
   "rowNumber": {
    "description": "1-indexed sheet row (row 1 is headers, so \u2265 2)",
    "minimum": 2,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_expense_by_id",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "headers": {
    "items": {},
    "type": "array"
   },
   "labeled": {
    "additionalProperties": true,
    "type": "object"
   },
   "reviewExpenseUrl": {
    "type": "string"
   },
   "rowNumber": {
    "description": "Resolved sheet row for the expense.",
    "type": "integer"
   },
   "sheetName": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   },
   "values": {
    "items": {},
    "type": "array"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "securitySchemes": [
