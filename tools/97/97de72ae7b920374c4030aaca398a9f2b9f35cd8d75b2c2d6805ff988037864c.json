{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List schemas registered for a Data Stream topic",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "description": "Page number (0-based, default: 0)",
    "type": "number"
   },
   "schemaId": {
    "description": "Filter by schema registry ID",
    "type": "number"
   },
   "schemaType": {
    "description": "Filter by schema type",
    "enum": [
     "AVRO",
     "JSON",
     "PROTOBUF"
    ],
    "type": "string"
   },
   "size": {
    "description": "Page size (default: 10)",
    "type": "number"
   },
   "topicId": {
    "description": "Topic ID to query schemas",
    "type": "string"
   }
  },
  "required": [
   "topicId"
  ],
  "type": "object"
 },
 "name": "ncloud_datastream_list_schemas"
}
