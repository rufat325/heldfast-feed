{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Saves a melody as a new private song. The melody must have no errors (run validate_melody or fit_melody_to_box first); warnings such as notes repeated too quickly are saved and marked, as in the composer. If the person is signed in, the song goes to their account and you get a link to open it in the composer. Without an account the song is saved anonymously and you get a claim link: give it to the person so they can keep it (valid 30 days). Set save_to_my_account to true to ask the person to sign in first (apps that cannot sign in mid-conversation should save without an account and give the claim link instead). Limits: 5 songs a day without an account, 15 a day with one.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "artist": {
    "description": "Original artist or composer (\"Traditional\" if unknown).",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "box": {
    "description": "Music box type: \"15\", \"20\", \"30\" (notes) or \"freestyle\" (digital only). See list_music_boxes.",
    "enum": [
     "15",
     "20",
     "30",
     "freestyle"
    ],
    "type": "string"
   },
   "bpm": {
    "description": "Tempo in beats per minute (30-300).",
    "maximum": 300,
    "minimum": 30,
    "type": "number"
   },
   "description": {
    "description": "Optional notes about the arrangement.",
    "maxLength": 1000,
    "type": "string"
   },
   "illegal_threshold_ticks": {
    "description": "Minimum gap between two identical notes, in ticks (default 384 = 2 beats).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Song title.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "description": "Notes in any order, at most 2000. Only onsets matter: music boxes have no note durations.",
    "items": {
     "properties": {
      "beat": {
       "description": "When the note sounds, in quarter notes from 0 (e.g. 0, 1, 1.5).",
       "minimum": 0,
       "type": "number"
      },
      "pitch": {
       "anyOf": [
        {
         "maxLength": 8,
         "type": "string"
        },
        {
         "maximum": 127,
         "minimum": 0,
         "type": "integer"
        }
       ],
       "description": "Note name like \"C5\", \"F#4\", \"Bb3\", or a MIDI number (60 = C4)."
      },
      "ticks": {
       "description": "Alternative to beat: 192 ticks per quarter note.",
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "pitch"
     ],
     "type": "object"
    },
    "maxItems": 2000,
    "minItems": 1,
    "type": "array"
   },
   "save_to_my_account": {
    "description": "True to save it in the person's account; they will be asked to sign in if they are not.",
    "type": "boolean"
   },
   "tags": {
    "items": {
     "maxLength": 30,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   }
  },
  "required": [
   "name",
   "artist",
   "box",
   "bpm",
   "notes"
  ],
  "type": "object"
 },
 "name": "create_song",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "box": {
    "type": "string"
   },
   "claim_expires_at": {
    "type": "string"
   },
   "claim_token": {
    "type": "string"
   },
   "claim_url": {
    "type": "string"
   },
   "composer_url": {
    "type": "string"
   },
   "private": {
    "type": "boolean"
   },
   "quota": {
    "additionalProperties": false,
    "properties": {
     "limit": {
      "description": "null means no daily limit",
      "type": [
       "number",
       "null"
      ]
     },
     "resets_at": {
      "type": "string"
     },
     "used": {
      "type": "number"
     }
    },
    "required": [
     "used",
     "limit",
     "resets_at"
    ],
    "type": "object"
   },
   "saved_to_account": {
    "type": "boolean"
   },
   "song_id": {
    "type": "string"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "issues": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "index": {
         "description": "Index of the note in the input, when the issue is about one note.",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "message": {
         "type": "string"
        },
        "severity": {
         "enum": [
          "error",
          "warning"
         ],
         "type": "string"
        },
        "suggestions": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "code",
        "severity",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "ok": {
      "type": "boolean"
     },
     "stats": {
      "additionalProperties": false,
      "properties": {
       "duration_seconds": {
        "type": "number"
       },
       "illegal_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "note_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "strip_length_cm": {
        "type": "number"
       }
      },
      "required": [
       "note_count",
       "illegal_count",
       "duration_seconds"
      ],
      "type": "object"
     }
    },
    "required": [
     "ok",
     "issues",
     "stats"
    ],
    "type": "object"
   }
  },
  "required": [
   "song_id",
   "box",
   "private",
   "saved_to_account",
   "quota",
   "validation"
  ],
  "type": "object"
 },
 "title": "Save a new music box song"
}
