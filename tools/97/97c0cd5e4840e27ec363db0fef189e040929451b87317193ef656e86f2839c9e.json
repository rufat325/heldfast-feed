 },
 "description": "Fetch one cursor-paginated page of current TikTok videos for a username.\n\nUse the returned cursor to paginate and choose latest or popular ordering. Media\nURLs are temporary. Content always resolves against the US region. Each successful\npage, including an empty page, costs 0.2 account credits. A private account returns\na forbidden error rather than an empty page; do not retry it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "region": {
    "const": "US",
    "default": "US",
    "type": "string"
   },
   "sort_by": {
    "default": "latest",
    "enum": [
     "latest",
     "popular"
    ],
    "type": "string"
   },
   "username": {
    "type": "string"
   }
  },
  "required": [
   "username"
  ],
  "type": "object"
 },
 "name": "list_tiktok_profile_videos",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "count": {
    "type": "number"
   },
   "data": {},
   "has_more": {
    "type": "boolean"
   },
   "next_cursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "not_found": {
    "items": {},
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "results": {
    "items": {},
    "type": "array"
   },
   "suggested_followups": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "reason": {
       "type": "string"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "List TikTok profile videos"
