{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a user-defined custom schema in Cloud Insight for custom metrics.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fields": {
    "description": "Schema field definitions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "dimension": {
       "description": "Whether this field is a dimension",
       "type": "boolean"
      },
      "fieldName": {
       "description": "Field name",
       "type": "string"
      },
      "fieldType": {
       "description": "Field data type",
       "enum": [
        "STRING",
        "INTEGER",
        "LONG",
        "FLOAT"
       ],
       "type": "string"
      }
     },
     "required": [
      "fieldName",
      "fieldType"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "prodName": {
    "description": "Product name(s) for the custom schema",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "useCustomResource": {
    "description": "Whether to use custom resource (default false)",
    "type": "boolean"
   }
  },
  "required": [
   "prodName",
   "fields"
  ],
  "type": "object"
 },
 "name": "ncloud_create_custom_schema"
}
