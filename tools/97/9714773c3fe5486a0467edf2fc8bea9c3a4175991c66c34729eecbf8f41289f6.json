       "checkOut"
      ],
      "type": [
       "object",
       "null"
      ]
     },
     "travelLinks": {
      "items": {
       "properties": {
        "affiliate": {
         "type": "boolean"
        },
        "detail": {
         "type": "string"
        },
        "title": {
         "type": "string"
        },
        "url": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
