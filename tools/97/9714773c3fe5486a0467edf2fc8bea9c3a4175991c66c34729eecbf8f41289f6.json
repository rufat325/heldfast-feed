{
 "_meta": {
  "openai/toolInvocation/invoked": "Listings ready",
  "openai/toolInvocation/invoking": "Planning the visit"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan a visit to an event"
 },
 "description": "Use this when the user is planning a trip to one specific event and wants tickets together with a place to stay, parking or directions. One call returns the latest event details, every seller link for the event, the venue address, suggested stay dates and search links for hotels, parking, directions and things to do. Planning only; nothing is booked or saved. Stale or inactive events have no planning links.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "Exact event slug from a search result; not an artist or venue slug.",
    "pattern": "^[a-z0-9-]{1,240}$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "prepare_event_visit",
 "outputSchema": {
  "properties": {
   "city": {
    "type": "string"
   },
   "country": {
    "type": "string"
   },
   "date": {
    "description": "Venue-local date; may be blank if unknown.",
    "type": "string"
   },
   "dateTime": {
    "description": "Provider absolute start timestamp when supplied.",
    "type": [
     "string",
     "null"
    ]
   },
   "handoffAvailable": {
    "description": "At least one exact-event seller link exists; this does not mean tickets remain.",
    "type": "boolean"
   },
   "inventoryVerified": {
    "const": false,
    "type": "boolean"
   },
   "links": {
    "items": {
     "properties": {
      "affiliate": {
       "type": "boolean"
      },
      "destination": {
       "description": "REST only: the seller page the link leads to, for display; may be blank. Link people to url.",
       "type": "string"
      },
      "inventoryVerified": {
       "const": false,
       "type": "boolean"
      },
      "official": {
       "type": "boolean"
      },
      "purpose": {
       "const": "external_event_checkout",
       "type": "string"
      },
      "seller": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "description": "Link to show the person: opens the seller's page for this event through ticketsea.com/go/.",
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url",
      "seller",
      "type",
      "official",
      "affiliate",
      "purpose",
      "inventoryVerified"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "listingUpdatedAt": {
    "description": "Original listing retrieval timestamp; not a stock check.",
    "type": "string"
   },
   "localTime": {
    "description": "Venue-local time; may be blank if unknown.",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "onSale": {
    "properties": {
     "endAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "startAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "tbd": {
      "type": "boolean"
     }
    },
    "required": [
     "startAt",
     "endAt",
     "tbd"
    ],
    "type": "object"
   },
   "otherSellers": {
    "description": "Other sellers the event's TicketSea page offers, such as resale marketplaces and box offices, in page order. detail is the page's own description of the link; some are a search for the event rather than a page for this exact performance. Empty for stale, canceled and past events.",
    "items": {
     "properties": {
      "affiliate": {
       "type": "boolean"
      },
      "detail": {
       "type": "string"
      },
      "inventoryVerified": {
       "const": false,
       "type": "boolean"
      },
      "seller": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url",
      "seller",
      "detail",
      "affiliate",
      "inventoryVerified"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pricing": {
    "description": "Informational published ranges, not current available offers. Prices may change moment to moment and are not guaranteed. Fees and taxes may be additional. When ranges is empty, omit the price line. Never combine primary/resale sellers or currencies.",
    "properties": {
     "inventoryVerified": {
      "const": false,
      "type": "boolean"
     },
     "label": {
      "type": "string"
     },
     "notice": {
      "type": "string"
     },
     "ranges": {
      "items": {
       "properties": {
        "checkedAt": {
         "type": "string"
        },
        "currency": {
         "type": "string"
        },
        "feeInclusion": {
         "const": "unknown",
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "maxMinor": {
         "minimum": 1,
         "type": "integer"
        },
        "minMinor": {
         "minimum": 1,
         "type": "integer"
        },
        "minorUnit": {
         "maximum": 3,
         "minimum": 0,
         "type": "integer"
        },
        "provider": {
         "type": "string"
        },
        "sourceType": {
         "type": "string"
        },
        "validUntil": {
         "description": "Expiry in Unix milliseconds. Discard at this time even if cached.",
         "type": "integer"
        }
       },
       "required": [
        "provider",
        "sourceType",
        "currency",
        "minMinor",
        "maxMinor",
        "minorUnit",
        "checkedAt",
        "validUntil",
        "label",
        "feeInclusion"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "label",
     "ranges",
     "notice",
     "inventoryVerified"
    ],
    "type": "object"
   },
   "publicSaleState": {
    "description": "Schedule state, not inventory. registration means restricted registration access, not an open general sale.",
    "type": "string"
   },
   "region": {
    "type": "string"
   },
   "slug": {
    "pattern": "^[a-z0-9-]{1,240}$",
    "type": "string"
   },
   "stale": {
    "type": "boolean"
   },
   "status": {
    "type": "string"
   },
   "tickets": {
    "description": "The first exact-event seller link for this performance, present only for a fresh, upcoming listing with a known seller page. The link opens the seller's page for this event through ticketsea.com/go/. It is not an availability check, and the event can have other sellers.",
    "properties": {
     "affiliate": {
      "description": "TicketSea may earn a commission from this seller.",
      "type": "boolean"
     },
     "official": {
      "type": "boolean"
     },
     "seller": {
      "type": "string"
     },
     "type": {
      "description": "primary or resale.",
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "url",
     "seller",
     "type",
     "official",
     "affiliate"
    ],
    "type": "object"
   },
   "timezone": {
    "description": "Provider timezone; may be blank if unknown. Do not invent one.",
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   },
   "venue": {
    "type": "string"
   },
   "visit": {
    "properties": {
     "bookingCreated": {
      "const": false,
      "type": "boolean"
     },
     "instructions": {
      "type": "string"
     },
     "planningAvailable": {
      "description": "The event snapshot is fresh and upcoming; this does not confirm availability.",
      "type": "boolean"
     },
     "suggestedStay": {
      "properties": {
       "checkIn": {
        "format": "date",
        "type": "string"
       },
       "checkOut": {
