{
 "description": "Place a market-cap-based limit order over WS. action: sell|buy. target: bps vs current mcap at placement.",
 "inputSchema": {
  "properties": {
   "action": {
    "enum": [
     "sell",
     "buy"
    ],
    "type": "string"
   },
   "amount": {
    "type": "integer"
   },
   "expiry_hours": {
    "default": 144,
    "maximum": 336,
    "minimum": 1,
    "type": "integer"
   },
   "holdings_percentage": {
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "slippage": {
    "default": 1500,
    "maximum": 2500,
    "minimum": 100,
    "type": "integer"
   },
   "target": {
    "minimum": 1,
    "type": "integer"
   },
   "token_address": {
    "type": "string"
   },
   "wallet_address": {
    "type": "string"
   }
  },
  "required": [
   "wallet_address",
   "token_address",
   "action",
   "target"
  ],
  "type": "object"
 },
 "name": "place_limit_order"
}
