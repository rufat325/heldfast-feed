{
 "description": "Record an inward purchase invoice from a supplier. CREATE ONLY.",
 "inputSchema": {
  "properties": {
   "company_id": {
    "type": "string"
   },
   "date": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "notes": {
    "type": "string"
   },
   "party_id": {
    "type": "string"
   },
   "party_name": {
    "description": "Supplier name",
    "type": "string"
   },
   "stock_lines": {
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "rate": {
       "type": "number"
      },
      "stock_id": {
       "type": "string"
      },
      "stock_name": {
       "type": "string"
      }
     },
     "required": [
      "quantity",
      "rate"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "supplier_invoice_no": {
    "description": "Supplier bill number",
    "type": "string"
   }
  },
  "required": [
   "company_id",
   "supplier_invoice_no",
   "stock_lines"
  ],
  "type": "object"
 },
 "name": "create_purchase_invoice"
}
