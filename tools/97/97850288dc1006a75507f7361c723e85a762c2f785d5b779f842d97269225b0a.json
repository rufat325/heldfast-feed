{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find food, beverage and pet brands, and see where to apply to each for a wholesale account. Filter by text, category path, country, availability or `submittable`. The text in `q` can match the name, other names or description of a brand. Search allows small spelling errors and returns at most the best 1,000 matches. `submittable` is true when the brand has an active web form at its address, and LintyBot read that page. It is false when a `robots.txt` file asks Linty not to use the page, or a part of the page where the form can be. Each page has up to 50 brands. To get the next page, send `next_cursor` as `cursor`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "availability": {
    "enum": [
     "direct",
     "indirect_only",
     "unavailable",
     "unknown"
    ],
    "type": "string"
   },
   "category": {
    "description": "A category path, for example `snacks/protein-bars`.",
    "maxLength": 300,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+(?:\\/[a-z0-9-]+)*$",
    "type": "string"
   },
   "country": {
    "description": "A two-letter country code in capitals, for example `US`.",
    "pattern": "^[A-Z]{2}$",
    "type": "string"
   },
   "cursor": {
    "description": "The `next_cursor` of the earlier page.",
    "maxLength": 100,
    "type": "string"
   },
   "q": {
    "description": "Text to find in the brand's name, other names or description. Search allows small spelling errors and returns at most the best 1,000 matches.",
    "maxLength": 200,
    "type": "string"
   },
   "submittable": {
    "description": "True: only brands with an active web form at their address, whose page LintyBot read, and no `robots.txt` refusal of the page or of a part of it where the form can be.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "find_brands",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "brands": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "availability": {
       "anyOf": [
        {
         "enum": [
          "direct",
          "indirect_only",
          "unavailable",
          "unknown"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "canonical_name": {
       "type": "string"
      },
      "category": {
       "type": [
        "string",
        "null"
       ]
      },
      "country": {
       "type": [
        "string",
        "null"
       ]
      },
      "json_twin_url": {
       "format": "uri",
       "type": "string"
      },
      "last_verified_at": {
       "anyOf": [
        {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "md_twin_url": {
       "format": "uri",
       "type": "string"
      },
      "primary_route_type": {
       "anyOf": [
        {
         "enum": [
          "web_form",
          "portal",
          "email",
          "phone",
          "pdf",
          "rep_contact",
          "broker",
          "distributor",
          "other",
          "marketplace"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "publish_state": {
       "enum": [
        "noindex",
        "published"
       ],
       "type": "string"
      },
      "requirement_count": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "route_flags": {
       "items": {
        "enum": [
         "bot_wall_observed",
         "login_required",
         "no_form_at_url",
         "captcha_on_submit",
         "blocked_for_lintybot",
         "frame_refused",
         "robots_refused"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "slug": {
       "type": "string"
      },
      "submittable": {
       "type": "boolean"
      }
     },
     "required": [
      "slug",
      "canonical_name",
      "category",
      "country",
      "publish_state",
      "availability",
      "primary_route_type",
      "route_flags",
      "requirement_count",
      "last_verified_at",
      "submittable",
      "json_twin_url",
      "md_twin_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "brands",
   "next_cursor"
  ],
  "type": "object"
 },
 "title": "Find brands"
}
