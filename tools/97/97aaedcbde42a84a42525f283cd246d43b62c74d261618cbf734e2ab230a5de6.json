{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Create a matching proforma invoice, commercial invoice, packing list and shipping instruction from one set of order data. Returns a link to Triplicate's free generator with everything filled in (the user reviews it and saves the PDF), plus totals (amount, cartons, net/gross weight, CBM) and checks (missing fields, HS code format, Incoterms freight/insurance consistency). Nothing is stored.",
 "inputSchema": {
  "properties": {
   "bank": {
    "properties": {
     "account": {
      "type": "string"
     },
     "bank_address": {
      "type": "string"
     },
     "bank_name": {
      "type": "string"
     },
     "beneficiary": {
      "type": "string"
     },
     "swift": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "buyer": {
    "description": "Buyer / consignee / importer",
    "properties": {
     "address": {
      "description": "Full address, lines separated by \\n",
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "tax_id": {
      "description": "Tax / VAT / business registration number",
      "type": "string"
     },
     "tel": {
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "charges": {
    "properties": {
     "discount": {
      "type": "number"
     },
     "freight": {
      "type": "number"
     },
     "insurance": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "document": {
    "properties": {
     "date": {
      "description": "YYYY-MM-DD",
      "type": "string"
     },
     "number": {
      "description": "Invoice number",
      "type": "string"
     },
     "po": {
      "description": "Buyer's PO / contract number",
      "type": "string"
     },
     "valid_days": {
      "description": "Proforma validity in days",
      "type": "number"
     }
    },
    "type": "object"
   },
   "imperial_units": {
    "default": false,
    "description": "Also show weights in pounds and volume in cubic feet on the packing list and shipping instruction (for US buyers)",
    "type": "boolean"
   },
   "items": {
    "items": {
     "properties": {
      "carton_height_cm": {
       "type": "number"
      },
      "carton_length_cm": {
       "type": "number"
      },
      "carton_width_cm": {
       "type": "number"
      },
      "country_of_origin": {
       "description": "Only if this item's origin differs from shipment.country_of_origin; the documents then show the origin per item",
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "gross_weight_per_carton_kg": {
       "type": "number"
      },
      "hs_code": {
       "type": "string"
      },
      "net_weight_per_carton_kg": {
       "type": "number"
      },
      "pieces_per_carton": {
       "type": "number"
      },
      "quantity": {
       "type": "number"
      },
      "unit": {
       "enum": [
        "PCS",
        "SETS",
        "BOXES",
        "PAIRS",
        "KG",
        "M"
       ],
       "type": "string"
      },
      "unit_price": {
       "type": "number"
      }
     },
     "required": [
      "description",
      "quantity"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "language": {
    "default": "en",
    "description": "Language of the generator page the link opens (documents are in English)",
    "enum": [
     "en",
     "zh",
     "ar",
     "fr",
     "es",
     "pt",
     "ru",
     "tr",
     "hi",
     "ur",
     "bn",
     "id",
     "vi",
     "ja",
     "ko"
    ],
    "type": "string"
   },
   "notify": {
    "description": "Notify party, if different from the buyer",
    "properties": {
     "address": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "open_document": {
    "default": "ci",
    "description": "pi proforma invoice, ci commercial invoice, pl packing list, si shipping instruction, sc sales contract (seller and buyer sign; the remarks become its other terms), co certificate of origin (non-preferential: the exporter's declaration, with space for a chamber of commerce to certify it), po purchase order (the buyer's order to the supplier: buyer = issuer, seller = supplier)",
    "enum": [
     "pi",
     "ci",
     "pl",
     "si",
     "po",
     "sc",
     "co"
    ],
    "type": "string"
   },
   "remarks": {
    "description": "Optional remarks printed on the documents, e.g. 'SAMPLES OF NO COMMERCIAL VALUE, NOT FOR RESALE. VALUE FOR CUSTOMS PURPOSES ONLY.'",
    "type": "string"
   },
   "seller": {
    "description": "Seller / shipper / exporter",
    "properties": {
     "address": {
      "description": "Full address, lines separated by \\n",
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "tax_id": {
      "description": "Tax / VAT / business registration number",
      "type": "string"
     },
     "tel": {
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "shipment": {
    "properties": {
     "country_of_origin": {
      "type": "string"
     },
     "etd": {
      "description": "YYYY-MM-DD",
      "type": "string"
     },
     "port_of_discharge": {
      "type": "string"
     },
     "port_of_loading": {
      "type": "string"
     },
     "vessel_or_flight": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "shipping_marks": {
    "description": "Optional; generated from buyer, destination and carton count if empty",
    "type": "string"
   },
   "signer": {
    "properties": {
     "name": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "terms": {
    "properties": {
     "currency": {
      "enum": [
       "USD",
       "EUR",
       "GBP",
       "JPY",
       "CNY",
       "KRW",
       "VND",
       "AUD",
       "CAD",
       "CHF",
       "HKD",
       "SGD",
       "INR",
       "PKR",
       "BDT",
       "IDR",
       "THB",
       "MYR",
       "PHP",
       "AED",
       "SAR",
       "TRY",
       "BRL",
       "MXN",
       "ZAR",
       "NGN",
       "KES",
       "EGP"
      ],
      "type": "string"
     },
     "incoterm": {
      "enum": [
       "EXW",
       "FCA",
       "FAS",
       "FOB",
       "CFR",
       "CIF",
       "CPT",
       "CIP",
       "DAP",
       "DPU",
       "DDP"
      ],
      "type": "string"
     },
     "payment": {
      "description": "e.g. 'T/T 30% deposit, 70% before shipment'",
      "type": "string"
     },
     "place": {
      "description": "Named place, e.g. 'Busan' for FOB Busan",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "seller",
   "buyer",
   "items"
  ],
  "type": "object"
 },
 "name": "create_trade_documents",
 "title": "Create export documents"
}
