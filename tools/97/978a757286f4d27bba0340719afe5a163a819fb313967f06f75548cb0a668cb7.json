{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Generate Password"
 },
 "description": "Use this when you need strong passwords with Web Crypto randomness: mode=\"random\" builds character-set passwords (length plus uppercase/lowercase/numbers/symbols toggles); mode=\"memorable\" builds word passphrases (words, separator, addNumber, addSymbol). Cryptographically random via Web Crypto (NOT deterministic). For test/dev fixtures \u2014 for real credentials prefer the client-side web tool at clean.tools/password-generator/ so the password never crosses the network. Example: {mode: \"random\", length: 16} -> mode \"random\", length 16, count 1, passwords [\"NXqtsn6MrsfG9d2i\"].",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "addNumber": {
    "description": "[memorable] Insert a random number (default true).",
    "type": "boolean"
   },
   "addSymbol": {
    "description": "[memorable] Insert a random symbol (default false).",
    "type": "boolean"
   },
   "count": {
    "description": "How many passwords (default 1).",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "length": {
    "description": "[random] Character length (default 16).",
    "maximum": 128,
    "minimum": 4,
    "type": "integer"
   },
   "lowercase": {
    "description": "[random] Include a-z (default true).",
    "type": "boolean"
   },
   "mode": {
    "description": "Password style (default random).",
    "enum": [
     "random",
     "memorable"
    ],
    "type": "string"
   },
   "numbers": {
    "description": "[random] Include 0-9 (default true).",
    "type": "boolean"
   },
   "separator": {
    "description": "[memorable] Word separator (default \"-\").",
    "type": "string"
   },
   "symbols": {
    "description": "[random] Include symbols (default false).",
    "type": "boolean"
   },
   "uppercase": {
    "description": "[random] Include A-Z (default true).",
    "type": "boolean"
   },
   "words": {
    "description": "[memorable] Number of words (default 4).",
    "maximum": 8,
    "minimum": 3,
    "type": "integer"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "generate_password",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Number of passwords generated (matches passwords.length).",
    "type": "integer"
   },
   "length": {
    "description": "[random mode only] character length of each password.",
    "type": "integer"
   },
   "mode": {
    "description": "Which generator produced the passwords.",
    "enum": [
     "random",
     "memorable"
    ],
    "type": "string"
   },
   "passwords": {
    "description": "The generated passwords/passphrases, length = count.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "words": {
    "description": "[memorable mode only] number of words in each passphrase.",
    "type": "integer"
   }
  },
  "required": [
   "mode",
   "count",
   "passwords"
  ],
  "type": "object"
 },
 "title": "Generate Password"
}
