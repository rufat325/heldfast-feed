    "default": 0,
    "description": "Observer altitude in metres.",
    "maximum": 9000,
    "minimum": -500,
    "title": "Alt M",
    "type": "number"
   },
   "days": {
    "default": 2,
    "description": "Window in days (1-3).",
    "maximum": 3,
    "minimum": 1,
    "title": "Days",
    "type": "integer"
   },
   "lat": {
    "description": "Latitude in degrees (-90 to 90).",
    "maximum": 90,
    "minimum": -90,
    "title": "Lat",
    "type": "number"
   },
   "lon": {
    "description": "Longitude in degrees (-180 to 180).",
    "maximum": 180,
    "minimum": -180,
    "title": "Lon",
    "type": "number"
   },
   "min_elevation": {
    "default": 10,
    "description": "Lowest elevation counted as a pass, in degrees above the horizon.",
    "maximum": 89,
    "minimum": 0,
    "title": "Min Elevation",
    "type": "number"
   },
   "norad_id": {
    "default": 25544,
    "description": "NORAD catalog number (default 25544, the ISS); CelesTrak 'stations' and 'visual' groups plus NOAA 15 / 18 / 19.",
    "maximum": 999999999,
    "minimum": 1,
    "title": "Norad Id",
    "type": "integer"
   },
   "visible_only": {
    "default": false,
    "description": "Only passes that can be seen with the eye (satellite sunlit, sky dark).",
    "title": "Visible Only",
    "type": "boolean"
   }
  },
