{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Daily water intake calculator"
 },
 "description": "Estimate a rough daily fluid target from body weight, using 30 to 35 ml per kg, plus an activity add (sedentary 0, light 250, moderate 500, active 750, very_active 1000 ml) and 500 ml more for hot conditions. Use units 'metric' (weightKg) or 'imperial' (weightStone and weightPounds). Returns a low-to-high range in litres, millilitres and 250 ml glasses. Source: https://hopi.co.uk/water-intake-calculator/",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "units": {
       "const": "metric"
      }
     }
    },
    "then": {
     "required": [
      "weightKg"
     ]
    }
   }
  ],
  "properties": {
   "activity": {
    "default": "sedentary",
    "description": "Activity level, default 'sedentary'",
    "enum": [
     "sedentary",
     "light",
     "moderate",
     "active",
     "very_active"
    ],
    "type": "string"
   },
   "hot": {
    "default": false,
    "description": "Add 500 ml for hot conditions. Default false",
    "type": "boolean"
   },
   "units": {
    "description": "'metric' (kg) or 'imperial' (stone and pounds)",
    "enum": [
     "metric",
     "imperial"
    ],
    "type": "string"
   },
   "weightKg": {
    "description": "Weight in kilograms (metric)",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "number"
   },
   "weightPounds": {
    "description": "Pounds part of weight (imperial)",
    "minimum": 0,
    "type": "number"
   },
   "weightStone": {
    "description": "Whole stone part of weight (imperial)",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "units"
  ],
  "type": "object"
 },
 "name": "hopi_water_intake_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "highGlasses": {
    "type": "number"
   },
   "highLitres": {
    "type": "number"
   },
   "highMl": {
    "type": "number"
   },
   "lowGlasses": {
    "type": "number"
   },
   "lowLitres": {
    "type": "number"
   },
   "lowMl": {
    "type": "number"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "units": {
    "type": "string"
   }
  },
  "required": [
   "highGlasses",
   "highLitres",
   "highMl",
   "lowGlasses",
   "lowLitres",
   "lowMl",
   "source_url",
   "summary",
   "units"
  ],
  "type": "object"
 },
 "title": "Daily water intake calculator"
}
