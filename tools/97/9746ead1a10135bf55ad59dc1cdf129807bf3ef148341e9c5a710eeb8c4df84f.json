{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The Ripio app (Wallet) crypto deposit address for an asset on one network, with its memo/tag when the network needs one and the warnings to relay before anyone sends funds. Without a network, or with an ambiguous one, it returns no address and lists the networks that receive the asset. It never creates an address. Ripio Trade uses different addresses.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset": {
    "description": "Ripio ticker, e.g. USDT, BTC or AAPLx.",
    "pattern": "^[A-Za-z0-9]{1,15}$",
    "type": "string"
   },
   "network": {
    "description": "The network as the sender names it: code, name or token standard, e.g. tron, \"BNB Chain\", TRC20, BEP-20.",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "asset"
  ],
  "type": "object"
 },
 "name": "ripio_get_deposit_address",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "asset": {
    "type": "string"
   },
   "asset_name": {
    "type": "string"
   },
   "deposit": {
    "additionalProperties": false,
    "properties": {
     "address": {
      "type": "string"
     },
     "address_version": {
      "type": "number"
     },
     "memo": {
      "type": [
       "string",
       "null"
      ]
     },
     "memo_required": {
      "type": "boolean"
     },
     "network": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "token_standard": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "code",
       "name",
       "label",
       "token_standard"
      ],
      "type": "object"
     }
    },
    "required": [
     "address",
     "memo",
     "memo_required",
     "network"
    ],
    "type": "object"
   },
   "networks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address_assigned": {
       "type": "boolean"
      },
      "can_receive": {
       "type": "boolean"
      },
      "code": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "max_amount": {
       "type": "string"
      },
      "memo_required": {
       "type": "boolean"
      },
      "min_amount": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "notes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "token_standard": {
       "type": [
        "string",
        "null"
       ]
      },
      "typical_minutes": {
       "type": "number"
      }
     },
     "required": [
      "code",
      "name",
      "label",
      "token_standard",
      "can_receive",
      "memo_required",
      "address_assigned",
      "notes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_step": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "choose_network",
     "unsupported_network",
     "deposits_disabled",
     "no_address",
     "memo_missing"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "asset",
   "status",
   "networks",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Ripio deposit address"
}
