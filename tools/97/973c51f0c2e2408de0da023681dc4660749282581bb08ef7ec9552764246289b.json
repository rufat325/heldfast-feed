{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true
 },
 "description": "Book a student into one of a tutor's open slots (from get_tutor_availability). The tutor and the student both get a confirmation email. Confirm the time, name, and email with the user before calling.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "description": "YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "slug": {
    "maxLength": 80,
    "type": "string"
   },
   "studentEmail": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "studentName": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "subject": {
    "maxLength": 100,
    "type": "string"
   },
   "time": {
    "description": "HH:MM, 24h, tutor's timezone \u2014 must match an open slot",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "type": {
    "default": "session",
    "description": "\"trial\" only if the tutor offers a free trial",
    "enum": [
     "session",
     "trial"
    ],
    "type": "string"
   }
  },
  "required": [
   "slug",
   "date",
   "time",
   "studentName",
   "studentEmail"
  ],
  "type": "object"
 },
 "name": "request_booking",
 "title": "Book a session with a tutor"
}
