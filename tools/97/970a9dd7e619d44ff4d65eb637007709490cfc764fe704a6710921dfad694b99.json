{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find probable duplicate books. mode=identical (exact title+authors) or similar (fuzzy) group the library (or ids/query/filter subset \u2014 filter takes a bundle name) with a merge-safety score; mode=compare diffs 2+ ids field-by-field. Read-only \u2014 never merges.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "type": "string"
   },
   "filter": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "ids": {
    "items": {
     "anyOf": [
      {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      {
       "minLength": 1,
       "type": "string"
      }
     ]
    },
    "type": "array"
   },
   "library": {
    "type": "string"
   },
   "limit": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "mode": {
    "default": "identical",
    "enum": [
     "identical",
     "similar",
     "compare"
    ],
    "type": "string"
   },
   "query": {
    "maxLength": 512,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "calibre_find_duplicates",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "booksScanned": {
    "type": "number"
   },
   "capped": {
    "type": "boolean"
   },
   "count": {
    "type": "number"
   },
   "groupCount": {
    "type": "number"
   },
   "keep": {
    "type": "number"
   },
   "languagesDiffer": {
    "type": "boolean"
   },
   "mergeSafety": {
    "type": "number"
   },
   "mode": {
    "type": "string"
   },
   "nextCursor": {
    "type": "string"
   },
   "offset": {
    "type": "number"
   }
  },
  "required": [
   "mode"
  ],
  "type": "object"
 },
 "title": "Find duplicates"
}
