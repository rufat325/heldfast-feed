{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Accept the four merchant documents (merchant-agreement, aup, dpa, refund-framework) by signing the APIbase acceptance message with the merchant wallet. Activates the merchant and returns the mk_live_ API key once.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "doc_hashes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "doc_id": {
       "type": "string"
      },
      "sha256": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "doc_id",
      "version",
      "sha256"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "description": "The exact acceptance text (see docs/integrator.md).",
    "type": "string"
   },
   "method": {
    "enum": [
     "wallet_signature",
     "checkbox+wallet_signature"
    ],
    "type": "string"
   },
   "signature": {
    "type": "string"
   },
   "wallet": {
    "type": "string"
   }
  },
  "required": [
   "wallet",
   "doc_hashes",
   "message",
   "signature"
  ],
  "type": "object"
 },
 "name": "shop.merchant.accept_terms",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "description": "mk_live_ key, shown once on first activation.",
    "type": "string"
   },
   "status": {
    "const": "active",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Accept merchant documents"
}
