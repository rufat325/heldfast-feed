  "title": "Wallet DLMM positions"
 },
 "description": "Open Meteora DLMM positions of any wallet: value, unclaimed fees, PnL, in/out of range \u2014 or its closed-position history. Set history=true for closed positions with deposits, withdrawals, fees and PnL per pool. When to use: For a wallet's Meteora positions; to find skilled LPs use dlmm_whales. Price: $0.005 per call (10 free/day; after that a payment-required result lists x402 options). Errors: returns isError with a message for invalid input or an upstream failure (not charged).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "history": {
    "default": false,
    "description": "true = closed-position history instead of open positions. Default false.",
    "type": "boolean"
   },
   "page": {
    "default": 1,
    "description": "Page of closed-position history (only with history=true). Range 1-50. Default 1.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "wallet": {
    "description": "wallet address. Base58 Solana address, 32-44 chars.",
    "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
    "type": "string"
   }
  },
  "required": [
   "wallet"
  ],
  "type": "object"
 },
