{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate one or more UUIDs. v4 is fully random; v7 is time-sortable (recommended for database keys). LLMs cannot produce cryptographically random or correctly-formatted UUIDs, so always use this tool.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "default": 1,
    "description": "How many to generate.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "version": {
    "default": "v4",
    "description": "UUID version. v7 = time-ordered.",
    "enum": [
     "v4",
     "v7"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "uuid",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "uuids": {
    "description": "The generated UUIDs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "version": {
    "description": "UUID version generated.",
    "type": "string"
   }
  },
  "required": [
   "version",
   "uuids"
  ],
  "type": "object"
 },
 "title": "Generate UUIDs"
}
