{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read one exact catalog component, including terminal IDs, electrical specs and known configuration. Catalog data does not verify an installed part or its protection evidence.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "catalogId": {
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_.-]+$",
    "type": "string"
   }
  },
  "required": [
   "catalogId"
  ],
  "type": "object"
 },
 "name": "get_component",
 "outputSchema": {
  "properties": {
   "data": {},
   "error": {
    "properties": {
     "code": {
      "type": "string"
     },
     "details": {},
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "metadata": {
    "properties": {
     "apiVersion": {
      "type": "string"
     },
     "engineVersion": {
      "type": "string"
     },
     "schemaVersion": {
      "type": "integer"
     }
    },
    "required": [
     "apiVersion",
     "engineVersion",
     "schemaVersion"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "tool": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool",
   "metadata"
  ],
  "type": "object"
 }
}
