{
 "description": "Delete a message YOU sent (author-only; other senders read as not found). This is a NON-destructive tombstone: the row is never removed \u2014 content, attachments, and audio read blanked and the prior values survive only in the append-only server-side revision ledger. Optimistic concurrency is required: pass expectedRevision equal to the message readback `revision` field; a stale value returns 409 REVISION_CONFLICT with currentRevision. Requires an Idempotency-Key of 1-128 chars from [A-Za-z0-9._:-] (minimum one) and messages:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expectedRevision": {
    "maximum": 2147483646,
    "minimum": 0,
    "type": "integer"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "messageId": {
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   }
  },
  "required": [
   "messageId",
   "expectedRevision",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_delete_message",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "additionalProperties": false,
    "properties": {
     "content": {
      "type": "null"
     },
     "conversationId": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "deleted": {
      "const": true,
      "type": "boolean"
     },
     "deletedAt": {
      "$ref": "#/properties/message/properties/editedAt/anyOf/0"
     },
     "edited": {
      "type": "boolean"
     },
     "editedAt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "lastEditedByUserId": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "messageId": {
      "minLength": 1,
      "type": "string"
     },
     "operation": {
      "const": "DELETE",
      "type": "string"
     },
     "revision": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "messageId",
     "conversationId",
     "operation",
     "revision",
     "content",
     "edited",
     "editedAt",
     "lastEditedByUserId",
     "deleted",
     "deletedAt"
    ],
    "type": "object"
   },
   "replayed": {
    "type": "boolean"
   },
   "sync": {
    "not": {}
   },
   "syncCoverage": {
    "not": {}
   }
  },
  "required": [
   "message",
   "replayed"
  ],
  "type": "object"
 }
}
