{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a task / log time"
 },
 "description": "Create a task, optionally with logged time entries, for a client or project. Invoice Ninja: POST /api/v1/tasks.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "client_id": {
    "description": "Client (hashed id).",
    "type": "string"
   },
   "description": {
    "description": "What the work was.",
    "minLength": 1,
    "type": "string"
   },
   "due_date": {
    "description": "Due date, YYYY-MM-DD.",
    "type": "string"
   },
   "project_id": {
    "description": "Project (hashed id).",
    "type": "string"
   },
   "rate": {
    "description": "Hourly rate; omit to use the project/client default.",
    "type": "number"
   },
   "time_log": {
    "description": "Time entries. Entries must not overlap.",
    "items": {
     "properties": {
      "billable": {
       "description": "Whether this entry is billable.",
       "type": "boolean"
      },
      "description": {
       "description": "Note for this time entry.",
       "type": "string"
      },
      "end": {
       "description": "End, Unix timestamp in seconds (0 = still running).",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "start": {
       "description": "Start, Unix timestamp in seconds.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "start",
      "end"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "description"
  ],
  "type": "object"
 },
 "name": "invoiceninja_create_task",
 "title": "Create a task / log time"
}
