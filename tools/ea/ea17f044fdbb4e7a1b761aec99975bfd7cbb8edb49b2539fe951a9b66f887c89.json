  "title": "Schedule a calendar\u2019s ready videos"
 },
 "description": "Schedule the ready videos of an approved calendar whose posts are waiting, after the user connected an account or picked a new time (all, or the numbers given). Needs publishing permission. Cost: Free to schedule.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "maximum": 31,
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 31,
    "minItems": 1,
    "type": "array"
   },
   "plan_id": {
    "pattern": "^pln_[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "plan_id"
  ],
  "type": "object"
 },
 "name": "post_content_plan",
 "outputSchema": {
