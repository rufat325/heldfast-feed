{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Project Status Dependencies"
 },
 "description": "Read blocking and informing relationships from the validated task DAG. Optionally focus upstream or downstream of one task and paginate the result.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "direction": {
    "default": "all",
    "description": "Relationship direction relative to task_id.",
    "enum": [
     "all",
     "upstream",
     "downstream"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "task_id": {
    "description": "Optional task identifier to focus on.",
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "type": {
    "description": "Optional dependency type filter.",
    "enum": [
     "blocks",
     "informs"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "project_status_get_dependencies",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "dependencies": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dependent": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "name"
       ],
       "type": "object"
      },
      "prerequisite": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "name"
       ],
       "type": "object"
      },
      "type": {
       "enum": [
        "blocks",
        "informs"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "prerequisite",
      "dependent"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hasMore": {
    "type": "boolean"
   },
   "nextOffset": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "offset": {
    "type": "number"
   },
   "ok": {
    "const": true,
    "type": "boolean"
   },
   "taskId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "ok",
   "taskId",
   "total",
   "count",
   "offset",
   "hasMore",
   "nextOffset",
   "dependencies"
