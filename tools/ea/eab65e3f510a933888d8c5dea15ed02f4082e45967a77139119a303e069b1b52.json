  ],
  "priority": 0.5,
  "readOnlyHint": true,
  "title": "List Documents"
 },
 "description": "List ClickUp documents. Optionally filter by parentId/parentType, creator, deleted, archived.",
 "inputSchema": {
  "properties": {
   "archived": {
    "description": "Include archived documents.",
    "type": "boolean"
   },
   "creator": {
    "description": "Filter by creator ID.",
    "type": "number"
   },
   "cursor": {
    "description": "Pagination cursor (preferred).",
    "type": "string"
   },
   "deleted": {
    "description": "Include deleted documents.",
    "type": "boolean"
   },
   "detail_level": {
    "description": "Controls response verbosity. 'names' returns id/name/url only for efficient navigation. 'detailed' returns full metadata. Default: detailed.",
    "enum": [
     "names",
     "detailed"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results.",
    "type": "number"
   },
   "next_cursor": {
    "description": "Pagination cursor (deprecated).",
    "type": "string"
   },
   "parentId": {
    "description": "Parent ID (space, folder, or list).",
    "type": "string"
   },
   "parentName": {
    "description": "Parent name.",
    "type": "string"
   },
   "parentType": {
    "description": "Parent type.",
    "enum": [
     "SPACE",
     "FOLDER",
     "LIST",
     "WORKSPACE",
     "EVERYTHING",
     "TASK"
    ],
    "type": "string"
   },
   "team_id": {
    "description": "The ClickUp Team ID or Workspace Name to use. If provided, the server will switch to this workspace for this and subsequent requests in the current session.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_documents"
}
