{
 "description": "Create, update, delete, search, inspect, and tag Anki flashcards through one high-level note/card workflow. Use this for note lifecycle work and card lookup, not for deck structure, note-type schema changes, or study scheduling. Mutating operations change the local Anki collection immediately; searches are read-only. Choose `operation` first, then provide the operation-specific IDs, query, fields, tags, or pagination inputs described by the schema.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cardIds": {
    "description": "Card IDs to get info for",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "deckName": {
    "description": "Deck name (for create operations)",
    "type": "string"
   },
   "fields": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Field name-value pairs (for create/update)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "includeDetails": {
    "description": "Include detailed note info (for find)",
    "type": "boolean"
   },
   "limit": {
    "description": "Max results to return (default: 50, recommended to prevent context overflow)",
    "type": "number"
   },
   "modelName": {
    "description": "Note type/model name (for create operations)",
    "type": "string"
   },
   "noteId": {
    "description": "Note ID (for update/delete single note)",
    "type": "number"
   },
   "noteIds": {
    "description": "Note IDs (for delete multiple)",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "notes": {
    "description": "Array of notes to create (for create_batch)",
    "items": {
     "properties": {
      "deckName": {
       "type": "string"
      },
      "fields": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "modelName": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "deckName",
      "modelName",
      "fields"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "offset": {
    "description": "Number of results to skip for pagination (default: 0)",
    "type": "number"
   },
   "operation": {
    "description": "The flashcard operation to perform",
    "enum": [
     "create",
     "create_batch",
     "update",
     "delete",
     "find",
     "get_info",
     "add_tags",
     "remove_tags",
     "clear_empty"
    ],
    "type": "string"
   },
   "query": {
    "description": "Anki search query (for find operation)",
    "type": "string"
   },
   "tags": {
    "description": "Tags to add/remove or set",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "operation"
  ],
  "type": "object"
 },
 "name": "manage_flashcards"
}
