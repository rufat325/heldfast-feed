{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Suggest feed fixes"
 },
 "description": "Validate a supplied feed for one target and turn deterministic validation issues into remediation actions for the affected records.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "content": {
    "description": "Feed content. Paste the JSON, XML, CSV, TSV or NDJSON payload directly. Maximum size is 2 MB.",
    "maxLength": 2000000,
    "minLength": 1,
    "type": "string"
   },
   "format": {
    "description": "Optional input-format override. Omit or use auto to detect JSON, NDJSON, XML, CSV or TSV automatically.",
    "enum": [
     "auto",
     "json",
     "xml",
     "csv",
     "tsv",
     "ndjson"
    ],
    "type": "string"
   },
   "target": {
    "description": "Validation target. Choose a published-contract validator, readiness checker or the generic hotel master data audit.",
    "enum": [
     "wego",
     "google_hotel_center",
     "trivago",
     "meta_catalog",
     "criteo",
     "hotel_master_data"
    ],
    "type": "string"
   }
  },
  "required": [
   "target",
   "content"
  ],
  "type": "object"
 },
 "name": "suggest_feed_fixes",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "fixes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "type": "string"
      },
      "affectedRows": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "code": {
       "type": "string"
      },
      "level": {
       "enum": [
        "error",
        "warning"
       ],
       "type": "string"
      }
     },
     "required": [
      "code",
      "level",
      "affectedRows",
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "format": {
    "enum": [
     "JSON",
     "XML",
     "CSV",
     "TSV",
     "NDJSON"
    ],
    "type": "string"
   },
   "issues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "level": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "rows": {
       "items": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "type": "array"
      }
     },
     "required": [
      "level",
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "records": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "target": {
    "description": "Validation target. Choose a published-contract validator, readiness checker or the generic hotel master data audit.",
    "enum": [
     "wego",
     "google_hotel_center",
     "trivago",
     "meta_catalog",
     "criteo",
     "hotel_master_data"
    ],
    "type": "string"
   }
  },
  "required": [
   "target",
   "score",
   "format",
   "records",
   "fixes",
   "issues"
  ],
  "type": "object"
 },
 "title": "Suggest feed fixes"
}
