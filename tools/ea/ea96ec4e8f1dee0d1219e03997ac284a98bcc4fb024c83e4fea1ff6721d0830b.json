{
 "description": "Copy a sheet/tab within the same spreadsheet. Supports batch copying: create multiple copies from a single source sheet (e.g., create 12 monthly sheets from a template). Copies all data, formatting, charts, and conditional formatting verbatim.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "copies": {
    "description": "Array of copies to create from the source sheet",
    "items": {
     "properties": {
      "insertIndex": {
       "description": "Position to insert the new sheet (0-indexed)",
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "newTitle": {
       "description": "Name for the copied sheet",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "newTitle"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "gid",
   "copies"
  ],
  "type": "object"
 },
 "name": "sheet-copy",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "completedAt": {
        "description": "ISO datetime when operation completed",
        "type": "string"
       },
       "failures": {
        "description": "Failed copies with error messages",
        "items": {
         "additionalProperties": false,
         "properties": {
          "error": {
           "type": "string"
          },
          "title": {
           "type": "string"
          }
         },
         "required": [
          "title",
          "error"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "items": {
        "description": "Information about created sheets",
        "items": {
         "additionalProperties": false,
         "properties": {
          "gid": {
           "description": "Sheet ID (from URL gid={gid})",
           "type": "string"
          },
          "sheetUrl": {
           "description": "URL of the created sheet",
           "type": "string"
          },
          "title": {
           "description": "Title of the created sheet",
           "type": "string"
          }
         },
         "required": [
          "gid",
          "title",
          "sheetUrl"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "itemsChanged": {
        "description": "Successfully created copies",
        "type": "number"
       },
       "itemsProcessed": {
        "description": "Total copies attempted",
        "type": "number"
       },
       "operationSummary": {
        "description": "Summary of the copy operation",
        "type": "string"
       },
       "sourceGid": {
        "description": "Source sheet ID",
        "type": "string"
       },
       "sourceTitle": {
        "description": "Source sheet title",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "operationSummary",
       "itemsProcessed",
       "itemsChanged",
       "completedAt",
       "id",
       "sourceGid",
       "sourceTitle",
       "items"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
