    "minLength": 34,
    "type": "string"
   },
   "quoteId": {
    "description": "AIURION quote UUID returned by printing.quotes.create.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "quoteId"
  ],
  "type": "object"
 },
 "name": "printing.orders.get",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": true,
    "properties": {
     "order": {
      "additionalProperties": true,
      "description": "Payment review and manufacturing status for the quote.",
      "type": [
       "object",
       "null"
      ]
     },
     "state": {
      "description": "Current combined payment and manufacturing state.",
