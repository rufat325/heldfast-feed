{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get one DB user (GET /mysql/v1/clusters/{clusterName}/users/{userName}).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clusterName": {
    "description": "Cluster name (3-30 chars, lowercase letters/digits/'-', no leading or trailing '-'; immutable after creation)",
    "pattern": "^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$",
    "type": "string"
   },
   "userName": {
    "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,14}[A-Za-z0-9]$",
    "type": "string"
   }
  },
  "required": [
   "clusterName",
   "userName"
  ],
  "type": "object"
 },
 "name": "ncloud_serverless_get_user"
}
