{
 "description": "Gestiona roles y permisos. Acciones: list, get (id), permissions (id), create, update (id), update_permissions (id).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "permissions",
     "create",
     "update",
     "update_permissions"
    ],
    "type": "string"
   },
   "id": {
    "description": "ID del rol",
    "type": "number"
   },
   "permissions": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "additionalProperties": {
       "anyOf": [
        {
         "const": "1",
         "type": "string"
        },
        {
         "const": "all",
         "type": "string"
        },
        {
         "const": "",
         "type": "string"
        },
        {
         "const": "no",
         "type": "string"
        },
        {
         "const": "specific",
         "type": "string"
        }
       ]
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ]
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "roles"
}
