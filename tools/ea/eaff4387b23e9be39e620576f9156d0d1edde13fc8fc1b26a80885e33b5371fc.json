{
 "description": "Open a sandbox (paper) perpetual position. Fills immediately at the live mid-price plus a deterministic spread + size-impact slippage + that venue's futures taker fee (0.05% per leg when the venue is not in the fee table). Requires an sb_ key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "description": "Sandbox API key (starts with sb_)",
    "type": "string"
   },
   "exchange": {
    "description": "Venue to paper-trade against",
    "enum": [
     "binance",
     "bybit",
     "okx",
     "mexc",
     "hyperliquid"
    ],
    "type": "string"
   },
   "idempotency_key": {
    "description": "Replay-safe key. Same key = same order returned.",
    "maxLength": 64,
    "type": "string"
   },
   "leverage": {
    "description": "Leverage multiplier (defaults to 1)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "limit_price": {
    "description": "Limit price (not yet wired)",
    "type": "string"
   },
   "quantity": {
    "description": "Base-asset quantity as a decimal string",
    "type": "string"
   },
   "side": {
    "description": "Position side",
    "enum": [
     "long",
     "short"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Trading pair (e.g. BTCUSDT)",
    "type": "string"
   },
   "type": {
    "description": "Order type (limit orders land in Phase 4)",
    "enum": [
     "market",
     "limit"
    ],
    "type": "string"
   }
  },
  "required": [
   "api_key",
   "exchange",
   "symbol",
   "side",
   "quantity"
  ],
  "type": "object"
 },
 "name": "sandbox_open_position"
}
