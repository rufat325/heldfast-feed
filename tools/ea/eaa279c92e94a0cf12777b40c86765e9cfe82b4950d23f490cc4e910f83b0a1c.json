{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Update user-specific settings for a calendar (color, visibility, reminders, custom name).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backgroundColor": {
    "description": "Background color in hex (#0088aa)",
    "type": "string"
   },
   "calendarId": {
    "description": "Calendar ID to update",
    "type": "string"
   },
   "colorId": {
    "description": "Color ID from colors.get",
    "type": "string"
   },
   "defaultReminders": {
    "description": "Default reminders for events",
    "items": {
     "additionalProperties": false,
     "properties": {
      "method": {
       "enum": [
        "email",
        "popup"
       ],
       "type": "string"
      },
      "minutes": {
       "type": "number"
      }
     },
     "required": [
      "method",
      "minutes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "foregroundColor": {
    "description": "Foreground color in hex",
    "type": "string"
   },
   "hidden": {
    "description": "Whether to hide from the calendar list",
    "type": "boolean"
   },
   "selected": {
    "description": "Whether to show events in the UI",
    "type": "boolean"
   },
   "summaryOverride": {
    "description": "Custom name for the calendar",
    "type": "string"
   }
  },
  "required": [
   "calendarId"
  ],
  "type": "object"
 },
 "name": "calendarlist_update",
 "title": "Update calendar settings"
}
