{
 "_meta": {
  "openai/toolInvocation/invoked": "Recommendations ready",
  "openai/toolInvocation/invoking": "Ranking events for you",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when a user wants recommendations personalized with a saved Dizko profile. Saved and learned taste rank the results; they never hide them.",
 "inputSchema": {
  "properties": {
   "avoid": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 40,
    "type": "array"
   },
   "city": {
    "maxLength": 200,
    "type": "string"
   },
   "date_from": {
    "maxLength": 200,
    "type": "string"
   },
   "date_to": {
    "maxLength": 200,
    "type": "string"
   },
   "event_types": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "featuring": {
    "maxLength": 200,
    "type": "string"
   },
   "free": {
    "type": "boolean"
   },
   "genres": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "limit": {
    "description": "Same as result_limit; result_limit wins when both are given.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "type": "number"
   },
   "neighborhoods": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "nightlife": {
    "type": "boolean"
   },
   "price_max": {
    "type": "number"
   },
   "profile_id": {
    "maxLength": 200,
    "type": "string"
   },
   "profile_secret": {
    "description": "Private profile secret returned when the profile was created.",
    "maxLength": 200,
    "type": "string"
   },
   "query": {
    "maxLength": 200,
    "type": "string"
   },
   "result_limit": {
    "default": 10,
    "description": "How many ranked events to return (1-50, default 10).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "venue": {
    "maxLength": 200,
    "type": "string"
   },
   "vibe": {
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "when": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "profile_id",
   "profile_secret"
  ],
  "type": "object"
 },
 "name": "recommend_events_for_user",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Recommend Events For User"
}
