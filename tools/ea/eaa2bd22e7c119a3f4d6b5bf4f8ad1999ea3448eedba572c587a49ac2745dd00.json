{
 "_meta": {
  "toolset": "interaction"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Measure"
 },
 "description": "Measure distance or area between geographic coordinate tuples. Returns { success, data: { mode, value, unit, segments?, id? }, message? }.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Custom measurement entity ID",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "mode": {
    "description": "Measurement mode: distance or area",
    "enum": [
     "distance",
     "area"
    ],
    "type": "string"
   },
   "positions": {
    "description": "Coordinate array [[lon, lat, alt?], ...]",
    "items": {
     "description": "Coordinate tuple [longitude, latitude, optional height]",
     "items": {
      "type": "number"
     },
     "maxItems": 3,
     "minItems": 2,
     "prefixItems": [
      {
       "description": "Longitude in decimal degrees",
       "maximum": 180,
       "minimum": -180,
       "type": "number"
      },
      {
       "description": "Latitude in decimal degrees",
       "maximum": 90,
       "minimum": -90,
       "type": "number"
      },
      {
       "description": "Optional height in meters",
       "maximum": 50000000,
       "minimum": -12000,
       "type": "number"
      }
     ],
     "type": "array"
    },
    "maxItems": 10000,
    "minItems": 2,
    "type": "array"
   },
   "sessionId": {
    "description": "Target browser session ID for multi-browser routing (optional)",
    "type": "string"
   },
   "showOnMap": {
    "default": true,
    "description": "Whether to display measurement result on map",
    "type": "boolean"
   }
  },
  "required": [
   "mode",
   "positions"
  ],
  "type": "object"
 },
 "name": "measure",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "mode": {
      "enum": [
       "distance",
       "area"
      ],
      "type": "string"
     },
     "segments": {
      "items": {
       "minimum": 0,
       "type": "number"
      },
      "type": "array"
     },
     "unit": {
      "type": "string"
     },
     "value": {
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "mode",
     "value",
     "unit"
    ],
    "type": "object"
   },
   "error": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 }
}
