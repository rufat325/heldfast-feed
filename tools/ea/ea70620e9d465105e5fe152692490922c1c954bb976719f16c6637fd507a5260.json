{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Kibi knowledge base"
 },
 "description": "Ask the KB a question or search it. Default intent-v1 ranking accepts questions, host-agent semantic facets and changed-code source locations, returns evidence, abstains below its confidence threshold and adds an answer layer: the current requirements that govern the topic, what must stay true (linked facts), why (ADRs) and what verifies it (scenarios, tests). Use before changing behavior, then kb_query for exact follow-up. No mutation side effects.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "answer": {
    "description": "Intent-v1 only, first page only. When true (default) the result includes an answer layer: current governing requirements with their linked facts, scenarios, tests and ADRs, superseded requirements listed separately, and observation facts labelled as notes. Bounded in size; discovery, not proof.",
    "type": "boolean"
   },
   "fields": {
    "anyOf": [
     {
      "const": "summary",
      "type": "string"
     },
     {
      "const": "full",
      "type": "string"
     }
    ],
    "description": "Optional result detail. 'summary' returns identifying metadata plus the match snippet for discovery. Use 'full' to include complete entity bodies, or follow up with kb_query for the exact entities you need."
   },
   "limit": {
    "description": "Optional max rows to return after ranking. Default: 20.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "minScore": {
    "description": "Intent-v1 acceptance threshold between 0 and 1. Low-confidence queries abstain instead of returning misleading matches.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "offset": {
    "description": "Optional zero-based pagination offset. Default: 0.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Free-text query for metadata and markdown body discovery. Example: 'OAuth login flow'.",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "rankingMode": {
    "anyOf": [
     {
      "const": "legacy",
      "type": "string"
     },
     {
      "const": "intent-v1",
      "type": "string"
     }
    ],
    "description": "Optional deterministic ranking mode. Default intent-v1: question-aware ranking with semantic facets, source-aware evidence, graph boosts, superseded demotion and abstention. Use legacy for the older lexical ranking."
   },
   "semanticFacets": {
    "description": "Optional host-agent semantic interpretation. Kibi uses these strings as deterministic aliases/facets; it does not call a model itself.",
    "properties": {
     "actions": {
      "items": {
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "actors": {
      "items": {
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "aliases": {
      "items": {
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "constraints": {
      "items": {
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "objects": {
      "items": {
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     }
    },
    "type": "object"
   },
   "sourceLocations": {
    "description": "Optional changed-code locations. Results are matched to source-linked symbols/entities and include source evidence.",
    "items": {
     "properties": {
      "column": {
       "maximum": 9007199254740991,
       "minimum": 1,
       "type": "integer"
      },
      "line": {
       "maximum": 9007199254740991,
       "minimum": 1,
       "type": "integer"
      },
      "path": {
       "description": "Workspace-relative source path.",
       "minLength": 1,
       "type": "string"
      },
      "symbol": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "type": {
    "anyOf": [
     {
      "const": "req",
      "type": "string"
     },
     {
      "const": "scenario",
      "type": "string"
     },
     {
      "const": "test",
      "type": "string"
     },
     {
      "const": "adr",
      "type": "string"
     },
     {
      "const": "flag",
      "type": "string"
     },
     {
      "const": "event",
      "type": "string"
     },
     {
      "const": "symbol",
      "type": "string"
     },
     {
      "const": "fact",
      "type": "string"
     }
    ],
    "description": "Optional entity type filter to narrow discovery. Example: 'req'."
   },
   "workspaceRoot": {
    "description": "Optional absolute path of the workspace this call is about when it differs from the one the server started in, for example the git worktree you are working in. The server answers from that workspace's knowledge base when it is a worktree of the same repository or lies under the client's MCP roots; otherwise it answers from its own workspace and adds a workspace_mismatch diagnostic. Host hooks fill this in automatically where available.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "kb_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "answer": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     "count": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "queryAnalysis": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     "results": {
      "items": {},
      "type": "array"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "results",
     "count"
    ],
    "type": "object"
   },
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "code": {
       "type": "string"
      },
      "detail": {},
      "file": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "anyOf": [
        {
         "const": "info",
         "type": "string"
        },
        {
         "const": "warning",
         "type": "string"
        },
        {
         "const": "error",
         "type": "string"
        }
       ]
      },
      "suggestion": {
       "type": "string"
      }
     },
     "required": [
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "effects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {},
      "errorCode": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "status": {
       "anyOf": [
        {
         "const": "completed",
         "type": "string"
        },
        {
         "const": "failed",
         "type": "string"
        },
        {
         "const": "not_applicable",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "kind",
      "status"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "details": {},
     "message": {
      "type": "string"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message",
     "retryable"
    ],
    "type": "object"
   },
   "kibiProtocol": {
    "const": 1,
    "type": "number"
   },
   "nextActions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "input": {},
      "operation": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "required": {
       "type": "boolean"
      }
     },
     "required": [
      "operation",
      "reason",
      "required"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "operation": {
    "const": "kb_search",
    "type": "string"
   },
   "resultVersion": {
    "const": "kibi.kb_search.v1",
    "type": "string"
   },
   "status": {
    "anyOf": [
     {
      "const": "success",
      "type": "string"
     },
     {
      "const": "committed_with_repairs",
      "type": "string"
     },
     {
      "const": "error",
      "type": "string"
     }
    ]
   }
  },
  "required": [
   "kibiProtocol",
   "operation",
   "resultVersion",
   "status",
   "data",
   "effects",
   "diagnostics",
   "nextActions"
  ],
  "type": "object"
 }
}
