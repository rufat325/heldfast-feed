{
 "description": "Run HULDRA nonlinear optimization using a compiled .PR as the objective evaluator",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "async_exec": {
    "description": "If true, return job_id for long optimizations",
    "type": "boolean"
   },
   "elements": {
    "description": "Parameters to optimize",
    "items": {
     "additionalProperties": false,
     "properties": {
      "delta": {
       "type": "number"
      },
      "index": {
       "description": "R-variable index (1-20)",
       "type": "number"
      },
      "label": {
       "type": "string"
      },
      "max": {
       "type": "number"
      },
      "min": {
       "type": "number"
      },
      "start": {
       "type": "number"
      }
     },
     "required": [
      "index",
      "label",
      "start",
      "min",
      "max",
      "delta"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "h_initial": {
    "description": "Initial step fraction (default: 0.125)",
    "type": "number"
   },
   "max_iterations": {
    "description": "Max iterations (default: 100)",
    "type": "number"
   },
   "objectives": {
    "description": "Objective values to minimize",
    "items": {
     "additionalProperties": false,
     "properties": {
      "goal": {
       "type": "number"
      },
      "index": {
       "description": "R-variable index (1-20) \u2014 maps to R(20+index)",
       "type": "number"
      },
      "label": {
       "type": "string"
      },
      "weight": {
       "type": "number"
      }
     },
     "required": [
      "index",
      "label",
      "goal",
      "weight"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "primary_file": {
    "description": "Data file to pass to the VALUE program",
    "type": "string"
   },
   "program": {
    "description": "Compiled .PR program name (the VALUE program)",
    "type": "string"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "userid": {
    "description": "Project owner's username. Required when accessing a shared project where you are a writer. Defaults to the authenticated user.",
    "type": "string"
   }
  },
  "required": [
   "project",
   "program",
   "primary_file",
   "elements",
   "objectives"
  ],
  "type": "object"
 },
 "name": "chaprola_optimize"
}
