{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Draw a Fibonacci study directly on the chart with exact candle coordinates and optional custom ratios. Supports retracement, extension, channel, time, fan, circle, spiral, arc and wedge variants. Prefer swing timestamps/prices returned by market_candles computations rather than visual guesses. Changes the chart you are building; call chart_link when you are done so the person can open it.",
 "inputSchema": {
  "properties": {
   "arrowEnd": {
    "type": "boolean"
   },
   "arrowStart": {
    "type": "boolean"
   },
   "color": {
    "description": "A palette name. \u201cup\u201d and \u201cdown\u201d are the reserved green and red \u2014 they assert a bullish or bearish claim, so use them for position zones and not for a measurement.",
    "enum": [
     "blue",
     "orange",
     "violet",
     "aqua",
     "yellow",
     "magenta",
     "neutral",
     "white",
     "up",
     "down"
    ],
    "type": "string"
   },
   "extendLeft": {
    "type": "boolean"
   },
   "extendRight": {
    "type": "boolean"
   },
   "fill": {
    "description": "Palette fill colour, or \u201cnone\u201d.",
    "type": "string"
   },
   "fillOpacity": {
    "description": "Shape fill opacity from 0 to 1.",
    "type": "number"
   },
   "fontSize": {
    "description": "Label/text size from 8 to 28.",
    "type": "number"
   },
   "levels": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "lineStyle": {
    "enum": [
     "solid",
     "dashed",
     "dotted"
    ],
    "type": "string"
   },
   "opacity": {
    "description": "Strength of the whole drawing, 0.1 to 1. Fade a level that is context rather than the decision.",
    "type": "number"
   },
   "points": {
    "items": {
     "properties": {
      "price": {
       "type": "number"
      },
      "time": {
       "type": "number"
      }
     },
     "required": [
      "time",
      "price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ref": {
    "type": "string"
   },
   "showLabels": {
    "type": "boolean"
   },
   "showStats": {
    "type": "boolean"
   },
   "symbol": {
    "type": "string"
   },
   "text": {
    "description": "Text for annotation tools.",
    "type": "string"
   },
   "tool": {
    "enum": [
     "fibRetracement",
     "fibExtension",
     "fibChannel",
     "fibTimeZone",
     "fibSpeedFan",
     "fibTimeExtension",
     "fibCircles",
     "fibSpiral",
     "fibSpeedArcs",
     "fibWedge"
    ],
    "type": "string"
   },
   "width": {
    "description": "Stroke width in pixels, 1 to 6.",
    "type": "number"
   }
  },
  "required": [
   "tool",
   "points"
  ],
  "type": "object"
 },
 "name": "fibonacci_draw"
}
