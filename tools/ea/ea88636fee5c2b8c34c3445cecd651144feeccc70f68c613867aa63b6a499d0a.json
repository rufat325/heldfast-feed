    "additionalProperties": {},
    "description": "Canonical germplasm record as returned by `/germplasm/{id}`.",
    "properties": {
     "accessionNumber": {
      "description": "Gene-bank catalog number.",
      "type": [
       "string",
       "null"
      ]
     },
     "biologicalStatusOfAccessionDescription": {
      "description": "MCPD biological-status label.",
      "type": [
       "string",
       "null"
      ]
     },
     "collection": {
