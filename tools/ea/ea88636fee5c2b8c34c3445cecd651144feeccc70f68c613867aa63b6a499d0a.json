{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch a single germplasm by DbId with attributes and direct parents. Response companions report study count, direct parent count, and direct descendant count \u2014 signals for pedigree depth and observation coverage.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "alias": {
    "description": "Connection alias registered via brapi_connect. Omit to read the connection registered under alias `default` \u2014 i.e. a prior brapi_connect call that did not specify an alias. Calls that used a non-default alias must pass that same alias here.",
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "germplasmDbId": {
    "description": "Germplasm identifier.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "germplasmDbId"
  ],
  "type": "object"
 },
 "name": "brapi_get_germplasm",
