{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a test plan's priority or custom fields.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "customFields": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cascadeValue": {
       "description": "Cascade dropdown value",
       "type": "string"
      },
      "id": {
       "description": "Custom field ID, e.g. qcf_1",
       "type": "string"
      },
      "value": {
       "description": "Field value",
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "id": {
    "description": "Test plan ID",
    "type": [
     "string",
     "number"
    ]
   },
   "priority": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "pattern": "^\\d+$",
      "type": "string"
     }
    ],
    "description": "Priority integer ID \u2014 use qtm4j_get_priorities"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "qtm4j_update_test_plan",
 "title": "Update Test Plan"
}
