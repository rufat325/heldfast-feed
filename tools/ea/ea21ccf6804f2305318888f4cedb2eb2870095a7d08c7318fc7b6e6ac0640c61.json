{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Independent outcome evidence for outcome-priced contracts: record what a task actually delivered and what the caller says it cost. Pass `counterparty_id`, `task_class`, `episode_id`, the `task` (acceptance_criteria), `delivery` (status) and `costs`; get a delivery, downstream-use and full-cost dossier with a receipt. Missing costs and unverified claims stay explicit; no ROI claim. Free, no account, no effect outside GAIP: the call records a receipt in GAIP's history. Inputs must be public and non-personal; calling declares that (data_classification defaults to PUBLIC).",
 "inputSchema": {
  "additionalProperties": true,
  "examples": [
   {
    "baseline_cost_gbp": "12.00",
    "costs": {
     "agent_gbp": "0.40",
     "compute_gbp": "0.12",
     "human_review_gbp": "3.50",
     "repair_gbp": "0"
    },
    "counterparty_id": "example-weather-agent",
    "delivery": {
     "receipt_id": "example-receipt-1",
     "status": "ACCEPTED"
    },
    "downstream_use": {
     "evidence_ref": "example-ticket-4411",
     "status": "USED"
    },
    "episode_id": "example-episode-1",
    "observed_at_utc": "2026-09-27T21:00:00Z",
    "task": {
     "acceptance_criteria": "Forecast JSON for London returned within 5 seconds"
    },
    "task_class": "weather_forecast",
    "unit_label": "forecast",
    "units": 7
   }
  ],
  "properties": {
   "baseline_cost_gbp": {
    "oneOf": [
     {
      "type": "number"
     },
     {
      "type": "string"
     }
    ]
   },
   "continuity_handle": {
    "additionalProperties": false,
    "properties": {
     "continuity_id": {
      "type": "string"
     },
     "token": {
      "type": "string"
     }
    },
    "required": [
     "continuity_id",
     "token"
    ],
    "type": "object"
   },
   "costs": {
    "type": "object"
   },
   "counterparty_id": {
    "type": "string"
   },
   "data_classification": {
    "default": "PUBLIC",
    "enum": [
     "PUBLIC",
     "NON_PERSONAL_PUBLIC"
    ],
    "type": "string"
   },
   "delivery": {
    "required": [
     "status"
    ],
    "type": "object"
   },
   "downstream_use": {
    "type": "object"
   },
   "episode_id": {
    "type": "string"
   },
   "evidence_refs": {
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "independent_operator_id": {
    "type": "string"
   },
   "synthetic": {
    "type": "boolean"
   },
   "task": {
    "required": [
     "acceptance_criteria"
    ],
    "type": "object"
   },
   "task_class": {
    "type": "string"
   }
  },
  "required": [
   "episode_id",
   "task",
   "delivery",
   "costs"
  ],
  "type": "object"
 },
 "name": "gaip_measure_outcome_value",
 "title": "Measure task outcome and value"
}
