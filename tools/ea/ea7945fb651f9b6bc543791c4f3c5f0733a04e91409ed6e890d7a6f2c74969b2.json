    "minimum": 2,
    "type": "integer"
   },
   "x_range": {
    "description": "X-axis range as (min, max), e.g., (-5.0, 5.0)",
    "maxItems": 2,
    "minItems": 2,
    "prefixItems": [
     {
      "type": "number"
     },
     {
      "type": "number"
     }
    ],
    "type": "array"
   }
  },
  "required": [
   "expression",
   "x_range"
  ],
  "type": "object"
 },
 "name": "plot_function",
