  "additionalProperties": false,
  "properties": {
   "expression": {
    "description": "Mathematical expression to plot, e.g., \"x**2\" or \"sin(x)\". Must be <= MAX_EXPRESSION_LENGTH characters. Example: \"x**2\"",
    "maxLength": 500,
    "type": "string"
   },
   "num_points": {
