{
 "_meta": {
  "openai/toolInvocation/invoked": "Recipes found",
  "openai/toolInvocation/invoking": "Finding recipes",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find recipes"
 },
 "description": "Use this to find drink and food recipes from the teas.co.uk recipe library, such as iced teas, lattes, chai or baking with tea. Give query (the kind of recipe), product_id (from find_products) or both. With both, recipes that use the product and match the words rank first. With neither, the call is refused. limit is 1 to 10 (default 5). There is no paging, so the best matches come first. An empty list means nothing matched. Drinks made with alcohol are never included. To buy the products use find_products.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "How many recipes (default 5).",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "product_id": {
    "description": "Optional product id from find_products.",
    "maxLength": 120,
    "type": "string"
   },
   "query": {
    "description": "What kind of recipe, for example \"iced peach tea\" or \"chai latte\".",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_recipes",
 "outputSchema": {
  "properties": {
   "recipes": {
    "items": {
     "properties": {
      "prep": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "uses": {
       "items": {
        "properties": {
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "recipes"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Find recipes"
}
