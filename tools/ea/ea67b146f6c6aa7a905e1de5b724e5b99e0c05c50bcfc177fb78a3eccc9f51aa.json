{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get contract summary list. Returns a summary of contracts grouped by region and contract type with counts for the specified month.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contractMonth": {
    "description": "Contract month in yyyyMM format (e.g. 202404)",
    "type": "string"
   },
   "contractStatusCode": {
    "description": "Contract status: ALL (default), NOML (normal), NLEND (terminated)",
    "enum": [
     "ALL",
     "NOML",
     "NLEND"
    ],
    "type": "string"
   },
   "contractTypeCode": {
    "description": "Contract type code (e.g. VSVR)",
    "type": "string"
   },
   "isOrganization": {
    "description": "Query as Organization master (integrated view)",
    "type": "boolean"
   },
   "isPartner": {
    "description": "Query as Partner representative",
    "type": "boolean"
   },
   "memberNoList": {
    "description": "Member number list (master/partner only)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pageNo": {
    "description": "Page number",
    "type": "number"
   },
   "pageSize": {
    "description": "Page size (max 1000, default 1000)",
    "type": "number"
   },
   "regionCode": {
    "description": "Region code (e.g. KR)",
    "type": "string"
   }
  },
  "required": [
   "contractMonth"
  ],
  "type": "object"
 },
 "name": "ncloud_get_contract_summary_list"
}
