     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The post's link."
   },
   "video_id": {
    "anyOf": [
     {
      "maxLength": 120,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Shorti's id of the video."
   }
  },
  "type": "object"
 },
