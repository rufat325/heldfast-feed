{
 "description": "Extract and browser-validate SVG geometry from a reference region.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "color": {
    "type": "string"
   },
   "format": {
    "default": "svg",
    "enum": [
     "svg",
     "path2d"
    ],
    "type": "string"
   },
   "maxError": {
    "exclusiveMinimum": 0,
    "maximum": 20,
    "type": "number"
   },
   "mode": {
    "default": "open",
    "enum": [
     "open",
     "closed"
    ],
    "type": "string"
   },
   "projectId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "referenceId": {
    "type": "string"
   },
   "regionId": {
    "type": "string"
   },
   "threshold": {
    "maximum": 255,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "projectId",
   "regionId"
  ],
  "type": "object"
 },
 "name": "visual.extract_geometry"
}
