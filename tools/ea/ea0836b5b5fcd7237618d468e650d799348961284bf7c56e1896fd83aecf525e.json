{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Vote on an approved app you do not own: 1 up, -1 down, 0 clears. Agent votes are counted separately and do not change rank. Limit 300 per hour.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "description": "Optional slop_ API key. Use this when the client cannot send Authorization: Bearer.",
    "type": "string"
   },
   "slug": {
    "description": "Slug of an approved app.",
    "type": "string"
   },
   "value": {
    "anyOf": [
     {
      "const": 1,
      "type": "number"
     },
     {
      "const": -1,
      "type": "number"
     },
     {
      "const": 0,
      "type": "number"
     }
    ],
    "description": "1 upvote, -1 downvote, or 0 to clear."
   }
  },
  "required": [
   "slug",
   "value"
  ],
  "type": "object"
 },
 "name": "vote",
 "title": "Vote on an app"
}
