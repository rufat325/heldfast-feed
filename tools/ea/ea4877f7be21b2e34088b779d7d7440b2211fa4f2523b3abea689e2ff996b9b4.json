{
 "description": "Envoie une demande de devis \u00e0 Moovtips au nom de la personne. Avant de l'appeler : demande-lui son pr\u00e9nom, le nom de son entreprise, son e-mail, son m\u00e9tier, sa ville et son besoin (sans rien inventer), puis demande-lui explicitement si elle accepte que ces informations soient transmises \u00e0 Moovtips. Moovtips r\u00e9pond sous 48 heures.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "besoin": {
    "description": "Le besoin d\u00e9crit par la personne, avec ses mots",
    "maxLength": 3000,
    "minLength": 20,
    "type": "string"
   },
   "budget": {
    "maxLength": 120,
    "type": "string"
   },
   "consentement": {
    "const": true,
    "description": "true seulement si la personne a accept\u00e9 explicitement que ses informations soient transmises \u00e0 Moovtips",
    "type": "boolean"
   },
   "delai": {
    "maxLength": 120,
    "type": "string"
   },
   "email": {
    "format": "email",
    "maxLength": 120,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "entreprise": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "langue": {
    "default": "fr",
    "enum": [
     "fr",
     "en"
    ],
    "type": "string"
   },
   "metier": {
    "description": "Ce que fait l'entreprise",
    "maxLength": 300,
    "minLength": 2,
    "type": "string"
   },
   "prenom": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "services": {
    "description": "Services voulus (voir services_moovtips)",
    "items": {
     "enum": [
      "site-vitrine",
      "site-3d",
      "standard-ia",
      "seo",
      "ugc",
      "shopify",
      "publicite",
      "automatisation",
      "identite",
      "print",
      "video-ia",
      "maintenance",
      "chat-ia",
      "reservation",
      "application",
      "reseau",
      "cybersecurite",
      "infogerance"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "telephone": {
    "description": "De pr\u00e9f\u00e9rence le num\u00e9ro WhatsApp",
    "pattern": "^[+0-9 ().-]{6,30}$",
    "type": "string"
   },
   "ville": {
    "description": "Ville ou zone des clients",
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "services",
   "prenom",
   "entreprise",
   "email",
   "metier",
   "ville",
   "besoin",
   "consentement"
  ],
  "type": "object"
 },
 "name": "envoyer_demande",
 "title": "Envoyer une demande de devis \u00e0 Moovtips"
}
