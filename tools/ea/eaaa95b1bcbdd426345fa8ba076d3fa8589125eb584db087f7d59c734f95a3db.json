{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Sandbox-only diagnosis, writes nothing (no verdict, no recommendation-trail entry). Two modes: pass shot_id to dry-run a LOGGED shot (optionally overriding its sensory_tags \u2014 the \"what would this read as?\" preview; the shot's own bean and its age at pulled_at are used), or pass the full metric set (bean_id, grinder_id, machine_id, grind_label, dose_g, yield_g, time_s, source) for a hypothetical shot. Identical output shape to diagnose_shot, including bean_context.",
 "inputSchema": {
  "properties": {
   "bean_id": {
    "description": "Coffee bean ID (must belong to this account)",
    "type": "integer"
   },
   "dose_g": {
    "description": "Dose in grams",
    "type": "number"
   },
   "grind_label": {
    "description": "Grinder setting label, e.g. \"1.1.3\"",
    "type": "string"
   },
   "grinder_id": {
    "description": "Grinder ID (must belong to this account)",
    "type": "integer"
   },
   "machine_id": {
    "description": "Machine ID (must belong to this account)",
    "type": "integer"
   },
   "sensory_tags": {
    "description": "Sensory observations, e.g. [\"sour\",\"bitter\"]. With shot_id: replaces the stored tags for this preview (omit to use stored; [] = none).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "shot_id": {
    "description": "Preview a logged shot by ID (dry-run; ignores the metric params below)",
    "type": "integer"
   },
   "source": {
    "description": "Grinder position source \u2014 affects G1 warning (raw mode only)",
    "enum": [
     "measured",
     "recalled",
     "assumed"
    ],
    "type": "string"
   },
   "time_s": {
    "description": "Extraction time in seconds",
    "type": "number"
   },
   "yield_g": {
    "description": "Yield in grams",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "diagnose_preview",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "bean_context": {
    "additionalProperties": true,
    "properties": {
     "bag_id": {
      "type": "integer"
     },
     "bean_id": {
      "type": "integer"
     },
     "bean_name": {
      "type": "string"
     },
     "dial_category": {
      "type": "string"
     },
     "effective_age_days": {
      "type": "integer"
     },
     "roast_level": {
      "type": "string"
     }
    },
    "required": [
     "bean_id",
     "bag_id",
     "bean_name",
     "roast_level",
     "effective_age_days",
     "dial_category"
    ],
    "type": "object"
   },
   "category": {
    "type": "string"
   },
   "facts": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "source": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hypotheses": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "cause": {
       "type": "string"
      },
      "cited_rules": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "confidence": {
       "type": "string"
      },
      "direction": {
       "type": "string"
      },
      "experiment": {
       "type": "string"
      },
      "lever": {
       "type": "string"
      },
      "target_label": {
       "type": "string"
      }
     },
     "required": [
      "cause",
      "lever",
      "direction",
      "confidence",
      "experiment",
      "cited_rules"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "kb_version": {
    "type": "string"
   },
   "one_variable_only": {
    "type": "boolean"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "category",
   "facts",
   "hypotheses",
   "warnings",
   "one_variable_only",
   "kb_version",
   "bean_context"
  ],
  "type": "object"
 },
 "title": "Preview a diagnosis"
}
