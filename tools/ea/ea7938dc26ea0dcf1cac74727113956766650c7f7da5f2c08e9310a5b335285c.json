{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Replace Guardrail MCP Servers"
 },
 "description": "Replace the complete MCP-server mapping set for one guardrail. Requires a guardrail with target mcp_tools. Any existing server omitted from mcp_servers is removed, and an empty object clears all mappings. Read list_guardrail_mcp_servers first. Repeating the same complete map is safe.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "guardrail_id": {
    "description": "Guardrail UUID or slug",
    "minLength": 1,
    "type": "string"
   },
   "mcp_servers": {
    "additionalProperties": {
     "properties": {
      "mcp_integration_capability_ids": {
       "description": "MCP integration capability UUIDs covered by this mapping",
       "items": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
       },
       "type": "array"
      },
      "run_on": {
       "default": [
        "input",
        "output"
       ],
       "description": "Guardrail phases to run for this MCP server",
       "items": {
        "enum": [
         "input",
         "output"
        ],
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      }
     },
     "type": "object"
    },
    "description": "Complete MCP-server mapping set keyed by server UUID; an empty object clears every mapping",
    "propertyNames": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "guardrail_id",
   "mcp_servers"
  ],
  "type": "object"
 },
 "name": "replace_guardrail_mcp_servers",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
