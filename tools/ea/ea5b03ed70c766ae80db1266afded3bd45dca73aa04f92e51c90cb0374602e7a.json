{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Full-page PNG of one URL. Returns the image (or, for a large one, links.file to fetch with the jobToken) plus a jobId/jobToken for get_screenshot. Paid in USDC (the 402 challenge names the network), or from a prepaid balance when the request carries Authorization: Bearer dck_\u2026: 0.02 USD per call. Answers with jobId, jobToken, filename, url, dimensions, bytes and links.file.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "auth": {
    "description": "HTTP basic auth for the page.",
    "properties": {
     "password": {
      "description": "Password for HTTP basic auth.",
      "maxLength": 512,
      "type": "string"
     },
     "username": {
      "description": "Username for HTTP basic auth.",
      "maxLength": 512,
      "type": "string"
     }
    },
    "required": [
     "username",
     "password"
    ],
    "type": "object"
   },
   "url": {
    "description": "Page to capture (full URL).",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "viewportWidth": {
    "description": "Capture width in px.",
    "maximum": 2560,
    "minimum": 320,
    "type": "integer"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "capture_screenshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bytes": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "code": {
    "type": "string"
   },
   "dimensions": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "type": "string"
   },
   "filename": {
    "type": "string"
   },
   "jobId": {
    "type": "string"
   },
   "jobToken": {
    "type": "string"
   },
   "links": {
    "additionalProperties": false,
    "properties": {
     "file": {
      "type": "string"
     }
    },
    "required": [
     "file"
    ],
    "type": "object"
   },
   "payment": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "type": "string"
       },
       "balance": {
        "type": "string"
       },
       "currency": {
        "const": "USD",
        "type": "string"
       },
       "rail": {
        "const": "prepaid",
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency",
       "rail",
       "balance"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "allowanceRemaining": {
        "type": "number"
       },
       "amount": {
        "type": "string"
       },
       "currency": {
        "const": "USD",
        "type": "string"
       },
       "pagesFromAllowance": {
        "type": "number"
       },
       "rail": {
        "const": "subscription",
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency",
       "rail",
       "pagesFromAllowance",
       "allowanceRemaining"
      ],
      "type": "object"
     }
    ]
   },
   "url": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Capture screenshot"
}
