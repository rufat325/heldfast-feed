{
 "description": "Validate and content-bind one caller-supplied material-property evidence envelope before attaching it to a compatible preliminary simulation. The receipt separates shape/content identity from source truth, material identity, uncertainty verification, design allowable, engineering validation, and physical authority. Computed-crystal evidence remains valid reference data but ineligible for the scalar engineering-product beam path. The operation calls no model or solver, stores nothing, contacts nobody, and creates no physical evidence, order, payment, or fabrication authority.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "evidence": {
    "additionalProperties": false,
    "description": "Caller-supplied exact material-property source snapshot. Binding proves content identity and envelope validity only; it does not verify the source claim or create a design allowable.",
    "properties": {
     "applicability": {
      "additionalProperties": false,
      "properties": {
       "manufacturing_process": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
       },
       "orientation": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
       },
       "temperature_c": {
        "description": "Celsius applicability. null is accepted only for computed_crystal evidence and keeps the result reference-only.",
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "temperature_c",
       "orientation",
       "manufacturing_process"
      ],
      "type": "object"
     },
     "basis": {
      "additionalProperties": false,
      "properties": {
       "class": {
        "enum": [
         "engineering_datasheet",
         "experimental_measurement",
         "computed_crystal"
        ]
       },
       "method": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
       },
       "uncertainty": {
        "additionalProperties": false,
        "allOf": [
         {
          "else": {
           "properties": {
            "value": {
             "minimum": 0,
             "type": "number"
            }
           }
          },
          "if": {
           "properties": {
            "kind": {
             "const": "not_reported"
            }
           },
           "required": [
            "kind"
           ]
          },
          "then": {
           "properties": {
            "value": {
             "type": "null"
            }
           }
          }
         }
        ],
        "properties": {
         "kind": {
          "enum": [
           "relative_percent",
           "not_reported"
          ]
         },
         "value": {
          "minimum": 0,
          "type": [
           "number",
           "null"
          ]
         }
        },
        "required": [
         "kind",
         "value"
        ],
        "type": "object"
       }
      },
      "required": [
       "class",
       "method",
       "uncertainty"
      ],
      "type": "object"
     },
     "material_state": {
      "additionalProperties": false,
      "properties": {
       "condition": {
        "maxLength": 300,
        "type": [
         "string",
         "null"
        ]
       },
       "grade": {
        "maxLength": 300,
        "type": [
         "string",
         "null"
        ]
       },
       "name": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
       },
       "product_form": {
        "maxLength": 300,
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "name",
       "grade",
       "condition",
       "product_form"
      ],
      "type": "object"
     },
     "property": {
      "additionalProperties": false,
      "properties": {
       "quantity": {
        "const": "elastic_modulus"
       },
       "unit": {
        "const": "GPa"
       },
       "value": {
        "exclusiveMinimum": 0,
        "type": "number"
       }
      },
      "required": [
       "quantity",
       "value",
       "unit"
      ],
      "type": "object"
     },
     "source": {
      "additionalProperties": false,
      "properties": {
       "checked_at": {
        "format": "date-time",
        "type": "string"
       },
       "excerpt": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
       },
       "id": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
       },
       "kind": {
        "enum": [
         "cited_reference",
         "materials_database",
         "plm_record"
        ]
       },
       "refresh_after": {
        "format": "date-time",
        "type": "string"
       },
       "version": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "kind",
       "id",
       "version",
       "checked_at",
       "refresh_after",
       "excerpt"
      ],
      "type": "object"
     }
    },
    "required": [
     "property",
     "material_state",
     "applicability",
     "basis",
     "source"
    ],
    "type": "object",
    "x-a2a2p-simulation-eligibility-fields": [
     "material_state.name",
     "material_state.grade",
     "material_state.condition",
     "material_state.product_form",
     "applicability.temperature_c",
     "applicability.orientation",
     "applicability.manufacturing_process"
    ],
    "x-a2a2p-simulation-ineligible-normalized-values": [
     "unknown",
     "unspecified",
     "not specified",
     "not applicable",
     "n/a",
     "na",
     "none",
     "null",
     "tbd",
     "to be determined",
     "pending"
    ]
   }
  },
  "required": [
   "evidence"
  ],
  "type": "object"
 },
 "name": "validate_material_property_evidence",
 "outputSchema": {
  "type": "object"
 }
}
