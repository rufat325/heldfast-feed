 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Explore indicative price dates"
 },
 "description": "Show cached indicative price observations in an interactive calendar by day, by month, or as observed departure/return date pairs. Prices are per adult. Every monthly row includes sample_size and sample_sufficient. A month with sample_sufficient=false is a limited cached observation, not a reliable monthly minimum or evidence of seasonality; state that limitation instead of drawing a seasonal conclusion. Always link the returned search_url from a short label in the answer language, for example \"Check live prices on Aviasurf\"; never paste the raw URL as text. Missing dates mean no cached observation, not that no flight exists.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "currency": {
    "description": "Three-letter output currency. Set it only when the user explicitly requests a currency; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "depart_date": {
    "description": "Center date for the local plus-or-minus three-day window.",
    "format": "date",
    "type": "string"
   },
   "depart_month": {
    "description": "Month for a daily calendar or observed date pairs.",
    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
    "type": "string"
   },
   "destination": {
    "description": "Destination city or airport IATA code.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "direct": {
    "default": false,
    "description": "Request nonstop observations only.",
    "type": "boolean"
   },
   "group_by": {
    "default": "departure_at",
    "description": "Calendar mode: daily departures, monthly minima, or observed round-trip date pairs.",
    "enum": [
     "departure_at",
     "month",
     "dates_pair"
    ],
    "type": "string"
   },
   "locale": {
    "default": "en",
    "description": "Language locale for response text and live-search handoff.",
    "pattern": "^[A-Za-z]{2}(?:-[A-Za-z]{2})?$",
    "type": "string"
   },
   "market": {
    "description": "Two-letter country market. Set it only when the user explicitly requests a country market or local Aviasurf site; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "months_ahead": {
    "default": 6,
    "description": "Number of months including the current partial month for month mode.",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "origin": {
    "description": "Origin city or airport IATA code.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "top_n": {
    "default": 10,
    "description": "Maximum number of cheapest dates to include in top_dates.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "trip_duration_max": {
    "description": "Maximum trip length in days for observed date pairs.",
    "minimum": 1,
    "type": "integer"
   },
   "trip_duration_min": {
    "description": "Minimum trip length in days for observed date pairs.",
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "origin",
   "destination"
  ],
  "type": "object"
 },
