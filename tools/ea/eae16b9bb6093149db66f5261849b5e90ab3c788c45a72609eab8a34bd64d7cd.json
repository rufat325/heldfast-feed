{
 "description": "Deploy a model as a managed, metered endpoint (Step 32 \u2014 orchestrate-don't-host: your provider key fronts a partner endpoint; OpenTrain owns no GPU). Source: trainedModelId (a registered model, e.g. from a completed model-program pass) OR provider TINKER|FIREWORKS|CUSTOM + spec {modelRef, baseUrl?}. Requires deploy:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "type": "string"
   },
   "provider": {
    "enum": [
     "TINKER",
     "FIREWORKS",
     "CUSTOM"
    ],
    "type": "string"
   },
   "spec": {
    "additionalProperties": false,
    "properties": {
     "baseUrl": {
      "type": "string"
     },
     "modelRef": {
      "type": "string"
     },
     "usageAlertUsd": {
      "type": "number"
     }
    },
    "required": [
     "modelRef"
    ],
    "type": "object"
   },
   "trainedModelId": {
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "opentrain_deploy_model",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
