{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use AFTER match_offer identifies Little Red Studio, or when an author explicitly asks for a bounded KDP paperback geometry/DPI preflight. Performs deterministic checks from caller-supplied page count, trim size, paper/interior choice and optional cover dimensions. It does not upload, publish, distribute, create checkout, claim final KDP acceptance, or infer trim-specific maximum page counts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cover_height_in": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "cover_pixel_height": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "cover_pixel_width": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "cover_width_in": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "interior_type": {
    "default": "black_white",
    "enum": [
     "black_white",
     "standard_color",
     "premium_color"
    ],
    "type": "string"
   },
   "page_count": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "paper_type": {
    "default": "white",
    "enum": [
     "white",
     "cream",
     "groundwood"
    ],
    "type": "string"
   },
   "spine_text_present": {
    "default": false,
    "type": "boolean"
   },
   "trim_height_in": {
    "maximum": 11.69,
    "minimum": 6,
    "type": "number"
   },
   "trim_width_in": {
    "maximum": 8.5,
    "minimum": 4,
    "type": "number"
   }
  },
  "required": [
   "page_count",
   "trim_width_in",
   "trim_height_in"
  ],
  "type": "object"
 },
 "name": "check_book_export_preflight",
 "title": "Check a paperback export preflight with Little Red Studio"
}
