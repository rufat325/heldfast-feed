{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Assign plain text content to a page as a new transcript.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "id": {
    "description": "Document ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "note": {
    "description": "Note for the transcript",
    "type": "string"
   },
   "nrIsPageId": {
    "default": false,
    "description": "Treat page nr as page ID",
    "type": "boolean"
   },
   "page": {
    "description": "Page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "parent": {
    "default": -1,
    "description": "Parent transcript ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "status": {
    "description": "Transcript status",
    "type": "string"
   },
   "text": {
    "description": "Plain text content to assign",
    "type": "string"
   },
   "toolName": {
    "description": "Tool name that created the transcript",
    "type": "string"
   },
   "useExistingLayout": {
    "default": false,
    "description": "Use existing layout",
    "type": "boolean"
   }
  },
  "required": [
   "collId",
   "id",
   "page",
   "text"
  ],
  "type": "object"
 },
 "name": "transkribus_page_assign_plaintext",
 "title": "Assign Plaintext to Page"
}
