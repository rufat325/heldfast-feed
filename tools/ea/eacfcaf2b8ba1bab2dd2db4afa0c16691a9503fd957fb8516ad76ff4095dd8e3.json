{
 "_meta": {
  "ui": {
   "csp": {
    "connectDomains": [
     "https://*.mapbox.com"
    ],
    "frameDomains": [
     "https://*.mapbox.com"
    ],
    "resourceDomains": [
     "https://*.mapbox.com"
    ]
   },
   "resourceUri": "ui://mapbox/preview-style/index.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Preview Mapbox Style Tool"
 },
 "description": "Generate preview URL for a Mapbox style using an existing public token",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accessToken": {
    "description": "Mapbox public access token (required, must start with pk.* and have styles:read permission). Secret tokens (sk.*) cannot be used as they cannot be exposed in browser URLs. Please use an existing public token or get one from list_tokens_tool or create one with create_token_tool with styles:read permission.",
    "format": "starts_with",
    "pattern": "^pk\\..*",
    "type": "string"
   },
   "styleId": {
    "description": "Style ID to preview",
    "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
    "type": "string"
   },
   "title": {
    "default": false,
    "description": "Show title in the preview",
    "type": "boolean"
   },
   "zoomwheel": {
    "default": true,
    "description": "Enable zoom wheel control",
    "type": "boolean"
   }
  },
  "required": [
   "styleId",
   "accessToken"
  ],
  "type": "object"
 },
 "name": "preview_style_tool",
 "title": "Preview Mapbox Style Tool"
}
