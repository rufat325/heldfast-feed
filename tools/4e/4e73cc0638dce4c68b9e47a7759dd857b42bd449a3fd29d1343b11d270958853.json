{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "HSL converter"
 },
 "description": "Convert a hex colour code to hue, saturation and lightness (HSL), or convert HSL values to hex and RGB. Source: https://hopi.co.uk/hsl-converter/",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "mode": {
       "const": "hex_to_hsl"
      }
     }
    },
    "then": {
     "required": [
      "hex"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "mode": {
       "const": "hsl_to_hex"
      }
     }
    },
    "then": {
     "required": [
      "h",
      "s",
      "l"
     ]
    }
   }
  ],
  "properties": {
   "h": {
    "description": "Hue 0 to 360 (for hsl_to_hex)",
    "maximum": 360,
    "minimum": 0,
    "type": "number"
   },
   "hex": {
    "description": "Hex colour code, e.g. #1FE85C (for hex_to_hsl)",
    "pattern": "^#?([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
    "type": "string"
   },
   "l": {
    "description": "Lightness 0 to 100 (for hsl_to_hex)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "mode": {
    "description": "Direction of conversion",
    "enum": [
     "hex_to_hsl",
     "hsl_to_hex"
    ],
    "type": "string"
   },
   "s": {
    "description": "Saturation 0 to 100 (for hsl_to_hex)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "mode"
  ],
  "type": "object"
 },
 "name": "hopi_hsl_converter",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "hex": {
    "type": "string"
   },
   "hsl": {
    "type": "array"
   },
   "hslString": {
    "type": "string"
   },
   "mode": {
    "type": "string"
   },
   "rgbString": {
    "type": "string"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "hex",
   "hslString",
   "mode",
   "rgbString",
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "HSL converter"
}
