{
 "description": "Get tasks for the current or specified sprint. Returns all tasks with their status, assignee, and ticket details.",
 "inputSchema": {
  "properties": {
   "projectId": {
    "description": "The project ID",
    "type": "string"
   },
   "status": {
    "description": "Filter by status (default: all)",
    "enum": [
     "all",
     "todo",
     "in_progress",
     "done"
    ],
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "get_sprint_tasks"
}
