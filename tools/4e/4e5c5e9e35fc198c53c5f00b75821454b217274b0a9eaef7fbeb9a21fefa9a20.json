{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Validate a monitor definition without creating it (check query syntax, thresholds, etc.)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "message": {
    "description": "Notification message",
    "type": "string"
   },
   "name": {
    "description": "Monitor name to validate",
    "type": "string"
   },
   "options": {
    "additionalProperties": {},
    "description": "Monitor options (thresholds, etc.)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "priority": {
    "description": "Priority 1-5",
    "type": "number"
   },
   "query": {
    "description": "Monitor query to validate",
    "type": "string"
   },
   "tags": {
    "description": "Tags for the monitor",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Monitor type (e.g. metric alert, log alert, query alert)",
    "type": "string"
   }
  },
  "required": [
   "name",
   "type",
   "query"
  ],
  "type": "object"
 },
 "name": "validate-monitor"
}
