{
 "_meta": {
  "openai/fileParams": [
   "file"
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find where a lap loses time"
 },
 "description": "Use this when asking where am I losing time: rank the five distance sectors where one lap loses most against the best valid lap. Upload an AiM RaceStudio CSV export or paste its CSV text. Do not use for corner speeds or braking point comparison.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "csv_text": {
    "maxLength": 20000000,
    "type": "string"
   },
   "file": {
    "properties": {
     "download_url": {
      "maxLength": 2048,
      "type": "string"
     },
     "file_id": {
      "maxLength": 256,
      "type": "string"
     },
     "file_name": {
      "maxLength": 256,
      "type": "string"
     },
     "mime_type": {
      "maxLength": 128,
      "type": "string"
     }
    },
    "required": [
     "download_url",
     "file_id"
    ],
    "type": "object"
   },
   "lap": {
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "find_time_loss",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "lap": {
    "type": "number"
   },
   "lap_time_s": {
    "type": "number"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reference_lap": {
    "type": "number"
   },
   "reference_time_s": {
    "type": "number"
   },
   "rush": {
    "additionalProperties": false,
    "properties": {
     "label": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "label",
     "url"
    ],
    "type": "object"
   },
   "segments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "end_m": {
       "type": "number"
      },
      "loss_s": {
       "type": "number"
      },
      "start_m": {
       "type": "number"
      }
     },
     "required": [
      "start_m",
      "end_m",
      "loss_s"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_loss_s": {
    "type": "number"
   }
  },
  "required": [
   "lap",
   "reference_lap",
   "lap_time_s",
   "reference_time_s",
   "total_loss_s",
   "segments",
   "notes",
   "rush"
  ],
  "type": "object"
 },
 "title": "Find where a lap loses time"
}
