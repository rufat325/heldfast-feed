{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read email preferences"
 },
 "description": "Returns job-alert settings and cadence, Autopilot result-email mode, product-update consent and the all-optional-emails-off state. jobAlertEligibility separately reports delivery restrictions such as bounce or unsubscribe. Account, security, billing and essential employer mail are outside these settings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "get_communication_preferences",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allOptionalEmailsOff": {
    "type": "boolean"
   },
   "autopilotResults": {
    "enum": [
     "individual",
     "daily_digest",
     "off"
    ],
    "type": "string"
   },
   "autopilotResultsOffAt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "When Autopilot results were last turned off."
   },
   "jobAlertEligibility": {
    "additionalProperties": false,
    "properties": {
     "eligible": {
      "type": "boolean"
     },
     "reason": {
      "enum": [
       "eligible",
       "off",
       "inactive",
       "unsubscribed",
       "address_suppressed",
       "banned",
       "retired"
      ],
      "type": "string"
     },
     "resumesOnActivity": {
      "description": "Whether using the product again would start them up.",
      "type": "boolean"
     }
    },
    "required": [
