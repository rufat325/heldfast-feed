     "twice_weekly",
     "off"
    ],
    "type": "string"
   },
   "productUpdates": {
    "type": "boolean"
   }
  },
  "required": [
   "jobAlerts",
   "autopilotResults",
   "productUpdates",
   "allOptionalEmailsOff",
   "autopilotResultsOffAt",
   "jobAlertEligibility"
  ],
  "type": "object"
 },
 "title": "Read email preferences"
}
