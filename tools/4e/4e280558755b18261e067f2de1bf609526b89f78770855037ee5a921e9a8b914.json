    "type": "string"
   },
   "candle_limit": {
    "maximum": 300,
    "minimum": 5,
    "type": "integer"
   },
   "product_id": {
    "pattern": "^[A-Za-z0-9]{2,15}-[A-Za-z0-9]{2,15}$",
    "type": "string"
   },
   "trade_limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "product_id"
  ],
  "type": "object"
 },
 "name": "market_snapshot"
}
