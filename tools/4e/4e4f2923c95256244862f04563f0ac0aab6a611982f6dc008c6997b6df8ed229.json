 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Open the visual review board for one to five inspected Psychopathia research candidates. Supply canonical IDs obtained from this server. Retrieves corpus entries only; it does not accept diagnoses, conversation history, scores, or model-authored evidence. Useful after inspecting differential_diagnosis and get_dysfunction results. Text clients receive the same corpus-derived comparison without needing a UI.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "pattern_ids": {
    "items": {
     "maxLength": 256,
     "minLength": 1,
     "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "pattern_ids"
  ],
  "type": "object"
 },
 "name": "render_pattern_review",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "corpus": {
    "additionalProperties": false,
    "properties": {
     "corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "pattern_layer_version": {
      "type": "string"
     },
     "taxonomy_version": {
      "type": "string"
     },
     "total": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "taxonomy_version",
     "pattern_layer_version",
     "corpus_sha256",
     "total"
    ],
    "type": "object"
   },
   "notice": {
    "type": "string"
   },
   "patterns": {
    "items": {
     "properties": {
      "diagnostic_reliability": {
       "type": "object"
      },
      "display_id": {
       "type": "string"
      },
      "dysfunction_name": {
       "type": "string"
      },
      "evidence": {
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "review": {
       "type": "object"
      }
     },
     "required": [
      "id",
      "display_id",
      "dysfunction_name",
      "review",
      "evidence",
      "diagnostic_reliability"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "schema_version": {
    "const": "pm-review/1",
    "type": "string"
   }
  },
  "required": [
   "schema_version",
   "patterns",
   "corpus",
   "notice"
  ],
  "type": "object"
 }
}
