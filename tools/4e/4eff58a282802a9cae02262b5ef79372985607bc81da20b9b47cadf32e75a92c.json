    "type": "string"
   },
   "idempotency_key": {
    "description": "Any unique string (for example a UUID) so retries return the same purchase and checkout link.",
    "maxLength": 100,
    "minLength": 8,
    "type": "string"
   },
   "purchase_id": {
    "description": "From an earlier payment_required result, to retrieve the package after the user paid.",
    "maxLength": 64,
    "type": "string"
   },
   "url": {
    "description": "Website to fix. Required unless purchase_id is given.",
    "maxLength": 2048,
    "minLength": 3,
    "type": "string"
   }
  },
  "type": "object"
