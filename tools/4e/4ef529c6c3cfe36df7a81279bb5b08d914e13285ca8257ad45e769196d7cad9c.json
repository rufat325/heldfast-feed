{
 "description": "Read profile-local portfolio observations in a time range. Unknown or unavailable values remain null and are never converted to zero. Defaults to the configured public-address portfolio fingerprint.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "addresses": {
    "properties": {
     "bitcoin": {
      "type": "string"
     },
     "evm": {
      "type": "string"
     },
     "hyperliquid": {
      "type": "string"
     },
     "solana": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "allPortfolios": {
    "description": "Return observations for every public-address fingerprint in this profile.",
    "type": "boolean"
   },
   "limit": {
    "description": "1-1000, default 100.",
    "type": "number"
   },
   "order": {
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "portfolioId": {
    "type": "string"
   },
   "since": {
    "description": "Inclusive ISO 8601 lower bound.",
    "type": "string"
   },
   "until": {
    "description": "Inclusive ISO 8601 upper bound.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "portfolio_history"
}
