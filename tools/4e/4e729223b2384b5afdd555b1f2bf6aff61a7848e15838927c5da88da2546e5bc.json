{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Generate a promotional short video from structured product information, features, call to action and optional website. When: Use when an agent needs a publish-ready product or service promotion from structured marketing input. Selection: specialized; prefer for Use when an agent needs a publish-ready product or service promotion from structured marketing input.. Minimum required input: productName, description, features, callToAction, language, durationSeconds, aspectRatio, voice, subtitles, backgroundMusic. Price: $2.00 USD per call. A free preview is available through preview_capability before payment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "aspectRatio": {
    "default": "9:16",
    "enum": [
     "9:16",
     "16:9",
     "1:1"
    ],
    "type": "string"
   },
   "backgroundMusic": {
    "default": true,
    "type": "boolean"
   },
   "callToAction": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "maxLength": 3000,
    "minLength": 1,
    "type": "string"
   },
   "durationSeconds": {
    "default": 30,
    "maximum": 120,
    "minimum": 5,
    "type": "integer"
   },
   "features": {
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "language": {
    "default": "en",
    "maxLength": 32,
    "minLength": 2,
    "type": "string"
   },
   "productName": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "subtitles": {
    "default": true,
    "type": "boolean"
   },
   "voice": {
    "default": "auto",
    "maxLength": 128,
    "type": "string"
   },
   "website": {
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "productName",
   "description",
   "features",
   "callToAction"
  ],
  "type": "object"
 },
 "name": "product_promo_video",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "assets": {
    "additionalProperties": false,
    "properties": {
     "audioUrl": {
      "anyOf": [
       {
        "format": "uri",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "materialUrls": {
      "items": {
       "format": "uri",
       "type": "string"
      },
      "type": "array"
     },
     "subtitleUrl": {
      "anyOf": [
       {
        "format": "uri",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "audioUrl",
     "subtitleUrl",
     "materialUrls"
    ],
    "type": "object"
   },
   "billing": {
    "additionalProperties": false,
    "properties": {
     "priceUsd": {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    },
    "required": [
     "priceUsd"
    ],
    "type": "object"
   },
   "capability": {
    "type": "string"
   },
   "content": {
    "additionalProperties": false,
    "properties": {
     "language": {
      "type": "string"
     },
     "script": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "script",
     "language"
    ],
    "type": "object"
   },
   "engine": {
    "additionalProperties": false,
    "properties": {
     "provider": {
      "const": "MoneyPrinterTurbo",
      "type": "string"
     },
     "upstreamTaskId": {
      "type": "string"
     }
    },
    "required": [
     "provider",
     "upstreamTaskId"
    ],
    "type": "object"
   },
   "generatedAt": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": false,
    "properties": {
     "sourceUrls": {
      "items": {
       "format": "uri",
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "sourceUrls"
    ],
    "type": "object"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "task": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "status": {
      "enum": [
       "processing",
       "completed"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "status"
    ],
    "type": "object"
   },
   "video": {
    "additionalProperties": false,
    "properties": {
     "aspectRatio": {
      "enum": [
       "9:16",
       "16:9",
       "1:1"
      ],
      "type": "string"
     },
     "durationSeconds": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "resolution": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "url",
     "durationSeconds",
     "aspectRatio",
     "resolution"
    ],
    "type": "object"
   }
  },
  "required": [
   "success",
   "capability",
   "task",
   "video",
   "content",
   "assets",
   "engine",
   "billing",
   "generatedAt"
  ],
  "type": "object"
 }
}
