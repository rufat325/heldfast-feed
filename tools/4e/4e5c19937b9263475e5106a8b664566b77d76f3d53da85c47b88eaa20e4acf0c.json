{
 "description": "List raw time entries (intervals) grouped by day for a date range (max 100 days). Paged by day \u2014 use `page` for older days.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Start date yyyy-MM-dd (use with `to`)",
    "type": "string"
   },
   "page": {
    "description": "Page number, 0-based (default 0)",
    "minimum": 0,
    "type": "integer"
   },
   "period": {
    "description": "Named period; alternative to explicit from/to",
    "enum": [
     "today",
     "yesterday",
     "this_week",
     "last_week",
     "this_month",
     "last_month",
     "last_7_days",
     "last_30_days"
    ],
    "type": "string"
   },
   "size": {
    "description": "Days per page (default 20, max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "tags": {
    "description": "Filter to these tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timezone": {
    "description": "IANA timezone (default: user's timezone)",
    "type": "string"
   },
   "to": {
    "description": "End date yyyy-MM-dd, inclusive",
    "type": "string"
   },
   "type_ids": {
    "description": "Filter to these exact activity type ids (internal \u2014 never show ids to the user)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type_names": {
    "description": "Filter to these activity type names (groups allowed)",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "list_intervals"
}
