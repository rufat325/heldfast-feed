{
 "description": "Document management: list folders, list/get documents, search, download (OAuth2 required for downloads)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action",
    "enum": [
     "list_folders",
     "get_folder",
     "list",
     "get",
     "get_by_employee",
     "search",
     "download_payslips",
     "download"
    ],
    "type": "string"
   },
   "document_pattern": {
    "description": "Document name pattern (for search)",
    "type": "string"
   },
   "employee_id": {
    "description": "Employee ID",
    "type": "number"
   },
   "employee_name": {
    "description": "Employee name (for search)",
    "type": "string"
   },
   "folder_id": {
    "description": "Folder ID filter",
    "type": "number"
   },
   "id": {
    "description": "Folder/document ID",
    "type": "number"
   },
   "limit": {
    "default": 100,
    "description": "Items per page",
    "type": "number"
   },
   "output_dir": {
    "description": "Output directory (for downloads)",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "factorial_documents",
 "title": "FactorialHR Documents"
}
