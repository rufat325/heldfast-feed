{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an AIS vessel scaffold with sanitized vessel rows, zone maps, route hints, adapter source, and receiver/privacy notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "websocket_json",
    "enum": [
     "rest_json",
     "websocket_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "ws://127.0.0.1:9075/ais",
    "type": "string"
   },
   "name": {
    "default": "ais_vessel_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the AIS scaffold.",
    "type": "string"
   },
   "provider": {
    "default": "ais_receiver",
    "enum": [
     "ais_receiver",
     "marine_traffic_adapter",
     "aishub_adapter",
     "custom"
    ],
    "type": "string"
   },
   "route_count": {
    "default": 6,
    "maximum": 256,
    "minimum": 0,
    "type": "integer"
   },
   "vessel_count": {
    "default": 24,
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "waterway_label": {
    "default": "harbor",
    "type": "string"
   },
   "zone_count": {
    "default": 4,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_ais_vessel_bus",
 "title": "Connect AIS vessel bus"
}
