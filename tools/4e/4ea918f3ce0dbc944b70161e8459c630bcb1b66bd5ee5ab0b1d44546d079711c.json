{
 "description": "Registra uma mem\u00f3ria p\u00fablica explicitamente escolhida pelo participante. Nada \u00e9 memorizado automaticamente.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "detail": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "kind": {
    "enum": [
     "interest",
     "commitment",
     "insight",
     "relationship",
     "game_moment"
    ],
    "type": "string"
   },
   "label": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "session_token": {
    "type": "string"
   },
   "source_thread_id": {
    "pattern": "^[a-f0-9]{64}$",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "session_token",
   "kind",
   "label",
   "detail"
  ],
  "type": "object"
 },
 "name": "nexo_remember",
 "title": "Guardar mem\u00f3ria p\u00fablica volunt\u00e1ria"
}
