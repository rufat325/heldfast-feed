{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read job preferences"
 },
 "description": "Returns stated target functions, work locations and modes, relocation, pay floor, availability, deal-breakers, seniority, AI-role interest and cover-letter settings. unanswered identifies preference keys the account holder has not supplied. It does not return resume content or work history.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "get_preferences",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "preferences": {
    "additionalProperties": false,
    "properties": {
     "acceptedWorkModes": {
      "items": {
       "enum": [
        "remote",
        "hybrid",
        "onsite"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "aiRoleInterest": {
      "enum": [
       "HIGH",
       "OPEN",
       "LOW",
       "AVOID"
      ],
      "type": "string"
     },
     "availability": {
      "oneOf": [
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "immediate",
          "type": "string"
         }
        },
        "required": [
         "kind"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "date": {
          "description": "Local date, YYYY-MM-DD.",
          "type": "string"
         },
         "kind": {
          "const": "specific_date",
          "type": "string"
         }
        },
        "required": [
         "kind",
         "date"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "notice_period",
          "type": "string"
         },
         "noticePeriodDays": {
          "maximum": 365,
          "minimum": 1,
          "type": "integer"
         }
        },
        "required": [
         "kind",
         "noticePeriodDays"
        ],
        "type": "object"
       }
      ]
     },
     "compensation": {
      "description": "A USD per-year minimum must be between 10,000 and 1,000,000; other currencies and hourly rates are unbounded.",
      "oneOf": [
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "open",
          "type": "string"
         }
        },
        "required": [
         "kind"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "currency": {
          "description": "ISO-4217 code, e.g. \"USD\".",
          "pattern": "^[A-Z]{3}$",
          "type": "string"
         },
         "kind": {
          "const": "minimum",
          "type": "string"
         },
         "minimumAmount": {
          "exclusiveMinimum": 0,
          "maximum": 100000000,
          "type": "number"
         },
         "period": {
          "enum": [
           "hour",
           "year"
          ],
          "type": "string"
         }
        },
        "required": [
         "kind",
         "minimumAmount",
         "currency",
         "period"
        ],
        "type": "object"
       }
      ]
     },
     "coverLettersEnabled": {
      "type": "boolean"
     },
     "dealBreakers": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "preferredLocations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "seniorities": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "targetFunctions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "willingToRelocate": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "unanswered": {
    "description": "Preference keys the person has never answered.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "preferences",
   "unanswered"
  ],
  "type": "object"
 },
 "title": "Read job preferences"
}
