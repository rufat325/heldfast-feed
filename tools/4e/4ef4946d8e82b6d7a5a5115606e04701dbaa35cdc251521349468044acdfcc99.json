  "title": "My subscriptions"
 },
 "description": "Use this when a signed in customer asks about their teas.co.uk tea subscriptions (repeat deliveries): what each one sends, how often, the next delivery, the price and whether it is active or paused. It takes no input and lists every subscription on the linked account, each with the id that change_subscription needs. An empty list means there are none. Without a linked account it returns an error asking the customer to sign in. These are delivery schedules and never take automatic card payments. To pause, resume or cancel one use change_subscription.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "my_subscriptions",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "subscriptions": {
    "items": {
     "properties": {
      "cycle": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "next_delivery": {
       "type": [
        "string",
        "null"
       ]
      },
      "note": {
       "type": "string"
      },
      "price_text": {
       "type": [
        "string",
        "null"
       ]
      },
      "product": {
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "product",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "subscriptions",
   "count"
  ],
  "type": "object"
 },
 "securitySchemes": [
