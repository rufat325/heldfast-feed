{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Fetch one shipped preset by name (stem): its raw .prt text plus a parsed summary. Unknown name returns an error listing the valid names.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "The preset filename stem (see list_presets), e.g. \"explosion\".",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_preset",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "doc": {
    "description": "The preset's raw .prt JSON text.",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "duration": {
      "type": "number"
     },
     "layerCount": {
      "type": "integer"
     },
     "looping": {
      "type": "boolean"
     },
     "meta": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "name": {
          "type": "string"
         },
         "notes": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "notes"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "schemaVersion": {
      "type": "integer"
     }
    },
    "required": [
     "layerCount",
     "schemaVersion",
     "duration",
     "looping",
     "meta"
    ],
    "type": "object"
   }
  },
  "required": [
   "name",
   "doc",
   "summary"
  ],
  "type": "object"
 },
 "title": "Get Preset"
}
