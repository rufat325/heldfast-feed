{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns the full issue list for either one cluster ID or one issue ID from the most recent check_project or check_files call. Read-only; no files are written or modified. Supply exactly one of clusterId or issueId \u2014 supplying both or neither returns an argument error. If the referenced cluster or issue no longer exists in the latest results (e.g., after re-running a check), returns a status: \"stale\" response instead of an error; call check_project or check_files again to refresh.",
 "inputSchema": {
  "additionalProperties": false,
  "oneOf": [
   {
    "required": [
     "clusterId"
    ]
   },
   {
    "required": [
     "issueId"
    ]
   }
  ],
  "properties": {
   "checkId": {
    "type": "string"
   },
   "clusterId": {
    "type": "string"
   },
   "issueId": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_issue_detail",
 "outputSchema": {
  "properties": {
   "code": {
    "type": "string"
   },
   "issues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "clusterId": {
       "type": "string"
      },
      "col": {
       "type": "integer"
      },
      "engine": {
       "enum": [
        "oxlint",
        "tsc",
        "biome",
        "eslint"
       ],
       "type": "string"
      },
      "file": {
       "type": "string"
      },
      "fixable": {
       "type": "boolean"
      },
      "issueId": {
       "type": "string"
      },
      "line": {
       "type": "integer"
      },
      "message": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning"
       ],
       "type": "string"
      }
     },
     "required": [
      "issueId",
      "file",
      "line",
      "col",
      "engine",
      "rule",
      "severity",
      "message",
      "fixable"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "status": {
    "enum": [
     "stale",
     "error"
    ],
    "type": "string"
   }
  },
  "type": "object"
 }
}
