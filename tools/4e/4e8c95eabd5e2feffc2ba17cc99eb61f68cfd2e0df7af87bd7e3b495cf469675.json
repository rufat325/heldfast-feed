    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "currency": {
    "const": "ZAR",
    "type": "string"
   },
   "customer": {
    "additionalProperties": true,
    "properties": {
     "address": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "city": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [],
    "type": "object"
   },
   "item_count": {
    "type": "number"
   },
   "items": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": true,
       "properties": {
        "colour": {
         "type": "string"
        },
        "finish": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "height": {
         "type": "number"
        },
        "mountType": {
         "type": "string"
        },
        "price": {
         "type": "number"
        },
        "productId": {
         "type": "string"
        },
        "productName": {
         "type": "string"
        },
        "quantity": {
         "type": "number"
        },
        "total": {
         "type": "number"
        },
        "width": {
         "type": "number"
        }
       },
       "required": [],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "message": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "payment_method": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "payment_status": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "payment_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "provider_reference": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "total_zar": {
    "type": "number"
   }
  },
  "required": [
   "checkout_id",
