{
 "description": "Phase 1 of 2 in the purchase flow. Convert a cart (or inline items + customer) into a checkout. Customer name, email, and phone are required. Returns checkout_id. No payment link is minted yet \u2014 call complete_checkout for that. Use update_checkout to correct customer details before finalising.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "cart_id"
    ]
   },
   {
    "properties": {
     "customer": {
      "required": [
       "name",
       "email",
       "phone"
      ]
     }
    },
    "required": [
     "items",
     "customer"
    ]
   }
  ],
  "properties": {
   "cart_id": {
    "description": "Either cart_id or items required",
    "type": "string"
   },
   "customer": {
    "properties": {
     "address": {
      "type": "string"
     },
     "city": {
      "type": "string"
     },
     "email": {
      "description": "Real customer email, checked before checkout creation",
      "type": "string"
     },
     "name": {
      "description": "Real customer name, checked before checkout creation",
      "type": "string"
     },
     "phone": {
      "description": "South African phone number, checked before checkout creation",
      "type": "string"
     }
    },
    "type": "object"
   },
   "items": {
    "items": {
     "properties": {
      "colour": {
       "description": "Exact available colour; validate with configure_product before adding",
       "minLength": 1,
       "type": "string"
      },
      "finish": {
       "description": "Optional pricing finish for aluminium Venetians",
       "type": "string"
      },
      "height_mm": {
       "description": "Actual ordered drop in millimetres",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "mount_type": {
       "description": "Use inside for recess fit or outside for face fix",
       "minLength": 1,
       "type": "string"
      },
      "product_id": {
       "description": "product_id returned by search_catalog or lookup_catalog",
       "type": "string"
      },
      "product_name": {
       "description": "Optional; server resolves the catalogue name",
       "type": "string"
      },
      "quantity": {
       "description": "Number of blinds; defaults to 1",
       "type": "number"
      },
      "total_price_zar": {
       "description": "Optional, ignored: server recalculates all totals",
       "type": "number"
      },
      "unit_price_zar": {
       "description": "Optional, ignored: server recalculates all prices",
       "type": "number"
      },
      "width_mm": {
       "description": "Actual ordered width in millimetres",
       "exclusiveMinimum": 0,
       "type": "number"
      }
     },
     "required": [
      "product_id",
      "width_mm",
      "height_mm",
      "colour",
      "mount_type"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "payment_method": {
    "description": "Default 'yoco'",
    "enum": [
     "yoco",
     "ozow"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_checkout",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "ap2": {
    "additionalProperties": true,
    "properties": {
