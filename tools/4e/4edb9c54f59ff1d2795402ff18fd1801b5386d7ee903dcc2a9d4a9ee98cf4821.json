{
 "description": "Capture a screenshot of a web page. Returns the hosted image URL and, for images up to 2 MB, the image itself so you can see the page.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adblock": {
    "description": "Block ads",
    "type": "boolean"
   },
   "block_cookie_banner": {
    "description": "Hide cookie consent banners",
    "type": "boolean"
   },
   "device_scale_factor": {
    "description": "1 = standard, 2 = retina, 3 = high-dpi",
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "format": {
    "description": "Image format. Default png",
    "enum": [
     "png",
     "jpeg",
     "webp"
    ],
    "type": "string"
   },
   "full_page": {
    "description": "Capture the whole scrollable page. Default true",
    "type": "boolean"
   },
   "light_mode": {
    "description": "Force light or dark color scheme",
    "enum": [
     "default",
     "light",
     "dark"
    ],
    "type": "string"
   },
   "selector": {
    "description": "CSS selector of a single element to capture",
    "type": "string"
   },
   "url": {
    "description": "Page to capture (http:// or https://)",
    "format": "uri",
    "type": "string"
   },
   "viewport_height": {
    "description": "Viewport height in pixels. Default 1080",
    "maximum": 3840,
    "minimum": 16,
    "type": "integer"
   },
   "viewport_width": {
    "description": "Viewport width in pixels. Default 1920",
    "maximum": 3840,
    "minimum": 16,
    "type": "integer"
   },
   "wait_ms": {
    "description": "Extra wait before capturing, in ms",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "screenshot_url",
 "title": "Screenshot a web page"
}
