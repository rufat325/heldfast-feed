{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"YNAB: Get Transaction Details"},"description":"Get full details for a single transaction by ID.\n\nArgs:\n  - budget_id (string, optional): Budget UUID. Omit to use the default budget.\n  - transaction_id (string, required): Transaction UUID.\n  - response_format (string, optional): \"json\" or \"markdown\" (default: \"markdown\").\n\nReturns: transaction (id, date, amount, memo, cleared, approved, account_id, payee_name, category_name, subtransactions), cached, cache_info\n\nErrors:\n  - \"No default budget set\" \u2192 run ynab_set_default_budget first\n  - \"Transaction not found\" \u2192 invalid transaction_id","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"budget_id":{"minLength":1,"type":"string"},"response_format":{"default":"markdown","enum":["json","markdown"],"type":"string"},"transaction_id":{"minLength":1,"type":"string"}},"required":["transaction_id"],"type":"object"},"name":"ynab_get_transaction","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"cache_info":{"description":"Human-readable cache status message (e.g., \"Cache hit\", \"Cache miss\")","type":"string"},"cached":{"description":"Indicates if data was served from cache","type":"boolean"},"transaction":{"additionalProperties":false,"description":"Transaction details","properties":{"account_id":{"type":"string"},"account_name":{"type":"string"},"amount":{"description":"Amount in decimal currency units","type":"number"},"amount_currency":{"type":"number"},"amount_formatted":{"type":["string","null"]},"amount_milliunits":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"approved":{"type":"boolean"},"category_id":{"type":["string","null"]},"category_name":{"type":["string","null"]},"cleared":{"type":"string"},"date":{"type":"string