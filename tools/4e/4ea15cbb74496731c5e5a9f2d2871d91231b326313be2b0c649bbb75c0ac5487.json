{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get Datadog events within a time range, optionally filtered by priority, source, or tags",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "end": {
    "description": "End time as Unix epoch seconds. Example: 1740003600",
    "type": "number"
   },
   "page": {
    "description": "Page number for pagination",
    "type": "number"
   },
   "priority": {
    "description": "Event priority filter",
    "enum": [
     "low",
     "normal"
    ],
    "type": "string"
   },
   "sources": {
    "description": "Comma-separated event sources. Example: datadog,nginx",
    "type": "string"
   },
   "start": {
    "description": "Start time as Unix epoch seconds. Example: 1740000000",
    "type": "number"
   },
   "tags": {
    "description": "Comma-separated tags to filter. Example: env:prod,service:api",
    "type": "string"
   },
   "unaggregated": {
    "description": "Return unaggregated events",
    "type": "boolean"
   }
  },
  "required": [
   "start",
   "end"
  ],
  "type": "object"
 },
 "name": "get-events"
}
