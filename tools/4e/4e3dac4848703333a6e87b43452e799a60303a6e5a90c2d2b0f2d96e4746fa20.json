{
 "description": "Read collected browser console logs; filter by level (info/warning/error/debug) and/or regex; optionally clear the buffer after reading.",
 "inputSchema": {
  "properties": {
   "clear": {
    "default": false,
    "description": "Clear the buffer after reading",
    "type": "boolean"
   },
   "level": {
    "description": "Filter by log level",
    "enum": [
     "info",
     "warning",
     "error",
     "debug"
    ],
    "type": "string"
   },
   "pattern": {
    "description": "Regex matched against log text",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "console_logs"
}
