{
 "description": "Search SF beverage SKUs by item name, with optional category filter and geo search. Returns sku_id, merchant, distance, size, and price in integer cents.",
 "inputSchema": {
  "properties": {
   "category": {
    "enum": [
     "coffee",
     "matcha",
     "chai"
    ],
    "type": "string"
   },
   "lat": {
    "type": "number"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "type": "integer"
   },
   "lon": {
    "type": "number"
   },
   "max_miles": {
    "type": "number"
   },
   "q": {
    "description": "item name substring, e.g. 'matcha latte'",
    "type": "string"
   },
   "sort": {
    "default": "distance",
    "enum": [
     "price",
     "distance"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_skus"
}
