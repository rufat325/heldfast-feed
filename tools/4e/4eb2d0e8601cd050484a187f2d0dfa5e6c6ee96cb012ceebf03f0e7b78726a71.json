\u0442\u0438 \u0437\u0430\u043a\u0440\u044b\u0442\u0430; volcano_red \u0438 volcano_orange \u2014 \u043a\u043e\u0434 KVERT \u043d\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0435; signals_unknown \u2014 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0443\u0437\u043d\u0430\u0442\u044c \u0442\u043e, \u0447\u0442\u043e \u0441\u043f\u043e\u0441\u043e\u0431\u043d\u043e \u0441\u043a\u0440\u044b\u0442\u044c \u0437\u0430\u043f\u0440\u0435\u0442; alert_warning \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435; out_of_season \u2014 \u0432\u043d\u0435 \u0441\u0435\u0437\u043e\u043d\u0430; clear \u2014 \u043f\u0440\u0435\u043f\u044f\u0442\u0441\u0442\u0432\u0438\u0439 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u043e","enum":["alert_ban","point_closed","volcano_red","weather_severe","signals_unknown","volcano_orange","alert_warning","out_of_season","clear"],"type":"string"},"id":{"description":"id \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430","type":"string"},"match":{"description":"high \u2014 \u043c\u0430\u0440\u0448\u0440\u0443\u0442 \u043d\u0430\u0437\u0432\u0430\u043d \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u043c; low \u2014 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0445\u043e\u0436\u0435 \u043d\u0430 \u0437\u0430\u043f\u0440\u043e\u0441 (\u0434\u0440\u0443\u0433\u043e\u0435 \u0447\u0438\u0441\u043b\u043e \u0438\u043b\u0438 \u043f\u0430\u0434\u0435\u0436): \u044d\u0442\u043e \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0434\u0440\u0443\u0433\u043e\u0439 \u043c\u0430\u0440\u0448\u0440\u0443\u0442, \u0443\u0442\u043e\u0447\u043d\u0438\u0442\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0443 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430","enum":["high","low"],"type":"string"},"park_name":{"description":"\u041e\u0445\u0440\u0430\u043d\u044f\u0435\u043c\u0430\u044f \u0442\u0435\u0440\u0440\u0438\u0442\u043e\u0440\u0438\u044f \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430, \u043a\u0430\u043a \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u0430 \u0432 \u0431\u0430\u0437\u0435; \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u043f\u043e\u0441\u0435\u0449\u0435\u043d\u0438\u044f \u2014 \u0443 \u0435\u0451 \u0434\u0438\u0440\u0435\u043a\u0446\u0438\u0438","type":["string","null"]},"reason":{"description":"\u041f\u0440\u0438\u0447\u0438\u043d\u0430 \u043e\u0446\u0435\u043d\u043a\u0438 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u0440\u043e\u043a\u043e\u0439","type":"string"},"title":{"type":"string"},"today":{"description":"\u041e\u0446\u0435\u043d\u043a\u0430 \u0443\u0441\u043b\u043e\u0432\u0438\u0439 \u043d\u0430 \u0441\u0435\u0433\u043e\u0434\u043d\u044f: go \u2014 \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0439, \u043e\u043f\u0430\u0441\u043d\u044b\u0445 \u043a\u043e\u0434\u043e\u0432 \u0432\u0443\u043b\u043a\u0430\u043d\u043e\u0432 \u0438 \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u0445 \u0442\u043e\u0447\u0435\u043a \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u043e (\u043d\u0435 \u0433\u0430\u0440\u0430\u043d\u0442\u0438\u044f \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438); caution \u2014 \u0435\u0441\u0442\u044c \u043f\u0440\u0438\u0447\u0438\u043d\u0430 \u0434\u043b\u044f \u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u043e\u0441\u0442\u0438 \u0438\u043b\u0438 \u0434\u0430\u043d\u043d\u044b\u0445 \u043c\u0430\u043b\u043e; no \u2014 \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u043d\u0435 \u0438\u0434\u0442\u0438. \u042d\u0442\u043e \u043d\u0435 \u043e\u0444\u0438\u0446\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u0431\u044e\u043b\u043b\u0435\u0442\u0435\u043d\u044c","enum":["go","caution","no"],"type":"string"},"unknown":{"description":"\u0427\u0442\u043e \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c: \u043f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u044f, \u0432\u0443\u043b\u043a\u0430\u043d\u044b \u043d\u0430 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0435, \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u0435 \u0442\u043e\u0447\u043a\u0438. \u041d\u0435\u043f\u0443\u0441\u0442\u043e\u0439 \u0441\u043f\u0438\u0441\u043e\u043a \u043e\u0446\u0435\u043d\u043a\u0443 go \u0438\u0441\u043a\u043b\u044e\u0447\u0430\u0435\u0442","items":{"type":"string"},"type":"array"},"url":{"description":"\u0410\u0434\u0440\u0435\u0441 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u043d\u0430 \u0412\u0435\u0434\u0430\u0440\u0435","type":"string"}},"required":["id","title","url","today","code","reason","unknown","alerts","park_name","match"],"type":"object"},"type":"array"}},"required":["found","places","routes"],"type":"object"},"title":"Place safety"}
