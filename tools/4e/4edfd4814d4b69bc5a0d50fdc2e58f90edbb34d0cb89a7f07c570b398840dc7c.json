{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Fix or pause a metric feed"
 },
 "description": "Change a feed's arguments, mapping, cadence, or pause it. Reach for this when a feed's last run reports `empty` (the response shape moved, so the mapping needs a new path) or `error`. Changing the mapping changes what the number means, so say what you're changing and why. May return `needs_confirmation`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approvalId": {
    "type": "string"
   },
   "enabled": {
    "description": "false pauses it; the definition and history are kept.",
    "type": "boolean"
   },
   "id": {
    "description": "Feed id, from ledger_feeds_list.",
    "type": "string"
   },
   "label": {
    "maxLength": 120,
    "type": "string"
   },
   "mapping": {
    "properties": {
     "atPath": {
      "maxLength": 200,
      "type": "string"
     },
     "seriesPath": {
      "maxLength": 200,
      "type": "string"
     },
     "shape": {
      "enum": [
       "scalar",
       "series"
      ],
      "type": "string"
     },
     "valuePath": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "required": [
     "shape",
     "valuePath"
    ],
    "type": "object"
   },
   "schedule": {
    "properties": {
     "dayOfWeek": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     "interval": {
      "enum": [
       "hourly",
       "daily",
       "weekly"
      ],
      "type": "string"
     },
     "time": {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     "timezone": {
      "maxLength": 64,
      "type": "string"
     }
    },
    "required": [
     "interval"
    ],
    "type": "object"
   },
   "toolArgs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "toolName": {
    "type": "string"
   },
   "windowHours": {
    "maximum": 9600,
    "minimum": 1,
    "type": "integer"
   },
   "workspace": {
    "description": "Workspace slug. Omit to use the pinned workspace.",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "ledger_feeds_update",
 "title": "Fix or pause a metric feed"
}
