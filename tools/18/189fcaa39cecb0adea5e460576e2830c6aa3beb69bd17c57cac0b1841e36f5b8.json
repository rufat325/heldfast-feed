{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Audit website pages the way AI reads them"
 },
 "description": "Read up to five public pages the way an AI crawler receives them, without running JavaScript. Returns sourced sections, table cells, internal and outside links and declared structured data, plus each page's type, source type and readiness findings with the documentation behind them, repeated declared facts to review, and the remaining request budget. Partial or unreadable pages are reported as such. Runs no AI queries and measures no visibility.",
 "inputSchema": {
  "properties": {
   "urls": {
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "title": "Urls",
    "type": "array"
   }
  },
  "required": [
   "urls"
  ],
  "title": "inspectedArguments",
  "type": "object"
 },
 "name": "surfacedby_inspect_page_evidence",
