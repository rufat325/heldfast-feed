{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Summarize the content in a mod or find a free event ID across the mod, game and dependencies. Use overview for descriptors, folders and definitions (the 50 busiest namespaces; pass a namespace or prefix to list those starting with it), or next_id with a namespace or prefix. Example: {\"mode\":\"next_id\",\"kind\":\"event\",\"namespace\":\"my_mod\"}. Returns a compact summary; the first call indexes the mod, which takes seconds on a large one.","inputSchema":{"additionalProperties":false,"properties":{"kind":{"default":"event","enum":["event","focus","decision","idea","leader","technology"],"type":"string"},"layer":{"default":"mod","enum":["mod","all"],"type":"string"},"mode":{"default":"overview","enum":["overview","next_id"],"type":"string"},"namespace":{"maxLength":256,"minLength":1,"type":"string"},"prefix":{"maxLength":256,"minLength":1,"type":"string"},"workspaceId":{"default":"current","pattern":"^[a-z][a-z0-9_-]{0,63}$","type":"string"}},"type":"object"},"name":"hoi4.mod_index","outputSchema":{"additionalProperties":false,"properties":{"artifacts":{"items":{},"maxItems":32,"type":"array"},"blockers":{"items":{},"type":"array"},"changedFiles":{"items":{},"type":"array"},"code":{"type":"string"},"data":{"additionalProperties":{},"properties":{},"type":"object"},"diagnostics":{"items":{},"maxItems":20,"type":"array"},"filesScanned":{"items":{},"type":"array"},"proposedFiles":{"items":{},"type":"array"},"status":{"enum":["ok","blocked","error"],"type":"string"},"validation":{},"workspaceId":{"type":"string"}},"required":["status","code","workspaceId","validation","data"],"type":"object"},"title":"Explore mod content and find free IDs"}
