{
 "description": "Accept or dismiss a model-switch suggestion by ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "\"accept\" to apply it, \"dismiss\" to ignore",
    "enum": [
     "accept",
     "dismiss"
    ],
    "type": "string"
   },
   "id": {
    "description": "Suggestion ID from get_suggestions",
    "type": "number"
   }
  },
  "required": [
   "id",
   "action"
  ],
  "type": "object"
 },
 "name": "update_suggestion"
}
