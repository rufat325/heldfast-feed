    "type": "string"
   },
   "property_uid": {
    "description": "The property's UID.",
    "type": "string"
   },
   "to": {
    "description": "Last day (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
