{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Tip calculator"
 },
 "description": "Work out a tip on a bill and optionally split the total between people. Returns the tip amount, the total, and the amount per person. Source: https://hopi.co.uk/tip-calculator/",
 "inputSchema": {
  "properties": {
   "bill": {
    "description": "The bill amount before tip",
    "type": "number"
   },
   "split": {
    "default": 1,
    "description": "Number of people to split between (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "tipPercent": {
    "default": 12.5,
    "description": "Tip as a percentage (default 12.5)",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "bill"
  ],
  "type": "object"
 },
 "name": "hopi_tip_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "bill": {
    "type": "number"
   },
   "perPerson": {
    "type": "number"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "split": {
    "type": "number"
   },
   "summary": {
    "type": "string"
   },
   "tip": {
    "type": "number"
   },
   "tipPercent": {
    "type": "number"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Tip calculator"
}
