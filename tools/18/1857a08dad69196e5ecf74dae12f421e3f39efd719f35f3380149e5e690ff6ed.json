{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Send email"
 },
 "description": "Send an email to a contact, raw address, or as a reply in an existing thread (threadId). Subject is required for new threads. Written to the outbox only; nothing leaves the sandbox.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "body": {
    "minLength": 1,
    "type": "string"
   },
   "contactId": {
    "type": "string"
   },
   "employeeId": {
    "description": "Sender; defaults to the company address",
    "type": "string"
   },
   "relatedIds": {
    "description": "Records this email is about",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "subject": {
    "type": "string"
   },
   "threadId": {
    "type": "string"
   },
   "to": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "body"
  ],
  "type": "object"
 },
 "name": "inbox_send_email",
 "title": "Send email"
}
