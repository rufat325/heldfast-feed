{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Cfpb Complaint Trends"
 },
 "description": "Time-series trends of complaint volume. lens=overview shows total complaints over time; lens=product shows by product; lens=company shows by company; lens=issue shows by issue. Interval can be month, quarter, or year.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date_received_max": {
    "description": "YYYY-MM-DD upper bound",
    "type": "string"
   },
   "date_received_min": {
    "description": "YYYY-MM-DD lower bound",
    "type": "string"
   },
   "lens": {
    "description": "Trend dimension",
    "enum": [
     "overview",
     "product",
     "issue",
     "company"
    ],
    "type": "string"
   },
   "product": {
    "description": "Filter to a specific product",
    "type": "string"
   },
   "sub_lens": {
    "description": "Optional sub-dimension",
    "type": "string"
   },
   "trend_depth": {
    "description": "Top N to track (default 5)",
    "type": "number"
   },
   "trend_interval": {
    "description": "Time bucket size",
    "enum": [
     "month",
     "quarter",
     "year"
    ],
    "type": "string"
   }
  },
  "required": [
   "lens"
  ],
  "type": "object"
 },
 "name": "cfpb_complaint_trends"
}
