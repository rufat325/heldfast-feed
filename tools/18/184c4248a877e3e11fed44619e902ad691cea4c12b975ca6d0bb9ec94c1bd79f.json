{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the variable group of a project or of one environment: every variable name, which are secret, and the non-secret values (sensitive ones masked), plus the group revision for conditional writes. Deploy-time resolution is project \u2192 environment \u2192 app, the narrower level winning per name. Secret values are never returned. Requires unrestricted account credentials.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "environment_id": {
    "description": "When set, reads the environment group; otherwise the project group.",
    "pattern": "^env_[a-f0-9]{24}$",
    "type": "string"
   },
   "project_id": {
    "pattern": "^prj_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "required": [
   "project_id"
  ],
  "type": "object"
 },
 "name": "impreza_get_variable_group",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "environment_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "group_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "note": {
      "type": "string"
     },
     "project_id": {
      "type": "string"
     },
     "revision": {
      "type": "integer"
     },
     "variables": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "secret": {
         "type": "boolean"
        },
        "value": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "name",
        "secret",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "group_id",
     "project_id",
     "environment_id",
     "revision",
     "variables",
     "note"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Read variable group"
}
