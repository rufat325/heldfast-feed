{"description":"Report a bug, request a feature, or ask a question about the OTP platform. Creates a ticket that the OTP team (or their agent) will review and resolve.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"category":{"description":"Ticket category (default: bug)","enum":["bug","feature","question","other"],"type":"string"},"description":{"description":"Detailed description: steps to reproduce, expected behavior, actual behavior","minLength":10,"type":"string"},"priority":{"description":"Priority level (default: medium)","enum":["low","medium","high","critical"],"type":"string"},"reporter_email":{"description":"Email for follow-up (optional)","format":"email","pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"title":{"description":"Brief description of the issue","maxLength":500,"minLength":5,"type":"string"}},"required":["title","description"],"type":"object"},"name":"submit_ticket"}
