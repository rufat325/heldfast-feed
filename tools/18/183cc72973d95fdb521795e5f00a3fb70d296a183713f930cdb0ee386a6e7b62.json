{"_meta":{"openai/outputTemplate":"ui://wemake/reise-v1.html","openai/toolInvocation/invoked":"Hotel found","openai/toolInvocation/invoking":"Looking up the hotel\u2026","openai/widgetAccessible":true,"ui":{"resourceUri":"ui://wemake/reise-v1.html","visibility":["model","app"]}},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Find a specific hotel by its name \u2014 typos and run-together names are fine (e.g. 'MeeStyleGarrage'). Optionally narrow by country (ISO code) and place. Returns the best matches with id, address, stars, rating and link; use the id with get_hotel, or search_hotels for prices.","inputSchema":{"additionalProperties":false,"properties":{"country":{"description":"optional ISO country code, e.g. TH \u2014 faster and more precise","type":"string"},"language":{"description":"answer language, ISO code (default en)","type":"string"},"name":{"description":"hotel name (typos are fine)","type":"string"},"place":{"description":"optional city or district, e.g. Bangkok","type":"string"}},"required":["name"],"type":"object"},"name":"find_hotel","outputSchema":{"additionalProperties":false,"properties":{"hotels":{"items":{"additionalProperties":false,"properties":{"address":{"type":"string"},"city":{"type":"string"},"country":{"type":"string"},"id":{"type":"string"},"image":{"type":"string"},"lat":{"type":"number"},"lon":{"type":"number"},"name":{"type":"string"},"rating":{"type":"number"},"reviews":{"type":"integer"},"stars":{"type":"number"},"url":{"type":"string"}},"required":["id","name","url"],"type":"object"},"type":["null","array"]},"note":{"type":"string"}},"required":["hotels"],"type":"object"},"title":"Find a hotel by name"}
