{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a percentage discount code with an explicit start date and customer audience. Defaults to dryRun:true, which resolves segments and previews the discount without creating it.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "appliesOncePerCustomer": {
    "default": false,
    "type": "boolean"
   },
   "code": {
    "minLength": 1,
    "type": "string"
   },
   "collectionId": {
    "pattern": "^gid:\\/\\/shopify\\/Collection\\/[0-9]+$",
    "type": "string"
   },
   "customerEligibility": {
    "const": "all_customers",
    "type": "string"
   },
   "customerSegments": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "dryRun": {
    "default": true,
    "description": "True (the default) returns a before/after preview without changing anything in Shopify. Pass false, after the user authorizes this store and exact change, to apply it; the tool then reads the result back.",
    "type": "boolean"
   },
   "endsAt": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "minimumPurchaseAmount": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "minimumQuantity": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "percentage": {
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "productIds": {
    "items": {
     "pattern": "^gid:\\/\\/shopify\\/Product\\/[0-9]+$",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "startsAt": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "store": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   },
   "usageLimit": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "store",
   "title",
   "code",
   "percentage",
   "startsAt"
  ],
  "type": "object"
 },
 "name": "shopify_create_discount"
}
