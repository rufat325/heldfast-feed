{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create invoice"
 },
 "description": "Create a new invoice. Requires invoices:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "description": "Invoice amount (required)",
    "minimum": 0,
    "type": "number"
   },
   "category_id": {
    "description": "Cost category ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "due_date": {
    "description": "Due date (ISO 8601)",
    "type": "string"
   },
   "invoice_date": {
    "description": "Invoice date (ISO 8601, required)",
    "type": "string"
   },
   "invoice_number": {
    "description": "Invoice number (required)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "description": "Notes",
    "type": "string"
   },
   "paid_date": {
    "description": "Paid date (ISO 8601)",
    "type": "string"
   },
   "project_id": {
    "description": "Project ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "purchase_order_id": {
    "description": "Purchase order ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "status": {
    "description": "Invoice status",
    "enum": [
     "pending",
     "approved",
     "paid",
     "voided"
    ],
    "type": "string"
   },
   "tax_amount": {
    "description": "Tax amount",
    "minimum": 0,
    "type": "number"
   },
   "vendor_id": {
    "description": "Vendor ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "work_order_id": {
    "description": "Work order ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "invoice_number",
   "amount",
   "invoice_date"
  ],
  "type": "object"
 },
 "name": "create_invoice",
 "title": "Create invoice"
}
