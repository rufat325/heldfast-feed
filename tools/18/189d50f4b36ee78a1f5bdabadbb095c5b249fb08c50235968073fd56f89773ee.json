   },
   "benchmark_symbol": {
    "description": "Benchmark fetched live (e.g. SPY) for beta/alpha/correlation.",
    "pattern": "^[A-Za-z][A-Za-z0-9.\\-]{0,11}$",
    "type": "string"
   },
   "kelly": {
    "additionalProperties": false,
    "description": "Bet parameters for the Kelly fraction (enables kelly).",
