{
 "description": "Search YouTube videos by intent. Returns compact ranked results with provenance and engagement hints. [~1-3s]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channelId": {
    "type": "string"
   },
   "dryRun": {
    "type": "boolean"
   },
   "duration": {
    "enum": [
     "any",
     "short",
     "medium",
     "long"
    ],
    "type": "string"
   },
   "maxResults": {
    "maximum": 25,
    "minimum": 1,
    "type": "number"
   },
   "order": {
    "enum": [
     "relevance",
     "date",
     "viewCount",
     "rating"
    ],
    "type": "string"
   },
   "publishedAfter": {
    "type": "string"
   },
   "publishedBefore": {
    "type": "string"
   },
   "query": {
    "description": "Search query",
    "type": "string"
   },
   "regionCode": {
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "findVideos"
}
