{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "GitHub Search"
 },
 "description": "Discover GitHub code with operation:\"code\", repositories with \"repositories\", or a known repository tree with \"tree\". Code search covers the default branch; tree accepts branch. Read known paths with ghGetFileContent. Empty or incomplete search results do not prove absence.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "queries": {
    "description": "Parallel queries; response rows use matching zero-based indexes.",
    "items": {
     "oneOf": [
      {
       "additionalProperties": false,
       "properties": {
        "concise": {
         "description": "Flat \"owner/repo:path\" rows.",
         "type": "boolean"
        },
        "extension": {
         "description": "File extension filter, e.g. \"ts\" (no dot).",
         "type": "string"
        },
        "filename": {
         "description": "Exact filename filter.",
         "type": "string"
        },
        "goal": {
         "description": "What this query should accomplish.",
         "type": "string"
        },
        "keywords": {
         "description": "ANDed; keep a phrase as one item; alternatives need separate queries.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "language": {
         "description": "GitHub language filter, e.g. \"typescript\".",
         "type": "string"
        },
        "match": {
         "default": "file",
         "description": "For operation:\"code\": \"file\" returns snippets; \"path\" returns paths only.",
         "enum": [
          "file",
          "path"
         ],
         "type": "string"
        },
        "operation": {
         "const": "code",
         "description": "Search code contents or file paths.",
         "type": "string"
        },
        "owner": {
         "description": "Repository owner (user or org).",
         "type": "string"
        },
        "page": {
         "default": 1,
         "description": "Result page, 1-based. Advance only while pagination.hasMore.",
         "maximum": 1000,
         "minimum": 1,
         "type": "integer"
        },
        "pageSize": {
         "default": 30,
         "description": "Results returned per page.",
         "maximum": 100,
         "minimum": 1,
         "type": "integer"
        },
        "path": {
         "description": "Repo path prefix, not a full file path.",
         "type": "string"
        },
        "reasoning": {
         "description": "Why this query advances the goal.",
         "type": "string"
        },
        "repo": {
         "description": "Repository name, without the owner.",
         "type": "string"
        }
       },
       "required": [
        "operation"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "archived": {
         "description": "true = archived only; default excludes archived.",
         "type": "boolean"
        },
        "concise": {
         "description": "Flat \"owner/repo\" rows for triage.",
         "type": "boolean"
        },
        "created": {
         "description": "Creation date: \">2023-01-01\" or \"a..b\".",
         "type": "string"
        },
        "forks": {
         "description": "Fork range: \">50\", \"10..100\".",
         "type": "string"
        },
        "goal": {
         "description": "What this query should accomplish.",
         "type": "string"
        },
        "goodFirstIssues": {
         "description": "Good-first-issue count range, e.g. \">5\".",
         "type": "string"
        },
        "keywords": {
         "description": "ANDed; keep a phrase as one item; alternatives need separate queries.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "language": {
         "description": "Primary language filter, e.g. \"rust\".",
         "type": "string"
        },
        "license": {
         "description": "SPDX id, e.g. \"mit\".",
         "type": "string"
        },
        "match": {
         "description": "For operation:\"repositories\": fields to search: name, description, or readme.",
         "items": {
          "enum": [
           "name",
           "description",
           "readme"
          ],
          "type": "string"
         },
         "type": "array"
        },
        "operation": {
         "const": "repositories",
         "description": "Discover repositories by keywords and repository filters.",
         "type": "string"
        },
        "owner": {
         "description": "Repository owner (user or org).",
         "type": "string"
        },
        "page": {
         "default": 1,
         "description": "Result page, 1-based. Advance only while pagination.hasMore.",
         "maximum": 1000,
         "minimum": 1,
         "type": "integer"
        },
        "pageSize": {
         "default": 30,
         "description": "Results returned per page.",
         "maximum": 100,
         "minimum": 1,
         "type": "integer"
        },
        "reasoning": {
         "description": "Why this query advances the goal.",
         "type": "string"
        },
        "size": {
         "description": "Repo size in KB: \">1000\", \"50..500\".",
         "type": "string"
        },
        "sort": {
         "default": "best-match",
         "description": "stars, forks, updated, help-wanted-issues, best-match.",
         "enum": [
          "stars",
          "forks",
          "help-wanted-issues",
          "updated",
          "best-match"
         ],
         "type": "string"
        },
        "stars": {
         "description": "Star range: \">100\", \"10..50\".",
         "type": "string"
        },
        "topics": {
         "description": "Repository topics; all must match.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "updated": {
         "description": "Last push date: \">2024-01-01\" or \"a..b\".",
         "type": "string"
        },
        "visibility": {
         "description": "\"public\" or \"private\" (private needs token scope).",
         "enum": [
          "public",
          "private"
         ],
         "type": "string"
        }
       },
       "required": [
        "operation"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "branch": {
         "description": "Ref; fallback warning means default branch was used.",
         "type": "string"
        },
        "goal": {
         "description": "What this query should accomplish.",
         "type": "string"
        },
        "include": {
         "description": "Optional sizes, languages, contributors, branches, or tags; each adds an API call.",
         "items": {
          "enum": [
           "sizes",
           "languages",
           "contributors",
           "branches",
           "tags"
          ],
          "type": "string"
         },
         "type": "array"
        },
        "maxDepth": {
         "description": "Tree recursion depth.",
         "maximum": 20,
         "minimum": 0,
         "type": "integer"
        },
        "metadataPage": {
         "default": 1,
         "description": "Page of the requested contributors, branches, or tags; follow next for each list independently.",
         "maximum": 1000,
         "minimum": 1,
         "type": "integer"
        },
        "operation": {
         "const": "tree",
         "description": "Browse the tree of a known repository.",
         "type": "string"
        },
        "owner": {
         "description": "Repository owner (user or org).",
         "type": "string"
        },
        "page": {
         "default": 1,
         "description": "Advance only on hasMore.",
         "maximum": 1000,
         "minimum": 1,
         "type": "integer"
        },
        "pageSize": {
         "default": 100,
         "description": "Tree entries returned per page.",
         "maximum": 200,
         "minimum": 1,
         "type": "integer"
        },
        "path": {
         "description": "Repo-relative directory; \"\"/\".\" for root.",
         "type": "string"
        },
        "reasoning": {
         "description": "Why this query advances the goal.",
         "type": "string"
        },
        "repo": {
         "description": "Repository name, without the owner.",
         "type": "string"
        }
       },
       "required": [
        "owner",
        "repo",
        "operation"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "responseCharLength": {
    "description": "Full-response char window.",
    "maximum": 50000,
    "minimum": 1,
    "type": "integer"
   },
   "responseCharOffset": {
    "description": "Full-response char offset; re-call with returned value when hasMore.",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "queries"
  ],
  "type": "object"
 },
 "name": "ghSearch",
 "title": "GitHub Search"
}
