 "description": "Perform collection operations: CRUD, browse public collections, view public/shared/system collections, or collect quotes. Auth required for create/get/update/delete/list/collect_from_public.\n\nWhen to use: User wants to save, organize, or manage their quote collections, or browse/view public collections.\n\nExamples:\n- `collection(action=\"browse\", tab=\"featured\")` - browse public collections\n- `collection(action=\"public_detail\", username=\"curator\", slug=\"favorites\")` - view public collection\n- `collection(action=\"shared_detail\", token=\"abc123\")` - view shared collection\n- `collection(action=\"collect_from_public\", username=\"curator\", slug=\"favorites\", quote_code=\"xyz\")` - collect quote",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Collection operation",
    "enum": [
     "create",
     "get",
     "update",
     "delete",
     "list",
     "browse",
     "public_detail",
     "shared_detail",
     "system_detail",
     "collect_from_public"
    ],
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Collection description (used for create/update)"
   },
   "limit": {
    "default": 25,
