     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Collection name/slug (required for create/get/update/delete)"
   },
   "page": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Page number"
   },
   "page_size": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Items per page"
   },
   "quote_code": {
    "anyOf": [
     {
      "type": "string"
