{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Pay and place the order"
 },
 "description": "Charge the payment credential the platform obtained for a session that is ready_for_payment and create the order. Input follows the ChatGPT payment-sheet contract: checkout_session_id, buyer, payment_data { token, provider: 'stripe', billing_address }. The token is a Stripe shared payment token (spt_\u2026); platforms without one should send the user to pay_online_url from create_checkout. After payment the patient gets an email link to add date of birth, sex, phone and consent \u2014 the lab requisition is issued when that is done.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "buyer": {
    "anyOf": [
     {
      "properties": {
       "email": {
        "anyOf": [
         {
          "format": "email",
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "first_name": {
        "anyOf": [
         {
          "maxLength": 80,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "last_name": {
        "anyOf": [
         {
          "maxLength": 80,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 160,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "phone_number": {
        "anyOf": [
         {
          "maxLength": 20,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "checkout_session_id": {
    "maxLength": 80,
    "minLength": 8,
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 128,
    "type": "string"
   },
   "payment_data": {
    "properties": {
     "billing_address": {
      "anyOf": [
       {
        "properties": {
         "city": {
          "type": "string"
         },
         "country": {
          "type": "string"
         },
         "line_one": {
          "type": "string"
         },
         "line_two": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "postal_code": {
          "type": "string"
         },
         "state": {
          "type": "string"
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "provider": {
      "description": "'stripe'",
      "maxLength": 40,
      "type": "string"
     },
     "token": {
      "maxLength": 400,
      "minLength": 4,
      "type": "string"
     }
    },
    "required": [
     "token"
    ],
    "type": "object"
   }
  },
  "required": [
   "checkout_session_id",
   "payment_data"
  ],
  "type": "object"
 },
 "name": "complete_checkout",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "id": {
    "type": "string"
   },
   "messages": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "content": {
       "type": "string"
      },
      "type": {
       "enum": [
        "info",
        "error"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "order": {
    "additionalProperties": false,
    "properties": {
     "checkout_session_id": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "permalink_url": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "checkout_session_id",
     "permalink_url"
    ],
    "type": "object"
   },
   "status": {
    "type": "string"
   },
   "totals": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "type": "number"
      },
      "display_text": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "display_text",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "status",
   "totals",
   "messages"
  ],
  "type": "object"
 },
 "title": "Pay and place the order"
}
