{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an Orbbec/Kinect-compatible depth silhouette scaffold with synthetic/file fallbacks, stable silhouette_out and depth_preview TOPs, and explicit hardware/SDK validation warnings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "description": "Start device/file source active where supported.",
    "type": "boolean"
   },
   "far_threshold": {
    "default": 0.8,
    "description": "Far depth cutoff.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "invert": {
    "default": false,
    "description": "Invert the silhouette mask.",
    "type": "boolean"
   },
   "movie_file": {
    "description": "Movie/depth file for source=file.",
    "type": "string"
   },
   "name": {
    "default": "orbbec_depth_silhouette",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "near_threshold": {
    "default": 0.2,
    "description": "Near depth cutoff.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Orbbec silhouette.",
    "type": "string"
   },
   "smooth": {
    "default": 1.5,
    "description": "Blur size for mask smoothing.",
    "minimum": 0,
    "type": "number"
   },
   "source": {
    "default": "synthetic",
    "description": "Depth source path. Synthetic is the offline-safe default.",
    "enum": [
     "orbbec_top",
     "kinect_azure_orbbec",
     "file",
     "synthetic"
    ],
    "type": "string"
   },
   "source_top_path": {
    "description": "Existing TOP path to select instead of creating a device/file source.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_orbbec_depth_silhouette",
 "title": "Create Orbbec depth silhouette"
}
