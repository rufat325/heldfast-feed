{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new version of a partial by updating its content or metadata. Only provided fields change, and the new version stays inactive until publish_partial makes it current.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "Description for this version",
    "type": "string"
   },
   "name": {
    "description": "New display name for the partial",
    "type": "string"
   },
   "prompt_partial_id": {
    "description": "Prompt partial ID or slug to update",
    "type": "string"
   },
   "status": {
    "description": "New status for the partial",
    "enum": [
     "active",
     "archived"
    ],
    "type": "string"
   },
   "string": {
    "description": "New content for the partial",
    "type": "string"
   }
  },
  "required": [
   "prompt_partial_id"
  ],
  "type": "object"
 },
 "name": "update_prompt_partial",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
