{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks whether one specific model runs on one specific machine, at what memory cost, and roughly how fast. Needs a hardware id and a model id from search_catalog. Returns a fit verdict, the memory arithmetic, and a decode-speed range with a confidence label. Memory is sized from all parameters, speed from active parameters. It does not recommend purchases and does not run anything.",
 "inputSchema": {
  "properties": {
   "context_length": {
    "default": 4096,
    "description": "Context window in tokens that the KV cache is sized for. 512 to 262144. Default 4096.",
    "maximum": 262144,
    "minimum": 512,
    "type": "integer"
   },
   "hardware_id": {
    "description": "Hardware id from search_catalog.",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-z0-9][a-z0-9._-]*$",
    "type": "string"
   },
   "model_id": {
    "description": "Model id from search_catalog.",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-z0-9][a-z0-9._-]*$",
    "type": "string"
   },
   "quantisation": {
    "default": "Q4_K_M",
    "description": "Weight quantisation. One of Q2_K, Q3_K_M, Q4_K_M, Q5_K_M, Q6_K, Q8_0, F16. Default Q4_K_M.",
    "enum": [
     "Q2_K",
     "Q3_K_M",
     "Q4_K_M",
     "Q5_K_M",
     "Q6_K",
     "Q8_0",
     "F16"
    ],
    "type": "string"
   }
  },
  "required": [
   "hardware_id",
   "model_id"
  ],
  "type": "object"
 },
 "name": "check_hardware_fit",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "context_length": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "data_as_of": {
    "description": "Date the bundled catalogue was last updated. Not the time of this call.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "hardware": {
    "additionalProperties": false,
    "properties": {
     "bandwidth_gb_s": {
      "description": "Theoretical peak memory bandwidth.",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
     },
     "memory_gb": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "memory_kind": {
      "enum": [
       "dedicated",
       "unified",
       "shared-system"
      ],
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "type": "string"
     },
     "status": {
      "description": "announced means not yet on sale; eol means no longer made.",
      "enum": [
       "current",
       "eol",
       "used-market",
       "announced"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "memory_gb",
     "memory_kind",
     "bandwidth_gb_s",
     "status"
    ],
    "type": "object"
   },
   "memory": {
    "additionalProperties": false,
    "description": "Memory arithmetic for the requested quantisation and context length.",
    "properties": {
     "available_gb": {
      "description": "Memory usable for the model after any operating-system reserve.",
      "minimum": 0,
      "type": "number"
     },
     "confidence": {
      "enum": [
       "measured",
       "estimated",
       "community"
      ],
      "type": "string"
     },
     "headroom_gb": {
      "description": "available - needed. Negative when the model does not fit.",
      "type": "number"
     },
     "kv_basis": {
      "description": "Whether the KV cache is computed from a published config or inferred from the parameter count.",
      "enum": [
       "published_architecture",
       "inferred_architecture"
      ],
      "type": "string"
     },
     "kv_cache_gb": {
      "minimum": 0,
      "type": "number"
     },
     "needed_gb": {
      "description": "weights + KV cache + overhead.",
      "minimum": 0,
      "type": "number"
     },
     "offloaded_gb": {
      "description": "Weights that would live in system RAM. 0 when fully resident.",
      "minimum": 0,
      "type": "number"
     },
     "overhead_gb": {
      "description": "Fixed framework overhead.",
      "minimum": 0,
      "type": "number"
     },
     "weights_gb": {
      "description": "All parameters quantised. For a Mixture-of-Experts model this counts every expert.",
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "weights_gb",
     "kv_cache_gb",
     "overhead_gb",
     "needed_gb",
     "available_gb",
     "headroom_gb",
     "offloaded_gb",
     "confidence",
     "kv_basis"
    ],
    "type": "object"
   },
   "model": {
    "additionalProperties": false,
    "properties": {
     "active_params_b": {
      "description": "Parameters read per token in billions. Equals total for dense models. Sets speed, never memory.",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
     },
     "is_moe": {
      "type": "boolean"
     },
     "name": {
      "maxLength": 120,
      "type": "string"
     },
     "total_params_b": {
      "description": "Total parameters in billions. Sets memory residency.",
      "exclusiveMinimum": 0,
      "type": "number"
     }
    },
    "required": [
     "id",
     "name",
     "total_params_b",
     "active_params_b",
     "is_moe"
    ],
    "type": "object"
   },
   "notes": {
    "items": {
     "maxLength": 300,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "quantisation": {
    "enum": [
     "Q2_K",
     "Q3_K_M",
     "Q4_K_M",
     "Q5_K_M",
     "Q6_K",
     "Q8_0",
     "F16"
    ],
    "type": "string"
   },
   "sources": {
    "description": "Primary sources for the model and hardware records. May be empty.",
    "items": {
     "pattern": "^https:\\/\\/",
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "speed": {
    "anyOf": [
     {
      "additionalProperties": false,
      "description": "Decode speed in tokens per second, always a range with a confidence label.",
      "properties": {
       "basis": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "description": "Where the figure comes from, e.g. a benchmark label. null for a modelled estimate."
       },
       "confidence": {
        "enum": [
         "measured",
         "estimated",
         "community"
        ],
        "type": "string"
       },
       "high_tok_s": {
        "minimum": 0,
        "type": "number"
       },
       "last_verified": {
        "anyOf": [
         {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "low_tok_s": {
        "minimum": 0,
        "type": "number"
       },
       "sample_count": {
        "anyOf": [
         {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "description": "Number of measured runs behind a measured or community figure."
       }
      },
      "required": [
       "low_tok_s",
       "high_tok_s",
       "confidence",
       "basis",
       "sample_count",
       "last_verified"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "null when the model does not fit, because a speed for hardware that cannot load the weights would be invented."
   },
   "summary": {
    "description": "One or two plain-language sentences stating the answer.",
    "maxLength": 600,
    "type": "string"
   },
   "url": {
    "pattern": "^https:\\/\\/llmconfigurator\\.com\\/en\\/",
    "type": "string"
   },
   "verdict": {
    "enum": [
     "fits_comfortably",
     "fits_tight",
     "needs_offload",
     "does_not_fit"
    ],
    "type": "string"
   }
  },
  "required": [
   "data_as_of",
   "summary",
   "verdict",
   "quantisation",
   "context_length",
   "model",
   "hardware",
   "memory",
   "speed",
   "notes",
   "sources",
   "url"
  ],
  "type": "object"
 },
 "title": "Check whether a model fits hardware"
}
