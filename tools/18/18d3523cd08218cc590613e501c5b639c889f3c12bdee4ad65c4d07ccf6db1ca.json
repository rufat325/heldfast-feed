  "readOnlyHint": false,
  "title": "Save a strategy"
 },
 "description": "Save a new private strategy using custom Python files and complete rules text, on any Premiss-supported market and timeframe. Accepts either files (strategy.py plus helper modules) and rules, or a convenience template. Uses the same package format as the app. Returns code and revision; saving does not run a backtest.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "maxLength": 65536,
       "type": "string"
      },
      "path": {
       "maxLength": 1024,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "path",
      "content"
     ],
     "type": "object"
    },
    "maxItems": 16,
    "minItems": 1,
    "type": "array"
   },
   "interval": {
    "enum": [
     "1m",
     "3m",
     "5m",
     "15m",
     "30m",
     "1h",
     "2h",
     "4h",
     "6h",
     "8h",
     "12h",
     "1d",
     "3d",
     "1w",
     "1M"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "request_key": {
    "description": "Idempotency UUID identifying one requested write and its unchanged arguments.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "rules": {
    "additionalProperties": false,
    "properties": {
     "buys": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "safety": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "sells": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     },
     "watches": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "watches",
     "buys",
     "sells",
     "safety"
    ],
    "type": "object"
   },
   "symbol": {
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   },
   "template": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "family": {
        "const": "sma_crossover",
        "type": "string"
       },
       "fast": {
        "maximum": 100,
        "minimum": 2,
        "type": "integer"
       },
       "slow": {
        "maximum": 300,
        "minimum": 3,
        "type": "integer"
       }
      },
      "required": [
       "family",
       "fast",
       "slow"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "enter_below": {
        "maximum": 45,
        "minimum": 5,
        "type": "number"
       },
       "exit_above": {
        "maximum": 95,
        "minimum": 55,
        "type": "number"
       },
       "family": {
        "const": "rsi_threshold",
        "type": "string"
       },
       "period": {
        "maximum": 100,
        "minimum": 2,
        "type": "integer"
       }
      },
      "required": [
       "family",
       "period",
       "enter_below",
       "exit_above"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "entry_bars": {
        "maximum": 300,
        "minimum": 2,
        "type": "integer"
       },
       "exit_bars": {
        "maximum": 300,
        "minimum": 2,
        "type": "integer"
       },
       "family": {
        "const": "price_channel",
        "type": "string"
       }
      },
      "required": [
       "family",
       "entry_bars",
       "exit_bars"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "request_key",
   "name",
   "symbol",
   "interval"
  ],
  "type": "object"
 },
