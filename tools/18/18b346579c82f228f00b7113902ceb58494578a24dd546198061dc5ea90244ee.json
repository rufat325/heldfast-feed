{
 "description": "Move a widget to a different sidebar",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "position": {
    "description": "0-based position in the target sidebar (default: append at the end)",
    "minimum": 0,
    "type": "integer"
   },
   "sidebar_id": {
    "description": "Target sidebar ID",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "widget_id": {
    "description": "Widget ID",
    "type": "string"
   }
  },
  "required": [
   "site",
   "widget_id",
   "sidebar_id"
  ],
  "type": "object"
 },
 "name": "mcp_move_widget"
}
