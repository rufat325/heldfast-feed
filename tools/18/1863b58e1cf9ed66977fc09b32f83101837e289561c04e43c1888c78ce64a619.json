 "description": "Hold spans to an attribute convention the caller states, including per span kind. The finding that matters most: a span name embedding an identifier. The name is the aggregation key, so a name per call means every call is its own operation and no latency distribution exists for it; identifiers belong in attributes. Also reports a required attribute absent, an attribute the contract forbids, reported by key and never by value, and an unrecognised span kind. Pay 160000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contract": {
    "additionalProperties": false,
    "example": {
     "forbid_high_cardinality_names": true,
     "forbidden_attributes": [
      "http.request.header.authorization"
     ],
     "require_known_kind": true,
     "required_attributes": [
      "service.name"
     ],
     "required_by_kind": {
      "SPAN_KIND_CLIENT": [
       "db.system"
      ],
      "SPAN_KIND_SERVER": [
       "http.request.method",
       "http.route"
      ]
     }
    },
    "properties": {
     "forbid_high_cardinality_names": {
      "description": "Defaults to true.",
      "type": "boolean"
     },
     "forbidden_attributes": {
      "items": {
       "maxLength": 256,
       "type": "string"
      },
      "maxItems": 200,
      "minItems": 1,
      "type": "array"
     },
     "require_known_kind": {
      "description": "Defaults to true.",
      "type": "boolean"
     },
     "required_attributes": {
      "items": {
       "maxLength": 256,
       "type": "string"
      },
      "maxItems": 200,
      "minItems": 1,
      "type": "array"
     },
     "required_by_kind": {
      "description": "Per span kind, the attributes every span of that kind must carry. A kind the specification does not define is reported as a rule that matched nothing.",
      "type": "object"
     }
    },
    "type": "object"
   },
   "spans": {
    "description": "A JSON array of span objects. Both snake_case and camelCase field names are read, because exporters differ. Timestamps may be RFC 3339 or epoch numbers. Nothing is fetched: no backend is queried and no credential is accepted, so the data supplied is the whole input.",
    "example": "[\n {\n  \"trace_id\": \"t1\",\n  \"span_id\": \"a\",\n  \"name\": \"GET /orders\",\n  \"kind\": \"SPAN_KIND_SERVER\",\n  \"start_time\": \"2026-10-02T12:00:00.000Z\",\n  \"end_time\": \"2026-10-02T12:00:00.500Z\",\n  \"attributes\": {\n   \"http.request.method\": \"GET\",\n   \"http.route\": \"/orders\"\n  }\n },\n {\n  \"trace_id\": \"t1\",\n  \"span_id\": \"b\",\n  \"parent_span_id\": \"a\",\n  \"name\": \"SELECT orders\",\n  \"kind\": \"SPAN_KIND_CLIENT\",\n  \"start_time\": \"2026-10-02T11:59:59.960Z\",\n  \"end_time\": \"2026-10-02T12:00:00.200Z\",\n  \"attributes\": {}\n },\n {\n  \"trace_id\": \"t1\",\n  \"span_id\": \"c\",\n  \"parent_span_id\": \"zz\",\n  \"name\": \"cache.get\",\n  \"start_time\": \"2026-10-02T12:00:00.100Z\",\n  \"end_time\": \"2026-10-02T12:00:00.110Z\",\n  \"attributes\": {}\n },\n {\n  \"trace_id\": \"t2\",\n  \"span_id\": \"d\",\n  \"name\": \"GET /orders/8827341/items\",\n  \"kind\": \"HTTP_SERVER\",\n  \"start_time\": \"2026-10-02T12:00:01.000\",\n  \"end_time\": \"2026-10-02T12:00:01.300Z\",\n  \"attributes\": {\n   \"http.request.method\": \"GET\"\n  }\n }\n]",
    "maxLength": 2097152,
    "type": "string"
   }
  },
  "required": [
   "spans",
   "contract"
  ],
  "type": "object"
 },
 "name": "span_attribute_contract_audit",
