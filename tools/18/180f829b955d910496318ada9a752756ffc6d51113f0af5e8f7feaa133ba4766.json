{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use when the submitter owns, hosts, sponsors, procures, or has a legitimate route to originate the opportunity. Control and economic use must be stated explicitly.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent_source": {
    "maxLength": 80,
    "type": "string"
   },
   "authority_access_state": {
    "maxLength": 300,
    "minLength": 2,
    "type": "string"
   },
   "commercial_intent": {
    "default": "exploring",
    "description": "Commercial readiness. No automatic charge; a fixed customer-specific payment request is issued only after scope and price are accepted.",
    "enum": [
     "exploring",
     "paid_verification_if_fit",
     "payment_request_after_scope",
     "formation_economics_if_verified"
    ],
    "type": "string"
   },
   "consent": {
    "const": true,
    "type": "boolean"
   },
   "country_location": {
    "maxLength": 220,
    "minLength": 1,
    "type": "string"
   },
   "current_state": {
    "maxLength": 2200,
    "minLength": 2,
    "type": "string"
   },
   "economic_consequence": {
    "maxLength": 2200,
    "minLength": 2,
    "type": "string"
   },
   "estimated_value": {
    "maxLength": 120,
    "type": "string"
   },
   "idempotency_key": {
    "description": "Recommended random retry key. Reuse only for retries of the exact same submission; it also acts as the private status token.",
    "maxLength": 200,
    "minLength": 32,
    "type": "string"
   },
   "name": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "maxLength": 1800,
    "type": "string"
   },
   "organization": {
    "maxLength": 240,
    "type": "string"
   },
   "rights_status": {
    "enum": [
     "owner",
     "written_mandate",
     "open_procurement",
     "private_initiative",
     "site_or_host_permission",
     "permission_pending"
    ],
    "type": "string"
   },
   "signal_name": {
    "maxLength": 220,
    "minLength": 1,
    "type": "string"
   },
   "summary": {
    "maxLength": 3000,
    "minLength": 20,
    "type": "string"
   },
   "support_needed": {
    "maxLength": 300,
    "type": "string"
   },
   "work_email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   }
  },
  "required": [
   "name",
   "work_email",
   "signal_name",
   "country_location",
   "summary",
   "authority_access_state",
   "rights_status",
   "current_state",
   "economic_consequence",
   "consent"
  ],
  "type": "object"
 },
 "name": "submit_authorized_opportunity",
 "title": "Submit a controlled opportunity"
}
