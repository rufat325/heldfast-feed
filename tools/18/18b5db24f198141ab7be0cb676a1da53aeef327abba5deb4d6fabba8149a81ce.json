 },
 "description": "A family's hub page as markdown \u2014 the written overview of that school of analysis plus its complete concept roster. Use after library_list_families, or when the user asks about a whole area like 'SMC' or 'Wyckoff'.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "key": {
    "description": "Family key, e.g. 'smc-ict'",
    "enum": [
     "trend",
     "momentum",
     "volatility",
     "volume-orderflow",
     "market-structure",
     "smc-ict",
     "wyckoff",
     "elliott-harmonics",
     "patterns",
     "levels",
     "statistics",
     "machine-learning",
     "time-seasonality",
     "sentiment-breadth",
     "risk-exits",
     "meta-composition",
     "validation"
    ],
    "type": "string"
   }
  },
  "required": [
   "key"
  ],
  "type": "object"
 },
 "name": "library_get_family",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Get a family hub"
}
