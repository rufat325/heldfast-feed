    "type": "string"
   },
   "source": {
    "description": "Whether setting is verified (\"measured\") or guess (\"recalled\"/\"assumed\")",
    "enum": [
     "measured",
     "recalled",
     "assumed"
    ],
    "type": "string"
   }
  },
  "required": [
