{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List bookmarks from Nextcloud Bookmarks app. Supports search, tag filtering, folder filtering, sorting, and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "folder": {
    "description": "Filter by folder ID (-1 for root)",
    "type": "number"
   },
   "limit": {
    "description": "Max bookmarks to return (default 10)",
    "type": "number"
   },
   "page": {
    "description": "Page number for pagination (starts at 0)",
    "type": "number"
   },
   "search": {
    "description": "Search term to filter bookmarks by title/URL/description",
    "type": "string"
   },
   "sortby": {
    "description": "Sort field",
    "enum": [
     "lastmodified",
     "title",
     "clickcount",
     "url",
     "added"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Filter by tags (e.g. ['tech', 'news'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "unavailable": {
    "description": "Only show unavailable bookmarks",
    "type": "boolean"
   },
   "untagged": {
    "description": "Only show bookmarks without tags",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_bookmarks",
 "title": "List Bookmarks"
}
