{"annotations":{"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Get deployment logs"},"description":"Read the raw log lines and uncaught exceptions a deployed workflow produced in the user's Cloudflare account, newest first. Use it when a run failed without explanation, or get_deployment_status shows errors you need to see. `source` in the answer says which log store responded; null means neither had anything for this window, which is not an error.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"limit":{"description":"Lines to return, 1-100. Default 50.","maximum":100,"minimum":1,"type":"integer"},"since":{"description":"Time window. Default 24h.","enum":["1h","24h","7d","30d"],"type":"string"},"source":{"description":"Force one store: Cloudflare Workers Logs, or the workflow's own log forwarder. Default tries the first, then the second.","enum":["workers_logs","tail"],"type":"string"},"workflowId":{"description":"The workflow's id, from list_workflows or create_workflow.","maxLength":100,"minLength":1,"type":"string"}},"required":["workflowId"],"type":"object"},"name":"get_deployment_logs","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":{},"properties":{"caveats":{"items":{"type":"string"},"type":"array"},"lines":{"items":{"additionalProperties":false,"properties":{"level":{"type":"string"},"message":{"type":"string"},"outcome":{"type":"string"},"requestId":{"type":"string"},"timestamp":{"type":"string"}},"type":"object"},"type":"array"},"rowsRead":{"type":"number"},"scriptName":{"type":"string"},"since":{"enum":["1h","24h","7d","30d"],"type":"string"},"source":{"anyOf":[{"enum":["workers_logs","tail"],"type":"string"},{"type":"null"}]},"unavailable":{"additionalProperties":false,"properties":{"code":{"type":"string"},"message":{"type":"string"},"remediation":{"type":"string"}},"required":["code","message","remediation"],"type":"object"},"workflowId":{"type":"string"}},"required":["workflowId","scriptName","since","source","lines","caveats"],"type":"object"},"title":"Get deployment logs"}
