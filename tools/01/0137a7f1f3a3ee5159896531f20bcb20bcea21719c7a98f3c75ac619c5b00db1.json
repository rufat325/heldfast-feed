    "description": "Optional non-empty role name or slug to filter to one role.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "tier": {
    "description": "Optional market tier; adds each role's measured span within that tier (tier_usd).",
    "enum": [
     "hub",
     "mid",
     "small"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
