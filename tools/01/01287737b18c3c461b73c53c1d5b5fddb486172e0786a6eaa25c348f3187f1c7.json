{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Whether a commissioned poem has been written yet. Delivered commissions come back with the poem's id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Commission id from commission_poem, e.g. c-1a2b3c4d",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "commission_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brief": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "poem_id": {
    "type": "string"
   },
   "receipt_url": {
    "type": "string"
   },
   "status": {
    "enum": [
     "pending",
     "delivered",
     "closed",
     "unknown"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "status"
  ],
  "type": "object"
 },
 "title": "Check a commission"
}
