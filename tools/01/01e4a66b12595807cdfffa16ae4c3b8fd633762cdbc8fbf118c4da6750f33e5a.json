    "type": "string"
   },
   "name": {
    "default": "livox_lidar_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Livox scaffold.",
    "type": "string"
   },
   "point_rate_hint": {
    "default": 240000,
    "maximum": 10000000,
    "minimum": 1,
    "type": "integer"
   },
   "receive_port": {
    "default": 56000,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "server_url": {
    "default": "ws://127.0.0.1:56000",
    "type": "string"
   },
   "zone_count": {
    "default": 8,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "create_livox_lidar_bus",
