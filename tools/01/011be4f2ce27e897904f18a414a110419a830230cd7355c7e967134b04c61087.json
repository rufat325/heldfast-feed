{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Log Egg Candling"
 },
 "description": "Log egg candling fertility results for an active batch. ALWAYS ask for confirmation before writing.",
 "inputSchema": {
  "properties": {
   "candleDate": {
    "description": "Optional candling date (YYYY-MM-DD)",
    "type": "string"
   },
   "clears": {
    "description": "Optional count of clear/infertile eggs",
    "type": "number"
   },
   "confirm": {
    "description": "Set to true to commit, false for dry-run preview",
    "type": "boolean"
   },
   "farmId": {
    "description": "The unique farm ID",
    "type": "string"
   },
   "fertileCount": {
    "description": "Number of fertile/developing eggs (positive integer <= eggsSet)",
    "type": "number"
   },
   "hatchId": {
    "description": "The unique hatch batch ID",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Unique request idempotency key",
    "type": "string"
   },
   "quitters": {
    "description": "Optional count of early quitters/dead germs",
    "type": "number"
   }
  },
  "required": [
   "farmId",
   "hatchId",
   "fertileCount"
  ],
  "type": "object"
 },
 "name": "log_candling"
}
