     "amount": {
      "description": "Amount in Canadian dollars (CAD)",
      "type": "number"
     },
     "days": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "meals": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "rule": {
      "type": "string"
     }
