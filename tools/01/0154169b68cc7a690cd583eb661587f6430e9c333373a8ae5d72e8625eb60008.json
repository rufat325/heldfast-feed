  "title": "CRA meal and vehicle rates"
 },
 "description": "CRA simplified-method rates (latest published tax year): flat meal rate per meal and maximum per day, and vehicle cents/km by province or territory where travel begins. These apply to moving expenses, northern residents deductions and medical travel, not to employer per-diems. Optionally calculates amounts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "Number of days (caps meals at the daily maximum).",
    "maximum": 3660,
    "minimum": 0,
    "type": "integer"
   },
   "kilometres": {
    "description": "Kilometres driven, to calculate a vehicle amount (needs province).",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "meals": {
    "description": "Number of meals.",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "province": {
    "description": "Province or territory where the travel begins.",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "cra_meal_travel_allowance",
