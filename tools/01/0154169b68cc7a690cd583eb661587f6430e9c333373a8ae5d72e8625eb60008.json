    "type": "string"
   },
   "dataVersion": {
    "description": "Version of the Tallyfern Rates dataset, e.g. 2026.10.03",
    "type": "string"
   },
   "disclaimer": {
    "description": "Not-tax-advice notice",
    "type": "string"
   },
   "latestPublishedNote": {
    "type": "string"
   },
   "mealAmount": {
    "additionalProperties": false,
