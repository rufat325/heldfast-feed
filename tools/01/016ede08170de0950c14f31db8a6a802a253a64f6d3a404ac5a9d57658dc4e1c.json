{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/security.cookie-audit",
  "agent-utilities/priceMicroUsd": 500
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Check up to 50 Set-Cookie headers for security attributes and prefix rules; masks cookie values. PAID: 500 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "setCookies": {
      "items": {
       "maxLength": 8192,
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     }
    },
    "required": [
     "setCookies"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "security_cookie_audit",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "cookies": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "findings": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "message": {
          "type": "string"
         },
         "rule": {
          "type": "string"
         },
         "severity": {
          "type": "string"
         }
        },
        "required": [
         "rule",
         "severity",
         "message"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "hasDomain": {
       "type": "boolean"
      },
      "httpOnly": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "sameSite": {
       "type": "string"
      },
      "secure": {
       "type": "boolean"
      },
      "value": {
       "const": "[REDACTED]"
      }
     },
     "required": [
      "name",
      "value",
      "secure",
      "httpOnly",
      "sameSite",
      "hasDomain",
      "findings"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scope": {
    "type": "string"
   }
  },
  "required": [
   "cookies",
   "scope"
  ],
  "type": "object"
 }
}
