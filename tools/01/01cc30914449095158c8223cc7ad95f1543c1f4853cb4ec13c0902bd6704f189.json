{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user compares two to four machines. Needs hardware ids from search_catalog. Returns memory, bandwidth, memory type, release year, status and a dated price where one is recorded, side by side. A price of null means none is on record. It does not check any model against the machines; use check_hardware_fit for that.",
 "inputSchema": {
  "properties": {
   "hardware_ids": {
    "description": "Two to four hardware ids from search_catalog.",
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "pattern": "^[a-z0-9][a-z0-9._-]*$",
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "hardware_ids"
  ],
  "type": "object"
 },
 "name": "compare_hardware",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data_as_of": {
    "description": "Date the bundled catalogue was last updated. Not the time of this call.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "hardware": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "architecture": {
       "maxLength": 80,
       "type": "string"
      },
      "bandwidth_gb_s": {
       "description": "Theoretical peak memory bandwidth.",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "class": {
       "maxLength": 40,
       "type": "string"
      },
      "id": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "^[a-z0-9][a-z0-9._-]*$",
       "type": "string"
      },
      "memory_gb": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "memory_kind": {
       "enum": [
        "dedicated",
        "unified",
        "shared-system"
       ],
       "type": "string"
      },
      "name": {
       "maxLength": 120,
       "type": "string"
      },
      "notes": {
       "anyOf": [
        {
         "maxLength": 400,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "price": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "as_of": {
           "description": "Date this price was checked.",
           "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
           "type": "string"
          },
          "market": {
           "enum": [
            "new",
            "used",
            "refurb"
           ],
           "type": "string"
          },
          "source": {
           "maxLength": 200,
           "type": "string"
          },
          "stale": {
           "description": "True when the price is older than 90 days.",
           "type": "boolean"
          },
          "usd": {
           "exclusiveMinimum": 0,
           "type": "number"
          }
         },
         "required": [
          "usd",
          "as_of",
          "market",
          "stale",
          "source"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "null when this catalogue holds no dated price. Never 0."
      },
      "release_year": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "sources": {
       "items": {
        "pattern": "^https:\\/\\/",
        "type": "string"
       },
       "maxItems": 8,
       "type": "array"
      },
      "status": {
       "description": "announced means not yet on sale; eol means no longer made.",
       "enum": [
        "current",
        "eol",
        "used-market",
        "announced"
       ],
       "type": "string"
      },
      "system_ram_gb": {
       "description": "System RAM available for offload. 0 for unified-memory machines.",
       "minimum": 0,
       "type": "number"
      },
      "url": {
       "pattern": "^https:\\/\\/llmconfigurator\\.com\\/en\\/",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "memory_gb",
      "memory_kind",
      "bandwidth_gb_s",
      "status",
      "class",
      "architecture",
      "release_year",
      "system_ram_gb",
      "price",
      "notes",
      "sources",
      "url"
     ],
     "type": "object"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array"
   },
   "summary": {
    "description": "One or two plain-language sentences stating the answer.",
    "maxLength": 600,
    "type": "string"
   }
  },
  "required": [
   "data_as_of",
   "summary",
   "hardware"
  ],
  "type": "object"
 },
 "title": "Compare two to four machines"
}
