{
 "annotations": {
  "readOnlyHint": true,
  "title": "Video analytics (plays)"
 },
 "description": "Aggregated play analytics for videos over a date range, grouped by a dimension. Read-only. GET /analytics/videos/plays.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currentPage": {
    "description": "Page number (1-based). Default 1.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "dimension": {
    "description": "Dimension to group plays by.",
    "enum": [
     "videoId",
     "emittedAt",
     "country",
     "deviceType",
     "operatingSystem",
     "browser"
    ],
    "type": "string"
   },
   "filter": {
    "description": "Filter expression, e.g. \"videoId:vi123\".",
    "type": "string"
   },
   "from": {
    "description": "Start date yyyy-mm-dd (inclusive). Required.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "pageSize": {
    "description": "Results per page (max 100). Default 25.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "to": {
    "description": "End date yyyy-mm-dd (inclusive).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "from",
   "dimension"
  ],
  "type": "object"
 },
 "name": "apivideo_get_video_analytics",
 "title": "Video analytics (plays)"
}
