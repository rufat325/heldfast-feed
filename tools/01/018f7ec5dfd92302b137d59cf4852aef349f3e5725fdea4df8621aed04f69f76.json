{
 "description": "Start an async export of an Open Label project's annotations. Formats: JSON (canonical), CSV, COCO, MASKS (PNG bundle), YOLO, VOC, CONLL, LS_JSON. Filters: statusScope (ALL|ANNOTATED|REVIEWED|ACCEPTED), datasetId, datasetVersionId (immutable snapshot scope), useVersionRecipe (replay the version's cut-time recipe), sliceId, anonymizeAnnotators. Every export is validated before delivery; poll with open_label_get_export, then download via GET /api/public/v1/open-label/projects/{projectId}/exports/{exportId}/download. Requires open-label:write scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "anonymizeAnnotators": {
    "description": "Replace annotator ids with stable aliases.",
    "type": "boolean"
   },
   "augmentation": {
    "additionalProperties": false,
    "description": "Offline train-split augmentation (COCO format only): bundles original + transformed images with transformed boxes.",
    "properties": {
     "multiplier": {
      "description": "Train-split output multiplier.",
      "maximum": 10,
      "minimum": 2,
      "type": "number"
     },
     "ops": {
      "additionalProperties": false,
      "properties": {
       "blur": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "maxSigma": {
            "type": "number"
           }
          },
          "required": [
           "maxSigma"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "brightness": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "amount": {
            "type": "number"
           }
          },
          "required": [
           "amount"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "crop": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "maxPercent": {
            "type": "number"
           }
          },
          "required": [
           "maxPercent"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "flipHorizontal": {
        "type": "boolean"
       },
       "flipVertical": {
        "type": "boolean"
       },
       "grayscale": {
        "type": "boolean"
       },
       "hue": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "maxDegrees": {
            "type": "number"
           }
          },
          "required": [
           "maxDegrees"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "rotate": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "maxDegrees": {
            "type": "number"
           }
          },
          "required": [
           "maxDegrees"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "rotate90": {
        "type": "boolean"
       },
       "saturation": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "amount": {
            "type": "number"
           }
          },
          "required": [
           "amount"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "type": "object"
     },
     "seed": {
      "description": "Reproducible op sampling.",
      "type": "number"
     },
     "split": {
      "additionalProperties": false,
      "description": "Split ratios (default 80/10/10); membership is permanent per row.",
      "properties": {
       "test": {
        "type": "number"
       },
       "train": {
        "type": "number"
       },
       "val": {
        "type": "number"
       }
      },
      "type": "object"
     }
    },
    "required": [
     "multiplier"
    ],
    "type": "object"
   },
   "datasetId": {
    "description": "Restrict to one dataset.",
    "type": "string"
   },
   "datasetVersionId": {
    "description": "Restrict to an immutable dataset-version snapshot: only manifest rows export and the persisted split membership governs augmentation.",
    "type": "string"
   },
   "format": {
    "description": "Export format (default JSON).",
    "enum": [
     "JSON",
     "CSV",
     "COCO",
     "MASKS",
     "YOLO",
     "VOC",
     "CONLL",
     "LS_JSON"
    ],
    "type": "string"
   },
   "projectId": {
    "description": "The Open Label project id.",
    "type": "string"
   },
   "sliceId": {
    "description": "Restrict to a saved slice.",
    "type": "string"
   },
   "statusScope": {
    "description": "Which tasks to include (default ALL).",
    "enum": [
     "ALL",
     "ANNOTATED",
     "REVIEWED",
     "ACCEPTED"
    ],
    "type": "string"
   },
   "useVersionRecipe": {
    "description": "Replay the named version's persisted cut-time recipe (split + augmentation) \u2014 the version id alone reproduces the augmented export.",
    "type": "boolean"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "open_label_start_export",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
