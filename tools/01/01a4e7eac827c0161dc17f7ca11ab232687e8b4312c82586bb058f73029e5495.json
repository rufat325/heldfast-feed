{
 "description": "Assess the security architecture of a cross-chain bridge design. Evaluates validator model, message passing, liquidity design, and governance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bridge_type": {
    "description": "Bridge architecture type",
    "enum": [
     "lock-and-mint",
     "burn-and-mint",
     "liquidity-pool",
     "atomic-swap",
     "optimistic",
     "zk-proof"
    ],
    "type": "string"
   },
   "has_rate_limiting": {
    "description": "Whether transfers have rate/volume limits",
    "type": "boolean"
   },
   "has_timelock": {
    "description": "Whether admin operations have a timelock",
    "type": "boolean"
   },
   "threshold": {
    "description": "Required signatures/approvals",
    "type": "number"
   },
   "validator_count": {
    "description": "Total number of validators/signers",
    "type": "number"
   },
   "validator_model": {
    "description": "How cross-chain messages are validated",
    "enum": [
     "multisig",
     "mpc",
     "relay-chain",
     "optimistic",
     "zk-proof",
     "single-relayer"
    ],
    "type": "string"
   }
  },
  "required": [
   "bridge_type",
   "validator_model"
  ],
  "type": "object"
 },
 "name": "bridge_architecture_review"
}
