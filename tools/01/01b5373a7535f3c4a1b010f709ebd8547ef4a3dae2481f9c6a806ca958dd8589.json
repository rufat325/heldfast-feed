{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create infrastructure zone"
 },
 "description": "Create an operational hydraulic boundary (pressure zone, DMA, sewershed, etc.). boundary is a GeoJSON Polygon, or a MultiPolygon when the area comes in separate pieces. (network_id, name) must be unique. Requires infrastructure_zones:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "boundary": {
    "anyOf": [
     {
      "properties": {
       "coordinates": {
        "items": {
         "items": {
          "items": false,
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
           {
            "type": "number"
           },
           {
            "type": "number"
           }
          ],
          "type": "array"
         },
         "type": "array"
        },
        "type": "array"
       },
       "type": {
        "const": "Polygon",
        "type": "string"
       }
      },
      "required": [
       "type",
       "coordinates"
      ],
      "type": "object"
     },
     {
      "properties": {
       "coordinates": {
        "items": {
         "items": {
          "items": {
           "items": false,
           "maxItems": 2,
           "minItems": 2,
           "prefixItems": [
            {
             "type": "number"
            },
            {
             "type": "number"
            }
           ],
           "type": "array"
          },
          "type": "array"
         },
         "type": "array"
        },
        "type": "array"
       },
       "type": {
        "const": "MultiPolygon",
        "type": "string"
       }
      },
      "required": [
       "type",
       "coordinates"
      ],
      "type": "object"
     }
    ],
    "description": "GeoJSON Polygon or MultiPolygon (EPSG:4326). Each ring is closed; coordinates are [lon, lat]. Use MultiPolygon for a boundary in separate pieces - an area split by a rail corridor, or one containing an island."
   },
   "code": {
    "description": "Optional short code (e.g. \"PZ-04\")",
    "maxLength": 50,
    "type": "string"
   },
   "kind": {
    "description": "Zone kind (required)",
    "enum": [
     "pressure_zone",
     "dma",
     "sewershed",
     "storm_catchment",
     "maintenance_district"
    ],
    "type": "string"
   },
   "name": {
    "description": "Zone name (required)",
    "maxLength": 200,
    "type": "string"
   },
   "network_id": {
    "description": "Infrastructure network ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "notes": {
    "description": "Free-form notes",
    "type": "string"
   }
  },
  "required": [
   "network_id",
   "kind",
   "name",
   "boundary"
  ],
  "type": "object"
 },
 "name": "create_infrastructure_zone",
 "title": "Create infrastructure zone"
}
