{
 "description": "Estimate token count and cost across providers for any prompt text. No session needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "prompt_text": {
    "description": "The prompt text to estimate cost for",
    "maxLength": 102400,
    "minLength": 1,
    "type": "string"
   },
   "target": {
    "default": "claude",
    "description": "Target platform for model recommendations",
    "enum": [
     "claude",
     "openai",
     "generic"
    ],
    "type": "string"
   }
  },
  "required": [
   "prompt_text"
  ],
  "type": "object"
 },
 "name": "estimate_cost"
}
