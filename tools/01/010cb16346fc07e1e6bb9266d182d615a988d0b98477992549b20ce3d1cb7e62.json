 },
 "description": "Inicia el pedido de la nota simple registral de una subasta (20 \u20ac, retenci\u00f3n: solo se cobra con PDF verificado). Requiere cuenta verificada (scope `notas:write`) y que la subasta tenga CRU/IDUFIR (`not_orderable` si no). Devuelve `pedido_id` y la `url` donde el usuario confirma el pago en el navegador (y, si el comercio para agentes est\u00e1 activo, `paymentLink` para pagarlo por MPP); el pago nunca se completa desde aqu\u00ed. Idempotente: si ya hay un pedido vivo devuelve `pedido_existente`. M\u00e1ximo 20 inmuebles al d\u00eda.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Identificador p\u00fablico de la subasta (10 caracteres)",
    "pattern": "^[A-Za-z0-9]{10}$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "nota_simple_pedir",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "compra": {
    "additionalProperties": {},
    "properties": {
     "instrucciones": {
      "additionalProperties": {},
      "properties": {
       "agente": {
        "type": "string"
       },
       "navegador": {
        "type": "string"
       }
      },
      "required": [
       "agente",
       "navegador"
      ],
      "type": "object"
     },
     "moneda": {
      "const": "EUR",
      "type": "string"
     },
     "paymentLink": {
      "description": "URL de pago m\u00e1quina (MPP/Stripe): POST \u2192 402 con reto \u2192 reintento con Shared Payment Token; en navegador, checkout humano",
      "type": "string"
     },
     "precio_cents": {
      "type": "number"
     },
     "precio_label": {
      "type": "string"
     }
    },
    "required": [
     "paymentLink",
     "precio_cents",
     "moneda",
     "instrucciones"
    ],
    "type": "object"
   },
   "cta": {
    "additionalProperties": {},
    "properties": {
     "text": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "text",
     "url"
    ],
    "type": "object"
   },
   "disclosure": {
    "type": "string"
   },
   "paymentLink": {
    "type": "string"
   },
   "pedido_id": {
    "type": "string"
   },
   "precio_cents": {
    "type": "number"
   },
   "siguiente_paso": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "pedido_id",
   "url",
   "siguiente_paso"
  ],
  "type": "object"
 },
 "title": "Pedir una nota simple"
}
