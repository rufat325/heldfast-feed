{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get personalized job recommendations for you. Recommendations are matched to your profile (skills, education, experience) and exclude jobs you have already applied to. If your profile is incomplete, recommendations fall back to jobs near your location.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Number of recommendations to return (default 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "pageToken": {
    "description": "Opaque cursor returned as nextPageToken from a previous call; pass it to fetch the next page",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_recommendations",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "jobs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "company": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": [
          "string",
          "null"
         ]
        },
        "name": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "employmentType": {
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "remote": {
       "type": "boolean"
      },
      "title": {
       "type": "string"
      },
      "uid": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "workplace": {
       "enum": [
        "on_site",
        "hybrid",
        "remote"
       ],
       "type": "string"
      }
     },
     "required": [
      "title",
      "location"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextPageToken": {
    "type": "string"
   }
  },
  "required": [
   "jobs"
  ],
  "type": "object"
 },
 "title": "Get recommendations"
}
