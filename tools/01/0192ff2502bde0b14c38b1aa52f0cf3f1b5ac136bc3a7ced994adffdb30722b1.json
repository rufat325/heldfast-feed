{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new Popup web page from an array of blocks. Returns the slug and public URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "blocks": {
    "description": "Array of content blocks",
    "items": {
     "properties": {
      "content": {
       "description": "Text content (for h1, h2, text)",
       "type": "string"
      },
      "description": {
       "description": "Link description (for link)",
       "type": "string"
      },
      "href": {
       "description": "Button link URL (for button)",
       "type": "string"
      },
      "label": {
       "description": "Button label (for button)",
       "type": "string"
      },
      "title": {
       "description": "Link title (for link)",
       "type": "string"
      },
      "type": {
       "enum": [
        "h1",
        "h2",
        "text",
        "image",
        "button",
        "divider",
        "youtube",
        "link"
       ],
       "type": "string"
      },
      "url": {
       "description": "URL (for image, link)",
       "type": "string"
      },
      "videoId": {
       "description": "YouTube video ID (for youtube)",
       "type": "string"
      },
      "width": {
       "description": "Display width",
       "enum": [
        "small",
        "medium",
        "full"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "blocks"
  ],
  "type": "object"
 },
 "name": "create_page"
}
