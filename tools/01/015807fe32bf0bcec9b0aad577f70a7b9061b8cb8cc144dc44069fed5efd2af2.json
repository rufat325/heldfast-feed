{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Scroll Page"
 },
 "description": "Scroll the page in a given direction.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "direction": {
    "description": "Scroll direction",
    "enum": [
     "up",
     "down",
     "left",
     "right"
    ],
    "type": "string"
   },
   "distance": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Pixels to scroll (default 500)"
   },
   "session_id": {
    "description": "Session ID returned by browser_navigate",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "direction"
  ],
  "type": "object"
 },
 "name": "browser_scroll"
}
