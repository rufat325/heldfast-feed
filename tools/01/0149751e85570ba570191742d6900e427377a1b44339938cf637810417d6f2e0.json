{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create asset replacement plan"
 },
 "description": "Create a new asset replacement plan. Requires asset_replacement_plans:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset_id": {
    "description": "Asset ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "estimated_cost": {
    "description": "Estimated replacement cost",
    "minimum": 0,
    "type": "number"
   },
   "funding_source": {
    "description": "Funding source",
    "maxLength": 200,
    "type": "string"
   },
   "notes": {
    "description": "Notes",
    "type": "string"
   },
   "planned_replacement_year": {
    "description": "Planned replacement year (required)",
    "maximum": 2100,
    "minimum": 2000,
    "type": "integer"
   },
   "priority": {
    "description": "Priority",
    "enum": [
     "CRITICAL",
     "HIGH",
     "MEDIUM",
     "LOW"
    ],
    "type": "string"
   },
   "status": {
    "description": "Status",
    "enum": [
     "PLANNED",
     "BUDGETED",
     "APPROVED",
     "COMPLETED",
     "CANCELLED"
    ],
    "type": "string"
   }
  },
  "required": [
   "asset_id",
   "planned_replacement_year"
  ],
  "type": "object"
 },
 "name": "create_asset_replacement_plan",
 "title": "Create asset replacement plan"
}
