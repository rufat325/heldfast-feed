{
 "description": "Execute or continue the SAME prepared graph. Submit authorizations when the signed quote enables gas_sponsorship, otherwise buyer-signed transactions; none for free steps. Never submit both payment modes. Retain run_id/access_token and the exact bundle. Pending is not failure; repeat the same run or read pipeline_status. Never create a replacement purchase after a lost response.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "access_token": {
    "maxLength": 128,
    "minLength": 20,
    "title": "Access Token",
    "type": "string"
   },
   "authorizations": {
    "anyOf": [
     {
      "additionalProperties": {
       "pattern": "^0x[0-9a-fA-F]{130}$",
       "type": "string"
      },
      "maxProperties": 16,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Authorizations"
   },
   "run_id": {
    "pattern": "^paid_[0-9a-f]{32}$",
    "title": "Run Id",
    "type": "string"
   },
   "transactions": {
    "anyOf": [
     {
      "additionalProperties": {
       "maxLength": 4098,
       "pattern": "^0x[0-9a-fA-F]+$",
       "type": "string"
      },
      "maxProperties": 16,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Transactions"
   }
  },
  "required": [
   "run_id",
   "access_token"
  ],
  "title": "PipelineInput",
  "type": "object"
 },
 "name": "pipeline_invoke"
}
