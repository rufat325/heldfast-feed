{
 "description": "Search for multi-city (multi-leg) flight itineraries. Supports 2-5 segments.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adults": {
    "default": 1,
    "minimum": 1,
    "type": "integer"
   },
   "cabinClass": {
    "default": "economy",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "children": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   },
   "infants": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   },
   "maxResults": {
    "default": 3,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "maxStops": {
    "maximum": 2,
    "minimum": 0,
    "type": "integer"
   },
   "segments": {
    "description": "Flight segments (2-5 legs)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "description": "Travel date in YYYY-MM-DD format",
       "type": "string"
      },
      "destination": {
       "description": "Arrival airport IATA code",
       "maxLength": 3,
       "minLength": 3,
       "type": "string"
      },
      "origin": {
       "description": "Departure airport IATA code",
       "maxLength": 3,
       "minLength": 3,
       "type": "string"
      }
     },
     "required": [
      "origin",
      "destination",
      "date"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "segments"
  ],
  "type": "object"
 },
 "name": "search_multi_city"
}
