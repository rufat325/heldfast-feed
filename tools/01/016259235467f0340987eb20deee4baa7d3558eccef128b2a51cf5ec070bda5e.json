{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Reschedule a booking"
 },
 "description": "Moves an existing booking (appointmentId from get_bookings) to a new time and emails the customer about the change. Executes immediately.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appointmentId": {
    "description": "From get_bookings",
    "type": "string"
   },
   "endTime": {
    "description": "ISO 8601 with UTC offset, e.g. 2026-09-20T15:00:00+10:00",
    "type": "string"
   },
   "startTime": {
    "description": "ISO 8601 with UTC offset, e.g. 2026-09-20T14:00:00+10:00",
    "type": "string"
   },
   "timezone": {
    "description": "IANA timezone; defaults to the booking\u2019s existing timezone",
    "type": "string"
   }
  },
  "required": [
   "appointmentId",
   "startTime",
   "endTime"
  ],
  "type": "object"
 },
 "name": "reschedule_booking",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_environment": {
    "description": "The Nexwin country and environment that supplied the result",
    "type": "string"
   },
   "appointmentId": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "_environment"
  ],
  "type": "object"
 },
 "title": "Reschedule a booking"
}
