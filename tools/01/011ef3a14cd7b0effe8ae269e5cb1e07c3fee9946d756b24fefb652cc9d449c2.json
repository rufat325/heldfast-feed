{
 "description": "Search patent records and metadata via Google Patents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Min date as type:YYYYMMDD (type = priority|filing|publication).",
    "type": "string"
   },
   "assignee": {
    "description": "Comma-separated assignee names.",
    "type": "string"
   },
   "before": {
    "description": "Max date as type:YYYYMMDD (type = priority|filing|publication).",
    "type": "string"
   },
   "country": {
    "description": "Comma-separated country codes (e.g. WO,US).",
    "type": "string"
   },
   "inventor": {
    "description": "Comma-separated inventor names.",
    "type": "string"
   },
   "language": {
    "description": "Comma-separated languages (e.g. ENGLISH,GERMAN).",
    "type": "string"
   },
   "num": {
    "description": "Results per page (1-100). (API default: 10)",
    "type": "number"
   },
   "page": {
    "description": "Zero-based page number. (API default: 0)",
    "type": "number"
   },
   "query": {
    "description": "Search terms; separate multiple with semicolons.",
    "type": "string"
   },
   "scholar": {
    "description": "Include Google Scholar results. (API default: false)",
    "type": "boolean"
   },
   "sort": {
    "description": "Sort order.",
    "enum": [
     "new",
     "old"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status.",
    "enum": [
     "GRANT",
     "APPLICATION"
    ],
    "type": "string"
   },
   "type": {
    "description": "Filter by type.",
    "enum": [
     "PATENT",
     "DESIGN"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "google_patents",
 "title": "Google Patents API"
}
