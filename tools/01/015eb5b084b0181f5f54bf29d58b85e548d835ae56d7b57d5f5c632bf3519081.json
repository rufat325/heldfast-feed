{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Percentage calculator"
 },
 "description": "Work out percentages three ways. Mode 'of': what is P percent of a number. Mode 'what': what percentage the part is of the whole. Mode 'change': the percentage change from a starting value to an end value. Source: https://hopi.co.uk/percentage-calculator/",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "mode": {
       "const": "of"
      }
     }
    },
    "then": {
     "required": [
      "percent",
      "number"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "mode": {
       "const": "what"
      }
     }
    },
    "then": {
     "required": [
      "part",
      "whole"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "mode": {
       "const": "change"
      }
     }
    },
    "then": {
     "required": [
      "from",
      "to"
     ]
    }
   }
  ],
  "properties": {
   "from": {
    "description": "Starting value (mode 'change', not zero)",
    "not": {
     "const": 0
    },
    "type": "number"
   },
   "mode": {
    "description": "'of' percent of a number, 'what' one number as a percentage of another, or 'change' percentage change",
    "enum": [
     "of",
     "what",
     "change"
    ],
    "type": "string"
   },
   "number": {
    "description": "The number (mode 'of')",
    "type": "number"
   },
   "part": {
    "description": "The part (mode 'what')",
    "type": "number"
   },
   "percent": {
    "description": "The percentage (mode 'of')",
    "type": "number"
   },
   "to": {
    "description": "End value (mode 'change')",
    "type": "number"
   },
   "whole": {
    "description": "The whole (mode 'what', not zero)",
    "not": {
     "const": 0
    },
    "type": "number"
   }
  },
  "required": [
   "mode"
  ],
  "type": "object"
 },
 "name": "hopi_percentage_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "mode": {
    "type": "string"
   },
   "number": {
    "type": "number"
   },
   "percent": {
    "type": "number"
   },
   "result": {
    "type": "number"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "mode",
   "result",
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Percentage calculator"
}
