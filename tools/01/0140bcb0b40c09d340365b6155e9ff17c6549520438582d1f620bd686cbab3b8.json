{
 "_meta": {
  "ui": {
   "resourceUri": "ui://frontend-checklist/review-report"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Audit Live URL"
 },
 "description": "Fetches a public HTTPS page and performs a non-exhaustive static review of its HTML, returning prioritized issues and fix guidance. Use it when the user requests an audit of a deployed public page. Localhost, private networks, and plain HTTP URLs are refused. It does not execute the page, measure live Core Web Vitals, or certify accessibility.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://frontendchecklist.io/favicon.svg"
  }
 ],
 "inputSchema": {
  "properties": {
   "focus": {
    "description": "Only check these categories (default: auto-detected from the fetched HTML).",
    "items": {
     "enum": [
      "html",
      "css",
      "javascript",
      "performance",
      "accessibility",
      "seo",
      "security",
      "images"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "minPriority": {
    "description": "Lowest priority to report (default: medium).",
    "enum": [
     "critical",
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "url": {
    "description": "Public URL to audit. Must use https://. Private IPs and localhost are blocked.",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "audit_url",
 "outputSchema": {
  "properties": {
   "error": {
    "type": "string"
   },
   "issues": {
    "items": {
     "properties": {
      "fixPrompt": {
       "type": "string"
      },
      "issue": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "critical",
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "properties": {
     "contentLength": {
      "type": "number"
     },
     "fetchedAt": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "suggestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "summary": {
    "properties": {
     "categories": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "criticalIssues": {
      "type": "number"
     },
     "highIssues": {
      "type": "number"
     },
     "issuesFound": {
      "type": "number"
     },
     "totalChecks": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Audit Live URL"
}
