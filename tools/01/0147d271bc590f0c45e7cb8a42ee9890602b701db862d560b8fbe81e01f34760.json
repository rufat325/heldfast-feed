{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Redirect check"
 },
 "description": "Follows a URL's redirect chain hop by hop and returns each step's status, source and target, the final URL and status, the hop count, and warnings for loops, HTTPS-to-HTTP downgrades and overly long chains. Body and headers of the destination are not returned (http_headers covers headers). Anonymous, rate-limited per IP; private and reserved addresses are refused.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "url": {
    "description": "Full URL, e.g. https://deinkunde.com",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "redirect_check",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "finalStatus": {
    "type": [
     "number",
     "null"
    ]
   },
   "finalStatusText": {
    "type": [
     "string",
     "null"
    ]
   },
   "finalUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "hops": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "properties": {
        "from": {
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "type": [
          "number",
          "null"
         ]
        },
        "to": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "ok": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "start": {
    "type": [
     "string",
     "null"
    ]
   },
   "totalHops": {
    "type": [
     "number",
     "null"
    ]
   },
   "warnings": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "title": "Redirect check"
}
