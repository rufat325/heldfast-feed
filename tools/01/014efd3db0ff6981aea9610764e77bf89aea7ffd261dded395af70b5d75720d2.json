      },
      "name": {
       "type": "string"
      },
      "source": {
       "description": "curated or live DEX data",
       "type": "string"
      },
      "symbol": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "next": {
    "additionalProperties": {},
    "description": "Suggested follow-up calls",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "symbol": {
    "description": "Symbol searched",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Resolve token symbol"
}
