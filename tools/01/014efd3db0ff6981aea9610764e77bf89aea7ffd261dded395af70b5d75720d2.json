  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chain": {
    "description": "Chain to swap on",
    "enum": [
     "solana",
     "base",
     "ethereum",
     "arbitrum",
     "polygon",
     "optimism",
     "bsc",
     "avalanche"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Ticker symbol to resolve, e.g. USDC, PEPE, WIF",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "symbol"
  ],
  "type": "object"
 },
 "name": "resolve_token",
 "outputSchema": {
