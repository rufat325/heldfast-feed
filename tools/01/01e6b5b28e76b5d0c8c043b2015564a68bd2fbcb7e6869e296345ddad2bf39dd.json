{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Move one or more messages (up to 500 ids) to a folder (name, path or id). Used for filing. NOTE: Outlook assigns a new id to every moved message; the `moved` result maps old id \u2192 new id. To move every message from a sender, prefer mail_bulk_by_sender.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"folder":{"description":"Destination folder","minLength":1,"type":"string"},"ids":{"description":"Message ids (1 to 500)","items":{"minLength":1,"type":"string"},"maxItems":500,"minItems":1,"type":"array"}},"required":["ids","folder"],"type":"object"},"name":"mail_move","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"failed":{"items":{"additionalProperties":false,"properties":{"error":{"type":"string"},"id":{"type":"string"}},"required":["id","error"],"type":"object"},"type":"array"},"moved":{"items":{"additionalProperties":false,"properties":{"id":{"type":"string"},"newId":{"type":"string"}},"required":["id","newId"],"type":"object"},"type":"array"},"succeeded":{"type":"number"}},"required":["succeeded","failed"],"type":"object"},"title":"Move messages"}
