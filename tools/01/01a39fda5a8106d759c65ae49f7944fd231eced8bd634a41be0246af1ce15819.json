{
 "description": "Generate a cURL command from method, URL, headers, and body parameters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "body": {
    "description": "Request body (JSON string)",
    "type": "string"
   },
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "default": {},
    "description": "Request headers as key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "method": {
    "default": "GET",
    "description": "HTTP method",
    "enum": [
     "GET",
     "POST",
     "PUT",
     "DELETE",
     "PATCH"
    ],
    "type": "string"
   },
   "url": {
    "description": "Request URL",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "generate_curl"
}
