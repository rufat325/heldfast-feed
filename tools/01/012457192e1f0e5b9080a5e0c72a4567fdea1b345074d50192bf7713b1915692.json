{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false
 },
 "description": "Create or preview a GitHub PR with a MartinLoop dossier body. Use execute=true to actually call gh.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "base": {
    "type": "string"
   },
   "execute": {
    "type": "boolean"
   },
   "file": {
    "type": "string"
   },
   "format": {
    "enum": [
     "json",
     "md",
     "github-pr"
    ],
    "type": "string"
   },
   "latest": {
    "const": true
   },
   "loopId": {
    "type": "string"
   },
   "runsDir": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "martin_create_pr",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "GitHub-flavoured Markdown PR body containing the run dossier.",
    "type": "string"
   },
   "grade": {
    "description": "Verification grade assigned to the run.",
    "enum": [
     "mergeable",
     "mergeable_with_review",
     "needs_review",
     "blocked",
     "insufficient_evidence"
    ],
    "type": "string"
   },
   "loopId": {
    "description": "MartinLoop run identifier used to generate the summary.",
    "type": "string"
   },
   "score": {
    "description": "Numeric verification score from 0\u2013100.",
    "type": "number"
   },
   "title": {
    "description": "Suggested GitHub pull-request title.",
    "type": "string"
   }
  },
  "required": [
   "loopId",
   "title",
   "body",
   "grade",
   "score"
  ],
  "type": "object"
 }
}
