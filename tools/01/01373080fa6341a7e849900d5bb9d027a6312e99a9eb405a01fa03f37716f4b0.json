{
 "description": "Run explicitly supplied acceptance commands in the requested project before dispatch. This executes the commands with supervisor privileges and can have their side effects; it creates no worker and does not prove worker completion. Structured checks require fresh execution evidence, while failure-count greps are flagged as insufficient baseline evidence.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "acceptance": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "anyOf": [
        {
         "minLength": 1,
         "type": "string"
        },
        {
         "additionalProperties": false,
         "properties": {
          "baseline": {
           "additionalProperties": false,
           "properties": {
            "failures": {
             "items": {
              "additionalProperties": false,
              "properties": {
               "kind": {
                "enum": [
                 "failure",
                 "error"
                ],
                "type": "string"
               },
               "signature": {
                "minLength": 1,
                "type": "string"
               },
               "test_id": {
                "minLength": 1,
                "type": "string"
               }
              },
              "required": [
               "test_id",
               "kind",
               "signature"
              ],
              "type": "object"
             },
             "type": "array"
            },
            "identity": {
             "additionalProperties": {
              "minLength": 1,
              "type": "string"
             },
             "properties": {
              "base_commit": {
               "minLength": 1,
               "type": "string"
              }
             },
             "required": [
              "base_commit"
             ],
             "type": "object"
            },
            "required": {
             "items": {
              "minLength": 1,
              "type": "string"
             },
             "type": "array"
            }
           },
           "required": [
            "identity",
            "failures",
            "required"
           ],
           "type": "object"
          },
          "command": {
           "minLength": 1,
           "type": "string"
          },
          "reportPath": {
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "command",
          "reportPath",
          "baseline"
         ],
         "type": "object"
        }
       ]
      },
      "maxItems": 10,
      "type": "array"
     }
    ]
   },
   "baseRef": {
    "minLength": 1,
    "type": "string"
   },
   "cwd": {
    "minLength": 1,
    "type": "string"
   },
   "timeoutMs": {
    "default": 600000,
    "maximum": 1800000,
    "minimum": 1000,
    "type": "integer"
   }
  },
  "required": [
   "cwd",
   "acceptance"
  ],
  "type": "object"
 },
 "name": "check_acceptance",
 "title": "Check acceptance commands"
}
