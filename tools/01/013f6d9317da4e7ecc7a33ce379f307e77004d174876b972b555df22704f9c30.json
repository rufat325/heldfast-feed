{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Rename a scene"
 },
 "description": "Changes the scene's display name, the one list_scenes and the dashboard show. Its draft, published versions and the streams playing it are untouched. Answers the scene: id, name, version.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "The new name",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "scene": {
    "description": "The scene (scn_\u2026), from list_scenes or create_scene.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "scene",
   "name"
  ],
  "type": "object"
 },
 "name": "rename_scene",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "anyOf": [
   {
    "additionalProperties": {},
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "version": {
      "description": "The published version; 0: never published",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "id",
     "name",
     "version"
    ],
    "type": "object"
   },
   {
    "additionalProperties": {},
    "properties": {
     "code": {
      "description": "Stable \u2014 branch on it: INVALID_INPUT, REVISION_REQUIRED, STALE_PUBLISH, CONFIRM_REQUIRED, UNAVAILABLE, \u2026",
      "type": "string"
     },
     "currentRevision": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "CONFLICT: the revision it has now"
     },
     "detail": {
      "description": "What is wrong, in a sentence",
      "type": "string"
     },
     "errors": {
      "description": "Each problem, when a check refused it"
     }
    },
    "required": [
     "code",
     "detail"
    ],
    "type": "object"
   }
  ],
  "properties": {},
  "type": "object"
 },
 "title": "Rename a scene"
}
