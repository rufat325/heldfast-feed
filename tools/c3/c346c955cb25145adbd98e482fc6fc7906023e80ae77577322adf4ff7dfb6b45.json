 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "city": {
    "type": "string"
   },
   "country": {
    "description": "2-letter ISO country code, e.g. 'GB', 'DE', 'CA'.",
    "type": "string"
   },
   "postal_code": {
    "type": "string"
   },
   "primary_line": {
    "description": "Primary delivery line.",
    "type": "string"
   },
   "secondary_line": {
    "type": "string"
   },
   "state": {
    "description": "State / province / region.",
    "type": "string"
   }
  },
  "required": [
   "primary_line",
   "country"
  ],
  "type": "object"
 },
 "name": "lob_verify_intl_address",
 "title": "Verify an international address"
}
