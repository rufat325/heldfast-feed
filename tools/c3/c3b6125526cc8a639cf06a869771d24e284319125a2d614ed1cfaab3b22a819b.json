   "card": {
    "default": "none",
    "description": "Paying with the Breeze Easy Visa. none = No; BV = Yes (card points).",
    "enum": [
     "none",
     "BV"
    ],
    "type": "string"
   },
   "fare": {
    "default": "NI",
    "description": "Bundle. NF = No Flex Fare (1 per $1); NI = Nice (2 per $1); NR = Nicer (5 per $1); NT = Nicest (5 per $1).",
    "enum": [
     "NF",
     "NI",
     "NR",
     "NT"
    ],
    "type": "string"
   },
   "price": {
    "description": "Fare and trip add-ons paid to Breeze (without taxes and fees) in US dollars. Booked with Breeze: the fare plus bags and seat selection. Government taxes and fees do not earn.",
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "number"
   },
   "status": {
    "default": "Member",
    "description": "Your Breezy Rewards level. Member = Member; Breezy 1 = Breezy 1 (+25%); Breezy 2 = Breezy 2 (+50%); Breezy 3 = Breezy 3 (+75%); Breezy Club = Breezy Club (+100%).",
    "enum": [
     "Member",
     "Breezy 1",
     "Breezy 2",
     "Breezy 3",
     "Breezy Club"
    ],
    "type": "string"
   }
  },
  "required": [
   "price"
  ],
  "type": "object"
 },
