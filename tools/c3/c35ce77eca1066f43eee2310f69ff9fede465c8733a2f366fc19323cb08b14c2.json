{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a filter"
 },
 "description": "Create a rule that files incoming mail in a connected mailbox. A rule that carries mail out of the mailbox, or that bins or junks what it matches, is refused, whether or not the provider would take it. An Outlook mailbox's rule files only under labels or out of the inbox (removeLabelIds INBOX).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addLabelIds": {
    "description": "Labels to apply, by id. TRASH and SPAM are refused.",
    "items": {
     "description": "A label id from labels_list.",
     "pattern": "^[A-Za-z0-9_-]{1,128}$",
     "type": "string"
    },
    "type": "array"
   },
   "forward": {
    "description": "Refused: this surface makes no rule that carries mail elsewhere.",
    "minLength": 1,
    "type": "string"
   },
   "from": {
    "description": "Match mail from this sender.",
    "type": "string"
   },
   "mailbox": {
    "description": "The mailbox's name or its email address.",
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "description": "Anything else to match: a Gmail search query, or for an Outlook mailbox one plain word or quoted phrase in the subject or body, with no AND, OR or NOT in capitals.",
    "type": "string"
   },
   "removeLabelIds": {
    "description": "Labels to remove, by id.",
    "items": {
     "description": "A label id from labels_list.",
     "pattern": "^[A-Za-z0-9_-]{1,128}$",
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "mailbox"
  ],
  "type": "object"
 },
 "name": "settings_filters_create",
