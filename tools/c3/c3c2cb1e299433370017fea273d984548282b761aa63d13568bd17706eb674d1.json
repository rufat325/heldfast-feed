{
 "description": "Install packages in a project",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "description": "Preview install without making changes",
    "type": "boolean"
   },
   "global": {
    "description": "Install globally",
    "type": "boolean"
   },
   "packages": {
    "description": "Package names to install (empty = install all from package.json)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "path": {
    "description": "Absolute path to the package directory",
    "type": "string"
   },
   "saveDev": {
    "description": "Save as devDependency",
    "type": "boolean"
   },
   "saveExact": {
    "description": "Save exact version instead of semver range",
    "type": "boolean"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "install"
}
