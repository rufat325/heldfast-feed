{
 "description": "Deep PDF inspection when Markdown is not enough. operation: inspect (page facts, metadata), render_page (PNG images), extract_regions (crop bounding boxes), ocr_pages / analyze_regions (configured OCR or vision provider), structure (JSON with document map, elements, geometry; profile quality|research adds trust and accessibility reports), compare (page-level diff of sources[0] vs sources[1]).",
 "inputSchema": {
  "$defs": {
   "InspectOperation": {
    "oneOf": [
     {
      "const": "inspect",
      "description": "Page count, metadata, and per-page facts.",
      "type": "string"
     },
     {
      "const": "render_page",
      "description": "Render pages to PNG images.",
      "type": "string"
     },
     {
      "const": "extract_regions",
      "description": "Crop regions (bounding boxes) out of rendered pages.",
      "type": "string"
     },
     {
      "const": "ocr_pages",
      "description": "OCR pages with the configured provider.",
      "type": "string"
     },
     {
      "const": "analyze_regions",
      "description": "Send regions to a configured vision/region provider.",
      "type": "string"
     },
     {
      "const": "structure",
      "description": "Structured JSON read: document map, elements, geometry, trust and accessibility reports.",
      "type": "string"
     },
     {
      "const": "compare",
      "description": "Page-level text diff between two PDFs (sources[0] = before, sources[1] = after).",
      "type": "string"
     }
    ]
   },
   "PageNumber": {
    "minimum": 1,
    "type": "integer"
   },
   "PageSpecifier": {
    "anyOf": [
     {
      "items": {
       "$ref": "#/$defs/PageNumber"
      },
      "type": "array"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "PdfEvidenceRegion": {
    "properties": {
     "bounding_box": {
      "$ref": "#/$defs/RegionBoundingBox"
     },
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "padding": {
      "maximum": 200.0,
      "minimum": 0.0,
      "type": [
       "number",
       "null"
      ]
     },
     "page": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "page",
     "bounding_box"
    ],
    "type": "object"
   },
   "PdfEvidenceSource": {
    "properties": {
     "pages": {
      "anyOf": [
       {
        "$ref": "#/$defs/PageSpecifier"
       },
       {
        "type": "null"
       }
      ]
     },
     "path": {
      "description": "Path to the local PDF file. Provide exactly one of path or url (not both).",
      "minLength": 1,
      "type": [
       "string",
       "null"
      ]
     },
     "regions": {
      "items": {
       "$ref": "#/$defs/PdfEvidenceRegion"
      },
      "type": [
       "array",
       "null"
      ]
     },
     "url": {
      "description": "URL of the PDF file. Provide exactly one of path or url (not both).",
      "minLength": 1,
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "RegionBoundingBox": {
    "properties": {
     "bottom": {
      "minimum": 0.0,
      "type": "number"
     },
     "left": {
      "minimum": 0.0,
      "type": "number"
     },
     "right": {
      "minimum": 0.0,
      "type": "number"
     },
     "top": {
      "minimum": 0.0,
      "type": "number"
     }
    },
    "required": [
     "left",
     "bottom",
     "right",
     "top"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_image": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "include_metadata": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "languages": {
    "items": {
     "type": "string"
    },
    "type": [
     "array",
     "null"
    ]
   },
   "max_output_chars": {
    "maximum": 1000000,
    "minimum": 1000,
    "type": [
     "integer",
     "null"
    ]
   },
   "max_pages": {
    "maximum": 20,
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "max_pixels_per_page": {
    "maximum": 64000000,
    "minimum": 10000,
    "type": [
     "integer",
     "null"
    ]
   },
   "max_regions": {
    "maximum": 100,
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "operation": {
    "$ref": "#/$defs/InspectOperation"
   },
   "profile": {
    "description": "structure only: fast (default), quality, or research (adds safety, trust, accessibility).",
    "type": [
     "string",
     "null"
    ]
   },
   "sample_pages": {
    "maximum": 20,
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "scale": {
    "maximum": 4.0,
    "minimum": 0.25,
    "type": [
     "number",
     "null"
    ]
   },
   "sources": {
    "items": {
     "$ref": "#/$defs/PdfEvidenceSource"
    },
    "type": "array"
   },
   "timeout_ms": {
    "maximum": 300000,
    "minimum": 1000,
    "type": [
     "integer",
     "null"
    ]
   }
  },
  "required": [
   "operation",
   "sources"
  ],
  "type": "object"
 },
 "name": "inspect"
}
