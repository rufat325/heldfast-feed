{
 "description": "Create a new category",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Description",
    "type": "string"
   },
   "meta": {
    "additionalProperties": {},
    "description": "Registered term meta fields (show_in_rest) as key/value",
    "type": "object"
   },
   "name": {
    "description": "Category name",
    "type": "string"
   },
   "parent": {
    "description": "Parent category ID (default 0 = top level)",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "URL slug",
    "type": "string"
   }
  },
  "required": [
   "site",
   "name"
  ],
  "type": "object"
 },
 "name": "wp_create_category"
}
