{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Booking and Procurement Policies"
 },
 "description": "Get TempGuru's published booking and procurement policies, plus any currently published public offer. Use for real booking questions that otherwise require an email. Values not supported by canonical copy are explicitly marked confirm_with_coordinator with TODO-for-Megan; never infer a missing number. <examples>get_policies() ; get_policies(topic='payment-terms') ; get_policies(topic='coi-additional-insured')</examples> <hints>Choose an advertised topic to return one policy. Narrow lexical aliases remain accepted, and unknown topics return the current available-topic list. This is an operational summary, not a contract.</hints>",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "topic": {
    "description": "Optional canonical policy topic. Choose an advertised enum value; omit for all policies or a broader question.",
    "enum": [
     "minimum-booking-hours",
     "cancellation-rescheduling",
     "no-show-backfill",
     "coi-additional-insured",
     "payment-terms",
     "background-checks",
     "order-confirmation",
     "quote-response",
     "offers"
    ],
    "maxLength": 80,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_policies",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "available_topics": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "data_version": {
    "type": "string"
   },
   "disclaimer": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "policies": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cap_usd": {
       "type": "number"
      },
      "code": {
       "type": "string"
      },
      "confirm_with_coordinator": {
       "type": "boolean"
      },
      "confirmed_claims": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "discount_percent": {
       "type": "number"
      },
      "expires": {
       "description": "Offer expiry date in YYYY-MM-DD format.",
       "format": "date",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
       "type": "string"
      },
      "scope": {
       "type": "string"
      },
      "sources": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "todo_for_megan": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "topic": {
       "type": "string"
      }
     },
     "required": [
      "topic",
      "title",
      "confirmed_claims",
      "confirm_with_coordinator",
      "todo_for_megan",
      "sources"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "policy_found": {
    "description": "Discriminator. false means the requested topic is not published.",
    "type": "boolean"
   },
   "requested": {
    "type": "string"
   },
   "scope": {
    "type": "string"
   },
   "status": {
    "enum": [
     "policies",
     "policy_not_found"
    ],
    "type": "string"
   },
   "todo_for_megan": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "updated": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "policy_found"
  ],
  "type": "object"
 },
 "title": "Get Booking and Procurement Policies"
}
