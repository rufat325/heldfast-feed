{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search for skills by tags or title query. Check for existing skills before creating new ones to avoid duplicates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque cursor for pagination",
    "type": "string"
   },
   "limit": {
    "default": 30,
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "orderBy": {
    "default": "recent",
    "enum": [
     "recent",
     "oldest",
     "name"
    ],
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "search_skills",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "nextCursor": {
    "description": "Opaque cursor for next page, absent if no more results",
    "type": "string"
   },
   "skills": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "executionLogId": {
       "type": [
        "number",
        "null"
       ]
      },
      "filePath": {
       "type": "string"
      },
      "hasStaleDeps": {
       "type": "boolean"
      },
      "id": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "title",
      "description",
      "tags",
      "filePath",
      "hasStaleDeps",
      "executionLogId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "suggestedTags": {
    "description": "Popular tags to explore when search returns empty results",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "skills"
  ],
  "type": "object"
 },
 "title": "Search Skills"
}
