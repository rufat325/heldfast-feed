{
 "description": "Create a cron schedule that automatically runs an endpoint at specified intervals.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cron": {
    "description": "Cron expression (e.g. \"*/5 * * * *\" for every 5 minutes, \"0 9 * * *\" for daily at 9am)",
    "type": "string"
   },
   "endpoint_id": {
    "description": "Endpoint ID to schedule (e.g. \"post--generate\")",
    "type": "string"
   },
   "input": {
    "additionalProperties": {},
    "description": "JSON input to pass to the endpoint on each run",
    "type": "object"
   },
   "project_id": {
    "description": "Project ID",
    "type": "string"
   },
   "timeout_seconds": {
    "description": "Max execution time per run (default: 60)",
    "type": "number"
   },
   "timezone": {
    "description": "IANA timezone (default: UTC)",
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "endpoint_id",
   "cron"
  ],
  "type": "object"
 },
 "name": "create_schedule"
}
