{
 "description": "Submit a new AI agent tool to SkillsIndex for indexing and scoring. The tool will be reviewed for security, utility, maintenance, and uniqueness before being published. Use this when you discover a useful tool that isn't in the directory yet.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "default": "other",
    "description": "Primary category",
    "enum": [
     "databases-storage",
     "browser-automation",
     "code-execution",
     "communication",
     "social-media",
     "marketing-analytics",
     "memory-knowledge",
     "file-systems",
     "finance-fintech",
     "search-data",
     "ai-llm",
     "cloud-platforms",
     "home-automation",
     "security-monitoring",
     "location-maps",
     "media-entertainment",
     "ecommerce",
     "health-biology",
     "legal",
     "other"
    ],
    "type": "string"
   },
   "description": {
    "description": "Brief description of what this tool does (min 10 chars)",
    "minLength": 10,
    "type": "string"
   },
   "ecosystem": {
    "default": "mcp_server",
    "description": "Which ecosystem this tool belongs to",
    "enum": [
     "mcp_server",
     "claude_skill",
     "gpt_action",
     "openclaw_skill",
     "plugin"
    ],
    "type": "string"
   },
   "github_url": {
    "description": "GitHub repository URL or project homepage",
    "format": "uri",
    "type": "string"
   },
   "name": {
    "description": "Tool name",
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "name",
   "github_url",
   "description"
  ],
  "type": "object"
 },
 "name": "submit_tool"
}
