{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Metric history series"
 },
 "description": "Use for a metric's history or trend (is the P/E high versus its past? how have margins moved?). Historical series for a TGMCharts-computed metric (daily valuation/yield lines, rolling TTM flows, quarterly margins). Points are even-time downsampled to max_points (default 120) to stay token-frugal \u2014 raw density is available at https://tgmcharts.com/api/v1/series/{symbol}/{metric}. points:null = intentionally withheld (sector-inappropriate, message included); [] = no stored history.",
 "inputSchema": {
  "properties": {
   "format": {
    "description": "json (default): the full JSON as text. markdown: a compact table or list, fewer tokens. structuredContent is the full JSON either way.",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   },
   "max_points": {
    "description": "Downsample cap (default 120)",
    "maximum": 500,
    "minimum": 10,
    "type": "integer"
   },
   "metric": {
    "description": "Series-tier metric slug (see list_metrics)",
    "enum": [
     "pe-ratio",
     "ps-ratio",
     "pb-ratio",
     "pfcf-ratio",
     "pocf-ratio",
     "ev-ebitda",
     "ev-ebit",
     "ev-sales",
     "ev-fcf",
     "ev-assets",
     "earnings-yield",
     "fcf-yield",
     "ebitda-yield",
     "ocf-yield",
     "dividend-yield",
     "total-return",
     "roic",
     "revenue-ttm",
     "net-income-ttm",
     "fcf-ttm",
     "ebitda-ttm",
     "capex-ttm",
     "buybacks-ttm",
     "sbc-ttm",
     "rd-ttm",
     "gross-margin-quarterly",
     "operating-margin-quarterly",
     "net-margin-quarterly",
     "revenue",
     "net-income",
     "capex",
     "buybacks",
     "stock-based-comp",
     "r-and-d",
     "revenue-quarterly",
     "net-income-quarterly"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Ticker symbol, e.g. KO",
    "type": "string"
   },
   "years": {
    "description": "Trailing window in years (default: full stored history)",
    "maximum": 20,
    "minimum": 2,
    "type": "integer"
   }
  },
  "required": [
   "symbol",
   "metric"
  ],
  "type": "object"
 },
 "name": "get_metric_series",
 "outputSchema": {
  "additionalProperties": {},
  "properties": {
   "applicability": {
    "anyOf": [
     {
      "const": "applicable",
      "type": "string"
     },
     {
      "additionalProperties": {},
      "properties": {
       "message": {
        "type": "string"
       },
       "tone": {
        "type": "string"
       }
      },
      "required": [
       "tone",
       "message"
      ],
      "type": "object"
     }
    ]
   },
   "asOf": {
    "type": [
     "string",
     "null"
    ]
   },
   "basis": {
    "type": "string"
   },
   "downsampledTo": {
    "type": [
     "number",
     "null"
    ]
   },
   "label": {
    "type": "string"
   },
   "links": {
    "additionalProperties": {},
    "properties": {
     "chart": {
      "type": [
       "string",
       "null"
      ]
     },
     "docs": {
      "type": "string"
     },
     "openapi": {
      "type": "string"
     },
     "page": {
      "type": "string"
     }
    },
    "required": [
     "chart",
     "page",
     "docs",
     "openapi"
    ],
    "type": "object"
   },
   "methodology": {
    "type": "string"
   },
   "metric": {
    "type": "string"
   },
   "name": {
    "type": [
     "string",
     "null"
    ]
   },
   "points": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "properties": {
        "date": {
         "type": "string"
        },
        "value": {
         "type": "number"
        }
       },
       "required": [
        "date",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "symbol": {
    "type": "string"
   },
   "unit": {
    "type": "string"
   },
   "years": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "required": [
   "symbol",
   "name",
   "metric",
   "label",
   "unit",
   "basis",
   "methodology",
   "asOf",
   "years",
   "points",
   "applicability",
   "links",
   "downsampledTo"
  ],
  "type": "object"
 },
 "title": "Metric history series"
}
