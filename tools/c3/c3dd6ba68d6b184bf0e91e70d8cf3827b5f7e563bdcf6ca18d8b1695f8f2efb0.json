{
 "description": "Find agents and MCP servers for a natural-language task. Returns ranked candidates, matched skills and capabilities, interfaces, trust evidence, and explicit availability and authentication states. Unknown states are not treated as online or unauthenticated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiVersion": {
    "const": "1",
    "type": "string"
   },
   "limit": {
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "protocols": {
    "items": {
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "requirements": {
    "properties": {
     "authentication": {
      "enum": [
       "unknown",
       "none",
       "required"
      ],
      "type": "string"
     },
     "availability": {
      "enum": [
       "unknown",
       "online",
       "degraded",
       "offline"
      ],
      "type": "string"
     },
     "callable": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "resourceTypes": {
    "items": {
     "enum": [
      "agent",
      "mcp-server",
      "skill",
      "knowledge-resource",
      "gateway",
      "tool",
      "repository",
      "website",
      "documentation"
     ],
     "type": "string"
    },
    "maxItems": 9,
    "type": "array"
   },
   "task": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "trust": {
    "properties": {
     "minimumCapability": {
      "enum": [
       "detected",
       "claimed",
       "tested",
       "verified"
      ],
      "type": "string"
     },
     "minimumIdentity": {
      "enum": [
       "detected",
       "declared",
       "verified"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "discover",
 "title": "Discover resources"
}
