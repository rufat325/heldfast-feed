{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Save a delivery address"},"description":"Saves an Australian delivery address to the address book in the current buying context (names, street, suburb, state code, four-digit postcode, optional company, mobile and type), optionally as the default. Collect it from the customer; never invent one. Needs a signed-in Printdash account: called without one, the connection asks the customer to sign in on printdash.io.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"address_line1":{"description":"Street address.","maxLength":120,"minLength":1,"type":"string"},"address_line2":{"maxLength":120,"type":"string"},"city":{"description":"Suburb or town.","maxLength":60,"minLength":1,"type":"string"},"company_name":{"maxLength":120,"type":"string"},"first_name":{"maxLength":60,"minLength":1,"type":"string"},"last_name":{"maxLength":60,"minLength":1,"type":"string"},"mobile":{"maxLength":20,"type":"string"},"postal_code":{"description":"Four-digit Australian postcode.","maxLength":4,"type":"string"},"set_as_default":{"description":"Make it the default address for this buying context.","type":"boolean"},"state":{"description":"NSW, VIC, QLD, SA, WA, TAS, NT or ACT.","maxLength":3,"type":"string"},"type":{"enum":["home","business"],"type":"string"}},"required":["first_name","last_name","address_line1","city","state","postal_code"],"type":"object"},"name":"create_address","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"address":{"additionalProperties":false,"properties":{"company":{"type":["string","null"]},"country":{"type":"string"},"id":{"type":"string"},"is_default":{"type":"boolean"},"line1":{"type":"string"},"line2":{"type":["string","null"]},"mobile":{"type":["string","null"]},"name":{"type":["string","null"]},"postcode":{"type":"string"},"state":{"type":"string"},"suburb":{"type":"string"},"summary":{"type":"string"},"type":{"enum":["home","business"],"type":"string"}},"required":["id","name","company","line1","line2","suburb","state","postcode","country","mobile","type","is_default","summary"],"type":"object"},"next":{"type":"string"},"saved":{"const":true,"type":"boolean"}},"required":["saved","address","next"],"type":"object"},"securitySchemes":[{"scopes":["openid","email","profile","offline_access"],"type":"oauth2"}],"title":"Save a delivery address"}
