{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Add review comment"
 },
 "description": "Adds a comment to the document under review, anchored to a quoted passage of the review markdown, and returns the created comment. If the quoted passage is ambiguous or cannot be located, the response indicates this along with candidate passages. A comment anchored within an existing thread is added as a reply. Targeted users with document access receive email and in-app mention notifications.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "comment": {
    "description": "The comment text",
    "type": "string"
   },
   "quoted_text": {
    "description": "Quoted passage from the review markdown to anchor on",
    "type": "string"
   },
   "review_id": {
    "description": "The review identifier",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "target_user_ids": {
    "description": "User identifiers to notify. Identifiers without document access are ignored.",
    "items": {
     "maxLength": 128,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?$",
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "review_id",
   "quoted_text",
   "comment"
  ],
  "type": "object"
 },
 "name": "add_comment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "anchor": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "block": {
        "type": "string"
       },
       "kind": {
        "const": "inline",
        "type": "string"
       },
       "quotedText": {
        "type": "string"
       },
       "section": {
        "type": "string"
       }
      },
      "required": [
       "kind",
       "section",
       "block",
       "quotedText"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "section",
        "type": "string"
       },
       "section": {
        "type": "string"
       }
      },
      "required": [
       "kind",
       "section"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "detached",
        "type": "string"
       },
       "path": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     }
    ]
   },
   "candidates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "block": {
       "type": "string"
      },
      "contextAfter": {
       "type": "string"
      },
      "contextBefore": {
       "type": "string"
      },
      "quotedText": {
       "type": "string"
      },
      "section": {
       "type": "string"
      }
     },
     "required": [
      "section",
      "contextBefore",
      "quotedText",
      "contextAfter"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "commentId": {
    "type": "string"
   },
   "hint": {
    "type": "string"
   },
   "hints": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "instructions": {
    "type": "string"
   },
   "mentionedUserIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "replyTo": {
    "type": "string"
   },
   "status": {
    "enum": [
     "created",
     "ambiguous",
     "not_found",
     "unsupported"
    ],
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Add review comment"
}
