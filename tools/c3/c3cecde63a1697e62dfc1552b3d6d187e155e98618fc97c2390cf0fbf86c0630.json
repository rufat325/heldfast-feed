{
 "description": "Update a project",
 "inputSchema": {
  "properties": {
   "if_exists": {
    "default": "error",
    "enum": [
     "error",
     "return"
    ],
    "type": "string"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "example": "fm_8f3kq2",
    "type": "string"
   },
   "slug": {
    "pattern": "^[a-z0-9][a-z0-9-]{1,62}$/u",
    "type": "string"
   },
   "tags": {
    "default": [],
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "projects_update"
}
