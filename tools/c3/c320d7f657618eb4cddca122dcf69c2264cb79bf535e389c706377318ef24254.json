    ],
    "type": "string"
   },
   "cursor": {
    "description": "Row offset to resume from \u2014 the numeric position of the first row to return, not an opaque token. Rows inserted since the previous page shift it, so prefer the keyset cursor where a tool offers one.",
    "examples": [
     0,
     100
    ],
    "minimum": 0,
    "type": "integer"
   },
   "direct_submission_kinds": {
    "description": "Restrict to subnets where surfaces of this kind a contributor can submit directly. One kind per call; see this parameter's enum.",
    "enum": [
     "archive",
     "dashboard",
     "data-artifact",
     "docs",
     "example",
     "openapi",
     "repo-registry",
     "sdk",
     "source-repo",
     "sse",
     "subnet-api",
     "subtensor-rpc",
     "subtensor-wss",
     "website"
    ],
    "examples": [
     "archive"
    ],
    "type": "string"
   },
   "evidence_action": {
    "description": "What the evidence is asking a contributor to do.",
    "enum": [
     "submit-new-evidence",
     "verify-existing-evidence",
     "replace-stale-evidence",
     "review-existing-evidence",
     "maintainer-review-existing-evidence",
     "monitor"
    ],
    "examples": [
     "submit-new-evidence"
    ],
    "type": "string"
   },
   "fields": {
    "description": "Comma-separated row field names to project, e.g. `netuid,name,slug`. Bare identifiers only \u2014 not a JSON array, no paths or indices. An unknown name is rejected rather than ignored. A projected row omits every non-selected property, including ones the row schema marks required: `required` describes the unprojected response (#10960), so a client validating responses should skip validation or treat row properties as optional when it sends this parameter.",
    "examples": [
     "netuid,name,slug"
    ],
    "pattern": "^[\\s,]*[A-Za-z_][A-Za-z0-9_]*(\\s*,[\\s,]*[A-Za-z_][A-Za-z0-9_]*)*[\\s,]*$",
    "type": "string"
   },
   "lane": {
    "description": "Which contribution lane the item belongs to.",
    "enum": [
     "direct-submission",
     "maintainer-review",
     "adapter-candidate",
     "monitoring-followup",
     "baseline-monitoring"
    ],
    "examples": [
     "direct-submission"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum rows to return (1-100). Defaults to 20 when omitted. The response reports the limit actually applied.",
    "examples": [
     20
    ],
    "maximum": 100,
    "minimum": 1,
    "type": "integer",
    "x-serving-bound": true
   },
   "llm_model": {
    "description": "Your model ID if known; omit otherwise. Analytics only.",
    "examples": [
     "gpt-6"
    ],
    "type": "string"
   },
   "missing_kinds": {
    "description": "Restrict to subnets where surfaces of this kind the subnet is MISSING. One kind per call; see this parameter's enum.",
    "enum": [
     "archive",
     "dashboard",
     "data-artifact",
     "docs",
     "example",
     "openapi",
     "repo-registry",
     "sdk",
     "source-repo",
     "sse",
     "subnet-api",
     "subtensor-rpc",
     "subtensor-wss",
     "website"
    ],
    "examples": [
     "archive"
    ],
    "type": "string"
   },
   "netuid": {
    "description": "Subnet id (netuid), 0-65535. 0 is the root subnet, which is special: it has no AMM pool and is emission-ineligible.",
    "examples": [
     64,
     0
    ],
    "maximum": 65535,
    "minimum": 0,
    "type": "integer"
   },
   "order": {
    "description": "Sort direction for the chosen sort key: `asc` smallest-first, `desc` largest-first.",
    "enum": [
     "asc",
     "desc"
    ],
    "examples": [
     "desc"
    ],
    "type": "string"
   },
   "q": {
    "description": "Free-text search terms, matched as case-insensitive substrings. Not a query language: operators, quotes and wildcards are matched literally.",
    "examples": [
     "inference",
     "text embedding"
    ],
    "maxLength": 200,
    "type": "string"
   },
   "sort": {
    "description": "Column to rank the result by; pair with `order` for direction. Options are per-tool; see this parameter's enum.",
    "enum": [
     "evidence_action",
     "lane",
     "name",
     "netuid",
     "priority_score"
    ],
    "examples": [
     "evidence_action"
    ],
    "type": "string"
   }
  },
  "required": [
   "context"
  ],
  "type": "object"
 },
