 "description": "Audit a JWKS document for the things that make key selection fail. Reports a kid missing from a multi-key set and a kid used twice, which both make resolution ambiguous; a declared algorithm the key type or curve cannot perform; an RSA modulus below a stated floor; an EC coordinate whose length does not match its declared curve; use and key_ops that disagree; and private key parameters present in a document meant to be published. Pay 220000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "jwks": {
    "description": "The key document to audit. A JWKS document with a keys array, at most 100 keys. Nothing is fetched and no signature is verified, so an arbitrary provider or client can be audited without a credential and without the provider being contacted. Documents are bounded at 262144 bytes.",
    "example": {
     "keys": [
      {
       "alg": "RS256",
       "e": "AQAB",
       "kid": "2026-q3",
       "kty": "RSA",
       "n": "",
       "use": "sig"
      },
      {
       "alg": "RS256",
       "e": "AQAB",
       "kid": "2026-q3",
       "kty": "RSA",
       "n": "wQ2hKxJ8vZ5nQ3mF7tYrLpXcB1dGhJkMnOpQrStUvWxYz0123456789AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCdEfGhIjK",
       "use": "sig"
      },
      {
       "alg": "ES512",
       "crv": "P-256",
       "kid": "ec-primary",
       "kty": "EC",
       "use": "sig",
       "x": "f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU",
       "y": "x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0"
      }
     ]
    },
    "properties": {
     "keys": {
      "items": {
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     }
    },
    "required": [
     "keys"
    ],
    "type": "object"
   },
   "min_rsa_modulus_bits": {
    "description": "The RSA modulus floor to apply. Defaults to 2048.",
    "maximum": 16384,
    "minimum": 512,
    "type": "integer"
   }
  },
  "required": [
   "jwks"
  ],
  "type": "object"
 },
 "name": "jwks_document_audit",
