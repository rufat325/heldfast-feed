{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Validate a .drawio file inside the configured output directory for structural errors, dangling references, duplicate IDs, and unsafe images.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "fileName": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.drawio$",
    "type": "string"
   }
  },
  "required": [
   "fileName"
  ],
  "type": "object"
 },
 "name": "validate_drawio",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "fileName": {
    "type": "string"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "issues": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "cellId": {
         "type": "string"
        },
        "code": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "valid": {
      "type": "boolean"
     }
    },
    "required": [
     "valid",
     "issues"
    ],
    "type": "object"
   }
  },
  "required": [
   "fileName",
   "validation"
  ],
  "type": "object"
 },
 "title": "Validate a DrawArch File"
}
