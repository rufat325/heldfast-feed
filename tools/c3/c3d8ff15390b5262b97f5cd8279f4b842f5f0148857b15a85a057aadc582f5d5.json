{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update the name, description, or named color scheme of a marketing project, then return its complete file, asset, and brand index.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brandColors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "hex": {
       "pattern": "^#[0-9a-f]{3}([0-9a-f]{3})?$",
       "type": "string"
      },
      "id": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "name": {
       "maxLength": 40,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "hex"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   },
   "description": {
    "maxLength": 1000,
    "type": "string"
   },
   "name": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "workspaceProjectId": {
    "minLength": 1,
    "type": "string"
   },
   "workspaceProjectKey": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "workspaceProjectId",
   "workspaceProjectKey"
  ],
  "type": "object"
 },
 "name": "picorn_projects_update",
 "title": "Picorn Projects: update project and brand colors"
}
