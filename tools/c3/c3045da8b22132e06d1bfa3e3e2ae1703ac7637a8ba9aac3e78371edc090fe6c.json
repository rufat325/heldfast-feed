 "description": "A derived TradeBasis asking-price market average. Supply odometerMiles plus either vin or all of year, make, model and trim. Ask the user for missing details; never invent vehicle identity or mileage. VIN-assisted decoding may still require a confirmed trim, fuelType or bodyStyle. If supplied identity conflicts with the VIN, ask the user to verify the VIN and conflicting fields; do not choose silently or retry unchanged. Omit market for nationwide US. Not a trade-in offer or completed-sale value.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "year",
     "make",
     "model",
     "trim"
    ]
   },
   {
    "required": [
     "vin"
    ]
   }
  ],
  "properties": {
   "bodyStyle": {
    "description": "Optional confirmed body style: sedan, hatchback, coupe, convertible, SUV, pickup, wagon, minivan or van. Required later if identity is ambiguous; ask the user and do not contradict the VIN.",
    "maxLength": 50,
    "type": "string"
   },
   "fuelType": {
    "description": "Optional confirmed powertrain/fuel type. Required later if identity is ambiguous. Ask the user rather than selecting a default; must agree with a reported VIN powertrain.",
    "enum": [
     "Gasoline",
     "Diesel",
     "Hybrid",
     "Plug-in Hybrid",
     "Electric"
    ],
    "type": "string"
   },
   "make": {
    "description": "Confirmed vehicle manufacturer. Required without vin; optional with vin, but must agree with the decoded make.",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "market": {
    "description": "Optional US state name or two-letter state code, not the user's precise location. Omit for nationwide US.",
    "maxLength": 60,
    "type": "string"
   },
   "model": {
    "description": "Confirmed US model name. Required without vin; optional with vin, but must agree with the decoded model.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "odometerMiles": {
    "description": "Current odometer reading in miles, required for BOTH input paths. Ask the user; never estimate mileage from the VIN or model year. Zero is valid only when actually reported.",
    "maximum": 600000,
    "minimum": 0,
    "type": "number"
   },
   "trim": {
    "description": "Confirmed exact trim, including meaningful +, hyphens and powertrain qualifiers. Required without vin. With vin, supply it if decoding does not identify one unambiguous trim; never assume Base or choose from a decoded list.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "vin": {
    "description": "VIN-assisted input: provide the vehicle's 17-character VIN with odometerMiles. Optional for complete manual input. Decoding may leave trim, fuelType or bodyStyle unresolved; ask the user to confirm them, never guess. If decoding fails, confirm the VIN or omit vin and use complete manual input. Supplied identity must agree with the VIN.",
    "maxLength": 30,
    "minLength": 1,
    "type": "string"
   },
   "year": {
    "description": "Confirmed model year. Required without vin; optional with vin, but must agree with the decoded year. Ask the user if unknown.",
    "type": "integer"
   }
  },
  "required": [
   "odometerMiles"
  ],
  "type": "object"
 },
