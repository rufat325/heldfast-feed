{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Update task details (title, type, points, tags, epic, description, blocked status, acceptance criteria, relevant files). Status cannot be set here \u2014 use start_task, finish_task, accept_task, or reject_task.",
 "inputSchema": {
  "properties": {
   "acceptanceCriteria": {
    "description": "Updated acceptance criteria with completion status",
    "items": {
     "properties": {
      "completed": {
       "type": "boolean"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text",
      "completed"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "blockedReason": {
    "description": "Reason for being blocked (required if isBlocked is true)",
    "type": "string"
   },
   "description": {
    "description": "New description (markdown)",
    "type": "string"
   },
   "epicId": {
    "description": "Move the task to this epic",
    "type": "string"
   },
   "isBlocked": {
    "description": "Whether the task is blocked",
    "type": "boolean"
   },
   "points": {
    "description": "Story points (1, 2, 3, 5, or 8)",
    "type": "number"
   },
   "relevantFiles": {
    "description": "Files relevant to this task. Paths must be relative to project root.",
    "items": {
     "properties": {
      "path": {
       "description": "Relative path from project root (e.g., 'src/api/auth.ts')",
       "type": "string"
      },
      "purpose": {
       "description": "Why this file is relevant (e.g., 'main implementation', 'test file')",
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "tags": {
    "description": "Replacement tag list",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "taskId": {
    "description": "The task ID to update",
    "type": "string"
   },
   "title": {
    "description": "New title",
    "type": "string"
   },
   "type": {
    "description": "Task type",
    "enum": [
     "feature",
     "bug",
     "chore"
    ],
    "type": "string"
   }
  },
  "required": [
   "taskId"
  ],
  "type": "object"
 },
 "name": "update_task"
}
