{
 "description": "Upload one private lesson asset for an organization-owned LMS course. Bytes are base64 input, sniffed server-side, and stored privately. Returns a stable asset ID; it does not alter or publish the course.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "base64": {
    "minLength": 1,
    "type": "string"
   },
   "contentType": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "courseId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "fileName": {
    "maxLength": 240,
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Required request idempotency key. Reuse it only for the identical operation.",
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "kind": {
    "enum": [
     "IMAGE",
     "AUDIO",
     "VIDEO",
     "FILE"
    ],
    "type": "string"
   }
  },
  "required": [
   "courseId",
   "kind",
   "fileName",
   "contentType",
   "base64",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_upload_asset",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
