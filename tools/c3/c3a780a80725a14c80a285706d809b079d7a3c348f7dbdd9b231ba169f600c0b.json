{
 "_meta": {
  "openai/toolInvocation/invoked": "Published file checked",
  "openai/toolInvocation/invoking": "Fetching /llms.txt\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check a website's published llms.txt"
 },
 "description": "Use this when the user asks whether a website already has an llms.txt, whether it is served correctly, or why PageSpeed Insights / Lighthouse flags it. Requests exactly one URL, https://<domain>/llms.txt, and reports HTTP status, content type, redirects, the file content, the format validation and the Lighthouse result. Does not crawl other pages and does not change anything on the site. Messages are in German.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "Domain or any URL of the website, e.g. \"example.com\".",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "check_published_llms_txt",
 "outputSchema": {
  "properties": {
   "content": {
    "type": "string"
   },
   "contentType": {
    "type": "string"
   },
   "found": {
    "type": "boolean"
   },
   "lighthouse": {
    "description": "Result of the three Lighthouse 13.3 \"llms-txt\" audit rules.",
    "properties": {
     "checks": {
      "items": {
       "properties": {
        "failureMessage": {
         "type": "string"
        },
        "id": {
         "enum": [
          "h1",
          "links",
          "length"
         ],
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "passed": {
         "type": "boolean"
        }
       },
       "required": [
        "id",
        "passed"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "passed": {
      "type": "boolean"
     }
    },
    "required": [
     "passed",
     "checks"
    ],
    "type": "object"
   },
   "message": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "redirects": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "type": "integer"
   },
   "url": {
    "type": "string"
   },
   "validation": {
    "description": "Format check against the llmstxt.org proposal.",
    "properties": {
     "byteSize": {
      "type": "number"
     },
     "issues": {
      "items": {
       "properties": {
        "code": {
         "type": "string"
        },
        "line": {
         "type": "number"
        },
        "message": {
         "type": "string"
        },
        "severity": {
         "enum": [
          "error",
          "warning",
          "info"
         ],
         "type": "string"
        }
       },
       "required": [
        "code",
        "severity",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "links": {
      "type": "number"
     },
     "score": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     },
     "valid": {
      "description": "true when no error-level finding exists.",
      "type": "boolean"
     }
    },
    "required": [
     "valid",
     "score",
     "issues"
    ],
    "type": "object"
   }
  },
  "required": [
   "url",
   "found",
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Check a website's published llms.txt"
}
