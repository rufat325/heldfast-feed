 "description": "Write multiple text files to private bucket storage. Respect locks and expected_bucket_revision_id. Use path operations to reorganize existing files without rewriting bytes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "account_id": {
    "description": "Optional account id from revdoku_status.accounts for this call only. Omit for the credential's default account. Client accounts require explicit Agency authorization; never infer an account from a bucket id.",
    "type": "string"
   },
   "bucket_id": {
    "description": "Real Revdoku bucket id returned by bucket_create or bucket_list, for example bkt_...; never use a placeholder id.",
    "type": "string"
   },
   "delete_missing": {
    "default": false,
    "description": "When true, delete existing bucket files that are not present in this write set.",
    "type": "boolean"
   },
   "expected_bucket_revision_id": {
    "description": "Optional optimistic-concurrency token from bucket.current_bucket_revision_id. A stale value returns BUCKET_REVISION_CONFLICT without saving any file.",
    "type": "string"
   },
   "files": {
    "description": "Array of text files to write to the bucket.",
    "items": {
     "properties": {
      "content": {
       "description": "UTF-8 text file content (HTML/CSS/JS/JSON/SVG/Markdown/etc.). Use revdoku upload or REST direct uploads for binary files (images, fonts, PDFs).",
       "type": "string"
      },
      "content_type": {
       "description": "MIME type such as text/html, text/css, text/plain, or application/json.",
       "type": "string"
      },
      "path": {
       "description": "Bucket-relative path, for example notes.md, leads.csv, or site/index.html.",
       "type": "string"
      },
      "reason": {
       "description": "Optional reason for this action. AI agents should include a short purpose for intentional reads and changes when known. Do not invent a reason or include secrets, file contents, or transcripts.",
       "maxLength": 2000,
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "path",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "reason": {
    "description": "Optional reason for this action. AI agents should include a short purpose for intentional reads and changes when known. Do not invent a reason or include secrets, file contents, or transcripts.",
    "maxLength": 2000,
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "bucket_id",
   "files"
  ],
  "type": "object"
 },
