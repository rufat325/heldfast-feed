     "properties": {
      "fileName": {
       "type": "string"
      },
      "structured": {
       "type": "object"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "smtpHost": {
    "description": "SMTP server host",
    "type": "string"
   },
   "smtpPass": {
    "description": "SMTP password or app password",
    "type": "string"
   },
   "smtpPort": {
