{
 "description": "Create a new script in Home Assistant",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "config": {
    "additionalProperties": {},
    "description": "Script config. Must include: alias, sequence. Optional: mode, description, icon, fields.",
    "type": "object"
   },
   "object_id": {
    "description": "Unique script ID (e.g. 'morning_routine')",
    "type": "string"
   }
  },
  "required": [
   "object_id",
   "config"
  ],
  "type": "object"
 },
 "name": "ha_create_script"
}
