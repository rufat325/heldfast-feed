{"annotations":{"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Wait for an existing quick-schema run_id until result.status is completed, completed_with_errors, or failed. Terminal failure is returned in result, so inspect status and failed_documents rather than assuming a successful tool call means full success. Returns generated template IDs and saved document IDs for future extraction or result retrieval. SDK defaults are 5 seconds between polls and 300 attempts; choose a smaller max_poll_attempts for short client timeouts. On polling timeout, check or wait on the same run_id rather than starting another run.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"api_url":{"not":{}},"max_poll_attempts":{"description":"Maximum status requests before polling timeout. SDK default: 300. Set lower to fit the MCP client's tool timeout; resume with the same run_id.","exclusiveMinimum":0,"type":"integer"},"poll_interval":{"description":"Seconds between status requests. SDK default: 5.","minimum":0,"type":"number"},"run_id":{"description":"run_id returned by start_quick_schema_creation; not an extraction task ID, document ID, or export job ID.","minLength":1,"type":"string"}},"required":["run_id"],"type":"object"},"name":"wait_for_quick_schema_creation","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"result":{"anyOf":[{"additionalProperties":true,"properties":{"can_retry_failed":{"type":"boolean"},"error_code":{"type":"string"},"error_message":{"type":"string"},"failed_documents_count":{"type":["number","null"]},"parent_document_id":{"type":["string","null"]},"path":{"type":"string"},"stage":{"type":"string"},"status":{"const":"failed","type":"string"},"total_documents":{"type":["number","null"]}},"required":["status","stage","error_code","error_message","path","can_retry_failed"],"