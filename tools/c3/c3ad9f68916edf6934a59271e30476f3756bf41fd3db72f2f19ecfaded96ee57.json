    "type": "string"
   },
   "package_name": {
    "description": "Package name.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ecosystem",
   "package_name"
  ],
  "type": "object"
 },
 "name": "query_package_registry",
 "title": "Query Package Registry"
}
