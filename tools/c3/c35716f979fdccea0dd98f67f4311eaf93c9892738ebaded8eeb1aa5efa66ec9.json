{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Cloud Insight monitoring target group (\uac10\uc2dc \ub300\uc0c1 \uadf8\ub8f9).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "groupDesc": {
    "description": "Description of the monitor group",
    "type": "string"
   },
   "groupName": {
    "description": "Name of the monitor group",
    "type": "string"
   },
   "monitorGroupItemList": {
    "description": "Monitoring targets ([{resourceId, nrn?}])",
    "items": {
     "additionalProperties": false,
     "properties": {
      "nrn": {
       "description": "Resource NRN (Resource Manager)",
       "type": "string"
      },
      "resourceId": {
       "description": "Monitoring target resource ID (e.g. server instance number)",
       "type": "string"
      },
      "resourceName": {
       "description": "Resource name",
       "type": "string"
      }
     },
     "required": [
      "resourceId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "prodKey": {
    "description": "Product key (cw_key) for the target service",
    "type": "string"
   },
   "prodName": {
    "description": "Product name",
    "type": "string"
   },
   "temporaryGroup": {
    "description": "true: create the Event Rule without creating a monitor group",
    "type": "boolean"
   },
   "type": {
    "description": "Target group type: NORMAL (default) or ASG (Auto Scaling Group)",
    "enum": [
     "NORMAL",
     "ASG"
    ],
    "type": "string"
   }
  },
  "required": [
   "prodKey",
   "monitorGroupItemList"
  ],
  "type": "object"
 },
 "name": "ncloud_create_monitor_group"
}
