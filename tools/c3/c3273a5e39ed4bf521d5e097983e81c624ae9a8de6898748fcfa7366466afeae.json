{
 "description": "Actually RUN a Hook's real WebAssembly bytecode in a local VM against a simulated transaction + ledger state, and report the true accept/rollback decision, return code/string, state writes, emitted txns and execution trace. Needs no xahaud node. Implements a subset of the Hook API; unsupported calls are recorded (fidelity LOCAL_VM, never faked).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "feeBase": {
    "type": "number"
   },
   "hookAccountId": {
    "description": "20-byte account-id hex the hook is installed on",
    "type": "string"
   },
   "hookParams": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "keyletBlobs": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "32-byte ledger index hex -> serialized object hex, for slot_set",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "ledgerSeq": {
    "type": "number"
   },
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   },
   "otxnBlob": {
    "description": "full originating-txn serialized blob hex (enables otxn_slot)",
    "type": "string"
   },
   "otxnFields": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "field-id -> hex value of originating-txn fields the hook reads",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "otxnParams": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "otxn param name -> hex value",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "resolveKeylets": {
    "description": "if true, fetch any slot_set'd ledger objects live and re-run (async pre-resolve)",
    "type": "boolean"
   },
   "state": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "initial hook state: 32-byte key hex -> value hex",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "txType": {
    "description": "originating tx type, e.g. \"Payment\"",
    "type": "string"
   },
   "wasmBase64": {
    "maxLength": 180000,
    "type": "string"
   },
   "wasmHex": {
    "maxLength": 262144,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "execute_hook",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "caveat": {
    "type": "string"
   },
   "degraded": {
    "type": "boolean"
   },
   "emitted": {
    "items": {},
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "exit": {
    "type": "string"
   },
   "fidelity": {
    "type": "string"
   },
   "foreignStateWrites": {
    "items": {},
    "type": "array"
   },
   "resolvedForeignState": {
    "items": {},
    "type": "array"
   },
   "resolvedKeylets": {
    "items": {},
    "type": "array"
   },
   "returnCode": {},
   "returnString": {
    "type": "string"
   },
   "stateApplied": {},
   "stateWrites": {
    "items": {},
    "type": "array"
   },
   "syntheticCalls": {
    "items": {},
    "type": "array"
   },
   "trace": {
    "items": {},
    "type": "array"
   },
   "unsupportedCalls": {
    "items": {},
    "type": "array"
   },
   "wantedForeignState": {
    "items": {},
    "type": "array"
   },
   "wantedKeylets": {
    "items": {},
    "type": "array"
   }
  },
  "type": "object"
 }
}
