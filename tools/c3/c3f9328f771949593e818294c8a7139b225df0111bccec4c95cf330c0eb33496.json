{
 "annotations": {
  "readOnlyHint": true,
  "title": "List tasks"
 },
 "description": "List operational tasks (cleaning, maintenance, check-in/out) with assignee, status, time window and cost. Filter by reservation, status, text match, channel, or start/deadline windows. Hostaway: GET /v1/tasks.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "canStartFromEnd": {
    "description": "Start window until (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "canStartFromStart": {
    "description": "Start window from (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "channelId": {
    "description": "Channel id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "limit": {
    "description": "Maximum records to return (1-500).",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "match": {
    "description": "Text search.",
    "type": "string"
   },
   "offset": {
    "description": "Records to skip from the start.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "reservationId": {
    "description": "Only tasks for this reservation.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "shouldEndByEnd": {
    "description": "Deadline until (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "shouldEndByStart": {
    "description": "Deadline from (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "status": {
    "description": "Task status.",
    "enum": [
     "pending",
     "confirmed",
     "inProgress",
     "completed",
     "cancelled"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "hostaway_list_tasks",
 "title": "List tasks"
}
