       "minimum": -9007199254740991,
       "type": "integer"
      },
      "quantity": {
       "description": "Quantity (max 1000 per item).",
       "maximum": 1000,
       "minimum": 1,
       "type": "integer"
      },
      "retail_price": {
       "description": "Retail price shown on the packing slip, e.g. \"29.99\".",
       "type": "string"
      },
      "sku": {
       "description": "Your SKU.",
       "type": "string"
      },
      "sync_variant_id": {
       "description": "Sync Variant id from your Printful store.",
