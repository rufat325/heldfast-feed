     "zip": {
      "description": "ZIP / postal code.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "retail_costs": {
    "properties": {
     "currency": {
      "description": "3-letter currency code.",
      "type": "string"
     },
     "discount": {
      "type": "string"
     },
     "shipping": {
      "type": "string"
     },
     "subtotal": {
      "type": "string"
     },
     "tax": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "shipping": {
    "description": "New shipping method id.",
    "type": "string"
   },
   "store_id": {
    "description": "Store id (numeric) for an ACCOUNT-level token; overrides PRINTFUL_STORE_ID. Not needed with a store-level token.",
    "type": "string"
   }
  },
  "required": [
   "order_id"
  ],
  "type": "object"
 },
 "name": "printful_update_draft_order",
 "title": "Update a draft order"
}
