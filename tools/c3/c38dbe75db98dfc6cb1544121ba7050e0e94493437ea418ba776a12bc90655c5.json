{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a draft order"
 },
 "description": "Change a DRAFT order (unsubmitted orders only) \u2014 send only the fields to change. CAUTION: if you send `items`, it replaces the list: existing items not included (by id or external_id) are removed. The order stays a draft; nothing is charged. Printful: PUT /orders/{id} (never with confirm).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "external_id": {
    "description": "New external id.",
    "type": "string"
   },
   "gift": {
    "properties": {
     "message": {
      "description": "Gift message text.",
      "type": "string"
     },
     "subject": {
      "description": "Gift message title.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "items": {
    "description": "Full replacement item list (see caution).",
