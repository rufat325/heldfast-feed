{
 "description": "List recent test runs. Filter by target, status, or test slug. Returns run status, score, summary, duration, and finding count.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 25,
    "description": "Max number of runs to return",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "status": {
    "description": "Filter by run status",
    "enum": [
     "QUEUED",
     "RUNNING",
     "PASSED",
     "WARNING",
     "FAILED",
     "CANCELED"
    ],
    "type": "string"
   },
   "targetId": {
    "description": "Filter by target ID",
    "type": "string"
   },
   "testSlug": {
    "description": "Filter by test definition slug (e.g. \"security-headers\")",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_runs",
 "title": "List Runs"
}
