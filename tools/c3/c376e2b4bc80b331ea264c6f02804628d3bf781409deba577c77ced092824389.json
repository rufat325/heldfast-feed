{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Create a compensation claim letter for an airline delay/cancellation, using EU261/UK261. Use this when you need a formal letter to send to the airline. Do NOT use when you need to check eligibility first; use check_compensation instead.",
 "inputSchema": {
  "properties": {
   "airline_name": {
    "description": "Name of the airline",
    "type": "string"
   },
   "arrival": {
    "description": "IATA code",
    "type": "string"
   },
   "booking_reference": {
    "description": "Booking reference number",
    "type": "string"
   },
   "claimed_amount": {
    "description": "Amount of compensation claimed",
    "type": "number"
   },
   "currency": {
    "description": "Currency of the claimed amount, ISO code",
    "enum": [
     "EUR",
     "GBP"
    ],
    "type": "string"
   },
   "departure": {
    "description": "IATA code",
    "type": "string"
   },
   "flight_date": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "flight_number": {
    "description": "e.g. BA117",
    "type": "string"
   },
   "incident_summary": {
    "description": "Brief description of the delay/cancellation",
    "type": "string"
   },
   "passenger_name": {
    "description": "Full name of the passenger",
    "type": "string"
   },
   "scheme": {
    "description": "Compensation scheme, EU261 or UK261",
    "enum": [
     "EU261",
     "UK261"
    ],
    "type": "string"
   }
  },
  "required": [
   "passenger_name",
   "airline_name",
   "flight_number",
   "flight_date",
   "departure",
   "arrival"
  ],
  "type": "object"
 },
 "name": "generate_claim_letter",
 "outputSchema": {
  "properties": {
   "letter": {
    "description": "The generated claim letter as a plain text string.",
    "type": "string"
   },
   "letter_html": {
    "description": "The generated claim letter as an HTML string.",
    "type": "string"
   },
   "letter_pdf": {
    "description": "The generated claim letter as a PDF file in base64 encoding.",
    "format": "byte",
    "type": "string"
   }
  },
  "required": [
   "letter"
  ],
  "type": "object"
 },
 "title": "Generate claim letter"
}
