{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a split payment for marketplaces (distributes funds among partner shops). Requires the YooKassa-for-platforms product. MOVES REAL MONEY \u2014 irreversible.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "anyOf": [
     {
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    ],
    "description": "Total payment amount"
   },
   "confirmation_type": {
    "default": "redirect",
    "description": "Confirmation type: redirect (needs return_url), embedded, or qr",
    "enum": [
     "redirect",
     "embedded",
     "qr"
    ],
    "type": "string"
   },
   "currency": {
    "default": "RUB",
    "description": "Currency (ISO-4217, default RUB)",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "description": {
    "description": "Payment description",
    "maxLength": 128,
    "type": "string"
   },
   "return_url": {
    "description": "Return URL \u2014 REQUIRED when confirmation_type=redirect",
    "format": "uri",
    "type": "string"
   },
   "transfers": {
    "description": "Recipients (splits). The sum of transfers must equal amount. Requires the Split Payments product",
    "items": {
     "additionalProperties": false,
     "properties": {
      "account_id": {
       "description": "Recipient ID (partner shopId connected to the platform)",
       "type": "string"
      },
      "amount": {
       "anyOf": [
        {
         "$ref": "#/properties/amount/anyOf/0"
        },
        {
         "$ref": "#/properties/amount/anyOf/1"
        }
       ],
       "description": "Amount for this recipient"
      },
      "description": {
       "description": "Transfer description",
       "type": "string"
      },
      "metadata": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Transfer metadata",
       "type": "object"
      },
      "platform_fee_amount": {
       "anyOf": [
        {
         "$ref": "#/properties/amount/anyOf/0"
        },
        {
         "$ref": "#/properties/amount/anyOf/1"
        }
       ],
       "description": "Platform commission withheld from this transfer (API field platform_fee_amount)"
      }
     },
     "required": [
      "account_id",
      "amount"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "amount",
   "description",
   "transfers"
  ],
  "type": "object"
 },
 "name": "create_split_payment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "confirmation_url": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "paid": {
    "type": "boolean"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Create split payment"
}
