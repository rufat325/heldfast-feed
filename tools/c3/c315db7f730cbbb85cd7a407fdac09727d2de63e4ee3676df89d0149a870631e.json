{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculates indicators from prices the user gives. Use it when the user gives their own prices and wants indicators calculated, such as \"calculate ATR and stochastic from these candles\". Pass prices (2 to 250 candles, oldest first, each with a numeric close and optionally time, open, high, low and volume) and indicators from sma, ema, rsi, macd, bollinger, atr, stochastic and vwap; optionally periods and series_length. atr and stochastic need high and low on every candle, and vwap needs high, low and volume. Returns the latest value and a short series for each indicator, with the settings used. Makes no outside request and keeps nothing. Informational only, not financial advice; gives no signals.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "indicators": {
    "description": "Indicators to calculate: sma, ema, rsi, macd (12, 26, 9), bollinger (2 standard deviations), atr, stochastic (%K and %D) and vwap (cumulative over the given candles)",
    "items": {
     "enum": [
      "sma",
      "ema",
      "rsi",
      "macd",
      "bollinger",
      "atr",
      "stochastic",
      "vwap"
     ],
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "periods": {
    "additionalProperties": false,
    "description": "Lookback length per indicator, in candles; any left out use the default shown",
    "properties": {
     "atr": {
      "description": "14 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "bollinger": {
      "description": "20 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "ema": {
      "description": "20 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "rsi": {
      "description": "14 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "sma": {
      "description": "20 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "stochastic": {
      "description": "14 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "prices": {
    "description": "Candles, oldest first, at most 250",
    "items": {
     "additionalProperties": false,
     "properties": {
      "close": {
       "type": "number"
      },
      "high": {
       "description": "Needed for atr, stochastic and vwap",
       "type": "number"
      },
      "low": {
       "description": "Needed for atr, stochastic and vwap",
       "type": "number"
      },
      "open": {
       "type": "number"
      },
      "time": {
       "description": "Date or time of the candle, such as \"2026-09-30\"; only echoed back",
       "maxLength": 40,
       "type": "string"
      },
      "volume": {
       "description": "Needed for vwap",
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "close"
     ],
     "type": "object"
    },
    "maxItems": 250,
    "minItems": 2,
    "type": "array"
   },
   "series_length": {
    "description": "How many of the most recent values to return for each indicator, 5 by default",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "prices",
   "indicators"
  ],
  "type": "object"
 },
 "name": "compute_indicators",
 "outputSchema": {
  "properties": {
   "asOf": {
    "description": "Date or time of the last price used",
    "type": "string"
   },
   "candles": {
    "description": "Number of candles the indicators were calculated over",
    "type": "integer"
   },
   "error": {
    "description": "Present when status is not ok: a stable code, what went wrong and what to do next.",
    "properties": {
     "code": {
      "type": "string"
     },
     "hint": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "hint"
    ],
    "type": "object"
   },
   "indicators": {
    "items": {
     "properties": {
      "indicator": {
       "enum": [
        "sma",
        "ema",
        "rsi",
        "macd",
        "bollinger",
        "atr",
        "stochastic",
        "vwap"
       ],
       "type": "string"
      },
      "latest": {
       "description": "One value of the indicator: the candle's position (0 is the first), its time when one was given, and the value or values",
       "properties": {
        "d": {
         "type": "number"
        },
        "histogram": {
         "type": "number"
        },
        "index": {
         "type": "integer"
        },
        "k": {
         "type": "number"
        },
        "lower": {
         "type": "number"
        },
        "macd": {
         "type": "number"
        },
        "middle": {
         "type": "number"
        },
        "signal": {
         "type": "number"
        },
        "time": {
         "type": [
          "string",
          "null"
         ]
        },
        "upper": {
         "type": "number"
        },
        "value": {
         "type": "number"
        }
       },
       "required": [
        "index",
        "time"
       ],
       "type": "object"
      },
      "params": {
       "description": "The settings used",
       "type": "object"
      },
      "series": {
       "description": "The most recent values, oldest first, ending with latest",
       "items": {
        "description": "One value of the indicator: the candle's position (0 is the first), its time when one was given, and the value or values",
        "properties": {
         "d": {
          "type": "number"
         },
         "histogram": {
          "type": "number"
         },
         "index": {
          "type": "integer"
         },
         "k": {
          "type": "number"
         },
         "lower": {
          "type": "number"
         },
         "macd": {
          "type": "number"
         },
         "middle": {
          "type": "number"
         },
         "signal": {
          "type": "number"
         },
         "time": {
          "type": [
           "string",
           "null"
          ]
         },
         "upper": {
          "type": "number"
         },
         "value": {
          "type": "number"
         }
        },
        "required": [
         "index",
         "time"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "indicator",
      "params",
      "latest",
      "series"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "latestClose": {
    "type": [
     "number",
     "null"
    ]
   },
   "library": {
    "description": "The library that did the calculation",
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "skipped": {
    "description": "Requested indicators that could not be calculated, with the reason",
    "items": {
     "properties": {
      "indicator": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "indicator",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "description": "Where the prices came from",
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "invalid_input",
     "no_data",
     "unavailable"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "candles",
   "latestClose",
   "indicators",
   "skipped",
   "notice",
   "library",
   "source",
   "asOf"
  ],
  "type": "object"
 },
 "title": "Compute indicators"
}
