            "type": "string"
           }
          },
          "required": [
           "tenant_id"
          ],
          "type": "object"
         },
         "name": "list_orders",
         "outputSchema": {
          "properties": {
           "items": {
            "type": "array"
           },
           "next_page": {
            "type": [
             "integer",
             "null"
            ]
           }
          },
          "required": [
           "items"
          ],
          "type": "object"
         }
        },
        {
         "annotations": {
          "readOnlyHint": true
         },
         "description": "Fetch one order by its identifier, including line items and the current fulfilment state.",
         "inputSchema": {
          "properties": {
           "order_id": {
            "description": "The order identifier.",
            "type": "string"
           }
          },
          "required": [
           "order_id"
          ],
          "type": "object"
         },
         "name": "get_order",
         "outputSchema": {
          "properties": {
           "id": {
            "type": "string"
           },
           "total": {
            "type": "number"
           }
          },
          "required": [
           "id"
          ],
          "type": "object"
         }
        },
        {
         "annotations": {
          "destructiveHint": true,
          "idempotentHint": false
         },
         "description": "Cancel an order that has not yet shipped. This cannot be undone and will issue a refund where one is due.",
         "inputSchema": {
          "properties": {
           "order_id": {
            "description": "The order to cancel.",
            "type": "string"
           },
           "reason": {
            "description": "Why it is being cancelled.",
            "type": "string"
           }
          },
          "required": [
           "order_id"
          ],
          "type": "object"
         },
         "name": "cancel_order"
        }
       ]
      }
     },
     {
      "name": "billing",
      "toolset": {
       "tools": [
        {
         "description": "Fetch an invoice line for an order.",
         "inputSchema": {
          "properties": {
           "order_id": {
            "description": "id",
            "type": "string"
           }
          },
