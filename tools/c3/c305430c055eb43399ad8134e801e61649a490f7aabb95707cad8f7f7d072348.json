          "readOnlyHint": true
         },
         "description": "List orders for a tenant, newest first, with optional paging. Returns only orders the caller is entitled to see.",
         "inputSchema": {
          "properties": {
           "page": {
            "description": "Page number, starting at 1.",
            "minimum": 1,
            "type": "integer"
           },
