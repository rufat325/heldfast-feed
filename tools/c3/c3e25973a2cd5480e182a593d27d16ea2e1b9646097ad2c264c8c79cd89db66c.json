{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get one UTC day's events with a short overview paragraph. Use it for \"give me yesterday's digest\" or \"what happened on 2026-10-20?\". Optional: date as YYYY-MM-DD (default: the last finished day; days are kept for 30 days), limit (default 10, at most 25). Returns the overview (null if it has not been written yet), the day's events ranked by score and heat with their sources, and asOf. The overview for a day is written after the day ends.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "date": {
    "description": "UTC day as YYYY-MM-DD. Default: the last finished day. Days are kept for 30 days.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "description": "Most events returned (default 10)",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "niche": {
    "description": "The topic area to read. Only \"ai-coding-agents\" (AI coding agents) exists today, and it is the default.",
    "enum": [
     "ai-coding-agents"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "daily_digest",
 "outputSchema": {
  "properties": {
   "asOf": {
    "description": "When the sources were last read completely",
    "type": [
     "string",
     "null"
    ]
   },
   "date": {
    "type": "string"
   },
   "events": {
    "items": {
     "properties": {
      "category": {
       "type": "string"
      },
      "firstReported": {
       "type": "string"
      },
      "heat": {
       "description": "Independent sources that reported the event within 48 hours of its first report",
       "type": "integer"
      },
      "id": {
       "type": "string"
      },
      "lastReported": {
       "type": "string"
      },
      "score": {
       "description": "0 to 10",
       "type": "number"
      },
      "scoring": {
       "enum": [
        "model",
        "rules"
       ],
       "type": "string"
      },
      "sources": {
       "items": {
        "properties": {
         "name": {
          "type": "string"
         },
         "publishedAt": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "url",
         "publishedAt"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "summary": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "summary",
      "category",
      "score",
      "heat",
      "scoring",
      "firstReported",
      "lastReported",
      "sources"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "niche": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "overview": {
    "type": [
     "string",
     "null"
    ]
   },
   "total": {
    "description": "Matching events before the limit was applied",
    "type": "integer"
   }
  },
  "required": [
   "niche",
   "date",
   "asOf",
   "overview",
   "events",
   "total"
  ],
  "type": "object"
 },
 "title": "Get a day's AI coding agent digest"
}
