 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "What's new \u2014 patterns by first_seen recency"
 },
 "description": "Patterns whose first_seen timestamp falls inside a recency window \u2014 the \"what showed up recently\" question. Distinct from `log10x_top_patterns` (current cost ranking) and `log10x_whats_changing` (delta vs baseline). New patterns have no baseline, so delta math is meaningless; this tool exists so they get a clean home and don't pollute the changing-vs-baseline surface. Implementation: queries bytes_per_pattern in the current `timeRange` window to find candidate hashes, then for each hash queries the 30-day history to find the earliest non-zero datapoint via `fetchFirstSeenBatch`. A pattern is \"new\" when its first_seen timestamp is younger than `first_seen_within` (default `1d`). Default sort: by first_seen recency descending (most recent first). Use `first_seen_within: \"1h\"` for incident triage, `\"1d\"` for daily-deploy review, `\"7d\"+` for weekly observability hygiene. Returns patterns with first_seen, age, cost_now_usd, bytes_now, events_now, and the service + severity attribution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "analyzerCost": {
    "description": "SIEM ingestion cost in $/GB. Auto-detected from profile if omitted.",
    "type": "number"
   },
   "environment": {
    "description": "Environment nickname (for multi-env setups).",
    "type": "string"
   },
   "first_seen_within": {
    "default": "1d",
    "description": "Patterns whose first-seen timestamp is younger than this are \"new.\" Default `1d`. Use `1h` for incident triage, `1d` for daily-deploy review, `7d`+ for weekly observability hygiene.",
    "enum": [
     "1h",
     "6h",
     "12h",
     "1d",
     "7d",
     "14d",
     "30d"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max patterns to return. Default 10.",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "service": {
    "description": "Service name to scope the result. Omit for all services.",
    "type": "string"
   },
   "severity": {
    "description": "Severity level to scope (e.g. `ERROR`, `CRITICAL`).",
    "type": "string"
   },
   "timeRange": {
    "default": "1h",
    "description": "Time range used to score current cost. Default 1h.",
    "pattern": "^\\d+[mhd]$",
    "type": "string"
   },
   "view": {
    "default": "summary",
    "description": "Output format.",
    "enum": [
     "summary",
     "markdown"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
