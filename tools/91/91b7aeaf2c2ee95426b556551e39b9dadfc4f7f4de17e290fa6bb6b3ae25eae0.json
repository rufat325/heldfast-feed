{
 "description": "Build a TTEOP v0.1-draft schema-conforming telemetry envelope from token counts. Computes Yield (\u03a5), Leverage (L), Velocity (V), output_fraction (F), and log_leverage (D). No data is submitted or persisted. Returns the complete envelope as JSON.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cache_read": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cache-read tokens, or null when unavailable."
   },
   "cache_write": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cache-write tokens, or null when unavailable."
   },
   "cohort_id": {
    "description": "Cohort identifier for private-managed-cohort mode. Requires operator_key.",
    "type": "string"
   },
   "input": {
    "description": "Fresh input tokens (non-negative integer, required).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "model": {
    "description": "Model identifier (e.g., 'claude-sonnet-4', 'gpt-4o').",
    "type": "string"
   },
   "operator_key": {
    "description": "Pseudonymous operator identifier. Must not contain real-world identity.",
    "type": "string"
   },
   "output": {
    "description": "Output tokens (non-negative integer, required).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "privacy_mode": {
    "description": "Privacy mode. Default: public-pseudonymous.",
    "enum": [
     "public-pseudonymous",
     "private-managed-cohort",
     "enterprise-isolated"
    ],
    "type": "string"
   },
   "provenance_level": {
    "description": "Provenance level. Default: self-reported.",
    "enum": [
     "self-reported",
     "collector-attested",
     "platform-verified",
     "signed"
    ],
    "type": "string"
   },
   "provider": {
    "description": "Provider name (e.g., 'anthropic', 'openai', 'google').",
    "type": "string"
   },
   "tool": {
    "description": "AI tool name (e.g., 'claude-code', 'cursor', 'copilot').",
    "type": "string"
   }
  },
  "required": [
   "input",
   "output"
  ],
  "type": "object"
 },
 "name": "tteop_build_envelope"
}
