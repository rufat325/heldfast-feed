{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Runs a command in a uv-managed environment and returns structured output.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "command": {
    "description": "Command and arguments to run (e.g. ['python', 'script.py'])",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "envFile": {
    "description": "Path to environment file (--env-file FILE)",
    "maxLength": 4096,
    "type": "string"
   },
   "frozen": {
    "default": false,
    "description": "Run without updating the lockfile (--frozen)",
    "type": "boolean"
   },
   "isolated": {
    "default": false,
    "description": "Run in a clean isolated environment (--isolated)",
    "type": "boolean"
   },
   "locked": {
    "default": false,
    "description": "Assert the lockfile is up-to-date (--locked)",
    "type": "boolean"
   },
   "module": {
    "default": false,
    "description": "Run as python -m <module> instead of a script (-m)",
    "type": "boolean"
   },
   "noSync": {
    "default": false,
    "description": "Skip syncing the environment for faster execution (--no-sync)",
    "type": "boolean"
   },
   "outputLimit": {
    "default": 20000,
    "description": "Maximum characters to return for stdout/stderr before truncation",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   },
   "python": {
    "description": "Python interpreter version to use (-p VERSION)",
    "maxLength": 255,
    "type": "string"
   },
   "withPackages": {
    "description": "Additional packages to inject for one-off use (--with PKG)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   }
  },
  "required": [
   "command"
  ],
  "type": "object"
 },
 "name": "uv-run",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "commandStderr": {
    "type": "string"
   },
   "exitCode": {
    "type": "number"
   },
   "stderr": {
    "type": "string"
   },
   "stderrTotalLines": {
    "type": "number"
   },
   "stderrTruncated": {
    "type": "boolean"
   },
   "stdout": {
    "type": "string"
   },
   "stdoutTotalLines": {
    "type": "number"
   },
   "stdoutTruncated": {
    "type": "boolean"
   },
   "success": {
    "type": "boolean"
   },
   "truncated": {
    "type": "boolean"
   },
   "uvDiagnostics": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "exitCode",
   "success"
  ],
  "type": "object"
 },
 "title": "uv Run"
}
