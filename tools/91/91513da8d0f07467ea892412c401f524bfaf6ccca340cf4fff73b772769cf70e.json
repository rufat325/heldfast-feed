{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Report citation trend over time"
 },
 "description": "Report citation rate over time for a panel from stored snapshots. Read-only; cache-only \u2014 makes no API calls to any AI engine and costs no API quota. Reads snapshot files from <config>/snapshots/<panel>/. Returns: snapshots[] (one entry per panel_run invocation, each with timestamp and citation_rate), plus per-query deltas (gained/lost/unchanged) comparing first vs last snapshot. Returns an empty series when no snapshots exist yet. No auth required. No rate limits. Use panel_run to accumulate snapshots first; use since to restrict the time window.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "panel": {
    "description": "Panel name to report on.",
    "minLength": 1,
    "type": "string"
   },
   "since": {
    "description": "ISO date floor, e.g. '2026-01-01'. Only include snapshots on or after.",
    "type": "string"
   }
  },
  "required": [
   "panel"
  ],
  "type": "object"
 },
 "name": "citations_trend",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Domain tracked by the panel.",
    "type": "string"
   },
   "first_taken_at": {
    "description": "Timestamp of the oldest snapshot.",
    "type": "string"
   },
   "last_taken_at": {
    "description": "Timestamp of the newest snapshot.",
    "type": "string"
   },
   "panel": {
    "description": "Panel name.",
    "type": "string"
   },
   "query_deltas": {
    "description": "Per-query changes between first and last snapshot.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "change": {
       "enum": [
        "gained",
        "lost",
        "unchanged"
       ],
       "type": "string"
      },
      "first": {
       "type": "boolean"
      },
      "last": {
       "type": "boolean"
      },
      "query": {
       "type": "string"
      }
     },
     "required": [
      "query",
      "change",
      "first",
      "last"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "series": {
    "description": "Time-series of citation rates, one entry per snapshot.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "citation_rate": {
       "description": "Citation rate at this snapshot (0-1).",
       "type": "number"
      },
      "engine": {
       "type": "string"
      },
      "queries_cited": {
       "type": "number"
      },
      "queries_total": {
       "type": "number"
      },
      "taken_at": {
       "type": "string"
      }
     },
     "required": [
      "taken_at",
      "engine",
      "queries_total",
      "queries_cited",
      "citation_rate"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "snapshots": {
    "description": "Number of snapshots available.",
    "type": "number"
   }
  },
  "required": [
   "panel",
   "snapshots",
   "series",
   "query_deltas"
  ],
  "type": "object"
 }
}
