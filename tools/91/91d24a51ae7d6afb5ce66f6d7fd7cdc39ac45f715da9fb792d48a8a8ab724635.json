{
 "description": "Verify the exact proof file for a previously started enrollment. Successful enrollment expires after 24 hours.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "enrollment_id": {
    "pattern": "^[a-f0-9-]{36}$",
    "type": "string"
   },
   "read_token": {
    "maxLength": 128,
    "minLength": 32,
    "type": "string"
   }
  },
  "required": [
   "enrollment_id",
   "read_token"
  ],
  "type": "object"
 },
 "name": "verify_target"
}
