{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a QR scan scaffold with sanitized scan events, route maps, sanitization policy, adapter source, and token/URL safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "http_json",
    "enum": [
     "websocket_json",
     "http_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9087/qr-scans",
    "type": "string"
   },
   "campaign_label": {
    "default": "visitor_scan",
    "type": "string"
   },
   "name": {
    "default": "qr_scan_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the QR scaffold.",
    "type": "string"
   },
   "route_count": {
    "default": 6,
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   },
   "sanitization_level": {
    "default": "route_only",
    "enum": [
     "route_only",
     "pseudonymous",
     "approval_required"
    ],
    "type": "string"
   },
   "scan_event_count": {
    "default": 24,
    "maximum": 4096,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_qr_scan_bus",
 "title": "Connect QR scan bus"
}
