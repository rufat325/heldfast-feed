{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search deck slides"
 },
 "description": "Use this when someone wants slides about a topic across companies' decks, for example a project, a market, a peer comparison or a named asset. Give it the words to find. Returns matching slides from every deck in 6ix's Deck library, newest decks first (a deck's matching slides together), with company, deck, date, slide number, a short excerpt and 6ix.com link, and how many decks match (decks, not slides); pass nextCursor as cursor for more slides.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "To read on: nextCursor from this tool's last answer, exactly as given, with the same other arguments",
    "maxLength": 700,
    "minLength": 8,
    "type": "string"
   },
   "limit": {
    "default": 15,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Words to find on slides",
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_decks",
 "outputSchema": {
  "properties": {
   "asOf": {
    "description": "When 6ix answered (ISO 8601, UTC)",
    "type": "string"
   },
   "decksFound": {
    "description": "Decks that match the words (decks, not slides), counted when the search began",
    "type": "integer"
   },
   "decksShown": {
    "description": "Different decks among this answer's slides",
    "type": "integer"
   },
   "hasMore": {
    "description": "More follow: ask again with cursor set to nextCursor",
    "type": "boolean"
   },
   "listChanged": {
    "description": "The list changed since the cursor was made and the last item shown is no longer in it, so an item may repeat or be missed here",
    "type": "boolean"
   },
   "nextCursor": {
    "description": "Pass as cursor to read on from the last item shown; null at the end",
    "type": [
     "string",
     "null"
    ]
   },
   "slides": {
    "items": {
     "properties": {
      "company": {
       "anyOf": [
        {
         "properties": {
          "exchange": {
           "type": [
            "string",
            "null"
           ]
          },
          "name": {
           "type": "string"
          },
          "ticker": {
           "type": [
            "string",
            "null"
           ]
          },
          "url": {
           "type": "string"
          }
         },
         "required": [
          "name",
          "url"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "companyName": {
       "type": [
        "string",
        "null"
       ]
      },
      "deck": {
       "properties": {
        "date": {
         "description": "The deck's date, YYYY-MM-DD",
         "type": [
          "string",
          "null"
         ]
        },
        "deckType": {
         "type": [
          "string",
          "null"
         ]
        },
        "id": {
         "description": "Pass to get_deck",
         "type": "string"
        },
        "slides": {
         "type": [
          "integer",
          "null"
         ]
        },
        "title": {
         "type": "string"
        },
        "url": {
         "type": [
          "string",
          "null"
         ]
        },
        "whatChanged": {
         "description": "What changed from the company's previous version of this deck",
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "title",
        "url"
       ],
       "type": "object"
      },
      "excerpt": {
       "type": [
        "string",
        "null"
       ]
      },
      "page": {
       "type": "integer"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "deck",
      "page",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "slides",
   "decksFound",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "Search deck slides"
}
