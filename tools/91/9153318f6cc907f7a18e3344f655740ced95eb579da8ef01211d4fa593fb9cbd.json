{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "stories:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Replace the text on one story page. This also permanently clears that page's existing narration audio so it can be regenerated from the new text.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "confirmNarrationRemoval": {
    "const": true,
    "description": "True only after the user approved replacing the page text and clearing its existing narration audio.",
    "type": "boolean"
   },
   "pageContent": {
    "maxLength": 30000,
    "type": "string"
   },
   "pageNumber": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "storyId": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "storyId",
   "pageNumber",
   "pageContent",
   "confirmNarrationRemoval"
  ],
  "type": "object"
 },
 "name": "replace_story_page_text",
 "title": "Replace My Story Page Text"
}
