{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Retrieve entries from a knowledge base with optional filtering and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folder": {
    "description": "Filter entries by folder ('general', 'skills', 'contexts', 'documents', 'faqs')",
    "type": "string"
   },
   "id": {
    "description": "Unique identifier of the knowledge base",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of entries to return per page",
    "type": "number"
   },
   "page": {
    "description": "Page number for pagination (starts at 1)",
    "type": "number"
   },
   "source": {
    "description": "Filter entries by source type ('manual', 'document', 'url')",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "neuron_list_kb_entries",
 "title": "List Knowledge Base Entries"
}
