  "title": "Known as of a date"
 },
 "description": "Get what a company had reported as of a date: per measure, the latest period filed by then, its value, and whether it was later restated; optionally ratios from those filings. For point-in-time backtests.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "as_of": {
    "description": "Decision date: only filings on or before it count.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "company": {
    "description": "Ticker (AAPL), CIK or company name.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "concepts": {
    "description": "Default: ten common measures.",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "periods": {
    "description": "annual (default) or quarterly.",
    "enum": [
     "annual",
     "quarterly"
    ],
    "type": "string"
   },
   "ratios": {
    "description": "Adds margins, ROE, ROA, leverage, free cash flow.",
    "type": "boolean"
   }
  },
  "required": [
   "company",
   "as_of"
  ],
  "type": "object"
 },
 "name": "known_as_of",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "description": "rows: one per measure in the order of columns, the value as it stood on as_of; changed_after flags values later restated.",
  "properties": {
   "as_of": {
    "type": "string"
   },
   "columns": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "company": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "limits": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "meaning": {
    "type": "string"
   },
   "missing": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "next_offset": {
    "type": "number"
   },
   "ratios": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "rows": {
    "items": {},
    "type": "array"
   },
   "snapshot": {
    "additionalProperties": {},
    "properties": {},
