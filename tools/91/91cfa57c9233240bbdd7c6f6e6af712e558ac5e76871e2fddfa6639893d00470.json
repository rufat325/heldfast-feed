  "additionalProperties": false,
  "properties": {
   "mab_id": {
    "description": "The reserve's mab_id, from unesco_search_biosphere_reserves. Case and accents are ignored.",
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "mab_id"
  ],
  "type": "object"
 },
 "name": "unesco_get_biosphere_reserve",
