       "buffer": {
        "description": "Buffer-zone marine area, as recorded.",
        "type": "number"
       },
       "core": {
        "description": "Core-zone marine area, as recorded.",
        "type": "number"
       },
       "total": {
        "description": "Total marine area, as recorded.",
        "type": "number"
       },
       "transition": {
        "description": "Transition-zone marine area, as recorded.",
        "type": "number"
       }
      },
      "required": [
       "total",
       "core",
       "buffer",
       "transition"
      ],
      "type": "object"
     },
     "terrestrial": {
      "additionalProperties": false,
      "description": "The terrestrial area by zone in hectares, as recorded; zone sums don't always match the total upstream.",
      "properties": {
       "buffer": {
        "description": "Buffer-zone terrestrial area, as recorded.",
        "type": "number"
       },
       "core": {
        "description": "Core-zone terrestrial area, as recorded.",
        "type": "number"
       },
       "total": {
        "description": "Total terrestrial area, as recorded.",
        "type": "number"
       },
       "transition": {
        "description": "Transition-zone terrestrial area, as recorded.",
        "type": "number"
       }
      },
      "required": [
       "total",
       "core",
       "buffer",
       "transition"
      ],
      "type": "object"
     },
     "total": {
      "description": "Total area, as recorded.",
      "type": "number"
     }
    },
    "required": [
     "total",
     "terrestrial",
     "marine"
    ],
    "type": "object"
   },
   "country": {
    "description": "Country name as UNESCO records it.",
    "type": "string"
   },
   "country_code": {
    "description": "ISO 3166-1 alpha-2 code of the reserve country.",
    "type": "string"
   },
   "designation_year": {
    "description": "Year of designation.",
    "type": "number"
   },
   "ecological_characteristics": {
    "description": "Ecological characteristics, when recorded.",
    "type": "string"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `biosphere_reserve_not_found`: No record carries this mab_id, after folding case and diacritics. `snapshot_unavailable`: No MAB snapshot has loaded yet and the Data Hub is unreachable. Other values are possible when a failure originates below the handler.",
        "examples": [
         "biosphere_reserve_not_found",
         "snapshot_unavailable"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
