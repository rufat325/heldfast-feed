     "core",
     "buffer",
     "transition"
    ],
    "type": "object"
   },
   "regional_network": {
    "description": "MAB regional network, when the reserve belongs to one.",
    "enum": [
     "African Biosphere Reserve Network (AfriMAB)",
     "Arab States Biosphere Reserve Network (ArabMAB)",
     "East Asian Biosphere Reserve Network (EABRN)",
     "Europe and North America Biosphere Reserve Network (EuroMAB)",
     "Ibero-American MAB Network (IberoMAB)",
     "South and Central Asia MAB Network (SACAM)",
     "Southeast Asian Biosphere Reserve Network (SeaBRnet)"
    ],
    "type": "string"
   },
   "regions": {
    "description": "UNESCO regions the reserve belongs to.",
    "items": {
     "description": "UNESCO region.",
     "enum": [
      "Africa",
      "Arab States",
      "Asia and the Pacific",
      "Europe and North America",
      "Latin America and the Caribbean"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "renaming_years": {
    "description": "Years the reserve was renamed; empty when none.",
    "items": {
     "description": "Year.",
     "type": "number"
    },
    "type": "array"
   },
   "sids": {
    "description": "True when the reserve is in a Small Island Developing State.",
    "type": "boolean"
   },
   "socio_economic_characteristics": {
    "description": "Socio-economic characteristics, when recorded.",
    "type": "string"
   },
   "sources": {
    "description": "Datasets this response was built from.",
    "items": {
     "additionalProperties": false,
     "description": "One source dataset.",
     "properties": {
      "attribution": {
       "description": "Credit line to reproduce with the data.",
       "type": "string"
      },
      "data_as_of": {
       "description": "Dataset's data_processed timestamp (ISO 8601) from the loaded snapshot.",
       "type": "string"
      },
      "dataset": {
       "description": "UNESCO Data Hub dataset id.",
       "enum": [
        "whc001",
        "ich001",
        "mab001"
       ],
       "type": "string"
      },
      "license": {
       "description": "Dataset license from the dataset metadata ('CC BY-SA 4.0').",
       "type": "string"
      },
      "title": {
       "description": "Dataset title.",
       "type": "string"
      }
     },
     "required": [
      "dataset",
      "title",
      "data_as_of",
      "license",
      "attribution"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "transboundary": {
    "description": "True for a transboundary reserve; each participating country has its own mab_id.",
    "type": "boolean"
   },
   "url": {
    "description": "The reserve's UNESCO page URL.",
    "type": "string"
   },
   "website": {
    "description": "The reserve's own website, when recorded.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Get biosphere reserve"
}
