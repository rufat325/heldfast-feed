  "readOnlyHint": true
 },
 "description": "Search AI repositories by name, description, README, topics, owner, or linked TAAFT company. Results rank relevant, popular, official repositories first unless a sort is selected.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "company": {
    "description": "Exact linked TAAFT company slug.",
    "type": "string"
   },
   "language": {
    "description": "Primary programming language.",
    "type": "string"
   },
   "license": {
    "description": "Repository license.",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_stars": {
    "description": "Minimum GitHub star count.",
    "minimum": 0,
    "type": "integer"
   },
   "owner": {
    "description": "Exact source owner, such as anthropics.",
    "type": "string"
   },
   "query": {
    "description": "Optional repository name, capability, topic, owner, or README keywords.",
    "type": "string"
   },
   "sort": {
    "default": "relevance",
    "enum": [
     "relevance",
     "stars",
     "latest",
     "recently_updated"
    ],
    "type": "string"
   },
   "updated_after": {
    "description": "Only repositories updated on or after this YYYY-MM-DD date.",
    "format": "date",
    "type": "string"
   }
  },
  "type": "object"
 },
