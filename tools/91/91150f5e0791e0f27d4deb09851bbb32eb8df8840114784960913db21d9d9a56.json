{
 "description": "Calculate fuel required and journey cost from distance, fuel economy, and fuel price \u2014 including cost per kilometre and per mile.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://roaduser.tools/icons/favicon.svg"
  }
 ],
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "currency": {
    "description": "Optional display-only currency label echoed back in the result, e.g. \"GBP\" or \"\u00a3\". No conversion is performed.",
    "type": "string"
   },
   "distance": {
    "additionalProperties": false,
    "description": "Journey distance. Must be finite and non-negative.",
    "properties": {
     "unit": {
      "enum": [
       "km",
       "mi"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   },
   "economy": {
    "additionalProperties": false,
    "description": "Vehicle fuel economy. Must be finite and greater than zero.",
    "properties": {
     "unit": {
      "enum": [
       "mpg_uk",
       "mpg_us",
       "l_per_100km",
       "km_per_l"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   },
   "price": {
    "additionalProperties": false,
    "description": "Fuel price per volume unit. Must be finite and non-negative.",
    "properties": {
     "per": {
      "enum": [
       "l",
       "gal_uk",
       "gal_us"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "per"
    ],
    "type": "object"
   }
  },
  "required": [
   "distance",
   "economy",
   "price"
  ],
  "type": "object"
 },
 "name": "calculate_fuel_cost",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "costPerKm": {
    "type": "number"
   },
   "costPerMile": {
    "type": "number"
   },
   "currency": {
    "description": "Echo of the display-only currency label.",
    "type": "string"
   },
   "fuel": {
    "additionalProperties": false,
    "description": "Fuel required for the journey.",
    "properties": {
     "gallonsUk": {
      "type": "number"
     },
     "gallonsUs": {
      "type": "number"
     },
     "litres": {
      "type": "number"
     }
    },
    "required": [
     "litres",
     "gallonsUk",
     "gallonsUs"
    ],
    "type": "object"
   },
   "totalCost": {
    "description": "Total journey fuel cost in the supplied price.",
    "type": "number"
   }
  },
  "required": [
   "fuel",
   "totalCost",
   "costPerKm",
   "costPerMile"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "tools:read",
    "tools:calculate"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Calculate fuel cost"
}
