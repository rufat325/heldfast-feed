{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Save an article as a draft on Misar.Blog (for review before publishing)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body_markdown": {
    "description": "Full article body in Markdown",
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "description": "Tags for the draft",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Draft title",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "body_markdown"
  ],
  "type": "object"
 },
 "name": "create_draft",
 "title": "Create draft"
}
