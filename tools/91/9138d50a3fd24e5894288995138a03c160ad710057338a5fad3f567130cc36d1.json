{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update infrastructure network"
 },
 "description": "Update an existing infrastructure network by ID. Requires infrastructure_networks:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "color_scheme": {
    "description": "Display color scheme",
    "maxLength": 50,
    "type": "string"
   },
   "criticality": {
    "anyOf": [
     {
      "description": "How strictly the network is held to its feature class's Level of Service targets: critical, high, medium or low. Unset is treated as medium; send null on update to clear it",
      "enum": [
       "critical",
       "high",
       "medium",
       "low"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "How strictly the network is held to its feature class's Level of Service targets: critical, high, medium or low. Unset is treated as medium; send null on update to clear it"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "feature_class": {
    "description": "Asset class code",
    "pattern": "^[a-z][a-z0-9_]{0,49}$",
    "type": "string"
   },
   "id": {
    "description": "Infrastructure network ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Free-form JSON metadata",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "Network name",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_infrastructure_network",
 "title": "Update infrastructure network"
}
