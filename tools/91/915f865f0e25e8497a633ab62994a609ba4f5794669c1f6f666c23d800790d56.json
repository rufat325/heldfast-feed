{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Pollar news near a place"
 },
 "description": "Lists recent Pollar events located in or around a named city or town, nearest first, with the distance in km. Accepts the place name in English, Polish, German or French, with an optional country for ambiguous names. A whole country, a region or a topic is a job for search_news.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "description": "Country name or ISO code, only to disambiguate",
    "maxLength": 60,
    "type": "string"
   },
   "limit": {
    "default": 15,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "pl",
     "de",
     "fr"
    ],
    "type": "string"
   },
   "place": {
    "description": "City or town name, e.g. 'Krak\u00f3w', 'Krakau' or 'Lyon'",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "radiusKm": {
    "default": 50,
    "maximum": 3000,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "place"
  ],
  "type": "object"
 },
 "name": "news_near",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "place": {
    "additionalProperties": false,
    "properties": {
     "country": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "country"
    ],
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "categoryPath": {
       "items": [
        {
         "type": "string"
        },
        {
         "type": "string"
        },
        {
         "type": "string"
        }
       ],
       "type": "array"
      },
      "distanceKm": {
       "type": "number"
      },
      "id": {
       "type": "string"
      },
      "imageSource": {
       "type": "string"
      },
      "imageUrl": {
       "type": "string"
      },
      "lead": {
       "type": "string"
      },
      "locationsSummary": {
       "type": "string"
      },
      "modifiedAt": {
       "type": "string"
      },
      "publishedAt": {
       "type": "string"
      },
      "shortHeadline": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "sourceCount": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "id",
      "slug",
      "title",
      "shortHeadline",
      "lead",
      "imageUrl",
      "imageSource",
      "publishedAt",
      "modifiedAt",
      "categoryPath",
      "sourceCount",
      "url",
      "distanceKm"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "place",
   "results"
  ],
  "type": "object"
 },
 "title": "Pollar news near a place"
}
