{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Prepare an owner-browser checkout link"
 },
 "description": "Return an owner-browser checkout link for one service in a published storefront. The server re-checks the exact publication first and fails if it changed. Never pays or signs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "projectionId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "type": "string"
   },
   "publicationDigest": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "slug",
   "publicationDigest",
   "projectionId"
  ],
  "type": "object"
 },
 "name": "voidpay_checkout_link",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "provider": {
    "const": "Voidpay \u00b7 voidly.ai",
    "type": "string"
   }
  },
  "required": [
   "provider"
  ],
  "type": "object"
 },
 "title": "Prepare an owner-browser checkout link"
}
