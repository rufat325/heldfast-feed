 "description": "Use to read one existing request with its original submissionId/resumeToken pair within the original 24-hour window. Returns offer state or recorded booking/payment/fulfillment after payment; no pricing call or new business action. For pending, wait retryAfterSeconds and retry that pair. For ambiguous/conflict inspect that intent; not_found denies access and unavailable is not vehicle evidence. Open customerPortalUrl for private login. No locale (original language), history, cancellation or modification.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "resumeToken": {
    "description": "Private 64-character hexadecimal secret generated for this submission. Reuse its original pair with submissionId for retries and status; never substitute account credentials.",
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "submissionId": {
    "description": "Identifies one offer intent. Generate a UUID for a requested new offer; keep it with the same resumeToken for unchanged retries and status.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "submissionId",
   "resumeToken"
  ],
  "type": "object"
 },
 "name": "get_offer_status",
