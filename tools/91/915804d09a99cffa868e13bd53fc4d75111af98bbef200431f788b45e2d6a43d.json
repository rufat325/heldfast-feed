{
 "description": "Update an existing document on RenderMark. Can update markdown content, title, publishing settings, or protection.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "identifier": {
    "description": "Document slug, ID, or full RenderMark URL",
    "type": "string"
   },
   "markdown": {
    "description": "New markdown content (replaces entire document)",
    "type": "string"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "protection": {
      "enum": [
       "none",
       "password",
       "email"
      ],
      "type": "string"
     },
     "showByLine": {
      "type": "boolean"
     },
     "showDatePublished": {
      "type": "boolean"
     },
     "showDateUpdated": {
      "type": "boolean"
     },
     "showToc": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "publish": {
    "description": "Set publish state",
    "type": "boolean"
   },
   "title": {
    "description": "New document title",
    "type": "string"
   }
  },
  "required": [
   "identifier"
  ],
  "type": "object"
 },
 "name": "update_document"
}
