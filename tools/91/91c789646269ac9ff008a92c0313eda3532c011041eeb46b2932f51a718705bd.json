{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get the latest feed items (technology, compliance, and security news for AI agents), optionally filtered by tags and source. Other products: call list_products.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum number of items to return.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "product": {
    "default": "ainews",
    "description": "Optional product stream to read (default ainews).",
    "enum": [
     "ainews",
     "events"
    ],
    "type": "string"
   },
   "source": {
    "description": "Optional source filter.",
    "enum": [
     "reddit",
     "x",
     "rss",
     "cve",
     "hn",
     "submitted"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Optional tag filters.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "get_latest",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Matching feed items.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "description": "Item id.",
       "type": "string"
      },
      "score": {
       "description": "Community ranking score.",
       "type": "number"
      },
      "summary": {
       "description": "Short summary, or null when the item has not been enriched yet.",
       "type": [
        "string",
        "null"
       ]
      },
      "tags": {
       "description": "Classifier tags.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "description": "Item title.",
       "type": "string"
      },
      "url": {
       "description": "Canonical item URL.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "summary",
      "tags",
      "score",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "additionalProperties": false,
    "description": "Provenance of the payload.",
    "properties": {
     "name": {
      "description": "Feed name.",
      "type": "string"
     },
     "url": {
      "description": "Feed homepage URL.",
      "type": "string"
     }
    },
    "required": [
     "name",
     "url"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "source"
  ],
  "type": "object"
 }
}
