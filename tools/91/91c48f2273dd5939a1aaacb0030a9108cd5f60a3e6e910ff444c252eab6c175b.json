{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get reporting metrics"
 },
 "description": "Aggregate support metrics over a period: new, created, assigned, closed and reopened tickets, average first response time and average total resolution time (seconds). Filter by team, channel, label or direction. Trengo: GET /reporting/metrics.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "channel_ids": {
    "description": "Only these channel ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "direction": {
    "description": "Only INBOUND or OUTBOUND conversations.",
    "enum": [
     "INBOUND",
     "OUTBOUND"
    ],
    "type": "string"
   },
   "end_date": {
    "description": "Period end as ISO 8601, e.g. 2026-09-01T00:00:00+00:00. Give it together with its pair.",
    "type": "string"
   },
   "label_ids": {
    "description": "Only these label ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "metrics": {
    "description": "Which metrics to return.",
    "items": {
     "enum": [
      "new_tickets",
      "assigned_tickets",
      "average_total_resolution_time",
      "average_first_response_time",
      "created_tickets",
      "closed_tickets",
      "reopened_tickets"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "start_date": {
    "description": "Period start as ISO 8601, e.g. 2026-09-01T00:00:00+00:00. Give it together with its pair.",
    "type": "string"
   },
   "team_ids": {
    "description": "Only these team ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   }
  },
  "required": [
   "metrics"
  ],
  "type": "object"
 },
 "name": "trengo_get_reporting_metrics",
 "title": "Get reporting metrics"
}
