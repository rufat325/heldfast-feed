{
 "description": "Repeat-buyer clusters on Robinhood Chain: wallets that bought inside 3 or more of the buyer bursts the scout has captured, with burst count and last-seen time. Use it to spot sniper crews before they dump on you. Data rewritten every 20 s (<= 30 s behind the chain); data older than 120 s is refused with a 503 and not charged. Costs $0.02 USDC per call (x402).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max rows, 1-25 (default 25)",
    "maximum": 25,
    "minimum": 1,
    "type": "number"
   },
   "minBursts": {
    "description": "Minimum bursts a wallet bought into, 3-50 (default 3)",
    "maximum": 50,
    "minimum": 3,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "rh_crews",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ageSec": {
    "type": "number"
   },
   "chain": {
    "type": "string"
   },
   "crews": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "ethUsd": {
    "type": [
     "number",
     "null"
    ]
   },
   "generatedAt": {
    "type": "number"
   },
   "rules": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "schemaVersion": {
    "type": "number"
   },
   "walletsTracked": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "required": [
   "chain",
   "schemaVersion",
   "generatedAt",
   "ageSec",
   "ethUsd",
   "walletsTracked",
   "crews"
  ],
  "type": "object"
 }
}
