  "additionalProperties": false,
  "properties": {
   "audience": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "family": {
    "enum": [
     "nonfiction",
     "fiction"
    ],
    "type": "string"
   },
   "hard_fails": {
    "additionalProperties": {
     "type": "string"
