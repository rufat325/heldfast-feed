{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get models filtered by type with optional query parameters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "application": {
    "description": "Filter by application",
    "type": "string"
   },
   "centuries": {
    "description": "Filter by centuries",
    "type": "string"
   },
   "collId": {
    "description": "Filter by collection ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "creator": {
    "description": "Filter by creator",
    "type": "string"
   },
   "docType": {
    "description": "Filter by document type",
    "type": "string"
   },
   "facetLimit": {
    "default": 10,
    "description": "Facet limit",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "featured": {
    "description": "Filter featured models",
    "type": "boolean"
   },
   "filter": {
    "description": "Filter string",
    "type": "string"
   },
   "index": {
    "description": "Start index (0-based)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "isoLanguages": {
    "description": "Filter by ISO languages",
    "type": "string"
   },
   "labels": {
    "description": "Filter by labels",
    "type": "string"
   },
   "minFacetCount": {
    "default": 2,
    "description": "Minimum facet count",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "nValues": {
    "description": "Number of results (-1 for all)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "prov": {
    "description": "Filter by provider",
    "type": "string"
   },
   "publisher": {
    "description": "Filter by publisher",
    "type": "string"
   },
   "releaseLevel": {
    "description": "Filter by release level",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "scriptTypes": {
    "description": "Filter by script types",
    "type": "string"
   },
   "slug": {
    "description": "Filter by slug",
    "type": "string"
   },
   "sortColumn": {
    "description": "Column to sort by",
    "type": "string"
   },
   "sortDirection": {
    "description": "Sort direction: asc or desc",
    "type": "string"
   },
   "type": {
    "description": "Model type (e.g. htr, la, ocr)",
    "pattern": "^[^/\\s]+$",
    "type": "string"
   },
   "userid": {
    "description": "Filter by user ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
 "name": "transkribus_model_get_by_type",
 "title": "Get Models by Type"
}
