{
 "description": "Create a new Lovelace dashboard",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "icon": {
    "description": "Material Design icon (e.g. 'mdi:tablet')",
    "type": "string"
   },
   "require_admin": {
    "default": false,
    "description": "Whether to require admin access",
    "type": "boolean"
   },
   "show_in_sidebar": {
    "default": true,
    "description": "Whether to show in the sidebar",
    "type": "boolean"
   },
   "title": {
    "description": "Display title for the dashboard",
    "type": "string"
   },
   "url_path": {
    "description": "URL path for the dashboard (e.g. 'tablet', 'kitchen'). Will be accessible at /lovelace-{url_path}/",
    "type": "string"
   }
  },
  "required": [
   "url_path",
   "title"
  ],
  "type": "object"
 },
 "name": "ha_create_dashboard"
}
