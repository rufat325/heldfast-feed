{
 "description": "Browse published experiences with optional filtering and sorting. Returns a paginated list with slug, name, tagline, intensity, duration, step count, and current traveler count.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "duration": {
    "description": "Filter by duration category",
    "enum": [
     "short",
     "medium",
     "long"
    ],
    "type": "string"
   },
   "intensity": {
    "description": "Filter by intensity level",
    "enum": [
     "LOW",
     "MEDIUM",
     "HIGH"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Results per page (default: 20, max: 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number (default: 1)",
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "Sort order (default: name)",
    "enum": [
     "name",
     "newest",
     "oldest",
     "steps",
     "duration"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "browse_experiences"
}
