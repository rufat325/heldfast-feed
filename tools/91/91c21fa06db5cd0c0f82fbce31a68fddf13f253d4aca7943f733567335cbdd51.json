{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run Kimi CLI as a detached background task. Subactions: start (returns taskId), status, tail (log output), stop, remove, list. Use for long-running autonomous work \u2014 the MCP call returns immediately and you poll status later.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Background task action.",
    "enum": [
     "start",
     "status",
     "tail",
     "stop",
     "remove",
     "list"
    ],
    "type": "string"
   },
   "addDirs": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "agent": {
    "enum": [
     "default",
     "okabe"
    ],
    "type": "string"
   },
   "agentFile": {
    "type": "string"
   },
   "cd": {
    "type": "string"
   },
   "label": {
    "description": "Human-readable label to identify this task later.",
    "type": "string"
   },
   "lines": {
    "default": 80,
    "description": "Lines to return from log tail.",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "maxRalphIterations": {
    "description": "Extra autonomous iterations after the first turn. -1 = unlimited.",
    "minimum": -1,
    "type": "integer"
   },
   "maxStepsPerTurn": {
    "minimum": 1,
    "type": "integer"
   },
   "mcpConfigFile": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ]
   },
   "model": {
    "description": "Optional model override. Known: kimi-for-coding, kimi-k2-6, kimi-k2-6-turbo, kimi-k2-thinking-turbo, kimi-k2-5, kimi-latest.",
    "type": "string"
   },
   "plan": {
    "description": "Start in plan mode.",
    "type": "boolean"
   },
   "prompt": {
    "description": "Prompt (required for action=start).",
    "type": "string"
   },
   "signal": {
    "default": "SIGTERM",
    "description": "Signal for stop action.",
    "enum": [
     "SIGTERM",
     "SIGKILL",
     "SIGINT"
    ],
    "type": "string"
   },
   "skillsDirs": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "taskId": {
    "description": "Task ID returned by action=start.",
    "type": "string"
   },
   "thinking": {
    "type": "boolean"
   },
   "workingDir": {
    "type": "string"
   },
   "yolo": {
    "description": "--yolo: auto-approve everything (default for bg tasks: afk; pass yolo for full power).",
    "type": "boolean"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "bg-kimi"
}
