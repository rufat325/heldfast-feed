{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Audit Logs"
 },
 "description": "List recent audit log entries for this company. Filter by action, resource, resourceId, user, source, outcome, destructive flag, and created date range.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Exact tool/action name, e.g. delete_campaign",
    "type": "string"
   },
   "createdAfter": {
    "description": "ISO timestamp lower bound",
    "type": "string"
   },
   "createdBefore": {
    "description": "ISO timestamp upper bound",
    "type": "string"
   },
   "destructive": {
    "description": "Whether the audited tool was destructive",
    "type": "boolean"
   },
   "limit": {
    "default": 50,
    "description": "Maximum rows to return",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "outcome": {
    "description": "Execution outcome",
    "enum": [
     "success",
     "failed",
     "blocked"
    ],
    "type": "string"
   },
   "resource": {
    "description": "Resource name, e.g. campaigns",
    "type": "string"
   },
   "resourceId": {
    "description": "Resource ID",
    "type": "string"
   },
   "source": {
    "description": "Audit source, e.g. mcp, ai_agent, payment_webhook, merchant_api",
    "enum": [
     "mcp",
     "ai_agent",
     "merchant_api",
     "payment_webhook",
     "manual_refresh",
     "qfpay_reconciliation",
     "hold_expiry_sweeper"
    ],
    "type": "string"
   },
   "userId": {
    "description": "Actor user ID",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_audit_logs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
