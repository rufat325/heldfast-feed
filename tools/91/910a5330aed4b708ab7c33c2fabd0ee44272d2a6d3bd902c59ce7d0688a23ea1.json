{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new saved view for a folder with a custom set of display columns.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "columns": {
    "description": "Ordered list of columns shown in the view",
    "items": {
     "additionalProperties": false,
     "properties": {
      "definition": {
       "description": "Optional column definition",
       "type": "string"
      },
      "fieldId": {
       "description": "Field ID this column maps to (omit for built-in columns)",
       "type": "string"
      },
      "name": {
       "description": "Column display name",
       "type": "string"
      },
      "order": {
       "description": "Column display order",
       "type": "number"
      },
      "type": {
       "description": "Column type \u2014 a FieldType or a default view column",
       "type": "string"
      }
     },
     "required": [
      "name",
      "type",
      "order"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "folderId": {
    "description": "Unique identifier of the folder",
    "minLength": 1,
    "type": "string"
   },
   "isDefault": {
    "description": "Whether this view is the folder's default view",
    "type": "boolean"
   },
   "name": {
    "description": "Display name for the view",
    "type": "string"
   }
  },
  "required": [
   "folderId",
   "name",
   "columns"
  ],
  "type": "object"
 },
 "name": "create_folder_view",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
