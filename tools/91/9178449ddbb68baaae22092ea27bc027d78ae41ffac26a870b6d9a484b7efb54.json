{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks whether a domain's email is set up correctly, such as \"is DMARC set up for github.com?\" or \"check SPF and DKIM for example.com\". Pass the domain and, if known, up to 5 DKIM selector names. Returns SPF (policy, DNS lookup count, issues), DMARC (policy, percentage, report address, issues), DKIM per selector, the MX hosts and mail provider, a grade from A to F, a list of fixes, and the source and as_of date. It reads public DNS only: it does not send mail, test delivery or read mailboxes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dkim_selectors": {
    "description": "DKIM selector names to look for, such as [\"google\"] or [\"selector1\", \"selector2\"]. Optional; DKIM cannot be found without one. At most 5.",
    "items": {
     "maxLength": 63,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9._-]+$",
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "domain": {
    "description": "The domain, such as \"example.com\". A web address or an email address is reduced to its domain.",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "check_email_auth",
 "outputSchema": {
  "properties": {
   "as_of": {
    "type": "string"
   },
   "dkim": {
    "properties": {
     "checked": {
      "items": {
       "properties": {
        "found": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "note": {
         "type": "string"
        },
        "selector": {
         "type": "string"
        }
       },
       "required": [
        "selector",
        "found"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "note": {
      "type": "string"
     },
     "status": {
      "enum": [
       "unknown",
       "found",
       "not_found",
       "unavailable"
      ],
      "type": "string"
     }
    },
    "required": [
     "status",
     "checked"
    ],
    "type": "object"
   },
   "dmarc": {
    "properties": {
     "found": {
      "type": [
       "boolean",
       "null"
      ]
     },
