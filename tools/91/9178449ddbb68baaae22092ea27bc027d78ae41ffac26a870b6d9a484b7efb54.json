       null
      ],
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "found",
     "issues"
    ],
    "type": [
     "object",
     "null"
    ]
   },
   "domain": {
    "type": "string"
   },
   "fixes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "grade": {
    "enum": [
     "A",
     "B",
     "C",
     "D",
     "F",
     null
    ],
    "type": [
     "string",
