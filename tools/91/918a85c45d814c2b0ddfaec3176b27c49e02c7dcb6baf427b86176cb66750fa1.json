{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Discover, fetch and validate an XML sitemap. Finds it via the robots.txt `Sitemap:` directive, then falls back to /sitemap.xml, /sitemap_index.xml and /sitemap-index.xml. Handles sitemap indexes (following children) and gzipped sitemaps.\n\nValidates: URL count against the 50,000 limit, uncompressed size against 50 MiB, <lastmod> presence and W3C-datetime validity, URLs pointing off-origin, http:// URLs, and duplicates.\n\nArgs:\n  - site (string): domain or any URL on it.\n  - sitemap_url (string, optional): explicit sitemap URL.\n  - follow_children (number): child sitemaps of an index to follow (default 3).\n  - response_format ('markdown' | 'json'): output format (default 'markdown').\n\nReturns: { found, type, url_count, child_sitemaps[], with_lastmod, invalid_lastmod[], newest_lastmod, off_origin_urls[], exceeds_url_limit, discovered_via, score, grade, findings[] }.\n\nExample: \"Check the sitemap for example.com\" -> sitemap_check(site=\"example.com\").",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "follow_children": {
    "default": 3,
    "description": "How many child sitemaps of an index to follow (default 3).",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "response_format": {
    "default": "markdown",
    "description": "Output format: 'markdown' for a human-readable summary (default) or 'json' for the full structured payload.",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "site": {
    "description": "Domain or any URL on it, e.g. 'example.com'.",
    "minLength": 1,
    "type": "string"
   },
   "sitemap_url": {
    "description": "Explicit sitemap URL. Omit to discover it via robots.txt, then the conventional paths.",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "sitemap_check",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bytes": {
    "type": "number"
   },
   "child_sitemaps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "child_sitemaps_followed": {
    "type": "number"
   },
   "discovered_via": {
    "type": "string"
   },
   "duplicate_urls": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "changefreq": {
       "type": [
        "string",
        "null"
       ]
      },
      "lastmod": {
       "type": [
        "string",
        "null"
       ]
      },
      "loc": {
       "type": "string"
      },
      "priority": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "loc",
      "lastmod",
      "changefreq",
      "priority"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "exceeds_size_limit": {
    "type": "boolean"
   },
   "exceeds_url_limit": {
    "type": "boolean"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "type": "string"
      },
      "severity": {
       "type": "string"
      }
     },
     "required": [
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "found": {
    "type": "boolean"
   },
   "grade": {
    "type": "string"
   },
   "invalid_lastmod": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "newest_lastmod": {
    "type": [
     "string",
     "null"
    ]
   },
   "non_https_urls": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "off_origin_urls": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "oldest_lastmod": {
    "type": [
     "string",
     "null"
    ]
   },
   "score": {
    "type": "number"
   },
   "status": {
    "type": [
     "number",
     "null"
    ]
   },
   "type": {
    "type": "string"
   },
   "url": {
    "type": "string"
   },
   "url_count": {
    "type": "number"
   },
   "with_lastmod": {
    "type": "number"
   }
  },
  "required": [
   "url",
   "found",
   "status",
   "type",
   "url_count",
   "child_sitemaps",
   "child_sitemaps_followed",
   "entries",
   "with_lastmod",
   "invalid_lastmod",
   "newest_lastmod",
   "oldest_lastmod",
   "off_origin_urls",
   "non_https_urls",
   "duplicate_urls",
   "exceeds_url_limit",
   "exceeds_size_limit",
   "bytes",
   "discovered_via",
   "score",
   "grade",
   "findings"
  ],
  "type": "object"
 },
 "title": "XML Sitemap Check"
}
