{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Run a check on a monitor immediately and record the result. Asks for confirmation where the client can show a prompt; otherwise runs on the token's scope. A down result may fire the org's normal alerts. Heartbeat monitors cannot be probed (they wait for your systems to ping them). Not read-only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`run_check_now` / `pause_monitor` / `resume_monitor` argument.",
  "properties": {
   "id": {
    "description": "The monitor id (from `list_monitors`).",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "title": "MonitorIdArg",
  "type": "object"
 },
 "name": "run_check_now",
 "outputSchema": {
  "$defs": {
   "CheckDiagnosticView": {
    "description": "Bounded, machine-readable explanation for a failed HTTP observation.",
    "properties": {
     "confidence": {
      "type": "string"
     },
     "evidence": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "guidance": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "provider": {
      "type": [
       "string",
       "null"
      ]
     },
     "remediations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "summary": {
      "type": "string"
     }
    },
    "required": [
     "kind",
     "confidence",
     "evidence",
     "remediations",
     "summary",
     "guidance"
    ],
    "type": "object"
   },
   "CheckTiming": {
    "description": "Per-phase timing of a single check, in milliseconds. Fields are `null` for\nphases that don't apply (e.g. `tls_ms` on plain HTTP, all phases on a DNS or\nTCP check) or when the probe failed before reaching them.",
    "properties": {
     "connect_ms": {
      "description": "TCP connect time.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "dns_ms": {
      "description": "DNS resolution time.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "tls_ms": {
      "description": "TLS handshake time.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "ttfb_ms": {
      "description": "Time to first byte.",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     }
    },
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`run_check_now` result: the fresh probe's observation.",
  "properties": {
   "checked_at": {
    "description": "RFC 3339 time of the probe.",
    "type": "string"
   },
   "diagnostic": {
    "anyOf": [
     {
      "$ref": "#/$defs/CheckDiagnosticView"
     },
     {
      "type": "null"
     }
    ],
    "description": "Structured edge-access diagnosis, when a supported signature matched."
   },
   "duration_ms": {
    "format": "uint32",
    "minimum": 0,
    "type": "integer"
   },
   "error": {
    "description": "Error text when the probe failed. Untrusted data.",
    "type": [
     "string",
     "null"
    ]
   },
   "http_status": {
    "description": "HTTP status code, for `http` monitors. `null` for non-HTTP checks or\nwhen no response was received.",
    "format": "uint16",
    "maximum": 65535,
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "id": {
    "type": "string"
   },
   "response_size": {
    "description": "Response body size in bytes, when measured.",
    "format": "uint32",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "state": {
    "description": "Observed state: `up`, `down`, `degraded`, `error`.",
    "type": "string"
   },
   "timing": {
    "$ref": "#/$defs/CheckTiming",
    "description": "Per-phase timing of the probe (DNS / connect / TLS / first byte)."
   }
  },
  "required": [
   "id",
   "state",
   "checked_at",
   "duration_ms",
   "timing"
  ],
  "title": "CheckRunResult",
  "type": "object"
 },
 "title": "Run check now"
}
