{
 "description": "Gestiona configuraci\u00f3n de notificaciones (admin only). Acciones: list (con category opcional), get (id), update (id). Convierte autom\u00e1ticamente arrays \u2194 CSV para notify_to_terms, notify_to_team, notify_to_team_members.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "update"
    ],
    "type": "string"
   },
   "category": {
    "description": "Filtro por categor\u00eda (project, ticket, etc.)",
    "type": "string"
   },
   "enable_email": {
    "type": "boolean"
   },
   "enable_slack": {
    "type": "boolean"
   },
   "enable_web": {
    "type": "boolean"
   },
   "id": {
    "description": "ID del setting de notificaci\u00f3n",
    "type": "number"
   },
   "notify_to_team": {
    "description": "IDs de equipos",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "notify_to_team_members": {
    "description": "IDs de miembros",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "notify_to_terms": {
    "description": "T\u00e9rminos a notificar",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "notification_settings"
}
