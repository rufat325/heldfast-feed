{
 "description": "The user's accounting books (Social AI Accounting): one tool for all bookkeeping verbs. Call action=\"list_books\" first to find the bookId, then: create_invoice (customer invoice with line items \u2014 VAT applied from book settings, posted to the general ledger when standard accounts exist), create_expense (supplier bill), add_contact (customer/supplier), list (recent invoices | bills | contacts, filterable by status), summary (revenue, expenses, profit, outstanding receivables/payables over N months). Records are always scoped to a book the caller owns or is a member of; created invoices are drafts the user can review before sending.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "What to do",
    "enum": [
     "list_books",
     "create_invoice",
     "create_expense",
     "add_contact",
     "list",
     "summary"
    ],
    "type": "string"
   },
   "billDate": {
    "description": "create_expense: YYYY-MM-DD, default today",
    "type": "string"
   },
   "bookId": {
    "description": "Accounting book ID \u2014 required for everything except list_books",
    "type": "string"
   },
   "contactType": {
    "description": "add_contact: default customer",
    "enum": [
     "customer",
     "supplier",
     "both"
    ],
    "type": "string"
   },
   "customerName": {
    "description": "create_invoice: customer name",
    "type": "string"
   },
   "dueDate": {
    "description": "create_invoice: YYYY-MM-DD",
    "type": "string"
   },
   "email": {
    "description": "add_contact: contact email",
    "type": "string"
   },
   "issueDate": {
    "description": "create_invoice: YYYY-MM-DD, default today",
    "type": "string"
   },
   "kind": {
    "description": "list: which records, default invoices",
    "enum": [
     "invoices",
     "bills",
     "contacts"
    ],
    "type": "string"
   },
   "limit": {
    "description": "list: max records, default 10",
    "type": "number"
   },
   "lines": {
    "description": "create_invoice/create_expense: line items",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "description": "create_expense: line amount (excl. VAT)",
       "type": "number"
      },
      "description": {
       "type": "string"
      },
      "quantity": {
       "description": "create_invoice only, default 1",
       "type": "number"
      },
      "unitPrice": {
       "description": "create_invoice: price per unit (excl. VAT)",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "months": {
    "description": "summary: how many months back, default 12",
    "type": "number"
   },
   "name": {
    "description": "add_contact: contact name",
    "type": "string"
   },
   "notes": {
    "description": "create_invoice: notes shown on the invoice",
    "type": "string"
   },
   "status": {
    "description": "list: filter, e.g. draft, sent, paid, unpaid",
    "type": "string"
   },
   "vendorName": {
    "description": "create_expense: supplier/vendor name",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_accounting"
}
