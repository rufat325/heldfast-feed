{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Free 3 times a day per client address, no key needed. Full-page PNG of one URL at the given viewport width, returned inline when small, else as links.file to fetch with the jobToken. Call it for a one-off look at a page or a mobile-width check. Do not call it for pages a comparison job covers: get_report names their screenshots for get_screenshot. Example: { \"url\": \"https://new.example/pricing\", \"viewportWidth\": 375 }. Answers with jobId, jobToken, filename, url, dimensions, bytes, links.file and, on a free run, sample and allowanceRemaining.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "auth": {
    "description": "HTTP basic auth for the page.",
    "properties": {
     "password": {
      "description": "Password for HTTP basic auth.",
      "maxLength": 512,
      "type": "string"
     },
     "username": {
      "description": "Username for HTTP basic auth.",
      "maxLength": 512,
      "type": "string"
     }
    },
    "required": [
     "username",
     "password"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "description": "Optional opaque string a retry repeats: under a prepaid balance the same value within 24 hours is not charged again and answers DUPLICATE_REQUEST with the jobId of the first call.",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "Page to capture (full URL).",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "viewportWidth": {
    "description": "Capture width in px.",
    "maximum": 2560,
    "minimum": 320,
    "type": "integer"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "capture_screenshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowanceRemaining": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "bytes": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "code": {
    "type": "string"
   },
   "dimensions": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "type": "string"
   },
   "filename": {
    "type": "string"
   },
   "jobId": {
    "type": "string"
   },
   "jobToken": {
    "type": "string"
   },
   "links": {
    "additionalProperties": false,
    "properties": {
     "file": {
      "type": "string"
     }
    },
    "required": [
     "file"
    ],
    "type": "object"
   },
   "pagesCharged": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "payment": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "type": "string"
       },
       "balance": {
        "type": "string"
       },
       "currency": {
        "const": "USD",
        "type": "string"
       },
       "rail": {
        "const": "prepaid",
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency",
       "rail",
       "balance"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "allowanceRemaining": {
        "type": "number"
       },
       "amount": {
        "type": "string"
       },
       "currency": {
        "const": "USD",
        "type": "string"
       },
       "pagesFromAllowance": {
        "type": "number"
       },
       "rail": {
        "const": "subscription",
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency",
       "rail",
       "pagesFromAllowance",
       "allowanceRemaining"
      ],
      "type": "object"
     }
    ]
   },
   "sample": {
    "type": "boolean"
   },
   "url": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Capture screenshot"
}
