{
 "description": "View details of a specific pull request including optional diff",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "include_diff": {
    "description": "Include the diff content",
    "type": "boolean"
   },
   "owner": {
    "description": "Repository owner",
    "minLength": 1,
    "type": "string"
   },
   "pull_number": {
    "description": "Pull request number",
    "minimum": 1,
    "type": "number"
   },
   "repo": {
    "description": "Repository name",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo",
   "pull_number"
  ],
  "type": "object"
 },
 "name": "github_pr_view"
}
