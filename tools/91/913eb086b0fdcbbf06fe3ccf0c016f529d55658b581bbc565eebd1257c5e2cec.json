 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false
 },
 "description": "Execute a sealed draft. Moves money. Call ONLY after approval_session_get_approval_session_status returned APPROVED for the approval_session_id: a commit sent while the approval is still pending is rejected with step_up_required and still spends the draft. One-shot: success or failure, the draft and approval are consumed, so a retry needs a fresh draft and a fresh approval.",
 "inputSchema": {
  "properties": {
   "approvalSessionId": {
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   },
   "companyId": {
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   },
   "draftId": {
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "commit_transfer",
 "outputSchema": {
  "properties": {
   "limitDetail": {
    "anyOf": [
     {
      "properties": {
       "limitCents": {
        "type": "string"
       },
       "operationalRail": {
        "type": "string"
       },
       "origin": {
        "type": "string"
       },
       "remainingCents": {
        "type": "string"
       },
       "roleId": {
        "type": "string"
       },
       "roleName": {
        "type": "string"
       },
       "window": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "paymentId": {
    "type": "string"
   },
   "reasons": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "PAYMENT_STATUS_UNSPECIFIED",
     "PAYMENT_STATUS_SUBMITTED",
     "PAYMENT_STATUS_DENIED",
     "PAYMENT_STATUS_NEEDS_HUMAN_APPROVAL",
     "PAYMENT_STATUS_REJECTED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Commit Transfer"
