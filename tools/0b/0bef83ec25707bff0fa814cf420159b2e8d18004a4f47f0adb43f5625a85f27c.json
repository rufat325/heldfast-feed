{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read a thread"
 },
 "description": "Read every message of one thread in a connected mailbox, oldest first.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "The threadId a search or a read answered.",
    "pattern": "^[A-Za-z0-9_=-]{1,512}$",
    "type": "string"
   },
   "mailbox": {
    "description": "The mailbox's name or its email address.",
    "minLength": 1,
    "type": "string"
   },
   "view": {
    "description": "full, the default, carries each message's text and attachments; summary leaves those out; headers leaves out the subject and snippet too.",
    "enum": [
     "full",
     "summary",
     "headers"
    ],
    "type": "string"
   }
  },
  "required": [
   "mailbox",
   "id"
  ],
  "type": "object"
 },
 "name": "threads_get",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "link": {
    "type": "string"
   },
   "messages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attachments": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "attachmentId": {
          "type": "string"
         },
         "filename": {
          "type": "string"
         },
         "holdsBytes": {
          "type": "boolean"
         },
         "mimeType": {
          "type": "string"
         },
         "size": {
          "type": "number"
         },
         "sizePrecision": {
          "enum": [
           "exact",
           "upperBound"
          ],
          "type": "string"
         }
        },
        "required": [
         "attachmentId",
         "filename",
         "mimeType",
         "size",
         "holdsBytes"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "bcc": {
       "type": [
        "string",
        "null"
       ]
      },
      "body": {
       "type": "string"
      },
      "bodyFormat": {
       "enum": [
        "text",
        "html",
        "none"
       ],
       "type": "string"
      },
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "cc": {
       "type": [
        "string",
        "null"
       ]
      },
      "date": {
       "type": [
        "string",
        "null"
       ]
      },
      "draft": {
       "type": "boolean"
      },
      "draftId": {
       "type": [
        "string",
        "null"
       ]
      },
      "flagged": {
       "type": "boolean"
      },
      "folder": {
       "enum": [
        "inbox",
        "sent",
        "archive",
        "drafts",
        "deleted",
        "junk",
        "other"
       ],
       "type": "string"
      },
      "from": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "labelIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "link": {
       "type": "string"
      },
      "omittedCharacters": {
       "type": "number"
      },
      "snippet": {
       "type": [
        "string",
        "null"
       ]
      },
      "subject": {
       "type": [
        "string",
        "null"
       ]
      },
      "threadId": {
       "type": "string"
      },
      "to": {
       "type": [
        "string",
        "null"
       ]
      },
      "unread": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "threadId",
      "from",
      "to",
      "cc",
      "bcc",
      "date",
      "draft",
      "draftId",
      "unread",
      "labelIds"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "shown": {
    "type": "number"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "id",
   "messages",
   "shown",
   "total"
  ],
  "type": "object"
 },
 "title": "Read a thread"
}
