{
 "description": "Create a governance block for derivative content that references the original publisher's block. Preserves the chain of provenance.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "content": {
    "description": "Derivative content",
    "type": "string"
   },
   "derivationType": {
    "description": "Type: summary, embedding, rag_chunk, translation, etc.",
    "type": "string"
   },
   "inference": {
    "enum": [
     "permitted",
     "prohibited",
     "compensation_required",
     "attribution_required"
    ],
    "type": "string"
   },
   "parentBlock": {
    "description": "Original governance block JSON string",
    "type": "string"
   },
   "privateKey": {
    "description": "Derivative agent's Ed25519 private key (hex)",
    "type": "string"
   },
   "publicKey": {
    "description": "Derivative agent's Ed25519 public key (hex)",
    "type": "string"
   },
   "training": {
    "enum": [
     "permitted",
     "prohibited",
     "compensation_required",
     "attribution_required"
    ],
    "type": "string"
   }
  },
  "required": [
   "content",
   "publicKey",
   "privateKey",
   "parentBlock",
   "derivationType"
  ],
  "type": "object"
 },
 "name": "create_chained_governance_block"
}
