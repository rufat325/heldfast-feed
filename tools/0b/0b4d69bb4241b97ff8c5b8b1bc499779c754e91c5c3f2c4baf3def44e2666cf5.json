{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "cherami_mail:full"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Restore received email"
 },
 "description": "Restore a received email from Trash to its inbox, conversation and search results, with its labels.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "message_id": {
    "description": "ID of a received entry from list_trash.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "message_id"
  ],
  "type": "object"
 },
 "name": "restore_message",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "inbox_id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "status": {
    "description": "already_live: the message was not in Trash and nothing changed.",
    "enum": [
     "restored",
     "already_live"
    ],
    "type": "string"
   },
   "thread_id": {
    "description": "Conversation the message is in now; null while a received message is unparsed.",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "id",
   "inbox_id",
   "thread_id",
   "status",
   "message"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "cherami_mail:full"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Restore received email"
}
