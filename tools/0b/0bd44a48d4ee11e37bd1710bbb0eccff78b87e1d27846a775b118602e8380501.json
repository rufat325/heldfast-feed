    "type": "string"
   },
   "periodStart": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ads_insight_summarize_ad_spend",
