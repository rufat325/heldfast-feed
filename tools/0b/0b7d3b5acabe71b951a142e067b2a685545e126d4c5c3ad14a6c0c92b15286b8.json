{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List events"
 },
 "description": "Lists this organizer's own events, newest first \u2014 id, title, status, who's answered, and the leading date \u2014 PLUS their drafts still waiting to be sent (create_event parks one whenever it drafts rather than launches). Pass archived:true for the archived list instead of the live one (drafts are omitted there \u2014 they're neither live nor archived). A draft's review_url is the organizer's dashboard, where they can review and send it themselves after signing in. Read-only; needs the read permission.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "archived": {
    "description": "true for archived events instead of live ones",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_events",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "drafts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "type": "string"
      },
      "dates": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "date": {
          "type": "string"
         },
         "daypart": {
          "anyOf": [
           {
            "enum": [
             "morning",
             "afternoon",
             "evening"
            ],
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "endTime": {
          "anyOf": [
           {
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "startTime": {
          "anyOf": [
           {
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "date"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "draft_id": {
       "type": "string"
      },
      "guest_count": {
       "type": "number"
      },
      "review_url": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "draft_id",
      "title",
      "dates",
      "guest_count",
      "review_url",
      "created_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "events": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "console_url": {
       "type": "string"
      },
      "created_at": {
       "type": "string"
      },
      "event_id": {
       "type": "string"
      },
      "invited_count": {
       "type": "number"
      },
      "leading_date": {
       "type": [
        "string",
        "null"
       ]
      },
      "mode": {
       "enum": [
        "classic",
        "ai"
       ],
       "type": "string"
      },
      "public_url": {
       "type": "string"
      },
      "responded_count": {
       "type": "number"
      },
      "status": {
       "enum": [
        "open",
        "confirmed"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "event_id",
      "title",
      "status",
      "mode",
      "created_at",
      "invited_count",
      "responded_count",
      "leading_date",
      "public_url",
      "console_url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "events",
   "drafts"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "events:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "List events"
}
