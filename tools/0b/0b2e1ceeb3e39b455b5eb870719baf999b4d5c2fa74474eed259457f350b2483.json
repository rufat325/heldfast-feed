{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create + lock fee-sharing for an existing mint. Approval is optional. Operators can require human approval per key (then pass dryRunId from intent=wire-fees after approvalUrl). Requires CREW_LAUNCHER_KEY in MCP env.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "crew": {
    "description": "Optional \u2014 omit to reuse board crew from launch",
    "items": {
     "properties": {
      "evmWallet": {
       "maxLength": 42,
       "minLength": 42,
       "type": "string"
      },
      "handle": {
       "type": "string"
      },
      "hireRole": {
       "enum": [
        "caller",
        "chart",
        "raid",
        "kol",
        "dev"
       ],
       "type": "string"
      },
      "share": {
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      },
      "wallet": {
       "maxLength": 64,
       "minLength": 20,
       "type": "string"
      }
     },
     "required": [
      "handle",
      "wallet",
      "share"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "dryRunId": {
    "description": "Optional unless the API key has requireApproval=true",
    "maxLength": 64,
    "minLength": 16,
    "type": "string"
   },
   "launcherKey": {
    "description": "FORBIDDEN \u2014 rejected if set. Use CREW_LAUNCHER_KEY in MCP env only.",
    "type": "string"
   },
   "mint": {
    "maxLength": 64,
    "minLength": 32,
    "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,64}$",
    "type": "string"
   },
   "mode": {
    "enum": [
     "agent",
     "split",
     "buyback",
     "raid"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 32,
    "type": "string"
   },
   "privateKey": {
    "description": "FORBIDDEN \u2014 rejected if set.",
    "type": "string"
   },
   "secretKey": {
    "description": "FORBIDDEN \u2014 rejected if set.",
    "type": "string"
   },
   "ticker": {
    "maxLength": 13,
    "type": "string"
   }
  },
  "required": [
   "mint"
  ],
  "type": "object"
 },
 "name": "crew_wire_fees",
 "title": "Wire / repair CREW fee-shares"
}
