{
 "description": "Return a structured page snapshot.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "maxChildren": {
    "description": "Max children per node (default 20).",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxDepth": {
    "description": "Max tree depth (default 4).",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "selector": {
    "description": "Scope to an element; omit for document body.",
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "browser_snapshot",
 "title": "Browser Snapshot"
}
