  "readOnlyHint": true,
  "title": "Search Steam games by title"
 },
 "description": "Find Steam games by title (typos, partial names, Russian names and acronyms are fine): appid, year, imho.run page and Steam link for each match. Use it to check which game the user means or to get an appid; the other tools also accept names directly. For a game the user can only describe, use find_game_by_description. Games rated for adults only (explicit sexual content) are not covered; filtering is best effort.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "n": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_games",
 "outputSchema": {
  "properties": {
   "query": {
    "title": "Query",
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "appid": {
       "title": "Appid",
       "type": "integer"
      },
      "name": {
       "title": "Name",
       "type": "string"
      },
      "steam_url": {
       "title": "Steam Url",
       "type": "string"
      },
      "url": {
       "title": "Url",
       "type": "string"
      },
      "year": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Year"
      }
     },
     "required": [
      "appid",
      "name",
      "url",
      "steam_url"
     ],
     "title": "AgentSearchHit",
     "type": "object"
    },
    "title": "Results",
    "type": "array"
   },
   "source": {
    "title": "Source",
    "type": "string"
   }
  },
  "required": [
   "query",
   "source",
   "results"
  ],
  "title": "SearchResponse",
  "type": "object"
 },
 "title": "Search Steam games by title"
}
