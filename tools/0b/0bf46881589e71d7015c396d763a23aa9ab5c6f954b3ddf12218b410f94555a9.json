{
 "description": "Create a recurring subscription in iugu",
 "inputSchema": {
  "properties": {
   "credits_based": {
    "description": "Whether this is a credit-based subscription",
    "type": "boolean"
   },
   "customer_id": {
    "description": "Customer ID",
    "type": "string"
   },
   "expires_at": {
    "description": "First charge date (YYYY-MM-DD)",
    "type": "string"
   },
   "only_on_charge_success": {
    "description": "Only activate on first successful charge",
    "type": "boolean"
   },
   "payable_with": {
    "description": "Payment method",
    "enum": [
     "credit_card",
     "bank_slip",
     "pix",
     "all"
    ],
    "type": "string"
   },
   "plan_identifier": {
    "description": "Plan identifier slug",
    "type": "string"
   },
   "price_cents": {
    "description": "Amount in cents for credit-based subscriptions",
    "type": "number"
   },
   "return_url": {
    "description": "Redirect URL after payment",
    "type": "string"
   }
  },
  "required": [
   "customer_id"
  ],
  "type": "object"
 },
 "name": "create_subscription"
}
