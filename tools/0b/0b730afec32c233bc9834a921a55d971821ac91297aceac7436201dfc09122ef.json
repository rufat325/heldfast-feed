{
 "description": "Register an agent on the ARCXS universal registry. Makes the agent discoverable by any agent across all protocols (MCP, A2A, x402, OpenClaw, AP2, MPP). Address format: name.namespace.agent (e.g., weather.myapp.agent). Free ephemeral registration (30-day TTL) or $20/year for permanent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Unique agent address (e.g., weather.myapp.agent)",
    "type": "string"
   },
   "capabilities": {
    "additionalProperties": {},
    "description": "Agent capabilities as key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "description": {
    "description": "What the agent does",
    "type": "string"
   },
   "name": {
    "description": "Human-readable display name",
    "type": "string"
   },
   "namespace": {
    "description": "Namespace (e.g., myapp)",
    "type": "string"
   },
   "protocols": {
    "description": "Protocols spoken (e.g., [\"mcp\", \"a2a\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tags": {
    "description": "Discovery tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ttl_days": {
    "description": "TTL in days for free tier (1-30, default 30)",
    "type": "number"
   }
  },
  "required": [
   "address",
   "name"
  ],
  "type": "object"
 },
 "name": "arcxs_register"
}
