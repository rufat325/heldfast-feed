{
 "description": "Create a recurring Rolli Agent report that runs on a cron-like cadence (daily, weekly, monthly, or one-time) with optional email and Slack notifications.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "available_credits": {
    "description": "Reasoning effort for each run: 1=low, 2=medium, 3=high, 4=max (default)",
    "maximum": 4,
    "minimum": 1,
    "type": "integer"
   },
   "ends_at": {
    "description": "ISO 8601 timestamp when the schedule stops",
    "type": "string"
   },
   "max_post": {
    "description": "Posts per platform per run (default: 100)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "mode": {
    "description": "Investigation mode (default: trend_briefing)",
    "enum": [
     "trend_briefing",
     "monitoring",
     "competitive_intel"
    ],
    "type": "string"
   },
   "name": {
    "description": "User-friendly name",
    "minLength": 1,
    "type": "string"
   },
   "notify_email": {
    "description": "Email address for run notifications",
    "type": "string"
   },
   "notify_slack_channel_id": {
    "description": "Slack channel ID",
    "type": "string"
   },
   "notify_slack_webhook": {
    "description": "Slack webhook URL",
    "type": "string"
   },
   "platforms": {
    "description": "Platforms to search",
    "items": {
     "enum": [
      "twitter",
      "reddit",
      "bluesky",
      "youtube",
      "threads",
      "facebook"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "question": {
    "description": "The recurring question for the agent",
    "minLength": 1,
    "type": "string"
   },
   "recurrence_day_of_month": {
    "description": "1\u201331 for monthly schedules",
    "maximum": 31,
    "minimum": 1,
    "type": "integer"
   },
   "recurrence_day_of_week": {
    "description": "0\u20136 for weekly schedules (0 = Sunday)",
    "maximum": 6,
    "minimum": 0,
    "type": "integer"
   },
   "recurrence_time": {
    "description": "Time of day in HH:MM format (e.g., \"09:00\")",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "recurrence_timezone": {
    "description": "IANA timezone (e.g., \"America/New_York\")",
    "minLength": 1,
    "type": "string"
   },
   "recurrence_type": {
    "description": "Schedule cadence",
    "enum": [
     "daily",
     "weekly",
     "monthly",
     "once"
    ],
    "type": "string"
   },
   "slack_bot_token": {
    "description": "Slack bot token",
    "type": "string"
   },
   "slack_team_id": {
    "description": "Slack workspace ID",
    "type": "string"
   },
   "slack_team_name": {
    "description": "Slack workspace name",
    "type": "string"
   },
   "starts_at": {
    "description": "ISO 8601 timestamp when the schedule becomes active",
    "type": "string"
   },
   "time_window": {
    "description": "Time window per run (default: 7d)",
    "type": "string"
   }
  },
  "required": [
   "name",
   "question",
   "recurrence_type",
   "recurrence_time",
   "recurrence_timezone",
   "starts_at"
  ],
  "type": "object"
 },
 "name": "create_agent_schedule"
}
