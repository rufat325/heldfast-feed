{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Record the user's explicit approve, reject or request_revision decision as the authenticated assigned reviewer or organization admin. Use the exact reviewed version and a stable request_id; retries must keep identical input. Approval authorizes editorial use/export only and never publishes. Rejection preserves the draft. Revision requests record actionable feedback and stop; do not automatically rewrite.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "enum": [
       "approve",
       "reject",
       "request_revision"
      ],
      "title": "ReviewAction",
      "type": "string"
     },
     "content_version_id": {
      "format": "uuid",
      "title": "Content Version Id",
      "type": "string"
     },
     "feedback": {
      "anyOf": [
       {
        "maxLength": 10000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Feedback"
     },
     "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
     }
    },
    "required": [
     "content_version_id",
     "request_id",
     "action"
    ],
    "title": "ReviewDecisionRequest",
    "type": "object"
   },
   "review_id": {
    "format": "uuid",
    "title": "Review Id",
    "type": "string"
   }
  },
  "required": [
   "review_id",
   "body"
  ],
  "type": "object"
 },
 "name": "decide_review"
}
