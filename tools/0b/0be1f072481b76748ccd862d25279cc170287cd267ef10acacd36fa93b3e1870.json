{
 "annotations": {},
 "description": "Create a shape. Args per `type`: FRAME: width, height, fillColor, auto layout args. RECTANGLE: width, height, fillColor, cornerRadius. ELLIPSE: width, height, fillColor, startAngle, endAngle, innerRadiusRatio. STAR: pointCount, outerRadius, innerRadius, fillColor, cornerRadius. POLYGON: pointCount, radius, fillColor, cornerRadius. LINE: length, rotation, strokeColor, strokeWeight. SECTION: width, height (no parent). All: x, y, name. Other args are rejected. For text use create_text.",
 "inputSchema": {
  "properties": {
   "clipsContent": {
    "description": "Clip content",
    "type": "boolean"
   },
   "cornerRadius": {
    "description": "Corner radius",
    "type": "number"
   },
   "counterAxisAlignItems": {
    "description": "Cross axis align: MIN, CENTER, MAX, BASELINE",
    "type": "string"
   },
   "counterAxisSizingMode": {
    "description": "Cross axis size: FIXED or AUTO (hug)",
    "type": "string"
   },
   "counterAxisSpacing": {
    "description": "Gap between wrapped rows (with WRAP)",
    "type": "number"
   },
   "endAngle": {
    "description": "Arc end, radians (default full circle)",
    "type": "number"
   },
   "fillColor": {
    "description": "Fill hex e.g. #FF5733",
    "type": "string"
   },
   "height": {
    "description": "Height (default 100)",
    "type": "number"
   },
   "innerRadius": {
    "description": "STAR inner radius (default 0.38 \u00d7 outer)",
    "type": "number"
   },
   "innerRadiusRatio": {
    "description": "Hole size 0-1, for rings (default 0)",
    "type": "number"
   },
   "itemReverseZIndex": {
    "description": "Put first child on top",
    "type": "boolean"
   },
   "itemSpacing": {
    "description": "Gap between children",
    "type": "number"
   },
   "layoutAlign": {
    "description": "This node's cross axis align in the parent's auto layout",
    "type": "string"
   },
   "layoutGrow": {
    "description": "1 = grow to fill the parent's main axis, 0 = keep size",
    "type": "number"
   },
   "layoutMode": {
    "description": "Auto layout: HORIZONTAL, VERTICAL, or NONE",
    "type": "string"
   },
   "layoutPositioning": {
    "description": "In the parent's auto layout: AUTO (in flow) or ABSOLUTE (free, at x/y)",
    "type": "string"
   },
   "layoutSizingHorizontal": {
    "description": "Width mode: FIXED, HUG (fit content), or FILL (fill parent). Prefer over *AxisSizingMode. HUG needs auto layout on this node; FILL on its parent.",
    "type": "string"
   },
   "layoutSizingVertical": {
    "description": "Height mode: FIXED, HUG, or FILL. Same rules as layoutSizingHorizontal.",
    "type": "string"
   },
   "layoutWrap": {
    "description": "NO_WRAP or WRAP",
    "type": "string"
   },
   "length": {
    "description": "LINE length (default 100)",
    "type": "number"
   },
   "maxHeight": {
    "description": "Max height; null clears",
    "type": "number"
   },
   "maxWidth": {
    "description": "Max width; null clears",
    "type": "number"
   },
   "minHeight": {
    "description": "Min height; null clears",
    "type": "number"
   },
   "minWidth": {
    "description": "Min width; null clears",
    "type": "number"
   },
   "name": {
    "description": "Layer name",
    "type": "string"
   },
   "outerRadius": {
    "description": "STAR outer radius (default 50)",
    "type": "number"
   },
   "paddingBottom": {
    "description": "Bottom padding",
    "type": "number"
   },
   "paddingLeft": {
    "description": "Left padding",
    "type": "number"
   },
   "paddingRight": {
    "description": "Right padding",
    "type": "number"
   },
   "paddingTop": {
    "description": "Top padding",
    "type": "number"
   },
   "parentId": {
    "description": "Parent node ID (default: current page)",
    "type": "string"
   },
   "pointCount": {
    "description": "STAR points (default 5) or POLYGON sides (default 3)",
    "type": "number"
   },
   "primaryAxisAlignItems": {
    "description": "Main axis align: MIN, CENTER, MAX, SPACE_BETWEEN",
    "type": "string"
   },
   "primaryAxisSizingMode": {
    "description": "Main axis size: FIXED or AUTO (hug)",
    "type": "string"
   },
   "radius": {
    "description": "POLYGON radius (default 50)",
    "type": "number"
   },
   "rotation": {
    "description": "LINE rotation in degrees",
    "type": "number"
   },
   "startAngle": {
    "description": "Arc start, radians (default 0)",
    "type": "number"
   },
   "strokeColor": {
    "description": "LINE color hex",
    "type": "string"
   },
   "strokeWeight": {
    "description": "LINE width (default 1)",
    "type": "number"
   },
   "strokesIncludedInLayout": {
    "description": "Include strokes in layout size",
    "type": "boolean"
   },
   "type": {
    "description": "FRAME, RECTANGLE, ELLIPSE, STAR, POLYGON, LINE, or SECTION",
    "type": "string"
   },
   "width": {
    "description": "Width (default 100)",
    "type": "number"
   },
   "x": {
    "description": "X (default 0)",
    "type": "number"
   },
   "y": {
    "description": "Y (default 0)",
    "type": "number"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
 "name": "create_node"
}
