{
 "description": "Disassemble or assemble instructions (at address, function, info, assemble)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "at_address",
        "type": "string"
       },
       "address": {
        "default": "cip",
        "type": "string"
       },
       "count": {
        "default": "10",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "function",
        "type": "string"
       },
       "address": {
        "default": "cip",
        "type": "string"
       },
       "max_instructions": {
        "default": 50,
        "type": "number"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "info",
        "type": "string"
       },
       "address": {
        "default": "cip",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "assemble",
        "type": "string"
       },
       "address": {
        "description": "Address to assemble at",
        "type": "string"
       },
       "instruction": {
        "description": "Assembly instruction (e.g. 'nop')",
        "type": "string"
       }
      },
      "required": [
       "action",
       "address",
       "instruction"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "x64dbg_disassembly"
}
