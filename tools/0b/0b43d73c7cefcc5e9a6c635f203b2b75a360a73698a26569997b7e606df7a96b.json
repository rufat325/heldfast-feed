     }
    ]
   },
   "not_found": {
    "items": {},
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "results": {
    "items": {},
    "type": "array"
   },
   "suggested_followups": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "reason": {
       "type": "string"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool",
      "reason"
     ],
