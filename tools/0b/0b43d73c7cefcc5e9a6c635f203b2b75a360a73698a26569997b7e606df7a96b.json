 },
 "description": "Fetch transcripts for a selected batch of videos from a YouTube channel.\n\nChoose the video count, ordering, language, and whether timestamped segments are\nincluded. This is a metered batch request.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "channel": {
    "description": "A handle, channel ID, or YouTube channel URL.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "include_segments": {
    "default": false,
    "type": "boolean"
   },
   "language": {
    "default": "en",
    "maxLength": 20,
    "minLength": 2,
    "type": "string"
   },
   "sort_by": {
    "default": "newest",
    "enum": [
     "popular",
     "newest",
     "oldest"
    ],
    "type": "string"
   },
   "video_limit": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "channel"
  ],
  "type": "object"
 },
 "name": "get_youtube_channel_transcripts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "count": {
    "type": "number"
   },
   "data": {},
   "has_more": {
    "type": "boolean"
   },
   "next_cursor": {
