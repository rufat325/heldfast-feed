{
 "_meta": {
  "openai/toolInvocation/invoked": "Export sent",
  "openai/toolInvocation/invoking": "Sending the export",
  "ui": {
   "resourceUri": "ui://timesheet/ResultCard.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Send Export via Email"
 },
 "description": "Use this when the user wants to generate and send a timesheet export directly to an email address, as an Excel, CSV, or PDF file.",
 "inputSchema": {
  "properties": {
   "email": {
    "description": "Email address to send the export to",
    "type": "string"
   },
   "endDate": {
    "description": "End date for the export period (YYYY-MM-DD)",
    "type": "string"
   },
   "filename": {
    "description": "Custom filename for the export",
    "type": "string"
   },
   "format": {
    "description": "Export file format. xlsx=Excel, xlsx1904=Excel 1904 date system, csv=comma-separated, pdf=PDF document",
    "enum": [
     "xlsx",
     "xlsx1904",
     "csv",
     "pdf"
    ],
    "type": "string"
   },
   "projectIds": {
    "description": "Filter by project IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "report": {
    "description": "Report type identifier",
    "type": "number"
   },
   "startDate": {
    "description": "Start date for the export period (YYYY-MM-DD)",
    "type": "string"
   },
   "teamIds": {
    "description": "Filter by team IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "email",
   "report",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "export_send",
 "outputSchema": {
  "properties": {
   "email": {
    "description": "Email address the export was sent to",
    "type": "string"
   },
   "success": {
    "description": "Whether email was sent successfully",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "title": "Send Export via Email"
}
