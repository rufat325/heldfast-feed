{
 "description": "Fetch JSON extraction results for one or more Suparse document IDs directly in the MCP response. This can be large; use only when you need the full JSON in context. For CSV, XLSX, Google Sheets, or saved JSON files, use download_results. If you need cleanup after fetching, call delete_documents after this tool succeeds.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_url": {
    "description": "Optional API base URL. Defaults to SUPARSE_API_URL or Suparse production API.",
    "format": "uri",
    "type": "string"
   },
   "document_ids": {
    "description": "Suparse document IDs to export.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "export_type": {
    "description": "Export mode for JSON results. Defaults to unified.",
    "enum": [
     "original",
     "unified"
    ],
    "type": "string"
   }
  },
  "required": [
   "document_ids"
  ],
  "type": "object"
 },
 "name": "fetch_json_results",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "export_type": {
    "enum": [
     "original",
     "unified"
    ],
    "type": "string"
   },
   "format": {
    "const": "json",
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "documents": {
       "items": {},
       "type": "array"
      },
      "original_file": {
       "type": "string"
      },
      "task_id": {
       "type": "string"
      },
      "total_documents_extracted": {
       "type": "number"
      }
     },
     "required": [
      "task_id",
      "original_file",
      "total_documents_extracted",
      "documents"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "format",
   "export_type",
   "results"
  ],
  "type": "object"
 },
 "title": "Fetch JSON Results"
}
