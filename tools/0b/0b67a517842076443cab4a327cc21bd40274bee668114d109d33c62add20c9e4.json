{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Fetch a paid sweep report"
 },
 "description": "Legacy alias of wallet_sweep kept for older clients: returns status=full with every holding once the wallet's payment has settled, otherwise status=not_paid with payment details. Prefer wallet_sweep. Errors (isError=true): malformed address.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Wallet address the report was requested for",
    "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "wallet_sweep_report",
 "outputSchema": {
  "properties": {
   "generated_utc": {
    "type": "string"
   },
   "not_scored": {
    "type": "integer"
   },
   "owner": {
    "type": "string"
   },
   "payment": {
    "description": "How to unlock the full report (absent once paid).",
    "properties": {
     "amount_sol": {
      "type": "number"
     },
     "how": {
      "type": "string"
     },
     "pay_to": {
      "type": "string"
     },
     "price_usd": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "riskiest": {
    "description": "up to 3 lowest-scoring holdings",
    "items": {
     "properties": {
      "amount": {
       "type": "number"
      },
      "flags": {
       "items": {
        "properties": {
         "msg": {
          "type": "string"
         },
         "severity": {
          "enum": [
           "critical",
           "high",
           "med",
           "low",
           "info",
           "ok"
          ],
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "found": {
       "type": "boolean"
      },
      "grade": {
       "type": "string"
      },
      "mint": {
       "type": "string"
      },
      "program": {
       "enum": [
        "spl-token",
        "token-2022"
       ],
       "type": "string"
      },
      "score": {
       "type": [
        "integer",
        "null"
       ]
      },
      "symbol": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "rows": {
    "description": "every holding, only when status=full",
    "items": {
     "properties": {
      "amount": {
       "type": "number"
      },
      "flags": {
       "items": {
        "properties": {
         "msg": {
          "type": "string"
         },
         "severity": {
          "enum": [
           "critical",
           "high",
           "med",
           "low",
           "info",
           "ok"
          ],
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "found": {
       "type": "boolean"
      },
      "grade": {
       "type": "string"
      },
      "mint": {
       "type": "string"
      },
      "program": {
       "enum": [
        "spl-token",
        "token-2022"
       ],
       "type": "string"
      },
      "score": {
       "type": [
        "integer",
        "null"
       ]
      },
      "symbol": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "description": "full = every holding itemised; summary = free tier; not_paid = payment not seen yet",
    "enum": [
     "full",
     "summary",
     "not_paid"
    ],
    "type": "string"
   },
   "tokens_held": {
    "type": "integer"
   },
   "tokens_scored": {
    "type": "integer"
   },
   "truncated": {
    "description": "holdings beyond the 40-token cap",
    "type": "integer"
   }
  },
  "required": [
   "owner",
   "status",
   "tokens_held"
  ],
  "type": "object"
 },
 "title": "Fetch a paid sweep report"
}
