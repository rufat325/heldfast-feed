{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Delete questions from a draft interview round"
 },
 "description": "Delete questions from one draft round by question id. Optional source_stage {stage: questions_and_directions, version} returns 409 when stale.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "const": "interview_plan.delete_questions",
    "type": "string"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "input": {
    "additionalProperties": false,
    "properties": {
     "ids": {
      "items": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
     },
     "round_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
     },
     "source_stage": {
      "additionalProperties": false,
      "properties": {
       "stage": {
        "const": "questions_and_directions",
        "type": "string"
       },
       "version": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "stage"
      ],
      "type": "object"
     }
    },
    "required": [
     "round_id",
     "ids"
    ],
    "type": "object"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "resource": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "pattern": "^ipd_[0-9A-Za-z]{16,64}$",
      "type": "string"
     },
     "type": {
      "const": "interview_plan_draft",
      "type": "string"
     }
    },
    "required": [
     "type",
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "action",
   "resource",
   "input"
  ],
  "type": "object"
 },
 "name": "yardstick_interview_plan_drafts_delete_questions",
 "title": "Delete questions from a draft interview round"
}
