{
 "description": "Everything in one call, Robinhood Chain and Solana: live buyer bursts on both chains (last 1-240 minutes, all tiers), Robinhood pools opened in the last hour, and 24-hour tallies (bursts, scored, median 30-minute return, rug check, pump.fun graduations). Data rewritten every 20 s; data older than 120 s is refused with a 503 and not charged. Costs $0.03 USDC per call (x402).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "minutes": {
    "description": "Look-back window in minutes, 1-240 (default 60)",
    "maximum": 240,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "launch_snapshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ageSec": {
    "type": "number"
   },
   "generatedAt": {
    "type": "number"
   },
   "robinhood": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "schemaVersion": {
    "type": "number"
   },
   "solana": {
    "$ref": "#/properties/robinhood"
   },
   "windowMin": {
    "type": "number"
   }
  },
  "required": [
   "schemaVersion",
   "generatedAt",
   "ageSec",
   "windowMin",
   "robinhood",
   "solana"
  ],
  "type": "object"
 }
}
