{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Deterministically resolve a folder by name/ID/URL and rename it (PUT /folders/{id}). dry_run=true (default) previews the rename.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dry_run": {
    "default": true,
    "description": "true = preview only; false = rename",
    "type": "boolean"
   },
   "folder_ref": {
    "description": "Folder name, ID, or dashboard URL",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Reserved client-supplied retry key",
    "type": "string"
   },
   "new_name": {
    "description": "New folder name",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "folder_ref",
   "new_name"
  ],
  "type": "object"
 },
 "name": "panda_action_rename_folder",
 "title": "Rename Folder"
}
