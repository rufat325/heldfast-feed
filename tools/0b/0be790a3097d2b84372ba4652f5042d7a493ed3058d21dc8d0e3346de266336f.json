{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search real product deals across DiscountHub merchants using keywords and filters.",
 "inputSchema": {
  "properties": {
   "category": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Short product keywords. Use catalogue language.",
    "title": "Category"
   },
   "country": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z]{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Two-letter country code, e.g. US or UZ.",
    "title": "Country"
   },
   "limit": {
    "default": 5,
    "description": "Number of results per collection.",
    "maximum": 20,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "max_price": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 100000000,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Maximum price in USD; excludes taxes and shipping.",
    "title": "Max Price"
   },
   "min_discount": {
    "default": 1,
    "description": "Minimum discount in percent.",
    "maximum": 100,
    "minimum": 1,
    "title": "Min Discount",
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Pagination page number.",
    "maximum": 1000,
    "minimum": 1,
    "title": "Page",
    "type": "integer"
   },
   "query": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Short product keywords. Use catalogue language.",
    "title": "Query"
   },
   "store": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Merchant name as shown in DiscountHub.",
    "title": "Store"
   }
  },
  "title": "search_dealsArguments",
  "type": "object"
 },
 "name": "search_deals"
}
