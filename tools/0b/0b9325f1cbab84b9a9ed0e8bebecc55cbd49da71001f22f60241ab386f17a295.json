      "type": "string"
     }
    },
    "required": [
     "url",
     "status"
    ],
    "type": "object"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "type": "integer"
   },
   "url": {
    "type": "string"
   },
   "xRobotsTag": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "reachable",
