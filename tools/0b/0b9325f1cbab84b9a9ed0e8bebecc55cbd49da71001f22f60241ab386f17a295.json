{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Checks whether 14 AI crawlers may fetch a page. Use it when the user asks whether AI crawlers can read a website or page, for example \"can AI crawlers read example.com?\", \"is GPTBot blocked in my robots.txt?\" or \"which AI bots are allowed on https://example.com/blog?\". Pass the page address. Returns, for 14 AI crawlers, whether robots.txt allows the page and the rule that decided it, plus the sitemaps, the redirect chain, and the page's X-Robots-Tag header and robots meta tag. It reads robots.txt only and does not test whether a firewall blocks crawlers. Do not use it for private or local addresses, for security scans, or to collect a site's content.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "Address of a public web page, for example https://example.com/pricing. A bare domain such as example.com means https. Only public http and https sites on the standard ports are checked.",
    "maxLength": 2048,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "check_ai_crawler_access",
 "outputSchema": {
  "properties": {
   "blockedCrawlers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "crawlers": {
    "items": {
     "properties": {
      "allowed": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "crawler": {
       "type": "string"
      },
      "operator": {
       "type": "string"
      },
      "purpose": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      }
     },
     "required": [
      "crawler",
      "operator",
      "purpose",
      "allowed"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "failure": {
    "type": "string"
   },
   "finalUrl": {
    "type": "string"
   },
   "metaRobots": {
    "type": "string"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "reachable": {
    "type": "boolean"
   },
   "redirects": {
    "items": {
     "properties": {
      "location": {
       "type": "string"
      },
      "status": {
       "type": "integer"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "robots": {
    "properties": {
