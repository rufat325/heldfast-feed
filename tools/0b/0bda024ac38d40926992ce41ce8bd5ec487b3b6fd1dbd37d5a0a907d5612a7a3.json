{
 "description": "List the scope items for an engagement.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "engagementId"
  ],
  "type": "object"
 },
 "name": "list_scope_items",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "scopeItems": {
    "items": {},
    "type": "array"
   }
  },
  "required": [
   "count",
   "scopeItems"
  ],
  "type": "object"
 },
 "title": "List scope items"
}
