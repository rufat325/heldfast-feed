{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Open prediction markets expiring soon"
 },
 "description": "Free public list of OPEN events whose endDate falls within the next `days` (default 7), soonest first, across all venues. Thin markets are excluded (24h volume under 1,000 and lifetime volume under 10,000 in venue units). Rows are compact events plus expiresInMs (milliseconds from the response to endDate). endDate is the venue's scheduled end, not a settlement guarantee. No API key required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "Lookahead window in days, 1-30 (default 7).",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "fiat": {
    "description": "Fiat currency code for monetary figures (default USD).",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "limit": {
    "description": "Rows, 1-100 (default 10).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset (default 0).",
    "minimum": 0,
    "type": "integer"
   },
   "source": {
    "description": "Venue slug, as in pm_data_events rows.",
    "enum": [
     "polymarket",
     "kalshi",
     "rothera",
     "limitless",
     "smarkets",
     "manifold",
     "metaculus",
     "predictit",
     "futuur",
     "myriad",
     "forecastex",
     "gemini"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "pm_data_expiring",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {},
   "httpStatus": {
    "type": "integer"
   },
   "ledgerEventId": {
    "type": [
     "string",
     "null"
    ]
   },
   "ledgerStatus": {
    "type": [
     "string",
     "null"
    ]
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "httpStatus",
   "ok"
  ],
  "type": "object"
 },
 "title": "Open prediction markets expiring soon"
}
