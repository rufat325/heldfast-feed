{
 "_meta": {
  "ui": {
   "resourceUri": "ui://frontend-checklist/review-report"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Review Frontend Code"
 },
 "description": "Runs a non-exhaustive static heuristic review of pasted HTML, CSS, or JavaScript against multiple frontend best practices and returns prioritized issues, fix guidance, and suggestions for manual verification. Use it when the user requests a review, audit, or debugging of source code. An empty issue list means no provable static issue was found; it does not establish accessibility conformance or runtime correctness.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://frontendchecklist.io/favicon.svg"
  }
 ],
 "inputSchema": {
  "properties": {
   "code": {
    "description": "The HTML, CSS, or JavaScript source to review (a snippet or a whole file).",
    "type": "string"
   },
   "focus": {
    "description": "Only check these categories (default: auto-detected from the code).",
    "items": {
     "enum": [
      "html",
      "css",
      "javascript",
      "performance",
      "accessibility",
      "seo",
      "security",
      "images"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "minPriority": {
    "description": "Lowest priority to report (default: medium).",
    "enum": [
     "critical",
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "review_code",
 "outputSchema": {
  "properties": {
   "issues": {
    "items": {
     "properties": {
      "fixPrompt": {
       "type": "string"
      },
      "issue": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "critical",
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "suggestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "summary": {
    "properties": {
     "categories": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "criticalIssues": {
      "type": "number"
     },
     "highIssues": {
      "type": "number"
     },
     "issuesFound": {
      "type": "number"
     },
     "totalChecks": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Review Frontend Code"
}
