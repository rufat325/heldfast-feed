{
 "description": "Returns a hydration schedule optimised for sustained energy through the day. Considers weight, sleep duration, caffeine schedule, and climate. The output is a time-stamped schedule (mL per slot, drink type, reason). Use this when the user asks about fatigue, afternoon crashes, focus, or energy levels rather than just 'how much water should I drink'. \u2014 powered by Vari (https://getvari.app)",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activity_level": {
    "enum": [
     "sedentary",
     "light",
     "moderate",
     "active",
     "very_active"
    ],
    "type": "string"
   },
   "caffeine_drinks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "time": {
       "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
       "type": "string"
      },
      "type": {
       "enum": [
        "coffee",
        "tea",
        "energy_drink"
       ],
       "type": "string"
      }
     },
     "required": [
      "time",
      "type"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "climate": {
    "enum": [
     "cold",
     "temperate",
     "hot",
     "very_hot"
    ],
    "type": "string"
   },
   "sleep_hours_last_night": {
    "maximum": 14,
    "minimum": 0,
    "type": "number"
   },
   "sleep_time": {
    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
    "type": "string"
   },
   "wake_time": {
    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
    "type": "string"
   },
   "weight_kg": {
    "maximum": 200,
    "minimum": 35,
    "type": "number"
   }
  },
  "required": [
   "weight_kg",
   "wake_time",
   "sleep_time"
  ],
  "type": "object"
 },
 "name": "optimize_hydration_for_energy"
}
