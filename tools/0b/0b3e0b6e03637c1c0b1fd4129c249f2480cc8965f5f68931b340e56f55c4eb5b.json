{
 "description": "Create a boleto charge. Returns boleto PDF URL, barcode, and expiration date.",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "Amount in cents",
    "type": "number"
   },
   "boleto": {
    "description": "Boleto instructions + payer data",
    "properties": {
     "document_number": {
      "description": "Boleto document number",
      "type": "string"
     },
     "expiration_date": {
      "description": "DD/MM/YYYY",
      "type": "string"
     },
     "instructions": {
      "description": "Free-text instructions shown on boleto",
      "type": "string"
     },
     "provider": {
      "description": "Bank provider identifier (e.g. santander)",
      "type": "string"
     }
    },
    "required": [
     "document_number",
     "expiration_date"
    ],
    "type": "object"
   },
   "customer": {
    "description": "Payer identity",
    "properties": {
     "document_number": {
      "type": "string"
     },
     "document_type": {
      "enum": [
       "CPF",
       "CNPJ"
      ],
      "type": "string"
     },
     "first_name": {
      "type": "string"
     },
     "last_name": {
      "type": "string"
     }
    },
    "required": [
     "first_name",
     "last_name",
     "document_type",
     "document_number"
    ],
    "type": "object"
   },
   "customer_id": {
    "description": "Merchant-side customer id",
    "type": "string"
   },
   "order_id": {
    "description": "Merchant-side order identifier",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "order_id",
   "customer_id",
   "boleto",
   "customer"
  ],
  "type": "object"
 },
 "name": "create_boleto"
}
