{
 "description": "Recent on-chain activity (trades etc.) for an address or username.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "input": {
    "description": "0x proxy wallet address or a leaderboard username",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "max rows (default 20)",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "pm_activity"
}
