{
 "description": "Register a webhook URL to receive payment notifications. Max 5 webhooks per agent. REQUIRES AGENT KEY.",
 "inputSchema": {
  "properties": {
   "events": {
    "default": [
     "invoice_paid"
    ],
    "description": "Event types to subscribe to",
    "items": {
     "enum": [
      "invoice_paid",
      "payment_completed",
      "payment_failed",
      "balance_low",
      "budget_warning",
      "test"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "url": {
    "description": "HTTPS webhook URL to receive events",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "register_webhook"
}
