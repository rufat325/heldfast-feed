{
 "description": "Count the 'transactions' in a Chia block. Returns coin_spends_count (the canonical analogue), plus additions_count and removals_count. Pass either height OR header_hash.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "header_hash": {
    "pattern": "^(0x)?[0-9a-fA-F]{64}$",
    "type": "string"
   },
   "height": {
    "description": "Block height",
    "minimum": 0,
    "type": "integer"
   },
   "network": {
    "default": "mainnet",
    "description": "Chia network: 'mainnet' (default) or 'testnet11'",
    "enum": [
     "mainnet",
     "testnet11"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "count_block_transactions"
}
