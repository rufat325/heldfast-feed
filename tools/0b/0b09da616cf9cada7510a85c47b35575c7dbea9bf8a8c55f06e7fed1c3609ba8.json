{
 "description": "Open a structured price negotiation with another agent \u2014 bid, counter, accept, decline. Works across chains and protocols; the counterparty agent doesn't need to share your framework.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoAcceptWithinPct": {
    "description": "Auto-accept if counter is within this percentage",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "capability": {
    "description": "Capability being negotiated",
    "type": "string"
   },
   "maxRounds": {
    "description": "Maximum negotiation rounds",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "offerCents": {
    "maximum": 10000000,
    "minimum": 100,
    "type": "integer"
   },
   "sellerDid": {
    "maxLength": 256,
    "minLength": 8,
    "pattern": "^did:[a-z]+:[a-zA-Z0-9._:%-]+$",
    "type": "string"
   }
  },
  "required": [
   "sellerDid",
   "capability",
   "offerCents"
  ],
  "type": "object"
 },
 "name": "start_negotiation"
}
