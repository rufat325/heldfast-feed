{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a candidate"
 },
 "description": "WRITE: add a candidate manually (as if a recruiter added them in the app \u2014 no auto-confirmation email is sent), optionally assigning them straight to one or more jobs in the job's default stage. Recruitee: POST /c/{company_id}/candidates.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cover_letter": {
    "description": "Cover letter text.",
    "type": "string"
   },
   "emails": {
    "description": "Email addresses.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "type": "array"
   },
   "links": {
    "description": "Other links (portfolio, website).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Candidate's full name (required).",
    "minLength": 1,
    "type": "string"
   },
   "offer_ids": {
    "description": "Jobs/talent pools to assign the candidate to (default stage).",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "phones": {
    "description": "Phone numbers.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "remote_cv_url": {
    "description": "Public URL of the CV file for Recruitee to fetch.",
    "format": "uri",
    "type": "string"
   },
   "social_links": {
    "description": "Social profile URLs (e.g. LinkedIn).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sources": {
    "description": "Source tags, e.g. [\"Referral\"].",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "recruitee_create_candidate",
 "title": "Create a candidate"
}
