{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "carscout:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Submit Feedback"
 },
 "description": "Send a bug report, feature request, or feedback to the CarScout team only when the user asks to send it.",
