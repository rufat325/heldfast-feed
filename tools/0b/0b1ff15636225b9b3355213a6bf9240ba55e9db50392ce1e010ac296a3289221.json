    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "description": "Short summary",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Feedback type",
    "enum": [
     "bug",
     "feature",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "title",
   "description"
  ],
  "type": "object"
 },
 "name": "submit_feedback",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "feedback": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "status": {
      "maxLength": 100,
      "type": "string"
     },
     "title": {
      "maxLength": 200,
      "type": "string"
     },
     "type": {
      "enum": [
       "bug",
       "feature",
       "other"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "type",
     "title",
     "status"
    ],
    "type": "object"
   }
  },
  "required": [
   "feedback"
  ],
  "type": "object"
 },
 "title": "Submit Feedback"
}
