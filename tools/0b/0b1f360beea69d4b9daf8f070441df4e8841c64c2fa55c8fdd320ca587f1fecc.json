{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate a shared-living agreement for tenants. Use when you need a comprehensive agreement. Do NOT use when you only need to split utilities.",
 "inputSchema": {
  "properties": {
   "deposit": {
    "description": "Deposit amount (0 if none)",
    "type": "number"
   },
   "house_rules": {
    "description": "Custom house rules; default covers quiet hours, guests, cleaning rota and shared supplies",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "monthly_rent": {
    "description": "Total monthly rent",
    "type": "number"
   },
   "move_in_date": {
    "description": "Move-in date (YYYY-MM-DD)",
    "type": "string"
   },
   "notice_period_months": {
    "description": "Notice period in months, default 1",
    "type": "number"
   },
   "property_address": {
    "description": "Address of the shared home",
    "type": "string"
   },
   "room_assignments": {
    "description": "Who sleeps in which room",
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "room": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "room"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "tenants": {
    "description": "All tenants (at least 2)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "utilities_policy": {
    "description": "How utilities are shared; default 'split equally unless agreed otherwise'",
    "type": "string"
   }
  },
  "required": [
   "property_address",
   "tenants",
   "move_in_date",
   "monthly_rent",
   "deposit"
  ],
  "type": "object"
 },
 "name": "roommate_agreement",
 "outputSchema": {
  "properties": {
   "agreement_text": {
    "description": "The full text of the roommate agreement in plain language.",
    "type": "string"
   },
   "signature_blocks": {
    "description": "The signature blocks for each tenant.",
    "items": {
     "properties": {
      "signature_date": {
       "description": "The date on which the tenant should sign.",
       "type": "string"
      },
      "tenant_name": {
       "description": "The name of the tenant who needs to sign.",
       "type": "string"
      }
     },
     "required": [
      "tenant_name",
      "signature_date"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "agreement_text",
   "signature_blocks"
  ],
  "type": "object"
 },
 "title": "Roommate agreement"
}
