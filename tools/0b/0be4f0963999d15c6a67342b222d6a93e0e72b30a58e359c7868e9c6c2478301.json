{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Ex\u00e9cute une commande dans une VM via SSH \u26a0\ufe0f ATTENTION: Op\u00e9ration potentiellement destructive!",
 "inputSchema": {
  "properties": {
   "capture": {
    "default": false,
    "type": "boolean"
   },
   "command": {
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "sudo": {
    "default": false,
    "type": "boolean"
   },
   "timeout": {
    "default": 300,
    "maximum": 600,
    "minimum": 10,
    "type": "number"
   },
   "user": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "vm_name": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
    "type": "string"
   }
  },
  "required": [
   "vm_name",
   "command"
  ],
  "type": "object"
 },
 "name": "vm_exec"
}
