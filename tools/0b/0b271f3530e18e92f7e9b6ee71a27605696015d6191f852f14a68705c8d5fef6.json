{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "utilpeek: convert a time between IANA time zones"
 },
 "description": "utilpeek: convert one instant between time zones. For business days use count_or_add_business_days. Zones come from the pinned IANA tz database (tzdata package), not the host; a wall time in a DST gap or fold is flagged `nonexistent` / `ambiguous`; a time with an offset plus `from_tz` is a 422. An unknown zone or a malformed time is a 422 (not charged). Typically under 0.1 s. Price: USD 0.001. Free: 10 utilpeek calls per IP per UTC day. Docs: https://tanod.dev/learn/timezone-converter-api.html",
 "inputSchema": {
  "properties": {
   "from_tz": {
    "anyOf": [
     {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^([A-Za-z0-9_+\\-]{1,40}(/[A-Za-z0-9_+\\-]{1,40}){0,2})$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional IANA zone of a time WITHOUT an offset (default UTC).",
    "title": "From Tz"
   },
   "time": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional ISO 8601 date-time or Unix seconds (default now).",
    "title": "Time"
   },
   "to_tz": {
    "description": "1-20 IANA time zones to convert to.",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "pattern": "^([A-Za-z0-9_+\\-]{1,40}(/[A-Za-z0-9_+\\-]{1,40}){0,2})$",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "title": "To Tz",
    "type": "array"
   }
  },
  "required": [
   "to_tz"
  ],
  "title": "convert_timeArguments",
  "type": "object"
 },
 "name": "convert_time",
