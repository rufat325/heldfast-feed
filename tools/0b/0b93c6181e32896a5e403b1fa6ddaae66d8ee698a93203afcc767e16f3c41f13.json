{
 "description": "Send emails via Resend API. Provide html_content and/or text_content.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attachments": {
    "description": "Attachments (max 40MB total)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "description": "Base64-encoded content",
       "type": "string"
      },
      "content_id": {
       "type": "string"
      },
      "content_type": {
       "type": "string"
      },
      "filename": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "content",
      "filename"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bcc_emails": {
    "description": "BCC recipients",
    "items": {
     "format": "email",
     "type": "string"
    },
    "type": "array"
   },
   "cc_emails": {
    "description": "CC recipients",
    "items": {
     "format": "email",
     "type": "string"
    },
    "type": "array"
   },
   "html_content": {
    "description": "HTML content of the email",
    "type": "string"
   },
   "reply_to": {
    "anyOf": [
     {
      "format": "email",
      "type": "string"
     },
     {
      "items": {
       "format": "email",
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Reply-to email address(es)"
   },
   "scheduled_at": {
    "description": "Schedule email for later (natural language or ISO 8601)",
    "type": "string"
   },
   "sender_email": {
    "description": "Sender email address, verified in Resend",
    "format": "email",
    "type": "string"
   },
   "subject": {
    "description": "Email subject line",
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "description": "Custom tags as key/value pairs",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "text_content": {
    "description": "Plain text version of the email",
    "type": "string"
   },
   "to_emails": {
    "description": "List of recipient email addresses (max 50)",
    "items": {
     "format": "email",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "to_emails",
   "subject",
   "sender_email"
  ],
  "type": "object"
 },
 "name": "send_email"
}
