{
 "description": "Retrieve the hierarchical DOM tree of the Firefox chrome user interface window.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxDepth": {
    "default": 3,
    "description": "Maximum recursive depth to traverse.",
    "type": "number"
   },
   "rootSelector": {
    "default": "window",
    "description": "CSS selector for root element.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_ui_tree"
}
