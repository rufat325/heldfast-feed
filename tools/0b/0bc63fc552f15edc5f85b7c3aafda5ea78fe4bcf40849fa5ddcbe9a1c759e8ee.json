{
 "description": "List all prices for a specific product.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "limit": {
    "description": "Max number of prices to return",
    "type": "number"
   },
   "locationId": {
    "description": "Location ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "offset": {
    "description": "Number of prices to skip for pagination",
    "type": "number"
   },
   "productId": {
    "description": "The product ID to list prices for",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "productId",
   "locationId"
  ],
  "type": "object"
 },
 "name": "crm_list_prices"
}
