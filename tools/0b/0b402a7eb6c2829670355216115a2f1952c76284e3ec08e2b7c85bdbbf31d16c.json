{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "update"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set App Metadata"
 },
 "description": "Update public HTML-shell metadata immediately, without AI, code edits, publishing or Saved Versions. Upload social_image/icon as base64 PNG/JPEG/WebP (max 5 MB, 4096px); null clears an image. Language sets HTML lang/dir and OG locale. For per-page cards, write optional seo.json and publish it; dynamic entries may read only explicitly public entity records.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "app_id": {
    "type": "string"
   },
   "description": {
    "maxLength": 4000,
    "type": "string"
   },
   "icon": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "base64": {
        "type": "string"
       },
       "content_type": {
        "enum": [
         "image/png",
         "image/jpeg",
         "image/webp"
        ],
        "type": "string"
       }
      },
      "required": [
       "base64",
       "content_type"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "language": {
    "description": "BCP-47 code, e.g. he, ar, en-US",
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "type": "string"
   },
   "social_image": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "base64": {
        "type": "string"
       },
       "content_type": {
        "enum": [
         "image/png",
         "image/jpeg",
         "image/webp"
        ],
        "type": "string"
       }
      },
      "required": [
       "base64",
       "content_type"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "structured_data": {
    "description": "Optional JSON-LD JSON string; empty clears it",
    "type": "string"
   }
  },
  "required": [
   "app_id"
  ],
  "type": "object"
 },
 "name": "set_app_metadata",
 "securitySchemes": [
  {
   "scopes": [
    "update"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Set App Metadata"
}
