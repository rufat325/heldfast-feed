{
 "description": "Get message report entries within a date range",
 "inputSchema": {
  "properties": {
   "channel": {
    "description": "Channel to report on",
    "enum": [
     "sms",
     "whatsapp",
     "rcs",
     "email",
     "voice",
     "facebook"
    ],
    "type": "string"
   },
   "endDate": {
    "description": "ISO 8601 end date (e.g. 2026-04-24)",
    "type": "string"
   },
   "startDate": {
    "description": "ISO 8601 start date (e.g. 2026-04-01)",
    "type": "string"
   }
  },
  "required": [
   "channel",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "get_report_entries"
}
