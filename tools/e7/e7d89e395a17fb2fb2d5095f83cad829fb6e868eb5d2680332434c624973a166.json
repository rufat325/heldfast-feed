    "type": "string"
   },
   "cursor": {
    "type": "string"
   },
   "limit": {
    "default": 100,
    "type": "integer"
   },
   "status": {
    "enum": [
     "pending",
     "submitted",
     "confirmed",
     "failed"
    ],
    "type": "string"
   },
   "wallet_id": {
    "type": "string"
   }
  },
  "required": [
   "wallet_id"
  ],
  "type": "object"
 },
 "name": "list_transactions"
}
