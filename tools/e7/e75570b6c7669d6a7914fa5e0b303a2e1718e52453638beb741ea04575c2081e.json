{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Remove a relation between two tickets (removes both directions). Errors if the relation does not exist.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "source": {
    "description": "Source ticket title",
    "type": "string"
   },
   "target": {
    "description": "Target ticket title",
    "type": "string"
   },
   "type": {
    "description": "Relation type",
    "type": "string"
   }
  },
  "required": [
   "source",
   "type",
   "target"
  ],
  "type": "object"
 },
 "name": "relation_remove",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "removed": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "removed"
  ],
  "type": "object"
 }
}
