{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Cpsc Recall Search"
 },
 "description": "Search U.S. Consumer Product Safety Commission (CPSC) product recalls via SaferProducts.gov (keyless). Filter by product name/keyword, title, manufacturer, hazard, recall number, and date range. Returns recall number, date, title, products, hazards, remedy, manufacturers, injuries, and the official CPSC recall URL. Data: CPSC/SaferProducts.gov.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date_end": {
    "description": "Recalls on/before this date (YYYY-MM-DD).",
    "type": "string"
   },
   "date_start": {
    "description": "Recalls on/after this date (YYYY-MM-DD).",
    "type": "string"
   },
   "hazard": {
    "description": "Hazard keyword filter (e.g. 'fire', 'choking', 'laceration').",
    "type": "string"
   },
   "limit": {
    "description": "Max recalls to return (default 25).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "manufacturer": {
    "description": "Manufacturer name filter.",
    "type": "string"
   },
   "product": {
    "description": "Product name filter (e.g. 'stroller', 'space heater').",
    "type": "string"
   },
   "recall_number": {
    "description": "Exact CPSC recall number (e.g. '26561').",
    "type": "string"
   },
   "title": {
    "description": "Recall title keyword filter.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "cpsc_recall_search"
}
