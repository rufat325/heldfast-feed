  "readOnlyHint": false,
  "title": "Attach Image To Page"
 },
 "description": "Attach a ready media asset to the page. placement determines where: avatar (header), block_image (image inside a specific block \u2014 requires blockId), gallery_item (appended to a gallery \u2014 optional blockId targets a specific gallery; otherwise the first one is used), background (theme background).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "altText": {
    "description": "Meaningful alt text for the image.",
    "type": "string"
   },
   "blockId": {
    "description": "Required when placement is block_image; optional for gallery_item (targets a specific gallery block).",
    "type": "string"
   },
   "editToken": {
    "description": "Required for anonymous demo pages. Use the editToken returned by page_create.",
    "type": "string"
   },
   "mediaAssetId": {
    "description": "The mediaAssetId returned by media_upload or media_upload_link_create.",
    "format": "uuid",
    "type": "string"
   },
   "pageId": {
    "description": "The pageId returned by page_create.",
    "format": "uuid",
    "type": "string"
   },
   "placement": {
    "description": "Where the image should be used. header_photo = business-card top photo, avatar = profile header avatar, block_image = image inside a block (requires blockId), gallery_item = appended to a gallery block, background = page background.",
    "enum": [
     "avatar",
     "header_photo",
     "block_image",
     "gallery_item",
     "background",
     "unassigned"
    ],
    "type": "string"
   }
  },
  "required": [
   "pageId",
   "mediaAssetId",
   "placement"
  ],
  "type": "object"
 },
