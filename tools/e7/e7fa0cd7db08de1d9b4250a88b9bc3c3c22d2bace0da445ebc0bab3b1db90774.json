{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Ask B.R.M to contact the user"
 },
 "description": "Sends the user's request to the B.R.M team: 'appointment' (private visit of the manufacture \u2014 a booking link is returned), 'quote' (personalised quote by email), or 'special_request' (anything the configurator does not offer; the workshop checks feasibility). Requires the user's explicit agreement to share their email and be contacted (user_consent=true). The message cannot be recalled once sent. Never an order, never a payment. Limited to a few requests per day.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "configuration": {
    "additionalProperties": false,
    "properties": {
     "engraving": {
      "description": "Optional engraving text (not priced, not rendered).",
      "maxLength": 24,
      "type": "string"
     },
     "model": {
      "description": "model_id from list_models, e.g. 'v6-44-sa'.",
      "type": "string"
     },
     "options": {
      "description": "option_id values from describe_model. Unset components keep their default.",
      "items": {
       "type": "string"
      },
      "maxItems": 40,
      "type": "array"
     }
    },
    "required": [
     "model"
    ],
    "type": "object"
   },
   "contact": {
    "additionalProperties": false,
    "properties": {
     "email": {
      "format": "email",
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "type": "string"
     }
    },
    "required": [
     "email"
    ],
    "type": "object"
   },
   "country": {
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 80,
    "type": "string"
   },
   "kind": {
    "enum": [
     "appointment",
     "quote",
     "special_request"
    ],
    "type": "string"
   },
   "lang": {
    "default": "en",
    "enum": [
     "fr",
     "en",
     "de",
     "es",
     "it",
     "nl",
     "pt",
     "ja",
     "ko",
     "zh",
     "ar",
     "hi"
    ],
    "type": "string"
   },
   "message": {
    "description": "What the user wants, in their words, precise enough for the workshop.",
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   },
   "user_consent": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "kind",
   "contact",
   "message",
   "user_consent"
  ],
  "type": "object"
 },
 "name": "submit_request",
 "outputSchema": {
  "properties": {
   "duplicate": {
    "type": "boolean"
   },
   "idempotent_replay": {
    "type": "boolean"
   },
   "is_order": {
    "const": false
   },
   "kind": {
    "type": "string"
   },
   "next_step": {
    "properties": {
     "booking_url": {
      "format": "uri",
      "type": "string"
     },
     "text": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "privacy": {
    "type": "string"
   },
   "request_id": {
    "examples": [
     "AG-3F9A12C0"
    ],
    "type": "string"
   },
   "status": {
    "const": "received"
   }
  },
  "type": "object"
 },
 "title": "Ask B.R.M to contact the user"
}
