{
 "description": "Update page properties (name, slug, settings, custom code)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "is_homepage": {
    "description": "Set as homepage",
    "type": "boolean"
   },
   "name": {
    "description": "New name",
    "type": "string"
   },
   "page_id": {
    "description": "Page ID",
    "type": "string"
   },
   "settings": {
    "additionalProperties": {},
    "description": "Page settings",
    "type": "object"
   },
   "slug": {
    "description": "New slug WITHOUT a leading slash (e.g. 'about', 'cart'). A leading '/' is stripped automatically \u2014 '/cart' would 404 on the storefront.",
    "type": "string"
   }
  },
  "required": [
   "page_id"
  ],
  "type": "object"
 },
 "name": "update_page"
}
