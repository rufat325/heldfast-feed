        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "clip_count": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "distance_km": {
       "anyOf": [
        {
         "type": "number"
        },
