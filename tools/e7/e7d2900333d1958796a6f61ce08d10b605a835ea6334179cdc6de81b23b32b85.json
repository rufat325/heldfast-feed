  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "\u3010\u9700\u8981\u767b\u5f55\u00b7\u4e3b\u529e\u65b9\u3011\u4ec5DRAFT\u914d\u7f6e\uff0c\u5f00\u653e\u540e\u51bb\u7ed3\u3002\u9ed8\u8ba4\u9884\u89c8\uff0c\u786e\u8ba4\u89c4\u5219/\u8981\u6c42/\u5956\u9879/\u6570\u91cf/\u7b7e\u5230\u8981\u6c42\u540e\u540c\u53c2+previewHash\u3001consent=true\u3001preview=false\u4fdd\u5b58\u3002CDKey\u5e93\u5b58\u672c\u4ebaApp\u914d\u7f6e\uff0c\u52ff\u7ed9\u6a21\u578b\uff1b\u53ef\u4fdd\u7559\u65e2\u6709\u5e93\u5b58\uff0c\u5b9e\u7269\u5956\u53ef\u76f4\u63a5\u914d\u7f6e\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activityRef": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "config": {
    "additionalProperties": false,
    "properties": {
     "prizes": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "cdkeys": {
         "items": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
         },
         "maxItems": 500,
         "type": "array"
        },
        "description": {
         "maxLength": 2000,
         "type": "string"
        },
        "id": {
         "$ref": "#/properties/config/properties/requirements/items/properties/id"
        },
        "imageUrl": {
         "$ref": "#/properties/config/properties/requirements/items/properties/imageUrl"
        },
        "kind": {
         "enum": [
          "PHYSICAL",
          "CDKEY"
         ],
         "type": "string"
        },
        "level": {
         "maxLength": 40,
         "minLength": 1,
         "type": "string"
        },
        "name": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "quantity": {
         "maximum": 500,
         "minimum": 1,
         "type": "integer"
        },
        "redemptionInstructions": {
         "maxLength": 2000,
         "type": "string"
        }
       },
       "required": [
        "id",
        "level",
        "name",
        "description",
        "imageUrl",
        "kind",
        "quantity",
        "redemptionInstructions"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "requireAppCheckin": {
      "type": "boolean"
     },
     "requirements": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "description": {
         "maxLength": 1000,
         "type": "string"
        },
        "id": {
         "pattern": "^[a-zA-Z0-9_-]{1,64}$",
         "type": "string"
        },
        "imageUrl": {
         "anyOf": [
          {
           "format": "uri",
           "maxLength": 2048,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "title": {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "id",
        "title",
        "description",
        "imageUrl"
       ],
       "type": "object"
      },
      "maxItems": 6,
      "type": "array"
     },
     "rules": {
      "maxLength": 2000,
      "type": "string"
     },
     "title": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "title",
     "rules",
     "requireAppCheckin",
     "requirements",
     "prizes"
    ],
    "type": "object"
   },
   "consent": {
    "const": true,
    "type": "boolean"
   },
   "preview": {
    "default": true,
    "type": "boolean"
   },
   "previewHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "activityRef",
   "config"
  ],
  "type": "object"
 },
 "name": "configure_activity_raffle",
 "title": "\u914d\u7f6e\u6d3b\u52a8\u62bd\u5956\u8349\u7a3f"
}
