    "default": "all",
    "enum": [
     "all",
     "striking"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "period": {
    "anyOf": [
     {
      "const": "today",
      "type": "string"
     },
     {
      "const": "7d",
      "type": "string"
     },
     {
      "const": "30d",
      "type": "string"
     },
     {
      "const": "90d",
      "type": "string"
     },
     {
      "maximum": 365,
      "minimum": 1,
      "type": "integer"
     }
    ],
    "default": "30d"
   },
   "site_id": {
    "format": "uuid",
    "type": "string"
   }
  },
  "type": "object"
 },
