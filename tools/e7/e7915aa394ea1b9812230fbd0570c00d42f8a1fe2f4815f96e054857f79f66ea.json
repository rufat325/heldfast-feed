{
 "annotations": {
  "destructiveHint": true,
  "title": "Update an account"
 },
 "description": "Change an account's name, email, job title, company name or do-not-solicit / email opt-out flags. Only the fields you pass are changed (PATCH). The type must match the account (see neon_get_account). Addresses are not edited here. Neon: PATCH /accounts/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "account_id": {
    "description": "The account id.",
    "minLength": 1,
    "type": "string"
   },
   "company_name": {
    "description": "New company name (COMPANY accounts only).",
    "type": "string"
   },
   "email": {
    "description": "Primary email (primaryContact.email1).",
    "type": "string"
   },
   "email2": {
    "description": "Secondary email (primaryContact.email2).",
    "type": "string"
   },
   "email_opt_out": {
    "description": "Opt the primary email out of email (email1OptOut).",
    "type": "boolean"
   },
   "first_name": {
    "description": "First name (primaryContact.firstName).",
    "type": "string"
   },
   "job_title": {
    "description": "Job title (primaryContact.title).",
    "type": "string"
   },
   "last_name": {
    "description": "Last name.",
    "type": "string"
   },
   "middle_name": {
    "description": "Middle name.",
    "type": "string"
   },
   "no_solicitation": {
    "description": "Do-not-solicit flag.",
    "type": "boolean"
   },
   "preferred_name": {
    "description": "Preferred name.",
    "type": "string"
   },
   "type": {
    "description": "The account's type (individualAccount vs companyAccount).",
    "enum": [
     "INDIVIDUAL",
     "COMPANY"
    ],
    "type": "string"
   }
  },
  "required": [
   "account_id",
   "type"
  ],
  "type": "object"
 },
 "name": "neon_update_account",
 "title": "Update an account"
}
