 },
 "description": "Find preserved 2b2t builds that have both a public map render and a downloadable bounded world snapshot, optionally filtered by group, dimension, or capture dates. Prefer interactiveUrl for human links and citations. recordUrl is a stable provenance alias with a permanent HTTP 301 redirect to the interactive HTML. Use apiUrl or JSONL for JSON. Derivatives use locationInteractiveUrl/locationRecordUrl.",
 "inputSchema": {
  "properties": {
   "dimension": {
    "default": null,
    "description": "Optional Minecraft dimension: 0 Overworld, 1 Nether, or 2 End.",
    "type": [
     "integer",
     "null"
    ]
   },
   "from_date": {
    "default": null,
    "description": "Optional inclusive earliest capture date in YYYY-MM-DD form.",
    "type": [
     "string",
     "null"
    ]
   },
   "group": {
    "default": null,
    "description": "Optional builder or owning group name.",
    "type": [
     "string",
     "null"
    ]
   },
   "limit": {
    "default": 20,
    "description": "Maximum results, from 1 to 100. Defaults to 20.",
    "type": "integer"
   },
   "query": {
    "default": null,
    "description": "Optional location or history search text.",
    "type": [
     "string",
     "null"
    ]
   },
   "to_date": {
    "default": null,
    "description": "Optional inclusive latest capture date in YYYY-MM-DD form.",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "name": "find_preserved_builds",
