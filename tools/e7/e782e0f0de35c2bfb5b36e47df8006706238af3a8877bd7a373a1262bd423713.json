{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update contact"
 },
 "description": "Update an existing contact by email address, including changing subscription status. Setting status to unsubscribed immediately excludes them from every future campaign. Does not support tags, phone, company, or job title \u2014 the API has no fields for them.",
 "inputSchema": {
  "properties": {
   "custom_fields": {
    "description": "Custom key-value attributes to merge",
    "type": "object"
   },
   "email": {
    "description": "Email address identifying the contact",
    "type": "string"
   },
   "first_name": {
    "description": "First name",
    "type": "string"
   },
   "last_name": {
    "description": "Last name",
    "type": "string"
   },
   "status": {
    "description": "New subscription status",
    "enum": [
     "subscribed",
     "unsubscribed",
     "bounced",
     "complained"
    ],
    "type": "string"
   }
  },
  "required": [
   "email"
  ],
  "type": "object"
 },
 "name": "update_contact"
}
