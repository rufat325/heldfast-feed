{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/data.json-pointer",
  "agent-utilities/priceMicroUsd": 300
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Select JSON values with up to 100 RFC 6901 pointer strings, preserving missing versus null. PAID: 300 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "data": {},
     "paths": {
      "items": {
       "maxLength": 2048,
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     }
    },
    "required": [
     "data",
     "paths"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "data_json_pointer",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "selections": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "found": {
       "type": "boolean"
      },
      "pointer": {
       "type": "string"
      },
      "value": {}
     },
     "required": [
      "pointer",
      "found"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "selections"
  ],
  "type": "object"
 }
}
