 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create agent"
 },
 "description": "Without sign-in: create one unclaimed, zero-cost agent from a manifest or template (hosted or external runtime only, budget 0). Needs idempotency_key unless dry_run. Returns claim_token/claim_url so a person can claim it later, the Agent Card URL and, for external runtimes, a single-use enrollment_code.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capability": {
    "enum": [
     "research",
     "extract",
     "verify"
    ],
    "type": "string"
   },
   "description": {
    "maxLength": 300,
    "type": "string"
   },
   "dry_run": {
    "description": "Plan only: validate and return the plan without creating anything.",
    "type": "boolean"
   },
   "idempotencyKey": {
    "description": "Stable caller-chosen key; retry with the same key and unchanged arguments.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "idempotency_key": {
    "description": "Stable caller-chosen key; retry with the same key and unchanged arguments.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "manifest": {
    "additionalProperties": {},
    "description": "A centralcity.agent/v1 manifest (kind Agent or Team). See docs/AGENT_MANIFEST.md; list templates with city_list_templates.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "mode": {
    "enum": [
     "hosted",
     "external"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "overrides": {
    "additionalProperties": false,
    "description": "Manifest fields merged over the template. Set metadata.name to create a distinct agent from the same template.",
    "properties": {
     "metadata": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "spec": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "parent_agent_id": {
    "description": "Optional existing agent to create under (lineage for cascade revoke). Not available anonymously.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "template": {
    "description": "Built-in template reference, for example template:research-team@1.0.0.",
    "maxLength": 128,
    "pattern": "^template:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?@\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$",
    "type": "string"
   }
  },
  "type": "object"
 },
