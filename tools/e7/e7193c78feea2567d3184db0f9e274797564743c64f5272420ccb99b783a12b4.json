{
 "_meta": {
  "ui": {
   "resourceUri": "ui://agent-manager.dev/docs-browser"
  }
 },
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search every page of agent-manager.dev by title, description and section. Returns page summaries with the slug get_doc_page takes. Use this first when you do not already know which page answers the question.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "How many results to return.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "What to search for, such as \"review mode\" or \"install\".",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_docs",
 "outputSchema": {
  "$defs": {
   "page": {
    "properties": {
     "description": {
      "type": "string"
     },
     "markdown_url": {
      "type": "string"
     },
     "section": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "title",
     "url"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "count": {
    "type": "integer"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "$ref": "#/$defs/page"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "count",
   "results"
  ],
  "type": "object"
 },
 "title": "Search the agent-manager documentation"
}
