{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run TRHTR recognition using a specific model in a collection.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allowConcurrentExecution": {
    "default": false,
    "description": "Allow concurrent execution",
    "type": "boolean"
   },
   "b2pBackend": {
    "default": "Legacy",
    "description": "B2P backend type",
    "type": "string"
   },
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "credits": {
    "default": "AUTO",
    "description": "Credits parameter",
    "type": "string"
   },
   "doLinePolygonSimplification": {
    "default": true,
    "description": "Simplify line polygons",
    "type": "boolean"
   },
   "doNotDeleteWorkDir": {
    "default": false,
    "description": "Do not delete work directory",
    "type": "boolean"
   },
   "id": {
    "description": "Document ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "modelId": {
    "description": "Model/HTR ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "modelName": {
    "description": "Model name",
    "type": "string"
   },
   "pages": {
    "description": "Page range (e.g. \"1-5\")",
    "type": "string"
   },
   "useExistingLinePolygons": {
    "default": false,
    "description": "Use existing line polygons",
    "type": "boolean"
   }
  },
  "required": [
   "collId",
   "modelId"
  ],
  "type": "object"
 },
 "name": "transkribus_recog_run_trhtr",
 "title": "Run TRHTR"
}
