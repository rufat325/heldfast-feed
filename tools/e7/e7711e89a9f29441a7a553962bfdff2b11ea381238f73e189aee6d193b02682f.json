     "mostGithubStars",
     "hasTypeScriptSupport",
     "hasKnownVulnerabilities",
     "deprecated",
     "possibleTyposquat",
     "installScriptRiskFlagged",
     "smallestInstallSize",
     "largestInstallSize"
