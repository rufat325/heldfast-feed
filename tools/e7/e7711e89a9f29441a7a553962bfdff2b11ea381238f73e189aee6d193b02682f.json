       "null"
      ]
     },
     "mostDownloads": {
      "type": [
       "string",
       "null"
      ]
     },
     "mostGithubStars": {
      "type": [
       "string",
       "null"
      ]
     },
     "possibleTyposquat": {
      "items": {
       "type": "string"
      },
      "type": "array"
