{
 "annotations": {
  "readOnlyHint": true,
  "title": "Find patients"
 },
 "description": "Search for patients by demographics. FHIR: GET /Patient?given=&family=&birthdate=&identifier=. Returns a FHIR searchset Bundle. Use the returned Patient id with the other tools.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "_count": {
    "description": "FHIR _count \u2014 max results per page.",
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "integer"
   },
   "birthdate": {
    "description": "Date of birth, yyyy-mm-dd.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "family": {
    "description": "Family (last) name.",
    "type": "string"
   },
   "given": {
    "description": "Given (first) name.",
    "type": "string"
   },
   "identifier": {
    "description": "Business identifier (e.g. MRN), optionally system|value.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "healthgorilla_find_patients",
 "title": "Find patients"
}
