{
 "description": "Create a temporary shareable URL for a markdown document preview. The URL expires after the specified duration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expiresIn": {
    "description": "How long the link stays active (default: 24h)",
    "enum": [
     "1h",
     "4h",
     "24h",
     "7d"
    ],
    "type": "string"
   },
   "markdown": {
    "description": "The markdown content to share",
    "type": "string"
   },
   "theme": {
    "description": "Theme name",
    "type": "string"
   },
   "title": {
    "description": "Document title",
    "type": "string"
   }
  },
  "required": [
   "markdown"
  ],
  "type": "object"
 },
 "name": "share_live_preview"
}
