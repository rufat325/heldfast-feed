{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Forward an email message to new recipients, including attachments and inline images.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Optional message to add above the forwarded content",
    "type": "string"
   },
   "from": {
    "description": "Sender email address (for send-as aliases)",
    "type": "string"
   },
   "id": {
    "description": "The ID of the message to forward",
    "type": "string"
   },
   "to": {
    "description": "Recipient email address(es), comma-separated for multiple",
    "type": "string"
   }
  },
  "required": [
   "id",
   "to"
  ],
  "type": "object"
 },
 "name": "message_forward",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "labelIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "threadId": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "threadId"
  ],
  "type": "object"
 },
 "title": "Forward message"
}
