{
 "description": "Sort lines of text. Supports asc/desc, case-insensitive, locale-aware collation, natural-sort (line2 before line10), dedupe, line-trim and empty-line drop.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "case_sensitive": {
    "default": true,
    "type": "boolean"
   },
   "dedupe": {
    "default": false,
    "type": "boolean"
   },
   "drop_empty": {
    "default": false,
    "type": "boolean"
   },
   "locale": {
    "type": "string"
   },
   "natural": {
    "default": false,
    "type": "boolean"
   },
   "order": {
    "default": "asc",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "trim_lines": {
    "default": false,
    "type": "boolean"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "sort_lines"
}
