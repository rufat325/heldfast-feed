{"_meta":{"securitySchemes":[{"type":"noauth"},{"scopes":["openid","email"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true,"title":"Get modeler notes"},"description":"Device knowledge for one modeler: its five 'read this first' truths, its fixes (symptom, kind = fault or documented behaviour, causes in likelihood order, each with its fix), and assistant-only notes on how users commonly misread it. Every item carries a gridleak.app URL, source ids and a reliability tier (measured, official, retail, press, community, unverified); `sources` resolves the ids to labels and URLs. Use it when a user is stuck on, confused by, or deciding about one of these modelers.","examples":[{"device":"helix-floor"},{"device":"hx-stomp","topic":"fixes"},{"device":"Quad Cortex","topic":"scenes"}],"inputSchema":{"properties":{"device":{"description":"Modeler slug from list_devices (e.g. 'helix-floor', 'hx-stomp', 'axe-fx-ii', 'quad-cortex') or its name ('Axe-Fx II', 'HX Stomp XL').","type":"string"},"topic":{"description":"Optional. 'truths', 'fixes' or 'agent_notes' returns one section; any other text keeps only items containing every word (e.g. 'snapshots', 'usb audio').","type":"string"}},"required":["device"],"type":"object"},"name":"get_device_notes","outputSchema":{"$defs":{"DeviceCard":{"additionalProperties":true,"properties":{"family":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Family"},"firmware":{"default":null,"title":"Firmware"},"form":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Form"},"installs":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Installs"},"maker":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Maker"},"name":{"title":"Name","type":"string"},"preset_device":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Preset Device"},"slug":{"title":"Slug","type":"string"},"tabs":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"title":"Tabs"},"url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Url"}},"required":["slug","name"],"title":"DeviceCard","type":"object"},"Provenance":{"additionalProperties":true,"description":"Where an answer comes from (api/knowledge/envelope.make).","properties":{"basis":{"enum":["measured","derived_from_circuit","synthesised","catalog_record","unknown"],"title":"Basis","type":"string"},"last_checked":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Last Checked"},"record_id":{"title":"Record Id","type":"string"},"record_url":{"title":"Record Url","type":"string"},"verification":{"enum":["schematic_verified","catalog_verified","unverified"],"title":"Verification","type":"string"}},"required":["record_id","record_url","verification","basis"],"title":"Provenance","type":"object"}},"additionalProperties":true,"description":"get_device_notes: one modeler's truths, fixes and agent notes, or the unknown-modeler answer.","properties":{"agent_notes":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"title":"Agent Notes"},"counts":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"title":"Counts"},"device":{"anyOf":[{"$ref":"#/$defs/DeviceCard"},{"type":"null"}],"default":null},"devices_url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Devices Url"},"error":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Error"},"fixes":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"title":"Fixes"},"hint":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Hint"},"how_to_cite":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"How To Cite"},"known_devices":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"title":"Known Devices"},"provenance":{"$ref":"#/$defs/Provenance"},"sources":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"title":"Sources"},"topic":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"title":"Topic"},"truths":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"title":"Truths"}},"required":["provenance"],"title":"DeviceNotesAnswer","type":"object"},"securitySchemes":[{"type":"noauth"},{"scopes":["openid","email"],"type":"oauth2"}],"title":"Get modeler notes"}
