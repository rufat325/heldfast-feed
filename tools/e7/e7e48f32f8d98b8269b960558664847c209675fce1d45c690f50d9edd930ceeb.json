{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create 1-10 databases atomically (POST /mysql/v1/clusters/{clusterName}/databases/batch-create \u2192 202 Operation).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clusterName": {
    "description": "Cluster name (3-30 chars, lowercase letters/digits/'-', no leading or trailing '-'; immutable after creation)",
    "pattern": "^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$",
    "type": "string"
   },
   "names": {
    "description": "Database names (1-10)",
    "items": {
     "pattern": "^[A-Za-z0-9_]{1,64}$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "clusterName",
   "names"
  ],
  "type": "object"
 },
 "name": "ncloud_serverless_batch_create_databases"
}
