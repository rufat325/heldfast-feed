{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Publish a clip immediately to a connected social account. For X (formerly Twitter) each post costs 1 credit. Returns a `postId`. The clip is queued for upload by Opus to the destination platform.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clipId": {
    "description": "Curation ID (e.g. \"CU67da38\"), NOT the full clip id.",
    "minLength": 1,
    "type": "string"
   },
   "postAccountId": {
    "description": "From opus_get_social_accounts.postAccountId",
    "minLength": 1,
    "type": "string"
   },
   "postDetail": {
    "additionalProperties": false,
    "properties": {
     "custom": {
      "additionalProperties": false,
      "properties": {
       "description": {
        "type": "string"
       },
       "privacy": {
        "description": "YouTube privacy setting",
        "enum": [
         "public",
         "private",
         "unlisted"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "mediaType": {
      "description": "Media type \u2014 supported values depend on the platform (typically \"video\")",
      "type": "string"
     },
     "title": {
      "description": "Title of the post",
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "title"
    ],
    "type": "object"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   },
   "subAccountId": {
    "description": "Required for Facebook pages, Instagram business accounts, and LinkedIn \u2014 from opus_get_social_accounts.subAccountId.",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "clipId",
   "postAccountId",
   "postDetail"
  ],
  "type": "object"
 },
 "name": "opus_publish_post"
}
