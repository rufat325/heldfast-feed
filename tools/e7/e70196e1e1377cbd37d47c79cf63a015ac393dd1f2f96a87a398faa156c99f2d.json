   },
   "offset": {
    "description": "Rows to skip, default 0",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "role": {
    "description": "Restrict to a single role",
    "enum": [
     "owner",
     "admin",
     "moderator",
     "member"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "hivelearn_list_members"
