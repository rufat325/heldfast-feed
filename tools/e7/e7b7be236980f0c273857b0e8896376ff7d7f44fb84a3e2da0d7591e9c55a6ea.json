{
 "description": "Evaluate current scene for pacing issues. Helps identify when to cut or change direction. Based on the Alexandrian principle: 'Cut to the next meaningful choice.'",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "currentActivity": {
    "description": "What's happening now",
    "type": "string"
   },
   "minutesInScene": {
    "description": "Real-time minutes in scene",
    "minimum": 0,
    "type": "number"
   },
   "playerEnergy": {
    "description": "GM's read on player engagement",
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "currentActivity",
   "playerEnergy",
   "minutesInScene"
  ],
  "type": "object"
 },
 "name": "analyze_scene"
}
