 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Domain Age & Registrar (RDAP)"
 },
 "description": "Looks up a domain in its registry's RDAP server (the ICANN successor to WHOIS, found via the IANA bootstrap): registration date, age in days/years, newlyRegistered (<30 days), expiry, last change, registrar name + IANA ID, EPP status, nameservers and DNSSEC. No personal contact data. Use when an agent must judge if a domain, sender or vendor is brand-new (a phishing/fraud signal). Unsupported TLDs return 400, uncharged. $0.01 USDC. Paid tool: call it once to get the x402 PaymentRequired object, then retry with params._meta[\"x402/payment\"].",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Domain, e.g. example.com. A URL, hostname or email address is reduced to its registrable domain. Alias: name.",
    "examples": [
     "example.com"
    ],
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "whois_domain_age",
 "title": "Domain Age & Registrar (RDAP)"
}
