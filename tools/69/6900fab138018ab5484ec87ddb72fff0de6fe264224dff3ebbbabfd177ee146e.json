{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "AtlaSent \u2014 Evaluate Many"
 },
 "description": "Evaluate up to 100 actions in a single request against your published AtlaSent policies. Returns decisions in input order. Optional batch_id (UUID) provides idempotency. Closed-by-default: 404 surfaces as a `feature_not_enabled` error tagged with the `v2_batch` tenant flag.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "batch_id": {
    "description": "Optional UUID for idempotency.",
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   },
   "items": {
    "description": "Items to evaluate (1-100). Decisions returned in input order.",
    "items": {
     "properties": {
      "action": {
       "maxLength": 256,
       "minLength": 1,
       "type": "string"
      },
      "agent": {
       "maxLength": 256,
       "minLength": 1,
       "type": "string"
      },
      "context": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "action",
      "agent"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "atlasent_evaluate_many",
 "title": "AtlaSent \u2014 Evaluate Many (batch)"
}
