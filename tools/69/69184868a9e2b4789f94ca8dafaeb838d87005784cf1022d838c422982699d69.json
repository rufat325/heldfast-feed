{
 "description": "Create a new recurring task (schedule a skill to run up to 5 times daily)",
 "inputSchema": {
  "properties": {
   "daysOfWeek": {
    "description": "Days 0-6 (Sun-Sat), empty for every day",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "description": {
    "description": "Task description",
    "type": "string"
   },
   "name": {
    "description": "Task name",
    "type": "string"
   },
   "skillConfig": {
    "description": "Skill configuration (tool, args, workflowId, webhookUrl, etc.)",
    "type": "object"
   },
   "skillType": {
    "description": "Type: mcp_tool, workflow, webhook, api_call",
    "type": "string"
   },
   "times": {
    "description": "Array of HH:MM times (max 5)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timezone": {
    "description": "Timezone (default: America/New_York)",
    "type": "string"
   }
  },
  "required": [
   "name",
   "skillType",
   "times"
  ],
  "type": "object"
 },
 "name": "recurring_tasks_create"
}
