{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch OHLCV candle data for an instrument. Useful for technical analysis and historical price research.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Number of candles to return (default 10, max 1000)",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "direction": {
    "description": "Sort: 'asc' (oldest first) or 'desc' (newest first). Default: desc",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "instrumentId": {
    "description": "Instrument ID",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "period": {
    "description": "Candle period",
    "enum": [
     "OneMinute",
     "FiveMinutes",
     "TenMinutes",
     "FifteenMinutes",
     "ThirtyMinutes",
     "OneHour",
     "FourHours",
     "OneDay",
     "OneWeek"
    ],
    "type": "string"
   }
  },
  "required": [
   "instrumentId",
   "period"
  ],
  "type": "object"
 },
 "name": "etoro_get_candles",
 "title": "Get OHLCV candles"
}
