{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find GST refund guidance"
 },
 "description": "Finds Fast GST Refund's public guides by preparation topic and returns their slugs, titles and descriptions. Takes general keywords; it does not need taxpayer identifiers or document contents.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 120,
    "minLength": 2,
    "pattern": "^[a-zA-Z0-9 \\-?]+$",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_refund_guides",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "guides": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "description": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "sourcesChecked": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "title",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "guides"
  ],
  "type": "object"
 },
 "title": "Find GST refund guidance"
}
