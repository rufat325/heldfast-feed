{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Aggregates pool depth, 24h volume, spread, and pricing across DEXs on Base.",
 "inputSchema": {
  "properties": {
   "chain_id": {
    "default": "base",
    "description": "Blockchain network identifier. Defaults to 'base'.",
    "type": "string"
   },
   "token_address": {
    "description": "The EVM contract address of the ERC-20 token on Base (e.g. 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913).",
    "type": "string"
   }
  },
  "required": [
   "token_address"
  ],
  "type": "object"
 },
 "name": "dex_liquidity_router",
 "outputSchema": {
  "properties": {
   "chain": {
    "description": "Target network",
    "type": "string"
   },
   "execution_verdict": {
    "description": "Approval state for automated trade execution",
    "type": "string"
   },
   "liquidity_usd": {
    "description": "Total pool liquidity in USD",
    "type": "number"
   },
   "mev_sandwich_risk_score": {
    "description": "Sandwich risk rating from 0 to 100",
    "type": "number"
   },
   "token": {
    "description": "Target token address",
    "type": "string"
   },
   "top_pool": {
    "description": "Liquidity pool address",
    "type": "string"
   }
  },
  "required": [
   "token",
   "chain",
   "top_pool",
   "liquidity_usd",
   "mev_sandwich_risk_score",
   "execution_verdict"
  ],
  "type": "object"
 }
}
