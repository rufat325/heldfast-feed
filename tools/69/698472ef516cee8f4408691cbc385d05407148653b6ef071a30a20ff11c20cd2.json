     "sudoku",
     "games",
     "seek-and-count",
     "color-by-math",
     "secret-codes",
     "crosswords",
     "nonograms",
     "bingo",
     "logic-puzzles"
    ],
    "type": "string"
   },
   "slug": {
    "description": "Puzzle slug, for example \"farm-friends\".",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "activity",
   "slug"
  ],
  "type": "object"
