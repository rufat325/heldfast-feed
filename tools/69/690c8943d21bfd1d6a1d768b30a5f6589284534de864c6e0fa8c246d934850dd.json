{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Trace a bounded literal feature query through matching strings and procedures, xrefs, and truthful containing-procedure resolution. Returns the operation budget, truncation, and residual unknowns; unknown_registry_approved: true records them durably without inferring reference kinds.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
   {
    "case_sensitive": false,
    "limit": 20,
    "max_operations": 20,
    "query": "license"
   }
  ],
  "properties": {
   "case_sensitive": {
    "default": false,
    "description": "Whether text matching distinguishes uppercase and lowercase.",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of results to return in this page.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "max_operations": {
    "default": 20,
    "description": "Maximum permitted operations for this operation.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Non-empty feature or text query to investigate.",
    "minLength": 1,
    "type": "string"
   },
   "unknown_registry_approved": {
    "const": true,
    "description": "Explicit approval to record bounded residuals durably",
    "type": "boolean"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "trace_feature",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "matches": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "address": {
         "type": "string"
        },
        "type": {
         "enum": [
          "string",
          "procedure"
         ],
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "type",
        "address",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "operation_budget": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     "operations_used": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "query": {
      "type": "string"
     },
     "references": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "containing_procedure": {
         "oneOf": [
          {
           "additionalProperties": false,
           "properties": {
            "found": {
             "const": true,
             "type": "boolean"
            },
            "procedure": {
             "additionalProperties": false,
             "properties": {
              "address": {
               "type": "string"
              },
              "classification": {
               "anyOf": [
                {
                 "additionalProperties": false,
                 "properties": {
                  "external": {
                   "type": "boolean"
                  },
                  "provenance": {
                   "minLength": 1,
                   "type": "string"
                  },
                  "thunk": {
                   "type": "boolean"
                  },
                  "thunk_target": {
                   "anyOf": [
                    {
                     "type": "string"
                    },
                    {
                     "type": "null"
                    }
                   ]
                  }
                 },
                 "required": [
                  "external",
                  "thunk",
                  "thunk_target",
                  "provenance"
                 ],
                 "type": "object"
                },
                {
                 "type": "null"
                }
               ],
               "default": null
              },
              "name": {
               "type": "string"
              }
             },
             "required": [
              "address",
              "name",
              "classification"
             ],
             "type": "object"
            },
            "query_address": {
             "type": "string"
            }
           },
           "required": [
            "query_address",
            "found",
            "procedure"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "found": {
             "const": false,
             "type": "boolean"
            },
            "procedure": {
             "type": "null"
            },
            "query_address": {
             "type": "string"
            },
            "reason": {
             "enum": [
              "outside_segments",
              "not_in_procedure"
             ],
             "type": "string"
            }
           },
           "required": [
            "query_address",
            "found",
            "procedure",
            "reason"
           ],
           "type": "object"
          }
         ]
        },
        "source_address": {
         "type": "string"
        },
        "target_address": {
         "type": "string"
        }
       },
       "required": [
        "target_address",
        "source_address",
        "containing_procedure"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "residual_unknowns": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "search_mode": {
      "const": "literal",
      "type": "string"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "query",
     "search_mode",
     "operations_used",
     "operation_budget",
     "matches",
     "references",
     "truncated",
     "residual_unknowns"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Trace Feature"
}
