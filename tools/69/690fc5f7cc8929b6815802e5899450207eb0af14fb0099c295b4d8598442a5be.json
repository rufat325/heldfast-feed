{
 "annotations": {
  "readOnlyHint": true,
  "title": "List documents"
 },
 "description": "List invoices, quotes and contracts, with totals and payment status. Filter by type, order, customer or status. Booqable: GET /api/4/documents.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "customer_id": {
    "description": "Only documents for this customer.",
    "type": "string"
   },
   "document_type": {
    "description": "Only this document type.",
    "enum": [
     "invoice",
     "quote",
     "contract"
    ],
    "type": "string"
   },
   "include": {
    "description": "Comma-separated relationships to sideload, e.g. customer,order.",
    "type": "string"
   },
   "order_id": {
    "description": "Only documents for this order.",
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based). Default 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Results per page, 1-100 (Booqable default 25).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Free-text search.",
    "type": "string"
   },
   "sort": {
    "description": "Sort, comma-separated attributes; prefix with - for descending, e.g. -created_at.",
    "type": "string"
   },
   "status": {
    "description": "Only documents in this status (values depend on document type).",
    "enum": [
     "confirmed",
     "unconfirmed",
     "revised",
     "partially_paid",
     "payment_due",
     "paid",
     "process_deposit",
     "overpaid"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "booqable_list_documents",
 "title": "List documents"
}
