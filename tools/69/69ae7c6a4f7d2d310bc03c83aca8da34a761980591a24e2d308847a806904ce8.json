{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Dated, sourced reporting on moving to and retiring in Italy, newest first. Filter by topic, by place (a comune's ISTAT code) or by dataset slug. Each entry has its URL, a Markdown URL for the full text, and the places and datasets it cites. Content is free to use provided you credit Expat Living Italy and link to the article.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dataset": {
    "description": "A dataset slug from GET /datasets.",
    "type": "string"
   },
   "include": {
    "description": "Pass `archived` to include archived articles, flagged by `status`.",
    "enum": [
     "archived"
    ],
    "type": "string"
   },
   "place": {
    "description": "A comune's 6-digit ISTAT code (or a province sigla / region slug).",
    "type": "string"
   },
   "topic": {
    "description": "One of: tax, residency-visas, costs-housing, healthcare, places, daily-life, data-method.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_articles",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "articles": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": "string"
      },
      "datasets": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "coverage": {
          "description": "How much of the place set the data covers, as the article states it.",
          "type": "string"
         },
         "slug": {
          "description": "The dataset's slug in GET /datasets, when the page is one of them.",
          "type": "string"
         },
         "title": {
          "type": "string"
         },
         "url": {
          "type": "string"
         },
         "vintage": {
          "type": "string"
         }
        },
        "required": [
         "title",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "deck": {
       "type": "string"
      },
      "markdownUrl": {
       "description": "The whole article as Markdown, with its citation at both ends.",
       "type": "string"
      },
      "places": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "code": {
          "description": "ISTAT code for a comune, sigla for a province, slug for a region.",
          "type": "string"
         },
         "grain": {
          "enum": [
           "comune",
           "province",
           "region"
          ],
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "grain",
         "code",
         "name",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "published": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "status": {
       "enum": [
        "published",
        "archived"
       ],
       "type": "string"
      },
      "supersededBy": {
       "description": "Slug of the newer article that replaces this one.",
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "topics": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "updated": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "title",
      "deck",
      "author",
      "published",
      "updated",
      "status",
      "topics",
      "url",
      "markdownUrl",
      "places",
      "datasets"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "attribution": {
    "additionalProperties": false,
    "properties": {
     "citeAs": {
      "description": "Per article: \"\u201c<title>\u201d by <author>, Expat Living Italy, <date>. <url>\".",
      "type": "string"
     },
     "creditText": {
      "type": "string"
     },
     "license": {
      "additionalProperties": false,
      "properties": {
       "name": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "url"
      ],
      "type": "object"
     },
     "required": {
      "const": true,
      "description": "Credit with a link is the condition of free use (CC BY 4.0).",
      "type": "boolean"
     },
     "requirement": {
      "type": "string"
     }
    },
    "required": [
     "required",
     "license",
     "creditText",
     "requirement",
     "citeAs"
    ],
    "type": "object"
   }
  },
  "required": [
   "articles",
   "attribution"
  ],
  "type": "object"
 },
 "title": "List Expat Living Italy's articles"
}
