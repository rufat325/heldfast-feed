     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     }
    ]
   },
   "format": {
    "enum": [
     "json",
     "csv"
    ]
   },
   "fuel_type": {
    "oneOf": [
     {
      "maxLength": 80,
