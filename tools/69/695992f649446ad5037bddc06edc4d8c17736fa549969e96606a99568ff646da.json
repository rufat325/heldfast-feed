    "maximum": 99999999.99,
    "minimum": 0,
    "type": "number"
   },
   "price_min": {
    "description": "Minimum expiry-gated effective price.",
    "maximum": 99999999.99,
    "minimum": 0,
    "type": "number"
   },
   "radius_miles": {
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "number"
   },
   "rooftop_slugs": {
    "description": "Restrict the single-snapshot aggregation to these network rooftops.",
    "items": {
     "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   },
   "transmission": {
    "oneOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     }
    ]
   },
   "trim": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
