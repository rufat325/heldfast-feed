{
 "description": "Generate reusable AI visibility prompts for ChatGPT, Perplexity, Google AI Mode, and similar answer engines.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "description": "Target audience. Defaults to buyers.",
    "type": "string"
   },
   "brand": {
    "description": "Brand/entity name.",
    "type": "string"
   },
   "category": {
    "description": "Product, service, or market category.",
    "type": "string"
   },
   "competitors": {
    "description": "Competitor names for comparison prompts.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "format": {
    "description": "Output format. Defaults to json.",
    "enum": [
     "csv",
     "json",
     "markdown"
    ],
    "type": "string"
   },
   "location": {
    "description": "Location for local-intent prompts. Defaults to the United States.",
    "type": "string"
   },
   "pains": {
    "description": "Customer problems for problem-intent prompts.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "surface": {
    "description": "AI surfaces to track. Defaults to ChatGPT, Perplexity, Google AI Mode.",
    "type": "string"
   }
  },
  "required": [
   "brand",
   "category"
  ],
  "type": "object"
 },
 "name": "prompt_matrix"
}
