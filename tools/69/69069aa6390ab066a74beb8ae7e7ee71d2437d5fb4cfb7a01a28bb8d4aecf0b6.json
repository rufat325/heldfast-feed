{
 "description": "Get race-by-race results for a driver. Timing fields (gap, finish time) are only returned for Developer and Custom accounts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "driverId": {
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "season": {
    "description": "Filter to a specific season year, e.g. 2026.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "driverId"
  ],
  "type": "object"
 },
 "name": "get_driver_results"
}
