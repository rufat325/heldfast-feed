{
 "annotations": {
  "readOnlyHint": true,
  "title": "List videos"
 },
 "description": "List videos in the account, with optional filters (title, tags, metadata, description, liveStreamId) and sorting. Read-only. GET /videos.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currentPage": {
    "description": "Page number (1-based). Default 1.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "description": {
    "description": "Filter by description (substring).",
    "type": "string"
   },
   "liveStreamId": {
    "description": "Return only videos recorded from this live stream id.",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Filter by metadata key/value pairs. Sent as metadata[key]=value.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "pageSize": {
    "description": "Results per page (max 100). Default 25.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "sortBy": {
    "description": "Field to sort by.",
    "enum": [
     "title",
     "createdAt",
     "publishedAt",
     "updatedAt"
    ],
    "type": "string"
   },
   "sortOrder": {
    "description": "Sort direction.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Filter by tags (all must match). Sent as tags[].",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Filter by video title (substring).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "apivideo_list_videos",
 "title": "List videos"
}
