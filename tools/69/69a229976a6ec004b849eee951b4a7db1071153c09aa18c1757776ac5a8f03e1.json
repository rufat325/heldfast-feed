{
 "_meta": {
  "openai/outputTemplate": "ui://bsd/customer-cards-v3.html",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "history.read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://bsd/customer-cards-v3.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show betting History"
 },
 "description": "Show the connected account\u2019s recorded profit/loss chart and actual win/loss counts. Requires currency and settlement source; never combine currencies or sources. Range/filter controls use the same app services. Missing results remain marked.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "advice": {
    "default": "all",
    "enum": [
     "all",
     "unknown",
     "unseen",
     "viewed",
     "followed",
     "modified",
     "rejected"
    ],
    "type": "string"
   },
   "adviceBasis": {
    "default": "current_response",
    "enum": [
     "current_response",
     "recorded_before_placement"
    ],
    "type": "string"
   },
   "bookId": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9_.:@/-]+$",
    "type": "string"
   },
   "currency": {
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "graded": {
    "default": "all",
    "enum": [
     "all",
     "yes",
     "no"
    ],
    "type": "string"
   },
   "league": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9_.:@/-]+$",
    "type": "string"
   },
   "range": {
    "default": "1m",
    "enum": [
     "1w",
     "1m",
     "3m",
     "1y",
     "ytd",
     "all"
    ],
    "type": "string"
   },
   "recordKind": {
    "default": "all",
    "enum": [
     "all",
     "import",
     "manual"
    ],
    "type": "string"
   },
   "result": {
    "default": "all",
    "enum": [
     "all",
     "open",
     "win",
     "loss",
     "push",
     "void",
     "cashout",
     "halfwin",
     "halfloss",
     "unknown"
    ],
    "type": "string"
   },
   "search": {
    "default": "",
    "maxLength": 128,
    "type": "string"
   },
   "source": {
    "enum": [
     "sportsbook_record",
     "provider_autograde",
     "self_reported"
    ],
    "type": "string"
   }
  },
  "required": [
   "currency",
   "source"
  ],
  "type": "object"
 },
 "name": "show_betting_history",
 "securitySchemes": [
  {
   "scopes": [
    "history.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Show betting History"
}
