{
 "description": "Uninstall a package from the device",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "keepData": {
    "default": false,
    "description": "Keep app data and cache (-k flag)",
    "type": "boolean"
   },
   "packageName": {
    "description": "Package name (e.g., 'com.example.app')",
    "type": "string"
   }
  },
  "required": [
   "packageName"
  ],
  "type": "object"
 },
 "name": "adb_uninstall"
}
