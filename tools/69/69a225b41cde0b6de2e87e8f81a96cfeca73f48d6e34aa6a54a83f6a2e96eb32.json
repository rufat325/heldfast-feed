{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Decision Evidence"
 },
 "description": "Attach quantitative or qualitative evidence to an existing decision.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confidence": {
    "description": "Confidence from 0 to 1.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "confounds": {
    "default": [],
    "description": "Known factors that may confound the result.",
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "decision_id": {
    "description": "Existing decision node id.",
    "minLength": 1,
    "type": "string"
   },
   "result_summary": {
    "description": "Concise summary of the evidence result.",
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "source_ref": {
    "description": "URL, experiment name, ticket, or transcript reference.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Evidence type.",
    "enum": [
     "quant",
     "qual"
    ],
    "type": "string"
   }
  },
  "required": [
   "decision_id",
   "type",
   "source_ref",
   "result_summary",
   "confidence"
  ],
  "type": "object"
 },
 "name": "decision_evidence"
}
