{
 "description": "Create a visit note for a patient in the PointCare EMR system.\n\nThis tool documents a home health visit including vital signs, assessment, and care plan. Use search_patient first to get the patient ID.\n\nRequired fields: patientId, visitType, visitDate, timeIn, timeOut\nRecommended fields: vitalSigns, subjective, objective, assessment, plan",
 "inputSchema": {
  "properties": {
   "assessment": {
    "description": "Clinical assessment and interpretation of findings",
    "type": "string"
   },
   "education": {
    "description": "Patient education topics covered",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "interventions": {
    "description": "List of interventions performed during visit",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "nextVisitDate": {
    "description": "Scheduled next visit date (YYYY-MM-DD)",
    "type": "string"
   },
   "notes": {
    "description": "Additional notes or comments",
    "type": "string"
   },
   "objective": {
    "description": "Nurse's observations and physical assessment findings",
    "type": "string"
   },
   "patientId": {
    "description": "Patient ID from search_patient (e.g., PT-10001)",
    "type": "string"
   },
   "patientResponse": {
    "description": "How patient responded to care/interventions",
    "type": "string"
   },
   "plan": {
    "description": "Care plan and next steps",
    "type": "string"
   },
   "subjective": {
    "description": "Patient's reported symptoms, concerns, and statements",
    "type": "string"
   },
   "timeIn": {
    "description": "Time nurse arrived (HH:MM format, 24-hour)",
    "type": "string"
   },
   "timeOut": {
    "description": "Time nurse departed (HH:MM format, 24-hour)",
    "type": "string"
   },
   "visitDate": {
    "description": "Date of visit (YYYY-MM-DD format)",
    "type": "string"
   },
   "visitType": {
    "description": "Type of visit",
    "enum": [
     "skilled_nursing",
     "physical_therapy",
     "occupational_therapy",
     "speech_therapy",
     "home_health_aide",
     "social_work",
     "initial_assessment",
     "recertification",
     "discharge",
     "other"
    ],
    "type": "string"
   },
   "vitalSigns": {
    "description": "Vital signs recorded during visit",
    "properties": {
     "bloodPressureDiastolic": {
      "description": "Diastolic BP (mmHg)",
      "type": "number"
     },
     "bloodPressureSystolic": {
      "description": "Systolic BP (mmHg)",
      "type": "number"
     },
     "heartRate": {
      "description": "Heart rate (bpm)",
      "type": "number"
     },
     "oxygenSaturation": {
      "description": "O2 saturation (%)",
      "type": "number"
     },
     "painLevel": {
      "description": "Pain level (0-10)",
      "type": "number"
     },
     "respiratoryRate": {
      "description": "Respiratory rate (breaths/min)",
      "type": "number"
     },
     "temperature": {
      "description": "Temperature",
      "type": "number"
     },
     "temperatureUnit": {
      "description": "Temperature unit",
      "enum": [
       "F",
       "C"
      ],
      "type": "string"
     },
     "weight": {
      "description": "Weight",
      "type": "number"
     },
     "weightUnit": {
      "description": "Weight unit",
      "enum": [
       "lbs",
       "kg"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "patientId",
   "visitType",
   "visitDate",
   "timeIn",
   "timeOut"
  ],
  "type": "object"
 },
 "name": "create_visit_note"
}
