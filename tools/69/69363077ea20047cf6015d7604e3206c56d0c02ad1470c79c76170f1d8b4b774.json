{
 "description": "Upload a file to the CRM media library. Provide a hosted URL or file data. Max 25MB.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "file_url": {
    "description": "URL of the file to upload",
    "type": "string"
   },
   "folder_id": {
    "description": "Parent folder ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM location ID",
    "type": "string"
   },
   "name": {
    "description": "File name",
    "type": "string"
   }
  },
  "required": [
   "location_id",
   "file_url",
   "name"
  ],
  "type": "object"
 },
 "name": "crm_media_upload"
}
