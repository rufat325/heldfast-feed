{
 "_legacy": {
  "bucket": "checkout",
  "successor": "https://api.trusteed.xyz/demo-store/mcp/checkout"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Retrieve a UCP checkout session by ID. Returns the current state of the checkout. Use ONLY for a checkout session created with ucp_create_checkout (Universal Commerce Protocol); for the standard flow (create_cart, preview_checkout, complete_checkout) do not call this tool. Checkout guide: read the MCP resource trusteed://guides/checkout.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "agent_key": {
    "description": "Sandbox credential from `create_sandbox_key`. Use this when your client cannot set an `Authorization: Bearer` header.",
    "type": "string"
   },
   "checkout_id": {
    "description": "UCP checkout session ID (valid UUID)",
    "type": "string"
   },
   "meta": {
    "description": "UCP request metadata. meta['ucp-agent'].profile = URL of the platform profile; it must be an https URL without credentials (at most 2048 characters)."
   }
  },
  "required": [
   "checkout_id"
  ],
  "type": "object"
 },
 "name": "ucp_get_checkout",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "approval_url": {
    "type": "string"
   },
   "created_at": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "expires_at": {
    "description": "ISO-8601 UTC instant at which this checkout SESSION stops being usable. It is not a stock reservation and not a price guarantee.",
    "type": "string"
   },
   "expires_in_seconds": {
    "description": "Whole seconds left on this checkout SESSION at response time (0 when already past). It is not a stock reservation and not a price guarantee.",
    "minimum": 0,
    "type": "integer"
   },
   "extensions": {
    "additionalProperties": {},
    "description": "`warnings[]` with `code`, `message`, `severity`.",
    "type": "object"
   },
   "fulfillment": {
    "additionalProperties": {},
    "type": "object"
   },
   "id": {
    "type": "string"
   },
   "idempotency_key": {
    "type": "string"
   },
   "intent": {
    "additionalProperties": {},
    "type": "object"
   },
   "label": {
    "type": "string"
   },
   "line_items": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "id": {
       "type": "string"
      },
      "price": {
       "additionalProperties": true,
       "properties": {
        "amount": {
         "type": "number"
        },
        "currency": {
         "type": "string"
        }
       },
       "required": [
        "amount",
        "currency"
       ],
       "type": "object"
      },
      "product_id": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "variant_id": {
       "type": "string"
      },
      "variant_title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "product_id",
      "title",
      "quantity",
      "price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_action": {
    "additionalProperties": {},
    "description": "Only when a person must approve or pay: `url`, `kind`, `retry`.",
    "type": "object"
   },
   "next_step": {
    "description": "Next-action code, not a tool name: provide_shipping_destination, refresh_shipping_rates, choose_shipping_option, preview_ucp_checkout, review_not_available_in_ucp.",
    "type": "string"
   },
   "next_step_message": {
    "type": "string"
   },
   "payment_options": {
    "description": "When present, ask the person which option they want; never choose for them.",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "incomplete",
     "requires_escalation",
     "ready_for_complete",
     "complete_in_progress",
     "completed",
     "canceled"
    ],
    "type": "string"
   },
   "totals": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "amount": {
       "type": "number"
      },
      "currency": {
       "type": "string"
      },
      "label": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "amount",
      "currency"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "updated_at": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "status",
   "currency",
   "line_items",
   "totals",
   "created_at",
   "updated_at"
  ],
  "type": "object"
 }
}
