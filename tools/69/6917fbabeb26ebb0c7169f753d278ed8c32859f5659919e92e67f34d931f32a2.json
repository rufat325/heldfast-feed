{
 "description": "Exact lookup of a 4-digit bank code (+ optional 3-digit branch code).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bankCode": {
    "pattern": "^\\d{4}$",
    "type": "string"
   },
   "branchCode": {
    "pattern": "^\\d{3}$",
    "type": "string"
   }
  },
  "required": [
   "bankCode"
  ],
  "type": "object"
 },
 "name": "jp_bank_lookup",
 "title": "Japanese bank / branch by code"
}
