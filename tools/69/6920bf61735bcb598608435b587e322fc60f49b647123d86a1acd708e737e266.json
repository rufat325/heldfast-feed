{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Gets a music box tune with its notes in the melody format (the same one validate_melody accepts), for one box version. Works for public tunes, for the signed-in person's own songs, and for a song this agent saved anonymously (pass its claim_token). Use search_songs or list_my_songs to find song ids.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "box": {
    "description": "Which version to return. Defaults to the version the arranger marked as preferred.",
    "enum": [
     "15",
     "20",
     "30",
     "freestyle"
    ],
    "type": "string"
   },
   "claim_token": {
    "description": "Only for songs saved without an account: the claim_token create_song returned.",
    "maxLength": 100,
    "type": "string"
   },
   "song_id": {
    "description": "Song id from search_songs, list_my_songs or create_song.",
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "song_id"
  ],
  "type": "object"
 },
 "name": "get_song",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "arranged_by": {
    "type": "string"
   },
   "artist": {
    "type": "string"
   },
   "available_boxes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "composer_url": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "melody": {
    "additionalProperties": false,
    "properties": {
     "box": {
      "type": "string"
     },
     "bpm": {
      "type": "number"
     },
     "notes": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "beat": {
         "type": "number"
        },
        "pitch": {
         "type": [
          "string",
          "number"
         ]
        },
        "ticks": {
         "type": "number"
        }
       },
       "required": [
        "pitch"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "box",
     "bpm",
     "notes"
    ],
    "type": "object"
   },
   "name": {
    "type": "string"
   },
   "private": {
    "type": "boolean"
   },
   "song_id": {
    "type": "string"
   },
   "stats": {
    "additionalProperties": false,
    "properties": {
     "duration_seconds": {
      "type": "number"
     },
     "illegal_count": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "note_count": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "strip_length_cm": {
      "type": "number"
     }
    },
    "required": [
     "note_count",
     "illegal_count",
     "duration_seconds"
    ],
    "type": "object"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "song_id",
   "name",
   "artist",
   "arranged_by",
   "private",
   "tags",
   "url",
   "available_boxes",
   "melody",
   "stats"
  ],
  "type": "object"
 },
 "title": "Get a music box tune"
}
