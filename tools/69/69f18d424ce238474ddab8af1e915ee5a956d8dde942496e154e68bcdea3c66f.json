{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Compute which entities should be visible from an observer pose and FOV cone, with ray-AABB occlusion. Read-only. Does not write entities. Returns {visible[], occluded[], observer}. Use get_expected_view instead of get_spatial_map when computing observer FOV visibility and occlusion cones rather than unfiltered world states.",
 "inputSchema": {
  "properties": {
   "fov_degrees": {
    "description": "Horizontal field of view in degrees (default: 90)",
    "type": "number"
   },
   "max_distance": {
    "description": "Maximum view distance in units (default: 100)",
    "type": "number"
   },
   "observer_orientation": {
    "description": "Observer orientation (yaw determines heading direction)",
    "properties": {
     "pitch": {
      "type": "number"
     },
     "roll": {
      "type": "number"
     },
     "yaw": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "observer_position": {
    "description": "Observer 3D coordinates",
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y",
     "z"
    ],
    "type": "object"
   },
   "project": {
    "description": "Optional project identifier",
    "type": "string"
   }
  },
  "required": [
   "observer_position"
  ],
  "type": "object"
 },
 "name": "get_expected_view"
}
