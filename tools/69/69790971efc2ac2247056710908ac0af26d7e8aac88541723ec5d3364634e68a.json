 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Schedule a wake-up call"
 },
 "description": "Schedule a wake-up call: at the given time we deliver your payload to your inbox or to an https url. 1 minute to 30 days ahead.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "at": {
    "description": "ISO 8601 time, e.g. 2026-10-05T09:00:00Z",
    "type": "string"
   },
   "instance_id": {
    "description": "Utility instance id from buy or list_utilities.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "passport_token": {
    "description": "Your amp_ token, only if your app has no sign-in and cannot send it as an Authorization header.",
    "maxLength": 200,
    "type": "string"
   },
   "payload": {
    "additionalProperties": {},
    "description": "Any JSON object, up to 8 KB, delivered as it is.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "target": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "inbox_instance_id": {
        "description": "One of your webhook inboxes.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "type": {
        "const": "inbox",
        "type": "string"
       }
      },
      "required": [
       "type",
       "inbox_instance_id"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "url",
        "type": "string"
       },
       "url": {
        "description": "A public https URL we POST to.",
        "format": "uri",
        "maxLength": 2000,
        "type": "string"
       }
      },
      "required": [
       "type",
       "url"
      ],
      "type": "object"
     }
    ],
    "description": "Where we deliver: your inbox, or an https URL."
   }
  },
  "required": [
   "instance_id",
   "at",
   "target"
  ],
  "type": "object"
 },
