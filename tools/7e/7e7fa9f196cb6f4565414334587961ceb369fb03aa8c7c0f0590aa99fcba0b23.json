{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List messages in inbox",
 "inputSchema": {
  "properties": {
   "after": {
    "description": "Filter messages after date (ISO 8601)",
    "type": "string"
   },
   "before": {
    "description": "Filter messages before date (ISO 8601)",
    "type": "string"
   },
   "concise": {
    "description": "Drop large free-text fields (message/event/task bodies, previews, attendee lists) to reduce payload size.",
    "type": "boolean"
   },
   "focused": {
    "description": "Show only Focused Inbox messages",
    "type": "boolean"
   },
   "folder": {
    "description": "Mail folder ID, well-known name, or path (for example Inbox/2026)",
    "type": "string"
   },
   "from": {
    "description": "Filter by sender email",
    "type": "string"
   },
   "order": {
    "description": "Message order: newest|oldest (default newest)",
    "enum": [
     "newest",
     "oldest"
    ],
    "type": "string"
   },
   "other": {
    "description": "Show only Other Inbox messages",
    "type": "boolean"
   },
   "top": {
    "description": "Number of messages to return",
    "type": "integer"
   },
   "unread": {
    "description": "Show only unread messages",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "mail_list"
}
