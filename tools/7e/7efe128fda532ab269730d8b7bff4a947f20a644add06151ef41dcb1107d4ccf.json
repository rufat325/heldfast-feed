{
 "description": "Compress chat message history using AI-powered summarization strategy. Creates concise summaries of older messages while preserving system messages and recent context.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customPrompt": {
    "description": "Custom prompt for summarization (optional)",
    "type": "string"
   },
   "maxModelTokens": {
    "default": 8192,
    "description": "Model's maximum token context window",
    "minimum": 1,
    "type": "number"
   },
   "messages": {
    "description": "Array of chat messages to compress",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "role": {
       "enum": [
        "system",
        "user",
        "assistant",
        "tool",
        "human"
       ],
       "type": "string"
      }
     },
     "required": [
      "role",
      "content"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "minRecentMessages": {
    "default": 4,
    "description": "Minimum recent messages to always preserve",
    "minimum": 0,
    "type": "number"
   },
   "openaiApiKey": {
    "description": "OpenAI API key (can also be set via OPENAI_API_KEY environment variable)",
    "type": "string"
   },
   "openaiModel": {
    "default": "gpt-4o-mini",
    "description": "OpenAI model to use for summarization",
    "type": "string"
   },
   "thresholdPercent": {
    "default": 0.7,
    "description": "Percentage threshold to trigger compression (0-1)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "messages"
  ],
  "type": "object"
 },
 "name": "summarize_messages"
}
