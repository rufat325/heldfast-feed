{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Export contacts matching a set of AND-combined filters. Returns an export job; poll status with `get-contact-export` to retrieve the download URL.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "filters": {
    "description": "Filters that select which contacts to include in the export. AND-combined.",
    "items": {
     "additionalProperties": false,
     "allOf": [
      {
       "else": {
        "required": [
         "value"
        ]
       },
       "if": {
        "properties": {
         "operator": {
          "enum": [
           "is_empty",
           "is_not_empty"
          ]
         }
        },
        "required": [
         "operator"
        ]
       },
       "then": {
        "not": {
         "required": [
          "value"
         ]
        }
       }
      }
     ],
     "properties": {
      "name": {
       "description": "Field to filter on (e.g. `list_id`, `subscription_status`, `email`).",
       "type": "string"
      },
      "operator": {
       "description": "Comparison operator.",
       "enum": [
        "equal",
        "not_equal",
        "contains",
        "not_contains",
        "is_empty",
        "is_not_empty"
       ],
       "type": "string"
      },
      "value": {
       "description": "Comparison value. Type depends on the field \u2014 string, number, boolean, or array."
      }
     },
     "required": [
      "name",
      "operator"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "filters"
  ],
  "type": "object"
 },
 "name": "create-contact-export"
}
