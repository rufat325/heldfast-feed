 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get combo"
 },
 "description": "One Polymarket combo: legs, conjunction result, all-time trade totals, the newest 100 taker fills, lifecycle totals and ingest coverage. Requires a Pro or Max API key. Unlike get_combo_fills it keeps executions priced above 0.95. Null lifecycle or missing leg facts are unknown, never zero.\n\nArgs:\n  - condition_id (string, required): Combo ID, 0x and 62 lowercase hex characters; not a binary market's condition_id\n\nReturns: combo, fills, lifecycle, coverage, access and meta. A malformed ID is a bad_request error and an unknown one not_found.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "condition_id": {
    "description": "Combo ID: 0x and 62 lowercase hex characters, not a binary market's condition_id",
    "pattern": "^0x[0-9a-f]{62}$",
    "type": "string"
   }
  },
  "required": [
   "condition_id"
  ],
  "type": "object"
 },
 "name": "get_combo",
