     },
     "status_reason": {
      "type": [
       "string",
       "null"
      ]
     },
     "totals": {
      "anyOf": [
       {
        "$ref": "#/$defs/ComboTotals"
       },
       {
        "type": "null"
       }
      ]
     },
     "window": {
      "anyOf": [
       {
        "$ref": "#/$defs/ComboWindowStats"
       },
       {
        "type": "null"
       }
      ]
     }
    },
