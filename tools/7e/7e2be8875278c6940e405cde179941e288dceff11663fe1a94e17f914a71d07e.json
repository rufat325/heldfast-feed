{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update one or more fields of a DNS record. Two-phase commit: first call shows current vs proposed values + token; second call (same params + token) applies the update.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "format": "uuid",
    "type": "string"
   },
   "record_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "source": {
    "type": "string"
   },
   "target": {
    "minLength": 1,
    "type": "string"
   },
   "ttl": {
    "maximum": 86400,
    "minimum": 60,
    "type": "integer"
   },
   "type": {
    "enum": [
     "A",
     "AAAA",
     "CNAME",
     "MX",
     "TXT",
     "SRV",
     "NS",
     "CAA",
     "PTR",
     "SPF"
    ],
    "type": "string"
   },
   "zone": {
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "zone",
   "record_id"
  ],
  "type": "object"
 },
 "name": "infomaniak_dns_update_record",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "after_preview": {
        "additionalProperties": {},
        "type": "object"
       },
       "before": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "number"
         },
         "source": {
          "type": "string"
         },
         "target": {
          "type": "string"
         },
         "ttl": {
          "minimum": 0,
          "type": "integer"
         },
         "type": {
          "enum": [
           "A",
           "AAAA",
           "CNAME",
           "MX",
           "TXT",
           "SRV",
           "NS",
           "CAA",
           "PTR",
           "SPF"
          ],
          "type": "string"
         },
         "updated_at": {
          "type": "number"
         }
        },
        "required": [
         "source",
         "type",
         "ttl",
         "target"
        ],
        "type": "object"
       },
       "record_id": {
        "type": "number"
       },
       "zone": {
        "type": "string"
       }
      },
      "required": [
       "zone",
       "record_id",
       "before",
       "after_preview"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "message": {
      "type": "string"
     },
     "record": {
      "$ref": "#/anyOf/0/properties/plan/properties/before"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "record",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
