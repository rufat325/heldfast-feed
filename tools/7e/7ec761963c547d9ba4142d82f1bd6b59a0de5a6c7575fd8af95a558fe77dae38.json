{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Restore design"
 },
 "description": "Put a design back. With a checkpoint_id it restores that snapshot; without one it undoes the most recent tensorcad_apply_ops batch. Either way the revision moves forward, so a stale expected_revision still fails.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "checkpoint_id": {
    "description": "Omit to undo the last batch of edits.",
    "type": "string"
   },
   "design_id": {
    "description": "Handle returned by tensorcad_new_design or tensorcad_open_design, e.g. \"dsn_1\".",
    "type": "string"
   }
  },
  "required": [
   "design_id"
  ],
  "type": "object"
 },
 "name": "tensorcad_restore",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "design_id": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "params_total": {
    "type": "number"
   },
   "restored_from": {
    "type": "string"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "counts": {
      "additionalProperties": false,
      "properties": {
       "error": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "info": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "warning": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       }
      },
      "required": [
       "error",
       "warning",
       "info"
      ],
      "type": "object"
     },
     "ok": {
      "description": "True when nothing blocks building this design.",
      "type": "boolean"
     },
     "top_findings": {
      "description": "The worst few findings. Call tensorcad_validate for all of them.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "hint": {
         "description": "What to change to clear the finding.",
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "path": {
         "description": "Block path the finding is about.",
         "type": "string"
        },
        "port": {
         "type": "string"
        },
        "rule": {
         "description": "Stable rule id, e.g. \"flash-head-dim\".",
         "type": "string"
        },
        "severity": {
         "enum": [
          "error",
          "warning",
          "info"
         ],
         "type": "string"
        }
       },
       "required": [
        "rule",
        "severity",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "ok",
     "counts",
     "top_findings"
    ],
    "type": "object"
   }
  },
  "required": [
   "design_id",
   "revision",
   "name",
   "restored_from",
   "params_total",
   "validation"
  ],
  "type": "object"
 },
 "title": "Restore design"
}
