{
 "annotations": {
  "destructiveHint": true,
  "title": "Create or update a customer"
 },
 "description": "Create a loyalty customer, or update one by passing its `id`. Loyverse does not document whether omitted fields survive an update, so on update fetch the customer first and send the full record. Loyverse: POST /customers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "description": "Street address.",
    "maxLength": 192,
    "type": "string"
   },
   "city": {
    "description": "City, town or village.",
    "maxLength": 64,
    "type": "string"
   },
   "country_code": {
    "description": "Two-letter ISO 3166-1 alpha-2 country code, e.g. US.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "customer_code": {
    "description": "Your own customer code (e.g. a loyalty card number).",
    "maxLength": 40,
    "type": "string"
   },
   "email": {
    "description": "Email address.",
    "maxLength": 100,
    "type": "string"
   },
   "id": {
    "description": "Existing customer id to update. Omit to create.",
    "type": "string"
   },
   "name": {
    "description": "The customer's name (required).",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "description": "A note about the customer.",
    "maxLength": 255,
    "type": "string"
   },
   "phone_number": {
    "description": "Phone number.",
    "maxLength": 15,
    "type": "string"
   },
   "postal_code": {
    "description": "Postal / ZIP code.",
    "maxLength": 20,
    "type": "string"
   },
   "region": {
    "description": "Province, state or prefecture.",
    "maxLength": 64,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "loyverse_upsert_customer",
 "title": "Create or update a customer"
}
