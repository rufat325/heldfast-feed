{
 "description": "Replace a funnel's definition. Send the whole funnel including every step \u2014 omitted steps are removed, not kept.",
 "inputSchema": {
  "properties": {
   "funnel_id": {
    "description": "id from list_funnels.",
    "type": "integer"
   },
   "name": {
    "type": "string"
   },
   "scope": {
    "enum": [
     "visitor",
     "session"
    ],
    "type": "string"
   },
   "site": {
    "description": "site_id from list_sites.",
    "type": [
     "string",
     "integer"
    ]
   },
   "steps": {
    "items": {
     "properties": {
      "type": {
       "enum": [
        "page",
        "event",
        "entry_page",
        "exit_page"
       ],
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "value"
     ],
     "type": "object"
    },
    "minItems": 2,
    "type": "array"
   },
   "strict_order": {
    "type": "boolean"
   }
  },
  "required": [
   "site",
   "funnel_id",
   "name",
   "steps"
  ],
  "type": "object"
 },
 "name": "update_funnel"
}
