{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List dismissed matches"
 },
 "description": "Returns the account's dismissed listings, newest first, with listing id, title, company, Dreamwork page url, dismissal time and whether the listing is still active. total counts all dismissed listings. limit defaults to 20 and accepts up to 50; nextOffset continues the list and null ends it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Page size, 20 when omitted.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "`nextOffset` from the previous page; 0 when omitted.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_dismissed_matches",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "active": {
       "type": "boolean"
      },
      "company": {
       "type": "string"
      },
      "dismissedAt": {
       "type": "string"
      },
      "jobId": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "jobId",
      "title",
      "company",
      "url",
      "dismissedAt",
      "active"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextOffset": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "total": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "matches",
   "total",
   "nextOffset"
  ],
  "type": "object"
 },
 "title": "List dismissed matches"
}
