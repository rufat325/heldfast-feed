{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Change a voiceover line"
 },
 "description": "Use this when someone wants to change the words, translation, language or voice of one voiceover line. Returns the updated line. A real change re-synthesizes its audio with the project's voice provider, spending synthesis credits and replacing the old audio; identical values change nothing. Not for project-wide pronunciation fixes.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "language": {
    "description": "New language code, e.g. en or pt-BR",
    "maxLength": 32,
    "minLength": 2,
    "type": "string"
   },
   "speechId": {
    "description": "Voiceover line to edit",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "description": "New words to speak, up to 5000 characters",
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "translatedText": {
    "description": "New translation spoken instead of the source text",
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "voice": {
    "description": "New voice id for this line",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "speechId"
  ],
  "type": "object"
 },
 "name": "update_speech",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "resynthesized": {
    "description": "True when the change re-synthesized the audio and spent synthesis credits",
    "type": "boolean"
   },
   "speech": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "duration": {
        "anyOf": [
         {
          "maximum": 86400,
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "language": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "projectId": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "textPreview": {
        "anyOf": [
         {
          "maxLength": 5000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "url": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "voice": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "projectId",
       "language",
       "voice",
       "url",
       "duration",
       "textPreview",
       "creationTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "updated",
     "unchanged",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "resynthesized",
   "speech"
  ],
  "type": "object"
 },
 "title": "Change a voiceover line"
}
