{
 "description": "Confirm a USDC transfer that pays for a human task. The transaction must already be on Base, Ethereum, or Solana. Does not accept card data. AI agents pay crypto for human requests.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "chain": {
    "description": "base, ethereum, or solana.",
    "type": "string"
   },
   "minutes": {
    "default": null,
    "format": "int32",
    "type": [
     "integer",
     "null"
    ]
   },
   "task_id": {
    "type": "string"
   },
   "tx_hash": {
    "type": "string"
   },
   "wallet": {
    "default": "",
    "description": "metamask, coinbase, trust, phantom, or rainbow.",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "chain",
   "tx_hash"
  ],
  "type": "object"
 },
 "name": "submit_crypto_payment",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "already_recorded": {
    "type": "boolean"
   },
   "chain": {
    "type": "string"
   },
   "paid": {
    "type": "boolean"
   },
   "price_label": {
    "type": "string"
   },
   "statement": {
    "type": "string"
   },
   "task_id": {
    "type": "string"
   },
   "tx_hash": {
    "type": "string"
   },
   "usdc_units": {
    "type": "string"
   },
   "wallet": {
    "type": "string"
   }
  },
  "required": [
   "paid",
   "already_recorded",
   "task_id",
   "chain",
   "wallet",
   "tx_hash",
   "usdc_units",
   "price_label",
   "statement"
  ],
  "type": "object"
 }
}
