{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true
 },
 "description": "Restart a specific container in a Data Forest app component",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "containerName": {
    "description": "Container name (e.g. shell-0, broker-1)",
    "maxLength": 60,
    "type": "string"
   },
   "id": {
    "description": "App unique identifier (Base62-encoded UUID)",
    "maxLength": 22,
    "type": "string"
   }
  },
  "required": [
   "id",
   "containerName"
  ],
  "type": "object"
 },
 "name": "ncloud_dataforest_kill_container"
}
