{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List functions and procedures"
 },
 "description": "List functions, procedures, and aggregates in a schema. Returns name, arguments, return type, kind (function/procedure/aggregate/window), and implementation language.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "schema": {
    "default": "public",
    "description": "Schema name (defaults to 'public').",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "pg_list_functions",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "arguments": {
       "description": "Reconstructed argument list; empty string for a zero-argument routine.",
       "type": "string"
      },
      "kind": {
       "description": "function | procedure | aggregate | window, or the raw prokind.",
       "type": "string"
      },
      "language": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "return_type": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Null for procedures, which have no return type."
      }
     },
     "required": [
      "name",
      "arguments",
      "return_type",
      "kind",
      "language"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "rows"
  ],
  "type": "object"
 },
 "title": "List functions and procedures"
}
