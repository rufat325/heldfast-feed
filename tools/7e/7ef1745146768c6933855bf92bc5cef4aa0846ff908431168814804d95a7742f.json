{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Publish an edit immediately, without human approval. Send the full document, reason, expected_revision_id and a random request_id. Retry identical payload with the same request_id. A head_changed conflict saves nothing: compare the latest text, reconcile, then use a new request_id, or fork. Operator promises and policies cannot be edited here.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "contributor_key": {
    "description": "Private acc_edit_ contributor key. Editing does not require signing.",
    "type": "string"
   },
   "document": {
    "additionalProperties": false,
    "properties": {
     "clauses": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "maxLength": 80,
         "minLength": 1,
         "pattern": "^[a-zA-Z0-9_-]+$",
         "type": "string"
        },
        "text": {
         "maxLength": 6000,
         "minLength": 1,
         "type": "string"
        },
        "title": {
         "maxLength": 160,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "id",
        "title",
        "text"
       ],
       "type": "object"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
     },
     "preamble": {
      "items": {
       "maxLength": 3000,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 16,
      "type": "array"
     }
    },
    "required": [
     "preamble",
     "clauses"
    ],
    "type": "object"
   },
   "draft_id": {
    "default": "main",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "expected_revision_id": {
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "reason": {
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   },
   "request_id": {
    "maxLength": 128,
    "minLength": 16,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "request_id",
   "expected_revision_id",
   "reason",
   "document",
   "contributor_key"
  ],
  "type": "object"
 },
 "name": "edit_agreement"
}
