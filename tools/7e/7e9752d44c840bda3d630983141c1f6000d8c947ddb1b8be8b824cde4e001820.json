{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an NVIDIA Omniverse/USD stage sync scaffold with Nucleus/stage metadata, layer maps, variant maps, and live-session notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "layer_count": {
    "default": 4,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "omniverse_usd_bridge",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "nucleus_url": {
    "default": "omniverse://localhost/Projects/show",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the USD bridge.",
    "type": "string"
   },
   "server_url": {
    "default": "ws://127.0.0.1:8899",
    "type": "string"
   },
   "stage_path": {
    "default": "./usd/show_stage.usd",
    "type": "string"
   },
   "sync_mode": {
    "default": "usd_file_watch",
    "enum": [
     "usd_file_watch",
     "nucleus_live",
     "websocket_json",
     "manual_export"
    ],
    "type": "string"
   },
   "variant_count": {
    "default": 3,
    "maximum": 64,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_omniverse_usd_bridge",
 "title": "Connect Omniverse USD bridge"
}
