{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Call when the conversation settles something the user's other agents should know: a decision, a plan, a status change (shipped, blocked, paused) or a finding. Commit under your own agent_id. Mark anything personal, financial or credential-like visibility: \"private\". Never commit small talk or a transcript. Write a contribution to the federation under agent_id: durable facts in entities (name + summary), what happened in sessions (date, project_focus, key_actions), short dated facts in notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_id": {
    "type": "string"
   },
   "agent_type": {
    "type": [
     "string",
     "null"
    ]
   },
   "entities": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "expected_digest": {
    "type": [
     "string",
     "null"
    ]
   },
   "instance": {
    "type": [
     "string",
     "null"
    ]
   },
   "mode": {
    "default": "merge",
    "type": "string"
   },
   "notes": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "on_clamp": {
    "default": "spill",
    "type": "string"
   },
   "role_narrative": {
    "type": [
     "string",
     "null"
    ]
   },
   "session_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "sessions": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "transcript_ref": {
    "type": [
     "string",
     "null"
    ]
   },
   "workstreams": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "agent_id"
  ],
  "type": "object"
 },
 "name": "commit_to_federation",
 "title": "Commit to federation"
}
