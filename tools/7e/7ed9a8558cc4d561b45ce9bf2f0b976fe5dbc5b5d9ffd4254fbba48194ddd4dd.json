{
 "annotations": {
  "destructiveHint": true,
  "title": "Comment on a ticket"
 },
 "description": "Add a comment to a ticket, either as a technician (technician_id, with is_internal=true for a private note or false for a reply the end user sees) or on behalf of an end user (enduser_id). Atera: POST /api/v3/tickets/{ticketId}/comments.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "comment": {
    "description": "The comment text.",
    "minLength": 1,
    "type": "string"
   },
   "enduser_id": {
    "description": "Post as this end-user contact (EndUserID).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "is_internal": {
    "default": true,
    "description": "Technician comments only: true = internal note (default), false = visible reply.",
    "type": "boolean"
   },
   "technician_email": {
    "description": "The technician's email (optional, with technician_id).",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "technician_id": {
    "description": "Post as this technician (TechnicianId).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "ticket_id": {
    "description": "The ticket's TicketID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "timestamp_utc": {
    "description": "Comment time in UTC, ISO 8601. Defaults to now.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   }
  },
  "required": [
   "ticket_id",
   "comment"
  ],
  "type": "object"
 },
 "name": "atera_add_ticket_comment",
 "title": "Comment on a ticket"
}
