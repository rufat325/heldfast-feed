       "from_sequence": {
        "minimum": 0,
        "type": "integer"
       },
       "ordering": {
        "const": "commit_visibility_then_id_asc",
        "type": "string"
       },
       "pending_beyond_horizon": {
        "type": "boolean"
       },
       "to_cursor": {
        "type": "string"
       },
       "to_sequence": {
        "minimum": 0,
        "type": "integer"
