      "properties": {
       "condition_id": {
        "type": "string"
       },
       "count": {
        "minimum": 1,
        "type": "integer"
       },
       "platform": {
        "enum": [
         "polymarket"
        ],
        "type": "string"
       },
       "trader_id": {
        "type": "integer"
       },
       "whale_alert_id": {
        "minimum": 1,
        "type": "integer"
       }
      },
      "required": [
       "count",
       "whale_alert_id",
       "condition_id",
       "trader_id",
       "platform"
      ],
      "type": "object"
     },
     "published_at": {
      "format": "date-time",
      "type": "string"
     },
     "sequence": {
      "minimum": 1,
      "type": "integer"
     },
     "source": {
