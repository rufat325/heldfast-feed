          "enum": [
           "S",
           "A",
           "B",
           "C",
           "D",
           "F"
          ],
          "type": "string"
         },
         "min_size": {
          "type": "number"
         },
         "trader": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "from_cursor": {
        "type": "string"
