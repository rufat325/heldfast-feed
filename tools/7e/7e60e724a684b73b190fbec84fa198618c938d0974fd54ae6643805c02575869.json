{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Run a custom Google Analytics report with dimensions and metrics.\n\n\u26a0\ufe0f TOKEN OPTIMIZATION: Use 'limit' to control result size (default: 10).\nThis tool can consume significant tokens with large datasets.\n\nCommon dimensions: date, city, country, deviceCategory, browser, pagePath, eventName\nCommon metrics: activeUsers, sessions, screenPageViews, conversions, totalRevenue",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dateRanges": {
    "description": "Date ranges for the report",
    "items": {
     "additionalProperties": false,
     "properties": {
      "endDate": {
       "description": "End date (YYYY-MM-DD or \"yesterday\", \"today\", \"7daysAgo\")",
       "type": "string"
      },
      "name": {
       "description": "Optional name for the date range",
       "type": "string"
      },
      "startDate": {
       "description": "Start date (YYYY-MM-DD or \"yesterday\", \"today\", \"7daysAgo\")",
       "type": "string"
      }
     },
     "required": [
      "startDate",
      "endDate"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dimensionFilter": {
    "additionalProperties": {},
    "description": "Dimension filter expression",
    "type": "object"
   },
   "dimensions": {
    "description": "Dimensions to group by (e.g., [{name: \"date\"}])",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limit": {
    "description": "Maximum number of rows to return (default: 10)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "metricFilter": {
    "additionalProperties": {},
    "description": "Metric filter expression",
    "type": "object"
   },
   "metrics": {
    "description": "Metrics to measure (e.g., [{name: \"activeUsers\"}])",
    "items": {
     "$ref": "#/properties/dimensions/items"
    },
    "type": "array"
   },
   "offset": {
    "description": "Number of rows to skip (for pagination)",
    "minimum": 0,
    "type": "integer"
   },
   "orderBys": {
    "description": "Sorting specification",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "propertyId": {
    "description": "GA4 property ID to query (overrides the default GA_PROPERTY_ID). Accepts \"123456789\" or \"properties/123456789\". Use ga_get_account_summaries to discover IDs.",
    "type": "string"
   }
  },
  "required": [
   "dateRanges",
   "metrics"
  ],
  "type": "object"
 },
 "name": "ga_run_report"
}
