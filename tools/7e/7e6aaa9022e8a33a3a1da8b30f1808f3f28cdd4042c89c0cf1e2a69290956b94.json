{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "Canonical per-chain collateral capabilities and addresses (per-collateral MarketRouter proxies, the shared OutcomeToken1155, and factories) plus the exact one-time approvals for collaterals with trading=true: approve(collateral -> router, MAX) for buys (AMM + orderbook), setApprovalForAll(OutcomeToken1155 -> router, true) for a LMSR or orderbook sell today \u2014 engine-scoped, so this drops out per settlement venue as each ships approval-free sells (burn-and-mint instead of a pull); check the actual /trade/prepare or /trade/simulate response for one market rather than assuming this list is permanent. A collateral whose settlement is committed emits no approval at all: its fills are entries on the venue commit ledger, so there is no router pull to authorize \u2014 read `settlement` per collateral from GET /discover/collateral. Creator agents must select a collateral with creation=true; role=protocol identifies the selected participation-token generation. Cancel and direct market-local claims need no approval. Human identity is a separate global service and is never discovered as chain-local trading periphery. All addresses are stable/permanent (UUPS) where applicable.",
 "inputSchema": {
  "properties": {
   "chainId": {
    "description": "Optional chainId. Returns all enabled chains if omitted.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "collateral": {
    "description": "Optional reviewed collateral symbol or token address filter.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "problee_get_contracts",
 "outputSchema": {
  "$defs": {
   "ChainId": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "DiscoverContractsResponse": {
    "additionalProperties": false,
    "properties": {
     "chains": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "approvals": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "amount": {
            "$ref": "#/$defs/WeiString"
           },
           "chainId": {
            "$ref": "#/$defs/ChainId"
           },
           "kind": {
            "enum": [
             "erc20_approve",
             "erc1155_set_approval_for_all"
            ],
            "type": "string"
           },
           "reason": {
            "enum": [
             "buy_collateral",
             "sell_outcome_token"
            ],
            "type": "string"
           },
           "spender": {
            "$ref": "#/$defs/EvmAddress"
           },
           "token": {
            "$ref": "#/$defs/EvmAddress"
           }
          },
          "required": [
           "kind",
           "reason",
           "chainId",
           "token",
           "spender"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "chainId": {
         "$ref": "#/$defs/ChainId"
        },
        "collaterals": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "capabilities": {
            "additionalProperties": false,
            "properties": {
             "creation": {
              "type": "boolean"
             },
             "trading": {
              "type": "boolean"
             }
            },
            "required": [
             "trading",
             "creation"
            ],
            "type": "object"
           },
           "decimals": {
            "maximum": 30,
            "minimum": 0,
            "type": "integer"
           },
           "role": {
            "$ref": "#/$defs/ServedCollateralRole"
           },
           "router": {
            "$ref": "#/$defs/EvmAddress"
           },
           "symbol": {
            "maxLength": 16,
            "minLength": 1,
            "type": "string"
           },
           "token": {
            "$ref": "#/$defs/EvmAddress"
           }
          },
          "required": [
           "symbol",
           "token",
           "router",
           "role",
           "capabilities"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "factories": {
         "additionalProperties": false,
         "properties": {
          "binary": {
           "$ref": "#/$defs/EvmAddress"
          },
          "orderbook": {
           "anyOf": [
            {
             "$ref": "#/$defs/EvmAddress"
            },
            {
             "type": "null"
            }
           ]
          },
          "ternary": {
           "$ref": "#/$defs/EvmAddress"
          }
         },
         "required": [
          "binary",
          "ternary",
          "orderbook"
         ],
         "type": "object"
        },
        "name": {
         "type": "string"
        },
        "outcomeToken": {
         "$ref": "#/$defs/EvmAddress"
        },
        "routerInterface": {
         "additionalProperties": false,
         "properties": {
          "abiVersion": {
           "type": "string"
          },
          "functions": {
           "additionalProperties": false,
           "properties": {
            "executeBasketIntent": {
             "$ref": "#/$defs/RouterInterfaceFunction"
            },
            "executeTradeIntent": {
             "$ref": "#/$defs/RouterInterfaceFunction"
            }
           },
           "required": [
            "executeTradeIntent",
            "executeBasketIntent"
           ],
           "type": "object"
          },
          "runtimeCodeHash": {
           "type": "string"
          }
         },
         "required": [
          "abiVersion",
          "runtimeCodeHash",
          "functions"
         ],
         "type": "object"
        },
        "stable": {
         "const": true,
         "type": "boolean"
        }
       },
       "required": [
        "chainId",
        "name",
        "stable",
        "collaterals",
        "outcomeToken",
        "factories",
        "routerInterface",
        "approvals"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "chains"
    ],
    "type": "object"
   },
   "EvmAddress": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "RouterInterfaceFunction": {
    "additionalProperties": false,
    "properties": {
     "selector": {
      "type": "string"
     },
     "signature": {
      "type": "string"
     }
    },
    "required": [
     "signature",
     "selector"
    ],
    "type": "object"
   },
   "ServedCollateralRole": {
    "maxLength": 32,
    "minLength": 1,
    "type": "string"
   },
   "WeiString": {
    "pattern": "^\\d+$",
    "type": "string"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/DiscoverContractsResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Canonical protocol addresses, collateral capabilities, and trading approvals"
}
