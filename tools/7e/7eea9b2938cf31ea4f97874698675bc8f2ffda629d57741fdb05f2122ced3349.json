{
 "description": "Redeem winning outcome tokens on a settled prediction market. Market must be determined/finalized.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Number of contracts to redeem",
    "type": "string"
   },
   "market_ticker": {
    "description": "Market ticker of settled market",
    "type": "string"
   },
   "outcome": {
    "description": "Outcome tokens to redeem: YES or NO",
    "type": "string"
   },
   "reason": {
    "description": "Reason for redemption (optional)",
    "type": "string"
   }
  },
  "required": [
   "market_ticker",
   "outcome",
   "amount"
  ],
  "type": "object"
 },
 "name": "redeem_prediction"
}
