{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create Export Template"
 },
 "description": "Use this when the user wants to save their export configuration as a reusable template.",
 "inputSchema": {
  "properties": {
   "email": {
    "description": "Default email for sending exports",
    "type": "string"
   },
   "filename": {
    "description": "Default filename",
    "type": "string"
   },
   "filter": {
    "description": "Status filter",
    "enum": [
     "all",
     "billable",
     "notBillable",
     "paid",
     "unpaid",
     "billed",
     "outstanding"
    ],
    "type": "string"
   },
   "format": {
    "description": "Export format",
    "enum": [
     "xlsx",
     "xlsx1904",
     "csv",
     "pdf"
    ],
    "type": "string"
   },
   "name": {
    "description": "Template name",
    "type": "string"
   },
   "projectIds": {
    "description": "Project IDs filter",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "report": {
    "description": "Report type identifier",
    "type": "number"
   },
   "splitTask": {
    "description": "Split multi-day tasks",
    "type": "boolean"
   },
   "summarize": {
    "description": "Add a totals row at the end (entries are still listed)",
    "type": "boolean"
   },
   "teamIds": {
    "description": "Team IDs filter",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Task type filter",
    "enum": [
     "all",
     "task",
     "mileage",
     "call"
    ],
    "type": "string"
   },
   "userIds": {
    "description": "User IDs filter",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "export_template_create",
 "outputSchema": {
  "properties": {
   "id": {
    "description": "Created template ID",
    "type": "string"
   },
   "name": {
    "description": "Template name",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Create Export Template"
}
