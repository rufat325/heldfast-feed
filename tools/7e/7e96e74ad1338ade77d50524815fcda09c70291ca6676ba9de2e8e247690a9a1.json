{
 "description": "View the recorded price history for a tracked route. Shows all past observations and the trend.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cabinClass": {
    "default": "economy",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "departureDate": {
    "description": "Travel date (YYYY-MM-DD)",
    "type": "string"
   },
   "destination": {
    "description": "Arrival airport IATA code",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "origin": {
    "description": "Departure airport IATA code",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination",
   "departureDate"
  ],
  "type": "object"
 },
 "name": "get_price_history"
}
