{
 "_meta": {
  "contextstudios/defaultResponseFormat": "legacy",
  "contextstudios/recommendedResponseFormat": "v2",
  "contextstudios/visibility": "public"
 },
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search all public Context Studios content (blog, guides, glossary, AI comparisons). Returns result IDs for use with the fetch tool.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://mcp.contextstudios.ai/icons/search-light.svg",
   "theme": "light"
  },
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://mcp.contextstudios.ai/icons/search-dark.svg",
   "theme": "dark"
  }
 ],
 "inputSchema": {
  "properties": {
   "query": {
    "description": "Search query",
    "examples": [
     "MCP server development",
     "Claude vs ChatGPT",
     "AI agent security"
    ],
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "properties": {
   "results": {
    "items": {
     "properties": {
      "id": {
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search Context Studios Content"
}
