{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get About Resume"
 },
 "description": "Returns a condensed profile card payload with current role, concise skills, profile image, email CTA, and proactive next-tool prompts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "conciseSkillLimit": {
    "default": 5,
    "maximum": 10,
    "minimum": 3,
    "type": "integer"
   },
   "includeAvailability": {
    "default": true,
    "type": "boolean"
   },
   "includeVisual": {
    "default": true,
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "get_about_resume",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "generatedAt": {
    "type": "string"
   },
   "proactiveActions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "type": "string"
      },
      "prompt": {
       "type": "string"
      },
      "toolName": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "toolName",
      "prompt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "profile": {
    "additionalProperties": false,
    "properties": {
     "availability": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "freelanceStatus": {
          "type": "string"
         },
         "fullTimeStatus": {
          "type": "string"
         }
        },
        "required": [
         "freelanceStatus",
         "fullTimeStatus"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "conciseSkills": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "currentCompany": {
      "type": "string"
     },
     "currentRole": {
      "type": "string"
     },
     "currentTitle": {
      "type": "string"
     },
     "email": {
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "fullName": {
      "type": "string"
     },
     "location": {
      "type": "string"
     },
     "profileImage": {
      "additionalProperties": false,
      "properties": {
       "alt": {
        "type": "string"
       },
       "mimeType": {
        "type": "string"
       },
       "src": {
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "src",
       "alt",
       "mimeType"
      ],
      "type": "object"
     },
     "summary": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "fullName",
     "title",
     "currentRole",
     "currentCompany",
     "currentTitle",
     "location",
     "conciseSkills",
     "summary",
     "availability",
     "email",
     "profileImage"
    ],
    "type": "object"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "datasetLastModified": {
      "type": "string"
     },
     "datasetLastUpdated": {
      "type": "string"
     },
     "datasetSha256": {
      "type": "string"
     },
     "file": {
      "type": "string"
     }
    },
    "required": [
     "file",
     "datasetSha256",
     "datasetLastModified",
     "datasetLastUpdated"
    ],
    "type": "object"
   }
  },
  "required": [
   "generatedAt",
   "profile",
   "proactiveActions",
   "source"
  ],
  "type": "object"
 },
 "title": "Get About Resume"
}
