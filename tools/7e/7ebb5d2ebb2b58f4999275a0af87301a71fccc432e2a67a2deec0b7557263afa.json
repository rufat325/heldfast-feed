{
 "description": "Run an arbitrary OData 3.0 query against any 1C entity. Supports $filter, $select, $expand, $orderby, $top, $skip, $inlinecount.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "entity": {
    "description": "OData-\u0441\u0443\u0449\u043d\u043e\u0441\u0442\u044c (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, Catalog_\u041d\u043e\u043c\u0435\u043d\u043a\u043b\u0430\u0442\u0443\u0440\u0430, Document_\u0421\u0447\u0451\u0442\u041d\u0430\u041e\u043f\u043b\u0430\u0442\u0443\u041f\u043e\u043a\u0443\u043f\u0430\u0442\u0435\u043b\u044e)",
    "type": "string"
   },
   "expand": {
    "description": "$expand \u0434\u043b\u044f \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0445 \u0442\u0430\u0431\u043b\u0438\u0446",
    "type": "string"
   },
   "filter": {
    "description": "$filter",
    "type": "string"
   },
   "inlinecount": {
    "default": false,
    "description": "\u0414\u043e\u0431\u0430\u0432\u0438\u0442\u044c $inlinecount=allpages",
    "type": "boolean"
   },
   "orderby": {
    "description": "$orderby",
    "type": "string"
   },
   "select": {
    "description": "$select",
    "type": "string"
   },
   "skip": {
    "default": 0,
    "description": "$skip",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "top": {
    "default": 100,
    "description": "$top",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "entity"
  ],
  "type": "object"
 },
 "name": "odata_query"
}
