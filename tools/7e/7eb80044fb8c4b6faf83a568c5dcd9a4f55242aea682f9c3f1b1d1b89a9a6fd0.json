{
 "description": "Write a completed conversion to a file: Excel (xlsx), CSV, Fortnox CSV, OFX or JSON. Files whose data failed the balance check are written with an \"-UNVERIFIED\" filename suffix and an in-file warning \u2014 do not strip either.\n\nConversions are held on the server for 10 minutes. If that window has passed, this tool re-converts the same file automatically, which consumes one conversion from the account's quota.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "columns": {
    "description": "Pro only. Comma-separated: date,description,amount,currency,balance",
    "type": "string"
   },
   "conversion_id": {
    "description": "The conversion.id returned by convert_bank_statement.",
    "type": "string"
   },
   "date_format": {
    "description": "Pro only.",
    "enum": [
     "DD/MM/YYYY",
     "MM/DD/YYYY",
     "DD.MM.YYYY"
    ],
    "type": "string"
   },
   "decimal_separator": {
    "description": "Pro only. \"comma\" produces the European convention (semicolon-delimited, 1234,56).",
    "enum": [
     "period",
     "comma"
    ],
    "type": "string"
   },
   "format": {
    "description": "xlsx and csv are free; fortnox, ofx and json need a Pro API key.",
    "enum": [
     "xlsx",
     "csv",
     "fortnox",
     "ofx",
     "json"
    ],
    "type": "string"
   },
   "order": {
    "enum": [
     "chronological",
     "statement"
    ],
    "type": "string"
   },
   "output_dir": {
    "type": "string"
   }
  },
  "required": [
   "conversion_id",
   "format"
  ],
  "type": "object"
 },
 "name": "export_conversion",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bytes": {
    "type": "number"
   },
   "format": {
    "type": "string"
   },
   "note": {
    "type": [
     "string",
     "null"
    ]
   },
   "path": {
    "type": "string"
   },
   "reconverted": {
    "type": "boolean"
   },
   "verdict": {
    "additionalProperties": false,
    "properties": {
     "ledger_safe": {
      "type": "boolean"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "ledger_safe"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "path",
   "format",
   "bytes",
   "verdict",
   "reconverted",
   "note",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Write a conversion to a file"
}
