{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List imported bank lines. Date and matched filters are applied client-side within the fetched page.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "accountId": {
    "description": "Filter by bank account ID (server-side)",
    "type": "string"
   },
   "matched": {
    "description": "true = only lines with a match, false = only unmatched (client-side)",
    "type": "boolean"
   },
   "maxEntryDate": {
    "description": "Entry date <= this (client-side, within page)",
    "type": "string"
   },
   "minEntryDate": {
    "description": "Entry date >= this (client-side, within page)",
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Records per page (max 1000, default 50)",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "verbose": {
    "description": "Return the full Billy response. Default false: compact records with key fields only (saves ~90% context)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_bank_lines"
}
