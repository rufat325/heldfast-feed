 "category": "integrations",
 "description": "Post the output of jira_to_test_suite as a formatted comment on the source Jira ticket. Converts Gherkin, E2E steps, API tests, and ambiguities into Atlassian Document Format (ADF). STATEFUL \u2014 creates a comment on the issue.",
 "inputSchema": {
  "properties": {
   "issue_key": {
    "description": "Jira issue key, e.g. \"PROJ-123\"",
    "type": "string"
   },
   "jira_base_url": {
    "description": "Atlassian base URL",
    "type": "string"
   },
   "jira_email": {
    "description": "Atlassian account email",
    "type": "string"
   },
   "jira_token": {
    "description": "Atlassian API token",
    "type": "string"
   },
   "test_suite": {
    "additionalProperties": true,
    "description": "The test_suite object from jira_to_test_suite result",
    "type": "object"
   }
  },
  "required": [
   "issue_key",
   "jira_base_url",
   "jira_email",
   "jira_token",
   "test_suite"
  ],
  "type": "object"
 },
 "name": "post_jira_comment",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "comment_id": {
    "type": "string"
   },
   "comment_url": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "type": "object"
 }
}
