{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Fetch a single published guide as Markdown. Use a route returned by list_sections, / for the homepage, and an optional language code. Only known public guide routes are allowed; legal pages are English-only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "language": {
    "default": "en",
    "enum": [
     "en",
     "fr",
     "pt",
     "es",
     "id",
     "tr",
     "hr",
     "sl",
     "zh",
     "hi",
     "ta",
     "th"
    ],
    "type": "string"
   },
   "route": {
    "maxLength": 80,
    "type": "string"
   }
  },
  "required": [
   "route"
  ],
  "type": "object"
 },
 "name": "get_guide"
}
