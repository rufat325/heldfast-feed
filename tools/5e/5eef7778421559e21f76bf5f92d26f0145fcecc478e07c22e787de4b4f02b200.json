{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Scaffold Payram Payments & Payouts App"
 },
 "description": "Generates a minimal full-stack app skeleton with Payram payments and payouts routes (and a simple UI) for a chosen language and framework.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "appName": {
    "description": "Name for the generated application. If not provided, defaults to payram-{framework}-starter",
    "minLength": 1,
    "type": "string"
   },
   "framework": {
    "description": "Web framework to use for scaffolding the application",
    "enum": [
     "express",
     "nextjs",
     "fastapi",
     "laravel",
     "gin",
     "spring-boot"
    ],
    "type": "string"
   },
   "includeWebhooks": {
    "default": true,
    "description": "Whether to include webhook handler code in the scaffolded application",
    "type": "boolean"
   },
   "language": {
    "description": "Programming language for the application (node for JavaScript/TypeScript)",
    "enum": [
     "node",
     "python",
     "php",
     "go",
     "java"
    ],
    "type": "string"
   }
  },
  "required": [
   "language",
   "framework"
  ],
  "type": "object"
 },
 "name": "scaffold_payram_app",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "appName": {
    "type": "string"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "contents": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "description",
      "contents"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "framework": {
    "type": "string"
   },
   "instructions": {
    "type": "string"
   },
   "language": {
    "type": "string"
   }
  },
  "required": [
   "appName",
   "language",
   "framework",
   "instructions",
   "files"
  ],
  "type": "object"
 },
 "title": "Scaffold Payram Payments & Payouts App"
}
