{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "View Wishlist"
 },
 "description": "View your CellarTracker wishlist wines. Optionally search by wine name, region, or varietal.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "query": {
    "description": "Search term",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get-wishlist",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "wines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "maxPrice": {
       "type": "string"
      },
      "notes": {
       "type": "string"
      },
      "vintage": {
       "type": "string"
      },
      "wine": {
       "type": "string"
      }
     },
     "required": [
      "wine",
      "vintage"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "wines"
  ],
  "type": "object"
 }
}
