{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set topic research sources"
 },
 "description": "Use this when someone asks to choose which subreddits or RSS feeds their blog's topic research reads. Returns the saved sources; each list passed replaces the old one, and clear removes them all. Not for fetching ideas now.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blogId": {
    "description": "Blog id, or the blog's name",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "clear": {
    "description": "true removes every saved source",
    "type": "boolean"
   },
   "reddit": {
    "description": "Complete new list of up to 20 subreddit names, without /r/; replaces the old list",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9_]+$",
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "rss": {
    "description": "Complete new list of up to 20 HTTPS RSS or Atom feed URLs; replaces the old list",
    "items": {
     "format": "uri",
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "blogId"
  ],
  "type": "object"
 },
 "name": "set_topic_sources",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blog": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "reddit": {
        "items": {
         "maxLength": 100,
         "type": "string"
        },
        "maxItems": 20,
        "type": "array"
       },
       "redditTruncated": {
        "type": "boolean"
       },
       "rss": {
        "items": {
         "maxLength": 2048,
         "type": "string"
        },
        "maxItems": 20,
        "type": "array"
       },
       "rssTruncated": {
        "type": "boolean"
       }
      },
      "required": [
       "id",
       "name",
       "reddit",
       "rss",
       "redditTruncated",
       "rssTruncated"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "updated",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "blog"
  ],
  "type": "object"
 },
 "title": "Set topic research sources"
}
