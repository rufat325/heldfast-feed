{
 "description": "List account withdrawals",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Number of results (default 25, max 100)",
    "type": "number"
   },
   "marker": {
    "description": "Pagination marker",
    "type": "string"
   },
   "method": {
    "description": "Withdrawal method (e.g. spei, bitcoin)",
    "type": "string"
   },
   "sort": {
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "pending",
     "processing",
     "complete",
     "failed"
    ],
    "type": "string"
   },
   "wids": {
    "description": "Comma-separated withdrawal IDs to filter",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_withdrawals"
}
