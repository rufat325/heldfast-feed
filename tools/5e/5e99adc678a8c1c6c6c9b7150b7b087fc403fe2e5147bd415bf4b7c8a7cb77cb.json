{
 "annotations": {},
 "description": "Set a node's Export presets. Does not export; use export_screenshots.",
 "inputSchema": {
  "properties": {
   "nodeIds": {
    "description": "Node IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "settings": {
    "description": "Presets in order. [] clears them.",
    "items": {
     "properties": {
      "constraint": {
       "description": "Size for PNG/JPG: {type: SCALE|WIDTH|HEIGHT, value}. SCALE 2 = @2x.",
       "properties": {
        "type": {
         "enum": [
          "SCALE",
          "WIDTH",
          "HEIGHT"
         ],
         "type": "string"
        },
        "value": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "contentsOnly": {
       "description": "Skip content that overlaps from outside (default true)",
       "type": "boolean"
      },
      "format": {
       "description": "PNG, JPG, SVG, or PDF",
       "enum": [
        "PNG",
        "SVG",
        "JPG",
        "PDF"
       ],
       "type": "string"
      },
      "suffix": {
       "description": "File name suffix e.g. '@2x'",
       "type": "string"
      },
      "useAbsoluteBounds": {
       "description": "Use full bounds even if the parent clips the node",
       "type": "boolean"
      }
     },
     "required": [
      "format"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "nodeIds",
   "settings"
  ],
  "type": "object"
 },
 "name": "set_export_settings"
}
