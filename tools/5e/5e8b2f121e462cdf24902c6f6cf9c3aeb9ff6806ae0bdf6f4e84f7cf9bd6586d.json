{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Publish (or send as a draft) an article from the workspace library to one or more connected sites. Get site ids from list_connected_sites and article ids from list_articles or create_article. The article must have a body. Publishing again updates the existing post on that site.",
 "inputSchema": {
  "properties": {
   "articleId": {
    "description": "Article UUID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "destinationIds": {
    "description": "Connected site ids from list_connected_sites",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "status": {
    "default": "publish",
    "description": "publish (live, default) or draft on the site",
    "enum": [
     "publish",
     "draft"
    ],
    "type": "string"
   }
  },
  "required": [
   "articleId",
   "destinationIds",
   "status"
  ],
  "type": "object"
 },
 "name": "publish_article",
 "outputSchema": {
  "description": "Output payload for publish_article",
  "properties": {
   "result": {
    "description": "Structured output from tool execution",
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Publish article"
}
