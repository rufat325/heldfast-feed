{
 "description": "Compare current on-chain ERC-20 allowance with caller-supplied prior allowance; no transaction submitted. Costs $0.001 USDC on Base via x402.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contract": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "network": {
    "enum": [
     "base",
     "ethereum"
    ],
    "type": "string"
   },
   "owner": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "previous_allowance_raw": {
    "pattern": "^\\d+$",
    "type": "string"
   },
   "spender": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "required": [
   "owner",
   "spender",
   "contract",
   "previous_allowance_raw"
  ],
  "type": "object"
 },
 "name": "erc20-allowance-delta"
}
