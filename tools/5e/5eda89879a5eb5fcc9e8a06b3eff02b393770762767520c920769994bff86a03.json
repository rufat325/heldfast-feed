{
 "description": "Get a single ACF field value for a post",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "field": {
    "description": "Field name or key (lowercased by the endpoint)",
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "format": {
    "description": "formatted (default): values as get_field returns them; raw: unformatted stored values",
    "enum": [
     "formatted",
     "raw"
    ],
    "type": "string"
   },
   "post_id": {
    "description": "Post ID",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "post_id",
   "field"
  ],
  "type": "object"
 },
 "name": "acf_get_post_field"
}
