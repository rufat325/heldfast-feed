{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "eth_feeHistory over a bounded window: base fee at every block plus the 25/50/75 priority-fee percentiles. Whether gas is RISING is not answerable from one instantaneous quote, which is what /chain/fee-data gives. Costs $0.001 USDC per call. Chains: base, ethereum, arbitrum, bsc, polygon, optimism, avalanche. Byte-identical to GET /chain/fee-history?chain=base&blocks=20.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blocks": {
    "description": "window size in blocks (bounded) (default 20)",
    "type": "string"
   },
   "chain": {
    "description": "chain key: base, ethereum, arbitrum, bsc, polygon, optimism, avalanche [required]",
    "type": "string"
   }
  },
  "required": [
   "chain"
  ],
  "type": "object"
 },
 "name": "chain_fee_history",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baseFeeGwei": {
    "additionalProperties": {},
    "type": "object"
   },
   "blocksCovered": {
    "type": "integer"
   },
   "caveat": {
    "type": [
     "string",
     "null"
    ]
   },
   "chain": {
    "type": [
     "string",
     "null"
    ]
   },
   "chainId": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "chainLabel": {
    "type": [
     "string",
     "null"
    ]
   },
   "gasUsedRatio": {
    "items": {},
    "type": "array"
   },
   "head": {
    "type": "integer"
   },
   "label": {
    "type": "string"
   },
   "note": {
    "type": [
     "string",
     "null"
    ]
   },
   "oldestBlock": {
    "type": "integer"
   },
   "perBlockBaseFeeGwei": {
    "items": {},
    "type": "array"
   },
   "priorityFeeGwei": {
    "additionalProperties": {},
    "type": "object"
   },
   "reason": {
    "type": [
     "string",
     "null"
    ]
   },
   "source": {
    "type": "string"
   },
   "stale": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "trendPct": {
    "type": "integer"
   },
   "ts": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Base-fee and priority-fee trend"
}
