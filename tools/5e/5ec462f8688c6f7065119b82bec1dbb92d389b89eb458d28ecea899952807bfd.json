{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Compare retained local snapshots of the same board, reporting cluster, node and connector changes. Names each changed node with its section and its old and new text, and each changed table cell with its row and column. Requires at least two distinct ingests. compareTo=1 selects the previous snapshot, 2 selects two states back. No network or LLM calls; ingest_board must capture the current Figma state first.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"boardId":{"description":"The Figma file key, as returned by ingest_board","maxLength":128,"minLength":6,"pattern":"^[A-Za-z0-9]+$","type":"string"},"compareTo":{"default":1,"description":"How many snapshots back to use as the baseline (1 = the ingest before the latest)","maximum":19,"minimum":1,"type":"integer"}},"required":["boardId"],"type":"object"},"name":"diff_board","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"addedConnections":{"items":{"type":"string"},"type":"array"},"baselineCreatedAt":{"description":"ISO timestamp of the baseline ingest","type":"string"},"baselineSnapshotId":{"type":"string"},"boardId":{"maxLength":128,"minLength":6,"pattern":"^[A-Za-z0-9]+$","type":"string"},"currentCreatedAt":{"description":"ISO timestamp of the latest ingest","type":"string"},"currentSnapshotId":{"type":"string"},"modifiedClusters":{"items":{"additionalProperties":false,"properties":{"addedNodeCount":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"editedNodeCount":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"label":{"type":"string"},"previousLabel":{"type":"string"},"removedNodeCount":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"section":{"description":"Name of the innermost section around the cluster; absent outside sections","type":"string"}},"require