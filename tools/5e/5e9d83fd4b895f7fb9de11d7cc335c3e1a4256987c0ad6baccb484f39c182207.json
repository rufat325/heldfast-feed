{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Extract a citation-ready YouTube transcript without requiring a YouTube API key. Accepts a video ID or URL and returns timestamped source links that agents can cite and open directly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "contextLines": {
    "description": "Nearby segments to include around query matches",
    "maximum": 5,
    "minimum": 0,
    "type": "integer"
   },
   "endSeconds": {
    "description": "Only inspect captions at or before this time",
    "minimum": 0,
    "type": "number"
   },
   "language": {
    "description": "Caption language code, for example en, ko, or ja",
    "type": "string"
   },
   "matchMode": {
    "description": "Whole-word matching is the default",
    "enum": [
     "word",
     "substring"
    ],
    "type": "string"
   },
   "maxSegments": {
    "description": "Maximum citations to return; defaults to 200",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Result offset for pagination",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Return only matching transcript segments",
    "minLength": 1,
    "type": "string"
   },
   "startSeconds": {
    "description": "Only inspect captions at or after this time",
    "minimum": 0,
    "type": "number"
   },
   "video": {
    "description": "YouTube video ID or URL",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "video"
  ],
  "type": "object"
 },
 "name": "research-video",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "citations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "type": "string"
      },
      "seconds": {
       "minimum": 0,
       "type": "number"
      },
      "sourceUrl": {
       "format": "uri",
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "timestamp": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "timestamp",
      "seconds",
      "text",
      "sourceUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "durationSeconds": {
    "minimum": 0,
    "type": "number"
   },
   "language": {
    "type": "string"
   },
   "matchMode": {
    "anyOf": [
     {
      "enum": [
       "word",
       "substring"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "nextOffset": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "type": [
     "string",
     "null"
    ]
   },
   "returnedSegments": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "channelId": {
      "type": [
       "string",
       "null"
      ]
     },
     "channelName": {
      "type": [
       "string",
       "null"
      ]
     },
     "channelUrl": {
      "anyOf": [
       {
        "format": "uri",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "thumbnailUrl": {
      "anyOf": [
       {
        "format": "uri",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "title": {
      "type": "string"
     },
     "videoId": {
      "type": "string"
     },
     "videoUrl": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "videoId",
     "title",
     "videoUrl",
     "channelId",
     "channelName",
     "channelUrl",
     "thumbnailUrl"
    ],
    "type": "object"
   },
   "sourceUrl": {
    "format": "uri",
    "type": "string"
   },
   "timeRange": {
    "additionalProperties": false,
    "properties": {
     "endSeconds": {
      "type": [
       "number",
       "null"
      ]
     },
     "startSeconds": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "startSeconds",
     "endSeconds"
    ],
    "type": "object"
   },
   "totalAvailableSegments": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "totalTranscriptSegments": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   },
   "videoId": {
    "type": "string"
   }
  },
  "required": [
   "videoId",
   "sourceUrl",
   "source",
   "language",
   "query",
   "matchMode",
   "timeRange",
   "totalTranscriptSegments",
   "totalAvailableSegments",
   "returnedSegments",
   "offset",
   "truncated",
   "nextOffset",
   "durationSeconds",
   "citations"
  ],
  "type": "object"
 },
 "title": "Research a YouTube video"
}
