{
 "description": "Apply one versioned ownership action: assign, accept, decline, release, reassign, offer an evidence-bearing handoff, or reopen terminal work.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Ownership action to apply through the versioned task state machine",
    "enum": [
     "assign",
     "accept",
     "decline",
     "release",
     "reassign",
     "offer",
     "reopen"
    ],
    "type": "string"
   },
   "agent_id": {
    "description": "Usually omit \u2014 Concord derives your identity from your session. Pass only the id your client told you (Codex); a session Concord can see always wins.",
    "minLength": 1,
    "type": "string"
   },
   "assumptions": {
    "description": "Assumptions made",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "changed_files": {
    "description": "Files that changed",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "decisions": {
    "description": "Notable decisions and why",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "expected_version": {
    "description": "Task version last read by the caller; stale versions are rejected",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "expires_seconds": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "force": {
    "type": "boolean"
   },
   "guardrails_checked": {
    "description": "Guardrails checked",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "handoff_id": {
    "description": "Pending handoff to resolve; inferred from the task when omitted",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "known_risks": {
    "description": "Known risks introduced",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "lease_seconds": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "next_steps": {
    "description": "Remaining work or follow-ups",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reason": {
    "minLength": 1,
    "type": "string"
   },
   "task_id": {
    "description": "Stable task identifier, e.g. TASK-12",
    "minLength": 1,
    "type": "string"
   },
   "tests_run": {
    "description": "Test commands run",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "to_agent_id": {
    "description": "Required for assign, reassign, and offer",
    "minLength": 1,
    "type": "string"
   },
   "what_changed": {
    "description": "Required for offer",
    "minLength": 1,
    "type": "string"
   },
   "workspace_id": {
    "description": "Workspace id returned by a Concord operation. Omit to use the automatically resolved repository workspace.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "action",
   "expected_version"
  ],
  "type": "object"
 },
 "name": "transfer_work",
 "title": "Transfer work"
}
