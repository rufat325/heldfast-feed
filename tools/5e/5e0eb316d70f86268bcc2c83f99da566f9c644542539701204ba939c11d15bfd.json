{
 "annotations": {
  "readOnlyHint": true,
  "title": "List staff shifts"
 },
 "description": "List staff working shifts at one location for a date range \u2014 clock-in/out times, weekday, availability and recurrence. GraphQL: shifts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "end_date": {
    "description": "Last date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "location_id": {
    "description": "Location id, e.g. urn:blvd:Location:<uuid> (from boulevard_list_locations).",
    "minLength": 1,
    "type": "string"
   },
   "staff_ids": {
    "description": "Only these staff ids.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "start_date": {
    "description": "First date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "location_id",
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "boulevard_list_shifts",
 "title": "List staff shifts"
}
