{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Request a layout repair for one managed clip, such as preserving a screen demo or moving captions away from faces. Changes that clip's project; preserves the other clips.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "clipId": {
    "default": null,
    "type": [
     "string",
     "null"
    ]
   },
   "idempotencyKey": {
    "default": null,
    "type": [
     "string",
     "null"
    ]
   },
   "repairMode": {
    "default": "auto",
    "enum": [
     "auto",
     "prefer_split",
     "prefer_focus",
     "prefer_tutorial",
     "prefer_demo",
     "move_captions_off_faces"
    ],
    "type": "string"
   },
   "workspaceId": {
    "description": "UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "clipId",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "clips_repair",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "Repair One Clip Layout"
}
