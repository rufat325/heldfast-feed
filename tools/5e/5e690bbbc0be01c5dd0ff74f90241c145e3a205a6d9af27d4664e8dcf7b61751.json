{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Group tickets by the values of one tag prefix (e.g. team), with ticket count and average priority per value.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "prefix": {
    "description": "Tag prefix to group by",
    "type": "string"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   }
  },
  "required": [
   "prefix"
  ],
  "type": "object"
 },
 "name": "report_group",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
     "additionalProperties": false,
     "properties": {
      "averagePriority": {
       "type": "number"
      },
      "ticketCount": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "value",
      "ticketCount",
      "averagePriority"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
