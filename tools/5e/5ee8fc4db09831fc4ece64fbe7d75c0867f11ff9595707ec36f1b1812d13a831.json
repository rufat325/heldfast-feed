{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get monitoring results for a WMS scenario over a time range",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Start time (Unix timestamp)",
    "type": "number"
   },
   "locationTypeCodes": {
    "description": "Agent locations, comma-separated (KR, USW, JP, SG, DE)",
    "type": "string"
   },
   "resultStatus": {
    "description": "Filter by result status",
    "enum": [
     "SUCCESS",
     "ERROR"
    ],
    "type": "string"
   },
   "scenarioId": {
    "description": "Scenario ID",
    "type": "number"
   },
   "to": {
    "description": "End time (Unix timestamp)",
    "type": "number"
   },
   "type": {
    "description": "Data aggregation type",
    "enum": [
     "RAW",
     "MIN5",
     "MIN30",
     "HOUR2",
     "DAY1"
    ],
    "type": "string"
   }
  },
  "required": [
   "scenarioId",
   "from",
   "to",
   "type"
  ],
  "type": "object"
 },
 "name": "ncloud_wms_get_results"
}
