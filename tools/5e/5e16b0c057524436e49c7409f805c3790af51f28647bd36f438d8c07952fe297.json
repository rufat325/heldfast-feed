{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search"
 },
 "description": "Searches the Lightbringer organisation's documents (inventions, patent applications, and reports) and meetings. The \"meeting\" category filters by title, reference, or indexed transcript/canvas text. Meeting result IDs resolve through fetch to canvas and transcript text. Returns matching results, each with an ID, title, and summary. A document result also lists its parts: the texts it has accumulated across its lifecycle (innovation description, priority draft, application text revisions), each with an ID that fetch accepts. Supports cursor-based pagination; omitting query lists accessible records in the selected category. Saved own application and patent results can include a structured family overview: accessible members, jurisdictions, recorded statuses, priority provenance and coverage limits. Its refresh assessment compares stored references with saved links without calling a provider or changing records. Document content is indexed asynchronously, so a recently created or edited document can take a short while to become searchable; an empty result reflects the current index and does not by itself establish that a matching document is absent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "enum": [
     "application",
     "patent",
     "innovation",
     "competitor_application",
     "report",
     "meeting"
    ],
    "type": "string"
   },
   "cursor": {
    "description": "Opaque cursor from a previous search response",
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free-text search query",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "nextCursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "family": {
       "additionalProperties": false,
       "properties": {
        "applicationCount": {
         "description": "Accessible saved application records in this group, including the selected record",
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "coverage": {
         "const": "unverified",
         "type": "string"
        },
        "groupingKey": {
         "description": "Representative accessible document key for grouping saved records; can change with links or access, not a global family ID",
         "type": "string"
        },
        "members": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "applicationNumber": {
            "type": [
             "string",
             "null"
            ]
           },
           "applicationType": {
            "type": "string"
           },
           "documentId": {
            "type": "string"
           },
           "filingDate": {
            "type": [
             "string",
             "null"
            ]
           },
           "publicationNumber": {
            "type": [
             "string",
             "null"
            ]
           },
           "recordedStatus": {
            "type": [
             "string",
             "null"
            ]
           },
           "refNum": {
            "type": [
             "string",
             "null"
            ]
           },
           "region": {
            "type": [
             "string",
             "null"
            ]
           },
           "relationship": {
            "enum": [
             "self",
             "parent",
             "child",
             "other_related"
            ],
            "type": "string"
           },
           "title": {
            "type": [
             "string",
             "null"
            ]
           }
          },
          "required": [
           "documentId",
           "title",
           "refNum",
           "applicationType",
           "region",
           "applicationNumber",
           "publicationNumber",
           "filingDate",
           "recordedStatus",
           "relationship"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "membersTruncated": {
         "type": "boolean"
        },
        "priorityDate": {
         "type": [
          "string",
          "null"
         ]
        },
        "priorityDateSource": {
         "enum": [
          "imported",
          "earliest_saved_priority_filing",
          "unknown"
         ],
         "type": "string"
        },
        "recordedPublicationCount": {
         "description": "Distinct publication numbers recorded on these applications, not all publications or inventions",
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "refresh": {
         "additionalProperties": false,
         "properties": {
          "ambiguousReferenceCount": {
           "anyOf": [
            {
             "maximum": 9007199254740991,
             "minimum": 0,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ]
          },
          "assessment": {
           "description": "Read-only assessment of this record\u2019s stored references. Missing links have accessible saved matches. Unresolved references need investigation; unknown and no_known_gap do not establish complete coverage.",
           "enum": [
            "missing_links",
            "unresolved_references",
            "unknown",
            "no_known_gap",
            "unsupported"
           ],
           "type": "string"
          },
          "eligible": {
           "description": "Whether this own record has a usable publication number; does not establish write permission",
           "type": "boolean"
          },
          "lastRefreshedAt": {
           "description": "Last recorded explicit provider family refresh; null means the refresh date is unknown",
           "type": [
            "string",
            "null"
           ]
          },
          "missingLinkCount": {
           "anyOf": [
            {
             "maximum": 9007199254740991,
             "minimum": 0,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ]
          },
          "references": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "applicationNumber": {
              "type": "string"
             },
             "direction": {
              "enum": [
               "parent",
               "child"
              ],
              "type": "string"
             },
             "documentId": {
              "type": [
               "string",
               "null"
              ]
             },
             "publicationNumber": {
              "type": [
               "string",
               "null"
              ]
             },
             "status": {
              "enum": [
               "linked",
               "missing_link",
               "unmatched",
               "ambiguous"
              ],
              "type": "string"
             }
            },
            "required": [
             "direction",
             "applicationNumber",
             "publicationNumber",
             "status",
             "documentId"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "referencesAvailable": {
           "type": "boolean"
          },
          "referencesTruncated": {
           "type": "boolean"
          },
          "unmatchedReferenceCount": {
           "anyOf": [
            {
             "maximum": 9007199254740991,
             "minimum": 0,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "eligible",
          "assessment",
          "referencesAvailable",
          "lastRefreshedAt",
          "missingLinkCount",
          "unmatchedReferenceCount",
          "ambiguousReferenceCount",
          "references",
          "referencesTruncated"
         ],
         "type": "object"
        },
        "regions": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "scope": {
         "const": "accessible_saved_records",
         "type": "string"
        }
       },
       "required": [
        "groupingKey",
        "scope",
        "applicationCount",
        "recordedPublicationCount",
        "regions",
        "priorityDate",
        "priorityDateSource",
        "members",
        "membersTruncated",
        "coverage",
        "refresh"
       ],
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "metadata": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "part": {
       "type": "string"
      },
      "parts": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "createdAt": {
          "type": [
           "string",
           "null"
          ]
         },
         "id": {
          "type": "string"
         },
         "label": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
         },
         "part": {
          "enum": [
           "disclosure",
           "priority_draft",
           "application_text"
          ],
          "type": "string"
         },
         "revisionId": {
          "type": [
           "string",
           "null"
          ]
         },
         "revisionType": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "id",
         "part",
         "label"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "text": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "text",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search"
}
