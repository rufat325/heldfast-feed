    "type": "string"
   },
   "name": {
    "description": "Filter by device name.",
    "type": "string"
   },
   "os_name": {
    "description": "Filter by operating system name.",
    "type": "string"
   },
   "os_version": {
    "description": "Filter by OS version string.",
    "type": "string"
   }
  },
  "required": [
