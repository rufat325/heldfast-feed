{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The signed-in student's grades for a term from the Testudo student portal: final grades once posted, mid-term grades while the term runs, and the semester and cumulative GPA. Use testudo_list_terms with kind \"grades\" for the terms available. Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "term_id": {
    "description": "Four-digit year followed by \"01\" (Spring), \"05\" (Summer), \"08\" (Fall) or \"12\" (Winter), e.g. \"202608\" for Fall 2026",
    "pattern": "^\\d{4}(01|05|08|12)$",
    "type": "string"
   }
  },
  "required": [
   "term_id"
  ],
  "type": "object"
 },
 "name": "testudo_get_grades",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "academic_action": {
    "description": "Academic action (probation, dismissal, dean's list, ...) recorded for the term; null if none",
    "type": [
     "string",
     "null"
    ]
   },
   "final_grades": {
    "description": "Courses with final grades; empty until grades are posted",
    "items": {
     "additionalProperties": false,
     "properties": {
      "course": {
       "description": "Course id, e.g. \"CMSC131\" or \"ENGL101X\"",
       "pattern": "^[A-Za-z]{4}\\d{3}[A-Za-z]?$",
       "type": "string"
      },
      "credits": {
       "description": "Credits the course is worth",
       "type": [
        "number",
        "null"
       ]
      },
      "grade": {
       "description": "Grade as posted, e.g. \"A-\"; null when not yet posted",
       "type": [
        "string",
        "null"
       ]
      },
      "section": {
       "anyOf": [
        {
         "description": "Section id, e.g. \"0101\"",
         "pattern": "^[A-Za-z0-9]{4}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "description": "Course title",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "course",
      "section",
      "title",
      "credits",
      "grade"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "gpa": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "cumulative": {
        "description": "Cumulative GPA through this term",
        "type": [
         "number",
         "null"
        ]
       },
       "semester": {
        "description": "GPA for this term",
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "semester",
       "cumulative"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "null until the term has posted grades"
   },
   "midterm_grades": {
    "description": "Courses with mid-term grades; empty outside the mid-term window",
    "items": {
     "additionalProperties": false,
     "properties": {
      "course": {
       "description": "Course id, e.g. \"CMSC131\" or \"ENGL101X\"",
       "pattern": "^[A-Za-z]{4}\\d{3}[A-Za-z]?$",
       "type": "string"
      },
      "credits": {
       "description": "Credits the course is worth",
       "type": [
        "number",
        "null"
       ]
      },
      "grade": {
       "description": "Grade as posted, e.g. \"A-\"; null when not yet posted",
       "type": [
        "string",
        "null"
       ]
      },
      "section": {
       "anyOf": [
        {
         "description": "Section id, e.g. \"0101\"",
         "pattern": "^[A-Za-z0-9]{4}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "description": "Course title",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "course",
      "section",
      "title",
      "credits",
      "grade"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "term": {
    "description": "Four-digit year followed by \"01\" (Spring), \"05\" (Summer), \"08\" (Fall) or \"12\" (Winter), e.g. \"202608\" for Fall 2026",
    "pattern": "^\\d{4}(01|05|08|12)$",
    "type": "string"
   }
  },
  "required": [
   "term",
   "final_grades",
   "midterm_grades",
   "gpa",
   "academic_action"
  ],
  "type": "object"
 },
 "title": "Get grades"
}
