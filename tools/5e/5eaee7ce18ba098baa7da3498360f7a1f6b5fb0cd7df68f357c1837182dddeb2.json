{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hotelumo:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List your hotels"
 },
 "description": "Use this when someone asks which hotels or properties they manage in Hotelumo, or a hotel's id is needed. Returns each hotel's id, name, currency, language and timezone, 20 per page by default (no addresses or guest data). Not for room availability.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Hotels per page, from 1 to 100; defaults to 20",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "offset": {
    "description": "Hotels to skip, from 0 to 10000; defaults to 0. For the next page pass offset + limit",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_hotels",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hotels": {
    "description": "Hotels in the signed-in organization. Addresses, phone numbers, channel credentials, payment configuration, reminder configuration and guest data are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "currency": {
       "$ref": "#/properties/hotels/items/properties/name"
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "lastEditTime": {
       "$ref": "#/properties/hotels/items/properties/name"
      },
      "locale": {
       "$ref": "#/properties/hotels/items/properties/name"
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "timezone": {
       "$ref": "#/properties/hotels/items/properties/name"
      }
     },
     "required": [
      "id",
      "name",
      "currency",
      "locale",
      "timezone",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "page": {
    "additionalProperties": false,
    "description": "hasMore is true when another page exists; request it with offset + limit",
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "type": "integer"
     },
     "offset": {
      "maximum": 10000,
      "minimum": 0,
      "type": "integer"
     },
     "returned": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "limit",
     "offset",
     "returned",
     "hasMore"
    ],
    "type": "object"
   }
  },
  "required": [
   "hotels",
   "page"
  ],
  "type": "object"
 },
 "title": "List your hotels"
}
