{
 "description": "Create, delete, list, inspect, move cards between, and configure Anki decks. Use this for deck-level organization, not for editing flashcard fields, note types, or study answers. Create, delete, move, and config operations mutate the collection; list and stats/config reads do not. Set `operation` first and supply the matching deck names, card IDs, target deck, or config ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cardIds": {
    "description": "Card IDs to move",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "configId": {
    "description": "Config ID to apply",
    "type": "number"
   },
   "deckName": {
    "description": "Deck name",
    "type": "string"
   },
   "deckNames": {
    "description": "Deck names (for batch operations)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "deleteCards": {
    "description": "Delete cards when deleting deck",
    "type": "boolean"
   },
   "operation": {
    "description": "Deck management operation",
    "enum": [
     "create",
     "delete",
     "list",
     "get_stats",
     "move_cards",
     "get_config",
     "set_config"
    ],
    "type": "string"
   },
   "targetDeck": {
    "description": "Target deck for moving cards",
    "type": "string"
   }
  },
  "required": [
   "operation"
  ],
  "type": "object"
 },
 "name": "manage_decks"
}
