{
 "description": "Send money out to a beneficiary in a LatAm country. Used for marketplace seller payouts, creator payouts, and cross-border settlement.",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "Payout amount in major units",
    "type": "number"
   },
   "beneficiary": {
    "description": "Beneficiary object with identity + destination account",
    "properties": {
     "bank_account": {
      "description": "Bank account details (country-specific fields)",
      "type": "object"
     },
     "document": {
      "description": "Tax ID",
      "type": "string"
     },
     "email": {
      "description": "Email",
      "type": "string"
     },
     "name": {
      "description": "Full name",
      "type": "string"
     }
    },
    "required": [
     "name",
     "document"
    ],
    "type": "object"
   },
   "country": {
    "description": "Destination country ISO-3166 alpha-2",
    "type": "string"
   },
   "currency": {
    "description": "ISO-4217 currency code",
    "type": "string"
   },
   "description": {
    "description": "Payout description",
    "type": "string"
   },
   "notification_url": {
    "description": "Webhook URL for payout status updates",
    "type": "string"
   },
   "order_id": {
    "description": "Merchant-side payout reference",
    "type": "string"
   },
   "payment_method_id": {
    "description": "Destination method (BA for bank account, varies by country)",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "currency",
   "country",
   "payment_method_id",
   "beneficiary",
   "order_id"
  ],
  "type": "object"
 },
 "name": "create_payout"
}
