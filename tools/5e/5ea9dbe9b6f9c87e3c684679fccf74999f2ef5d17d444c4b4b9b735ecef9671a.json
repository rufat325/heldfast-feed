{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Prepare a canonical PT-BR OiAir form link for one exact organization, publication and expected version. Trial requires that the selected group offers a trial. Opening the link and submitting a request are separate actions; this tool neither submits a request nor reserves or confirms a place.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expectedVersion": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "organizationId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "publicationId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "visit": {
    "enum": [
     "trial",
     "regular"
    ],
    "type": "string"
   }
  },
  "required": [
   "organizationId",
   "publicationId",
   "expectedVersion"
  ],
  "type": "object"
 },
 "name": "get_booking_link",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bookingSemantics": {
    "additionalProperties": false,
    "properties": {
     "availability": {
      "const": "unknown",
      "type": "string"
     },
     "bookingMode": {
      "const": "request_confirmation",
      "type": "string"
     },
     "createsRequest": {
      "const": false,
      "type": "boolean"
     },
     "requiresOrganizationConfirmation": {
      "const": true,
      "type": "boolean"
     },
     "reservesSeat": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "availability",
     "bookingMode",
     "createsRequest",
     "reservesSeat",
     "requiresOrganizationConfirmation"
    ],
    "type": "object"
   },
   "checkedAt": {
    "type": "string"
   },
   "offeringId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "organizationId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "publicationId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "source": {
    "const": "organization_confirmation",
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   },
   "validUntil": {
    "type": "string"
   },
   "version": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "visit": {
    "enum": [
     "trial",
     "regular"
    ],
    "type": "string"
   }
  },
  "required": [
   "organizationId",
   "publicationId",
   "offeringId",
   "version",
   "url",
   "visit",
   "source",
   "checkedAt",
   "validUntil",
   "bookingSemantics"
  ],
  "type": "object"
 }
}
