{
 "annotations": {
  "idempotentHint": true
 },
 "description": "Submit one or more facts to the knowledge base. Facts with matching content will be updated. Call this immediately when learning something new - do not wait for user prompting.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "facts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "minLength": 1,
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "sourceType": {
       "enum": [
        "user",
        "documentation",
        "code",
        "inference"
       ],
       "type": "string"
      },
      "tags": {
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "type": "array"
      },
      "verified": {
       "default": false,
       "type": "boolean"
      }
     },
     "required": [
      "content",
      "tags"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "facts"
  ],
  "type": "object"
 },
 "name": "submit_facts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "created": {
    "type": "number"
   },
   "facts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "id": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "updated": {
    "type": "number"
   }
  },
  "required": [
   "created",
   "updated",
   "facts"
  ],
  "type": "object"
 },
 "title": "Submit Facts"
}
