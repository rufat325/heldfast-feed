{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add a JSON job using the write token and a stable job_key. The same key and payload return the original job. Changing the payload for that key is a conflict. Payloads are limited to 16 KiB encoded JSON and must contain no secrets or personal data. The 100-job lifetime limit includes completed and failed jobs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "job_key": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
    "type": "string"
   },
   "payload": {
    "description": "Required JSON value, including null. Maximum encoded size: 16384 bytes."
   },
   "queue_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   },
   "write_token": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "queue_id",
   "write_token",
   "job_key",
   "payload"
  ],
  "type": "object"
 },
 "name": "enqueue_agent_queue_job",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "deduplicated": {
    "type": "boolean"
   },
   "expire_timestamp": {
    "type": "integer"
   },
   "job": {
    "additionalProperties": false,
    "properties": {
     "attempts": {
      "maximum": 5,
      "minimum": 0,
      "type": "integer"
     },
     "claimed_until_timestamp": {
      "type": [
       "integer",
       "null"
      ]
     },
     "created_at_timestamp": {
      "type": "integer"
     },
     "expire_timestamp": {
      "type": "integer"
     },
     "job_id": {
      "pattern": "^[a-f0-9]{32}$",
      "type": "string"
     },
     "job_key": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$",
      "type": "string"
     },
     "payload": {},
     "status": {
      "enum": [
       "pending",
       "claimed",
       "completed",
       "failed"
      ],
      "type": "string"
     }
    },
    "required": [
     "job_id",
     "job_key",
     "payload",
     "status",
     "attempts",
     "created_at_timestamp",
     "expire_timestamp",
     "claimed_until_timestamp"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "queue_id": {
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   }
  },
  "required": [
   "ok",
   "queue_id",
   "expire_timestamp",
   "job",
   "deduplicated"
  ],
  "type": "object"
 },
 "title": "Enqueue agent queue job"
}
