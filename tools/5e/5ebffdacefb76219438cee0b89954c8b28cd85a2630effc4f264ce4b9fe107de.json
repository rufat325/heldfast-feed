{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Detect Repeated Takes"
 },
 "description": "Detect repeated sentence takes (retakes) in a word timeline using token similarity within a time window, and plan removal of all but the kept take. Returns take groups, removal and keep ranges, and apply routes. Local-only; never changes Premiere.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expected_cep_target": {
    "additionalProperties": false,
    "anyOf": [
     {
      "required": [
       "sequence_id"
      ]
     },
     {
      "required": [
       "source_item"
      ]
     }
    ],
    "description": "Optional reviewed CEP sequence/clip identity and exact tick ranges. Checked before every generated command; UXP refuses this CEP-only guard.",
    "properties": {
     "backend": {
      "const": "cep",
      "description": "Backend namespace for these IDs.",
      "type": "string"
     },
     "clip": {
      "additionalProperties": false,
      "description": "Optional exact reviewed timeline clip.",
      "properties": {
       "effect": {
        "additionalProperties": false,
        "description": "Reviewed effect and parameter identity checked before mutation.",
        "properties": {
         "display_name": {
          "description": "Optional exact host display name.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         "match_name": {
          "description": "Effect match name from host inspection.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         "parameter_index": {
          "description": "Inspected zero-based parameter index.",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
         },
         "parameter_name": {
          "description": "Exact inspected parameter name.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "match_name",
         "parameter_index",
         "parameter_name"
        ],
        "type": "object"
       },
       "end_ticks": {
        "description": "Exact expected exclusive timeline end ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "in_ticks": {
        "description": "Exact expected source In ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "node_id": {
        "description": "Stable CEP node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "out_ticks": {
        "description": "Exact expected exclusive source Out ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "project_item_id": {
        "description": "Expected source project-item node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "start_ticks": {
        "description": "Exact expected timeline start ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "track_index": {
        "description": "Expected zero-based track index; identity still checked.",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       },
       "track_type": {
        "description": "Expected media track group.",
        "enum": [
         "video",
         "audio"
        ],
        "type": "string"
       }
      },
      "required": [
       "node_id",
       "track_type",
       "track_index"
      ],
      "type": "object"
     },
     "project_document_id": {
      "description": "Exact Premiere project document ID observed during review.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "sequence_id": {
      "description": "Stable expected active sequence ID.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "source_item": {
      "additionalProperties": false,
      "description": "Reviewed source identity for a source-only operation.",
      "properties": {
       "media_path": {
        "description": "Optional exact source-media path.",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
       },
       "node_id": {
        "description": "Exact project-item node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "node_id"
      ],
      "type": "object"
     }
    },
    "required": [
     "backend"
    ],
    "type": "object"
   },
   "expected_project_path": {
    "description": "Optional absolute saved-project path. Every generated CEP command refuses before its body when the active project differs or is unsaved. UXP commands refuse this CEP-only guard; local-only tools do not inspect Premiere. Omit to keep existing behavior.",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "frame_rate": {
    "description": "Timebase used to snap ranges to whole frames; defaults to 30.",
    "maximum": 240,
    "minimum": 1,
    "type": "number"
   },
   "handle_frames": {
    "description": "Frames of handle left inside each removal so cuts are not tight; defaults to 1.",
    "maximum": 24,
    "minimum": 0,
    "type": "integer"
   },
   "keep": {
    "description": "Which take in each group to keep; defaults to last.",
    "enum": [
     "last",
     "first"
    ],
    "type": "string"
   },
   "max_gap_seconds": {
    "description": "Only sentences starting within this many seconds of an earlier candidate are compared; defaults to 20.",
    "maximum": 120,
    "minimum": 1,
    "type": "number"
   },
   "max_groups": {
    "description": "Maximum take groups to return; defaults to 64.",
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   },
   "min_words": {
    "description": "Minimum tokens a sentence needs before it is compared; defaults to 4.",
    "maximum": 20,
    "minimum": 3,
    "type": "integer"
   },
   "similarity_threshold": {
    "description": "Token Jaccard/containment similarity needed to group two sentences; defaults to 0.8.",
    "maximum": 1,
    "minimum": 0.6,
    "type": "number"
   },
   "word_timeline": {
    "additionalProperties": false,
    "description": "Caller-supplied word-timed transcript for one Premiere source item. Words must be ordered by start time and bound to the transcript revision returned by get_clip_transcript_uxp. Different labeled speakers may overlap; same-speaker words may not, even when another speaker is between them.",
    "properties": {
     "source_project_item_id": {
      "description": "Exact Premiere source project-item ID.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "transcript_revision": {
      "description": "Revision returned by get_clip_transcript_uxp.",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "words": {
      "description": "Ordered word tokens with source-time boundaries.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "confidence": {
         "description": "Optional recognizer confidence.",
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "end_seconds": {
         "description": "Word end in source seconds.",
         "exclusiveMinimum": 0,
         "maximum": 86400,
         "type": "number"
        },
        "speaker_label": {
         "description": "Optional caller-normalized speaker label.",
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        "start_seconds": {
         "description": "Word start in source seconds.",
         "maximum": 86400,
         "minimum": 0,
         "type": "number"
        },
        "text": {
         "description": "Word token, punctuation allowed.",
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "text",
        "start_seconds",
        "end_seconds"
       ],
       "type": "object"
      },
      "maxItems": 20000,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "source_project_item_id",
     "transcript_revision",
     "words"
    ],
    "type": "object"
   }
  },
  "required": [
   "word_timeline"
  ],
  "type": "object"
 },
 "name": "detect_repeated_takes",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true; on failure, diagnostic detail when the tool provides it."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "receipt": {
    "additionalProperties": true,
    "description": "Versioned common mutation receipt; success never implies rendered verification.",
    "type": "object"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Detect Repeated Takes"
}
