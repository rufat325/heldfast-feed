{
 "description": "Scans SQL for dangerous patterns before execution \u2014 DELETE/UPDATE without WHERE, DROP/TRUNCATE, tautologies (WHERE 1=1), stacked statements, UNION-based injection, and privilege changes. Comment- and string-literal-aware; no database connection. Returns PASS/FLAG/BLOCK with findings.",
 "inputSchema": {
  "properties": {
   "dialect": {
    "description": "SQL dialect (default generic).",
    "enum": [
     "postgres",
     "mysql",
     "sqlite",
     "tsql",
     "generic"
    ],
    "type": "string"
   },
   "policy": {
    "properties": {
     "allowDdl": {
      "type": "boolean"
     },
     "allowUnboundedWrites": {
      "type": "boolean"
     },
     "blockSeverityAtOrAbove": {
      "enum": [
       "low",
       "medium",
       "high",
       "critical"
      ],
      "type": "string"
     },
     "maxStatements": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "sql": {
    "description": "The SQL to scan.",
    "type": "string"
   }
  },
  "required": [
   "sql"
  ],
  "type": "object"
 },
 "name": "scan_sql"
}
