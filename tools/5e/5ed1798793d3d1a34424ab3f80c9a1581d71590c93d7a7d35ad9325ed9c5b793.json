 "description": "Records the opening deposit a founder chose for their banking application. This stores an intention only \u2014 it does not move money, and no funds are transferred by any part of Lovie today. Never tell the user their deposit has been sent.",
 "inputSchema": {
  "properties": {
   "amount": {
    "maxLength": 30,
    "minLength": 1,
    "pattern": "^[0-9]+\\.[0-9]{1,4}$",
    "type": "string"
   },
   "applicationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "currencyCode": {
    "maxLength": 3,
    "pattern": "^([A-Z]{3})?$",
    "type": "string"
   }
  },
  "required": [
   "applicationId"
  ],
  "type": "object"
 },
