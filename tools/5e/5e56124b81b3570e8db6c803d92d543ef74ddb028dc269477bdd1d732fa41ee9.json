{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Scrape and render web pages to get HTML content. Supports JavaScript execution, custom headers, scrolling, and content manipulation. Returns clean HTML or raw HTML.",
 "inputSchema": {
  "properties": {
   "auto_proxy": {
    "description": "Auto-escalate proxy. Default: false",
    "type": "boolean"
   },
   "block_ads": {
    "description": "Block ads. Default: false",
    "type": "boolean"
   },
   "block_resources": {
    "description": "Block images, CSS, fonts. Default: true",
    "type": "boolean"
   },
   "cookies": {
    "description": "Custom cookies: 'cookie1=value1;cookie2=value2'",
    "type": "string"
   },
   "custom_js": {
    "description": "Custom JavaScript code to execute",
    "type": "string"
   },
   "custom_proxy": {
    "description": "Custom proxy URI",
    "type": "string"
   },
   "custom_proxy_password": {
    "description": "Custom proxy password",
    "type": "string"
   },
   "custom_proxy_username": {
    "description": "Custom proxy username",
    "type": "string"
   },
   "device": {
    "description": "Device: 'desktop' or 'mobile'. Default: 'desktop'",
    "type": "string"
   },
   "http_method": {
    "description": "HTTP method: 'GET', 'POST', 'PUT'. Default: 'GET'",
    "type": "string"
   },
   "js": {
    "description": "Execute JavaScript. Default: true",
    "type": "boolean"
   },
   "js_timeout": {
    "description": "JS execution timeout in seconds. Default: timeout/2",
    "type": "number"
   },
   "post_data": {
    "description": "POST/PUT data",
    "type": "string"
   },
   "progressive_scroll": {
    "description": "Scroll until page height stabilizes. Default: false",
    "type": "boolean"
   },
   "proxy_country": {
    "description": "ISO country code for premium proxy. Default: 'US'",
    "type": "string"
   },
   "proxy_type": {
    "description": "Proxy: 'rotating', 'advanced', 'premium', 'residential', 'mobile', 'custom'. Default: 'rotating'",
    "type": "string"
   },
   "response_type": {
    "description": "Response type: 'html' (clean) or 'raw' (unprocessed). Default: 'html'",
    "type": "string"
   },
   "scroll_callback": {
    "description": "JS function (base64) to control scroll continuation",
    "type": "string"
   },
   "scroll_down": {
    "description": "Scroll down the page. Default: false",
    "type": "boolean"
   },
   "scroll_to_selector": {
    "description": "CSS selector to scroll to",
    "type": "string"
   },
   "scroll_wait": {
    "description": "Milliseconds between scrolls. Default: 100",
    "type": "number"
   },
   "session_id": {
    "description": "Session ID (1-16 chars)",
    "type": "string"
   },
   "strip_tags": {
    "description": "CSS selectors/tags to remove",
    "type": "string"
   },
   "timeout": {
    "description": "Request timeout in seconds. Default: 60",
    "type": "number"
   },
   "url": {
    "description": "URL to render and scrape",
    "type": "string"
   },
   "useragent": {
    "description": "Custom user agent string",
    "type": "string"
   },
   "wait_for": {
    "description": "Wait condition: milliseconds, CSS selector, or base64-encoded JS function",
    "type": "string"
   },
   "wait_for_timeout": {
    "description": "Timeout for wait_for in milliseconds",
    "type": "number"
   },
   "window_height": {
    "description": "Viewport height in pixels",
    "type": "number"
   },
   "window_width": {
    "description": "Viewport width in pixels",
    "type": "number"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "ujeebu_scrape_html"
}
