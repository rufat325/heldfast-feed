{
 "description": "List tracked Codex workers. Defaults to active workers only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "includeDetails": {
    "default": false,
    "type": "boolean"
   },
   "includeHistory": {
    "default": false,
    "type": "boolean"
   },
   "status": {
    "enum": [
     "queued",
     "running",
     "completed",
     "failed",
     "cancelled",
     "lost"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_codex_workers",
 "title": "List Codex workers"
}
