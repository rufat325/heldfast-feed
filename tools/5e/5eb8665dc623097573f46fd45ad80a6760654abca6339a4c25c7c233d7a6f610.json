{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Funds"
 },
 "description": "Searches funds by name and returns canonical CIKs for discovery or disambiguation.\n\nWHEN TO USE: The user asks to find funds, a partial name may match several funds, or a workflow specifically needs a canonical CIK.\nExamples:\n  - \"Find funds with Pershing in the name\"\n  - \"Which Renaissance filer did you mean?\"\n\nWHEN NOT TO USE:\n  - Call analyze_fund or clone_fund directly for an ordinary fund name; those tools resolve names themselves\n  - Call compare_funds directly for ordinary fund names\n\nRETURNS: Up to the requested limit (maximum 10) of matching funds, each with CIK + name + AUM + star rating.\n\nVERIFICATION: Cite record-level `source_url` filing or disclosure links when present.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_filers",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "access": {
    "additionalProperties": false,
    "properties": {
     "limited_fields": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "message": {
      "type": "string"
     },
     "tier": {
      "type": "string"
     },
     "upgrade_url": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "tier",
     "limited_fields"
    ],
    "type": "object"
   },
   "data_status": {
    "additionalProperties": false,
    "properties": {
     "complete": {
      "const": false,
      "type": "boolean"
     },
     "message": {
      "type": "string"
     },
     "missing": {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "complete",
     "missing"
    ],
    "type": "object"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "data_through": {
      "type": [
       "string",
       "null"
      ]
     },
     "source": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "aum_usd": {
       "type": [
        "number",
        "null"
       ]
      },
      "cik": {
       "type": "string"
      },
      "filer_name": {
       "type": "string"
      },
      "match_type": {
       "enum": [
        "exact",
        "prefix",
        "contains"
       ],
       "type": "string"
      },
      "star_rating": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "cik",
      "filer_name",
      "match_type",
      "aum_usd",
      "star_rating"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search Funds"
}
