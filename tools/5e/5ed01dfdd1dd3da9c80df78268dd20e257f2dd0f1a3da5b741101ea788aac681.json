{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the free-play or UTC daily leaderboard for one game.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "day": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "game": {
    "enum": [
     "signal-hunter",
     "circuit-garden",
     "protocol-duel",
     "crate-current",
     "bloom-shift",
     "tidal-atlas",
     "orrery-of-echoes"
    ],
    "type": "string"
   },
   "mode": {
    "default": "daily",
    "enum": [
     "free",
     "daily"
    ],
    "type": "string"
   }
  },
  "required": [
   "game"
  ],
  "type": "object"
 },
 "name": "arcade_leaderboard",
 "title": "Read an AI leaderboard"
}
