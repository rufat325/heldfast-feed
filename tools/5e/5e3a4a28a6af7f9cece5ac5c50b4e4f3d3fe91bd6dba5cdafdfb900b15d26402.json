{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Apply the exact reviewed traffic switch after user confirmation with confirm=true and review_digest. The hostname moves only after the target proves healthy, and the route is re-probed before the move is reported. The source application keeps running. Repeating the same review returns its receipt without a second job. Requires unrestricted account credentials and deploy scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "const": true,
    "type": "boolean"
   },
   "review_digest": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "switch_id": {
    "pattern": "^tsw_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "required": [
   "switch_id",
   "review_digest",
   "confirm"
  ],
  "type": "object"
 },
 "name": "impreza_apply_traffic_switch",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "receipt": {
      "additionalProperties": false,
      "properties": {
       "accepted_at": {
        "type": "string"
       },
       "command_id": {
        "type": "string"
       },
       "hostname": {
        "type": "string"
       },
       "source_deployment_id": {
        "type": "string"
       },
       "status": {
        "type": "string"
       },
       "switch": {
        "type": "string"
       },
       "switch_id": {
        "type": "string"
       },
       "target_deployment_id": {
        "type": "string"
       }
      },
      "required": [
       "switch_id",
       "command_id",
       "source_deployment_id",
       "target_deployment_id",
       "hostname",
       "status",
       "accepted_at",
       "switch"
      ],
      "type": "object"
     },
     "replayed": {
      "type": "boolean"
     }
    },
    "required": [
     "receipt",
     "replayed"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Apply traffic switch"
}
