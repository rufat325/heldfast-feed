{
 "description": "Create a HappyHorse task on RunAPI (edit video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audio_setting": {
    "enum": [
     "auto",
     "original"
    ],
    "type": "string"
   },
   "callback_url": {
    "type": "string"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "happyhorse-edit-video"
    ],
    "type": "string"
   },
   "output_resolution": {
    "enum": [
     "720p",
     "1080p"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "reference_image_urls": {
    "items": {},
    "maxItems": 5,
    "type": "array"
   },
   "seed": {
    "type": "number"
   },
   "source_video_url": {
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "source_video_url"
  ],
  "type": "object"
 },
 "name": "edit_video"
}
