{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Answer a question by quoting a published wiki article, or \u2014 when the question names one country, programme, tax regime, bank or legal form and asks one of its reviewed questions \u2014 with the reviewed structured answer and its verbatim official quotation. Never generated at request time; always carries the URL it came from. Returns confident=false with suggested reading when the corpus does not cover the question or when context genuinely conflicts. Bare MSO means the Hong Kong Money Service Operator licence; use Management Services Organization or regulated-practice context for the broader platform concept. Ask in the language you want answered \u2014 Russian and English are both first-class.",
 "inputSchema": {
  "properties": {
   "locale": {
    "description": "Corpus language; inferred from the question when omitted.",
    "enum": [
     "ru",
     "en",
     "ko",
     "zh-hant"
    ],
    "type": "string"
   },
   "question": {
    "description": "A natural-language question, up to 2000 characters.",
    "type": "string"
   }
  },
  "required": [
   "question"
  ],
  "type": "object"
 },
 "name": "ask",
 "outputSchema": {
  "properties": {
   "answer": {
    "type": [
     "string",
     "null"
    ]
   },
