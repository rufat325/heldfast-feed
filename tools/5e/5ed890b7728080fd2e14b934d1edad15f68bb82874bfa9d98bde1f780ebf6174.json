{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Normalize Garmin readiness, sleep score, Body Battery and recent movement load into the shared wellness_context shape for recommendation engines.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "default": 7,
    "description": "Lookback window for normalized Garmin wellness context.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "injury_flags": {
    "default": [],
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "notes": {
    "maxLength": 500,
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "soreness": {
    "default": [],
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "timezone": {
    "default": "UTC",
    "description": "IANA timezone for the Garmin calendar date queried from Connect, e.g. America/New_York. Invalid names fall back to UTC. Omit or pass UTC to keep the previous UTC-day behavior.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "garmin_wellness_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body_battery": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "context_contract_version": {
    "const": "delx-wellness-context/v1",
    "type": "string"
   },
   "context_type": {
    "const": "wellness_context",
    "type": "string"
   },
   "data_quality": {},
   "generated_at": {
    "type": "string"
   },
   "injury_flags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "readiness_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "recent_training_load": {
    "enum": [
     "low",
     "normal",
     "high",
     "unknown"
    ],
    "type": "string"
   },
   "recent_training_load_minutes": {
    "minimum": 0,
    "type": "number"
   },
   "recommended_handoff": {
    "additionalProperties": false,
    "properties": {
     "reason": {
      "type": "string"
     },
     "tool": {
      "type": "string"
     }
    },
    "required": [
     "tool",
     "reason"
    ],
    "type": "object"
   },
   "sleep_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "soreness": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "source": {
    "const": "garmin",
    "type": "string"
   },
   "telegram_summary": {
    "type": "string"
   }
  },
  "required": [
   "source",
   "context_contract_version",
   "context_type",
   "generated_at",
   "recent_training_load",
   "soreness",
   "injury_flags",
   "notes",
   "recommended_handoff"
  ],
  "type": "object"
 },
 "title": "Garmin Wellness Context"
}
