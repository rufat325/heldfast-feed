     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Article"
   },
   "candidate_multiplier": {
    "default": 4,
    "title": "Candidate Multiplier",
    "type": "integer"
   },
   "case_law_boost": {
    "default": 0.0,
    "title": "Case Law Boost",
    "type": "number"
   },
   "domain": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
