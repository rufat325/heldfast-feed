{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "CVE Vulnerability Lookup"
 },
 "description": "Look up a security vulnerability by CVE id, or search CVEs by keyword (product, library, attack; newest first): description, CVSS score and severity, published and modified dates, affected vendors/products, CWE weaknesses, known-exploited flag and reference links. Data source: NVD. This product uses data from the NVD API but is not endorsed or certified by the NVD. Price: $0.002 per successful call; failed calls are free. Free to try: a few calls a day without a key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "api_key": {
    "description": "Your Unstuck API key, if this connection has none. Leave empty to try free tools or to get a key and payment link.",
    "maxLength": 200,
    "type": "string"
   },
   "cve_id": {
    "description": "Exact CVE id, e.g. \"CVE-2021-44228\". Give this or keyword.",
    "pattern": "^CVE-\\d{4}-\\d{4,7}$",
    "type": "string"
   },
   "keyword": {
    "description": "Words to search CVE descriptions for, e.g. \"log4j remote code execution\".",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "limit": {
    "description": "Max results for a keyword search. Default 5, max 10.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "vulnerability_lookup",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance_usd": {
    "description": "Remaining prepaid balance, USD.",
    "type": "number"
   },
   "charged_usd": {
    "description": "Amount charged for this call, USD.",
    "type": "number"
   },
   "notice": {
    "const": "This product uses data from the NVD API but is not endorsed or certified by the NVD.",
    "type": "string"
   },
   "order": {
    "description": "Keyword results are newest first unless NVD's rate limit forced the oldest page.",
    "enum": [
     "exact_match",
     "newest_first",
     "oldest_first"
    ],
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "affected_products": {
       "description": "Vulnerable \"vendor:product\" pairs from the CPE configurations, applications first (up to 25).",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "affected_products_total": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "cve_id": {
       "type": "string"
      },
      "cvss_score": {
       "description": "Base score 0-10 (newest CVSS version available).",
       "type": [
        "number",
        "null"
       ]
      },
      "cvss_vector": {
       "type": [
        "string",
        "null"
       ]
      },
      "cvss_version": {
       "type": [
        "string",
        "null"
       ]
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "known_exploited": {
       "description": "Listed in CISA's Known Exploited Vulnerabilities catalog.",
       "type": "boolean"
      },
      "last_modified": {
       "type": [
        "string",
        "null"
       ]
      },
      "nvd_url": {
       "type": "string"
      },
      "published": {
       "type": [
        "string",
        "null"
       ]
      },
      "references": {
       "description": "Up to 15 reference links.",
       "items": {
        "additionalProperties": false,
        "properties": {
         "tags": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "url",
         "tags"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "severity": {
       "description": "CRITICAL, HIGH, MEDIUM, LOW or NONE.",
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "description": "NVD analysis status, e.g. \"Analyzed\".",
       "type": [
        "string",
        "null"
       ]
      },
      "weaknesses": {
       "description": "CWE ids, e.g. \"CWE-502\".",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "cve_id",
      "description",
      "cvss_score",
      "severity",
      "cvss_version",
      "cvss_vector",
      "published",
      "last_modified",
      "status",
      "known_exploited",
      "weaknesses",
      "affected_products",
      "affected_products_total",
      "references",
      "nvd_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "const": "NVD",
    "type": "string"
   },
   "total_results": {
    "description": "Total matches in NVD (keyword searches may have more than returned).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "source",
   "notice",
   "total_results",
   "order",
   "results",
   "charged_usd",
   "balance_usd"
  ],
  "type": "object"
 },
 "title": "CVE Vulnerability Lookup"
}
