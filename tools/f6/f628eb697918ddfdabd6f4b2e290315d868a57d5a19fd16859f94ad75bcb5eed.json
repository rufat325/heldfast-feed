{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a booking"
 },
 "description": "Create a new booking in a room for given dates and guest details. It immediately blocks inventory and is synced to connected channels. Set checkAvailability=true to refuse the booking if the room is not free, and notifyGuest / notifyHost to send confirmation emails. Undo by setting status cancelled with beds24_update_booking. Requires a token with bookings write access. Beds24: POST /bookings.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "type": "string"
   },
   "arrival": {
    "description": "Arrival date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "arrivalTime": {
    "description": "Expected arrival time (free text).",
    "type": "string"
   },
   "assignBooking": {
    "description": "Let Beds24 assign the first free unit / room using room dependency settings.",
    "type": "boolean"
   },
   "checkAvailability": {
    "description": "Do not save the booking if the room has no availability. Recommended.",
    "type": "boolean"
   },
   "city": {
    "type": "string"
   },
   "comments": {
    "description": "Guest comments.",
    "type": "string"
   },
   "company": {
    "type": "string"
   },
   "country": {
    "description": "Free text country.",
    "type": "string"
   },
   "country2": {
    "description": "2-letter country code, e.g. DE.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "departure": {
    "description": "Departure (check-out) date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "deposit": {
    "type": "number"
   },
   "email": {
    "type": "string"
   },
   "firstName": {
    "type": "string"
   },
   "flagColor": {
    "description": "Flag colour, 6-character hex (e.g. ff0000) or empty string to clear.",
    "pattern": "^([0-9a-fA-F]{6})?$",
    "type": "string"
   },
   "flagText": {
    "type": "string"
   },
   "lang": {
    "description": "Guest language, 2-letter code, e.g. en.",
    "type": "string"
   },
   "lastName": {
    "type": "string"
   },
   "mobile": {
    "type": "string"
   },
   "notes": {
    "description": "Internal host notes.",
    "type": "string"
   },
   "notifyGuest": {
    "description": "Email the guest a booking confirmation.",
    "type": "boolean"
   },
   "notifyHost": {
    "description": "Email the host a booking confirmation.",
    "type": "boolean"
   },
   "numAdult": {
    "description": "Number of adults.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "numChild": {
    "description": "Number of children.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "phone": {
    "type": "string"
   },
   "postcode": {
    "type": "string"
   },
   "price": {
    "description": "Total booking price.",
    "type": "number"
   },
   "reference": {
    "description": "Your own reference.",
    "maxLength": 100,
    "type": "string"
   },
   "roomId": {
    "description": "Room (room type) id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "state": {
    "type": "string"
   },
   "status": {
    "description": "Booking status.",
    "enum": [
     "confirmed",
     "request",
     "new",
     "cancelled",
     "black",
     "inquiry"
    ],
    "type": "string"
   },
   "tax": {
    "type": "number"
   },
   "title": {
    "description": "Guest title, e.g. Mr, Ms.",
    "type": "string"
   },
   "unitId": {
    "description": "Specific unit within the room type.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "roomId",
   "arrival",
   "departure"
  ],
  "type": "object"
 },
 "name": "beds24_create_booking",
 "title": "Create a booking"
}
