{
 "description": "Scan ALL cross-chain bridge routes: deBridge DLN + LI.FI/Relay + ChangeNOW. Ranks every route by net output, checks for existing token approvals that should be revoked before bridging, and returns the winner + runners-up. Read-only. Never signs or broadcasts. ChangeNOW requires ticker symbols.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "raw base units of tokenIn",
    "type": "string"
   },
   "fromChainId": {
    "type": "number"
   },
   "fromDecimals": {
    "description": "default 18",
    "type": "number"
   },
   "fromSymbol": {
    "description": "ticker for ChangeNOW (e.g. ETH, USDC)",
    "type": "string"
   },
   "taker": {
    "type": "string"
   },
   "toChainId": {
    "type": "number"
   },
   "toDecimals": {
    "description": "default 18",
    "type": "number"
   },
   "toSymbol": {
    "description": "ticker for ChangeNOW",
    "type": "string"
   },
   "tokenIn": {
    "type": "string"
   },
   "tokenOut": {
    "type": "string"
   }
  },
  "required": [
   "fromChainId",
   "toChainId",
   "tokenIn",
   "tokenOut",
   "amount",
   "taker"
  ],
  "type": "object"
 },
 "name": "bridge_aggregator_scan"
}
