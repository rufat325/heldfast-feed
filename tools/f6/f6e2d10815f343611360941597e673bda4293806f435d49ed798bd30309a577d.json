{
 "description": "[OPERATOR] Evaluate an intent against the Values Floor policy engine. Returns real pass/fail verdict.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "delegation_scope": {
    "description": "Delegation scope for context",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "delegation_spend_limit": {
    "description": "Delegation spend limit",
    "type": "number"
   },
   "delegation_spent": {
    "default": 0,
    "description": "Amount already spent",
    "type": "number"
   },
   "intent_id": {
    "description": "Intent ID from create_intent",
    "type": "string"
   }
  },
  "required": [
   "intent_id",
   "delegation_scope",
   "delegation_spend_limit"
  ],
  "type": "object"
 },
 "name": "evaluate_intent"
}
