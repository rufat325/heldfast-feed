{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns the caller's most recent Make-an-Offer / bargaining offers. Pass role: 'buyer' for offers you sent, or role: 'seller' for offers received on your own listings. Optionally filter to a single state (pending / accepted / rejected / countered / buyer_accepted / expired). Each entry has the product, the offered price, the seller's counter price if any, and timestamps. Read-only, no side effects. Requires an 'Authorization: Bearer <agent api key>' header.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "default": 20,
    "description": "Maximum number of most-recent offers to return (1-50, default 20).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "role": {
    "description": "Whose side to list from: 'buyer' returns offers you sent, 'seller' returns offers received on your listings.",
    "enum": [
     "buyer",
     "seller"
    ],
    "type": "string"
   },
   "state": {
    "description": "Optional filter to a single offer state. When omitted, offers in every state are returned.",
    "enum": [
     "pending",
     "accepted",
     "rejected",
     "countered",
     "buyer_accepted",
     "expired"
    ],
    "type": "string"
   }
  },
  "required": [
   "role"
  ],
  "type": "object"
 },
 "name": "offers.list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "offers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "counter_price": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "amount": {
           "type": "number"
          },
          "currency": {
           "type": "string"
          }
         },
         "required": [
          "amount",
          "currency"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "created_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "expires_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "offer_id": {
       "type": "string"
      },
      "offered_price": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "type": "number"
        },
        "currency": {
         "type": "string"
        }
       },
       "required": [
        "amount",
        "currency"
       ],
       "type": "object"
      },
      "product_id": {
       "type": "string"
      },
      "product_name": {
       "type": "string"
      },
      "role": {
       "enum": [
        "buyer",
        "seller"
       ],
       "type": "string"
      },
      "state": {
       "enum": [
        "pending",
        "accepted",
        "rejected",
        "countered",
        "buyer_accepted",
        "expired"
       ],
       "type": "string"
      }
     },
     "required": [
      "offer_id",
      "product_id",
      "product_name",
      "role",
      "state",
      "offered_price",
      "counter_price",
      "created_at",
      "expires_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "offers"
  ],
  "type": "object"
 },
 "title": "List the authenticated user's own Resollo offers"
}
