{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "account:read",
     "pages:read",
     "pages:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Claimed Pages"
 },
 "description": "List landing pages saved to the signed-in account. Safe to call without sign-in: an anonymous chat gets ok=true, authenticated=false and an empty list (not an error) because it has no saved pages \u2014 then create the page directly with page_create_from_brief. Sign-in is only needed later to keep or manage a page.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum number of claimed pages to return.",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "account_pages_list",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "authRequired": {
    "description": "true when the session is an anonymous demo: it has no saved pages, so pages is empty. Not an error.",
    "type": "boolean"
   },
   "authenticated": {
    "description": "false when no account is signed in to this chat (pages is then empty by definition); true for a signed-in account.",
    "type": "boolean"
   },
   "nextStep": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "claimedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "createdAt": {
       "type": "string"
      },
      "isPublished": {
       "type": "boolean"
      },
      "pageId": {
       "format": "uuid",
       "type": "string"
      },
      "previewUrl": {
       "type": "string"
      },
      "publishedUrl": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "status": {
       "enum": [
        "draft",
        "published"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "updatedAt": {
       "type": "string"
      }
     },
     "required": [
      "pageId",
      "slug",
      "title",
      "status",
      "isPublished",
      "previewUrl",
      "publishedUrl",
      "claimedAt",
      "createdAt",
      "updatedAt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "ok",
   "pages"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "account:read",
    "pages:read",
    "pages:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "List Claimed Pages"
}
