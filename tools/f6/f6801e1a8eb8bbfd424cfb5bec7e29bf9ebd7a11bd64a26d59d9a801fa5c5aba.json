{
 "description": "Create a sales receipt (paid-on-the-spot sale \u2014 combines invoice + payment). CustomerRef and Line items required.",
 "inputSchema": {
  "properties": {
   "CurrencyRef": {
    "properties": {
     "value": {
      "description": "ISO-4217",
      "type": "string"
     }
    },
    "type": "object"
   },
   "CustomerRef": {
    "properties": {
     "value": {
      "description": "Customer.Id",
      "type": "string"
     }
    },
    "required": [
     "value"
    ],
    "type": "object"
   },
   "DepositToAccountRef": {
    "properties": {
     "value": {
      "description": "Account.Id where funds are deposited",
      "type": "string"
     }
    },
    "type": "object"
   },
   "Line": {
    "description": "Sales receipt line items (same shape as invoice lines)",
    "items": {
     "properties": {
      "Amount": {
       "type": "number"
      },
      "Description": {
       "type": "string"
      },
      "DetailType": {
       "description": "Typically 'SalesItemLineDetail'",
       "type": "string"
      },
      "SalesItemLineDetail": {
       "properties": {
        "ItemRef": {
         "properties": {
          "value": {
           "description": "Item.Id",
           "type": "string"
          }
         },
         "type": "object"
        },
        "Qty": {
         "type": "number"
        },
        "UnitPrice": {
         "type": "number"
        }
       },
       "type": "object"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "PaymentMethodRef": {
    "properties": {
     "value": {
      "description": "PaymentMethod.Id",
      "type": "string"
     }
    },
    "type": "object"
   },
   "PrivateNote": {
    "type": "string"
   },
   "TxnDate": {
    "description": "Receipt date (YYYY-MM-DD)",
    "type": "string"
   }
  },
  "required": [
   "CustomerRef",
   "Line"
  ],
  "type": "object"
 },
 "name": "create_sales_receipt"
}
