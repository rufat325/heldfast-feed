 "description": "Fetch the full details of one specific Resollo product listing by its ID, including its Semantic Profile (suitable_for, not_ideal_for, target_audience, key_strengths, evokes, is_similar_to -- useful for judging fit against a buyer's stated needs), attributes, all image URLs, shipment prices, and the seller's accepted payment/shipment methods. Returns not_found for products that don't exist, are sold, expired, or moderation-hidden. No authentication required.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currency": {
    "description": "ISO 4217 code for the returned price fields. Defaults to USD. Same semantics as in search_products.",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "productId": {
    "description": "The product listing's uuid.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "productId"
  ],
  "type": "object"
 },
 "name": "products.get",
