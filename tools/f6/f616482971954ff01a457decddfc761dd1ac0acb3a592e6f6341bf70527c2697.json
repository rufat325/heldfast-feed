{
 "description": "Get a composite risk summary for an asset across selected oracle providers. Includes HHI concentration, volatility, correlation, freshness, manipulation resistance, and shared-dependency risk.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "period": {
    "description": "Analysis period in hours, default 168 (7 days)",
    "maximum": 8760,
    "minimum": 1,
    "type": "integer"
   },
   "providers": {
    "description": "Oracle providers to analyze, e.g. [\"chainlink\", \"redstone\", \"api3\"]",
    "items": {
     "enum": [
      "chainlink",
      "api3",
      "redstone",
      "dia",
      "winklink",
      "supra",
      "twap",
      "reflector",
      "flare",
      "band"
     ],
     "type": "string"
    },
    "minItems": 2,
    "type": "array"
   },
   "symbol": {
    "description": "Asset symbol, e.g. BTC, ETH",
    "type": "string"
   }
  },
  "required": [
   "symbol",
   "providers"
  ],
  "type": "object"
 },
 "name": "get_risk_summary"
}
