{
 "description": "Generate a random string (hex, alphanumeric, or bytes)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "format": {
    "default": "hex",
    "description": "Output format",
    "enum": [
     "hex",
     "base64",
     "alphanumeric"
    ],
    "type": "string"
   },
   "length": {
    "default": 32,
    "description": "Length in characters",
    "maximum": 1024,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "random_string"
}
