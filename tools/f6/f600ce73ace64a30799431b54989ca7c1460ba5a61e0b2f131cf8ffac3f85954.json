{
 "description": "Update an existing schedule",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "day_cap_limit": {
    "description": "Daily cap limit",
    "type": "number"
   },
   "day_cap_type": {
    "description": "Daily cap type",
    "enum": [
     "views",
     "clicks"
    ],
    "type": "string"
   },
   "day_parting_id": {
    "description": "Day parting ID for time-of-day targeting",
    "type": "number"
   },
   "delivery_method": {
    "description": "Delivery pacing: \"default\" (ASAP) or \"smooth\" (evenly distributed)",
    "enum": [
     "default",
     "smooth"
    ],
    "type": "string"
   },
   "end_at": {
    "description": "End date/time in ISO-8601 format",
    "type": "string"
   },
   "end_at_timezone": {
    "description": "IANA timezone for end_at",
    "type": "string"
   },
   "end_date": {
    "description": "End date (YYYY-MM-DD HH:MM:SS) \u2014 deprecated, use end_at",
    "type": "string"
   },
   "id": {
    "description": "Schedule ID",
    "type": "number"
   },
   "per_user_view_limit": {
    "description": "Per-user view frequency cap",
    "type": "number"
   },
   "per_user_view_period": {
    "description": "Days before per-user view counter resets",
    "type": "number"
   },
   "quota_lifetime": {
    "description": "Total quota amount (views or clicks, not per thousand)",
    "type": "number"
   },
   "quota_type": {
    "description": "Quota measurement type",
    "enum": [
     "views",
     "clicks"
    ],
    "type": "string"
   },
   "start_at": {
    "description": "Start date/time in ISO-8601 format",
    "type": "string"
   },
   "start_at_timezone": {
    "description": "IANA timezone for start_at",
    "type": "string"
   },
   "start_date": {
    "description": "Start date (YYYY-MM-DD HH:MM:SS) \u2014 deprecated, use start_at",
    "type": "string"
   },
   "under_delivery_behaviour": {
    "description": "Whether to keep serving until quota met or stop on end date",
    "enum": [
     "endOnQuota",
     "endOnDate"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_schedule"
}
