{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Recommend experiences"
 },
 "description": "Use this when the user describes what they want in natural language rather than naming a category. Parses the query for audience, mood, constraints, occasion, and time of day, then returns scored recommendations with a reason field explaining the match.",
 "inputSchema": {
  "properties": {
   "city": {
    "description": "Optional city slug. If omitted, the city is parsed from the query.",
    "type": "string"
   },
   "date": {
    "description": "Optional ISO date (YYYY-MM-DD) for availability-aware ranking.",
    "type": "string"
   },
   "format": {
    "default": "json",
    "description": "Response shape. 'json' returns structured records; 'text' returns the same content rendered as a short narrative paragraph for chat surfaces.",
    "enum": [
     "json",
     "text"
    ],
    "type": "string"
   },
   "language": {
    "description": "BCP-47 language code for human-readable fields (e.g., 'en', 'fr-FR'). Defaults to English when omitted.",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "Number of recommendations to return (1-20). Default 5.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "pax": {
    "default": 2,
    "description": "Number of people. Default 2.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Natural-language preference, e.g., \"romantic evening in Paris under 100 euros\" or \"rainy day in Edinburgh with kids 8 and 12\".",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
