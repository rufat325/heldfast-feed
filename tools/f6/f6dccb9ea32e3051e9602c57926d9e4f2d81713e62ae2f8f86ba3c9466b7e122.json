{
 "description": "Retorna um snippet de codigo Delphi/DUnitX/CLI pronto para uso, de uma categoria especifica",
 "inputSchema": {
  "properties": {
   "categoria": {
    "description": "Categoria do snippet",
    "enum": [
     "unit_skeleton",
     "dunitx_test_fixture",
     "dunitx_console_dpr",
     "dproj_coverage_settings",
     "cli_invocation",
     "ci_script_windows"
    ],
    "type": "string"
   },
   "nome": {
    "description": "Nome do snippet dentro da categoria",
    "type": "string"
   }
  },
  "required": [
   "categoria",
   "nome"
  ],
  "type": "object"
 },
 "name": "get_snippet"
}
