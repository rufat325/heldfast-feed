{
 "_meta": {
  "openai/toolInvocation/invoked": "Time entry updated",
  "openai/toolInvocation/invoking": "Updating the time entry",
  "ui": {
   "resourceUri": "ui://timesheet/TaskCard.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update Task"
 },
 "description": "Use this when the user wants to modify details of an existing time entry such as times, description, or billing status.",
 "inputSchema": {
  "properties": {
   "billable": {
    "description": "Updated billable status",
    "type": "boolean"
   },
   "billed": {
    "description": "Mark task as billed (invoice sent to client)",
    "type": "boolean"
   },
   "description": {
    "description": "Updated task description",
    "type": "string"
   },
   "endDateTime": {
    "description": "Updated end time in ISO 8601 format",
    "format": "date-time",
    "type": "string"
   },
   "id": {
    "description": "The task ID to update",
    "type": "string"
   },
   "paid": {
    "description": "Mark task as paid (for invoicing)",
    "type": "boolean"
   },
   "startDateTime": {
    "description": "Updated start time in ISO 8601 format",
    "format": "date-time",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "task_update",
 "outputSchema": {
  "properties": {
   "action": {
    "description": "What happened to the task (the rest of the object is the full task)",
    "enum": [
     "updated"
    ],
    "type": "string"
   },
   "id": {
    "description": "The updated task ID",
    "type": "string"
   },
   "success": {
    "description": "Whether the update was successful",
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Update Task"
}
