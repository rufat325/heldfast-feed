{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Preview Template"
 },
 "description": "See how your document will look.",
 "inputSchema": {
  "properties": {
   "accept": {
    "default": "text/html",
    "enum": [
     "text/html",
     "application/pdf"
    ],
    "type": "string"
   },
   "data": {
    "description": "Template variables as key-value pairs",
    "type": "object"
   },
   "template_id": {
    "description": "Template ID to preview",
    "type": "string"
   }
  },
  "required": [
   "template_id",
   "data"
  ],
  "type": "object"
 },
 "input_examples": [
  {
   "data": {
    "client_name": "Acme Corp",
    "date": "2026-01-15",
    "total": "$1,250.00"
   },
   "template_id": "tmpl_invoice_001"
  },
  {
   "data": {
    "item": "Widget A",
    "price": "$25.00",
    "quantity": 10
   },
   "template_id": "tmpl_receipt_002"
  }
 ],
 "name": "preview_template",
 "outputSchema": {
  "properties": {
   "html": {
    "description": "Rendered HTML preview",
    "type": "string"
   }
  },
  "required": [
   "html"
  ],
  "type": "object"
 }
}
