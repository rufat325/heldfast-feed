{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "connections:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List saved authentication account references for the selected acting AI and target AI, with status, scopes and defaults. Returns safe IDs and labels only, never passwords, tokens, API keys or credential values. Selecting a saved account does not grant new permission.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "actingAiId": {
    "description": "Authorized Darwin AI whose saved authentication accounts to list.",
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   },
   "afterCursor": {
    "description": "Continue after the previous response nextCursor.",
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "includeUnavailable": {
    "description": "Include expired, reauthentication-required or revoked accounts. Defaults to false.",
    "type": "boolean"
   },
   "limit": {
    "description": "Maximum saved accounts to return, up to 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "targetAiId": {
    "description": "Target AI whose scoped saved accounts to inspect.",
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   }
  },
  "required": [
   "actingAiId",
   "targetAiId"
  ],
  "type": "object"
 },
 "name": "list_connections",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "accounts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accountId": {
       "maxLength": 200,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9_-]+$",
       "type": "string"
      },
      "canRefresh": {
       "type": "boolean"
      },
      "credentialExpiresAt": {
       "anyOf": [
        {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "expiresAt": {
       "anyOf": [
        {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "grantId": {
       "maxLength": 200,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9_-]+$",
       "type": "string"
      },
      "isDefault": {
       "type": "boolean"
      },
      "label": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "retention": {
       "enum": [
        "temporary",
        "saved"
       ],
       "type": "string"
      },
      "retentionConsentedAt": {
       "anyOf": [
        {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "When the user explicitly chose this retention mode. Null means the retention consent cannot be proven and the account must not be used."
      },
      "scopes": {
       "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 50,
       "type": "array"
      },
      "status": {
       "enum": [
        "available",
        "authentication_required",
        "revoked"
       ],
       "type": "string"
      },
      "targetAiId": {
       "maxLength": 200,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
       "type": "string"
      }
     },
     "required": [
      "accountId",
      "grantId",
      "targetAiId",
      "label",
      "scopes",
      "isDefault",
      "retention",
      "status",
      "retentionConsentedAt",
      "expiresAt",
      "credentialExpiresAt",
      "canRefresh"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "accounts",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List connections"
}
