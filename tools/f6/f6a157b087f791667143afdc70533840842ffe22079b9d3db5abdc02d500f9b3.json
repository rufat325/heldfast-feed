{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a Cloud Insight event rule by directly specifying the monitor group (targets) and metrics group (rule template) inline, without pre-created groups.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asgPolicys": {
    "description": "VPC Auto Scaling group policies",
    "items": {
     "additionalProperties": false,
     "properties": {
      "autoScalingGroupNo": {
       "description": "Auto Scaling group number",
       "type": "number"
      },
      "autoScalingPolicyNo": {
       "description": "Auto Scaling policy number",
       "type": "number"
      },
      "policyName": {
       "description": "Auto Scaling policy name",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "cfTriggers": {
    "description": "Cloud Functions trigger names",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "classicAsgPolicys": {
    "description": "Classic Auto Scaling group policies",
    "items": {
     "$ref": "#/properties/asgPolicys/items"
    },
    "type": "array"
   },
   "groupDesc": {
    "description": "Description (<= 300 chars)",
    "type": "string"
   },
   "groupName": {
    "description": "Name of the rule group (1-100 chars)",
    "type": "string"
   },
   "metricsGroup": {
    "additionalProperties": false,
    "description": "Metrics group definition (CreateOrUpdateMetricsGrpDto)",
    "properties": {
     "groupDesc": {
      "description": "Description (<= 300 chars)",
      "type": "string"
     },
     "groupName": {
      "description": "Name of the metrics group (1-100 chars)",
      "type": "string"
     },
     "metricsGroupItems": {
      "description": "Metric items (at least one)",
      "items": {
       "additionalProperties": false,
       "properties": {
        "calculation": {
         "description": "Aggregation of the metric",
         "enum": [
          "COUNT",
          "SUM",
          "MAX",
          "MIN",
          "AVG"
         ],
         "type": "string"
        },
        "condition": {
         "description": "Threshold operator (LT, LE, EQ, GE, GT)",
         "enum": [
          "LT",
          "LE",
          "EQ",
          "GE",
          "GT"
         ],
         "type": "string"
        },
        "desc": {
         "description": "Metric description",
         "type": "string"
        },
        "dimensions": {
         "description": "Dimension filters, e.g. [{dim:\"type\", val:\"svr\"}]",
         "items": {
          "additionalProperties": false,
          "properties": {
           "dim": {
            "description": "Dimension name defined in the schema (e.g. \"type\")",
            "type": "string"
           },
           "val": {
            "description": "Dimension value (e.g. \"svr\")",
            "type": "string"
           }
          },
          "required": [
           "dim",
           "val"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "duration": {
         "description": "Duration (>= 1)",
         "type": "number"
        },
        "eventLevel": {
         "description": "Event level",
         "enum": [
          "INFO",
          "WARNING",
          "CRITICAL"
         ],
         "type": "string"
        },
        "metric": {
         "description": "Metric name (e.g. avg_cpu_used_rto)",
         "type": "string"
        },
        "metricGroupItemId": {
         "description": "Metric group item ID (when updating an existing item)",
         "type": "string"
        },
        "threshold": {
         "description": "Threshold value",
         "type": "number"
        }
       },
       "required": [
        "metric",
        "eventLevel",
        "condition",
        "calculation",
        "duration",
        "threshold"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "prodKey": {
      "description": "Product key (cw_key) for the target service",
      "type": "string"
     },
     "prodType": {
      "description": "Product type: system (Ncloud product) or custom (Custom Schema)",
      "enum": [
       "system",
       "custom"
      ],
      "type": "string"
     },
     "temporaryGroup": {
      "default": false,
      "description": "true: create the Event Rule without creating a metrics group (default false)",
      "type": "boolean"
     }
    },
    "required": [
     "prodKey",
     "groupName",
     "metricsGroupItems"
    ],
    "type": "object"
   },
   "monitorGroup": {
    "additionalProperties": false,
    "description": "Monitor group definition (MonitorGrpDto)",
    "properties": {
     "groupDesc": {
      "description": "Description of the monitor group",
      "type": "string"
     },
     "groupName": {
      "description": "Name of the monitor group",
      "type": "string"
     },
     "monitorGroupItemList": {
      "description": "Monitoring targets ([{resourceId, nrn?}])",
      "items": {
       "additionalProperties": false,
       "properties": {
        "nrn": {
         "description": "Resource NRN (Resource Manager)",
         "type": "string"
        },
        "resourceId": {
         "description": "Monitoring target resource ID (e.g. server instance number)",
         "type": "string"
        },
        "resourceName": {
         "description": "Resource name",
         "type": "string"
        }
       },
       "required": [
        "resourceId"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "prodKey": {
      "description": "Product key (cw_key) for the target service",
      "type": "string"
     },
     "prodName": {
      "description": "Product name",
      "type": "string"
     },
     "temporaryGroup": {
      "description": "true: create the Event Rule without creating a monitor group",
      "type": "boolean"
     },
     "type": {
      "description": "Target group type: NORMAL (default) or ASG (Auto Scaling Group)",
      "enum": [
       "NORMAL",
       "ASG"
      ],
      "type": "string"
     }
    },
    "required": [
     "prodKey",
     "monitorGroupItemList"
    ],
    "type": "object"
   },
   "personalNotificationRecipients": {
    "description": "Personal notification recipients",
    "items": {
     "$ref": "#/properties/recipientNotifications/items"
    },
    "type": "array"
   },
   "prodKey": {
    "description": "Product key (cw_key)",
    "type": "string"
   },
   "recipientNotifications": {
    "description": "Notification recipient groups",
    "items": {
     "additionalProperties": false,
     "properties": {
      "enableNotiWhenEventClose": {
       "description": "Send a notification when the event closes",
       "type": "boolean"
      },
      "groupName": {
       "description": "Notification recipient group name",
       "type": "string"
      },
      "groupNum": {
       "description": "Notification recipient group number",
       "type": "number"
      },
      "notifyTypes": {
       "description": "Notification methods (SMS, EMAIL)",
       "items": {
        "enum": [
         "SMS",
         "EMAIL"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "reminderTime": {
       "description": "Reminder interval in minutes (5-720)",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "prodKey",
   "groupName",
   "monitorGroup",
   "metricsGroup"
  ],
  "type": "object"
 },
 "name": "ncloud_create_rule_directly"
}
