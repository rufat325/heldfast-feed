{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set Resource Availability"
 },
 "description": "Add an availability window for a resource. Use day-of-week + recurring=true for weekly schedules, or a specific date for one-off blocks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "description": "YYYY-MM-DD for a specific date instead of dayOfWeek",
    "type": "string"
   },
   "dayOfWeek": {
    "description": "Day of week (0=Sun..6=Sat)",
    "enum": [
     "mon",
     "tue",
     "wed",
     "thu",
     "fri",
     "sat",
     "sun"
    ],
    "type": "string"
   },
   "endTime": {
    "description": "HH:MM (24h)",
    "type": "string"
   },
   "isRecurring": {
    "description": "Default true",
    "type": "boolean"
   },
   "resourceId": {
    "description": "Resource ID",
    "type": "string"
   },
   "startTime": {
    "description": "HH:MM (24h)",
    "type": "string"
   },
   "type": {
    "description": "Default available",
    "enum": [
     "available",
     "blocked"
    ],
    "type": "string"
   }
  },
  "required": [
   "resourceId",
   "startTime",
   "endTime"
  ],
  "type": "object"
 },
 "name": "set_resource_availability",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
