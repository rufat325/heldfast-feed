{
 "description": "Convert a character from narrative to itemized inventory mode. Enables full item tracking with stats, equipment slots, gold, and weight/encumbrance.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "characterId": {
    "description": "Character ID to upgrade",
    "type": "string"
   },
   "maxSlots": {
    "default": 20,
    "description": "Maximum inventory slots",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxWeight": {
    "default": 100,
    "description": "Maximum carry weight",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "preserveNarrative": {
    "default": true,
    "description": "Keep narrative equipment as reference (stored in narrative field)",
    "type": "boolean"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "startingGold": {
    "default": 0,
    "description": "Starting gold amount",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "sessionId",
   "characterId"
  ],
  "type": "object"
 },
 "name": "upgrade_inventory"
}
