{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Schedule a Workbench flow"
 },
 "description": "Set a specific built flow to run automatically on a cadence \u2014 the deterministic counterpart to a zv1 routine. Each run executes the flow's latest PUBLISHED revision with the fixed `input` envelope and routes the output per `delivery`. USE THIS when the user wants a flow they've built to run on a schedule (\"run my digest flow every morning\"). Do NOT create a routine for this \u2014 a routine runs a free-form instruction, not a built flow. The schedule runs the PUBLISHED flow, so the flow must be published (check workbench_flows_revisions_list; publish with workbench_flows_publish if it isn't). `input` is fixed for every run, so the flow itself should fetch anything time-varying at run time. Manage existing schedules with workbench_flows_schedules_list / workbench_flows_schedules_update.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approvalId": {
    "description": "Approval id from a prior needs_confirmation response. Omit on the first call.",
    "type": "string"
   },
   "delivery": {
    "enum": [
     "history",
     "notification",
     "email"
    ],
    "type": "string"
   },
   "flowId": {
    "description": "Flow to schedule (id from workbench_flows_list).",
    "type": "string"
   },
   "input": {
    "description": "Fixed input envelope every run executes with \u2014 {\"kind\":\"chat\",\"messages\":[\u2026]} or {\"kind\":\"form\",\"values\":{\u2026}}, the same shape workbench_flows_run takes. Constant across runs.",
    "oneOf": [
     {
      "properties": {
       "kind": {
        "const": "chat",
        "type": "string"
       },
       "messages": {
        "items": {
         "additionalProperties": {},
         "properties": {
          "content": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "items": {},
             "type": "array"
            },
            {
             "type": "null"
            }
           ]
          },
          "name": {
           "type": "string"
          },
          "role": {
           "type": "string"
          },
          "tool_call_id": {
           "type": "string"
          },
          "tool_calls": {
           "items": {
            "additionalProperties": {},
            "properties": {
             "function": {
              "additionalProperties": {},
              "properties": {
               "arguments": {},
               "name": {
                "type": "string"
               }
              },
              "type": "object"
             },
             "id": {
              "type": "string"
             },
             "type": {
              "type": "string"
             }
            },
            "type": "object"
           },
           "type": "array"
          }
         },
         "required": [
          "role"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "values": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       }
      },
      "required": [
       "kind",
       "messages"
      ],
      "type": "object"
     },
     {
      "properties": {
       "kind": {
        "const": "form",
        "type": "string"
       },
       "values": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       }
      },
      "required": [
       "kind",
       "values"
      ],
      "type": "object"
     }
    ]
   },
   "interval": {
    "description": "Cadence: hourly, daily, or weekly.",
    "enum": [
     "hourly",
     "daily",
     "weekly"
    ],
    "type": "string"
   },
   "label": {
    "anyOf": [
     {
      "maxLength": 120,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "scheduleDayOfWeek": {
    "anyOf": [
     {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "scheduleTime": {
    "anyOf": [
     {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "scheduleTimezone": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "workspace": {
    "description": "Workspace slug. Personal tokens with no default workspace MUST pass this. Ignored for workspace API keys.",
    "type": "string"
   }
  },
  "required": [
   "flowId",
   "interval",
   "input"
  ],
  "type": "object"
 },
 "name": "workbench_flows_schedule",
 "title": "Schedule a Workbench flow"
}
