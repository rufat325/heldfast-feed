    "minimum": -9007199254740991,
    "type": "integer"
   },
   "max_items": {
    "default": 6,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "compile_codex_turn"
}
