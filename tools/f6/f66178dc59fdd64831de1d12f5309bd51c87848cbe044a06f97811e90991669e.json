{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Scaffold Template"
 },
 "description": "Template-based project setup. Available templates: blog, landing, docs, ecommerce, saas, i18n, mobile. Changes are auto-committed to git.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "locales": {
    "description": "Override locales",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "template": {
    "description": "Template ID: blog, landing, docs, ecommerce, saas, i18n, mobile",
    "type": "string"
   },
   "with_sample_content": {
    "default": true,
    "description": "Include sample content (default: true)",
    "type": "boolean"
   }
  },
  "required": [
   "template"
  ],
  "type": "object"
 },
 "name": "contentrain_scaffold"
}
