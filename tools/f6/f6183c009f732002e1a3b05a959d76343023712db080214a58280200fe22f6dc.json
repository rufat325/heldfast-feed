{
 "annotations": {
  "destructiveHint": true
 },
 "description": "Create a LinkedIn Ads campaign for B2B advertising.",
 "inputSchema": {
  "properties": {
   "daily_budget": {
    "description": "Daily budget in USD",
    "type": "number"
   },
   "group_id": {
    "description": "Campaign group ID the campaign belongs to (REQUIRED \u2014 LinkedIn campaigns cannot exist outside a group). List existing groups with linkedin_ads_get_campaign_groups.",
    "type": "string"
   },
   "name": {
    "description": "Campaign name",
    "type": "string"
   },
   "objective": {
    "description": "Campaign objective",
    "enum": [
     "WEBSITE_VISIT",
     "LEAD_GENERATION",
     "ENGAGEMENT",
     "VIDEO_VIEW",
     "BRAND_AWARENESS"
    ],
    "type": "string"
   },
   "target_audiences": {
    "description": "Matched-audience segment IDs. Must be the adSegment id (list_audiences 'destination_segment_id'), NOT the dmpSegment id \u2014 a dmpSegment id fails with a bare HTTP 500.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "target_functions": {
    "description": "Target job functions, e.g. ['engineering','it','operations']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "target_locations": {
    "description": "Target locations, e.g. ['US','UK','CA']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "target_seniorities": {
    "description": "Target seniorities, e.g. ['senior','manager','director','vp','cxo']",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "group_id"
  ],
  "type": "object"
 },
 "name": "create_linkedin_campaign"
}
