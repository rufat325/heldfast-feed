     "minLength": 1,
     "type": "string"
    },
    "maxItems": 64,
    "type": "array"
   },
   "intent": {
    "description": "Complete post-change normative intent. Send the desired behavior, not a patch fragment.",
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
