{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Rounding & significant figures calculator"
 },
 "description": "Round a number to a chosen number of decimal places or significant figures, with halves always rounded up (away from zero). Mode 'dp': decimal places, 0 to 12. Mode 'sf': significant figures, 1 to 15. Source: https://hopi.co.uk/rounding-calculator/",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "mode": {
       "const": "dp"
      }
     }
    },
    "then": {
     "properties": {
      "count": {
       "maximum": 12,
       "minimum": 0
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "mode": {
       "const": "sf"
      }
     }
    },
    "then": {
     "properties": {
      "count": {
       "maximum": 15,
       "minimum": 1
      }
     }
    }
   }
  ],
  "properties": {
   "count": {
    "description": "How many decimal places (0 to 12) or significant figures (1 to 15)",
    "maximum": 15,
    "minimum": 0,
    "type": "integer"
   },
   "mode": {
    "description": "'dp' for decimal places, or 'sf' for significant figures",
    "enum": [
     "dp",
     "sf"
    ],
    "type": "string"
   },
   "number": {
    "description": "The number to round",
    "type": "number"
   }
  },
  "required": [
   "number",
   "mode",
   "count"
  ],
  "type": "object"
 },
 "name": "hopi_rounding_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "type": "number"
   },
   "formatted": {
    "type": "string"
   },
   "mode": {
    "type": "string"
   },
   "number": {
    "type": "number"
   },
   "rounded": {
    "type": "number"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "count",
   "formatted",
   "mode",
   "number",
   "rounded",
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Rounding & significant figures calculator"
}
