{
 "_meta": {
  "openai/outputTemplate": "ui://imagelato/batch-detail-v1.html",
  "openai/toolInvocation/invoked": "Imagelato image batch ready.",
  "openai/toolInvocation/invoking": "Loading Imagelato image batch\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "imagelato:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://imagelato/batch-detail-v1.html"
  },
  "ui/resourceUri": "ui://imagelato/batch-detail-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a processed image and its variants"
 },
 "description": "Use this when someone asks for the resized or converted versions of one processed image, or their links. Returns the batch's project, template, main URL, formats and sizes plus up to 20 variants with format, size and first-party URL. Not for resizing or converting a new image.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "batchId": {
    "description": "Exact batch id",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "batchId"
  ],
  "type": "object"
 },
 "name": "get_batch",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "batch": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "created": {
        "anyOf": [
         {
          "maxLength": 100,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "edited": {
        "$ref": "#/properties/batch/anyOf/0/properties/created"
       },
       "format": {
        "anyOf": [
         {
          "maxLength": 20,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "formats": {
        "items": {
         "maxLength": 20,
         "type": "string"
        },
        "maxItems": 10,
        "type": "array"
       },
       "id": {
        "maxLength": 200,
        "type": "string"
       },
       "projectId": {
        "$ref": "#/properties/batch/anyOf/0/properties/slug"
       },
       "size": {
        "$ref": "#/properties/batch/anyOf/0/properties/format"
       },
       "sizes": {
        "items": {
         "maxLength": 20,
         "type": "string"
        },
        "maxItems": 10,
        "type": "array"
       },
       "slug": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "templateId": {
        "$ref": "#/properties/batch/anyOf/0/properties/slug"
       },
       "url": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "variants": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "format": {
           "$ref": "#/properties/batch/anyOf/0/properties/format"
          },
          "size": {
           "$ref": "#/properties/batch/anyOf/0/properties/format"
          },
          "url": {
           "$ref": "#/properties/batch/anyOf/0/properties/url"
          }
         },
         "required": [
          "format",
          "size",
          "url"
         ],
         "type": "object"
        },
        "maxItems": 20,
        "type": "array"
       }
      },
      "required": [
       "id",
       "slug",
       "projectId",
       "templateId",
       "url",
       "format",
       "size",
       "formats",
       "sizes",
       "created",
       "edited",
       "variants"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Allowlisted batch metadata; asset URLs are kept only on https://www.imagelato.com/images/. Null when not found."
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "batch"
  ],
  "type": "object"
 },
 "title": "Get a processed image and its variants"
}
