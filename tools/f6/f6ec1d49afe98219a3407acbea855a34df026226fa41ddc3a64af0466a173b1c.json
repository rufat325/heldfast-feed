{
 "_meta": {
  "openai/outputTemplate": "ui://giftroam/app.html@v8",
  "openai/resultCanProduceWidget": true,
  "openai/toolInvocation/invoked": "Found gifts",
  "openai/toolInvocation/invoking": "Searching gifts\u2026",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://giftroam/app.html@v8",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://giftroam/app.html@v8"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search gifts deliverable to a country"
 },
 "description": "Find gifts that can be delivered to a destination country, optionally filtered by free text, occasion, budget (minor units) and a needed-by date. Returns a shortlist with final customer prices (delivery included) and delivery days. Paginate with cursor.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "budget_max": {
    "description": "Maximum price in minor units (cents).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "budget_min": {
    "description": "Minimum price in minor units (cents).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "country": {
    "description": "Destination country, ISO-3166 alpha-2 (e.g. FR).",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "cursor": {
    "description": "Opaque cursor from a previous page.",
    "type": "string"
   },
   "date_needed": {
    "description": "YYYY-MM-DD; only gifts that can arrive by then.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "description": "Display language for results (e.g. he-IL). The query may be typed in that language.",
    "maxLength": 12,
    "type": "string"
   },
   "occasion": {
    "description": "Occasion slug from the occasions resource (e.g. birthday).",
    "maxLength": 48,
    "type": "string"
   },
   "query": {
    "description": "Product keywords, 1-4 words (e.g. 'chocolate basket', 'red roses'). Destination, recipient and occasion are separate fields. Omit for a general browse.",
    "maxLength": 120,
    "type": "string"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
 "name": "search_gifts",
 "outputSchema": {
  "properties": {
   "country": {
    "properties": {
     "iso2": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "date_warning": {
    "description": "Present when the requested needed-by date is unreachable: results are shown WITHOUT the date filter",
    "type": "string"
   },
   "display_text": {
    "description": "Human-readable one-line summary of the result",
    "type": "string"
   },
   "error": {
    "description": "Present only when the call failed",
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "next_step": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "locale": {
    "description": "BCP-47 locale the texts are localized to",
    "type": "string"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "results": {
    "items": {
     "properties": {
      "contains_alcohol": {
       "description": "yes | no | unknown",
       "type": "string"
      },
      "currency": {
       "type": "string"
      },
      "customer_amount_minor": {
       "description": "Price in minor units (cents)",
       "type": "number"
      },
      "delivery_days": {
       "description": "Business-day delivery estimate range",
       "properties": {
        "max": {
         "type": "number"
        },
        "min": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "display_price": {
       "description": "Final customer price incl. delivery, e.g. \"$99.95\"",
       "type": "string"
      },
      "gift_id": {
       "type": "string"
      },
      "image_url": {
       "type": "string"
      },
      "one_liner": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "orders:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Search gifts deliverable to a country"
}
