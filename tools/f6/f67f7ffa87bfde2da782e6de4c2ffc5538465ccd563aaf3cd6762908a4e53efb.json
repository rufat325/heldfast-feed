{
 "annotations": {
  "readOnlyHint": true,
  "title": "List properties"
 },
 "description": "List the properties in the account with their address, currency, check-in times and room types (roomTypes). Optional flags include texts, pictures, offers, unit details and all rooms. Requires the properties scope. Beds24: GET /properties.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "includeAllRooms": {
    "description": "Include every room type of each property.",
    "type": "boolean"
   },
   "includeLanguages": {
    "description": "Languages for texts, e.g. [\"en\"] or [\"all\"].",
    "items": {
     "maxLength": 3,
     "minLength": 2,
     "type": "string"
    },
    "type": "array"
   },
   "includeOffers": {
    "description": "Include offers per room.",
    "type": "boolean"
   },
   "includePictures": {
    "type": "boolean"
   },
   "includePriceRules": {
    "type": "boolean"
   },
   "includeTexts": {
    "description": "Which descriptive texts to include.",
    "items": {
     "enum": [
      "all",
      "property",
      "roomType"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "includeUnitDetails": {
    "description": "Include full unit details (by default only unit names).",
    "type": "boolean"
   },
   "includeUpsellItems": {
    "type": "boolean"
   },
   "page": {
    "description": "Page number beyond the first (2, 3, ...). Check pages.nextPageExists in the previous response.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "propertyIds": {
    "description": "One or more property ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "roomIds": {
    "description": "One or more room ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "beds24_list_properties",
 "title": "List properties"
}
