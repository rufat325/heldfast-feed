{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Suggest icons for each thing a UI description mentions, such as \"settings sidebar with search, profile, and logout\". Splits on commas and words like \"and\" or \"with\", then ranks icons per concept. Pick one per concept, then call get_icon.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"description":{"description":"A short description of the screen, feature, or list of actions that need icons.","maxLength":500,"minLength":1,"type":"string"},"perConcept":{"description":"Candidates per concept (default 3, max 10).","maximum":10,"minimum":1,"type":"integer"}},"required":["description"],"type":"object"},"name":"suggest_icons","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"concepts":{"items":{"additionalProperties":false,"properties":{"concept":{"type":"string"},"results":{"items":{"additionalProperties":false,"properties":{"categories":{"items":{"type":"string"},"type":"array"},"componentName":{"type":"string"},"name":{"type":"string"},"tags":{"items":{"type":"string"},"type":"array"},"url":{"type":"string"}},"required":["name","componentName","categories","tags","url"],"type":"object"},"type":"array"}},"required":["concept","results"],"type":"object"},"type":"array"},"description":{"type":"string"},"unmatched":{"items":{"type":"string"},"type":"array"}},"required":["description","concepts","unmatched"],"type":"object"},"title":"Suggest icons for a UI"}
