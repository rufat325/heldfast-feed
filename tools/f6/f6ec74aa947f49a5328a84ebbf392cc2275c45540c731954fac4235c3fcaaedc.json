{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Update extended access settings: enable/disable inheritance (permissionSources) and/or grant/revoke acl. Disable inheritance first \u2014 acl changes are rejected while inherited.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "acl": {
    "additionalProperties": {},
    "description": "{\"grant\"|\"revoke\": {\"READ\"|\"GRANT\"|\"WRITE\": {\"users\": [\u2026], \"groups\": [\u2026], \"roles\": [\u2026]}}}",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "entityId": {
    "type": "string"
   },
   "entityType": {
    "description": "Entity type: \"project\", \"portfolio\" or \"goal\"",
    "enum": [
     "project",
     "portfolio",
     "goal"
    ],
    "type": "string"
   },
   "permissionSources": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Parent entity id(s) to inherit from; [] disables inheritance"
   }
  },
  "required": [
   "entityType",
   "entityId"
  ],
  "type": "object"
 },
 "name": "update_entity_access"
}
