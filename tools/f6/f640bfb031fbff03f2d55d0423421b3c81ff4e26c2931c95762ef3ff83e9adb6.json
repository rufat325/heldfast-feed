{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find nearest points on approved highway polylines. Historical geometry, not routing or live passability. Example: {\"location_name\":\"Block Game Jerusalem\",\"highway_dimension\":1,\"limit\":3}. Prefer interactiveUrl for human links; recordUrl for identity, provenance and semantic retrieval (location-prefixed on derivatives).",
 "inputSchema": {
  "properties": {
   "dimension": {
    "default": null,
    "description": "0 Overworld, 1 Nether, 2 End. Inferred for a named location; defaults to Overworld for coordinates.",
    "type": [
     "integer",
     "null"
    ]
   },
   "highway_dimension": {
    "default": null,
    "description": "Dimension of highways to compare; omit to use origin dimension. OW/Nether use nominal 8:1 conversion; End cannot convert.",
    "type": [
     "integer",
     "null"
    ]
   },
   "limit": {
    "default": 5,
    "description": "Maximum results, 1\u2013100.",
    "type": "integer"
   },
   "location_id": {
    "default": null,
    "description": "Atlas location ID as the origin; do not combine with x/z or name.",
    "type": [
     "integer",
     "null"
    ]
   },
   "location_name": {
    "default": null,
    "description": "Exact location name, case-insensitive. Ambiguous names require an ID.",
    "type": [
     "string",
     "null"
    ]
   },
   "x": {
    "default": null,
    "description": "Native X coordinate; provide x/z OR location_id OR exact location_name.",
    "type": [
     "integer",
     "null"
    ]
   },
   "z": {
    "default": null,
    "description": "Native Z coordinate, paired with x.",
    "type": [
     "integer",
     "null"
    ]
   }
  },
  "type": "object"
 },
