{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Audit schema.org structured data"
 },
 "description": "Deep schema.org validation for a URL. Parses every JSON-LD block and microdata node, checks required fields per @type (Article needs headline+author+datePublished, FAQPage needs mainEntity, HowTo needs step, etc.), and flags missing fields and malformed JSON-LD. Returns issues list and a valid/invalid verdict. Use to fix structured-data bugs that predict_citation flags but can't explain.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "URL whose JSON-LD and microdata to validate against schema.org expected fields.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "audit_schema",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fetched_at": {
    "description": "UTC ISO-8601 timestamp.",
    "type": "string"
   },
   "issues": {
    "description": "Validation issues found.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning"
       ],
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "path",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "json_ld_blocks": {
    "description": "Total JSON-LD blocks found.",
    "type": "number"
   },
   "json_ld_parse_errors": {
    "description": "Number of JSON-LD blocks that failed to parse.",
    "type": "number"
   },
   "microdata_types_present": {
    "description": "Schema types found via microdata (itemtype).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "schema_types_present": {
    "description": "@type values found across all JSON-LD blocks.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "blocks": {
      "type": "number"
     },
     "errors": {
      "type": "number"
     },
     "typed_nodes": {
      "type": "number"
     },
     "valid": {
      "description": "True when no typed node is missing a required field.",
      "type": "boolean"
     },
     "warnings": {
      "type": "number"
     }
    },
    "required": [
     "blocks",
     "typed_nodes",
     "errors",
     "warnings",
     "valid"
    ],
    "type": "object"
   },
   "url": {
    "description": "URL that was audited.",
    "type": "string"
   }
  },
  "required": [
   "url",
   "fetched_at",
   "json_ld_blocks",
   "json_ld_parse_errors",
   "schema_types_present",
   "microdata_types_present",
   "issues",
   "summary"
  ],
  "type": "object"
 }
}
