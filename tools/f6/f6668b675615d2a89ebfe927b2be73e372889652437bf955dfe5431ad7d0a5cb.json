{
 "description": "List ITSM tickets. Optionally filter by status (open/resolved) or severity.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max tickets to return (default 20)",
    "type": "number"
   },
   "severity": {
    "description": "Filter by severity",
    "enum": [
     "critical",
     "warning",
     "info",
     "all"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "open",
     "resolved",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "itsm_list_tickets"
}
