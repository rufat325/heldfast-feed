{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Delete a string in every language"
 },
 "description": "Use this when someone asks to remove a key from their translations. Returns how many language rows were deleted and which other projects shared them; a shared string is deleted permanently for those projects too. Not for removing only one language's translation.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "description": "Exact key to delete in every language",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "project": {
    "description": "Project id or name that has the key",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "project",
   "key"
  ],
  "type": "object"
 },
 "name": "delete_phrase",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deletedTranslationCount": {
    "minimum": 0,
    "type": "integer"
   },
   "key": {
    "maxLength": 256,
    "type": "string"
   },
   "project": {
    "anyOf": [
     {
      "maxLength": 128,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "sharedProjects": {
    "description": "Other projects the deleted string was also removed from",
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "status": {
    "enum": [
     "deleted",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "project",
   "key",
   "deletedTranslationCount",
   "sharedProjects"
  ],
  "type": "object"
 },
 "title": "Delete a string in every language"
}
