{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Run when catalog JSON is corrupt (list-modules, get-module-details, or validate fail with extra data after JSON). Rewrites the first valid JSON object in architecture, modules, entries, and slices; removes leftover .tmp files; rebuilds the entry index. Does not delete facts. Optional dryRun previews without writing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "description": "Preview repairs without writing (default false)",
    "type": "boolean"
   },
   "projectId": {
    "description": "Required. Call list-projects first (query by workspace folder name) and pass the matching projectId. Never omit. default-project is forbidden.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "fix-data",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "type": "boolean"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": "string"
      },
      "extraBytes": {
       "type": "number"
      },
      "path": {
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "indexItemCount": {
    "type": "number"
   },
   "projectId": {
    "type": "string"
   },
   "repaired": {
    "type": "number"
   },
   "scanned": {
    "type": "number"
   },
   "summary": {
    "type": "string"
   },
   "tmpRemoved": {
    "type": "number"
   },
   "unreadable": {
    "type": "number"
   }
  },
  "required": [
   "projectId",
   "scanned",
   "repaired",
   "unreadable",
   "tmpRemoved",
   "indexItemCount",
   "files",
   "summary",
   "dryRun"
  ],
  "type": "object"
 },
 "title": "Fix Catalog Data"
}
