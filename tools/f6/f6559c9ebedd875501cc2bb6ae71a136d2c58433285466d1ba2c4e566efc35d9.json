{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Validate design"
 },
 "description": "Run every design rule: shape and symbol errors, kernel-friendly head dimensions, tensor-core multiples, whether training and serving fit the chosen device, Chinchilla sanity and drift from published numbers. Each finding carries a fix hint.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "B": {
    "description": "Micro-batch size.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "S": {
    "description": "Source length, for an encoder-decoder: the second sequence its encoder runs along. Defaults to the document's own S; ignored by a design that declares none.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "T": {
    "description": "Sequence length. Defaults to the document's own T.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "concurrency": {
    "description": "Concurrent sequences when serving.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "design_id": {
    "description": "Handle returned by tensorcad_new_design or tensorcad_open_design, e.g. \"dsn_1\".",
    "type": "string"
   },
   "dp": {
    "description": "Data parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "dtype": {
    "description": "Training dtype. Default bf16.",
    "enum": [
     "fp32",
     "bf16",
     "fp16",
     "fp8"
    ],
    "type": "string"
   },
   "ep": {
    "description": "Expert parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "gpus": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "hardware": {
    "description": "Hardware id: h100-sxm, h200-sxm, b200, a100-80, rtx5080 or rtx4090. Default h100-sxm.",
    "type": "string"
   },
   "mfu": {
    "description": "Model FLOPs utilization, 0..1.",
    "exclusiveMinimum": 0,
    "maximum": 1,
    "type": "number"
   },
   "optimizer": {
    "enum": [
     "adamw",
     "adamw8bit",
     "muon",
     "sgd_momentum",
     "sgd",
     "bf16_adam"
    ],
    "type": "string"
   },
   "packing": {
    "description": "Training rows packed with documents, for a design whose mask keeps them apart (doc(b, q) == doc(b, kv)). Moves the training figures and the cost, not serving.",
    "properties": {
     "mean": {
      "description": "Mean document length, in tokens.",
      "minimum": 1,
      "type": "number"
     },
     "spread": {
      "description": "Coefficient of variation of the lengths: 0, the default, is fixed; 1 is exponential.",
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "mean"
    ],
    "type": "object"
   },
   "pp": {
    "description": "Pipeline parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "recompute": {
    "enum": [
     "none",
     "selective",
     "full"
    ],
    "type": "string"
   },
   "severity": {
    "description": "Only return findings at least this bad.",
    "enum": [
     "error",
     "warning",
     "info"
    ],
    "type": "string"
   },
   "tokens": {
    "description": "Training token budget. Defaults to Chinchilla-optimal.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "tp": {
    "description": "Tensor parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "zero": {
    "description": "ZeRO/FSDP sharding stage.",
    "maximum": 3,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "design_id"
  ],
  "type": "object"
 },
 "name": "tensorcad_validate",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "counts": {
    "additionalProperties": false,
    "properties": {
     "error": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "info": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "warning": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "error",
     "warning",
     "info"
    ],
    "type": "object"
   },
   "design_id": {
    "type": "string"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "hint": {
       "description": "What to change to clear the finding.",
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "path": {
       "description": "Block path the finding is about.",
       "type": "string"
      },
      "port": {
       "type": "string"
      },
      "rule": {
       "description": "Stable rule id, e.g. \"flash-head-dim\".",
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "rule",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "params_total": {
    "type": "number"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "design_id",
   "revision",
   "name",
   "ok",
   "counts",
   "findings",
   "params_total"
  ],
  "type": "object"
 },
 "title": "Validate design"
}
