{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new topic on the Data Stream service. Topic name must include the account prefix (use get_topic_prefix first). Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Topic description (max 200 chars)",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, preview without creating",
    "type": "boolean"
   },
   "name": {
    "description": "Topic name including prefix (e.g. h4j6l-mytopic). Max 200 chars, lowercase+numbers+hyphen",
    "type": "string"
   },
   "partitions": {
    "description": "Number of partitions 1~16 (default: 1)",
    "maximum": 16,
    "minimum": 1,
    "type": "number"
   },
   "retentionMs": {
    "description": "Message retention in ms (default: 86400000 = 24h)",
    "maximum": 1296000000,
    "minimum": 3600000,
    "type": "number"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "ncloud_datastream_create_topic"
}
