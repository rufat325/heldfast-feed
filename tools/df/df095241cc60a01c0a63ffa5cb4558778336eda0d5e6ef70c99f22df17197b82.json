{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "search artists"
 },
 "description": "Search artists by name and get every performance we know about, across all sources. Artist records include nullable mbid and cross-provider-verified spotify_id fields for stable matching. Use this to find when and where a specific artist is playing. Great for answering 'When does Bonobo play?', 'Where can I see Tale of Us?', or 'Which cities is Nina Kraviz touring?'",
 "inputSchema": {
  "properties": {
   "artist_name": {
    "description": "Artist name to search for",
    "type": "string"
   },
   "city": {
    "description": "Filter performances by city",
    "type": "string"
   },
   "country": {
    "description": "Filter performances by country",
    "type": "string"
   },
   "end_date": {
    "description": "End date filter (YYYY-MM-DD)",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum artists to return (default 20, max 100)",
    "type": "number"
   },
   "start_date": {
    "description": "Start date filter (YYYY-MM-DD)",
    "type": "string"
   },
   "upcoming_only": {
    "default": true,
    "description": "Only return future performances (default true)",
    "type": "boolean"
   }
  },
  "required": [
   "artist_name"
  ],
  "type": "object"
 },
 "name": "search_artists"
}
