{
 "description": "List messages within a conversation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "conversationId": {
    "description": "Conversation ID",
    "type": "string"
   },
   "lastMessageId": {
    "description": "Cursor: last message ID for pagination",
    "type": "string"
   },
   "limit": {
    "description": "Max messages to return",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "type": {
    "description": "Filter by message type",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "conversationId"
  ],
  "type": "object"
 },
 "name": "crm_list_messages"
}
