 "description": "Recall long-term memories stored about the current household. Call this at the start of advisory or open-ended turns. Filter by type when only one author's notes are relevant.",
 "inputSchema": {
  "examples": [
   {
    "limit": 20,
    "type": "user"
   }
  ],
  "properties": {
   "cursor": {
    "description": "nextCursor from a previous response. Omit for the first page.",
    "examples": [
     "eyJQSyI6IkhvdXNlaG9sZCMxMjM0In0="
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max number of memories to return in this page. 1-100, default 20.",
    "examples": [
     20
    ],
    "type": "integer"
   },
   "type": {
    "description": "Filter by author. Omit for both.",
    "enum": [
     "system",
     "user"
    ],
    "examples": [
     "user"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "recall_memory",
 "outputSchema": {
  "properties": {
