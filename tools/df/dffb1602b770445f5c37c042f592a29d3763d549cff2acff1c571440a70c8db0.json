{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Apply a confirmed operation after its editor drain with confirmed=true. Preserves originals, verifies destination content/media and atomically changes inheritance. Reuses the original key via operationId. EXECUTOR_FENCED requires status/drain or explicit resume; committed-readback errors require the SAME operation, never another activation. Requires instructions:write and current folder-employer access.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirmed": {
    "const": true,
    "type": "boolean"
   },
   "folderId": {
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "operationId": {
    "$ref": "#/properties/folderId"
   }
  },
  "required": [
   "folderId",
   "operationId",
   "confirmed"
  ],
  "type": "object"
 },
 "name": "opentrain_apply_folder_instruction_change",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "committedAt": {
      "anyOf": [
       {
        "$ref": "#/properties/result/properties/quiesceReadyAt"
       },
       {
        "type": "null"
       }
      ]
     },
     "folderId": {
      "$ref": "#/properties/result/properties/operationId"
     },
     "leaseExpiresAt": {
      "$ref": "#/properties/result/properties/quiesceReadyAt"
     },
     "operationId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
     },
     "planDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "quiesceReadyAt": {
      "format": "date-time",
      "type": "string"
     },
     "readbackVerified": {
      "type": "boolean"
     },
     "requiresExplicitResume": {
      "type": "boolean"
     },
     "result": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "archivedPageIds": {
          "items": {
           "$ref": "#/properties/result/properties/operationId"
          },
          "maxItems": 500,
          "type": "array"
         },
         "destinationPages": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "checksum": {
             "$ref": "#/properties/result/properties/planDigest"
            },
            "contentSchemaVersion": {
             "type": "integer"
            },
            "icon": {
             "type": [
              "string",
              "null"
             ]
            },
            "pageId": {
             "$ref": "#/properties/result/properties/operationId"
            },
            "parentPageId": {
             "anyOf": [
              {
               "$ref": "#/properties/result/properties/operationId"
              },
              {
               "type": "null"
              }
             ]
            },
            "sortOrder": {
             "type": "integer"
            },
            "sourcePageId": {
             "anyOf": [
              {
               "$ref": "#/properties/result/properties/operationId"
              },
              {
               "type": "null"
              }
             ]
            },
            "title": {
             "type": "string"
            }
           },
           "required": [
            "pageId",
            "title",
            "icon",
            "sortOrder",
            "contentSchemaVersion",
            "parentPageId",
            "checksum",
            "sourcePageId"
           ],
           "type": "object"
          },
          "maxItems": 500,
          "type": "array"
         },
         "folderId": {
          "$ref": "#/properties/result/properties/operationId"
         },
         "instructionSetId": {
          "$ref": "#/properties/result/properties/operationId"
         },
         "kind": {
          "enum": [
           "ACTIVATE",
           "APPEND",
           "REVERSE"
          ],
          "type": "string"
         },
         "operationId": {
          "$ref": "#/properties/result/properties/operationId"
         },
         "planDigest": {
          "$ref": "#/properties/result/properties/planDigest"
         },
         "preservedFolderPageIds": {
          "$ref": "#/properties/result/properties/result/anyOf/0/properties/archivedPageIds"
         },
         "readbackVerified": {
          "type": "boolean"
         },
         "restoredPageIds": {
          "$ref": "#/properties/result/properties/result/anyOf/0/properties/archivedPageIds"
         },
         "retainedSourcePageIds": {
          "$ref": "#/properties/result/properties/result/anyOf/0/properties/archivedPageIds"
         },
         "reversalGuardDigest": {
          "$ref": "#/properties/result/properties/planDigest"
         },
         "reversedOperationId": {
          "$ref": "#/properties/result/properties/operationId"
         },
         "revisions": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "kind": {
             "type": "string"
            },
            "revision": {
             "minimum": 0,
             "type": "integer"
            },
            "scopeId": {
             "$ref": "#/properties/result/properties/operationId"
            },
            "scopeType": {
             "enum": [
              "JOB",
              "FOLDER"
             ],
             "type": "string"
            }
           },
           "required": [
            "scopeType",
            "scopeId",
            "revision",
            "kind"
           ],
           "type": "object"
          },
          "maxItems": 501,
          "type": "array"
         },
         "visibilityCommitted": {
          "const": true,
          "type": "boolean"
         }
        },
        "required": [
         "operationId",
         "folderId",
         "instructionSetId",
         "planDigest",
         "kind",
         "visibilityCommitted",
         "readbackVerified",
         "destinationPages",
         "archivedPageIds",
         "retainedSourcePageIds",
         "preservedFolderPageIds",
         "revisions",
         "reversalGuardDigest"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "state": {
      "enum": [
       "QUIESCING",
       "STAGING",
       "VERIFIED",
       "COMMITTED",
       "VERIFIED_READBACK",
       "CANCELLED",
       "FAILED"
      ],
      "type": "string"
     },
     "visibilityCommitted": {
      "type": "boolean"
     }
    },
    "required": [
     "operationId",
     "folderId",
     "state",
     "planDigest",
     "visibilityCommitted",
     "readbackVerified",
     "quiesceReadyAt",
     "leaseExpiresAt",
     "committedAt",
     "requiresExplicitResume",
     "result"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
