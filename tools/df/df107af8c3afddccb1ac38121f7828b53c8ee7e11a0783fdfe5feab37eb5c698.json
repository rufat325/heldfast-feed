  "readOnlyHint": true,
  "title": "chainpeek: check a transfer recipient for address poisoning on Base, Ethereum or Robinhood Chain"
 },
 "description": "chainpeek: Check a transfer recipient for address poisoning: lookalikes in the sender's history. For balance, gas and blacklist checks too use transfer_preflight; for OFAC use check_sanctions. Returns a `risk` (high | medium | low) for paying `to`: reads `from`'s transfers of one token (default USDC) over the last 2,000 blocks and finds addresses with `to`'s first 4 and last 4 hex characters; each reason carries its evidence (tx hash, block, amount, direction). High: `to` was never paid and imitates an address `from` paid or a contact, or appears only in zero-value or dust transfers. Medium: a lookalike exists but `to` was paid or is a contact. Older history, other tokens and other lookalikes are not seen. Bad input is a 422, a failed read a 502 (neither charged). Typically 0.5-4 s. Price: USD 0.002. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/address-poisoning-check-api.html",
 "inputSchema": {
  "properties": {
   "chain": {
    "description": "ethereum, base or robinhood (Robinhood Chain, chain id 4663).",
    "enum": [
     "ethereum",
     "base",
     "robinhood"
    ],
    "title": "Chain",
    "type": "string"
   },
   "contacts": {
    "anyOf": [
     {
      "items": {
       "pattern": "^0x[0-9a-fA-F]{40}$",
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Up to 100 addresses you trust (your address book); `to` is compared with them too, without any chain read.",
    "title": "Contacts"
   },
   "dust_threshold": {
    "anyOf": [
     {
      "maximum": 1000000000000.0,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Incoming transfers below this many token units count as dust. Default 0.01 for USDC and USDT; off for other tokens unless set; 0 turns it off.",
    "title": "Dust Threshold"
   },
   "from": {
    "description": "The sending wallet whose transfer history is read (0x + 40 hex).",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "title": "From",
    "type": "string"
   },
   "lookback_blocks": {
    "default": 2000,
    "description": "How many of the latest blocks of history to read (0-2,000; default 2,000, about 67 minutes on Base and 6.7 hours on Ethereum). 0 reads nothing and checks `contacts` only.",
    "maximum": 2000,
    "minimum": 0,
    "title": "Lookback Blocks",
    "type": "integer"
   },
   "to": {
    "description": "The recipient about to be paid (0x + 40 hex). Must differ from `from`.",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "title": "To",
    "type": "string"
   },
   "token": {
    "default": "USDC",
    "description": "USDC (default), USDT, or a token contract address. Only this token's transfers are read. On robinhood pass a contract address.",
    "pattern": "^(USDC|USDT|0x[0-9a-fA-F]{40})$",
    "title": "Token",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "from",
   "to"
  ],
  "title": "check_address_poisoningArguments",
  "type": "object"
 },
