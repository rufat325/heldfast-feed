{
 "description": "List stored memories with optional filters by type, category, scope, or project.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Filter by category (e.g., \"backend\", \"frontend\", or any custom category)",
    "maxLength": 50,
    "type": "string"
   },
   "importance_min": {
    "description": "Only return memories with importance >= this value",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "default": 50,
    "description": "Results per page",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "memory_type": {
    "description": "Filter by type",
    "enum": [
     "identity",
     "preference",
     "architecture",
     "decision",
     "bug",
     "dependency",
     "pattern",
     "context",
     "session_summary",
     "task",
     "correction",
     "reminder",
     "skill",
     "rule",
     "principle",
     "intent"
    ],
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset",
    "type": "integer"
   },
   "scope": {
    "default": "all",
    "description": "Filter by scope",
    "enum": [
     "global",
     "project",
     "all"
    ],
    "type": "string"
   },
   "sort_by": {
    "default": "importance",
    "description": "Sort order: importance (default), updated, created, referenced (most used first), least_used",
    "enum": [
     "importance",
     "updated",
     "created",
     "referenced",
     "least_used"
    ],
    "type": "string"
   },
   "tag": {
    "description": "Filter by tag (e.g., \"marketing-campaign\")",
    "maxLength": 30,
    "type": "string"
   },
   "untyped": {
    "description": "When true, only return memories with no memory_type set",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_memories"
}
