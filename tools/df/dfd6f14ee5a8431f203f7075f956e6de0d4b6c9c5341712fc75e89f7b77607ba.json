{
 "_meta": {
  "ui": {
   "resourceUri": "ui://excalidraw/canvas"
  },
  "ui/resourceUri": "ui://excalidraw/canvas"
 },
 "description": "Render Excalidraw elements as an interactive inline diagram. Pass an array of elements with type, x, y coordinates and optional styling. The diagram streams in progressively as elements are generated. Use read_me first to see available element types and color palettes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "background": {
    "$ref": "#/properties/elements/items/properties/backgroundColor"
   },
   "elements": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "angle": {
       "maximum": 360,
       "minimum": -360,
       "type": "number"
      },
      "backgroundColor": {
       "maxLength": 32,
       "type": "string"
      },
      "fontFamily": {
       "maximum": 4,
       "minimum": 1,
       "type": "integer"
      },
      "fontSize": {
       "maximum": 1000,
       "minimum": 1,
       "type": "number"
      },
      "groupIds": {
       "items": {
        "maxLength": 64,
        "type": "string"
       },
       "maxItems": 50,
       "type": "array"
      },
      "height": {
       "$ref": "#/properties/elements/items/properties/width"
      },
      "locked": {
       "type": "boolean"
      },
      "opacity": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "points": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "x": {
          "$ref": "#/properties/elements/items/properties/x"
         },
         "y": {
          "$ref": "#/properties/elements/items/properties/x"
         }
        },
        "required": [
         "x",
         "y"
        ],
        "type": "object"
       },
       "maxItems": 10000,
       "type": "array"
      },
      "roughness": {
       "maximum": 3,
       "minimum": 0,
       "type": "number"
      },
      "strokeColor": {
       "$ref": "#/properties/elements/items/properties/backgroundColor"
      },
      "strokeWidth": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "text": {
       "maxLength": 10000,
       "type": "string"
      },
      "type": {
       "enum": [
        "rectangle",
        "ellipse",
        "diamond",
        "arrow",
        "text",
        "line",
        "freedraw"
       ],
       "type": "string"
      },
      "width": {
       "maximum": 100000,
       "minimum": 0,
       "type": "number"
      },
      "x": {
       "maximum": 1000000,
       "minimum": -1000000,
       "type": "number"
      },
      "y": {
       "$ref": "#/properties/elements/items/properties/x"
      }
     },
     "required": [
      "type",
      "x",
      "y"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "title": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "elements"
  ],
  "type": "object"
 },
 "name": "create_view",
 "title": "Create Excalidraw View"
}
