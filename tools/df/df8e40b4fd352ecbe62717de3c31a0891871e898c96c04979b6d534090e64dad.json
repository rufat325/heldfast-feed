{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Render any public GLB URL to a PNG via three.ws's hosted three-light rig + auto-framing camera. Returns the PNG inline as a base64 data URL (\u2264 ~4 MB) plus dimensions. Background defaults to #0a0a0a \u2014 pass \"transparent\" for compositing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "background": {
    "description": "CSS color (e.g. \"#0a0a0a\") or \"transparent\". Default \"#0a0a0a\".",
    "type": "string"
   },
   "glbUrl": {
    "description": "Public http(s) URL of a .glb file.",
    "format": "uri",
    "type": "string"
   },
   "height": {
    "description": "Output height in pixels (default 1024).",
    "maximum": 2048,
    "minimum": 64,
    "type": "integer"
   },
   "width": {
    "description": "Output width in pixels (default 1024).",
    "maximum": 2048,
    "minimum": 64,
    "type": "integer"
   }
  },
  "required": [
   "glbUrl"
  ],
  "type": "object"
 },
 "name": "thumbnail_glb",
 "title": "Render a GLB to a PNG thumbnail"
}
