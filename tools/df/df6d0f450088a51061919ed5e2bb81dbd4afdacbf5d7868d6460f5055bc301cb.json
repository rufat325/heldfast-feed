{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Scope a property turnover"
 },
 "description": "Turns move-out inspection findings for a US rental unit into a priced make-ready scope. For a first estimate use property_turnover_quick_estimate; use this one for rate cards, owner decisions, measured quantities or confirmed findings. Inputs: property (ZIP, bedrooms, bathrooms, optional details) and findings (description or issue code, location, extent, quantity); optional rate_card, decisions, detail, read. Returns tasks by trade, low/expected/high costs, priorities, vendor scopes, refer-outs, assumptions, unknowns and download links. Text is read by the matcher alone unless read=ai. Not for: diagnosing hazards, legal advice on deposits, remodel bids, properties outside the US.\nThe same findings under the same ruleset give the same result; AI never sets a number.",
 "inputSchema": {
  "$defs": {
   "Area": {
    "enum": [
     "whole_unit",
     "kitchen",
     "living_room",
     "dining_room",
     "bedroom",
     "bathroom",
     "hallway",
     "entry",
     "laundry",
     "closet",
     "garage",
     "patio_balcony",
     "exterior",
     "yard",
     "other"
    ],
    "type": "string"
   },
   "Constraints": {
    "additionalProperties": false,
    "properties": {
     "access_notes": {
      "maxLength": 500,
      "type": "string"
     },
     "occupied": {
      "default": false,
      "description": "Work happens while occupied.",
      "type": "boolean"
     },
     "target_ready_date": {
      "format": "date",
      "type": "string"
     }
    },
    "type": "object"
   },
   "Decision": {
    "additionalProperties": false,
    "description": "Owner decision. Re-run the same request with decisions to get the approved scope.",
    "properties": {
     "action": {
      "enum": [
       "approve",
       "decline",
       "defer"
      ],
      "type": "string"
     },
     "finding_id": {
      "type": "string"
     },
     "line_id": {
      "type": "string"
     },
     "note": {
      "maxLength": 300,
      "type": "string"
     }
    },
    "required": [
     "action"
    ],
    "type": "object"
   },
   "Extent": {
    "enum": [
     "spot",
     "partial",
     "full"
    ],
    "type": "string"
   },
   "Extraction": {
    "additionalProperties": false,
    "description": "How a finding was produced, when software read it from free text (contract 0.4.0) or\nfrom an uploaded document (``ai_document`` and ``page``, additive).\n\nSet by the web tool when its AI reader (Azure OpenAI) turned a person's own words, or a page\nof their inspection report, into this finding. The engine reports such a finding as\n``resolution: \"ai\"`` with ``needs_review`` and flags its lines; it never changes how the\nfinding is priced.",
    "properties": {
     "confidence": {
      "anyOf": [
       {
        "maximum": 1.0,
        "minimum": 0.0,
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       }
      ],
      "description": "The reader's confidence, 0 to 1."
     },
     "method": {
      "description": "'ai': read by a language model from free text. 'ai_document': read by a language model from a page of an uploaded document.",
      "enum": [
       "ai",
       "ai_document"
      ],
      "type": "string"
     },
     "model": {
      "description": "The model that read it, e.g. 'gpt-5-nano 2025-08-07'.",
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9._:() -]+$",
      "type": "string"
     },
     "page": {
      "description": "'ai_document' only: the page of the upload it was read from (1-based).",
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     },
     "quote": {
      "description": "'ai_document' only: the row's words as printed on that page, contact details masked. Evidence for checking the finding; it never changes the price.",
      "maxLength": 300,
      "type": "string"
     },
     "review": {
      "$ref": "#/$defs/ExtractionReview",
      "description": "'ai_document' only: the person's review before estimating (confirmed, accepted or edited). Leave out when the finding was not checked; it then needs review.",
      "type": "object"
     }
    },
    "required": [
     "method",
     "model",
     "confidence"
    ],
    "type": "object"
   },
   "ExtractionReview": {
    "additionalProperties": false,
    "description": "What the person did with a finding the web tool read from an uploaded document, before\nestimating (contract 0.11.0, additive). ``confirmed``: they pressed \"Looks right\";\n``accepted``: left as read, on a row the page did not flag; ``edited``: they changed it\n(``changed`` names what). A reviewed finding keeps its ``extraction`` (where it came from)\nbut is no longer reported as needing review: the person has checked it.",
    "properties": {
     "changed": {
      "description": "'edited': the fields the person changed.",
      "items": {
       "enum": [
        "description",
        "area",
        "label",
        "extent",
        "quantity"
       ],
       "type": "string"
      },
      "maxItems": 5,
      "type": "array"
     },
     "flags": {
      "description": "Why the page flagged it, if it did.",
      "items": {
       "enum": [
        "low_confidence",
        "medium_confidence",
        "quote_not_on_page",
        "count_unread",
        "column_unclear",
        "ok_unclear",
        "unmatched",
        "loose_match",
        "ai_match"
       ],
       "type": "string"
      },
      "maxItems": 9,
      "type": "array"
     },
     "outcome": {
      "enum": [
       "confirmed",
       "accepted",
       "edited"
      ],
      "type": "string"
     }
    },
    "required": [
     "outcome"
    ],
    "type": "object"
   },
   "Finding": {
    "additionalProperties": false,
    "description": "One observed condition. Give a taxonomy `code` if you know it, else a `description`.",
    "properties": {
     "code": {
      "description": "Optional. Only a code returned by property_turnover_issue_codes (e.g. 'walls.nail_holes'); otherwise leave it out and use description.",
      "maxLength": 80,
      "type": "string"
     },
     "confirmed": {
      "default": false,
      "description": "true: the person checked this AI-read finding (one with extraction) and it says what they meant. It keeps resolution 'ai' but no longer needs review, and the answer is verified once every AI-read finding is confirmed.",
      "type": "boolean"
     },
     "description": {
      "description": "Plain description if no code, e.g. 'dog urine stains in bedroom carpet'.",
      "maxLength": 300,
      "type": "string"
     },
     "extent": {
      "$ref": "#/$defs/Extent",
      "description": "spot | partial | full; defaults per issue.",
      "type": "string"
     },
     "extraction": {
      "$ref": "#/$defs/Extraction",
      "description": "Set by Tektolo's AI reader on findings it read from free text or a document (reading.findings of an earlier answer); keep it when you send such a finding back. They come back as resolution 'ai' with needs_review unless confirmed.",
      "type": "object"
     },
     "id": {
      "description": "Your id for this finding; defaults to f1, f2, ... in order.",
      "maxLength": 40,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "type": "string"
     },
     "location": {
      "$ref": "#/$defs/Location",
      "description": "Object {\"area\": \"bedroom\", \"label\": \"Bedroom 2\"}, or a plain string such as \"Bedroom 2\" or \"kitchen\" (mapped to an area; other text becomes the label).",
      "type": "object"
     },
     "notes": {
      "maxLength": 1000,
      "type": "string"
     },
     "quantity": {
      "$ref": "#/$defs/Quantity",
      "description": "Measured amount, e.g. 120 sq_ft. Derived when omitted.",
      "type": "object"
     },
     "signature_like": {
      "default": false,
      "description": "Set by Tektolo's notes reader (reading.findings, the web tool's rows): the words came right after a sign-off and read like a name or signature ('Thanks!' / 'Rotten Egg Smell'), kept only because they name a safety item. A safety item in them is raised unconfirmed (check first). Keep it when you send such a finding back, so every way of sending the same words gives the same answer.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "FloorCoverings": {
    "additionalProperties": false,
    "description": "What is on the floors. Drives the carpet-cleaning baseline and whole-unit carpet sizes.",
    "properties": {
     "carpet_present": {
      "description": "Is there wall-to-wall carpet? Omit if unknown: carpet findings then imply carpet; with no carpet findings, whole-unit carpet cleaning is left out and listed as unknown.",
      "type": "boolean"
     },
     "carpet_sq_ft": {
      "description": "Carpeted floor area. Omit to assume 60% of the unit floor area.",
      "maximum": 20000,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "Location": {
    "additionalProperties": false,
    "description": "Where the finding is. Also accepted as a plain string (\"Bedroom 2\", \"kitchen\").",
    "properties": {
     "area": {
      "$ref": "#/$defs/Area",
      "default": "whole_unit",
      "type": "string"
     },
     "label": {
      "description": "e.g. 'Bedroom 2'.",
      "maxLength": 60,
      "type": "string"
     }
    },
    "type": "object"
   },
   "PriceTier": {
    "description": "Purchasing channel. Library prices are pm_vendor (a PM buying turns from a local vendor).",
    "enum": [
     "bulk_contract",
     "pm_vendor",
     "retail_one_off"
    ],
    "type": "string"
   },
   "Profile": {
    "enum": [
     "minimum",
     "standard",
     "premium"
    ],
    "type": "string"
   },
   "PropertyProfile": {
    "additionalProperties": false,
    "properties": {
     "bathrooms": {
      "anyOf": [
       {
        "maximum": 12.0,
        "minimum": 0.0,
        "multipleOf": 0.5,
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       }
      ],
      "description": "Half baths count as 0.5."
     },
     "bedrooms": {
      "description": "0 for a studio.",
      "maximum": 12,
      "minimum": 0,
      "type": "integer"
     },
     "floor_coverings": {
      "$ref": "#/$defs/FloorCoverings",
      "type": "object"
     },
     "sq_ft": {
      "description": "Interior sq ft.",
      "maximum": 20000,
      "minimum": 150,
      "type": "integer"
     },
     "unit_type": {
      "$ref": "#/$defs/UnitType",
      "default": "apartment",
      "description": "Single-family homes and townhomes get house-sized defaults (floor area, locks).",
      "type": "string"
     },
     "year_built": {
      "description": "Drives lead-paint (pre-1978) handling.",
      "maximum": 2100,
      "minimum": 1700,
      "type": "integer"
     },
     "zip": {
      "description": "5-digit US ZIP code (no street address).",
      "pattern": "^\\d{5}$",
      "type": "string"
     }
    },
    "required": [
     "zip",
     "bedrooms",
     "bathrooms"
    ],
    "type": "object"
   },
   "Quantity": {
    "additionalProperties": false,
    "properties": {
     "uom": {
      "$ref": "#/$defs/Uom",
      "type": "string"
     },
     "value": {
      "anyOf": [
       {
        "exclusiveMinimum": 0.0,
        "maximum": 100000.0,
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       }
      ]
     }
    },
    "required": [
     "value",
     "uom"
    ],
    "type": "object"
   },
   "RateCardEntry": {
    "additionalProperties": false,
    "description": "Your own price. Examples: {\"trade\": \"handyman\", \"unit_price\": 65, \"uom\": \"hour\"} (an\nhourly labor rate for that trade); {\"trade\": \"painter\", \"min_charge\": 150} (visit minimum);\n{\"task_id\": \"carpet.clean\", \"unit_price\": 0.2, \"uom\": \"sq_ft\"} (task_id from a result line).\nA task_id entry beats a trade entry; both beat the library. The result lists what was\napplied and what was ignored (rate_card_applied / rate_card_ignored).",
    "properties": {
     "min_charge": {
      "anyOf": [
       {
        "minimum": 0.0,
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       }
      ],
      "description": "USD per trade visit."
     },
     "task_id": {
      "description": "A task_id from a result line, e.g. 'carpet.clean'.",
      "type": "string"
     },
     "trade": {
      "$ref": "#/$defs/Trade",
      "type": "string"
     },
     "trip_charge": {
      "anyOf": [
       {
        "minimum": 0.0,
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       }
      ],
      "description": "USD per trade visit."
     },
     "unit_price": {
      "anyOf": [
       {
        "minimum": 0.0,
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       }
      ],
      "description": "USD per uom. On a trade entry, uom 'hour' is an hourly labor rate (replaces the labor part of that trade's prices); another uom prices that trade's tasks in it."
     },
     "uom": {
      "$ref": "#/$defs/Uom",
      "description": "Unit your price is quoted in. Required with a trade unit_price. If it differs from a task's uom, the entry is not applied to that task (see rate_card_ignored).",
      "type": "string"
     }
    },
    "type": "object"
   },
   "Standards": {
    "additionalProperties": false,
    "properties": {
     "overrides": {
      "$ref": "#/$defs/StandardsOverrides",
      "type": "object"
     },
     "price_tier": {
      "$ref": "#/$defs/PriceTier",
      "default": "pm_vendor",
      "description": "bulk_contract (portfolio contract prices) | pm_vendor (default: a property manager buying turns from local vendors) | retail_one_off (an owner hiring one contractor).",
      "type": "string"
     },
     "profile": {
      "$ref": "#/$defs/Profile",
      "default": "standard",
      "description": "minimum (rent-ready basics) | standard | premium (higher finish).",
      "type": "string"
     }
    },
    "type": "object"
   },
   "StandardsOverrides": {
    "additionalProperties": false,
    "properties": {
     "always_rekey": {
      "type": "boolean"
     },
     "carpet_policy": {
      "enum": [
       "clean",
       "replace_if_damaged",
       "always_replace"
      ],
      "type": "string"
     },
     "cleaning_policy": {
      "enum": [
       "standard",
       "deep"
      ],
      "type": "string"
     },
     "markup_pct": {
      "anyOf": [
       {
        "maximum": 100.0,
        "minimum": 0.0,
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       }
      ],
      "description": "Management markup applied to every line, %."
     },
     "paint_policy": {
      "enum": [
       "touch_up",
       "full_if_needed",
       "always_full"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "Trade": {
    "enum": [
     "hauling",
     "handyman",
     "drywall",
     "painter",
     "flooring",
     "carpet_cleaning",
     "cleaning",
     "appliance",
     "plumber",
     "electrician",
     "hvac",
     "locksmith",
     "pest_control",
     "landscaping",
     "window_glass",
     "environmental",
     "structural"
    ],
    "type": "string"
   },
   "UnitType": {
    "enum": [
     "apartment",
     "single_family",
     "townhome",
     "condo",
     "duplex",
     "manufactured"
    ],
    "type": "string"
   },
   "Uom": {
    "enum": [
     "each",
     "sq_ft",
     "sq_ft_floor",
     "sq_yd",
     "linear_ft",
     "room",
     "unit",
     "bedroom",
     "bathroom",
     "hour",
     "cu_yd",
     "visit"
    ],
    "type": "string"
   },
   "Vendor": {
    "additionalProperties": false,
    "properties": {
     "contact": {
      "maxLength": 200,
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   }
  },
  "examples": [
   {
    "findings": [
     {
      "description": "pet urine in carpet",
      "location": "Bedroom 2"
     },
     {
      "description": "3 blinds broken",
      "quantity": {
       "uom": "each",
       "value": 3
      }
     }
    ],
    "property": {
     "bathrooms": 1,
     "bedrooms": 2,
     "zip": "43215"
    }
   }
  ],
  "properties": {
   "audit": {
    "default": false,
    "description": "Also return the run record and input/result hashes (an audit trail). Default false.",
    "type": "boolean"
   },
   "client_refs": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Your own reference ids (e.g. unit_id, job_id). Echoed back, never used.",
    "type": "object"
   },
   "constraints": {
    "$ref": "#/$defs/Constraints",
    "description": "Target ready date, whether the unit is occupied, access notes.",
    "type": "object"
   },
   "decisions": {
    "description": "Approve, decline or defer lines or findings from an earlier scope.",
    "items": {
     "$ref": "#/$defs/Decision"
    },
    "maxItems": 500,
    "type": "array"
   },
   "detail": {
    "default": "summary",
    "description": "summary: totals, trade scopes, every line tied to a finding (capped at 40) plus the largest must-fix/refer-out lines, a one-line note on the routine lines left out, notes, and only findings needing attention (small). full: every line, finding and source.",
    "enum": [
     "summary",
     "full"
    ],
    "type": "string"
   },
   "expect_ruleset": {
    "description": "Optional. The ruleset version you built against, as results carry it in provenance.ruleset_version (e.g. 'sd-2026.11.14'), or its sha256: hash. If the rules have changed since, the call fails (nothing computed, nothing charged) and says what is in force now, so you upgrade on your own schedule. Leave it out to answer under the current rules.",
    "type": "string"
   },
   "findings": {
    "description": "Move-out inspection findings, one per condition, with location and extent.",
    "items": {
     "$ref": "#/$defs/Finding"
    },
    "maxItems": 200,
    "type": "array"
   },
   "property": {
    "$ref": "#/$defs/PropertyProfile",
    "description": "The unit: ZIP, size, type and year built.",
    "type": "object"
   },
   "rate_card": {
    "description": "Your own prices by trade or task; they replace the regional library prices.",
    "items": {
     "$ref": "#/$defs/RateCardEntry"
    },
    "maxItems": 300,
    "type": "array"
   },
   "read": {
    "default": "parser",
    "description": "parser (default): descriptions are read by the deterministic parser and matcher only; what they cannot place comes back as a manual-quote line with suggested codes. ai: what the parser cannot place is then read by an AI model; the answer is a draft (review.status) and echoes the reading, whose findings you confirm and send back for a verified answer (contract 0.12.0).",
    "enum": [
     "parser",
     "ai"
    ],
    "type": "string"
   },
   "retain": {
    "default": true,
    "description": "Optional (contract 0.5.0). false: keep none of this request's text. By default the finding descriptions are kept with contact details and access codes removed, to improve matching; the estimate is the same either way.",
    "type": "boolean"
   },
   "serve_pinned": {
    "default": false,
    "description": "Optional, with expect_ruleset. True asks us to answer under the ruleset version you named even when the rules have changed since, from that version's signed bundle; the result says so in served_from_bundle. We refuse a version older than 12 months, one a later correction or law change replaced for your state, or one we have no bundle for. Default false: the call fails whenever the rules have changed.",
    "type": "boolean"
   },
   "standards": {
    "$ref": "#/$defs/Standards",
    "description": "Finish profile, price tier and overrides.",
    "type": "object"
   },
   "tax_rate": {
    "anyOf": [
     {
      "maximum": 0.2,
      "minimum": 0.0,
      "type": "number"
     },
     {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "type": "string"
     }
    ],
    "description": "Applied to all lines, e.g. 0.07."
   },
   "trade_vendors": {
    "additionalProperties": {
     "$ref": "#/$defs/Vendor"
    },
    "description": "Vendor (name, contact) to put on each trade's lines.",
    "propertyNames": {
     "$ref": "#/$defs/Trade"
    },
    "type": "object"
   }
  },
  "required": [
   "property"
  ],
  "type": "object"
 },
 "name": "property_turnover_scope",
 "outputSchema": {
  "$defs": {
   "CostRange": {
    "properties": {
     "expected": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       }
      ]
     },
     "high": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       }
      ]
     },
     "low": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       }
      ]
     }
    },
    "required": [
     "low",
     "expected",
     "high"
    ],
    "type": "object"
   },
   "Extent": {
    "enum": [
     "spot",
     "partial",
     "full"
    ],
    "type": "string"
   },
   "FindingResolution": {
    "properties": {
     "code": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "confidence": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "confirmed": {
      "default": false,
      "type": "boolean"
     },
     "extent": {
      "anyOf": [
       {
        "$ref": "#/$defs/Extent"
       },
       {
        "type": "null"
       }
      ]
     },
     "finding_id": {
      "type": "string"
     },
     "issue_name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "line_ids": {
