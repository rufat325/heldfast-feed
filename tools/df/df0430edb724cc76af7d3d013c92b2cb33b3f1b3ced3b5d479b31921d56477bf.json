{
 "description": "Assign a zone to a channel",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channel": {
    "description": "Channel ID",
    "type": "number"
   },
   "zone": {
    "additionalProperties": false,
    "description": "Zone object with id and type",
    "properties": {
     "id": {
      "description": "Zone ID",
      "type": "number"
     },
     "type": {
      "description": "Zone type (default: standard_zone)",
      "enum": [
       "standard_zone",
       "email_zone"
      ],
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "channel",
   "zone"
  ],
  "type": "object"
 },
 "name": "create_channel_zone_assignment"
}
