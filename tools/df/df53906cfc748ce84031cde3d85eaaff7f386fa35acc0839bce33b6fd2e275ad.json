{
 "_meta": {
  "openai/fileParams": [
   "file"
  ],
  "openai/toolInvocation/invoked": "Invoice read",
  "openai/toolInvocation/invoking": "Reading the invoice",
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "mcp"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Invoice to Excel"
 },
 "description": "Read an invoice (PDF, scan or photo) and turn it into a spreadsheet: returns the header fields, the line items and download links to an Excel (.xlsx) and a CSV file, valid for 60 minutes without signing in. Give the file as file_url, file_base64 or (ChatGPT) file.",
 "inputSchema": {
  "$defs": {
   "ChatGPTFile": {
    "description": "ChatGPT's file object (Apps SDK `openai/fileParams`).",
    "properties": {
     "download_url": {
      "title": "Download Url",
      "type": "string"
     },
     "file_id": {
      "title": "File Id",
      "type": "string"
     },
     "file_name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "File Name"
     },
     "mime_type": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Mime Type"
     }
    },
    "required": [
     "download_url",
     "file_id"
    ],
    "title": "ChatGPTFile",
    "type": "object"
   }
  },
  "properties": {
   "file": {
    "anyOf": [
     {
      "$ref": "#/$defs/ChatGPTFile"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "ChatGPT only: the attached file. Other clients use file_url or file_base64."
   },
   "file_base64": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The invoice file's bytes, base64-encoded. Use for a local file.",
    "title": "File Base64"
   },
   "file_name": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The file's name, e.g. invoice-1042.pdf (optional).",
    "title": "File Name"
   },
   "file_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "An https link to the invoice (PDF or image) that the server can download.",
    "title": "File Url"
   }
  },
  "title": "invoice_to_excelArguments",
  "type": "object"
 },
 "name": "invoice_to_excel",
 "title": "Invoice to Excel"
}
