{
 "description": "Get today's Starknet network statistics over a recent window.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hours": {
    "description": "Lookback window. Defaults to 24h.",
    "enum": [
     "1h",
     "4h",
     "24h"
    ],
    "type": "string"
   },
   "network": {
    "description": "Network to query. Defaults to the server's configured network (mainnet).",
    "enum": [
     "mainnet",
     "sepolia"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_today_stats"
}
