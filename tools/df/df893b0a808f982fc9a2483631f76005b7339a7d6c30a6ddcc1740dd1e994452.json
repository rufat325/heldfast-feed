{
 "description": "Verify a disclosure receipt without exposing its content, category, severity, or commitment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "receipt_id": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "receipt_id"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "payload": {
      "additionalProperties": false,
      "properties": {
       "commitment": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
       },
       "id": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
       },
       "issued_at": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
        "type": "string"
       },
       "key_id": {
        "maxLength": 30,
        "minLength": 1,
        "type": "string"
       },
       "kind": {
        "enum": [
         "leak",
         "confession"
        ],
        "type": "string"
       },
       "release_mode": {
        "enum": [
         "agent",
         "editor",
         "private"
        ],
        "type": "string"
       },
       "site": {
        "enum": [
         "leaks",
         "confession"
        ],
        "type": "string"
       },
       "stage": {
        "enum": [
         "intended",
         "in_progress",
         "ongoing",
         "completed"
        ],
        "type": "string"
       },
       "v": {
        "const": 1,
        "type": "number"
       }
      },
      "required": [
       "v",
       "id",
       "kind",
       "site",
       "stage",
       "commitment",
       "release_mode",
       "issued_at",
       "key_id"
      ],
      "type": "object"
     },
     "signature": {
      "maxLength": 128,
      "type": "string"
     }
    },
    "required": [
     "payload",
     "signature"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "name": "verify_receipt"
}
