{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search literal words in public normalized journal records. Use before reading a returned ID. No private results, generated answers or external fetches. Cursor expires after one hour; maximum 100 records.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque next_cursor from the preceding page; expires after one hour.",
    "maxLength": 2048,
    "type": "string"
   },
   "kind": {
    "enum": [
     "page",
     "summary",
     "cost",
     "work"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Page size; default 20, maximum 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Literal words in public titles and normalized descriptions; no regex or generated answers.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_content",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "canonical": {
       "format": "uri",
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "id": {
       "description": "Stable published content ID; never a path or URL.",
       "pattern": "^[a-z0-9][a-z0-9-]{0,119}$",
       "type": "string"
      },
      "kind": {
       "enum": [
        "page",
        "summary",
        "cost",
        "work"
       ],
       "type": "string"
      },
      "last_updated": {
       "type": "string"
      },
      "revision": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "kind",
      "title",
      "description",
      "canonical",
      "last_updated",
      "revision"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limit": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "snapshot": {
    "type": "string"
   }
  },
  "required": [
   "items",
   "next_cursor",
   "snapshot",
   "limit"
  ],
  "type": "object"
 },
 "title": "Search journal records"
}
