{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List comments on a test case. Pass versionNo to read comments for a specific version (defaults to the latest version when omitted). Returns paginated { data: [{ id, comment, created, updated, isEdited }] }.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "fields": {
    "description": "Comma-separated fields to return",
    "type": "string"
   },
   "id": {
    "description": "Test case UID (from search) or key (e.g. PROJ-TC-123)",
    "type": [
     "string",
     "number"
    ]
   },
   "maxResults": {
    "description": "Items per page (max 100, default 50)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "Sort e.g. \"id:asc\" or \"updated:desc\"",
    "type": "string"
   },
   "startAt": {
    "description": "Page offset (default 0)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "versionNo": {
    "description": "Test case version number (defaults to latest)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "qtm4j_get_test_case_comments",
 "title": "Get Test Case Comments"
}
