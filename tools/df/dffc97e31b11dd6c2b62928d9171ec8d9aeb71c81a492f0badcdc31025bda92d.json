{
 "description": "Return the preview naming convention plus a ready-to-paste preview code template for a component, so any agent writes consistent previews.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "component": {
    "description": "Component name, e.g. \"Button\"",
    "type": "string"
   },
   "platform": {
    "description": "Target platform",
    "enum": [
     "android",
     "ios"
    ],
    "type": "string"
   },
   "states": {
    "description": "State names, e.g. [\"Enabled\", \"Disabled\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "platform"
  ],
  "type": "object"
 },
 "name": "get_preview_guidance"
}
