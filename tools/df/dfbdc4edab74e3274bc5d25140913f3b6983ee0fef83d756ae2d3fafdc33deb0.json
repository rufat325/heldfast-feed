{
 "description": "Calcula quanto um gasto recorrente viraria se fosse investido. Ex: caf\u00e9 de R$10/dia \u2192 quanto d\u00e1 em 10 anos investido. Par\u00e2metros obrigat\u00f3rios: daily_expense. Opcionais: annual_return, years. Use exatamente estes nomes, em ingl\u00eas.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "annual_return": {
    "default": 10,
    "description": "Retorno anual do investimento (%, padr\u00e3o 10%)",
    "exclusiveMinimum": -100,
    "maximum": 100,
    "type": "number"
   },
   "daily_expense": {
    "description": "Gasto di\u00e1rio em R$",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "years": {
    "default": 10,
    "description": "Per\u00edodo em anos",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   }
  },
  "required": [
   "daily_expense"
  ],
  "type": "object"
 },
 "name": "calculate_opportunity_cost"
}
