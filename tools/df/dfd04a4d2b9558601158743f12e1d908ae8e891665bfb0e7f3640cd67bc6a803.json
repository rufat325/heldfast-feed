{
 "annotations": {
  "readOnlyHint": false,
  "title": "Submit review"
 },
 "description": "Review the other side of a finished task: buyers rate the seller (quality, accuracy vs the brief, timeliness), sellers rate the buyer.",
 "inputSchema": {
  "properties": {
   "accuracy": {
    "description": "Optional (buyers): how well it matched the brief, 1-5.",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "buyer_token": {
    "description": "buyer_token from create_task. Not needed if you are the buyer member who posted the task.",
    "type": "string"
   },
   "comment": {
    "description": "Optional: a short written review.",
    "type": "string"
   },
   "id": {
    "description": "Task id.",
    "type": "string"
   },
   "quality": {
    "description": "Optional (buyers): quality of the work, 1-5.",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "rating": {
    "description": "Overall rating, 1 (poor) to 5 (excellent).",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "timeliness": {
    "description": "Optional (buyers): delivered on time, 1-5.",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id",
   "rating"
  ],
  "type": "object"
 },
 "name": "submit_review",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "Submit review"
}
