{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Every Hyperliquid wallet ranked by realized PnL, biggest losses or volume over a window. Wallets with fewer than 5 fills in the window are left out.",
 "inputSchema": {
  "properties": {
   "from": {
    "description": "Unix ms window start (default 30d ago)",
    "type": "number"
   },
   "limit": {
    "description": "Number of rows, max 200, default 50",
    "type": "number"
   },
   "sort_by": {
    "description": "Ranking metric",
    "enum": [
     "realized_pnl",
     "loss",
     "volume"
    ],
    "type": "string"
   },
   "to": {
    "description": "Unix ms window end (default now)",
    "type": "number"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_pnl_leaderboard",
 "outputSchema": {
  "description": "Wallets ranked over the window",
  "properties": {
   "data": {
    "description": "Wallets",
    "items": {
     "description": "One wallet",
     "properties": {
      "address": {
       "description": "Wallet address (0x\u2026)"
      },
      "fills": {
       "description": "Fills in the window"
      },
      "losses": {
       "description": "Losing closing fills"
      },
      "maker_fills": {
       "description": "Fills as maker"
      },
      "markets_count": {
       "description": "Markets traded"
      },
      "max_drawdown_pct": {
       "description": "Largest peak-to-trough drop of the PnL curve, 0 to 1"
      },
      "pct_maker": {
       "description": "Share of fills as maker, 0 to 1"
      },
      "realized_pnl": {
       "description": "Realized PnL in USD"
      },
      "taker_fills": {
       "description": "Fills as taker"
      },
      "volume_usd": {
       "description": "Traded notional in USD"
      },
      "win_rate": {
       "description": "Share of closed trades that were profitable, 0 to 1"
      },
      "wins": {
       "description": "Profitable closing fills"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "from": {
    "description": "Window start, Unix milliseconds"
   },
   "sort_by": {
    "description": "Ranking metric"
   },
   "to": {
    "description": "Window end, Unix milliseconds"
   }
  },
  "type": "object"
 }
}
