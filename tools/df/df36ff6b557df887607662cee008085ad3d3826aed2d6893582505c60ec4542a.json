{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Screenshot a Web Page"
 },
 "description": "Take a screenshot of a website. Open any web page URL in a real browser and capture it as a PNG image, either the visible area or the full page. Use it to see what a site looks like, check a page layout, or capture visual proof of a web page. Price: $0.01 per successful call; failed calls are free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "api_key": {
    "description": "Your Unstuck API key, if this connection has none. Leave empty to try free tools or to get a key and payment link.",
    "maxLength": 200,
    "type": "string"
   },
   "full_page": {
    "description": "Capture the whole scrollable page instead of just the viewport (capped at 10000px tall).",
    "type": "boolean"
   },
   "height": {
    "description": "Viewport height in pixels (default 800).",
    "maximum": 2160,
    "minimum": 240,
    "type": "integer"
   },
   "url": {
    "description": "The http(s) URL of the web page to capture.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "width": {
    "description": "Viewport width in pixels (default 1280).",
    "maximum": 1920,
    "minimum": 320,
    "type": "integer"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "screenshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance_usd": {
    "description": "Remaining prepaid balance, USD.",
    "type": "number"
   },
   "bytes": {
    "description": "PNG size in bytes.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "charged_usd": {
    "description": "Amount charged for this call, USD.",
    "type": "number"
   },
   "expires_at": {
    "description": "When the link expires (ISO 8601).",
    "type": "string"
   },
   "final_url": {
    "description": "Page URL after redirects.",
    "type": "string"
   },
   "title": {
    "description": "Page title.",
    "type": "string"
   },
   "url": {
    "description": "Link to the PNG, valid for 24 hours.",
    "type": "string"
   },
   "width": {
    "description": "Viewport width used, in pixels.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "url",
   "expires_at",
   "final_url",
   "title",
   "width",
   "bytes",
   "charged_usd",
   "balance_usd"
  ],
  "type": "object"
 },
 "title": "Screenshot a Web Page"
}
