{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Checks the SEO and Product data of a product page. Use it when the user asks whether one product page of an online store is set up for search, for example \"is https://shop.example.com/products/blue-mug set up for search?\", \"does my product page have Product structured data?\" or \"why does Google show no price for this product?\". Pass the product page address. Returns title and meta description length, h1 headings, canonical link, Open Graph tags, and the Product structured data (JSON-LD): name, brand, SKU, GTIN, MPN, price, currency, availability, variant count and rating summary, plus a list of issues found. On Shopify it adds the product handle and whether a variant parameter is in the address. Works on any store. It reads one page, skips it if robots.txt disallows it for Agent Tools, and does not run JavaScript. Do not use it for page speed, rankings or traffic, to collect prices or catalogs, or for private or local addresses.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "Address of one public product page, for example https://shop.example.com/products/blue-mug. Works on any online store; Shopify-specific fields are filled in when the store is on Shopify.",
    "maxLength": 2048,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "product_page_seo",
 "outputSchema": {
  "properties": {
   "blockedByRobots": {
    "type": "boolean"
   },
   "failure": {
    "type": "string"
   },
   "finalUrl": {
    "type": "string"
   },
   "issues": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "jsonLdBlocks": {
    "type": "integer"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "openGraph": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "page": {
    "properties": {
     "canonical": {
      "type": "string"
     },
     "canonicalMatchesPage": {
      "type": "boolean"
     },
     "description": {
      "type": "string"
     },
     "descriptionLength": {
      "type": "integer"
     },
     "h1": {
      "type": "string"
     },
     "h1Count": {
      "type": "integer"
     },
     "language": {
      "type": "string"
     },
     "robots": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "titleLength": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "platform": {
    "enum": [
     "shopify",
     "unknown"
    ],
    "type": "string"
   },
   "product": {
    "properties": {
     "aggregateRating": {
      "properties": {
       "count": {
        "type": "number"
       },
       "ratingValue": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "brand": {
      "type": "string"
     },
     "descriptionLength": {
      "type": "integer"
     },
     "gtin": {
      "type": "string"
     },
     "imageCount": {
      "type": "integer"
     },
     "mpn": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "offers": {
      "properties": {
       "availability": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "count": {
        "type": "integer"
       },
       "currencies": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "priceMax": {
        "type": "number"
       },
       "priceMin": {
        "type": "number"
       },
       "withPrice": {
        "type": "integer"
       }
      },
      "type": "object"
     },
     "schemaType": {
      "type": "string"
     },
     "sku": {
      "type": "string"
     },
     "variants": {
      "properties": {
       "count": {
        "type": "integer"
       },
       "withGtin": {
        "type": "integer"
       },
       "withMpn": {
        "type": "integer"
       },
       "withSku": {
        "type": "integer"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "reachable": {
    "type": "boolean"
   },
   "shopify": {
    "properties": {
     "handle": {
      "type": "string"
     },
     "variantInUrl": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "type": "integer"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "reachable",
   "notice",
   "source"
  ],
  "type": "object"
 },
 "title": "Check product JSON-LD and page SEO"
}
