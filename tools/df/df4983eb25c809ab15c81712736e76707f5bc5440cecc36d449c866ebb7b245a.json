{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Suggest a starting point on a mesh. Validate its coverage with an actual drape.",
 "inputSchema": {
  "properties": {
   "angle": {
    "default": 0,
    "title": "Angle",
    "type": "number"
   },
   "lock_angle": {
    "default": 45,
    "exclusiveMaximum": 90,
    "exclusiveMinimum": 0,
    "title": "Lock Angle",
    "type": "number"
   },
   "mesh_id": {
    "pattern": "^[A-Za-z0-9_-]{1,80}$",
    "title": "Mesh Id",
    "type": "string"
   },
   "workspace_id": {
    "pattern": "^[0-9a-f]{48}$",
    "title": "Workspace Id",
    "type": "string"
   }
  },
  "required": [
   "workspace_id",
   "mesh_id"
  ],
  "title": "suggest_seedArguments",
  "type": "object"
 },
 "name": "suggest_seed",
 "outputSchema": {
  "additionalProperties": true,
  "title": "suggest_seedDictOutput",
  "type": "object"
 }
}
