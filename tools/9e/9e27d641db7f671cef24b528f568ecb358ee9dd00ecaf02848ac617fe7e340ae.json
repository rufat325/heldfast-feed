 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read the app Tail feed with its account-filtered community, following, own, profile, bookmark or private-list visibility. Uses app moderation, mutes and account-bound cursor rules; does not post. Action and version are fixed by this tool; do not supply them.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "maxLength": 1500,
    "minLength": 1,
    "type": "string"
   },
   "feed": {
    "enum": [
     "community",
     "for_you",
     "following",
     "own",
     "profile",
     "bookmarks",
     "list"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "listId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "profileId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "search": {
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_tail_feed",
 "securitySchemes": [
  {
   "scopes": [
    "tail.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Read Tail feed"
}
