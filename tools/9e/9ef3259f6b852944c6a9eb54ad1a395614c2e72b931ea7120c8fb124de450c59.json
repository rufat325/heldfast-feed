{
 "description": "Look up one GitHub issue or PR by repo + number. Celestia repos only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "number": {
    "description": "Issue or PR number.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "repo": {
    "description": "Repo, e.g. \"celestiaorg/celestia-app\" or shorthand \"celestia-app\".",
    "type": "string"
   }
  },
  "required": [
   "repo",
   "number"
  ],
  "type": "object"
 },
 "name": "get_issue_status"
}
