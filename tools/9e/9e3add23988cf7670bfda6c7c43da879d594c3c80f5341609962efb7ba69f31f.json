{"description":"Saves the rider's answers to their Etapa account and starts building their guide, as the app does. Every agreement must be true. Building takes a minute or two: call `etapa_get_guide` next.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"activity":{"enum":["none","light","regular","high"],"type":"string"},"beginner":{"description":"For `getting_started` and `returning`","properties":{"goal":{"enum":["habit","endurance","century"],"type":"string"},"rideSetting":{"enum":["outdoor","indoor","both"],"type":"string"},"ridesPerWeek":{"default":1,"maximum":4,"minimum":1,"type":"integer"},"startDate":{"description":"`this_monday`, `next_monday`, or a date YYYY-MM-DD","pattern":"^(this_monday|next_monday|\\d{4}-\\d{2}-\\d{2})$","type":"string"},"strengthPerWeek":{"default":0,"maximum":2,"minimum":0,"type":"integer"},"weeks":{"anyOf":[{"const":8,"type":"number"},{"const":12,"type":"number"},{"const":16,"type":"number"}]}},"required":["goal","rideSetting","weeks","startDate"],"type":"object"},"companion":{"description":"Who guides them; matteo for a new rider with no preference. Leave out for a rider who has one and didn't ask to change","enum":["clara","lars","sophie","matteo","elena","tom","kai"],"type":"string"},"consent":{"description":"All four agreements, each answered yes by the rider","properties":{"age16":{"const":true,"type":"boolean"},"aiCompanion":{"const":true,"type":"boolean"},"healthNote":{"const":true,"type":"boolean"},"termsAndPrivacy":{"const":true,"type":"boolean"}},"required":["age16","termsAndPrivacy","aiCompanion","healthNote"],"type":"object"},"cyclingFrequency":{"enum":["never","occasional","recent_weeks","regular"],"type":"string"},"guide":{"description":"For `fitter` and `find_goal`","properties":{"bikes":{"items":{"enum":["road","gravel","mtb","ebike","indoor"],"type":"string"},"minItems":1,"type":"array"},"event":{"properties":{"date":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"distanceKm":{"maximum":2000,"minimum":1,"type":"number"},"elevationM":{"maximum":30000,"minimum":0,"type":"number"},"name":{"maxLength":150,"minLength":1,"type":"string"}},"required":["name","date"],"type":"object"},"indoorPerWeek":{"default":0,"maximum":6,"minimum":0,"type":"integer"},"outdoorPerWeek":{"default":2,"maximum":6,"minimum":0,"type":"integer"},"startDate":{"description":"`this_monday`, `next_monday`, or a date YYYY-MM-DD","pattern":"^(this_monday|next_monday|\\d{4}-\\d{2}-\\d{2})$","type":"string"},"strengthPerWeek":{"default":0,"maximum":3,"minimum":0,"type":"integer"},"weeks":{"anyOf":[{"const":4,"type":"number"},{"const":8,"type":"number"},{"const":12,"type":"number"},{"const":16,"type":"number"}]}},"required":["bikes","startDate"],"type":"object"},"intent":{"enum":["getting_started","returning","find_goal","fitter"],"type":"string"},"longestRide":{"description":"Their longest ride in the last 3 months, as a band","enum":["none","under_15","15_30","30_60","60_100","100_160","over_160"],"type":"string"},"longestRideKm":{"description":"Or the distance in km, if they gave a number","maximum":1000,"minimum":0,"type":"number"},"name":{"description":"What their companion calls them","maxLength":100,"minLength":1,"type":"string"}},"required":["consent","name","activity","cyclingFrequency","intent"],"type":"object"},"name":"etapa_build_guide","title":"Etapa sign-up: build the rider's guide"}
