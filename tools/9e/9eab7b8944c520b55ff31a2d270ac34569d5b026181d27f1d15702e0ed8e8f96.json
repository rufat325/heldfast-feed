{
 "description": "One-call health check for an Evernode host (the official docs' troubleshooting checklist, automated): registration entry on the governor namespace, heartbeat liveness vs the on-chain active rule (current moment \u2212 heartbeatFreq\u00d7momentSize), instance load, reputation byte, EVR trustline + balance, registration URIToken held, lease offers, machine specs + accumulated EVR reward. Layout verified against canonical evernode-js-client + live mainnet. Read-only; ~9 serial RPC reads (slow but thorough).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "host r-address",
    "minLength": 25,
    "type": "string"
   },
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "evernode_host_diagnostics",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "type": "string"
   },
   "balances": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "checks": {
    "items": {},
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "heartbeat": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "isRegisteredHost": {
    "type": "boolean"
   },
   "leases": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "network": {
    "type": "string"
   },
   "notes": {
    "items": {},
    "type": "array"
   },
   "registration": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "specs": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "summary": {
    "type": "string"
   },
   "warnings": {
    "items": {},
    "type": "array"
   }
  },
  "type": "object"
 }
}
