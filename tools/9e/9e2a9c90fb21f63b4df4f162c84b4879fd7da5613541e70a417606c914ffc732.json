{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Screen open markets by league, group, volume, price, spread, time to close and 24-hour move, sorted server-side (default by volume). Rows carry spread_cents and a signed move_cents; call get_market before trading. Set full=true for every upstream field.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "closes_within_min": {
    "description": "Closes within this many minutes.",
    "maximum": 525600,
    "minimum": 1,
    "type": "integer"
   },
   "full": {
    "type": "boolean"
   },
   "group": {
    "description": "Sports, Politics, Economy, Crypto, Entertainment or Other.",
    "type": "string"
   },
   "league": {
    "description": "A league such as NFL or WNBA.",
    "type": "string"
   },
   "limit": {
    "description": "Default 20, max 50.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "max_spread_cents": {
    "description": "Yes ask minus yes bid at most this.",
    "maximum": 99,
    "minimum": 0,
    "type": "integer"
   },
   "min_move_cents": {
    "description": "Moved at least this much in about 24 hours, either way.",
    "maximum": 99,
    "minimum": 1,
    "type": "integer"
   },
   "min_volume": {
    "description": "At least this many contracts traded.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "price_max_cents": {
    "description": "Yes price at most this.",
    "maximum": 99,
    "minimum": 1,
    "type": "integer"
   },
   "price_min_cents": {
    "description": "Yes price at least this.",
    "maximum": 99,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "Default volume.",
    "enum": [
     "volume",
     "close_time",
     "move",
     "spread"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "screen_markets",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "markets": {
    "items": {},
    "type": "array"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "count",
   "truncated",
   "markets"
  ],
  "type": "object"
 },
 "title": "Screen markets"
}
