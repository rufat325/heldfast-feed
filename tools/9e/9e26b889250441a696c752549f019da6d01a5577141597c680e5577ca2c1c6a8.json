{
 "description": "Register an ephemeral agent with a did:key identity. Short-lived agents that auto-expire. Returns agent_id, did:key, and keypair.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "capabilities": {
    "description": "List of agent capabilities (e.g. ['search', 'write'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "scopes": {
    "description": "Permission scopes to grant (e.g. ['agent:read', 'agent:execute'])",
    "items": {
     "enum": [
      "agent:read",
      "agent:write",
      "agent:execute",
      "agent:transact",
      "agent:communicate",
      "agent:delegate",
      "agent:elevate"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "ttl_seconds": {
    "description": "Time-to-live in seconds before the agent auto-expires",
    "type": "number"
   }
  },
  "required": [
   "capabilities",
   "scopes"
  ],
  "type": "object"
 },
 "name": "vorim_register_ephemeral"
}
