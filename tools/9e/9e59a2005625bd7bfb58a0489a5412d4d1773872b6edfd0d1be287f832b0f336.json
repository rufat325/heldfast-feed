{
 "description": "The final step: combines failures, flakiness history, and code change correlation to produce a GO / NO_GO / INVESTIGATE verdict with confidence score and a breakdown of blockers vs safe-to-ignore failures.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "affectedTests": {
    "description": "Tests known to be affected by code changes (from ast-impact-mapper-mcp)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "changedFiles": {
    "description": "Files changed in this commit/PR",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "customInfraPatterns": {
    "description": "Extra regex patterns (as strings) to classify as infrastructure errors, e.g. 'GCP quota exceeded', 'No space left on device'",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "failures": {
    "description": "All failures from the CI run",
    "items": {
     "properties": {
      "duration": {
       "type": "number"
      },
      "errorMessage": {
       "type": "string"
      },
      "filePath": {
       "type": "string"
      },
      "suiteName": {
       "type": "string"
      },
      "testName": {
       "type": "string"
      }
     },
     "required": [
      "testName",
      "suiteName",
      "errorMessage"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "flakinessHistory": {
    "description": "Flakiness history for cross-referencing",
    "items": {
     "properties": {
      "flakyProbability": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "recentFailures": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "suiteName": {
       "type": "string"
      },
      "testName": {
       "type": "string"
      },
      "totalRuns": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "testName",
      "suiteName",
      "flakyProbability",
      "recentFailures",
      "totalRuns"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "format": {
    "description": "Output format. Use 'markdown' for GitHub PR comments or Slack. Defaults to 'text'.",
    "enum": [
     "text",
     "markdown"
    ],
    "type": "string"
   }
  },
  "required": [
   "failures",
   "flakinessHistory",
   "changedFiles"
  ],
  "type": "object"
 },
 "name": "generate_release_recommendation"
}
