{
 "description": "Create a new product in the VTEX catalog",
 "inputSchema": {
  "properties": {
   "BrandId": {
    "description": "Brand ID",
    "type": "number"
   },
   "CategoryId": {
    "description": "Category ID",
    "type": "number"
   },
   "Description": {
    "description": "Product description (HTML supported)",
    "type": "string"
   },
   "DescriptionShort": {
    "description": "Short description",
    "type": "string"
   },
   "IsActive": {
    "description": "Active status (default true)",
    "type": "boolean"
   },
   "IsVisible": {
    "description": "Product visibility (default true)",
    "type": "boolean"
   },
   "LinkId": {
    "description": "URL slug",
    "type": "string"
   },
   "Name": {
    "description": "Product name",
    "type": "string"
   },
   "RefId": {
    "description": "Reference ID (internal code)",
    "type": "string"
   },
   "Title": {
    "description": "Page title (SEO)",
    "type": "string"
   }
  },
  "required": [
   "Name",
   "CategoryId",
   "BrandId"
  ],
  "type": "object"
 },
 "name": "create_product"
}
