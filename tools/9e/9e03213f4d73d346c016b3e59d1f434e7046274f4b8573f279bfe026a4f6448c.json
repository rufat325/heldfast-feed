{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Generate Design Tokens"
 },
 "description": "Turn a design-token spec (semantic colors + optional spacing/radius/type scales) into REAL, ready-to-use artifact files: CSS custom properties, Tailwind v4 @theme, SwiftUI, Jetpack Compose, and W3C DTCG JSON. Deterministic \u2014 outputs code, not advice. Use it to give a project one source of truth across web, iOS and Android. Pair with audit_accessibility to verify the palette's contrast.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "colors": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Semantic color roles \u2192 hex. e.g. {\"primary\":\"#4F46E5\",\"onPrimary\":\"#FFFFFF\",\"surface\":\"#0A0A0B\",\"textPrimary\":\"#F5F5F5\",\"danger\":\"#EF4444\"}",
    "type": "object"
   },
   "fontFamilies": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "font role\u2192stack (default sans/mono)",
    "type": "object"
   },
   "fontSizes": {
    "additionalProperties": {
     "type": "number"
    },
    "description": "type scale name\u2192px (default xs..4xl)",
    "type": "object"
   },
   "format": {
    "description": "Output format (default 'all')",
    "enum": [
     "css",
     "tailwind",
     "swiftui",
     "compose",
     "dtcg",
     "all"
    ],
    "type": "string"
   },
   "name": {
    "description": "Token set / brand name (default 'Brand')",
    "type": "string"
   },
   "radii": {
    "additionalProperties": {
     "type": "number"
    },
    "description": "radius name\u2192px (default sm/md/lg/xl/full; use 9999 for pill)",
    "type": "object"
   },
   "spacing": {
    "description": "px spacing scale (default 8pt scale 2..96)",
    "items": {
     "type": "number"
    },
    "type": "array"
   }
  },
  "required": [
   "colors"
  ],
  "type": "object"
 },
 "name": "generate_design_tokens",
 "title": "Generate Design Tokens"
}
