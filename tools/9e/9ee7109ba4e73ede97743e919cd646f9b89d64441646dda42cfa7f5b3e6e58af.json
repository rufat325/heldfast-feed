{
 "description": "Record a review verdict \u2014 `approve` or `reject` \u2014 on one revision of a design, with an optional note. Kept beside the design, like comments: it never moves the revision. Recorded as an agent's decision, so a person waiting with ui_builder_await_decision's default `from: \"human\"` is not answered by it. Pass your own `decisionId` to make a retry idempotent.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agentModel": {
    "description": "Optional current model name shown to design viewers; self-reported. Omit when unknown.",
    "maxLength": 80,
    "type": "string"
   },
   "agentName": {
    "description": "Optional agent/client name shown to design viewers; self-reported.",
    "maxLength": 80,
    "type": "string"
   },
   "decisionId": {
    "description": "Your id for this decision; makes a retry idempotent.",
    "type": "string"
   },
   "designId": {
    "type": "string"
   },
   "displayName": {
    "type": "string"
   },
   "note": {
    "description": "Why, in a sentence or two.",
    "type": "string"
   },
   "revision": {
    "description": "The revision the verdict is about.",
    "type": "integer"
   },
   "token": {
    "description": "A grant token from poll_access, when you cannot set the X-Compose-Preview-Token header yourself \u2014 an MCP client fixes its headers at connect time, so this is how a token approved during this session is used in it. Prefer the header where you control it.",
    "type": "string"
   },
   "verdict": {
    "enum": [
     "approve",
     "reject"
    ],
    "type": "string"
   }
  },
  "required": [
   "designId",
   "revision",
   "verdict"
  ],
  "type": "object"
 },
 "name": "ui_builder_record_decision",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "approved": {
    "type": "boolean"
   },
   "decisions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "decidedAtEpochMillis": {
       "type": "integer"
      },
      "decidedBy": {
       "type": "string"
      },
      "deciderKind": {
       "type": "string"
      },
      "decisionId": {
       "type": "string"
      },
      "displayName": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "note": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "revision": {
       "type": "integer"
      },
      "sequence": {
       "type": "integer"
      },
      "verdict": {
       "type": "string"
      }
     },
     "required": [
      "decisionId",
      "sequence",
      "revision",
      "verdict",
      "decidedBy",
      "deciderKind",
      "decidedAtEpochMillis"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "designId": {
    "type": "string"
   },
   "latest": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "decidedAtEpochMillis": {
        "type": "integer"
       },
       "decidedBy": {
        "type": "string"
       },
       "deciderKind": {
        "type": "string"
       },
       "decisionId": {
        "type": "string"
       },
       "displayName": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "note": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "revision": {
        "type": "integer"
       },
       "sequence": {
        "type": "integer"
       },
       "verdict": {
        "type": "string"
       }
      },
      "required": [
       "decisionId",
       "sequence",
       "revision",
       "verdict",
       "decidedBy",
       "deciderKind",
       "decidedAtEpochMillis"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "schema": {
    "const": "compose-preview/ui-builder-decision/v1",
    "type": "string"
   },
   "sequence": {
    "type": "integer"
   },
   "summary": {
    "type": "string"
   },
   "timedOut": {
    "type": "boolean"
   }
  },
  "required": [
   "schema",
   "summary",
   "designId",
   "timedOut",
   "sequence",
   "approved"
  ],
  "type": "object"
 }
}
