{
 "description": "Block until the first SMS/OTP code arrives on a rental, or time out. The one-step way to rent a number and get the code in an automated flow.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "intervalMs": {
    "default": 3000,
    "description": "Poll interval, in ms.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "rentalId": {
    "description": "The rentalId returned by rent_number.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "timeoutMs": {
    "default": 120000,
    "description": "Max time to wait, in ms.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "rentalId"
  ],
  "type": "object"
 },
 "name": "wait_for_sms",
 "title": "Wait for SMS"
}
