{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "visibility": [
    "app"
   ]
  },
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Save the person\u2019s edits"
 },
 "description": "Commits the editor's source edits from its acknowledged revision, rebasing over concurrent changes while preserving both authors' insertions.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "commitId": {
    "maxLength": 128,
    "type": "string"
   },
   "docKind": {
    "description": "markdown, text or code; the filename decides when absent.",
    "enum": [
     "markdown",
     "text",
     "code"
    ],
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "editorKey": {
    "description": "The editor key from private tool-result _meta.rapier, held by the host and editor alone.",
    "maxLength": 512,
    "type": "string"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "filename": {
    "maxLength": 256,
    "type": "string"
   },
   "splices": {
    "description": "Exact sequential local journal from the acknowledged source to text; at most the retained 500 records of 64 splices.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "inserted": {
       "maxLength": 26214400,
       "type": "string"
      },
      "pos": {
       "maximum": 26214400,
       "minimum": 0,
       "type": "integer"
      },
      "removed": {
       "maxLength": 26214400,
       "type": "string"
      }
     },
     "required": [
      "pos",
      "removed",
      "inserted"
     ],
     "type": "object"
    },
    "maxItems": 32000,
    "type": "array"
   },
   "text": {
    "maxLength": 26214400,
    "type": "string"
   }
  },
  "required": [
   "document",
   "editorKey",
   "expectedRevision",
   "text",
   "commitId"
  ],
  "type": "object"
 },
 "name": "document.commit",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "outcome": {
    "enum": [
     "committed",
     "refused",
     "uncertain"
    ],
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Save the person\u2019s edits"
}
