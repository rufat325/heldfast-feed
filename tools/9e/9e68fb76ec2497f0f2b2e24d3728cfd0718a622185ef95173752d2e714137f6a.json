{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List Datadog Agents in the fleet with filtering, sorting, and pagination",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filter": {
    "description": "Filter string using Datadog query syntax",
    "type": "string"
   },
   "pageNumber": {
    "default": 0,
    "description": "Page number (0-based)",
    "type": "number"
   },
   "pageSize": {
    "default": 50,
    "description": "Number of results per page (max 100)",
    "type": "number"
   },
   "sortAttribute": {
    "description": "Attribute to sort by",
    "type": "string"
   },
   "sortDescending": {
    "description": "Sort descending if true",
    "type": "boolean"
   },
   "tags": {
    "description": "Comma-separated list of tags to filter agents",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list-fleet-agents"
}
