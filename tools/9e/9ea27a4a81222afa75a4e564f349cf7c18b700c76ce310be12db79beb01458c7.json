{
 "description": "Find points of interest near a location in India \u2014 hospitals, ATMs, restaurants, petrol pumps, schools, etc.",
 "inputSchema": {
  "properties": {
   "keywords": {
    "description": "Category or keyword (e.g. 'hospital', 'atm', 'restaurant', 'petrol pump')",
    "type": "string"
   },
   "lat": {
    "description": "Reference latitude",
    "type": "number"
   },
   "lng": {
    "description": "Reference longitude",
    "type": "number"
   },
   "radius": {
    "description": "Search radius in metres (default 1000, max 10000)",
    "type": "number"
   },
   "sortBy": {
    "description": "Sort order \u2014 dist:asc (nearest first), imp (most prominent first)",
    "enum": [
     "dist:asc",
     "dist:desc",
     "imp"
    ],
    "type": "string"
   }
  },
  "required": [
   "keywords",
   "lat",
   "lng"
  ],
  "type": "object"
 },
 "name": "nearby_search"
}
