{
 "description": "Export multiple nodes from a Figma file in a specified format",
 "inputSchema": {
  "properties": {
   "fileKey": {
    "description": "Figma file key",
    "type": "string"
   },
   "format": {
    "default": "PNG",
    "description": "Export format",
    "enum": [
     "PNG",
     "SVG",
     "PDF",
     "JPG"
    ],
    "type": "string"
   },
   "nodeIds": {
    "description": "Array of node IDs to export",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "scale": {
    "default": 1,
    "description": "Scale factor",
    "type": "number"
   }
  },
  "required": [
   "fileKey",
   "nodeIds"
  ],
  "type": "object"
 },
 "name": "export_multiple_nodes"
}
