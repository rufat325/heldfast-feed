{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Read a JSON locale file from disk, translate it into one or more languages, and write <lang>.json files. Set incremental=true to reuse existing output files and only translate new/missing keys.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Source language code (default: en)",
    "type": "string"
   },
   "incremental": {
    "description": "Reuse existing <lang>.json and only translate new keys",
    "type": "boolean"
   },
   "model": {
    "type": "string"
   },
   "outDir": {
    "description": "Output directory (default: same directory as the source file)",
    "type": "string"
   },
   "path": {
    "description": "Path to the source locale JSON file, e.g. locales/en.json",
    "type": "string"
   },
   "provider": {
    "enum": [
     "anthropic",
     "openai"
    ],
    "type": "string"
   },
   "to": {
    "description": "Target language code(s), comma-separated, e.g. \"es,fr,de\"",
    "type": "string"
   }
  },
  "required": [
   "path",
   "to"
  ],
  "type": "object"
 },
 "name": "translate_file",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "mode": {
    "type": "string"
   },
   "warnings": {
    "type": "array"
   },
   "written": {}
  },
  "required": [
   "warnings",
   "mode"
  ],
  "type": "object"
 },
 "title": "Translate File"
}
