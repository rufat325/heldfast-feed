{
 "_meta": {
  "openai/outputTemplate": "ui://wapiworld/project-instances-overview-v1.html",
  "openai/toolInvocation/invoked": "Wapiworld project overview ready.",
  "openai/toolInvocation/invoking": "Loading Wapiworld project\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "wapiworld:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://wapiworld/project-instances-overview-v1.html"
  },
  "ui/resourceUri": "ui://wapiworld/project-instances-overview-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show Wapiworld project overview"
 },
 "description": "Use this when someone wants a quick overview or dashboard of one Wapiworld project's WhatsApp numbers. Returns an overview card with the project name, how many instances are ready, pairing, starting, offline or unknown (counting up to 100), and up to 20 instances with phone and status. Not for sending a message.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "projectId": {
    "description": "Project id",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "show_project_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "instanceCount": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "instanceCountIsLowerBound": {
    "type": "boolean"
   },
   "instances": {
    "description": "Up to 20 instances. QR pairing codes, instance credentials, API keys, proxy data and arbitrary stored fields are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "health": {
       "enum": [
        "ready",
        "pairing",
        "starting",
        "offline",
        "unknown"
       ],
       "type": "string"
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "maxLength": 200,
       "type": "string"
      },
      "phone": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "anyOf": [
        {
         "enum": [
          "starting",
          "qrcode",
          "ready",
          "logged_out",
          "not_connected",
          "disconnected",
          "offline",
          "STARTING",
          "QRCODE",
          "READY"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "status",
      "health",
      "phone",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "project": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "pattern": "^[0-9a-f]{24}$",
        "type": "string"
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "required": [
       "id",
       "name"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "statusCounts": {
    "additionalProperties": false,
    "properties": {
     "offline": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "pairing": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "ready": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "starting": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "unknown": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "ready",
     "pairing",
     "starting",
     "offline",
     "unknown"
    ],
    "type": "object"
   },
   "statusCountsAreLowerBounds": {
    "type": "boolean"
   }
  },
  "required": [
   "project",
   "instanceCount",
   "instanceCountIsLowerBound",
   "statusCounts",
   "statusCountsAreLowerBounds",
   "instances"
  ],
  "type": "object"
 },
 "title": "Show Wapiworld project overview"
}
