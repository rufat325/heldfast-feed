{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Move a note to another folder or path. Links are preserved.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dryRun": {
    "default": false,
    "description": "Preview the change without applying it: returns the planned action and the exact CLI command.",
    "type": "boolean"
   },
   "from": {
    "description": "Vault-relative path of the note to move.",
    "minLength": 1,
    "type": "string"
   },
   "to": {
    "description": "Destination folder or vault-relative path.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "note_move",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Optional tool-specific structured result data."
   },
   "text": {
    "description": "Human-readable result text.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "title": "Move note"
}
