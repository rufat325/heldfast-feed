    "maximum": 4,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_allowed_external_domains",
