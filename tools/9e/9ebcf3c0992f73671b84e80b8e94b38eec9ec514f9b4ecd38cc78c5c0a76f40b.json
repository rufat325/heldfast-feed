{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Designers and design engineers in the catalogue, featured first, then by name, with optional technology and role filters and cursor paging. Use search_people to find someone by name or focus. Example: {\"role\": \"design engineer\", \"technology\": \"nextjs\", \"limit\": 20}",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "description": "next_cursor from the previous call, with the same query and filters. Omit for the first page.",
    "maxLength": 2000,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Results per page (1 to 50, default 20).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "role": {
    "description": "Words in their role, e.g. \"design engineer\" or \"product designer\".",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "technology": {
    "description": "Only people whose site is built with this technology, e.g. \"nextjs\", \"astro\", \"framer\".",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_people",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "avatar_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "bio": {
       "type": [
        "string",
        "null"
       ]
      },
      "image_url": {
       "description": "Their site's OG image, else their avatar: the stored image file, served directly.",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "resource_count": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "role": {
       "type": [
        "string",
        "null"
       ]
      },
      "site_url": {
       "description": "Their site's own address, untagged.",
       "type": [
        "string",
        "null"
       ]
      },
      "slug": {
       "type": "string"
      },
      "tangent_url": {
       "description": "Their profile on Tangent.",
       "type": "string"
      },
      "thumbnail_url": {
       "description": "The same URL as image_url (people's images have no smaller stored copy).",
       "type": [
        "string",
        "null"
       ]
      },
      "website": {
       "description": "Visit link for their site (tagged utm_source=tangent-mcp).",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "slug",
      "name",
      "role",
      "bio",
      "website",
      "site_url",
      "tangent_url",
      "image_url",
      "thumbnail_url",
      "avatar_url",
      "resource_count"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "next_cursor"
  ],
  "type": "object"
 },
 "title": "List people"
}
