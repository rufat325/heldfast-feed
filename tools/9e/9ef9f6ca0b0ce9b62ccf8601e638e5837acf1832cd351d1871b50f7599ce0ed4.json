{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Preview or apply a filtered bulk archive/delete operation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "all": {
    "default": false,
    "type": "boolean"
   },
   "confirm": {
    "default": false,
    "type": "boolean"
   },
   "dry_run": {
    "default": true,
    "type": "boolean"
   },
   "mode": {
    "default": "archive",
    "enum": [
     "archive",
     "delete"
    ],
    "type": "string"
   },
   "reason": {
    "maxLength": 1000,
    "type": "string"
   },
   "scope": {
    "maxLength": 256,
    "pattern": "^(user|project|agent|team):[A-Za-z0-9._~:/-]+$",
    "type": "string"
   },
   "tags": {
    "default": [],
    "items": {
     "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "memory.forget_many"
}
