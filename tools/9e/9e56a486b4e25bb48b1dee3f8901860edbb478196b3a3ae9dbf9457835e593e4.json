{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Hospital-specific pricing tool for source-labeled Loa runtime data. Returns source-labeled Published MRF prices and Loa Verified Provider Price overlays for CPT codes. cash_price is the cash/self-pay price, list_price is the gross charge before discounts (most patients pay less), and insurance_prices are payer-negotiated rates for the named plan, not out-of-pocket costs. Any of these can be null when the hospital did not publish that price. Use this when comparing named hospitals or checking a quoted hospital price against available source rows.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cpt_codes": {
    "description": "CPT procedure codes to look up pricing for",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "hospital_ids": {
    "description": "Hospital IDs from search_hospitals results",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "hospital_ids",
   "cpt_codes"
  ],
  "type": "object"
 },
 "name": "get_hospital_pricing",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hospitals_found": {
    "type": "number"
   },
   "pricing": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cash_price": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "cash_source_labels": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "cpt_code": {
       "type": "string"
      },
      "cpt_description": {
       "type": "string"
      },
      "hospital_id": {
       "type": "string"
      },
      "hospital_location": {
       "type": "string"
      },
      "hospital_name": {
       "type": "string"
      },
      "insurance_prices": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "payer": {
          "type": "string"
         },
         "plan": {
          "type": "string"
         },
         "price": {
          "type": "number"
         },
         "source_label": {
          "type": "string"
         }
        },
        "required": [
         "payer",
         "plan",
         "price",
         "source_label"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "list_price": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "loa_link": {
       "anyOf": [
        {
         "additionalProperties": false,
         "description": "Tracked Loa link. Share it when the user wants to book, contact, or learn more about this provider or hospital.",
         "properties": {
          "action": {
           "enum": [
            "book",
            "website",
            "profile"
           ],
           "type": "string"
          },
          "label": {
           "type": "string"
          },
          "url": {
           "format": "uri",
           "type": "string"
          }
         },
         "required": [
          "url",
          "action",
          "label"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "record_count": {
       "type": "number"
      },
      "source_labels": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "hospital_id",
      "hospital_name",
      "hospital_location",
      "cpt_code",
      "cpt_description",
      "cash_price",
      "cash_source_labels",
      "list_price",
      "insurance_prices",
      "source_labels",
      "record_count",
      "loa_link"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "authority": {
      "enum": [
       "authoritative",
       "advisory",
       "estimate"
      ],
      "type": "string"
     },
     "basis": {
      "type": "string"
     },
     "methodology_url": {
      "format": "uri",
      "type": "string"
     },
     "source_scope": {
      "type": "string"
     },
     "source_url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "authority",
     "basis",
     "methodology_url"
    ],
    "type": "object"
   },
   "services_found": {
    "type": "number"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "pricing",
   "total",
   "hospitals_found",
   "services_found",
   "provenance"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "openid",
    "email",
    "profile"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Hospital Pricing"
}
