 "description": "GetGeneralLedger pages through one account's posted lines with opening, running, and closing balances \u2014 the account register. Read-only.",
 "inputSchema": {
  "properties": {
   "basis": {
    "enum": [
     "REPORT_BASIS_UNSPECIFIED",
     "REPORT_BASIS_ACCRUAL",
     "REPORT_BASIS_CASH"
    ],
    "type": "string"
   },
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "currencyCode": {
    "maxLength": 3,
    "pattern": "^([A-Z]{3})?$",
    "type": "string"
   },
   "endDate": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "glAccountId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "pageSize": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "pageToken": {
    "maxLength": 500,
    "type": "string"
   },
   "startDate": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "vendor": {
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "companyId",
   "glAccountId"
  ],
  "type": "object"
 },
 "name": "accounting_get_general_ledger",
 "outputSchema": {
  "properties": {
   "closingBalance": {
    "type": "string"
   },
   "currencyCode": {
    "type": "string"
   },
   "nextPageToken": {
    "type": "string"
   },
   "openingBalance": {
    "type": "string"
   },
   "rows": {
    "items": {
     "properties": {
      "amount": {
       "type": "string"
      },
      "entryDate": {
       "type": "string"
      },
      "journalEntryId": {
       "anyOf": [
        {
         "description": "UUID value wrapper.",
         "properties": {
          "value": {
           "format": "uuid",
           "type": "string"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "memo": {
       "type": "string"
      },
      "runningBalance": {
       "type": "string"
      },
      "side": {
       "type": "string"
      },
      "transactionId": {
       "anyOf": [
        {
         "description": "UUID value wrapper.",
         "properties": {
          "value": {
           "format": "uuid",
           "type": "string"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "totalCount": {
    "type": "integer"
   }
  },
  "type": "object"
 },
 "title": "Get General Ledger"
}
