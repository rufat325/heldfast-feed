{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search California School Accounting Manual (CSAM 2024) by keywords and topic, procedure number or a returned chunk_id. Use chunk_id with direction=previous or next and limit (1\u201310) to read adjacent source chunks within the same procedure; navigation.continuation supplies the next request. Results include extracted text plus Markdown with conservative code-definition/journal tables, topic path, procedure revision, printed/PDF page and a CDE PDF citation. All non-stopword keywords must match; topic filters heading words. Use short accounting terms rather than a long question. Read citations for surrounding tables/context; later correspondence is excluded. No login or model-provider key required.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "chunk_id": {
    "anyOf": [
     {
      "pattern": "^csam:20\\d{2}:[a-f0-9]{24}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Chunk Id"
   },
   "client_id": {
    "anyOf": [
     {
      "pattern": "^sacs_client_[0-9a-f]{32}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Client Id"
   },
   "direction": {
    "default": "current",
    "enum": [
     "current",
     "previous",
     "next"
    ],
    "title": "Direction",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 500,
    "minimum": 0,
    "title": "Offset",
    "type": "integer"
   },
   "procedure": {
    "anyOf": [
     {
      "pattern": "^\\d{3}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Procedure"
   },
   "query": {
    "default": "",
    "maxLength": 160,
    "title": "Query",
    "type": "string"
   },
   "topic": {
    "anyOf": [
     {
      "maxLength": 100,
      "minLength": 2,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Topic"
   }
  },
  "title": "sacs_search_csamArguments",
  "type": "object"
 },
 "name": "sacs_search_csam",
 "outputSchema": {
  "$defs": {
   "PublicError": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "invalid_request",
       "not_found",
       "private_scope_denied",
       "dataset_mismatch",
       "payload_rejected",
       "backend_unavailable"
      ],
      "title": "Code",
      "type": "string"
     },
     "message": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Message",
      "type": "string"
     },
     "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "title": "PublicError",
    "type": "object"
   },
   "SourceProvenance": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Description",
      "type": "string"
     },
     "record_ref": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Record Ref",
      "type": "string"
     },
     "source": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Source",
      "type": "string"
     }
    },
    "required": [
     "source",
     "record_ref",
     "description"
    ],
    "title": "SourceProvenance",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "contract_version": {
    "const": "sacs.mcp.v1",
    "default": "sacs.mcp.v1",
    "title": "Contract Version",
    "type": "string"
   },
   "data": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Data"
   },
   "data_version": {
    "maxLength": 256,
    "minLength": 1,
    "title": "Data Version",
    "type": "string"
   },
   "error": {
    "anyOf": [
     {
      "$ref": "#/$defs/PublicError"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "title": "Limitations",
    "type": "array"
   },
   "ok": {
    "title": "Ok",
    "type": "boolean"
   },
   "request_id": {
    "maxLength": 128,
    "minLength": 8,
    "title": "Request Id",
    "type": "string"
   },
   "source_provenance": {
    "items": {
     "$ref": "#/$defs/SourceProvenance"
    },
    "title": "Source Provenance",
    "type": "array"
   }
  },
  "required": [
   "data_version",
   "request_id",
   "ok"
  ],
  "title": "PublicToolResponse",
  "type": "object"
 }
}
