{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create knowledge-card drafts"
 },
 "description": "Create pending, user-owned general-knowledge card drafts only after clear affirmative consent to specifically named, independently teachable knowledge in the current conversation. Every card must declare knowledge_scope as general_knowledge. Personal or company decisions, product principles or policies, pricing rationale, preferences, plans, tasks, reminders, meeting outcomes, project status, and autobiographical facts are ineligible. An assistant suggestion alone is not consent. This tool never accepts raw transcripts or historical-conversation data, and it cannot approve, publish, or modify public knowledge cards.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cards": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "client_card_id": {
       "maxLength": 160,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9._:-]+$",
       "type": "string"
      },
      "evidence_selectors": {
       "items": {
        "oneOf": [
         {
          "additionalProperties": false,
          "properties": {
           "message_ref": {
            "maxLength": 240,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
           },
           "polarity": {
            "default": "supports",
            "enum": [
             "supports",
             "contradicts"
            ],
            "type": "string"
           },
           "quality": {
            "default": "unknown",
            "enum": [
             "unknown",
             "low",
             "medium",
             "high"
            ],
            "type": "string"
           },
           "relation_origin": {
            "default": "model_inferred",
            "enum": [
             "explicit_user",
             "extracted_from_source",
             "model_inferred"
            ],
            "type": "string"
           },
           "selector_type": {
            "const": "message",
            "type": "string"
           }
          },
          "required": [
           "selector_type",
           "message_ref"
          ],
          "type": "object"
         },
         {
          "additionalProperties": false,
          "properties": {
           "polarity": {
            "default": "supports",
            "enum": [
             "supports",
             "contradicts"
            ],
            "type": "string"
           },
           "quality": {
            "default": "unknown",
            "enum": [
             "unknown",
             "low",
             "medium",
             "high"
            ],
            "type": "string"
           },
           "relation_origin": {
            "default": "model_inferred",
            "enum": [
             "explicit_user",
             "extracted_from_source",
             "model_inferred"
            ],
            "type": "string"
           },
           "selector_type": {
            "const": "external_ref",
            "type": "string"
           },
           "source_ref": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "selector_type",
           "source_ref"
          ],
          "type": "object"
         },
         {
          "additionalProperties": false,
          "properties": {
           "end": {
            "maximum": 10000000,
            "minimum": 1,
            "type": "integer"
           },
           "polarity": {
            "default": "supports",
            "enum": [
             "supports",
             "contradicts"
            ],
            "type": "string"
           },
           "quality": {
            "default": "unknown",
            "enum": [
             "unknown",
             "low",
             "medium",
             "high"
            ],
            "type": "string"
           },
           "relation_origin": {
            "default": "model_inferred",
            "enum": [
             "explicit_user",
             "extracted_from_source",
             "model_inferred"
            ],
            "type": "string"
           },
           "selector_type": {
            "const": "text_position",
            "type": "string"
           },
           "start": {
            "maximum": 9999999,
            "minimum": 0,
            "type": "integer"
           }
          },
          "required": [
           "selector_type",
           "start",
           "end"
          ],
          "type": "object"
         },
         {
          "additionalProperties": false,
          "properties": {
           "line_end": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer"
           },
           "line_start": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer"
           },
           "polarity": {
            "default": "supports",
            "enum": [
             "supports",
             "contradicts"
            ],
            "type": "string"
           },
           "quality": {
            "default": "unknown",
            "enum": [
             "unknown",
             "low",
             "medium",
             "high"
            ],
            "type": "string"
           },
           "relation_origin": {
            "default": "model_inferred",
            "enum": [
             "explicit_user",
             "extracted_from_source",
             "model_inferred"
            ],
            "type": "string"
           },
           "selector_type": {
            "const": "line_range",
            "type": "string"
           }
          },
          "required": [
           "selector_type",
           "line_start",
           "line_end"
          ],
          "type": "object"
         }
        ]
       },
       "maxItems": 24,
       "type": "array"
      },
      "explanation": {
       "maxLength": 6000,
       "minLength": 1,
       "type": "string"
      },
      "knowledge_scope": {
       "const": "general_knowledge",
       "description": "Required assertion that this card teaches reusable knowledge independent of a person, company, product, preference, plan, task, or decision.",
       "type": "string"
      },
      "relations": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "direction": {
          "enum": [
           "outgoing",
           "incoming"
          ],
          "type": "string"
         },
         "evidence_selector_indexes": {
          "items": {
           "maximum": 23,
           "minimum": 0,
           "type": "integer"
          },
          "maxItems": 24,
          "type": "array"
         },
         "target_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
         },
         "target_kind": {
          "description": "Minimal-core drafts may relate only to the owner's private knowledge or another draft; public graph targets are unavailable.",
          "enum": [
           "private",
           "draft"
          ],
          "type": "string"
         },
         "type": {
          "enum": [
           "related",
           "prerequisite",
           "generalizes",
           "derived_from",
           "equivalent_to",
           "supersedes",
           "answers",
           "supports",
           "contradicts",
           "causes",
           "contributes_to",
           "enables",
           "inhibits"
          ],
          "type": "string"
         },
         "weight": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "type": "number"
         }
        },
        "required": [
         "target_kind",
         "target_id",
         "type"
        ],
        "type": "object"
       },
       "maxItems": 12,
       "type": "array"
      },
      "summary": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "tags": {
       "items": {
        "maxLength": 48,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 12,
       "type": "array"
      },
      "title": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "topic": {
       "maxLength": 48,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "knowledge_scope",
      "title"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "conversation_ref": {
      "maxLength": 240,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
     },
     "discussed_at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     "source_url": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     },
     "type": {
      "const": "current_conversation",
      "type": "string"
     }
    },
    "required": [
     "type",
     "conversation_ref"
    ],
    "type": "object"
   },
   "provider": {
    "enum": [
     "chatgpt",
     "claude",
     "gemini",
     "other"
    ],
    "type": "string"
   },
   "request_id": {
    "maxLength": 160,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   }
  },
  "required": [
   "provider",
   "request_id",
   "provenance",
   "cards"
  ],
  "type": "object"
 },
 "name": "create_card_drafts",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "batch_id": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "created": {
    "type": "boolean"
   },
   "draft_count": {
    "maximum": 50,
    "minimum": 0,
    "type": "integer"
   },
   "review_flags": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "client_id": {
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      },
      "code": {
       "enum": [
        "possible_autobiographical",
        "possible_organization_specific",
        "possible_choice_rationale",
        "possible_task_or_meeting",
        "possible_project_status"
       ],
       "type": "string"
      },
      "field": {
       "maxLength": 240,
       "type": "string"
      },
      "match": {
       "maxLength": 80,
       "type": "string"
      },
      "message": {
       "maxLength": 240,
       "type": "string"
      }
     },
     "required": [
      "client_id",
      "code",
      "field",
      "match",
      "message"
     ],
     "type": "object"
    },
    "maxItems": 600,
    "type": "array"
   },
   "review_path": {
    "maxLength": 512,
    "pattern": "^\\/.*",
    "type": "string"
   },
   "review_url": {
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   },
   "status": {
    "const": "pending",
    "type": "string"
   }
  },
  "required": [
   "status",
   "batch_id",
   "created",
   "draft_count",
   "review_path",
   "review_url",
   "review_flags"
  ],
  "type": "object"
 },
 "title": "Create knowledge-card drafts"
}
