{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Run one of myplate.food's quick body-composition & fitness calculators and get its value plus the healthy band. Pick `metric` and pass that metric's fields:\n\u2022 waist-to-height \u2014 waist, height\n\u2022 waist-to-hip \u2014 waist, hip, sex\n\u2022 lean-body-mass \u2014 weight, height, sex\n\u2022 ffmi \u2014 weight, height, body_fat, sex\n\u2022 water-intake \u2014 weight (+ optional activity: sedentary|moderate|active)\n\u2022 weight-loss-percentage \u2014 start_weight, current_weight\n\u2022 one-rep-max \u2014 weight, reps\nLengths and weights follow `unit` (metric = cm/kg, imperial = in/lb; default metric).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activity": {
    "description": "Activity (for water-intake).",
    "enum": [
     "sedentary",
     "moderate",
     "active"
    ],
    "type": "string"
   },
   "body_fat": {
    "description": "Body-fat % (for ffmi).",
    "maximum": 70,
    "minimum": 0,
    "type": "number"
   },
   "current_weight": {
    "description": "Current weight (for weight-loss-percentage).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "height": {
    "description": "Height (cm or in).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "hip": {
    "description": "Hip (cm or in).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "metric": {
    "description": "Which calculator to run.",
    "enum": [
     "waist-to-height",
     "waist-to-hip",
     "lean-body-mass",
     "ffmi",
     "water-intake",
     "weight-loss-percentage",
     "one-rep-max"
    ],
    "type": "string"
   },
   "reps": {
    "description": "Reps performed (for one-rep-max).",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "sex": {
    "description": "Required for waist-to-hip, lean-body-mass, ffmi.",
    "enum": [
     "male",
     "female"
    ],
    "type": "string"
   },
   "start_weight": {
    "description": "Starting weight (for weight-loss-percentage).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "unit": {
    "description": "Units for inputs/output. Default metric (cm/kg).",
    "enum": [
     "metric",
     "imperial"
    ],
    "type": "string"
   },
   "waist": {
    "description": "Waist (cm or in per unit).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "weight": {
    "description": "Weight (kg or lb).",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "metric"
  ],
  "type": "object"
 },
 "name": "calculate_body_metric",
 "title": "Calculate a body / fitness metric"
}
