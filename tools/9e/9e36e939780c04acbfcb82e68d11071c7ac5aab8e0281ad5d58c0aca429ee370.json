{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Agent tool-call test builder"
 },
 "description": "Build 1-20 tool invocation checks for an authorized staging agent. Returns tool-tests.json; does not execute tests. One-time application dispatcher capture is required. Run with the free PromptBrake Action; no license is needed. Checks observed calls and typed arguments, not backend effects or independent permission enforcement.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "tests": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "description": "Unique stable ASCII test ID.",
       "maxLength": 80,
       "type": "string"
      },
      "name": {
       "description": "Nonempty ASCII name starting with a letter or number; then letters, numbers, spaces, . _ -. Unique ignoring case.",
       "maxLength": 80,
       "type": "string"
      },
      "prompt": {
       "description": "Nonblank message for the user's chatbot; this tool does not send it.",
       "maxLength": 4000,
       "type": "string"
      },
      "rule": {
       "additionalProperties": false,
       "properties": {
        "arguments": {
         "additionalProperties": {},
         "description": "For must_call_with only: 1-10 dotted object paths to typed JSON values.",
         "properties": {},
         "required": [],
         "type": "object"
        },
        "tool": {
         "maxLength": 80,
         "type": "string"
        },
        "type": {
         "enum": [
          "must_not_call",
          "must_call_with"
         ],
         "type": "string"
        }
       },
       "required": [
        "type",
        "tool"
       ],
       "type": "object"
      }
     },
     "required": [
      "id",
      "name",
      "prompt",
      "rule"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "tests"
  ],
  "type": "object"
 },
 "name": "build_agent_tool_tests",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "execution_required": {
    "type": "boolean"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pack_json": {
    "type": "string"
   },
   "setup": {
    "type": "string"
   }
  },
  "required": [
   "pack_json",
   "setup",
   "execution_required",
   "limitations"
  ],
  "type": "object"
 },
 "title": "Agent tool-call test builder"
}
