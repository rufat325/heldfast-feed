{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:settings"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Save push notification settings"
 },
 "description": "Preview, then with confirm:true save a narrow change to push preferences (groups, tier, quiet hours). Read soclo_notifications_preferences first and pass its exact expectedUpdatedAt (null for an absent row) plus a stable UUID clientRequestId. Uses an atomic revision check and preserves other groups and columns. Free. Needs manage:settings. If the outcome is unknown, read the preferences and reconcile before any further write; do not retry automatically.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "changes": {
    "additionalProperties": false,
    "properties": {
     "groups": {
      "additionalProperties": false,
      "properties": {
       "account": {
        "type": "boolean"
       },
       "ads": {
        "type": "boolean"
       },
       "autopilot": {
        "type": "boolean"
       },
       "growth": {
        "type": "boolean"
       },
       "inbox": {
        "type": "boolean"
       },
       "performance": {
        "type": "boolean"
       },
       "publishing": {
        "type": "boolean"
       },
       "reminders": {
        "type": "boolean"
       },
       "sales": {
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "quietEnd": {
      "maximum": 23,
      "minimum": 0,
      "type": "integer"
     },
     "quietStart": {
      "maximum": 23,
      "minimum": 0,
      "type": "integer"
     },
     "tier": {
      "enum": [
       "off",
       "essential",
       "balanced",
       "everything"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "clientRequestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "confirm": {
    "type": "boolean"
   },
   "expectedUpdatedAt": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "clientRequestId",
   "changes"
  ],
  "type": "object"
 },
 "name": "soclo_notifications_save_preferences",
 "title": "Save push notification settings"
}
