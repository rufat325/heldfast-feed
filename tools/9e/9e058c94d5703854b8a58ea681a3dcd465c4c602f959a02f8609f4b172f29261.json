{
 "description": "Record an interaction and update NPC relationship. Automatically adjusts attitude based on impact.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "actingCharacterId": {
    "description": "Character ID of the PC who caused this interaction (tracks per-PC attitudes)",
    "type": "string"
   },
   "addFears": {
    "description": "Add fears",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "addKnows": {
    "description": "Add to what NPC knows",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "addOwes": {
    "description": "Add debts/favors",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "addWants": {
    "description": "Add wants",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "attitudeChange": {
    "description": "Explicit attitude override (optional)",
    "enum": [
     "hostile",
     "unfriendly",
     "neutral",
     "friendly",
     "allied"
    ],
    "type": "string"
   },
   "impact": {
    "description": "How this affected the relationship",
    "enum": [
     "very_negative",
     "negative",
     "neutral",
     "positive",
     "very_positive"
    ],
    "type": "string"
   },
   "interaction": {
    "description": "Description of what happened",
    "type": "string"
   },
   "npcId": {
    "description": "NPC ID",
    "type": "string"
   },
   "removeFears": {
    "description": "Remove fears",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "removeKnows": {
    "description": "Remove from knows",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "removeOwes": {
    "description": "Remove debts",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "removeWants": {
    "description": "Remove wants",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "npcId",
   "interaction",
   "impact"
  ],
  "type": "object"
 },
 "name": "update_relationship"
}
