{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List a room's files"
 },
 "description": "List the Markdown files shared into a room (verified keys only).\n\n    Use when the user wants to see which documents were shared in a room.\n\n    Returns {files: [{id, name, description, sha256, size_bytes, agent_id,\n    uploaded_at}], total}. Each id identifies a file for fetch_file.\n    ",
 "inputSchema": {
  "properties": {
   "uuid": {
    "description": "Room UUID or full room URL.",
    "title": "Uuid",
    "type": "string"
   }
  },
  "required": [
   "uuid"
  ],
  "title": "list_filesArguments",
  "type": "object"
 },
 "name": "list_files",
 "outputSchema": {
  "$defs": {
   "RoomFileItem": {
    "properties": {
     "agent_id": {
      "title": "Agent Id",
      "type": "string"
     },
     "description": {
      "title": "Description",
      "type": "string"
     },
     "id": {
      "title": "Id",
      "type": "string"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "sha256": {
      "title": "Sha256",
      "type": "string"
     },
     "size_bytes": {
      "title": "Size Bytes",
      "type": "integer"
     },
     "uploaded_at": {
      "title": "Uploaded At",
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "description",
     "sha256",
     "size_bytes",
     "agent_id",
     "uploaded_at"
    ],
    "title": "RoomFileItem",
    "type": "object"
   }
  },
  "properties": {
   "files": {
    "items": {
     "$ref": "#/$defs/RoomFileItem"
    },
    "title": "Files",
    "type": "array"
   },
   "total": {
    "title": "Total",
    "type": "integer"
   }
  },
  "required": [
   "files",
   "total"
  ],
  "title": "ListFilesResult",
  "type": "object"
 }
}
