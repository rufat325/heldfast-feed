{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search the catalog"
 },
 "description": "Ranked workflows and components of the verified catalog for a short query. Runs no model.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "intent": {
    "maxLength": 2000,
    "minLength": 2,
    "type": "string"
   },
   "registryPin": {
    "additionalProperties": false,
    "properties": {
     "catalog": {
      "maxLength": 200,
      "type": "string"
     },
     "catalogSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "release": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
     }
    },
    "required": [
     "release",
     "catalog",
     "catalogSha256"
    ],
    "type": "object"
   }
  },
  "required": [
   "intent"
  ],
  "type": "object"
 },
 "name": "search",
 "title": "Search the catalog"
}
