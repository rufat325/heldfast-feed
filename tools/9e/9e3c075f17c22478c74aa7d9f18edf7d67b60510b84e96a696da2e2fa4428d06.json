{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search the Perfume Picks catalog"
 },
 "description": "Full-text search across 13,000+ fragrances in the Perfume Picks database. Filter by brand, fragrance family, gender, and MSRP (USD). Returns note pyramids, accords, and community wear scores with source attribution.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brand": {
    "description": "Brand name filter, e.g. 'Dior'",
    "maxLength": 200,
    "type": "string"
   },
   "fragrance_family": {
    "description": "Family filter, e.g. 'woody', 'amber', 'fresh'",
    "maxLength": 120,
    "type": "string"
   },
   "gender": {
    "description": "Marketed gender category of the fragrance; omit to include all",
    "enum": [
     "masculine",
     "feminine",
     "unisex"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 10, max 10)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "price_max": {
    "description": "Maximum MSRP in USD",
    "minimum": 0,
    "type": "number"
   },
   "price_min": {
    "description": "Minimum MSRP in USD",
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Free-text search: fragrance or brand name",
    "maxLength": 120,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_fragrances"
}
