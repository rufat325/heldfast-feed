{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compute a line-by-line diff between two texts, marking removed lines with \"-\", added with \"+\" and unchanged with two spaces, plus a change count. Use to see exactly what changed instead of comparing by eye. Capped at 1000 lines per side.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "a": {
    "description": "The original (\"before\") text.",
    "maxLength": 100000,
    "minLength": 0,
    "type": "string"
   },
   "b": {
    "description": "The updated (\"after\") text.",
    "maxLength": 100000,
    "minLength": 0,
    "type": "string"
   }
  },
  "required": [
   "a",
   "b"
  ],
  "type": "object"
 },
 "name": "diff",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "added": {
    "type": "number"
   },
   "changed": {
    "type": "boolean"
   },
   "diff": {
    "description": "The line diff (+/-/space prefixed), empty if identical.",
    "type": "string"
   },
   "removed": {
    "type": "number"
   }
  },
  "required": [
   "changed",
   "added",
   "removed",
   "diff"
  ],
  "type": "object"
 },
 "title": "Line diff between two texts"
}
