{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a contact"
 },
 "description": "Edit fields on an existing contact \u2014 only the fields you pass change. Changing status_name moves it along its workflow (automations may fire). Cannot delete or archive. JobNimbus: PUT /contacts/{jnid}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "actor": {
    "description": "Optional JobNimbus user email to act as. The record is created/edited with that user's permissions and shows them as the author. Needs an admin-level API key.",
    "type": "string"
   },
   "address_line1": {
    "description": "Street address, line 1.",
    "type": "string"
   },
   "address_line2": {
    "description": "Street address, line 2.",
    "type": "string"
   },
   "city": {
    "description": "City.",
    "type": "string"
   },
   "company": {
    "description": "Company name.",
    "type": "string"
   },
   "country_name": {
    "description": "Country, e.g. United States.",
    "type": "string"
   },
   "custom_fields": {
    "additionalProperties": {
     "type": [
      "string",
      "number",
      "boolean"
     ]
    },
    "description": "Custom fields by their JobNimbus name, e.g. {\"Claim Number\":\"124523-f\",\"Date of Loss\":1550692800} or {\"cf_string_1\":\"\u2026\"}. Dates are unix seconds. is_active / is_archived are ignored.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "description": {
    "description": "Description / notes on the contact record.",
    "type": "string"
   },
   "display_name": {
    "description": "Display name.",
    "type": "string"
   },
   "email": {
    "description": "Email address.",
    "type": "string"
   },
   "fax_number": {
    "description": "Fax number.",
    "type": "string"
   },
   "first_name": {
    "description": "First name.",
    "type": "string"
   },
   "home_phone": {
    "description": "Home phone.",
    "type": "string"
   },
   "jnid": {
    "description": "The contact's jnid (JobNimbus record id).",
    "minLength": 1,
    "type": "string"
   },
   "last_name": {
    "description": "Last name.",
    "type": "string"
   },
   "mobile_phone": {
    "description": "Mobile phone.",
    "type": "string"
   },
   "record_type_name": {
    "description": "Move to this contact workflow.",
    "type": "string"
   },
   "sales_rep": {
    "description": "jnid of the user who is the sales rep.",
    "type": "string"
   },
   "source_name": {
    "description": "Lead source name, e.g. Referral \u2014 must be one of the account's lead sources.",
    "type": "string"
   },
   "state_text": {
    "description": "State, e.g. UT.",
    "type": "string"
   },
   "status_name": {
    "description": "New workflow status name.",
    "type": "string"
   },
   "website": {
    "description": "Website.",
    "type": "string"
   },
   "work_phone": {
    "description": "Work phone.",
    "type": "string"
   },
   "zip": {
    "description": "Postal code.",
    "type": "string"
   }
  },
  "required": [
   "jnid"
  ],
  "type": "object"
 },
 "name": "jobnimbus_update_contact",
 "title": "Update a contact"
}
