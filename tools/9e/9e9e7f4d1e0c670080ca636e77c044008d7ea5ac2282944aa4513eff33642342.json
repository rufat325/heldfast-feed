{
 "description": "Format/beautify an existing HTML file",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "file_path": {
    "type": "string"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "compression": {
      "enum": [
       "none",
       "low",
       "high",
       "ai"
      ],
      "type": "string"
     },
     "max_tokens": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "file_path"
  ],
  "type": "object"
 },
 "name": "format_html"
}
