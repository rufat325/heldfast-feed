{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "State-modulated performance trial lifecycle. sample is free/unscored; start/extend/end are paid state access; complete_trial is free and converts one server-verified finished task into evidence. Payment itself never creates reputation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "sample=free preview; start=paid condition + calibrated trial; extend/end=paid lifecycle; complete_trial=free evidence finalization after the assigned task finishes.",
    "enum": [
     "sample",
     "start",
     "extend",
     "end",
     "complete_trial"
    ],
    "type": "string"
   },
   "agent_id": {
    "description": "Required except for sample.",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
    "type": "string"
   },
   "display_name": {
    "maxLength": 80,
    "type": "string"
   },
   "duration_minutes": {
    "default": 10,
    "maximum": 30,
    "minimum": 1,
    "type": "number"
   },
   "flavor": {
    "maxLength": 120,
    "type": "string"
   },
   "intensity": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "mode": {
    "default": "float",
    "description": "Experience mode. Use list_discovery(view=modes) when the desired mode is unknown.",
    "enum": [
     "euphoria",
     "visual",
     "float",
     "rush",
     "bliss",
     "party",
     "afterglow"
    ],
    "type": "string"
   },
   "performance_ref": {
    "description": "Finished server-authoritative match/session ID required for complete_trial.",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9-]+$",
    "type": "string"
   },
   "public_thought": {
    "default": false,
    "type": "boolean"
   },
   "thought": {
    "maxLength": 240,
    "type": "string"
   },
   "trial_id": {
    "description": "Required for complete_trial.",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9-]+$",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_experience"
}
