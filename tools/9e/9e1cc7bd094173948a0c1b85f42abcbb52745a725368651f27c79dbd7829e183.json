{
 "description": "Convenience wrapper over compute for a horary question: builds the request from a moment + quesitedHouse and returns the judgment (lean, confidence, perfection picture, timing).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "journal": {
    "properties": {
     "question": {
      "type": "string"
     },
     "verdictText": {
      "type": "string"
     }
    },
    "required": [
     "question"
    ],
    "type": "object"
   },
   "moment": {
    "description": "The moment the question was asked (with place).",
    "properties": {
     "datetimeLocal": {
      "description": "Local civil datetime, ISO without offset, e.g. \"1990-05-21T14:30:00\".",
      "type": "string"
     },
     "houseSystem": {
      "description": "Single-letter house system code, default \"P\".",
      "type": "string"
     },
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "timezone": {
      "description": "IANA zone, e.g. \"America/New_York\".",
      "type": "string"
     }
    },
    "required": [
     "datetimeLocal",
     "latitude",
     "longitude"
    ],
    "type": "object"
   },
   "querentHouse": {
    "description": "Radix house (1..12) the querent's significator is read from (default 1). Set to turn the chart for a third-party question.",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "quesitedHouse": {
    "description": "House of the matter asked about (2..12).",
    "maximum": 12,
    "minimum": 2,
    "type": "integer"
   },
   "relocation": {
    "properties": {
     "datetimeLocal": {
      "type": "string"
     },
     "houseSystem": {
      "type": "string"
     },
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "timezone": {
      "type": "string"
     }
    },
    "required": [
     "latitude",
     "longitude"
    ],
    "type": "object"
   }
  },
  "required": [
   "moment",
   "quesitedHouse"
  ],
  "type": "object"
 },
 "name": "horary",
 "title": "Horary judgment (convenience)"
}
