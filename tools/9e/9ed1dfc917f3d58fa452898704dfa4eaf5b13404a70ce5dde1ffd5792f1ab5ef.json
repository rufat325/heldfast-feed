{
 "description": "Update a reward's details or mark it as used. Set status to 'used' when the reward has been redeemed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expiration_date": {
    "description": "Update expiration date (YYYY-MM-DD)",
    "type": "string"
   },
   "name": {
    "description": "Update reward name",
    "type": "string"
   },
   "notes": {
    "description": "Update notes",
    "type": "string"
   },
   "reward_id": {
    "description": "The reward ID to update",
    "type": "string"
   },
   "source": {
    "description": "Update source",
    "type": "string"
   },
   "status": {
    "description": "Set status \u2014 use 'used' when redeemed",
    "enum": [
     "active",
     "used",
     "expired"
    ],
    "type": "string"
   },
   "type": {
    "description": "Update type",
    "type": "string"
   },
   "value": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^[+-]?\\d+(\\.\\d+)?$",
      "type": "string"
     }
    ],
    "description": "Update dollar value"
   }
  },
  "required": [
   "reward_id"
  ],
  "type": "object"
 },
 "name": "update_reward"
}
