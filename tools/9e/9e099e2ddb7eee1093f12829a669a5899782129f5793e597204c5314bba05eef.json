{
 "description": "Rank moments in a window for an electional aim. Samples the window and scores each instant by how closely a set of wanted body-to-body aspects is satisfied (tighter and applying aspects score higher), optionally penalizing a void-of-course Moon. Returns the top moments with the aspects that matched. Body-to-body only; for aspects to the angles, compute the chart at a candidate moment.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "avoid_void_moon": {
    "default": false,
    "description": "penalize a void-of-course Moon",
    "type": "boolean"
   },
   "end": {
    "description": "UTC ISO end of the window",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "max moments to return (default 10)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "start": {
    "description": "UTC ISO start of the window",
    "type": "string"
   },
   "step_hours": {
    "default": 6,
    "description": "sampling step in hours (default 6)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "wanted": {
    "description": "aspects to reward when close to exact",
    "items": {
     "additionalProperties": false,
     "properties": {
      "a": {
       "description": "first body, snake_case",
       "type": "string"
      },
      "aspect": {
       "enum": [
        "conjunction",
        "sextile",
        "square",
        "trine",
        "opposition"
       ],
       "type": "string"
      },
      "b": {
       "description": "second body, snake_case",
       "type": "string"
      }
     },
     "required": [
      "a",
      "b",
      "aspect"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "zodiac": {
    "default": "tropical",
    "description": "tropical (default) or sidereal:<ayanamsa>",
    "enum": [
     "tropical",
     "sidereal:lahiri",
     "sidereal:fagan_bradley",
     "sidereal:krishnamurti",
     "sidereal:raman",
     "sidereal:yukteshwar",
     "sidereal:galcent_0sag",
     "sidereal:true_citra"
    ],
    "type": "string"
   }
  },
  "required": [
   "start",
   "end",
   "wanted"
  ],
  "type": "object"
 },
 "name": "electional_search"
}
