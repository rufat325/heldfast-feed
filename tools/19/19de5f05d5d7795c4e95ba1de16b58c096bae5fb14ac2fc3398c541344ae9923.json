{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "read:library"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check an upload"
 },
 "description": "Read whether the original byte upload for an uploadId is absent or uploaded, using the same uploadId and MIME type. Needs read:library. Free; changes nothing. Keep the uploadId and do not retry automatically if it cannot be confirmed.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bucket": {
    "enum": [
     "media",
     "brand-assets"
    ],
    "type": "string"
   },
   "mimeType": {
    "enum": [
     "image/png",
     "image/jpeg",
     "image/webp",
     "image/gif",
     "video/mp4",
     "video/webm",
     "video/quicktime",
     "audio/mpeg",
     "audio/mp4",
     "audio/wav",
     "audio/x-wav",
     "audio/ogg",
     "audio/webm"
    ],
    "type": "string"
   },
   "uploadId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "uploadId",
   "mimeType"
  ],
  "type": "object"
 },
 "name": "soclo_library_upload_status",
 "title": "Check an upload"
}
