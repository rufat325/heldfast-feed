 "description": "Create a five-minute direct newsletter media upload bound to the organization, filename, content type, byte size, and SHA-256 digest. Object and completion URLs are single-use. Video uploads include a JPEG poster upload.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "content_type": {
    "enum": [
     "image/gif",
     "image/jpeg",
     "image/png",
     "image/webp",
     "video/mp4",
     "video/quicktime",
     "video/webm"
    ],
    "type": "string"
   },
   "filename": {
    "maxLength": 240,
    "minLength": 1,
    "type": "string"
   },
   "sha256": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "size": {
    "maximum": 26214400,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "filename",
   "content_type",
   "size",
   "sha256"
  ],
  "type": "object"
 },
