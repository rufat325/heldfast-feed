{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new Datadog monitor (metric alert, log alert, etc.)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "message": {
    "description": "Notification message (supports @mentions)",
    "type": "string"
   },
   "name": {
    "description": "Monitor name",
    "type": "string"
   },
   "options": {
    "additionalProperties": {},
    "description": "Advanced monitor options (thresholds, etc.)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "priority": {
    "description": "Priority 1-5 (1=highest)",
    "type": "number"
   },
   "query": {
    "description": "Monitor query. Example: avg(last_5m):avg:system.cpu.user{env:prod} > 90",
    "type": "string"
   },
   "tags": {
    "description": "Tags for the monitor",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Monitor type (e.g. metric alert, log alert, query alert, service check)",
    "type": "string"
   }
  },
  "required": [
   "name",
   "type",
   "query"
  ],
  "type": "object"
 },
 "name": "create-monitor"
}
