{"_meta":{"xdata.kr/credential":{"providers":["hometax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=hometax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: hometax__session__login (\uac19\uc740 account_link_id). \uc791\uc131 \uc911\uc778 \uc6d0\ucc9c\uc138 \uc815\uae30\uc2e0\uace0\uc11c\ub97c \uc81c\ucd9c\ud569\ub2c8\ub2e4. \uc774 \ub3c4\uad6c\ub294 \uae30\uad00\uc758 \uae30\ub85d\uc744 \ubc14\uafc9\ub2c8\ub2e4. \uccab \ud638\ucd9c\uc740 \uc2e4\ud589\ub418\uc9c0 \uc54a\uace0, \uc804\uc1a1\ud560 \ub0b4\uc6a9\uc758 \ubbf8\ub9ac\ubcf4\uae30\uc640 1\ud68c\uc6a9 confirmation_token \uc744 \ub3cc\ub824\uc90d\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uadf8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc0ac\uc6a9\uc790\uc5d0\uac8c \uadf8\ub300\ub85c \ubcf4\uc5ec \uc90d\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \ub3d9\uc758\ud55c \ub4a4\uc5d0\ub9cc \uac19\uc740 \uc778\uc790\uc5d0 \uadf8 confirmation_token \uc744 \ub354\ud574 \ub2e4\uc2dc \ud638\ucd9c\ud569\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uc758 \ub3d9\uc758 \uc5c6\uc774 \ud1a0\ud070\uc744 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc778\uc790\ub97c \ud558\ub098\ub77c\ub3c4 \ubc14\uafb8\uba74 \ud1a0\ud070\uc740 \ubb34\ud6a8\uac00 \ub429\ub2c8\ub2e4. \uadf8\ub54c\ub294 \ud1a0\ud070 \uc5c6\uc774 \ud638\ucd9c\ud574 \uc0c8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 1\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"confirmSubmit":{"description":"\uc81c\ucd9c \ud655\uc778\uc785\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uc5d0\uac8c preview \uacb0\uacfc\ub97c \ubcf4\uc5ec \uc8fc\uace0 \uc81c\ucd9c \ub3d9\uc758\ub97c \ubc1b\uc558\uc744 \ub54c\ub9cc true \ub85c \uc785\ub825\ud569\ub2c8\ub2e4. true \uac00 \uc544\ub2c8\uba74 \uc81c\ucd9c\ud558\uc9c0 \uc54a\uace0 \uac70\uc808\ud569\ub2c8\ub2e4.","type":"boolean"},"confirmation_token":{"description":"\uccab \ud638\ucd9c\uc774 \ub3cc\ub824\uc900 1\ud68c\uc6a9 \ud655\uc778 \ud1a0\ud070\uc785\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uac19\uc740 \uc778\uc790\uc5d0 \uc774 \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc5b4 \ub2e4\uc2dc \ud638\ucd9c\ud558\uba74 \uc2e4\ud589\ub429\ub2c8\ub2e4. 10\ubd84 \ub4a4 \ub9cc\ub8cc\ub418\uace0 \ud55c \ubc88\ub9cc \uc4f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","type":"string"},"draft_id":{"description":"init \uacb0\uacfc\uc758 draft_id \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4. \uc5b4\ub290 \uc2e0\uace0\uc11c\ub97c \uc791\uc131 \uc911\uc778\uc9c0 \uac00\ub9ac\ud0b5\ub2c8\ub2e4.","type":"string"},"expected_state_version":{"description":"\uc9c1\uc804 \ub2e8\uacc4 \uacb0\uacfc\uc758 state_version \uc744 \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(1 \uc774\uc0c1). \uadf8\uc0ac\uc774 \uc2e0\uace0\uc11c\uac00 \ubc14\ub00c\uc5b4 \uac12\uc774 \ub2e4\ub974\uba74 \uc2e4\ud589\ud558\uc9c0 \uc54a\uace0 \uac70\uc808\ud569\ub2c8\ub2e4.","type":"integer"},"idempotency_key":{"description":"\uac19\uc740 \uc694\uccad\uc744 \ub450 \ubc88 \uc2e4\ud589\ud558\uc9c0 \uc54a\uae30 \uc704\ud55c \ud0a4(8\uc790 \uc774\uc0c1 128\uc790 \uc774\ud558)\uc785\ub2c8\ub2e4. \uac19\uc740 \ucd08\uc548\uc758 \ub2e4\ub978 \ub2e8\uacc4\uc5d0\ub294 \uc0c8 \uac12\uc744 \uc785\ub825\ud558\uace0, \uc7ac\uc2dc\ub3c4\uc5d0\ub294 \uac19\uc740 \uac12\uc744 \uc785\ub825\ud569\ub2c8\ub2e4. \uac19\uc740 \ud0a4\ub85c \ub2e4\uc2dc \uc694\uccad\ud558\uba74 \ub2e4\uc2dc \uc2e4\ud589\ud558\uc9c0 \uc54a\uace0 \ucc98\uc74c \uacb0\uacfc\ub97c \ub3cc\ub824\uc90d\ub2c8\ub2e4.","type":"string"},"sbmsAgreement":{"description":"\uc2e0\uace0 \ub0b4\uc6a9 \ub3d9\uc758\uc785\ub2c8\ub2e4. \uc2e0\uace0 \ud654\uba74\uc758 \ub3d9\uc758 \uccb4\ud06c\uc640 \uac19\uace0, true \uc5ec\uc57c \uc81c\ucd9c\ud569\ub2c8\ub2e4.","type":"boolean"},"submissionOptions":{"description":"\uc77d\uc9c0 \uc54a\ub294 \uce78\uc785\ub2c8\ub2e4. confirmSubmit \uacfc sbmsAgreement \ub294 \ucd5c\uc0c1\uc704\uc5d0 \uc785\ub825\ud569\ub2c8\ub2e4. \uc774 \uc548\uc5d0 \ub2f4\uc740 \uac12\uc73c\ub85c\ub294 \uc81c\ucd9c\uc774 \ud655\uc778\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.","type":"object"}},"required":["draft_id","expected_state_version","idempotency_key","confirmSubmit","sbmsAgreement"],"type":"object"},"name":"hometax__tax__withholding__regular_report__submit","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\ud648\ud0dd\uc2a4 \uc6d0\ucc9c\uc138 \uc815\uae30\uc2e0\uace0 \uc81c\ucd9c"}
