 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Make the confirmed storyboard pictures"
 },
 "description": "Spends Brix36 credits for exactly the approved quoted pictures. Chat mode requires the quote's unchanged projectId, revisionId, mode, operationId, quoteToken, modelId, priceVersion and quotedCredits. Insufficient balance returns balance, shortfall and creditsInformationUrl without a checkout. Durable purchase/job reconciliation makes identical retries safe, including after expiry. Legacy confirmationToken remains supported. No video authorization or planning-model call.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmationToken": {
    "description": "Brix36-issued confirmation code for these pictures and credits.",
    "maxLength": 80000,
    "minLength": 1,
    "type": "string"
   },
   "mode": {
    "description": "missing prepares selected shots without pictures; new_version buys another picture for exactly one shot that already has one.",
    "enum": [
     "missing",
     "new_version"
    ],
    "type": "string"
   },
   "modelId": {
    "description": "The exact modelId label returned with that still quote.",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "operationId": {
    "description": "Stable operationId from the picture quote. A new_version operation uses op_ followed by 10\u2013120 letters, digits, underscores or dashes.",
    "maxLength": 130,
    "minLength": 1,
    "pattern": "^op_[A-Za-z0-9_-]{10,120}$",
    "type": "string"
   },
   "priceVersion": {
    "description": "Chat mode: exact priceVersion from the picture quote the customer approved.",
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "projectId": {
    "description": "The music-video or Film project id.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "quoteToken": {
    "description": "The exact opaque quoteToken returned by studio_storyboard_stills_quote.",
    "maxLength": 80000,
    "minLength": 1,
    "type": "string"
   },
   "quotedCredits": {
    "description": "Chat mode: exact creditAmount shown to and approved by the customer.",
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "revisionId": {
    "description": "Exact storyboard revisionId from studio_sections_read. Identical retries retain the originally quoted revision.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "revisionId",
   "mode",
   "operationId",
   "quoteToken",
   "modelId"
  ],
  "type": "object"
 },
