{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Pull a 30/60/90-day snapshot across every configured signal source for one post: GSC clicks/impressions/CTR/position + top queries, Matomo visits + dwell, GA4 pageviews, Clarity scroll/rage clicks, AI-citation counts.\n\nEach source is best-effort: if its env vars are missing the field is omitted. Returns whatever is available.\n\nRead-only. No third-party writes. Optionally persists to the local DuckDB cache when persist=true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "persist": {
    "default": false,
    "type": "boolean"
   },
   "url": {
    "description": "Canonical URL of the post to snapshot.",
    "format": "uri",
    "type": "string"
   },
   "window": {
    "default": 30,
    "enum": [
     30,
     60,
     90
    ],
    "type": "number"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "posts_snapshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bing": {
    "additionalProperties": false,
    "properties": {
     "clicks": {
      "$ref": "#/properties/gsc/properties/clicks"
     },
     "ctr": {
      "$ref": "#/properties/gsc/properties/ctr"
     },
     "impressions": {
      "$ref": "#/properties/gsc/properties/impressions"
     },
     "position": {
      "$ref": "#/properties/gsc/properties/position"
     },
     "top_queries": {
      "$ref": "#/properties/gsc/properties/top_queries"
     }
    },
    "required": [
     "clicks",
     "impressions",
     "ctr",
     "position",
     "top_queries"
    ],
    "type": "object"
   },
   "cannibalization": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "competing_urls": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "query": {
       "type": "string"
      }
     },
     "required": [
      "query",
      "competing_urls"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "citations": {
    "additionalProperties": false,
    "properties": {
     "active_citations": {
      "type": "number"
     },
     "last_seen_at": {
      "type": "string"
     },
     "llms": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "last_seen": {
         "type": "string"
        },
        "llm": {
         "type": "string"
        },
        "query": {
         "type": "string"
        },
        "replaced_by_url": {
         "type": "string"
        }
       },
       "required": [
        "llm",
        "query",
        "last_seen"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "active_citations",
     "llms"
    ],
    "type": "object"
   },
   "clarity": {
    "additionalProperties": false,
    "properties": {
     "dead_clicks": {
      "type": "number"
     },
     "excessive_scroll": {
      "type": "number"
     },
     "rage_clicks": {
      "type": "number"
     },
     "scroll_depth_avg": {
      "type": "number"
     }
    },
    "required": [
     "scroll_depth_avg",
     "rage_clicks",
     "dead_clicks",
     "excessive_scroll"
    ],
    "type": "object"
   },
   "ga4": {
    "additionalProperties": false,
    "properties": {
     "avg_time_on_page_s": {
      "type": "number"
     },
     "bounce_rate": {
      "type": "number"
     },
     "unique_visitors": {
      "type": "number"
     },
     "visits": {
      "type": "number"
     }
    },
    "required": [
     "visits",
     "unique_visitors",
     "avg_time_on_page_s",
     "bounce_rate"
    ],
    "type": "object"
   },
   "gsc": {
    "additionalProperties": false,
    "properties": {
     "clicks": {
      "type": "number"
     },
     "ctr": {
      "type": "number"
     },
     "impressions": {
      "type": "number"
     },
     "position": {
      "type": "number"
     },
     "top_queries": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "clicks": {
         "type": "number"
        },
        "ctr": {
         "type": "number"
        },
        "impressions": {
         "type": "number"
        },
        "position": {
         "type": "number"
        },
        "query": {
         "type": "string"
        }
       },
       "required": [
        "query",
        "clicks",
        "impressions",
        "ctr",
        "position"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "clicks",
     "impressions",
     "ctr",
     "position",
     "top_queries"
    ],
    "type": "object"
   },
   "matomo": {
    "additionalProperties": false,
    "properties": {
     "avg_time_on_page_s": {
      "type": "number"
     },
     "bounce_rate": {
      "type": "number"
     },
     "goal_conversions": {
      "type": "number"
     },
     "unique_visitors": {
      "type": "number"
     },
     "visits": {
      "type": "number"
     }
    },
    "required": [
     "visits",
     "unique_visitors",
     "avg_time_on_page_s",
     "bounce_rate"
    ],
    "type": "object"
   },
   "meta": {
    "additionalProperties": true,
    "properties": {
     "age_days": {
      "type": "number"
     },
     "excerpt": {
      "type": "string"
     },
     "headings": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "published_at": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     },
     "updated_at": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "word_count": {
      "type": "number"
     }
    },
    "required": [
     "slug",
     "url",
     "title",
     "published_at",
     "age_days",
     "status",
     "tags"
    ],
    "type": "object"
   },
   "window_days": {
    "type": "number"
   }
  },
  "required": [
   "meta",
   "window_days",
   "gsc"
  ],
  "type": "object"
 },
 "title": "Unified per-URL snapshot"
}
