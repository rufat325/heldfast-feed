{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Inbox Thread Attention"
 },
 "description": "Complete, reopen, or schedule follow-up for one inbox thread using its current version. `thread_id` accepts a conversation ID (thd_...) or a thread ID.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "done": {
    "type": "boolean"
   },
   "expected_version": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "follow_up_at": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "id": {
    "description": "Mailbox ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Optional idempotency key. If omitted, the MCP server generates one for POST tools.",
    "pattern": "^[\\x20-\\x7E]{1,255}$",
    "type": "string"
   },
   "thread_id": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "thread_id",
   "expected_version"
  ],
  "type": "object"
 },
 "name": "shipmail_update_inbox_thread_attention",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "inbox_thread_attention": {
    "properties": {
     "attention_since": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "attention_state": {
      "type": "string"
     },
     "conversation_id": {
      "description": "Stable Shipmail conversation ID. thread_id is deprecated.",
      "type": "string"
     },
     "done_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "follow_up_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "object": {
      "type": "string"
     },
     "thread_id": {
      "description": "Deprecated mail-server thread ID. Unchanged and still supported; conversation_id is the stable identifier.",
      "type": "string"
     },
     "version": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "object",
     "id",
     "thread_id",
     "conversation_id",
     "attention_state",
     "version",
     "attention_since",
     "done_at",
     "follow_up_at"
    ],
    "type": "object"
   }
  },
  "required": [
   "inbox_thread_attention"
  ],
  "type": "object",
