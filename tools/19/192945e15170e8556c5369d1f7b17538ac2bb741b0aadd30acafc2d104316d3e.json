{
 "description": "Place a limit-then-trailing order. Wait for limit, then trailing phase; when trail triggers, single swap. action: limit_trailing_sell|limit_trailing_buy.",
 "inputSchema": {
  "properties": {
   "action": {
    "enum": [
     "limit_trailing_sell",
     "limit_trailing_buy"
    ],
    "type": "string"
   },
   "amount": {
    "type": "integer"
   },
   "expiry_hours": {
    "default": 144,
    "maximum": 336,
    "minimum": 1,
    "type": "integer"
   },
   "holdings_percentage": {
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "slippage": {
    "default": 500,
    "maximum": 2500,
    "minimum": 100,
    "type": "integer"
   },
   "target": {
    "minimum": 1,
    "type": "integer"
   },
   "token_address": {
    "type": "string"
   },
   "trail": {
    "minimum": 1,
    "type": "integer"
   },
   "wallet_address": {
    "type": "string"
   }
  },
  "required": [
   "wallet_address",
   "token_address",
   "action",
   "target",
   "trail"
  ],
  "type": "object"
 },
 "name": "place_limit_trailing_order"
}
