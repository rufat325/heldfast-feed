{
 "description": "TrueCoverage drill-down for one event (GetEventDetailsRequest). Requires eventTitle plus baseExecutionScope (environment + timeWindow). Optional comparisonExecutionScope for coverage columns (automationEmitsOnly on comparison). Same timeWindow / platform rules as get-truecoverage-events.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "baseExecutionScope": {
    "properties": {
     "automationEmitsOnly": {
      "description": "On comparison/coverage scopes only: restrict to emits with test_id",
      "type": "boolean"
     },
     "branchName": {
      "type": "string"
     },
     "environment": {
      "description": "RUM environment tag from list-rum-environments (e.g. QA, production)",
      "minLength": 1,
      "type": "string"
     },
     "metadataFilters": {
      "items": {
       "properties": {
        "key": {
         "minLength": 1,
         "type": "string"
        },
        "operator": {
         "enum": [
          "UNKNOWN_OPERATOR",
          "EQUALS",
          "NOT_EQUALS",
          "GREATER_THAN",
          "LESS_THAN"
         ],
         "type": "string"
        },
        "value": {
         "properties": {
          "boolValue": {
           "type": "boolean"
          },
          "floatValue": {
           "type": "number"
          },
          "intValue": {
           "type": [
            "string",
            "number"
           ]
          },
          "stringValue": {
           "type": "string"
          }
         },
         "type": "object"
        }
       },
       "required": [
        "key",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "platform": {
      "enum": [
       "web",
       "ios",
       "android",
       "UNKNOWN_EXECUTION_PLATFORM",
       "WEB_EXECUTION_PLATFORM",
       "IOS_EXECUTION_PLATFORM",
       "ANDROID_EXECUTION_PLATFORM"
      ],
      "type": "string"
     },
     "release": {
      "type": "string"
     },
     "timeWindow": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "relativeWindow": {
          "pattern": "^-?\\d+(\\.\\d+)?s$",
          "type": "string"
         }
        },
        "required": [
         "relativeWindow"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "fixedWindow": {
          "description": "Fixed calendar window (both bounds required)",
          "properties": {
           "endTime": {
            "description": "RFC 3339 timestamp",
            "minLength": 1,
            "type": "string"
           },
           "startTime": {
            "description": "RFC 3339 timestamp",
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "startTime",
           "endTime"
          ],
          "type": "object"
         }
        },
        "required": [
         "fixedWindow"
        ],
        "type": "object"
       }
      ]
     }
    },
    "required": [
     "environment",
     "timeWindow"
    ],
    "type": "object"
   },
   "comparisonExecutionScope": {
    "properties": {
     "automationEmitsOnly": {
      "description": "On comparison/coverage scopes only: restrict to emits with test_id",
      "type": "boolean"
     },
     "branchName": {
      "type": "string"
     },
     "environment": {
      "description": "RUM environment tag from list-rum-environments (e.g. QA, production)",
      "minLength": 1,
      "type": "string"
     },
     "metadataFilters": {
      "items": {
       "properties": {
        "key": {
         "minLength": 1,
         "type": "string"
        },
        "operator": {
         "enum": [
          "UNKNOWN_OPERATOR",
          "EQUALS",
          "NOT_EQUALS",
          "GREATER_THAN",
          "LESS_THAN"
         ],
         "type": "string"
        },
        "value": {
         "properties": {
          "boolValue": {
           "type": "boolean"
          },
          "floatValue": {
           "type": "number"
          },
          "intValue": {
           "type": [
            "string",
            "number"
           ]
          },
          "stringValue": {
           "type": "string"
          }
         },
         "type": "object"
        }
       },
       "required": [
        "key",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "platform": {
      "enum": [
       "web",
       "ios",
       "android",
       "UNKNOWN_EXECUTION_PLATFORM",
       "WEB_EXECUTION_PLATFORM",
       "IOS_EXECUTION_PLATFORM",
       "ANDROID_EXECUTION_PLATFORM"
      ],
      "type": "string"
     },
     "release": {
      "type": "string"
     },
     "timeWindow": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "relativeWindow": {
          "pattern": "^-?\\d+(\\.\\d+)?s$",
          "type": "string"
         }
        },
        "required": [
         "relativeWindow"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "fixedWindow": {
          "description": "Fixed calendar window (both bounds required)",
          "properties": {
           "endTime": {
            "description": "RFC 3339 timestamp",
            "minLength": 1,
            "type": "string"
           },
           "startTime": {
            "description": "RFC 3339 timestamp",
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "startTime",
           "endTime"
          ],
          "type": "object"
         }
        },
        "required": [
         "fixedWindow"
        ],
        "type": "object"
       }
      ]
     }
    },
    "required": [
     "environment",
     "timeWindow"
    ],
    "type": "object"
   },
   "eventTitle": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "eventTitle",
   "baseExecutionScope"
  ],
  "type": "object"
 },
 "name": "get-truecoverage-event-details"
}
