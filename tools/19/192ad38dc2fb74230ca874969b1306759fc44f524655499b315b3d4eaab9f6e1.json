{
 "description": "Record a production incident to build pattern library.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "incident_type": {
    "description": "Incident type",
    "type": "string"
   },
   "pattern": {
    "description": "Code pattern that caused the incident",
    "type": "string"
   },
   "time_to_debug_hrs": {
    "description": "Debug hours",
    "type": "number"
   }
  },
  "required": [
   "pattern"
  ],
  "type": "object"
 },
 "name": "timps_record_incident"
}
