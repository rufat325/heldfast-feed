{
 "description": "Record completion evidence and atomically leave the task active as a handoff, mark it review-ready, or close it with a complete/closed outcome.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_id": {
    "description": "Usually omit \u2014 Concord derives your identity from your session. Pass only the id your client told you (Codex); a session Concord can see always wins.",
    "minLength": 1,
    "type": "string"
   },
   "assumptions": {
    "description": "Assumptions made",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "changed_files": {
    "description": "Files that changed",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "decisions": {
    "description": "Notable decisions and why",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "diff_size": {
    "description": "Rough diff size, e.g. +120 / -30",
    "type": "string"
   },
   "expected_version": {
    "description": "Task version last read by the caller; stale versions are rejected",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "guardrails_checked": {
    "description": "Guardrails checked",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "known_risks": {
    "description": "Known risks introduced",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "needs_review_from": {
    "description": "Who should review",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "next_steps": {
    "description": "Remaining work or follow-ups",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "open_questions": {
    "description": "Unresolved review questions",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "outcome": {
    "default": "complete",
    "description": "Final task state; handoff records evidence without changing lifecycle state",
    "enum": [
     "handoff",
     "review_ready",
     "complete",
     "closed"
    ],
    "type": "string"
   },
   "provenance": {
    "description": "Evidence source for review claims",
    "items": {
     "properties": {
      "field": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "required": [
      "field",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "reason": {
    "description": "Audited terminal reason; defaults to the change summary",
    "minLength": 1,
    "type": "string"
   },
   "reported_outcome": {
    "additionalProperties": false,
    "description": "Optional measured acceptance, integration, or intervention result",
    "properties": {
     "acceptance": {
      "default": "not_checked",
      "enum": [
       "accepted",
       "rejected",
       "not_checked"
      ],
      "type": "string"
     },
     "human_intervention_ms": {
      "maximum": 604800000,
      "minimum": 0,
      "type": "integer"
     },
     "integration": {
      "default": "not_checked",
      "enum": [
       "passed",
       "failed",
       "not_checked"
      ],
      "type": "string"
     },
     "rework_ms": {
      "maximum": 604800000,
      "minimum": 0,
      "type": "integer"
     },
     "source": {
      "enum": [
       "agent",
       "ci",
       "review",
       "human"
      ],
      "type": "string"
     }
    },
    "required": [
     "source"
    ],
    "type": "object"
   },
   "task_id": {
    "description": "Stable task identifier, e.g. TASK-12",
    "minLength": 1,
    "type": "string"
   },
   "tests_run": {
    "description": "Test commands run",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "what_changed": {
    "description": "Concise summary of what changed",
    "minLength": 1,
    "type": "string"
   },
   "workspace_id": {
    "description": "Workspace id returned by a Concord operation. Omit to use the automatically resolved repository workspace.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "expected_version",
   "what_changed"
  ],
  "type": "object"
 },
 "name": "finish_work",
 "title": "Finish work"
}
