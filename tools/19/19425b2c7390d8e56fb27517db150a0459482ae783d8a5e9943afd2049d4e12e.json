         "properties": {
          "carb_g": {
           "type": "number"
          },
          "fat_g": {
           "type": "number"
          },
          "kcal": {
           "type": "number"
          },
          "protein_g": {
           "type": "number"
          }
         },
         "required": [
          "kcal",
          "protein_g",
          "carb_g",
          "fat_g"
         ],
         "type": "object"
        },
        "quantity": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "quantity",
        "macros"
       ],
       "type": "object"
      },
      "usual_meal": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "name",
      "times_logged",
      "last_eaten",
      "usual_meal",
      "typical_serving"
     ],
