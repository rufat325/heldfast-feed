{
 "description": "Publish an immutable Native Forms assessment version from the exact expected draft revision. Requires confirmPublish=true and an idempotency key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirmPublish": {
    "const": true,
    "type": "boolean"
   },
   "expectedDraftRevision": {
    "minimum": 0,
    "type": "integer"
   },
   "formId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Required request idempotency key. Reuse it only for the identical operation.",
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "formId",
   "expectedDraftRevision",
   "confirmPublish",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_publish_assessment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
