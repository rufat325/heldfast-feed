{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find product candidates for a registration plate or a complete vehicle make/model/year. Always ask the user to verify fitment on the product page.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "lang": {
    "default": "es",
    "pattern": "^[a-z]{2}$",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "pricing": {
    "default": "public",
    "description": "customer only works with a valid logged-in PrestaShop session. The server derives the group.",
    "enum": [
     "public",
     "customer"
    ],
    "type": "string"
   },
   "q": {
    "maxLength": 160,
    "type": "string"
   },
   "registration": {
    "maxLength": 16,
    "type": "string"
   },
   "shop": {
    "default": "tudetic",
    "enum": [
     "tudetic",
     "mototic",
     "scubatic",
     "biketic",
     "autotic",
     "trekktic",
     "cubiertas",
     "ociotic",
     "decortic"
    ],
    "type": "string"
   },
   "vehicle_cc": {
    "maxLength": 30,
    "type": "string"
   },
   "vehicle_make": {
    "maxLength": 80,
    "type": "string"
   },
   "vehicle_model": {
    "maxLength": 120,
    "type": "string"
   },
   "vehicle_year": {
    "maxLength": 20,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "check_vehicle_compatibility",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "notice": {
    "type": "string"
   },
   "products": {
    "items": {
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "schema_version": {
    "type": "string"
   }
  },
  "required": [
   "schema_version",
   "products",
   "notice"
  ],
  "type": "object"
 },
 "title": "Check vehicle compatibility"
}
