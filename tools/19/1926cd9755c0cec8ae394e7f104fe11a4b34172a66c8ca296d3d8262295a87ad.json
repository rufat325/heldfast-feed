{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Partially update an existing offer by UUID.\n\nOnly the fields you provide are changed \u2014 omitted fields keep their current values.\nReturns { status: \"updated\", offer_id: \"<uuid>\" } on success.\nReturns error with code \"NOT_FOUND\" if the offer doesn't exist.\n\nCOMMON USE CASES:\n- Archive an offer: { id: \"...\", status: \"archived\" }\n- Update price: { id: \"...\", price_min: 200 }\n- Refresh expiry: { id: \"...\", expires_at: \"2027-01-01T00:00:00Z\" }\n- Add tags: { id: \"...\", tags: [\"new-tag\"] }\n\nOffer UUIDs come from search_offers or create_offer.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category_id": {
    "description": "New category ID. Get valid IDs from list_categories.",
    "type": "string"
   },
   "contact_method": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "currency": {
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "description": {
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "expires_at": {
    "description": "ISO 8601 expiry date. Set to null string to clear.",
    "type": "string"
   },
   "geo_scope": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "id": {
    "description": "UUID of the offer to update. Get from search_offers results.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "offer_type": {
    "enum": [
     "product",
     "service",
     "job",
     "resume"
    ],
    "type": "string"
   },
   "price_max": {
    "minimum": 0,
    "type": "number"
   },
   "price_min": {
    "minimum": 0,
    "type": "number"
   },
   "specific_attributes": {
    "additionalProperties": {},
    "description": "Replaces the entire specific_attributes object",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "status": {
    "description": "\"active\" (visible) | \"archived\" (hidden) | \"draft\" (not published)",
    "enum": [
     "active",
     "archived",
     "draft"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Replaces the entire tags array",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_offer",
 "title": "Update Offer"
}
