{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List findings"},"description":"List security findings for the organisation. Filter by pentest, asset, repository, severity, client-visible status, source, confirmation type, assignee, CVSS range, or dormant assets. Search titles or human identifiers such as ODI-12.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"assetId":{"description":"Filter to findings whose latest revision references this asset.","type":"string"},"assignee":{"anyOf":[{"maxLength":500,"minLength":1,"type":"string"},{"items":{"maxLength":500,"minLength":1,"type":"string"},"minItems":1,"type":"array"}],"description":"Client user ID(s), or __unassigned__ to include findings without an assignee."},"confirmationType":{"anyOf":[{"enum":["static","partial","exploited"],"type":"string"},{"items":{"enum":["static","partial","exploited"],"type":"string"},"minItems":1,"type":"array"}]},"cvssMax":{"maximum":10,"minimum":0,"type":"number"},"cvssMin":{"maximum":10,"minimum":0,"type":"number"},"excludeStatuses":{"anyOf":[{"enum":["REPORTED","ACKNOWLEDGED","MITIGATING","OPEN_FOR_RETEST","NEEDS_REVISION","FIXED_AND_RETESTED"],"type":"string"},{"items":{"enum":["REPORTED","ACKNOWLEDGED","MITIGATING","OPEN_FOR_RETEST","NEEDS_REVISION","FIXED_AND_RETESTED"],"type":"string"},"minItems":1,"type":"array"}],"description":"Exclude these client-visible statuses."},"hideDormant":{"description":"Hide findings on dormant assets.","type":"boolean"},"lean":{"description":"Exclude heavy evidence from list results; details stay available.","type":"boolean"},"limit":{"default":50,"maximum":200,"minimum":1,"type":"integer"},"offset":{"default":0,"maximum":9007199254740991,"minimum":0,"type":"integer"},"pentestId":{"description":"Filter to a single pentest.","type":"string"},"repository":{"description":"Filter to a source repository such as owner/