{
 "description": "Record a customer payment against one or more invoices. TotalAmt and CustomerRef are required.",
 "inputSchema": {
  "properties": {
   "CurrencyRef": {
    "properties": {
     "value": {
      "description": "ISO-4217",
      "type": "string"
     }
    },
    "type": "object"
   },
   "CustomerRef": {
    "properties": {
     "value": {
      "description": "Customer.Id",
      "type": "string"
     }
    },
    "required": [
     "value"
    ],
    "type": "object"
   },
   "Line": {
    "description": "Invoice allocations",
    "items": {
     "properties": {
      "Amount": {
       "type": "number"
      },
      "LinkedTxn": {
       "items": {
        "properties": {
         "TxnId": {
          "description": "Invoice.Id",
          "type": "string"
         },
         "TxnType": {
          "description": "Typically 'Invoice'",
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "PaymentMethodRef": {
    "properties": {
     "value": {
      "description": "PaymentMethod.Id",
      "type": "string"
     }
    },
    "type": "object"
   },
   "TotalAmt": {
    "description": "Payment amount",
    "type": "number"
   },
   "TxnDate": {
    "description": "Payment date (YYYY-MM-DD)",
    "type": "string"
   }
  },
  "required": [
   "CustomerRef",
   "TotalAmt"
  ],
  "type": "object"
 },
 "name": "create_payment"
}
