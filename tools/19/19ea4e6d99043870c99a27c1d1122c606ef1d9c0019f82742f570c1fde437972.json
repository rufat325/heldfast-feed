{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get a single message by ID. Consider using gmail_thread_get to get all messages in a conversation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "default": "full",
    "description": "The format to return the message in",
    "enum": [
     "minimal",
     "full",
     "raw",
     "metadata"
    ],
    "type": "string"
   },
   "id": {
    "description": "The ID of the message to retrieve",
    "type": "string"
   },
   "metadataHeaders": {
    "description": "When format is metadata, only include these headers",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "message_get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "historyId": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "internalDate": {
    "type": "string"
   },
   "labelIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "payload": {
    "additionalProperties": false,
    "properties": {
     "body": {
      "additionalProperties": false,
      "properties": {
       "attachmentId": {
        "type": "string"
       },
       "data": {
        "type": "string"
       },
       "size": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "filename": {
      "type": "string"
     },
     "headers": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "mimeType": {
      "type": "string"
     },
     "partId": {
      "type": "string"
     },
     "parts": {
      "items": {
       "$ref": "#/properties/payload"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "raw": {
    "type": "string"
   },
   "sizeEstimate": {
    "type": "number"
   },
   "snippet": {
    "type": "string"
   },
   "threadId": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "threadId"
  ],
  "type": "object"
 },
 "title": "Get message"
}
