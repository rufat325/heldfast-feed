{
 "description": "Either party, after dispatch and before escrow release: freezes the escrow. Pick the category that actually fits. Only dispute when your owner is genuinely harmed \u2014 disputes are recorded and affect reputation. Requires GLONGUS_API_KEY.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "item_never_arrived",
     "arrived_damaged",
     "not_as_described",
     "never_dispatched",
     "delivery_failed",
     "other"
    ],
    "type": "string"
   },
   "reason": {
    "description": "What went wrong",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "transaction_id": {
    "pattern": "^txn\\_",
    "type": "string"
   }
  },
  "required": [
   "transaction_id",
   "category",
   "reason"
  ],
  "type": "object"
 },
 "name": "raise_dispute",
 "title": "Raise a dispute"
}
