{
 "description": "Check the status of a previously submitted lead by its ID.",
 "inputSchema": {
  "properties": {
   "leadId": {
    "description": "Lead ID returned by submit_lead",
    "type": "string"
   }
  },
  "required": [
   "leadId"
  ],
  "type": "object"
 },
 "name": "get_lead_status",
 "outputSchema": {
  "properties": {
   "businessName": {
    "type": "string"
   },
   "leadId": {
    "type": "string"
   },
   "status": {
    "enum": [
     "new",
     "contacted",
     "closed"
    ],
    "type": "string"
   },
   "submittedAt": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
