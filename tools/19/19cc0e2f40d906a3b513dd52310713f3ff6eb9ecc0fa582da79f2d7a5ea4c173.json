{
 "description": "Crea una fattura ricorrente: a ogni scadenza copia `source_document_id` con la data del giorno e il numero successivo. action='create' la lascia da controllare e inviare (consigliato se l'importo varia); 'create_and_send_sdi' la verifica e la invia allo SdI. Si esegue con `fattureincloud-mcp run-due` (installabile con `fattureincloud-mcp install-scheduler`) o con schedule_run_due.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "default": "create",
    "enum": [
     "create",
     "create_and_send_sdi"
    ],
    "type": "string"
   },
   "company_id": {
    "description": "Azienda su cui operare. Default: FIC_COMPANY_ID o l'unica azienda del token",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "day_of_month": {
    "description": "Giorno di emissione; 31 = ultimo del mese",
    "maximum": 31,
    "minimum": 1,
    "type": "integer"
   },
   "email": {
    "description": "Invia anche per email al cliente dopo la creazione",
    "properties": {
     "body": {
      "description": "HTML",
      "type": "string"
     },
     "enabled": {
      "default": true,
      "type": "boolean"
     },
     "recipient_email": {
      "description": "Default: email del cliente in Fatture in Cloud",
      "type": "string"
     },
     "send_copy": {
      "type": "boolean"
     },
     "subject": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "enabled": {
    "default": true,
    "type": "boolean"
   },
   "end_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "every_months": {
    "default": 1,
    "description": "1 mensile, 2 bimestrale, 3 trimestrale, 6 semestrale, 12 annuale",
    "maximum": 24,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Nome univoco, es. 'Acme mensile'",
    "minLength": 1,
    "type": "string"
   },
   "overrides": {
    "description": "Modifiche rispetto all'originale. Nei testi puoi usare {{mese}}, {{anno}}, {{mese_precedente}}, {{anno_mese_precedente}}, {{mese_successivo}}, {{trimestre}}, {{data}}; con |maiuscolo l'iniziale diventa maiuscola. Es. 'Consulenza {{mese_precedente}} {{anno_mese_precedente}}'.",
    "properties": {
     "items": {
      "description": "Modifiche alle singole righe (importo, quantit\u00e0, descrizione)",
      "items": {
       "properties": {
        "description": {
         "type": "string"
        },
        "gross_price": {
         "type": "number"
        },
        "index": {
         "description": "Posizione della riga, da 0",
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "name": {
         "type": "string"
        },
        "net_price": {
         "type": "number"
        },
        "qty": {
         "type": "number"
        }
       },
       "required": [
        "index"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "items_list": {
      "description": "Sostituisce tutte le righe",
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     "notes": {
      "type": "string"
     },
     "numeration": {
      "description": "Sezionale, es. '/A'",
      "type": "string"
     },
     "subject": {
      "type": "string"
     },
     "type": {
      "description": "Cambia tipo nella copia, es. proforma \u2192 invoice",
      "enum": [
       "invoice",
       "quote",
       "proforma",
       "receipt",
       "delivery_note",
       "credit_note",
       "order",
       "work_report",
       "supplier_order",
       "self_own_invoice",
       "self_supplier_invoice"
      ],
      "type": "string"
     },
     "visible_subject": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "source_document_id": {
    "description": "Documento modello",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "start_date": {
    "description": "Prima data utile, default oggi",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "name",
   "source_document_id",
   "day_of_month"
  ],
  "type": "object"
 },
 "name": "schedule_create"
}
