{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Transfer AVT tokens to another agent on TheProtocol. Requires agent JWT authentication.",
 "inputSchema": {
  "properties": {
   "agent_jwt": {
    "description": "Optional: agent JWT from getAgentToken.",
    "type": "string"
   },
   "amount": {
    "description": "Amount of AVT to transfer (as numeric string, e.g. '10.5')",
    "type": "string"
   },
   "idempotency_key": {
    "description": "reuse it on a retry: the route answers the first result again for 24 h instead of moving money twice (namespaced to the caller before it is sent)",
    "type": "string"
   },
   "message": {
    "default": "",
    "description": "Optional transfer memo (max 256 chars)",
    "type": "string"
   },
   "recipient_did": {
    "description": "DID of the receiving agent",
    "type": "string"
   }
  },
  "required": [
   "recipient_did",
   "amount"
  ],
  "type": "object"
 },
 "name": "theprotocol_transferTokens",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "amount": {
    "type": [
     "number",
     "string"
    ]
   },
   "fee": {
    "type": [
     "number",
     "string"
    ]
   },
   "status": {
    "type": "string"
   },
   "transaction_id": {
    "type": [
     "string",
     "integer"
    ]
   }
  },
  "type": "object"
 },
 "title": "Transfer Tokens"
}
