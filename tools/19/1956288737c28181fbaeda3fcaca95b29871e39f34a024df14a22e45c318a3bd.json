{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get an exact version"
 },
 "description": "The checksum-verified bytes of an exact workflow, component or demo version.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
    "type": "string"
   },
   "registryPin": {
    "additionalProperties": false,
    "properties": {
     "catalog": {
      "maxLength": 200,
      "type": "string"
     },
     "catalogSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "release": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
     }
    },
    "required": [
     "release",
     "catalog",
     "catalogSha256"
    ],
    "type": "object"
   },
   "section": {
    "enum": [
     "workflows",
     "components",
     "demos"
    ],
    "type": "string"
   },
   "version": {
    "maxLength": 80,
    "type": "string"
   }
  },
  "required": [
   "section",
   "id",
   "version"
  ],
  "type": "object"
 },
 "name": "get",
 "title": "Get an exact version"
}
