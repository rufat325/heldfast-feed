 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check storyboard picture readiness"
 },
 "description": "Returns readyForVideo, shotsMissingStills, public likenessGate, look-test state and reviewStills for the exact project and revision. Each review binding identifies a saved stableShotId/stillAssetId. A likenessGate of not_required needs no likeness verdict; an absent look test needs no look acceptance. Required likeness verdicts and acceptance of the saved look set are recorded separately. Video uses the original approved price and the existing readiness gates. No state change, provider call or charge.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "description": "The music-video or Film project id.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "revisionId": {
    "description": "Exact storyboard revisionId from studio_sections_read. Identical retries retain the originally quoted revision.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "revisionId"
  ],
  "type": "object"
 },
 "name": "studio_storyboard_readiness",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": true,
    "properties": {
     "likenessGate": {
      "additionalProperties": true,
      "properties": {
       "confirmedStableShotIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "pendingStableShotIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "rejectedStableShotIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "requiredStableShotIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "state": {
        "enum": [
         "not_required",
         "pending",
         "confirmed",
         "rejected"
        ]
       }
      },
      "required": [
       "state",
       "requiredStableShotIds",
       "pendingStableShotIds",
       "confirmedStableShotIds",
       "rejectedStableShotIds"
      ],
      "type": "object"
     },
     "lookTest": {
      "additionalProperties": true,
      "properties": {
       "missingStableShotIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "stableShotIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "state": {
        "enum": [
         "not_started",
         "preparing",
         "review",
         "accepted"
        ]
       }
      },
      "required": [
       "state",
       "stableShotIds",
       "missingStableShotIds"
      ],
      "type": "object"
     },
     "readyForVideo": {
      "type": "boolean"
     },
     "reviewStills": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "likenessRequired": {
         "type": "boolean"
        },
        "lookSelected": {
         "type": "boolean"
        },
        "stableShotId": {
         "type": "string"
        },
        "stillAssetId": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "stableShotId",
        "stillAssetId",
        "likenessRequired",
        "lookSelected"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "shotsMissingStills": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "readyForVideo",
     "shotsMissingStills",
     "likenessGate",
     "lookTest",
     "reviewStills"
    ],
    "type": "object"
   },
   {
    "additionalProperties": true,
