        "field",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "message": {
      "type": "string"
     },
     "outcomeUnknown": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
