{
 "description": "Authorize a credit-card payment on Getnet. Set delayed=false to authorize+capture atomically; delayed=true to authorize only (use capture_credit later).",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "Amount in cents",
    "type": "number"
   },
   "credit": {
    "description": "Card data (pre-tokenized preferred via number_token)",
    "properties": {
     "brand": {
      "description": "Visa, Mastercard, Elo, Amex, Hipercard",
      "type": "string"
     },
     "cardholder_name": {
      "type": "string"
     },
     "expiration_month": {
      "type": "string"
     },
     "expiration_year": {
      "type": "string"
     },
     "number_installments": {
      "type": "number"
     },
     "number_token": {
      "description": "Token from tokenize_card",
      "type": "string"
     },
     "save_card_data": {
      "type": "boolean"
     },
     "security_code": {
      "type": "string"
     },
     "soft_descriptor": {
      "type": "string"
     },
     "transaction_type": {
      "enum": [
       "FULL",
       "INSTALL_NO_INTEREST",
       "INSTALL_WITH_INTEREST"
      ],
      "type": "string"
     }
    },
    "required": [
     "number_token",
     "cardholder_name",
     "security_code",
     "brand",
     "expiration_month",
     "expiration_year"
    ],
    "type": "object"
   },
   "currency": {
    "description": "ISO-4217 currency code (default BRL)",
    "type": "string"
   },
   "customer": {
    "description": "Customer identity",
    "properties": {
     "customer_id": {
      "description": "Merchant-side customer id",
      "type": "string"
     },
     "document_number": {
      "description": "CPF or CNPJ digits only",
      "type": "string"
     },
     "document_type": {
      "enum": [
       "CPF",
       "CNPJ"
      ],
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "first_name": {
      "type": "string"
     },
     "last_name": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone_number": {
      "type": "string"
     }
    },
    "required": [
     "customer_id",
     "first_name",
     "last_name",
     "email",
     "document_type",
     "document_number"
    ],
    "type": "object"
   },
   "delayed": {
    "description": "true = authorize only; false = authorize + capture",
    "type": "boolean"
   },
   "order_id": {
    "description": "Merchant-side order identifier",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "order_id",
   "delayed",
   "customer",
   "credit"
  ],
  "type": "object"
 },
 "name": "authorize_credit"
}
