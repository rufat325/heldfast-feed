{"description":"Search for emails across all accounts. Supports filters by sender, recipient, subject, date range, attachments, tags. Excludes junk by default. Use --fields to minimize token cost.","inputSchema":{"properties":{"accountId":{"description":"Limit to specific account","type":"string"},"flagged":{"description":"Flagged/starred only","type":"boolean"},"folderId":{"description":"Limit to specific folder","type":"string"},"from":{"description":"Filter by sender address","type":"string"},"hasAttachment":{"description":"Only with attachments","type":"boolean"},"includeJunk":{"description":"Include junk messages (default: false)","type":"boolean"},"limit":{"default":25,"description":"Max results","minimum":0,"type":"integer"},"query":{"description":"Full-text search query. Optional when at least one filter is given","type":"string"},"searchMode":{"description":"fulltext (default): Thunderbird's search index over subject, body and author \u2014 fast on large mailboxes, needs Global Search enabled in Thunderbird. body: scans message bodies directly \u2014 slow, may time out on big folders.","enum":["fulltext","body"],"type":"string"},"since":{"description":"Start date (ISO 8601 or relative: '7d', '2w', '3m', '1y', 'today', 'yesterday')","type":"string"},"sizeMax":{"description":"Maximum message size in bytes","minimum":0,"type":"integer"},"sizeMin":{"description":"Minimum message size in bytes","minimum":0,"type":"integer"},"subject":{"description":"Filter by subject substring","type":"string"},"tag":{"description":"Filter by tag key (e.g. $label1)","type":"string"},"to":{"description":"Filter by recipient address","type":"string"},"unread":{"description":"Unread only","type":"boolean"},"until":{"description":"End date (ISO or relative)","type":"string"}},"type":"object"},"name":"email_search"}
