{
 "description": "Pull a file from the device to local filesystem",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "localPath": {
    "description": "Local destination (defaults to temp dir)",
    "type": "string"
   },
   "remotePath": {
    "description": "File path on the device",
    "type": "string"
   }
  },
  "required": [
   "remotePath"
  ],
  "type": "object"
 },
 "name": "adb_pull"
}
