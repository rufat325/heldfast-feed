{
 "description": "Prepare a one-time direct Cloudflare TUS upload. If localFilePath is supplied, this stdio server uploads the file; hosted MCP never accepts local paths or bytes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contentType": {
    "enum": [
     "video/mp4",
     "video/webm",
     "video/ogg",
     "video/quicktime"
    ],
    "type": "string"
   },
   "durationSeconds": {
    "exclusiveMinimum": 0,
    "maximum": 7200,
    "type": "number"
   },
   "fileName": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "localFilePath": {
    "description": "Stdio-only optional local upload. Path must be inside OPENTRAIN_MCP_VIDEO_UPLOAD_ROOTS and match fileName/sizeBytes.",
    "minLength": 1,
    "type": "string"
   },
   "sizeBytes": {
    "exclusiveMinimum": 0,
    "maximum": 2000000000,
    "type": "integer"
   },
   "title": {
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "fileName",
   "contentType",
   "sizeBytes",
   "durationSeconds",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_video_library_prepare_upload",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
