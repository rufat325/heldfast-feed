{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a constituent"
 },
 "description": "WRITE: change scalar fields on an existing constituent (name, salutation, job title, org name, deceased flag, etc.). Only the fields you pass are sent. LGL's update schema marks first_name and last_name as required, so pass the current values (from lgl_get_constituent) if you are not changing them. Addresses, emails and phones are not edited here. LGL: PATCH /api/v1/constituents/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "addressee": {
    "description": "Addressee/label name.",
    "type": "string"
   },
   "annual_report_name": {
    "type": "string"
   },
   "birthday": {
    "description": "Birthday (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "constituent_contact_type_name": {
    "description": "Constituent contact type name, e.g. 'Primary'.",
    "type": "string"
   },
   "deceased_date": {
    "description": "Deceased date.",
    "type": "string"
   },
   "external_constituent_id": {
    "description": "External constituent ID (your own system's id).",
    "type": "string"
   },
   "first_name": {
    "description": "First name (required by LGL even when unchanged).",
    "minLength": 1,
    "type": "string"
   },
   "gender": {
    "type": "string"
   },
   "id": {
    "description": "Constituent id (integer).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "is_anon": {
    "description": "Gives anonymously?",
    "type": "boolean"
   },
   "is_deceased": {
    "type": "boolean"
   },
   "is_org": {
    "description": "True if this constituent is an organization or company.",
    "type": "boolean"
   },
   "job_title": {
    "type": "string"
   },
   "last_name": {
    "description": "Last name (required by LGL even when unchanged).",
    "minLength": 1,
    "type": "string"
   },
   "maiden_name": {
    "type": "string"
   },
   "middle_name": {
    "type": "string"
   },
   "nick_name": {
    "type": "string"
   },
   "org_name": {
    "description": "Organization name.",
    "type": "string"
   },
   "prefix": {
    "description": "Prefix, e.g. 'Dr.'.",
    "type": "string"
   },
   "salutation": {
    "type": "string"
   },
   "spouse_name": {
    "description": "Spouse/partner name.",
    "type": "string"
   },
   "suffix": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "first_name",
   "last_name"
  ],
  "type": "object"
 },
 "name": "lgl_update_constituent",
 "title": "Update a constituent"
}
