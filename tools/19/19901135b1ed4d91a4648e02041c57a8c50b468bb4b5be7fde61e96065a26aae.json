{
 "description": "Solana pump.fun bonding-curve buyer bursts from the last 1-240 minutes, on pump.fun tokens 5 min to 4 h old that show curve progress. Each burst has SOL inflow, curve position, token age and, on sampled bursts, its anatomy (same-slot bundles, scripted sizes, top-3 share, top holders). Outcomes are scored at graduation or 20 minutes. Data rewritten every 20 s; data older than 120 s is refused with a 503 and not charged. Costs $0.01 USDC per call (x402).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "minutes": {
    "description": "Look-back window in minutes, 1-240 (default 60)",
    "maximum": 240,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "sol_bursts_live",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ageSec": {
    "type": "number"
   },
   "bursts": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "chain": {
    "type": "string"
   },
   "generatedAt": {
    "type": "number"
   },
   "latest": {
    "anyOf": [
     {
      "$ref": "#/properties/bursts/items"
     },
     {
      "type": "null"
     }
    ]
   },
   "note": {
    "type": "string"
   },
   "rule": {
    "type": "string"
   },
   "schemaVersion": {
    "type": "number"
   },
   "solUsd": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "required": [
   "chain",
   "schemaVersion",
   "generatedAt",
   "ageSec",
   "solUsd",
   "bursts"
  ],
  "type": "object"
 }
}
