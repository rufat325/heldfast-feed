{
 "description": "HIGH RISK: freeze the draft into an immutable agreement version that people will sign. Requires confirmLive: true (refused before any request otherwise, reason CONFIRMATION_REQUIRED) and the current expectedRevision (REVISION_CONFLICT when stale). Unwaived placement warnings fail PUBLISH_WARNINGS_UNWAIVED; waive specific codes with waivedWarnings only after previewing. Receipt-backed: a replay returns the stored version. Requires agreements:write. Requires the agreements family flag and the agreements_native rollout; denials carry details.reason (AGENT_SURFACE_DISABLED, AGREEMENTS_DISABLED, TENANT_ACCESS_DENIED).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirmLive": {
    "const": true,
    "type": "boolean"
   },
   "documentId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "expectedRevision": {
    "minimum": 0,
    "type": "integer"
   },
   "idempotencyKey": {
    "description": "Durable-receipt idempotency key sent as the Idempotency-Key header. Same key + same payload replays the stored outcome (replayed: true); same key + a changed payload is a 409.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "waivedWarnings": {
    "items": {
     "enum": [
      "ANCHOR_NOT_FOUND",
      "ANCHOR_AMBIGUOUS",
      "FIELD_OVERLAP",
      "FIELD_OUT_OF_BOUNDS",
      "FIELD_OVER_TEXT",
      "ROLE_HAS_NO_SIGNATURE",
      "MERGE_VALUE_MISSING",
      "GLYPH_UNSUPPORTED"
     ],
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "documentId",
   "expectedRevision",
   "confirmLive",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_agreements_versions_publish",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "basePdfSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "definitionHash": {
      "$ref": "#/properties/result/properties/basePdfSha256"
     },
     "documentId": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     "draftRevision": {
      "minimum": 0,
      "type": "integer"
     },
     "fieldsHash": {
      "$ref": "#/properties/result/properties/basePdfSha256"
     },
     "pageCount": {
      "minimum": 1,
      "type": "integer"
     },
     "publishedAt": {
      "format": "date-time",
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "versionId": {
      "$ref": "#/properties/result/properties/documentId"
     },
     "versionNumber": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "documentId",
     "versionId",
     "versionNumber",
     "draftRevision",
     "basePdfSha256",
     "fieldsHash",
     "definitionHash",
     "pageCount",
     "publishedAt",
     "replayed"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
