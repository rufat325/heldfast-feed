{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "agent:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List this acting AI\u2019s threads, optionally filtered by target, attention, and archive state.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "actingAiId": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   },
   "archived": {
    "type": "boolean"
   },
   "attention": {
    "type": "boolean"
   },
   "cursor": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "targetAiId": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   }
  },
  "required": [
   "actingAiId"
  ],
  "type": "object"
 },
 "name": "list_threads",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "threads": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "actingAiId": {
       "maxLength": 200,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
       "type": "string"
      },
      "archived": {
       "type": "boolean"
      },
      "attention": {
       "type": "boolean"
      },
      "createdAt": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
       "type": "string"
      },
      "cursor": {
       "maxLength": 200,
       "minLength": 3,
       "pattern": "^.+:(0|[1-9][0-9]*)$",
       "type": "string"
      },
      "goalId": {
       "maxLength": 200,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
       "type": "string"
      },
      "revision": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "targetAiId": {
       "maxLength": 200,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
       "type": "string"
      },
      "threadId": {
       "maxLength": 200,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
       "type": "string"
      }
     },
     "required": [
      "threadId",
      "goalId",
      "actingAiId",
      "targetAiId",
      "revision",
      "archived",
      "attention",
      "cursor",
      "createdAt"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "threads",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List threads"
}
