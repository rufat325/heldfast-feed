{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get tour details"
 },
 "description": "Get the full details of one TripWays tour by bokun_id (the number in tripways.com/t/{id}): summary, itinerary stops, inclusions and exclusions, languages, cancellation policy, meeting point or pickup, from-price, rating, hero_image, url, and checkout_url. Live dates and group totals come from check_availability and get_price_quote.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bokun_id": {
    "pattern": "^[0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "bokun_id"
  ],
  "type": "object"
 },
 "name": "get_tour_details",
 "outputSchema": {
  "properties": {
   "activities": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "bokun_id": {
    "description": "Tour id; the number in tripways.com/t/{id}.",
    "type": "string"
   },
   "bookable_natively": {
    "description": "True when checkout_url opens TripWays checkout; false when it opens the operator calendar.",
    "type": "boolean"
   },
   "cancellation": {
    "description": "free, flexible, partial, or non_refundable.",
    "type": "string"
   },
   "checkout_url": {
    "description": "TripWays checkout for this tour.",
    "type": "string"
   },
   "destinations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "duration_hours": {
    "type": "number"
   },
   "duration_text": {
    "type": "string"
   },
   "error": {
    "description": "Present when ok is false. code: tour_not_found, destination_not_found, destination_ambiguous, or unpriced. message is written for the traveler.",
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "exclusions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "from_price": {
    "description": "Lowest adult price.",
    "properties": {
     "amount": {
      "minimum": 0,
      "type": "number"
     },
     "currency": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "gttd_eligible": {
    "description": "Listed on Google Things to Do.",
    "type": "boolean"
   },
   "guidance": {
    "type": "string"
   },
   "hero_image": {
    "description": "Main photo URL.",
    "type": "string"
   },
   "hotel_pickup": {
    "type": "boolean"
   },
   "inclusions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "itinerary": {
    "items": {
     "properties": {
      "body": {
       "type": "string"
      },
      "poi_name": {
       "type": "string"
      },
      "stop_index": {
       "type": "integer"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "languages": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "meeting_pickup_label": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "rating": {
    "properties": {
     "count": {
      "type": "integer"
     },
     "low_confidence": {
      "description": "True when there are fewer than 10 reviews.",
      "type": "boolean"
     },
     "value": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "reason": {
    "description": "Why checkout works the way it does, e.g. pickup_required.",
    "type": [
     "string",
     "null"
    ]
   },
   "summary": {
    "type": "string"
   },
   "themes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "description": "The tour's TripWays page.",
    "type": "string"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Get tour details"
}
