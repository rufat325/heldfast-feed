{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/agents.env-template-check",
  "agent-utilities/priceMicroUsd": 500
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Compare environment-variable names against a template; never returns assignment values. PAID: 500 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "actual": {
      "maxLength": 100000,
      "type": "string"
     },
     "template": {
      "maxLength": 100000,
      "type": "string"
     }
    },
    "required": [
     "template",
     "actual"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "agents_env_template_check",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "duplicateNames": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "extra": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "missing": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "scope": {
    "type": "string"
   },
   "templateDuplicateNames": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "unrecognizedLines": {
    "additionalProperties": false,
    "properties": {
     "actual": {
      "type": "number"
     },
     "template": {
      "type": "number"
     }
    },
    "required": [
     "template",
     "actual"
    ],
    "type": "object"
   }
  },
  "required": [
   "missing",
   "extra",
   "duplicateNames",
   "templateDuplicateNames",
   "unrecognizedLines",
   "scope"
  ],
  "type": "object"
 }
}
