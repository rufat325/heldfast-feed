{
 "description": "Change a certificate status. Use \"revoked\" to invalidate (verify endpoint will reject).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "status": {
    "enum": [
     "active",
     "revoked",
     "expired"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "status"
  ],
  "type": "object"
 },
 "name": "hivelearn_update_certificate"
}
