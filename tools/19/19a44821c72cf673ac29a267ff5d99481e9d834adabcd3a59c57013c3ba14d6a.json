{
 "description": "Legacy auth-required tool \u2014 prefer the open UCP flow (create_cart \u2192 create_checkout \u2192 complete_checkout) for credentialless checkout. Use submit_enquiry only when the customer wants a sales team follow-up by email rather than paying online. Requires Bearer token. Pass a configure_product output plus customer name, email, and phone. Team responds within 24 hours.",
 "inputSchema": {
  "properties": {
   "customer_email": {
    "description": "Customer email address",
    "type": "string"
   },
   "customer_name": {
    "description": "Customer full name",
    "type": "string"
   },
   "customer_phone": {
    "description": "Customer phone number",
    "type": "string"
   },
   "message": {
    "description": "Required enquiry message; at least 10 characters after trimming",
    "minLength": 10,
    "type": "string"
   },
   "product_config": {
    "description": "Product configuration from configure_product",
    "properties": {
     "colour": {
      "type": "string"
     },
     "height_mm": {
      "type": "number"
     },
     "mount_type": {
      "type": "string"
     },
     "price_zar": {
      "type": "number"
     },
     "product_id": {
      "type": "string"
     },
     "product_name": {
      "type": "string"
     },
     "width_mm": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "product_config",
   "customer_name",
   "customer_email",
   "customer_phone",
   "message"
  ],
  "type": "object"
 },
 "name": "submit_enquiry",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "contact": {
    "additionalProperties": true,
    "properties": {
     "contact_name": {
      "type": "string"
     },
     "contact_phone": {
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "whatsapp": {
      "type": "string"
     }
    },
    "required": [],
    "type": "object"
   },
   "enquiry_id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "enquiry_id",
   "message",
   "contact"
  ],
  "type": "object"
 }
}
