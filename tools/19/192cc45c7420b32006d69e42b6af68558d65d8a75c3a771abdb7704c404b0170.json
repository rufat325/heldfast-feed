{
 "description": "Create a new workflow in n8n. Prefer n8n_search_nodes + n8n_validate_workflow first so the JSON is valid. You can specify nodes, connections, and settings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "connections": {
    "additionalProperties": {},
    "description": "Node connections",
    "type": "object"
   },
   "name": {
    "description": "Name of the workflow",
    "type": "string"
   },
   "nodes": {
    "description": "Array of workflow nodes (defaults to empty)",
    "items": {
     "additionalProperties": true,
     "properties": {
      "name": {
       "type": "string"
      },
      "parameters": {
       "additionalProperties": {},
       "type": "object"
      },
      "position": {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "settings": {
    "additionalProperties": {},
    "description": "Workflow settings",
    "type": "object"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "n8n_create_workflow"
}
