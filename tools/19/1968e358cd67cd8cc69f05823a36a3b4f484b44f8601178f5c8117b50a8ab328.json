{
 "description": "Create a page type (template) with a custom-field schema. Pages of this type carry these custom fields. Only call after the user confirms.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
   "__schema0": {
    "properties": {
     "acceptedTypes": {
      "description": "For a 'media' field: allowed media kinds (empty = all).",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "defaultValue": {
      "type": [
       "string",
       "null"
      ]
     },
     "description": {
      "type": [
       "string",
       "null"
      ]
     },
     "fields": {
      "description": "For an 'object' field: nested field definitions.",
      "items": {
       "$ref": "#/definitions/__schema0"
      },
      "type": "array"
     },
     "hidden": {
      "description": "Hide the field from admin forms (still stored on records).",
      "type": "boolean"
     },
     "itemFields": {
      "description": "For a 'list' of objects: nested field definitions.",
      "items": {
       "$ref": "#/definitions/__schema0"
      },
      "type": "array"
     },
     "itemType": {
      "description": "For a 'list' field: the type of each item.",
      "enum": [
       "text",
       "textarea",
       "richText",
       "markdown",
       "number",
       "date",
       "datetime",
       "boolean",
       "color",
       "media",
       "link",
       "url",
       "email",
       "select",
       "multiselect",
       "radio",
       "relation",
       "repeater",
       "object",
       "list",
       "table",
       "json",
       "form",
       "pageSelector",
       "password",
       "phone",
       "file",
       "hidden"
      ],
      "type": "string"
     },
     "key": {
      "minLength": 1,
      "type": "string"
     },
     "label": {
      "minLength": 1,
      "type": "string"
     },
     "localized": {
      "description": "Store this field's value per language: { en: '...', pl: '...' }. Only 'text', 'textarea', 'richText' and 'markdown' may be translatable - a translatable price or sku would corrupt the catalog and is rejected.",
      "type": "boolean"
     },
     "maxLength": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "maxValue": {
      "type": "number"
     },
     "minLength": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "minValue": {
      "type": "number"
     },
     "multiple": {
      "description": "For a 'media' field: true = gallery, false = single.",
      "type": "boolean"
     },
     "options": {
      "description": "Choices for a 'select' or 'multiselect' field. Required (non-empty) for those types.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "pattern": {
      "type": "string"
     },
     "relationTo": {
      "description": "For a 'relation' field: what it points at - a collection ('pages', 'forms', 'media_assets', 'users', 'model_records') or 'model:<slug>' for the records of one model (slug from list_models). Required for relation fields.",
      "type": [
       "string",
       "null"
      ]
     },
     "relationType": {
      "anyOf": [
       {
        "enum": [
         "hasOne",
         "hasMany"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "For a 'relation' field: cardinality. 'hasOne' = one linked id, 'hasMany' = a list of ids. If omitted the CMS treats it as 'hasOne'."
     },
     "required": {
      "default": false,
      "type": "boolean"
     },
     "schemaProperty": {
      "type": "string"
     },
     "type": {
      "enum": [
       "text",
       "textarea",
       "richText",
       "markdown",
       "number",
       "date",
       "datetime",
       "boolean",
       "color",
       "media",
       "link",
       "url",
       "email",
       "select",
       "multiselect",
       "radio",
       "relation",
       "repeater",
       "object",
       "list",
