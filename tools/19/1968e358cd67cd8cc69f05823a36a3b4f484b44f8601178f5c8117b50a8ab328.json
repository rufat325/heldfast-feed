       "form",
       "pageSelector",
       "password",
       "phone",
       "file",
       "hidden"
      ],
      "type": "string"
     }
    },
    "required": [
     "key",
     "label",
     "type"
    ],
    "type": "object"
   }
  },
  "properties": {
   "allowChildren": {
    "type": "boolean"
   },
   "description": {
    "type": "string"
   },
   "fields": {
