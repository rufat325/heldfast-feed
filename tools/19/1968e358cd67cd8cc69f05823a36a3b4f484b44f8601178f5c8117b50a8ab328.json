    "items": {
     "$ref": "#/definitions/__schema0"
    },
    "type": "array"
   },
   "icon": {
    "description": "Lucide icon name",
    "type": "string"
   },
   "name": {
    "description": "Display name",
    "type": "string"
   },
   "slug": {
    "description": "URL-safe slug, lowercase (e.g. 'post', 'case-study')",
    "pattern": "^[a-z][a-z0-9-]*$",
    "type": "string"
   },
   "urlPrefix": {
    "description": "URL prefix (e.g. 'blog')",
    "type": "string"
   }
  },
  "required": [
