{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List or search email threads (conversations). Recommended over messages_list for most use cases.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "includeSpamTrash": {
    "default": false,
    "description": "Include spam and trash in results",
    "type": "boolean"
   },
   "labelIds": {
    "description": "Only return threads with these label IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "maxResults": {
    "default": 10,
    "description": "Maximum number of threads to return",
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "pageToken": {
    "description": "Page token for pagination",
    "type": "string"
   },
   "q": {
    "description": "Search query (same syntax as Gmail search box)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "threads_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "nextPageToken": {
    "type": "string"
   },
   "resultSizeEstimate": {
    "type": "number"
   },
   "threads": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "historyId": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "snippet": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "List threads"
}
