{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Announcements posted in one or more ELMS (Canvas) courses within a date window (default: the last 14 days). Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "course_ids": {
    "description": "Courses to read announcements from, up to 20",
    "items": {
     "description": "Canvas course id, from elms_list_courses",
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "end_date": {
    "description": "Latest post date (default: today)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "start_date": {
    "description": "Earliest post date (default: 14 days ago)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   }
  },
  "required": [
   "course_ids"
  ],
  "type": "object"
 },
 "name": "elms_list_announcements",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "announcements": {
    "description": "Newest first",
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": [
        "string",
        "null"
       ]
      },
      "course_id": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "message": {
       "description": "Announcement body, converted from HTML to plain text; null when empty",
       "type": [
        "string",
        "null"
       ]
      },
      "posted_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      },
      "read": {
       "type": "boolean"
      },
      "reply_count": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "course_id",
      "title",
      "message",
      "posted_at",
      "author",
      "url",
      "read",
      "reply_count"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "announcements"
  ],
  "type": "object"
 },
 "title": "List ELMS announcements"
}
