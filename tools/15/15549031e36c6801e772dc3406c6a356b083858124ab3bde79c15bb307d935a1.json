{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an NFC tap scaffold with sanitized tap events, station maps, consent policy, adapter source, and tag-privacy notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "websocket_json",
    "enum": [
     "websocket_json",
     "http_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "ws://127.0.0.1:9084/nfc",
    "type": "string"
   },
   "consent_mode": {
    "default": "opt_in_required",
    "enum": [
     "opt_in_required",
     "pseudonymous",
     "aggregate_only"
    ],
    "type": "string"
   },
   "installation_label": {
    "default": "interactive_installation",
    "type": "string"
   },
   "name": {
    "default": "nfc_tap_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the NFC scaffold.",
    "type": "string"
   },
   "station_count": {
    "default": 6,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "tap_event_count": {
    "default": 24,
    "maximum": 2048,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_nfc_tap_bus",
 "title": "Connect NFC tap bus"
}
