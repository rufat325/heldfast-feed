{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update one workflow node"
 },
 "description": "Update one path on one node while preserving sibling data. workflowId selects the current workflow, nodeId selects exactly one node inside it, and path selects the mutable field whose contract validates value. Copy expectedVersionId from the latest workflow read and set acknowledgeNonAtomicRisk=true; both guards are required before the full PUT. Use n8n_workflows_update for top-level or multi-node edits. Requires write/unsafe mode plus read and update permission; returns the changed path and residual race risk.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "acknowledgeNonAtomicRisk": {
    "const": true,
    "description": "Must be true to acknowledge that n8n exposes a non-atomic full-workflow PUT.",
    "type": "boolean"
   },
   "expectedVersionId": {
    "description": "Current workflow versionId that must still match before the PUT.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "type": "string"
   },
   "nodeId": {
    "description": "Unique stable ID of the single node to update.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "type": "string"
   },
   "path": {
    "description": "Allowed dot path under a mutable node field, such as parameters.url or disabled.",
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "value": {
    "description": "Safe JSON value to write at the selected node path."
   },
   "workflowId": {
    "description": "Stable ID of the workflow containing the target node.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "type": "string"
   }
  },
  "required": [
   "workflowId",
   "nodeId",
   "path",
   "value",
   "expectedVersionId",
   "acknowledgeNonAtomicRisk"
  ],
  "type": "object"
 },
