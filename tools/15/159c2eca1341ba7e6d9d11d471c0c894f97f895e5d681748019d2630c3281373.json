{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List all users with pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "caseSensitive": {
    "default": false,
    "description": "Case sensitive search",
    "type": "boolean"
   },
   "exactMatch": {
    "default": true,
    "description": "Require exact match",
    "type": "boolean"
   },
   "firstName": {
    "description": "Filter by first name",
    "type": "string"
   },
   "index": {
    "description": "Start index (0-based)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "lastName": {
    "description": "Filter by last name",
    "type": "string"
   },
   "nValues": {
    "description": "Number of results (-1 for all)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "onlyActive": {
    "default": true,
    "description": "Only return active users",
    "type": "boolean"
   },
   "sortColumn": {
    "description": "Column to sort by",
    "type": "string"
   },
   "sortDirection": {
    "description": "Sort direction: asc or desc",
    "type": "string"
   },
   "user": {
    "description": "Username or email to search for",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "transkribus_user_list",
 "title": "List Users"
}
