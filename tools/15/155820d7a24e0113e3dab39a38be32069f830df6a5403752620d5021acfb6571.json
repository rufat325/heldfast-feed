{
 "description": "Deliver an accepted task: a note, a content hash, a URL, or any of them.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "hash": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "note": {
    "maxLength": 2000,
    "type": "string"
   },
   "task": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "url": {
    "maxLength": 512,
    "type": "string"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "ronin_deliver"
}
