{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List who has access to a calendar and their permission levels.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "calendarId": {
    "description": "Calendar ID to get sharing rules for",
    "type": "string"
   },
   "maxResults": {
    "default": 100,
    "description": "Maximum rules to return",
    "maximum": 250,
    "minimum": 1,
    "type": "number"
   },
   "pageToken": {
    "description": "Page token for pagination",
    "type": "string"
   },
   "showDeleted": {
    "default": false,
    "description": "Include deleted rules",
    "type": "boolean"
   }
  },
  "required": [
   "calendarId"
  ],
  "type": "object"
 },
 "name": "acl_list",
 "title": "List calendar sharing rules"
}
