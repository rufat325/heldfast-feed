{
 "description": "Generate pre-built page templates for common UI patterns: landing pages, dashboards, auth flows, pricing, settings, CRUD tables, blog listings, onboarding wizards, error pages, and ecommerce storefronts (PLP, PDP, cart, checkout). Supports all frameworks and component libraries.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brand_identity": {
    "description": "JSON string from branding-mcp generate_brand_identity. Overrides design context with brand tokens.",
    "type": "string"
   },
   "component_library": {
    "default": "none",
    "description": "Component library to use",
    "enum": [
     "shadcn",
     "radix",
     "headlessui",
     "primevue",
     "material",
     "none"
    ],
    "type": "string"
   },
   "dark_mode": {
    "default": false,
    "description": "Include dark mode variant classes",
    "type": "boolean"
   },
   "framework": {
    "description": "Target framework",
    "enum": [
     "react",
     "nextjs",
     "vue",
     "angular",
     "svelte",
     "html"
    ],
    "type": "string"
   },
   "industry": {
    "description": "Target industry for tailored design",
    "enum": [
     "saas",
     "fintech",
     "ecommerce",
     "healthcare",
     "education",
     "startup",
     "agency",
     "media",
     "devtools",
     "general"
    ],
    "type": "string"
   },
   "mood": {
    "description": "Design mood/personality",
    "enum": [
     "bold",
     "calm",
     "playful",
     "professional",
     "premium",
     "energetic",
     "minimal",
     "editorial",
     "futuristic",
     "warm",
     "corporate",
     "creative"
    ],
    "type": "string"
   },
   "project_name": {
    "description": "Project/app name to use in the template (defaults to \"MyApp\")",
    "type": "string"
   },
   "template": {
    "description": "Type of page template to generate",
    "enum": [
     "landing",
     "dashboard",
     "auth_login",
     "auth_signup",
     "pricing",
     "settings",
     "crud_table",
     "blog_list",
     "onboarding",
     "error_404",
     "ecommerce_plp",
     "ecommerce_pdp",
     "ecommerce_cart",
     "ecommerce_checkout",
     "ai_chat",
     "changelog",
     "team_members",
     "settings_billing",
     "api_keys",
     "analytics",
     "profile",
     "file_manager",
     "kanban",
     "calendar",
     "docs",
     "faq",
     "blog_post"
    ],
    "type": "string"
   },
   "visual_style": {
    "description": "Visual style layer to apply",
    "enum": [
     "glassmorphism",
     "neubrutalism",
     "soft-depth",
     "bento-grid",
     "gradient-mesh",
     "dark-premium",
     "minimal-editorial",
     "linear-modern",
     "retro-playful",
     "corporate-trust"
    ],
    "type": "string"
   }
  },
  "required": [
   "template",
   "framework"
  ],
  "type": "object"
 },
 "name": "generate_page_template"
}
