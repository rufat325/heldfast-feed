{
 "_meta": {
  "openai/toolInvocation/invoked": "Listings ready",
  "openai/toolInvocation/invoking": "Finding events"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find upcoming events"
 },
 "description": "Use this when the user wants upcoming concerts, sports, theatre or other live events by performer or event name, city, country, category or dates. Returns cached provider listings in date order. Each event has its TicketSea page (url) and, when a fresh exact-event seller link exists, a tickets link to that seller's page. Not live inventory, and nothing is purchased. Use nextOffset to page, and narrow the filters when scanLimited is true.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "city": {
    "description": "City the user asked about, as an exact city name (case-insensitive), such as Seattle. Location is never inferred.",
    "maxLength": 120,
    "type": "string"
   },
   "country": {
    "pattern": "^[A-Z]{2}$",
    "type": "string"
   },
   "from": {
    "format": "date",
    "type": "string"
   },
   "kind": {
    "enum": [
     "music",
     "sports",
     "theatre",
     "other"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Artist, team, event or venue text.",
    "maxLength": 120,
    "type": "string"
   },
   "to": {
    "format": "date",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "search_events",
 "outputSchema": {
  "properties": {
   "coverage": {
    "type": "string"
   },
   "events": {
    "items": {
     "properties": {
      "city": {
       "type": "string"
      },
      "country": {
       "type": "string"
      },
      "date": {
       "description": "Venue-local date; may be blank if unknown.",
       "type": "string"
      },
      "dateTime": {
       "description": "Provider absolute start timestamp when supplied.",
       "type": [
        "string",
        "null"
       ]
      },
      "inventoryVerified": {
       "const": false,
       "type": "boolean"
      },
      "listingUpdatedAt": {
       "description": "Original listing retrieval timestamp; not a stock check.",
       "type": "string"
      },
      "localTime": {
       "description": "Venue-local time; may be blank if unknown.",
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "onSale": {
       "properties": {
        "endAt": {
         "type": [
          "string",
          "null"
         ]
        },
        "startAt": {
         "type": [
          "string",
          "null"
         ]
        },
        "tbd": {
         "type": "boolean"
        }
       },
       "required": [
        "startAt",
        "endAt",
        "tbd"
       ],
       "type": "object"
      },
      "pricing": {
       "description": "Informational published ranges, not current available offers. Prices may change moment to moment and are not guaranteed. Fees and taxes may be additional. When ranges is empty, omit the price line. Never combine primary/resale sellers or currencies.",
       "properties": {
        "inventoryVerified": {
         "const": false,
         "type": "boolean"
        },
        "label": {
         "type": "string"
        },
        "notice": {
         "type": "string"
        },
        "ranges": {
         "items": {
          "properties": {
           "checkedAt": {
            "type": "string"
           },
           "currency": {
            "type": "string"
           },
           "feeInclusion": {
            "const": "unknown",
            "type": "string"
           },
           "label": {
            "type": "string"
           },
           "maxMinor": {
            "minimum": 1,
            "type": "integer"
           },
           "minMinor": {
            "minimum": 1,
            "type": "integer"
           },
           "minorUnit": {
            "maximum": 3,
            "minimum": 0,
            "type": "integer"
           },
           "provider": {
            "type": "string"
           },
           "sourceType": {
            "type": "string"
           },
           "validUntil": {
            "description": "Expiry in Unix milliseconds. Discard at this time even if cached.",
            "type": "integer"
           }
          },
          "required": [
           "provider",
           "sourceType",
           "currency",
           "minMinor",
           "maxMinor",
           "minorUnit",
           "checkedAt",
           "validUntil",
           "label",
           "feeInclusion"
          ],
          "type": "object"
         },
         "type": "array"
        }
       },
       "required": [
        "label",
        "ranges",
        "notice",
        "inventoryVerified"
       ],
       "type": "object"
      },
      "publicSaleState": {
       "description": "Schedule state, not inventory. registration means restricted registration access, not an open general sale.",
       "type": "string"
      },
      "region": {
       "type": "string"
      },
      "slug": {
       "pattern": "^[a-z0-9-]{1,240}$",
       "type": "string"
      },
      "stale": {
       "type": "boolean"
      },
      "status": {
       "type": "string"
      },
      "tickets": {
       "description": "The first exact-event seller link for this performance, present only for a fresh, upcoming listing with a known seller page. The link opens the seller's page for this event through ticketsea.com/go/. It is not an availability check, and the event can have other sellers.",
       "properties": {
        "affiliate": {
         "description": "TicketSea may earn a commission from this seller.",
         "type": "boolean"
        },
        "official": {
         "type": "boolean"
        },
        "seller": {
         "type": "string"
        },
        "type": {
         "description": "primary or resale.",
         "type": "string"
        },
        "url": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
        "url",
        "seller",
        "type",
        "official",
        "affiliate"
       ],
       "type": "object"
      },
      "timezone": {
       "description": "Provider timezone; may be blank if unknown. Do not invent one.",
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      },
      "venue": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "url",
      "name",
      "date",
      "dateTime",
      "localTime",
      "timezone",
      "venue",
      "city",
      "region",
      "country",
      "status",
      "publicSaleState",
      "onSale",
      "listingUpdatedAt",
      "stale",
      "inventoryVerified"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "hasMore": {
    "type": "boolean"
   },
   "nextOffset": {
    "maximum": 1000,
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "notice": {
    "type": "string"
   },
   "scanLimited": {
    "type": "boolean"
   },
   "sources": {
    "items": {
     "properties": {
      "available": {
       "type": "boolean"
      },
      "countrySnapshots": {
       "items": {
        "properties": {
         "country": {
          "type": "string"
         },
         "listingUpdatedAt": {
          "type": "string"
         },
         "stale": {
          "type": "boolean"
         }
        },
        "required": [
         "country",
         "listingUpdatedAt",
         "stale"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "error": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "required": [
      "source",
      "available"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "events",
   "nextOffset",
   "hasMore",
   "scanLimited",
   "sources",
   "coverage",
   "notice"
  ],
  "type": "object"
 },
 "title": "Find upcoming events"
}
