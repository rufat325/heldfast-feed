  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "name": {
    "type": "string"
   },
   "siteId": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_snapshots",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
