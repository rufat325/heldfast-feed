{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search LoggedModels by experiment with filter and pagination",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "experimentIds": {
    "description": "Experiment IDs (defaults to MLFLOW_EXPERIMENT_ID)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filter": {
    "description": "Filter expression",
    "type": "string"
   },
   "maxResults": {
    "default": 100,
    "type": "number"
   },
   "orderBy": {
    "description": "Sort spec, e.g. [{field_name: 'creation_timestamp', ascending: false}]",
    "items": {
     "properties": {
      "ascending": {
       "type": "boolean"
      },
      "field_name": {
       "type": "string"
      }
     },
     "required": [
      "field_name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pageToken": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search-logged-models"
}
