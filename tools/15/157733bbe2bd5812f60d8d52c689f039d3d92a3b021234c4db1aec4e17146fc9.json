 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "advertiser": {
    "description": "Advertiser ID",
    "type": "number"
   },
   "description": {
    "description": "Contract description",
    "type": "string"
   },
   "end_at": {
    "description": "Contract end date (YYYY-MM-DD)",
    "type": "string"
   },
   "id": {
