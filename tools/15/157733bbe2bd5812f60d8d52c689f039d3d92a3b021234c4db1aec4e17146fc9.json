    "type": "number"
   },
   "name": {
    "description": "Contract name",
    "type": "string"
   },
   "payment_due_date": {
    "description": "Payment due date (YYYY-MM-DD)",
    "type": "string"
   },
   "rate": {
    "description": "Contract rate",
    "type": "number"
   },
   "start_at": {
    "description": "Contract start date (YYYY-MM-DD)",
    "type": "string"
   },
   "status": {
    "description": "Contract status",
