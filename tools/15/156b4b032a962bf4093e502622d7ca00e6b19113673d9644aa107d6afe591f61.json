{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Find workspace files whose paths match a glob such as src/**/*.ts. Skips files ignored by .gitignore, dependency and build folders such as node_modules and dist, and secrets.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"cursor":{"default":"","maxLength":4096,"type":"string"},"limit":{"default":100,"maximum":200,"minimum":1,"type":"integer"},"pattern":{"maxLength":1000,"minLength":1,"type":"string"},"workspaceId":{"maxLength":100,"minLength":1,"pattern":"^[a-zA-Z0-9][a-zA-Z0-9._-]*$","type":"string"}},"required":["workspaceId","pattern"],"type":"object"},"name":"globFiles"}
