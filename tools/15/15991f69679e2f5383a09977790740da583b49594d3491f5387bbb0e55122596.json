{
 "description": "Return a single COSO principle by framework number or slug, including its paraphrased points of focus.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "type": "string"
   },
   "number": {
    "maximum": 17,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_principle",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "found": {
    "type": "boolean"
   },
   "principle": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "component": {
        "enum": [
         "control-environment",
         "risk-assessment",
         "control-activities",
         "information-communication",
         "monitoring-activities"
        ],
        "type": "string"
       },
       "id": {
        "type": "string"
       },
       "number": {
        "type": "number"
       },
       "pointsOfFocus": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "id": {
           "type": "string"
          },
          "summary": {
           "type": "string"
          }
         },
         "required": [
          "id",
          "summary"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "statement": {
        "type": "string"
       }
      },
      "required": [
       "number",
       "id",
       "component",
       "statement",
       "pointsOfFocus"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "found",
   "principle"
  ],
  "type": "object"
 },
 "title": "Get a COSO principle"
}
