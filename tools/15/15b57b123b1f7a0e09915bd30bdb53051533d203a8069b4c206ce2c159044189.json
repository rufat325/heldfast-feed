     },
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "Primary series (array), or a keyed object for charts that take one; omit for scalar charts."
   },
   "format": {
    "description": "`svg` (default) or `bare`.",
    "enum": [
     "svg",
     "bare"
    ],
    "type": "string"
   },
