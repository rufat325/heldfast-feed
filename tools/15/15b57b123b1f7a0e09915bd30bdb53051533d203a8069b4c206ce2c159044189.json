    "additionalProperties": {},
    "description": "Other props (value, target, color, \u2026).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "type": {
    "description": "Chart slug, e.g. \"sparkline\".",
    "type": "string"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
 "name": "render_microchart",
