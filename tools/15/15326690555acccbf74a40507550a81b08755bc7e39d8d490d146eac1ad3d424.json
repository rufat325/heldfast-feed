{
 "_meta": {
  "openai/fileParams": [
   "files"
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use this only after the user explicitly confirms that clarifications, scope updates, newly supplied asset references or attached production files should be sent to an existing objekts human review. When ChatGPT already has a requested file, pass it through the files field rather than creating a second upload. Do not use it to change a brief that exists only in the current conversation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addedAssetIds": {
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "answers": {
    "additionalProperties": {
     "maxLength": 4000,
     "type": "string"
    },
    "propertyNames": {
     "maxLength": 200,
     "type": "string"
    },
    "type": "object"
   },
   "briefPatch": {
    "additionalProperties": {},
    "propertyNames": {
     "maxLength": 200,
     "type": "string"
    },
    "type": "object"
   },
   "confirmed": {
    "const": true,
    "type": "boolean"
   },
   "files": {
    "items": {
     "properties": {
      "download_url": {
       "maxLength": 4096,
       "type": "string"
      },
      "file_id": {
       "maxLength": 512,
       "type": "string"
      },
      "file_name": {
       "maxLength": 255,
       "type": "string"
      },
      "mime_type": {
       "maxLength": 200,
       "type": "string"
      }
     },
     "required": [
      "download_url",
      "file_id"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "submissionId": {
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "confirmed",
   "submissionId"
  ],
  "type": "object"
 },
 "name": "update_production_brief",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "humanEstimate": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "message": {
    "type": [
     "string",
     "null"
    ]
   },
   "questions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "RECEIVED",
     "REVIEWING",
     "NEED_INFO",
     "HUMAN_ESTIMATE_READY",
     "CALL_PROPOSED",
     "WON",
     "LOST",
     "CLOSED",
     "DELETED"
    ],
    "type": "string"
   },
   "submissionId": {
    "type": "string"
   }
  },
  "required": [
   "submissionId",
   "status",
   "questions"
  ],
  "type": "object"
 },
 "title": "Update submitted production brief"
}
