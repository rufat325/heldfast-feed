{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "appskyline:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search an app store"
 },
 "description": "Use this when someone asks which apps show up for a search term, or who their competitors are for a keyword, on the App Store, Mac App Store, Google Play or Microsoft Store. Returns the live results in rank order with store id, title, rating and developer (10 by default, up to 200). Not for one app's own position.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "Two-letter store country code such as US or IT; defaults to US",
    "maxLength": 10,
    "type": "string"
   },
   "lang": {
    "description": "Two-letter language code such as en or it; defaults to en except on Google Play, which uses the store default",
    "maxLength": 32,
    "type": "string"
   },
   "num": {
    "description": "Number of results to return, from 1 to 200; defaults to 10",
    "exclusiveMinimum": 0,
    "maximum": 200,
    "type": "integer"
   },
   "store": {
    "description": "Store to search: ios-app-store, macos-app-store, google-play or microsoft-store",
    "enum": [
     "ios-app-store",
     "macos-app-store",
     "google-play",
     "microsoft-store"
    ],
    "type": "string"
   },
   "term": {
    "description": "Search term as a user would type it in the store, 1 to 200 characters",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "store",
   "term"
  ],
  "type": "object"
 },
 "name": "search_store_results",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "anyOf": [
     {
      "maxLength": 10,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "lang": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "results": {
    "description": "Live search results in store rank order; nothing is stored in AppSkyline",
    "items": {
     "additionalProperties": false,
     "properties": {
      "developer": {
       "$ref": "#/properties/results/items/properties/id"
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "rank": {
       "exclusiveMinimum": 0,
       "maximum": 200,
       "type": "integer"
      },
      "score": {
       "anyOf": [
        {
         "maximum": 1000000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Rating score as the store reports it"
      },
      "title": {
       "$ref": "#/properties/results/items/properties/id"
      }
     },
     "required": [
      "rank",
      "id",
      "title",
      "score",
      "developer"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "type": "array"
   },
   "status": {
    "enum": [
     "found",
     "empty"
    ],
    "type": "string"
   },
   "store": {
    "enum": [
     "ios-app-store",
     "macos-app-store",
     "google-play",
     "microsoft-store"
    ],
    "type": "string"
   },
   "term": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "truncated": {
    "description": "True when the store returned more than 200 results",
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "store",
   "term",
   "country",
   "lang",
   "results",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Search an app store"
}
