{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Run Loop Maker"
 },
 "description": "Make walking/running loops that start and end at one point, each within 3% of the target distance. Returns Google Maps links and an encoded polyline. Routes and map data \u00a9 OpenStreetMap contributors (ODbL); routing and elevation: Valhalla on FOSSGIS servers. (API Tool Calls, by Cowerx)",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "default": 3,
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "direction": {
    "default": "any",
    "enum": [
     "any",
     "n",
     "e",
     "s",
     "w"
    ],
    "type": "string"
   },
   "distance_km": {
    "maximum": 42.2,
    "minimum": 1,
    "type": "number"
   },
   "prefer": {
    "default": [],
    "items": {
     "enum": [
      "quiet",
      "trails",
      "flat"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array",
    "uniqueItems": true
   },
   "start": {
    "oneOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "lat": {
        "maximum": 90,
        "minimum": -90,
        "type": "number"
       },
       "lon": {
        "maximum": 180,
        "minimum": -180,
        "type": "number"
       }
      },
      "required": [
       "lat",
       "lon"
      ],
      "type": "object"
     }
    ]
   },
   "stops": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "lat": {
       "maximum": 90,
       "minimum": -90,
       "type": "number"
      },
      "lon": {
       "maximum": 180,
       "minimum": -180,
       "type": "number"
      }
     },
     "required": [
      "lat",
      "lon"
     ],
     "type": "object"
    },
    "maxItems": 9,
    "minItems": 1,
    "type": "array"
   },
   "via": {
    "oneOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "lat": {
        "maximum": 90,
        "minimum": -90,
        "type": "number"
       },
       "lon": {
        "maximum": 180,
        "minimum": -180,
        "type": "number"
       }
      },
      "required": [
       "lat",
       "lon"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "start",
   "distance_km"
  ],
  "type": "object"
 },
 "name": "make_run_loop",
 "title": "Run Loop Maker"
}
