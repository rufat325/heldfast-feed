{
 "description": "Archive a project flow, stopping new capture while retaining aggregate reports. Owner/admin only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "flowKey": {
    "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
    "type": "string"
   },
   "projectId": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "flowKey"
  ],
  "type": "object"
 },
 "name": "archive_analytics_flow"
}
