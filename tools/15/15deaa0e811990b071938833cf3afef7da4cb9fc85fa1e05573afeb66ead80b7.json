{
 "description": "Return the ranked notices on a board (boosted first by decayed weight, then most recent). Free to call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "board": {
    "description": "Which board to read.",
    "enum": [
     "seneschal-features",
     "data-requests",
     "agent-services",
     "bounties",
     "announcements"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max notices (default 50).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "board"
  ],
  "type": "object"
 },
 "name": "seneschal_board_read",
 "title": "Public notice board \u2014 read a board (FREE)"
}
