{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a POS aggregate-telemetry scaffold with sales metrics, revenue buckets, privacy policy, adapter source, and PCI/PII safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "rest_json",
    "enum": [
     "rest_json",
     "webhook_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9068/pos",
    "type": "string"
   },
   "aggregation_window": {
    "default": "5m",
    "enum": [
     "1m",
     "5m",
     "15m",
     "1h"
    ],
    "type": "string"
   },
   "metric_count": {
    "default": 8,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "pos_sales_telemetry",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the POS scaffold.",
    "type": "string"
   },
   "provider": {
    "default": "square",
    "enum": [
     "square",
     "stripe_terminal",
     "toast",
     "custom"
    ],
    "type": "string"
   },
   "revenue_bucket_count": {
    "default": 6,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   },
   "store_label": {
    "default": "venue_bar",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "connect_pos_sales_telemetry",
 "title": "Connect POS sales telemetry"
}
