{
 "description": "Get recent competitive signals \u2014 product launches, hiring moves, market events. Filter by company, type, or urgency.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "company": {
    "description": "Filter by company name",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max signals to return",
    "type": "number"
   },
   "type": {
    "description": "Signal type",
    "enum": [
     "product",
     "hiring",
     "market"
    ],
    "type": "string"
   },
   "urgency": {
    "description": "Urgency level",
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "vertical": {
    "default": "fintech-payments",
    "description": "Industry vertical to query",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_signals"
}
