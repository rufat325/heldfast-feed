{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Request a service at a time. Check availability first. A fixed-price service costs the business's price from list_services; a different totalPrice you send is only noted for the business. A priced booking binds your person only once they confirmed it: without terms_sha nothing is sent, and you get the summary to show them (confirm.summary, confirm.terms_sha); call again with that terms_sha on their clear yes. Returns the item and, if you have no account, an access_token.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contact": {
    "properties": {
     "email": {
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "locale": {
      "maxLength": 12,
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "type": "string"
     }
    },
    "type": "object"
   },
   "idempotency_key": {
    "description": "Same key + same request = same answer. Required for agents.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "key": {
    "description": "The person's key (sdkey1_\u2026), if that is all you have: it is exchanged once for a pass, which comes back in identity.passes \u2014 keep the pass and send it next time instead. Never stored.",
    "maxLength": 200,
    "type": "string"
   },
   "message": {
    "maxLength": 20000,
    "type": "string"
   },
   "pass": {
    "description": "The person's passes (sdpass1_\u2026), space-separated, at most 8: presented to the network that issued each, so the business recognises the customer. Or send them in the Sdi-Pass header. Never stored.",
    "maxLength": 1608,
    "type": "string"
   },
   "payload": {
    "properties": {
     "endTime": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     "notes": {
      "maxLength": 5000,
      "type": "string"
     },
     "partySize": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
     },
     "personalised": {
      "properties": {
       "listPrice": {
        "properties": {
         "currency": {
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
         },
         "value": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "value",
         "currency"
        ],
        "type": "object"
       },
       "says": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "required": [
       "listPrice"
      ],
      "type": "object"
     },
     "reservationFor": {
      "properties": {
       "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "serviceId": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "serviceId",
       "name"
      ],
      "type": "object"
     },
     "resourceId": {
      "type": "string"
     },
     "startTime": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     "totalPrice": {
      "properties": {
       "currency": {
        "maxLength": 3,
        "minLength": 3,
        "type": "string"
       },
       "value": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "value",
       "currency"
      ],
      "type": "object"
     }
    },
    "required": [
     "reservationFor",
     "startTime",
     "endTime"
    ],
    "type": "object"
   },
   "terms_sha": {
    "description": "The fingerprint of the terms your person confirmed (details.terms_sha of the 409 confirm_terms a priced request without it gets). Nothing is sent to the business without it when the request carries a price.",
    "pattern": "^[A-Za-z0-9_-]{43}$",
    "type": "string"
   }
  },
  "required": [
   "payload"
  ],
  "type": "object"
 },
 "name": "create_booking",
 "title": "Request a booking"
}
