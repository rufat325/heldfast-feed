{"description":"Generate cryptographically-random password(s) (keyless, offline, CSPRNG). Control the character sets and length; returns the password(s) and their entropy in bits.","inputSchema":{"properties":{"count":{"description":"How many to generate (1-50, default 1).","type":"number"},"digits":{"description":"Include 0-9 (default true).","type":"boolean"},"exclude_ambiguous":{"description":"Exclude look-alikes (0/O, 1/l/I) (default false).","type":"boolean"},"length":{"description":"Password length (4-256, default 20).","type":"number"},"lowercase":{"description":"Include a-z (default true).","type":"boolean"},"symbols":{"description":"Include punctuation (default true).","type":"boolean"},"uppercase":{"description":"Include A-Z (default true).","type":"boolean"}},"type":"object"},"name":"generate_password"}
