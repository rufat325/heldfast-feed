  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Return dated Wikipedia article links ranked by official daily pageviews, with namespace filtering and original rank/view counts. FREE during validation. No key, credits, wallet or preparation needed. Supply your task in input. Existing source and input limits apply.",
