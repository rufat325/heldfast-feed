       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "views": {
       "type": "number"
      }
     },
     "required": [
      "title",
      "url",
      "rank",
      "views"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "language": {
    "type": "string"
   },
   "namespaceFilter": {
    "additionalProperties": false,
    "properties": {
     "mainPage": {
      "type": "string"
     },
     "retrievedAt": {
      "type": "string"
     },
     "sourceUrl": {
      "type": "string"
     }
    },
    "required": [
     "sourceUrl",
     "retrievedAt",
     "mainPage"
    ],
    "type": "object"
   },
   "ranking": {
    "type": "string"
   },
   "retrievedAt": {
    "type": "string"
   },
   "sourceUrl": {
    "type": "string"
   }
  },
