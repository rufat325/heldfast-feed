     "date": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "language": {
      "default": "en",
      "enum": [
       "en",
       "es",
       "de",
       "fr",
       "it",
       "pt",
       "ja",
       "zh",
       "ru",
       "ar"
      ],
      "type": "string"
     },
     "limit": {
      "default": 25,
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "date"
    ],
    "type": "object"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "web_wikipedia_popular",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "availableEntries": {
    "type": "number"
   },
   "date": {
    "type": "string"
   },
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
