{
 "description": "Get statistics about job seekers in New Caledonia by various criteria",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "group_by": {
    "default": "province",
    "description": "How to group results",
    "enum": [
     "province",
     "age_class",
     "diplome",
     "metier_recherche"
    ],
    "type": "string"
   },
   "province": {
    "description": "Filter by province",
    "enum": [
     "Sud",
     "Nord",
     "Iles"
    ],
    "type": "string"
   },
   "year": {
    "description": "Year to query",
    "maximum": 2030,
    "minimum": 2004,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "nc_get_job_seeker_stats"
}
