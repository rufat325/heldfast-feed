{
 "_meta": {
  "openai/outputTemplate": "ui://soclo/chat-ads/v2.html",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "generate:video"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://soclo/chat-ads/v2.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Export an editor project"
 },
 "description": "Export the exact render job against its acknowledged expectedRevision, with timed captions, overlays and owned Library audioTracks, under a stable UUID clientRequestId. Ordinary editor export is free; this does not start Film Desk or a paid creative-v4 film. Read soclo_editor_export_status with the original clientRequestId after transport loss and until finished; do not resubmit.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "clientRequestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "expectedRevision": {
    "pattern": "^[1-9][0-9]{0,9}$",
    "type": "string"
   },
   "job": {
    "properties": {
     "audioTracks": {
      "items": {
       "properties": {
        "atMs": {
         "minimum": 0,
         "type": "number"
        },
        "uri": {
         "minLength": 1,
         "type": "string"
        },
        "volume": {
         "type": "number"
        }
       },
       "required": [
        "uri",
        "atMs"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "bitrate": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "clips": {
      "items": {
       "properties": {
        "filterMatrix": {
         "items": {
          "type": "number"
         },
         "type": "array"
        },
        "inMs": {
         "minimum": 0,
         "type": "number"
        },
        "isImage": {
         "type": "boolean"
        },
        "join": {
         "anyOf": [
          {
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "outMs": {
         "minimum": 0,
         "type": "number"
        },
        "transform": {
         "type": "object"
        },
        "uri": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "uri",
        "inMs",
        "outMs"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "format": {
      "const": "mp4",
      "type": "string"
     },
     "fps": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "height": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "overlays": {
      "items": {
       "properties": {
        "atMs": {
         "minimum": 0,
         "type": "number"
        },
        "color": {
         "type": "string"
        },
        "durMs": {
         "minimum": 0,
         "type": "number"
        },
        "fontFamily": {
         "type": "string"
        },
        "kind": {
         "enum": [
          "text",
          "image"
         ],
         "type": "string"
        },
        "sizePt": {
         "type": "number"
        },
        "text": {
         "type": "string"
        },
        "uri": {
         "type": "string"
        },
        "widthN": {
         "type": "number"
        },
        "xN": {
         "type": "number"
        },
        "yN": {
         "type": "number"
        }
       },
       "required": [
        "kind",
        "atMs",
        "durMs"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "width": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "clips",
     "width",
     "height"
    ],
    "type": "object"
   },
   "projectId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "targetId": {
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "clientRequestId",
   "expectedRevision",
   "job",
   "targetId"
  ],
  "type": "object"
 },
 "name": "soclo_editor_export",
 "title": "Export an editor project"
}
