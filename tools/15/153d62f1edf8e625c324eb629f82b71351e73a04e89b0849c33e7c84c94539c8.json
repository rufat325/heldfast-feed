{
 "description": "Get AI-suggested assets from the brand library that match a given post context or topic.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brandId": {
    "description": "Brand ID (defaults to active brand)",
    "type": "string"
   },
   "context": {
    "description": "Post content or topic to find matching assets for",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "context"
  ],
  "type": "object"
 },
 "name": "suggest_assets_for_post"
}
