    "type": "string"
   },
   "dry_run": {
    "description": "When true, returns dry_run_unsupported without executing; this tool cannot be rehearsed.",
    "type": "boolean"
   },
   "fighter_key": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
