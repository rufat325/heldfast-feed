 "description": "Check whether datasets that are meant to be disjoint share any keys. A key in both a training and an evaluation split means the evaluation is measuring memorisation, and every figure computed from it is optimistic. Reports overlap per pair with the share of the smaller set, since that is the one whose measurements are compromised, plus keys appearing in every dataset. Pay 160000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "datasets": {
    "description": "Named datasets. Each name must be distinct, or a finding cannot be attributed to one of them.",
    "example": [
     {
      "csv": "customer_id,label\nC-001,1\nC-002,0\nC-003,1\nC-004,0\n",
      "name": "train"
     },
     {
      "csv": "customer_id,label\nC-003,1\nC-005,0\n",
      "name": "evaluation"
     },
     {
      "csv": "customer_id,label\nC-006,1\n",
      "name": "holdout"
     }
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "csv": {
       "description": "One dataset. Delimited text with a header row, at most 262144 bytes and 5000 data rows. RFC 4180 quoting is honoured. Nothing is fetched.",
       "maxLength": 262144,
       "type": "string"
      },
      "name": {
       "maxLength": 64,
       "type": "string"
      }
     },
     "required": [
      "name",
      "csv"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "delimiter": {
    "description": "Single field separator. Defaults to a comma.",
    "maxLength": 1,
    "minLength": 1,
    "type": "string"
   },
   "expect_disjoint": {
    "description": "Whether any overlap is a finding. Defaults to true. Set false to measure overlap without judging it.",
    "type": "boolean"
   },
   "key": {
    "description": "The columns identifying a record in every dataset. A composite key is supported. Values are canonicalised exactly, so 42 and 42.0 are the same key and a large identifier is compared as text rather than collapsed.",
    "example": [
     "customer_id"
    ],
    "items": {
     "maxLength": 256,
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "datasets",
   "key"
  ],
  "type": "object"
 },
 "name": "dataset_overlap_audit",
