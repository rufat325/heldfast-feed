{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List videos. Use this tool to list videos.",
 "inputSchema": {
  "properties": {
   "category_id": {
    "description": "Category of the video",
    "type": "string"
   },
   "chart": {
    "description": "chartUnspecified|mostPopular",
    "enum": [
     "chartUnspecified",
     "mostPopular"
    ],
    "type": "string"
   },
   "hl": {
    "description": "Specifies the localization language",
    "type": "string"
   },
   "ids": {
    "description": "Return videos with the given ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "locale": {
    "description": "Locale of the video metadata to return",
    "type": "string"
   },
   "max_height": {
    "description": "Max height of the embedded player in pixels",
    "minimum": 0,
    "type": "number"
   },
   "max_results": {
    "default": 5,
    "description": "The maximum number of items that should be returned, 0 for no limit",
    "minimum": 0,
    "type": "number"
   },
   "max_width": {
    "description": "Max width of the embedded player in pixels",
    "minimum": 0,
    "type": "number"
   },
   "on_behalf_of_content_owner": {
    "description": "ID of the content owner, for YouTube content partners",
    "type": "string"
   },
   "output": {
    "default": "json",
    "description": "json|yaml|table",
    "enum": [
     "json",
     "yaml",
     "table"
    ],
    "type": "string"
   },
   "parts": {
    "default": [
     "id",
     "snippet",
     "status",
     "statistics"
    ],
    "description": "Comma separated parts",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rating": {
    "description": "Return videos liked/disliked by the authenticated user",
    "type": "string"
   },
   "region_code": {
    "description": "Specific to the specified region",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "video-list",
 "title": "List videos"
}
