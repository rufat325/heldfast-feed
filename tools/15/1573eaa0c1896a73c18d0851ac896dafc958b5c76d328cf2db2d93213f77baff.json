{
 "annotations": {},
 "description": "Pre-check whether a CDSS Kafka version upgrade can proceed",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "serviceGroupInstanceNo": {
    "description": "Cluster instance number",
    "type": "string"
   },
   "upgradeConfigGroupNo": {
    "description": "Config group number for the target version",
    "type": "number"
   },
   "upgradeKafkaVersionCode": {
    "description": "Target Kafka version code (from ncloud_cdss_get_kafka_versions)",
    "type": "number"
   }
  },
  "required": [
   "serviceGroupInstanceNo",
   "upgradeKafkaVersionCode",
   "upgradeConfigGroupNo"
  ],
  "type": "object"
 },
 "name": "ncloud_cdss_upgrade_precheck"
}
