{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "cherami_mail:full"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List inbox labels"
 },
 "description": "Find labels used in an inbox, alphabetically, with message counts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Continue with next_cursor from the previous result, keeping the same filters. Stop when next_cursor is null.",
    "maxLength": 1024,
    "type": "string"
   },
   "inbox_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "prefix": {
    "description": "Filter by a literal, case-sensitive label prefix.",
    "type": "string"
   }
  },
  "required": [
   "inbox_id"
  ],
  "type": "object"
 },
 "name": "list_labels",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "labels": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "received_count": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "sent_count": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "name",
      "received_count",
      "sent_count"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "labels",
   "next_cursor"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "cherami_mail:full"
   ],
   "type": "oauth2"
  }
 ],
 "title": "List inbox labels"
}
