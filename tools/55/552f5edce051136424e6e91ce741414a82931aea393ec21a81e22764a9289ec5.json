{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Delete a voiceover line"
 },
 "description": "Use this when someone wants one voiceover line permanently deleted with its audio. Returns the deleted line id; the audio and timing files are erased, so restoring it means synthesizing again, which spends credits. Deleting it again changes nothing. Not for changing its words.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "speechId": {
    "description": "Voiceover line to delete",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "speechId"
  ],
  "type": "object"
 },
 "name": "delete_speech",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "speechId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "const": "deleted",
    "type": "string"
   }
  },
  "required": [
   "status",
   "speechId"
  ],
  "type": "object"
 },
 "title": "Delete a voiceover line"
}
