{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use this when someone wants the same parts again from an earlier 3D Printer on Demand order. It takes the private order link from their order email, works out a new estimate for each part from the files saved with that order, and returns a private link to review the parts and order them on our website. It takes no payment and does not change the earlier order.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "order_link": {
    "description": "The private order link from the order confirmation or shipping email.",
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "order_link"
  ],
  "type": "object"
 },
 "name": "reorder_from_order",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "type": "string"
   },
   "needs_review": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_step": {
    "type": "string"
   },
   "order_number": {
    "type": "string"
   },
   "outcome": {
    "enum": [
     "ready",
     "needs_review",
     "not_found",
     "invalid_link",
     "try_later",
     "unavailable"
    ],
    "type": "string"
   },
   "parts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "changed_since_order": {
       "type": "boolean"
      },
      "earlier_price_per_part_usd": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "price_per_part_usd": {
       "type": "number"
      },
      "quantity": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "quantity",
      "price_per_part_usd",
      "changed_since_order"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "reorder_url": {
    "type": "string"
   },
   "review_url": {
    "type": "string"
   }
  },
  "required": [
   "outcome",
   "message"
  ],
  "type": "object"
 },
 "title": "Reorder parts from an earlier order"
}
