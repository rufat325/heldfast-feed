{
 "description": "Fetch a note progressively: outline (headings) | frontmatter_only | full, with an optional max_tokens ceiling.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "enum": [
     "outline",
     "frontmatter_only",
     "full"
    ],
    "type": "string"
   },
   "max_tokens": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "note_id": {
    "type": "string"
   }
  },
  "required": [
   "note_id"
  ],
  "type": "object"
 },
 "name": "get_note"
}
