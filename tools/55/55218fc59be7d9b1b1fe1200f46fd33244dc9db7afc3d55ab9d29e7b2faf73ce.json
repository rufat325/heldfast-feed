{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Retrieve cited passages"
 },
 "description": "Look up cited passages from public Koskamo datasets so an agent can answer from facts instead of guessing.",
 "inputSchema": {
  "properties": {
   "dataset": {
    "description": "Optional dataset id or slug. Defaults to all public datasets.",
    "type": "string"
   },
   "query": {
    "description": "The question or search string",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "top_k": {
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "koskamo_retrieve",
 "outputSchema": {
  "properties": {
   "passages": {
    "items": {
     "properties": {
      "chunkId": {
       "description": "Chunk uuid for database-backed datasets; dataset:document:ordinal for the bundled catalog",
       "type": "string"
      },
      "createdAt": {
       "description": "Document creation timestamp",
       "format": "date-time",
       "type": "string"
      },
      "datasetId": {
       "type": "string"
      },
      "datasetName": {
       "type": "string"
      },
      "datasetSlug": {
       "type": "string"
      },
      "datasetVersion": {
       "description": "Dataset version at retrieval time; cite this",
       "type": "integer"
      },
      "documentId": {
       "type": "string"
      },
      "documentTitle": {
       "type": "string"
      },
      "documentVersion": {
       "description": "Document content version; increments when an approved revision replaces the document",
       "type": "integer"
      },
      "ordinal": {
       "description": "Chunk position inside the source document",
       "type": "integer"
      },
      "score": {
       "description": "Ranking score within the retrieval engine; not a confidence probability",
       "type": "number"
      },
      "sourceUrl": {
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "version": {
       "description": "Alias of datasetVersion kept for existing citers",
       "type": "integer"
      }
     },
     "required": [
      "text",
      "score",
      "datasetId",
      "datasetSlug",
      "datasetName",
      "datasetVersion",
      "documentId",
      "documentTitle",
      "documentVersion",
      "sourceUrl",
      "chunkId",
      "ordinal",
      "version",
      "createdAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   }
  },
  "required": [
   "query",
   "passages"
  ],
  "type": "object"
 },
 "title": "Retrieve cited passages"
}
