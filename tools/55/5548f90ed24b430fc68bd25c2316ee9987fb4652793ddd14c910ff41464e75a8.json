{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Edit Order Payment"
 },
 "description": "Edit an existing order payment (amount/status/paid_at). Returns {success}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Updated amount",
    "type": "number"
   },
   "by": {
    "default": "id",
    "description": "Lookup field",
    "enum": [
     "id",
     "externalId"
    ],
    "type": "string"
   },
   "id": {
    "description": "Payment ID (or externalId) to edit",
    "type": "string"
   },
   "paid_at": {
    "description": "Updated paid timestamp 'YYYY-MM-DD HH:MM:SS'",
    "type": "string"
   },
   "site": {
    "description": "Site (store) symbolic code. Required on create/edit when the API key is scoped to multiple sites (see list_sites).",
    "type": "string"
   },
   "status": {
    "description": "Updated payment status code",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "order_payment_edit"
}
