{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Set a channel watermark. Use this tool to set a channel watermark.",
 "inputSchema": {
  "properties": {
   "channel_id": {
    "description": "ID of the channel",
    "type": "string"
   },
   "duration_ms": {
    "description": "Duration in milliseconds for which the watermark should be displayed",
    "minimum": 0,
    "type": "number"
   },
   "file": {
    "description": "Path to the watermark file",
    "type": "string"
   },
   "in_video_position": {
    "description": "topLeft|topRight|bottomLeft|bottomRight",
    "enum": [
     "topLeft",
     "topRight",
     "bottomLeft",
     "bottomRight"
    ],
    "type": "string"
   },
   "offset_ms": {
    "description": "Defines the time at which the watermark will appear",
    "minimum": 0,
    "type": "number"
   },
   "offset_type": {
    "description": "offsetFromStart|offsetFromEnd",
    "enum": [
     "offsetFromStart",
     "offsetFromEnd"
    ],
    "type": "string"
   },
   "on_behalf_of_content_owner": {
    "description": "ID of the content owner, for YouTube content partners",
    "type": "string"
   }
  },
  "required": [
   "channel_id",
   "file"
  ],
  "type": "object"
 },
 "name": "watermark-set",
 "title": "Set a channel watermark"
}
