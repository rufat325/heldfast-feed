{
 "_meta": {
  "openai/outputTemplate": "ui://hairdora/salon-overview-v1.html",
  "openai/toolInvocation/invoked": "HairDora salon overview ready.",
  "openai/toolInvocation/invoking": "Loading HairDora salon\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "hairdora:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://hairdora/salon-overview-v1.html"
  },
  "ui/resourceUri": "ui://hairdora/salon-overview-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show salon overview"
 },
 "description": "Use this when someone wants a quick overview or dashboard of one hair salon. Returns an overview card with the salon's details, a client count, the next 8 upcoming appointments with time, status and number of services, and up to 12 services with prices (no client names or contact details). Not for one specific booking.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "salonId": {
    "description": "Id of one of the user's salons, as the salon list returns it (24 lowercase hex characters)",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "salonId"
  ],
  "type": "object"
 },
 "name": "show_salon_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "appointmentCount": {
    "maximum": 8,
    "minimum": 0,
    "type": "integer"
   },
   "appointmentCountIsLowerBound": {
    "type": "boolean"
   },
   "appointments": {
    "description": "The next upcoming appointments, earliest first",
    "items": {
     "additionalProperties": false,
     "properties": {
      "serviceCount": {
       "maximum": 10000,
       "minimum": 0,
       "type": "integer"
      },
      "startTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "anyOf": [
        {
         "enum": [
          "SCHEDULED",
          "CLIENT_ARRIVED",
          "NO_SHOW",
          "CANCELED"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "startTime",
      "status",
      "serviceCount"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "type": "array"
   },
   "clientCount": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "clientCountIsLowerBound": {
    "type": "boolean"
   },
   "salon": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "currency": {
        "anyOf": [
         {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 16,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "pattern": "^[0-9a-f]{24}$",
        "type": "string"
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       },
       "timezone": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "currency",
       "defaultLocale",
       "timezone"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Salon metadata; null when not found. The overview excludes client names, contact details, client and appointment ids, notes, organization data, staff ids, payment data and service history."
   },
   "serviceCount": {
    "maximum": 12,
    "minimum": 0,
    "type": "integer"
   },
   "serviceCountIsLowerBound": {
    "type": "boolean"
   },
   "services": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "maxLength": 200,
       "type": "string"
      },
      "price": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "price"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   }
  },
  "required": [
   "salon",
   "clientCount",
   "clientCountIsLowerBound",
   "appointmentCount",
   "appointmentCountIsLowerBound",
   "serviceCount",
   "serviceCountIsLowerBound",
   "services",
   "appointments"
  ],
  "type": "object"
 },
 "title": "Show salon overview"
}
