   "limit": {
    "description": "Max results, 1-20, default 5",
    "type": "number"
   },
   "slug": {
    "description": "Slug of the product to find alternatives to",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "find_alternatives",
 "outputSchema": {
  "properties": {
   "products": {
    "items": {
