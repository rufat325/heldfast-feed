{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find alternatives"
 },
 "description": "Live FastDrop products similar to a given one, ranked by shared tags, overlapping probed MCP tool capabilities, and pricing model. Each result says why it matched.",
