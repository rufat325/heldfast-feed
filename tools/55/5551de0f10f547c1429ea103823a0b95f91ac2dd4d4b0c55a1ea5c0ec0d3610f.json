  "properties": {
   "account": {
    "description": "\u0410\u043a\u043a\u0430\u0443\u043d\u0442-\u043f\u0440\u043e\u0444\u0438\u043b\u044c (\u043c\u0443\u043b\u044c\u0442\u0438\u0430\u043a\u043a\u0430\u0443\u043d\u0442, \u0441\u043c. *_auth_status); \u043f\u0443\u0441\u0442\u043e = \u043e\u0441\u043d\u043e\u0432\u043d\u043e\u0439",
    "type": "string"
   },
   "country": {
    "description": "\u0421\u0442\u0440\u0430\u043d\u0430 \u0432\u044b\u0434\u0430\u0447\u0438 Google (\u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438): ISO-\u043a\u043e\u0434 (\u00abRU\u00bb, \u00abUS\u00bb) \u0438\u043b\u0438 \u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0439 id XMLRiver (\u00ab2643\u00bb). \u0411\u0435\u0437 location \u2014 \u0437\u0430\u0434\u0430\u0451\u0442 \u0441\u0442\u0440\u0430\u043d\u0443 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e; \u0441 location \u2014 \u043f\u0435\u0440\u0435\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0430\u0432\u0442\u043e\u0432\u044b\u0432\u0435\u0434\u0435\u043d\u043d\u0443\u044e \u0438\u0437 \u0433\u043e\u0440\u043e\u0434\u0430",
    "minLength": 1,
    "type": "string"
   },
   "location": {
    "description": "\u041b\u043e\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u0432\u044b\u0434\u0430\u0447\u0430 Google \u043f\u043e \u0433\u043e\u0440\u043e\u0434\u0443 (\u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043a\u0438): \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043d\u0430 \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u043c (\u00abMoscow\u00bb, \u00abSaint Petersburg\u00bb) \u0438\u043b\u0438 \u0447\u0438\u0441\u043b\u043e\u0432\u043e\u0439 Google criteria ID (\u00ab1011969\u00bb). \u0420\u0435\u0437\u043e\u043b\u0432\u0438\u0442\u0441\u044f \u0432 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440 loc; \u043f\u0440\u0438 \u043f\u0435\u0440\u0432\u043e\u043c \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u0438 \u0441\u043a\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u043e\u0447\u043d\u0438\u043a geo.csv XMLRiver (~5 \u041c\u0411, \u043a\u044d\u0448 \u043d\u0430 \u0434\u0438\u0441\u043a\u0435 7 \u0434\u043d\u0435\u0439). \u0421\u0442\u0440\u0430\u043d\u0430 \u0432\u044b\u0432\u043e\u0434\u0438\u0442\u0441\u044f \u0438\u0437 \u0433\u043e\u0440\u043e\u0434\u0430 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438",
    "minLength": 1,
    "type": "string"
   },
   "phrases": {
    "description": "\u0424\u0440\u0430\u0437\u044b \u0434\u043b\u044f \u0441\u0431\u043e\u0440\u0430 \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043e\u043a (1\u201350; \u041f\u041b\u0410\u0422\u041d\u041e \u0437\u0430 \u043a\u0430\u0436\u0434\u0443\u044e: N \u0444\u0440\u0430\u0437 = N \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0439)",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "region": {
    "description": "\u00ab\u041c\u043e\u0441\u043a\u0432\u0430\u00bb/\u00ab\u0420\u043e\u0441\u0441\u0438\u044f\u00bb/213/225 \u2014 \u041e\u0414\u0418\u041d \u0440\u0435\u0433\u0438\u043e\u043d \u043f\u043e\u0434\u0441\u043a\u0430\u0437\u043e\u043a (\u043d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0438\u043b\u0438 id \u042f\u043d\u0434\u0435\u043a\u0441\u0430, lr); \u0431\u0435\u0437 \u043d\u0435\u0433\u043e \u2014 \u0431\u0435\u0437 \u0433\u0435\u043e",
    "type": "string"
