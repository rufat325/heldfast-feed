{
 "_meta": {
  "growsurf/riskTier": "READ"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Embeddable Element Snippet"
 },
 "description": "Generate the HTML snippet for a GrowSurf embeddable element (with optional auth attributes).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "element": {
    "enum": [
     "form",
     "invite",
     "rewards",
     "referral_status",
     "referral_summary",
     "affiliate_summary",
     "commissions",
     "payouts"
    ],
    "type": "string"
   },
   "participant": {
    "additionalProperties": false,
    "properties": {
     "email": {
      "type": "string"
     },
     "firstName": {
      "type": "string"
     },
     "lastName": {
      "type": "string"
     }
    },
    "required": [
     "email"
    ],
    "type": "object"
   },
   "withAuthAttributes": {
    "default": false,
    "type": "boolean"
   }
  },
  "required": [
   "element"
  ],
  "type": "object"
 },
 "name": "growsurf_embeddable_element_snippet",
 "outputSchema": {
  "description": "The snippet for one embeddable GrowSurf element, as a markdown document.",
  "properties": {
   "markdown": {
    "description": "The generated guidance as a markdown document.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Embeddable Element Snippet"
}
