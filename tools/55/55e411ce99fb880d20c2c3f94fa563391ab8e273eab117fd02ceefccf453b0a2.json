    "type": "string"
   },
   "currency": {
    "const": "EUR",
    "type": "string"
   },
   "disclaimer": {
    "maxLength": 600,
    "minLength": 1,
    "type": "string"
   },
   "exampleReportUrl": {
    "maxLength": 400,
    "pattern": "^https:\\/\\/[^\\s]+$",
    "type": "string"
   },
   "freeReportLimits": {
    "additionalProperties": false,
    "properties": {
     "agentChannelPerDay": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     "note": {
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     },
     "perEmail": {
      "additionalProperties": false,
      "properties": {
       "count": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
       },
       "windowDays": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
       }
      },
      "required": [
       "count",
       "windowDays"
      ],
      "type": "object"
     }
    },
    "required": [
     "perEmail",
     "note",
     "agentChannelPerDay"
    ],
    "type": "object"
   },
   "language": {
    "enum": [
     "es",
