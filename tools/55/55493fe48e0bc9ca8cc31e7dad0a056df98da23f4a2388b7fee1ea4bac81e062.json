{
 "description": "Update an existing product by its ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "availableInStore": {
    "description": "Whether the product is available in the storefront",
    "type": "boolean"
   },
   "description": {
    "description": "Product description",
    "type": "string"
   },
   "imageUrl": {
    "description": "URL of the product image",
    "type": "string"
   },
   "locationId": {
    "description": "Location ID the product belongs to",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "medias": {
    "description": "Array of media objects associated with the product",
    "items": {},
    "type": "array"
   },
   "name": {
    "description": "Product name",
    "type": "string"
   },
   "productId": {
    "description": "The product ID to update",
    "type": "string"
   },
   "productType": {
    "description": "Type of product (e.g. PHYSICAL, DIGITAL, SERVICE)",
    "type": "string"
   },
   "statementDescriptor": {
    "description": "Descriptor shown on billing statements",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "productId"
  ],
  "type": "object"
 },
 "name": "crm_update_product"
}
