{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Inspect a link on a public page"
 },
 "description": "Safely fetch one public HTTPS source page and report matching anchor markup for a public HTTPS target, including observed rel tokens. This does not establish indexing, crawler treatment, or ranking impact. Redirect history is reported as unobserved.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "sourceUrl": {
    "description": "Public HTTPS page whose fetched HTML is inspected.",
    "format": "uri",
    "maxLength": 2000,
    "type": "string"
   },
   "targetUrl": {
    "description": "Public HTTPS destination to match exactly, ignoring fragments.",
    "format": "uri",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "sourceUrl",
   "targetUrl"
  ],
  "type": "object"
 },
 "name": "toolfound_inspect_public_link",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "canonical_result_url": {
    "format": "uri",
    "type": "string"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "field": {
      "enum": [
       "sourceUrl",
       "targetUrl"
      ],
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "evidence": {
    "additionalProperties": false,
    "properties": {
     "found": {
      "type": "boolean"
     },
     "links": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "anchorText": {
         "type": "string"
        },
        "href": {
         "type": "string"
        },
        "nofollow": {
         "type": "boolean"
        },
        "rel": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "resolvedUrl": {
         "type": "string"
        },
        "sponsored": {
         "type": "boolean"
        },
        "ugc": {
         "type": "boolean"
        }
       },
       "required": [
        "href",
        "resolvedUrl",
        "anchorText",
        "rel",
        "nofollow",
        "sponsored",
        "ugc"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "matchingLinkCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "found",
     "matchingLinkCount",
     "links"
    ],
    "type": "object"
   },
   "fetch": {
    "additionalProperties": false,
    "properties": {
     "note": {
      "type": "string"
     },
     "redirectHistory": {
      "const": "unobserved",
      "type": "string"
     },
     "status": {
      "enum": [
       "fetched",
       "failed",
       "rejected"
      ],
      "type": "string"
     }
    },
    "required": [
     "status",
     "redirectHistory",
     "note"
    ],
    "type": "object"
   },
   "fetchedAt": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "sourceUrl": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "targetUrl": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "summary",
   "sourceUrl",
   "targetUrl",
   "fetchedAt",
   "fetch",
   "evidence",
   "canonical_result_url"
  ],
  "type": "object"
 },
 "title": "Inspect a link on a public page"
}
