{
 "description": "Create a new native ad item using a native template",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "height": {
    "description": "Ad height in pixels",
    "type": "number"
   },
   "location": {
    "description": "Click-through URL",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom metadata key-value pairs",
    "type": "object"
   },
   "name": {
    "description": "Ad item name",
    "type": "string"
   },
   "template": {
    "description": "Native template ID",
    "type": "number"
   },
   "tracking_pixel": {
    "description": "Third-party tracking pixel URL",
    "type": "string"
   },
   "tracking_pixels": {
    "description": "Array of tracking pixel URLs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "trusted_redirect_domains": {
    "description": "Trusted redirect domains",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "variables": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Template variables as key-value pairs (keys should be integer strings)",
    "type": "object"
   },
   "width": {
    "description": "Ad width in pixels",
    "type": "number"
   }
  },
  "required": [
   "name",
   "template",
   "variables"
  ],
  "type": "object"
 },
 "name": "create_native_ad_item"
}
