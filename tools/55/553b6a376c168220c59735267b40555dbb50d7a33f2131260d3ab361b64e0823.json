 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Edge Hunter"
 },
 "description": "Read the Max-only Edge Hunter API at https://0xinsider.com/sports/edge. Pro receives 403 forbidden with reason max_plan_required. One view selector offers board (default), full signals and cohort observations. All views accept kind sports|esports (omission covers both), sports, leagues, market_types, condition_ids, event_slugs, series_slugs and legacy category. Array selections accept 1..100 supplied values before deduplication, including comma-separated values inside a value; repeat REST query keys or supply MCP arrays. Lists match OR; axes match AND. Canonical sports and machine league identities normalize case-insensitively; market types and event/series slugs are exact case-sensitive provider strings. category=NFL selects the Football bucket; leagues=[nfl] selects NFL. Selection precedes the cap or pagination and appears as normalized selection beside the result fields; changed selections cannot share cursors or ETags. Every row carries nullable market_context with nullable league, series_slug, market_type and metadata_updated_at for authoritative filter discovery; metadata_updated_at is the local canonical writer clock, not provider observation time. Selected reads fail closed with 503 read_model_warming if frozen sidecar readiness is absent. Board defaults stay B grade floor, 30 rows and 48-hour horizon; min_grade S/A/B and limit clamp 1..30 are configurable, total is before the cap, with both current outcome quotes. Signals use min_grade default B, horizon default 12/clamp 1..48, limit default 20/clamp 1..100 and cursor, retaining token_id, all ranked/holder/directional/category-skill fields and clocks. Grade floor requires a holder at that grade or better without removing other holders. Observations require cohort wider_holder|in_play|emerging_pile, accept limit/cursor, and retain full observation rows, snapshot_as_of, degraded, source-generation/category funnel diagnostics and REST meta. Observation horizon stays 48h with 12h in-play kickoff lookback and 30s live snapshot ceiling; funnel accounting is not a league/type/ID selection census. All public views read warmed generations only; missing or stale readiness returns 503 read_model_warming with Retry-After 5. Advanced views use private,no-cache with REST/SDK ETag/304 helpers; board uses private,no-store and has no ETag/pagination. Invalid mode-specific parameters return 400. Price marks are market midpoints, not wallet entry prices; volume is shares. Null/db_only/degraded identify unavailable or weaker evidence. Analytics is not an order instruction.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "All views; legacy canonical bucket alias. NFL selects Football; use leagues=[nfl] for NFL only.",
    "type": "string"
   },
   "cohort": {
    "description": "Required for observations; rejected for board/signals",
    "enum": [
     "wider_holder",
     "in_play",
     "emerging_pile"
    ],
    "type": "string"
   },
   "condition_ids": {
    "description": "Exact market selections. Raw provider condition IDs and the existing mkt_-prefixed aliases normalize to raw IDs. Unknown well-formed IDs return an empty result. All views. Repeat this query key or put comma-separated values inside a value. Values normalize, sort and deduplicate; at most 100 supplied values before deduplication. Values within this axis match OR; different selected axes match AND. An empty selection is invalid. Filtering precedes the board cap or advanced pagination and is bound to advanced cursors and ETags.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "cursor": {
    "description": "Advanced next_cursor, bound to view, all normalized selections and snapshot",
    "type": "string"
   },
   "event_slugs": {
    "description": "Exact provider event slugs. Use event_slug returned on the row; no title or slug-prefix guessing. All views. Repeat this query key or put comma-separated values inside a value. Values normalize, sort and deduplicate; at most 100 supplied values before deduplication. Values within this axis match OR; different selected axes match AND. An empty selection is invalid. Filtering precedes the board cap or advanced pagination and is bound to advanced cursors and ETags.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "horizon_hours": {
    "description": "Board default 48/signals default 12, clamp 1..48; rejected for observations",
    "type": "integer"
   },
   "kind": {
    "description": "All views: sports excludes the Esports bucket; esports selects only Esports. Omit for both. Combines with other selections using AND. Selected reads echo normalized selection and require frozen metadata readiness.",
    "enum": [
     "sports",
     "esports"
    ],
    "type": "string"
   },
   "leagues": {
    "description": "Normalized machine/provider league identities, such as nfl, cfb, nba, epl, cs2, lol, dota2 or valorant. Known wire/tag aliases normalize; other provider keys match exact lowercase identity. This is separate from category: category=NFL selects Football, while leagues=nfl selects NFL only. Read market_context.league for authoritative values. All views. Repeat this query key or put comma-separated values inside a value. Values normalize, sort and deduplicate; at most 100 supplied values before deduplication. Values within this axis match OR; different selected axes match AND. An empty selection is invalid. Filtering precedes the board cap or advanced pagination and is bound to advanced cursors and ETags.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "limit": {
    "description": "Board cap default 30/clamp 1..30; advanced page default 20/clamp 1..100",
    "type": "integer"
   },
   "market_types": {
    "description": "Exact provider sports_market_type values. This is an open provider taxonomy, distinct from exact market IDs. Read market_context.market_type; missing selected metadata excludes the row. All views. Repeat this query key or put comma-separated values inside a value. Values normalize, sort and deduplicate; at most 100 supplied values before deduplication. Values within this axis match OR; different selected axes match AND. An empty selection is invalid. Filtering precedes the board cap or advanced pagination and is bound to advanced cursors and ETags.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "min_grade": {
    "description": "Board/signals only; holder at this grade or better, default B",
    "enum": [
     "S",
     "A",
     "B"
    ],
    "type": "string"
   },
   "series_slugs": {
    "description": "Exact provider series slugs. Read market_context.series_slug; a missing selected series excludes the row. All views. Repeat this query key or put comma-separated values inside a value. Values normalize, sort and deduplicate; at most 100 supplied values before deduplication. Values within this axis match OR; different selected axes match AND. An empty selection is invalid. Filtering precedes the board cap or advanced pagination and is bound to advanced cursors and ETags.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "sports": {
    "description": "Canonical sport buckets, including Esports and Table Tennis, matched case-insensitively. Unknown names and league aliases such as NFL are rejected in sports; use category for legacy bucket aliases or leagues for exact league selection. Omission covers every sport admitted by the selected view. All views. Repeat this query key or put comma-separated values inside a value. Values normalize, sort and deduplicate; at most 100 supplied values before deduplication. Values within this axis match OR; different selected axes match AND. An empty selection is invalid. Filtering precedes the board cap or advanced pagination and is bound to advanced cursors and ETags.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "view": {
    "default": "board",
    "description": "Response mode; defaults to board",
    "enum": [
     "board",
     "signals",
     "observations"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
