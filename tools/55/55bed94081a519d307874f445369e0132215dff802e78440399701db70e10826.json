{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get service metrics"
 },
 "description": "Get CPU / memory metrics for a service's containers. GET /v1/projects/{projectId}/services/{serviceId}/metrics. Use queryType=single (default) for a current snapshot or queryType=range with duration/startTime/endTime.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "duration": {
    "description": "Range duration in seconds (alternative to startTime/endTime).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "endTime": {
    "description": "Range end.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "metricTypes": {
    "description": "Which metrics to return; defaults to all if omitted.",
    "items": {
     "enum": [
      "cpu",
      "memory"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "projectId": {
    "description": "Project id.",
    "type": "string"
   },
   "queryType": {
    "description": "single = point-in-time (default), range = time series.",
    "enum": [
     "single",
     "range"
    ],
    "type": "string"
   },
   "serviceId": {
    "description": "Service id.",
    "type": "string"
   },
   "startTime": {
    "description": "Range start (unix ms/seconds per API).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "time": {
    "description": "Point-in-time for queryType=single.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "projectId",
   "serviceId"
  ],
  "type": "object"
 },
 "name": "northflank_get_service_metrics",
 "title": "Get service metrics"
}
