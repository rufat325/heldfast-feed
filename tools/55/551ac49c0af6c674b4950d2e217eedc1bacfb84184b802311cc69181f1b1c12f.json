{
 "description": "Checks package names against the OSV (Open Source Vulnerabilities) database and returns CVEs/GHSAs affecting them. Use after validating imports to catch known-vulnerable dependencies before installing.",
 "inputSchema": {
  "properties": {
   "language": {
    "description": "Language \u2192 ecosystem (python\u2192PyPI, js/ts\u2192npm, rust\u2192crates.io, go\u2192Go).",
    "enum": [
     "python",
     "javascript",
     "typescript",
     "rust",
     "go"
    ],
    "type": "string"
   },
   "packages": {
    "description": "Package names to check.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timeoutMs": {
    "description": "OSV request timeout in ms (default: 8000).",
    "type": "number"
   }
  },
  "required": [
   "packages",
   "language"
  ],
  "type": "object"
 },
 "name": "scan_vulnerabilities"
}
