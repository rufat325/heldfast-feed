{
 "_meta": {
  "openai/fileParams": [
   "files"
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use this when the user wants to keep images as design references: uploaded images or public links to image files, up to 4 per call. Each image is read once and kept as a style description with its layout, color palette (hex), typography, texture and hierarchy; the image itself is not stored. Leave out profile_key to start a new profile, or pass the key from an earlier call to add to it. Returns the profile_key (keep it), what was added and any image that could not be read. It does not open web pages, search for images or identify people.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "files": {
    "description": "Images the user uploaded, at most 4 per call (PNG, JPEG, GIF or WebP).",
    "items": {
     "properties": {
      "download_url": {
       "description": "Temporary link to the uploaded image.",
       "maxLength": 2000,
       "type": "string"
      },
      "file_id": {
       "maxLength": 200,
       "type": "string"
      },
      "file_name": {
       "maxLength": 200,
       "type": "string"
      },
      "mime_type": {
       "maxLength": 100,
       "type": "string"
      }
     },
     "required": [
      "download_url",
      "file_id"
     ],
     "type": "object"
    },
    "maxItems": 4,
    "type": "array"
   },
   "profile_key": {
    "description": "Leave out to start a new profile; pass the key from an earlier add_refs to add to that profile.",
    "pattern": "^tp_[0-9a-f]{32}$",
    "type": "string"
   },
   "urls": {
    "description": "Public https links that open one image directly (PNG, JPEG, GIF or WebP), at most 4 per call, files and links together. Pages that show an image do not work.",
    "items": {
     "maxLength": 1000,
     "type": "string"
    },
    "maxItems": 4,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "add_refs",
 "outputSchema": {
  "properties": {
   "added": {
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "palette": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "ref_id": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "ref_id",
      "name",
      "summary",
      "palette",
      "tags"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "as_of": {
    "description": "UTC date of this answer.",
    "type": "string"
   },
   "failed": {
    "items": {
     "properties": {
      "code": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "profile_key": {
    "type": "string"
   },
   "refs_max": {
    "type": "integer"
   },
   "refs_total": {
    "type": "integer"
   },
   "retention": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "partial",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "profile_key",
   "added",
   "failed",
   "refs_total",
   "refs_max",
   "retention",
   "source",
   "as_of",
