{
 "description": "Record who reviewed a commit and the outcome (human or AI reviewer).",
 "inputSchema": {
  "properties": {
   "agent": {
    "description": "acting agent identity (defaults to OCTOBOARD_AGENT)",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "outcome": {
    "default": "approved",
    "enum": [
     "approved",
     "changes-requested",
     "rejected",
     "commented"
    ],
    "type": "string"
   },
   "rev": {
    "type": "string"
   },
   "reviewerType": {
    "default": "human",
    "enum": [
     "human",
     "ai"
    ],
    "type": "string"
   }
  },
  "required": [
   "rev"
  ],
  "type": "object"
 },
 "name": "board_review"
}
