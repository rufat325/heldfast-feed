 "description": "Formats breaking out in the West that no Korean video holds yet, and those arriving. Formats breaking out in the West (the US, Europe, other English-speaking countries) that no Korean video holds yet, then those just reaching Korea, in Shorti's radar order. Each says what its videos do, its strongest video (link, views), how many Western videos and creators broke out with it and when last, how many Korean videos it has, and how much of it needs no language (`language_light`). `to_korea` is the measured time from a Western hit to the first Korean video across this release's formats. Use it when a creator asks what to shoot before it reaches Korea; narrow by `category` or `state`; then shorti_format(format_id) for how to shoot one.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "anyOf": [
     {
      "enum": [
       "beauty",
       "food",
       "fashion",
       "daily",
       "comedy",
       "dance",
       "music",
       "pets",
       "fitness",
       "travel",
       "art",
       "gaming",
       "product",
       "info",
       "ai",
       "household",
       "tech",
       "parenting"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The creator's niche, when they have one: beauty, food, fashion, daily, comedy, dance, music, pets, fitness, travel, art, gaming, product, info, ai, household, tech, parenting."
   },
   "lang": {
    "default": "ko",
    "description": "The creator's language. 'en' answers in the English Shorti wrote: never translate its Korean yourself.",
    "enum": [
     "ko",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "default": 6,
    "description": "How many formats.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "anyOf": [
     {
      "enum": [
       "not_in_korea",
       "arriving",
       "entered"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "'not_in_korea': no Korean video yet; 'arriving': the first ones; 'entered': already made in Korea."
   }
  },
  "type": "object"
 },
