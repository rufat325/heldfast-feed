     "LCRY-1700",
     "LCRY-1200",
     "LCRY-2380",
     "LCRY-1100",
     "LCRY-1258",
     "SIDE-1000"
    ],
    "type": "string"
   }
  },
  "required": [
   "template",
   "labels"
  ],
  "type": "object"
 },
 "name": "create_label_sheet",
 "title": "Create a printable label sheet"
}
