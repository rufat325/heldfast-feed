   "copies": {
    "default": 1,
    "maximum": 156,
    "minimum": 1,
    "type": "integer"
   },
   "fontFamily": {
    "default": "Arial",
    "enum": [
     "Arial",
     "Helvetica",
     "Times New Roman",
     "Courier New",
     "Calibri",
     "Verdana",
     "Georgia",
     "Tahoma",
     "Trebuchet MS",
     "Impact",
     "Comic Sans MS",
     "Lucida Console"
    ],
    "type": "string"
   },
   "fontSize": {
    "default": 10,
    "maximum": 20,
    "minimum": 6,
    "type": "number"
   },
   "labels": {
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 156,
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "default": "Agent labels",
    "maxLength": 120,
    "type": "string"
   },
   "qrEnabled": {
