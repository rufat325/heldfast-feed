{"description":"Run an order past a compliance officer and risk manager before sending it to the broker. Checks buying power, cash-account settlement violations, FINRA intraday margin (post-PDT) or legacy PDT limits, Reg SHO short-sale rules, wash-sale exposure, position concentration, per-trade risk versus stop, liquidity, spread, fat-finger prices, leverage and market hours. Returns approve / approve_with_warnings / reject with reasons and a resized quantity when useful. Price: $0.005.","inputSchema":{"examples":[{"account":{"equity":100000,"positions":[],"type":"margin"},"market":{"ask":200.02,"avg_daily_volume":50000000,"bid":199.98,"last_price":200},"order":{"limit_price":200,"quantity":50,"side":"buy","stop_loss_price":190,"symbol":"AAPL"}}],"properties":{"account":{"description":"Account state before the order.","properties":{"buying_power":{"description":"Broker-reported buying power, if known.","type":"number"},"cash":{"type":"number"},"day_trade_regime":{"description":"Defaults by date; brokers may phase in until 2027-10-20.","enum":["intraday_margin","legacy_pdt"]},"day_trades_last_5_days":{"type":"integer"},"equity":{"description":"Net liquidation value (USD).","type":"number"},"positions":{"items":{"properties":{"avg_cost":{"type":"number"},"market_price":{"type":"number"},"opened_today":{"type":"boolean"},"quantity":{"description":"Negative for short.","type":"number"},"sector":{"type":"string"},"symbol":{"type":"string"}},"type":"object"},"type":"array"},"recent_sales":{"description":"Sales in the last 30 days, for wash-sale checks.","items":{"properties":{"date":{"type":"string"},"quantity":{"type":"number"},"realized_pnl":{"type":"number"},"symbol":{"type":"string"}},"type":"object"},"type":"array"},"settled_cash":{"description":"Cash accounts: settled funds available.","type":"number"},"type":{"enum":["cash","margin"]}},"required":["type","equity"],"type":"object"},"market":{"properties":{"ask":{"type":"number"},"avg_daily_volume":{"type":"number"},"bid":{"type":"number"},"halted":{"type":"boolean"},"last_price":{"type":"number"},"prev_close":{"type":"number"}},"type":"object"},"order":{"properties":{"limit_price":{"type":"number"},"locate_confirmed":{"type":"boolean"},"order_type":{"enum":["market","limit","stop","stop_limit"]},"quantity":{"type":"number"},"side":{"enum":["buy","sell","sell_short","buy_to_cover"]},"stop_loss_price":{"description":"Planned protective stop, used for risk-per-trade.","type":"number"},"symbol":{"type":"string"},"timestamp":{"description":"ISO time the order will be sent; defaults to now.","type":"string"}},"required":["symbol","side","quantity"],"type":"object"},"policy":{"description":"Override risk limits. Defaults: {\"max_position_pct\":0.2,\"max_order_risk_pct\":0.02,\"max_adv_pct\":0.05,\"max_spread_pct\":0.01,\"max_gross_leverage\":2,\"max_limit_deviation_pct\":0.1,\"allow_short\":true,\"allow_extended_hours\":false,\"require_stop\":false}","type":"object"}},"required":["account","order"],"type":"object"},"name":"pre_trade_check","title":"Pre-trade compliance and risk check"}
