{
 "description": "Delete one or more documents from Suparse by document ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_url": {
    "description": "Optional API base URL. Defaults to SUPARSE_API_URL or Suparse production API.",
    "format": "uri",
    "type": "string"
   },
   "document_ids": {
    "description": "Suparse document IDs to delete.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "document_ids"
  ],
  "type": "object"
 },
 "name": "delete_documents",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deleted": {
    "type": "boolean"
   },
   "document_ids": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "deleted",
   "document_ids"
  ],
  "type": "object"
 },
 "title": "Delete Documents"
}
