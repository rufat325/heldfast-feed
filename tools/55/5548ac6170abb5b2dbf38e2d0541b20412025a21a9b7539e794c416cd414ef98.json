{
 "description": "Search 90,000+ live US government surplus auction listings from 26 official sources. Supports keyword, category, state, ZIP-radius, and price filters.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "type": "string"
   },
   "limit": {
    "description": "Results per page, default 25",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "price_max_usd": {
    "type": "number"
   },
   "query": {
    "description": "Keyword search, e.g. 'forklift'",
    "type": "string"
   },
   "radius_miles": {
    "maximum": 300,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "enum": [
     "ending_soon",
     "newest",
     "price_low",
     "price_high",
     "most_bids",
     "best_deals"
    ],
    "type": "string"
   },
   "state": {
    "description": "2-letter US state code",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "zip": {
    "description": "Center a radius search on this ZIP",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_listings",
 "title": "Search live government auctions"
}
