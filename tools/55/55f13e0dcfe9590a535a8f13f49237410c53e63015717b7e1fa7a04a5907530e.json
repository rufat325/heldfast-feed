{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Investors in the peers"
 },
 "description": "Use this when someone wants the investors who hold a company's peers but not the company, or the overlap between two companies' holders, for example to find investors to approach. Give it the company and up to 10 peer tickers; mode missing (default) or overlap. Returns institutions ranked by how many peers they hold, with their position in each peer and in the company and their 6ix page.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "company": {
    "description": "Ticker (AAPL, NYSE:BAC, SHOP.TO), company name, or the 6ix company link returned by find_company",
    "maxLength": 400,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_peers": {
    "default": 2,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "default": "missing",
    "enum": [
     "missing",
     "overlap",
     "all"
    ],
    "type": "string"
   },
   "peers": {
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "company",
   "peers"
  ],
  "type": "object"
 },
 "name": "compare_peer_ownership",
 "outputSchema": {
  "properties": {
   "asOf": {
    "description": "When 6ix answered (ISO 8601, UTC)",
    "type": "string"
   },
   "company": {
    "properties": {
     "exchange": {
      "type": [
       "string",
       "null"
      ]
     },
     "name": {
      "type": "string"
     },
     "ticker": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "url"
    ],
    "type": "object"
   },
   "holders": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "peers": {
    "items": {
     "properties": {
      "exchange": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "ticker": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "company",
   "peers",
   "holders"
  ],
  "type": "object"
 },
 "title": "Investors in the peers"
}
