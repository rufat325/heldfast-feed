{
 "description": "Send the same keys to multiple targets (across hosts) and optionally capture results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capture": {
    "default": true,
    "description": "Capture after sending.",
    "type": "boolean"
   },
   "captureLines": {
    "default": 200,
    "description": "Default lines to capture (per-target override available).",
    "type": "number"
   },
   "delayMs": {
    "default": 0,
    "description": "Default delay before capture in ms (per-target override available).",
    "type": "number"
   },
   "enter": {
    "default": true,
    "description": "Append Enter.",
    "type": "boolean"
   },
   "keys": {
    "description": "Keys/command to send.",
    "type": "string"
   },
   "mode": {
    "description": "send_capture (default) captures once, tail polls, pattern checks for regex.",
    "enum": [
     "send_capture",
     "tail",
     "pattern"
    ],
    "type": "string"
   },
   "pattern": {
    "description": "Regex pattern when mode=pattern.",
    "type": "string"
   },
   "patternFlags": {
    "description": "Regex flags (e.g., i)",
    "type": "string"
   },
   "tailIntervalMs": {
    "default": 1000,
    "description": "Tail interval ms (mode=tail).",
    "type": "number"
   },
   "tailIterations": {
    "default": 3,
    "description": "Tail iterations (mode=tail).",
    "type": "number"
   },
   "targets": {
    "description": "List of targets to fan-out to.",
    "items": {
     "properties": {
      "captureLines": {
       "description": "Lines to capture for this target.",
       "type": "number"
      },
      "delayMs": {
       "description": "Delay before capture for this target.",
       "type": "number"
      },
      "host": {
       "description": "SSH host alias (optional).",
       "type": "string"
      },
      "target": {
       "description": "Pane target (pane id or session:window.pane).",
       "type": "string"
      }
     },
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "targets",
   "keys"
  ],
  "type": "object"
 },
 "name": "tmux_multi_run",
 "title": "Fan-out send and capture"
}
