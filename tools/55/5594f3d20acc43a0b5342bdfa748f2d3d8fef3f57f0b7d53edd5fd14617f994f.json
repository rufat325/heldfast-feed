 "description": "Paid x402 services we observed on Coinbase's x402 Bazaar, with coverage. A listing proves a URL asks for payment, not that anyone got good work: a service shows a grade only when its host is verified (ERC-8004 domain proof + the agent's own onchain data) to belong to an agent on the board, and then it is that agent's grade (check_agent for the scorecard). Everything else is ungraded with a reason. Filter by host, agent or coverage state. Free within the per-IP allowance. Live data only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent": {
    "description": "An agent id: the services verified as that agent's, e.g. base:14516.",
    "maxLength": 80,
    "type": "string"
   },
   "cursor": {
    "description": "The previous page's next_cursor.",
    "maxLength": 500,
    "type": "string"
   },
   "host": {
    "description": "A host name, e.g. api.example.com.",
    "maxLength": 253,
    "type": "string"
   },
   "limit": {
    "description": "Items per page, 1 to 50 (default 25).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "enum": [
     "graded",
     "ungraded"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
