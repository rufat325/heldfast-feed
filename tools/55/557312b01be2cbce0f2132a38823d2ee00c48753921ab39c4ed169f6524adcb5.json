{
 "description": "Full-content safety-data export in standard shapes for a challenge (owner-only, embargo-aware \u2014 embargoed rows withhold content). Requires safety_data:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "challengeId": {
    "minLength": 1,
    "type": "string"
   },
   "kind": {
    "description": "Filter to one artifact kind.",
    "enum": [
     "JAILBREAK",
     "OVER_REFUSAL",
     "AGENT_VIOLATION",
     "PREFERENCE_PAIR"
    ],
    "type": "string"
   }
  },
  "required": [
   "challengeId"
  ],
  "type": "object"
 },
 "name": "opentrain_safety_data_export",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
