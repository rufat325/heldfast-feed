{
 "_meta": {
  "threadlinqs/catalog_note": "Served from the public catalog, not your authenticated tool list. Check THREADLINQS_API_KEY.",
  "threadlinqs/catalog_source": "public_catalog",
  "ui": {
   "resourceUri": "ui://threadlinqs/graph",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Similar Threats"
 },
 "description": "Threats similar to a given threat, with the EVIDENCE behind each link: per-channel score breakdown, which signal dominates, the concrete shared techniques / IOCs / CVEs, and quality flags for stale or high-confidence-low-evidence links. Use explain_correlation for a full decomposition of one specific pair.",
 "inputSchema": {
  "properties": {
   "id": {
    "description": "Source threat ID (e.g. TL-2026-0042)",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 10, max 20 \u2014 the handler caps here).",
    "type": "number"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_similar_threats",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "type": "integer"
   },
   "counts": {
    "additionalProperties": true,
    "properties": {
     "has_more": {
      "type": "boolean"
     },
     "limit": {
      "type": "integer"
     },
     "matched": {
      "type": "integer"
     },
     "matched_is_floor": {
      "description": "True when the source queries saturated, so `matched` under-counts.",
      "type": "boolean"
     },
     "returned": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "data": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "dominance": {},
      "id": {
       "description": "Neighbour threat ID \u2014 pass to get_threat.",
       "type": "string"
      },
      "is_high_conf_low_signal": {
       "type": "boolean"
      },
      "is_stale": {
       "type": "boolean"
      },
      "score_breakdown": {
       "additionalProperties": true,
       "properties": {},
       "type": "object"
      },
      "shared_cves": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "shared_iocs": {
       "items": {},
       "type": "array"
      },
      "shared_techniques": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "signal_count": {
       "type": "integer"
      },
      "similarity_score": {
       "type": "number"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "similar": {
    "items": {},
    "type": "array"
   },
   "source_threat_id": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Similar Threats"
}
