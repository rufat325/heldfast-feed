{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Makes one of the signed-in person's songs public (anyone can find and play it on musicboxmelodies.com) or private. Only make a song public when the person asked for it: ask them to confirm, then call again with confirmed: true.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "confirmed": {
    "description": "Required to make a song public: true only after the person confirmed.",
    "type": "boolean"
   },
   "song_id": {
    "maxLength": 40,
    "type": "string"
   },
   "visibility": {
    "enum": [
     "public",
     "private"
    ],
    "type": "string"
   }
  },
  "required": [
   "song_id",
   "visibility"
  ],
  "type": "object"
 },
 "name": "set_song_visibility",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "song_id": {
    "type": "string"
   },
   "status": {
    "enum": [
     "updated",
     "needs_confirmation"
    ],
    "type": "string"
   },
   "url": {
    "type": "string"
   },
   "visibility": {
    "type": "string"
   }
  },
  "required": [
   "song_id",
   "visibility",
   "status",
   "url"
  ],
  "type": "object"
 },
 "title": "Make a song public or private"
}
