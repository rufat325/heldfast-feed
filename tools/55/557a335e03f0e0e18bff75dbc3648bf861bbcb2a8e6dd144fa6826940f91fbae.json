{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Modify properties of an existing object. fill/stroke on a group or compound path are applied to every path and text frame inside it (like Illustrator's UI; clipping paths and guides are skipped) and the result reports how many were changed (painted) and the colors they actually have (verified.descendantFills). success is false if any of them could not be painted. Note: Illustrator will be activated (brought to foreground) during execution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "coordinate_system": {
    "description": "Coordinate system. Auto-detected from document by default (CMYK/print \u2192 document, RGB/web \u2192 artboard-web). artboard-web: origin at active artboard top-left, Y-down. document: Illustrator native coords, origin at bottom-left, Y-up. Call get_document_info to check which system is active.",
    "enum": [
     "artboard-web",
     "document"
    ],
    "type": "string"
   },
   "properties": {
    "description": "Properties to modify",
    "properties": {
     "contents": {
      "description": "Text contents (for text frames)",
      "type": "string"
     },
     "fill": {
      "description": "Fill color. For text frames this is the character color; for groups/compound paths it is applied to all paths and text inside",
      "oneOf": [
       {
        "properties": {
         "c": {
          "description": "Cyan (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "k": {
          "description": "Black (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "m": {
          "description": "Magenta (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "type": {
          "const": "cmyk",
          "description": "Color type",
          "type": "string"
         },
         "y": {
          "description": "Yellow (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         }
        },
        "required": [
         "type",
         "c",
         "m",
         "y",
         "k"
        ],
        "type": "object"
       },
       {
        "properties": {
         "b": {
          "description": "Blue (0-255)",
          "maximum": 255,
          "minimum": 0,
          "type": "number"
         },
         "g": {
          "description": "Green (0-255)",
          "maximum": 255,
          "minimum": 0,
          "type": "number"
         },
         "r": {
          "description": "Red (0-255)",
          "maximum": 255,
          "minimum": 0,
          "type": "number"
         },
         "type": {
          "const": "rgb",
          "description": "Color type",
          "type": "string"
         }
        },
        "required": [
         "type",
         "r",
         "g",
         "b"
        ],
        "type": "object"
       },
       {
        "properties": {
         "type": {
          "const": "gray",
          "description": "Color type",
          "type": "string"
         },
         "value": {
          "description": "Gray value (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         }
        },
        "required": [
         "type",
         "value"
        ],
        "type": "object"
       },
       {
        "properties": {
         "type": {
          "const": "none",
          "description": "Color type",
          "type": "string"
         }
        },
        "required": [
         "type"
        ],
        "type": "object"
       }
      ]
     },
     "font_name": {
      "description": "Exact font name for text frames, as listed by list_fonts (the 'name' field, e.g. PostScript name 'HelveticaNeue-Bold'). If not found, nothing is modified and an error with font_candidates is returned",
      "type": "string"
     },
     "font_size": {
      "description": "Font size (for text frames)",
      "type": "number"
     },
     "hidden": {
      "description": "Hide (true) or show (false) the object without deleting it",
      "type": "boolean"
     },
     "justification": {
      "description": "Paragraph alignment for text frames, applied to all paragraphs",
      "enum": [
       "left",
       "center",
       "right"
      ],
      "type": "string"
     },
     "leading": {
      "anyOf": [
       {
        "exclusiveMinimum": 0,
        "type": "number"
       },
       {
        "const": "auto",
        "type": "string"
       }
      ],
      "description": "Line spacing (leading) in pt for text frames, or \"auto\" for auto leading. Omit to leave unchanged"
     },
     "locked": {
      "description": "Lock (true) or unlock (false) the object. Unlock is applied before other changes, lock after them",
      "type": "boolean"
     },
     "name": {
      "description": "Object name",
      "type": "string"
     },
     "opacity": {
      "description": "Opacity (0-100)",
      "type": "number"
     },
     "position": {
      "description": "Position",
      "properties": {
       "x": {
        "description": "X coordinate",
        "type": "number"
       },
       "y": {
        "description": "Y coordinate",
        "type": "number"
       }
      },
      "required": [
       "x",
       "y"
      ],
      "type": "object"
     },
     "rotation": {
      "description": "Rotation in degrees. Default mode is \"delta\" (additive). Use rotation_mode: \"absolute\" for target angle.",
      "type": "number"
     },
     "rotation_mode": {
      "default": "delta",
      "description": "delta = add to current rotation, absolute = set to exact angle",
      "enum": [
       "delta",
       "absolute"
      ],
      "type": "string"
     },
     "size": {
      "description": "Size",
      "properties": {
       "height": {
        "description": "Height",
        "type": "number"
       },
       "width": {
        "description": "Width",
        "type": "number"
       }
      },
      "type": "object"
     },
     "stroke": {
      "description": "Stroke settings. For groups/compound paths it is applied to all paths and text inside",
      "properties": {
       "color": {
        "description": "Stroke color",
        "oneOf": [
         {
          "properties": {
           "c": {
            "description": "Cyan (0-100)",
            "maximum": 100,
            "minimum": 0,
            "type": "number"
           },
           "k": {
            "description": "Black (0-100)",
            "maximum": 100,
            "minimum": 0,
            "type": "number"
           },
           "m": {
            "description": "Magenta (0-100)",
            "maximum": 100,
            "minimum": 0,
            "type": "number"
           },
           "type": {
            "const": "cmyk",
            "description": "Color type",
            "type": "string"
           },
           "y": {
            "description": "Yellow (0-100)",
            "maximum": 100,
            "minimum": 0,
            "type": "number"
           }
          },
          "required": [
           "type",
           "c",
           "m",
           "y",
           "k"
          ],
          "type": "object"
         },
         {
          "properties": {
           "b": {
            "description": "Blue (0-255)",
            "maximum": 255,
            "minimum": 0,
            "type": "number"
           },
           "g": {
            "description": "Green (0-255)",
            "maximum": 255,
            "minimum": 0,
            "type": "number"
           },
           "r": {
            "description": "Red (0-255)",
            "maximum": 255,
            "minimum": 0,
            "type": "number"
           },
           "type": {
            "const": "rgb",
            "description": "Color type",
            "type": "string"
           }
          },
          "required": [
           "type",
           "r",
           "g",
           "b"
          ],
          "type": "object"
         },
         {
          "properties": {
           "type": {
            "const": "gray",
            "description": "Color type",
            "type": "string"
           },
           "value": {
            "description": "Gray value (0-100)",
            "maximum": 100,
            "minimum": 0,
            "type": "number"
           }
          },
          "required": [
           "type",
           "value"
          ],
          "type": "object"
         },
         {
          "properties": {
           "type": {
            "const": "none",
            "description": "Color type",
            "type": "string"
           }
          },
          "required": [
           "type"
          ],
          "type": "object"
         }
        ]
       },
       "width": {
        "description": "Stroke width",
        "type": "number"
       }
      },
      "type": "object"
     },
     "tracking": {
      "description": "Letter spacing (tracking) in 1/1000 em, for text frames. 0 = none, positive = looser, negative = tighter. Same units and range as Illustrator's Character panel.",
      "maximum": 10000,
      "minimum": -1000,
      "type": "number"
     }
    },
    "type": "object"
   },
   "uuid": {
    "description": "UUID of the target object",
    "type": "string"
   }
  },
  "required": [
   "uuid",
   "properties"
  ],
  "type": "object"
 },
 "name": "modify_object",
 "title": "Modify Object"
}
