{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks about an RFC, such as \"which RFC obsoletes RFC 2616?\" or \"find the RFC about WebSocket\". Pass either the RFC number, or words from its title (not both). A number returns the title, status, publication date, authors, abstract, and the RFCs it obsoletes, is obsoleted by, updates and is updated by. Title words return up to five matching RFCs with their numbers: call again with a number for the details.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "number": {
    "description": "RFC number, such as 2616",
    "maximum": 99999,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Words from an RFC title, such as \"websocket\". Use number or query, not both",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "lookup_rfc",
 "outputSchema": {
  "properties": {
   "asOf": {
    "description": "Date of the source data when it states one, otherwise the date it was read (UTC, YYYY-MM-DD)",
    "type": "string"
   },
   "error": {
    "description": "Present when status is not ok: a stable code, what went wrong and what to do next.",
    "properties": {
     "code": {
      "type": "string"
     },
     "hint": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "hint"
    ],
    "type": "object"
   },
   "matches": {
    "items": {
     "properties": {
      "level": {
       "type": [
        "string",
        "null"
       ]
      },
      "number": {
       "type": "integer"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "rfc": {
    "properties": {
     "abstract": {
      "type": [
       "string",
       "null"
      ]
     },
     "authors": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "errataUrl": {
      "type": [
       "string",
       "null"
      ]
     },
     "number": {
      "type": "integer"
     },
     "obsoletedBy": {
      "description": "RFCs that replace this one; empty when it is current",
      "items": {
       "type": "integer"
      },
      "type": "array"
     },
     "obsoletes": {
      "items": {
       "type": "integer"
      },
      "type": "array"
     },
     "published": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "description": "Category such as proposed standard, internet standard, informational or historic",
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "updatedBy": {
      "items": {
       "type": "integer"
      },
      "type": "array"
     },
     "updates": {
      "items": {
       "type": "integer"
      },
      "type": "array"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "source": {
    "description": "Where the data comes from",
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "not_found",
     "invalid_input",
     "unavailable"
    ],
    "type": "string"
   },
   "totalMatches": {
    "type": "integer"
   }
  },
  "required": [
   "status",
   "source",
   "asOf"
  ],
  "type": "object"
 },
 "title": "Look up an RFC"
}
