{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Detects redundant molds occupying the same flight slot or shot role, ranking pairs by overlap severity and recommending which disc to keep vs cut. Accepts discs list or a BagIQ share link.","inputSchema":{"properties":{"discs":{"description":"List of discs in the bag (minimum 2 discs, optional if share_url or share_id is provided)","items":{"oneOf":[{"description":"Disc name, slug, or brand+name string (e.g. 'Innova Destroyer' or 'discraft-buzzz')","type":"string"},{"properties":{"brand":{"description":"Manufacturer brand name","type":"string"},"confidence":{"description":"Player confidence","enum":["shaky","okay","trusted","money disc"],"type":"string"},"disc":{"description":"Disc name or slug (required)","type":"string"},"locked":{"description":"If true, lock this disc to prevent cut recommendations","type":"boolean"},"plastic":{"description":"Plastic blend (e.g. Star, Champion, ESP)","type":"string"},"throw_type":{"description":"Primary throw style","enum":["backhand","forehand","both"],"type":"string"},"usage":{"description":"Usage frequency","enum":["rare","sometimes","often","all the time"],"type":"string"},"use_case":{"description":"Role or shot description (e.g. 'windy drives', 'tunnel shots')","type":"string"},"wear_state":{"description":"Wear condition","enum":["new","seasoned","beat"],"type":"string"}},"required":["disc"],"type":"object"}]},"maxItems":35,"minItems":2,"type":"array"},"share_id":{"description":"Optional BagIQ short share ID (e.g. '4fisr8a7')","type":"string"},"share_url":{"description":"Optional BagIQ share link (e.g. 'https://app.bagiq.app/?s=4fisr8a7')","type":"string"}},"type":"object"},"name":"detect_overlap","outputSchema":{"properties":{"interactive_bag_url":{"type":"string"},"overlap_count":{"type":"integer"},"overlaps":{"items":{"type":"object"},"type":"array"},"unresolved_discs":{"items":{"type":"string"},"type":"