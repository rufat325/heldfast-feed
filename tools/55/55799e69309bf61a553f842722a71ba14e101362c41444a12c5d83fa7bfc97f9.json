{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "List logged time in FreeAgent for a date range. Use view='unbilled' to find time that has not yet been invoiced. Returns per-project totals alongside the individual entries.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fromDate": {
    "description": "Start of the date range YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Maximum timeslips to return (default 100, max 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "project": {
    "description": "Only time on this project",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/projects\\/\\d+$",
    "type": "string"
   },
   "task": {
    "description": "Only time on this task",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/tasks\\/\\d+$",
    "type": "string"
   },
   "toDate": {
    "description": "End of the date range YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "user": {
    "description": "Only time logged by this user",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/users\\/\\d+$",
    "type": "string"
   },
   "view": {
    "default": "all",
    "description": "Which timeslips to return (default: all)",
    "enum": [
     "all",
     "unbilled",
     "running"
    ],
    "type": "string"
   }
  },
  "required": [
   "fromDate",
   "toDate"
  ],
  "type": "object"
 },
 "name": "freeagent_list_timeslips"
}
