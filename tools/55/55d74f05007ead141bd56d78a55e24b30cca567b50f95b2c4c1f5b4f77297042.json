{
 "description": "Persist a profile so later runs are instant and free. Saves to the project (.zahori/profiles, committable) by default so it travels to production and teammates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "global": {
    "description": "Save to the user-global dir instead of the project.",
    "type": "boolean"
   },
   "profile": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "description": "Stable id; defaults to the URL hostname.",
      "type": "string"
     },
     "match": {
      "description": "URL regex patterns; defaults to the hostname.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     },
     "notes": {
      "type": "string"
     },
     "pick": {
      "additionalProperties": {},
      "description": "variant/order/audioLanguage/languageMap/audioLanguageFallbacks.",
      "type": "object"
     },
     "sniff": {
      "additionalProperties": {},
      "description": "kinds/urlPattern/urlExclude/replayHeaders.",
      "type": "object"
     },
     "steps": {
      "description": "Ordered page actions (goto/dismissOverlays/play/click/waitFor/scroll/eval).",
      "type": "array"
     }
    },
    "type": "object"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "profile"
  ],
  "type": "object"
 },
 "name": "zahori_save_profile",
 "title": "Save a working profile"
}
