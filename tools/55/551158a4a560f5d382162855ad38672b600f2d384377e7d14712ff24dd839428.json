{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Pollar explainers"
 },
 "description": "Lists Pollar's latest explainers, newest first. An explainer is a short narrated walk-through of one news event that answers the question behind it, with maps, timelines, key figures, charts and quotes. get_explainer takes a returned eventSlug for the content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 10,
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "pl",
     "de",
     "fr"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_explainers",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "explainers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "categoryPath": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "durationS": {
       "type": "number"
      },
      "eventSlug": {
       "type": "string"
      },
      "eventTitle": {
       "type": "string"
      },
      "publishedAt": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "eventSlug",
      "eventTitle",
      "categoryPath",
      "durationS",
      "publishedAt",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "explainers"
  ],
  "type": "object"
 },
 "title": "List Pollar explainers"
}
