{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "In-game catalogue price of a new aircraft in a given year: the entry-into-service price inflated by US CPI to nominal dollars of that year, and the same price in 2024 dollars. Accepts an id from aircraft_catalog or part of the name; when several types match and the year does not settle it, returns candidates to choose from.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "model": {
    "description": "Aircraft id from aircraft_catalog (a320-200) or part of its name (A320, 747-400)",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   },
   "year": {
    "description": "Game year to price the aircraft in",
    "maximum": 2030,
    "minimum": 1950,
    "type": "integer"
   }
  },
  "required": [
   "model",
   "year"
  ],
  "type": "object"
 },
 "name": "aircraft_price",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "candidates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "eisYear": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "eopYear": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "eisYear",
      "eopYear"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "match": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "availability": {
        "enum": [
         "not-yet",
         "new",
         "used-only"
        ],
        "type": "string"
       },
       "eisPlanned": {
        "type": "boolean"
       },
       "eisYear": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "eopYear": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "id": {
        "type": "string"
       },
       "listPriceUsdMlnAtEis": {
        "type": "number"
       },
       "name": {
        "type": "string"
       },
       "priceEstimated": {
        "type": "boolean"
       },
       "priceUsdMln2024": {
        "type": "number"
       },
       "priceUsdMlnNominal": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "id",
       "name",
       "eisYear",
       "eopYear",
       "eisPlanned",
       "listPriceUsdMlnAtEis",
       "priceUsdMlnNominal",
       "priceUsdMln2024",
       "priceEstimated",
       "availability"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "note": {
    "type": "string"
   },
   "year": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "year",
   "match",
   "candidates",
   "note"
  ],
  "type": "object"
 },
 "title": "Aircraft price in a game year"
}
