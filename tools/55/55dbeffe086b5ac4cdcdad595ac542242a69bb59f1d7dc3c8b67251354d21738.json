{
 "description": "Find internal link opportunities from a source page to required supplied target pages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "keyword": {
    "type": "string"
   },
   "max_suggestions": {
    "default": 8,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "source_markdown": {
    "description": "Source page markdown when no URL exists",
    "maxLength": 50000,
    "minLength": 80,
    "type": "string"
   },
   "source_url": {
    "description": "Source page URL to scrape",
    "format": "uri",
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "description": "Optional target brand, domain, or product",
    "type": "string"
   },
   "target_pages": {
    "description": "Required candidate internal pages from your sitemap, CMS, crawler, Search Console, or /site/sitemap-audit.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "maxLength": 500,
       "type": "string"
      },
      "keywords": {
       "default": [],
       "items": {
        "type": "string"
       },
       "maxItems": 12,
       "type": "array"
      },
      "title": {
       "maxLength": 180,
       "minLength": 1,
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url",
      "title"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "agentseo_content_internal_links",
 "title": "AgentSEO Content Internal Links"
}
