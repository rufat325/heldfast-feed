{
 "description": "Register this agent with the communication hub. Returns the agent identity.",
 "inputSchema": {
  "properties": {
   "capabilities": {
    "description": "Capability tags (e.g. \"code-review\", \"testing\")",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "channels": {
    "description": "Channels to auto-create and join after registration (e.g. [\"general\"]). Non-existent channels are created on the fly.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "metadata": {
    "description": "Arbitrary metadata (JSON object)",
    "type": "object"
   },
   "name": {
    "description": "Human-readable agent name (2-64 chars, alphanumeric with . _ -)",
    "type": "string"
   },
   "skills": {
    "description": "Skills this agent provides (for skill-based discovery)",
    "items": {
     "properties": {
      "id": {
       "description": "Unique skill identifier",
       "type": "string"
      },
      "name": {
       "description": "Human-readable skill name",
       "type": "string"
      },
      "tags": {
       "description": "Tags for discovery",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "comm_register"
}
