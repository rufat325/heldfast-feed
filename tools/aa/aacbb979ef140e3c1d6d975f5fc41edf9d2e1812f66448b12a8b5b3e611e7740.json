{
 "description": "Create or iterate UI components with style audit and design context awareness. Supports React, Next.js, Vue, Angular, Svelte, and HTML. Component library integration available: shadcn/ui, Radix UI, Headless UI, PrimeVue, Material UI.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brand_identity": {
    "description": "JSON string from branding-mcp generate_brand_identity. Overrides design context with brand tokens.",
    "type": "string"
   },
   "component_library": {
    "default": "none",
    "description": "Component library to use in generated code",
    "enum": [
     "shadcn",
     "radix",
     "headlessui",
     "primevue",
     "material",
     "none"
    ],
    "type": "string"
   },
   "component_type": {
    "description": "Type of component to generate (e.g., \"button\", \"card\", \"form\", \"navbar\", \"sidebar\", \"modal\", \"table\", \"hero\")",
    "type": "string"
   },
   "design_reference_url": {
    "description": "URL to extract design inspiration from",
    "format": "uri",
    "type": "string"
   },
   "existing_css_variables": {
    "description": "Existing CSS variables for style audit",
    "type": "string"
   },
   "existing_tailwind_config": {
    "description": "Existing tailwind.config.js content for style audit",
    "type": "string"
   },
   "framework": {
    "description": "Target framework",
    "enum": [
     "react",
     "nextjs",
     "vue",
     "angular",
     "svelte",
     "html"
    ],
    "type": "string"
   },
   "industry": {
    "description": "Target industry for tailored design",
    "enum": [
     "saas",
     "fintech",
     "ecommerce",
     "healthcare",
     "education",
     "startup",
     "agency",
     "media",
     "devtools",
     "general"
    ],
    "type": "string"
   },
   "mood": {
    "description": "Design mood/personality",
    "enum": [
     "bold",
     "calm",
     "playful",
     "professional",
     "premium",
     "energetic",
     "minimal",
     "editorial",
     "futuristic",
     "warm",
     "corporate",
     "creative"
    ],
    "type": "string"
   },
   "props": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Component props as key-value pairs",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "skip_ml": {
    "default": false,
    "description": "Skip ML enhancement and scoring for pure generation",
    "type": "boolean"
   },
   "variant": {
    "description": "Component variant (e.g., \"outline\", \"ghost\", \"gradient\", \"glass\", \"destructive\", \"loading\", \"icon\")",
    "type": "string"
   },
   "visual_style": {
    "description": "Visual style layer to apply",
    "enum": [
     "glassmorphism",
     "neubrutalism",
     "soft-depth",
     "bento-grid",
     "gradient-mesh",
     "dark-premium",
     "minimal-editorial",
     "linear-modern",
     "retro-playful",
     "corporate-trust"
    ],
    "type": "string"
   }
  },
  "required": [
   "component_type",
   "framework"
  ],
  "type": "object"
 },
 "name": "generate_ui_component"
}
