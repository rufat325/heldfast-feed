{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new feedback item in the Loopback bus.\n\nUse this to file any observation about a running product: a UI defect, a backend error, a usage insight, or a UX papercut. Every item is tagged to a project so the right agent picks it up later.\n\nArgs: project (slug), type (ui|backend|usage|ux), title, and optionally body, severity (p0-p3, default p2), source, reporter, route, url, dom_selector, screenshot_path, replay_url, console[], network[], repro_steps[].\n\nReturns the created item as JSON, including its generated id (fb_...). New items start with status 'open'.\n\nExample: file \"Pay button dead on iOS Safari\" with project='shop-web', type='ui', severity='p1', route='/checkout'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "default": "",
    "description": "Full description of the feedback/observation",
    "maxLength": 10000,
    "type": "string"
   },
   "console": {
    "default": [],
    "description": "Recent console log lines relevant to the issue",
    "items": {
     "maxLength": 2000,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "dom_selector": {
    "description": "CSS selector of the affected element",
    "maxLength": 500,
    "type": "string"
   },
   "extra": {
    "additionalProperties": {},
    "default": {},
    "description": "Free-form context object: LLM run ids/model/trace URLs for AI features, automation run metadata, viewport, element HTML snippet, etc.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "network": {
    "default": [],
    "description": "Relevant network requests (url, method, status, ms)",
    "items": {
     "properties": {
      "method": {
       "description": "HTTP method",
       "maxLength": 10,
       "type": "string"
      },
      "ms": {
       "description": "Duration in milliseconds",
       "type": "number"
      },
      "status": {
       "description": "HTTP status code",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "url": {
       "description": "Request URL",
       "maxLength": 2000,
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "project": {
    "description": "Project/repo slug this feedback belongs to, e.g. 'appbroda-web'",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "replay_url": {
    "description": "Session replay link (e.g. PostHog replay URL)",
    "maxLength": 2000,
    "type": "string"
   },
   "reporter": {
    "default": "human",
    "description": "Who reported it",
    "enum": [
     "human",
     "agent",
     "system"
    ],
    "type": "string"
   },
   "repro_steps": {
    "default": [],
    "description": "Steps to reproduce",
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   },
   "route": {
    "description": "App route where observed, e.g. '/checkout'",
    "maxLength": 500,
    "type": "string"
   },
   "screenshot_path": {
    "description": "Path or URL of a screenshot",
    "maxLength": 1000,
    "type": "string"
   },
   "severity": {
    "default": "p2",
    "description": "p0=critical, p1=high, p2=normal, p3=nice-to-have",
    "enum": [
     "p0",
     "p1",
     "p2",
     "p3"
    ],
    "type": "string"
   },
   "source": {
    "default": "manual",
    "description": "Where this feedback came from",
    "enum": [
     "manual",
     "widget",
     "stagewise",
     "sentry",
     "posthog",
     "jam",
     "other"
    ],
    "type": "string"
   },
   "title": {
    "description": "Short summary, e.g. 'Checkout button dead on mobile Safari'",
    "maxLength": 200,
    "minLength": 3,
    "type": "string"
   },
   "type": {
    "description": "Feedback dimension: 'ui' (visual/design), 'backend' (errors/API), 'usage' (analytics/behavior), 'ux' (flow/experience)",
    "enum": [
     "ui",
     "backend",
     "usage",
     "ux"
    ],
    "type": "string"
   },
   "url": {
    "description": "Full URL where observed",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "project",
   "type",
   "title"
  ],
  "type": "object"
 },
 "name": "loopback_submit_feedback",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignee_agent": {
    "description": "Agent currently holding the claim",
    "type": "string"
   },
   "attachments": {
    "description": "Files attached to this item. `intent` decides what you do with each: 'reference' is context for the fix and never ships; 'asset' is a deliverable \u2014 copy it from `path` to `target_path` in the repo, commit it, and record that with loopback_link_change. Read files from `path` directly rather than fetching `url`.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "intent": {
       "description": "'reference' = context only; 'asset' = a deliverable to copy into the repo",
       "enum": [
        "reference",
        "asset"
       ],
       "type": "string"
      },
      "mime": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "path": {
       "description": "Absolute path on this machine \u2014 read or copy it directly",
       "type": "string"
      },
      "size": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "target_path": {
       "description": "For assets: the repo-relative path this file should end up at",
       "type": "string"
      },
      "url": {
       "description": "Hub URL, for humans and browsers",
       "type": "string"
      }
     },
     "required": [
      "id",
      "created_at",
      "name",
      "mime",
      "size",
      "intent",
      "path",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "body": {
    "type": "string"
   },
   "comments": {
    "description": "Full audit trail",
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": "string"
      },
      "body": {
       "type": "string"
      },
      "created_at": {
       "type": "string"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "id",
      "created_at",
      "author",
      "body"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "console": {
    "description": "Console lines captured at report time",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "created_at": {
    "type": "string"
   },
   "dom_selector": {
    "type": "string"
   },
   "extra": {
    "additionalProperties": {},
    "description": "Free-form captured context. Read `extra.failed_responses` for failing requests with up to 2KB of response body, and `extra.context` for LLM/automation run metadata (run_id, model, trace_url).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "id": {
    "description": "Feedback id, e.g. 'fb_mabc12_3f9a1c'",
    "type": "string"
   },
   "links": {
    "additionalProperties": false,
    "description": "Repo/branch/commit/PR of the fix",
    "properties": {
     "branch": {
      "type": "string"
     },
     "commit": {
      "type": "string"
     },
     "diff_summary": {
      "type": "string"
     },
     "pr_url": {
      "type": "string"
     },
     "repo": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "network": {
    "description": "Network calls captured at report time",
    "items": {
     "additionalProperties": false,
     "properties": {
      "method": {
       "description": "HTTP method",
       "maxLength": 10,
       "type": "string"
      },
      "ms": {
       "description": "Duration in milliseconds",
       "type": "number"
      },
      "status": {
       "description": "HTTP status code",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "url": {
       "description": "Request URL",
       "maxLength": 2000,
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "project": {
    "type": "string"
   },
   "replay_url": {
    "type": "string"
   },
   "reporter": {
    "enum": [
     "human",
     "agent",
     "system"
    ],
    "type": "string"
   },
   "repro_steps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "resolution": {
    "type": "string"
   },
   "route": {
    "type": "string"
   },
   "screenshot_path": {
    "type": "string"
   },
   "severity": {
    "enum": [
     "p0",
     "p1",
     "p2",
     "p3"
    ],
    "type": "string"
   },
   "source": {
    "enum": [
     "manual",
     "widget",
     "stagewise",
     "sentry",
     "posthog",
     "jam",
     "other"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "open",
     "triaged",
     "in_progress",
     "fixed",
     "verified",
     "wontfix"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "type": {
    "enum": [
     "ui",
     "backend",
     "usage",
     "ux"
    ],
    "type": "string"
   },
   "updated_at": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "project",
   "created_at",
   "updated_at",
   "source",
   "reporter",
   "type",
   "severity",
   "title",
   "body",
   "console",
   "network",
   "repro_steps",
   "status",
   "links",
   "extra"
  ],
  "type": "object"
 },
 "title": "Submit feedback"
}
