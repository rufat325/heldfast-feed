{"description":"Create a time-based schedule on a profile. Rules and filter categories can reference schedules to apply only during the window.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"days":{"description":"Days of week, e.g. [\"mon\",\"tue\",\"wed\",\"thu\",\"fri\"]","items":{"enum":["mon","tue","wed","thu","fri","sat","sun"],"type":"string"},"type":"array"},"end":{"description":"HH:MM 24h, e.g. 21:00","pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$","type":"string"},"name":{"description":"Schedule name, e.g. Bedtime","type":"string"},"profile_id":{"description":"Profile ID (use list_profiles to discover IDs)","pattern":"^[A-Za-z0-9_-]+$","type":"string"},"start":{"description":"HH:MM 24h, e.g. 21:00","pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$","type":"string"},"timezone":{"description":"IANA timezone, e.g. America/Chicago","type":"string"}},"required":["profile_id","name","timezone","days","start","end"],"type":"object"},"name":"create_schedule"}
