  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get large trade counterparty makers"
 },
 "description": "Page the maker wallets of one counterparty execution past the first page its execution embeds. Percentages keep the whole execution as their denominator across pages.\n\nArgs:\n  - id (string, required): Large trade ID such as wt_123 or 123\n  - execution_id (string, required): execution_id of the execution\n  - snapshot_id (string, required): counterparty_analysis.snapshot_id from get_large_trade\n  - cursor (string, optional): makers_next_cursor from the execution or next_cursor from the previous page\n  - limit (number, 1-100, default 100): Makers per page\n\nReturns: items (makers), next_cursor, execution_id, snapshot_id and meta.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "makers_next_cursor from the execution, or next_cursor from the previous page",
    "type": "string"
   },
   "execution_id": {
    "description": "execution_id of one counterparty execution",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Large trade ID such as wt_123 or 123",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Max makers per page (1-100, default 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "snapshot_id": {
    "description": "counterparty_analysis.snapshot_id from get_large_trade",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "execution_id",
   "snapshot_id"
  ],
  "type": "object"
 },
