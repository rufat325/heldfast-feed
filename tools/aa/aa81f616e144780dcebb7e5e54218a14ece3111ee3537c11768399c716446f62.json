{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "screenings:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Submit invented data to sandbox@1. Requires synthetic=true and an idempotencyKey of 8\u2013128 URL-safe characters, reused unchanged with the same request for retries. Retains screening evidence according to policy and may create a review case; consumes sandbox allowance, never paid production allowance. Cannot screen production or link counterparties.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "idempotencyKey": {
    "pattern": "^[\\w:.-]{8,128}$",
    "type": "string"
   },
   "request": {
    "additionalProperties": false,
    "properties": {
     "counterpartyId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "package": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "policy": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
       },
       "version": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       }
      },
      "required": [
       "id",
       "version"
      ],
      "type": "object"
     },
     "reference": {
      "maxLength": 160,
      "type": "string"
     },
     "retention": {
      "default": "standard",
      "enum": [
       "standard",
       "minimal"
      ],
      "type": "string"
     },
     "sources": {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 512,
      "minItems": 1,
      "type": "array"
     },
     "subject": {
      "additionalProperties": false,
      "properties": {
       "birthDate": {
        "anyOf": [
         {
          "pattern": "^(?!0000)\\d{4}$",
          "type": "string"
         },
         {
          "pattern": "^(?!0000)\\d{4}-(0[1-9]|1[0-2])$",
          "type": "string"
         },
         {
          "allOf": [
           {
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
           },
           {
            "pattern": "^(?!0000)"
           }
          ],
          "type": "string"
         }
        ]
       },
       "country": {
        "maxLength": 100,
        "minLength": 2,
        "type": "string"
       },
       "entityType": {
        "default": "person",
        "enum": [
         "person",
         "organization",
         "vessel",
         "aircraft",
         "other"
        ],
        "type": "string"
       },
       "identifiers": {
        "default": [],
        "items": {
         "additionalProperties": false,
         "properties": {
          "issuer": {
           "maxLength": 100,
           "minLength": 1,
           "type": "string"
          },
          "type": {
           "maxLength": 80,
           "minLength": 1,
           "type": "string"
          },
          "value": {
           "maxLength": 160,
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "type",
          "value"
         ],
         "type": "object"
        },
        "maxItems": 20,
        "type": "array"
       },
       "name": {
        "maxLength": 300,
        "minLength": 2,
        "type": "string"
       }
      },
      "required": [
       "name"
      ],
      "type": "object"
     }
    },
    "required": [
     "subject"
    ],
    "type": "object"
   },
   "synthetic": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "request",
   "idempotencyKey",
   "synthetic"
  ],
  "type": "object"
 },
 "name": "run_sandbox_screening",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "screenings:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Test a sandbox screening"
}
