{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read published consulting services, pricing policy and contact URL. Use to assess engagement fit; does not book or send anything.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "language": {
    "default": "en",
    "enum": [
     "en",
     "de"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_services",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contactUrl": {
    "format": "uri",
    "type": "string"
   },
   "language": {
    "enum": [
     "en",
     "de"
    ],
    "type": "string"
   },
   "pricing": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "const": "EUR",
      "type": "string"
     },
     "hourlyRate": {
      "const": 120,
      "type": "number"
     },
     "publishedRates": {
      "const": true,
      "type": "boolean"
     },
     "type": {
      "const": "custom_quote",
      "type": "string"
     },
     "unit": {
      "const": "hour",
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     },
     "vatIncluded": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "type",
     "publishedRates",
     "hourlyRate",
     "currency",
     "unit",
     "vatIncluded",
     "url"
    ],
    "type": "object"
   },
   "services": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "description",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "language",
   "services",
   "pricing",
   "contactUrl"
  ],
  "type": "object"
 }
}
