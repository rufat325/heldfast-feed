{"description":"Tasks you can see, filtered by worker, job, status (open by default; done, cancelled or all) and due (overdue, today in shop time, or all). Overdue first, then by due time. A field worker sees their own tasks, tasks they made and tasks on jobs they are booked on.","inputSchema":{"properties":{"assignee_id":{"format":"uuid","type":"string"},"due":{"enum":["overdue","today","all"],"type":"string"},"job_id":{"format":"uuid","type":"string"},"limit":{"maximum":200,"minimum":1,"type":"integer"},"shop_id":{"format":"uuid","type":"string"},"status":{"enum":["open","done","cancelled","all"],"type":"string"}},"required":["shop_id"],"type":"object"},"name":"tasks_list","outputSchema":{"properties":{"tasks":{"items":{"properties":{"assignee_id":{"format":"uuid","type":["string","null"]},"assignee_name":{"type":["string","null"]},"chased_at":{"format":"date-time","type":["string","null"]},"close_note":{"type":["string","null"]},"closed_at":{"format":"date-time","type":["string","null"]},"created_at":{"format":"date-time","type":"string"},"created_by":{"format":"uuid","type":"string"},"due_at":{"format":"date-time","type":["string","null"]},"job_id":{"format":"uuid","type":["string","null"]},"job_summary":{"type":["string","null"]},"note_id":{"format":"uuid","type":["string","null"]},"overdue":{"type":"boolean"},"shop_id":{"format":"uuid","type":"string"},"status":{"type":"string"},"task_id":{"format":"uuid","type":"string"},"title":{"type":"string"}},"required":["task_id","shop_id","job_id","job_summary","note_id","title","assignee_id","assignee_name","due_at","status","overdue","created_by","created_at","closed_at","close_note","chased_at"],"type":"object"},"type":"array"}},"required":["tasks"],"type":"object"}}
