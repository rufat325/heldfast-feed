{
 "description": "Create a Decision Lineage Receipt \u2014 traces which data sources influenced a decision. Right-to-explanation primitive.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contributingSources": {
    "items": {
     "properties": {
      "accessReceiptId": {
       "type": "string"
      },
      "compensationStatus": {
       "enum": [
        "settled",
        "pending",
        "disputed",
        "revoked"
       ],
       "type": "string"
      },
      "derivationDepth": {
       "type": "number"
      },
      "lineageConfidence": {
       "enum": [
        "complete",
        "partial",
        "asserted",
        "inferred",
        "broken_external",
        "unverifiable"
       ],
       "type": "string"
      },
      "sourceId": {
       "type": "string"
      },
      "termsVersionAtAccess": {
       "type": "string"
      },
      "transformPath": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "sourceId",
      "accessReceiptId",
      "derivationDepth",
      "transformPath",
      "termsVersionAtAccess",
      "lineageConfidence",
      "compensationStatus"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "decisionArtifactId": {
    "type": "string"
   },
   "decisionType": {
    "description": "E.g. loan_approval, content_moderation, risk_assessment",
    "type": "string"
   },
   "explanation": {
    "type": "string"
   },
   "governingPurpose": {
    "type": "string"
   },
   "lineageCompleteness": {
    "enum": [
     "complete",
     "partial",
     "asserted",
     "broken_external"
    ],
    "type": "string"
   },
   "transformChain": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "decisionArtifactId",
   "decisionType",
   "contributingSources",
   "lineageCompleteness"
  ],
  "type": "object"
 },
 "name": "create_decision_lineage_receipt"
}
