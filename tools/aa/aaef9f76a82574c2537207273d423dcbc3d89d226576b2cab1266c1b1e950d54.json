{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Repository Dependency Map"
 },
 "description": "Build a cross-repository dependency map showing where a dependency appears across the source repo, optional compared repos, and (optionally) the public index. Returns structured JSON. Consumes credits.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compare_repos": {
    "description": "Repository UUIDs to compare against (max 10)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "demo": {
    "description": "Run in demo mode (pre-signup, public data, IP-based credits)",
    "type": "boolean"
   },
   "dependency": {
    "description": "Dependency name to map",
    "type": "string"
   },
   "files_per_repo": {
    "description": "Max files per repo (default 25)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "include_public_index": {
    "description": "Include matches from the public index (default false)",
    "type": "boolean"
   },
   "limit": {
    "description": "Max dependencies (default 25)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "repo_key": {
    "description": "Repository UUID or clone URL",
    "type": "string"
   },
   "type": {
    "description": "Dependency type filter",
    "enum": [
     "package",
     "import",
     "export",
     "env"
    ],
    "type": "string"
   }
  },
  "required": [
   "repo_key"
  ],
  "type": "object"
 },
 "name": "code-fundi-repo-map"
}
