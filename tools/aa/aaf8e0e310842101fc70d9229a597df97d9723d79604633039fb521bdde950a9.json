{
 "description": "Record a change you or your agent made to a site (deploy, copy edit, campaign) so it can be correlated with analytics later.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actor": {
    "description": "optional actor label (default: agent)",
    "type": "string"
   },
   "description": {
    "description": "what changed, plain English",
    "type": "string"
   },
   "path": {
    "description": "optional page path e.g. /pricing",
    "type": "string"
   },
   "site": {
    "description": "site slug the change targets",
    "type": "string"
   },
   "tag": {
    "description": "optional tag e.g. campaign, content, fix",
    "type": "string"
   }
  },
  "required": [
   "description",
   "site"
  ],
  "type": "object"
 },
 "name": "log_change"
}
