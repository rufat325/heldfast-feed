     "US",
     "UK",
     "CA",
     "AU",
     "DE",
     "FR"
    ],
    "type": "string"
   },
   "q": {
    "description": "Item description, e.g. 'forklift'",
    "type": "string"
   },
   "state": {
    "description": "Optional 2-letter state/region code.",
    "type": "string"
   }
  },
  "required": [
