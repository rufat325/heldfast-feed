{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Ranked facets for the entire filtered bibliography before pagination. Uses the same selection rules as search_publications.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "added_since": {
    "description": "Added to AMIRA on or after this ISO date",
    "maxLength": 40,
    "type": "string"
   },
   "author": {
    "description": "Author/editor name, either name order",
    "maxLength": 1000,
    "type": "string"
   },
   "facet": {
    "enum": [
     "type",
     "year",
     "language",
     "subject",
     "author",
     "venue"
    ],
    "type": "string"
   },
   "has_fulltext": {
    "description": "Filter by extracted full-text availability",
    "type": "boolean"
   },
   "keyword": {
    "description": "Title, abstracts, venue, subjects or full text; every word must match, quote a phrase",
    "maxLength": 1000,
    "type": "string"
   },
   "language": {
    "description": "Language name or ISO code",
    "maxLength": 1000,
    "type": "string"
   },
   "limit": {
    "description": "Default 25, max 100",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "subject": {
    "description": "Subject heading, partial",
    "maxLength": 1000,
    "type": "string"
   },
   "type": {
    "description": "Exact type; discover values with list_publication_facets",
    "maxLength": 1000,
    "type": "string"
   },
   "venue": {
    "description": "Journal/book title, partial",
    "maxLength": 1000,
    "type": "string"
   },
   "year_from": {
    "maximum": 2200,
    "minimum": 0,
    "type": "integer"
   },
   "year_to": {
    "maximum": 2200,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "facet"
  ],
  "type": "object"
 },
 "name": "list_publication_facets",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "effective_limit": {
    "type": "number"
   },
   "facet": {
    "type": "string"
   },
   "filters": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "has_more": {
    "type": "boolean"
   },
   "missing_values": {
    "type": "number"
   },
   "next_offset": {
    "type": "number"
   },
   "offset": {
    "type": "number"
   },
   "requested_limit": {
    "type": "number"
   },
   "response_limited": {
    "type": "boolean"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amira_url": {
       "type": "string"
      },
      "publication_count": {
       "type": "number"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "value",
      "publication_count"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_matches": {
    "type": "number"
   },
   "total_publications": {
    "type": "number"
   }
  },
  "required": [
   "facet",
   "total_publications",
   "missing_values",
   "count",
   "total_matches",
   "offset",
   "has_more",
   "results"
  ],
  "type": "object"
 },
 "title": "Publication facets"
}
