{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Write state of a root"
 },
 "description": "Read-only snapshot of a root's write state, same as `axiom status --json`: who holds .axiom/lock (pid, host, digest, since, stale), the wait queue, registered in-flight intents (paths), interrupted journals that need `axiom_rollback`, the last applied chain entry and whether the journal hash chain verifies. Never takes the lock.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "root": {
    "description": "Absolute repository root; must equal or lie inside an allowlisted --root",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "axiom_status",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "additionalProperties": false,
    "properties": {
     "entries": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "firstBad": {
      "additionalProperties": false,
      "properties": {
       "reason": {
        "enum": [
         "prev-mismatch",
         "seq-gap",
         "parse"
        ],
        "type": "string"
       },
       "seq": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       }
      },
      "required": [
       "seq",
       "reason"
      ],
      "type": "object"
     },
     "head": {
      "description": "sha256:<64 lowercase hex>",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "missingJournals": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "ok": {
      "type": "boolean"
     }
    },
    "required": [
     "ok",
     "entries",
     "head",
     "missingJournals"
    ],
    "type": "object"
   },
   "corrupt": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "interrupted": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "done": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "files": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "manifestDigest": {
       "description": "sha256:<64 lowercase hex>",
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      },
      "phase": {
       "enum": [
        "staged",
        "committing",
        "committed",
        "rolling-back",
        "rolled-back"
       ],
       "type": "string"
      },
      "pid": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "startedAt": {
       "type": "string"
      }
     },
     "required": [
      "manifestDigest",
      "phase",
      "startedAt",
      "pid",
      "files",
      "done"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "lastApplied": {
    "additionalProperties": false,
    "properties": {
     "at": {
      "type": "string"
     },
     "code": {
      "type": "string"
     },
     "files": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "manifestDigest": {
      "description": "sha256:<64 lowercase hex>",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "prev": {
      "description": "sha256:<64 lowercase hex>",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "seq": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "state": {
      "enum": [
       "committed",
       "rolled-back",
       "failed"
      ],
      "type": "string"
     }
    },
    "required": [
     "seq",
     "manifestDigest",
     "state",
     "at",
     "prev",
     "files"
    ],
    "type": "object"
   },
   "lock": {
    "additionalProperties": false,
    "properties": {
     "held": {
      "type": "boolean"
     },
     "holder": {
      "additionalProperties": false,
      "properties": {
       "digest": {
        "type": "string"
       },
       "host": {
        "type": "string"
       },
       "pid": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "since": {
        "type": "string"
       },
       "stale": {
        "type": "boolean"
       }
      },
      "required": [
       "pid",
       "stale"
      ],
      "type": "object"
     },
     "intents": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "digest": {
         "type": "string"
        },
        "paths": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "pid": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "since": {
         "type": "string"
        }
       },
       "required": [
        "digest",
        "paths",
        "pid",
        "since"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "queue": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "pid": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "since": {
         "type": "string"
        }
       },
       "required": [
        "pid",
        "since"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "held",
     "queue",
     "intents"
    ],
    "type": "object"
   },
   "root": {
    "type": "string"
   }
  },
  "required": [
   "root",
   "lock",
   "interrupted",
   "corrupt",
   "chain"
  ],
  "type": "object"
 },
 "title": "Write state of a root"
}
