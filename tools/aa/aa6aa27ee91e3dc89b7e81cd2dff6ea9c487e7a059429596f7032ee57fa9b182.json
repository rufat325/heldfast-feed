{
 "_meta": {
  "openai/outputTemplate": "ui://soclo/chat-ads/v2.html",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "plan:create",
     "generate:video",
     "read:wallet"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://soclo/chat-ads/v2.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Approve and film one video variant"
 },
 "description": "THIS SPENDS CREDITS. Films ONE exact owner-approved variant with its original request ID, after a fresh matching quote; pass the full variants page (as returned by soclo_video_variants_quote) and approval carrying that variant\u2019s exact projectId, revision, quoteId, expectedCredits and clientRequestId. Only after the owner has seen and approved that quote. It refuses if the saved storyboard or the current quote differs. UNKNOWN permits status only (soclo_video_variants_status); never replay an unknown Make. Persist all returned IDs in host context/widget state. One result is one finished Soclo render, never joined agent-local clips. Wallet/ledger and soclo_video_make remain authoritative.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approval": {
    "additionalProperties": false,
    "description": "The exact displayed project, revision, quote, credits and request identity of the ONE variant being approved.",
    "properties": {
     "clientRequestId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "expectedCredits": {
      "minimum": 0,
      "type": "number"
     },
     "projectId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "quoteId": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "revision": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "projectId",
     "revision",
     "quoteId",
     "expectedCredits",
     "clientRequestId"
    ],
    "type": "object"
   },
   "variants": {
    "description": "Transport page of existing saved host projects, not an engine craft limit; use more pages if needed.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "clientRequestId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "dispatchConnected": {
       "type": "boolean"
      },
      "expectedCredits": {
       "minimum": 0,
       "type": "number"
      },
      "generationId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "hook": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "label": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "makeReady": {
       "type": "boolean"
      },
      "projectId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "quoteId": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      },
      "revision": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "hook",
      "projectId",
      "revision",
      "clientRequestId"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "variants",
   "approval"
  ],
  "type": "object"
 },
 "name": "soclo_video_variants_approve",
 "title": "Approve and film one video variant"
}
