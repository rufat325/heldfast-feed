{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get the launch leaderboard"
 },
 "description": "SaaSCity's most upvoted launches for this week's launch, the last 30 days, or all time, optionally within one category.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Listing category id",
    "enum": [
     "ai",
     "saas",
     "productivity",
     "devtools",
     "design",
     "marketing",
     "fintech",
     "health",
     "mobile",
     "games",
     "web3",
     "molt",
     "directories",
     "other"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "How many to return",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "period": {
    "default": "week",
    "description": "week = this Monday's launch",
    "enum": [
     "week",
     "month",
     "all_time"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_leaderboard",
 "outputSchema": {
  "properties": {
   "listings": {
    "items": {
     "properties": {
      "category": {
       "type": "string"
      },
      "pageUrl": {
       "description": "SaaSCity listing page",
       "type": "string"
      },
      "points": {
       "description": "Community upvote points",
       "type": "integer"
      },
      "slug": {
       "description": "Pass to get_listing or find_alternatives",
       "type": "string"
      },
      "tagline": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "websiteUrl": {
       "description": "The product site",
       "type": "string"
      }
     },
     "required": [
      "title",
      "tagline",
      "slug",
      "category",
      "points",
      "pageUrl",
      "websiteUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "period": {
    "type": "string"
   },
   "weekStart": {
    "description": "Present for period=week",
    "type": "string"
   }
  },
  "required": [
   "listings",
   "period"
  ],
  "type": "object"
 },
 "title": "Get the launch leaderboard"
}
