{
 "description": "Revise an existing draft in place: only the fields you pass change, the rest are left alone. Still does NOT deliver anything. Use this to apply the user's edits instead of creating a second draft. Drafts that have already been sent cannot be edited.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "from": {
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "html": {
    "description": "Replaces the HTML body",
    "type": "string"
   },
   "id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "subject": {
    "maxLength": 998,
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "description": "Replaces the plain-text body",
    "type": "string"
   },
   "to": {
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_draft"
}
