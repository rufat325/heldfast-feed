    "type": [
     "string",
     "null"
    ]
   },
   "start_utc": {
    "type": "string"
   },
   "totals": {
    "additionalProperties": true,
    "properties": {
     "gap_min": {
      "type": "number"
     },
     "segments": {
      "type": "number"
     },
     "switches": {
      "type": "number"
     },
     "total_filled_min": {
      "type": "number"
     }
    },
    "required": [
     "segments",
     "total_filled_min",
     "gap_min",
     "switches"
    ],
    "type": "object"
   }
  },
  "required": [
   "ok",
   "asked_at_utc",
   "start_utc",
   "end_utc",
   "duration_budget_min",
   "mood",
   "mood_label_ro",
   "plan",
   "totals",
