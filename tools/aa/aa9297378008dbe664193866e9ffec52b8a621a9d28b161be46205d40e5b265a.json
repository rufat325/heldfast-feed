{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan an evening"
 },
 "description": "Builds a TV watching plan that FILLS a window of time \u2014 either one long programme or 2-3 consecutive programmes with small gaps, ordered as a timeline. Use it when the user wants a schedule for the whole evening or a long window (3+ hours) rather than a single pick: \"plan my evening\", \"ce v\u0103d toat\u0103 seara\", \"f\u0103-mi un program pentru 20\u201324\". TV only (live Romanian EPG, no streaming titles); for ONE decision that may also be a streaming title, use tv_concierge. Accepts start time, duration budget, mood, and channel preferences. Output: ordered timeline + alternatives dropped + totals.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allow_channel_switch": {
    "default": true,
    "type": "boolean"
   },
   "duration_min": {
    "default": 180,
    "maximum": 360,
    "minimum": 30,
    "type": "integer"
   },
   "max_gap_min": {
    "default": 10,
    "maximum": 30,
    "minimum": 0,
    "type": "integer"
   },
   "max_segments": {
    "default": 3,
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "mood": {
    "type": "string"
   },
   "prefer": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "start": {
    "default": "20:00",
    "description": "Start time: \"now\" | \"HH:MM\" (Europe/Bucharest) | ISO instant",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tv_plan_evening",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alternatives": {
    "items": {
     "$ref": "#/properties/plan/items"
    },
    "type": "array"
   },
   "asked_at_utc": {
    "type": "string"
   },
   "duration_budget_min": {
    "type": "number"
   },
   "end_utc": {
    "type": "string"
   },
   "freshness": {
    "additionalProperties": true,
    "properties": {
     "epg_age_min": {
      "type": [
       "number",
       "null"
      ]
     },
     "stale": {
      "type": "boolean"
     },
     "streaming_age_min": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "stale"
    ],
    "type": "object"
   },
   "mood": {
    "type": "string"
   },
   "mood_label_ro": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "plan": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
