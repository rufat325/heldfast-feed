{
 "description": "Parses CSV text (header row required) and reports per-column non-empty/empty value counts across the data rows. No numeric aggregation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "delimiter": {
    "type": "string"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "csv_stats",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "columnCount": {
    "type": "integer"
   },
   "columns": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "empty": {
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "nonEmpty": {
       "type": "integer"
      }
     },
     "required": [
      "name",
      "nonEmpty",
      "empty"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "rowCount": {
    "type": "integer"
   }
  },
  "required": [
   "rowCount",
   "columnCount",
   "columns"
  ],
  "type": "object"
 }
}
