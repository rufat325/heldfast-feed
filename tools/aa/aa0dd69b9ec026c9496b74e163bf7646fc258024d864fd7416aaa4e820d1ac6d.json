{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a task"
 },
 "description": "Create a task in a task list (tasklist_id) or a project (project_id \u2014 goes to its 'Default Task List'). Paymo: POST /api/tasks.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "billable": {
    "description": "Whether the task is billable.",
    "type": "boolean"
   },
   "budget_hours": {
    "description": "Budget hours for the task.",
    "minimum": 0,
    "type": "number"
   },
   "description": {
    "description": "Task description / notes.",
    "type": "string"
   },
   "due_date": {
    "description": "Due date.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "name": {
    "description": "Task name.",
    "minLength": 1,
    "type": "string"
   },
   "priority": {
    "anyOf": [
     {
      "const": 25,
      "type": "number"
     },
     {
      "const": 50,
      "type": "number"
     },
     {
      "const": 75,
      "type": "number"
     },
     {
      "const": 100,
      "type": "number"
     }
    ],
    "description": "Priority: 25 low, 50 normal, 75 high, 100 critical."
   },
   "project_id": {
    "description": "Project to add the task to (used when tasklist_id is not given).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "tasklist_id": {
    "description": "Task list to add the task to.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "users": {
    "description": "Assignee user ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "paymo_create_task",
 "title": "Create a task"
}
