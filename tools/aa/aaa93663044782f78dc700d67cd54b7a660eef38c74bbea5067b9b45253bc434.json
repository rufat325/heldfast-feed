{
 "_meta": {
  "fastmcp": {
   "tags": []
  }
 },
 "description": "Generic Base mainnet event log search via eth_getLogs - filter by contract address and/or up to 4 topics over a block range (max 2,000 blocks).",
 "inputSchema": {
  "properties": {
   "payload": {
    "properties": {
     "address": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Address"
     },
     "from_block": {
      "minimum": 0,
      "title": "From Block",
      "type": "integer"
     },
     "to_block": {
      "minimum": 0,
      "title": "To Block",
      "type": "integer"
     },
     "topics": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "maxItems": 4,
      "title": "Topics",
      "type": "array"
     }
    },
    "required": [
     "from_block",
     "to_block"
    ],
    "title": "EventsInput",
    "type": "object"
   }
  },
  "required": [
   "payload"
  ],
  "type": "object"
 },
 "name": "base_events",
 "title": "Base Events"
}
