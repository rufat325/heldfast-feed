{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List tutorial videos"
 },
 "description": "Use this when someone asks which tutorial videos exist, optionally for one project, tutorial, language or device. Returns each video's id, tutorial, language, device, format, dimensions, file size and URL, most recently edited first, 25 per page by default. Not for checking missing languages.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page with the same filters; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "device": {
    "description": "Only videos for this device: computer, tablet or smartphone",
    "maxLength": 100,
    "type": "string"
   },
   "limit": {
    "description": "Videos per page, from 1 to 100; defaults to 25",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "locale": {
    "description": "Only videos in this language code, e.g. en or pt-BR",
    "maxLength": 32,
    "type": "string"
   },
   "projectId": {
    "description": "Only videos in this project",
    "maxLength": 200,
    "type": "string"
   },
   "tutorialId": {
    "description": "Only videos of this tutorial",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_videos",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceFilter": {
    "anyOf": [
     {
      "maxLength": 100,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "hasMore": {
    "type": "boolean"
   },
   "localeFilter": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 4096,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   },
   "offset": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "projectIdFilter": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "returned": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "enum": [
     "found",
     "empty"
    ],
    "type": "string"
   },
   "tutorialIdFilter": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "videos": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "device": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "fileSize": {
       "anyOf": [
        {
         "maximum": 1000000000000000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "format": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "height": {
       "anyOf": [
        {
         "maximum": 100000,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "locale": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "projectId": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "tutorialId": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "width": {
       "anyOf": [
        {
         "maximum": 100000,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "tutorialId",
      "projectId",
      "url",
      "locale",
      "device",
      "format",
      "width",
      "height",
      "fileSize",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "status",
   "projectIdFilter",
   "tutorialIdFilter",
   "localeFilter",
   "deviceFilter",
   "videos",
   "offset",
   "returned",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List tutorial videos"
}
