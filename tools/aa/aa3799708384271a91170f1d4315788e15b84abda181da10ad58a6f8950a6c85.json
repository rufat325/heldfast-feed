{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the documents owned by the authenticated account (requires an lp_ API key), newest first, with cursor pagination.",
 "inputSchema": {
  "properties": {
   "cursor": {
    "description": "The nextCursor value from a previous call.",
    "type": "string"
   },
   "limit": {
    "description": "Max documents to return (1-200, default 50).",
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_docs",
 "outputSchema": {
  "properties": {
   "docs": {
    "items": {
     "properties": {
      "expires_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "updated_at": {
       "type": "string"
      },
      "view_count": {
       "type": "integer"
      },
      "visibility": {
       "type": "string"
      }
     },
     "required": [
      "slug"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextCursor": {
    "description": "Pass as the cursor argument for the next page; null when the listing is exhausted",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "docs",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List your documents"
}
