{
 "description": "Create a client-attributed labeling project as an ACTIVE operator (labeling work types only; the client label groups your delivery console). Requires operator:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clientLabel": {
    "description": "Which downstream client this project serves",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "projectType": {
    "enum": [
     "IMAGE_ANNOTATION",
     "TEXT_ANNOTATION",
     "DOCUMENT_ANNOTATION",
     "VIDEO_AUDIO_ANNOTATION",
     "GENERAL_LABEL_STUDIO"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "projectType",
   "clientLabel"
  ],
  "type": "object"
 },
 "name": "opentrain_operator_project_create",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
