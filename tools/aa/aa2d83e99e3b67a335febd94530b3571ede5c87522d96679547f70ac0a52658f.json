{
 "annotations": {
  "destructiveHint": true,
  "title": "Log a CRM interaction"
 },
 "description": "Record a call, email, meeting or contact with a customer or lead, with an optional note and call outcome. Requires a super_admin-level token. TeamUp: POST /crm/interactions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "call_outcome": {
    "description": "Outcome \u2014 only for interaction_type=Call.",
    "enum": [
     "Connected",
     "No Answer",
     "Voicemail"
    ],
    "type": "string"
   },
   "customer": {
    "description": "The customer's numeric id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "interaction_type": {
    "description": "Kind of interaction.",
    "enum": [
     "Call",
     "Contacted",
     "Email",
     "Meeting"
    ],
    "type": "string"
   },
   "note": {
    "description": "Free-text notes about the interaction.",
    "type": "string"
   }
  },
  "required": [
   "customer",
   "interaction_type"
  ],
  "type": "object"
 },
 "name": "goteamup_log_crm_interaction",
 "title": "Log a CRM interaction"
}
