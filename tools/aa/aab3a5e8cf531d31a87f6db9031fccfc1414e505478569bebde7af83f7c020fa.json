{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Entity"
 },
 "description": "Get detailed information about a specific entity by its slug ID. Returns name, type, aliases, description, related entities, and citation count.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "entity_id": {
    "description": "Entity slug ID. Example: \"god-the-father\"",
    "type": "string"
   }
  },
  "required": [
   "entity_id"
  ],
  "type": "object"
 },
 "name": "entities.get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entity": {
    "additionalProperties": false,
    "properties": {
     "aliases": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "citationCount": {
      "description": "Number of citations in the source index. A citation of a whole section counts once, so the entity's paragraph total can be higher.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "description": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "seeAlso": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "description": "Related entry names. An entity with citationCount 0 is a cross-reference stub: follow seeAlso to the entry that has the paragraphs."
     },
     "type": {
      "enum": [
       "being",
       "place",
       "order",
       "race",
       "religion",
       "concept"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "type",
     "aliases",
     "description",
     "seeAlso",
     "citationCount"
    ],
    "type": "object"
   }
  },
  "required": [
   "entity"
  ],
  "type": "object"
 },
 "title": "Get Entity"
}
