{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Capture bounded evidence from the current stopped debug state without resuming execution. Use this when an agent needs raw stack, locals, registers, exception details, modules, or nearby instructions; prefer debug_diagnose_stop when you also want ranked crash hypotheses and project-frame selection. This is read-only with respect to the debuggee and returns best-effort evidence plus collection errors for optional data that an adapter cannot provide.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"disassembleAfter":{"default":12,"description":"Number of instructions after the current instruction to request when disassembly is enabled.","maximum":100,"minimum":0,"type":"integer"},"disassembleBefore":{"default":8,"description":"Number of instructions before the current instruction to request when disassembly is enabled.","maximum":100,"minimum":0,"type":"integer"},"includeDisassembly":{"default":true,"description":"Include best-effort instructions around the selected frame instruction pointer when supported.","type":"boolean"},"includeExceptionInfo":{"default":true,"description":"Include structured exception information for the stopped thread when the adapter supports it.","type":"boolean"},"includeModules":{"default":false,"description":"Include a bounded list of loaded executable images and libraries.","type":"boolean"},"maxVariablesPerScope":{"default":100,"description":"Maximum variables returned per inspected scope, bounding output size.","exclusiveMinimum":0,"maximum":500,"type":"integer"},"moduleCount":{"default":50,"description":"Maximum loaded modules to return when includeModules is true.","exclusiveMinimum":0,"maximum":500,"type":"integer"},"sessionId":{"description":"Optional DAP session ID. Omit to use the backward-compatible default session.","maxLength":64,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za