{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "imagelato:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check webhook delivery health"
 },
 "description": "Use this when someone asks whether their Imagelato webhooks are working, failing or disabled. Returns each endpoint's origin, subscribed events, active flag and consecutive failures, 25 per page by default; an endpoint is disabled after 20 failures in a row. Not for adding or editing a webhook.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page with the same filters; absent for the first page",
    "maxLength": 1024,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "limit": {
    "description": "Results per page, from 1 to 100; defaults to 25",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "description": "Only webhooks of this project; every project when absent",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_webhook_subscriptions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "description": "Delivery health for one endpoint origin; an endpoint is disabled after 20 consecutive failures. Full endpoint URLs, signing secrets and ownership fields are excluded.",
     "properties": {
      "active": {
       "type": "boolean"
      },
      "allEvents": {
       "type": "boolean"
      },
      "consecutiveFailures": {
       "maximum": 999999,
       "minimum": 0,
       "type": "integer"
      },
      "edited": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "events": {
       "items": {
        "maxLength": 80,
        "type": "string"
       },
       "maxItems": 10,
       "type": "array"
      },
      "origin": {
       "maxLength": 300,
       "type": "string"
      }
     },
     "required": [
      "origin",
      "events",
      "allEvents",
      "active",
      "consecutiveFailures",
      "edited"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 1024,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   },
   "total": {
    "description": "Matching records across all pages",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "items",
   "total",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "Check webhook delivery health"
}
