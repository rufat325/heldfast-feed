{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Start general traveler verification for this MCP session after the traveler confirms their email address. Uses the property\u2019s configured verification method. This does not create a quote, enquiry, hold, or booking.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agentName": {
    "type": "string"
   },
   "agentProvider": {
    "type": "string"
   },
   "emailConfirmedByTraveler": {
    "description": "True only after the traveler confirms the exact email address.",
    "type": "boolean"
   },
   "guestEmail": {
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "guestName": {
    "minLength": 1,
    "type": "string"
   },
   "guestPhone": {
    "type": "string"
   },
   "method": {
    "enum": [
     "EMAIL_CODE",
     "EMAIL_LINK",
     "SMS_CODE",
     "WHATSAPP_CODE"
    ],
    "type": "string"
   },
   "propertyToken": {
    "type": "string"
   }
  },
  "required": [
   "guestName",
   "guestEmail",
   "emailConfirmedByTraveler"
  ],
  "type": "object"
 },
 "name": "start_traveler_verification"
}
