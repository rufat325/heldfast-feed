{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Fetch webhook message"
 },
 "description": "Fetch a single message sent through a webhook (id, content, embed count, timestamp), using the webhook's ID and token. Read-only. Requires the original webhook token.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "message_id": {
    "description": "ID of the webhook message to fetch.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "webhook_id": {
    "description": "ID (snowflake) of the webhook that sent the message.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "webhook_token": {
    "description": "Secret token of the webhook.",
    "type": "string"
   }
  },
  "required": [
   "webhook_id",
   "webhook_token",
   "message_id"
  ],
  "type": "object"
 },
 "name": "discord_fetch_webhook_message",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "content": {
    "type": "string"
   },
   "embeds": {
    "type": "number"
   },
   "id": {
    "type": "string"
   },
   "timestamp": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "content",
   "embeds",
   "timestamp"
  ],
  "type": "object"
 }
}
