  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "confirmation_id": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "message": {
    "maxLength": 4000,
    "minLength": 3,
    "type": "string"
   },
   "order_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "subject": {
    "maxLength": 200,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "subject",
   "message"
  ],
  "type": "object"
 },
 "name": "create_support_ticket",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "propertyNames": {
   "type": "string"
  },
  "type": "object"
 },
 "title": "Create Support Ticket"
}
