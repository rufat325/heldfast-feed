     "support.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a new customer support request to Vaanzari staff after signed-in browser approval. The submitted message cannot be unsent.",
