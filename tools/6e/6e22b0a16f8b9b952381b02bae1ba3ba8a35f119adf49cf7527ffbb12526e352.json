{
 "description": "Store a writing sample (something the user actually wrote) so HumanifyMe can learn their voice. Text must be at least 100 characters and carry at least one context label.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "labels": {
    "items": {
     "enum": [
      "casual",
      "professional",
      "annoyed",
      "polite",
      "direct",
      "sales",
      "email",
      "text",
      "linkedin"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "text": {
    "minLength": 100,
    "type": "string"
   }
  },
  "required": [
   "text",
   "labels"
  ],
  "type": "object"
 },
 "name": "humanify_add_sample"
}
