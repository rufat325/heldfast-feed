{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Company Filings Summary"
 },
 "description": "Retrieve a structured overview of a company's SEC filing activity. Returns the most recent 20 filings and pre-computed signals: filing velocity (ACCELERATING / NORMAL / SLOWING vs. trailing 365-day average), material event count in the last 90 days, 10-K disclosure volume trend (RISING / STABLE / FALLING), and the unique form types filed in the last 90 days. Use this as a first-pass signal before digging into insider or material-event detail.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ticker_or_cik": {
    "description": "Ticker symbol (e.g. \"AAPL\") or numeric CIK (e.g. \"320193\" or \"0000320193\").",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ticker_or_cik"
  ],
  "type": "object"
 },
 "name": "get_company_filings_summary",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cik": {
    "type": "string"
   },
   "company_name": {
    "type": [
     "string",
     "null"
    ]
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "data_delay": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "timestamp": {
      "type": "string"
     }
    },
    "required": [
     "source",
     "timestamp",
     "data_delay"
    ],
    "type": "object"
   },
   "recent_filings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accession_number": {
       "type": "string"
      },
      "filing_date": {
       "type": "string"
      },
      "form": {
       "type": "string"
      },
      "items": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "primary_doc_description": {
       "type": [
        "string",
        "null"
       ]
      },
      "sec_url": {
       "type": "string"
      }
     },
     "required": [
      "accession_number",
      "form",
      "filing_date",
      "primary_doc_description",
      "items",
      "sec_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "signals": {
    "additionalProperties": false,
    "properties": {
     "disclosure_volume_trend": {
      "anyOf": [
       {
        "enum": [
         "RISING",
         "STABLE",
         "FALLING"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "filing_velocity": {
      "anyOf": [
       {
        "enum": [
         "ACCELERATING",
         "NORMAL",
         "SLOWING"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "latest_form_types": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "material_event_count_90d": {
      "type": "number"
     }
    },
    "required": [
     "filing_velocity",
     "material_event_count_90d",
     "disclosure_volume_trend",
     "latest_form_types"
    ],
    "type": "object"
   },
   "ticker": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "ticker",
   "cik",
   "company_name",
   "recent_filings",
   "signals",
   "meta"
  ],
  "type": "object"
 },
 "title": "Company Filings Summary"
}
