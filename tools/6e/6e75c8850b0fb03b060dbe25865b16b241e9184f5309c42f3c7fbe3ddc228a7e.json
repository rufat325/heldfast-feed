{
 "description": "Fetch the structured JSON result for one processed Suparse document using the direct single-document result endpoint. Use fetch_json_results when fetching multiple document IDs or an export selection.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_url": {
    "description": "Optional API base URL. Defaults to SUPARSE_API_URL or Suparse production API.",
    "format": "uri",
    "type": "string"
   },
   "document_id": {
    "description": "Suparse document ID to fetch.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "document_id"
  ],
  "type": "object"
 },
 "name": "fetch_document_result",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "documents": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "credits_used": {
       "type": "number"
      },
      "document_id": {
       "type": "string"
      },
      "extracted_data": {
       "additionalProperties": {},
       "type": "object"
      },
      "file_name": {
       "type": "string"
      },
      "page_end": {
       "type": "number"
      },
      "page_start": {
       "type": "number"
      },
      "template_id": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "document_id",
      "file_name",
      "page_start",
      "page_end",
      "template_id",
      "credits_used",
      "extracted_data"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "original_file": {
    "type": "string"
   },
   "task_id": {
    "type": "string"
   },
   "total_documents_extracted": {
    "type": "number"
   }
  },
  "required": [
   "task_id",
   "original_file",
   "total_documents_extracted",
   "documents"
  ],
  "type": "object"
 },
 "title": "Fetch Document Result"
}
