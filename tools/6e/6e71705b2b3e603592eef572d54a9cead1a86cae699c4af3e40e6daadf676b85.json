{
 "description": "Search emails with filters. By default returns compact results without full body content to save context. Set returnBody=true to include full email bodies.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "type": "string"
   },
   "before": {
    "type": "string"
   },
   "body": {
    "type": "string"
   },
   "folder": {
    "type": "string"
   },
   "from": {
    "type": "string"
   },
   "hasAttachment": {
    "type": "boolean"
   },
   "limit": {
    "type": "number"
   },
   "offset": {
    "type": "number"
   },
   "returnBody": {
    "description": "Include full email body in results (default: false). Set to true only when you need the full content.",
    "type": "boolean"
   },
   "since": {
    "type": "string"
   },
   "starredOnly": {
    "type": "boolean"
   },
   "subject": {
    "type": "string"
   },
   "to": {
    "type": "string"
   },
   "unreadOnly": {
    "type": "boolean"
   }
  },
  "required": [
   "accountId"
  ],
  "type": "object"
 },
 "name": "email_search"
}
