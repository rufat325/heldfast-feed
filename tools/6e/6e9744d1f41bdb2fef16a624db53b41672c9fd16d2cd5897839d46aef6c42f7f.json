{
 "description": "Render a static SVG line graph from profile-local portfolio snapshots. Plots known priced value only, labels incomplete coverage, includes provider-estimated NFT values when recorded, and omits unavailable observations instead of plotting fake zeroes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "addresses": {
    "properties": {
     "bitcoin": {
      "type": "string"
     },
     "evm": {
      "type": "string"
     },
     "hyperliquid": {
      "type": "string"
     },
     "solana": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "allPortfolios": {
    "type": "boolean"
   },
   "limit": {
    "description": "Historical observations to consider, max 1000.",
    "type": "number"
   },
   "maxPoints": {
    "description": "Rendered point cap, 2-500, default 200.",
    "type": "number"
   },
   "portfolioId": {
    "type": "string"
   },
   "since": {
    "type": "string"
   },
   "until": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "portfolio_value_graph"
}
