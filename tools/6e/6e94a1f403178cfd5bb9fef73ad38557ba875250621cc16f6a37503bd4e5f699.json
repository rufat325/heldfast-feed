{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create a link between the current issue and another issue.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "issue": {
    "description": "Key or id of the issue to link with",
    "type": "string"
   },
   "issueId": {
    "description": "Current issue key or id",
    "type": "string"
   },
   "relationship": {
    "description": "Link type",
    "enum": [
     "relates",
     "is dependent by",
     "depends on",
     "is subtask for",
     "is parent task for",
     "duplicates",
     "is duplicated by",
     "is epic of",
     "has epic"
    ],
    "type": "string"
   }
  },
  "required": [
   "issueId",
   "relationship",
   "issue"
  ],
  "type": "object"
 },
 "name": "create_issue_link"
}
