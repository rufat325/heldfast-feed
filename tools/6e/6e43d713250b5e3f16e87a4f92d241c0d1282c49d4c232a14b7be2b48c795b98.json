{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Compare credit pack prices"},"description":"Compare credit pack prices (extra usage credits sold on top of a subscription, such as ChatGPT credits) across regions, normalised to the price per 100 credits in one currency. Answers questions like \"where are ChatGPT credits cheapest?\".","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"channel":{"description":"Sales channel: web (regional website prices) or app_store (iOS). Defaults to web for ChatGPT and app_store for other products.","enum":["web","app_store"],"type":"string"},"currency":{"description":"ISO 4217 currency for converted reference prices, e.g. USD, CNY, EUR. Defaults to USD for en and CNY for zh.","pattern":"^[A-Z]{3}$","type":"string"},"item":{"default":"all","description":"An item key from availableItems, or all.","pattern":"^[a-zA-Z0-9_:-]{1,80}$","type":"string"},"limit":{"default":10,"maximum":50,"minimum":1,"type":"integer"},"locale":{"default":"en","description":"Language for region and plan names: en (default) or zh.","enum":["zh","en"],"type":"string"},"pack":{"default":"all","description":"all (default), unit for single-credit prices, or a pack quantity such as 1000.","pattern":"^(?:all|unit|[1-9]\\d{0,30})$","type":"string"},"page":{"default":1,"maximum":1000,"minimum":1,"type":"integer"},"product":{"anyOf":[{"enum":["chatgpt","claude","gemini","perplexity","grok"],"type":"string"},{"pattern":"^app_[1-9]\\d{5,14}$","type":"string"}],"default":"chatgpt","description":"Product key returned by list_catalog, including dynamically registered app_<apple-id> products."},"region":{"description":"Optional filter by region code or name.","maxLength":100,"type":"string"},"sort":{"default":"price_asc","description":"price_asc: cheapest per 100 credits first (default); price_desc; region: alphabetical.","enum":["price_asc","price_desc","region"],"type":"str