{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Home Assistant state/service scaffold with REST/WebSocket adapter nodes, entity maps, service maps, and physical-action safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "websocket_json",
    "enum": [
     "rest_json",
     "websocket_json",
     "manual"
    ],
    "type": "string"
   },
   "area_count": {
    "default": 3,
    "maximum": 64,
    "minimum": 0,
    "type": "integer"
   },
   "base_url": {
    "default": "http://homeassistant.local:8123",
    "type": "string"
   },
   "entity_count": {
    "default": 12,
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   },
   "entity_domain": {
    "default": "sensor",
    "enum": [
     "sensor",
     "light",
     "switch",
     "media_player",
     "climate"
    ],
    "type": "string"
   },
   "name": {
    "default": "homeassistant_state_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Home Assistant scaffold.",
    "type": "string"
   },
   "service_count": {
    "default": 4,
    "maximum": 128,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_homeassistant_state_bus",
 "title": "Connect Home Assistant state bus"
}
