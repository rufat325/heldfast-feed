{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Check if a new schema is compatible with the latest existing schema for a Data Stream topic",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "schema": {
    "description": "New schema definition as JSON string to validate",
    "type": "string"
   },
   "schemaType": {
    "description": "Schema type",
    "enum": [
     "AVRO",
     "JSON",
     "PROTOBUF"
    ],
    "type": "string"
   },
   "topicId": {
    "description": "Topic ID",
    "type": "string"
   }
  },
  "required": [
   "topicId",
   "schemaType",
   "schema"
  ],
  "type": "object"
 },
 "name": "ncloud_datastream_check_schema_compatibility"
}
