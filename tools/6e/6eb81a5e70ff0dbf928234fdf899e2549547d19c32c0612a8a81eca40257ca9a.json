  "readOnlyHint": true,
  "title": "Quote an investor firm search"
 },
 "description": "Use to find real estate investor and lender firms in a state or city: hard-money lenders, private money lenders, note buyers, fix-and-flip investors, investment funds, cash home buyers and wholesalers. Returns firms with business phones, business emails, website and key people (name and title only). Free: this tool only returns a quote and never spends credits. The quote states the cost per firm returned; firms not found cost nothing. Tell the user the cost and ask. Only after the user agrees, call run_investor_firm_search with the quote_id. To find who is actively buying properties in an area, use quote_active_investor_search instead.",
 "inputSchema": {
  "properties": {
   "city": {
    "description": "City to search in. Leave out to search the whole state.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "investorType": {
    "description": "The kind of firm: hard_money_lender (hard-money lenders), private_lender (private money lenders), note_buyer (mortgage note buyers), fix_and_flip (fix-and-flip investors), real_estate_fund (real estate investment funds), cash_home_buyer (cash home buyers), wholesaler (real estate wholesalers).",
    "enum": [
     "hard_money_lender",
     "private_lender",
     "note_buyer",
     "fix_and_flip",
     "real_estate_fund",
     "cash_home_buyer",
     "wholesaler"
    ],
    "type": "string"
   },
   "maxResults": {
    "description": "Most firms to return, 1-25. Default 10.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "description": "Two-letter US state, e.g. TX.",
