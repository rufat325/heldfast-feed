 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Predict how long legal redlines will take, whether the deal will slip past quarter-end, and the revenue at risk. See the full version at https://rahuldsarker.co/calculators/contract-redline-duration-predictor",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "baseLegalReviewDays": {
    "description": "Base legal review time, in days",
    "type": "number"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "daysPerRound": {
    "description": "Turnaround days per redline round",
    "type": "number"
   },
   "daysToQuarterEnd": {
    "description": "Days remaining to quarter-end",
    "type": "number"
   },
   "dealValue": {
    "description": "Deal value",
    "type": "number"
   },
   "expectedRedlineRounds": {
    "description": "Expected number of redline rounds",
    "type": "number"
   },
   "paper": {
    "description": "Whose paper: \"yours\" for your standard MSA, \"theirs\" for their paper/custom contract (drags roughly 1.8x)",
    "enum": [
     "yours",
     "theirs"
    ],
    "type": "string"
   }
  },
  "required": [
   "baseLegalReviewDays",
   "expectedRedlineRounds",
   "daysPerRound",
   "paper",
   "dealValue",
   "daysToQuarterEnd"
  ],
  "type": "object"
 },
 "name": "contract_redline_duration_predictor",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benchmarks": {
    "description": "Rule-of-thumb verdicts for the headline numbers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "band": {
       "type": "string"
      },
      "display": {
       "type": "string"
      },
      "metric": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "read": {
       "type": "string"
      },
