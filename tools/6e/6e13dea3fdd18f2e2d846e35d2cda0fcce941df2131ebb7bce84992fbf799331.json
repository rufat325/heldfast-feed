{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate an illustrative USD base-service subtotal from public rates. Inspection needs sampleChecks; prep needs units; fulfillment needs orders; storage needs cubicMeters and months. Sourcing is quote-only. Excludes freight and other pass-through costs; does not submit or approve a quote.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cubicMeters": {
    "exclusiveMinimum": 0,
    "maximum": 10000,
    "type": "number"
   },
   "months": {
    "maximum": 120,
    "minimum": 1,
    "type": "integer"
   },
   "orders": {
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "sampleChecks": {
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "service": {
    "enum": [
     "sourcing",
     "inspection",
     "prep",
     "storage",
     "fulfillment"
    ],
    "type": "string"
   },
   "units": {
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "service"
  ],
  "type": "object"
 },
 "name": "estimate_prepport_base_cost",
 "title": "Estimate a base service cost"
}
