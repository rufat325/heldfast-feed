{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search cited Form BE or Form B rules by topic, field ID, rule ID, or TaxBrain category. Returns official source records with every match.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "audit": {
    "properties": {
     "previousEventId": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
     },
     "runId": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
     },
     "sequence": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "runId",
     "sequence"
    ],
    "type": "object"
   },
   "formType": {
    "anyOf": [
     {
      "const": "BE",
      "type": "string"
     },
     {
      "const": "B",
      "type": "string"
     }
    ],
    "default": "BE"
   },
   "query": {
    "description": "Tax topic, Form BE field, or TaxBrain category",
    "minLength": 1,
    "type": "string"
   },
   "taxYear": {
    "default": 2026,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_tax_authority",
 "title": "Search Malaysian tax rules"
}
