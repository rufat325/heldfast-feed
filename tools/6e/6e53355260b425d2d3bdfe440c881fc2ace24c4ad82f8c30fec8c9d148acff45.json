{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List graded makers"
 },
 "description": "List makers graded in the Quartermaster ledger, best first, optionally filtered by category, minimum grade, and how their off-price stock behaves. Use for questions like \"who makes good boots under $300\", \"best jeans that last\" or \"which shirt brands are worth it\".",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "One of: shoes (Leather shoes), boots (Boots), sneakers (Sneakers), tailoring (Suits, jackets, trousers), shirts (Shirts), knitwear (Knitwear), outerwear (Outerwear), watches (Watches), denim (Jeans), tees (Tees and polos), chore (Chore jackets and overshirts), chinos (Chinos and cotton trousers).",
    "enum": [
     "shoes",
     "boots",
     "sneakers",
     "tailoring",
     "shirts",
     "knitwear",
     "outerwear",
     "watches",
     "denim",
     "tees",
     "chore",
     "chinos"
    ],
    "type": "string"
   },
   "min_grade": {
    "enum": [
     "S",
     "A",
     "B",
     "C",
     "D"
    ],
    "type": "string"
   },
   "off_price": {
    "description": "mainline: off-price stock is the real line; made-for-outlet: a cheaper line under the same name; rare: seldom discounted.",
    "enum": [
     "mainline",
     "mixed",
     "made-for-outlet",
     "rare",
     "unknown"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "quartermaster_list_makers",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "minimum": 0,
    "type": "integer"
   },
   "makers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "dossier": {
       "type": "string"
      },
      "full_price": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "high": {
           "type": "number"
          },
          "low": {
           "type": "number"
          }
         },
         "required": [
          "low",
          "high"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "grade": {
       "enum": [
        "S",
        "A",
        "B",
        "C",
        "D"
       ],
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "maker": {
       "type": "string"
      },
      "off_price_stock": {
       "type": "string"
      }
     },
     "required": [
      "maker",
      "id",
      "grade",
      "categories",
      "full_price",
      "off_price_stock",
      "dossier"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "makers"
  ],
  "type": "object"
 },
 "title": "List graded makers"
}
