{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add and/or remove tags on a product, order, customer or draft order by GID (tagsAdd/tagsRemove). Defaults to dryRun:true.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "add": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "dryRun": {
    "default": true,
    "description": "True (the default) returns a before/after preview without changing anything in Shopify. Pass false to apply the change; the tool then reads the result back.",
    "type": "boolean"
   },
   "ownerId": {
    "pattern": "^gid:\\/\\/shopify\\/[A-Za-z]+\\/[0-9]+$",
    "type": "string"
   },
   "remove": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "store": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "store",
   "ownerId"
  ],
  "type": "object"
 },
 "name": "shopify_tags"
}
