{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Select relevant capabilities progressively, or request full delivery. Charges the published resolve price (/api/v1/pricing) to a key with read + requests:write; data.economics reports chargedCredits and creditsRemaining. Optional maxPriceCredits caps this call. Optional task session remembers prior delivery and reported results; selection never executes or acquires a capability.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bundle_id": {
    "$ref": "#/properties/capabilities/items"
   },
   "capabilities": {
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "delivery": {
    "default": "progressive",
    "enum": [
     "progressive",
     "full"
    ],
    "type": "string"
   },
   "include_considered": {
    "default": false,
    "type": "boolean"
   },
   "include_repeat": {
    "default": false,
    "type": "boolean"
   },
   "intent": {
    "maxLength": 1000,
    "minLength": 3,
    "type": "string"
   },
   "limit": {
    "default": 3,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "maxPriceCredits": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "request_id": {
    "maxLength": 120,
    "minLength": 8,
    "type": "string"
   },
   "session_id": {
    "maxLength": 80,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "resolve_task_capabilities"
}
