    "type": "string"
   },
   "friendly_name": {
    "type": "string"
   },
   "handle": {
    "type": "string"
   },
   "hint": {
    "type": "string"
   },
   "human_description": {
    "type": "string"
   },
   "mandates": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "next": {
    "additionalProperties": false,
    "properties": {
     "args": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "string"
        },
        {
