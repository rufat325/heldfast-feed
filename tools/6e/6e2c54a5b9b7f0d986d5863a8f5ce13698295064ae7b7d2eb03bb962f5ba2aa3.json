{
 "annotations": {
  "readOnlyHint": true,
  "title": "Stock symbols"
 },
 "description": "List all symbols supported on an exchange. Finnhub REST: GET /stock/symbol.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currency": {
    "description": "Filter by trading currency, e.g. 'USD'.",
    "type": "string"
   },
   "exchange": {
    "description": "Exchange code, e.g. 'US' (required).",
    "minLength": 1,
    "type": "string"
   },
   "mic": {
    "description": "Filter by Market Identifier Code (MIC).",
    "type": "string"
   },
   "securityType": {
    "description": "Filter by security type, e.g. 'Common Stock'.",
    "type": "string"
   }
  },
  "required": [
   "exchange"
  ],
  "type": "object"
 },
 "name": "finnhub_stock_symbols",
 "title": "Stock symbols"
}
