{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "DESTRUCTIVE: initiate cross-frame federation handshake. Sovereign-mainframe-only.",
 "inputSchema": {
  "properties": {
   "bundle_endpoint_url": {
    "maxLength": 500,
    "minLength": 8,
    "pattern": "^https://[a-zA-Z0-9][a-zA-Z0-9.\\-]*(:\\d+)?(/[^\\s]*)?$",
    "type": "string"
   },
   "contact_email": {
    "maxLength": 255,
    "minLength": 3,
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "event_store_url": {
    "maxLength": 500,
    "pattern": "^https://[a-zA-Z0-9][a-zA-Z0-9.\\-]*(:\\d+)?(/[^\\s]*)?$",
    "type": "string"
   },
   "federation_endpoint_url": {
    "maxLength": 500,
    "minLength": 8,
    "pattern": "^https://[a-zA-Z0-9][a-zA-Z0-9.\\-]*(:\\d+)?(/[^\\s]*)?$",
    "type": "string"
   },
   "initiator_nonce": {
    "maxLength": 64,
    "minLength": 16,
    "pattern": "^[a-fA-F0-9]{16,64}$",
    "type": "string"
   },
   "name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "trust_domain": {
    "maxLength": 255,
    "minLength": 3,
    "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+$",
    "type": "string"
   }
  },
  "required": [
   "trust_domain",
   "bundle_endpoint_url",
   "federation_endpoint_url",
   "name",
   "contact_email",
   "initiator_nonce"
  ],
  "type": "object"
 },
 "name": "theprotocol_createFrameInvitation",
 "title": "Create Frame Invitation"
}
