{
 "description": "Approve a pending high-risk checkpoint. Grants one execution for the approved tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approvedBy": {
    "description": "Approver identity",
    "type": "string"
   },
   "file": {
    "description": "Path to the annotated markdown file",
    "type": "string"
   },
   "reason": {
    "description": "Approval rationale",
    "type": "string"
   },
   "tool": {
    "description": "Tool name being approved",
    "type": "string"
   }
  },
  "required": [
   "file",
   "tool",
   "approvedBy",
   "reason"
  ],
  "type": "object"
 },
 "name": "approve_checkpoint"
}
