{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Confirm the Offer status change and send its candidate email"
 },
 "description": "Bind the fixed applications-owned status/email approval POC with explicit approval metadata and a matching idempotency key.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "application_id": {
    "minLength": 1,
    "type": "string"
   },
   "binding": {
    "additionalProperties": false,
    "properties": {
     "approved_action_key": {
      "minLength": 1,
      "type": "string"
     },
     "approved_idempotency_key": {
      "minLength": 1,
      "type": "string"
     },
     "approved_input_hash": {
      "minLength": 1,
      "type": "string"
     },
     "preview_hash": {
      "minLength": 1,
      "type": "string"
     },
     "resource_version_precondition": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "preview_hash",
     "approved_action_key",
     "approved_input_hash",
     "approved_idempotency_key",
     "resource_version_precondition"
    ],
    "type": "object"
   },
   "current_status": {
    "const": "Interviewing",
    "type": "string"
   },
   "decision": {
    "const": "review_edit",
    "type": "string"
   },
   "email_type": {
    "const": "offer",
    "type": "string"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "mode": {
    "enum": [
     "test",
     "live"
    ],
    "type": "string"
   },
   "personalization_instruction": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "requested_sender_identity_id": {
    "anyOf": [
     {
      "format": "uuid",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "target_status": {
    "const": "Offer",
    "type": "string"
   }
  },
  "required": [
   "application_id",
   "current_status",
   "target_status",
   "email_type",
   "decision",
   "binding"
  ],
  "type": "object"
 },
 "name": "yardstick_applications_status_email_poc_bind",
 "title": "Confirm the Offer status change and send its candidate email"
}
