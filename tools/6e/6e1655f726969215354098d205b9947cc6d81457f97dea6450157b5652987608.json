 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update credential"
 },
 "description": "Update one stored credential, potentially breaking dependent workflows. credentialId selects the record; omit fields to keep them and supply at least one change. If type changes, data is also required and must match n8n_credentials_schema. With data, isPartialData=false replaces the saved field set, while true requests a partial merge. Use create for a new credential. Requires write/unsafe mode plus update permission; returns metadata without secret values.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "credentialId": {
    "description": "Stable ID of the credential to update.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "type": "string"
   },
   "data": {
    "additionalProperties": {},
    "description": "Replacement or partial credential field values; never returned.",
    "type": "object"
   },
   "isGlobal": {
    "description": "Optional replacement for the n8n global flag.",
    "type": "boolean"
   },
   "isPartialData": {
    "default": false,
    "description": "Treat supplied data as partial rather than complete replacement data (default false).",
    "type": "boolean"
   },
   "isResolvable": {
    "description": "Optional replacement for the n8n resolvability flag.",
    "type": "boolean"
   },
   "name": {
    "description": "Replacement human-readable credential name (1-128 characters).",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Replacement public credential type; requires replacement data when supplied.",
    "pattern": "^[A-Za-z0-9_.-]{1,128}$",
    "type": "string"
   }
  },
  "required": [
   "credentialId"
  ],
  "type": "object"
 },
 "name": "n8n_credentials_update",
