{
 "annotations": {
  "destructiveHint": true,
  "title": "Create patient"
 },
 "description": "Registers a NEW patient record in your Health Gorilla tenant. FHIR: POST /Patient with a minimal FHIR R4 Patient resource built from the given args. State-changing.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "birthdate": {
    "description": "Date of birth, yyyy-mm-dd.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "city": {
    "description": "City.",
    "type": "string"
   },
   "family": {
    "description": "Family (last) name.",
    "minLength": 1,
    "type": "string"
   },
   "gender": {
    "description": "Administrative gender.",
    "enum": [
     "male",
     "female",
     "other",
     "unknown"
    ],
    "type": "string"
   },
   "given": {
    "description": "Given (first) name.",
    "minLength": 1,
    "type": "string"
   },
   "identifier": {
    "description": "Business identifier value (e.g. MRN).",
    "type": "string"
   },
   "line": {
    "description": "Street address line.",
    "type": "string"
   },
   "postalCode": {
    "description": "Postal / ZIP code.",
    "type": "string"
   },
   "state": {
    "description": "State (2-letter).",
    "type": "string"
   }
  },
  "required": [
   "given",
   "family",
   "birthdate",
   "gender"
  ],
  "type": "object"
 },
 "name": "healthgorilla_create_patient",
 "title": "Create patient"
}
