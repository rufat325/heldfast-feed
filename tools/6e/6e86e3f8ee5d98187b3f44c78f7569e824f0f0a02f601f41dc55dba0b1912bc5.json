{
 "description": "Record an exception identified during testing, with root cause, impact and any compensating control.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "compensatingControl": {
    "type": "string"
   },
   "description": {
    "minLength": 1,
    "type": "string"
   },
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "impact": {
    "type": "string"
   },
   "reference": {
    "description": "The sample item reference the exception relates to.",
    "minLength": 1,
    "type": "string"
   },
   "rootCause": {
    "type": "string"
   },
   "testResultId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "testResultId",
   "reference",
   "description"
  ],
  "type": "object"
 },
 "name": "note_exception",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "exception": {}
  },
  "required": [
   "exception"
  ],
  "type": "object"
 },
 "title": "Note an exception"
}
