{
 "description": "Counter an existing quote, forwarded to the owning seller. Pass the quote_ref and a target price, revised selections, or both. Appends a round to the negotiation; stays non-binding until the seller approves.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "counter_total_usdc": {
    "description": "Your proposed price for the configuration.",
    "minimum": 0,
    "type": "number"
   },
   "note": {
    "description": "Free-form message to the seller.",
    "maxLength": 1000,
    "type": "string"
   },
   "quote_ref": {
    "maxLength": 40,
    "minLength": 3,
    "type": "string"
   },
   "selections": {
    "additionalProperties": false,
    "description": "Revised configuration, if you are changing what you want.",
    "properties": {
     "options": {
      "additionalProperties": {},
      "type": "object"
     },
     "quantity": {
      "maximum": 100000,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "options"
    ],
    "type": "object"
   },
   "seller_mcp_url": {
    "description": "mcp_ref.seller_mcp_url from a discovery result.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "seller_mcp_url",
   "quote_ref"
  ],
  "type": "object"
 },
 "name": "counter_quote"
}
