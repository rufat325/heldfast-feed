{
 "description": "Create a QR code that links to social media profiles. When scanned via the short URL, returns a JSON object with all platform links. Provide at least one platform link.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "background_color": {
    "description": "Hex color for background.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "corner_style": {
    "description": "Corner shape.",
    "enum": [
     "square",
     "extra-rounded",
     "dot"
    ],
    "type": "string"
   },
   "dot_style": {
    "description": "Dot shape.",
    "enum": [
     "square",
     "rounded",
     "dots",
     "classy-rounded"
    ],
    "type": "string"
   },
   "facebook": {
    "description": "Facebook profile/page URL.",
    "type": "string"
   },
   "foreground_color": {
    "description": "Hex color for dots.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "format": {
    "default": "svg",
    "description": "Image format.",
    "enum": [
     "svg",
     "png"
    ],
    "type": "string"
   },
   "frame_color": {
    "description": "Frame background color.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "frame_style": {
    "description": "Frame style around QR.",
    "enum": [
     "none",
     "banner_bottom",
     "banner_top",
     "rounded"
    ],
    "type": "string"
   },
   "frame_text": {
    "description": "CTA text on frame (max 30 chars).",
    "maxLength": 30,
    "type": "string"
   },
   "frame_text_color": {
    "description": "Frame text color.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "github": {
    "description": "GitHub profile URL.",
    "type": "string"
   },
   "instagram": {
    "description": "Instagram profile URL.",
    "type": "string"
   },
   "label": {
    "description": "Label for this QR code.",
    "type": "string"
   },
   "linkedin": {
    "description": "LinkedIn profile URL.",
    "type": "string"
   },
   "logo_url": {
    "description": "Logo URL or data URI.",
    "type": "string"
   },
   "tiktok": {
    "description": "TikTok profile URL.",
    "type": "string"
   },
   "twitter": {
    "description": "Twitter/X profile URL.",
    "type": "string"
   },
   "website": {
    "description": "Personal/company website URL.",
    "type": "string"
   },
   "youtube": {
    "description": "YouTube channel URL.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_social_qr"
}
