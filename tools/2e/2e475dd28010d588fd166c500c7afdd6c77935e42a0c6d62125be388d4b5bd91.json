{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new SourceBuild project with full configuration",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "artifactBackup": {
    "default": false,
    "description": "Backup artifacts",
    "type": "boolean"
   },
   "artifactBucket": {
    "description": "Object Storage bucket for artifacts",
    "type": "string"
   },
   "artifactFilename": {
    "description": "Artifact filename",
    "type": "string"
   },
   "artifactPath": {
    "description": "Build artifact paths",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "artifactStoragePath": {
    "description": "Path within bucket",
    "type": "string"
   },
   "artifactUse": {
    "default": false,
    "description": "Save build artifacts",
    "type": "boolean"
   },
   "branch": {
    "description": "Branch to build from",
    "type": "string"
   },
   "buildCommands": {
    "description": "Build commands",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "cacheImage": {
    "description": "Cache image name",
    "type": "string"
   },
   "cacheLatest": {
    "default": false,
    "description": "Set latest tag for cache",
    "type": "boolean"
   },
   "cacheRegistry": {
    "description": "Container Registry for cache",
    "type": "string"
   },
   "cacheTag": {
    "description": "Cache image tag",
    "type": "string"
   },
   "cacheUse": {
    "default": false,
    "description": "Save build image after completion",
    "type": "boolean"
   },
   "computeId": {
    "description": "Compute type ID (from list_compute)",
    "type": "number"
   },
   "description": {
    "description": "Project description",
    "type": "string"
   },
   "dockerId": {
    "description": "Docker engine version ID (required if dockerUse=true, from list_docker_engines)",
    "type": "number"
   },
   "dockerUse": {
    "default": false,
    "description": "Include Docker engine for build",
    "type": "boolean"
   },
   "dockerbuildDockerfile": {
    "description": "Dockerfile path",
    "type": "string"
   },
   "dockerbuildImage": {
    "description": "Docker build image name",
    "type": "string"
   },
   "dockerbuildLatest": {
    "default": false,
    "description": "Set latest tag for Docker build",
    "type": "boolean"
   },
   "dockerbuildRegistry": {
    "description": "Docker build target Container Registry name",
    "type": "string"
   },
   "dockerbuildTag": {
    "description": "Docker build image tag",
    "type": "string"
   },
   "dockerbuildUse": {
    "default": false,
    "description": "Enable Docker image build",
    "type": "boolean"
   },
   "envVars": {
    "description": "Build environment variables",
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "image": {
    "description": "Image name (required if platformType=ContainerRegistry|PublicRegistry)",
    "type": "string"
   },
   "linkedCloudLogAnalytics": {
    "default": false,
    "description": "Enable Cloud Log Analytics integration",
    "type": "boolean"
   },
   "linkedFileSafer": {
    "default": false,
    "description": "Enable File Safer integration",
    "type": "boolean"
   },
   "name": {
    "description": "Project name (alphanumeric, '_', '-', 1-80 chars)",
    "type": "string"
   },
   "osId": {
    "description": "OS ID (required if platformType=SourceBuild, from list_os)",
    "type": "number"
   },
   "platformType": {
    "default": "SourceBuild",
    "description": "Platform type: SourceBuild | ContainerRegistry | PublicRegistry",
    "type": "string"
   },
   "postBuildCommands": {
    "description": "Post-build commands",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "preBuildCommands": {
    "description": "Pre-build commands",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "registryName": {
    "description": "Container Registry name (required if platformType=ContainerRegistry)",
    "type": "string"
   },
   "repository": {
    "description": "Source repository name",
    "type": "string"
   },
   "runtimeId": {
    "description": "Runtime type ID (required if platformType=SourceBuild, from list_runtimes)",
    "type": "number"
   },
   "runtimeVersionId": {
    "description": "Runtime version ID (required if platformType=SourceBuild, from list_runtime_versions)",
    "type": "number"
   },
   "sourceType": {
    "default": "SourceCommit",
    "description": "Source repository type (SourceCommit)",
    "type": "string"
   },
   "tag": {
    "description": "Image tag (required if platformType=ContainerRegistry|PublicRegistry)",
    "type": "string"
   },
   "timeout": {
    "default": 60,
    "description": "Build timeout in minutes (5-540, default: 5)",
    "type": "number"
   }
  },
  "required": [
   "name",
   "repository",
   "branch",
   "computeId"
  ],
  "type": "object"
 },
 "name": "ncloud_sourcebuild_create_project"
}
