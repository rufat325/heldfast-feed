{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Act on an open page"
 },
 "description": "Runs actions against an open session and returns the resulting state. Actions: {navigate}, {click:{ref}}, {type:{ref,text,clear}}, {select:{ref,value}}, {press}, {scroll}, {wait}, {back}. The `ref` is the one `controls` gave you. It stops at the first failure and tells you where. $0.0005 per action. Reference for the oassis API: https://oassis.dev/openapi.json",
 "inputSchema": {
  "properties": {
   "actions": {
    "description": "What to do, in order: click, type, select, scroll, hover, press, navigate, wait. One to twenty-five per call.",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "navigate": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
        "navigate"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "click": {
         "additionalProperties": false,
         "properties": {
          "ref": {
           "minLength": 1,
           "type": "string"
          },
          "selector": {
           "minLength": 1,
           "type": "string"
          }
         },
         "type": "object"
        }
       },
       "required": [
        "click"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "type": {
         "additionalProperties": false,
         "properties": {
          "clear": {
           "type": "boolean"
          },
          "ref": {
           "minLength": 1,
           "type": "string"
          },
          "selector": {
           "minLength": 1,
           "type": "string"
          },
          "text": {
           "type": "string"
          }
         },
         "required": [
          "text"
         ],
         "type": "object"
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "select": {
         "additionalProperties": false,
         "properties": {
          "ref": {
           "minLength": 1,
           "type": "string"
          },
          "selector": {
           "minLength": 1,
           "type": "string"
          },
          "value": {
           "type": "string"
          }
         },
         "required": [
          "value"
         ],
         "type": "object"
        }
       },
       "required": [
        "select"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "press": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "press"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "scroll": {
         "additionalProperties": false,
         "properties": {
          "by": {
           "type": "number"
          },
          "to": {
           "enum": [
            "top",
            "bottom"
           ],
           "type": "string"
          }
         },
         "type": "object"
        }
       },
       "required": [
        "scroll"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "wait": {
         "additionalProperties": false,
         "properties": {
          "ms": {
           "maximum": 30000,
           "minimum": 0,
           "type": "integer"
          },
          "selector": {
           "minLength": 1,
           "type": "string"
          }
         },
         "type": "object"
        }
       },
       "required": [
        "wait"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "back": {
         "const": true,
         "type": "boolean"
        }
       },
       "required": [
        "back"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   },
   "binaryAs": {
    "default": "base64",
    "description": "How a screenshot or a PDF comes back. `base64` is the only value today.",
    "enum": [
     "base64",
     "url"
    ],
    "type": "string"
   },
   "block": {
    "additionalProperties": false,
    "description": "What not to load, which makes a render faster and cheaper. `resourceTypes` takes image, font, stylesheet, media\u2026 and `urlPatterns` are regular expressions, not globs: `\\.svg$`, not `*.svg`.",
    "properties": {
     "resourceTypes": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     },
     "urlPatterns": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "controls": {
    "additionalProperties": false,
    "description": "Options for the `controls` format: `visibleOnly`, and `limit` (1 to 1000) to cut the map.",
    "properties": {
     "limit": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
     },
     "visibleOnly": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "formats": {
    "default": [
     "controls"
    ],
    "description": "Outputs you want in the same response. `controls` is the map of what can be clicked; `elements` needs `selectors`; `json` needs `json.prompt` or `json.schema`.",
    "items": {
     "enum": [
      "html",
      "markdown",
      "links",
      "screenshot",
      "pdf",
      "elements",
      "json",
      "accessibility",
      "controls"
     ],
     "type": "string"
    },
    "maxItems": 9,
    "minItems": 1,
    "type": "array"
   },
   "json": {
    "additionalProperties": false,
    "description": "For the `json` format: a `prompt` describing what to pull out, a JSON `schema` to fill, or both.",
    "properties": {
     "model": {
      "minLength": 1,
      "type": "string"
     },
     "prompt": {
      "minLength": 1,
      "type": "string"
     },
     "schema": {
      "additionalProperties": {},
      "type": "object"
     }
    },
    "type": "object"
   },
   "links": {
    "additionalProperties": false,
    "description": "Options for the `links` format: `visibleOnly`, `excludeExternal` to keep only internal links.",
    "properties": {
     "excludeExternal": {
      "type": "boolean"
     },
     "visibleOnly": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "maxAge": {
    "description": "Accept an answer up to this many milliseconds old. A cache hit costs $0.0002 instead of the format price. Leave it out to force a fresh render.",
    "maximum": 604800000,
    "minimum": 0,
    "type": "integer"
   },
   "pdf": {
    "additionalProperties": false,
    "description": "Options for the `pdf` format: `format` (a4, letter, legal\u2026), `landscape`, `printBackground`, `scale` 0.1 to 2.",
    "properties": {
     "format": {
      "enum": [
       "letter",
       "legal",
       "tabloid",
       "ledger",
       "a0",
       "a1",
       "a2",
       "a3",
       "a4",
       "a5",
       "a6"
      ],
      "type": "string"
     },
     "landscape": {
      "type": "boolean"
     },
     "printBackground": {
      "type": "boolean"
     },
     "scale": {
      "maximum": 2,
      "minimum": 0.1,
      "type": "number"
     }
    },
    "type": "object"
   },
   "request": {
    "additionalProperties": false,
    "description": "How to make the request: `headers`, `cookies`, `userAgent`, and `auth` for basic authentication.",
    "properties": {
     "auth": {
      "additionalProperties": false,
      "properties": {
       "password": {
        "type": "string"
       },
       "username": {
        "type": "string"
       }
      },
      "required": [
       "username",
       "password"
      ],
      "type": "object"
     },
     "cookies": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "domain": {
         "type": "string"
        },
        "httpOnly": {
         "type": "boolean"
        },
        "name": {
         "minLength": 1,
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "secure": {
         "type": "boolean"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "headers": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "userAgent": {
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "screenshot": {
    "additionalProperties": false,
    "description": "Options for the `screenshot` format: `fullPage` for the whole page, `type` (png, jpeg, webp), `quality` 1-100 (not with png), `omitBackground`, `selector` to capture one element, and its own `viewport`.",
    "properties": {
     "fullPage": {
      "type": "boolean"
     },
     "omitBackground": {
      "type": "boolean"
     },
     "quality": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     },
     "selector": {
      "minLength": 1,
      "type": "string"
     },
     "type": {
      "enum": [
       "png",
       "jpeg",
       "webp"
      ],
      "type": "string"
     },
     "viewport": {
      "additionalProperties": false,
      "properties": {
       "deviceScaleFactor": {
        "maximum": 3,
        "minimum": 0.1,
        "type": "number"
       },
       "height": {
        "maximum": 4096,
        "minimum": 1,
        "type": "integer"
       },
       "width": {
        "maximum": 4096,
        "minimum": 1,
        "type": "integer"
       }
      },
      "required": [
       "width",
       "height"
      ],
      "type": "object"
     }
    },
    "type": "object"
   },
   "selectors": {
    "description": "CSS selectors for the `elements` format.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "sessionId": {
    "description": "The session to act on, from `web_session_open`.",
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "Page to process.",
    "format": "uri",
    "type": "string"
   },
   "viewport": {
    "additionalProperties": false,
    "description": "The window to render in: `width`, `height`, `deviceScaleFactor`.",
    "properties": {
     "deviceScaleFactor": {
      "maximum": 3,
      "minimum": 0.1,
      "type": "number"
     },
     "height": {
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
     },
     "width": {
      "maximum": 4096,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "width",
     "height"
    ],
    "type": "object"
   },
   "wait": {
    "additionalProperties": false,
    "description": "When to consider the page loaded: `until` (load, domcontentloaded, networkidle0, networkidle2), `selector` to wait for, `timeout` in ms.",
    "properties": {
     "selector": {
      "minLength": 1,
      "type": "string"
     },
     "timeout": {
      "maximum": 60000,
      "minimum": 100,
      "type": "integer"
     },
     "until": {
      "enum": [
       "load",
       "domcontentloaded",
       "networkidle0",
       "networkidle2"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "sessionId",
   "actions"
  ],
  "type": "object"
 },
 "name": "web_act"
}
