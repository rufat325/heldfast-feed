{
 "description": "External secret-manager (vault) configuration. list, get (vaultProviderId), create (name+config+assignments), update (vaultProviderId+name+config+assignments \u2014 the API REPLACES the provider, so all four must be sent even when changing one; run get first), remove (vaultProviderId), testConnection (vaultProviderId for a saved provider, or config to check credentials before saving), listSecretNames (vaultProviderId+projectId, environmentId?). config is discriminated on providerType: hashicorp | infisical | aws | doppler | azure | scaleway. Note infisical.projectId and scaleway.projectId are that provider's own project, NOT the Dokploy projectId used in assignments. assignments is [{projectId, environmentIds?}] naming the Dokploy projects the vault serves. listSecretNames returns names only \u2014 Dokploy exposes no API to read a secret's value \u2014 and provider credentials are never echoed back in tool output.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "remove",
     "testConnection",
     "listSecretNames"
    ],
    "type": "string"
   },
   "assignments": {
    "description": "Dokploy projects/environments this vault serves",
    "items": {
     "properties": {
      "environmentIds": {
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "type": "array"
      },
      "projectId": {
       "description": "Dokploy project ID",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "projectId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "config": {
    "description": "Vault credentials, keyed by providerType",
    "oneOf": [
     {
      "properties": {
       "mount": {
        "description": "defaults to 'secret'",
        "minLength": 1,
        "type": "string"
       },
       "namespace": {
        "type": "string"
       },
       "providerType": {
        "const": "hashicorp",
        "type": "string"
       },
       "token": {
        "minLength": 1,
        "type": "string"
       },
       "url": {
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "providerType",
       "url",
       "token"
      ],
      "type": "object"
     },
     {
      "properties": {
       "clientId": {
        "minLength": 1,
        "type": "string"
       },
       "clientSecret": {
        "minLength": 1,
        "type": "string"
       },
       "environmentSlug": {
        "minLength": 1,
        "type": "string"
       },
       "projectId": {
        "description": "the Infisical project, not a Dokploy projectId",
        "minLength": 1,
        "type": "string"
       },
       "providerType": {
        "const": "infisical",
        "type": "string"
       },
       "secretPath": {
        "description": "defaults to '/'",
        "type": "string"
       },
       "siteUrl": {
        "description": "defaults to https://app.infisical.com",
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "providerType",
       "clientId",
       "clientSecret",
       "projectId",
       "environmentSlug"
      ],
      "type": "object"
     },
     {
      "properties": {
       "accessKeyId": {
        "minLength": 1,
        "type": "string"
       },
       "endpoint": {
        "format": "uri",
        "type": "string"
       },
       "providerType": {
        "const": "aws",
        "type": "string"
       },
       "region": {
        "minLength": 1,
        "type": "string"
       },
       "secretAccessKey": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "providerType",
       "region",
       "accessKeyId",
       "secretAccessKey"
      ],
      "type": "object"
     },
     {
      "properties": {
       "config": {
        "description": "Doppler config name, e.g. 'prod'",
        "type": "string"
       },
       "project": {
        "type": "string"
       },
       "providerType": {
        "const": "doppler",
        "type": "string"
       },
       "serviceToken": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "providerType",
       "serviceToken"
      ],
      "type": "object"
     },
     {
      "properties": {
       "clientId": {
        "minLength": 1,
        "type": "string"
       },
       "clientSecret": {
        "minLength": 1,
        "type": "string"
       },
       "providerType": {
        "const": "azure",
        "type": "string"
       },
       "tenantId": {
        "minLength": 1,
        "type": "string"
       },
       "vaultUri": {
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "providerType",
       "vaultUri",
       "tenantId",
       "clientId",
       "clientSecret"
      ],
      "type": "object"
     },
     {
      "properties": {
       "apiUrl": {
        "description": "defaults to https://api.scaleway.com",
        "format": "uri",
        "type": "string"
       },
       "projectId": {
        "description": "the Scaleway project, not a Dokploy projectId",
        "minLength": 1,
        "type": "string"
       },
       "providerType": {
        "const": "scaleway",
        "type": "string"
       },
       "region": {
        "description": "defaults to 'fr-par'",
        "type": "string"
       },
       "secretKey": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "providerType",
       "projectId",
       "secretKey"
      ],
      "type": "object"
     }
    ]
   },
   "environmentId": {
    "description": "listSecretNames: narrow to one environment",
    "type": "string"
   },
   "name": {
    "description": "Provider name (letters, digits, _ and - only)",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "description": "listSecretNames: Dokploy project ID",
    "type": "string"
   },
   "vaultProviderId": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "dokploy_vault_provider"
}
