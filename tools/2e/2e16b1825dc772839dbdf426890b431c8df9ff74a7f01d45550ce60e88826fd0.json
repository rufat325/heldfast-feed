    "description": "RE2 syntax",
    "type": "string"
   }
  },
  "required": [
   "pattern",
   "input"
  ],
  "type": "object"
 },
 "name": "regex_match",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "groups": {
    "items": {
