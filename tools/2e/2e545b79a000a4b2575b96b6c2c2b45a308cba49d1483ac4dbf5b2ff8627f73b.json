{
 "description": "Update an existing webhook endpoint (URL, subscribed events, active state, retries, or timeout). Only the fields you pass are changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": "string"
   },
   "events": {
    "items": {
     "enum": [
      "invoice.*",
      "invoice.created",
      "invoice.updated",
      "invoice.paid",
      "invoice.underpaid",
      "invoice.overpaid",
      "invoice.expired",
      "invoice.cancelled",
      "payment.*",
      "payment.created",
      "payment.updated",
      "payment.detected",
      "payment.confirmed",
      "payment.paid",
      "payment.underpaid",
      "payment.overpaid",
      "payment.expired"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "isActive": {
    "type": "boolean"
   },
   "retryCount": {
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "timeout": {
    "maximum": 30000,
    "minimum": 1000,
    "type": "integer"
   },
   "url": {
    "format": "uri",
    "type": "string"
   },
   "webhookId": {
    "description": "The webhook ID (wh_...).",
    "type": "string"
   }
  },
  "required": [
   "webhookId"
  ],
  "type": "object"
 },
 "name": "update_webhook",
 "title": "Update webhook"
}
