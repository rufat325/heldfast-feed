{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Estimate a college list"
 },
 "description": "Score one student profile against up to 15 colleges at once. Returns every school sorted by chance with its verdict, the Reach/Target/Likely balance, the chance of at least one acceptance, and concrete advice to balance the list.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "act": {
    "description": "ACT composite, 1 to 36. Ignored if sat is given.",
    "maximum": 36,
    "minimum": 1,
    "type": "integer"
   },
   "apCourses": {
    "description": "Number of AP courses taken or in progress.",
    "maximum": 30,
    "minimum": 0,
    "type": "integer"
   },
   "athlete": {
    "description": "Recruited athlete.",
    "type": "boolean"
   },
   "classRankPercent": {
    "description": "Class rank as a top percentage, e.g. 5 for top 5%.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "firstGen": {
    "description": "First-generation college student.",
    "type": "boolean"
   },
   "gpa": {
    "description": "Unweighted GPA on a 4.0 scale. Provide this or weightedGpa.",
    "maximum": 4,
    "minimum": 0,
    "type": "number"
   },
   "grade": {
    "description": "Current grade level. Defaults to 12.",
    "enum": [
     "9",
     "10",
     "11",
     "12"
    ],
    "type": "string"
   },
   "homeState": {
    "description": "Two-letter U.S. state code, for in-state vs out-of-state at public schools.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "legacy": {
    "description": "Parent attended this school.",
    "type": "boolean"
   },
   "major": {
    "description": "Intended major, e.g. Computer Science.",
    "maxLength": 60,
    "type": "string"
   },
   "round": {
    "description": "Application round. Defaults to Regular Decision.",
    "enum": [
     "Regular Decision",
     "Early Action",
     "Early Decision",
     "REA/SCEA",
     "Rolling"
    ],
    "type": "string"
   },
   "sat": {
    "description": "Total SAT score, 400 to 1600.",
    "maximum": 1600,
    "minimum": 400,
    "type": "integer"
   },
   "schools": {
    "description": "College names.",
    "items": {
     "type": "string"
    },
    "maxItems": 15,
    "minItems": 1,
    "type": "array"
   },
   "weightedGpa": {
    "description": "Weighted GPA (e.g. 4.3 on a 5.0 scale).",
    "maximum": 6,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "schools"
  ],
  "type": "object"
 },
 "name": "estimate_college_list",
 "title": "Estimate chances across a college list"
}
