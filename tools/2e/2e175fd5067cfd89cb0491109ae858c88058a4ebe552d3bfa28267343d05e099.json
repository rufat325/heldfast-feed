      },
      "bookId": {
       "type": "number"
      },
      "charEnd": {
       "type": "number"
      },
      "charStart": {
       "type": "number"
      },
      "cosine": {
       "type": "number"
      },
      "rerankScore": {
       "type": "number"
      },
      "snippet": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "bookId",
      "title",
      "authors",
      "charStart",
      "charEnd",
      "snippet"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scope": {
    "type": "string"
   },
   "semanticAvailable": {
    "type": "boolean"
   },
   "semanticReason": {
    "type": "string"
   },
   "target": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Semantic search"
}
