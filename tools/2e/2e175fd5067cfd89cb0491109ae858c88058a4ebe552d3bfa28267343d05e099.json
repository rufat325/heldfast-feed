{
 "_meta": {
  "ui": {
   "resourceUri": "ui://calibre/board-semantic.html"
  },
  "ui/resourceUri": "ui://calibre/board-semantic.html"
 },
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Meaning-based search over the local index. scope=library ranks books; scope=book (needs bookId) ranks passages within one book. target=figures searches figure captions instead of text \u2014 use when the user asks for a diagram/chart/schema; hits point at calibre_get_figures for the pixels. mode=hybrid (default) fuses semantic + keyword matches; mode=vector is semantic-only; mode=keyword is exact keyword/FTS (no model at query time). All modes need an index built by calibre_build_index. filter accepts a bundle name to scope library searches (list bundles via calibre_manage_bundles).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bookId": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "filter": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "include_excluded": {
    "type": "boolean"
   },
   "library": {
    "type": "string"
   },
   "mode": {
    "default": "hybrid",
    "enum": [
     "hybrid",
     "vector",
     "keyword"
    ],
    "type": "string"
   },
   "query": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "scope": {
    "default": "library",
    "enum": [
     "library",
     "book"
    ],
    "type": "string"
   },
   "target": {
    "default": "text",
    "enum": [
     "text",
     "figures"
    ],
    "type": "string"
   },
   "topK": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "calibre_semantic_search",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "bookId": {
    "type": "number"
   },
   "bookIds": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "count": {
    "type": "number"
   },
   "exclusionsApplied": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "figures": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "bookId": {
       "type": "number"
      },
      "caption": {
       "type": "string"
      },
      "charOffset": {
       "type": "number"
      },
      "contextCharEnd": {
       "type": "number"
      },
      "contextCharStart": {
       "type": "number"
      },
      "contextSnippet": {
       "type": "string"
      },
      "cosine": {
       "type": "number"
      },
      "figIndex": {
       "type": "number"
      },
      "format": {
       "type": "string"
      },
      "page": {
       "type": "number"
      },
      "rerankScore": {
       "type": "number"
      },
      "source": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "bookId",
      "title",
      "authors",
      "figIndex",
      "page",
      "caption",
      "format",
      "charOffset"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "filter": {
    "type": "string"
   },
   "lowConfidence": {
    "type": "boolean"
   },
   "maxRerank": {
    "type": "number"
   },
   "maxScore": {
    "type": "number"
   },
   "mode": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "passages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "charEnd": {
       "type": "number"
      },
      "charStart": {
       "type": "number"
      },
      "cosine": {
       "type": "number"
      },
      "frontMatter": {
       "type": "boolean"
      },
      "rerankScore": {
       "type": "number"
      }
     },
     "required": [
      "charStart",
      "charEnd",
      "body"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "reranked": {
    "type": "boolean"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
