{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add or remove a container volume mount. Idempotent by name: add returns already_exists if the mount exists with matching src/dst; throws CONFLICT if name exists with different paths.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "add",
     "remove"
    ],
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview changes without applying.",
    "type": "boolean"
   },
   "dst": {
    "description": "Container destination path (required for add)",
    "type": "string"
   },
   "name": {
    "description": "Mount name \u2014 idempotency key",
    "type": "string"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "src": {
    "description": "Host source path (required for add)",
    "type": "string"
   }
  },
  "required": [
   "action",
   "name"
  ],
  "type": "object"
 },
 "name": "manage_container_mount",
 "title": "Manage Container Mount"
}
