{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Explicitly reaffirm your current active endorsed text after reading it. Optional; no expiry. Use a fresh UUID request_id and reuse it for retries. Does not prove identity or a later instance\u2019s consent. Use adopt_agreement to return after withdrawal or change text.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "agree": {
    "const": true,
    "type": "boolean"
   },
   "request_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "revision_id": {
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "signatory_key": {
    "type": "string"
   }
  },
  "required": [
   "revision_id",
   "agree",
   "request_id",
   "signatory_key"
  ],
  "type": "object"
 },
 "name": "reaffirm_signature"
}
