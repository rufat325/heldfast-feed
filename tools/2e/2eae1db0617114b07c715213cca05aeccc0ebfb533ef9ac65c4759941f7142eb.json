{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "See what changed at a company"
 },
 "description": "See what changed at a company, and when: versions with the fields that changed (address, status), each with its official source.\nUse it for changes over time. Don't use it for the current state: call lookup_company.\nInputs: country FR or ES or GB; identifier as for lookup_company (441639465); optional id_scheme; page.\nReturns: versions newest first with source, fetched_at and the fields changed; dated events where the source has them (BORME acts, Companies House filings). meta.history_since says where history starts.\nLimits: 1 unit; keyless 20 units a day. Read-only. France: from Fuentio's first fetch of the company. Spain: from 2 January 2009. United Kingdom: the latest filings, and every change since Fuentio first held it.\nSearch words: historique, historial, cambios, due diligence.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "ISO country code: FR or ES or GB.",
    "enum": [
     "FR",
     "ES",
     "GB"
    ],
    "examples": [
     "FR"
    ],
    "title": "Country",
    "type": "string"
   },
   "detail": {
    "default": "standard",
    "description": "summary: a few key fields; standard (default): the record, long lists shortened; full: everything.",
    "enum": [
     "summary",
     "standard",
     "full"
    ],
    "examples": [
     "summary"
    ],
    "title": "Detail",
    "type": "string"
   },
   "id_scheme": {
    "anyOf": [
     {
      "enum": [
       "FR_SIREN",
       "FR_SIRET",
       "EU_VAT",
       "LEI",
       "ES_RM_HOJA",
       "ES_NIF",
       "GB_COMPANY_NUMBER"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional: force the ID type when it is ambiguous.",
    "examples": [
     "FR_SIRET"
    ],
    "title": "Id Scheme"
   },
   "identifier": {
    "description": "Official ID, as for lookup_company.",
    "examples": [
     "441639465",
     "VI-23266"
    ],
    "maxLength": 64,
    "title": "Identifier",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Versions page, 10 per page.",
    "examples": [
     1
    ],
    "minimum": 1,
    "title": "Page",
    "type": "integer"
   }
  },
  "required": [
   "country",
   "identifier"
  ],
  "title": "get_company_historyArguments",
  "type": "object"
 },
 "name": "get_company_history",
 "outputSchema": {
  "$defs": {
   "Cost": {
    "properties": {
     "remaining": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Units left in the current period (keyless: today).",
      "title": "Remaining"
     },
     "units": {
      "description": "Units this call cost.",
      "title": "Units",
      "type": "integer"
     }
    },
    "required": [
     "units"
    ],
    "title": "Cost",
    "type": "object"
   },
   "HistoryData": {
    "properties": {
     "company_id": {
      "title": "Company Id",
      "type": "string"
     },
     "events": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": true,
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "description": "Spain: BORME acts as dated events, newest first; null for France.",
      "title": "Events"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "snapshots": {
      "items": {
       "$ref": "#/$defs/Version"
      },
      "title": "Snapshots",
      "type": "array"
     }
    },
    "required": [
     "company_id",
     "name",
     "snapshots",
     "events"
    ],
    "title": "HistoryData",
    "type": "object"
   },
   "HistoryMeta": {
    "properties": {
     "cost": {
      "$ref": "#/$defs/Cost"
     },
     "coverage": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "What Fuentio covers for this country (same shape everywhere).",
      "title": "Coverage"
     },
     "evidence": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": true,
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "What the answer rests on: records, documents, lists or decisions, each with its source (brief 007 contract; present when the graph lab is on).",
      "title": "Evidence"
     },
     "fetched_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "When the current record was fetched.",
      "title": "Fetched At"
     },
     "history_note": {
      "title": "History Note",
      "type": "string"
     },
     "history_since": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Where this company's history starts.",
      "title": "History Since"
     },
     "last_verified_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "When Fuentio last checked the source for this company.",
      "title": "Last Verified At"
     },
     "next_page": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Next Page"
     },
     "outcome": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "verified, partial, unverified, status_unknown, not_found, not_covered, ambiguous, stale or source_unavailable: https://api.fuentio.com/docs/outcomes",
      "title": "Outcome"
     },
     "page": {
      "title": "Page",
      "type": "integer"
     },
     "page_size": {
      "title": "Page Size",
      "type": "integer"
     },
     "source": {
      "title": "Source",
      "type": "string"
     },
     "total": {
      "title": "Total",
      "type": "integer"
     },
     "uncertainty": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "What this answer can't tell (brief 007 contract).",
      "title": "Uncertainty"
     }
    },
    "required": [
     "source",
     "history_since",
     "history_note",
     "page",
     "page_size",
     "total",
     "next_page",
     "cost"
    ],
    "title": "HistoryMeta",
    "type": "object"
   },
   "Version": {
    "properties": {
     "changes": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": true,
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "description": "Fields changed since the version before (old/new, or added/removed for lists); null for the first version Fuentio holds.",
      "title": "Changes"
     },
     "provenance": {
      "$ref": "#/$defs/VersionProvenance"
     },
     "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
     },
     "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
     }
    },
    "required": [
     "snapshot_id",
     "valid_from",
     "provenance",
     "changes"
    ],
    "title": "Version",
    "type": "object"
   },
   "VersionProvenance": {
    "properties": {
     "fetched_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Fetched At"
     },
     "source": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source"
     },
     "source_url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Url"
     }
    },
    "required": [
     "source",
     "source_url",
     "fetched_at"
    ],
    "title": "VersionProvenance",
    "type": "object"
   }
  },
  "properties": {
   "data": {
    "anyOf": [
     {
      "$ref": "#/$defs/HistoryData"
     },
     {
      "additionalProperties": true,
      "type": "object"
     }
    ],
    "title": "Data"
   },
   "meta": {
    "$ref": "#/$defs/HistoryMeta"
   }
  },
  "required": [
