{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Discover and scrape a whole site as one job. Returns a crawl id straight away; read it with crawl_status. Use this instead of calling scrape in a loop.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Maximum pages to scrape.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "maxDepth": {
    "description": "How far from the seed to follow.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "url": {
    "description": "The site to start from.",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "crawl",
 "title": "Crawl"
}
