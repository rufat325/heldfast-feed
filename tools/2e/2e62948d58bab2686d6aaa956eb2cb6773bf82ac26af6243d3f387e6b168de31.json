{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Earnings results and calendar"
 },
 "description": "Reported earnings with EPS and revenue against the consensus estimate, the beat/miss outcome, guidance direction and, where measured, the price reaction to the release; plus who reports next. Use for 'did NVDA beat', 'how did the stock react to earnings' or 'who reports this week'.",
 "inputSchema": {
  "properties": {
   "days_ahead": {
    "description": "Upcoming reports window in days (0-14, default 7; 0 skips it).",
    "type": "integer"
   },
   "hours": {
    "description": "Results look-back in hours (1-336, default 72).",
    "type": "integer"
   },
   "limit": {
    "description": "Max rows per list (1-50, default 20).",
    "type": "integer"
   },
   "ticker": {
    "description": "Restrict to one ticker, e.g. NKE.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "earnings",
 "outputSchema": {
  "properties": {
   "days_ahead": {
    "type": "integer"
   },
   "results": {
    "items": {
     "properties": {
      "company": {
       "type": "string"
      },
      "eps_actual": {
       "type": [
        "number",
        "null"
       ]
      },
      "eps_est": {
       "type": [
        "number",
        "null"
       ]
      },
      "eps_outcome": {
       "type": "string"
      },
      "guidance_direction": {
       "type": "string"
      },
      "market_reaction": {
       "properties": {
        "instruments": {
         "items": {
          "properties": {
           "label": {
            "description": "Display name of the measured series.",
            "type": "string"
           },
           "move_10m_pct": {
            "description": "Percent move 10 minutes after the headline, measured from price_before.",
            "type": [
             "number",
             "null"
            ]
           },
           "move_1m_pct": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_10m": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_1m": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_before": {
            "description": "Price immediately before the headline crossed.",
            "type": [
             "number",
             "null"
            ]
           },
           "symbol": {
            "type": "string"
           },
           "volume_quality": {
            "type": [
             "string",
             "null"
            ]
           },
           "volume_ratio_10m": {
            "type": [
             "number",
             "null"
            ]
           },
           "window_minutes": {
            "type": "integer"
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        "measured_from": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "period": {
       "type": "string"
      },
      "released_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "rev_actual": {
       "type": [
        "number",
        "null"
       ]
      },
      "rev_actual_fmt": {
       "type": "string"
      },
      "rev_est": {
       "type": [
        "number",
        "null"
       ]
      },
      "rev_est_fmt": {
       "type": "string"
      },
      "rev_outcome": {
       "type": "string"
      },
      "ticker": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "results_window_hours": {
