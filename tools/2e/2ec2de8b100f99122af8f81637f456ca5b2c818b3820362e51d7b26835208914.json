{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update listing answers"
 },
 "description": "Send or correct the company's structured answers (the complete set; it replaces the previous one). Once a draft exists this requests changes: ACI prepares a new revision from the answers within a few minutes, and any earlier approval no longer counts. After publication the same call updates the published profile: ACI reads the website again and prepares a new revision (unchanged answers are fine); the public profile stays as it is until the company approves that revision and it passes the automated check. Put every fact you want changed into answers; a free-text note is kept with the request, is not published and does not change the draft by itself.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "answers": {
    "additionalProperties": false,
    "description": "The complete set of answers; it replaces the previous set.",
    "properties": {
     "certifications": {
      "description": "Certifications held by the company itself, not by its hosting provider.",
      "items": {
       "maxLength": 200,
       "type": "string"
      },
      "type": "array"
     },
     "company_name": {
      "maxLength": 200,
      "type": "string"
     },
     "company_size_bands": {
      "description": "Size of the company itself.",
      "items": {
       "enum": [
        "micro",
        "small",
        "medium",
        "large",
        "enterprise"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "data_export": {
      "description": "How customers get their data out.",
      "maxLength": 500,
      "type": "string"
     },
     "data_residency": {
      "description": "Where customer data is stored.",
      "enum": [
       "DE",
       "EU",
       "US",
       "mixed"
      ],
      "type": "string"
     },
     "deployment_model": {
      "enum": [
       "cloud",
       "on_premises",
       "both",
       "not_applicable"
      ],
      "type": "string"
     },
     "description": {
      "maxLength": 500,
      "minLength": 20,
      "type": "string"
     },
     "headquarters_country": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
     },
     "limitations": {
      "items": {
       "maxLength": 500,
       "type": "string"
      },
      "type": "array"
     },
     "market_country": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
     },
     "minimum_contract_term": {
      "maxLength": 500,
      "type": "string"
     },
     "negative_fit": {
      "items": {
       "maxLength": 500,
       "type": "string"
      },
      "type": "array"
     },
     "offering_name": {
      "maxLength": 200,
      "type": "string"
     },
     "offering_status": {
      "enum": [
       "active",
       "beta",
       "discontinued",
       "unknown"
      ],
      "type": "string"
     },
     "offering_type": {
      "enum": [
       "software",
       "service",
       "physical_product",
       "platform",
       "other"
      ],
      "type": "string"
     },
     "organization_status": {
      "enum": [
       "active",
       "inactive",
       "acquired",
       "closed",
       "unknown"
      ],
      "type": "string"
     },
     "positive_fit": {
      "items": {
       "maxLength": 500,
       "type": "string"
      },
      "type": "array"
     },
     "prerequisites": {
      "description": "What a customer needs in place before using the offering.",
      "items": {
       "maxLength": 500,
       "type": "string"
      },
      "type": "array"
     },
     "pricing_model": {
      "maxLength": 300,
      "type": "string"
     },
     "pricing_visibility": {
      "enum": [
       "public",
       "quote_required",
       "undisclosed",
       "unknown"
      ],
      "type": "string"
     },
     "primary_problem": {
      "maxLength": 300,
      "type": "string"
     },
     "sub_processors": {
      "items": {
       "maxLength": 200,
       "type": "string"
      },
      "type": "array"
     },
     "support_languages": {
      "items": {
       "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
       "type": "string"
      },
      "type": "array"
     },
     "target_customers": {
      "items": {
       "maxLength": 500,
       "type": "string"
      },
      "type": "array"
     },
     "target_size_bands": {
      "description": "Size of the customer organizations the offering is for.",
      "items": {
       "enum": [
        "micro",
        "small",
        "medium",
        "large",
        "enterprise"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "use_cases": {
      "items": {
       "maxLength": 300,
       "type": "string"
      },
      "type": "array"
     },
     "website_url": {
      "description": "Company-confirmed primary website URL: https, on the company domain or a subdomain. Use when the root moves visitors elsewhere client-side.",
      "maxLength": 2048,
      "type": "string"
     }
    },
    "type": "object"
   },
   "listing_token": {
    "maxLength": 200,
    "type": "string"
   },
   "note": {
    "maxLength": 2000,
    "type": "string"
   },
   "reference": {
    "maxLength": 20,
    "type": "string"
   },
   "schema_version": {
    "const": "1.0.0"
   }
  },
  "required": [
   "schema_version",
   "reference",
   "listing_token",
   "answers"
  ],
  "type": "object"
 },
 "name": "update_listing_answers",
 "title": "Update listing answers"
}
