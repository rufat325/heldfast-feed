{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check a blog's sitemap"
 },
 "description": "Use this when someone asks what pages their blog's sitemap lists, or which pages are available to link to. Returns the sitemap's URL count and the first 25 URLs with language and last-modified date, read live from the blog's custom domain. Not for the posts stored in Polyblog.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blogId": {
    "description": "Blog whose sitemap to read",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "locale": {
    "description": "Only URLs in this language, a two-letter code such as en",
    "maxLength": 50,
    "type": "string"
   },
   "maxUrls": {
    "description": "How many sitemap URLs to read and count, from 1 to 2,000; defaults to 500, and only the first 25 are listed",
    "exclusiveMinimum": 0,
    "maximum": 2000,
    "type": "integer"
   }
  },
  "required": [
   "blogId"
  ],
  "type": "object"
 },
 "name": "get_sitemap_urls",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baseUrl": {
    "anyOf": [
     {
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "childSitemaps": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "returned": {
    "description": "How many sitemap URLs were read, at most maxUrls",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "rootSitemap": {
    "$ref": "#/properties/baseUrl"
   },
   "sample": {
    "description": "The first 25 URLs read; returned counts every URL read",
    "items": {
     "additionalProperties": false,
     "properties": {
      "lastmod": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "locale": {
       "anyOf": [
        {
         "maxLength": 50,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "$ref": "#/properties/baseUrl"
      }
     },
     "required": [
      "locale",
      "lastmod",
      "url"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "type": "array"
   },
   "sampleTruncated": {
    "type": "boolean"
   },
   "totalUrls": {
    "$ref": "#/properties/childSitemaps"
   }
  },
  "required": [
   "baseUrl",
   "rootSitemap",
   "childSitemaps",
   "totalUrls",
   "returned",
   "sample",
   "sampleTruncated"
  ],
  "type": "object"
 },
 "title": "Check a blog's sitemap"
}
