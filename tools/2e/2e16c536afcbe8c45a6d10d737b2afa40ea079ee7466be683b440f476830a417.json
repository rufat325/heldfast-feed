{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Poll an async tracking job by job_id. Returns status (queued, running, completed, or failed). On completion, product is populated; on scrape failure, error is populated (HTTP 200 job lookup \u2014 not a transport error). On failure, returns a structured error object with fields error.code, error.message, error.http_status, error.retry_recommended, and error.retry_after_seconds.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "job_id": {
    "description": "Job ID from track_product",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "job_id"
  ],
  "type": "object"
 },
 "name": "get_job_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "error": {
    "anyOf": [
     {
      "additionalProperties": true,
      "properties": {
       "code": {
        "type": "string"
       },
       "http_status": {
        "type": [
         "number",
         "null"
        ]
       },
       "message": {
        "type": "string"
       },
       "retry_after_seconds": {
        "type": [
         "number",
         "null"
        ]
       },
       "retry_recommended": {
        "type": "boolean"
       }
      },
      "required": [
       "code",
       "message",
       "retry_recommended"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "hint": {
    "type": "string"
   },
   "job_id": {
    "type": "string"
   },
   "product": {
    "anyOf": [
     {
      "additionalProperties": true,
      "properties": {
       "currency": {
        "type": "string"
       },
       "current_price": {
        "type": [
         "number",
         "null"
        ]
       },
       "last_checked_at": {
        "type": [
         "string",
         "null"
        ]
       },
       "name": {
        "type": "string"
       },
       "product_id": {
        "type": "string"
       },
       "product_url": {
        "type": "string"
       },
       "shop": {
        "type": "string"
       },
       "status": {
        "type": "string"
       }
      },
      "required": [
       "product_id",
       "name",
       "shop",
       "currency"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "queued",
     "running",
     "completed",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "job_id",
   "status"
  ],
  "type": "object"
 },
 "title": "Get job status"
}
