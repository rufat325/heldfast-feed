{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Is it cheaper to import this car from the UK or Northern Ireland to Ireland?"},"description":"Headline call. Use when someone is deciding whether to buy a used car in the UK or Northern Ireland and import it to Ireland. Compares the median price of comparable live UK and Northern Ireland listings (same make, model, fuel, within 1 year and 30,000 km) with the Irish median, adds transport, customs duty and import VAT (Great Britain), Irish VRT and NOx levy, and returns a verdict (IMPORT, MARGINAL or BUY_IN_IRELAND), the saving in EUR, the landed-cost breakdown per route and the three cheapest matching listings. Returns 404 (no charge) if either market has fewer than 5 comparables. Pass co2_g_km for an accurate VRT figure. Estimate only. Costs 0.02 USDC per call via x402; no-data results are free.","inputSchema":{"properties":{"co2_g_km":{"default":125,"description":"WLTP CO2 in g/km for the VRT estimate. Default 130.","example":125,"examples":[125],"maximum":1000,"minimum":0,"type":"integer"},"fuel_type":{"default":"Petrol","description":"Fuel type, e.g. Petrol, Diesel, Electric, Petrol Hybrid, Petrol Plug-in Hybrid.","enum":["Petrol","Diesel","Electric","Petrol Hybrid","Diesel Hybrid","Petrol Plug-in Hybrid","Diesel Plug-in Hybrid","petrol","diesel","electric","petrol hybrid","diesel hybrid","petrol plug-in hybrid","diesel plug-in hybrid"],"example":"Petrol","examples":["Petrol"],"type":"string"},"make":{"default":"Volkswagen","description":"Vehicle make, case-insensitive.","example":"Volkswagen","examples":["Volkswagen"],"type":"string"},"margin_of_safety_eur":{"default":1000.0,"description":"Minimum saving to recommend IMPORT rather than MARGINAL. Default 1000.","example":1000.0,"examples":[1000.0],"minimum":0,"type":"number"},"mileage_km":{"default":50000,"description":"Odometer reading in km.","example":50000,"examples":[50000],"minimum":0,"type":"inte