{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "qa",
 "description": "Validate an LLM function call / tool_use output: check that function name is in allowed list, arguments match expected schema, no extra/missing args. For OpenAI function calling & MCP tool_use testing.",
 "inputSchema": {
  "properties": {
   "allowed_functions": {
    "description": "List of allowed function definitions",
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "optional_args": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "required_args": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "function_call": {
    "additionalProperties": true,
    "description": "The function call object from LLM (e.g. { \"name\": \"get_weather\", \"arguments\": {\"city\":\"Paris\"} })",
    "type": "object"
   }
  },
  "required": [
   "function_call",
   "allowed_functions"
  ],
  "type": "object"
 },
 "name": "function_call_validate",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "error_count": {
    "type": "number"
   },
   "errors": {
    "type": "array"
   },
   "function_name": {},
   "provided_args": {},
   "required_args": {},
   "valid": {
    "type": "boolean"
   }
  },
  "type": "object"
 }
}
