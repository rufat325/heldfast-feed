{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "CodeInspectus Setup"
 },
 "description": "Inspect external-engine health and exact platform download sizes, save declined choices, or install selected Opengrep/Gitleaks/Trivy components after explicit confirmation. Plan is offline. Install writes only to ~/.codeinspectus, verifies immutable pins/publisher provenance, and never modifies the target repository.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "default": "plan",
    "description": "Plan is offline/read-only. Install downloads only after confirm_downloads=true. Decline saves the choice.",
    "enum": [
     "plan",
     "install",
     "decline"
    ],
    "type": "string"
   },
   "components": {
    "description": "Components to install or decline. Default: all three external engines.",
    "items": {
     "enum": [
      "opengrep",
      "gitleaks",
      "trivy"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "confirm_downloads": {
    "description": "Must be true for an install that needs network downloads.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "codeinspectus_setup",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "type": "string"
   },
   "outcome": {
    "enum": [
     "planned",
     "installed",
     "declined"
    ],
    "type": "string"
   },
   "plan": {
    "additionalProperties": false,
    "properties": {
     "components": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "action": {
         "enum": [
          "none",
          "download",
          "redownload",
          "refresh_database",
          "blocked"
         ],
         "type": "string"
        },
        "coverage": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "download_size_bytes": {
         "minimum": 0,
         "type": "integer"
        },
        "estimated_database_disk_bytes": {
         "minimum": 0,
         "type": "integer"
        },
        "id": {
         "enum": [
          "opengrep",
          "gitleaks",
          "trivy"
         ],
         "type": "string"
        },
        "license": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "note": {
         "type": "string"
        },
        "selected": {
         "type": "boolean"
        },
        "state": {
         "type": "string"
        },
        "version": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "name",
        "version",
        "state",
        "action",
        "selected",
        "coverage",
        "license"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "confirmation_required": {
      "type": "boolean"
     },
     "estimated_database_disk_bytes": {
      "minimum": 0,
      "type": "integer"
     },
     "exact_download_bytes": {
      "minimum": 0,
      "type": "integer"
     },
     "native": {
      "additionalProperties": false,
      "properties": {
       "coverage": {
        "type": "string"
       },
       "download_required": {
        "const": false,
        "type": "boolean"
       },
       "rule_count": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "rule_count",
       "download_required",
       "coverage"
      ],
      "type": "object"
     },
     "network_required": {
      "type": "boolean"
     },
     "platform": {
      "type": "string"
     },
     "preference_state": {
      "enum": [
       "unconfigured",
       "configured",
       "invalid"
      ],
      "type": "string"
     },
     "schema_version": {
      "const": "1.0.0",
      "type": "string"
     },
     "verifier": {
      "additionalProperties": false,
      "properties": {
       "available": {
        "type": "boolean"
       },
       "download_size_bytes": {
        "minimum": 0,
        "type": "integer"
       },
       "license": {
        "const": "Apache-2.0",
        "type": "string"
       },
       "name": {
        "const": "Cosign",
        "type": "string"
       },
       "purpose": {
        "type": "string"
       },
       "required": {
        "type": "boolean"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "version",
       "required",
       "available",
       "license",
       "purpose"
      ],
      "type": "object"
     },
     "warnings": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "schema_version",
     "platform",
     "native",
     "components",
     "verifier",
     "preference_state",
     "network_required",
     "confirmation_required",
     "exact_download_bytes",
     "estimated_database_disk_bytes",
     "warnings"
    ],
    "type": "object"
   }
  },
  "required": [
   "outcome",
   "message",
   "plan"
  ],
  "type": "object"
 },
 "title": "Plan or install external security engines"
}
