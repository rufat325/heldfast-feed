{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a QLab OSC cue-stack scaffold with cue command maps, status, and rehearsal-focused setup notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "description": "Activate OSC operators immediately.",
    "type": "boolean"
   },
   "cue_count": {
    "default": 16,
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   },
   "include_transport": {
    "default": true,
    "description": "Include GO/STOP/PAUSE/RESUME rows.",
    "type": "boolean"
   },
   "name": {
    "default": "qlab_cue_stack",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the QLab scaffold.",
    "type": "string"
   },
   "qlab_host": {
    "default": "127.0.0.1",
    "description": "QLab OSC host.",
    "type": "string"
   },
   "receive_port": {
    "default": 53001,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "send_port": {
    "default": 53000,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "workspace_id": {
    "description": "Optional QLab workspace identifier/label.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "connect_qlab_cue_stack",
 "title": "Connect QLab cue stack"
}
