{
 "_meta": {
  "openai/widgetAccessible": true
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Prepare Staged Attachment Upload"
 },
 "description": "Create a five-minute, one-time raw upload URL bound to the mailbox, filename, content type, byte size, and SHA-256 digest. The upload returns a staged attachment ID.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "content_type": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "filename": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "mailbox_id": {
    "description": "Mailbox ID the staged attachment will be bound to.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "sha256": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "size": {
    "maximum": 26214400,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "mailbox_id",
   "filename",
   "content_type",
   "size",
   "sha256"
  ],
  "type": "object"
 },
 "name": "shipmail_prepare_staged_attachment_upload",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "prepared_upload": {
    "properties": {
     "content_type": {
      "type": "string"
     },
     "expires_at": {
      "type": "string"
     },
     "filename": {
      "type": "string"
     },
     "mailbox_id": {
      "type": "string"
     },
     "sha256": {
      "type": "string"
     },
     "size": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "upload_method": {
      "type": "string"
     },
     "upload_url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "mailbox_id",
     "filename",
     "content_type",
     "size",
     "sha256",
     "upload_url",
     "upload_method",
     "expires_at"
    ],
    "type": "object"
   }
  },
  "required": [
   "prepared_upload"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Prepare Staged Attachment Upload"
}
