{"_meta":{"xdata.kr/credential":{"providers":["hometax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=hometax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: hometax__session__login (\uac19\uc740 account_link_id). filing_type \uc73c\ub85c \uc2e0\uace0 \uad6c\ubd84\uc744 \uc815\ud574(regular \uc815\uae30, amendment \uc218\uc815, late \uae30\ud55c\ud6c4, \uae30\ubcf8 regular) \uc6d0\ucc9c\uc138 \uc804\uc790\ud30c\uc77c \ubcc0\ud658\uc2e0\uace0\ub97c \uc2dc\uc791\ud569\ub2c8\ub2e4. \uae30\uad00\uc774 \ubc1b\ub294 \uc6d0\ubcf8 \ud30c\uc77c \ud06c\uae30 \ubc94\uc704\uc640 \uc9c4\ud589 \uc911\uc778 \ubcc0\ud658 \uc791\uc5c5\uc744 \uc77d\uae30\ub9cc \ud558\uace0 \uae30\uad00\uc5d0 \uc544\ubb34\uac83\ub3c4 \uc62c\ub9ac\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uae30\uad00\uc5d0 \uc9c4\ud589 \uc911\uc778 \uc791\uc5c5\uc774 \uc788\uc73c\uba74 \uadf8 \uc791\uc5c5 \ubc88\ud638\ub97c resume_batch_id \ub85c \ubcf4\ub0b4 \uc774\uc5b4 \uac11\ub2c8\ub2e4. \uc774 \ub2e8\uacc4\uc758 job_id \uc640 snapshot_hash \ub85c \uc6d0\ubcf8\uc744 \ub4f1\ub85d\ud558\uace0 upload \ub97c \ubd80\ub985\ub2c8\ub2e4. \ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc774\uba74 \uccab \uc694\uccad \uc804\uc5d0 request_idempotency_key \uac12\uc744 \ub9cc\ub4e4\uc5b4 \uc800\uc7a5\ud558\uc138\uc694. \uc751\ub2f5\uc744 \ubc1b\uc9c0 \ubabb\ud55c \uadf8 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c\ub9cc \uac19\uc740 \uc778\uc790\uc640 \ud568\uaed8 \uadf8 \uac12\uc744 \ub2e4\uc2dc \ubcf4\ub0b4\uace0, \uc0c8\ub85c \uc2e4\ud589\ud560 \ub54c\ub294 \uc0c8 \uac12\uc744 \uc4f0\uc138\uc694. \uc774 \uac12 \uc5c6\uc774 \ub2e4\uc2dc \ubd80\ub974\uba74 \uc0c8 \uc694\uccad\uc774 \ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5c6\uc774 \ub9db\ubcf4\uae30\ub85c \ubd80\ub97c \ub54c\ub294 \uc774 \uc120\ud0dd \uce78\uc744 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00 \uc5c5\ubb34\uc5d0 \ub530\ub85c \uc788\ub294 idempotency_key \uce78\uc740 \ub2e4\ub978 \uce78\uc774\ub2c8 \uadf8\ub300\ub85c \ub450\uc138\uc694. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 2\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"filing_type":{"default":"regular","description":"\ubcc0\ud658\ud560 \uc2e0\uace0\uc758 \uc885\ub958\uc785\ub2c8\ub2e4. regular(\uc815\uae30\uc2e0\uace0), amendment(\uc218\uc815\uc2e0\uace0), late(\uae30\ud55c\ud6c4\uc2e0\uace0) \uac00\uc6b4\ub370 \ud558\ub098\ub97c \uc785\ub825\ud558\uba70 \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 regular \uc785\ub2c8\ub2e4. \uc774 \uac12\uc740 \uc774\uc5b4\uc9c0\ub294 \ub2e8\uacc4\uc5d0 \uadf8\ub300\ub85c \uc774\uc5b4\uc9c0\uace0, \uc774\ubbf8 \uc811\uc218\ub41c \uc2e0\uace0\ub97c \ub2e4\uc2dc \uc62c\ub9ac\ub294 \uc7ac\uc2e0\uace0\ub294 regular \uc5d0\uc11c\ub9cc \ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","enum":["regular","amendment","late"],"title":"Filing Type","type":"string"},"request_idempotency_key":{"description":"\ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc5d0\uc11c \uc751\ub2f5\uc744 \ubabb \ubc1b\uc740 \uac19\uc740 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c \uc4f0\ub294 \uc120\ud0dd \uac12\uc785\ub2c8\ub2e4. \uc4f0\ub294 \ubc95\uc740 \ub3c4\uad6c \uc124\uba85\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.","maxLength":128,"minLength":1,"pattern":"^[\\x20-\\x7E]+$","type":"string"},"resume_batch_id":{"anyOf":[{"maxLength":100,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"\uae30\uad00\uc5d0 \uc774\ubbf8 \uc9c4\ud589 \uc911\uc778 \ubcc0\ud658 \uc791\uc5c5\uc744 \uc774\uc5b4\uac08 \ub54c \uadf8 \uc791\uc5c5\uc758 \uc2dd\ubcc4\uc790\uc785\ub2c8\ub2e4. \uc9c4\ud589\ud604\ud669\uc5d0 \ub098\uc628 \uc791\uc5c5 ID \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud558\uba70 1\uc790 \uc774\uc0c1 100\uc790 \uc774\ud558\uc785\ub2c8\ub2e4. \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \uc0c8 \ubcc0\ud658 \uc791\uc5c5\uc73c\ub85c \uc2dc\uc791\ud558\uace0, \uae30\uad00\uc5d0 \uc9c4\ud589 \uc911\uc778 \ubcc0\ud658 \uc791\uc5c5\uc774 \uc788\ub294\ub370 \uc774 \uac12\uc744 \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \uae30\uc874 \ubcc0\ud658 \uc791\uc5c5\uc774 \uc788\ub2e4\ub294 \uc624\ub958(409)\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","title":"Resume Batch Id"}},"title":"InitRequest","type":"object"},"name":"hometax__tax__withholding__file_conversion__init","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\ud648\ud0dd\uc2a4 \uc6d0\ucc9c\uc138 \uc804\uc790\ud30c\uc77c \ubcc0\ud658\uc2e0\uace0 \uc791\uc5c5 \uc2dc\uc791"}
