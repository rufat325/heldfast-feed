{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Explain a block"
 },
 "description": "What one block is and what it contributes: its parameters as written and as evaluated, the shape on every port, its share of the model's weights and compute, and its documentation. Use it to answer \"why is this block this size\" without reading the whole design.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "B": {
    "description": "Micro-batch size.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "S": {
    "description": "Source length, for an encoder-decoder: the second sequence its encoder runs along. Defaults to the document's own S; ignored by a design that declares none.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "T": {
    "description": "Sequence length. Defaults to the document's own T.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "concurrency": {
    "description": "Concurrent sequences when serving.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "design_id": {
    "description": "Handle returned by tensorcad_new_design or tensorcad_open_design, e.g. \"dsn_1\".",
    "type": "string"
   },
   "dp": {
    "description": "Data parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "dtype": {
    "description": "Training dtype. Default bf16.",
    "enum": [
     "fp32",
     "bf16",
     "fp16",
     "fp8"
    ],
    "type": "string"
   },
   "ep": {
    "description": "Expert parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "gpus": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "hardware": {
    "description": "Hardware id: h100-sxm, h200-sxm, b200, a100-80, rtx5080 or rtx4090. Default h100-sxm.",
    "type": "string"
   },
   "mfu": {
    "description": "Model FLOPs utilization, 0..1.",
    "exclusiveMinimum": 0,
    "maximum": 1,
    "type": "number"
   },
   "optimizer": {
    "enum": [
     "adamw",
     "adamw8bit",
     "muon",
     "sgd_momentum",
     "sgd",
     "bf16_adam"
    ],
    "type": "string"
   },
   "packing": {
    "description": "Training rows packed with documents, for a design whose mask keeps them apart (doc(b, q) == doc(b, kv)). Moves the training figures and the cost, not serving.",
    "properties": {
     "mean": {
      "description": "Mean document length, in tokens.",
      "minimum": 1,
      "type": "number"
     },
     "spread": {
      "description": "Coefficient of variation of the lengths: 0, the default, is fixed; 1 is exponential.",
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "mean"
    ],
    "type": "object"
   },
   "path": {
    "description": "Full path of the block, e.g. \"layers/block/attn\".",
    "type": "string"
   },
   "pp": {
    "description": "Pipeline parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "recompute": {
    "enum": [
     "none",
     "selective",
     "full"
    ],
    "type": "string"
   },
   "tokens": {
    "description": "Training token budget. Defaults to Chinchilla-optimal.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "tp": {
    "description": "Tensor parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "zero": {
    "description": "ZeRO/FSDP sharding stage.",
    "maximum": 3,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "design_id",
   "path"
  ],
  "type": "object"
 },
 "name": "tensorcad_explain",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "copies": {
    "additionalProperties": false,
    "properties": {
     "active": {
      "type": "number"
     },
     "total": {
      "type": "number"
     }
    },
    "required": [
     "total",
     "active"
    ],
    "type": "object"
   },
   "design_id": {
    "type": "string"
   },
   "flops_per_token": {
    "type": "number"
   },
   "kind": {
    "type": "string"
   },
   "parameters": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "doc": {
       "type": "string"
      },
      "expression": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "params": {
    "type": "number"
   },
   "path": {
    "type": "string"
   },
   "ports": {
    "additionalProperties": false,
    "properties": {
     "in": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "out": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "required": [
     "in",
     "out"
    ],
    "type": "object"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "share_of_flops": {
    "type": "number"
   },
   "share_of_params": {
    "type": "number"
   },
   "summary": {
    "type": "string"
   },
   "type": {
    "type": "string"
   }
  },
  "required": [
   "design_id",
   "revision",
   "path",
   "type",
   "kind",
   "params",
   "share_of_params",
   "flops_per_token",
   "share_of_flops",
   "copies",
   "parameters",
   "ports"
  ],
  "type": "object"
 },
 "title": "Explain a block"
}
