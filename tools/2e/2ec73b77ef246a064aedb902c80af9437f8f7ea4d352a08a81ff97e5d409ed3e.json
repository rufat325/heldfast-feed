{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Safely inspect, install, update, or uninstall the small bundled tdmcp skill catalog for Codex or Claude. Mutations default to dry-run, use exact manifest ownership, reject unowned conflicts and symlinks, and roll back partial filesystem changes. Only package-bundled skills are accepted; this is not a remote or arbitrary skill installer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Inspect, install, update, or uninstall manifest-owned bundled tdmcp skills.",
    "enum": [
     "status",
     "install",
     "update",
     "uninstall"
    ],
    "type": "string"
   },
   "dry_run": {
    "default": true,
    "description": "Plan without writing. Must be explicitly false to apply a mutation.",
    "type": "boolean"
   },
   "force_owned_drift": {
    "default": false,
    "description": "Allow replacement/removal of content already recorded by the manifest but locally changed. Never permits touching unowned paths.",
    "type": "boolean"
   },
   "host": {
    "description": "Agent host whose skill directory is managed.",
    "enum": [
     "codex",
     "claude"
    ],
    "type": "string"
   },
   "project_root": {
    "description": "Absolute project path. Required for project scope unless a CLI injects its cwd.",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "scope": {
    "description": "Project-local or current-user skill installation scope.",
    "enum": [
     "project",
     "user"
    ],
    "type": "string"
   },
   "skills": {
    "description": "Bundled skills to manage. Omit for the complete curated catalog.",
    "items": {
     "pattern": "^tdmcp-[a-z0-9-]+$",
     "type": "string"
    },
    "maxItems": 16,
    "type": "array"
   }
  },
  "required": [
   "action",
   "host",
   "scope"
  ],
  "type": "object"
 },
 "name": "manage_agent_skills",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "status",
     "install",
     "update",
     "uninstall"
    ],
    "type": "string"
   },
   "applied": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "from_sha256": {
       "type": "string"
      },
      "name": {
       "pattern": "^tdmcp-[a-z0-9-]+$",
       "type": "string"
      },
      "operation": {
       "enum": [
        "install",
        "update",
        "remove",
        "unchanged"
       ],
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "to_sha256": {
       "type": "string"
      }
     },
     "required": [
      "operation",
      "name",
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dry_run": {
    "type": "boolean"
   },
   "host": {
    "enum": [
     "codex",
     "claude"
    ],
    "type": "string"
   },
   "manifest_path": {
    "type": "string"
   },
   "planned": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "from_sha256": {
       "type": "string"
      },
      "name": {
       "pattern": "^tdmcp-[a-z0-9-]+$",
       "type": "string"
      },
      "operation": {
       "enum": [
        "install",
        "update",
        "remove",
        "unchanged"
       ],
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "to_sha256": {
       "type": "string"
      }
     },
     "required": [
      "operation",
      "name",
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scope": {
    "enum": [
     "project",
     "user"
    ],
    "type": "string"
   },
   "skills": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "installed_sha256": {
       "type": "string"
      },
      "name": {
       "pattern": "^tdmcp-[a-z0-9-]+$",
       "type": "string"
      },
      "owned": {
       "type": "boolean"
      },
      "path": {
       "type": "string"
      },
      "source_sha256": {
       "type": "string"
      },
      "state": {
       "enum": [
        "not_installed",
        "installed",
        "outdated",
        "missing",
        "drifted",
        "unowned_conflict"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "path",
      "state",
      "source_sha256",
      "owned"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source_version": {
    "type": "string"
   },
   "status": {
    "enum": [
     "planned",
     "applied",
     "no_change",
     "conflict",
     "failed"
    ],
    "type": "string"
   },
   "target_root": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "action",
   "status",
   "dry_run",
   "host",
   "scope",
   "target_root",
   "manifest_path",
   "source_version",
   "planned",
   "applied",
   "skills",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Manage bundled agent skills"
}
