{"_meta":{"openai/outputTemplate":"ui://atlasly/workspace/v15.html","ui":{"resourceUri":"ui://atlasly/workspace/v15.html"}},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Site Verdict"},"description":"Purpose: produce the one-call Atlasly hero appraisal for a known UK site. When to use: use first for acquisition, feasibility, concept, or planning-stage questions that need a clear Proceed, Investigate, or Stop screen rather than separate lookups. Returns: potential dealbreakers, design-changing risks, visible unknowns, source links, boundary confidence, a static constraint map with numbered callouts matching the written verdict, and a temporary branded share card; public use requires no Atlasly account. Limitations: address-only results are explicitly a point-radius screen, not parcel intersections; Stop uses conservative affirmative official sample-text matches to explicit no-go phrases, not an arbitrary rule interpreter. Failed/unverified source gaps cannot trigger Stop or prove a clear site; completeness and source freshness remain unverified. A successful geography render is not full-boundary verification, and fallback geography is unverified. Parameter guidance: provide a full UK address or postcode, intended_use, project_stage, optional proposal detail, radius 250\u20131000m, and any explicit no_go_triggers such as Flood Zone 3 or Green Belt; optional persist_share_card=false skips the temporary share-card record, while static map storage remains separate. Chaining: every response returns site_ref; pass it unchanged into another Atlasly tool to reuse the canonical site, coordinates, boundary confidence, LPA, evidence links, and project context.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"address":{"description":"UK site address or postcode","minLength":3,"type":"string"},"intended_use":{"description":"Intended use, for example residential, office, school, or mixed use","minLength":2,"type":"string"},"no_go_triggers":{"description":"Explicit user rules that may justify Stop when matched by retrieved evidence","items":{"minLength":3,"type":"string"},"maxItems":12,"type":"array"},"persist_share_card":{"description":"Default true creates a temporary token-accessible share-card record; false skips that record. Static map storage is separate and may still occur.","type":"boolean"},"project_stage":{"description":"Project stage, for example acquisition, feasibility, concept, or planning","minLength":2,"type":"string"},"proposal":{"description":"Optional proposal detail such as scale, height, units, or works","minLength":3,"type":"string"},"radius_meters":{"description":"Point-screen radius in metres; defaults to 800","maximum":1000,"minimum":250,"type":"integer"},"site_ref":{"description":"Canonical site_ref returned by any previous Atlasly tool. Pass it unchanged to chain the same resolved site into this call; address, search_area, or project_id will be filled from it when omitted.","properties":{"address_aliases":{"items":{"maxLength":300,"minLength":1,"type":"string"},"maxItems":4,"type":"array"},"boundary_confidence":{"enum":["address_point","inferred_parcel","red_line_upload","unknown"],"type":"string"},"boundary_id":{"type":["string","null"]},"canonical_address":{"type":["string","null"]},"coordinates":{"anyOf":[{"properties":{"lat":{"type":"number"},"lng":{"type":"number"}},"required":["lat","lng"],"type":"object"},{"type":"null"}]},"country_code":{"pattern":"^[a-z]{2}$","type":"string"},"id":{"type":["string","null"]},"jurisdiction":{"type":["string","null"]},"local_planning_authority":{"type":["string","null"]},"location_source":{"enum":["geocoder","user_coordinates"],"type":"string"},"project_id":{"type":["string","null"]},"source_links":{"items":{"properties":{"label":{"type":"string"},"url":{"format":"uri","type":"string"}},"required":["label","url"],"type":"object"},"type":"array"},"status":{"enum":["resolved","partial","unresolved"],"type":"string"},"version":{"const":"1","type":"string"}},"required":["version","status","id","canonical_address","coordinates","boundary_id","boundary_confidence","jurisdiction","local_planning_authority","source_links","project_id"],"type":"object"}},"required":["intended_use","project_stage"],"type":"object"},"name":"site_verdict","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"atlasly_link":{"additionalProperties":false,"properties":{"label":{"type":"string"},"url":{"type":"string"}},"required":["label","url"],"type":"object"},"confidence_notes":{"items":{"type":"string"},"type":"array"},"details":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"error_code":{"type":"string"},"error_source":{"type":"string"},"executive_summary":{"type":"string"},"headline":{"type":"string"},"human_message":{"type":"string"},"key_data_points":{"items":{"additionalProperties":false,"properties":{"confidence":{"enum":["high","medium","low"],"type":"string"},"label":{"type":"string"},"provenance":{"enum":["official_data","policy_citation","atlasly_inference","user_input"],"type":"string"},"value":{"type":"string"}},"required":["label","value","confidence","provenance"],"type":"object"},"type":"array"},"message":{"type":"string"},"next_best_actions":{"items":{"type":"string"},"type":"array"},"query":{"additionalProperties":false,"properties":{"address":{"type":"string"},"country_code":{"type":"string"},"display_name":{"type":"string"},"geocode_confidence":{"enum":["exact","postcode_only","district_approximation","user_supplied"],"type":"string"},"jurisdiction":{"type":"string"},"lat":{"type":"number"},"lng":{"type":"number"},"local_authority":{"type":"string"},"location_source":{"enum":["geocoder","user_coordinates"],"type":"string"},"radius_capped":{"type":"boolean"},"radius_meters":{"type":"number"},"support_level":{"enum":["uk_full","limited"],"type":"string"