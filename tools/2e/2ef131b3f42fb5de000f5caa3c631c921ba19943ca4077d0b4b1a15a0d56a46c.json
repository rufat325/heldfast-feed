 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "relationshipType": {
    "description": "Description of the link relationship (e.g. 'variation', 'social_crop', 'thumbnail')",
    "type": "string"
   },
   "sourceId": {
    "description": "The parent/source asset ID",
    "type": "string"
   },
   "targetId": {
    "description": "The child/target asset ID",
    "type": "string"
   }
  },
  "required": [
   "sourceId",
   "targetId",
   "relationshipType"
  ],
  "type": "object"
 },
 "name": "link_assets"
}
