{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "When the user asks which repository files to hand off to another agent or reviewer, call with arguments such as {\"entries\":[{\"path\":\"src/app.py\",\"kind\":\"file\"}]}. Send permitted relative filenames and kinds only; never file contents, secrets or URLs. Returns exact zero-based include/exclude/skip indexes and reasons for the original entries. This is filename-only planning, not a content security scan or permission to upload.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "file",
        "directory",
        "symlink"
       ],
       "type": "string"
      },
      "path": {
       "maxLength": 512,
       "type": "string"
      }
     },
     "required": [
      "path",
      "kind"
     ],
     "type": "object"
    },
    "maxItems": 1024,
    "type": "array"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 },
 "name": "prepare_repository_handoff",
 "outputSchema": {
  "properties": {
   "contentSecurityVerified": {
    "const": false
   },
   "entriesReceived": {
    "type": "integer"
   },
   "entryDecisions": {
    "items": {
     "properties": {
      "decision": {
       "enum": [
        "ALLOW",
        "DENY",
        "SKIP"
       ]
      },
      "index": {
       "minimum": 0,
       "type": "integer"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "index",
      "decision",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "excludeIndexes": {
    "items": {
     "minimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "includeIndexes": {
    "items": {
     "minimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "manifestDigest": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "schema": {
    "type": "string"
   },
   "skipIndexes": {
    "items": {
     "minimum": 0,
     "type": "integer"
    },
    "type": "array"
   }
  },
  "required": [
   "schema",
   "entriesReceived",
   "entryDecisions",
   "includeIndexes",
   "excludeIndexes",
   "skipIndexes",
   "manifestDigest",
   "contentSecurityVerified"
  ],
  "type": "object"
 }
}
