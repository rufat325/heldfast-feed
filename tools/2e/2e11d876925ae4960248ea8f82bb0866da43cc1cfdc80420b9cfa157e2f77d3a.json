{
 "description": "Format and prettify CSS stylesheets with proper indentation",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "css": {
    "description": "CSS string to format",
    "type": "string"
   },
   "indent": {
    "default": 2,
    "description": "Indent spaces (default 2)",
    "type": "number"
   },
   "minify": {
    "default": false,
    "description": "If true, minify instead of format",
    "type": "boolean"
   }
  },
  "required": [
   "css"
  ],
  "type": "object"
 },
 "name": "format_css"
}
