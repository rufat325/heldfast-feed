{
 "description": "Create a WooCommerce product",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attributes": {
    "description": "Product attributes",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Attribute name (custom) or taxonomy (pa_color)",
       "type": "string"
      },
      "options": {
       "description": "Option values (default [])",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "variation": {
       "description": "Used for variations (default false)",
       "type": "boolean"
      },
      "visible": {
       "description": "Show on the product page (default true)",
       "type": "boolean"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "categories": {
    "description": "Product category IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "description": {
    "description": "Long description (HTML)",
    "type": "string"
   },
   "images": {
    "description": "Attachment IDs; the first is the main image, the rest the gallery",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "manage_stock": {
    "description": "Track stock quantity (default false)",
    "type": "boolean"
   },
   "meta_data": {
    "description": "Custom meta to set",
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "type": "string"
      },
      "value": {}
     },
     "required": [
      "key"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Product name",
    "type": "string"
   },
   "regular_price": {
    "description": "Regular price as decimal string, e.g. \"19.90\"",
    "type": "string"
   },
   "sale_price": {
    "description": "Sale price as decimal string",
    "type": "string"
   },
   "short_description": {
    "description": "Short description (HTML)",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "sku": {
    "description": "SKU (must be unique)",
    "type": "string"
   },
   "status": {
    "description": "Status (default publish)",
    "enum": [
     "draft",
     "pending",
     "private",
     "publish"
    ],
    "type": "string"
   },
   "stock_quantity": {
    "description": "Stock quantity (used when manage_stock is true)",
    "type": "integer"
   },
   "stock_status": {
    "description": "Stock status (default instock)",
    "enum": [
     "instock",
     "outofstock",
     "onbackorder"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Product tag IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "type": {
    "description": "Product type (default simple)",
    "enum": [
     "simple",
     "grouped",
     "external",
     "variable"
    ],
    "type": "string"
   }
  },
  "required": [
   "site",
   "name"
  ],
  "type": "object"
 },
 "name": "woo_create_product"
}
