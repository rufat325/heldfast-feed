    "approved": true,
    "cdp_endpoint": "http://127.0.0.1:9222",
    "max_timeline_events": 2000,
    "observation_ms": 10000,
    "target_id": "TARGET_ID_FROM_LIST_BROWSER_TARGETS"
   }
  ],
  "properties": {
   "allowed_origins": {
    "description": "Value for allowed origins.",
    "items": {
     "maxLength": 2048,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 32,
    "minItems": 1,
    "type": "array"
   },
   "approved": {
    "const": true,
    "description": "Explicit operator approval to perform this operation.",
    "type": "boolean"
   },
   "cdp_endpoint": {
    "description": "Approved literal loopback Chrome DevTools Protocol endpoint.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "max_timeline_events": {
    "default": 2000,
    "description": "Maximum permitted timeline events for this operation.",
    "maximum": 20000,
    "minimum": 1,
    "type": "integer"
   },
   "observation_ms": {
    "default": 10000,
    "description": "Value for observation ms.",
    "maximum": 60000,
    "minimum": 1,
    "type": "integer"
   },
   "target_id": {
    "description": "Exact authorized CDP target identifier.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "cdp_endpoint",
   "allowed_origins",
   "target_id",
   "approved"
  ],
  "type": "object"
 },
