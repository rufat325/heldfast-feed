{
 "description": "Create AND immediately publish a post in one step. Shortcut that creates a draft then publishes it.",
 "inputSchema": {
  "properties": {
   "content": {
    "description": "Post text content",
    "type": "string"
   },
   "mediaType": {
    "enum": [
     "TEXT",
     "IMAGE",
     "VIDEO",
     "CAROUSEL"
    ],
    "type": "string"
   },
   "mediaUrls": {
    "description": "Optional media URLs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "platforms": {
    "description": "Target platforms e.g. ['INSTAGRAM', 'TWITTER']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Optional title",
    "type": "string"
   }
  },
  "required": [
   "content",
   "platforms"
  ],
  "type": "object"
 },
 "name": "postall_create_and_publish"
}
