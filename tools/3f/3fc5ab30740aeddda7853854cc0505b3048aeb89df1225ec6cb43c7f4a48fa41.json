{
 "description": "Upload files to a file input.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filePaths": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "selector": {
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "sessionId",
   "selector",
   "filePaths"
  ],
  "type": "object"
 },
 "name": "browser_upload_file",
 "title": "Browser Upload File"
}
