{
 "description": "List findings (discovered issues) across your targets. Filter by status, severity, or target. Returns title, severity, status, test name, and AI enrichment if available.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 50,
    "description": "Max number of findings to return",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "severity": {
    "description": "Filter by severity",
    "enum": [
     "CRITICAL",
     "WARNING",
     "INFO"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by finding status (default: OPEN)",
    "enum": [
     "OPEN",
     "MUTED",
     "RESOLVED"
    ],
    "type": "string"
   },
   "targetId": {
    "description": "Filter by target ID",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_findings",
 "title": "List Findings"
}
