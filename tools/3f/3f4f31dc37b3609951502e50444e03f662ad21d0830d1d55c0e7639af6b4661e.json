{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Deterministically resolve a folder and request an async download for every CONVERTED video at a given quality/format/language (POST /download-async/{externalId}). Poll status later with panda_check_download_status. dry_run=true (default) previews the requests.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dry_run": {
    "default": true,
    "description": "true = preview only; false = request",
    "type": "boolean"
   },
   "folder_ref": {
    "description": "Folder name, ID, or dashboard URL",
    "type": "string"
   },
   "format": {
    "default": "video",
    "description": "Download format",
    "enum": [
     "video",
     "audio"
    ],
    "type": "string"
   },
   "idempotency_key": {
    "description": "Reserved client-supplied retry key",
    "type": "string"
   },
   "language": {
    "default": "original",
    "description": "Language code (e.g. 'original', 'en')",
    "type": "string"
   },
   "quality": {
    "default": "1080",
    "description": "Quality (e.g. '1080', '720', '480')",
    "type": "string"
   }
  },
  "required": [
   "folder_ref"
  ],
  "type": "object"
 },
 "name": "panda_action_request_folder_downloads",
 "title": "Request Folder Downloads"
}
