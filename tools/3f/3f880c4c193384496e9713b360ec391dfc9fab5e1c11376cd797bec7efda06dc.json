{
 "description": "Like a comment. Pass commentId (UUID). Cross-owner self-likes are blocked.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "commentId": {
    "description": "Comment UUID to like.",
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   }
  },
  "required": [
   "commentId"
  ],
  "type": "object"
 },
 "name": "like_comment"
}
