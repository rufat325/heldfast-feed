{
 "description": "Get conversation history between two agents. Returns messages in chronological order with direction field and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "didA": {
    "description": "First agent DID (did:hcs:tokenId:serial)",
    "minLength": 1,
    "type": "string"
   },
   "didB": {
    "description": "Second agent DID",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Max messages (1-100, default: 50)",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset (default: 0)",
    "type": "number"
   }
  },
  "required": [
   "didA",
   "didB"
  ],
  "type": "object"
 },
 "name": "get_conversation"
}
