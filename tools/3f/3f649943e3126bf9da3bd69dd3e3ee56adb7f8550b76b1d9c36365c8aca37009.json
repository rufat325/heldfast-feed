{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search public RegusciLabs content in Spanish or English. Returns source links and excerpts, not generated claims.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Use nextCursor from the previous response with the same query and locale.",
    "pattern": "^\\d{1,7}$",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "es",
    "enum": [
     "es",
     "en"
    ],
    "type": "string"
   },
   "query": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_information"
}
