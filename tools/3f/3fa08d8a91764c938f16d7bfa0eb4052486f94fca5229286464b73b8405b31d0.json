{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:ads"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update a campaign"
 },
 "description": "Update a campaign. Spending/deletion: preview, then owner-approved confirm:true with the same requestId. Other edits: one call. Creates request active; report returned status and claim live only when active. Full field guide: soclo://tools/soclo_ads_update_ad_campaign.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "properties": {
     "campaignId": {
      "type": "string"
     }
    },
    "required": [
     "campaignId"
    ],
    "type": "object"
   },
   "payload": {
    "properties": {
     "allowSharedBudgetUpdate": {
      "type": "boolean"
     },
     "bidAmount": {
      "type": "number"
     },
     "bidStrategy": {
      "enum": [
       "LOWEST_COST_WITHOUT_CAP",
       "LOWEST_COST_WITH_BID_CAP",
       "COST_CAP",
       "LOWEST_COST_WITH_MIN_ROAS"
      ],
      "type": "string"
     },
     "budget": {
      "properties": {
       "amount": {
        "description": "Budget amount in the ad account's currency",
        "type": "number"
       },
       "type": {
        "enum": [
         "daily",
         "lifetime"
        ],
        "type": "string"
       }
      },
      "required": [
       "amount",
       "type"
      ],
      "type": "object"
     },
     "finalUrlSuffix": {
      "type": "string"
     },
     "manualCpc": {
      "additionalProperties": false,
      "properties": {
       "maxCpc": {
        "type": "number"
       }
      },
      "required": [
       "maxCpc"
      ],
      "type": "object"
     },
     "name": {
      "description": "**Meta only.** Rename the campaign.",
      "maxLength": 255,
      "type": "string"
     },
     "networkSettings": {
      "additionalProperties": false,
      "properties": {
       "displayNetwork": {
        "type": "boolean"
       },
       "searchPartners": {
        "description": "campaign.network_settings.target_search_network",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "platformSpecificData": {
      "properties": {
       "spendCap": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "type": "object"
     },
     "portfolioBidStrategyId": {
      "pattern": "^\\d+$",
      "type": "string"
     },
     "roasAverageFloor": {
      "type": "number"
     },
     "sharedBudgetId": {
      "anyOf": [
       {
        "pattern": "^\\d+$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "targetImpressionShare": {
      "properties": {
       "location": {
        "enum": [
         "ANYWHERE_ON_PAGE",
         "TOP_OF_PAGE",
         "ABSOLUTE_TOP_OF_PAGE"
        ],
        "type": "string"
       },
       "maxCpc": {
        "type": "number"
       },
       "percent": {
        "maximum": 100,
        "type": "number"
       }
      },
      "required": [
       "location",
       "percent",
       "maxCpc"
      ],
      "type": "object"
     },
     "trackingUrlTemplate": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "parameters",
   "payload"
  ],
  "type": "object"
 },
 "name": "soclo_ads_update_ad_campaign",
 "title": "Update a campaign"
}
