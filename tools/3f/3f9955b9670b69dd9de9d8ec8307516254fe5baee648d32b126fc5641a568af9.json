{
 "description": "Survivor HUD kit: hud.json + cartoon PNGs + Godot .tscn + Three / Unity / Unreal snippets. Writes the folder (npm). 1 credit. Do not redraw the hearts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currencies": {
    "description": "default [\"gem\",\"mushroom\",\"drop\"]",
    "items": {
     "type": "string"
    },
    "maxItems": 6,
    "type": "array"
   },
   "health_max": {
    "description": "default 5",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "health_style": {
    "description": "hearts skin or bar skin, or custom:<slug> from gripforge_hud_bar",
    "type": "string"
   },
   "health_type": {
    "description": "default hearts",
    "enum": [
     "hearts",
     "bar"
    ],
    "type": "string"
   },
   "minimap": {
    "description": "default false",
    "type": "boolean"
   },
   "out_dir": {
    "description": "Write hud.json, PNGs, tscn, snippets (default ./gripforge-hud)",
    "type": "string"
   },
   "portrait": {
    "description": "default true",
    "type": "boolean"
   },
   "preset": {
    "const": "survivor",
    "description": "v1: survivor only (default)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "gripforge_hud"
}
