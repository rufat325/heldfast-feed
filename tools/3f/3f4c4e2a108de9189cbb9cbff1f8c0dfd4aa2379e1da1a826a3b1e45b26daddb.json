{
 "description": "Prepare a non-executing firmware manifest after owner authorization and an exact compatibility match. Returns backup, recovery, sources, validation and stop points; never returns a flash command.",
 "inputSchema": {
  "properties": {
   "observed": {
    "additionalProperties": false,
    "properties": {
     "codename": {
      "description": "Documented hardware codename, when available.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "firmware_version": {
      "description": "Installed vendor firmware version.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "hardware_revision": {
      "description": "Exact hardware or PCB revision.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "model_number": {
      "description": "Model number from the physical label, not the retail family name.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "sensor": {
      "description": "Confirmed image sensor or other sensor identifier.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "soc": {
      "description": "Confirmed SoC or module identifier.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "wifi_module": {
      "description": "Confirmed Wi-Fi or radio module identifier.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "owner_authorized": {
    "type": "boolean"
   },
   "playbook_id": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "playbook_id",
   "owner_authorized",
   "observed"
  ],
  "type": "object"
 },
 "name": "prepare_firmware_job",
 "outputSchema": {
  "properties": {},
  "type": "object"
 },
 "title": "Prepare a firmware job manifest"
}
