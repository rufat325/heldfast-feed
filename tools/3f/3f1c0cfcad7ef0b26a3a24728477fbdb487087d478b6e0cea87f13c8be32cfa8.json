{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Search Items"},"description":"Search items listed for sale across current public FindA.Sale sales by keyword, with optional category, condition, price range and city filters. Returns item title, price, condition, photos and links to the item and its sale.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"category":{"description":"Category name from list_categories, e.g. \"Furniture\"","maxLength":100,"type":"string"},"city":{"description":"Only items in sales in this city","maxLength":80,"type":"string"},"condition":{"description":"Condition filter, e.g. \"NEW\", \"LIKE_NEW\", \"USED\"","maxLength":40,"type":"string"},"limit":{"description":"Max results (default 20, max 50)","maximum":50,"minimum":1,"type":"integer"},"priceMax":{"description":"Maximum price in US dollars","minimum":0,"type":"number"},"priceMin":{"description":"Minimum price in US dollars","minimum":0,"type":"number"},"query":{"description":"Keywords, e.g. \"brass lamp\" or \"oak dresser\"","maxLength":100,"minLength":1,"type":"string"},"sortBy":{"description":"Sort order (default relevance)","enum":["relevance","newest","price_asc","price_desc"],"type":"string"}},"required":["query"],"type":"object"},"name":"search_items","title":"Search Items"}
