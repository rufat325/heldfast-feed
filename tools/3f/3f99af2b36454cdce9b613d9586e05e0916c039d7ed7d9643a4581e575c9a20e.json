{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Changelog"
 },
 "description": "Returns the first-party Portfolio release history from its complete generated release dataset. Supports exact/latest/all versions, bounded version/date/category/query filters, and stable cursor pagination for complete notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "afterVersion": {
    "minLength": 1,
    "type": "string"
   },
   "category": {
    "enum": [
     "Added",
     "Changed",
     "Fixed",
     "Notes"
    ],
    "type": "string"
   },
   "cursor": {
    "minLength": 1,
    "type": "string"
   },
   "fromDate": {
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "type": "string"
   },
   "throughVersion": {
    "minLength": 1,
    "type": "string"
   },
   "toDate": {
    "minLength": 1,
    "type": "string"
   },
   "version": {
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_changelog",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "complete": {
    "type": "boolean"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "filters": {},
   "found": {
    "type": "boolean"
   },
   "hasMore": {
    "type": "boolean"
   },
   "latestReleasedVersion": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "nextCursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "releases": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "citationUrl": {
       "type": "string"
      },
      "coverage": {},
      "date": {
       "type": "string"
      },
      "items": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "sections": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "items": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "links": {
             "items": {
              "additionalProperties": false,
              "properties": {
               "label": {
                "type": "string"
               },
               "url": {
                "type": "string"
               }
              },
              "required": [
               "label",
               "url"
              ],
              "type": "object"
             },
             "type": "array"
            },
            "text": {
             "type": "string"
            }
           },
           "required": [
            "text",
            "links"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "title": {
          "enum": [
           "Added",
           "Changed",
           "Fixed",
           "Notes"
          ],
          "type": "string"
         }
        },
        "required": [
         "title",
         "items"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "status": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "version",
      "date",
      "status",
      "citationUrl",
      "body",
      "items",
      "sections"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "returnedReleases": {
    "type": "number"
   },
   "source": {},
   "totalMatchingReleases": {
    "type": "number"
   },
   "totalReleases": {
    "type": "number"
   }
  },
  "required": [
   "found",
   "releases",
   "nextCursor",
   "hasMore",
   "complete"
  ],
  "type": "object"
 },
 "title": "Get Changelog"
}
