{
 "description": "Parse any document and generate a structured summary with configurable detail level. Extracts key information, main points, and metadata. Perfect for agents that need document overviews before detailed processing.",
 "inputSchema": {
  "properties": {
   "content": {
    "description": "Document content (text, HTML, or base64 encoded)",
    "type": "string"
   },
   "content_type": {
    "default": "auto",
    "description": "Type of content to summarize",
    "enum": [
     "pdf",
     "html",
     "text",
     "image",
     "auto"
    ],
    "type": "string"
   },
   "file_path": {
    "description": "Path to document file",
    "type": "string"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "extract_keywords": {
      "default": true,
      "description": "Extract key terms and topics",
      "type": "boolean"
     },
     "focus_areas": {
      "description": "Specific topics to focus on in summary",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "include_metadata": {
      "default": true,
      "description": "Include document metadata in summary",
      "type": "boolean"
     },
     "word_limit": {
      "default": 500,
      "description": "Maximum words in summary",
      "type": "number"
     }
    },
    "type": "object"
   },
   "summary_level": {
    "default": "detailed",
    "description": "Level of detail in summary",
    "enum": [
     "brief",
     "detailed",
     "comprehensive"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "summarize_document"
}
