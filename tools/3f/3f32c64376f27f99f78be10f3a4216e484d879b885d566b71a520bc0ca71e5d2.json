{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search EUR-Lex"
 },
 "description": "Search EUR-Lex with structured filters (free text, date range, document type, author, language). Returns a paginated list of matching documents with CELEX numbers, titles, and dates. Use this when the user wants to find documents matching a topic or filter; use lex_get_document afterwards to fetch full content of a specific result.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "author": {
    "oneOf": [
     {
      "enum": [
       "commission",
       "council",
       "parliament",
       "court-of-justice",
       "general-court",
       "ecb",
       "eca",
       "eesc",
       "cor",
       "ema",
       "efsa"
      ],
      "type": "string"
     },
     {
      "items": {
       "enum": [
        "commission",
        "council",
        "parliament",
        "court-of-justice",
        "general-court",
        "ecb",
        "eca",
        "eesc",
        "cor",
        "ema",
        "efsa"
       ],
       "type": "string"
      },
      "type": "array"
     }
    ]
   },
   "dateFrom": {
    "format": "date",
    "type": "string"
   },
   "dateTo": {
    "format": "date",
    "type": "string"
   },
   "documentType": {
    "oneOf": [
     {
      "enum": [
       "judgment",
       "opinion",
       "order",
       "regulation",
       "directive",
       "decision",
       "recommendation",
       "opinion-act",
       "communication",
       "proposal",
       "report",
       "resolution",
       "declaration",
       "treaty",
       "protocol",
       "agreement",
       "written-question",
       "oral-question",
       "consolidated-text",
       "guideline",
       "implementing"
      ],
      "type": "string"
     },
     {
      "items": {
       "enum": [
        "judgment",
        "opinion",
        "order",
        "regulation",
        "directive",
        "decision",
        "recommendation",
        "opinion-act",
        "communication",
        "proposal",
        "report",
        "resolution",
        "declaration",
        "treaty",
        "protocol",
        "agreement",
        "written-question",
        "oral-question",
        "consolidated-text",
        "guideline",
        "implementing"
       ],
       "type": "string"
      },
      "type": "array"
     }
    ]
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "fr",
     "de",
     "es",
     "it",
     "pl",
     "nl",
     "pt",
     "ro",
     "bg",
     "cs",
     "da",
     "el",
     "et",
     "fi",
     "ga",
     "hr",
     "hu",
     "lt",
     "lv",
     "mt",
     "sk",
     "sl",
     "sv"
    ],
    "type": "string"
   },
   "maxPages": {
    "default": 1,
    "description": "Result pages to fetch (clamped by subscription tier).",
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free-text search.",
    "type": "string"
   },
   "textScope": {
    "description": "Where to apply the query string.",
    "enum": [
     "title",
     "text",
     "title-text",
     "any"
    ],
    "type": "string"
   },
   "year": {
    "oneOf": [
     {
      "type": "integer"
     },
     {
      "items": {
       "type": "integer"
      },
      "type": "array"
     }
    ]
   }
  },
  "type": "object"
 },
 "name": "lex_search"
}
