{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compare recruiter keywords and LinkedIn search words with profile text, headline, About or resume. Use it for \"does my profile have the right keywords for backend jobs?\", \"what words am I missing for this job?\" or \"how do I make my LinkedIn headline findable?\". Pass profileText (headline on the first line) and either targetTitles or company and job (the applyUrl or the title). Returns, per role, the title variants, skills, tools and seniority words present or missing, an example boolean search string and whether the text would match it, and short tips for writing the headline and About section as a career story. Fixed lists and the posting's own terms, no AI model; general recruiter practice, not a guarantee. It never reads LinkedIn or any site: the user pastes the text, which is used only while the call runs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "company": {
    "description": "With job: the company name or its careers page link",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "job": {
    "description": "With company: the job's applyUrl from find_company_jobs, or its title as listed",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "level": {
    "description": "The level aimed for, when the target titles do not say it",
    "enum": [
     "intern",
     "entry",
     "mid",
     "senior",
     "lead",
     "staff",
     "principal",
     "manager",
     "director",
     "executive"
    ],
    "type": "string"
   },
   "profileText": {
    "description": "The user's own profile text, pasted: headline on the first line, then the About section and roles. Up to 10,000 characters. It is read for this answer only.",
    "maxLength": 10000,
    "minLength": 20,
    "type": "string"
   },
   "targetTitles": {
    "description": "Job titles the user is aiming for, such as \"Senior Backend Engineer\". Use this or company and job.",
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "profileText"
  ],
  "type": "object"
 },
 "name": "profile_keyword_check",
 "outputSchema": {
  "properties": {
   "asOf": {
    "type": "string"
   },
   "guidance": {
    "type": "string"
   },
   "job": {
    "properties": {
     "applyUrl": {
      "type": "string"
     },
     "company": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "company",
     "title",
     "applyUrl",
     "source"
    ],
    "type": "object"
   },
   "message": {
    "type": "string"
   },
   "narrative": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "roles": {
    "items": {
     "properties": {
      "boolean": {
       "properties": {
        "example": {
         "type": "string"
        },
        "matches": {
         "type": "boolean"
        },
        "unmatched": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "example",
        "matches",
        "unmatched"
       ],
       "type": "object"
      },
      "coverage": {
       "properties": {
        "present": {
         "type": "integer"
        },
        "total": {
         "type": "integer"
        }
       },
       "required": [
        "present",
        "total"
       ],
       "type": "object"
      },
      "family": {
       "type": [
        "string",
        "null"
       ]
      },
      "groups": {
       "items": {
        "properties": {
         "missing": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "name": {
          "enum": [
           "titles",
           "skills",
           "tools",
           "seniority",
           "postingTerms"
          ],
          "type": "string"
         },
         "present": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "name",
         "present",
         "missing"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "level": {
       "type": [
        "string",
        "null"
       ]
      },
      "target": {
       "type": "string"
      }
     },
     "required": [
      "target",
      "family",
      "level",
      "coverage",
      "groups",
      "boolean"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "not_found",
     "job_not_found",
     "unavailable"
    ],
    "type": "string"
   },
   "suggestions": {
    "items": {
     "properties": {
      "applyUrl": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "applyUrl"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Check recruiter and LinkedIn profile keywords"
}
