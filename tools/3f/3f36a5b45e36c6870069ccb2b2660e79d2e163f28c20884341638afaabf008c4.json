{
 "_meta": {
  "openai/annotationJustification": "Replaces the goals catalog used by A/B tests.",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Replace goals"
 },
 "description": "Create or replace all site conversion goals (\u226450). Required before start_test when no goal exists.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "One sentence: why you are calling this tool and what you are trying to accomplish. Stored on the site's activity log and visible to everyone on the site \u2014 never put secrets or personal data here.",
    "minLength": 1,
    "type": "string"
   },
   "goals": {
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "id": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "label": {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        "pathPattern": {
         "description": "Match path exactly or prefix with trailing * (e.g. \"/thanks\" or \"/blog/*\").",
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "type": {
         "const": "pageview",
         "type": "string"
        }
       },
       "required": [
        "id",
        "label",
        "type",
        "pathPattern"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "formId": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "id": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "label": {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        "type": {
         "const": "form",
         "type": "string"
        }
       },
       "required": [
        "id",
        "label",
        "type",
        "formId"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "eventName": {
         "description": "Built-in client event name (0.47.1).",
         "enum": [
          "download",
          "cta_click"
         ],
         "type": "string"
        },
        "id": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "label": {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        "type": {
         "const": "event",
         "type": "string"
        }
       },
       "required": [
        "id",
        "label",
        "type",
        "eventName"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 50,
    "type": "array"
   },
   "guestToken": {
    "description": "Guest token from start_site. Send it on every call until claim_site. Omit when this chat is already signed in to Dotsy.",
    "minLength": 20,
    "type": "string"
   },
   "site": {
    "description": "Site slug, e.g. acme-studio",
    "type": "string"
   }
  },
  "required": [
   "site",
   "goals",
   "context"
  ],
  "type": "object"
 },
 "name": "put_goals"
}
