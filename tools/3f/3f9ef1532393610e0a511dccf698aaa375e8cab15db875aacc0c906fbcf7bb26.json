{
 "_meta": {
  "openai/outputTemplate": "ui://supovia/support-overview-v1.html",
  "openai/toolInvocation/invoked": "Supovia support overview ready.",
  "openai/toolInvocation/invoking": "Loading Supovia support\u2026",
  "ui": {
   "resourceUri": "ui://supovia/support-overview-v1.html"
  },
  "ui/resourceUri": "ui://supovia/support-overview-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show support overview"
 },
 "description": "Use this when someone wants a quick visual summary of their customer support. Returns a card with up to 20 websites (name, domain, AI agent on or off) and the 20 most recently active conversations (channel, open or resolved, times), optionally for one website. Not for complete open-conversation totals.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "websiteId": {
    "description": "Only this website; every website when absent",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "show_support_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "conversations": {
    "description": "The 20 most recently active conversations: channel, resolved state and timestamps. Customer identifiers, internal record ids, message bodies, prompts, credentials, internal notes, organization ids and arbitrary metadata are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "channel": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "resolved": {
       "type": "boolean"
      }
     },
     "required": [
      "channel",
      "resolved",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "conversationsHaveMore": {
    "type": "boolean"
   },
   "openConversationCount": {
    "description": "Open conversations among the 20 shown, not the organization total",
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   },
   "websites": {
    "description": "Up to 20 websites: name, domain and AI-agent status only",
    "items": {
     "additionalProperties": false,
     "properties": {
      "agentEnabled": {
       "type": "boolean"
      },
      "domain": {
       "anyOf": [
        {
         "maxLength": 253,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "domain",
      "agentEnabled"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "websitesHaveMore": {
    "type": "boolean"
   }
  },
  "required": [
   "websites",
   "websitesHaveMore",
   "conversations",
   "conversationsHaveMore",
   "openConversationCount"
  ],
  "type": "object"
 },
 "title": "Show support overview"
}
