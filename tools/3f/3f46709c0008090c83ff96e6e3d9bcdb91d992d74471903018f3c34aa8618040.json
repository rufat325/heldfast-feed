    "type": "string"
   },
   "search": {
    "maxLength": 2048,
    "type": "string"
   },
   "since": {
    "maxLength": 256,
    "type": "string"
   },
   "state": {
    "type": "boolean"
   },
   "version": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "versions": {
    "type": "boolean"
   }
