{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Call one endpoint. structuredContent: rows, credits (used, remaining), paging (has_more, next_cursor). Validated locally first (a bad call is free), quoted, refused above max_credits and confirmed above the threshold. A large page is cut at row boundaries with a link to the full body. Spends credits; needs SOCIALCRAWL_API_KEY.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "additionalProperties": {},
    "description": "JSON body for POST batch endpoints, e.g. { ids: [...] }.",
    "type": "object"
   },
   "confirm": {
    "description": "true only after the user approved a spend above the confirmation threshold (default 100 credits).",
    "type": "boolean"
   },
   "fields": {
    "description": "Row paths exactly as socialcrawl_endpoint lists them, e.g. 'post.id,post.content.text,post.engagement.*'. Cuts tokens.",
    "type": "string"
   },
   "format": {
    "description": "json (default), csv (canonical columns) or summary.",
    "enum": [
     "json",
     "csv",
     "summary"
    ],
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Makes a retry safe: a replay returns the original response for 0 credits (24h).",
    "minLength": 16,
    "type": "string"
   },
   "max_credits": {
    "description": "Spend cap. Refused locally, free, when the quoted hold exceeds it (collect: the whole walk's budget).",
    "minimum": 1,
    "type": "integer"
   },
   "max_items": {
    "description": "Show at most this many rows; the full page stays behind the result link.",
    "minimum": 1,
    "type": "integer"
   },
   "method": {
    "description": "Only for a resource served by several methods (prism/jobs). Inferred: a body selects POST.",
    "enum": [
     "GET",
     "POST",
     "PATCH",
     "DELETE"
    ],
    "type": "string"
   },
   "params": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": [
        "string",
        "number",
        "boolean"
       ]
      },
      {
       "items": {
        "$ref": "#/properties/params/additionalProperties/anyOf/0"
       },
       "type": "array"
      }
     ]
    },
    "description": "Query params, e.g. { handle: 'x', limit: 10 }. Arrays join with commas (label). Sent as strings.",
    "type": "object"
   },
   "platform": {
    "description": "Platform slug, e.g. 'tiktok'. An unknown slug gets a did-you-mean.",
    "minLength": 1,
    "type": "string"
   },
   "resource": {
    "description": "Resource path, e.g. 'post/comments'; path params as 'jobs/{job_id}' + params.job_id, or the concrete path.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "platform",
   "resource"
  ],
  "type": "object"
 },
 "name": "socialcrawl_request",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "credits": {
    "additionalProperties": false,
    "properties": {
     "cached": {
      "description": "Served from cache: 0 credits.",
      "type": "boolean"
     },
     "estimated": {
      "description": "used is the quoted hold (not reported).",
      "type": "boolean"
     },
     "quoted_max": {
      "description": "Hold taken up front.",
      "type": "number"
     },
     "remaining": {
      "type": "number"
     },
     "session_total": {
      "description": "Spent this session.",
      "type": "number"
     },
     "used": {
      "description": "Settled charge, after refunds.",
      "type": "number"
     }
    },
    "type": "object"
   },
   "csv_rows": {
    "description": "format=csv: rows in the text CSV.",
    "type": "number"
   },
   "data": {
    "description": "Single-object result."
   },
   "did_you_mean": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "endpoint": {
    "type": "string"
   },
   "fix": {
    "type": "string"
   },
   "hint": {},
   "job": {
    "additionalProperties": false,
    "description": "A submitted background job and how to poll it.",
    "properties": {
     "id": {
      "type": "string"
     },
     "poll": {
      "additionalProperties": false,
      "description": "Repeat until the status is terminal.",
      "properties": {
       "after_s": {
        "description": "Wait before the first poll.",
        "type": "number"
       },
       "arguments": {
        "additionalProperties": {},
        "type": "object"
       },
       "tool": {
        "type": "string"
       }
      },
      "required": [
       "tool",
       "arguments",
       "after_s"
      ],
      "type": "object"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "poll"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "page": {
    "additionalProperties": {},
    "description": "Page-level blocks beside the rows.",
    "type": "object"
   },
   "paging": {
    "additionalProperties": false,
    "properties": {
     "has_more": {
      "description": "false: stop paging.",
      "type": "boolean"
     },
     "next_cursor": {
      "description": "Send as cursor.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "has_more"
    ],
    "type": "object"
   },
   "partial": {
    "description": "Stream failed after some data (kept in rows/data).",
    "type": "boolean"
   },
   "reason": {
    "type": "string"
   },
   "request_id": {
    "type": "string"
   },
   "retry_after_s": {
    "type": "number"
   },
   "retryable": {
    "description": "Never retry a 402.",
    "type": "boolean"
   },
   "rows": {
    "description": "Untrusted text.",
    "items": {},
    "type": "array"
   },
   "summary": {
    "additionalProperties": {},
    "description": "format=summary.",
    "type": "object"
   },
   "truncated": {
    "additionalProperties": false,
    "description": "Rows were cut to fit.",
    "properties": {
     "omitted_keys": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "resource": {
      "description": "Read it for the full body.",
      "type": "string"
     },
     "shown": {
      "type": "number"
     },
     "total": {
      "type": "number"
     }
    },
    "required": [
     "resource"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Call an Endpoint"
}
