{
 "description": "Why did my transaction fail? Plain-English diagnosis from ON-CHAIN facts: engine result decoded to cause + concrete fix (catalog of ~30 common Xahau failure codes), hook rollback return-strings decoded and interpreted (e.g. the genesis reward hook's 'You must wait N seconds' becomes a claimable-at date), the partial-payment trap on 'successful' Payments (delivered_amount vs Amount), and not-found triage (expired LastLedgerSequence / wrong network). 1 RPC read; authoritative \u2014 decodes what the chain recorded, re-executes nothing (use hook_execution_postmortem to replay hooks).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   },
   "txHash": {
    "description": "transaction hash",
    "maxLength": 64,
    "minLength": 64,
    "type": "string"
   }
  },
  "required": [
   "txHash"
  ],
  "type": "object"
 },
 "name": "diagnose_failed_tx",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "causes": {
    "items": {},
    "type": "array"
   },
   "engineResult": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "engineResultCode": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "error": {
    "type": "string"
   },
   "failed": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ]
   },
   "fixes": {
    "items": {},
    "type": "array"
   },
   "found": {
    "type": "boolean"
   },
   "hookRejections": {
    "items": {},
    "type": "array"
   },
   "network": {
    "type": "string"
   },
   "notes": {
    "items": {},
    "type": "array"
   },
   "partialDelivery": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "resultClass": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "summary": {
    "type": "string"
   },
   "txHash": {
    "type": "string"
   },
   "validated": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ]
   },
   "whatItTried": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 }
}
