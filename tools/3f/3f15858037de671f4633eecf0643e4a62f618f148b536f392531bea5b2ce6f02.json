{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Reads title, description and share tags of a page. Use it when the user asks about the meta tags, canonical tag or Open Graph social preview of a web page, for example \"what will the preview look like when I share this page?\", \"does my homepage have a meta description and canonical tag?\" or \"which Open Graph tags is my page missing?\". Pass the page address. Returns the title, meta description, canonical link, language, viewport, icons, Open Graph and Twitter tags, and a list of the common tags that are missing. Tags added by JavaScript are not seen. Do not use it to read a page's text or contact details, for private or local addresses, or for rankings and traffic.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "Address of a public web page, for example https://example.com/pricing. A bare domain such as example.com means https. Only public http and https sites on the standard ports are checked.",
    "maxLength": 2048,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "check_page_tags",
 "outputSchema": {
  "properties": {
   "contentType": {
    "type": "string"
   },
   "failure": {
    "type": "string"
   },
   "finalUrl": {
    "type": "string"
   },
   "missing": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "openGraph": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "page": {
    "properties": {
     "alternates": {
      "items": {
       "properties": {
        "href": {
         "type": "string"
        },
        "hreflang": {
         "type": "string"
        }
       },
       "required": [
        "hreflang",
        "href"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "canonical": {
      "type": "string"
     },
     "charset": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "descriptionLength": {
      "type": "integer"
     },
     "icons": {
      "items": {
       "properties": {
        "href": {
         "type": "string"
        },
        "rel": {
         "type": "string"
        }
       },
       "required": [
        "rel",
        "href"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "language": {
      "type": "string"
     },
     "robots": {
      "type": "string"
     },
     "themeColor": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "titleLength": {
      "type": "integer"
     },
     "viewport": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "reachable": {
    "type": "boolean"
   },
   "redirectCount": {
    "type": "integer"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "type": "integer"
   },
   "twitter": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "reachable",
   "notice",
   "source"
  ],
  "type": "object"
 },
 "title": "Check Open Graph and share tags"
}
