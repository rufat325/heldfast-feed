{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get or update visualization settings for a question (chart type, colors, labels, etc.)",
 "inputSchema": {
  "properties": {
   "display": {
    "description": "Chart display type",
    "enum": [
     "table",
     "bar",
     "line",
     "area",
     "pie",
     "scalar",
     "row",
     "funnel",
     "scatter",
     "map",
     "gauge",
     "progress",
     "waterfall",
     "combo"
    ],
    "type": "string"
   },
   "question_id": {
    "description": "Question ID to get/update visualization for",
    "type": "number"
   },
   "settings": {
    "description": "Visualization settings object",
    "properties": {
     "graph.colors": {
      "description": "Custom colors",
      "type": "array"
     },
     "graph.dimensions": {
      "description": "Dimension fields",
      "type": "array"
     },
     "graph.label_value_frequency": {
      "type": "string"
     },
     "graph.metrics": {
      "description": "Metric fields",
      "type": "array"
     },
     "graph.show_values": {
      "type": "boolean"
     },
     "graph.x_axis.title_text": {
      "type": "string"
     },
     "graph.y_axis.title_text": {
      "type": "string"
     },
     "pie.show_legend": {
      "type": "boolean"
     },
     "pie.show_total": {
      "type": "boolean"
     },
     "table.cell_column": {
      "type": "string"
     },
     "table.pivot": {
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "question_id"
  ],
  "type": "object"
 },
 "name": "mb_visualization_settings",
 "title": "Get Visualization Settings"
}
