{
 "_meta": {
  "openai/outputTemplate": "ui://widget/products.html@v9",
  "openai/widgetAccessible": true
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List brand products"
 },
 "description": "List a brand's live products/denominations with prices in the chosen coin \u2014 including the exact denomination labels the pricing and order tools expect (eSIM destinations are covered by list_esim_plans). Creates no order.",
 "inputSchema": {
  "properties": {
   "brand_slug": {
    "description": "brandSlug from list_brands/search_products",
    "type": "string"
   },
   "coin": {
    "description": "Coin for live pricing (default USDC)",
    "type": "string"
   },
   "country_code": {
    "type": "string"
   }
  },
  "required": [
   "brand_slug",
   "country_code"
  ],
  "type": "object"
 },
 "name": "list_products",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "brand": {
    "type": "string"
   },
   "brand_slug": {
    "type": "string"
   },
   "coin": {
    "type": "string"
   },
   "country": {
    "type": "string"
   },
   "country_name": {
    "type": "string"
   },
   "destination_name": {
    "type": "string"
   },
   "error": {
    "description": "product_not_found",
    "type": "string"
   },
   "flag": {
    "type": "string"
   },
   "is_esim": {
    "type": "boolean"
   },
   "kind": {
    "description": "giftcard | esim | topup",
    "type": "string"
   },
   "logoUrl": {
    "type": "string"
   },
   "products": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "coin_amount": {
       "description": "Live price in the requested coin",
       "type": "number"
      },
      "data_gb": {
       "description": "eSIM plans only",
       "type": "number"
      },
      "denomination_label": {
       "description": "Exact label for get_price/validate_order",
       "type": "string"
      },
      "dynamic": {
       "type": "boolean"
      },
      "range": {
       "additionalProperties": true,
       "properties": {
        "max": {
         "type": "number"
        },
        "min": {
         "type": "number"
        },
        "step": {
         "type": "number"
        }
       },
       "required": [],
       "type": "object"
      },
      "usd": {
       "type": "number"
      },
      "validity_days": {
       "description": "eSIM plans only",
       "type": "number"
      }
     },
     "required": [],
     "type": "object"
    },
    "type": "array"
   },
   "url": {
    "description": "Product page on the AgentRoam site",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "title": "List brand products"
}
