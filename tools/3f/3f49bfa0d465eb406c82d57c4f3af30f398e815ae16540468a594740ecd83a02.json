{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Settlement Status"
 },
 "description": "Look up a previous DPX settlement by settlement ID. Returns the full audit record: status, tx hash, amounts, fees, oracle conditions at time of settlement, ESG score, Claude AI reasoning, and timestamp.",
 "inputSchema": {
  "properties": {
   "settlementId": {
    "description": "Settlement ID from the settlement.execute tool (format: dpx_...)",
    "type": "string"
   }
  },
  "required": [
   "settlementId"
  ],
  "type": "object"
 },
 "name": "settlement.status",
 "outputSchema": {
  "properties": {
   "httpStatus": {
    "description": "HTTP status from Settlement Agent",
    "type": "number"
   },
   "settlement": {
    "properties": {
     "amount": {
      "type": "number"
     },
     "destinationCurrency": {
      "type": "string"
     },
     "esgScore": {
      "type": "number"
     },
     "feesTotal": {
      "type": "number"
     },
     "netAmount": {
      "type": "number"
     },
     "oracleStatus": {
      "type": "string"
     },
     "reasoning": {
      "type": "string"
     },
     "settlementId": {
      "type": "string"
     },
     "sourceCurrency": {
      "type": "string"
     },
     "status": {
      "enum": [
       "executed",
       "sandbox",
       "held",
       "failed",
       "pending"
      ],
      "type": "string"
     },
     "timestamp": {
      "type": "string"
     },
     "txHash": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 }
}
