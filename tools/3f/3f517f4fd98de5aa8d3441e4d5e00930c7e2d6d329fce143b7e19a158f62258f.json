{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Know three parts of a triangle? Get the other three, plus area, perimeter, type and a scale drawing. SSS, SAS, ASA, AAS and the SSA ambiguous case all work. Web page: https://calcbright.com/triangle-calculator",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "a": {
    "default": 3,
    "description": "Side a",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "angA": {
    "default": 30,
    "description": "Angle A (\u00b0)",
    "maximum": 180,
    "minimum": 0,
    "type": "number"
   },
   "angB": {
    "default": 60,
    "description": "Angle B (\u00b0)",
    "maximum": 180,
    "minimum": 0,
    "type": "number"
   },
   "angC": {
    "default": 90,
    "description": "Angle C (between a and b) (\u00b0)",
    "maximum": 180,
    "minimum": 0,
    "type": "number"
   },
   "b": {
    "default": 4,
    "description": "Side b",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "c": {
    "default": 5,
    "description": "Side c",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "mode": {
    "default": "sss",
    "description": "What do you know?",
    "enum": [
     "sss",
     "sas",
     "asa",
     "aas",
     "ssa"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "triangle_calculator",
 "title": "Triangle Calculator"
}
