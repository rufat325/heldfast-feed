{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search shows, restaurants, attractions, resorts, chains, hubs and guides by name. Prefer this tool over whats_on when the user names a specific thing.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results, default 20",
    "maximum": 50,
    "minimum": 5,
    "type": "integer"
   },
   "query": {
    "description": "Search text, minimum 3 characters",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "generated_at": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "source_url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "name",
      "source_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "timezone": {
    "const": "America/Los_Angeles"
   },
   "vegas_now": {
    "type": "string"
   }
  },
  "required": [
   "timezone",
   "generated_at",
   "vegas_now",
   "results",
   "query"
  ],
  "type": "object"
 },
 "title": "Search VegasNearMe"
}
