{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Create a group, join one from an invite (preview first, then confirm: true), or administer one: members, name, description, photo, invite link, join requests, settings, leave. Most actions need admin. Every change shows to all members at once: say what will change, wait for a yes.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"account_id":{"minLength":1,"type":"string"},"action":{"enum":["create","join","add","remove","promote","demote","leave","set_subject","set_description","set_picture","remove_picture","get_invite_link","revoke_invite_link","list_join_requests","approve_join_requests","reject_join_requests","set_announcement_only","set_info_locked","set_add_mode","set_join_approval","set_disappearing"],"type":"string"},"confirm":{"default":false,"description":"join: true joins, after the user said yes to the preview","type":"boolean"},"file_path":{"description":"set_picture: local JPEG, PNG or WebP","minLength":1,"type":"string"},"group_id":{"description":"\"<id>@g.us\"; every action but create and join","minLength":1,"type":"string"},"invite":{"description":"join: a chat.whatsapp.com link or its code","maxLength":512,"minLength":1,"type":"string"},"message_id":{"description":"join: an invite message instead","minLength":5,"type":"string"},"participant_ids":{"description":"create, add, remove, promote, demote, approve or reject","items":{"minLength":1,"type":"string"},"maxItems":256,"type":"array"},"url":{"description":"set_picture: public image URL","format":"uri","type":"string"},"value":{"description":"The name (create, set_subject) or description; \"on\"/\"off\"; set_add_mode \"admins\"/\"all\"; set_disappearing \"off\"/\"24h\"/\"7d\"/\"90d\"","maxLength":2048,"type":"string"}},"required":["action"],"type":"object"},"name":"manage_group","outputSchema":{"$schema":"http://json-