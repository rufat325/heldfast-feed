{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List my missions"
 },
 "description": "List user missions with various filtering options Docs: https://1lev1.com/mcp#listUserMissionsTool",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filter": {
    "default": "all",
    "description": "Filter missions by status",
    "enum": [
     "all",
     "active",
     "completed",
     "startable",
     "stoppable",
     "overdue"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of missions to return",
    "type": "number"
   },
   "missionName": {
    "description": "Search for missions by name (partial match)",
    "type": "string"
   },
   "projectId": {
    "description": "Filter by specific project ID (numeric)",
    "type": "string"
   },
   "projectName": {
    "description": "Filter by project name",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "listUserMissionsTool"
}
