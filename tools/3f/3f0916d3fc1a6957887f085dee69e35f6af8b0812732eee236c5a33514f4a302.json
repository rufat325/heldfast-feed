{
 "description": "Create a new Longhorn recurring job. Longhorn docs: https://longhorn.io/docs/1.13.0/snapshots-and-backups/scheduling-backups-and-snapshots/",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "concurrency": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "cron": {
    "description": "Cron schedule expression.",
    "type": "string"
   },
   "groups": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "labels": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "type": "string"
   },
   "parameters": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "retain": {
    "description": "Retention count when retentionPolicy is count-based (the default).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "retainAge": {
    "description": "Go duration such as \"720h\" \u2014 required when retentionPolicy is age-based (Longhorn 1.13.0+).",
    "type": "string"
   },
   "retentionPolicy": {
    "description": "count-based (default) retains the newest N items; age-based uses retainAge instead.",
    "enum": [
     "count-based",
     "age-based"
    ],
    "type": "string"
   },
   "task": {
    "description": "e.g. \"snapshot\", \"backup\", \"snapshot-cleanup\", \"snapshot-delete\", \"filesystem-trim\", \"system-backup\".",
    "type": "string"
   }
  },
  "required": [
   "name",
   "task",
   "cron",
   "retain",
   "concurrency"
  ],
  "type": "object"
 },
 "name": "recurringjob_create",
 "title": "Create recurring job"
}
