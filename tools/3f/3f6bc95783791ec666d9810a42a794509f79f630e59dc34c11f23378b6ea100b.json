{
 "description": "Store an encrypted secret with optional rotation policy. Value is encrypted at rest with AES-256-GCM.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Secret name (e.g. \"openai_api_key\", \"stripe_live\")",
    "minLength": 1,
    "type": "string"
   },
   "rotation_policy": {
    "default": "none",
    "description": "Automatic rotation reminder policy",
    "enum": [
     "none",
     "daily",
     "weekly",
     "monthly"
    ],
    "type": "string"
   },
   "service": {
    "default": "default",
    "description": "Service this secret belongs to (e.g. \"openai\", \"stripe\")",
    "type": "string"
   },
   "value": {
    "description": "The secret value to store \u2014 encrypted immediately, never stored in plaintext",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "value"
  ],
  "type": "object"
 },
 "name": "store_secret"
}
