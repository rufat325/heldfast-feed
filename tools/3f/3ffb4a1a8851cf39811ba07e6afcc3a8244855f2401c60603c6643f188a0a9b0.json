{
 "description": "Update WordPress site settings (only the given fields change); returns all settings afterwards",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date_format": {
    "description": "PHP date format, e.g. d.m.Y",
    "type": "string"
   },
   "default_category": {
    "description": "Default post category ID",
    "type": "integer"
   },
   "default_comment_status": {
    "description": "Allow comments on new posts",
    "enum": [
     "open",
     "closed"
    ],
    "type": "string"
   },
   "default_ping_status": {
    "description": "Allow pingbacks/trackbacks on new posts",
    "enum": [
     "open",
     "closed"
    ],
    "type": "string"
   },
   "default_post_format": {
    "description": "Default post format slug ('0' = standard)",
    "type": "string"
   },
   "description": {
    "description": "Site tagline",
    "type": "string"
   },
   "email": {
    "description": "Admin email (single site only)",
    "format": "email",
    "type": "string"
   },
   "language": {
    "description": "Locale, e.g. de_DE (must be installed; '' = en_US)",
    "type": "string"
   },
   "page_for_posts": {
    "description": "Page ID that lists the latest posts (show_on_front=page)",
    "type": "integer"
   },
   "page_on_front": {
    "description": "Page ID shown on the front page (show_on_front=page)",
    "type": "integer"
   },
   "posts_per_page": {
    "description": "Blog pages show at most this many posts",
    "type": "integer"
   },
   "show_on_front": {
    "description": "Front page shows the latest posts or a static page",
    "enum": [
     "posts",
     "page"
    ],
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "site_icon": {
    "description": "Site icon (favicon) media ID",
    "type": "integer"
   },
   "site_logo": {
    "description": "Site logo media ID",
    "type": "integer"
   },
   "start_of_week": {
    "description": "First day of the week (0 = Sunday, 1 = Monday)",
    "maximum": 6,
    "minimum": 0,
    "type": "integer"
   },
   "time_format": {
    "description": "PHP time format, e.g. H:i",
    "type": "string"
   },
   "timezone": {
    "description": "Timezone city, e.g. Europe/Berlin (option timezone_string)",
    "type": "string"
   },
   "title": {
    "description": "Site title",
    "type": "string"
   },
   "url": {
    "description": "Site URL (siteurl; single site only - changing it can lock you out)",
    "type": "string"
   },
   "use_smilies": {
    "description": "Convert emoticons like :-) to graphics",
    "type": "boolean"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "wp_update_settings"
}
