   "email": {
    "description": "The user's email address: the guide goes to this D\u00e9staire account.",
    "format": "email",
    "maxLength": 254,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "slug": {
    "description": "The guide's slug, the last part of its URL.",
    "maxLength": 120,
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "email"
  ],
  "type": "object"
 },
 "name": "buy_guide",
 "outputSchema": {
