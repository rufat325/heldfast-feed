{"annotations":{"openWorldHint":true,"readOnlyHint":true,"title":"List jobs"},"description":"Live crypto jobs (1,300+ open roles at 50+ crypto companies: Coinbase, Binance, OKX, Ripple, Circle, Phantom, Uniswap...) collected every 6h from the companies' own job boards. Filter by role, remote, location, company, keyword. Apply links go to the company's own application page. Works without an API key.","inputSchema":{"additionalProperties":false,"properties":{"company_slug":{"description":"e.g. coinbase, binance, phantom","maxLength":160,"minLength":1,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","type":"string"},"employment_type":{"enum":["full_time","part_time","contract","internship"],"type":"string"},"include_description":{"default":false,"description":"Full job descriptions (large); use get_job for one role","type":"boolean"},"limit":{"default":25,"maximum":100,"minimum":1,"type":"integer"},"location":{"description":"Location substring, e.g. 'London', 'Singapore'","maxLength":100,"minLength":2,"type":"string"},"offset":{"default":0,"minimum":0,"type":"integer"},"q":{"description":"Search title or company, e.g. 'solidity', 'Coinbase'","maxLength":100,"minLength":2,"type":"string"},"remote":{"description":"true = remote roles only","type":"boolean"},"tag":{"description":"Role category","enum":["engineering","security","data","research","product","design","marketing","sales-bd","legal-compliance","finance","trading","support","operations","other"],"type":"string"}},"type":"object"},"name":"list_jobs"}
