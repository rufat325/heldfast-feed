{
 "_meta": {
  "openai/widgetAccessible": true,
  "ui": {
   "visibility": [
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Internal: returns raw app HTML plus its trust tier and capability grants for the universal loader widget. Not useful to call directly \u2014 use get_app to read source.",
 "inputSchema": {
  "properties": {
   "mount": {
    "description": "the caller is mounting this app on screen now (records the live pointer); refetches and framing bricks leave it unset",
    "type": "boolean"
   },
   "name": {
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_app_html",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "author": {
    "type": "string"
   },
   "caps": {
    "additionalProperties": false,
    "properties": {
     "call_tools": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "cross_collection_read": {
      "type": "boolean"
     },
     "cross_collection_write": {
      "type": "boolean"
     },
     "delete_items": {
      "enum": [
       "allow",
       "confirm",
       "deny"
      ],
      "type": "string"
     },
     "file_read": {
      "type": "boolean"
     },
     "file_write": {
      "type": "boolean"
     },
     "read_source": {
      "type": "boolean"
     },
     "send_message": {
      "type": "boolean"
     },
     "settings_write": {
      "type": "boolean"
     }
    },
    "required": [
     "call_tools",
     "send_message",
     "delete_items",
     "cross_collection_read",
     "cross_collection_write",
     "settings_write",
     "read_source",
     "file_read",
     "file_write"
    ],
    "type": "object"
   },
   "collection": {
    "description": "the collection this app opens on",
    "type": "string"
   },
   "csp": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "declaration": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "host": {
    "description": "label for the client this widget is running under; usually empty",
    "type": "string"
   },
   "html": {
    "type": "string"
   },
   "locked": {
    "description": "a fixed system app (settings renders these read-only)",
    "type": "boolean"
   },
   "name": {
    "type": "string"
   },
   "tier": {
    "enum": [
     "local",
     "unreviewed"
    ],
    "type": "string"
   },
   "version": {
    "type": "number"
   }
  },
  "required": [
   "name",
   "version",
   "html",
   "author",
   "tier",
   "locked",
   "collection",
   "caps"
  ],
  "type": "object"
 },
 "title": "App HTML (internal)"
}
