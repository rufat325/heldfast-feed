{
 "description": "Get real-time token prices and 24h change for STX, CELO, ETH, and more",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currency": {
    "default": "usd",
    "description": "Quote currency (default: usd)",
    "pattern": "^[a-zA-Z]{2,10}$",
    "type": "string"
   },
   "symbols": {
    "description": "Token symbols to fetch (e.g. ['STX', 'CELO', 'ETH'])",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "symbols"
  ],
  "type": "object"
 },
 "name": "get_prices"
}
