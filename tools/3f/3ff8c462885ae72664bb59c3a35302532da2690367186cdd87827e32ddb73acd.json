{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run a small bounded synchronous TAP ADQL query after inspecting the exact table and columns. Use TOP in ADQL and/or maxrec, and treat tool errors as failures rather than empty scientific results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "format": {
    "description": "MCP result output format.",
    "enum": [
     "votable",
     "csv",
     "tsv",
     "json",
     "jsonl"
    ],
    "type": "string"
   },
   "maxrec": {
    "description": "TAP MAXREC row limit. Defaults to 100 when omitted.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Exact metadata-backed ADQL query text. Use TOP for a query-level bound; do not use LIMIT.",
    "minLength": 1,
    "type": "string"
   },
   "runId": {
    "description": "Optional TAP RUNID request value.",
    "minLength": 1,
    "type": "string"
   },
   "service": {
    "description": "Known Starfetch TAP service preset selected for this workflow; use this or url.",
    "minLength": 1,
    "type": "string"
   },
   "uploads": {
    "description": "TAP uploads forwarded to the service; local file paths are not supported.",
    "items": {
     "anyOf": [
      {
       "properties": {
        "tableName": {
         "description": "Temporary TAP_UPLOAD table name.",
         "minLength": 1,
         "type": "string"
        },
        "uri": {
         "description": "Remote VOTable URI for TAP upload.",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "tableName",
        "uri"
       ],
       "type": "object"
      },
      {
       "properties": {
        "filename": {
         "description": "Optional inline VOTable filename.",
         "minLength": 1,
         "type": "string"
        },
        "tableName": {
         "description": "Temporary TAP_UPLOAD table name.",
         "minLength": 1,
         "type": "string"
        },
        "votable": {
         "description": "Inline VOTable XML content.",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "tableName",
        "votable"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "url": {
    "description": "Explicit TAP base URL selected for this workflow; use this or service.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "format",
   "query"
  ],
  "type": "object"
 },
 "name": "starfetch_tap_query",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "content": {
        "type": "string"
       },
       "fields": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "datatype": {
           "type": "string"
          },
          "description": {
           "type": "string"
          },
          "name": {
           "type": "string"
          },
          "ucd": {
           "type": "string"
          },
          "unit": {
           "type": "string"
          },
          "utype": {
           "type": "string"
          }
         },
         "required": [
          "name"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "format": {
        "enum": [
         "json",
         "jsonl"
        ],
        "type": "string"
       },
       "overflow": {
        "type": "boolean"
       }
      },
      "required": [
       "content",
       "fields",
       "format"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "content": {
        "type": "string"
       },
       "format": {
        "enum": [
         "csv",
         "tsv",
         "votable"
        ],
        "type": "string"
       }
      },
      "required": [
       "content",
       "format"
      ],
      "type": "object"
     }
    ]
   },
   "diagnostics": {
    "additionalProperties": false,
    "properties": {
     "durationMs": {
      "minimum": 0,
      "type": "number"
     },
     "effectiveMaxrec": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "format": {
      "enum": [
       "votable",
       "csv",
       "tsv",
       "json",
       "jsonl"
      ],
      "type": "string"
     },
     "query": {
      "type": "string"
     },
     "requestFormat": {
      "enum": [
       "votable",
       "csv",
       "tsv"
      ],
      "type": "string"
     },
     "runId": {
      "type": "string"
     },
     "target": {
      "additionalProperties": false,
      "properties": {
       "baseUrl": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "service": {
        "type": "string"
       }
      },
      "required": [
       "baseUrl"
      ],
      "type": "object"
     },
     "uploadCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "target",
     "durationMs",
     "effectiveMaxrec",
     "format",
     "requestFormat",
     "query",
     "uploadCount"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "diagnostics"
  ],
  "type": "object"
 },
 "title": "Run bounded TAP query"
}
