{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Return the chosen candidate's exact request-time quote without another provider call while it remains valid. If it expired, refresh only that candidate at the same amount and never silently reselect. Example: pass the chosen candidate_id and exact selection receipt hash. AssetFare quotes retain continuation_v3; external quotes contain normalized facts and a provider handoff without executable payloads. This tool never prepares, signs, submits, or creates transaction authority.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount_usd": {
    "description": "Requested input value in USD, minimum 1. USD 1 is reachability/schema smoke only. A USD 50 competitive bucket was observed only for dated 2026-09-23 Solana USDC to Base USDC evidence and must not be generalized to another corridor. USD 1,000 is the primary representative amount. SOL input includes a swap. Always quote the actual intended amount.",
    "minimum": 1,
    "type": "number"
   },
   "candidate_id": {
    "description": "Exact candidate_id returned by assetfare_v2_route_selection; it is never chosen automatically.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "from_chain": {
    "description": "Source chain for the v2 route. Polygon, Optimism, Ethereum, HyperEVM, X Layer, Sei, Sonic, Monad, Avalanche, Cronos, Injective, Linea, Aptos, Unichain, and Ink are source-only and cannot be used as to_chain.",
    "enum": [
     "solana",
     "base",
     "arbitrum",
     "robinhood",
     "polygon",
     "optimism",
     "ethereum",
     "hyperevm",
     "xlayer",
     "sei",
     "sonic",
     "monad",
     "avalanche",
     "cronos",
     "injective",
     "linea",
     "aptos",
     "unichain",
     "ink"
    ],
    "type": "string"
   },
   "from_token": {
    "description": "Input token symbol on from_chain. The chain-token pair must appear in current v2 capabilities.",
    "enum": [
     "SOL",
     "ETH",
     "USDC",
     "USDG"
    ],
    "type": "string"
   },
   "max_eta_seconds": {
    "description": "Optional stricter maximum ETA in seconds; it cannot exceed the selected profile limit.",
    "maximum": 1800,
    "minimum": 1,
    "type": "integer"
   },
   "profile": {
    "description": "Time policy: fast (30s), balanced (60s default), or explicit economy (up to 1,800s).",
    "enum": [
     "fast",
     "balanced",
     "economy"
    ],
    "type": "string"
   },
   "selection_receipt_sha256": {
    "description": "Exact selection_receipt.sha256 returned with the fresh shortlist.",
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "to_chain": {
    "description": "Destination chain for the v2 route: Solana, Base, Arbitrum, or Robinhood Chain. Source-only chains are not destinations.",
    "enum": [
     "solana",
     "base",
     "arbitrum",
     "robinhood"
    ],
    "type": "string"
   },
   "to_token": {
    "description": "Output token symbol on to_chain. The chain-token pair must appear in current v2 capabilities.",
    "enum": [
     "SOL",
     "ETH",
     "USDC",
     "USDG"
    ],
    "type": "string"
   }
  },
  "required": [
   "from_chain",
   "from_token",
   "to_chain",
   "to_token",
   "amount_usd",
   "candidate_id",
   "selection_receipt_sha256"
  ],
  "type": "object"
 },
 "name": "assetfare_v2_quote_selected_candidate",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "choice_binding": {
    "additionalProperties": false,
    "properties": {
     "automatic_reselection_forbidden": {
      "const": true,
      "type": "boolean"
     },
     "candidate_id": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     "refresh_reason": {
      "anyOf": [
       {
        "const": "request_time_quote_expired",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "refresh_scope": {
      "enum": [
       "none",
       "selected_candidate_only_same_exact_amount"
      ],
      "type": "string"
     },
     "request_time_quote_reused": {
      "type": "boolean"
     },
     "selection_grants_execution_authority": {
      "const": false,
      "type": "boolean"
     },
     "selection_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "selection_status": {
      "const": "explicitly_selected",
      "type": "string"
     },
     "server_signing": {
      "const": false,
      "type": "boolean"
     },
     "server_submission": {
      "const": false,
      "type": "boolean"
     },
     "version": {
      "const": "assetfare-agent-route-choice-2.0.0",
      "type": "string"
     }
    },
    "required": [
     "version",
     "candidate_id",
     "selection_receipt_sha256",
     "selection_status",
     "selection_grants_execution_authority",
     "request_time_quote_reused",
     "refresh_reason",
     "refresh_scope",
     "automatic_reselection_forbidden",
     "server_signing",
     "server_submission"
    ],
    "type": "object"
   },
   "selected_candidate": {
    "additionalProperties": true,
    "properties": {
     "all_in_cost_usd": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "type": "string"
     },
     "assetfare_direct": {
      "type": "boolean"
     },
     "candidate_id": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     "eta_basis": {
      "enum": [
       "provider_reported",
       "policy_conservative_bound",
       "observed_p95"
      ],
      "type": "string"
     },
     "eta_seconds": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "eta_upper_bound_seconds": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "excluded_reason": {
      "minLength": 1,
      "type": "string"
     },
     "expected_receive_base": {
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
     },
     "fee_included": {
      "const": true,
      "type": "boolean"
     },
     "minimum_receive_base": {
      "pattern": "^[1-9][0-9]*$",
      "type": "string"
     },
     "prepare_available": {
      "type": "boolean"
     },
     "prepare_mode": {
      "enum": [
       "assetfare_unsigned",
       "external_handoff",
       "external_unsigned"
      ],
      "type": "string"
     },
     "provider": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     "provider_role": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     "rank": {
      "maximum": 2,
      "minimum": 1,
      "type": "integer"
     },
     "verification_tier": {
      "enum": [
       "quote_verified",
       "execution_verified"
      ],
      "type": "string"
     }
    },
    "required": [
     "candidate_id",
     "provider",
     "provider_role",
     "expected_receive_base",
     "minimum_receive_base",
     "all_in_cost_usd",
     "eta_seconds",
     "eta_upper_bound_seconds",
     "eta_basis",
     "verification_tier",
     "prepare_mode",
     "prepare_available",
     "assetfare_direct",
     "fee_included"
    ],
    "type": "object"
   },
   "selection_quote_source": {
    "enum": [
     "request_time_exact_quote",
     "selected_candidate_expiry_refresh"
    ],
    "type": "string"
   },
   "server_signing": {
    "const": false,
    "type": "boolean"
   },
   "server_submission": {
    "const": false,
    "type": "boolean"
   },
   "status": {
    "enum": [
     "fresh_assetfare_quote",
     "fresh_external_quote"
    ],
    "type": "string"
   },
   "version": {
    "const": "assetfare-agent-route-choice-2.0.0",
    "type": "string"
   }
  },
  "required": [
   "version",
   "status",
   "choice_binding",
   "selected_candidate",
   "selection_quote_source",
   "server_signing",
   "server_submission"
  ],
  "type": "object"
 }
}
