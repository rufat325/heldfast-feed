{
 "_meta": {
  "ui": {
   "resourceUri": "ui://liveauth/lightning-payment",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "description": "Confirm a LiveAuth session and receive a JWT. With only a PoW quoteId, the server reuses its existing PoW solver automatically. With Lightning, call with quoteId to poll settlement.",
 "inputSchema": {
  "properties": {
   "challengeHex": {
    "description": "Challenge hex (optional; PoW can be solved automatically)",
    "type": "string"
   },
   "difficultyBits": {
    "description": "Challenge difficulty (optional)",
    "type": "number"
   },
   "expiresAtUnix": {
    "description": "Challenge expiration (optional)",
    "type": "number"
   },
   "hashHex": {
    "description": "Solved PoW hash (optional)",
    "type": "string"
   },
   "macaroon": {
    "description": "L402 bundle macaroon (L402 only)",
    "type": "string"
   },
   "nonce": {
    "description": "Solved PoW nonce (optional)",
    "type": "number"
   },
   "quoteId": {
    "description": "The quoteId from the start response",
    "type": "string"
   },
   "signature": {
    "description": "Challenge signature (optional)",
    "type": "string"
   }
  },
  "required": [
   "quoteId"
  ],
  "type": "object"
 },
 "name": "liveauth_mcp_confirm"
}
