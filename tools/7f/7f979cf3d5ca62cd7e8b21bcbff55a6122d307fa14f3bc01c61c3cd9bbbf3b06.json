{
 "description": "Build mathematically valid tihai, tukra, or chakradhar compositions for a given taal and jati.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cycles": {
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "form": {
    "minLength": 1,
    "type": "string"
   },
   "jati": {
    "enum": [
     "tisra",
     "chatusra",
     "khanda",
     "misra"
    ],
    "type": "string"
   },
   "taal": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taal",
   "form",
   "jati"
  ],
  "type": "object"
 },
 "name": "compose_builder",
 "title": "Compose Builder"
}
