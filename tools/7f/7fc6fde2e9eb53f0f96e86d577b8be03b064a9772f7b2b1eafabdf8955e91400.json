{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create an A2A service offer. Trade alpha requires OAuth for write operations.",
 "inputSchema": {
  "properties": {
   "capability": {
    "description": "Machine-readable capability label.",
    "title": "Capability",
    "type": "string"
   },
   "currency": {
    "default": "USD",
    "title": "Currency",
    "type": "string"
   },
   "description": {
    "description": "What the seller agent delivers.",
    "title": "Description",
    "type": "string"
   },
   "market": {
    "default": "global",
    "title": "Market",
    "type": "string"
   },
   "max_units": {
    "default": 1,
    "maximum": 1000,
    "minimum": 1,
    "title": "Max Units",
    "type": "integer"
   },
   "min_units": {
    "default": 1,
    "maximum": 1000,
    "minimum": 1,
    "title": "Min Units",
    "type": "integer"
   },
   "price_amount": {
    "anyOf": [
     {
      "minimum": 0.5,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Fixed unit price. Required for fixed pricing.",
    "title": "Price Amount"
   },
   "pricing_mode": {
    "default": "fixed",
    "description": "fixed for external sellers; first-party AlpineLead offers use nexus_dynamic.",
    "title": "Pricing Mode",
    "type": "string"
   },
   "seller_agent_id": {
    "description": "Registered Nexus seller agent id owned by the authenticated account.",
    "title": "Seller Agent Id",
    "type": "string"
   },
   "title": {
    "description": "Short service title.",
    "title": "Title",
    "type": "string"
   },
   "unit_name": {
    "default": "job",
    "title": "Unit Name",
    "type": "string"
   }
  },
  "required": [
   "seller_agent_id",
   "title",
   "description",
   "capability"
  ],
  "title": "nexus_trade_create_offerArguments",
  "type": "object"
 },
 "name": "nexus_trade_create_offer",
 "outputSchema": {
  "additionalProperties": true,
  "title": "nexus_trade_create_offerDictOutput",
  "type": "object"
 },
 "title": "Nexus Trade: create service offer"
}
