{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Calculates DORA proxy metrics (deployment frequency, lead time, change failure rate, MTTR) for a GitHub repository.\n- Side effects: None. This is a strictly read-only operation.\n- Data sources: GitHub REST API (releases, actions/runs, pulls).\n- Auth requirements: No special authentication required for public repositories. Private repositories require GITHUB_TOKEN.\n- Rate limits: Subject to standard GitHub API limits. Heavy API usage due to multiple list endpoints being queried.\n- Return shape: Returns a JSON object with calculated DORA metrics over the specified period.\n- Usage guidelines: Use this tool ONLY to evaluate DORA metrics and team delivery performance. DO NOT use this tool for other checks:\n  - For raw workflow statuses, use 'check_ci_status' instead.\n  - For a computed A-F health score grading, use 'get_health_score' instead.\n  - For general repository metadata, use 'get_repo_health' instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "default": 30,
    "description": "Number of past days to analyze (default: 30)",
    "maximum": 90,
    "minimum": 7,
    "type": "number"
   },
   "owner": {
    "description": "GitHub repository owner (e.g., 'modelcontextprotocol')",
    "type": "string"
   },
   "repo": {
    "description": "GitHub repository name (e.g., 'sdk')",
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo"
  ],
  "type": "object"
 },
 "name": "get_dora_metrics",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "change_failure_rate": {
    "additionalProperties": false,
    "properties": {
     "failed_runs": {
      "type": "number"
     },
     "rate_percent": {
      "type": [
       "number",
       "null"
      ]
     },
     "total_runs": {
      "type": "number"
     }
    },
    "required": [
     "total_runs",
     "failed_runs",
     "rate_percent"
    ],
    "type": "object"
   },
   "deployment_frequency": {
    "additionalProperties": false,
    "properties": {
     "per_week": {
      "type": [
       "number",
       "null"
      ]
     },
     "releases_count": {
      "type": "number"
     }
    },
    "required": [
     "releases_count",
     "per_week"
    ],
    "type": "object"
   },
   "lead_time": {
    "additionalProperties": false,
    "properties": {
     "median_hours": {
      "type": [
       "number",
       "null"
      ]
     },
     "pr_count": {
      "type": "number"
     }
    },
    "required": [
     "median_hours",
     "pr_count"
    ],
    "type": "object"
   },
   "measured_from": {
    "type": "string"
   },
   "measured_to": {
    "type": "string"
   },
   "mttr": {
    "additionalProperties": false,
    "properties": {
     "incidents_count": {
      "type": "number"
     },
     "median_hours": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "median_hours",
     "incidents_count"
    ],
    "type": "object"
   },
   "owner": {
    "type": "string"
   },
   "period_days": {
    "type": "number"
   },
   "repo": {
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo",
   "period_days",
   "measured_from",
   "measured_to",
   "deployment_frequency",
   "lead_time",
   "change_failure_rate",
   "mttr"
  ],
  "type": "object"
 }
}
