{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run CITlab HTR recognition on a document using a specific model.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allowConcurrentExecution": {
    "description": "Allow concurrent execution (default false)",
    "type": "boolean"
   },
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "credits": {
    "description": "Credits parameter",
    "type": "string"
   },
   "dict": {
    "description": "Dictionary to use",
    "type": "string"
   },
   "doLinePolygonSimplification": {
    "description": "Simplify line polygons (default true)",
    "type": "boolean"
   },
   "doStoreConfMats": {
    "description": "Store confidence matrices (default true)",
    "type": "boolean"
   },
   "doStructures": {
    "description": "Run structure analysis",
    "type": "boolean"
   },
   "docId": {
    "description": "Document ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "keepOriginalLinePolygons": {
    "description": "Keep original line polygons (default false)",
    "type": "boolean"
   },
   "modelId": {
    "description": "Model/HTR ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "pages": {
    "description": "Page range (e.g. \"1-5\")",
    "type": "string"
   },
   "tempDict": {
    "description": "Temporary dictionary",
    "type": "string"
   }
  },
  "required": [
   "collId",
   "modelId",
   "docId"
  ],
  "type": "object"
 },
 "name": "transkribus_recog_run_htr_citlab",
 "title": "Run HTR (CITlab)"
}
