{
 "description": "Show Redis slow queries \u2014 find commands that took too long to execute",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "default": 10,
    "description": "Number of slow log entries to return",
    "type": "number"
   },
   "redis_url": {
    "default": "redis://localhost:6379",
    "description": "Redis connection URL",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "redis_slowlog"
}
