{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Restore a selected retained release of an app. Read release_history with impreza_api_call on /platform/deployments/{id}, and select a rel_ id with rollback_supported=true. Requires a compatible agent and manage scope. Can interrupt traffic; restores image/configuration, not database or mutable data. Explain the target and obtain confirmation. Reports failure if the release expired or ports/storage/routing changed. Poll deployment history for the actual result. If confirm_token is absent from this connection's input schema, use a connection that exposes it or a supported customer-portal flow. A quote or confirmation request is not completion. IRREVERSIBLE \u2014 takes two calls: the first returns a confirm_token and changes nothing, the second repeats the same arguments plus confirm_token and executes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "const": true,
    "description": "True only after customer confirmation.",
    "type": "boolean"
   },
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   },
   "target_version": {
    "description": "Exact retained rel_ id from release_history.",
    "pattern": "^rel_[A-Za-z0-9._-]{1,100}$",
    "type": "string"
   }
  },
  "required": [
   "deployment_id",
   "target_version",
   "confirm"
  ],
  "type": "object"
 },
 "name": "impreza_rollback_deployment",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "command_id": {
      "type": "string"
     },
     "deployment_id": {
      "type": "string"
     },
     "saved_configuration": {
      "type": "object"
     },
     "status": {
      "const": "updating",
      "type": "string"
     },
     "target_version": {
      "type": "string"
     }
    },
    "required": [
     "command_id",
     "deployment_id",
     "target_version",
     "status",
     "saved_configuration"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Restore app release"
}
