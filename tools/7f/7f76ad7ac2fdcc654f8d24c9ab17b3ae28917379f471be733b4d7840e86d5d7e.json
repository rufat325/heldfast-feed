{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Parsha study pack"
 },
 "description": "Everything to study the weekly Torah portion: the reading (for a date, or by parsha name), aliyot and haftarah, the text of a chosen aliyah (Hebrew + English), a commentator's notes on its opening verses, and the parsha's topic and themes. Great for preparing a dvar Torah.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aliyah": {
    "default": 1,
    "description": "Which aliyah's text to include.",
    "maximum": 7,
    "minimum": 1,
    "type": "integer"
   },
   "commentator": {
    "default": "Rashi",
    "type": "string"
   },
   "date": {
    "description": "Any date \u2014 uses that week's Shabbat reading. Default: this week.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "israel": {
    "default": false,
    "type": "boolean"
   },
   "parasha": {
    "description": "Or a parsha name, e.g. \"Vayera\".",
    "type": "string"
   },
   "verses_of_commentary": {
    "default": 3,
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "vowels": {
    "default": "full",
    "enum": [
     "full",
     "none"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "parsha_study_pack",
 "title": "Parsha study pack"
}
