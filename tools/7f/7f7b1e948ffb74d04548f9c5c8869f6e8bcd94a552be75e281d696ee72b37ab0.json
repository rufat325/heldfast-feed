{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Free. Circle attestation and mint state for a bridge, by its burn transaction hash (returned by the bridge call).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "burnTx": {
    "description": "Burn transaction hash from the bridge response.",
    "pattern": "^0x[0-9a-fA-F]{64}$",
    "type": "string"
   },
   "from": {
    "description": "Source chain, if known.",
    "enum": [
     "base",
     "arc"
    ],
    "type": "string"
   }
  },
  "required": [
   "burnTx"
  ],
  "type": "object"
 },
 "name": "bridge_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "burnTx": {
    "description": "Burn transaction hash",
    "type": "string"
   },
   "circleStatus": {
    "description": "Circle attestation status",
    "type": "string"
   },
   "delayReason": {
    "description": "Why it is delayed, if it is",
    "type": [
     "string",
     "null"
    ]
   },
   "feeExecuted": {
    "description": "Circle fee actually charged",
    "type": "string"
   },
   "forwardState": {
    "description": "Circle Forwarding state",
    "type": "string"
   },
   "from": {
    "description": "Source chain",
    "type": "string"
   },
   "mintTx": {
    "description": "Mint transaction on the destination, once minted",
    "type": "string"
   },
   "state": {
    "description": "waiting | attested | minted | delayed",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Track a bridge"
}
