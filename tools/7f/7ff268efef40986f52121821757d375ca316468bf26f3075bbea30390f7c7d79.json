  "readOnlyHint": true,
  "title": "Get Urantia Parallels for a Bible Verse"
 },
 "description": "Returns the top 10 Urantia paragraphs whose embeddings are nearest to the Bible chunk that contains this verse. Pre-computed at seed time with text-embedding-3-large (3072-d) cosine similarity. Each result carries a similarity score (0..1) and rank (1..10).\n\nThese are semantic neighbors, not a curated list of parallels.",
 "execution": {
  "taskSupport": "forbidden"
 },
