    "description": "Book identifier. Example: \"Matt\"",
    "type": "string"
   },
   "chapter": {
    "description": "Chapter number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "verse": {
    "description": "Verse number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "book_code",
   "chapter",
   "verse"
  ],
  "type": "object"
 },
 "name": "bible.verse.urantia_parallels",
