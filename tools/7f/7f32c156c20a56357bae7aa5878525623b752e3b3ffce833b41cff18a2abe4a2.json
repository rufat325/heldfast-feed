{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only: report each node's operator flags (bypass / render / display / lock / allowCooking / clone) plus index-aware input wiring, network position, color and comment \u2014 the signals that explain a black/blank output that a parameter dump hides. Scan one node or a subtree (recursive); set only_problems to surface just the ops whose flags or cook errors would suppress output. Returns structuredContent for code to process.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "max_nodes": {
    "default": 200,
    "description": "Cap the number of nodes scanned during a recursive subtree walk.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "only_problems": {
    "default": false,
    "description": "Return only nodes whose flags or cook errors would suppress output: bypass on, allowCooking off, or a cook error present. Conservative \u2014 display/render are reported but never used to filter (they default off on many visible ops).",
    "type": "boolean"
   },
   "path": {
    "description": "Full path of the node to inspect, or the COMP whose children to scan when recursive is set.",
    "type": "string"
   },
   "recursive": {
    "default": false,
    "description": "Also scan the immediate children (depth 1) of path. Use this on a container to diagnose its whole network in one round-trip.",
    "type": "boolean"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "get_td_node_flags",
