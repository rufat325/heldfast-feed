{
 "description": "Add a product to the Target cart for pickup or delivery",
 "inputSchema": {
  "properties": {
   "fulfillment": {
    "description": "Fulfillment method (default: shipping)",
    "enum": [
     "pickup",
     "shipping",
     "delivery"
    ],
    "type": "string"
   },
   "quantity": {
    "description": "Quantity to add (default: 1)",
    "type": "number"
   },
   "tcin": {
    "description": "Target product TCIN",
    "type": "string"
   },
   "url": {
    "description": "Target product URL",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "add_to_cart"
}
