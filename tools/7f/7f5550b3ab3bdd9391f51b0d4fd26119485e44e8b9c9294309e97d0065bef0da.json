{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "POST /v1/paymaster/allowlist - upserts the (chainId, contractAddress) pair as a sponsorable target. Re-posting the same pair updates the label.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chainId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "contractAddress": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "label": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "chainId",
   "contractAddress"
  ],
  "type": "object"
 },
 "name": "paymaster_allowlist_add",
 "title": "Add contract to allowlist"
}
