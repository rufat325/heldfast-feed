{
 "description": "Live LTL freight rates to a US ZIP code for one or more products \u2014 real carrier pricing (the same engine the website checkout uses). Returns carrier, service, transit days and price. Rate-limited to 10 calls/hour. Items that qualify for parcel (UPS) shipping or that need a custom quote are flagged.",
 "inputSchema": {
  "properties": {
   "items": {
    "description": "Products to ship",
    "items": {
     "properties": {
      "qty": {
       "description": "Quantity (default 1)",
       "type": "number"
      },
      "sku": {
       "description": "Product SKU or MPN",
       "type": "string"
      }
     },
     "required": [
      "sku"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "liftgate": {
    "description": "Liftgate at delivery (no dock)",
    "type": "boolean"
   },
   "residential": {
    "description": "Residential delivery address",
    "type": "boolean"
   },
   "zip": {
    "description": "Destination US ZIP code (5 digits)",
    "type": "string"
   }
  },
  "required": [
   "zip",
   "items"
  ],
  "type": "object"
 },
 "name": "get_freight_estimate"
}
