{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a server-side mail redirection. Two-phase commit. Emails received at name@<domain> will be forwarded to every address in targets.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "description": "Token from the prior plan response. Required on the apply phase only.",
    "format": "uuid",
    "type": "string"
   },
   "mail_hosting_id": {
    "description": "Mail hosting ID. Discover via infomaniak_list_mail_hostings.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "name": {
    "description": "Local part of the source address (e.g. 'support' to forward 'support@coden.lu'). Lowercase alphanumeric with dots, underscores or dashes; 1-64 chars. NOT the full email.",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-z0-9._-]+$",
    "type": "string"
   },
   "targets": {
    "description": "Destination addresses, full emails. Every address must be valid. Multiple targets fan-out (each receives a copy).",
    "items": {
     "format": "email",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "mail_hosting_id",
   "name",
   "targets"
  ],
  "type": "object"
 },
 "name": "infomaniak_create_redirection",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "mail_hosting_id": {
        "type": "number"
       },
       "name": {
        "type": "string"
       },
       "targets": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "mail_hosting_id",
       "name",
       "targets"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "message": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "status": {
      "const": "applied",
      "type": "string"
     },
     "targets": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "status",
     "name",
     "targets",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
