{
 "description": "Update a conversation (assign, star, mark read/unread, add feedback).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "assignedTo": {
    "description": "User ID to assign the conversation to",
    "type": "string"
   },
   "conversationId": {
    "description": "Conversation ID",
    "type": "string"
   },
   "feedback": {
    "additionalProperties": {},
    "description": "Feedback object for the conversation",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "locationId": {
    "description": "Location ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "starred": {
    "description": "Star or unstar the conversation",
    "type": "boolean"
   },
   "unreadCount": {
    "description": "Set unread message count",
    "type": "number"
   }
  },
  "required": [
   "access_token",
   "conversationId",
   "locationId"
  ],
  "type": "object"
 },
 "name": "crm_update_conversation"
}
