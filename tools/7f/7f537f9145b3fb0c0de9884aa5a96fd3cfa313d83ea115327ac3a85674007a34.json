{
 "description": "Configure the display-only Recent tab shown inside the existing workspace Home tab/table region, and choose which Home tab opens by default.\nSet config.defaultTabId to \"recent\" or to a use-case tab id listed by inspect_home_recent_tab to change the default tab; omit it to keep the legacy defaultSelected behavior.\nRequires the exact workspace revision returned by inspect_home_recent_tab and a full config object, or null to reset defaults. This only changes Home navigation and presentation: it does not run workflows, call providers, spend credits, change approvals, or mutate workflow/customer records.\n\nRequires write access when connected with OAuth.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "config": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "defaultSelected": {
        "type": "boolean"
       },
       "defaultTabId": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "enabled": {
        "type": "boolean"
       },
       "includeChildRuns": {
        "type": "boolean"
       },
       "label": {
        "maxLength": 40,
        "minLength": 1,
        "type": "string"
       },
       "limit": {
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
       },
       "sources": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "cta": {
           "additionalProperties": false,
           "properties": {
            "label": {
             "maxLength": 40,
             "minLength": 1,
             "type": "string"
            },
            "target": {
             "anyOf": [
              {
               "additionalProperties": false,
               "properties": {
                "outputPagePathname": {
                 "minLength": 1,
                 "type": "string"
                },
                "type": {
                 "const": "output-page",
                 "type": "string"
                }
               },
               "required": [
                "type",
                "outputPagePathname"
               ],
               "type": "object"
              },
              {
               "additionalProperties": false,
               "properties": {
                "field": {},
                "type": {
                 "const": "url-field",
                 "type": "string"
                }
               },
               "required": [
                "type",
                "field"
               ],
               "type": "object"
              }
             ]
            }
           },
           "required": [
            "label",
            "target"
           ],
           "type": "object"
          },
          "workflowId": {
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "workflowId"
         ],
         "type": "object"
        },
        "maxItems": 12,
        "type": "array"
       },
       "statuses": {
        "items": {
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 24,
        "type": "array"
       },
       "version": {
        "const": 1,
        "type": "number"
       }
      },
      "required": [
       "version"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Complete Home Recent config, or null to reset to defaults."
   },
   "expectedWorkspaceUpdatedAt": {
    "description": "Exact workspaceUpdatedAt revision returned by inspect_home_recent_tab.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "expectedWorkspaceUpdatedAt",
   "config"
  ],
  "type": "object"
 },
 "name": "configure_home_recent_tab"
}
