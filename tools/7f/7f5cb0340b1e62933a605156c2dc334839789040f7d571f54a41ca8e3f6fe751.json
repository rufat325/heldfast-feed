{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns a seller's public profile -- the same information the web /user/<id> profile page shows: display name, avatar URL, about text, identity-verification badge, location (country/region/city), when they joined, accepted payment/shipment methods, whether they have a fully active Stripe Connect account, their number of currently active listings, completed-sale count, follower count, and their positive-feedback rating (0-5, null if they have no feedback yet). Useful for judging seller reputation before advising a buyer, or to get the shop_url for browsing everything they sell (pass the same seller id as search's seller_id filter). Read-only, no authentication required.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "sellerId": {
    "description": "The seller's uuid -- the seller.id from any search or getProduct result.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "sellerId"
  ],
  "type": "object"
 },
 "name": "sellers.get",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "about": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "accepted_payment_methods": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "accepted_shipment_methods": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "active_listing_count": {
    "type": "number"
   },
   "avatar_url": {
    "type": "string"
   },
   "city": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "country_code": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "feedback_count": {
    "type": "number"
   },
   "follower_count": {
    "type": "number"
   },
   "id": {
    "type": "string"
   },
   "is_verified": {
    "type": "boolean"
   },
   "member_since": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "name": {
    "type": "string"
   },
   "profile_url": {
    "type": "string"
   },
   "rating": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "region_code": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "shop_url": {
    "type": "string"
   },
   "sold_count": {
    "type": "number"
   },
   "stripe_connect_active": {
    "type": "boolean"
   }
  },
  "required": [
   "id",
   "name",
   "avatar_url",
   "about",
   "is_verified",
   "country_code",
   "region_code",
   "city",
   "member_since",
   "accepted_payment_methods",
   "accepted_shipment_methods",
   "stripe_connect_active",
   "active_listing_count",
   "sold_count",
   "follower_count",
   "rating",
   "feedback_count",
   "profile_url",
   "shop_url"
  ],
  "type": "object"
 },
 "title": "Get a Resollo seller's public profile"
}
