{
 "description": "Create a cash payment voucher on a Colombian cash network (POST /restpagos/v2/efectivo/{network} on secure.payco.co). The payer takes the voucher code to a physical point to pay.",
 "inputSchema": {
  "properties": {
   "cell_phone": {
    "description": "Payer mobile phone",
    "type": "string"
   },
   "currency": {
    "description": "Currency (default COP)",
    "type": "string"
   },
   "description": {
    "description": "Payment description",
    "type": "string"
   },
   "doc_number": {
    "description": "Payer document number",
    "type": "string"
   },
   "doc_type": {
    "description": "Payer document type",
    "type": "string"
   },
   "email": {
    "description": "Payer email",
    "type": "string"
   },
   "end_date": {
    "description": "Voucher expiry date, YYYY-MM-DD",
    "type": "string"
   },
   "invoice": {
    "description": "Merchant invoice/order reference",
    "type": "string"
   },
   "ip": {
    "description": "Payer IP address",
    "type": "string"
   },
   "last_name": {
    "description": "Payer last name",
    "type": "string"
   },
   "name": {
    "description": "Payer first name",
    "type": "string"
   },
   "network": {
    "description": "Cash network",
    "enum": [
     "efecty",
     "gana",
     "redservi",
     "puntored",
     "sured"
    ],
    "type": "string"
   },
   "tax": {
    "description": "Tax portion (default \"0\")",
    "type": "string"
   },
   "tax_base": {
    "description": "Taxable base",
    "type": "string"
   },
   "url_confirmation": {
    "description": "Server-to-server confirmation webhook URL",
    "type": "string"
   },
   "url_response": {
    "description": "URL the payer returns to",
    "type": "string"
   },
   "value": {
    "description": "Amount (string)",
    "type": "string"
   }
  },
  "required": [
   "network",
   "invoice",
   "description",
   "value",
   "doc_type",
   "doc_number",
   "name",
   "email",
   "cell_phone",
   "end_date",
   "ip"
  ],
  "type": "object"
 },
 "name": "create_cash_payment"
}
