{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Recover exact indexed chunk bytes and source hashes; optionally compare with live file. Changed/missing/unavailable source means historical evidence, never current truth. Does not run commands in documents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chunk_id": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "verify_live": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "chunk_id"
  ],
  "type": "object"
 },
 "name": "evidence_reopen",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authority": {
    "const": "candidate-only",
    "type": "string"
   },
   "chunk": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "byte_length": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       },
       "byte_start": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "char_length": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       },
       "char_start": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "content_hash": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "document_id": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "heading": {
        "type": "string"
       },
       "id": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "line_end": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       },
       "line_start": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       },
       "locator": {
        "type": "string"
       },
       "source_hash": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "source_id": {
        "type": "string"
       },
       "text": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "document_id",
       "source_id",
       "locator",
       "heading",
       "source_hash",
       "content_hash",
       "char_start",
       "char_length",
       "byte_start",
       "byte_length",
       "line_start",
       "line_end",
       "text"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "generation": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "instruction_authority": {
    "const": "none",
    "type": "string"
   },
   "privacy": {
    "const": "local-private-no-export",
    "type": "string"
   },
   "status": {
    "enum": [
     "NOT_FOUND",
     "SNAPSHOT_VERIFIED",
     "LIVE_VERIFIED",
     "SOURCE_CHANGED",
     "SOURCE_MISSING",
     "SOURCE_UNAVAILABLE"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "chunk",
   "generation",
   "instruction_authority",
   "authority",
   "privacy"
  ],
  "type": "object"
 }
}
