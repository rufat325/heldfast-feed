{
 "description": "Search a bounded CSS parameter range using coarse-to-fine browser rendering and a strict render budget.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "max": {
    "type": "number"
   },
   "maxEvaluations": {
    "exclusiveMinimum": 0,
    "maximum": 60,
    "type": "integer"
   },
   "min": {
    "type": "number"
   },
   "projectId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "property": {
    "enum": [
     "translateX",
     "translateY",
     "width",
     "height",
     "fontSize",
     "lineHeight",
     "letterSpacing",
     "borderRadius",
     "opacity"
    ],
    "type": "string"
   },
   "referenceId": {
    "type": "string"
   },
   "regionId": {
    "type": "string"
   },
   "selector": {
    "type": "string"
   },
   "step": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "timeoutMs": {
    "exclusiveMinimum": 0,
    "maximum": 120000,
    "type": "integer"
   }
  },
  "required": [
   "projectId",
   "selector",
   "property",
   "min",
   "max",
   "step"
  ],
  "type": "object"
 },
 "name": "visual.optimize"
}
