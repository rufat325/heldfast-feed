{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Current state of an offer, including the code and checkout link once accepted.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "offerId": {
    "maxLength": 64,
    "type": "string"
   }
  },
  "required": [
   "offerId"
  ],
  "type": "object"
 },
 "name": "get_offer",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "acceptance": {
    "additionalProperties": false,
    "properties": {
     "checkoutUrl": {
      "type": "string"
     },
     "code": {
      "type": "string"
     },
     "codeExpiresAt": {
      "type": "string"
     },
     "finalPriceCents": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "shopPayUrl": {
      "type": "string"
     }
    },
    "required": [
     "finalPriceCents",
     "checkoutUrl",
     "shopPayUrl"
    ],
    "type": "object"
   },
   "counterCents": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "currency": {
    "type": "string"
   },
   "expiresAt": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "offerId": {
    "type": "string"
   },
   "round": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "roundsRemaining": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "status": {
    "enum": [
     "countered",
     "accepted",
     "rejected",
     "expired",
     "withdrawn"
    ],
    "type": "string"
   },
   "yourLastOfferCents": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "offerId",
   "status",
   "round",
   "roundsRemaining",
   "currency",
   "expiresAt",
   "message"
  ],
  "type": "object"
 }
}
