    "pattern": "^[0-9A-Z]{6}$",
    "type": "string"
   },
   "top": {
    "description": "\ud45c\uc2dc\ud560 \uc885\ubaa9/\ud589 \uc218 (\uae30\ubcf8\uac12 20, \ucd5c\ub300 50) \u2014 view=date_rank\ub294 \uc21c\uc704\ub97c \uc870\ud68c \ubc94\uc704 \uc548\uc5d0\uc11c \ub9e4\uae30\ubbc0\ub85c 20\ub85c \uc81c\ud55c\ub429\ub2c8\ub2e4",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "unit": {
    "description": "view=top\uc758 \uae08\uc561/\uc218\ub7c9 \uae30\uc900 (\uae30\ubcf8\uac12: amount)",
    "enum": [
     "amount",
     "quantity"
    ],
    "type": "string"
   },
   "view": {
    "description": "\uc870\ud68c \uc885\ub958 (\uae30\ubcf8\uac12: top)",
    "enum": [
     "top",
     "date_rank",
     "market_daily",
     "market_intraday",
     "stock_daily",
     "stock_intraday",
     "arbitrage_balance"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_program_trading",
 "title": "\ud504\ub85c\uadf8\ub7a8 \ub9e4\ub9e4 \uc870\ud68c"
