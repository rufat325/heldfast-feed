{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update project document"
 },
 "description": "Update a project document by ID. Requires project_documents:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "Description",
    "type": "string"
   },
   "file_path": {
    "description": "Storage path",
    "maxLength": 2000,
    "type": "string"
   },
   "file_size": {
    "description": "File size in bytes",
    "minimum": 0,
    "type": "number"
   },
   "file_type": {
    "description": "MIME type",
    "maxLength": 200,
    "type": "string"
   },
   "folder_id": {
    "description": "Folder ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "id": {
    "description": "Project document ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "name": {
    "description": "Document name",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "project_id": {
    "description": "Project ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "uploaded_by": {
    "description": "Uploader user ID",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_project_document",
 "title": "Update project document"
}
