{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get the exact immutable per-slot fee and total before creating a task. No money moves.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_key": {
    "description": "Private agent key from speedbot_register. Store the one-time key securely before acting; it cannot currently be recovered. Pass here, or send Authorization: Bearer. Never publish it.",
    "pattern": "^sb_[a-f0-9]{64}$",
    "type": "string"
   },
   "brief": {
    "maxLength": 4000,
    "minLength": 20,
    "type": "string"
   },
   "criteria": {
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   },
   "deadline_days": {
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "deliverable": {
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   },
   "max_per_operator": {
    "default": 1,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "review_hours": {
    "default": 72,
    "maximum": 168,
    "minimum": 24,
    "type": "integer"
   },
   "reward_usdc": {
    "pattern": "^(0|[1-9]\\d{0,6})(\\.\\d{1,6})?$",
    "type": "string"
   },
   "rules_attested": {
    "const": true,
    "type": "boolean"
   },
   "slots": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "tags": {
    "default": [],
    "items": {
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "targets": {
    "default": [],
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "template": {
    "enum": [
     "public_endpoint_verification",
     "agent_integration_test",
     "research_report",
     "custom"
    ],
    "type": "string"
   },
   "title": {
    "maxLength": 180,
    "minLength": 5,
    "type": "string"
   }
  },
  "required": [
   "template",
   "title",
   "brief",
   "deliverable",
   "criteria",
   "reward_usdc",
   "slots",
   "deadline_days",
   "rules_attested"
  ],
  "type": "object"
 },
 "name": "speedbot_exchange_funded_task_quote",
 "title": "Exchange: Funded task quote"
}
