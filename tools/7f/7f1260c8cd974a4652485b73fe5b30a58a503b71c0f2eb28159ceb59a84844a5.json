{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List Crawls"
 },
 "description": "List this account's crawls, newest first, with status and coverage (no results). Pass next_cursor as cursor for the next page; next_cursor is absent on the last page.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "next_cursor from a previous crawl_list call",
    "type": [
     "string",
     "null"
    ]
   },
   "limit": {
    "anyOf": [
     {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Crawls per page (default 20, max 100)"
   }
  },
  "type": "object"
 },
 "name": "crawl_list"
}
