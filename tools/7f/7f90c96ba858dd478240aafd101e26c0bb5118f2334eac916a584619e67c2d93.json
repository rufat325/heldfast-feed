{
 "description": "Commit changes to git repository.",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "Optional: ID of remote agent. If omitted, executes locally.",
    "type": "string"
   },
   "files": {
    "description": "Files to commit (empty = all staged)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "message": {
    "description": "Commit message",
    "type": "string"
   },
   "repo": {
    "description": "Path to the git repository",
    "type": "string"
   }
  },
  "required": [
   "repo",
   "message"
  ],
  "type": "object"
 },
 "name": "git_commit"
}
