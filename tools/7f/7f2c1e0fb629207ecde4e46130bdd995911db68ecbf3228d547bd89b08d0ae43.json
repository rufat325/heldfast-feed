{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Generate draft job skills"
 },
 "description": "Generate draft interview-plan skills from confirmed competencies.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "const": "interview_plan.generate_skills",
    "type": "string"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "input": {
    "additionalProperties": false,
    "properties": {
     "accepted_skills": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "category": {
         "maxLength": 128,
         "type": "string"
        },
        "description": {
         "maxLength": 5000,
         "type": "string"
        },
        "details": {
         "maxLength": 5000,
         "type": "string"
        },
        "id": {
         "maxLength": 128,
         "type": "string"
        },
        "name": {
         "maxLength": 300,
         "type": "string"
        },
        "requirement": {
         "maxLength": 5000,
         "type": "string"
        },
        "skill": {
         "maxLength": 300,
         "type": "string"
        },
        "title": {
         "maxLength": 300,
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
     },
     "instructions": {
      "maxLength": 10000,
      "type": "string"
     },
     "source_stage": {
      "additionalProperties": false,
      "properties": {
       "stage": {
        "const": "competencies",
        "type": "string"
       },
       "version": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "stage"
      ],
      "type": "object"
     }
    },
    "type": "object"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "resource": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "pattern": "^ipd_[0-9A-Za-z]{16,64}$",
      "type": "string"
     },
     "type": {
      "const": "interview_plan_draft",
      "type": "string"
     }
    },
    "required": [
     "type",
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "action",
   "resource",
   "input"
  ],
  "type": "object"
 },
 "name": "yardstick_interview_plan_drafts_generate_skills",
 "title": "Generate draft job skills"
}
