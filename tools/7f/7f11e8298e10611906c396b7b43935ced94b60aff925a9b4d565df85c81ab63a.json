{
 "description": "List all bids on a given intent, sorted by amount ascending. Each bid includes the bidder's SynmercoScore. Use to see competition before bidding, or to evaluate offers as the buyer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "intentId": {
    "description": "Intent UUID",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Max bids to return",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "description": "Filter by bid status",
    "enum": [
     "open",
     "won",
     "lost",
     "withdrawn",
     "expired"
    ],
    "type": "string"
   }
  },
  "required": [
   "intentId"
  ],
  "type": "object"
 },
 "name": "list_bids_on_intent"
}
