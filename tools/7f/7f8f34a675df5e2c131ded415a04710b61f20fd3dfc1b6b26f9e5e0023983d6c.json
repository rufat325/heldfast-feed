{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set a date's time"
 },
 "description": "Sets or clears the time on dates already on a draft or a live event \u2014 an exact start (and optional end) time, or a daypart (morning/afternoon/evening), never both; omit all three to make it a plain day again. The one way to put a time on a date that is already there (add_dates refuses a duplicate day). An exact time is an autopilot feature: on a draft it is charged at send, once; on a live classic (share-link) poll it is refused \u2014 a classic poll asks about days and dayparts only. Never mails anyone \u2014 nobody's row changed. The confirmed date on a live event can't be changed. Needs the write permission.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dates": {
    "description": "The ISO day(s) to set \u2014 each must already be on the event or draft",
    "items": {
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "maxItems": 300,
    "minItems": 1,
    "type": "array"
   },
   "daypart": {
    "anyOf": [
     {
      "enum": [
       "morning",
       "afternoon",
       "evening"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "A rough time of day instead of an exact one"
   },
   "endTime": {
    "anyOf": [
     {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "\"HH:MM\", 24h \u2014 only with a startTime, and later than it"
   },
   "event_id": {
    "description": "A draft_ id, or a live event id",
    "type": "string"
   },
   "startTime": {
    "anyOf": [
     {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "\"HH:MM\", 24h \u2014 the exact start"
   }
  },
  "required": [
   "event_id",
   "dates"
  ],
  "type": "object"
 },
 "name": "set_date_time",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": "string"
      },
      "daypart": {
       "anyOf": [
        {
         "enum": [
          "morning",
          "afternoon",
          "evening"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "endTime": {
       "anyOf": [
        {
         "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "label": {
       "type": "string"
      },
      "startTime": {
       "anyOf": [
        {
         "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "date",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "events:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Set a date's time"
}
