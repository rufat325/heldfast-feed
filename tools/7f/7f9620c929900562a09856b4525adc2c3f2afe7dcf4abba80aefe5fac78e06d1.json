{
 "description": "Map a @alter-ai/cli exit code or error message to a remediation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "error": {
    "description": "The stderr / error message.",
    "maxLength": 10000,
    "type": "string"
   },
   "exit_code": {
    "description": "The CLI process exit code.",
