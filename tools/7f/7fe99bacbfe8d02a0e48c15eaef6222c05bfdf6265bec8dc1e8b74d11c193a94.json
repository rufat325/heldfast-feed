{
 "description": "Ask a natural-language analytics question; the Fleets agent runs the right tools server-side and returns an answer with citations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "model": {
    "description": "model (default haiku)",
    "enum": [
     "haiku",
     "sonnet",
     "opus"
    ],
    "type": "string"
   },
   "question": {
    "description": "the question, plain English",
    "type": "string"
   }
  },
  "required": [
   "question"
  ],
  "type": "object"
 },
 "name": "ask"
}
