{
 "description": "Rename or move a file within an app. oldPath is the current path, newPath is the destination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "The app public ID",
    "type": "string"
   },
   "newPath": {
    "description": "New file path, e.g. \"new-name.html\" or \"subfolder/file.html\"",
    "type": "string"
   },
   "oldPath": {
    "description": "Current file path, e.g. \"old-name.html\"",
    "type": "string"
   }
  },
  "required": [
   "appId",
   "oldPath",
   "newPath"
  ],
  "type": "object"
 },
 "name": "neblla_move_file"
}
