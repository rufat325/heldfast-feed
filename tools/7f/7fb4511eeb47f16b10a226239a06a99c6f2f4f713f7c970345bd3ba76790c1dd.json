{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Set a date-specific availability override \u2014 mark a day as unavailable, or set custom hours for that date.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "calendarId": {
    "description": "Calendar UUID",
    "type": "string"
   },
   "date": {
    "description": "Date to override (YYYY-MM-DD)",
    "type": "string"
   },
   "hours": {
    "description": "Custom hours for this date (overrides weekly hours)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "end": {
       "description": "End time (HH:mm)",
       "type": "string"
      },
      "start": {
       "description": "Start time (HH:mm)",
       "type": "string"
      }
     },
     "required": [
      "start",
      "end"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "isUnavailable": {
    "description": "Mark the entire day as unavailable",
    "type": "boolean"
   },
   "reason": {
    "description": "Reason for the override (e.g. 'Holiday')",
    "type": "string"
   }
  },
  "required": [
   "calendarId",
   "date"
  ],
  "type": "object"
 },
 "name": "neuron_set_override",
 "title": "Set Availability Override"
}
