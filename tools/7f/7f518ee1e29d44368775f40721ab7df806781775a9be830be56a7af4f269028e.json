{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hairdora:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List salon payments"
 },
 "description": "Use this when someone asks what payments their salon took, whether a client paid, or how much came in over a period. Returns payment records with id, client and salon ids, date, amount, currency and status for any date window and all salons unless one is given, newest first, up to 100 (no card details). Not for charging or refunding a client.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clientId": {
    "description": "Only payments from this client, by an id from the client list",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "endTime": {
    "description": "Only payments ending before this ISO 8601 time",
    "maxLength": 32,
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of payments to return (default 20, maximum 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "salonId": {
    "description": "Only payments at this salon, by an id from the user's salon list; every salon when absent",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "startTime": {
    "description": "Only payments starting at or after this ISO 8601 time",
    "maxLength": 32,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_payments",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "hasMore": {
    "type": "boolean"
   },
   "payments": {
    "description": "Payment records, newest first; this tool cannot charge, refund or move funds. Cardholder data, processor and customer ids, credentials, errors, discounts, staff commission splits, operator notes and organization data are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "type": [
        "number",
        "null"
       ]
      },
      "clientId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "currency": {
       "anyOf": [
        {
         "pattern": "^[A-Z]{3}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "salonId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "startTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "anyOf": [
        {
         "enum": [
          "CANCELED",
          "FAILED",
          "SUCCEEDED"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "clientId",
      "salonId",
      "startTime",
      "amount",
      "currency",
      "status"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "payments",
   "count",
   "hasMore"
  ],
  "type": "object"
 },
 "title": "List salon payments"
}
