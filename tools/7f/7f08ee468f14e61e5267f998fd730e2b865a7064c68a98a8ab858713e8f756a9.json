{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Fix how a word is pronounced"
 },
 "description": "Use this when narration mispronounces a word, name or brand in a project's voiceovers. Returns the rule and the project's rule count after adding or replacing it (IPA or CMU phonemes, up to 500 rules) and syncing the pronunciation dictionary used for later synthesis. Not for re-voicing lines that already have audio.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alphabet": {
    "description": "Phonetic alphabet: ipa or cmu; defaults to ipa",
    "enum": [
     "ipa",
     "cmu"
    ],
    "type": "string"
   },
   "phonemes": {
    "description": "How to say it, in the chosen phonetic alphabet, up to 500 characters",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "description": "Project whose narration to fix",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "word": {
    "description": "Exact word or phrase to match, up to 120 characters",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "word",
   "phonemes"
  ],
  "type": "object"
 },
 "name": "set_pronunciation_rule",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "rule": {
    "additionalProperties": false,
    "properties": {
     "alphabet": {
      "enum": [
       "ipa",
       "cmu"
      ],
      "type": "string"
     },
     "phonemes": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
     },
     "word": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "word",
     "phonemes",
     "alphabet"
    ],
    "type": "object"
   },
   "ruleCount": {
    "anyOf": [
     {
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "ruleCountIsLowerBound": {
    "type": "boolean"
   },
   "status": {
    "enum": [
     "added",
     "replaced",
     "unchanged",
     "project-not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "projectId",
   "rule",
   "ruleCount",
   "ruleCountIsLowerBound"
  ],
  "type": "object"
 },
 "title": "Fix how a word is pronounced"
}
