{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare Platforms"
 },
 "description": "Compare 2-6 platforms in one category with optional criterion weights. Applies VaultRubric's 75% coverage gate, 60% hack cap and too-close-to-call (<3 points) rules.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "512x512"
   ],
   "src": "https://vaultrubric.com/icon.png"
  }
 ],
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "platforms": {
    "description": "2-6 platform names from the same category, e.g. ['Coinbase', 'Kraken']",
    "items": {
     "type": "string"
    },
    "maxItems": 6,
    "minItems": 2,
    "type": "array"
   },
   "weights": {
    "additionalProperties": {
     "maximum": 10,
     "minimum": 0,
     "type": "number"
    },
    "description": "Optional importance 0-10 per criterion key (keys from get_platform criteria, e.g. {'fees': 10, 'security': 8}); unspecified criteria default to 5",
    "type": "object"
   }
  },
  "required": [
   "platforms"
  ],
  "type": "object"
 },
 "name": "compare_platforms",
 "outputSchema": {
  "properties": {
   "attribution": {
    "description": "Always 'Source: VaultRubric (vaultrubric.com)'; include when citing.",
    "type": "string"
   },
   "category": {
    "type": "string"
   },
   "license": {
    "description": "Data license / reuse terms",
    "type": "string"
   },
   "methodology": {
    "description": "URL of the scoring methodology",
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "page": {
    "description": "Most relevant VaultRubric page URL",
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "customer_funds_hack": {},
      "data_coverage_pct": {
       "type": [
        "number",
        "null"
       ]
      },
      "eligible": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "score_pct": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "rules": {
    "type": "string"
   },
   "too_close_to_call": {
    "items": {
     "type": "string"
    },
    "type": [
     "array",
     "null"
    ]
   },
   "weights": {
    "description": "Weights applied (object) or 'equal (5 each)'"
   },
   "winner": {
    "description": "Winning platform, or null if too close / none eligible",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "category",
   "results",
   "page",
   "attribution"
  ],
  "type": "object"
 },
 "title": "Compare Platforms"
}
