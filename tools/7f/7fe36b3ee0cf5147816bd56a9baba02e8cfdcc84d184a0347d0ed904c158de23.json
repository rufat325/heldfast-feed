{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "List a wallet's fills for history and P&L. Newest first; keyset cursor on (timestamp,id); one row per match. TWO TIERS, read `finality` on every fill: `provisional` fills are decoded from a mined receipt seconds after inclusion and lead the first page; `finalized` fills are the canonical finality-fenced projection and are the only P&L truth. Provisional fills never appear on a cursor page \u2014 they are always newer than any cursor \u2014 so a paging walk stays canonical. Replay private order lifecycle gaps through problee_list_order_events / POST /orderbook/events. ORDERBOOK MatchSettled ingest freshness (prod 2026-07-10): webhook_first \u22481.52s from block time. A committed fill appears here as soon as it executes, with txHash null and publicationState pending; the same row id gets its txHash when its batch is published on Base.",
 "inputSchema": {
  "properties": {
   "chainId": {
    "description": "Active chain to query. Discover IDs via GET /discover/chains.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "cursor": {
    "description": "Opaque cursor from a previous response.",
    "type": "string"
   },
   "limit": {
    "description": "Page size (1\u2013100, default 50).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "walletAddress": {
    "description": "Wallet to list fills for (0x + 40 hex).",
    "type": "string"
   }
  },
  "required": [
   "walletAddress",
   "chainId"
  ],
  "type": "object"
 },
 "name": "problee_list_trade_fills",
 "outputSchema": {
  "$defs": {
   "EvmAddress": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "FillSettlementState": {
    "enum": [
     "pending",
     "committed",
     "finalized"
    ],
    "type": "string"
   },
   "OrderbookClOrdId": {
    "maxLength": 200,
    "type": "string"
   },
   "RecordedOn": {
    "additionalProperties": false,
    "properties": {
     "addressTransfersUrl": {
      "format": "uri",
      "type": "string"
     },
     "explorer": {
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
     },
     "txUrl": {
      "format": "uri",
      "type": "string"
     },
     "verifyUrl": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "explorer"
    ],
    "type": "object"
   },
   "TradeFillsResponse": {
    "additionalProperties": false,
    "properties": {
     "fills": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "batchNonce": {
         "anyOf": [
          {
           "pattern": "^\\d+$",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "batchTxHash": {
         "type": [
          "string",
          "null"
         ]
        },
        "chainId": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "clOrdId": {
         "$ref": "#/$defs/OrderbookClOrdId"
        },
        "collateralDelta": {
         "type": "string"
        },
        "direction": {
         "enum": [
          "buy",
          "sell",
          "redeem"
         ],
         "type": "string"
        },
        "executionStatus": {
         "const": "executed",
         "type": "string"
        },
        "explorerUrl": {
         "format": "uri",
         "type": "string"
        },
        "feePaid": {
         "type": [
          "string",
          "null"
         ]
        },
        "finality": {
         "$ref": "#/$defs/TradeFinality"
        },
        "id": {
         "type": "string"
        },
        "liquidityRole": {
         "enum": [
          "maker",
          "taker"
         ],
         "type": "string"
        },
        "logicalTradeKey": {
         "type": "string"
        },
        "marketAddress": {
         "$ref": "#/$defs/EvmAddress"
        },
        "outcomeIndex": {
         "anyOf": [
          {
           "const": 0,
           "type": "number"
          },
          {
           "const": 1,
           "type": "number"
          },
          {
           "const": 2,
           "type": "number"
          }
         ]
        },
        "priceDecimal": {
         "type": "string"
        },
        "priceE18": {
         "type": "string"
        },
        "priceRaw": {
         "type": "string"
        },
        "priceRawScale": {
         "enum": [
          "fixed_1e18",
          "decimal_0_1"
         ],
         "type": "string"
        },
        "principalReceipt": {
         "additionalProperties": false,
         "properties": {
          "authority": {
           "const": "committed_ledger",
           "type": "string"
          },
          "collateralDelta": {
           "maxLength": 80,
           "pattern": "^-?\\d+$",
           "type": "string"
          },
          "collateralEntryKey": {
           "anyOf": [
            {
             "maxLength": 512,
             "minLength": 1,
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "feeEntryKey": {
           "anyOf": [
            {
             "maxLength": 512,
             "minLength": 1,
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "feePaid": {
           "maxLength": 78,
           "pattern": "^\\d+$",
           "type": "string"
          },
          "movementKey": {
           "maxLength": 512,
           "minLength": 1,
           "type": "string"
          },
          "shareEntryKey": {
           "maxLength": 512,
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "authority",
          "movementKey",
          "collateralDelta",
          "feePaid",
          "shareEntryKey",
          "collateralEntryKey",
          "feeEntryKey"
         ],
         "type": "object"
        },
        "publicationState": {
         "enum": [
          "pending",
          "published",
          "finalized"
         ],
         "type": "string"
        },
        "recordedOn": {
         "$ref": "#/$defs/RecordedOn"
        },
        "settlementMode": {
         "enum": [
          "committed",
          "onchain"
         ],
         "type": "string"
        },
        "settlementState": {
         "$ref": "#/$defs/FillSettlementState"
        },
        "sharesDelta": {
         "type": "string"
        },
        "side": {
         "type": "string"
        },
        "timestamp": {
         "anyOf": [
          {
           "format": "date-time",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
           "type": "string"
          },
          {
           "format": "date-time",
           "type": "string"
          }
         ]
        },
        "trader": {
         "$ref": "#/$defs/EvmAddress"
        },
        "txHash": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "chainId",
        "txHash",
        "id",
        "marketAddress",
        "trader",
        "side",
        "outcomeIndex",
        "direction",
        "sharesDelta",
        "collateralDelta",
        "priceRaw",
        "priceRawScale",
        "priceDecimal",
        "priceE18",
        "timestamp"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "hasMore": {
      "type": "boolean"
     },
     "nextCursor": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "fills",
     "nextCursor",
     "hasMore"
    ],
    "type": "object"
   },
   "TradeFinality": {
    "enum": [
     "provisional",
     "finalized"
    ],
    "type": "string"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/TradeFillsResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "List a wallet's trade fills, newest first (keyset cursor). Mined-tier fills lead; read `finality`."
}
