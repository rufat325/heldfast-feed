{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Add an existing calendar to the user's calendar list. Use this to subscribe to shared calendars.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backgroundColor": {
    "description": "Background color in hex (#0088aa)",
    "type": "string"
   },
   "colorId": {
    "description": "Color ID from colors.get",
    "type": "string"
   },
   "foregroundColor": {
    "description": "Foreground color in hex",
    "type": "string"
   },
   "hidden": {
    "description": "Whether to hide from the calendar list",
    "type": "boolean"
   },
   "id": {
    "description": "Calendar ID to subscribe to (usually an email address)",
    "type": "string"
   },
   "selected": {
    "description": "Whether to show events in the UI",
    "type": "boolean"
   },
   "summaryOverride": {
    "description": "Custom name for the calendar",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "calendarlist_insert",
 "title": "Subscribe to calendar"
}
