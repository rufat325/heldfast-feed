{
 "description": "Export your buyer-scoped safety corpus for a challenge (validated breaks / over-refusals / agent-violations). Metadata rows only; embargo-aware; held-out content never leaks cross-buyer. Requires safety_data:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "challengeId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "challengeId"
  ],
  "type": "object"
 },
 "name": "opentrain_safety_dataset_export",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
