{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a category, optionally as a subcategory of a top-level category (ZenMoney allows one nesting level).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "kind": {
    "description": "Defaults to the parent's kind, else expense",
    "enum": [
     "expense",
     "income",
     "both"
    ],
    "type": "string"
   },
   "parent": {
    "description": "Top-level parent category (name or id)",
    "type": "string"
   },
   "required": {
    "default": false,
    "description": "Mark as a mandatory (non-discretionary) expense",
    "type": "boolean"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "create_category",
 "title": "Create category"
}
