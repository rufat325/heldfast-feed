{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Create deterministic weekly fixtures for 3\u201324 teams with balanced home/away games and odd-team byes. Double round-robin reverses the round order and swaps home/away for the return leg. Returns fixtures, team counts, a Markdown table and a share link.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "doubleRoundRobin": {
    "type": "boolean"
   },
   "startDate": {
    "description": "First possible match date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "teams": {
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 24,
    "minItems": 3,
    "type": "array"
   },
   "weekday": {
    "anyOf": [
     {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "string"
     }
    ],
    "description": "0 Sunday through 6 Saturday, or an English weekday name or 3-letter abbreviation (case-insensitive), for example Saturday or sat. Requires startDate; first round is on or after that date."
   }
  },
  "required": [
   "teams"
  ],
  "type": "object"
 },
 "name": "generate_round_robin",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "byes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": "string"
      },
      "round": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "team": {
       "type": "string"
      }
     },
     "required": [
      "round",
      "team"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "fixtures": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "away": {
       "type": "string"
      },
      "date": {
       "type": "string"
      },
      "durationMinutes": {
       "type": "number"
      },
      "home": {
       "type": "string"
      },
      "round": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "time": {
       "type": "string"
      },
      "venue": {
       "type": "string"
      }
     },
     "required": [
      "round",
      "home",
      "away",
      "durationMinutes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "shareUrl": {
    "format": "uri",
    "type": "string"
   },
   "summary": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "away": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "byes": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "home": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "team": {
       "type": "string"
      }
     },
     "required": [
      "team",
      "home",
      "away",
      "byes"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "fixtures",
   "byes",
   "summary",
   "shareUrl"
  ],
  "type": "object"
 },
 "title": "Generate a round-robin schedule"
}
