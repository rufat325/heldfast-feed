{
 "description": "Log an MCP tool call with performance data including latency, success/failure, and error details.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "description": "Error message if call failed",
    "type": "string"
   },
   "latency_ms": {
    "description": "Call latency in milliseconds",
    "minimum": 0,
    "type": "integer"
   },
   "params": {
    "additionalProperties": {},
    "description": "Parameters passed to the tool",
    "type": "object"
   },
   "result_summary": {
    "description": "Brief summary of the result",
    "type": "string"
   },
   "server_name": {
    "description": "Name of the MCP server",
    "type": "string"
   },
   "session_id": {
    "description": "Unique session identifier",
    "type": "string"
   },
   "success": {
    "description": "Whether the call succeeded",
    "type": "boolean"
   },
   "tool_name": {
    "description": "Name of the tool called",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "server_name",
   "tool_name",
   "params",
   "latency_ms",
   "success"
  ],
  "type": "object"
 },
 "name": "log_tool_call"
}
