{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update node pool settings (node count or autoscale) in an NKS cluster",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoscale": {
    "additionalProperties": false,
    "description": "Autoscale configuration",
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "max": {
      "type": "number"
     },
     "min": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "clusterUuid": {
    "description": "UUID of the cluster",
    "type": "string"
   },
   "instanceNo": {
    "description": "Node pool instance number",
    "type": "number"
   },
   "nodeCount": {
    "description": "Desired node count (required if autoscale disabled)",
    "type": "number"
   }
  },
  "required": [
   "clusterUuid",
   "instanceNo"
  ],
  "type": "object"
 },
 "name": "ncloud_nks_update_node_pool"
}
