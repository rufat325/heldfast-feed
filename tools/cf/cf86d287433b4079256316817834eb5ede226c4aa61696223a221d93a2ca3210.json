{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Ask what this magazine would actually give a reader who said they wanted these things. Returns the REAL sequenced path with the rationale for each piece \u2014 the same core the anonymous intake calls, not a preview. Read-only: writes nothing and records no signal.\n\n[capability: adaptive-magazine-engine \u00b7 mirrors: POST /api/magazine/start-path]",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "emotions": {
    "description": "Emotions the reader is steering by.",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "forms": {
    "description": "Article forms to steer by. At least one of emotions/forms is required.",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "limit": {
    "description": "Pieces to return (default 4).",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "property": {
    "description": "Property id; defaults to vela.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vela.magazine.sequence_path",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "path": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "personalized": {
       "type": "boolean"
      },
      "rationale": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "slug",
      "title",
      "rationale",
      "personalized"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "property": {
    "type": "string"
   }
  },
  "required": [
   "property",
   "path"
  ],
  "type": "object"
 },
 "title": "vela.magazine.sequence_path"
}
