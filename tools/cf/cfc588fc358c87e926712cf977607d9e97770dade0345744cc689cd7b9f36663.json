{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List every chain RAVN supports"
 },
 "description": "Every chain RAVN lists a token registry for (see ravn_tokens). Static, doesn't change per request, safe to cache instead of hardcoding a chain table.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "apiKey": {
    "description": "Your RAVN API key, if you have one \u2014 raises your rate limit",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ravn_chains",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "data": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "chainId": {
         "type": "number"
        },
        "explorerUrl": {
         "type": "string"
        },
        "logoUrl": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "nativeCurrency": {
         "additionalProperties": false,
         "properties": {
          "decimals": {
           "type": "number"
          },
          "name": {
           "type": "string"
          },
          "symbol": {
           "type": "string"
          }
         },
         "required": [
          "name",
          "symbol",
          "decimals"
         ],
         "type": "object"
        },
        "shortName": {
         "type": "string"
        }
       },
       "required": [
        "chainId",
        "name",
        "shortName",
        "nativeCurrency",
        "explorerUrl"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "meta": {
      "additionalProperties": false,
      "properties": {
       "requestId": {
        "type": "string"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "requestId",
       "version"
      ],
      "type": "object"
     }
    },
    "required": [
     "data",
     "meta"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "details": {},
       "message": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     "meta": {
      "additionalProperties": false,
      "properties": {
       "requestId": {
        "type": "string"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "requestId",
       "version"
      ],
      "type": "object"
     }
    },
    "required": [
     "error",
     "meta"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "List every chain RAVN supports"
}
