{
 "annotations": {
  "idempotentHint": false,
  "title": "Create New Document"
 },
 "description": "Create a new empty Photoshop document with given dimensions, resolution, and color mode. Returns the new document id and name plus active context. Use this when starting from scratch; prefer ps_open_document to load an existing file.",
 "inputSchema": {
  "properties": {
   "color_mode": {
    "default": "RGB",
    "description": "Color mode (RGB, CMYK, Grayscale)",
    "enum": [
     "RGB",
     "CMYK",
     "Grayscale"
    ],
    "type": "string"
   },
   "height": {
    "description": "Document height in pixels",
    "maximum": 30000,
    "minimum": 1,
    "type": "number"
   },
   "resolution": {
    "default": 72,
    "description": "Document resolution in DPI (default: 72)",
    "maximum": 2400,
    "minimum": 1,
    "type": "number"
   },
   "width": {
    "description": "Document width in pixels",
    "maximum": 30000,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "width",
   "height"
  ],
  "type": "object"
 },
 "name": "ps_create_document",
 "outputSchema": {
  "properties": {
   "context": {
    "type": "object"
   },
   "id": {
    "type": "number"
   },
   "name": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
