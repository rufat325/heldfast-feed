{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find the run with the best (max/min) value of a metric in an experiment",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ascending": {
    "default": false,
    "description": "True to minimize (e.g. loss); default maximizes",
    "type": "boolean"
   },
   "experimentId": {
    "description": "Experiment ID (defaults to MLFLOW_EXPERIMENT_ID)",
    "type": "string"
   },
   "filter": {
    "description": "Additional filter on top of metric ordering",
    "type": "string"
   },
   "metric": {
    "description": "Metric key to optimize on (e.g. 'accuracy', 'loss')",
    "type": "string"
   }
  },
  "required": [
   "metric"
  ],
  "type": "object"
 },
 "name": "get-best-run"
}
