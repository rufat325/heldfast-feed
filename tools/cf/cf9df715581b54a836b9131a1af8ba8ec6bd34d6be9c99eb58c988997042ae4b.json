{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send an email message through Nextcloud Mail. Requires an account ID and recipient addresses.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The mail account ID to send from (from list_mail_accounts)",
    "type": "number"
   },
   "bcc": {
    "description": "BCC email addresses",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "body": {
    "description": "Email body content (plain text)",
    "type": "string"
   },
   "cc": {
    "description": "CC email addresses",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "isHtml": {
    "description": "Whether the body is HTML (default: false)",
    "type": "boolean"
   },
   "subject": {
    "description": "Email subject line",
    "type": "string"
   },
   "to": {
    "description": "Recipient email addresses",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "accountId",
   "to",
   "subject",
   "body"
  ],
  "type": "object"
 },
 "name": "mail_send_message",
 "title": "Send Mail Message"
}
