{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List your signed receipts"
 },
 "description": "List your workspace receipts filtered by outcome, policy, model, or date range. Requires your aqta_ key as Bearer.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max rows, default 25.",
    "type": "number"
   },
   "model": {
    "description": "Only receipts for this model.",
    "type": "string"
   },
   "outcome": {
    "description": "Only receipts with this outcome.",
    "enum": [
     "ALLOWED",
     "BLOCKED",
     "SUPPRESSED",
     "PASSED"
    ],
    "type": "string"
   },
   "policy": {
    "description": "Only receipts where this policy ran, e.g. pii_scan.",
    "type": "string"
   },
   "since": {
    "description": "ISO timestamp lower bound.",
    "type": "string"
   },
   "until": {
    "description": "ISO timestamp upper bound.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_my_receipts",
 "title": "List your signed receipts"
}
