     "title",
     "company_slug",
     "instance",
     "location",
     "all_locations",
     "country",
     "workplace_type",
     "team",
     "salary",
     "posted_at",
     "url",
     "apply_url",
     "description",
     "sections",
     "salary_note",
     "source"
