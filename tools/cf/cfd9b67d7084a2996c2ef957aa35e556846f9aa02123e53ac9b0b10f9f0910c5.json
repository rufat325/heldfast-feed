{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read one Lever opening in full: the advert, its named sections, and the salary as published. company_slug and instance are the ones the row carried, and a site living on both instances holds different openings on each.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "company_slug": {
    "description": "The Lever site name, as resolve_company returns it.",
    "minLength": 1,
    "type": "string"
   },
   "instance": {
    "description": "The Lever instance the row came from. Left out, the global one is read.",
    "enum": [
     "global",
     "eu"
    ],
    "type": "string"
   },
   "job_id": {
    "description": "The identifier of one opening, as a search returns it.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "company_slug",
   "job_id"
  ],
  "type": "object"
 },
 "name": "get_job",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "job": {
    "additionalProperties": false,
    "properties": {
     "all_locations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "apply_url": {
      "type": "string"
     },
     "commitment": {
      "description": "Absent when the company does not record it.",
      "type": "string"
     },
     "company_slug": {
      "type": "string"
     },
     "country": {
      "description": "ISO 3166-1 alpha-2, null when Lever does not record a country.",
      "type": [
       "string",
       "null"
      ]
     },
     "department": {
      "description": "Absent when the company does not record it.",
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "instance": {
      "enum": [
       "global",
       "eu"
      ],
      "type": "string"
     },
     "location": {
      "type": "string"
     },
     "posted_at": {
      "type": "string"
     },
     "salary": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "currency": {
          "type": "string"
         },
         "interval": {
          "description": "The period the amounts belong to, as Lever writes it. Never converted.",
          "type": "string"
         },
         "max": {
          "type": "number"
         },
         "min": {
          "type": "number"
         }
        },
        "required": [
         "min",
         "max",
         "currency",
         "interval"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "Null when the company published no salary, which is never the same as zero."
     },
     "salary_note": {
      "type": [
       "string",
       "null"
      ]
     },
     "sections": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "heading": {
         "type": "string"
        },
        "items": {
