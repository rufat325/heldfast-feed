{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Watch a mountain"
 },
 "description": "Hand the user a one-tap door to a standing powder alert on one resort:\n    we email them when the forecast for that mountain crosses a snowfall bar.\n\n    Use it the moment snow is the answer \u2014 you have just told somebody a\n    mountain gets 40 cm on Thursday, or that this week is quiet and next looks\n    better. `cm` is the bar worth waking up for (5-100, default the house bar).\n\n    WHAT THIS TOOL DOES NOT DO, deliberately: it does not take the user's email\n    address. An alert needs one, and an address is theirs to give to us, not\n    yours to pass on \u2014 so this returns an entry_url that opens the resort page\n    with the alert already chosen and the form open, and they finish it in one\n    field. Present the entry_url exactly as given; never resolve, rewrite or\n    substitute it.",
 "inputSchema": {
  "properties": {
   "cm": {
    "default": 0,
    "title": "Cm",
    "type": "integer"
   },
   "lang": {
    "default": "en",
    "title": "Lang",
    "type": "string"
   },
   "resort": {
    "title": "Resort",
    "type": "string"
   }
  },
  "required": [
   "resort"
  ],
  "title": "watch_resortArguments",
  "type": "object"
 },
 "name": "watch_resort",
