   },
   "campground_name": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Name, or the start of the name, of a specific campground\n(e.g., \"Jumbo Rocks\", \"Upper Pines\"). Matching campgrounds are returned\nfirst; with no other location given, the search centers on the best match."
   },
   "camping_type": {
    "anyOf": [
     {
      "enum": [
       "tent",
       "rv",
       "primitive",
       "group",
       "cabin",
       "glamping"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Camping type (tent/rv/primitive/group/cabin/glamping)"
   },
   "latitude": {
    "anyOf": [
