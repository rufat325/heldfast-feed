  "readOnlyHint": true,
  "title": "Search Campgrounds"
 },
 "description": "Search for campgrounds with 40+ filters including location, amenities, activities, and community safety.\n\nRequires at least one location constraint: near_location, campground_name,\nlatitude+longitude, or states.",
 "inputSchema": {
