   },
   "min_cell_coverage_score": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Minimum cell coverage score (1-5)"
   },
   "min_greenbook_vibe_score": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
