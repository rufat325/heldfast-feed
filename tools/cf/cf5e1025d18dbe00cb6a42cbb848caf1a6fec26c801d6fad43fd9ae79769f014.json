   },
   "prefers_fishing": {
    "default": false,
    "description": "Prefer fishing access",
    "type": "boolean"
   },
   "prefers_forest": {
    "default": false,
    "description": "Prefer forested settings",
    "type": "boolean"
   },
   "prefers_hiking": {
    "default": false,
    "description": "Prefer hiking trails",
    "type": "boolean"
   },
   "prefers_kayaking": {
    "default": false,
    "description": "Prefer kayaking access",
    "type": "boolean"
   },
   "prefers_lakefront": {
    "default": false,
