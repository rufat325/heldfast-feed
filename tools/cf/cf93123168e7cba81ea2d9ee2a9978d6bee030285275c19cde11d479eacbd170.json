{
 "description": "Search documents in a Master Data entity",
 "inputSchema": {
  "properties": {
   "dataEntity": {
    "description": "Data entity name (e.g., CL for clients)",
    "type": "string"
   },
   "fields": {
    "description": "Comma-separated fields (required by VTEX)",
    "type": "string"
   },
   "rangeEnd": {
    "description": "Pagination end (default 10)",
    "type": "number"
   },
   "rangeStart": {
    "description": "Pagination start (default 0)",
    "type": "number"
   },
   "where": {
    "description": "Filter expression (e.g., email=customer@example.com)",
    "type": "string"
   }
  },
  "required": [
   "dataEntity",
   "fields"
  ],
  "type": "object"
 },
 "name": "search_masterdata"
}
