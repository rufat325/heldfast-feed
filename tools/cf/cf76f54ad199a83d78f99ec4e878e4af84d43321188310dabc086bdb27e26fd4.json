{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Log a structured progress update for a task. Use this to document what you attempted, what succeeded, what failed, and any blockers or questions.",
 "inputSchema": {
  "properties": {
   "blockers": {
    "description": "Issues blocking progress (will mark task as blocked if provided)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "checks": {
    "description": "Test or check results at this point, e.g. { passed: 42, total: 42, label: \"vitest\" }. Shown on the Now view.",
    "properties": {
     "label": {
      "description": "What ran, e.g. vitest (max 40 chars)",
      "type": "string"
     },
     "passed": {
      "type": "number"
     },
     "total": {
      "type": "number"
     }
    },
    "required": [
     "passed",
     "total"
    ],
    "type": "object"
   },
   "questions": {
    "description": "Questions for the team",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "taskId": {
    "description": "The task ID to log progress for",
    "type": "string"
   },
   "whatAttempted": {
    "description": "What was attempted (required)",
    "type": "string"
   },
   "whatFailed": {
    "description": "What didn't work and why",
    "type": "string"
   },
   "whatSucceeded": {
    "description": "What worked or was accomplished",
    "type": "string"
   }
  },
  "required": [
   "taskId",
   "whatAttempted"
  ],
  "type": "object"
 },
 "name": "log_progress"
}
