{
 "description": "Pattern/string search, symbol autocomplete, or get string at address",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "pattern",
        "type": "string"
       },
       "address": {
        "description": "Start address",
        "type": "string"
       },
       "max_results": {
        "default": 1000,
        "type": "number"
       },
       "query": {
        "description": "Byte pattern (e.g. '48 89 5C ??')",
        "type": "string"
       },
       "size": {
        "description": "Size of range",
        "type": "string"
       }
      },
      "required": [
       "action",
       "query"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "string",
        "type": "string"
       },
       "encoding": {
        "default": "utf8",
        "enum": [
         "utf8",
         "ascii",
         "unicode"
        ],
        "type": "string"
       },
       "module": {
        "default": "",
        "type": "string"
       },
       "query": {
        "description": "Text string to search for",
        "type": "string"
       }
      },
      "required": [
       "action",
       "query"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "string_at",
        "type": "string"
       },
       "encoding": {
        "default": "auto",
        "enum": [
         "auto",
         "ascii",
         "unicode"
        ],
        "type": "string"
       },
       "max_length": {
        "default": 256,
        "type": "number"
       },
       "query": {
        "description": "Address",
        "type": "string"
       }
      },
      "required": [
       "action",
       "query"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "symbol_auto_complete",
        "type": "string"
       },
       "max_results": {
        "default": 256,
        "type": "number"
       },
       "query": {
        "description": "Partial symbol name",
        "type": "string"
       }
      },
      "required": [
       "action",
       "query"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "encode_type",
        "type": "string"
       },
       "query": {
        "description": "Address",
        "type": "string"
       },
       "size": {
        "default": "1",
        "type": "string"
       }
      },
      "required": [
       "action",
       "query"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "x64dbg_search"
}
