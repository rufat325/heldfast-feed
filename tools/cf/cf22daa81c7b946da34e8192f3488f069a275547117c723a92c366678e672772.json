{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Shows detailed container or image information with structured state, image, and platform data.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   },
   "size": {
    "default": false,
    "description": "Display total file sizes (-s, --size)",
    "type": "boolean"
   },
   "target": {
    "anyOf": [
     {
      "maxLength": 255,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 255,
       "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
     }
    ],
    "description": "Container/image/network/volume target(s) to inspect"
   },
   "type": {
    "description": "Object type to inspect: \"container\", \"image\", \"volume\", or \"network\" (--type)",
    "enum": [
     "container",
     "image",
     "volume",
     "network"
    ],
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "inspect",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cmd": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "created": {
    "type": "string"
   },
   "driver": {
    "type": "string"
   },
   "entrypoint": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "env": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "healthStatus": {
    "enum": [
     "healthy",
     "unhealthy",
     "starting",
     "none"
    ],
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "image": {
    "type": "string"
   },
   "inspectType": {
    "enum": [
     "container",
     "image",
     "volume",
     "network"
    ],
    "type": "string"
   },
   "labels": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "mountpoint": {
    "type": "string"
   },
   "mounts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "destination": {
       "type": "string"
      },
      "mode": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "required": [
      "source",
      "destination"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "networkSettings": {
    "additionalProperties": false,
    "properties": {
     "ipAddress": {
      "type": "string"
     },
     "ports": {
      "additionalProperties": {
       "anyOf": [
        {
         "items": {
          "additionalProperties": false,
          "properties": {
           "hostIp": {
            "type": "string"
           },
           "hostPort": {
            "type": "string"
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "required": [
     "ipAddress"
    ],
    "type": "object"
   },
   "platform": {
    "type": "string"
   },
   "relatedTargets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "inspectType": {
       "enum": [
        "container",
        "image",
        "volume",
        "network"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "target": {
       "type": "string"
      }
     },
     "required": [
      "target",
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "repoDigests": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "repoTags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "restartPolicy": {
    "type": "string"
   },
   "running": {
    "type": "boolean"
   },
   "scope": {
    "type": "string"
   },
   "size": {
    "type": "number"
   },
   "state": {
    "additionalProperties": false,
    "properties": {
     "running": {
      "type": "boolean"
     },
     "startedAt": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "running"
    ],
    "type": "object"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "image"
  ],
  "type": "object"
 },
 "title": "Docker Inspect"
}
