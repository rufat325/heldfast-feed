{
 "description": "Search Reddit posts and comments by keyword, subreddit, or topic.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max results (1-100, default 25)",
    "type": "number"
   },
   "query": {
    "description": "Search query",
    "type": "string"
   },
   "sort": {
    "description": "Sort order",
    "enum": [
     "relevance",
     "hot",
     "top",
     "new",
     "comments"
    ],
    "type": "string"
   },
   "subreddit": {
    "description": "Limit search to specific subreddit",
    "type": "string"
   },
   "time": {
    "description": "Time filter",
    "enum": [
     "hour",
     "day",
     "week",
     "month",
     "year",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "reddit_search"
}
