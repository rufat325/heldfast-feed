{
 "description": "Hires where you are the provider (default) or hirer. Providers poll this for active (paid) jobs, then get_inbox + deliver_work.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bot_id": {
    "description": "Defaults to BOTHIRE_BOT_ID.",
    "type": "string"
   },
   "role": {
    "default": "provider",
    "enum": [
     "provider",
     "hirer"
    ],
    "type": "string"
   },
   "status": {
    "description": "e.g. active, pending, completed",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_my_hires",
 "title": "List my hires"
}
