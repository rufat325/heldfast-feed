{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hotelumo:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List rate plans and base prices"
 },
 "description": "Use this when someone asks what rate plans a hotel sells, such as room-only or breakfast-included rates, and their base prices. Returns each plan's title, room type, base price in minor currency units, meal plan, per-room or per-person pricing and default flag, 20 per page by default. Not for prices on specific dates.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hotelId": {
    "description": "Hotel id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "limit": {
    "description": "Rate plans per page, from 1 to 100; defaults to 20",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "offset": {
    "description": "Rate plans to skip, from 0 to 10000; defaults to 0. For the next page pass offset + limit",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "roomTypeId": {
    "description": "Only this room type (24 lowercase hexadecimal characters)",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "hotelId"
  ],
  "type": "object"
 },
 "name": "list_rate_plans",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "description": "hasMore is true when another page exists; request it with offset + limit",
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "type": "integer"
     },
     "offset": {
      "maximum": 10000,
      "minimum": 0,
      "type": "integer"
     },
     "returned": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "limit",
     "offset",
     "returned",
     "hasMore"
    ],
    "type": "object"
   },
   "ratePlans": {
    "description": "basePrice is in integer minor currency units. Channel-manager mappings, integration metadata and credentials are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "basePrice": {
       "anyOf": [
        {
         "maximum": 1000000000000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "currency": {
       "$ref": "#/properties/ratePlans/items/properties/title"
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "isDefault": {
       "type": "boolean"
      },
      "mealPlan": {
       "$ref": "#/properties/ratePlans/items/properties/title"
      },
      "rateMode": {
       "anyOf": [
        {
         "$ref": "#/properties/ratePlans/items/properties/title/anyOf/0"
        },
        {
         "type": "null"
        }
       ],
       "description": "manual or derived"
      },
      "roomTypeId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sellMode": {
       "$ref": "#/properties/ratePlans/items/properties/title"
      },
      "title": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "roomTypeId",
      "title",
      "basePrice",
      "currency",
      "mealPlan",
      "sellMode",
      "rateMode",
      "isDefault"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "ratePlans",
   "page"
  ],
  "type": "object"
 },
 "title": "List rate plans and base prices"
}
