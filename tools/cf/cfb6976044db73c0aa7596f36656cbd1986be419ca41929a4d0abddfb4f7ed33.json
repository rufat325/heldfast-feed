{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Request a file import from an Object Storage bucket into a Data Box NAS (up to 5 files, 500 MB each). Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucketName": {
    "description": "Source bucket name (see ncloud_databox_list_buckets)",
    "type": "string"
   },
   "dataBoxNo": {
    "description": "Data Box number (console: My Space > server details > Infra tab)",
    "type": "integer"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns the request without sending it",
    "type": "boolean"
   },
   "fileList": {
    "description": "Files to import (up to 5)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Object name in the bucket, including extension",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "nasInstanceNo": {
    "description": "Target NAS instance number (see ncloud_databox_list_nas)",
    "type": "integer"
   }
  },
  "required": [
   "dataBoxNo",
   "bucketName",
   "fileList",
   "nasInstanceNo"
  ],
  "type": "object"
 },
 "name": "ncloud_databox_apply_file_import"
}
