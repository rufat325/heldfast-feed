{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estimate pi with seeded Monte Carlo and a 95% Wilson interval; up to 5 million samples. CPU or optional CUDA. Other direct scientific engines run on CPU.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "backend": {
    "default": "cpu",
    "enum": [
     "cpu",
     "cuda"
    ],
    "type": "string"
   },
   "device_ids": {
    "items": {
     "maximum": 9007199254740991,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 16,
    "type": "array"
   },
   "samples": {
    "maximum": 5000000,
    "minimum": 100,
    "type": "integer"
   },
   "seed": {
    "maximum": 4294967295,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "samples",
   "seed"
  ],
  "type": "object"
 },
 "name": "simulate_pi"
}
