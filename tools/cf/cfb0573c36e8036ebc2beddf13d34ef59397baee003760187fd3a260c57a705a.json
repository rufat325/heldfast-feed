       "JP"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "freshness": {
      "description": "Window applied.",
      "examples": [
       "week"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "language": {
      "description": "Search language when given.",
      "examples": [
       "ja"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "more_results_available": {
      "description": "The engine has more pages.",
      "examples": [
       true
      ],
      "type": "boolean"
     },
     "news": {
      "description": "News results; empty when not asked or none.",
      "items": {
       "description": "One news result.",
       "properties": {
        "age": {
         "description": "Age as worded.",
         "examples": [
          "2 hours ago"
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "breaking": {
         "description": "Flagged breaking by the engine.",
         "examples": [
          false
         ],
         "type": "boolean"
        },
        "description": {
         "description": "Snippet.",
         "examples": [
          "..."
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "page_age": {
         "description": "Article date when known.",
         "examples": [
          "2026-09-27T09:00:00"
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "source": {
         "description": "Publisher or host.",
         "examples": [
          "Reuters"
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "title": {
         "description": "Headline.",
         "examples": [
          "Typhoon nears Tokyo"
         ],
         "type": [
          "string",
          "null"
         ]
        },
        "url": {
         "description": "Article URL.",
         "examples": [
          "https://example.com/news/1"
         ],
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "title",
        "url",
        "description",
        "age",
        "page_age",
        "source",
        "breaking"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "news_count": {
      "description": "News results returned.",
      "examples": [
       3
      ],
      "type": "integer"
     },
     "notes": {
