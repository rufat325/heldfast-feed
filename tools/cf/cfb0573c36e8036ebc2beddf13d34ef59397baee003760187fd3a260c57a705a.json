       "examples": [
        "No result matched the query."
       ],
       "type": "string"
      },
      "type": "array"
     },
     "query": {
      "description": "Query as given.",
      "examples": [
       "\u6771\u4eac \u5929\u6c17\u4e88\u5831"
      ],
      "type": "string"
     },
     "source": {
      "const": "brave",
      "description": "Data source.",
      "type": "string"
     },
     "web": {
