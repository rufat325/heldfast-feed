{
 "description": "List nextgen projects, optionally filtered by search term or status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "type": "number"
   },
   "page_size": {
    "description": "max 100",
    "type": "number"
   },
   "status": {
    "description": "Filter by project status",
    "enum": [
     "running",
     "overdue",
     "over_budget",
     "closed"
    ],
    "type": "string"
   },
   "term": {
    "description": "Search term to filter projects",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "teamleader_projects_list"
}
