{
 "_meta": {
  "vesremont.com/auth": {
   "resource": "https://vesremont.com/mcp",
   "scope": "webhooks:read",
   "scopes": [
    "webhooks:read"
   ]
  },
  "vesremont.com/user-confirmation": false
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Inspect delivery failures or retries for a subscription ID from create_webhook or list_webhooks. Returns only the latest 100 attempts, without event payloads or secrets; no manual resend is performed. Use list_webhooks for subscription status. OAuth scopes: webhooks:read. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "subscription_id": {
    "description": "Subscription ID returned by create_webhook or list_webhooks for this application and buyer session. Not a delivery ID or signing secret.",
    "pattern": "^[a-f0-9]{32}$",
    "type": "string"
   }
  },
  "required": [
   "subscription_id"
  ],
  "type": "object"
 },
 "name": "list_webhook_deliveries",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attempt": {
       "minimum": 0,
       "type": "integer"
      },
      "delivered_at": {
       "anyOf": [
        {
         "format": "date-time",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "event_id": {
       "type": "string"
      },
      "event_type": {
       "type": "string"
      },
      "http_status": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "next_retry_at": {
       "anyOf": [
        {
         "format": "date-time",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "enum": [
        "queued",
        "sending",
        "delivered",
        "failed",
        "cancelled"
       ]
      }
     },
     "required": [
      "event_id",
      "event_type",
      "attempt",
      "http_status",
      "status",
      "next_retry_at",
      "delivered_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 }
}
