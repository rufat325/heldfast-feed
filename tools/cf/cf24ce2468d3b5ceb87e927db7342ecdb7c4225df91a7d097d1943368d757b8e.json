{
 "description": "Rank multiple candidate properties by investment value. Accepts properties from ANY source (user, web search, listing portals) and enriches each with stamp duty, transaction comps, rental yield, affordability, and location data. Returns ranked list with transparent scores (0-100) across 4 dimensions: value vs comps, rental yield, affordability, location. This is the decision layer \u2014 an agent gathers listings anywhere, Bounty tells it which one is best. (PAID \u2014 auto-pay if wallet configured)",
 "inputSchema": {
  "properties": {
   "buyer_profile": {
    "default": "SC",
    "enum": [
     "SC",
     "SPR",
     "FR",
     "entity"
    ],
    "type": "string"
   },
   "candidates": {
    "description": "List of candidate properties to evaluate",
    "items": {
     "properties": {
      "flat_type": {
       "description": "HDB flat type (e.g. '4 ROOM')",
       "type": "string"
      },
      "monthly_rent": {
       "description": "Expected monthly rent (optional)",
       "type": "number"
      },
      "name": {
       "description": "Property name or address (optional)",
       "type": "string"
      },
      "postal_code": {
       "description": "Postal code for location (optional)",
       "type": "string"
      },
      "price": {
       "description": "Asking price in SGD",
       "type": "number"
      },
      "property_type": {
       "default": "hdb",
       "description": "hdb, private, condo, landed",
       "type": "string"
      },
      "town": {
       "description": "Town or area (e.g. 'TAMPINES')",
       "type": "string"
      }
     },
     "required": [
      "price"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "existing_monthly_debt": {
    "default": 0,
    "description": "Existing monthly debt obligations",
    "type": "number"
   },
   "monthly_income": {
    "description": "Gross monthly income for affordability (optional)",
    "type": "number"
   },
   "region": {
    "default": "SG",
    "description": "Region/country code. SG supported now; HK/AE/AU/JP planned.",
    "enum": [
     "SG",
     "HK",
     "AE",
     "AU",
     "JP"
    ],
    "type": "string"
   }
  },
  "required": [
   "candidates"
  ],
  "type": "object"
 },
 "name": "sg_property_rank"
}
