{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Match supplied invoice IDs to payment and refund records in integer USD cents. Reports unpaid, partial and overpaid balances. Does not independently verify settlement, move funds or recognize customer-supplied data as XGuard revenue. Price: 0.100000 USDC on Base. Supporting releases may return activation_pending without payment. Use exact x402 headers and preserve the original quote and idempotency key.","inputSchema":{"additionalProperties":false,"properties":{"currency":{"enum":["USD"],"type":"string"},"idempotency_key":{"maxLength":128,"minLength":8,"type":"string"},"invoices":{"items":{"additionalProperties":false,"properties":{"amount_cents":{"maximum":1000000000000,"minimum":0,"type":"integer"},"id":{"maxLength":100,"minLength":1,"pattern":"^[A-Za-z0-9_.:-]+$","type":"string"}},"required":["id","amount_cents"],"type":"object"},"maxItems":50,"minItems":1,"type":"array"},"max_amount_atomic":{"maxLength":12,"minLength":1,"pattern":"^\\d{1,12}$","type":"string"},"payments":{"items":{"additionalProperties":false,"properties":{"amount_cents":{"maximum":1000000000000,"minimum":0,"type":"integer"},"id":{"maxLength":100,"minLength":1,"pattern":"^[A-Za-z0-9_.:-]+$","type":"string"},"invoice_id":{"maxLength":100,"minLength":1,"pattern":"^[A-Za-z0-9_.:-]+$","type":"string"},"refunded_cents":{"maximum":1000000000000,"minimum":0,"type":"integer"}},"required":["id","invoice_id","amount_cents","refunded_cents"],"type":"object"},"maxItems":100,"minItems":0,"type":"array"}},"required":["currency","invoices","payments","max_amount_atomic","idempotency_key"],"type":"object"},"name":"xguard.commerce_reconcile_invoices"}
