{
 "description": "Free configuration and enrollment preflight before paying. Validates exact authorized paths, pack and idempotency format; refuses an existing caller payment attempt. Makes no target request, signature, settlement or ledger write. Not a deployment test, wallet/balance check or capacity reservation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "json": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "equals": {
          "type": [
           "string",
           "number",
           "boolean",
           "null"
          ]
         },
         "path": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "path",
         "equals"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "status": {
       "type": "number"
      },
      "text": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "url",
      "status"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "enrollment_id": {
    "pattern": "^[a-f0-9-]{36}$",
    "type": "string"
   },
   "idempotency_key": {
    "type": "string"
   },
   "read_token": {
    "maxLength": 128,
    "minLength": 32,
    "type": "string"
   }
  },
  "required": [
   "checks",
   "enrollment_id",
   "read_token",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "preflight_pack"
}
