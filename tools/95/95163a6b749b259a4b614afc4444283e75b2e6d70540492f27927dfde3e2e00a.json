{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "campaign.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update session summary mnemons"
 },
 "description": "Update typed/meta fields of SessionSummary mnemons.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaignId": {
    "minLength": 1,
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "combats": {
       "description": "Combat encounters that took place this session.",
       "items": {
        "additionalProperties": false,
        "properties": {
         "description": {
          "description": "Who fought whom and where, in one sentence.",
          "minLength": 1,
          "type": "string"
         },
         "outcome": {
          "description": "How it resolved, e.g. \"party victorious, no casualties\".",
          "type": "string"
         }
        },
        "required": [
         "description"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "date": {
       "type": "string"
      },
      "detailedSummary": {
       "description": "Full narrative summary, 3-5 paragraphs.",
       "type": "string"
      },
      "entryId": {
       "description": "Mnemon entry id (hex) or exact title.",
       "minLength": 1,
       "type": "string"
      },
      "loot": {
       "description": "Items, treasure, or rewards acquired.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "majorEvents": {
       "description": "Significant story beats, in chronological order.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "npcsMentioned": {
       "description": "NPCs that appeared or were referenced. This is descriptive only \u2014 to link one to an existing NPC mnemon, call create_mnemon_relationship with SESSION_ATTENDEE_NPC.",
       "items": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "description": "Name as referenced in the session, e.g. \"Captain Mira\".",
          "minLength": 1,
          "type": "string"
         },
         "role": {
          "description": "Role played this session, e.g. \"quest-giver\", \"rescued captive\".",
          "type": "string"
         }
        },
        "required": [
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "oneSentenceSummary": {
       "description": "Single-sentence TL;DR of what happened.",
       "type": "string"
      },
      "openThreads": {
       "description": "Unresolved threads and cliffhangers as of session end.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "partyDecisions": {
       "description": "Meaningful choices that will shape future sessions.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "partyEndState": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Character display name -> short end-of-session status line.",
       "type": "object"
      },
      "previouslyOn": {
       "description": "Where each player ended \u2014 read aloud at the top of the next session.",
       "type": "string"
      },
      "sessionNumber": {
       "type": "integer"
      },
      "suggestedTitle": {
       "description": "Short evocative title for the session, like a TV episode title.",
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "visibility": {
       "enum": [
        "HIDDEN",
        "INTERNAL",
        "PUBLIC"
       ],
       "type": "string"
      }
     },
     "required": [
      "entryId"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "campaignId",
   "items"
  ],
  "type": "object"
 },
 "name": "update_session_summary_mnemons",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "entryId": {
       "type": "string"
      },
      "error": {
       "type": "string"
      },
      "failedOpIndex": {
       "type": "number"
      },
      "index": {
       "type": "number"
      },
      "success": {
       "type": "boolean"
      },
      "title": {
       "type": "string"
      },
      "warnings": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "index",
      "success"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Update session summary mnemons"
}
