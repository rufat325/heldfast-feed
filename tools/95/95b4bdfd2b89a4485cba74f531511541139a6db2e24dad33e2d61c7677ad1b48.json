{
 "description": "Create a call activity. SIDE EFFECT: creates a call record.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignee_id": {
    "description": "User ID to assign the call to",
    "type": "string"
   },
   "customer_id": {
    "description": "Customer ID (requires customer_type)",
    "type": "string"
   },
   "customer_type": {
    "description": "Customer type",
    "enum": [
     "contact",
     "company"
    ],
    "type": "string"
   },
   "description": {
    "description": "Call description",
    "type": "string"
   },
   "due_at": {
    "description": "Call datetime (ISO 8601)",
    "type": "string"
   }
  },
  "required": [
   "due_at"
  ],
  "type": "object"
 },
 "name": "teamleader_calls_create"
}
