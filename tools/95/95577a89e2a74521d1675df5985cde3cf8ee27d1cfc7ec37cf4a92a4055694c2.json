{
 "description": "Spawn an ACP agent process and perform the initialize handshake. Must be called before creating sessions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentId": {
    "description": "ID of the installed agent to initialize",
    "type": "string"
   },
   "clientCapabilities": {
    "additionalProperties": false,
    "description": "Client capabilities",
    "properties": {
     "fs": {
      "additionalProperties": false,
      "properties": {
       "readTextFile": {
        "type": "boolean"
       },
       "writeTextFile": {
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "terminal": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "clientInfo": {
    "additionalProperties": false,
    "description": "Calling client info",
    "properties": {
     "name": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "version"
    ],
    "type": "object"
   },
   "protocolVersion": {
    "description": "Protocol version to negotiate",
    "type": "number"
   }
  },
  "required": [
   "agentId"
  ],
  "type": "object"
 },
 "name": "initialize"
}
