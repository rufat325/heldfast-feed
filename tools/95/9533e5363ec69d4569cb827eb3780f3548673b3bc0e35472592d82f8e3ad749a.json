{
 "description": "Get prioritized revenue-driving actions for BD and marketing teams based on current competitive intelligence.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "priority": {
    "description": "P1 = this week \u00b7 P2 = this month \u00b7 P3 = this quarter",
    "enum": [
     "P1",
     "P2",
     "P3"
    ],
    "type": "string"
   },
   "team": {
    "description": "Filter by team",
    "enum": [
     "bd",
     "marketing",
     "product"
    ],
    "type": "string"
   },
   "vertical": {
    "default": "fintech-payments",
    "description": "Industry vertical to query",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_action_items"
}
