{
 "_meta": {
  "openai/outputTemplate": "ui://haus/widgets/v2",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://haus/widgets/v2",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Update a pet's name, microchip number, date of birth, notes, or its linked vet contact and insurance document. Only the fields you send change.",
 "inputSchema": {
  "examples": [
   {
    "id": "01933f9c-7a2b-7c3d-8e4f-1a2b3c4d5e6f",
    "notes": "Started prescription diet on vet's advice."
   }
  ],
  "properties": {
   "dateOfBirth": {
    "description": "Date of birth, YYYY-MM-DD. Empty string clears it.",
    "examples": [
     "2021-06-15"
    ],
    "type": "string"
   },
   "id": {
    "description": "Pet id from list_pets.",
    "examples": [
     "01933f9c-7a2b-7c3d-8e4f-1a2b3c4d5e6f"
    ],
    "type": "string"
   },
   "insuranceDocumentId": {
    "description": "Insurance document id from create_document.",
    "examples": [
     "doc_1a2b3c4d5e6f"
    ],
    "type": "string"
   },
   "microchipNumber": {
    "description": "New microchip number.",
    "examples": [
     "985141000123456"
    ],
    "type": "string"
   },
   "name": {
    "description": "New name.",
    "examples": [
     "Bella"
    ],
    "type": "string"
   },
   "notes": {
    "description": "Freeform notes.",
    "examples": [
     "Allergic to chicken; on prescription food."
    ],
    "type": "string"
   },
   "vetContactId": {
    "description": "Vet contact id from create_contact.",
    "examples": [
     "contact_5e6f7a8b9c0d"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_pet",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "variant": {
    "enum": [
     "list",
     "detail",
     "confirmation"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 }
}
