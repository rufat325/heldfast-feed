{
 "description": "Store an encrypted secret in a target's vault. Common keys: LOGIN_EMAIL, LOGIN_PASSWORD (B2B shop auth), ga4_service_account (GA4 monitoring). Values are AES-256-GCM encrypted at rest.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Optional description",
    "maxLength": 500,
    "type": "string"
   },
   "environment": {
    "default": "PRODUCTION",
    "description": "Environment scope",
    "enum": [
     "PRODUCTION",
     "STAGING",
     "DEVELOPMENT"
    ],
    "type": "string"
   },
   "key": {
    "description": "Secret key (e.g. LOGIN_EMAIL)",
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
    "type": "string"
   },
   "label": {
    "description": "Human-readable label",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "targetId": {
    "description": "The target ID",
    "type": "string"
   },
   "value": {
    "description": "Secret value (will be encrypted)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "targetId",
   "key",
   "label",
   "value"
  ],
  "type": "object"
 },
 "name": "store_secret",
 "title": "Store Secret"
}
