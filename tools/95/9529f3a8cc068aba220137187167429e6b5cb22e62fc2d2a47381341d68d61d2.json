{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Current YouPin898 buy orders (bids) for an item, in CNY, refreshed about every 30 minutes. Default: best buy-order price and order count (Pro plan). With detail=true or any float/phase/fade/tier filter: every individual buy order with its float range and conditions (Enterprise plan). Requires an API key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "detail": {
    "description": "Return every order with float ranges (Enterprise)",
    "type": "boolean"
   },
   "fade": {
    "description": "Fade % of the item",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "float": {
    "description": "Only orders accepting this float",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "limit": {
    "description": "Max orders returned (default 25)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "market_hash_name": {
    "description": "Exact market_hash_name",
    "minLength": 1,
    "type": "string"
   },
   "phase": {
    "enum": [
     "Phase 1",
     "Phase 2",
     "Phase 3",
     "Phase 4",
     "Ruby",
     "Sapphire",
     "Black Pearl",
     "Emerald"
    ],
    "type": "string"
   },
   "tier": {
    "description": "Case Hardened tier",
    "enum": [
     "T1",
     "T2",
     "T3",
     "T4",
     "Full Blue"
    ],
    "type": "string"
   }
  },
  "required": [
   "market_hash_name"
  ],
  "type": "object"
 },
 "name": "get_youpin_buy_orders",
 "title": "YouPin buy orders"
}
