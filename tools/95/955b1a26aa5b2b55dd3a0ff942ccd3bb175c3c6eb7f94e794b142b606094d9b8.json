{
 "description": "Read-only Markdown note reader by vault-relative path and optional line range.",
 "inputSchema": {
  "properties": {
   "end_line": {
    "minimum": 1,
    "type": "integer"
   },
   "include_sensitive": {
    "default": false,
    "description": "Requires OBSIDIAN_SEMANTIC_ALLOW_SENSITIVE=true on the server.",
    "type": "boolean"
   },
   "path": {
    "type": "string"
   },
   "start_line": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "read_note"
}
