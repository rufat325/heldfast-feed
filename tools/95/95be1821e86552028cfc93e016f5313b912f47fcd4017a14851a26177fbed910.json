{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "mcp:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Search graded Pok\u00e9mon cards by name (Chinese / English / Japanese), community nickname (e.g. \"\u9b3c\u76ae\"), or set code + card number (e.g. \"sv8a \u55b7\u706b\u9f99\", \"CEL 4\"). \u4e2d\u6587\u7528\u6237: \u6309\u5b98\u65b9\u5361\u540d/\u5708\u5185\u7b80\u79f0/\u7cfb\u5217\u7801+\u5361\u53f7\u67e5\u4efb\u610f\u5b9d\u53ef\u68a6\u8bc4\u7ea7\u5361, \u8fd4\u56de card_id \u4f9b\u67e5\u4ef7/\u8d70\u52bf/\u5b58\u4e16\u91cf\u5de5\u5177\u4f7f\u7528\u3002Returns up to 10 matching cards with card_id (incl. rarity/variant/species fields) \u2014 use card_id with the other tools. A bare set code or set name (e.g. \"151c\", \"Celebrations\") returns a set-level summary with guidance instead of a truncated card list \u2014 follow it to get_set_overview / set_species_summary for whole-set stats. Optional lang filters to one language track (en / ja / zh-cn); tracks are never mixed. Calls record usage and query metadata within POKEKA.",
 "inputSchema": {
  "properties": {
   "lang": {
    "description": "Optional language track filter.",
    "enum": [
     "en",
     "ja",
     "zh-cn"
    ],
    "type": "string"
   },
   "query": {
    "description": "Card name, nickname/slang, or set code + number. zh/en/ja all accepted.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_card",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "also_matched_sets": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "by_lang": {
    "type": "object"
   },
   "by_rarity": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "display_cjk": {
       "type": "string"
      },
      "display_en": {
       "type": "string"
      },
      "n": {
       "type": "number"
      },
      "tier": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "condition": {
    "description": "\"raw\" when the user asked for an ungraded card",
    "type": "string"
   },
   "entity_anchor": {
    "additionalProperties": true,
    "properties": {
     "found_in": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "nickname"
      ],
      "type": "string"
     },
     "term": {
      "description": "the dictionary term found inside the question",
      "type": "string"
     }
    },
    "type": "object"
   },
   "exact_match": {
    "description": "true only when set, number AND every other entity in the query (character, nickname, language) agree with the results",
    "type": "boolean"
   },
   "grading_filter": {
    "additionalProperties": true,
    "properties": {
     "additional_requests": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "company": {
         "type": "string"
        },
        "grade": {
         "type": "string"
        },
        "requested_tier": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "company": {
      "type": "string"
     },
     "grade": {
      "type": "string"
     },
     "requested_tier": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "guess_note": {
    "type": "string"
   },
   "guidance": {
    "type": "string"
   },
   "hint": {
    "type": "string"
   },
   "lang": {
    "type": "string"
   },
   "match_kind": {
    "description": "species | card_name | guess \u2014 guess means nothing matched and the results are prefix guesses, never price from them",
    "type": "string"
   },
   "mismatch": {
    "additionalProperties": true,
    "properties": {
     "matched_character": {
      "type": "string"
     },
     "matched_name": {
      "type": "string"
     },
     "requested_terms": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "qualifier_note": {
    "type": "string"
   },
   "qualifiers_dropped": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "query_constraint_note": {
    "type": "string"
   },
   "query_intent": {
    "enum": [
     "price"
    ],
    "type": "string"
   },
   "query_type": {
    "description": "\"set\" = the query was a bare set code/name; read guidance and use the set-level tools",
    "type": "string"
   },
   "rarity_filter": {
    "additionalProperties": true,
    "properties": {
     "requested": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "status": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "related_sets": {
    "description": "only when unambiguous: the set that carries the same collector name on the requested language track (the same release usually has a different set code per language). Absent when the name covers a whole era or product family rather than one release.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "lang": {
       "type": "string"
      },
      "set_code": {
       "type": "string"
      },
      "total_cards": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "result_count": {
    "type": "number"
   },
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "card_id": {
       "type": "string"
      },
      "card_number": {
       "type": "string"
      },
      "card_url": {
       "type": "string"
      },
      "character": {
       "description": "featured Pok\u00e9mon (EN species name)",
       "type": "string"
      },
      "dex_no": {
       "type": "number"
      },
      "finish_tiers": {
       "type": "string"
      },
      "gen_code": {
       "type": "string"
      },
      "image_url": {
       "type": "string"
      },
      "lang": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "rarity": {
       "description": "bilingual rarity bucket label",
       "type": "string"
      },
      "rarity_display": {
       "additionalProperties": true,
       "properties": {
        "cjk": {
         "description": "JP-style code (SR/RR/\u2026)",
         "type": "string"
        },
        "en": {
         "description": "official EN star-system name",
         "type": "string"
        }
       },
       "type": "object"
      },
      "rarity_tier": {
       "description": "machine rarity tier key (double_rare/ultra_rare/\u2026)",
       "type": "string"
      },
      "set_code": {
       "type": "string"
      },
      "set_name": {
       "type": "string"
      },
      "variant": {
       "description": "variant slot (master_ball/poke_ball/\u2026); absent for normal",
       "type": "string"
      },
      "variant_kind": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "safe_to_price": {
    "description": "true = results[0] can be priced without asking the user to confirm; false = candidates only",
    "type": "boolean"
   },
   "sample": {
    "items": {
     "additionalProperties": true,
