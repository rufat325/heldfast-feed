{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Edit one of the linked account's products, or unlist it. Pass its productId (from swop_list_my_products) plus ONLY the fields to change \u2014 anything omitted keeps its current value. To unlist it, set status to 'archived'. Confirm price and name changes with the user first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "New description",
    "maxLength": 2000,
    "type": "string"
   },
   "digitalDeliveryNote": {
    "description": "What a buyer receives",
    "maxLength": 500,
    "type": "string"
   },
   "extraImages": {
    "description": "Replaces the additional images. Requires image, since the full list is rewritten",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 9,
    "type": "array"
   },
   "image": {
    "description": "New primary image URL",
    "format": "uri",
    "type": "string"
   },
   "keywords": {
    "description": "Replaces the keywords",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "mintLimit": {
    "description": "New inventory available",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "name": {
    "description": "New product name",
    "maxLength": 120,
    "type": "string"
   },
   "priceUsd": {
    "description": "New price in USD (settles in USDC)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "productId": {
    "description": "The product id from swop_list_my_products",
    "type": "string"
   },
   "requiresShipping": {
    "description": "Collect a shipping address",
    "type": "boolean"
   },
   "royaltyPercentage": {
    "description": "Resale royalty percent",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "royaltyRecipient": {
    "description": "Wallet receiving royalties",
    "type": "string"
   },
   "shippingCost": {
    "description": "Flat shipping cost in USD",
    "minimum": 0,
    "type": "number"
   },
   "status": {
    "description": "Set 'archived' to unlist",
    "enum": [
     "active",
     "archived"
    ],
    "type": "string"
   },
   "variants": {
    "description": "Buyer-selectable options. Replaces the existing set when given.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Variant group, e.g. \"Color\" or \"Size\"",
       "minLength": 1,
       "type": "string"
      },
      "options": {
       "description": "Choices, e.g. [\"Black\",\"White\"]",
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "options"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "productId"
  ],
  "type": "object"
 },
 "name": "swop_update_product",
 "title": "Update or unlist a product"
}
