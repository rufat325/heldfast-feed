{
 "description": "Turn one keyword or page opportunity into an implementation-ready brief.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "current_rank": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "include_competitor_outlines": {
    "default": true,
    "type": "boolean"
   },
   "keyword": {
    "description": "Selected opportunity keyword",
    "type": "string"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "opportunity_type": {
    "enum": [
     "quick_win",
     "content_refresh",
     "ai_overview_opportunity",
     "featured_snippet_opportunity",
     "commercial_intent_opportunity",
     "lost_keyword_recovery",
     "competitor_gap"
    ],
    "type": "string"
   },
   "page_url": {
    "format": "uri",
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "description": "Target domain or URL",
    "type": "string"
   }
  },
  "required": [
   "keyword",
   "target"
  ],
  "type": "object"
 },
 "name": "agentseo_opportunities_brief",
 "title": "AgentSEO Opportunity Brief"
}
