{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Review Compose YAML before deploying. Public images or local builds and auxiliary files from one retained context_id. No remote build contexts, SSH, aliases, profiles, host privileges or external volumes/networks. Uploaded runtime files require an agent supporting compose-source-files-v1. Returns services, TCP port hints, variable names, changes and blockers without executing project code. Select web_service and target_port explicitly. Original published ports are removed; only the HTTP service joins the proxy and receives a loopback port. Names and volumes become deployment-specific. Use the returned analysis_id as compose_review_id with the same YAML/service/port/context_id in impreza_deploy_custom mode=compose after review. Never paste secrets: reference uppercase vars instead. This is a configuration review, not an executable stored plan or a health check. Never include credentials in source text: secret detection cannot inspect arbitrary source or configuration. Enter runtime secrets through the owner portal link.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "compose_yaml": {
    "maxLength": 65536,
    "minLength": 1,
    "type": "string"
   },
   "context_id": {
    "description": "Retained source upload for local build contexts and auxiliary files.",
    "pattern": "^ctx_[a-f0-9]{1,36}$",
    "type": "string"
   },
   "target_port": {
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "web_service": {
    "maxLength": 63,
    "type": "string"
   }
  },
  "required": [
   "compose_yaml"
  ],
  "type": "object"
 },
 "name": "impreza_prepare_compose",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "analysis_id": {
      "type": "string"
     },
     "auxiliary_files": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "changes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "environment_files": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "errors": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "path",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "parameters": {
      "type": [
       "object",
       "null"
      ]
     },
     "services": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "depends_on": {
         "type": "array"
        },
        "environment_names": {
         "type": "array"
        },
        "has_healthcheck": {
         "type": "boolean"
        },
        "image": {
         "type": [
          "string",
          "null"
         ]
        },
        "name": {
         "type": "string"
        },
        "tcp_ports": {
         "type": "array"
        },
        "volumes": {
         "type": "array"
        }
       },
       "required": [
        "name",
        "image",
        "tcp_ports",
        "environment_names",
        "depends_on",
        "volumes",
        "has_healthcheck"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "source_context_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_files": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "status": {
      "enum": [
       "blocked",
       "needs_input",
       "ready_for_review"
      ],
      "type": "string"
     },
     "target_port": {
      "type": [
       "integer",
       "null"
      ]
     },
     "unverified": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "variables": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "nonempty": {
         "type": "boolean"
        },
        "required": {
         "type": "boolean"
        },
        "services": {
         "type": "array"
        }
       },
       "required": [
        "name",
        "required",
        "nonempty",
        "services"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "volumes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "warnings": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "path",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "web_service": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "analysis_id",
     "status",
     "services",
     "volumes",
     "variables",
     "web_service",
     "target_port",
     "source_context_id",
     "source_files",
     "auxiliary_files",
     "environment_files",
     "changes",
     "warnings",
     "errors",
     "unverified",
     "parameters"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Review Compose deployment"
}
