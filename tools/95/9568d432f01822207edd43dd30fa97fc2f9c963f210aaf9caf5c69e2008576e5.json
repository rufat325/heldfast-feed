{
 "description": "Submit a project to AiList. When a user says \"list my project on AiList\", read their repo and call this with the details. The project goes live in minutes after auto-review. Requires AILIST_API_KEY env var \u2014 get a free key at hifriendbot.com/ai-list/submit/",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "built_with": {
    "description": "Technologies used (e.g. \"Node.js, TypeScript, Zod\")",
    "maxLength": 500,
    "type": "string"
   },
   "category": {
    "description": "Project category: mcp-server, cli-tool, library, web-app, api, plugin, model, dataset, agent, other",
    "enum": [
     "mcp-server",
     "cli-tool",
     "library",
     "web-app",
     "api",
     "plugin",
     "model",
     "dataset",
     "agent",
     "other"
    ],
    "type": "string"
   },
   "creator_name": {
    "description": "Creator or organization name",
    "maxLength": 200,
    "type": "string"
   },
   "creator_url": {
    "description": "Creator homepage or profile URL",
    "format": "uri",
    "type": "string"
   },
   "description": {
    "description": "Full project description (supports markdown)",
    "maxLength": 5000,
    "type": "string"
   },
   "github_url": {
    "description": "GitHub repository URL",
    "format": "uri",
    "type": "string"
   },
   "name": {
    "description": "Project name (required)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "npm_package": {
    "description": "npm package name (e.g. \"cogmemai-mcp\")",
    "maxLength": 200,
    "type": "string"
   },
   "pypi_package": {
    "description": "PyPI package name",
    "maxLength": 200,
    "type": "string"
   },
   "tagline": {
    "description": "Short tagline describing the project",
    "maxLength": 300,
    "type": "string"
   },
   "tags": {
    "description": "Comma-separated tags (e.g. \"memory, mcp, claude\")",
    "maxLength": 500,
    "type": "string"
   },
   "url": {
    "description": "Project homepage URL",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "submit_project"
}
