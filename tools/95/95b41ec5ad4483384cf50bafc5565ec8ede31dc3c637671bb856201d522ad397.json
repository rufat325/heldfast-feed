{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Add an inbound rule to a Network ACL",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "denyAllowGroupNo": {
    "description": "Deny-Allow Group number (alternative to ipBlock)",
    "type": "string"
   },
   "ipBlock": {
    "description": "IP block in CIDR format (e.g., 0.0.0.0/0)",
    "type": "string"
   },
   "networkAclNo": {
    "description": "Network ACL number",
    "type": "string"
   },
   "portRange": {
    "description": "Port range (e.g., 80, 1-65535)",
    "type": "string"
   },
   "priority": {
    "description": "Rule priority (1-199)",
    "type": "number"
   },
   "protocolTypeCode": {
    "description": "Protocol type code (TCP, UDP, ICMP)",
    "type": "string"
   },
   "ruleActionCode": {
    "description": "Rule action (ALLOW or DROP)",
    "type": "string"
   },
   "ruleDescription": {
    "description": "Description for the rule",
    "type": "string"
   }
  },
  "required": [
   "networkAclNo",
   "priority",
   "protocolTypeCode",
   "ruleActionCode"
  ],
  "type": "object"
 },
 "name": "ncloud_add_network_acl_inbound"
}
