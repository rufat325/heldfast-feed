{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Change settings in one call. The argument has the shape of the settings row that run_query schema=settings returns, and every field is optional: authMode (off, write or all); rateLimit {enabled, limit, windowSeconds}; audit (record the call trace); uiAuth (hide the desk pages until sign-in); protocols {stdio, streamableHttp, sse} (at least one stays on); events {enabled, types, autoTimer, autoSystem} (which events the server announces; types are names, groups such as ticket.* or *); toolGates {tool: true|false} (false disables a tool, not describe_server); toolAuthOverrides {tool: true|false} (true requires a credential for that tool even while auth is off); toolScopeOverrides {tool: read|write|pii|admin|default} (default restores the tool's own scope; admin tools, describe_server and generate_traffic cannot change). Only the fields you send change. Everything is checked first, and if any part is refused nothing is changed. MQTT has its own tool, set_mqtt. Requires admin even when auth mode is off, because it can change auth mode, the rate limit, the call trace, the page lock and who may call what. Then call run_query with schema=settings, or describe_server for the scopes and gates in force.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "audit": {
    "$ref": "#/properties/rateLimit/properties/enabled",
    "description": "true records a call trace, readable with run_query schema=trace."
   },
   "authMode": {
    "description": "off, write, or all.",
    "enum": [
     "off",
     "write",
     "all"
    ],
    "type": "string"
   },
   "events": {
    "additionalProperties": false,
    "description": "What the server announces to listeners.",
    "properties": {
     "autoSystem": {
      "$ref": "#/properties/rateLimit/properties/enabled",
      "description": "true (the default) lets watch_system switch on system.info itself."
     },
     "autoTimer": {
      "$ref": "#/properties/rateLimit/properties/enabled",
      "description": "true (the default) lets push_timer switch on the timer events itself."
     },
     "enabled": {
      "$ref": "#/properties/rateLimit/properties/enabled",
      "description": "true turns the event stream on (off by default)."
     },
     "types": {
      "description": "The kinds to announce, replacing the selection. Names, groups such as ticket.*, or *.",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "protocols": {
    "additionalProperties": false,
    "description": "Which transports answer. At least one must stay true.",
    "properties": {
     "sse": {
      "$ref": "#/properties/rateLimit/properties/enabled",
      "description": "true or false. The string \"0\" is false."
     },
     "stdio": {
      "$ref": "#/properties/rateLimit/properties/enabled",
      "description": "true or false. The string \"0\" is false."
     },
     "streamableHttp": {
      "$ref": "#/properties/rateLimit/properties/enabled",
      "description": "true or false. The string \"0\" is false."
     }
    },
    "type": "object"
   },
   "rateLimit": {
    "additionalProperties": false,
    "description": "The per-principal rate limit. Send only the parts to change.",
    "properties": {
     "enabled": {
      "description": "true or false. The string \"0\" is false.",
      "type": [
       "boolean",
       "string",
       "number"
      ]
     },
     "limit": {
      "description": "Calls allowed per window.",
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "windowSeconds": {
      "description": "Window length in seconds.",
      "exclusiveMinimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "toolAuthOverrides": {
    "additionalProperties": {
     "$ref": "#/properties/rateLimit/properties/enabled"
    },
    "description": "Tool name to true or false. true requires a credential for that tool even while auth is off.",
    "type": "object"
   },
   "toolGates": {
    "additionalProperties": {
     "$ref": "#/properties/rateLimit/properties/enabled"
    },
    "description": "Tool name to true or false. false disables that tool for everyone.",
    "type": "object"
   },
   "toolScopeOverrides": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Tool name to read, write, pii, admin, or default (restores the tool's own scope).",
    "type": "object"
   },
   "uiAuth": {
    "$ref": "#/properties/rateLimit/properties/enabled",
    "description": "true hides the desk HTML until an admin signs in. Tool calls stay up."
   }
  },
  "type": "object"
 },
 "name": "update_settings",
