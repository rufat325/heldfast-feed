{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Ingest repo"
 },
 "description": "Parse package.json, tailwind/vite config, route files, and existing tests via static analysis. No LLM call.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
