{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Select an OpenAPI operation and generate a safe request plan without executing it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "idempotency_key": {
    "description": "Stable key used to make a paid retry idempotent.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "method": {
    "description": "Optional HTTP method selector.",
    "type": "string"
   },
   "operation_id": {
    "description": "Preferred operationId selector.",
    "type": "string"
   },
   "path": {
    "description": "Optional path selector.",
    "type": "string"
   },
   "spec": {
    "description": "OpenAPI JSON document containing the operation to plan."
   }
  },
  "required": [
   "spec",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "plan_api_request",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "Safe request plan for a selected OpenAPI operation; no request is executed.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "error": {},
   "extensions": {},
   "operation": {},
   "request": {},
   "resource": {},
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Plan API request"
}
