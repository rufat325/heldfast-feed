{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an immutable purchase intent and exact plain-language quote. Returns the human review URL. Item price plus flat $8 shipping and $0 tax; no additional buyer API fees. Requires a configured X-Wever-Agent-Key. Boutique supports quantity 1 per unique catalog listing. Creates no payment and grants no approval. The independently authenticated human must approve the exact outcome on the review page.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "business_id": {
    "pattern": "^[a-z][a-z0-9-]{0,63}$",
    "type": "string"
   },
   "delivery_address": {
    "additionalProperties": false,
    "properties": {
     "city": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
     },
     "country": {
      "const": "US"
     },
     "line1": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
     },
     "line2": {
      "maxLength": 120,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
      "type": "string"
     },
     "postal_code": {
      "pattern": "^[0-9]{5}(-[0-9]{4})?$",
      "type": "string"
     },
     "state": {
      "enum": [
       "AL",
       "AK",
       "AZ",
       "AR",
       "CA",
       "CO",
       "CT",
       "DE",
       "DC",
       "FL",
       "GA",
       "HI",
       "ID",
       "IL",
       "IN",
       "IA",
       "KS",
       "KY",
       "LA",
       "ME",
       "MD",
       "MA",
       "MI",
       "MN",
       "MS",
       "MO",
       "MT",
       "NE",
       "NV",
       "NH",
       "NJ",
       "NM",
       "NY",
       "NC",
       "ND",
       "OH",
       "OK",
       "OR",
       "PA",
       "RI",
       "SC",
       "SD",
       "TN",
       "TX",
       "UT",
       "VT",
       "VA",
       "WA",
       "WV",
       "WI",
       "WY"
      ]
     }
    },
    "required": [
     "name",
     "line1",
     "line2",
     "city",
     "state",
     "postal_code",
     "country"
    ],
    "type": "object"
   },
   "idempotency_key": {
    "pattern": "^[A-Za-z0-9_-]{16,64}$",
    "type": "string"
   },
   "item_id": {
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "quantity": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "business_id",
   "item_id",
   "quantity",
   "delivery_address",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "wever_purchase-create-intent",
 "title": "purchase create intent"
}
