{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read a public article or YouTube URL and return only the passages relevant to your query, each anchored to its paragraph and labelled with the section it sits under. Use this instead of get_article whenever you have a specific question about a link \u2014 it answers in a fraction of the tokens and the anchors stay citable.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "minimum": 0,
    "type": "integer"
   },
   "max_passages": {
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "max_tokens": {
    "maximum": 25000,
    "minimum": 100,
    "type": "integer"
   },
   "query": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "format": "uri",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "required": [
   "url",
   "query"
  ],
  "type": "object"
 },
 "name": "search_article",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "author": {
    "type": [
     "string",
     "null"
    ]
   },
   "cache_hit": {
    "type": "boolean"
   },
   "content_quality": {
    "type": [
     "string",
     "null"
    ]
   },
   "extraction_source": {
    "type": "string"
   },
   "language": {
    "type": [
     "string",
     "null"
    ]
   },
   "matched_blocks": {
    "type": "number"
   },
   "next_cursor": {
    "type": [
     "number",
     "null"
    ]
   },
   "passages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "anchor": {
       "type": "number"
      },
      "rank": {
       "type": "number"
      },
      "score": {
       "type": "number"
      },
      "section": {
       "type": [
        "string",
        "null"
       ]
      },
      "text": {
       "type": "string"
      },
      "tokens": {
       "type": "number"
      }
     },
     "required": [
      "anchor",
      "section",
      "rank",
      "score",
      "tokens",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "published_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "publisher": {
    "type": [
     "string",
     "null"
    ]
   },
   "query": {
    "type": "string"
   },
   "reader_url": {
    "type": "string"
   },
   "responded_at": {
    "type": "string"
   },
   "source_url": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "tokens_returned": {
    "type": "number"
   },
   "total_blocks": {
    "type": "number"
   },
   "total_tokens": {
    "type": "number"
   }
  },
  "required": [
   "source_url",
   "reader_url",
   "title",
   "author",
   "publisher",
   "published_at",
   "language",
   "extraction_source",
   "content_quality",
   "cache_hit",
   "responded_at",
   "total_blocks",
   "total_tokens",
   "query",
   "matched_blocks",
   "tokens_returned",
   "next_cursor",
   "passages"
  ],
  "type": "object"
 },
 "title": "Find the passages of an article that answer a question"
}
