{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Seal the proof pack"
 },
 "description": "Hashes and closes the proof pack after the work is completed. Needs state WORK_COMPLETED. Never: Issue the invoice. Platform fee CHF 0.05 per accepted call: quote first, then send quote_id, mandate_token and idempotency_key.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "evidence": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "photo_before",
        "photo_after",
        "measurement",
        "material_list",
        "signature",
        "note"
       ],
       "type": "string"
      },
      "label": {
       "maxLength": 200,
       "type": "string"
      },
      "sha256": {
       "pattern": "^[0-9a-f]{64}$",
       "type": "string"
      }
     },
     "required": [
      "kind",
      "sha256"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   },
   "flow_id": {
    "description": "The flow (job) id, which is also its chain id.",
    "pattern": "^f_[A-Za-z0-9_-]{8,100}$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Required on every mutate and money call; a retry with the same key returns the same result and is not charged again.",
    "pattern": "^[\\x21-\\x7e]{1,100}$",
    "type": "string"
   },
   "mandate_token": {
    "description": "The mandate token from mandate.create.",
    "pattern": "^jfm_[A-Za-z0-9_-]{20,100}$",
    "type": "string"
   },
   "quote_id": {
    "description": "A valid quote for this capability (quote).",
    "pattern": "^q_[A-Za-z0-9_-]{8,100}$",
    "type": "string"
   }
  },
  "required": [
   "mandate_token",
   "flow_id",
   "evidence"
  ],
  "type": "object"
 },
 "name": "proof_seal",
 "title": "Seal the proof pack"
}
