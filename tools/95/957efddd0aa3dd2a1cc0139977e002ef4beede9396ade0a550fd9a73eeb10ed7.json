 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List your community members"
 },
 "description": "List your community members\n\nThe wallets in the token's community, with email, holder group, verification time and any handles they shared (X, Discord, Telegram, ENS, SNS). The token page's owner is listed first on page one. Owner or manager; wallet session only. Returns personal contact data of community members.\n\nNeeds Sign in with Chain Daddy (scope api:read).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "chain": {
    "description": "The token page's chain: a key (`base`, `arbitrum`, `solana`), a numeric chain id or CAIP-2. Required because a token id names a different token page on every chain; the role check and the data both stay on this chain.",
    "examples": [
     "base"
    ],
    "type": "string"
   },
   "id": {
    "description": "The token page's id (the registration's numeric token id)",
    "format": "int64",
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "default": "all",
    "enum": [
     "all",
     "verified",
     "unverified"
    ],
    "type": "string"
   },
   "tier": {
    "description": "A holder group id, or `all`",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "id"
  ],
  "type": "object"
 },
 "name": "list_community_members",
 "outputSchema": {
  "properties": {
   "members": {
    "items": {
     "properties": {
      "discord": {
       "type": [
        "string",
        "null"
       ]
      },
      "email": {
