{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Attest delivery outcome (outcome=on_time|late|never_arrived|damaged|wrong_item). Requires owning agent_id. Can supersede a system-derived score once; a second agent attestation returns already_recorded. Poor outcomes next\u2192order_dispute. Omit quality/carrier_rating if unknown.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_id": {
    "description": "Owning agent id (required for authorization)",
    "type": "string"
   },
   "carrier_rating": {
    "description": "Carrier rating 1-5 \u2014 omit if unknown; used in reputation when provided",
    "maximum": 5,
    "minimum": 1,
    "type": "number"
   },
   "notes": {
    "description": "Free-text delivery/quality notes",
    "type": "string"
   },
   "order_id": {
    "description": "Order id to attest",
    "type": "string"
   },
   "outcome": {
    "description": "Observed fulfillment outcome. Sets status (on_time/late\u2192DELIVERED, damaged/wrong_item\u2192DISPUTED, never_arrived\u2192FAILED) and reputation.",
    "enum": [
     "on_time",
     "late",
     "never_arrived",
     "damaged",
     "wrong_item"
    ],
    "type": "string"
   },
   "quality": {
    "description": "Product quality 1-5 \u2014 omit if unknown (do not invent)",
    "maximum": 5,
    "minimum": 1,
    "type": "number"
   },
   "search_id": {
    "description": "Optional search_id for analytics correlation",
    "type": "string"
   },
   "session_token": {
    "description": "Session token from agent_authenticate \u2014 required whenever agent_id is passed",
    "type": "string"
   }
  },
  "required": [
   "order_id",
   "agent_id",
   "outcome"
  ],
  "type": "object"
 },
 "name": "order_feedback",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "already_recorded": {
    "type": "boolean"
   },
   "detail": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "hint": {
    "type": "string"
   },
   "next": {
    "additionalProperties": false,
    "properties": {
     "args": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        }
       ]
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "tool": {
      "type": "string"
     }
    },
    "required": [
     "tool"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "order_id": {
    "type": "string"
   },
   "outcome": {},
   "status": {
    "type": "string"
   },
   "superseded": {
    "type": "boolean"
   },
   "updated": {}
  },
  "type": "object"
 },
 "title": "Submit feedback"
}
