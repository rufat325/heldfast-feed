{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing SLO correction's category, time range, or description",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Updated category",
    "enum": [
     "Scheduled Maintenance",
     "Outside Business Hours",
     "Deployment",
     "Other"
    ],
    "type": "string"
   },
   "description": {
    "description": "Updated description",
    "type": "string"
   },
   "duration": {
    "description": "Updated duration in seconds",
    "type": "number"
   },
   "end": {
    "description": "Updated ISO 8601 end time",
    "type": "string"
   },
   "rrule": {
    "description": "Updated recurrence rule",
    "type": "string"
   },
   "sloCorrectionId": {
    "description": "The SLO correction ID to update",
    "type": "string"
   },
   "start": {
    "description": "Updated ISO 8601 start time",
    "type": "string"
   },
   "timezone": {
    "description": "Updated timezone",
    "type": "string"
   }
  },
  "required": [
   "sloCorrectionId"
  ],
  "type": "object"
 },
 "name": "update-slo-correction"
}
