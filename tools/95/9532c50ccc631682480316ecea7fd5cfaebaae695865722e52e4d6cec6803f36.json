{
 "description": "Show line-by-line annotation of a file",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cwd": {
    "description": "Repository path",
    "type": "string"
   },
   "path": {
    "description": "File path to annotate",
    "type": "string"
   },
   "rev": {
    "description": "Revision to blame at",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "sl_blame"
}
