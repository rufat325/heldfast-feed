{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Print a public web page to PDF with real Chrome. Returns title, page count, size, a direct download URL and (include_base64=true) the PDF bytes as base64.",
 "inputSchema": {
  "properties": {
   "format": {
    "default": "A4",
    "enum": [
     "A4",
     "Letter",
     "Legal",
     "A3",
     "A5",
     "Tabloid"
    ],
    "type": "string"
   },
   "include_base64": {
    "default": false,
    "type": "boolean"
   },
   "landscape": {
    "default": false,
    "type": "boolean"
   },
   "page_numbers": {
    "default": false,
    "type": "boolean"
   },
   "url": {
    "description": "Public http(s) URL or bare domain",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "url_to_pdf",
 "title": "Web page to PDF"
}
