{
 "description": "Upload a file attachment for use in a conversation message.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "attachmentUrl": {
    "description": "Public URL of the file to upload",
    "type": "string"
   },
   "conversationId": {
    "description": "Conversation ID to attach the file to",
    "type": "string"
   },
   "locationId": {
    "description": "Location ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "conversationId",
   "locationId",
   "attachmentUrl"
  ],
  "type": "object"
 },
 "name": "crm_upload_message_attachment"
}
