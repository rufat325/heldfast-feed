{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get label version history"
 },
 "description": "List every published version (spl_version + published_date) of a label for a SETID \u2014 useful to see how a drug's labeling has changed over time. DailyMed v2: GET /spls/{setid}/history.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "page": {
    "description": "Page number (1-based). Default 1.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "pagesize": {
    "description": "Results per page (max 100). Default 100.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "setid": {
    "description": "The label SETID (UUID).",
    "pattern": "^[0-9a-fA-F-]{36}$",
    "type": "string"
   }
  },
  "required": [
   "setid"
  ],
  "type": "object"
 },
 "name": "dailymed_label_history",
 "title": "Get label version history"
}
