{
 "description": "Create a Runway Aleph task on RunAPI (edit video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "enum": [
     "16:9",
     "9:16",
     "4:3",
     "3:4",
     "1:1",
     "21:9"
    ],
    "type": "string"
   },
   "callback_url": {
    "type": "string"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "runway-aleph"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "reference_image_url": {
    "type": "string"
   },
   "seed": {
    "type": "number"
   },
   "source_video_url": {
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   },
   "watermark": {
    "type": "string"
   }
  },
  "required": [
   "prompt",
   "source_video_url"
  ],
  "type": "object"
 },
 "name": "edit_video"
}
