{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "SummarizeCampaignWindow summarises one charge against the campaigns in its billing window. Results are cached per company + account + window + charge, so repeated panel opens do not re-run the agent.",
 "inputSchema": {
  "properties": {
   "accountId": {
    "maxLength": 64,
    "type": "string"
   },
   "chargeAmount": {
    "maxLength": 30,
    "pattern": "^(-?[0-9]+(\\.[0-9]{1,4})?)?$",
    "type": "string"
   },
   "companyId": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "periodEnd": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "periodStart": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "provider": {
    "enum": [
     "PROVIDER_PLAID",
     "PROVIDER_STRIPE",
     "PROVIDER_RAMP",
     "PROVIDER_GOOGLE_ADS",
     "PROVIDER_META_ADS",
     "PROVIDER_MERCURY",
     "PROVIDER_GMAIL",
     "PROVIDER_SLACK",
     "PROVIDER_TIKTOK_ADS",
     "PROVIDER_SHOPIFY",
     "PROVIDER_HUBSPOT",
     "PROVIDER_X_ADS",
     "PROVIDER_DOCUSIGN"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ads_insight_summarize_campaign_window",
 "outputSchema": {
  "properties": {
   "cached": {
    "type": "boolean"
   },
   "generatedAt": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "highlights": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "summary": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Summarize Campaign Window"
}
