{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search leads you can see: your own plus the unclaimed pool. Filter by name/phone text, status, industry, city or minimum lead score.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "city": {
    "type": "string"
   },
   "industry": {
    "description": "Partial match, e.g. \"hvac\" or \"dental\".",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_score": {
    "description": "Pipeline lead score, 1-5.",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "scope": {
    "default": "all",
    "enum": [
     "all",
     "mine",
     "unclaimed"
    ],
    "type": "string"
   },
   "search": {
    "description": "Text to match in business name, contact name or phone.",
    "type": "string"
   },
   "status": {
    "enum": [
     "cold",
     "contacted",
     "shadow_trial",
     "trial_active",
     "won",
     "lost"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_leads",
 "title": "Find leads"
}
