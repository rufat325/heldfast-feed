{
 "description": "Publish or unpublish a side page. Set published=true to make it live, false to pull it back to draft.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "published": {
    "description": "true = publish, false = unpublish",
    "type": "boolean"
   },
   "sideKey": {
    "description": "Side page key",
    "type": "string"
   },
   "slug": {
    "description": "Parent landing page slug",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "sideKey",
   "published"
  ],
  "type": "object"
 },
 "name": "set_side_page_state"
}
