{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Move or delete EVERY message from a sender (exact address) in a folder (Inbox by default). Use `dryRun: true` first to learn how many messages match. Deletion goes to Deleted Items unless `permanent: true`.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"action":{"description":"move = move to targetFolder; delete = delete","enum":["move","delete"],"type":"string"},"dryRun":{"default":false,"description":"true = count only, change nothing","type":"boolean"},"folder":{"description":"Source folder. Default: inbox","type":"string"},"from":{"description":"Exact sender address","format":"email","pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"permanent":{"default":false,"description":"With action = delete: permanent deletion","type":"boolean"},"targetFolder":{"description":"Required when action = move","type":"string"}},"required":["from","action"],"type":"object"},"name":"mail_bulk_by_sender","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"dryRun":{"type":"boolean"},"failed":{"items":{"additionalProperties":false,"properties":{"error":{"type":"string"},"id":{"type":"string"}},"required":["id","error"],"type":"object"},"type":"array"},"matched":{"type":"number"},"succeeded":{"type":"number"}},"required":["matched","dryRun","succeeded","failed"],"type":"object"},"title":"Bulk action by sender"}
