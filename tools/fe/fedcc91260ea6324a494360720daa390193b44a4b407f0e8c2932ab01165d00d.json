    "properties": {
     "w1": {
      "type": "number"
     },
     "w2": {
      "type": "number"
     },
     "w3": {
      "type": "number"
     },
     "w4": {
      "type": "number"
     }
    },
    "required": [
     "w1",
     "w2",
     "w3",
     "w4"
    ],
    "type": "object"
   }
  },
  "required": [
   "title",
   "scores",
   "weights",
   "weightedValue",
   "weightedCost",
   "formula",
   "priority",
   "rank",
   "of",
   "target"
  ],
  "type": "object"
 }
}
