     "reached",
     "priorityToBeat",
     "options"
    ],
    "type": "object"
   },
   "title": {
    "type": "string"
   },
   "weightedCost": {
    "description": "w3 \u00d7 estimate + w4 \u00d7 risk",
    "type": "number"
   },
   "weightedValue": {
    "description": "w1 \u00d7 benefit + w2 \u00d7 penalty",
    "type": "number"
   },
   "weights": {
