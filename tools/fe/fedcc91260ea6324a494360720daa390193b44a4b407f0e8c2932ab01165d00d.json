{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Explain one ticket's priority: the formula with its scores and the project's weights, its rank among the open tickets (not state:done) as calc_priority ranks, and what it would take to reach the top N: the priority to beat, and the smallest change of each single score that gets there.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "tag": {
    "description": "Rank only among tickets with this tag (prefix:value); the ticket must have it",
    "type": "string"
   },
   "tags": {
    "description": "Rank only among tickets with all of these tags (intersection, also with tag); the ticket must have them. Each as prefix:value",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Ticket title",
    "type": "string"
   },
   "top": {
    "description": "The rank to reach (default 1)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "explain_priority",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "formula": {
    "type": "string"
   },
   "of": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "priority": {
    "type": "number"
   },
   "rank": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "scores": {
    "additionalProperties": false,
    "properties": {
     "benefit": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "estimate": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "penalty": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "risk": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "benefit",
     "penalty",
     "estimate",
     "risk"
    ],
    "type": "object"
   },
   "target": {
    "additionalProperties": false,
    "properties": {
     "options": {
      "description": "The smallest change of one score that reaches the rank, per score where one does",
      "items": {
       "additionalProperties": false,
       "properties": {
        "dimension": {
         "enum": [
          "benefit",
          "penalty",
          "estimate",
          "risk"
         ],
         "type": "string"
        },
        "from": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "priority": {
         "type": "number"
        },
        "rank": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "to": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        }
       },
       "required": [
        "dimension",
        "from",
        "to",
        "priority",
        "rank"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "priorityToBeat": {
      "description": "Priority of the ticket holding that rank now",
      "type": [
       "number",
       "null"
      ]
     },
     "reached": {
      "type": "boolean"
     },
     "top": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
