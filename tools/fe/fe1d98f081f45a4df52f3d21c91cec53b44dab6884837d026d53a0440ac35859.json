{
 "description": "Return a workpaper including its rendered Markdown.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "workpaperId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "workpaperId"
  ],
  "type": "object"
 },
 "name": "get_workpaper",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "found": {
    "type": "boolean"
   },
   "workpaper": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "found",
   "workpaper"
  ],
  "type": "object"
 },
 "title": "Get a workpaper"
}
