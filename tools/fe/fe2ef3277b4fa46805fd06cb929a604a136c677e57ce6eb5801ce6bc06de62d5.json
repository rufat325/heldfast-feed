{
 "description": "Search GeraPersona for voice/personality skins a user can install on a robot, Alexa, GeraVoice, Claude-desktop, or any AI agent with a voice interface. Supports filters on language, gender, age range, mood, compatible device, price band, minimum rating. Results are APPROVED personas only (pending/rejected are hidden).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ageRange": {
    "description": "e.g. \"child\", \"adult\", \"elder\"",
    "maxLength": 50,
    "type": "string"
   },
   "category": {
    "description": "Category slug",
    "maxLength": 100,
    "type": "string"
   },
   "compatibleDevice": {
    "description": "Device identifier the persona must support, e.g. \"unitree-g1\", \"alexa\", \"claude-desktop\", \"elevenlabs\"",
    "maxLength": 100,
    "type": "string"
   },
   "gender": {
    "maxLength": 50,
    "type": "string"
   },
   "language": {
    "description": "ISO 639-1 language code, e.g. \"en\", \"es\", \"fr\", \"ar\"",
    "maxLength": 10,
    "type": "string"
   },
   "maxPriceGbpPence": {
    "maximum": 1000000,
    "type": "integer"
   },
   "minPriceGbpPence": {
    "minimum": 0,
    "type": "integer"
   },
   "minRating": {
    "maximum": 5,
    "minimum": 0,
    "type": "number"
   },
   "mood": {
    "description": "e.g. \"calm\", \"warm\", \"energetic\", \"formal\", \"playful\", \"wise\"",
    "maxLength": 50,
    "type": "string"
   },
   "page": {
    "default": 1,
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "integer"
   },
   "pageSize": {
    "default": 20,
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "query": {
    "description": "Free-text search across name + bio",
    "maxLength": 200,
    "type": "string"
   },
   "sort": {
    "enum": [
     "new",
     "top",
     "price_asc",
     "price_desc",
     "rating"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_personas"
}
