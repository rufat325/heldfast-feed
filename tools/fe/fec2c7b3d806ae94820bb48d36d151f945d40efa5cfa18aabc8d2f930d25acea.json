{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Link one or more test cases to a test cycle so they appear in its execution list. Pass the cycle's internal id and an array of { id, versionNo } pairs (id is the test case internal UID; versionNo is usually 1).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Test cycle internal ID",
    "type": [
     "string",
     "number"
    ]
   },
   "sort": {
    "description": "Sort, e.g. \"key:ASC\"",
    "type": "string"
   },
   "testCases": {
    "description": "Test cases to link",
    "items": {
     "properties": {
      "id": {
       "description": "Test case internal UID",
       "type": "string"
      },
      "versionNo": {
       "description": "Test case version, usually 1",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "id",
      "versionNo"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "testCases"
  ],
  "type": "object"
 },
 "name": "qtm4j_link_test_cases_to_cycle",
 "title": "Link Test Cases to Test Cycle"
}
