{
 "description": "Get contextual discovery questions using MEDDPICC, BANT, SPICED, or custom frameworks. Questions adapt based on what you already know about the prospect.",
 "inputSchema": {
  "properties": {
   "deal_stage": {
    "description": "Stage of conversation",
    "enum": [
     "first_call",
     "discovery",
     "deep_dive",
     "technical",
     "executive"
    ],
    "type": "string"
   },
   "framework": {
    "description": "Discovery framework to use",
    "enum": [
     "meddpicc",
     "bant",
     "spiced",
     "challenger",
     "gap_selling",
     "all"
    ],
    "type": "string"
   },
   "gaps_to_fill": {
    "description": "Specific information gaps to address",
    "type": "string"
   },
   "known_metrics": {
    "description": "Metrics/KPIs already discussed",
    "type": "string"
   },
   "known_pain_points": {
    "description": "Pain points already identified",
    "type": "string"
   },
   "prospect_industry": {
    "description": "Prospect industry for context",
    "type": "string"
   },
   "prospect_role": {
    "description": "Role of person you are meeting with",
    "type": "string"
   },
   "your_solution": {
    "description": "Your product/solution for relevant questions",
    "type": "string"
   }
  },
  "required": [
   "framework"
  ],
  "type": "object"
 },
 "name": "discovery_question_bank"
}
