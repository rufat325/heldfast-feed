{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Project"
 },
 "description": "WHEN TO USE: To create a new brand monitoring project. RETURNS: Created project object with generated id. NEXT STEP: Call lbm_run_scan to start monitoring.",
 "inputSchema": {
  "properties": {
   "auto_monitoring": {
    "description": "Optional auto monitoring config",
    "properties": {
     "enabled": {
      "description": "Enable auto monitoring",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "brand_name": {
    "description": "Brand name to monitor (required)",
    "type": "string"
   },
   "domain": {
    "description": "Brand domain (required, e.g. \"example.com\")",
    "type": "string"
   },
   "language": {
    "description": "2-letter ISO language code (required, e.g. \"en\", \"uk\")",
    "type": "string"
   },
   "location": {
    "description": "Country name, 2-letter ISO code, or \"auto\" (required)",
    "type": "string"
   },
   "models": {
    "description": "LLM model IDs to monitor (required). Call lbm_list_models to get available IDs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "project_name": {
    "description": "Project name (required)",
    "type": "string"
   },
   "prompts": {
    "description": "Array of monitoring prompts (required)",
    "items": {
     "properties": {
      "tags": {
       "description": "Optional tags",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "text": {
       "description": "The prompt text",
       "type": "string"
      }
     },
     "required": [
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "project_name",
   "brand_name",
   "domain",
   "language",
   "location",
   "models",
   "prompts"
  ],
  "type": "object"
 },
 "name": "lbm_create_project"
}
