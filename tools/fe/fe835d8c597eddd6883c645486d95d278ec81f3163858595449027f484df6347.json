{
 "description": "Approve a pending sequence execution. Requires the workspace to have send_consent_at set. Cron will dispatch after approval.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approved_by": {
    "description": "Approving user id",
    "format": "uuid",
    "type": "string"
   },
   "execution_id": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "execution_id",
   "approved_by"
  ],
  "type": "object"
 },
 "name": "tap_approve_execution"
}
