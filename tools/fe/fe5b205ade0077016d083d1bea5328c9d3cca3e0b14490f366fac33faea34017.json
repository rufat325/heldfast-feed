{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Gets daily, weekly, 30-day, and historical weekly-rank statistics for a Binance TradFi perpetual from official Binance klines.",
