  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "symbol": {
    "description": "Binance USD\u24c8-M perpetual symbol, for example TSLAUSDT",
    "maxLength": 24,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "get_perp_stats",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "change_1d_pct": {
    "type": "number"
   },
   "change_30d_pct": {
    "type": "number"
   },
   "change_7d_pct": {
    "type": "number"
   },
   "data_date": {
    "type": "string"
   },
   "last_close": {
    "type": "number"
   },
   "source_urls": {
