    },
    "type": "array"
   },
   "symbol": {
    "type": "string"
   },
   "week_rank": {
    "additionalProperties": true,
    "properties": {
     "of": {
      "type": "number"
     },
     "rank": {
      "type": "number"
     },
     "since": {
      "type": "string"
     }
    },
    "required": [
     "rank",
     "of",
     "since"
    ],
    "type": "object"
   }
  },
  "required": [
   "symbol",
   "data_date",
   "last_close",
   "change_1d_pct",
   "change_7d_pct",
   "change_30d_pct",
   "week_rank",
   "source_urls"
