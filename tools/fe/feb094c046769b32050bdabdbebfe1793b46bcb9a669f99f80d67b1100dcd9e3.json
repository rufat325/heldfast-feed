{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Aggregate federal contract spending by NAICS, PSC, recipient, or awarding agency over a date range, optionally filtered by keywords/NAICS/agency - market sizing in one call (\"top contractors in NAICS 541512 last year\", \"which agencies buy the most cybersecurity\"). Keyless.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agency_name": {
    "type": "string"
   },
   "category": {
    "enum": [
     "naics",
     "psc",
     "recipient",
     "awarding_agency"
    ],
    "type": "string"
   },
   "end_date": {
    "description": "YYYY-MM-DD (default: today)",
    "type": "string"
   },
   "keywords": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Top N (default 10)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "naics_codes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "start_date": {
    "description": "YYYY-MM-DD (default: 1 year ago)",
    "type": "string"
   }
  },
  "required": [
   "category"
  ],
  "type": "object"
 },
 "name": "spending_by_category",
 "title": "Federal spending rollups"
}
