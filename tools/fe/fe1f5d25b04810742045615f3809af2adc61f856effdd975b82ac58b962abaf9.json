{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run a LinkedIn Sales Navigator search, store a point-in-time contact snapshot, and return contact list metadata.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "__requestBody": {
    "additionalProperties": {},
    "description": "Request body",
    "properties": {
     "filters": {
      "additionalProperties": {},
      "description": "Search filters stored on a contact list",
      "properties": {
       "companyLinkedInUrls": {
        "description": "LinkedIn company URLs to scope the search. Supports multiple companies. Omit to search across all companies.",
        "example": [
         "https://www.linkedin.com/company/stripe"
        ],
        "items": {
         "format": "uri",
         "type": "string"
        },
        "type": "array"
       },
       "countries": {
        "description": "Countries to filter by (ISO 3166-1 alpha-2 codes)",
        "example": [
         "US",
         "GB"
        ],
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "jobTitles": {
        "description": "Job titles to filter contacts by",
        "example": [
         "Engineering Manager",
         "VP Engineering"
        ],
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "keywords": {
        "description": "Keywords to search for in contact profiles",
        "example": "Kubernetes",
        "type": "string"
       }
      },
      "type": "object"
     },
     "name": {
      "description": "Display name for the contact list",
      "example": "Engineering leads at Stripe",
      "maxLength": 200,
      "type": "string"
     }
    },
    "required": [
     "name",
     "filters"
    ],
    "type": "object"
   }
  },
  "required": [
   "__requestBody"
  ],
  "type": "object"
 },
 "name": "contact_lists-create"
}
