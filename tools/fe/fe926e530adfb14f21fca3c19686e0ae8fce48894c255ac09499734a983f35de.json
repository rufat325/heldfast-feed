  "additionalProperties": false,
  "properties": {
   "dueOn": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "engagementId": {
    "format": "uuid",
    "type": "string"
   },
   "scopeItemId": {
    "$ref": "#/properties/engagementId"
   }
  },
  "required": [
   "engagementId",
   "scopeItemId",
   "dueOn"
  ],
  "type": "object"
 },
 "name": "save_deadline",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
