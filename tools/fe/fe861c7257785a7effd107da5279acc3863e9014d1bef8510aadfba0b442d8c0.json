{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Rename a tutorial or change its voice"
 },
 "description": "Use this when someone wants to rename a tutorial or change the default voice of its narration. Returns the updated tutorial; fields left out keep their values, and repeating the same values changes nothing. Not for editing narration text.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "defaultVoice": {
    "description": "New default voice id for synthesized narration",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "New tutorial name, up to 200 characters",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "tutorialId": {
    "description": "Tutorial to edit",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "tutorialId"
  ],
  "type": "object"
 },
 "name": "update_tutorial",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "enum": [
     "updated",
     "unchanged",
     "not-found"
    ],
    "type": "string"
   },
   "tutorial": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultVoice": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "projectId": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "projectId",
       "defaultVoice",
       "creationTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "status",
   "tutorial"
  ],
  "type": "object"
 },
 "title": "Rename a tutorial or change its voice"
}
