{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add a team member"
 },
 "description": "Adds a person to the connected Nexwin account's team without a login, so bookings can be made with them. Nobody is emailed. Use invite_team_member instead if they need to sign in. Set isInternalOnly for someone callers should never be told about by name. Returns the new teamMemberId.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "email": {
    "description": "Optional; kept on their profile",
    "format": "email",
    "type": "string"
   },
   "firstName": {
    "minLength": 1,
    "type": "string"
   },
   "isInternalOnly": {
    "description": "true hides this person's name from callers",
    "type": "boolean"
   },
   "lastName": {
    "minLength": 1,
    "type": "string"
   },
   "timezone": {
    "description": "IANA timezone, e.g. Australia/Sydney (the default)",
    "type": "string"
   }
  },
  "required": [
   "firstName",
   "lastName"
  ],
  "type": "object"
 },
 "name": "add_team_member",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_environment": {
    "description": "The Nexwin country and environment that supplied the result",
    "type": "string"
   },
   "invited": {
    "type": "boolean"
   },
   "message": {
    "type": [
     "string",
     "null"
    ]
   },
   "success": {
    "type": "boolean"
   },
   "teamMemberId": {
    "type": "string"
   }
  },
  "required": [
   "_environment",
   "success",
   "message"
  ],
  "type": "object"
 },
 "title": "Add a team member"
}
