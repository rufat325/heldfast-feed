                "null"
               ]
              },
              "name": {
               "description": "Parameter name.",
               "type": "string"
              },
              "required": {
               "description": "Whether the tool requires this parameter.",
               "type": "boolean"
              },
              "type": {
               "description": "JSON scalar type, or null when unspecified.",
               "type": [
                "string",
                "null"
               ]
              }
             },
             "required": [
              "name",
              "type",
              "required",
              "description"
             ],
             "type": "object"
            },
            "type": "array"
           },
           "title": {
            "description": "Human title, when distinct from name.",
            "type": [
             "string",
             "null"
            ]
           },
           "tokenEstimate": {
            "description": "Approximate context tokens this tool's definition costs.",
            "type": "integer"
           }
          },
          "required": [
