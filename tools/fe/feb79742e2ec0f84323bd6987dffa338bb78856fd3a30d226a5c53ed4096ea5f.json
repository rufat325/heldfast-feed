        "additionalProperties": false,
        "properties": {
         "component": {
          "description": "Channel slug.",
          "type": "string"
         },
         "score": {
          "description": "That channel's score.",
          "type": [
           "integer",
           "null"
          ]
         },
         "type": {
          "description": "Ecosystem.",
          "type": "string"
         },
         "url": {
          "description": "Canonical page.",
          "type": "string"
         }
        },
        "required": [
         "component",
         "type",
         "score",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "slug": {
       "description": "Stable verifymcp identifier.",
       "type": "string"
      },
      "status": {
       "description": "Scoring status.",
       "type": [
        "string",
        "null"
       ]
      },
      "statusMessage": {
       "description": "The registry's stated reason for a deprecated or deleted status, quoted from the publisher. Null when none was given, which is always the case while active.",
       "type": [
        "string",
        "null"
       ]
      },
      "tools": {
