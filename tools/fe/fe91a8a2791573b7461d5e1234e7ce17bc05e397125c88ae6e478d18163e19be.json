{
 "description": "Generate production-ready forms with validation schemas, accessible markup, error handling, and multi-step support. Includes preset form types (login, signup, contact, checkout) or fully custom field definitions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brand_identity": {
    "description": "JSON from branding-mcp generate_brand_identity. Overrides design context with brand tokens.",
    "type": "string"
   },
   "component_library": {
    "default": "none",
    "description": "Component library styling",
    "enum": [
     "shadcn",
     "radix",
     "headlessui",
     "material",
     "none"
    ],
    "type": "string"
   },
   "dark_mode": {
    "default": false,
    "description": "Include dark mode classes",
    "type": "boolean"
   },
   "fields": {
    "description": "Custom field definitions. Required for \"custom\" type, optional override for presets.",
    "items": {
     "properties": {
      "label": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "options": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "placeholder": {
       "type": "string"
      },
      "required": {
       "type": "boolean"
      },
      "type": {
       "enum": [
        "text",
        "email",
        "password",
        "number",
        "tel",
        "url",
        "textarea",
        "select",
        "checkbox",
        "radio",
        "date",
        "file"
       ],
       "type": "string"
      },
      "validation": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "type",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "form_type": {
    "description": "Type of form to generate",
    "enum": [
     "login",
     "signup",
     "contact",
     "checkout",
     "settings",
     "search",
     "newsletter",
     "custom"
    ],
    "type": "string"
   },
   "framework": {
    "description": "Target framework",
    "enum": [
     "react",
     "nextjs",
     "vue",
     "angular",
     "svelte",
     "html"
    ],
    "type": "string"
   },
   "industry": {
    "description": "Target industry",
    "enum": [
     "saas",
     "fintech",
     "ecommerce",
     "healthcare",
     "education",
     "startup",
     "agency",
     "media",
     "devtools",
     "general"
    ],
    "type": "string"
   },
   "mood": {
    "description": "Design mood",
    "enum": [
     "bold",
     "calm",
     "playful",
     "professional",
     "premium",
     "energetic",
     "minimal",
     "editorial",
     "futuristic",
     "warm",
     "corporate",
     "creative"
    ],
    "type": "string"
   },
   "multi_step": {
    "default": false,
    "description": "Split into multi-step form with progress",
    "type": "boolean"
   },
   "validation_library": {
    "default": "zod",
    "description": "Validation library for schema generation",
    "enum": [
     "zod",
     "yup",
     "none"
    ],
    "type": "string"
   },
   "visual_style": {
    "description": "Visual style",
    "enum": [
     "glassmorphism",
     "neubrutalism",
     "soft-depth",
     "bento-grid",
     "gradient-mesh",
     "dark-premium",
     "minimal-editorial",
     "linear-modern",
     "retro-playful",
     "corporate-trust"
    ],
    "type": "string"
   }
  },
  "required": [
   "form_type",
   "framework"
  ],
  "type": "object"
 },
 "name": "generate_form"
}
