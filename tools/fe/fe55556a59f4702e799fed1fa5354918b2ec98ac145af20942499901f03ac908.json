{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Simulate paying off several debts with minimum payments plus an optional extra each month, highest rate first (avalanche) and smallest balance first (snowball), against minimums only. Returns months to debt-free and total interest for each. Use for \"avalanche or snowball on my debts\" and \"what does $200 extra a month do\".",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "debts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "annual_rate_pct": {
       "maximum": 1000,
       "minimum": 0,
       "type": "number"
      },
      "balance": {
       "exclusiveMinimum": 0,
       "maximum": 10000000,
       "type": "number"
      },
      "min_payment": {
       "description": "Minimum monthly payment, held fixed",
       "exclusiveMinimum": 0,
       "maximum": 10000000,
       "type": "number"
      },
      "name": {
       "maxLength": 40,
       "type": "string"
      }
     },
     "required": [
      "balance",
      "annual_rate_pct",
      "min_payment"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   },
   "extra_per_month": {
    "description": "Extra paid each month on top of all minimums, in dollars",
    "maximum": 100000,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "debts"
  ],
  "type": "object"
 },
 "name": "debt_payoff_plan",
 "title": "Pay off several debts: avalanche, snowball or minimums"
}
