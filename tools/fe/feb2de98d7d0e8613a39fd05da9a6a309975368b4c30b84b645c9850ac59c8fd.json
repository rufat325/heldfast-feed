{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "FREE deterministic technical SEO audit of supplied same-site snapshots. Compact summary, stable issue IDs and bounded evidence pagination. No remote crawl, model, rankings, credentials or charge. Prefer local crawler reports to keep raw HTML outside model prompts.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "capturedAt": {
    "maxLength": 100,
    "type": "string"
   },
   "coverage": {
    "additionalProperties": false,
    "properties": {
     "discoveredUrls": {
      "minimum": 0,
      "type": "integer"
     },
     "refreshRequestedUrls": {
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     },
     "robotsStatus": {
      "maxLength": 100,
      "type": "string"
     },
     "sitemapDiscovery": {
      "additionalProperties": false,
      "properties": {
       "discoveredPageUrls": {
        "maximum": 200,
        "minimum": 0,
        "type": "integer"
       },
       "excludedEntries": {
        "minimum": 0,
        "type": "integer"
       },
       "limited": {
        "type": "boolean"
       },
       "pendingSitemaps": {
        "maximum": 200,
        "minimum": 0,
        "type": "integer"
       },
       "sitemapsAttempted": {
        "maximum": 5,
        "minimum": 0,
        "type": "integer"
       },
       "sitemapsBlocked": {
        "maximum": 200,
        "minimum": 0,
        "type": "integer"
       },
       "sitemapsEnabled": {
        "type": "boolean"
       },
       "sitemapsFailed": {
        "maximum": 5,
        "minimum": 0,
        "type": "integer"
       },
       "sitemapsRead": {
        "maximum": 5,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [],
      "type": "object"
     },
     "stopReason": {
      "maxLength": 100,
      "type": "string"
     }
    },
    "required": [],
    "type": "object"
   },
   "detail": {
    "default": "summary",
    "enum": [
     "summary",
     "evidence"
    ],
    "type": "string"
   },
   "group": {
    "maxLength": 100,
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "maximum": 20000,
    "minimum": 0,
    "type": "integer"
   },
   "pageUrl": {
    "maxLength": 2048,
    "type": "string"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "crawlStatus": {
       "enum": [
        "fetched",
        "robots-blocked",
        "failed",
        "skipped"
       ],
       "type": "string"
      },
      "headers": {
       "additionalProperties": false,
       "properties": {
        "content-type": {
         "maxLength": 256,
         "type": "string"
        },
        "x-robots-tag": {
         "maxLength": 2048,
         "type": "string"
        }
       },
       "required": [],
       "type": "object"
      },
      "html": {
       "maxLength": 100000,
       "type": "string"
      },
      "status": {
       "maximum": 599,
       "minimum": 100,
       "type": "integer"
      },
      "url": {
       "maxLength": 2048,
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "previousIssueIds": {
    "items": {
     "maxLength": 250,
     "type": "string"
    },
    "maxItems": 200,
    "type": "array"
   },
   "siteUrl": {
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "siteUrl",
   "pages"
  ],
  "type": "object"
 },
 "name": "agent_utilities_seo_audit"
}
