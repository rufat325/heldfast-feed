{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "stories:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Permanently delete a story owned by the connected account. This cannot be undone.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "confirmPermanentDeletion": {
    "const": true,
    "description": "True only after the user explicitly confirmed permanent deletion of this story.",
    "type": "boolean"
   },
   "storyId": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "storyId",
   "confirmPermanentDeletion"
  ],
  "type": "object"
 },
 "name": "delete_story",
 "title": "Permanently Delete My Story"
}
