{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Create a deposit to add funds to the prepaid balance with crypto. Returns the exact amount to send, the network, the address and the deadline, plus the payment window in the VoidMob dashboard where the user can check the address. Payment comes from a crypto wallet: the user's, or their own automation's. The balance goes up once the payment confirms, and any extra is credited too. It spends nothing, so it needs no purchase approval, but ask the user which coin and how much unless they said. Keep at most one open deposit: check get_deposit first and reuse one that still takes payments. After a purchase is refused for a low balance, offer a deposit rather than creating one.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"amount_cents":{"description":"Amount to add in US cents (2000 = $20.00). Each coin has a minimum (get_deposit lists them).","maximum":1000000,"minimum":1,"type":"integer"},"coin":{"description":"Coin id from get_deposit (e.g. 'ltc', 'btc', 'usdt_trc20')","maxLength":40,"minLength":2,"type":"string"}},"required":["coin","amount_cents"],"type":"object"},"name":"create_deposit","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"deposit":{"additionalProperties":{},"properties":{"address":{"type":"string"},"amount_cents":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"asset":{"type":"string"},"bonus_cents":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"coin":{"type":"string"},"confirmations":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"created_at":{"type":"string"},"credited_at":{"type":["string","null"]},"credited_cents":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"crypto_amount":{"type":"string"},"expires_at":{"type":"string"},"id":{"type":"string"},"network":{"type":"string"},"payment_uri":{"type":["string","null"]},"received_cents":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"required_confirmations":{"anyOf":[{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},{"type":"null"}]},"status":{"enum":["awaiting_payment","confirming","underpaid","credited","expired"],"type":"string"},"top_up":{"anyOf":[{"additionalProperties":{},"properties":{"crypto_amount":{"type":"string"},"until":{"type":"string"}},"required":["crypto_amount","until"],"type":"object"},{"type":"null"}]},"url":{"type":"string"}},"required":["id","status","coin","asset","network","amount_cents","crypto_amount","address","payment_uri","confirmations","required_confirmations","received_cents","credited_cents","bonus_cents","top_up","url","expires_at","created_at","credited_at"],"type":"object"}},"required":["deposit"],"type":"object"},"title":"Add funds with a crypto deposit"}
