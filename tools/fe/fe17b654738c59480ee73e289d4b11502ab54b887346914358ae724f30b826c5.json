{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/html.metadata",
  "agent-utilities/priceMicroUsd": 0
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Extract title, description, canonical URL, language and social metadata from supplied HTML. FREE during validation. No key, credits, wallet or preparation needed. Supply your task in input. Existing source and input limits apply.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "baseUrl": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
     },
     "html": {
      "maxLength": 100000,
      "type": "string"
     }
    },
    "required": [
     "html"
    ],
    "type": "object"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "html_metadata",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "canonicalUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "description": {
    "type": "string"
   },
   "language": {
    "type": "string"
   },
   "robots": {
    "type": "string"
   },
   "social": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "title",
   "description",
   "language",
   "canonicalUrl",
   "robots",
   "social"
  ],
  "type": "object"
 }
}
