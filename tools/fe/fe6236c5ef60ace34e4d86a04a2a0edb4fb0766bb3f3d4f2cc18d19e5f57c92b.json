{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Task"
 },
 "description": "Create a task within an epic. Tasks are the primary unit of work.",
 "inputSchema": {
  "properties": {
   "assigned_to": {
    "description": "Assignee name",
    "type": "string"
   },
   "depends_on": {
    "description": "Task IDs this task depends on",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "description": {
    "description": "Task description",
    "type": "string"
   },
   "due_date": {
    "description": "Due date (YYYY-MM-DD)",
    "type": "string"
   },
   "epic_id": {
    "description": "Parent epic ID",
    "type": "integer"
   },
   "estimated_hours": {
    "description": "Estimated hours",
    "type": "number"
   },
   "priority": {
    "default": "medium",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "source_ref": {
    "description": "Link to source code location",
    "properties": {
     "commit": {
      "description": "Commit hash",
      "type": "string"
     },
     "file": {
      "type": "string"
     },
     "line_end": {
      "type": "integer"
     },
     "line_start": {
      "type": "integer"
     },
     "repo": {
      "description": "Repository URL or name",
      "type": "string"
     }
    },
    "required": [
     "file"
    ],
    "type": "object"
   },
   "status": {
    "default": "todo",
    "enum": [
     "todo",
     "in_progress",
     "review",
     "done",
     "blocked"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Task title",
    "type": "string"
   }
  },
  "required": [
   "epic_id",
   "title"
  ],
  "type": "object"
 },
 "name": "task_create"
}
