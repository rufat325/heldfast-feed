 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "512x512"
   ],
   "src": "https://vaultrubric.com/icon.png"
  }
 ],
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "name": {
