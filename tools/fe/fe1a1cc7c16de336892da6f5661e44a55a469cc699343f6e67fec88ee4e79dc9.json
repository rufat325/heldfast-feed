       "properties": {
        "basis": {
         "type": [
          "string",
          "null"
         ]
        },
        "imputed_score": {
         "type": [
          "number",
          "null"
         ]
        },
        "key": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "score_out_of_10": {
         "type": [
          "number",
          "null"
         ]
        },
        "sources": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "weight": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "customer_funds_hack": {},
     "data_coverage_pct": {
      "type": [
       "number",
       "null"
      ]
     },
     "eligible_for_pick": {
      "type": "boolean"
     },
     "incident_notes": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     },
     "vaultrubric_score_pct": {
      "type": [
       "number",
       "null"
      ]
     }
