{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Sign and Send Transaction"
 },
 "description": "DEV ONLY \u2014 Sign and broadcast an unsigned transaction using a local private key (PK env var). For production, use a dedicated wallet MCP server (Fireblocks, Safe, Turnkey, etc.) instead of this tool. Takes the transaction object returned by any write.* tool and submits it onchain.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain_id": {
    "default": 8453,
    "description": "Chain ID: 8453 (Base), 130 (Unichain), or 10 (Optimism)",
    "type": "number"
   },
   "data": {
    "description": "Encoded calldata (hex)",
    "type": "string"
   },
   "to": {
    "description": "Target contract address",
    "type": "string"
   },
   "value": {
    "default": "0",
    "description": "Value in wei (default '0')",
    "type": "string"
   }
  },
  "required": [
   "to",
   "data"
  ],
  "type": "object"
 },
 "name": "dev.send",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blockNumber": {
    "type": "number"
   },
   "gasLimit": {
    "type": "number"
   },
   "gasUsed": {
    "type": "number"
   },
   "signer": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "txHash": {
    "type": "string"
   }
  },
  "required": [
   "signer",
   "txHash",
   "status",
   "blockNumber",
   "gasLimit",
   "gasUsed"
  ],
  "type": "object"
 }
}
