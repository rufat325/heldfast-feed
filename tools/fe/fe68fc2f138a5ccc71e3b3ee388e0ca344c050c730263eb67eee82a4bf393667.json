{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit a sanitized inquiry only after the user has explicitly authorized sending it to Quiet Stance. Do not send passwords, API keys, financial credentials, protected records, regulated personal data, or trade-secret documents. Submission creates an inquiry for human review; it does not imply acceptance, payment terms, system access, or authority to act.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent_source": {
    "maxLength": 80,
    "type": "string"
   },
   "authorization": {
    "maxLength": 120,
    "type": "string"
   },
   "consent": {
    "const": true,
    "type": "boolean"
   },
   "consequence": {
    "maxLength": 2400,
    "minLength": 5,
    "type": "string"
   },
   "current_approach": {
    "maxLength": 2400,
    "minLength": 5,
    "type": "string"
   },
   "name": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "maxLength": 1300,
    "type": "string"
   },
   "organization": {
    "maxLength": 240,
    "type": "string"
   },
   "problem": {
    "maxLength": 3000,
    "minLength": 20,
    "type": "string"
   },
   "recurrence": {
    "maxLength": 500,
    "type": "string"
   },
   "work_email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   }
  },
  "required": [
   "name",
   "work_email",
   "problem",
   "consequence",
   "current_approach",
   "consent"
  ],
  "type": "object"
 },
 "name": "submit_workflow_inquiry",
 "title": "Submit an authorized recurring workflow inquiry to Quiet Stance"
}
