{
 "description": "ROTATION WIZARD alt \u2014 assemble an UNSIGNED SignerListSet (multisig). Often SAFER than disable-master for high-value accounts: multiple recovery keys, no single point of loss. quorum=0 removes the list. Rejects an unreachable quorum (would lock out the account). Never signs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "account": {
    "minLength": 25,
    "type": "string"
   },
   "network": {
    "default": "testnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   },
   "quorum": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "signers": {
    "items": {
     "properties": {
      "account": {
       "minLength": 25,
       "type": "string"
      },
      "weight": {
       "maximum": 9007199254740991,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "account",
      "weight"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "account",
   "quorum"
  ],
  "type": "object"
 },
 "name": "build_signer_list_set_unsigned"
}
