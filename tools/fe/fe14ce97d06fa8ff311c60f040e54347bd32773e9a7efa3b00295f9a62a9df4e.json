{
 "description": "Derive a constrained policy artifact for a sub-agent. Scope can only diminish, never expand. (NCCoE constrained delegation)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "delegation_purpose": {
    "description": "Purpose of the delegation",
    "type": "string"
   },
   "enforcement_triggers": {
    "description": "Subset of parent enforcement triggers",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "measurement_types": {
    "description": "Subset of parent measurement types",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "requested_ttl_seconds": {
    "description": "Requested TTL (will be clamped to parent remaining)",
    "type": "number"
   }
  },
  "required": [
   "enforcement_triggers",
   "measurement_types",
   "requested_ttl_seconds",
   "delegation_purpose"
  ],
  "type": "object"
 },
 "name": "delegate_to_subagent"
}
