{
 "description": "Search the graded catalog of x402 services (the x402 Bazaar + independent indexes), ranked by real 30-day demand and agent-usability grade (A-F). Free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "callable": {
    "description": "only services callable through the gateway",
    "type": "boolean"
   },
   "grade": {
    "description": "comma list of grades, e.g. \"A,B\"",
    "type": "string"
   },
   "limit": {
    "description": "max 100 per page",
    "type": "number"
   },
   "offset": {
    "description": "pagination offset",
    "type": "number"
   },
   "query": {
    "description": "substring match on name/description",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_services"
}
