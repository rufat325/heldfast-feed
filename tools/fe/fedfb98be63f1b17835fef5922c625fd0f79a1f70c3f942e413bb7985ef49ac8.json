{
 "description": "Add 1 to 12 parts in one call. Send ONE call and wait for its answer before the next. parts may be a JSON list or the same list inside a string.",
 "inputSchema": {
  "properties": {
   "forge_handle": {
    "description": "The forge_handle returned by enter_forge.",
    "type": "string"
   },
   "parts": {
    "items": {
     "description": "One part. Example: {\"id\": \"helm\", \"role\": \"helm\", \"shape\": \"cylinder\", \"size\": {\"radius_top\": 0.13, \"radius_bottom\": 0.14, \"height\": 0.3}, \"position\": [0, 1.7, 0], \"material\": \"steel\"}",
     "properties": {
      "color": {
       "description": "#rrggbb, optional; overrides the material colour",
       "type": "string"
      },
      "id": {
       "description": "Your name for the part: lowercase letters, digits, _ or -, unique.",
       "type": "string"
      },
      "material": {
       "enum": [
        "steel",
        "blackened_steel",
        "gold",
        "bronze",
        "leather",
        "cloth",
        "wood",
        "fur",
        "gem",
        "stone"
       ],
       "type": "string"
      },
      "position": {
       "description": "[x, y, z] centre in metres",
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "role": {
       "enum": [
        "head",
        "helm",
        "visor",
        "plume",
        "torso",
        "belt",
        "arm",
        "hand",
        "leg",
        "foot",
        "pauldron",
        "shield",
        "emblem",
        "cape",
        "sword",
        "scabbard",
        "ornament"
       ],
       "type": "string"
      },
      "rotation": {
       "description": "[x, y, z] degrees, optional",
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "scale": {
       "description": "[x, y, z], optional",
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "shape": {
       "enum": [
        "box",
        "cylinder",
        "cone",
        "sphere",
        "capsule",
        "torus",
        "lathe",
        "extrude",
        "tube",
        "armour"
       ],
       "type": "string"
      },
      "size": {
       "description": "Keys depend on shape: box: w, h, d; cylinder: radius_top, radius_bottom, height, arc; cone: radius, height, arc; sphere: radius, arc, top, bottom; capsule: radius, length; torus: radius, tube; lathe: points; extrude: outline, depth; tube: points, radius; armour: piece, style, w, h, d",
       "type": "object"
      }
     },
     "required": [
      "id",
      "role",
      "shape",
      "size",
      "position"
     ],
     "type": "object"
    },
    "type": [
     "array",
     "string"
    ]
   }
  },
  "required": [
   "forge_handle",
   "parts"
  ],
  "type": "object"
 },
 "name": "forge_add"
}
