{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Generate a structured Agentic SDLC plan (Plan->Create->Test->Review->Optimize->Secure) from a goal and repo context. The plan is tailored to a `workType` (docs/feature/bugfix/refactor/security/release/infra) -- e.g. docs tasks do not default to requiring code unit tests, while bugfix tasks always include repro + regression tests.\n\nTemplate-based -- no LLM call needed. Reads basic repo metadata (and the repo's actual label list, to avoid inventing labels that don't exist) to enrich the plan.\n\nArgs:\n  - goal (string): The user's goal or feature description (required).\n  - owner, repo: Repo coordinates (fall back to env vars).\n  - workType (string?): Explicit task category. If omitted, inferred from goal + acceptanceCriteria -- check the output's `confidence`/`needsClarification` rather than assuming the guess is correct.\n  - constraints (string[]?): Technical or business constraints.\n  - acceptanceCriteria (string[]?): Explicit acceptance criteria.\n\nReturns: Phase-by-phase SDLC plan tailored to the (inferred or explicit) work type, plus structured output including workType/confidence/reasoning/needsClarification, and `issueDrafts` -- structured issue drafts (title/body/labels/phase/acceptanceCriteria/riskLevel) directly usable as `create_issue_set`'s `issues` input.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "acceptanceCriteria": {
    "description": "Acceptance criteria the implementation must satisfy.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "constraints": {
    "description": "Technical or business constraints.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "goal": {
    "description": "The user goal or feature request to plan around.",
    "minLength": 5,
    "type": "string"
   },
   "owner": {
    "description": "GitHub owner. Falls back to GITHUB_OWNER.",
    "type": "string"
   },
   "repo": {
    "description": "GitHub repo. Falls back to GITHUB_REPO.",
    "type": "string"
   },
   "workType": {
    "description": "Explicit task category: docs, feature, bugfix, refactor, security, release, or infra. If omitted, it is inferred from `goal` + `acceptanceCriteria` -- check the output's `confidence` and `needsClarification` fields rather than assuming the guess is correct.",
    "enum": [
     "docs",
     "feature",
     "bugfix",
     "refactor",
     "security",
     "release",
     "infra"
    ],
    "type": "string"
   }
  },
  "required": [
   "goal"
  ],
  "type": "object"
 },
 "name": "plan_from_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "acceptanceCriteria": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "appliedPolicyRules": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "source": {
       "const": "repository",
       "type": "string"
      }
     },
     "required": [
      "id",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "confidence": {
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "constraints": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "defaultBranch": {
    "type": "string"
   },
   "goal": {
    "type": "string"
   },
   "issueDrafts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "acceptanceCriteria": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "body": {
       "type": "string"
      },
      "goal": {
       "type": "string"
      },
      "labels": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "phase": {
       "type": "string"
      },
      "riskLevel": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "body",
      "labels",
      "phase",
      "acceptanceCriteria",
      "riskLevel",
      "goal"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "language": {
    "type": [
     "string",
     "null"
    ]
   },
   "needsClarification": {
    "type": "boolean"
   },
   "phases": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "phase": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      },
      "tasks": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "phase",
      "summary",
      "tasks"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "policyDegraded": {
    "type": "boolean"
   },
   "policyDigest": {
    "type": "string"
   },
   "policyErrors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "policySources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "blobSha": {
       "type": [
        "string",
        "null"
       ]
      },
      "digest": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "default",
        "repository"
       ],
       "type": "string"
      },
      "path": {
       "type": [
        "string",
        "null"
       ]
      },
      "ref": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "kind",
      "path",
      "ref",
      "blobSha",
      "digest"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "reasoning": {
    "type": "string"
   },
   "repo": {
    "type": "string"
   },
   "risks": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "suggestedIssues": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "trustBoundary": {
    "additionalProperties": false,
    "properties": {
     "callerAndRepositoryContent": {
      "const": "untrusted",
      "type": "string"
     },
     "instructionHandling": {
      "const": "never_execute",
      "type": "string"
     },
     "permissionHandling": {
      "const": "never_expand",
      "type": "string"
     },
     "secretHandling": {
      "const": "never_reveal",
      "type": "string"
     }
    },
    "required": [
     "callerAndRepositoryContent",
     "instructionHandling",
     "secretHandling",
     "permissionHandling"
    ],
    "type": "object"
   },
   "workType": {
    "enum": [
     "docs",
     "feature",
     "bugfix",
     "refactor",
     "security",
     "release",
     "infra"
    ],
    "type": "string"
   }
  },
  "required": [
   "goal",
   "repo",
   "defaultBranch",
   "language",
   "workType",
   "confidence",
   "reasoning",
   "needsClarification",
   "constraints",
   "acceptanceCriteria",
   "phases",
   "suggestedIssues",
   "issueDrafts",
   "risks",
   "policySources",
   "appliedPolicyRules",
   "policyDegraded",
   "policyErrors"
  ],
  "type": "object"
 },
 "title": "Generate SDLC Plan from Context"
}
