{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns every question asked about a product listing, including the seller's answer where one exists (answer/answered_at are null for unanswered questions). Useful to check what past buyers already asked before asking a new one, or before advising a buyer on a purchase decision. Read-only, no authentication required.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "productId": {
    "description": "The product listing's uuid.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "productId"
  ],
  "type": "object"
 },
 "name": "questions.list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "questions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "answer": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "answered_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "created_at": {
       "type": "string"
      },
      "id": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "product_id": {
       "type": "string"
      },
      "questioner_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "product_id",
      "message",
      "answer",
      "created_at",
      "answered_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "questions"
  ],
  "type": "object"
 },
 "title": "Get a Resollo product's questions and answers"
}
