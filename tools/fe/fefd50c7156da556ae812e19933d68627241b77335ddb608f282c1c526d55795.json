{
 "description": "List WooCommerce orders (slim)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Only orders created after this date (YYYY-MM-DD). Not combinable with before: before wins",
    "type": "string"
   },
   "before": {
    "description": "Only orders created before this date (YYYY-MM-DD)",
    "type": "string"
   },
   "customer": {
    "description": "Customer (user) ID",
    "type": "integer"
   },
   "page": {
    "description": "Page number (default 1)",
    "type": "integer"
   },
   "per_page": {
    "description": "Orders per page (default 20, -1 for all)",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "description": "Order status: any (default), pending, processing, on-hold, completed, cancelled, refunded, failed",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "woo_list_orders"
}
