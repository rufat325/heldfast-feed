{
 "_meta": {
  "openai/toolInvocation/invoked": "Hours added up",
  "openai/toolInvocation/invoking": "Adding up your hours",
  "ui": {
   "resourceUri": "ui://timesheet/Statistics.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get Statistics"
 },
 "description": "Use this when the user wants to see time tracking statistics, summaries, or reports for a date range of up to one year (366 days). For a longer period, call it once per year. Returns aggregated totals, project breakdowns, and daily/weekly hour charts.",
 "inputSchema": {
  "properties": {
   "endDate": {
    "description": "End date for the statistics period (YYYY-MM-DD)",
    "format": "date",
    "type": "string"
   },
   "filter": {
    "description": "Filter by billing/payment status",
    "enum": [
     "all",
     "billable",
     "notBillable",
     "paid",
     "unpaid",
     "billed",
     "outstanding"
    ],
    "type": "string"
   },
   "projectId": {
    "description": "Filter statistics for a specific project",
    "type": "string"
   },
   "projectIds": {
    "description": "Filter statistics for multiple projects",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "startDate": {
    "description": "Start date for the statistics period (YYYY-MM-DD)",
    "format": "date",
    "type": "string"
   },
   "tagIds": {
    "description": "Filter statistics by tag IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "teamId": {
    "description": "Filter statistics for a specific team",
    "type": "string"
   },
   "teamIds": {
    "description": "Filter statistics for multiple teams",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "userIds": {
    "description": "Filter statistics by user IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "statistics_get",
 "outputSchema": {
  "properties": {
   "billableHours": {
    "description": "Billable hours",
    "type": "number"
   },
   "endDate": {
    "description": "Period end date",
    "type": "string"
   },
   "nonBillableHours": {
    "description": "Non-billable hours",
    "type": "number"
   },
   "startDate": {
    "description": "Period start date",
    "type": "string"
   },
   "totalBreakHours": {
    "description": "Total break hours",
    "type": "number"
   },
   "totalHours": {
    "description": "Total hours tracked",
    "type": "number"
   },
   "totalTasks": {
    "description": "Total number of tasks",
    "type": "number"
   },
   "truncated": {
    "description": "True when not every entry of the range could be read (over 5,000), so the totals are too low",
    "type": "boolean"
   }
  },
  "required": [
   "totalHours",
   "billableHours",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "title": "Get Statistics"
}
