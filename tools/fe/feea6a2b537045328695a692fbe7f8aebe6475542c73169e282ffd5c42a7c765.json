{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Navigate the FRED category tree. Returns the current category, its child categories, and \u2014 when viewing a leaf node with no children \u2014 a sample of series within it. Omit category_id to start at the root (ID 0).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "category_id": {
    "description": "Category ID to view. Omit or use 0 to start at the root.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "fedreserve_browse_categories",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "category",
     "children"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "category": {
    "additionalProperties": false,
    "description": "The category being viewed.",
    "properties": {
     "id": {
      "description": "Category ID.",
      "type": "number"
     },
     "name": {
      "description": "Category name.",
      "type": "string"
     },
     "notes": {
      "description": "Category notes when provided.",
      "type": "string"
     },
     "parent_id": {
      "description": "Parent category ID when applicable.",
      "type": "number"
     }
    },
    "required": [
     "id",
     "name"
    ],
    "type": "object"
   },
   "children": {
    "description": "Child categories. Empty for leaf nodes.",
    "items": {
     "additionalProperties": false,
     "description": "A child category in the FRED hierarchy.",
     "properties": {
      "id": {
       "description": "Child category ID.",
       "type": "number"
      },
      "name": {
       "description": "Child category name.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `category_not_found`: category_id does not exist on FRED. Other values are possible when a failure originates below the handler.",
        "examples": [
         "category_not_found"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "sample_series": {
    "description": "Sample series when the category has no children (leaf node). Use fedreserve_search_series or fedreserve_get_observations for deeper access.",
    "items": {
     "additionalProperties": false,
     "description": "One series in this leaf category.",
     "properties": {
      "frequency": {
       "description": "Data frequency.",
       "type": "string"
      },
      "id": {
       "description": "Series ID.",
       "type": "string"
      },
      "title": {
       "description": "Series title.",
       "type": "string"
      },
      "units": {
       "description": "Units of measurement.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "units",
      "frequency"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Browse FRED Categories"
}
