{
 "annotations": {
  "readOnlyHint": true,
  "title": "List audit logs"
 },
 "description": "Security audit trail of the account (up to 180 days): who did what to which resource, when, from which IP and via API or Hub. Filter by action, origin, resource type, time window or a keyword (UUID, username or IP). Returns total_count for paging. UpCloud: GET /1.3/audit-logs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "action": {
    "description": "Only this action.",
    "enum": [
     "create",
     "read",
     "update",
     "delete",
     "access-update",
     "attach",
     "detach",
     "login",
     "logout"
    ],
    "type": "string"
   },
   "created_after": {
    "description": "ISO timestamp, e.g. 2026-09-01T00:00:00Z (inclusive). Default 180 days ago.",
    "type": "string"
   },
   "created_before": {
    "description": "ISO timestamp (inclusive). Default now.",
    "type": "string"
   },
   "limit": {
    "description": "Max entries to return, 0-200 (API default 50).",
    "maximum": 200,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "description": "Offset into the results (API default 0).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "origin": {
    "description": "Only this origin.",
    "enum": [
     "api",
     "gui",
     "upcloud_internal"
    ],
    "type": "string"
   },
   "q": {
    "description": "Keyword: a resource UUID, account username or IP address.",
    "maxLength": 255,
    "type": "string"
   },
   "resource_type": {
    "description": "Only this resource type (uks = Kubernetes).",
    "enum": [
     "account",
     "auth",
     "init-script",
     "managed-database",
     "managed-loadbalancer",
     "managed-loadbalancer-certificate-bundle",
     "managed-object-storage",
     "server",
     "ssh-key",
     "storage",
     "uks"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "upcloud_list_audit_logs",
 "title": "List audit logs"
}
