{
 "description": "Launch an Android Virtual Device (AVD) emulator. Returns once the emulator process has started.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "avdName": {
    "description": "AVD name (from adb_avd_list)",
    "type": "string"
   },
   "coldBoot": {
    "default": false,
    "description": "Force cold boot (-no-snapshot-load)",
    "type": "boolean"
   },
   "gpuMode": {
    "default": "auto",
    "description": "GPU acceleration mode",
    "enum": [
     "auto",
     "host",
     "swiftshader_indirect",
     "off"
    ],
    "type": "string"
   },
   "headless": {
    "default": false,
    "description": "Run without GUI window (-no-window)",
    "type": "boolean"
   }
  },
  "required": [
   "avdName"
  ],
  "type": "object"
 },
 "name": "adb_emulator_start"
}
