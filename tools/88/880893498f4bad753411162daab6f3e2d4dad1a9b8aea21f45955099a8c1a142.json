{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read one prepared offer by its submissionId and resumeToken. No quote, booking, payment, message or provider request is created.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "resumeToken": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "submissionId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "submissionId",
   "resumeToken"
  ],
  "type": "object"
 },
 "name": "get_offer_status",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "status": {
      "const": "invalid_request",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "status": {
      "const": "unavailable",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "retryAfterSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "status": {
      "const": "pending",
      "type": "string"
     }
    },
    "required": [
     "status",
     "retryAfterSeconds"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "retryAfterSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "status": {
      "const": "rate_limited",
      "type": "string"
     }
    },
    "required": [
     "status",
     "retryAfterSeconds"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "status": {
      "enum": [
       "conflict",
       "ambiguous",
       "not_found"
      ],
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingConfirmed": {
      "const": false,
      "type": "boolean"
     },
     "checkoutUrl": {
      "format": "uri",
      "type": "string"
     },
     "nextAction": {
      "type": "string"
     },
     "offer": {
      "additionalProperties": false,
      "properties": {
       "completeTermsBound": {
        "const": true,
        "type": "boolean"
       },
       "currency": {
        "const": "EUR",
        "type": "string"
       },
       "customerConfirmationRequired": {
        "const": true,
        "type": "boolean"
       },
       "expiresAt": {
        "type": "string"
       },
       "grossTotalCents": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "currency",
       "grossTotalCents",
       "expiresAt",
       "customerConfirmationRequired",
       "completeTermsBound"
      ],
      "type": "object"
     },
     "status": {
      "const": "prepared",
      "type": "string"
     },
     "termsUrl": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "status",
     "bookingConfirmed",
     "checkoutUrl",
     "termsUrl",
     "offer",
     "nextAction"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Read prepared offer status"
}
