{
 "description": "Create a new recipe. Only `title` is required. Ingredients are an array of {title, amount, unit, note, position}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "calories": {
    "type": "string"
   },
   "carbohydrate": {
    "type": "string"
   },
   "cholesterol": {
    "type": "string"
   },
   "cook_time": {
    "description": "Minutes",
    "type": "number"
   },
   "course_id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "cuisine_id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "description": {
    "type": "string"
   },
   "directions": {
    "type": "string"
   },
   "draft": {
    "type": "boolean"
   },
   "fat": {
    "type": "string"
   },
   "fiber": {
    "type": "string"
   },
   "ingredients": {
    "description": "Maps to recipe_ingredients_attributes on the wire",
    "items": {
     "properties": {
      "_destroy": {
       "description": "Set to true with id to remove an ingredient on update",
       "type": "boolean"
      },
      "amount": {
       "type": "string"
      },
      "id": {
       "description": "Existing ingredient id (for updates)",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "note": {
       "type": "string"
      },
      "position": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "title": {
       "type": "string"
      },
      "unit": {
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "main_ingredient_id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "prep_time": {
    "description": "Minutes",
    "type": "number"
   },
   "private": {
    "type": "boolean"
   },
   "protein": {
    "type": "string"
   },
   "rating": {
    "type": [
     "string",
     "number"
    ]
   },
   "saturated_fat": {
    "type": "string"
   },
   "servings": {
    "type": "number"
   },
   "sodium": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "sugar": {
    "type": "string"
   },
   "tag_titles": {
    "description": "Comma-separated list of tag names",
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "total_time": {
    "description": "Minutes",
    "type": "number"
   },
   "url": {
    "type": "string"
   },
   "yield": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_recipe"
}
