{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Vault deposits, withdrawals and transfers for a Hyperliquid wallet. Positive amounts go into the account. Account deposits and withdrawals are recorded only up to 2026-06-06.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "0x-prefixed 20-byte hex address",
    "type": "string"
   },
   "event_types": {
    "description": "Comma-separated type filter (deposit,withdrawal,vault_deposit,vault_withdraw,vault_transfer_in,vault_transfer_out)",
    "type": "string"
   },
   "from": {
    "description": "Unix ms window start",
    "type": "number"
   },
   "limit": {
    "description": "Max entries, default 1000, cap 10000",
    "type": "number"
   },
   "to": {
    "description": "Unix ms window end",
    "type": "number"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_user_ledger",
 "outputSchema": {
  "description": "Vault and transfer ledger",
  "properties": {
   "address": {
    "description": "Wallet address (0x\u2026)"
   },
   "data": {
    "description": "Ledger entries",
    "items": {
     "description": "One entry",
     "properties": {
      "amount": {
       "description": "USD; positive into the account"
      },
      "timestamp": {
       "description": "Unix milliseconds"
      },
      "type": {
       "description": "Event type"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "from": {
    "description": "Window start, Unix milliseconds"
   },
   "to": {
    "description": "Window end, Unix milliseconds"
   }
  },
  "type": "object"
 }
}
