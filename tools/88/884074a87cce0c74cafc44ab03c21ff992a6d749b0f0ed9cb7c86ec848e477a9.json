       "target",
       "fragmentHash"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "obligations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "enum": [
        "evidence",
        "behavior",
        "types",
        "serialization",
        "compatibility",
        "other"
       ],
       "type": "string"
      },
      "command_alternatives": {
       "items": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "type": "array"
      },
      "description": {
       "type": "string"
      },
      "expected": {
       "additionalProperties": false,
       "properties": {
        "output_excludes": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "output_includes": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "success": {
         "type": "boolean"
        }
       },
       "required": [
        "success"
       ],
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "origin": {
       "enum": [
        "memory",
        "episode",
        "manual"
       ],
       "type": "string"
      },
      "phase": {
       "enum": [
        "session",
        "after-edit"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "origin",
      "category",
      "phase",
      "description",
      "command_alternatives",
      "expected"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "omitted": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "constraints",
        "decisions",
        "bugs",
        "findings",
        "resources",
        "relationships"
       ],
