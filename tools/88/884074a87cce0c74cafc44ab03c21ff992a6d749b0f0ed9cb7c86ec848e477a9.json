{
 "description": "Given a file, symbol, or task phrase you're about to work on, return the MINIMAL relevant memory \u2014 invariants, decisions, bug history, blast radius \u2014 as a compact brief. Call FIRST when starting work. A task phrase with no file/symbol match falls back to the closest graph matches. Returns a budgeted brief plus a delivery receipt. Not for exhaustive rationale on one file (hunch_why) or keyword search (hunch_query).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "as_of": {
    "description": "Time-travel ref (commit/tag/branch): assemble the slice as it stood then.",
    "type": "string"
   },
   "budget_tokens": {
    "description": "Rough token budget for the brief (default 1500).",
    "type": "number"
   },
   "cwd": {
    "description": "Your current directory, when it differs from where this session started (e.g. a worktree); writes then commit there, not to the original root.",
    "type": "string"
   },
   "include": {
    "description": "Opt-in extras; omitted by default to keep the brief small.",
    "items": {
     "enum": [
      "recent_tasks",
      "project_dna"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "profile": {
    "description": "Delivery role: builder (default), reviewer, or architect. Changes non-blocking order only.",
    "enum": [
     "builder",
     "reviewer",
     "architect"
    ],
    "type": "string"
   },
   "target": {
    "description": "A file path, symbol, or task phrase you're about to work on.",
    "type": "string"
   },
   "task_id": {
    "description": "Exact task ID from hunch_task; records this delivery for the task's contribution report.",
    "pattern": "^htask_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "hunch_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "abstention": {
    "additionalProperties": false,
    "properties": {
     "active": {
      "type": "boolean"
     },
     "reasons": {
      "additionalProperties": false,
      "properties": {
       "insufficient-context": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "low-confidence": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "low-relevance": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "low-confidence",
       "insufficient-context",
       "low-relevance"
      ],
      "type": "object"
     },
     "retry_hint": {
      "type": [
       "string",
       "null"
      ]
     },
     "withheld": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "active",
     "withheld",
     "reasons",
     "retry_hint"
    ],
    "type": "object"
   },
   "accounted_chars": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "blocking_overflow": {
    "type": "boolean"
   },
   "budget_tokens": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "delivered": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "delivery_reason": {
       "enum": [
        "ranked",
        "blocking-reserved"
       ],
       "type": "string"
      },
      "kind": {
       "enum": [
        "constraints",
        "decisions",
        "bugs",
        "findings",
        "resources",
        "relationships"
       ],
       "type": "string"
      },
      "provenance_status": {
       "enum": [
        "current",
        "unverified",
        "stale"
       ],
       "type": "string"
      },
      "rank": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "record_id": {
       "type": "string"
      },
      "token_cost": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "kind",
      "record_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hypotheses": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "disprove": {
       "type": "string"
      },
      "historical_pattern": {
       "type": "string"
      },
      "kind": {
       "const": "decision",
       "type": "string"
      },
      "obligations": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "category": {
          "enum": [
           "evidence",
           "behavior",
           "types",
           "serialization",
           "compatibility",
           "other"
          ],
          "type": "string"
         },
         "command_alternatives": {
          "items": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "type": "array"
         },
