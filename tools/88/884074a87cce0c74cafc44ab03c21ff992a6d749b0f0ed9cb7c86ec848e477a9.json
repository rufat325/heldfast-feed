          "type": "string"
         },
         "expected": {
          "additionalProperties": false,
          "properties": {
           "output_excludes": {
            "items": {
             "type": "string"
            },
            "type": "array"
           },
           "output_includes": {
            "items": {
             "type": "string"
            },
            "type": "array"
           },
           "success": {
            "type": "boolean"
           }
          },
          "required": [
           "success"
          ],
          "type": "object"
         },
         "id": {
          "type": "string"
         },
         "origin": {
          "enum": [
           "memory",
           "episode",
           "manual"
          ],
          "type": "string"
         },
         "phase": {
          "enum": [
           "session",
           "after-edit"
          ],
          "type": "string"
         }
        },
        "required": [
         "id",
         "origin",
         "category",
         "phase",
         "description",
         "command_alternatives",
         "expected"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "rank": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "record_id": {
       "type": "string"
      },
      "verify": {
       "type": "string"
      },
      "where": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "why": {
       "type": "string"
      }
     },
     "required": [
      "kind",
      "record_id",
      "rank",
      "why",
      "where",
      "historical_pattern",
      "verify",
      "disprove",
      "obligations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "landscape": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "fragmentHash": {
        "type": "string"
       },
       "schema": {
        "const": "hunch.landscape-fragment/1",
        "type": "string"
       },
       "target": {
        "type": "string"
       }
      },
      "required": [
