{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Run the rule-based verdict engine on a single post: combine snapshot + decay curve and emit a verdict with reason codes and a 0-1 confidence score.\n\nReason codes are deterministic. The mapping reasons -> verdict lives in src/verdict/rules.ts and can be inspected.\n\nReporting only - does NOT mutate anything. To act on the verdict, hand the brief to a writer or to an AI rewrite tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "persist": {
    "default": false,
    "type": "boolean"
   },
   "url": {
    "description": "Canonical URL of the post.",
    "format": "uri",
    "type": "string"
   },
   "window": {
    "default": 30,
    "enum": [
     30,
     60,
     90
    ],
    "type": "number"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "posts_verdict",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confidence": {
    "type": "number"
   },
   "evidence": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "not": {}
      }
     ]
    },
    "type": "object"
   },
   "reason_strings": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "reasons": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "url": {
    "type": "string"
   },
   "verdict": {
    "enum": [
     "refresh",
     "expand",
     "merge",
     "kill",
     "double_down",
     "hold"
    ],
    "type": "string"
   }
  },
  "required": [
   "url",
   "verdict",
   "reasons",
   "confidence",
   "evidence",
   "reason_strings"
  ],
  "type": "object"
 },
 "title": "Verdict per post (refresh / expand / merge / kill / double_down / hold)"
}
