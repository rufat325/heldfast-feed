{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare highest/lowest recorded immigration rates by judge or court, jointly filtered by state, nationality and calendar/fiscal proceeding-completion year. Defaults to asylum_denial_rate and minimum_decisions 1; a larger minimum is optional. Include small samples with decision counts and labels. Asylum percentages use grants plus denials, with procedural outcomes separate. At most ten results. Use proceeding_removal_rate only for explicitly requested broader proceeding outcomes. Historical rates do not predict individual outcomes or imply a choice of judge.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "entity": {
    "enum": [
     "judge",
     "court"
    ],
    "type": "string"
   },
   "limit": {
    "default": 3,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "metric": {
    "default": "asylum_denial_rate",
    "enum": [
     "asylum_denial_rate",
     "proceeding_removal_rate"
    ],
    "type": "string"
   },
   "minimum_decisions": {
    "default": 1,
    "description": "Minimum grant-or-denial decisions; defaults to 1. Samples below 35 are labeled, not hidden.",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "nationality": {
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   },
   "order": {
    "default": "ascending",
    "enum": [
     "ascending",
     "descending"
    ],
    "type": "string"
   },
   "state": {
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "year": {
    "maximum": 2100,
    "minimum": 1950,
    "type": "integer"
   },
   "year_basis": {
    "default": "calendar",
    "enum": [
     "calendar",
     "fiscal"
    ],
    "type": "string"
   }
  },
  "required": [
   "entity"
  ],
  "type": "object"
 },
