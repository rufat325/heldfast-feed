{
 "description": "Search companies on the platform. Returns company name, industry, location, size, website, and open roles count.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "Filter by country",
    "type": "string"
   },
   "industry": {
    "description": "Filter by industry",
    "type": "string"
   },
   "is_hiring": {
    "description": "Filter to companies actively hiring",
    "type": "boolean"
   },
   "limit": {
    "description": "Results per page (default: 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number (default: 1)",
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Company name or industry keyword",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_companies"
}
