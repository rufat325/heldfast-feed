{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List resources managed in Ncloud. When NRN is specified, returns single resource detail with tags and groups.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "groupName": {
    "description": "Group name filter",
    "type": "string"
   },
   "nrn": {
    "description": "Ncloud Resource Name for single resource detail lookup",
    "type": "string"
   },
   "page": {
    "description": "Page number (default 0)",
    "type": "number"
   },
   "productName": {
    "description": "Product name filter (e.g., 'Server (VPC)', 'VPC')",
    "type": "string"
   },
   "regionCode": {
    "description": "Region code filter (KR, KRS)",
    "type": "string"
   },
   "resourceId": {
    "description": "Resource ID filter",
    "type": "string"
   },
   "resourceName": {
    "description": "Resource name filter",
    "type": "string"
   },
   "resourceType": {
    "description": "Resource type filter",
    "type": "string"
   },
   "size": {
    "description": "Page size (default 20)",
    "type": "number"
   },
   "tag": {
    "description": "Tag filter array [{tagKey, tagValue}]",
    "items": {
     "additionalProperties": false,
     "properties": {
      "tagKey": {
       "description": "Tag key",
       "type": "string"
      },
      "tagValue": {
       "description": "Tag value",
       "type": "string"
      }
     },
     "required": [
      "tagKey",
      "tagValue"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "ncloud_resource_list_resources"
}
