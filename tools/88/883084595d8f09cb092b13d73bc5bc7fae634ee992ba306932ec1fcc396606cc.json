{
 "description": "ETH-quoted Uniswap v4 and v3 pools opened on Robinhood Chain in the last 1-24 hours, youngest first, with token, age, last price, ETH liquidity, last swap time, 60-minute net flow and the burst tiers that fired. Data rewritten every 20 s (<= 30 s behind the chain); data older than 120 s is refused with a 503 and not charged. Costs $0.005 USDC per call (x402).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hours": {
    "description": "Look-back window in hours, 1-24 (default 6)",
    "maximum": 24,
    "minimum": 1,
    "type": "number"
   },
   "limit": {
    "description": "Max rows, 1-1000 (default 200)",
    "maximum": 1000,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "rh_pools_new",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ageSec": {
    "type": "number"
   },
   "chain": {
    "type": "string"
   },
   "ethUsd": {
    "type": [
     "number",
     "null"
    ]
   },
   "generatedAt": {
    "type": "number"
   },
   "pools": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "rules": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "schemaVersion": {
    "type": "number"
   }
  },
  "required": [
   "chain",
   "schemaVersion",
   "generatedAt",
   "ageSec",
   "ethUsd",
   "pools"
  ],
  "type": "object"
 }
}
