            },
            "en_catalogo": {
             "type": "boolean"
            },
            "nombre": {
             "type": [
              "string",
              "null"
             ]
            },
            "prefijo": {
             "pattern": "^[0-9]{2,8}$",
             "type": "string"
            }
           },
           "required": [
            "codigo",
            "prefijo",
            "nombre",
            "en_catalogo"
           ],
           "type": "object"
          }
         },
         "required": [
          "codigo",
          "nivel",
          "nombre",
          "en_catalogo",
          "segmento",
          "familia",
          "clase",
          "producto"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "UNSPSC oficial con su jerarqu\u00eda; null si la fuente no publica c\u00f3digo"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "unspsc_catalogo": {
    "additionalProperties": true,
    "properties": {
     "documentos": {
      "description": "consultas oficiales de las que salen",
      "items": {
       "additionalProperties": true,
       "properties": {},
       "type": "object"
      },
      "type": "array"
     },
     "licencia": {
      "description": "licencia y atribuci\u00f3n de los nombres (CC BY-SA 4.0)",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "nombres": {
      "description": "no_publicados: los nombres van a null y los c\u00f3digos de cada nivel s\u00ed",
      "enum": [
       "publicados",
       "no_publicados",
       "no_disponible"
      ],
      "type": "string"
     },
     "nota": {
      "type": "string"
     }
    },
    "required": [
     "nombres",
     "licencia",
     "documentos",
     "nota"
    ],
    "type": "object"
   }
  },
  "required": [
   "procesos",
   "contratos",
   "cobertura"
  ],
  "type": "object"
 },
 "title": "Detalle de un proceso de SECOP II"
}
