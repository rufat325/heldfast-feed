     },
     "fuentes": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "capturado_hasta": {
         "type": [
          "string",
          "null"
         ]
        },
        "corte": {
         "type": [
          "string",
          "null"
         ]
        },
        "dataset": {
         "type": "string"
        },
        "nota_corte": {
         "type": [
          "string",
          "null"
         ]
        },
        "ultima_sincronizacion": {
         "type": [
          "string",
          "null"
         ]
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "dataset",
        "url",
        "ultima_sincronizacion",
        "corte",
        "capturado_hasta",
        "nota_corte"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "nota": {
      "type": "string"
     }
    },
    "required": [
     "alcance",
     "fuentes",
     "nota"
    ],
    "type": "object"
   },
   "contratos": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "procesos": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "unspsc_adicionales_detalle": {
       "items": {
        "$ref": "#/properties/procesos/items/properties/unspsc_principal_detalle/anyOf/0"
       },
       "type": "array"
      },
      "unspsc_fuente": {
       "anyOf": [
        {
         "enum": [
          "oficial_secop2",
          "oficial_secop1"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "unspsc_principal_detalle": {
       "anyOf": [
        {
         "additionalProperties": false,
         "description": "UNSPSC oficial con su jerarqu\u00eda; null si la fuente no publica c\u00f3digo",
         "properties": {
          "clase": {
           "anyOf": [
            {
