             "type": "null"
            }
           ]
          },
          "codigo": {
           "pattern": "^[0-9]{8}$",
           "type": "string"
          },
          "en_catalogo": {
           "description": "false: los datos abiertos no tienen nombre para este c\u00f3digo",
           "type": "boolean"
          },
          "familia": {
           "anyOf": [
            {
             "$ref": "#/properties/procesos/items/properties/unspsc_principal_detalle/anyOf/0/properties/segmento"
