            "string",
            "null"
           ]
          },
          "producto": {
           "anyOf": [
            {
             "$ref": "#/properties/procesos/items/properties/unspsc_principal_detalle/anyOf/0/properties/segmento"
            },
            {
             "type": "null"
            }
           ]
          },
          "segmento": {
           "additionalProperties": false,
           "properties": {
            "codigo": {
             "pattern": "^[0-9]{8}$",
