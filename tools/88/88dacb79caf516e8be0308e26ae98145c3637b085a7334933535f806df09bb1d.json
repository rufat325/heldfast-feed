{
 "description": "Update an agent's reputation after a task result. Success increases mu and decreases sigma; failure does the opposite. Higher evidence class = larger effect.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentId": {
    "description": "Agent whose reputation to update",
    "type": "string"
   },
   "evidenceClass": {
    "description": "Complexity of the task",
    "enum": [
     "trivial",
     "standard",
     "complex",
     "critical"
    ],
    "type": "string"
   },
   "principalId": {
    "description": "Principal ID",
    "type": "string"
   },
   "scope": {
    "description": "Reputation scope",
    "type": "string"
   },
   "success": {
    "description": "Whether the task succeeded",
    "type": "boolean"
   }
  },
  "required": [
   "agentId",
   "principalId",
   "scope",
   "success",
   "evidenceClass"
  ],
  "type": "object"
 },
 "name": "update_reputation"
}
