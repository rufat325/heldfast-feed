{
 "description": "Export the canvas as PNG or SVG",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "background": {
    "maxLength": 32,
    "type": "string"
   },
   "elementIds": {
    "items": {
     "maxLength": 64,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "format": {
    "enum": [
     "png",
     "svg"
    ],
    "type": "string"
   },
   "padding": {
    "maximum": 500,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "format"
  ],
  "type": "object"
 },
 "name": "export_scene"
}
