  "title": "List Agent Tasks"
 },
 "description": "List Agent-stage tasks visible to this Talonic workspace credential.\n\nUSE WHEN: looking for external-agent work to process; begin with status 'available'.\nNOT FOR: reading the immutable task payload (use talonic_get_agent_task) or taking a lease (use talonic_claim_agent_task).\nARGS: optional status, limit, and cursor. RETURNS: metadata only plus pagination.next_cursor.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Opaque cursor from pagination.next_cursor.",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Page size (default 50).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Optional task-status filter.",
    "enum": [
     "available",
     "claimed",
     "submitted",
     "timed_out",
     "cancelled"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "talonic_list_agent_tasks",
 "title": "List Agent Tasks"
}
