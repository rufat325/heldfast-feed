  "title": "Open a $2 receipted session"
 },
 "description": "Open a $2 receipted negotiation session: deterministic, replayable, every move signed.\n\nPAID ($2 once, from your credit balance) \u2014 the $2 covers EVERY move of\nthis negotiation (up to 10 moves, 7 days), tuned to the category. A new\nkey's 50\u00a2 starter credit is a taste, not enough for a session \u2014 top up\nfirst. category: resale | supply | retail. side: buy | sell.\nwalk_away = your true floor (sell) / ceiling (buy) \u2014 private,\nnever crossed. Pass their_offers to get the first move back\nimmediately with the session. Subsequent moves: session_advise\nwith the session_id \u2014 no further charge.",
 "inputSchema": {
  "properties": {
   "api_key": {
    "description": "Your SNHP API key; $2 is debited from its credit balance (covers every move of this one negotiation).",
    "title": "Api Key",
    "type": "string"
   },
   "category": {
    "description": "Negotiation category for tuning: 'resale' | 'supply' | 'retail'.",
    "title": "Category",
    "type": "string"
   },
   "my_offers": {
    "anyOf": [
     {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Your own offers so far, in dollars, oldest first (optional).",
    "title": "My Offers"
   },
   "rounds_left": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Bargaining rounds remaining for this move (optional; overrides the category default).",
    "title": "Rounds Left"
   },
   "seed": {
    "default": 0,
    "description": "RNG seed for the deterministic engine (default 0).",
    "title": "Seed",
    "type": "integer"
   },
   "side": {
    "description": "Which side you're on: 'buy' or 'sell'.",
    "title": "Side",
    "type": "string"
   },
   "target": {
    "description": "Your aspiration price in dollars.",
    "title": "Target",
    "type": "number"
   },
   "their_offers": {
    "anyOf": [
     {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The other side's offers so far, in dollars, oldest first \u2014 pass to get the first move back with the session (optional).",
    "title": "Their Offers"
   },
   "walk_away": {
    "description": "Your true reservation in dollars \u2014 floor (sell) / ceiling (buy); private, never crossed.",
    "title": "Walk Away",
    "type": "number"
   }
  },
  "required": [
   "api_key",
   "category",
   "side",
   "walk_away",
   "target"
  ],
  "title": "nextmove_openArguments",
  "type": "object"
 },
