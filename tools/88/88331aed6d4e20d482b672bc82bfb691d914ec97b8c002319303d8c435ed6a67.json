{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get vacation rental collection content"
 },
 "description": "Returns collection-level content for a VRM. Sections: \"about\" (collection info), \"reviews\" (guest reviews with ratings). Use for guest questions about the company, area, or review quality.",
 "inputSchema": {
  "properties": {
   "collections": {
    "description": "Collection slug(s) \u2014 each a `collection_id` from list_collections. For search_bookables and discover_collections: OMIT to span the whole network, pass one to scope to a single manager, or several to compare across managers. For build_bookable_carousel: pass the collection_id(s) your chosen properties belong to \u2014 one, or several when the picks span managers. Every other tool operates on a single collection \u2014 pass exactly ONE.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max items for reviews. Default 10.",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset",
    "type": "number"
   },
   "section": {
    "description": "Content section",
    "enum": [
     "about",
     "reviews"
    ],
    "type": "string"
   }
  },
  "required": [
   "section"
  ],
  "type": "object"
 },
 "name": "get_collection_content",
 "outputSchema": {
  "properties": {
   "data": {
    "description": "Collection metadata for the \"about\" section.",
    "properties": {
     "description": {
      "type": [
       "string",
       "null"
      ]
     },
     "name": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "limit": {
    "type": "number"
   },
   "membership": {
    "description": "Optional collection membership metadata. Anonymous responses may expose availability, but member pricing is populated only for authenticated guests.",
    "properties": {
     "available": {
      "type": "boolean"
     },
     "memberRatesEnabled": {
      "type": "boolean"
     },
     "perks": {
      "description": "Manager-authored membership benefit lines.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "programName": {
      "type": "string"
     },
     "url": {
      "description": "Manager-owned membership page URL, capable of carrying kid_sid.",
      "type": "string"
     }
    },
    "required": [
     "available",
     "url"
    ],
    "type": "object"
   },
   "offset": {
    "type": "number"
   },
   "reviews": {
    "items": {
     "properties": {
      "channel": {
       "type": [
        "string",
        "null"
       ]
      },
      "date": {
       "type": [
        "string",
        "null"
       ]
      },
      "property": {
       "type": [
        "string",
        "null"
       ]
      },
      "propertySlug": {
       "type": [
        "string",
        "null"
       ]
      },
      "rating": {
       "type": [
        "number",
        "null"
       ]
      },
      "reviewer": {
       "type": [
        "string",
        "null"
       ]
      },
      "text": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "section": {
    "enum": [
     "about",
     "reviews"
    ],
    "type": "string"
   },
   "summary": {
    "description": "Review aggregates for the \"reviews\" section.",
    "properties": {
     "averageRating": {
      "type": [
       "number",
       "null"
      ]
     },
     "total": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "total": {
    "type": "number"
   },
   "type": {
    "description": "Always \"vrmContent\".",
    "type": "string"
   }
  },
  "required": [
   "type",
   "section"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "View Collection Info"
}
