{
 "annotations": {
  "title": "Transfer items"
 },
 "description": "Bulk-transfer a quantity of an item between slot ranges of a window. Defaults move within the player inventory (slots 9-45). Set `window` true to operate on the currently open container window instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "description": "How many to move; omit to move all available",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "destEnd": {
    "description": "Destination range end slot, exclusive (default 45)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "destStart": {
    "description": "Destination range start slot (default 9)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "item": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    ],
    "description": "Item name (e.g. \"diamond_pickaxe\") or numeric item id"
   },
   "sourceEnd": {
    "description": "Source range end slot, exclusive (default 45)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "sourceStart": {
    "description": "Source range start slot (default 9)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "window": {
    "description": "Operate on the open container window instead of the player inventory",
    "type": "boolean"
   }
  },
  "required": [
   "item"
  ],
  "type": "object"
 },
 "name": "transfer_items"
}
