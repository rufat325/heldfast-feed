{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Audit a URL for AI-search readiness: GEO score (0\u2013100), grade, per-category scores and findings (AI crawler access, llms.txt, structured data, citability, technical).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "only run these rule categories",
    "items": {
     "enum": [
      "ai-crawler",
      "llms-txt",
      "schema",
      "content",
      "technical"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "ignore": {
    "description": "skip these rule ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "maxFindings": {
    "description": "max findings returned (default 20, clamped to 1\u2013100)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "only": {
    "description": "only run these rule ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timeout": {
    "description": "per-request fetch timeout in ms",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "url": {
    "description": "URL to audit \u2014 https://\u2026 or a bare hostname",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "audit_url",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "categories": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "max": {
       "type": "number"
      },
      "score": {
       "type": "number"
      }
     },
     "required": [
      "category",
      "label",
      "score",
      "max"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "counts": {
    "additionalProperties": false,
    "properties": {
     "errors": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "info": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "warnings": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "errors",
     "warnings",
     "info"
    ],
    "type": "object"
   },
   "finalUrl": {
    "type": "string"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "ruleId": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warn",
        "info"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "ruleId",
      "severity",
      "title",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "grade": {
    "enum": [
     "A",
     "B",
     "C",
     "D",
     "F"
    ],
    "type": "string"
   },
   "score": {
    "type": "number"
   },
   "truncated": {
    "type": "boolean"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "finalUrl",
   "score",
   "grade",
   "counts",
   "categories",
   "findings",
   "truncated"
  ],
  "type": "object"
 }
}
