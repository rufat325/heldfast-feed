{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update an existing Auto Scaling Group configuration (e.g. min/max size, desired capacity, cooldown)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoScalingGroupNo": {
    "description": "Auto Scaling Group number to update",
    "type": "string"
   },
   "defaultCoolDown": {
    "description": "Default cooldown period in seconds",
    "type": "number"
   },
   "desiredCapacity": {
    "description": "New desired number of instances",
    "type": "number"
   },
   "healthCheckGracePeriod": {
    "description": "Health check grace period in seconds",
    "type": "number"
   },
   "launchConfigurationNo": {
    "description": "New launch configuration number",
    "type": "string"
   },
   "maxSize": {
    "description": "New maximum number of instances",
    "type": "number"
   },
   "minSize": {
    "description": "New minimum number of instances",
    "type": "number"
   }
  },
  "required": [
   "autoScalingGroupNo"
  ],
  "type": "object"
 },
 "name": "ncloud_update_asg"
}
