{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Find errors from the last game launch and group them by category, with source files, lines and fix hints. Show which files changed since the log and which errors appeared after a relaunch; mod entries come first. Example: {\"scope\":\"mod\",\"category\":\"effect\"}. Returns at most 20 entries (limit 50) with fix hints and which entries are new since the previous launch.","inputSchema":{"additionalProperties":false,"properties":{"category":{"enum":["syntax","duplicate","localisation","effect","trigger","scope","graphics","interface","map","missing_reference","other"],"type":"string"},"limit":{"default":20,"maximum":50,"minimum":1,"type":"integer"},"offset":{"default":0,"maximum":1000000,"minimum":0,"type":"integer"},"query":{"maxLength":200,"minLength":1,"type":"string"},"scope":{"default":"all","enum":["all","mod","unlocated"],"type":"string"},"workspaceId":{"default":"current","pattern":"^[a-z][a-z0-9_-]{0,63}$","type":"string"}},"type":"object"},"name":"hoi4.error_log","outputSchema":{"additionalProperties":false,"properties":{"artifacts":{"items":{},"maxItems":32,"type":"array"},"blockers":{"items":{},"type":"array"},"changedFiles":{"items":{},"type":"array"},"code":{"type":"string"},"data":{"additionalProperties":{},"properties":{},"type":"object"},"diagnostics":{"items":{},"maxItems":20,"type":"array"},"filesScanned":{"items":{},"type":"array"},"proposedFiles":{"items":{},"type":"array"},"status":{"enum":["ok","blocked","error"],"type":"string"},"validation":{},"workspaceId":{"type":"string"}},"required":["status","code","workspaceId","validation","data"],"type":"object"},"title":"Read the game error log"}
