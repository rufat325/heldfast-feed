{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create the first interview guide on a project. Use this to upload a new guide. Pass structured fields, not markdown: intro, blocks (title, minutes, notes, questions with text/note/key), and notes_template. Needs at least one block with a title. Fails if the project already has a guide \u2014 then use guides_edit. Core does not show the guide. Live reads it on the project.",
 "inputSchema": {
  "properties": {
   "blocks": {
    "description": "Timed sections in interview order.",
    "items": {
     "properties": {
      "minutes": {
       "description": "Minutes allocated to this block.",
       "type": "integer"
      },
      "notes": {
       "description": "Block note shown to the interviewer.",
       "type": "string"
      },
      "questions": {
       "items": {
        "properties": {
         "key": {
          "description": "True if this is a must-ask question.",
          "type": "boolean"
         },
         "note": {
          "description": "Interviewer note under the question.",
          "type": "string"
         },
         "text": {
          "description": "Spoken question.",
          "type": "string"
         }
        },
        "required": [
         "text"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "title": {
       "description": "Block title, e.g. Opening.",
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "intro": {
    "description": "Spoken opening before the first block.",
    "type": "string"
   },
   "notes_template": {
    "description": "Post-interview notes template (conspect).",
    "type": "string"
   },
   "project_id": {
    "description": "Project UUID.",
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "blocks"
  ],
  "type": "object"
 },
 "name": "guides_create",
 "title": "Guides Create"
}
