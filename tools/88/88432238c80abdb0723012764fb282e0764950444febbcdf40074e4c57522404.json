{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a reservation"
 },
 "description": "Create a reservation (or a blocked period) on a property. Smoobu treats it like a booking from a channel and SYNCS the blocked dates to every connected channel (Airbnb, Booking.com, ...). Fails if the dates overlap an existing booking. This server offers no cancel \u2014 cancel it in Smoobu if needed. Which guest fields are mandatory depends on your booking-tool 'Form Content' settings. Smoobu: POST /api/reservations.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "description": "Guest address.",
    "properties": {
     "location": {
      "description": "City / town.",
      "type": "string"
     },
     "postalCode": {
      "type": "string"
     },
     "street": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "adults": {
    "description": "Number of adults.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "apartment_id": {
    "description": "The property id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "arrival_date": {
    "description": "Arrival date (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "arrival_time": {
    "description": "Arrival time (HH:mm, 24h).",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "channel_id": {
    "description": "Channel id (defaults to 70). Must be a channel the account has, e.g. 13 = Direct booking, 11 = Blocked channel.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "children": {
    "description": "Number of children.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "country": {
    "description": "Guest country.",
    "type": "string"
   },
   "departure_date": {
    "description": "Departure date (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "departure_time": {
    "description": "Departure time (HH:mm, 24h).",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "deposit": {
    "description": "Deposit amount.",
    "type": "number"
   },
   "deposit_status": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     }
    ],
    "description": "Deposit status: 0 = open / not paid, 1 = paid in full."
   },
   "email": {
    "description": "Guest email.",
    "type": "string"
   },
   "first_name": {
    "description": "Guest first name.",
    "type": "string"
   },
   "language": {
    "description": "Guest language, e.g. en, de, es.",
    "type": "string"
   },
   "last_name": {
    "description": "Guest last name.",
    "type": "string"
   },
   "notice": {
    "description": "Free-text notes on the booking.",
    "type": "string"
   },
   "phone": {
    "description": "Guest phone.",
    "type": "string"
   },
   "prepayment": {
    "description": "Prepayment amount.",
    "type": "number"
   },
   "prepayment_status": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     }
    ],
    "description": "Prepayment status: 0 = open / not paid, 1 = paid in full."
   },
   "price": {
    "description": "Total price of the booking.",
    "type": "number"
   },
   "price_elements": {
    "description": "Optional price breakdown (base price, cleaning fee, ...).",
    "items": {
     "properties": {
      "amount": {
       "description": "Amount.",
       "type": "number"
      },
      "currencyCode": {
       "description": "ISO 4217 currency code, e.g. EUR.",
       "maxLength": 3,
       "minLength": 3,
       "type": "string"
      },
      "name": {
       "description": "Display name, e.g. 'Cleaning fee'.",
       "type": "string"
      },
      "quantity": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Quantity, if applicable."
      },
      "sortOrder": {
       "description": "Display order (ascending).",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "tax": {
       "description": "Tax, if applicable.",
       "type": [
        "number",
        "null"
       ]
      },
      "type": {
       "description": "Price element type.",
       "enum": [
        "basePrice",
        "cleaningFee",
        "addon",
        "longStayDiscount",
        "coupon"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "amount",
      "currencyCode"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "price_status": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     }
    ],
    "description": "Price status: 0 = open / not paid, 1 = paid in full."
   }
  },
  "required": [
   "apartment_id",
   "arrival_date",
   "departure_date"
  ],
  "type": "object"
 },
 "name": "smoobu_create_reservation",
 "title": "Create a reservation"
}
