_status","reason"],"type":"object"},"type":"array"},"unavailable_listing_count":{"minimum":0,"type":"integer"},"unknown_price_count":{"minimum":0,"type":"integer"},"unknown_price_listing_ids":{"items":{"type":"string"},"type":"array"},"vehicles":{"items":{"$ref":"#/$defs/vehicle_detail"},"maxItems":4,"type":"array"}},"required":["currency","vehicles","not_found","unavailable","requested_listing_count","found_listing_count","not_found_listing_count","unavailable_listing_count","known_price_count","unknown_price_count","known_price_listing_ids","unknown_price_listing_ids","price_comparison_complete","cheapest_listing_id","price_comparison_notice"],"type":"object"},{"$ref":"#/$defs/error"}],"type":"object"},"title":"Compare shortlisted car listings"}
