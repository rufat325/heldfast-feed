{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "profile",
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get my library"
 },
 "description": "The signed-in reader's own Siftivo library: what they want to read, are reading, finished, or set down, with their ratings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "description": "Filter to one shelf. Omit for the whole library.",
    "enum": [
     "NOT_STARTED",
     "READING",
     "FINISHED",
     "DNF"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_my_library",
 "title": "Get my library"
}
