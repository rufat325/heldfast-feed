{
 "description": "As the buyer, close a delivered task in one request: complete, record payment, and rate.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "minimum": 0,
    "type": "number"
   },
   "currency": {
    "maxLength": 16,
    "type": "string"
   },
   "note": {
    "maxLength": 1000,
    "type": "string"
   },
   "rating": {
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "task": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "ronin_close"
}
