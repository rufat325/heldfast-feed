    "enum": [
     "ECO",
     "BTC",
     "ETH"
    ],
    "type": "string"
   },
   "token_out": {
    "description": "Output token (e.g., BTC, ECO)",
    "enum": [
     "ECO",
     "BTC",
     "ETH"
    ],
    "type": "string"
   }
  },
  "required": [
