{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Previews partial field patches by default. To apply, set dryRun to false and provide expectedFieldHashes for every submitted field from get-note-details or a dry run. Validates the complete batch before writing and verifies saved values. Each submitted field replaces its complete value, including HTML.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"dryRun":{"default":true,"description":"Preview bounded raw HTML changes and full-value hashes without modifying Anki. Set false to apply with expectedFieldHashes.","type":"boolean"},"updates":{"items":{"properties":{"expectedFieldHashes":{"additionalProperties":{"description":"SHA-256 of the complete UTF-8 field value, including HTML","pattern":"^[a-f0-9]{64}$","type":"string"},"description":"Expected hashes keyed by field name, from get-note-details or a dry run. Required for every submitted field when applying; unrelated fields are not checked.","propertyNames":{"maxLength":500,"minLength":1,"type":"string"},"type":"object"},"fields":{"additionalProperties":{"maxLength":500000,"type":"string"},"description":"Partial field patch. Each submitted field replaces its complete value; other fields remain unchanged.","propertyNames":{"maxLength":500,"minLength":1,"type":"string"},"type":"object"},"noteId":{"description":"Anki note ID","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"required":["noteId","fields"],"type":"object"},"maxItems":50,"minItems":1,"type":"array"}},"required":["updates"],"type":"object"},"name":"update-note-fields","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"applied":{"type":"boolean"},"changedFieldCount":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"changes":{"items":{"additionalProperties":false,"properties":{"afterFieldHash":{"description":