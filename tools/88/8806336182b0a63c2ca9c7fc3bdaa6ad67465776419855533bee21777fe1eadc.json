{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an ADS-B aircraft scaffold with sanitized aircraft rows, altitude bands, track history metadata, adapter source, and feed/privacy notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "rest_json",
    "enum": [
     "rest_json",
     "websocket_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9074/aircraft",
    "type": "string"
   },
   "aircraft_count": {
    "default": 32,
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "airspace_label": {
    "default": "venue_airspace",
    "type": "string"
   },
   "altitude_band_count": {
    "default": 6,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "adsb_aircraft_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the ADS-B scaffold.",
    "type": "string"
   },
   "provider": {
    "default": "dump1090",
    "enum": [
     "dump1090",
     "tar1090",
     "opensky_adapter",
     "custom"
    ],
    "type": "string"
   },
   "track_history_count": {
    "default": 24,
    "maximum": 2048,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_adsb_aircraft_bus",
 "title": "Connect ADS-B aircraft bus"
}
