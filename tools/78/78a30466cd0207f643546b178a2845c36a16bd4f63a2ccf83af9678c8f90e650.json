{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Query widget preview chart data from Cloud Insight by specifying metrics directly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "metricsInfo": {
    "description": "Metric definitions to preview (WidgetMetricInfoDto[])",
    "items": {
     "additionalProperties": false,
     "properties": {
      "color": {
       "description": "Chart color (e.g., #1f77b4)",
       "type": "string"
      },
      "dimensions": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Dimension filters as key-value pairs",
       "type": "object"
      },
      "displayName": {
       "description": "Metric display name on the widget",
       "type": "string"
      },
      "metric": {
       "description": "Metric name to query",
       "type": "string"
      },
      "period": {
       "description": "Aggregation interval",
       "enum": [
        "Min1",
        "Min5",
        "Min30",
        "Hour2",
        "Day1"
       ],
       "type": "string"
      },
      "prodKey": {
       "description": "Product key (cw_key)",
       "type": "string"
      },
      "productName": {
       "description": "Product name (e.g., \"System/Server(VPC)\")",
       "type": "string"
      },
      "resourceId": {
       "description": "Resource ID",
       "type": "string"
      },
      "resourceName": {
       "description": "Resource name",
       "type": "string"
      },
      "statistic": {
       "description": "Aggregation function",
       "enum": [
        "COUNT",
        "SUM",
        "MAX",
        "MIN",
        "AVG"
       ],
       "type": "string"
      }
     },
     "required": [
      "prodKey",
      "metric",
      "statistic",
      "period"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "periodEnd": {
    "description": "End time in Unix epoch milliseconds",
    "type": "number"
   },
   "periodStart": {
    "description": "Start time in Unix epoch milliseconds",
    "type": "number"
   }
  },
  "required": [
   "periodStart",
   "periodEnd",
   "metricsInfo"
  ],
  "type": "object"
 },
 "name": "ncloud_query_widget_preview"
}
