{
 "description": "File an issue (bug / enhancement / feature / task) against a project. Requires `write` scope. appId and title are required.",
 "inputSchema": {
  "properties": {
   "appId": {
    "description": "Project id the issue belongs to (required)",
    "type": "string"
   },
   "assignedToUid": {
    "description": "Assignee user id",
    "type": "string"
   },
   "description": {
    "description": "Issue body",
    "type": "string"
   },
   "dueDate": {
    "description": "Due date (ISO date string)",
    "type": "string"
   },
   "estimateMinutes": {
    "description": "Estimate in minutes",
    "type": "number"
   },
   "issueType": {
    "description": "Type (default 'bug')",
    "enum": [
     "bug",
     "enhancement",
     "feature",
     "task"
    ],
    "type": "string"
   },
   "labels": {
    "description": "Labels",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "severity": {
    "description": "Severity (default 'minor')",
    "enum": [
     "minor",
     "major",
     "critical",
     "blocker"
    ],
    "type": "string"
   },
   "startDate": {
    "description": "Start date (ISO date string)",
    "type": "string"
   },
   "status": {
    "description": "Status (default 'newBug')",
    "enum": [
     "newBug",
     "triaged",
     "inProgress",
     "blocked",
     "fixed",
     "verified",
     "wontFix",
     "duplicate"
    ],
    "type": "string"
   },
   "title": {
    "description": "Issue title (required)",
    "type": "string"
   }
  },
  "required": [
   "appId",
   "title"
  ],
  "type": "object"
 },
 "name": "create_issue"
}
