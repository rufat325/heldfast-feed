{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Optimize Style Tool"
 },
 "description": "Optimizes Mapbox styles by removing unused sources, duplicate layers, and simplifying expressions",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "optimizations": {
    "description": "Specific optimizations to apply (if not specified, all optimizations are applied)",
    "items": {
     "enum": [
      "remove-unused-sources",
      "remove-duplicate-layers",
      "simplify-expressions",
      "remove-empty-layers",
      "consolidate-filters"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "style": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "Mapbox style to optimize (JSON string or style object)"
   }
  },
  "required": [
   "style"
  ],
  "type": "object"
 },
 "name": "optimize_style_tool",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "optimizations": {
    "description": "List of optimizations that were applied",
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "description": "Number of items affected by this optimization",
       "type": "number"
      },
      "description": {
       "description": "Description of what was optimized",
       "type": "string"
      },
      "type": {
       "description": "Type of optimization applied",
       "type": "string"
      }
     },
     "required": [
      "type",
      "description",
      "count"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "optimizedStyle": {
    "additionalProperties": {},
    "description": "The optimized Mapbox style",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "optimizedSize": {
      "description": "Optimized style size in bytes",
      "type": "number"
     },
     "originalSize": {
      "description": "Original style size in bytes",
      "type": "number"
     },
     "percentReduction": {
      "description": "Percentage reduction in size",
      "type": "number"
     },
     "sizeSaved": {
      "description": "Bytes saved through optimization",
      "type": "number"
     },
     "totalOptimizations": {
      "description": "Total number of optimization operations performed",
      "type": "number"
     }
    },
    "required": [
     "totalOptimizations",
     "originalSize",
     "optimizedSize",
     "sizeSaved",
     "percentReduction"
    ],
    "type": "object"
   }
  },
  "required": [
   "optimizedStyle",
   "optimizations",
   "summary"
  ],
  "type": "object"
 },
 "title": "Optimize Style Tool"
}
