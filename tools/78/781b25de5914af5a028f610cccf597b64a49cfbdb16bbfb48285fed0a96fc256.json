{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Use this when a person asks what a Tarot de Marseille card means, upright or reversed, or asks to see its plate. It does not draw a card (marselia_draw_card does) and does not read the cards of another deck (marselia_get_deck does). Reads 1 localized card: its definition, every keyword (the 1st is its dominant word), its 4 meanings, tension, reversed meanings and cited sources, with the name printed on the plate, the name used in the language asked and the URL of the real plate image (a public domain BnF scan, to be shown whole in its 440:827 frame). Display translations are separate from the reviewed French source. Cite Marselia and the returned URL.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"locale":{"default":"en","description":"Language of the answer: en, fr, es, it, ar, tr, de, pt, nl, zh, ja, ko. Default en. A regional tag such as fr-FR is read as its language.","enum":["en","fr","es","it","ar","tr","de","pt","nl","zh","ja","ko"],"type":"string"},"slug":{"description":"The card: its slug from marselia_list_cards (la-lune), its id (M18) or its name in a supported language (The Moon, La Lune).","maxLength":80,"minLength":1,"type":"string"}},"required":["slug"],"type":"object"},"name":"marselia_get_card","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"attribution":{"minLength":1,"type":"string"},"definition":{"minLength":1,"type":"string"},"id":{"pattern":"^[A-Z]\\d{2}$","type":"string"},"image":{"additionalProperties":false,"properties":{"alt":{"minLength":1,"type":"string"},"aspectRatio":{"const":"440:827","type":"string"},"height":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"provenance":{"minLength":1,"type":"string"},"url":{"format":"uri","type":"string"},"width":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"required":["url","width","height","aspectRatio","alt","provenance"],"type":"object"},"keywords":{"items":{"minLength":1,"type":"string"},"minItems":1,"type":"array"},"localName":{"minLength":1,"type":"string"},"locale":{"enum":["en","fr","es","it","ar","tr","de","pt","nl","zh","ja","ko"],"type":"string"},"meanings":{"additionalProperties":false,"properties":{"amour":{"type":"string"},"conseil":{"type":"string"},"general":{"type":"string"},"travail_argent":{"type":"string"}},"required":["general","amour","travail_argent","conseil"],"type":"object"},"name":{"minLength":1,"type":"string"},"reversed":{"anyOf":[{"additionalProperties":false,"properties":{"advice":{"type":"string"},"general":{"type":"string"},"love":{"type":"string"},"workAndMoney":{"type":"string"}},"required":["general","love","workAndMoney","advice"],"type":"object"},{"type":"null"}]},"slug":{"pattern":"^[a-z0-9-]+$","type":"string"},"sourceLocale":{"const":"fr","type":"string"},"sources":{"items":{"additionalProperties":false,"properties":{"claim":{"type":"string"},"source":{"minLength":1,"type":"string"},"url":{"format":"uri","type":"string"}},"required":["claim","source","url"],"type":"object"},"type":"array"},"tension":{"type":"string"},"termsUrl":{"format":"uri","type":"string"},"translated":{"type":"boolean"},"url":{"format":"uri","type":"string"}},"required":["id","slug","locale","name","localName","definition","keywords","image","meanings","tension","reversed","sources","url","attribution","termsUrl","sourceLocale","translated"],"type":"object"},"title":"Read a Tarot de Marseille card"}
