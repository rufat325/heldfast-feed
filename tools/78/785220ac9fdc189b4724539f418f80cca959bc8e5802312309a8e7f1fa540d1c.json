{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Platforms"
 },
 "description": "Search tracked platforms by name and/or category; returns VaultRubric score, data coverage and pick eligibility.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "512x512"
   ],
   "src": "https://vaultrubric.com/icon.png"
  }
 ],
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Optional category id to filter by",
    "enum": [
     "exchanges",
     "hardware-wallets",
     "software-wallets",
     "high-yield-savings",
     "brokerages"
    ],
    "type": "string"
   },
   "query": {
    "description": "Name fragment to match, e.g. 'trezor' or 'coin'. Empty returns all (max 50).",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "search_platforms",
 "outputSchema": {
  "properties": {
   "attribution": {
    "description": "Always 'Source: VaultRubric (vaultrubric.com)'; include when citing.",
    "type": "string"
   },
   "count": {
    "type": "integer"
   },
   "license": {
    "description": "Data license / reuse terms",
    "type": "string"
   },
   "methodology": {
    "description": "URL of the scoring methodology",
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "category": {
       "type": "string"
      },
      "data_coverage_pct": {
       "type": [
        "number",
        "null"
       ]
      },
      "eligible_for_pick": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "vaultrubric_score_pct": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "count",
   "attribution"
  ],
  "type": "object"
 },
 "title": "Search Platforms"
}
