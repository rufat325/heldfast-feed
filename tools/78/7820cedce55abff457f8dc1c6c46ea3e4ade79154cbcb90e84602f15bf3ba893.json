{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Search scholarly papers (journal articles, preprints, reviews, datasets) on any topic: up to 25 results with title, year, DOI, authors, institutions, venue, citation count, open-access status and PDF link, abstract and topics. Filter by year range, open access only and type; sort by relevance, most cited or newest. Data from OpenAlex (CC0). Costs $0.003 USDC on Base via x402.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"limit":{"description":"Results, 1-25 (default 10)","pattern":"^\\d{1,2}$","type":"string"},"openAccess":{"description":"true: only open-access papers","enum":["true","false"],"type":"string"},"q":{"description":"Topic or phrase","pattern":"^[\\s\\S]+$","type":"string"},"since":{"description":"Published in or after this year","pattern":"^\\d{4}$","type":"string"},"sort":{"description":"Order (default relevance)","enum":["relevance","cited","newest"],"type":"string"},"type":{"description":"Only this kind of work","enum":["article","review","preprint","book-chapter","dataset"],"type":"string"},"until":{"description":"Published in or before this year","pattern":"^\\d{4}$","type":"string"}},"required":["q"],"type":"object"},"name":"papers_search","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"properties":{"checkedAt":{"description":"string, e.g. \"2026-11-28T06:51:33.104Z\""},"papers":{"description":"array"},"query":{"description":"object"},"source":{"description":"string, e.g. \"OpenAlex (CC0)\""},"total":{"description":"number, e.g. 13678"}},"type":"object"},"title":"Papers search"}
