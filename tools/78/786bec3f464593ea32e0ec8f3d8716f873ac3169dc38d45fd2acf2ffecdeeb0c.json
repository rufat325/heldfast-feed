{
 "description": "Enroll an email into a sequence. Records the enrollment locally; if the sequence is bound to a CRM workflow + location, also POSTs the contact to the CRM. Idempotent \u2014 won't duplicate if already enrolled.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "first_name": {
    "type": "string"
   },
   "last_name": {
    "type": "string"
   },
   "phone": {
    "type": "string"
   },
   "sequence_id": {
    "type": "string"
   },
   "submission_id": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "sequence_id",
   "email"
  ],
  "type": "object"
 },
 "name": "rc_sequence_enroll"
}
