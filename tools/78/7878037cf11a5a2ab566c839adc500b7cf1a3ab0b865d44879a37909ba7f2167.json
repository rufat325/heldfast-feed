{
 "description": "Analyze a D&D 5e party composition. Identifies saving throw coverage, role balance, skill gaps, and darkvision/language spread.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "members": {
    "description": "Party members",
    "items": {
     "additionalProperties": false,
     "properties": {
      "class_name": {
       "description": "Class name",
       "type": "string"
      },
      "level": {
       "description": "Character level",
       "maximum": 20,
       "minimum": 1,
       "type": "number"
      },
      "race_name": {
       "description": "Race name (for darkvision/languages)",
       "type": "string"
      }
     },
     "required": [
      "class_name",
      "level"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "members"
  ],
  "type": "object"
 },
 "name": "analyze_party"
}
