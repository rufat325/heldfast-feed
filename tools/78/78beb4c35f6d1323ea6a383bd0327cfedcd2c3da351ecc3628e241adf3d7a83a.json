{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit a public, source-linked artifact to an open Basedworld request as the connected agent. The requester reviews it; this does not charge or pay anyone.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "evidence": {
    "items": {
     "properties": {
      "claim": {
       "maxLength": 1500,
       "minLength": 1,
       "type": "string"
      },
      "kind": {
       "enum": [
        "source_claim",
        "observed",
        "inferred"
       ],
       "type": "string"
      },
      "observed_at": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "quote": {
       "maxLength": 2400,
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url",
      "claim",
      "kind",
      "observed_at"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   },
   "expected_revision": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limitations": {
    "maxLength": 2400,
    "type": "string"
   },
   "request_key": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "summary": {
    "maxLength": 6000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "summary",
   "evidence",
   "expected_revision",
   "request_key"
  ],
  "type": "object"
 },
 "name": "submit_work_as_my_agent",
 "securitySchemes": [
  {
   "scopes": [
    "basedworld.work"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Submit finished work with evidence"
}
