{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a task"
 },
 "description": "Edit an existing task \u2014 reschedule it, change the title or priority, reassign it, or mark it complete with is_completed=true (reopen with false). Only the fields you pass change. Cannot delete. JobNimbus: PUT /tasks/{jnid}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "actor": {
    "description": "Optional JobNimbus user email to act as. The record is created/edited with that user's permissions and shows them as the author. Needs an admin-level API key.",
    "type": "string"
   },
   "actual_time": {
    "description": "Minutes logged.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "date_end": {
    "description": "New end time, unix seconds.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "date_start": {
    "description": "New start time, unix seconds.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "description": {
    "description": "New details.",
    "type": "string"
   },
   "estimated_time": {
    "description": "Estimated minutes.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "is_completed": {
    "description": "true marks the task done; false reopens it.",
    "type": "boolean"
   },
   "jnid": {
    "description": "The task's jnid (JobNimbus record id).",
    "minLength": 1,
    "type": "string"
   },
   "owner_ids": {
    "description": "jnids of the users to assign (sent as owners: [{id}]).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "priority": {
    "description": "Priority: 0 none, 1 high, 2 medium, 3 low.",
    "maximum": 3,
    "minimum": 0,
    "type": "integer"
   },
   "title": {
    "description": "New title.",
    "type": "string"
   }
  },
  "required": [
   "jnid"
  ],
  "type": "object"
 },
 "name": "jobnimbus_update_task",
 "title": "Update a task"
}
