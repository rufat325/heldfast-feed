{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Screen a supplied trade series for repeated volume at nearly equal prices within a declared time window. Return recycled-volume ratio and cycles; a pattern does not prove wash trading.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "price_band_pct": {
    "default": 0.25,
    "maximum": 5,
    "minimum": 0.01,
    "type": "number"
   },
   "trades": {
    "items": {
     "properties": {
      "price": {
       "minimum": 0,
       "type": "number"
      },
      "ts_s": {
       "minimum": 0,
       "type": "number"
      },
      "volume": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "ts_s",
      "price",
      "volume"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "minItems": 20,
    "type": "array"
   },
   "window_s": {
    "default": 3600,
    "maximum": 86400,
    "minimum": 60,
    "type": "number"
   }
  },
  "required": [
   "trades"
  ],
  "type": "object"
 },
 "name": "screen_wash_trading"
}
