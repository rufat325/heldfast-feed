{
 "description": "Retrieves the current Uptime Kuma server settings including timezone, authentication status, primary base URL, and other configuration options.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "includeSecrets": {
    "description": "Return credentials in full instead of \"***\". Off by default: this output is persisted in conversation transcripts and logs. Can also be enabled globally with UPTIME_KUMA_INCLUDE_SECRETS=true.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "getSettings",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "settings": {
    "additionalProperties": false,
    "description": "Current Uptime Kuma server settings",
    "properties": {
     "checkUpdate": {
      "description": "Check for updates",
      "type": "boolean"
     },
     "disableAuth": {
      "description": "Authentication disabled",
      "type": "boolean"
     },
     "dnsCache": {
      "description": "DNS cache enabled",
      "type": "boolean"
     },
     "domainExpiryNotifyDays": {
      "description": "Domain expiry notification days",
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "entryPage": {
      "description": "Entry page (dashboard/statuspage)",
      "type": "string"
     },
     "keepDataPeriodDays": {
      "description": "Data retention period (days)",
      "type": "number"
     },
     "nscd": {
      "description": "NSCD enabled",
      "type": "boolean"
     },
     "primaryBaseURL": {
      "description": "Primary base URL",
      "type": "string"
     },
     "searchEngineIndex": {
      "description": "Allow search engine indexing",
      "type": "boolean"
     },
     "serverTimezone": {
      "description": "Server timezone",
      "type": "string"
     },
     "tlsExpiryNotifyDays": {
      "description": "TLS expiry notification days",
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "trustProxy": {
      "description": "Trust proxy headers",
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "settings"
  ],
  "type": "object"
 },
 "title": "Get Settings"
}
