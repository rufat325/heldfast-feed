{
 "_meta": {
  "openai/toolInvocation/invoked": "Hotel details ready",
  "openai/toolInvocation/invoking": "Opening the hotel\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Hotel details"
 },
 "description": "Full details of one hotel from search_hotels by its hotel_key: address, description, amenities, photos, check-in/check-out times, places nearby, a summary of guest opinions and the page url. With check_in/check_out it also checks availability live and returns an `availability` block: available true/false for those dates, with the real price when a room is free. availability.checked false means the supplier did not answer \u2014 the price is a catalogue price for other dates, not a confirmation. Always give the traveller the url of every item as a clickable link, unchanged: it is the only way to book or buy.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "adults": {
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "check_in": {
    "description": "YYYY-MM-DD.",
    "type": "string"
   },
   "check_out": {
    "description": "YYYY-MM-DD.",
    "type": "string"
   },
   "children": {
    "maximum": 4,
    "minimum": 0,
    "type": "integer"
   },
   "children_ages": {
    "description": "Ages of the children, comma separated, e.g. \"4,9\".",
    "type": "string"
   },
   "hotel_key": {
    "description": "hotel_key returned by search_hotels.",
    "type": "string"
   },
   "lang": {
    "description": "Language of the answer and of the links: es, en, de, fr, it, pt, tr or ru. Default es.",
    "type": "string"
   },
   "nationality": {
    "description": "Guest nationality, ISO-3166 alpha-2.",
    "type": "string"
   }
  },
  "required": [
   "hotel_key"
  ],
  "type": "object"
 },
 "name": "get_hotel",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "address": {
    "type": "string"
   },
   "amenities": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "city_url": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "hotel": {
