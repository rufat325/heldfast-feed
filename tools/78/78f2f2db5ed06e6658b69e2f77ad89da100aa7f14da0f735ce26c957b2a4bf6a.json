{
 "description": "Register a webhook (notifica\u00e7\u00e3o) to receive Bling events",
 "inputSchema": {
  "properties": {
   "ativo": {
    "description": "Whether the webhook is active",
    "type": "boolean"
   },
   "descricao": {
    "description": "Webhook description",
    "type": "string"
   },
   "modulo": {
    "description": "Module to listen to (e.g., pedido.venda)",
    "type": "string"
   },
   "url": {
    "description": "Target URL to receive callbacks",
    "type": "string"
   }
  },
  "required": [
   "url",
   "modulo"
  ],
  "type": "object"
 },
 "name": "subscribe_webhook"
}
