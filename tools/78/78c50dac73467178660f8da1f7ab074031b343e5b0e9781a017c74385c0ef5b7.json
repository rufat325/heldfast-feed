{
 "description": "Generate AI logo concepts (icon + palette + typography + layout) for a business. Returns N variations. Requires Founder sub or one-time LOGO_PACK/BRAND_KIT purchase. [Requires a free namemy.app API key \u2014 get one at https://namemy.app/app/api-keys]",
 "inputSchema": {
  "properties": {
   "count": {
    "default": 4,
    "description": "Number of variations (1-9)",
    "type": "number"
   },
   "description": {
    "description": "What the business does",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "preferences": {
    "properties": {
     "colorPalette": {
      "type": "string"
     },
     "industry": {
      "type": "string"
     },
     "styles": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "slogan": {
    "type": "string"
   }
  },
  "required": [
   "name",
   "description"
  ],
  "type": "object"
 },
 "name": "generate_logo"
}
