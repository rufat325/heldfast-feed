{
 "description": "Update an existing visualization on the canvas. You can change its data, title, description, or any other property.",
 "inputSchema": {
  "properties": {
   "description": {
    "description": "Updated description",
    "type": "string"
   },
   "id": {
    "description": "ID of the visualization to update",
    "type": "string"
   },
   "mermaid": {
    "description": "Updated Mermaid diagram syntax",
    "type": "string"
   },
   "series": {
    "description": "Updated data series for charts",
    "items": {
     "properties": {
      "data": {
       "items": {
        "items": {
         "type": "number"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "data"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "table": {
    "description": "Updated table data",
    "properties": {
     "headers": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "rows": {
      "items": {
       "items": {
        "type": [
         "string",
         "number"
        ]
       },
       "type": "array"
      },
      "type": "array"
     }
    },
    "required": [
     "headers",
     "rows"
    ],
    "type": "object"
   },
   "title": {
    "description": "Updated title",
    "type": "string"
   },
   "type": {
    "description": "Type of visualization",
    "enum": [
     "line",
     "bar",
     "scatter",
     "table",
     "flowchart",
     "pie"
    ],
    "type": "string"
   },
   "xLabels": {
    "description": "Updated x-axis labels",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "updateVisualization"
}
