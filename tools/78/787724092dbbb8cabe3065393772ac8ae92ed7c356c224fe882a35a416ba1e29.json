      "status": 200
     },
     {
      "attempt": 2,
      "event_id": "evt-2",
      "status": 202
     },
     {
      "attempt": 1,
      "event_id": "evt-3",
      "status": 503
     },
     {
      "attempt": 2,
      "event_id": "evt-3",
