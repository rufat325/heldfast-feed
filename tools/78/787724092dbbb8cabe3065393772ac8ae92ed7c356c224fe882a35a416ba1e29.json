      "status": 503
     },
     {
      "attempt": 1,
      "event_id": "evt-4",
      "status": 502
     },
     {
      "attempt": 1,
      "status": 200
     }
    ],
    "items": {
     "type": "object"
    },
    "maxItems": 2000,
    "minItems": 1,
    "type": "array"
   },
   "max_attempts": {
    "description": "The attempt budget, used to tell an event that is still retrying from one that is lost. Defaults to 5.",
    "example": 4,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "success_statuses": {
    "description": "Statuses that count as delivered. Defaults to 200, 201, 202 and 204.",
    "example": [
     200,
     202,
     204
    ],
    "items": {
     "maximum": 599,
     "minimum": 100,
     "type": "integer"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
