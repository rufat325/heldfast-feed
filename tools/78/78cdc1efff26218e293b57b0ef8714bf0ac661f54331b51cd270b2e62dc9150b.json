{
 "annotations": {
  "destructiveHint": true,
  "title": "Add a note to a record"
 },
 "description": "Add a note (title + body) to a Contact, Organisation, Lead, Opportunity or Project. Insightly: POST /<Object>/{id}/Notes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "body": {
    "description": "Note body (may contain HTML).",
    "type": "string"
   },
   "id": {
    "description": "The record's numeric id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "object": {
    "description": "The record type to attach the note to.",
    "enum": [
     "Contacts",
     "Organisations",
     "Leads",
     "Opportunities",
     "Projects"
    ],
    "type": "string"
   },
   "title": {
    "description": "Note title (required).",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "object",
   "id",
   "title"
  ],
  "type": "object"
 },
 "name": "insightly_add_note",
 "title": "Add a note to a record"
}
