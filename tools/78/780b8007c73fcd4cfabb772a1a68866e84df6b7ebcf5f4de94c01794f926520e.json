"s":{"pattern":"^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$","type":"string"},"t":{"additionalProperties":false,"properties":{"limit":{"additionalProperties":false,"properties":{"tif":{"const":"Ioc","type":"string"}},"required":["tif"],"type":"object"}},"required":["limit"],"type":"object"}},"required":["a","b","p","s","r","t","c"],"type":"object"},"maxItems":1,"minItems":1,"type":"array"},"type":{"const":"order","type":"string"}},"required":["type","orders","grouping"],"type":"object"},"expiresAfter":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["action","expiresAfter"],"type":"object"}},"required":["guard","order"],"type":"object"},"name":"hyperliquid_perp_guard_exact_call"}
