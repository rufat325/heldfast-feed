{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "appskyline:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://appskyline/keyword-rank-v6.html"
  },
  "ui/resourceUri": "ui://appskyline/keyword-rank-v6.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check an app's keyword rank"
 },
 "description": "Use this when someone asks where their app ranks for a keyword right now in one store and country. Returns the app's live position, or not-ranked, after scanning the top 50 results by default and up to 200, and renders a rank card. Not for how a rank changed over time.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "AppSkyline app id (uuid)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "country": {
    "description": "Two-letter store country code such as US or IT; defaults to US",
    "maxLength": 10,
    "type": "string"
   },
   "lang": {
    "description": "Two-letter language code such as en or it; defaults to en except on Google Play, which uses the store default",
    "maxLength": 32,
    "type": "string"
   },
   "num": {
    "default": 50,
    "description": "How many search results to scan for the app, from 1 to 200; defaults to 50",
    "exclusiveMinimum": 0,
    "maximum": 200,
    "type": "integer"
   },
   "store": {
    "description": "Store to check: ios-app-store, macos-app-store, google-play or microsoft-store; the app needs an id on that store",
    "enum": [
     "ios-app-store",
     "macos-app-store",
     "google-play",
     "microsoft-store"
    ],
    "type": "string"
   },
   "term": {
    "description": "Search term to check, 1 to 200 characters",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "appId",
   "store",
   "term"
  ],
  "type": "object"
 },
 "name": "get_keyword_rank",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "app": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "id",
       "name"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "country": {
    "anyOf": [
     {
      "maxLength": 10,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "lang": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "rank": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 200,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "1-based position; null unless status is ranked"
   },
   "resultsScanned": {
    "description": "How many results were scanned; report a rank as #N of this",
    "maximum": 200,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "enum": [
     "ranked",
     "not-ranked",
     "app-not-found",
     "store-not-configured"
    ],
    "type": "string"
   },
   "store": {
    "enum": [
     "ios-app-store",
     "macos-app-store",
     "google-play",
     "microsoft-store"
    ],
    "type": "string"
   },
   "term": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "status",
   "app",
   "term",
   "store",
   "country",
   "lang",
   "rank",
   "resultsScanned"
  ],
  "type": "object"
 },
 "title": "Check an app's keyword rank"
}
