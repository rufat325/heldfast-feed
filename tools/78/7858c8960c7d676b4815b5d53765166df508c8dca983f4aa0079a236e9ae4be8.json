{
 "description": "Estimate the savings target needed for Financial Independence / Early Retirement. Runs Monte Carlo simulation and returns the probability the portfolio survives the planning horizon.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "annual_expense": {
    "description": "Projected annual spending in retirement (in selected currency).",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "apply_inflation": {
    "default": true,
    "type": "boolean"
   },
   "currency": {
    "default": "USD",
    "enum": [
     "USD",
     "EUR",
     "GBP",
     "CHF",
     "JPY",
     "CAD",
     "AUD",
     "DKK"
    ],
    "type": "string"
   },
   "current_savings": {
    "default": 0,
    "description": "Current liquid + invested assets.",
    "minimum": 0,
    "type": "number"
   },
   "inflation_rate": {
    "default": 3,
    "maximum": 30,
    "minimum": 0,
    "type": "number"
   },
   "portfolio_return_rate": {
    "default": 5,
    "description": "Expected real annual return %.",
    "maximum": 30,
    "minimum": 0,
    "type": "number"
   },
   "portfolio_volatility": {
    "default": 12,
    "description": "Annual return standard deviation %.",
    "maximum": 50,
    "minimum": 0,
    "type": "number"
   },
   "years": {
    "description": "Planning horizon in years.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "annual_expense",
   "years"
  ],
  "type": "object"
 },
 "name": "calculate_fire_target"
}
