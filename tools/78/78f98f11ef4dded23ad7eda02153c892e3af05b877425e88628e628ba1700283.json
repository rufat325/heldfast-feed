{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Save a wedding-day run sheet"},"description":"[Sign-in required] Writes a reviewed timeline to the wedding as the day-of run sheet, replacing the one there \u2014 costs no credits and returns the number of events saved and the number replaced. Times are 24h HH:MM in chronological order; an out-of-order sheet is refused before anything is written.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"events":{"items":{"additionalProperties":false,"properties":{"description":{"maxLength":500,"type":"string"},"location":{"maxLength":160,"type":"string"},"owner":{"maxLength":160,"type":"string"},"photoUrl":{"format":"uri","maxLength":500,"type":"string"},"time":{"pattern":"^([01]\\d|2[0-3]):[0-5]\\d$","type":"string"},"title":{"maxLength":160,"minLength":1,"type":"string"}},"required":["time","title"],"type":"object"},"maxItems":60,"minItems":1,"type":"array"},"idempotency_key":{"description":"any string of your choosing; the first result under it is returned again for 10 minutes","maxLength":128,"minLength":1,"type":"string"}},"required":["events"],"type":"object"},"name":"set_run_sheet","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"properties":{"changed":{"description":"whether anything was written","type":"boolean"},"charged":{"description":"credits actually spent; 0 today for every tool","type":"number"},"events":{"type":"number"},"links":{"description":"pages the user can open","items":{"additionalProperties":true,"properties":{"label":{"type":"string"},"url":{"type":"string"}},"required":["label","url"],"type":"object"},"type":"array"},"replaced_events":{"type":"number"},"summary":{"description":"one human sentence about the result","type":"string"}},"required":["summary","links","changed","charged"],"type"