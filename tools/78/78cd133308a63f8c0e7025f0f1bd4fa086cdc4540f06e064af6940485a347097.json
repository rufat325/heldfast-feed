{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Check domain citation presence"
 },
 "description": "Check whether a domain is cited by an AI engine across a cluster of queries. Returns per-query presence, rank, and a citation-rate summary. Use to measure visibility for a brand, product, or content site in AI search.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Domain to check, e.g. 'automatelab.tech' (without protocol).",
    "minLength": 1,
    "type": "string"
   },
   "engine": {
    "default": "auto",
    "description": "LLM engine to check for citations. 'auto' runs all available LLM engines and returns per-engine breakdown + cross-engine consensus. Pin to a specific engine to reduce cost. 'bing_serp' and 'brave_serp' measure web rank, not LLM citations \u2014 use check_citations for those.",
    "enum": [
     "perplexity",
     "claude",
     "openai",
     "gemini",
     "bing_serp",
     "brave_serp",
     "google_ai_mode",
     "auto"
    ],
    "type": "string"
   },
   "queries": {
    "description": "Queries to test the domain against. 1-20 queries per call.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "domain",
   "queries"
  ],
  "type": "object"
 },
 "name": "domain_am_i_cited",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "consensus": {
    "additionalProperties": {},
    "description": "Cross-engine consensus stats (multi_engine mode).",
    "type": "object"
   },
   "domain": {
    "description": "The domain that was checked.",
    "type": "string"
   },
   "engine": {
    "description": "Engine used (single_engine mode only).",
    "type": "string"
   },
   "engines": {
    "description": "Per-engine summary rows (multi_engine mode).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "citation_rate": {
       "type": "number"
      },
      "engine": {
       "type": "string"
      },
      "ok": {
       "type": "boolean"
      },
      "queries_cited": {
       "type": "number"
      },
      "surface": {
       "type": "string"
      }
     },
     "required": [
      "engine",
      "ok"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "fetched_at": {
    "description": "UTC ISO-8601 timestamp.",
    "type": "string"
   },
   "mode": {
    "description": "Whether one or multiple engines were queried.",
    "enum": [
     "single_engine",
     "multi_engine"
    ],
    "type": "string"
   },
   "per_engine": {
    "description": "Full per-engine detail (multi_engine mode).",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "results": {
    "description": "Per-query results (single_engine mode).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "cited": {
       "description": "Whether the domain was cited for this query.",
       "type": "boolean"
      },
      "matching_urls": {
       "description": "Matching citation URLs found.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "query": {
       "type": "string"
      },
      "rank": {
       "description": "1-based rank of the first matching citation.",
       "type": "number"
      }
     },
     "required": [
      "query",
      "cited",
      "matching_urls"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "additionalProperties": false,
    "description": "Aggregate summary (single_engine mode).",
    "properties": {
     "average_rank": {
      "description": "Average rank across cited queries.",
      "type": "number"
     },
     "citation_rate": {
      "description": "Fraction of queries where domain was cited (0-1).",
      "type": "number"
     },
     "queries_cited": {
      "type": "number"
     },
     "queries_total": {
      "type": "number"
     }
    },
    "required": [
     "queries_total",
     "queries_cited",
     "citation_rate"
    ],
    "type": "object"
   },
   "surface": {
    "description": "Engine surface type (single_engine mode only).",
    "type": "string"
   }
  },
  "required": [
   "domain",
   "mode",
   "fetched_at"
  ],
  "type": "object"
 }
}
