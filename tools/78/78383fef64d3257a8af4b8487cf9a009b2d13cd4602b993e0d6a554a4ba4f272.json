{
 "description": "Create a new resume for the authenticated user by directly specifying its content \u2014 name, headline, summary, contact info, work experience, education, skills, projects, certificates. Unlike the human resume builder at /app/resume-builder/, this tool skips layout and styling entirely \u2014 Datronis applies sensible defaults, which the user can still adjust later in the builder without losing anything you wrote. Requires a personal access token.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "description": "Your Datronis personal access token (starts with \"dtk_\"). Generate one at /app/api-keys/. Required unless sent as an `Authorization: Bearer <token>` HTTP header instead (preferred \u2014 see search_jobs' api_key description for why).",
    "type": "string"
   },
   "certificates": {
    "description": "Certifications. If provided, replaces this entire section \u2014 send the complete list, not just what changed.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "description": "YYYY-MM",
       "type": "string"
      },
      "id": {
       "description": "Omit to auto-generate.",
       "type": "string"
      },
      "issuer": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "contact": {
    "additionalProperties": false,
    "description": "Contact links shown in the header.",
    "properties": {
     "email": {
      "type": "string"
     },
     "github": {
      "type": "string"
     },
     "languages": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "linkedin": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "reddit": {
      "type": "string"
     },
     "telegram": {
      "type": "string"
     },
     "twitter": {
      "type": "string"
     },
     "website": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "customSections": {
    "description": "Extra named sections not covered above (awards, publications, volunteering, etc). If provided, replaces this entire section \u2014 send the complete list, not just what changed.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "description": "Omit to auto-generate.",
       "type": "string"
      },
      "items": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "bullets": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "id": {
          "description": "Omit to auto-generate.",
          "type": "string"
         },
         "subtitle": {
          "type": "string"
         },
         "title": {
          "type": "string"
         }
        },
        "required": [
         "title"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "title": {
       "description": "Section heading, e.g. \"Publications\" or \"Volunteering\".",
       "type": "string"
      }
     },
     "required": [
      "title",
      "items"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "education": {
    "description": "Education history. If provided, replaces this entire section \u2014 send the complete list, not just what changed.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "bullets": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "current": {
       "type": "boolean"
      },
      "degree": {
       "type": "string"
      },
      "endDate": {
       "description": "YYYY-MM",
       "type": "string"
      },
      "field": {
       "type": "string"
      },
      "id": {
       "description": "Omit to auto-generate.",
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "startDate": {
       "description": "YYYY-MM",
       "type": "string"
      },
      "university": {
       "type": "string"
      }
     },
     "required": [
      "university"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "experiences": {
    "description": "Work history, most recent first. If provided, replaces this entire section \u2014 send the complete list, not just what changed.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "bullets": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "company": {
       "type": "string"
      },
      "current": {
       "type": "boolean"
      },
      "endDate": {
       "description": "YYYY-MM, omit/empty if current",
       "type": "string"
      },
      "id": {
       "description": "Omit to auto-generate.",
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "startDate": {
       "description": "YYYY-MM",
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "company",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "headline": {
    "description": "Short professional title under the name, e.g. \"Senior Software Engineer\".",
    "type": "string"
   },
   "is_default": {
