   "locale": {
    "description": "2-letter locale code for this resume version, e.g. \"en\", \"de\". Defaults to \"en\".",
    "type": "string"
   },
   "location": {
    "description": "City, Country shown in the header.",
    "type": "string"
   },
   "name": {
    "description": "Full name shown on the resume header.",
    "type": "string"
   },
   "projects": {
    "description": "Projects section. If provided, replaces this entire section \u2014 send the complete list, not just what changed.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "bullets": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "endDate": {
       "type": "string"
      },
      "id": {
       "description": "Omit to auto-generate.",
       "type": "string"
      },
      "link": {
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "remote": {
       "type": "boolean"
      },
      "role": {
       "type": "string"
      },
      "startDate": {
       "type": "string"
      },
      "tech": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "skills": {
    "description": "Skill categories. If provided, replaces this entire section \u2014 send the complete list, not just what changed.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "description": "Omit to auto-generate.",
       "type": "string"
      },
      "name": {
       "description": "Category label, e.g. \"Programming\" or \"Backend\".",
       "type": "string"
      },
      "skills": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "skills"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "description": "2-4 sentence professional summary.",
    "type": "string"
   },
   "title": {
    "description": "Internal title to identify this resume, e.g. \"Backend Engineer \u2014 EU\". Defaults to \"Untitled Resume\".",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_resume"
}
