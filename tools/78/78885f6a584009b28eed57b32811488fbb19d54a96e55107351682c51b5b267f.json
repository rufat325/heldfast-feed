{"description":"VISUAL-ONLY redaction: draws opaque rectangles over regions on PDF pages. WARNING: this does NOT remove the underlying text or data from the PDF; it only covers it visually, and the original content can still be extracted programmatically. It is not suitable for sanitizing confidential documents. True redaction needs software that rewrites the PDF content stream, such as Adobe Acrobat Pro.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"color":{"default":"black","description":"Redaction color (default: black)","maxLength":32,"type":"string"},"filePath":{"description":"PDF file path","maxLength":4096,"type":"string"},"outputPath":{"description":"Output path","maxLength":4096,"type":"string"},"regions":{"description":"Regions to redact","items":{"additionalProperties":false,"properties":{"height":{"description":"Height in points","type":"number"},"page":{"description":"Page number (1-indexed)","type":"number"},"width":{"description":"Width in points","type":"number"},"x":{"description":"Left edge (points from left)","type":"number"},"y":{"description":"Bottom edge (points from bottom)","type":"number"}},"required":["page","x","y","width","height"],"type":"object"},"minItems":1,"type":"array"}},"required":["filePath","outputPath","regions"],"type":"object"},"name":"pdf_redact"}
