{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the free ad windows on the tower, the free city billboards and the free casino game sponsorships, with monthly prices. Tower windows come first (floor 1 up, the cheapest floors first), then billboards (the most prominent first), then the casino's games: use kind to get only one of them, and maxPrice to cap the monthly price. Any floor, face or spot filter returns tower windows only. Pages hold up to 100 items; when next isn't null, pass it as cursor for the next page.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "The next value from the previous page",
    "maxLength": 20,
    "type": "string"
   },
   "face": {
    "enum": [
     "south",
     "east",
     "north",
     "west"
    ],
    "type": "string"
   },
   "floor": {
    "description": "One floor, 1 to 80 (higher floors cost more)",
    "maximum": 80,
    "minimum": 1,
    "type": "integer"
   },
   "floorMax": {
    "maximum": 80,
    "minimum": 1,
    "type": "integer"
   },
   "floorMin": {
    "maximum": 80,
    "minimum": 1,
    "type": "integer"
   },
   "kind": {
    "description": "window = on the tower, billboard = in the city around it, casino = the sponsor of one casino game",
    "enum": [
     "window",
     "billboard",
     "casino"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Items per page, 1 to 100 (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "maxPrice": {
    "description": "Highest monthly price in US dollars, e.g. 20",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "spot": {
    "description": "Corner windows cost 35% more",
    "enum": [
     "corner",
     "middle"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_windows",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "billing": {
       "const": "monthly",
       "type": "string"
      },
      "column": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "1 to 6 across the face; 1 and 6 are corners"
      },
      "currency": {
       "const": "USD",
       "type": "string"
      },
      "face": {
       "anyOf": [
        {
         "enum": [
          "south",
          "east",
          "north",
          "west"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "floor": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "1 to 80; null for billboards and casino games"
      },
      "id": {
       "description": "Slot id: \"F47-S3\" (floor 47, south face, column 3), \"B-1234\" (a city billboard) or \"C-slots\" (the sponsor of a casino game)",
       "type": "string"
      },
      "image": {
       "description": "The slot's share card (PNG)",
       "type": "string"
      },
      "kind": {
       "enum": [
        "window",
        "billboard",
        "casino"
       ],
       "type": "string"
      },
      "leaseUrl": {
       "description": "Where a person leases this slot",
       "type": "string"
      },
      "pageUrl": {
       "description": "The slot's page",
       "type": "string"
      },
      "price": {
       "description": "Monthly price for people, e.g. \"$68\"",
       "type": "string"
      },
      "priceCents": {
       "description": "Monthly price in US cents, exactly what Stripe charges",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "spot": {
       "anyOf": [
        {
         "enum": [
          "corner",
          "middle"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "kind",
      "floor",
      "face",
      "column",
      "spot",
      "priceCents",
      "price",
      "currency",
      "billing",
      "pageUrl",
      "leaseUrl",
      "image"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Pass as `cursor` for the next page; null on the last page"
   }
  },
  "required": [
   "items",
   "next"
  ],
  "type": "object"
 },
 "title": "Find free windows"
}
