{
 "annotations": {},
 "description": "Send KakaoTalk Brand Messages through SENS (POST /brandmessage/v2/services/{serviceId}/messages \u2192 202). Free-form: set messageType and type-specific fields per message; template-based: set templateCode (+ messageType of the template) and messages[].templateParameters. Not deliverable 20:50-08:00 (code 3022). targeting I (default) = ad-consented channel friends, M = all ad-consented, N = ad-consented non-friends (M/N need an 080 number). Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": false,
    "description": "If true, returns the request preview without sending",
    "type": "boolean"
   },
   "isAdult": {
    "description": "Adult-only content (default false)",
    "type": "boolean"
   },
   "messageType": {
    "description": "Message layout type",
    "enum": [
     "TEXT",
     "IMAGE",
     "WIDE_IMAGE",
     "WIDE_ITEM_LIST",
     "COMMERCE",
     "CAROUSEL_COMMERCE",
     "CAROUSEL_FEED",
     "PREMIUM_VIDEO"
    ],
    "type": "string"
   },
   "messages": {
    "description": "Recipients with type-specific payload (1-100)",
    "items": {
     "additionalProperties": true,
     "properties": {
      "additionalContent": {
       "description": "COMMERCE additional text (\u226434 chars, \u22641 line break)",
       "maxLength": 34,
       "type": "string"
      },
      "buttons": {
       "description": "Buttons (TEXT/IMAGE \u22645, WIDE \u22642, COMMERCE 1-2, PREMIUM_VIDEO \u22641). No AC in free-form, no BC/BT with a template",
       "items": {
        "additionalProperties": true,
        "properties": {
         "bizFormId": {
          "description": "Business form ID (BF)",
          "type": "string"
         },
         "linkMobile": {
          "$ref": "#/properties/messages/items/properties/coupon/properties/linkMobile"
         },
         "linkPc": {
          "$ref": "#/properties/messages/items/properties/coupon/properties/linkPc"
         },
         "name": {
          "description": "Button label (\u226414 chars)",
          "maxLength": 14,
          "type": "string"
         },
         "schemeAndroid": {
          "$ref": "#/properties/messages/items/properties/coupon/properties/schemeAndroid"
         },
         "schemeIos": {
          "$ref": "#/properties/messages/items/properties/coupon/properties/schemeIos"
         },
         "type": {
          "description": "WL web link | AL app link | BF business form | AC add channel | BK bot keyword | MD message | BC consult talk | BT chatbot",
          "enum": [
           "WL",
           "AL",
           "BF",
           "AC",
           "BK",
           "MD",
           "BC",
           "BT"
          ],
          "type": "string"
         }
        },
        "required": [
         "type",
         "name"
        ],
        "type": "object"
       },
       "maxItems": 5,
       "type": "array"
      },
      "carousel": {
       "$ref": "#/properties/messages/items/properties/item",
       "description": "CAROUSEL_COMMERCE/CAROUSEL_FEED: { head?, list: [2-6 cards], tail: { linkMobile(required), linkPc, schemeAndroid, schemeIos } }"
      },
      "commerce": {
       "$ref": "#/properties/messages/items/properties/item",
       "description": "COMMERCE: { title(\u226430), regularPrice, discountPrice, discountRate | discountFixed } (send as strings)"
      },
      "content": {
       "description": "TEXT/IMAGE \u22641,300 chars; WIDE_IMAGE/PREMIUM_VIDEO \u226476 chars",
       "maxLength": 1300,
       "type": "string"
      },
      "countryCode": {
       "description": "Country code (default 82)",
       "type": "string"
      },
      "coupon": {
       "additionalProperties": true,
       "description": "One coupon per message",
       "properties": {
        "description": {
         "description": "\u226412 chars (WIDE_IMAGE \u22648, WIDE_ITEM_LIST \u226418), no line breaks",
         "maxLength": 18,
         "type": "string"
        },
        "linkMobile": {
         "description": "Mobile URL (\u22641,000 chars)",
         "maxLength": 1000,
         "type": "string"
        },
        "linkPc": {
         "description": "PC URL (\u22641,000 chars)",
         "maxLength": 1000,
         "type": "string"
        },
        "schemeAndroid": {
         "description": "Android scheme (\u22641,000 chars)",
         "maxLength": 1000,
         "type": "string"
        },
        "schemeIos": {
         "description": "iOS scheme (\u22641,000 chars)",
         "maxLength": 1000,
         "type": "string"
        },
        "title": {
         "description": "Fixed patterns only: '${N}\uc6d0 \ud560\uc778 \ucfe0\ud3f0' | '${1-100}% \ud560\uc778 \ucfe0\ud3f0' | '\ubc30\uc1a1\ube44 \ud560\uc778 \ucfe0\ud3f0' | '${\u22647 chars} \ubb34\ub8cc \ucfe0\ud3f0' | '${\u22647 chars} UP \ucfe0\ud3f0'",
         "type": "string"
        }
       },
       "required": [
        "title",
        "description"
       ],
       "type": "object"
      },
      "failoverConfig": {
       "additionalProperties": false,
       "description": "SMS failover settings (used with useSmsFailover=true)",
       "properties": {
        "content": {
         "description": "Failover content (default = the message content without buttons)",
         "type": "string"
        },
        "from": {
         "description": "Failover sender number (registered in the console)",
         "type": "string"
        },
        "subject": {
         "description": "Failover subject (LMS only; default = channel name)",
         "type": "string"
        },
        "type": {
         "description": "Failover type; omitted = SMS when \u226490 bytes, else LMS",
         "enum": [
          "SMS",
          "LMS"
         ],
         "type": "string"
        }
       },
       "type": "object"
      },
      "headerContent": {
       "description": "WIDE_ITEM_LIST (required) / PREMIUM_VIDEO header, \u226420 chars",
       "maxLength": 20,
       "type": "string"
      },
      "image": {
       "additionalProperties": true,
       "description": "IMAGE/WIDE_IMAGE/COMMERCE image",
       "properties": {
        "imageId": {
         "description": "Image ID from the console upload / ncloud_sens_list_brandmessage_images",
         "type": "string"
        },
        "imageLink": {
         "description": "URL opened when the image is tapped",
         "maxLength": 1000,
         "type": "string"
        }
       },
       "type": "object"
      },
      "item": {
       "additionalProperties": {},
       "description": "WIDE_ITEM_LIST: { list: [{ title, imageId, linkMobile, linkPc, schemeAndroid, schemeIos }] } (item 1 = main image, items 2-4 = sub images)",
       "type": "object"
      },
      "templateParameters": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Template variables #{name} \u2192 value (template-based sending)",
       "type": "object"
      },
      "to": {
       "description": "Recipient number (digits only)",
       "pattern": "^\\d+$",
       "type": "string"
      },
      "useSmsFailover": {
       "description": "Send SMS/LMS when not delivered",
       "type": "boolean"
      },
      "video": {
       "$ref": "#/properties/messages/items/properties/item",
       "description": "PREMIUM_VIDEO: { thumbnailId, videoUrl (KakaoTV) }"
      }
     },
     "required": [
      "to"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "plusFriendId": {
    "description": "KakaoTalk channel ID (e.g. @channelname)",
    "type": "string"
   },
   "reserveTime": {
    "description": "Scheduled send time 'YYYY-MM-DD HH:mm' (no seconds; must be at least 10 minutes from now)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$",
    "type": "string"
   },
   "reserveTimeZone": {
    "description": "tz database name for reserveTime (default Asia/Seoul)",
    "type": "string"
   },
   "serviceId": {
    "description": "Biz Message service ID in NRN form (e.g. ncp:kkobizmsg:kr:1********2:myproject). Defaults to NCLOUD_SENS_BRANDMESSAGE_SERVICE_ID (or NCLOUD_SENS_ALIMTALK_SERVICE_ID) / NCLOUD_SENS_SERVICE_ID. Find it with ncloud_sens_list_projects (kkoBizMsgService.serviceId). A 'Forbidden' reply means the project does not have this channel enabled.",
    "type": "string"
   },
   "targeting": {
    "description": "Audience: M | N | I (default I)",
    "enum": [
     "M",
     "N",
     "I"
    ],
    "type": "string"
   },
   "templateCode": {
    "description": "Template code for template-based (\uae30\ubcf8\ud615) sending",
    "type": "string"
   }
  },
  "required": [
   "plusFriendId",
   "messageType",
   "messages"
  ],
  "type": "object"
 },
 "name": "ncloud_sens_send_brandmessage"
}
