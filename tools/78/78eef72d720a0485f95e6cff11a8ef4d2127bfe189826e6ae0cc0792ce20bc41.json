{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "TXT Record Lookup"
 },
 "description": "Free public API. Fetch all TXT records on a domain, classifying each as SPF, DKIM, DMARC, BIMI, verification token, or general.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Domain to fetch TXT records for.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "tools_txt_record_lookup",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "description": "All TXT records on the domain, classified.",
  "properties": {
   "data": {
    "additionalProperties": true,
    "properties": {
     "count": {
      "type": "number"
     },
     "domain": {
      "type": "string"
     },
     "records": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "category": {
         "description": "SPF | DMARC | DKIM | Verification | MTA-STS | Other.",
         "type": "string"
        },
        "service": {
         "description": "For verification tokens, the service that issued it.",
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "value",
        "category"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "domain",
     "count",
     "records"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Always true here; failures return an isError result instead.",
    "type": "boolean"
   }
  },
  "required": [
   "ok",
   "data"
  ],
  "type": "object"
 },
 "title": "TXT Record Lookup"
}
