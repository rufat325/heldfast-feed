{
 "description": "Get posts from a specific Liberty.win community.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "after": {
    "description": "Cursor ID for pagination",
    "type": "number"
   },
   "community": {
    "description": "Community name (e.g. 'politics', 'technology')",
    "type": "string"
   },
   "sort": {
    "description": "Sort order: hot (default), new, or top",
    "enum": [
     "hot",
     "new",
     "top"
    ],
    "type": "string"
   },
   "t": {
    "description": "Time filter (only for sort=top)",
    "enum": [
     "hour",
     "day",
     "week",
     "month",
     "year",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [
   "community"
  ],
  "type": "object"
 },
 "name": "get_community_posts"
}
