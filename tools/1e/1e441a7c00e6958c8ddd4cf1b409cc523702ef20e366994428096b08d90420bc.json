{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when someone lists the services that send their email and wants the SPF record to publish, or wants a sender added to the SPF record they already have. Takes provider names such as Google Workspace or Mailchimp, include terms such as include:spf.example.com, or IP addresses, and returns one merged record with its count of DNS lookups against the limit of ten. Pass the domain when you know it, so the result includes the senders already in its published record.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "all": {
    "description": "How the record ends. A new record ends in ~all unless you pass -all. A record the domain already publishes keeps its own ending unless you pass one.",
    "enum": [
     "~all",
     "-all"
    ],
    "type": "string"
   },
   "domain": {
    "description": "The domain the record is for. When given, the SPF record it publishes today is read and the senders are added to it, so nothing already in it is lost.",
    "maxLength": 253,
    "minLength": 1,
    "type": "string"
   },
   "ip4": {
    "description": "IPv4 addresses or ranges that send this domain's mail directly, such as 192.0.2.10 or 192.0.2.0/24.",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "ip6": {
    "description": "IPv6 addresses or ranges that send this domain's mail directly, such as 2001:db8::1 or 2001:db8::/32.",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "senders": {
    "description": "The platforms that send this domain's mail: provider names such as Google Workspace or Mailchimp, or include terms such as include:spf.example.com.",
    "items": {
     "maxLength": 300,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "senders"
  ],
  "type": "object"
 },
 "name": "build_spf",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "added": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "after": {
    "type": [
     "string",
     "null"
    ]
   },
   "domain": {
    "type": [
     "string",
     "null"
    ]
   },
   "external_data": {
    "additionalProperties": false,
    "properties": {
     "fields": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "label": {
         "type": "string"
        },
        "name": {
         "type": [
          "string",
          "null"
         ]
        },
        "shortened": {
         "type": "boolean"
        },
        "source": {
         "enum": [
          "dns",
          "report",
          "request"
         ],
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "source",
        "label",
        "name",
        "value",
        "shortened"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "notice": {
      "type": "string"
     },
     "omitted": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "notice",
     "fields",
     "omitted"
    ],
    "type": "object"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "level": {
       "enum": [
        "ok",
        "warn",
        "error"
       ],
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "level",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "findings_omitted": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "lookups": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "no_include": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "outcome": {
    "enum": [
     "built",
     "created",
     "merged",
     "already-present",
     "not-spf",
     "invalid",
     "nothing-to-add"
    ],
    "type": "string"
   },
   "over_limit": {
    "type": "boolean"
   },
   "published": {
    "type": "boolean"
   },
   "skipped": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "unrecognised": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "domain",
   "outcome",
   "published",
   "after",
   "added",
   "skipped",
   "unrecognised",
   "no_include",
   "lookups",
   "over_limit",
   "findings",
   "findings_omitted",
   "external_data",
   "url"
  ],
  "type": "object"
 },
 "title": "Build an SPF record"
}
