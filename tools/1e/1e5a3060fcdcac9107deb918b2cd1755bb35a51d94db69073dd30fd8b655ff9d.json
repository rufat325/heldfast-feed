{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Runs all four validation layers on a PassportDraft: L1 schema, L2 AAS meta-model (aas-core), L3 IDTA 02035 template conformance, L4 domain plausibility. Returns the verdict (valid, valid_with_warnings, invalid) and every finding with layer, rule id, path, DE/EN message, legal reference and fix hint. The only source of a validity claim.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "asOf": {
    "description": "ISO date-time treated as \"now\" by the plausibility layer; default: draft.meta.createdAt",
    "type": "string"
   },
   "draft": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "draftId": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "draftId"
      ],
      "type": "object"
     },
     {
      "additionalProperties": {},
      "properties": {
       "meta": {}
      },
      "required": [
       "meta"
      ],
      "type": "object"
     }
    ],
    "description": "A PassportDraft object, or { draftId } as returned by an earlier call"
   },
   "lang": {
    "description": "Language of the text summary (default en)",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "skipPlausibility": {
    "description": "Skip L4 (domain plausibility). Default false",
    "type": "boolean"
   }
  },
  "required": [
   "draft"
  ],
  "type": "object"
 },
 "name": "validate_passport",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "draftId": {
    "type": "string"
   },
   "error": {
    "description": "Set when the call failed",
    "type": "string"
   },
   "findings": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "layer": {
       "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
       ],
       "type": "string"
      },
      "message": {
       "additionalProperties": false,
       "properties": {
        "de": {
         "type": "string"
        },
        "en": {
         "type": "string"
        }
       },
       "required": [
        "de",
        "en"
       ],
       "type": "object"
      },
      "path": {
       "type": "string"
      },
      "ruleId": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning"
       ],
       "type": "string"
      }
     },
     "required": [
      "layer",
      "ruleId",
      "severity",
      "path",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "layers": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "verdict": {
    "enum": [
     "valid",
     "valid_with_warnings",
     "invalid"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Validate a passport draft"
}
