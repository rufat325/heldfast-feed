{
 "description": "[provider] Search people by company, industry or tech \u2014 ids only. Search leads. Accepts the full person filter set. (LeadsForge \u00b7 People & contact data) (costs $0.001 per call, paid automatically: from your wallet via x402 or from prepaid credits (API key))",
 "inputSchema": {
  "additionalProperties": true,
  "description": "returns person ids plus name, job title, location and firmographics \u2014 NOT email or phone. Feed the returned `id` into the enrichment routes as `personID` to reveal a contact channel.",
  "properties": {
   "companyDomains": {
    "description": "{include: [domain], exclude: [domain]} \u2014 the way to target named companies",
    "examples": [
     {
      "include": [
       "stripe.com"
      ]
     }
    ],
    "type": "object"
   },
   "companyEmployeeNumberRange": {
    "description": "{min, max}",
    "examples": [
     {
      "max": 500,
      "min": 50
     }
    ],
    "type": "object"
   },
   "companyFoundedYearRange": {
    "description": "{min, max}",
    "examples": [
     {
      "max": 2024,
      "min": 2010
     }
    ],
    "type": "object"
   },
   "companyFundingRounds": {
    "description": "{include/exclude}; ids from leadsforge.people.search.filters.funding_types",
    "examples": [
     {
      "include": [
       "SERIES_B"
      ]
     }
    ],
    "type": "object"
   },
   "companyIDs": {
    "description": "{include/exclude} LeadsForge company ids",
    "type": "object"
   },
   "companyIndustries": {
    "description": "{include/exclude}; EXACT values from leadsforge.people.search.filters.industries",
    "examples": [
     {
      "include": [
       "software development"
      ]
     }
    ],
    "type": "object"
   },
   "companyKeywords": {
    "description": "{include, exclude, all} free text",
    "type": "object"
   },
   "companyLocations": {
    "description": "{include/exclude} free text",
    "examples": [
     {
      "include": [
       "United States"
      ]
     }
    ],
    "type": "object"
   },
   "companyNames": {
    "description": "{include/exclude} free text, partial and case-insensitive",
    "examples": [
     {
      "include": [
       "Stripe"
      ]
     }
    ],
    "type": "object"
   },
   "companyRequired": {
    "description": "only return leads that have a resolved company",
    "type": "boolean"
   },
   "companyRevenueRanges": {
    "description": "values from leadsforge.people.search.filters.revenue_ranges",
    "examples": [
     [
      "small_upper"
     ]
    ],
    "type": "array"
   },
   "companyTechnologies": {
    "description": "{any: [...], all: [...]} free text",
    "examples": [
     {
      "any": [
       "hubspot"
      ]
     }
    ],
    "type": "object"
   },
   "companyTypes": {
    "description": "{include/exclude}; ids from leadsforge.people.search.filters.company_types",
    "examples": [
     {
      "include": [
       "PRIVATELY_HELD"
      ]
     }
    ],
    "type": "object"
   },
   "companyYearsInBusinessRange": {
    "description": "{min, max}",
    "type": "object"
   },
   "excludeDomains": {
    "description": "suppression list \u2014 company domains to skip",
    "type": "array"
   },
   "excludeEmails": {
    "description": "suppression list \u2014 emails you already own (documented in the route description, not in the schema)",
    "type": "array"
   },
   "excludeLinkedInURLs": {
    "description": "suppression list \u2014 LinkedIn profile URLs to skip",
    "type": "array"
   },
   "leadDepartments": {
    "description": "{include/exclude}; values from leadsforge.people.search.filters.departments",
    "examples": [
     {
      "include": [
       "master_sales"
      ]
     }
    ],
    "type": "object"
   },
   "leadIDs": {
    "description": "{include/exclude} LeadsForge person ids",
    "type": "object"
   },
   "leadJobTitles": {
    "description": "job-title filter, free text",
    "examples": [
     {
      "include": [
       "Head of Growth"
      ]
     }
    ],
    "type": "object"
   },
   "leadLanguages": {
    "description": "language filter",
    "type": "object"
   },
   "leadLocations": {
    "description": "{include/exclude} free text",
    "examples": [
     {
      "include": [
       "United States"
      ]
     }
    ],
    "type": "object"
   },
   "leadSeniorities": {
    "description": "{include/exclude}; values from leadsforge.people.search.filters.seniorities",
    "examples": [
     {
      "include": [
       "c_suite"
      ]
     }
    ],
    "type": "object"
   },
   "leadTenure": {
    "description": "{min, max} years in current role",
    "type": "object"
   },
   "limit": {
    "description": "page size",
    "examples": [
     2
    ],
    "type": "integer"
   },
   "maxContactsPerCompany": {
    "description": "cap results per company so one big employer cannot fill the page",
    "examples": [
     3
    ],
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "leadsforge_people_search"
}
