{
 "_meta": {
  "anthropic/alwaysLoad": true
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Who Am I"
 },
 "description": "Show the current identity: auth mode (api key, oauth, session, or anonymous), active workspace, and plan limits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "clipform_whoami",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "auth_mode": {
    "description": "How this session is authenticated",
    "enum": [
     "api_key",
     "oauth",
     "session",
     "anonymous"
    ],
    "type": "string"
   },
   "is_authenticated": {
    "description": "True for api_key, oauth, or session auth; false for anonymous",
    "type": "boolean"
   },
   "links": {
    "additionalProperties": false,
    "description": "Workspace-level dashboard links - only present for a non-anonymous caller.",
    "properties": {
     "dashboard": {
      "description": "Dashboard home for the active workspace.",
      "type": "string"
     },
     "forms": {
      "description": "Forms list for the active workspace.",
      "type": "string"
     }
    },
    "required": [
     "dashboard",
     "forms"
    ],
    "type": "object"
   },
   "plan": {
    "additionalProperties": false,
    "description": "Plan limits for the active workspace",
    "properties": {
     "form_limit": {
      "description": "Max forms in the workspace, or null if unlimited",
      "type": [
       "number",
       "null"
      ]
     },
     "name": {
      "type": "string"
     },
     "node_limit": {
      "description": "Max nodes per form, or null if unlimited",
      "type": [
       "number",
       "null"
      ]
     },
     "tier": {
      "type": "number"
     }
    },
    "required": [
     "name",
     "tier",
     "node_limit",
     "form_limit"
    ],
    "type": "object"
   },
   "workspace": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "name"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Active workspace, or null when anonymous"
   },
   "workspaces": {
    "description": "All workspaces in the caller's company - only present for session (dashboard) auth",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "auth_mode",
   "is_authenticated",
   "workspace",
   "plan"
  ],
  "type": "object"
 },
 "title": "Who Am I"
}
