{
 "description": "Create a saved audience configuration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "config": {
    "additionalProperties": false,
    "properties": {
     "filters": {
      "additionalProperties": false,
      "properties": {
       "ageRange": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "companyDomain": {
        "maxLength": 255,
        "type": "string"
       },
       "companyIndustry": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "companyName": {
        "maxLength": 255,
        "type": "string"
       },
       "companyRevenueRange": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "companySize": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "department": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "gender": {
        "type": "string"
       },
       "hasBusinessEmail": {
        "type": "boolean"
       },
       "hasLinkedin": {
        "type": "boolean"
       },
       "hasPersonalEmail": {
        "type": "boolean"
       },
       "hasPhone": {
        "type": "boolean"
       },
       "isB2b": {
        "enum": [
         "y",
         "n"
        ],
        "type": "string"
       },
       "jobTitle": {
        "maxLength": 200,
        "type": "string"
       },
       "seniority": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "state": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "maxScore": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     },
     "minScore": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     },
     "minTopicOverlap": {
      "maximum": 10,
      "minimum": 1,
      "type": "integer"
     },
     "sourceUrl": {
      "format": "uri",
      "type": "string"
     },
     "topicIds": {
      "items": {
       "type": "integer"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "topicIds"
    ],
    "type": "object"
   },
   "name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "config"
  ],
  "type": "object"
 },
 "name": "create_audience",
 "title": "Create Audience"
}
