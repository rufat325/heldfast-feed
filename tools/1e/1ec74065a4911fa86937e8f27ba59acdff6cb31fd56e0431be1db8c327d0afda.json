{
 "description": "Pull recent blockchain events via paid x402 endpoint",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 50,
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "Unix timestamp (seconds).",
    "type": "integer"
   },
   "types": {
    "items": {
     "enum": [
      "contracts",
      "liquidity",
      "prices",
      "transfers",
      "nfts"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "blockwire_feed"
}
