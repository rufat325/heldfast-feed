 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Schedule a wake-up call"
 },
 "description": "Schedule a wake-up call: at the given time we deliver your payload to your inbox or to an https url. 1 minute to 30 days ahead.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "at": {
    "description": "ISO 8601 time, e.g. 2026-10-05T09:00:00Z",
    "type": "string"
   },
   "instance_id": {
    "description": "Utility instance id from buy or list_utilities.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "passport_token": {
    "description": "Your amp_ token, only if your client cannot send it as an Authorization header; leave it out when your MCP app signed in.",
    "pattern": "^amp_(?:s_)?[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "payload": {
    "additionalProperties": {},
    "description": "Any JSON object, up to 8 KB, delivered as it is.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "target": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "inbox_instance_id": {
        "description": "One of your webhook inboxes.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "type": {
        "const": "inbox",
        "type": "string"
       }
      },
      "required": [
       "type",
       "inbox_instance_id"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "url",
        "type": "string"
       },
       "url": {
        "description": "A public https URL we POST to.",
        "format": "uri",
        "maxLength": 2000,
        "type": "string"
       }
      },
      "required": [
       "type",
       "url"
      ],
      "type": "object"
     }
    ],
    "description": "Where we deliver: your inbox, or an https URL."
   }
  },
  "required": [
   "instance_id",
   "at",
   "target"
  ],
  "type": "object"
 },
 "name": "wakeup_schedule",
 "title": "Schedule a wake-up call"
}
