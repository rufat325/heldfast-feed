{
 "annotations": {
  "destructiveHint": true,
  "title": "Update listing calendar"
 },
 "description": "Change availability and/or pricing for a date range on one listing, pushed to every connected channel: block (isAvailable=false) or open days, set the nightly price, min/max stay, closed-to-arrival/departure, or a note. For multi-unit listings set desiredUnitsToSell instead of isAvailable (0 blocks). Hostaway: PUT /v1/listings/{listingId}/calendar.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "closedOnArrival": {
    "description": "Closed to arrival.",
    "type": "boolean"
   },
   "closedOnDeparture": {
    "description": "Closed to departure.",
    "type": "boolean"
   },
   "desiredUnitsToSell": {
    "description": "Multi-unit listings: units to sell (0 blocks).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "endDate": {
    "description": "Last day to change (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "isAvailable": {
    "description": "false blocks the days, true opens them (single-unit listings).",
    "type": "boolean"
   },
   "listingId": {
    "description": "Listing id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "maximumStay": {
    "description": "Maximum nights.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "minimumStay": {
    "description": "Minimum nights.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "note": {
    "description": "Calendar note.",
    "type": "string"
   },
   "price": {
    "description": "Nightly price.",
    "minimum": 0,
    "type": "number"
   },
   "startDate": {
    "description": "First day to change (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "listingId",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "hostaway_update_calendar",
 "title": "Update listing calendar"
}
