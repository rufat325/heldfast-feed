{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Upload an image, video, or PDF directly using base64 data (or data URI) into the workspace media library and return its asset id (to attach with create_post.mediaIds).",
 "inputSchema": {
  "properties": {
   "alt": {
    "description": "Accessibility alt text for the media asset",
    "maxLength": 400,
    "type": "string"
   },
   "data": {
    "description": "Base64 encoded file content or data URI (e.g. 'data:image/png;base64,...')",
    "minLength": 1,
    "type": "string"
   },
   "filename": {
    "description": "Filename with extension (e.g. 'infographic.png')",
    "maxLength": 120,
    "type": "string"
   },
   "mime": {
    "description": "MIME type (e.g. 'image/png', 'image/jpeg', 'video/mp4')",
    "maxLength": 50,
    "type": "string"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "name": "upload_media",
 "outputSchema": {
  "description": "Uploaded media asset details",
  "properties": {
   "assetId": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "assetId",
   "kind",
   "url"
  ],
  "type": "object"
 },
 "title": "Upload media"
}
