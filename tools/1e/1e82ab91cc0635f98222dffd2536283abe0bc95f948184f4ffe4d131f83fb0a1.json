{
 "description": "Saves the buyer's project answers (no personal data) and returns a link to erppartnerfinder.com where the buyer reviews the answers, adds their own contact details, confirms their email and chooses which partners receive the request. Nothing is sent to partners and no email is sent by this tool. Give the link to the buyer; it is valid for 30 days. Optionally name one partner the buyer asked about (it is then always shown and preselected).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ai_assisted_delivery": {
    "enum": [
     "important",
     "nice",
     "none"
    ],
    "type": "string"
   },
   "apps": {
    "default": [],
    "items": {
     "enum": [
      "accounting",
      "invoicing",
      "sales",
      "crm",
      "purchase",
      "inventory",
      "manufacturing",
      "plm",
      "quality",
      "maintenance",
      "project",
      "timesheets",
      "field_service",
      "helpdesk",
      "planning",
      "website",
      "ecommerce",
      "pos",
      "marketing",
      "email_marketing",
      "events",
      "appointments",
      "hr",
      "payroll",
      "recruitment",
      "expenses",
      "documents",
      "sign",
      "rental",
      "subscriptions",
      "fleet",
      "repair",
      "studio",
      "knowledge",
      "spreadsheet_bi"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "country": {
    "enum": [
     "DE",
     "AT",
     "CH",
     "other"
    ],
    "type": "string"
   },
   "employees": {
    "enum": [
     "1-10",
     "11-50",
     "51-200",
     "201-500",
     "500+"
    ],
    "type": "string"
   },
   "industry": {
    "enum": [
     "other",
     "manufacturing",
     "wholesale_distribution",
     "retail_ecommerce",
     "construction_trades",
     "professional_services",
     "it_software",
     "logistics_transport",
     "food_beverage",
     "healthcare_pharma",
     "energy_utilities",
     "real_estate",
     "education",
     "nonprofit",
     "public_sector",
     "finance_insurance",
     "hospitality_tourism",
     "automotive",
     "agriculture",
     "media_marketing"
    ],
    "type": "string"
   },
   "language": {
    "default": "en",
    "description": "Language of the page the buyer will see",
    "enum": [
     "de",
     "en",
     "fr",
     "it"
    ],
    "type": "string"
   },
   "languages": {
    "default": [
     "de"
    ],
    "items": {
     "enum": [
      "de",
      "en",
      "fr",
      "it"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "partner_slug": {
    "description": "A partner the buyer specifically wants to contact (slug from search_partners)",
    "type": "string"
   },
   "situation": {
    "enum": [
     "new",
     "switch",
     "rescue",
     "upgrade"
    ],
    "type": "string"
   },
   "timeline": {
    "enum": [
     "asap",
     "3m",
     "6m",
     "later"
    ],
    "type": "string"
   },
   "users": {
    "description": "Planned Odoo users",
    "enum": [
     "1-5",
     "6-20",
     "21-50",
     "51-200",
     "200+"
    ],
    "type": "string"
   }
  },
  "required": [
   "country",
   "industry",
   "employees",
   "users",
   "situation"
  ],
  "type": "object"
 },
 "name": "prepare_request",
 "title": "Prepare a partner request for the buyer"
}
