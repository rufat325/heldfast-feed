{
 "description": "Register a stock-in or stock-out movement for a product (alias of update_stock with explicit direction)",
 "inputSchema": {
  "properties": {
   "depositoId": {
    "description": "Warehouse ID",
    "type": "number"
   },
   "direction": {
    "description": "in=entry (E), out=exit (S)",
    "enum": [
     "in",
     "out"
    ],
    "type": "string"
   },
   "observacoes": {
    "description": "Notes",
    "type": "string"
   },
   "preco": {
    "description": "Unit price (optional)",
    "type": "number"
   },
   "productId": {
    "description": "Product ID",
    "type": "number"
   },
   "quantidade": {
    "description": "Quantity",
    "type": "number"
   }
  },
  "required": [
   "productId",
   "depositoId",
   "direction",
   "quantidade"
  ],
  "type": "object"
 },
 "name": "create_stock_movement"
}
