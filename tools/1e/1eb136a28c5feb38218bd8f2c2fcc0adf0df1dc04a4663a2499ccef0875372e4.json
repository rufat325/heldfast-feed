{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "What a new VPS can be, and what it costs. Lists the locations (with each jurisdiction's note), the operating systems, the CPU/memory/disk ranges with the price per unit for every billing cycle, and the apps it can be born with, in the account currency. Pass a whole configuration (billing_cycle, location, os, cpu_cores, memory_gb, disk_gb) to get its exact price instead \u2014 what is due today, what it renews at, whether the balance covers it and whether that location has room right now. Then order it with impreza_order_vps using the same values. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "app": {
    "description": "Optional: what it is born with \u2014 'none' (default, bare OS); '@agent' is opt-in, '@agent-mcp', 'none', a '@panel-*' choice or a catalog app name. The customer can request the agent later via impreza_install_agent with confirmation.",
    "type": "string"
   },
   "billing_cycle": {
    "description": "Optional, to price a configuration: monthly, quarterly, semiannually, annually, biennially or triennially.",
    "type": "string"
   },
   "cpu_cores": {
    "description": "Optional: vCPU count, inside the range this tool lists.",
    "type": "number"
   },
   "disk_gb": {
    "description": "Optional: SSD disk in GB, inside the range this tool lists.",
    "type": "number"
   },
   "location": {
    "description": "Optional: a location id, slug or name from this tool, e.g. \"romania\".",
    "type": [
     "string",
     "number"
    ]
   },
   "memory_gb": {
    "description": "Optional: memory in GB, inside the range this tool lists.",
    "type": "number"
   },
   "os": {
    "description": "Optional: an operating system id, slug or name from this tool, e.g. \"ubuntu-24.04\".",
    "type": [
     "string",
     "number"
    ]
   }
  },
  "type": "object"
 },
 "name": "impreza_vps_offer",
 "outputSchema": {
  "anyOf": [
   {
    "$comment": "Two answers: the offer (no or partial arguments) and the exact quote of one whole configuration.",
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "_note": {
        "$comment": "Hosted only: added when some but not all of the quote arguments were passed.",
        "type": "string"
       },
       "apps": {
        "properties": {
         "default": {
          "type": "string"
         },
         "note": {
          "type": "string"
         },
         "options": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       },
       "balance": {
        "pattern": "^-?[0-9]+.[0-9]{2}$",
        "type": "string"
       },
       "billing_cycles": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "cycle": {
           "enum": [
            "monthly",
            "quarterly",
            "semiannually",
            "annually",
            "biennially",
            "triennially"
           ],
           "type": "string"
          },
          "months": {
           "type": "integer"
          }
         },
         "required": [
          "cycle",
          "months"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "currency": {
        "type": "string"
       },
       "description": {
        "type": "string"
       },
       "limits": {
        "properties": {
         "disk_gb_per_core": {
          "type": [
           "string",
           "null"
          ]
         },
         "memory_gb_per_core": {
          "type": [
           "string",
           "null"
          ]
         }
        },
        "type": "object"
       },
       "locations": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "badge": {
           "type": "string"
          },
          "best_for": {
           "type": "string"
          },
          "country": {
           "type": "string"
          },
          "id": {
           "type": "integer"
          },
          "name": {
           "type": "string"
          },
          "slug": {
           "type": "string"
          },
          "surcharge": {
           "additionalProperties": {
            "pattern": "^-?[0-9]+.[0-9]{2}$",
            "type": "string"
           },
           "type": "object"
          }
         },
         "required": [
          "id",
          "slug",
          "name"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "name": {
        "type": "string"
       },
       "operating_systems": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "family": {
           "type": "string"
          },
          "id": {
           "type": "integer"
          },
          "name": {
           "type": "string"
          },
          "slug": {
           "type": "string"
          },
          "surcharge": {
           "additionalProperties": {
            "pattern": "^-?[0-9]+.[0-9]{2}$",
            "type": "string"
           },
           "type": "object"
          }
         },
         "required": [
          "id",
          "slug",
          "name",
          "family"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "order": {
        "type": "string"
       },
       "pricing": {
        "type": "string"
       },
       "product_id": {
        "type": "integer"
       },
       "resources": {
        "type": "object"
       },
       "starting_at": {
        "additionalProperties": {
         "pattern": "^-?[0-9]+.[0-9]{2}$",
         "type": "string"
        },
        "type": "object"
       }
      },
      "required": [
       "product_id",
       "name",
       "description",
       "currency",
       "billing_cycles",
       "locations",
       "operating_systems",
       "resources",
       "limits",
       "apps",
       "starting_at",
       "pricing",
       "order",
       "balance"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "balance": {
        "pattern": "^-?[0-9]+.[0-9]{2}$",
        "type": "string"
       },
       "balance_covers": {
        "type": "boolean"
       },
       "billing_cycle": {
        "type": "string"
       },
       "configuration": {
        "type": "object"
       },
       "currency": {
        "type": "string"
       },
       "due_today": {
        "pattern": "^-?[0-9]+.[0-9]{2}$",
        "type": "string"
       },
       "due_today_cents": {
        "type": "integer"
       },
       "exact": {
        "type": "boolean"
       },
       "lines": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "amount": {
           "pattern": "^-?[0-9]+.[0-9]{2}$",
           "type": "string"
          },
          "item": {
           "type": "string"
          },
          "quantity": {
           "type": "integer"
          },
          "setup_fee": {
           "pattern": "^-?[0-9]+.[0-9]{2}$",
           "type": "string"
          },
          "unit_price": {
           "pattern": "^-?[0-9]+.[0-9]{2}$",
           "type": "string"
          }
         },
         "required": [
          "item",
          "quantity",
          "unit_price",
          "amount"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "location_available": {
        "$comment": "null when the provisioning module cannot tell (not installed, or it failed to answer).",
        "type": [
         "boolean",
         "null"
        ]
       },
       "months": {
        "type": "integer"
       },
       "note": {
        "type": "string"
       },
       "order": {
        "properties": {
         "body": {
          "type": "object"
         },
         "method": {
          "type": "string"
         },
         "path": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "product": {
        "type": "string"
       },
       "product_id": {
        "type": "integer"
       },
       "recurring": {
        "pattern": "^-?[0-9]+.[0-9]{2}$",
        "type": "string"
       },
       "renews": {
        "type": "string"
       },
       "setup_fee": {
        "pattern": "^-?[0-9]+.[0-9]{2}$",
        "type": "string"
       },
       "top_up_needed": {
        "anyOf": [
         {
          "pattern": "^-?[0-9]+.[0-9]{2}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "product_id",
       "product",
       "currency",
       "billing_cycle",
       "months",
       "lines",
       "recurring",
       "setup_fee",
       "due_today",
       "due_today_cents",
       "renews",
       "balance",
       "balance_covers",
       "top_up_needed",
       "exact",
       "location_available",
       "order"
      ],
      "type": "object"
     }
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "VPS options and prices"
}
