    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "diasUteisMes": {
    "description": "Dias \u00fateis no m\u00eas; se n\u00e3o informado, 22.",
    "maximum": 31,
    "minimum": 1,
    "type": "integer"
   },
   "salarioBruto": {
    "description": "Sal\u00e1rio bruto mensal em reais.",
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "number"
   },
   "uf": {
    "description": "Sigla da unidade federativa, por exemplo SP.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "valeTransporteDiario": {
    "description": "Custo di\u00e1rio de vale-transporte em reais; se n\u00e3o informado, zero.",
    "maximum": 1000,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "cidade",
   "uf"
  ],
  "type": "object"
 },
