{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find canonical model slugs, context limits, and provider prices. Optional provider_slug filters availability, not the provider in bestOffer. bestOffer is selected for 10M input + 2M output tokens; use offer_compare for your workload. Follow pagination.hasMore.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "category_slug": {
    "default": "",
    "maxLength": 80,
    "type": "string"
   },
   "page": {
    "default": 1,
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "default": 25,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "provider_slug": {
    "default": "",
    "maxLength": 80,
    "type": "string"
   },
   "query": {
    "default": "",
    "maxLength": 80,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "catalog_search",
 "outputSchema": {
  "properties": {
   "data": {
    "properties": {
     "models": {
      "items": {
       "properties": {
        "author": {
         "properties": {
          "name": {
           "type": "string"
          },
          "slug": {
           "type": "string"
          }
         },
         "required": [
          "slug",
          "name"
         ],
         "type": "object"
        },
        "bestOffer": {
         "anyOf": [
          {
           "properties": {
            "prices": {
             "properties": {
              "inputPerMillionTokens": {
               "minimum": 0,
               "type": "number"
              },
              "outputPerMillionTokens": {
               "minimum": 0,
               "type": "number"
              }
             },
             "required": [
              "inputPerMillionTokens",
              "outputPerMillionTokens"
             ],
             "type": "object"
            },
            "provider": {
             "properties": {
              "name": {
               "type": "string"
              },
              "slug": {
               "type": "string"
              }
             },
             "required": [
              "slug",
              "name"
             ],
             "type": "object"
            }
           },
           "required": [
            "provider",
            "prices"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ],
         "description": "Provider selected using 10 million input and 2 million output tokens; not independent minima or a quote for every workload."
        },
        "contextTokens": {
         "anyOf": [
          {
           "minimum": 1,
           "type": "integer"
          },
          {
           "type": "null"
          }
         ]
        },
        "family": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "id": {
         "type": "string"
        },
        "maxOutputTokens": {
         "anyOf": [
          {
           "minimum": 1,
           "type": "integer"
          },
          {
           "type": "null"
          }
         ]
        },
        "name": {
         "type": "string"
        },
        "offerCount": {
         "minimum": 0,
         "type": "integer"
        },
        "releasedAt": {
         "anyOf": [
          {
           "format": "date",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "slug": {
         "type": "string"
        },
        "weightAvailability": {
         "enum": [
          "closed",
          "open",
          "unknown"
         ],
         "type": "string"
        }
       },
       "required": [
        "id",
        "slug",
        "name",
        "author",
        "family",
        "releasedAt",
        "contextTokens",
        "maxOutputTokens",
        "weightAvailability",
        "offerCount",
        "bestOffer"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "models"
    ],
    "type": "object"
   },
   "meta": {
    "properties": {
     "apiVersion": {
      "const": "v1"
     },
     "currency": {
      "const": "USD"
     },
     "tokenPriceUnit": {
      "const": "per_million_tokens"
     }
    },
    "required": [
     "apiVersion",
     "currency",
     "tokenPriceUnit"
    ],
    "type": "object"
   },
   "pagination": {
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "minimum": 1,
      "type": "integer"
     },
     "offset": {
      "minimum": 0,
      "type": "integer"
     },
     "page": {
      "minimum": 1,
      "type": "integer"
     },
     "pageCount": {
      "minimum": 0,
      "type": "integer"
     },
     "pageSize": {
      "minimum": 1,
      "type": "integer"
     },
     "total": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "meta",
   "data",
   "pagination"
  ],
  "type": "object"
 },
 "title": "Search LLM catalog"
}
