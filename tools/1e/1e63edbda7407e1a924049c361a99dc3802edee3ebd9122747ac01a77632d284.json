{
 "description": "Create a new product",
 "inputSchema": {
  "properties": {
   "categories": {
    "description": "Category IDs",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "description": {
    "description": "Description by locale",
    "properties": {
     "es": {
      "type": "string"
     },
     "pt": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "name": {
    "description": "Product name by locale, e.g. {\"es\":\"Producto\"}",
    "properties": {
     "en": {
      "type": "string"
     },
     "es": {
      "type": "string"
     },
     "pt": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "published": {
    "description": "Whether the product is published",
    "type": "boolean"
   },
   "variants": {
    "description": "Product variants",
    "items": {
     "properties": {
      "price": {
       "description": "Price",
       "type": "string"
      },
      "sku": {
       "description": "SKU",
       "type": "string"
      },
      "stock": {
       "description": "Stock quantity",
       "type": "number"
      },
      "weight": {
       "description": "Weight in kg",
       "type": "string"
      }
     },
     "required": [
      "price"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "variants"
  ],
  "type": "object"
 },
 "name": "create_product"
}
