{
 "_meta": {
  "openai/ui": {
   "entrypoints": [
    {
     "type": "global"
    }
   ]
  },
  "securitySchemes": [
   {
    "scopes": [
     "artifact.read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://carryo/website-library.html",
   "visibility": [
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Browse your Carryo websites and private drafts, select one, and continue editing in chat. Opening the library does not change or publish a website.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2020%2020%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%221.33%22%3E%3Crect%20x%3D%222%22%20y%3D%223%22%20width%3D%2216%22%20height%3D%2214%22%20rx%3D%223%22%2F%3E%3Cpath%20d%3D%22M2%207h16M6%205h.01M9%205h.01M7%2010l-2%202%202%202m6-4%202%202-2%202%22%2F%3E%3C%2Fsvg%3E"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "minimum": 0,
    "type": "integer"
   },
   "workspaceId": {
    "description": "Optional exact workspaceId of the Carryo team selected by the user. Lists Personal websites when omitted.",
    "pattern": "^ws_[A-Za-z0-9]+$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "website.library",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "artifacts": {
    "description": "Carryo pages owned by the authenticated user",
    "items": {
     "additionalProperties": false,
     "properties": {
      "accessMode": {
       "description": "Whether the page is public or restricted",
       "enum": [
        "public",
        "restricted"
       ],
       "type": "string"
      },
      "alternateShareUrls": {
       "anyOf": [
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "description": "Alternate share URLs, when available"
      },
      "customSlug": {
       "$ref": "#/properties/workspaceId",
       "description": "Optional custom URL ending"
      },
      "expiresAt": {
       "$ref": "#/properties/workspaceId",
       "description": "Optional ISO-8601 expiration timestamp"
      },
      "fileName": {
       "description": "Page file name",
       "type": "string"
      },
      "isRevoked": {
       "description": "Whether the share link has been revoked",
       "type": "boolean"
      },
      "linkId": {
       "description": "Carryo page link identifier",
       "type": "string"
      },
      "manageUrl": {
       "$ref": "#/properties/workspaceId",
       "description": "Carryo management URL for private drafts"
      },
      "policies": {
       "additionalProperties": false,
       "description": "Actual per-website policy; use this instead of Personal account defaults",
       "properties": {
        "canReactivate": {
         "description": "Whether restoration is currently supported in Carryo, subject to available capacity",
         "type": "boolean"
        },
        "inactivityRevokesAt": {
         "$ref": "#/properties/workspaceId",
         "description": "Inactivity deadline; a separately set expiresAt can take the website offline earlier"
        },
        "inactivityWindowDays": {
         "description": "Days since this website\u2019s last owner edit or Keep live action; null means no inactivity expiry. Views and sign-in do not renew it",
         "type": [
          "number",
          "null"
         ]
        },
        "updatesPerLink": {
         "description": "This website\u2019s update limit; null means unlimited subject to fair use",
         "type": [
          "number",
          "null"
         ]
        }
       },
       "required": [
        "updatesPerLink",
        "inactivityWindowDays",
        "canReactivate"
       ],
       "type": "object"
      },
      "publicationState": {
       "description": "Whether the page is a private draft or published",
       "enum": [
        "draft",
        "published"
       ],
       "type": "string"
      },
      "shareUrl": {
       "$ref": "#/properties/workspaceId",
       "description": "Primary share URL, omitted for private drafts"
      }
     },
     "required": [
      "linkId",
      "fileName",
      "publicationState",
      "accessMode",
      "isRevoked"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limit": {
    "description": "Pagination limit used by the response",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset used by the response",
    "type": "number"
   },
   "total": {
    "description": "Total page count before pagination",
    "type": "number"
   },
   "workspaceId": {
    "description": "Workspace whose links were listed; omitted for Personal",
    "type": [
     "string",
     "null"
    ]
   },
   "workspaces": {
    "description": "Carryo workspaces the authenticated user can access",
    "items": {
     "additionalProperties": false,
     "properties": {
      "capabilities": {
       "additionalProperties": false,
       "description": "Workspace actions currently available to the authenticated user",
       "properties": {
        "canListLinks": {
         "description": "Whether workspace links can be listed",
         "type": "boolean"
        },
        "canPublishLinks": {
         "description": "Whether new workspace links can be published",
         "type": "boolean"
        },
        "canRevokeLinks": {
         "description": "Whether workspace links can be revoked",
         "type": "boolean"
        },
        "canUpdateLinks": {
         "description": "Whether workspace links can be updated",
         "type": "boolean"
        }
       },
       "required": [
        "canListLinks",
        "canPublishLinks",
        "canUpdateLinks",
        "canRevokeLinks"
       ],
       "type": "object"
      },
      "role": {
       "description": "The authenticated user role in this workspace",
       "enum": [
        "owner",
        "editor"
       ],
       "type": "string"
      },
      "workspaceId": {
       "description": "Stable Carryo workspace identifier to use in later tool calls",
       "type": "string"
      },
      "workspaceName": {
       "description": "User-facing Carryo workspace name",
       "type": "string"
      }
     },
     "required": [
      "workspaceId",
      "workspaceName",
      "role",
      "capabilities"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "artifacts",
   "total",
   "limit",
   "offset",
   "workspaces"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "artifact.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Carryo"
}
