{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "qa",
 "description": "Compute text similarity between reference and hypothesis using multiple metrics: Cosine (BoW, TF-IDF), Jaccard, ROUGE-1, ROUGE-2, ROUGE-L, and BLEU. No API key needed. Ideal for LLM eval (expected vs actual), RAG quality checks, and NLG benchmarking. Supports batch mode.",
 "inputSchema": {
  "properties": {
   "batch": {
    "description": "Batch mode: array of {reference, hypothesis} pairs.",
    "items": {
     "properties": {
      "hypothesis": {
       "type": "string"
      },
      "reference": {
       "type": "string"
      }
     },
     "required": [
      "reference",
      "hypothesis"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hypothesis": {
    "description": "Hypothesis / actual text (LLM output)",
    "type": "string"
   },
   "metrics": {
    "description": "Metrics to compute (default: all). Options: \"cosine_bow\", \"cosine_tfidf\", \"jaccard\", \"rouge1\", \"rouge2\", \"rougeL\", \"bleu\"",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reference": {
    "description": "Reference / expected text (ground truth)",
    "type": "string"
   },
   "threshold": {
    "description": "Optional pass/fail threshold (0-1). Applies to ROUGE-L F1 score.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "similarity_score",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "type": "number"
   },
   "f1": {
    "type": "number"
   },
   "mode": {
    "type": "string"
   },
   "precision": {
    "type": "number"
   },
   "recall": {
    "type": "number"
   },
   "results": {}
  },
  "type": "object"
 }
}
