{
 "annotations": {
  "readOnlyHint": true,
  "title": "List commissions"
 },
 "description": "List partner commissions, by partner, status, customer or time window. Dub: GET /commissions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "customerId": {
    "description": "Only commissions from this customer.",
    "type": "string"
   },
   "interval": {
    "description": "Relative time window. Use start/end instead for an absolute range.",
    "enum": [
     "24h",
     "7d",
     "30d",
     "90d",
     "1y",
     "mtd",
     "qtd",
     "ytd",
     "all"
    ],
    "type": "string"
   },
   "page": {
    "description": "1-based page number.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Page size, 1-100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "partnerId": {
    "description": "Only this partner's commissions.",
    "type": "string"
   },
   "status": {
    "description": "Only commissions in this state.",
    "type": "string"
   },
   "type": {
    "description": "Only commissions of this type, e.g. sale, lead, click.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "dub_list_commissions",
 "title": "List commissions"
}
