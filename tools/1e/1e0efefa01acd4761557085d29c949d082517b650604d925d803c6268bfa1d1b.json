{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Preview attaching a published agreement version to Project To-dos (writes nothing): each job's masked recipients (\"First L.\"), whether future hires are included, warnings, and a receipt valid for 15 minutes. Pass the receipt unchanged to opentrain_agreements_project_todos_attach. SELECTED needs selectedContractIds, each a contract of one listed job (RECIPIENT_NOT_ELIGIBLE otherwise). Requires agreements:write and project_todos:write. Requires the agreements family flag and the agreements_native rollout; denials carry details.reason (AGENT_SURFACE_DISABLED, AGREEMENTS_DISABLED, TENANT_ACCESS_DENIED).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "enum": [
     "ACTIVE",
     "FUTURE",
     "ACTIVE_AND_FUTURE",
     "SELECTED"
    ],
    "type": "string"
   },
   "blockingMode": {
    "default": "NONE",
    "enum": [
     "NONE",
     "IMMEDIATE",
     "AFTER_DUE"
    ],
    "type": "string"
   },
   "dueAt": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "jobIds": {
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "selectedContractIds": {
    "default": [],
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "versionId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "versionId",
   "jobIds",
   "audience"
  ],
  "type": "object"
 },
 "name": "opentrain_agreements_project_todos_attach_preflight",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "const": "preflight",
      "type": "string"
     },
     "audience": {
      "enum": [
       "ACTIVE",
       "FUTURE",
       "ACTIVE_AND_FUTURE",
       "SELECTED"
      ],
      "type": "string"
     },
     "basePdfSha256": {
      "$ref": "#/properties/result/properties/definitionHash"
     },
     "blockingMode": {
      "enum": [
       "NONE",
       "IMMEDIATE",
       "AFTER_DUE"
      ],
      "type": "string"
     },
     "definitionHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "documentId": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     "dueAt": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "includesFutureHires": {
      "type": "boolean"
     },
     "jobs": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "currentRecipientCount": {
         "minimum": 0,
         "type": "integer"
        },
        "jobId": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "recipients": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "contractId": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
           },
           "displayName": {
            "maxLength": 120,
            "type": "string"
           }
          },
          "required": [
           "contractId",
           "displayName"
          ],
          "type": "object"
         },
         "maxItems": 500,
         "type": "array"
        },
        "recipientsTruncated": {
         "type": "boolean"
        }
       },
       "required": [
        "jobId",
        "currentRecipientCount",
        "recipients",
        "recipientsTruncated"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "receipt": {
      "additionalProperties": false,
      "properties": {
       "expiresAt": {
        "format": "date-time",
        "type": "string"
       },
       "token": {
        "maxLength": 8192,
        "minLength": 16,
        "type": "string"
       }
      },
      "required": [
       "token",
       "expiresAt"
      ],
      "type": "object"
     },
     "totalRecipientCount": {
      "minimum": 0,
      "type": "integer"
     },
     "versionId": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     "versionNumber": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "warnings": {
      "items": {
       "maxLength": 300,
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     }
    },
    "required": [
     "action",
     "versionId",
     "documentId",
     "versionNumber",
     "definitionHash",
     "basePdfSha256",
     "audience",
     "includesFutureHires",
     "blockingMode",
     "dueAt",
     "jobs",
     "totalRecipientCount",
     "receipt",
     "warnings"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
