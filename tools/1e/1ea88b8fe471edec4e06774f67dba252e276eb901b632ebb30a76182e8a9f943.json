{
 "description": "Close (or partially close) a sandbox position. Pass either position_id or (exchange, symbol, side). Returns realized PnL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "type": "string"
   },
   "exchange": {
    "enum": [
     "binance",
     "bybit",
     "okx",
     "mexc",
     "hyperliquid"
    ],
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 64,
    "type": "string"
   },
   "position_id": {
    "format": "uuid",
    "type": "string"
   },
   "quantity": {
    "description": "Partial close quantity (defaults to full)",
    "type": "string"
   },
   "side": {
    "enum": [
     "long",
     "short"
    ],
    "type": "string"
   },
   "symbol": {
    "type": "string"
   }
  },
  "required": [
   "api_key"
  ],
  "type": "object"
 },
 "name": "sandbox_close_position"
}
