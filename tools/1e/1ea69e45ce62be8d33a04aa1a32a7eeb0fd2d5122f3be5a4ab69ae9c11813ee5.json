{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "profile",
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use this when the user wants to change where a tender stands in their team's Tenda pipeline: to Qualifying while they look into it, back to Watching, to Submitted, or to Won or Lost when the buyer announces the result. Moving to Bidding or No bid takes the bid or no-bid call (use record_bid_call). Needs a Tenda account and workspace. Do not use to take a tender off the pipeline, which is done in the Tenda dashboard.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "stage": {
    "description": "Where the tender goes: \"watching\", \"qualifying\", \"bidding\", \"submitted\", \"won\", \"lost\" or \"no_bid\".",
    "enum": [
     "watching",
     "qualifying",
     "bidding",
     "submitted",
     "won",
     "lost",
     "no_bid"
    ],
    "type": "string"
   },
   "tender_reference": {
    "description": "The notice ID, procurement identifier, solicitation number or the buyer's own reference, e.g. \"012345-2026\" on Find a Tender, \"WS4851234567\" on CanadaBuys or \"140D0427Q0879\" on SAM.gov.",
    "minLength": 3,
    "type": "string"
   },
   "workspace": {
    "description": "The Tenda workspace to use, by name, when the user is in more than one, e.g. \"Northbridge Services\".",
    "type": "string"
   }
  },
  "required": [
   "tender_reference",
   "stage"
  ],
  "type": "object"
 },
 "name": "move_in_pipeline",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "moved": {
    "type": "boolean"
   },
   "stage": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "tender": {
    "additionalProperties": {},
    "properties": {
     "buyer": {
      "type": "string"
     },
     "closes": {
      "type": "string"
     },
     "closesAt": {
      "type": "string"
     },
     "daysLeft": {
      "type": "number"
     },
     "reference": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "workspace": {
    "additionalProperties": {},
    "properties": {
     "name": {
      "type": "string"
     },
     "role": {
      "type": "string"
     },
     "timeZone": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "summary"
  ],
  "type": "object"
 },
 "title": "Move a tender in the pipeline"
}
