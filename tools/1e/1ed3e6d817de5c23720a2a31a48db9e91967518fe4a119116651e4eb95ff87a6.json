  "title": "Assess EU Import (Beta)"
 },
 "description": "Use when you need a source-backed assessment of importing a product into the EU (tariff classification, duties, and related evidence). Returns an EvidenceEnvelope; import assessment is Beta and results expose source coverage and support levels.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assessment_type": {
    "description": "Currently only import is supported.",
    "enum": [
     "import"
    ],
    "type": "string"
   },
   "parameters": {
    "additionalProperties": false,
    "description": "Required + optional inputs for assess_import.",
    "properties": {
     "assessment_date": {
      "anyOf": [
       {
        "format": "date",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Optional TARIC effective/simulation date; availability depends on the installed snapshot.",
      "title": "Assessment Date"
     },
     "currency": {
      "examples": [
       "EUR"
      ],
      "maxLength": 3,
      "minLength": 3,
      "title": "Currency",
      "type": "string"
     },
     "destination_country": {
      "examples": [
       "FR"
      ],
      "maxLength": 2,
      "minLength": 2,
      "title": "Destination Country",
      "type": "string"
     },
     "destination_location": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Destination Location"
     },
     "dimensions": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Dimensions"
     },
     "freight_cost": {
      "anyOf": [
       {
        "minimum": 0.0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Freight Cost"
     },
     "goods_value": {
      "examples": [
       13500.0
      ],
      "maximum": 1000000000000,
      "minimum": 0.01,
      "title": "Goods Value",
      "type": "number"
     },
     "incoterm": {
      "anyOf": [
       {
        "maxLength": 10,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Incoterm"
     },
     "insurance_cost": {
      "anyOf": [
       {
        "minimum": 0.0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Insurance Cost"
     },
     "known_hs_code": {
      "anyOf": [
       {
        "maxLength": 10,
        "minLength": 6,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "examples": [
       "960100"
      ],
      "title": "Known Hs Code"
     },
     "manufacturer": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Manufacturer"
     },
     "material": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Material"
     },
     "model": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Model"
     },
     "origin_country": {
      "examples": [
       "CN"
      ],
      "maxLength": 2,
      "minLength": 2,
      "title": "Origin Country",
      "type": "string"
     },
     "origin_location": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Origin Location"
     },
     "product": {
      "examples": [
       "750ml insulated stainless steel drinking bottle"
      ],
      "maxLength": 500,
      "minLength": 3,
      "title": "Product",
      "type": "string"
     },
     "quantity": {
      "examples": [
       5000
      ],
      "maximum": 1000000000,
      "minimum": 1,
      "title": "Quantity",
      "type": "integer"
     },
     "shipping_mode": {
      "anyOf": [
       {
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Shipping Mode"
     },
     "weight_kg": {
      "anyOf": [
       {
        "maximum": 1000000000,
        "minimum": 0.0001,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Weight Kg"
     }
    },
    "required": [
     "product",
     "origin_country",
     "destination_country",
     "quantity",
     "goods_value",
     "currency"
    ],
    "title": "AssessImportInput",
    "type": "object"
   }
  },
  "required": [
   "assessment_type",
   "parameters"
  ],
  "type": "object"
 },
