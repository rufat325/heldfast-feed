{
 "_meta": {
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit imported SVG"
 },
 "description": "Change inspected foreign-tree nodes while preserving untouched bytes, definitions and safe references. Requires the complete SVG read handle.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent": {
    "type": "string"
   },
   "alt": {
    "minLength": 1,
    "type": "string"
   },
   "document": {
    "maxLength": 64,
    "type": "string"
   },
   "label": {
    "type": "string"
   },
   "node_edits": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attributes": {
       "additionalProperties": {
        "maxLength": 16384,
        "type": [
         "string",
         "null"
        ]
       },
       "maxProperties": 64,
       "minProperties": 1,
       "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$",
        "type": "string"
       },
       "type": "object"
      },
      "geometry": {
       "additionalProperties": {
        "maxLength": 16384,
        "type": [
         "string",
         "number",
         "null"
        ]
       },
       "maxProperties": 64,
       "minProperties": 1,
       "propertyNames": {
        "enum": [
         "x",
         "y",
         "x1",
         "y1",
         "x2",
         "y2",
         "cx",
         "cy",
         "r",
         "rx",
         "ry",
         "fx",
         "fy",
         "fr",
         "width",
         "height",
         "dx",
         "dy",
         "d",
         "points",
         "pathLength",
         "transform",
         "viewBox",
         "preserveAspectRatio",
         "rotate",
         "textLength",
         "lengthAdjust",
         "startOffset",
         "offset",
         "refX",
         "refY",
         "markerWidth",
         "markerHeight",
         "orient",
         "gradientTransform",
         "patternTransform"
        ],
        "type": "string"
       },
       "type": "object"
      },
      "id": {
       "maxLength": 1024,
       "pattern": "^svg:0(?:\\.[0-9]+)*$",
       "type": "string"
      },
      "style": {
       "additionalProperties": {
        "maxLength": 16384,
        "type": [
         "string",
         "null"
        ]
       },
       "maxProperties": 64,
       "minProperties": 1,
       "propertyNames": {
        "enum": [
         "alignment-baseline",
         "baseline-shift",
         "clip-path",
         "clip-rule",
         "color",
         "color-interpolation",
         "color-interpolation-filters",
         "direction",
         "display",
         "dominant-baseline",
         "fill",
         "fill-opacity",
         "fill-rule",
         "filter",
         "flood-color",
         "flood-opacity",
         "font-family",
         "font-size",
         "font-size-adjust",
         "font-stretch",
         "font-style",
         "font-variant",
         "font-weight",
         "image-rendering",
         "letter-spacing",
         "lighting-color",
         "marker-start",
         "marker-mid",
         "marker-end",
         "mask",
         "opacity",
         "overflow",
         "paint-order",
         "pointer-events",
         "shape-rendering",
         "stop-color",
         "stop-opacity",
         "stroke",
         "stroke-dasharray",
         "stroke-dashoffset",
         "stroke-linecap",
         "stroke-linejoin",
         "stroke-miterlimit",
         "stroke-opacity",
         "stroke-width",
         "text-anchor",
         "text-decoration",
         "text-rendering",
         "transform",
         "transform-box",
         "transform-origin",
         "unicode-bidi",
         "vector-effect",
         "visibility",
         "white-space",
         "word-spacing",
         "writing-mode"
        ],
        "type": "string"
       },
       "type": "object"
      },
      "text": {
       "maxLength": 16384,
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "maxItems": 128,
    "minItems": 1,
    "type": "array"
   },
   "operation_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "svg_handle": {
    "maxLength": 128,
    "type": "string"
   },
   "turn_id": {
    "maxLength": 160,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   }
  },
  "required": [
   "document",
   "svg_handle",
   "node_edits"
  ],
  "type": "object"
 },
 "name": "svg.edit",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "outcome": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Edit imported SVG"
}
