{
 "description": "Apply text formatting to cells in a Google Sheet",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Alias of the Google account to target. Optional \u2014 defaults to the session/global default account, or the sole authenticated account. Run manage_accounts list to see available aliases.",
    "type": "string"
   },
   "bold": {
    "description": "Make text bold",
    "type": "boolean"
   },
   "fontFamily": {
    "description": "Font family name",
    "type": "string"
   },
   "fontSize": {
    "description": "Font size in points",
    "type": "number"
   },
   "foregroundColor": {
    "description": "Text color (RGB values 0-1)",
    "properties": {
     "blue": {
      "type": "number"
     },
     "green": {
      "type": "number"
     },
     "red": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "italic": {
    "description": "Make text italic",
    "type": "boolean"
   },
   "range": {
    "description": "Range to format (e.g., 'A1:C10')",
    "type": "string"
   },
   "spreadsheetId": {
    "description": "Spreadsheet ID",
    "type": "string"
   },
   "strikethrough": {
    "description": "Strikethrough text",
    "type": "boolean"
   },
   "underline": {
    "description": "Underline text",
    "type": "boolean"
   }
  },
  "required": [
   "spreadsheetId",
   "range"
  ],
  "type": "object"
 },
 "name": "formatGoogleSheetText"
}
