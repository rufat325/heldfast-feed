{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update a calendar's settings. Only provided fields are modified.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color": {
    "description": "New hex color code",
    "type": "string"
   },
   "description": {
    "description": "New description",
    "type": "string"
   },
   "id": {
    "description": "Calendar UUID",
    "type": "string"
   },
   "isActive": {
    "description": "Enable or disable the calendar",
    "type": "boolean"
   },
   "name": {
    "description": "New display name",
    "type": "string"
   },
   "notifyEmail": {
    "description": "Toggle email notifications",
    "type": "boolean"
   },
   "notifyEmailAddress": {
    "description": "New host email for notifications",
    "type": "string"
   },
   "notifyPhone": {
    "description": "New host phone for WhatsApp notifications",
    "type": "string"
   },
   "notifyWhatsapp": {
    "description": "Toggle WhatsApp notifications",
    "type": "boolean"
   },
   "timezone": {
    "description": "New IANA timezone",
    "type": "string"
   },
   "visibility": {
    "description": "New visibility",
    "enum": [
     "private",
     "public",
     "org-link"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "neuron_update_calendar",
 "title": "Update Calendar"
}
