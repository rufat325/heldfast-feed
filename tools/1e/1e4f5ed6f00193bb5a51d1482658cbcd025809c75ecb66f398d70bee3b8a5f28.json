{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List email campaigns"
 },
 "description": "List recent email campaigns for a specific Klaviyo account. Returns campaign IDs, names, status, and send dates.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account": {
    "description": "Account name (e.g., 'my-store' or 'My Store')",
    "type": "string"
   },
   "status": {
    "description": "Filter by campaign status (case-sensitive Klaviyo values). Default: all.",
    "enum": [
     "Draft",
     "Queued without Recipients",
     "Scheduled",
     "Sending",
     "Sent",
     "Cancelled"
    ],
    "type": "string"
   }
  },
  "required": [
   "account"
  ],
  "type": "object"
 },
 "name": "list_campaigns"
}
