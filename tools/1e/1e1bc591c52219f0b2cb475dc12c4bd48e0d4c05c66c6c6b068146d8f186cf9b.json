{
 "annotations": {
  "destructiveHint": true,
  "title": "Schedule a calendar event"
 },
 "description": "Create a timed (or all-day) event on your calendar, optionally with contacts/users as attendees. The timezone of start_date becomes the event's timezone. Returns { EventId }. LACRM: CreateEvent.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attendees": {
    "description": "Attendees: contacts and/or users.",
    "items": {
     "properties": {
      "id": {
       "description": "ContactId (is_user=false) or UserId (is_user=true).",
       "type": "string"
      },
      "is_user": {
       "description": "true if this attendee is a CRM user. Default false (a contact).",
       "type": "boolean"
      },
      "status": {
       "enum": [
        "IsAttending",
        "Maybe",
        "NotAttending"
       ],
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "calendar_id": {
    "description": "Calendar to put it on. Default: your primary (a long numeric Uid \u2014 always pass it as a string).",
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "end_date": {
    "description": "End, ISO 8601 date-time.",
    "type": "string"
   },
   "is_all_day": {
    "description": "All-day event (times ignored). Default false.",
    "type": "boolean"
   },
   "location": {
    "type": "string"
   },
   "name": {
    "description": "Event name shown on the calendar.",
    "minLength": 1,
    "type": "string"
   },
   "start_date": {
    "description": "Start, ISO 8601 date-time, e.g. 2026-10-06T14:00:00-05:00.",
    "type": "string"
   }
  },
  "required": [
   "name",
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "lacrm_create_event",
 "title": "Schedule a calendar event"
}
