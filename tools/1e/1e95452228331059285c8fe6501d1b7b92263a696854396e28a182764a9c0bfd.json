{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Print the active document to a printer, or to a PostScript file with outputFile. A print preset is the base; options are grouped like the Print dialog's pages and override it","inputSchema":{"properties":{"colorManagement":{"description":"Color management","properties":{"intent":{"enum":["perceptual","saturation","relative_colorimetric","absolute_colorimetric"],"type":"string"},"profile":{"description":"source (the document's), printer, or custom (named by profileName)","enum":["source","printer","custom"],"type":"string"},"profileName":{"type":"string"}},"type":"object"},"flattener":{"description":"Advanced: transparency flattening. Give a preset, or the settings","properties":{"balance":{"description":"Raster/vector balance: 0 all raster, 100 all vector","maximum":100,"minimum":0,"type":"number"},"clipComplexRegions":{"type":"boolean"},"gradientResolution":{"maximum":9600,"minimum":1,"type":"number"},"lineArtResolution":{"maximum":9600,"minimum":1,"type":"number"},"overprint":{"enum":["preserve","discard"],"type":"string"},"preset":{"description":"Flattener preset name, e.g. \"[High Resolution]\"","type":"string"},"strokesToOutlines":{"type":"boolean"},"textToOutlines":{"type":"boolean"}},"type":"object"},"fonts":{"description":"Fonts","properties":{"download":{"enum":["none","subset","complete"],"type":"string"},"substitution":{"enum":["oblique","tint","device"],"type":"string"}},"type":"object"},"general":{"description":"General: copies, artboards, layers, bounds, job name","properties":{"artboards":{"description":"Artboards, 1-based: \"1\", \"1-3,5\". Default all","type":"string"},"bitmapResolution":{"maximum":2400,"minimum":72,"type":"number"},"bounds":{"description":"artboard; artwork (Ignore Artboards); or crop","enum":["artboard","artwork","crop"],"type":"string"},"collate":{"type":"boolean"},"copies":{"maximum":9999,"minimum":1,"type":"i