{
 "annotations": {
  "readOnlyHint": true,
  "title": "List tasks"
 },
 "description": "List tasks due in a date range, optionally only incomplete/complete, for given users. If contact_id is given, ALL of that contact's tasks are returned regardless of dates or status. LACRM: GetTasks.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "completion_status": {
    "description": "Default Both.",
    "enum": [
     "Both",
     "Incomplete",
     "Complete"
    ],
    "type": "string"
   },
   "contact_id": {
    "description": "Only tasks attached to this contact (a long numeric Uid \u2014 always pass it as a string).",
    "minLength": 1,
    "type": "string"
   },
   "end_date": {
    "description": "Upper bound of due dates, yyyy-mm-dd.",
    "type": "string"
   },
   "max_results": {
    "description": "Results per page (MaxNumberOfResults), 1-10000. Default here: 50.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number, 1-based. Default 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "sort_direction": {
    "description": "Sort direction.",
    "enum": [
     "Ascending",
     "Descending"
    ],
    "type": "string"
   },
   "start_date": {
    "description": "Lower bound of due dates, yyyy-mm-dd.",
    "type": "string"
   },
   "user_ids": {
    "description": "Only tasks assigned to these UserIds.",
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     ]
    },
    "type": "array"
   }
  },
  "required": [
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "lacrm_list_tasks",
 "title": "List tasks"
}
