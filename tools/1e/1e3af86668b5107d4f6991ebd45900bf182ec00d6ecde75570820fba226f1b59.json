{
 "annotations": {},
 "description": "Find and replace text in TEXT nodes, on the current page or inside nodeId.",
 "inputSchema": {
  "properties": {
   "find": {
    "description": "Text or regex to find",
    "type": "string"
   },
   "nodeId": {
    "description": "Search inside this node (default: current page)",
    "type": "string"
   },
   "regexFlags": {
    "description": "Regex flags (default 'g')",
    "type": "string"
   },
   "replace": {
    "description": "Replacement. \"\" deletes the text.",
    "type": "string"
   },
   "useRegex": {
    "description": "find is a regex (default false)",
    "type": "boolean"
   }
  },
  "required": [
   "find",
   "replace"
  ],
  "type": "object"
 },
 "name": "find_replace_text"
}
