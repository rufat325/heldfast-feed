{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks for papers from a specific conference (optionally a year), e.g. \u201cmost-cited NeurIPS 2024 papers\u201d, \u201cshow me CCS 2025 accepted papers\u201d, or \u201cwhat's new in security at IEEE S&P this year\u201d. `sort` is `recency` (newest first, default) or `citations` (most-cited first); page with `limit` / `offset`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "conference": {
    "description": "Conference short name, e.g. \"NeurIPS\", \"CCS\", \"ICLR\".",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max papers to return per page (default 20, max 100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset; use to fetch subsequent pages.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "sort": {
    "default": "recency",
    "description": "`recency` (newest first, default) or `citations` (most-cited first).",
    "enum": [
     "recency",
     "citations"
    ],
    "type": "string"
   },
   "year": {
    "description": "Restrict to a single year (e.g. 2024). Omit to span all years.",
    "maximum": 2100,
    "minimum": 1990,
    "type": "integer"
   }
  },
  "required": [
   "conference"
  ],
  "type": "object"
 },
 "name": "get_conference_papers",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "has_more": {
    "description": "True when more papers exist past this page; re-call with offset += limit.",
    "type": "boolean"
   },
   "papers": {
    "items": {
     "properties": {
      "abstract": {
       "type": "string"
      },
      "arxiv_id": {
       "type": "string"
      },
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "citation_count": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "conference": {
       "description": "Conference short name (e.g. NeurIPS, CCS).",
       "type": "string"
      },
      "doi": {
       "type": "string"
      },
      "paper_id": {
       "description": "Lune paper UUID. An internal handle for fetching a paper's FULL TEXT via get_paper_fulltext; do NOT show it to the user. Cite papers by title, authors, and venue instead.",
       "type": "string"
      },
      "pdf_cdn_url": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "year": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "paper_id",
      "title",
      "authors",
      "citation_count"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Total papers at this venue matching the filters (paging count).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "papers"
  ],
  "type": "object"
 },
 "title": "Get conference papers"
}
