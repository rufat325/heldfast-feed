{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new goal. Types: milestone (checklist), numeric (value tracking), habit, vision.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Category (e.g., Health, Career, Finance)",
    "type": "string"
   },
   "current_value": {
    "description": "Current value (numeric goals, >= 0)",
    "type": "number"
   },
   "description": {
    "description": "Goal description",
    "type": "string"
   },
   "goal_type": {
    "description": "Type",
    "enum": [
     "milestone",
     "numeric",
     "habit",
     "vision"
    ],
    "type": "string"
   },
   "milestones": {
    "description": "Milestones array [{title: \"...\"}] (for milestone goals)",
    "type": "array"
   },
   "priority": {
    "description": "Priority: 1=high, 2=medium, 3=low",
    "enum": [
     1,
     2,
     3
    ],
    "type": "integer"
   },
   "start_value": {
    "description": "Starting value; defaults to current_value. Lets goals that go down (90 -> 80 kg) show progress",
    "type": "number"
   },
   "target_date": {
    "description": "Target date (Y-m-d)",
    "type": "string"
   },
   "target_value_num": {
    "description": "Target value (for numeric goals)",
    "type": "number"
   },
   "title": {
    "description": "Goal title",
    "type": "string"
   },
   "unit": {
    "description": "Unit of measurement (for numeric goals)",
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "create_goal",
 "title": "Create goal"
}
