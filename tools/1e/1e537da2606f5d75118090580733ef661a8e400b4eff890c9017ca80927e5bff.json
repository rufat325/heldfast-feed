{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Resolve an EU legal citation"},"description":"Use this to resolve a written EU legal citation, such as Article 97(1) PSD2, into an instrument and provision locator. For a topic rather than a citation, use search_legislation. Ranked candidates with ambiguity flagged and confidence stated: exact (instrument certain, provision found), strong (instrument certain, provision not verified or not named) or ambiguous (more than one reading). A citation of an instrument this corpus does not hold is named, with its CELEX and ELI, rather than guessed at.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"citation":{"description":"A citation in any form a reader would write: \"Article 97(1) PSD2\", \"Art. 5a of Regulation (EU) No 910/2014\", a CELEX number, an ELI path, or a bare acronym.","type":"string"},"cursor":{"anyOf":[{"maxLength":512,"pattern":"^[A-Za-z0-9_-]+$","type":"string"},{"type":"null"}]},"limit":{"anyOf":[{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},{"type":"null"}]}},"required":["citation"],"type":"object"},"name":"resolve_citation","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"corpus_release":{"additionalProperties":false,"properties":{"built_at":{"type":"string"},"corpus_release_id":{"type":"string"},"schema_version":{"type":"string"}},"required":["corpus_release_id","schema_version","built_at"],"type":"object"},"coverage":{"additionalProperties":false,"properties":{"corpus":{"type":"string"},"exhaustive":{"type":"boolean"},"language":{"type":"string"},"national_implementation":{"type":"boolean"}},"required":["corpus","language","exhaustive","national_implementation"],"type":"object"},"data":{"anyOf":[{"additionalProperties":{},"properties":{"ambiguous":{"type":"boolean"},"items":{"items":{"additionalProperties":{