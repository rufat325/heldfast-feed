      "song_dna",
      "timeline",
      "best_moments",
      "lyrics",
      "scores",
      "story",
      "shot_plan"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "song_id": {
    "type": "string"
   },
   "view": {
    "default": "summary",
    "enum": [
     "summary",
     "full"
    ],
    "type": "string"
   }
  },
  "required": [
   "song_id"
  ],
  "type": "object"
 },
 "name": "get_song",
 "title": "Get a song's analysis"
}
