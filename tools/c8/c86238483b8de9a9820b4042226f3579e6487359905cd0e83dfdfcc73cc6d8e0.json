    "type": "number"
   },
   "pr": {
    "description": "Comment on this pull request. Mutually exclusive with issue.",
    "type": "number"
   },
   "repo": {
    "description": "owner/name repository (default: gh/git inference).",
    "type": "string"
   },
   "workspace": {
    "description": "Override the workspace for this call (like the CLI's --workspace flag).",
    "type": "string"
   }
  },
  "type": "object"
 },
