{
 "description": "Search One Piece TCG cards by name, color, type, cost, power, rarity, attribute, character type, or set. Returns card details with effects.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attribute": {
    "description": "Attribute: Slash, Strike, Ranged, Special, Wisdom",
    "type": "string"
   },
   "card_type": {
    "description": "Card type: LEADER, CHARACTER, EVENT, STAGE",
    "type": "string"
   },
   "color": {
    "description": "Card color: Red, Blue, Green, Purple, Yellow, Black",
    "type": "string"
   },
   "cost": {
    "description": "Exact cost value",
    "type": "number"
   },
   "cost_max": {
    "description": "Maximum cost",
    "type": "number"
   },
   "cost_min": {
    "description": "Minimum cost",
    "type": "number"
   },
   "has_counter": {
    "description": "Filter cards with/without counter value",
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "description": "Max results (default 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Offset for pagination",
    "minimum": 0,
    "type": "number"
   },
   "power_max": {
    "description": "Maximum power",
    "type": "number"
   },
   "power_min": {
    "description": "Minimum power",
    "type": "number"
   },
   "query": {
    "description": "Search card name, number, effect text, or character type",
    "type": "string"
   },
   "rarity": {
    "description": "Rarity: C, UC, R, SR, SEC, L, SP CARD, P, TR",
    "type": "string"
   },
   "set": {
    "description": "Set name or code (e.g., \"OP-01\", \"ROMANCE DAWN\")",
    "type": "string"
   },
   "type": {
    "description": "Character type (e.g., \"Straw Hat Crew\", \"Navy\", \"Supernovas\")",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_cards"
}
