{
 "description": "Update a product. Only the fields you pass are changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "askForAddress": {
    "type": "boolean"
   },
   "askForName": {
    "type": "boolean"
   },
   "askForPhoneNumber": {
    "type": "boolean"
   },
   "currency": {
    "enum": [
     "USD",
     "EUR",
     "GBP",
     "CAD",
     "AUD",
     "JPY"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "image": {
    "type": "string"
   },
   "isActive": {
    "type": "boolean"
   },
   "name": {
    "type": "string"
   },
   "price": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "productId": {
    "description": "Product ID (prd_...).",
    "type": "string"
   }
  },
  "required": [
   "productId"
  ],
  "type": "object"
 },
 "name": "update_product",
 "title": "Update product"
}
