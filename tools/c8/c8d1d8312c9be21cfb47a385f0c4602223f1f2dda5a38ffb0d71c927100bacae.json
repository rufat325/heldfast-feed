{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Funding a Hyperliquid wallet paid or received, per market per bucket. Positive means received, negative means paid. bucket=1d gives daily totals, 1h the raw hourly payments.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "0x-prefixed 20-byte hex address",
    "type": "string"
   },
   "bucket": {
    "description": "Aggregation bucket; default 1d",
    "enum": [
     "1h",
     "1d",
     "raw"
    ],
    "type": "string"
   },
   "from": {
    "description": "Unix ms window start (inclusive)",
    "type": "number"
   },
   "limit": {
    "description": "Most recent rows to return (default 200)",
    "type": "number"
   },
   "market": {
    "description": "Optional market filter (e.g. BTC-PERP)",
    "type": "string"
   },
   "to": {
    "description": "Unix ms window end (exclusive)",
    "type": "number"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_user_funding",
 "outputSchema": {
  "description": "Funding paid or received per market per bucket",
  "properties": {
   "address": {
    "description": "Wallet address (0x\u2026)"
   },
   "bucket": {
    "description": "Bucket size"
   },
   "data": {
    "description": "Buckets",
    "items": {
     "description": "One bucket and market",
     "properties": {
      "avg_funding_rate": {
       "description": "Average hourly rate"
      },
      "avg_position": {
       "description": "Average position size"
      },
      "bucket_start": {
       "description": "Bucket start, Unix milliseconds"
      },
      "funding_payment": {
       "description": "USD; positive received, negative paid"
      },
      "interval_count": {
       "description": "Hourly payments in the bucket"
      },
      "market": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "market_class": {
       "description": "perp, spot, prediction or option"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "from": {
    "description": "Window start, Unix milliseconds"
   },
   "returned": {
    "description": "Rows in data, most recent first"
   },
   "to": {
    "description": "Window end, Unix milliseconds"
   },
   "total_rows": {
    "description": "Rows in the window before the limit"
   }
  },
  "type": "object"
 }
}
