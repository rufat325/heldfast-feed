{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Search/filter nodes in a graph. Returns COMPACT refs (id, name, type, path, score, 1-line summary) \u2014 not source. Combine filters (AND). Use nodeIds for an exact batch fetch. Results are score-ranked and capped by `limit` (default 25).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "commitHash": {
    "type": "string"
   },
   "dir": {
    "description": "Nodes under this folder (prefix)",
    "type": "string"
   },
   "filePath": {
    "description": "Nodes in exactly this file",
    "type": "string"
   },
   "graphId": {
    "type": "string"
   },
   "limit": {
    "description": "Default 25",
    "type": "number"
   },
   "minScore": {
    "type": "number"
   },
   "name": {
    "description": "Substring match on node name",
    "type": "string"
   },
   "nodeIds": {
    "description": "Exact ids to resolve; ignores other filters",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "nodeTypes": {
    "description": "e.g. COMPONENT, HOOK, FUNCTION, ROUTE",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "severity": {
    "description": "Min security severity",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   }
  },
  "required": [
   "graphId"
  ],
  "type": "object"
 },
 "name": "find_nodes"
}
