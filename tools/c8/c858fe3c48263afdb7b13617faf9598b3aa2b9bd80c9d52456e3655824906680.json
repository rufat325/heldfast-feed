 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Records the NAICS industry classification a founder has chosen for their formation. Call formation_suggest_naics_codes first, show the candidates with their official titles, and call this ONLY after the person has explicitly picked one. Never choose on their behalf and never infer a code from the business description alone: this value travels onto a bank application, where a wrong classification is a compliance problem rather than a typo. The code is checked against the 2022 edition and a code naming no real industry is refused.",
 "inputSchema": {
  "properties": {
   "formationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "naicsCode": {
    "maxLength": 6,
    "pattern": "^([0-9]{2,6})?$",
    "type": "string"
   }
  },
  "required": [
   "formationId"
  ],
  "type": "object"
 },
 "name": "formation_confirm_naics_code",
 "outputSchema": {
  "properties": {
   "formationId": {
    "anyOf": [
     {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "naicsCode": {
    "type": "string"
   },
   "naicsTitle": {
    "anyOf": [
     {
      "description": "Human-readable name (1-255 Unicode chars).",
      "properties": {
       "value": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "title": "Confirm Naics Code"
}
