{
 "description": "[Wicked Memory] Fetch one of your memories by id (another wallet's or a deleted id returns the same 404).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "memory_id": {
    "description": "The memory's UUID.",
    "type": "string"
   },
   "nonce": {
    "description": "From memory_prepare (single use).",
    "type": "string"
   },
   "signature": {
    "description": "Your wallet's signature over memory_prepare's message_to_sign.",
    "type": "string"
   },
   "timestamp": {
    "description": "From memory_prepare.",
    "type": "string"
   },
   "wallet": {
    "description": "Your agent's 0x wallet address.",
    "type": "string"
   }
  },
  "required": [
   "wallet",
   "memory_id",
   "timestamp",
   "nonce",
   "signature"
  ],
  "type": "object"
 },
 "name": "memory_get"
}
