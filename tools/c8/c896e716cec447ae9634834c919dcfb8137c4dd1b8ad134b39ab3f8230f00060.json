{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "CodeInspectus Compliance Report"
 },
 "description": "Produce a per-framework code-level control-coverage view for a prior scan (NIST CSF 2.0, ISO 27001:2022, SOC 2, CIS v8.1, Essential Eight, OWASP Web/LLM). Reports 'X of N code-visible controls have findings' with the code-visible subset as the explicit denominator. This is NOT a compliance audit, certification, or attestation \u2014 code-level evidence only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "framework": {
    "description": "Restrict the report to one framework. Default: all frameworks.",
    "enum": [
     "NIST_CSF_2.0",
     "ISO27001:2022",
     "SOC2",
     "CIS_v8.1",
     "EssentialEight",
     "OWASP_Web_2021",
     "OWASP_LLM_2025"
    ],
    "type": "string"
   },
   "scan_id": {
    "description": "scan_id returned by a prior codeinspectus_scan call.",
    "pattern": "^scan-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   }
  },
  "required": [
   "scan_id"
  ],
  "type": "object"
 },
 "name": "codeinspectus_compliance_report",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "disclaimer": {
    "type": "string"
   },
   "frameworks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code_visible_controls": {
       "type": "integer"
      },
      "controls": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "findings": {
          "type": "integer"
         },
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "status": {
          "enum": [
           "gap",
           "clear"
          ],
          "type": "string"
         }
        },
        "required": [
         "id",
         "name",
         "findings",
         "status"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "controls_with_findings": {
       "type": "integer"
      },
      "disclaimer": {
       "type": "string"
      },
      "framework": {
       "type": "string"
      },
      "scope": {
       "type": "string"
      }
     },
     "required": [
      "framework",
      "scope",
      "code_visible_controls",
      "controls_with_findings",
      "controls",
      "disclaimer"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "posture_note": {
    "type": "string"
   },
   "posture_score": {
    "type": "number"
   },
   "scan_id": {
    "type": "string"
   }
  },
  "required": [
   "scan_id",
   "posture_score",
   "posture_note",
   "frameworks",
   "disclaimer"
  ],
  "type": "object"
 },
 "title": "Code-level compliance coverage report"
}
