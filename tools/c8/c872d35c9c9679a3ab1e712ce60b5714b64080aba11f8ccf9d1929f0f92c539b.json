{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Download one HKEx document by its URL and extract its text and tables.\n\n    ``link`` must be an HKEx document URL (host ``www1.hkexnews.hk``); any other host is\n    rejected. With ``extract=True`` the response includes extracted ``document_text``\n    (truncated) and up to 30 ``tables``; set ``extract=False`` for size/content-type only.\n    ",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "extract": {
    "description": "Extract text and tables",
    "type": "boolean"
   },
   "link": {
    "description": "HKEx document URL",
    "type": "string"
   }
  },
  "required": [
   "link"
  ],
  "type": "object"
 },
 "name": "get_filing",
 "outputSchema": {
  "properties": {
   "result": {
    "description": "The downloaded document, with text and tables when extract is true.",
    "properties": {
     "content_type": {
      "type": "string"
     },
     "document_text": {
      "description": "Extracted Markdown text",
      "type": "string"
     },
     "link": {
      "type": "string"
     },
     "size_bytes": {
      "type": "integer"
     },
     "tables": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "tables_omitted": {
      "type": "integer"
     },
     "text_length": {
      "type": "integer"
     },
     "text_truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "link",
     "size_bytes"
    ],
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
