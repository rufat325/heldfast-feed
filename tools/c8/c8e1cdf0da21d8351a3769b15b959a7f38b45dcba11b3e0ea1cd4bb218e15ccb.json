{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "What the user holds on Ripio right now: Wallet (fiat and crypto), memecoins and Ripio Trade balances in one list, with available and locked amounts and an estimated value in ARS and USD at Ripio app sell rates. Zero balances are hidden unless include_zero is true.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_zero": {
    "description": "Include assets with a zero balance. Default false.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "ripio_get_portfolio",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "as_of": {
    "type": "string"
   },
   "holdings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "asset": {
       "type": "string"
      },
      "available": {
       "type": "string"
      },
      "locked": {
       "type": "string"
      },
      "total": {
       "type": "string"
      },
      "value_ars": {
       "type": "string"
      },
      "value_usd": {
       "type": "string"
      },
      "venue": {
       "enum": [
        "wallet",
        "memecoin",
        "trade"
       ],
       "type": "string"
      }
     },
     "required": [
      "asset",
      "venue",
      "available",
      "locked",
      "total"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totals": {
    "additionalProperties": false,
    "properties": {
     "unvalued_assets": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "value_ars": {
      "type": "string"
     },
     "value_usd": {
      "type": "string"
     }
    },
    "required": [
     "value_ars",
     "unvalued_assets"
    ],
    "type": "object"
   },
   "valuation": {
    "additionalProperties": false,
    "properties": {
     "method": {
      "const": "wallet_sell_rate",
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "usd_reference": {
      "type": "string"
     }
    },
    "required": [
     "method",
     "note"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "as_of",
   "valuation",
   "holdings",
   "totals",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Ripio portfolio"
}
