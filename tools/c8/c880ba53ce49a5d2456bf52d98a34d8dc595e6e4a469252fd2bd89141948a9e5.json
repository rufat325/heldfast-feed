        "type": "boolean"
       },
       "priceNote": {
        "description": "Why the price is missing or what it means (co-ownership share, auction, room only\u2026), in Slovak. Tell the user.",
        "type": [
         "string",
         "null"
        ]
       },
       "pricePerM2Eur": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "description": "Asking price per m\u00b2 of floor area (or of the plot for pozemok); null when area or price is unknown or not real."
       },
       "priceSavingPerM2Eur": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
