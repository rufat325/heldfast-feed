  "openai/toolInvocation/invoked": "Detail nehnute\u013enosti",
  "openai/toolInvocation/invoking": "Otv\u00e1ram inzer\u00e1t\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get property details"
 },
 "description": "Use this when the user asks for more about one specific property returned by search_properties (floor, number of floors, condition, construction, ownership, energy certificate, year built, balcony, lift, parking, cellar, price history). Requires the property id from search_properties; do not guess ids. Returns facts LivinIsto read from the listing and its price verdict; it does not return the agent's or seller's name, phone, e-mail, the ad's own text or an exact address \u2014 for contact the user opens the property's url. If the property is no longer in the offer, found is false.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "propertyId": {
    "description": "The id of a property from search_properties results.",
    "maxLength": 40,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "propertyId"
  ],
  "type": "object"
 },
 "name": "get_property_details",
