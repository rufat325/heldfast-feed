         {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "description": "Floor (0 = ground floor); null when not stated."
       },
       "id": {
        "description": "Stable LivinIsto property id; pass it to get_property_details.",
        "type": "string"
       },
       "landAreaM2": {
        "description": "Plot area in m\u00b2; null when not stated.",
        "type": [
         "number",
         "null"
        ]
       },
       "lift": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "ownership": {
        "type": [
         "string",
         "null"
        ]
       },
