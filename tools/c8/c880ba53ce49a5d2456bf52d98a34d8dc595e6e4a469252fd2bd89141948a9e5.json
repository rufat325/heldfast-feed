        ],
        "description": "LivinIsto price verdict per m\u00b2 against comparable properties (same type, place, rooms or size). null = not enough comparable listings, too dispersed, or the price is not a plain price."
       },
       "propertyType": {
        "description": "byt = flat, dom = house, chata = cottage / holiday home, pozemok = building plot, apartman = apartment.",
        "enum": [
         "byt",
         "dom",
         "chata",
         "pozemok",
         "apartman"
        ],
        "type": "string"
       },
       "reserved": {
        "description": "The source marks it as reserved.",
        "type": "boolean"
       },
       "roomOnly": {
        "description": "True when the rent is for a room in a shared flat, not the whole flat.",
        "type": "boolean"
       },
       "rooms": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "description": "Number of rooms; null when not stated (or when only a room is rented)."
       },
       "source": {
        "description": "Where the listing comes from (portal name, or LivinIsto for a listing published on LivinIsto directly).",
        "type": "string"
       },
       "title": {
        "description": "What it is and where, assembled by LivinIsto (e.g. \"2-izbov\u00fd byt, \u017dilina \u00b7 Vl\u010dince\") \u2014 never the seller's own headline.",
        "type": "string"
       },
       "totalFloors": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "transaction": {
        "enum": [
         "sale",
         "rent"
        ],
        "type": "string"
       },
       "url": {
        "description": "Link to the property on www.livinisto.sk \u2014 show it to the user unchanged.",
        "type": "string"
       }
      },
      "required": [
       "id",
       "title",
       "propertyType",
       "transaction",
       "priceEur",
       "priceIsMonthly",
       "pricePerM2Eur",
       "priceNote",
       "rooms",
       "areaM2",
       "landAreaM2",
       "floor",
       "city",
       "cityPart",
       "district",
       "roomOnly",
       "reserved",
       "priceVerdict",
       "priceSavingPerM2Eur",
       "comparableListings",
       "source",
       "url",
       "photoUrl",
       "totalFloors",
       "condition",
       "construction",
       "ownership",
       "energyCertificate",
       "buildYear",
       "balcony",
       "lift",
       "parking",
       "cellar",
       "photoCount",
       "priceHistory"
