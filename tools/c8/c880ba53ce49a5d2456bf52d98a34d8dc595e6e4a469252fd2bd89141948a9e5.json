        "type": [
         "boolean",
         "null"
        ]
       },
       "city": {
        "type": [
         "string",
         "null"
        ]
       },
       "cityPart": {
        "description": "Borough of Bratislava or Ko\u0161ice, when known.",
        "type": [
         "string",
         "null"
        ]
       },
       "comparableListings": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
