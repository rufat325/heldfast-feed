{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search address"
 },
 "description": "Two steps to build an address. kind=municipality with provinceCode and q returns municipalities and their codes. kind=street with provinceCode, municipalityDgcCode, municipalityIneCode (from the first step) and q returns streets with streetTypeCode and streetCode (and localityId in the Basque Country). Pass the chosen street, the house number and the codes to resolve_building. Only for places check_coverage reports as covered. Do not store or publish the address.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "kind": {
    "description": "municipality (step 1) or street (step 2).",
    "enum": [
     "municipality",
     "street"
    ],
    "type": "string"
   },
   "language": {
    "default": "es",
    "description": "Language of the texts in the answer (and of the report): es, en, de, nl or fr. Default es.",
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   },
   "municipalityDgcCode": {
    "description": "Only with kind=street: municipalityDgcCode from step 1.",
    "pattern": "^\\d{1,3}$",
    "type": "string"
   },
   "municipalityIneCode": {
    "description": "Only with kind=street: municipalityIneCode from step 1.",
    "pattern": "^\\d{3}$",
    "type": "string"
   },
   "provinceCode": {
    "description": "Two-digit INE province code (e.g. 28 Madrid, 08 Barcelona).",
    "pattern": "^\\d{2}$",
    "type": "string"
   },
   "q": {
    "description": "Text to search: municipality name, or street name optionally followed by the number (\"Col\u00f3n, 5\").",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "streetTypeCode": {
    "description": "Only with kind=street, optional: street type code to narrow the search (CL, AV, PZ\u2026).",
    "pattern": "^[A-Z0-9]{1,4}$",
    "type": "string"
   }
  },
  "required": [
   "kind",
   "provinceCode",
   "q"
  ],
  "type": "object"
 },
 "name": "search_address",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "contract": {
    "const": "agent-api-1.1.0",
    "type": "string"
   },
   "kind": {
    "enum": [
     "municipality",
     "street"
    ],
    "type": "string"
   },
   "language": {
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   },
   "numberHint": {
    "maxLength": 16,
    "minLength": 1,
    "type": "string"
   },
   "options": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": false,
       "properties": {
        "municipalityDgcCode": {
         "pattern": "^\\d{1,3}$",
         "type": "string"
        },
        "municipalityIneCode": {
         "pattern": "^\\d{3}$",
         "type": "string"
        },
        "officialLabel": {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        "provinceCode": {
         "pattern": "^\\d{2}$",
         "type": "string"
        }
       },
       "required": [
        "provinceCode",
        "municipalityDgcCode",
        "municipalityIneCode",
        "officialLabel"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     {
      "items": {
       "additionalProperties": false,
       "properties": {
        "localityId": {
         "pattern": "^[0-9]{14}$",
         "type": "string"
        },
        "localityLabel": {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        "municipalityDgcCode": {
         "pattern": "^\\d{1,3}$",
         "type": "string"
        },
        "municipalityIneCode": {
         "pattern": "^\\d{3}$",
         "type": "string"
        },
        "officialLabel": {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        "provinceCode": {
         "pattern": "^\\d{2}$",
         "type": "string"
        },
        "streetCode": {
         "pattern": "^[A-Z0-9]{1,15}$",
         "type": "string"
        },
        "streetTypeCode": {
         "pattern": "^[A-Z0-9]{1,4}$",
         "type": "string"
        },
        "streetTypeLabel": {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "provinceCode",
        "municipalityDgcCode",
        "municipalityIneCode",
        "officialLabel",
        "streetTypeCode",
        "streetCode"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     }
    ]
   }
  },
  "required": [
   "contract",
   "language",
   "kind",
   "options"
  ],
  "type": "object"
 },
 "title": "Search a municipality or street in the official directory"
}
