{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Shoe size converter"
 },
 "description": "Convert a UK shoe size to approximate EU and US sizes. Set sex to 'men' (UK 5 to 13) or 'women' (UK 2 to 9). UK size must be in whole or half steps. Source: https://hopi.co.uk/shoe-size-converter/",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "properties": {
      "sex": {
       "const": "men"
      }
     }
    },
    "then": {
     "properties": {
      "ukSize": {
       "maximum": 13,
       "minimum": 5
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "sex": {
       "const": "women"
      }
     }
    },
    "then": {
     "properties": {
      "ukSize": {
       "maximum": 9,
       "minimum": 2
      }
     }
    }
   }
  ],
  "properties": {
   "sex": {
    "description": "Which sizing chart to use",
    "enum": [
     "men",
     "women"
    ],
    "type": "string"
   },
   "ukSize": {
    "description": "UK shoe size (whole or half, e.g. 8 or 8.5)",
    "maximum": 13,
    "minimum": 2,
    "multipleOf": 0.5,
    "type": "number"
   }
  },
  "required": [
   "ukSize",
   "sex"
  ],
  "type": "object"
 },
 "name": "hopi_shoe_size_converter",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "eu": {
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "sex": {
    "type": "string"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "uk": {
    "type": "number"
   },
   "us": {
    "type": "number"
   }
  },
  "required": [
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Shoe size converter"
}
