   },
   "path": {
    "description": "Destination file path, e.g. \"/server.properties\", \"/velocity.toml\".",
    "type": "string"
   },
   "server": {
    "description": "The server id (server_...) from list_servers.",
    "type": "string"
   }
  },
  "required": [
   "server",
   "path",
   "content"
  ],
  "type": "object"
 },
 "name": "write_file",
 "outputSchema": {
