{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Clone le syst\u00e8me h\u00f4te entier vers une VM KVM bootable \u26a0\ufe0f ATTENTION: Op\u00e9ration potentiellement destructive!",
 "inputSchema": {
  "properties": {
   "cpus": {
    "default": 4,
    "maximum": 32,
    "minimum": 1,
    "type": "number"
   },
   "disk_size": {
    "default": "60G",
    "pattern": "^\\d+[GM]$",
    "type": "string"
   },
   "dry_run": {
    "default": false,
    "type": "boolean"
   },
   "hostname": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "memory": {
    "default": 8192,
    "maximum": 65536,
    "minimum": 1024,
    "type": "number"
   },
   "name": {
    "default": "neutron-clone",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
    "type": "string"
   },
   "timeout_ms": {
    "maximum": 7200000,
    "minimum": 60000,
    "type": "number"
   },
   "username": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vm_clone_system"
}
