{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Publish a new article (or schedule it) on Misar.Blog",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body_markdown": {
    "description": "Full article body in Markdown",
    "minLength": 1,
    "type": "string"
   },
   "cover_image_url": {
    "description": "URL of the cover image",
    "format": "uri",
    "type": "string"
   },
   "schedule_at": {
    "description": "ISO 8601 timestamp to schedule. Omit to publish immediately.",
    "type": "string"
   },
   "tags": {
    "description": "Up to 10 tags",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "title": {
    "description": "Article title",
    "maxLength": 250,
    "minLength": 1,
    "type": "string"
   },
   "visibility": {
    "default": "public",
    "description": "Who can read this article",
    "enum": [
     "public",
     "subscribers",
     "paid",
     "private"
    ],
    "type": "string"
   }
  },
  "required": [
   "title",
   "body_markdown"
  ],
  "type": "object"
 },
 "name": "publish_article",
 "title": "Publish article"
}
