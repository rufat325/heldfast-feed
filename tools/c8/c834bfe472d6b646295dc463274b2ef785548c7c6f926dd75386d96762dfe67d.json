{
 "description": "Check (or wait up to 120 seconds for) the outcome of a browser-approved login started with opentrain_auth_login_start. AUTHENTICATED means the session is SAVED; whether opentrain tools actually use it depends on precedence (an OPENTRAIN_PERSONAL_API_TOKEN environment key still outranks it) \u2014 the instructions state the effective source, and opentrain_auth_status confirms it. PENDING/SLOW_DOWN/TIMEOUT mean call again; DENIED/EXPIRED are final. Failures return structuredContent.error {code, retryable, remediation}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "loginId": {
    "description": "The loginId returned by opentrain_auth_login_start.",
    "pattern": "^lgn_[A-Za-z0-9_-]{16,64}$",
    "type": "string"
   },
   "waitSeconds": {
    "description": "Poll for up to this many seconds before answering (default 0: one poll). Call again to keep waiting; the handle stays valid until expiresAt.",
    "maximum": 120,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "loginId"
  ],
  "type": "object"
 },
 "name": "opentrain_auth_login_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expiresAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "instructions": {
    "type": "string"
   },
   "intervalSeconds": {
    "type": [
     "number",
     "null"
    ]
   },
   "loginId": {
    "type": "string"
   },
   "session": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "accessExpiresAt": {
        "type": "string"
       },
       "clientId": {
        "type": "string"
       },
       "grantId": {
        "type": "string"
       },
       "issuer": {
        "type": "string"
       },
       "obtainedAt": {
        "type": "string"
       },
       "refreshExpiresAt": {
        "type": "string"
       },
       "resource": {
        "type": "string"
       },
       "scope": {
        "type": "string"
       },
       "sessionExpiresAt": {
        "type": "string"
       },
       "tokenId": {
        "type": "string"
       }
      },
      "required": [
       "grantId",
       "tokenId",
       "issuer",
       "clientId",
       "resource",
       "scope",
       "accessExpiresAt",
       "refreshExpiresAt",
       "sessionExpiresAt",
       "obtainedAt"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "PENDING",
     "SLOW_DOWN",
     "AUTHENTICATED",
     "DENIED",
     "EXPIRED",
     "TIMEOUT"
    ],
    "type": "string"
   },
   "userCode": {
    "type": [
     "string",
     "null"
    ]
   },
   "verificationUriComplete": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "status",
   "loginId",
   "userCode",
   "verificationUriComplete",
   "expiresAt",
   "intervalSeconds",
   "session",
   "instructions"
  ],
  "type": "object"
 }
}
