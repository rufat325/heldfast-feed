{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Structural events in a channel's history: renames, description and photo changes, verification flips, subscriber/view milestones, and post edits or deletions \u2014 for telling what happened on a given date.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"channel":{"description":"Channel slug (Telegram username, without the @) or numeric channel id","minLength":1,"type":"string"},"event_types":{"description":"Event types to keep; omit for all of them","items":{"enum":["CHANNEL_FOLLOWED","CHANNEL_TITLE_CHANGED","CHANNEL_ABOUT_CHANGED","CHANNEL_PHOTO_CHANGED","VERIFIED_STATUS_CHANGED","SUBSCRIBERS_MILESTONE","CHANNEL_FIRST_MESSAGE","POST_EDITED","POST_DELETED","VIEW_MILESTONE","COMMENT_MILESTONE"],"type":"string"},"type":"array"},"limit":{"default":20,"maximum":50,"minimum":1,"type":"integer"},"order":{"default":"desc","description":"Sort by event time: desc (newest first) or asc","enum":["asc","desc"],"type":"string"},"page":{"default":0,"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["channel"],"type":"object"},"name":"get_channel_timeline","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"channel":{"type":"string"},"events":{"items":{"additionalProperties":{},"properties":{"data":{"anyOf":[{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},{"type":"null"}],"description":"Event payload; its shape follows event_type"},"event_id":{"type":["string","null"]},"event_timestamp":{"description":"ISO 8601 timestamp","type":["string","null"]},"event_type":{"type":["string","null"]},"message_id":{"type":["number","null"]}},"type":"object"},"type":"array"},"page":{"type":["number","null"]},"total":{"type":["number","null"]}},"required":["channel","events"],"type":"object"},"title":"Channel timeline events"}
