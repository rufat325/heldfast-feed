{
 "description": "Replace an order's line items (full replace of the items array). Recomputes totals. Only call after the user confirms.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "items": {
    "items": {
     "properties": {
      "name": {
       "description": "Custom line name (ad-hoc item)",
       "type": "string"
      },
      "price": {
       "description": "Custom unit price in minor units (ad-hoc item)",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "recordId": {
       "description": "Product record id the line refers to",
       "type": "string"
      },
      "variantSelections": {
       "additionalProperties": {},
       "description": "Selected variant options, e.g. {size: 'M', color: 'red'}",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "quantity"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "orderId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "orderId",
   "items"
  ],
  "type": "object"
 },
 "name": "edit_order"
}
