{
 "description": "Search federal award spending data from USAspending.gov. Find awards by keyword, look up a company total federal contracts, or see agency spending breakdown.",
 "inputSchema": {
  "properties": {
   "agency": {
    "description": "Filter by agency name",
    "type": "string"
   },
   "keyword": {
    "description": "Search keyword (e.g. \"artificial intelligence\", \"cloud services\")",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Number of results (max 25)",
    "type": "number"
   },
   "min_amount": {
    "description": "Minimum award amount in USD",
    "type": "number"
   },
   "recipient": {
    "description": "Company name (e.g. \"Microsoft\", \"Lockheed Martin\")",
    "type": "string"
   },
   "type": {
    "default": "awards",
    "description": "awards (search awards), recipient (company history), or agency",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_spending"
}
