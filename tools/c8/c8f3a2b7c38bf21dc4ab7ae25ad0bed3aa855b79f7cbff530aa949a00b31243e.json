{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add a rendered tutorial video"
 },
 "description": "Use this when someone has an already uploaded tutorial video file and wants it listed under a tutorial. Returns the new video record with its language, device, dimensions and URLs. Host the file first and pass its public https URL; each call adds another record. Not for recording, rendering or uploading a video.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chaptersUrl": {
    "$ref": "#/properties/url",
    "description": "Public https URL of the chapters track"
   },
   "device": {
    "description": "Device the video was rendered for: computer, tablet or smartphone",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "duration": {
    "description": "Duration in seconds, up to 86400",
    "maximum": 86400,
    "minimum": 0,
    "type": "number"
   },
   "fileSize": {
    "description": "File size in bytes",
    "maximum": 1000000000000000,
    "minimum": 0,
    "type": "number"
   },
   "format": {
    "description": "Container or codec, e.g. mp4 or webm",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "height": {
    "description": "Height in pixels, 1 to 100000",
    "exclusiveMinimum": 0,
    "maximum": 100000,
    "type": "integer"
   },
   "locale": {
    "description": "Language code of this video, e.g. en or pt-BR",
    "maxLength": 32,
    "minLength": 2,
    "type": "string"
   },
   "projectId": {
    "description": "Project that owns the tutorial",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "subtitlesUrl": {
    "$ref": "#/properties/chaptersUrl",
    "description": "Public https URL of a WebVTT subtitle track"
   },
   "thumbnailUrl": {
    "$ref": "#/properties/chaptersUrl",
    "description": "Public https URL of the poster image"
   },
   "tutorialId": {
    "description": "Tutorial this video is a rendering of",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "Public https URL of the already-uploaded video file",
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   },
   "width": {
    "description": "Width in pixels, 1 to 100000",
    "exclusiveMinimum": 0,
    "maximum": 100000,
    "type": "integer"
   }
  },
  "required": [
   "projectId",
   "tutorialId",
   "url"
  ],
  "type": "object"
 },
 "name": "create_video",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "const": "created",
    "type": "string"
   },
   "video": {
    "additionalProperties": false,
    "properties": {
     "chaptersUrl": {
      "anyOf": [
       {
        "maxLength": 2048,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "creationTime": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "device": {
      "anyOf": [
       {
        "maxLength": 100,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "duration": {
      "anyOf": [
       {
        "maximum": 86400,
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "fileSize": {
      "anyOf": [
       {
        "maximum": 1000000000000000,
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "format": {
      "anyOf": [
       {
        "maxLength": 100,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "height": {
      "anyOf": [
       {
        "maximum": 100000,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "lastEditTime": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "locale": {
      "anyOf": [
       {
        "maxLength": 32,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "projectId": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "subtitlesUrl": {
      "anyOf": [
       {
        "maxLength": 2048,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "thumbnailUrl": {
      "anyOf": [
       {
        "maxLength": 2048,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "tutorialId": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "url": {
      "anyOf": [
       {
        "maxLength": 2048,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "width": {
      "anyOf": [
       {
        "maximum": 100000,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "projectId",
     "tutorialId",
     "url",
     "locale",
     "device",
     "format",
     "width",
     "height",
     "duration",
     "fileSize",
     "chaptersUrl",
     "subtitlesUrl",
     "thumbnailUrl",
     "creationTime",
     "lastEditTime"
    ],
    "type": "object"
   }
  },
  "required": [
   "status",
   "video"
  ],
  "type": "object"
 },
 "title": "Add a rendered tutorial video"
}
