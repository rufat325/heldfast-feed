{
 "description": "Resolve the private image URL (/api/instructions/assets/<id>) from metadata without uploading bytes or changing instructions. Upload with the same idempotencyKey to get the same URL. The URL shows the image only after a page write in this job places it; then only people with access to that page can load it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contentType": {
    "enum": [
     "image/jpeg",
     "image/png",
     "image/webp",
     "image/gif",
     "image/avif"
    ],
    "type": "string"
   },
   "fileName": {
    "maxLength": 240,
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "sha256": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "sizeBytes": {
    "maximum": 5242880,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "jobId",
   "fileName",
   "contentType",
   "sizeBytes",
   "sha256",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_job_instructions_plan_image",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
