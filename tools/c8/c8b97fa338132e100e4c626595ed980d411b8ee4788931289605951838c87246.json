    "additionalProperties": {},
    "description": "Model update data",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "id": {
    "description": "Resource ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "type": {
    "description": "Model type (e.g. htr, la, ocr)",
    "pattern": "^[^/\\s]+$",
    "type": "string"
   }
  },
  "required": [
   "type",
   "id",
   "body"
  ],
  "type": "object"
 },
