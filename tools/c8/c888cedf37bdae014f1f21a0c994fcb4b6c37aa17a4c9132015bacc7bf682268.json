  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "agentId": {
    "description": "Agent ID",
    "type": "string"
   },
   "edges": {
    "description": "Array of edges connecting nodes",
    "items": {},
    "type": "array"
   },
   "locationId": {
    "description": "Location ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
