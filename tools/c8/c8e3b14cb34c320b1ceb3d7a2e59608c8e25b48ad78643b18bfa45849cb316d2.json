{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "taptax:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List my invoices"
 },
 "description": "Read the signed-in person's own invoices from their TapTax account, newest first, with each one's live status (a sent invoice past its due date reads as overdue) and the totals outstanding and overdue. Needs no details from the person.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "default": "all",
    "description": "unpaid = sent, viewed or overdue",
    "enum": [
     "all",
     "unpaid",
     "overdue",
     "paid",
     "draft"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_invoices",
 "title": "List my invoices"
}
