{
 "_meta": {
  "openai/annotationJustification": "Replaces the full menu document for bulk nav rewrites.",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Replace all menus"
 },
 "description": "Replace the whole menu doc (ifMatch from get_menu_doc required). Each item may omit menu \u2014 the enclosing menu key in doc is used.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "One sentence: why you are calling this tool and what you are trying to accomplish. Stored on the site's activity log and visible to everyone on the site \u2014 never put secrets or personal data here.",
    "minLength": 1,
    "type": "string"
   },
   "doc": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "items": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "attrs": {
          "additionalProperties": {
           "type": "string"
          },
          "type": "object"
         },
         "childShell": {
          "type": [
           "string",
           "null"
          ]
         },
         "childTemplate": {
          "type": "string"
         },
         "data": {
          "additionalProperties": {
           "type": "string"
          },
          "type": "object"
         },
         "html": {
          "type": "string"
         },
         "id": {
          "minLength": 1,
          "type": "string"
         },
         "kind": {
          "enum": [
           "page",
           "url",
           "anchor",
           "mailto",
           "group"
          ],
          "type": "string"
         },
         "label": {
          "minLength": 1,
          "type": "string"
         },
         "menu": {
          "minLength": 1,
          "type": "string"
         },
         "newTab": {
          "default": false,
          "type": "boolean"
         },
         "parent": {
          "type": [
           "string",
           "null"
          ]
         },
         "ref": {
          "type": "string"
         },
         "sort": {
          "type": "integer"
         }
        },
        "required": [
         "sort",
         "parent",
         "label",
         "kind",
         "ref",
         "id"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "shell": {
       "type": [
        "string",
        "null"
       ]
      },
      "template": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "items"
     ],
     "type": "object"
    },
    "type": "object"
   },
   "guestToken": {
    "description": "Guest token from start_site. Send it on every call until claim_site. Omit when this chat is already signed in to Dotsy.",
    "minLength": 20,
    "type": "string"
   },
   "ifMatch": {
    "description": "Whole-doc etag from get_menu_doc. Required (sent as If-Match).",
    "type": "string"
   },
   "site": {
    "description": "Site slug, e.g. acme-studio",
    "type": "string"
   }
  },
  "required": [
   "site",
   "doc",
   "ifMatch",
   "context"
  ],
  "type": "object"
 },
 "name": "put_menu_doc"
}
