{
 "description": "Presses a hardware/navigation button on the device",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "button": {
    "enum": [
     "home",
     "back",
     "volumeUp",
     "volumeDown",
     "enter",
     "dpadUp",
     "dpadDown",
     "dpadLeft",
     "dpadRight",
     "dpadCenter"
    ],
    "type": "string"
   },
   "device_id": {
    "pattern": "^[\\w\\-.:]{1,256}$",
    "type": "string"
   }
  },
  "required": [
   "device_id",
   "button"
  ],
  "type": "object"
 },
 "name": "press_button"
}
