{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get tasks"
 },
 "description": "Get the tasks in a list, with optional filters and pagination. ClickUp REST: GET /list/{list_id}/task.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "archived": {
    "description": "Include archived items \u2014 serialized as archived=true/false. Default false.",
    "type": "boolean"
   },
   "assignees": {
    "description": "Filter by assignee user ids (repeated assignees[] params).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "due_date_gt": {
    "description": "Only tasks due after this Unix time in ms.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "due_date_lt": {
    "description": "Only tasks due before this Unix time in ms.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "include_closed": {
    "description": "Include closed tasks (serialized true/false).",
    "type": "boolean"
   },
   "list_id": {
    "description": "The list id.",
    "type": "string"
   },
   "order_by": {
    "description": "Sort field, e.g. 'created', 'updated', 'due_date', 'id'.",
    "type": "string"
   },
   "page": {
    "description": "0-indexed page number for pagination.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "reverse": {
    "description": "Reverse the sort order (serialized true/false).",
    "type": "boolean"
   },
   "statuses": {
    "description": "Filter by status names (repeated statuses[] params), e.g. [\"open\",\"in progress\"].",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "subtasks": {
    "description": "Include subtasks (serialized true/false).",
    "type": "boolean"
   }
  },
  "required": [
   "list_id"
  ],
  "type": "object"
 },
 "name": "clickup_get_tasks",
 "title": "Get tasks"
}
