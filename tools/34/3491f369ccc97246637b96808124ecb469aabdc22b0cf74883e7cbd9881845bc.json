{
 "description": "Create an immediate Pix charge (cobranca imediata)",
 "inputSchema": {
  "properties": {
   "calendario": {
    "description": "Expiration settings",
    "properties": {
     "expiracao": {
      "description": "Expiration in seconds (default 3600)",
      "type": "number"
     }
    },
    "type": "object"
   },
   "chave": {
    "description": "Pix key of the receiver",
    "type": "string"
   },
   "devedor": {
    "description": "Debtor info",
    "properties": {
     "cpf": {
      "description": "Debtor CPF",
      "type": "string"
     },
     "nome": {
      "description": "Debtor name",
      "type": "string"
     }
    },
    "type": "object"
   },
   "solicitacaoPagador": {
    "description": "Message to payer",
    "type": "string"
   },
   "txid": {
    "description": "Transaction ID (26-35 chars, alphanumeric)",
    "type": "string"
   },
   "valor": {
    "description": "Charge value",
    "properties": {
     "original": {
      "description": "Amount as string (e.g. '10.00')",
      "type": "string"
     }
    },
    "required": [
     "original"
    ],
    "type": "object"
   }
  },
  "required": [
   "valor",
   "chave"
  ],
  "type": "object"
 },
 "name": "create_cob"
}
