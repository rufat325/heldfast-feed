{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hotelumo:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List extras and add-ons"
 },
 "description": "Use this when someone asks what extras a hotel sells, such as breakfast, parking, spa, transfers or fees, and what they cost. Returns each active extra's name, price in minor currency units, currency, category and taxable flag, 20 per page by default. Not for what a guest bought or was charged.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hotelId": {
    "description": "Only this hotel (24 lowercase hexadecimal characters); every hotel when absent",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "limit": {
    "description": "Extras per page, from 1 to 100; defaults to 20",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "offset": {
    "description": "Extras to skip, from 0 to 10000; defaults to 0. For the next page pass offset + limit",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_extras",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "extras": {
    "description": "Active extras; price is in integer minor currency units. Guest charges, folio data, display colors and credentials are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "anyOf": [
        {
         "$ref": "#/properties/extras/items/properties/name/anyOf/0"
        },
        {
         "type": "null"
        }
       ],
       "description": "BREAKFAST, PARKING, SPA, TRANSFER, FEE or OTHER"
      },
      "currency": {
       "$ref": "#/properties/extras/items/properties/name"
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "price": {
       "anyOf": [
        {
         "maximum": 1000000000000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "taxable": {
       "type": "boolean"
      }
     },
     "required": [
      "name",
      "price",
      "currency",
      "taxable",
      "category"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "page": {
    "additionalProperties": false,
    "description": "hasMore is true when another page exists; request it with offset + limit",
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "type": "integer"
     },
     "offset": {
      "maximum": 10000,
      "minimum": 0,
      "type": "integer"
     },
     "returned": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "limit",
     "offset",
     "returned",
     "hasMore"
    ],
    "type": "object"
   }
  },
  "required": [
   "extras",
   "page"
  ],
  "type": "object"
 },
 "title": "List extras and add-ons"
}
