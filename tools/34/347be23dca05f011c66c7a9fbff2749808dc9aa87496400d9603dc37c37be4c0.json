{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read one Internet Archive item by its identifier, as returned by search_items or search_inside. Sections are opt-in: 'basic' is the default and covers what a description needs. 'files' lists the downloadable files, which on a scanned film or book run to dozens of derivatives, so filter by format when a particular one is wanted. 'full_metadata' returns every field the Archive publishes for the item, which is large and rarely needed. 'file_count' and 'total_bytes' are always reported, whether or not the file list was asked for.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "file_format": {
    "description": "Keep only files of this format, such as 'PDF' or 'MP3'. Matched case-insensitively.",
    "maxLength": 60,
    "type": "string"
   },
   "identifier": {
    "description": "Archive identifier, such as 'nasa'. It is the last part of an item's address rather than the address itself, and it is matched exactly, capitals included.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "max_description_chars": {
    "default": 2000,
    "maximum": 20000,
    "minimum": 100,
    "type": "integer"
   },
   "max_files": {
    "default": 25,
    "description": "Ceiling on files returned.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "sections": {
    "default": [
     "basic"
    ],
    "description": "Which parts to return. Each one beyond 'basic' adds to the size of the answer.",
    "items": {
     "enum": [
      "basic",
      "files",
      "full_metadata"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "identifier"
  ],
  "type": "object"
 },
 "name": "get_item",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collections": {
    "description": "Collections the item sits in.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "date": {
    "type": [
     "string",
     "null"
    ]
   },
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "file_count": {
    "description": "Files the item holds, whatever this answer returned.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "download_url": {
       "type": "string"
      },
      "format": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "size_bytes": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "format",
      "size_bytes",
      "download_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "full_metadata": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "item": {
    "additionalProperties": false,
    "properties": {
     "creator": {
      "type": [
       "string",
       "null"
      ]
     },
     "downloads": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "identifier": {
      "description": "Pass this to get_item to read the full record.",
      "type": "string"
     },
     "media_type": {
      "description": "The kind the catalogue files this row under, in the Archive's own words. Most rows carry one of texts, movies, audio, image, software or data, and some carry a kind the filter cannot ask for, such as 'collection' for a page gathering items rather than an item itself.",
      "type": [
       "string",
       "null"
      ]
     },
     "source_url": {
      "description": "Public page. Show this when citing the item.",
      "type": "string"
     },
     "title": {
      "type": [
       "string",
       "null"
      ]
     },
     "year": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "identifier",
     "title",
     "creator",
     "year",
     "media_type",
     "downloads",
     "source_url"
    ],
    "type": "object"
   },
   "language": {
    "type": [
     "string",
     "null"
    ]
   },
   "license_url": {
    "description": "Terms the uploader attached, when they attached any.",
    "type": [
     "string",
     "null"
    ]
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "publisher": {
    "type": [
     "string",
     "null"
    ]
   },
   "total_bytes": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "item",
   "description",
   "date",
   "publisher",
   "language",
   "collections",
   "license_url",
   "file_count",
   "total_bytes",
   "notes"
  ],
  "type": "object"
 },
 "title": "Read an item"
}
