{
 "description": "Li\u1ec7t k\u00ea checkout theo tr\u1ea1ng th\u00e1i, m\u00e3 \u0111\u01a1n, kho\u1ea3ng ng\u00e0y v\u00e0 ph\u00e2n trang. / List and filter hosted checkouts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "from_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "order_code": {
    "maxLength": 50,
    "type": "string"
   },
   "page": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "pending",
     "paid",
     "expired",
     "cancelled"
    ],
    "type": "string"
   },
   "to_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "monapay_list_checkouts",
 "title": "Danh s\u00e1ch phi\u00ean thanh to\u00e1n"
}
