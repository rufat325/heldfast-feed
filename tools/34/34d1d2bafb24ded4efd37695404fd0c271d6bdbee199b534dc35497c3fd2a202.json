          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "description": "Numbered paragraph within the article, e.g. \"2\"."
       },
       "point": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
