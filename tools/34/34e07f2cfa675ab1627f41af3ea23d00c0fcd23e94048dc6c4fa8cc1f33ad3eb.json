{
 "description": "AI-fill the sections of a theme using the user's K-Layer (brand voice, target audience, value prop, ICP). Returns structured content, not HTML.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "k_layer": {
    "additionalProperties": {},
    "description": "The user's K-Layer profile \u2014 at minimum K1 (brand) and K2 (voice). Uses whatever fields are present.",
    "properties": {
     "brand_name": {
      "type": "string"
     },
     "icp_description": {
      "description": "Ideal customer profile",
      "type": "string"
     },
     "keywords": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "tagline": {
      "type": "string"
     },
     "value_prop": {
      "type": "string"
     },
     "voice": {
      "description": "e.g. \"professional\", \"bold\", \"vibe\", \"technical\"",
      "type": "string"
     }
    },
    "type": "object"
   },
   "model": {
    "description": "Override Groq model. Default: llama-3.3-70b-versatile",
    "type": "string"
   },
   "sections_override": {
    "description": "Override the theme's section list (e.g. [\"hero\", \"pricing_table\", \"footer\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "theme_id": {
    "description": "Theme registry ID (e.g. \"shadcn-violet\")",
    "type": "string"
   }
  },
  "required": [
   "theme_id",
   "k_layer"
  ],
  "type": "object"
 },
 "name": "landing_pages_generate",
 "title": "Generate landing page content"
}
