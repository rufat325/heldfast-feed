  "additionalProperties": false,
  "properties": {
   "fuel_type": {
    "default": "diesel",
    "description": "Fuel type. e.g. gasoline, diesel, lpg, cng, e85.",
    "enum": [
     "gasoline_regular",
     "gasoline",
     "gasoline_premium",
     "gasoline_super",
     "diesel_regular",
     "diesel",
     "diesel_premium",
     "lpg",
     "cng",
     "e85",
     "kerosene",
     "premium"
    ],
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "How many cheapest countries to return.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "region": {
    "default": "world",
    "description": "Region to search. Default: world (all countries).",
    "enum": [
     "europe",
     "asia",
     "africa",
     "north_america",
     "south_america",
     "oceania",
     "world"
