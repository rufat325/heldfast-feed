      "enum": [
       "createdAt",
       "lastActive",
       "name"
      ],
      "type": "string"
     },
     "currency": {
      "type": "string"
     },
     "dateFormat": {
      "type": "string"
     },
     "defaultBillable": {
      "type": "boolean"
     },
     "defaultView": {
      "type": "string"
     },
     "projectSort": {
      "enum": [
       "createdAt",
       "lastActive",
       "name"
      ],
      "type": "string"
     },
     "showCompletedTasks": {
      "type": "boolean"
     },
     "systemNotificationTime": {
