{
 "_meta": {
  "toolset": "interaction"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Highlight"
 },
 "description": "Highlight one feature or every feature in a GeoJSON layer. Returns { success: boolean, message?: string, error?: string }.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "clear": {
    "description": "Clear existing highlights and restore original styles",
    "type": "boolean"
   },
   "color": {
    "default": "#FFFF00",
    "description": "Highlight color (CSS format)",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "featureIndex": {
    "description": "Feature index (highlights all if omitted)",
    "minimum": 0,
    "type": "integer"
   },
   "layerId": {
    "description": "Layer ID",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "description": "Target browser session ID for multi-browser routing (optional)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "highlight",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "error": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 }
}
