{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "List FreeAgent invoices with their status and outstanding balance. Use view='overdue' to chase late payers, 'open_or_overdue' for everything unpaid, or 'draft' for invoices not yet issued.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contact": {
    "description": "Only invoices for this contact",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/contacts\\/\\d+$",
    "type": "string"
   },
   "fromDate": {
    "description": "Earliest invoice date YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Maximum invoices to return (default 50, max 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "project": {
    "description": "Only invoices for this project",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/projects\\/\\d+$",
    "type": "string"
   },
   "toDate": {
    "description": "Latest invoice date YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "view": {
    "default": "all",
    "description": "Which invoices to return (default: all)",
    "enum": [
     "all",
     "recent_open_or_overdue",
     "open",
     "overdue",
     "open_or_overdue",
     "draft",
     "paid"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "freeagent_list_invoices"
}
