{
 "description": "List published CanonicAI domain canons from the static canon bundle. Returns slug, action statement, construct/source counts, and canonical URLs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum summaries to return.",
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "description": "Number of summaries to skip.",
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_canons",
 "outputSchema": {
  "properties": {
   "canons": {
    "items": {
     "properties": {
      "action_statement": {
       "type": "string"
      },
      "date_modified": {
       "type": "string"
      },
      "jsonUrl": {
       "format": "uri",
       "type": "string"
      },
      "n_constructs": {
       "type": "integer"
      },
      "n_source_works": {
       "type": "integer"
      },
      "slug": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "slug",
      "action_statement",
      "n_constructs",
      "n_source_works",
      "url",
      "jsonUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "type": "integer"
   }
  },
  "required": [
   "count",
   "canons"
  ],
  "type": "object"
 }
}
