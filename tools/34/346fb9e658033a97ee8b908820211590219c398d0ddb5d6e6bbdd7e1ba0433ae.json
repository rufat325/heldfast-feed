{
 "annotations": {
  "readOnlyHint": true,
  "title": "List interviews"
 },
 "description": "List scheduled interview events (candidate_id, offer_id, stage_id, start time, duration, location, attendees). Defaults to upcoming events for the whole company; narrow by candidate, date range or interviewer. Recruitee: GET /c/{company_id}/interview/events.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "admin_ids": {
    "description": "Only events assigned to these admin ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "candidate_id": {
    "description": "Only this candidate's interviews.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "end_date": {
    "description": "Range end, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "description": "Events per page (default unlimited).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number; only used together with limit.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "scope": {
    "description": "Only mine, or all (default all).",
    "enum": [
     "my",
     "all"
    ],
    "type": "string"
   },
   "start_date": {
    "description": "Range start, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "status": {
    "description": "Which events (default upcoming).",
    "enum": [
     "upcoming",
     "past_due",
     "all"
    ],
    "type": "string"
   },
   "timezone": {
    "description": "Timezone for the date range, e.g. Europe/Amsterdam.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "recruitee_list_interview_events",
 "title": "List interviews"
}
