{
 "description": "Run LocalHistogramEqualization (contrast-limited local histogram equalization) on a view. Omitted parameters keep PixInsight's defaults.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Blend of the equalized result with the original, 0 to 1.",
    "type": "number"
   },
   "circular_kernel": {
    "description": "Circular kernel (true) or square kernel (false).",
    "type": "boolean"
   },
   "histogram_resolution": {
    "description": "Histogram resolution: 8, 10 or 12 bits.",
    "enum": [
     "Bit8",
     "Bit10",
     "Bit12"
    ],
    "type": "string"
   },
   "radius": {
    "description": "Kernel radius in pixels.",
    "type": "number"
   },
   "slope_limit": {
    "description": "Contrast slope limit.",
    "type": "number"
   },
   "view_id": {
    "description": "PixInsight view identifier.",
    "type": "string"
   }
  },
  "required": [
   "view_id"
  ],
  "type": "object"
 },
 "name": "run_lhe"
}
