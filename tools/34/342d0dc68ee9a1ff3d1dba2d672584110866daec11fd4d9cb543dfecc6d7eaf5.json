{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a small stage-specific capability selection and concrete next actions from a caller-approved project projection. Keep source and full snapshots local. Caller-reported outcomes are not verified execution. Does not acquire, execute, store project context or send reminders.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checks": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "artifactDigest": {
       "$ref": "#/properties/impact/properties/sourceRevision"
      },
      "artifactPath": {
       "maxLength": 240,
       "minLength": 1,
       "type": "string"
      },
      "id": {
       "pattern": "^[A-Za-z0-9_-]{1,80}$",
       "type": "string"
      },
      "result": {
       "enum": [
        "passed",
        "failed",
        "unknown"
       ],
       "type": "string"
      },
      "sourceRevision": {
       "$ref": "#/properties/impact/properties/sourceRevision"
      },
      "taskId": {
       "pattern": "^[A-Za-z0-9_-]{1,80}$",
       "type": "string"
      },
      "title": {
       "$ref": "#/properties/impact/properties/coverageGaps/items"
      }
     },
     "required": [
      "id",
      "taskId",
      "title",
      "result",
      "sourceRevision",
      "artifactPath",
      "artifactDigest"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "contextSourceRevision": {
    "$ref": "#/properties/impact/properties/sourceRevision"
   },
   "currentSourceRevision": {
    "$ref": "#/properties/impact/properties/sourceRevision"
   },
   "features": {
    "default": [],
    "items": {
     "enum": [
      "auth",
      "webhooks",
      "browser",
      "dependencies"
     ],
     "type": "string"
    },
    "maxItems": 4,
    "type": "array"
   },
   "goal": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "hasContext": {
    "default": false,
    "type": "boolean"
   },
   "impact": {
    "additionalProperties": false,
    "properties": {
     "coverageGaps": {
      "items": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "features": {
      "items": {
       "enum": [
        "auth",
        "webhooks",
        "browser",
        "dependencies"
       ],
       "type": "string"
      },
      "maxItems": 4,
      "type": "array"
     },
     "sourceRevision": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     }
    },
    "required": [
     "sourceRevision",
     "features",
     "coverageGaps"
    ],
    "type": "object"
   },
   "needs": {
    "default": [],
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 4,
    "type": "array"
   },
   "pending": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "implement_and_verify",
        "verify_at_current_revision",
        "repair_and_retest",
        "resolve_issue",
        "review_scope_change"
       ],
       "type": "string"
      },
      "taskId": {
       "pattern": "^[A-Za-z0-9_-]{1,80}$",
       "type": "string"
      },
      "title": {
       "$ref": "#/properties/impact/properties/coverageGaps/items"
      }
     },
     "required": [
      "taskId",
      "title",
      "action"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "scopeNeedsDecision": {
    "default": false,
    "type": "boolean"
   },
   "stack": {
    "default": [],
    "items": {
     "maxLength": 60,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "stage": {
    "enum": [
     "start",
     "build",
     "verify",
     "resume"
    ],
    "type": "string"
   }
  },
  "required": [
   "stage",
   "goal"
  ],
  "type": "object"
 },
 "name": "plan_project_development"
}
