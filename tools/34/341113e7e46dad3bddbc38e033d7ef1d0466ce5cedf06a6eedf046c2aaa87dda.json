{
 "description": "Show diff between package versions or between local and registry",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "diffNameOnly": {
    "description": "Only show file names that changed",
    "type": "boolean"
   },
   "package": {
    "description": "Package spec for comparison (e.g. pkg@1.0.0..pkg@2.0.0)",
    "type": "string"
   },
   "path": {
    "description": "Absolute path to local package (compares local vs registry)",
    "type": "string"
   },
   "specs": {
    "description": "Two package specs to compare (e.g. ['pkg@1.0.0', 'pkg@2.0.0'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "diff"
}
