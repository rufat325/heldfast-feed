    },
    "type": "object"
   },
   "method": {
    "description": "Method to probe with. Defaults to GET.",
    "enum": [
     "GET",
     "POST"
    ],
    "example": "POST",
    "type": "string"
   },
   "url": {
    "description": "HTTPS URL of an x402 endpoint on a reviewed origin. Credentials, ports and fragments are refused.",
