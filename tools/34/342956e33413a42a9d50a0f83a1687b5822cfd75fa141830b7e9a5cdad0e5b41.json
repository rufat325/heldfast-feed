{
 "description": "Mint a short-lived stateless revision-exact browser preview link (no writes; read-scoped). Draft grants CAS the expectedDraftVersion; published grants bind one immutable version; published-latest resolves it. The secret rides the returned URL fragment \u2014 open it directly in a browser.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "definitionId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "request": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "expectedDraftVersion": {
        "minimum": 0,
        "type": "integer"
       },
       "source": {
        "const": "draft",
        "type": "string"
       }
      },
      "required": [
       "source",
       "expectedDraftVersion"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "source": {
        "const": "published",
        "type": "string"
       },
       "versionNumber": {
        "minimum": 1,
        "type": "integer"
       }
      },
      "required": [
       "source",
       "versionNumber"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "source": {
        "const": "published-latest",
        "type": "string"
       }
      },
      "required": [
       "source"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "definitionId",
   "request"
  ],
  "type": "object"
 },
 "name": "opentrain_job_checklists_preview",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
