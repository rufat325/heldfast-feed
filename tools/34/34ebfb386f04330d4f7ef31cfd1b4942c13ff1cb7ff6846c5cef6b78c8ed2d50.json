{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "cherami_mail:full"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update conversation labels"
 },
 "description": "Add or remove labels on every message currently in a conversation, received and sent. Later messages in the conversation do not get these labels.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "add_labels": {
    "items": {
     "description": "Case-sensitive label, trimmed; at most 128 UTF-8 bytes, without control characters.",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "remove_labels": {
    "items": {
     "description": "Case-sensitive label, trimmed; at most 128 UTF-8 bytes, without control characters.",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "thread_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "thread_id"
  ],
  "type": "object"
 },
 "name": "update_thread_labels",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "add_labels": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "The conversation's current ID.",
    "type": "string"
   },
   "inbox_id": {
    "type": "string"
   },
   "message_count": {
    "description": "Number of messages updated, including ones that already had these labels.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "received_count": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "remove_labels": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sent_count": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "id",
   "inbox_id",
   "message_count",
   "received_count",
   "sent_count",
   "add_labels",
   "remove_labels"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "cherami_mail:full"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Update conversation labels"
}
