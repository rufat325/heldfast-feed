{"annotations":{"destructiveHint":false},"description":"\u0421\u0432\u043e\u0434\u043a\u0430 \u0440\u0430\u0431\u043e\u0447\u0435\u0439 \u0441\u0435\u0441\u0441\u0438\u0438 \u2014 \u0432 \u0436\u0443\u0440\u043d\u0430\u043b \u043f\u0440\u043e\u0435\u043a\u0442\u0430. \u0417\u043e\u0432\u0438 \u0412 \u041a\u041e\u041d\u0426\u0415 \u0441\u0435\u0441\u0441\u0438\u0438 \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0434 \u0434\u043e\u043b\u0433\u043e\u0439 \u043f\u0430\u0443\u0437\u043e\u0439, \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u2014 \u043d\u0435 \u0434\u0440\u043e\u0431\u0438. \u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430: \u0421\u0434\u0435\u043b\u0430\u043d\u043e \u2192 \u0420\u0435\u0448\u0435\u043d\u0438\u044f \u0438 \u043f\u043e\u0447\u0435\u043c\u0443 (\u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043e\u0442\u0432\u0435\u0440\u0433\u043d\u0443\u0442\u044b\u0435) \u2192 \u0413\u0440\u0430\u0431\u043b\u0438 \u2192 \u041e\u0441\u0442\u0430\u043b\u043e\u0441\u044c. \u0414\u043e 6000 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432, \u043d\u0430 \u044f\u0437\u044b\u043a\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f.","inputSchema":{"properties":{"project_id":{"type":"integer"},"text":{"type":"string"}},"required":["project_id","text"],"type":"object"},"name":"save_session_summary","outputSchema":{"properties":{"result":{"type":"string"}},"required":["result"],"type":"object"}}
