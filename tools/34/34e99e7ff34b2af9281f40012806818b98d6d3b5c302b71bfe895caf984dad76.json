{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing permission on a file or shared drive. Can change role or expiration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expirationTime": {
    "description": "Expiration time in RFC 3339 format. Setting to null removes expiration.",
    "type": "string"
   },
   "fileId": {
    "description": "The ID of the file or shared drive",
    "type": "string"
   },
   "permissionId": {
    "description": "The ID of the permission to update",
    "type": "string"
   },
   "removeExpiration": {
    "default": false,
    "description": "Remove the expiration time",
    "type": "boolean"
   },
   "role": {
    "description": "The new role for the permission",
    "enum": [
     "owner",
     "organizer",
     "fileOrganizer",
     "writer",
     "commenter",
     "reader"
    ],
    "type": "string"
   },
   "supportsAllDrives": {
    "default": true,
    "description": "Support shared drives",
    "type": "boolean"
   },
   "transferOwnership": {
    "default": false,
    "description": "Whether to transfer ownership (role must be owner)",
    "type": "boolean"
   },
   "useDomainAdminAccess": {
    "default": false,
    "description": "Issue the request as a domain administrator",
    "type": "boolean"
   }
  },
  "required": [
   "fileId",
   "permissionId",
   "role"
  ],
  "type": "object"
 },
 "name": "permission_update",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "deleted": {
    "type": "boolean"
   },
   "displayName": {
    "type": "string"
   },
   "domain": {
    "type": "string"
   },
   "emailAddress": {
    "type": "string"
   },
   "expirationTime": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "pendingOwner": {
    "type": "boolean"
   },
   "photoLink": {
    "type": "string"
   },
   "role": {
    "enum": [
     "owner",
     "organizer",
     "fileOrganizer",
     "writer",
     "commenter",
     "reader"
    ],
    "type": "string"
   },
   "type": {
    "enum": [
     "user",
     "group",
     "domain",
     "anyone"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "type",
   "role"
  ],
  "type": "object"
 },
 "title": "Update permission"
}
