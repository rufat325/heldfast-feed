      "title": "Send Bridge"
     },
     "type": "global"
    },
    {
     "type": "thread"
    },
    {
     "extensions": [
      ".eml",
      ".ics",
      ".md",
      ".txt",
      ".json",
      ".csv"
     ],
     "type": "file"
    }
   ]
