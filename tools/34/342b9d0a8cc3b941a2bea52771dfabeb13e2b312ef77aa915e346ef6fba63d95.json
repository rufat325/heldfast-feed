  "ui": {
   "resourceUri": "ui://send-bridge/card"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Prepares an interactive file transfer card and secure download link for any text or document export. Use when the user or an agent wants to stage a file for transfer, download, or sharing (such as email drafts, calendar events, markdown notes, code snippets, or CSVs). In ChatGPT and MCP Apps hosts, opens the interactive transfer card (ui://send-bridge/card) with file metadata, MIME type badge, SHA-256 integrity hash, remaining TTL countdown, and download button. In plain MCP clients, returns standard JSON containing download_url, file_name, sha256, expires_at, and size_bytes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "Text or document content of the file to transfer.",
    "maxLength": 200000,
    "type": "string"
   },
   "file": {
    "description": "File metadata injected when opened through a file extension entrypoint in ChatGPT.",
    "properties": {
     "name": {
      "minLength": 1,
      "type": "string"
     },
     "resourceUri": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "name",
     "resourceUri"
    ],
    "type": "object"
   },
   "file_name": {
    "description": "Name of the file to transfer (e.g. report.md, invite.ics, draft.eml).",
    "maxLength": 120,
    "type": "string"
   },
   "mime_type": {
    "description": "Optional MIME type (e.g. text/markdown, text/calendar, message/rfc822). Inferred from file_name if omitted.",
    "maxLength": 100,
    "type": "string"
   },
   "transfer_id": {
    "description": "Optional existing transfer ID to inspect.",
    "maxLength": 64,
    "type": "string"
   },
   "ttl_hours": {
    "description": "Hours until the download link expires (1-168 hours; default is 24).",
    "maximum": 168,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "prepare_transfer",
 "outputSchema": {
  "properties": {
   "download_url": {
    "description": "Direct download URL for the file.",
    "type": "string"
   },
   "expires_at": {
    "description": "ISO 8601 expiration timestamp.",
    "type": "string"
   },
   "file": {
    "type": "object"
   },
   "file_name": {
    "description": "Sanitized name of the file.",
    "type": "string"
   },
   "interactive_ui": {
    "description": "Resource URI of the interactive transfer card.",
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "mime_type": {
    "description": "MIME content type.",
    "type": "string"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sha256": {
    "description": "Hex-encoded SHA-256 integrity checksum.",
    "type": "string"
   },
   "size_bytes": {
    "description": "Total size in bytes.",
    "type": "integer"
   },
   "status": {
    "enum": [
     "ok",
     "ready"
    ],
    "type": "string"
   },
   "transfer_id": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "interactive_ui"
  ],
  "type": "object"
 },
 "title": "Prepare file transfer"
}
