{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "$0.01 per call. Pay with x402 (USDC on Base) in _meta[\"x402/payment\"]; MPP (tempo) on the HTTP URL /v1/sanctions/screen. Screen a name against the US OFAC SDN and Consolidated lists: potential matches with list, programs, name score and reasons; optional type, date of birth and country re-rank. Fuzzy, folds accents, any script. Not a determination: an empty candidates list is a paid 200 and certifies nothing. Not UN, EU or UK.",
 "inputSchema": {
  "additionalProperties": false,
  "description": "A name to screen; type, dob and country only add reasons and re-rank.",
  "properties": {
   "country": {
    "anyOf": [
     {
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "ISO 3166-1 alpha-2: a nationality or address country.",
    "examples": [
     "RU"
    ],
    "title": "Country"
   },
   "dob": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "YYYY or YYYY-MM-DD, for persons.",
    "examples": [
     "1952-10-07"
    ],
    "title": "Dob"
   },
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "min_score": {
    "default": 85,
    "description": "Name score floor, 70-100.",
    "maximum": 100,
    "minimum": 70,
    "title": "Min Score",
    "type": "integer"
   },
   "name": {
    "description": "Any script.",
    "examples": [
     "Banco Nacional de Cuba"
    ],
    "maxLength": 200,
    "minLength": 2,
    "title": "Name",
    "type": "string"
   },
   "type": {
    "anyOf": [
     {
      "enum": [
       "person",
       "entity",
       "vessel",
       "aircraft"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "What the party is. A mismatch ranks a candidate lower.",
    "title": "Type"
   }
  },
  "required": [
   "name"
  ],
  "title": "SanctionsScreenRequest",
  "type": "object"
 },
