{
 "description": "Upload a file from a URL to PutPut and get a CDN link back",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filename": {
    "description": "Optional filename override",
    "type": "string"
   },
   "prefix": {
    "description": "Optional path prefix for organization",
    "type": "string"
   },
   "url": {
    "description": "URL of the file to upload",
    "type": "string"
   },
   "visibility": {
    "description": "File visibility (default: public)",
    "enum": [
     "public",
     "private"
    ],
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "upload_file"
}
