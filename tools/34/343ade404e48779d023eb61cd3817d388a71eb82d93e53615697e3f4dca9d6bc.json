{
 "description": "Get current quotes (last price, daily change) for securities by security ID. Get the IDs from search_symbols first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "preferredCurrency": {
    "default": "EUR",
    "description": "Preferred quote currency",
    "type": "string"
   },
   "quoteProvider": {
    "description": "Quote provider from search_symbols",
    "type": "string"
   },
   "securityIds": {
    "description": "Security ID(s) from search_symbols",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "securityIds",
   "quoteProvider"
  ],
  "type": "object"
 },
 "name": "get_quotes"
}
