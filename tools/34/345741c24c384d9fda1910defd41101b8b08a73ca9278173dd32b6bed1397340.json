{
 "annotations": {
  "readOnlyHint": true,
  "title": "List jobs"
 },
 "description": "List operational jobs (cleanings, greetings, maintenance and other services) scheduled in a date window, optionally for given properties and statuses, sorted by start date. Hostfully: GET /api/v3.3/jobs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from": {
    "description": "Window start (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "modified_since": {
    "description": "Only jobs modified on or after this date; Hostfully requires it, default 2000-01-01 (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "property_uids": {
    "description": "Only jobs at these properties.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "statuses": {
    "description": "Only jobs in these statuses.",
    "items": {
     "enum": [
      "NEW",
      "SCHEDULED",
      "DONE",
      "CANCELLED"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "to": {
    "description": "Window end (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "hostfully_list_jobs",
 "title": "List jobs"
}
