{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get channel message history"
 },
 "description": "Retrieve historical messages published to a channel, newest-first by default. REST: GET /channels/{channel}/messages.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "channel": {
    "description": "Channel name, e.g. 'chat:room1'.",
    "type": "string"
   },
   "direction": {
    "description": "forwards (oldest-first) or backwards (newest-first, default).",
    "enum": [
     "forwards",
     "backwards"
    ],
    "type": "string"
   },
   "end": {
    "description": "Latest message time, ms since epoch (inclusive).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "limit": {
    "description": "Max messages (<=1000). Default 100.",
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "integer"
   },
   "start": {
    "description": "Earliest message time, ms since epoch (inclusive).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "channel"
  ],
  "type": "object"
 },
 "name": "ably_get_channel_history",
 "title": "Get channel message history"
}
