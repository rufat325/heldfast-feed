  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Connect an EEG device and START a live streaming session on the user's head.\nRequires confirm=True; call device.test first. Track with stream.status().\nIdle watchdog: if no stream.status()/stream.telemetry() poll happens for\nidle_timeout_sec (default 900), the session is stopped and the device\ndisconnected automatically \u2014 an abandoned stream never keeps running on\nthe user's head. Any poll resets the timer; idle_timeout_sec=0 disables\nthe watchdog.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "chunk_size": {
    "default": 125,
    "description": "Samples per streamed chunk (default 125).",
    "type": "integer"
   },
   "confirm": {
    "default": false,
    "description": "MUST be true to start \u2014 the explicit user go-ahead for a live\nsession on their head; anything else is refused with zero requests.",
    "type": "boolean"
   },
   "connection_type": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Device-specific selector (e.g. serial vs wifi)."
   },
   "device_type": {
    "description": "Device id from device.list (e.g. \"brainbit\").",
    "type": "string"
   },
   "idle_timeout_sec": {
    "default": 900,
    "description": "Watchdog: stop+disconnect after this many seconds\nwithout a status poll (default 900; 0 disables).",
    "type": "integer"
   },
   "ip_address": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Device IP for network/wifi devices."
   },
   "ip_port": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Port for network devices."
   },
   "mac_address": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Bluetooth MAC (BT devices)."
   },
   "n_channels": {
    "default": 8,
    "description": "Channel count to open (default 8).",
    "type": "integer"
   },
   "port": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Serial/COM port for wired devices."
   },
   "serial_number": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Device serial (some BLE stacks)."
   },
   "session_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional existing session to resume/reuse."
   },
   "source_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "LSL source id."
   },
   "stream_name": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "LSL stream name (LSL devices)."
   }
  },
  "required": [
   "device_type"
  ],
  "type": "object"
 },
 "name": "stream.start",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "Stream.Start"
}
