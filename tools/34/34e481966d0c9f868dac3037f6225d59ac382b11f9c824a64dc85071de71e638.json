{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get import status"
 },
 "description": "Returns a single import's current status and summary (total / succeeded / failed / warnings). Status lifecycle: SCHEDULED \u2192 IN_PROGRESS \u2192 FINISHED | FINISHED_WITH_WARNINGS | FAILED | CANCELED. FINISHED can transition to REVERTING \u2192 REVERTED.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "companyId": {
    "description": "Company id from list_companies.",
    "type": "string"
   },
   "importId": {
    "description": "Import id from list_imports.",
    "type": "string"
   }
  },
  "required": [
   "companyId",
   "importId"
  ],
  "type": "object"
 },
 "name": "get_import_status",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "createdAt": {
    "description": "ISO timestamp.",
    "type": "string"
   },
   "entityName": {
    "description": "Entity type being imported.",
    "type": "string"
   },
   "fileName": {
    "description": "Uploaded file name.",
    "type": "string"
   },
   "finishedAt": {
    "description": "ISO timestamp when reached terminal status, if applicable.",
    "type": "string"
   },
   "id": {
    "description": "Import id.",
    "type": "string"
   },
   "status": {
    "description": "Lifecycle status (SCHEDULED, IN_PROGRESS, FINISHED, FINISHED_WITH_WARNINGS, FAILED, CANCELED, REVERTING, REVERTED).",
    "type": "string"
   },
   "summary": {
    "additionalProperties": true,
    "description": "Counts per result type.",
    "properties": {
     "failed": {
      "type": "integer"
     },
     "succeeded": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     },
     "warnings": {
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "id",
   "status"
  ],
  "type": "object"
 }
}
