{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Free. How many ACTIVE Brazilian establishments match a prospecting filter (CNAE code or prefix, state/UF, city, opening date range, headquarters only), from the Receita Federal monthly registry. Use it to budget pages before paying for br_company_list. Rate limited (50/day).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "city": {
    "description": "Municipality name (accents and case ignored).",
    "maxLength": 80,
    "type": "string"
   },
   "cnae": {
    "description": "CNAE code or prefix: '6201-5/00', '6201500', '6201' (class) or '62' (division).",
    "maxLength": 12,
    "type": "string"
   },
   "hq_only": {
    "description": "Only headquarters (one row per company).",
    "type": "boolean"
   },
   "opened_after": {
    "description": "Opened on or after (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "opened_before": {
    "description": "Opened on or before (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "state": {
    "description": "UF, e.g. 'SP'.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "br_company_count",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cached": {
    "type": "boolean"
   },
   "data_freshness": {
    "type": "string"
   },
   "filters": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "generated_at": {
    "type": "string"
   },
   "pages_of_100": {
    "type": "number"
   },
   "reference_month": {
    "type": "string"
   },
   "sources": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "fetched_at": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "url",
      "fetched_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "additionalProperties": false,
    "description": "Short summary in English and Portuguese.",
    "properties": {
     "en": {
      "type": "string"
     },
     "pt": {
      "type": "string"
     }
    },
    "required": [
     "en",
     "pt"
    ],
    "type": "object"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "filters",
   "total",
   "pages_of_100",
   "reference_month",
   "summary",
   "sources",
   "data_freshness",
   "generated_at",
   "cached"
  ],
  "type": "object"
 }
}
