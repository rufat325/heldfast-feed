    "type": "integer"
   },
   "odometer_max": {
    "minimum": 0,
    "type": "integer"
   },
   "oem_program_slug": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "offset": {
    "description": "Zero-based row offset. Results are totally ordered and stable for an unchanged catalog, but pagination is NOT snapshot-isolated: ingestion between two page requests shifts offsets, so a traversal may duplicate or omit rows. To copy the catalog consistently: record catalog_watermark AND total from the first page, compare both on every subsequent page, and restart the traversal if either changes. Narrowing by rooftop_slug shortens each traversal and so reduces the chance of a restart. Offsets beyond 10000 are rejected; narrow the query instead.",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "passenger_capacity_min": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "price_max": {
    "description": "Maximum expiry-gated effective price: an unexpired special price when present, otherwise asking price.",
    "maximum": 99999999.99,
    "minimum": 0,
    "type": "number"
   },
   "price_min": {
    "description": "Minimum expiry-gated effective price: an unexpired special price when present, otherwise asking price.",
    "maximum": 99999999.99,
    "minimum": 0,
    "type": "number"
   },
   "radius_miles": {
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "number"
   },
   "rooftop_slug": {
    "description": "Restrict results to one rooftop, as listed by network_directory. A slug that matches no rooftop returns no results rather than an error.",
    "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
    "type": "string"
   },
   "rooftop_slugs": {
    "description": "Restrict results to these network rooftops.",
    "items": {
     "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   },
   "sort": {
    "description": "Optional ordering; defaults to price_asc. The sort key uses NULLS LAST and is deterministically terminated by rooftop and unit ids. distance requires latitude and longitude (radius_miles defaults to 50).",
    "enum": [
     "price_asc",
     "price_desc",
     "year_desc",
     "mileage_asc",
     "distance"
    ]
   },
   "transmission": {
    "oneOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     }
    ]
   },
   "trim": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "view": {
    "default": "summary",
    "enum": [
     "summary",
     "manifest",
     "full"
    ]
   }
  },
  "type": "object"
 },
