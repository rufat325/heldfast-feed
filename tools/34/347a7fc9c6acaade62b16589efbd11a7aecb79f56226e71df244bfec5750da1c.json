 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search network inventory"
 },
 "description": "Browse available inventory across the network, one page at a time. For counts or distributions call inventory_stats; to copy the catalog call network_snapshot (one download replaces hundreds of pages). Results are slim summary rows; embed hero_photo_url as a markdown image when presenting a vehicle, and call inventory_get with rooftop_slug for its full photo gallery. Optional OEM program scope; optional geographic radius \u2014 latitude and longitude together; radius_miles defaults to 50 (max 500) and needs both. Rooftops without coordinates are excluded from geo-scoped results. Pass country=CA for Canadian dealers. Listed prices may exclude doc/government fees and tax \u2014 call quote_preview for the estimated total. Totals are estimates at best; when pricing_coverage is \"partial_estimate\", present the total as a subtotal excluding the charges in excluded. Always relay pricing_disclosure.",
 "inputSchema": {
  "additionalProperties": false,
  "description": "Categorical arrays are ORed within their field; separate filter fields are ANDed together. The default ordering is price_asc. Server-enforced: latitude requires longitude; longitude requires latitude; radius_miles requires latitude and longitude. sort = distance requires latitude and longitude. Additional argument rules are enforced server-side.",
  "properties": {
   "body_style": {
    "oneOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     }
    ]
   },
   "condition": {
    "enum": [
     "new",
     "used"
    ]
   },
   "country": {
    "default": "US",
    "description": "Market to search; rooftops in the other country are excluded. Prices are in that country's currency; the radius stays in miles.",
    "enum": [
     "US",
     "CA"
    ],
    "type": "string"
   },
   "drivetrain": {
    "oneOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     }
    ]
   },
   "exterior_color": {
    "oneOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     }
    ]
   },
   "format": {
    "default": "json",
    "enum": [
     "json",
     "csv"
    ]
   },
   "fuel_type": {
    "oneOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     }
    ]
   },
   "interior_color": {
    "oneOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 80,
