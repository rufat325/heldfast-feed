{
 "description": "Create or get a share URL for an execution.\n\nRequires write access when connected with OAuth.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "executionId": {
    "type": "string"
   },
   "expiresAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "expiresInDays": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "outputSteps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "executionId"
  ],
  "type": "object"
 },
 "name": "share_execution"
}
