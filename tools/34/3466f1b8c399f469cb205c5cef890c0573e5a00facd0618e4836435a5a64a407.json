{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Retrieve a full compliance profile for a single EPA-regulated facility by EPA Registry ID. Returns facility metadata, per-program compliance status, inspection history, formal enforcement actions, penalty totals, and TRI release summary. Use epa_search_facilities to discover Registry IDs. For area-level enforcement discovery use epa_search_violations instead.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "registry_id": {
    "description": "EPA FRS Registry ID for the facility (obtained from epa_search_facilities)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "registry_id"
  ],
  "type": "object"
 },
 "name": "epa_get_facility",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "registryId",
     "name",
     "programs",
     "inspections",
     "formalActions"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "airCompliance": {
    "additionalProperties": false,
    "description": "CAA-specific compliance details. Present only when facility is registered under CAA (programs.air=true).",
    "properties": {
     "programId": {
      "description": "CAA program identifier",
      "type": "string"
     },
     "status": {
      "description": "Air compliance status",
      "type": "string"
     },
     "statusDate": {
      "description": "Date of status determination",
      "type": "string"
     }
    },
    "type": "object"
   },
   "city": {
    "description": "City",
    "type": "string"
   },
   "compliance": {
    "additionalProperties": false,
    "description": "Compliance summary from DFR. Absent when ECHO DFR compliance endpoint unavailable.",
    "properties": {
     "mediaStatusCode": {
      "description": "Compliance media status code",
      "type": "string"
     },
     "mediaStatusDescription": {
      "description": "Human-readable compliance status description",
      "type": "string"
     },
     "quartersInViolation": {
      "description": "Number of quarters with compliance violations in the past 3 years",
      "type": "number"
     }
    },
    "type": "object"
   },
   "complianceStatus": {
    "description": "Overall compliance status text",
    "type": "string"
   },
   "county": {
    "description": "County name",
    "type": "string"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `facility_not_found`: ECHO returned no facility record for the given Registry ID. Other values are possible when a failure originates below the handler.",
        "examples": [
         "facility_not_found"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "fipsCode": {
    "description": "5-digit county FIPS code",
    "type": "string"
   },
   "formalActions": {
    "description": "Formal enforcement actions on record",
    "items": {
     "additionalProperties": false,
     "description": "Single formal enforcement action with case ID and penalty amount",
     "properties": {
      "actionType": {
       "description": "Type of formal enforcement action",
       "type": "string"
      },
      "caseId": {
       "description": "Enforcement case identifier",
       "type": "string"
      },
      "penaltyAssessedInDollars": {
       "description": "Penalty amount assessed in dollars",
       "type": "number"
      },
      "settlementDate": {
       "description": "Settlement or resolution date",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "inspections": {
    "description": "Inspection history records",
    "items": {
     "additionalProperties": false,
     "description": "Single inspection record with activity type and date",
     "properties": {
      "activityDate": {
       "description": "Date of inspection",
       "type": "string"
      },
      "activityType": {
       "description": "Inspection activity type code",
       "type": "string"
      },
      "description": {
       "description": "Activity type description",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "latitude": {
    "description": "Latitude in decimal degrees",
    "type": "number"
   },
   "longitude": {
    "description": "Longitude in decimal degrees",
    "type": "number"
   },
   "name": {
    "description": "Facility name",
    "type": "string"
   },
   "programs": {
    "additionalProperties": false,
    "description": "Program registration flags",
    "properties": {
     "air": {
      "description": "Registered under Clean Air Act (CAA)",
      "type": "boolean"
     },
     "rcra": {
      "description": "Registered under RCRA (hazardous waste)",
      "type": "boolean"
     },
     "sdwa": {
      "description": "Regulated under Safe Drinking Water Act",
      "type": "boolean"
     },
     "tri": {
      "description": "Participates in Toxic Release Inventory (TRI)",
      "type": "boolean"
     },
     "water": {
      "description": "Registered under Clean Water Act (CWA)",
      "type": "boolean"
     }
    },
    "required": [
     "air",
     "water",
     "rcra",
     "tri",
     "sdwa"
    ],
    "type": "object"
   },
   "registryId": {
    "description": "EPA FRS Registry ID",
    "type": "string"
   },
   "state": {
    "description": "2-letter state abbreviation",
    "type": "string"
   },
   "street": {
    "description": "Street address",
    "type": "string"
   },
   "triReleasesTransfersInLbs": {
    "description": "Total TRI on/off-site releases and transfers in pounds",
    "type": "number"
   },
   "waterCompliance": {
    "additionalProperties": false,
    "description": "CWA/NPDES permit and compliance details. Present only when facility is registered under CWA (programs.water=true).",
    "properties": {
     "permitId": {
      "description": "NPDES permit ID",
      "type": "string"
     },
     "programId": {
      "description": "CWA program identifier",
      "type": "string"
     },
     "status": {
      "description": "Water compliance status",
      "type": "string"
     }
    },
    "type": "object"
   },
   "zip": {
    "description": "ZIP code",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Get EPA Facility Compliance Profile"
}
