{
 "description": "Full pricing breakdown for a product (tiers, monthly/yearly, affiliate rate).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "billing": {
    "enum": [
     "monthly",
     "yearly"
    ],
    "type": "string"
   },
   "product_slug": {
    "description": "Product slug from the catalog (e.g., 'injectshield')",
    "type": "string"
   },
   "tier": {
    "description": "Specific tier name to highlight",
    "type": "string"
   }
  },
  "required": [
   "product_slug"
  ],
  "type": "object"
 },
 "name": "get_pricing",
 "title": "Get pricing"
}
