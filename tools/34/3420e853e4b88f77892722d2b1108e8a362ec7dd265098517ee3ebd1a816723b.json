{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "isitdone: receipt for the current tree"
 },
 "description": "Read-only, runs nothing. Whether the current working tree already has a verification receipt: PASS (the checks passed on exactly this tree), FAIL, STALE (files or the check configuration changed since) or NONE.",
 "inputSchema": {
  "properties": {
   "cwd": {
    "description": "Absolute path of the repository, or of a directory inside it. Default: the client's first workspace root, else the directory the server was started in.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "isitdone_receipt",
 "outputSchema": {
  "properties": {
   "done": {
    "description": "True only for a PASS receipt of a full run on exactly this tree.",
    "type": "boolean"
   },
   "reason": {
    "type": "string"
   },
   "receipt": {
    "properties": {
     "branch": {
      "type": [
       "string",
       "null"
      ]
     },
     "checks": {
      "items": {
       "properties": {
        "cmd": {
         "type": "string"
        },
        "durationMs": {
         "type": "number"
        },
        "exitCode": {
         "type": [
          "integer",
          "null"
         ]
        },
        "id": {
         "type": "string"
        },
        "status": {
         "enum": [
          "PASS",
          "FAIL",
          "TIMEOUT",
          "ERROR"
         ],
         "type": "string"
        },
        "summary": {
         "type": [
          "string",
          "null"
         ]
        },
        "tail": {
         "description": "Last lines of the combined output; empty for checks that passed.",
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "id",
        "cmd",
        "status",
        "tail"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "claim": {
      "type": [
       "string",
       "null"
      ]
     },
     "createdAt": {
      "type": "string"
     },
     "head": {
      "type": [
       "string",
       "null"
      ]
     },
     "host": {
      "type": [
       "string",
       "null"
      ]
     },
     "profile": {
      "enum": [
       "lite",
       "full"
      ],
      "type": "string"
     },
     "status": {
      "enum": [
       "PASS",
       "FAIL"
      ],
      "type": "string"
     },
     "tree": {
      "type": "string"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "root": {
    "type": "string"
   },
   "state": {
    "enum": [
     "PASS",
     "FAIL",
     "STALE",
     "NONE"
    ],
    "type": "string"
   },
   "tree": {
    "description": "Hash of the current working tree.",
    "type": "string"
   }
  },
  "required": [
   "state",
   "done",
   "reason",
   "receipt"
  ],
  "type": "object"
 },
 "title": "isitdone: receipt for the current tree"
}
