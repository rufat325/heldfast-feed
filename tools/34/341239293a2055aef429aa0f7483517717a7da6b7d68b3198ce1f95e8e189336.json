{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Report actual source dates, coverage, record counts and SHA256 provenance.",
 "inputSchema": {
  "properties": {},
  "type": "object"
 },
 "name": "freshness",
 "outputSchema": {
  "$defs": {
   "AwardAvailability": {
    "properties": {
     "artifact_http_status": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "check_interval_seconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
     },
     "checked_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "inventory_http_status": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "latest_release_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "latest_release_url": {
      "type": [
       "string",
       "null"
      ]
     },
     "max_check_age_seconds": {
      "format": "int64",
      "type": "integer"
     },
     "state": {
      "type": "string"
     }
    },
    "required": [
     "state",
     "check_interval_seconds",
     "max_check_age_seconds"
    ],
    "type": "object"
   },
   "AwardFreshness": {
    "properties": {
     "age_state": {
      "type": "string"
     },
     "age_warning_after_days": {
      "format": "int64",
      "type": "integer"
     },
     "effective_source_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_age_days": {
      "format": "int64",
      "type": [
       "integer",
       "null"
      ]
     },
     "upstream": {
      "$ref": "#/$defs/AwardAvailability"
     },
     "warning": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "age_state",
     "age_warning_after_days",
     "upstream"
    ],
    "type": "object"
   },
   "FreshnessState": {
    "enum": [
     "fresh",
     "stale",
     "unknown",
     "unavailable"
    ],
    "type": "string"
   },
   "SourceCoverage": {
    "properties": {
     "award_freshness": {
      "anyOf": [
       {
        "$ref": "#/$defs/AwardFreshness"
       },
       {
        "type": "null"
       }
      ],
      "description": "Award age and latest official release evidence, independent of publication or scheduler state."
     },
     "dataset": {
      "type": "string"
     },
     "exclusion_freshness": {
      "anyOf": [
       {
        "$ref": "#/$defs/SourceFreshness"
       },
       {
        "type": "null"
       }
      ]
     },
     "input_rows": {
      "format": "int64",
      "type": "integer"
     },
     "public_rows": {
      "format": "int64",
      "type": "integer"
     },
     "reference_edition": {
      "type": [
       "string",
       "null"
      ]
     },
     "reference_scope": {
      "type": [
       "string",
       "null"
      ]
     },
     "sha256": {
      "type": "string"
     },
     "source_date": {
      "type": "string"
     },
     "source_date_kind": {
      "description": "Meaning of the supplied date; not an importer or scheduler timestamp.",
      "type": "string"
     },
     "source_url": {
      "type": "string"
     }
    },
    "required": [
     "dataset",
     "source_url",
     "source_date",
     "sha256",
     "input_rows",
     "public_rows",
     "source_date_kind"
    ],
    "type": "object"
   },
   "SourceFreshness": {
    "properties": {
     "attention_required": {
      "type": "boolean"
     },
     "evaluated_at": {
      "description": "UTC time when age was evaluated; source and observation dates are unchanged.",
      "type": "string"
     },
     "max_age_seconds": {
      "description": "Explicit warning threshold for this daily snapshot. Not a scheduler promise.",
      "format": "int64",
      "type": "integer"
     },
     "source_age_seconds": {
      "description": "Age of the official source timestamp, never the import or enrichment timestamp.",
      "format": "int64",
      "type": [
       "integer",
       "null"
      ]
     },
     "state": {
      "$ref": "#/$defs/FreshnessState"
     },
     "warn_age_seconds": {
      "description": "Early-warning boundary, separate from the stale-source boundary.",
      "format": "int64",
      "type": "integer"
     },
     "warning": {
      "description": "User-facing warning, or null when within the warning threshold.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "state",
     "evaluated_at",
     "max_age_seconds",
     "warn_age_seconds",
     "attention_required"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "generation": {
    "type": "string"
   },
   "history": {
    "type": "string"
   },
   "sources": {
    "items": {
     "$ref": "#/$defs/SourceCoverage"
    },
    "type": "array"
   }
  },
  "required": [
   "generation",
   "sources",
   "history"
  ],
  "type": "object"
 },
 "title": "Check source dates"
}
