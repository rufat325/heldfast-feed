{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Returns the current site's all-time, site-wide totals: subscribers (current active count), notifications sent, views, clicks, and goal conversions/value. Not bounded by any date range \u2014 for trends over a period use pushengage_get_analytics_timeseries instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "site_id": {
    "description": "Override the currently selected site.",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "pushengage_get_analytics_summary",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "total_clicks": {
    "type": "number"
   },
   "total_goal_count": {
    "type": "number"
   },
   "total_goal_value": {
    "type": "number"
   },
   "total_notifications_sent": {
    "type": "number"
   },
   "total_subscribers": {
    "type": "number"
   },
   "total_views": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Get all-time analytics totals"
}
