     "properties": {
      "city": {
       "description": "City",
       "type": "string"
      },
      "country": {
       "description": "Country",
       "type": "string"
      },
      "postalCode": {
       "description": "Postal/ZIP code",
       "type": "string"
      },
      "region": {
       "description": "State or province",
       "type": "string"
      },
      "street": {
       "description": "Street address",
       "type": "string"
      },
      "type": {
       "description": "Address type",
       "enum": [
        "HOME",
        "WORK",
        "OTHER"
       ],
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "birthday": {
    "description": "New birthday (YYYY-MM-DD or YYYYMMDD), or null to remove",
    "type": [
     "string",
     "null"
    ]
   },
   "categories": {
    "description": "Replace all groups/categories with these",
