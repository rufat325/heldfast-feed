     "properties": {
      "type": {
       "description": "Email type",
       "enum": [
        "HOME",
        "WORK",
        "OTHER"
       ],
       "type": "string"
      },
      "value": {
       "description": "Email address",
       "type": "string"
      }
     },
     "required": [
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "firstName": {
    "description": "New first name, or null to clear",
    "type": [
     "string",
     "null"
    ]
   },
   "fullName": {
    "description": "New full display name",
    "type": "string"
   },
   "lastName": {
    "description": "New last name, or null to clear",
    "type": [
     "string",
     "null"
    ]
   },
   "note": {
    "description": "New notes, or null to remove",
    "type": [
     "string",
     "null"
    ]
   },
   "org": {
    "description": "New organization, or null to remove",
    "type": [
     "string",
     "null"
    ]
   },
   "phones": {
