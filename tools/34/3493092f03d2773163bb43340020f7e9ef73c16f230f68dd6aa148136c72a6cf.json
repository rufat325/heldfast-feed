{
 "annotations": {
  "readOnlyHint": true,
  "title": "List treatment notes"
 },
 "description": "Query treatment note summaries by client, lock status, date range or last-updated date. Max 100 per page. IntakeQ: GET /notes/summary.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "client": {
    "description": "Client name or email (partial matches).",
    "type": "string"
   },
   "client_id": {
    "description": "Only this client's notes.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "deleted_only": {
    "description": "true = only notes deleted in the last 10 days.",
    "type": "boolean"
   },
   "end_date": {
    "description": "On or before (yyyy-MM-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "page": {
    "description": "Page number (1, 2, ...). Each page holds at most 100 records.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "start_date": {
    "description": "On or after (yyyy-MM-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "status": {
    "anyOf": [
     {
      "const": 1,
      "type": "number"
     },
     {
      "const": 2,
      "type": "number"
     }
    ],
    "description": "1 = locked notes, 2 = unlocked notes."
   },
   "updated_since": {
    "description": "Only notes updated after this date (yyyy-MM-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "intakeq_list_notes",
 "title": "List treatment notes"
}
