{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check that the PDF parses, has an optional expected page count, and contains required text. This does not perform PDF/A, signature, visual, or OCR validation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capability": {
    "description": "Document capability returned by POST /v1/documents.",
    "maxLength": 64,
    "minLength": 40,
    "type": "string"
   },
   "document_id": {
    "description": "UUID returned by POST /v1/documents.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "page_count": {
    "description": "Expected number of pages.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "required_text": {
    "description": "Literal text strings that must be present.",
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "document_id",
   "capability"
  ],
  "type": "object"
 },
 "name": "validate_pdf_text",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "PDF parsing, page-count, required-text, and native-text coverage checks.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "checks": {
    "items": {},
    "type": "array"
   },
   "documentId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "error": {},
   "extensions": {},
   "resource": {},
   "valid": {
    "type": "boolean"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Validate PDF text expectations"
}
