{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Screen stocks"
 },
 "description": "Run one of Talval's stock screens over the covered universe and return the ranked results with fair value, upside and scores.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 15,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "screen": {
    "description": "Which screen to run.",
    "enum": [
     "undervalued",
     "high_quality",
     "safe_dividend",
     "undervalued_dividend"
    ],
    "type": "string"
   },
   "sector": {
    "description": "Optional sector filter, e.g. 'Technology'.",
    "type": "string"
   }
  },
  "required": [
   "screen"
  ],
  "type": "object"
 },
 "name": "screen_stocks",
 "outputSchema": {
  "properties": {
   "label": {
    "type": [
     "string",
     "null"
    ]
   },
   "rows": {
    "description": "Ranked. Empty when nothing clears the screen.",
    "items": {
     "properties": {
      "currency": {
       "description": "Trading currency of the price and fair value.",
       "type": [
        "string",
        "null"
       ]
      },
      "fair_value": {
       "type": [
        "number",
        "null"
       ]
      },
      "name": {
       "type": [
        "string",
        "null"
       ]
      },
      "price": {
       "type": [
        "number",
        "null"
       ]
      },
      "quality_score": {
       "type": [
        "number",
        "null"
       ]
      },
      "ticker": {
       "type": "string"
      },
      "upside_pct": {
       "description": "Percent, not a fraction: 12.5 means +12.5%.",
       "type": [
        "number",
        "null"
       ]
      },
      "verdict": {
       "description": "Undervalued, Fairly valued or Overvalued.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "ticker"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "screen": {
    "type": "string"
   },
   "sector": {
    "description": "The sector filter applied, if any.",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "screen",
   "rows"
  ],
  "type": "object"
 },
 "title": "Screen stocks"
}
