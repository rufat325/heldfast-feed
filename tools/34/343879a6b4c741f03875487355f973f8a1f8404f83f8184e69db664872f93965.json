{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare TV options side-by-side"
 },
 "description": "Compares 2-5 program titles by scoring each against the chosen mood, finding the next TV airing (next 48h by default) and looking each up in the streaming catalog. Returns side-by-side breakdown and a winner with reasoning.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "mood": {
    "type": "string"
   },
   "options": {
    "description": "Array of 2-5 titles (string) or { title, channel? } objects to compare",
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "channel": {
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "title"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 5,
    "minItems": 2,
    "type": "array"
   },
   "prefer": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "upcoming_window_hours": {
    "default": 48,
    "maximum": 72,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "options"
  ],
  "type": "object"
 },
 "name": "tv_compare_options",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asked_at_utc": {
    "type": "string"
   },
   "freshness": {
    "additionalProperties": true,
    "properties": {
     "epg_age_min": {
      "type": [
       "number",
       "null"
      ]
     },
     "stale": {
      "type": "boolean"
     },
     "streaming_age_min": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "stale"
    ],
    "type": "object"
   },
   "mood": {
    "type": "string"
   },
   "mood_label_ro": {
    "type": "string"
   },
   "options": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "winner": {
    "anyOf": [
     {
      "additionalProperties": true,
      "properties": {
       "query": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       },
       "total_score": {
        "type": "number"
       }
      },
      "required": [
       "query",
       "total_score",
       "reason"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "asked_at_utc",
   "mood",
   "mood_label_ro",
   "options",
   "winner",
   "freshness"
  ],
  "type": "object"
 },
 "title": "Compare TV options side-by-side"
}
