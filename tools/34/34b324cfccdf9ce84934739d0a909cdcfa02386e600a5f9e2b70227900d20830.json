{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get blog details"
 },
 "description": "Use this when someone asks about one blog's setup, such as its domain, default language or languages. Returns the blog's id, name, custom domain, default locale, locales, cover image URL and dates, by id or name. Not for a visual overview with recent posts.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "idOrName": {
    "description": "Blog id, or the blog's name",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "idOrName"
  ],
  "type": "object"
 },
 "name": "get_blog",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blog": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "coverUrl": {
        "$ref": "#/properties/blog/anyOf/0/properties/logoUrl"
       },
       "created": {
        "anyOf": [
         {
          "maxLength": 100,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "customDomain": {
        "anyOf": [
         {
          "maxLength": 300,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 50,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "edited": {
        "$ref": "#/properties/blog/anyOf/0/properties/created"
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "locales": {
        "items": {
         "maxLength": 50,
         "type": "string"
        },
        "maxItems": 100,
        "type": "array"
       },
       "localesTruncated": {
        "type": "boolean"
       },
       "logoUrl": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "customDomain",
       "logoUrl",
       "defaultLocale",
       "locales",
       "localesTruncated",
       "coverUrl",
       "created",
       "edited"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "blog"
  ],
  "type": "object"
 },
 "title": "Get blog details"
}
