{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get forum post"
 },
 "description": "Get a forum post's details (title, archived/locked state, applied tags, message count) plus its recent messages, oldest-to-newest. Read-only. Pass the post's thread_id. Returns a JSON object.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "description": "How many recent messages to include (1\u2013100). Default 20.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "thread_id": {
    "description": "ID (snowflake) of the forum post (thread).",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   }
  },
  "required": [
   "thread_id"
  ],
  "type": "object"
 },
 "name": "discord_get_forum_post",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "appliedTags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "archived": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "createdAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "type": "string"
   },
   "locked": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "messageCount": {
    "type": [
     "number",
     "null"
    ]
   },
   "messages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": "string"
      },
      "content": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "timestamp": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "author",
      "content",
      "timestamp"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "archived",
   "locked",
   "messageCount",
   "appliedTags",
   "createdAt",
   "messages"
  ],
  "type": "object"
 }
}
