{
 "description": "All of a form's submissions (up to 2,000) as CSV text, optionally filtered by status.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "formId": {
    "description": "Form id, e.g. frm_abc123",
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "spam",
     "flagged"
    ],
    "type": "string"
   }
  },
  "required": [
   "formId"
  ],
  "type": "object"
 },
 "name": "export_submissions",
 "title": "Export submissions as CSV"
}
