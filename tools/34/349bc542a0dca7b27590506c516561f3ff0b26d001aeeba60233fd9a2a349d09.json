{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a collaboration inquiry straight to Norbert's inbox. Only use it when the user wants to contact him, with their real name and email so he can reply.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "company": {
    "maxLength": 200,
    "type": "string"
   },
   "email": {
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "message": {
    "maxLength": 5000,
    "minLength": 10,
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "email",
   "message"
  ],
  "type": "object"
 },
 "name": "send_inquiry",
 "title": "Contact Norbert"
}
