{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Accurately count characters (Unicode code points), UTF-16 units, words, lines and UTF-8 bytes in text. LLMs are notoriously bad at counting, so always use this tool for \"how many characters/words\" questions.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "input": {
    "description": "Text to measure.",
    "maxLength": 100000,
    "minLength": 0,
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "count",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bytes": {
    "description": "UTF-8 bytes.",
    "type": "number"
   },
   "characters": {
    "description": "Unicode code points.",
    "type": "number"
   },
   "lines": {
    "type": "number"
   },
   "utf16_units": {
    "type": "number"
   },
   "words": {
    "type": "number"
   }
  },
  "required": [
   "characters",
   "utf16_units",
   "words",
   "lines",
   "bytes"
  ],
  "type": "object"
 },
 "title": "Count characters, words, lines, bytes"
}
