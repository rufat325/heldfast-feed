{
 "description": "Revert specified files to their committed state. Caution: discards uncommitted changes to specified files. Confirm with user.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cwd": {
    "description": "Repository path",
    "type": "string"
   },
   "paths": {
    "description": "Files to revert",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rev": {
    "description": "Revision to revert to",
    "type": "string"
   }
  },
  "required": [
   "paths"
  ],
  "type": "object"
 },
 "name": "sl_revert"
}
