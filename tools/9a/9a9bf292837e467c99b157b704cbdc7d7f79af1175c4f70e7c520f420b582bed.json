{
 "description": "Rank ads by return across a campaign or account \u2014 which ad copy actually converts",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ad_group_id": {
    "description": "Restrict to one ad group",
    "type": "string"
   },
   "campaign_id": {
    "description": "Restrict to one campaign",
    "type": "string"
   },
   "customer_id": {
    "description": "Google Ads customer/account ID",
    "type": "string"
   },
   "days": {
    "default": 30,
    "description": "Lookback window in days (default 30)",
    "type": "number"
   },
   "limit": {
    "default": 20,
    "description": "How many to return (default 20)",
    "type": "number"
   },
   "sort_by": {
    "default": "revenue",
    "description": "Ranking metric",
    "enum": [
     "revenue",
     "roas",
     "conversions",
     "cost",
     "cpa"
    ],
    "type": "string"
   }
  },
  "required": [
   "customer_id"
  ],
  "type": "object"
 },
 "name": "google_ads_ad_performance"
}
