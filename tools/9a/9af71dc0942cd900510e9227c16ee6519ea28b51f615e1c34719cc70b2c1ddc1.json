{"description":"List issues of a project; filters: status, priority, milestone, component, label, assignee, parent, blocked, due","inputSchema":{"properties":{"assignee":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Person name; null = unassigned"},"blocked":{"description":"true: only issues waiting for an open blocker","type":"boolean"},"componentLabel":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Component name; null = none"},"due":{"description":"Due date: overdue, set or none","enum":["overdue","set","none"],"type":"string"},"labelName":{"description":"Filter by label name","type":"string"},"limit":{"default":50,"type":"integer"},"milestoneLabel":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Milestone name; null = none"},"offset":{"type":"integer"},"parentIdentifier":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Direct sub-issues of this issue; null = top-level only"},"priority":{"description":"Filter by priority","enum":["NoPriority","Urgent","High","Medium","Low"],"type":"string"},"projectIdentifier":{"description":"Project key","type":"string"},"status":{"description":"Status name, \"open\" (default) or \"all\"","type":"string"},"title":{"description":"Title contains this text","type":"string"},"workspace":{"type":"string"}},"required":["projectIdentifier"],"type":"object"},"name":"list_issues"}
