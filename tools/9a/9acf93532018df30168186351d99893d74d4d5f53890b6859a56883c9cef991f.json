{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Correct fields on an already-logged shot in place \u2014 no need to delete and re-log. Use for fixing a wrong dose/yield/time or grind label, re-filing a shot onto the right bean (bean_id), backfilling rating/tasting notes, or fixing the timestamp (pulled_at). Changing grind_label re-derives the numeric grind position from the shot's grinder; changing yield/time/dose/tds keeps flow rate and extraction yield consistent automatically.",
 "inputSchema": {
  "properties": {
   "fields": {
    "description": "Only the fields to change",
    "properties": {
     "bag_id": {
      "description": "Re-file the shot onto this bag; must be a bag of the shot's bean",
      "type": "integer"
     },
     "bean_id": {
      "description": "Re-file the shot onto this bean (its current bag, unless bag_id is also given)",
      "type": "integer"
     },
     "best_brew": {
      "enum": [
       0,
       1
      ],
      "type": "integer"
     },
     "beverage_g": {
      "type": "number"
     },
     "data_confidence": {
      "description": "estimated marks the metrics as a best guess instead of burying the caveat in notes",
      "enum": [
       "measured",
       "recalled",
       "estimated"
      ],
      "type": "string"
     },
     "dose_g": {
      "type": "number"
     },
     "drink_intent": {
      "enum": [
       "straight",
       "milk"
      ],
      "type": "string"
     },
     "favourite": {
      "enum": [
       0,
       1
      ],
      "type": "integer"
     },
     "finish_action": {
      "enum": [
       "hard_stop",
       "passive_drip"
      ],
      "type": "string"
     },
     "flavor_notes": {
      "description": "null clears the notes",
      "maxLength": 4096,
      "type": [
       "string",
       "null"
      ]
     },
     "grind_label": {
      "description": "Corrected grind setting label; numeric position is re-derived",
      "type": "string"
     },
     "grinder_id": {
      "type": "integer"
     },
     "machine_id": {
      "type": "integer"
     },
     "machine_settings": {
      "description": "The machine's selector positions for this shot, {key: position}; replaces what was stamped, null clears it",
      "maxProperties": 16,
      "type": [
       "object",
       "null"
      ]
     },
     "observations": {
      "maxProperties": 64,
      "type": "object"
     },
     "program_id": {
      "type": "integer"
     },
     "pulled_at": {
      "description": "Corrected timestamp (ISO 8601 or \"YYYY-MM-DD HH:MM:SS\")",
      "type": "string"
     },
     "rating": {
      "description": "1-5; null clears the rating",
      "maximum": 5,
      "minimum": 1,
      "type": [
       "integer",
       "null"
      ]
     },
     "sensory_tags": {
      "items": {
       "maxLength": 128,
       "type": "string"
      },
      "maxItems": 64,
      "type": "array"
     },
     "tasted": {
      "description": "Backfill 1 to mark a pending shot as tasted-clean (tasted, no defect tags) so it leaves the taste-pending queue without inventing a tag or rating",
      "enum": [
       0,
       1
      ],
      "type": "integer"
     },
     "tds": {
      "type": "number"
     },
     "temp_taste": {
      "enum": [
       "hot",
       "warm",
       "cold"
      ],
      "type": "string"
     },
     "temperature_c": {
      "type": "number"
     },
     "time_s": {
      "type": "number"
     },
     "verdict": {
      "description": "null clears the verdict",
      "type": [
       "string",
       "null"
      ]
     },
     "vessel_name": {
      "type": "string"
     },
     "vessel_weight_g": {
      "type": "number"
     },
     "water_id": {
      "type": "integer"
     },
     "yield_g": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "shot_id": {
    "description": "ID of the shot to correct",
    "type": "integer"
   }
  },
  "required": [
   "shot_id",
   "fields"
  ],
  "type": "object"
 },
 "name": "update_shot",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "message": {
    "type": "string"
   },
   "shot_id": {
    "type": "integer"
   },
   "status": {
    "type": "string"
   },
   "updated_fields": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "status",
   "shot_id",
   "updated_fields",
   "message"
  ],
  "type": "object"
 },
 "title": "Update a shot"
}
