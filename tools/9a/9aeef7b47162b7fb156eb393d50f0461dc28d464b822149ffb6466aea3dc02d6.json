{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a price alert for a product. Use notify_on_drop / notify_on_rise for any price change without a numeric threshold, and/or min_threshold_price / max_threshold_price for target prices. At least one of those four settings is required. Requires a Pricewatcha API key (pwk_live_...) from https://pricewatcha.com/profile#api-keys. On failure, returns a structured error object with fields error.code, error.message, error.http_status, error.retry_recommended, and error.retry_after_seconds.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "description": "Pricewatcha API key (pwk_live_...)",
    "minLength": 1,
    "type": "string"
   },
   "max_threshold_price": {
    "description": "Notify when the price rises to or above this value.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "min_threshold_price": {
    "description": "Notify when the price drops to or below this value.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "name": {
    "description": "Optional alert name",
    "maxLength": 128,
    "type": "string"
   },
   "notify_email": {
    "description": "Send email notifications (default true)",
    "type": "boolean"
   },
   "notify_on_drop": {
    "description": "Notify on any price drop. No threshold required.",
    "type": "boolean"
   },
   "notify_on_rise": {
    "description": "Notify on any price increase. No threshold required.",
    "type": "boolean"
   },
   "product_id": {
    "description": "Public product ID (prod_... or demo_...)",
    "minLength": 1,
    "type": "string"
   },
   "webhook_url": {
    "description": "Optional HTTPS webhook URL",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "api_key",
   "product_id"
  ],
  "type": "object"
 },
 "name": "create_price_alert",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "alert_id": {
    "type": "integer"
   },
   "created_at": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "is_active": {
    "type": "boolean"
   },
   "last_triggered_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "max_threshold_price": {
    "type": [
     "number",
     "null"
    ]
   },
   "min_threshold_price": {
    "type": [
     "number",
     "null"
    ]
   },
   "name": {
    "type": [
     "string",
     "null"
    ]
   },
   "notify_email": {
    "type": "boolean"
   },
   "notify_on_drop": {
    "type": "boolean"
   },
   "notify_on_rise": {
    "type": "boolean"
   },
   "product_id": {
    "type": "string"
   },
   "updated_at": {
    "type": "string"
   },
   "webhook_url": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "alert_id",
   "product_id",
   "notify_on_drop",
   "notify_on_rise",
   "currency",
   "notify_email",
   "is_active",
   "created_at",
   "updated_at"
  ],
  "type": "object"
 },
 "title": "Create price alert"
}
