 "description": "Use this when the user gives a 17-character vehicle identification number (VIN) and wants to know what car it is, such as \"what car is 1HGCM82633A004353?\". Returns the model year, make, model, trim, body class, engine, fuel, plant country and NHTSA's error codes and error text, which flag a wrong check digit or an incomplete decode. US-market vehicles. A data lookup, not a history report.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "vin": {
    "description": "The 17-character vehicle identification number (letters and digits, no I, O or Q)",
    "pattern": "^[A-HJ-NPR-Za-hj-npr-z0-9]{17}$",
    "type": "string"
   }
  },
  "required": [
   "vin"
  ],
  "type": "object"
 },
 "name": "decode_vin",
