{
 "annotations": {
  "destructiveHint": true,
  "title": "Create submissions"
 },
 "description": "Create up to 10 new submissions on a form, as if respondents had filled it in \u2014 e.g. to import responses collected elsewhere. Each submission needs its question answers (question ids from fillout_get_form); URL parameters, scheduling, payments, login email and timestamps are optional. Creates real records that trigger the form's integrations. Fillout: POST /forms/{formId}/submissions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "formId": {
    "description": "The form's public id (the formId from fillout_list_forms, also the id in the form's share URL).",
    "minLength": 1,
    "type": "string"
   },
   "submissions": {
    "description": "1-10 submissions to create.",
    "items": {
     "properties": {
      "lastUpdatedAt": {
       "description": "When it was last updated, ISO 8601.",
       "type": "string"
      },
      "login": {
       "description": "Login-page information.",
       "properties": {
        "email": {
         "description": "Verified respondent email.",
         "type": "string"
        }
       },
       "required": [
        "email"
       ],
       "type": "object"
      },
      "payments": {
       "description": "Payment answers (records only; no money moves).",
       "items": {
        "properties": {
         "id": {
          "description": "Payment field id.",
          "type": "string"
         },
         "value": {
          "description": "A record of an existing Stripe payment \u2014 this does NOT charge anyone.",
          "properties": {
           "currency": {
            "type": "string"
           },
           "email": {
            "type": "string"
           },
           "paymentId": {
            "description": "Stripe payment id.",
            "type": "string"
           },
           "status": {
            "type": "string"
           },
           "stripeCustomerId": {
            "type": "string"
           },
           "stripeCustomerUrl": {
            "type": "string"
           },
           "stripePaymentUrl": {
            "type": "string"
           },
           "stripeSubscriptionId": {
            "type": "string"
           },
           "totalAmount": {
            "description": "Amount in cents.",
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
           }
          },
          "required": [
           "paymentId"
          ],
          "type": "object"
         }
        },
        "required": [
         "id",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "questions": {
       "description": "Answers, one per question id.",
       "items": {
        "properties": {
         "id": {
          "description": "The question id (from fillout_get_form).",
          "type": "string"
         },
         "value": {
          "description": "The answer, shaped for the question type (string, number, array of choices, object...)."
         }
        },
        "required": [
         "id",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "scheduling": {
       "description": "Scheduling (booking) answers.",
       "items": {
        "properties": {
         "id": {
          "description": "Scheduling field id.",
          "type": "string"
         },
         "value": {
          "description": "Booking details.",
          "properties": {
           "email": {
            "type": "string"
           },
           "eventEndTime": {
            "description": "ISO 8601.",
            "type": "string"
           },
           "eventId": {
            "type": "string"
           },
           "eventStartTime": {
            "description": "ISO 8601.",
            "type": "string"
           },
           "eventUrl": {
            "type": "string"
           },
           "fullName": {
            "type": "string"
           },
           "meetingNotes": {
            "type": "string"
           },
           "rescheduleOrCancelUrl": {
            "type": "string"
           },
           "scheduledUserEmail": {
            "type": "string"
           },
           "timezone": {
            "description": "IANA timezone, e.g. Europe/Prague.",
            "type": "string"
           },
           "userId": {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
           }
          },
          "required": [
           "fullName",
           "email",
           "eventStartTime",
           "eventEndTime",
           "timezone"
          ],
          "type": "object"
         }
        },
        "required": [
         "id",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "submissionTime": {
       "description": "When it was submitted, ISO 8601 (default now).",
       "type": "string"
      },
      "urlParameters": {
       "description": "URL parameter values.",
       "items": {
        "properties": {
         "id": {
          "description": "URL parameter id (from fillout_get_form).",
          "type": "string"
         },
         "name": {
          "description": "URL parameter name.",
          "type": "string"
         },
         "value": {
          "description": "URL parameter value.",
          "type": "string"
         }
        },
        "required": [
         "id",
         "name",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "questions"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "formId",
   "submissions"
  ],
  "type": "object"
 },
 "name": "fillout_create_submissions",
 "title": "Create submissions"
}
