{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Find new topic ideas"
 },
 "description": "Use this when someone asks for new blog topic ideas from Reddit or RSS feeds. Returns counts and up to 5 of the saved ideas; it fetches the sources, scores candidates with paid AI and saves those that pass. Not for ideas already saved.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "description": "Who the blog writes for; defaults to the blog's context",
    "maxLength": 600,
    "type": "string"
   },
   "blogId": {
    "description": "Blog to find ideas for",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "limitPerSource": {
    "description": "Items to read from each source, from 1 to 100; defaults to 25",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "minScore": {
    "description": "Lowest AI score, 0 to 10, an idea needs to be saved; defaults to 5",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "perSourceCap": {
    "description": "Most candidates to score from each source, from 1 to 100; no cap by default",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "sinceHours": {
    "description": "How far back to read, in hours, from 1 to 8,760; defaults to 168 (7 days)",
    "exclusiveMinimum": 0,
    "maximum": 8760,
    "type": "integer"
   },
   "sources": {
    "additionalProperties": false,
    "description": "Subreddits and RSS feeds for this run only; the blog's saved sources when absent",
    "properties": {
     "reddit": {
      "description": "Subreddit names (without /r/)",
      "items": {
       "maxLength": 100,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9_]+$",
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "rss": {
      "description": "Full RSS / Atom feed URLs",
      "items": {
       "format": "uri",
       "maxLength": 2048,
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "blogId"
  ],
  "type": "object"
 },
 "name": "refresh_topic_ideas",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alreadyPublishedSkipped": {
    "$ref": "#/properties/fetched"
   },
   "duplicatesSkipped": {
    "$ref": "#/properties/fetched"
   },
   "fetched": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "newCandidates": {
    "$ref": "#/properties/fetched"
   },
   "saved": {
    "$ref": "#/properties/fetched"
   },
   "sourceErrorCount": {
    "$ref": "#/properties/fetched"
   },
   "sourceErrorDetailsSuppressed": {
    "const": true,
    "type": "boolean"
   },
   "status": {
    "const": "refreshed",
    "type": "string"
   },
   "topIdeas": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "angle": {
       "anyOf": [
        {
         "maxLength": 500,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "score": {
       "anyOf": [
        {
         "maximum": 10,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "title",
      "angle",
      "score"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "topIdeasTruncated": {
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "fetched",
   "newCandidates",
   "saved",
   "duplicatesSkipped",
   "alreadyPublishedSkipped",
   "topIdeas",
   "topIdeasTruncated",
   "sourceErrorCount",
   "sourceErrorDetailsSuppressed"
  ],
  "type": "object"
 },
 "title": "Find new topic ideas"
}
