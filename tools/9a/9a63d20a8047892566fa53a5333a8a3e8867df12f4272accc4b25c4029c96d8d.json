{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Page through analyzed procedures as address/value pairs after provider analysis. Ghidra metadata distinguishes thunks and external functions; follow next_offset for exhaustive coverage and use returned addresses in later function operations.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "limit": 100,
    "offset": 0
   }
  ],
  "properties": {
   "document": {
    "description": "The document name",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Maximum number of results to return in this page.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Zero-based index of the first result to return.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "unknown_registry_approved": {
    "const": true,
    "description": "Explicit approval to record typed capability unavailability as a residual unknown",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_procedures",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "has_more": {
      "type": "boolean"
     },
     "items": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "address": {
         "type": "string"
        },
        "procedure": {
         "additionalProperties": false,
         "properties": {
          "external": {
           "type": "boolean"
          },
          "thunk": {
           "type": "boolean"
          },
          "thunk_target": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "external",
          "thunk",
          "thunk_target"
         ],
         "type": "object"
        },
        "string": {
         "additionalProperties": false,
         "properties": {
          "byte_length": {
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          },
          "encoding": {
           "type": "string"
          },
          "termination": {
           "enum": [
            "missing",
            "present_or_not_required"
           ],
           "type": "string"
          }
         },
         "required": [
          "encoding",
          "termination",
          "byte_length"
         ],
         "type": "object"
        },
        "symbol": {
         "additionalProperties": false,
         "properties": {
          "dynamic": {
           "type": "boolean"
          },
          "external": {
           "type": "boolean"
          },
          "primary": {
           "type": "boolean"
          },
          "source": {
           "enum": [
            "default",
            "analysis",
            "ai",
            "imported",
            "user_defined"
           ],
           "type": "string"
          },
          "type": {
           "type": "string"
          }
         },
         "required": [
          "primary",
          "dynamic",
          "external",
          "type",
          "source"
         ],
         "type": "object"
        },
        "value": {
         "type": "string"
        },
        "value_truncated": {
         "type": "boolean"
        }
       },
       "required": [
        "address",
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "limit": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     "next_offset": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "offset": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "items",
     "offset",
     "limit",
     "total",
     "next_offset",
     "has_more"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "List Procedures"
}
