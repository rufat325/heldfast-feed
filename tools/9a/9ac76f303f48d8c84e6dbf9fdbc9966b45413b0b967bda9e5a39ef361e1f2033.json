{
 "description": "Publish a prepared candidate as the immutable release workers read. deliveryPolicy is REQUIRED and explicit \u2014 SILENT (visible, no worker notification/obligation), NOTIFY (notification, no obligation), or READ_REQUIRED (unread obligation + read/\"I understand\" + reminders). The release records the system recommendation and whether it was overridden.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "candidateId": {
    "minLength": 1,
    "type": "string"
   },
   "confirm": {
    "const": true,
    "type": "boolean"
   },
   "deliveryPolicy": {
    "enum": [
     "SILENT",
     "NOTIFY",
     "READ_REQUIRED"
    ],
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "notesText": {
    "maxLength": 4000,
    "type": "string"
   },
   "operationKey": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "titleText": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "candidateId",
   "operationKey",
   "deliveryPolicy",
   "confirm"
  ],
  "type": "object"
 },
 "name": "opentrain_job_instructions_release_publish",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
