{
 "description": "List or create discount/coupon codes for a shop. Supports percent, fixed, free_shipping, volume, and bogo types.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "What to do",
    "enum": [
     "list",
     "create"
    ],
    "type": "string"
   },
   "bogoBuyProductId": {
    "type": "string"
   },
   "bogoGetProductId": {
    "type": "string"
   },
   "bogoGetQty": {
    "type": "number"
   },
   "code": {
    "description": "create: coupon code (required unless isAutomatic=true)",
    "type": "string"
   },
   "discountType": {
    "description": "create: default percent",
    "enum": [
     "percent",
     "fixed",
     "free_shipping",
     "volume",
     "bogo"
    ],
    "type": "string"
   },
   "discountValue": {
    "description": "create: percent or fixed amount value",
    "type": "number"
   },
   "expiresAt": {
    "description": "create: ISO date/time",
    "type": "string"
   },
   "isAutomatic": {
    "description": "create: apply automatically without a code",
    "type": "boolean"
   },
   "limit": {
    "description": "list: max discounts",
    "type": "number"
   },
   "maxUses": {
    "type": "number"
   },
   "minOrderAmount": {
    "type": "number"
   },
   "offset": {
    "description": "list: pagination offset",
    "type": "number"
   },
   "projectId": {
    "description": "Website project ID",
    "type": "string"
   },
   "volumeTiers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "discount_pct": {
       "type": "number"
      },
      "min_qty": {
       "type": "number"
      }
     },
     "required": [
      "min_qty",
      "discount_pct"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "action"
  ],
  "type": "object"
 },
 "name": "manage_discounts"
}
