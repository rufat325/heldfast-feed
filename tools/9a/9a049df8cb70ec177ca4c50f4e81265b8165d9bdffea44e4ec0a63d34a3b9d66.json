{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Verify canonical documents/tree/checksums. This does not prove real worker access, collaboration synchronization or browser rendering. Requires current employer folder access. Empty destinations require reviewed activation; published/unknown delivery writes refuse without changing release/read/ack flags. Requires instructions:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folderId": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   }
  },
  "required": [
   "folderId"
  ],
  "type": "object"
 },
 "name": "opentrain_folder_instructions_verify",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "browserRenderVerified": {
      "const": false,
      "type": "boolean"
     },
     "canonicalSource": {
      "const": "FOLDER_INSTRUCTION_SET",
      "type": "string"
     },
     "checksumMatched": {
      "type": "null"
     },
     "collaborationSyncVerified": {
      "const": false,
      "type": "boolean"
     },
     "employerUrl": {
      "type": "string"
     },
     "findings": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "$ref": "#/properties/result/properties/employerUrl"
        },
        "details": {
         "additionalProperties": {},
         "type": "object"
        },
        "message": {
         "$ref": "#/properties/result/properties/employerUrl"
        },
        "path": {
         "$ref": "#/properties/result/properties/employerUrl"
        },
        "severity": {
         "enum": [
          "ERROR",
          "WARNING",
          "INFO"
         ],
         "type": "string"
        }
       },
       "required": [
        "code",
        "severity",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "ok": {
      "type": "boolean"
     },
     "pageCount": {
      "minimum": 0,
      "type": "integer"
     },
     "pages": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "checksum": {
         "pattern": "^[a-fA-F0-9]{64}$",
         "type": "string"
        },
        "findings": {
         "$ref": "#/properties/result/properties/findings"
        },
        "imageUrls": {
         "items": {
          "$ref": "#/properties/result/properties/employerUrl"
         },
         "type": "array"
        },
        "nodeCount": {
         "$ref": "#/properties/result/properties/pageCount"
        },
        "pageId": {
         "pattern": "^[A-Za-z0-9._:-]{1,128}$",
         "type": "string"
        },
        "renderedHtmlValid": {
         "type": "boolean"
        },
        "stableNodeIdCount": {
         "$ref": "#/properties/result/properties/pageCount"
        },
        "title": {
         "$ref": "#/properties/result/properties/employerUrl"
        }
       },
       "required": [
        "pageId",
        "title",
        "checksum",
        "nodeCount",
        "stableNodeIdCount",
        "imageUrls",
        "renderedHtmlValid",
        "findings"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "restReadBackVerified": {
      "const": true,
      "type": "boolean"
     },
     "storageWriteAccepted": {
      "type": "null"
     },
     "treeChecksum": {
      "$ref": "#/properties/result/properties/employerUrl"
     }
    },
    "required": [
     "ok",
     "storageWriteAccepted",
     "restReadBackVerified",
     "checksumMatched",
     "collaborationSyncVerified",
     "browserRenderVerified",
     "canonicalSource",
     "employerUrl",
     "treeChecksum",
     "pageCount",
     "findings",
     "pages"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
