{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find TripAdvisor locations near a point within a radius, or inside a bounding box. Center by lat+lon+radius, by a reference location_id+radius, or by a sw/ne bounding box. Returns matches with distance and a location id. Returns slim summaries by default; pass view:\"full\" for the whole records.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Restrict to one category",
    "enum": [
     "RESTAURANT",
     "ATTRACTION",
     "HOTEL"
    ],
    "type": "string"
   },
   "include_photo": {
    "description": "Include a photo per result",
    "type": "boolean"
   },
   "lat": {
    "description": "Center latitude (with lon+radius)",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "locale": {
    "description": "Preferred locales for localized fields, in priority order (e.g. [\"en\",\"es\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "location_id": {
    "description": "Reference location as center (with radius)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "lon": {
    "description": "Center longitude (with lat+radius)",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "min_rating": {
    "description": "Minimum traveler rating (1.0\u20135.0)",
    "maximum": 5,
    "minimum": 1,
    "type": "number"
   },
   "ne_lat": {
    "description": "Bounding box NE latitude",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "ne_lon": {
    "description": "Bounding box NE longitude",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "page": {
    "description": "Page index (1-based)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "radius": {
    "description": "Search radius (required with lat/lon or location_id; must be > 0)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "size": {
    "description": "Results per page (max 20)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "Sort order (default distance)",
    "enum": [
     "distance",
     "rating"
    ],
    "type": "string"
   },
   "sw_lat": {
    "description": "Bounding box SW latitude",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "sw_lon": {
    "description": "Bounding box SW longitude",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "unit": {
    "description": "Radius unit (default MI)",
    "enum": [
     "MI",
     "KM"
    ],
    "type": "string"
   },
   "view": {
    "description": "Response shape: \"compact\" (default) drops fields the response already carries elsewhere; \"full\" returns every field this server understands. compact returns the slim projection where one exists and strips image URLs elsewhere; \"full\" returns TripAdvisor's whole records.",
    "enum": [
     "compact",
     "full"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ta_search_nearby"
}
