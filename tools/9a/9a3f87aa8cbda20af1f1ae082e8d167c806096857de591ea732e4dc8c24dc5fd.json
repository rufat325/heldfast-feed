{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Review Quote Paper Edit"
 },
 "description": "Review a transcript quote library, explicitly order approved quotes, and return running timings and a formula-neutralized CSV paper edit inline. Local-only; no files, provider calls or multi-source timeline assembly.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expected_cep_target": {
    "additionalProperties": false,
    "anyOf": [
     {
      "required": [
       "sequence_id"
      ]
     },
     {
      "required": [
       "source_item"
      ]
     }
    ],
    "description": "Optional reviewed CEP sequence/clip identity and exact tick ranges. Checked before every generated command; UXP refuses this CEP-only guard.",
    "properties": {
     "backend": {
      "const": "cep",
      "description": "Backend namespace for these IDs.",
      "type": "string"
     },
     "clip": {
      "additionalProperties": false,
      "description": "Optional exact reviewed timeline clip.",
      "properties": {
       "effect": {
        "additionalProperties": false,
        "description": "Reviewed effect and parameter identity checked before mutation.",
        "properties": {
         "display_name": {
          "description": "Optional exact host display name.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         "match_name": {
          "description": "Effect match name from host inspection.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         "parameter_index": {
          "description": "Inspected zero-based parameter index.",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
         },
         "parameter_name": {
          "description": "Exact inspected parameter name.",
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "match_name",
         "parameter_index",
         "parameter_name"
        ],
        "type": "object"
       },
       "end_ticks": {
        "description": "Exact expected exclusive timeline end ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "in_ticks": {
        "description": "Exact expected source In ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "node_id": {
        "description": "Stable CEP node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "out_ticks": {
        "description": "Exact expected exclusive source Out ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "project_item_id": {
        "description": "Expected source project-item node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "start_ticks": {
        "description": "Exact expected timeline start ticks.",
        "pattern": "^-?\\d{1,30}$",
        "type": "string"
       },
       "track_index": {
        "description": "Expected zero-based track index; identity still checked.",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
       },
       "track_type": {
        "description": "Expected media track group.",
        "enum": [
         "video",
         "audio"
        ],
        "type": "string"
       }
      },
      "required": [
       "node_id",
       "track_type",
       "track_index"
      ],
      "type": "object"
     },
     "project_document_id": {
      "description": "Exact Premiere project document ID observed during review.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "sequence_id": {
      "description": "Stable expected active sequence ID.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "source_item": {
      "additionalProperties": false,
      "description": "Reviewed source identity for a source-only operation.",
      "properties": {
       "media_path": {
        "description": "Optional exact source-media path.",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
       },
       "node_id": {
        "description": "Exact project-item node ID.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "node_id"
      ],
      "type": "object"
     }
    },
    "required": [
     "backend"
    ],
    "type": "object"
   },
   "expected_project_path": {
    "description": "Optional absolute saved-project path. Every generated CEP command refuses before its body when the active project differs or is unsaved. UXP commands refuse this CEP-only guard; local-only tools do not inspect Premiere. Omit to keep existing behavior.",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "expected_review_revision": {
    "description": "Revision from the initial review; required when selecting or rejecting entries. A changed input requires a new review.",
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   },
   "quote_order": {
    "description": "Explicitly approved quote IDs in final paper-edit order. Omit for an unapproved library preview.",
    "items": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 512,
    "type": "array"
   },
   "segments": {
    "description": "Quote library with captured transcript revisions and source ranges.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "end_seconds": {
       "description": "Source-time end, greater than start.",
       "maximum": 86400,
       "minimum": 0,
       "type": "number"
      },
      "id": {
       "description": "Stable transcript segment ID.",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "source_project_item_id": {
       "description": "Exact source project-item ID.",
       "maxLength": 512,
       "minLength": 1,
       "type": "string"
      },
      "speaker_label": {
       "description": "Reviewed speaker label.",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "start_seconds": {
       "description": "Source-time start in seconds.",
       "maximum": 86400,
       "minimum": 0,
       "type": "number"
      },
      "text": {
       "description": "Supplied transcript text; never uploaded or retained by this tool.",
       "maxLength": 1000,
       "type": "string"
      },
      "transcript_revision": {
       "description": "Revision of the captured source transcript.",
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "id",
      "source_project_item_id",
      "transcript_revision",
      "start_seconds",
      "end_seconds",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 512,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "segments"
  ],
  "type": "object"
 },
 "name": "review_quote_paper_edit",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true; on failure, diagnostic detail when the tool provides it."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "receipt": {
    "additionalProperties": true,
    "description": "Versioned common mutation receipt; success never implies rendered verification.",
    "type": "object"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Review Quote Paper Edit"
}
