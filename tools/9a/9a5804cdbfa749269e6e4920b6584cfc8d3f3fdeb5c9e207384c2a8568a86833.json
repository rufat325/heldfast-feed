{
 "description": "Administrator-only finite earned-credit issuance with a permanent unique reference. Never called automatically.",
 "inputSchema": {
  "properties": {
   "budget": {
    "properties": {
     "agentId": {
      "format": "uuid",
      "type": [
       "string",
       "null"
      ]
     },
     "amount": {
      "type": "integer"
     },
     "operatorLimit": {
      "default": 300,
      "type": "integer"
     },
     "reason": {
      "type": "string"
     },
     "reference": {
      "type": "string"
     },
     "reviewerLimit": {
      "default": 100,
      "type": "integer"
     },
     "subsidy": {
      "default": false,
      "type": "boolean"
     }
    },
    "required": [
     "reference",
     "amount",
     "agentId",
     "reason"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "type": "string"
   }
  },
  "required": [
   "budget",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "issue_budget"
}
