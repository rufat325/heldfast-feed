{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Inspect Image Session"
 },
 "description": "Retrieve detailed information about an image generation session and all its assets.\n\nReturns:\n- Session metadata (creation time, name, status)\n- List of all assets with their prompts, toolchains, and status\n- Parent-child relationships showing iteration history\n\nUse this to:\n- Review what was generated in a session\n- Find asset IDs for iteration\n- Understand the generation history and toolchains used",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "sessionId": {
    "description": "The session UUID to inspect",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "inspectImageSession",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assetCount": {
    "type": "number"
   },
   "assets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "assetId": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "prompt": {
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "assetId",
      "prompt",
      "kind",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "type": [
     "string",
     "null"
    ]
   },
   "sessionId": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "name",
   "status",
   "assets"
  ],
  "type": "object"
 }
}
