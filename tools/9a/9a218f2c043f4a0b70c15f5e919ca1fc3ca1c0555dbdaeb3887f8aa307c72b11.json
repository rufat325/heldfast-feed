{
 "description": "Report incorrect or outdated pricing data for a product.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "What's wrong with the current pricing data",
    "type": "string"
   },
   "product": {
    "description": "Product slug",
    "type": "string"
   },
   "report_type": {
    "default": "incorrect_price",
    "enum": [
     "incorrect_price",
     "missing_plan",
     "outdated",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "product",
   "description"
  ],
  "type": "object"
 },
 "name": "report_incorrect_pricing"
}
