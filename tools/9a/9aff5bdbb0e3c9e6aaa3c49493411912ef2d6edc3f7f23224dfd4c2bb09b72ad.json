{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Solana wallet rug-risk sweep"
 },
 "description": "Grade every token a Solana wallet holds for rug risk in one call (up to 40 holdings). Free: totals plus the 3 riskiest holdings. Paid ($1 in SOL, one time per wallet): every holding itemised. This one tool covers the whole paid flow: an unpaid result includes payment.pay_to and payment.amount_sol; send exactly that amount (the amount identifies the wallet), then call wallet_sweep again with the same address and it returns status=full once the payment is seen on chain (usually within 30 s). Use solsnap_scan for a single token. Errors (isError=true): malformed address. Empty wallets return tokens_held=0.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Wallet (owner) address, base58 32-44 chars. Not a token mint.",
    "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "wallet_sweep",
 "outputSchema": {
  "properties": {
   "generated_utc": {
    "type": "string"
   },
   "not_scored": {
    "type": "integer"
   },
   "owner": {
    "type": "string"
   },
   "payment": {
    "description": "How to unlock the full report (absent once paid).",
    "properties": {
     "amount_sol": {
      "type": "number"
     },
     "how": {
      "type": "string"
     },
     "pay_to": {
      "type": "string"
     },
     "price_usd": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "riskiest": {
    "description": "up to 3 lowest-scoring holdings",
    "items": {
     "properties": {
      "amount": {
       "type": "number"
      },
      "flags": {
       "items": {
        "properties": {
         "msg": {
          "type": "string"
         },
         "severity": {
          "enum": [
           "critical",
           "high",
           "med",
           "low",
           "info",
           "ok"
          ],
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "found": {
       "type": "boolean"
      },
      "grade": {
       "type": "string"
      },
      "mint": {
       "type": "string"
      },
      "program": {
       "enum": [
        "spl-token",
        "token-2022"
       ],
       "type": "string"
      },
      "score": {
       "type": [
        "integer",
        "null"
       ]
      },
      "symbol": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "rows": {
    "description": "every holding, only when status=full",
    "items": {
     "properties": {
      "amount": {
       "type": "number"
      },
      "flags": {
       "items": {
        "properties": {
         "msg": {
          "type": "string"
         },
         "severity": {
          "enum": [
           "critical",
           "high",
           "med",
           "low",
           "info",
           "ok"
          ],
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "found": {
       "type": "boolean"
      },
      "grade": {
       "type": "string"
      },
      "mint": {
       "type": "string"
      },
      "program": {
       "enum": [
        "spl-token",
        "token-2022"
       ],
       "type": "string"
      },
      "score": {
       "type": [
        "integer",
        "null"
       ]
      },
      "symbol": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "description": "full = every holding itemised; summary = free tier; not_paid = payment not seen yet",
    "enum": [
     "full",
     "summary",
     "not_paid"
    ],
    "type": "string"
   },
   "tokens_held": {
    "type": "integer"
   },
   "tokens_scored": {
    "type": "integer"
   },
   "truncated": {
    "description": "holdings beyond the 40-token cap",
    "type": "integer"
   }
  },
  "required": [
   "owner",
   "status",
   "tokens_held"
  ],
  "type": "object"
 },
 "title": "Solana wallet rug-risk sweep"
}
