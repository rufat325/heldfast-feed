  "readOnlyHint": true,
  "title": "chainpeek: current lending supply and borrow APY on Aave V3, Compound V3 and Morpho, with a best stablecoin rate view"
 },
 "description": "chainpeek: Use when an agent must choose where to lend or borrow: supply and borrow APY on Aave, Compound and Morpho. For protocol TVL use get_protocol_tvl; for perp funding use get_funding_rates. Returns current lending supply and borrow APY on Aave V3, Compound V3 and Morpho by chain and asset, or the best stablecoin supply rate (USDC, USDT, DAI, USDS, USDe) across them. Snapshot refreshed about every 5 minutes (`as_of`, `stale`); Aave, Compound and Morpho on Ethereum, Base, Arbitrum, Optimism and Polygon; APY excludes rewards. Informational only, not investment advice. Bad input is a 422 (not charged). Typically under 1 s. Price: USD 0.001. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/defi-lending-rates-api.html",
 "inputSchema": {
  "properties": {
   "assets": {
    "anyOf": [
     {
      "items": {
       "pattern": "^[A-Za-z0-9._-]{1,20}$",
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional asset symbols such as USDC or WETH (case-insensitive, at most 20). In best_stablecoin only USDC, USDT, DAI, USDS and USDe are ranked.",
    "title": "Assets"
   },
   "chains": {
    "anyOf": [
     {
      "items": {
       "enum": [
        "ethereum",
        "base",
        "arbitrum",
        "polygon",
        "optimism"
       ],
       "type": "string"
      },
      "maxItems": 5,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional subset of ethereum, base, arbitrum, polygon, optimism. Default: all. Aave V3, Compound V3 and Morpho cover all five.",
    "title": "Chains"
   },
   "limit": {
    "default": 50,
    "description": "Rows returned, 1-200 (default 50).",
    "maximum": 200,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "min_tvl_usd": {
    "anyOf": [
     {
      "maximum": 10000000000000.0,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Only rows with at least this many USD supplied (rows with an unknown USD size are dropped when it is above 0). Default 0; best_stablecoin defaults to 1,000,000.",
    "title": "Min Tvl Usd"
   },
   "protocols": {
    "anyOf": [
     {
      "items": {
       "enum": [
        "aave_v3",
        "compound_v3",
        "morpho"
       ],
       "type": "string"
      },
      "maxItems": 3,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional subset of aave_v3, compound_v3, morpho. Default: all.",
    "title": "Protocols"
   },
   "view": {
    "default": "all",
    "description": "all: every matching rate, highest supply APY first. best_stablecoin: USDC, USDT, DAI, USDS and USDe ranked by supply APY across the three protocols (canonical token addresses only).",
    "enum": [
     "all",
     "best_stablecoin"
    ],
    "title": "View",
    "type": "string"
   }
  },
  "title": "get_lending_yieldsArguments",
  "type": "object"
 },
