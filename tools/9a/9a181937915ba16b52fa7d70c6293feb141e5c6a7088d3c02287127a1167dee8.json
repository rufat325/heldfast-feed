{
 "description": "Format cells in a Google Sheet (background, borders, alignment)",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Alias of the Google account to target. Optional \u2014 defaults to the session/global default account, or the sole authenticated account. Run manage_accounts list to see available aliases.",
    "type": "string"
   },
   "backgroundColor": {
    "description": "Background color (RGB values 0-1)",
    "properties": {
     "blue": {
      "type": "number"
     },
     "green": {
      "type": "number"
     },
     "red": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "horizontalAlignment": {
    "description": "Horizontal alignment",
    "enum": [
     "LEFT",
     "CENTER",
     "RIGHT"
    ],
    "type": "string"
   },
   "range": {
    "description": "Range to format (e.g., 'A1:C10')",
    "type": "string"
   },
   "spreadsheetId": {
    "description": "Spreadsheet ID",
    "type": "string"
   },
   "verticalAlignment": {
    "description": "Vertical alignment",
    "enum": [
     "TOP",
     "MIDDLE",
     "BOTTOM"
    ],
    "type": "string"
   },
   "wrapStrategy": {
    "description": "Text wrapping",
    "enum": [
     "OVERFLOW_CELL",
     "CLIP",
     "WRAP"
    ],
    "type": "string"
   }
  },
  "required": [
   "spreadsheetId",
   "range"
  ],
  "type": "object"
 },
 "name": "formatGoogleSheetCells"
}
