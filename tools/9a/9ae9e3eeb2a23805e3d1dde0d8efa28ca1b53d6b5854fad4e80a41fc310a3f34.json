{
 "_meta": {
  "ui": {
   "resourceUri": "ui://destaire/stay"
  },
  "ui/resourceUri": "ui://destaire/stay"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "One stay as its page shows it: description, address, location, website, \"from\" rate, amenities, collections, and photo URLs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "slug": {
    "description": "The stay's slug, the last part of its URL.",
    "maxLength": 120,
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_stay",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "address": {
    "type": "string"
   },
   "amenities": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "collections": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "name",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "country": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "destination": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "name",
     "url"
    ],
    "type": "object"
   },
   "hero": {
    "description": "The main photo at 2:1.",
    "format": "uri",
    "type": "string"
   },
   "kind": {
    "description": "A hotel, or a private stay: a whole house or estate that one party rents.",
    "enum": [
     "hotel",
     "private stay"
    ],
    "type": "string"
   },
   "lede": {
    "type": "string"
   },
   "location": {
    "additionalProperties": false,
    "properties": {
     "latitude": {
      "type": "number"
     },
     "longitude": {
      "type": "number"
     }
    },
    "required": [
     "latitude",
     "longitude"
    ],
    "type": "object"
   },
   "name": {
    "type": "string"
   },
   "photos": {
    "items": {
     "format": "uri",
     "type": "string"
    },
    "type": "array"
   },
   "rate": {
    "additionalProperties": false,
    "description": "The \"from\" rate: the lowest nightly price over the next six months, checked each week.",
    "properties": {
     "amount": {
      "description": "The \"from\" rate in euros, rounded to 10.",
      "type": [
       "number",
       "null"
      ]
     },
     "checked": {
      "anyOf": [
       {
        "format": "date",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The day the rate was last read on the hotel's own booking engine (YYYY-MM-DD). Null when no date is recorded."
     },
     "currency": {
      "anyOf": [
       {
        "const": "EUR",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "per": {
      "anyOf": [
       {
        "enum": [
         "night",
         "week"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "text": {
      "description": "As the site shows it: \"from \u20ac950/night\", or \"Price on request\".",
      "type": "string"
     }
    },
    "required": [
     "text",
     "amount",
     "currency",
     "per",
     "checked"
    ],
    "type": "object"
   },
   "town": {
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   },
   "website": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "name",
   "url",
   "kind",
   "lede",
   "description",
   "town",
   "destination",
   "country",
   "address",
   "location",
   "website",
   "rate",
   "amenities",
   "collections",
   "hero",
   "photos"
  ],
  "type": "object"
 },
 "title": "Get a stay"
}
