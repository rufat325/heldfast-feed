{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Run a spec's embedded test cases (or ad-hoc given->expect cases) through the real reactive pipeline in a throwaway runtime, returning pass/fail plus per-field failures (path, expected, actual). Use this to certify domain behavior before create_model / promotion.",
 "inputSchema": {
  "properties": {
   "spec": {
    "description": "The ModelSpec whose tests to run.",
    "properties": {
     "constants": {
      "type": "object"
     },
     "constraints": {
      "items": {
       "properties": {
        "expr": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "policy": {
         "enum": [
          "rollback",
          "flag"
         ],
         "type": "string"
        }
       },
       "required": [
        "id",
        "expr"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "defaultValues": {
      "items": {
       "properties": {
        "description": {
         "type": "string"
        },
        "expr": {
         "type": "string"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "path",
        "expr"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "derivations": {
      "items": {
       "properties": {
        "evaluation": {
         "enum": [
          "eager",
          "lazy"
         ],
         "type": "string"
        },
        "expr": {
         "type": "string"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "path",
        "expr"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "effects": {
      "items": {
       "properties": {
        "afterMs": {
         "type": "string"
        },
        "at": {
         "type": "string"
        },
        "dedupeKey": {
         "type": "string"
        },
        "emit": {
         "type": "string"
        },
        "executor": {
         "enum": [
          "caller",
          "server",
          "llm",
          "timer"
         ],
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "payload": {
         "type": "object"
        },
        "policy": {
         "type": "object"
        },
        "prompt": {
         "type": "string"
        },
        "request": {
         "type": "object"
        },
        "requests": {
         "type": "string"
        },
        "response": {
         "type": "object"
        },
        "responseSchema": {
         "type": "object"
        },
        "statusPath": {
         "type": "string"
        },
        "trigger": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "executor",
        "trigger"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "library": {
      "properties": {
       "define": {
        "type": "string"
       },
       "description": {
        "type": "string"
       },
       "signatures": {
        "type": "object"
       }
      },
      "required": [
       "define"
      ],
      "type": "object"
     },
     "metaDerivations": {
      "items": {
       "properties": {
        "expr": {
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "property": {
         "type": "string"
        }
       },
       "required": [
        "path",
        "property",
        "expr"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "schema": {
      "type": "object"
     },
     "tests": {
      "items": {
       "properties": {
        "description": {
         "type": "string"
        },
        "expect": {
         "type": "object"
        },
        "given": {
         "type": "object"
        }
       },
       "required": [
        "expect"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "version": {
      "type": "string"
     },
     "viewDefinition": {
      "type": "object"
     }
    },
    "required": [
     "id",
     "schema"
    ],
    "type": "object"
   },
   "tests": {
    "description": "Optional list of test cases (each with 'given' inputs and 'expect' outputs); omit to run the spec's own embedded 'tests'.",
    "type": "array"
   }
  },
  "required": [
   "spec"
  ],
  "type": "object"
 },
 "name": "test_spec",
 "outputSchema": {
  "properties": {
   "failed": {
    "description": "Cases that failed.",
    "type": "integer"
   },
   "passed": {
    "description": "Cases that passed.",
    "type": "integer"
   },
   "results": {
    "description": "Per-case results (with per-field failures on failure).",
    "type": "array"
   },
   "total": {
    "description": "Total test cases run.",
    "type": "integer"
   }
  },
  "type": "object"
 },
 "title": "Test spec"
}
