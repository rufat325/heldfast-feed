{
 "description": "Structured, filterable query over the change history \u2014 filter by date, endpoint, object type/name, change kind, and source.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "change_kind": {
    "enum": [
     "added",
     "removed",
     "modified",
     "renamed",
     "deprecated"
    ],
    "type": "string"
   },
   "endpoint": {
    "enum": [
     "v1.0",
     "beta"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "object_name": {
    "description": "e.g. group, user, conditionalAccessPolicy",
    "type": "string"
   },
   "object_type": {
    "description": "e.g. EntityType, EnumType, ComplexType, ObjectInstance",
    "type": "string"
   },
   "since": {
    "description": "ISO date (YYYY-MM-DD); defaults to 7 days ago",
    "type": "string"
   },
   "source": {
    "enum": [
     "seed-entra-ms",
     "backfill-graph-changelog",
     "self"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_recent_changes"
}
