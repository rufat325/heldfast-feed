 },
 "description": "Pending Replies (Inbox): the replies the user owes ('who do I owe a reply?'), newest first, or one by reply_id. status: unsent (default; pending + snoozed), sent, dismissed, all. Filter by person_name or person_id. Each reply has reply_id, person_name, person_id (null when unlinked), draft, summary, channel, category, source ids, status, state (unsent | sent | dismissed) and due (owed now; false while snoozed until snooze_until). Read-only. ($0.05; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "1-200, default 50.",
    "type": "number"
   },
   "person_id": {
    "type": "string"
   },
   "person_name": {
    "type": "string"
   },
   "reply_id": {
    "description": "Read one reply (ignores the filters).",
    "type": "string"
   },
   "status": {
    "enum": [
     "unsent",
     "sent",
     "dismissed",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_pending_replies",
 "openWorldHint": false,
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "app_url": {
    "type": "string"
   },
   "count": {
    "type": "number"
   },
   "has_more": {
    "type": "boolean"
   },
   "pending_replies": {
    "items": {
     "additionalProperties": false,
     "description": "One reply the user owes (Inbox \u2192 Pending Replies). Dayze never sends it.",
     "properties": {
      "approved_at": {
       "description": "PHI-427: when the owner approved the draft and opened it in Gmail, or null. Dayze never sends; the Gmail sync closes the reply when the email goes out.",
       "type": [
        "string",
        "null"
       ]
      },
      "category": {
       "description": "personal or work",
       "type": "string"
      },
      "channel": {
       "type": "string"
      },
      "created_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "draft": {
       "description": "The reply text saved for later.",
       "type": [
        "string",
        "null"
       ]
      },
      "due": {
       "description": "Owed now: pending, or snoozed with snooze_until passed. False while a snooze runs, and when sent or dismissed.",
       "type": "boolean"
      },
      "is_private": {
       "description": "Always true.",
       "type": "boolean"
      },
      "person_id": {
       "description": "Linked contact id; null when the reply is unlinked.",
       "type": [
        "string",
        "null"
       ]
      },
      "person_name": {
       "type": "string"
      },
      "received_at": {
       "type": "string"
      },
      "reply_id": {
       "type": "string"
      },
      "responded_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "snooze_until": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "additionalProperties": false,
       "description": "The email it answers, as ids only; null when none was saved.",
       "properties": {
        "kind": {
         "description": "gmail, email or other",
         "type": "string"
        },
        "message_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "thread_id": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": [
        "object",
        "null"
       ]
      },
      "state": {
       "description": "unsent (pending or snoozed), sent (the owner replied) or dismissed",
       "type": "string"
      },
      "status": {
       "description": "pending, snoozed, responded or dismissed",
       "type": "string"
      },
      "summary": {
       "type": [
        "string",
        "null"
       ]
      },
      "updated_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "visibility": {
       "description": "Always private: Pending Replies have no sharing setting.",
       "type": "string"
      }
     },
     "required": [
      "reply_id",
      "person_name",
      "person_id",
      "channel",
      "category",
      "summary",
      "draft",
      "status",
      "state",
      "due",
      "received_at",
      "source",
      "visibility",
      "is_private"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "description": "The filter applied: unsent, sent, dismissed or all.",
    "type": "string"
   }
  },
  "required": [
