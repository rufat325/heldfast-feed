{
 "description": "Get inbox messages for an agent. Returns messages sorted by timestamp with pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "did": {
    "description": "Agent DID",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Max messages (1-100, default: 50)",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset (default: 0)",
    "type": "number"
   }
  },
  "required": [
   "did"
  ],
  "type": "object"
 },
 "name": "get_inbox"
}
