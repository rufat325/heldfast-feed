{
 "annotations": {
  "audience": [
   "user",
   "assistant"
  ],
  "openWorldHint": true,
  "priority": 0.5,
  "title": "Update Bulk Tasks"
 },
 "description": "Update multiple tasks. Each task needs: taskId or taskName + listName. Options: batch size, concurrency.",
 "inputSchema": {
  "properties": {
   "options": {
    "description": "Processing options. JSON strings are auto-parsed.",
    "properties": {
     "batchSize": {
      "description": "Tasks per batch (default: 10)",
      "type": "number"
     },
     "concurrency": {
      "description": "Parallel operations (default: 3)",
      "type": "number"
     },
     "continueOnError": {
      "description": "Continue if some tasks fail",
      "type": "boolean"
     },
     "retryCount": {
      "description": "Retry attempts for failures",
      "type": "number"
     }
    },
    "type": "object"
   },
   "tasks": {
    "description": "Tasks to update",
    "items": {
     "description": "Task object",
     "properties": {
      "assignees": {
       "description": "User IDs/emails/names (comma-separated or JSON string)",
       "type": "string"
      },
      "customTaskId": {
       "description": "Custom ID (optional)",
       "type": "string"
      },
      "custom_fields": {
       "description": "Custom fields as JSON string: [{id, value}]",
       "type": "string"
      },
      "custom_task_type": {
       "description": "New task type name (e.g. 'Bug', 'Milestone')",
       "type": "string"
      },
      "description": {
       "description": "New description",
       "type": "string"
      },
      "dueDate": {
       "description": "New due date: unix ms, natural language, or null to clear.",
       "type": "string"
      },
      "listName": {
       "description": "List name. Required with taskName",
       "type": "string"
      },
      "markdown_description": {
       "description": "New markdown",
       "type": "string"
      },
      "name": {
       "description": "New name",
       "type": "string"
      },
      "priority": {
       "description": "Priority 1 (urgent) - 4 (low), as string or number. Or null to clear.",
       "type": "string"
      },
      "startDate": {
       "description": "New start date: unix ms, natural language, or null to clear.",
       "type": "string"
      },
      "status": {
       "description": "New status",
       "type": "string"
      },
      "taskId": {
       "description": "Task ID",
       "type": "string"
      },
      "taskName": {
       "description": "Task name. Automatically resolved to ID. Requires listName",
       "type": "string"
      },
      "time_estimate": {
       "description": "Time estimate: natural language ('2h 30m', '45m', '1.5h'), plain number (minutes), or null to clear.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "team_id": {
    "description": "The ClickUp Team ID or Workspace Name to use. If provided, the server will switch to this workspace for this and subsequent requests in the current session.",
    "type": "string"
   }
  },
  "required": [
   "tasks"
  ],
  "type": "object"
 },
 "name": "update_bulk_tasks"
}
