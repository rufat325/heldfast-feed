{
 "description": "Post a job on Himalayas without an account. Provide your email and company details. Payment is required \u2014 a Stripe checkout URL will be returned. No authentication needed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "app_link_or_email": {
    "description": "Application URL or email address",
    "type": "string"
   },
   "base_salary": {
    "description": "Minimum salary",
    "type": "number"
   },
   "category_list": {
    "description": "Comma-separated job categories",
    "type": "string"
   },
   "company_name": {
    "description": "Company name",
    "type": "string"
   },
   "company_url": {
    "description": "Company website URL",
    "type": "string"
   },
   "customer_email": {
    "description": "Your email address for payment and notifications",
    "type": "string"
   },
   "description": {
    "description": "Job description (350+ characters, can include HTML)",
    "minLength": 350,
    "type": "string"
   },
   "employment_type": {
    "description": "Employment type",
    "enum": [
     "Full Time",
     "Part Time",
     "Contractor",
     "Temporary",
     "Intern",
     "Volunteer",
     "Other"
    ],
    "type": "string"
   },
   "max_salary": {
    "description": "Maximum salary",
    "type": "number"
   },
   "salary_country": {
    "description": "Salary currency code (default: USD)",
    "type": "string"
   },
   "seniority": {
    "description": "Seniority levels",
    "items": {
     "enum": [
      "Entry-level",
      "Mid-level",
      "Senior",
      "Manager",
      "Director",
      "Executive"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "skill_list": {
    "description": "Comma-separated skills",
    "type": "string"
   },
   "title": {
    "description": "Job title (5-80 characters)",
    "maxLength": 80,
    "minLength": 5,
    "type": "string"
   },
   "valid_through": {
    "description": "Expiration date (ISO format, defaults to 30 days from now)",
    "type": "string"
   }
  },
  "required": [
   "customer_email",
   "company_name",
   "company_url",
   "title",
   "description",
   "employment_type",
   "seniority",
   "app_link_or_email"
  ],
  "type": "object"
 },
 "name": "post_job_public"
}
