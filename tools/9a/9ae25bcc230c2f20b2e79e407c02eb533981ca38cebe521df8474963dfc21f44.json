{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false,
  "title": "Create Seller Account"
 },
 "description": "Creates a seller account on Boson Protocol. Required before creating any offers. signerAddress is automatically set as admin, assistant, and treasury. Provide seller metadata and royaltyPercentage. Returns unsigned transaction data.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authTokenId": {
    "$ref": "#/properties/royaltyPercentage",
    "description": "NFT token ID used as auth token (e.g. Lens profile ID). Pass '0' if not using auth tokens."
   },
   "authTokenType": {
    "description": "Auth token type: 0=None, 1=Lens Protocol profile NFT.",
    "type": "number"
   },
   "configId": {
    "description": "Boson/Fermion Protocol deployment identifier. Format: '<env>-<chainId>-<index>' e.g. 'production-137-0' (Polygon mainnet), 'testing-80002-0' (Amoy testnet). Call get_config_ids to list all valid values for this server.",
    "type": "string"
   },
   "contactLinks": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "tag": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "tag"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "contactPreference": {
    "type": "string"
   },
   "contractUri": {
    "default": "",
    "description": "Optional URI for OpenSea-style storefront metadata (defaults to empty string, meaning none). When set, it is fetched to copy it to The Graph's IPFS node, so it must be an ipfs:// URI, a CID, or an http(s) URL returning JSON.",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "executionMode": {
    "description": "'direct' = standard on-chain tx (sign locally with your wallet \u2192 send_signed_transaction). 'metaTx' = gasless relay via Biconomy (send_meta_transaction). Defaults to 'direct'.",
    "enum": [
     "direct",
     "metaTx"
    ],
    "type": "string"
   },
   "images": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "fit": {
       "type": "string"
      },
      "height": {
       "type": "number"
      },
      "position": {
       "type": "string"
      },
      "tag": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "width": {
       "type": "number"
      }
     },
     "required": [
      "url",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "kind": {
    "type": "string"
   },
   "legalTradingName": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "royaltyPercentage": {
    "description": "Default resale royalty in basis points (0\u201310000). Applied to all offers unless overridden.",
    "type": "string"
   },
   "salesChannels": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "deployments": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "lastUpdated": {
          "type": "string"
         },
         "link": {
          "type": "string"
         },
         "product": {
          "additionalProperties": false,
          "properties": {
           "uuid": {
            "type": "string"
           },
           "version": {
            "type": "number"
           }
          },
          "type": "object"
         },
         "status": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "link": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "settingsEditor": {
       "type": "string"
      },
      "settingsUrl": {
       "type": "string"
      },
      "tag": {
       "type": "string"
      }
     },
     "required": [
      "tag"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "signerAddress": {
    "description": "Ethereum address that will sign and send this transaction. Must match the wallet that will sign the returned transaction locally.",
    "type": "string"
   },
   "socialLinks": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "tag": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "tag"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "type": {
    "type": "string"
   },
   "website": {
    "type": "string"
   }
  },
  "required": [
   "type",
   "kind",
   "contactPreference",
   "royaltyPercentage",
   "authTokenId",
   "authTokenType",
   "configId",
   "signerAddress"
  ],
  "type": "object"
 },
 "name": "create_seller"
}
