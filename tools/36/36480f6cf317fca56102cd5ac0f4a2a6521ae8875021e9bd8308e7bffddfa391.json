{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only environment, engine, workspace, and run-store diagnostics for MartinLoop. Use first for software work, fresh installs, suspicious state, or before retries. Do not use as proof that a task is complete. Next: call martin_estimate or martin_triage_runs depending on whether this is new work or failed prior work.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "engine": {
    "description": "Optional engine to highlight in diagnostics.",
    "enum": [
     "claude",
     "codex",
     "gemini",
     "openai"
    ],
    "type": "string"
   },
   "runsDir": {
    "description": "Optional runs-root override resolved under the default Martin runs root.",
    "type": "string"
   },
   "workingDirectory": {
    "description": "Optional repo-root override for doctor context.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "martin_doctor",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "engines": {
    "additionalProperties": true,
    "type": "object"
   },
   "environment": {
    "additionalProperties": false,
    "properties": {
     "liveMode": {
      "type": "boolean"
     },
     "mode": {
      "enum": [
       "live",
       "proof"
      ],
      "type": "string"
     },
     "runsRoot": {
      "type": "string"
     },
     "workingDirectory": {
      "type": "string"
     },
     "workspaceRoot": {
      "type": "string"
     }
    },
    "required": [
     "workspaceRoot",
     "workingDirectory",
     "runsRoot",
     "mode",
     "liveMode"
    ],
    "type": "object"
   },
   "receiptScope": {
    "additionalProperties": false,
    "properties": {
     "invocationRoot": {
      "type": "string"
     },
     "repoRoot": {
      "type": "string"
     },
     "runsRoot": {
      "type": "string"
     },
     "workingDirectory": {
      "type": "string"
     }
    },
    "required": [
     "invocationRoot",
     "workingDirectory",
     "repoRoot",
     "runsRoot"
    ],
    "type": "object"
   },
   "requestedEngine": {
    "type": "string"
   },
   "runStore": {
    "additionalProperties": true,
    "properties": {
     "exists": {
      "type": "boolean"
     },
     "latestRun": {
      "additionalProperties": true,
      "properties": {
       "activeAttemptId": {
        "description": "ID of the currently active attempt, when a run is in progress.",
        "type": "string"
       },
       "attempts": {
        "type": "integer"
       },
       "avoidedUsd": {
        "type": "number"
       },
       "costUsd": {
        "type": "number"
       },
       "createdAt": {
        "type": "string"
       },
       "lastAttempt": {
        "additionalProperties": true,
        "type": "object"
       },
       "lifecycleState": {
        "type": "string"
       },
       "loopId": {
        "type": "string"
       },
       "objective": {
        "type": "string"
       },
       "pressure": {
        "type": "string"
       },
       "remainingBudgetUsd": {
        "type": "number"
       },
       "remainingIterations": {
        "type": "integer"
       },
       "remainingTokens": {
        "type": "integer"
       },
       "shouldStop": {
        "type": "boolean"
       },
       "status": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "updatedAt": {
        "type": "string"
       }
      },
      "required": [
       "loopId",
       "title",
       "objective",
       "status",
       "lifecycleState",
       "attempts",
       "costUsd",
       "avoidedUsd",
       "pressure",
       "shouldStop",
       "remainingBudgetUsd",
       "remainingIterations"
      ],
      "type": "object"
     },
     "loopCount": {
      "type": "integer"
     }
    },
    "required": [
     "exists",
     "loopCount"
    ],
    "type": "object"
   },
   "server": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "nodeVersion": {
      "type": "string"
     },
     "platform": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "nodeVersion",
     "platform"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "ok",
     "degraded"
    ],
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "status",
   "summary",
   "server",
   "environment",
   "receiptScope",
   "engines",
   "runStore",
   "warnings"
  ],
  "type": "object"
 }
}
