{
 "description": "Manage exception breakpoints, list Windows exception codes, or skip exceptions",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "set",
        "type": "string"
       },
       "chance": {
        "default": "first",
        "enum": [
         "first",
         "second",
         "all"
        ],
        "type": "string"
       },
       "code": {
        "description": "Exception code (hex, e.g. C0000005)",
        "type": "string"
       }
      },
      "required": [
       "action",
       "code"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "delete",
        "type": "string"
       },
       "code": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "code"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "list",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "list_codes",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "skip",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "x64dbg_exceptions"
}
