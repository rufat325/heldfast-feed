{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Free. Fetch again, without paying, a paid answer from the last 10 minutes using the receipt.replay_token it carried. Use it when the first response was lost (timeout, disconnect) instead of paying twice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "token": {
    "description": "receipt.replay_token from a paid answer (valid 10 minutes).",
    "type": "string"
   }
  },
  "required": [
   "token"
  ],
  "type": "object"
 },
 "name": "br_replay",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attestation": {
    "additionalProperties": false,
    "description": "Ed25519 signature of this answer; verify at verify_url or with the public key at /.well-known/kyb-attestation.json.",
    "properties": {
     "algorithm": {
      "type": "string"
     },
     "key_id": {
      "type": "string"
     },
     "sha256": {
      "type": "string"
     },
     "signature": {
      "type": "string"
     },
     "signed_at": {
      "type": "string"
     },
     "verify_url": {
      "type": "string"
     }
    },
    "required": [
     "algorithm",
     "key_id",
     "sha256",
     "signed_at",
     "signature",
     "verify_url"
    ],
    "type": "object"
   },
   "cached": {
    "type": "boolean"
   },
   "generated_at": {
    "type": "string"
   },
   "receipt": {
    "additionalProperties": false,
    "description": "Re-read this answer free for 10 minutes with br_replay.",
    "properties": {
     "replay_token": {
      "type": "string"
     },
     "replay_until": {
      "type": "string"
     }
    },
    "required": [
     "replay_token",
     "replay_until"
    ],
    "type": "object"
   }
  },
  "required": [
   "generated_at",
   "cached",
   "receipt"
  ],
  "type": "object"
 }
}
