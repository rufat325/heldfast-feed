      "maximum": 2100,
      "minimum": 1950,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional model year (1950-2100), to help NHTSA when position 10 of the VIN is ambiguous.",
    "title": "Model Year"
   },
   "vin": {
    "description": "The 17-character Vehicle Identification Number, such as 1HGCM82633A004352 (letters and digits, never I, O or Q). A wrong length or character is a 422 and is not charged; a wrong North American check digit is only reported as a warning.",
