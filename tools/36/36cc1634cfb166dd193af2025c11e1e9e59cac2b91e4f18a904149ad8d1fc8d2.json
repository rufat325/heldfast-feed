 "description": "Submit an artist's application for Dynamoi music distribution after the user explicitly asks to apply and all five eligibility requirements are met. This records an application for manual review; it does not approve distribution, accept an agreement, submit a release, transfer rights, configure splits or tax forms, or deliver music to stores. All three valid ISO 3166-1 alpha-2 country or territory codes, an adult signer attestation, confirmApplicationSubmission=true, and a concise userIntentSummary are required. Country, tax, payout, sanctions, and provider-delivery checks remain manual progression gates after intake; a valid code does not imply approval. Repeated submission is idempotent for an active application.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "adultSignerAttestation": {
    "const": true,
    "type": "boolean"
   },
   "applicantCountry": {
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "artistId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "confirmApplicationSubmission": {
    "const": true,
    "type": "boolean"
   },
   "payoutCountry": {
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "taxResidencyCountry": {
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "userIntentSummary": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "adultSignerAttestation",
   "applicantCountry",
   "artistId",
   "confirmApplicationSubmission",
   "payoutCountry",
   "taxResidencyCountry",
   "userIntentSummary"
  ],
  "type": "object"
 },
