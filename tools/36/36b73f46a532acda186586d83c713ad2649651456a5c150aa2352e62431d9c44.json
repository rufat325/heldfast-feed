{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Read chain data"},"description":"Reads blocks, transactions, logs, accounts and protocol state from the layer's own index and coord RPC. For a proof use taifoon_prove. Actions: lookup \u2014 a block, transaction or receipt; logs \u2014 event logs like eth_getLogs, paged; account \u2014 every event or transaction of an address on one chain; scan \u2014 advance and read a scan job; rpc \u2014 one JSON-RPC read through the coord RPC gateway; query \u2014 one priced on-chain data query on Base (x402); transitions \u2014 a protocol's state transitions from the protocol trees; decoders \u2014 the protocols the producer decodes; bridge \u2014 the exact approve + bridge calls for a USDC transfer across chains.","inputSchema":{"additionalProperties":false,"properties":{"action":{"default":"lookup","description":"what to do (default lookup): lookup | logs | account | scan | rpc | query | transitions | decoders | bridge","enum":["lookup","logs","account","scan","rpc","query","transitions","decoders","bridge"],"examples":["lookup"],"type":"string"},"address":{"description":"address (actions: logs, account)","type":"string"},"amount":{"description":"amount (actions: bridge)","type":"string"},"api_key":{"description":"api key (actions: lookup, logs, account, scan, rpc, transitions)","type":"string"},"chain":{"description":"8453 (Base); \"base\" works too (actions: query)","type":["integer","string"]},"chain_id":{"description":"any chain the layer reads: 8453, 5042, 1, 56, 43114, 42161, 137, 10, 4663, 42220, 36927, 3692781, 2741, 196, 143, 100 (actions: lookup, logs, account, scan, rpc)","type":"integer"},"cursor":{"description":"cursor (actions: logs, account, scan)","minimum":0,"type":"integer"},"dst_chain_id":{"description":"dst chain id (actions: bridge)","type":"integer"},"from":{"description":"from (actions: logs, account)","minimum":0,"type":"integer"},"from_seq":{"description":"from seq (actions: transitions)","minimum":0,"type":"integer"},"full_proof":{"description":"add the multiproof itself (actions: lookup)","type":"boolean"},"id":{"description":"block: latest | finalized | a number | a block hash; tx and receipt: the 32-byte transaction hash (actions: lookup, scan)","type":"string"},"key":{"description":"key (actions: transitions)","type":"string"},"kind":{"description":"kind (actions: lookup)","enum":["block","tx","receipt"],"type":"string"},"limit":{"description":"limit (actions: logs, account, scan, transitions)","maximum":1000,"minimum":1,"type":"integer"},"method":{"description":"method (actions: rpc)","enum":["eth_blockNumber","eth_call","eth_getLogs","eth_getBlockByNumber","eth_getBlockByHash","eth_getTransactionByHash","eth_getTransactionReceipt","eth_getBlockReceipts","eth_getTransactionByBlockNumberAndIndex","eth_getBlockTransactionCountByNumber","eth_getBlockTransactionCountByHash","eth_getBalance","eth_getCode","eth_getTransactionCount","eth_getStorageAt","eth_estimateGas","eth_gasPrice","eth_maxPriorityFeePerGas","eth_feeHistory","eth_blobBaseFee","eth_syncing","eth_chainId","net_version","net_listening","web3_clientVersion","taifoon_getProof"],"type":"string"},"params":{"description":"params (actions: rpc, query)","items":{},"type":"array"},"payment":{"description":"optional: the x402 PAYMENT-SIGNATURE header value (base64) for the terms an unpaid call returns (actions: query)","type":"string"},"protocol":{"description":"protocol (actions: transitions)","type":"string"},"question":{"description":"question (actions: query)","enum":["pool_tokens","block_hash"],"type":"string"},"recipient":{"description":"recipient (actions: bridge)","type":"string"},"sender":{"description":"sender (actions: bridge)","type":"string"},"speed":{"description":"speed (actions: bridge)","enum":["standard","fast"],"type":"string"},"src_chain_id":{"description":"src chain id (actions: bridge)","type":"integer"},"to":{"description":"to (actions: logs, account)","minimum":0,"type":"integer"},"topic0":{"description":"topic0 (actions: logs)","type":"string"},"topic1":{"description":"topic1 (actions: logs)","type":"string"},"topic2":{"description":"topic2 (actions: logs)","type":"string"},"topic3":{"description":"topic3 (actions: logs)","type":"string"},"txs":{"description":"block: add the transaction hashes (actions: lookup)","type":"boolean"},"view":{"description":"view (actions: account)","enum":["events","txs"],"type":"string"}},"type":"object"},"name":"taifoon_chain","title":"Read chain data"}
