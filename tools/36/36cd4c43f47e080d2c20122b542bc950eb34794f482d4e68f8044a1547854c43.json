{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"\ud504\ub85c\uc81d\ud2b8\uc5d0 CI \uc124\uc815\uc744 \uc0dd\uc131\ud569\ub2c8\ub2e4 \u2014 platform=github(.github/workflows/egovframe-ci.yml, \uae30\ubcf8)\u00b7gitlab(.gitlab-ci.yml)\u00b7jenkins(Jenkinsfile, Declarative). \ube4c\ub4dc\ub3c4\uad6c(maven/gradle) \uc790\ub3d9 \uac10\uc9c0, JDK \uc9c0\uc815, \ube4c\ub4dc\u00b7\ud14c\uc2a4\ud2b8(GitLab \uc740 JUnit \ub9ac\ud3ec\ud2b8). supplyChain=true \uba74 \uc774 \uc11c\ubc84\uc758 CLI(npx egovframe-scaffold-mcp)\ub85c SBOM \uc0dd\uc131 \u2192 \ucd5c\uc18c \uc694\uc18c 7\uc885 \uc810\uac80(sbom-check --fail-on minimum) \u2192 \uc804\ud658 \uc900\ube44\ub3c4 \ud3c9\uac00\uc11c(failOn \uae30\uc900, \uae30\ubcf8 supplyChain:D)\ub97c \ub3cc\ub824 \uae30\uc900\uc744 \ub118\uc73c\uba74 \uc2e4\ud328\ud558\uace0 \ubcf4\uace0\uc11c\u00b7SBOM \uc744 \uc544\ud2f0\ud329\ud2b8\ub85c \ub0a8\uae30\ub294 \uacf5\uae09\ub9dd \uac8c\uc774\ud2b8\ub97c \ucd94\uac00\ud569\ub2c8\ub2e4(GitHub \uc740 PR \uc694\uc57d\uc5d0 \ub4f1\uae09, GitLab \uc740 CycloneDX \ub9ac\ud3ec\ud2b8). npmRegistry(\uc0ac\ub0b4 npm \ub808\uc9c0\uc2a4\ud2b8\ub9ac)\u00b7offlineBundle(\ub7ec\ub108\uc5d0\uc11c \ubcf8 \uc624\ud504\ub77c\uc778 \ubc88\ub4e4 \uacbd\ub85c)\uc740 \ud658\uacbd \ubcc0\uc218\ub85c \ub123\uc2b5\ub2c8\ub2e4. dryRun\uc73c\ub85c \ub0b4\uc6a9\ub9cc \ubbf8\ub9ac\ubcfc \uc218 \uc788\uace0, \uc2e4\uc81c \uc0dd\uc131 \uc2dc \uae30\uc874 \ud30c\uc77c\uc774 \uc788\uc73c\uba74 \ub36e\uc5b4\uc4f0\uc9c0 \uc54a\uace0 \uac70\ubd80\ud569\ub2c8\ub2e4.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"dryRun":{"default":false,"description":"true\uba74 \ud30c\uc77c \uc0dd\uc131 \uc5c6\uc774 \ub0b4\uc6a9\ub9cc \ubc18\ud658","type":"boolean"},"failOn":{"default":"supplyChain:D","description":"\uacf5\uae09\ub9dd \uac8c\uc774\ud2b8(\ud3c9\uac00\uc11c)\uc758 --fail-on \uc2dd","pattern":"^(?:(?:migration|supplyChain):[ABCD]|[A-Za-z]+(?:>=?\\d+)?)(?:,(?:(?:migration|supplyChain):[ABCD]|[A-Za-z]+(?:>=?\\d+)?))*$","type":"string"},"jdk":{"default":"17","description":"JDK \ubc84\uc804 (\uae30\ubcf8 17, \uc22b\uc790\u00b7\uc810\ub9cc \ud5c8\uc6a9)","pattern":"^[0-9]{1,2}(\\.[0-9]{1,3}){0,2}$","type":"string"},"npmRegistry":{"description":"\uc0ac\ub0b4 npm \ub808\uc9c0\uc2a4\ud2b8\ub9ac URL(NPM_CONFIG_REGISTRY \ub85c \uc124\uc815 \u2014 npx \uac00 \uc774 \uc11c\ubc84\ub97c \ubc1b\ub294 \uacf3)","pattern":"^https?:\\/\\/[A-Za-z0-9.\\-]+(?::\\d{1,5})?(?:\\/[A-Za-z0-9._~%\\-\\/]*)?$","type":"string"},"offlineBundle":{"description":"\ud3d0\uc1c4\ub9dd \ub7ec\ub108\u00b7\uc5d0\uc774\uc804\ud2b8\uc5d0\uc11c \ubcf8 \uc624\ud504\ub77c\uc778 \ubc88\ub4e4 \uacbd\ub85c(EGOVFRAME_OFFLINE_BUNDLE \ub85c \uc124\uc815)","pattern":"^(?:\\/|[A-Za-z]:[\\\\/])[A-Za-z0-9_.\\/\\\\: -]{0,250}$","type":"string"},"osv":{"default":true,"description":"\uacf5\uae09\ub9dd \uac8c\uc774\ud2b8\uc5d0\uc11c OSV \ucde8\uc57d\uc810 \uc870\ud68c(--offline=false)","type":"boolean"},"platform":{"default":"github","description":"CI \ud50c\ub7ab\ud3fc: github(GitHub Actions, \uae30\ubcf8) | gitlab(.gitlab-ci.yml) | jenkins(Jenkinsfile, Declarative)","enum":["github","gitlab","jenkins"],"type":"string"},"projectDir":{"description":"\ud504\ub85c\uc81d\ud2b8 \ub514\ub809\ud130\ub9ac(\uc808\ub300\uacbd\ub85c \uad8c\uc7a5)","type":"string"},"secureCoding":{"default":false,"description":"v0.44: \uac8c\uc774\ud2b8\uc5d0 \ubcf4\uc548\uc57d\uc810 \uc810\uac80 \ub2e8\uacc4 \ucd94\uac00(secure --fail-on high, SARIF \ub97c GitHub code scanning \uc5d0 \uc5c5\ub85c\ub4dc\u00b7GitLab\u00b7Jenkins \ub294 \ubcf4\uad00)","type":"boolean"},"supplier":{"description":"SBOM \uacf5\uae09\uc790(pom <organization><name> \uc774 \uc5c6\uc73c\uba74 \ucd5c\uc18c \uc694\uc18c '\uacf5\uae09\uc790'\uac00 \ube60\uc838 \uac8c\uc774\ud2b8\uac00 \uc2e4\ud328\ud558\ubbc0\ub85c \uc9c0\uc815)","pattern":"^[\\p{L}\\p{N}][\\p{L}\\p{N} .,&()_-]{0,99}$","type":"string"},"supplyChain":{"default":false,"description":"true \uba74 \uacf5\uae09\ub9dd \uac8c\uc774\ud2b8 \ucd94\uac00: SBOM \uc0dd\uc131 \u2192 \ucd5c\uc18c \uc694\uc18c \uc810\uac80(--fail-on minimum) \u2192 \uc804\ud658 \uc900\ube44\ub3c4 \ud3c9\uac00\uc11c(failOn) \u2192 \uc544\ud2f0\ud329\ud2b8","type":"boolean"}},"required":["projectDir"],"type":"object"},"name":"generate_egovframe_ci","title":"CI \uc6cc\ud06c\ud50c\ub85c \uc0dd\uc131"}
