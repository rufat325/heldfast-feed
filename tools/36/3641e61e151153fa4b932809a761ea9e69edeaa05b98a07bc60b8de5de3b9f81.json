{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Check a CV"},"description":"Grade a CV (cv, curriculum vitae, r\u00e9sum\u00e9) for the Dutch job market: 0-100 score plus a 1-10 grade, the three fixes to make first with the exact lines they refer to, and ATS readability. Use when the user asks 'is my CV good', 'check my CV', 'beoordeel mijn cv' or pastes a CV. Free, no AI, nothing stored. Remove BSN, ID and bank numbers first. The result includes nextStep, a suggested follow-up (usually open_in_editor).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"cv_text":{"description":"The full text of the CV (200-25,000 characters). Remove BSN, ID and bank numbers first.","maxLength":25000,"minLength":200,"type":"string"},"locale":{"description":"Language of the CV and the answer. Detected from the text when omitted.","enum":["nl","en"],"type":"string"}},"required":["cv_text"],"type":"object"},"name":"check_cv","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"band":{"enum":["sterk","goed","in_ontwikkeling","zwak"],"type":"string"},"bandLabel":{"type":"string"},"canOpenInEditor":{"type":"boolean"},"categories":{"items":{"additionalProperties":false,"properties":{"id":{"enum":["content","ats","basics","dutch_conventions"],"type":"string"},"label":{"type":"string"},"score":{"maximum":100,"minimum":0,"type":"integer"},"weight":{"maximum":1,"minimum":0,"type":"number"}},"required":["id","label","score","weight"],"type":"object"},"maxItems":4,"minItems":4,"type":"array"},"criticalIssues":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"grade10":{"description":"score / 10, one decimal, floor 1. The MCP grade; the website's CV check uses its own scale and can differ.","maximum":10,"minimum":1,"type":"number"},"limitations":{"type":"string"},"meta":{"additionalProperties":false,"properties":{"locale":{"en