{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search for objects by specified criteria",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "artboard_index": {
    "description": "Artboard index (0-based integer)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "coordinate_system": {
    "description": "Coordinate system. Auto-detected from document by default (CMYK/print \u2192 document, RGB/web \u2192 artboard-web). artboard-web: origin at active artboard top-left, Y-down. document: Illustrator native coords, origin at bottom-left, Y-up. Call get_document_info to check which system is active.",
    "enum": [
     "artboard-web",
     "document"
    ],
    "type": "string"
   },
   "fill_color": {
    "description": "Search paths and compound paths (matched by their inner paths) by fill color. Tolerance defaults to 5 per channel (0-255 for RGB, 0-100 for CMYK). Set tolerance: 0 for exact match.",
    "properties": {
     "b": {
      "type": "number"
     },
     "c": {
      "type": "number"
     },
     "g": {
      "type": "number"
     },
     "k": {
      "type": "number"
     },
     "m": {
      "type": "number"
     },
     "r": {
      "type": "number"
     },
     "tolerance": {
      "type": "number"
     },
     "type": {
      "enum": [
       "cmyk",
       "rgb"
      ],
      "type": "string"
     },
     "y": {
      "type": "number"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   },
   "font_name": {
    "description": "Font name (partial match)",
    "type": "string"
   },
   "font_size": {
    "description": "Font size range",
    "properties": {
     "max": {
      "type": "number"
     },
     "min": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "layer_name": {
    "description": "Layer name",
    "type": "string"
   },
   "name": {
    "description": "Object name (partial match)",
    "type": "string"
   },
   "stroke_color": {
    "description": "Search paths and compound paths (matched by their inner paths) by stroke color. Tolerance defaults to 5 per channel (0-255 for RGB, 0-100 for CMYK). Set tolerance: 0 for exact match.",
    "properties": {
     "b": {
      "type": "number"
     },
     "c": {
      "type": "number"
     },
     "g": {
      "type": "number"
     },
     "k": {
      "type": "number"
     },
     "m": {
      "type": "number"
     },
     "r": {
      "type": "number"
     },
     "tolerance": {
      "type": "number"
     },
     "type": {
      "enum": [
       "cmyk",
       "rgb"
      ],
      "type": "string"
     },
     "y": {
      "type": "number"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   },
   "type": {
    "description": "Object type",
    "enum": [
     "text",
     "path",
     "image",
     "group",
     "compound-path",
     "symbol"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_objects",
 "title": "Find Objects"
}
