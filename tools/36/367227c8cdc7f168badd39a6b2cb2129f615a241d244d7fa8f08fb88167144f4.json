{
 "description": "Generate images from text prompts using Ideogram V3. Supports multiple aspect ratios, style types, and quality levels.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aspect_ratio": {
    "description": "Output aspect ratio (default: 1x1)",
    "enum": [
     "1x1",
     "16x9",
     "9x16",
     "4x3",
     "3x4",
     "3x2",
     "2x3",
     "4x5",
     "5x4",
     "1x2",
     "2x1",
     "1x3",
     "3x1",
     "10x16",
     "16x10"
    ],
    "type": "string"
   },
   "magic_prompt": {
    "description": "Auto-enhance prompts (default: AUTO)",
    "enum": [
     "AUTO",
     "ON",
     "OFF"
    ],
    "type": "string"
   },
   "negative_prompt": {
    "description": "What to exclude from the generated image",
    "type": "string"
   },
   "num_images": {
    "description": "Number of images to generate (1-8, default: 1)",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "prompt": {
    "description": "Image description (1-10,000 characters)",
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
   "rendering_speed": {
    "description": "Speed/quality tradeoff. FLASH=fastest, QUALITY=best (default: DEFAULT)",
    "enum": [
     "FLASH",
     "TURBO",
     "DEFAULT",
     "QUALITY"
    ],
    "type": "string"
   },
   "seed": {
    "description": "Reproducibility seed (0-2,147,483,647)",
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   },
   "style_type": {
    "description": "Visual style (default: AUTO)",
    "enum": [
     "AUTO",
     "GENERAL",
     "REALISTIC",
     "DESIGN",
     "FICTION"
    ],
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "ideogram_generate"
}
