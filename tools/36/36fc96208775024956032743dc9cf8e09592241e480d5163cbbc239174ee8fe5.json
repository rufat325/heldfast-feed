{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Apply layout controls (paragraph spacing, table row height, cell padding). Google Docs supports paragraph spacing only. Surface: revisionable \u2014 DOCX geometry edits emit native property-change revisions (w:pPrChange/w:trPrChange/w:tcPrChange).",
 "emitsNonRevisionChanges": false,
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cell_padding": {
    "additionalProperties": false,
    "properties": {
     "bottom_dxa": {
      "type": "number"
     },
     "cell_indexes": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "left_dxa": {
      "type": "number"
     },
     "right_dxa": {
      "type": "number"
     },
     "row_indexes": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "table_indexes": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "top_dxa": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "file_path": {
    "description": "Path to the DOCX or ODT file.",
    "type": "string"
   },
   "google_doc_id": {
    "description": "Google Doc ID or URL (alternative to file_path). Extract from URL: docs.google.com/document/d/{ID}/edit",
    "type": "string"
   },
   "paragraph_spacing": {
    "additionalProperties": false,
    "properties": {
     "after_twips": {
      "type": "number"
     },
     "before_twips": {
      "type": "number"
     },
     "line_rule": {
      "enum": [
       "auto",
       "exact",
       "atLeast"
      ],
      "type": "string"
     },
     "line_twips": {
      "type": "number"
     },
     "paragraph_ids": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "row_height": {
    "additionalProperties": false,
    "properties": {
     "row_indexes": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "rule": {
      "enum": [
       "auto",
       "exact",
       "atLeast"
      ],
      "type": "string"
     },
     "table_indexes": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "value_twips": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "strict": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "format_layout",
 "surface": "revisionable"
}
