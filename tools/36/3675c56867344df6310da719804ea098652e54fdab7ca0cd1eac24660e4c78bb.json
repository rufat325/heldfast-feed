{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks what models a given machine can run. Needs a hardware id from search_catalog. Returns up to 20 catalogue models ranked for that machine, each with a fit verdict and a speed range, optionally filtered to one use such as coding. It covers only models in the catalogue, at one quantisation and context length per call, and leaves out models that do not fit.",
 "inputSchema": {
  "properties": {
   "context_length": {
    "default": 4096,
    "description": "Context window in tokens that the KV cache is sized for. 512 to 262144. Default 4096.",
    "maximum": 262144,
    "minimum": 512,
    "type": "integer"
   },
   "hardware_id": {
    "description": "Hardware id from search_catalog.",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-z0-9][a-z0-9._-]*$",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum models, 1 to 20. Default 10.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "quantisation": {
    "default": "Q4_K_M",
    "description": "Weight quantisation. One of Q2_K, Q3_K_M, Q4_K_M, Q5_K_M, Q6_K, Q8_0, F16. Default Q4_K_M.",
    "enum": [
     "Q2_K",
     "Q3_K_M",
     "Q4_K_M",
     "Q5_K_M",
     "Q6_K",
     "Q8_0",
     "F16"
    ],
    "type": "string"
   },
   "use_case": {
    "description": "Only list models tagged for this use. One of coding, chat, reasoning, agents, vision. Omit for all models.",
    "enum": [
     "coding",
     "chat",
     "reasoning",
     "agents",
     "vision"
    ],
    "type": "string"
   }
  },
  "required": [
   "hardware_id"
  ],
  "type": "object"
 },
 "name": "models_for_hardware",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "context_length": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "data_as_of": {
    "description": "Date the bundled catalogue was last updated. Not the time of this call.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "hardware": {
    "additionalProperties": false,
    "properties": {
     "bandwidth_gb_s": {
      "description": "Theoretical peak memory bandwidth.",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
     },
     "memory_gb": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "memory_kind": {
      "enum": [
       "dedicated",
       "unified",
       "shared-system"
      ],
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "type": "string"
     },
     "status": {
      "description": "announced means not yet on sale; eol means no longer made.",
      "enum": [
       "current",
       "eol",
       "used-market",
       "announced"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "memory_gb",
     "memory_kind",
     "bandwidth_gb_s",
     "status"
    ],
    "type": "object"
   },
   "models": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "model_id": {
       "maxLength": 80,
       "minLength": 1,
       "pattern": "^[a-z0-9][a-z0-9._-]*$",
       "type": "string"
      },
      "name": {
       "maxLength": 120,
       "type": "string"
      },
      "needed_gb": {
       "minimum": 0,
       "type": "number"
      },
      "rank": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "speed": {
       "anyOf": [
        {
         "additionalProperties": false,
         "description": "Decode speed in tokens per second, always a range with a confidence label.",
         "properties": {
          "basis": {
           "anyOf": [
            {
             "maxLength": 200,
             "type": "string"
            },
            {
             "type": "null"
            }
           ],
           "description": "Where the figure comes from, e.g. a benchmark label. null for a modelled estimate."
          },
          "confidence": {
           "enum": [
            "measured",
            "estimated",
            "community"
           ],
           "type": "string"
          },
          "high_tok_s": {
           "minimum": 0,
           "type": "number"
          },
          "last_verified": {
           "anyOf": [
            {
             "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "low_tok_s": {
           "minimum": 0,
           "type": "number"
          },
          "sample_count": {
           "anyOf": [
            {
             "exclusiveMinimum": 0,
             "maximum": 9007199254740991,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ],
           "description": "Number of measured runs behind a measured or community figure."
          }
         },
         "required": [
          "low_tok_s",
          "high_tok_s",
          "confidence",
          "basis",
          "sample_count",
          "last_verified"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "pattern": "^https:\\/\\/llmconfigurator\\.com\\/en\\/",
       "type": "string"
      },
      "verdict": {
       "enum": [
        "fits_comfortably",
        "fits_tight",
        "needs_offload",
        "does_not_fit"
       ],
       "type": "string"
      }
     },
     "required": [
      "rank",
      "model_id",
      "name",
      "verdict",
      "needed_gb",
      "speed",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "quantisation": {
    "enum": [
     "Q2_K",
     "Q3_K_M",
     "Q4_K_M",
     "Q5_K_M",
     "Q6_K",
     "Q8_0",
     "F16"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One or two plain-language sentences stating the answer.",
    "maxLength": 600,
    "type": "string"
   },
   "url": {
    "pattern": "^https:\\/\\/llmconfigurator\\.com\\/en\\/",
    "type": "string"
   },
   "use_case": {
    "anyOf": [
     {
      "enum": [
       "coding",
       "chat",
       "reasoning",
       "agents",
       "vision"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "The use-case filter applied, or null."
   }
  },
  "required": [
   "data_as_of",
   "summary",
   "quantisation",
   "context_length",
   "use_case",
   "hardware",
   "models",
   "url"
  ],
  "type": "object"
 },
 "title": "List models a machine can run"
}
