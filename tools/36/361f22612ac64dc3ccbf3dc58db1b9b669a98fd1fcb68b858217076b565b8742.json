    "type": "string"
   },
   "target": {
    "description": "Long URL to shorten. Must be a complete http:// or https:// URL (e.g. 'https://example.com/page'). A bare domain like 'example.com' is rejected.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "infomaniak_create_short_url",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "target": {
        "type": "string"
       }
      },
      "required": [
       "target"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "message": {
      "type": "string"
     },
     "short_url": {},
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
