{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read a saved config review and its accepted receipt without returning secret values. Accepted means queued, not applied or healthy. Requires unrestricted account credentials and read scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "config_plan_id": {
    "pattern": "^cplan_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "required": [
   "config_plan_id"
  ],
  "type": "object"
 },
 "name": "impreza_get_config_plan",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "changes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "deployment_id": {
      "type": "string"
     },
     "diff_text": {
      "type": "string"
     },
     "expires_at": {
      "type": "string"
     },
     "may_interrupt_traffic": {
      "type": "boolean"
     },
     "name": {
      "type": "string"
     },
     "no_changes": {
      "type": "boolean"
     },
     "operation": {
      "type": "string"
     },
     "plan_id": {
      "type": "string"
     },
     "preserves_data": {
      "type": "boolean"
     },
     "receipt": {
      "type": [
       "object",
       "null"
      ]
     },
     "review_digest": {
      "type": "string"
     },
     "secrets": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "plan_id",
     "review_digest",
     "expires_at",
     "status",
     "receipt",
     "operation",
     "deployment_id",
     "name",
     "changes",
     "diff_text",
     "no_changes",
     "secrets",
     "may_interrupt_traffic",
     "preserves_data"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Read config review"
}
