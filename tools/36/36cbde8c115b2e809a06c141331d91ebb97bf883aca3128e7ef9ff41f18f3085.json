        "docx",
        "txt",
        "md"
       ],
       "type": "string"
      },
      "name": {
       "description": "File name",
       "type": "string"
      }
     },
     "required": [
      "name",
      "content",
      "fileType"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "files"
  ],
  "type": "object"
 },
 "name": "batch_parse_resumes"
