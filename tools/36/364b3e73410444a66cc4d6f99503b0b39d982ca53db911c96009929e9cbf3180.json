{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":true,"title":"Sign Screenshot URL"},"description":"Generate a signed URL for a screenshot that can be used without an API key. Useful for embedding screenshots in emails, documents, or sharing with third parties. Signing is free, rendering the URL consumes one credit. URLs expire after the specified duration.","inputSchema":{"properties":{"block_ads":{"description":"Block ads (default: true)","type":"boolean"},"block_cookie_banners":{"description":"Remove cookie banners (default: true)","type":"boolean"},"click_selector":{"description":"CSS selector to click","type":"string"},"dark_mode":{"description":"Enable dark mode (default: false)","type":"boolean"},"delay":{"description":"Milliseconds to wait after load (default: 0)","maximum":10000,"minimum":0,"type":"integer"},"device":{"description":"Device preset for emulation","enum":["iphone_14","iphone_15_pro","pixel_7","ipad_pro","macbook_pro"],"type":"string"},"expires_in":{"description":"URL validity in seconds, 60-2592000 (default: 86400 = 1 day)","maximum":2592000,"minimum":60,"type":"integer"},"format":{"description":"Output format (default: png)","enum":["png","jpeg","webp","pdf"],"type":"string"},"full_page":{"description":"Capture entire scrollable page (default: false)","type":"boolean"},"height":{"description":"Viewport height in pixels (default: 800)","maximum":10000,"minimum":200,"type":"integer"},"hide_selectors":{"description":"CSS selectors to hide","type":"string"},"lazy_load":{"description":"For full-page captures: scroll through the page first so lazy-loaded images below the first screen appear (default: false). Slower, usually 1-5 seconds more. Ignored unless full_page is true. Some sites can still differ.","type":"boolean"},"quality":{"description":"Image quality (default: 90)","maximum":100,"minimum":1,"type":"integer"},"url":{"description":"URL to capture (must start with http:// or https://)","type":"string"},"user_agent":{"description":"Custom user agent","type":"string"},"width":{"description":"Viewport width in pixels (default: 1280)","maximum":3840,"minimum":320,"type":"integer"}},"required":["url"],"type":"object"},"name":"sign_screenshot_url"}
