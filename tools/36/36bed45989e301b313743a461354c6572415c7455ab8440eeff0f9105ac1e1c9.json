{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Update a saved filter. \"filter\"/\"query\" fully replace the previous conditions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "fields": {
    "description": "Issue fields shown as columns",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filter": {
    "additionalProperties": {},
    "description": "Conditions by field, e.g. {\"queue\": \"TREK\", \"status\": \"open\"} (replaces fully)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "filterId": {
    "type": "number"
   },
   "folder": {
    "description": "Folder id to place the filter into",
    "type": "string"
   },
   "groupBy": {
    "description": "Grouping field",
    "type": "string"
   },
   "name": {
    "description": "Filter name",
    "type": "string"
   },
   "query": {
    "description": "Query language condition (mutually exclusive with filter)",
    "type": "string"
   },
   "sorts": {
    "description": "Sort order",
    "items": {
     "properties": {
      "field": {
       "type": "string"
      },
      "isAscending": {
       "type": "boolean"
      }
     },
     "required": [
      "field",
      "isAscending"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "filterId"
  ],
  "type": "object"
 },
 "name": "update_filter"
}
