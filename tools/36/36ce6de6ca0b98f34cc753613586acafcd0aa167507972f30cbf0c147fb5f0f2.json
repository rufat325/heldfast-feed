{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new SourcePipeline pipeline with tasks and optional triggers",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Pipeline description",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns preview without creating",
    "type": "boolean"
   },
   "name": {
    "description": "Pipeline name (1-30 chars, alphanumeric + '-' and '_')",
    "type": "string"
   },
   "tasks": {
    "description": "Task list (at least one task required)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "config": {
       "additionalProperties": false,
       "properties": {
        "projectId": {
         "description": "Project ID (SourceBuild or SourceDeploy project)",
         "type": "number"
        },
        "scenarioId": {
         "description": "Deploy scenario ID (required if type is SourceDeploy)",
         "type": "number"
        },
        "stageId": {
         "description": "Deploy stage ID (required if type is SourceDeploy)",
         "type": "number"
        },
        "target": {
         "additionalProperties": false,
         "properties": {
          "info": {
           "additionalProperties": false,
           "properties": {
            "branch": {
             "description": "Branch name (for SourceBuild tasks)",
             "type": "string"
            }
           },
           "type": "object"
          }
         },
         "type": "object"
        }
       },
       "required": [
        "projectId"
       ],
       "type": "object"
      },
      "linkedTasks": {
       "description": "Preceding task names (empty array [] if none)",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "description": "Task name (1-50 chars, alphanumeric + '-' and '_')",
       "type": "string"
      },
      "type": {
       "description": "Task type",
       "enum": [
        "SourceBuild",
        "SourceDeploy"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "type",
      "config",
      "linkedTasks"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "trigger": {
    "additionalProperties": false,
    "description": "Trigger configuration",
    "properties": {
     "repository": {
      "description": "Push trigger settings",
      "items": {
       "additionalProperties": false,
       "properties": {
        "branch": {
         "description": "Branch name",
         "type": "string"
        },
        "name": {
         "description": "Repository name",
         "type": "string"
        },
        "type": {
         "description": "Repository type (sourcecommit)",
         "type": "string"
        }
       },
       "required": [
        "type",
        "name",
        "branch"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "schedule": {
      "description": "Schedule trigger settings",
      "items": {
       "additionalProperties": false,
       "properties": {
        "day": {
         "description": "Days of week (MON|TUE|WED|THU|FRI|SAT|SUN)",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "scheduleOnlyWithChange": {
         "description": "Run only when source changed (true/false)",
         "type": "boolean"
        },
        "time": {
         "description": "Execution time in HH:mm format (24h)",
         "type": "string"
        },
        "timeZone": {
         "description": "Timezone (from ncloud_get_pipeline_timezones)",
         "type": "string"
        }
       },
       "required": [
        "day",
        "time",
        "timeZone",
        "scheduleOnlyWithChange"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "sourcepipeline": {
      "description": "Pipeline trigger settings",
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "description": "Pipeline ID to trigger from",
         "type": "number"
        }
       },
       "required": [
        "id"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "name",
   "tasks"
  ],
  "type": "object"
 },
 "name": "ncloud_create_pipeline"
}
