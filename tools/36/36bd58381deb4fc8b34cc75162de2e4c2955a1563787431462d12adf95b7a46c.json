{
 "description": "List support tickets, optionally filtered by customer or status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customer_id": {
    "description": "Customer ID for filtering (requires customer_type)",
    "type": "string"
   },
   "customer_type": {
    "description": "Customer type for filtering",
    "enum": [
     "contact",
     "company"
    ],
    "type": "string"
   },
   "page": {
    "type": "number"
   },
   "page_size": {
    "description": "max 100",
    "type": "number"
   },
   "ticket_status_id": {
    "description": "Filter by ticket status ID",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "teamleader_tickets_list"
}
