{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List a directory in a server's file system (jailed to that server). Use \"/\" for the root; then read_file/write_file to inspect or edit configs.",
 "inputSchema": {
  "properties": {
   "path": {
    "description": "Directory path, e.g. \"/\", \"/plugins\", \"/config\".",
    "type": "string"
   },
   "server": {
    "description": "The server id (server_...) from list_servers.",
    "type": "string"
   }
  },
  "required": [
   "server"
  ],
  "type": "object"
 },
 "name": "list_files",
 "outputSchema": {
  "properties": {
   "entries": {
    "items": {
     "properties": {
      "directory": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "size": {
       "description": "Bytes; 0 for directories.",
       "type": "integer"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 },
 "title": "List Server Files"
}
