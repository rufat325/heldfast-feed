{
 "description": "Update an existing form's name, slug, status, fields or settings (partial). Only call after the user describes the change and confirms.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "type": "string"
   },
   "fields": {
    "description": "Replacement fields array",
    "items": {
     "properties": {
      "defaultValue": {
       "type": "string"
      },
      "fieldType": {
       "enum": [
        "text",
        "email",
        "password",
        "textarea",
        "number",
        "phone",
        "url",
        "date",
        "datetime",
        "select",
        "multiselect",
        "boolean",
        "radio",
        "file",
        "hidden"
       ],
       "type": "string"
      },
      "helpText": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "label": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "name": {
       "type": "string"
      },
      "options": {
       "items": {
        "properties": {
         "disabled": {
          "type": "boolean"
         },
         "label": {
          "additionalProperties": {
           "type": "string"
          },
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         },
         "value": {
          "type": "string"
         }
        },
        "required": [
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "order": {
       "type": "number"
      },
      "placeholder": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "requiredWhen": {
       "additionalProperties": false,
       "description": "Require the field only while this condition group holds",
       "properties": {
        "conditions": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "equals": {},
           "field": {
            "description": "The name of the field to test",
            "minLength": 1,
            "type": "string"
           },
           "isEmpty": {
            "type": "boolean"
           },
           "notEmpty": {
            "type": "boolean"
           },
           "notEquals": {}
          },
          "required": [
           "field"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "logic": {
         "description": "all = every condition must hold, any = one is enough",
         "enum": [
          "all",
          "any"
         ],
         "type": "string"
        }
       },
       "required": [
        "logic",
        "conditions"
       ],
       "type": "object"
      },
      "showWhen": {
       "additionalProperties": false,
       "description": "Show the field only while this condition group holds",
       "properties": {
        "conditions": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "equals": {},
           "field": {
            "description": "The name of the field to test",
            "minLength": 1,
            "type": "string"
           },
           "isEmpty": {
            "type": "boolean"
           },
           "notEmpty": {
            "type": "boolean"
           },
           "notEquals": {}
          },
          "required": [
           "field"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "logic": {
         "description": "all = every condition must hold, any = one is enough",
         "enum": [
          "all",
          "any"
         ],
         "type": "string"
        }
       },
       "required": [
        "logic",
        "conditions"
       ],
       "type": "object"
      },
      "validation": {
       "properties": {
        "customMessage": {
         "type": "string"
        },
        "maxLength": {
         "type": "number"
        },
        "maxValue": {
         "type": "number"
        },
        "minLength": {
         "type": "number"
        },
        "minValue": {
         "type": "number"
        },
        "pattern": {
         "type": "string"
        },
        "required": {
         "type": "boolean"
        }
       },
       "type": "object"
      },
      "width": {
       "enum": [
        "full",
        "half",
        "third"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "idOrSlug": {
    "description": "The form's id or slug to update",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "settings": {
    "properties": {
     "actionType": {
      "enum": [
       "contact",
       "custom"
      ],
      "type": "string"
     },
     "emailConfigurationId": {
      "type": "string"
     },
     "emailRecipients": {
      "items": {
       "format": "email",
       "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
       "type": "string"
      },
      "type": "array"
     },
     "errorMessage": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "redirectUrl": {
      "type": "string"
     },
     "requireLogin": {
      "type": "boolean"
     },
     "saveSubmissions": {
      "type": "boolean"
     },
     "sendEmailNotification": {
      "type": "boolean"
     },
     "submitButtonLabel": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "successMessage": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "webhookUrl": {
      "format": "uri",
      "type": "string"
     }
    },
    "type": "object"
   },
   "slug": {
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "published",
     "archived"
    ],
    "type": "string"
   }
  },
  "required": [
   "idOrSlug"
  ],
  "type": "object"
 },
 "name": "update_form"
}
