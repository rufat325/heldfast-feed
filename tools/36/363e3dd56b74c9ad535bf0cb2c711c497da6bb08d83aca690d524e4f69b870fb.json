{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compare travel advisories. Use this when the user wants the advice for several countries side by side, such as \"compare Mexico, Colombia and Peru\" or \"which of these countries has the highest advisory level?\". Pass one to five country names or ISO codes. Returns for each the UK FCDO alert and review date and the US State Department level and update date, with official links. Use get_travel_advice for the full text of one country. UK advice is for British citizens and US advice for US citizens.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "countries": {
    "description": "Country names or two-letter ISO codes, up to 5",
    "items": {
     "maxLength": 80,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "countries"
  ],
  "type": "object"
 },
 "name": "compare_advisories",
 "outputSchema": {
  "properties": {
   "citizenship": {
    "type": "string"
   },
   "countries": {
    "items": {
     "properties": {
      "candidates": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "country": {
       "type": "string"
      },
      "query": {
       "type": "string"
      },
      "status": {
       "enum": [
        "ok",
        "not_found",
        "ambiguous",
        "unavailable"
       ],
       "type": "string"
      },
      "uk": {
       "properties": {
        "alertText": {
         "type": "string"
        },
        "reviewedAt": {
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "status"
       ],
       "type": "object"
      },
      "us": {
       "properties": {
        "level": {
         "type": [
          "integer",
          "null"
         ]
        },
        "levelText": {
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "type": "string"
        },
        "updated": {
         "type": [
          "string",
          "null"
         ]
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "status"
       ],
       "type": "object"
      }
     },
     "required": [
      "query",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "license": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "sources": {
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "ok",
     "unavailable"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "countries",
   "citizenship",
   "sources",
   "license",
   "notice"
  ],
  "type": "object"
 },
 "title": "Compare travel advisories"
}
