     }
    },
    "required": [
     "action",
     "token",
     "agent_key",
     "body"
    ]
   },
   {
    "properties": {
     "action": {
      "const": "watch_read"
     }
    },
    "required": [
     "action",
     "token",
     "agent_key"
    ]
   },
   {
    "properties": {
     "action": {
      "const": "watch_update"
     }
    },
    "required": [
     "action",
     "token",
     "agent_key",
     "body"
    ]
   },
   {
    "properties": {
     "action": {
      "const": "renewal_draft"
     }
