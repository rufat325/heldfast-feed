     "action": {
      "const": "read"
     }
    },
    "required": [
     "action",
     "token"
    ]
   },
   {
    "properties": {
     "action": {
      "const": "recheck"
     }
    },
    "required": [
     "action",
     "token",
     "idempotency_key"
    ]
   },
   {
    "properties": {
     "action": {
      "const": "fork_draft"
     }
