    ]
   }
  ],
  "properties": {
   "action": {
    "enum": [
     "read",
     "recheck",
     "fork_draft",
     "fork",
     "watch_read",
     "watch_update",
     "renewal_draft",
     "renew",
     "download"
    ],
    "type": "string"
   },
   "agent_key": {
    "type": "string"
   },
   "body": {
    "description": "REST JSON body for the chosen action. See its documented fields in the action description and OpenAPI.",
    "type": "object"
   },
   "delete_credential": {
    "pattern": "^[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "handle": {
