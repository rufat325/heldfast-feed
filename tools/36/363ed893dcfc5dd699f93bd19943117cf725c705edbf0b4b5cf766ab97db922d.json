{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List the production staff of an anime (by mal_id) \u2014 director, composer, etc. \u2014 with their roles. Complements get_anime_characters (which covers voice actors). Get the mal_id from search_anime.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "MyAnimeList numeric ID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_anime_staff",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "staff": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "mal_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "positions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "mal_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "staff"
  ],
  "type": "object"
 },
 "title": "Get anime staff"
}
