{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Run 1 to 5 independent product searches for one selected Russian delivery region, up to 10 results per search. Each search supports the same text, brand, form, price, approved optional goal, sort and page filters as products_search. Results remain grouped in request order. Inspect each status and complete flag; a failed search is not an empty match. Use current catalog RUB prices; never substitute analogs without user confirmation.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"country":{"const":"RU","type":"string"},"region_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"searches":{"items":{"additionalProperties":false,"properties":{"brand":{"default":"","maxLength":80,"type":"string"},"form":{"default":"","maxLength":80,"type":"string"},"goal_code":{"default":"","maxLength":80,"type":"string"},"limit":{"default":5,"maximum":10,"minimum":1,"type":"integer"},"max_price":{"default":1000000,"maximum":1000000,"minimum":0,"type":"number"},"min_price":{"default":0,"maximum":1000000,"minimum":0,"type":"number"},"page":{"default":1,"maximum":100,"minimum":1,"type":"integer"},"query":{"default":"","maxLength":120,"type":"string"},"sort":{"default":"name","enum":["name","price_asc","price_desc"],"type":"string"}},"type":"object"},"maxItems":5,"minItems":1,"type":"array"}},"required":["country","region_id","searches"],"type":"object"},"name":"products_search_batch"}
