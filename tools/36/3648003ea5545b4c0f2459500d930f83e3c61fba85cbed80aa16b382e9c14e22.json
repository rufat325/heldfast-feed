{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Generate UGC, slideshow, remix, caption, or calendar content from project intelligence.",
 "inputSchema": {
  "properties": {
   "consentConfirmed": {
    "description": "Required when using uploaded creator or likeness-like media.",
    "type": "boolean"
   },
   "contentType": {
    "enum": [
     "reaction_demo",
     "hook_slideshow",
     "tiktok_video_remix",
     "tiktok_slideshow_remix",
     "ugc_avatar",
     "caption_pack",
     "content_calendar"
    ],
    "type": "string"
   },
   "count": {
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "goal": {
    "type": "string"
   },
   "platforms": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "projectId": {
    "type": "string"
   },
   "prompt": {
    "type": "string"
   },
   "saveToLibrary": {
    "type": "boolean"
   },
   "team_id": {
    "description": "Optional team ID or slug. Ignored when using a team-scoped API key.",
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "request_project_content",
 "title": "Request Project Content"
}
