{
 "description": "Runtime profiling run. object_type: not used. Required: target_type*(CLASS|PROGRAM) + class_name* for CLASS or program_name* for PROGRAM [onprem only \u2014 ABAP Cloud has no programs]. Optional: profiling(default true; set false for a plain run with no trace), profiling flags, description. Response: JSON.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aggregate": {
    "description": "Aggregate profiling data.",
    "type": "boolean"
   },
   "all_db_events": {
    "description": "Trace all DB events.",
    "type": "boolean"
   },
   "all_dynpro_events": {
    "description": "Trace dynpro events.",
    "type": "boolean"
   },
   "all_internal_table_events": {
    "description": "Trace internal table events.",
    "type": "boolean"
   },
   "all_misc_abap_statements": {
    "description": "Trace miscellaneous ABAP statements.",
    "type": "boolean"
   },
   "all_procedural_units": {
    "description": "Trace all procedural units.",
    "type": "boolean"
   },
   "all_system_kernel_events": {
    "description": "Trace system kernel events.",
    "type": "boolean"
   },
   "amdp_trace": {
    "description": "Enable AMDP tracing.",
    "type": "boolean"
   },
   "class_name": {
    "description": "Class name for profiling.",
    "type": "string"
   },
   "description": {
    "description": "Profiler run description.",
    "type": "string"
   },
   "explicit_on_off": {
    "description": "Use explicit on/off trace sections.",
    "type": "boolean"
   },
   "max_size_for_trace_file": {
    "description": "Maximum trace file size.",
    "type": "number"
   },
   "max_time_for_tracing": {
    "description": "Maximum tracing time.",
    "type": "number"
   },
   "profiling": {
    "default": true,
    "description": "Whether to capture a profiler trace while running. Default true. Set false for a plain run with no tracing \u2014 the profiling flags below are then ignored.",
    "type": "boolean"
   },
   "program_name": {
    "description": "Program name for profiling.",
    "type": "string"
   },
   "sql_trace": {
    "description": "Enable SQL trace.",
    "type": "boolean"
   },
   "target_type": {
    "description": "Profile execution target kind.",
    "enum": [
     "CLASS",
     "PROGRAM"
    ],
    "type": "string"
   },
   "with_rfc_tracing": {
    "description": "Enable RFC tracing.",
    "type": "boolean"
   }
  },
  "required": [
   "target_type"
  ],
  "type": "object"
 },
 "name": "HandlerProfileRun"
}
