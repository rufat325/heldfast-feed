{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Generate AI content and publish it in a single step.\n\nCombines generate_content + publish_content into one call.\nFirst generates platform-optimized content using AI, then publishes to the specified platforms.\n\nSame platform requirements as publish_content apply.",
 "inputSchema": {
  "properties": {
   "contentOverrides": {
    "properties": {
     "caption": {
      "type": "string"
     },
     "hashtags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "generation": {
    "properties": {
     "callToAction": {
      "type": "string"
     },
     "style": {
      "enum": [
       "storytelling",
       "promotional",
       "educational",
       "entertaining"
      ],
      "type": "string"
     },
     "tone": {
      "enum": [
       "professional",
       "casual",
       "energetic",
       "informative"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "hashtags": {
    "enum": [
     "on",
     "off",
     "platform_auto"
    ],
    "type": "string"
   },
   "mediaType": {
    "description": "Media type hint",
    "enum": [
     "image",
     "video",
     "auto"
    ],
    "type": "string"
   },
   "mediaUrl": {
    "description": "Media URL for the post",
    "type": "string"
   },
   "mediaUrls": {
    "description": "Multiple media URLs for carousel",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "platforms": {
    "description": "Target platforms to generate content for and publish to",
    "items": {
     "enum": [
      "x",
      "linkedin",
      "linkedin-page",
      "facebook",
      "instagram",
      "threads",
      "bluesky",
      "mastodon",
      "nostr",
      "youtube",
      "tiktok",
      "lemmy",
      "discord",
      "slack",
      "telegram",
      "pinterest",
      "dribbble",
      "devto",
      "hashnode",
      "gmb",
      "whop",
      "producthunt"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "prompt": {
    "description": "Creative prompt for AI content generation",
    "type": "string"
   },
   "strictAi": {
    "type": "boolean"
   }
  },
  "required": [
   "platforms"
  ],
  "type": "object"
 },
 "name": "publish_ai",
 "title": "AI Generate & Publish"
}
