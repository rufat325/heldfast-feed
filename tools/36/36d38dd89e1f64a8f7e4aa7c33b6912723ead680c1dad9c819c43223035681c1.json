{
 "description": "Mover un issue a un nuevo estado. Requiere confirm: true para ejecutar. Sin confirm devuelve preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "description": "true para ejecutar la transicion",
    "type": "boolean"
   },
   "issueKey": {
    "description": "Clave del issue (ej: PROJ-123)",
    "type": "string"
   },
   "transitionId": {
    "description": "ID de la transicion (obtenido de df_statuses)",
    "type": "string"
   }
  },
  "required": [
   "issueKey",
   "transitionId"
  ],
  "type": "object"
 },
 "name": "df_transition"
}
