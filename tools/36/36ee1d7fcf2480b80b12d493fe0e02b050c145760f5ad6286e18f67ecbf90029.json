{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Runs ruff format and returns structured results (files changed, file list).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "check": {
    "default": false,
    "description": "Check mode (report without modifying files)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "config": {
    "description": "Path to custom ruff config file",
    "maxLength": 4096,
    "type": "string"
   },
   "diff": {
    "default": false,
    "description": "Show diff of formatting changes without applying (--diff)",
    "type": "boolean"
   },
   "exclude": {
    "description": "File patterns to exclude from formatting",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "indentWidth": {
    "description": "Override the configured indent width (--indent-width)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "isolated": {
    "default": false,
    "description": "Ignore all configuration files (--isolated)",
    "type": "boolean"
   },
   "lineLength": {
    "description": "Override the configured line length (--line-length)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "noCache": {
    "default": false,
    "description": "Disable cache (--no-cache)",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "patterns": {
    "default": [
     "."
    ],
    "description": "Files or directories to format (default: [\".\"])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "preview": {
    "default": false,
    "description": "Enable preview formatting rules (--preview)",
    "type": "boolean"
   },
   "pythonPath": {
    "description": "Python interpreter path to use (overrides executable/PATH fallback)",
    "maxLength": 4096,
    "type": "string"
   },
   "quoteStyle": {
    "description": "Quote style override for formatting",
    "enum": [
     "single",
     "double"
    ],
    "type": "string"
   },
   "range": {
    "description": "Line range for formatting (e.g. '10-20')",
    "maxLength": 255,
    "type": "string"
   },
   "targetVersion": {
    "description": "Python version target override (e.g. 'py38')",
    "maxLength": 255,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ruff-format",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checkMode": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "exitCode": {
    "type": "number"
   },
   "files": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filesChanged": {
    "type": "number"
   },
   "filesUnchanged": {
    "type": "number"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "filesChanged",
   "filesUnchanged"
  ],
  "type": "object"
 },
 "title": "ruff Format"
}
