{
 "description": "As-of customs-tariff lookup: which measures/duty rates apply to a goods code in a jurisdiction (eu, us, uk, jp), optionally from an origin, on a date. Duty expressions are verbatim; every measure carries its legal citation. Not legal advice.",
 "inputSchema": {
  "properties": {
   "code": {
    "description": "goods code, 2-10 digits (HS/TARIC/HTS)",
    "type": "string"
   },
   "date": {
    "description": "as-of date YYYY-MM-DD, default today",
    "type": "string"
   },
   "direction": {
    "default": "import",
    "enum": [
     "import",
     "export"
    ],
    "type": "string"
   },
   "jurisdiction": {
    "default": "eu",
    "enum": [
     "eu",
     "us",
     "uk",
     "jp"
    ],
    "type": "string"
   },
   "origin": {
    "description": "ISO2 origin country (eu/uk only)",
    "type": "string"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "tariff_lookup"
}
