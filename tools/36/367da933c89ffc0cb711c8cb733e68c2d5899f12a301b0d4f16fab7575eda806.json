{
 "description": "Search Swedish statutes and regulations by keyword. FTS5 with BM25 ranking. Do NOT use for case law \u2014 use search_case_law instead.",
 "inputSchema": {
  "properties": {
   "as_of_date": {
    "description": "Historical date filter (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "document_id": {
    "description": "Filter by SFS number (e.g., \"2018:218\")",
    "pattern": "^\\d{4}:\\d+$",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum results to return",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search query in Swedish or English. Supports FTS5 syntax.",
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "description": "Filter by document status",
    "enum": [
     "in_force",
     "amended",
     "repealed"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_legislation"
}
