{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Parse CSS Color"
 },
 "description": "Parse a CSS color string and return hex, rgb, oklch, and gamut info.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "input": {
    "description": "CSS color string, e.g. \"tomato\", \"#ff6347\", \"oklch(0.6 0.18 27)\" (max 256 chars)",
    "maxLength": 256,
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "parse_color",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hex": {
    "description": "Lowercase #rrggbb sRGB-clamped hex of the parsed color",
    "type": "string"
   },
   "inGamut": {
    "description": "false when the input fell outside the sRGB gamut",
    "type": "boolean"
   },
   "oklch": {
    "additionalProperties": false,
    "description": "Raw (lossless) OKLCH components of the parsed color",
    "properties": {
     "c": {
      "type": "number"
     },
     "h": {
      "description": "0 for achromatic",
      "type": "number"
     },
     "l": {
      "type": "number"
     }
    },
    "required": [
     "l",
     "c",
     "h"
    ],
    "type": "object"
   },
   "rgb": {
    "additionalProperties": false,
    "description": "sRGB-clamped 0-255 integer channels; see inGamut",
    "properties": {
     "b": {
      "type": "number"
     },
     "g": {
      "type": "number"
     },
     "r": {
      "type": "number"
     }
    },
    "required": [
     "r",
     "g",
     "b"
    ],
    "type": "object"
   }
  },
  "required": [
   "hex",
   "rgb",
   "oklch",
   "inGamut"
  ],
  "type": "object"
 }
}
