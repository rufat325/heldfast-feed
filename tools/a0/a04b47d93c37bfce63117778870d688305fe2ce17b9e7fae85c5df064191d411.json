{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a campaign in the user's Picorn account from agent-authored post ideas (no model is called). The campaign lives in a marketing project: pass workspaceProjectId + workspaceProjectKey from picorn_projects_create, or omit both to create a new project named after the topic. Returns campaignId and one ideaId per idea. Create each post file with the same workspace plus campaignId + ideaId, then schedule it with picorn_posts_schedule. Requires a Picorn access token.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Campaign goal, audience or promise.",
    "maxLength": 1000,
    "type": "string"
   },
   "ideas": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "angle": {
       "maxLength": 300,
       "type": "string"
      },
      "caption": {
       "description": "Post caption for this idea.",
       "maxLength": 2200,
       "type": "string"
      },
      "cta": {
       "maxLength": 300,
       "type": "string"
      },
      "hook": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "title": {
       "maxLength": 200,
       "type": "string"
      }
     },
     "required": [
      "hook"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "topic": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "workspaceProjectId": {
    "type": "string"
   },
   "workspaceProjectKey": {
    "type": "string"
   }
  },
  "required": [
   "topic"
  ],
  "type": "object"
 },
 "name": "picorn_campaigns_create",
 "title": "Picorn Campaigns: create a campaign"
}
