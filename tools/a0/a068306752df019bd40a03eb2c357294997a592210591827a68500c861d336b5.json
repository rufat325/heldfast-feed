{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find content for a couple"
 },
 "description": "Finds TV programs that satisfy two people with different moods/preferences. Default fairness=strict (min(scoreA,scoreB) >= threshold \u2014 no veto). Auto-falls-back to fairness=average if strict returns empty, marked with degraded:true. Returns per-person score breakdown + compromise note when one side wins by >1.5 points.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fairness": {
    "default": "strict",
    "enum": [
     "strict",
     "average"
    ],
    "type": "string"
   },
   "include_streaming_xref": {
    "default": true,
    "type": "boolean"
   },
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "min_score": {
    "default": 1,
    "type": "number"
   },
   "person_a": {
    "additionalProperties": false,
    "description": "Preferences for person A",
    "properties": {
     "dislike_genres": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "dislike_keywords": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "mood": {
      "type": "string"
     },
     "prefer": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "person_b": {
    "additionalProperties": false,
    "description": "Preferences for person B",
    "properties": {
     "dislike_genres": {
      "$ref": "#/properties/person_a/properties/dislike_genres"
     },
     "dislike_keywords": {
      "$ref": "#/properties/person_a/properties/dislike_keywords"
     },
     "mood": {
      "$ref": "#/properties/person_a/properties/mood"
     },
     "prefer": {
      "$ref": "#/properties/person_a/properties/prefer"
     }
    },
    "type": "object"
   },
   "timeframe": {
    "default": "tonight",
    "type": "string"
   }
  },
  "required": [
   "person_a",
   "person_b"
  ],
  "type": "object"
 },
 "name": "tv_find_for_couple",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asked_at_utc": {
    "type": "string"
   },
   "count": {
    "type": "number"
   },
   "degraded": {
    "type": "boolean"
   },
   "fairness": {
    "type": "string"
   },
   "freshness": {
    "additionalProperties": true,
    "properties": {
     "epg_age_min": {
      "type": [
       "number",
       "null"
      ]
     },
     "stale": {
      "type": "boolean"
     },
     "streaming_age_min": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "stale"
    ],
    "type": "object"
   },
   "items": {
    "items": {
     "$ref": "#/properties/person_a"
    },
    "type": "array"
   },
   "min_score": {
    "type": "number"
   },
   "person_a": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "person_b": {
    "$ref": "#/properties/person_a"
   },
   "timeframe_label": {
    "type": "string"
   },
   "window": {
    "additionalProperties": true,
    "properties": {
     "from_utc": {
      "type": "string"
     },
     "to_utc": {
      "type": "string"
     }
    },
    "required": [
     "from_utc",
     "to_utc"
    ],
    "type": "object"
   }
  },
  "required": [
   "asked_at_utc",
   "timeframe_label",
   "window",
   "person_a",
   "person_b",
   "fairness",
   "min_score",
   "degraded",
   "count",
   "items",
   "freshness"
  ],
  "type": "object"
 },
 "title": "Find content for a couple"
}
