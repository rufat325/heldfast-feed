{
 "description": "List sitemaps submitted for a Google Search Console property",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "siteUrl": {
    "description": "Search Console property",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "siteUrl"
  ],
  "type": "object"
 },
 "name": "list_sitemaps",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "siteUrl": {
    "type": "string"
   },
   "sitemaps": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "contents": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "indexed": {
          "type": "number"
         },
         "submitted": {
          "type": "number"
         },
         "type": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "type",
         "submitted",
         "indexed"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "errors": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "isPending": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "description": "Null when Google did not report it, which is not the same as known to be processed"
      },
      "isSitemapsIndex": {
       "type": "boolean"
      },
      "lastDownloaded": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastSubmitted": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "path": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "warnings": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Null while the sitemap is pending. Zero warnings beside zero errors reads as parsed and clean, which an unprocessed sitemap is not"
      }
     },
     "required": [
      "path",
      "lastSubmitted",
      "lastDownloaded",
      "isPending",
      "isSitemapsIndex",
      "warnings",
      "errors",
      "contents"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "siteUrl",
   "count",
   "sitemaps"
  ],
  "type": "object"
 }
}
