{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Search listings"},"description":"Search real-estate listings published on new.estate (homes, apartments, plots, commercial property for sale or rent in many countries). Returns matching listings with price, area, location and the URL of each listing page. The accepted property type and country values are listed by get_catalog. The listing URL is the page to cite for each result.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"areaUnit":{"default":"m","description":"Unit of minArea/maxArea: square metres (m) or square feet (ft).","enum":["m","ft"],"type":"string"},"country":{"description":"ISO 3166-1 alpha-2 country code, upper case, e.g. PL, ES.","pattern":"^[A-Z]{2}$","type":"string"},"currency":{"description":"ISO 4217 code of minPrice/maxPrice. Required with a price bound; listings in other currencies are compared after conversion. Listings that do not disclose a price (auction or tender) are left out of any search with a price bound.","pattern":"^[A-Z]{3}$","type":"string"},"cursor":{"description":"nextCursor of the previous page.","maxLength":128,"minLength":1,"type":"string"},"features":{"description":"Only listings that have every feature given.","items":{"enum":["balcony","garden","basement","parking","elevator","furnished","airConditioning"],"type":"string"},"maxItems":7,"minItems":1,"type":"array"},"latitude":{"maximum":90,"minimum":-90,"type":"number"},"limit":{"default":10,"maximum":24,"minimum":1,"type":"integer"},"locale":{"default":"en-US","description":"Language of names, titles, descriptions and listing URLs, e.g. en-US, pl-PL, de-DE.","enum":["en-US","en-GB","en-AU","en-CA","en-IE","en-NZ","pl-PL","cs-CZ","sk-SK","hr-HR","sr-RS","sl-SI","bg-BG","fr-FR","fr-CH","fr-BE","fr-CA","de-DE","de-AT","de-CH","es-ES","es-MX","es-AR","es-CO","es-CL","it-IT","ro-RO","nl-NL","nl-BE"