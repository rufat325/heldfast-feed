{
 "description": "Record that the user checked in at a waypoint. Triggers co-presence detection against other users' recent check-ins.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "lat": {
    "type": "number"
   },
   "lon": {
    "type": "number"
   },
   "name": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "occurred_at": {
    "format": "date-time",
    "type": "string"
   },
   "waypoint_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "waypoint_id",
   "name"
  ],
  "type": "object"
 },
 "name": "polarity_checkin"
}
