{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Latest published stories, newest first, with status labels and sources (primary first).",
 "inputSchema": {
  "properties": {
   "format": {
    "enum": [
     "breaking",
     "model_drop",
     "the_number",
     "money",
     "explainer",
     "rumor",
     "for_the_minutes",
     "standard",
     "wire_link"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "topic": {
    "enum": [
     "models",
     "agents",
     "chips",
     "policy",
     "funding",
     "open_source",
     "research",
     "products",
     "safety",
     "enterprise",
     "business",
     "society"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_latest",
 "outputSchema": {
  "properties": {
   "attribution": {
    "type": "string"
   },
   "data": {
    "items": {
     "properties": {
      "affects": {
       "description": "sectors and functions the event affects",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "aiDisclosure": {
       "type": [
        "string",
        "null"
       ]
      },
      "aiGenerated": {
       "description": "true: the text is AI-generated from the listed sources (EU AI Act Art. 50(4) label); false only for wire_link items",
       "type": "boolean"
      },
      "attribution": {
       "type": "string"
      },
      "disclosure": {
       "enum": [
        "ai",
        "reviewed",
        "link"
       ],
       "type": "string"
      },
      "format": {
       "description": "one of breaking, model_drop, the_number, money, explainer, rumor, for_the_minutes, standard, wire_link; wire_link = an outlet's headline and a link to its report, no text by Minutes of AI",
       "type": "string"
      },
      "headline": {
       "type": "string"
      },
      "label": {
       "properties": {
        "code": {
         "type": "string"
        },
        "text": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "text"
       ],
       "type": "object"
      },
      "lane": {
       "description": "builders: SDK and library releases, checkpoints, repository signals",
       "enum": [
        "business",
        "builders",
        null
       ],
       "type": [
        "string",
        "null"
       ]
      },
      "lede": {
       "type": [
        "string",
        "null"
       ]
      },
      "outletCount": {
       "description": "distinct outlets in sources",
       "type": "integer"
      },
      "publishedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "slug": {
       "type": "string"
      },
      "sourceCount": {
       "description": "entries in sources (one per page)",
       "type": "integer"
      },
      "sources": {
       "items": {
        "properties": {
         "isPrimary": {
          "type": "boolean"
         },
         "outlet": {
          "type": "string"
         },
         "publishedAt": {
          "type": [
           "string",
           "null"
          ]
         },
         "quote": {
          "type": [
           "string",
           "null"
          ]
         },
         "title": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "outlet",
         "url",
         "isPrimary"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "state": {
       "type": "string"
      },
      "updatedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": "string"
      },
      "wireLink": {
       "description": "wire_link only: {outlet, url, originalHeadline, publishedAt, supersededBy}",
       "type": "object"
      }
     },
     "required": [
      "slug",
      "url",
      "headline",
      "format",
      "label",
      "publishedAt",
      "updatedAt",
      "sources",
      "aiGenerated",
      "attribution"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "license": {
    "type": "object"
   }
  },
  "required": [
   "attribution",
   "data"
  ],
  "type": "object"
 },
 "title": "Latest stories"
}
