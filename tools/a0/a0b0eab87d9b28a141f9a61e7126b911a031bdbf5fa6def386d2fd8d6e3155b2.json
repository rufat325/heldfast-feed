    "type": "string"
   },
   "max_results": {
    "description": "Maximum results (default 10)",
    "type": "number"
   },
   "occasion": {
    "description": "Occasion description",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "drinking-recommendations",
