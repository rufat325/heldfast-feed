{
 "description": "Search Meta's public Ad Library for competitive research. Returns active and inactive ads matching `search_terms` OR `search_page_ids` in the selected countries. Default country = ['US']. Returns ad_snapshot_url (preview), creative bodies/titles, page_id, delivery times, publisher_platforms.\n\nNote: only ads in categories subject to public transparency (political / housing / employment / credit) return full metadata; other categories return lighter data.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ad_active_status": {
    "description": "Default ACTIVE",
    "enum": [
     "ALL",
     "ACTIVE",
     "INACTIVE"
    ],
    "type": "string"
   },
   "ad_reached_countries": {
    "description": "ISO-2 country codes. Default ['US']",
    "items": {
     "maxLength": 2,
     "minLength": 2,
     "type": "string"
    },
    "type": "array"
   },
   "ad_type": {
    "description": "Default ALL",
    "enum": [
     "ALL",
     "POLITICAL_AND_ISSUE_ADS",
     "HOUSING_ADS",
     "EMPLOYMENT_ADS",
     "CREDIT_ADS"
    ],
    "type": "string"
   },
   "after": {
    "type": "string"
   },
   "fields": {
    "description": "Override default field list",
    "type": "string"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "publisher_platforms": {
    "items": {
     "enum": [
      "FACEBOOK",
      "INSTAGRAM",
      "AUDIENCE_NETWORK",
      "MESSENGER"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "search_page_ids": {
    "description": "Specific Facebook Page IDs to look at",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "search_terms": {
    "description": "Keywords to search ad text/creative",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_ads_library"
}
