{
 "annotations": {
  "readOnlyHint": true,
  "title": "Calculate a stay quote"
 },
 "description": "Price a prospective stay at one property: rent, fees, taxes, security deposit and total for the given dates and party. Computes only \u2014 creates nothing. Hostfully: POST /api/v3.3/quotes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agency_uid": {
    "description": "Agency UID. Defaults to HOSTFULLY_AGENCY_UID; hostfully_list_agencies lists the options.",
    "type": "string"
   },
   "check_in_date": {
    "description": "Check-in date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "check_out_date": {
    "description": "Check-out date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "children_count": {
    "description": "Children among the guests.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "guests": {
    "description": "Number of guests.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "lead_uid": {
    "description": "Quote in the context of an existing lead.",
    "type": "string"
   },
   "pet_count": {
    "description": "Number of pets.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "property_uid": {
    "description": "The property's UID.",
    "type": "string"
   }
  },
  "required": [
   "property_uid",
   "check_in_date",
   "check_out_date",
   "guests"
  ],
  "type": "object"
 },
 "name": "hostfully_calculate_quote",
 "title": "Calculate a stay quote"
}
