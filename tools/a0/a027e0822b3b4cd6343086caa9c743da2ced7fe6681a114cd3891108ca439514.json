{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Liquidations on a Hyperliquid perp, read from our own nodes: price, size, side and the liquidated wallet. Hyperliquid's public API has no liquidation feed.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Number of liquidation events (1-100, default 20)",
    "type": "number"
   },
   "market": {
    "description": "Market symbol \u2014 native HL perp (e.g. \"BTC-PERP\", \"ETH-PERP\") or HIP-3 builder market namespaced as \"<issuer>:<base>-PERP\" (e.g. \"flx:GAS-PERP\", \"xyz:NVDA-PERP\")",
    "type": "string"
   }
  },
  "required": [
   "market"
  ],
  "type": "object"
 },
 "name": "get_liquidations",
 "outputSchema": {
  "description": "Liquidations",
  "properties": {
   "data": {
    "description": "Liquidations",
    "items": {
     "description": "One row",
     "properties": {
      "address": {
       "description": "Liquidated wallet"
      },
      "base_market": {
       "description": "Display symbol without the HIP-3 issuer prefix"
      },
      "block_number": {
       "description": "Hyperliquid block height"
      },
      "display_symbol": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "issuer": {
       "description": "HIP-3 builder code (\"\" for native markets)"
      },
      "market": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "market_type": {
       "description": "perp, spot or prediction"
      },
      "price": {
       "description": "Price in USD"
      },
      "quote_asset": {
       "description": "Quote asset, e.g. USDC"
      },
      "realized_pnl": {
       "description": "Realized PnL in USD"
      },
      "side": {
       "description": "The liquidated wallet's fill side: \"sell\" closed a long, \"buy\" closed a short"
      },
      "size": {
       "description": "Size in base units"
      },
      "source": {
       "description": "Venue, always hyperliquid"
      },
      "timestamp": {
       "description": "Unix milliseconds"
      },
      "venue": {
       "description": "Venue, always hyperliquid"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "pagination": {
    "description": "Cursor pagination",
    "properties": {
     "has_more": {
      "description": "Whether more rows exist"
     },
     "next_cursor": {
      "description": "Pass as cursor to fetch the next page; null on the last page"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 }
}
