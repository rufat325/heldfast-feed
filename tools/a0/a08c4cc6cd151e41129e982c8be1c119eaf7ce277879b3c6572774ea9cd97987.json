{
 "description": "Scroll the chart or page up/down/left/right",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Scroll amount in pixels (default 300)",
    "type": "number"
   },
   "direction": {
    "description": "Scroll direction",
    "enum": [
     "up",
     "down",
     "left",
     "right"
    ],
    "type": "string"
   }
  },
  "required": [
   "direction"
  ],
  "type": "object"
 },
 "name": "ui_scroll"
}
