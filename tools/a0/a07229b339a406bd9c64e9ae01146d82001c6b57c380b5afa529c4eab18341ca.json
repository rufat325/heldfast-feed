{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Public status page for a long task, a deployment or a fleet. create(title, components: names or\n{name, group}) returns url to share (read-only) and capabilities.write_token: pass it as token for\nset_component(component, status, message, percent 0\u2013100), post_update(text, level), touch and delete.\nheartbeat_id makes a component follow a heartbeat. read(version, wait_seconds) waits for a change.","inputSchema":{"properties":{"action":{"enum":["create","read","set_component","post_update","touch","delete"],"title":"Action","type":"string"},"component":{"anyOf":[{"maxLength":60,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Component"},"components":{"anyOf":[{"items":{},"maxItems":30,"type":"array"},{"type":"null"}],"default":null,"title":"Components"},"description":{"anyOf":[{"maxLength":1000,"type":"string"},{"type":"null"}],"default":null,"title":"Description"},"group":{"anyOf":[{"maxLength":60,"type":"string"},{"type":"null"}],"default":null,"title":"Group"},"heartbeat_id":{"anyOf":[{"pattern":"^[A-Za-z0-9_-]{16,64}$","type":"string"},{"type":"null"}],"default":null,"title":"Heartbeat Id"},"id":{"anyOf":[{"pattern":"^[A-Za-z0-9_-]{16,64}$","type":"string"},{"type":"null"}],"default":null,"title":"Id"},"level":{"anyOf":[{"enum":["info","warning","problem","resolved"],"type":"string"},{"type":"null"}],"default":null,"title":"Level"},"message":{"anyOf":[{"maxLength":300,"type":"string"},{"type":"null"}],"default":null,"title":"Message"},"percent":{"anyOf":[{"maximum":100,"minimum":0,"type":"number"},{"type":"null"}],"default":null,"title":"Percent"},"status":{"anyOf":[{"enum":["operational","degraded","down","maintenance","running","waiting","done","failed","unknown"],"type":"string"},{"type":"null"}],"default":null,"title":"Status"},"text":{"anyOf":[{"maxLength":1000,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Text"},"title":{"anyOf":[{"maxLength":120,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Title"},"token":{"anyOf":[{"maxLength":128,"minLength":16,"type":"string"},{"type":"null"}],"default":null,"title":"Token"},"ttl_seconds":{"anyOf":[{"maximum":604800,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Ttl Seconds"},"version":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Version"},"wait_seconds":{"anyOf":[{"maximum":30,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Wait Seconds"}},"required":["action"],"title":"status_pageArguments","type":"object"},"name":"status_page"}
